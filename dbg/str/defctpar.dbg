     1686        LABEL "&Ф"
     1687        SIZE 3 BY 1
     1688        BGCOLOR 8 .
     1689   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по:"
     1690         VIEW-AS TEXT
     1691        SIZE 9.5 BY .67 NO-UNDO.
     1692   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Объект:"
     1693         VIEW-AS TEXT
     1694        SIZE 7.5 BY .67 NO-UNDO.
     1695   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1696         VIEW-AS TEXT
     1697        SIZE 4 BY .67
     1698        FGCOLOR 4  NO-UNDO.
     1699   DEFINE VARIABLE v-sort-pole AS CHARACTER FORMAT "X(256)":U
     1700        VIEW-AS FILL-IN
     1701        SIZE 21.5 BY 1 NO-UNDO.
     1702   DEFINE VARIABLE R-obj AS INTEGER
     1703        VIEW-AS RADIO-SET HORIZONTAL
     1704        RADIO-BUTTONS
     1705             "текущий", 0,
     1706   "все", 1
     1707        SIZE 16 BY 1 TOOLTIP "Партии по всем объектам или по текущему"
     1708        FGCOLOR 1  NO-UNDO.
     1709   DEFINE VARIABLE R-sort AS INTEGER
     1710        VIEW-AS RADIO-SET HORIZONTAL
     1711        RADIO-BUTTONS
     1712             "серии", 2,
     1713   "артикулу", 3,
     1714   "наименованию", 4
     1715        SIZE 39.38 BY 1 TOOLTIP "Поиск по СЕРИИ (№ партии), артикулу или наименованию"
     1716        FGCOLOR 4  NO-UNDO.
     1717   DEFINE QUERY BROWSE-2 FOR
     1718         x_parts,
     1719         Buf_goods,
     1720         Buf_bar-code SCROLLING.
     1721   DEFINE BROWSE BROWSE-2
     1722     QUERY BROWSE-2 NO-LOCK DISPLAY
     1723         mark-string(recid( x_parts), rid-list) COLUMN-LABEL '*'  FORMAT "X(1)":U
     1724         x_parts.artic COLUMN-LABEL 'Артикул! '  FORMAT "X(16)":U
     1725         x_parts.part-code COLUMN-LABEL 'Серия!№ партии'  FORMAT "X(20)":U
     1726         Buf_bar-code.b-code COLUMN-LABEL 'Бар-код!партии'  FORMAT "999999999":U
     1727         Buf_goods.gds-name COLUMN-LABEL 'Наименование!товара'  FORMAT "X(40)":U
     1728         f-obj-name(recid( x_parts))   @ vf-obj-name  COLUMN-LABEL 'Объект!Название'  FORMAT "X(20)":U
     1729         x_parts.fact-date COLUMN-LABEL 'Дата ПН! '  FORMAT "99/99/9999":U
     1730         x_parts.fact-qnty COLUMN-LABEL 'Остатки!количество'  FORMAT "->>,>>>,>>9.999":U
     1731         x_parts.in-code COLUMN-LABEL '№ ПН! '  FORMAT "X(14)":U
     1732         x_parts.last-date COLUMN-LABEL 'Последний срок!реализации'  FORMAT "99/99/9999":U
     1733         x_parts.dop COLUMN-LABEL 'Цена!Производителя'  FORMAT "x(13)":U
     1734         x_parts.defect COLUMN-LABEL 'ФиБ! '  FORMAT "9":U
     1735         x_parts.price-cli COLUMN-LABEL 'Цена!(вал.пост)'  FORMAT "->>,>>>,>>>,>>9.999":U
     1736         x_parts.price-rubl COLUMN-LABEL 'Цена уч!руб'  FORMAT "->>,>>>,>>9.99":U
     1737         x_parts.obj-type COLUMN-LABEL 'Объект!тип'  FORMAT "X(3)":U
     1738         x_parts.obj-code COLUMN-LABEL 'Объект!код'  FORMAT "99999":U
     1739         x_parts.vat-type COLUMN-LABEL 'Тип!НДС'  FORMAT "X(6)":U
     1740         x_parts.vat-pc COLUMN-LABEL '%!НДС'  FORMAT ">>9.99":U
     1741         f-cli-name(recid( x_parts))   @ vf-cli-name  COLUMN-LABEL 'Контрагент!Название'  FORMAT "X(30)":U
     1742         enable x_parts.artic
     1743       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.25 BY 17.54 FIT-LAST-COLUMN.
     1744   DEFINE FRAME Dialog-Frame
     1745        BROWSE-2 AT ROW 4.75 COL 1.25 WIDGET-ID 200
     1746        b-Cancel AT ROW 1 COL 1
     1747        b-add-2 AT ROW 1 COL 11.13 WIDGET-ID 48
     1748        b-add AT ROW 1.04 COL 11.63 WIDGET-ID 10
     1749        b-del-2 AT ROW 1 COL 24 WIDGET-ID 50
     1750        b-del AT ROW 1 COL 24 WIDGET-ID 12
     1751        b-impotr-www AT ROW 1 COL 36 WIDGET-ID 16
     1752        b-make-trn AT ROW 1 COL 42.63 WIDGET-ID 8
     1753        b-report AT ROW 1 COL 52.63 WIDGET-ID 40
     1754        b-make-add AT ROW 1 COL 62.75 WIDGET-ID 24
     1755        b-clear AT ROW 1 COL 73 WIDGET-ID 20
     1756        b-sch AT ROW 1 COL 90.5 WIDGET-ID 4
     1757        b-print AT ROW 1 COL 92.5 WIDGET-ID 2
     1758        b-help AT ROW 1 COL 94.5
     1759        R-sort AT ROW 2.13 COL 11.25 NO-LABEL WIDGET-ID 30
     1760        v-sort-pole AT ROW 2.13 COL 48.63 COLON-ALIGNED NO-LABEL WIDGET-ID 38
     1761        R-obj AT ROW 2.25 COL 81 NO-LABEL WIDGET-ID 42
     1762        b-mark AT ROW 3.71 COL 1.75 WIDGET-ID 14
     1763        b-mark-all AT ROW 3.71 COL 4.88 WIDGET-ID 28
     1764        FILL-IN-1 AT ROW 2.25 COL 2 NO-LABEL WIDGET-ID 36
     1765        b-del-mark AT ROW 3.71 COL 7.88 WIDGET-ID 26
     1766        FILL-IN-2 AT ROW 2.38 COL 73.13 NO-LABEL WIDGET-ID 46
     1767        mark-num AT ROW 4 COL 9.5 COLON-ALIGNED NO-LABEL WIDGET-ID 18
     1768        SPACE(82.37) SKIP(17.62)
     1769       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1770            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1771            TITLE "Управление списком партий"
     1772            CANCEL-BUTTON b-Cancel WIDGET-ID 100.
     1773   ASSIGN
     1774          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1775          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1776   ASSIGN
     1777          b-make-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-make-add:HANDLE.
     1778   ASSIGN
     1779          b-make-trn:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-make-trn:HANDLE.
     1780   ASSIGN
     1781          b-report:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-make-add-2:HANDLE.
     1782   ASSIGN
     1783          BROWSE-2:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     1784   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1785   DO:
     1786     APPLY "END-ERROR":U TO SELF.
     1787   END.
     1788   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1789   DO:
     1790   define variable i as integer   no-undo .
     1791   define variable ii as integer   no-undo .
     1792   define buffer buf_parts for ub.parts  .
     1793   empty temp-table temp-parts.
     1794   run str/defctpar.w
     1795   ( parparentproc ,
     1796     this-procedure,
     1797     v-cntxt-obj-type,
     1798     v-cntxt-obj-code,
     1799     "add-new-fib" ,
     1800     p-obj,
     1801     output TABLE temp-parts)
     1802     no-error .
     1803   run waitfram-show in this-procedure ("Отметка ФиБ на партиях") .
     1804     for each temp-parts :
     1805         find first x_parts no-lock  where
     1806               x_parts.obj-code   = temp-parts.obj-code and
     1807               x_parts.obj-type   = temp-parts.obj-type  and
     1808               x_parts.artic      = temp-parts.artic  and
     1809               x_parts.prod-type  = temp-parts.prod-type  and
     1810               x_parts.prod-code  = temp-parts.prod-code  and
     1811               x_parts.out-code   = temp-parts.out-code  and
     1812               x_parts.in-code    = temp-parts.in-code  and
     1813               x_parts.part-code  = temp-parts.part-code  no-error .
     1814          if not available x_parts then do:
     1815              i = i + 1 .
     1816              ii = ii + 1 .
     1817              create x_parts.
     1818              buffer-copy temp-parts to x_parts
     1819                 assign
     1820                    x_parts.defect = logical('yes':U)
     1821              .
     1822               run save-proc in this-procedure
     1823               ( buffer x_parts ) .
     1824          end.
     1825     end.
     1826     run waitfram-hide in this-procedure .
     1827     run OpenBr in this-procedure (yes, no, '':U).
     1828     if r-obj = 1 then do:
     1829        message substitute ( "Добавлено &1 партий в список ФиБ партий по всем объектам " , i , ii ) view-as alert-box .
     1830     end.
     1831     else do:
     1832        message substitute ( "Добавлено &1 партий в список ФиБ партий по текущему объекту " , i , ii ) view-as alert-box .
     1833     end.
     1834   END.
     1835   ON CHOOSE OF b-add-2 IN FRAME Dialog-Frame
     1836   DO:
     1837     apply "CHOOSE" to b-add IN FRAME Dialog-Frame .
     1838   END.
     1839   ON CHOOSE OF b-clear IN FRAME Dialog-Frame
     1840   DO:
     1841   define variable br-handle as handle no-undo .
     1842   define variable g#log as logical   no-undo .
     1843   define variable v-doc-rec as recid no-undo .
     1844     find current x_parts no-error    .
     1845     if not available x_parts then return .
     1846     delete x_parts.
     1847     br-handle = BROWSE-2:handle in frame Dialog-Frame .
     1848     if valid-handle (br-handle) then do:
     1849       g#log = br-handle:select-next-row().
     1850       if not g#log then g#log = br-handle:select-prev-row().
     1851       v-doc-rec = recid (x_parts) .
     1852     end.
     1853      run OpenBr in this-procedure (yes, no, '':U).
     1854      apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
     1855      reposition BROWSE-2 to recid v-doc-rec no-error.
     1856   END.
     1857   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1858   DO:
     1859   define variable i as integer   no-undo .
     1860   define buffer buf_x_parts for x_parts  .
     1861   define buffer buf_parts for ub.parts  .
     1862   if num-entries ( rid-list ) = 0  then do:
     1863     find current x_parts no-error    .
     1864     if not available x_parts then return .
     1865     assign
     1866       x_parts.defect = false
     1867     .
     1868         run save-proc in this-procedure
     1869         ( buffer x_parts ) .
     1870       delete x_parts no-error .
     1871   end.
     1872   else do:
     1873     do i = 1 to num-entries(rid-list) :
     1874     find first buf_x_parts where recid(buf_x_parts) = int(entry(i,rid-list)) no-error.
     1875     if not available buf_x_parts then next .
     1876     assign
     1877       buf_x_parts.defect = false
     1878     .
     1879         run save-proc in this-procedure
     1880         ( buffer buf_x_parts ) .
     1881         for each   buf_parts exclusive-lock  where
     1882                     buf_parts.artic      = buf_x_parts.artic      and
     1883                     buf_parts.prod-type  = buf_x_parts.prod-type  and
     1884                     buf_parts.prod-code  = buf_x_parts.prod-code  and
     1885                     buf_parts.part-code  = buf_x_parts.part-code  and
     1886                     buf_parts.out-code   = 'free-zone':U           and
     1887                     buf_parts.defect = logical('yes':U)
     1888                     :
     1889               buf_parts.defect = false   .
     1890           end.
     1891       delete buf_x_parts no-error .
     1892     end.
     1893     rid-list = "".
     1894   end.
     1895   run OpenBr in this-procedure (yes, no, '':U).
     1896   END.
     1897   ON CHOOSE OF b-del-2 IN FRAME Dialog-Frame
     1898   DO:
     1899     apply "CHOOSE" to b-del IN FRAME Dialog-Frame .
     1900   END.
     1901   ON CHOOSE OF b-del-mark IN FRAME Dialog-Frame
     1902   DO:
     1903   rid-list = "".
     1904   g-log = BROWSE-2:refresh() .
     1905   apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1906   END.
     1907   ON CHOOSE OF b-impotr-www IN FRAME Dialog-Frame
     1908   DO:
     1909   define variable i as integer   no-undo .
     1910   define variable ii as integer   no-undo .
     1911   define buffer buf_parts for ub.parts  .
     1912   empty temp-table temp-parts.
     1913   run str/imp-fib.w
     1914   ( parparentproc  ,
     1915     this-procedure ,
     1916     output TABLE temp-parts )
     1917     no-error .
     1918   find first temp-parts no-error .
     1919   if not available temp-parts then return .
     1920   run waitfram-show in this-procedure ("Отметка ФиБ на партиях") .
     1921     for each temp-parts :
     1922         find first x_parts no-lock  where
     1923               x_parts.obj-code   = temp-parts.obj-code and
     1924               x_parts.obj-type   = temp-parts.obj-type  and
     1925               x_parts.artic      = temp-parts.artic  and
     1926               x_parts.prod-type  = temp-parts.prod-type  and
     1927               x_parts.prod-code  = temp-parts.prod-code  and
     1928               x_parts.out-code   = temp-parts.out-code  and
     1929               x_parts.in-code    = temp-parts.in-code  and
     1930               x_parts.part-code  = temp-parts.part-code  no-error .
     1931          if not available x_parts then do:
     1932              i = i + 1 .
     1933              ii = ii + 1 .
     1934              create x_parts.
     1935              buffer-copy temp-parts to x_parts
     1936                 assign
     1937                    x_parts.whole-send-news = int('yes':U)
     1938              .
     1939               run save-proc in this-procedure
     1940               ( buffer x_parts ) .
     1941          end.
     1942     end.
     1943     run waitfram-hide in this-procedure .
     1944     run OpenBr in this-procedure (yes, no, '':U).
     1945     if r-obj = 1 then do:
     1946        message substitute ( "Добавлено &1 партий в список ФиБ партий по всем объектам " , i , ii ) view-as alert-box .
     1947     end.
     1948     else do:
     1949        message substitute ( "Добавлено &1 партий в список ФиБ партий по текущему объекту " , i , ii ) view-as alert-box .
     1950     end.
     1951   END.
     1952   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1953   DO:
     1954         if available x_parts then do:
     1955   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1956   define variable v-str-recid19 as character no-undo .
     1957   define variable v-num-entry19 as integer   no-undo .
     1958   assign
     1959     v-str-recid19 = trim( string( recid( x_parts ) , "->>>>>>>>>>>9":U ) )
     1960     v-num-entry19 = lookup( v-str-recid19 , rid-list )
     1961   .
     1962   if v-num-entry19 > 0 then do:
     1963     assign
     1964       entry( v-num-entry19, rid-list ) = "":U
     1965       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1966     .
     1967   end.
     1968   else do:
     1969     assign
     1970       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid19
     1971     .
     1972   end.
     1973           g-log = BROWSE-2:refresh() .
     1974           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1975               g-log = BROWSE-2:select-next-row ().
     1976               apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
     1977           end.
     1978           if num-entries( rid-list ) = 0
     1979           then
     1980               hide mark-num in frame Dialog-Frame.
     1981           else do:
     1982               end.
     1983       end.
     1984       apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1985   END.
     1986   ON CHOOSE OF b-mark-all IN FRAME Dialog-Frame
     1987   DO:
     1988          for each x_parts :
     1989             if length (rid-list) >= 31000 then leave.
     1990   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1991   define variable v-str-recid21 as character no-undo .
     1992   define variable v-num-entry21 as integer   no-undo .
     1993   assign
     1994     v-str-recid21 = trim( string( recid( x_parts ) , "->>>>>>>>>>>9":U ) )
     1995     v-num-entry21 = lookup( v-str-recid21 , rid-list )
     1996   .
     1997   if v-num-entry21 > 0 then do:
     1998     assign
     1999       entry( v-num-entry21, rid-list ) = "":U
     2000       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2001     .
     2002   end.
     2003   else do:
     2004     assign
     2005       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid21
     2006     .
     2007   end.
     2008          end.
     2009           g-log = BROWSE-2:refresh() .
     2010           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2011               g-log = BROWSE-2:select-next-row ().
     2012               apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
     2013           end.
     2014   END.
