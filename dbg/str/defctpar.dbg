     1487           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-vat-register in g#attr-lib
     1488         (input  p-obj-type
     1489         ,input  p-obj-code
     1490         ,input-output p-value
     1491         ,output p-setted
     1492         ) no-error .
     1493       if error-status :error
