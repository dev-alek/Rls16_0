     2419   ON VALUE-CHANGED OF R-obj IN FRAME Dialog-Frame
     2420   DO:
     2421   END.
     2422   ON VALUE-CHANGED OF R-sort IN FRAME Dialog-Frame
     2423   DO:
     2424     assign r-sort.
     2425   END.
     2426   ON LEAVE OF v-sort-pole IN FRAME Dialog-Frame
     2427   DO:
     2428   END.
     2429   ON RETURN OF v-sort-pole IN FRAME Dialog-Frame
     2430   DO:
     2431    assign r-sort v-sort-pole.
     2432     case r-sort:
     2433     when 1 then do:
     2434        run proc-find-b-code in this-procedure(no, v-sort-pole) no-error.
     2435     end.
     2436     when 2 then do:
     2437        run proc-find-part-code in this-procedure(no, v-sort-pole) no-error.
     2438     end.
     2439     when 3 then do:
     2440        run proc-find-artic in this-procedure(no, v-sort-pole) no-error.
     2441     end.
     2442     when 4 then do:
     2443        run proc-find-name in this-procedure(no, v-sort-pole) no-error.
     2444     end.
     2445     end case.
     2446     return no-apply.
     2447   END.
     2448   ON CTRL-J  OF v-sort-pole IN FRAME Dialog-Frame
     2449   do:
     2450    assign r-sort v-sort-pole .
     2451     case r-sort:
     2452     when 1 then do:
     2453       run proc-find-b-code in this-procedure(yes, v-sort-pole) no-error.
     2454     end.
     2455     when 2 then do:
     2456       run proc-find-part-code in this-procedure(yes, v-sort-pole) no-error.
     2457     end.
     2458     when 3 then do:
     2459       run proc-find-artic in this-procedure(yes, v-sort-pole) no-error.
     2460     end.
     2461     when 4 then do:
     2462       run proc-find-name in this-procedure(yes, v-sort-pole) no-error.
     2463     end.
     2464     end case.
     2465     if error-status:error then return no-apply.
     2466   end.
