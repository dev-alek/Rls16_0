     2489   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2490   procedure set-filter-name :
     2491   define input parameter p-filter-name as character no-undo .
     2492     do with frame Dialog-Frame:
     2493       if p-filter-name > "" then do:
     2494         assign
     2495           frame Dialog-Frame:title
     2496             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2497         .
     2498         assign
     2499           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2500         .
     2501       end.
     2502       else do:
     2503         assign
     2504           b-sch :tooltip = ""
     2505         .
     2506       end.
     2507     end.
     2508   end procedure.
     2509   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2510   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2511   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2512   on help of frame Dialog-Frame
     2513   do:
     2514     run gbl/app_help.p
     2515       (input this-procedure :file-name
     2516       ,input ''
     2517       ,input ?
     2518       ) no-error.
     2519     if error-status :error then do:
     2520       message
     2521         "Ошибка при вызове помощи"
     2522         error-status :get-message(1)
     2523         view-as alert-box .
     2524     end.
     2525   end.
     2526   run minbtn-set in this-procedure .
     2527   on choose of b-help in frame Dialog-Frame
     2528   do:
     2529     apply "help":u to frame Dialog-Frame .
     2530   end.
     2531   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2532   procedure minbtn-set :
     2533       do
     2534           on error undo, return error return-value
     2535           :
     2536           define variable ii              as integer       no-undo .
     2537           define variable fh              as widget-handle no-undo .
     2538           define variable hh              as widget-handle no-undo .
     2539           define variable v-h             as handle        extent 4 no-undo .
     2540           define variable v-name-button   as character     no-undo .
     2541           define variable v-help-old-x    as decimal       no-undo .
     2542           define variable v-help-old-y    as decimal       no-undo .
     2543           define variable v-help-old-size as decimal       no-undo .
     2544           define variable v-frame-width   as decimal       no-undo .
     2545           define variable jj              as integer       no-undo .
     2546           do
     2547               on error undo, return error
     2548               :
     2549               assign
     2550                   v-frame-width = frame Dialog-Frame:width - 0.3
     2551                   fh            = frame Dialog-Frame:first-child
     2552                   hh            = fh:first-child
     2553                   ii            = 1
     2554                   .
     2555               do while valid-handle(hh):
     2556                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2557                   do:
     2558                       case lc(hh:name) :
     2559                           when "b-help" then
     2560                               do:
     2561                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2562                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2563                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2564                                   hh:TOOLTIP = "Помощь" .
     2565                                   v-help-old-x = hh:column .
     2566                                   v-help-old-y = hh:row    .
     2567                                   v-help-old-size = hh:width .
     2568                                   hh:width-chars = 2.5 .
     2569                               end.
     2570                           when "b-print" then
     2571                               do:
     2572                                   hh:load-image("cmp/b-print.bmp":u) .
     2573                                   hh:TOOLTIP = "Печать" .
     2574                                   v-h[ii] = hh:handle .
     2575                                   ii = ii + 1 .
     2576                                   hh:width-chars = 3 .
     2577                               end.
     2578                           when "b-history" or
     2579                           when "b-hist" then
     2580                               do:
     2581                                   hh:load-image("cmp/b-hist.bmp":u) .
     2582                                   hh:TOOLTIP = "История" .
     2583                                   v-h[ii] = hh:handle .
     2584                                   ii = ii + 1 .
     2585                                   hh:width-chars = 3 .
     2586                               end.
     2587                           when "b-sch" then
     2588                               do:
     2589                                   hh:load-image("cmp/b-sch.bmp":u) .
     2590                                   hh:TOOLTIP = "Установка Фильтра" .
     2591                                   v-h[ii] = hh:handle .
     2592                                   ii = ii + 1 .
     2593                                   hh:width-chars = 3 .
     2594                               end.
     2595                           when "b-hist-user" then
     2596                               do:
     2597                                   hh:load-image("cmp/b-hist.bmp":u) .
     2598                                   hh:TOOLTIP = "История пользователя" .
     2599                                   ii = ii + 1 .
     2600                               end.
     2601                       end case.
     2602                   end.
     2603                   hh = hh:next-sibling.
     2604               end.
     2605               b-help:column = v-frame-width - b-help:width-chars.
     2606               jj = 0.
     2607               repeat ii = 4 to 1 by -1 :
     2608                   if valid-handle (v-h[ii] ) then
     2609                   do:
     2610                       jj  = jj + 1 .
     2611                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2612                       v-h[ii]:row    = v-help-old-y .
     2613                   end.
     2614               end.
     2615           end.
     2616       end.
     2617   end procedure.
     2618   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2619   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2620   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2621   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2622   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2623   define variable v-diasize-current-frame-height as decimal   no-undo .
     2624   define variable v-diasize-change-size          as logical   no-undo .
     2625   define variable v-diasize-resize-button        as handle    no-undo .
     2626   define variable v-diasize-wndmax               as logical   no-undo .
     2627   define variable v-diasize-wndstore             as logical   no-undo .
     2628   define variable v-diasize-proc-name            as character no-undo .
     2629   define variable v-diasize-browse-handle        as handle    no-undo .
     2630   define variable v-diasize-browse-number        as integer   no-undo .
     2631   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2632   define temp-table temp-diasize-handle no-undo
     2633     field handle-value  as handle
     2634     field save-position as decimal
     2635     index xpk is primary unique handle-value
     2636     .
     2637   define temp-table temp-browse-handle no-undo
     2638     field browse-type   as character
     2639     field browse-number as integer
     2640     field browse-handle as handle
     2641     field original-size as decimal
     2642     index xpk is primary unique browse-type browse-number
     2643     index xie browse-type browse-handle
     2644   .
     2645   procedure diasize_change-height :
     2646     define input  parameter p-change-value  as decimal   no-undo .
     2647     define input  parameter p-move-resize   as logical   no-undo .
     2648     define variable v-field-group-handle    as handle    no-undo .
     2649     define variable v-object-handle         as handle    no-undo .
     2650     define variable v-frame-height          as decimal   no-undo .
     2651     define variable v-frame-virtual-height  as decimal   no-undo .
     2652     define variable v-browse-height         as decimal   no-undo .
     2653     define variable v-window-height         as decimal   no-undo .
     2654     define variable v-window-virtual-height as decimal   no-undo .
     2655     define variable v-change-sign           as integer   no-undo .
     2656     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2657     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2658     if p-change-value > 0
     2659     then do:
     2660       if frame Dialog-Frame :height + p-change-value
     2661           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2662       then do:
     2663         assign
     2664           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2665                           - (frame Dialog-Frame :height-chars)
     2666         .
     2667         if p-change-value <= 0
     2668         then do:
     2669           run diasize_position-resize-button in this-procedure .
     2670           return .
     2671         end.
     2672       end.
     2673     end.
     2674     if p-change-value < 0
     2675     then do:
     2676       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2677       then do:
     2678         assign
     2679           p-change-value = v-diasize-orig-frame-height
     2680                          - (frame Dialog-Frame :height-chars)
     2681         .
     2682         if p-change-value >= 0
     2683         then do:
     2684           run diasize_position-resize-button in this-procedure .
     2685           return .
     2686         end.
     2687       end.
     2688     end.
     2689     if p-change-value >= 0
     2690     then do:
     2691       assign
     2692         v-change-sign = 1
     2693       .
     2694     end.
     2695     else do:
     2696       assign
     2697         v-change-sign = -1
     2698       .
     2699     end.
     2700     assign
     2701       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2702     .
     2703     if p-change-value = 0
     2704     then do:
     2705       run diasize_position-resize-button in this-procedure .
     2706       return .
     2707     end.
     2708     move_block:
     2709     do
     2710     on error undo move_block, retry move_block
     2711     :
     2712       if retry
     2713       then do:
     2714         do
     2715         on error undo move_block, leave move_block
     2716         :
     2717           if p-change-value > 0
     2718           then do:
     2719             for each buf_temp-diasize-handle
     2720             on error undo, next
     2721             :
     2722               assign
     2723                 v-object-handle = buf_temp-diasize-handle.handle-value
     2724               .
     2725               if v-object-handle <> v-diasize-resize-button
     2726               then do:
     2727                 assign
     2728                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2729                 .
     2730               end.
     2731             end.
     2732             assign
     2733               v-diasize-browse-handle :height = v-browse-height
     2734             .
     2735             for each buf_temp-browse-handle
     2736               where buf_temp-browse-handle.browse-type = 'height':u
     2737             on error undo, next
     2738             :
     2739               assign
     2740                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2741               .
     2742             end.
     2743             assign
     2744               frame Dialog-Frame :height = v-frame-height
     2745             .
     2746             if frame Dialog-Frame :scrollable = true
     2747             then do:
     2748               assign
     2749                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2750               .
     2751             end.
     2752             run diasize_position-resize-button in this-procedure .
     2753           end.
     2754           else do:
     2755             if frame Dialog-Frame :scrollable = true
     2756             then do:
     2757               assign
     2758                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2759               .
     2760             end.
     2761             assign
     2762               frame Dialog-Frame :height = v-frame-height
     2763             .
     2764             assign
     2765               v-diasize-browse-handle :height = v-browse-height
     2766             .
     2767             for each buf_temp-browse-handle
     2768               where buf_temp-browse-handle.browse-type = 'height':u
     2769             on error undo, next
     2770             :
     2771               assign
     2772                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2773               .
     2774             end.
     2775             for each buf_temp-diasize-handle
     2776             on error undo, next
     2777             :
     2778               assign
     2779                 v-object-handle = buf_temp-diasize-handle.handle-value
     2780               .
     2781               if v-object-handle <> v-diasize-resize-button
     2782               then do:
     2783                 assign
     2784                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2785                 .
     2786               end.
     2787             end.
     2788             run diasize_position-resize-button in this-procedure .
     2789           end.
     2790           assign
     2791             v-diasize-change-size = false
     2792           .
     2793           leave move_block .
     2794         end.
     2795       end.
     2796       assign
     2797         v-diasize-need-full-display = true
     2798       .
     2799       if v-diasize-change-size = false
     2800       then do:
     2801         assign
     2802           v-diasize-change-size = true
     2803         .
     2804       end.
     2805       else do:
     2806         return .
     2807       end.
     2808       assign
     2809         v-frame-height = frame Dialog-Frame :height
     2810         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2811         v-browse-height = v-diasize-browse-handle :height
     2812       .
     2813       for each buf_temp-browse-handle
     2814         where buf_temp-browse-handle.browse-type = 'height':u
     2815       :
     2816         assign
     2817           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2818         .
     2819       end.
     2820       for each buf_temp-diasize-handle
     2821       :
     2822         delete buf_temp-diasize-handle .
     2823       end.
     2824       assign
     2825         v-field-group-handle = frame Dialog-Frame :first-child
     2826       .
     2827       do while valid-handle(v-field-group-handle)
     2828       :
     2829         assign
     2830           v-object-handle = v-field-group-handle :first-child
     2831         .
     2832         do while valid-handle(v-object-handle)
     2833         :
     2834           if  v-object-handle <> v-diasize-browse-handle :handle
     2835           and can-query(v-object-handle, "row")
     2836           and can-query(v-object-handle, "height")
     2837           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2838           then do:
     2839             find first buf_temp-browse-handle
     2840               where buf_temp-browse-handle.browse-type   = 'height':u
     2841                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2842               no-error .
     2843             if available buf_temp-browse-handle
     2844             then do:
     2845             end.
     2846             else do:
     2847               create buf_temp-diasize-handle .
     2848               assign
     2849                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2850                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2851               .
     2852             end.
     2853           end.
     2854           assign
     2855             v-object-handle = v-object-handle :next-sibling
     2856           .
     2857         end.
     2858         assign
     2859           v-field-group-handle = v-field-group-handle :next-sibling
     2860         .
     2861       end.
     2862       do with frame Dialog-Frame
     2863       :
     2864         hide v-diasize-resize-button .
     2865         assign
     2866           v-diasize-resize-button :row    = 1
     2867           v-diasize-resize-button :column = 1
     2868         .
     2869       end.
     2870       if p-change-value > 0
     2871       then do:
     2872         if frame Dialog-Frame :scrollable = true
     2873         then do:
     2874           assign
     2875             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2876             no-error .
     2877           if error-status :error
     2878           or error-status :get-message(1) <> ""
     2879           then do:
     2880             undo move_block, retry move_block .
     2881           end.
     2882         end.
     2883         assign
     2884           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2885           no-error .
     2886         if error-status :error
     2887         or error-status :get-message(1) <> ""
     2888         then do:
     2889           undo move_block, retry move_block .
     2890         end.
     2891         assign
     2892           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2893           no-error .
     2894         if error-status :error
     2895         or error-status :get-message(1) <> ""
     2896         then do:
     2897           undo move_block, retry move_block .
     2898         end.
     2899         for each buf_temp-browse-handle
     2900           where buf_temp-browse-handle.browse-type = 'height':u
     2901         on error undo move_block, retry move_block
     2902         :
     2903           assign
     2904             buf_temp-browse-handle.browse-handle :height
     2905               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2906             no-error .
     2907           if error-status :error
     2908           or error-status :get-message(1) <> ""
     2909           then do:
     2910             undo move_block, retry move_block .
     2911           end.
     2912         end.
     2913         for each buf_temp-diasize-handle
     2914         on error undo move_block, retry move_block
     2915         :
     2916           assign
     2917             v-object-handle = buf_temp-diasize-handle.handle-value
     2918           .
     2919           if v-object-handle <> v-diasize-resize-button
     2920           then do:
     2921             assign
     2922               v-object-handle :row = v-object-handle :row + p-change-value
     2923               no-error .
     2924             if error-status :error
     2925             or error-status :get-message(1) <> ""
     2926             then do:
     2927               undo move_block, retry move_block .
     2928             end.
     2929           end.
     2930         end.
     2931       end.
     2932       else do:
     2933         for each buf_temp-diasize-handle
     2934         on error undo move_block, retry move_block
     2935         :
     2936           assign
     2937             v-object-handle = buf_temp-diasize-handle.handle-value
     2938           .
     2939           if v-object-handle <> v-diasize-resize-button
     2940           then do:
     2941             assign
     2942               v-object-handle :row = v-object-handle :row + p-change-value
     2943               no-error .
     2944             if error-status :error
     2945             or error-status :get-message(1) <> ""
     2946             then do:
     2947               undo move_block, retry move_block .
     2948             end.
     2949           end.
     2950         end.
     2951         assign
     2952           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2953           no-error .
     2954         if error-status :error
     2955         or error-status :get-message(1) <> ""
     2956         then do:
     2957           undo move_block, retry move_block .
     2958         end.
     2959         for each buf_temp-browse-handle
     2960           where buf_temp-browse-handle.browse-type = 'height':u
     2961         on error undo move_block, retry move_block
     2962         :
     2963           assign
     2964             buf_temp-browse-handle.browse-handle :height
     2965               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2966             no-error .
     2967           if error-status :error
     2968           or error-status :get-message(1) <> ""
     2969           then do:
     2970             undo move_block, retry move_block .
     2971           end.
     2972         end.
     2973         assign
     2974           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2975           no-error .
     2976         if error-status :error
     2977         or error-status :get-message(1) <> ""
     2978         then do:
     2979           undo move_block, retry move_block .
     2980         end.
     2981         if frame Dialog-Frame :scrollable = true
     2982         then do:
     2983           assign
     2984             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2985             no-error .
     2986           if error-status :error
     2987           or error-status :get-message(1) <> ""
     2988           then do:
     2989             undo move_block, retry move_block .
     2990           end.
     2991         end.
     2992       end.
     2993       if p-move-resize = true
     2994       then do:
     2995         run diasize_position-resize-button in this-procedure .
     2996       end.
     2997       if v-diasize-wndstore = true
     2998       then do:
     2999         if connected("ub") = true
     3000         then do:
     3001           define variable v-cntxt-db-num        as integer   no-undo .
     3002           define variable v-cntxt-userid        as character no-undo .
     3003           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3004                                             , OUTPUT v-cntxt-userid
     3005                                             ) .
     3006           run gbl/wndsizew.p
     3007             (input  v-cntxt-db-num
     3008             ,input  v-cntxt-userid
     3009             ,input  v-diasize-proc-name
     3010             ,input  'height':u
     3011             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3012             ) .
     3013         end.
     3014       end.
     3015     end.
     3016     assign
     3017       v-diasize-change-size = false
     3018     .
     3019   end procedure.
     3020   procedure diasize_set-height :
     3021     define input  parameter p-new-height  as decimal   no-undo .
     3022     define input  parameter p-move-resize as logical   no-undo .
     3023     do
     3024     on error undo, return error return-value
     3025     :
     3026       run diasize_change-height in this-procedure
     3027         (input  (p-new-height - frame Dialog-Frame :height)
     3028         ,input  p-move-resize
     3029         ) .
     3030     end.
     3031   end procedure.
     3032   procedure diasize_change-width :
     3033     define input  parameter p-change-value as decimal   no-undo .
     3034     define input  parameter p-move-resize  as logical   no-undo .
     3035     define variable v-field-group-handle   as handle    no-undo .
     3036     define variable v-object-handle        as handle    no-undo .
     3037     define variable v-frame-width          as decimal   no-undo .
     3038     define variable v-frame-virtual-width  as decimal   no-undo .
     3039     define variable v-browse-width         as decimal   no-undo .
     3040     define variable v-window-width         as decimal   no-undo .
     3041     define variable v-window-virtual-width as decimal   no-undo .
     3042     define variable v-change-sign          as integer   no-undo .
     3043     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3044     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3045     if p-change-value > 0
     3046     then do:
     3047       if frame Dialog-Frame :width + p-change-value >
     3048           session :width-chars
     3049       then do:
     3050         assign
     3051           p-change-value = session :width-chars - frame Dialog-Frame :width
     3052         .
     3053         if p-change-value <= 0
     3054         then do:
     3055           run diasize_position-resize-button in this-procedure .
     3056           return .
     3057         end.
     3058       end.
     3059     end.
     3060     if p-change-value < 0
     3061     then do:
     3062       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3063       then do:
     3064         assign
     3065           p-change-value = v-diasize-orig-frame-width
     3066                          - frame Dialog-Frame :width
     3067         .
     3068         if p-change-value >= 0
     3069         then do:
     3070           run diasize_position-resize-button in this-procedure .
     3071           return .
     3072         end.
     3073       end.
     3074     end.
     3075     if p-change-value >= 0
     3076     then do:
     3077       assign
     3078         v-change-sign = 1
     3079       .
     3080     end.
     3081     else do:
     3082       assign
     3083         v-change-sign = -1
     3084       .
     3085     end.
     3086     assign
     3087       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3088     .
     3089     if p-change-value = 0
     3090     then do:
     3091       run diasize_position-resize-button in this-procedure .
     3092       return .
     3093     end.
     3094     move_block:
     3095     do
     3096     on error undo move_block, leave move_block
     3097     :
     3098       if retry
     3099       then do:
     3100         do
     3101         on error undo move_block, leave move_block
     3102         :
     3103           if p-change-value > 0
     3104           then do:
     3105             for each buf_temp-diasize-handle
     3106             on error undo, next
     3107             :
     3108               assign
     3109                 v-object-handle = buf_temp-diasize-handle.handle-value
     3110               .
     3111               if v-object-handle <> v-diasize-resize-button
     3112               then do:
     3113                 assign
     3114                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3115                 .
     3116               end.
     3117             end.
     3118             assign
     3119               v-diasize-browse-handle :width = v-browse-width
     3120             .
     3121             for each buf_temp-browse-handle
     3122               where buf_temp-browse-handle.browse-type = 'width':u
     3123             on error undo, next
     3124             :
     3125               assign
     3126                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3127               .
     3128             end.
     3129             assign
     3130               frame Dialog-Frame :width = v-frame-width
     3131             .
     3132             if frame Dialog-Frame :scrollable = true
     3133             then do:
     3134               assign
     3135                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3136               .
     3137             end.
     3138             run diasize_position-resize-button in this-procedure .
     3139           end.
     3140           else do:
     3141             if frame Dialog-Frame :scrollable = true
     3142             then do:
     3143               assign
     3144                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3145               .
     3146             end.
     3147             assign
     3148               frame Dialog-Frame :width = v-frame-width
     3149             .
     3150             for each buf_temp-browse-handle
     3151               where buf_temp-browse-handle.browse-type = 'width':u
     3152             on error undo, next
     3153             :
     3154               assign
     3155                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3156               .
     3157             end.
     3158             assign
     3159               v-diasize-browse-handle :width = v-browse-width
     3160             .
     3161             for each buf_temp-diasize-handle
     3162             on error undo, next
     3163             :
     3164               assign
     3165                 v-object-handle = buf_temp-diasize-handle.handle-value
     3166               .
     3167               if v-object-handle <> v-diasize-resize-button
     3168               then do:
     3169                 assign
     3170                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3171                 .
     3172               end.
     3173             end.
     3174             run diasize_position-resize-button in this-procedure .
     3175           end.
     3176           assign
     3177             v-diasize-change-size = false
     3178           .
     3179           leave move_block .
     3180         end.
     3181       end.
     3182       assign
     3183         v-diasize-need-full-display = true
     3184       .
     3185       if v-diasize-change-size = false
     3186       then do:
     3187         assign
     3188           v-diasize-change-size = true
     3189         .
     3190       end.
     3191       else do:
     3192         return .
     3193       end.
     3194       assign
     3195         v-frame-width = frame Dialog-Frame :width
     3196         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3197         v-browse-width = v-diasize-browse-handle :width
     3198       .
     3199       for each buf_temp-browse-handle
     3200         where buf_temp-browse-handle.browse-type = 'width':u
     3201       :
     3202         assign
     3203           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3204         .
     3205       end.
     3206       for each buf_temp-diasize-handle
     3207       :
     3208         delete buf_temp-diasize-handle .
     3209       end.
     3210       assign
     3211         v-field-group-handle = frame Dialog-Frame :first-child
     3212       .
     3213       do while valid-handle(v-field-group-handle)
     3214       :
     3215         assign
     3216           v-object-handle = v-field-group-handle :first-child
     3217         .
     3218         do while valid-handle(v-object-handle)
     3219         :
     3220           if  v-object-handle <> v-diasize-browse-handle :handle
     3221           and v-object-handle <> v-diasize-resize-button
     3222           and can-query(v-object-handle, "row")
     3223           and can-query(v-object-handle, "height")
     3224           and ( v-object-handle :col + v-object-handle :width
     3225                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3226               )
     3227           then do:
     3228             find first buf_temp-browse-handle
     3229               where buf_temp-browse-handle.browse-type   = 'width':u
     3230                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3231               no-error .
     3232             if available buf_temp-browse-handle
     3233             then do:
     3234             end.
     3235             else do:
     3236               create buf_temp-diasize-handle .
     3237               assign
     3238                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3239                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3240               .
     3241             end.
     3242           end.
     3243           assign
     3244             v-object-handle = v-object-handle :next-sibling
     3245           .
     3246         end.
     3247         assign
     3248           v-field-group-handle = v-field-group-handle :next-sibling
     3249         .
     3250       end.
     3251       do with frame Dialog-Frame
     3252       :
     3253         hide v-diasize-resize-button .
     3254         v-diasize-resize-button :row = 1.
     3255         v-diasize-resize-button :column = 1.
     3256       end.
     3257       if p-change-value > 0
     3258       then do:
     3259         if frame Dialog-Frame :scrollable = true
     3260         then do:
     3261           assign
     3262             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3263             no-error .
     3264           if error-status :error
     3265           or error-status :get-message(1) <> ""
     3266           then do:
     3267             undo move_block, retry move_block.
     3268           end.
     3269         end.
     3270         assign
     3271           frame Dialog-Frame :width = v-frame-width + p-change-value
     3272           no-error .
     3273         if error-status :error
     3274         or error-status :get-message(1) <> ""
     3275         then do:
     3276           undo move_block, retry move_block.
     3277         end.
     3278         assign
     3279           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3280         no-error .
     3281         if error-status :error
     3282         or error-status :get-message(1) <> ""
     3283         then do:
     3284           undo move_block, retry move_block.
     3285         end.
     3286         for each buf_temp-browse-handle
     3287           where buf_temp-browse-handle.browse-type = 'width':u
     3288         on error undo move_block, retry move_block
     3289         :
     3290           assign
     3291             buf_temp-browse-handle.browse-handle :width
     3292               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3293             no-error .
     3294           if error-status :error
     3295           or error-status :get-message(1) <> ""
     3296           then do:
     3297             undo move_block, retry move_block .
     3298           end.
     3299         end.
     3300         for each buf_temp-diasize-handle
     3301         on error undo move_block, retry move_block
     3302         :
     3303           assign
     3304             v-object-handle = buf_temp-diasize-handle.handle-value
     3305           .
     3306           if v-object-handle <> v-diasize-resize-button
     3307           then do:
     3308             assign
     3309               v-object-handle :col = v-object-handle :col + p-change-value
     3310               no-error .
     3311             if error-status :error
     3312             or error-status :get-message(1) <> ""
     3313             then do:
     3314               undo move_block, retry move_block .
     3315             end.
     3316           end.
     3317         end.
     3318       end.
     3319       else do:
     3320         for each buf_temp-diasize-handle
     3321         on error undo move_block, retry move_block
     3322         :
     3323           assign
     3324             v-object-handle = buf_temp-diasize-handle.handle-value
     3325           .
     3326           if v-object-handle <> v-diasize-resize-button
     3327           then do:
     3328             assign
     3329               v-object-handle :col = v-object-handle :col + p-change-value
     3330               no-error .
     3331             if error-status :error
     3332             or error-status :get-message(1) <> ""
     3333             then do:
     3334               undo move_block, retry move_block .
     3335             end.
     3336           end.
     3337         end.
     3338         for each buf_temp-browse-handle
     3339           where buf_temp-browse-handle.browse-type = 'width':u
     3340         on error undo move_block, retry move_block
     3341         :
     3342           assign
     3343             buf_temp-browse-handle.browse-handle :width
     3344               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3345             no-error .
     3346           if error-status :error
     3347           or error-status :get-message(1) <> ""
     3348           then do:
     3349             undo move_block, retry move_block .
     3350           end.
     3351         end.
     3352         assign
     3353           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3354           no-error .
     3355         if error-status :error
     3356         or error-status :get-message(1) <> ""
     3357         then do:
     3358           undo move_block, retry move_block.
     3359         end.
     3360         assign
     3361           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3362         no-error .
     3363         if error-status :error
     3364         or error-status :get-message(1) <> ""
     3365         then do:
     3366           undo move_block, retry move_block.
     3367         end.
     3368         if frame Dialog-Frame :scrollable = true
     3369         then do:
     3370           assign
     3371             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3372           no-error .
     3373           if error-status :error
     3374           or error-status :get-message(1) <> ""
     3375           then do:
     3376             undo move_block, retry move_block.
     3377           end.
     3378         end.
     3379       end.
     3380       if p-move-resize
     3381       then do:
     3382         run diasize_position-resize-button in this-procedure .
     3383       end.
     3384       if v-diasize-wndstore = true
     3385       then do:
     3386         if connected("ub") = true
     3387         then do:
     3388           define variable v-cntxt-db-num        as integer   no-undo .
     3389           define variable v-cntxt-userid        as character no-undo .
     3390           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3391                                             , OUTPUT v-cntxt-userid
     3392                                             ) .
     3393           run gbl/wndsizew.p
     3394             (input  v-cntxt-db-num
     3395             ,input  v-cntxt-userid
     3396             ,input  v-diasize-proc-name
     3397             ,input  'width':u
     3398             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3399             ) .
     3400         end.
     3401       end.
     3402     end.
     3403     assign
     3404       v-diasize-change-size = false
     3405     .
     3406   end procedure.
     3407   procedure diasize_set-width :
     3408     define input  parameter p-new-width  as decimal   no-undo .
     3409     define input  parameter p-move-resize as logical   no-undo .
     3410     do
     3411     on error undo, return error return-value
     3412     :
     3413       run diasize_change-width in this-procedure
     3414         (input  (p-new-width - frame Dialog-Frame :width)
     3415         ,input  p-move-resize
     3416         ) .
     3417     end.
     3418   end procedure.
     3419   procedure diasize_position-resize-button :
     3420     do with frame Dialog-Frame
     3421     :
     3422       hide v-diasize-resize-button .
     3423       assign
     3424         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3425                     - 1
     3426                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3427         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3428                     - 1
     3429                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3430       .
     3431       view v-diasize-resize-button .
     3432     end.
     3433   end procedure.
     3434   on alt-right anywhere
     3435   do:
     3436     run diasize_change-width in this-procedure
     3437       (input 1
     3438       ,input true
     3439       ) .
     3440     return no-apply .
     3441   end.
     3442   on alt-left anywhere
     3443   do:
     3444     run diasize_change-width in this-procedure
     3445       (input -1
     3446       ,input true
     3447       ) .
     3448     return no-apply .
     3449   end.
     3450   on alt-down anywhere
     3451   do:
     3452     run diasize_change-height in this-procedure
     3453       (input 1
     3454       ,input true
     3455       ) .
     3456     return no-apply .
     3457   end.
     3458   on alt-up anywhere
     3459   do:
     3460     run diasize_change-height in this-procedure
     3461       (input -1
     3462       ,input true
     3463       ) .
     3464     return no-apply .
     3465   end.
     3466   on alt-enter of frame Dialog-Frame
     3467   do:
     3468     run diasize_maximize in this-procedure
     3469       (input  ?
     3470       ).
     3471     return no-apply .
     3472   end.
     3473   procedure diasize_end-move :
     3474     do
     3475     on error undo, return error return-value
     3476     :
     3477       define variable v-row-delta as decimal   no-undo .
     3478       define variable v-col-delta as decimal   no-undo .
     3479       define variable v-new-row as decimal   no-undo .
     3480       define variable v-new-col as decimal   no-undo .
     3481       assign
     3482         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3483         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3484       .
     3485       assign
     3486         v-row-delta = v-new-row - frame Dialog-Frame :height
     3487         v-col-delta = v-new-col - frame Dialog-Frame :width
     3488       .
     3489       run diasize_change-height in this-procedure
     3490         (input v-row-delta
     3491         ,input true
     3492         ) .
     3493       run diasize_change-width in this-procedure
     3494         (input v-col-delta
     3495         ,input true
     3496         ) .
     3497     end.
     3498   end procedure.
     3499   procedure diasize_maximize :
     3500     define input  parameter p-action as logical   no-undo .
     3501     do
     3502     on error undo, return error return-value
     3503     :
     3504       if p-action = ?
     3505       then do:
     3506         if v-diasize-need-maximize = true
     3507         then do:
     3508           assign
     3509             p-action = true
     3510           .
     3511         end.
     3512         else do:
     3513           assign
     3514             p-action = false
     3515           .
     3516         end.
     3517       end.
     3518       if p-action = true
     3519       then do:
     3520         run diasize_change-height in this-procedure
     3521           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3522               - frame Dialog-Frame :height-chars
     3523           ,input true
     3524           ) .
     3525         run diasize_change-width in this-procedure
     3526           (input session :width-chars
     3527               - frame Dialog-Frame :width-chars
     3528           ,input true
     3529           ) .
     3530         assign
     3531           v-diasize-need-maximize = false
     3532         .
     3533       end.
     3534       else do:
     3535         run diasize_change-width in this-procedure
     3536           (input v-diasize-orig-frame-width
     3537               - frame Dialog-Frame :width-chars
     3538           ,input true
     3539           ) .
     3540         run diasize_change-height in this-procedure
     3541           (input v-diasize-orig-frame-height
     3542               - frame Dialog-Frame :height-chars
     3543           ,input true
     3544           ) .
     3545         assign
     3546           v-diasize-need-maximize = true
     3547         .
     3548       end.
     3549     end.
     3550   end procedure.
     3551   procedure diasize_restore-orig-size :
     3552     do
     3553     on error undo, return error return-value
     3554     :
     3555       assign
     3556         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3557         v-diasize-current-frame-height = frame Dialog-Frame :height
     3558       .
     3559       run diasize_set-height in this-procedure
     3560         (input  v-diasize-orig-frame-height
     3561         ,input  true
     3562         ) .
     3563       run diasize_set-width in this-procedure
     3564         (input  v-diasize-orig-frame-width
     3565         ,input  true
     3566         ) .
     3567     end.
     3568   end procedure.
     3569   procedure diasize_restore-current-size :
     3570     do
     3571     on error undo, return error return-value
     3572     :
     3573       run diasize_set-height in this-procedure
     3574         (input  v-diasize-current-frame-height
     3575         ,input  true
     3576         ) .
     3577       run diasize_set-width in this-procedure
     3578         (input  v-diasize-current-frame-width
     3579         ,input  true
     3580         ) .
     3581     end.
     3582   end procedure.
     3583   procedure diasize_set-browse-handle :
     3584     define input  parameter p-browse-handle as handle   no-undo .
     3585     define buffer buf_temp-browse-handle for temp-browse-handle .
     3586     do
     3587     on error undo, return error return-value
     3588     :
     3589       assign
     3590         v-diasize-browse-handle = p-browse-handle
     3591       .
     3592       for each buf_temp-browse-handle
     3593       on error undo, return error return-value
     3594       :
     3595         delete buf_temp-browse-handle .
     3596       end.
     3597     end.
     3598   end procedure.
     3599   procedure diasize_add_browse :
     3600     define input  parameter p-browse-type   as character no-undo .
     3601     define input  parameter p-browse-handle as handle    no-undo .
     3602     define buffer buf_temp-browse-handle for temp-browse-handle .
     3603     do
     3604     on error undo, return error return-value
     3605     :
     3606       assign
     3607         v-diasize-browse-number = v-diasize-browse-number + 1
     3608       .
     3609       create buf_temp-browse-handle .
     3610       assign
     3611         buf_temp-browse-handle.browse-type   = p-browse-type
     3612         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3613         buf_temp-browse-handle.browse-handle = p-browse-handle
     3614       .
     3615     end.
     3616   end procedure.
     3617   procedure diasize_init :
     3618     define variable v-default-value    as logical   no-undo .
     3619     define variable v-restore-saved    as logical   no-undo .
     3620     define variable v-resize-value-str as character no-undo .
     3621     do
     3622     on error undo, return error return-value
     3623     :
     3624       do with frame Dialog-Frame
     3625       :
     3626         assign
     3627           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3628           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3629           v-diasize-browse-handle     = browse BROWSE-2 :handle
     3630         .
     3631         create button v-diasize-resize-button
     3632         assign
     3633           parent        = frame Dialog-Frame :first-child
     3634           label         = "s"
     3635           height-pixels = 16
     3636           width-pixels  = 16
     3637           visible       = true
     3638           sensitive     = true
     3639           movable       = true
     3640           triggers:
     3641             on end-move persistent run diasize_end-move in this-procedure .
     3642           end triggers.
     3643         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3644         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3645         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3646         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3647         assign
     3648           v-diasize-wndmax = false
     3649         .
     3650         if connected("ub") = true
     3651         then do:
     3652           define variable v-cntxt-db-num        as integer   no-undo .
     3653           define variable v-cntxt-userid        as character no-undo .
     3654           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3655                                             , OUTPUT v-cntxt-userid
     3656                                             ) .
     3657           run gbl/wndpar_r.p
     3658             (input  v-cntxt-db-num
     3659             ,input  v-cntxt-userid
     3660             ,input  'wndmax':U
     3661             ,output v-diasize-wndmax
     3662             ,output v-default-value
     3663             ) .
     3664         end.
     3665         assign
     3666           v-diasize-wndstore = false
     3667         .
     3668         if connected("ub") = true
     3669         then do:
     3670           run gbl/wndpar_r.p
     3671             (input  v-cntxt-db-num
     3672             ,input  v-cntxt-userid
     3673             ,input  'wndstore':U
     3674             ,output v-diasize-wndstore
     3675             ,output v-default-value
     3676             ) .
     3677         end.
     3678         assign
     3679           v-diasize-proc-name = entry(1, program-name(2), '.')
     3680         .
     3681         if v-diasize-wndstore = true
     3682         then do:
     3683           assign
     3684             v-restore-saved = false
     3685           .
     3686           if connected("ub") = true
     3687           then do:
     3688             run gbl/wndsizer.p
     3689               (input  v-cntxt-db-num
     3690               ,input  v-cntxt-userid
     3691               ,input  v-diasize-proc-name
     3692               ,input  'height':u
     3693               ,output v-resize-value-str
     3694               ) .
     3695             if v-resize-value-str <> '':U
     3696             then do:
     3697               run diasize_change-height in this-procedure
     3698                 (input  integer(v-resize-value-str)
     3699                 ,input  true
     3700                 ) .
     3701               assign
     3702                 v-restore-saved = true
     3703               .
     3704             end.
     3705           end.
     3706           if connected("ub") = true
     3707           then do:
     3708             run gbl/wndsizer.p
     3709               (input  v-cntxt-db-num
     3710               ,input  v-cntxt-userid
     3711               ,input  v-diasize-proc-name
     3712               ,input  'width':u
     3713               ,output v-resize-value-str
     3714               ) .
     3715             if v-resize-value-str <> '':U
     3716             then do:
     3717               run diasize_change-width in this-procedure
     3718                 (input  integer(v-resize-value-str)
     3719                 ,input  true
     3720                 ) .
     3721               assign
     3722                 v-restore-saved = true
     3723               .
     3724             end.
     3725           end.
     3726           if v-restore-saved <> true
     3727           then do:
     3728             if v-diasize-wndmax = true
     3729             then do:
     3730               run diasize_maximize in this-procedure
     3731                 (input  true
     3732                 ) .
     3733             end.
     3734           end.
     3735         end.
     3736         else do:
     3737           if v-diasize-wndmax = true
     3738           then do:
     3739             run diasize_maximize in this-procedure
     3740               (input  true
     3741               ) .
     3742           end.
     3743         end.
     3744       end.
     3745     end.
     3746   end procedure.
     3747   procedure diasize_need-full-display :
     3748     define output parameter p-need-full-display as logical   no-undo .
     3749     do
     3750     on error undo, return error return-value
     3751     :
     3752       assign
     3753         p-need-full-display = v-diasize-need-full-display
     3754       .
     3755       assign
     3756         v-diasize-need-full-display = false
     3757       .
     3758     end.
     3759   end procedure.
     3760   procedure get-context :
     3761      define output parameter p-db-num as integer          no-undo.
     3762      define output parameter p-user-id as character        no-undo.
     3763      define variable v-login               as character    no-undo.
     3764      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3765      define buffer buf_user-login  for ub.user-login .
     3766      do
     3767      on error undo, return error
     3768      :
     3769            FIND FIRST buf_sys-ctrl no-lock.
     3770            ASSIGN
     3771               v-login = USERID("ub")
     3772               p-db-num = buf_sys-ctrl.db-num
     3773            .
     3774            FIND FIRST buf_user-login
     3775                 WHERE buf_user-login.db-num = p-db-num
     3776                   AND buf_user-login.user-login = v-login
     3777                 no-lock
     3778                 no-error
     3779                 .
     3780            IF AVAILABLE buf_user-login
     3781            THEN DO:
     3782               assign
     3783                  p-user-id = buf_user-login.user-id
     3784               .
     3785            END.
     3786      end.
     3787   end procedure.
     3788       run diasize_init in this-procedure .
     3789   def var sort-labelBROWSE-2   as character no-undo .
     3790   def var sort-clmnBROWSE-2    as handle    no-undo .
     3791   def var cur-clmnBROWSE-2     as handle    no-undo .
     3792   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     3793   def var re-queryBROWSE-2     as logical   initial no no-undo .
     3794   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     3795      run sort-brBROWSE-2
     3796        (input (if available x_parts
     3797                then recid(x_parts)
     3798                else ?
     3799               )
     3800        ).
     3801   end.
     3802   PROCEDURE sort-brBROWSE-2 :
     3803     define input parameter p-recid as recid no-undo .
     3804     if re-queryBROWSE-2 = no then do:
     3805       assign
     3806          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     3807       .
     3808       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     3809       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     3810         assign
     3811            sort-labelBROWSE-2 = ""
     3812            sort-clmnBROWSE-2 = ?
     3813         .
     3814        end.
     3815        else do:
     3816          assign
     3817            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     3818            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     3819            sort-clmnBROWSE-2:column-fgcolor = 4
     3820          .
     3821        end.
     3822      end.
     3823     assign
     3824       cur-clmn-locBROWSE-2 = 1
     3825     .
     3826     def var column-handle as handle no-undo .
     3827     column-handle = BROWSE-2:first-column.
     3828     do while valid-handle(column-handle) :
     3829       if column-handle = cur-clmnBROWSE-2 then do:
     3830         leave .
     3831       end.
     3832       column-handle = column-handle:NEXT-COLUMN.
     3833       assign
     3834         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     3835       .
     3836     end.
     3837     case sort-labelBROWSE-2:
     3838           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(x_parts), &1&2&1)', chr(34), rid-list)     .     run OpenBr (yes, no, '':U).   . END.
     3839           when 'Артикул! '  then DO:    assign       sort-column-name = "x_parts.artic"     .     run OpenBr (yes, no, '':U).   . END.
     3840           when 'Серия!№ партии'  then DO:    assign       sort-column-name = "x_parts.part-code"     .     run OpenBr (yes, no, '':U).   . END.
     3841           when 'Бар-код!партии'  then DO:    assign       sort-column-name = "Buf_bar-code.b-code"     .     run OpenBr (yes, no, '':U).   . END.
     3842           when 'Наименование!товара'  then DO:    assign       sort-column-name = "Buf_goods.gds-name"     .     run OpenBr (yes, no, '':U).   . END.
     3843           when 'Дата ПН! '  then DO:    assign       sort-column-name = "x_parts.fact-date"     .     run OpenBr (yes, no, '':U).   . END.
     3844           when 'Остатки!количество'  then DO:    assign       sort-column-name = "x_parts.fact-qnty"     .     run OpenBr (yes, no, '':U).   . END.
     3845           when '№ ПН! '  then DO:    assign       sort-column-name = "x_parts.in-code"     .     run OpenBr (yes, no, '':U).   . END.
     3846           when 'Последний срок!реализации'  then DO:    assign       sort-column-name = "x_parts.last-date"     .     run OpenBr (yes, no, '':U).   . END.
     3847           when 'Цена!Производителя'  then DO:    assign       sort-column-name = "x_parts.dop"     .     run OpenBr (yes, no, '':U).   . END.
     3848           when 'ФиБ! '  then DO:    assign       sort-column-name = "x_parts.defect"     .     run OpenBr (yes, no, '':U).   . END.
     3849           when 'Цена!(вал.пост)'  then DO:    assign       sort-column-name = "x_parts.price-cli"     .     run OpenBr (yes, no, '':U).   . END.
     3850           when 'Цена уч!руб'  then DO:    assign       sort-column-name = "x_parts.price-rubl"     .     run OpenBr (yes, no, '':U).   . END.
     3851           when 'Объект!тип'  then DO:    assign       sort-column-name = "x_parts.obj-type"     .     run OpenBr (yes, no, '':U).   . END.
     3852           when 'Объект!код'  then DO:    assign       sort-column-name = "x_parts.obj-code"     .     run OpenBr (yes, no, '':U).   . END.
     3853           when 'Тип!НДС'  then DO:    assign       sort-column-name = "x_parts.vat-type"     .     run OpenBr (yes, no, '':U).   . END.
     3854           when '%!НДС'  then DO:    assign       sort-column-name = "x_parts.vat-pc"     .     run OpenBr (yes, no, '':U).   . END.
     3855           when 'Объект!Название'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-obj-name&1, recid(x_parts))', chr(34))     .     run OpenBr (yes, no, '':U).   . END.
     3856       otherwise do:
     3857         assign
     3858           sort-column-name = ""
     3859         .
     3860         run OpenBr (yes, no, '':U).
     3861         if sort-labelBROWSE-2 <> "" then do:
     3862           assign
     3863             cur-clmnBROWSE-2:column-fgcolor = 0
     3864           .
     3865         end.
     3866         assign
     3867           cur-clmn-locBROWSE-2 = ?
     3868         .
     3869       end.
     3870     end case.
     3871     if p-recid <> ? then do:
     3872       reposition BROWSE-2 to recid p-recid no-error.
     3873       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     3874     end.
     3875     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     3876   END PROCEDURE.
     3877   procedure re-open-query-srt-clmnBROWSE-2:
     3878   if cur-clmnBROWSE-2 = ? then do:
     3879      run OpenBr (yes, no, '':U).
     3880   end.
     3881   else do:
     3882      assign re-queryBROWSE-2 = yes.
     3883      run sort-brBROWSE-2
     3884        (input (if available x_parts
     3885                then recid(x_parts)
     3886                else ?
     3887               )
     3888        ).
     3889      assign re-queryBROWSE-2 = no.
     3890   end.
     3891   end.
     3892   MAIN-BLOCK:
     3893   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3894      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3895     run ini-proc.
     3896     run my_enable.
     3897     run OpenBR in this-procedure (yes, no, '':U).
     3898     WAIT-FOR GO OF FRAME Dialog-Frame.
     3899   END.
     3900   RUN disable_UI.
     3901   PROCEDURE cb_choice-obj :
     3902   define output parameter p-obj-type as character no-undo .
     3903   define output parameter p-obj-code as integer   no-undo .
     3904   define output parameter p-obj-name as character no-undo .
     3905   define buffer Post-clients for ub.clients  .
     3906   define variable rid-list as character no-undo .
     3907   define variable v-hostcode as integer   no-undo .
     3908     run ref/cli-all.w ( input parParentProc, input "b-sel", 'объект':U , ?, ?, ?, ?, ?, output  rid-list ) no-error .
     3909     if num-entries (rid-list) < 1 then return error return-value .
     3910     find first post-clients no-lock  where recid (post-clients) = integer(rid-list)  no-error.
     3911     if available post-clients then do:
     3912         assign
     3913             p-obj-code = Post-clients.obj-code
     3914             p-obj-type = Post-clients.obj-type
     3915             p-obj-name = post-clients.obj-name
     3916         .
     3917   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3918   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3919     (input  p-obj-type
     3920     ,input  p-obj-code
     3921     ,output v-hostcode
     3922     )  .
     3923           if v-hostcode <> v-cntxt-host-code-obj then do:
     3924               assign
     3925                   p-obj-code = ?
     3926                   p-obj-type = ?
     3927                   p-obj-name = ?
     3928               .
     3929             return error "Не верно выбран объект для перемещения, он должен быть той же фирмы " .
     3930           end.
     3931       end.
     3932       else do:
     3933             assign
     3934                 p-obj-code = ?
     3935                 p-obj-type = ?
     3936                 p-obj-name = ?
     3937           .
     3938           return error  "Не верно выбран объект" .
     3939       end.
     3940   END PROCEDURE.
     3941   PROCEDURE disable_UI :
     3942     HIDE FRAME Dialog-Frame.
     3943   END PROCEDURE.
     3944   PROCEDURE enable_UI :
     3945     DISPLAY R-sort v-sort-pole R-obj FILL-IN-1 FILL-IN-2 mark-num
     3946         WITH FRAME Dialog-Frame.
     3947     ENABLE BROWSE-2 b-Cancel b-add-2 b-add b-del-2 b-del b-impotr-www b-make-trn
     3948            b-report b-make-add b-clear b-sch b-print b-help R-sort v-sort-pole
     3949            R-obj b-mark b-mark-all FILL-IN-1 b-del-mark FILL-IN-2 mark-num
     3950         WITH FRAME Dialog-Frame.
     3951     VIEW FRAME Dialog-Frame.
     3952     OPEN QUERY BROWSE-2 FOR EACH x_parts NO-LOCK,              EACH Buf_goods OF x_parts NO-LOCK,              EACH Buf_bar-code WHERE            Buf_bar-code.gds-code  = Buf_goods.gds-code and            Buf_bar-code.in-code   = x_parts.in-code and            Buf_bar-code.part-code = x_parts.part-code            NO-LOCK INDEXED-REPOSITION.
     3953   END PROCEDURE.
     3954   PROCEDURE gds-rec-proc :
     3955     gds-rec = recid (buf_goods) no-error .
     3956   END PROCEDURE.
     3957   PROCEDURE ini-proc :
     3958   define variable v-today as date      no-undo .
     3959   define variable v-time as integer   no-undo .
     3960   define variable v-value-character  as character no-undo .
     3961   define variable v-value-decimal    as decimal   no-undo .
     3962   define variable v-value-integer    as integer   no-undo .
     3963   define variable v-value-logical    as logical   no-undo .
     3964   define variable v-value-type       as character no-undo .
     3965   define variable v-value-date       as date      no-undo .
     3966   define variable v-pharm as character no-undo .
     3967   define variable var-type as character no-undo .
     3968   rid-list = "".
     3969     r-obj = p-obj.
     3970     display r-obj with frame Dialog-Frame .
     3971   empty temp-table temp-obj.
     3972   if r-obj = 1 then do:
     3973   for each ub.clients no-lock where ub.clients.host-code <> 0 and ub.clients.host-code <> ? :
     3974     RUN clntattr-value IN THIS-PROCEDURE
     3975       (INPUT ub.clients.obj-type,
     3976        INPUT ub.clients.obj-code,
     3977        input 'pharm':U,
     3978        OUTPUT v-pharm,
     3979        OUTPUT var-type).
     3980     IF v-pharm = "yes":u THEN DO:
     3981       create temp-obj.
     3982       assign
     3983         temp-obj.obj-code = ub.clients.obj-code
     3984         temp-obj.obj-type = ub.clients.obj-type
     3985       .
     3986     end.
     3987   end.
     3988   end.
     3989   else do:
     3990       create temp-obj.
     3991       assign
     3992         temp-obj.obj-code = p-obj-code
     3993         temp-obj.obj-type = p-obj-type
     3994       .
     3995   end.
     3996   x_parts.artic:read-only in browse BROWSE-2 = true .
     3997   x_parts.artic:resizable in browse BROWSE-2   = true .
     3998   x_parts.part-code:resizable in browse BROWSE-2   = true .
     3999   buf_goods.gds-name:resizable in browse BROWSE-2   = true .
     4000   buf_goods.gds-name:width in browse BROWSE-2       = 20 .
     4001   vf-obj-name:resizable in browse BROWSE-2   = true .
     4002   vf-obj-name:width in browse BROWSE-2       = 14 .
     4003   vf-cli-name:resizable in browse BROWSE-2   = true .
     4004   vf-cli-name:width in browse BROWSE-2       = 25 .
     4005     empty temp-table thbjattr_thbj-attr .
     4006    v-srok = 0.
     4007    case p-mode :
     4008    when "defect" then do:
     4009       if R-obj = 1  then do:
     4010          frame Dialog-Frame:TITLE = substitute("ВСЕ Фальсифицированные и бракованные партии ") .
     4011       end.
     4012       else do:
     4013          frame Dialog-Frame:TITLE = substitute("Фальсифицированные и бракованные партии на объекте &1&2",p-obj-type,p-obj-code) .
     4014       end.
     4015       run make-defect in this-procedure .
     4016     end.
     4017    when "add-new-fib" then do:
     4018        if R-obj = 1  then do:
     4019           frame Dialog-Frame:TITLE = substitute("Создание  списка парий  по всем объектам") .
     4020        end.
     4021        else do:
     4022           frame Dialog-Frame:TITLE = substitute("Создание  списка парий   на объекте  &1&2",p-obj-type,p-obj-code) .
     4023        end.
     4024        run make-new in this-procedure .
     4025     end.
     4026     when "srok" then do:
     4027       run adm/shattri.p (
     4028          input "get":U
     4029         ,input v-cntxt-obj-type
     4030         ,input v-cntxt-obj-code
     4031         ,input 'Ass-obj':U
     4032         ,input 'crit-srokgod':U
     4033         ,output v-value-character
     4034         ,output v-value-date
     4035         ,output v-value-decimal
     4036         ,output v-srok
     4037         ,output v-value-logical
     4038         ,output v-value-type
     4039         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4040         ) no-error .
     4041           run cur-time in this-procedure (
     4042                 output v-today
     4043               , output v-time
     4044           ).
     4045           run godendo-offset-to-date in this-procedure (
     4046                 input  v-today
     4047               , input  v-srok
     4048               , output v-srok-date
     4049           ).
     4050           if R-obj = 1  then do:
     4051              frame Dialog-Frame:TITLE = substitute ("Товары с истекающим сроком годности до &1 ", string (v-srok-date,"99/99/9999" )).
     4052           end.
     4053           else do:
     4054              frame Dialog-Frame:TITLE = substitute ("Товары с истекающим сроком годности до &3 на объекте &1&2", p-obj-type, p-obj-code, string (v-srok-date,"99/99/9999" )).
     4055           end.
     4056           run make-srok in this-procedure .
     4057        end.
     4058     end case.
     4059   END PROCEDURE.
     4060   PROCEDURE make-defect :
     4061   empty temp-table x_parts.
     4062   define buffer buf_parts for ub.parts  .
     4063   for each temp-obj,
     4064      each buf_parts no-lock where
     4065              buf_parts.obj-type = temp-obj.obj-type and
     4066              buf_parts.obj-code = temp-obj.obj-code and
     4067              buf_parts.defect = logical('yes':U) and
     4068              buf_parts.out-code = 'free-zone':U :
     4069         create x_parts.
     4070         buffer-copy buf_parts to x_parts.
     4071     end.
     4072   END PROCEDURE.
     4073   PROCEDURE make-new :
     4074   empty temp-table x_parts.
     4075   define buffer buf_parts for ub.parts  .
     4076   END PROCEDURE.
     4077   PROCEDURE make-srok :
     4078   empty temp-table x_parts.
     4079   define buffer buf_parts for ub.parts  .
     4080    for each temp-obj,
     4081        each buf_parts no-lock where
     4082              buf_parts.obj-type = temp-obj.obj-type and
     4083              buf_parts.obj-code = temp-obj.obj-code and
     4084              buf_parts.last-date <= v-srok-date and
     4085              buf_parts.out-code = 'free-zone':U :
     4086         create x_parts.
     4087         buffer-copy buf_parts to x_parts.
     4088     end.
     4089   END PROCEDURE.
     4090   PROCEDURE my_enable :
     4091     display FILL-IN-1 FILL-IN-2 WITH FRAME Dialog-Frame.
     4092     ENABLE b-Cancel b-mark b-add b-add-2 b-del b-del-2 b-impotr-www b-make-trn  b-sch
     4093            b-print b-help BROWSE-2 b-mark-all b-del-mark
     4094            r-sort v-sort-pole b-report
     4095         WITH FRAME Dialog-Frame.
     4096     VIEW FRAME Dialog-Frame.
     4097    case p-mode :
     4098    when "defect" then do:
     4099     hide b-clear b-make-add in frame Dialog-Frame .
     4100     end.
     4101    when "add-new-fib" then do:
     4102        hide b-del b-del-2 b-add b-add-2 b-make-trn b-impotr-www b-mark b-mark-all  b-del-mark b-sch b-print b-report  in frame Dialog-Frame .
     4103        enable b-clear b-make-add with frame Dialog-Frame .
     4104     end.
     4105     when "srok" then do:
     4106       hide b-del b-del-2 b-add b-add-2 b-make-trn b-impotr-www b-mark b-del-mark b-mark-all b-clear b-make-add   in frame Dialog-Frame .
     4107     end.
     4108     end case.
     4109   END PROCEDURE.
     4110   PROCEDURE OpenBr :
     4111   define input  parameter p-open-query     as logical   no-undo .
     4112   define input  parameter p-find-next      as logical   no-undo .
     4113   define input  parameter p-find-condition as character no-undo .
     4114   define variable v-find-condition as character no-undo .
     4115   define variable l-query-was-opened as logical no-undo .
     4116   define variable title0 as character no-undo.
     4117   define variable sort-column-phrase as character no-undo .
     4118   case sort-column-name :
     4119     when "" then do:
     4120       assign
     4121         sort-column-phrase = ""
     4122       .
     4123     end.
     4124     otherwise do:
     4125       assign
     4126         sort-column-phrase = "by " + sort-column-name
     4127       .
     4128     end.
     4129   end case.
     4130   define variable l-open-query as logical   no-undo .
     4131   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4132   define variable  l-disable-where-30  as logical   no-undo .
     4133   define variable  l-filter-open-30    as logical   .
     4134   define variable  flt-rec-30       as recid     no-undo .
     4135   define variable  filter-name-30      as character no-undo .
     4136   define variable  where-phrase-30     as character no-undo .
     4137   define variable  sort-phrase-30      as character no-undo .
     4138   define variable  where-phrase-rus-30 as character no-undo .
     4139   define variable  sort-phrase-rus-30  as character no-undo .
     4140     run waitfram-show in this-procedure
     4141       (input "ЖДИТЕ ..."
     4142       ).
     4143   run gbl/flt-get.p
     4144     (input filter-point
     4145     ,output flt-rec-30
     4146     ,output filter-name-30
     4147     ,output where-phrase-30
     4148     ,output sort-phrase-30
     4149     ,output where-phrase-rus-30
     4150     ,output sort-phrase-rus-30
     4151     ).
     4152   if p-open-query then do:
     4153       run set-filter-name in this-procedure
     4154         (INPUT filter-name-30
     4155         ) no-error .
     4156     assign
     4157       l-filter-open-30 = false
     4158     .
     4159     if flt-rec-30 <> ?
     4160       or sort-column-phrase > ""
     4161     then do:
     4162       define variable  parameter-2-30 as character no-undo .
     4163       define variable  parameter-3-30 as character no-undo .
     4164       define variable  parameter-4-30 as character no-undo .
     4165       define variable  parameter-5-30 as character no-undo .
     4166       define variable  parameter-6-30 as character no-undo .
     4167       define variable  parameter-7-30 as character no-undo .
     4168         assign
     4169         parameter-3-30 =
     4170                                 "FOR EACH x_parts"
     4171         parameter-4-30 =
     4172           (
     4173             if (" true = true  " + " " + where-phrase-30) <> ""
     4174             then " true = true  " + " " + where-phrase-30
     4175             else "true"
     4176           )
     4177         parameter-5-30 = (" " + "" + " " + substitute(', EACH Buf_goods OF x_parts NO-LOCK,   EACH Buf_bar-code WHERE   BUF_bar-code.gds-code  = BUF_goods.gds-code and    BUF_bar-code.in-code   = x_parts.in-code and    BUF_bar-code.part-code = x_parts.part-code     ' , chr(34)  ))
     4178         parameter-6-30 = if sort-phrase-30 = ''
     4179                              then
     4180           (
     4181           " " + " " +
     4182             " " + sort-column-phrase +
     4183           " " + " "
     4184           )
     4185                              else
     4186           (
     4187           " " + " " +
     4188             " " + sort-column-phrase +
     4189           " " + sort-phrase-30
     4190           )
     4191         parameter-7-30 =
     4192           "   "
     4193       .
     4194       do
     4195       on stop undo, leave
     4196       on error undo, leave
     4197       :
     4198         assign
     4199           l-disable-where-30 =
     4200             (" true = true  " + " " + where-phrase-30 = "")
     4201         .
     4202         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4203                             ,input query BROWSE-2:handle
     4204                             ,input parameter-3-30
     4205                             ,input parameter-4-30
     4206                             ,input parameter-5-30
     4207                             ,input parameter-6-30
     4208                             ,input parameter-7-30
     4209                             )
     4210         .
     4211         assign
     4212           l-filter-open-30 = true
     4213         .
     4214       end.
     4215       if l-filter-open-30 = false then do:
     4216         message
     4217           "Ошибка при фильтрации / сортировке" skip
     4218           "Будут показаны записи без учета фильтра" skip
     4219           view-as alert-box .
     4220       end.
     4221       else do:
     4222           assign
     4223             l-query-was-opened = true
     4224           .
     4225       end.
     4226     end.
     4227     if l-filter-open-30 = false then do:
     4228       OPEN QUERY BROWSE-2 FOR EACH x_parts no-lock
     4229         where  true = true
     4230       , EACH Buf_goods OF x_parts NO-LOCK,   EACH Buf_bar-code WHERE   Buf_bar-code.gds-code  = Buf_goods.gds-code and    Buf_bar-code.in-code   = x_parts.in-code and    Buf_bar-code.part-code = x_parts.part-code
     4231     .
     4232         assign
     4233           l-query-was-opened = true
     4234         .
     4235     end.
     4236   end.
     4237   else do:
     4238     assign
     4239       doc-rec = recid( x_parts )
     4240     .
     4241     do
     4242     on stop undo, leave
     4243     on error undo, leave
     4244     :
     4245       if query BROWSE-2:handle:get-buffer-handle(1) = (buffer x_parts:handle) then do:
     4246         assign
     4247         parameter-2-30 = (if p-find-next then "true":u else "false":u )
     4248         parameter-4-30 =
     4249           "where ":u + " true = true  " + " ":u + where-phrase-30 + " ":u + p-find-condition + " " + ""
     4250         parameter-5-30 = " "
     4251       .
     4252         run fltopend_fltfindd in this-procedure  (
     4253                             input this-procedure:handle
     4254                             ,input query BROWSE-2:handle
     4255                             ,input rowid(x_parts)
     4256                             ,input logical(parameter-2-30)
     4257                             ,input no-lock
     4258                             ,input (buffer x_parts:handle)
     4259                             ,input parameter-4-30
     4260                             ,input parameter-5-30
     4261                             ) no-error.
     4262         .
     4263         assign
     4264           doc-rec = integer(return-value)
     4265           v-fltopend-rowid[1] = ?
     4266         .
     4267       end.
     4268       else do:
     4269         assign
     4270         parameter-2-30 = (if p-find-next then "true":u else "false":u )
     4271         parameter-3-30 =  "FOR EACH x_parts"
     4272         parameter-4-30 =
     4273           (
     4274             if (" true = true  " + " " + where-phrase-30) <> ""
     4275             then " true = true  " + " " + where-phrase-30
     4276             else "true"
     4277           )
     4278         parameter-5-30 = (" " + "" + " " + substitute(', EACH Buf_goods OF x_parts NO-LOCK,   EACH Buf_bar-code WHERE   BUF_bar-code.gds-code  = BUF_goods.gds-code and    BUF_bar-code.in-code   = x_parts.in-code and    BUF_bar-code.part-code = x_parts.part-code     ' , chr(34)  ) + " " + p-find-condition)
     4279         parameter-6-30 = if sort-phrase-30 = ''
     4280                              then
     4281           (
     4282           " " + " " +
     4283             " " + sort-column-phrase +
     4284           " " + " "
     4285           )
     4286                              else
     4287           (
     4288           " " + " " +
     4289             " " + sort-column-phrase +
     4290           " " + sort-phrase-30
     4291           )
     4292         parameter-7-30 =
     4293           "   "
     4294       .
     4295         run fltopend_fltfindq in this-procedure  (
     4296                             input this-procedure:handle
     4297                             ,input query BROWSE-2:handle
     4298                             ,input logical(parameter-2-30)
     4299                             ,input no-lock
     4300                             ,input parameter-3-30
     4301                             ,input parameter-4-30
     4302                             ,input parameter-5-30
     4303                             ,input parameter-6-30
     4304                             ,input parameter-7-30
     4305                             ,output v-fltopend-rowid
     4306                             ) no-error.
     4307         .
     4308         doc-rec = ?.
     4309       end.
     4310       assign
     4311         l-query-was-opened = true
     4312       .
     4313     end.
     4314   end.
     4315     run waitfram-hide in this-procedure .
     4316   if not p-open-query then do:
     4317    reposition BROWSE-2  to recid doc-rec no-error.
     4318    end.
     4319   if not p-open-query and v-fltopend-rowid[1] <> ? then do:
     4320      query BROWSE-2:handle:reposition-to-rowid(v-fltopend-rowid) no-error.
     4321   end.
     4322   END PROCEDURE.
     4323   PROCEDURE proc-b-sch :
     4324   assign
     4325     tbl = 'parts'
     4326     join-tbl = 'x_parts'
     4327     fld = ""
     4328     lab = ""
     4329     spr = ""
     4330     dim = '0'
     4331     .
     4332     run fltfield-add in this-procedure('in-code', 'Номер ПН', '',
     4333     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4334     run fltfield-add in this-procedure('part-code', 'Номер/Серия партии', '',
     4335     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4336       run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     4337     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4338     run fltfield-add in this-procedure('supp-type*supp-code', 'Поставщик', 'cli',
     4339     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4340     run fltfield-add in this-procedure('prod-type*prod-code', 'Производитель', 'cli',
     4341     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4342     run fltfield-add in this-procedure('qnty', 'Кол.док.', '',
     4343     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4344     run fltfield-add in this-procedure('fact-qnty', 'Факт.кол.', '',
     4345     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4346     run fltfield-add in this-procedure('fact-date', 'Дата', '',
     4347     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4348     run fltfield-add in this-procedure('pay-code', 'Код Оплаты', 'pay',
     4349     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4350     run fltfield-add in this-procedure('whole-send-news', 'ФиБ', '',
     4351     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4352     run fltfield-add in this-procedure('price-base', 'Цена (вал)', '',
     4353     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4354     run fltfield-add in this-procedure('price-rubl', 'Цена (руб)', '',
     4355     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4356     run fltfield-add in this-procedure('price-cli', 'Цена пост. (вал)', '',
     4357     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4358     run fltfield-add in this-procedure('exch-code', 'Валюта пост.', 'curr',
     4359     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4360     run fltfield-add in this-procedure('dop', 'Цена производителя', '',
     4361     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4362     run fltfield-add in this-procedure('cst-code', 'ГТД', '',
     4363     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4364     run fltfield-add in this-procedure('last-date', 'Срок годности', '',
     4365     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4366     run fltfield-add in this-procedure('vat-type', 'Тип НДС', '',
     4367     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4368     run fltfield-add in this-procedure('vat-pc', '% НДС', '',
     4369     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4370     run fltfield-add in this-procedure('contract-code', 'Договор', '',
     4371     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4372     run fltfield-add in this-procedure('pl-code', 'Место хранения', '',
     4373     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4374   Filter-Block:
     4375   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4376       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4377       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4378     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     4379     run OpenBr in this-procedure (yes, no, '':U).
     4380   END.
     4381   END PROCEDURE.
     4382   PROCEDURE proc-find-artic :
     4383   define input parameter par-next as logical no-undo.
     4384   define input parameter p-var    as char no-undo.
     4385     doc-rec = ? .
     4386     if par-next = true
     4387     then find next   x_parts no-lock where  x_parts.artic = p-var no-error  .
     4388     else find first  x_parts no-lock where  x_parts.artic = p-var no-error  .
     4389     if available x_parts then doc-rec = recid(x_parts) .
     4390     reposition BROWSE-2 to recid doc-rec no-error .
     4391     if not error-status :error then apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
     4392     else do:
     4393          message " Запись не найдена " view-as alert-box information .
     4394     end.
     4395   END PROCEDURE.
     4396   PROCEDURE proc-find-b-code :
     4397   define input parameter par-next as logical no-undo.
     4398   define input parameter p-var    as char no-undo.
     4399   define variable v-var1 as integer   no-undo .
     4400   v-var1 = int (p-var) no-error .
     4401   run OpenBr in this-procedure ( false  , par-next,  substitute(" and buf_bar-code.b-code = &1 " , v-var1 )) .
     4402   apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
     4403   END PROCEDURE.
     4404   PROCEDURE proc-find-name :
     4405   define input parameter par-next as logical no-undo.
     4406   define input parameter p-var    as character no-undo.
     4407     doc-rec = ? .
     4408     if par-next = true
     4409     then find next
     4410         x_parts no-lock where can-find
     4411         ( first buf_goods no-lock  where
     4412               buf_goods.artic     = x_parts.artic and
     4413               buf_goods.prod-type = x_parts.prod-type and
     4414               buf_goods.prod-code = x_parts.prod-code and
     4415               buf_goods.gds-name begins p-var )
     4416               no-error  .
     4417     else find first
     4418         x_parts no-lock where can-find (
     4419         first buf_goods no-lock  where
     4420               buf_goods.artic     = x_parts.artic and
     4421               buf_goods.prod-type = x_parts.prod-type and
     4422               buf_goods.prod-code = x_parts.prod-code and
     4423               buf_goods.gds-name begins p-var )
     4424               no-error  .
     4425     if available x_parts then doc-rec = recid(x_parts) .
     4426     reposition BROWSE-2 to recid doc-rec no-error .
     4427     if not error-status :error then apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
     4428     else do:
     4429          message " Запись не найдена " view-as alert-box information .
     4430     end.
     4431   END PROCEDURE.
     4432   PROCEDURE proc-find-part-code :
     4433   define input parameter par-next as logical no-undo.
     4434   define input parameter p-var    as char no-undo.
     4435     doc-rec = ? .
     4436     if par-next = true
     4437     then find next   x_parts no-lock where  x_parts.part-code = p-var no-error  .
     4438     else find first  x_parts no-lock where  x_parts.part-code = p-var no-error  .
     4439     if available x_parts then doc-rec = recid(x_parts) .
     4440     reposition BROWSE-2 to recid doc-rec no-error .
     4441     if not error-status :error then apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
     4442     else do:
     4443          message " Запись не найдена " view-as alert-box information .
     4444     end.
     4445   END PROCEDURE.
     4446   PROCEDURE save-proc :
     4447   DEFINE PARAMETER BUFFER bf_parts for x_parts.
     4448   define buffer buf_parts for ub.parts  .
     4449   if p-mode = "defect" or true  then do:
     4450   find first  buf_parts exclusive-lock where
     4451               buf_parts.obj-code   = bf_parts.obj-code and
     4452               buf_parts.obj-type   = bf_parts.obj-type  and
     4453               buf_parts.artic      = bf_parts.artic  and
     4454               buf_parts.prod-type  = bf_parts.prod-type  and
     4455               buf_parts.prod-code  = bf_parts.prod-code  and
     4456               buf_parts.out-code   = bf_parts.out-code  and
     4457               buf_parts.in-code    = bf_parts.in-code  and
     4458               buf_parts.part-code  = bf_parts.part-code  no-error .
     4459     if error-status :error then do:
     4460         message
     4461           vss-workfile vss-revision vss-description skip
     4462           error-status :get-message(1) skip
     4463           return-value skip
     4464           ""
     4465           view-as alert-box error
     4466         .
     4467         return error return-value .
     4468     end.
     4469     if buf_parts.defect <> bf_parts.defect then do:
     4470        buf_parts.defect = bf_parts.defect .
     4471     end.
     4472   end.
     4473   END PROCEDURE.
     4474   PROCEDURE make-xx-part :
     4475   empty temp-table xx_parts.
     4476     if num-entries ( rid-list ) = 0  then do:
     4477        for each x_parts :
     4478           create xx_parts.
     4479           buffer-copy x_parts to  xx_parts.
     4480        end.
     4481     end.
     4482     else do:
     4483        for each x_parts :
     4484          if lookup ( string(recid(x_parts)) , rid-list ) > 0 then do:
     4485             create xx_parts .
     4486             buffer-copy x_parts to  xx_parts .
     4487          end.
     4488        end.
     4489     end.
     4490   END PROCEDURE.
