     1902   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1903   procedure doc-code:
     1904   define input  parameter parmode          as   character           no-undo.
     1905   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1906   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1907   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1908   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1909   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1910   define variable vardb-remote     as   logical             no-undo.
     1911   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1912   define variable v-delimiter as character no-undo .
     1913   do
     1914   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1915   :
     1916   find first buf_sys-ctrl no-lock .
     1917   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1918     CASE parmode:
     1919       when "main":u then do:
     1920         if vardb-remote then do:
     1921           assign
     1922             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1923         end.
     1924         else do:
     1925           assign
     1926             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1927         end.
     1928       end.
     1929       when "trio" then do:
     1930         assign
     1931           pardoc-code = replace (parroot-doc-code, "=", "*").
     1932       end.
     1933       otherwise do:
     1934         assign
     1935         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1936         no-error
     1937         .
     1938         if error-status:error  then do:
     1939           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1940                                         ,chr(10)
     1941                                         ,parmode
     1942                                         ).
     1943         end.
     1944         if num-entries(parmode) = 1
     1945         and parmode <> "chip":U
     1946         and parmode <> "chip_s":U
     1947         then do:
     1948           assign
     1949           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1950         end.
     1951         else if (lookup("chip":U, parmode) > 0
     1952                  or
     1953                  lookup("chip_s":U, parmode) > 0) then do:
     1954           assign
     1955             vartemp-doc-code = parroot-doc-code.
     1956           do while true:
     1957             if index (vartemp-doc-code , ".") = 0 then
     1958               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1959             else
     1960               vartemp-doc-code  =
     1961               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1962               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1963               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1964             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1965           end.
     1966           assign
     1967             pardoc-code = vartemp-doc-code.
     1968         end.
     1969       end.
     1970     end CASE.
     1971     if pardoc-code = '':U
     1972     or (parroot-doc-code <> '':U
     1973     and pardoc-code = parroot-doc-code) then do:
     1974       undo, return error substitute("Ошибка при генерации номера документа&1"
     1975                                     ,chr(10)).
     1976     end.
     1977   end.
     1978   end. // procedure/method
     1979   function get-doc-code-int64 returns int64
     1980     ( input p-doc-code as character ) :
     1981     define variable v-ind              as integer   no-undo .
     1982     define variable v-num-entries      as integer   no-undo .
     1983     define variable v-doc-code-int64   as int64     no-undo .
     1984     define variable v-canonic-doc-code as character no-undo .
     1985     assign
     1986       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1987       v-canonic-doc-code = p-doc-code
     1988     .
     1989     do v-ind = 1 to v-num-entries
     1990     :
     1991       assign
     1992         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1993       .
     1994     end.
     1995     assign
     1996       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1997     .
     1998     return v-doc-code-int64 .
     1999   end. // function/method
     2000   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2001   define new global shared variable g#trdcalib as handle no-undo.
     2002   procedure create-price-list-attr :
