     2085   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2086   define variable v-waitfram-action01         as character   no-undo .
     2087   define variable v-waitfram-action02         as character   no-undo .
     2088   define variable v-waitfram-action03         as character   no-undo .
     2089   define variable mWaitFramTextBeg            as character   no-undo.
     2090   define variable mWaitFramTextEnd            as character   no-undo.
     2091   define variable mWaitFramView               as logical     no-undo.
     2092   define variable mWaitProcEvent              as logical     no-undo init yes.
     2093   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2094   define variable mWaitFramStop               as logical     no-undo.
     2095   define variable mWaitFramStopUser           as logical     no-undo.
     2096   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2097   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2098   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2099   define button B-WaitFramStop auto-end-key
     2100        label "Стоп"
     2101        size 10 by 1 tooltip "Остоновить процесс".
     2102   define button B-viewProcInfo
     2103        label "Информация"
     2104        size 15 by 1 tooltip "Информация о процесс".
     2105   define frame waitfram
     2106     v-waitfram-action01 format "x(72)" no-label skip
     2107     v-waitfram-action02 format "x(72)" no-label skip
     2108     v-waitfram-action03 format "x(72)" no-label skip
     2109     B-viewProcInfo
     2110     B-WaitFramStop at row 4 col 30
     2111     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2112     .
     2113   define new global shared variable mBatchMode as logical no-undo init ?.
     2114   define variable mFramBachModHandle as handle no-undo.
     2115   mFramBachModHandle = frame waitfram:handle.
     2116   define variable mFameOldVis as logical no-undo.
     2117   define variable mVisCUrentVin as logical no-undo.
     2118   if session:batch-mode
     2119   then
     2120      mBatchMode = yes.
     2121   if mBatchMode = ? then do:
     2122     mVisCUrentVin = current-window:visible.
     2123     mFameOldVis = mFramBachModHandle:visible.
     2124     mFramBachModHandle:visible  = yes.
     2125     mBatchMode = mFramBachModHandle:visible ne yes.
     2126     mFramBachModHandle:visible = mFameOldVis.
     2127     current-window:visible = mVisCUrentVin.
     2128   end.
     2129    if  log-manager:logfile-name ne ?
     2130     then DO:
     2131         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2132         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2133         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2134     end.
     2135   on choose of B-WaitFramStop in frame waitfram
     2136   do:
     2137     mWaitFramStop = yes.
     2138     mWaitFramStopUser = yes.
     2139   end.
     2140   function waitfram-check-timeout returns logical():
     2141      define variable vtime as int64 no-undo.
     2142      if mWaitFramStopTimeOut
     2143      then
     2144         return yes.
     2145      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2146      if     mWaitFramTimeOut ne ?
     2147         and mWaitFramTimeOut ne 0
     2148         and mWaitFramTimeOut lt vtime
     2149      then do:
     2150         mWaitFramStopTimeOut = yes.
     2151      end.
     2152      return mWaitFramStopTimeOut.
     2153   end.
     2154   procedure waitfram-hide :
     2155     if not session:batch-mode
     2156     then do
     2157     on error undo, return error return-value
     2158     :
     2159       pause 0 before-hide .
     2160       if not mBatchMode then
     2161         hide frame waitfram .
     2162     if     not mWaitFramView
     2163        and mWaitProcEvent
     2164     then
     2165       process events .
     2166     end.
     2167   end procedure.
     2168   procedure waitfram-show :
     2169     define input  parameter p-message as character no-undo .
     2170     define variable v-left-margin as integer   no-undo .
     2171     if not session:batch-mode
     2172     then do
     2173     on error undo, return error return-value
     2174     :
     2175       if length(p-message) <= 70 then do:
     2176         assign
     2177           v-left-margin = integer((70 - length(p-message)) / 2)
     2178         .
     2179         assign
     2180           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2181         .
     2182         assign
     2183           v-waitfram-action01 = " "
     2184           v-waitfram-action02 = " "
     2185                                    + fill(" ", v-left-margin)
     2186                                    + p-message
     2187           v-waitfram-action03 = " "
     2188         .
     2189       end.
     2190       else do:
     2191         define variable vRindex1 as integer no-undo.
     2192         define variable vRindex2 as integer no-undo.
     2193         vRindex1 = r-index(p-message," ",70).
     2194         if vRindex1 = 0
     2195         then
     2196            vRindex1 = 70.
     2197         if length(p-message)  <= vRindex1 + 70 then do:
     2198           assign
     2199             v-waitfram-action01 = " "
     2200             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2201             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2202           .
     2203         end.
     2204         else do:
     2205           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2206           if vRindex2 <= vRindex1
     2207           then
     2208              vRindex2 = vRindex1 + 70.
     2209           assign
     2210             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2211             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2212             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2213           .
     2214         end.
     2215       end.
     2216       B-viewProcInfo:visible   in frame waitfram = no.
     2217       B-viewProcInfo:sensitive in frame waitfram = no.
     2218       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2219       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2220       if  (   mWaitFramView
     2221          or  mWaitProcEvent)
     2222          and not mBatchMode
     2223       then
     2224          display
     2225             v-waitfram-action01 skip
     2226             v-waitfram-action02 skip
     2227             v-waitfram-action03 skip
     2228          with frame waitfram .
     2229       if     mWaitFramView
     2230          then do:
     2231             if     mWaitFramInterval ne ?
     2232                and not mBatchMode
     2233             then
     2234                wait-for go of frame waitfram pause mWaitFramInterval.
     2235          end.
     2236          else
     2237             if     mWaitProcEvent
     2238                and not mBatchMode
     2239             then
     2240                process events .
     2241     end.
     2242   end procedure.
     2243      procedure waitfram-show-this:
     2244         define input  parameter iInterval as int64 no-undo.
     2245         define variable vtime as int64 no-undo.
     2246         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2247         mWaitFramInterval = iInterval.
     2248         run waitfram-show (substitute("&1&2 &3&4" ,
     2249                                       mWaitFramTextBeg ,
     2250                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2251                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2252                                       mWaitFramTextEnd
     2253                                      )
     2254                           ).
     2255      end.
     2256      procedure WaitFramRunPause:
     2257         define input  parameter iInterval as dec no-undo.
     2258         define variable vStart  as datetime-tz no-undo.
     2259         define variable vend    as datetime-tz no-undo.
     2260         define variable vint as int64 no-undo.
     2261         define variable vOk as logical no-undo.
     2262         vStart = now.
     2263         vend   = vStart.
     2264         publish "WaitFramPause" (iInterval,output vOk).
     2265         vend   =  now.
     2266         vint = vend - vStart.
     2267         vint = iInterval - vint / 1000.
     2268         if     not mWaitFramStop
     2269            and (   vint > 0
     2270                 or (    not vOk
     2271                     and iInterval eq ?
     2272                     )
     2273                 )
     2274         then
     2275            run waitfram-show-this (iInterval).
     2276         vend   =  now.
     2277         vint = vend - vStart.
     2278         vint = iInterval - vint / 1000.
     2279         if     not mWaitFramStop
     2280            and vint > 0
     2281         then do:
     2282            run gbl/pause.p (vint * 1000).
     2283         end.
     2284         if iInterval ne ?
     2285         then
     2286            publish "WaitFramStop".
     2287         waitfram-check-timeout().
     2288      end.
     2289      procedure WaitFramWaitFor:
     2290         define input  parameter iInterval as dec no-undo.
     2291         assign
     2292            mWaitFramStartProc   = now
     2293            mWaitFramStopUser    = no
     2294            mWaitFramStopTimeOut = no
     2295         .
     2296         block-wait:
     2297         do while not mWaitFramStop:
     2298            run WaitFramRunPause (iInterval).
     2299            if  waitfram-check-timeout()
     2300            then do:
     2301               leave block-wait.
     2302            end.
     2303         end.
     2304         run waitfram-hide.
     2305      end.
     2306   procedure waitfram-join :
     2307     define input  parameter p-line-1  as character no-undo .
     2308     define input  parameter p-line-2  as character no-undo .
     2309     define input  parameter p-line-3  as character no-undo .
     2310     define output parameter p-message as character no-undo .
     2311     do
     2312     on error undo, return error return-value
     2313     :
     2314       assign
     2315         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2316                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2317                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2318       .
     2319     end.
     2320   end procedure.
     2321   function waitfram-join-function returns character
     2322     (input p-line-1 as character
     2323     ,input p-line-2 as character
     2324     ,input p-line-3 as character
     2325     ).
     2326     define variable v-message as character no-undo .
     2327     run waitfram-join in this-procedure
     2328       (input  p-line-1
     2329       ,input  p-line-2
     2330       ,input  p-line-3
     2331       ,output v-message
     2332       ) .
     2333     return v-message .
     2334   end function .
     2335   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2336   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     2337   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     2338   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     2339   define variable gp-excise     like ub.price-list.excise     no-undo.
     2340   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     2341   define variable gp-fact-order as decimal   no-undo .
     2342   define variable gp-price-sale-parts as decimal   no-undo .
     2343   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2344   procedure lineattr-value :
     2345     do
     2346     on error undo, return error return-value
     2347     :
     2348       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2349       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2350       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2351       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     2352       define output parameter p-type     as character no-undo .
     2353       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2354       def var v-format         as character no-undo .
     2355       def var v-fillin_width   as integer   no-undo .
     2356       def var v-fillin_height  as integer   no-undo .
     2357       def var v-label          as character no-undo .
     2358       def var v-user-can-edit  as logical   no-undo .
     2359       def var v-output-display as logical   no-undo .
     2360       def var v-other          as character no-undo .
     2361       run lineattr-code in this-procedure
     2362         (input  p-code
     2363         ,output p-type
     2364         ,output v-format
     2365         ,output v-fillin_width
     2366         ,output v-fillin_height
     2367         ,output v-label
     2368         ,output v-user-can-edit
     2369         ,output v-output-display
     2370         ,output v-other
     2371         ) no-error .
     2372       if error-status :error then do:
     2373         undo, return error return-value .
     2374       end.
     2375       find first buf_doc-line-attr no-lock
     2376         where buf_doc-line-attr.doc-code  = p-doc-code
     2377           and buf_doc-line-attr.gds-code  = p-gds-code
     2378           and buf_doc-line-attr.attr-code = p-code
     2379         no-error .
     2380       if avail buf_doc-line-attr then do:
     2381         assign
     2382           p-value =  buf_doc-line-attr.attr-value
     2383         .
     2384       end.
     2385       else do:
     2386         assign
     2387           p-value = if p-type = 'L':U then "no":U else ""
     2388         .
     2389       end.
     2390     end.
     2391   end procedure.
     2392   procedure lineattr-write :
     2393     do
     2394     on error undo, return error return-value
     2395     :
     2396       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2397       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2398       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2399       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     2400       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2401       def var v-type           as character no-undo .
     2402       def var v-format         as character no-undo .
     2403       def var v-fillin_width   as integer   no-undo .
     2404       def var v-fillin_height  as integer   no-undo .
     2405       def var v-label          as character no-undo .
     2406       def var v-user-can-edit  as logical   no-undo .
     2407       def var v-output-display as logical   no-undo .
     2408       def var v-other          as character no-undo .
     2409       run lineattr-code in this-procedure
     2410         (input  p-code
     2411         ,output v-type
     2412         ,output v-format
     2413         ,output v-fillin_width
     2414         ,output v-fillin_height
     2415         ,output v-label
     2416         ,output v-user-can-edit
     2417         ,output v-output-display
     2418         ,output v-other
     2419         ) no-error .
     2420       if error-status :error then do:
     2421         undo, return error return-value .
     2422       end.
     2423       find first buf_doc-line-attr exclusive-lock
     2424         where buf_doc-line-attr.doc-code  = p-doc-code
     2425           and buf_doc-line-attr.gds-code  = p-gds-code
     2426           and buf_doc-line-attr.attr-code = p-code
     2427         no-error .
     2428       if not available buf_doc-line-attr then do:
     2429         create buf_doc-line-attr .
     2430         assign
     2431           buf_doc-line-attr.doc-code  = p-doc-code
     2432           buf_doc-line-attr.gds-code = p-gds-code
     2433           buf_doc-line-attr.attr-code = p-code
     2434         .
     2435       end.
     2436       assign
     2437         buf_doc-line-attr.attr-value = p-value
     2438       .
     2439        release buf_doc-line-attr.
     2440     end.
     2441   end procedure.
     2442   procedure lineattr-exist :
     2443     do
     2444     on error undo, return error return-value
     2445     :
     2446       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2447       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2448       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2449       define output parameter p-exist   as logical  no-undo .
     2450       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2451       def var v-type           as character no-undo .
     2452       def var v-format         as character no-undo .
     2453       def var v-fillin_width   as integer   no-undo .
     2454       def var v-fillin_height  as integer   no-undo .
     2455       def var v-label          as character no-undo .
     2456       def var v-user-can-edit  as logical   no-undo .
     2457       def var v-output-display as logical   no-undo .
     2458       def var v-other          as character no-undo .
     2459       run lineattr-code in this-procedure
     2460         (input  p-code
     2461         ,output v-type
     2462         ,output v-format
     2463         ,output v-fillin_width
     2464         ,output v-fillin_height
     2465         ,output v-label
     2466         ,output v-user-can-edit
     2467         ,output v-output-display
     2468         ,output v-other
     2469         ) no-error .
     2470       if error-status :error then do:
     2471         undo, return error return-value .
     2472       end.
     2473       find first buf_doc-line-attr no-lock
     2474         where buf_doc-line-attr.doc-code  = p-doc-code
     2475           and buf_doc-line-attr.gds-code = p-gds-code
     2476           and buf_doc-line-attr.attr-code = p-code
     2477         no-error .
     2478       if  available buf_doc-line-attr then do:
     2479         p-exist = yes.
     2480       end.
     2481     end.
     2482   end procedure.
     2483   procedure lineattr-delete :
     2484     do
     2485     on error undo, return error return-value
     2486     :
     2487       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2488       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2489       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2490       define output parameter p-deleted  as logical no-undo.
     2491       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2492       def var v-type           as character no-undo .
     2493       def var v-format         as character no-undo .
     2494       def var v-fillin_width   as integer   no-undo .
     2495       def var v-fillin_height  as integer   no-undo .
     2496       def var v-label          as character no-undo .
     2497       def var v-user-can-edit  as logical   no-undo .
     2498       def var v-output-display as logical   no-undo .
     2499       def var v-other          as character no-undo .
     2500       run lineattr-code in this-procedure
     2501         (input  p-code
     2502         ,output v-type
     2503         ,output v-format
     2504         ,output v-fillin_width
     2505         ,output v-fillin_height
     2506         ,output v-label
     2507         ,output v-user-can-edit
     2508         ,output v-output-display
     2509         ,output v-other
     2510         ) no-error .
     2511       if error-status :error then do:
     2512         undo, return error return-value .
     2513       end.
     2514       find first buf_doc-line-attr exclusive-lock
     2515         where buf_doc-line-attr.doc-code  = p-doc-code
     2516           and buf_doc-line-attr.gds-code  = p-gds-code
     2517           and buf_doc-line-attr.attr-code = p-code
     2518         no-error NO-WAIT.
     2519       if not available buf_doc-line-attr then do:
     2520         p-deleted = no.
     2521       end.
     2522       else do:
     2523         delete buf_doc-line-attr.
     2524         p-deleted = yes.
     2525       end.
     2526     end.
     2527   end procedure.
     2528   procedure lineattr-code :
     2529     do on error undo, return error return-value
     2530     :
     2531       define input  parameter p-code           as character no-undo .
     2532       define output parameter p-type           as character no-undo .
     2533       define output parameter p-format         as character no-undo .
     2534       define output parameter p-fillin_width   as integer   no-undo .
     2535       define output parameter p-fillin_height  as integer   no-undo .
     2536       define output parameter p-label          as character no-undo .
     2537       define output parameter p-user-can-edit  as logical   no-undo .
     2538       define output parameter p-output-display as logical   no-undo .
     2539       define output parameter p-other          as character no-undo .
     2540       case p-code :
     2541               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2542               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2543               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2544               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2545               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2546               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2547               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2548               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2549               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2550               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2551               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2552         otherwise do:
     2553           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     2554         end.
     2555       end.
     2556     end.
     2557   end procedure.
     2558   procedure lineattr-value-flora-gds :
     2559     do
     2560     on error undo, return error return-value
     2561     :
     2562       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2563       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     2564       define input  parameter p-prt-code    as integer   no-undo .
     2565       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     2566       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     2567       define output parameter p-value       as    decimal   no-undo .
     2568       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2569       find first buf_doc-line-attr no-lock
     2570         where buf_doc-line-attr.doc-code  = p-doc-code
     2571           and buf_doc-line-attr.gds-code  = p-gds-code
     2572           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2573         no-error .
     2574       if avail buf_doc-line-attr then do:
     2575         assign
     2576           p-value = decimal( buf_doc-line-attr.attr-value)
     2577         .
     2578       end.
     2579       else do:
     2580         assign
     2581           p-value = 0
     2582         .
     2583       end.
     2584     end.
     2585   end procedure.
     2586   procedure lineattr-write-flora-gds :
     2587     do
     2588     on error undo, return error return-value
     2589     :
     2590       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2591       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2592       define input parameter p-prt-code    as integer   no-undo .
     2593       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2594       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
