     1587   define input-output parameter p-road-tax-rubl as decimal no-undo .
     1588   define variable v-doc-code as character no-undo .
     1589   define buffer     buff-goods    for ub.goods      .
     1590   define buffer     buf_gds-obj   for ub.gds-obj .
     1591   define buffer     buf_parts     for ub.parts   .
     1592   define buffer b-td_trn-doc for ub.trn-doc  .
