     5328             other-base-locoprl     = (if out-vatp_partsprl.other-base     = ? then 0 else out-vatp_partsprl.other-base)
     5329             other-rubl-locoprl     = (if out-vatp_partsprl.other-rubl     = ? then 0 else out-vatp_partsprl.other-rubl)
     5330             vat-pc-locoprl         = (if out-vatp_partsprl.vat-pc         = ? then 0 else out-vatp_partsprl.vat-pc)
     5331             slt-pc-locoprl         = (if out-vatp_partsprl.slt-pc         = ? then 0 else out-vatp_partsprl.slt-pc).
     5332             ASSIGN   slt-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     5333       ASSIGN   slt-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     5334     assign
     5335       exch-rate-cli-locoprl = (out-vatp_partsprl.price-rubl - transport-rubl-locoprl - other-rubl-locoprl - road-tax-rubl-locoprl - (if out-vatp_partsprl.vat-type <> 'в т. ч.':U then vat-rubl-locoprl else 0) - (if out-vatp_partsprl.slt-type <> 'в т. ч.':U then slt-rubl-locoprl else 0)) / out-vatp_partsprl.price-cli .
     5336     assign
     5337       slt-cli-locoprl        = slt-rubl-locoprl       / exch-rate-cli-locoprl
     5338       vat-cli-locoprl        = vat-rubl-locoprl       / exch-rate-cli-locoprl
     5339       road-tax-cli-locoprl   = road-tax-rubl-locoprl  / exch-rate-cli-locoprl
     5340       transport-cli-locoprl  = 0
     5341       other-cli-locoprl      = 0
     5342     .
     5343   ASSIGN
     5344             price-base-without-tax-locoprl = price-base-with-tax-locoprl - vat-base-locoprl - slt-base-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))
     5345       price-rubl-without-tax-locoprl = price-rubl-with-tax-locoprl - vat-rubl-locoprl - slt-rubl-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))
     5346   .
     5347         assign
     5348           varprice-base-consprl = varprice-base-consprl + (price-base-with-tax-locoprl - (if road-tax-base-locoprl = ? then 0 else road-tax-base-locoprl))* out-vatp_partsprl.fact-qnty
     5349           varprice-rubl-consprl = varprice-rubl-consprl + (price-rubl-with-tax-locoprl - (if road-tax-rubl-locoprl = ? then 0 else road-tax-rubl-locoprl))* out-vatp_partsprl.fact-qnty.
     5350         assign
     5351           varis-cons-parts-haveprl = yes
     5352           varcons-qntyprl          = varcons-qntyprl + out-vatp_partsprl.fact-qnty.
     5353       end.
     5354       assign
     5355         varfact-qntyprl = varfact-qntyprl + out-vatp_partsprl.fact-qnty.
     5356     end.
     5357   end.
     5358   assign
     5359     varprice-base-consprl = varprice-base-consprl / varcons-qntyprl
     5360     varprice-rubl-consprl = varprice-rubl-consprl / varcons-qntyprl.
     5361   if varprice-base-consprl = ? then do:
     5362     assign
     5363       varprice-base-consprl = 0.
     5364   end.
     5365   if varprice-rubl-consprl = ? then do:
     5366     assign
     5367       varprice-rubl-consprl = 0.
     5368   end.
     5369   assign
     5370       slt-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc)
     5371     vat-base-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     5372     discnt-base-saleprl            = vardiscnt-base
     5373     price-base-with-tax-saleprl    = (varprice-base - vardiscnt-base)
     5374       slt-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc)
     5375     vat-rubl-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc)
     5376     discnt-rubl-saleprl            = vardiscnt-rubl
     5377     price-rubl-with-tax-saleprl    = (varprice-rubl - vardiscnt-rubl)
     5378     .
     5379   if vardoc-type = 'инв':U then do:
     5380     assign
     5381       varfact-qntyprl = vardoc-qnty.
     5382   end.
     5383   else do:
     5384     assign
     5385       varfact-qntyprl = varfact-qnty.
     5386   end.
     5387   if varis-cons-parts-haveprl = no then do:
     5388     assign
     5389           vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     5390           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
     5391   end.
     5392   else do:
     5393     if vardoc-type = 'инв':U then do:
     5394       assign
     5395               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     5396               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     5397        .
     5398     end.
     5399     else do:
     5400       assign
     5401               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     5402               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     5403        .
     5404     end.
     5405   end.
     5406   assign
     5407   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
     5408   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
     5409     end.
     5410   end procedure.
     5411   def var vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5412   procedure tax-name:
     5413   define input  parameter pardef-tax  as character           no-undo.
     5414   define output parameter parname-tax as character initial ? no-undo.
     5415   define buffer bf_tax for ub.tax.
     5416   do on error undo, return error :
     5417      case pardef-tax:
     5418         when 'vat':U then do:
     5419                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     5420         end.
     5421         when 'slt':U then do:
     5422                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     5423         end.
     5424         when 'rdt':U then do:
     5425                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     5426         end.
     5427         when 'exc':U then do:
     5428                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     5429         end.
     5430         otherwise do:
     5431            return error "Задан неверный параметр " + pardef-tax + " .".
     5432         end.
     5433      end case.
     5434   end.
     5435   end procedure.
     5436   Procedure compare_road-tax :
     5437     define input-output parameter new-road-tax as decimal no-undo .
     5438     define input parameter p-b-code like ub.bar-code.b-code no-undo.
     5439     define input parameter p-obj-type as character no-undo .
     5440     define input parameter p-obj-code as integer   no-undo .
     5441     define input parameter p-mess     as logical   no-undo .
     5442     define variable v-log      as logical   no-undo .
     5443     define variable p-cur-dn   as character no-undo .
     5444     define variable p-cur-pr   as decimal   no-undo .
     5445     define variable p-cur-rt   as decimal   no-undo .
     5446     define variable p-cur-ex   as decimal   no-undo .
     5447     define variable v-name-tax as character no-undo .
     5448   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5450     (input  p-obj-type
     5451     ,input  p-obj-code
     5452     ,input  p-b-code
     5453     ,input  0
     5454     ,input  0
     5455     ,output p-cur-dn
     5456     ,output p-cur-pr
     5457     ,output p-cur-rt
     5458     ,output p-cur-ex
     5459     )  .
     5460   if p-cur-dn <> ? Then DO :
     5461      new-road-tax = p-cur-rt .
     5462   End.
     5463   end procedure.
     5464   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5465   PROCEDURE calc-pr-list :
     5466   define input  parameter bc          like ub.price-list.b-code   no-undo .
     5467   define input  parameter d-num       like ub.price-doc.doc-num   no-undo .
     5468   define input  parameter calc-method             as character    no-undo .
     5469   define input  parameter increase-pc             as decimal      no-undo .
     5470   define input  parameter round-method            as character    no-undo .
     5471   define input  parameter round-base              as decimal      no-undo .
     5472   define input  parameter p-doc-price-rubl        as decimal      no-undo .
     5473   define input  parameter p-doc-price-base        as decimal      no-undo .
     5474   define input  parameter p-doc-price-rubl-novat  as decimal      no-undo .
     5475   define input  parameter p-doc-price-base-novat  as decimal      no-undo .
     5476   define output parameter calc-rec                as recid        no-undo .
     5477   define buffer buf-price-list for ub.price-list.
     5478   define buffer buf-price-doc  for ub.price-doc.
     5479   define buffer buf-bar-code   for ub.bar-code.
     5480   define buffer buf-goods      for ub.goods.
     5481   define buffer buf-gds-prt    for ub.gds-prt.
     5482   define buffer buf-gds-grp    for ub.gds-grp.
     5483   define buffer buf_contract   for ub.contract .
     5484   define buffer buf_contract-specif for ub.contract-specif .
     5485   define variable cur-pr like ub.price-list.price-sale no-undo .
     5486   define variable cur-rt like ub.price-list.road-tax   no-undo .
     5487   define variable cur-ex like ub.price-list.excise     no-undo .
     5488   define variable cur-dn like ub.price-list.doc-num    no-undo .
     5489   define variable loc-ret        as logical            no-undo .
     5490   define variable old-price-sale as decimal            no-undo .
     5491   define variable v-bonus        as decimal            no-undo .
     5492   assign
     5493     loc-ret = true
     5494   .
     5495   calc-pr:
     5496   do on error undo calc-pr, return error:
     5497     find  buf-bar-code no-lock where
     5498           buf-bar-code.b-code = bc.
     5499     find  buf-goods no-lock where
     5500           buf-goods.gds-code = buf-bar-code.gds-code.
     5501     find  buf-gds-prt no-lock where
     5502           buf-gds-prt.node-code = buf-bar-code.node-code.
     5503     find  buf-price-list where
     5504           buf-price-list.doc-num    = d-num and
     5505           buf-price-list.b-code     = bc and
     5506           buf-price-list.price-type = "".
     5507     find  buf-price-doc where
     5508           buf-price-doc.doc-num = d-num.
     5509     g#log = yes.
     5510     define variable loc-increase-pc      like  ub.goods.increase-pc no-undo .
     5511     define variable loc-grp-increase-pc  like  ub.goods.increase-pc no-undo .
     5512   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5513   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-increase-pc in g#library
     5514     (input  buf-goods.gds-code
     5515     ,input  buf-price-list.obj-type
     5516     ,input  buf-price-list.obj-code
     5517     ,output  loc-increase-pc
     5518     ) no-error .
     5519     if error-status :error then do:
     5520        message vss-workfile vss-revision vss-description skip
     5521        "Ошибка метода поиска наценки товара на объекте" skip
     5522        error-status :get-message(1) .
     5523     end.
     5524   define variable p-prc-min        as decimal   no-undo .
     5525   define variable p-prc-max        as decimal   no-undo .
     5526   define variable p-round-method   as character no-undo .
     5527   define variable p-base           as decimal   no-undo .
     5528   define variable p-value-margin   as integer   no-undo .
     5529   define variable p-type-margin    as logical   no-undo .
     5530   define variable p-value-increase as integer   no-undo .
     5531   define variable p-type-increase  as logical   no-undo .
     5532   define variable p-value-rmethod  as integer   no-undo .
     5533   define variable p-type-rmethod   as logical   no-undo .
     5534   run gds-attr-margin-value
     5535   (
     5536     input   buf-goods.gds-code ,
     5537     input   buf-price-list.obj-type  ,
     5538     input   buf-price-list.obj-code  ,
     5539     output  p-prc-min  ,
     5540     output  p-prc-max  ,
     5541     output  loc-grp-increase-pc,
     5542     output  p-round-method   ,
     5543     output  p-base           ,
     5544     output  p-value-margin    ,
     5545     output  p-type-margin     ,
     5546     output  p-value-increase    ,
     5547     output  p-type-increase   ,
     5548     output  p-value-rmethod    ,
     5549     output  p-type-rmethod
     5550     ) no-error .
     5551     if error-status :error then do:
     5552        message vss-workfile vss-revision vss-description skip
     5553        "Ошибка процедуры поиска наценки по группе товара на объекте" skip
     5554        error-status :get-message(1) skip
     5555        return-value .
     5556     end.
     5557     define variable g-g as logical no-undo .
     5558     g-g = false .
     5559     case calc-method:
     5560       when 'Товар':U then do:
     5561         case buf-goods.calc-method:
     5562           when 'Группа':U then do:
     5563             find buf-gds-grp no-lock where
     5564                 buf-gds-grp.node-code = buf-goods.grp-code.
     5565             case buf-gds-grp.calc-method:
     5566      when 'Накл-безНДС':U  then do:
     5567         if ub.trn-doc.doc-type = 'при':U and
     5568            ( ub.trn-doc.ext-doc-type = 'ie':U  ) then do:
     5569                 run str/gdsnovat.p ('Накл-безНДС':U,
     5570                         buf-price-list.obj-type,
     5571                         buf-price-list.obj-code,
     5572                         buf-price-doc.host-code,
     5573                         buf-price-list.artic,
     5574                         buf-price-list.prod-type,
     5575                         buf-price-list.prod-code,
     5576                         loc-grp-increase-pc,
     5577                         doc-code,
     5578                         input p-doc-price-rubl-novat   ,
     5579                         input p-doc-price-base-novat   ,
     5580                         output cost-base   ,
     5581                         output cost-rubl   ,
     5582                         output v-price-base  ,
     5583                         output v-price-rubl  ,
     5584                         output cur-rt-base ,
     5585                         output cur-rt-rubl )
     5586                         .
     5587                         if available ub.doc-line then do:
     5588                             assign
