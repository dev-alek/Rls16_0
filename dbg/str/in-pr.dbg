     2613     end.
     2614   end procedure.
     2615   procedure lineattr-delete-flora-gds :
     2616     do
     2617     on error undo, return error return-value
     2618     :
     2619       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2620       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2621       define input  parameter p-prt-code    as integer   no-undo .
     2622       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2623       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2624       define output parameter p-deleted  as logical no-undo.
     2625       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2626       find first buf_doc-line-attr exclusive-lock
     2627         where buf_doc-line-attr.doc-code  = p-doc-code
     2628           and buf_doc-line-attr.gds-code  = p-gds-code
     2629           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2630         no-error NO-WAIT.
     2631       if not available buf_doc-line-attr then do:
     2632         p-deleted = no.
     2633       end.
     2634       else do:
     2635         delete buf_doc-line-attr.
     2636         p-deleted = yes.
