     5244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5245     (output varoutvprbprl
     5246     )  .
     5247   if varoutvprbprl = "base":u then do:
     5248     assign
     5249           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     5250       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     5251     .
     5252   end.
     5253   else do:
     5254     assign
     5255           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     5256       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     5257     .
     5258   end.
     5259   if varoutvprbprl = "rubl":u then do:
     5260     assign
     5261           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     5262       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     5263   end.
     5264   else do:
     5265     assign
     5266           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     5267       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     5268   end.
     5269   assign
     5270     varis-cons-parts-haveprl =  no.
     5271   assign
     5272     varfact-qntyprl       = 0
     5273     varcons-qntyprl       = 0
     5274     varprice-base-consprl = 0
     5275     varprice-rubl-consprl = 0.
     5276   find first out-vatp_doc-lineprl where
     5277              out-vatp_doc-lineprl.doc-code   = vardoc-num
     5278          and out-vatp_doc-lineprl.artic      = varartic
     5279          and out-vatp_doc-lineprl.prod-type  = varprod-type
     5280          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     5281   if available out-vatp_doc-lineprl           and
     5282     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     5283     assign
