     2597       find first buf_doc-line-attr exclusive-lock
     2598         where buf_doc-line-attr.doc-code  = p-doc-code
     2599           and buf_doc-line-attr.gds-code  = p-gds-code
     2600           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2601         no-error .
     2602       if not available buf_doc-line-attr then do:
     2603         create buf_doc-line-attr .
