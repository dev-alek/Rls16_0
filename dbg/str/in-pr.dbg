     1599   define variable v-total-avrg-base         as decimal no-undo .
     1600   define variable v-total-avrg-rubl         as decimal no-undo .
     1601   define variable v-total-avrg-qnty         as decimal no-undo .
     1602   define variable v-total-road-tax-base     as decimal no-undo .
     1603   define variable v-total-road-tax-rubl     as decimal no-undo .
     1604   define variable v-all-total-road-tax-base as decimal no-undo .
     1605   define variable v-all-total-road-tax-rubl as decimal no-undo .
     1606   assign
