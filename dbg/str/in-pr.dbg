     4293   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     4294     (input  ?
     4295     ,input  l-type
     4296     ,input  l-code
     4297     ,output par-pr-nakl-ie
     4298     ,output par-pr-nakl-iv
     4299     ,output par-pr-nakl-im
