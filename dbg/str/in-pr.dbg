     8976   PROCEDURE exp-prt:
     8977   define input  parameter g-code  like ub.goods.gds-code    no-undo.
     8978   define input  parameter old-num like ub.price-doc.doc-num no-undo.
     8979   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     8980   define output parameter new-rec as recid               no-undo.
     8981   define buffer buf-bar-code   for ub.bar-code.
     8982   define buffer buf-goods      for ub.goods.
     8983   define buffer buf-price-list for ub.price-list.
     8984   find buf-goods no-lock where
     8985        buf-goods.gds-code = g-code.
     8986   exp-alt:
     8987   do on error undo exp-alt, return error:
     8988   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8989   for each  buf-price-list where
     8990             buf-price-list.doc-num    = old-num and
     8991             buf-price-list.artic      = buf-goods.artic and
     8992             buf-price-list.prod-type  = buf-goods.prod-type and
     8993             buf-price-list.prod-code  = buf-goods.prod-code and
     8994             buf-price-list.main-price = no,
     8995       first buf-bar-code no-lock where
     8996             buf-bar-code.b-code   = buf-price-list.b-code and
     8997             buf-bar-code.unit-cli <> buf-goods.unit-base:
     8998     run cre-pr-list (input  buf-bar-code.b-code,
     8999                      input  new-num,
     9000                      output new-rec) no-error.
     9001     if error-status:error then do:
     9002       message
     9003         "Ошибка cre-pr-list." skip
     9004         "Код:" buf-bar-code.b-code
     9005         view-as alert-box.
     9006       next.
     9007     end.
     9008   end.
     9009     if par-pr-parex = "yes" and
     9010        par-pr-notls = "yes" then do:
     9011   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9012   define buffer buf_parts for ub.parts  .
     9013       for each  buf_parts no-lock where
     9014             buf_parts.out-code    = 'free-zone':U and
     9015             buf_parts.obj-type   = v-cntxt-obj-type and
     9016             buf_parts.obj-code   = v-cntxt-obj-code and
     9017             buf_parts.rsrv-free   = true  and
     9018             buf_parts.status_     = false and
     9019             buf_parts.artic       = buf-goods.artic and
     9020             buf_parts.prod-type   = buf-goods.prod-type and
     9021             buf_parts.prod-code   = buf-goods.prod-code ,
     9022           first buf-bar-code no-lock where
     9023                 buf-bar-code.gds-code  = buf-goods.gds-code and
     9024                 buf-bar-code.unit-cli  = buf-goods.unit-base and
     9025                 buf-bar-code.in-code   = buf_parts.in-code and
     9026                 buf-bar-code.part-code = buf_parts.part-code
     9027             :
     9028     run cre-pr-list (input  buf-bar-code.b-code,
     9029                      input  new-num,
     9030                      output new-rec) no-error.
     9031     if error-status:error then do:
     9032       message
     9033         "Ошибка cre-pr-list." skip
     9034         "Код:" buf-bar-code.b-code
     9035         view-as alert-box.
     9036       next.
     9037     end.
     9038   end.
     9039     end.
     9040   end.
     9041   END PROCEDURE.
     9042   procedure ver-par-disc-mar :
     9043    do
     9044    on error undo, return error return-value
     9045    :
     9046   define input parameter   p-obj-type    like ub.clients.obj-type no-undo .
     9047   define input parameter   p-obj-code    like ub.clients.obj-type no-undo .
     9048   define input parameter   p-node-code   like ub.goods.grp-code no-undo .
     9049   define output parameter  par-disc-mar  as logical no-undo .
     9050   define variable p-host-code       as integer no-undo .
     9051   define variable p-prc-min         as decimal no-undo .
     9052   define variable p-prc-max         as decimal no-undo .
     9053   define variable p-increase-pc     as decimal no-undo .
     9054   define variable p-round-method    as character no-undo .
     9055   define variable p-base            as decimal no-undo .
     9056   define variable p-value-margin    as integer  no-undo.
     9057   define variable p-type-margin     as logical no-undo .
     9058   define variable p-value-increase  as integer  no-undo.
     9059   define variable p-type-increase   as logical no-undo .
     9060   define variable p-value-rmethod   as integer  no-undo.
     9061   define variable p-type-rmethod    as logical no-undo .
     9062   define variable v-value-character as character no-undo .
     9063   define variable v-value-date      as date      no-undo .
     9064   define variable v-value-decimal   as decimal   no-undo .
     9065   define variable v-value-integer   as integer   no-undo .
     9066   define variable v-value-logical   as logical   no-undo .
     9067    par-disc-mar = false .
     9068   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9069   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     9070     (input  p-obj-type
     9071     ,input  p-obj-code
     9072     ,output p-host-code
     9073     )  .
     9074   empty temp-table thbjattr_thbj-attr.
     9075   run adm/shattri.p (
     9076      input "get":U
     9077     ,input p-obj-type
     9078     ,input p-obj-code
     9079     ,input 'overval':U
     9080     ,input  "pr-discm"
     9081     ,output par-pr-discm
     9082     ,output v-value-date
     9083     ,output v-value-decimal
     9084     ,output v-value-integer
     9085     ,output v-value-logical
     9086     ,output par-type
     9087     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     9088     ) no-error .
     9089   if trim(par-pr-discm) = "" then return .
     9090   run grp-obj-margin-value
     9091   ( input   p-node-code ,
     9092     input   p-obj-type  ,
     9093     input   p-obj-code  ,
     9094     output  p-prc-min  ,
     9095     output  p-prc-max  ,
     9096     output  p-increase-pc,
     9097     output  p-round-method ,
     9098     output  p-base         ,
     9099     output  p-value-margin    ,
     9100     output  p-type-margin,
     9101     output  p-value-increase,
     9102     output  p-type-increase  ,
     9103     output  p-value-rmethod,
     9104     output  p-type-rmethod
     9105     ) .
     9106   if p-type-margin = false  then return.
     9107   par-disc-mar = true  .
     9108    end.
     9109   end procedure.
     9110   procedure create-dfc :
     9111   define input  parameter v-plt-id      as integer   no-undo .
     9112   define input  parameter v-plt-db-num  as integer   no-undo .
     9113   define input  parameter v-pdf-id      as integer   no-undo .
     9114   define input  parameter v-pdf-db-num  as integer   no-undo .
     9115   define input  parameter v-doc-num     as character no-undo .
     9116   define input  parameter p-base-rate   as decimal   no-undo .
     9117   define input  parameter p-base-scale  as decimal   no-undo .
     9118   define buffer red_price-doc for ub.price-doc  .
     9119   define buffer red_price-list for ub.price-list  .
     9120   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     9121   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     9122   define buffer buf_price-all for ub.price-all  .
     9123   define variable v-price-calc-base  as decimal   no-undo .
     9124   define variable v-price-calc-doc   as decimal   no-undo .
     9125   define variable v-price-calc-rubl  as decimal   no-undo .
     9126   define variable v-price-prev-base  as decimal   no-undo .
     9127   define variable v-price-prev-doc   as decimal   no-undo .
     9128   define variable v-price-prev-rubl  as decimal   no-undo .
     9129   define variable v-price-sale-base  as decimal   no-undo .
     9130   define variable v-price-sale-doc   as decimal   no-undo .
     9131   define variable v-price-sale-rubl  as decimal   no-undo .
     9132   define variable v-road-tax-base    as decimal   no-undo .
     9133   define variable v-road-tax-doc     as decimal   no-undo .
     9134   define variable v-road-tax-rubl    as decimal   no-undo .
     9135   define variable v-excise-base      as decimal   no-undo .
     9136   define variable v-excise-doc       as decimal   no-undo .
     9137   define variable v-excise-rubl      as decimal   no-undo .
     9138   define variable v-type as character no-undo .
     9139   define variable v-code as integer   no-undo .
     9140   define variable v-prev-doc-code as character no-undo .
     9141   define variable v-status as integer   no-undo .
     9142     do
     9143     on error undo, return error return-value
     9144     :
     9145   run waitfram-show in this-procedure ( "Создание документа формирования цены... " ) .
     9146   find first red_price-doc no-lock where
     9147              red_price-doc.doc-num = v-doc-num
     9148              no-error .
     9149   find first buf_price-doc-forming exclusive-lock where
     9150              buf_price-doc-forming.plt-id     = v-plt-id      and
     9151              buf_price-doc-forming.plt-db-num = v-plt-db-num  and
     9152              buf_price-doc-forming.pdf-id     = v-pdf-id      and
     9153              buf_price-doc-forming.pdf-db     = v-pdf-db-num
     9154              no-error .
     9155   assign
     9156     v-type = red_price-doc.obj-type
     9157     v-code = red_price-doc.obj-code
     9158   .
     9159   assign
     9160      buf_price-doc-forming.name = trim ( trim (red_price-doc.ps, "@" ))
     9161      buf_price-doc-forming.stts = integer('0':U)
     9162      v-status = ( if red_price-doc.status_ = 'новый':U then integer('0':U) else integer('3':U) )
     9163   .
     9164   for each red_price-list no-lock  where red_price-list.doc-num = v-doc-num :
     9165   if var-pr-r-b = "rubl" then do:
     9166    v-price-calc-rubl  = red_price-list.price-calc .
     9167    v-price-calc-base  = v-price-calc-rubl / p-base-rate * p-base-scale .
     9168    v-price-calc-doc   = red_price-list.price-calc .
     9169    v-price-prev-rubl  = red_price-list.price-prev  .
     9170    v-price-prev-base  = v-price-prev-rubl / p-base-rate * p-base-scale .
     9171    v-price-prev-doc   = red_price-list.price-prev  .
     9172    v-price-sale-rubl  = red_price-list.price-sale  .
     9173    v-price-sale-base  = v-price-sale-rubl / p-base-rate * p-base-scale .
     9174    v-price-sale-doc   = red_price-list.price-sale  .
     9175    v-road-tax-rubl    = red_price-list.road-tax    .
     9176    v-road-tax-base    = v-road-tax-rubl   / p-base-rate * p-base-scale .
     9177    v-road-tax-doc     = red_price-list.road-tax    .
     9178    v-excise-rubl      = red_price-list.excise      .
     9179    v-excise-base      = v-excise-rubl     / p-base-rate * p-base-scale .
     9180    v-excise-doc       = red_price-list.excise      .
     9181    end.
     9182   else do:
     9183    v-price-calc-base  = red_price-list.price-calc .
     9184    v-price-calc-rubl  = v-price-calc-base * p-base-rate / p-base-scale .
     9185    v-price-calc-doc   = red_price-list.price-calc .
     9186    v-price-prev-base  = red_price-list.price-prev  .
     9187    v-price-prev-rubl  = v-price-prev-base * p-base-rate / p-base-scale .
     9188    v-price-prev-doc   = red_price-list.price-prev  .
     9189    v-price-sale-base  = red_price-list.price-sale  .
     9190    v-price-sale-rubl  = v-price-sale-base * p-base-rate / p-base-scale .
     9191    v-price-sale-doc   = red_price-list.price-sale  .
     9192    v-road-tax-base    = red_price-list.road-tax    .
     9193    v-road-tax-rubl    = v-road-tax-base   * p-base-rate / p-base-scale .
     9194    v-road-tax-doc     = red_price-list.road-tax    .
     9195    v-excise-base      = red_price-list.excise      .
     9196    v-excise-rubl      = v-excise-base     * p-base-rate / p-base-scale .
     9197    v-excise-doc       = red_price-list.excise      .
     9198   end.
     9199       create buf_price-doc-forming-gds.
     9200       assign
     9201          buf_price-doc-forming-gds.pdf-db            = v-pdf-db-num
     9202          buf_price-doc-forming-gds.pdf-id            = v-pdf-id
     9203          buf_price-doc-forming-gds.plt-db-num        = v-plt-db-num
     9204          buf_price-doc-forming-gds.plt-id            = v-plt-id
     9205          buf_price-doc-forming-gds.line-num          = red_price-list.line-num
     9206          buf_price-doc-forming-gds.artic             = red_price-list.artic
     9207          buf_price-doc-forming-gds.prod-code         = red_price-list.prod-code
     9208          buf_price-doc-forming-gds.prod-type         = red_price-list.prod-type
     9209          buf_price-doc-forming-gds.b-code            = red_price-list.b-code
     9210          buf_price-doc-forming-gds.calc-method       = red_price-list.calc-method
     9211          buf_price-doc-forming-gds.d-pcnt            = red_price-list.d-pcnt
     9212          buf_price-doc-forming-gds.end-date          = ?
     9213          buf_price-doc-forming-gds.end-shift-date    = ?
     9214          buf_price-doc-forming-gds.end-shift-name    = ?
     9215          buf_price-doc-forming-gds.end-shift-num     = ?
     9216          buf_price-doc-forming-gds.end-sys-date      = ?
     9217          buf_price-doc-forming-gds.end-sys-time      = ?
     9218          buf_price-doc-forming-gds.have-end-period   = int(false)
     9219          buf_price-doc-forming-gds.have-start-period = int(false)
     9220          buf_price-doc-forming-gds.price-calc-base   =  v-price-calc-base
     9221          buf_price-doc-forming-gds.price-calc-doc    =  v-price-calc-doc
     9222          buf_price-doc-forming-gds.price-calc-rubl   =  v-price-calc-rubl
     9223          buf_price-doc-forming-gds.price-prev-base   =  v-price-prev-base
     9224          buf_price-doc-forming-gds.price-prev-doc    =  v-price-prev-doc
     9225          buf_price-doc-forming-gds.price-prev-rubl   =  v-price-prev-rubl
     9226          buf_price-doc-forming-gds.price-sale-base   =  v-price-sale-base
     9227          buf_price-doc-forming-gds.price-sale-doc    =  v-price-sale-doc
     9228          buf_price-doc-forming-gds.price-sale-rubl   =  v-price-sale-rubl
     9229          buf_price-doc-forming-gds.road-tax-base     =  v-road-tax-base
     9230          buf_price-doc-forming-gds.road-tax-doc      =  v-road-tax-doc
     9231          buf_price-doc-forming-gds.road-tax-rubl     =  v-road-tax-rubl
     9232          buf_price-doc-forming-gds.excise-base       =  v-excise-base
     9233          buf_price-doc-forming-gds.excise-doc        =  v-excise-doc
     9234          buf_price-doc-forming-gds.excise-rubl       =  v-excise-rubl
     9235          buf_price-doc-forming-gds.vat-pc            = red_price-list.vat-pc
     9236          buf_price-doc-forming-gds.slt-pc            = red_price-list.slt-pc
     9237          buf_price-doc-forming-gds.start-date        = ?
     9238          buf_price-doc-forming-gds.start-shift-date  = ?
     9239          buf_price-doc-forming-gds.start-shift-name  = ?
     9240          buf_price-doc-forming-gds.start-shift-num   = ?
     9241          buf_price-doc-forming-gds.start-sys-date    = ?
     9242          buf_price-doc-forming-gds.start-sys-time    = ?
     9243          buf_price-doc-forming-gds.stts              = buf_price-doc-forming.stts
     9244          .
     9245   end.
     9246    if red_price-doc.status_ = 'новый':U  then do:
     9247       find first red_price-doc exclusive-lock where
     9248                  red_price-doc.doc-num = v-doc-num
     9249                  no-error .
     9250       delete red_price-doc.
     9251    end.
     9252       if v-status <> 0 then do:
     9253           run str/diallog.w
     9254               (parparentproc
     9255               , this-procedure
     9256               , 'str/pdf-clos.p':U
     9257               , ( string(recid(buf_price-doc-forming)) + chr(4) +
     9258                 'yes' + chr(4) +
     9259                 'no' + chr(4) +
     9260                 v-type + chr(4) +
     9261                 string(v-code) + chr(4) +
     9262                 ( if gen-mode =  "cost-price" then   "cost-price-act"  else 'факт':U ) + chr(4) +
     9263                 ub.trn-doc.doc-code + chr(4) +
     9264                 'yes' )
     9265               , yes
     9266               , '':U
     9267               , 'Закрытие ДНЦ') no-error .
     9268           if error-status :error then do:
     9269              if return-value  <> "pr-goods":U  then do:
     9270                 message
     9271                   vss-workfile vss-revision vss-description skip
     9272                   error-status :get-message(1) skip
     9273                   return-value skip
     9274                   "Для закрытых ДНЦ сформировать денорм цены"
     9275                   view-as alert-box error
     9276                 .
     9277                 return error return-value .
     9278              end.
     9279           end.
     9280       end.
     9281   run waitfram-hide in this-procedure.
     9282     end.
     9283   end procedure.
     9284   procedure find-main-plt :
     9285   define input  parameter p-cntxt-obj-type as character no-undo .
     9286   define input  parameter p-cntxt-obj-code as integer   no-undo .
     9287   define output parameter p-plt-id         as integer   no-undo .
     9288   define output parameter p-plt-db-num     as integer   no-undo .
     9289   define output parameter p-round-method   as character no-undo .
     9290   define output parameter p-round-base     as decimal   no-undo .
     9291   define buffer buf_price-list-type    for ub.price-list-type  .
     9292   define buffer result_price-list-type for ub.price-list-type  .
     9293     do
     9294     on error undo, return error return-value
     9295     :
     9296   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9297   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     9298     (input  parparentproc
     9299     ,input  p-cntxt-obj-type
     9300     ,input  p-cntxt-obj-code
     9301     ,input  yes
     9302     ,output p-plt-id
     9303     ,output p-plt-db-num
     9304     ) no-error .
     9305     if error-status :error then
     9306     message
     9307       vss-workfile vss-revision vss-description skip
     9308       error-status :get-message(1) skip
     9309       return-value skip
     9310       "Поиск ГТПЛ для переоценок"
     9311       view-as alert-box error
     9312     .
     9313     find first buf_price-list-type no-lock where
     9314                buf_price-list-type.stts = integer('0':U) and
     9315                buf_price-list-type.main = true  and
     9316                buf_price-list-type.plt-id     = p-plt-id     and
     9317                buf_price-list-type.plt-db-num = p-plt-db-num no-error .
     9318     if not available buf_price-list-type then return error substitute("Не найден главный тип прайс-листа  &1 &2" ,p-plt-id ,p-plt-db-num ) .
     9319     if buf_price-list-type.under-type-list  = 1 then do:
     9320         find first result_price-list-type no-lock where
     9321                   result_price-list-type.stts = integer('0':U) and
     9322                   result_price-list-type.main = true  and
     9323                   result_price-list-type.plt-id     = buf_price-list-type.plt-main-id and
     9324                   result_price-list-type.plt-db-num = buf_price-list-type.plt-main-db-num no-error .
     9325     if not available result_price-list-type then return error substitute("Не найден главный родительский тип прайс-листа  для подчиненного &1 &2" , p-plt-id ,p-plt-db-num ) .
     9326     end.
     9327     else do:
     9328       find first result_price-list-type no-lock where  recid(result_price-list-type) = recid(buf_price-list-type) no-error .
     9329     end.
     9330     assign
     9331       p-plt-id        = result_price-list-type.plt-id
     9332       p-plt-db-num    = result_price-list-type.plt-db-num
     9333       p-round-method  = result_price-list-type.calc-round-method
     9334       p-round-base    = result_price-list-type.calc-round-base
     9335     .
     9336     end.
     9337   end procedure.
     9338   procedure calc-npricesale-doc-line :
     9339   define input  parameter bc    like ub.price-list.b-code no-undo.
     9340   define input  parameter d-num like ub.price-doc.doc-num no-undo.
     9341   define input  parameter p-doc-num  as character    no-undo.
     9342   define input  parameter p-new-sum  as decimal      no-undo .
     9343   define output parameter calc-rec   as recid        no-undo.
     9344   define buffer buf-price-list for ub.price-list.
     9345   define buffer buf-bar-code   for ub.bar-code.
     9346   define buffer buf-goods      for ub.goods.
     9347   define buffer buf-gds-prt    for ub.gds-prt.
     9348   define buffer buf-gds-grp    for ub.gds-grp.
     9349   define buffer buf-price-doc  for ub.price-doc.
     9350     do
     9351     on error undo, return error return-value
     9352     :
     9353     find  buf-bar-code no-lock where
     9354           buf-bar-code.b-code = bc.
     9355     find  buf-goods no-lock where
     9356           buf-goods.gds-code = buf-bar-code.gds-code.
     9357     find  buf-gds-prt no-lock where
     9358           buf-gds-prt.node-code = buf-bar-code.node-code.
     9359     find  buf-price-list where
     9360           buf-price-list.doc-num    = d-num and
     9361           buf-price-list.b-code     = bc and
     9362           buf-price-list.price-type = "".
     9363     find  buf-price-doc where
     9364           buf-price-doc.doc-num = d-num.
     9365           buf-price-list.price-sale = p-new-sum .
     9366           buf-price-list.price-calc = p-new-sum .
     9367           buf-price-list.calc-method = 'Накладная':U + " " + p-doc-num .
     9368           calc-rec = recid (buf-price-list).
     9369     run calc-pr-sub (input  buf-bar-code.b-code,
     9370                      input  buf-price-list.doc-num,
     9371                      input  'Отсутствует':U,
     9372                      input  0,
     9373                      input  ?  ,
     9374                      input  ?,
     9375                      output calc-rec) no-error.
     9376     if error-status :error then
     9377     message
     9378       vss-workfile vss-revision vss-description skip
     9379       error-status :get-message(1) skip
     9380       return-value skip
     9381       ""
     9382       view-as alert-box error
     9383     .
     9384     end.
     9385   end procedure.
