     4301      define variable ii as integer   no-undo .
     4302      define variable nn as integer   no-undo .
     4303      define variable v-fullname as character no-undo .
     4304      nn = num-entries ( par-pr-nogds ).
     4305      par-pr-nogds-long = "".
     4306      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     4307         repeat ii = 1 to nn :
     4308           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     4309           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     4310         end.
     4311         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     4312      end.
     4313   l-par = true .
     4314   end procedure.
     4315   PROCEDURE cre-pr-list:
     4316   define input  parameter bc      like ub.price-list.b-code no-undo.
     4317   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     4318   define output parameter new-rec as recid             no-undo.
     4319   define buffer buf-price-list for ub.price-list.
     4320   define buffer buf-price-doc  for ub.price-doc.
     4321   define buffer buf-bar-code   for ub.bar-code.
     4322   define buffer buf-goods      for ub.goods.
     4323   define buffer buf-gds-prt    for ub.gds-prt.
     4324   define buffer root-gds-prt   for ub.gds-prt.
     4325   define variable cur-pr like ub.price-list.price-sale no-undo.
     4326   define variable cur-rt like ub.price-list.road-tax   no-undo.
     4327   define variable cur-ex like ub.price-list.excise     no-undo.
     4328   define variable cur-dn like ub.price-list.doc-num    no-undo.
     4329   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     4330   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     4331   define variable cur-rt-base as decimal no-undo .
     4332   define variable cur-rt-rubl as decimal no-undo .
     4333   define variable p-hostcode as int no-undo .
     4334   define variable v-line-num as integer no-undo .
     4335   define variable v-skip-del-gds as logical no-undo initial no .
     4336   cre-pr:
     4337   do on error undo cre-pr, return error:
     4338     find  buf-bar-code no-lock where
     4339           buf-bar-code.b-code = bc.
     4340     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     4341     if error-status :error then do:
     4342       message
     4343         return-value skip
     4344         "Ошибка !"
     4345         view-as alert-box error
     4346       .
     4347       undo cre-pr, return.
     4348     end.
     4349     find  buf-goods no-lock where
     4350           buf-goods.gds-code = buf-bar-code.gds-code.
     4351     find first root-gds-prt no-lock where
     4352               root-gds-prt.upper-code = buf-goods.prt-root.
     4353     if root-gds-prt.node-name <> '_Пустая шкала':U and
     4354       buf-bar-code.in-code <> "" then do:
     4355       message
     4356         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     4357         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     4358         view-as alert-box error.
     4359       undo cre-pr, return.
     4360     end.
     4361     find  buf-gds-prt no-lock where
     4362           buf-gds-prt.node-code = buf-bar-code.node-code.
     4363     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     4364       message
     4365         "Не допускается создавать цены на удаленные товары!" skip (2)
     4366         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     4367         view-as alert-box error.
     4368       undo cre-pr, return.
     4369     end.
     4370     find  buf-price-doc where
     4371           buf-price-doc.doc-num = new-num.
     4372   define variable v-ret as logical no-undo .
     4373      run ver-modificator-price-is-null (
     4374             input    buf-goods.artic        ,
     4375             input    buf-goods.prod-type    ,
     4376             input    buf-goods.prod-code    ,
     4377             input    buf-price-doc.obj-type   ,
     4378             input    buf-price-doc.obj-code   ,
     4379             output   v-ret ).
     4380         if v-ret = false then dO:
     4381             message
     4382               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     4383               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     4384               view-as alert-box error.
     4385             undo cre-pr, return.
     4386           end.
     4387   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4388   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4389     (input  buf-price-doc.obj-type
     4390     ,input  buf-price-doc.obj-code
     4391     ,output p-hostcode
     4392     ) no-error .
     4393   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4395     (input  buf-goods.gds-code
     4396     ,input  '1':U
     4397     ,input  ?
     4398     ,input  p-hostcode
     4399     ,input  buf-price-doc.obj-type
     4400     ,input  buf-price-doc.obj-code
     4401     ,output local_vat-pc
     4402     ) no-error .
     4403   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4404   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4405     (input  buf-goods.gds-code
     4406     ,input  '2':U
     4407     ,input  ?
     4408     ,input  p-hostcode
     4409     ,input  buf-price-doc.obj-type
     4410     ,input  buf-price-doc.obj-code
     4411     ,output local_slt-pc
     4412     ) no-error .
     4413   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4415     (input  buf-price-doc.obj-type
     4416     ,input  buf-price-doc.obj-code
     4417     ,input  bc
     4418     ,input  0
     4419     ,input  0
     4420     ,output cur-dn
     4421     ,output cur-pr
     4422     ,output cur-rt
     4423     ,output cur-ex
     4424     ) no-error .
     4425     find first buf-price-list where
     4426               buf-price-list.b-code  = buf-bar-code.b-code and
     4427               buf-price-list.doc-num = new-num  and
     4428               buf-price-list.price-type = ""    no-error .
     4429     if not available buf-price-list then do:
     4430       run calc-price-line-num (input  new-num , output v-line-num) .
     4431       create buf-price-list.
     4432       assign
     4433         buf-price-list.line-num  = v-line-num
     4434         buf-price-list.b-code    = buf-bar-code.b-code
     4435         buf-price-list.doc-num   = buf-price-doc.doc-num
     4436         buf-price-list.prod-type = buf-goods.prod-type
     4437         buf-price-list.prod-code = buf-goods.prod-code
     4438         buf-price-list.artic     = buf-goods.artic
     4439         buf-price-list.obj-type  = buf-price-doc.obj-type
     4440         buf-price-list.obj-code  = buf-price-doc.obj-code
     4441         buf-price-list.vat-pc    = local_vat-pc
     4442         buf-price-list.slt-pc    = local_slt-pc
     4443         buf-price-list.price-prev = cur-pr
     4444         .
     4445       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     4446           buf-bar-code.in-code   = "" and
     4447           buf-bar-code.part-code = "" and
     4448           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     4449         buf-price-list.main-price = yes.
     4450         if cur-pr <> ? then do:
     4451           run exp-prt (input buf-goods.gds-code,
     4452                       input cur-dn,
     4453                       input new-num,
     4454                       output new-rec) no-error.
     4455           if error-status :error then do:
     4456             message
     4457               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     4458               view-as alert-box error.
     4459             undo cre-pr, return error.
     4460           end.
     4461         end.
     4462       end.
     4463       else do:
     4464         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     4465           buf-price-list.d-pcnt = ?.
     4466         end.
     4467         buf-price-list.main-price = no.
     4468       end.
     4469     end.
     4470   end.
     4471   new-rec = recid (buf-price-list).
     4472   END PROCEDURE.
     4473   procedure calc-price-line-num :
     4474    do
     4475    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4476    :
     4477   define input parameter p-doc-num as character no-undo .
     4478   define output parameter p-num  as integer no-undo .
     4479   define variable v-fact as integer no-undo .
     4480   define buffer buf_1_price-list for ub.price-list .
     4481   p-num = 1 .
     4482   find last  buf_1_price-list no-lock where
     4483              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     4484              if available buf_1_price-list then
     4485                   assign
     4486                     v-fact = buf_1_price-list.line-num
     4487                   .
     4488   v-fact = v-fact + 1.
     4489   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     4490    end.
     4491   end procedure.
     4492   PROCEDURE del-pr-list:
     4493   define input parameter bc    like ub.bar-code.b-code   no-undo.
     4494   define input parameter d-num like ub.price-doc.doc-num no-undo.
     4495   define input parameter round-method as character         no-undo.
     4496   define input parameter round-base   as decimal      no-undo.
     4497   define buffer buf-price-list for ub.price-list.
     4498   define buffer buf-bar-code   for ub.bar-code.
     4499   define buffer buf-goods      for ub.goods.
     4500   define variable l-ov-on as logical no-undo .
     4501   del-pr:
     4502   do on error undo del-pr, return error:
     4503     find first  buf-price-list no-lock where
     4504                 buf-price-list.doc-num    = d-num and
     4505                 buf-price-list.b-code     = bc and
     4506                 buf-price-list.price-type = "" no-error.
     4507     if not available buf-price-list then
     4508       undo del-pr, return error.
     4509     find  buf-goods no-lock where
     4510           buf-goods.prod-type = buf-price-list.prod-type and
     4511           buf-goods.prod-code = buf-price-list.prod-code and
     4512           buf-goods.artic     = buf-price-list.artic.
     4513     if buf-price-list.main-price then do:
     4514       for each  buf-price-list exclusive-lock where
     4515                 buf-price-list.doc-num   = d-num and
     4516                 buf-price-list.artic     = buf-goods.artic and
     4517                 buf-price-list.prod-type = buf-goods.prod-type and
     4518                 buf-price-list.prod-code = buf-goods.prod-code,
     4519           first buf-bar-code no-lock where
     4520                 buf-bar-code.b-code = buf-price-list.b-code
     4521       on error undo del-pr, return error:
     4522   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     4524     (input  ub.buf-price-list.obj-type
     4525     ,input  ub.buf-price-list.obj-code
     4526     ,input  ub.buf-price-list.artic
     4527     ,input  ub.buf-price-list.prod-type
     4528     ,input  ub.buf-price-list.prod-code
     4529     ,input  'ov-on=request:exclusive'
     4530     ,output l-ov-on
     4531     ) no-error .
     4532         if error-status:error then do:
     4533           message
     4534             vss-workfile vss-revision vss-description skip
     4535             "Ошибка получения признака товара на объекте" skip
     4536             error-status :get-message(1) skip
     4537             return-value skip
     4538             view-as alert-box error .
     4539         end.
     4540         if l-ov-on then do:
     4541   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     4543     (input  ub.buf-price-list.obj-type
     4544     ,input  ub.buf-price-list.obj-code
     4545     ,input  ub.buf-price-list.artic
     4546     ,input  ub.buf-price-list.prod-type
     4547     ,input  ub.buf-price-list.prod-code
     4548     ,input  'ov-on=false'
     4549     ,output l-ov-on
     4550     ) no-error .
     4551           if error-status :error then do:
     4552           end.
     4553          end.
     4554         delete buf-price-list.
     4555       end.
     4556     end.
     4557     else do:
     4558       find  buf-bar-code no-lock where
     4559             buf-bar-code.b-code = buf-price-list.b-code.
     4560       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     4561         message
     4562           "Нельзя удалить неосновную цену." skip
     4563           "Неосновная цена (скидка) не может быть неопределенной." skip
     4564           "Код:" bc skip
     4565           "Переоценка:" d-num
     4566           view-as alert-box error.
     4567         undo del-pr, return error.
     4568       end.
     4569       find current buf-price-list exclusive-lock no-error .
     4570       delete buf-price-list.
     4571       run calc-base-upd (input buf-bar-code.b-code,
     4572                         input d-num,
     4573                         input round-method,
     4574                         input round-base) no-error.
     4575       if error-status :error then
     4576         undo del-pr, return error.
     4577     end.
     4578   end.
     4579   END PROCEDURE.
     4580   PROCEDURE calc-base-upd:
     4581   define input parameter bc    like ub.bar-code.b-code   no-undo.
     4582   define input parameter d-num like ub.price-doc.doc-num no-undo.
     4583   define input parameter round-method as character         no-undo.
     4584   define input parameter round-base   as decimal      no-undo.
     4585   define buffer alt-bar-code   for ub.bar-code.
     4586   define buffer alt-price-list for ub.price-list.
     4587   define buffer buf-bar-code   for ub.bar-code.
     4588   define buffer buf-goods      for ub.goods.
     4589   calc-base:
     4590   do on error undo calc-base, return error:
     4591     find  buf-bar-code no-lock where
     4592           buf-bar-code.b-code = bc.
     4593     find  buf-goods no-lock where
     4594           buf-goods.gds-code = buf-bar-code.gds-code.
     4595     for each  alt-bar-code no-lock where
     4596               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     4597               alt-bar-code.node-code = buf-bar-code.node-code and
     4598               alt-bar-code.part-code = buf-bar-code.part-code and
     4599               alt-bar-code.in-code   = buf-bar-code.in-code and
     4600               alt-bar-code.unit-cli <> buf-goods.unit-base,
     4601         each  alt-price-list where
     4602               alt-price-list.doc-num    = d-num and
     4603               alt-price-list.b-code     = alt-bar-code.b-code and
     4604               alt-price-list.price-type = ""
     4605         on error undo calc-base, return error:
     4606       run calc-pr-alt (input d-num,
     4607                       input alt-bar-code.b-code,
     4608                       input round-method,
     4609                       input round-base) no-error.
     4610       if error-status:error then
     4611         undo calc-base, return error.
     4612     end.
     4613   end.
     4614   END PROCEDURE.
     4615   PROCEDURE calc-pr-alt:
     4616   define input parameter d-num like ub.price-doc.doc-num no-undo.
     4617   define input parameter bc    like ub.bar-code.b-code   no-undo.
     4618   define input parameter r-method as character             no-undo.
     4619   define input parameter r-base   as decimal              no-undo.
     4620   define buffer buf-price-doc  for ub.price-doc.
     4621   define buffer buf-price-list for ub.price-list.
     4622   define buffer buf-bar-code   for ub.bar-code.
     4623   define buffer buf-goods      for ub.goods.
     4624   define buffer old-price-list for ub.price-list.
     4625   define variable pr-rec   as   recid                  no-undo.
     4626   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     4627   pr-alt:
     4628   do on error undo pr-alt, return error:
     4629     if r-method = ? or
     4630        r-base = ? then do:
     4631       message
     4632         "Нельзя удалить основную цену." skip
     4633         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     4634         "Код:" bc skip
     4635         "Переоценка:" d-num
     4636         view-as alert-box error.
     4637       undo pr-alt, return error.
     4638     end.
     4639     find  buf-price-doc where
     4640           buf-price-doc.doc-num = d-num.
     4641     find  buf-bar-code no-lock where
     4642           buf-bar-code.b-code = bc.
     4643     find  buf-goods no-lock where
     4644           buf-goods.gds-code = buf-bar-code.gds-code.
     4645     find  buf-price-list where
     4646           buf-price-list.doc-num = buf-price-doc.doc-num and
     4647           buf-price-list.b-code  = bc.
     4648     if buf-price-list.d-pcnt = ? then do:
     4649   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     4651     (input  buf-price-doc.obj-type
     4652     ,input  buf-price-doc.obj-code
     4653     ,input  bc
     4654     ,input  0
     4655     ,input  0
     4656     ,output pr-rec
     4657     ,output pr-c-b-r
     4658     )  .
     4659       find old-price-list no-lock where
     4660           recid (old-price-list) = pr-rec no-error.
     4661       if available old-price-list and
     4662         old-price-list.b-code = bc then
     4663         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     4664       else
     4665         buf-price-list.d-pcnt = 0.
     4666     end.
     4667      if buf-price-list.d-pcnt = ? then do:
     4668         assign
     4669           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     4670           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     4671           .
     4672     end.
     4673     else do:
     4674         assign
     4675           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     4676                                         buf-bar-code.cli-base-rate *
     4677                                         (1 - buf-price-list.d-pcnt / 100)
     4678           buf-price-list.calc-method =  'Основная':U
     4679           .
     4680   case r-method :
     4681     when '9-окончание':U then do:
     4682       if buf-price-list.price-sale < 29 then do:
     4683         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     4684           assign
     4685             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     4686           .
     4687         end.
     4688       end.
     4689       else do:
     4690         if (buf-price-list.price-sale modulo 10) < 3 then do:
     4691           assign
     4692             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     4693                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     4694                   - 1 ) * 10
     4695                 + 9
     4696           .
     4697         end.
     4698         else do:
     4699           assign
     4700             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     4701                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     4702                   ) * 10
     4703                 + 9
     4704           .
     4705         end.
     4706         assign
     4707           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     4708         .
     4709       end.
     4710     end.
     4711     when '9-99окончание':U then do:
     4712       if buf-price-list.price-sale < r-base then do:
     4713         assign
     4714           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     4715         .
     4716       end.
     4717       else do:
     4718         assign
     4719           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     4720         .
     4721       end.
     4722     end.
     4723     when 'Без-дробных':U then do:
     4724       assign
     4725         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     4726       .
     4727     end.
     4728     when 'Произвольно':U then do:
     4729       if r-base <> 0 then do:
     4730         assign
     4731           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     4732         .
     4733         if buf-price-list.price-sale = 0 then do:
     4734           assign
     4735             buf-price-list.price-sale = r-base
     4736           .
     4737         end.
     4738       end.
     4739     end.
     4740     when 'Вверх':U then do:
     4741       if r-base <> 0 then do:
     4742         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     4743           assign
     4744             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     4745           .
     4746         end.
     4747       end.
     4748       if buf-price-list.price-sale = 0 then do:
     4749         assign
     4750           buf-price-list.price-sale = r-base
     4751         .
     4752       end.
     4753     end.
     4754     when 'Коэффициент':U then do:
     4755       if r-base <> 0 then do:
     4756         assign
     4757           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     4758         .
     4759       end.
     4760     end.
     4761     when 'Отключено':U then do:
     4762     end.
     4763     otherwise do:
     4764       message
     4765         vss-workfile vss-revision vss-description skip
     4766         "Неизвестный метод округления продажной цены" skip
     4767         "round-method" r-method skip
     4768         "round-base"   r-base   skip
     4769         "price"        buf-price-list.price-sale             skip
     4770         view-as alert-box error .
     4771     end.
     4772   end.
     4773     end.
     4774   end.
     4775   END PROCEDURE.
     4776   PROCEDURE calc-pr-discnt:
     4777   define input parameter d-num like ub.price-doc.doc-num no-undo.
     4778   define input parameter bc    like ub.bar-code.b-code   no-undo.
     4779   define buffer buf-price-doc  for ub.price-doc.
     4780   define buffer buf-price-list for ub.price-list.
     4781   define buffer buf-bar-code   for ub.bar-code.
     4782   define buffer buf-goods      for ub.goods.
     4783   define buffer old-price-list for ub.price-list.
     4784   define variable pr-rec   as   recid                  no-undo.
     4785   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     4786   pr-discnt:
     4787   do on error undo pr-discnt, return error:
     4788     find  buf-price-doc where
     4789           buf-price-doc.doc-num = d-num.
     4790     find  buf-bar-code no-lock where
     4791           buf-bar-code.b-code = bc.
     4792     find  buf-goods no-lock where
     4793           buf-goods.gds-code = buf-bar-code.gds-code.
     4794     find  buf-price-list where
     4795           buf-price-list.doc-num = buf-price-doc.doc-num and
     4796           buf-price-list.b-code  = bc.
     4797     buf-price-list.d-pcnt = (1 -
     4798                              buf-price-list.price-sale /
     4799                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     4800                              buf-bar-code.cli-base-rate) *
     4801                              100
     4802                              .
     4803   end.
     4804   END PROCEDURE.
     4805   PROCEDURE calc-pr-sub :
     4806   define  input  parameter bc             like ub.price-list.b-code no-undo.
     4807   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     4808   define  input  parameter calc-method  as character    no-undo.
     4809   define  input  parameter increase-pc  as decimal      no-undo.
     4810   define  input  parameter round-method as character    no-undo.
     4811   define  input  parameter round-base   as decimal      no-undo.
     4812   define  output parameter calc-rec     as recid        no-undo.
     4813   define  buffer buf-price-list for ub.price-list.
     4814   define  buffer buf-bar-code   for ub.bar-code.
     4815   define  buffer buf-goods      for ub.goods.
     4816   define  buffer buf-gds-prt    for ub.gds-prt.
     4817   define  buffer buf-gds-grp    for ub.gds-grp.
     4818   define  buffer buf-price-doc  for ub.price-doc.
     4819   calc-sub:
     4820   do on error undo calc-sub, return error:
     4821     find  buf-bar-code no-lock where
     4822           buf-bar-code.b-code = bc.
     4823     find  buf-goods no-lock where
     4824           buf-goods.gds-code = buf-bar-code.gds-code.
     4825     find  buf-gds-prt no-lock where
     4826           buf-gds-prt.node-code = buf-bar-code.node-code.
     4827     find  buf-price-list where
     4828           buf-price-list.doc-num    = d-num and
     4829           buf-price-list.b-code     = bc and
     4830           buf-price-list.price-type = "".
     4831     find  buf-price-doc where
     4832           buf-price-doc.doc-num = d-num.
     4833     calc-rec = recid (buf-price-list).
     4834     if buf-price-list.main-price then do:
     4835       for each  buf-price-list where
     4836                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     4837                 buf-price-list.main-price = no and
     4838                 buf-price-list.artic      = buf-goods.artic and
     4839                 buf-price-list.prod-type  = buf-goods.prod-type and
     4840                 buf-price-list.prod-code  = buf-goods.prod-code,
     4841           first buf-bar-code no-lock where
     4842                 buf-bar-code.b-code   = buf-price-list.b-code and
     4843                 buf-bar-code.unit-cli = buf-goods.unit-base
     4844           on error undo calc-sub, return error:
     4845         run calc-pr-list (input  buf-bar-code.b-code,
     4846                           input  buf-price-list.doc-num,
     4847                           input  calc-method,
     4848                           input  increase-pc,
     4849                           input  round-method,
     4850                           input  round-base,
     4851                           input ? ,
     4852                           input ? ,
     4853                           input ? ,
     4854                           input ? ,
     4855                           output calc-rec) no-error.
     4856         if error-status :error then
     4857           undo calc-sub, return error.
     4858         calc-rec = recid (buf-price-list).
     4859       end.
     4860       for each  buf-price-list where
     4861                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     4862                 buf-price-list.main-price = no and
     4863                 buf-price-list.artic      = buf-goods.artic and
     4864                 buf-price-list.prod-type  = buf-goods.prod-type and
     4865                 buf-price-list.prod-code  = buf-goods.prod-code,
     4866           first buf-bar-code no-lock where
     4867                 buf-bar-code.b-code    = buf-price-list.b-code and
     4868                 buf-bar-code.unit-cli <> buf-goods.unit-base
     4869           on error undo calc-sub, return error:
     4870         run calc-pr-alt (input buf-price-doc.doc-num,
     4871                         input buf-bar-code.b-code,
     4872                         input round-method,
     4873                         input round-base) no-error.
     4874         if error-status :error then
     4875           undo calc-sub, return error.
     4876       end.
     4877     end.
     4878     else do:
     4879       run calc-base-upd (input buf-bar-code.b-code,
     4880                         input buf-price-doc.doc-num,
     4881                         input round-method,
     4882                         input round-base) no-error.
     4883       if error-status :error then
     4884         undo calc-sub, return error.
     4885     end.
     4886   end.
     4887   END PROCEDURE.
     4888   procedure ver-pr-nogds :
     4889   define input  parameter p-gds-code      as integer   no-undo .
     4890   define input  parameter p-par-pr-nogds  as character no-undo .
     4891   define output parameter p-not           as logical   no-undo .
     4892   define output parameter p-str           as character no-undo .
     4893   define buffer buf_goods for ub.goods  .
     4894   define variable nn as integer   no-undo .
     4895   define variable ii as integer   no-undo .
     4896   define variable v-namegrp as character no-undo .
     4897     do
     4898     on error undo, return error return-value
     4899     :
     4900     if p-par-pr-nogds = "1" then do:
     4901        assign
     4902         p-not = true
     4903         p-str = ""
     4904        .
     4905        return .
     4906     end.
     4907     assign
     4908       p-not = false
     4909       p-str = ""
     4910     .
     4911     find first buf_goods no-lock where
     4912                buf_goods.gds-code = p-gds-code no-error .
     4913     nn = num-entries(par-pr-nogds-long,chr(4)) .
     4914     repeat ii = 1 to nn:
     4915        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     4916        if buf_goods.grp-name  begins v-namegrp  then do:
     4917           assign
     4918             p-not = true
     4919             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     4920           .
     4921           leave .
     4922        end.
     4923     end.
     4924     end.
     4925   end procedure.
     4926   define buffer b1-doc-line    for ub.doc-line .
     4927   define variable doc-code      like ub.trn-doc.doc-code  no-undo .
     4928   define variable cost-base     as decimal no-undo .
     4929   define variable cost-rubl     as decimal no-undo .
     4930   define variable v-price-base  as decimal no-undo .
     4931   define variable v-price-rubl  as decimal no-undo.
     4932   define variable tt-price-sale as decimal no-undo.
     4933   define variable cur-rt-base   as decimal no-undo.
     4934   define variable cur-rt-rubl   as decimal no-undo.
     4935   define variable v-parts as logical   no-undo init false .
     4936   define variable tt-price-prodwihvat as decimal no-undo.
     4937   define variable tt-prod-vat         as decimal no-undo.
     4938   define variable v-root-b-code like ub.bar-code.b-code no-undo .
     4939   define variable pr-list-rec   as recid                no-undo .
     4940   define variable calc-rec      as recid                no-undo.
     4941   define variable par-type       as character          no-undo .
     4942   define variable v-round-method as character          no-undo .
     4943   define variable v-round-base   as decimal            no-undo .
     4944   define var p-new-road-tax as decimal no-undo .
     4945   define variable p-flag as logical init false no-undo .
     4946   define variable v-name-tax as character no-undo .
     4947   define variable par-disc-mar as logical no-undo .
     4948   define variable v-ret as logical no-undo .
     4949   define variable v-plt-id     as integer   no-undo .
     4950   define variable v-plt-db-num as integer   no-undo .
     4951   define variable v-pdf-id     as integer   no-undo .
     4952   define variable v-pdf-db-num as integer   no-undo .
     4953   define variable par-pr-nakl as logical   no-undo .
     4954   define variable v-rest-last as decimal   no-undo .
     4955   define variable v-rest-qnty as decimal   no-undo .
     4956   define variable v-rest-sale as decimal   no-undo .
     4957   define variable v-sale-base as decimal   no-undo .
     4958   define variable is-after-margin-parts as logical   no-undo .
     4959   define variable  par-gen-mrgn-ie-parts as character no-undo .
     4960   define variable  par-gen-mrgn-iv-parts as character no-undo .
     4961   define variable  par-gen-mrgn-im-parts as character no-undo .
     4962   define variable v-last-price-sale   as decimal   no-undo .
     4963   define variable v-last-calc-method  as character no-undo .
     4964   define variable attr-marg-pr-paraf   as character no-undo init "0".
     4965   define variable v-type               as character no-undo .
     4966   define variable loc-grp-increase-pc   as decimal   no-undo .
     4967   define variable loc-grp-round-method  as character no-undo .
     4968   define variable loc-grp-round-base    as decimal   no-undo .
     4969   define variable p-prc-min             as decimal   no-undo .
     4970   define variable p-prc-max             as decimal   no-undo .
     4971   define variable p-value-margin        as integer   no-undo .
     4972   define variable p-type-margin         as logical   no-undo .
     4973   define variable p-value-increase      as integer   no-undo .
     4974   define variable p-type-increase       as logical   no-undo .
     4975   define variable p-value-rmethod       as integer   no-undo .
     4976   define variable p-type-rmethod        as logical   no-undo .
     4977   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4978   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4979   procedure prl-vat:
     4980     define input parameter parrecid as recid no-undo.
     4981       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
     4982       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     4983       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     4984       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     4985       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     4986       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     4987       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     4988       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
     4989       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
     4990       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     4991       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
     4992       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
     4993       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
     4994       define output parameter excise-rubl-saleprl            like ub.doc-line.price-rubl no-undo.
     4995       define output parameter discnt-base-saleprl            like ub.gds-dtl.discnt-base no-undo.
     4996       define output parameter discnt-rubl-saleprl            like ub.gds-dtl.discnt-rubl no-undo.
     4997       define buffer out-vatp_gds-dtlprl     for ub.gds-dtl.
     4998       define buffer buf_out-vatp_gds-dtlprl for ub.gds-dtl.
