     2680   procedure lineattr-write-add-line-cli :
     2681   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2682   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2683   define input  parameter p-cli-type      as character no-undo .
     2684   define input  parameter p-cli-code      as integer   no-undo .
     2685   define input  parameter p-contract-code as integer   no-undo .
     2686   define input  parameter p-host-code     as integer   no-undo .
     2687   define input  parameter p-exch-code     as integer   no-undo .
     2688   define input  parameter p-exch-rate     as decimal   no-undo .
     2689   define input  parameter p-exch-scale    as integer   no-undo .
     2690   define input  parameter p-sum-cli       as decimal   no-undo .
     2691   define input  parameter p-sum-vat       as decimal   no-undo .
     2692   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2693     do
     2694     on error undo, return error return-value
     2695     :
     2696       find first buf_doc-line-attr exclusive-lock
     2697         where buf_doc-line-attr.doc-code  = p-doc-code
     2698           and buf_doc-line-attr.gds-code  = p-gds-code
     2699           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2700                                             chr(4) + p-cli-type +
     2701                                             chr(4) + string(p-cli-code) +
     2702                                             chr(4) + string(p-contract-code) +
     2703                                             chr(4) + string(p-host-code)
     2704         no-error .
     2705       if not available buf_doc-line-attr then do:
     2706         create buf_doc-line-attr .
     2707         assign
     2708           buf_doc-line-attr.doc-code  = p-doc-code
     2709           buf_doc-line-attr.gds-code  = p-gds-code
     2710           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     2711                                         chr(4) + p-cli-type +
     2712                                         chr(4) + string(p-cli-code) +
     2713                                         chr(4) + string(p-contract-code) +
     2714                                         chr(4) + string(p-host-code)
     2715         .
     2716       end.
     2717       assign
     2718         buf_doc-line-attr.attr-value =
     2719         string(p-exch-code)  + chr(4) +
     2720         string(p-exch-rate)  + chr(4) +
     2721         string(p-exch-scale) + chr(4) +
     2722         string(p-sum-cli)    + chr(4) +
     2723         string(p-sum-vat)
     2724         .
     2725     end.
     2726   end procedure.
     2727   procedure lineattr-value-add-line-cli :
     2728   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2729   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2730   define input   parameter p-cli-type      as character no-undo .
     2731   define input   parameter p-cli-code      as integer   no-undo .
     2732   define input   parameter p-contract-code as integer   no-undo .
     2733   define input   parameter p-host-code     as integer   no-undo .
     2734   define output  parameter p-exch-code     as integer   no-undo .
     2735   define output  parameter p-exch-rate     as decimal   no-undo .
     2736   define output  parameter p-exch-scale    as integer   no-undo .
     2737   define output  parameter p-sum-cli       as decimal   no-undo .
     2738   define output  parameter p-sum-vat       as decimal   no-undo .
     2739   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2740     do
     2741     on error undo, return error return-value
     2742     :
     2743       find first buf_doc-line-attr exclusive-lock
     2744         where buf_doc-line-attr.doc-code  = p-doc-code
     2745           and buf_doc-line-attr.gds-code  = p-gds-code
     2746           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2747                                             chr(4) + p-cli-type +
     2748                                             chr(4) + string(p-cli-code) +
     2749                                             chr(4) + string(p-contract-code) +
     2750                                             chr(4) + string(p-host-code)
     2751         no-error .
     2752       if available buf_doc-line-attr then do:
     2753        assign
     2754           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     2755           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     2756           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     2757           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     2758           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     2759          .
     2760        end.
     2761     end.
     2762   end procedure.
     2763   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     2764     define variable v-code as character no-undo .
     2765     define variable v-type as character no-undo .
     2766     define variable v-gds-code as integer   no-undo .
     2767   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2768   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2769     (input  local-doc-line.artic
     2770     ,input  local-doc-line.prod-type
     2771     ,input  local-doc-line.prod-code
     2772     ,output v-gds-code
     2773     )  .
     2774     run lineattr-value (
     2775         input   local-doc-line.doc-code ,
     2776         input   v-gds-code              ,
     2777         input   'reason-code':U ,
     2778         output  v-code                  ,
     2779         output  v-type ) .
     2780     find first ub.trn-reason no-lock where
     2781                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     2782     if not available ub.trn-reason then do:
     2783        return "" .
     2784     end.
     2785     else do:
     2786        return ub.trn-reason.reason-name .
     2787     end.
     2788   end function.
     2789   procedure lineattr-value-parts :
     2790     do
     2791     on error undo, return error return-value
     2792     :
     2793       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2794       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     2795       define input  parameter p-part-code   as character no-undo .
     2796       define input  parameter p_in-code     as character no-undo .
     2797       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     2798       define output parameter p-value       as    decimal   no-undo .
     2799       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2800       find first buf_doc-line-attr no-lock
     2801         where buf_doc-line-attr.doc-code  = p-doc-code
     2802           and buf_doc-line-attr.gds-code  = p-gds-code
     2803           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2804         no-error .
     2805       if avail buf_doc-line-attr then do:
     2806         assign
     2807           p-value = decimal( buf_doc-line-attr.attr-value)
     2808         .
     2809       end.
     2810       else do:
     2811         assign
     2812           p-value = 0
     2813         .
     2814       end.
     2815     end.
     2816   end procedure.
