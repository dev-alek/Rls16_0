     2057   procedure pdoc-forming-attr :
     2058   define input  parameter p-plt-id       as integer   no-undo .
     2059   define input  parameter p-plt-db-num   as integer   no-undo .
     2060   define input  parameter p-pdf-id       as integer   no-undo .
