     3351     (input  v-host-code
     3352     ,input  today
     3353     ,output v-base-rate
     3354     ,output v-base-scale
     3355     )  .
     3356   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3357   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     3358     (input  ?
     3359     ,input  p-obj-type
     3360     ,input  p-obj-code
     3361     ,input  yes
     3362     ,output p-plt-id
     3363     ,output p-plt-db-num
     3364     )  .
     3365      create ub.price-doc-forming.
     3366      assign
     3367         ub.price-doc-forming.plt-id       = p-plt-id
     3368         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     3369         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     3370         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     3371         ub.price-doc-forming.base-rate    = v-base-rate
     3372         ub.price-doc-forming.base-scale   = v-base-scale
     3373         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     3374         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     3375         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     3376         ub.price-doc-forming.stts         = 0
     3377         ub.price-doc-forming.sys-date     = today
     3378         ub.price-doc-forming.sys-time     = time
     3379         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     3380         ub.price-doc-forming.who          = v-cntxt-userid
     3381         ub.price-doc-forming.name         = "автосоздание"
     3382      .
     3383      assign
     3384       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     3385       p-pdf-id      = ub.price-doc-forming.pdf-id
     3386       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     3387       p-plt-id      = ub.price-doc-forming.plt-id
     3388      .
     3389     end.
     3390   end procedure.
     3391   procedure prcreate-new-price-doc-forming-gds :
     3392   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     3393   define input  parameter p-obj-type   as character no-undo .
     3394   define input  parameter p-obj-code   as integer   no-undo .
     3395   define input  parameter par-pr-notls as character no-undo .
     3396   define input  parameter par-pr-altex as character no-undo .
     3397   define input  parameter par-pr-sclex as character no-undo .
     3398   define input  parameter p-line-num    as integer   no-undo .
     3399   define input  parameter p-gds-code    as integer   no-undo .
     3400   define input  parameter p-price-sale  as decimal   no-undo .
     3401   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     3402   define buffer buf_goods for ub.goods  .
     3403   define buffer buf_bar-code for ub.bar-code  .
     3404   define buffer main_bar-code for ub.bar-code  .
     3405   define variable main-b-code as integer   no-undo .
     3406   define variable v-sec as integer   no-undo .
     3407     do
     3408     on error undo, return error return-value
     3409     :
     3410   define variable v-cur-dn as character no-undo .
     3411   define variable v-cur-pr as decimal   no-undo .
     3412   define variable v-cur-rt as decimal   no-undo .
     3413   define variable v-cur-ex as decimal   no-undo .
     3414   find first buf_price-doc-forming no-lock where
     3415              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     3416              if error-status :error then return error .
     3417   find first buf_goods no-lock where
     3418              buf_goods.gds-code  = p-gds-code no-error .
     3419              if error-status :error then return error .
     3420   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3421     (input  buf_goods.gds-code
     3422     ,input  ?
     3423     ,output main-b-code
     3424     ) no-error .
     3425   run check-use-bar-code (main-b-code) no-error .
     3426   if error-status :error then return .
     3427   run create-line-pdf-mpl-lib (
     3428        input buf_price-doc-forming.plt-db-num
     3429       ,input buf_price-doc-forming.plt-id
     3430       ,input buf_price-doc-forming.pdf-db
     3431       ,input buf_price-doc-forming.pdf-id
     3432       ,input p-line-num
     3433       ,input main-b-code
     3434       ,input buf_goods.artic
     3435       ,input buf_goods.prod-type
     3436       ,input buf_goods.prod-code
     3437       ,input ""
     3438       ,input 0
     3439       ,input p-price-sale
     3440       ,input ""
     3441       ,input 0
     3442      ,input-output v-sec ) no-error .
     3443      if error-status :error  then do:
     3444        message
     3445          vss-workfile vss-revision vss-description skip
     3446          error-status :get-message(1) skip
     3447          return-value skip
     3448          "2"
     3449          view-as alert-box error
     3450        .
     3451      end.
     3452   define buffer old_price-list for ub.price-list  .
     3453   if par-pr-notls = "yes" then do:
     3454   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3455   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3456     (input  p-obj-type
     3457     ,input  p-obj-code
     3458     ,input  main-b-code
     3459     ,input  0
     3460     ,input  0
     3461     ,output v-cur-dn
     3462     ,output v-cur-pr
     3463     ,output v-cur-rt
     3464     ,output v-cur-ex
     3465     )  .
     3466   end.
     3467   if par-pr-altex = "yes" and
     3468      par-pr-notls = "yes" then do:
     3469       if v-cur-dn <> "" then do:
     3470           for each old_price-list no-lock where
     3471                    old_price-list.doc-num = v-cur-dn and
     3472                    old_price-list.artic      = buf_goods.artic and
     3473                    old_price-list.prod-type  = buf_goods.prod-type and
     3474                    old_price-list.prod-code  = buf_goods.prod-code and
     3475                    old_price-list.main-price = no,
     3476                   first buf_bar-code no-lock where
     3477                         buf_bar-code.b-code   = old_price-list.b-code and
     3478                         buf_bar-code.unit-cli <> buf_goods.unit-base
     3479                         :
     3480                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     3481                          if error-status :error then next.
     3482                    run create-line-pdf-mpl-lib (
     3483                          input buf_price-doc-forming.plt-db-num
     3484                         ,input buf_price-doc-forming.plt-id
     3485                         ,input buf_price-doc-forming.pdf-db
     3486                         ,input buf_price-doc-forming.pdf-id
     3487                         ,input p-line-num
     3488                         ,input old_price-list.b-code
     3489                         ,input buf_goods.artic
     3490                         ,input buf_goods.prod-type
     3491                         ,input buf_goods.prod-code
     3492                         ,input ""
     3493                         ,input 0
     3494                         ,input old_price-list.price-sale
     3495                         ,input ""
     3496                         ,input 0
     3497                        ,input-output v-sec ) no-error .
     3498           end.
     3499       end.
     3500   end.
     3501   if par-pr-sclex = "yes" and
     3502      par-pr-notls = "yes" then do:
     3503       if v-cur-dn <> "" then do:
     3504           for each old_price-list no-lock where
     3505                    old_price-list.doc-num    = v-cur-dn and
     3506                    old_price-list.artic      = buf_goods.artic and
     3507                    old_price-list.prod-type  = buf_goods.prod-type and
     3508                    old_price-list.prod-code  = buf_goods.prod-code and
     3509                    old_price-list.main-price = no,
     3510                   first buf_bar-code no-lock where
     3511                         buf_bar-code.b-code   = old_price-list.b-code and
     3512                         buf_bar-code.in-code  = "" and
     3513                         buf_bar-code.unit-cli = buf_goods.unit-base
     3514                         :
     3515                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     3516                          if error-status :error then next.
     3517                    run create-line-pdf-mpl-lib (
     3518                          input buf_price-doc-forming.plt-db-num
     3519                         ,input buf_price-doc-forming.plt-id
     3520                         ,input buf_price-doc-forming.pdf-db
     3521                         ,input buf_price-doc-forming.pdf-id
     3522                         ,input p-line-num
     3523                         ,input old_price-list.b-code
     3524                         ,input buf_goods.artic
     3525                         ,input buf_goods.prod-type
     3526                         ,input buf_goods.prod-code
     3527                         ,input ""
     3528                         ,input 0
     3529                         ,input old_price-list.price-sale
     3530                         ,input ""
     3531                         ,input 0
     3532                       ,input-output v-sec ) no-error .
     3533           end.
     3534       end.
     3535   end.
     3536   end.
     3537   end procedure.
     3538   procedure copy_new_price-doc-forming :
     3539   define input  parameter       p-recid      as recid no-undo .
     3540   define input-output parameter p-plt-db-num as integer   no-undo .
     3541   define input-output parameter p-plt-id     as integer   no-undo .
     3542   define output parameter       p-pdf-db-num as integer   no-undo .
     3543   define output parameter       p-pdf-id     as integer   no-undo .
     3544   define buffer buf_price-list-type        for ub.price-list-type  .
     3545   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     3546   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     3547   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     3548   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     3549   define variable v-host-code  as integer   no-undo .
     3550   define variable v-base-rate  as decimal   no-undo .
     3551   define variable v-base-scale as integer   no-undo .
     3552   define variable v-exch-rate  as decimal   no-undo .
     3553   define variable v-exch-scale as integer   no-undo .
     3554   define variable v-base as logical   no-undo .
     3555   define variable v-name as character no-undo .
     3556     do
     3557     on error undo, return error return-value
     3558     :
     3559   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3560   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     3561     (output v-base
     3562     )  .
     3563   find first buf_price-list-type no-lock where
     3564              buf_price-list-type.plt-db-num = p-plt-db-num and
     3565              buf_price-list-type.plt-id     = p-plt-id no-error .
     3566   if error-status :error then return error "Не найден ТПЛ".
     3567   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     3568   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     3569       if available buf_price-doc-forming then do :
     3570           assign
     3571             v-base-rate  = buf_price-doc-forming.base-rate
     3572             v-base-scale = buf_price-doc-forming.base-scale
     3573             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     3574           .
     3575       end.
     3576       else do:
     3577           assign
     3578             v-base-rate  = 1
     3579             v-base-scale = 1
     3580             v-name       = "Автосоздание"
     3581           .
     3582       end.
     3583      create ub.price-doc-forming.
     3584      assign
     3585         ub.price-doc-forming.plt-id       = p-plt-id
     3586         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     3587         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     3588         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     3589         ub.price-doc-forming.base-rate    = v-base-rate
     3590         ub.price-doc-forming.base-scale   = v-base-scale
     3591         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     3592         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     3593         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     3594         ub.price-doc-forming.stts         = 0
     3595         ub.price-doc-forming.sys-date     = today
     3596         ub.price-doc-forming.sys-time     = time
     3597         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     3598         ub.price-doc-forming.who          = v-cntxt-userid
     3599         ub.price-doc-forming.name         = v-name
     3600      .
     3601      assign
     3602       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     3603       p-pdf-id      = ub.price-doc-forming.pdf-id
     3604       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     3605       p-plt-id      = ub.price-doc-forming.plt-id
     3606      .
     3607     end.
     3608     if not available buf_price-doc-forming then return .
     3609   for each buf_price-doc-forming-attr no-lock where
     3610            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     3611            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     3612            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     3613            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     3614       create ub.price-doc-forming-attr.
     3615       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     3616       assign
     3617         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     3618         ub.price-doc-forming-attr.plt-id      = p-plt-id
     3619         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     3620         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     3621         .
     3622   end.
     3623   for each buf_price-doc-forming-gds no-lock where
     3624            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     3625            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     3626            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     3627            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     3628       create ub.price-doc-forming-gds.
     3629       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     3630       assign
     3631         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     3632         ub.price-doc-forming-gds.plt-id      = p-plt-id
     3633         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     3634         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     3635       .
     3636   end.
     3637   for each buf_pd-forming-gds-attr no-lock where
     3638            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     3639            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     3640            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     3641            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     3642       create ub.price-doc-forming-gdsattr.
     3643       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     3644       assign
     3645         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     3646         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     3647         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     3648         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     3649       .
     3650   end.
     3651   end procedure.
     3652   define variable par-pr-incpc as character no-undo.
     3653   define variable par-pr-rndmt as character no-undo.
     3654   define variable par-pr-rndbs as character no-undo.
     3655   define variable par-pr-clt-q as character no-undo.
     3656   define variable par-pr-dpl-q as character no-undo.
     3657   define variable par-pr-rdc-q as character no-undo.
     3658   define variable par-pr-abs-d as character no-undo.
     3659   define variable par-pr-altex as character no-undo.
     3660   define variable par-pr-parex as character no-undo.
     3661   define variable par-pr-sclex as character no-undo.
     3662   define variable par-pr-notls as character no-undo.
     3663   define variable par-pr-equ-dq as integer  no-undo.
     3664   define variable par-pr-discm as character no-undo .
     3665   define variable par-pr-dscnt as character no-undo .
     3666   define variable par-pr-print as character no-undo .
     3667   define variable par-pr-sigma as character no-undo .
     3668   define variable par-pr-goods as character no-undo.
     3669   define variable par-pr-nogds as character no-undo.
     3670   define variable par-alcohol  as character no-undo.
     3671   define variable par-gen-mrgn-ie as character no-undo .
     3672   define variable par-gen-mrgn-iv as character no-undo .
     3673   define variable par-gen-mrgn-im as character no-undo .
     3674   define variable par-pr-nakl-ie  as logical   no-undo .
     3675   define variable par-pr-nakl-iv  as logical   no-undo .
     3676   define variable par-pr-nakl-im  as logical   no-undo .
     3677   define variable par-pr-nogds-long as longchar no-undo .
     3678   define temp-table tmp-proof-price no-undo
     3679     field node-code like ub.gds-grp.node-code
     3680     field proof as decimal
     3681     field price as decimal
     3682   index pi node-code proof descending .
     3683   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3684   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3685   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3686   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     3687   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     3688   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     3689   ASSIGN
     3690      v-S_CONTRACT                = "Contract":U
     3691      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     3692      v-DELIM_CHR_3               = ","
     3693      .
     3694   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     3695   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     3696   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     3697   FUNCTION Can-Find-Spec RETURN LOGICAL (
     3698      INPUT iHost-Code    AS INTEGER,
     3699      INPUT iContract-Num AS INTEGER,
     3700      INPUT iGds-Code     AS INTEGER ):
     3701      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     3702      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     3703      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     3704      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     3705      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     3706      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     3707          INPUT  iHost-Code,
     3708          INPUT  iContract-Num,
     3709          OUTPUT iTmp-Extent3
     3710          ).
     3711      IF iTmp-Extent3[1] = 2 THEN DO:
     3712         ASSIGN
     3713            iTmp-Host-Code      = iTmp-Extent3[2]
     3714            iTmp-Contract-Num   = iTmp-Extent3[3]
     3715            .
     3716      END. ELSE DO:
     3717         ASSIGN
     3718            iTmp-Host-Code      = iHost-Code
     3719            iTmp-Contract-Num   = iContract-Num
     3720            .
     3721      END.
     3722      IF iGds-Code = ? THEN DO:
     3723         ASSIGN
     3724            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3725                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3726                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3727                           ).
     3728      END. ELSE DO:
     3729            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3730                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3731                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3732                              AND buf_Spec.Gds-Code      = iGds-Code
     3733                            ).
     3734      END.
     3735      RETURN (lRet).
     3736   END FUNCTION.
     3737   PROCEDURE MS-Contract-EXTENT-3:
     3738      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     3739      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     3740      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     3741      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     3742      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     3743      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     3744      FIND FIRST buf_Cont-2 WHERE
     3745                 buf_Cont-2.Host-Code      = i-Host-Code
     3746             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     3747           NO-LOCK NO-ERROR.
     3748      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     3749         RETURN.
     3750      END.
     3751      FOR FIRST buf_Ext-Classif WHERE
     3752                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3753           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3754                                               STRING(i-Contract-code)
     3755           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3756          NO-LOCK,
     3757          EACH buf_Cont WHERE
     3758               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     3759           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3760          NO-LOCK:
     3761          ASSIGN
     3762             i-Ret[1] = 1
     3763             i-Ret[2] = buf_Cont.Host-code
     3764             i-Ret[3] = buf_Cont.Contract-code
     3765             .
     3766          LEAVE.
     3767      END.
     3768      IF i-Ret[1] <> 1 THEN DO:
     3769         FOR FIRST buf_Ext-Classif WHERE
     3770                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3771              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3772                                                  STRING(i-Contract-code)
     3773              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3774             NO-LOCK,
     3775             EACH buf_Cont WHERE
     3776                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3777              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3778             NO-LOCK:
     3779             ASSIGN
     3780                i-Ret[1] = 2
     3781                i-Ret[2] = buf_Cont.Host-code
     3782                i-Ret[3] = buf_Cont.Contract-code
     3783                .
     3784             LEAVE.
     3785         END.
     3786      END.
     3787      RETURN.
     3788   END PROCEDURE.
