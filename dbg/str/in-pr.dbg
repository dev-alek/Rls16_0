     5192   end.
     5193   else do:
     5194     find first out-vatp_doc-attrprl no-lock
     5195       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     5196         and out-vatp_doc-attrprl.attr-code = 'envd':U
     5197         no-error .
     5198     if not available out-vatp_doc-attrprl then do:
     5199       assign
     5200         out-vatp-have-vat-sltprl = yes.
     5201     end.
     5202     else do:
     5203        out-vatp-have-vat-sltprl = no.
     5204     end.
     5205   end.
