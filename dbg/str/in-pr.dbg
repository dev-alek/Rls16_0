     7718           if ( cur-rt-base <> ? )   then
     7719             assign
     7720               buf-price-list.road-tax  = cur-rt-base
     7721               .
     7722               else
     7723                   assign
     7724                     buf-price-list.road-tax  = 0
     7725                     .
     7726      end.
     7727   case round-method :
     7728     when '9-окончание':U then do:
     7729       if buf-price-list.price-sale < 29 then do:
     7730         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     7731           assign
     7732             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     7733           .
     7734         end.
     7735       end.
     7736       else do:
     7737         if (buf-price-list.price-sale modulo 10) < 3 then do:
     7738           assign
     7739             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     7740                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     7741                   - 1 ) * 10
     7742                 + 9
     7743           .
     7744         end.
     7745         else do:
     7746           assign
     7747             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     7748                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     7749                   ) * 10
     7750                 + 9
     7751           .
     7752         end.
     7753         assign
     7754           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     7755         .
     7756       end.
     7757     end.
     7758     when '9-99окончание':U then do:
     7759       if buf-price-list.price-sale < round-base then do:
     7760         assign
     7761           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     7762         .
     7763       end.
     7764       else do:
     7765         assign
     7766           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     7767         .
     7768       end.
     7769     end.
     7770     when 'Без-дробных':U then do:
     7771       assign
     7772         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     7773       .
     7774     end.
     7775     when 'Произвольно':U then do:
     7776       if round-base <> 0 then do:
     7777         assign
     7778           buf-price-list.price-sale = round (buf-price-list.price-sale / round-base, 0) * round-base
     7779         .
     7780         if buf-price-list.price-sale = 0 then do:
     7781           assign
     7782             buf-price-list.price-sale = round-base
     7783           .
     7784         end.
     7785       end.
     7786     end.
     7787     when 'Вверх':U then do:
     7788       if round-base <> 0 then do:
     7789         if truncate ( buf-price-list.price-sale / round-base, 0 ) <> (buf-price-list.price-sale / round-base) then do:
     7790           assign
     7791             buf-price-list.price-sale = truncate (buf-price-list.price-sale / round-base, 0) * round-base + round-base
     7792           .
     7793         end.
     7794       end.
     7795       if buf-price-list.price-sale = 0 then do:
     7796         assign
     7797           buf-price-list.price-sale = round-base
     7798         .
     7799       end.
     7800     end.
     7801     when 'Коэффициент':U then do:
     7802       if round-base <> 0 then do:
     7803         assign
     7804           buf-price-list.price-sale = buf-price-list.price-sale * round-base
     7805         .
     7806       end.
     7807     end.
     7808     when 'Отключено':U then do:
     7809     end.
     7810     otherwise do:
     7811       message
     7812         vss-workfile vss-revision vss-description skip
     7813         "Неизвестный метод округления продажной цены" skip
     7814         "round-method" round-method skip
     7815         "round-base"   round-base   skip
     7816         "price"        buf-price-list.price-sale             skip
     7817         view-as alert-box error .
     7818     end.
     7819   end.
     7820     calc-rec = recid (buf-price-list).
     7821     run calc-pr-sub (input  buf-bar-code.b-code,
     7822                      input  buf-price-list.doc-num,
     7823                      input  calc-method,
     7824                      input  increase-pc,
     7825                      input  round-method,
     7826                      input  round-base,
     7827                      output calc-rec) no-error.
     7828     if error-status :error then
     7829       undo calc-pr, return error.
     7830       old-price-sale = buf-price-list.price-sale .
     7831      if line-mode = "calc":u then do:
     7832           run calc-sigma (input buf-price-list.b-code,
     7833                           input-output buf-price-list.price-sale,
     7834                           input buf-price-doc.host-code,
     7835                           input buf-price-doc.obj-code,
     7836                           input buf-price-doc.obj-type,
     7837                           output loc-ret).
     7838           if loc-ret = false then
     7839             message "Цена товара :" SKIP
     7840             "артикул :" buf-price-list.artic buf-price-list.prod-type buf-price-list.prod-code skip
     7841             "бар-код :" buf-price-list.b-code skip
     7842               "не изменилась из-за заданного максимально допустимого отклонения! " skip
     7843               " Рассчитанная цена "  old-price-sale skip
     7844               " Действующая цена "   buf-price-list.price-sale
     7845               view-as alert-box .
     7846      end.
     7847   end.
     7848   END PROCEDURE.
     7849   procedure calc-sigma :
     7850    do
     7851    on error undo, return error return-value
     7852    :
     7853   define input parameter l-bcode like ub.price-list.b-code no-undo .
     7854   define input-output parameter new-price as decimal no-undo .
     7855   define input parameter l-host as integer no-undo .
     7856   define input parameter l-code as integer no-undo .
     7857   define input parameter l-type as character no-undo .
     7858   define output parameter p-ret as logical no-undo .
     7859   define variable conf-par     as character no-undo.
     7860   define variable par-type     as character no-undo.
     7861   define variable i-sigma as decimal no-undo .
     7862   define variable cur-pr like ub.price-list.price-sale no-undo.
     7863   define variable cur-rt like ub.price-list.road-tax   no-undo.
     7864   define variable cur-ex like ub.price-list.excise     no-undo.
     7865   define variable cur-dn like ub.price-list.doc-num    no-undo.
     7866   define variable old-price as decimal no-undo .
     7867   define variable v-value-character as character no-undo .
     7868   define variable v-value-date      as date      no-undo .
     7869   define variable v-value-decimal   as decimal   no-undo .
     7870   define variable v-value-integer   as integer   no-undo .
     7871   define variable v-value-logical   as logical   no-undo .
     7872   p-ret = true  .
     7873   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     7874   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7875   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7876     (input  l-type
     7877     ,input  l-code
     7878     ,input  l-bcode
     7879     ,input  0
     7880     ,input  0
     7881     ,output cur-dn
     7882     ,output cur-pr
     7883     ,output cur-rt
     7884     ,output cur-ex
     7885     )  .
     7886   old-price = cur-pr .
     7887   if old-price =  new-price then do:
     7888      p-ret = true .
     7889      return.
     7890   end.
     7891      i-sigma = decimal(par-pr-sigma) .
     7892      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     7893          assign
     7894            p-ret = false
     7895            new-price = old-price
     7896          .
     7897          end.
     7898      else p-ret = true .
     7899     end.
     7900    end.
     7901   end procedure.
     7902   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7903   PROCEDURE VER-PR-EQU-DQ :
     7904   define input parameter  l-doc-num    like ub.price-list.doc-num    no-undo .
     7905   define input parameter  l-num       as integer no-undo .
     7906   define input parameter  l-b-code    as integer   no-undo .
     7907   define variable  l-doc-num2    like ub.price-list.doc-num    no-undo .
     7908   define buffer l-price-list  for ub.price-list .
     7909   define buffer pp_price-list for ub.price-list .
     7910   define buffer p2_price-list for ub.price-list .
     7911   define buffer main_price-list for ub.price-list .
     7912   define buffer alt_price-list  for ub.price-list .
     7913   define buffer buf1-bar-code for ub.bar-code .
     7914   define buffer buf2-bar-code for ub.bar-code .
     7915   define variable v-num as integer init 0 no-undo .
     7916   define variable bbb as logical no-undo .
     7917   define variable  l-price-sale like ub.price-list.price-sale no-undo .
     7918   define variable  l-road-tax   like ub.price-list.road-tax   no-undo .
     7919   define variable  l-excise     like ub.price-list.excise     no-undo .
     7920   define variable  l-ok         as logical no-undo .
     7921   define variable  check-par    as logical no-undo .
     7922   for each l-price-list where l-price-list.doc-num = l-doc-num     and
     7923                               l-price-list.main-price = true
     7924                               exclusive-lock  :
     7925     find first ub.goods where ub.goods.artic    = l-price-list.artic and
     7926                           ub.goods.prod-type = l-price-list.prod-type and
     7927                           ub.goods.prod-code = l-price-list.prod-code no-lock   .
     7928         check-par = false .
     7929         if l-num = 2 then do:
     7930           find first buf2-bar-code where buf2-bar-code.b-code = l-b-code no-lock no-error .
     7931           if ub.goods.gds-code <> buf2-bar-code.gds-code then next.
     7932         end.
     7933   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7934   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7935     (input  l-price-list.obj-type
     7936     ,input  l-price-list.obj-code
     7937     ,input  l-price-list.b-code
     7938     ,input  0
     7939     ,input  0
     7940     ,output l-doc-num2
     7941     ,output l-price-sale
     7942     ,output l-road-tax
     7943     ,output l-excise
     7944     ) no-error .
     7945         if l-doc-num2 <> ? then do :
     7946           if l-price-sale = l-price-list.price-sale
     7947           then do:
     7948             if par-pr-equ-dq >= 2 then do:
     7949               check-par = false .
     7950                  for each pp_price-list no-lock where pp_price-list.doc-num = l-doc-num   and
     7951                     pp_price-list.artic       =  l-price-list.artic      and
     7952                     pp_price-list.prod-type   =  l-price-list.prod-type  and
     7953                     pp_price-list.prod-code   =  l-price-list.prod-code  and
     7954                     pp_price-list.main-price  =  no  :
     7955                       check-par = true  .
     7956                       leave.
     7957                   end.
     7958               if  check-par = true then NEXT .
     7959               if par-pr-equ-dq = 2 then do:
     7960                 if  ( v-num <= 2  and check-par = false ) then
     7961                 run gbl/d-askw.w
     7962                   (input "Удалить строку?"
     7963                   ,input      "Предыдущая цена РАВНА цене по закрываемому документу " + chr(10)
     7964                               + " Объект "  + l-price-list.obj-type + " " + String(l-price-list.obj-code) + chr(10)
     7965                               + " Артикул " + l-price-list.artic    + " " +  ub.goods.gds-name + chr(10)
     7966                               + " Бар-код " + string(l-price-list.b-code)
     7967                               + " Цена по предыдущему документу № " + l-doc-num + " "
     7968                               + string(l-price-sale) + chr(10)
     7969                               + string(l-price-list.price-sale)
     7970                               + " Удалить строку? "
     7971                   ,input "|^"
     7972                   ,input "Да|Нет|Да для всех^confirm|Нет для всех^confirm"
     7973                   ,input "Удалить строку|"
     7974                       + "Не удалять строку|"
     7975                       + "Удалять у всех товаров, цена на которые не изменилась|"
     7976                       + "Не удалять у всех товаров, цена на которые не изменилась"
     7977                   ,input 1
     7978                   ,input 2
     7979                   ,output v-num
     7980                   ).
     7981                 end.
     7982                 else do:
     7983                   v-num = 3 .
     7984                 end.
     7985                   if v-num = 1 then do:
     7986                     run del-pr-list (input l-price-list.b-code,
     7987                                     input l-price-list.doc-num,
     7988                                     input ?,
     7989                                     input ?) no-error.
     7990                                     if error-status :error then do:
     7991                                             message  vss-workfile vss-revision vss-description skip
     7992                                             "Ошибка при удаление строки переоценки "
     7993                                             l-price-list.b-code skip
     7994                                             error-status :get-message(1) .
     7995                                             return error.
     7996                                     end.
     7997                   end.
     7998                   if v-num = 3  then do:
     7999                      run del-pr-list (input l-price-list.b-code,
     8000                                       input l-price-list.doc-num,
     8001                                       input ?,
     8002                                       input ?)
     8003                                       no-error.
     8004                   end.
     8005             end.
     8006           end.
     8007          end.
     8008   end.
     8009     if par-pr-equ-dq >= 2 then do:
     8010        for each main_price-list no-lock where
     8011                 main_price-list.doc-num         = l-doc-num   and
     8012                 main_price-list.main-price      = true ,
     8013           first ub.goods where ub.goods.artic   = main_price-list.artic and
     8014                           ub.goods.prod-type = main_price-list.prod-type and
     8015                           ub.goods.prod-code = main_price-list.prod-code no-lock   :
     8016                if l-num = 2 then do:
     8017                   find first buf2-bar-code where buf2-bar-code.b-code = l-b-code no-lock no-error .
     8018                   if ub.goods.gds-code <> buf2-bar-code.gds-code then next.
     8019                end.
     8020                   for each pp_price-list no-lock where
     8021                     pp_price-list.doc-num         = main_price-list.doc-num    and
     8022                     pp_price-list.artic           = main_price-list.artic      and
     8023                     pp_price-list.prod-type       = main_price-list.prod-type  and
     8024                     pp_price-list.prod-code       = main_price-list.prod-code  and
     8025                     pp_price-list.main-price      = no and
     8026                     pp_price-list.price-sale      = main_price-list.price-sale  ,
     8027                       first buf1-bar-code no-lock where
     8028                         buf1-bar-code.b-code    = pp_price-list.b-code and
     8029                         buf1-bar-code.unit-cli  = ub.goods.unit-base break by buf1-bar-code.b-code :
     8030                             if first-of( buf1-bar-code.b-code ) then do:
     8031                             bbb = false.
     8032                                      for each alt_price-list where
     8033                                             pp_price-list.doc-num         = alt_price-list.doc-num    and
     8034                                             pp_price-list.artic           = alt_price-list.artic      and
     8035                                             pp_price-list.prod-type       = alt_price-list.prod-type  and
     8036                                             pp_price-list.prod-code       = alt_price-list.prod-code  and
     8037                                             pp_price-list.main-price      = no  no-lock :
     8038                                           if pp_price-list.b-code   =  fnc-base-code (alt_price-list.b-code) and
     8039                                             alt_price-list.b-code = pp_price-list.b-code then next.
     8040                                             if fnc-base-code (alt_price-list.b-code) = pp_price-list.b-code
     8041                                             then do:
     8042                                                   bbb = true .
     8043                                                   leave.
     8044                                              end.
     8045                                      end.
     8046                                       if bbb = false then do:
     8047                                           run del-pr-list ( input pp_price-list.b-code  ,
     8048                                                             input pp_price-list.doc-num ,
     8049                                                             input ? ,
     8050                                                             input ? ) no-error.
     8051                                           if error-status :error then do:
     8052                                             message  vss-workfile vss-revision vss-description skip
     8053                                             " Нельзя удалить " pp_price-list.b-code skip
     8054                                             error-status :get-message(1) .
     8055                                             end.
     8056                                       end.
     8057                             end.
     8058                   end.
     8059        end.
     8060    end.
     8061   end procedure.
     8062   define variable v1-b-code as integer   no-undo .
     8063   define variable new-rec as recid no-undo .
     8064   define variable v-msg as character no-undo .
     8065   define buffer n1_price-list for ub.price-list  .
     8066   do
     8067   on error undo, return error return-value
     8068   :
