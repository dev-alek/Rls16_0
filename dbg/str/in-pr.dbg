     2846   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2847   PROCEDURE write-bonus :
     2848   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2849   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2850   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2851   define input  parameter v-bonus as decimal   no-undo .
     2852     do
     2853     on error undo, return error return-value
     2854     :
     2855       find first ub.contract-specif-attr exclusive-lock  where
     2856                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2857                  ub.contract-specif-attr.host-code    = p-host-code     and
     2858                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2859                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2860                 no-error .
     2861         if not available ub.contract-specif-attr then do:
     2862            create ub.contract-specif-attr .
     2863            assign
     2864                 ub.contract-specif-attr.contract-num = p-contract-num
     2865                 ub.contract-specif-attr.host-code    = p-host-code
     2866                 ub.contract-specif-attr.gds-code     = p-gds-code
     2867                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2868            .
     2869         end.
     2870         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2871   end.
     2872   END PROCEDURE.
     2873   PROCEDURE read-bonus :
     2874   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2875   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2876   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2877   define output parameter v-bonus as decimal   no-undo .
     2878     do
     2879     on error undo, return error return-value
     2880     :
     2881   find first ub.contract-specif-attr no-lock  where
     2882              ub.contract-specif-attr.contract-num = p-contract-num  and
     2883              ub.contract-specif-attr.host-code    = p-host-code     and
     2884              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2885              ub.contract-specif-attr.attr-code    = 'bonus':U
     2886              no-error .
     2887      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2888                                           else  v-bonus = 0 .
     2889   end.
     2890   END PROCEDURE.
     2891   PROCEDURE write-prc-min :
     2892   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
