      508   function cross-list returns logical (
      509     input parfirst-stream  as character,
      510     input parsecond-stream as character,
      511     input pardelim         as character).
      512     if pardelim = ""
      513     or pardelim = ?
      514     then do:
      515       assign
      516         pardelim = ","
      517       .
      518     end.
      519     define variable vari            as integer no-undo .
      520     define variable varresult-cross as logical no-undo .
      521     assign
      522       varresult-cross = no
      523     .
      524     def var v-num-parfirst-stream as integer no-undo .
      525     assign
      526       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      527     .
      528     do vari = 1 to v-num-parfirst-stream
      529     :
      530       if lookup(entry(vari, parfirst-stream, pardelim)
      531                ,parsecond-stream
      532                ,pardelim
      533                ) > 0 then do:
      534         assign
      535           varresult-cross = yes
      536         .
      537         leave.
      538       end.
      539     end.
      540     return varresult-cross .
      541   end function.
