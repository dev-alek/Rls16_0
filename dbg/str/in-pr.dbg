     5288                                  and out-vatp_partsprl.obj-type   = varobj-type
     5289                                  and out-vatp_partsprl.obj-code   = varobj-code
     5290                                  and out-vatp_partsprl.artic      = varartic
     5291                                  and out-vatp_partsprl.prod-type  = varprod-type
     5292                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
     5293       if out-vatp_partsprl.purch-code = 2 then do:
