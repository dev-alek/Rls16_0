     5103     do
     5104     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     5105     :
     5106       find first bf_price-list no-lock
     5107         where recid(bf_price-list) = parrecid
     5108         no-error .
     5109       if not available bf_price-list
     5110       then do:
     5111         return error "Ошибка во входящих параметрах prl-vat.i" .
     5112       end.
     5113       find first bf_goods no-lock
     5114         where bf_goods.artic     = bf_price-list.artic
     5115           and bf_goods.prod-type = bf_price-list.prod-type
     5116           and bf_goods.prod-code = bf_price-list.prod-code
     5117         no-error .
     5118       if not available bf_goods
     5119       then do:
     5120         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     5121       end.
     5122       assign
     5123         varvat-pc = bf_price-list.vat-pc
     5124         varslt-pc = bf_price-list.slt-pc
     5125       .
     5126       if varvat-pc = ?
     5127       then do:
     5128         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     5129       end.
     5130       if varslt-pc = ?
     5131       then do:
     5132         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     5133       end.
     5134       assign
     5135         varbase-rate   = 1
     5136         varbase-scale  = 1
     5137         varroad-tax    = bf_price-list.road-tax
     5138         varexcise      = bf_price-list.excise
