     1521   function hvrdtax return logical (input parrecid as recid):
     1522   define variable varresult as logical no-undo.
     1523   run hvrdtax-proc (input parrecid, output varresult).
     1524   return varresult.
     1525   end function.
     1526   procedure hvrdtax-proc:
     1527   define input  parameter parrecid  as recid   no-undo.
     1528   define output parameter parresult as logical no-undo.
     1529   define buffer bf_goods for ub.goods.
     1530   define buffer bf_units for ub.units.
     1531   define buffer rt_tax   for ub.tax.
     1532   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1533   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1534   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1535   if available rt_tax and
     1536       can-find(first ub.tax-units No-LOCK WHERE
     1537                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1538                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1539                                                       else assign parresult = no.
     1540   end procedure.
     1541   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1542   procedure check-use-bar-code :
     1543     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     1544     do
     1545     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1546     on stop   undo, return error substitute( "&1. stop", vss-include-info10 )
     1547     on endkey undo, return error substitute( "&1. endkey", vss-include-info10 )
     1548     :
     1549       define buffer buf_bar-code for ub.bar-code .
     1550       find first buf_bar-code no-lock
     1551         where buf_bar-code.b-code     = p-b-code
     1552         no-error .
     1553       if not available buf_bar-code then do:
     1554         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info10, p-b-code ) .
     1555       end.
     1556       if buf_bar-code.stts = integer('99':U) then do:
     1557         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     1558                                 + "Выполняется удаление бар-кода"
     1559                                 ,vss-include-info10
     1560                                 ,p-b-code
     1561                                 ,chr(10)
     1562                               ) .
     1563       end.
     1564       if buf_bar-code.stts = integer('79':U) then do:
     1565         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     1566                                 + "Бар-код выключен"
     1567                                 ,vss-include-info10
     1568                                 ,p-b-code
     1569                                 ,chr(10)
     1570                               ) .
     1571       end.
     1572       return .
     1573     end.
     1574   end procedure.
     1575   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576   define new global shared variable g#lib-trn  as handle no-undo .
     1577   define new global shared variable g#lib-trn2 as handle no-undo .
     1578   define new global shared variable g#lib-trn3 as handle no-undo .
     1579   define new global shared variable g#lib-trn4 as handle no-undo .
     1580   procedure main-road-tax :
     1581   define input parameter p-obj-type  like ub.gds-obj.obj-type  no-undo .
