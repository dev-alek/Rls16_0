        1   block-level on error undo, throw.
        2   define input parameter parParentProc  as widget-handle no-undo.
        3   define input parameter p-doc-rec      as recid no-undo .
        4   define input parameter gen-mode       as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aa9f57929aa3, 2828, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: VRukavishnikov $":U .
        7   define variable vss-date        as character no-undo init "$Date: Пн ноя 15 13:32:14 2021 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: in-pr.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: str/in-pr.p $":U .
       10   define variable vss-description as character no-undo init "Генерация переоценки при фактическом закрытии приходной накладной".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2':u,p-doc-rec,gen-mode)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define new global shared variable g#lib-log as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
       77     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
       78     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
       79     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
       80     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
       81     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
       82     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
       83     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
       84     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
       85     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
       86     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
       87     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
       88     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
       89     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
       90     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
       91     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
       92     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
       93     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
       94     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
       95     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
       96     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
       97     define variable v-cntxp-conf-par        as   character                no-undo.
       98     define variable v-cntxp-par-type        as   character                no-undo.
       99     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
      100     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
      101     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
      102     define variable v-cntxp-db-num          as integer   no-undo .
      103     define variable v-cntxp-userid          as character no-undo .
      104     define variable v-cntxp-level           as character no-undo .
      105     define variable v-cntxp-db-num-obj      as integer   no-undo .
      106     define variable v-cntxp-is-admin        as logical   no-undo .
      107     define buffer bf-cntxp_store for ub.store.
      108     define buffer bf-cntxp_shop  for ub.shop.
      109     define buffer bf-cntxp_sysconf for ub.sysconf.
      110   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111     define variable v-cntxt-db-num        as integer   no-undo .
      112     define variable v-cntxt-userid        as character no-undo .
      113     define variable v-cntxt-level         as character no-undo .
      114     define variable v-cntxt-host-code-obj as integer   no-undo .
      115     define variable v-cntxt-obj-type      as character no-undo .
      116     define variable v-cntxt-obj-code      as integer   no-undo .
      117     define variable v-cntxt-db-num-obj    as integer   no-undo .
      118     define variable v-cntxt-is-admin      as logical   no-undo .
      119   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define temp-table tt-level-dis-attr no-undo
      121         field attr-code   like global-state-attr.attr-code
      122         field attr-value  like global-state-attr.attr-value
      123         index pi   attr-value descending
      124         index pi1 is unique attr-value
      125               attr-code .
      126   procedure lvldsc-byattr :
      127   define input  parameter p-attr-code  as character no-undo .
      128   define input  parameter p-attr-value as character no-undo .
      129   define output parameter p-val1       as decimal   no-undo .
      130   define output parameter p-val2       as decimal   no-undo .
      131   define output parameter p-prc        as decimal   no-undo .
      132     do
      133     on error undo, return error return-value
      134     :
      135     define variable v-str1 as character no-undo .
      136     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
      137     v-str1 = trim ( v-str1 , chr(4) ) .
      138    run lvldsc-bytt (
      139         input   v-str1
      140       , input   p-attr-value
      141       , output  p-val1
      142       , output  p-val2
      143       , output  p-prc )
      144         no-error .
      145     end.
      146   end procedure.
      147   procedure lvldsc-bytt :
      148   define input  parameter p-attr-code as character no-undo .
      149   define input  parameter p-attr-value as character no-undo .
      150   define output parameter p-val1 as decimal   no-undo .
      151   define output parameter p-val2 as decimal   no-undo .
      152   define output parameter p-prc  as decimal   no-undo .
      153   define variable v-str1 as character no-undo .
      154     do
      155     on error undo, return error return-value
      156     :
      157     assign
      158        v-str1 = trim ( p-attr-code , "[]()" )
      159        p-val1 = decimal(entry(1,v-str1, ";"))
      160        p-val2 = decimal(entry(2,v-str1, ";"))
      161        p-prc  = decimal(p-attr-value)
      162        no-error
      163     .
      164     end.
      165   end procedure.
      166   procedure level-dis-value :
      167   define input  parameter p-price-prod as decimal   no-undo .
      168   define input  parameter p-b-code     as integer   no-undo .
      169   define input  parameter p-obj-type   as character no-undo .
      170   define input  parameter p-obj-code   as integer   no-undo .
      171   define output parameter p-prc as decimal   no-undo .
      172   define variable v-level-dis-attr as character no-undo .
      173   define variable v-type as character no-undo .
      174   define variable v-val1 as decimal   no-undo .
      175   define variable v-val2 as decimal   no-undo .
      176   define variable v-prc  as decimal   no-undo .
      177   define variable ix     as integer   no-undo .
      178   do
      179    on error undo, return error return-value
      180    :
      181   define buffer buf_goods for ub.goods  .
      182   define buffer buf_bar-code for ub.bar-code  .
      183   find first buf_bar-code no-lock where
      184              buf_bar-code.b-code = p-b-code
      185              no-error .
      186   find first buf_goods no-lock where
      187              buf_goods.gds-code = buf_bar-code.gds-code
      188              no-error .
      189   run ggoattr-value (
      190      input   buf_goods.grp-code
      191     ,input   v-cntxt-host-code-obj
      192     ,input   p-obj-type
      193     ,input   p-obj-code
      194     ,input   'level-dis':U
      195     ,output  v-level-dis-attr
      196     ,output  v-type ) no-error .
      197   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
      198     create
      199       tt-level-dis-attr
      200     .
      201     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
      202     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
      203   end.
      204   p-prc = 0 .
      205     if p-price-prod = 0 then do:
      206         for each tt-level-dis-attr no-lock
      207                 :
      208               run lvldsc-bytt (
      209                 input   tt-level-dis-attr.attr-code
      210               , input   tt-level-dis-attr.attr-value
      211               , output  v-val1
      212               , output  v-val2
      213               , output  v-prc  )
      214               .
      215               if v-val1  = 0  then do:
      216                  p-prc = v-prc .
      217                 leave.
      218               end.
      219         end.
      220     end.
      221     else do:
      222         for each tt-level-dis-attr no-lock
      223                 :
      224               run lvldsc-bytt (
      225                 input   tt-level-dis-attr.attr-code
      226               , input   tt-level-dis-attr.attr-value
      227               , output  v-val1
      228               , output  v-val2
      229               , output  v-prc  )
      230               .
      231               if p-price-prod   > v-val1 and
      232                  p-price-prod  <= v-val2 then do:
      233                  p-prc = v-prc .
      234                 leave.
      235               end.
      236         end.
      237     end.
      238   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
      239    end.
      240   end procedure.
      241   procedure calc-price-levelprod :
      242   define input  parameter p-mode     as integer   no-undo .
      243   define input  parameter p-rb       as character no-undo .
      244   define input  parameter p-b-code   as integer   no-undo .
      245   define input  parameter p-obj-type as character no-undo .
      246   define input  parameter p-obj-code as integer   no-undo .
      247   define output parameter p-price-sale as decimal   no-undo .
      248   define output parameter p-descript-calc as character no-undo .
      249   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
      250   define variable  v-PriceWithVat    as decimal   no-undo init 0.
      251   define variable  v-prod-vat        as decimal   no-undo init 0.
      252   define variable  v-discnt          as decimal   no-undo init 0.
      253   define buffer buf_goods for ub.goods  .
      254   define buffer buf_bar-code for ub.bar-code  .
      255   define buffer buf_parts for ub.parts  .
      256   define variable v-part-code as character no-undo .
      257   define variable v-in-code   as character no-undo .
      258     do
      259     on error undo, return error return-value
      260     :
      261   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
      263   (  input  p-b-code
      264    , input  p-obj-type
      265    , input  p-obj-code
      266    , output v-PriceWithoutVat
      267    , output v-PriceWithVat
      268    , output v-prod-vat
      269    , output v-part-code
      270    , output v-in-code
      271           ) no-error .
      272         if error-status :error then do:
      273           return error "Нет цены производителя!".
      274         end.
      275   find first buf_bar-code no-lock where
      276              buf_bar-code.b-code = p-b-code
      277              no-error .
      278   find first buf_goods no-lock where
      279              buf_goods.gds-code = buf_bar-code.gds-code
      280              no-error .
      281   find first buf_parts no-lock where
      282              buf_parts.artic      = buf_goods.artic        and
      283              buf_parts.prod-type  = buf_goods.prod-type    and
      284              buf_parts.prod-code  = buf_goods.prod-code    and
      285              buf_parts.in-code    = buf_bar-code.in-code   and
      286              buf_parts.out-code   = buf_bar-code.in-code   and
      287              buf_parts.part-code  = buf_bar-code.part-code
      288              no-error .
      289               if error-status :error then do:
      290                   find first buf_parts no-lock where
      291                             buf_parts.artic      = buf_goods.artic        and
      292                             buf_parts.prod-type  = buf_goods.prod-type    and
      293                             buf_parts.prod-code  = buf_goods.prod-code    and
      294                             buf_parts.in-code    = v-in-code              and
      295                             buf_parts.out-code   = v-in-code              and
      296                             buf_parts.part-code  = v-part-code
      297                             no-error .
      298                   if error-status :error then do:
      299                      message
      300                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
      301                                   v-in-code,
      302                                   v-part-code ,
      303                                   buf_goods.artic   ,
      304                                   buf_goods.prod-type,
      305                                   buf_goods.prod-code ) .
      306                      return error "Нет цены производителя !!!".
      307                   end.
      308               end.
      309   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
      310   define variable v-postWithoutVat-rubl as decimal   no-undo .
      311   define variable v-postWithoutVat-base as decimal   no-undo .
      312      case p-mode :
      313       when 1 then do:
      314          if p-rb = "rubl" then do:
      315             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
      316          end.
      317          else do:
      318             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
      319          end.
      320       end.
      321       when 2 then do:
      322         if p-rb = "rubl" then do:
      323           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
      324           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
      325         end.
      326         else do:
      327           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
      328           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
      329         end.
      330       end.
      331      end case.
      332   p-descript-calc =
      333     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
      334     buf_goods.gds-name                  +  chr(10) +
      335     buf_goods.artic +
      336     buf_goods.prod-type +
      337     string(buf_goods.prod-code)         + chr(10) +
      338     "бар-код " +  string(p-b-code)      + chr(10)  +
      339     'ПН    ' + v-in-code  +
      340     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
      341     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
      342     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
      343     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
      344     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
      345     chr(10) +
      346     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
      347     chr(10) +
      348     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
      349     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
      350     chr(10) +
      351     string(p-price-sale)                                                               +  chr(10) +
      352     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
      353     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
      354   .
      355     end.
      356   end procedure.
      357   define   shared variable g#auto as logical no-undo.
      358   define   shared variable g#news as logical no-undo.
      359   define   shared variable g#oxml as logical no-undo.
      360   define   shared variable g#esys as logical no-undo.
      361   define   shared variable g#news-source-db as integer no-undo.
      362   define   shared variable g#esys-source-esys as integer no-undo.
      363   define   shared variable g#db-num as integer   no-undo .
      364   define   shared variable g#userid as character no-undo .
      365   define   shared variable g#passwd as character no-undo .
      366   define variable line-mode    as character no-undo .
      367   define variable line-rec     as recid     no-undo .
      368   define variable var-pr-r-b   as character no-undo .
      369   define variable v-log-handle as handle    no-undo .
      370   define variable v-str        as character no-undo .
      371   if (valid-handle(g#lib-log) <> true) then do:   run gbl/lib-log.p persistent no-error .   if error-status :error or (valid-handle(g#lib-log) <> true) then do:     message       "Error starting gbl/lib-log.p" skip       g#lib-log skip       g#lib-log :type skip       g#lib-log :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-log_get-log-handle in g#lib-log
      372     (output  v-log-handle
      373     )  .
      374   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      376     (output var-pr-r-b
      377     )  .
      378       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      379       define buffer   in-vatp-parts    for ub.parts   .
      380       define buffer   in-vatp-doc      for ub.trn-doc .
      381       define buffer   in-vatp-goods    for ub.goods   .
      382       define buffer   in-vatp-sysconf  for ub.sysconf .
      383       define buffer   in-vatp_doc-attr for ub.doc-attr.
      384       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      385       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      386       define variable varinvprb                  as   character              no-undo.
      387       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      388       define variable cli-base-rate              as   decimal                no-undo.
      389       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      390       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      391       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      392       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      393       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      394       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      395       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      396       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      397       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
