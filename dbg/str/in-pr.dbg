     8111             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     8112             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     8113             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     8114             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     8115             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     8116             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     8117             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     8118             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     8119             v-cntxp-load-time       = bf-cntxp_store.load-time
     8120             v-cntxp-holidays        = bf-cntxp_store.holidays
     8121             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     8122             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     8123             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     8124             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     8125             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     8126             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     8127             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     8128             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     8129             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     8130             .
     8131         end.
     8132         when 'маг':U then do:
     8133           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     8134           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     8135           assign
     8136             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     8137             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     8138             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     8139             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     8140             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     8141             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
