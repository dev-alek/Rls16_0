     2895   define input  parameter v-prc-min        as decimal   no-undo .
     2896     do
     2897     on error undo, return error return-value
     2898     :
     2899       find first ub.contract-specif-attr exclusive-lock  where
     2900                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2901                 ub.contract-specif-attr.host-code    = p-host-code     and
     2902                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2903                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2904                 no-error .
     2905         if not available ub.contract-specif-attr then do:
     2906            create ub.contract-specif-attr .
     2907            assign
     2908                 ub.contract-specif-attr.contract-num = p-contract-num
     2909                 ub.contract-specif-attr.host-code    = p-host-code
     2910                 ub.contract-specif-attr.gds-code     = p-gds-code
     2911                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2912                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2913            .
     2914         end.
     2915         else do:
     2916            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2917         end.
     2918       find first ub.contract-specif exclusive-lock where
     2919           ub.contract-specif.contract-num = p-contract-num and
     2920           ub.contract-specif.host-code    = p-host-code    and
     2921           ub.contract-specif.gds-code     = p-gds-code.
     2922           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2923   end.
