      825   procedure grp-obj-write :
      826   do
      827   on error undo, return error
      828   :
      829   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      830   define input parameter p-host-code  as integer                          no-undo.
      831   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      832   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      833   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      834   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      835   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      836   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      837   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      838   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      839   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      840   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      841   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      842       find first buf_gds-grp-obj exclusive-lock
      843            where buf_gds-grp-obj.node-code  = p-node-code
      844              and buf_gds-grp-obj.host-code  = p-host-code
      845              and buf_gds-grp-obj.obj-type   = p-obj-type
      846              and buf_gds-grp-obj.obj-code   = p-obj-code
      847       no-error.
      848       if not available buf_gds-grp-obj
      849       then do:
      850           create buf_gds-grp-obj.
      851           assign
      852                   buf_gds-grp-obj.node-code  = p-node-code
      853                   buf_gds-grp-obj.host-code  = p-host-code
      854                   buf_gds-grp-obj.obj-type   = p-obj-type
      855                   buf_gds-grp-obj.obj-code   = p-obj-code
      856           .
      857       end.
      858       assign
      859       buf_gds-grp-obj.min-increase = p-min-increase
      860       buf_gds-grp-obj.max-increase = p-max-increase
      861       buf_gds-grp-obj.increase-pc = p-increase-pc
      862       buf_gds-grp-obj.calc-method = p-calc-method
      863       buf_gds-grp-obj.round-method = p-round-method
      864       buf_gds-grp-obj.round-coef = p-round-coef
      865       buf_gds-grp-obj.cli-type   = p-cli-type
      866       buf_gds-grp-obj.cli-code   = p-cli-code
      867       .
      868   end.
      869   end procedure.
      870   procedure grp-obj-margin-value :
      871   do
      872   on error undo, return error
      873   :
      874   define input parameter p-node-code as integer      no-undo.
      875   define input parameter p-obj-type  as character    no-undo.
      876   define input parameter p-obj-code  as integer      no-undo.
      877   define output parameter p-min-value as decimal      no-undo init ?.
      878   define output parameter p-max-value as decimal      no-undo init ?.
      879   define output parameter p-increase-pc as decimal      no-undo init ?.
      880   define output parameter p-round-method as character no-undo init "":U.
      881   define output parameter p-base as decimal no-undo init ?.
      882   define output parameter p-range-margin     as integer      no-undo.
      883   define output parameter p-exists-margin    as logical      no-undo.
      884   define output parameter p-range-increase     as integer      no-undo.
      885   define output parameter p-exists-increase    as logical      no-undo.
      886   define output parameter p-range-rmethod     as integer no-undo .
      887   define output parameter p-exists-rmethod    as logical no-undo .
      888   define variable v-host-code as integer      no-undo.
      889   DEFINE VARIABLE v-found as logical no-undo .
      890   DEFINE VARIABLE v-exists as logical no-undo .
      891   DEFINE VARIABLE v-range as integer no-undo .
      892   DEFINE VARIABLE jj as integer no-undo .
      893   DEFINE VARIABLE v-margin-found as logical no-undo .
      894   DEFINE VARIABLE v-increase-found as logical no-undo .
      895   DEFINE VARIABLE v-min-value as decimal      no-undo.
      896   DEFINE VARIABLE v-max-value as decimal      no-undo.
      897   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      898   define variable v-round-method as character no-undo .
      899   define variable v-base as decimal no-undo .
      900   define variable v-print-code as character no-undo .
      901   define buffer buf_gds-grp for ub.gds-grp.
      902   find first buf_gds-grp no-lock where
      903              buf_gds-grp.node-code = p-node-code no-error .
      904   if not avail buf_gds-grp and p-node-code <> 0 then do:
      905     message
      906       vss-workfile vss-revision vss-description
      907       skip "Не удалось найти группу товаров с кодом" p-node-code
      908       view-as alert-box error .
      909     undo, return error .
      910   end.
      911   if p-obj-type <> '' then do:
      912   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      914     (input  p-obj-type
      915     ,input  p-obj-code
      916     ,output v-host-code
      917     ) no-error .
      918     if error-status :error
      919     then do:
      920         message
      921           vss-workfile vss-revision vss-description
      922           skip "Не удалось найти фирму объекта"
      923           skip p-obj-type p-obj-code
      924           skip return-value
      925           skip trim(error-status :get-message(1))
      926               trim(error-status :get-message(2))
      927               trim(error-status :get-message(3))
      928               trim(error-status :get-message(4))
      929               trim(error-status :get-message(5))
      930         view-as alert-box error.
      931         undo, return error .
      932     end.
      933   end.
      934   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      935   do while v-found = no and jj < 2:
      936     if v-range <> 3 then do:
      937       find first buf_gds-grp-obj no-lock
      938           where buf_gds-grp-obj.node-code = p-node-code
      939             and buf_gds-grp-obj.host-code = v-host-code
      940             and buf_gds-grp-obj.obj-type  = p-obj-type
      941             and buf_gds-grp-obj.obj-code  = p-obj-code
      942       no-error .
      943     end.
      944     if v-range = 3 or not available buf_gds-grp-obj
      945     then do:
      946        if v-range <> 2 then do:
      947           find first buf_gds-grp-obj no-lock
      948               where buf_gds-grp-obj.node-code = p-node-code
      949                 and buf_gds-grp-obj.host-code = v-host-code
      950                 and buf_gds-grp-obj.obj-type  = ""
      951                 and buf_gds-grp-obj.obj-code  = 0
      952           no-error .
      953         end.
      954         if v-range = 2 or not available buf_gds-grp-obj
      955         then do:
      956             if v-range <> 1 then do:
      957               find first buf_gds-grp-obj no-lock
      958                   where buf_gds-grp-obj.node-code = p-node-code
      959                   and buf_gds-grp-obj.host-code = 0
      960                   and buf_gds-grp-obj.obj-type  = ""
      961                   and buf_gds-grp-obj.obj-code  = 0
      962               no-error .
      963             end.
      964             if v-range = 1 or not available buf_gds-grp-obj
      965             then do:
      966                 assign
      967                     v-exists = no
      968                 .
      969             end.
      970             else do:
      971                 assign
      972                     v-exists = yes
      973                     v-range = 1
      974                 .
      975             end.
      976         end.
      977         else do:
      978             assign
      979                 v-exists = yes
      980                 v-range  = 2
      981             .
      982         end.
      983     end.
      984     else do:
      985         assign
      986             v-exists = yes
      987             v-range  = 3
      988         .
      989     end.
      990     if available buf_gds-grp-obj
      991     then do:
      992       assign
      993       v-min-value    = buf_gds-grp-obj.min-increase
      994       v-max-value    = buf_gds-grp-obj.max-increase
      995       v-increase-pc  = buf_gds-grp-obj.increase-pc
      996       v-round-method = buf_gds-grp-obj.round-method
      997       v-base         = buf_gds-grp-obj.round-coef
      998       .
      999       assign
     1000       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
     1001                           then yes
     1002                           else p-exists-margin)
     1003       p-range-margin = if p-exists-margin and p-min-value = ?
     1004                         then v-range
     1005                         else p-range-margin
     1006       p-min-value   =  if p-exists-margin and  p-min-value = ?
     1007                         then v-min-value
     1008                         else p-min-value
     1009       p-max-value   =  if p-exists-margin and  p-max-value = ?
     1010                         then v-max-value
     1011                         else p-max-value
     1012       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
     1013                           then yes
     1014                           else p-exists-increase)
     1015       p-range-increase = if p-exists-increase and p-increase-pc = ?
     1016                         then v-range
     1017                         else p-range-increase
     1018       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
     1019                         then v-increase-pc
     1020                         else p-increase-pc)
     1021       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
     1022                           then yes
     1023                           else p-exists-rmethod
     1024       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
     1025                           then v-range
     1026                           else p-range-rmethod)
     1027       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
     1028                           then v-round-method
     1029                           else p-round-method)
     1030       p-base          = (if p-exists-rmethod and p-base = ?
     1031                           then v-base
     1032                           else p-base)
     1033       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
     1034       jj = jj + 1
     1035       .
     1036     end.
     1037     else do:
     1038       assign
     1039       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
     1040       jj = jj + 1
     1041       .
     1042     end.
     1043   end.
     1044   end.
     1045   end procedure.
