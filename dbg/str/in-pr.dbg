     8650           assign
     8651             n1_price-list.price-sale = truncate (n1_price-list.price-sale, 0) + 1
     8652           .
     8653         end.
     8654       end.
     8655       else do:
     8656         if (n1_price-list.price-sale modulo 10) < 3 then do:
     8657           assign
     8658             n1_price-list.price-sale = (n1_price-list.price-sale - (n1_price-list.price-sale modulo 100))
     8659                 + ( truncate (((n1_price-list.price-sale modulo 100) / 10), 0)
     8660                   - 1 ) * 10
     8661                 + 9
     8662           .
     8663         end.
     8664         else do:
     8665           assign
     8666             n1_price-list.price-sale = (n1_price-list.price-sale - (n1_price-list.price-sale modulo 100))
     8667                 + ( truncate (((n1_price-list.price-sale modulo 100) / 10), 0)
     8668                   ) * 10
     8669                 + 9
     8670           .
     8671         end.
     8672         assign
     8673           n1_price-list.price-sale = round (n1_price-list.price-sale, 0)
     8674         .
     8675       end.
     8676     end.
     8677     when '9-99окончание':U then do:
     8678       if n1_price-list.price-sale < loc-grp-round-base then do:
     8679         assign
     8680           n1_price-list.price-sale = truncate (n1_price-list.price-sale, 0) + 0.99
     8681         .
     8682       end.
     8683       else do:
     8684         assign
     8685           n1_price-list.price-sale = truncate (n1_price-list.price-sale / 10 , 0) * 10 + 9.99
     8686         .
     8687       end.
     8688     end.
     8689     when 'Без-дробных':U then do:
     8690       assign
     8691         n1_price-list.price-sale = round (n1_price-list.price-sale, 0)
     8692       .
     8693     end.
     8694     when 'Произвольно':U then do:
     8695       if loc-grp-round-base <> 0 then do:
     8696         assign
