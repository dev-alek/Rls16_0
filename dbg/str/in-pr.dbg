     5147       for each bf_parts no-lock
     5148         where bf_parts.out-code   = bf_price-list.doc-num
     5149           and bf_parts.obj-type   = bf_price-list.obj-type
     5150           and bf_parts.obj-code   = bf_price-list.obj-code
     5151           and bf_parts.artic      = bf_price-list.artic
     5152           and bf_parts.prod-type  = bf_price-list.prod-type
     5153           and bf_parts.prod-code  = bf_price-list.prod-code
     5154       :
     5155         assign
     5156           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     5157         .
     5158       end.
     5159       assign
     5160         vardoc-num   = bf_price-list.doc-num
     5161         vardoc-code  = bf_price-list.doc-num
     5162         varobj-type  = bf_price-list.obj-type
     5163         varobj-code  = bf_price-list.obj-code
     5164         varartic     = bf_price-list.artic
     5165         varprod-type = bf_price-list.prod-type
     5166         varprod-code = bf_price-list.prod-code
     5167         vardoc-qnty  = varfact-qnty
     5168         varext-doc-type = 'ot':U
     5169       .
