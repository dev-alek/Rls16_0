     3980   procedure grp-obj-notcorr-value :
     3981   do
     3982   on error undo, return error
     3983   :
     3984   define input parameter p-node-code             as integer      no-undo.
     3985   define input parameter p-obj-type              as character    no-undo.
     3986   define input parameter p-obj-code              as integer      no-undo.
     3987   define output parameter p-notcorr              as character    no-undo init ?.
     3988   define output parameter p-range-notcorr     as integer      no-undo.
     3989   define output parameter p-exists-notcorr    as logical      no-undo.
     3990   define variable v-host-code as integer      no-undo.
     3991   DEFINE VARIABLE v-found as logical no-undo .
     3992   DEFINE VARIABLE v-exists as logical no-undo .
     3993   DEFINE VARIABLE v-range as integer no-undo .
     3994   DEFINE VARIABLE jj as integer no-undo .
     3995   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     3996   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     3997   define buffer buf_gds-grp for ub.gds-grp.
     3998   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     3999   find first buf_gds-grp no-lock where
     4000              buf_gds-grp.node-code = p-node-code no-error .
     4001   if not avail buf_gds-grp and p-node-code <> 0 then do:
     4002     message
     4003       vss-workfile vss-revision vss-description
     4004       skip "Не удалось найти группу товаров с кодом" p-node-code
     4005       view-as alert-box error .
     4006     undo, return error .
     4007   end.
     4008   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4009   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4010     (input  p-obj-type
     4011     ,input  p-obj-code
     4012     ,output v-host-code
     4013     ) no-error .
     4014   if error-status :error
     4015   then do:
     4016       message
     4017         vss-workfile vss-revision vss-description
     4018         skip "Не удалось найти фирму объекта"
     4019         skip p-obj-type p-obj-code
     4020         skip return-value
     4021         skip trim(error-status :get-message(1))
     4022       view-as alert-box error.
     4023       undo, return error .
     4024   end.
     4025   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     4026   do while v-found = no and jj < 2:
     4027     if v-range <> 3 then do:
     4028       find first buf_gds-grp-obj no-lock
     4029           where buf_gds-grp-obj.node-code = p-node-code
     4030             and buf_gds-grp-obj.host-code = v-host-code
     4031             and buf_gds-grp-obj.obj-type  = p-obj-type
     4032             and buf_gds-grp-obj.obj-code  = p-obj-code
     4033       no-error .
     4034     end.
     4035     if v-range = 3 or not available buf_gds-grp-obj
     4036     then do:
     4037        if v-range <> 2 then do:
     4038           find first buf_gds-grp-obj no-lock
     4039               where buf_gds-grp-obj.node-code = p-node-code
     4040                 and buf_gds-grp-obj.host-code = v-host-code
     4041                 and buf_gds-grp-obj.obj-type  = ""
     4042                 and buf_gds-grp-obj.obj-code  = 0
     4043           no-error .
     4044         end.
     4045         if v-range = 2 or not available buf_gds-grp-obj
     4046         then do:
     4047             if v-range <> 1 then do:
     4048               find first buf_gds-grp-obj no-lock
     4049                   where buf_gds-grp-obj.node-code = p-node-code
     4050                   and buf_gds-grp-obj.host-code = 0
     4051                   and buf_gds-grp-obj.obj-type  = ""
     4052                   and buf_gds-grp-obj.obj-code  = 0
     4053               no-error .
     4054             end.
     4055             if v-range = 1 or not available buf_gds-grp-obj
     4056             then do:
     4057                 assign
     4058                     v-exists = no
     4059                 .
     4060             end.
     4061             else do:
     4062                 assign
     4063                     v-exists = yes
     4064                     v-range = 1
     4065                 .
     4066             end.
     4067         end.
     4068         else do:
     4069             assign
     4070                 v-exists = yes
     4071                 v-range  = 2
     4072             .
     4073         end.
     4074     end.
     4075     else do:
     4076         assign
     4077             v-exists = yes
     4078             v-range  = 3
     4079         .
     4080     end.
     4081     if available buf_gds-grp-obj
     4082     then do:
     4083       find first buf_gds-grp-obj-attr no-lock
     4084         where buf_gds-grp-obj-attr.node-code   = p-node-code
     4085           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     4086           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     4087           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     4088           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     4089         no-error .
     4090       if available buf_gds-grp-obj-attr then do:
     4091         assign
     4092           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     4093         .
     4094       end.
     4095       else do:
     4096         assign
     4097           v-notcorr-value = ?
     4098         .
     4099       end.
     4100       assign
     4101       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     4102                           then yes
     4103                           else p-exists-notcorr)
     4104       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     4105                         then v-range
     4106                         else p-range-notcorr
     4107       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     4108                         then v-notcorr-value
     4109                         else p-notcorr
     4110       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     4111       jj = jj + 1
     4112       .
     4113     end.
     4114     else do:
     4115       assign
     4116       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     4117       jj = jj + 1
     4118       .
     4119     end.
     4120   end.
     4121   end.
     4122   end procedure.
     4123   define variable vss-include-info42 as character format "X(65)" no-undo
     4124   initial "@(#)$Workfile$ $Revision$".
     4125   procedure grplib-get-full-name :
     4126      define input parameter p-node-code  as integer      no-undo.
     4127      define output parameter p-full-name as character    no-undo.
     4128      do
     4129   on error undo, return error
     4130   :
     4131       define variable v-upper-code    as integer           no-undo.
     4132       define buffer buf_gds-grp       for ub.gds-grp.
     4133       define buffer buf_upper_gds-grp for ub.gds-grp.
     4134       find first buf_gds-grp no-lock
     4135            where buf_gds-grp.node-code = p-node-code
     4136       no-error.
     4137       if not available buf_gds-grp
     4138       then do:
     4139           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4140       end.
     4141       assign
     4142           p-full-name  = ""
     4143           v-upper-code = 1
     4144       .
     4145       do while buf_gds-grp.upper-code <> 0
     4146       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     4147       :
     4148           assign
     4149               p-full-name  = buf_gds-grp.node-name
     4150                            + (if p-full-name <> "" then chr(47) else "")
     4151                            + p-full-name
     4152               v-upper-code = buf_gds-grp.upper-code
     4153           .
     4154           find first buf_gds-grp no-lock
     4155                where buf_gds-grp.node-code = v-upper-code
     4156           no-error.
     4157           if not available buf_gds-grp
     4158           then do:
     4159               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     4160                                   + string( v-upper-code )
     4161                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4162           end.
     4163       end.
     4164       assign
     4165       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     4166       .
     4167   end.
     4168   end .
     4169   procedure grplib-get-node-from-full-name :
     4170   define input parameter p-full-name as character no-undo .
     4171   define output parameter p-node-code as integer no-undo .
     4172   define variable v-ii as integer no-undo .
     4173   define variable v-upper-code as integer no-undo .
     4174   define variable v-root-code as integer no-undo .
     4175   define variable v-entry as character no-undo .
     4176   define buffer buf_gds-grp       for ub.gds-grp.
     4177   do
     4178   on error undo, return error
     4179   :
     4180     find first buf_gds-grp no-lock
     4181         where buf_gds-grp.upper-code = 0
     4182     no-error .
     4183     if not available buf_gds-grp
     4184     then do:
     4185         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     4186     end.
     4187     else do:
     4188       assign
     4189       v-root-code = buf_gds-grp.node-code
     4190       .
     4191     end.
     4192     v-upper-code = v-root-code.
     4193     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     4194       assign
     4195       v-entry = entry(v-ii, p-full-name, chr(47)).
     4196       if v-entry = '' then leave.
     4197       find first buf_gds-grp no-lock where
     4198                 buf_gds-grp.node-name = v-entry
     4199             and buf_gds-grp.upper-code = v-upper-code
     4200             no-error.
     4201       if not available buf_gds-grp then do:
     4202         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     4203       end.
     4204       else do:
     4205         p-node-code = buf_gds-grp.node-code.
     4206         v-upper-code = buf_gds-grp.node-code.
     4207       end.
     4208     end.
     4209   end.
     4210   end .
     4211   procedure  chec-par :
     4212   define output parameter l-par as logical no-undo .
     4213   define input parameter l-host like ub.clients.obj-code no-undo .
     4214   define input parameter l-type like ub.clients.obj-type no-undo .
