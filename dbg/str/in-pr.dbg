     2993              ub.contract-specif-attr.attr-code    = "retro-bonus"
     2994              no-error .
     2995      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     2996                                           else  v-retro-bonus = "" .
     2997   end.
     2998   END PROCEDURE.
     2999   define buffer buf1_parts for ub.parts  .
     3000   FUNCTION fnc-base-code RETURN integer (local-bc as integer).
     3001   define variable local-base-code like ub.bar-code.b-code no-undo.
     3002   run prc-base-code (input local-bc, output local-base-code).
     3003   return (local-base-code).
     3004   END FUNCTION.
     3005   define variable g#log as logical   no-undo .
     3006   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3007   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     3008                                           local-doc-num as char).
     3009   define buffer base-price        for ub.price-list.
     3010   define variable local-main-code like ub.bar-code.b-code no-undo.
     3011   define variable local-base-code like ub.bar-code.b-code no-undo.
     3012     run prc-base-code (input local-bc, output local-base-code).
     3013     find base-price no-lock where
     3014          base-price.doc-num = local-doc-num and
     3015          base-price.b-code  = local-base-code and
     3016          base-price.price-type = "" no-error.
     3017     if not available base-price then do:
     3018       run prc-main-code (input local-bc, output local-main-code).
     3019       find  base-price no-lock where
     3020             base-price.doc-num = local-doc-num and
     3021             base-price.b-code  = local-main-code and
     3022             base-price.price-type = "" no-error.
     3023     end.
     3024     if available base-price then
     3025       return (base-price.price-sale).
     3026     else
     3027       return (?).
     3028   END FUNCTION.
     3029   procedure prc-main-code:
     3030   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     3031   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     3032   define buffer local-bar-code        for ub.bar-code.
     3033   define buffer local-goods           for ub.goods.
     3034   define buffer main-code             for ub.bar-code.
     3035   define buffer main-prt              for ub.gds-prt.
     3036     local-main-code = ?.
     3037     find local-bar-code no-lock where
     3038          local-bar-code.b-code = local-bc no-error.
     3039     if not available local-bar-code then
     3040       return.
     3041     find local-goods no-lock where
     3042          local-goods.gds-code = local-bar-code.gds-code.
     3043     find first  main-prt no-lock where
     3044                 main-prt.upper-code = local-goods.prt-root.
     3045     find  main-code no-lock where
     3046           main-code.gds-code  = local-bar-code.gds-code and
     3047           main-code.in-code   = "" and
     3048           main-code.part-code = "" and
     3049           main-code.unit-cli  = local-goods.unit-base and
     3050           main-code.node-code = main-prt.node-code.
     3051     local-main-code = main-code.b-code.
     3052   end procedure.
     3053   procedure prc-base-code:
     3054   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     3055   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     3056   define buffer local-bar-code for ub.bar-code.
     3057   define buffer local-goods    for ub.goods.
     3058   define buffer base-code      for ub.bar-code.
     3059     local-base-code = ?.
     3060     find local-bar-code no-lock where
     3061          local-bar-code.b-code = local-bc no-error.
     3062     if not available local-bar-code then
     3063       return.
     3064     find local-goods no-lock where
     3065          local-goods.gds-code = local-bar-code.gds-code.
     3066     find base-code no-lock where
     3067          base-code.gds-code  = local-bar-code.gds-code and
     3068          base-code.node-code = local-bar-code.node-code and
     3069          base-code.in-code   = local-bar-code.in-code and
     3070          base-code.part-code = local-bar-code.part-code and
     3071          base-code.unit-cli  = local-goods.unit-base.
     3072     local-base-code = base-code.b-code.
     3073   end procedure.
     3074   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3075   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3076   procedure prcreate-new-price-doc :
     3077   do
     3078   on error undo, return error return-value
     3079   :
     3080   define input  parameter p-curr-db-num  as integer   no-undo .
     3081   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
     3082   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
     3083   define input  parameter p-plt-id       as integer   no-undo .
     3084   define input  parameter p-plt-db-num   as integer   no-undo .
     3085   define input  parameter p-pdf-id       as integer   no-undo .
     3086   define input  parameter p-pdf-db-num   as integer   no-undo .
     3087   define output parameter p-price-doc-recid  as recid                no-undo.
     3088   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     3089   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     3090   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     3091   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     3092   define buffer buf_price-doc-forming for ub.price-doc-forming.
     3093   define buffer buf_price-doc         for ub.price-doc.
     3094   find first buf_price-doc-forming no-lock where
     3095              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     3096              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     3097              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     3098              buf_price-doc-forming.plt-id     = p-plt-id
     3099              no-error .
     3100   if not available buf_price-doc-forming and p-plt-id = ? then do:
     3101      run create_new_price-doc-forming
     3102           ( input p-obj-type ,
     3103             input p-obj-code ,
     3104             output p-pdf-db-num ,
     3105             output p-pdf-id ,
     3106             output p-plt-db-num ,
     3107             output p-plt-id
     3108             ).
     3109       find first buf_price-doc-forming no-lock where
     3110                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     3111                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     3112                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     3113                 buf_price-doc-forming.plt-id     = p-plt-id
     3114                 no-error .
     3115   end.
     3116       create buf_price-doc .
     3117       run doc-code in this-procedure
     3118       (input  "main",
     3119        input  p-obj-type  ,
     3120        input  p-obj-code  ,
     3121        input  ?,
     3122        output buf_price-doc.doc-num) no-error.
     3123       if error-status:error then do:
     3124         message vss-workfile vss-revision vss-description skip
     3125                error-status :get-message(1)
     3126               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     3127         return error.
     3128       end.
     3129   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3131     (input  p-obj-type
     3132     ,input  p-obj-code
     3133     ,output v-host-code
     3134     )  .
     3135       v-obj-current-date  = today .
     3136       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     3137           v-base-rate   =  buf_price-doc-forming.base-rate  .
     3138           v-base-scale  =  buf_price-doc-forming.base-scale .
     3139       end.
     3140       else do:
     3141   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     3143     (input  v-host-code
     3144     ,input  v-obj-current-date
     3145     ,output v-base-rate
     3146     ,output v-base-scale
     3147     )  .
     3148       end.
     3149      assign
     3150       buf_price-doc.base-rate      = v-base-rate
     3151       buf_price-doc.base-scale     = v-base-scale
     3152       buf_price-doc.cr-db-num      = p-curr-db-num
     3153       buf_price-doc.doc-date       = v-obj-current-date
     3154       buf_price-doc.fact-num       = 0
     3155       buf_price-doc.host-code      = v-host-code
     3156       buf_price-doc.is-corr        = false
     3157       buf_price-doc.is-del         = false
     3158       buf_price-doc.obj-code       = p-obj-code
     3159       buf_price-doc.obj-type       = p-obj-type
     3160       buf_price-doc.out-code       = ""
     3161       buf_price-doc.pdf-db         = p-pdf-db-num
     3162       buf_price-doc.pdf-id         = p-pdf-id
     3163       buf_price-doc.plt-db-num     = p-plt-db-num
     3164       buf_price-doc.plt-id         = p-plt-id
     3165       buf_price-doc.PS             = "@ "
     3166       buf_price-doc.rest-base      = 0
     3167       buf_price-doc.rest-last      = 0
     3168       buf_price-doc.rest-qnty      = 0
     3169       buf_price-doc.rest-sale      = 0
     3170       buf_price-doc.sale-base      = 0
     3171       buf_price-doc.status_        = 'новый':U
     3172       .
     3173       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
     3174       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     3175       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     3176       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
     3177       assign
     3178           p-price-doc-recid = recid ( buf_price-doc )
     3179       .
     3180   end.
     3181   end procedure.
     3182   procedure prcreate-new-price-list :
     3183   do
     3184   on error undo, return error return-value
     3185   :
     3186   define input parameter p-price-doc-recid   as recid                    no-undo.
     3187   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     3188   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     3189   define output parameter p-update           as logical                  no-undo.
     3190   define variable kk as integer no-undo .
     3191   define var v-b-code    like ub.bar-code.b-code     no-undo.
     3192   define variable p-hostcode as int no-undo .
     3193   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     3194   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     3195   define buffer buf_price-doc        for ub.price-doc.
     3196   define buffer buf_price-list       for ub.price-list.
     3197   define buffer buf_bar-code         for ub.bar-code.
     3198   define buffer buf_goods            for ub.goods.
     3199   define buffer buf_root_gds-prt     for ub.gds-prt.
     3200   define buffer buf_gds-prt          for ub.gds-prt.
     3201   find first buf_price-doc no-lock
     3202        where recid( buf_price-doc ) = p-price-doc-recid
     3203   .
     3204   find first buf_goods no-lock
     3205        where buf_goods.gds-code = p-gds-code
     3206   .
     3207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3208     (input  p-gds-code
     3209     ,input  ?
     3210     ,output v-b-code
     3211     ) no-error .
     3212   if error-status :error
     3213   then do:
     3214       message
     3215           "Не найден основной бар-код"
     3216           skip "для товара "
     3217           skip string(buf_goods.artic)
     3218           skip buf_goods.gds-name
     3219       view-as alert-box
     3220       title "Ошибка при выполнении prcreate.i".
     3221       undo, return error .
     3222   end.
     3223   find first buf_bar-code no-lock
     3224        where buf_bar-code.b-code = v-b-code
     3225   no-error.
     3226   if error-status :error
     3227   then do:
     3228       message
     3229           "Не найдена запись bar-code"
     3230           skip "для товара "
     3231           skip string(buf_goods.artic)
     3232           skip buf_goods.gds-name
     3233           skip "С основным бар-кодом"
     3234           skip string(v-b-code)
     3235       view-as alert-box
     3236       title "Ошибка при выполнении prcreate.i".
     3237       undo, return error .
     3238   end.
     3239   find first buf_root_gds-prt no-lock
     3240        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     3241   .
     3242   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     3243     and buf_bar-code.in-code <> ""
     3244   then do:
     3245       message
     3246           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     3247           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     3248           view-as alert-box error.
     3249       undo, return error.
     3250   end.
     3251   find first buf_gds-prt no-lock
     3252        where buf_gds-prt.node-code = buf_bar-code.node-code
     3253   .
     3254   find first buf_price-list
     3255        where buf_price-list.doc-num = buf_price-doc.doc-num
     3256          and buf_price-list.b-code  = v-b-code
     3257   no-error.
     3258   if available buf_price-list
     3259   then do:
     3260       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     3261          skip "  Цена:   " buf_price-list.price-sale
     3262          skip "Цена будет изменена"
     3263       view-as alert-box warning.
     3264       assign
     3265           p-update = yes
     3266       .
     3267   end.
     3268   else do:
     3269   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3270   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3271     (input  buf_price-doc.obj-type
     3272     ,input  buf_price-doc.obj-code
     3273     ,output p-hostcode
     3274     ) no-error .
     3275   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3276   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3277     (input  buf_goods.gds-code
     3278     ,input  '1':U
     3279     ,input  ?
     3280     ,input  p-hostcode
     3281     ,input  buf_price-doc.obj-type
     3282     ,input  buf_price-doc.obj-code
     3283     ,output local_vat-pc
     3284     ) no-error .
     3285   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3286   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3287     (input  buf_goods.gds-code
     3288     ,input  '2':U
     3289     ,input  ?
     3290     ,input  p-hostcode
     3291     ,input  buf_price-doc.obj-type
     3292     ,input  buf_price-doc.obj-code
     3293     ,output local_slt-pc
     3294     ) no-error .
     3295       kk = kk + 1.
     3296   define variable v-main-bar-code as integer   no-undo .
     3297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3298     (input  buf_goods.gds-code
     3299     ,input  ?
     3300     ,output v-main-bar-code
     3301     )  .
     3302       create buf_price-list.
     3303       assign
     3304           buf_price-list.line-num    = kk
     3305           buf_price-list.doc-num     = buf_price-doc.doc-num
     3306           buf_price-list.b-code      = buf_bar-code.b-code
     3307           buf_price-list.artic       = buf_goods.artic
     3308           buf_price-list.prod-type   = buf_goods.prod-type
     3309           buf_price-list.prod-code   = buf_goods.prod-code
     3310           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     3311           buf_price-list.calc-method = 'Отсутствует':U
     3312           buf_price-list.obj-type    = buf_price-doc.obj-type
     3313           buf_price-list.obj-code    = buf_price-doc.obj-code
     3314           buf_price-list.price-sale  = p-price-sale
     3315           buf_price-list.vat-pc      = local_vat-pc
     3316           buf_price-list.slt-pc      = local_slt-pc
     3317           p-update                   = no
     3318       .
     3319   end.
     3320   end.
     3321   end procedure.
