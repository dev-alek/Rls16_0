     2649         where buf_doc-line-attr.doc-code  = p-doc-code
     2650           and buf_doc-line-attr.gds-code  = p-gds-code
     2651           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     2652        :
