        1   block-level on error undo, throw.
        2   using ibs.th.gbl.sys.objsrv.
        3   define variable vss-revision    as character no-undo init "$Revision: 1eba0946c2d7, 3078, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        5   define variable vss-date        as character no-undo init "$Date: Пт авг 05 19:16:25 2022 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: create-LK_RECEIPT.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: str/create-LK_RECEIPT.p $":U .
        8   define variable vss-description as character no-undo init "Список УПД".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       79   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       80   define new global shared variable g#attr-lib  as handle no-undo .
       81   define variable v-attr-lib-variable as handle no-undo .
       82   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   function getattrUtdex returns char
       84   (idb-num   as integer,
       85    idoc-id   as integer,
       86    iattrcode as character,
       87    iExValue  as character  ):
       88      define buffer utd-attr for utd-attr.
       89      find first utd-attr where utd-attr.db-num eq idb-num
       90                            and utd-attr.doc-id eq idoc-id
       91                            and utd-attr.attr-code eq iattrcode
       92      no-lock no-error.
       93      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
       94   end.
       95   function getattrUtd returns char
       96   (idb-num   as integer,
       97    idoc-id   as integer,
       98    iattrcode as character ):
       99     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      100   end.
      101   function setattrUtd returns logical
      102   (idb-num   as integer,
      103    idoc-id   as integer,
      104    iattrcode as character,
      105    iattrval  as character ):
      106      define buffer utd-attr for utd-attr.
      107      find first utd-attr where utd-attr.db-num eq idb-num
      108                            and utd-attr.doc-id eq idoc-id
      109                            and utd-attr.attr-code eq iattrcode
      110      no-lock no-error.
      111      if not available utd-attr
      112      then do:
      113         create utd-attr.
      114         assign
      115            utd-attr.db-num    = idb-num
      116            utd-attr.doc-id    = idoc-id
      117            utd-attr.attr-code = iattrcode
      118            utd-attr.attr-value = iattrval
      119         .
      120      end.
      121      else do:
      122         if utd-attr.attr-value ne iattrval
      123         then do:
      124            find current utd-attr exclusive-lock no-error.
      125            if available utd-attr
      126            then
      127               utd-attr.attr-value = iattrval.
      128         end.
      129      end.
      130      release utd-attr.
      131   end.
      132   function GetAttrUtdlinesEx returns char
      133   (idb-num   as integer,
      134    idoc-id   as integer,
      135    ilinenum  as integer,
      136    iattrcode as character,
      137    iExValue  as character  ):
      138      define buffer utd-lines-attr for utd-lines-attr.
      139      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      140                                  and utd-lines-attr.doc-id    eq idoc-id
      141                                  and utd-lines-attr.lineNum   eq ilineNum
      142                                  and utd-lines-attr.attr-code eq iattrcode
      143      no-lock no-error.
      144      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      145   end.
      146   function GetAttrUtdlines returns char
      147   (idb-num   as integer,
      148    idoc-id   as integer,
      149    ilinenum  as integer,
      150    iattrcode as character ):
      151      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      152   end.
      153   function setattrUtdlines returns logical
      154   (idb-num   as integer,
      155    idoc-id   as integer,
      156    ilinenum  as integer,
      157    iattrcode as character,
      158    iattrval  as character ):
      159      define buffer utd-lines-attr for utd-lines-attr.
      160      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      161                                  and utd-lines-attr.doc-id    eq idoc-id
      162                                  and utd-lines-attr.lineNum   eq ilineNum
      163                                  and utd-lines-attr.attr-code eq iattrcode
      164      no-lock no-error.
      165      if not available utd-lines-attr
      166      then do:
      167         if iattrval ne ?
      168            and iattrval ne ""
      169         then do:
      170            create utd-lines-attr.
      171            assign
      172               utd-lines-attr.db-num    = idb-num
      173               utd-lines-attr.doc-id    = idoc-id
      174               utd-lines-attr.lineNum   = ilineNum
      175               utd-lines-attr.attr-code = iattrcode
      176               utd-lines-attr.attr-value = iattrval
      177            .
      178         end.
      179      end.
      180      else do:
      181         if utd-lines-attr.attr-value ne iattrval
      182         then do:
      183            find current utd-lines-attr exclusive-lock no-error.
      184            if available utd-lines-attr
      185            then do:
      186               if    iattrval eq ?
      187                  or iattrval eq ""
      188               then do:
      189                  delete utd-lines-attr.
      190               end.
      191               else do:
      192                  utd-lines-attr.attr-value = iattrval.
      193               end.
      194            end.
      195         end.
      196      end.
      197      release utd-lines-attr.
      198   end.
      199   function GetAttrUtdMarkingLinesEx returns char
      200   (idb-num   as integer,
      201    idoc-id   as integer,
      202    ilinenum  as integer,
      203    imark     as character,
      204    iattrcode as character,
      205    iExValue  as character  ):
      206      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      207      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      208                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      209                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      210                                          and utd-marking-lines-attr.mark      eq imark
      211                                          and utd-marking-lines-attr.attr-code eq iattrcode
      212      no-lock no-error.
      213      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      214   end.
      215   function GetAttrUtdMarkingLines returns char
      216   (idb-num   as integer,
      217    idoc-id   as integer,
      218    ilinenum  as integer,
      219    imark     as character,
      220    iattrcode as character ):
      221      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      222   end.
      223   function setattrUtdMarkingLines returns logical
      224   (idb-num   as integer,
      225    idoc-id   as integer,
      226    ilinenum  as integer,
      227    imark     as character,
      228    iattrcode as character,
      229    iattrval  as character ):
      230      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      231      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      232                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      233                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      234                                          and utd-marking-lines-attr.mark      eq imark
      235                                          and utd-marking-lines-attr.attr-code eq iattrcode
      236      no-lock no-error.
      237      if not available utd-marking-lines-attr
      238      then do:
      239         if iattrval ne ?
      240            and iattrval ne ""
      241         then do:
      242            create utd-marking-lines-attr.
      243            assign
      244               utd-marking-lines-attr.db-num     = idb-num
      245               utd-marking-lines-attr.doc-id     = idoc-id
      246               utd-marking-lines-attr.lineNum    = ilineNum
      247               utd-marking-lines-attr.mark       = imark
      248               utd-marking-lines-attr.attr-code  = iattrcode
      249               utd-marking-lines-attr.attr-value = iattrval
      250            .
      251         end.
      252      end.
      253      else do:
      254         if utd-marking-lines-attr.attr-value ne iattrval
      255         then do:
      256            find current utd-marking-lines-attr exclusive-lock no-error.
      257            if available utd-marking-lines-attr
      258            then do:
      259               if    iattrval eq ?
      260                  or iattrval eq ""
      261               then do:
      262                  delete utd-marking-lines-attr.
      263               end.
      264               else do:
      265                  utd-marking-lines-attr.attr-value = iattrval.
      266               end.
      267            end.
      268         end.
      269      end.
      270      release utd-marking-lines-attr.
      271   end.
      272   define input parameter p-doc-code as character no-undo .
      273   define buffer buf_utd for ub.utd .
      274   define buffer buf_utd-lines for ub.utd-lines .
      275   define buffer buf_trn-doc for ub.trn-doc .
      276   define buffer buf_fbr-doc for ub.fbr-doc .
      277   define buffer buf_doc-line for ub.doc-line .
      278   define buffer buf_doc-line-attr for ub.doc-line-attr .
      279   define buffer buf_fbr-line for ub.fbr-line .
      280   define buffer buf_fbr-recipe for ub.fbr-recipe .
      281   define buffer buf_goods for ub.goods .
      282   define variable EdocType  as class ibs.th.str.utd.edoctype no-undo .
      283   define variable create-LK_RECEIPT as logical no-undo init no .
      284   define variable ProductGroups as character no-undo .
      285   define variable v-par-type as character no-undo .
      286   define variable v-par-val  as character no-undo .
      287   define variable vPG as character no-undo .
      288   define variable vPG-ii as integer no-undo .
      289   define variable vAction as character no-undo .
      290   define variable vINN as character no-undo .
      291   find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code no-error .
      292   if not available buf_trn-doc
      293   then do :
      294     undo, return error "Накладная не найдена!" .
      295   end .
      296   for first firm no-lock where firm.firm-code = buf_trn-doc.host-code :
      297     vINN = firm.inn .
      298   end .
      299   case buf_trn-doc.ext-doc-type :
      300     when 'wm':U then vAction = "PRODUCTION_USE" .
      301     when 'vt':U then vAction = "LOSS" .
      302     when 'we':U then vAction = "DESTRUCTION" .
      303     otherwise do :
      304       return .
      305     end .
      306   end case .
      307   doc-lines-check_ :
      308   for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
      309   first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic
      310                             and buf_goods.prod-type = buf_doc-line.prod-type
      311                             and buf_goods.prod-code = buf_doc-line.prod-code
      312   :
      313     if buf_trn-doc.ext-doc-type = 'vt':U
      314     and buf_doc-line.fact-qnty >= 0
      315     then next doc-lines-check_ .
      316       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      317     ( buf_goods.gds-code,
      318       'mark-type':U,
      319        output v-par-val,
      320        output v-par-type
      321     ).
      322     v-par-val = trim(v-par-val, "-40") .
      323     if v-par-val <> "milk"
      324     and v-par-val <> "water"
      325     then next doc-lines-check_ .
      326     find first buf_doc-line-attr no-lock where buf_doc-line-attr.doc-code = buf_doc-line.doc-code
      327                                            and buf_doc-line-attr.gds-code = buf_goods.gds-code
      328                                            and buf_doc-line-attr.attr-code = "GTIN-qnty"
      329                                            no-error .
      330     if not available buf_doc-line-attr
      331     or (available buf_doc-line-attr and trim(buf_doc-line-attr.attr-value) = "")
      332     then do :
      333       next doc-lines-check_ .
      334     end .
      335     create-LK_RECEIPT = yes .
      336     if ProductGroups > ""
      337     and lookup(v-par-val, ProductGroups) > 0
      338     then .
      339     else do :
      340       ProductGroups = ProductGroups + v-par-val + "," .
      341     end .
      342   end .
      343   if not create-LK_RECEIPT
      344   then do :
      345     return .
      346   end .
      347   ProductGroups = trim(ProductGroups, ",") .
      348   EdocType = ObjSrv:Env:Utd:EDocType.
      349   do vPG-ii = 1 to num-entries(ProductGroups) :
      350     run create-utd (input entry(vPG-ii, ProductGroups)) .
      351   end .
      352   procedure create-utd :
      353     define input parameter pPG as character no-undo .
      354     define variable v-LineNum as integer no-undo .
      355     define variable ii as integer no-undo .
      356     define variable vGtin as character no-undo .
      357     define variable vQnty as decimal no-undo .
      358     create buf_utd.
      359     assign
      360       buf_utd.db-num = g#db-num
      361       buf_utd.doc-id = next-value (s-utd-doc-code, ub)
      362       buf_utd.LoadDate = date (now)
      363       buf_utd.LoadTime = time
      364       buf_utd.ModifyDate = date (now)
      365       buf_utd.ModifyTime = time
      366       buf_utd.obj-type = buf_trn-doc.obj-type
      367       buf_utd.obj-code = buf_trn-doc.obj-code
      368       buf_utd.host-code = buf_trn-doc.host-code
      369       buf_utd.DocumentNumber = buf_trn-doc.doc-code
      370       buf_utd.doc-code = buf_trn-doc.doc-code
      371       buf_utd.DocumentDate = buf_trn-doc.fact-date
      372       buf_utd.LoadDate = buf_trn-doc.fact-date
      373       buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:RecipientResponseStatusNotAccep:KeyIntDB
      374       buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LK_RECEIPT_New:KeyIntDB
      375       buf_utd.EDocType = EDocType:LK_RECEIPT:KeyIntDB
      376       buf_utd.obj-inn = vINN
      377     .
      378     setattrUtd (input buf_utd.db-num,
      379                 input buf_utd.doc-id,
      380                 input "LK_RECEIPT_PG",
      381                 input pPG)
      382                 .
      383     setattrUtd (input buf_utd.db-num,
      384                 input buf_utd.doc-id,
      385                 input "LK_RECEIPT_Action",
      386                 input vAction)
      387                 .
      388     v-LineNum = 1 .
      389     doc-lines_ :
      390     for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
      391     first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic
      392                               and buf_goods.prod-type = buf_doc-line.prod-type
      393                               and buf_goods.prod-code = buf_doc-line.prod-code
      394     :
      395       if buf_trn-doc.ext-doc-type = 'vt':U
      396       and buf_doc-line.fact-qnty >= 0
      397       then next doc-lines_ .
      398           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      399       ( buf_goods.gds-code,
      400         'mark-type':U,
      401          output v-par-val,
      402          output v-par-type
      403       ).
      404       v-par-val = trim(v-par-val, "-40") .
      405       if v-par-val <> pPG
      406       then next doc-lines_ .
      407       find first buf_doc-line-attr no-lock where buf_doc-line-attr.doc-code = buf_doc-line.doc-code
      408                                              and buf_doc-line-attr.gds-code = buf_goods.gds-code
      409                                              and buf_doc-line-attr.attr-code = "GTIN-qnty"
      410                                              no-error .
      411       if not available buf_doc-line-attr
      412       or (available buf_doc-line-attr and trim(buf_doc-line-attr.attr-value) = "")
      413       then do :
      414         next doc-lines_ .
      415       end .
      416       ii_ :
      417       do ii = 1 to num-entries(buf_doc-line-attr.attr-value, ";") :
      418         assign
      419           vGtin = entry(1, entry(ii, buf_doc-line-attr.attr-value, ";"), "=")
      420           vQnty = decimal(entry(2, entry(ii, buf_doc-line-attr.attr-value, ";"), "="))
      421         no-error .
      422         if error-status:error
      423         then next ii_ .
      424         find first buf_utd-lines exclusive-lock where buf_utd-lines.db-num = buf_utd.db-num
      425                                                   and buf_utd-lines.doc-id = buf_utd.doc-id
      426                                                   and buf_utd-lines.ProductCode = vGtin
      427         no-error .
      428         if not available buf_utd-lines
      429         then do :
      430           create buf_utd-lines .
      431           assign
      432             buf_utd-lines.db-num = buf_utd.db-num
      433             buf_utd-lines.doc-id = buf_utd.doc-id
      434             buf_utd-lines.LineNum = v-LineNum
      435             buf_utd-lines.gds-code = buf_goods.gds-code
      436             buf_utd-lines.GdsName = buf_goods.gds-name
      437             buf_utd-lines.ProductCode = vGtin
      438             buf_utd-lines.UnitCode = buf_doc-line.unit-cli
      439             buf_utd-lines.Quantity = vQnty
      440             buf_utd-lines.Price = buf_doc-line.price-rubl / ((100 + buf_doc-line.VAT-pc) / 100)
      441             buf_utd-lines.Total = buf_doc-line.price-rubl * buf_utd-lines.Quantity
      442             buf_utd-lines.Vat = buf_utd-lines.Total - (buf_utd-lines.Price * buf_utd-lines.Quantity)
      443             buf_utd-lines.TotalWithVatExcluded = buf_utd-lines.Total - buf_utd-lines.Vat
      444           .
      445           v-LineNum = v-LineNum + 1 .
      446         end .
      447         else do :
      448           assign
      449             buf_utd-lines.Quantity = buf_utd-lines.Quantity + vQnty
      450             buf_utd-lines.Total = buf_doc-line.price-rubl * buf_utd-lines.Quantity
      451             buf_utd-lines.Vat = buf_utd-lines.Total - (buf_utd-lines.Price * buf_utd-lines.Quantity)
      452             buf_utd-lines.TotalWithVatExcluded = buf_utd-lines.Total - buf_utd-lines.Vat
      453           .
      454         end .
      455       end .
      456     end .
      457   end procedure .
