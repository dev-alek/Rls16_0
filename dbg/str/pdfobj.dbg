     1617   procedure fltfield-clear :
     1618     define output parameter loc-fld as character no-undo.
     1619     define output parameter loc-lab as character no-undo .
     1620     define output parameter loc-spr as character no-undo .
     1621     define output parameter loc-dim as character no-undo .
     1622     assign
     1623       loc-fld = ""
     1624       loc-lab = ""
     1625       loc-spr = ""
     1626       loc-dim = "0"
     1627     .
     1628   end procedure .
     1629   procedure fltfield-add :
     1630     define input        parameter par-fld as character no-undo.
     1631     define input        parameter par-lab as character no-undo .
     1632     define input        parameter par-spr as character no-undo .
     1633     define input-output parameter loc-fld as character no-undo.
     1634     define input-output parameter loc-lab as character no-undo .
     1635     define input-output parameter loc-spr as character no-undo .
     1636     define input-output parameter loc-dim as character no-undo .
     1637     do
     1638     on error undo, return error
     1639     :
     1640       assign
     1641       loc-fld = if loc-dim = '0'
     1642                 then par-fld
     1643                 else (loc-fld + chr(44) + par-fld)
     1644       loc-lab = if loc-dim = '0'
     1645                 then par-lab
     1646                 else (loc-lab + chr(44) + par-lab)
     1647       loc-spr = if loc-dim = '0'
     1648                 then par-spr
     1649                 else (loc-spr + chr(44) + par-spr)
     1650       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1651                 string(integer(if num-entries(loc-dim) > 1
     1652                               then entry(2, loc-dim)
     1653                               else entry(1, loc-dim)
     1654                               ) + 1)
     1655       no-error
     1656       .
     1657     end.
     1658   end procedure.
