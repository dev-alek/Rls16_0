     2308   function mark-string returns character
     2309     ( buffer loc-table for ub.price-doc-forming, input mark-list as character  ) :
     2310     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
     2311   end function.
     2312   function stts-string returns character
     2313     ( buffer loc-table for ub.price-doc-forming   ) :
     2314    case loc-table.stts :
     2315       when 0 then return 'новый':U .
     2316       when 1 then return 'удал':U .
     2317       when 3 then return 'факт':U .
     2318       when 4 then return 'готов':U .
     2319    end case.
     2320   end function.
     2321   function activ-pr returns character
     2322     ( buffer loc-table for ub.price-doc-forming  ) :
     2323   define buffer buf_price-all for ub.price-all  .
     2324   define buffer buf2_price-all for ub.price-all  .
     2325     find first buf_price-all no-lock where
     2326                buf_price-all.pdf-db = loc-table.pdf-db  and
     2327                buf_price-all.pdf-id = loc-table.pdf-id  and
     2328                buf_price-all.plt-db-num = loc-table.plt-db-num and
     2329                buf_price-all.plt-id     = loc-table.plt-id and
     2330                buf_price-all.status_    = 'акт':U
     2331                no-error .
     2332      if available buf_price-all then do:
     2333               find first buf2_price-all no-lock where
     2334                         buf2_price-all.pdf-db = loc-table.pdf-db  and
     2335                         buf2_price-all.pdf-id = loc-table.pdf-id  and
     2336                         buf2_price-all.plt-db-num = loc-table.plt-db-num and
     2337                         buf2_price-all.plt-id     = loc-table.plt-id and
     2338                         buf2_price-all.status_    <> 'акт':U
     2339                         no-error .
     2340                if available buf2_price-all then return "не все" .
     2341                else return "все +" .
     2342         end.
     2343      else do:
     2344         return "".
     2345      end.
     2346   end function.
