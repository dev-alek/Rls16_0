     1764       buf_price-doc.pdf-id         = p-pdf-id
     1765       buf_price-doc.plt-db-num     = p-plt-db-num
     1766       buf_price-doc.plt-id         = p-plt-id
     1767       buf_price-doc.PS             = "@ "
