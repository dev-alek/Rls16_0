     1776       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
     1777       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
     1778       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
