     2698   ON CHOOSE OF B-close IN FRAME Dialog-Frame
     2699   DO:
     2700      define variable g#log as logical   no-undo .
     2701   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2702   do:
     2703     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2704       (input  v-cntxt-db-num
     2705       ,input  v-cntxt-userid
     2706       ,input  0
     2707       ,input  'actn_pdf_close':U
     2708       ,input  'global':U
     2709       ,input  v-cntxt-host-code-obj
     2710       ,input  v-cntxt-obj-type
     2711       ,input  v-cntxt-obj-code
     2712       ,input  0
     2713       ,input  0
     2714       ,input  0
     2715       ,input  true
     2716       ,output g#log
     2717       )  .
     2718   end.
     2719     if not g#log then return .
     2720   define variable v-rec-id as recid no-undo .
     2721   define variable v-mode as character no-undo .
     2722   define variable v-ask-pr as logical   no-undo .
     2723    if var-paket = false then do:
     2724     if not available buf_price-doc-forming then return .
     2725     if buf_price-doc-forming.stts <> integer('0':U) then do:
     2726      message "Закрытые или удаленные ДНЦ закрывать нельзя! "
     2727               view-as alert-box information .
     2728      return .
     2729      end.
     2730     v-rec-id = recid(buf_price-doc-forming) .
     2731     if buf_price-list-type.main = true  then do:
     2732        run str/pdf-cask.w ( input parparentproc , input recid( buf_price-doc-forming ) , output v-mode , output v-ask-pr ) .
     2733        if v-mode = "" or  v-ask-pr = ? then return no-apply.
     2734     end.
     2735     else do:
     2736     message "Закрывать ДНЦ" buf_price-doc-forming.pdf-id "?"
     2737         view-as alert-box question
     2738         buttons yes-no
     2739         update var-ok as logical
     2740         .
     2741     if var-ok =  false then return .
     2742     end.
     2743       run str/diallog.w
     2744           ( parparentproc
     2745           , this-procedure
     2746           , 'str/pdf-clos.p':U + chr(4) + '1' + chr(4) + '0' + chr(4) + '1'
     2747           , ( string(v-rec-id) + chr(4) +
     2748              'no' + chr(4) +
     2749              'no' + chr(4) +
     2750              '?'  + chr(4) +
     2751              '?'  + chr(4) +
     2752              string(v-mode) + chr(4) +
     2753              '?' + chr(4) +
     2754              string(v-ask-pr)  )
     2755            , yes
     2756            , '':U
     2757            , 'Закрытие ДНЦ') no-error .
     2758       if error-status :error then
     2759       message
     2760         error-status :get-message(1) skip
     2761         return-value skip
     2762         "Ошибка закрытия ДНЦ"
     2763         view-as alert-box error
     2764       .
     2765     end.
     2766     else do:
     2767         define variable nn as integer   no-undo .
     2768         define variable v-recid as recid no-undo .
     2769         define buffer cl_price-doc-forming for ub.price-doc-forming  .
     2770         define buffer cl_price-list-type for ub.price-list-type  .
     2771         define variable i as integer   no-undo .
     2772         nn = num-entries(p-rec-list) .
     2773             if nn = 0 then do:
     2774                 message "Не выбрано ни одной строки для закрытия! "  view-as alert-box information .
     2775                 return .
     2776             end.
     2777             message substitute("Закрыть &1 отмеченных ДНЦ ?  " , nn)
     2778               view-as alert-box question
     2779               buttons yes-no
     2780               update v-ok as logical.
     2781             if v-ok then do:
     2782               repeat i = 1 to nn :
     2783                   v-recid = int(entry( i , p-rec-list )) .
     2784                   find first cl_price-doc-forming no-lock where
     2785                       recid(cl_price-doc-forming) = v-recid no-error .
     2786                       if available cl_price-doc-forming then do:
     2787                           find first cl_price-list-type no-lock where
     2788                                     cl_price-list-type.plt-id = cl_price-doc-forming.plt-id and
     2789                                     cl_price-list-type.plt-db-num = cl_price-doc-forming.plt-db-num
     2790                                     no-error .
     2791                                if cl_price-doc-forming.stts <> integer('0':U)   then do:
     2792                                   message substitute("ДНЦ &1 закрыть уже нельзя !" , cl_price-doc-forming.pdf-id) view-as alert-box information .
     2793                                 end.
     2794                                 else do:
     2795                                     if cl_price-list-type.main = true  then do:
     2796                                         if v-mode = "" or  v-ask-pr = ? then
     2797                                         run str/pdf-cask.w ( input parparentproc , input recid(cl_price-doc-forming ) , output v-mode , output v-ask-pr ) .
     2798                                             if v-mode = "" or  v-ask-pr = ? then do:
     2799                                                 next.
     2800                                             end.
     2801                                     end.
     2802                                       run str/diallog.w
     2803                                           (parparentproc
     2804                                           , this-procedure
     2805                                           , 'str/pdf-clos.p':U + chr(4) + '1' + chr(4) + '0' + chr(4) + '1'
     2806                                           , ( string(recid(cl_price-doc-forming )) + chr(4) +
     2807                                             'no' + chr(4) +
     2808                                             'no' + chr(4) +
     2809                                             '?' + chr(4) +
     2810                                             '?' + chr(4) +
     2811                                             string(v-mode) + chr(4) +
     2812                                             '?' + chr(4) +
     2813                                             string(v-ask-pr)  )
     2814                                           , yes
     2815                                           , '':U
     2816                                           , 'Закрытие ДНЦ') no-error .
     2817                                           if error-status :error then message
     2818                                             error-status :get-message(1) skip
     2819                                             return-value skip
     2820                                             "Ошибка при закрытии ДНЦ"
     2821                                             view-as alert-box error
     2822                                           .
     2823                             end.
     2824                       end.
     2825               end.
     2826             end.
     2827     end.
     2828     run openbr in this-procedure .
     2829     reposition BROWSE-1grp to recid v-rec-id no-error .
     2830     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     2831   END.
     2832   ON CHOOSE OF B-copy IN FRAME Dialog-Frame
     2833   DO:
     2834     define variable g#log as logical   no-undo .
     2835   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2836   do:
     2837     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2838       (input  v-cntxt-db-num
     2839       ,input  v-cntxt-userid
     2840       ,input  0
     2841       ,input  'actn_pdf_update':U
     2842       ,input  'global':U
     2843       ,input  v-cntxt-host-code-obj
     2844       ,input  v-cntxt-obj-type
     2845       ,input  v-cntxt-obj-code
     2846       ,input  0
     2847       ,input  0
     2848       ,input  0
     2849       ,input  true
     2850       ,output g#log
     2851       )  .
     2852   end.
     2853   if not g#log then return .
     2854   define variable v-rec-id as recid no-undo .
     2855   define variable v-plt-db-num as integer   no-undo .
     2856   define variable v-plt-id     as integer   no-undo .
     2857   define variable v-pdf-db-num as integer   no-undo .
     2858   define variable v-pdf-id     as integer   no-undo .
     2859   define variable v-ok1 as integer   no-undo .
     2860   if not available buf_price-doc-forming then return.
     2861   v-rec-id = recid (buf_price-doc-forming) .
     2862     message "Копировать ДНЦ №" buf_price-doc-forming.pdf-id skip
     2863             "БД:"              buf_price-doc-forming.pdf-db skip
     2864             "на другой ТПЛ ?"                               skip(2)
     2865     "При копировании из текущего ДНЦ в новый ДНЦ перенесутся все баркоды с ценами КАК ЕСТЬ, " skip
     2866     "При этом не проверяются НИ КАКИЕ настройки !!! " skip
     2867     "(ни проверка наличия спец цен (шкал,партий и другой единицы измерения), ни проверка наличия свободной зоны, "
     2868     " ни ограничения нового ТПЛ)"
     2869     view-as alert-box question
     2870     button yes-no
     2871     update v-ok as logical .
     2872     if not v-ok then return .
     2873   define variable v-spis-recid as character no-undo .
     2874   define variable i as integer   no-undo .
     2875   define variable v-kol as integer   no-undo .
     2876   define buffer bufc_price-list-type for ub.price-list-type  .
     2877   v-spis-recid = "" .
     2878   run ref/typepric.w (
     2879       input parParentProc     ,
     2880       input "mode=all,b-mark,b-sel,title=ВЫБИРИТЕ Типы Прайс-листов для копирования endtitle" ,
     2881       input-output v-spis-recid
     2882       ) no-error .
     2883       v-kol = num-entries(v-spis-recid).
     2884       v-ok1 = 0.
     2885       repeat i = 1 to v-kol :
     2886          find first bufc_price-list-type no-lock  where recid(bufc_price-list-type) = int(entry(i,v-spis-recid)) no-error .
     2887          if bufc_price-list-type.stts <> 0 then next.
     2888          v-plt-db-num = bufc_price-list-type.plt-db-num .
     2889          v-plt-id     = bufc_price-list-type.plt-id     .
     2890          run copy_new_price-doc-forming (
     2891              input v-rec-id  ,
     2892              input-output v-plt-db-num  ,
     2893              input-output v-plt-id      ,
     2894              output v-pdf-db-num  ,
     2895              output v-pdf-id
     2896              ) no-error .
     2897              if not error-status :error then do:
     2898                 v-ok1 = v-ok1 + 1 .
     2899              end.
     2900       end.
     2901     run openbr in this-procedure .
     2902     reposition BROWSE-1grp to recid v-rec-id no-error .
     2903     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     2904     message substitute ( "Создано &1 копий ДНЦ" , v-ok1 ) view-as alert-box information .
     2905   END.
     2906   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2907   DO:
     2908   if not available buf_price-doc-forming then return .
     2909      define variable g#log as logical   no-undo .
     2910      if buf_price-doc-forming.stts = integer('3':U) then do:
     2911   define variable vss-include-info34 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2912   do:
     2913     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2914       (input  v-cntxt-db-num
     2915       ,input  v-cntxt-userid
     2916       ,input  0
     2917       ,input  'actn_pdf_delete-fact':U
     2918       ,input  'global':U
     2919       ,input  v-cntxt-host-code-obj
     2920       ,input  v-cntxt-obj-type
     2921       ,input  v-cntxt-obj-code
     2922       ,input  0
     2923       ,input  0
     2924       ,input  0
     2925       ,input  true
     2926       ,output g#log
     2927       )  .
     2928   end.
     2929      end.
     2930      else do:
     2931   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2932   do:
     2933     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2934       (input  v-cntxt-db-num
     2935       ,input  v-cntxt-userid
     2936       ,input  0
     2937       ,input  'actn_pdf_delete':U
     2938       ,input  'global':U
     2939       ,input  v-cntxt-host-code-obj
     2940       ,input  v-cntxt-obj-type
     2941       ,input  v-cntxt-obj-code
     2942       ,input  0
     2943       ,input  0
     2944       ,input  0
     2945       ,input  true
     2946       ,output g#log
     2947       )  .
     2948   end.
     2949     end.
     2950     if not g#log then return .
     2951   if var-paket = false  then do:
     2952     if not available buf_price-doc-forming then return .
     2953     if buf_price-list-type.main = true  and
     2954        buf_price-doc-forming.stts = integer('3':U)
     2955        then do:
     2956         message "ДНЦ :" buf_price-doc-forming.name skip
     2957                 "№" buf_price-doc-forming.pdf-id
     2958                 "главного типа  - удалять нельзя !!!"
     2959                 view-as alert-box error
     2960                 title "Внимание !" .
     2961                 return.
     2962     end.
     2963     message "Удалять ДНЦ : " buf_price-doc-forming.name skip
     2964             "№" buf_price-doc-forming.pdf-id "?"
     2965             view-as alert-box question
     2966             buttons yes-no update g-ok as log.
     2967     if not g-ok then return .
     2968     run price-doc-forming-delete (
     2969         buf_price-doc-forming.plt-db-num ,
     2970         buf_price-doc-forming.plt-id     ,
     2971         buf_price-doc-forming.pdf-db     ,
     2972         buf_price-doc-forming.pdf-id     ,
     2973         v-cntxt-db-num                   ,
     2974         v-cntxt-userid                   )
     2975         no-error .
     2976    end.
     2977    else do:
     2978    define variable nn as integer   no-undo .
     2979    define variable v-recid as recid no-undo .
     2980    define buffer del_price-doc-forming for ub.price-doc-forming  .
     2981    define buffer del_price-list-type for ub.price-list-type  .
     2982    define variable i as integer   no-undo .
     2983    nn = num-entries(p-rec-list) .
     2984       if nn = 0 then do:
     2985           message "Не выбрано ни одной строки для удаления! "  view-as alert-box information .
     2986           return .
     2987       end.
     2988       message substitute("Удалить &1 отмеченных ДНЦ ?  " , nn)
     2989         view-as alert-box question
     2990         buttons yes-no
     2991         update v-ok as logical.
     2992       if v-ok then do:
     2993          repeat i = 1 to nn :
     2994             v-recid = int(entry( i , p-rec-list )) .
     2995             find first del_price-doc-forming no-lock where
     2996                  recid(del_price-doc-forming) = v-recid no-error .
     2997                  if available del_price-doc-forming then do:
     2998                     find first del_price-list-type no-lock where
     2999                                del_price-list-type.plt-id = del_price-doc-forming.plt-id and
     3000                                del_price-list-type.plt-db-num = del_price-doc-forming.plt-db-num
     3001                                no-error .
     3002                       if  del_price-list-type.main = true  and
     3003                           del_price-doc-forming.stts = integer('3':U)   then do:
     3004                             message substitute("Удалять ДНЦ &1 нельзя !" , del_price-doc-forming.pdf-id) view-as alert-box information .
     3005                           end.
     3006                           else do:
     3007                           run price-doc-forming-delete (
     3008                               del_price-doc-forming.plt-db-num ,
     3009                               del_price-doc-forming.plt-id     ,
