     4690     B-ftpl:tooltip in frame Dialog-Frame  = v-filter-name .
     4691     if v-flt-rec = ? then do:
     4692        i-schTPL:LOAD-IMAGE ("cmp/b-sch.bmp") .
     4693        v-filter-name  = 'Фильтр по ТПЛ не установлен' .
     4694     end.
