     3496         v-change-sign = 1
     3497       .
     3498     end.
     3499     else do:
     3500       assign
     3501         v-change-sign = -1
     3502       .
     3503     end.
     3504     assign
     3505       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3506     .
