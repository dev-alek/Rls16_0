     1952   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1953     (input  v-host-code
     1954     ,input  today
     1955     ,output v-base-rate
     1956     ,output v-base-scale
     1957     )  .
     1958   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1959   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     1960     (input  ?
     1961     ,input  p-obj-type
     1962     ,input  p-obj-code
     1963     ,input  yes
     1964     ,output p-plt-id
     1965     ,output p-plt-db-num
     1966     )  .
     1967      create ub.price-doc-forming.
     1968      assign
     1969         ub.price-doc-forming.plt-id       = p-plt-id
     1970         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1971         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1972         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1973         ub.price-doc-forming.base-rate    = v-base-rate
     1974         ub.price-doc-forming.base-scale   = v-base-scale
     1975         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1976         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1977         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1978         ub.price-doc-forming.stts         = 0
     1979         ub.price-doc-forming.sys-date     = today
     1980         ub.price-doc-forming.sys-time     = time
     1981         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1982         ub.price-doc-forming.who          = v-cntxt-userid
     1983         ub.price-doc-forming.name         = "автосоздание"
     1984      .
     1985      assign
     1986       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1987       p-pdf-id      = ub.price-doc-forming.pdf-id
