     1784   procedure prcreate-new-price-list :
     1785   do
     1786   on error undo, return error return-value
     1787   :
     1788   define input parameter p-price-doc-recid   as recid                    no-undo.
     1789   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
     1790   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
     1791   define output parameter p-update           as logical                  no-undo.
     1792   define variable kk as integer no-undo .
     1793   define var v-b-code    like ub.bar-code.b-code     no-undo.
     1794   define variable p-hostcode as int no-undo .
     1795   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1796   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1797   define buffer buf_price-doc        for ub.price-doc.
     1798   define buffer buf_price-list       for ub.price-list.
     1799   define buffer buf_bar-code         for ub.bar-code.
     1800   define buffer buf_goods            for ub.goods.
     1801   define buffer buf_root_gds-prt     for ub.gds-prt.
     1802   define buffer buf_gds-prt          for ub.gds-prt.
     1803   find first buf_price-doc no-lock
     1804        where recid( buf_price-doc ) = p-price-doc-recid
     1805   .
     1806   find first buf_goods no-lock
     1807        where buf_goods.gds-code = p-gds-code
     1808   .
     1809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1810     (input  p-gds-code
     1811     ,input  ?
     1812     ,output v-b-code
     1813     ) no-error .
     1814   if error-status :error
     1815   then do:
     1816       message
     1817           "Не найден основной бар-код"
     1818           skip "для товара "
     1819           skip string(buf_goods.artic)
     1820           skip buf_goods.gds-name
     1821       view-as alert-box
     1822       title "Ошибка при выполнении prcreate.i".
     1823       undo, return error .
     1824   end.
     1825   find first buf_bar-code no-lock
     1826        where buf_bar-code.b-code = v-b-code
     1827   no-error.
     1828   if error-status :error
     1829   then do:
     1830       message
     1831           "Не найдена запись bar-code"
     1832           skip "для товара "
     1833           skip string(buf_goods.artic)
     1834           skip buf_goods.gds-name
     1835           skip "С основным бар-кодом"
     1836           skip string(v-b-code)
     1837       view-as alert-box
     1838       title "Ошибка при выполнении prcreate.i".
     1839       undo, return error .
     1840   end.
     1841   find first buf_root_gds-prt no-lock
     1842        where buf_root_gds-prt.upper-code = buf_goods.prt-root
     1843   .
     1844   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
     1845     and buf_bar-code.in-code <> ""
     1846   then do:
     1847       message
     1848           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1849           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
     1850           view-as alert-box error.
     1851       undo, return error.
     1852   end.
     1853   find first buf_gds-prt no-lock
     1854        where buf_gds-prt.node-code = buf_bar-code.node-code
     1855   .
     1856   find first buf_price-list
     1857        where buf_price-list.doc-num = buf_price-doc.doc-num
     1858          and buf_price-list.b-code  = v-b-code
     1859   no-error.
     1860   if available buf_price-list
     1861   then do:
     1862       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
     1863          skip "  Цена:   " buf_price-list.price-sale
     1864          skip "Цена будет изменена"
     1865       view-as alert-box warning.
     1866       assign
     1867           p-update = yes
     1868       .
     1869   end.
     1870   else do:
     1871   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1872   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1873     (input  buf_price-doc.obj-type
     1874     ,input  buf_price-doc.obj-code
     1875     ,output p-hostcode
     1876     ) no-error .
     1877   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1878   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1879     (input  buf_goods.gds-code
     1880     ,input  '1':U
     1881     ,input  ?
     1882     ,input  p-hostcode
     1883     ,input  buf_price-doc.obj-type
     1884     ,input  buf_price-doc.obj-code
     1885     ,output local_vat-pc
     1886     ) no-error .
     1887   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1888   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1889     (input  buf_goods.gds-code
     1890     ,input  '2':U
     1891     ,input  ?
     1892     ,input  p-hostcode
     1893     ,input  buf_price-doc.obj-type
     1894     ,input  buf_price-doc.obj-code
     1895     ,output local_slt-pc
     1896     ) no-error .
     1897       kk = kk + 1.
     1898   define variable v-main-bar-code as integer   no-undo .
     1899   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1900     (input  buf_goods.gds-code
     1901     ,input  ?
     1902     ,output v-main-bar-code
     1903     )  .
     1904       create buf_price-list.
     1905       assign
     1906           buf_price-list.line-num    = kk
     1907           buf_price-list.doc-num     = buf_price-doc.doc-num
     1908           buf_price-list.b-code      = buf_bar-code.b-code
     1909           buf_price-list.artic       = buf_goods.artic
     1910           buf_price-list.prod-type   = buf_goods.prod-type
     1911           buf_price-list.prod-code   = buf_goods.prod-code
     1912           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     1913           buf_price-list.calc-method = 'Отсутствует':U
     1914           buf_price-list.obj-type    = buf_price-doc.obj-type
     1915           buf_price-list.obj-code    = buf_price-doc.obj-code
     1916           buf_price-list.price-sale  = p-price-sale
     1917           buf_price-list.vat-pc      = local_vat-pc
     1918           buf_price-list.slt-pc      = local_slt-pc
     1919           p-update                   = no
     1920       .
     1921   end.
     1922   end.
     1923   end procedure.
     1924   procedure create_new_price-doc-forming :
     1925   define input  parameter p-obj-type   as character no-undo .
