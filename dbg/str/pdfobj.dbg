     1993   procedure prcreate-new-price-doc-forming-gds :
     1994   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     1995   define input  parameter p-obj-type   as character no-undo .
     1996   define input  parameter p-obj-code   as integer   no-undo .
     1997   define input  parameter par-pr-notls as character no-undo .
     1998   define input  parameter par-pr-altex as character no-undo .
     1999   define input  parameter par-pr-sclex as character no-undo .
     2000   define input  parameter p-line-num    as integer   no-undo .
     2001   define input  parameter p-gds-code    as integer   no-undo .
     2002   define input  parameter p-price-sale  as decimal   no-undo .
     2003   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     2004   define buffer buf_goods for ub.goods  .
     2005   define buffer buf_bar-code for ub.bar-code  .
     2006   define buffer main_bar-code for ub.bar-code  .
     2007   define variable main-b-code as integer   no-undo .
     2008   define variable v-sec as integer   no-undo .
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012   define variable v-cur-dn as character no-undo .
     2013   define variable v-cur-pr as decimal   no-undo .
     2014   define variable v-cur-rt as decimal   no-undo .
     2015   define variable v-cur-ex as decimal   no-undo .
     2016   find first buf_price-doc-forming no-lock where
     2017              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     2018              if error-status :error then return error .
     2019   find first buf_goods no-lock where
     2020              buf_goods.gds-code  = p-gds-code no-error .
     2021              if error-status :error then return error .
     2022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2023     (input  buf_goods.gds-code
     2024     ,input  ?
     2025     ,output main-b-code
     2026     ) no-error .
     2027   run check-use-bar-code (main-b-code) no-error .
     2028   if error-status :error then return .
     2029   run create-line-pdf-mpl-lib (
     2030        input buf_price-doc-forming.plt-db-num
     2031       ,input buf_price-doc-forming.plt-id
     2032       ,input buf_price-doc-forming.pdf-db
     2033       ,input buf_price-doc-forming.pdf-id
     2034       ,input p-line-num
     2035       ,input main-b-code
     2036       ,input buf_goods.artic
     2037       ,input buf_goods.prod-type
     2038       ,input buf_goods.prod-code
     2039       ,input ""
     2040       ,input 0
     2041       ,input p-price-sale
     2042       ,input ""
     2043       ,input 0
     2044      ,input-output v-sec ) no-error .
     2045      if error-status :error  then do:
     2046        message
     2047          vss-workfile vss-revision vss-description skip
     2048          error-status :get-message(1) skip
     2049          return-value skip
     2050          "2"
     2051          view-as alert-box error
     2052        .
     2053      end.
     2054   define buffer old_price-list for ub.price-list  .
     2055   if par-pr-notls = "yes" then do:
     2056   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2057   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2058     (input  p-obj-type
     2059     ,input  p-obj-code
     2060     ,input  main-b-code
     2061     ,input  0
     2062     ,input  0
     2063     ,output v-cur-dn
     2064     ,output v-cur-pr
     2065     ,output v-cur-rt
     2066     ,output v-cur-ex
     2067     )  .
     2068   end.
     2069   if par-pr-altex = "yes" and
     2070      par-pr-notls = "yes" then do:
     2071       if v-cur-dn <> "" then do:
     2072           for each old_price-list no-lock where
     2073                    old_price-list.doc-num = v-cur-dn and
     2074                    old_price-list.artic      = buf_goods.artic and
     2075                    old_price-list.prod-type  = buf_goods.prod-type and
     2076                    old_price-list.prod-code  = buf_goods.prod-code and
     2077                    old_price-list.main-price = no,
     2078                   first buf_bar-code no-lock where
     2079                         buf_bar-code.b-code   = old_price-list.b-code and
     2080                         buf_bar-code.unit-cli <> buf_goods.unit-base
     2081                         :
     2082                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     2083                          if error-status :error then next.
     2084                    run create-line-pdf-mpl-lib (
     2085                          input buf_price-doc-forming.plt-db-num
     2086                         ,input buf_price-doc-forming.plt-id
     2087                         ,input buf_price-doc-forming.pdf-db
     2088                         ,input buf_price-doc-forming.pdf-id
     2089                         ,input p-line-num
     2090                         ,input old_price-list.b-code
     2091                         ,input buf_goods.artic
     2092                         ,input buf_goods.prod-type
     2093                         ,input buf_goods.prod-code
     2094                         ,input ""
     2095                         ,input 0
     2096                         ,input old_price-list.price-sale
     2097                         ,input ""
     2098                         ,input 0
     2099                        ,input-output v-sec ) no-error .
     2100           end.
     2101       end.
     2102   end.
     2103   if par-pr-sclex = "yes" and
     2104      par-pr-notls = "yes" then do:
     2105       if v-cur-dn <> "" then do:
     2106           for each old_price-list no-lock where
     2107                    old_price-list.doc-num    = v-cur-dn and
     2108                    old_price-list.artic      = buf_goods.artic and
     2109                    old_price-list.prod-type  = buf_goods.prod-type and
     2110                    old_price-list.prod-code  = buf_goods.prod-code and
     2111                    old_price-list.main-price = no,
     2112                   first buf_bar-code no-lock where
     2113                         buf_bar-code.b-code   = old_price-list.b-code and
     2114                         buf_bar-code.in-code  = "" and
     2115                         buf_bar-code.unit-cli = buf_goods.unit-base
     2116                         :
     2117                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     2118                          if error-status :error then next.
     2119                    run create-line-pdf-mpl-lib (
     2120                          input buf_price-doc-forming.plt-db-num
     2121                         ,input buf_price-doc-forming.plt-id
     2122                         ,input buf_price-doc-forming.pdf-db
     2123                         ,input buf_price-doc-forming.pdf-id
     2124                         ,input p-line-num
     2125                         ,input old_price-list.b-code
     2126                         ,input buf_goods.artic
     2127                         ,input buf_goods.prod-type
     2128                         ,input buf_goods.prod-code
     2129                         ,input ""
     2130                         ,input 0
     2131                         ,input old_price-list.price-sale
     2132                         ,input ""
     2133                         ,input 0
     2134                       ,input-output v-sec ) no-error .
     2135           end.
     2136       end.
     2137   end.
     2138   end.
     2139   end procedure.
     2140   procedure copy_new_price-doc-forming :
     2141   define input  parameter       p-recid      as recid no-undo .
     2142   define input-output parameter p-plt-db-num as integer   no-undo .
     2143   define input-output parameter p-plt-id     as integer   no-undo .
     2144   define output parameter       p-pdf-db-num as integer   no-undo .
     2145   define output parameter       p-pdf-id     as integer   no-undo .
     2146   define buffer buf_price-list-type        for ub.price-list-type  .
     2147   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     2148   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     2149   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     2150   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     2151   define variable v-host-code  as integer   no-undo .
     2152   define variable v-base-rate  as decimal   no-undo .
     2153   define variable v-base-scale as integer   no-undo .
     2154   define variable v-exch-rate  as decimal   no-undo .
     2155   define variable v-exch-scale as integer   no-undo .
     2156   define variable v-base as logical   no-undo .
     2157   define variable v-name as character no-undo .
     2158     do
     2159     on error undo, return error return-value
     2160     :
     2161   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2162   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2163     (output v-base
     2164     )  .
     2165   find first buf_price-list-type no-lock where
     2166              buf_price-list-type.plt-db-num = p-plt-db-num and
     2167              buf_price-list-type.plt-id     = p-plt-id no-error .
     2168   if error-status :error then return error "Не найден ТПЛ".
     2169   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     2170   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     2171       if available buf_price-doc-forming then do :
     2172           assign
     2173             v-base-rate  = buf_price-doc-forming.base-rate
     2174             v-base-scale = buf_price-doc-forming.base-scale
     2175             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     2176           .
     2177       end.
     2178       else do:
     2179           assign
     2180             v-base-rate  = 1
     2181             v-base-scale = 1
     2182             v-name       = "Автосоздание"
     2183           .
     2184       end.
     2185      create ub.price-doc-forming.
     2186      assign
     2187         ub.price-doc-forming.plt-id       = p-plt-id
     2188         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     2189         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     2190         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     2191         ub.price-doc-forming.base-rate    = v-base-rate
     2192         ub.price-doc-forming.base-scale   = v-base-scale
     2193         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     2194         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     2195         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     2196         ub.price-doc-forming.stts         = 0
     2197         ub.price-doc-forming.sys-date     = today
     2198         ub.price-doc-forming.sys-time     = time
     2199         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     2200         ub.price-doc-forming.who          = v-cntxt-userid
     2201         ub.price-doc-forming.name         = v-name
     2202      .
     2203      assign
     2204       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     2205       p-pdf-id      = ub.price-doc-forming.pdf-id
     2206       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     2207       p-plt-id      = ub.price-doc-forming.plt-id
     2208      .
     2209     end.
     2210     if not available buf_price-doc-forming then return .
     2211   for each buf_price-doc-forming-attr no-lock where
     2212            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2213            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2214            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2215            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2216       create ub.price-doc-forming-attr.
     2217       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     2218       assign
     2219         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     2220         ub.price-doc-forming-attr.plt-id      = p-plt-id
     2221         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     2222         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     2223         .
     2224   end.
     2225   for each buf_price-doc-forming-gds no-lock where
     2226            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     2227            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     2228            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2229            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     2230       create ub.price-doc-forming-gds.
     2231       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     2232       assign
     2233         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     2234         ub.price-doc-forming-gds.plt-id      = p-plt-id
     2235         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     2236         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     2237       .
     2238   end.
     2239   for each buf_pd-forming-gds-attr no-lock where
     2240            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     2241            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     2242            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     2243            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     2244       create ub.price-doc-forming-gdsattr.
     2245       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     2246       assign
     2247         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     2248         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     2249         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     2250         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     2251       .
     2252   end.
     2253   end procedure.
     2254   def var vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2255   procedure check-use-bar-code :
     2256     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     2257     do
     2258     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info27, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2259     on stop   undo, return error substitute( "&1. stop", vss-include-info27 )
     2260     on endkey undo, return error substitute( "&1. endkey", vss-include-info27 )
     2261     :
     2262       define buffer buf_bar-code for ub.bar-code .
     2263       find first buf_bar-code no-lock
     2264         where buf_bar-code.b-code     = p-b-code
     2265         no-error .
     2266       if not available buf_bar-code then do:
     2267         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info27, p-b-code ) .
     2268       end.
     2269       if buf_bar-code.stts = integer('99':U) then do:
     2270         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     2271                                 + "Выполняется удаление бар-кода"
     2272                                 ,vss-include-info27
     2273                                 ,p-b-code
     2274                                 ,chr(10)
     2275                               ) .
     2276       end.
     2277       if buf_bar-code.stts = integer('79':U) then do:
     2278         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     2279                                 + "Бар-код выключен"
     2280                                 ,vss-include-info27
     2281                                 ,p-b-code
     2282                                 ,chr(10)
     2283                               ) .
     2284       end.
     2285       return .
     2286     end.
     2287   end procedure.
