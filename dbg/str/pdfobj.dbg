     1678   procedure prcreate-new-price-doc :
     1679   do
     1680   on error undo, return error return-value
     1681   :
     1682   define input  parameter p-curr-db-num  as integer   no-undo .
     1683   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
     1684   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
     1685   define input  parameter p-plt-id       as integer   no-undo .
     1686   define input  parameter p-plt-db-num   as integer   no-undo .
     1687   define input  parameter p-pdf-id       as integer   no-undo .
     1688   define input  parameter p-pdf-db-num   as integer   no-undo .
     1689   define output parameter p-price-doc-recid  as recid                no-undo.
     1690   define variable v-host-code         like ub.sysconf.host-code        no-undo.
     1691   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
     1692   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
     1693   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
     1694   define buffer buf_price-doc-forming for ub.price-doc-forming.
     1695   define buffer buf_price-doc         for ub.price-doc.
     1696   find first buf_price-doc-forming no-lock where
     1697              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1698              buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1699              buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1700              buf_price-doc-forming.plt-id     = p-plt-id
     1701              no-error .
     1702   if not available buf_price-doc-forming and p-plt-id = ? then do:
     1703      run create_new_price-doc-forming
     1704           ( input p-obj-type ,
     1705             input p-obj-code ,
     1706             output p-pdf-db-num ,
     1707             output p-pdf-id ,
     1708             output p-plt-db-num ,
     1709             output p-plt-id
     1710             ).
     1711       find first buf_price-doc-forming no-lock where
     1712                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
     1713                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
     1714                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1715                 buf_price-doc-forming.plt-id     = p-plt-id
     1716                 no-error .
     1717   end.
     1718       create buf_price-doc .
     1719       run doc-code in this-procedure
     1720       (input  "main",
     1721        input  p-obj-type  ,
     1722        input  p-obj-code  ,
     1723        input  ?,
     1724        output buf_price-doc.doc-num) no-error.
     1725       if error-status:error then do:
     1726         message vss-workfile vss-revision vss-description skip
     1727                error-status :get-message(1)
     1728               "Ошибка при генерации номера документа." return-value view-as alert-box error.
     1729         return error.
     1730       end.
