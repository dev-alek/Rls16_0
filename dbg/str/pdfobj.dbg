     1442   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1443   procedure fltopend_fltopend :
     1444   define input parameter p-parent-handle as handle no-undo .
     1445   define input parameter p-qh as handle no-undo .
     1446   define input parameter p-flt-open-open-query  as character no-undo .
     1447   define input parameter p-where-cond as character no-undo .
     1448   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1449   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1450   define input parameter p-indexed-reposition as character no-undo .
     1451     do
     1452     on error undo, return error
     1453     :
     1454   define variable v-prepare-string as character no-undo .
     1455   define variable glog as logical no-undo .
     1456   assign
     1457   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1458                      p-where-cond + chr(32)  +
     1459                      p-use-indFIRST-query-tail + chr(32) +
     1460                      p-use-ind-sort-clmn-by + chr(32) +
     1461                      p-indexed-reposition
     1462   .
     1463   assign
     1464   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1465   if not glog
     1466   or error-status:error then do:
     1467     message error-status:get-message(1) view-as alert-box .
     1468     undo, return error .
     1469   end.
     1470   assign
     1471   glog = p-qh:query-open no-error .
     1472   if not glog
     1473   or error-status:error then do:
     1474     message error-status:get-message(1) view-as alert-box .
     1475     undo, return error .
     1476   end.
     1477     end.
     1478   end procedure.
     1479   procedure fltopend_fltfindd :
     1480   define input parameter p-parent-handle as handle no-undo .
     1481   define input parameter p-qh as handle no-undo .
     1482   define input parameter p-rowid as rowid no-undo .
     1483   define input parameter p-next as logical no-undo .
     1484   define input parameter p-lock as integer no-undo .
     1485   define input parameter p-bh as handle no-undo .
     1486   define input parameter p-where-cond as character no-undo .
     1487   define input parameter p-use-index-phrase as character no-undo .
     1488   define variable glog as logical no-undo .
     1489   define variable v-qh as handle no-undo .
     1490   define variable v-bh as handle no-undo .
     1491   define variable v-recid as recid no-undo .
     1492   define variable v-prepare-string as character no-undo .
     1493   do
     1494   on error undo, return error
     1495   on stop undo, return error
     1496   :
     1497     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1498     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1499     create query v-qh.
     1500     v-qh:set-buffers(v-bh).
     1501     v-prepare-string = substitute("for each &1 &2 &3"
     1502                                     ,v-bh:name
     1503                                     ,p-where-cond
     1504                                     ,p-use-index-phrase).
     1505     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1506     if not glog then do:
     1507       delete object v-qh.
     1508       delete object v-bh.
     1509       undo, return error .
     1510     end.
     1511     glog = v-qh:query-open no-error .
     1512     if not glog then do:
     1513       delete object v-qh.
     1514       delete object v-bh.
     1515       undo, return error .
     1516     end.
     1517     if p-next then do:
     1518       v-qh:reposition-to-rowid(p-rowid) no-error .
     1519       glog = v-qh:get-next( p-lock) no-error .
     1520       glog = v-qh:get-next( p-lock) no-error .
     1521       if not glog or v-qh:query-off-end = yes then do:
     1522         glog = v-qh:get-first( p-lock) no-error .
     1523       end.
     1524     end.
     1525     else do:
     1526       glog = v-qh:get-first( p-lock) no-error .
     1527     end.
     1528     v-recid = v-bh:recid no-error .
     1529     delete object v-qh.
     1530     delete object v-bh.
     1531     return string(v-recid) .
     1532   end.
     1533   end procedure.
     1534   procedure fltopend_fltfindq :
     1535   define input parameter p-parent-handle as handle no-undo .
     1536   define input parameter p-qh as handle no-undo .
     1537   define input parameter p-next as logical no-undo .
     1538   define input parameter p-lock as integer no-undo .
     1539   define input parameter p-flt-open-open-query  as character no-undo .
     1540   define input parameter p-where-cond as character no-undo .
     1541   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1542   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1543   define input parameter p-indexed-reposition as character no-undo .
     1544   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1545   define variable glog as logical no-undo .
     1546   define variable v-qh as handle no-undo .
     1547   define variable v-bh as handle no-undo extent 18.
     1548   define variable v-rowid as rowid no-undo extent 18.
     1549   define variable v-ii as integer no-undo .
     1550   define variable v-prepare-string as character no-undo .
     1551   do
     1552   on error undo, return error
     1553   on stop undo, return error
     1554   :
     1555     create query v-qh.
     1556     do v-ii = 1 to p-qh:num-buffers:
     1557       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1558       assign
     1559       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1560       no-error.
     1561       v-qh:add-buffer(v-bh[v-ii]).
     1562     end.
     1563     assign
     1564     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1565                       p-where-cond + chr(32)  +
     1566                       p-use-indFIRST-query-tail + chr(32) +
     1567                       p-use-ind-sort-clmn-by + chr(32) +
     1568                       p-indexed-reposition
     1569     .
     1570     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1571     if not glog then do:
     1572       delete object v-qh.
     1573       do v-ii = 1 to p-qh:num-buffers:
     1574         delete object v-bh[v-ii].
     1575       end.
     1576       undo, return error .
     1577     end.
     1578     glog = v-qh:query-open no-error .
     1579     if not glog then do:
     1580       delete object v-qh.
     1581       do v-ii = 1 to p-qh:num-buffers:
     1582         delete object v-bh[v-ii].
     1583       end.
     1584       undo, return error .
     1585     end.
     1586     if p-next then do:
     1587       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1588       glog = v-qh:get-next( p-lock) no-error .
     1589       glog = v-qh:get-next( p-lock) no-error .
     1590       if not glog or v-qh:query-off-end = yes then do:
     1591         glog = v-qh:get-first( p-lock) no-error .
     1592       end.
     1593     end.
     1594     else do:
     1595       glog = v-qh:get-first( p-lock) no-error .
     1596     end.
     1597     do v-ii = 1 to p-qh:num-buffers:
     1598       assign
     1599       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1600       no-error.
     1601     end.
     1602     delete object v-qh.
     1603     do v-ii = 1 to p-qh:num-buffers:
     1604       delete object v-bh[v-ii].
     1605     end.
     1606   end.
     1607   end procedure.
