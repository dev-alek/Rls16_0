     3824   procedure diasize_set-height :
     3825     define input  parameter p-new-height  as decimal   no-undo .
     3826     define input  parameter p-move-resize as logical   no-undo .
     3827     do
     3828     on error undo, return error return-value
     3829     :
     3830       run diasize_change-height in this-procedure
     3831         (input  (p-new-height - frame Dialog-Frame :height)
     3832         ,input  p-move-resize
     3833         ) .
     3834     end.
     3835   end procedure.
     3836   procedure diasize_change-width :
