        1   DEFINE BUFFER buf_price-doc FOR ub.price-doc.
        2   DEFINE BUFFER buf_price-doc-forming FOR ub.price-doc-forming.
        3   DEFINE NEW SHARED BUFFER buf_price-list-type FOR ub.price-list-type.
        4   define input  parameter parParentProc as handle no-undo .
        5   define input  parameter p-mode  as character no-undo .
        6   define input  parameter p-obj-type as character no-undo .
        7   define input  parameter p-obj-code as integer   no-undo .
        8   define input  parameter p-plt-id as int no-undo .
        9   define input  parameter p-plt-db-num as int no-undo .
       10   define input  parameter p-bttns as character no-undo .
       11   define input-output parameter  p-rec-list as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Список документов назначения цены".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define new global shared variable g#library  as handle no-undo .
      122   define new global shared variable g#library2 as handle no-undo .
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124     define variable v-cntxt-db-num        as integer   no-undo .
      125     define variable v-cntxt-userid        as character no-undo .
      126     define variable v-cntxt-level         as character no-undo .
      127     define variable v-cntxt-host-code-obj as integer   no-undo .
      128     define variable v-cntxt-obj-type      as character no-undo .
      129     define variable v-cntxt-obj-code      as integer   no-undo .
      130     define variable v-cntxt-db-num-obj    as integer   no-undo .
      131     define variable v-cntxt-is-admin      as logical   no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133     run mainmenu_getcntxt in parparentproc
      134       (output v-cntxt-db-num
      135       ,output v-cntxt-userid
      136       ,output v-cntxt-level
      137       ,output v-cntxt-host-code-obj
      138       ,output v-cntxt-obj-type
      139       ,output v-cntxt-obj-code
      140       ,output v-cntxt-db-num-obj
      141       ,output v-cntxt-is-admin
      142       ) .
      143   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   define variable v-waitfram-action01         as character   no-undo .
      145   define variable v-waitfram-action02         as character   no-undo .
      146   define variable v-waitfram-action03         as character   no-undo .
      147   define variable mWaitFramTextBeg            as character   no-undo.
      148   define variable mWaitFramTextEnd            as character   no-undo.
      149   define variable mWaitFramView               as logical     no-undo.
      150   define variable mWaitProcEvent              as logical     no-undo init yes.
      151   define variable mWaitFramInterval           as integer     no-undo init 1 .
      152   define variable mWaitFramStop               as logical     no-undo.
      153   define variable mWaitFramStopUser           as logical     no-undo.
      154   define variable mWaitFramStopTimeOut        as logical     no-undo.
      155   define variable mWaitFramStartProc          as datetime-tz no-undo.
      156   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      157   define button B-WaitFramStop auto-end-key
      158        label "Стоп"
      159        size 10 by 1 tooltip "Остоновить процесс".
      160   define button B-viewProcInfo
      161        label "Информация"
      162        size 15 by 1 tooltip "Информация о процесс".
      163   define frame waitfram
      164     v-waitfram-action01 format "x(72)" no-label skip
      165     v-waitfram-action02 format "x(72)" no-label skip
      166     v-waitfram-action03 format "x(72)" no-label skip
      167     B-viewProcInfo
      168     B-WaitFramStop at row 4 col 30
      169     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      170     .
      171   define new global shared variable mBatchMode as logical no-undo init ?.
      172   define variable mFramBachModHandle as handle no-undo.
      173   mFramBachModHandle = frame waitfram:handle.
      174   define variable mFameOldVis as logical no-undo.
      175   define variable mVisCUrentVin as logical no-undo.
      176   if session:batch-mode
      177   then
      178      mBatchMode = yes.
      179   if mBatchMode = ? then do:
      180     mVisCUrentVin = current-window:visible.
      181     mFameOldVis = mFramBachModHandle:visible.
      182     mFramBachModHandle:visible  = yes.
      183     mBatchMode = mFramBachModHandle:visible ne yes.
      184     mFramBachModHandle:visible = mFameOldVis.
      185     current-window:visible = mVisCUrentVin.
      186   end.
      187    if  log-manager:logfile-name ne ?
      188     then DO:
      189         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      190         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      191         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      192     end.
      193   on choose of B-WaitFramStop in frame waitfram
      194   do:
      195     mWaitFramStop = yes.
      196     mWaitFramStopUser = yes.
      197   end.
      198   function waitfram-check-timeout returns logical():
      199      define variable vtime as int64 no-undo.
      200      if mWaitFramStopTimeOut
      201      then
      202         return yes.
      203      vtime = ( now - mWaitFramStartProc ) / 1000 .
      204      if     mWaitFramTimeOut ne ?
      205         and mWaitFramTimeOut ne 0
      206         and mWaitFramTimeOut lt vtime
      207      then do:
      208         mWaitFramStopTimeOut = yes.
      209      end.
      210      return mWaitFramStopTimeOut.
      211   end.
      212   procedure waitfram-hide :
      213     if not session:batch-mode
      214     then do
      215     on error undo, return error return-value
      216     :
      217       pause 0 before-hide .
      218       if not mBatchMode then
      219         hide frame waitfram .
      220     if     not mWaitFramView
      221        and mWaitProcEvent
      222     then
      223       process events .
      224     end.
      225   end procedure.
      226   procedure waitfram-show :
      227     define input  parameter p-message as character no-undo .
      228     define variable v-left-margin as integer   no-undo .
      229     if not session:batch-mode
      230     then do
      231     on error undo, return error return-value
      232     :
      233       if length(p-message) <= 70 then do:
      234         assign
      235           v-left-margin = integer((70 - length(p-message)) / 2)
      236         .
      237         assign
      238           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      239         .
      240         assign
      241           v-waitfram-action01 = " "
      242           v-waitfram-action02 = " "
      243                                    + fill(" ", v-left-margin)
      244                                    + p-message
      245           v-waitfram-action03 = " "
      246         .
      247       end.
      248       else do:
      249         define variable vRindex1 as integer no-undo.
      250         define variable vRindex2 as integer no-undo.
      251         vRindex1 = r-index(p-message," ",70).
      252         if vRindex1 = 0
      253         then
      254            vRindex1 = 70.
      255         if length(p-message)  <= vRindex1 + 70 then do:
      256           assign
      257             v-waitfram-action01 = " "
      258             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      259             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      260           .
      261         end.
      262         else do:
      263           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      264           if vRindex2 <= vRindex1
      265           then
      266              vRindex2 = vRindex1 + 70.
      267           assign
      268             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      269             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      270             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      271           .
      272         end.
      273       end.
      274       B-viewProcInfo:visible   in frame waitfram = no.
      275       B-viewProcInfo:sensitive in frame waitfram = no.
      276       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      277       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      278       if  (   mWaitFramView
      279          or  mWaitProcEvent)
      280          and not mBatchMode
      281       then
      282          display
      283             v-waitfram-action01 skip
      284             v-waitfram-action02 skip
      285             v-waitfram-action03 skip
      286          with frame waitfram .
      287       if     mWaitFramView
      288          then do:
      289             if     mWaitFramInterval ne ?
      290                and not mBatchMode
      291             then
      292                wait-for go of frame waitfram pause mWaitFramInterval.
      293          end.
      294          else
      295             if     mWaitProcEvent
      296                and not mBatchMode
      297             then
      298                process events .
      299     end.
      300   end procedure.
      301      procedure waitfram-show-this:
      302         define input  parameter iInterval as int64 no-undo.
      303         define variable vtime as int64 no-undo.
      304         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      305         mWaitFramInterval = iInterval.
      306         run waitfram-show (substitute("&1&2 &3&4" ,
      307                                       mWaitFramTextBeg ,
      308                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      309                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      310                                       mWaitFramTextEnd
      311                                      )
      312                           ).
      313      end.
      314      procedure WaitFramRunPause:
      315         define input  parameter iInterval as dec no-undo.
      316         define variable vStart  as datetime-tz no-undo.
      317         define variable vend    as datetime-tz no-undo.
      318         define variable vint as int64 no-undo.
      319         define variable vOk as logical no-undo.
      320         vStart = now.
      321         vend   = vStart.
      322         publish "WaitFramPause" (iInterval,output vOk).
      323         vend   =  now.
      324         vint = vend - vStart.
      325         vint = iInterval - vint / 1000.
      326         if     not mWaitFramStop
      327            and (   vint > 0
      328                 or (    not vOk
      329                     and iInterval eq ?
      330                     )
      331                 )
      332         then
      333            run waitfram-show-this (iInterval).
      334         vend   =  now.
      335         vint = vend - vStart.
      336         vint = iInterval - vint / 1000.
      337         if     not mWaitFramStop
      338            and vint > 0
      339         then do:
      340            run gbl/pause.p (vint * 1000).
      341         end.
      342         if iInterval ne ?
      343         then
      344            publish "WaitFramStop".
      345         waitfram-check-timeout().
      346      end.
      347      procedure WaitFramWaitFor:
      348         define input  parameter iInterval as dec no-undo.
      349         assign
      350            mWaitFramStartProc   = now
      351            mWaitFramStopUser    = no
      352            mWaitFramStopTimeOut = no
      353         .
      354         block-wait:
      355         do while not mWaitFramStop:
      356            run WaitFramRunPause (iInterval).
      357            if  waitfram-check-timeout()
      358            then do:
      359               leave block-wait.
      360            end.
      361         end.
      362         run waitfram-hide.
      363      end.
      364   procedure waitfram-join :
      365     define input  parameter p-line-1  as character no-undo .
      366     define input  parameter p-line-2  as character no-undo .
      367     define input  parameter p-line-3  as character no-undo .
      368     define output parameter p-message as character no-undo .
      369     do
      370     on error undo, return error return-value
      371     :
      372       assign
      373         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      374                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      375                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      376       .
      377     end.
      378   end procedure.
      379   function waitfram-join-function returns character
      380     (input p-line-1 as character
      381     ,input p-line-2 as character
      382     ,input p-line-3 as character
      383     ).
      384     define variable v-message as character no-undo .
      385     run waitfram-join in this-procedure
      386       (input  p-line-1
      387       ,input  p-line-2
      388       ,input  p-line-3
      389       ,output v-message
      390       ) .
      391     return v-message .
      392   end function .
      393   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   define temp-table x_obj-group no-undo like ub.clients  .
      395   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      396   procedure metod-gop-obj :
      397     do
      398     on error undo, return error return-value
      399     :
      400   define input  parameter p-cntxt-db-num as integer   no-undo .
      401   define input  parameter p-gop-id       as integer   no-undo .
      402   define input  parameter p-gop-db-num   as integer   no-undo .
      403   define buffer buf1_clients for ub.clients  .
      404   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      405   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      406   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      407   for each  x_obj-group : delete x_obj-group. end.
      408   if p-gop-id = 0 or p-gop-id = ?  then do:
      409      if p-cntxt-db-num = 0  then do:
      410           for each buf1_clients no-lock where
      411                   (buf1_clients.obj-type = 'маг':U  or
      412                    buf1_clients.obj-type = 'скл':U  )
      413                   and
      414                   buf1_clients.db-num >= 0  and
      415                   buf1_clients.stts = 0
      416                   :
      417             create x_obj-group .
      418             assign
      419               x_obj-group.obj-code   = buf1_clients.obj-code
      420               x_obj-group.obj-type   = buf1_clients.obj-type
      421               x_obj-group.obj-name   = buf1_clients.obj-name
      422               x_obj-group.db-num     = buf1_clients.db-num
      423             .
      424           end.
      425      end.
      426      else do:
      427           for each buf1_clients no-lock where
      428                   (buf1_clients.obj-type = 'маг':U  or
      429                    buf1_clients.obj-type = 'скл':U  ) and
      430                    buf1_clients.db-num = p-cntxt-db-num  and
      431                    buf1_clients.stts = 0
      432                   :
      433             create x_obj-group .
      434             assign
      435               x_obj-group.obj-code   = buf1_clients.obj-code
      436               x_obj-group.obj-type   = buf1_clients.obj-type
      437               x_obj-group.obj-name   = buf1_clients.obj-name
      438               x_obj-group.db-num     = buf1_clients.db-num
      439             .
      440           end.
      441      end.
      442   end.
      443   else do:
      444         for each buf_db-grp-obj-price  where
      445                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      446                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      447                 buf_db-grp-obj-price.stts = 0  no-lock :
      448           for each buf1_clients no-lock where
      449                  (buf1_clients.obj-type = 'маг':U  or
      450                   buf1_clients.obj-type = 'скл':U  ) and
      451                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      452                   buf1_clients.stts = 0
      453                   :
      454             create x_obj-group .
      455             assign
      456               x_obj-group.obj-code   = buf1_clients.obj-code
      457               x_obj-group.obj-type   = buf1_clients.obj-type
      458               x_obj-group.obj-name   = buf1_clients.obj-name
      459               x_obj-group.db-num     = buf1_clients.db-num
      460             .
      461           end.
      462         end.
      463       for each buf_host-grp-obj-price where
      464               buf_host-grp-obj-price.gop-id     = p-gop-id and
      465               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      466               buf_host-grp-obj-price.stts = 0
      467               no-lock :
      468         for each buf1_clients no-lock where
      469                (buf1_clients.obj-type = 'маг':U  or
      470                 buf1_clients.obj-type = 'скл':U  ) and
      471                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      472                 buf1_clients.stts = 0
      473                 :
      474             find first x_obj-group no-lock  where
      475                       x_obj-group.obj-code   = buf1_clients.obj-code and
      476                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      477             if not available  x_obj-group then   create x_obj-group .
      478             assign
      479               x_obj-group.obj-code   = buf1_clients.obj-code
      480               x_obj-group.obj-type   = buf1_clients.obj-type
      481               x_obj-group.obj-name   = buf1_clients.obj-name
      482               x_obj-group.db-num     = buf1_clients.db-num
      483             .
      484         end.
      485       end.
      486       for each buf_obj-grp-obj-price where
      487               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      488               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      489               buf_obj-grp-obj-price.stts = 0
      490               no-lock :
      491         for each buf1_clients no-lock where
      492                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      493                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      494                   buf1_clients.stts     = 0
      495                   :
      496             find first  x_obj-group no-lock  where
      497                         x_obj-group.obj-code   = buf1_clients.obj-code and
      498                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      499             if not available  x_obj-group then   create x_obj-group .
      500             assign
      501               x_obj-group.obj-code   = buf1_clients.obj-code
      502               x_obj-group.obj-type   = buf1_clients.obj-type
      503               x_obj-group.obj-name   = buf1_clients.obj-name
      504               x_obj-group.db-num     = buf1_clients.db-num
      505             .
      506         end.
      507       end.
      508   end.
      509   end.
      510   end procedure.
      511   procedure metod-obj-in-gop :
      512   define input  parameter p-curr-db-num as integer   no-undo .
      513   define input  parameter p-obj-type as character no-undo .
      514   define input  parameter p-obj-code as integer   no-undo .
      515   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      516     do
      517     on error undo, return error return-value
      518     :
      519       empty temp-table x_grp-obj-price.
      520       for each buf_grp-obj-price where
      521                buf_grp-obj-price.stts = 0
      522                no-lock :
      523                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      524                  for each x_obj-group where
      525                           x_obj-group.obj-type = p-obj-type and
      526                           x_obj-group.obj-code = p-obj-code :
      527                       create  x_grp-obj-price.
      528                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      529                  end.
      530       end.
      531     end.
      532   end procedure.
      533   procedure metod-delobj-usr :
      534   define input  parameter p-pdf-id  as integer   no-undo .
      535   define input  parameter p-pdf-db  as integer   no-undo .
      536   define input  parameter p-plt-id  as integer   no-undo .
      537   define input  parameter p-plt-db-num as integer   no-undo .
      538   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      539     do
      540     on error undo, return error return-value
      541     :
      542   for each buf_price-doc-forming-attr no-lock  where
      543            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      544            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      545            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      546            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      547            buf_price-doc-forming-attr.attr-code begins "obj" :
      548      for each x_obj-group  where
      549               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      550               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      551        delete x_obj-group.
      552      end.
      553   end.
      554     if not can-find (first x_obj-group) then do:
      555        return "nullobj" .
      556     end.
      557   end.
      558   end procedure.
      559   procedure metod-obj-pdf :
      560   define input  parameter p-cntxt-db-num as integer   no-undo .
      561   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      562   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      563   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      564   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      565   define buffer buf_price-list-type for ub.price-list-type  .
      566   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      567     do
      568     on error undo, return error return-value
      569     :
      570    for each  x_obj-group : delete x_obj-group. end.
      571    find first buf_price-list-type no-lock where
      572               buf_price-list-type.plt-id = p-plt-id and
      573               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      574   if error-status :error then return error return-value .
      575    find first buf_price-doc-forming no-lock where
      576               buf_price-doc-forming.plt-id     = p-plt-id and
      577               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      578               buf_price-doc-forming.pdf-id     = p-pdf-id and
      579               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      580               no-error .
      581   if error-status :error then return error return-value .
      582     run metod-gop-obj in this-procedure (
      583         p-cntxt-db-num,
      584         buf_price-list-type.gop-id ,
      585         buf_price-list-type.gop-db-num
      586         ) no-error .
      587     run metod-delobj-usr in this-procedure (
      588       buf_price-doc-forming.pdf-id ,
      589       buf_price-doc-forming.pdf-db ,
      590       buf_price-doc-forming.plt-id ,
      591       buf_price-doc-forming.plt-db-num
      592       ) no-error .
      593     end.
      594   end procedure.
      595   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      596   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      597   procedure price-doc-forming-DELETE :
      598   define input  parameter p-plt-db-num       as integer   no-undo .
      599   define input  parameter p-plt-id           as integer   no-undo .
      600   define input  parameter p-pdf-db-num       as integer   no-undo .
      601   define input  parameter p-pdf-id           as integer   no-undo .
      602   define input  parameter p-db-num-usr       as integer   no-undo .
      603   define input  parameter p-userid           as character no-undo .
      604   define buffer buf_price-list-type for ub.price-list-type  .
      605   define variable v-value-character as character no-undo .
      606   define variable v-date-close-period as date      no-undo .
      607   define variable v-value-decimal as decimal   no-undo .
      608   define variable v-value-integer as integer   no-undo .
      609   define variable v-value-logical as logical   no-undo .
      610   define variable v-value-type as character no-undo .
      611   define variable v-ask  as logical   no-undo init false .
      612     do
      613     on error undo, return error return-value
      614     :
      615   if p-pdf-db-num <> p-db-num-usr then do:
      616      message "Нельзя удалять ДНЦ на чужой БД !" view-as alert-box error .
      617      return .
      618   end.
      619   find first ub.price-doc-forming no-lock  where
      620           ub.price-doc-forming.pdf-db       = p-pdf-db-num  and
      621           ub.price-doc-forming.pdf-id       = p-pdf-id      and
      622           ub.price-doc-forming.plt-db-num   = p-plt-db-num  and
      623           ub.price-doc-forming.plt-id       = p-plt-id
      624           no-error .
      625   if  ub.price-doc-forming.STTS = integer('1':U) then do:
      626      message "ДНЦ уже удален !" view-as alert-box error .
      627      return .
      628   end.
      629   if  ub.price-doc-forming.STTS = integer('4':U) then do:
      630      message "ДНЦ в статусе ГОТОВ удалять нельзя !" view-as alert-box error .
      631      return .
      632   end.
      633   if  ub.price-doc-forming.STTS = integer('3':U) then do:
      634   find first ub.price-doc-forming exclusive-lock  where
      635           ub.price-doc-forming.pdf-db       = p-pdf-db-num  and
      636           ub.price-doc-forming.pdf-id       = p-pdf-id      and
      637           ub.price-doc-forming.plt-db-num   = p-plt-db-num  and
      638           ub.price-doc-forming.plt-id       = p-plt-id
      639           no-error .
      640    empty temp-table x_obj-group.
      641    find first buf_price-list-type no-lock where
      642               buf_price-list-type.plt-id    =  ub.price-doc-forming.plt-id and
      643               buf_price-list-type.plt-db-num = ub.price-doc-forming.plt-db-num no-error .
      644     run metod-gop-obj in this-procedure ( v-cntxt-db-num,  buf_price-list-type.gop-id , buf_price-list-type.gop-db-num) .
      645     run metod-delobj-usr (
      646       ub.price-doc-forming.pdf-id  ,
      647       ub.price-doc-forming.pdf-db ,
      648       ub.price-doc-forming.plt-id    ,
      649       ub.price-doc-forming.plt-db-num
      650       ).
      651    for each x_obj-group :
      652     run adm/shattri.p (
      653          input "get":U
      654         ,input x_obj-group.obj-type
      655         ,input x_obj-group.obj-code
      656         ,input 'nakl_par':U
      657         ,input  "date-close-period"
      658         ,output v-value-character
      659         ,output v-date-close-period
      660         ,output v-value-decimal
      661         ,output v-value-integer
      662         ,output v-value-logical
      663         ,output v-value-type
      664         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      665         ) no-error .
      666     if error-status :error then v-date-close-period = date('').
      667         if v-date-close-period <> date('') then do:
      668             if ub.price-doc-forming.sys-date < v-date-close-period
      669             then do:
      670               message  substitute(
      671                 "Дата закрытия ДНЦ &1 более ранняя, чем дата закрытия периода &2
      672                 Дата закрытия документа  &3 &2
      673                 Дата закрытия периода    &4 &2
      674                 Объект &5 &6 "
      675                 ,
      676                 ub.price-doc-forming.pdf-id  ,
      677                 chr(10)  ,
      678                 string ( ub.price-doc-forming.sys-date , "99/99/9999" ) ,
      679                 string ( v-date-close-period,   "99/99/9999") ,
      680                           x_obj-group.obj-type ,
      681                           x_obj-group.obj-code  ) view-as alert-box information .
      682                 return.
      683             end.
      684         end.
      685     end.
      686       if available ub.price-doc-forming then do :
      687             ub.price-doc-forming.stts = integer('1':U) .
      688             release ub.price-doc-forming.
      689             find first ub.price-doc-forming no-lock  where
      690                     ub.price-doc-forming.pdf-db       = p-pdf-db-num  and
      691                     ub.price-doc-forming.pdf-id       = p-pdf-id      and
      692                     ub.price-doc-forming.plt-db-num   = p-plt-db-num  and
      693                     ub.price-doc-forming.plt-id       = p-plt-id
      694                     no-error .
      695   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      696   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run a-nwspdf in g#library2
      697     (input  ub.price-doc-forming.plt-id
      698     ,input  ub.price-doc-forming.plt-db-num
      699     ,input  ub.price-doc-forming.pdf-id
      700     ,input  ub.price-doc-forming.pdf-db
      701     ,output v-ask
      702     )  .
      703             if v-ask then do:
      704               run str/diallog.w
      705                       ( input parparentproc
      706                       , input this-procedure
      707                       , input 'str/sendpdfr.p':U
      708                       , input ("D":U + chr(4) +
      709                               string(ub.price-doc-forming.plt-id) + chr(4)  +
      710                               string(ub.price-doc-forming.plt-db-num) + chr(4) +
      711                               string(ub.price-doc-forming.pdf-id) + chr(4)  +
      712                               string(ub.price-doc-forming.pdf-db)
      713                               )
      714                       , input yes
      715                       , input '':U
      716                       , input '') no-error .
      717                       if error-status :error then do:
      718                       message
      719                         vss-workfile vss-revision vss-description skip
      720                         error-status :get-message(1) skip
      721                         return-value skip
      722                         "str/sendpdfr.p"
      723                         view-as alert-box error
      724                       .
      725                       end.
      726             end.
      727       end.
      728   end.
      729   if  ub.price-doc-forming.STTS = integer('0':U) then do:
      730   find first ub.price-doc-forming exclusive-lock  where
      731           ub.price-doc-forming.pdf-db       = p-pdf-db-num  and
      732           ub.price-doc-forming.pdf-id       = p-pdf-id      and
      733           ub.price-doc-forming.plt-db-num   = p-plt-db-num  and
      734           ub.price-doc-forming.plt-id       = p-plt-id
      735           no-error .
      736       if available ub.price-doc-forming then do :
      737          delete ub.price-doc-forming.
      738       end.
      739   end.
      740     end.
      741   end procedure.
      742   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   procedure grp-obj-write :
      744   do
      745   on error undo, return error
      746   :
      747   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      748   define input parameter p-host-code  as integer                          no-undo.
      749   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      750   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      751   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      752   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      753   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      754   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      755   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      756   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      757   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      758   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      759   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      760       find first buf_gds-grp-obj exclusive-lock
      761            where buf_gds-grp-obj.node-code  = p-node-code
      762              and buf_gds-grp-obj.host-code  = p-host-code
      763              and buf_gds-grp-obj.obj-type   = p-obj-type
      764              and buf_gds-grp-obj.obj-code   = p-obj-code
      765       no-error.
      766       if not available buf_gds-grp-obj
      767       then do:
      768           create buf_gds-grp-obj.
      769           assign
      770                   buf_gds-grp-obj.node-code  = p-node-code
      771                   buf_gds-grp-obj.host-code  = p-host-code
      772                   buf_gds-grp-obj.obj-type   = p-obj-type
      773                   buf_gds-grp-obj.obj-code   = p-obj-code
      774           .
      775       end.
      776       assign
      777       buf_gds-grp-obj.min-increase = p-min-increase
      778       buf_gds-grp-obj.max-increase = p-max-increase
      779       buf_gds-grp-obj.increase-pc = p-increase-pc
      780       buf_gds-grp-obj.calc-method = p-calc-method
      781       buf_gds-grp-obj.round-method = p-round-method
      782       buf_gds-grp-obj.round-coef = p-round-coef
      783       buf_gds-grp-obj.cli-type   = p-cli-type
      784       buf_gds-grp-obj.cli-code   = p-cli-code
      785       .
      786   end.
      787   end procedure.
      788   procedure grp-obj-margin-value :
      789   do
      790   on error undo, return error
      791   :
      792   define input parameter p-node-code as integer      no-undo.
      793   define input parameter p-obj-type  as character    no-undo.
      794   define input parameter p-obj-code  as integer      no-undo.
      795   define output parameter p-min-value as decimal      no-undo init ?.
      796   define output parameter p-max-value as decimal      no-undo init ?.
      797   define output parameter p-increase-pc as decimal      no-undo init ?.
      798   define output parameter p-round-method as character no-undo init "":U.
      799   define output parameter p-base as decimal no-undo init ?.
      800   define output parameter p-range-margin     as integer      no-undo.
      801   define output parameter p-exists-margin    as logical      no-undo.
      802   define output parameter p-range-increase     as integer      no-undo.
      803   define output parameter p-exists-increase    as logical      no-undo.
      804   define output parameter p-range-rmethod     as integer no-undo .
      805   define output parameter p-exists-rmethod    as logical no-undo .
      806   define variable v-host-code as integer      no-undo.
      807   DEFINE VARIABLE v-found as logical no-undo .
      808   DEFINE VARIABLE v-exists as logical no-undo .
      809   DEFINE VARIABLE v-range as integer no-undo .
      810   DEFINE VARIABLE jj as integer no-undo .
      811   DEFINE VARIABLE v-margin-found as logical no-undo .
      812   DEFINE VARIABLE v-increase-found as logical no-undo .
      813   DEFINE VARIABLE v-min-value as decimal      no-undo.
      814   DEFINE VARIABLE v-max-value as decimal      no-undo.
      815   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      816   define variable v-round-method as character no-undo .
      817   define variable v-base as decimal no-undo .
      818   define variable v-print-code as character no-undo .
      819   define buffer buf_gds-grp for ub.gds-grp.
      820   find first buf_gds-grp no-lock where
      821              buf_gds-grp.node-code = p-node-code no-error .
      822   if not avail buf_gds-grp and p-node-code <> 0 then do:
      823     message
      824       vss-workfile vss-revision vss-description
      825       skip "Не удалось найти группу товаров с кодом" p-node-code
      826       view-as alert-box error .
      827     undo, return error .
      828   end.
      829   if p-obj-type <> '' then do:
      830   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      831   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      832     (input  p-obj-type
      833     ,input  p-obj-code
      834     ,output v-host-code
      835     ) no-error .
      836     if error-status :error
      837     then do:
      838         message
      839           vss-workfile vss-revision vss-description
      840           skip "Не удалось найти фирму объекта"
      841           skip p-obj-type p-obj-code
      842           skip return-value
      843           skip trim(error-status :get-message(1))
      844               trim(error-status :get-message(2))
      845               trim(error-status :get-message(3))
      846               trim(error-status :get-message(4))
      847               trim(error-status :get-message(5))
      848         view-as alert-box error.
      849         undo, return error .
      850     end.
      851   end.
      852   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      853   do while v-found = no and jj < 2:
      854     if v-range <> 3 then do:
      855       find first buf_gds-grp-obj no-lock
      856           where buf_gds-grp-obj.node-code = p-node-code
      857             and buf_gds-grp-obj.host-code = v-host-code
      858             and buf_gds-grp-obj.obj-type  = p-obj-type
      859             and buf_gds-grp-obj.obj-code  = p-obj-code
      860       no-error .
      861     end.
      862     if v-range = 3 or not available buf_gds-grp-obj
      863     then do:
      864        if v-range <> 2 then do:
      865           find first buf_gds-grp-obj no-lock
      866               where buf_gds-grp-obj.node-code = p-node-code
      867                 and buf_gds-grp-obj.host-code = v-host-code
      868                 and buf_gds-grp-obj.obj-type  = ""
      869                 and buf_gds-grp-obj.obj-code  = 0
      870           no-error .
      871         end.
      872         if v-range = 2 or not available buf_gds-grp-obj
      873         then do:
      874             if v-range <> 1 then do:
      875               find first buf_gds-grp-obj no-lock
      876                   where buf_gds-grp-obj.node-code = p-node-code
      877                   and buf_gds-grp-obj.host-code = 0
      878                   and buf_gds-grp-obj.obj-type  = ""
      879                   and buf_gds-grp-obj.obj-code  = 0
      880               no-error .
      881             end.
      882             if v-range = 1 or not available buf_gds-grp-obj
      883             then do:
      884                 assign
      885                     v-exists = no
      886                 .
      887             end.
      888             else do:
      889                 assign
      890                     v-exists = yes
      891                     v-range = 1
      892                 .
      893             end.
      894         end.
      895         else do:
      896             assign
      897                 v-exists = yes
      898                 v-range  = 2
      899             .
      900         end.
      901     end.
      902     else do:
      903         assign
      904             v-exists = yes
      905             v-range  = 3
      906         .
      907     end.
      908     if available buf_gds-grp-obj
      909     then do:
      910       assign
      911       v-min-value    = buf_gds-grp-obj.min-increase
      912       v-max-value    = buf_gds-grp-obj.max-increase
      913       v-increase-pc  = buf_gds-grp-obj.increase-pc
      914       v-round-method = buf_gds-grp-obj.round-method
      915       v-base         = buf_gds-grp-obj.round-coef
      916       .
      917       assign
      918       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      919                           then yes
      920                           else p-exists-margin)
      921       p-range-margin = if p-exists-margin and p-min-value = ?
      922                         then v-range
      923                         else p-range-margin
      924       p-min-value   =  if p-exists-margin and  p-min-value = ?
      925                         then v-min-value
      926                         else p-min-value
      927       p-max-value   =  if p-exists-margin and  p-max-value = ?
      928                         then v-max-value
      929                         else p-max-value
      930       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      931                           then yes
      932                           else p-exists-increase)
      933       p-range-increase = if p-exists-increase and p-increase-pc = ?
      934                         then v-range
      935                         else p-range-increase
      936       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      937                         then v-increase-pc
      938                         else p-increase-pc)
      939       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      940                           then yes
      941                           else p-exists-rmethod
      942       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      943                           then v-range
      944                           else p-range-rmethod)
      945       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      946                           then v-round-method
      947                           else p-round-method)
      948       p-base          = (if p-exists-rmethod and p-base = ?
      949                           then v-base
      950                           else p-base)
      951       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      952       jj = jj + 1
      953       .
      954     end.
      955     else do:
      956       assign
      957       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      958       jj = jj + 1
      959       .
      960     end.
      961   end.
      962   end.
      963   end procedure.
      964   procedure grp-obj-income-cli-value :
      965   do
      966   on error undo, return error
      967   :
      968   define input parameter p-node-code as integer      no-undo.
      969   define input parameter p-obj-type  as character    no-undo.
      970   define input parameter p-obj-code  as integer      no-undo.
      971   define output parameter p-cli-type as character    no-undo init ?.
      972   define output parameter p-cli-code as integer      no-undo init ?.
      973   define output parameter p-range-income-cli     as integer      no-undo.
      974   define output parameter p-exists-income-cli    as logical      no-undo.
      975   define variable v-host-code as integer      no-undo.
      976   DEFINE VARIABLE v-found as logical no-undo .
      977   DEFINE VARIABLE v-exists as logical no-undo .
      978   DEFINE VARIABLE v-range as integer no-undo .
      979   DEFINE VARIABLE jj as integer no-undo .
      980   DEFINE VARIABLE v-income-cli-found as logical no-undo .
      981   DEFINE VARIABLE v-cli-type-value as char      no-undo.
      982   DEFINE VARIABLE v-cli-code-value as int      no-undo.
      983   define buffer buf_gds-grp for ub.gds-grp.
      984   find first buf_gds-grp no-lock where
      985              buf_gds-grp.node-code = p-node-code no-error .
      986   if not avail buf_gds-grp and p-node-code <> 0 then do:
      987     message
      988       vss-workfile vss-revision vss-description
      989       skip "Не удалось найти группу товаров с кодом" p-node-code
      990       view-as alert-box error .
      991     undo, return error .
      992   end.
      993   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      995     (input  p-obj-type
      996     ,input  p-obj-code
      997     ,output v-host-code
      998     ) no-error .
      999   if error-status :error
     1000   then do:
     1001       message
     1002         vss-workfile vss-revision vss-description
     1003         skip "Не удалось найти фирму объекта"
     1004         skip p-obj-type p-obj-code
     1005         skip return-value
     1006         skip trim(error-status :get-message(1))
     1007              trim(error-status :get-message(2))
     1008              trim(error-status :get-message(3))
     1009              trim(error-status :get-message(4))
     1010              trim(error-status :get-message(5))
     1011       view-as alert-box error.
     1012       undo, return error .
     1013   end.
     1014   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1015   do while v-found = no and jj < 2:
     1016     if v-range <> 3 then do:
     1017       find first buf_gds-grp-obj no-lock
     1018           where buf_gds-grp-obj.node-code = p-node-code
     1019             and buf_gds-grp-obj.host-code = v-host-code
     1020             and buf_gds-grp-obj.obj-type  = p-obj-type
     1021             and buf_gds-grp-obj.obj-code  = p-obj-code
     1022       no-error .
     1023     end.
     1024     if v-range = 3 or not available buf_gds-grp-obj
     1025     then do:
     1026        if v-range <> 2 then do:
     1027           find first buf_gds-grp-obj no-lock
     1028               where buf_gds-grp-obj.node-code = p-node-code
     1029                 and buf_gds-grp-obj.host-code = v-host-code
     1030                 and buf_gds-grp-obj.obj-type  = ""
     1031                 and buf_gds-grp-obj.obj-code  = 0
     1032           no-error .
     1033         end.
     1034         if v-range = 2 or not available buf_gds-grp-obj
     1035         then do:
     1036             if v-range <> 1 then do:
     1037               find first buf_gds-grp-obj no-lock
     1038                   where buf_gds-grp-obj.node-code = p-node-code
     1039                   and buf_gds-grp-obj.host-code = 0
     1040                   and buf_gds-grp-obj.obj-type  = ""
     1041                   and buf_gds-grp-obj.obj-code  = 0
     1042               no-error .
     1043             end.
     1044             if v-range = 1 or not available buf_gds-grp-obj
     1045             then do:
     1046                 assign
     1047                     v-exists = no
     1048                 .
     1049             end.
     1050             else do:
     1051                 assign
     1052                     v-exists = yes
     1053                     v-range = 1
     1054                 .
     1055             end.
     1056         end.
     1057         else do:
     1058             assign
     1059                 v-exists = yes
     1060                 v-range  = 2
     1061             .
     1062         end.
     1063     end.
     1064     else do:
     1065         assign
     1066             v-exists = yes
     1067             v-range  = 3
     1068         .
     1069     end.
     1070     if available buf_gds-grp-obj
     1071     then do:
     1072       assign
     1073       v-cli-type-value    = buf_gds-grp-obj.cli-type
     1074       v-cli-code-value    = buf_gds-grp-obj.cli-code
     1075       .
     1076       assign
     1077       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     1078                           then yes
     1079                           else p-exists-income-cli)
     1080       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     1081                         then v-range
     1082                         else p-range-income-cli
     1083       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     1084                         then v-cli-type-value
     1085                         else p-cli-type
     1086       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     1087                         then v-cli-code-value
     1088                         else p-cli-code
     1089       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     1090       jj = jj + 1
     1091       .
     1092     end.
     1093     else do:
     1094       assign
     1095       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     1096       jj = jj + 1
     1097       .
     1098     end.
     1099   end.
     1100   end.
     1101   end procedure.
