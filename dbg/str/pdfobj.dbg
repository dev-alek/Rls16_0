     4083           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4084         no-error .
     4085         if error-status :error
     4086         or error-status :get-message(1) <> ""
     4087         then do:
     4088           undo move_block, retry move_block.
     4089         end.
     4090         for each buf_temp-browse-handle
     4091           where buf_temp-browse-handle.browse-type = 'width':u
     4092         on error undo move_block, retry move_block
     4093         :
     4094           assign
     4095             buf_temp-browse-handle.browse-handle :width
     4096               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4097             no-error .
     4098           if error-status :error
     4099           or error-status :get-message(1) <> ""
     4100           then do:
     4101             undo move_block, retry move_block .
     4102           end.
     4103         end.
     4104         for each buf_temp-diasize-handle
     4105         on error undo move_block, retry move_block
     4106         :
     4107           assign
     4108             v-object-handle = buf_temp-diasize-handle.handle-value
     4109           .
     4110           if v-object-handle <> v-diasize-resize-button
     4111           then do:
     4112             assign
     4113               v-object-handle :col = v-object-handle :col + p-change-value
     4114               no-error .
     4115             if error-status :error
     4116             or error-status :get-message(1) <> ""
     4117             then do:
     4118               undo move_block, retry move_block .
     4119             end.
     4120           end.
     4121         end.
     4122       end.
     4123       else do:
     4124         for each buf_temp-diasize-handle
     4125         on error undo move_block, retry move_block
     4126         :
     4127           assign
     4128             v-object-handle = buf_temp-diasize-handle.handle-value
     4129           .
     4130           if v-object-handle <> v-diasize-resize-button
     4131           then do:
     4132             assign
     4133               v-object-handle :col = v-object-handle :col + p-change-value
     4134               no-error .
     4135             if error-status :error
     4136             or error-status :get-message(1) <> ""
     4137             then do:
     4138               undo move_block, retry move_block .
     4139             end.
     4140           end.
     4141         end.
     4142         for each buf_temp-browse-handle
     4143           where buf_temp-browse-handle.browse-type = 'width':u
     4144         on error undo move_block, retry move_block
     4145         :
     4146           assign
     4147             buf_temp-browse-handle.browse-handle :width
     4148               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4149             no-error .
     4150           if error-status :error
     4151           or error-status :get-message(1) <> ""
     4152           then do:
     4153             undo move_block, retry move_block .
     4154           end.
     4155         end.
     4156         assign
     4157           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4158           no-error .
     4159         if error-status :error
     4160         or error-status :get-message(1) <> ""
     4161         then do:
     4162           undo move_block, retry move_block.
     4163         end.
     4164         assign
     4165           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4166         no-error .
     4167         if error-status :error
     4168         or error-status :get-message(1) <> ""
     4169         then do:
     4170           undo move_block, retry move_block.
     4171         end.
     4172         if frame Dialog-Frame :scrollable = true
     4173         then do:
     4174           assign
     4175             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4176           no-error .
     4177           if error-status :error
     4178           or error-status :get-message(1) <> ""
     4179           then do:
     4180             undo move_block, retry move_block.
     4181           end.
     4182         end.
     4183       end.
     4184       if p-move-resize
     4185       then do:
     4186         run diasize_position-resize-button in this-procedure .
     4187       end.
     4188       if v-diasize-wndstore = true
     4189       then do:
     4190         if connected("ub") = true
     4191         then do:
     4192           define variable v-cntxt-db-num        as integer   no-undo .
     4193           define variable v-cntxt-userid        as character no-undo .
     4194           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4195                                             , OUTPUT v-cntxt-userid
     4196                                             ) .
     4197           run gbl/wndsizew.p
     4198             (input  v-cntxt-db-num
     4199             ,input  v-cntxt-userid
     4200             ,input  v-diasize-proc-name
     4201             ,input  'width':u
     4202             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4203             ) .
     4204         end.
     4205       end.
     4206     end.
     4207     assign
     4208       v-diasize-change-size = false
     4209     .
     4210   end procedure.
     4211   procedure diasize_set-width :
     4212     define input  parameter p-new-width  as decimal   no-undo .
     4213     define input  parameter p-move-resize as logical   no-undo .
     4214     do
     4215     on error undo, return error return-value
     4216     :
     4217       run diasize_change-width in this-procedure
     4218         (input  (p-new-width - frame Dialog-Frame :width)
     4219         ,input  p-move-resize
     4220         ) .
     4221     end.
     4222   end procedure.
     4223   procedure diasize_position-resize-button :
     4224     do with frame Dialog-Frame
     4225     :
     4226       hide v-diasize-resize-button .
     4227       assign
     4228         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4229                     - 1
     4230                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4231         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4232                     - 1
     4233                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4234       .
     4235       view v-diasize-resize-button .
     4236     end.
     4237   end procedure.
     4238   on alt-right anywhere
     4239   do:
     4240     run diasize_change-width in this-procedure
     4241       (input 1
     4242       ,input true
     4243       ) .
     4244     return no-apply .
     4245   end.
     4246   on alt-left anywhere
     4247   do:
     4248     run diasize_change-width in this-procedure
     4249       (input -1
     4250       ,input true
     4251       ) .
     4252     return no-apply .
     4253   end.
     4254   on alt-down anywhere
     4255   do:
     4256     run diasize_change-height in this-procedure
     4257       (input 1
     4258       ,input true
     4259       ) .
     4260     return no-apply .
     4261   end.
     4262   on alt-up anywhere
     4263   do:
     4264     run diasize_change-height in this-procedure
     4265       (input -1
     4266       ,input true
     4267       ) .
     4268     return no-apply .
     4269   end.
     4270   on alt-enter of frame Dialog-Frame
     4271   do:
     4272     run diasize_maximize in this-procedure
     4273       (input  ?
     4274       ).
     4275     return no-apply .
     4276   end.
     4277   procedure diasize_end-move :
     4278     do
     4279     on error undo, return error return-value
     4280     :
     4281       define variable v-row-delta as decimal   no-undo .
     4282       define variable v-col-delta as decimal   no-undo .
     4283       define variable v-new-row as decimal   no-undo .
     4284       define variable v-new-col as decimal   no-undo .
     4285       assign
     4286         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4287         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4288       .
     4289       assign
     4290         v-row-delta = v-new-row - frame Dialog-Frame :height
     4291         v-col-delta = v-new-col - frame Dialog-Frame :width
     4292       .
     4293       run diasize_change-height in this-procedure
     4294         (input v-row-delta
     4295         ,input true
     4296         ) .
     4297       run diasize_change-width in this-procedure
     4298         (input v-col-delta
     4299         ,input true
     4300         ) .
     4301     end.
     4302   end procedure.
     4303   procedure diasize_maximize :
     4304     define input  parameter p-action as logical   no-undo .
     4305     do
     4306     on error undo, return error return-value
     4307     :
     4308       if p-action = ?
     4309       then do:
     4310         if v-diasize-need-maximize = true
     4311         then do:
     4312           assign
     4313             p-action = true
     4314           .
     4315         end.
     4316         else do:
     4317           assign
     4318             p-action = false
     4319           .
     4320         end.
     4321       end.
     4322       if p-action = true
     4323       then do:
     4324         run diasize_change-height in this-procedure
     4325           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4326               - frame Dialog-Frame :height-chars
     4327           ,input true
     4328           ) .
     4329         run diasize_change-width in this-procedure
     4330           (input session :width-chars
     4331               - frame Dialog-Frame :width-chars
     4332           ,input true
     4333           ) .
     4334         assign
     4335           v-diasize-need-maximize = false
     4336         .
     4337       end.
     4338       else do:
     4339         run diasize_change-width in this-procedure
     4340           (input v-diasize-orig-frame-width
     4341               - frame Dialog-Frame :width-chars
     4342           ,input true
     4343           ) .
     4344         run diasize_change-height in this-procedure
     4345           (input v-diasize-orig-frame-height
     4346               - frame Dialog-Frame :height-chars
     4347           ,input true
     4348           ) .
     4349         assign
     4350           v-diasize-need-maximize = true
     4351         .
     4352       end.
     4353     end.
     4354   end procedure.
     4355   procedure diasize_restore-orig-size :
     4356     do
     4357     on error undo, return error return-value
     4358     :
     4359       assign
     4360         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4361         v-diasize-current-frame-height = frame Dialog-Frame :height
     4362       .
     4363       run diasize_set-height in this-procedure
     4364         (input  v-diasize-orig-frame-height
     4365         ,input  true
     4366         ) .
     4367       run diasize_set-width in this-procedure
     4368         (input  v-diasize-orig-frame-width
     4369         ,input  true
     4370         ) .
     4371     end.
     4372   end procedure.
     4373   procedure diasize_restore-current-size :
     4374     do
     4375     on error undo, return error return-value
     4376     :
     4377       run diasize_set-height in this-procedure
     4378         (input  v-diasize-current-frame-height
     4379         ,input  true
     4380         ) .
     4381       run diasize_set-width in this-procedure
     4382         (input  v-diasize-current-frame-width
     4383         ,input  true
     4384         ) .
     4385     end.
     4386   end procedure.
     4387   procedure diasize_set-browse-handle :
     4388     define input  parameter p-browse-handle as handle   no-undo .
     4389     define buffer buf_temp-browse-handle for temp-browse-handle .
     4390     do
     4391     on error undo, return error return-value
     4392     :
     4393       assign
     4394         v-diasize-browse-handle = p-browse-handle
     4395       .
     4396       for each buf_temp-browse-handle
     4397       on error undo, return error return-value
     4398       :
     4399         delete buf_temp-browse-handle .
     4400       end.
     4401     end.
     4402   end procedure.
     4403   procedure diasize_add_browse :
     4404     define input  parameter p-browse-type   as character no-undo .
     4405     define input  parameter p-browse-handle as handle    no-undo .
     4406     define buffer buf_temp-browse-handle for temp-browse-handle .
     4407     do
     4408     on error undo, return error return-value
     4409     :
     4410       assign
     4411         v-diasize-browse-number = v-diasize-browse-number + 1
     4412       .
     4413       create buf_temp-browse-handle .
     4414       assign
     4415         buf_temp-browse-handle.browse-type   = p-browse-type
     4416         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4417         buf_temp-browse-handle.browse-handle = p-browse-handle
     4418       .
     4419     end.
     4420   end procedure.
     4421   procedure diasize_init :
     4422     define variable v-default-value    as logical   no-undo .
     4423     define variable v-restore-saved    as logical   no-undo .
     4424     define variable v-resize-value-str as character no-undo .
     4425     do
     4426     on error undo, return error return-value
     4427     :
     4428       do with frame Dialog-Frame
     4429       :
     4430         assign
     4431           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4432           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4433           v-diasize-browse-handle     = browse BROWSE-1grp :handle
     4434         .
     4435         create button v-diasize-resize-button
     4436         assign
     4437           parent        = frame Dialog-Frame :first-child
     4438           label         = "s"
     4439           height-pixels = 16
     4440           width-pixels  = 16
     4441           visible       = true
     4442           sensitive     = true
     4443           movable       = true
     4444           triggers:
     4445             on end-move persistent run diasize_end-move in this-procedure .
     4446           end triggers.
     4447         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4448         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4449         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4450         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4451         assign
     4452           v-diasize-wndmax = false
     4453         .
     4454         if connected("ub") = true
     4455         then do:
     4456           define variable v-cntxt-db-num        as integer   no-undo .
     4457           define variable v-cntxt-userid        as character no-undo .
     4458           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4459                                             , OUTPUT v-cntxt-userid
     4460                                             ) .
     4461           run gbl/wndpar_r.p
     4462             (input  v-cntxt-db-num
     4463             ,input  v-cntxt-userid
     4464             ,input  'wndmax':U
     4465             ,output v-diasize-wndmax
     4466             ,output v-default-value
     4467             ) .
     4468         end.
     4469         assign
     4470           v-diasize-wndstore = false
     4471         .
     4472         if connected("ub") = true
     4473         then do:
     4474           run gbl/wndpar_r.p
     4475             (input  v-cntxt-db-num
     4476             ,input  v-cntxt-userid
     4477             ,input  'wndstore':U
     4478             ,output v-diasize-wndstore
     4479             ,output v-default-value
     4480             ) .
     4481         end.
     4482         assign
     4483           v-diasize-proc-name = entry(1, program-name(2), '.')
     4484         .
     4485         if v-diasize-wndstore = true
     4486         then do:
     4487           assign
     4488             v-restore-saved = false
     4489           .
     4490           if connected("ub") = true
     4491           then do:
     4492             run gbl/wndsizer.p
     4493               (input  v-cntxt-db-num
     4494               ,input  v-cntxt-userid
     4495               ,input  v-diasize-proc-name
     4496               ,input  'height':u
     4497               ,output v-resize-value-str
     4498               ) .
     4499             if v-resize-value-str <> '':U
     4500             then do:
     4501               run diasize_change-height in this-procedure
     4502                 (input  integer(v-resize-value-str)
     4503                 ,input  true
     4504                 ) .
     4505               assign
     4506                 v-restore-saved = true
     4507               .
     4508             end.
     4509           end.
     4510           if connected("ub") = true
     4511           then do:
     4512             run gbl/wndsizer.p
     4513               (input  v-cntxt-db-num
     4514               ,input  v-cntxt-userid
     4515               ,input  v-diasize-proc-name
     4516               ,input  'width':u
     4517               ,output v-resize-value-str
     4518               ) .
     4519             if v-resize-value-str <> '':U
     4520             then do:
     4521               run diasize_change-width in this-procedure
     4522                 (input  integer(v-resize-value-str)
     4523                 ,input  true
     4524                 ) .
     4525               assign
     4526                 v-restore-saved = true
     4527               .
     4528             end.
     4529           end.
     4530           if v-restore-saved <> true
     4531           then do:
     4532             if v-diasize-wndmax = true
     4533             then do:
     4534               run diasize_maximize in this-procedure
     4535                 (input  true
     4536                 ) .
     4537             end.
     4538           end.
     4539         end.
     4540         else do:
     4541           if v-diasize-wndmax = true
     4542           then do:
     4543             run diasize_maximize in this-procedure
     4544               (input  true
     4545               ) .
     4546           end.
     4547         end.
     4548       end.
     4549     end.
     4550   end procedure.
     4551   procedure diasize_need-full-display :
     4552     define output parameter p-need-full-display as logical   no-undo .
     4553     do
     4554     on error undo, return error return-value
     4555     :
     4556       assign
     4557         p-need-full-display = v-diasize-need-full-display
     4558       .
     4559       assign
     4560         v-diasize-need-full-display = false
     4561       .
     4562     end.
     4563   end procedure.
     4564   procedure get-context :
     4565      define output parameter p-db-num as integer          no-undo.
     4566      define output parameter p-user-id as character        no-undo.
     4567      define variable v-login               as character    no-undo.
     4568      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4569      define buffer buf_user-login  for ub.user-login .
     4570      do
     4571      on error undo, return error
     4572      :
     4573            FIND FIRST buf_sys-ctrl no-lock.
     4574            ASSIGN
     4575               v-login = USERID("ub")
     4576               p-db-num = buf_sys-ctrl.db-num
     4577            .
     4578            FIND FIRST buf_user-login
     4579                 WHERE buf_user-login.db-num = p-db-num
     4580                   AND buf_user-login.user-login = v-login
     4581                 no-lock
     4582                 no-error
     4583                 .
     4584            IF AVAILABLE buf_user-login
     4585            THEN DO:
     4586               assign
     4587                  p-user-id = buf_user-login.user-id
     4588               .
     4589            END.
     4590      end.
     4591   end procedure.
     4592   run diasize_add_browse in this-procedure
     4593     (input  'width':u
     4594     ,input  browse BROWSE-2-pr:handle
     4595     ) .
     4596   run diasize_init in this-procedure .
     4597   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4598   on f5 of frame Dialog-Frame anywhere
     4599   do:
     4600     run openbr in this-procedure .
     4601       apply "VALUE-CHANGED" to BROWSE-1grp.
     4602   end.
     4603   MAIN-BLOCK:
     4604   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4605      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4606     buf_price-list-type.name:resizable in browse BROWSE-1grp   = true .
     4607     buf_price-doc-forming.name:resizable in browse BROWSE-1grp   = true .
     4608     buf_price-doc-forming.name:read-only in browse BROWSE-1grp   = true .
     4609     frame Dialog-Frame:TITLE = ( if p-mode = "pl-type":U  then ("ДНЦ по ТИПУ прайс-листа № " + string( p-plt-id) + " БД " + string( p-plt-db-num))
     4610                                                           else "Документы назначения цены" ) +
     4611                                                           " Объект "  + p-obj-type + string(p-obj-code)
     4612                                                            .
     4613     v-title-0 = frame Dialog-Frame:TITLE .
     4614     R-status = 2.
     4615     run init-proc in this-procedure .
     4616     run my_en in this-procedure .
     4617     apply "VALUE-CHANGED" to BROWSE-1grp IN FRAME Dialog-Frame .
     4618     disable
     4619        B-sel      when LOOKUP ("b-sel":U,    p-bttns) = 0
     4620        B-add      when LOOKUP ("b-add":U,    p-bttns) = 0
     4621        b-copy     when LOOKUP ("b-add":U,    p-bttns) = 0
     4622        i-copy     when LOOKUP ("b-add":U,    p-bttns) = 0
     4623        B-chg      when LOOKUP ("b-chg":U,    p-bttns) = 0
     4624        B-del      when LOOKUP ("b-del":U,    p-bttns) = 0
     4625        B-del-pr   when LOOKUP ("b-del":U,    p-bttns) = 0
     4626        B-mark     when LOOKUP ("b-mark":U,   p-bttns) = 0
     4627       with frame Dialog-Frame .
     4628     hide B-del-pr in frame Dialog-Frame .
     4629     WAIT-FOR GO OF FRAME Dialog-Frame.
     4630   END.
     4631   run disable_ui in this-procedure .
     4632   PROCEDURE color-all :
     4633   define input  parameter p-color as integer   no-undo .
     4634     buf_price-doc-forming.pdf-id:fgcolor  in browse BROWSE-1grp =  p-color.
     4635     buf_price-doc-forming.name:fgcolor    in browse BROWSE-1grp =  p-color.
     4636   END PROCEDURE.
     4637   PROCEDURE disable_UI :
     4638     HIDE FRAME Dialog-Frame.
     4639   END PROCEDURE.
     4640   PROCEDURE enable_UI :
     4641     DISPLAY loc-pdf-id R-status T-paket FILL-IN-6 FILL-IN-1 v-user-name
     4642         WITH FRAME Dialog-Frame.
     4643     ENABLE B-Cancel B-mark B-sel B-add B-lkp B-chg B-del B-close B-ftpl B-sch
     4644            B-print B-history B-Help i-schTPL B-price-doc B-del-pr B-copy i-copy
     4645            loc-pdf-id R-status T-paket BROWSE-1grp b-lkp-pd B-print-pr
     4646            BROWSE-2-pr FILL-IN-6 FILL-IN-1 v-user-name
     4647         WITH FRAME Dialog-Frame.
     4648     VIEW FRAME Dialog-Frame.
     4649     OPEN QUERY BROWSE-1grp FOR     EACH buf_price-doc-forming WHERE     ( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) AND     ( p-mode <> "pl-type" OR (buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num))     USE-INDEX spis ,            FIRST buf_price-list-type  WHERE           buf_price-list-type.plt-id = buf_price-doc-forming.plt-id AND           buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num ,            FIRST x_grp-obj-price WHERE           x_grp-obj-price.gop-id    = buf_price-list-type.gop-id   AND           x_grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num .    OPEN QUERY BROWSE-2-pr FOR EACH buf_price-doc NO-LOCK WHERE       buf_price-doc.pdf-id = buf_price-doc-forming.pdf-id AND       buf_price-doc.pdf-db = buf_price-doc-forming.pdf-db AND       buf_price-doc.plt-id = buf_price-doc-forming.plt-id AND       buf_price-doc.plt-db-num = buf_price-doc-forming.plt-db-num INDEXED-REPOSITION.
     4650   END PROCEDURE.
     4651   PROCEDURE ini-flt-tpl :
