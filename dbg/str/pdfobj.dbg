     4775   PROCEDURE openbr :
     4776   define variable p-open-query       as logical no-undo init true .
     4777   define variable l-query-was-opened as logical no-undo .
     4778   define variable doc-rec  as recid     no-undo .
     4779   define variable p-find-next      as logical   no-undo .
     4780   define variable p-find-condition as character no-undo .
     4781   define variable sort-column-phrase as character no-undo .
     4782   case sort-column-name :
     4783     when "" then do:
     4784       assign
     4785         sort-column-phrase = ""
     4786       .
     4787     end.
     4788     otherwise do:
     4789       assign
     4790         sort-column-phrase = "by " + sort-column-name
     4791       .
     4792     end.
     4793   end case.
     4794   define variable title0 as character no-undo init "Список ДНЦ" .
     4795   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4796   define variable  l-disable-where-47  as logical   no-undo .
     4797   define variable  l-filter-open-47    as logical   .
     4798   define variable  flt-rec-47       as recid     no-undo .
     4799   define variable  filter-name-47      as character no-undo .
     4800   define variable  where-phrase-47     as character no-undo .
     4801   define variable  sort-phrase-47      as character no-undo .
     4802   define variable  where-phrase-rus-47 as character no-undo .
     4803   define variable  sort-phrase-rus-47  as character no-undo .
     4804     run waitfram-show in this-procedure
     4805       (input "ЖДИТЕ ..."
     4806       ).
     4807   run gbl/flt-get.p
     4808     (input filter-point
     4809     ,output flt-rec-47
     4810     ,output filter-name-47
     4811     ,output where-phrase-47
     4812     ,output sort-phrase-47
     4813     ,output where-phrase-rus-47
     4814     ,output sort-phrase-rus-47
     4815     ).
     4816   if p-open-query then do:
     4817       run set-filter-name in this-procedure
     4818         (INPUT filter-name-47
     4819         ) no-error .
     4820     assign
     4821       l-filter-open-47 = false
     4822     .
     4823     if flt-rec-47 <> ?
     4824       or sort-column-phrase > ""
     4825     then do:
     4826       define variable  parameter-2-47 as character no-undo .
     4827       define variable  parameter-3-47 as character no-undo .
     4828       define variable  parameter-4-47 as character no-undo .
     4829       define variable  parameter-5-47 as character no-undo .
     4830       define variable  parameter-6-47 as character no-undo .
     4831       define variable  parameter-7-47 as character no-undo .
     4832         assign
     4833         parameter-3-47 =
     4834                                 "FOR EACH buf_price-doc-forming"
     4835         parameter-4-47 =
     4836           (
     4837             if ("( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) and                  ( p-mode <> 'pl-type' OR                  ( buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num )) " + " " + where-phrase-47) <> ""
     4838             then  substitute('( &1 = 2 OR buf_price-doc-forming.stts =  &1 ) and                        ( &5&2&5 <> &5pl-type&5 OR                     ( buf_price-doc-forming.plt-id = &3 AND                        buf_price-doc-forming.plt-db-num = &4 )) ' ,                       r-status, p-mode, p-plt-id, p-plt-db-num , chr(34) )  + " " + where-phrase-47
     4839             else "true"
     4840           )
     4841         parameter-5-47 = (" " + " " + " " + substitute(' , FIRST buf_price-list-type  WHERE        buf_price-list-type.plt-id = buf_price-doc-forming.plt-id AND       buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num &1  , FIRST x_grp-obj-price WHERE        x_grp-obj-price.gop-id     = buf_price-list-type.gop-id   AND       x_grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num  &2' ,       v-where-phrase , v-sort-phrase ))
     4842         parameter-6-47 = if sort-phrase-47 = ''
     4843                              then
     4844           (
     4845           " " + "" +
     4846             " " + sort-column-phrase +
     4847           " " + " "
     4848           )
     4849                              else
     4850           (
     4851           " " + "" +
     4852             " " + sort-column-phrase +
     4853           " " + sort-phrase-47
     4854           )
     4855         parameter-7-47 =
     4856           "   "
     4857       .
     4858       do
     4859       on stop undo, leave
     4860       on error undo, leave
     4861       :
     4862         assign
     4863           l-disable-where-47 =
     4864             ("( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) and                  ( p-mode <> 'pl-type' OR                  ( buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num )) " + " " + where-phrase-47 = "")
     4865         .
     4866         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4867                             ,input query BROWSE-1grp:handle
     4868                             ,input parameter-3-47
     4869                             ,input parameter-4-47
     4870                             ,input parameter-5-47
     4871                             ,input parameter-6-47
     4872                             ,input parameter-7-47
     4873                             )
     4874         .
     4875         assign
     4876           l-filter-open-47 = true
     4877         .
     4878       end.
     4879       if l-filter-open-47 = false then do:
     4880         message
     4881           "Ошибка при фильтрации / сортировке" skip
     4882           "Будут показаны записи без учета фильтра" skip
     4883           view-as alert-box .
     4884       end.
     4885       else do:
     4886           assign
     4887             l-query-was-opened = true
     4888           .
     4889       end.
     4890     end.
     4891     if l-filter-open-47 = false then do:
     4892       OPEN QUERY BROWSE-1grp FOR EACH buf_price-doc-forming no-lock
     4893         where ( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) and                  ( p-mode <> 'pl-type' OR                  ( buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num ))
     4894       , FIRST buf_price-list-type  WHERE       buf_price-list-type.plt-id     = buf_price-doc-forming.plt-id AND         buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num , FIRST x_grp-obj-price WHERE        x_grp-obj-price.gop-id     = buf_price-list-type.gop-id   AND       x_grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num
     4895     .
     4896         assign
     4897           l-query-was-opened = true
     4898         .
     4899     end.
     4900   end.
     4901   else do:
     4902     assign
     4903       doc-rec = recid( buf_price-doc-forming )
     4904     .
     4905     do
     4906     on stop undo, leave
     4907     on error undo, leave
     4908     :
     4909       if query BROWSE-1grp:handle:get-buffer-handle(1) = (buffer buf_price-doc-forming:handle) then do:
     4910         assign
     4911         parameter-2-47 = (if p-find-next then "true":u else "false":u )
     4912         parameter-4-47 =
     4913           "where ":u +  substitute('( &1 = 2 OR buf_price-doc-forming.stts =  &1 ) and                        ( &5&2&5 <> &5pl-type&5 OR                     ( buf_price-doc-forming.plt-id = &3 AND                        buf_price-doc-forming.plt-db-num = &4 )) ' ,                       r-status, p-mode, p-plt-id, p-plt-db-num , chr(34) )  + " ":u + where-phrase-47 + " ":u + p-find-condition + " " + " "
     4914         parameter-5-47 = ""
     4915       .
     4916         run fltopend_fltfindd in this-procedure  (
     4917                             input this-procedure:handle
     4918                             ,input query BROWSE-1grp:handle
     4919                             ,input rowid(buf_price-doc-forming)
     4920                             ,input logical(parameter-2-47)
     4921                             ,input no-lock
     4922                             ,input (buffer buf_price-doc-forming:handle)
     4923                             ,input parameter-4-47
     4924                             ,input parameter-5-47
     4925                             ) no-error.
     4926         .
     4927         assign
     4928           doc-rec = integer(return-value)
     4929           v-fltopend-rowid[1] = ?
     4930         .
     4931       end.
     4932       else do:
     4933         assign
     4934         parameter-2-47 = (if p-find-next then "true":u else "false":u )
     4935         parameter-3-47 =  "FOR EACH buf_price-doc-forming"
     4936         parameter-4-47 =
     4937           (
     4938             if ("( r-status = 2 OR buf_price-doc-forming.stts =  r-status ) and                  ( p-mode <> 'pl-type' OR                  ( buf_price-doc-forming.plt-id = p-plt-id AND buf_price-doc-forming.plt-db-num = p-plt-db-num )) " + " " + where-phrase-47) <> ""
     4939             then  substitute('( &1 = 2 OR buf_price-doc-forming.stts =  &1 ) and                        ( &5&2&5 <> &5pl-type&5 OR                     ( buf_price-doc-forming.plt-id = &3 AND                        buf_price-doc-forming.plt-db-num = &4 )) ' ,                       r-status, p-mode, p-plt-id, p-plt-db-num , chr(34) )  + " " + where-phrase-47
     4940             else "true"
     4941           )
     4942         parameter-5-47 = (" " + " " + " " + substitute(' , FIRST buf_price-list-type  WHERE        buf_price-list-type.plt-id = buf_price-doc-forming.plt-id AND       buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num &1  , FIRST x_grp-obj-price WHERE        x_grp-obj-price.gop-id     = buf_price-list-type.gop-id   AND       x_grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num  &2' ,       v-where-phrase , v-sort-phrase ) + " " + p-find-condition)
     4943         parameter-6-47 = if sort-phrase-47 = ''
     4944                              then
     4945           (
     4946           " " + "" +
     4947             " " + sort-column-phrase +
     4948           " " + " "
     4949           )
     4950                              else
     4951           (
     4952           " " + "" +
     4953             " " + sort-column-phrase +
     4954           " " + sort-phrase-47
     4955           )
     4956         parameter-7-47 =
     4957           "   "
     4958       .
     4959         run fltopend_fltfindq in this-procedure  (
     4960                             input this-procedure:handle
     4961                             ,input query BROWSE-1grp:handle
     4962                             ,input logical(parameter-2-47)
     4963                             ,input no-lock
     4964                             ,input parameter-3-47
     4965                             ,input parameter-4-47
     4966                             ,input parameter-5-47
     4967                             ,input parameter-6-47
     4968                             ,input parameter-7-47
     4969                             ,output v-fltopend-rowid
     4970                             ) no-error.
     4971         .
     4972         doc-rec = ?.
     4973       end.
     4974       assign
     4975         l-query-was-opened = true
     4976       .
     4977     end.
     4978   end.
     4979     run waitfram-hide in this-procedure .
     4980   APPLY "VALUE-CHANGED" TO BROWSE-1grp in frame Dialog-Frame.
     4981   APPLY "ENTRY" TO BROWSE-1grp.
     4982   OPEN QUERY BROWSE-2-pr FOR EACH buf_price-doc NO-LOCK WHERE       buf_price-doc.pdf-id = buf_price-doc-forming.pdf-id AND       buf_price-doc.pdf-db = buf_price-doc-forming.pdf-db AND       buf_price-doc.plt-id = buf_price-doc-forming.plt-id AND       buf_price-doc.plt-db-num = buf_price-doc-forming.plt-db-num INDEXED-REPOSITION.
     4983   END PROCEDURE.
     4984   PROCEDURE seach-pdf-id :
     4985   define input  parameter p-id as INTEGER no-undo .
     4986   define input  parameter p-next as logical   no-undo .
     4987   if p-next = true then do:
     4988      find next buf_price-doc-forming no-lock where
     4989         buf_price-doc-forming.pdf-id     = p-id no-error .
     4990         if not available buf_price-doc-forming then do:
     4991           message "Еще запись не найдена ! " view-as alert-box information .
     4992           return .
     4993         end.
     4994   end.
     4995   else do:
     4996     find first buf_price-doc-forming no-lock where
     4997                buf_price-doc-forming.pdf-id     = p-id
     4998    no-error .
     4999                 if not available buf_price-doc-forming then do:
     5000                   message "Запись не найдена !" view-as alert-box information .
     5001                   return .
     5002                 end.
     5003   end.
     5004   reposition BROWSE-1grp to rowid rowid(buf_price-doc-forming) no-error .
     5005   apply "value-changed" to BROWSE-1grp in frame Dialog-Frame.
     5006   END PROCEDURE.
     5007   PROCEDURE set-filter-name :
     5008     define input parameter p-filter-name as character no-undo .
     5009     do with frame Dialog-Frame:
     5010       if p-filter-name > "" then do:
     5011         assign
     5012           frame Dialog-Frame:title
     5013             = v-title-0  + "   ФИЛЬТР: " + p-filter-name.
     5014         .
     5015         assign
     5016           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     5017         .
     5018       end.
     5019       else do:
     5020         assign
     5021           b-sch :TOOLTIP = ""
     5022           frame Dialog-Frame:title = v-title-0 .
     5023         .
     5024       end.
     5025     end.
     5026   END PROCEDURE.
