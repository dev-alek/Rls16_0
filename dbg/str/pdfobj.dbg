     1735     ,output v-host-code
     1736     )  .
     1737       v-obj-current-date  = today .
     1738       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
     1739           v-base-rate   =  buf_price-doc-forming.base-rate  .
