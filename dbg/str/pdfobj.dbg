     2579     define variable v-plt-db-num as integer   no-undo .
     2580     next-prev = false .
     2581   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2582   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run glstmain in g#library
     2583     (output v-only-main
     2584     )  .
     2585     if v-only-main = false then do:
     2586         run ref/l-tppr.p
     2587           ( input parParentProc,
     2588             input p-obj-type ,
     2589             input p-obj-code ,
     2590             input "b-sel" ,
     2591             output v-recid
     2592             ).
     2593         find first buf1_price-list-type no-lock where recid(buf1_price-list-type) = int(v-recid) no-error .
     2594     end.
     2595     else do:
     2596   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2597   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     2598     (input  parParentProc
     2599     ,input  v-cntxt-obj-type
     2600     ,input  v-cntxt-obj-code
     2601     ,input  no
     2602     ,output v-plt-id
     2603     ,output v-plt-db-num
     2604     ) no-error .
     2605        find first buf1_price-list-type no-lock where
     2606                   buf1_price-list-type.plt-id = v-plt-id and
     2607                   buf1_price-list-type.plt-db-num = v-plt-db-num
     2608                   no-error .
     2609     end.
     2610     if available buf1_price-list-type then do:
     2611         if buf1_price-list-type.stts <> integer('0':U) then do:
     2612            message "ДНЦ можно создать только с текущим типом прайс-листов !" view-as alert-box information  .
     2613            return .
     2614         end.
     2615         if buf1_price-list-type.under-type-list <> 0 then do:
     2616            message "Нельзя выбирать подчиненный прайс-лист !" view-as alert-box information  .
     2617            return .
     2618         end.
     2619         if buf1_price-list-type.gop-id = 0 then do:
     2620            message "Этот тип прайс-листа действует на ВСЕ объекты системы ."
     2621                    "Вы действительно хотите создать одинаковые цены на ВСЕХ объектах ? " view-as alert-box question
     2622                    buttons yes-no
     2623                    update v-okk as logical
     2624                    .
     2625            if v-okk = false then return .
     2626         end.
     2627         run str/df-price.w
     2628           ( input parparentproc,
     2629             input 'ДОБАВЛЕНИЕ':U ,
     2630             input buf1_price-list-type.plt-id,
     2631             input buf1_price-list-type.plt-db-num ,
     2632             input ? ,
     2633             output v-rec-list ,
     2634             input-output v-rec-id ,
     2635             input-output br-handle ,
     2636             input-output buffer-handle ,
     2637             input-output next-prev
     2638             ) .
     2639         run openbr in this-procedure .
     2640         reposition BROWSE-1grp to recid v-rec-id no-error .
     2641         apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
     2642       end.
     2643       else do:
     2644         message "Не выбран ТПЛ !!!" view-as alert-box .
     2645         return no-apply .
     2646       end.
     2647   END.
     2648   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     2649   DO:
