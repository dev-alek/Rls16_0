     4669     run fltfield-add in this-procedure('name'        , 'Название ТПЛ',   '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4670     run fltfield-add in this-procedure('stts'        , 'Статус',         '', input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
