     3448   .
     3449   procedure diasize_change-height :
     3450     define input  parameter p-change-value  as decimal   no-undo .
     3451     define input  parameter p-move-resize   as logical   no-undo .
     3452     define variable v-field-group-handle    as handle    no-undo .
     3453     define variable v-object-handle         as handle    no-undo .
     3454     define variable v-frame-height          as decimal   no-undo .
     3455     define variable v-frame-virtual-height  as decimal   no-undo .
     3456     define variable v-browse-height         as decimal   no-undo .
     3457     define variable v-window-height         as decimal   no-undo .
     3458     define variable v-window-virtual-height as decimal   no-undo .
     3459     define variable v-change-sign           as integer   no-undo .
     3460     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3461     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3462     if p-change-value > 0
     3463     then do:
