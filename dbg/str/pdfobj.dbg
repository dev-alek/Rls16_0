     3330   run minbtn-set in this-procedure .
     3331   on choose of b-help in frame Dialog-Frame
     3332   do:
     3333     apply "help":u to frame Dialog-Frame .
     3334   end.
     3335   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3336   procedure minbtn-set :
     3337       do
     3338           on error undo, return error return-value
     3339           :
     3340           define variable ii              as integer       no-undo .
     3341           define variable fh              as widget-handle no-undo .
     3342           define variable hh              as widget-handle no-undo .
     3343           define variable v-h             as handle        extent 4 no-undo .
     3344           define variable v-name-button   as character     no-undo .
     3345           define variable v-help-old-x    as decimal       no-undo .
     3346           define variable v-help-old-y    as decimal       no-undo .
     3347           define variable v-help-old-size as decimal       no-undo .
     3348           define variable v-frame-width   as decimal       no-undo .
     3349           define variable jj              as integer       no-undo .
     3350           do
     3351               on error undo, return error
     3352               :
     3353               assign
     3354                   v-frame-width = frame Dialog-Frame:width - 0.3
     3355                   fh            = frame Dialog-Frame:first-child
     3356                   hh            = fh:first-child
     3357                   ii            = 1
     3358                   .
     3359               do while valid-handle(hh):
     3360                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3361                   do:
     3362                       case lc(hh:name) :
     3363                           when "b-help" then
     3364                               do:
     3365                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3366                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3367                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3368                                   hh:TOOLTIP = "Помощь" .
     3369                                   v-help-old-x = hh:column .
     3370                                   v-help-old-y = hh:row    .
     3371                                   v-help-old-size = hh:width .
     3372                                   hh:width-chars = 2.5 .
     3373                               end.
     3374                           when "b-print" then
     3375                               do:
     3376                                   hh:load-image("cmp/b-print.bmp":u) .
     3377                                   hh:TOOLTIP = "Печать" .
     3378                                   v-h[ii] = hh:handle .
     3379                                   ii = ii + 1 .
     3380                                   hh:width-chars = 3 .
     3381                               end.
     3382                           when "b-history" or
     3383                           when "b-hist" then
     3384                               do:
     3385                                   hh:load-image("cmp/b-hist.bmp":u) .
     3386                                   hh:TOOLTIP = "История" .
     3387                                   v-h[ii] = hh:handle .
     3388                                   ii = ii + 1 .
     3389                                   hh:width-chars = 3 .
     3390                               end.
     3391                           when "b-sch" then
     3392                               do:
     3393                                   hh:load-image("cmp/b-sch.bmp":u) .
     3394                                   hh:TOOLTIP = "Установка Фильтра" .
     3395                                   v-h[ii] = hh:handle .
     3396                                   ii = ii + 1 .
     3397                                   hh:width-chars = 3 .
     3398                               end.
     3399                           when "b-hist-user" then
     3400                               do:
     3401                                   hh:load-image("cmp/b-hist.bmp":u) .
     3402                                   hh:TOOLTIP = "История пользователя" .
     3403                                   ii = ii + 1 .
     3404                               end.
     3405                       end case.
     3406                   end.
     3407                   hh = hh:next-sibling.
     3408               end.
     3409               b-help:column = v-frame-width - b-help:width-chars.
     3410               jj = 0.
     3411               repeat ii = 4 to 1 by -1 :
     3412                   if valid-handle (v-h[ii] ) then
     3413                   do:
     3414                       jj  = jj + 1 .
     3415                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3416                       v-h[ii]:row    = v-help-old-y .
     3417                   end.
     3418               end.
     3419           end.
     3420       end.
     3421   end procedure.
     3422   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3423   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3424   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3425   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3426   define variable v-diasize-current-frame-width  as decimal   no-undo .
