        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Выбор диапазонов сумм для почасового отчета по диапазонам сумм продаж ".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   define   shared variable g#auto as logical no-undo.
       68   define   shared variable g#news as logical no-undo.
       69   define   shared variable g#oxml as logical no-undo.
       70   define   shared variable g#esys as logical no-undo.
       71   define   shared variable g#news-source-db as integer no-undo.
       72   define   shared variable g#esys-source-esys as integer no-undo.
       73   define   shared variable g#db-num as integer   no-undo .
       74   define   shared variable g#userid as character no-undo .
       75   define   shared variable g#passwd as character no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      124   define variable par-type          as character no-undo.
      125   define variable v-value-character as character no-undo .
      126   define variable v-value-date      as date      no-undo .
      127   define variable v-value-decimal   as decimal   no-undo .
      128   define variable v-value-integer   as integer   no-undo .
      129   define variable v-value-logical   as logical   no-undo .
      130   DEFINE SHARED temp-table sum-vals no-undo
      131   field sum1   like ub.chk-doc.netto
      132   field sum2   like ub.chk-doc.netto
      133   field num-chk   like ub.inkas.num-chk extent 24
      134   field tot like ub.inkas.num-chk
      135   INDEX pi IS PRIMARY sum1 ASCENDING .
      136   define variable dops as character no-undo format "X(250)".
      137   define variable dopst as character no-undo format "X(1)".
      138   define variable sum-step as decimal no-undo.
      139   define variable sum-from as decimal no-undo.
      140   define variable sum-to as decimal no-undo.
      141   define variable sum-current as decimal no-undo.
      142   define variable idec  as decimal no-undo.
      143   DEFINE BUTTON B-help
      144        LABEL "Помо&щь"
      145        SIZE 10 BY 1.
      146   DEFINE BUTTON Btn-ALL
      147        LABEL "ВСЕ"
      148        SIZE 9.63 BY 1.08.
      149   DEFINE BUTTON BTN-delete-all
      150        LABEL "ВСЕ"
      151        SIZE 9.13 BY 1.
      152   DEFINE BUTTON BTN_Delete
      153        LABEL "Удалить"
      154        SIZE 9.5 BY 1.25.
      155   DEFINE BUTTON Btn_EXIT
      156        LABEL "Выход"
      157        SIZE 10 BY 1
      158        BGCOLOR 8 .
      159   DEFINE BUTTON BTN_Select
      160        LABEL "Выбрать"
      161        SIZE 9.5 BY 1.25.
      162   DEFINE VARIABLE SEL-0 AS CHARACTER
      163        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      164        LIST-ITEMS "0_10","10_20","20_30","30_40","40_50","50_60","60_70","70_80","80_90","90_100","100_150","150_200","200_300","300_400","400_500","500_1000","1000_1500","1500_2000","2000_3000","3000_4000","4000_5000","5000_7500","7500_10000","10000_10000000"
      165        SIZE 17 BY 7 TOOLTIP "Доступные диапазоны" NO-UNDO.
      166   DEFINE VARIABLE SEL-1 AS CHARACTER
      167        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      168        SIZE 17 BY 7 TOOLTIP "Выбранные диапазоны" NO-UNDO.
      169   DEFINE FRAME Dialog-Frame
      170        Btn_EXIT AT ROW 1 COL 1
      171        B-help AT ROW 1 COL 31
      172        SEL-0 AT ROW 2.96 COL 2.13 NO-LABEL
      173        SEL-1 AT ROW 3.04 COL 29.5 NO-LABEL
      174        BTN_Select AT ROW 10.79 COL 4.5
      175        BTN_Delete AT ROW 10.79 COL 33
      176        BTN-delete-all AT ROW 12.25 COL 33.25
      177        Btn-ALL AT ROW 12.29 COL 4.5
      178        SPACE(33.86) SKIP(0.16)
      179       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      180            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      181            TITLE "Выберите диапазоны"
      182            DEFAULT-BUTTON Btn_EXIT.
      183   ASSIGN
      184          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      185          FRAME Dialog-Frame:HIDDEN           = TRUE.
      186   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      187   DO:
      188     APPLY "END-ERROR":U TO SELF.
      189   END.
      190   ON CHOOSE OF Btn-ALL IN FRAME Dialog-Frame
      191   DO:
      192   define variable i as integer.
      193   define variable sum-1 like ub.chk-doc.netto.
      194   define variable sum-2 like ub.chk-doc.netto.
      195     do i = 1 to SEL-0:num-items:
      196         assign
      197         sum-1 = DEC(ENTRY(1,ENTRY(i,SEL-0:list-items),"_"))
      198         sum-2 = DEC(ENTRY(2,ENTRY(i,SEL-0:list-items),"_")).
      199         find first sum-vals where sum-vals.sum1 = sum-1 no-lock no-error.
      200         if not avail sum-vals then do:
      201             create sum-vals.
      202             assign sum1 = sum-1
      203                sum2 = sum-2.
      204             SEL-1:ADD-LAST(string(sum-1) + "_" + string(sum-2)).
      205         end.
      206     end.
      207     apply "entry" to sel-0.
      208   END.
      209   ON CHOOSE OF BTN-delete-all IN FRAME Dialog-Frame
      210   DO:
      211     define variable for_sums as character.
      212     define variable i as integer.
      213     define variable j as integer.
      214     j = SEL-1:num-items.
      215     do i = 1 to j:
      216         for_sums = ENTRY(1,Sel-1:LIST-ITEMS).
      217         SEL-1:DELETE(1).
      218         FIND FIRST sum-vals where sum1 = DEC(ENTRY(1,for_sums,"_")) NO-ERROR.
      219         IF AVAILABLE sum-vals then delete sum-vals.
      220       end.
      221   END.
      222   ON CHOOSE OF BTN_Delete IN FRAME Dialog-Frame
      223   DO:
      224     define variable for_sums as character.
      225     assign sel-1.
      226     for_sums = Sel-1.
      227     SEL-1:DELETE(for_sums).
      228     FIND FIRST sum-vals where sum1 = DEC(ENTRY(1,for_sums,"_")) NO-ERROR.
      229     IF AVAILABLE sum-vals then delete sum-vals.
      230     APPLY "ENTRY" to sel-1.
      231     APPLY "CURSOR-UP" to sel-1.
      232   END.
      233   ON CHOOSE OF BTN_Select IN FRAME Dialog-Frame
      234   DO:
      235     define variable for_sums as char.
      236     define variable sum-1 like ub.chk-doc.netto.
      237     define variable sum-2 like ub.chk-doc.netto.
      238     assign SEl-0.
      239     assign
      240     sum-1 = DEC(ENTRY(1,SEL-0,"_"))
      241     sum-2 = DEC(ENTRY(2,SEl-0,"_")).
      242     find first sum-vals where sum-vals.sum1 = sum-1 no-lock no-error.
      243     if available sum-vals then do:
      244       bell.
      245       message "Этот диапазон уже выбран" .
      246       apply "entry" to sel-0.
      247       return.
      248     end.
      249     create sum-vals.
      250     assign sum1 = sum-1
      251            sum2 = sum-2.
      252     SEL-1:ADD-LAST(SEl-0).
      253     apply "entry" to sel-0.
      254   END.
      255   ON LEFT-MOUSE-DBLCLICK OF SEL-0 IN FRAME Dialog-Frame
      256   DO:
      257        APPLY "CHOOSE" to Btn_select.
      258   END.
      259   ON DELETE-CHARACTER OF SEL-1 IN FRAME Dialog-Frame
      260   DO:
      261     APPLY "CHOOSE" to BTN_Delete.
      262   END.
      263   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      264   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      265   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266   on help of frame Dialog-Frame
      267   do:
      268     run gbl/app_help.p
      269       (input this-procedure :file-name
      270       ,input ''
      271       ,input ?
      272       ) no-error.
      273     if error-status :error then do:
      274       message
      275         "Ошибка при вызове помощи"
      276         error-status :get-message(1)
      277         view-as alert-box .
      278     end.
      279   end.
      280   run minbtn-set in this-procedure .
      281   on choose of b-help in frame Dialog-Frame
      282   do:
      283     apply "help":u to frame Dialog-Frame .
      284   end.
      285   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      286   procedure minbtn-set :
      287       do
      288           on error undo, return error return-value
      289           :
      290           define variable ii              as integer       no-undo .
      291           define variable fh              as widget-handle no-undo .
      292           define variable hh              as widget-handle no-undo .
      293           define variable v-h             as handle        extent 4 no-undo .
      294           define variable v-name-button   as character     no-undo .
      295           define variable v-help-old-x    as decimal       no-undo .
      296           define variable v-help-old-y    as decimal       no-undo .
      297           define variable v-help-old-size as decimal       no-undo .
      298           define variable v-frame-width   as decimal       no-undo .
      299           define variable jj              as integer       no-undo .
      300           do
      301               on error undo, return error
      302               :
      303               assign
      304                   v-frame-width = frame Dialog-Frame:width - 0.3
      305                   fh            = frame Dialog-Frame:first-child
      306                   hh            = fh:first-child
      307                   ii            = 1
      308                   .
      309               do while valid-handle(hh):
      310                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      311                   do:
      312                       case lc(hh:name) :
      313                           when "b-help" then
      314                               do:
      315                                   hh:load-image-up("cmp/b-help.bmp":u) .
      316                                   hh:load-image-down("cmp/b-help.bmp":u) .
      317                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      318                                   hh:TOOLTIP = "Помощь" .
      319                                   v-help-old-x = hh:column .
      320                                   v-help-old-y = hh:row    .
      321                                   v-help-old-size = hh:width .
      322                                   hh:width-chars = 2.5 .
      323                               end.
      324                           when "b-print" then
      325                               do:
      326                                   hh:load-image("cmp/b-print.bmp":u) .
      327                                   hh:TOOLTIP = "Печать" .
      328                                   v-h[ii] = hh:handle .
      329                                   ii = ii + 1 .
      330                                   hh:width-chars = 3 .
      331                               end.
      332                           when "b-history" or
      333                           when "b-hist" then
      334                               do:
      335                                   hh:load-image("cmp/b-hist.bmp":u) .
      336                                   hh:TOOLTIP = "История" .
      337                                   v-h[ii] = hh:handle .
      338                                   ii = ii + 1 .
      339                                   hh:width-chars = 3 .
      340                               end.
      341                           when "b-sch" then
      342                               do:
      343                                   hh:load-image("cmp/b-sch.bmp":u) .
      344                                   hh:TOOLTIP = "Установка Фильтра" .
      345                                   v-h[ii] = hh:handle .
      346                                   ii = ii + 1 .
      347                                   hh:width-chars = 3 .
      348                               end.
      349                           when "b-hist-user" then
      350                               do:
      351                                   hh:load-image("cmp/b-hist.bmp":u) .
      352                                   hh:TOOLTIP = "История пользователя" .
      353                                   ii = ii + 1 .
      354                               end.
      355                       end case.
      356                   end.
      357                   hh = hh:next-sibling.
      358               end.
      359               b-help:column = v-frame-width - b-help:width-chars.
      360               jj = 0.
      361               repeat ii = 4 to 1 by -1 :
      362                   if valid-handle (v-h[ii] ) then
      363                   do:
      364                       jj  = jj + 1 .
      365                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      366                       v-h[ii]:row    = v-help-old-y .
      367                   end.
      368               end.
      369           end.
      370       end.
      371   end procedure.
      372   MAIN-BLOCK:
      373   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      374      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      375   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   empty temp-table thbjattr_thbj-attr.
      377   run adm/shattri.p (
      378      input "get":U
      379     ,input ''
      380     ,input 0
      381     ,input 'report-glob':U
      382     ,input  ""
      383     ,output v-value-character
      384     ,output v-value-date
      385     ,output v-value-decimal
      386     ,output v-value-integer
      387     ,output v-value-logical
      388     ,output par-type
      389     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      390     ) no-error .
      391     for each thbjattr_thbj-attr :
      392       if thbjattr_thbj-attr.prop-code = 'sumvals':U  then  dops = thbjattr_thbj-attr.property-value-character.
      393       if thbjattr_thbj-attr.prop-code = 'sum-step':U then  sum-step = thbjattr_thbj-attr.property-value-decimal .
      394       if thbjattr_thbj-attr.prop-code = 'sum-from':U then  sum-from = thbjattr_thbj-attr.property-value-decimal .
      395       if thbjattr_thbj-attr.prop-code = 'sum-to':U   then  sum-to = thbjattr_thbj-attr.property-value-decimal .
      396     end.
      397     IF dops <> "" and dops <> ? and dops <> "0" then
      398     sel-0:list-items = dops.
      399     else do:
      400       assign
      401       sum-current = sum-from
      402       sel-0:list-items = "".
      403       DO while sum-current < sum-to:
      404             SEL-0:ADD-LAST(string(sum-current) + "_" + string(sum-current + sum-step)).
      405           assign
      406           sum-current = sum-current + sum-step.
      407       end.
      408     end.
      409     RUN enable_UI.
      410     for each sum-vals no-lock:
      411       sel-1:add-last(string(sum-vals.sum1) + "_" + string(sum-vals.sum2)).
      412     end.
      413     WAIT-FOR CHOOSE OF BTN_exit.
      414   END.
      415   RUN disable_UI.
      416   PROCEDURE disable_UI :
      417     HIDE FRAME Dialog-Frame.
      418   END PROCEDURE.
      419   PROCEDURE enable_UI :
      420     DISPLAY SEL-0 SEL-1
      421         WITH FRAME Dialog-Frame.
      422     ENABLE Btn_EXIT B-help SEL-0 SEL-1 BTN_Select BTN_Delete BTN-delete-all
      423            Btn-ALL
      424         WITH FRAME Dialog-Frame.
      425     VIEW FRAME Dialog-Frame.
      426   END PROCEDURE.
