      137   procedure alienini-getkey :
      138   define input parameter i-filename as char.
      139   define input parameter i-section as char.
      140   define input parameter i-key as char.
      141   define output parameter o-value as char.
      142   define variable EntryPointer as integer no-undo.
      143   define variable mem1 as memptr no-undo.
      144   define variable mem2 as memptr no-undo.
      145   define variable mem1size as integer no-undo.
      146   define variable mem2size as integer no-undo.
      147   define variable ii       as integer    no-undo.
      148   define variable cbReturnSize  as integer    no-undo.
      149   assign
      150   set-size(mem1)  = 4000
      151   mem1size = 4000.
      152   if i-key = "" then EntryPointer = 0.
      153   else do:
      154     assign
      155     set-size(mem2) = 128
      156     mem2size = 128
      157     EntryPointer = get-pointer-value(mem2)
      158     put-string(mem2, 1) = i-key.
      159   end.
      160   run getprivateprofilestringA
      161                                 (i-section,
      162                                  EntryPointer,
      163                                  "",
      164                                  get-pointer-value(mem1),
      165                                  input mem1size,
      166                                  i-filename,
      167                                  output cbReturnSize).
      168   do ii = 1 to cbReturnSize:
      169     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
      170                  then o-value + ","
      171                  else o-value + chr(get-byte(mem1, ii)).
      172   end.
      173     set-size(mem1) = 0.
      174     set-size(mem2) = 0.
      175   end procedure.
      176   procedure alienini-putkey :
      177   define input parameter i-filename as char.
      178   define input parameter i-section as char.
      179   define input parameter i-key as char.
      180   define input parameter i-value as char.
      181   define variable cbReturnSize as integer.
      182   run writeprivateprofilestringA
      183                                  (i-section,
      184                                   i-key,
      185                                   i-value,
      186                                   i-filename,
      187                                   output cbReturnSize ).
      188   end procedure.
      189   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
      190     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
      191     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
      192     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
      193     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
      194     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
      195     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
      196     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
      197   END PROCEDURE.
      198   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
      199     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
      200     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
      201     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
      202     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
      203     DEFINE RETURN PARAMETER lpszValue    AS LONG.
      204   END PROCEDURE.
