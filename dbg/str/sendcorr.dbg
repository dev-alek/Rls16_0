      264   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
      265   define variable v-is-closed-shift-journal as integer no-undo .
      266   assign
      267   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
      268                               +
      269                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
      270                               +
      271                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
      272   .
      273   return v-is-closed-shift-journal.
      274   END FUNCTION.
      275   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
      276   define variable v-is-first-journal as logical no-undo .
      277   assign
      278   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
      279                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
      280                     or (p-journal-num =  integer(entry(1, '17':U)))
      281                     or (p-journal-num = integer(entry(1, '16':U)))
      282   .
      283   return v-is-first-journal.
      284   END FUNCTION.
      285   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
      286   define variable v-is-petrol-journal as logical no-undo .
      287   assign
      288   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
      289   return v-is-petrol-journal.
      290   END FUNCTION.
      291   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
      292   define variable v-max-record-num as integer no-undo .
      293   assign
      294   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      295                       then 1489
      296                       else 2340).
      297   return v-max-record-num.
      298   END FUNCTION.
      299   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
      300   define variable v-max-record-num as integer no-undo .
      301   assign
      302   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
      303                       then 1489 * num-entries('30,31,32,33':U)
      304                       else 2340 * num-entries('17':U)).
      305   return v-max-record-num.
      306   END FUNCTION.
      307   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
      308                                           ,input p-rec-no as integer):
      309   define variable v-num-recs as integer no-undo .
      310   if tekka-is-petrol-journal (p-journal-num) then do:
      311     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
      312       assign
      313       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
      314       .
      315     end.
      316     else do:
      317       assign
      318       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
      319       .
      320     end.
      321   end.
      322   else do:
      323     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
      324       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      325         assign
      326         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
      327         .
      328       end.
      329       else do:
      330         assign
      331         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
      332         .
      333       end.
      334     end.
      335     else do:
      336       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
      337         assign
      338         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
      339         .
      340       end.
      341       else do:
      342         assign
      343         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
      344         .
      345       end.
      346     end.
      347   end.
      348   return v-num-recs.
      349   END FUNCTION.
      350   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
      351                                              ,input p-is-petrol as logical
      352                                              ,input p-is-current as logical
      353                                              ,output p-rec-no as decimal
      354                                              ):
      355   define variable v-obj-num0 as integer no-undo .
      356   define variable v-obj-num as integer no-undo .
      357   define variable v-obj-num2 as integer no-undo .
      358   define variable p-num-recs2 as integer no-undo .
      359   define variable p-rec-no2 as integer no-undo .
      360   if p-is-petrol then do:
      361     assign
      362     v-obj-num0 = trunc(p-num-recs / 1489, 0)
      363     .
      364     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
      365     then
      366     assign
      367     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
      368     p-rec-no = p-num-recs modulo 1489
      369     .
      370     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
      371     then
      372     assign
      373     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
      374     p-rec-no = p-num-recs modulo 1489
      375     .
      376   end.
      377   else do:
      378     assign
      379     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
      380     p-num-recs = trunc(p-num-recs, 0)
      381     v-obj-num0 = trunc(p-num-recs / 2340, 0)
      382     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
      383     .
      384     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
      385     then
      386     assign
      387     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
      388     p-rec-no = p-num-recs modulo 2340
      389     .
      390     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
      391     then
      392     assign
      393     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
      394     p-rec-no = p-num-recs modulo 2340
      395     .
      396     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
      397     then
      398     assign
      399     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
      400     p-rec-no2 = p-num-recs2 modulo 2978
      401     .
      402     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
      403     then
      404     assign
      405     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
      406     p-rec-no2 = p-num-recs2 modulo 2978
      407     .
      408     assign
      409     p-rec-no = p-rec-no + p-rec-no2 / 10000
      410     .
      411   end.
      412   if v-obj-num = 0 then v-obj-num = 100.
      413   return v-obj-num.
      414   END FUNCTION.
      415   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
      416   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
      417   if lookup (string(p-obj-num), '17':U) > 0 then do:
      418      if p-is-ptrl then
      419      return integer(entry(1, '26,27,28,29':U)).
      420      if not p-is-ptrl then
      421      return integer(entry(1, '16':U)).
      422   end.
      423   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      424   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      425   return 0.
      426   END FUNCTION.
      427   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
      428   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
      429   if lookup (string(p-obj-num), '17':U) > 0 then do:
      430     if p-is-ptrl then
      431     return integer(entry(1, '26,27,28,29':U)).
      432     if not p-is-ptrl then
      433     return integer(entry(1, '16':U)).
      434   end.
      435   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
      436   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
      437   return 0.
      438   END FUNCTION.
      439   PROCEDURE maria-put:
      440   define parameter buffer buf_cash-desk for ub.cash-desk.
      441   define input parameter p-out    as character no-undo .
      442   define input parameter p-fname as character no-undo .
      443   define input parameter p-by-record as logical no-undo .
      444   define input parameter p-shift-fields as integer no-undo .
      445   define input parameter p-binary as logical no-undo .
      446   define input parameter p-obj-num as integer no-undo .
      447   define input parameter p-max-records as integer no-undo .
      448   define input parameter p-plu as integer no-undo .
      449   define input parameter p-value as character no-undo .
      450   define variable v-file-name as character no-undo .
      451   define variable v-create as logical no-undo .
      452   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      453   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
      454   output stream IBMSTREAM
      455   to value(v-file-name) append .
      456   Put  stream IBMSTREAM unformatted
      457   p-plu
      458   chr(3)
      459   p-value
      460   skip.
      461   output stream IBMSTREAM
      462   close.
      463   if not p-by-record then do:
      464     find first buf_temp-tekka-tsk where
      465               buf_temp-tekka-tsk.filename  = v-file-name no-error .
      466     if not available buf_temp-tekka-tsk then do:
      467       v-create = yes.
      468     end.
      469   end.
      470   else do:
      471     find first buf_temp-tekka-tsk where
      472               buf_temp-tekka-tsk.filename  = v-file-name
      473           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
      474     if not available buf_temp-tekka-tsk
      475     then do:
      476       find first buf_temp-tekka-tsk where
      477                 buf_temp-tekka-tsk.filename  = v-file-name
      478             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
      479       if not available buf_temp-tekka-tsk
      480       then do:
      481         v-create = yes.
      482       end.
      483     end.
      484   end.
      485   if v-create then do:
      486     create buf_temp-tekka-tsk.
      487     assign
      488     buf_temp-tekka-tsk.filename = v-file-name
      489     buf_temp-tekka-tsk.range    = p-plu
      490     buf_temp-tekka-tsk.obj-num = p-obj-num
      491     buf_temp-tekka-tsk.obj-name = '':U
      492     buf_temp-tekka-tsk.num-records = 0
      493     buf_temp-tekka-tsk.max-records = p-max-records
      494     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
      495     buf_temp-tekka-tsk.task-num = p-fname
      496     buf_temp-tekka-tsk.by-record = p-by-record
      497     buf_temp-tekka-tsk.shift-fields = p-shift-fields
      498     buf_temp-tekka-tsk.binary = p-binary
      499     buf_temp-tekka-tsk.send-get = 'send'
      500     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      501     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      502     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      503     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      504                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      505                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      506                                 then 'local'
      507                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      508     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      509     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      510     buf_temp-tekka-tsk.waiting-sek = 30
      511     buf_temp-tekka-tsk.min-plu     = p-plu
      512     buf_temp-tekka-tsk.max-plu     = p-plu
      513     .
      514   end.
      515   assign
      516   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
      517   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
      518   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
      519   .
      520   END PROCEDURE.
      521   PROCEDURE maria-get:
      522   define parameter buffer buf_cash-desk for ub.cash-desk.
      523   define input parameter p-out    as character no-undo .
      524   define input parameter p-fname as character no-undo .
      525   define input parameter p-by-record as logical no-undo .
      526   define input parameter p-obj-num as integer no-undo .
      527   define input parameter p-num-fields as integer no-undo .
      528   define input parameter p-max-records as integer no-undo .
      529   define input parameter p-min-plu as integer no-undo .
      530   define input parameter p-max-plu as integer no-undo .
      531   define input parameter p-other as character no-undo .
      532   define input parameter p-order-num as integer no-undo .
      533   define variable v-file-name as character no-undo .
      534   define variable v-secondary-obj-num as character no-undo .
      535   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      536   if p-by-record then do:
      537     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
      538   end.
      539   else do:
      540     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
      541   end.
      542   find first buf_temp-tekka-tsk where
      543             buf_temp-tekka-tsk.filename  = v-file-name no-error .
      544   if not available buf_temp-tekka-tsk then do:
      545     create buf_temp-tekka-tsk.
      546     assign
      547     buf_temp-tekka-tsk.filename = v-file-name
      548     buf_temp-tekka-tsk.obj-num = p-obj-num
      549     buf_temp-tekka-tsk.obj-name = '':U
      550     buf_temp-tekka-tsk.max-records = p-max-records
      551     buf_temp-tekka-tsk.num-fields = p-num-fields
      552     buf_temp-tekka-tsk.task-num = p-fname
      553     buf_temp-tekka-tsk.by-record = p-by-record
      554     buf_temp-tekka-tsk.send-get = 'get'
      555     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      556     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      557     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      558     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      559                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      560                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      561                                   then 'local'
      562                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      563     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      564     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      565     buf_temp-tekka-tsk.waiting-sek = 30
      566     buf_temp-tekka-tsk.min-plu     = p-min-plu
      567     buf_temp-tekka-tsk.max-plu     = p-max-plu
      568     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
      569                                       and p-max-plu <> ?
      570                                       then p-max-plu - p-min-plu + 1
      571                                       else 0)
      572     buf_temp-tekka-tsk.other-info = p-other
      573     buf_temp-tekka-tsk.order-num = p-order-num
      574     .
      575     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
      576       assign
      577       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
      578       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
      579       v-secondary-obj-num = entry(1, v-secondary-obj-num)
      580       no-error
      581       .
      582       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
      583     end.
      584   end.
      585   END PROCEDURE.
      586   PROCEDURE maria-task:
      587   define parameter buffer buf_cash-desk for ub.cash-desk.
      588   define input parameter p-fname as character no-undo .
      589   define input parameter p-obj-num-list as character no-undo .
      590   define input parameter p-parameters as character no-undo .
      591   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
      592   find first buf_temp-tekka-tsk where
      593             buf_temp-tekka-tsk.task-num  = p-fname no-error .
      594   if not available buf_temp-tekka-tsk then do:
      595     create buf_temp-tekka-tsk.
      596     assign
      597     buf_temp-tekka-tsk.filename = ''
      598     buf_temp-tekka-tsk.range = 1
      599     buf_temp-tekka-tsk.obj-num = 0
      600     buf_temp-tekka-tsk.obj-name = p-obj-num-list
      601     buf_temp-tekka-tsk.task-num = p-fname
      602     buf_temp-tekka-tsk.by-record = no
      603     buf_temp-tekka-tsk.send-get = 'task'
      604     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
      605     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
      606     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
      607     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
      608                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
      609                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
      610                                   then 'local'
      611                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
      612     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
      613     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
      614     buf_temp-tekka-tsk.waiting-sek = 30
      615     buf_temp-tekka-tsk.other-info = p-parameters
      616     buf_temp-tekka-tsk.order-num = 0
      617     .
      618   end.
      619   END PROCEDURE.
      620   procedure tekkatsk-verify-schema :
      621   define input parameter p-obj-list as character no-undo .
      622   define input parameter p-dir-path as character no-undo .
      623   define variable v-obj-num as integer no-undo .
      624   define variable v-obj-name as character no-undo .
      625   define variable v-num-records as integer no-undo .
      626   define variable v-size_ as integer no-undo .
      627   define variable v-value as character no-undo .
      628   define variable ii as integer no-undo .
      629   define variable jj as integer no-undo .
      630   define variable ii-ibs as integer no-undo .
      631   define variable ii-tekka as integer no-undo .
      632   define variable v-result as character no-undo .
      633   define buffer buf_temp-tekka-schema for temp-tekka-schema.
      634   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
      635     do
      636     on error undo, return error
      637     :
      638        for each buf_temp-tekka-schema:
      639          delete buf_temp-tekka-schema.
      640        end.
      641        input from value('tekkasch.d').
      642        repeat :
      643          create buf_temp-tekka-schema.
      644          import buf_temp-tekka-schema.
      645          assign
      646          buf_temp-tekka-schema.host = 'IBS'
      647          ii = ii + 1.
      648          .
      649        end.
      650        input close.
      651        ii-ibs = ii.
      652         _ii:
      653         do ii = 1 to 256:
      654           if p-obj-list = "ALL"
      655           or lookup(string(ii), p-obj-list) > 0 then do:
      656             assign
      657             v-obj-num = 0
      658             v-obj-name = ''
      659             v-num-records = 0
      660             v-size_ = 0
      661             .
      662             run alienini-getkey in this-procedure (
      663                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      664                                                     ,input ('obj' + string(ii, '999'))
      665                                                     ,input 'oname'
      666                                                     ,output v-value) no-error .
      667             if v-value = ? then next _ii.
      668             assign
      669             v-obj-num = ii
      670             v-obj-name = v-value
      671             .
      672             run alienini-getkey in this-procedure (
      673                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      674                                                     ,input ('obj' + string(ii, '999'))
      675                                                     ,input 'size'
      676                                                     ,output v-value) no-error .
      677             assign
      678             v-num-records = integer(v-value) no-error  .
      679             if error-status:error
      680             or v-num-records = 0 then next _ii.
      681             run alienini-getkey in this-procedure (
      682                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      683                                                     ,input 'obj' + string(ii, '999')
      684                                                     ,input 'f000'
      685                                                     ,output v-value) no-error .
      686             assign
      687             v-size_ = integer(v-value) no-error  .
      688             if error-status:error
      689             or v-size_ = 0 then next _ii.
      690             _jj:
      691             do jj = 1 to 256:
      692               run alienini-getkey in this-procedure (
      693                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      694                                                       ,input 'obj' + string(ii, '999')
      695                                                       ,input 'f' + string(jj, '999')
      696                                                       ,output v-value) no-error .
      697               if v-value = ? then next _ii.
      698               create buf_temp-tekka-schema.
      699               assign
      700               buf_temp-tekka-schema.host = 'tekka'
      701               buf_temp-tekka-schema.obj-num = v-obj-num
      702               buf_temp-tekka-schema.obj-name = v-obj-name
      703               buf_temp-tekka-schema.num-records = v-num-records
      704               buf_temp-tekka-schema.size_ = v-size_
      705               buf_temp-tekka-schema.field-num = jj
      706               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
      707               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
      708                                                  then entry(2, entry(2, v-value, '#'), ':')
      709                                                  else '':U)
      710               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
      711               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
      712               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
      713                                                           , 'C,I,I,I,D,D,D,D,D':U)
      714               no-error
      715               .
      716               if error-status:error then do:
      717                 delete buf_temp-tekka-schema.
      718                 next _jj.
      719               end.
      720               run alienini-getkey in this-procedure (
      721                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
      722                                                       ,input 'obj' + string(ii, '999') + 'name'
      723                                                       ,input 'n' + string(jj, '999')
      724                                                       ,output v-value) no-error .
      725               if v-value <> ? then
      726               buf_temp-tekka-schema.field-name = v-value.
      727             end.
      728           end.
      729         end.
      730         ii-tekka = ii - 1.
      731        if p-obj-list <> 'ALL' then do:
      732         if ii-tekka <> ii-ibs then do:
      733           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
      734                                   , ii-ibs
      735                                   , ii-tekka).
      736         end.
      737        end.
      738        for each buf_temp-tekka-schema where
      739               buf_temp-tekka-schema.host = 'tekka':
      740          find first buf2_temp-tekka-schema where
      741                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
      742                AND buf2_temp-tekka-schema.host = 'ibs'
      743                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
      744          if not available buf2_temp-tekka-schema then do:
      745           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
      746                                   , buf_temp-tekka-schema.field-num
      747                                   , buf_temp-tekka-schema.obj-num).
      748          end.
      749          buffer-compare buf_temp-tekka-schema
      750          to buf2_temp-tekka-schema
      751          save result in v-result.
      752          if v-result <> '':U then do:
      753           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
      754                                   , buf_temp-tekka-schema.field-num
      755                                   , buf_temp-tekka-schema.obj-num).
      756          end.
      757        end.
      758     end.
      759   end procedure.
      760   FUNCTION set-Sx returns character (input p-string as character):
      761   return p-string.
      762   END FUNCTION.
      763   FUNCTION get-Sx returns character (input p-string  as character):
      764   return p-string.
      765   END FUNCTION.
      766   FUNCTION set-B returns character (input p-string  as character):
      767   return chr(integer(p-string)).
      768   END FUNCTION.
      769   FUNCTION get-B returns character (input p-string  as character):
      770   return string(asc(p-string)).
      771   END FUNCTION.
      772   FUNCTION set-BF returns character (input p-string  as character):
      773   define variable v-dopi as integer no-undo .
      774   define variable ii as integer no-undo .
      775   do ii = 1 to 8:
      776     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      777   end.
      778   return chr(v-dopi).
      779   END FUNCTION.
      780   FUNCTION get-BF returns character (input p-string  as character):
      781   define variable v-dopi as integer no-undo .
      782   define variable v-dops as character no-undo .
      783   define variable ii as integer no-undo .
      784   v-dopi = asc(p-string).
      785   do ii = 8 to 1 BY -1:
      786     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      787   end.
      788   return v-dops.
      789   END FUNCTION.
      790   FUNCTION set-BN returns character (input p-string  as character
      791                                     ,input p-bin-group as character):
      792   define variable v-dopi as integer no-undo .
      793   define variable ii as integer no-undo .
      794   define variable jj as integer no-undo .
      795   define variable v-grp-nums as integer no-undo .
      796   define variable v-dopi2 as integer no-undo .
      797   v-grp-nums = num-entries(p-bin-group).
      798   do jj = 0 to v-grp-nums - 1:
      799     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
      800     do ii = 1 to 8:
      801       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
      802     end.
      803   end.
      804   return chr(v-dopi).
      805   END FUNCTION.
      806   FUNCTION get-BN returns character (input p-string  as character
      807                                     ,input p-bin-group as character):
      808   define variable v-dopi as integer no-undo .
      809   define variable v-dops as character no-undo .
      810   define variable v-grp-nums as integer no-undo .
      811   define variable ii as integer no-undo .
      812   define variable jj as integer no-undo .
      813   v-dopi = asc(p-string).
      814   v-grp-nums = num-entries(p-bin-group).
      815   do jj = 1 to v-grp-nums:
      816   do ii = 8 to 1 BY -1:
      817     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
      818   end.
      819   end.
      820   return v-dops.
      821   END FUNCTION.
      822   procedure fill-temp-cd :
      823   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
      824   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      825   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      826   define input parameter p-clear-table as logical no-undo .
      827   define buffer buf_temp-cd for temp-cd.
      828   define buffer buf_cash-desk for ub.cash-desk.
      829     do
      830     on error undo, return error
      831     :
      832        if p-clear-table  then do:
      833          for each buf_temp-cd:
      834            delete buf_temp-cd.
      835          end.
      836        end.
      837        for each buf_cash-desk no-lock where
      838               buf_cash-desk.db-num = p-db-num
      839           AND buf_cash-desk.obj-code = p-obj-code
      840           and buf_cash-desk.cash-on  = yes
      841        BREAK by buf_cash-desk.pos-type:
      842          if first-of(buf_cash-desk.pos-type) then do:
      843            create buf_temp-cd.
      844            buffer-copy buf_cash-desk to buf_temp-cd.
      845          end.
      846        end.
      847     end.
      848   end procedure.
      849   define variable vss-include-info5 as character format "X(65)" no-undo
      850   initial "@(#)$Workfile$ $Revision$".
      851   define variable v-bgelib-bgefmt        as character         no-undo.
      852   define variable v-bgelib-bgeflold      as character         no-undo.
      853   define stream stmXMLOut.
      854   define stream stmXMLLog.
      855   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      856   procedure cur-time :
      857      define output parameter p-today as date      no-undo .
      858      define output parameter p-time  as integer   no-undo .
      859     do
      860     on error undo, return error
      861     :
      862       define variable v-date1 as date      no-undo .
      863       define variable v-date2 as date      no-undo .
      864       define variable v-time  as integer   no-undo .
      865       assign
      866         v-date1 = today
      867         v-time  = time
      868         v-date2 = today
      869       .
      870       if v-date1 <> v-date2
      871       then do:
      872         assign
      873           v-date1 = today
      874           v-time  = v-time
      875         .
      876       end.
      877       assign
      878         p-today = v-date1
      879         p-time  = v-time
      880       .
      881     end.
      882   end.
      883   function cur-time-date returns character
      884   :
      885     return string(today, '99/99/9999':U) .
      886   end.
      887   function cur-time-mjd returns decimal
      888   :
      889     define variable v-date as date      no-undo .
      890     define variable v-time as integer   no-undo .
      891     run cur-time in this-procedure
      892       (output v-date
      893       ,output v-time
      894       ) .
      895     return integer(v-date) - 2400002 + (v-time / 86400) .
      896   end.
      897   function cur-time-get-ending-index returns integer
      898   (input p-number as integer
      899   )
      900   :
      901     if p-number < 0
      902     or p-number = ?
      903     then do:
      904       return 1 .
      905     end.
      906     define variable v-rest as integer   no-undo .
      907     assign
      908       p-number = p-number modulo 100
      909     .
      910     if p-number < 20
      911     then do:
      912       assign
      913         v-rest = p-number
      914       .
      915     end.
      916     else do:
      917       assign
      918         v-rest = p-number modulo 10
      919       .
      920     end.
      921     case v-rest :
      922       when 1
      923       then do:
      924         return 2 .
      925       end.
      926       when 2 or
      927       when 3 or
      928       when 4
      929       then do:
      930         return 3 .
      931       end.
      932       otherwise do:
      933         return 1 .
      934       end.
      935     end case .
      936   end.
      937   procedure cur-time-mjd-to-date :
      938      define input  parameter i-mjd-diff as decimal no-undo.
      939      define output parameter o-Date     as date    no-undo.
      940      define output parameter o-Time     as integer no-undo.
      941      define variable v-day-number as integer   no-undo .
      942      if    i-mjd-diff < 0
      943         or i-mjd-diff = ?
      944      then do:
      945         return "?" .
      946      end.
      947      assign
      948         v-day-number = truncate(i-mjd-diff,0).
      949         o-Date = date(v-day-number + 2400002).
      950         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      951     .
      952   end.
      953   function cur-time-mjd-to-string returns character
      954   (input p-mjd-diff as decimal
      955   )
      956   :
      957     define variable v-day-number as integer   no-undo .
      958     define variable v-seconds    as integer   no-undo .
      959     define variable v-hour       as integer   no-undo .
      960     define variable v-min        as integer   no-undo .
      961     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      962     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      963     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      964     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      965     if p-mjd-diff < 0
      966     or p-mjd-diff = ?
      967     then do:
      968       return "?" .
      969     end.
      970     assign
      971       v-day-number = integer(truncate(p-mjd-diff,0))
      972       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      973     .
      974     if v-seconds > 86400
      975     then do:
      976       assign
      977         v-seconds = 86400 - 1
      978       .
      979     end.
      980     if v-seconds < 0
      981     then do:
      982       assign
      983         v-seconds = 0
      984       .
      985     end.
      986     assign
      987       v-hour = truncate(v-seconds / 3600, 0)
      988     .
      989     assign
      990       v-seconds = v-seconds modulo 3600
      991     .
      992     assign
      993       v-min = truncate(v-seconds / 60, 0)
      994     .
      995     assign
      996       v-seconds = v-seconds modulo 60
      997     .
      998     return
      999         (if v-day-number <> 0
     1000           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1001           else ""
     1002         )
     1003       + (if v-day-number <> 0 or v-hour <> 0
     1004           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1005           else ""
     1006         )
     1007       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1008           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1009           else ""
     1010         )
     1011       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1012       .
     1013   end.
     1014   function cur-time-string returns character
     1015   :
     1016     define variable v-date as date      no-undo .
     1017     define variable v-time as integer   no-undo .
     1018     run cur-time in this-procedure
     1019       (output v-date
     1020       ,output v-time
     1021       ) .
     1022     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1023   end.
     1024   function cur-time-string-sec returns character
     1025   :
     1026     define variable v-date as date      no-undo .
     1027     define variable v-time as integer   no-undo .
     1028     run cur-time in this-procedure
     1029       (output v-date
     1030       ,output v-time
     1031       ) .
     1032     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1033   end.
     1034   function cur-time-custom  returns character
     1035   (input p-prefix as character
     1036   ,input p-date-format as character
     1037   ,input p-delimiter as character
     1038   ,input p-time-format as character
     1039   ,input p-suffix as character
     1040   )
     1041   :
     1042     define variable v-date as date      no-undo .
     1043     define variable v-time as integer   no-undo .
     1044     run cur-time in this-procedure
     1045       (output v-date
     1046       ,output v-time
     1047       ) .
     1048     return
     1049       p-prefix
     1050       + string(v-date, p-date-format)
     1051       + p-delimiter
     1052       + string(v-time, p-time-format)
     1053       + p-suffix
     1054       .
     1055   end.
     1056   function cur-time-print  returns character
     1057   :
     1058     define variable v-date as date      no-undo .
     1059     define variable v-time as integer   no-undo .
     1060     run cur-time in this-procedure
     1061       (output v-date
     1062       ,output v-time
     1063       ) .
     1064     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1065   end.
     1066   function cur-time-datetime returns datetime
     1067   :
     1068     define variable v-char as character no-undo .
     1069     define variable v-datetime as datetime no-undo .
     1070     v-char = cur-time-string().
     1071     v-datetime = datetime(v-char).
     1072     return  v-datetime.
     1073   end.
     1074   function cur-time-string-msec returns character
     1075   :
     1076     define variable v-date as datetime  no-undo .
     1077     v-date = now.
     1078     return string(v-date) .
     1079   end.
     1080   define variable vss-include-info7 as character format "X(65)" no-undo
     1081   initial "@(#)$Workfile$ $Revision$".
     1082   procedure xmlchar-test :
     1083   define input parameter p-in-string          as character        no-undo.
     1084   define output parameter p-out-string-enc    as character        no-undo.
     1085   define output parameter p-out-string-dec    as character        no-undo.
     1086   do
     1087   on error undo, return error
     1088   :
     1089          run xmlchar-encode in this-procedure
     1090       (
     1091             input p-in-string
     1092           , output p-out-string-enc
     1093       ).
     1094          run xmlchar-decode in this-procedure
     1095       (
     1096             input p-out-string-enc
     1097           , output p-out-string-dec
     1098       ).
     1099   end.
     1100   end .
     1101   procedure xmlchar-encode :
     1102   define input parameter p-in-string      as character        no-undo.
     1103   define output parameter p-out-string    as character        no-undo.
     1104       define variable v-position      as integer      no-undo.
     1105       define variable v-current-char  as character    no-undo.
     1106   do
     1107   on error undo, return error
     1108   :
     1109       assign
     1110           p-out-string = "":U
     1111       .
     1112       case p-in-string
     1113       :
     1114           when ?
     1115           then do:
     1116               assign
     1117                   p-out-string = "?":U
     1118               .
     1119           end.
     1120           when "?":U
     1121           then do:
     1122               assign
     1123                   p-out-string = "&#63;":U
     1124               .
     1125           end.
     1126           otherwise do:
     1127               do v-position = 1 to length( p-in-string )
     1128               :
     1129                   assign
     1130                       v-current-char = substring( p-in-string, v-position, 1 )
     1131                   .
     1132                   case v-current-char
     1133                   :
     1134                       when "&":U
     1135                       then do:
     1136                           assign
     1137                               p-out-string = p-out-string + "&amp;":U
     1138                           .
     1139                       end.
     1140                       when ">":U
     1141                       then do:
     1142                           assign
     1143                               p-out-string = p-out-string + "&gt;":U
     1144                           .
     1145                       end.
     1146                       when "<":U
     1147                       then do:
     1148                           assign
     1149                               p-out-string = p-out-string + "&lt;":U
     1150                           .
     1151                       end.
     1152                       when "'":U
     1153                       then do:
     1154                           assign
     1155                               p-out-string = p-out-string + "&apos;":U
     1156                           .
     1157                       end.
     1158                       when '"':U
     1159                       then do:
     1160                           assign
     1161                               p-out-string = p-out-string + "&quot;":U
     1162                           .
     1163                       end.
     1164                       when chr(1)
     1165                       then do:
     1166                           assign
     1167                               p-out-string = p-out-string + "":U
     1168                           .
     1169                       end.
     1170                       when chr(2)
     1171                       then do:
     1172                           assign
     1173                               p-out-string = p-out-string + "":U
     1174                           .
     1175                       end.
     1176                       when chr(3)
     1177                       then do:
     1178                           assign
     1179                               p-out-string = p-out-string + "":U
     1180                           .
     1181                       end.
     1182                       when chr(4)
     1183                       then do:
     1184                           assign
     1185                               p-out-string = p-out-string + "":U
     1186                           .
     1187                       end.
     1188                       when chr(5)
     1189                       then do:
     1190                           assign
     1191                               p-out-string = p-out-string + "":U
     1192                           .
     1193                       end.
     1194                       when chr(6)
     1195                       then do:
     1196                           assign
     1197                               p-out-string = p-out-string + "":U
     1198                           .
     1199                       end.
     1200                       when chr(7)
     1201                       then do:
     1202                           assign
     1203                               p-out-string = p-out-string + "":U
     1204                           .
     1205                       end.
     1206                       when chr(8)
     1207                       then do:
     1208                           assign
     1209                               p-out-string = p-out-string + "":U
     1210                           .
     1211                       end.
     1212                       when chr(9)
     1213                       then do:
     1214                           assign
     1215                               p-out-string = p-out-string + "":U
     1216                           .
     1217                       end.
     1218                       when chr(29)
     1219                       then do:
     1220                           assign
     1221                               p-out-string = p-out-string + "":U
     1222                           .
     1223                       end.
     1224                       when chr(10)
     1225                       then do:
     1226                           assign
     1227                               p-out-string = p-out-string + "&#10;":U
     1228                           .
     1229                       end.
     1230                       when chr(13)
     1231                       then do:
     1232                           assign
     1233                               p-out-string = p-out-string + "&#13;":U
     1234                           .
     1235                       end.
     1236                       otherwise do:
     1237                           assign
     1238                               p-out-string = p-out-string + v-current-char
     1239                           .
     1240                       end.
     1241                   end case.
     1242               end.
     1243           end.
     1244       end case.
     1245   end.
     1246   end .
     1247   procedure xmlchar-encode-1c :
     1248   define input parameter p-in-string      as character        no-undo.
     1249   define output parameter p-out-string    as character        no-undo.
     1250       define variable v-position      as integer      no-undo.
     1251       define variable v-current-char  as character    no-undo.
     1252   do
     1253   on error undo, return error
     1254   :
     1255       assign
     1256           p-out-string = "":U
     1257       .
     1258       case p-in-string
     1259       :
     1260           when ?
     1261           then do:
     1262               assign
     1263                   p-out-string = "?":U
     1264               .
     1265           end.
     1266           otherwise do:
     1267               do v-position = 1 to length( p-in-string )
     1268               :
     1269                   assign
     1270                       v-current-char = substring( p-in-string, v-position, 1 )
     1271                   .
     1272                   case v-current-char
     1273                   :
     1274                       when chr(1)
     1275                       then do:
     1276                           assign
     1277                               p-out-string = p-out-string + " ":U
     1278                           .
     1279                       end.
     1280                       when chr(2)
     1281                       then do:
     1282                           assign
     1283                               p-out-string = p-out-string + " ":U
     1284                           .
     1285                       end.
     1286                       when chr(3)
     1287                       then do:
     1288                           assign
     1289                               p-out-string = p-out-string + " ":U
     1290                           .
     1291                       end.
     1292                       when chr(4)
     1293                       then do:
     1294                           assign
     1295                               p-out-string = p-out-string + " ":U
     1296                           .
     1297                       end.
     1298                       when chr(5)
     1299                       then do:
     1300                           assign
     1301                               p-out-string = p-out-string + " ":U
     1302                           .
     1303                       end.
     1304                       when chr(6)
     1305                       then do:
     1306                           assign
     1307                               p-out-string = p-out-string + " ":U
     1308                           .
     1309                       end.
     1310                       when chr(7)
     1311                       then do:
     1312                           assign
     1313                               p-out-string = p-out-string + " ":U
     1314                           .
     1315                       end.
     1316                       when chr(8)
     1317                       then do:
     1318                           assign
     1319                               p-out-string = p-out-string + " ":U
     1320                           .
     1321                       end.
     1322                       when chr(9)
     1323                       then do:
     1324                           assign
     1325                               p-out-string = p-out-string + " ":U
     1326                           .
     1327                       end.
     1328                       when chr(29)
     1329                       then do:
     1330                           assign
     1331                               p-out-string = p-out-string + " ":U
     1332                           .
     1333                       end.
     1334                       when chr(10)
     1335                       then do:
     1336                           assign
     1337                               p-out-string = p-out-string + " ":U
     1338                           .
     1339                       end.
     1340                       when chr(13)
     1341                       then do:
     1342                           assign
     1343                               p-out-string = p-out-string + " ":U
     1344                           .
     1345                       end.
     1346                       otherwise do:
     1347                           assign
     1348                               p-out-string = p-out-string + v-current-char
     1349                           .
     1350                       end.
     1351                   end case.
     1352               end.
     1353           end.
     1354       end case.
     1355   end.
     1356   end .
     1357   procedure xmlchar-decode :
     1358   define input parameter p-in-string      as character        no-undo.
     1359   define output parameter p-out-string    as character        no-undo.
     1360       define variable v-position      as integer      no-undo.
     1361       define variable v-last-position as integer      no-undo.
     1362       define variable v-temp-integer  as integer      no-undo.
     1363       define variable v-current-char  as character    no-undo.
     1364       define variable v-next-char     as character    no-undo.
     1365       define variable v-success       as logical      no-undo.
     1366   do
     1367   on error undo, return error
     1368   :
     1369       assign
     1370           p-out-string = "":U
     1371           v-position   = 0
     1372       .
     1373       replace-cycle:
     1374       do while yes
     1375       on error undo, return error
     1376       :
     1377           assign
     1378               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1379           .
     1380           if v-last-position <= v-position
     1381           then do:
     1382               if v-position = 0
     1383               then do:
     1384                   assign
     1385                       p-out-string = p-in-string
     1386                   .
     1387               end.
     1388               else do:
     1389                   assign
     1390                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1391                   .
     1392               end.
     1393               leave replace-cycle.
     1394           end.
     1395           else do:
     1396               assign
     1397                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1398                   v-position      = v-last-position
     1399                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1400               .
     1401               if v-current-char = "#":U
     1402               then do:
     1403                   assign
     1404                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1405                   .
     1406                   if v-last-position > 0
     1407                   then do:
     1408                       run xmlchar-read-integer in this-procedure
     1409                        (
     1410                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1411                           , output v-temp-integer
     1412                           , output v-success
     1413                       ).
     1414                       if v-success = yes
     1415                       and v-temp-integer >= 1
     1416                       and v-temp-integer <= 255
     1417                       then do:
     1418                           assign
     1419                               p-out-string = p-out-string + chr( v-temp-integer )
     1420                               v-position   = v-last-position + 1
     1421                           .
     1422                       end.
     1423                       else do:
     1424                           assign
     1425                               p-out-string = p-out-string + "&":U
     1426                               v-position   = v-position   + 1
     1427                           .
     1428                       end.
     1429                   end.
     1430                   else do:
     1431                       assign
     1432                           p-out-string = p-out-string + "&":U
     1433                           v-position   = v-position   + 1
     1434                       .
     1435                   end.
     1436               end.
     1437               else do:
     1438                   case substring( p-in-string, v-position + 1, 3 )
     1439                   :
     1440                       when "lt;":U
     1441                       then do:
     1442                           assign
     1443                               p-out-string = p-out-string + "<":U
     1444                               v-position   = v-position   + 3
     1445                           .
     1446                       end.
     1447                       when "gt;":U
     1448                       then do:
     1449                           assign
     1450                               p-out-string = p-out-string + ">":U
     1451                               v-position   = v-position   + 3
     1452                           .
     1453                       end.
     1454                       otherwise do:
     1455                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1456                           then do:
     1457                               assign
     1458                                   p-out-string = p-out-string + "&":U
     1459                                   v-position   = v-position   + 4
     1460                               .
     1461                           end.
     1462                           else do:
     1463                               case substring( p-in-string, v-position + 1, 5 )
     1464                               :
     1465                                   when "quot;":U
     1466                                   then do:
     1467                                       assign
     1468                                           p-out-string = p-out-string + '"':U
     1469                                           v-position   = v-position   + 5
     1470                                       .
     1471                                   end.
     1472                                   when "apos;":U
     1473                                   then do:
     1474                                       assign
     1475                                           p-out-string = p-out-string + "'":U
     1476                                           v-position   = v-position   + 5
     1477                                       .
     1478                                   end.
     1479                                   otherwise do:
     1480                                       assign
     1481                                           p-out-string = p-out-string + "&":U
     1482                                       .
     1483                                   end.
     1484                               end case.
     1485                           end.
     1486                       end.
     1487                   end case.
     1488               end.
     1489           end.
     1490       end.
     1491   end.
     1492   end .
     1493   procedure xmlchar-read-integer :
     1494   define input parameter p-input-string      as character        no-undo.
     1495   define output parameter p-output-integer   as integer          no-undo.
     1496   define output parameter p-success       as logical          no-undo.
     1497   do
     1498   on error undo, return error
     1499   :
     1500       assign
     1501           p-output-integer = integer( p-input-string )
     1502       no-error.
     1503       if error-status :error
     1504       then do:
     1505           assign
     1506               p-success           = no
     1507               p-output-integer    = 0
     1508           .
     1509       end.
     1510       else do:
     1511           assign
     1512               p-success           = yes
     1513           .
     1514       end.
     1515   end.
     1516   end.
     1517   define variable v-bgelib-bgeclall           as logical      no-undo.
     1518   define variable v-bgelib-bgedict            as logical      no-undo.
     1519   define temp-table temp_ext-doc-type no-undo
     1520       field edt-key               as integer
     1521       field ext-doc-type          as character
     1522       field ext-doc-type-label    as character
     1523       index pi is primary unique
     1524           edt-key
     1525   .
     1526   define temp-table temp_bgelib_goods no-undo
     1527       field gds-code as integer
     1528       index pi is primary unique
     1529           gds-code
     1530   .
     1531   define temp-table temp_bgelib_clients no-undo
     1532       field obj-type as character
     1533       field obj-code as integer
     1534       index pi is primary unique
     1535           obj-type
     1536           obj-code
     1537   .
     1538   define temp-table temp_bgelib_dis-card no-undo
     1539       field d-card as character
     1540       index pi is primary unique
     1541           d-card
     1542   .
     1543   define temp-table temp_bgelib_trn-doc no-undo
     1544       field doc-code as integer
     1545   .
     1546   procedure bgelib-tag-open:
     1547   do
     1548   on error undo, return error
     1549   :
     1550   define input parameter v-tag-level  as integer      no-undo.
     1551   define input parameter v-tag-name   as character    no-undo.
     1552   define input parameter v-tag-value  as character    no-undo.
     1553       put stream stmXMLOut unformatted
     1554           chr(10)
     1555           + fill(" ", 4 * v-tag-level)
     1556           + "<" + v-tag-name
     1557           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     1558           + v-tag-value + ">"
     1559       .
     1560   end.
     1561   end procedure.
     1562   procedure bgelib-tag-put:
     1563   do
     1564   on error undo, return error
     1565   :
     1566   define input parameter v-tag-level      as integer      no-undo.
     1567   define input parameter v-tag-name       as character    no-undo.
     1568   define input parameter v-tag-value      as character    no-undo.
     1569   define input parameter v-empty-mode     as integer      no-undo.
     1570       v-tag-name = trim(v-tag-name).
     1571       if  v-empty-mode = 1
     1572       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     1573       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     1574       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     1575       then do:
     1576           run xmlchar-encode in this-procedure (
     1577                 input v-tag-value
     1578               , output v-tag-value
     1579           ).
     1580           put stream stmXMLOut unformatted
     1581               chr(10) + fill(" ", 4 * v-tag-level)
     1582                           + '<' + v-tag-name + '>'
     1583                           + v-tag-value
     1584                           + '</' + v-tag-name + '>'
     1585           .
     1586       end.
     1587   end.
     1588   end procedure.
     1589   procedure bgelib-tag-close:
     1590   do
     1591   on error undo, return error
     1592   :
     1593   define input parameter v-tag-level as integer      no-undo.
     1594   define input parameter v-tag-name  as character    no-undo.
     1595       put stream stmXMLOut unformatted
     1596           chr(10)
     1597           + fill( " ", 4 * v-tag-level)
     1598           + '</' + v-tag-name + '>'
     1599       .
     1600   end.
     1601   end procedure.
     1602   procedure bgelib-write-log:
     1603   do
     1604   on error undo, return error
     1605   :
     1606   define input parameter v-filename   as character    no-undo.
     1607   define input parameter v-log-level  as integer      no-undo.
     1608   define input parameter v-out-string as character    no-undo.
     1609       output stream stmXMLLog to value( v-filename ) append.
     1610       put stream stmXMLLog unformatted
     1611           chr(10)
     1612       .
     1613       put stream stmXMLLog unformatted
     1614           ( if v-log-level = 0
     1615             or v-out-string = "&DLine"
     1616             or v-out-string = "&Line"
     1617             then ""
     1618             else cur-time-string-sec() + " " )
     1619       .
     1620       put stream stmXMLLog unformatted
     1621           ( if v-out-string = "&Line"
     1622             then fill( "-", 80 )
     1623             else if v-out-string = "&DLine"
     1624                  then fill( "=", 80 )
     1625                  else v-out-string )
     1626       .
     1627       output stream stmXMLLog close.
     1628   end.
     1629   end procedure.
     1630   procedure bgelib-write-edt:
     1631   do
     1632   on error undo, return error
     1633   :
     1634   define input parameter v-editor-handle    as handle       no-undo.
     1635   define input parameter v-log-level        as integer      no-undo.
     1636   define input parameter v-out-string       as character    no-undo.
     1637       if valid-handle ( v-editor-handle )
     1638       then do:
     1639           v-editor-handle :move-to-eof().
     1640           v-editor-handle :insert-string( ( if v-log-level = 0
     1641                                             or v-out-string = "&DLine"
     1642                                             or v-out-string = "&Line"
     1643                                             then ""
     1644                                             else cur-time-string-sec() + " "
     1645                                         ) ).
     1646           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     1647                                             then fill( "-", 80 )
     1648                                             else if v-out-string = "&DLine" then fill("=", 80)
     1649                                             else fill( " ", v-log-level) + v-out-string
     1650                                         ) ).
     1651           v-editor-handle :insert-string( chr(10) ).
     1652       end.
     1653       process events.
     1654       output to 'bgescn.txt' append.
     1655           put unformatted
     1656               chr(10)
     1657               string( ( if v-log-level = 0
     1658                         or v-out-string = "&DLine"
     1659                         or v-out-string = "&Line"
     1660                         then ""
     1661                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     1662                     ) )
     1663               string( ( if v-out-string = "&Line"
     1664                         then fill( "-", 80 )
     1665                         else if v-out-string = "&DLine"
     1666                              then fill( "=", 80 )
     1667                              else fill( " ", v-log-level ) + v-out-string
     1668                     ) )
     1669           .
     1670       output close.
     1671   end.
     1672   end procedure.
     1673   procedure bgelib-show-cnt:
     1674   do
     1675   on error undo, return error
     1676   :
     1677   define input parameter v-fillin-handle     as handle   no-undo.
     1678       if valid-handle( v-fillin-handle )
     1679       then do:
     1680           assign
     1681               v-fillin-handle :visible = true
     1682           .
     1683       end.
     1684   end.
     1685   end procedure.
     1686   procedure bgelib-hide-cnt:
     1687   do
     1688   on error undo, return error
     1689   :
     1690   define input parameter v-fillin-handle     as handle   no-undo.
     1691       if valid-handle( v-fillin-handle )
     1692       then do:
     1693           assign v-fillin-handle :visible = false.
     1694       end.
     1695   end.
     1696   end procedure.
     1697   procedure bgelib-write-cnt:
     1698   do
     1699   on error undo, return error
     1700   :
     1701   define input parameter v-fillin-handle    as handle       no-undo.
     1702   define input parameter v-fillin-string    as character    no-undo.
     1703       if valid-handle( v-fillin-handle )
     1704       then do:
     1705           assign
     1706               v-fillin-handle :SCREEN-value = v-fillin-string
     1707           .
     1708       end.
     1709   end.
     1710   end procedure.
     1711   procedure bgelib-write-header:
     1712   do
     1713   on error undo, return error
     1714   :
     1715   define input parameter p-first-file     as logical      no-undo.
     1716   define input parameter p-xml-file-name  as character    no-undo.
     1717   define input parameter p-list-file-name as character    no-undo.
     1718   define input parameter p-file-number    as integer      no-undo.
     1719   define input parameter p-have-prev      as logical      no-undo.
     1720   define input parameter p-prev-filename  as character    no-undo.
     1721   define input parameter p-obj-list       as character    no-undo.
     1722   define input parameter p-doc-type-list  as character    no-undo.
     1723   define input parameter p-parameter-list as character    no-undo.
     1724       define variable v-counter    as integer        no-undo.
     1725       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1726       put stream stmXMLOut unformatted
     1727           "<?xml version='1.0' encoding='windows-1251'?>"
     1728       .
     1729       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1730       run bgelib-tag-open( input 0, input "header", input "" ).
     1731       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1732       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1733       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1734       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1735       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1736       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1737       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1738       :
     1739           run bgelib-tag-put(
     1740                 input 1
     1741               , input entry( 2 * v-counter, p-parameter-list )
     1742               , input entry( 2 * v-counter + 1, p-parameter-list )
     1743               , input 0
     1744           ).
     1745       end.
     1746       run bgelib-tag-close( input 0, input "header" ).
     1747       output stream stmXMLOut close.
     1748       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1749       if p-first-file = yes
     1750       then do:
     1751           put stream stmXMLOut unformatted
     1752               "<?xml version='1.0' encoding='windows-1251'?>"
     1753           .
     1754           run bgelib-tag-open( input 0, input "export", input "" ).
     1755       end.
     1756       run bgelib-tag-open( input 1, input "file", input "" ).
     1757       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1758       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1759       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1760       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1761       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1762       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1763       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1764       :
     1765           run bgelib-tag-put(
     1766                 input 2
     1767               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1768               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1769               , input 0
     1770           ).
     1771       end.
     1772       run bgelib-tag-close( input 1, input "file" ).
     1773       output stream stmXMLOut close.
     1774   end.
     1775   end procedure.
     1776   procedure bgelib-write-footer:
     1777   do
     1778   on error undo, return error
     1779   :
     1780   define input parameter p-last-file      as logical      no-undo.
     1781   define input parameter p-xml-file-name  as character    no-undo.
     1782   define input parameter p-list-file-name as character    no-undo.
     1783   define input parameter p-have-next      as logical      no-undo.
     1784   define input parameter p-next-file-name as character    no-undo.
     1785       define variable v-error-num     as integer           no-undo.
     1786       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1787       if p-have-next = yes
     1788       then do:
     1789           run bgelib-tag-open( input 0, input "footer", "" ).
     1790           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1791           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1792           run bgelib-tag-close( input 0, input "footer" ).
     1793       end.
     1794       run bgelib-tag-close( input 0, input "root" ).
     1795       output stream stmXMLOut close.
     1796       run bge/os_copy.p (
     1797             input "M"
     1798           , input p-xml-file-name + "tmp"
     1799           , input p-xml-file-name + "xml"
     1800           , output v-error-num
     1801       ).
     1802       if p-last-file = yes
     1803       then do:
     1804           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1805               run bgelib-tag-close( input 0, input "export" ).
     1806           output stream stmXMLOut close.
     1807           run bge/os_copy.p (
     1808                 input "M"
     1809               , input p-list-file-name + "tmp"
     1810               , input p-list-file-name + "xml"
     1811               , output v-error-num
     1812           ).
     1813       end.
     1814   end.
     1815   end procedure.
     1816   procedure bgelib-filename :
     1817   do
     1818   on error undo, return error
     1819   :
     1820   define input parameter p-prefix             as character    no-undo.
     1821   define output parameter p-xml-file-name     as character    no-undo.
     1822   define output parameter p-log-file-name     as character    no-undo.
     1823   define output parameter p-list-file-name    as character    no-undo.
     1824       define variable v-home-dir  as character    no-undo.
     1825       define variable v-error-num as integer      no-undo.
     1826       get-key-value section "BGE" key "outdir" value v-home-dir.
     1827       if v-home-dir = ?
     1828       then do:
     1829           message
     1830             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1831             skip(1)
     1832             skip "Обратитесь к администратору."
     1833           view-as alert-box error.
     1834           undo, return error .
     1835       end.
     1836       run gbl/dir-cre.p (
     1837           input v-home-dir
     1838       ) no-error.
     1839       if error-status :error
     1840       then do:
     1841           message
     1842             skip "Неверно задан каталог экспорта."
     1843             skip(1)
     1844             skip "Обратитесь к администратору."
     1845           view-as alert-box error.
     1846           undo, return error .
     1847       end.
     1848       run bge/genfname.p (
     1849             input v-home-dir
     1850           , input p-prefix
     1851           , input ""
     1852           , input "xml"
     1853           , input "tmp"
     1854           , output p-xml-file-name
     1855       ).
     1856       assign
     1857           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1858           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1859           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1860       .
     1861   end.
     1862   end procedure.
     1863   procedure bgelib-read-config :
     1864   do
     1865   on error undo, return error
     1866   :
     1867   define variable v-par-type as character     no-undo.
     1868     define variable v-param-type      as character  no-undo .
     1869     define variable v-value-character as character  no-undo .
     1870     define variable v-value-date      as date       no-undo .
     1871     define variable v-value-decimal   as decimal    no-undo .
     1872     define variable v-value-integer   as integer    no-undo .
     1873     define variable v-value-logical   as logical    no-undo .
     1874     define variable v-tth             as handle     no-undo .
     1875       assign
     1876           v-bgelib-bgeclall = no
     1877           v-bgelib-bgedict  = no
     1878       .
     1879       run adm/shattri.p ( input "get":U
     1880                         , input  '':u
     1881                         , input  0
     1882                         , input  'bge-export':U
     1883                         , input  'bgeclall':U
     1884                         , output v-value-character
     1885                         , output v-value-date
     1886                         , output v-value-decimal
     1887                         , output v-value-integer
     1888                         , output v-value-logical
     1889                         , output v-param-type
     1890                         , input-output table-handle v-tth
     1891                         ) no-error .
     1892       if error-status :error
     1893       then do:
     1894         assign
     1895           v-bgelib-bgeclall = no
     1896         .
     1897       end.
     1898       else do:
     1899         assign
     1900           v-bgelib-bgeclall = v-value-logical
     1901         .
     1902       end.
     1903       delete object v-tth.
     1904       run adm/shattri.p ( input "get":U
     1905                         , input  '':u
     1906                         , input  0
     1907                         , input  'bge-export':U
     1908                         , input  'bgedict':U
     1909                         , output v-value-character
     1910                         , output v-value-date
     1911                         , output v-value-decimal
     1912                         , output v-value-integer
     1913                         , output v-value-logical
     1914                         , output v-param-type
     1915                         , input-output table-handle v-tth
     1916                         ) no-error .
     1917       if error-status :error
     1918       then do:
     1919         assign
     1920           v-bgelib-bgedict = no
     1921         .
     1922       end.
     1923       else do:
     1924         assign
     1925           v-bgelib-bgedict = v-value-logical
     1926         .
     1927       end.
     1928       delete object v-tth.
     1929       run adm/shattri.p ( input "get":U
     1930                         , input  '':u
     1931                         , input  0
     1932                         , input  'bge-export':U
     1933                         , input  'bgefmt':U
     1934                         , output v-value-character
     1935                         , output v-value-date
     1936                         , output v-value-decimal
     1937                         , output v-value-integer
     1938                         , output v-value-logical
     1939                         , output v-param-type
     1940                         , input-output table-handle v-tth
     1941                         ) no-error .
     1942       if error-status :error
     1943       then do:
     1944         assign
     1945           v-bgelib-bgefmt  = "xml":U
     1946         .
     1947       end.
     1948       else do:
     1949         assign
     1950           v-bgelib-bgefmt  = v-value-character
     1951         .
     1952       end.
     1953       delete object v-tth.
     1954       run adm/shattri.p ( input "get":U
     1955                         , input  '':u
     1956                         , input  0
     1957                         , input  'bge-export':U
     1958                         , input  'bgeflold':U
     1959                         , output v-value-character
     1960                         , output v-value-date
     1961                         , output v-value-decimal
     1962                         , output v-value-integer
     1963                         , output v-value-logical
     1964                         , output v-param-type
     1965                         , input-output table-handle v-tth
     1966                         ) no-error .
     1967       if error-status :error
     1968       then do:
     1969         assign
     1970           v-bgelib-bgeflold  = "old":U
     1971         .
     1972       end.
     1973       else do:
     1974         assign
     1975           v-bgelib-bgeflold  = v-value-character
     1976         .
     1977       end.
     1978       delete object v-tth.
     1979   end.
     1980   end procedure.
     1981   procedure bgelib-check-file-size :
     1982   do
     1983   on error undo, return error
     1984   :
     1985   define input parameter p-out-filename   as character    no-undo.
     1986   define output parameter p-is-big        as logical      no-undo.
     1987       define variable v-current-position    as integer        no-undo.
     1988       assign
     1989           v-current-position = seek( stmXMLOut )
     1990       .
     1991       if v-current-position / 1024 / 1024  >= 100
     1992       then do:
     1993           assign
     1994               p-is-big = yes
     1995           .
     1996       end.
     1997   end.
     1998   end procedure.
     1999   procedure bgelib-init-ext-doc-type :
     2000       define variable v-counter    as integer      no-undo.
     2001       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2002   do
     2003   for buf_temp_ext-doc-type
     2004   on error undo, return error
     2005   :
     2006       empty temp-table buf_temp_ext-doc-type.
     2007       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2008       :
     2009           create buf_temp_ext-doc-type.
     2010           assign
     2011               buf_temp_ext-doc-type.edt-key               = v-counter
     2012               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2013               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2014           .
     2015       end.
     2016   end.
     2017   end procedure.
     2018   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2019   define variable v-xml-file-name     as character            no-undo.
     2020   define variable v-xml-file-name-path as character            no-undo.
     2021   define variable v-log-file-name     as character            no-undo.
     2022   define variable v-locked            as logical              no-undo.
     2023   define variable v-log-string        as character            no-undo.
     2024   define variable v-oper-num          as integer              no-undo.
     2025   define variable v-obj-list          as character            no-undo.
     2026   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2027   DEF VAR intRep      AS INT NO-UNDO.
     2028   define variable hEDT             AS HANDLE NO-UNDO.
     2029   define variable hCNT             AS HANDLE NO-UNDO.
     2030   procedure xml-cd-write-header:
     2031   do
     2032   on error undo, return error
     2033   :
     2034   define input parameter p-xml-file-name       as character    no-undo.
     2035   define input parameter p-xml-file-name-path  as character    no-undo.
     2036   define input parameter p-doc-name            as character    no-undo.
     2037   define input parameter p-version             as character    no-undo.
     2038   define input parameter p-obj-list            as character    no-undo.
     2039   define input parameter p-correspondent       as character    no-undo .
     2040   define input parameter p-write-header        as logical      no-undo .
     2041   define variable OS-time as character no-undo .
     2042   define variable id as character no-undo .
     2043   define buffer buf_db for ub.db.
     2044   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     2045   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     2046   assign
     2047   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2048   .
     2049   run bgelib-tag-open in this-procedure (
     2050                                        1
     2051                                       ,p-doc-name
     2052                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     2053                                         ).
     2054   if p-write-header then do:
     2055     run bgelib-tag-open(2, "Header","").
     2056     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     2057     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     2058     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     2059     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     2060     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     2061     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     2062     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     2063     find first buf_db where buf_db.db-num = g#db-num no-lock.
     2064     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     2065     run bgelib-tag-close( 2, "Header" ).
     2066   end.
     2067   output stream stmXMLOut close.
     2068   end.
     2069   end procedure.
     2070   procedure xml-cd-write-footer:
     2071   do
     2072   on error undo, return error
     2073   :
     2074   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     2075   define input parameter p-xml-file-name as character    no-undo.
     2076   define input parameter p-doc-name      as character    no-undo .
     2077   define variable v-error-num     as integer           no-undo.
     2078   define variable v-md5-signature as character no-undo .
     2079   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2080   run bgelib-tag-close( 0, p-doc-name ).
     2081   put stream stmXMLOut unformatted skip.
     2082   output stream stmXMLOut close.
     2083   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2084   if v-error-num > 0
     2085   then do:
     2086      return error.
     2087   end.
     2088   if opsys = "unix"
     2089   then do:
     2090       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2091   end.
     2092   end.
     2093   end procedure.
     2094   procedure xml-cd-filename :
     2095   do
     2096   on error undo, return error
     2097   :
     2098   define input parameter  p-out               as character no-undo .
     2099   define output parameter p-xml-file-name     as character    no-undo.
     2100   define output parameter p-xml-file-name-path   as character    no-undo.
     2101   define output parameter p-log-file-name     as character    no-undo.
     2102   define output parameter p-locked            as logical      no-undo.
     2103   define variable v-out as character     no-undo.
     2104   define variable loc#log as logical no-undo .
     2105   define variable BadFlag as logical no-undo .
     2106   define variable fq as integer no-undo .
     2107   define variable v-remote as character no-undo .
     2108   assign
     2109   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     2110   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     2111   p-log-file-name = p-out + "actions.log"
     2112   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     2113   .
     2114   end.
     2115   end procedure.
     2116   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     2117   define variable v-date-str as character no-undo .
     2118   assign
     2119   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2120                string(Month(p-date), "99":U) + "-":U +
     2121                string(DAY(p-date), "99":U).
     2122   return v-date-str.
     2123   END FUNCTION.
     2124   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     2125   define variable v-date-str as character no-undo .
     2126   assign
     2127   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     2128                string(Month(p-date), "99":U) + "-":U +
     2129                string(DAY(p-date), "99":U) + chr(32) +
     2130                string(p-time, "HH:MM:SS").
     2131   return v-date-str.
     2132   END FUNCTION.
     2133   function string-to-date returns date ( input p-string  as character):
     2134     define variable v-date as date no-undo .
     2135     assign
     2136     v-date = date(integer(substring(p-string, 4, 2))
     2137                   ,integer(substring(p-string, 1, 2))
     2138                   ,integer(substring(p-string, 7, 4))
     2139                  ) no-error .
     2140     if error-status:error then return ?.
     2141     return v-date.
     2142   END FUNCTION.
     2143   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     2144   define variable v-time as integer no-undo init ?.
     2145   define variable v-dop1 as character no-undo .
     2146   define variable v-dop2 as character no-undo .
     2147   assign
     2148   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     2149   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     2150   no-error .
     2151   if error-status:error then return ?.
     2152   assign
     2153   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     2154             integer(entry(2, v-dop2, ";":U)) * 60 +
     2155             integer(entry(3, v-dop2, ";":U)) no-error .
     2156   return v-time.
     2157   END FUNCTION.
     2158   FIND FIRST ub.cash-desk NO-LOCK WHERE
     2159              ub.cash-desk.db-num = g#db-num AND
     2160              (ub.cash-desk.pos-type = 'IBM':U
     2161               AND
     2162               ub.cash-desk.obj-code = i-obj-code)
     2163              OR
     2164              (ub.cash-desk.pos-type = 'IBM-XML':U
     2165              AND
     2166              ub.cash-desk.obj-code = i-obj-code)
     2167               No-error.
     2168   IF not avail(cash-desk) then do:
     2169     run write-log-and-file in p-log-handle (
     2170           input 1
     2171         , input log-file-name
     2172         , input 1
     2173         , input substitute( "!!!&1 справочника оснований чеков коррекций реализуется только для касс &2 &3 "
     2174                             , (if action = "U" then "Передача" else "Удаление")
     2175                             , 'IBM':U
     2176                             , 'IBM-XML':U
     2177                           )
     2178                                           ).
     2179     return.
     2180   end.
     2181   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2182   procedure putc-corr :
     2183   define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
     2184   define input parameter p-version like ub.cash-desk.version no-undo .
     2185   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
     2186   define input parameter p-cash-num like ub.cash-desk.cash-num  no-undo .
     2187   define input parameter p-is-del as logical no-undo .
     2188   define buffer buf_code for ub.code.
     2189   define variable ii as integer no-undo.
     2190     do
     2191     on error undo, return error
     2192     :
     2193       if p-is-del then do:
     2194         for each buf_code where buf_code.parent = "OsnovCorr" and buf_code.status_ = 0 :
     2195           ii = ii + 1.
     2196           run bgelib-tag-open in this-procedure ( input 2, input "CorrectionReason", input substitute("ctrl='&2' code='&1'", string (ii), "ADD":u)).
     2197             run bgelib-tag-put in this-procedure ( input 3, input "CorrectionReasonName", input string(buf_code.CodeName), input 1 ).
     2198           run bgelib-tag-close in this-procedure ( input 2, input "CorrectionReason").
     2199         end.
     2200         ii = 0 .
     2201       end.
     2202       else do:
     2203         run bgelib-tag-open in this-procedure ( input 2, input "CorrectionReason", input substitute("ctrl='&2' code='&1'", "*", "DEL":u)).
     2204         run bgelib-tag-close in this-procedure ( input 2, input "CorrectionReason").
     2205       end.
     2206     end.
     2207   end procedure.
     2208   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2209   PROCEDURE   for-cash-cycle:
     2210   DEFINE VARIABLE fname-list as character no-undo .
     2211   DEFINE VARIABLE out-list as character no-undo .
     2212   DEFINE VARIABLE var-file-num as integer no-undo .
     2213   DEFINE VARIABLE v-dir-remote as character no-undo .
     2214   DEFINE VARIABLE v-dir-remote-tmp as character no-undo .
     2215   define variable v-plu as character no-undo .
     2216   define variable ss  as character no-undo .
     2217   define variable ss0  as character no-undo .
     2218   define variable v-temp-kat-file as character no-undo .
     2219   define variable v-kat-file as character no-undo .
     2220   define variable v-kat-file-save as character no-undo .
     2221   define variable v-updated-subject-dis-kat as logical no-undo .
     2222   define variable v-next as logical no-undo .
     2223   define variable v-cd-subject-code as character no-undo .
     2224   define variable v-cd-disc-string as character no-undo .
     2225   define variable v-versiond as decimal no-undo .
     2226   define buffer for-cash-desk for ub.cash-desk.
     2227   _for:
     2228   FOR EACH for-cash-desk NO-LOCK WHERE
     2229           for-cash-desk.db-num = g#db-num AND
     2230           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2231           for-cash-desk.obj-code = i-obj-code AND
     2232           for-cash-desk.cash-on  = yes
     2233       BREAK
     2234       BY for-cash-desk.db-num
     2235       BY for-cash-desk.obj-code
     2236       BY for-cash-desk.pos-type
     2237       BY for-cash-desk.cash-on
     2238       :
     2239     if LOOKUP(ub.cash-desk.pos-type,
     2240               ('NCR-GM':U + chr(44) +
     2241                'IBM-XML':U + chr(44) +
     2242                'MAGIA-XML':U + chr(44) +
     2243                'NCR-AS@R':U + chr(44)
     2244                  )) > 0
     2245     and for-cash-desk.autonomy = integer('1':U) then NEXT.
     2246     assign
     2247     v-versiond = decimal(for-cash-desk.version)
     2248     no-error .
     2249     if error-status:error
     2250     or v-versiond < 1.11
     2251     or for-cash-desk.pos-type <> 'IBM-XML':U
     2252     then do:
     2253       run write-log-and-file in p-log-handle (
     2254             input 1
     2255           , input log-file-name
     2256           , input 1
     2257           , input substitute( "Невозможно передать на кассу &1 &2&3&4" +
     2258                               "Данный функционал доступен только для POS &5 с версии ПО кассы 1.11 или POS &6"
     2259                             ,  for-cash-desk.cash-num
     2260                             , 'маг':U
     2261                             , for-cash-desk.obj-code
     2262                             , chr(10)
     2263                             , 'IBM':U
     2264                             , 'IBM-XML':U
     2265                             )
     2266                                             ).
     2267        next _for.
     2268     end.
     2269     run write-log-and-file in p-log-handle (
     2270           input 1
     2271         , input log-file-name
     2272         , input 1
     2273         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     2274                           )
     2275                                           ).
     2276   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2277   case for-cash-desk.pos-type:
     2278       when 'IBM-XML':U or when 'Autotank':U
     2279     then do:
     2280   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2281   run xml-cd-filename in this-procedure (
     2282         input out
     2283       , output v-xml-file-name
     2284       , output v-xml-file-name-path
     2285       , output v-log-file-name
     2286       , output v-locked
     2287   ).
     2288   run write-log-and-file in p-log-handle (
     2289         input 1
     2290       , input log-file-name
     2291       , input 1
     2292       , input substitute( ("'Пересылка справочника оснований чеков коррекций '" + " &1")
     2293                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2294                         )
     2295                                         ).
     2296   run write-log-and-file in p-log-handle (
     2297         input 1
     2298       , input log-file-name
     2299       , input 1
     2300       , input substitute( "................с параметрами: ... магазин: &1", i-obj-code )
     2301                                         ).
     2302   assign
     2303   v-obj-list = 'маг':U + string(i-obj-code)
     2304   .
     2305   run xml-cd-write-header in this-procedure (
     2306         input v-xml-file-name
     2307       , input v-xml-file-name-path
     2308       , input 'data'
     2309       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2310       , input v-obj-list
     2311       , input (
     2312                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2313                   then (if for-cash-desk.autonomy = integer('0':U)
     2314                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2315                         else ("КМ"   )
     2316                         )
     2317                   else ("маг" + string(for-cash-desk.obj-code) +  "_касса" + string(for-cash-desk.cash-num))
     2318                   )
     2319               )
     2320       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
     2321   ).
     2322   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2323   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2324     end.
     2325     when 'IBM':U
     2326     then do:
     2327   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2328   if for-cash-desk.cash-os = ""
     2329   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2330   then NEXT.
     2331   assign
     2332   Cash-OS2 = (for-cash-desk.cash-os = "OS/2":U) OR (for-cash-desk.cash-os = "LINUX":U)
     2333               AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
     2334   Cash-DOS = NOT CASH-OS2
     2335   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 )
     2336   v-dir-remote-tmp = v-remote + "tmp":U
     2337   v-dir-remote = v-remote + "out":U + string(for-cash-desk.obj-code, "99999") + "-" + string(for-cash-desk.cash-num, "999")
     2338   .
     2339   if for-cash-desk.remote = 1 then do:
     2340     run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
     2341       if error-status:error then do:
     2342         run write-log-and-file in p-log-handle (
     2343               input 1
     2344             , input log-file-name
     2345             , input 1
     2346             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     2347                               "и/или попытка его создания не удалась"
     2348                               ,v-dir-remote-tmp
     2349                               ,for-cash-desk.cash-num
     2350                               ,chr(10)
     2351                               )
     2352                                               ).
     2353         NEXT.
     2354     end.
     2355     run gbl/dir-cre.p ( input v-dir-remote ) no-error .
     2356       if error-status:error then do:
     2357         run write-log-and-file in p-log-handle (
     2358               input 1
     2359             , input log-file-name
     2360             , input 1
     2361             , input substitute("!!!Каталог &1  для отсылки запроса на удаленную кассу &2 не найден&3" +
     2362                               "и/или попытка его создания не удалась"
     2363                               ,v-dir-remote
     2364                               ,for-cash-desk.cash-num
     2365                               ,chr(10)
     2366                               )
     2367                                               ).
     2368         NEXT.
     2369       end.
     2370   end.
     2371   output stream IBMStream
     2372   to value( (if for-cash-desk.remote = 1
     2373               then (v-dir-remote-tmp + chr(47) + "fl":U)
     2374               else out) + fname + '.dat' ) convert target "ibm866".
     2375   OS2-time =       ( if Cash-OS2 then
     2376                                       string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     2377                         else "" )
     2378   .
     2379     end.
     2380   END CASE.
     2381     RUN putc-corr in this-procedure
     2382                  ( input for-cash-desk.pos-type
     2383                   ,input for-cash-desk.version
     2384                   ,input for-cash-desk.cash-os
     2385                   ,input for-cash-desk.cash-num
     2386                   ,input true
     2387                   ).
     2388   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2389   case for-cash-desk.pos-type:
     2390       when 'IBM-XML':U or when 'Autotank':U
     2391     then do:
     2392   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2393   output stream stmxmlout close.
     2394   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2395       , input 'data'
     2396   ).
     2397   run write-log-and-file in p-log-handle (
     2398         input 1
     2399       , input log-file-name
     2400       , input 1
     2401       , input substitute( "Данные выгружены в файл &1"
     2402                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2403                         )
     2404                                          ).
     2405   if (
     2406   not (g#news or g#auto or g#esys )
     2407   or
     2408   (
     2409   for-cash-desk.pos-type = 'MAGIA-XML':U
     2410   or
     2411     (for-cash-desk.pos-type = 'IBM-XML':U
     2412   or (for-cash-desk.pos-type = 'Autotank':U
     2413     and
     2414     for-cash-desk.autonomy = integer('2':U))
     2415     )))
     2416   then do:
     2417     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2418     end.
     2419     if (for-cash-desk.pos-type = 'IBM-XML':U
     2420     and for-cash-desk.autonomy = integer('0':U))
     2421     or (for-cash-desk.pos-type = 'Autotank':U
     2422     and for-cash-desk.autonomy = integer('2':U))
     2423     then do:
     2424       run str/post-xml.p
     2425         (
     2426          input parparentproc
     2427         ,input p-parent-handle
     2428         ,input p-log-handle
     2429         ,input g#news or g#esys
     2430         ,input g#auto
     2431         ,input 'send'
     2432         ,input log-file-name
     2433         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2434         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2435         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2436         ,input 30
     2437         ,input   ( if action = 'U'
     2438                     then ('Ждите - ' + 'добавление/изменение справочника оснований чеков коррекций ')
     2439                     else ('Ждите - ' + 'удаление справочника оснований чеков коррекций ') ) +
     2440                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2441         ) no-error .
     2442       if error-status:error
     2443       or return-value = "error" then do:
     2444         run write-log-and-file in p-log-handle (
     2445               input 1
     2446             , input log-file-name
     2447             , input 1
     2448             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2449                                   ,for-cash-desk.obj-code
     2450                                   ,for-cash-desk.cash-num
     2451                                   , chr(10)
     2452                                   , error-status:get-message(1)
     2453                                   , return-value
     2454                               )
     2455                                               ).
     2456         assign
     2457         v-view-log = yes
     2458         .
     2459       end.
     2460     end.
     2461     if not available ub.shop then do:
     2462       find first ub.shop no-lock where
     2463                 ub.shop.obj-code = for-cash-desk.obj-code.
     2464     end.
     2465     if
     2466     not (g#news or g#esys)
     2467     then do:
     2468       run str/getxibmf.p (
     2469                       input parparentproc
     2470                     ,input p-log-handle
     2471                     ,input 'маг':U
     2472                     ,input for-cash-desk.obj-code
     2473                     ,input ub.shop.host-code
     2474                     ,input in_
     2475                     ,input spl
     2476                     ,input (in_ + sav)
     2477                     ,input for-cash-desk.pos-type
     2478                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2479                             and for-cash-desk.autonomy = integer('0':U))
     2480                             or (for-cash-desk.pos-type = 'Autotank':U
     2481                             and for-cash-desk.autonomy = integer('2':U))
     2482                             then "utf-8":U
     2483                             else "windows-1251")
     2484                     ,input log-file-name
     2485                     ,input "data":U
     2486                     ,input v-xml-file-name
     2487                     ,input-output v-view-log
     2488                     ) no-error .
     2489       if error-status:error then do:
     2490         run write-log-and-file in p-log-handle (
     2491               input 1
     2492             , input log-file-name
     2493             , input 1
     2494             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     2495                                   ,for-cash-desk.obj-code
     2496                                   ,for-cash-desk.cash-num
     2497                               )
     2498                                               ).
     2499         assign
     2500         v-view-log = yes
     2501         .
     2502       end.
     2503     end.
     2504   end.
     2505   if g#news
     2506   or g#auto
     2507   or g#esys
     2508   and for-cash-desk.pos-type = 'MAGIA-XML':U
     2509   then do:
     2510   end.
     2511     end.
     2512     when 'IBM':U
     2513     then do:
     2514   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2515   output stream IBMStream close.
     2516   output stream IBMStream
     2517   to value( (if for-cash-desk.remote = 1
     2518               then (v-dir-remote-tmp + chr(47) + "fl":U)
     2519               else out) + fname + '.ad0' ) convert target "ibm866".
     2520   put stream IBMStream ' ' skip(1).
     2521    put stream IBMStream unformatted '  ' for-cash-desk.addr-path ' plu' skip.
     2522   output stream IBMStream close.
     2523   OS-RENAME
     2524   VALUE((if for-cash-desk.remote = 1
     2525           then (v-dir-remote-tmp + chr(47) + "fl":U)
     2526           else out) + fname + '.ad0')
     2527   VALUE((if for-cash-desk.remote = 1
     2528           then (v-dir-remote + chr(47) + "fl":U)
     2529           else out) + fname + '.adr').
     2530   os-er = OS-ERROR.
     2531   run write-log-and-file in p-log-handle (
     2532         input 1
     2533       , input log-file-name
     2534       , input 1
     2535       , input substitute( "Данные выгружены в файл &1, файл адреса &2"
     2536                           , ((if for-cash-desk.remote = 1
     2537                               then (v-dir-remote + chr(47) + "fl":U)
     2538                               else out) + fname + '.dat')
     2539                           , ((if for-cash-desk.remote = 1
     2540                               then (v-dir-remote + chr(47) + "fl":U)
     2541                               else out) + fname + '.adr')
     2542                           )
     2543                                          ).
     2544   if os-er <> 0 then do:
     2545     run write-log-and-file in p-log-handle (
     2546           input 1
     2547         , input log-file-name
     2548         , input 1
     2549         , input substitute( "!!!Ошибки в работе локальной сети или нарушение прав доступа при обмене информацией с кассой &1",
     2550                               for-cash-desk.cash-num
     2551                           )
     2552                                           ).
     2553         assign
     2554         v-view-log = yes
     2555         .
     2556         return "error":U.
     2557   end.
     2558   if for-cash-desk.remote = 1 then do:
     2559     OS-RENAME
     2560     VALUE(v-dir-remote-tmp + chr(47) + "fl":U + fname + '.dat')
     2561     VALUE(v-dir-remote  + chr(47) + "fl":U + fname + '.dat').
     2562     os-er = OS-ERROR.
     2563     if os-er <> 0 then do:
     2564         run write-log-and-file in p-log-handle (
     2565               input 1
     2566             , input log-file-name
     2567             , input 1
     2568             , input substitute( "!!!Ошибки в работе локальной сети или нарушение прав доступа при обмене информацией с кассой &1",
     2569                                   for-cash-desk.cash-num
     2570                               )
     2571                                               ).
     2572         assign
     2573         v-view-log = yes
     2574         .
     2575         return "error":U.
     2576     end.
     2577     run write-log-and-file in p-log-handle (
     2578           input 1
     2579         , input log-file-name
     2580         , input 1
     2581         , input substitute( "Данные выгружены в файл &1",
     2582                               (v-dir-remote  + chr(47) + "fl":U + fname + '.dat')
     2583                           )
     2584                                           ).
     2585   end.
     2586   else do:
     2587     if not g#news
     2588     and not g#auto
     2589     and not g#esys
     2590     then do:
     2591     end.
     2592   end.
     2593     end.
     2594   END CASE.
     2595   END .
     2596   END PROCEDURE.
     2597   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2598   PROCEDURE SENDING:
     2599   _cash-desk:
     2600   FOR EACH ub.cash-desk NO-LOCK WHERE
     2601            ub.cash-desk.db-num = g#db-num AND
     2602            ub.cash-desk.obj-code = i-obj-code AND
     2603           ub.cash-desk.cash-on
     2604   BREAK
     2605   By ub.cash-desk.pos-type :
     2606     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     2607   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2608   define variable dflt-cd18 as character no-undo .
     2609   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2610   define variable v-param-type19 as character no-undo .
     2611   define variable v-value-date19 as date no-undo .
     2612   define variable v-value-decimal19 as decimal no-undo .
     2613   define variable v-value-integer19 as INTEGER no-undo .
     2614   define variable v-value-logical19 AS LOGICAL no-undo .
     2615   define variable v-tth19 as handle no-undo .
     2616   run adm/shattri.p (
     2617       input "get":U
     2618       ,input  'маг':U
     2619       ,input  ub.cash-desk.obj-code
     2620       ,input  'cd-sending':U
     2621       ,input  'dflt-cd':U
     2622       ,output dflt-cd18
     2623       ,output v-value-date19
     2624       ,output v-value-decimal19
     2625       ,output v-value-integer19
     2626       ,output v-value-logical19
     2627       ,output v-param-type19
     2628       ,INPUT-OUTPUT table-handle v-tth19
     2629       ) no-error .
     2630   delete object v-tth19 no-error.
     2631   case ub.cash-desk.pos-type:
     2632       when 'IBM-XML':U or when 'Autotank':U
     2633     then do:
     2634   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2635   run str/get-inis.p (
     2636                   input 'маг':U
     2637                 , input ub.cash-desk.obj-code
     2638                 , input ub.cash-desk.pos-type
     2639                 , input cash-desk.remote
     2640                 , input "send":U
     2641                 , output out
     2642                 , output out2
     2643                 , output in_
     2644                 , output spl
     2645                 , output sav
     2646                 , output v-remote
     2647                 )  no-error .
     2648   if error-status:error then do:
     2649     run write-log-and-file in p-log-handle (
     2650           input 1
     2651         , input log-file-name
     2652         , input 1
     2653         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2654                             , ub.cash-desk.pos-type
     2655                             , ub.cash-desk.obj-code
     2656                             , chr(10)
     2657                             , error-status:get-message(1)
     2658                             , return-value )).
     2659     assign
     2660     v-view-log = yes.
     2661     return error.
     2662   end.
     2663   if ub.cash-desk.pos-type = 'IBM-XML':U
     2664   or ub.cash-desk.pos-type = 'Autotank':U
     2665   then do:
     2666     file-info:file-name = (out  + "undelivered").
     2667     if file-info:FULL-PATHNAME <> ? then do:
     2668       run str/rsndxibm.p ( input parparentproc
     2669                           ,input p-parent-handle
     2670                           ,input p-log-handle
     2671                           ,input out  + "undelivered" ) no-error.
     2672     end.
     2673   end.
     2674     end.
     2675     when 'IBM':U
     2676     then do:
     2677   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2678   run str/get-inis.p (
     2679                   input 'маг':U
     2680                 , input ub.cash-desk.obj-code
     2681                 , input ub.cash-desk.pos-type
     2682                 , input cash-desk.remote
     2683                 , input "send":U
     2684                 , output out
     2685                 , output out2
     2686                 , output in_
     2687                 , output spl
     2688                 , output sav
     2689                 , output v-remote
     2690                 )  no-error .
     2691   if error-status:error then do:
     2692     run write-log-and-file in p-log-handle (
     2693           input 1
     2694         , input log-file-name
     2695         , input 1
     2696         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2697                             , ub.cash-desk.pos-type
     2698                             , ub.cash-desk.obj-code
     2699                             , chr(10)
     2700                             , error-status:get-message(1)
     2701                             , return-value )).
     2702     assign
     2703     v-view-log = yes.
     2704     return error.
     2705   end.
     2706     end.
     2707   END CASE.
     2708       RUN for-cash-cycle no-error.
     2709       if error-status:error then do:
     2710         run write-log-and-file in p-log-handle (
     2711               input 1
     2712             , input log-file-name
     2713             , input 1
     2714             , input substitute("&1 &2", error-status:get-message(1), return-value)
     2715                                                 ).
     2716         assign
     2717         v-view-log = yes
     2718         .
     2719       end.
     2720     END.
     2721     IF LAST-OF(ub.cash-desk.pos-type) then do:
     2722   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2723   case ub.cash-desk.pos-type:
     2724   END CASE.
     2725     END.
     2726   END.
     2727   END PROCEDURE.
     2728   RUN SENDING no-error.
     2729   if error-status:error then do:
     2730     run write-log-and-file in p-log-handle (
     2731           input 1
     2732         , input log-file-name
     2733         , input 1
     2734         , input substitute( "!!!Ошибки при отсылке справочника оснований чеков коррекций на кассы &1&2"
     2735                            , p-obj-type, i-obj-code
     2736                           )
     2737                                           ).
     2738   end.
