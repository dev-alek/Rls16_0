        1   using Ibs.Th.Gbl.*.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id               as recid            no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Список печатных форм документа производства".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       72   define new shared variable RepPathName        as character no-undo .
       73   define new shared variable PrintRubl          as logical   no-undo .
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       76   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       77   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       78   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       79   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       80   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       81   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       82   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       83   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       84   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       85   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       86   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       87   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       88   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       89   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       90   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       91   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       92   define variable vss-include-info2 as character format "X(65)" no-undo
       93   initial "@(#)$Workfile$ $Revision$".
       94       define temp-table Tmp#List no-undo like ub.ord-blank
       95           field id                        as integer
       96           field proc-name                 as character
       97           field proc-param                as character
       98           field print-options             as character
       99           field orient                    as character
      100           field orient-orientation        as character
      101           field orient-font-num           as integer
      102           field font-num                  as character
      103           field filtr                     as character
      104           field view_                     as integer  init 1
      105           field sys-key                   as character
      106           field sys-key-black             as character
      107           field type-parts                as character
      108           field type-parts-enabled        as logical
      109           field type-price                as character
      110           field type-price-enabled        as logical
      111           field type-scale                as character
      112           field type-scale-enabled        as logical
      113           field type-val                  as character
      114           field type-val-enabled          as logical
      115           field sort-name                 as character
      116           field sort-name-enabled         as logical
      117           field sort-gr                   as character
      118           field sort-gr-enabled           as logical
      119           field print-graft               as character
      120           field print-graft-enabled       as logical
      121           field no-vat                    as character
      122           field no-vat-enabled            as logical
      123           index pi is primary unique id
      124           index in-name
      125              blank-name
      126           index lu
      127               last-use
      128       .
      129       define temp-table temp_form-list no-undo
      130           field doc-code  as character
      131           field id        as integer
      132           field doc-type  as character
      133           field status_   as character
      134           field internal  as character
      135           field flag      as character
      136           index pi is primary unique
      137               doc-code
      138               id
      139           index idx
      140               id
      141       .
      142       define temp-table temp_menu-doc_disabled-doc-list no-undo
      143           field doc-code      as character
      144           field blank-name    as character
      145           field reason        as character
      146           index pi is primary unique
      147                   doc-code
      148                   blank-name
      149       .
      150       define variable v-menu-doc-sys-key              as character    no-undo.
      151       define variable v-menu-doc-doc-code             as character    no-undo.
      152       define variable v-menu-doc-doc-type             as character    no-undo.
      153       define variable v-menu-doc-ext-doc-type         as character    no-undo.
      154       define variable v-menu-doc-status_              as character    no-undo.
      155       define variable v-menu-doc-internal             as character    no-undo.
      156       define variable v-menu-doc-flag                 as character    no-undo.
      157       define variable v-menu-doc-item-counter         as integer      no-undo.
      158       define variable v-menu-doc-item-disabled        as logical      no-undo.
      159   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      160   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      161     define variable p-entry   as logical   no-undo .
      162     define variable v-ind as integer   no-undo .
      163     if p-delimiter = "*":U then do:
      164       message
      165         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      166         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      167         view-as alert-box error .
      168       return ? .
      169     end.
      170     assign
      171       p-entry = true
      172     .
      173     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      174       assign
      175         p-entry = false
      176       .
      177       if num-entries( p-list, "*":U ) > 1 then do:
      178         block_check-list:
      179         do v-ind = 1 to num-entries( p-list, p-delimiter )
      180         :
      181           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      182             assign
      183               p-entry = true
      184             .
      185             leave block_check-list .
      186           end.
      187         end.
      188       end.
      189     end.
      190     return p-entry .
      191   end function .
      192       procedure menu-doc-create-menu-item
      193       :
      194       define input parameter p-type   as   character no-undo.
      195       define input parameter p-stat   as   character no-undo.
      196       define input parameter p-intr   as   character no-undo.
      197       define input parameter p-flag   as   character no-undo.
      198       define input parameter param-1  as   character no-undo.
      199       define input parameter param-2  as   character no-undo.
      200       define input parameter param-3  as   character no-undo.
      201       define input parameter param-4  as   character no-undo.
      202       define input parameter param-5  as   character no-undo.
      203       define input parameter param-6  as   character no-undo.
      204       define input parameter param-7  as   character no-undo.
      205       define input parameter param-8  as   character no-undo.
      206       define input parameter param-9  as   character no-undo.
      207       define input parameter param-10 as   character no-undo.
      208       define input parameter param-11 as   character no-undo.
      209       define input parameter param-12 as   character no-undo.
      210       do
      211       on error undo, return error
      212       :
      213           assign
      214               v-menu-doc-item-disabled = yes
      215           .
      216           if v-menu-doc-sys-key <> 'ExpertekIBS':U
      217           and ( ( param-10 <> "":U
      218                   and check-entry-with-mask( v-menu-doc-sys-key, param-10, chr(44) ) = false
      219                 )
      220                 or ( param-12 <> "":U
      221                      and check-entry-with-mask( v-menu-doc-sys-key, param-12, chr(44) ) = true )
      222                    )
      223           then do:
      224               undo, return .
      225           end.
      226           if param-7 = "":U
      227           then do:
      228               undo, return .
      229           end.
      230           if param-1 = '*':U
      231           or lookup( p-type, param-1 ) > 0
      232           then do:
      233               if param-2 = '*':U
      234               or lookup( p-stat, param-2 ) > 0
      235               then do:
      236                   if param-3 = '*':U
      237                   or lookup( p-intr, param-3 ) > 0
      238                   then do:
      239                       if param-4 = '*':U
      240                       or lookup( p-flag, param-4 ) > 0
      241                       then do:
      242                           assign
      243                               v-menu-doc-item-disabled = no
      244                           .
      245                           find first tmp#list
      246                                where tmp#list.blank-name     = param-5
      247                                  and tmp#list.filtr          = param-6
      248                                  and tmp#list.proc-name      = param-7
      249                                  and tmp#list.proc-param     = param-8
      250                                  and tmp#list.print-options  = param-9
      251                                  and tmp#list.sys-key        = param-10
      252                                  and tmp#list.orient         = param-11
      253                                  and tmp#list.sys-key-black  = param-12
      254                           no-error.
      255                           if not available tmp#list
      256                           then do:
      257                               assign
      258                                   v-menu-doc-item-counter = v-menu-doc-item-counter + 1
      259                               .
      260                               create tmp#list.
      261                               assign
      262                                   tmp#list.id             = v-menu-doc-item-counter
      263                                   tmp#list.cli-code       = v-menu-doc-item-counter
      264                                   tmp#list.blank-name     = param-5
      265                                   tmp#list.filtr          = param-6
      266                                   tmp#list.proc-name      = param-7
      267                                   tmp#list.proc-param     = param-8
      268                                   tmp#list.print-options  = param-9
      269                                   tmp#list.sys-key        = param-10
      270                                   tmp#list.orient         = param-11
      271                                   tmp#list.sys-key-black  = param-12
      272                               .
      273                               assign
      274                                   tmp#list.orient-orientation     = entry( 1, tmp#list.orient )
      275                                   tmp#list.orient-font-num        = 7
      276                               .
      277                               assign
      278                                   tmp#list.orient-font-num      = ( if num-entries( tmp#list.orient ) > 1
      279                                                                     then integer( entry( 2, tmp#list.orient ) )
      280                                                                     else 7 )
      281                               no-error.
      282                               if error-status :error
      283                               then do:
      284                                   assign
      285                                       tmp#list.orient-font-num = 7
      286                                   .
      287                               end.
      288                               run menu-doc-set-visible-options in this-procedure (
      289                                     input tmp#list.print-options
      290                                   , output tmp#list.type-parts-enabled
      291                                   , output tmp#list.type-price-enabled
      292                                   , output tmp#list.type-scale-enabled
      293                                   , output tmp#list.type-val-enabled
      294                                   , output tmp#list.sort-name-enabled
      295                                   , output tmp#list.sort-gr-enabled
      296                                   , output tmp#list.print-graft-enabled
      297                                   , output tmp#list.no-vat-enabled
      298                               ).
      299                           end.
      300                       end.
      301                   end.
      302               end.
      303           end.
      304           if v-menu-doc-item-disabled = yes
      305           then do:
      306               find first tmp#list
      307                    where tmp#list.blank-name     = param-5
      308                      and tmp#list.filtr          = param-6
      309                      and tmp#list.proc-name      = param-7
      310                      and tmp#list.proc-param     = param-8
      311                      and tmp#list.print-options  = param-9
      312                      and tmp#list.sys-key        = param-10
      313                      and tmp#list.orient         = param-11
      314                      and tmp#list.sys-key-black  = param-12
      315               no-error.
      316               if available tmp#list
      317               then do:
      318                   find first temp_menu-doc_disabled-doc-list
      319                        where temp_menu-doc_disabled-doc-list.doc-code     = v-menu-doc-doc-code
      320                          and temp_menu-doc_disabled-doc-list.blank-name   = param-5
      321                   no-error.
      322                   if not available temp_menu-doc_disabled-doc-list
      323                   then do:
      324                       create temp_menu-doc_disabled-doc-list.
      325                       assign
      326                           temp_menu-doc_disabled-doc-list.doc-code    = v-menu-doc-doc-code
      327                           temp_menu-doc_disabled-doc-list.blank-name  = param-5
      328                       .
      329                   end.
      330                   if param-1 <> '*':U
      331                   and lookup( p-type, param-1 ) > 0
      332                   then do:
      333                       assign
      334                           temp_menu-doc_disabled-doc-list.reason   = "type":U
      335                       .
      336                   end.
      337                   assign
      338                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      339                   .
      340                   if param-2 <> '*':U
      341                   and lookup( p-stat, param-2 ) > 0
      342                   then do:
      343                       assign
      344                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "stat":U
      345                       .
      346                   end.
      347                   assign
      348                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      349                   .
      350                   if param-3 <> '*':U
      351                   and lookup( p-intr, param-3 ) > 0
      352                   then do:
      353                       assign
      354                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "intr":U
      355                       .
      356                   end.
      357                   assign
      358                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      359                   .
      360                   if param-4 <> '*':U
      361                   and lookup( p-flag, param-4 ) > 0
      362                   then do:
      363                       assign
      364                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "flag":U
      365                       .
      366                   end.
      367                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      368                   then do:
      369                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      370                             input tmp#list.blank-name
      371                           , input tmp#list.sys-key
      372                           , input Tmp#List.sys-key-black
      373                           , output tmp#list.blank-name
      374                       ).
      375                   end.
      376               end.
      377               else do:
      378                   assign
      379                       v-menu-doc-item-disabled = no
      380                   .
      381               end.
      382           end.
      383           if v-menu-doc-item-disabled = no
      384           then do:
      385               find first tmp#list
      386                    where tmp#list.blank-name     = param-5
      387                      and tmp#list.filtr          = param-6
      388                      and tmp#list.proc-name      = param-7
      389                      and tmp#list.proc-param     = param-8
      390                      and tmp#list.print-options  = param-9
      391                      and tmp#list.sys-key        = param-10
      392                      and tmp#list.orient         = param-11
      393                      and tmp#list.sys-key-black  = param-12
      394               no-error.
      395               if available tmp#list
      396               then do:
      397                   find first temp_form-list
      398                        where temp_form-list.doc-code  = v-menu-doc-doc-code
      399                          and temp_form-list.id        = tmp#list.id
      400                   no-error.
      401                   if not available temp_form-list
      402                   then do:
      403                       create temp_form-list.
      404                       assign
      405                           temp_form-list.doc-code  = v-menu-doc-doc-code
      406                           temp_form-list.id        = tmp#list.id
      407                           temp_form-list.doc-type  = v-menu-doc-doc-type
      408                           temp_form-list.status_   = v-menu-doc-status_
      409                           temp_form-list.internal  = v-menu-doc-internal
      410                           temp_form-list.flag      = v-menu-doc-flag
      411                       .
      412                   end.
      413                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      414                   then do:
      415                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      416                             input tmp#list.blank-name
      417                           , input tmp#list.sys-key
      418                           , input Tmp#List.sys-key-black
      419                           , output tmp#list.blank-name
      420                       ).
      421                   end.
      422               end.
      423           end.
      424       end.
      425       end procedure.
      426       procedure menu-doc-set-visible-options :
      427       define input parameter p-print-options          as character        no-undo.
      428       define output parameter p-type-parts-enabled    as logical          no-undo.
      429       define output parameter p-type-price-enabled    as logical          no-undo.
      430       define output parameter p-type-scale-enabled    as logical          no-undo.
      431       define output parameter p-type-val-enabled      as logical          no-undo.
      432       define output parameter p-sort-name-enabled     as logical          no-undo.
      433       define output parameter p-sort-gr-enabled       as logical          no-undo.
      434       define output parameter p-print-graft-enabled   as logical          no-undo.
      435       define output parameter p-no-vat-enabled        as logical          no-undo.
      436       do
      437       on error undo, return error
      438       :
      439           assign
      440               p-type-parts-enabled    = ( if substring( p-print-options, 1, 1 ) = "+" then yes else no )
      441               p-type-price-enabled    = ( if substring( p-print-options, 2, 1 ) = "+" then yes else no )
      442               p-type-scale-enabled    = ( if substring( p-print-options, 3, 1 ) = "+" then yes else no )
      443               p-type-val-enabled      = ( if substring( p-print-options, 4, 1 ) = "+" then yes else no )
      444               p-sort-name-enabled     = ( if substring( p-print-options, 5, 1 ) = "+" then yes else no )
      445               p-sort-gr-enabled       = ( if substring( p-print-options, 6, 1 ) = "+" then yes else no )
      446               p-print-graft-enabled   = ( if substring( p-print-options, 7, 1 ) = "+" then yes else no )
      447               p-no-vat-enabled        = ( if substring( p-print-options, 8, 1 ) = "+" then yes else no )
      448           .
      449       end.
      450       end procedure.
      451       procedure menu-doc-create-options-string :
      452       define input parameter p-tmp-list-id        as integer          no-undo.
      453       define output parameter p-options-string    as character        no-undo.
      454           define buffer buf_tmp#list      for tmp#list.
      455       do
      456       for buf_tmp#list
      457       on error undo, return error
      458       :
      459           find first buf_tmp#list
      460                where buf_tmp#list.id = p-tmp-list-id
      461           .
      462           assign
      463               p-options-string =  ( if trim( buf_tmp#list.type-parts  ) = "+":U then "+":U else "-":U )
      464                                 + ( if trim( buf_tmp#list.type-price  ) = "+":U then "+":U else "-":U )
      465                                 + ( if trim( buf_tmp#list.type-scale  ) = "+":U then "+":U else "-":U )
      466                                 + ( if trim( buf_tmp#list.type-val    ) = "+":U then "+":U else "-":U )
      467                                 + ( if trim( buf_tmp#list.sort-name   ) = "+":U then "+":U else "-":U )
      468                                 + ( if trim( buf_tmp#list.sort-gr     ) = "+":U then "+":U else "-":U )
      469                                 + ( if trim( buf_tmp#list.print-graft ) = "+":U then "+":U else "-":U )
      470                                 + ( if trim( buf_tmp#list.no-vat      ) = "+":U then "+":U else "-":U )
      471           .
      472       end.
      473       end procedure.
      474       procedure menu-doc-set-options-string :
      475       define input parameter p-tmp-list-id            as integer          no-undo.
      476       define input parameter p-options-string         as character        no-undo.
      477           define buffer buf_tmp#list      for tmp#list.
      478       do
      479       for buf_tmp#list
      480       on error undo, return error
      481       :
      482           find first buf_tmp#list
      483                where buf_tmp#list.id = p-tmp-list-id
      484           .
      485           assign
      486               buf_tmp#list.type-parts  = ( if buf_tmp#list.type-parts-enabled     = yes then substitute( "  &1", substring( p-options-string, 1, 1 ) ) else " ":U )
      487               buf_tmp#list.type-price  = ( if buf_tmp#list.type-price-enabled     = yes then substitute( "  &1", substring( p-options-string, 2, 1 ) ) else " ":U )
      488               buf_tmp#list.type-scale  = ( if buf_tmp#list.type-scale-enabled     = yes then substitute( "  &1", substring( p-options-string, 3, 1 ) ) else " ":U )
      489               buf_tmp#list.type-val    = ( if buf_tmp#list.type-val-enabled       = yes then substitute( "  &1", substring( p-options-string, 4, 1 ) ) else " ":U )
      490               buf_tmp#list.sort-name   = ( if buf_tmp#list.sort-name-enabled      = yes then substitute( "  &1", substring( p-options-string, 5, 1 ) ) else " ":U )
      491               buf_tmp#list.sort-gr     = ( if buf_tmp#list.sort-gr-enabled        = yes then substitute( "  &1", substring( p-options-string, 6, 1 ) ) else " ":U )
      492               buf_tmp#list.print-graft = ( if buf_tmp#list.print-graft-enabled    = yes then substitute( "  &1", substring( p-options-string, 7, 1 ) ) else " ":U )
      493               buf_tmp#list.no-vat      = ( if buf_tmp#list.no-vat-enabled         = yes then substitute( "  &1", substring( p-options-string, 8, 1 ) ) else " ":U )
      494           .
      495       end.
      496       end procedure.
      497       procedure menu-doc-create-options-enabled-string :
      498       define input parameter p-tmp-list-id                as integer          no-undo.
      499       define output parameter p-options-enabled-string    as character        no-undo.
      500           define buffer buf_tmp#list      for tmp#list.
      501       do
      502       for buf_tmp#list
      503       on error undo, return error
      504       :
      505           find first buf_tmp#list
      506                where buf_tmp#list.id = p-tmp-list-id
      507           .
      508           assign
      509               p-options-enabled-string =  ( if buf_tmp#list.type-parts-enabled  = yes then "+":U else "-":U )
      510                                         + ( if buf_tmp#list.type-price-enabled  = yes then "+":U else "-":U )
      511                                         + ( if buf_tmp#list.type-scale-enabled  = yes then "+":U else "-":U )
      512                                         + ( if buf_tmp#list.type-val-enabled    = yes then "+":U else "-":U )
      513                                         + ( if buf_tmp#list.sort-name-enabled   = yes then "+":U else "-":U )
      514                                         + ( if buf_tmp#list.sort-gr-enabled     = yes then "+":U else "-":U )
      515                                         + ( if buf_tmp#list.print-graft-enabled = yes then "+":U else "-":U )
      516                                         + ( if buf_tmp#list.no-vat-enabled      = yes then "+":U else "-":U )
      517           .
      518       end.
      519       end procedure.
      520       procedure menu-doc-extend-blank-name-for-IBS :
      521       define input parameter p-in-blank-name      as character        no-undo.
      522       define input parameter p-sys-key            as character        no-undo.
      523       define input parameter p-sys-key-black      as character        no-undo.
      524       define output parameter p-out-blank-name    as character        no-undo.
      525       do
      526       on error undo, return error
      527       :
      528           assign
      529               p-out-blank-name = p-in-blank-name
      530           .
      531           if p-sys-key <> "":U
      532           then do:
      533               assign
      534                   p-out-blank-name = substring( p-in-blank-name + " '" + p-sys-key + "'" , 1, 120 )
      535               .
      536           end.
      537           if p-sys-key-black <> ""
      538           then do:
      539               assign
      540                   p-out-blank-name = substring( p-in-blank-name + " no-'" + p-sys-key-black + "'", 1, 120 )
      541               .
      542           end.
      543       end.
      544       end procedure.
      545   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546     define variable v-cntxt-db-num        as integer   no-undo .
      547     define variable v-cntxt-userid        as character no-undo .
      548     define variable v-cntxt-level         as character no-undo .
      549     define variable v-cntxt-host-code-obj as integer   no-undo .
      550     define variable v-cntxt-obj-type      as character no-undo .
      551     define variable v-cntxt-obj-code      as integer   no-undo .
      552     define variable v-cntxt-db-num-obj    as integer   no-undo .
      553     define variable v-cntxt-is-admin      as logical   no-undo .
      554   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      557   define variable par-type          as character no-undo.
      558   define variable v-value-character as character no-undo .
      559   define variable v-value-date      as date      no-undo .
      560   define variable v-value-decimal   as decimal   no-undo .
      561   define variable v-value-integer   as integer   no-undo .
      562   define variable v-value-logical   as logical   no-undo .
      563   procedure proc-alt-shift-f2:
      564     if not ibs.th.gbl.gbl-var:rcode
      565   then
      566     run gbl\inidebug.p .
      567   end.
      568   procedure proc-alt-shift-f3:
      569     run gbl/prvssinf.p
      570       ( input this-procedure
      571       ) .
      572   end.
      573   define variable v-inform-launched as logical no-undo initial false .
      574   procedure proc-alt-shift-f4:
      575     define variable v-action as character no-undo .
      576     if v-inform-launched = false then do:
      577       assign
      578         v-inform-launched = true
      579       .
      580       run gbl/d-inform.w
      581         (  input self
      582         ,  input this-procedure
      583         , output v-action
      584         ) no-error .
      585       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      586       assign
      587         v-inform-launched = false
      588       .
      589     end.
      590   end.
      591   procedure proc-alt-f1:
      592     run gbl/corrhelp.p
      593       (input this-procedure
      594       ) .
      595   end .
      596   on alt-shift-f2 anywhere do:
      597     run proc-alt-shift-f2.
      598   end.
      599   on alt-shift-f3 anywhere do:
      600     run proc-alt-shift-f3 in this-procedure .
      601   end.
      602   on alt-shift-f4 anywhere do:
      603     run proc-alt-shift-f4 in this-procedure.
      604   end.
      605   on alt-f1 anywhere do:
      606     run proc-alt-f1 in this-procedure .
      607   end.
      608   define new shared variable CostPrice    as logical                          no-undo.
      609   define variable ii              as integer          no-undo.
      610   define variable Nesoot_Flag     as logical          no-undo.
      611   define variable stat            as logical          no-undo.
      612   define variable in-docprvalue   as character        no-undo.
      613   define variable in-docprtype    as character        no-undo.
      614   define variable List_           as character        no-undo.
      615   define variable sys-key         as character        no-undo.
      616   define variable g#report-num    as integer      no-undo.
      617   define variable g#quest-print   as logical      no-undo.
      618   define variable g#log           as logical      no-undo.
      619   def new shared var v-rep-util as class ReportXsltUtil no-undo.
      620   DEFINE NEW SHARED BUFFER clients FOR ub.clients.
      621   define buffer buf_usr-flt for ubflt.usr-flt .
      622   DEFINE BUTTON b-chg
      623        LABEL "&Изменить"
      624        SIZE 10 BY 1.
      625   DEFINE BUTTON b-erase
      626        LABEL "&Снять все *":L
      627        SIZE 13.13 BY 1 TOOLTIP "Снять все отметки"
      628        BGCOLOR 8 .
      629   DEFINE BUTTON b-exit AUTO-END-KEY
      630        LABEL "&Выход ":L
      631        SIZE 10 BY 1
      632        BGCOLOR 8 .
      633   DEFINE BUTTON b-help
      634        LABEL "&Помощь":L
      635        SIZE 10 BY 1
      636        BGCOLOR 8 .
      637   DEFINE BUTTON b-mark
      638        LABEL "&*":L
      639        SIZE 3.63 BY 1
      640        BGCOLOR 8 .
      641   DEFINE BUTTON b-print
      642        LABEL "Пе&чать":L
      643        SIZE 10 BY 1
      644        BGCOLOR 8 .
      645   DEFINE VARIABLE v-printer-name AS CHARACTER FORMAT "X(256)":U
      646        LABEL "Текущий принтер"
      647         VIEW-AS TEXT
      648        SIZE 53 BY .67
      649        FGCOLOR 4  NO-UNDO.
      650   DEFINE VARIABLE tg-detail AS LOGICAL INITIAL no
      651        LABEL "Детализация"
      652        VIEW-AS TOGGLE-BOX
      653        SIZE 19.75 BY .83 NO-UNDO.
      654   DEFINE VARIABLE tg-fat AS LOGICAL INITIAL no
      655        LABEL "Калорийность"
      656        VIEW-AS TOGGLE-BOX
      657        SIZE 15.5 BY .83 NO-UNDO.
      658   DEFINE VARIABLE tg-rubl AS LOGICAL INITIAL no
      659        LABEL "Печать в "
      660        VIEW-AS TOGGLE-BOX
      661        SIZE 19.75 BY .83 NO-UNDO.
      662   DEFINE QUERY BROWSE-2 FOR
      663         Tmp#List SCROLLING.
      664   DEFINE BROWSE BROWSE-2
      665     QUERY BROWSE-2 DISPLAY
      666         Tmp#List.last-use COLUMN-LABEL "*" FORMAT "*/"
      667         Tmp#List.blank-name COLUMN-LABEL "Название документа":C59 FORMAT "X(59)"
      668         Tmp#List.type-price column-label "уч.ц."    format "X(5)"
      669     ENABLE
      670         Tmp#List.last-use
      671       WITH NO-BOX NO-ROW-MARKERS SEPARATORS SIZE 70.13 BY 17.54.
      672   DEFINE FRAME Dialog-Frame
      673        b-chg AT ROW 1 COL 36 WIDGET-ID 2
      674        b-print AT ROW 1 COL 51
      675        b-help AT ROW 1 COL 61
      676        b-exit AT ROW 1.04 COL 2.13
      677        b-mark AT ROW 1.04 COL 12.13
      678        b-erase AT ROW 1.04 COL 15.88
      679        BROWSE-2 AT ROW 2.25 COL 1.38
      680        tg-rubl AT ROW 20.04 COL 2.5
      681        tg-fat AT ROW 20.04 COL 45.38 WIDGET-ID 4
      682        tg-detail AT ROW 20.96 COL 2.5
      683        v-printer-name AT ROW 22 COL 17 COLON-ALIGNED
      684        SPACE(0.62) SKIP(0.32)
      685       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      686            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      687            TITLE "".
      688   ASSIGN
      689          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      690          FRAME Dialog-Frame:HIDDEN           = TRUE.
      691   ASSIGN
      692          BROWSE-2:MAX-DATA-GUESS IN FRAME Dialog-Frame         = 200.
      693   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      694   DO:
      695     APPLY "END-ERROR":U TO SELF.
      696   END.
      697   ON 1 OF BROWSE-2 IN FRAME Dialog-Frame
      698   DO:
      699       if available tmp#list
      700       then do:
      701           if tmp#list.type-price = "  +":U
      702           or tmp#list.type-price = "  -":U
      703           then do:
      704               assign
      705                   tmp#list.type-price = ( if tmp#list.type-price = "  +":U then "  -":U else "  +":U )
      706               .
      707           end.
      708           BROWSE-2 :refresh().
      709       end.
      710   END.
      711   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      712   DO:
      713       if available tmp#list
      714       then do:
      715           define variable v-options-string            as character    no-undo.
      716           define variable v-options-string-new        as character    no-undo.
      717           define variable v-options-enabled-string    as character    no-undo.
      718           run menu-doc-create-options-string in this-procedure (
      719                 input tmp#list.id
      720               , output v-options-string
      721           ).
      722           run menu-doc-create-options-enabled-string in this-procedure (
      723                 input tmp#list.id
      724               , output v-options-enabled-string
      725           ).
      726           run str/fbrdprnd.w (
      727                 input tmp#list.blank-name
      728               , input v-options-string
      729               , input v-options-enabled-string
      730               , output v-options-string-new
      731           ) no-error.
      732           if error-status :error
      733           then do:
      734               message
      735                        vss-workfile vss-revision vss-description
      736                   skip(1)
      737                   skip "Ошибка изменения параметров печати."
      738                   skip return-value
      739                   skip trim(error-status :get-message(1))
      740                        trim(error-status :get-message(2))
      741                        trim(error-status :get-message(3))
      742               view-as alert-box error.
      743               undo, return no-apply .
      744           end.
      745           if v-options-string-new <> v-options-string
      746           then do:
      747               run menu-doc-set-options-string in this-procedure (
      748                       input tmp#list.id
      749                     , input v-options-string-new
      750               ).
      751               browse BROWSE-2 :refresh().
      752               apply "entry" to BROWSE-2 in frame Dialog-Frame.
      753           end.
      754       end.
      755   END.
      756   ON CHOOSE OF b-erase IN FRAME Dialog-Frame
      757   DO:
      758     For each Tmp#List share-lock :
      759         Tmp#List.last-use=false.
      760     End.
      761       OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.cli-code.
      762   END.
      763   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      764   OR MOUSE-SELECT-DBLCLICK OF BROWSE-2 IN FRAME Dialog-Frame
      765   DO:
      766       if not available tmp#list
      767       then do:
      768           message "Неправильный выбор строки.".
      769           return no-apply.
      770       end.
      771       BROWSE-2 :refresh ().
      772       if Tmp#List.last-use = true
      773       then do:
      774           assign
      775               Tmp#List.last-use = false
      776           .
      777           display
      778               "" @ Tmp#List.last-use
      779           with browse BROWSE-2.
      780       end.
      781       else do:
      782           assign
      783               Tmp#List.last-use = true
      784           .
      785           display
      786               "*" @ Tmp#List.last-use
      787           with browse BROWSE-2.
      788       end.
      789       apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
      790       assign
      791           g#log = BROWSE-2:select-next-row ()
      792       .
      793   END.
      794   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      795   DO:
      796     define variable lok as logical no-undo .
      797   define variable         PrintDoc              as      logical no-undo .
      798   define variable         PrintSet              as      logical no-undo .
      799   define variable         Print-Round           AS      LOGICAL INITIAL yes no-undo .
      800       define variable l-recid as recid no-undo .
      801       Assign
      802           List_ = ''
      803           ii = 0
      804           l-recid = recid(Tmp#List)
      805       .
      806       For each Tmp#List
      807       :
      808           if Tmp#List.last-use <> false
      809           then Assign
      810               ii = ii + 1
      811               List_ = List_ + ',' + string(tmp#list.id)
      812           .
      813       End.
      814       if ii = 0
      815       then do:
      816           Message
      817               "Отметьте формы документа для печати!"
      818           view-as alert-box information
      819           title "Внимание !".
      820           find first Tmp#List no-lock
      821                where l-recid = recid(Tmp#List)
      822           .
      823           return no-apply.
      824       end.
      825   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      826   empty temp-table thbjattr_thbj-attr.
      827   run adm/shattri.p (
      828      input "get":U
      829     ,input v-cntxt-obj-type
      830     ,input v-cntxt-obj-code
      831     ,input 'prt-obj':U
      832     ,input  ""
      833     ,output v-value-character
      834     ,output v-value-date
      835     ,output v-value-decimal
      836     ,output v-value-integer
      837     ,output v-value-logical
      838     ,output par-type
      839     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      840     ) no-error .
      841   for each thbjattr_thbj-attr :
      842       if thbjattr_thbj-attr.prop-code = 'in-docpr' then in-docprvalue =  thbjattr_thbj-attr.property-value-character .
      843   end.
      844       run save-form-parameters in this-procedure.
      845       if g#quest-print = true  THEN DO:
      846       output  to value( string( session:temp-directory + "$" + string( g#report-num ) ) ) .
      847       OUTPUT CLOSE.
      848       End.
      849       v-rep-util = new ReportXsltUtil(string( session :temp-directory ) + "rpt" + string( g#report-num )).
      850       for each tmp#list no-lock
      851           where tmp#list.last-use = yes
      852       :
      853           assign
      854               CostPrice   = ( trim( tmp#list.type-price ) = "+":U )
      855           .
      856           v-rep-util:begin-report().
      857           case num-entries(tmp#list.proc-param)
      858           :
      859               when 0
      860               then do:
      861                   run value (tmp#list.proc-name)  (
      862                         input p-mainmenu-handle
      863                       , input rec_id
      864                       , input tg-rubl
      865                       , input tg-detail
      866                       , INPUT tg-fat
      867                   ).
      868               end.
      869               when 1
      870               then do:
      871                   run value (tmp#list.proc-name)  (
      872                         input p-mainmenu-handle
      873                       , input rec_id
      874                       , input tg-rubl
      875                       , input tg-detail
      876                       , input tmp#list.proc-param
      877                   ).
      878               end.
      879               when 2
      880               then do:
      881                   run value (tmp#list.proc-name)  (
      882                         input p-mainmenu-handle
      883                       , input rec_id
      884                       , input tg-rubl
      885                       , input tg-detail
      886                       , INPUT tg-fat
      887                       , input entry(1,tmp#list.proc-param)
      888                       , input entry(2,tmp#list.proc-param)
      889                   ).
      890               end.
      891               when 3
      892               then do:
      893                   message "Для документа производства число параметров не может быть равно 3"
      894                       view-as alert-box.
      895               end.
      896               when 4
      897               then do:
      898                   run value (tmp#list.proc-name) (
      899                         input p-mainmenu-handle
      900                       , input rec_id
      901                       , input tg-rubl
      902                       , input tg-detail
      903                       , input entry(1,tmp#list.proc-param)
      904                       , input entry(2,tmp#list.proc-param)
      905                       , input entry(3,tmp#list.proc-param)
      906                       , input entry(4,tmp#list.proc-param)
      907                   ).
      908               end.
      909               when 5
      910               then do:
      911                   message
      912                       "Для документа производства число параметров не может быть больше 4"
      913                   view-as alert-box.
      914                   undo, return no-apply .
      915               end.
      916           end case.
      917           v-rep-util:end-report().
      918       end.
      919       v-rep-util:write-config().
      920       delete object v-rep-util.
      921   if session :set-wait-state( "" ) then.
      922       if g#quest-print = true
      923       then do:
      924           OS-DELETE
      925              value( string( session:temp-directory) + "rpt" + string( g#report-num )  )    .
      926           OS-RENAME
      927              value(  string( session:temp-directory) + "$" + string( g#report-num )     )
      928              value(  string( session:temp-directory) + "rpt" + string( g#report-num )) .
      929           IF ii = 1 and
      930               ((can-find (first tmp#list where CAPS(Tmp#list.proc-name) = "rep/xl-prtcl.p":U and Tmp#List.last-use = true) = true  ) OR
      931                (can-find (first tmp#list where CAPS(Tmp#list.proc-name) = "rep/tick-doc.p":U and Tmp#List.last-use = true) = true  ))
      932                then do:
      933   if session :set-wait-state( "" ) then.
      934                end.
      935                ELSE DO :
      936                 find first tmp#list where  Tmp#List.last-use = true no-lock no-error .
      937                   define variable v-user-action           as character            no-undo.
      938                   define variable v-printed               as logical              no-undo.
      939                 case Tmp#list.orient :
      940                     when 'A4port' then do:
      941                           run gbl/prnfilen.w (
      942                                 input "":U
      943                               , input 4
      944                               , input string( session :temp-directory ) + "rpt" + string( g#report-num )
      945                               , input 7
      946                               , output v-user-action
      947                               , output v-printed
      948                           ) .
      949                     end.
      950                     when 'A4lans' or when "" then do:
      951                           run gbl/prnfilen.w (
      952                                 input "":U
      953                               , input 8
      954                               , input string( session :temp-directory ) + "rpt" + string( g#report-num )
      955                               , input 7
      956                               , output v-user-action
      957                               , output v-printed
      958                           ) .
      959                     end.
      960                 End case.
      961                End.
      962         end.
      963      Else  Message 'Задание распечатано'.
      964   END.
      965   ON ROW-DISPLAY OF BROWSE-2 IN FRAME Dialog-Frame
      966   DO:
      967     if Tmp#List.orient = 'A4port' OR
      968        Tmp#List.orient = 'A3port'
      969     then DO:
      970         Tmp#List.last-use          :fgcolor in browse BROWSE-2 = blue_color.
      971         Tmp#List.blank-name        :fgcolor in browse BROWSE-2 = blue_color.
      972     End.
      973     else do:
      974         if Tmp#List.orient = 'EXCEL' OR
      975            Tmp#List.orient = 'self'
      976         then DO:
      977                 Tmp#List.last-use   :fgcolor in browse BROWSE-2 = CYAN_COLOR.
      978                 Tmp#List.blank-name :fgcolor in browse BROWSE-2 = CYAN_COLOR.
      979         end.
      980         else do:
      981             Tmp#List.last-use   :fgcolor in browse BROWSE-2 = black_color.
      982             Tmp#List.blank-name :fgcolor in browse BROWSE-2 = black_color.
      983         end.
      984     end.
      985     if tmp#list.type-price-enabled = no
      986     then do:
      987         assign
      988             Tmp#List.type-price :bgcolor in browse BROWSE-2 = GREY_COLOR
      989         .
      990     end.
      991   END.
      992   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   on help of frame Dialog-Frame
      994   do:
      995     run gbl/app_help.p
      996       (input this-procedure :file-name
      997       ,input ''
      998       ,input ?
      999       ) no-error.
     1000     if error-status :error then do:
     1001       message
     1002         "Ошибка при вызове помощи"
     1003         error-status :get-message(1)
     1004         view-as alert-box .
     1005     end.
     1006   end.
     1007   run minbtn-set in this-procedure .
     1008   on choose of b-help in frame Dialog-Frame
     1009   do:
     1010     apply "help":u to frame Dialog-Frame .
     1011   end.
     1012   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1013   procedure minbtn-set :
     1014       do
     1015           on error undo, return error return-value
     1016           :
     1017           define variable ii              as integer       no-undo .
     1018           define variable fh              as widget-handle no-undo .
     1019           define variable hh              as widget-handle no-undo .
     1020           define variable v-h             as handle        extent 4 no-undo .
     1021           define variable v-name-button   as character     no-undo .
     1022           define variable v-help-old-x    as decimal       no-undo .
     1023           define variable v-help-old-y    as decimal       no-undo .
     1024           define variable v-help-old-size as decimal       no-undo .
     1025           define variable v-frame-width   as decimal       no-undo .
     1026           define variable jj              as integer       no-undo .
     1027           do
     1028               on error undo, return error
     1029               :
     1030               assign
     1031                   v-frame-width = frame Dialog-Frame:width - 0.3
     1032                   fh            = frame Dialog-Frame:first-child
     1033                   hh            = fh:first-child
     1034                   ii            = 1
     1035                   .
     1036               do while valid-handle(hh):
     1037                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1038                   do:
     1039                       case lc(hh:name) :
     1040                           when "b-help" then
     1041                               do:
     1042                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1043                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1044                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1045                                   hh:TOOLTIP = "Помощь" .
     1046                                   v-help-old-x = hh:column .
     1047                                   v-help-old-y = hh:row    .
     1048                                   v-help-old-size = hh:width .
     1049                                   hh:width-chars = 2.5 .
     1050                               end.
     1051                           when "b-print" then
     1052                               do:
     1053                                   hh:load-image("cmp/b-print.bmp":u) .
     1054                                   hh:TOOLTIP = "Печать" .
     1055                                   v-h[ii] = hh:handle .
     1056                                   ii = ii + 1 .
     1057                                   hh:width-chars = 3 .
     1058                               end.
     1059                           when "b-history" or
     1060                           when "b-hist" then
     1061                               do:
     1062                                   hh:load-image("cmp/b-hist.bmp":u) .
     1063                                   hh:TOOLTIP = "История" .
     1064                                   v-h[ii] = hh:handle .
     1065                                   ii = ii + 1 .
     1066                                   hh:width-chars = 3 .
     1067                               end.
     1068                           when "b-sch" then
     1069                               do:
     1070                                   hh:load-image("cmp/b-sch.bmp":u) .
     1071                                   hh:TOOLTIP = "Установка Фильтра" .
     1072                                   v-h[ii] = hh:handle .
     1073                                   ii = ii + 1 .
     1074                                   hh:width-chars = 3 .
     1075                               end.
     1076                           when "b-hist-user" then
     1077                               do:
     1078                                   hh:load-image("cmp/b-hist.bmp":u) .
     1079                                   hh:TOOLTIP = "История пользователя" .
     1080                                   ii = ii + 1 .
     1081                               end.
     1082                       end case.
     1083                   end.
     1084                   hh = hh:next-sibling.
     1085               end.
     1086               b-help:column = v-frame-width - b-help:width-chars.
     1087               jj = 0.
     1088               repeat ii = 4 to 1 by -1 :
     1089                   if valid-handle (v-h[ii] ) then
     1090                   do:
     1091                       jj  = jj + 1 .
     1092                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1093                       v-h[ii]:row    = v-help-old-y .
     1094                   end.
     1095               end.
     1096           end.
     1097       end.
     1098   end procedure.
     1099   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1100   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1101   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1102   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1103   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1104   define variable v-diasize-current-frame-height as decimal   no-undo .
     1105   define variable v-diasize-change-size          as logical   no-undo .
     1106   define variable v-diasize-resize-button        as handle    no-undo .
     1107   define variable v-diasize-wndmax               as logical   no-undo .
     1108   define variable v-diasize-wndstore             as logical   no-undo .
     1109   define variable v-diasize-proc-name            as character no-undo .
     1110   define variable v-diasize-browse-handle        as handle    no-undo .
     1111   define variable v-diasize-browse-number        as integer   no-undo .
     1112   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1113   define temp-table temp-diasize-handle no-undo
     1114     field handle-value  as handle
     1115     field save-position as decimal
     1116     index xpk is primary unique handle-value
     1117     .
     1118   define temp-table temp-browse-handle no-undo
     1119     field browse-type   as character
     1120     field browse-number as integer
     1121     field browse-handle as handle
     1122     field original-size as decimal
     1123     index xpk is primary unique browse-type browse-number
     1124     index xie browse-type browse-handle
     1125   .
     1126   procedure diasize_change-height :
     1127     define input  parameter p-change-value  as decimal   no-undo .
     1128     define input  parameter p-move-resize   as logical   no-undo .
     1129     define variable v-field-group-handle    as handle    no-undo .
     1130     define variable v-object-handle         as handle    no-undo .
     1131     define variable v-frame-height          as decimal   no-undo .
     1132     define variable v-frame-virtual-height  as decimal   no-undo .
     1133     define variable v-browse-height         as decimal   no-undo .
     1134     define variable v-window-height         as decimal   no-undo .
     1135     define variable v-window-virtual-height as decimal   no-undo .
     1136     define variable v-change-sign           as integer   no-undo .
     1137     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1138     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1139     if p-change-value > 0
     1140     then do:
     1141       if frame Dialog-Frame :height + p-change-value
     1142           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1143       then do:
     1144         assign
     1145           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1146                           - (frame Dialog-Frame :height-chars)
     1147         .
     1148         if p-change-value <= 0
     1149         then do:
     1150           run diasize_position-resize-button in this-procedure .
     1151           return .
     1152         end.
     1153       end.
     1154     end.
     1155     if p-change-value < 0
     1156     then do:
     1157       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1158       then do:
     1159         assign
     1160           p-change-value = v-diasize-orig-frame-height
     1161                          - (frame Dialog-Frame :height-chars)
     1162         .
     1163         if p-change-value >= 0
     1164         then do:
     1165           run diasize_position-resize-button in this-procedure .
     1166           return .
     1167         end.
     1168       end.
     1169     end.
     1170     if p-change-value >= 0
     1171     then do:
     1172       assign
     1173         v-change-sign = 1
     1174       .
     1175     end.
     1176     else do:
     1177       assign
     1178         v-change-sign = -1
     1179       .
     1180     end.
     1181     assign
     1182       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1183     .
     1184     if p-change-value = 0
     1185     then do:
     1186       run diasize_position-resize-button in this-procedure .
     1187       return .
     1188     end.
     1189     move_block:
     1190     do
     1191     on error undo move_block, retry move_block
     1192     :
     1193       if retry
     1194       then do:
     1195         do
     1196         on error undo move_block, leave move_block
     1197         :
     1198           if p-change-value > 0
     1199           then do:
     1200             for each buf_temp-diasize-handle
     1201             on error undo, next
     1202             :
     1203               assign
     1204                 v-object-handle = buf_temp-diasize-handle.handle-value
     1205               .
     1206               if v-object-handle <> v-diasize-resize-button
     1207               then do:
     1208                 assign
     1209                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1210                 .
     1211               end.
     1212             end.
     1213             assign
     1214               v-diasize-browse-handle :height = v-browse-height
     1215             .
     1216             for each buf_temp-browse-handle
     1217               where buf_temp-browse-handle.browse-type = 'height':u
     1218             on error undo, next
     1219             :
     1220               assign
     1221                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1222               .
     1223             end.
     1224             assign
     1225               frame Dialog-Frame :height = v-frame-height
     1226             .
     1227             if frame Dialog-Frame :scrollable = true
     1228             then do:
     1229               assign
     1230                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1231               .
     1232             end.
     1233             run diasize_position-resize-button in this-procedure .
     1234           end.
     1235           else do:
     1236             if frame Dialog-Frame :scrollable = true
     1237             then do:
     1238               assign
     1239                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1240               .
     1241             end.
     1242             assign
     1243               frame Dialog-Frame :height = v-frame-height
     1244             .
     1245             assign
     1246               v-diasize-browse-handle :height = v-browse-height
     1247             .
     1248             for each buf_temp-browse-handle
     1249               where buf_temp-browse-handle.browse-type = 'height':u
     1250             on error undo, next
     1251             :
     1252               assign
     1253                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1254               .
     1255             end.
     1256             for each buf_temp-diasize-handle
     1257             on error undo, next
     1258             :
     1259               assign
     1260                 v-object-handle = buf_temp-diasize-handle.handle-value
     1261               .
     1262               if v-object-handle <> v-diasize-resize-button
     1263               then do:
     1264                 assign
     1265                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1266                 .
     1267               end.
     1268             end.
     1269             run diasize_position-resize-button in this-procedure .
     1270           end.
     1271           assign
     1272             v-diasize-change-size = false
     1273           .
     1274           leave move_block .
     1275         end.
     1276       end.
     1277       assign
     1278         v-diasize-need-full-display = true
     1279       .
     1280       if v-diasize-change-size = false
     1281       then do:
     1282         assign
     1283           v-diasize-change-size = true
     1284         .
     1285       end.
     1286       else do:
     1287         return .
     1288       end.
     1289       assign
     1290         v-frame-height = frame Dialog-Frame :height
     1291         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1292         v-browse-height = v-diasize-browse-handle :height
     1293       .
     1294       for each buf_temp-browse-handle
     1295         where buf_temp-browse-handle.browse-type = 'height':u
     1296       :
     1297         assign
     1298           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1299         .
     1300       end.
     1301       for each buf_temp-diasize-handle
     1302       :
     1303         delete buf_temp-diasize-handle .
     1304       end.
     1305       assign
     1306         v-field-group-handle = frame Dialog-Frame :first-child
     1307       .
     1308       do while valid-handle(v-field-group-handle)
     1309       :
     1310         assign
     1311           v-object-handle = v-field-group-handle :first-child
     1312         .
     1313         do while valid-handle(v-object-handle)
     1314         :
     1315           if  v-object-handle <> v-diasize-browse-handle :handle
     1316           and can-query(v-object-handle, "row")
     1317           and can-query(v-object-handle, "height")
     1318           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1319           then do:
     1320             find first buf_temp-browse-handle
     1321               where buf_temp-browse-handle.browse-type   = 'height':u
     1322                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1323               no-error .
     1324             if available buf_temp-browse-handle
     1325             then do:
     1326             end.
     1327             else do:
     1328               create buf_temp-diasize-handle .
     1329               assign
     1330                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1331                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1332               .
     1333             end.
     1334           end.
     1335           assign
     1336             v-object-handle = v-object-handle :next-sibling
     1337           .
     1338         end.
     1339         assign
     1340           v-field-group-handle = v-field-group-handle :next-sibling
     1341         .
     1342       end.
     1343       do with frame Dialog-Frame
     1344       :
     1345         hide v-diasize-resize-button .
     1346         assign
     1347           v-diasize-resize-button :row    = 1
     1348           v-diasize-resize-button :column = 1
     1349         .
     1350       end.
     1351       if p-change-value > 0
     1352       then do:
     1353         if frame Dialog-Frame :scrollable = true
     1354         then do:
     1355           assign
     1356             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1357             no-error .
     1358           if error-status :error
     1359           or error-status :get-message(1) <> ""
     1360           then do:
     1361             undo move_block, retry move_block .
     1362           end.
     1363         end.
     1364         assign
     1365           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1366           no-error .
     1367         if error-status :error
     1368         or error-status :get-message(1) <> ""
     1369         then do:
     1370           undo move_block, retry move_block .
     1371         end.
     1372         assign
     1373           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1374           no-error .
     1375         if error-status :error
     1376         or error-status :get-message(1) <> ""
     1377         then do:
     1378           undo move_block, retry move_block .
     1379         end.
     1380         for each buf_temp-browse-handle
     1381           where buf_temp-browse-handle.browse-type = 'height':u
     1382         on error undo move_block, retry move_block
     1383         :
     1384           assign
     1385             buf_temp-browse-handle.browse-handle :height
     1386               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1387             no-error .
     1388           if error-status :error
     1389           or error-status :get-message(1) <> ""
     1390           then do:
     1391             undo move_block, retry move_block .
     1392           end.
     1393         end.
     1394         for each buf_temp-diasize-handle
     1395         on error undo move_block, retry move_block
     1396         :
     1397           assign
     1398             v-object-handle = buf_temp-diasize-handle.handle-value
     1399           .
     1400           if v-object-handle <> v-diasize-resize-button
     1401           then do:
     1402             assign
     1403               v-object-handle :row = v-object-handle :row + p-change-value
     1404               no-error .
     1405             if error-status :error
     1406             or error-status :get-message(1) <> ""
     1407             then do:
     1408               undo move_block, retry move_block .
     1409             end.
     1410           end.
     1411         end.
     1412       end.
     1413       else do:
     1414         for each buf_temp-diasize-handle
     1415         on error undo move_block, retry move_block
     1416         :
     1417           assign
     1418             v-object-handle = buf_temp-diasize-handle.handle-value
     1419           .
     1420           if v-object-handle <> v-diasize-resize-button
     1421           then do:
     1422             assign
     1423               v-object-handle :row = v-object-handle :row + p-change-value
     1424               no-error .
     1425             if error-status :error
     1426             or error-status :get-message(1) <> ""
     1427             then do:
     1428               undo move_block, retry move_block .
     1429             end.
     1430           end.
     1431         end.
     1432         assign
     1433           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1434           no-error .
     1435         if error-status :error
     1436         or error-status :get-message(1) <> ""
     1437         then do:
     1438           undo move_block, retry move_block .
     1439         end.
     1440         for each buf_temp-browse-handle
     1441           where buf_temp-browse-handle.browse-type = 'height':u
     1442         on error undo move_block, retry move_block
     1443         :
     1444           assign
     1445             buf_temp-browse-handle.browse-handle :height
     1446               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1447             no-error .
     1448           if error-status :error
     1449           or error-status :get-message(1) <> ""
     1450           then do:
     1451             undo move_block, retry move_block .
     1452           end.
     1453         end.
     1454         assign
     1455           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1456           no-error .
     1457         if error-status :error
     1458         or error-status :get-message(1) <> ""
     1459         then do:
     1460           undo move_block, retry move_block .
     1461         end.
     1462         if frame Dialog-Frame :scrollable = true
     1463         then do:
     1464           assign
     1465             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1466             no-error .
     1467           if error-status :error
     1468           or error-status :get-message(1) <> ""
     1469           then do:
     1470             undo move_block, retry move_block .
     1471           end.
     1472         end.
     1473       end.
     1474       if p-move-resize = true
     1475       then do:
     1476         run diasize_position-resize-button in this-procedure .
     1477       end.
     1478       if v-diasize-wndstore = true
     1479       then do:
     1480         if connected("ub") = true
     1481         then do:
     1482           define variable v-cntxt-db-num        as integer   no-undo .
     1483           define variable v-cntxt-userid        as character no-undo .
     1484           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1485                                             , OUTPUT v-cntxt-userid
     1486                                             ) .
     1487           run gbl/wndsizew.p
     1488             (input  v-cntxt-db-num
     1489             ,input  v-cntxt-userid
     1490             ,input  v-diasize-proc-name
     1491             ,input  'height':u
     1492             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1493             ) .
     1494         end.
     1495       end.
     1496     end.
     1497     assign
     1498       v-diasize-change-size = false
     1499     .
     1500   end procedure.
     1501   procedure diasize_set-height :
     1502     define input  parameter p-new-height  as decimal   no-undo .
     1503     define input  parameter p-move-resize as logical   no-undo .
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507       run diasize_change-height in this-procedure
     1508         (input  (p-new-height - frame Dialog-Frame :height)
     1509         ,input  p-move-resize
     1510         ) .
     1511     end.
     1512   end procedure.
     1513   procedure diasize_change-width :
     1514     define input  parameter p-change-value as decimal   no-undo .
     1515     define input  parameter p-move-resize  as logical   no-undo .
     1516     define variable v-field-group-handle   as handle    no-undo .
     1517     define variable v-object-handle        as handle    no-undo .
     1518     define variable v-frame-width          as decimal   no-undo .
     1519     define variable v-frame-virtual-width  as decimal   no-undo .
     1520     define variable v-browse-width         as decimal   no-undo .
     1521     define variable v-window-width         as decimal   no-undo .
     1522     define variable v-window-virtual-width as decimal   no-undo .
     1523     define variable v-change-sign          as integer   no-undo .
     1524     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1525     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1526     if p-change-value > 0
     1527     then do:
     1528       if frame Dialog-Frame :width + p-change-value >
     1529           session :width-chars
     1530       then do:
     1531         assign
     1532           p-change-value = session :width-chars - frame Dialog-Frame :width
     1533         .
     1534         if p-change-value <= 0
     1535         then do:
     1536           run diasize_position-resize-button in this-procedure .
     1537           return .
     1538         end.
     1539       end.
     1540     end.
     1541     if p-change-value < 0
     1542     then do:
     1543       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1544       then do:
     1545         assign
     1546           p-change-value = v-diasize-orig-frame-width
     1547                          - frame Dialog-Frame :width
     1548         .
     1549         if p-change-value >= 0
     1550         then do:
     1551           run diasize_position-resize-button in this-procedure .
     1552           return .
     1553         end.
     1554       end.
     1555     end.
     1556     if p-change-value >= 0
     1557     then do:
     1558       assign
     1559         v-change-sign = 1
     1560       .
     1561     end.
     1562     else do:
     1563       assign
     1564         v-change-sign = -1
     1565       .
     1566     end.
     1567     assign
     1568       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1569     .
     1570     if p-change-value = 0
     1571     then do:
     1572       run diasize_position-resize-button in this-procedure .
     1573       return .
     1574     end.
     1575     move_block:
     1576     do
     1577     on error undo move_block, leave move_block
     1578     :
     1579       if retry
     1580       then do:
     1581         do
     1582         on error undo move_block, leave move_block
     1583         :
     1584           if p-change-value > 0
     1585           then do:
     1586             for each buf_temp-diasize-handle
     1587             on error undo, next
     1588             :
     1589               assign
     1590                 v-object-handle = buf_temp-diasize-handle.handle-value
     1591               .
     1592               if v-object-handle <> v-diasize-resize-button
     1593               then do:
     1594                 assign
     1595                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1596                 .
     1597               end.
     1598             end.
     1599             assign
     1600               v-diasize-browse-handle :width = v-browse-width
     1601             .
     1602             for each buf_temp-browse-handle
     1603               where buf_temp-browse-handle.browse-type = 'width':u
     1604             on error undo, next
     1605             :
     1606               assign
     1607                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1608               .
     1609             end.
     1610             assign
     1611               frame Dialog-Frame :width = v-frame-width
     1612             .
     1613             if frame Dialog-Frame :scrollable = true
     1614             then do:
     1615               assign
     1616                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1617               .
     1618             end.
     1619             run diasize_position-resize-button in this-procedure .
     1620           end.
     1621           else do:
     1622             if frame Dialog-Frame :scrollable = true
     1623             then do:
     1624               assign
     1625                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1626               .
     1627             end.
     1628             assign
     1629               frame Dialog-Frame :width = v-frame-width
     1630             .
     1631             for each buf_temp-browse-handle
     1632               where buf_temp-browse-handle.browse-type = 'width':u
     1633             on error undo, next
     1634             :
     1635               assign
     1636                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1637               .
     1638             end.
     1639             assign
     1640               v-diasize-browse-handle :width = v-browse-width
     1641             .
     1642             for each buf_temp-diasize-handle
     1643             on error undo, next
     1644             :
     1645               assign
     1646                 v-object-handle = buf_temp-diasize-handle.handle-value
     1647               .
     1648               if v-object-handle <> v-diasize-resize-button
     1649               then do:
     1650                 assign
     1651                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1652                 .
     1653               end.
     1654             end.
     1655             run diasize_position-resize-button in this-procedure .
     1656           end.
     1657           assign
     1658             v-diasize-change-size = false
     1659           .
     1660           leave move_block .
     1661         end.
     1662       end.
     1663       assign
     1664         v-diasize-need-full-display = true
     1665       .
     1666       if v-diasize-change-size = false
     1667       then do:
     1668         assign
     1669           v-diasize-change-size = true
     1670         .
     1671       end.
     1672       else do:
     1673         return .
     1674       end.
     1675       assign
     1676         v-frame-width = frame Dialog-Frame :width
     1677         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1678         v-browse-width = v-diasize-browse-handle :width
     1679       .
     1680       for each buf_temp-browse-handle
     1681         where buf_temp-browse-handle.browse-type = 'width':u
     1682       :
     1683         assign
     1684           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1685         .
     1686       end.
     1687       for each buf_temp-diasize-handle
     1688       :
     1689         delete buf_temp-diasize-handle .
     1690       end.
     1691       assign
     1692         v-field-group-handle = frame Dialog-Frame :first-child
     1693       .
     1694       do while valid-handle(v-field-group-handle)
     1695       :
     1696         assign
     1697           v-object-handle = v-field-group-handle :first-child
     1698         .
     1699         do while valid-handle(v-object-handle)
     1700         :
     1701           if  v-object-handle <> v-diasize-browse-handle :handle
     1702           and v-object-handle <> v-diasize-resize-button
     1703           and can-query(v-object-handle, "row")
     1704           and can-query(v-object-handle, "height")
     1705           and ( v-object-handle :col + v-object-handle :width
     1706                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1707               )
     1708           then do:
     1709             find first buf_temp-browse-handle
     1710               where buf_temp-browse-handle.browse-type   = 'width':u
     1711                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1712               no-error .
     1713             if available buf_temp-browse-handle
     1714             then do:
     1715             end.
     1716             else do:
     1717               create buf_temp-diasize-handle .
     1718               assign
     1719                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1720                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1721               .
     1722             end.
     1723           end.
     1724           assign
     1725             v-object-handle = v-object-handle :next-sibling
     1726           .
     1727         end.
     1728         assign
     1729           v-field-group-handle = v-field-group-handle :next-sibling
     1730         .
     1731       end.
     1732       do with frame Dialog-Frame
     1733       :
     1734         hide v-diasize-resize-button .
     1735         v-diasize-resize-button :row = 1.
     1736         v-diasize-resize-button :column = 1.
     1737       end.
     1738       if p-change-value > 0
     1739       then do:
     1740         if frame Dialog-Frame :scrollable = true
     1741         then do:
     1742           assign
     1743             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1744             no-error .
     1745           if error-status :error
     1746           or error-status :get-message(1) <> ""
     1747           then do:
     1748             undo move_block, retry move_block.
     1749           end.
     1750         end.
     1751         assign
     1752           frame Dialog-Frame :width = v-frame-width + p-change-value
     1753           no-error .
     1754         if error-status :error
     1755         or error-status :get-message(1) <> ""
     1756         then do:
     1757           undo move_block, retry move_block.
     1758         end.
     1759         assign
     1760           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1761         no-error .
     1762         if error-status :error
     1763         or error-status :get-message(1) <> ""
     1764         then do:
     1765           undo move_block, retry move_block.
     1766         end.
     1767         for each buf_temp-browse-handle
     1768           where buf_temp-browse-handle.browse-type = 'width':u
     1769         on error undo move_block, retry move_block
     1770         :
     1771           assign
     1772             buf_temp-browse-handle.browse-handle :width
     1773               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1774             no-error .
     1775           if error-status :error
     1776           or error-status :get-message(1) <> ""
     1777           then do:
     1778             undo move_block, retry move_block .
     1779           end.
     1780         end.
     1781         for each buf_temp-diasize-handle
     1782         on error undo move_block, retry move_block
     1783         :
     1784           assign
     1785             v-object-handle = buf_temp-diasize-handle.handle-value
     1786           .
     1787           if v-object-handle <> v-diasize-resize-button
     1788           then do:
     1789             assign
     1790               v-object-handle :col = v-object-handle :col + p-change-value
     1791               no-error .
     1792             if error-status :error
     1793             or error-status :get-message(1) <> ""
     1794             then do:
     1795               undo move_block, retry move_block .
     1796             end.
     1797           end.
     1798         end.
     1799       end.
     1800       else do:
     1801         for each buf_temp-diasize-handle
     1802         on error undo move_block, retry move_block
     1803         :
     1804           assign
     1805             v-object-handle = buf_temp-diasize-handle.handle-value
     1806           .
     1807           if v-object-handle <> v-diasize-resize-button
     1808           then do:
     1809             assign
     1810               v-object-handle :col = v-object-handle :col + p-change-value
     1811               no-error .
     1812             if error-status :error
     1813             or error-status :get-message(1) <> ""
     1814             then do:
     1815               undo move_block, retry move_block .
     1816             end.
     1817           end.
     1818         end.
     1819         for each buf_temp-browse-handle
     1820           where buf_temp-browse-handle.browse-type = 'width':u
     1821         on error undo move_block, retry move_block
     1822         :
     1823           assign
     1824             buf_temp-browse-handle.browse-handle :width
     1825               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1826             no-error .
     1827           if error-status :error
     1828           or error-status :get-message(1) <> ""
     1829           then do:
     1830             undo move_block, retry move_block .
     1831           end.
     1832         end.
     1833         assign
     1834           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1835           no-error .
     1836         if error-status :error
     1837         or error-status :get-message(1) <> ""
     1838         then do:
     1839           undo move_block, retry move_block.
     1840         end.
     1841         assign
     1842           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1843         no-error .
     1844         if error-status :error
     1845         or error-status :get-message(1) <> ""
     1846         then do:
     1847           undo move_block, retry move_block.
     1848         end.
     1849         if frame Dialog-Frame :scrollable = true
     1850         then do:
     1851           assign
     1852             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1853           no-error .
     1854           if error-status :error
     1855           or error-status :get-message(1) <> ""
     1856           then do:
     1857             undo move_block, retry move_block.
     1858           end.
     1859         end.
     1860       end.
     1861       if p-move-resize
     1862       then do:
     1863         run diasize_position-resize-button in this-procedure .
     1864       end.
     1865       if v-diasize-wndstore = true
     1866       then do:
     1867         if connected("ub") = true
     1868         then do:
     1869           define variable v-cntxt-db-num        as integer   no-undo .
     1870           define variable v-cntxt-userid        as character no-undo .
     1871           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1872                                             , OUTPUT v-cntxt-userid
     1873                                             ) .
     1874           run gbl/wndsizew.p
     1875             (input  v-cntxt-db-num
     1876             ,input  v-cntxt-userid
     1877             ,input  v-diasize-proc-name
     1878             ,input  'width':u
     1879             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1880             ) .
     1881         end.
     1882       end.
     1883     end.
     1884     assign
     1885       v-diasize-change-size = false
     1886     .
     1887   end procedure.
     1888   procedure diasize_set-width :
     1889     define input  parameter p-new-width  as decimal   no-undo .
     1890     define input  parameter p-move-resize as logical   no-undo .
     1891     do
     1892     on error undo, return error return-value
     1893     :
     1894       run diasize_change-width in this-procedure
     1895         (input  (p-new-width - frame Dialog-Frame :width)
     1896         ,input  p-move-resize
     1897         ) .
     1898     end.
     1899   end procedure.
     1900   procedure diasize_position-resize-button :
     1901     do with frame Dialog-Frame
     1902     :
     1903       hide v-diasize-resize-button .
     1904       assign
     1905         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1906                     - 1
     1907                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1908         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1909                     - 1
     1910                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1911       .
     1912       view v-diasize-resize-button .
     1913     end.
     1914   end procedure.
     1915   on alt-right anywhere
     1916   do:
     1917     run diasize_change-width in this-procedure
     1918       (input 1
     1919       ,input true
     1920       ) .
     1921     return no-apply .
     1922   end.
     1923   on alt-left anywhere
     1924   do:
     1925     run diasize_change-width in this-procedure
     1926       (input -1
     1927       ,input true
     1928       ) .
     1929     return no-apply .
     1930   end.
     1931   on alt-down anywhere
     1932   do:
     1933     run diasize_change-height in this-procedure
     1934       (input 1
     1935       ,input true
     1936       ) .
     1937     return no-apply .
     1938   end.
     1939   on alt-up anywhere
     1940   do:
     1941     run diasize_change-height in this-procedure
     1942       (input -1
     1943       ,input true
     1944       ) .
     1945     return no-apply .
     1946   end.
     1947   on alt-enter of frame Dialog-Frame
     1948   do:
     1949     run diasize_maximize in this-procedure
     1950       (input  ?
     1951       ).
     1952     return no-apply .
     1953   end.
     1954   procedure diasize_end-move :
     1955     do
     1956     on error undo, return error return-value
     1957     :
     1958       define variable v-row-delta as decimal   no-undo .
     1959       define variable v-col-delta as decimal   no-undo .
     1960       define variable v-new-row as decimal   no-undo .
     1961       define variable v-new-col as decimal   no-undo .
     1962       assign
     1963         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1964         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1965       .
     1966       assign
     1967         v-row-delta = v-new-row - frame Dialog-Frame :height
     1968         v-col-delta = v-new-col - frame Dialog-Frame :width
     1969       .
     1970       run diasize_change-height in this-procedure
     1971         (input v-row-delta
     1972         ,input true
     1973         ) .
     1974       run diasize_change-width in this-procedure
     1975         (input v-col-delta
     1976         ,input true
     1977         ) .
     1978     end.
     1979   end procedure.
     1980   procedure diasize_maximize :
     1981     define input  parameter p-action as logical   no-undo .
     1982     do
     1983     on error undo, return error return-value
     1984     :
     1985       if p-action = ?
     1986       then do:
     1987         if v-diasize-need-maximize = true
     1988         then do:
     1989           assign
     1990             p-action = true
     1991           .
     1992         end.
     1993         else do:
     1994           assign
     1995             p-action = false
     1996           .
     1997         end.
     1998       end.
     1999       if p-action = true
     2000       then do:
     2001         run diasize_change-height in this-procedure
     2002           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2003               - frame Dialog-Frame :height-chars
     2004           ,input true
     2005           ) .
     2006         run diasize_change-width in this-procedure
     2007           (input session :width-chars
     2008               - frame Dialog-Frame :width-chars
     2009           ,input true
     2010           ) .
     2011         assign
     2012           v-diasize-need-maximize = false
     2013         .
     2014       end.
     2015       else do:
     2016         run diasize_change-width in this-procedure
     2017           (input v-diasize-orig-frame-width
     2018               - frame Dialog-Frame :width-chars
     2019           ,input true
     2020           ) .
     2021         run diasize_change-height in this-procedure
     2022           (input v-diasize-orig-frame-height
     2023               - frame Dialog-Frame :height-chars
     2024           ,input true
     2025           ) .
     2026         assign
     2027           v-diasize-need-maximize = true
     2028         .
     2029       end.
     2030     end.
     2031   end procedure.
     2032   procedure diasize_restore-orig-size :
     2033     do
     2034     on error undo, return error return-value
     2035     :
     2036       assign
     2037         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2038         v-diasize-current-frame-height = frame Dialog-Frame :height
     2039       .
     2040       run diasize_set-height in this-procedure
     2041         (input  v-diasize-orig-frame-height
     2042         ,input  true
     2043         ) .
     2044       run diasize_set-width in this-procedure
     2045         (input  v-diasize-orig-frame-width
     2046         ,input  true
     2047         ) .
     2048     end.
     2049   end procedure.
     2050   procedure diasize_restore-current-size :
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       run diasize_set-height in this-procedure
     2055         (input  v-diasize-current-frame-height
     2056         ,input  true
     2057         ) .
     2058       run diasize_set-width in this-procedure
     2059         (input  v-diasize-current-frame-width
     2060         ,input  true
     2061         ) .
     2062     end.
     2063   end procedure.
     2064   procedure diasize_set-browse-handle :
     2065     define input  parameter p-browse-handle as handle   no-undo .
     2066     define buffer buf_temp-browse-handle for temp-browse-handle .
     2067     do
     2068     on error undo, return error return-value
     2069     :
     2070       assign
     2071         v-diasize-browse-handle = p-browse-handle
     2072       .
     2073       for each buf_temp-browse-handle
     2074       on error undo, return error return-value
     2075       :
     2076         delete buf_temp-browse-handle .
     2077       end.
     2078     end.
     2079   end procedure.
     2080   procedure diasize_add_browse :
     2081     define input  parameter p-browse-type   as character no-undo .
     2082     define input  parameter p-browse-handle as handle    no-undo .
     2083     define buffer buf_temp-browse-handle for temp-browse-handle .
     2084     do
     2085     on error undo, return error return-value
     2086     :
     2087       assign
     2088         v-diasize-browse-number = v-diasize-browse-number + 1
     2089       .
     2090       create buf_temp-browse-handle .
     2091       assign
     2092         buf_temp-browse-handle.browse-type   = p-browse-type
     2093         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2094         buf_temp-browse-handle.browse-handle = p-browse-handle
     2095       .
     2096     end.
     2097   end procedure.
     2098   procedure diasize_init :
     2099     define variable v-default-value    as logical   no-undo .
     2100     define variable v-restore-saved    as logical   no-undo .
     2101     define variable v-resize-value-str as character no-undo .
     2102     do
     2103     on error undo, return error return-value
     2104     :
     2105       do with frame Dialog-Frame
     2106       :
     2107         assign
     2108           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2109           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2110           v-diasize-browse-handle     = browse BROWSE-2 :handle
     2111         .
     2112         create button v-diasize-resize-button
     2113         assign
     2114           parent        = frame Dialog-Frame :first-child
     2115           label         = "s"
     2116           height-pixels = 16
     2117           width-pixels  = 16
     2118           visible       = true
     2119           sensitive     = true
     2120           movable       = true
     2121           triggers:
     2122             on end-move persistent run diasize_end-move in this-procedure .
     2123           end triggers.
     2124         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2125         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2126         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2127         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2128         assign
     2129           v-diasize-wndmax = false
     2130         .
     2131         if connected("ub") = true
     2132         then do:
     2133           define variable v-cntxt-db-num        as integer   no-undo .
     2134           define variable v-cntxt-userid        as character no-undo .
     2135           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2136                                             , OUTPUT v-cntxt-userid
     2137                                             ) .
     2138           run gbl/wndpar_r.p
     2139             (input  v-cntxt-db-num
     2140             ,input  v-cntxt-userid
     2141             ,input  'wndmax':U
     2142             ,output v-diasize-wndmax
     2143             ,output v-default-value
     2144             ) .
     2145         end.
     2146         assign
     2147           v-diasize-wndstore = false
     2148         .
     2149         if connected("ub") = true
     2150         then do:
     2151           run gbl/wndpar_r.p
     2152             (input  v-cntxt-db-num
     2153             ,input  v-cntxt-userid
     2154             ,input  'wndstore':U
     2155             ,output v-diasize-wndstore
     2156             ,output v-default-value
     2157             ) .
     2158         end.
     2159         assign
     2160           v-diasize-proc-name = entry(1, program-name(2), '.')
     2161         .
     2162         if v-diasize-wndstore = true
     2163         then do:
     2164           assign
     2165             v-restore-saved = false
     2166           .
     2167           if connected("ub") = true
     2168           then do:
     2169             run gbl/wndsizer.p
     2170               (input  v-cntxt-db-num
     2171               ,input  v-cntxt-userid
     2172               ,input  v-diasize-proc-name
     2173               ,input  'height':u
     2174               ,output v-resize-value-str
     2175               ) .
     2176             if v-resize-value-str <> '':U
     2177             then do:
     2178               run diasize_change-height in this-procedure
     2179                 (input  integer(v-resize-value-str)
     2180                 ,input  true
     2181                 ) .
     2182               assign
     2183                 v-restore-saved = true
     2184               .
     2185             end.
     2186           end.
     2187           if connected("ub") = true
     2188           then do:
     2189             run gbl/wndsizer.p
     2190               (input  v-cntxt-db-num
     2191               ,input  v-cntxt-userid
     2192               ,input  v-diasize-proc-name
     2193               ,input  'width':u
     2194               ,output v-resize-value-str
     2195               ) .
     2196             if v-resize-value-str <> '':U
     2197             then do:
     2198               run diasize_change-width in this-procedure
     2199                 (input  integer(v-resize-value-str)
     2200                 ,input  true
     2201                 ) .
     2202               assign
     2203                 v-restore-saved = true
     2204               .
     2205             end.
     2206           end.
     2207           if v-restore-saved <> true
     2208           then do:
     2209             if v-diasize-wndmax = true
     2210             then do:
     2211               run diasize_maximize in this-procedure
     2212                 (input  true
     2213                 ) .
     2214             end.
     2215           end.
     2216         end.
     2217         else do:
     2218           if v-diasize-wndmax = true
     2219           then do:
     2220             run diasize_maximize in this-procedure
     2221               (input  true
     2222               ) .
     2223           end.
     2224         end.
     2225       end.
     2226     end.
     2227   end procedure.
     2228   procedure diasize_need-full-display :
     2229     define output parameter p-need-full-display as logical   no-undo .
     2230     do
     2231     on error undo, return error return-value
     2232     :
     2233       assign
     2234         p-need-full-display = v-diasize-need-full-display
     2235       .
     2236       assign
     2237         v-diasize-need-full-display = false
     2238       .
     2239     end.
     2240   end procedure.
     2241   procedure get-context :
     2242      define output parameter p-db-num as integer          no-undo.
     2243      define output parameter p-user-id as character        no-undo.
     2244      define variable v-login               as character    no-undo.
     2245      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2246      define buffer buf_user-login  for ub.user-login .
     2247      do
     2248      on error undo, return error
     2249      :
     2250            FIND FIRST buf_sys-ctrl no-lock.
     2251            ASSIGN
     2252               v-login = USERID("ub")
     2253               p-db-num = buf_sys-ctrl.db-num
     2254            .
     2255            FIND FIRST buf_user-login
     2256                 WHERE buf_user-login.db-num = p-db-num
     2257                   AND buf_user-login.user-login = v-login
     2258                 no-lock
     2259                 no-error
     2260                 .
     2261            IF AVAILABLE buf_user-login
     2262            THEN DO:
     2263               assign
     2264                  p-user-id = buf_user-login.user-id
     2265               .
     2266            END.
     2267      end.
     2268   end procedure.
     2269       run diasize_init in this-procedure .
     2270   find first ub.fbr-doc where recid(ub.fbr-doc) = rec_id no-lock.
     2271   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2272   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2273     v-printer-name = session:printer-name.
     2274   MAIN-BLOCK:
     2275   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2276      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2277   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2278     run mainmenu_getcntxt in p-mainmenu-handle
     2279       (output v-cntxt-db-num
