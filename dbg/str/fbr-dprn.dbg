     2284       ,output v-cntxt-obj-code
     2285       ,output v-cntxt-db-num-obj
     2286       ,output v-cntxt-is-admin
     2287       ) .
     2288      run get-report-num in p-mainmenu-handle (
     2289          output g#report-num
     2290      ).
     2291      run get-quest-print in p-mainmenu-handle (
     2292          output g#quest-print
     2293      ).
     2294     assign tg-rubl:label = "Печать в рублях" .
     2295       run load-menu in this-procedure (
     2296             ub.fbr-doc.doc-code
     2297           , ub.fbr-doc.doc-type
     2298           , ub.fbr-doc.status_
     2299           , '*'
     2300           , '*'
     2301       ).
     2302     RUN enable_UI.
     2303     Tmp#List.last-use      :read-only in browse BROWSE-2 =  true .
     2304       ASSIGN frame Dialog-Frame:TITLE =  "Печать документа  "
     2305     + " Тип: " + ub.fbr-doc.doc-type
     2306     + " Статус: " + ub.fbr-doc.status_
     2307     + "  № "  + ub.fbr-doc.doc-code.
     2308     WAIT-FOR GO OF FRAME Dialog-Frame focus BROWSE-2.
     2309   END.
     2310   RUN disable_UI.
     2311   PROCEDURE disable_UI :
     2312     HIDE FRAME Dialog-Frame.
     2313   END PROCEDURE.
     2314   PROCEDURE enable_UI :
     2315     DISPLAY tg-rubl tg-fat tg-detail v-printer-name
     2316         WITH FRAME Dialog-Frame.
     2317     ENABLE b-chg b-print b-help b-exit b-mark b-erase BROWSE-2 tg-rubl tg-fat
     2318            tg-detail v-printer-name
     2319         WITH FRAME Dialog-Frame.
     2320     VIEW FRAME Dialog-Frame.
     2321     OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.cli-code.
     2322   END PROCEDURE.
     2323   PROCEDURE get-call-point :
     2324   define input parameter p-tmp#list-id as integer          no-undo.
     2325   define input parameter p-doc-type as character        no-undo.
     2326   define input parameter p-status_  as character        no-undo.
     2327   define input parameter p-internal as character        no-undo.
     2328   define input parameter p-flag     as character        no-undo.
     2329   define output parameter p-call-point as character        no-undo.
     2330   do
     2331   on error undo, return error
     2332   :
     2333       assign
     2334           p-call-point = substitute( "&1,&2,&3,&4", p-doc-type, p-status_, p-internal, p-flag )
     2335       .
     2336   end.
     2337   END PROCEDURE.
     2338   PROCEDURE get-saved-logical :
     2339   define input parameter p-list       as character        no-undo.
     2340   define input parameter p-name       as character        no-undo.
     2341   define output parameter p-logical   as character        no-undo.
     2342       define variable v-position    as integer      no-undo.
     2343   do
     2344   on error undo, return error
     2345   :
     2346       assign
     2347           v-position = lookup( p-name, p-list )
     2348       .
     2349       if v-position = 0
     2350       then do:
     2351           assign
     2352               p-logical = "  -":U
     2353           .
     2354       end.
     2355       else do:
     2356           if num-entries( p-list ) > v-position
     2357           then do:
     2358               assign
     2359                   p-logical = "  ":U + entry( v-position + 1, p-list )
     2360               .
     2361               if trim( p-logical ) = "":U
     2362               then do:
     2363                   assign
     2364                       p-logical = "  -":U
     2365                   .
     2366               end.
     2367           end.
     2368           else do:
     2369               assign
     2370                   p-logical = "  -":U
     2371               .
     2372           end.
     2373       end.
     2374   end.
     2375   END PROCEDURE.
     2376   PROCEDURE Load-menu :
     2377   define input parameter p-doc-code   as character        no-undo.
     2378   define input parameter xtype        as character        no-undo.
     2379   define input parameter xstatus      as character        no-undo.
     2380   define input parameter xInternal    as character        no-undo.
     2381   define input parameter xflag        as character        no-undo.
     2382       define variable varhave-dressing    as logical  init no no-undo.
     2383       define variable v-call-point        as character    no-undo.
     2384       define variable v-temp-char         as character    no-undo.
     2385       define buffer bf_fbr-line   for ub.fbr-line.
     2386       define buffer bf_recipe     for ub.recipe.
     2387       define buffer buf_tmp#list  for tmp#list.
     2388   do
     2389   for bf_fbr-line
     2390     , bf_recipe
     2391     , buf_tmp#list
     2392   on error undo, return error
     2393   :
     2394   for each bf_fbr-line where bf_fbr-line.doc-code = fbr-doc.doc-code no-lock,
     2395     first bf_recipe
     2396      where bf_recipe.recipe-code = bf_fbr-line.recipe-code
     2397        and bf_recipe.recipe-type = 'разделка':U  no-lock on error undo, return error return-value :
     2398     assign
     2399       varhave-dressing = yes.
     2400     leave.
     2401   end.
     2402   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2403   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2404     (output v-menu-doc-sys-key
     2405     ) no-error .
