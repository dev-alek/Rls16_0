     2537   initial "@(#)$Workfile$ $Revision$".
     2538           run menu-doc-create-menu-item in this-procedure
     2539             ( input xtype
     2540              , input xstatus
     2541              , input xinternal
     2542              , input xflag
     2543              , input 'производство':U
     2544              , input 'факт':U
     2545              , input '*'
     2546              , input '*'
     2547              , input 'Калькуляционная карточка '
     2548              , input 'cost,sale,rubl,base'
     2549              , input 'rep/ccard.p'
     2550              , input ''
     2551              , input '------'
     2552              , input ''
     2553              , input 'A4port'
     2554              , input ''
     2555           ).
     2556       for each buf_tmp#list
     2557       :
     2558           run get-call-point in this-procedure (
     2559                 input buf_tmp#list.id
     2560               , input v-menu-doc-doc-type
     2561               , input v-menu-doc-status_
     2562               , input v-menu-doc-internal
     2563               , input v-menu-doc-flag
     2564               , output v-call-point
     2565           ).
     2566           find first buf_usr-flt no-lock
     2567                where buf_usr-flt.user-name  = v-cntxt-userid
     2568                  and buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     2569                                               , buf_tmp#list.blank-name
     2570                                               , buf_tmp#list.sys-key
     2571                                               , buf_tmp#list.sys-key-black
     2572                                               , v-call-point )
     2573           no-error.
     2574           if available buf_usr-flt
     2575           then do:
     2576               assign
     2577                   tg-detail    =  ( if lookup("detail", buf_usr-flt.list_) > 0 then yes else no )
     2578                   tg-rubl      =  ( if lookup("rubl",   buf_usr-flt.list_) > 0 then yes else no )
     2579                   tg-fat       =  ( if lookup("fat",    buf_usr-flt.list_) > 0 then yes else no )
     2580               .
     2581           end.
     2582           else do:
     2583               create buf_usr-flt .
     2584               assign
     2585                   buf_usr-flt.user-name    = v-cntxt-userid
     2586                   buf_usr-flt.call-point   = substitute( "&1,&2,&3,&4"
     2587                                               , buf_tmp#list.blank-name
     2588                                               , buf_tmp#list.sys-key
     2589                                               , buf_tmp#list.sys-key-black
     2590                                               , v-call-point )
     2591               .
     2592           end.
     2593           run get-saved-logical in this-procedure (
     2594                 input buf_usr-flt.list_
     2595               , input "type-price":U
     2596               , output buf_tmp#list.type-price
     2597           ).
     2598           assign
     2599               v-temp-char = "":U
     2600           .
     2601           run get-saved-logical in this-procedure (
     2602                 input buf_usr-flt.list_
     2603               , input "selection":U
     2604               , output v-temp-char
     2605           ).
     2606           if v-temp-char = "  +":U
     2607           then do:
     2608               assign
     2609                   buf_tmp#list.last-use = yes
     2610               .
     2611           end.
     2612           assign
     2613               buf_tmp#list.view_ = 1
     2614           .
     2615           if sys-key <> 'ExpertekIBS':U
     2616           then do:
     2617               if sys-key <> buf_tmp#list.sys-key
     2618               and buf_tmp#list.sys-key <> ''
     2619               then do:
     2620                   assign
     2621                       buf_tmp#list.view_      = 0
     2622                       buf_tmp#list.last-use   = no
     2623                   .
     2624               end.
     2625           end.
     2626           if buf_tmp#list.proc-name = "":U
     2627           then do:
     2628               assign
     2629                   buf_tmp#list.view_      = 0
     2630                   buf_tmp#list.last-use   = no
     2631               .
     2632           end.
     2633           if buf_tmp#list.type-price-enabled = no
     2634           then do:
     2635               assign
     2636                   buf_tmp#list.type-price   = " ":U
     2637               .
     2638           end.
     2639     end.
     2640   end.
     2641   END PROCEDURE.
     2642   PROCEDURE save-form-parameters :
     2643       define variable v-call-point    as character    no-undo.
     2644       define buffer buf_tmp#list          for tmp#list.
     2645       define buffer buf_usr-flt           for ubflt.usr-flt.
     2646       define buffer buf_temp_form-list    for temp_form-list.
     2647   do
     2648   for buf_tmp#list
     2649     , buf_usr-flt
     2650     , buf_temp_form-list
     2651   with frame Dialog-Frame
     2652   on error undo, return error
     2653   :
     2654       for each buf_tmp#list
     2655       :
     2656           run get-call-point in this-procedure (
     2657                 input buf_tmp#list.id
     2658               , input v-menu-doc-doc-type
     2659               , input v-menu-doc-status_
     2660               , input v-menu-doc-internal
     2661               , input v-menu-doc-flag
     2662               , output v-call-point
     2663           ).
     2664           find first buf_usr-flt exclusive-lock
     2665                where buf_usr-flt.user-name  = v-cntxt-userid
     2666                  and buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     2667                                               , buf_tmp#list.blank-name
     2668                                               , buf_tmp#list.sys-key
     2669                                               , buf_tmp#list.sys-key-black
     2670                                               , v-call-point )
     2671           no-error.
     2672           if not available buf_usr-flt
     2673           then do:
     2674               create buf_usr-flt.
     2675               assign
     2676                   buf_usr-flt.user-name  = v-cntxt-userid
     2677                   buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     2678                                               , buf_tmp#list.blank-name
     2679                                               , buf_tmp#list.sys-key
     2680                                               , buf_tmp#list.sys-key-black
     2681                                               , v-call-point )
     2682               .
     2683           end.
     2684           assign
     2685               buf_usr-flt.list_ = substitute( "selection,&1,type-price,&2,type-scale,&3,type-val,&4,sort-name,&5,sort-gr,&6,print-graft,&7":U
     2686                                       , ( if buf_tmp#list.last-use = yes then "+":U else "-":U )
     2687                                       , ( if index( buf_tmp#list.type-price , "+":U ) <> 0 then "+":U else "-":U )
     2688                                       , ( if index( buf_tmp#list.type-scale , "+":U ) <> 0 then "+":U else "-":U )
     2689                                       , ( if index( buf_tmp#list.type-val   , "+":U ) <> 0 then "+":U else "-":U )
     2690                                       , ( if index( buf_tmp#list.sort-name  , "+":U ) <> 0 then "+":U else "-":U )
     2691                                       , ( if index( buf_tmp#list.sort-gr    , "+":U ) <> 0 then "+":U else "-":U )
     2692                                       , ( if index( buf_tmp#list.print-graft, "+":U ) <> 0 then "+":U else "-":U )
     2693                                       )
     2694           .
     2695           assign
     2696               tg-rubl
     2697               tg-detail
     2698               tg-fat
     2699           .
     2700           assign
     2701               buf_usr-flt.list_       = buf_usr-flt.list_
     2702                                       + ( if tg-rubl   = yes then ",rubl"   else "" )
     2703                                       + ( if tg-detail = yes then ",detail" else "" )
     2704                                       + ( if tg-fat    = yes then ",fat" else "" )
     2705           .
     2706       end.
     2707   end.
     2708   END PROCEDURE.
