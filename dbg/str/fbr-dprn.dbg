     2518           run menu-doc-create-menu-item in this-procedure
     2519             ( input xtype
     2520              , input xstatus
     2521              , input xinternal
     2522              , input xflag
     2523              , input 'производство':U
     2524              , input 'факт,разрешен':U
     2525              , input '*'
     2526              , input '*'
     2527              , input 'Акт производства промежуточных ингредиентов'
     2528              , input 'cost,sale,rubl,base'
