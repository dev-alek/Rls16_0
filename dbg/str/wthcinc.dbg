      264             SIZE 6 BY 1
      265        tt-c-wth-doc.cli-type AT ROW 5.27 COL 14 COLON-ALIGNED
      266             LABEL "Контрагент"
      267             VIEW-AS COMBO-BOX INNER-LINES 5
      268             LIST-ITEMS "Item 1"
      269             DROP-DOWN-LIST
      270             SIZE 6 BY 1
      271        BR-lines AT ROW 12.87 COL 1
      272        B-lookup AT ROW 20.27 COL 1
      273        B-chk AT ROW 20.27 COL 11
