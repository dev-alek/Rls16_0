        1   DEFINE BUFFER buf_c-wth-line FOR ub.c-wth-line.
        2   DEFINE BUFFER buf_clients FOR ub.clients.
        3   DEFINE BUFFER buf_deliver FOR ub.clients.
        4   DEFINE BUFFER buf_obj FOR ub.clients.
        5   DEFINE BUFFER buf_operator FOR ub.clients.
        6   DEFINE BUFFER buf_receiver FOR ub.clients.
        7   DEFINE BUFFER buf_wth FOR ub.wealth.
        8   DEFINE BUFFER current-place FOR ub.wth-place.
        9   DEFINE BUFFER first_c-wth-line FOR ub.c-wth-line.
       10   DEFINE BUFFER out-place FOR ub.wth-place.
       11   DEFINE TEMP-TABLE tt-c-wth-doc NO-UNDO LIKE ub.c-wth-doc.
       12   define input parameter parparentproc as widget-handle no-undo .
       13   define input parameter par-mode AS CHARACTER NO-UNDO.
       14   define input parameter parhost-code like ub.sysconf.host-code no-undo.
       15   define input parameter parobj-type like ub.clients.obj-type no-undo.
       16   define input parameter parobj-code like ub.clients.obj-code no-undo.
       17   define input parameter parcli-type like ub.clients.obj-type no-undo.
       18   define input parameter parcli-code like ub.clients.obj-code no-undo.
       19   define input parameter par-type AS CHARACTER NO-UNDO.
       20   define input parameter parauto-fill like ub.c-wth-doc.auto-fill no-undo .
       21   define input-output parameter p-doc-rec     as recid no-undo .
       22   define input parameter p-call-prog  as handle no-undo .
       23   define input-output parameter p-next-prev as character no-undo .
       24   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       25   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       26   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       27   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       28   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       29   define variable vss-description AS CHAR NO-UNDO INIT "перемещение МЦ: добавление, изменение, просмотр":U.
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   procedure proc-alt-shift-f2:
       89     if not ibs.th.gbl.gbl-var:rcode
       90   then
       91     run gbl\inidebug.p .
       92   end.
       93   procedure proc-alt-shift-f3:
       94     run gbl/prvssinf.p
       95       ( input this-procedure
       96       ) .
       97   end.
       98   define variable v-inform-launched as logical no-undo initial false .
       99   procedure proc-alt-shift-f4:
      100     define variable v-action as character no-undo .
      101     if v-inform-launched = false then do:
      102       assign
      103         v-inform-launched = true
      104       .
      105       run gbl/d-inform.w
      106         (  input self
      107         ,  input this-procedure
      108         , output v-action
      109         ) no-error .
      110       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      111       assign
      112         v-inform-launched = false
      113       .
      114     end.
      115   end.
      116   procedure proc-alt-f1:
      117     run gbl/corrhelp.p
      118       (input this-procedure
      119       ) .
      120   end .
      121   on alt-shift-f2 anywhere do:
      122     run proc-alt-shift-f2.
      123   end.
      124   on alt-shift-f3 anywhere do:
      125     run proc-alt-shift-f3 in this-procedure .
      126   end.
      127   on alt-shift-f4 anywhere do:
      128     run proc-alt-shift-f4 in this-procedure.
      129   end.
      130   on alt-f1 anywhere do:
      131     run proc-alt-f1 in this-procedure .
      132   end.
      133   define new global shared variable g#library  as handle no-undo .
      134   define new global shared variable g#library2 as handle no-undo .
      135   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   function usrfulnf returns character ( input p-user-id as character):
      137   define variable v-user-name as character no-undo .
      138   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      140     (input  p-user-id
      141     ,output v-user-name
      142     ) no-error .
      143   if error-status:error
      144   or v-user-name = ""
      145   then do:
      146     return p-user-id.
      147   end.
      148   else do:
      149     return v-user-name.
      150   end.
      151   end function.
      152   define buffer bf_c-wth-doc for ub.c-wth-doc.
      153   DEFINE VARIABLE f-date     AS DATE NO-UNDO.
      154   DEFINE VARIABLE f-time     AS INT  NO-UNDO.
      155   DEFINE VARIABLE s-date     AS DATE NO-UNDO.
      156   DEFINE VARIABLE s-num      AS INT  NO-UNDO.
      157   DEFINE VARIABLE v_rid      AS CHAR NO-UNDO.
      158   DEFINE VARIABLE l-shift-on AS LOG  NO-UNDO.
      159   DEFINE VARIABLE lock-doc as logical no-undo.
      160   DEFINE VARIABLE locked-out as logical no-undo .
      161   DEFINE VARIABLE locked-current as logical no-undo .
      162   DEFINE VARIABLE locked-inter_ as logical no-undo .
      163   DEFINE VARIABLE locked-cli as logical no-undo .
      164   define buffer auto-c-wth-doc-lock_batchprocess for ub.batchprocess .
      165   define buffer bind_c-wth-doc for ub.c-wth-doc.
      166   define buffer bind_inkas for ub.inkas.
      167   DEFINE TEMP-TABLE tt-par-dtl NO-UNDO LIKE ub.wth-par
      168   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
      169   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
      170   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
      171   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
      172   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (рубл)"
      173   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
      174   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(рубл)"
      175   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
      176   FIELD w-p-code     like ub.wth-dtl.w-p-code
