      275             LABEL "Корр."
      276              VIEW-AS TEXT
      277             SIZE 12 BY .67
      278             FGCOLOR 12
      279        tt-c-wth-doc.corr-date AT ROW 1.03 COL 82 COLON-ALIGNED NO-LABEL
      280              VIEW-AS TEXT
      281             SIZE 10 BY .67
      282             FGCOLOR 12
      283        tt-c-wth-doc.doc-code AT ROW 2.5 COL 7.3 COLON-ALIGNED
      284             LABEL "Номер"
      285              VIEW-AS TEXT
      286             SIZE 16.1 BY .67
      287             FGCOLOR 4
      288        tt-c-wth-doc.doc-date AT ROW 2.5 COL 29 COLON-ALIGNED
      289             LABEL "Дата"
      290              VIEW-AS TEXT
      291             SIZE 10 BY .67
      292        tt-c-wth-doc.fact-date AT ROW 2.5 COL 48.4 COLON-ALIGNED
      293             LABEL "Факт"
      294              VIEW-AS TEXT
      295             SIZE 10 BY .67
      296             FGCOLOR 4
      297        tt-c-wth-doc.shift-date AT ROW 2.5 COL 65.5 COLON-ALIGNED
      298             LABEL "Смена"
      299              VIEW-AS TEXT
      300             SIZE 10 BY .67
      301             FGCOLOR 4
