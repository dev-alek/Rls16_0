      227         VIEW-AS TEXT
      228        SIZE 24.5 BY 1 NO-UNDO.
      229   DEFINE QUERY BR-lines FOR
      230         buf_c-wth-line,
      231         buf_wth SCROLLING.
      232   DEFINE QUERY Dialog-Frame FOR
      233         tt-c-wth-doc,
      234         buf_obj,
      235         buf_clients,
      236         first_c-wth-line,
      237         out-place,
      238         buf_operator,
      239         buf_deliver,
      240         buf_receiver SCROLLING.
      241   DEFINE BROWSE BR-lines
      242     QUERY BR-lines NO-LOCK DISPLAY
      243         buf_c-wth-line.wth-code FORMAT ">>>>>>>>9":U
      244         buf_wth.wth-name FORMAT "X(40)":U
      245         buf_c-wth-line.doc-sum FORMAT "->,>>>,>>>,>>9.99":U
      246         buf_c-wth-line.fact-sum FORMAT "->,>>>,>>>,>>9.99":U
      247         buf_c-wth-line.sum-gds-rubl FORMAT "->,>>>,>>>,>>9.99":U COLUMN-LABEL 'Сумма по связ. тов. (rub.)'
      248         buf_c-wth-line.sum-gds-base FORMAT "->,>>>,>>>,>>9.99":U COLUMN-LABEL 'Сумма по связ. тов. (б.в.)'
      249         buf_c-wth-line.credate FORMAT "99/99/99":U
      250         buf_c-wth-line.creid FORMAT "X(16)":U
      251     ENABLE
      252         buf_c-wth-line.creid
      253       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.1 BY 7.27.
      254   DEFINE FRAME Dialog-Frame
      255        b-quit AT ROW 1 COL 1
      256        B-prev AT ROW 1 COL 40
      257        B-next AT ROW 1 COL 44.1
      258        B-Help AT ROW 1 COL 95
      259        tt-c-wth-doc.obj-type AT ROW 3.77 COL 14 COLON-ALIGNED
      260             LABEL "Объект"
