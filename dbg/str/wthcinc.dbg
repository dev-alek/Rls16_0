      313              VIEW-AS TEXT
      314             SIZE 7.5 BY .67
      315        for-object AT ROW 3.77 COL 29 COLON-ALIGNED NO-LABEL
      316        for-current-w-p-code AT ROW 3.77 COL 65.5 COLON-ALIGNED
      317        for-current-w-p-name AT ROW 3.77 COL 76 COLON-ALIGNED NO-LABEL
      318        tt-c-wth-doc.cli-name AT ROW 5.07 COL 29 COLON-ALIGNED NO-LABEL
      319              VIEW-AS TEXT
      320             SIZE 24.5 BY 1
      321        for-out-w-p-code AT ROW 5.07 COL 65.5 COLON-ALIGNED
      322        for-out-w-p-name AT ROW 5.07 COL 76 COLON-ALIGNED NO-LABEL
      323        tt-c-wth-doc.cli-code AT ROW 5.27 COL 21 COLON-ALIGNED NO-LABEL
      324              VIEW-AS TEXT
      325             SIZE 6.8 BY .67
      326        tt-c-wth-doc.fact-sum AT ROW 6.5 COL 65.5 COLON-ALIGNED
      327             LABEL "Кол-во факт"
      328              VIEW-AS TEXT
      329             SIZE 24.1 BY .67
      330        tt-c-wth-doc.doc-sum AT ROW 6.77 COL 21 COLON-ALIGNED
      331             LABEL "Кол-во по документу"
      332              VIEW-AS TEXT
      333             SIZE 18.4 BY .67
      334        tt-c-wth-doc.sum-gds-rubl AT ROW 8 COL 27 COLON-ALIGNED WIDGET-ID 4
      335             LABEL "Сумма по тов. (abbr_rubl.)"
      336              VIEW-AS TEXT
      337             SIZE 14 BY .67
      338        tt-c-wth-doc.sum-gds-base AT ROW 8 COL 65.5 COLON-ALIGNED WIDGET-ID 2
      339             LABEL "Сумма по тов.(баз. вал)" FORMAT "->>>,>>>,>>9.99"
      340              VIEW-AS TEXT
      341             SIZE 14 BY .67
      342        tt-c-wth-doc.operator AT ROW 9.27 COL 14 COLON-ALIGNED
      343             LABEL "Составил"
      344              VIEW-AS TEXT
      345             SIZE 12.3 BY .67
      346       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      347            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      348            CANCEL-BUTTON b-quit.
      349   DEFINE FRAME Dialog-Frame
      350        for-operator AT ROW 9.27 COL 29 COLON-ALIGNED NO-LABEL
      351        tt-c-wth-doc.deliver AT ROW 10.43 COL 14 COLON-ALIGNED
      352             LABEL "Передал"
      353              VIEW-AS TEXT
      354             SIZE 12.3 BY .67
      355        for-deliver AT ROW 10.5 COL 29 COLON-ALIGNED NO-LABEL
      356        for-receiver AT ROW 11.5 COL 29 COLON-ALIGNED NO-LABEL
      357        tt-c-wth-doc.receiver AT ROW 11.57 COL 14 COLON-ALIGNED
      358             LABEL "Получил"
      359              VIEW-AS TEXT
      360             SIZE 12.3 BY .67
      361        SPACE(71.57) SKIP(9.50)
      362       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      363            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      364            TITLE "Документ движения материальных ценностей: история"
      365            CANCEL-BUTTON b-quit.
      366   ASSIGN
      367          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      368          FRAME Dialog-Frame:HIDDEN           = TRUE.
      369   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      370   DO:
      371     p-next-prev = "QUIT".
      372     APPLY "END-ERROR":U TO SELF.
      373   END.
      374   ON CHOOSE OF B-chk IN FRAME Dialog-Frame
      375   DO:
      376     DEFINE VARIABLE loc-ref-list as character no-undo.
      377     DEFINE VARIABLE var-doc-code like ub.c-wth-doc.doc-code no-undo .
      378     if tt-c-wth-doc.borned then do:
      379       assign
      380       var-doc-code = tt-c-wth-doc.source-ref.
      381     end.
      382     else do:
      383       var-doc-code = tt-c-wth-doc.doc-code.
      384     end.
      385     run str/chk-docs.w (
      386                    input parparentproc
      387                   ,input '':U
      388                   ,input 'out-code':U
      389                   ,input ?
      390                   ,input parobj-type
      391                   ,input parobj-code
      392                   ,input var-doc-code
      393                   ,input ''
      394                   ,input 0
      395                   ,input ?
      396                   ,input ?
      397                   ,input 0
      398                   ,output loc-ref-list) no-error.
      399     if error-status:error then return no-apply.
      400   END.
      401   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
      402   DO:
      403   define variable v-doc-rec as recid no-undo .
      404   define variable v-line-rec as recid no-undo .
      405    if not avail buf_c-wth-line then return no-apply.
      406     ASSIGN
      407     v-line-rec = RECID( buf_c-wth-line )
      408     v-doc-rec = recid(bf_c-wth-doc)
      409     FOR-CURRENT-W-P-CODE
      410     FOR-OUT-W-P-CODE
      411     .
      412     run str/wthcinca.w (input parparentproc,
      413                     INPUT 'ПРОСМОТР':U,
      414                     input v-doc-rec,
      415                     input for-current-w-p-code,
      416                     input for-out-w-p-code,
      417                     input-output v-LINE-REC,
      418                     INPUT tt-c-wth-doc.doc-type ) no-error.
      419     apply "entry" to br-lines.
      420   END.
      421   ON CHOOSE OF B-next IN FRAME Dialog-Frame
      422   DO:
      423        run reposition-c-wth-doc in this-procedure
      424     (input 'next':U
      425     ) no-error .
      426     if error-status:error then return no-apply.
      427   END.
      428   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
      429   DO:
      430      run reposition-c-wth-doc in this-procedure
      431     (input 'prev':U
      432     ) no-error .
      433   if error-status:error then return no-apply.
      434   END.
      435   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      436   DO:
      437       p-next-prev = "QUIT".
      438   END.
      439   ON VALUE-CHANGED OF tt-c-wth-doc.cli-type IN FRAME Dialog-Frame
      440   DO:
      441    run control-out in this-procedure.
      442    FIND FIRST buf_clients NO-LOCK WHERE
      443             buf_clients.obj-type = INPUT FRAME Dialog-Frame tt-c-wth-doc.cli-type AND
      444             buf_clients.obj-code = INPUT FRAME Dialog-Frame tt-c-wth-doc.cli-code NO-ERROR.
      445   IF AVAIL buf_clients THEN DO:
      446       DISPLAY
      447       buf_clients.obj-name @ tt-c-wth-doc.cli-name WITH FRAME Dialog-Frame.
      448     END.
      449   END.
      450   ON LEAVE OF tt-c-wth-doc.deliver IN FRAME Dialog-Frame
      451   DO:
      452         FIND FIRST buf_deliver NO-LOCK WHERE
      453               buf_deliver.obj-type = 'чел':U AND
      454               buf_deliver.obj-code = INPUT FRAME Dialog-Frame tt-c-wth-doc.deliver NO-ERROR.
      455     IF AVAIL buf_deliver THEN DO:
      456       DISPLAY
      457       buf_deliver.obj-name @ for-deliver
      458           WITH FRAME Dialog-Frame.
      459     END.
      460   END.
      461   ON LEAVE OF for-current-w-p-code IN FRAME Dialog-Frame
      462   DO:
      463       FIND FIRST current-place NO-LOCK WHERE
      464               current-place.host-code = tt-c-wth-doc.host-code AND
      465               current-place.obj-type = tt-c-wth-doc.obj-type      AND
      466               current-place.obj-code = tt-c-wth-doc.obj-code      AND
      467               current-place.w-p-code = INPUT FRAME Dialog-Frame for-current-w-p-code NO-ERROR.
      468     IF AVAIL current-place THEN DO:
      469       DISPLAY
      470       current-place.w-p-name @ for-current-w-p-name
      471       WITH FRAME Dialog-Frame.
      472     END.
      473   END.
      474   ON LEAVE OF for-out-w-p-code IN FRAME Dialog-Frame
      475   DO:
      476       FIND FIRST out-place NO-LOCK WHERE
      477               out-place.host-code = tt-c-wth-doc.host-code AND
      478               out-place.obj-type = tt-c-wth-doc.obj-type AND
      479               out-place.obj-code = tt-c-wth-doc.obj-code AND
      480               out-place.w-p-code = INPUT FRAME Dialog-Frame for-out-w-p-code NO-ERROR.
      481     IF AVAIL out-place THEN DO:
      482       DISPLAY
      483       out-place.w-p-name @ for-out-w-p-name
      484           WITH FRAME Dialog-Frame.
      485     END.
      486   END.
      487   ON LEAVE OF tt-c-wth-doc.operator IN FRAME Dialog-Frame
      488   DO:
      489       FIND FIRST buf_operator NO-LOCK WHERE
      490               buf_operator.obj-type = 'чел':U AND
      491               buf_operator.obj-code = INPUT FRAME Dialog-Frame tt-c-wth-doc.operator NO-ERROR.
      492     IF AVAIL buf_operator THEN DO:
      493       DISPLAY
      494       buf_operator.obj-name @ for-operator
      495       WITH FRAME Dialog-Frame.
      496     END.
      497   END.
      498   ON LEAVE OF tt-c-wth-doc.receiver IN FRAME Dialog-Frame
      499   DO:
      500       FIND FIRST buf_receiver NO-LOCK WHERE
      501               buf_receiver.obj-type = 'чел':U AND
      502               buf_receiver.obj-code = INPUT FRAME Dialog-Frame tt-c-wth-doc.receiver NO-ERROR.
      503     IF AVAIL buf_receiver THEN DO:
      504       DISPLAY
      505       buf_receiver.obj-name @ for-receiver
      506       WITH FRAME Dialog-Frame.
      507     END.
      508   END.
      509   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      510   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      511   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   on help of frame Dialog-Frame
      513   do:
      514     run gbl/app_help.p
      515       (input this-procedure :file-name
      516       ,input ''
      517       ,input ?
      518       ) no-error.
      519     if error-status :error then do:
      520       message
      521         "Ошибка при вызове помощи"
      522         error-status :get-message(1)
      523         view-as alert-box .
      524     end.
      525   end.
      526   run minbtn-set in this-procedure .
      527   on choose of b-help in frame Dialog-Frame
      528   do:
      529     apply "help":u to frame Dialog-Frame .
      530   end.
      531   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      532   procedure minbtn-set :
      533       do
      534           on error undo, return error return-value
      535           :
      536           define variable ii              as integer       no-undo .
      537           define variable fh              as widget-handle no-undo .
      538           define variable hh              as widget-handle no-undo .
      539           define variable v-h             as handle        extent 4 no-undo .
      540           define variable v-name-button   as character     no-undo .
      541           define variable v-help-old-x    as decimal       no-undo .
      542           define variable v-help-old-y    as decimal       no-undo .
      543           define variable v-help-old-size as decimal       no-undo .
      544           define variable v-frame-width   as decimal       no-undo .
      545           define variable jj              as integer       no-undo .
      546           do
      547               on error undo, return error
      548               :
      549               assign
      550                   v-frame-width = frame Dialog-Frame:width - 0.3
      551                   fh            = frame Dialog-Frame:first-child
      552                   hh            = fh:first-child
      553                   ii            = 1
      554                   .
      555               do while valid-handle(hh):
      556                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      557                   do:
      558                       case lc(hh:name) :
      559                           when "b-help" then
      560                               do:
      561                                   hh:load-image-up("cmp/b-help.bmp":u) .
      562                                   hh:load-image-down("cmp/b-help.bmp":u) .
      563                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      564                                   hh:TOOLTIP = "Помощь" .
      565                                   v-help-old-x = hh:column .
      566                                   v-help-old-y = hh:row    .
      567                                   v-help-old-size = hh:width .
      568                                   hh:width-chars = 2.5 .
      569                               end.
      570                           when "b-print" then
      571                               do:
      572                                   hh:load-image("cmp/b-print.bmp":u) .
      573                                   hh:TOOLTIP = "Печать" .
      574                                   v-h[ii] = hh:handle .
      575                                   ii = ii + 1 .
      576                                   hh:width-chars = 3 .
      577                               end.
      578                           when "b-history" or
      579                           when "b-hist" then
      580                               do:
      581                                   hh:load-image("cmp/b-hist.bmp":u) .
      582                                   hh:TOOLTIP = "История" .
      583                                   v-h[ii] = hh:handle .
      584                                   ii = ii + 1 .
      585                                   hh:width-chars = 3 .
      586                               end.
      587                           when "b-sch" then
      588                               do:
      589                                   hh:load-image("cmp/b-sch.bmp":u) .
      590                                   hh:TOOLTIP = "Установка Фильтра" .
      591                                   v-h[ii] = hh:handle .
      592                                   ii = ii + 1 .
      593                                   hh:width-chars = 3 .
      594                               end.
      595                           when "b-hist-user" then
      596                               do:
      597                                   hh:load-image("cmp/b-hist.bmp":u) .
      598                                   hh:TOOLTIP = "История пользователя" .
      599                                   ii = ii + 1 .
      600                               end.
      601                       end case.
      602                   end.
      603                   hh = hh:next-sibling.
      604               end.
      605               b-help:column = v-frame-width - b-help:width-chars.
      606               jj = 0.
      607               repeat ii = 4 to 1 by -1 :
      608                   if valid-handle (v-h[ii] ) then
      609                   do:
      610                       jj  = jj + 1 .
      611                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      612                       v-h[ii]:row    = v-help-old-y .
      613                   end.
      614               end.
      615           end.
      616       end.
      617   end procedure.
      618   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      619   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      620   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      621   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      622   define variable v-diasize-current-frame-width  as decimal   no-undo .
      623   define variable v-diasize-current-frame-height as decimal   no-undo .
      624   define variable v-diasize-change-size          as logical   no-undo .
      625   define variable v-diasize-resize-button        as handle    no-undo .
      626   define variable v-diasize-wndmax               as logical   no-undo .
      627   define variable v-diasize-wndstore             as logical   no-undo .
      628   define variable v-diasize-proc-name            as character no-undo .
      629   define variable v-diasize-browse-handle        as handle    no-undo .
      630   define variable v-diasize-browse-number        as integer   no-undo .
      631   define variable v-diasize-need-full-display    as logical   no-undo init false .
      632   define temp-table temp-diasize-handle no-undo
      633     field handle-value  as handle
      634     field save-position as decimal
      635     index xpk is primary unique handle-value
      636     .
      637   define temp-table temp-browse-handle no-undo
      638     field browse-type   as character
      639     field browse-number as integer
      640     field browse-handle as handle
      641     field original-size as decimal
      642     index xpk is primary unique browse-type browse-number
      643     index xie browse-type browse-handle
      644   .
      645   procedure diasize_change-height :
      646     define input  parameter p-change-value  as decimal   no-undo .
      647     define input  parameter p-move-resize   as logical   no-undo .
      648     define variable v-field-group-handle    as handle    no-undo .
      649     define variable v-object-handle         as handle    no-undo .
      650     define variable v-frame-height          as decimal   no-undo .
      651     define variable v-frame-virtual-height  as decimal   no-undo .
      652     define variable v-browse-height         as decimal   no-undo .
      653     define variable v-window-height         as decimal   no-undo .
      654     define variable v-window-virtual-height as decimal   no-undo .
      655     define variable v-change-sign           as integer   no-undo .
      656     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      657     define buffer buf_temp-browse-handle  for temp-browse-handle .
      658     if p-change-value > 0
      659     then do:
      660       if frame Dialog-Frame :height + p-change-value
      661           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      662       then do:
      663         assign
      664           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      665                           - (frame Dialog-Frame :height-chars)
      666         .
      667         if p-change-value <= 0
      668         then do:
      669           run diasize_position-resize-button in this-procedure .
      670           return .
      671         end.
      672       end.
      673     end.
      674     if p-change-value < 0
      675     then do:
      676       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      677       then do:
      678         assign
      679           p-change-value = v-diasize-orig-frame-height
      680                          - (frame Dialog-Frame :height-chars)
      681         .
      682         if p-change-value >= 0
      683         then do:
      684           run diasize_position-resize-button in this-procedure .
      685           return .
      686         end.
      687       end.
      688     end.
      689     if p-change-value >= 0
      690     then do:
      691       assign
      692         v-change-sign = 1
      693       .
      694     end.
      695     else do:
      696       assign
      697         v-change-sign = -1
      698       .
      699     end.
      700     assign
      701       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      702     .
      703     if p-change-value = 0
      704     then do:
      705       run diasize_position-resize-button in this-procedure .
      706       return .
      707     end.
      708     move_block:
      709     do
      710     on error undo move_block, retry move_block
      711     :
      712       if retry
      713       then do:
      714         do
      715         on error undo move_block, leave move_block
      716         :
      717           if p-change-value > 0
      718           then do:
      719             for each buf_temp-diasize-handle
      720             on error undo, next
      721             :
      722               assign
      723                 v-object-handle = buf_temp-diasize-handle.handle-value
      724               .
      725               if v-object-handle <> v-diasize-resize-button
      726               then do:
      727                 assign
      728                   v-object-handle :row = buf_temp-diasize-handle.save-position
      729                 .
      730               end.
      731             end.
      732             assign
      733               v-diasize-browse-handle :height = v-browse-height
      734             .
      735             for each buf_temp-browse-handle
      736               where buf_temp-browse-handle.browse-type = 'height':u
      737             on error undo, next
      738             :
      739               assign
      740                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      741               .
      742             end.
      743             assign
      744               frame Dialog-Frame :height = v-frame-height
      745             .
      746             if frame Dialog-Frame :scrollable = true
      747             then do:
      748               assign
      749                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      750               .
      751             end.
      752             run diasize_position-resize-button in this-procedure .
      753           end.
      754           else do:
      755             if frame Dialog-Frame :scrollable = true
      756             then do:
      757               assign
      758                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      759               .
      760             end.
      761             assign
      762               frame Dialog-Frame :height = v-frame-height
      763             .
      764             assign
      765               v-diasize-browse-handle :height = v-browse-height
      766             .
      767             for each buf_temp-browse-handle
      768               where buf_temp-browse-handle.browse-type = 'height':u
      769             on error undo, next
      770             :
      771               assign
      772                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      773               .
      774             end.
      775             for each buf_temp-diasize-handle
      776             on error undo, next
      777             :
      778               assign
      779                 v-object-handle = buf_temp-diasize-handle.handle-value
      780               .
      781               if v-object-handle <> v-diasize-resize-button
      782               then do:
      783                 assign
      784                   v-object-handle :row = buf_temp-diasize-handle.save-position
      785                 .
      786               end.
      787             end.
      788             run diasize_position-resize-button in this-procedure .
      789           end.
      790           assign
      791             v-diasize-change-size = false
      792           .
      793           leave move_block .
      794         end.
      795       end.
      796       assign
      797         v-diasize-need-full-display = true
      798       .
      799       if v-diasize-change-size = false
      800       then do:
      801         assign
      802           v-diasize-change-size = true
      803         .
      804       end.
      805       else do:
      806         return .
      807       end.
      808       assign
      809         v-frame-height = frame Dialog-Frame :height
      810         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      811         v-browse-height = v-diasize-browse-handle :height
      812       .
      813       for each buf_temp-browse-handle
      814         where buf_temp-browse-handle.browse-type = 'height':u
      815       :
      816         assign
      817           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      818         .
      819       end.
      820       for each buf_temp-diasize-handle
      821       :
      822         delete buf_temp-diasize-handle .
      823       end.
      824       assign
      825         v-field-group-handle = frame Dialog-Frame :first-child
      826       .
      827       do while valid-handle(v-field-group-handle)
      828       :
      829         assign
      830           v-object-handle = v-field-group-handle :first-child
      831         .
      832         do while valid-handle(v-object-handle)
      833         :
      834           if  v-object-handle <> v-diasize-browse-handle :handle
      835           and can-query(v-object-handle, "row")
      836           and can-query(v-object-handle, "height")
      837           and ( v-object-handle :row > v-diasize-browse-handle :row )
      838           then do:
      839             find first buf_temp-browse-handle
      840               where buf_temp-browse-handle.browse-type   = 'height':u
      841                 and buf_temp-browse-handle.browse-handle = v-object-handle
      842               no-error .
      843             if available buf_temp-browse-handle
      844             then do:
      845             end.
      846             else do:
      847               create buf_temp-diasize-handle .
      848               assign
      849                 buf_temp-diasize-handle.handle-value  = v-object-handle
      850                 buf_temp-diasize-handle.save-position = v-object-handle :row
      851               .
      852             end.
      853           end.
      854           assign
      855             v-object-handle = v-object-handle :next-sibling
      856           .
      857         end.
      858         assign
      859           v-field-group-handle = v-field-group-handle :next-sibling
      860         .
      861       end.
      862       do with frame Dialog-Frame
      863       :
      864         hide v-diasize-resize-button .
      865         assign
      866           v-diasize-resize-button :row    = 1
      867           v-diasize-resize-button :column = 1
      868         .
      869       end.
      870       if p-change-value > 0
      871       then do:
      872         if frame Dialog-Frame :scrollable = true
      873         then do:
      874           assign
      875             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      876             no-error .
      877           if error-status :error
      878           or error-status :get-message(1) <> ""
      879           then do:
      880             undo move_block, retry move_block .
      881           end.
      882         end.
      883         assign
      884           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      885           no-error .
      886         if error-status :error
      887         or error-status :get-message(1) <> ""
      888         then do:
      889           undo move_block, retry move_block .
      890         end.
      891         assign
      892           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      893           no-error .
      894         if error-status :error
      895         or error-status :get-message(1) <> ""
      896         then do:
      897           undo move_block, retry move_block .
      898         end.
      899         for each buf_temp-browse-handle
      900           where buf_temp-browse-handle.browse-type = 'height':u
      901         on error undo move_block, retry move_block
      902         :
      903           assign
      904             buf_temp-browse-handle.browse-handle :height
      905               = buf_temp-browse-handle.browse-handle :height + p-change-value
      906             no-error .
      907           if error-status :error
      908           or error-status :get-message(1) <> ""
      909           then do:
      910             undo move_block, retry move_block .
      911           end.
      912         end.
      913         for each buf_temp-diasize-handle
      914         on error undo move_block, retry move_block
      915         :
      916           assign
      917             v-object-handle = buf_temp-diasize-handle.handle-value
      918           .
      919           if v-object-handle <> v-diasize-resize-button
      920           then do:
      921             assign
      922               v-object-handle :row = v-object-handle :row + p-change-value
      923               no-error .
      924             if error-status :error
      925             or error-status :get-message(1) <> ""
      926             then do:
      927               undo move_block, retry move_block .
      928             end.
      929           end.
      930         end.
      931       end.
      932       else do:
      933         for each buf_temp-diasize-handle
      934         on error undo move_block, retry move_block
      935         :
      936           assign
      937             v-object-handle = buf_temp-diasize-handle.handle-value
      938           .
      939           if v-object-handle <> v-diasize-resize-button
      940           then do:
      941             assign
      942               v-object-handle :row = v-object-handle :row + p-change-value
      943               no-error .
      944             if error-status :error
      945             or error-status :get-message(1) <> ""
      946             then do:
      947               undo move_block, retry move_block .
      948             end.
      949           end.
      950         end.
      951         assign
      952           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      953           no-error .
      954         if error-status :error
      955         or error-status :get-message(1) <> ""
      956         then do:
      957           undo move_block, retry move_block .
      958         end.
      959         for each buf_temp-browse-handle
      960           where buf_temp-browse-handle.browse-type = 'height':u
      961         on error undo move_block, retry move_block
      962         :
      963           assign
      964             buf_temp-browse-handle.browse-handle :height
      965               = buf_temp-browse-handle.browse-handle :height + p-change-value
      966             no-error .
      967           if error-status :error
      968           or error-status :get-message(1) <> ""
      969           then do:
      970             undo move_block, retry move_block .
      971           end.
      972         end.
      973         assign
      974           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      975           no-error .
      976         if error-status :error
      977         or error-status :get-message(1) <> ""
      978         then do:
      979           undo move_block, retry move_block .
      980         end.
      981         if frame Dialog-Frame :scrollable = true
      982         then do:
      983           assign
      984             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      985             no-error .
      986           if error-status :error
      987           or error-status :get-message(1) <> ""
      988           then do:
      989             undo move_block, retry move_block .
      990           end.
      991         end.
      992       end.
      993       if p-move-resize = true
      994       then do:
      995         run diasize_position-resize-button in this-procedure .
      996       end.
      997       if v-diasize-wndstore = true
      998       then do:
      999         if connected("ub") = true
     1000         then do:
     1001           define variable v-cntxt-db-num        as integer   no-undo .
     1002           define variable v-cntxt-userid        as character no-undo .
     1003           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1004                                             , OUTPUT v-cntxt-userid
     1005                                             ) .
     1006           run gbl/wndsizew.p
     1007             (input  v-cntxt-db-num
     1008             ,input  v-cntxt-userid
     1009             ,input  v-diasize-proc-name
     1010             ,input  'height':u
     1011             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1012             ) .
     1013         end.
     1014       end.
     1015     end.
     1016     assign
     1017       v-diasize-change-size = false
     1018     .
     1019   end procedure.
     1020   procedure diasize_set-height :
     1021     define input  parameter p-new-height  as decimal   no-undo .
     1022     define input  parameter p-move-resize as logical   no-undo .
     1023     do
     1024     on error undo, return error return-value
     1025     :
     1026       run diasize_change-height in this-procedure
     1027         (input  (p-new-height - frame Dialog-Frame :height)
     1028         ,input  p-move-resize
     1029         ) .
     1030     end.
     1031   end procedure.
     1032   procedure diasize_change-width :
     1033     define input  parameter p-change-value as decimal   no-undo .
     1034     define input  parameter p-move-resize  as logical   no-undo .
     1035     define variable v-field-group-handle   as handle    no-undo .
     1036     define variable v-object-handle        as handle    no-undo .
     1037     define variable v-frame-width          as decimal   no-undo .
     1038     define variable v-frame-virtual-width  as decimal   no-undo .
     1039     define variable v-browse-width         as decimal   no-undo .
     1040     define variable v-window-width         as decimal   no-undo .
     1041     define variable v-window-virtual-width as decimal   no-undo .
     1042     define variable v-change-sign          as integer   no-undo .
     1043     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1044     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1045     if p-change-value > 0
     1046     then do:
     1047       if frame Dialog-Frame :width + p-change-value >
     1048           session :width-chars
     1049       then do:
     1050         assign
     1051           p-change-value = session :width-chars - frame Dialog-Frame :width
     1052         .
     1053         if p-change-value <= 0
     1054         then do:
     1055           run diasize_position-resize-button in this-procedure .
     1056           return .
     1057         end.
     1058       end.
     1059     end.
     1060     if p-change-value < 0
     1061     then do:
     1062       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1063       then do:
     1064         assign
     1065           p-change-value = v-diasize-orig-frame-width
     1066                          - frame Dialog-Frame :width
     1067         .
     1068         if p-change-value >= 0
     1069         then do:
     1070           run diasize_position-resize-button in this-procedure .
     1071           return .
     1072         end.
     1073       end.
     1074     end.
     1075     if p-change-value >= 0
     1076     then do:
     1077       assign
     1078         v-change-sign = 1
     1079       .
     1080     end.
     1081     else do:
     1082       assign
     1083         v-change-sign = -1
     1084       .
     1085     end.
     1086     assign
     1087       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1088     .
     1089     if p-change-value = 0
     1090     then do:
     1091       run diasize_position-resize-button in this-procedure .
     1092       return .
     1093     end.
     1094     move_block:
     1095     do
     1096     on error undo move_block, leave move_block
     1097     :
     1098       if retry
     1099       then do:
     1100         do
     1101         on error undo move_block, leave move_block
     1102         :
     1103           if p-change-value > 0
     1104           then do:
     1105             for each buf_temp-diasize-handle
     1106             on error undo, next
     1107             :
     1108               assign
     1109                 v-object-handle = buf_temp-diasize-handle.handle-value
     1110               .
     1111               if v-object-handle <> v-diasize-resize-button
     1112               then do:
     1113                 assign
     1114                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1115                 .
     1116               end.
     1117             end.
     1118             assign
     1119               v-diasize-browse-handle :width = v-browse-width
     1120             .
     1121             for each buf_temp-browse-handle
     1122               where buf_temp-browse-handle.browse-type = 'width':u
     1123             on error undo, next
     1124             :
     1125               assign
     1126                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1127               .
     1128             end.
     1129             assign
     1130               frame Dialog-Frame :width = v-frame-width
     1131             .
     1132             if frame Dialog-Frame :scrollable = true
     1133             then do:
     1134               assign
     1135                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1136               .
     1137             end.
     1138             run diasize_position-resize-button in this-procedure .
     1139           end.
     1140           else do:
     1141             if frame Dialog-Frame :scrollable = true
     1142             then do:
     1143               assign
     1144                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1145               .
     1146             end.
     1147             assign
     1148               frame Dialog-Frame :width = v-frame-width
     1149             .
     1150             for each buf_temp-browse-handle
     1151               where buf_temp-browse-handle.browse-type = 'width':u
     1152             on error undo, next
     1153             :
     1154               assign
     1155                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1156               .
     1157             end.
     1158             assign
     1159               v-diasize-browse-handle :width = v-browse-width
     1160             .
     1161             for each buf_temp-diasize-handle
     1162             on error undo, next
     1163             :
     1164               assign
     1165                 v-object-handle = buf_temp-diasize-handle.handle-value
     1166               .
     1167               if v-object-handle <> v-diasize-resize-button
     1168               then do:
     1169                 assign
     1170                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1171                 .
     1172               end.
     1173             end.
     1174             run diasize_position-resize-button in this-procedure .
     1175           end.
     1176           assign
     1177             v-diasize-change-size = false
     1178           .
     1179           leave move_block .
     1180         end.
     1181       end.
     1182       assign
     1183         v-diasize-need-full-display = true
     1184       .
     1185       if v-diasize-change-size = false
     1186       then do:
     1187         assign
     1188           v-diasize-change-size = true
     1189         .
     1190       end.
     1191       else do:
     1192         return .
     1193       end.
     1194       assign
     1195         v-frame-width = frame Dialog-Frame :width
     1196         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1197         v-browse-width = v-diasize-browse-handle :width
     1198       .
     1199       for each buf_temp-browse-handle
     1200         where buf_temp-browse-handle.browse-type = 'width':u
     1201       :
     1202         assign
     1203           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1204         .
     1205       end.
     1206       for each buf_temp-diasize-handle
     1207       :
     1208         delete buf_temp-diasize-handle .
     1209       end.
     1210       assign
     1211         v-field-group-handle = frame Dialog-Frame :first-child
     1212       .
     1213       do while valid-handle(v-field-group-handle)
     1214       :
     1215         assign
     1216           v-object-handle = v-field-group-handle :first-child
     1217         .
     1218         do while valid-handle(v-object-handle)
     1219         :
     1220           if  v-object-handle <> v-diasize-browse-handle :handle
     1221           and v-object-handle <> v-diasize-resize-button
     1222           and can-query(v-object-handle, "row")
     1223           and can-query(v-object-handle, "height")
     1224           and ( v-object-handle :col + v-object-handle :width
     1225                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1226               )
     1227           then do:
     1228             find first buf_temp-browse-handle
     1229               where buf_temp-browse-handle.browse-type   = 'width':u
     1230                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1231               no-error .
     1232             if available buf_temp-browse-handle
     1233             then do:
     1234             end.
     1235             else do:
     1236               create buf_temp-diasize-handle .
     1237               assign
     1238                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1239                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1240               .
     1241             end.
     1242           end.
     1243           assign
     1244             v-object-handle = v-object-handle :next-sibling
     1245           .
     1246         end.
     1247         assign
     1248           v-field-group-handle = v-field-group-handle :next-sibling
     1249         .
     1250       end.
     1251       do with frame Dialog-Frame
     1252       :
     1253         hide v-diasize-resize-button .
     1254         v-diasize-resize-button :row = 1.
     1255         v-diasize-resize-button :column = 1.
     1256       end.
     1257       if p-change-value > 0
     1258       then do:
     1259         if frame Dialog-Frame :scrollable = true
     1260         then do:
     1261           assign
     1262             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1263             no-error .
     1264           if error-status :error
     1265           or error-status :get-message(1) <> ""
     1266           then do:
     1267             undo move_block, retry move_block.
     1268           end.
     1269         end.
     1270         assign
     1271           frame Dialog-Frame :width = v-frame-width + p-change-value
     1272           no-error .
     1273         if error-status :error
     1274         or error-status :get-message(1) <> ""
     1275         then do:
     1276           undo move_block, retry move_block.
     1277         end.
     1278         assign
     1279           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1280         no-error .
     1281         if error-status :error
     1282         or error-status :get-message(1) <> ""
     1283         then do:
     1284           undo move_block, retry move_block.
     1285         end.
     1286         for each buf_temp-browse-handle
     1287           where buf_temp-browse-handle.browse-type = 'width':u
     1288         on error undo move_block, retry move_block
     1289         :
     1290           assign
     1291             buf_temp-browse-handle.browse-handle :width
     1292               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1293             no-error .
     1294           if error-status :error
     1295           or error-status :get-message(1) <> ""
     1296           then do:
     1297             undo move_block, retry move_block .
     1298           end.
     1299         end.
     1300         for each buf_temp-diasize-handle
     1301         on error undo move_block, retry move_block
     1302         :
     1303           assign
     1304             v-object-handle = buf_temp-diasize-handle.handle-value
     1305           .
     1306           if v-object-handle <> v-diasize-resize-button
     1307           then do:
     1308             assign
     1309               v-object-handle :col = v-object-handle :col + p-change-value
     1310               no-error .
     1311             if error-status :error
     1312             or error-status :get-message(1) <> ""
     1313             then do:
     1314               undo move_block, retry move_block .
     1315             end.
     1316           end.
     1317         end.
     1318       end.
     1319       else do:
     1320         for each buf_temp-diasize-handle
     1321         on error undo move_block, retry move_block
     1322         :
     1323           assign
     1324             v-object-handle = buf_temp-diasize-handle.handle-value
     1325           .
     1326           if v-object-handle <> v-diasize-resize-button
     1327           then do:
     1328             assign
     1329               v-object-handle :col = v-object-handle :col + p-change-value
     1330               no-error .
     1331             if error-status :error
     1332             or error-status :get-message(1) <> ""
     1333             then do:
     1334               undo move_block, retry move_block .
     1335             end.
     1336           end.
     1337         end.
     1338         for each buf_temp-browse-handle
     1339           where buf_temp-browse-handle.browse-type = 'width':u
     1340         on error undo move_block, retry move_block
     1341         :
     1342           assign
     1343             buf_temp-browse-handle.browse-handle :width
     1344               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1345             no-error .
     1346           if error-status :error
     1347           or error-status :get-message(1) <> ""
     1348           then do:
     1349             undo move_block, retry move_block .
     1350           end.
     1351         end.
     1352         assign
     1353           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1354           no-error .
     1355         if error-status :error
     1356         or error-status :get-message(1) <> ""
     1357         then do:
     1358           undo move_block, retry move_block.
     1359         end.
     1360         assign
     1361           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1362         no-error .
     1363         if error-status :error
     1364         or error-status :get-message(1) <> ""
     1365         then do:
     1366           undo move_block, retry move_block.
     1367         end.
     1368         if frame Dialog-Frame :scrollable = true
     1369         then do:
     1370           assign
     1371             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1372           no-error .
     1373           if error-status :error
     1374           or error-status :get-message(1) <> ""
     1375           then do:
     1376             undo move_block, retry move_block.
     1377           end.
     1378         end.
     1379       end.
     1380       if p-move-resize
     1381       then do:
     1382         run diasize_position-resize-button in this-procedure .
     1383       end.
     1384       if v-diasize-wndstore = true
     1385       then do:
     1386         if connected("ub") = true
     1387         then do:
     1388           define variable v-cntxt-db-num        as integer   no-undo .
     1389           define variable v-cntxt-userid        as character no-undo .
     1390           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1391                                             , OUTPUT v-cntxt-userid
     1392                                             ) .
     1393           run gbl/wndsizew.p
     1394             (input  v-cntxt-db-num
     1395             ,input  v-cntxt-userid
     1396             ,input  v-diasize-proc-name
     1397             ,input  'width':u
     1398             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1399             ) .
     1400         end.
     1401       end.
     1402     end.
     1403     assign
     1404       v-diasize-change-size = false
     1405     .
     1406   end procedure.
     1407   procedure diasize_set-width :
     1408     define input  parameter p-new-width  as decimal   no-undo .
     1409     define input  parameter p-move-resize as logical   no-undo .
     1410     do
     1411     on error undo, return error return-value
     1412     :
     1413       run diasize_change-width in this-procedure
     1414         (input  (p-new-width - frame Dialog-Frame :width)
     1415         ,input  p-move-resize
     1416         ) .
     1417     end.
     1418   end procedure.
     1419   procedure diasize_position-resize-button :
     1420     do with frame Dialog-Frame
     1421     :
     1422       hide v-diasize-resize-button .
     1423       assign
     1424         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1425                     - 1
     1426                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1427         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1428                     - 1
     1429                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1430       .
     1431       view v-diasize-resize-button .
     1432     end.
     1433   end procedure.
     1434   on alt-right anywhere
     1435   do:
     1436     run diasize_change-width in this-procedure
     1437       (input 1
     1438       ,input true
     1439       ) .
     1440     return no-apply .
     1441   end.
     1442   on alt-left anywhere
     1443   do:
     1444     run diasize_change-width in this-procedure
     1445       (input -1
     1446       ,input true
     1447       ) .
     1448     return no-apply .
     1449   end.
     1450   on alt-down anywhere
     1451   do:
     1452     run diasize_change-height in this-procedure
     1453       (input 1
     1454       ,input true
     1455       ) .
     1456     return no-apply .
     1457   end.
     1458   on alt-up anywhere
     1459   do:
     1460     run diasize_change-height in this-procedure
     1461       (input -1
     1462       ,input true
     1463       ) .
     1464     return no-apply .
     1465   end.
     1466   on alt-enter of frame Dialog-Frame
     1467   do:
     1468     run diasize_maximize in this-procedure
     1469       (input  ?
     1470       ).
     1471     return no-apply .
     1472   end.
     1473   procedure diasize_end-move :
     1474     do
     1475     on error undo, return error return-value
     1476     :
     1477       define variable v-row-delta as decimal   no-undo .
     1478       define variable v-col-delta as decimal   no-undo .
     1479       define variable v-new-row as decimal   no-undo .
     1480       define variable v-new-col as decimal   no-undo .
     1481       assign
     1482         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1483         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1484       .
     1485       assign
     1486         v-row-delta = v-new-row - frame Dialog-Frame :height
     1487         v-col-delta = v-new-col - frame Dialog-Frame :width
     1488       .
     1489       run diasize_change-height in this-procedure
     1490         (input v-row-delta
     1491         ,input true
     1492         ) .
     1493       run diasize_change-width in this-procedure
     1494         (input v-col-delta
     1495         ,input true
     1496         ) .
     1497     end.
     1498   end procedure.
     1499   procedure diasize_maximize :
     1500     define input  parameter p-action as logical   no-undo .
     1501     do
     1502     on error undo, return error return-value
     1503     :
     1504       if p-action = ?
     1505       then do:
     1506         if v-diasize-need-maximize = true
     1507         then do:
     1508           assign
     1509             p-action = true
     1510           .
     1511         end.
     1512         else do:
     1513           assign
     1514             p-action = false
     1515           .
     1516         end.
     1517       end.
     1518       if p-action = true
     1519       then do:
     1520         run diasize_change-height in this-procedure
     1521           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1522               - frame Dialog-Frame :height-chars
     1523           ,input true
     1524           ) .
     1525         run diasize_change-width in this-procedure
     1526           (input session :width-chars
     1527               - frame Dialog-Frame :width-chars
     1528           ,input true
     1529           ) .
     1530         assign
     1531           v-diasize-need-maximize = false
     1532         .
     1533       end.
     1534       else do:
     1535         run diasize_change-width in this-procedure
     1536           (input v-diasize-orig-frame-width
     1537               - frame Dialog-Frame :width-chars
     1538           ,input true
     1539           ) .
     1540         run diasize_change-height in this-procedure
     1541           (input v-diasize-orig-frame-height
     1542               - frame Dialog-Frame :height-chars
     1543           ,input true
     1544           ) .
     1545         assign
     1546           v-diasize-need-maximize = true
     1547         .
     1548       end.
     1549     end.
     1550   end procedure.
     1551   procedure diasize_restore-orig-size :
     1552     do
     1553     on error undo, return error return-value
     1554     :
     1555       assign
     1556         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1557         v-diasize-current-frame-height = frame Dialog-Frame :height
     1558       .
     1559       run diasize_set-height in this-procedure
     1560         (input  v-diasize-orig-frame-height
     1561         ,input  true
     1562         ) .
     1563       run diasize_set-width in this-procedure
     1564         (input  v-diasize-orig-frame-width
     1565         ,input  true
     1566         ) .
     1567     end.
     1568   end procedure.
     1569   procedure diasize_restore-current-size :
     1570     do
     1571     on error undo, return error return-value
     1572     :
     1573       run diasize_set-height in this-procedure
     1574         (input  v-diasize-current-frame-height
     1575         ,input  true
     1576         ) .
     1577       run diasize_set-width in this-procedure
     1578         (input  v-diasize-current-frame-width
     1579         ,input  true
     1580         ) .
     1581     end.
     1582   end procedure.
     1583   procedure diasize_set-browse-handle :
     1584     define input  parameter p-browse-handle as handle   no-undo .
     1585     define buffer buf_temp-browse-handle for temp-browse-handle .
     1586     do
     1587     on error undo, return error return-value
     1588     :
     1589       assign
     1590         v-diasize-browse-handle = p-browse-handle
     1591       .
     1592       for each buf_temp-browse-handle
     1593       on error undo, return error return-value
     1594       :
     1595         delete buf_temp-browse-handle .
     1596       end.
     1597     end.
     1598   end procedure.
     1599   procedure diasize_add_browse :
     1600     define input  parameter p-browse-type   as character no-undo .
     1601     define input  parameter p-browse-handle as handle    no-undo .
     1602     define buffer buf_temp-browse-handle for temp-browse-handle .
     1603     do
     1604     on error undo, return error return-value
     1605     :
     1606       assign
     1607         v-diasize-browse-number = v-diasize-browse-number + 1
     1608       .
     1609       create buf_temp-browse-handle .
     1610       assign
     1611         buf_temp-browse-handle.browse-type   = p-browse-type
     1612         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1613         buf_temp-browse-handle.browse-handle = p-browse-handle
     1614       .
     1615     end.
     1616   end procedure.
     1617   procedure diasize_init :
     1618     define variable v-default-value    as logical   no-undo .
     1619     define variable v-restore-saved    as logical   no-undo .
     1620     define variable v-resize-value-str as character no-undo .
     1621     do
     1622     on error undo, return error return-value
     1623     :
     1624       do with frame Dialog-Frame
     1625       :
     1626         assign
     1627           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1628           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1629           v-diasize-browse-handle     = browse BR-lines :handle
     1630         .
     1631         create button v-diasize-resize-button
     1632         assign
     1633           parent        = frame Dialog-Frame :first-child
     1634           label         = "s"
     1635           height-pixels = 16
     1636           width-pixels  = 16
     1637           visible       = true
     1638           sensitive     = true
     1639           movable       = true
     1640           triggers:
     1641             on end-move persistent run diasize_end-move in this-procedure .
     1642           end triggers.
     1643         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1644         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1645         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1646         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1647         assign
     1648           v-diasize-wndmax = false
     1649         .
     1650         if connected("ub") = true
     1651         then do:
     1652           define variable v-cntxt-db-num        as integer   no-undo .
     1653           define variable v-cntxt-userid        as character no-undo .
     1654           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1655                                             , OUTPUT v-cntxt-userid
     1656                                             ) .
     1657           run gbl/wndpar_r.p
     1658             (input  v-cntxt-db-num
     1659             ,input  v-cntxt-userid
     1660             ,input  'wndmax':U
     1661             ,output v-diasize-wndmax
     1662             ,output v-default-value
     1663             ) .
     1664         end.
     1665         assign
     1666           v-diasize-wndstore = false
     1667         .
     1668         if connected("ub") = true
     1669         then do:
     1670           run gbl/wndpar_r.p
     1671             (input  v-cntxt-db-num
     1672             ,input  v-cntxt-userid
     1673             ,input  'wndstore':U
     1674             ,output v-diasize-wndstore
     1675             ,output v-default-value
     1676             ) .
     1677         end.
     1678         assign
     1679           v-diasize-proc-name = entry(1, program-name(2), '.')
     1680         .
     1681         if v-diasize-wndstore = true
     1682         then do:
     1683           assign
     1684             v-restore-saved = false
     1685           .
     1686           if connected("ub") = true
     1687           then do:
     1688             run gbl/wndsizer.p
     1689               (input  v-cntxt-db-num
     1690               ,input  v-cntxt-userid
     1691               ,input  v-diasize-proc-name
     1692               ,input  'height':u
     1693               ,output v-resize-value-str
     1694               ) .
     1695             if v-resize-value-str <> '':U
     1696             then do:
     1697               run diasize_change-height in this-procedure
     1698                 (input  integer(v-resize-value-str)
     1699                 ,input  true
     1700                 ) .
     1701               assign
     1702                 v-restore-saved = true
     1703               .
     1704             end.
     1705           end.
     1706           if connected("ub") = true
     1707           then do:
     1708             run gbl/wndsizer.p
     1709               (input  v-cntxt-db-num
     1710               ,input  v-cntxt-userid
     1711               ,input  v-diasize-proc-name
     1712               ,input  'width':u
     1713               ,output v-resize-value-str
     1714               ) .
     1715             if v-resize-value-str <> '':U
     1716             then do:
     1717               run diasize_change-width in this-procedure
     1718                 (input  integer(v-resize-value-str)
     1719                 ,input  true
     1720                 ) .
     1721               assign
     1722                 v-restore-saved = true
     1723               .
     1724             end.
     1725           end.
     1726           if v-restore-saved <> true
     1727           then do:
     1728             if v-diasize-wndmax = true
     1729             then do:
     1730               run diasize_maximize in this-procedure
     1731                 (input  true
     1732                 ) .
     1733             end.
     1734           end.
     1735         end.
     1736         else do:
     1737           if v-diasize-wndmax = true
     1738           then do:
     1739             run diasize_maximize in this-procedure
     1740               (input  true
     1741               ) .
     1742           end.
     1743         end.
     1744       end.
     1745     end.
     1746   end procedure.
     1747   procedure diasize_need-full-display :
     1748     define output parameter p-need-full-display as logical   no-undo .
     1749     do
     1750     on error undo, return error return-value
     1751     :
     1752       assign
     1753         p-need-full-display = v-diasize-need-full-display
     1754       .
     1755       assign
     1756         v-diasize-need-full-display = false
     1757       .
     1758     end.
     1759   end procedure.
     1760   procedure get-context :
     1761      define output parameter p-db-num as integer          no-undo.
     1762      define output parameter p-user-id as character        no-undo.
     1763      define variable v-login               as character    no-undo.
     1764      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1765      define buffer buf_user-login  for ub.user-login .
     1766      do
     1767      on error undo, return error
     1768      :
     1769            FIND FIRST buf_sys-ctrl no-lock.
     1770            ASSIGN
     1771               v-login = USERID("ub")
     1772               p-db-num = buf_sys-ctrl.db-num
     1773            .
     1774            FIND FIRST buf_user-login
     1775                 WHERE buf_user-login.db-num = p-db-num
     1776                   AND buf_user-login.user-login = v-login
     1777                 no-lock
     1778                 no-error
     1779                 .
     1780            IF AVAILABLE buf_user-login
     1781            THEN DO:
     1782               assign
     1783                  p-user-id = buf_user-login.user-id
     1784               .
     1785            END.
     1786      end.
     1787   end procedure.
     1788       run diasize_init in this-procedure .
     1789   p-next-prev = "":U.
     1790   n-p: do while p-next-prev = '':U:
     1791   MAIN-BLOCK:
     1792   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1793      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1794       if par-mode <> 'ПРОСМОТР':U then do:
     1795           message vss-workfile vss-revision vss-description skip
     1796                       "Неверный параметр вызова par-mode"
     1797           view-as alert-box ERROR.
     1798           return error.
     1799       end.
     1800       if not par-mode = 'ПРОСМОТР':U then
     1801       p-next-prev = "QUIT".
     1802       find first ub.sysconf No-LOCK WHERE
     1803                        ub.sysconf.host-code = parhost-code No-ERROR.
     1804       if not avail ub.sysconf then do:
     1805           message vss-workfile vss-revision vss-description skip
     1806                           "Неверный параметр вызова parhost-code"
     1807               view-as alert-box ERROR.
     1808               return error.
     1809       end.
     1810       find first ub.clients No-LOCK WHERE
     1811                   ub.clients.obj-type = parobj-type AND
     1812                   ub.clients.obj-code = parobj-code No-ERROR.
     1813       if not avail ub.clients then do:
     1814           message vss-workfile vss-revision vss-description skip
     1815                           "Неверный параметр вызова parobj-type/parobj-code"
     1816               view-as alert-box ERROR.
     1817               return error.
     1818       end.
     1819       if parcli-type <> '':U or parcli-code <> 0 then do:
     1820           find first ub.clients No-LOCK WHERE
     1821                       ub.clients.obj-type = parcli-type AND
     1822                       ub.clients.obj-code = parcli-code No-ERROR.
     1823           if not avail ub.clients then do:
     1824               message vss-workfile vss-revision vss-description skip
     1825                               "Неверный параметр вызова parcli-type/parcli-code"
     1826                   view-as alert-box ERROR.
     1827                   return error.
     1828           end.
     1829       end.
     1830       if LOOKUP(par-type, "при,рас,спи") = 0 then do:
     1831               message vss-workfile vss-revision vss-description skip
     1832                               "Неверный параметр вызова par-type"
     1833                   view-as alert-box ERROR.
     1834                   return error.
     1835       end.
     1836       tt-c-wth-doc.cli-type:list-items = 'орг':U + chr(44) +
     1837                                       'чел':U + chr(44) +
     1838                                       'маг':U + chr(44) +
     1839                                       'скл':U + chr(44).
     1840       tt-c-wth-doc.obj-type:list-items = 'орг':U + chr(44) +
     1841                                       'чел':U + chr(44) +
     1842                                       'маг':U + chr(44) +
     1843                                       'скл':U + chr(44).
     1844     Run fill-tables no-error.
     1845     if error-status:error then return error.
     1846     RUN Myenable in this-procedure .
     1847     WAIT-FOR GO OF FRAME Dialog-Frame.
     1848   END.
     1849   end.
     1850   RUN disable_UI.
     1851   PROCEDURE control-line :
     1852   DEFINE OUTPUT PARAMETER lock-doc as logical no-undo.
     1853   IF CAN-FIND(FIRST ub.c-wth-line No-LOCK WHERE
     1854                     ub.c-wth-line.doc-code = tt-c-wth-doc.doc-code
     1855                 AND ub.c-wth-line.chip-num = tt-c-wth-doc.chip-num
     1856                 AND ub.c-wth-line.corr-user-db-num = tt-c-wth-doc.corr-user-db-num
     1857                 ) then
     1858   lock-doc = yes.
     1859   else lock-doc = no.
     1860   END PROCEDURE.
     1861   PROCEDURE control-out :
     1862    IF INPUT FRAME Dialog-Frame tt-c-wth-doc.cli-type = 'чел':U   OR
     1863       INPUT FRAME Dialog-Frame tt-c-wth-doc.cli-type = 'орг':U THEN DO:
     1864       DISABLE
     1865       for-out-w-p-code
     1866       WITH FRAME Dialog-Frame.
     1867       HIDE
     1868       for-out-w-p-code IN FRAME Dialog-Frame
     1869       for-out-w-p-name IN FRAME Dialog-Frame
     1870       .
     1871       locked-out = yes.
     1872     END.
     1873   END PROCEDURE.
     1874   PROCEDURE disable_UI :
     1875     HIDE FRAME Dialog-Frame.
     1876   END PROCEDURE.
     1877   PROCEDURE enable_UI :
     1878     OPEN QUERY Dialog-Frame FOR EACH tt-c-wth-doc SHARE-LOCK,              EACH buf_obj WHERE buf_obj.obj-type = tt-c-wth-doc.obj-type   AND buf_obj.obj-code = tt-c-wth-doc.obj-code SHARE-LOCK,              EACH buf_clients WHERE buf_clients.obj-type = tt-c-wth-doc.cli-type   AND buf_clients.obj-code = tt-c-wth-doc.cli-code SHARE-LOCK,              EACH first_c-wth-line WHERE first_c-wth-line.doc-code = tt-c-wth-doc.doc-code   AND first_c-wth-line.corr-user-db-num = tt-c-wth-doc.corr-user-db-num   AND first_c-wth-line.chip-num = tt-c-wth-doc.chip-num SHARE-LOCK,              EACH out-place WHERE out-place.w-p-code = first_c-wth-line.out-code SHARE-LOCK,              EACH buf_operator WHERE buf_operator.obj-code = tt-c-wth-doc.operator   AND buf_operator.obj-type = 'чел':U SHARE-LOCK,              EACH buf_deliver WHERE buf_deliver.obj-code = tt-c-wth-doc.deliver   AND buf_deliver.obj-type = 'чел':U SHARE-LOCK,              EACH buf_receiver WHERE buf_receiver.obj-code = tt-c-wth-doc.receiver   AND buf_receiver.obj-type = 'чел':U SHARE-LOCK.
     1879     GET FIRST Dialog-Frame.
     1880     DISPLAY for-object for-current-w-p-code for-current-w-p-name for-out-w-p-code
     1881             for-out-w-p-name for-operator for-deliver for-receiver
     1882         WITH FRAME Dialog-Frame.
     1883     IF AVAILABLE tt-c-wth-doc THEN
     1884       DISPLAY tt-c-wth-doc.obj-type tt-c-wth-doc.cli-type
     1885             tt-c-wth-doc.corr-user-name tt-c-wth-doc.corr-date
     1886             tt-c-wth-doc.doc-code tt-c-wth-doc.doc-date tt-c-wth-doc.fact-date
     1887             tt-c-wth-doc.shift-date tt-c-wth-doc.shift-name tt-c-wth-doc.shift-num
     1888             tt-c-wth-doc.obj-code tt-c-wth-doc.cli-name tt-c-wth-doc.cli-code
     1889             tt-c-wth-doc.fact-sum tt-c-wth-doc.doc-sum tt-c-wth-doc.sum-gds-rubl
     1890             tt-c-wth-doc.sum-gds-base tt-c-wth-doc.operator tt-c-wth-doc.deliver
     1891             tt-c-wth-doc.receiver
     1892         WITH FRAME Dialog-Frame.
     1893     ENABLE b-quit B-prev B-next B-Help BR-lines B-lookup B-chk
     1894            tt-c-wth-doc.corr-user-name tt-c-wth-doc.corr-date
     1895            tt-c-wth-doc.doc-date tt-c-wth-doc.fact-date tt-c-wth-doc.shift-date
     1896            tt-c-wth-doc.shift-name tt-c-wth-doc.shift-num tt-c-wth-doc.obj-code
     1897            for-object for-current-w-p-code for-current-w-p-name
     1898            tt-c-wth-doc.cli-name for-out-w-p-code for-out-w-p-name
     1899            tt-c-wth-doc.cli-code tt-c-wth-doc.fact-sum tt-c-wth-doc.doc-sum
     1900            tt-c-wth-doc.sum-gds-rubl tt-c-wth-doc.sum-gds-base
     1901            tt-c-wth-doc.operator for-operator tt-c-wth-doc.deliver for-deliver
     1902            for-receiver tt-c-wth-doc.receiver
     1903         WITH FRAME Dialog-Frame.
     1904     VIEW FRAME Dialog-Frame.
     1905   END PROCEDURE.
     1906   PROCEDURE fill-tables :
     1907   for each tt-c-wth-doc:
     1908       delete tt-c-wth-doc.
     1909   end.
     1910     if par-mode = 'ПРОСМОТР':U then do:
     1911       FIND FIRST bf_c-wth-doc NO-LOCK WHERE
     1912                   recid(bf_c-wth-doc) = p-doc-rec.
     1913     end.
     1914     IF NOT AVAIL bf_c-wth-doc then
     1915     return error.
     1916     if bf_c-wth-doc.status_ = 'факт':U and par-mode <> 'ПРОСМОТР':U then do:
     1917        message "Документ движения МЦ с N" bf_c-wth-doc.doc-code  "имеет статус" bf_c-wth-doc.status_ SKIP
     1918                         "Изменения не допускаются"
     1919           view-as alert-box error.
     1920           return error.
     1921       end.
     1922     create tt-c-wth-doc.
     1923     buffer-copy bf_c-wth-doc to tt-c-wth-doc.
     1924       FIND FIRST buf_obj No-LOCK WHERe
     1925                   buf_obj.obj-type = tt-c-wth-doc.obj-type AND
     1926                   buf_obj.obj-code = tt-c-wth-doc.obj-code No-ERROR.
     1927       if not avail buf_obj then do:
     1928         message "Документ движения МЦ N" bf_c-wth-doc.doc-code  skip
     1929                 "Неверный объект" bf_c-wth-doc.obj-type bf_c-wth-doc.obj-code
     1930         view-as alert-box ERROR.
     1931         return error.
     1932       end.
     1933       FIND FIRST buf_clients No-LOCK WHERe
     1934                   buf_clients.obj-type = tt-c-wth-doc.cli-type AND
     1935                   buf_clients.obj-code = tt-c-wth-doc.cli-code No-ERROR.
     1936       if not avail buf_clients then do:
     1937         message "Документ движения МЦ N" bf_c-wth-doc.doc-code  skip
     1938                 "Неверный контрагент" bf_c-wth-doc.cli-type bf_c-wth-doc.cli-code
     1939         view-as alert-box ERROR.
     1940         return error.
     1941       end.
     1942       FIND FIRST buf_operator No-LOCK WHERe
     1943                           buf_operator.obj-type = 'чел':U AND
     1944                           buf_operator.obj-code = tt-c-wth-doc.operator No-ERROR.
     1945       FIND FIRST buf_deliver No-LOCK WHERe
     1946                           buf_deliver.obj-type = 'чел':U AND
     1947                           buf_deliver.obj-code = tt-c-wth-doc.deliver No-ERROR.
     1948       FIND FIRST buf_receiver No-LOCK WHERe
     1949                           buf_receiver.obj-type = 'чел':U AND
     1950                           buf_receiver.obj-code = tt-c-wth-doc.receiver No-ERROR.
     1951       FIND FIRST buf_c-wth-line No-LOCK where
     1952                  BUF_c-wth-line.DOC-CODE = TT-c-wth-doc.doc-code
     1953             AND buf_c-wth-line.corr-user-db-num = tt-c-wth-doc.corr-user-db-num
     1954             AND buf_c-wth-line.chip-num = tt-c-wth-doc.chip-num
     1955                  nO-ERROR.
     1956       if avail buf_c-wth-line then do:
     1957         find first current-place No-LOCK WHERE
     1958                       current-place.w-p-code = buf_c-wth-line.w-p-code NO-ERROR.
     1959         if avail current-place then
     1960         assign
     1961         for-current-w-p-code = current-place.w-p-code
     1962         for-current-w-p-name = current-place.w-p-name
     1963         .
     1964         find first out-place No-LOCK WHERE
     1965                       out-place.w-p-code = buf_c-wth-line.out-code NO-ERROR.
     1966         if avail out-place then
     1967         assign
     1968         for-out-w-p-code = out-place.w-p-code
     1969         for-out-w-p-name = out-place.w-p-name
     1970         .
     1971       end.
     1972       CASE tt-c-wth-doc.source-type:
     1973         when 'док.МЦ':U then do:
     1974           FIND FIRST bind_c-wth-doc NO-LOCK WHERE
     1975                      bind_c-wth-doc.doc-code = tt-c-wth-doc.source-ref NO-ERROR.
     1976         end.
     1977         when 'касса':U then do:
     1978           FIND FIRST bind_inkas NO-LOCK WHERE
     1979                      bind_inkas.inkas-code = tt-c-wth-doc.source-ref NO-ERROR.
     1980         end.
     1981       END CASE.
     1982   END PROCEDURE.
     1983   PROCEDURE lock-proc :
     1984   DEFINE INPUT PARAMETER lock-doc as logical no-undo.
     1985   if lock-doc then do:
     1986       DISABLE
     1987       tt-c-wth-doc.cli-type
     1988       tt-c-wth-doc.cli-code
     1989       for-current-w-p-code
     1990       for-out-w-p-code
     1991       with frame Dialog-Frame
     1992       .
     1993   end.
     1994   END PROCEDURE.
     1995   PROCEDURE MyEnable :
     1996   assign
     1997   buf_c-wth-line.sum-gds-rubl:label in browse br-lines = "Сумма по связ. тов. (рубл.)".
     1998    buf_c-wth-line.creid:READ-ONLY IN BROWSE BR-lines = YES.
     1999    IF AVAILABLE buf_clients and par-mode = 'ДОБАВЛЕНИЕ':U THEN dO:
     2000       DISPLAY buf_clients.obj-name @ tt-c-wth-doc.cli-name
     2001         WITH FRAME Dialog-Frame.
     2002     end.
     2003     else
     2004     display
     2005     tt-c-wth-doc.cli-name
     2006     with frame Dialog-Frame.
     2007     IF AVAILABLE buf_deliver THEN
     2008       DISPLAY buf_deliver.obj-name @ for-deliver
     2009         WITH FRAME Dialog-Frame.
     2010     IF AVAILABLE buf_obj THEN
     2011       DISPLAY buf_obj.obj-name @ for-object
     2012         WITH FRAME Dialog-Frame.
     2013     IF AVAILABLE buf_operator THEN
     2014       DISPLAY buf_operator.obj-name @ for-operator
     2015         WITH FRAME Dialog-Frame.
     2016     IF AVAILABLE buf_receiver THEN
     2017       DISPLAY buf_receiver.obj-name @ for-receiver
     2018         WITH FRAME Dialog-Frame.
     2019     IF AVAILABLE current-place THEN
     2020       DISPLAY
     2021       current-place.w-p-code @ for-current-w-p-code
     2022       current-place.w-p-name @ for-current-w-p-name
     2023     WITH FRAME Dialog-Frame .
     2024     IF AVAILABLE out-place THEN
     2025       DISPLAY
     2026       out-place.w-p-code @ for-out-w-p-code
     2027       out-place.w-p-name @ for-out-w-p-name
     2028     WITH FRAME Dialog-Frame .
     2029     IF AVAILABLE tt-c-wth-doc THEN
     2030       DISPLAY
     2031       tt-c-wth-doc.fact-date
     2032       tt-c-wth-doc.doc-code
     2033       tt-c-wth-doc.doc-date
     2034       tt-c-wth-doc.shift-name
     2035       tt-c-wth-doc.shift-num
     2036       tt-c-wth-doc.shift-date
     2037       tt-c-wth-doc.obj-code
     2038       tt-c-wth-doc.obj-type
     2039       tt-c-wth-doc.cli-code
     2040       tt-c-wth-doc.cli-type
     2041       tt-c-wth-doc.fact-sum
     2042       tt-c-wth-doc.doc-sum
     2043       tt-c-wth-doc.operator
     2044       tt-c-wth-doc.deliver
     2045       tt-c-wth-doc.receiver
     2046       tt-c-wth-doc.sum-gds-base
     2047       tt-c-wth-doc.sum-gds-rubl
     2048       usrfulnf(tt-c-wth-doc.corr-user-name) @ tt-c-wth-doc.corr-user-name
     2049       tt-c-wth-doc.corr-date
     2050       WITH FRAME Dialog-Frame.
     2051       IF par-mode = 'ПРОСМОТР':U  THEN DO:
     2052         assign
     2053         b-quit:label = "&Выход"
     2054         b-quit:col = 1
     2055         .
     2056         ENABLE
     2057         B-Prev
     2058         B-Next
     2059         b-quit
     2060         WITH FRAME Dialog-Frame.
     2061         assign
     2062         locked-out = yes
     2063         locked-current = yes
     2064         .
     2065       END.
     2066       if not tt-c-wth-doc.inter_ then do:
     2067         HIDE
     2068         for-out-w-p-code
     2069         for-out-w-p-name
     2070         in frame Dialog-Frame.
     2071       end.
     2072       ENABLE
     2073       b-help
     2074       br-lines
     2075       b-lookup
     2076       WITH FRAME Dialog-Frame.
     2077       Hide b-chk
     2078       in frame Dialog-Frame.
     2079       OPEN QUERY BR-lines FOR EACH buf_c-wth-line WHERE         buf_c-wth-line.doc-code = tt-c-wth-doc.doc-code     AND buf_c-wth-line.corr-user-db-num = tt-c-wth-doc.corr-user-db-num     AND buf_c-wth-line.chip-num = tt-c-wth-doc.chip-num NO-LOCK,            first buf_wth WHERE buf_wth.wth-code = buf_c-wth-line.wth-code NO-LOCK.
     2080       IF ERROR-STATUS:ERROR THEN DO:
     2081           REPOSITION br-lines TO ROW 1 NO-ERROR.
     2082       END.
     2083       APPLY "ENTRY":U TO br-lines IN FRAME Dialog-Frame.
     2084       APPLY "VALUE-CHANGED":U TO br-lines IN FRAME Dialog-Frame.
     2085       IF par-mode <> 'ПРОСМОТР':U THEN DO:
     2086         APPLY "VALUE-CHANGED":U TO tt-c-wth-doc.cli-type IN FRAME Dialog-Frame.
     2087       END.
     2088      run control-line in this-procedure ( output lock-doc).
     2089      run lock-proc in this-procedure ( input  lock-doc).
     2090      ASSIGN
     2091      FRAME Dialog-Frame :TITLE = substitute("Удаленный документ № &1 движения материальных ценностей (&2  - &3)"
     2092                                               ,tt-c-wth-doc.doc-code
     2093                                               ,ENTRY(LOOKUP(tt-c-wth-doc.ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u)
     2094                                               ,CAPS( par-mode )).
     2095     .
     2096     VIEW FRAME Dialog-Frame.
     2097   END PROCEDURE.
     2098   PROCEDURE proc-b-add :
     2099   END PROCEDURE.
     2100   PROCEDURE proc-b-del :
     2101   END PROCEDURE.
     2102   PROCEDURE proc-save-doc :
     2103   END PROCEDURE.
     2104   PROCEDURE reposition-c-wth-doc :
     2105   define input parameter p-direction as character no-undo .
     2106   define variable v-new-c-wth-doc-recid as recid no-undo .
     2107   do
     2108   on error undo, return error
     2109   :
     2110     if valid-handle(p-call-prog)
     2111     then do:
     2112       run reposition-c-wth-doc in p-call-prog
     2113         (input  p-direction
     2114         ,output v-new-c-wth-doc-recid
     2115         ).
     2116       if v-new-c-wth-doc-recid <> ?
     2117       then do:
     2118         define buffer buf_c-wth-doc for ub.c-wth-doc .
     2119         find first buf_c-wth-doc no-lock
     2120           where recid(buf_c-wth-doc) = v-new-c-wth-doc-recid
     2121           no-error .
     2122         assign
     2123         p-doc-rec = v-new-c-wth-doc-recid
     2124         p-next-prev = '':U
     2125         .
     2126       end.
     2127     end.
     2128     else do:
     2129       message "Список документов МЦ не определен." view-as alert-box INFORMATION .
     2130       return no-apply.
     2131     end.
     2132     END.
     2133   END PROCEDURE.
