     5162         cb-chk-type
     5163         with frame Dialog-Frame .
     5164         return no-apply.
     5165       end.
     5166       if get-chkc_context.z-check = no then do:
     5167         message
     5168         substitute("Чек типа &1 можно получить только если включен параметр <принимать чеки z-отчета>&2" +
     5169                     "АРМ Администратор-Справочники-Магазины-Параметры-Опции закачки чеков&2" +
     5170                     "или&2" +
     5171                     "АРМ Администратор-Список фирм-Параметры-Опции закачки чеков"
     5172                   , entry (lookup (cb-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
     5173                   , chr(10)
     5174                   )
     5175         view-as alert-box error .
     5176         assign
     5177         cb-chk-type = '1':U.
     5178         display
     5179         cb-chk-type
     5180         with frame Dialog-Frame .
     5181         return no-apply.
     5182       end.
     5183     end.
     5184     if lookup(cb-chk-type, '14,15,16,17,36':U) > 0 then do:
     5185       if ptrl-check = no then do:
     5186         message
     5187         substitute("Чек типа &1 можно получить только если включен параметр <принимать специф.чеки АЗК>&2" +
     5188                     "АРМ Администратор-Справочники-Магазины-Параметры-Опции закачки чеков&2" +
     5189                     "или&2" +
     5190                     "АРМ Администратор-Список фирм-Параметры-Опции закачки чеков"
     5191                   , entry (lookup (cb-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U)
     5192                   , chr(10)
     5193                   )
     5194         view-as alert-box error .
     5195         assign
     5196         cb-chk-type = '1':U.
     5197         display
     5198         cb-chk-type
     5199         with frame Dialog-Frame .
     5200         return no-apply.
     5201       end.
     5202     end.
     5203     if cb-chk-type = '69':U
     5204     or cb-chk-type = '96':U then do:
     5205       if not get-chkc_context.is-catering then do:
     5206         message
     5207         substitute("Чек типа &1 можно получить только на объекте, на котором включена опция РЕСТОРАН&2"
     5208                   , entry (lookup (cb-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U))
     5209         view-as alert-box error .
     5210         assign
     5211         cb-chk-type = '1':U.
     5212         display
     5213         cb-chk-type
     5214         with frame Dialog-Frame .
     5215         return no-apply.
     5216       end.
     5217     end.
     5218     assign
     5219     tt-chk-doc.chk-type = integer(CB-chk-type).
     5220     if par-mode = 'ДОБАВЛЕНИЕ':U and available locked_chk-doc then
     5221     locked_chk-doc.chk-type = integer(CB-chk-type).
     5222     case CB-chk-type:
     5223       when '96':U
     5224       or when '69':U
     5225       then do:
     5226         menu-item m-write-off:sensitive in menu M-prt = no.
     5227         menu-item m-modificator:sensitive in menu M-prt = YES.
     5228         ASSIGN
     5229         b-adddiscnt:SENSITIVE IN FRAME Dialog-Frame = YES
     5230         b-addbonus:SENSITIVE IN FRAME Dialog-Frame = YES
     5231         b-addpay:SENSITIVE IN FRAME Dialog-Frame = YES
     5232         .
     5233       end.
     5234       WHEN  '14':U
     5235       OR
     5236       WHEN  '16':U
     5237       OR
     5238       WHEN  '15':U
     5239       OR
     5240       WHEN  '17':U
     5241       or
     5242       when '11':U
     5243       or
     5244       when '36':U
     5245       THEN DO:
     5246            assign
     5247            menu-item m-write-off:sensitive in menu M-prt = NO
     5248            menu-item m-modificator:sensitive in menu M-prt = NO
     5249            b-adddiscnt:SENSITIVE IN FRAME Dialog-Frame = NO
     5250            b-addbonus:SENSITIVE IN FRAME Dialog-Frame = NO
     5251            b-addpay:SENSITIVE IN FRAME Dialog-Frame = NO
     5252            .
     5253       end.
     5254       otherwise do:
