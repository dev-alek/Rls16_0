      109   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      110   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      111                                                                     input  orders as integer):
      112   define variable  round-m-sum as decimal no-undo.
      113   if orders >= 0 then
      114   round-m-sum = round(mysum,orders).
      115   else
      116   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      117   return round-m-sum.
      118   END FUNCTION.
