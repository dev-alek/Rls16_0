     3666   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3667   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
     3668                                                       ,input p-range-type as character
     3669                                                       ,input p-code as integer):
     3670   define variable v-seq-val as integer no-undo .
     3671   define buffer buf_code-range for ub.code-range.
     3672   find first buf_code-range no-lock where
     3673             buf_code-range.db-num = p-db-num
     3674       and  buf_code-range.range-type = p-range-type
     3675       and  buf_code-range.stts = 'u'
     3676       and buf_code-range.first-code <= p-code
     3677       and buf_code-range.last-code >= p-code no-error .
     3678   if available buf_code-range then return yes.
     3679   CASE p-range-type:
     3680     when 'pngb':U then do:
     3681       v-seq-val = current-value(s-pngb-code, ub).
     3682     end.
     3683     when 'fmgb':U then do:
     3684       v-seq-val = current-value(s-fmgb-code, ub).
     3685     end.
     3686   END CASE.
     3687   if p-code <= v-seq-val then do:
     3688     find first buf_code-range no-lock where
     3689               buf_code-range.db-num = p-db-num
     3690         and  buf_code-range.range-type = p-range-type
     3691         and  buf_code-range.stts = 'a'
     3692         and buf_code-range.first-code <= p-code
     3693         no-error .
     3694    if available buf_code-range then return yes.
     3695   end.
     3696   find first buf_code-range no-lock where
     3697             buf_code-range.db-num = p-db-num
     3698       and  buf_code-range.range-type = p-range-type
     3699       and  buf_code-range.stts = 'f'
     3700       and buf_code-range.first-code <= p-code
     3701       and buf_code-range.last-code >= p-code
     3702       no-error .
     3703   if available buf_code-range then return yes.
     3704   return no.
     3705   END FUNCTION.
     3706   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     3707                                                       ,input p-range-type as character
     3708                                                       ,input p-code as integer):
     3709   define variable v-seq-val as integer no-undo .
     3710   define buffer buf_code-range for ub.code-range.
     3711   CASE p-range-type:
     3712     when 'pngb':U then do:
     3713       v-seq-val = current-value(s-pngb-code, ub).
     3714     end.
     3715     when 'fmgb':U then do:
     3716       v-seq-val = current-value(s-fmgb-code, ub).
     3717     end.
     3718   END CASE.
     3719   if p-code <= v-seq-val then do:
     3720     find first buf_code-range no-lock where
     3721               buf_code-range.db-num = p-db-num
     3722         and  buf_code-range.range-type = p-range-type
     3723         and buf_code-range.first-code <= p-code
     3724         and buf_code-range.last-code >= p-code no-error .
     3725     if available buf_code-range then return yes.
     3726   end.
     3727   return no.
     3728   END FUNCTION.
     3729   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     3730                                                       ,input p-db-num as integer
     3731                                                       ,input p-staff-code as integer
     3732                                                       ,input p-date as date
     3733                                                        ):
     3734   define buffer buf_staff for ub.staff.
     3735   if p-date = ? then do:
     3736     p-date = today .
     3737   end.
     3738   find first buf_staff no-lock where
     3739             buf_staff.role = p-role
     3740         and buf_staff.role-level = 'db':U
     3741         and buf_staff.db-num = p-db-num
     3742         and buf_staff.staff-code = p-staff-code
     3743         and buf_staff.date-end >= p-date use-index pi  no-error .
     3744   if available buf_staff then do:
     3745     return buf_staff.psn-code.
     3746   end.
     3747   return 0.
     3748   end FUNCTION.
     3749   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     3750                                                             ,input p-db-num as integer
     3751                                                             ,input p-date as date
     3752                                                                 ):
     3753   define buffer buf_staff for ub.staff.
     3754   define buffer buf2_staff for ub.staff.
     3755   if p-date = ? then do:
     3756     p-date = today .
     3757   end.
     3758   for each  buf_staff no-lock where
     3759             buf_staff.role = p-role
     3760         and buf_staff.db-num = p-db-num,
     3761   first buf2_staff no-lock where
     3762         buf2_staff.role = p-role
     3763     and buf2_staff.role-level = 'db':U
     3764     and buf2_staff.staff-code = buf_staff.staff-code
     3765     and buf2_staff.date-start <= p-date
     3766     and buf2_staff.date-end >= p-date
     3767   by buf_staff.staff-code
     3768   by date-start descending:
     3769     return buf_staff.staff-code.
     3770   end.
     3771   end FUNCTION.
     3772   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     3773                                                  ,input p-db-num as integer
     3774                                                  ,input p-psn-code as integer
     3775                                                  ,input p-date as date
     3776                                                  ,output p-c-password as character
     3777                                                        ):
     3778   define buffer buf_staff for ub.staff.
     3779   if p-date = ? then do:
     3780     p-date = today .
     3781   end.
     3782   find first buf_staff no-lock where
     3783             buf_staff.role = p-role
     3784         and buf_staff.role-level = 'db':U
     3785         and buf_staff.db-num = p-db-num
     3786        and buf_staff.date-end >= p-date
     3787        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     3788   if available buf_staff
     3789   then do:
     3790     assign
     3791     p-c-password = buf_staff.password.
     3792     return buf_staff.staff-code.
     3793   end.
     3794   p-c-password = ''.
     3795   return 0.
     3796   end FUNCTION.
     3797   FUNCTION gbclcode-is-psn-role returns integer (
     3798                                                 input p-role as character
     3799                                                 ,input p-psn-code as integer
     3800                                                 ,input p-date as date
     3801                                                     ):
     3802   define buffer buf_staff for ub.staff.
     3803   if p-date = ? then do:
     3804     p-date = today .
     3805   end.
     3806   for each buf_staff no-lock where
     3807             buf_staff.psn-code = p-psn-code
     3808        and  buf_staff.role = p-role
     3809   by buf_staff.role-level
     3810   by buf_staff.date-start
     3811        :
     3812     if  buf_staff.date-start <= p-date and
     3813     buf_staff.date-end >= p-date  then do:
     3814       return buf_staff.staff-code.
     3815     end.
     3816   end.
     3817   return 0.
     3818   end FUNCTION.
     3819   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     3820   define variable v-role-name as character no-undo .
     3821   assign
     3822   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     3823   no-error .
     3824   return v-role-name.
     3825   END.
     3826   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3827   FUNCTION gbclcode-get-position returns character ( input p-role as character
     3828                                                     ,input p-role-level as character
     3829                                                     ,input p-work-place as character
     3830                                                     ,input p-staff-code as integer
     3831                                                                ):
     3832   define variable v-role-name as character no-undo .
     3833   define variable v-role-level as character no-undo .
     3834   define variable v-staff-code as integer no-undo .
     3835   assign
     3836   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     3837   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     3838   v-staff-code = p-staff-code
     3839   no-error .
     3840   return substitute("&1, &2, Код &3"
     3841                   ,v-role-name
     3842                   ,v-role-level
     3843                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     3844   END.
     3845   FUNCTION gbclcode-get-work-place returns character (
     3846                                                   input p-role as character
     3847                                                  ,input p-role-level as character
     3848                                                  ,input p-db-num as integer
     3849                                                  ,input p-host-code as integer
     3850                                                  ,input p-obj-type as character
     3851                                                  ,input p-obj-code as integer
     3852                                                  ) :
     3853   define variable v-work-place as character no-undo .
     3854   define variable v-obj-type as character no-undo .
     3855     case p-role-level:
     3856       when 'db':U then do:
     3857         v-work-place = string(p-db-num, "99999").
     3858       end.
     3859       when 'firm':U then do:
     3860         v-work-place = string(p-host-code, "99999").
     3861       end.
     3862       when 'object':U then do:
     3863         assign
     3864         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     3865         .
     3866       end.
     3867     END CASE.
     3868     return v-work-place.
     3869   END FUNCTION.
     3870   FUNCTION gbclcode-get-level-last-code returns integer (
     3871                                                           input p-role as character
     3872                                                         , input p-role-level as character
     3873                                                         , input p-work-place as character
     3874                                                         , input p-date-start as date
     3875                                                         ):
     3876   DEFINE VARIABLE v-today as date no-undo .
     3877   define buffer buf_staff for ub.staff.
     3878   if p-work-place = chr(63) then return ?.
     3879   if p-date-start = ? then do:
     3880     v-today = today .
     3881   end.
     3882   else do:
     3883     v-today = p-date-start.
     3884   end.
     3885   find last buf_staff no-lock where
     3886             buf_staff.role = p-role
     3887        and  buf_staff.role-level = p-role-level
     3888        and  buf_staff.work-place = p-work-place
     3889        and  buf_staff.date-start <= v-today + 1
     3890        and  buf_staff.date-end >= v-today + 1
     3891        use-index pi  no-error .
     3892   if available buf_staff
     3893   then return buf_staff.staff-code.
     3894   return 0.
     3895   end FUNCTION.
     3896   define variable p-pos-type as character no-undo .
     3897   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3898   define variable paycardv as character no-undo .
     3899   FUNCTION f-paycardv RETURNS CHARACTER(input p-pay-card as character, p-cash-pay-obj-code as integer, p-cash-pay-curr-code as integer):
     3900   define variable kk as integer no-undo .
     3901   define variable pay-card-num as character no-undo .
     3902   define buffer buf_cash-pay for ub.cash-pay.
     3903   find first buf_cash-pay no-lock where
     3904              buf_cash-pay.cdpay-code = p-cash-pay-obj-code
     3905          AND buf_cash-pay.curr-code = p-cash-pay-curr-code no-error .
     3906   if not avail buf_cash-pay then return "":U.
     3907   if p-pay-card = "":u
     3908   or p-pay-card = ? then return "":U.
     3909   assign
     3910   pay-card-num = "":U
     3911   .
     3912   _kk:
     3913   do kk = 1 to num-entries(buf_cash-pay.pay-card-view):
     3914     if p-pay-card begins entry(kk, buf_cash-pay.pay-card-view) then do:
     3915       assign
     3916       pay-card-num = p-pay-card
     3917       .
     3918       return pay-card-num.
     3919     end.
     3920   end.
     3921   if pay-card-num = "":u then do:
     3922     if length(p-pay-card) > 4 then
     3923     assign
     3924     pay-card-num = fill("*":U, length(p-pay-card) - 4) +
     3925                     substr(p-pay-card, (length(p-pay-card) - 3), 4)
     3926     .
     3927     else
     3928     return fill("*":U, length(p-pay-card)).
     3929   end.
     3930   return pay-card-num.
     3931   END FUNCTION.
