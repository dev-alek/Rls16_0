     5525     if not avail tt-chk-gds then return no-apply.
     5526     define buffer buf_staff  for ub.staff.
     5527     run ref/staffs.w (
     5528                    input parparentproc
     5529                   ,input "b-sel"
     5530                   ,input 'S':U
     5531                   ,input get-chkc_context.db-num
     5532                   ,input 0
     5533                   ,output sale-list ) .
