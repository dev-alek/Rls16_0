     7478     assign
     7479     v-old-shift-name = tt-chk-doc.shift-name
     7480     tt-chk-doc.shift-name
     7481     .
     7482     assign
     7483     v-dopi = integer(tt-chk-doc.shift-name) no-error .
     7484     if error-status:error
     7485     or v-dopi < 0
     7486     or v-dopi > 99 then do:
     7487       message
     7488       "Неверное значение № смены"
     7489       view-as alert-box error .
     7490       tt-chk-doc.shift-name = v-old-shift-name .
     7491       display
     7492       tt-chk-doc.shift-name
     7493       with frame Dialog-Frame .
     7494       return no-apply.
     7495     end.
     7496     display
     7497     v-dopi @ tt-chk-doc.shift-num
     7498     with frame Dialog-Frame .
     7499   end.
     7500   ON RETURN OF tt-chk-gds.src-qnty IN BROWSE br-gds,
     7501               tt-chk-gds.src-price IN BROWSE br-gds,
     7502               tt-chk-gds.src-discnt IN BROWSE br-gds,
     7503               tt-chk-gds.src-code IN BROWSE br-gds,
     7504               tt-chk-gds.pump IN BROWSE br-gds,
     7505               tt-chk-gds.nozzle-code IN BROWSE br-gds,
     7506               tt-chk-gds.pl-code IN BROWSE br-gds,
     7507               tt-chk-gds.loc1 IN BROWSE br-gds,
     7508               tt-chk-gds.road-tax IN BROWSE br-gds,
     7509               tt-chk-discnt.real-value-abs IN BROWSE br-discnt,
     7510               tt-chk-discnt.real-value-pcnt IN BROWSE br-discnt,
     7511               tt-chk-pay.tot-sum IN BROWSE br-pay,
     7512               tt-chk-pay.curr-code IN BROWSE br-pay,
     7513               tt-chk-pay.pay-code IN BROWSE br-pay DO:
