     3992   FUNCTION get-tax-type RETURNS CHARACTER
     3993     ( input p-tax-code as integer) :
     3994   case p-tax-code :
     3995     when 1 then return "18%" .
     3996     when 2 then return "10%" .
     3997     when 3 then return "0%" .
     3998     when 4 then return "Б/Н" .
     3999     when 5 then return "18/118" .
     4000     when 6 then return "10/110" .
     4001     otherwise return "Неизвестн." .
     4002   end case .
     4003   END FUNCTION.
     4004   FUNCTION get-OVDtax-type RETURNS CHARACTER
     4005     ( input p-tax-code as integer) :
     4006   case p-tax-code :
     4007     when 1102 then return "18%" .
     4008     when 1103 then return "10%" .
     4009     when 1104 then return "0%" .
     4010     when 1105 then return "Б/Н" .
     4011     when 1106 then return "18/118" .
     4012     when 1107 then return "10/110" .
     4013     otherwise return "Неизвестн." .
     4014   end case .
     4015   END FUNCTION.
