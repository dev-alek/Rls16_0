     4807   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     4808   or Right-Mouse-CLICK OF b-print IN FRAME Dialog-Frame
     4809   DO:
     4810   define variable v-normal-call as logical no-undo .
     4811   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4812   if lookup(self :type
     4813            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4814            ) = 0
     4815   then do:
     4816     message
     4817       "$Workfile$"
     4818       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4819       "Интерфейсный элемент" self :name  skip
     4820       "Тип" self :type  skip
     4821       "Процедура" this-procedure :file-name skip
     4822       view-as alert-box .
     4823   end.
     4824   else do:
     4825     apply "entry":u to self  .
     4826     if focus :handle <> self :handle  then do:
     4827       return no-apply .
     4828     end.
     4829   end.
     4830     if last-event:lABEL = "CHOOSE"
     4831     or last-event:lABEL = "ENTER" then do:
     4832       v-normal-call = yes.
     4833     end.
     4834     if v-normal-call then do:
     4835       run str/checkp.p ( input parparentproc, input tt-chk-doc.doc-code).
     4836     end.
     4837     else do:
     4838       run print-xml in this-procedure ( input (dataset superchk:handle)
     4839                                           ,input tt-chk-doc.doc-code) no-error.
     4840       if error-status:error then do:
     4841         message
     4842         "Ошибка при выводе в XML"
     4843         error-status:get-message(1)
     4844         return-value
     4845         view-as alert-box .
     4846       end.
     4847       else do:
     4848         message
     4849         "Чек напечатан в XML"
     4850         view-as alert-box .
     4851       end.
     4852     end.
     4853   END.
