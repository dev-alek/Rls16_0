     5496    FIND FIRST b_bar-code No-LOCK WHERE
     5497                      b_bar-code.b-code = tt-chk-gds.b-code No-ERROR.
     5498     if not avail b_bar-code then return no-apply.
     5499    FIND FIRST b_Goods No-LOCK WHERE
     5500                       b_goods.gds-code = b_bar-code.gds-code No-ERROR.
     5501     if not avail b_goods then return no-apply.
     5502     run setprts in this-procedure ( input recid(b_goods), input recid(b_bar-code), input b_goods.prt-root, input yes) no-error.
     5503     if error-status:error then return no-apply.
