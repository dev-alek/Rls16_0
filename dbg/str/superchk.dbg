     5310     if par-l-mask and tt-chk-doc.src-d-card <> "" then v-src-d-card = substring(tt-chk-doc.src-d-card,1,6) + "XXXXXX" + substring (tt-chk-doc.src-d-card,13,4).
     5311     else v-src-d-card = tt-chk-doc.src-d-card .
     5312         display
     5313         v-src-d-card
     5314         with frame Dialog-Frame .
     5315   END.
