     5543     tt-chk-doc.sales-man = 0
     5544     .
     5545     run get-staff in this-procedure ( input tt-chk-doc.sales-man, input 'S':U, input tt-chk-doc.chk-date) no-error.
     5546     DISPLAY
     5547     tt-chk-gds.sales-man
     5548     tt-gds-info.salesman-name
     5549     with browse br-gds.
     5550     apply "entry" to br-gds in frame Dialog-Frame.
     5551   END.
     5552   ON CHOOSE OF MENU-ITEM m-write-off
     5553   DO:
     5554    DEFINE VARIABLE choice AS INTEGER NO-UNDO.
     5555    DEFINE BUFFER buf_tt-chk-gds FOR tt-chk-gds.
     5556       if not avail tt-chk-gds then return.
     5557     run gbl/d-askw.w (input "Выбор кода списания",
     5558                         input "Установить признак СПИСАНИЕ на текущую товарную позицию",
     5559                         input "|",
     5560                         input "Нет|Да|Отказ",
     5561                         input "Не  установлен|Установлен|Отказ от установки кода списания",
     5562                         input 1,
     5563                         input 3,
     5564                         output choice).
     5565    IF choice = 3  THEN RETURN NO-APPLY.
     5566    FIND FIRST buf_tt-chk-gds EXCLUSIVE-LOCK WHERE
     5567           RECID(buf_tt-chk-gds) = recid(tt-chk-gds).
     5568    CASE choice:
     5569        WHEN 1 THEN DO:
     5570          ASSIGN
     5571          buf_tt-chk-gds.write-off-code = 0.
     5572        END.
     5573        WHEN 2 THEN DO:
     5574           CASE tt-chk-doc.chk-type:
     5575               WHEN INTEGER('1':U)
     5576                or when integer('69':U)
     5577               THEN DO:
     5578                   ASSIGN
     5579                   buf_tt-chk-gds.write-off-code = INTEGER('1':U).
     5580               END.
     5581               WHEN INTEGER('6':U) THEN DO:
     5582                   ASSIGN
     5583                   buf_tt-chk-gds.write-off-code = INTEGER('-6':U).
     5584               END.
     5585               WHEN INTEGER('96':U) THEN DO:
     5586                   ASSIGN
     5587                   buf_tt-chk-gds.write-off-code = INTEGER('-9':U).
     5588               END.
     5589           END CASE.
     5590        END.
     5591    END CASE.
     5592    run get-sums in this-procedure no-error .
     5593   display
     5594   tt-chk-doc.tot-doc
     5595   tt-chk-doc.discnt
     5596   tt-chk-doc.netto
     5597   tt-chk-doc.src-tot-doc
     5598   with frame Dialog-Frame.
     5599    br-gds:REFRESH()  IN FRAME Dialog-Frame.
     5600    apply "entry" to br-gds in frame Dialog-Frame.
     5601   END.
