     4882   ON CHOOSE OF br-attr IN FRAME Dialog-Frame
     4883   DO:
     4884     if available locked_chk-doc then
     4885     run str\superchk-attr.w( input parparentproc,
     4886                               input locked_chk-doc.doc-code).
     4887   END.
     4888   ON DELETE-CHARACTER OF BR-discnt IN FRAME Dialog-Frame
     4889   DO:
     4890   DEFINE VARIABLE v-line-num like ub.chk-discnt.line-num no-undo .
     4891   DEFINE VARIABLE v-value-type like ub.chk-discnt.value-type no-undo .
     4892   DEFINE VARIABLE v-line-type  like ub.chk-discnt.line-type no-undo .
     4893   define variable v-record-type as integer no-undo .
     4894   define variable v-discnt-type like ub.chk-discnt.discnt-type no-undo .
     4895   define buffer loc-tt-chk-discnt for tt-chk-discnt.
     4896    if par-mode <> 'ДОБАВЛЕНИЕ':U then return no-apply.
     4897    glog = yes.
     4898    if dflt-cd <> 'NCR-GM':U
     4899    and dflt-cd <> 'NCR-AS@R':U
     4900    and tt-chk-discnt.record-type = 0
     4901    then do:
     4902     if tt-chk-discnt.object-line-num <> 0 then do:
     4903       message
     4904       "Нельзя удалить скидку/бонус"
     4905       view-as alert-box .
     4906       return no-apply.
     4907     end.
     4908    end.
     4909     message
     4910     "Удалить скидку/бонус из чека ?"
     4911      view-as alert-box question buttons OK-Cancel update glog.
     4912     if glog <> true then return.
     4913     assign
     4914     v-line-num = tt-chk-discnt.line-num
     4915     v-value-type = tt-chk-discnt.value-type
     4916     v-line-type  = tt-chk-discnt.line-type
     4917     v-record-type = tt-chk-discnt.record-type
     4918     v-discnt-type = tt-chk-discnt.discnt-type
     4919     .
     4920     find first locked_chk-discnt where
     4921              locked_chk-discnt.doc-code = tt-chk-doc.doc-code
     4922         AND locked_chk-discnt.line-num = tt-chk-discnt.line-num
     4923         AND locked_chk-discnt.object-line-num = tt-chk-discnt.object-line-num
     4924         AND locked_chk-discnt.discnt-id = tt-chk-discnt.discnt-id.
     4925     delete locked_chk-discnt.
     4926     delete tt-chk-discnt.
     4927     CASE par-mode:   WHEN 'ДОБАВЛЕНИЕ':U OR WHEN 'ИЗМЕНЕНИЕ':U THEN DO:     OPEN QUERY BR-discnt FOR EACH tt-chk-discnt WHERE            tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type         by tt-chk-discnt.line-num.   END.    WHEN  'ПРОСМОТР':U or when "susp-type" THEN DO:        OPEN QUERY BR-discnt FOR EACH tt-chk-discnt NO-LOCK              WHERE tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type            by tt-chk-discnt.line-num.     END. END CASE.
     4928     if v-record-type < 4 then do:
     4929     run get-discnt in this-procedure (
     4930                                             input v-line-num
     4931                                             ,input v-value-type
     4932                                             ,input v-line-type
     4933                                             ,input v-discnt-type
     4934                                             ).
     4935     v-is-sub-d = no.
     4936     for each loc-tt-chk-discnt:
     4937       if loc-tt-chk-discnt.line-type = integer('2':U) then do:
     4938         assign
     4939         v-is-sub-d = yes
     4940         .
     4941       end.
     4942     end.
     4943     run GET-SUMS IN THIS-PROCEDURE NO-ERROR.
     4944     display
     4945     tt-chk-doc.tot-doc
     4946     tt-chk-doc.discnt
     4947     tt-chk-doc.netto
     4948     tt-chk-doc.src-tot-doc
     4949     with frame Dialog-Frame.
     4950     end.
     4951   END.
     4952   ON DELETE-CHARACTER OF BR-gds IN FRAME Dialog-Frame
     4953   DO:
     4954   if par-mode <> 'ДОБАВЛЕНИЕ':U then return no-apply.
     4955    glog = yes.
     4956     message
     4957     "Удалить товар из чека ?"
     4958      view-as alert-box question buttons OK-Cancel update glog.
     4959     if glog <> true then return.
     4960    find first locked_chk-gds where
     4961             locked_chk-gds.doc-code= tt-chk-gds.doc-code
     4962         AND locked_chk-gds.line-num = tt-chk-gds.line-num.
     4963     for each locked_chk-discnt where
     4964                   locked_chk-discnt.doc-code = tt-chk-doc.doc-code and
     4965                   locked_chk-discnt.line-num = tt-chk-gds.line-num,
     4966           each tt-chk-discnt where
     4967                   tt-chk-discnt.doc-code = tt-chk-doc.doc-code and
     4968                   tt-chk-discnt.line-num = tt-chk-gds.line-num:
     4969           if tt-chk-discnt.line-type = integer('2':U)  OR
     4970              TT-chk-discnt.line-type = INTEGER('3':U)
     4971           then
     4972           tt-chk-discnt.line-num = tt-chk-discnt.line-num - 1.
     4973           else
     4974           delete tt-chk-discnt.
     4975           delete locked_chk-discnt.
     4976       end.
     4977     delete locked_chk-gds.
     4978     delete tt-chk-gds.
     4979     delete tt-gds-info.
     4980     CASE par-mode:     WHEN 'ДОБАВЛЕНИЕ':U     OR     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:        IF dflt-cd = 'MAGIA-XML':U THEN OPEN QUERY BR-gds FOR EACH tt-chk-gds       WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,              FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by abs(tt-chk-gds.line-num).     ELSE     OPEN QUERY BR-gds FOR EACH tt-chk-gds           WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                  FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by tt-chk-gds.line-num.      END.     WHEN 'ПРОСМОТР':U or when "susp-type" THEN DO:            IF dflt-cd = 'MAGIA-XML':U THEN         OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK             WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                      FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num             by abs(tt-chk-gds.line-num).          ELSE             OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK                 WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                          FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num                 by tt-chk-gds.line-num.      END. END CASE.
     4981     run GET-SUMS IN THIS-PROCEDURE NO-ERROR.
     4982     display
     4983     tt-chk-doc.tot-doc
     4984     tt-chk-doc.discnt
     4985     tt-chk-doc.netto
     4986     tt-chk-doc.src-tot-doc
     4987     with frame Dialog-Frame.
     4988   END.
     4989   ON DELETE-CHARACTER OF BR-pay IN FRAME Dialog-Frame
     4990   DO:
     4991   if par-mode <> 'ДОБАВЛЕНИЕ':U then return no-apply.
     4992      glog = yes.
     4993     message
     4994     "Удалить оплату из чека ?"
     4995     view-as alert-box question buttons OK-Cancel update glog.
     4996     if glog <> true then return.
     4997     find first locked_chk-pay where
     4998             locked_chk-pay.doc-code = tt-chk-pay.doc-code
     4999         AND locked_chk-pay.line-num = tt-chk-pay.line-num.
     5000     delete locked_chk-pay.
     5001     delete tt-chk-pay.
     5002     delete tt-pay-info.
     5003    CASE par-mode:   WHEN 'ДОБАВЛЕНИЕ':U   OR   WHEN 'ИЗМЕНЕНИЕ':U  THEN DO:      OPEN QUERY BR-pay FOR EACH  tt-chk-pay          WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code ,            first tt-pay-info no-lock where tt-pay-info.line-num = tt-chk-pay.line-num          by tt-chk-pay.line-num.  END.   WHEN 'ПРОСМОТР':U or when "susp-type" THEN DO:      OPEN QUERY BR-pay FOR EACH  tt-chk-pay          WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code ,            first tt-pay-info no-lock where tt-pay-info.line-num = tt-chk-pay.line-num          by tt-chk-pay.line-num.  END. END CASE.
     5004   END.
     5005   ON ENTRY OF BR-pay IN FRAME Dialog-Frame
     5006   DO:
     5007     APPLY "VALUE-CHANGED" TO br-pay.
     5008   END.
     5009   ON VALUE-CHANGED OF BR-pay IN FRAME Dialog-Frame
     5010   DO:
     5011   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     5012   DEFINE VARIABLE v-type AS CHARACTER NO-UNDO.
     5013   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     5014   IF par-mode = 'ИЗМЕНЕНИЕ':U  THEN do:
     5015   IF AVAILABLE tt-chk-pay
     5016   AND tt-chk-pay.pay-card <> ''
     5017   AND tt-chk-pay.pay-card <> '0' THEN DO:
     5018     RUN cp-attr-value IN THIS-PROCEDURE (
     5019                                            input tt-chk-pay.pay-code
     5020                                           ,INPUT tt-chk-pay.curr-code
     5021                                           ,INPUT 0
     5022                                           ,INPUT ''
     5023                                            ,INPUT 0
     5024                                           ,INPUT 'paycard-edit-prefix':U
     5025                                            ,OUTPUT v-value
     5026                                            ,OUTPUT v-type) no-ERROR.
     5027       DO v-ii = 1 TO NUM-ENTRIES(v-value):
     5028          IF tt-chk-pay.pay-card BEGINS ENTRY(v-ii, v-value) THEN DO:
     5029              tt-chk-pay.pay-card:READ-ONLY IN BROWSE br-pay = NO.
     5030          END.
     5031       END.
     5032     END.
     5033     ELSE DO:
     5034      tt-chk-pay.pay-card:READ-ONLY IN BROWSE br-pay = YES.
     5035     END.
     5036   END.
     5037   END.
     5038   ON CHOOSE OF Btn_sht-from IN FRAME Dialog-Frame
     5039   DO:
     5040     define variable c_shift-list   as character no-undo.
     5041       run str/sht-all.w (parparentproc,
     5042           v-cntxt-obj-type,
     5043           v-cntxt-obj-code,
     5044           "b-sel",
     5045           "obj",
     5046           v-cntxt-obj-type,
     5047           v-cntxt-obj-code,
     5048           "",
     5049           input-output c_shift-list) no-error.
     5050       if error-status:error then
     5051       do:
     5052           message
     5053               vss-workfile vss-revision vss-description skip
     5054               "Ошибка при выборе смены"  skip
     5055               error-status :get-message( 1 ) skip
     5056               return-value skip
     5057               view-as alert-box error .
     5058           return no-apply.
     5059       end.
     5060       if c_shift-list =  "":U then
     5061       do:
     5062           return no-apply.
     5063       end.
     5064       find first buf_shift-obj where recid (buf_shift-obj) = integer (c_shift-list) no-lock.
     5065       tt-chk-doc.src-shift-date:screen-value = string(buf_shift-obj.shift-date) no-error.
     5066       tt-chk-doc.shift-name:screen-value = string(buf_shift-obj.shift-name) no-error.
     5067       tt-chk-doc.shift-num:screen-value = string(buf_shift-obj.shift-num) no-error.
     5068   END.
     5069   ON CHOOSE OF BUTTON-1 IN FRAME Dialog-Frame
     5070   DO:
     5071     def var p-corr-osnov as character no-undo.
     5072     def var rid# as character no-undo .
     5073     do with frame Dialog-Frame:
     5074       run ref/codelayout.p(parparentproc,'ВЫБОР':U,"","OsnovCorr", "Основание коррекции",output table tmprecid).
     5075       for first tmprecid where tmprecid.fTable = "code" no-lock:
     5076         find first ub.Code no-lock where recid (ub.Code) = integer(tmprecid.Frecid) no-error .
     5077         v-doc-osnov = ub.Code.CodeName.
     5078         v-corr-osnov1 = integer(ub.Code.code) .
     5079         display v-doc-osnov with frame Dialog-Frame .
     5080         apply "LEAVE":U to v-doc-osnov.
     5081       end.
     5082     end.
     5083   END.
     5084   ON CHOOSE OF BUTTON-susp IN FRAME Dialog-Frame
     5085   DO:
     5086     define variable v-code as character no-undo .
     5087     define buffer buf_reason for ub.code .
     5088     do with frame Dialog-Frame:
     5089       run ref/reasonSuspCheck.w(parparentproc,'ВЫБОР':U,output v-code).
     5090       find first buf_reason no-lock where buf_reason.parent = 'reasons-suspicious-check':U and
     5091       buf_reason.code = v-code no-error .
     5092       if available (buf_reason) then do:
     5093           if buf_reason.code = "0" then do:
     5094               charKey_one = buf_reason.code .
     5095               v-susp = "Иная: " .
     5096               v-susp-chk = "" .
     5097               display v-susp-chk .
     5098               enable v-susp-chk with frame Dialog-Frame .
     5099               v-susp-chk:read-only = false .
     5100           end.
     5101           else do:
     5102               v-susp = "".
     5103               charKey_one = buf_reason.code .
     5104               v-susp-chk = buf_reason.CodeName .
     5105               display v-susp-chk .
     5106               enable v-susp-chk with frame Dialog-Frame .
     5107               v-susp-chk:read-only = true .
     5108               find first ub.susp-chk exclusive-lock where ub.susp-chk.doc-code = tt-chk-doc.doc-code no-error .
     5109               if available (ub.susp-chk) then do:
     5110                   assign
     5111                   ub.susp-chk.reason-name = v-susp-chk
     5112                   .
     5113               end.
     5114           end.
     5115       end.
     5116     end.
     5117   END.
