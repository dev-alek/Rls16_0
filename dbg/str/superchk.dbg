     4633     DEFINE VARIABLE cli-list as character no-undo .
     4634       run ref/discards.w (
     4635                        input parparentproc
     4636                       ,input "b-sel":U
     4637                       ,input 'все':U
     4638                       ,input get-chkc_context.host-code
     4639                       ,input tt-chk-doc.obj-type
     4640                       ,input tt-chk-doc.obj-code
     4641                       ,input '':U
     4642                       ,input ?
     4643                       ,output cli-list ) no-error.
     4644       if not cli-list  = "" then do:
     4645         FIND FIRST buf_dis-card no-lock where
     4646                     recid(buf_dis-card) = integer(cli-list).
     4647         if buf_dis-card.status_ = 'неисп':U
     4648         or buf_dis-card.status_ = 'смкли':U
     4649         then do:
     4650           message
     4651           substitute("Нельзя создать чек с картой &1&2" +
     4652                     "Карта имеет статус &3, &4"
     4653                     , buf_dis-card.d-card
     4654                     , chr(10)
     4655                     , buf_dis-card.status_
     4656                     , (if buf_dis-card.status_ = 'неисп':U
     4657                       then "карта должна быть ОКОНЧАТЕЛЬНО удалена"
     4658                       else "карта будет доступна по окончании процесса смены владельца")
     4659                      )
     4660           view-as alert-box error .
     4661           return no-apply.
     4662         end.
     4663         DISPLAY
     4664         buf_dis-card.d-card @ tt-chk-doc.d-card
     4665         with frame Dialog-Frame.
     4666         find first buf_clients no-lock where
     4667                     buf_clients.obj-type = buf_dis-card.cli-type
     4668               AND  buf_clients.obj-code = buf_dis-card.cli-code.
     4669         display
     4670         buf_clients.obj-name @ f-cli-name
     4671         with frame Dialog-Frame.
     4672      end.
     4673   END.
     4674   ON CHOOSE OF b-cd IN FRAME Dialog-Frame
