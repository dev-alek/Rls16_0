     7225   run diasize_add_browse in this-procedure
     7226     (input  'width':u
     7227     ,input  browse BR-pay :handle
     7228     ) .
     7229   run diasize_init in this-procedure .
     7230   on F9 of frame Dialog-Frame anywhere do:
     7231   define buffer buf_bar-code  for ub.bar-code.
     7232   if not available tt-chk-gds then return no-apply.
     7233   find first buF_bar-code no-lock where
     7234              buf_bar-code.b-code = tt-chk-gds.b-code no-error .
     7235   if not available buf_bar-code then return no-apply.
     7236   run str/showgds.p ( input parparentproc
     7237                     ,input THIS-PROCEDURE:HANDLE
     7238                     ,input buf_bar-code.gds-code
     7239                     ,input 'ПРОСМОТР':U) no-error .
     7240   if error-status:error then return no-apply.
     7241   apply "entry" to br-gds in frame Dialog-Frame.
     7242   return no-apply.
     7243   end.
     7244   ON value-changed OF br-gds do:
     7245   end.
     7246   ON LEAVE OF tt-chk-gds.src-qnty IN BROWSE br-gds,
     7247               tt-chk-gds.src-price IN BROWSE br-gds,
     7248               tt-chk-gds.src-discnt IN BROWSE br-gds,
     7249               tt-chk-gds.src-code IN BROWSE br-gds,
     7250               tt-chk-gds.doc-qnty IN BROWSE br-gds,
     7251               tt-chk-gds.b-code IN BROWSE br-gds DO:
     7252   define variable old-b-code      like tt-chk-gds.b-code no-undo .
     7253   define variable old-src-code    like tt-chk-gds.src-code no-undo .
     7254   define variable old-src-qnty like tt-chk-gds.src-qnty no-undo .
     7255   define variable old-doc-qnty like tt-chk-gds.doc-qnty no-undo .
     7256   define variable old-src-price like tt-chk-gds.src-price no-undo .
     7257   define variable old-src-sum like tt-chk-gds.src-sum no-undo .
     7258   define variable old-src-discnt like tt-chk-gds.src-discnt no-undo .
     7259   define variable old-vat-summ like tt-chk-gds.VAT-sum-rubl no-undo .
     7260       if not avail tt-chk-gds then return no-apply.
     7261       if self:name = "b-code":U and par-mode = 'ИЗМЕНЕНИЕ':U and
     7262       tt-chk-gds.b-code <> integer(tt-chk-gds.b-code:screen-value in browse br-gds) then do:
     7263       RUN check-ch-bc-ck in this-procedure ( input gp-price-sale, input tt-chk-gds.price-base) no-error.
     7264       if error-status:error then do:
     7265         tt-chk-gds.b-code:screen-value in browse br-gds = string(tt-chk-gds.b-code).
     7266         return no-apply.
     7267       end.
     7268       end.
     7269       else do:
     7270         assign
     7271         old-b-code       = tt-chk-gds.b-code
     7272         old-src-code     = tt-chk-gds.src-code
     7273         old-src-qnty     = tt-chk-gds.src-qnty
     7274         old-doc-qnty     = tt-chk-gds.doc-qnty
     7275         old-src-price    = tt-chk-gds.src-price
     7276         old-src-sum      = tt-chk-gds.src-sum
     7277         old-src-discnt   = tt-chk-gds.src-discnt
     7278         old-vat-summ     = tt-chk-gds.VAT-sum-rubl
     7279         .
     7280         if old-src-discnt = 0
     7281         and decimal(tt-chk-gds.src-discnt:screen-value in browse br-gds    ) <> 0 then do:
     7282           define variable v-vchoice as integer no-undo .
     7283           define variable v-dchoice as integer no-undo .
     7284           run str/askmdisc.w ( input-output v-vchoice
     7285                               ,input-output v-dchoice) no-error.
     7286           if v-vchoice = 0 then do:
     7287             assign
     7288             tt-chk-gds.src-discnt = old-src-discnt.
     7289             display
     7290             tt-chk-gds.src-discnt
     7291             with browse br-gds.
     7292             return no-apply.
     7293           end.
     7294         end.
     7295         assign
     7296         tt-chk-gds.b-code = integer(tt-chk-gds.b-code:screen-value in browse br-gds)
     7297         tt-chk-gds.src-code = tt-chk-gds.src-code:screen-value in browse br-gds
     7298         tt-chk-gds.src-qnty = decimal(tt-chk-gds.src-qnty:screen-value in browse br-gds    )
     7299         tt-chk-gds.src-discnt = decimal(tt-chk-gds.src-discnt:screen-value in browse br-gds    )
     7300         tt-chk-gds.src-price = decimal(tt-chk-gds.src-price:screen-value in browse br-gds    )
     7301         tt-chk-gds.src-sum = tt-chk-gds.src-qnty * tt-chk-gds.src-price
     7302         tt-chk-gds.VAT-sum-rubl = ((tt-chk-gds.src-price * tt-chk-gds.VAT-pc)/(100 + tt-chk-gds.VAT-pc)) * tt-chk-gds.src-qnty
     7303         .
     7304         run get-b-code in this-procedure ( input v-vchoice
     7305                                           ,input v-dchoice
     7306                                         ) no-error.
     7307         if error-status:error then do:
     7308           assign
     7309           tt-chk-gds.b-code     =   old-b-code
     7310           tt-chk-gds.src-code   =   old-src-code
     7311           tt-chk-gds.src-qnty   =   old-src-qnty
     7312           tt-chk-gds.doc-qnty   =   old-doc-qnty
     7313           tt-chk-gds.src-price  =   old-src-price
     7314           tt-chk-gds.src-sum    =   old-src-sum
     7315           tt-chk-gds.src-discnt =   old-src-discnt
     7316           tt-chk-gds.VAT-sum-rubl = old-vat-summ
     7317           .
     7318           display
     7319           tt-chk-gds.b-code
     7320           tt-chk-gds.src-code
     7321           tt-chk-gds.src-qnty
     7322           tt-chk-gds.doc-qnty
     7323           tt-chk-gds.src-price
     7324           tt-chk-gds.src-discnt
     7325           tt-chk-gds.VAT-sum-rubl
     7326           with browse br-gds.
     7327           undo, return no-apply.
     7328         end.
     7329         find first buf_marking-chk no-lock where buf_marking-chk.doc-code = tt-chk-gds.doc-code
     7330                                              and buf_marking-chk.line-num = tt-chk-gds.line-num
     7331                                              no-error .
     7332         if available buf_marking-chk
     7333         then do :
     7334           assign
     7335             tt-chk-gds.b-code     =   old-b-code
     7336             tt-chk-gds.src-code   =   old-src-code
     7337             tt-chk-gds.src-qnty   =   old-src-qnty
     7338             tt-chk-gds.doc-qnty   =   old-doc-qnty
     7339             tt-chk-gds.src-price  =   old-src-price
     7340             tt-chk-gds.src-sum    =   old-src-sum
     7341             tt-chk-gds.src-discnt =   old-src-discnt
     7342             tt-chk-gds.VAT-sum-rubl = old-vat-summ
     7343           .
     7344           display
     7345             tt-chk-gds.b-code
     7346             tt-chk-gds.src-code
     7347             tt-chk-gds.src-qnty
     7348             tt-chk-gds.doc-qnty
     7349             tt-chk-gds.src-price
     7350             tt-chk-gds.src-discnt
     7351             tt-chk-gds.VAT-sum-rubl
     7352           with browse br-gds.
     7353         end .
     7354       end.
     7355   end.
