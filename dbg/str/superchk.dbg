     7088       if v-curr-sv-date <> ?
     7089       then do:
     7090         assign
     7091           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     7092         .
     7093         assign
     7094           self :screen-value = string(v-new-sv-date) .
     7095         .
     7096       end.
     7097     end.
     7098     return no-apply .
     7099   end.
     7100   on ctrl-e of corr-date in frame Dialog-Frame
     7101   do:
     7102     if (can-query (self, "sensitive")
     7103        and
