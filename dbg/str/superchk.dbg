     1669   procedure xmlchar-test :
     1670   define input parameter p-in-string          as character        no-undo.
     1671   define output parameter p-out-string-enc    as character        no-undo.
     1672   define output parameter p-out-string-dec    as character        no-undo.
     1673   do
     1674   on error undo, return error
     1675   :
     1676          run xmlchar-encode in this-procedure
     1677       (
     1678             input p-in-string
     1679           , output p-out-string-enc
     1680       ).
     1681          run xmlchar-decode in this-procedure
     1682       (
     1683             input p-out-string-enc
     1684           , output p-out-string-dec
     1685       ).
     1686   end.
     1687   end .
     1688   procedure xmlchar-encode :
     1689   define input parameter p-in-string      as character        no-undo.
     1690   define output parameter p-out-string    as character        no-undo.
     1691       define variable v-position      as integer      no-undo.
     1692       define variable v-current-char  as character    no-undo.
     1693   do
     1694   on error undo, return error
     1695   :
     1696       assign
     1697           p-out-string = "":U
     1698       .
     1699       case p-in-string
     1700       :
     1701           when ?
     1702           then do:
     1703               assign
     1704                   p-out-string = "?":U
     1705               .
     1706           end.
     1707           when "?":U
     1708           then do:
     1709               assign
     1710                   p-out-string = "&#63;":U
     1711               .
     1712           end.
     1713           otherwise do:
     1714               do v-position = 1 to length( p-in-string )
     1715               :
     1716                   assign
     1717                       v-current-char = substring( p-in-string, v-position, 1 )
     1718                   .
     1719                   case v-current-char
     1720                   :
     1721                       when "&":U
     1722                       then do:
     1723                           assign
     1724                               p-out-string = p-out-string + "&amp;":U
     1725                           .
     1726                       end.
     1727                       when ">":U
     1728                       then do:
     1729                           assign
     1730                               p-out-string = p-out-string + "&gt;":U
     1731                           .
     1732                       end.
     1733                       when "<":U
     1734                       then do:
     1735                           assign
     1736                               p-out-string = p-out-string + "&lt;":U
     1737                           .
     1738                       end.
     1739                       when "'":U
     1740                       then do:
     1741                           assign
     1742                               p-out-string = p-out-string + "&apos;":U
     1743                           .
     1744                       end.
     1745                       when '"':U
     1746                       then do:
     1747                           assign
     1748                               p-out-string = p-out-string + "&quot;":U
     1749                           .
     1750                       end.
     1751                       when chr(1)
     1752                       then do:
     1753                           assign
     1754                               p-out-string = p-out-string + "":U
     1755                           .
     1756                       end.
     1757                       when chr(2)
     1758                       then do:
     1759                           assign
     1760                               p-out-string = p-out-string + "":U
     1761                           .
     1762                       end.
     1763                       when chr(3)
     1764                       then do:
     1765                           assign
     1766                               p-out-string = p-out-string + "":U
     1767                           .
     1768                       end.
     1769                       when chr(4)
     1770                       then do:
     1771                           assign
     1772                               p-out-string = p-out-string + "":U
     1773                           .
     1774                       end.
     1775                       when chr(5)
     1776                       then do:
     1777                           assign
     1778                               p-out-string = p-out-string + "":U
     1779                           .
     1780                       end.
     1781                       when chr(6)
     1782                       then do:
     1783                           assign
     1784                               p-out-string = p-out-string + "":U
     1785                           .
     1786                       end.
     1787                       when chr(7)
     1788                       then do:
     1789                           assign
     1790                               p-out-string = p-out-string + "":U
     1791                           .
     1792                       end.
     1793                       when chr(8)
     1794                       then do:
     1795                           assign
     1796                               p-out-string = p-out-string + "":U
     1797                           .
     1798                       end.
     1799                       when chr(9)
     1800                       then do:
     1801                           assign
     1802                               p-out-string = p-out-string + "":U
     1803                           .
     1804                       end.
     1805                       when chr(29)
     1806                       then do:
     1807                           assign
     1808                               p-out-string = p-out-string + "":U
     1809                           .
     1810                       end.
     1811                       when chr(10)
     1812                       then do:
     1813                           assign
     1814                               p-out-string = p-out-string + "&#10;":U
     1815                           .
     1816                       end.
     1817                       when chr(13)
     1818                       then do:
     1819                           assign
     1820                               p-out-string = p-out-string + "&#13;":U
     1821                           .
     1822                       end.
     1823                       otherwise do:
     1824                           assign
     1825                               p-out-string = p-out-string + v-current-char
     1826                           .
     1827                       end.
     1828                   end case.
     1829               end.
     1830           end.
     1831       end case.
     1832   end.
     1833   end .
     1834   procedure xmlchar-encode-1c :
     1835   define input parameter p-in-string      as character        no-undo.
     1836   define output parameter p-out-string    as character        no-undo.
     1837       define variable v-position      as integer      no-undo.
     1838       define variable v-current-char  as character    no-undo.
     1839   do
     1840   on error undo, return error
     1841   :
     1842       assign
     1843           p-out-string = "":U
     1844       .
     1845       case p-in-string
     1846       :
     1847           when ?
     1848           then do:
     1849               assign
     1850                   p-out-string = "?":U
     1851               .
     1852           end.
     1853           otherwise do:
     1854               do v-position = 1 to length( p-in-string )
     1855               :
     1856                   assign
     1857                       v-current-char = substring( p-in-string, v-position, 1 )
     1858                   .
     1859                   case v-current-char
     1860                   :
     1861                       when chr(1)
     1862                       then do:
     1863                           assign
     1864                               p-out-string = p-out-string + " ":U
     1865                           .
     1866                       end.
     1867                       when chr(2)
     1868                       then do:
     1869                           assign
     1870                               p-out-string = p-out-string + " ":U
     1871                           .
     1872                       end.
     1873                       when chr(3)
     1874                       then do:
     1875                           assign
     1876                               p-out-string = p-out-string + " ":U
     1877                           .
     1878                       end.
     1879                       when chr(4)
     1880                       then do:
     1881                           assign
     1882                               p-out-string = p-out-string + " ":U
     1883                           .
     1884                       end.
     1885                       when chr(5)
     1886                       then do:
     1887                           assign
     1888                               p-out-string = p-out-string + " ":U
     1889                           .
     1890                       end.
     1891                       when chr(6)
     1892                       then do:
     1893                           assign
     1894                               p-out-string = p-out-string + " ":U
     1895                           .
     1896                       end.
     1897                       when chr(7)
     1898                       then do:
     1899                           assign
     1900                               p-out-string = p-out-string + " ":U
     1901                           .
     1902                       end.
     1903                       when chr(8)
     1904                       then do:
     1905                           assign
     1906                               p-out-string = p-out-string + " ":U
     1907                           .
     1908                       end.
     1909                       when chr(9)
     1910                       then do:
     1911                           assign
     1912                               p-out-string = p-out-string + " ":U
     1913                           .
     1914                       end.
     1915                       when chr(29)
     1916                       then do:
     1917                           assign
     1918                               p-out-string = p-out-string + " ":U
     1919                           .
     1920                       end.
     1921                       when chr(10)
     1922                       then do:
     1923                           assign
     1924                               p-out-string = p-out-string + " ":U
     1925                           .
     1926                       end.
     1927                       when chr(13)
     1928                       then do:
     1929                           assign
     1930                               p-out-string = p-out-string + " ":U
     1931                           .
     1932                       end.
     1933                       otherwise do:
     1934                           assign
     1935                               p-out-string = p-out-string + v-current-char
     1936                           .
     1937                       end.
     1938                   end case.
     1939               end.
     1940           end.
     1941       end case.
     1942   end.
     1943   end .
     1944   procedure xmlchar-decode :
     1945   define input parameter p-in-string      as character        no-undo.
     1946   define output parameter p-out-string    as character        no-undo.
     1947       define variable v-position      as integer      no-undo.
     1948       define variable v-last-position as integer      no-undo.
     1949       define variable v-temp-integer  as integer      no-undo.
     1950       define variable v-current-char  as character    no-undo.
     1951       define variable v-next-char     as character    no-undo.
     1952       define variable v-success       as logical      no-undo.
     1953   do
     1954   on error undo, return error
     1955   :
     1956       assign
     1957           p-out-string = "":U
     1958           v-position   = 0
     1959       .
     1960       replace-cycle:
     1961       do while yes
     1962       on error undo, return error
     1963       :
     1964           assign
     1965               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1966           .
     1967           if v-last-position <= v-position
     1968           then do:
     1969               if v-position = 0
     1970               then do:
     1971                   assign
     1972                       p-out-string = p-in-string
     1973                   .
     1974               end.
     1975               else do:
     1976                   assign
     1977                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1978                   .
     1979               end.
     1980               leave replace-cycle.
     1981           end.
     1982           else do:
     1983               assign
     1984                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1985                   v-position      = v-last-position
     1986                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1987               .
     1988               if v-current-char = "#":U
     1989               then do:
     1990                   assign
     1991                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1992                   .
     1993                   if v-last-position > 0
     1994                   then do:
     1995                       run xmlchar-read-integer in this-procedure
     1996                        (
     1997                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1998                           , output v-temp-integer
     1999                           , output v-success
     2000                       ).
     2001                       if v-success = yes
     2002                       and v-temp-integer >= 1
     2003                       and v-temp-integer <= 255
     2004                       then do:
     2005                           assign
     2006                               p-out-string = p-out-string + chr( v-temp-integer )
     2007                               v-position   = v-last-position + 1
     2008                           .
     2009                       end.
     2010                       else do:
     2011                           assign
     2012                               p-out-string = p-out-string + "&":U
     2013                               v-position   = v-position   + 1
     2014                           .
     2015                       end.
     2016                   end.
     2017                   else do:
     2018                       assign
     2019                           p-out-string = p-out-string + "&":U
     2020                           v-position   = v-position   + 1
     2021                       .
     2022                   end.
     2023               end.
     2024               else do:
     2025                   case substring( p-in-string, v-position + 1, 3 )
     2026                   :
     2027                       when "lt;":U
     2028                       then do:
     2029                           assign
     2030                               p-out-string = p-out-string + "<":U
     2031                               v-position   = v-position   + 3
     2032                           .
     2033                       end.
     2034                       when "gt;":U
     2035                       then do:
     2036                           assign
     2037                               p-out-string = p-out-string + ">":U
     2038                               v-position   = v-position   + 3
     2039                           .
     2040                       end.
     2041                       otherwise do:
     2042                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2043                           then do:
     2044                               assign
     2045                                   p-out-string = p-out-string + "&":U
     2046                                   v-position   = v-position   + 4
     2047                               .
     2048                           end.
     2049                           else do:
     2050                               case substring( p-in-string, v-position + 1, 5 )
     2051                               :
     2052                                   when "quot;":U
     2053                                   then do:
     2054                                       assign
     2055                                           p-out-string = p-out-string + '"':U
     2056                                           v-position   = v-position   + 5
     2057                                       .
     2058                                   end.
     2059                                   when "apos;":U
     2060                                   then do:
     2061                                       assign
     2062                                           p-out-string = p-out-string + "'":U
     2063                                           v-position   = v-position   + 5
     2064                                       .
     2065                                   end.
     2066                                   otherwise do:
     2067                                       assign
     2068                                           p-out-string = p-out-string + "&":U
     2069                                       .
     2070                                   end.
     2071                               end case.
     2072                           end.
     2073                       end.
     2074                   end case.
     2075               end.
     2076           end.
     2077       end.
     2078   end.
     2079   end .
     2080   procedure xmlchar-read-integer :
     2081   define input parameter p-input-string      as character        no-undo.
     2082   define output parameter p-output-integer   as integer          no-undo.
     2083   define output parameter p-success       as logical          no-undo.
     2084   do
     2085   on error undo, return error
     2086   :
     2087       assign
     2088           p-output-integer = integer( p-input-string )
     2089       no-error.
     2090       if error-status :error
     2091       then do:
     2092           assign
     2093               p-success           = no
     2094               p-output-integer    = 0
     2095           .
     2096       end.
     2097       else do:
     2098           assign
     2099               p-success           = yes
     2100           .
     2101       end.
     2102   end.
     2103   end.
     2104   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2105   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2106   define variable mMRCCode  as logical    no-undo.
     2107   define variable mTypeMark as character  no-undo.
     2108   function IS-NeedMark returns logical
     2109   ( input ib-code as integer  ,
     2110     input ib-str as character ):
     2111      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     2112      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     2113                                    and buf_prod-bc-attr.b-str  eq ib-str
     2114                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     2115        no-lock no-error.
     2116      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2117   end.
     2118   function repTegforDm return char
     2119   (iDM as char ):
     2120       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     2121       define variable vteg as character no-undo.
     2122       define variable oDM as character no-undo.
     2123       define variable vi as integer no-undo.
     2124       oDM = iDm.
     2125       do vi = 1 to num-entries(vTeglist):
     2126          vTeg = entry(vi,vTeglist).
     2127          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     2128       end.
     2129       return oDM.
     2130   end.
     2131   function repSpecSimbforDm return char
     2132   (iDM as char ):
     2133       define variable oDM as character no-undo.
     2134     run
     2135       xmlchar-decode(iDM, output oDM).
     2136     return repTegforDm (oDM).
     2137   end.
     2138   function CheckGtin return logical
     2139   (iGtin as char):
     2140      define variable bar_code as character no-undo.
     2141      define variable vGtin as logical no-undo init "yes".
     2142      if length(iGtin) eq 14
     2143      then do:
     2144         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     2145         run str/chk-sum.p
     2146          (input-output bar_code ) no-error .
     2147         if iGtin ne  bar_code
     2148         then
     2149            vGtin = no.
     2150      end.
     2151      else
     2152         vGtin = no.
     2153      return vgtin.
     2154   end.
     2155   function repSpecSimbforXlm return char
     2156   (iDM as char ):
     2157       iDM = replace(iDM,chr(29),"").
     2158       return iDM.
     2159   end.
     2160   function getGtinByDM return char
     2161   (IDM as char):
     2162      define variable VTXT as char no-undo.
     2163      define variable vGtin as char no-undo.
     2164      vTXt = IdM.
     2165      vGtin = IDM.
     2166      if    length(vtxt) > 14
     2167      then do:
     2168         if   vtxt begins "(01)"
     2169                or vtxt begins "(02)"
     2170         then
     2171            vGtin = substring(vtxt,5,14).
     2172         else if   (vtxt begins "01"
     2173                or vtxt begins "02" )
     2174                and (   (    substring(iDm,17,2) eq "21"
     2175                         and length(vtxt) >= 21)
     2176                     or substring(iDm,17,2) eq "37"
     2177                     or substring(iDm,17,4) eq "(37)" )
     2178         then do:
     2179            vGtin = substring(vtxt,3,14).
     2180            if not checkGtin(vGtin)
     2181            then
     2182               vGtin = substring(vtxt,1,14).
     2183         end.
     2184         else if     length(vtxt) eq 14 + 7 + 4 + 4
     2185             or length(vtxt) eq 14 + 7 + 4
     2186             or length(vtxt) eq 14 + 7
     2187         then
     2188            vGtin = substring(vtxt,1,14).
     2189      end.
     2190      if not checkGtin(vGtin)
     2191      then
     2192         vGtin = "".
     2193      return vgtin.
     2194   end.
     2195   function getGdsCodeByGtin return int
     2196   (iGtin as char):
     2197      define buffer prod-bc  for ub.prod-bc.
     2198      define buffer bar-code for ub.bar-code.
     2199      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     2200      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2201      return if avail bar-code then bar-code.gds-code else ?.
     2202   end.
     2203   function getQntyCodeByGtin return decimal
     2204   (iGtin as char):
     2205      define buffer prod-bc  for ub.prod-bc.
     2206      define buffer bar-code for ub.bar-code.
     2207      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     2208      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     2209      return if avail bar-code then bar-code.cli-base-rate else ?.
     2210   end.
     2211   function getGdsCodeByDM return int
     2212   (iDm as char):
     2213      define variable vGtin as char no-undo.
     2214      define buffer prod-bc for ub.prod-bc.
     2215      vGtin  = getGtinByDM (IDM ).
     2216      return getGdsCodeByGtin (vGtin).
     2217   end.
     2218   function ChekTypeMarkByGds return logical
     2219   (iGds-code as integer ):
     2220      define buffer goods-attr for ub.goods-attr.
     2221      find first goods-attr where goods-attr.gds-code   = iGds-code
     2222                              and goods-attr.attr-code  = 'mark-type':U
     2223      no-lock no-error.
     2224      if available goods-attr
     2225      then do:
     2226         mTypeMark = goods-attr.attr-value.
     2227         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     2228           .
     2229      end.
     2230      else
     2231         return no.
     2232   end.
     2233   function ChekTypeMarkByDm return logical
     2234   (iDM as char ):
     2235      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     2236   end.
     2237   function ChekTypeMarkByGtin return logical
     2238   (iGtin as char ):
     2239      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     2240   end.
     2241   function GetNextElement return character
     2242     (input iAllTeg        as logical
     2243     ,output oteg          as character
     2244     ,output otegval       as character
     2245     ,input-output pstr    as character
     2246      ):
     2247        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     2248        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     2249        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     2250        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     2251        define variable vTeg as character no-undo.
     2252        define variable vLength as integer no-undo.
     2253        define variable vi as integer no-undo.
     2254        define variable vj as integer no-undo.
     2255        define buffer code for ub.code.
     2256        find first code where Code.parent eq "MarkType"
     2257                          and Code.CodeValue   eq mTypeMark
     2258                          no-lock no-error.
     2259        if     available code
     2260           and Code.misc1 ne ""
     2261           and Code.misc1 ne ?
     2262        then do:
     2263           integer (Code.misc1) no-error.
     2264           if not error-status:error
     2265           then
     2266             entry (4,vlistleng) = Code.misc1.
     2267        end.
     2268        if iAllTeg
     2269        then
     2270           assign
     2271              vlistElem     = vlistElem    + vlistElemDop
     2272              vlistleng     = vlistleng    + vlistlengDop
     2273           .
     2274        else if mMRCCode
     2275        then
     2276           assign
     2277              vlistElem     = vlistElem    + ",(8005),8005"
     2278              vlistleng     = vlistleng    + ",000006,0006"
     2279           .
     2280       block-elem:
     2281       do vi = 1 to num-entries(vlistElem):
     2282          vTeg = entry(vi,vlistElem).
     2283          if pstr begins vTeg
     2284          then do:
     2285             if    vTeg eq "21"
     2286             then
     2287                vLength = index(pstr,chr(29)) - 2 no-error.
     2288             if vLength  <= 0
     2289             then
     2290                vLength = int(entry(vi,vlistleng)).
     2291             otegval = substring (pstr,length(vteg) + 1, vLength).
     2292             oteg = replace(replace(vteg,")",""),"(","").
     2293             vTeg = vteg + otegval.
     2294             otegval = replace(otegval,chr(29),"").
     2295             oteg = replace(replace(oteg,")",""),"(","").
     2296             pstr = substring (pstr,length(vTeg)+ 1).
     2297             vTeg = replace(vTeg,chr(29),"").
     2298             leave block-elem.
     2299          end.
     2300          else
     2301             vTeg = "".
     2302       end.
     2303       return vteg.
     2304   end.
     2305   function GetCodeIdent return character
     2306   (iDm as char):
     2307      define variable Velement   as character no-undo init "first".
     2308      define variable oCodeIdent as character no-undo.
     2309      define variable vteg as character no-undo.
     2310      define variable vtegval as character no-undo.
     2311      define variable vGtin as character no-undo.
     2312      define buffer marking for ub.marking.
     2313      for first marking no-lock where
     2314                marking.mark eq iDm
     2315            and marking.unit-ext = "LEVEL2"
     2316      :
     2317        return iDm.
     2318      end.
     2319      vGtin  = getGtinByDM (iDm ).
     2320      ChekTypeMarkByDm(idm).
     2321      if iDm begins 'tech_':U
     2322      then
     2323         oCodeIdent = iDm.
     2324      else if length(iDm) < 21
     2325      then do:
     2326         find first marking where marking.mark eq idm
     2327         no-lock no-error.
     2328         oCodeIdent = if available marking then marking.mark else  ?.
     2329      end.
     2330      else if     length(iDm) eq 29
     2331         and not iDm begins "01"
     2332         and not iDm begins "02"
     2333      then
     2334         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     2335      else  if     length(iDm) >= 24
     2336               and (  iDm begins "01"
     2337                   or iDm begins "02")
     2338               and  substring(iDm,17,2) ne "21"
     2339      then do:
     2340         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     2341                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     2342         then
     2343            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     2344         else
     2345            oCodeIdent = iDM.
     2346      end.
     2347      else  if     (   length(iDm) eq 25
     2348                    or length(iDm) eq 21)
     2349               and (not iDm begins "01"
     2350               and  not iDm begins "02")
     2351      then
     2352         oCodeIdent = substring(iDm,1,21).
     2353      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     2354      then
     2355         oCodeIdent = substring(iDm,1,21).
     2356      else do while Velement ne "" and idm ne "":
     2357         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     2358         oCodeIdent = oCodeIdent + Velement.
     2359      end.
     2360      return oCodeIdent.
     2361   end.
     2362   function GetTegCod return character
     2363   (icodeIdent as char, iTeg as char):
     2364      define variable Velement   as character no-undo init "first".
     2365      define variable oTeg as character no-undo init ?.
     2366      define variable vteg as character no-undo.
     2367      define variable vtegval as character no-undo.
     2368      if     ((length(icodeIdent) eq 21
     2369         and not icodeIdent begins "01"
     2370         and not icodeIdent begins "02")
     2371         or
     2372             ( length(icodeIdent) eq 25
     2373               and not icodeIdent begins "01"
     2374               and not icodeIdent begins "02"))
     2375      then do:
     2376         if iTeg eq "01" or iTeg eq "02"
     2377         then
     2378            oTeg = substring(icodeIdent,1,21).
     2379         else  if  iTeg eq "21"
     2380         then
     2381            oTeg = substring(icodeIdent,15,7).
     2382      end.
     2383      else do:
     2384         ChekTypeMarkByDm(icodeIdent).
     2385         block-teg:
     2386            do while Velement ne "" and icodeIdent ne "":
     2387            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2388            if    Velement begins iTeg
     2389               or Velement begins "(" + iTeg + ")"
     2390            then do:
     2391               oTeg = vtegval.
     2392               leave block-teg.
     2393            end.
     2394         end.
     2395      end.
     2396      return oTeg.
     2397   end.
     2398   function isOAD return logical
     2399   (icodeIdent as character):
     2400      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2401   end.
     2402   function isMark return logical
     2403   (icodeIdent as character):
     2404      define buffer buf_marking for ub.marking.
     2405      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2406             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2407   end.
     2408   function addBracketForCode return character
     2409   (icodeIdent as char):
     2410      define variable Velement   as character no-undo init "first".
     2411      define variable oTeg as character no-undo.
     2412      define variable vteg as character no-undo.
     2413      define variable vtegval as character no-undo.
     2414      define buffer marking for ub.marking.
     2415      find first marking no-lock where
     2416                 marking.mark begins icodeIdent no-error.
     2417      if    not ChekTypeMarkByDm(icodeIdent)
     2418         or length(icodeIdent) le 24
     2419         or (avail marking and marking.unit-ext = "LEVEL2")
     2420      then
     2421         oTeg = icodeIdent.
     2422      else do:
     2423         if (  icodeIdent begins "01"
     2424            or icodeIdent begins "02"
     2425            ) and CheckGtin(substring (icodeIdent,3,14))
     2426            and substring (icodeIdent,17,2) eq "21"
     2427         then do:
     2428            mMRCCode = yes.
     2429            ChekTypeMarkByDm(icodeIdent).
     2430            block-teg:
     2431            do while Velement ne "" and icodeIdent ne "":
     2432               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2433               if vteg ne ""
     2434               then
     2435                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2436            end.
     2437            mMRCCode = no.
     2438         end.
     2439         else do:
     2440            oTeg = icodeIdent.
     2441         end.
     2442      end.
     2443      return oTeg.
     2444   end.
     2445   function getlevelByCodId return int
     2446   (iCode as char):
     2447      define variable vLength as int no-undo.
     2448      define variable vLevel  as int no-undo.
     2449      if not ChekTypeMarkByDM (icode) then return ?.
     2450      vLength = length(iCode).
     2451      if    vLength eq 18
     2452         or vLength eq 20
     2453      then
     2454         Vlevel = 4.
     2455      else if vLength eq 21
     2456      then
     2457         Vlevel = 1.
     2458      else if vLength eq 25
     2459      then do:
     2460         if  iCode begins "01"
     2461         then
     2462            Vlevel = 3.
     2463         else
     2464            Vlevel = 1.
     2465      end.
     2466      else if     vLength >= 26
     2467              and vLength <= 46
     2468      then do:
     2469         if    substring(iCode,17,2) eq "11"
     2470            or substring(iCode,17,2) eq "13"
     2471            or (    substring(iCode,17,2) eq "21"
     2472                and vLength >= 33
     2473                and substring(iCode,26,4) ne "8005")
     2474         then
     2475            Vlevel = 4.
     2476         else if    vLength eq 31
     2477                 or vLength eq 38
     2478                 or vLength eq 39
     2479                 or vLength eq 45
     2480         then
     2481            Vlevel = 1.
     2482         else if    vLength eq 35
     2483                 or vLength eq 43
     2484         then
     2485            Vlevel = 3.
     2486         else
     2487            Vlevel = ?.
     2488      end.
     2489      else
     2490         Vlevel = ?.
     2491      return Vlevel.
     2492   end.
     2493   function getLevelMotpBycodid return character
     2494   (iDm as char):
     2495      define variable vLevel as integer no-undo.
     2496      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2497      vLevel = getlevelByCodId(iDm).
     2498      if    vLevel eq ?
     2499         or vLevel < 1
     2500         or vLevel > 6
     2501      then
     2502         return ?.
     2503      else
     2504         return entry(vlevel,vList).
     2505   end.
     2506   function getLevelUTDByLevelMotp return character
     2507   (iUnit as char):
     2508      define variable vLevel as integer no-undo.
     2509      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2510      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2511      vLevel = lookup(iUnit,vListMOTP).
     2512      if    vLevel eq ?
     2513         or vLevel < 1
     2514         or vLevel > 4
     2515      then
     2516         return ?.
     2517      else
     2518         return entry(vlevel,vListutd).
     2519   end.
     2520   function getLevelMotpByDM return character
     2521   (iDm as char):
     2522      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2523   end.
     2524   function getLevelUTDByCodId return character
     2525   (iDm as char):
     2526      define variable vLevel as integer no-undo.
     2527      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2528      vLevel = getlevelByCodId(iDm).
     2529      if    vLevel eq ?
     2530         or vLevel < 1
     2531         or vLevel > 4
     2532      then
     2533         return ?.
     2534      else
     2535         return entry(vlevel,vList).
     2536   end.
     2537   function getLevelUTDByDM return character
     2538   (iDm as char):
     2539      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2540   end.
     2541   define variable mNotMarkQnty as logical no-undo.
     2542   function getQntyUTDByCodId return decimal
     2543   (iDM as char):
     2544      define variable vLevel as integer no-undo.
     2545      define variable vList as character no-undo init "1,5,10,500".
     2546      define variable vGtin as character no-undo.
     2547      define variable vqnty as decimal no-undo init ?.
     2548      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2549      if vqnty eq ?
     2550      then do:
     2551         if not mNotMarkQnty
     2552         then do:
     2553            define buffer marking for ub.marking.
     2554            define variable vCodident as character no-undo.
     2555            vCodident = GetCodeIdent(idm).
     2556            find first marking where marking.mark begins vCodident no-lock no-error.
     2557            if     available marking
     2558               and marking.box-qnty ne ?
     2559            then
     2560               return marking.box-qnty.
     2561         end.
     2562         vGtin = getGtinByDm(iDM).
     2563         if ChekTypeMarkByGtin (vGtin)
     2564         then do:
     2565            vLevel = getlevelByCodId(iDM).
     2566            if     vLevel >= 1
     2567               and vLevel <= 4
     2568            then
     2569               vqnty = int(entry(vlevel,vList)).
     2570         end.
     2571         else
     2572            vqnty = getQntyCodeByGtin(vgtin).
     2573      end.
     2574      return vqnty.
     2575   end.
     2576   function getQntyUTDByDM return decimal
     2577   (iDm as char):
     2578      define variable vDM as character no-undo.
     2579      if     length (iDm) ne 25
     2580         and length (iDm) ne 29
     2581         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2582      then
     2583         vDM = substring (iDm,1,length (iDm) - 6 ).
     2584      else
     2585         vDM = substring (iDm,1,length (iDm) - 4 ).
     2586      return getQntyUTDByCodId(vDM).
     2587   end.
     2588   function getMRC4 return decimal
     2589   (iMRC as char):
     2590      define variable oMrc     as decimal no-undo init ?.
     2591      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2592      define variable vi       as integer no-undo.
     2593      define variable vfound   as integer no-undo.
     2594      define variable vposStart   as integer no-undo.
     2595      do:
     2596      OMRc = 0.
     2597      do vi = 1 to 4:
     2598         define variable vsimb as character no-undo.
     2599         vsimb = substring(iMRC,vi,1).
     2600         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2601         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2602         if vfound > 0
     2603         then
     2604            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2605         end.
     2606         OMRc = OMRc / 100.
     2607      end.
     2608      return OMRc.
     2609   end.
     2610   function getMRCByDM return decimal
     2611   (iDm as char):
     2612      define variable vMRC     as character no-undo.
     2613      define variable oMrc     as decimal no-undo init ?.
     2614      define variable Velement as character no-undo init "empty".
     2615      define variable vteg as character no-undo.
     2616      define variable vtegval as character no-undo.
     2617      if    length(idm) eq 14 + 7 + 4 + 4
     2618         or length(idm) eq 14 + 7 + 4
     2619      then do:
     2620         vMRC = substring(idm,22,4).
     2621         omrc = getMRC4(vMRC).
     2622      end.
     2623      else do:
     2624          ChekTypeMarkByDm(iDm).
     2625          block-mrc:
     2626          do while Velement ne "" and idm ne "":
     2627             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2628             if Velement begins "8005"
     2629             then do:
     2630                vMRC = substring(Velement,5,6).
     2631                leave block-mrc.
     2632             end.
     2633             else if Velement begins "(8005)"
     2634             then do:
     2635                vMRC = substring(Velement,7,6).
     2636                leave block-mrc.
     2637             end.
     2638          end.
     2639          if vMRC ne ""
     2640          then
     2641             OMRc = dec(vmrc) / 100 no-error.
     2642      end.
     2643      return OMRc.
     2644   end.
     2645   function MoveDate return Date
     2646   (idate as date,
     2647    iMonth as int64):
     2648      define variable vMonth   as int64 no-undo.
     2649      define variable vYear    as int64 no-undo.
     2650      define variable vDateNew as date  no-undo.
     2651       define variable vDay     as int64 no-undo.
     2652       vMonth = month(iDate) + iMonth.
     2653       vYear =  year(iDate).
     2654       if vMonth <= 0
     2655       then assign
     2656          vMonth = vMonth + 12
     2657           vYear  = vYear - 1
     2658       .
     2659       else if vMonth > 12
     2660       then assign
     2661          vMonth = vMonth - 12
     2662           vYear  = vYear + 1
     2663       .
     2664       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2665       do while error-status:error eq yes:
     2666          VDay = vDay + 1.
     2667          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2668       end.
     2669       if VDay > 0
     2670       then
     2671          vDateNew + 1.
     2672       return vDateNew.
     2673   end.
     2674   procedure checkEMRC:
     2675   define input  parameter iDm as character no-undo.
     2676   define output parameter vok as logical   no-undo init yes.
     2677      define variable v-value-emrc as character no-undo.
     2678      define variable v-type-emrc  as character no-undo.
     2679      define variable vDateIso     as character no-undo.
     2680      define variable vMRC         as decimal no-undo.
     2681      define variable vqnty        as decimal no-undo.
     2682      define variable vPrice       as decimal no-undo.
     2683      define variable vparent      as character no-undo.
     2684      define variable vgds-code    as integer no-undo.
     2685      define buffer code for ub.code.
     2686      vMRC = getMRCByDM(iDm).
     2687      if vMRC > 0
     2688      then do:
     2689         vgds-code = getGdsCodeByDM(iDm).
     2690         vqnty     = getQntyUTDByDM(iDm).
     2691               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2692            (
     2693             input   vgds-code
     2694            ,input   'emrc-type':U
     2695            ,output   v-value-emrc
     2696            ,output   v-type-emrc
     2697          ) no-error.
     2698          if     v-value-emrc ne ""
     2699             and v-value-emrc ne ?
     2700          then do:
     2701             vDateIso = iso-date(today).
     2702             vPrice = vMRC / vqnty.
     2703             vparent ="emc" + chr(4) + v-value-emrc.
     2704             find last code where Code.parent      eq vparent
     2705                              and Code.code        le vDateIso
     2706                              and code.status_  eq 0
     2707             no-lock no-error.
     2708             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2709             then
     2710                vOk = true .
     2711             else do:
     2712                 define variable vText      as character no-undo.
     2713                 define variable vDate      as date no-undo.
     2714                 define variable vDateLast  as character no-undo.
     2715                 define variable vDateFirst as character no-undo.
     2716                 define variable vDate3     as date no-undo.
     2717                 vdate = date(code.misc1).
     2718                 vDateLast = code.misc1.
     2719                 vDate3 = MoveDate(today, - 3 ).
     2720                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2721                                      string(vDate3  , "99/99/9999"),
     2722                                      string(vDate   , "99/99/9999")
     2723                                      ).
     2724                 vdateIso = iso-date(vdate3).
     2725                 find last code  where Code.parent      eq vparent
     2726                                   and Code.code        le vDateIso
     2727                                   and code.status_  eq 0 no-lock no-error.
     2728                 if available code
     2729                 then
     2730                    vDateIso = code.code.
     2731                 vDateFirst = vDateIso.
     2732                 vDateLast = iso-date(vdate).
     2733                 define variable vGood as logical no-undo.
     2734                 define variable vDateSale as date no-undo.
     2735                 define buffer bcode for code.
     2736                 for last code where Code.parent   eq vparent
     2737                                 and code.status_  eq 0
     2738                                 and code.code     < vDateLast
     2739                                 and code.code     >= vDateFirst
     2740                 no-lock:
     2741                    find first bcode where bCode.parent   eq vparent
     2742                                       and bcode.status_  eq 0
     2743                                       and bcode.code     > code.code no-lock no-error.
     2744                    if available bcode
     2745                    then do:
     2746                       if vPrice < dec(Code.CodeValue)
     2747                       then
     2748                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2749                                                     chr(10),
     2750                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2751                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2752                                                     ).
     2753                       else do:
     2754                          vGood = yes.
     2755                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2756                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2757                                                     chr(10),
     2758                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2759                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2760                                                     string(         vDateSale            ,"99/99/9999"),
     2761                                                     string(vDateSale - today)
     2762                                                     ).
     2763                       end.
     2764                    end.
     2765                 end.
     2766                 if vgood
     2767                 then do:
     2768                    define variable choice as integer no-undo .
     2769                    run gbl/d-askw.w (input "Уточнение"
     2770                           ,input  vText
     2771                           ,input "|"
     2772                           ,input "Принять|Вернуть"
     2773                           ,input "Принять данный товар|Вернуть товар постащику"
     2774                           ,input 1
     2775                           ,input 2
     2776                           ,output choice) no-error.
     2777                    vok = choice eq 1.
     2778                 end.
     2779                 else
     2780                    vok =false.
     2781             end.
     2782          end.
     2783      end.
     2784   end.
     2785   function addGs2Mark return character
     2786   (iMark as char):
     2787      define variable vDM   as character no-undo.
     2788      define variable vIdx  as integer   no-undo.
     2789      if index(iMark,chr(29),1) > 0
     2790      then return iMark.
     2791      if substring(iMark,26,4) = "8005" then
     2792      do:
     2793        vIdx = index(iMark,"93",26 + 4 + 5).
     2794        if vIdx > 1 then do:
     2795          vDM = substitute("&1&4&2&4&3",
     2796                           substring(iMark,1,25),
     2797                           substring(iMark,26,vIdx - 25 - 1),
     2798                           substring(iMark,vIdx),
     2799                           chr(29)) no-error.
     2800          vIdx = index(vDm,"240",vIdx + 4).
     2801          if vIdx > 0 then
     2802          do:
     2803            vDM = substitute("&1&3&2",
     2804                             substring(vDm,1,vIdx - 1),
     2805                             substring(vDm,vIdx),
     2806                             chr(29)) no-error.
     2807          end.
     2808        end.
     2809        else
     2810          vDM = substitute("&1&3&2",
     2811                           substring(iMark,1,25),
     2812                           substring(iMark,26),
     2813                           chr(29)) no-error.
     2814      end.
     2815      else if substring(iMark,32,2) = "91" then
     2816      do:
     2817        vIdx = index(iMark,"92",32).
     2818        if vIdx > 1 then
     2819          vDM = substitute("&1&4&2&4&3",
     2820                           substring(iMark,1,31),
     2821                           substring(iMark,32,vIdx - 31 - 1),
     2822                           substring(iMark,vIdx),
     2823                           chr(29)) no-error.
     2824        else
     2825          vDM = substitute("&1&3&2",
     2826                           substring(iMark,1,31),
     2827                           substring(iMark,32),
     2828                           chr(29)) no-error.
     2829      end.
     2830      else if substring(iMark,39,2) = "91" then
     2831      do:
     2832        vIdx = index(iMark,"92",38).
     2833        if vIdx > 1 then
     2834          vDM = substitute("&1&4&2&4&3",
     2835                           substring(iMark,1,38),
     2836                           substring(iMark,39,vIdx - 38 - 1),
     2837                           substring(iMark,vIdx),
     2838                           chr(29)) no-error.
     2839        else
     2840          vDM = substitute("&1&3&2",
     2841                           substring(iMark,1,38),
     2842                           substring(iMark,39),
     2843                           chr(29)) no-error.
     2844      end.
     2845      else if substring(iMark,25,2) = "93" then
     2846      do:
     2847        vIdx = index(iMark,"92",25).
     2848        if vIdx > 1 then
     2849          vDM = substitute("&1&4&2&4&3",
     2850                           substring(iMark,1,24),
     2851                           substring(iMark,25,vIdx - 24 - 1),
     2852                           substring(iMark,vIdx),
     2853                           chr(29)) no-error.
     2854        else
     2855          vIdx = index(iMark,"3103",25).
     2856          if vIdx > 0 then
     2857          vDM = substitute("&1&4&2&4&3",
     2858                           substring(iMark,1,24),
     2859                           substring(iMark,25,vIdx - 24 - 1),
     2860                           substring(iMark,vIdx),
     2861                           chr(29)) no-error.
     2862          else
     2863            vDM = substitute("&1&3&2",
     2864                             substring(iMark,1,24),
     2865                             substring(iMark,25),
     2866                             chr(29)) no-error.
     2867      end.
     2868      else if substring(iMark,32,2) = "93" then
     2869      do:
     2870        vDM = substitute("&1&3&2",
     2871              substring(iMark,1,31),
     2872              substring(iMark,32),
     2873              chr(29)) no-error.
     2874      end.
     2875      return if vDM <> "" then vDm else iMark.
     2876   end.
     2877   function ChkGdsPromo returns logical
     2878       (input iDocCode as character)
     2879       :
     2880       define buffer buf_chk-gds for ub.chk-gds.
     2881       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2882       define variable vPromo as logical no-undo.
     2883       vPromo = no.
     2884       cspr:
     2885       for each buf_chk-gds no-lock where
     2886                    buf_chk-gds.doc-code = iDocCode,
     2887              first buf_chk-gds-attr no-lock where
     2888                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     2889                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     2890                and buf_chk-gds-attr.attr-code = "CSPromo"
     2891                and buf_chk-gds-attr.attr-value <> "0":
     2892          vPromo = yes.
     2893          leave cspr.
     2894       end.
     2895       return vPromo.
     2896   end.
     2897   function ChkPromoLine returns logical
     2898       (input iDocCode as character,
     2899       input iLineNum as integer)
     2900       :
     2901       define buffer buf_chk-gds for ub.chk-gds.
     2902       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2903       define variable vPromo as logical no-undo.
     2904       vPromo = no.
     2905       find first buf_chk-gds-attr no-lock where
     2906                    buf_chk-gds-attr.doc-code = iDocCode
     2907                and buf_chk-gds-attr.line-num  = iLineNum
     2908                and buf_chk-gds-attr.attr-code = "CSPromo"
     2909                and buf_chk-gds-attr.attr-value <> "0"
     2910       no-error.
     2911       if avail buf_chk-gds-attr then vPromo = yes.
     2912       return vPromo.
     2913   end.
     2914   function ChkPromoSum returns decimal
     2915       (input iDocCode as character,
     2916        input iLineNum as integer)
     2917       :
     2918      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2919      define variable vSumPromo as decimal no-undo.
     2920      find first buf_chk-gds-attr no-lock where
     2921                 buf_chk-gds-attr.doc-code = iDocCode
     2922             and buf_chk-gds-attr.line-num  = iLineNum
     2923             and buf_chk-gds-attr.attr-code = "CSPromoSum"
     2924         no-error.
     2925      if avail buf_chk-gds-attr then
     2926         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
     2927      return vSumPromo.
     2928   end function.
     2929   function ChkPromoPrice returns logical
     2930       (input iDocCode as character,
     2931        input iLineNum as integer)
     2932       :
     2933      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2934      define variable v-is-promo as logical no-undo.
     2935      v-is-promo = no.
     2936      find first buf_chk-gds-attr no-lock where
     2937                 buf_chk-gds-attr.doc-code = iDocCode
     2938             and buf_chk-gds-attr.line-num  = iLineNum
     2939             and buf_chk-gds-attr.attr-code = "CSPromo"
     2940         no-error.
     2941      if avail buf_chk-gds-attr
     2942        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     2943      then v-is-promo = yes.
     2944      return v-is-promo.
     2945   end function.
     2946   function ChkDopLitr returns logical
     2947       (input iDocCode as character,
     2948        input iLineNum as integer)
     2949       :
     2950      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2951      define variable v-is-promo as logical no-undo.
     2952      v-is-promo = no.
     2953      find first buf_chk-gds-attr no-lock where
     2954                 buf_chk-gds-attr.doc-code = iDocCode
     2955             and buf_chk-gds-attr.line-num  = iLineNum
     2956             and buf_chk-gds-attr.attr-code = "CSPromo"
     2957         no-error.
     2958      if avail buf_chk-gds-attr and
     2959        buf_chk-gds-attr.attr-value = "3"
     2960      then v-is-promo = yes.
     2961      return v-is-promo.
     2962   end function.
     2963   function RoundUp return decimal
     2964       (input iQnty as decimal,
     2965        input iPrice as decimal):
     2966       def var vSum  as decimal no-undo.
     2967       def var vSumR as decimal no-undo.
     2968       vSum = ABSOLUTE(iQnty) * iPrice.
     2969       vSumR = Round(vSum,2).
     2970       if vSumR < vSum then vSumR = vSumR + 0.01.
     2971       if iQnty < 0 then vSumR = - vSumR.
     2972       return vSumR.
     2973   end function.
     2974   function GetPromoSum returns decimal
     2975       (input iDocCode as character)
     2976       :
     2977       define buffer buf_chk-doc for ub.chk-doc.
     2978       define buffer buf2_chk-doc for ub.chk-doc.
     2979       define buffer buf_chk-gds for ub.chk-gds.
     2980       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     2981       define buffer buf2_chk-gds for ub.chk-gds.
     2982       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     2983       define variable v-price-base as decimal no-undo.
     2984       define variable v-doc-qnty as decimal no-undo.
     2985       define variable v-sum-base as decimal no-undo.
     2986       define variable v-sum-all as decimal no-undo.
     2987       define variable v-sum-promo as decimal no-undo.
     2988       define variable v-sum-chk as decimal no-undo.
     2989       assign
     2990          v-price-base = 0
     2991          v-doc-qnty = 0
     2992          v-sum-all = 0
     2993          v-sum-chk = 0
     2994          v-sum-promo = 0
     2995          .
     2996       for each buf_chk-gds no-lock where
     2997                buf_chk-gds.doc-code = iDocCode,
     2998          first buf_chk-gds-attr no-lock where
     2999                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3000            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3001            and buf_chk-gds-attr.attr-code = "CSPromoSum"
     3002          :
     3003          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
     3004       end.
     3005       if v-sum-promo = 0 then do:
     3006           for each buf_chk-gds no-lock where
     3007                    buf_chk-gds.doc-code = iDocCode,
     3008              first buf_chk-gds-attr no-lock where
     3009                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3010                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3011                and buf_chk-gds-attr.attr-code = "CSPromo"
     3012                and can-do("1,6", buf_chk-gds-attr.attr-value)
     3013              :
     3014              assign
     3015                v-price-base = buf_chk-gds.price-base
     3016                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
     3017                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
     3018                .
     3019           end.
     3020           for each buf_chk-gds no-lock where
     3021                    buf_chk-gds.doc-code = iDocCode,
     3022              first buf_chk-gds-attr no-lock where
     3023                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3024                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3025                and buf_chk-gds-attr.attr-code = "CSPromo"
     3026                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     3027              :
     3028              if v-price-base = 0 then do:
     3029                 find first buf_chk-doc no-lock where
     3030                            buf_chk-doc.doc-code = iDocCode
     3031                     no-error.
     3032                 if avail buf_chk-doc and
     3033                    buf_chk-doc.chk-type = int('6':U) and
     3034                    buf_chk-doc.doc-num2 > ""  and
     3035                    num-entries(buf_chk-doc.doc-num2,":") = 2
     3036                 then
     3037                 for first buf2_chk-doc no-lock where
     3038                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     3039                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     3040                       and buf2_chk-doc.chk-type = int('1':U)
     3041                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
     3042                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     3043                       :
     3044                   for each buf2_chk-gds no-lock where
     3045                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
     3046                      first buf2_chk-gds-attr no-lock where
     3047                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
     3048                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
     3049                        and buf2_chk-gds-attr.attr-code = "CSPromo"
     3050                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
     3051                      :
     3052                       v-price-base = buf2_chk-gds.price-base.
     3053                   end.
     3054                 end.
     3055              end.
     3056              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
     3057                  assign
     3058                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
     3059                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
     3060                     .
     3061              end.
     3062              else do:
     3063                 assign
     3064                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
     3065                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
     3066                 .
     3067              end.
     3068           end.
     3069           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
     3070       end.
     3071       return v-sum-promo.
     3072   end function.
     3073   function GetUnBaseSum returns decimal
     3074       (input iDocCode as character,
     3075        input iLineNum as integer,
     3076        input iQnty as decimal,
     3077        input iPrice as decimal):
     3078      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3079      define variable vBaseSum as decimal no-undo.
     3080      define variable vDiscSum as decimal no-undo.
     3081      vDiscSum = 0.
     3082      find first buf_chk-gds-attr no-lock where
     3083                        buf_chk-gds-attr.doc-code = iDocCode
     3084                    and buf_chk-gds-attr.line-num  = iLineNum
     3085                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
     3086             no-error.
     3087      if avail buf_chk-gds-attr then
     3088         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
     3089      vBaseSum = iQnty * iPrice + vDiscSum.
     3090      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
     3091         vBaseSum = RoundUp(iQnty, iPrice).
     3092      return vBaseSum.
     3093   end function.
     3094   function GetRoundSum returns decimal
     3095       (input iDocCode as character,
     3096        input iLineNum as integer,
     3097        input iQnty as decimal,
     3098        input iPrice as decimal):
     3099      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3100      define variable vBaseSum as decimal no-undo.
     3101      if ChkPromoPrice(iDocCode, iLineNum) then
     3102         vBaseSum = RoundUp(iQnty, iPrice).
     3103      else vBaseSum = iQnty * iPrice.
     3104      return vBaseSum.
     3105   end function.
     3106   function GetRoundSumChkDel returns decimal
     3107       (input iDocCode as character,
     3108        input iLineNum as integer,
     3109        input iChipNum as integer,
     3110        input iQnty as decimal,
     3111        input iPrice as decimal):
     3112      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     3113      define variable vBaseSum as decimal no-undo.
     3114      define variable vIsPromo as logical no-undo.
     3115      for each buf_c-chk-doc-attr no-lock where
     3116               buf_c-chk-doc-attr.doc-code = iDocCode
     3117           and buf_c-chk-doc-attr.chip-num = iChipNum
     3118          :
     3119          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
     3120          then do :
     3121            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
     3122            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
     3123            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
     3124            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
     3125            then vIsPromo = yes.
     3126          end.
     3127      end.
     3128      if ChkPromoPrice(iDocCode, iLineNum) then
     3129         vBaseSum = RoundUp(iQnty, iPrice).
     3130      else vBaseSum = iQnty * iPrice.
     3131      return vBaseSum.
     3132   end function.
     3133   function GetSaleRetDisc returns decimal
     3134       (input iDocCode as character,
     3135        input iSaleCode as character):
     3136      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3137      define buffer buf_chk-gds for ub.chk-gds.
     3138      define variable vQntyPromoRet as decimal no-undo.
     3139      define variable vQntyPromoSel as decimal no-undo.
     3140      define variable vDiscSumRet   as decimal no-undo.
     3141      define variable vDiscSumSale  as decimal no-undo.
     3142      vDiscSumRet = 0.
     3143      cspr:
     3144      for each  buf_chk-gds no-lock where
     3145                buf_chk-gds.doc-code = iDocCode,
     3146          first buf_chk-gds-attr no-lock where
     3147                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     3148            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3149            and buf_chk-gds-attr.attr-code = "CSPromo"
     3150            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     3151          :
     3152          vQntyPromoRet = buf_chk-gds.src-qnty.
     3153          leave cspr.
     3154      end.
     3155      if vQntyPromoRet <> 0 then
     3156      for each  buf_chk-gds no-lock where
     3157                buf_chk-gds.doc-code = iSaleCode:
     3158          find first buf_chk-gds-attr no-lock where
     3159                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     3160                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3161                 and buf_chk-gds-attr.attr-code = "CSPromo"
     3162          no-error.
     3163          if avail buf_chk-gds-attr
     3164               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     3165          then
     3166            vQntyPromoSel = buf_chk-gds.src-qnty.
     3167          find first buf_chk-gds-attr no-lock where
     3168                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     3169                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3170                and buf_chk-gds-attr.attr-code = "CSPromoSum"
     3171          no-error.
     3172          if avail buf_chk-gds-attr then
     3173             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
     3174      end.
     3175      if vQntyPromoRet <> 0 and
     3176         vQntyPromoSel = -1 * vQntyPromoRet
     3177      then vDiscSumRet = -1 * vDiscSumSale.
     3178      return vDiscSumRet.
     3179   end function.
     3180   function SetPromoDisc return logical
     3181    (input iDocCode as character,
     3182        input iLineNum as integer
     3183        )
     3184       :
     3185      define buffer buf_chk-doc for ub.chk-doc.
     3186      define buffer buf2_chk-doc for ub.chk-doc.
     3187      define buffer buf_chk-gds for ub.chk-gds.
     3188      define buffer buf2_chk-gds for ub.chk-gds.
     3189      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3190      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     3191      define buffer buf_chk-discnt for ub.chk-discnt.
     3192      define buffer buf2_chk-discnt for ub.chk-discnt.
     3193      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
     3194      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
     3195      define variable v-promo-sum as decimal no-undo.
     3196      define variable v-disc-promo-id as character no-undo.
     3197      define variable var-discnt-id as integer no-undo.
     3198      define variable v-chk-sale as character no-undo.
     3199      find first buf_chk-gds-attr no-lock where
     3200                 buf_chk-gds-attr.doc-code = iDocCode
     3201             and buf_chk-gds-attr.line-num  = iLineNum
     3202             and buf_chk-gds-attr.attr-code = "CSPromo"
     3203         no-error.
     3204      if avail buf_chk-gds-attr
     3205        then do:
     3206        find first buf_chk-discnt no-lock where
     3207                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     3208               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
     3209               and buf_chk-discnt.record-type = 0
     3210               and buf_chk-discnt.promo-id > ""
     3211               no-error.
     3212        if not avail buf_chk-discnt then do:
     3213           find first buf_chk-doc no-lock where
     3214                      buf_chk-doc.doc-code = iDocCode
     3215              no-error.
     3216           find first buf_chk-gds no-lock where
     3217                      buf_chk-gds.doc-code = iDocCode
     3218                 and  buf_chk-gds.line-num = iLineNum
     3219              no-error.
     3220          for first buf2_chk-doc no-lock where
     3221                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     3222                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     3223                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
     3224                and buf2_chk-doc.chk-type = int('1':U)
     3225                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
     3226                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     3227              :
     3228              find first buf2_chk-gds no-lock where
     3229                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     3230                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
     3231              no-error.
     3232              if not avail buf2_chk-gds then return no.
     3233              v-chk-sale = buf2_chk-doc.doc-code.
     3234              find first buf_chk-discnt no-lock where
     3235                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     3236                         buf_chk-discnt.record-type = 1 and
     3237                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     3238                         buf_chk-discnt.promo-id > ""
     3239              no-error .
     3240              if avail buf_chk-discnt
     3241              then do:
     3242                 v-disc-promo-id = buf_chk-discnt.promo-id.
     3243                 find first buf2_chk-discnt no-lock where
     3244                   buf2_chk-discnt.doc-code = iDocCode and
     3245                   buf2_chk-discnt.record-type = 5 and
     3246                   buf2_chk-discnt.line-num = 0 and
     3247                   buf2_chk-discnt.promo-id =  v-disc-promo-id
     3248                 no-error.
     3249                 find first buf2_chk-discnt-attr no-lock where
     3250                            buf2_chk-discnt-attr.doc-code = iDocCode and
     3251                            buf2_chk-discnt-attr.record-type = 5 and
     3252                            buf2_chk-discnt-attr.line-num = 0 and
     3253                            buf2_chk-discnt-attr.attr-code = "promo-id" and
     3254                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
     3255                       no-error .
     3256                 if not avail buf2_chk-discnt
     3257                 then do:
     3258                     for each buf_chk-discnt no-lock where
     3259                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     3260                          and buf_chk-discnt.record-type = 5:
     3261                          var-discnt-id  = var-discnt-id + 1.
     3262                     end.
     3263                     create buf2_chk-discnt.
     3264                     assign
     3265                       buf2_chk-discnt.doc-code = iDocCode
     3266                       buf2_chk-discnt.record-type = 5
     3267                       buf2_chk-discnt.line-num = 0
     3268                       buf2_chk-discnt.promo-id = v-disc-promo-id
     3269                       buf2_chk-discnt.object-sum = 0
     3270                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
     3271                                                      then buf2_chk-discnt-attr.discnt-id
     3272                                                      else (var-discnt-id + 1)
     3273                       var-discnt-id = 0
     3274                       buf2_chk-discnt.object-line-num = 0
     3275                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     3276                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
     3277                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
     3278                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
     3279                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
     3280                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
     3281                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
     3282                       .
     3283                 end.
     3284                 if avail buf2_chk-discnt and
     3285                    not avail buf2_chk-discnt-attr
     3286                 then do:
     3287                    create buf2_chk-discnt-attr.
     3288                    assign
     3289                       buf2_chk-discnt-attr.doc-code = iDocCode
     3290                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
     3291                       buf2_chk-discnt-attr.record-type     = 5
     3292                       buf2_chk-discnt-attr.line-num        = 0
     3293                       buf2_chk-discnt-attr.object-line-num = 0
     3294                       buf2_chk-discnt-attr.attr-code       = "promo-id"
     3295                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
     3296                       .
     3297                 end.
     3298              end.
     3299          end.
     3300           v-promo-sum = 0.
     3301           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     3302           then do:
     3303              if v-chk-sale <> ? and v-chk-sale <> "" then
     3304                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     3305              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     3306              if v-promo-sum <> 0 then do:
     3307                  find first buf2_chk-gds-attr no-lock where
     3308                             buf2_chk-gds-attr.doc-code = iDocCode
     3309                         and buf2_chk-gds-attr.line-num  = iLineNum
     3310                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     3311                     no-error.
     3312                  if not avail buf2_chk-gds-attr then do:
     3313                      create buf2_chk-gds-attr.
     3314                      assign
     3315                         buf2_chk-gds-attr.doc-code = iDocCode
     3316                         buf2_chk-gds-attr.line-num  = iLineNum
     3317                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     3318                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     3319                         .
     3320                  end.
     3321              end.
     3322           end.
     3323           for each buf_chk-discnt no-lock where
     3324                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     3325               and buf_chk-discnt.record-type = 0:
     3326              var-discnt-id  = var-discnt-id + 1.
     3327           end.
     3328           create buf_chk-discnt.
     3329           assign
     3330               buf_chk-discnt.doc-code = iDocCode
     3331               buf_chk-discnt.line-num = iLineNum
     3332               buf_chk-discnt.record-type = 0
     3333               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     3334               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     3335               buf_chk-discnt.line-type = integer('1':U)
     3336               buf_chk-discnt.line-sign = no
     3337               buf_chk-discnt.pass-discnt = integer('0':U)
     3338               buf_chk-discnt.value-type = integer('2':U)
     3339               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     3340               buf_chk-discnt.d-card = buf_chk-gds.d-card
     3341               buf_chk-discnt.discnt-value-abs = 0
     3342               buf_chk-discnt.discnt-value-pcnt = 0
     3343               buf_chk-discnt.object-line-num = iLineNum
     3344               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     3345               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     3346               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     3347               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     3348               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     3349               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     3350               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     3351               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     3352               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     3353               var-discnt-id = var-discnt-id + 1
     3354               buf_chk-discnt.promo-id = v-disc-promo-id
     3355               buf_chk-discnt.discnt-type = integer('7':U)
     3356               .
     3357           find first buf_chk-discnt-attr no-lock where
     3358                      buf_chk-discnt-attr.attr-code = "promo-id"
     3359                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     3360                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     3361                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     3362                  no-error.
     3363           if not avail buf_chk-discnt-attr then
     3364           do:
     3365               create buf_chk-discnt-attr .
     3366               assign
     3367                   buf_chk-discnt-attr.attr-code = "promo-id"
     3368                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     3369                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     3370                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     3371                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     3372                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     3373                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     3374                   .
     3375            end.
     3376        end.
     3377      end.
     3378      return yes.
     3379   end function.
     3380   function GetPromoPriceSum returns decimal
     3381       (input iDocCode as character)
     3382       :
     3383       define buffer buf_chk-gds for ub.chk-gds.
     3384       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3385       define variable vPromoSum as decimal no-undo.
     3386       vPromoSum = 0.
     3387       cspr:
     3388       for each buf_chk-gds no-lock where
     3389                    buf_chk-gds.doc-code = iDocCode,
     3390              first buf_chk-gds-attr no-lock where
     3391                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3392                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3393                and buf_chk-gds-attr.attr-code = "CSPromo"
     3394                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     3395          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     3396          leave cspr.
     3397       end.
     3398       return vPromoSum.
     3399   end.
     3400   function GetPromoPriceLine returns integer
     3401       (input iDocCode as character)
     3402       :
     3403       define buffer buf_chk-gds for ub.chk-gds.
     3404       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     3405       define variable vPromoLine as integer no-undo.
     3406       vPromoLine = 0.
     3407       cspr:
     3408       for each buf_chk-gds no-lock where
     3409                    buf_chk-gds.doc-code = iDocCode,
     3410              first buf_chk-gds-attr no-lock where
     3411                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     3412                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     3413                and buf_chk-gds-attr.attr-code = "CSPromo"
     3414                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     3415          vPromoLine = buf_chk-gds-attr.line-num.
     3416          leave cspr.
     3417       end.
     3418       return vPromoLine.
     3419   end.
