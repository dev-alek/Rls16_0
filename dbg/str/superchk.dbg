     5713   ON LEAVE OF v-link-chk IN FRAME Dialog-Frame
     5714   DO:
     5715     assign
     5716       v-link-chk.
     5717               find first ub.susp-chk exclusive-lock where ub.susp-chk.doc-code = tt-chk-doc.doc-code no-error .
     5718               if available (ub.susp-chk) then do:
     5719                   ub.susp-chk.link-chk = v-link-chk .
     5720               end.
     5721   END.
     5722   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     5723   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     5724     Marking = ObjSrv:Env:Marking:Sts:Mark.
     5725   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5726   on help of frame Dialog-Frame
     5727   do:
     5728     run gbl/app_help.p
     5729       (input this-procedure :file-name
     5730       ,input ''
     5731       ,input ?
     5732       ) no-error.
     5733     if error-status :error then do:
     5734       message
     5735         "Ошибка при вызове помощи"
     5736         error-status :get-message(1)
     5737         view-as alert-box .
     5738     end.
     5739   end.
     5740   run minbtn-set in this-procedure .
     5741   on choose of b-help in frame Dialog-Frame
     5742   do:
     5743     apply "help":u to frame Dialog-Frame .
     5744   end.
     5745   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5746   procedure minbtn-set :
     5747       do
     5748           on error undo, return error return-value
     5749           :
     5750           define variable ii              as integer       no-undo .
     5751           define variable fh              as widget-handle no-undo .
     5752           define variable hh              as widget-handle no-undo .
     5753           define variable v-h             as handle        extent 4 no-undo .
     5754           define variable v-name-button   as character     no-undo .
     5755           define variable v-help-old-x    as decimal       no-undo .
     5756           define variable v-help-old-y    as decimal       no-undo .
     5757           define variable v-help-old-size as decimal       no-undo .
     5758           define variable v-frame-width   as decimal       no-undo .
     5759           define variable jj              as integer       no-undo .
     5760           do
     5761               on error undo, return error
     5762               :
     5763               assign
     5764                   v-frame-width = frame Dialog-Frame:width - 0.3
     5765                   fh            = frame Dialog-Frame:first-child
     5766                   hh            = fh:first-child
     5767                   ii            = 1
     5768                   .
     5769               do while valid-handle(hh):
     5770                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5771                   do:
     5772                       case lc(hh:name) :
     5773                           when "b-help" then
     5774                               do:
     5775                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5776                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5777                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5778                                   hh:TOOLTIP = "Помощь" .
     5779                                   v-help-old-x = hh:column .
     5780                                   v-help-old-y = hh:row    .
     5781                                   v-help-old-size = hh:width .
     5782                                   hh:width-chars = 2.5 .
     5783                               end.
     5784                           when "b-print" then
     5785                               do:
     5786                                   hh:load-image("cmp/b-print.bmp":u) .
     5787                                   hh:TOOLTIP = "Печать" .
     5788                                   v-h[ii] = hh:handle .
     5789                                   ii = ii + 1 .
     5790                                   hh:width-chars = 3 .
     5791                               end.
     5792                           when "b-history" or
     5793                           when "b-hist" then
     5794                               do:
     5795                                   hh:load-image("cmp/b-hist.bmp":u) .
     5796                                   hh:TOOLTIP = "История" .
     5797                                   v-h[ii] = hh:handle .
     5798                                   ii = ii + 1 .
     5799                                   hh:width-chars = 3 .
     5800                               end.
     5801                           when "b-sch" then
     5802                               do:
     5803                                   hh:load-image("cmp/b-sch.bmp":u) .
     5804                                   hh:TOOLTIP = "Установка Фильтра" .
     5805                                   v-h[ii] = hh:handle .
     5806                                   ii = ii + 1 .
     5807                                   hh:width-chars = 3 .
     5808                               end.
     5809                           when "b-hist-user" then
     5810                               do:
     5811                                   hh:load-image("cmp/b-hist.bmp":u) .
     5812                                   hh:TOOLTIP = "История пользователя" .
     5813                                   ii = ii + 1 .
     5814                               end.
     5815                       end case.
     5816                   end.
     5817                   hh = hh:next-sibling.
     5818               end.
     5819               b-help:column = v-frame-width - b-help:width-chars.
     5820               jj = 0.
     5821               repeat ii = 4 to 1 by -1 :
     5822                   if valid-handle (v-h[ii] ) then
     5823                   do:
     5824                       jj  = jj + 1 .
     5825                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5826                       v-h[ii]:row    = v-help-old-y .
     5827                   end.
     5828               end.
     5829           end.
     5830       end.
     5831   end procedure.
     5832   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     5833   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     5834   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     5835   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     5836   define variable v-diasize-current-frame-width  as decimal   no-undo .
     5837   define variable v-diasize-current-frame-height as decimal   no-undo .
     5838   define variable v-diasize-change-size          as logical   no-undo .
     5839   define variable v-diasize-resize-button        as handle    no-undo .
     5840   define variable v-diasize-wndmax               as logical   no-undo .
     5841   define variable v-diasize-wndstore             as logical   no-undo .
     5842   define variable v-diasize-proc-name            as character no-undo .
     5843   define variable v-diasize-browse-handle        as handle    no-undo .
     5844   define variable v-diasize-browse-number        as integer   no-undo .
     5845   define variable v-diasize-need-full-display    as logical   no-undo init false .
     5846   define temp-table temp-diasize-handle no-undo
     5847     field handle-value  as handle
     5848     field save-position as decimal
     5849     index xpk is primary unique handle-value
     5850     .
     5851   define temp-table temp-browse-handle no-undo
     5852     field browse-type   as character
     5853     field browse-number as integer
     5854     field browse-handle as handle
     5855     field original-size as decimal
     5856     index xpk is primary unique browse-type browse-number
     5857     index xie browse-type browse-handle
     5858   .
     5859   procedure diasize_change-height :
     5860     define input  parameter p-change-value  as decimal   no-undo .
     5861     define input  parameter p-move-resize   as logical   no-undo .
     5862     define variable v-field-group-handle    as handle    no-undo .
     5863     define variable v-object-handle         as handle    no-undo .
     5864     define variable v-frame-height          as decimal   no-undo .
     5865     define variable v-frame-virtual-height  as decimal   no-undo .
     5866     define variable v-browse-height         as decimal   no-undo .
     5867     define variable v-window-height         as decimal   no-undo .
     5868     define variable v-window-virtual-height as decimal   no-undo .
     5869     define variable v-change-sign           as integer   no-undo .
     5870     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5871     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5872     if p-change-value > 0
     5873     then do:
     5874       if frame Dialog-Frame :height + p-change-value
     5875           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     5876       then do:
     5877         assign
     5878           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     5879                           - (frame Dialog-Frame :height-chars)
     5880         .
     5881         if p-change-value <= 0
     5882         then do:
     5883           run diasize_position-resize-button in this-procedure .
     5884           return .
     5885         end.
     5886       end.
     5887     end.
     5888     if p-change-value < 0
     5889     then do:
     5890       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     5891       then do:
     5892         assign
     5893           p-change-value = v-diasize-orig-frame-height
     5894                          - (frame Dialog-Frame :height-chars)
     5895         .
     5896         if p-change-value >= 0
     5897         then do:
     5898           run diasize_position-resize-button in this-procedure .
     5899           return .
     5900         end.
     5901       end.
     5902     end.
     5903     if p-change-value >= 0
     5904     then do:
     5905       assign
     5906         v-change-sign = 1
     5907       .
     5908     end.
     5909     else do:
     5910       assign
     5911         v-change-sign = -1
     5912       .
     5913     end.
     5914     assign
     5915       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5916     .
     5917     if p-change-value = 0
     5918     then do:
     5919       run diasize_position-resize-button in this-procedure .
     5920       return .
     5921     end.
     5922     move_block:
     5923     do
     5924     on error undo move_block, retry move_block
     5925     :
     5926       if retry
     5927       then do:
     5928         do
     5929         on error undo move_block, leave move_block
     5930         :
     5931           if p-change-value > 0
     5932           then do:
     5933             for each buf_temp-diasize-handle
     5934             on error undo, next
     5935             :
     5936               assign
     5937                 v-object-handle = buf_temp-diasize-handle.handle-value
     5938               .
     5939               if v-object-handle <> v-diasize-resize-button
     5940               then do:
     5941                 assign
     5942                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5943                 .
     5944               end.
     5945             end.
     5946             assign
     5947               v-diasize-browse-handle :height = v-browse-height
     5948             .
     5949             for each buf_temp-browse-handle
     5950               where buf_temp-browse-handle.browse-type = 'height':u
     5951             on error undo, next
     5952             :
     5953               assign
     5954                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     5955               .
     5956             end.
     5957             assign
     5958               frame Dialog-Frame :height = v-frame-height
     5959             .
     5960             if frame Dialog-Frame :scrollable = true
     5961             then do:
     5962               assign
     5963                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     5964               .
     5965             end.
     5966             run diasize_position-resize-button in this-procedure .
     5967           end.
     5968           else do:
     5969             if frame Dialog-Frame :scrollable = true
     5970             then do:
     5971               assign
     5972                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     5973               .
     5974             end.
     5975             assign
     5976               frame Dialog-Frame :height = v-frame-height
     5977             .
     5978             assign
     5979               v-diasize-browse-handle :height = v-browse-height
     5980             .
     5981             for each buf_temp-browse-handle
     5982               where buf_temp-browse-handle.browse-type = 'height':u
     5983             on error undo, next
     5984             :
     5985               assign
     5986                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     5987               .
     5988             end.
     5989             for each buf_temp-diasize-handle
     5990             on error undo, next
     5991             :
     5992               assign
     5993                 v-object-handle = buf_temp-diasize-handle.handle-value
     5994               .
     5995               if v-object-handle <> v-diasize-resize-button
     5996               then do:
     5997                 assign
     5998                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5999                 .
     6000               end.
     6001             end.
     6002             run diasize_position-resize-button in this-procedure .
     6003           end.
     6004           assign
     6005             v-diasize-change-size = false
     6006           .
     6007           leave move_block .
     6008         end.
     6009       end.
     6010       assign
     6011         v-diasize-need-full-display = true
     6012       .
     6013       if v-diasize-change-size = false
     6014       then do:
     6015         assign
     6016           v-diasize-change-size = true
     6017         .
     6018       end.
     6019       else do:
     6020         return .
     6021       end.
     6022       assign
     6023         v-frame-height = frame Dialog-Frame :height
     6024         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     6025         v-browse-height = v-diasize-browse-handle :height
     6026       .
     6027       for each buf_temp-browse-handle
     6028         where buf_temp-browse-handle.browse-type = 'height':u
     6029       :
     6030         assign
     6031           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     6032         .
     6033       end.
     6034       for each buf_temp-diasize-handle
     6035       :
     6036         delete buf_temp-diasize-handle .
     6037       end.
     6038       assign
     6039         v-field-group-handle = frame Dialog-Frame :first-child
     6040       .
     6041       do while valid-handle(v-field-group-handle)
     6042       :
     6043         assign
     6044           v-object-handle = v-field-group-handle :first-child
     6045         .
     6046         do while valid-handle(v-object-handle)
     6047         :
     6048           if  v-object-handle <> v-diasize-browse-handle :handle
     6049           and can-query(v-object-handle, "row")
     6050           and can-query(v-object-handle, "height")
     6051           and ( v-object-handle :row > v-diasize-browse-handle :row )
     6052           then do:
     6053             find first buf_temp-browse-handle
     6054               where buf_temp-browse-handle.browse-type   = 'height':u
     6055                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6056               no-error .
     6057             if available buf_temp-browse-handle
     6058             then do:
     6059             end.
     6060             else do:
     6061               create buf_temp-diasize-handle .
     6062               assign
     6063                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6064                 buf_temp-diasize-handle.save-position = v-object-handle :row
     6065               .
     6066             end.
     6067           end.
     6068           assign
     6069             v-object-handle = v-object-handle :next-sibling
     6070           .
     6071         end.
     6072         assign
     6073           v-field-group-handle = v-field-group-handle :next-sibling
     6074         .
     6075       end.
     6076       do with frame Dialog-Frame
     6077       :
     6078         hide v-diasize-resize-button .
     6079         assign
     6080           v-diasize-resize-button :row    = 1
     6081           v-diasize-resize-button :column = 1
     6082         .
     6083       end.
     6084       if p-change-value > 0
     6085       then do:
     6086         if frame Dialog-Frame :scrollable = true
     6087         then do:
     6088           assign
     6089             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     6090             no-error .
     6091           if error-status :error
     6092           or error-status :get-message(1) <> ""
     6093           then do:
     6094             undo move_block, retry move_block .
     6095           end.
     6096         end.
     6097         assign
     6098           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     6099           no-error .
     6100         if error-status :error
     6101         or error-status :get-message(1) <> ""
     6102         then do:
     6103           undo move_block, retry move_block .
     6104         end.
     6105         assign
     6106           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6107           no-error .
     6108         if error-status :error
     6109         or error-status :get-message(1) <> ""
     6110         then do:
     6111           undo move_block, retry move_block .
     6112         end.
     6113         for each buf_temp-browse-handle
     6114           where buf_temp-browse-handle.browse-type = 'height':u
     6115         on error undo move_block, retry move_block
     6116         :
     6117           assign
     6118             buf_temp-browse-handle.browse-handle :height
     6119               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6120             no-error .
     6121           if error-status :error
     6122           or error-status :get-message(1) <> ""
     6123           then do:
     6124             undo move_block, retry move_block .
     6125           end.
     6126         end.
     6127         for each buf_temp-diasize-handle
     6128         on error undo move_block, retry move_block
     6129         :
     6130           assign
     6131             v-object-handle = buf_temp-diasize-handle.handle-value
     6132           .
     6133           if v-object-handle <> v-diasize-resize-button
     6134           then do:
     6135             assign
     6136               v-object-handle :row = v-object-handle :row + p-change-value
     6137               no-error .
     6138             if error-status :error
     6139             or error-status :get-message(1) <> ""
     6140             then do:
     6141               undo move_block, retry move_block .
     6142             end.
     6143           end.
     6144         end.
     6145       end.
     6146       else do:
     6147         for each buf_temp-diasize-handle
     6148         on error undo move_block, retry move_block
     6149         :
     6150           assign
     6151             v-object-handle = buf_temp-diasize-handle.handle-value
     6152           .
     6153           if v-object-handle <> v-diasize-resize-button
     6154           then do:
     6155             assign
     6156               v-object-handle :row = v-object-handle :row + p-change-value
     6157               no-error .
     6158             if error-status :error
     6159             or error-status :get-message(1) <> ""
     6160             then do:
     6161               undo move_block, retry move_block .
     6162             end.
     6163           end.
     6164         end.
     6165         assign
     6166           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6167           no-error .
     6168         if error-status :error
     6169         or error-status :get-message(1) <> ""
     6170         then do:
     6171           undo move_block, retry move_block .
     6172         end.
     6173         for each buf_temp-browse-handle
     6174           where buf_temp-browse-handle.browse-type = 'height':u
     6175         on error undo move_block, retry move_block
     6176         :
     6177           assign
     6178             buf_temp-browse-handle.browse-handle :height
     6179               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6180             no-error .
     6181           if error-status :error
     6182           or error-status :get-message(1) <> ""
     6183           then do:
     6184             undo move_block, retry move_block .
     6185           end.
     6186         end.
     6187         assign
     6188           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     6189           no-error .
     6190         if error-status :error
     6191         or error-status :get-message(1) <> ""
     6192         then do:
     6193           undo move_block, retry move_block .
     6194         end.
     6195         if frame Dialog-Frame :scrollable = true
     6196         then do:
     6197           assign
     6198             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     6199             no-error .
     6200           if error-status :error
     6201           or error-status :get-message(1) <> ""
     6202           then do:
     6203             undo move_block, retry move_block .
     6204           end.
     6205         end.
     6206       end.
     6207       if p-move-resize = true
     6208       then do:
     6209         run diasize_position-resize-button in this-procedure .
     6210       end.
     6211       if v-diasize-wndstore = true
     6212       then do:
     6213         if connected("ub") = true
     6214         then do:
     6215           define variable v-cntxt-db-num        as integer   no-undo .
     6216           define variable v-cntxt-userid        as character no-undo .
     6217           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6218                                             , OUTPUT v-cntxt-userid
     6219                                             ) .
     6220           run gbl/wndsizew.p
     6221             (input  v-cntxt-db-num
     6222             ,input  v-cntxt-userid
     6223             ,input  v-diasize-proc-name
     6224             ,input  'height':u
     6225             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     6226             ) .
     6227         end.
     6228       end.
     6229     end.
     6230     assign
     6231       v-diasize-change-size = false
     6232     .
     6233   end procedure.
     6234   procedure diasize_set-height :
     6235     define input  parameter p-new-height  as decimal   no-undo .
     6236     define input  parameter p-move-resize as logical   no-undo .
     6237     do
     6238     on error undo, return error return-value
     6239     :
     6240       run diasize_change-height in this-procedure
     6241         (input  (p-new-height - frame Dialog-Frame :height)
     6242         ,input  p-move-resize
     6243         ) .
     6244     end.
     6245   end procedure.
     6246   procedure diasize_change-width :
     6247     define input  parameter p-change-value as decimal   no-undo .
     6248     define input  parameter p-move-resize  as logical   no-undo .
     6249     define variable v-field-group-handle   as handle    no-undo .
     6250     define variable v-object-handle        as handle    no-undo .
     6251     define variable v-frame-width          as decimal   no-undo .
     6252     define variable v-frame-virtual-width  as decimal   no-undo .
     6253     define variable v-browse-width         as decimal   no-undo .
     6254     define variable v-window-width         as decimal   no-undo .
     6255     define variable v-window-virtual-width as decimal   no-undo .
     6256     define variable v-change-sign          as integer   no-undo .
     6257     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6258     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6259     if p-change-value > 0
     6260     then do:
     6261       if frame Dialog-Frame :width + p-change-value >
     6262           session :width-chars
     6263       then do:
     6264         assign
     6265           p-change-value = session :width-chars - frame Dialog-Frame :width
     6266         .
     6267         if p-change-value <= 0
     6268         then do:
     6269           run diasize_position-resize-button in this-procedure .
     6270           return .
     6271         end.
     6272       end.
     6273     end.
     6274     if p-change-value < 0
     6275     then do:
     6276       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     6277       then do:
     6278         assign
     6279           p-change-value = v-diasize-orig-frame-width
     6280                          - frame Dialog-Frame :width
     6281         .
     6282         if p-change-value >= 0
     6283         then do:
     6284           run diasize_position-resize-button in this-procedure .
     6285           return .
     6286         end.
     6287       end.
     6288     end.
     6289     if p-change-value >= 0
     6290     then do:
     6291       assign
     6292         v-change-sign = 1
     6293       .
     6294     end.
     6295     else do:
     6296       assign
     6297         v-change-sign = -1
     6298       .
     6299     end.
     6300     assign
     6301       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6302     .
     6303     if p-change-value = 0
     6304     then do:
     6305       run diasize_position-resize-button in this-procedure .
     6306       return .
     6307     end.
     6308     move_block:
     6309     do
     6310     on error undo move_block, leave move_block
     6311     :
     6312       if retry
     6313       then do:
     6314         do
     6315         on error undo move_block, leave move_block
     6316         :
     6317           if p-change-value > 0
     6318           then do:
     6319             for each buf_temp-diasize-handle
     6320             on error undo, next
     6321             :
     6322               assign
     6323                 v-object-handle = buf_temp-diasize-handle.handle-value
     6324               .
     6325               if v-object-handle <> v-diasize-resize-button
     6326               then do:
     6327                 assign
     6328                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6329                 .
     6330               end.
     6331             end.
     6332             assign
     6333               v-diasize-browse-handle :width = v-browse-width
     6334             .
     6335             for each buf_temp-browse-handle
     6336               where buf_temp-browse-handle.browse-type = 'width':u
     6337             on error undo, next
     6338             :
     6339               assign
     6340                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6341               .
     6342             end.
     6343             assign
     6344               frame Dialog-Frame :width = v-frame-width
     6345             .
     6346             if frame Dialog-Frame :scrollable = true
     6347             then do:
     6348               assign
     6349                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     6350               .
     6351             end.
     6352             run diasize_position-resize-button in this-procedure .
     6353           end.
     6354           else do:
     6355             if frame Dialog-Frame :scrollable = true
     6356             then do:
     6357               assign
     6358                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     6359               .
     6360             end.
     6361             assign
     6362               frame Dialog-Frame :width = v-frame-width
     6363             .
     6364             for each buf_temp-browse-handle
     6365               where buf_temp-browse-handle.browse-type = 'width':u
     6366             on error undo, next
     6367             :
     6368               assign
     6369                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6370               .
     6371             end.
     6372             assign
     6373               v-diasize-browse-handle :width = v-browse-width
     6374             .
     6375             for each buf_temp-diasize-handle
     6376             on error undo, next
     6377             :
     6378               assign
     6379                 v-object-handle = buf_temp-diasize-handle.handle-value
     6380               .
     6381               if v-object-handle <> v-diasize-resize-button
     6382               then do:
     6383                 assign
     6384                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6385                 .
     6386               end.
     6387             end.
     6388             run diasize_position-resize-button in this-procedure .
     6389           end.
     6390           assign
     6391             v-diasize-change-size = false
     6392           .
     6393           leave move_block .
     6394         end.
     6395       end.
     6396       assign
     6397         v-diasize-need-full-display = true
     6398       .
     6399       if v-diasize-change-size = false
     6400       then do:
     6401         assign
     6402           v-diasize-change-size = true
     6403         .
     6404       end.
     6405       else do:
     6406         return .
     6407       end.
     6408       assign
     6409         v-frame-width = frame Dialog-Frame :width
     6410         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     6411         v-browse-width = v-diasize-browse-handle :width
     6412       .
     6413       for each buf_temp-browse-handle
     6414         where buf_temp-browse-handle.browse-type = 'width':u
     6415       :
     6416         assign
     6417           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     6418         .
     6419       end.
     6420       for each buf_temp-diasize-handle
     6421       :
     6422         delete buf_temp-diasize-handle .
     6423       end.
     6424       assign
     6425         v-field-group-handle = frame Dialog-Frame :first-child
     6426       .
     6427       do while valid-handle(v-field-group-handle)
     6428       :
     6429         assign
     6430           v-object-handle = v-field-group-handle :first-child
     6431         .
     6432         do while valid-handle(v-object-handle)
     6433         :
     6434           if  v-object-handle <> v-diasize-browse-handle :handle
     6435           and v-object-handle <> v-diasize-resize-button
     6436           and can-query(v-object-handle, "row")
     6437           and can-query(v-object-handle, "height")
     6438           and ( v-object-handle :col + v-object-handle :width
     6439                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     6440               )
     6441           then do:
     6442             find first buf_temp-browse-handle
     6443               where buf_temp-browse-handle.browse-type   = 'width':u
     6444                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6445               no-error .
     6446             if available buf_temp-browse-handle
     6447             then do:
     6448             end.
     6449             else do:
     6450               create buf_temp-diasize-handle .
     6451               assign
     6452                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6453                 buf_temp-diasize-handle.save-position = v-object-handle :col
     6454               .
     6455             end.
     6456           end.
     6457           assign
     6458             v-object-handle = v-object-handle :next-sibling
     6459           .
     6460         end.
     6461         assign
     6462           v-field-group-handle = v-field-group-handle :next-sibling
     6463         .
     6464       end.
     6465       do with frame Dialog-Frame
     6466       :
     6467         hide v-diasize-resize-button .
     6468         v-diasize-resize-button :row = 1.
     6469         v-diasize-resize-button :column = 1.
     6470       end.
     6471       if p-change-value > 0
     6472       then do:
     6473         if frame Dialog-Frame :scrollable = true
     6474         then do:
     6475           assign
     6476             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     6477             no-error .
     6478           if error-status :error
     6479           or error-status :get-message(1) <> ""
     6480           then do:
     6481             undo move_block, retry move_block.
     6482           end.
     6483         end.
     6484         assign
     6485           frame Dialog-Frame :width = v-frame-width + p-change-value
     6486           no-error .
     6487         if error-status :error
     6488         or error-status :get-message(1) <> ""
     6489         then do:
     6490           undo move_block, retry move_block.
     6491         end.
     6492         assign
     6493           v-diasize-browse-handle :width = v-browse-width + p-change-value
     6494         no-error .
     6495         if error-status :error
     6496         or error-status :get-message(1) <> ""
     6497         then do:
     6498           undo move_block, retry move_block.
     6499         end.
     6500         for each buf_temp-browse-handle
     6501           where buf_temp-browse-handle.browse-type = 'width':u
     6502         on error undo move_block, retry move_block
     6503         :
     6504           assign
     6505             buf_temp-browse-handle.browse-handle :width
     6506               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6507             no-error .
     6508           if error-status :error
     6509           or error-status :get-message(1) <> ""
     6510           then do:
     6511             undo move_block, retry move_block .
     6512           end.
     6513         end.
     6514         for each buf_temp-diasize-handle
     6515         on error undo move_block, retry move_block
     6516         :
     6517           assign
     6518             v-object-handle = buf_temp-diasize-handle.handle-value
     6519           .
     6520           if v-object-handle <> v-diasize-resize-button
     6521           then do:
     6522             assign
     6523               v-object-handle :col = v-object-handle :col + p-change-value
     6524               no-error .
     6525             if error-status :error
     6526             or error-status :get-message(1) <> ""
     6527             then do:
     6528               undo move_block, retry move_block .
     6529             end.
     6530           end.
     6531         end.
     6532       end.
     6533       else do:
     6534         for each buf_temp-diasize-handle
     6535         on error undo move_block, retry move_block
     6536         :
     6537           assign
     6538             v-object-handle = buf_temp-diasize-handle.handle-value
     6539           .
     6540           if v-object-handle <> v-diasize-resize-button
     6541           then do:
     6542             assign
     6543               v-object-handle :col = v-object-handle :col + p-change-value
     6544               no-error .
     6545             if error-status :error
     6546             or error-status :get-message(1) <> ""
     6547             then do:
     6548               undo move_block, retry move_block .
     6549             end.
     6550           end.
     6551         end.
     6552         for each buf_temp-browse-handle
     6553           where buf_temp-browse-handle.browse-type = 'width':u
     6554         on error undo move_block, retry move_block
     6555         :
     6556           assign
     6557             buf_temp-browse-handle.browse-handle :width
     6558               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6559             no-error .
     6560           if error-status :error
     6561           or error-status :get-message(1) <> ""
     6562           then do:
     6563             undo move_block, retry move_block .
     6564           end.
     6565         end.
     6566         assign
     6567           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     6568           no-error .
     6569         if error-status :error
     6570         or error-status :get-message(1) <> ""
     6571         then do:
     6572           undo move_block, retry move_block.
     6573         end.
     6574         assign
     6575           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     6576         no-error .
     6577         if error-status :error
     6578         or error-status :get-message(1) <> ""
     6579         then do:
     6580           undo move_block, retry move_block.
     6581         end.
     6582         if frame Dialog-Frame :scrollable = true
     6583         then do:
     6584           assign
     6585             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     6586           no-error .
     6587           if error-status :error
     6588           or error-status :get-message(1) <> ""
     6589           then do:
     6590             undo move_block, retry move_block.
     6591           end.
     6592         end.
     6593       end.
     6594       if p-move-resize
     6595       then do:
     6596         run diasize_position-resize-button in this-procedure .
     6597       end.
     6598       if v-diasize-wndstore = true
     6599       then do:
     6600         if connected("ub") = true
     6601         then do:
     6602           define variable v-cntxt-db-num        as integer   no-undo .
     6603           define variable v-cntxt-userid        as character no-undo .
     6604           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6605                                             , OUTPUT v-cntxt-userid
     6606                                             ) .
     6607           run gbl/wndsizew.p
     6608             (input  v-cntxt-db-num
     6609             ,input  v-cntxt-userid
     6610             ,input  v-diasize-proc-name
     6611             ,input  'width':u
     6612             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     6613             ) .
     6614         end.
     6615       end.
     6616     end.
     6617     assign
     6618       v-diasize-change-size = false
     6619     .
     6620   end procedure.
     6621   procedure diasize_set-width :
     6622     define input  parameter p-new-width  as decimal   no-undo .
     6623     define input  parameter p-move-resize as logical   no-undo .
     6624     do
     6625     on error undo, return error return-value
     6626     :
     6627       run diasize_change-width in this-procedure
     6628         (input  (p-new-width - frame Dialog-Frame :width)
     6629         ,input  p-move-resize
     6630         ) .
     6631     end.
     6632   end procedure.
     6633   procedure diasize_position-resize-button :
     6634     do with frame Dialog-Frame
     6635     :
     6636       hide v-diasize-resize-button .
     6637       assign
     6638         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     6639                     - 1
     6640                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     6641         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     6642                     - 1
     6643                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     6644       .
     6645       view v-diasize-resize-button .
     6646     end.
     6647   end procedure.
     6648   on alt-right anywhere
     6649   do:
     6650     run diasize_change-width in this-procedure
     6651       (input 1
     6652       ,input true
     6653       ) .
     6654     return no-apply .
     6655   end.
     6656   on alt-left anywhere
     6657   do:
     6658     run diasize_change-width in this-procedure
     6659       (input -1
     6660       ,input true
     6661       ) .
     6662     return no-apply .
     6663   end.
     6664   on alt-down anywhere
     6665   do:
     6666     run diasize_change-height in this-procedure
     6667       (input 1
     6668       ,input true
     6669       ) .
     6670     return no-apply .
     6671   end.
     6672   on alt-up anywhere
     6673   do:
     6674     run diasize_change-height in this-procedure
     6675       (input -1
     6676       ,input true
     6677       ) .
     6678     return no-apply .
     6679   end.
     6680   on alt-enter of frame Dialog-Frame
     6681   do:
     6682     run diasize_maximize in this-procedure
     6683       (input  ?
     6684       ).
     6685     return no-apply .
     6686   end.
     6687   procedure diasize_end-move :
     6688     do
     6689     on error undo, return error return-value
     6690     :
     6691       define variable v-row-delta as decimal   no-undo .
     6692       define variable v-col-delta as decimal   no-undo .
     6693       define variable v-new-row as decimal   no-undo .
     6694       define variable v-new-col as decimal   no-undo .
     6695       assign
     6696         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     6697         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     6698       .
     6699       assign
     6700         v-row-delta = v-new-row - frame Dialog-Frame :height
     6701         v-col-delta = v-new-col - frame Dialog-Frame :width
     6702       .
     6703       run diasize_change-height in this-procedure
     6704         (input v-row-delta
     6705         ,input true
     6706         ) .
     6707       run diasize_change-width in this-procedure
     6708         (input v-col-delta
     6709         ,input true
     6710         ) .
     6711     end.
     6712   end procedure.
     6713   procedure diasize_maximize :
     6714     define input  parameter p-action as logical   no-undo .
     6715     do
     6716     on error undo, return error return-value
     6717     :
     6718       if p-action = ?
     6719       then do:
     6720         if v-diasize-need-maximize = true
     6721         then do:
     6722           assign
     6723             p-action = true
     6724           .
     6725         end.
     6726         else do:
     6727           assign
     6728             p-action = false
     6729           .
     6730         end.
     6731       end.
     6732       if p-action = true
     6733       then do:
     6734         run diasize_change-height in this-procedure
     6735           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     6736               - frame Dialog-Frame :height-chars
     6737           ,input true
     6738           ) .
     6739         run diasize_change-width in this-procedure
     6740           (input session :width-chars
     6741               - frame Dialog-Frame :width-chars
     6742           ,input true
     6743           ) .
     6744         assign
     6745           v-diasize-need-maximize = false
     6746         .
     6747       end.
     6748       else do:
     6749         run diasize_change-width in this-procedure
     6750           (input v-diasize-orig-frame-width
     6751               - frame Dialog-Frame :width-chars
     6752           ,input true
     6753           ) .
     6754         run diasize_change-height in this-procedure
     6755           (input v-diasize-orig-frame-height
     6756               - frame Dialog-Frame :height-chars
     6757           ,input true
     6758           ) .
     6759         assign
     6760           v-diasize-need-maximize = true
     6761         .
     6762       end.
     6763     end.
     6764   end procedure.
     6765   procedure diasize_restore-orig-size :
     6766     do
     6767     on error undo, return error return-value
     6768     :
     6769       assign
     6770         v-diasize-current-frame-width  = frame Dialog-Frame :width
     6771         v-diasize-current-frame-height = frame Dialog-Frame :height
     6772       .
     6773       run diasize_set-height in this-procedure
     6774         (input  v-diasize-orig-frame-height
     6775         ,input  true
     6776         ) .
     6777       run diasize_set-width in this-procedure
     6778         (input  v-diasize-orig-frame-width
     6779         ,input  true
     6780         ) .
     6781     end.
     6782   end procedure.
     6783   procedure diasize_restore-current-size :
     6784     do
     6785     on error undo, return error return-value
     6786     :
     6787       run diasize_set-height in this-procedure
     6788         (input  v-diasize-current-frame-height
     6789         ,input  true
     6790         ) .
     6791       run diasize_set-width in this-procedure
     6792         (input  v-diasize-current-frame-width
     6793         ,input  true
     6794         ) .
     6795     end.
     6796   end procedure.
     6797   procedure diasize_set-browse-handle :
     6798     define input  parameter p-browse-handle as handle   no-undo .
     6799     define buffer buf_temp-browse-handle for temp-browse-handle .
     6800     do
     6801     on error undo, return error return-value
     6802     :
     6803       assign
     6804         v-diasize-browse-handle = p-browse-handle
     6805       .
     6806       for each buf_temp-browse-handle
     6807       on error undo, return error return-value
     6808       :
     6809         delete buf_temp-browse-handle .
     6810       end.
     6811     end.
     6812   end procedure.
     6813   procedure diasize_add_browse :
     6814     define input  parameter p-browse-type   as character no-undo .
     6815     define input  parameter p-browse-handle as handle    no-undo .
     6816     define buffer buf_temp-browse-handle for temp-browse-handle .
     6817     do
     6818     on error undo, return error return-value
     6819     :
     6820       assign
     6821         v-diasize-browse-number = v-diasize-browse-number + 1
     6822       .
     6823       create buf_temp-browse-handle .
     6824       assign
     6825         buf_temp-browse-handle.browse-type   = p-browse-type
     6826         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     6827         buf_temp-browse-handle.browse-handle = p-browse-handle
     6828       .
     6829     end.
     6830   end procedure.
     6831   procedure diasize_init :
     6832     define variable v-default-value    as logical   no-undo .
     6833     define variable v-restore-saved    as logical   no-undo .
     6834     define variable v-resize-value-str as character no-undo .
     6835     do
     6836     on error undo, return error return-value
     6837     :
     6838       do with frame Dialog-Frame
     6839       :
     6840         assign
     6841           v-diasize-orig-frame-height = frame Dialog-Frame :height
     6842           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     6843           v-diasize-browse-handle     = browse br-gds :handle
     6844         .
     6845         create button v-diasize-resize-button
     6846         assign
     6847           parent        = frame Dialog-Frame :first-child
     6848           label         = "s"
     6849           height-pixels = 16
     6850           width-pixels  = 16
     6851           visible       = true
     6852           sensitive     = true
     6853           movable       = true
     6854           triggers:
     6855             on end-move persistent run diasize_end-move in this-procedure .
     6856           end triggers.
     6857         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     6858         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     6859         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     6860         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     6861         assign
     6862           v-diasize-wndmax = false
     6863         .
     6864         if connected("ub") = true
     6865         then do:
     6866           define variable v-cntxt-db-num        as integer   no-undo .
     6867           define variable v-cntxt-userid        as character no-undo .
     6868           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6869                                             , OUTPUT v-cntxt-userid
     6870                                             ) .
     6871           run gbl/wndpar_r.p
     6872             (input  v-cntxt-db-num
     6873             ,input  v-cntxt-userid
     6874             ,input  'wndmax':U
     6875             ,output v-diasize-wndmax
     6876             ,output v-default-value
     6877             ) .
     6878         end.
     6879         assign
     6880           v-diasize-wndstore = false
     6881         .
     6882         if connected("ub") = true
     6883         then do:
     6884           run gbl/wndpar_r.p
     6885             (input  v-cntxt-db-num
     6886             ,input  v-cntxt-userid
     6887             ,input  'wndstore':U
     6888             ,output v-diasize-wndstore
     6889             ,output v-default-value
     6890             ) .
     6891         end.
     6892         assign
     6893           v-diasize-proc-name = entry(1, program-name(2), '.')
     6894         .
     6895         if v-diasize-wndstore = true
     6896         then do:
     6897           assign
     6898             v-restore-saved = false
     6899           .
     6900           if connected("ub") = true
     6901           then do:
     6902             run gbl/wndsizer.p
     6903               (input  v-cntxt-db-num
     6904               ,input  v-cntxt-userid
     6905               ,input  v-diasize-proc-name
     6906               ,input  'height':u
     6907               ,output v-resize-value-str
     6908               ) .
     6909             if v-resize-value-str <> '':U
     6910             then do:
     6911               run diasize_change-height in this-procedure
     6912                 (input  integer(v-resize-value-str)
     6913                 ,input  true
     6914                 ) .
     6915               assign
     6916                 v-restore-saved = true
     6917               .
     6918             end.
     6919           end.
     6920           if connected("ub") = true
     6921           then do:
     6922             run gbl/wndsizer.p
     6923               (input  v-cntxt-db-num
     6924               ,input  v-cntxt-userid
     6925               ,input  v-diasize-proc-name
     6926               ,input  'width':u
     6927               ,output v-resize-value-str
     6928               ) .
     6929             if v-resize-value-str <> '':U
     6930             then do:
     6931               run diasize_change-width in this-procedure
     6932                 (input  integer(v-resize-value-str)
     6933                 ,input  true
     6934                 ) .
     6935               assign
     6936                 v-restore-saved = true
     6937               .
     6938             end.
     6939           end.
     6940           if v-restore-saved <> true
     6941           then do:
     6942             if v-diasize-wndmax = true
     6943             then do:
     6944               run diasize_maximize in this-procedure
     6945                 (input  true
     6946                 ) .
     6947             end.
     6948           end.
     6949         end.
     6950         else do:
     6951           if v-diasize-wndmax = true
     6952           then do:
     6953             run diasize_maximize in this-procedure
     6954               (input  true
     6955               ) .
     6956           end.
     6957         end.
     6958       end.
     6959     end.
     6960   end procedure.
     6961   procedure diasize_need-full-display :
     6962     define output parameter p-need-full-display as logical   no-undo .
     6963     do
     6964     on error undo, return error return-value
     6965     :
     6966       assign
     6967         p-need-full-display = v-diasize-need-full-display
     6968       .
     6969       assign
     6970         v-diasize-need-full-display = false
     6971       .
     6972     end.
     6973   end procedure.
     6974   procedure get-context :
     6975      define output parameter p-db-num as integer          no-undo.
     6976      define output parameter p-user-id as character        no-undo.
     6977      define variable v-login               as character    no-undo.
     6978      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     6979      define buffer buf_user-login  for ub.user-login .
     6980      do
     6981      on error undo, return error
     6982      :
     6983            FIND FIRST buf_sys-ctrl no-lock.
     6984            ASSIGN
     6985               v-login = USERID("ub")
     6986               p-db-num = buf_sys-ctrl.db-num
     6987            .
     6988            FIND FIRST buf_user-login
     6989                 WHERE buf_user-login.db-num = p-db-num
     6990                   AND buf_user-login.user-login = v-login
     6991                 no-lock
     6992                 no-error
     6993                 .
     6994            IF AVAILABLE buf_user-login
     6995            THEN DO:
     6996               assign
     6997                  p-user-id = buf_user-login.user-id
     6998               .
     6999            END.
     7000      end.
     7001   end procedure.
     7002   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7003   on ' ' of corr-date in frame Dialog-Frame
     7004   do:
     7005     if (can-query (self, "sensitive")
     7006        and
     7007        self :sensitive = true
     7008        )
     7009     or (can-query (self, "read-only")
     7010        and
     7011        self :read-only = false
     7012        )
     7013     then do:
     7014       assign
     7015         self :screen-value = ?
     7016       .
     7017     end.
     7018     return no-apply.
     7019   end.
     7020   on delete-character of corr-date in frame Dialog-Frame
     7021   do:
     7022     if (can-query (self, "sensitive")
     7023        and
     7024        self :sensitive = true
