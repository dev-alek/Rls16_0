       68   define new global shared variable g#vssrevis-logger as handle    no-undo .
       69   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       70   define variable v-vssrevis-logger                   as handle    no-undo .
       71   procedure vss-logevent :
       72     define input  parameter p-extra-paramters as character no-undo .
       73     define variable v-vssrevis-parameters as character no-undo .
       74     do
       75     on error undo, return error return-value
       76     :
       77       if  valid-handle(v-vssrevis-logger)
       78       and v-vssrevis-logger :get-signature("logevent") <> ""
       79       then do:
       80         run vss-get-parameters in this-procedure
       81           (output v-vssrevis-parameters
       82           ).
       83         run logevent in v-vssrevis-logger
       84           (input vss-workfile
       85           ,input vss-revision
       86           ,input v-vssrevis-parameters
       87           ,input p-extra-paramters
       88           ).
       89       end.
       90     end.
       91   end procedure.
       92   assign
       93     v-vssrevis-logger = g#vssrevis-logger
       94   .
       95   if  valid-handle(v-vssrevis-logger)
       96   and v-vssrevis-logger :get-signature("logevent") <> ""
       97   then do:
       98     assign
       99       v-vssrevis-logevent = true
      100     .
