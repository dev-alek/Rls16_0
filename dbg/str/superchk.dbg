     5258            menu-item m-modificator:sensitive in menu M-prt = yes
     5259            .
     5260           ASSIGN
     5261           b-adddiscnt:SENSITIVE IN FRAME Dialog-Frame = YES
     5262           b-addbonus:SENSITIVE IN FRAME Dialog-Frame = YES
     5263           b-addpay:SENSITIVE IN FRAME Dialog-Frame = YES
     5264           .
     5265       END.
     5266     END CASE.
     5267    if CB-chk-type = '12':U then do:
     5268       assign
     5269       tt-chk-pay.tot-sum:read-only in browse br-pay = no
     5270       tt-chk-pay.pay-code:read-only in browse br-pay = yes
     5271       tt-chk-pay.pay-code:visible in browse br-pay = no
     5272       tt-chk-pay.curr-code:visible in browse br-pay = no
     5273       tt-chk-pay.pay-card:visible in browse br-pay = no
     5274       tt-chk-pay.tot-sum:label in browse br-pay = "Сумма"
     5275       b-addpay:visible = no
