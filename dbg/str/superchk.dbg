      459   procedure cp-attr-code :
      460     do
      461     on error undo, return error
      462     :
      463       define input  parameter p-code           as character no-undo .
      464       define output parameter p-type           as character no-undo .
      465       define output parameter p-format         as character no-undo .
      466       define output parameter p-label          as character no-undo .
      467       define output parameter p-range          as integer   no-undo .
      468       define output parameter p-user-can-edit  as logical   no-undo .
      469       define output parameter p-output-display as logical   no-undo .
      470       define output parameter p-other          as character no-undo .
      471       case p-code :
      472               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      473               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      474               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      475               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      476               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      477               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      478               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      479               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      480               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      481               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      482         otherwise do:
      483           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      484         end.
      485       end.
      486     end.
      487   end procedure.
      488   procedure cp-attr-tooltip :
      489     do
      490     on error undo, return error
      491     :
      492       define input  parameter p-code    as character no-undo .
      493       define output parameter p-tooltip as character no-undo .
      494       define output parameter p-label   as character no-undo .
      495       case p-code :
      496               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      497               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      498               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      499               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      500               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      501               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      502               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      503               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      504               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      505               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      506         otherwise do:
      507           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      508         end.
      509       end.
      510     end.
      511   end procedure.
      512   procedure cp-attr-value :
      513     do
      514     on error undo, return error
      515     :
      516       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      517       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      518       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      519       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      520       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      521       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      522       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      523       define output parameter p-type        as character no-undo .
      524       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      525       define variable v-format         as character no-undo .
      526       define variable v-label          as character no-undo .
      527       define variable v-range          as integer   no-undo .
      528       define variable v-user-can-edit  as logical   no-undo .
      529       define variable v-output-display as logical   no-undo .
      530       define variable v-other          as character no-undo .
      531       run cp-attr-code in this-procedure
      532         (input  p-code
      533         ,output p-type
      534         ,output v-format
      535         ,output v-label
      536         ,output v-range
      537         ,output v-user-can-edit
      538         ,output v-output-display
      539         ,output v-other
      540         ) no-error .
      541       if error-status :error then do:
      542         undo, return error return-value .
      543       end.
      544       find first buf_cash-pay-attr no-lock
      545         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      546           and buf_cash-pay-attr.curr-code  = p-curr-code
      547           and buf_cash-pay-attr.host-code  = p-host-code
      548           and buf_cash-pay-attr.obj-type   = p-obj-type
      549           and buf_cash-pay-attr.obj-code   = p-obj-code
      550           and buf_cash-pay-attr.attr-code  = p-code
      551         no-error .
      552       if avail buf_cash-pay-attr then do:
      553         assign
      554           p-value =  buf_cash-pay-attr.attr-value
      555         .
      556       end.
      557       else do:
      558         assign
      559           p-value = if p-type = 'L':U then "no":U else ""
      560         .
      561       end.
      562     end.
      563   end procedure.
      564   procedure cp-attr-write :
      565     do
      566     on error undo, return error
      567     :
      568       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      569       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      570       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      571       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      572       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      573       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      574       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      575       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      576       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      577       define variable v-type           as character no-undo .
      578       define variable v-format         as character no-undo .
      579       define variable v-label          as character no-undo .
      580       define variable v-range          as integer   no-undo .
      581       define variable v-user-can-edit  as logical   no-undo .
      582       define variable v-output-display as logical   no-undo .
      583       define variable v-other          as character no-undo .
      584       run cp-attr-code in this-procedure
      585         (input  p-code
      586         ,output v-type
      587         ,output v-format
      588         ,output v-label
      589         ,output v-range
      590         ,output v-user-can-edit
      591         ,output v-output-display
      592         ,output v-other
      593         ) no-error .
      594       if error-status :error then do:
      595         undo, return error return-value .
      596       end.
      597       find first buf_cash-pay-attr exclusive-lock
      598         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      599           and buf_cash-pay-attr.curr-code  = p-curr-code
      600           and buf_cash-pay-attr.host-code  = p-host-code
      601           and buf_cash-pay-attr.obj-type   = p-obj-type
      602           and buf_cash-pay-attr.obj-code   = p-obj-code
      603           and buf_cash-pay-attr.attr-code = p-code
      604         no-error .
      605       if not available buf_cash-pay-attr then do:
      606         create buf_cash-pay-attr .
      607         assign
      608         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      609         buf_cash-pay-attr.curr-code  = p-curr-code
      610         buf_cash-pay-attr.host-code  = p-host-code
      611         buf_cash-pay-attr.obj-type   = p-obj-type
      612         buf_cash-pay-attr.obj-code   = p-obj-code
      613         buf_cash-pay-attr.attr-code = p-code
      614         .
      615       end.
      616       assign
      617         buf_cash-pay-attr.attr-value = p-value
      618       .
      619       release buf_cash-pay-attr no-error .
      620       if error-status:error then do:
      621         undo, return error return-value .
      622       end.
      623     end.
      624   end procedure.
      625   procedure cp-attr-exist :
      626     do
      627     on error undo, return error
      628     :
      629       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      630       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      631       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      632       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      633       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      634       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      635       define output parameter p-exist   as logical  no-undo .
      636       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      637       define variable v-type           as character no-undo .
      638       define variable v-format         as character no-undo .
      639       define variable v-label          as character no-undo .
      640       define variable v-range          as integer   no-undo .
      641       define variable v-user-can-edit  as logical   no-undo .
      642       define variable v-output-display as logical   no-undo .
      643       define variable v-other          as character no-undo .
      644       run cp-attr-code in this-procedure
      645         (input  p-code
      646         ,output v-type
      647         ,output v-format
      648         ,output v-label
      649         ,output v-range
      650         ,output v-user-can-edit
      651         ,output v-output-display
      652         ,output v-other
      653         ) no-error .
      654       if error-status :error then do:
      655         undo, return error return-value .
      656       end.
      657       find first buf_cash-pay-attr exclusive-lock
      658         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      659           and buf_cash-pay-attr.curr-code  = p-curr-code
      660           and buf_cash-pay-attr.host-code  = p-host-code
      661           and buf_cash-pay-attr.obj-type   = p-obj-type
      662           and buf_cash-pay-attr.obj-code   = p-obj-code
      663           and buf_cash-pay-attr.attr-code = p-code
      664         no-error .
      665       if  available buf_cash-pay-attr then do:
      666         p-exist = yes.
      667       end.
      668     end.
      669   end procedure.
      670   procedure cp-attr-delete :
      671     do
      672     on error undo, return error
      673     :
      674       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      675       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      676       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      677       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      678       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      679       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      680       define output parameter p-deleted  as logical no-undo.
      681       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      682       define variable v-type           as character no-undo .
      683       define variable v-format         as character no-undo .
      684       define variable v-label          as character no-undo .
      685       define variable v-range          as integer   no-undo .
      686       define variable v-user-can-edit  as logical   no-undo .
      687       define variable v-output-display as logical   no-undo .
      688       define variable v-other          as character no-undo .
      689       run cp-attr-code in this-procedure
      690         (input  p-code
      691         ,output v-type
      692         ,output v-format
      693         ,output v-label
      694         ,output v-range
      695         ,output v-user-can-edit
      696         ,output v-output-display
      697         ,output v-other
      698         ) no-error .
      699       if error-status :error then do:
      700         undo, return error return-value .
      701       end.
      702       find first buf_cash-pay-attr exclusive-lock
      703         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      704           and buf_cash-pay-attr.curr-code  = p-curr-code
      705           and buf_cash-pay-attr.host-code  = p-host-code
      706           and buf_cash-pay-attr.obj-type   = p-obj-type
      707           and buf_cash-pay-attr.obj-code   = p-obj-code
      708           and buf_cash-pay-attr.attr-code = p-code
      709         no-error NO-WAIT.
      710       if not available buf_cash-pay-attr then do:
      711         p-deleted = no.
      712       end.
      713       else do:
      714         delete buf_cash-pay-attr no-error .
      715         if error-status:error then do:
      716           undo, return error return-value .
      717         end.
      718         p-deleted = yes.
      719       end.
      720     end.
      721   end procedure.
      722   procedure cp-attr-news :
      723     do
      724     on error undo, return error
      725     :
      726       define input  parameter p-code           as character no-undo .
      727       define output parameter p-news           as logical   no-undo .
      728       case p-code :
      729               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
      730               when 'grp-code':U then do:     assign     p-news = true.   end.
      731               when 'is-use':U then do:     assign     p-news = true.   end.
      732               when 'dop-doc':U then do:     assign     p-news = true.   end.
      733               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
      734               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
      735               when 'form_km3':U then do:     assign     p-news = false.   end.
      736               when 'bal_malina':U then do:     assign     p-news = false.   end.
      737               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
      738               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
      739         otherwise do:
      740           p-news = no.
      741         end.
      742       end.
      743     end.
      744   end procedure.
      745   procedure cp-attr-hist :
      746     do
      747     on error undo, return error
      748     :
