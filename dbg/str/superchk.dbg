     5282       tt-chk-pay.pay-code:visible in browse br-pay = yes
     5283       tt-chk-pay.curr-code:visible in browse br-pay = yes
     5284       tt-chk-pay.pay-card:visible in browse br-pay = yes
     5285       tt-chk-pay.tot-sum:label in browse br-pay = "Сумма платежа"
     5286       b-addpay:visible = yes
     5287       .
