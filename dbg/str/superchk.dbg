     5406   ON CHOOSE OF MENU-ITEM m-gds
     5407   DO:
     5408     if not avail tt-chk-gds then return no-apply.
     5409     run proc-chg-gds in this-procedure no-error.
     5410     if error-status:error then return no-apply.
     5411   END.
     5412   ON CHOOSE OF MENU-ITEM m-modificator
     5413   DO:
     5414    DEFINE VARIABLE choice AS INTEGER NO-UNDO.
     5415    DEFINE BUFFER buf_tt-chk-gds FOR tt-chk-gds.
     5416       if not avail tt-chk-gds then return.
     5417     run gbl/d-askw.w ( input "Выбор кода списания",
     5418                         input "Установить признак МОДИФИКАТОРА С 0 ЦЕНОЙ на текущую товарную позицию",
     5419                         input "|",
     5420                         input "Нет|Да|Да+СПИСАНИЕ|Отказ",
     5421                         input "Не  установлен|МОДИФИКАТОР С 0-ЦЕНОЙ"
     5422                               + (if tt-chk-doc.chk-type = integer('96':U)
     5423                                  or tt-chk-doc.chk-type = integer('69':U)
     5424                                  then "^disable":U
     5425                                  else "":U)
     5426                               + "|МОДИФИКАТОР С 0-ценой+КОД СПИСАНИЯ|Отказ от установки кода списания",
     5427                         input 1,
     5428                         input 4,
     5429                         output choice).
     5430    IF choice = 4  THEN RETURN NO-APPLY.
     5431    FIND FIRST buf_tt-chk-gds EXCLUSIVE-LOCK WHERE
     5432           RECID(buf_tt-chk-gds) = recid(tt-chk-gds).
     5433    CASE choice:
     5434        WHEN 1 THEN DO:
     5435          ASSIGN
     5436          buf_tt-chk-gds.write-off-code = 0.
     5437        END.
     5438        WHEN 2 THEN DO:
     5439           CASE tt-chk-doc.chk-type:
     5440               WHEN INTEGER('1':U) THEN DO:
     5441                   ASSIGN
     5442                   buf_tt-chk-gds.write-off-code = INTEGER('2':U).
     5443               END.
     5444               WHEN INTEGER('6':U) THEN DO:
     5445                   ASSIGN
     5446                   buf_tt-chk-gds.write-off-code = INTEGER('-2':U).
     5447               END.
     5448               WHEN INTEGER('96':U) THEN DO:
     5449                   ASSIGN
     5450                   buf_tt-chk-gds.write-off-code = INTEGER('-4':U).
     5451               END.
     5452               WHEN INTEGER('69':U) THEN DO:
     5453                   ASSIGN
     5454                   buf_tt-chk-gds.write-off-code = INTEGER('3':U).
     5455               END.
     5456           END CASE.
     5457        END.
     5458        WHEN 3 THEN DO:
     5459           CASE tt-chk-doc.chk-type:
     5460               WHEN INTEGER('1':U) THEN DO:
     5461                   ASSIGN
     5462                   buf_tt-chk-gds.write-off-code = INTEGER('3':U).
     5463               END.
     5464               WHEN INTEGER('6':U) THEN DO:
     5465                   ASSIGN
     5466                   buf_tt-chk-gds.write-off-code = INTEGER('-3':U).
     5467               END.
     5468               WHEN INTEGER('96':U) THEN DO:
     5469                   ASSIGN
     5470                   buf_tt-chk-gds.write-off-code = INTEGER('-4':U).
     5471               END.
     5472           END CASE.
     5473      END.
     5474    END CASE.
     5475    run get-sums in this-procedure no-error .
     5476   display
     5477   tt-chk-doc.tot-doc
     5478   tt-chk-doc.discnt
     5479   tt-chk-doc.netto
     5480   tt-chk-doc.src-tot-doc
     5481   with frame Dialog-Frame.
     5482    br-gds:REFRESH()  IN FRAME Dialog-Frame.
     5483    apply "entry" to br-gds in frame Dialog-Frame.
     5484   END.
