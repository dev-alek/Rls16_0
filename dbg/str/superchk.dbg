     5536               recid(buf_staff) = integer(sale-list) no-error .
     5537     if not available buf_staff then return no-apply.
     5538     assign
     5539     tt-chk-gds.sales-man = buf_staff.staff-code + (if dflt-cd = 'MAGIA-XML':U then 10000 else 0)
     5540     tt-gds-info.salesman-name = get-salesman (input tt-chk-gds.sales-man, input tt-chk-doc.chk-date, output tt-chk-gds.salesman-psn-code)
     5541     .
