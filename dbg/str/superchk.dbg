    10295       tt-chk-doc.d-card when dc-change
    10296       tt-chk-doc.doc-num
    10297       tt-chk-doc.doc-num2
    10298       WITH FRAME Dialog-Frame.
    10299       hide
    10300       text-4
    10301       button-susp
    10302       v-susp-chk
    10303       v-link-chk
    10304       in frame Dialog-Frame .
    10305       assign
    10306       tt-chk-gds.src-code:read-only in browse br-gds = yes
    10307       tt-chk-gds.b-code:read-only in browse br-gds = yes
    10308       tt-chk-gds.pump:read-only in browse br-gds = yes
    10309       tt-chk-gds.src-price:read-only in browse br-gds = yes
    10310       tt-chk-gds.src-discnt:read-only in browse br-gds = yes
    10311       tt-chk-gds.src-qnty:read-only in browse br-gds = yes
    10312       tt-chk-gds.road-tax:read-only in browse br-gds = yes
    10313       tt-chk-gds.depart-id:read-only in browse br-gds = yes
    10314       tt-chk-pay.tot-sum:read-only in browse br-pay = (if tt-chk-doc.chk-type = integer('12':U)
    10315                                                        then no
    10316                                                        else yes)
    10317       tt-chk-pay.pay-card:read-only in browse br-pay = yes
    10318       tt-chk-pay.src-qnty:read-only in browse br-pay = yes
    10319       tt-chk-pay.src-val:read-only in browse br-pay= yes
    10320       tt-chk-discnt.real-value-abs:read-only in browse br-discnt = yes
    10321       tt-chk-discnt.real-value-pcnt:read-only in browse br-discnt = yes
    10322       b-addgds:label = "Товар"
    10323       .
    10324       if dflt-cd = 'NCR-GM':U
    10325       or dflt-cd = 'NCR-AS@R':U
    10326       then do:
    10327         assign
    10328         tt-chk-gds.src-discnt:read-only in browse br-gds = yes
    10329         .
    10330       end.
    10331     END.
    10332   end case.
    10333   IF par-mode <> 'ДОБАВЛЕНИЕ':U
    10334   or not get-chkc_context.is-catering
    10335   THEN DO:
    10336       menu-item m-write-off:sensitive in menu M-prt = no.
    10337       menu-item m-modificator:sensitive in menu M-prt = no.
    10338   END.
    10339   if par-mode <> 'ДОБАВЛЕНИЕ':U
    10340   then do:
    10341     menu-item m-sales-man:sensitive in menu m-prt = no.
    10342   end.
    10343   if not cas-shft then do:
    10344       hide
    10345       tt-chk-doc.src-shift-date
    10346       tt-chk-doc.shift-num
    10347       tt-chk-doc.shift-name
    10348       in frame Dialog-Frame.
    10349   end.
    10350   if not actn#log_bonus then do:
    10351     disable  tt-chk-doc.d-card v-src-d-card B-card with frame Dialog-Frame .
    10352   end.
    10353   b-adddiscnt:POPUP-MENU IN FRAME Dialog-Frame = ?.
    10354   b-addbonus:POPUP-MENU IN FRAME Dialog-Frame = ?.
    10355   VIEW FRAME Dialog-Frame.
    10356   CASE par-mode:     WHEN 'ДОБАВЛЕНИЕ':U     OR     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:        IF dflt-cd = 'MAGIA-XML':U THEN OPEN QUERY BR-gds FOR EACH tt-chk-gds       WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,              FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by abs(tt-chk-gds.line-num).     ELSE     OPEN QUERY BR-gds FOR EACH tt-chk-gds           WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                  FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by tt-chk-gds.line-num.      END.     WHEN 'ПРОСМОТР':U or when "susp-type" THEN DO:            IF dflt-cd = 'MAGIA-XML':U THEN         OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK             WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                      FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num             by abs(tt-chk-gds.line-num).          ELSE             OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK                 WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                          FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num                 by tt-chk-gds.line-num.      END. END CASE.
    10357   CASE par-mode:   WHEN 'ДОБАВЛЕНИЕ':U   OR   WHEN 'ИЗМЕНЕНИЕ':U  THEN DO:      OPEN QUERY BR-pay FOR EACH  tt-chk-pay          WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code ,            first tt-pay-info no-lock where tt-pay-info.line-num = tt-chk-pay.line-num          by tt-chk-pay.line-num.  END.   WHEN 'ПРОСМОТР':U or when "susp-type" THEN DO:      OPEN QUERY BR-pay FOR EACH  tt-chk-pay          WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code ,            first tt-pay-info no-lock where tt-pay-info.line-num = tt-chk-pay.line-num          by tt-chk-pay.line-num.  END. END CASE.
    10358   CASE par-mode:   WHEN 'ДОБАВЛЕНИЕ':U OR WHEN 'ИЗМЕНЕНИЕ':U THEN DO:     OPEN QUERY BR-discnt FOR EACH tt-chk-discnt WHERE            tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type         by tt-chk-discnt.line-num.   END.    WHEN  'ПРОСМОТР':U or when "susp-type" THEN DO:        OPEN QUERY BR-discnt FOR EACH tt-chk-discnt NO-LOCK              WHERE tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type            by tt-chk-discnt.line-num.     END. END CASE.
    10359   hide br-discnt in frame Dialog-Frame.
    10360   IF b-cf:SENSITIVE IN FRAME Dialog-Frame = NO THEN HIDE
    10361   b-cf IN FRAME Dialog-Frame.
    10362   hide BR-corr in frame Dialog-Frame.
    10363   hide v-corr-osnov v-corr-type in frame Dialog-Frame.
    10364   if tt-chk-doc.chk-type = integer('43':U)
    10365   or tt-chk-doc.chk-type = integer('44':U)
    10366   then do :
    10367     v-corr-osnov = tt-chk-doc.doc-num .
    10368     if num-entries(tt-chk-doc.doc-num2, ":") = 2
    10369     then do :
    10370       if entry(1, tt-chk-doc.doc-num2, ":") = "0"
    10371       then v-corr-type = "самостоятельно" .
    10372       else
    10373       if entry(1, tt-chk-doc.doc-num2, ":") = "1"
    10374       then v-corr-type = "по предписанию" .
    10375       else
    10376       v-corr-type = "неизвестн." .
    10377     end.
    10378     else
    10379     v-corr-type = "неизвестн." .
    10380     hide BR-gds in frame Dialog-Frame.
    10381     open query br-corr for each tt-chk-gds WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code .
    10382     display BR-corr v-corr-osnov v-corr-type with frame Dialog-Frame.
    10383     enable BR-corr with frame Dialog-Frame.
    10384     hide tt-chk-doc.doc-num2 tt-chk-doc.doc-num in frame Dialog-Frame.
    10385   end.
    10386       if par-mode <> "susp-type" then
    10387       do:
    10388           for first buf_chk-doc-attr where buf_chk-doc-attr.doc-code = tt-chk-doc.doc-code
    10389               and buf_chk-doc-attr.attr-code = "corr-osnov":
    10390               v-corr-osnov1 = integer(buf_chk-doc-attr.attr-value).
    10391               v-doc-osnov = OsnovCorr(v-corr-osnov1) .
    10392           end.
    10393           for first buf_chk-doc-attr where buf_chk-doc-attr.doc-code = tt-chk-doc.doc-code
    10394               and buf_chk-doc-attr.attr-code = "corr-date":
    10395               corr-date = date(buf_chk-doc-attr.attr-value) .
    10396           end.
    10397           for first buf_chk-doc-attr where buf_chk-doc-attr.doc-code = tt-chk-doc.doc-code
    10398               and buf_chk-doc-attr.attr-code = "corr-num":
    10399               f-num-corr = buf_chk-doc-attr.attr-value .
    10400           end.
    10401           for first buf_chk-doc-attr where buf_chk-doc-attr.doc-code = tt-chk-doc.doc-code
    10402               and buf_chk-doc-attr.attr-code = "corr-cause":
    10403               f-cause-corr = buf_chk-doc-attr.attr-value .
    10404           end.
    10405           display
    10406               text-1
    10407               v-doc-osnov
    10408               corr-date
    10409               f-cause-corr
    10410               f-num-corr
    10411               with frame Dialog-Frame .
    10412           hide
    10413               text-4
    10414               button-susp
    10415               v-susp-chk
    10416               v-link-chk
    10417               in frame Dialog-Frame .
    10418       end.
    10419       else
    10420       do:
    10421           for first ub.susp-chk no-lock where ub.susp-chk.doc-code = tt-chk-doc.doc-code:
    10422               v-susp-chk = ub.susp-chk.reason-name .
    10423               v-link-chk = ub.susp-chk.link-chk .
    10424           end.
    10425           hide
    10426               text-1
    10427               v-doc-osnov
    10428               corr-date
    10429               f-cause-corr
    10430               f-num-corr
    10431               button-1
    10432               b-choose-date
    10433               in frame Dialog-Frame .
    10434           display text-4 v-susp-chk v-link-chk with frame Dialog-Frame .
    10435           enable
    10436               button-susp
    10437               v-susp-chk
    10438               v-link-chk
    10439               b-exit
    10440               with frame Dialog-Frame .
    10441               v-susp-chk:read-only = true .
    10442       end.
    10443   for each tt-gds-info no-lock:
    10444   EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(tt-chk-doc.obj-type, tt-chk-doc.obj-code) no-error.
    10445         RUN gds-attr-value (
    10446                             INPUT tt-gds-info.gds-code,
    10447                             INPUT 'mark-type':U,
    10448                             OUTPUT v-gds-attr-value,
    10449                             OUTPUT v-gds-attr-type
    10450                             ).
    10451         if v-gds-attr-value > ""
    10452         and EDOParSec:GetIsMarkingForType(v-gds-attr-value)
    10453         then do :
    10454         enable
    10455         B_mark
    10456         with frame Dialog-Frame .
    10457         leave .
    10458         end.
    10459   end.
    10460   END PROCEDURE.
    10461   PROCEDURE pays-display :
    10462   DEFINE INPUT PARAMETER p-change-curr as logical no-undo.
    10463   DEFINE VARIABLE curr-rate                  like ub.curr-shop.exch-rate   no-undo .
    10464   DEFINE VARIABLE curr-scale                 like ub.curr-shop.exch-scale  no-undo .
    10465   FIND FIRST ub.cash-pay WHERE
    10466             ub.cash-pay.cdpay-code = tt-chk-pay.pay-code AND
    10467             ub.cash-pay.curr-code = tt-chk-pay.curr-code NO-LOCK NO-ERROR.
    10468   if NOT available ub.cash-pay
    10469   AND tt-chk-doc.chk-type <> INTEGER('12':U) then do:
    10470     assign
    10471     tt-chk-pay.is-error = yes
    10472     .
    10473   end.
    10474   CASE ABS(tt-chk-pay.curr-code):
    10475     when 0 then do:
    10476       assign
    10477       tt-chk-pay.tot-rubl = tt-chk-pay.tot-sum
    10478       .
    10479       if get-chkc_context.cas-curs then do:
    10480         assign
    10481         tt-chk-pay.tot-base = tt-chk-pay.tot-sum / tt-chk-pay.cash-rate
    10482         .
    10483         run find-curs in this-procedure
    10484                           (
    10485                            input tt-chk-doc.chk-date
    10486                           ,input tt-chk-doc.chk-time
    10487                           ,input get-chkc_context.base-code
    10488                           ,output tt-pay-info.exch-rate
    10489                           ,output tt-pay-info.exch-scale
    10490                           ,output tt-pay-info.exch-date
    10491                           ,output tt-pay-info.exch-time
    10492                           )  no-error.
    10493       end.
    10494       else do:
    10495         run find-curs in this-procedure
    10496                           (
    10497                            input tt-chk-doc.chk-date
    10498                           ,input tt-chk-doc.chk-time
    10499                           ,input get-chkc_context.base-code
    10500                           ,output cash-rate_
    10501                           ,output cash-scale_
    10502                           ,output tt-pay-info.exch-date
    10503                           ,output tt-pay-info.exch-time
    10504                           )  no-error.
    10505         assign
    10506         tt-chk-pay.is-error = error-status:error
    10507         tt-chk-pay.tot-base = tt-chk-pay.tot-sum / cash-rate_ * cash-scale_
    10508         tt-pay-info.exch-rate = cash-rate_
    10509         tt-pay-info.exch-scale = cash-scale_
    10510         .
    10511       end.
    10512     end.
    10513     when get-chkc_context.base-code then do:
    10514       assign
    10515       tt-chk-pay.tot-base = tt-chk-pay.tot-sum
    10516       .
    10517       if cas-curs then do:
    10518         assign
    10519         tt-chk-pay.tot-rubl = if get-chkc_context.r-b = 'base':U
    10520                             then tt-chk-pay.tot-sum * tt-chk-doc.cash-rate
    10521                             else tt-chk-pay.tot-sum / tt-chk-pay.cash-rate
    10522         .
    10523         run find-curs in this-procedure
    10524                           (
    10525                            input tt-chk-doc.chk-date
    10526                           ,input tt-chk-doc.chk-time
    10527                           ,input get-chkc_context.base-code
    10528                           ,output tt-pay-info.exch-rate
    10529                           ,output tt-pay-info.exch-scale
    10530                           ,output tt-pay-info.exch-date
    10531                           ,output tt-pay-info.exch-time
    10532                           )  no-error.
    10533       end.
    10534       else do:
    10535               run find-curs in this-procedure
    10536                                 (
    10537                                  input tt-chk-doc.chk-date
    10538                                 ,input tt-chk-doc.chk-time
    10539                                 ,input get-chkc_context.base-code
    10540                                 ,output cash-rate_
    10541                                 ,output cash-scale_
    10542                                 ,output exch-date_
    10543                                 ,output exch-time_
    10544                                 )  no-error.
    10545           assign
    10546           tt-chk-pay.is-error = error-status:error
    10547           tt-chk-pay.tot-rubl = tt-chk-pay.tot-sum * cash-rate_ / cash-scale_
    10548           tt-pay-info.exch-rate = cash-rate_
    10549           tt-pay-info.exch-scale = cash-scale_
    10550           .
    10551       end.
    10552     end.
    10553     otherwise do:
    10554       if cas-curs then do:
    10555         assign
    10556         tt-chk-pay.tot-base = if get-chkc_context.r-b = 'base':U
    10557                            then tt-chk-pay.tot-sum / tt-chk-pay.cash-rate
    10558                            else tt-chk-pay.tot-base
    10559                             tt-chk-pay.tot-rubl = if get-chkc_context.r-b = 'base':U
    10560                            then tt-chk-pay.tot-sum / cass-rate * tt-chk-doc.cash-rate
    10561                            else tt-chk-pay.tot-sum / tt-chk-pay.cash-rate
    10562         .
    10563         if not get-chkc_context.r-b = 'base':U then do:
    10564                   run find-curs in this-procedure
    10565                             (
    10566                              input tt-chk-doc.chk-date
    10567                             ,input tt-chk-doc.chk-time
    10568                             ,input get-chkc_context.base-code
    10569                             ,output cash-rate_
    10570                             ,output cash-scale_
    10571                             ,output exch-date_
    10572                             ,output exch-time_
    10573                             )  no-error.
    10574             assign
    10575             tt-chk-pay.is-error = error-status:error
    10576             tt-chk-pay.tot-base = tt-chk-pay.tot-sum * cash-rate_ / cash-scale_
    10577             .
    10578         end.
    10579         run find-curs in this-procedure
    10580                             (
    10581                             input tt-chk-doc.chk-date
    10582                             ,input tt-chk-doc.chk-time
    10583                             ,input tt-chk-pay.curr-code
    10584                             ,output tt-pay-info.exch-rate
    10585                             ,output tt-pay-info.exch-scale
    10586                             ,output tt-pay-info.exch-date
    10587                             ,output tt-pay-info.exch-time
    10588                             )  no-error.
    10589       end.
    10590       else do:
    10591           run find-curs in this-procedure
    10592                 (
    10593                  input tt-chk-doc.chk-date
    10594                 ,input tt-chk-doc.chk-time
    10595                 ,input tt-chk-pay.curr-code
    10596                 ,output cash-rate_
    10597                 ,output cash-scale_
    10598                 ,output tt-pay-info.exch-date
    10599                 ,output tt-pay-info.exch-time
    10600                 )  no-error.
    10601           assign
    10602           tt-chk-pay.is-error = error-status:error
    10603           tt-chk-pay.tot-rubl = tt-chk-pay.tot-sum * cash-rate_ / cash-scale_
    10604           tt-pay-info.exch-rate = cash-rate_
    10605           tt-pay-info.exch-scale = cash-scale_
    10606           curr-rate = cash-rate_
    10607           curr-scale = cash-scale_
    10608           .
    10609                       run find-curs in this-procedure
    10610                             (
    10611                              input tt-chk-doc.chk-date
    10612                             ,input tt-chk-doc.chk-time
    10613                             ,input get-chkc_context.base-code
    10614                             ,output cash-rate_
    10615                             ,output cash-scale_
    10616                             ,output exch-date_
    10617                             ,output exch-time_
    10618                             )  no-error.
    10619             assign
    10620             tt-chk-pay.is-error = error-status:error
    10621             tt-chk-pay.tot-base = tt-chk-pay.tot-sum * (curr-rate / curr-scale)  /
    10622                                cash-rate_ * cash-scale_
    10623             .
    10624       end.
    10625     end.
    10626   END CASE.
    10627   assign
    10628   tt-pay-info.calc-rate = tt-chk-pay.tot-rubl / tt-chk-pay.tot-sum
    10629   tt-pay-info.exch-time-str = string(tt-pay-info.exch-time, "hh:mm:ss").
    10630   .
    10631   display
    10632   tt-chk-pay.tot-sum
    10633   tt-chk-pay.tot-base
    10634   tt-chk-pay.tot-rubl
    10635   tt-chk-pay.cash-rate
    10636   tt-pay-info.calc-rate
    10637   tt-pay-info.exch-date
    10638   tt-pay-info.exch-time-str
    10639   tt-pay-info.exch-rate
    10640   tt-pay-info.exch-scale
    10641   with browse br-pay.
    10642   glog = br-pay:refresh() in frame Dialog-Frame.
    10643   END PROCEDURE.
    10644   PROCEDURE proc-b-addbonus :
    10645   define variable v-line-num AS integer NO-UNDO.
    10646   define variable v-src-d-card AS character NO-UNDO.
    10647   define variable v-discnt-type as integer no-undo .
    10648   define variable v-discnt-id AS integer NO-UNDO.
    10649   define variable v-kateg AS integer NO-UNDO.
    10650   define variable v-updated AS LOGICAL NO-UNDO.
    10651   define buffer loc_tt-chk-discnt for tt-chk-discnt.
    10652   define buffer buf_tt-chk-discnt for tt-chk-discnt.
    10653   define buffer last-tt-chk-gds for tt-chk-gds.
    10654   if not actn#log_bonus then do:
    10655     message "Отсутствует право: Редактирование бонусов, скидок и ДК в чеках"
    10656     view-as alert-box.
    10657     return.
    10658   end.
    10659   if v-br-discnt-current-type = 4 then do:
    10660     if available tt-chk-discnt THEN DO:
    10661        RUN proc-leave-discnt-abs in THIS-PROCEDURE ( input integer('2':U)).
    10662     END.
    10663   end.
    10664   if not br-discnt:visible in frame Dialog-Frame
    10665   OR v-br-discnt-current-type = 0
    10666   then do:
    10667       ASSIGN
    10668       v-br-discnt-current-type = 4.
    10669       hide br-gds in frame Dialog-Frame.
    10670       display br-discnt with frame Dialog-Frame.
    10671       ASSIGN
    10672       b-addgds:label = "Товары"
    10673       b-adddiscnt:label = "Скидки"
    10674       tt-chk-discnt.src-d-card:VISIBLE IN BROWSE br-discnt = YES
    10675       tt-chk-discnt.discnt-id:VISIBLE IN BROWSE br-discnt = YES
    10676       tt-chk-discnt.kateg:VISIBLE IN BROWSE br-discnt = YES
    10677       v-br-discnt-current-type = 4
    10678       .
    10679       run diasize_restore-orig-size in this-procedure .
    10680       run diasize_set-browse-handle in this-procedure
    10681         (input browse br-discnt :handle
    10682         ) .
    10683       run diasize_add_browse in this-procedure
    10684         (input  'width':u
    10685         ,input  browse BR-pay :handle
    10686         ) .
    10687       run diasize_restore-current-size in this-procedure .
    10688       CASE par-mode:   WHEN 'ДОБАВЛЕНИЕ':U OR WHEN 'ИЗМЕНЕНИЕ':U THEN DO:     OPEN QUERY BR-discnt FOR EACH tt-chk-discnt WHERE            tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type         by tt-chk-discnt.line-num.   END.    WHEN  'ПРОСМОТР':U or when "susp-type" THEN DO:        OPEN QUERY BR-discnt FOR EACH tt-chk-discnt NO-LOCK              WHERE tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type            by tt-chk-discnt.line-num.     END. END CASE.
    10689        if par-mode = 'ДОБАВЛЕНИЕ':U then do:
    10690           assign
    10691           b-addbonus:POPUP-MENU IN FRAME Dialog-Frame = menu MENU-b-addbonus:handle
    10692           b-addbonus:MENU-MOUSE = 1
    10693           b-addbonus:label = "Добавить Бoнус"
    10694           b-adddiscnt:popup-menu = ?
    10695           .
    10696       end.
    10697       if par-mode = 'ПРОСМОТР':U or par-mode = "susp-type" then do:
    10698         ENABLE
    10699         b-addgds
    10700         b-adddiscnt
    10701         with frame Dialog-Frame.
    10702         DISABLE
    10703         b-addbonus
    10704         with frame Dialog-Frame.
    10705       end.
    10706       return.
    10707   end.
    10708   if not par-mode = 'ДОБАВЛЕНИЕ':U then return.
    10709   if discnt-option = "":U then do:
    10710     run gbl/pop-up.p ( input self:handle, input no) no-error.
    10711   end.
    10712   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
    10713     run str/add-bon.w ( input parparentproc
    10714                    ,input par-mode
    10715                    ,input-output v-line-num
    10716                    ,input-output v-src-d-card
    10717                    ,input-output v-discnt-type
    10718                    ,input-output v-discnt-id
    10719                    ,input-output v-kateg
    10720                    ,output v-updated ) no-error.
    10721    if not v-updated then return error.
    10722     find first buf_tt-chk-discnt no-lock where
    10723               buf_tt-chk-discnt.doc-code = tt-chk-doc.doc-code
    10724           and buf_tt-chk-discnt.record-type = 4
    10725           and buf_tt-chk-discnt.discnt-id = v-discnt-id
    10726           and buf_tt-chk-discnt.line-num = v-line-num
    10727           no-error.
    10728     if available buf_tt-chk-discnt then do:
    10729       message
    10730       "В данном чеке уже есть строка начисления бонуса с таким номером внешней транзакции"
    10731       view-as alert-box error .
    10732       undo, return error.
    10733     end.
    10734   end.
    10735   if integer(entry(1, discnt-option)) = integer('2':U)
    10736   and v-line-num = 0 then do:
    10737     message "Нельзя начислять бонус на подитог сразу после шапки чека"
    10738     view-as alert-box ERROR.
    10739     return error.
    10740   end.
    10741   find last tt-chk-discnt where
    10742                      tt-chk-discnt.doc-code = tt-chk-doc.doc-code and
    10743             tt-chk-discnt.record-type = 4 no-error.
    10744   assign
    10745   var-discnt-id = if avail tt-chk-discnt
    10746                         then tt-chk-discnt.discnt-id
    10747                         else 0
    10748   .
    10749   find first last-tt-chk-gds where
    10750                last-tt-chk-gds.doc-code = tt-chk-doc.doc-code and
    10751                last-tt-chk-gds.line-num = v-line-num no-error.
    10752   if not avail last-tt-chk-gds then do:
    10753       message "В чеке нет строчки с номером" v-line-num
    10754       view-as alert-box ERROR.
    10755       return error.
    10756   end.
    10757   create tt-chk-discnt.
    10758   assign
    10759   tt-chk-discnt.doc-code = tt-chk-doc.doc-code
    10760   tt-chk-discnt.line-num = v-line-num
    10761   tt-chk-discnt.record-type = 4
    10762   tt-chk-discnt.discnt-id = v-discnt-id
    10763   tt-chk-discnt.line-type = integer(entry(1, discnt-option))
    10764   tt-chk-discnt.pass-discnt = integer('1':U)
    10765   tt-chk-discnt.value-type = integer(entry(2, discnt-option))
    10766   tt-chk-discnt.discnt-type = v-discnt-type
    10767   tt-chk-discnt.src-d-card = v-src-d-card
    10768   tt-chk-discnt.d-card = v-src-d-card
    10769   tt-chk-discnt.kateg = v-kateg
    10770   tt-chk-discnt.discnt-value-abs = 0
    10771   tt-chk-discnt.discnt-value-pcnt  = 0
    10772   tt-chk-discnt.object-line-num = tt-chk-discnt.line-num
    10773   var-discnt-id = var-discnt-id + 1
    10774   .
    10775   create locked_chk-discnt.
    10776   buffer-copy tt-chk-discnt to locked_chk-discnt.
    10777   discnt-option = "":U.
    10778   CASE par-mode:   WHEN 'ДОБАВЛЕНИЕ':U OR WHEN 'ИЗМЕНЕНИЕ':U THEN DO:     OPEN QUERY BR-discnt FOR EACH tt-chk-discnt WHERE            tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type         by tt-chk-discnt.line-num.   END.    WHEN  'ПРОСМОТР':U or when "susp-type" THEN DO:        OPEN QUERY BR-discnt FOR EACH tt-chk-discnt NO-LOCK              WHERE tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type            by tt-chk-discnt.line-num.     END. END CASE.
    10779       find first loc_tt-chk-discnt WHERE
    10780                  loc_tt-chk-discnt.doc-code = tt-chk-doc.doc-code
    10781              AND loc_tt-chk-discnt.discnt-id = v-discnt-id
    10782              AND loc_tt-chk-discnt.record-type = 4 NO-LOCK NO-ERROR.
    10783       IF avail loc_tt-chk-discnt then do:
    10784         reposition br-discnt to recid recid(loc_tt-chk-discnt).
    10785       end.
    10786     apply "entry" to br-discnt in frame Dialog-Frame .
    10787   END PROCEDURE.
    10788   PROCEDURE proc-b-adddiscnt :
    10789   define variable var-line-num as character no-undo.
    10790   define variable v-wro-code as integer no-undo .
    10791   define buffer loc_tt-chk-discnt for tt-chk-discnt.
    10792   define buffer last-tt-chk-gds for tt-chk-gds.
    10793   if not actn#log_bonus then do:
    10794     message "Отсутствует право: Редактирование бонусов, скидок и ДК в чеках"
    10795     view-as alert-box.
    10796     return.
    10797   end.
    10798   if v-br-discnt-current-type = 0 then do:
    10799     if available tt-chk-discnt THEN DO:
    10800        RUN proc-leave-discnt-abs in THIS-PROCEDURE (input (if tt-chk-discnt.value-type = integer('2':U)
    10801                                                           then integer('2':U)
    10802                                                           else integer('1':U))).
    10803     END.
    10804   end.
    10805   if not br-discnt:visible in frame Dialog-Frame
    10806   OR v-br-discnt-current-type = 4
    10807   then do:
    10808       ASSIGN
    10809       v-br-discnt-current-type = 0.
    10810       hide br-gds in frame Dialog-Frame.
    10811       display br-discnt with frame Dialog-Frame.
    10812       ASSIGN
    10813       b-addgds:label = "Товары"
    10814       b-addbonus:LABEL = "Бонусы"
    10815       tt-chk-discnt.src-d-card:VISIBLE IN BROWSE br-discnt = NO
    10816       tt-chk-discnt.discnt-id:VISIBLE IN BROWSE br-discnt = NO
    10817       tt-chk-discnt.kateg:VISIBLE IN BROWSE br-discnt = NO
    10818       v-br-discnt-current-type = 0
    10819       .
    10820       run diasize_restore-orig-size in this-procedure .
    10821       run diasize_set-browse-handle in this-procedure
    10822         (input browse br-discnt :handle
    10823         ) .
    10824       run diasize_add_browse in this-procedure
    10825         (input  'width':u
    10826         ,input  browse BR-pay :handle
    10827         ) .
    10828       run diasize_restore-current-size in this-procedure .
    10829       CASE par-mode:   WHEN 'ДОБАВЛЕНИЕ':U OR WHEN 'ИЗМЕНЕНИЕ':U THEN DO:     OPEN QUERY BR-discnt FOR EACH tt-chk-discnt WHERE            tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type         by tt-chk-discnt.line-num.   END.    WHEN  'ПРОСМОТР':U or when "susp-type" THEN DO:        OPEN QUERY BR-discnt FOR EACH tt-chk-discnt NO-LOCK              WHERE tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type            by tt-chk-discnt.line-num.     END. END CASE.
    10830        if par-mode = 'ДОБАВЛЕНИЕ':U then do:
    10831           assign
    10832           b-adddiscnt:POPUP-MENU IN FRAME Dialog-Frame = menu MENU-B-adddiscnt:handle
    10833           b-adddiscnt:MENU-MOUSE = 1
    10834           b-adddiscnt:label = "Добавить скидку"
    10835           b-addbonus:popup-menu = ?
    10836           .
    10837       end.
    10838       if par-mode = 'ПРОСМОТР':U or par-mode = "susp-type" then do:
    10839         ENABLE
    10840         b-addgds
    10841         b-addbonus
    10842         with frame Dialog-Frame.
    10843         DISABLE
    10844         b-adddiscnt
    10845         with frame Dialog-Frame.
    10846         b-addbonus:popup-menu = ?.
    10847       end.
    10848       return.
    10849   end.
    10850   if not par-mode = 'ДОБАВЛЕНИЕ':U then return.
    10851   if discnt-option = "":U then do:
    10852     run gbl/pop-up.p ( input self:handle, input no) no-error.
    10853   end.
    10854   if tt-chk-doc.src-d-pcnt <> 0 then do:
    10855     if lookup('2':U, discnt-option) > 0 then do:
    10856       message
    10857       "В данном чеке будут одновременно выставлены:" SKIp
    10858       "% скидка на товары клиента и абсолютная скидка на итог" skip
    10859       "По правилам разбора чека до тех пор, пока в чеке есть абсолютная скидка на итог,"
    10860       "% скидка на товары будет иметь только информационное значение " skip
    10861       "и не будет применяться к товарам чека"
    10862       view-as alert-box WARNING.
    10863     end.
    10864   end.
    10865   run gbl/d-prompt.w (
    10866       ('title=':u + "Введите номер строки, после которой была начислена скидка" + '\':u
    10867     + 'text1=':u + "Номер строки" + '\':u
    10868     + 'format=' + ">9" + '\':u
    10869     + 'type=int\':u
    10870     + 'fillin_row=2\':u
    10871     + 'fillin_col=4\':u
    10872     + 'fillin_width=4\':u
    10873     + 'fillin_height=1\':u
    10874     + 'max-chars=70\':u
    10875     + 'readonly=no\':u)
    10876     ,input-output var-line-num
    10877     ).
    10878   if return-value = 'false':u then do:
    10879     return error.
    10880   end.
    10881   if integer(entry(1, discnt-option)) = integer('2':U)
    10882   and integer(var-line-num) = 0 then do:
    10883     message "Нельзя начислять скидку на подитог сразу после шапки чека"
    10884     view-as alert-box ERROR.
    10885     return error.
    10886   end.
    10887   find last tt-chk-discnt where
    10888                      tt-chk-discnt.doc-code = tt-chk-doc.doc-code and
    10889             tt-chk-discnt.record-type = 0 no-error.
    10890   assign
    10891   var-discnt-id = if avail tt-chk-discnt
    10892                         then tt-chk-discnt.discnt-id
    10893                         else 0
    10894   .
    10895   find first last-tt-chk-gds where
    10896                last-tt-chk-gds.doc-code = tt-chk-doc.doc-code and
    10897                last-tt-chk-gds.line-num = integer(var-line-num) no-error.
    10898   if not avail last-tt-chk-gds then do:
    10899       message "В чеке нет строчки с номером" var-line-num
    10900       view-as alert-box ERROR.
    10901       return error.
    10902   end.
    10903   create tt-chk-discnt.
    10904   assign
    10905   tt-chk-discnt.doc-code = tt-chk-doc.doc-code
    10906   tt-chk-discnt.line-num = integer(var-line-num)
    10907   tt-chk-discnt.record-type = 0
    10908   tt-chk-discnt.discnt-id = var-discnt-id + 1
    10909   tt-chk-discnt.line-type = integer(entry(1, discnt-option))
    10910   tt-chk-discnt.pass-discnt = integer('1':U)
    10911   tt-chk-discnt.value-type = integer(entry(2, discnt-option))
    10912   tt-chk-discnt.discnt-type = integer('0':U)
    10913   tt-chk-discnt.d-card = "":U
    10914   tt-chk-discnt.discnt-value-abs = 0
    10915   tt-chk-discnt.discnt-value-pcnt  = 0
    10916   tt-chk-discnt.object-line-num = (if tt-chk-discnt.line-type = integer('1':U)
    10917                                    then  tt-chk-discnt.line-num
    10918                                    else 0)
    10919   var-discnt-id = var-discnt-id + 1
    10920   .
    10921   if tt-chk-discnt.line-type = integer('2':U)  then do:
    10922     assign
    10923     v-is-sub-d = yes
    10924     .
    10925   end.
    10926   create locked_chk-discnt.
    10927   buffer-copy tt-chk-discnt to locked_chk-discnt.
    10928   discnt-option = "":U.
    10929   CASE par-mode:   WHEN 'ДОБАВЛЕНИЕ':U OR WHEN 'ИЗМЕНЕНИЕ':U THEN DO:     OPEN QUERY BR-discnt FOR EACH tt-chk-discnt WHERE            tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type         by tt-chk-discnt.line-num.   END.    WHEN  'ПРОСМОТР':U or when "susp-type" THEN DO:        OPEN QUERY BR-discnt FOR EACH tt-chk-discnt NO-LOCK              WHERE tt-chk-discnt.doc-code = tt-chk-doc.doc-code            AND tt-chk-discnt.record-type = v-br-discnt-current-type            by tt-chk-discnt.line-num.     END. END CASE.
    10930       find first loc_tt-chk-discnt WHERE
    10931                  loc_tt-chk-discnt.doc-code = tt-chk-doc.doc-code
    10932              AND loc_tt-chk-discnt.discnt-value-abs = 0
    10933              AND loc_tt-chk-discnt.record-type = 0
    10934       NO-LOCK NO-ERROR.
    10935       IF avail loc_tt-chk-discnt then do:
    10936         reposition br-discnt to recid recid(loc_tt-chk-discnt).
    10937       end.
    10938     apply "entry" to br-discnt in frame Dialog-Frame .
    10939   END PROCEDURE.
    10940   PROCEDURE proc-b-addgds :
    10941   define variable varrid-list as character no-undo.
    10942   define variable ii as integer no-undo.
    10943   DEFINE VARIABLE varline-rid as recid  no-undo.
    10944   define variable v-wro-code as integer no-undo .
    10945   define variable v-mark as character no-undo .
    10946   define variable v-ok as logical no-undo .
    10947   define variable v-b-code like ub.bar-code.b-code no-undo .
    10948   define buffer lng_chk-gds for ub.chk-gds.
    10949   define buffer loc_tt-chk-gds for tt-chk-gds.
    10950   define buffer loc_bar-code for ub.bar-code.
    10951   define buffer loc_goods for ub.goods.
    10952   if not br-gds:visible in frame Dialog-Frame
    10953   then do:
    10954       hide br-discnt in frame Dialog-Frame.
    10955       display
    10956       br-gds with frame Dialog-Frame.
    10957       run diasize_restore-orig-size in this-procedure .
    10958       run diasize_set-browse-handle in this-procedure
    10959         (input browse br-gds :handle
    10960         ) .
    10961       run diasize_add_browse in this-procedure
    10962         (input  'width':u
    10963         ,input  browse BR-pay :handle
    10964         ) .
    10965       run diasize_restore-current-size in this-procedure .
    10966       assign
    10967       b-adddiscnt:POPUP-MENU IN FRAME Dialog-Frame = ?
    10968       b-addbonus:POPUP-MENU IN FRAME Dialog-Frame = ?
    10969       b-addgds:label = if par-mode = 'ДОБАВЛЕНИЕ':U then "Добавить товар" else b-addgds:label
    10970       b-adddiscnt:label = "Скидки"
    10971       b-addbonus:LABEL = "Бонусы"
    10972       .
    10973       if par-mode = 'ПРОСМОТР':U or par-mode = "susp-type" then do:
    10974         ENABLE
    10975         b-adddiscnt
    10976         b-addbonus
    10977         with frame Dialog-Frame.
    10978         DISABLE
    10979         b-addgds
    10980         with frame Dialog-Frame.
    10981       end.
    10982       CASE par-mode:     WHEN 'ДОБАВЛЕНИЕ':U     OR     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:        IF dflt-cd = 'MAGIA-XML':U THEN OPEN QUERY BR-gds FOR EACH tt-chk-gds       WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,              FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by abs(tt-chk-gds.line-num).     ELSE     OPEN QUERY BR-gds FOR EACH tt-chk-gds           WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                  FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by tt-chk-gds.line-num.      END.     WHEN 'ПРОСМОТР':U or when "susp-type" THEN DO:            IF dflt-cd = 'MAGIA-XML':U THEN         OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK             WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                      FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num             by abs(tt-chk-gds.line-num).          ELSE             OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK                 WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                          FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num                 by tt-chk-gds.line-num.      END. END CASE.
    10983       return.
    10984   end.
    10985   if not par-mode = 'ДОБАВЛЕНИЕ':U then return.
    10986   varrid-list = "" .
    10987   run ref/gds-ref.p (
    10988                    input parparentproc
    10989                   ,input "b-sel,b-mark"
    10990                   ,input ?
    10991                   ,input ?
    10992                   ,input ?
    10993                   ,input ?
    10994                   ,input ?
    10995                   ,input ?
    10996                   ,input ?
    10997                   ,input tt-chk-doc.obj-type
    10998                   ,input tt-chk-doc.obj-code
    10999                   ,input ?
    11000                 , output varrid-list ).
    11001   if varrid-list = "" then return error.
    11002   ii = 1.
    11003   FIND LAST lng_chk-gds No-LOCK WHERE
    11004             lng_chk-gds.doc-code = TT-CHK-doc.doc-code
    11005             USE-INDEX ln NO-ERROR.
    11006    if avail lng_chk-gds then lng = lng_chk-gds.line-num.
    11007    else lng = 0.
    11008    _ii:
    11009    DO WHILE (ii <= num-entries(varrid-list) )
    11010    on error undo _ii, next _ii
    11011    :
    11012         FIND FIRST loc_goods WHERE
    11013                    recid( loc_goods ) = integer( entry(ii,varrid-list) ) NO-LOCK .
    11014         FIND FIRST ub.gds-prt WHERE
    11015                    ub.gds-prt.upper-code = loc_goods.prt-root NO-LOCK .
    11016         FIND FIRST loc_bar-code WHERE
    11017                    loc_bar-code.node-code = ub.gds-prt.node-code AND
    11018                   loc_bar-code.gds-code = loc_goods.gds-code AND
    11019                   loc_bar-code.in-code = "" AND
    11020                   loc_bar-code.part-code = ""  AND
    11021                   loc_bar-code.unit-cli = loc_goods.unit-base NO-LOCK .
    11022         run get-price1 in this-procedure ( input loc_goods.gds-code, input loc_bar-code.node-code) No-ERROR.
    11023         if error-status:error then return no-apply.
    11024         assign
    11025         lng = lng + 1
    11026         .
    11027         CASE tt-chk-doc.chk-type:
    11028           when INTEGER('96':U) then do:
    11029             v-wro-code = INTEGER('-9':U).
    11030           end.
    11031           when INTEGER('69':U)  then do:
    11032             v-wro-code = INTEGER('1':U).
    11033           end.
    11034           when INTEGER('17':U)  then do:
    11035             v-wro-code = INTEGER('17':U).
    11036           end.
    11037         END CASE.
    11038         create tt-chk-gds.
    11039         assign
    11040         tt-chk-gds.doc-code = tt-chk-doc.doc-code
    11041         tt-chk-gds.line-num = lng
    11042         tt-chk-gds.src-code = string(loc_bar-code.b-code)
    11043         tt-chk-gds.src-price = ( if gp-price-sale <> ? then gp-price-sale else 0)
    11044         tt-chk-gds.src-discnt = 0
    11045         tt-chk-gds.src-qnty = 0
    11046         tt-chk-gds.src-sum = 0
    11047         tt-chk-gds.price-base = 0
    11048         tt-chk-gds.doc-qnty = 0
    11049         tt-chk-gds.discnt = 0
    11050         tt-chk-gds.sum-base = 0
    11051         tt-chk-gds.is-error = no
    11052         tt-chk-gds.b-code = loc_bar-code.b-code
    11053         tt-chk-gds.pass-gds = integer('1':U)
    11054         tt-chk-gds.write-off-code = v-wro-code
    11055         tt-chk-gds.nozzle-code = 0
    11056         tt-chk-gds.src-pl-code = 0
    11057         tt-chk-gds.pl-code = 0
    11058         tt-chk-gds.density = 0
    11059         tt-chk-gds.pump = 0
    11060         tt-chk-gds.loc1 = '':U
    11061         .
    11062   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11063   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    11064     (input  loc_goods.gds-code
    11065     ,input  '1':U
    11066     ,input  ?
    11067     ,input  v-host-code
    11068     ,input  p-obj-type
    11069     ,input  p-obj-code
    11070     ,output tt-chk-gds.VAT-pc
    11071     ) no-error .
    11072         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(tt-chk-doc.obj-type, tt-chk-doc.obj-code).
    11073         RUN gds-attr-value (
    11074                             INPUT loc_goods.gds-code,
    11075                             INPUT 'mark-type':U,
    11076                             OUTPUT v-gds-attr-value,
    11077                             OUTPUT v-gds-attr-type
    11078                             ).
    11079         if v-gds-attr-value > ""
    11080         and EDOParSec:GetIsMarkingForType(v-gds-attr-value)
    11081         then do :
    11082           run str/enter-mark.w (input loc_goods.gds-code,
    11083                                 output v-mark,
    11084                                 output v-ok,
    11085                                 output v-b-code) .
    11086           if v-ok
    11087           then do :
    11088             find first buf_marking-chk exclusive-lock where buf_marking-chk.doc-code = tt-chk-gds.doc-code
    11089                                                         and buf_marking-chk.line-num = tt-chk-gds.line-num
    11090                                                         and buf_marking-chk.mark     = v-mark
    11091                                                         no-error .
    11092             if not available buf_marking-chk
    11093             then do :
    11094               create buf_marking-chk .
    11095               assign
    11096                 buf_marking-chk.doc-code = tt-chk-gds.doc-code
    11097                 buf_marking-chk.line-num = tt-chk-gds.line-num
    11098                 buf_marking-chk.mark     = v-mark
    11099               .
    11100             end .
    11101             assign
    11102               buf_marking-chk.date-modify = today
    11103               buf_marking-chk.time-modify = time
    11104             .
    11105             assign
    11106               tt-chk-gds.src-qnty = 1
    11107               tt-chk-gds.doc-qnty = 1
    11108               tt-chk-gds.b-code = v-b-code
    11109               tt-chk-gds.src-code = string(v-b-code)
    11110             .
    11111             for first ub.marking no-lock where ub.marking.mark = buf_marking-chk.mark :
    11112               assign buf_marking-chk.unit = ub.marking.unit-ext .
    11113               if buf_marking-chk.unit = "LEVEL1"
    11114               then
    11115               assign
    11116                 tt-chk-gds.doc-qnty = tt-chk-gds.src-qnty * 10
    11117                 tt-chk-gds.src-price  = tt-chk-gds.src-price * 10
    11118                 tt-chk-gds.src-sum    = tt-chk-gds.src-sum * 10
    11119                 tt-chk-gds.src-discnt = tt-chk-gds.src-discnt * 10
    11120               .
    11121             end .
    11122             enable
    11123             B_mark
    11124             with frame Dialog-Frame .
    11125           end .
    11126           else do :
    11127             delete tt-chk-gds .
    11128             ii = ii + 1 .
    11129             undo _ii, next _ii.
    11130           end .
    11131         end .
    11132         create locked_chk-gds.
    11133         buffer-copy tt-chk-gds to locked_chk-gds.
    11134         create tt-gds-info.
    11135         buffer-copy tt-chk-gds to tt-gds-info
    11136         assign
    11137         tt-gds-info.artic = loc_goods.artic
    11138         tt-gds-info.gds-name = loc_goods.gds-name
    11139         tt-gds-info.prt-name = "-":U
    11140         ii = ii + 1
    11141         varline-rid = recid(tt-chk-gds)
    11142         .
    11143         CASE par-mode:     WHEN 'ДОБАВЛЕНИЕ':U     OR     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:        IF dflt-cd = 'MAGIA-XML':U THEN OPEN QUERY BR-gds FOR EACH tt-chk-gds       WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,              FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by abs(tt-chk-gds.line-num).     ELSE     OPEN QUERY BR-gds FOR EACH tt-chk-gds           WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                  FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by tt-chk-gds.line-num.      END.     WHEN 'ПРОСМОТР':U or when "susp-type" THEN DO:            IF dflt-cd = 'MAGIA-XML':U THEN         OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK             WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                      FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num             by abs(tt-chk-gds.line-num).          ELSE             OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK                 WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                          FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num                 by tt-chk-gds.line-num.      END. END CASE.
    11144         REPOSITION Br-gds to recid varline-rid no-error.
    11145         if error-status:error then do:
    11146           undo _ii, next _ii.
    11147         end.
    11148         if get-chkc_context.doc-prt and gds-prt.node-name <> '_Пустая шкала':U then do:
    11149             run setprts in this-procedure ( input recid(loc_goods), input recid(loc_bar-code), input loc_goods.prt-root, input yes) no-error.
    11150             if error-status:error then do:
    11151               undo _ii, next _ii.
    11152             end.
    11153         end.
    11154       end.
    11155       CASE par-mode:     WHEN 'ДОБАВЛЕНИЕ':U     OR     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:        IF dflt-cd = 'MAGIA-XML':U THEN OPEN QUERY BR-gds FOR EACH tt-chk-gds       WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,              FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by abs(tt-chk-gds.line-num).     ELSE     OPEN QUERY BR-gds FOR EACH tt-chk-gds           WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                  FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by tt-chk-gds.line-num.      END.     WHEN 'ПРОСМОТР':U or when "susp-type" THEN DO:            IF dflt-cd = 'MAGIA-XML':U THEN         OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK             WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                      FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num             by abs(tt-chk-gds.line-num).          ELSE             OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK                 WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                          FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num                 by tt-chk-gds.line-num.      END. END CASE.
    11156       find first loc_tt-chk-gds WHERE
    11157                  loc_tt-chk-gds.doc-code = tt-chk-doc.doc-code AND
    11158                  loc_tt-chk-gds.src-qnty = 0 NO-LOCK NO-ERROR.
    11159       IF avail loc_tt-chk-gds then do:
    11160         reposition br-gds to recid recid(loc_tt-chk-gds).
    11161       end.
    11162   apply "entry" to br-gds in frame Dialog-Frame .
    11163   END PROCEDURE.
    11164   PROCEDURE proc-b-addpay :
    11165   define variable varrid-list as character no-undo.
    11166   DEFine VARiable trid as recid no-undo.
    11167   define variable base-rate_   as decimal                 no-undo .
    11168   define variable base-scale_  like ub.chk-doc.cash-scale no-undo .
    11169   define buffer lnp_chk-pay for ub.chk-pay.
    11170   define buffer loc_tt-chk-pay for tt-chk-pay.
    11171   define buffer loc_cash-pay for ub.cash-pay.
    11172   define buffer loc_currency for ub.currency.
    11173   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
    11174   run proc-save-doc in this-procedure No-ERROR.
    11175   if error-status:error then return error.
    11176   end .
    11177   varrid-list = "" .
    11178   run ref/cashpays.w (
    11179                 input parparentproc
    11180                ,input "b-sel"
    11181                ,input 'все':U
    11182                ,input get-chkc_context.host-code
    11183                ,input locked_chk-doc.obj-type
    11184                ,input locked_chk-doc.obj-code
    11185                ,output varrid-list ) .
    11186   if varrid-list = "" then return error.
    11187   FIND LAST lnp_chk-pay No-LOCK WHERE
    11188             lnp_chk-pay.doc-code = TT-chk-doc.doc-code
    11189             USE-INDEX ln NO-ERROR.
    11190   if avail lnp_chk-pay then lnp = lnp_chk-pay.line-num.
    11191   else lnp = 0.
    11192   FIND FIRST loc_cash-pay WHERE
    11193                           recid( loc_cash-pay ) = integer( varrid-list ) NO-LOCK .
    11194   run find-bank-curs in this-procedure (
    11195                                         input tt-chk-doc.chk-date
    11196                                         ,input loc_cash-pay.curr-code
    11197                                         ,output bank-rate_
    11198                                         ,output bank-scale_
    11199                                         ) no-error.
    11200   run find-curs in this-procedure (
    11201                                   input tt-chk-doc.chk-date
    11202                                   ,input tt-chk-doc.chk-time
    11203                                   ,input loc_cash-pay.curr-code
    11204                                   ,output cash-rate_
    11205                                   ,output cash-scale_
    11206                                   ,output exch-date_
    11207                                   ,output exch-time_
    11208                                   ) no-error.
    11209   if get-chkc_context.r-b = 'base':U and
    11210   get-chkc_context.base-code <> 0 then do:
    11211     run find-curs in this-procedure (
    11212                                     input tt-chk-doc.chk-date
    11213                                     ,input tt-chk-doc.chk-time
    11214                                     ,input get-chkc_context.base-code
    11215                                     ,output base-rate_
    11216                                     ,output base-scale_
    11217                                     ,output exch-date_
    11218                                     ,output exch-time_
    11219                                     ) no-error.
    11220   end.
    11221   else do:
    11222     assign
    11223     base-rate_ = 1
    11224     base-scale_ = 1
    11225     .
    11226   end.
    11227   create tt-chk-pay.
    11228   assign
    11229   lnp = lnp + 1
    11230   tt-chk-pay.doc-code = tt-chk-doc.doc-code
    11231   tt-chk-pay.line-num = lnp
    11232   tt-chk-pay.chk-date = tt-chk-doc.chk-date
    11233   tt-chk-pay.pay-code = loc_cash-pay.cdpay-code
    11234   tt-chk-pay.curr-code = loc_cash-pay.curr-code
    11235   tt-chk-pay.obj-code = tt-chk-doc.obj-code
    11236   tt-chk-pay.obj-type = tt-chk-doc.obj-type
    11237   tt-chk-pay.bank-rate = bank-rate_
    11238   tt-chk-pay.bank-scale = bank-scale_
    11239   tt-chk-pay.cash-rate = cash-rate_ / cash-scale_ * (if get-chkc_context.r-b = 'base':U and get-chkc_context.base-code <> 0 then base-rate_ / base-scale_ else 1)
    11240   tt-chk-pay.tot-base = 0
    11241   tt-chk-pay.tot-sum = 0
    11242   tt-chk-pay.tot-rubl = 0
    11243   tt-chk-pay.pay-card = "":U
    11244   tt-chk-pay.is-error = no
    11245   tt-chk-pay.pass-pay = integer('1':U)
    11246   .
    11247   create tt-pay-info.
    11248   buffer-copy tt-chk-pay to tt-pay-info
    11249   assign
    11250   tt-pay-info.exch-rate = cash-rate_
    11251   tt-pay-info.exch-scale = cash-scale_
    11252   tt-pay-info.exch-date = exch-date_
    11253   tt-pay-info.exch-time = exch-time_
    11254   tt-pay-info.exch-time-str = string(exch-time_, "hh:mm:ss")
    11255   tt-pay-info.calc-rate = cash-rate_ / cash-scale_
    11256   .
    11257   CREATE locked_chk-pay .
    11258   buffer-copy tt-chk-pay to locked_chk-pay.
    11259     trid = recid(tt-chk-pay).
    11260   CASE par-mode:   WHEN 'ДОБАВЛЕНИЕ':U   OR   WHEN 'ИЗМЕНЕНИЕ':U  THEN DO:      OPEN QUERY BR-pay FOR EACH  tt-chk-pay          WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code ,            first tt-pay-info no-lock where tt-pay-info.line-num = tt-chk-pay.line-num          by tt-chk-pay.line-num.  END.   WHEN 'ПРОСМОТР':U or when "susp-type" THEN DO:      OPEN QUERY BR-pay FOR EACH  tt-chk-pay          WHERE tt-chk-pay.doc-code = tt-chk-doc.doc-code ,            first tt-pay-info no-lock where tt-pay-info.line-num = tt-chk-pay.line-num          by tt-chk-pay.line-num.  END. END CASE.
    11261   REPOSITION br-pay to recid trid NO-ERROR.
    11262   glog = BR-pay:SET-REPOSITIONED-ROW(1, "CONDITIONAL") in frame Dialog-Frame.
    11263   apply "entry" to br-pay in frame Dialog-Frame .
    11264   END PROCEDURE.
    11265   PROCEDURE proc-b-slip :
    11266   define input parameter p-slip-type as character no-undo .
    11267     define buffer buf_chk-doc-attr for ub.chk-doc-attr .
    11268     define buffer buf_chk-pay-attr for ub.chk-pay-attr .
    11269     find first buf_chk-doc-attr no-lock where buf_chk-doc-attr.doc-code = tt-chk-doc.doc-code
    11270                                           and buf_chk-doc-attr.attr-code = "CheckId"
    11271                                           no-error .
    11272     if not available buf_chk-doc-attr
    11273     or (available buf_chk-doc-attr and trim(buf_chk-doc-attr.attr-value) = "")
    11274     then do :
    11275       message "Слипы не найдены!" view-as alert-box .
    11276       return .
    11277     end .
    11278     if p-slip-type = "chk"
    11279     then do :
    11280       run str/chk-slips.w (input v-cntxt-db-num-obj,
    11281                            input trim(buf_chk-doc-attr.attr-value),
    11282                            input ?)
    11283                           .
    11284     end .
    11285     if p-slip-type = "pay"
    11286     then do :
    11287       find first buf_chk-pay-attr no-lock where buf_chk-pay-attr.doc-code = tt-chk-doc.doc-code
    11288                                             and buf_chk-pay-attr.attr-code = "RRN"
    11289                                             and buf_chk-pay-attr.line-num = tt-chk-pay.line-num
    11290                                             no-error .
    11291       if not available buf_chk-pay-attr
    11292       or (available buf_chk-pay-attr and trim(buf_chk-pay-attr.attr-value) = "")
    11293       then do :
    11294         find first buf_chk-pay-attr no-lock where buf_chk-pay-attr.doc-code = tt-chk-doc.doc-code
    11295                                               and buf_chk-pay-attr.attr-code = "CPDOC"
    11296                                               and buf_chk-pay-attr.line-num = tt-chk-pay.line-num
    11297                                               no-error .
    11298         if not available buf_chk-pay-attr
    11299         or (available buf_chk-pay-attr and trim(buf_chk-pay-attr.attr-value) = "")
    11300         then do :
    11301           message "В чеке нет атрибута 'RRN/CPDOC' для поиска слипов по оплате!" view-as alert-box error .
    11302           return .
    11303         end .
    11304       end .
    11305       run str/chk-slips.w (input v-cntxt-db-num-obj,
    11306                            input trim(buf_chk-doc-attr.attr-value),
    11307                            input trim(buf_chk-pay-attr.attr-value))
    11308                           .
    11309     end .
    11310   END PROCEDURE.
    11311   PROCEDURE proc-chg-gds :
    11312   define variable varrid-list as character no-undo.
    11313   DEFINE VARIABLE varline-rid as recid  no-undo.
    11314   define buffer lng_chk-gds for ub.chk-gds.
    11315   define buffer loc_chk-gds for ub.chk-gds.
    11316   define buffer loc_bar-code for ub.bar-code.
    11317   define buffer loc_goods for ub.goods.
    11318   if not (par-mode = 'ИЗМЕНЕНИЕ':U or par-mode = 'ДОБАВЛЕНИЕ':U) then return.
    11319   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
    11320     run proc-save-doc in this-procedure No-ERROR.
    11321     if error-status:error then return error.
    11322   end.
    11323   if not available tt-gds-info
    11324   then do :
    11325     find first tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num .
    11326   end .
    11327   varrid-list = "" .
    11328   run ref/gds-ref.p (
    11329                   input parparentproc
    11330                 ,input "b-sel,b-mark"
    11331                 ,input ?
    11332                 ,input ?
    11333                 ,input ?
    11334                 ,input ?
    11335                 ,input ?
    11336                 ,input ?
    11337                 ,input ?
    11338                 ,input tt-chk-doc.obj-type
    11339                 ,input tt-chk-doc.obj-code
    11340                 ,input ?
    11341                , output varrid-list ).
    11342   if varrid-list <> "" then do:
    11343     ii = 1.
    11344         FIND FIRST loc_goods WHERE
    11345                    recid( loc_goods ) = integer( entry(1,varrid-list) ) NO-LOCK .
    11346         FIND FIRST ub.gds-prt WHERE
    11347                    ub.gds-prt.upper-code = loc_goods.prt-root NO-LOCK .
    11348         FIND FIRST loc_bar-code WHERE
    11349                    loc_bar-code.node-code = ub.gds-prt.node-code AND
    11350                   loc_bar-code.gds-code = loc_goods.gds-code AND
    11351                   loc_bar-code.in-code = "" AND
    11352                   loc_bar-code.part-code = ""  AND
    11353                   loc_bar-code.unit-cli = loc_goods.unit-base NO-LOCK .
    11354         run get-price1 in this-procedure ( input loc_goods.gds-code, input loc_bar-code.node-code) No-ERROR.
    11355         if error-status:error then undo, return error.
    11356         RUN check-ch-bc-ck in this-procedure ( input gp-price-sale, input tt-chk-gds.price-base) no-error.
    11357         if error-status:error then undo, return error.
    11358         assign
    11359         tt-chk-gds.doc-code = tt-chk-doc.doc-code
    11360         tt-chk-gds.src-code = string(loc_bar-code.b-code)
    11361         tt-chk-gds.is-error = no
    11362         tt-chk-gds.src-code = string(loc_bar-code.b-code)
    11363         tt-chk-gds.b-code = loc_bar-code.b-code
    11364         tt-gds-info.artic = loc_goods.artic
    11365         tt-gds-info.gds-code = loc_goods.gds-code
    11366         tt-gds-info.gds-name = loc_goods.gds-name
    11367         tt-gds-info.prt-name = "-":U.
    11368          .
    11369         if get-chkc_context.doc-prt and gds-prt.node-name <> '_Пустая шкала':U then do:
    11370             run setprts in this-procedure ( input recid(loc_goods), input recid(loc_bar-code), input loc_goods.prt-root, input no).
    11371         end.
    11372       end.
    11373       display
    11374       tt-chk-gds.b-code
    11375       tt-chk-gds.src-code
    11376       tt-gds-info.artic
    11377       tt-gds-info.gds-name
    11378       tt-gds-info.prt-name
    11379       tt-chk-gds.is-error
    11380       with browse br-gds.
    11381     apply "entry" to br-gds in frame Dialog-Frame .
    11382   END PROCEDURE.
    11383   PROCEDURE proc-chg-pay :
    11384   define input parameter p-reference as logical no-undo.
    11385   define input parameter p-old-curr-code like ub.chk-pay.curr-code no-undo.
    11386   define variable varrid-list as character no-undo.
    11387   DEFINE VARIABLE varline-rid as recid  no-undo.
    11388   define buffer loc_cash-pay for ub.cash-pay.
    11389   define buffer loc_currency for ub.currency.
    11390   if not (par-mode = 'ИЗМЕНЕНИЕ':U or par-mode = 'ДОБАВЛЕНИЕ':U) then return.
    11391   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
    11392     run proc-save-doc in this-procedure No-ERROR.
    11393     if error-status:error then return error.
    11394   end .
    11395   varrid-list = "" .
    11396   if p-reference then do:
    11397       run ref/cashpays.w (
    11398                   input parparentproc
    11399                 ,input "b-sel"
    11400                 ,input 'все':U
    11401                 ,input get-chkc_context.host-code
    11402                 ,input locked_chk-doc.obj-type
    11403                 ,input locked_chk-doc.obj-code
    11404                 ,output varrid-list ) .
    11405       if varrid-list = "":U then return error.
    11406       FIND FIRST loc_cash-pay WHERE
    11407                              recid( loc_cash-pay ) = integer( varrid-list ) NO-LOCK .
    11408     assign
    11409       tt-chk-pay.pay-code = loc_cash-pay.cdpay-code
    11410       tt-chk-pay.curr-code = loc_cash-pay.curr-code
    11411       .
    11412   end.
    11413       run find-bank-curs in this-procedure (
    11414                                             input tt-chk-doc.chk-date
    11415                                             ,input (if p-reference
    11416                                                     then loc_cash-pay.curr-code
    11417                                                     else tt-chk-pay.curr-code)
    11418                                             ,output bank-rate_
    11419                                             ,output bank-scale_
    11420                                             ) no-error.
    11421       run find-curs in this-procedure (
    11422                                        input tt-chk-doc.chk-date
    11423                                       ,input tt-chk-doc.chk-time
    11424                                       ,input (if p-reference
    11425                                               then loc_cash-pay.curr-code
    11426                                               else tt-chk-pay.curr-code)
    11427                                       ,output cash-rate_
    11428                                       ,output cash-scale_
    11429                                       ,output exch-date_
    11430                                       ,output exch-time_
    11431                                       ) no-error.
    11432       assign
    11433       tt-chk-pay.bank-rate = (if p-old-curr-code <> tt-chk-pay.curr-code
    11434                                             then bank-rate_
    11435                                             else tt-chk-pay.bank-rate)
    11436       tt-chk-pay.bank-scale = (if p-old-curr-code <> tt-chk-pay.curr-code
    11437                                           then bank-scale_
    11438                                           else tt-chk-pay.bank-scale)
    11439       tt-chk-pay.cash-rate = if not get-chkc_context.cas-curs AND p-old-curr-code <> tt-chk-pay.curr-code
    11440                                           then cash-rate_ / cash-scale_
    11441                                          else tt-chk-pay.cash-rate
    11442       tt-chk-pay.is-error = no
    11443       tt-pay-info.calc-rate = cash-rate_ / cash-scale_
    11444       tt-pay-info.exch-rate = cash-rate_
    11445       tt-pay-info.exch-scale = cash-scale_
    11446       tt-pay-info.exch-date = exch-date_
    11447       tt-pay-info.exch-time = exch-time_
    11448       tt-pay-info.exch-time-str = string(exch-time_, "hh:mm:ss")
    11449      .
    11450   run get-pay-sums in this-procedure ( buffer tt-chk-pay).
    11451   display
    11452   tt-chk-pay.pay-code
    11453   tt-chk-pay.curr-code
    11454   tt-chk-pay.is-error
    11455   tt-chk-pay.bank-rate
    11456   tt-chk-pay.bank-scale
    11457   tt-chk-pay.cash-rate
    11458   tt-chk-pay.tot-rubl
    11459   tt-chk-pay.tot-base
    11460   get-pay(tt-chk-pay.pay-code, tt-chk-pay.curr-code, output varcurr-name) @ v-pay-name
    11461   varcurr-name
    11462   tt-pay-info.calc-rate
    11463   tt-pay-info.exch-rate
    11464   tt-pay-info.exch-scale
    11465   tt-pay-info.exch-date
    11466   tt-pay-info.exch-time-str
    11467   with browse br-pay.
    11468   apply "entry" to br-pay in frame Dialog-Frame .
    11469   END PROCEDURE.
    11470   PROCEDURE proc-leave-discnt-abs :
    11471   define input parameter p-type as integer no-undo .
    11472   DEFINE VARIABLE v-old-discnt-value like ub.chk-discnt.discnt-value-abs  no-undo .
    11473   if par-mode = 'ПРОСМОТР':U or par-mode = "susp-type" then return.
    11474   IF NOT AVAILABLE TT-CHK-DISCNT THEN RETURN NO-APPLY.
    11475   if p-type = integer('2':U) then do:
    11476     assign
    11477     v-old-discnt-value = tt-chk-discnt.discnt-value-abs
    11478     .
    11479   end.
    11480   else do:
    11481     assign
    11482     v-old-discnt-value = tt-chk-discnt.discnt-value-pcnt
    11483     .
    11484   end.
    11485   if dflt-cd <> 'NCR-GM':U and
    11486     dflt-cd <> 'NCR-AS@R':U and
    11487     tt-chk-discnt.object-line-num <> 0
    11488     and tt-chk-discnt.record-type = 0
    11489     then do:
    11490     message
    11491     "Нельзя менять значение скидки для скидки по товарной строке"
    11492     view-as alert-box .
    11493     assign
    11494     tt-chk-discnt.real-value-abs:screen-value in browse br-discnt = string(v-old-discnt-value)
    11495     .
    11496     if p-type = integer('2':U) then  do:
    11497       assign
    11498       tt-chk-discnt.real-value-abs:screen-value in browse br-discnt = string(v-old-discnt-value)
    11499       .
    11500     end.
    11501     else do:
    11502       assign
    11503       tt-chk-discnt.real-value-pcnt:screen-value in browse br-discnt = string(v-old-discnt-value)
    11504       .
    11505     end.
    11506   end.
    11507   else do:
    11508     find first locked_chk-discnt where
    11509           locked_chk-discnt.doc-code = tt-chk-doc.doc-code
    11510       AND locked_chk-discnt.line-num = tt-chk-discnt.line-num
    11511       AND locked_chk-discnt.object-line-num = tt-chk-discnt.object-line-num
    11512       AND locked_chk-discnt.discnt-id = tt-chk-discnt.discnt-id.
    11513     IF LOCKED_chk-discnt.value-type = INTEGER('2':U) or LOCKED_chk-discnt.value-type = INTEGER('5':U)  THEN DO:
    11514         assign
    11515         locked_chk-discnt.discnt-value-abs = decimal(tt-chk-discnt.real-value-abs:screen-value in browse br-discnt    )
    11516         tt-chk-discnt.discnt-value-abs = locked_chk-discnt.discnt-value-abs
    11517         .
    11518     END.
    11519     ELSE DO:
    11520         assign
    11521         locked_chk-discnt.discnt-value-pcnt = decimal(tt-chk-discnt.real-value-pcnt:screen-value in browse br-discnt    )
    11522         tt-chk-discnt.discnt-value-pcnt = locked_chk-discnt.discnt-value-pcnt
    11523         locked_chk-discnt.discnt-value-abs = tt-chk-discnt.discnt-value-pcnt * tt-chk-discnt.object-sum / 100
    11524         tt-chk-discnt.discnt-value-abs = locked_chk-discnt.discnt-value-abs
    11525         .
    11526     END.
    11527     if tt-chk-discnt.record-type < 4 then do:
    11528       run get-discnt in this-procedure(
    11529                                               input tt-chk-discnt.line-num
    11530                                               ,input tt-chk-discnt.value-type
    11531                                             ,input tt-chk-discnt.line-type
    11532                                             ,input tt-chk-discnt.discnt-type
    11533                                               ).
    11534       run get-sums in this-procedure no-error.
    11535       display
    11536       tt-chk-doc.tot-doc
    11537       tt-chk-doc.discnt
    11538       tt-chk-doc.netto
    11539       tt-chk-doc.src-tot-doc
    11540       with frame Dialog-Frame.
    11541     end.
    11542   end.
    11543   END PROCEDURE.
    11544   PROCEDURE add-blocked-marks :
    11545     define buffer buf_marking for ub.marking .
    11546     define buffer lng_chk-gds for chk-gds.
    11547     define buffer loc_tt-chk-gds for tt-chk-gds.
    11548     define buffer loc_bar-code for bar-code.
    11549     define buffer loc_goods for goods.
    11550     define buffer buf_prod-bc for ub.prod-bc .
    11551     define variable v-GTIN as character no-undo .
    11552     define variable v-wro-code as integer no-undo .
    11553     define variable v-mark as character no-undo .
    11554     DEFINE VARIABLE varline-rid as recid  no-undo.
    11555     define variable ii as integer no-undo .
    11556     FIND LAST lng_chk-gds No-LOCK WHERE
    11557               lng_chk-gds.doc-code = TT-CHK-doc.doc-code
    11558               USE-INDEX ln NO-ERROR.
    11559     if avail lng_chk-gds then lng = lng_chk-gds.line-num.
    11560     else lng = 0.
    11561     ii = 0 .
    11562     _ii:
    11563     for each buf_marking no-lock where buf_marking.obj-type = v-cntxt-obj-type
    11564                                    and buf_marking.obj-code = v-cntxt-obj-code
    11565                                    and buf_marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB
    11566                                    :
    11567       FIND FIRST loc_goods WHERE
    11568                  loc_goods.gds-code = buf_marking.gds-code NO-LOCK .
    11569       FIND FIRST gds-prt WHERE
    11570                  gds-prt.upper-code = loc_goods.prt-root NO-LOCK .
    11571       v-GTIN = getGtinByDM(buf_marking.mark) .
    11572       for each loc_bar-code no-lock WHERE
    11573                 loc_bar-code.gds-code = loc_goods.gds-code AND
    11574                 loc_bar-code.in-code = "" AND
    11575                 loc_bar-code.part-code = "",
    11576       each buf_prod-bc no-lock where buf_prod-bc.b-code = loc_bar-code.b-code
    11577                                  and buf_prod-bc.b-str  = v-GTIN :
    11578         leave .
    11579       end .
    11580       if not available loc_bar-code
    11581       then do :
    11582         FIND FIRST loc_bar-code WHERE
    11583                  loc_bar-code.node-code = gds-prt.node-code AND
    11584                 loc_bar-code.gds-code = loc_goods.gds-code AND
    11585                 loc_bar-code.in-code = "" AND
    11586                 loc_bar-code.part-code = ""  AND
    11587                 loc_bar-code.unit-cli = loc_goods.unit-base no-lock .
    11588       end .
    11589       run get-price1 in this-procedure ( input loc_goods.gds-code, input loc_bar-code.node-code) No-ERROR.
    11590       if error-status:error then return no-apply.
    11591       assign
    11592       lng = lng + 1
    11593       .
    11594       CASE tt-chk-doc.chk-type:
    11595         when INTEGER('96':U) then do:
    11596           v-wro-code = INTEGER('-9':U).
    11597         end.
    11598         when INTEGER('69':U)  then do:
    11599           v-wro-code = INTEGER('1':U).
    11600         end.
    11601         when INTEGER('17':U)  then do:
    11602           v-wro-code = INTEGER('17':U).
    11603         end.
    11604       END CASE.
    11605       create tt-chk-gds.
    11606       assign
    11607       tt-chk-gds.doc-code = tt-chk-doc.doc-code
    11608       tt-chk-gds.line-num = lng
    11609       tt-chk-gds.src-code = string(loc_bar-code.b-code)
    11610       tt-chk-gds.src-price = ( if gp-price-sale <> ? then gp-price-sale else 0)
    11611       tt-chk-gds.src-discnt = 0
    11612       tt-chk-gds.src-qnty = 0
    11613       tt-chk-gds.src-sum = 0
    11614       tt-chk-gds.price-base = 0
    11615       tt-chk-gds.doc-qnty = 0
    11616       tt-chk-gds.discnt = 0
    11617       tt-chk-gds.sum-base = 0
    11618       tt-chk-gds.is-error = no
    11619       tt-chk-gds.b-code = loc_bar-code.b-code
    11620       tt-chk-gds.pass-gds = integer('1':U)
    11621       tt-chk-gds.write-off-code = v-wro-code
    11622       tt-chk-gds.nozzle-code = 0
    11623       tt-chk-gds.src-pl-code = 0
    11624       tt-chk-gds.pl-code = 0
    11625       tt-chk-gds.density = 0
    11626       tt-chk-gds.pump = 0
    11627       tt-chk-gds.loc1 = '':U
    11628       .
    11629       v-mark = buf_marking.mark .
    11630       find first buf_marking-chk exclusive-lock where buf_marking-chk.doc-code = tt-chk-gds.doc-code
    11631                                                   and buf_marking-chk.line-num = tt-chk-gds.line-num
    11632                                                   and buf_marking-chk.mark     = v-mark
    11633                                                   no-error .
    11634       if not available buf_marking-chk
    11635       then do :
    11636         create buf_marking-chk .
    11637         assign
    11638           buf_marking-chk.doc-code = tt-chk-gds.doc-code
    11639           buf_marking-chk.line-num = tt-chk-gds.line-num
    11640           buf_marking-chk.mark     = v-mark
    11641         .
    11642       end .
    11643       assign
    11644         buf_marking-chk.date-modify = today
    11645         buf_marking-chk.time-modify = time
    11646       .
    11647       assign
    11648         tt-chk-gds.src-qnty = 1
    11649         tt-chk-gds.doc-qnty = 1
    11650       .
    11651       assign buf_marking-chk.unit = buf_marking.unit-ext .
    11652       if buf_marking-chk.unit = "LEVEL1"
    11653       then
    11654       assign
    11655         tt-chk-gds.doc-qnty = tt-chk-gds.src-qnty * 10
    11656         tt-chk-gds.src-price  = tt-chk-gds.src-price * 10
    11657         tt-chk-gds.src-sum    = tt-chk-gds.src-sum * 10
    11658         tt-chk-gds.src-discnt = tt-chk-gds.src-discnt * 10
    11659       .
    11660       create locked_chk-gds.
    11661       buffer-copy tt-chk-gds to locked_chk-gds.
    11662       create tt-gds-info.
    11663       buffer-copy tt-chk-gds to tt-gds-info
    11664       assign
    11665       tt-gds-info.artic = loc_goods.artic
    11666       tt-gds-info.gds-name = loc_goods.gds-name
    11667       tt-gds-info.prt-name = "-":U
    11668       ii = ii + 1
    11669       varline-rid = recid(tt-chk-gds)
    11670       .
    11671       CASE par-mode:     WHEN 'ДОБАВЛЕНИЕ':U     OR     WHEN 'ИЗМЕНЕНИЕ':U THEN DO:        IF dflt-cd = 'MAGIA-XML':U THEN OPEN QUERY BR-gds FOR EACH tt-chk-gds       WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,              FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by abs(tt-chk-gds.line-num).     ELSE     OPEN QUERY BR-gds FOR EACH tt-chk-gds           WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                  FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num  by tt-chk-gds.line-num.      END.     WHEN 'ПРОСМОТР':U or when "susp-type" THEN DO:            IF dflt-cd = 'MAGIA-XML':U THEN         OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK             WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                      FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num             by abs(tt-chk-gds.line-num).          ELSE             OPEN QUERY BR-gds FOR EACH tt-chk-gds NO-LOCK                 WHERE tt-chk-gds.doc-code = tt-chk-doc.doc-code ,                          FIRST tt-gds-info where tt-gds-info.line-num = tt-chk-gds.line-num                 by tt-chk-gds.line-num.      END. END CASE.
    11672       REPOSITION Br-gds to recid varline-rid no-error.
    11673       if error-status:error then do:
    11674         undo _ii, next _ii.
    11675       end.
    11676       if shop.doc-prt and gds-prt.node-name <> '_Пустая шкала':U then do:
    11677           run setprts in this-procedure ( input recid(loc_goods), input recid(loc_bar-code), input loc_goods.prt-root, input yes) no-error.
    11678           if error-status:error then do:
    11679             undo _ii, next _ii.
    11680           end.
    11681       end.
    11682     end .
    11683     if ii = 0
    11684     then do :
    11685       message "Нет заблокированных марок на объекте" view-as alert-box .
    11686     end .
    11687     else do :
    11688       message "Добавлены товары по " string(ii) " заблокированным маркам" view-as alert-box .
    11689       enable
    11690       B_mark
    11691       with frame Dialog-Frame .
    11692     end .
    11693   END PROCEDURE.
    11694   PROCEDURE proc-pcnt-discnt :
    11695   define input parameter p-src-d-pcnt like ub.chk-doc.src-d-pcnt no-undo.
    11696   if v-is-sub-d then do:
    11697     message
    11698     "В данном чеке будут одновременно выставлены:" SKIp
    11699     "% скидка на товары клиента и абсолютная скидка на итог" skip
    11700     "По правилам разбора чека до тех пор, пока в чеке есть абсолютная скидка на итог,"
    11701     "% скидка на товары будет иметь только информационное значение " skip
    11702     "и не будет применяться к товарам чека"
    11703     view-as alert-box WARNING.
    11704     return.
    11705   end.
    11706   run get-sums in this-procedure no-error .
    11707   display
    11708   tt-chk-doc.tot-doc
    11709   tt-chk-doc.discnt
    11710   tt-chk-doc.netto
    11711   tt-chk-doc.src-tot-doc
    11712   with frame Dialog-Frame.
    11713   END PROCEDURE.
    11714   PROCEDURE proc-save-doc :
    11715   DEFINE VARIABLE var-rid as recid no-undo.
    11716   define variable var-chk-type as character no-undo.
    11717   DEFINE VARIABLE varline-rid as recid no-undo .
    11718   define variable v-is-petrol-check            as logical                 no-undo .
    11719   define buffer buf-tt-chk-gds for tt-chk-gds .
    11720   define buffer buf-tt-gds-info for tt-gds-info .
    11721   define buffer loc-chk-gds for ub.chk-gds.
    11722   define buffer buf-tt-chk-pay for tt-chk-pay .
    11723   define buffer loc-chk-pay for ub.chk-pay.
    11724   define buffer buf-tt-chk-discnt for tt-chk-discnt .
    11725   define buffer loc-chk-discnt for ub.chk-discnt.
    11726   define buffer buf_c-chk-doc for ub.c-chk-doc.
    11727   assign
    11728   frame Dialog-Frame fhour
    11729   frame Dialog-Frame fmin
    11730   frame Dialog-Frame fsec
    11731   frame Dialog-Frame cb-chk-type
    11732   .
    11733   if par-mode = 'ИЗМЕНЕНИЕ':U then
    11734   run trg/chk-doch.p (
    11735                    buffer locked_chk-doc
    11736                 , input no
    11737                 , input no
    11738                 , input no
    11739                 , input-output v-chip-num
    11740                 , output v-is-update).
    11741   assign
    11742   tt-chk-doc.cashier
    11743   tt-chk-doc.chk-date
    11744   tt-chk-doc.chk-num
    11745   tt-chk-doc.chk-time = fhour * 3600 + fmin * 60 + fsec
    11746   tt-chk-doc.chk-type = if cb-chk-type = '1':U
    11747                         or
    11748                         cb-chk-type = '6':U
    11749                         or
    11750                         cb-chk-type = '96':U
    11751                         or
    11752                         cb-chk-type = '69':U
    11753                         or
    11754                         cb-chk-type = '14':U
    11755                         or
    11756                         cb-chk-type = '15':U
    11757                         or
    11758                         cb-chk-type = '16':U
    11759                         or
    11760                         cb-chk-type = '17':U
    11761                         or
    11762                         cb-chk-type = '8':U
    11763                         or
    11764                         cb-chk-type = '11':U
    11765                         or
    11766                         cb-chk-type = '12':U
    11767                         or
    11768                         cb-chk-type = '36':U
    11769                         or
    11770                         cb-chk-type = '301':U
    11771                         or
    11772                         cb-chk-type = '306':U
    11773                         or
    11774                         cb-chk-type = '201':U
    11775                         or
    11776                         cb-chk-type = '206':U
    11777                         or
    11778                         cb-chk-type = '208':U
    11779                         then integer(cb-chk-type)
    11780                         else 0
    11781   tt-chk-doc.obj-code
    11782   tt-chk-doc.pay-desk
    11783   tt-chk-doc.ps
    11784   tt-chk-doc.src-shift-date
    11785   tt-chk-doc.shift-num
    11786   tt-chk-doc.shift-name
    11787   tt-chk-doc.d-card
    11788   tt-chk-doc.src-d-card
    11789   tt-chk-doc.src-d-pcnt
    11790   tt-chk-doc.sales-man
    11791   tt-chk-doc.cash-rate
    11792   tt-chk-doc.cash-scale
    11793   tt-chk-doc.z-number
    11794   tt-chk-doc.doc-num
    11795   tt-chk-doc.doc-num2
    11796   .
    11797   buffer-copy tt-chk-doc
    11798   except
    11799   d-pcnt
    11800   tot-doc
    11801   netto
    11802   discnt
    11803   sub-discnt
    11804   office
    11805   correct
    11806   cashier-psn-code
    11807   salesman-psn-code
    11808   out-code
    11809   to locked_chk-doc
    11810   assign
    11811   locked_chk-doc.correct = yes
    11812   .
    11813   display tt-chk-doc.ps
    11814   with frame Dialog-Frame .
    11815   for each buf-tt-chk-gds no-lock where
    11816            buf-tt-chk-gds.doc-code = tt-chk-doc.doc-code,
    11817       first loc-chk-gds where
    11818             loc-chk-gds.doc-code = buf-tt-chk-gds.doc-code
    11819        AND  loc-chk-gds.line-num = buf-tt-chk-gds.line-num,
    11820       first buf-tt-gds-info no-lock where
    11821             buf-tt-gds-info.line-num = buf-tt-chk-gds.line-num:
    11822     assign
    11823     loc-chk-gds.src-code = buf-tt-chk-gds.src-code
    11824     loc-chk-gds.b-code = buf-tt-chk-gds.b-code
    11825     loc-chk-gds.src-qnty = buf-tt-chk-gds.src-qnty
    11826     loc-chk-gds.src-price = buf-tt-chk-gds.src-price
    11827     loc-chk-gds.src-discnt = buf-tt-chk-gds.src-discnt
    11828     loc-chk-gds.src-sum = buf-tt-chk-gds.src-sum
    11829     loc-chk-gds.road-tax = buf-tt-chk-gds.road-tax
    11830     loc-chk-gds.pump = buf-tt-chk-gds.pump
    11831     loc-chk-gds.nozzle-code  = buf-tt-chk-gds.nozzle-code
    11832     loc-chk-gds.loc1 = buf-tt-chk-gds.loc1
    11833     loc-chk-gds.pl-code = buf-tt-chk-gds.pl-code
    11834     loc-chk-gds.src-pl-code = buf-tt-chk-gds.src-pl-code
    11835     loc-chk-gds.sales-man = buf-tt-chk-gds.sales-man
    11836     loc-chk-gds.depart-id = (if buf-tt-chk-gds.depart-id = ? then 0 else buf-tt-chk-gds.depart-id )
    11837     loc-chk-gds.depart-code = (if buf-tt-chk-gds.depart-code = ? then 0 else buf-tt-chk-gds.depart-code)
    11838     loc-chk-gds.depart-type = 'маг':U
    11839     loc-chk-gds.doc-qnty = (if par-mode = 'ДОБАВЛЕНИЕ':U then buf-tt-chk-gds.doc-qnty else loc-chk-gds.doc-qnty)
    11840     loc-chk-gds.write-off-code = (if par-mode = 'ДОБАВЛЕНИЕ':U then buf-tt-chk-gds.write-off-code else loc-chk-gds.write-off-code)
    11841     .
    11842   END.
    11843   for each buf-tt-chk-pay no-lock where
    11844            buf-tt-chk-pay.doc-code = tt-chk-doc.doc-code,
    11845       first loc-chk-pay where
    11846             loc-chk-pay.doc-code = buf-tt-chk-pay.doc-code
    11847        AND  loc-chk-pay.line-num = buf-tt-chk-pay.line-num:
    11848     assign
    11849     loc-chk-pay.pay-code = buf-tt-chk-pay.pay-code
    11850     loc-chk-pay.curr-code = buf-tt-chk-pay.curr-code
    11851     loc-chk-pay.pay-card = buf-tt-chk-pay.pay-card
    11852     loc-chk-pay.cash-rate = buf-tt-chk-pay.cash-rate
    11853     loc-chk-pay.tot-sum = buf-tt-chk-pay.tot-sum
    11854     .
    11855   END.
    11856   for each buf-tt-chk-discnt no-lock where
    11857            buf-tt-chk-discnt.doc-code = tt-chk-doc.doc-code
    11858        and buf-tt-chk-discnt.record-type = 4,
    11859       first loc-chk-discnt where
    11860             loc-chk-discnt.doc-code = buf-tt-chk-discnt.doc-code
    11861         and loc-chk-discnt.record-type = buf-tt-chk-discnt.record-type
    11862         AND loc-chk-discnt.line-num = buf-tt-chk-discnt.line-num
    11863         and loc-chk-discnt.object-line-num = buf-tt-chk-discnt.object-line-num
    11864         and loc-chk-discnt.discnt-id = buf-tt-chk-discnt.discnt-id
    11865         :
    11866     buffer-copy buf-tt-chk-discnt to loc-chk-discnt.
    11867     if buf-tt-chk-discnt.line-type = integer('1':U) then do:
    11868       find first loc-chk-gds no-lock where
    11869                 loc-chk-gds.doc-code = buf-tt-chk-discnt.doc-code
    11870             and loc-chk-gds.line-num = buf-tt-chk-discnt.object-line-num no-error.
    11871       if not available loc-chk-gds then do:
    11872         delete buf-tt-chk-discnt.
    11873         delete loc-chk-discnt.
    11874       end.
    11875       else do:
    11876       end.
    11877     end.
    11878   END.
    11879   if lookup(string(tt-chk-doc.chk-type) , '14,15,16,17,36':U) > 0 then do:
    11880     v-is-petrol-check = yes.
    11881   end.
    11882   if v-is-petrol-check then do:
    11883     assign
    11884     tt-chk-doc.tot-doc = 0
    11885     tt-chk-doc.discnt = 0
    11886     tt-chk-doc.netto = 0
    11887     .
    11888   end.
    11889   END PROCEDURE.
    11890   PROCEDURE reposition-chk-doc :
    11891   define input parameter p-direction as character no-undo .
    11892   define variable v-new-chk-doc-recid as recid no-undo .
    11893   define buffer buf_chk-doc for ub.chk-doc .
    11894   do
    11895   on error undo, return error
    11896   :
    11897     if valid-handle(p-call-prog)
    11898     then do:
    11899       run reposition-chk-doc in p-call-prog
    11900         (input  p-direction
    11901         ,output v-new-chk-doc-recid
    11902         ).
    11903       if v-new-chk-doc-recid <> ?
    11904       then do:
    11905         find first buf_chk-doc no-lock
    11906           where recid(buf_chk-doc) = v-new-chk-doc-recid
    11907           no-error .
    11908         if lookup(string(buf_chk-doc.chk-type), '2,3,4,5,7':U) > 0 then do:
    11909         end.
    11910         assign
    11911         p-doc-rec = v-new-chk-doc-recid
    11912         p-next-prev = '':U
    11913         .
    11914       end.
    11915     end.
    11916     else do:
    11917       message "Список чеков не определен." view-as alert-box INFORMATION .
    11918       return no-apply.
    11919     end.
    11920     END.
    11921   END PROCEDURE.
    11922   PROCEDURE reposition-goods :
    11923   define input  parameter p-direction   as character no-undo .
    11924   define output parameter p-recid as recid no-undo .
    11925   define buffer buf_goods for ub.goods.
    11926   case p-direction :
    11927     when "first":U
    11928     then do:
    11929       get first br-gds.
    11930     end.
    11931     when "last":U
    11932     then do:
    11933       get last br-gds.
    11934     end.
    11935     when "prev":U
    11936     then do:
    11937       get prev br-gds.
    11938       if not available tt-gds-info then do:
    11939         message
    11940         "Это первый товар чека"
    11941         view-as alert-box.
    11942       end.
    11943     end.
    11944     when "next":U
    11945     then do:
    11946       get next br-gds.
    11947       if not available tt-gds-info then do:
    11948         message
    11949         "Это последний товар чека"
    11950         view-as alert-box.
    11951       end.
    11952     end.
    11953   end case .
    11954   if available tt-gds-info then do:
    11955     IF tt-gds-info.gds-code = 0 THEN DO:
    11956       MESSAGE
    11957       "Нет товара для данной строки чека!"
    11958       VIEW-AS ALERT-BOX WARNING.
    11959     END.
    11960     ELSE DO:
    11961       find first buf_goods no-lock where
    11962           buf_goods.gds-code = tt-gds-info.gds-code no-error.
    11963       if available tt-gds-info then do:
    11964         assign
    11965         p-recid = recid(buf_goods)
    11966         .
    11967       end.
    11968     END.
    11969   end.
    11970   run reposition-query-br-gds in this-procedure
    11971     (input recid(tt-chk-gds)
    11972     ).
    11973   END PROCEDURE.
    11974   PROCEDURE reposition-query-br-gds :
    11975   define input parameter p-recid as recid no-undo .
    11976   if p-recid <> ?
    11977   then do:
    11978     reposition br-gds to recid p-recid no-error.
    11979   end.
    11980   do with frame Dialog-Frame:
    11981     apply "entry":u to browse BR-corr .
    11982     apply "VALUE-CHANGED":u to browse BR-corr .
    11983   end.
    11984   END PROCEDURE.
    11985   PROCEDURE sel-cd :
    11986   define variable ri-list as character no-undo .
    11987   define buffer loc_cash-desk  for ub.cash-desk.
    11988   run ref/cashlist.w
    11989       (input  parparentproc
    11990       ,input  'b-sel':U
    11991       ,input  'объект':U
    11992       ,input  get-chkc_context.db-num
    11993       ,input  get-chkc_context.host-code
    11994       ,input  'маг':U
    11995       ,input  shop-code
    11996       ,input  ?
    11997       ,output ri-list
    11998       ) no-error.
    11999   if ri-list = '' then do:
    12000     undo, return error .
    12001   end.
    12002   FIND FIRST loc_cash-desk No-LOCK WHERE
    12003             recid(loc_cash-desk) = integer(ri-list) no-error.
    12004   if not available loc_cash-desk then do:
    12005     undo, return error .
    12006   end.
    12007   if loc_cash-desk.autonomy = integer('2':U) then do:
    12008     message
    12009     "Нельзя создать чек для КАССОВОГО МЕНЕДЖЕРА!"
    12010     view-as alert-box error.
    12011     undo, return error .
    12012   end.
    12013   if loc_cash-desk.pos-type <> dflt-cd then do:
    12014     message
    12015     substitute("На &1&2 установлен тип кассы по умолчанию - &3&4" +
    12016               "Вы уверены, что хотите создать чек для кассы с типом &5?"
    12017               , 'маг':U
    12018               , shop-code
    12019               , dflt-cd
    12020               , chr(10)
    12021               , loc_cash-desk.pos-type)
    12022     view-as alert-box question buttons yes-no update glog.
    12023     if not glog then undo, return error .
    12024   end.
    12025   find first buf_cash-desk no-lock where
    12026             recid(buf_cash-desk) = recid(loc_cash-desk).
    12027   get-chkc_context.pos-type = buf_cash-desk.pos-type.
    12028   END PROCEDURE.
    12029   PROCEDURE setparts :
    12030   define input  parameter p-gds-code as integer   no-undo .
    12031   define input  parameter parunit-cli like ub.bar-code.unit-cli no-undo.
    12032   define input  parameter parnode-code like ub.bar-code.node-code no-undo.
    12033   define variable v-prt-rec as recid no-undo .
    12034   DEFine BUFFER loc-goods for ub.goods.
    12035   define buffer loc-parts for ub.parts.
    12036   define buffer loc-bar-code for ub.bar-code.
    12037   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12038   do:
    12039     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    12040       (input  v-cntxt-db-num
    12041       ,input  v-cntxt-userid
    12042       ,input  0
    12043       ,input  'actn_archive_cost':U
    12044       ,input  'object':U
    12045       ,input  v-host-code
    12046       ,input  tt-chk-doc.obj-type
    12047       ,input  tt-chk-doc.obj-code
    12048       ,input  0
    12049       ,input  0
    12050       ,input  0
    12051       ,input  true
    12052       ,output glog
    12053       )  .
    12054   end.
    12055   if NOT glog then
    12056   return ERROR .
    12057   run str/parts-l.w
    12058     (input parparentproc
    12059     ,input tt-chk-doc.obj-type
    12060     ,input tt-chk-doc.obj-code
    12061     ,input p-gds-code
    12062     ,input ""
    12063     ,input 'ПРОСМОТР':U
    12064     ,input 'остатки':U
    12065     ,input 'текущий':U
    12066     ,input 'выбор':U
    12067     ,output v-prt-rec
    12068     ) .
    12069   if v-prt-rec <> ? then do:
    12070     FIND FIRST loc-parts No-LOCK WHERE recid(loc-parts) = v-prt-rec No-ERROR.
    12071     IF NOT avail loc-parts then return no-apply.
    12072     FIND FIRST loc-goods No-LOCK where
    12073                 loc-goods.artic = loc-parts.artic AND
    12074                 loc-goods.prod-type = loc-parts.prod-type AND
    12075                 loc-goods.prod-code = loc-parts.prod-code No-ERROR.
    12076     FIND FIRST loc-bar-code NO-LOCK WHERE
    12077               loc-bar-code.gds-code = loc-goods.gds-code AND
    12078               loc-bar-code.unit-cli = parunit-cli AND
    12079               loc-bar-code.in-code   = loc-parts.in-code AND
    12080               loc-bar-code.part-code = loc-parts.part-code AND
    12081               loc-bar-code.node-code  = parnode-code NO-ERROR.
    12082     IF AVAIl loc-bar-code then do:
    12083         assign
    12084         tt-chk-gds.b-code = loc-bar-code.b-code
    12085         tt-chk-gds.src-code = (if par-mode = 'ИЗМЕНЕНИЕ':U
    12086                                then tt-chk-gds.src-code else
    12087                                string(loc-bar-code.b-code))
    12088         .
    12089         DISPLAY
    12090         tt-chk-gds.b-code
    12091         tt-chk-gds.src-code
    12092         tt-chk-gds.is-error
    12093         with browse br-gds.
    12094     end.
    12095     else do:
    12096       return error.
    12097     end.
    12098   end.
    12099   END PROCEDURE.
    12100   PROCEDURE setprts :
    12101   DEF INPUT PARAMETER rcg as recid no-undo.
    12102   DEF INPUT PARAMETER rcb as recid no-undo.
    12103   DEF INPUT PARAMETER p-goods-prt-root like ub.goods.prt-root no-undo.
    12104   DEF INPUT PARAMETER ff as logical no-undo.
    12105   DEFINE VARIABLE varline-rid as recid no-undo.
    12106   DEFINE buffer loc_bar-code for ub.bar-code.
    12107   DEFINE buffer root_bar-code for ub.bar-code.
    12108   define buffer loc_gds-prt for ub.gds-prt.
    12109       define buffer buf_goods  for ub.goods .
    12110       find first buf_goods no-lock
    12111         where recid(buf_goods) = rcg
    12112         .
    12113       define variable v-sel-node-code as integer   no-undo .
    12114       run str/prt-ref.w
    12115         (input parparentproc
    12116         ,input  buf_goods.gds-code
    12117         ,input  'выбор':U
    12118         ,input  tt-chk-doc.obj-type
    12119         ,input  tt-chk-doc.obj-code
    12120         ,input  ""
    12121         ,input  ""
    12122         ,output v-sel-node-code
    12123         ) .
    12124       if v-sel-node-code <> ? then do:
    12125           FIND FIRST loc_gds-prt No-LOCK
    12126             WHERE loc_gds-prt.node-code = v-sel-node-code
    12127             No-ERROR.
    12128           IF NOT avail loc_gds-prt then return error.
    12129           if NOT loc_gds-prt.is-term then do:
    12130             message
    12131             "Признак" loc_gds-prt.f-name "нетерминальный" skip
    12132             view-as alert-box Warning.
    12133           end.
    12134           FIND FIRST loc_bar-code No-LOCK WHERE
    12135                      recid(loc_bar-code) = rcb No-ERROR.
    12136           FIND FIRST root_bar-code No-LOCK WHERE
    12137                       root_bar-code.gds-code = loc_bar-code.gds-code AND
    12138                       root_bar-code.unit-cli = loc_bar-code.unit-cli AND
    12139                       root_bar-code.in-code   = "" AND
    12140                       root_bar-code.part-code = "" AND
    12141                       root_bar-code.node-code  = loc_gds-prt.node-code NO-ERROR.
    12142           IF AVAIl root_bar-code then do:
    12143             assign
    12144             tt-chk-gds.src-code = (if par-mode = 'ИЗМЕНЕНИЕ':U
    12145                                    then tt-chk-gds.src-code
    12146                                    else string(root_bar-code.b-code))
    12147             tt-chk-gds.b-code = root_bar-code.b-code.
    12148             DISPLAY
    12149             tt-chk-gds.b-code
    12150             tt-chk-gds.src-code
    12151             tt-chk-gds.is-error
    12152             with browse br-gds.
    12153             run get-price1 in this-procedure ( input loc_bar-code.gds-code, input root_bar-code.node-code) No-ERROR.
    12154             if error-status:error then undo, return error.
    12155             RUN check-ch-bc-ck in this-procedure ( input gp-price-sale, input tt-chk-gds.price-base) no-error.
    12156             if error-status:error then undo, return error.
    12157             if gp-price-sale <> ? then do:
    12158               if ff then do:
    12159                 assign
    12160                 tt-chk-gds.src-price = gp-price-sale
    12161                 .
    12162                 DISPLAY
    12163                 tt-chk-gds.src-price
    12164                 with browse br-gds.
    12165               end.
    12166             end.
    12167             assign
    12168             tt-gds-info.prt-name = ( if loc_gds-prt.node-name = '_Пустая шкала':U
    12169                                     then "-":U
    12170                                     else ( if loc_gds-prt.upper-code = p-goods-prt-root
    12171                                             then "-------------------":U
    12172                                             else loc_gds-prt.f-name ) )
    12173             .
    12174             display
    12175               tt-gds-info.prt-name
    12176               tt-chk-gds.is-error
    12177               with browse br-gds.
    12178           end.
    12179           else do:
    12180             message
    12181               "Отсутствует бар-код для признака" loc_gds-prt.f-name
    12182               view-as alert-box WARNING.
    12183             return.
    12184           end.
    12185       end.
    12186   END PROCEDURE.
    12187   PROCEDURE write-log-and-file :
    12188   define input parameter p-tab-position   as integer      no-undo.
    12189   DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
    12190   DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
    12191   DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
    12192   message
    12193   p-log-string
    12194   view-as alert-box error .
    12195   END PROCEDURE.
    12196   FUNCTION get-good RETURNS CHARACTER
    12197     (
    12198       input  parb-code as integer
    12199     , output pargds-code AS integer
    12200     , output pargds-name as character
    12201     , output parprt-name as character
    12202     , output paris-error as logical) :
    12203   define variable var-artic like ub.goods.artic No-undo.
    12204   run get-good-proc in this-procedure (
    12205   input parb-code
    12206   ,output pargds-code
    12207   ,output pargds-name
    12208   ,output parprt-name
    12209   ,output paris-error
    12210   ,output var-artic) no-error.
    12211   RETURN var-artic.
    12212   END FUNCTION.
    12213   FUNCTION get-pay RETURNS CHARACTER
    12214     ( input parpay-code as integer,  input parcurr-code as integer, output parcurr-name as character) :
    12215   define variable varpay-name like ub.cash-pay.obj-name no-undo.
    12216   run get-pay-proc in this-procedure (
    12217   input  parpay-code
    12218   ,input  parcurr-code
    12219   ,output parcurr-name
    12220   ,output varpay-name ) no-error.
    12221   RETURN varpay-name.
    12222   END FUNCTION.
    12223   FUNCTION get-salesman RETURNS CHARACTER
    12224     ( input  p-salesman as integer, input p-date as date, output p-psn-code as integer) :
    12225   define variable v-psn-code like ub.clients.obj-code No-undo.
    12226   define buffer buf_clients for ub.clients.
    12227   if p-salesman = 0
    12228   or p-salesman = ? then DO:
    12229     P-PSN-CODE = 0.
    12230     return '':U.
    12231   END.
    12232   assign
    12233   v-psn-code = gbclcode-is-this-db-role  ( input 'S':U
    12234                                             ,input get-chkc_context.db-num
    12235                                             ,input p-salesman - (if dflt-cd = 'MAGIA-XML':U
    12236                                                                 then 10000
    12237                                                                 else 0)
    12238                                             ,input p-date
    12239                                                                 )
    12240   no-error .
    12241   if v-psn-code = ? then do:
    12242     p-psn-code = 0.
    12243     return chr(63).
    12244   end.
    12245   else do:
    12246     assign
    12247     p-psn-code = v-psn-code
    12248     .
    12249     find first buf_clients no-lock where
    12250               buf_clients.obj-type = 'чел':U
    12251           AND buf_clients.obj-code = p-psn-code no-error .
    12252     if not available buf_clients then return chr(63).
    12253     return buf_Clients.obj-name.
    12254   end.
    12255   END FUNCTION.
    12256   FUNCTION get-templ-rl-name RETURNS CHARACTER
    12257     ( INPUT p-templ-rl-root AS INTEGER ) :
    12258   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
    12259   if p-templ-rl-root = 0 then return "".
    12260   FIND FIRST buf_dis-rule NO-LOCK WHERE buf_dis-rule.rule-num = p-templ-rl-root NO-ERROR.
    12261   IF AVAILABLE buf_dis-rule THEN RETURN buf_dis-rule.des.
    12262   RETURN "!!!Неизвестный шаблон скидки".
    12263   END FUNCTION.
    12264   FUNCTION GdsName RETURNS CHARACTER
    12265     ( input p-gds-code as integer) :
    12266     define variable v-gds-name as character no-undo .
    12267     define buffer buf_goods for ub.goods .
    12268     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
    12269     if available (buf_goods) then v-gds-name = buf_goods.gds-name .
    12270     RETURN v-gds-name.
    12271   END FUNCTION.
