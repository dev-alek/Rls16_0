     5506   ON CHOOSE OF MENU-ITEM m-prt-2
     5507   DO:
     5508     DEFINE BUFFER b_goods for ub.goods.
     5509     DEFINE BUFFER b_bar-code for ub.bar-code.
     5510    if not avail tt-chk-gds then return.
     5511    FIND FIRST b_bar-code No-LOCK WHERE
     5512                      b_bar-code.b-code = tt-chk-gds.b-code No-ERROR.
     5513     if not avail b_bar-code then return no-apply.
     5514    FIND FIRST b_Goods No-LOCK WHERE
     5515                       b_goods.gds-code = b_bar-code.gds-code No-ERROR.
