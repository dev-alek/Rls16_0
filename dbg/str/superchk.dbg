      751       case p-code :
      752               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
      753               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
      754               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
      755               when 'form_km3':U then do:     assign     p-hist = true.   end.
      756               when 'bal_malina':U then do:     assign     p-hist = true.   end.
