     4612   ON CHOOSE OF B-card IN FRAME Dialog-Frame
     4613   DO:
     4614   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4615   if lookup(self :type
     4616            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     4617            ) = 0
     4618   then do:
     4619     message
     4620       "$Workfile$"
     4621       "Указанному интерфейсному элементу фокус не может быть передан" skip
     4622       "Интерфейсный элемент" self :name  skip
     4623       "Тип" self :type  skip
