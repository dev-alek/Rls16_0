      764   end procedure.
      765   procedure print-xml:
      766   define input parameter p-dsh as handle no-undo .
      767   define input parameter p-file-name-without-ext as character no-undo .
      768   define variable glog as logical no-undo .
      769   define variable v-rowid as rowid no-undo.
      770   define variable v-rowid-list as character no-undo .
      771   define variable v-rowid-list2 as character no-undo .
      772   define variable v-ii as integer no-undo .
      773   define variable v-th as handle no-undo .
      774   define variable v-bh as handle no-undo .
      775   define variable v-dsh  as handle no-undo .
      776   do
      777   on error undo, return error
      778   :
      779     case p-dsh:type:
      780       when "DATASET" then do:
      781         do v-ii = 1 to p-dsh:num-buffers:
      782           v-rowid-list = v-rowid-list +
      783                           (if v-ii = 1 then '' else chr(44)) +
      784                           (if p-dsh:get-buffer-handle(v-ii):available
      785                           then string(p-dsh:get-buffer-handle(v-ii):rowid)
      786                           else '').
      787         end .
      788         v-dsh = p-dsh.
      789       end.
      790       when "temp-table" then do:
      791         if p-dsh:default-buffer-handle:available then do:
      792           v-rowid-list = string(p-dsh:default-buffer-handle:rowid).
      793         end.
      794         v-dsh = p-dsh.
      795       end.
      796       when "buffer" then do:
      797         if not valid-handle(p-dsh:table-handle) then do:
      798           if p-dsh:available then do:
      799             create temp-table v-th  .
      800             v-th:create-like(p-dsh).
      801             v-th:temp-table-prepare(p-dsh:table).
      802             create buffer v-bh for table v-th.
      803             v-bh:buffer-create().
      804             v-bh:buffer-copy(p-dsh).
      805             v-bh:buffer-release().
      806             v-dsh = v-bh.
      807           end.
      808         end.
      809         else do:
      810           v-dsh = p-dsh.
      811         end.
      812       end.
      813     end case.
      814     glog = v-dsh:WRITE-XML("FILE"
      815                           , substitute("&1.xml", p-file-name-without-ext)
      816                           , yes
      817                           , "windows-1251"
      818                           , ''
      819                           , no
      820                           , no  ) no-error.
      821     case p-dsh:type:
      822       when "DATASET" then do:
      823         do v-ii = 1 to p-dsh:num-buffers:
      824           if entry(v-ii,v-rowid-list) <> '' then do:
      825              glog = p-dsh:get-buffer-handle(v-ii):find-by-rowid(TO-ROWID(entry(v-ii,v-rowid-list)))  .
      826           end.
      827           v-rowid-list2 = v-rowid-list2 +
      828                           (if v-ii = 1 then '' else chr(44)) +
      829                           (if p-dsh:get-buffer-handle(v-ii):available
      830                           then string(p-dsh:get-buffer-handle(v-ii):rowid)
      831                           else '').
      832         end .
      833       end.
      834       when "temp-table" then do:
      835         if v-rowid-list <> '' then do:
      836           p-dsh:default-buffer-handle:find-by-rowid(to-rowid(v-rowid-list)).
      837         end.
      838       end.
      839       when "buffer" then do:
      840         if not valid-handle(p-dsh:table-handle) then do:
      841           delete object v-bh.
      842           delete object v-th.
      843         end.
      844       end.
      845     end case.
      846   end.
      847   end procedure.
      848   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      849   procedure sel-date :
      850     define input  parameter p-date-handle as handle    no-undo .
      851     define input  parameter p-description as character no-undo .
      852     do
      853     on error undo, return error return-value
      854     :
      855       if (can-query (p-date-handle, "sensitive")
      856         and
      857         p-date-handle :sensitive = true
      858         )
      859       or (can-query (p-date-handle, "read-only")
      860         and
      861         p-date-handle :read-only = false
      862         )
      863       then do:
      864         if p-date-handle :handle <> focus :handle
      865         then do:
      866           apply "entry":u to p-date-handle .
      867         end.
      868         define variable v-ok            as logical no-undo .
      869         define variable v-curr-sv-date as date no-undo .
      870         assign
      871           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      872         .
      873         if v-curr-sv-date = ?
      874         then do:
      875           run gbl/getcurdt.p
      876             (output v-curr-sv-date
      877             ) .
      878         end.
      879         if v-curr-sv-date <> ?
      880         then do:
      881           run gbl/d-inpday.w
      882             (input ?
      883             ,input "Выбор даты"
      884             ,input p-description
      885             ,input ""
      886             ,input-output v-curr-sv-date
      887             ,output v-ok
      888             ).
      889           if v-ok = true
      890           then do:
      891             assign
      892               p-date-handle :screen-value = string(v-curr-sv-date) .
      893             .
      894           end.
      895         end.
      896       end.
      897     end.
      898   end procedure.
      899    define  temp-table tmprecid
      900       field Frecid as recid init ?
      901       field fnum as character
      902       field fTable as character
      903    index num  fnum Frecid
      904    index itable is primary unique fTable Frecid
      905    .
      906   define variable fSelect as logical no-undo format "*/" column-label "".
      907   function isSelect return logical
      908       (iBuffer as handle  ):
      909       define buffer tmprecid for tmprecid.
      910       if iBuffer:available
      911       then
      912          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      913                                and tmprecid.Frecid = iBuffer:recid
      914          no-lock no-error.
      915       return available tmprecid.
      916    end.
      917   function setSelect return logical
      918       (iBuffer as handle  ):
      919       define buffer tmprecid for tmprecid.
      920       if iBuffer:available
      921       then do:
      922          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      923                                and tmprecid.Frecid = iBuffer:recid
      924          no-lock no-error.
      925          if available tmprecid
      926          then
      927             delete tmprecid.
      928          else do:
      929             create tmprecid.
      930             assign
      931                tmprecid.fTable = iBuffer:TABLE
      932                tmprecid.Frecid = iBuffer:recid
      933             .
      934          end.
      935       end.
      936       return available tmprecid.
      937    end.
      938    procedure rid-keep :
      939        run gbl/rid-keep.p (input table tmprecid) no-error.
      940    end.
      941    procedure rid-rest :
      942         run gbl/rid-rest.p (output table tmprecid) no-error.
      943    end.
      944   function ChkType returns character
      945           (input p-chk-type as integer):
      946   define variable result as character no-undo.
      947   result = entry(lookup(string(p-chk-type),'1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U), 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Приход_Корр,Расход_Корр':U ) no-error .
      948   return result.
      949   end function.
      950   function PayType returns character
      951           (input p-pay-code as integer):
      952   define variable result as character no-undo.
      953   find first ub.pay-type where ub.pay-type.obj-code = p-pay-code no-error .
      954   if available (ub.pay-type) then result = ub.pay-type.obj-name .
      955   else result = "" .
      956   return result.
      957   end function.
      958   function OsnovCorr returns character
      959           (input p-corr-osnov as integer):
      960   define variable result as character no-undo.
      961   find first ub.Code no-lock where ub.Code.code = string(p-corr-osnov) and ub.Code.parent = "OsnovCorr" no-error .
      962   if available (ub.Code) then result = ub.Code.CodeName .
      963   else result = "" .
      964   return result.
      965   end function.
