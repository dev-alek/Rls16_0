      120   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      121   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      122   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      123   define variable gp-excise     like ub.price-list.excise     no-undo.
      124   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
