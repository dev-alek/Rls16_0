     5320   ON LEAVE OF tt-chk-doc.d-card IN FRAME Dialog-Frame
     5321   DO:
     5322     assign
     5323     tt-chk-doc.d-card
     5324     .
     5325     find first buf_dis-card no-lock where
     5326                 buf_dis-card.d-card = trim(tt-chk-doc.d-card) no-error.
     5327     if avail buf_dis-card then do:
     5328       if buf_dis-card.status_ = 'неисп':U
     5329       or buf_dis-card.status_ = 'смкли':U
     5330       then do:
     5331         message
     5332         substitute("Нельзя создать чек с картой &1&2" +
     5333                     "Карта имеет статус &3, &4"
     5334                     , buf_dis-card.d-card
     5335                     , chr(10)
     5336                     , buf_dis-card.status_
     5337                     , (if buf_dis-card.status_ = 'неисп':U
     5338                       then "карта должна быть ОКОНЧАТЕЛЬНО удалена"
     5339                       else "карта будет доступна по окончании процесса смены владельца" )
     5340                      )
     5341         view-as alert-box error .
     5342         assign
     5343         tt-chk-doc.d-card = '':U
     5344         .
     5345         display
     5346         tt-chk-doc.d-card
     5347         with frame Dialog-Frame .
     5348         return no-apply.
     5349       end.
     5350       find first buf_clients no-lock where
     5351                   buf_clients.obj-type = buf_dis-card.cli-type
     5352              AND buf_clients.obj-code = buf_dis-card.cli-code no-error.
     5353       if available buf_clients then do:
     5354           display
     5355           buf_clients.obj-name @ f-cli-name
     5356           with frame Dialog-Frame.
     5357       end.
     5358       else do:
     5359           release buf_clients.
     5360           display
     5361           chr(63) @ f-cli-name
     5362           with frame Dialog-Frame.
     5363       end.
     5364     end.
     5365     else do:
     5366           release buf_clients.
     5367           display
     5368           chr(63) @ f-cli-name
     5369           with frame Dialog-Frame.
     5370     end.
     5371   END.
