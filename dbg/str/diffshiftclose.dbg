        1   DEFINE TEMP-TABLE X_shift-param NO-UNDO LIKE ub.shift-param
        2       field gds-name as character.
        3   define input  parameter parparentproc         as widget-handle no-undo .
        4   define input parameter p-mode           as character     no-undo.
        5   define input parameter p-obj-type       as character     no-undo.
        6   define input parameter p-obj-code       as integer       no-undo.
        7   define input parameter p-shift-date     as date          no-undo.
        8   define input parameter p-shift-num      as integer       no-undo.
        9   define input parameter p-shift-name     as character     no-undo.
       10   define input parameter p-type           as character     no-undo.
       11   define output parameter p-ok            as logical       no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Список выявленных отклонений".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   function fnc-convert-dot-to-colon returns character
       79       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
       80   function fnc-convert-dot-to-colon returns character
       81   (input p-data as decimal, input p-accur as character, input p-num as integer):
       82       define variable result as character no-undo.
       83       define variable v-str-result as character no-undo.
       84       if p-data = ? then p-data = 0 .
       85       p-data = round(p-data, p-num).
       86       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
       87       return v-str-result.
       88   END FUNCTION.
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define  stream PrnLibStream.
       91   procedure prn-lib-prn-file :
       92     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       93     define input parameter p-DIsabledoptions as integer no-undo .
       94     define variable v-report-name as character no-undo .
       95     define variable v-user-action as character no-undo .
       96     define variable v-printed     as logical   no-undo .
       97     define variable v-exist       as logical   no-undo .
       98     do
       99       on error undo, return error
      100       :
      101       run prn-lib-get-report-name  in this-procedure (
      102         input parParentProc
      103         ,output v-report-name
      104         ).
      105   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      107     (input  v-report-name
      108     ,input  2
      109     ,output v-exist
      110     )  .
      111       if NOT v-exist then
      112       DO:
      113         Message
      114           "Нет заданий на печать ! "
      115           view-as alert-box .
      116         Return  .
      117       End.
      118       run gbl/prnfilen.w
      119         (input  ""
      120         ,input  p-DisabledOptions
      121         ,input  string(v-report-name )
      122         ,input  7
      123         ,output v-user-action
      124         ,output v-printed
      125         ) .
      126       if v-printed then
      127       do:
      128         return "YES" .
      129       end.
      130       else
      131       do:
      132         return "NO" .
      133       end.
      134     end.
      135   end procedure.
      136   procedure prn-lib-open-stream :
      137     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      138     define input parameter p-page-size    as integer no-undo .
      139     define input parameter p-is-stream    as logical no-undo .
      140     define input parameter p-append       as logical no-undo .
      141     define variable v-report-name as character no-undo .
      142     do
      143       on error undo, return error
      144       :
      145       run prn-lib-get-report-name  in this-procedure (
      146         input parParentProc
      147         ,output v-report-name
      148         ).
      149       if p-is-stream then
      150       do:
      151         if p-append then
      152         do:
      153           output stream PrnLibStream to value( v-report-name )
      154             page-size value(p-page-size) append .
      155         end.
      156         if not p-append then
      157         do:
      158           output stream PrnLibStream to value( v-report-name )
      159             page-size value(p-page-size) .
      160         end.
      161       end.
      162       if not p-is-stream then
      163       do:
      164         if p-append then
      165         do:
      166           output to value( v-report-name )
      167             page-size value(p-page-size) append .
      168         end.
      169         if not p-append then
      170         do:
      171           output to value( v-report-name )
      172             page-size value(p-page-size) .
      173         end.
      174       end.
      175     end.
      176   end procedure.
      177   procedure prn-lib-open-exp :
      178     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      179     define input parameter p-is-stream    as logical no-undo .
      180     define input parameter p-is-append    as logical no-undo .
      181     define output parameter p-ReportFileName as char init "report" no-undo.
      182     define output parameter p-process as logical no-undo .
      183     define variable glog as logical no-undo .
      184     do
      185       on error undo, return error
      186       :
      187       SYSTEM-DIALOG GET-FILE p-ReportFileName
      188         TITLE      "Укажите путь"
      189         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      190         ASK-OVERWRITE
      191         CREATE-TEST-FILE
      192         SAVE-AS
      193         USE-FILENAME
      194         DEFAULT-EXTENSION "txt"
      195         UPDATE glog
      196         .
      197       if not glog then  return.
      198       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      199       if p-is-stream then
      200       do:
      201         if p-is-append then
      202         do:
      203           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      204         end.
      205         else
      206         do:
      207           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      208         end.
      209       end.
      210       else
      211       do:
      212         if p-is-append then
      213         do:
      214           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      215         end.
      216         else
      217         do:
      218           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      219         end.
      220       end.
      221       p-process = yes.
      222     end.
      223   end procedure.
      224   procedure prn-lib-get-report-name :
      225     define input parameter parParentProc  as widget-handle no-undo.
      226     define output parameter p-report-name as character no-undo .
      227     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      228   end procedure.
      229   procedure prn-lib-reportviewer-report-name :
      230     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      231     define input parameter p-report-name-html as character no-undo .
      232     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      233   end procedure.
      234   procedure prn-lib-reportviewer :
      235     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      236     define input parameter p-report-name-html as character no-undo .
      237     define input parameter p-param        as character no-undo .
      238     define variable v-excel           as character no-undo init 'TRUE' .
      239     define variable v-value-character as character no-undo .
      240     define variable v-value-integer   as character no-undo .
      241     define variable v-value-date      as date      no-undo .
      242     define variable v-value-decimal   as decimal   no-undo .
      243     define variable rep-excel         as logical   no-undo .
      244     define variable excel-string      as character no-undo .
      245     define variable v-param-type      as character no-undo .
      246     define variable v-tth             as handle    no-undo .
      247     run adm/shattri.p (
      248       input "get":U
      249       ,input  ""
      250       ,input  0
      251       ,input  'report-glob':U
      252       ,input  'rep-excel':U
      253       ,output v-value-character
      254       ,output v-value-date
      255       ,output v-value-decimal
      256       ,output v-value-integer
      257       ,output rep-excel
      258       ,output v-param-type
      259       ,INPUT-OUTPUT table-handle v-tth
      260       )  .
      261     if rep-excel then v-excel = "TRUE" .
      262     else v-excel = "FALSE" .
      263     if p-param eq ""
      264     then
      265        p-param = "EXCEL:" + v-excel.
      266     else
      267        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      268     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      269   end procedure.
      270   define variable v-title as character no-undo .
      271   define stream Out-Stream .
      272   define stream OutStr-html.
      273   function dev returns decimal
      274       (input p-type as character) forward .
      275   DEFINE BUTTON b-cancel AUTO-GO
      276       LABEL "&Выход"
      277       SIZE 15 BY 1.
      278   DEFINE BUTTON B-print
      279       LABEL "Печать"
      280       SIZE 10 BY 1.
      281   DEFINE BUTTON B-update
      282       LABEL "Указать расхождение"
      283       SIZE 23 BY 1.
      284   DEFINE BUTTON b-help
      285       LABEL "Помощь":L
      286       SIZE 7 BY 1.
      287   DEFINE QUERY BROWSE-2 FOR
      288       X_shift-param SCROLLING.
      289   DEFINE BROWSE BROWSE-2
      290       QUERY BROWSE-2 NO-LOCK DISPLAY
      291       X_shift-param.gds-code column-label "Код топлива" FORMAT ">>>>>999999999":U width 15
      292       X_shift-param.gds-name column-label "Наименование" FORMAT "X(48)":U width 20
      293       X_shift-param.loc1 column-label "№ резерв." FORMAT "X(8)":U width 10
      294       X_shift-param.system-cli-qnty column-label "Расч. остаток!на конец смены, кг" FORMAT "->>>>>>>>>>9.99":U width 20
      295       X_shift-param.fact-stock-end column-label "Факт. остаток!на конец смены, кг" FORMAT "->>>>>>>>>>9.99":U width 20
      296       X_shift-param.cash-qnty column-label "Объем продаж!на кассе, л" FORMAT "->>>>>>>>>>9.99":U width 15
      297       X_shift-param.meas-qnty column-label "Объем продаж!по счетчикам ТРК, л" FORMAT "->>>>>>>>>>9.99":U width 20
      298       X_shift-param.tech-refuell column-label "Техпролив, л" FORMAT "->>>>>>>>9.99":U width 15
      299       X_shift-param.dev-mass column-label "Допустимое!отклонение в кг" FORMAT "->>>>9.99":U width 15
      300       X_shift-param.diff-stock-end column-label "Факт отклонение по!остаткам в кг" FORMAT "->>>>>>>>>>>>>>>>>>>>>>>>>>9.99":U  width 20
      301       X_shift-param.diff-cash-trk column-label "Разница по!кассе и ТРК, л" FORMAT "->>>>>>>>>>>>>>>>>9.99":U  width 15
      302       dev(p-type) column-label "Превышение допустимого!отклонения на, кг" FORMAT "->>>>>>>>>>>>>>>>>9.99":U  width 25
      303       X_shift-param.disc-diffMass column-label "Причина расхождения/!номер заявки в ЦДС" format "X(256)":U  width 30
      304       X_shift-param.disc-diffTRK column-label "Причина расхождения/!номер заявки в ЦДС" format "X(256)":U  width 30
      305   enable
      306       X_shift-param.disc-diffMass
      307       X_shift-param.disc-diffTRK
      308       WITH NO-ROW-MARKERS SEPARATORS SIZE 106.5 BY 13.75.
      309   DEFINE FRAME Dialog-Frame
      310       B-print AT ROW 1.25 COL 107.5 RIGHT-ALIGNED WIDGET-ID 6
      311       b-cancel AT ROW 1.25 COL 2 WIDGET-ID 8
      312       B-update AT ROW 1.25 COL 17 WIDGET-ID 4
      313       b-help AT ROW 1 COL 92.5
      314       BROWSE-2 AT ROW 2.5 COL 2 WIDGET-ID 200
      315       SPACE(0.49) SKIP(0.37)
      316       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      317       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      318       TITLE "<insert dialog title>" WIDGET-ID 100.
      319   ASSIGN
      320       FRAME Dialog-Frame:SCROLLABLE = FALSE
      321       FRAME Dialog-Frame:HIDDEN     = TRUE.
      322   assign
      323       BROWSE-2:column-resizable in frame Dialog-Frame = true .
      324   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      325       DO:
      326           APPLY "END-ERROR":U TO SELF.
      327       END.
      328   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      329       DO:
      330           run proc-b-print (p-type) no-error.
      331           if error-status:error then return no-apply.
      332       END.
      333   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      334       DO:
      335           define variable v-close as logical no-undo .
      336           if p-mode <> 'ПРОСМОТР':U then
      337           do:
      338               case p-type:
      339                   when "diff-mass" then
      340                       do:
      341                           find first X_shift-param where X_shift-param.disc-diffMass = "" and
      342                               X_shift-param.error-mass no-error .
      343                           if available (X_shift-param) then
      344                           do:
      345                               message "Причина расхождения указана не для всех найденных отклонений." skip
      346                                   "Отменить закрытие смены?"
      347                                   view-as alert-box question buttons yes-no update v-close.
      348                               if not v-close then return no-apply .
      349                           end.
      350                           else p-ok = true .
      351                       end.
      352                   when "diff-TRK" then
      353                       do:
      354                           find first X_shift-param where X_shift-param.disc-diffTRK = "" and
      355                               X_shift-param.error-paid-trans no-error .
      356                           if available (X_shift-param) then
      357                           do:
      358                               message "Причина расхождения указана не для всех найденных отклонений." skip
      359                                   "Отменить закрытие смены?"
      360                                   view-as alert-box question buttons yes-no update v-close.
      361                               if not v-close then return no-apply .
      362                           end.
      363                           else p-ok = true .
      364                       end.
      365               end case .
      366           end.
      367       END.
      368   ON CHOOSE OF B-update IN FRAME Dialog-Frame
      369       DO:
      370           define buffer buf_shift-param for ub.shift-param .
      371           define variable row_param as rowid no-undo .
      372           if not available (X_shift-param) then
      373           do:
      374               message "Не выбрана строка!"
      375                   view-as alert-box.
      376               return .
      377           end.
      378           if p-type = "diff-mass" then
      379           do:
      380               row_param = rowid(X_shift-param) .
      381               find first X_shift-param where rowid(X_shift-param) = row_param .
      382               run str/diffShift_Name.w (input-output X_shift-param.disc-diffMass
      383                   ) no-error .
      384               for first buf_shift-param exclusive-lock where buf_shift-param.obj-code = X_shift-param.obj-code and
      385                   buf_shift-param.obj-type = X_shift-param.obj-type and
      386                   buf_shift-param.shift-date = X_shift-param.shift-date and
      387                   buf_shift-param.shift-num = X_shift-param.shift-num and
      388                   buf_shift-param.shift-name = X_shift-param.shift-name and
      389                   buf_shift-param.gds-code = X_shift-param.gds-code and
      390                   buf_shift-param.pl-code = X_shift-param.pl-code:
      391                   buf_shift-param.disc-diffMass = X_shift-param.disc-diffMass .
      392               end.
      393           end.
      394           else
      395           do:
      396               row_param = rowid(X_shift-param) .
      397               find first X_shift-param where rowid(X_shift-param) = row_param .
      398               run str/diffShift_Name.w (input-output X_shift-param.disc-diffTRK
      399                   ) no-error .
      400               for first buf_shift-param exclusive-lock where buf_shift-param.obj-code = X_shift-param.obj-code and
      401                   buf_shift-param.obj-type = X_shift-param.obj-type and
      402                   buf_shift-param.shift-date = X_shift-param.shift-date and
      403                   buf_shift-param.shift-num = X_shift-param.shift-num and
      404                   buf_shift-param.shift-name = X_shift-param.shift-name and
      405                   buf_shift-param.gds-code = X_shift-param.gds-code and
      406                   buf_shift-param.pl-code = X_shift-param.pl-code:
      407                   buf_shift-param.disc-diffTRK = X_shift-param.disc-diffTRK .
      408               end.
      409           end.
      410           run init-temp .
      411           BROWSE-2:refresh () no-error .
      412           reposition BROWSE-2 to rowid row_param no-error .
      413       END.
      414   ON row-leave OF BROWSE-2 IN FRAME Dialog-Frame
      415       DO:
      416           define buffer bf_shift-param for ub.shift-param .
      417           find current X_shift-param exclusive-lock .
      418           assign browse BROWSE-2
      419               X_shift-param.disc-diffMass
      420               X_shift-param.disc-diffTRK
      421               .
      422           find first bf_shift-param exclusive-lock where bf_shift-param.obj-code = X_shift-param.obj-code and
      423               bf_shift-param.obj-type = X_shift-param.obj-type and
      424               bf_shift-param.shift-date = X_shift-param.shift-date and
      425               bf_shift-param.shift-num = X_shift-param.shift-num and
      426               bf_shift-param.shift-name = X_shift-param.shift-name and
      427               bf_shift-param.gds-code = X_shift-param.gds-code and
      428               bf_shift-param.pl-code = X_shift-param.pl-code no-error .
      429           if available (bf_shift-param) then
      430           do:
      431               assign
      432                   bf_shift-param.disc-diffMass = X_shift-param.disc-diffMass
      433                   bf_shift-param.disc-diffTRK  = X_shift-param.disc-diffTRK
      434                   .
      435           end.
      436           BROWSE-2:refresh () .
      437       END.
      438   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      439       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      440   MAIN-BLOCK:
      441   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      442       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      443   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      444   on help of frame Dialog-Frame
      445   do:
      446     run gbl/app_help.p
      447       (input this-procedure :file-name
      448       ,input ''
      449       ,input ?
      450       ) no-error.
      451     if error-status :error then do:
      452       message
      453         "Ошибка при вызове помощи"
      454         error-status :get-message(1)
      455         view-as alert-box .
      456     end.
      457   end.
      458   run minbtn-set in this-procedure .
      459   on choose of b-help in frame Dialog-Frame
      460   do:
      461     apply "help":u to frame Dialog-Frame .
      462   end.
      463   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      464   procedure minbtn-set :
      465       do
      466           on error undo, return error return-value
      467           :
      468           define variable ii              as integer       no-undo .
      469           define variable fh              as widget-handle no-undo .
      470           define variable hh              as widget-handle no-undo .
      471           define variable v-h             as handle        extent 4 no-undo .
      472           define variable v-name-button   as character     no-undo .
      473           define variable v-help-old-x    as decimal       no-undo .
      474           define variable v-help-old-y    as decimal       no-undo .
      475           define variable v-help-old-size as decimal       no-undo .
      476           define variable v-frame-width   as decimal       no-undo .
      477           define variable jj              as integer       no-undo .
      478           do
      479               on error undo, return error
      480               :
      481               assign
      482                   v-frame-width = frame Dialog-Frame:width - 0.3
      483                   fh            = frame Dialog-Frame:first-child
      484                   hh            = fh:first-child
      485                   ii            = 1
      486                   .
      487               do while valid-handle(hh):
      488                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      489                   do:
      490                       case lc(hh:name) :
      491                           when "b-help" then
      492                               do:
      493                                   hh:load-image-up("cmp/b-help.bmp":u) .
      494                                   hh:load-image-down("cmp/b-help.bmp":u) .
      495                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      496                                   hh:TOOLTIP = "Помощь" .
      497                                   v-help-old-x = hh:column .
      498                                   v-help-old-y = hh:row    .
      499                                   v-help-old-size = hh:width .
      500                                   hh:width-chars = 2.5 .
      501                               end.
      502                           when "b-print" then
      503                               do:
      504                                   hh:load-image("cmp/b-print.bmp":u) .
      505                                   hh:TOOLTIP = "Печать" .
      506                                   v-h[ii] = hh:handle .
      507                                   ii = ii + 1 .
      508                                   hh:width-chars = 3 .
      509                               end.
      510                           when "b-history" or
      511                           when "b-hist" then
      512                               do:
      513                                   hh:load-image("cmp/b-hist.bmp":u) .
      514                                   hh:TOOLTIP = "История" .
      515                                   v-h[ii] = hh:handle .
      516                                   ii = ii + 1 .
      517                                   hh:width-chars = 3 .
      518                               end.
      519                           when "b-sch" then
      520                               do:
      521                                   hh:load-image("cmp/b-sch.bmp":u) .
      522                                   hh:TOOLTIP = "Установка Фильтра" .
      523                                   v-h[ii] = hh:handle .
      524                                   ii = ii + 1 .
      525                                   hh:width-chars = 3 .
      526                               end.
      527                           when "b-hist-user" then
      528                               do:
      529                                   hh:load-image("cmp/b-hist.bmp":u) .
      530                                   hh:TOOLTIP = "История пользователя" .
      531                                   ii = ii + 1 .
      532                               end.
      533                       end case.
      534                   end.
      535                   hh = hh:next-sibling.
      536               end.
      537               b-help:column = v-frame-width - b-help:width-chars.
      538               jj = 0.
      539               repeat ii = 4 to 1 by -1 :
      540                   if valid-handle (v-h[ii] ) then
      541                   do:
      542                       jj  = jj + 1 .
      543                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      544                       v-h[ii]:row    = v-help-old-y .
      545                   end.
      546               end.
      547           end.
      548       end.
      549   end procedure.
      550   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      551   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      552   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      553   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      554   define variable v-diasize-current-frame-width  as decimal   no-undo .
      555   define variable v-diasize-current-frame-height as decimal   no-undo .
      556   define variable v-diasize-change-size          as logical   no-undo .
      557   define variable v-diasize-resize-button        as handle    no-undo .
      558   define variable v-diasize-wndmax               as logical   no-undo .
      559   define variable v-diasize-wndstore             as logical   no-undo .
      560   define variable v-diasize-proc-name            as character no-undo .
      561   define variable v-diasize-browse-handle        as handle    no-undo .
      562   define variable v-diasize-browse-number        as integer   no-undo .
      563   define variable v-diasize-need-full-display    as logical   no-undo init false .
      564   define temp-table temp-diasize-handle no-undo
      565     field handle-value  as handle
      566     field save-position as decimal
      567     index xpk is primary unique handle-value
      568     .
      569   define temp-table temp-browse-handle no-undo
      570     field browse-type   as character
      571     field browse-number as integer
      572     field browse-handle as handle
      573     field original-size as decimal
      574     index xpk is primary unique browse-type browse-number
      575     index xie browse-type browse-handle
      576   .
      577   procedure diasize_change-height :
      578     define input  parameter p-change-value  as decimal   no-undo .
      579     define input  parameter p-move-resize   as logical   no-undo .
      580     define variable v-field-group-handle    as handle    no-undo .
      581     define variable v-object-handle         as handle    no-undo .
      582     define variable v-frame-height          as decimal   no-undo .
      583     define variable v-frame-virtual-height  as decimal   no-undo .
      584     define variable v-browse-height         as decimal   no-undo .
      585     define variable v-window-height         as decimal   no-undo .
      586     define variable v-window-virtual-height as decimal   no-undo .
      587     define variable v-change-sign           as integer   no-undo .
      588     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      589     define buffer buf_temp-browse-handle  for temp-browse-handle .
      590     if p-change-value > 0
      591     then do:
      592       if frame Dialog-Frame :height + p-change-value
      593           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      594       then do:
      595         assign
      596           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      597                           - (frame Dialog-Frame :height-chars)
      598         .
      599         if p-change-value <= 0
      600         then do:
      601           run diasize_position-resize-button in this-procedure .
      602           return .
      603         end.
      604       end.
      605     end.
      606     if p-change-value < 0
      607     then do:
      608       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      609       then do:
      610         assign
      611           p-change-value = v-diasize-orig-frame-height
      612                          - (frame Dialog-Frame :height-chars)
      613         .
      614         if p-change-value >= 0
      615         then do:
      616           run diasize_position-resize-button in this-procedure .
      617           return .
      618         end.
      619       end.
      620     end.
      621     if p-change-value >= 0
      622     then do:
      623       assign
      624         v-change-sign = 1
      625       .
      626     end.
      627     else do:
      628       assign
      629         v-change-sign = -1
      630       .
      631     end.
      632     assign
      633       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      634     .
      635     if p-change-value = 0
      636     then do:
      637       run diasize_position-resize-button in this-procedure .
      638       return .
      639     end.
      640     move_block:
      641     do
      642     on error undo move_block, retry move_block
      643     :
      644       if retry
      645       then do:
      646         do
      647         on error undo move_block, leave move_block
      648         :
      649           if p-change-value > 0
      650           then do:
      651             for each buf_temp-diasize-handle
      652             on error undo, next
      653             :
      654               assign
      655                 v-object-handle = buf_temp-diasize-handle.handle-value
      656               .
      657               if v-object-handle <> v-diasize-resize-button
      658               then do:
      659                 assign
      660                   v-object-handle :row = buf_temp-diasize-handle.save-position
      661                 .
      662               end.
      663             end.
      664             assign
      665               v-diasize-browse-handle :height = v-browse-height
      666             .
      667             for each buf_temp-browse-handle
      668               where buf_temp-browse-handle.browse-type = 'height':u
      669             on error undo, next
      670             :
      671               assign
      672                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      673               .
      674             end.
      675             assign
      676               frame Dialog-Frame :height = v-frame-height
      677             .
      678             if frame Dialog-Frame :scrollable = true
      679             then do:
      680               assign
      681                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      682               .
      683             end.
      684             run diasize_position-resize-button in this-procedure .
      685           end.
      686           else do:
      687             if frame Dialog-Frame :scrollable = true
      688             then do:
      689               assign
      690                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      691               .
      692             end.
      693             assign
      694               frame Dialog-Frame :height = v-frame-height
      695             .
      696             assign
      697               v-diasize-browse-handle :height = v-browse-height
      698             .
      699             for each buf_temp-browse-handle
      700               where buf_temp-browse-handle.browse-type = 'height':u
      701             on error undo, next
      702             :
      703               assign
      704                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      705               .
      706             end.
      707             for each buf_temp-diasize-handle
      708             on error undo, next
      709             :
      710               assign
      711                 v-object-handle = buf_temp-diasize-handle.handle-value
      712               .
      713               if v-object-handle <> v-diasize-resize-button
      714               then do:
      715                 assign
      716                   v-object-handle :row = buf_temp-diasize-handle.save-position
      717                 .
      718               end.
      719             end.
      720             run diasize_position-resize-button in this-procedure .
      721           end.
      722           assign
      723             v-diasize-change-size = false
      724           .
      725           leave move_block .
      726         end.
      727       end.
      728       assign
      729         v-diasize-need-full-display = true
      730       .
      731       if v-diasize-change-size = false
      732       then do:
      733         assign
      734           v-diasize-change-size = true
      735         .
      736       end.
      737       else do:
      738         return .
      739       end.
      740       assign
      741         v-frame-height = frame Dialog-Frame :height
      742         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      743         v-browse-height = v-diasize-browse-handle :height
      744       .
      745       for each buf_temp-browse-handle
      746         where buf_temp-browse-handle.browse-type = 'height':u
      747       :
      748         assign
      749           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      750         .
      751       end.
      752       for each buf_temp-diasize-handle
      753       :
      754         delete buf_temp-diasize-handle .
      755       end.
      756       assign
      757         v-field-group-handle = frame Dialog-Frame :first-child
      758       .
      759       do while valid-handle(v-field-group-handle)
      760       :
      761         assign
      762           v-object-handle = v-field-group-handle :first-child
      763         .
      764         do while valid-handle(v-object-handle)
      765         :
      766           if  v-object-handle <> v-diasize-browse-handle :handle
      767           and can-query(v-object-handle, "row")
      768           and can-query(v-object-handle, "height")
      769           and ( v-object-handle :row > v-diasize-browse-handle :row )
      770           then do:
      771             find first buf_temp-browse-handle
      772               where buf_temp-browse-handle.browse-type   = 'height':u
      773                 and buf_temp-browse-handle.browse-handle = v-object-handle
      774               no-error .
      775             if available buf_temp-browse-handle
      776             then do:
      777             end.
      778             else do:
      779               create buf_temp-diasize-handle .
      780               assign
      781                 buf_temp-diasize-handle.handle-value  = v-object-handle
      782                 buf_temp-diasize-handle.save-position = v-object-handle :row
      783               .
      784             end.
      785           end.
      786           assign
      787             v-object-handle = v-object-handle :next-sibling
      788           .
      789         end.
      790         assign
      791           v-field-group-handle = v-field-group-handle :next-sibling
      792         .
      793       end.
      794       do with frame Dialog-Frame
      795       :
      796         hide v-diasize-resize-button .
      797         assign
      798           v-diasize-resize-button :row    = 1
      799           v-diasize-resize-button :column = 1
      800         .
      801       end.
      802       if p-change-value > 0
      803       then do:
      804         if frame Dialog-Frame :scrollable = true
      805         then do:
      806           assign
      807             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      808             no-error .
      809           if error-status :error
      810           or error-status :get-message(1) <> ""
      811           then do:
      812             undo move_block, retry move_block .
      813           end.
      814         end.
      815         assign
      816           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      817           no-error .
      818         if error-status :error
      819         or error-status :get-message(1) <> ""
      820         then do:
      821           undo move_block, retry move_block .
      822         end.
      823         assign
      824           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      825           no-error .
      826         if error-status :error
      827         or error-status :get-message(1) <> ""
      828         then do:
      829           undo move_block, retry move_block .
      830         end.
      831         for each buf_temp-browse-handle
      832           where buf_temp-browse-handle.browse-type = 'height':u
      833         on error undo move_block, retry move_block
      834         :
      835           assign
      836             buf_temp-browse-handle.browse-handle :height
      837               = buf_temp-browse-handle.browse-handle :height + p-change-value
      838             no-error .
      839           if error-status :error
      840           or error-status :get-message(1) <> ""
      841           then do:
      842             undo move_block, retry move_block .
      843           end.
      844         end.
      845         for each buf_temp-diasize-handle
      846         on error undo move_block, retry move_block
      847         :
      848           assign
      849             v-object-handle = buf_temp-diasize-handle.handle-value
      850           .
      851           if v-object-handle <> v-diasize-resize-button
      852           then do:
      853             assign
      854               v-object-handle :row = v-object-handle :row + p-change-value
      855               no-error .
      856             if error-status :error
      857             or error-status :get-message(1) <> ""
      858             then do:
      859               undo move_block, retry move_block .
      860             end.
      861           end.
      862         end.
      863       end.
      864       else do:
      865         for each buf_temp-diasize-handle
      866         on error undo move_block, retry move_block
      867         :
      868           assign
      869             v-object-handle = buf_temp-diasize-handle.handle-value
      870           .
      871           if v-object-handle <> v-diasize-resize-button
      872           then do:
      873             assign
      874               v-object-handle :row = v-object-handle :row + p-change-value
      875               no-error .
      876             if error-status :error
      877             or error-status :get-message(1) <> ""
      878             then do:
      879               undo move_block, retry move_block .
      880             end.
      881           end.
      882         end.
      883         assign
      884           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      885           no-error .
      886         if error-status :error
      887         or error-status :get-message(1) <> ""
      888         then do:
      889           undo move_block, retry move_block .
      890         end.
      891         for each buf_temp-browse-handle
      892           where buf_temp-browse-handle.browse-type = 'height':u
      893         on error undo move_block, retry move_block
      894         :
      895           assign
      896             buf_temp-browse-handle.browse-handle :height
      897               = buf_temp-browse-handle.browse-handle :height + p-change-value
      898             no-error .
      899           if error-status :error
      900           or error-status :get-message(1) <> ""
      901           then do:
      902             undo move_block, retry move_block .
      903           end.
      904         end.
      905         assign
      906           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      907           no-error .
      908         if error-status :error
      909         or error-status :get-message(1) <> ""
      910         then do:
      911           undo move_block, retry move_block .
      912         end.
      913         if frame Dialog-Frame :scrollable = true
      914         then do:
      915           assign
      916             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      917             no-error .
      918           if error-status :error
      919           or error-status :get-message(1) <> ""
      920           then do:
      921             undo move_block, retry move_block .
      922           end.
      923         end.
      924       end.
      925       if p-move-resize = true
      926       then do:
      927         run diasize_position-resize-button in this-procedure .
      928       end.
      929       if v-diasize-wndstore = true
      930       then do:
      931         if connected("ub") = true
      932         then do:
      933           define variable v-cntxt-db-num        as integer   no-undo .
      934           define variable v-cntxt-userid        as character no-undo .
      935           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      936                                             , OUTPUT v-cntxt-userid
      937                                             ) .
      938           run gbl/wndsizew.p
      939             (input  v-cntxt-db-num
      940             ,input  v-cntxt-userid
      941             ,input  v-diasize-proc-name
      942             ,input  'height':u
      943             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      944             ) .
      945         end.
      946       end.
      947     end.
      948     assign
      949       v-diasize-change-size = false
      950     .
      951   end procedure.
      952   procedure diasize_set-height :
      953     define input  parameter p-new-height  as decimal   no-undo .
      954     define input  parameter p-move-resize as logical   no-undo .
      955     do
      956     on error undo, return error return-value
      957     :
      958       run diasize_change-height in this-procedure
      959         (input  (p-new-height - frame Dialog-Frame :height)
      960         ,input  p-move-resize
      961         ) .
      962     end.
      963   end procedure.
      964   procedure diasize_change-width :
      965     define input  parameter p-change-value as decimal   no-undo .
      966     define input  parameter p-move-resize  as logical   no-undo .
      967     define variable v-field-group-handle   as handle    no-undo .
      968     define variable v-object-handle        as handle    no-undo .
      969     define variable v-frame-width          as decimal   no-undo .
      970     define variable v-frame-virtual-width  as decimal   no-undo .
      971     define variable v-browse-width         as decimal   no-undo .
      972     define variable v-window-width         as decimal   no-undo .
      973     define variable v-window-virtual-width as decimal   no-undo .
      974     define variable v-change-sign          as integer   no-undo .
      975     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      976     define buffer buf_temp-browse-handle  for temp-browse-handle .
      977     if p-change-value > 0
      978     then do:
      979       if frame Dialog-Frame :width + p-change-value >
      980           session :width-chars
      981       then do:
      982         assign
      983           p-change-value = session :width-chars - frame Dialog-Frame :width
      984         .
      985         if p-change-value <= 0
      986         then do:
      987           run diasize_position-resize-button in this-procedure .
      988           return .
      989         end.
      990       end.
      991     end.
      992     if p-change-value < 0
      993     then do:
      994       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      995       then do:
      996         assign
      997           p-change-value = v-diasize-orig-frame-width
      998                          - frame Dialog-Frame :width
      999         .
     1000         if p-change-value >= 0
     1001         then do:
     1002           run diasize_position-resize-button in this-procedure .
     1003           return .
     1004         end.
     1005       end.
     1006     end.
     1007     if p-change-value >= 0
     1008     then do:
     1009       assign
     1010         v-change-sign = 1
     1011       .
     1012     end.
     1013     else do:
     1014       assign
     1015         v-change-sign = -1
     1016       .
     1017     end.
     1018     assign
     1019       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1020     .
     1021     if p-change-value = 0
     1022     then do:
     1023       run diasize_position-resize-button in this-procedure .
     1024       return .
     1025     end.
     1026     move_block:
     1027     do
     1028     on error undo move_block, leave move_block
     1029     :
     1030       if retry
     1031       then do:
     1032         do
     1033         on error undo move_block, leave move_block
     1034         :
     1035           if p-change-value > 0
     1036           then do:
     1037             for each buf_temp-diasize-handle
     1038             on error undo, next
     1039             :
     1040               assign
     1041                 v-object-handle = buf_temp-diasize-handle.handle-value
     1042               .
     1043               if v-object-handle <> v-diasize-resize-button
     1044               then do:
     1045                 assign
     1046                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1047                 .
     1048               end.
     1049             end.
     1050             assign
     1051               v-diasize-browse-handle :width = v-browse-width
     1052             .
     1053             for each buf_temp-browse-handle
     1054               where buf_temp-browse-handle.browse-type = 'width':u
     1055             on error undo, next
     1056             :
     1057               assign
     1058                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1059               .
     1060             end.
     1061             assign
     1062               frame Dialog-Frame :width = v-frame-width
     1063             .
     1064             if frame Dialog-Frame :scrollable = true
     1065             then do:
     1066               assign
     1067                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1068               .
     1069             end.
     1070             run diasize_position-resize-button in this-procedure .
     1071           end.
     1072           else do:
     1073             if frame Dialog-Frame :scrollable = true
     1074             then do:
     1075               assign
     1076                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1077               .
     1078             end.
     1079             assign
     1080               frame Dialog-Frame :width = v-frame-width
     1081             .
     1082             for each buf_temp-browse-handle
     1083               where buf_temp-browse-handle.browse-type = 'width':u
     1084             on error undo, next
     1085             :
     1086               assign
     1087                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1088               .
     1089             end.
     1090             assign
     1091               v-diasize-browse-handle :width = v-browse-width
     1092             .
     1093             for each buf_temp-diasize-handle
     1094             on error undo, next
     1095             :
     1096               assign
     1097                 v-object-handle = buf_temp-diasize-handle.handle-value
     1098               .
     1099               if v-object-handle <> v-diasize-resize-button
     1100               then do:
     1101                 assign
     1102                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1103                 .
     1104               end.
     1105             end.
     1106             run diasize_position-resize-button in this-procedure .
     1107           end.
     1108           assign
     1109             v-diasize-change-size = false
     1110           .
     1111           leave move_block .
     1112         end.
     1113       end.
     1114       assign
     1115         v-diasize-need-full-display = true
     1116       .
     1117       if v-diasize-change-size = false
     1118       then do:
     1119         assign
     1120           v-diasize-change-size = true
     1121         .
     1122       end.
     1123       else do:
     1124         return .
     1125       end.
     1126       assign
     1127         v-frame-width = frame Dialog-Frame :width
     1128         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1129         v-browse-width = v-diasize-browse-handle :width
     1130       .
     1131       for each buf_temp-browse-handle
     1132         where buf_temp-browse-handle.browse-type = 'width':u
     1133       :
     1134         assign
     1135           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1136         .
     1137       end.
     1138       for each buf_temp-diasize-handle
     1139       :
     1140         delete buf_temp-diasize-handle .
     1141       end.
     1142       assign
     1143         v-field-group-handle = frame Dialog-Frame :first-child
     1144       .
     1145       do while valid-handle(v-field-group-handle)
     1146       :
     1147         assign
     1148           v-object-handle = v-field-group-handle :first-child
     1149         .
     1150         do while valid-handle(v-object-handle)
     1151         :
     1152           if  v-object-handle <> v-diasize-browse-handle :handle
     1153           and v-object-handle <> v-diasize-resize-button
     1154           and can-query(v-object-handle, "row")
     1155           and can-query(v-object-handle, "height")
     1156           and ( v-object-handle :col + v-object-handle :width
     1157                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1158               )
     1159           then do:
     1160             find first buf_temp-browse-handle
     1161               where buf_temp-browse-handle.browse-type   = 'width':u
     1162                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1163               no-error .
     1164             if available buf_temp-browse-handle
     1165             then do:
     1166             end.
     1167             else do:
     1168               create buf_temp-diasize-handle .
     1169               assign
     1170                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1171                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1172               .
     1173             end.
     1174           end.
     1175           assign
     1176             v-object-handle = v-object-handle :next-sibling
     1177           .
     1178         end.
     1179         assign
     1180           v-field-group-handle = v-field-group-handle :next-sibling
     1181         .
     1182       end.
     1183       do with frame Dialog-Frame
     1184       :
     1185         hide v-diasize-resize-button .
     1186         v-diasize-resize-button :row = 1.
     1187         v-diasize-resize-button :column = 1.
     1188       end.
     1189       if p-change-value > 0
     1190       then do:
     1191         if frame Dialog-Frame :scrollable = true
     1192         then do:
     1193           assign
     1194             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1195             no-error .
     1196           if error-status :error
     1197           or error-status :get-message(1) <> ""
     1198           then do:
     1199             undo move_block, retry move_block.
     1200           end.
     1201         end.
     1202         assign
     1203           frame Dialog-Frame :width = v-frame-width + p-change-value
     1204           no-error .
     1205         if error-status :error
     1206         or error-status :get-message(1) <> ""
     1207         then do:
     1208           undo move_block, retry move_block.
     1209         end.
     1210         assign
     1211           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1212         no-error .
     1213         if error-status :error
     1214         or error-status :get-message(1) <> ""
     1215         then do:
     1216           undo move_block, retry move_block.
     1217         end.
     1218         for each buf_temp-browse-handle
     1219           where buf_temp-browse-handle.browse-type = 'width':u
     1220         on error undo move_block, retry move_block
     1221         :
     1222           assign
     1223             buf_temp-browse-handle.browse-handle :width
     1224               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1225             no-error .
     1226           if error-status :error
     1227           or error-status :get-message(1) <> ""
     1228           then do:
     1229             undo move_block, retry move_block .
     1230           end.
     1231         end.
     1232         for each buf_temp-diasize-handle
     1233         on error undo move_block, retry move_block
     1234         :
     1235           assign
     1236             v-object-handle = buf_temp-diasize-handle.handle-value
     1237           .
     1238           if v-object-handle <> v-diasize-resize-button
     1239           then do:
     1240             assign
     1241               v-object-handle :col = v-object-handle :col + p-change-value
     1242               no-error .
     1243             if error-status :error
     1244             or error-status :get-message(1) <> ""
     1245             then do:
     1246               undo move_block, retry move_block .
     1247             end.
     1248           end.
     1249         end.
     1250       end.
     1251       else do:
     1252         for each buf_temp-diasize-handle
     1253         on error undo move_block, retry move_block
     1254         :
     1255           assign
     1256             v-object-handle = buf_temp-diasize-handle.handle-value
     1257           .
     1258           if v-object-handle <> v-diasize-resize-button
     1259           then do:
     1260             assign
     1261               v-object-handle :col = v-object-handle :col + p-change-value
     1262               no-error .
     1263             if error-status :error
     1264             or error-status :get-message(1) <> ""
     1265             then do:
     1266               undo move_block, retry move_block .
     1267             end.
     1268           end.
     1269         end.
     1270         for each buf_temp-browse-handle
     1271           where buf_temp-browse-handle.browse-type = 'width':u
     1272         on error undo move_block, retry move_block
     1273         :
     1274           assign
     1275             buf_temp-browse-handle.browse-handle :width
     1276               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1277             no-error .
     1278           if error-status :error
     1279           or error-status :get-message(1) <> ""
     1280           then do:
     1281             undo move_block, retry move_block .
     1282           end.
     1283         end.
     1284         assign
     1285           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1286           no-error .
     1287         if error-status :error
     1288         or error-status :get-message(1) <> ""
     1289         then do:
     1290           undo move_block, retry move_block.
     1291         end.
     1292         assign
     1293           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1294         no-error .
     1295         if error-status :error
     1296         or error-status :get-message(1) <> ""
     1297         then do:
     1298           undo move_block, retry move_block.
     1299         end.
     1300         if frame Dialog-Frame :scrollable = true
     1301         then do:
     1302           assign
     1303             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1304           no-error .
     1305           if error-status :error
     1306           or error-status :get-message(1) <> ""
     1307           then do:
     1308             undo move_block, retry move_block.
     1309           end.
     1310         end.
     1311       end.
     1312       if p-move-resize
     1313       then do:
     1314         run diasize_position-resize-button in this-procedure .
     1315       end.
     1316       if v-diasize-wndstore = true
     1317       then do:
     1318         if connected("ub") = true
     1319         then do:
     1320           define variable v-cntxt-db-num        as integer   no-undo .
     1321           define variable v-cntxt-userid        as character no-undo .
     1322           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1323                                             , OUTPUT v-cntxt-userid
     1324                                             ) .
     1325           run gbl/wndsizew.p
     1326             (input  v-cntxt-db-num
     1327             ,input  v-cntxt-userid
     1328             ,input  v-diasize-proc-name
     1329             ,input  'width':u
     1330             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1331             ) .
     1332         end.
     1333       end.
     1334     end.
     1335     assign
     1336       v-diasize-change-size = false
     1337     .
     1338   end procedure.
     1339   procedure diasize_set-width :
     1340     define input  parameter p-new-width  as decimal   no-undo .
     1341     define input  parameter p-move-resize as logical   no-undo .
     1342     do
     1343     on error undo, return error return-value
     1344     :
     1345       run diasize_change-width in this-procedure
     1346         (input  (p-new-width - frame Dialog-Frame :width)
     1347         ,input  p-move-resize
     1348         ) .
     1349     end.
     1350   end procedure.
     1351   procedure diasize_position-resize-button :
     1352     do with frame Dialog-Frame
     1353     :
     1354       hide v-diasize-resize-button .
     1355       assign
     1356         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1357                     - 1
     1358                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1359         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1360                     - 1
     1361                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1362       .
     1363       view v-diasize-resize-button .
     1364     end.
     1365   end procedure.
     1366   on alt-right anywhere
     1367   do:
     1368     run diasize_change-width in this-procedure
     1369       (input 1
     1370       ,input true
     1371       ) .
     1372     return no-apply .
     1373   end.
     1374   on alt-left anywhere
     1375   do:
     1376     run diasize_change-width in this-procedure
     1377       (input -1
     1378       ,input true
     1379       ) .
     1380     return no-apply .
     1381   end.
     1382   on alt-down anywhere
     1383   do:
     1384     run diasize_change-height in this-procedure
     1385       (input 1
     1386       ,input true
     1387       ) .
     1388     return no-apply .
     1389   end.
     1390   on alt-up anywhere
     1391   do:
     1392     run diasize_change-height in this-procedure
     1393       (input -1
     1394       ,input true
     1395       ) .
     1396     return no-apply .
     1397   end.
     1398   on alt-enter of frame Dialog-Frame
     1399   do:
     1400     run diasize_maximize in this-procedure
     1401       (input  ?
     1402       ).
     1403     return no-apply .
     1404   end.
     1405   procedure diasize_end-move :
     1406     do
     1407     on error undo, return error return-value
     1408     :
     1409       define variable v-row-delta as decimal   no-undo .
     1410       define variable v-col-delta as decimal   no-undo .
     1411       define variable v-new-row as decimal   no-undo .
     1412       define variable v-new-col as decimal   no-undo .
     1413       assign
     1414         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1415         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1416       .
     1417       assign
     1418         v-row-delta = v-new-row - frame Dialog-Frame :height
     1419         v-col-delta = v-new-col - frame Dialog-Frame :width
     1420       .
     1421       run diasize_change-height in this-procedure
     1422         (input v-row-delta
     1423         ,input true
     1424         ) .
     1425       run diasize_change-width in this-procedure
     1426         (input v-col-delta
     1427         ,input true
     1428         ) .
     1429     end.
     1430   end procedure.
     1431   procedure diasize_maximize :
     1432     define input  parameter p-action as logical   no-undo .
     1433     do
     1434     on error undo, return error return-value
     1435     :
     1436       if p-action = ?
     1437       then do:
     1438         if v-diasize-need-maximize = true
     1439         then do:
     1440           assign
     1441             p-action = true
     1442           .
     1443         end.
     1444         else do:
     1445           assign
     1446             p-action = false
     1447           .
     1448         end.
     1449       end.
     1450       if p-action = true
     1451       then do:
     1452         run diasize_change-height in this-procedure
     1453           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1454               - frame Dialog-Frame :height-chars
     1455           ,input true
     1456           ) .
     1457         run diasize_change-width in this-procedure
     1458           (input session :width-chars
     1459               - frame Dialog-Frame :width-chars
     1460           ,input true
     1461           ) .
     1462         assign
     1463           v-diasize-need-maximize = false
     1464         .
     1465       end.
     1466       else do:
     1467         run diasize_change-width in this-procedure
     1468           (input v-diasize-orig-frame-width
     1469               - frame Dialog-Frame :width-chars
     1470           ,input true
     1471           ) .
     1472         run diasize_change-height in this-procedure
     1473           (input v-diasize-orig-frame-height
     1474               - frame Dialog-Frame :height-chars
     1475           ,input true
     1476           ) .
     1477         assign
     1478           v-diasize-need-maximize = true
     1479         .
     1480       end.
     1481     end.
     1482   end procedure.
     1483   procedure diasize_restore-orig-size :
     1484     do
     1485     on error undo, return error return-value
     1486     :
     1487       assign
     1488         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1489         v-diasize-current-frame-height = frame Dialog-Frame :height
     1490       .
     1491       run diasize_set-height in this-procedure
     1492         (input  v-diasize-orig-frame-height
     1493         ,input  true
     1494         ) .
     1495       run diasize_set-width in this-procedure
     1496         (input  v-diasize-orig-frame-width
     1497         ,input  true
     1498         ) .
     1499     end.
     1500   end procedure.
     1501   procedure diasize_restore-current-size :
     1502     do
     1503     on error undo, return error return-value
     1504     :
     1505       run diasize_set-height in this-procedure
     1506         (input  v-diasize-current-frame-height
     1507         ,input  true
     1508         ) .
     1509       run diasize_set-width in this-procedure
     1510         (input  v-diasize-current-frame-width
     1511         ,input  true
     1512         ) .
     1513     end.
     1514   end procedure.
     1515   procedure diasize_set-browse-handle :
     1516     define input  parameter p-browse-handle as handle   no-undo .
     1517     define buffer buf_temp-browse-handle for temp-browse-handle .
     1518     do
     1519     on error undo, return error return-value
     1520     :
     1521       assign
     1522         v-diasize-browse-handle = p-browse-handle
     1523       .
     1524       for each buf_temp-browse-handle
     1525       on error undo, return error return-value
     1526       :
     1527         delete buf_temp-browse-handle .
     1528       end.
     1529     end.
     1530   end procedure.
     1531   procedure diasize_add_browse :
     1532     define input  parameter p-browse-type   as character no-undo .
     1533     define input  parameter p-browse-handle as handle    no-undo .
     1534     define buffer buf_temp-browse-handle for temp-browse-handle .
     1535     do
     1536     on error undo, return error return-value
     1537     :
     1538       assign
     1539         v-diasize-browse-number = v-diasize-browse-number + 1
     1540       .
     1541       create buf_temp-browse-handle .
     1542       assign
     1543         buf_temp-browse-handle.browse-type   = p-browse-type
     1544         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1545         buf_temp-browse-handle.browse-handle = p-browse-handle
     1546       .
     1547     end.
     1548   end procedure.
     1549   procedure diasize_init :
     1550     define variable v-default-value    as logical   no-undo .
     1551     define variable v-restore-saved    as logical   no-undo .
     1552     define variable v-resize-value-str as character no-undo .
     1553     do
     1554     on error undo, return error return-value
     1555     :
     1556       do with frame Dialog-Frame
     1557       :
     1558         assign
     1559           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1560           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1561           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1562         .
     1563         create button v-diasize-resize-button
     1564         assign
     1565           parent        = frame Dialog-Frame :first-child
     1566           label         = "s"
     1567           height-pixels = 16
     1568           width-pixels  = 16
     1569           visible       = true
     1570           sensitive     = true
     1571           movable       = true
     1572           triggers:
     1573             on end-move persistent run diasize_end-move in this-procedure .
     1574           end triggers.
     1575         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1576         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1577         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1578         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1579         assign
     1580           v-diasize-wndmax = false
     1581         .
     1582         if connected("ub") = true
     1583         then do:
     1584           define variable v-cntxt-db-num        as integer   no-undo .
     1585           define variable v-cntxt-userid        as character no-undo .
     1586           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1587                                             , OUTPUT v-cntxt-userid
     1588                                             ) .
     1589           run gbl/wndpar_r.p
     1590             (input  v-cntxt-db-num
     1591             ,input  v-cntxt-userid
     1592             ,input  'wndmax':U
     1593             ,output v-diasize-wndmax
     1594             ,output v-default-value
     1595             ) .
     1596         end.
     1597         assign
     1598           v-diasize-wndstore = false
     1599         .
     1600         if connected("ub") = true
     1601         then do:
     1602           run gbl/wndpar_r.p
     1603             (input  v-cntxt-db-num
     1604             ,input  v-cntxt-userid
     1605             ,input  'wndstore':U
     1606             ,output v-diasize-wndstore
     1607             ,output v-default-value
     1608             ) .
     1609         end.
     1610         assign
     1611           v-diasize-proc-name = entry(1, program-name(2), '.')
     1612         .
     1613         if v-diasize-wndstore = true
     1614         then do:
     1615           assign
     1616             v-restore-saved = false
     1617           .
     1618           if connected("ub") = true
     1619           then do:
     1620             run gbl/wndsizer.p
     1621               (input  v-cntxt-db-num
     1622               ,input  v-cntxt-userid
     1623               ,input  v-diasize-proc-name
     1624               ,input  'height':u
     1625               ,output v-resize-value-str
     1626               ) .
     1627             if v-resize-value-str <> '':U
     1628             then do:
     1629               run diasize_change-height in this-procedure
     1630                 (input  integer(v-resize-value-str)
     1631                 ,input  true
     1632                 ) .
     1633               assign
     1634                 v-restore-saved = true
     1635               .
     1636             end.
     1637           end.
     1638           if connected("ub") = true
     1639           then do:
     1640             run gbl/wndsizer.p
     1641               (input  v-cntxt-db-num
     1642               ,input  v-cntxt-userid
     1643               ,input  v-diasize-proc-name
     1644               ,input  'width':u
     1645               ,output v-resize-value-str
     1646               ) .
     1647             if v-resize-value-str <> '':U
     1648             then do:
     1649               run diasize_change-width in this-procedure
     1650                 (input  integer(v-resize-value-str)
     1651                 ,input  true
     1652                 ) .
     1653               assign
     1654                 v-restore-saved = true
     1655               .
     1656             end.
     1657           end.
     1658           if v-restore-saved <> true
     1659           then do:
     1660             if v-diasize-wndmax = true
     1661             then do:
     1662               run diasize_maximize in this-procedure
     1663                 (input  true
     1664                 ) .
     1665             end.
     1666           end.
     1667         end.
     1668         else do:
     1669           if v-diasize-wndmax = true
     1670           then do:
     1671             run diasize_maximize in this-procedure
     1672               (input  true
     1673               ) .
     1674           end.
     1675         end.
     1676       end.
     1677     end.
     1678   end procedure.
     1679   procedure diasize_need-full-display :
     1680     define output parameter p-need-full-display as logical   no-undo .
     1681     do
     1682     on error undo, return error return-value
     1683     :
     1684       assign
     1685         p-need-full-display = v-diasize-need-full-display
     1686       .
     1687       assign
     1688         v-diasize-need-full-display = false
     1689       .
     1690     end.
     1691   end procedure.
     1692   procedure get-context :
     1693      define output parameter p-db-num as integer          no-undo.
     1694      define output parameter p-user-id as character        no-undo.
     1695      define variable v-login               as character    no-undo.
     1696      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1697      define buffer buf_user-login  for ub.user-login .
     1698      do
     1699      on error undo, return error
     1700      :
     1701            FIND FIRST buf_sys-ctrl no-lock.
     1702            ASSIGN
     1703               v-login = USERID("ub")
     1704               p-db-num = buf_sys-ctrl.db-num
     1705            .
     1706            FIND FIRST buf_user-login
     1707                 WHERE buf_user-login.db-num = p-db-num
     1708                   AND buf_user-login.user-login = v-login
     1709                 no-lock
     1710                 no-error
     1711                 .
     1712            IF AVAILABLE buf_user-login
     1713            THEN DO:
     1714               assign
     1715                  p-user-id = buf_user-login.user-id
     1716               .
     1717            END.
     1718      end.
     1719   end procedure.
     1720       run diasize_init in this-procedure .
     1721       case p-type:
     1722           when "diff-mass" then
     1723               do:
     1724                   frame Dialog-Frame:title = "Выявлены отклонения в 1 части сменного отчета".
     1725               end.
     1726           when "diff-TRK" then
     1727               do:
     1728                   frame Dialog-Frame:title = "Выявлены отклонения в 9 части сменного отчета".
     1729               end.
     1730           otherwise
     1731           do:
     1732               frame Dialog-Frame:title = "Выявлены отклонения".
     1733           end.
     1734       end case .
     1735       run init-temp.
     1736       RUN enable_UI.
     1737       if p-mode = 'ПРОСМОТР':U then
     1738       do:
     1739           p-ok = true .
     1740           X_shift-param.disc-diffMass:column-read-only in browse BROWSE-2 = true .
     1741           X_shift-param.disc-diffTRK:column-read-only in browse BROWSE-2 = true .
     1742           disable
     1743               B-update
     1744               with frame Dialog-Frame .
     1745       end.
     1746       WAIT-FOR GO OF FRAME Dialog-Frame  .
     1747   END.
     1748   RUN disable_UI.
     1749   PROCEDURE disable_UI :
     1750       HIDE FRAME Dialog-Frame.
     1751   END PROCEDURE.
     1752   PROCEDURE enable_UI :
     1753       ENABLE b-cancel B-update B-print BROWSE-2
     1754           WITH FRAME Dialog-Frame.
     1755       hide b-help in frame Dialog-Frame .
     1756       VIEW FRAME Dialog-Frame.
     1757       open query BROWSE-2 for each X_shift-param no-lock by X_shift-param.gds-code descending indexed-reposition.
     1758   END PROCEDURE.
     1759   PROCEDURE init-temp :
     1760       define buffer buf_X_shift-param for X_shift-param .
     1761       define buffer buf_shift-param   for ub.shift-param .
     1762       define buffer buf_goods         for ub.goods .
     1763       for each X_shift-param:
     1764           delete X_shift-param .
     1765       end.
     1766       if p-type = "diff-TRK" then
     1767       do:
     1768           for each buf_shift-param no-lock where buf_shift-param.obj-code = p-obj-code and
     1769               buf_shift-param.obj-type = p-obj-type and
     1770               buf_shift-param.shift-date = p-shift-date and
     1771               buf_shift-param.shift-num = p-shift-num and
     1772               buf_shift-param.shift-name = p-shift-name and
     1773               buf_shift-param.error-paid-trans
     1774               :
     1775               find first buf_goods no-lock where buf_goods.gds-code = buf_shift-param.gds-code no-error .
     1776               if available (buf_goods) then
     1777               do:
     1778                   create X_shift-param .
     1779                   buffer-copy buf_shift-param to X_shift-param .
     1780                   X_shift-param.gds-name = buf_goods.gds-name .
     1781               end.
     1782           end.
     1783       end.
     1784       if p-type = "diff-mass" then
     1785       do:
     1786           for each buf_shift-param no-lock where buf_shift-param.obj-code = p-obj-code and
     1787               buf_shift-param.obj-type = p-obj-type and
     1788               buf_shift-param.shift-date = p-shift-date and
     1789               buf_shift-param.shift-num = p-shift-num and
     1790               buf_shift-param.shift-name = p-shift-name and
     1791               buf_shift-param.error-mass
     1792               :
     1793               find first buf_goods no-lock where buf_goods.gds-code = buf_shift-param.gds-code no-error .
     1794               if available (buf_goods) then
     1795               do:
     1796                   create X_shift-param .
     1797                   buffer-copy buf_shift-param to X_shift-param .
     1798                   X_shift-param.gds-name = buf_goods.gds-name .
     1799               end.
     1800           end.
     1801       end.
     1802       if p-type = "diff-mass" then
     1803       do:
     1804           X_shift-param.disc-diffTRK:visible IN BROWSE BROWSE-2 = FALSE.
     1805           X_shift-param.cash-qnty:visible IN BROWSE BROWSE-2 = FALSE.
     1806           X_shift-param.meas-qnty:visible IN BROWSE BROWSE-2 = FALSE.
     1807           X_shift-param.tech-refuell:visible IN BROWSE BROWSE-2 = FALSE.
     1808           X_shift-param.diff-cash-trk:visible IN BROWSE BROWSE-2 = FALSE.
     1809       end .
     1810       else
     1811       do:
     1812           X_shift-param.diff-stock-end:visible IN BROWSE BROWSE-2 = FALSE.
     1813           X_shift-param.dev-mass:visible IN BROWSE BROWSE-2 = FALSE.
     1814           X_shift-param.disc-diffMass:visible IN BROWSE BROWSE-2 = FALSE.
     1815           X_shift-param.system-cli-qnty:visible IN BROWSE BROWSE-2 = FALSE.
     1816           X_shift-param.fact-stock-end:visible IN BROWSE BROWSE-2 = FALSE.
     1817       end.
     1818   END PROCEDURE.
     1819   PROCEDURE proc-b-print :
     1820       define input parameter v-type as character no-undo .
     1821       define variable dev-paid-trans      as decimal   no-undo .
     1822       define variable prc-dev-mass        as decimal   no-undo .
     1823       define VARIABLE p-report-id         as character no-undo .
     1824       define variable v-file-name-rep-htm as character no-undo .
     1825       define buffer buf_shiftParam for ub.shift-param .
     1826       define buffer buf_goods      for ub.goods .
     1827       define buffer buf_susp-chk   for ub.susp-chk .
     1828       define buffer bf_shift-obj   for ub.shift-obj .
     1829       run get-report-num (output p-report-id).
     1830       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1831       find first bf_shift-obj no-lock where bf_shift-obj.obj-code = p-obj-code and
     1832           bf_shift-obj.obj-type = p-obj-type and
     1833           bf_shift-obj.shift-date = p-shift-date and
     1834           bf_shift-obj.Shift-num = p-shift-num no-error .
     1835       if not available (bf_shift-obj) then return error.
     1836       find first buf_shiftParam no-lock where buf_shiftParam.obj-code = bf_shift-obj.obj-code and
     1837           buf_shiftParam.obj-type = bf_shift-obj.obj-type and
     1838           buf_shiftParam.shift-date = bf_shift-obj.shift-date and
     1839           buf_shiftParam.shift-num = bf_shift-obj.shift-num and
     1840           buf_shiftParam.gds-code = 0 and
     1841           buf_shiftParam.pl-code = 0 no-error .
     1842       if not available (buf_shiftParam) then
     1843       do:
     1844           find first buf_shiftparam no-lock where buf_shiftparam.obj-code = 0 and
     1845               buf_shiftparam.obj-type = "" and
     1846               buf_shiftparam.shift-date = 01/01/1900 no-error .
     1847           if not available (buf_shiftparam) then
     1848           do:
     1849               assign
     1850                   prc-dev-mass   = 0.65
     1851                   dev-paid-trans = 1
     1852                   .
     1853           end.
     1854           else
     1855           do:
     1856               assign
     1857                   prc-dev-mass   = buf_shiftparam.prc-dev-mass
     1858                   dev-paid-trans = buf_shiftparam.dev-paid-trans
     1859                   .
     1860           end.
     1861       end.
     1862       else
     1863           assign
     1864               dev-paid-trans = buf_shiftParam.dev-paid-trans
     1865               prc-dev-mass   = buf_shiftParam.prc-dev-mass
     1866               .
     1867       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1868       put stream OutStr-html unformatted
     1869           "<!DOCTYPE HTML>" skip
     1870           ' <html>' skip
     1871           '  <head>' skip
     1872           '   <meta charset="utf-8">' skip
     1873           '    <style type="text/css">' skip
     1874           '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1875           '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1876           '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1877           '   </style>' skip
     1878           '  </head>' skip
     1879           .
     1880       put stream OutStr-html unformatted
     1881           '<body>' skip
     1882           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1883           '<thead>' skip
     1884           .
     1885       put stream OutStr-html unformatted
     1886           '<tr class="set_columns">' skip
     1887           '<td style="width: 100px;"></td>' skip
     1888           '<td style="width: 200px;"></td>' skip
     1889           '<td style="width: 100px;"></td>' skip
     1890           '<td style="width: 150px;"></td>' skip
     1891           '<td style="width: 150px;"></td>' skip
     1892           '<td style="width: 150px;"></td>' skip
     1893           '<td style="width: 150px;"></td>' skip
     1894           '<td style="width: 150px;"></td>' skip
     1895           '<td style="width: 350px;"></td>' skip
     1896           '</tr>' skip
     1897           .
     1898       put stream OutStr-html unformatted
     1899           '<tr>' skip
     1900           '<td colspan="9" style="text-align: left;">АЗК №' + string(bf_shift-obj.obj-code) + ' </td>' skip
     1901           '</tr>' skip
     1902           .
     1903       put stream OutStr-html unformatted
     1904           '</thead>' skip .
     1905       if v-type = "diff-mass" then
     1906       do:
     1907           put stream OutStr-html unformatted
     1908               '<TR style="height:55px;">' skip
     1909               '<TD text_wrap="true" colspan="9" style="text-align: center; font-weight:bold;">Проверка отклонений по 1 части сменного отчета. Отклонение между расчетной и фактической массой топлива на конец смены.</TD>' skip
     1910               '</tr>' skip
     1911               '<tr>' skip
     1912               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Код топлива</TD>' skip
     1913               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Наименование</TD>' skip
     1914               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ резервуара</TD>' skip
     1915               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Расч. остаток на конец смены, кг</TD>' skip
     1916               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Факт. остаток на конец смены, кг</TD>' skip
     1917               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Допустимое отклонение, кг</TD>' skip
     1918               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Факт. отклонение по остаткам, кг</TD>' skip
     1919               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Превышение допустимого отклонения на, кг</TD>' skip
     1920               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Причина расхождения/номер заявки в ЦДС</TD>' skip
     1921               '</TR>'skip
     1922               .
     1923           for each buf_shiftParam no-lock
     1924               where buf_shiftParam.obj-code = p-obj-code
     1925               and buf_shiftParam.obj-type = p-obj-type
     1926               and buf_shiftParam.shift-date = p-shift-date
     1927               and buf_shiftParam.shift-num = p-shift-num
     1928               and buf_shiftParam.error-mass:
     1929               find first buf_goods no-lock where buf_goods.gds-code = buf_shiftParam.gds-code no-error .
     1930               if not available (buf_goods) then next .
     1931               put stream OutStr-html unformatted
     1932                   '<TR>' skip
     1933                   '<TD text_wrap="true">' + string(buf_goods.gds-code) + '</TD>' skip
     1934                   '<TD text_wrap="true">' + buf_goods.gds-name + '</TD>' skip
     1935                   '<TD text_wrap="true" style="text-align: center;">' + string(buf_shiftParam.loc1) + '</TD>' skip
     1936                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.system-cli-qnty,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.system-cli-qnty <> ? then fnc-convert-dot-to-colon(buf_shiftParam.system-cli-qnty,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1937                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.fact-stock-end,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.fact-stock-end <> ? then fnc-convert-dot-to-colon(buf_shiftParam.fact-stock-end,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1938                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.dev-mass,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.dev-mass <> ? then fnc-convert-dot-to-colon(buf_shiftParam.dev-mass,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1939                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.diff-stock-end,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.diff-stock-end <> ? then fnc-convert-dot-to-colon(buf_shiftParam.diff-stock-end,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1940                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(absolute(buf_shiftParam.dev-mass - buf_shiftParam.diff-stock-end),">>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if absolute(buf_shiftParam.dev-mass - buf_shiftParam.diff-stock-end) <> ? then fnc-convert-dot-to-colon(absolute(buf_shiftParam.dev-mass - buf_shiftParam.diff-stock-end),">>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1941                   '<TD text_wrap="true" style="width: 350px;">' + string(buf_shiftParam.disc-diffMass) + '</TD>' skip
     1942                   '</tr>' skip
     1943                   .
     1944           end.
     1945           put stream OutStr-html unformatted
     1946               '<thead>' skip
     1947               '<TR  style="height:25px;">' skip
     1948               '<TD text_wrap="true" colspan="9" style="text-align: left;">* Процент допустимого отклонения массы топлива = ' + string(prc-dev-mass,"9.99") + '%</TD>' skip
     1949               '</tr>' skip
     1950               '<TR  style="height:25px;">' skip
     1951               '<TD text_wrap="true" colspan="9" style="text-align: left;"></TD>' skip
     1952               '</tr>' skip
     1953               '<TR  style="height:25px;">' skip
     1954               '<TD text_wrap="true" colspan="9" style="text-align: left;"></TD>' skip
     1955               '</tr>' skip
     1956               '</thead>' skip
     1957               .
     1958       end .
     1959       else
     1960       do:
     1961           put stream OutStr-html unformatted
     1962               '<TR style="height:55px;">' skip
     1963               '<TD text_wrap="true" height:25px; colspan="9" style="text-align: center; font-weight:bold;">Проверка отклонений по 9 части сменного отчета. Отклонения между объемом продаж топлива на кассе и объемом по счетчикам ТРК.</TD>' skip
     1964               '</tr>' skip
     1965               '<tr>' skip
     1966               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Код топлива</TD>' skip
     1967               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Наименование</TD>' skip
     1968               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ резервуара</TD>' skip
     1969               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Объем продаж на кассе, л</TD>' skip
     1970               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Объем продаж по счетчикам ТРК, л</TD>' skip
     1971               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Техпролив, л</TD>' skip
     1972               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Разница по кассе и ТРК, л</TD>' skip
     1973               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Превышение допустимого отклонения на, л</TD>' skip
     1974               '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver; width: 350px;">Причина расхождения/номер заявки в ЦДС</TD>' skip
     1975               '</TR>'skip
     1976               .
     1977           for each buf_shiftParam no-lock
     1978               where buf_shiftParam.obj-code = p-obj-code
     1979               and buf_shiftParam.obj-type = p-obj-type
     1980               and buf_shiftParam.shift-date = p-shift-date
     1981               and buf_shiftParam.shift-num = p-shift-num
     1982               and buf_shiftParam.error-paid-trans:
     1983               find first buf_goods no-lock where buf_goods.gds-code = buf_shiftParam.gds-code no-error .
     1984               if not available (buf_goods) then next .
     1985               put stream OutStr-html unformatted
     1986                   '<TR>' skip
     1987                   '<TD text_wrap="true">' + string(buf_goods.gds-code) + '</TD>' skip
     1988                   '<TD text_wrap="true">' + buf_goods.gds-name + '</TD>' skip
     1989                   '<TD text_wrap="true" style="text-align: center;">' + string(buf_shiftParam.loc1) + '</TD>' skip
     1990                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.cash-qnty,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.cash-qnty <> ? then fnc-convert-dot-to-colon(buf_shiftParam.cash-qnty,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1991                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.meas-qnty,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.meas-qnty <> ? then fnc-convert-dot-to-colon(buf_shiftParam.meas-qnty,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1992                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.tech-refuell,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.tech-refuell <> ? then fnc-convert-dot-to-colon(buf_shiftParam.tech-refuell,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1993                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.diff-cash-trk,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.diff-cash-trk <> ? then fnc-convert-dot-to-colon(buf_shiftParam.diff-cash-trk,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1994                   '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(absolute(buf_shiftParam.dev-paid-trans - buf_shiftParam.diff-cash-trk),">>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if absolute(buf_shiftParam.dev-paid-trans - buf_shiftParam.diff-cash-trk) <> ? then fnc-convert-dot-to-colon(absolute(buf_shiftParam.dev-paid-trans - buf_shiftParam.diff-cash-trk),">>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1995                   '<TD text_wrap="true">' + string(buf_shiftParam.disc-diffTRK) + '</TD>' skip
     1996                   '</tr>' skip
     1997                   .
     1998           end.
     1999           put stream OutStr-html unformatted
     2000               '<thead>' skip
     2001               '<TR style="height:25px;">' skip
     2002               '<TD text_wrap="true" colspan="8" style="text-align: left;">*Допустимое отклонение между объемом продаж топлива на кассе и объемом по счетчикам ТРК = ' + string(dev-paid-trans,"9.99") + 'л</TD>' skip
     2003               '</tr>' skip
     2004               '<TR style="height:25px;">' skip
     2005               '<TD text_wrap="true" colspan="8" style="text-align: left;"></TD>' skip
     2006               '</tr>' skip
     2007               '<TR style="height:25px;">' skip
     2008               '<TD text_wrap="true" colspan="8" style="text-align: left;"></TD>' skip
     2009               '</tr>' skip
     2010               '</thead>' skip
     2011               .
     2012       end.
     2013       put stream OutStr-html unformatted
     2014           '</table>' skip
     2015           '</body>' skip
     2016           '</html>' skip
     2017           .
     2018       output stream OutStr-html close.
     2019       run prn-lib-reportviewer-report-name in this-procedure (
     2020           input parparentproc
     2021           ,input v-file-name-rep-htm
     2022           ) .
     2023       if error-status:error then
     2024       do:
     2025           message return-value view-as alert-box.
     2026           return .
     2027       end.
     2028   END PROCEDURE.
     2029   PROCEDURE get-report-num :
     2030       define output parameter p-report-num as integer no-undo .
     2031       do
     2032           on error undo, return error return-value
     2033           :
     2034           run gbl/getrpnum.p (output p-report-num).
     2035       end.
     2036   END PROCEDURE.
     2037   function dev returns decimal
     2038       (input v-type as character):
     2039       if v-type = "diff-mass" then return absolut(X_shift-param.dev-mass - X_shift-param.diff-stock-end) .
     2040       else return absolut(X_shift-param.dev-paid-trans - X_shift-param.diff-cash-trk) .
     2041   end function.
