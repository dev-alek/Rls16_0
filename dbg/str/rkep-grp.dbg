     4554   END PROCEDURE.
     4555   PROCEDURE Openbr :
     4556   define input  parameter p-open-query     as logical   no-undo .
     4557   define input  parameter p-find-next      as logical   no-undo .
     4558   define input  parameter p-find-condition as character no-undo .
     4559   define variable l-query-was-opened as logical no-undo .
     4560   define variable title0 as character no-undo.
     4561   title0 = "Справочник групп блюд на кассе R-KEEPER" + chr(32).
     4562   run waitfram-show in this-procedure ("Ждите...").
     4563   define variable sort-column-phrase as character no-undo .
     4564   case sort-column-name :
     4565     when "" then do:
     4566       assign
     4567         sort-column-phrase = ""
     4568       .
     4569     end.
     4570     otherwise do:
     4571       assign
     4572         sort-column-phrase = "by " + sort-column-name
     4573       .
     4574     end.
     4575   end case.
     4576   define variable l-open-query as logical   no-undo .
     4577     CASE v-mode :
     4578       WHEN 'все':U        THEN DO:
     4579         assign
     4580         filter-point = filter-point0 + v-mode
     4581         filter-label = substitute("&1 Один объект", filter-label0)
     4582         .
     4583         if p-open-query then do:
     4584           frame Dialog-Frame:TITLE = title0.
     4585         end.
     4586   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4587   define variable  l-disable-where-35  as logical   no-undo .
     4588   define variable  l-filter-open-35    as logical   .
     4589   define variable  flt-rec-35       as recid     no-undo .
     4590   define variable  filter-name-35      as character no-undo .
     4591   define variable  where-phrase-35     as character no-undo .
     4592   define variable  sort-phrase-35      as character no-undo .
     4593   define variable  where-phrase-rus-35 as character no-undo .
     4594   define variable  sort-phrase-rus-35  as character no-undo .
     4595     run waitfram-show in this-procedure
     4596       (input "ЖДИТЕ ..."
     4597       ).
     4598   run gbl/flt-get.p
     4599     (input filter-point
     4600     ,output flt-rec-35
     4601     ,output filter-name-35
     4602     ,output where-phrase-35
     4603     ,output sort-phrase-35
     4604     ,output where-phrase-rus-35
     4605     ,output sort-phrase-rus-35
     4606     ).
     4607   if p-open-query then do:
     4608       run set-filter-name in this-procedure
     4609         (INPUT filter-name-35
     4610         ) no-error .
     4611     assign
     4612       l-filter-open-35 = false
     4613     .
     4614     if flt-rec-35 <> ?
     4615       or sort-column-phrase > ""
     4616     then do:
     4617       define variable  parameter-2-35 as character no-undo .
     4618       define variable  parameter-3-35 as character no-undo .
     4619       define variable  parameter-4-35 as character no-undo .
     4620       define variable  parameter-5-35 as character no-undo .
     4621       define variable  parameter-6-35 as character no-undo .
     4622       define variable  parameter-7-35 as character no-undo .
     4623         assign
     4624         parameter-3-35 =
     4625                                 "FOR EACH X_cd-grp"
     4626         parameter-4-35 =
