      633   procedure fltfield-clear :
      634     define output parameter loc-fld as character no-undo.
      635     define output parameter loc-lab as character no-undo .
      636     define output parameter loc-spr as character no-undo .
      637     define output parameter loc-dim as character no-undo .
      638     assign
      639       loc-fld = ""
      640       loc-lab = ""
      641       loc-spr = ""
      642       loc-dim = "0"
      643     .
      644   end procedure .
      645   procedure fltfield-add :
      646     define input        parameter par-fld as character no-undo.
      647     define input        parameter par-lab as character no-undo .
      648     define input        parameter par-spr as character no-undo .
      649     define input-output parameter loc-fld as character no-undo.
      650     define input-output parameter loc-lab as character no-undo .
      651     define input-output parameter loc-spr as character no-undo .
      652     define input-output parameter loc-dim as character no-undo .
      653     do
      654     on error undo, return error
      655     :
      656       assign
      657       loc-fld = if loc-dim = '0'
      658                 then par-fld
      659                 else (loc-fld + chr(44) + par-fld)
      660       loc-lab = if loc-dim = '0'
      661                 then par-lab
      662                 else (loc-lab + chr(44) + par-lab)
      663       loc-spr = if loc-dim = '0'
      664                 then par-spr
      665                 else (loc-spr + chr(44) + par-spr)
      666       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      667                 string(integer(if num-entries(loc-dim) > 1
      668                               then entry(2, loc-dim)
      669                               else entry(1, loc-dim)
      670                               ) + 1)
      671       no-error
      672       .
      673     end.
      674   end procedure.
      675   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   define  stream PrnLibStream.
      677   procedure prn-lib-prn-file :
      678     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      679     define input parameter p-DIsabledoptions as integer no-undo .
      680     define variable v-report-name as character no-undo .
      681     define variable v-user-action as character no-undo .
      682     define variable v-printed     as logical   no-undo .
      683     define variable v-exist       as logical   no-undo .
      684     do
      685       on error undo, return error
      686       :
      687       run prn-lib-get-report-name  in this-procedure (
      688         input parParentProc
      689         ,output v-report-name
      690         ).
      691   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      692   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      693     (input  v-report-name
      694     ,input  2
      695     ,output v-exist
      696     )  .
      697       if NOT v-exist then
      698       DO:
      699         Message
      700           "Нет заданий на печать ! "
      701           view-as alert-box .
      702         Return  .
      703       End.
      704       run gbl/prnfilen.w
      705         (input  ""
      706         ,input  p-DisabledOptions
      707         ,input  string(v-report-name )
      708         ,input  7
      709         ,output v-user-action
      710         ,output v-printed
      711         ) .
      712       if v-printed then
      713       do:
      714         return "YES" .
      715       end.
      716       else
      717       do:
      718         return "NO" .
      719       end.
      720     end.
      721   end procedure.
      722   procedure prn-lib-open-stream :
      723     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      724     define input parameter p-page-size    as integer no-undo .
      725     define input parameter p-is-stream    as logical no-undo .
      726     define input parameter p-append       as logical no-undo .
      727     define variable v-report-name as character no-undo .
      728     do
      729       on error undo, return error
      730       :
      731       run prn-lib-get-report-name  in this-procedure (
      732         input parParentProc
      733         ,output v-report-name
      734         ).
      735       if p-is-stream then
      736       do:
      737         if p-append then
      738         do:
      739           output stream PrnLibStream to value( v-report-name )
      740             page-size value(p-page-size) append .
      741         end.
      742         if not p-append then
      743         do:
      744           output stream PrnLibStream to value( v-report-name )
      745             page-size value(p-page-size) .
      746         end.
      747       end.
      748       if not p-is-stream then
      749       do:
      750         if p-append then
      751         do:
      752           output to value( v-report-name )
      753             page-size value(p-page-size) append .
      754         end.
      755         if not p-append then
      756         do:
      757           output to value( v-report-name )
      758             page-size value(p-page-size) .
      759         end.
      760       end.
      761     end.
      762   end procedure.
      763   procedure prn-lib-open-exp :
      764     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      765     define input parameter p-is-stream    as logical no-undo .
      766     define input parameter p-is-append    as logical no-undo .
      767     define output parameter p-ReportFileName as char init "report" no-undo.
      768     define output parameter p-process as logical no-undo .
      769     define variable glog as logical no-undo .
      770     do
      771       on error undo, return error
      772       :
      773       SYSTEM-DIALOG GET-FILE p-ReportFileName
      774         TITLE      "Укажите путь"
      775         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      776         ASK-OVERWRITE
      777         CREATE-TEST-FILE
      778         SAVE-AS
      779         USE-FILENAME
      780         DEFAULT-EXTENSION "txt"
      781         UPDATE glog
      782         .
      783       if not glog then  return.
      784       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      785       if p-is-stream then
      786       do:
      787         if p-is-append then
      788         do:
      789           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      790         end.
      791         else
      792         do:
      793           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      794         end.
      795       end.
      796       else
      797       do:
      798         if p-is-append then
      799         do:
      800           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      801         end.
      802         else
      803         do:
      804           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      805         end.
      806       end.
      807       p-process = yes.
      808     end.
      809   end procedure.
      810   procedure prn-lib-get-report-name :
      811     define input parameter parParentProc  as widget-handle no-undo.
      812     define output parameter p-report-name as character no-undo .
      813     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      814   end procedure.
      815   procedure prn-lib-reportviewer-report-name :
      816     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      817     define input parameter p-report-name-html as character no-undo .
      818     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      819   end procedure.
      820   procedure prn-lib-reportviewer :
      821     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      822     define input parameter p-report-name-html as character no-undo .
      823     define input parameter p-param        as character no-undo .
      824     define variable v-excel           as character no-undo init 'TRUE' .
      825     define variable v-value-character as character no-undo .
      826     define variable v-value-integer   as character no-undo .
      827     define variable v-value-date      as date      no-undo .
      828     define variable v-value-decimal   as decimal   no-undo .
      829     define variable rep-excel         as logical   no-undo .
      830     define variable excel-string      as character no-undo .
      831     define variable v-param-type      as character no-undo .
      832     define variable v-tth             as handle    no-undo .
      833     run adm/shattri.p (
      834       input "get":U
      835       ,input  ""
      836       ,input  0
      837       ,input  'report-glob':U
      838       ,input  'rep-excel':U
      839       ,output v-value-character
      840       ,output v-value-date
      841       ,output v-value-decimal
      842       ,output v-value-integer
      843       ,output rep-excel
      844       ,output v-param-type
      845       ,INPUT-OUTPUT table-handle v-tth
      846       )  .
      847     if rep-excel then v-excel = "TRUE" .
      848     else v-excel = "FALSE" .
      849     if p-param eq ""
      850     then
      851        p-param = "EXCEL:" + v-excel.
      852     else
      853        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      854     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      855   end procedure.
      856   define new global shared variable g#libbcrcn as handle no-undo .
      857   define variable vss-include-info7 as character format "X(65)" no-undo
      858   initial "@(#)$Workfile$ $Revision$".
      859   define temp-table temp_fbrglib_grp no-undo
      860       field sel           as character
      861       field full-name     as character
      862       field out-code      as integer
      863       field sort-name     as character
      864       field node-code     as integer
      865       field upper-code    as integer
      866       field name          as character
      867       field level         as integer
      868       field mark          as character
      869       field obj-type      as character
      870       field obj-code      as integer
      871       field global-code   as integer
