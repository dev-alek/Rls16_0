     2646     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2647   END.
     2648   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2649   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2650   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2651   on help of frame Dialog-Frame
     2652   do:
     2653     run gbl/app_help.p
     2654       (input this-procedure :file-name
     2655       ,input ''
     2656       ,input ?
     2657       ) no-error.
     2658     if error-status :error then do:
     2659       message
     2660         "Ошибка при вызове помощи"
     2661         error-status :get-message(1)
     2662         view-as alert-box .
     2663     end.
     2664   end.
     2665   run minbtn-set in this-procedure .
     2666   on choose of b-help in frame Dialog-Frame
     2667   do:
     2668     apply "help":u to frame Dialog-Frame .
     2669   end.
     2670   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2671   procedure minbtn-set :
     2672       do
     2673           on error undo, return error return-value
     2674           :
     2675           define variable ii              as integer       no-undo .
     2676           define variable fh              as widget-handle no-undo .
     2677           define variable hh              as widget-handle no-undo .
     2678           define variable v-h             as handle        extent 4 no-undo .
     2679           define variable v-name-button   as character     no-undo .
     2680           define variable v-help-old-x    as decimal       no-undo .
     2681           define variable v-help-old-y    as decimal       no-undo .
     2682           define variable v-help-old-size as decimal       no-undo .
     2683           define variable v-frame-width   as decimal       no-undo .
     2684           define variable jj              as integer       no-undo .
     2685           do
     2686               on error undo, return error
     2687               :
     2688               assign
     2689                   v-frame-width = frame Dialog-Frame:width - 0.3
     2690                   fh            = frame Dialog-Frame:first-child
     2691                   hh            = fh:first-child
     2692                   ii            = 1
     2693                   .
     2694               do while valid-handle(hh):
     2695                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2696                   do:
     2697                       case lc(hh:name) :
     2698                           when "b-help" then
     2699                               do:
     2700                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2701                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2702                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2703                                   hh:TOOLTIP = "Помощь" .
     2704                                   v-help-old-x = hh:column .
     2705                                   v-help-old-y = hh:row    .
     2706                                   v-help-old-size = hh:width .
     2707                                   hh:width-chars = 2.5 .
     2708                               end.
     2709                           when "b-print" then
     2710                               do:
     2711                                   hh:load-image("cmp/b-print.bmp":u) .
     2712                                   hh:TOOLTIP = "Печать" .
     2713                                   v-h[ii] = hh:handle .
     2714                                   ii = ii + 1 .
     2715                                   hh:width-chars = 3 .
     2716                               end.
     2717                           when "b-history" or
     2718                           when "b-hist" then
     2719                               do:
     2720                                   hh:load-image("cmp/b-hist.bmp":u) .
     2721                                   hh:TOOLTIP = "История" .
     2722                                   v-h[ii] = hh:handle .
     2723                                   ii = ii + 1 .
     2724                                   hh:width-chars = 3 .
     2725                               end.
     2726                           when "b-sch" then
     2727                               do:
     2728                                   hh:load-image("cmp/b-sch.bmp":u) .
     2729                                   hh:TOOLTIP = "Установка Фильтра" .
     2730                                   v-h[ii] = hh:handle .
     2731                                   ii = ii + 1 .
     2732                                   hh:width-chars = 3 .
     2733                               end.
     2734                           when "b-hist-user" then
     2735                               do:
     2736                                   hh:load-image("cmp/b-hist.bmp":u) .
     2737                                   hh:TOOLTIP = "История пользователя" .
     2738                                   ii = ii + 1 .
     2739                               end.
     2740                       end case.
     2741                   end.
     2742                   hh = hh:next-sibling.
     2743               end.
     2744               b-help:column = v-frame-width - b-help:width-chars.
     2745               jj = 0.
     2746               repeat ii = 4 to 1 by -1 :
     2747                   if valid-handle (v-h[ii] ) then
     2748                   do:
     2749                       jj  = jj + 1 .
     2750                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2751                       v-h[ii]:row    = v-help-old-y .
     2752                   end.
     2753               end.
     2754           end.
     2755       end.
     2756   end procedure.
     2757   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2758   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2759   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2760   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2761   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2762   define variable v-diasize-current-frame-height as decimal   no-undo .
     2763   define variable v-diasize-change-size          as logical   no-undo .
     2764   define variable v-diasize-resize-button        as handle    no-undo .
     2765   define variable v-diasize-wndmax               as logical   no-undo .
     2766   define variable v-diasize-wndstore             as logical   no-undo .
     2767   define variable v-diasize-proc-name            as character no-undo .
     2768   define variable v-diasize-browse-handle        as handle    no-undo .
     2769   define variable v-diasize-browse-number        as integer   no-undo .
     2770   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2771   define temp-table temp-diasize-handle no-undo
     2772     field handle-value  as handle
     2773     field save-position as decimal
     2774     index xpk is primary unique handle-value
     2775     .
     2776   define temp-table temp-browse-handle no-undo
     2777     field browse-type   as character
     2778     field browse-number as integer
     2779     field browse-handle as handle
     2780     field original-size as decimal
     2781     index xpk is primary unique browse-type browse-number
     2782     index xie browse-type browse-handle
     2783   .
     2784   procedure diasize_change-height :
     2785     define input  parameter p-change-value  as decimal   no-undo .
     2786     define input  parameter p-move-resize   as logical   no-undo .
     2787     define variable v-field-group-handle    as handle    no-undo .
     2788     define variable v-object-handle         as handle    no-undo .
     2789     define variable v-frame-height          as decimal   no-undo .
     2790     define variable v-frame-virtual-height  as decimal   no-undo .
     2791     define variable v-browse-height         as decimal   no-undo .
     2792     define variable v-window-height         as decimal   no-undo .
     2793     define variable v-window-virtual-height as decimal   no-undo .
     2794     define variable v-change-sign           as integer   no-undo .
     2795     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2796     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2797     if p-change-value > 0
     2798     then do:
     2799       if frame Dialog-Frame :height + p-change-value
     2800           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2801       then do:
     2802         assign
     2803           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2804                           - (frame Dialog-Frame :height-chars)
     2805         .
     2806         if p-change-value <= 0
     2807         then do:
     2808           run diasize_position-resize-button in this-procedure .
     2809           return .
     2810         end.
     2811       end.
     2812     end.
     2813     if p-change-value < 0
     2814     then do:
     2815       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2816       then do:
     2817         assign
     2818           p-change-value = v-diasize-orig-frame-height
     2819                          - (frame Dialog-Frame :height-chars)
     2820         .
     2821         if p-change-value >= 0
     2822         then do:
     2823           run diasize_position-resize-button in this-procedure .
     2824           return .
     2825         end.
     2826       end.
     2827     end.
     2828     if p-change-value >= 0
     2829     then do:
     2830       assign
     2831         v-change-sign = 1
     2832       .
     2833     end.
     2834     else do:
     2835       assign
     2836         v-change-sign = -1
     2837       .
     2838     end.
     2839     assign
     2840       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2841     .
     2842     if p-change-value = 0
     2843     then do:
     2844       run diasize_position-resize-button in this-procedure .
     2845       return .
     2846     end.
     2847     move_block:
     2848     do
     2849     on error undo move_block, retry move_block
     2850     :
     2851       if retry
     2852       then do:
     2853         do
     2854         on error undo move_block, leave move_block
     2855         :
     2856           if p-change-value > 0
     2857           then do:
     2858             for each buf_temp-diasize-handle
     2859             on error undo, next
     2860             :
     2861               assign
     2862                 v-object-handle = buf_temp-diasize-handle.handle-value
     2863               .
     2864               if v-object-handle <> v-diasize-resize-button
     2865               then do:
     2866                 assign
     2867                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2868                 .
     2869               end.
     2870             end.
     2871             assign
     2872               v-diasize-browse-handle :height = v-browse-height
     2873             .
     2874             for each buf_temp-browse-handle
     2875               where buf_temp-browse-handle.browse-type = 'height':u
     2876             on error undo, next
     2877             :
     2878               assign
     2879                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2880               .
     2881             end.
     2882             assign
     2883               frame Dialog-Frame :height = v-frame-height
     2884             .
     2885             if frame Dialog-Frame :scrollable = true
     2886             then do:
     2887               assign
     2888                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2889               .
     2890             end.
     2891             run diasize_position-resize-button in this-procedure .
     2892           end.
     2893           else do:
     2894             if frame Dialog-Frame :scrollable = true
     2895             then do:
     2896               assign
     2897                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2898               .
     2899             end.
     2900             assign
     2901               frame Dialog-Frame :height = v-frame-height
     2902             .
     2903             assign
     2904               v-diasize-browse-handle :height = v-browse-height
     2905             .
     2906             for each buf_temp-browse-handle
     2907               where buf_temp-browse-handle.browse-type = 'height':u
     2908             on error undo, next
     2909             :
     2910               assign
     2911                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2912               .
     2913             end.
     2914             for each buf_temp-diasize-handle
     2915             on error undo, next
     2916             :
     2917               assign
     2918                 v-object-handle = buf_temp-diasize-handle.handle-value
     2919               .
     2920               if v-object-handle <> v-diasize-resize-button
     2921               then do:
     2922                 assign
     2923                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2924                 .
     2925               end.
     2926             end.
     2927             run diasize_position-resize-button in this-procedure .
     2928           end.
     2929           assign
     2930             v-diasize-change-size = false
     2931           .
     2932           leave move_block .
     2933         end.
     2934       end.
     2935       assign
     2936         v-diasize-need-full-display = true
     2937       .
     2938       if v-diasize-change-size = false
     2939       then do:
     2940         assign
     2941           v-diasize-change-size = true
     2942         .
     2943       end.
     2944       else do:
     2945         return .
     2946       end.
     2947       assign
     2948         v-frame-height = frame Dialog-Frame :height
     2949         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2950         v-browse-height = v-diasize-browse-handle :height
     2951       .
     2952       for each buf_temp-browse-handle
     2953         where buf_temp-browse-handle.browse-type = 'height':u
     2954       :
     2955         assign
     2956           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2957         .
     2958       end.
     2959       for each buf_temp-diasize-handle
     2960       :
     2961         delete buf_temp-diasize-handle .
     2962       end.
     2963       assign
     2964         v-field-group-handle = frame Dialog-Frame :first-child
     2965       .
     2966       do while valid-handle(v-field-group-handle)
     2967       :
     2968         assign
     2969           v-object-handle = v-field-group-handle :first-child
     2970         .
     2971         do while valid-handle(v-object-handle)
     2972         :
     2973           if  v-object-handle <> v-diasize-browse-handle :handle
     2974           and can-query(v-object-handle, "row")
     2975           and can-query(v-object-handle, "height")
     2976           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2977           then do:
     2978             find first buf_temp-browse-handle
     2979               where buf_temp-browse-handle.browse-type   = 'height':u
     2980                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2981               no-error .
     2982             if available buf_temp-browse-handle
     2983             then do:
     2984             end.
     2985             else do:
     2986               create buf_temp-diasize-handle .
     2987               assign
     2988                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2989                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2990               .
     2991             end.
     2992           end.
     2993           assign
     2994             v-object-handle = v-object-handle :next-sibling
     2995           .
     2996         end.
     2997         assign
     2998           v-field-group-handle = v-field-group-handle :next-sibling
     2999         .
     3000       end.
     3001       do with frame Dialog-Frame
     3002       :
     3003         hide v-diasize-resize-button .
     3004         assign
     3005           v-diasize-resize-button :row    = 1
     3006           v-diasize-resize-button :column = 1
     3007         .
     3008       end.
     3009       if p-change-value > 0
     3010       then do:
     3011         if frame Dialog-Frame :scrollable = true
     3012         then do:
     3013           assign
     3014             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3015             no-error .
