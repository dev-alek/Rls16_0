     4526                          "Все&!" + chr(44) + 'все':U + chr(44) +
     4527                           "Без привязки&-" + chr(44) + "-":U
     4528   rs-mode = p-mode
     4529   t-name = logical(entry(1, p-status, chr(4)))
     4530   t-group = logical(entry(2, p-status, chr(4)))
     4531   .
     4532   rs-sch = "id":U.
     4533   DISPLAY
     4534   rs-mode
     4535   sch-id
     4536   mark-num
     4537   WITH FRAME Dialog-Frame.
     4538   run proc-buttons in this-procedure(no).
