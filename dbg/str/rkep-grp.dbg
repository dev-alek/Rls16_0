     3029         end.
     3030         assign
     3031           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3032           no-error .
     3033         if error-status :error
     3034         or error-status :get-message(1) <> ""
     3035         then do:
     3036           undo move_block, retry move_block .
     3037         end.
     3038         for each buf_temp-browse-handle
     3039           where buf_temp-browse-handle.browse-type = 'height':u
     3040         on error undo move_block, retry move_block
     3041         :
     3042           assign
     3043             buf_temp-browse-handle.browse-handle :height
     3044               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3045             no-error .
     3046           if error-status :error
     3047           or error-status :get-message(1) <> ""
     3048           then do:
     3049             undo move_block, retry move_block .
     3050           end.
     3051         end.
     3052         for each buf_temp-diasize-handle
     3053         on error undo move_block, retry move_block
     3054         :
     3055           assign
     3056             v-object-handle = buf_temp-diasize-handle.handle-value
     3057           .
     3058           if v-object-handle <> v-diasize-resize-button
     3059           then do:
     3060             assign
     3061               v-object-handle :row = v-object-handle :row + p-change-value
     3062               no-error .
     3063             if error-status :error
     3064             or error-status :get-message(1) <> ""
     3065             then do:
     3066               undo move_block, retry move_block .
     3067             end.
     3068           end.
     3069         end.
     3070       end.
     3071       else do:
     3072         for each buf_temp-diasize-handle
     3073         on error undo move_block, retry move_block
     3074         :
     3075           assign
     3076             v-object-handle = buf_temp-diasize-handle.handle-value
     3077           .
     3078           if v-object-handle <> v-diasize-resize-button
     3079           then do:
     3080             assign
     3081               v-object-handle :row = v-object-handle :row + p-change-value
     3082               no-error .
     3083             if error-status :error
     3084             or error-status :get-message(1) <> ""
     3085             then do:
     3086               undo move_block, retry move_block .
     3087             end.
     3088           end.
     3089         end.
     3090         assign
     3091           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3092           no-error .
     3093         if error-status :error
     3094         or error-status :get-message(1) <> ""
     3095         then do:
     3096           undo move_block, retry move_block .
     3097         end.
     3098         for each buf_temp-browse-handle
     3099           where buf_temp-browse-handle.browse-type = 'height':u
     3100         on error undo move_block, retry move_block
     3101         :
     3102           assign
     3103             buf_temp-browse-handle.browse-handle :height
     3104               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3105             no-error .
     3106           if error-status :error
     3107           or error-status :get-message(1) <> ""
     3108           then do:
     3109             undo move_block, retry move_block .
     3110           end.
     3111         end.
     3112         assign
     3113           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3114           no-error .
     3115         if error-status :error
     3116         or error-status :get-message(1) <> ""
     3117         then do:
     3118           undo move_block, retry move_block .
     3119         end.
     3120         if frame Dialog-Frame :scrollable = true
     3121         then do:
     3122           assign
     3123             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3124             no-error .
     3125           if error-status :error
     3126           or error-status :get-message(1) <> ""
     3127           then do:
     3128             undo move_block, retry move_block .
     3129           end.
     3130         end.
     3131       end.
     3132       if p-move-resize = true
     3133       then do:
     3134         run diasize_position-resize-button in this-procedure .
     3135       end.
     3136       if v-diasize-wndstore = true
     3137       then do:
     3138         if connected("ub") = true
     3139         then do:
     3140           define variable v-cntxt-db-num        as integer   no-undo .
     3141           define variable v-cntxt-userid        as character no-undo .
     3142           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3143                                             , OUTPUT v-cntxt-userid
     3144                                             ) .
     3145           run gbl/wndsizew.p
     3146             (input  v-cntxt-db-num
     3147             ,input  v-cntxt-userid
     3148             ,input  v-diasize-proc-name
     3149             ,input  'height':u
     3150             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3151             ) .
     3152         end.
     3153       end.
     3154     end.
     3155     assign
     3156       v-diasize-change-size = false
     3157     .
     3158   end procedure.
     3159   procedure diasize_set-height :
     3160     define input  parameter p-new-height  as decimal   no-undo .
     3161     define input  parameter p-move-resize as logical   no-undo .
     3162     do
     3163     on error undo, return error return-value
     3164     :
     3165       run diasize_change-height in this-procedure
     3166         (input  (p-new-height - frame Dialog-Frame :height)
     3167         ,input  p-move-resize
     3168         ) .
     3169     end.
     3170   end procedure.
     3171   procedure diasize_change-width :
     3172     define input  parameter p-change-value as decimal   no-undo .
     3173     define input  parameter p-move-resize  as logical   no-undo .
     3174     define variable v-field-group-handle   as handle    no-undo .
     3175     define variable v-object-handle        as handle    no-undo .
     3176     define variable v-frame-width          as decimal   no-undo .
     3177     define variable v-frame-virtual-width  as decimal   no-undo .
     3178     define variable v-browse-width         as decimal   no-undo .
     3179     define variable v-window-width         as decimal   no-undo .
     3180     define variable v-window-virtual-width as decimal   no-undo .
     3181     define variable v-change-sign          as integer   no-undo .
     3182     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3183     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3184     if p-change-value > 0
     3185     then do:
     3186       if frame Dialog-Frame :width + p-change-value >
     3187           session :width-chars
     3188       then do:
     3189         assign
     3190           p-change-value = session :width-chars - frame Dialog-Frame :width
     3191         .
     3192         if p-change-value <= 0
     3193         then do:
     3194           run diasize_position-resize-button in this-procedure .
     3195           return .
     3196         end.
     3197       end.
     3198     end.
     3199     if p-change-value < 0
     3200     then do:
     3201       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3202       then do:
     3203         assign
     3204           p-change-value = v-diasize-orig-frame-width
     3205                          - frame Dialog-Frame :width
     3206         .
     3207         if p-change-value >= 0
     3208         then do:
     3209           run diasize_position-resize-button in this-procedure .
     3210           return .
     3211         end.
     3212       end.
     3213     end.
     3214     if p-change-value >= 0
     3215     then do:
     3216       assign
     3217         v-change-sign = 1
     3218       .
     3219     end.
     3220     else do:
     3221       assign
     3222         v-change-sign = -1
     3223       .
     3224     end.
     3225     assign
     3226       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3227     .
     3228     if p-change-value = 0
     3229     then do:
     3230       run diasize_position-resize-button in this-procedure .
     3231       return .
     3232     end.
     3233     move_block:
     3234     do
     3235     on error undo move_block, leave move_block
     3236     :
     3237       if retry
     3238       then do:
     3239         do
     3240         on error undo move_block, leave move_block
     3241         :
     3242           if p-change-value > 0
     3243           then do:
     3244             for each buf_temp-diasize-handle
     3245             on error undo, next
     3246             :
     3247               assign
     3248                 v-object-handle = buf_temp-diasize-handle.handle-value
     3249               .
     3250               if v-object-handle <> v-diasize-resize-button
     3251               then do:
     3252                 assign
     3253                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3254                 .
     3255               end.
     3256             end.
     3257             assign
     3258               v-diasize-browse-handle :width = v-browse-width
     3259             .
     3260             for each buf_temp-browse-handle
     3261               where buf_temp-browse-handle.browse-type = 'width':u
     3262             on error undo, next
     3263             :
     3264               assign
     3265                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3266               .
     3267             end.
     3268             assign
     3269               frame Dialog-Frame :width = v-frame-width
     3270             .
     3271             if frame Dialog-Frame :scrollable = true
     3272             then do:
     3273               assign
     3274                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3275               .
     3276             end.
     3277             run diasize_position-resize-button in this-procedure .
     3278           end.
     3279           else do:
     3280             if frame Dialog-Frame :scrollable = true
     3281             then do:
     3282               assign
     3283                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3284               .
     3285             end.
     3286             assign
     3287               frame Dialog-Frame :width = v-frame-width
     3288             .
     3289             for each buf_temp-browse-handle
     3290               where buf_temp-browse-handle.browse-type = 'width':u
     3291             on error undo, next
     3292             :
     3293               assign
     3294                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3295               .
     3296             end.
     3297             assign
     3298               v-diasize-browse-handle :width = v-browse-width
     3299             .
     3300             for each buf_temp-diasize-handle
     3301             on error undo, next
     3302             :
     3303               assign
     3304                 v-object-handle = buf_temp-diasize-handle.handle-value
     3305               .
     3306               if v-object-handle <> v-diasize-resize-button
     3307               then do:
     3308                 assign
     3309                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3310                 .
     3311               end.
     3312             end.
     3313             run diasize_position-resize-button in this-procedure .
     3314           end.
     3315           assign
     3316             v-diasize-change-size = false
     3317           .
     3318           leave move_block .
     3319         end.
     3320       end.
     3321       assign
     3322         v-diasize-need-full-display = true
     3323       .
     3324       if v-diasize-change-size = false
     3325       then do:
     3326         assign
     3327           v-diasize-change-size = true
     3328         .
     3329       end.
     3330       else do:
     3331         return .
     3332       end.
     3333       assign
     3334         v-frame-width = frame Dialog-Frame :width
     3335         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3336         v-browse-width = v-diasize-browse-handle :width
     3337       .
     3338       for each buf_temp-browse-handle
     3339         where buf_temp-browse-handle.browse-type = 'width':u
     3340       :
     3341         assign
     3342           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3343         .
     3344       end.
     3345       for each buf_temp-diasize-handle
     3346       :
     3347         delete buf_temp-diasize-handle .
     3348       end.
     3349       assign
     3350         v-field-group-handle = frame Dialog-Frame :first-child
     3351       .
     3352       do while valid-handle(v-field-group-handle)
     3353       :
     3354         assign
     3355           v-object-handle = v-field-group-handle :first-child
     3356         .
     3357         do while valid-handle(v-object-handle)
     3358         :
     3359           if  v-object-handle <> v-diasize-browse-handle :handle
     3360           and v-object-handle <> v-diasize-resize-button
     3361           and can-query(v-object-handle, "row")
     3362           and can-query(v-object-handle, "height")
     3363           and ( v-object-handle :col + v-object-handle :width
     3364                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3365               )
     3366           then do:
     3367             find first buf_temp-browse-handle
     3368               where buf_temp-browse-handle.browse-type   = 'width':u
     3369                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3370               no-error .
     3371             if available buf_temp-browse-handle
     3372             then do:
     3373             end.
     3374             else do:
     3375               create buf_temp-diasize-handle .
     3376               assign
     3377                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3378                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3379               .
     3380             end.
     3381           end.
     3382           assign
     3383             v-object-handle = v-object-handle :next-sibling
     3384           .
     3385         end.
     3386         assign
     3387           v-field-group-handle = v-field-group-handle :next-sibling
     3388         .
     3389       end.
     3390       do with frame Dialog-Frame
     3391       :
     3392         hide v-diasize-resize-button .
     3393         v-diasize-resize-button :row = 1.
     3394         v-diasize-resize-button :column = 1.
     3395       end.
     3396       if p-change-value > 0
     3397       then do:
     3398         if frame Dialog-Frame :scrollable = true
     3399         then do:
     3400           assign
     3401             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3402             no-error .
     3403           if error-status :error
     3404           or error-status :get-message(1) <> ""
     3405           then do:
     3406             undo move_block, retry move_block.
     3407           end.
     3408         end.
     3409         assign
     3410           frame Dialog-Frame :width = v-frame-width + p-change-value
     3411           no-error .
     3412         if error-status :error
     3413         or error-status :get-message(1) <> ""
     3414         then do:
     3415           undo move_block, retry move_block.
     3416         end.
     3417         assign
     3418           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3419         no-error .
     3420         if error-status :error
     3421         or error-status :get-message(1) <> ""
     3422         then do:
     3423           undo move_block, retry move_block.
     3424         end.
     3425         for each buf_temp-browse-handle
     3426           where buf_temp-browse-handle.browse-type = 'width':u
     3427         on error undo move_block, retry move_block
     3428         :
     3429           assign
     3430             buf_temp-browse-handle.browse-handle :width
     3431               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3432             no-error .
     3433           if error-status :error
     3434           or error-status :get-message(1) <> ""
     3435           then do:
     3436             undo move_block, retry move_block .
     3437           end.
     3438         end.
     3439         for each buf_temp-diasize-handle
     3440         on error undo move_block, retry move_block
     3441         :
     3442           assign
     3443             v-object-handle = buf_temp-diasize-handle.handle-value
     3444           .
     3445           if v-object-handle <> v-diasize-resize-button
     3446           then do:
     3447             assign
     3448               v-object-handle :col = v-object-handle :col + p-change-value
     3449               no-error .
     3450             if error-status :error
     3451             or error-status :get-message(1) <> ""
     3452             then do:
     3453               undo move_block, retry move_block .
     3454             end.
     3455           end.
     3456         end.
     3457       end.
     3458       else do:
     3459         for each buf_temp-diasize-handle
     3460         on error undo move_block, retry move_block
     3461         :
     3462           assign
     3463             v-object-handle = buf_temp-diasize-handle.handle-value
     3464           .
     3465           if v-object-handle <> v-diasize-resize-button
     3466           then do:
     3467             assign
     3468               v-object-handle :col = v-object-handle :col + p-change-value
     3469               no-error .
     3470             if error-status :error
     3471             or error-status :get-message(1) <> ""
     3472             then do:
     3473               undo move_block, retry move_block .
     3474             end.
     3475           end.
     3476         end.
     3477         for each buf_temp-browse-handle
     3478           where buf_temp-browse-handle.browse-type = 'width':u
     3479         on error undo move_block, retry move_block
     3480         :
     3481           assign
     3482             buf_temp-browse-handle.browse-handle :width
     3483               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3484             no-error .
     3485           if error-status :error
     3486           or error-status :get-message(1) <> ""
     3487           then do:
     3488             undo move_block, retry move_block .
     3489           end.
     3490         end.
     3491         assign
     3492           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3493           no-error .
     3494         if error-status :error
     3495         or error-status :get-message(1) <> ""
     3496         then do:
     3497           undo move_block, retry move_block.
     3498         end.
     3499         assign
     3500           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3501         no-error .
     3502         if error-status :error
     3503         or error-status :get-message(1) <> ""
     3504         then do:
     3505           undo move_block, retry move_block.
     3506         end.
     3507         if frame Dialog-Frame :scrollable = true
     3508         then do:
     3509           assign
     3510             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3511           no-error .
     3512           if error-status :error
     3513           or error-status :get-message(1) <> ""
     3514           then do:
     3515             undo move_block, retry move_block.
     3516           end.
     3517         end.
     3518       end.
     3519       if p-move-resize
     3520       then do:
     3521         run diasize_position-resize-button in this-procedure .
     3522       end.
     3523       if v-diasize-wndstore = true
     3524       then do:
     3525         if connected("ub") = true
     3526         then do:
     3527           define variable v-cntxt-db-num        as integer   no-undo .
     3528           define variable v-cntxt-userid        as character no-undo .
     3529           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3530                                             , OUTPUT v-cntxt-userid
     3531                                             ) .
     3532           run gbl/wndsizew.p
     3533             (input  v-cntxt-db-num
     3534             ,input  v-cntxt-userid
     3535             ,input  v-diasize-proc-name
     3536             ,input  'width':u
     3537             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3538             ) .
     3539         end.
     3540       end.
     3541     end.
     3542     assign
     3543       v-diasize-change-size = false
     3544     .
     3545   end procedure.
     3546   procedure diasize_set-width :
     3547     define input  parameter p-new-width  as decimal   no-undo .
     3548     define input  parameter p-move-resize as logical   no-undo .
     3549     do
     3550     on error undo, return error return-value
     3551     :
     3552       run diasize_change-width in this-procedure
     3553         (input  (p-new-width - frame Dialog-Frame :width)
     3554         ,input  p-move-resize
     3555         ) .
     3556     end.
     3557   end procedure.
     3558   procedure diasize_position-resize-button :
     3559     do with frame Dialog-Frame
     3560     :
     3561       hide v-diasize-resize-button .
     3562       assign
     3563         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3564                     - 1
     3565                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3566         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3567                     - 1
     3568                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3569       .
     3570       view v-diasize-resize-button .
     3571     end.
     3572   end procedure.
     3573   on alt-right anywhere
     3574   do:
     3575     run diasize_change-width in this-procedure
     3576       (input 1
     3577       ,input true
     3578       ) .
     3579     return no-apply .
     3580   end.
     3581   on alt-left anywhere
     3582   do:
     3583     run diasize_change-width in this-procedure
     3584       (input -1
     3585       ,input true
     3586       ) .
     3587     return no-apply .
     3588   end.
     3589   on alt-down anywhere
     3590   do:
     3591     run diasize_change-height in this-procedure
     3592       (input 1
     3593       ,input true
     3594       ) .
     3595     return no-apply .
     3596   end.
     3597   on alt-up anywhere
     3598   do:
     3599     run diasize_change-height in this-procedure
     3600       (input -1
     3601       ,input true
     3602       ) .
     3603     return no-apply .
     3604   end.
     3605   on alt-enter of frame Dialog-Frame
     3606   do:
     3607     run diasize_maximize in this-procedure
     3608       (input  ?
     3609       ).
     3610     return no-apply .
     3611   end.
     3612   procedure diasize_end-move :
     3613     do
     3614     on error undo, return error return-value
     3615     :
     3616       define variable v-row-delta as decimal   no-undo .
     3617       define variable v-col-delta as decimal   no-undo .
     3618       define variable v-new-row as decimal   no-undo .
     3619       define variable v-new-col as decimal   no-undo .
     3620       assign
     3621         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3622         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3623       .
     3624       assign
     3625         v-row-delta = v-new-row - frame Dialog-Frame :height
     3626         v-col-delta = v-new-col - frame Dialog-Frame :width
     3627       .
     3628       run diasize_change-height in this-procedure
     3629         (input v-row-delta
     3630         ,input true
     3631         ) .
     3632       run diasize_change-width in this-procedure
     3633         (input v-col-delta
     3634         ,input true
     3635         ) .
     3636     end.
     3637   end procedure.
     3638   procedure diasize_maximize :
     3639     define input  parameter p-action as logical   no-undo .
     3640     do
     3641     on error undo, return error return-value
     3642     :
     3643       if p-action = ?
     3644       then do:
     3645         if v-diasize-need-maximize = true
     3646         then do:
     3647           assign
     3648             p-action = true
     3649           .
     3650         end.
     3651         else do:
     3652           assign
     3653             p-action = false
     3654           .
     3655         end.
     3656       end.
     3657       if p-action = true
     3658       then do:
     3659         run diasize_change-height in this-procedure
     3660           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3661               - frame Dialog-Frame :height-chars
     3662           ,input true
     3663           ) .
     3664         run diasize_change-width in this-procedure
     3665           (input session :width-chars
     3666               - frame Dialog-Frame :width-chars
     3667           ,input true
     3668           ) .
     3669         assign
     3670           v-diasize-need-maximize = false
     3671         .
     3672       end.
     3673       else do:
     3674         run diasize_change-width in this-procedure
     3675           (input v-diasize-orig-frame-width
     3676               - frame Dialog-Frame :width-chars
     3677           ,input true
     3678           ) .
     3679         run diasize_change-height in this-procedure
     3680           (input v-diasize-orig-frame-height
     3681               - frame Dialog-Frame :height-chars
     3682           ,input true
     3683           ) .
     3684         assign
     3685           v-diasize-need-maximize = true
     3686         .
     3687       end.
     3688     end.
     3689   end procedure.
     3690   procedure diasize_restore-orig-size :
     3691     do
     3692     on error undo, return error return-value
     3693     :
     3694       assign
     3695         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3696         v-diasize-current-frame-height = frame Dialog-Frame :height
     3697       .
     3698       run diasize_set-height in this-procedure
     3699         (input  v-diasize-orig-frame-height
     3700         ,input  true
     3701         ) .
     3702       run diasize_set-width in this-procedure
     3703         (input  v-diasize-orig-frame-width
     3704         ,input  true
     3705         ) .
     3706     end.
     3707   end procedure.
     3708   procedure diasize_restore-current-size :
     3709     do
     3710     on error undo, return error return-value
     3711     :
     3712       run diasize_set-height in this-procedure
     3713         (input  v-diasize-current-frame-height
     3714         ,input  true
     3715         ) .
     3716       run diasize_set-width in this-procedure
     3717         (input  v-diasize-current-frame-width
     3718         ,input  true
     3719         ) .
     3720     end.
     3721   end procedure.
     3722   procedure diasize_set-browse-handle :
     3723     define input  parameter p-browse-handle as handle   no-undo .
     3724     define buffer buf_temp-browse-handle for temp-browse-handle .
     3725     do
     3726     on error undo, return error return-value
     3727     :
     3728       assign
     3729         v-diasize-browse-handle = p-browse-handle
     3730       .
     3731       for each buf_temp-browse-handle
     3732       on error undo, return error return-value
     3733       :
     3734         delete buf_temp-browse-handle .
     3735       end.
     3736     end.
     3737   end procedure.
     3738   procedure diasize_add_browse :
     3739     define input  parameter p-browse-type   as character no-undo .
     3740     define input  parameter p-browse-handle as handle    no-undo .
     3741     define buffer buf_temp-browse-handle for temp-browse-handle .
     3742     do
     3743     on error undo, return error return-value
     3744     :
     3745       assign
     3746         v-diasize-browse-number = v-diasize-browse-number + 1
     3747       .
     3748       create buf_temp-browse-handle .
     3749       assign
     3750         buf_temp-browse-handle.browse-type   = p-browse-type
     3751         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3752         buf_temp-browse-handle.browse-handle = p-browse-handle
     3753       .
     3754     end.
     3755   end procedure.
     3756   procedure diasize_init :
     3757     define variable v-default-value    as logical   no-undo .
     3758     define variable v-restore-saved    as logical   no-undo .
     3759     define variable v-resize-value-str as character no-undo .
     3760     do
     3761     on error undo, return error return-value
     3762     :
     3763       do with frame Dialog-Frame
     3764       :
     3765         assign
     3766           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3767           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3768           v-diasize-browse-handle     = browse BR-rkep-grp :handle
     3769         .
     3770         create button v-diasize-resize-button
     3771         assign
     3772           parent        = frame Dialog-Frame :first-child
     3773           label         = "s"
     3774           height-pixels = 16
     3775           width-pixels  = 16
     3776           visible       = true
     3777           sensitive     = true
     3778           movable       = true
     3779           triggers:
     3780             on end-move persistent run diasize_end-move in this-procedure .
     3781           end triggers.
     3782         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3783         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3784         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3785         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3786         assign
     3787           v-diasize-wndmax = false
     3788         .
     3789         if connected("ub") = true
     3790         then do:
     3791           define variable v-cntxt-db-num        as integer   no-undo .
     3792           define variable v-cntxt-userid        as character no-undo .
     3793           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3794                                             , OUTPUT v-cntxt-userid
     3795                                             ) .
     3796           run gbl/wndpar_r.p
     3797             (input  v-cntxt-db-num
     3798             ,input  v-cntxt-userid
     3799             ,input  'wndmax':U
     3800             ,output v-diasize-wndmax
     3801             ,output v-default-value
     3802             ) .
     3803         end.
     3804         assign
     3805           v-diasize-wndstore = false
     3806         .
     3807         if connected("ub") = true
     3808         then do:
     3809           run gbl/wndpar_r.p
     3810             (input  v-cntxt-db-num
     3811             ,input  v-cntxt-userid
     3812             ,input  'wndstore':U
     3813             ,output v-diasize-wndstore
     3814             ,output v-default-value
     3815             ) .
     3816         end.
     3817         assign
     3818           v-diasize-proc-name = entry(1, program-name(2), '.')
     3819         .
     3820         if v-diasize-wndstore = true
     3821         then do:
     3822           assign
     3823             v-restore-saved = false
     3824           .
     3825           if connected("ub") = true
     3826           then do:
     3827             run gbl/wndsizer.p
     3828               (input  v-cntxt-db-num
     3829               ,input  v-cntxt-userid
     3830               ,input  v-diasize-proc-name
     3831               ,input  'height':u
     3832               ,output v-resize-value-str
     3833               ) .
     3834             if v-resize-value-str <> '':U
     3835             then do:
     3836               run diasize_change-height in this-procedure
     3837                 (input  integer(v-resize-value-str)
     3838                 ,input  true
     3839                 ) .
     3840               assign
     3841                 v-restore-saved = true
     3842               .
     3843             end.
     3844           end.
     3845           if connected("ub") = true
     3846           then do:
     3847             run gbl/wndsizer.p
     3848               (input  v-cntxt-db-num
     3849               ,input  v-cntxt-userid
     3850               ,input  v-diasize-proc-name
     3851               ,input  'width':u
     3852               ,output v-resize-value-str
     3853               ) .
     3854             if v-resize-value-str <> '':U
     3855             then do:
     3856               run diasize_change-width in this-procedure
     3857                 (input  integer(v-resize-value-str)
     3858                 ,input  true
     3859                 ) .
     3860               assign
     3861                 v-restore-saved = true
     3862               .
     3863             end.
     3864           end.
     3865           if v-restore-saved <> true
     3866           then do:
     3867             if v-diasize-wndmax = true
     3868             then do:
     3869               run diasize_maximize in this-procedure
     3870                 (input  true
     3871                 ) .
     3872             end.
     3873           end.
     3874         end.
     3875         else do:
     3876           if v-diasize-wndmax = true
     3877           then do:
     3878             run diasize_maximize in this-procedure
     3879               (input  true
     3880               ) .
     3881           end.
     3882         end.
     3883       end.
     3884     end.
     3885   end procedure.
     3886   procedure diasize_need-full-display :
     3887     define output parameter p-need-full-display as logical   no-undo .
     3888     do
     3889     on error undo, return error return-value
     3890     :
     3891       assign
     3892         p-need-full-display = v-diasize-need-full-display
     3893       .
     3894       assign
     3895         v-diasize-need-full-display = false
     3896       .
     3897     end.
     3898   end procedure.
     3899   procedure get-context :
     3900      define output parameter p-db-num as integer          no-undo.
     3901      define output parameter p-user-id as character        no-undo.
     3902      define variable v-login               as character    no-undo.
     3903      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3904      define buffer buf_user-login  for ub.user-login .
     3905      do
     3906      on error undo, return error
     3907      :
     3908            FIND FIRST buf_sys-ctrl no-lock.
     3909            ASSIGN
     3910               v-login = USERID("ub")
     3911               p-db-num = buf_sys-ctrl.db-num
     3912            .
     3913            FIND FIRST buf_user-login
     3914                 WHERE buf_user-login.db-num = p-db-num
     3915                   AND buf_user-login.user-login = v-login
     3916                 no-lock
     3917                 no-error
     3918                 .
     3919            IF AVAILABLE buf_user-login
     3920            THEN DO:
     3921               assign
     3922                  p-user-id = buf_user-login.user-id
     3923               .
     3924            END.
     3925      end.
     3926   end procedure.
     3927       run diasize_init in this-procedure .
     3928   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3929   procedure set-filter-name :
     3930   define input parameter p-filter-name as character no-undo .
     3931     do with frame Dialog-Frame:
     3932       if p-filter-name > "" then do:
     3933         assign
     3934           frame Dialog-Frame:title
     3935             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3936         .
     3937         assign
     3938           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3939         .
     3940       end.
     3941       else do:
     3942         assign
     3943           b-sch :tooltip = ""
     3944         .
     3945       end.
     3946     end.
     3947   end procedure.
     3948   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3949   ON TAB ANYWHERE
     3950   DO:
     3951   define variable ii as integer no-undo .
     3952   define variable fh as widget-handle no-undo .
     3953   define variable hh as widget-handle no-undo .
     3954   define variable v-next-widget-name as character no-undo .
     3955   if v-tab-order <> '' then do:
     3956     if self:type = "TOGGLE-BOX" then
     3957     self:BGCOLOR = ?.
     3958     assign
     3959     ii = lookup(self:name, v-tab-order).
     3960     assign
     3961     ii = ii + 1
     3962     v-next-widget-name = entry(ii, v-tab-order)
     3963     no-error .
     3964     if error-status:error then do:
     3965       assign
     3966       ii = 1
     3967       v-next-widget-name = entry( ii, v-tab-order)
     3968       .
     3969     end.
     3970     assign
     3971     fh = frame Dialog-Frame:first-child
     3972     hh = fh:first-child
     3973     .
     3974     do while valid-handle(hh):
     3975       if hh:name = v-next-widget-name then do:
     3976         if hh:sensitive  = yes
     3977         AND hh:visible = yes then do:
     3978           if hh:type = "TOGGLE-BOX":U then do:
     3979             assign
     3980             hh:BGcolor = 1
     3981             .
     3982           end.
     3983           APPLY "ENTRY" to hh.
     3984           return no-apply.
     3985         end.
     3986         else do:
     3987           APPLY "TAB" to hh.
     3988           return no-apply.
     3989         end.
     3990       end.
     3991       hh = hh:next-sibling.
     3992     end.
     3993   end.
     3994   END.
     3995   ON BACK-TAB ANYWHERE
     3996   DO:
     3997   define variable ii as integer no-undo .
     3998   define variable fh as widget-handle no-undo .
     3999   define variable hh as widget-handle no-undo .
     4000   define variable v-next-widget-name as character no-undo .
     4001   if v-tab-order <> '' then do:
     4002     assign
     4003     ii = lookup(self:name, v-tab-order).
     4004     .
     4005     assign
     4006     ii = (if ii = 1
     4007           then  num-entries(v-tab-order)
     4008           else ii - 1
     4009           )
     4010     v-next-widget-name = entry(ii, v-tab-order)
     4011     .
     4012     assign
     4013     fh = frame Dialog-Frame:first-child
     4014     hh = fh:first-child
     4015     .
     4016     do while valid-handle(hh):
     4017       if hh:name = v-next-widget-name then do:
     4018         if hh:sensitive  = yes
     4019         AND hh:visible = yes then do:
     4020           if hh:type = "TOGGLE-BOX":U then do:
     4021             assign
     4022             hh:BGcolor = 1
     4023             .
     4024           end.
     4025           APPLY "ENTRY" to hh.
     4026           return no-apply.
     4027         end.
     4028         else do:
     4029         APPLY "BACK-TAB" to hh.
     4030         return no-apply.
     4031         end.
     4032       end.
     4033       hh = hh:next-sibling.
     4034     end.
     4035     end.
     4036   END.
     4037   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4038   ON RETURN ANYWHERE
     4039   DO:
     4040   define variable ii as integer no-undo .
     4041   define variable fh as widget-handle no-undo .
     4042   define variable hh as widget-handle no-undo .
     4043   define variable v-next-widget-name as character no-undo .
     4044     if v-tab-order <> '' then do:
     4045       assign
     4046       ii = lookup(self:name, v-tab-order).
     4047       if ii = num-entries(v-tab-order) then do:
     4048           APPLY 'CHOOSE' TO b-quit in frame Dialog-Frame.
     4049           return no-apply.
     4050       end.
     4051       if self:type <> "BUTTON" and
     4052         self:type <> "EDITOR"  then do:
     4053         run proc-move-forward in this-procedure .
     4054         return no-apply.
     4055       end.
     4056       if self:type = "BUTTON" then do:
     4057         APPLY "CHOOSE" to self.
     4058       end.
     4059       if self:type = "TOGGLE-BOX" then
     4060       self:BGCOLOR = ?.
     4061       assign
     4062       ii = ii + 1
     4063       v-next-widget-name = entry(ii, v-tab-order)
     4064       no-error .
     4065       if error-status:error then do:
     4066         assign
     4067         ii = 1
     4068         v-next-widget-name = entry( ii, v-tab-order)
     4069         .
     4070       end.
     4071       assign
     4072       fh = frame Dialog-Frame:first-child
     4073       hh = fh:first-child
     4074       .
     4075       do while valid-handle(hh):
     4076         if hh:name = v-next-widget-name then do:
     4077           if hh:sensitive  = yes
     4078           AND hh:visible = yes then do:
     4079             if hh:type = "TOGGLE-BOX":U then do:
     4080               assign
     4081               hh:BGcolor = 1
     4082               .
     4083             end.
     4084             APPLY "ENTRY" to hh.
     4085             return no-apply.
     4086           end.
     4087           else do:
     4088             APPLY "TAB" to hh.
     4089             return no-apply.
     4090           end.
     4091         end.
     4092         hh = hh:next-sibling.
     4093       end.
     4094     end.
     4095   END.
     4096   procedure proc-move-forward :
     4097   define variable ii as integer no-undo .
     4098   define variable fh as widget-handle no-undo .
     4099   define variable hh as widget-handle no-undo .
     4100   define variable v-next-widget-name as character no-undo .
     4101   do
     4102   on error undo, return error
     4103   :
     4104     if v-tab-order <> '' then do:
     4105       if self:type = "TOGGLE-BOX" then
     4106       self:BGCOLOR = ?.
     4107       assign
     4108       ii = lookup(self:name, v-tab-order).
     4109       assign
     4110       ii = ii + 1
     4111       v-next-widget-name = entry(ii, v-tab-order)
     4112       no-error .
     4113       if error-status:error then do:
     4114         assign
     4115         ii = 1
     4116         v-next-widget-name = entry( ii, v-tab-order)
     4117         .
     4118       end.
     4119       assign
     4120       fh = frame Dialog-Frame:first-child
     4121       hh = fh:first-child
     4122       .
     4123       do while valid-handle(hh):
     4124         if hh:name = v-next-widget-name then do:
     4125           if hh:sensitive  = yes
     4126           AND hh:visible = yes then do:
     4127             if hh:type = "TOGGLE-BOX":U then do:
     4128               assign
     4129               hh:BGcolor = 1
     4130               .
     4131             end.
     4132             APPLY "ENTRY" to hh.
     4133             return.
     4134           end.
     4135           else do:
     4136             assign
     4137             ii = ii + 1
     4138             v-next-widget-name = entry(ii, v-tab-order)
     4139             no-error .
     4140             if error-status:error then do:
     4141               assign
     4142               ii = 1
     4143               v-next-widget-name = entry( ii, v-tab-order)
     4144               .
     4145             end.
     4146           end.
     4147         end.
     4148         hh = hh:next-sibling.
     4149       end.
     4150     end.
     4151   end.
     4152   end procedure.
     4153   def var sort-labelBR-rkep-grp   as character no-undo .
     4154   def var sort-clmnBR-rkep-grp    as handle    no-undo .
     4155   def var cur-clmnBR-rkep-grp     as handle    no-undo .
     4156   def var cur-clmn-locBR-rkep-grp as integer   no-undo .
     4157   def var re-queryBR-rkep-grp     as logical   initial no no-undo .
     4158   on start-search, ctrl-o of BR-rkep-grp in frame Dialog-Frame do:
     4159      run sort-brBR-rkep-grp
     4160        (input (if available X_cd-grp
     4161                then recid(X_cd-grp)
     4162                else ?
     4163               )
     4164        ).
     4165   end.
     4166   PROCEDURE sort-brBR-rkep-grp :
     4167     define input parameter p-recid as recid no-undo .
     4168     if re-queryBR-rkep-grp = no then do:
     4169       assign
     4170          cur-clmnBR-rkep-grp = BR-rkep-grp:current-column in frame Dialog-Frame
     4171       .
     4172       if sort-clmnBR-rkep-grp <> ? then sort-clmnBR-rkep-grp:column-fgcolor = 0.
     4173       if cur-clmnBR-rkep-grp = sort-clmnBR-rkep-grp then do:
     4174         assign
     4175            sort-labelBR-rkep-grp = ""
     4176            sort-clmnBR-rkep-grp = ?
     4177         .
     4178        end.
     4179        else do:
     4180          assign
     4181            sort-labelBR-rkep-grp = cur-clmnBR-rkep-grp:label
     4182            sort-clmnBR-rkep-grp  = cur-clmnBR-rkep-grp
     4183            sort-clmnBR-rkep-grp:column-fgcolor = 4
     4184          .
     4185        end.
     4186      end.
     4187     assign
     4188       cur-clmn-locBR-rkep-grp = 1
     4189     .
     4190     def var column-handle as handle no-undo .
     4191     column-handle = BR-rkep-grp:first-column.
     4192     do while valid-handle(column-handle) :
     4193       if column-handle = cur-clmnBR-rkep-grp then do:
     4194         leave .
     4195       end.
     4196       column-handle = column-handle:NEXT-COLUMN.
     4197       assign
     4198         cur-clmn-locBR-rkep-grp = cur-clmn-locBR-rkep-grp + 1
     4199       .
     4200     end.
     4201     case sort-labelBR-rkep-grp:
     4202           when v-id  then DO:    assign       sort-column-name = "X_cd-grp.grp-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     4203           when X_cd-grp.name:label in browse BR-rkep-grp then DO:    assign       sort-column-name = "X_cd-grp.name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     4204       otherwise do:
     4205         assign
     4206           sort-column-name = ""
     4207         .
     4208         run OpenBr in this-procedure ( input yes, input no, input '':U).
     4209           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-rkep-grp') then do:
     4210             run mv-brw-defaultBR-rkep-grp.
     4211           end.
     4212         if sort-labelBR-rkep-grp <> "" then do:
     4213           assign
     4214             cur-clmnBR-rkep-grp:column-fgcolor = 0
     4215           .
     4216         end.
     4217         assign
     4218           cur-clmn-locBR-rkep-grp = ?
     4219         .
     4220       end.
     4221     end case.
     4222       if cur-clmn-locBR-rkep-grp <> ? then do:
     4223         if can-do( this-procedure:internal-entries, 'ch-clmnBR-rkep-grp') then do:
     4224           run ch-clmnBR-rkep-grp in this-procedure (cur-clmn-locBR-rkep-grp).
     4225         end.
     4226       end.
     4227     if p-recid <> ? then do:
     4228       reposition BR-rkep-grp to recid p-recid no-error.
     4229       apply "value-changed" to BR-rkep-grp in frame Dialog-Frame.
     4230     end.
     4231     apply "entry" to BR-rkep-grp in frame Dialog-Frame.
     4232   END PROCEDURE.
     4233   procedure re-open-query-srt-clmnBR-rkep-grp:
     4234   if cur-clmnBR-rkep-grp = ? then do:
     4235      run OpenBr in this-procedure ( input yes, input no, input '':U).
     4236   end.
     4237   else do:
     4238      assign re-queryBR-rkep-grp = yes.
     4239      run sort-brBR-rkep-grp
     4240        (input (if available X_cd-grp
     4241                then recid(X_cd-grp)
     4242                else ?
     4243               )
     4244        ).
     4245      assign re-queryBR-rkep-grp = no.
     4246   end.
     4247   end.
     4248   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4249   do:
