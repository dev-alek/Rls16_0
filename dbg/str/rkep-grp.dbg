     2352         get-gparent-diff(BUFFER X_fbr-gds-grp) @ v-parent COLUMN-LABEL "Г" FORMAT "+/-"
     2353         get-gname-diff(BUFFER X_fbr-gds-grp) @ v-name COLUMN-LABEL "Н" FORMAT "+/-"
     2354         X_fbr-gds-grp.node-name FORMAT "X(30)":U
     2355         X_cd-grp.upper-grp-code COLUMN-LABEL "Код родителя" FORMAT "9999":U
     2356     ENABLE
     2357         X_cd-grp.NAME
     2358       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.25 FIT-LAST-COLUMN.
