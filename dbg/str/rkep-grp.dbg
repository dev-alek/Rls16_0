     2074   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2075   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2076   procedure fltopend_fltopend :
     2077   define input parameter p-parent-handle as handle no-undo .
     2078   define input parameter p-qh as handle no-undo .
     2079   define input parameter p-flt-open-open-query  as character no-undo .
     2080   define input parameter p-where-cond as character no-undo .
     2081   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2082   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2083   define input parameter p-indexed-reposition as character no-undo .
     2084     do
     2085     on error undo, return error
     2086     :
     2087   define variable v-prepare-string as character no-undo .
     2088   define variable glog as logical no-undo .
     2089   assign
     2090   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2091                      p-where-cond + chr(32)  +
     2092                      p-use-indFIRST-query-tail + chr(32) +
     2093                      p-use-ind-sort-clmn-by + chr(32) +
     2094                      p-indexed-reposition
     2095   .
     2096   assign
     2097   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2098   if not glog
     2099   or error-status:error then do:
     2100     message error-status:get-message(1) view-as alert-box .
     2101     undo, return error .
     2102   end.
     2103   assign
     2104   glog = p-qh:query-open no-error .
     2105   if not glog
     2106   or error-status:error then do:
     2107     message error-status:get-message(1) view-as alert-box .
     2108     undo, return error .
     2109   end.
     2110     end.
     2111   end procedure.
     2112   procedure fltopend_fltfindd :
     2113   define input parameter p-parent-handle as handle no-undo .
     2114   define input parameter p-qh as handle no-undo .
     2115   define input parameter p-rowid as rowid no-undo .
     2116   define input parameter p-next as logical no-undo .
     2117   define input parameter p-lock as integer no-undo .
     2118   define input parameter p-bh as handle no-undo .
     2119   define input parameter p-where-cond as character no-undo .
     2120   define input parameter p-use-index-phrase as character no-undo .
     2121   define variable glog as logical no-undo .
     2122   define variable v-qh as handle no-undo .
     2123   define variable v-bh as handle no-undo .
     2124   define variable v-recid as recid no-undo .
     2125   define variable v-prepare-string as character no-undo .
     2126   do
     2127   on error undo, return error
     2128   on stop undo, return error
     2129   :
     2130     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2131     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2132     create query v-qh.
     2133     v-qh:set-buffers(v-bh).
     2134     v-prepare-string = substitute("for each &1 &2 &3"
     2135                                     ,v-bh:name
     2136                                     ,p-where-cond
     2137                                     ,p-use-index-phrase).
     2138     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2139     if not glog then do:
     2140       delete object v-qh.
     2141       delete object v-bh.
     2142       undo, return error .
     2143     end.
     2144     glog = v-qh:query-open no-error .
     2145     if not glog then do:
     2146       delete object v-qh.
     2147       delete object v-bh.
     2148       undo, return error .
     2149     end.
     2150     if p-next then do:
     2151       v-qh:reposition-to-rowid(p-rowid) no-error .
     2152       glog = v-qh:get-next( p-lock) no-error .
     2153       glog = v-qh:get-next( p-lock) no-error .
     2154       if not glog or v-qh:query-off-end = yes then do:
     2155         glog = v-qh:get-first( p-lock) no-error .
     2156       end.
     2157     end.
     2158     else do:
     2159       glog = v-qh:get-first( p-lock) no-error .
     2160     end.
     2161     v-recid = v-bh:recid no-error .
     2162     delete object v-qh.
     2163     delete object v-bh.
     2164     return string(v-recid) .
     2165   end.
     2166   end procedure.
     2167   procedure fltopend_fltfindq :
     2168   define input parameter p-parent-handle as handle no-undo .
     2169   define input parameter p-qh as handle no-undo .
     2170   define input parameter p-next as logical no-undo .
     2171   define input parameter p-lock as integer no-undo .
     2172   define input parameter p-flt-open-open-query  as character no-undo .
     2173   define input parameter p-where-cond as character no-undo .
     2174   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2175   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2176   define input parameter p-indexed-reposition as character no-undo .
     2177   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2178   define variable glog as logical no-undo .
     2179   define variable v-qh as handle no-undo .
     2180   define variable v-bh as handle no-undo extent 18.
     2181   define variable v-rowid as rowid no-undo extent 18.
     2182   define variable v-ii as integer no-undo .
     2183   define variable v-prepare-string as character no-undo .
     2184   do
     2185   on error undo, return error
     2186   on stop undo, return error
     2187   :
     2188     create query v-qh.
     2189     do v-ii = 1 to p-qh:num-buffers:
     2190       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2191       assign
     2192       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2193       no-error.
     2194       v-qh:add-buffer(v-bh[v-ii]).
     2195     end.
     2196     assign
     2197     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2198                       p-where-cond + chr(32)  +
     2199                       p-use-indFIRST-query-tail + chr(32) +
     2200                       p-use-ind-sort-clmn-by + chr(32) +
     2201                       p-indexed-reposition
     2202     .
     2203     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2204     if not glog then do:
     2205       delete object v-qh.
     2206       do v-ii = 1 to p-qh:num-buffers:
     2207         delete object v-bh[v-ii].
     2208       end.
     2209       undo, return error .
     2210     end.
     2211     glog = v-qh:query-open no-error .
     2212     if not glog then do:
     2213       delete object v-qh.
     2214       do v-ii = 1 to p-qh:num-buffers:
     2215         delete object v-bh[v-ii].
     2216       end.
     2217       undo, return error .
     2218     end.
     2219     if p-next then do:
     2220       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2221       glog = v-qh:get-next( p-lock) no-error .
     2222       glog = v-qh:get-next( p-lock) no-error .
     2223       if not glog or v-qh:query-off-end = yes then do:
     2224         glog = v-qh:get-first( p-lock) no-error .
     2225       end.
     2226     end.
     2227     else do:
     2228       glog = v-qh:get-first( p-lock) no-error .
     2229     end.
     2230     do v-ii = 1 to p-qh:num-buffers:
     2231       assign
     2232       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2233       no-error.
     2234     end.
     2235     delete object v-qh.
     2236     do v-ii = 1 to p-qh:num-buffers:
     2237       delete object v-bh[v-ii].
     2238     end.
     2239   end.
     2240   end procedure.
