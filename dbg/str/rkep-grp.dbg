     2557   ON VALUE-CHANGED OF rs-mode IN FRAME Dialog-Frame
     2558   DO:
     2559     ASSIGN
     2560     rs-mode
     2561     v-mode = rs-mode
     2562     .
     2563     CASE rs-mode:
     2564         WHEN "+":U THEN DO:
     2565             ENABLE
     2566             b-chg
     2567             T-group
     2568             T-name
     2569             T-batch
     2570             WITH FRAME Dialog-Frame.
     2571         END.
     2572         OTHERWISE do:
     2573             ASSIGN
     2574             t-group = NO
     2575             t-name = NO
     2576             t-batch = NO    .
     2577             DISPLAY
     2578             t-group
     2579             t-name
     2580             t-batch
     2581             WITH FRAME Dialog-Frame.
     2582             DISABLE
     2583             T-group
     2584             T-name
     2585             t-batch
     2586             b-chg
     2587             WITH FRAME Dialog-Frame.
     2588       END.
     2589     END CASE.
     2590     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     2591     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2592   END.
     2593   ON VALUE-CHANGED OF RS-sch IN FRAME Dialog-Frame
     2594   DO:
     2595     RUN proc-rs-sch IN THIS-PROCEDURE NO-ERROR.
     2596     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2597   END.
     2598   ON CTRL-J OF sch-id IN FRAME Dialog-Frame
