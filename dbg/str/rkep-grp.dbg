     2381             FGCOLOR 4
     2382        SPACE(89.24) SKIP(18.03)
     2383       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2384            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2385            TITLE "Группы блюд на кассе R-KEEPER"
     2386            DEFAULT-BUTTON b-quit.
     2387   ASSIGN
     2388          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2389          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2390   ON GO OF FRAME Dialog-Frame
     2391   DO:
     2392     p-rid-list = v-rid-list.
     2393   END.
     2394   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2395   DO:
     2396     APPLY "END-ERROR":U TO SELF.
     2397   END.
     2398   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     2399   DO:
     2400     assign
     2401     t-name
     2402     t-group
     2403     .
     2404     if not t-name
     2405     and not t-group
     2406     then do:
     2407       message
     2408       "Не выбрана ни одна опция для синхронизации" skip
     2409       "(название, вышестоящая группа на кассе)"
     2410       view-as alert-box error .
     2411       return no-apply.
     2412     end.
     2413   run str/diallog.w (
     2414                 input parparentproc
     2415               , input THIS-PROCEDURE
     2416               , input 'str/rkepsyn2.p':U
     2417               , input (p-curr-obj-type + chr(4) +
     2418                 string(p-curr-obj-code) + chr(4) +
     2419                 (if t-batch
     2420                 then v-rid-list
     2421                 else string(recid(X_cd-grp)))
     2422                  ) + chr(4) +
     2423                 ((if t-name then "name":U else "":U) + chr(44) +
     2424                 (if t-group then "group":U else "":U)
     2425                 )
     2426               , input no
     2427               , input 'Прервать'
     2428               , input 'Синхронизация данных по группам блюд на кассе R-KEEPER и соответствующим группам блюд IBS TH')
     2429                .
     2430     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2431     HIDE mark-num in frame Dialog-Frame .
     2432     if v-rid-list <> "":U then
     2433     REPOSITION br-rkep-grp to recid integer(entry(1, v-rid-list)) No-ERROR.
     2434     APPLY "VALUE-CHANGED" to br-rkep-grp.
     2435   END.
     2436   ON CHOOSE OF B-link IN FRAME Dialog-Frame
     2437   DO:
     2438   define variable loc#log as logical no-undo.
     2439   define variable loc-doc-rec as recid no-undo .
     2440   define variable varrid-list as character no-undo .
     2441   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     2442   if not available X_cd-grp then return no-apply.
     2443   define variable v-host-code as integer   no-undo .
     2444   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2446     (input  p-curr-obj-type
     2447     ,input  p-curr-obj-code
     2448     ,output v-host-code
     2449     )  .
     2450   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2451   do:
     2452     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2453       (input  v-cntxt-db-num
     2454       ,input  v-cntxt-userid
     2455       ,input  0
     2456       ,input  'actn_cashdesk-goods-groups_update':U
     2457       ,input  'object':U
     2458       ,input  v-host-code
     2459       ,input  p-curr-obj-type
     2460       ,input  p-curr-obj-code
     2461       ,input  0
     2462       ,input  0
     2463       ,input  0
     2464       ,input  true
     2465       ,output loc#log
     2466       )  .
     2467   end.
     2468   if not loc#log then return no-apply.
     2469   loc-doc-rec = recid(X_cd-grp).
     2470   run ref/fbrggrp.w (
     2471         input parparentproc
     2472       , input p-curr-obj-type
     2473       , input p-curr-obj-code
     2474       , input "buttons-for-admin"
     2475       , input-output varrid-list
     2476   ).
     2477   find first buf_fbr-gds-grp no-lock where
     2478             buf_fbr-gds-grp.obj-type = p-curr-obj-type
     2479          AND buf_fbr-gds-grp.obj-code = p-curr-obj-code
     2480          and buf_fbr-gds-grp.out-code = X_cd-grp.grp-code no-error.
     2481   if not available buf_Fbr-gds-grp then do:
     2482     return no-apply.
     2483   end.
     2484   RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2485   reposition br-rkep-grp to recid loc-doc-rec no-error.
     2486   if error-status:error then do:                           find first pos_cd-grp no-lock where                                   recid(pos_cd-grp) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ГРУППЫ БЛЮДА" skip                            string(if avail pos_cd-grp                                    then  substitute("Идентификатор: &1, название &2"                                                     , pos_cd-grp.grp-code                                                      , pos_cd-grp.grp-name)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     2487   apply "entry" to br-rkep-grp in frame Dialog-Frame.
     2488   apply "value-changed" to br-rkep-grp in frame Dialog-Frame.
     2489   END.
     2490   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2491   DO:
     2492   define variable loc#log as logical no-undo .
     2493     if available X_cd-grp then do:
     2494   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2495   define variable v-str-recid18 as character no-undo .
     2496   define variable v-num-entry18 as integer   no-undo .
     2497   assign
     2498     v-str-recid18 = trim( string( recid( X_cd-grp ) , "->>>>>>>>>>>9":U ) )
     2499     v-num-entry18 = lookup( v-str-recid18 , v-rid-list )
     2500   .
     2501   if v-num-entry18 > 0 then do:
     2502     assign
     2503       entry( v-num-entry18, v-rid-list ) = "":U
     2504       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2505     .
     2506   end.
     2507   else do:
     2508     assign
     2509       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid18
     2510     .
     2511   end.
     2512       loc#log = br-rkep-grp:refresh() .
     2513       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2514           loc#log = br-rkep-grp:select-next-row ().
     2515           apply "VALUE-CHANGED" to br-rkep-grp in frame Dialog-Frame.
     2516       end.
     2517       if num-entries( v-rid-list ) = 0
     2518       then
     2519           hide mark-num in frame Dialog-Frame.
     2520       else
     2521           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2522     end.
     2523     apply "entry" to br-rkep-grp in frame Dialog-Frame.
     2524   END.
     2525   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2526   DO:
     2527     if not avail X_cd-grp then return no-apply.
     2528     run proc-b-print in this-procedure  no-error.
     2529     if error-status:error then do:
     2530        return no-apply.
     2531     end.
     2532     APPLY "ENTRY" to br-rkep-grp.
     2533   END.
     2534   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     2535   DO:
     2536     run proc-b-sch in this-procedure no-error.
     2537     if error-status:error then return no-apply.
     2538   END.
     2539   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     2540   DO:
