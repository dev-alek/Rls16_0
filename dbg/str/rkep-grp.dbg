      100   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   define variable v-waitfram-action01         as character   no-undo .
      102   define variable v-waitfram-action02         as character   no-undo .
      103   define variable v-waitfram-action03         as character   no-undo .
      104   define variable mWaitFramTextBeg            as character   no-undo.
      105   define variable mWaitFramTextEnd            as character   no-undo.
      106   define variable mWaitFramView               as logical     no-undo.
      107   define variable mWaitProcEvent              as logical     no-undo init yes.
      108   define variable mWaitFramInterval           as integer     no-undo init 1 .
      109   define variable mWaitFramStop               as logical     no-undo.
      110   define variable mWaitFramStopUser           as logical     no-undo.
      111   define variable mWaitFramStopTimeOut        as logical     no-undo.
      112   define variable mWaitFramStartProc          as datetime-tz no-undo.
      113   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      114   define button B-WaitFramStop auto-end-key
      115        label "Стоп"
      116        size 10 by 1 tooltip "Остоновить процесс".
      117   define button B-viewProcInfo
      118        label "Информация"
      119        size 15 by 1 tooltip "Информация о процесс".
      120   define frame waitfram
      121     v-waitfram-action01 format "x(72)" no-label skip
      122     v-waitfram-action02 format "x(72)" no-label skip
      123     v-waitfram-action03 format "x(72)" no-label skip
      124     B-viewProcInfo
      125     B-WaitFramStop at row 4 col 30
      126     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      127     .
      128   define new global shared variable mBatchMode as logical no-undo init ?.
      129   define variable mFramBachModHandle as handle no-undo.
      130   mFramBachModHandle = frame waitfram:handle.
      131   define variable mFameOldVis as logical no-undo.
      132   define variable mVisCUrentVin as logical no-undo.
      133   if session:batch-mode
      134   then
      135      mBatchMode = yes.
      136   if mBatchMode = ? then do:
      137     mVisCUrentVin = current-window:visible.
      138     mFameOldVis = mFramBachModHandle:visible.
      139     mFramBachModHandle:visible  = yes.
      140     mBatchMode = mFramBachModHandle:visible ne yes.
      141     mFramBachModHandle:visible = mFameOldVis.
      142     current-window:visible = mVisCUrentVin.
      143   end.
      144    if  log-manager:logfile-name ne ?
      145     then DO:
      146         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      147         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      148         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      149     end.
      150   on choose of B-WaitFramStop in frame waitfram
      151   do:
      152     mWaitFramStop = yes.
      153     mWaitFramStopUser = yes.
      154   end.
      155   function waitfram-check-timeout returns logical():
      156      define variable vtime as int64 no-undo.
      157      if mWaitFramStopTimeOut
      158      then
      159         return yes.
      160      vtime = ( now - mWaitFramStartProc ) / 1000 .
      161      if     mWaitFramTimeOut ne ?
      162         and mWaitFramTimeOut ne 0
      163         and mWaitFramTimeOut lt vtime
      164      then do:
      165         mWaitFramStopTimeOut = yes.
      166      end.
      167      return mWaitFramStopTimeOut.
      168   end.
      169   procedure waitfram-hide :
      170     if not session:batch-mode
      171     then do
      172     on error undo, return error return-value
      173     :
      174       pause 0 before-hide .
      175       if not mBatchMode then
      176         hide frame waitfram .
      177     if     not mWaitFramView
      178        and mWaitProcEvent
      179     then
      180       process events .
      181     end.
      182   end procedure.
      183   procedure waitfram-show :
      184     define input  parameter p-message as character no-undo .
      185     define variable v-left-margin as integer   no-undo .
      186     if not session:batch-mode
      187     then do
      188     on error undo, return error return-value
      189     :
      190       if length(p-message) <= 70 then do:
      191         assign
      192           v-left-margin = integer((70 - length(p-message)) / 2)
      193         .
      194         assign
      195           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      196         .
      197         assign
      198           v-waitfram-action01 = " "
      199           v-waitfram-action02 = " "
      200                                    + fill(" ", v-left-margin)
      201                                    + p-message
      202           v-waitfram-action03 = " "
      203         .
      204       end.
      205       else do:
      206         define variable vRindex1 as integer no-undo.
      207         define variable vRindex2 as integer no-undo.
      208         vRindex1 = r-index(p-message," ",70).
      209         if vRindex1 = 0
      210         then
      211            vRindex1 = 70.
      212         if length(p-message)  <= vRindex1 + 70 then do:
      213           assign
      214             v-waitfram-action01 = " "
      215             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      216             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      217           .
      218         end.
      219         else do:
      220           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      221           if vRindex2 <= vRindex1
      222           then
      223              vRindex2 = vRindex1 + 70.
      224           assign
      225             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      226             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      227             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      228           .
      229         end.
      230       end.
      231       B-viewProcInfo:visible   in frame waitfram = no.
      232       B-viewProcInfo:sensitive in frame waitfram = no.
      233       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      234       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      235       if  (   mWaitFramView
      236          or  mWaitProcEvent)
      237          and not mBatchMode
      238       then
      239          display
      240             v-waitfram-action01 skip
      241             v-waitfram-action02 skip
      242             v-waitfram-action03 skip
      243          with frame waitfram .
      244       if     mWaitFramView
      245          then do:
      246             if     mWaitFramInterval ne ?
      247                and not mBatchMode
      248             then
      249                wait-for go of frame waitfram pause mWaitFramInterval.
      250          end.
      251          else
      252             if     mWaitProcEvent
      253                and not mBatchMode
      254             then
      255                process events .
      256     end.
      257   end procedure.
      258      procedure waitfram-show-this:
      259         define input  parameter iInterval as int64 no-undo.
      260         define variable vtime as int64 no-undo.
      261         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      262         mWaitFramInterval = iInterval.
      263         run waitfram-show (substitute("&1&2 &3&4" ,
      264                                       mWaitFramTextBeg ,
      265                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      266                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      267                                       mWaitFramTextEnd
      268                                      )
      269                           ).
      270      end.
      271      procedure WaitFramRunPause:
      272         define input  parameter iInterval as dec no-undo.
      273         define variable vStart  as datetime-tz no-undo.
      274         define variable vend    as datetime-tz no-undo.
      275         define variable vint as int64 no-undo.
      276         define variable vOk as logical no-undo.
      277         vStart = now.
      278         vend   = vStart.
      279         publish "WaitFramPause" (iInterval,output vOk).
      280         vend   =  now.
      281         vint = vend - vStart.
      282         vint = iInterval - vint / 1000.
      283         if     not mWaitFramStop
      284            and (   vint > 0
      285                 or (    not vOk
      286                     and iInterval eq ?
      287                     )
      288                 )
      289         then
      290            run waitfram-show-this (iInterval).
      291         vend   =  now.
      292         vint = vend - vStart.
      293         vint = iInterval - vint / 1000.
      294         if     not mWaitFramStop
      295            and vint > 0
      296         then do:
      297            run gbl/pause.p (vint * 1000).
      298         end.
      299         if iInterval ne ?
      300         then
      301            publish "WaitFramStop".
      302         waitfram-check-timeout().
      303      end.
      304      procedure WaitFramWaitFor:
      305         define input  parameter iInterval as dec no-undo.
      306         assign
      307            mWaitFramStartProc   = now
      308            mWaitFramStopUser    = no
      309            mWaitFramStopTimeOut = no
      310         .
      311         block-wait:
      312         do while not mWaitFramStop:
      313            run WaitFramRunPause (iInterval).
      314            if  waitfram-check-timeout()
      315            then do:
      316               leave block-wait.
      317            end.
      318         end.
      319         run waitfram-hide.
      320      end.
      321   procedure waitfram-join :
      322     define input  parameter p-line-1  as character no-undo .
      323     define input  parameter p-line-2  as character no-undo .
      324     define input  parameter p-line-3  as character no-undo .
      325     define output parameter p-message as character no-undo .
      326     do
      327     on error undo, return error return-value
      328     :
      329       assign
      330         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      331                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      332                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      333       .
      334     end.
      335   end procedure.
      336   function waitfram-join-function returns character
      337     (input p-line-1 as character
      338     ,input p-line-2 as character
      339     ,input p-line-3 as character
      340     ).
      341     define variable v-message as character no-undo .
      342     run waitfram-join in this-procedure
      343       (input  p-line-1
      344       ,input  p-line-2
      345       ,input  p-line-3
      346       ,output v-message
      347       ) .
      348     return v-message .
      349   end function .
      350   procedure proc-alt-shift-f2:
      351     if not ibs.th.gbl.gbl-var:rcode
      352   then
      353     run gbl\inidebug.p .
      354   end.
      355   procedure proc-alt-shift-f3:
      356     run gbl/prvssinf.p
      357       ( input this-procedure
      358       ) .
      359   end.
      360   define variable v-inform-launched as logical no-undo initial false .
      361   procedure proc-alt-shift-f4:
      362     define variable v-action as character no-undo .
      363     if v-inform-launched = false then do:
      364       assign
      365         v-inform-launched = true
      366       .
      367       run gbl/d-inform.w
      368         (  input self
      369         ,  input this-procedure
      370         , output v-action
      371         ) no-error .
      372       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      373       assign
      374         v-inform-launched = false
      375       .
      376     end.
      377   end.
      378   procedure proc-alt-f1:
      379     run gbl/corrhelp.p
      380       (input this-procedure
      381       ) .
      382   end .
      383   on alt-shift-f2 anywhere do:
      384     run proc-alt-shift-f2.
      385   end.
      386   on alt-shift-f3 anywhere do:
      387     run proc-alt-shift-f3 in this-procedure .
      388   end.
      389   on alt-shift-f4 anywhere do:
      390     run proc-alt-shift-f4 in this-procedure.
      391   end.
      392   on alt-f1 anywhere do:
      393     run proc-alt-f1 in this-procedure .
      394   end.
      395   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   define variable c-point  as character no-undo .
      397   define variable tbl      as character no-undo .
      398   define variable join-tbl as character no-undo .
      399   define variable fld      as character no-undo .
      400   define variable lab      as character no-undo .
      401   define variable spr      as character no-undo .
      402   define variable dim      as character no-undo .
      403   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      404   procedure cur-time :
      405      define output parameter p-today as date      no-undo .
      406      define output parameter p-time  as integer   no-undo .
      407     do
      408     on error undo, return error
      409     :
      410       define variable v-date1 as date      no-undo .
      411       define variable v-date2 as date      no-undo .
      412       define variable v-time  as integer   no-undo .
      413       assign
      414         v-date1 = today
      415         v-time  = time
      416         v-date2 = today
      417       .
      418       if v-date1 <> v-date2
      419       then do:
      420         assign
      421           v-date1 = today
      422           v-time  = v-time
      423         .
      424       end.
      425       assign
      426         p-today = v-date1
      427         p-time  = v-time
      428       .
      429     end.
      430   end.
      431   function cur-time-date returns character
      432   :
      433     return string(today, '99/99/9999':U) .
      434   end.
      435   function cur-time-mjd returns decimal
      436   :
      437     define variable v-date as date      no-undo .
      438     define variable v-time as integer   no-undo .
      439     run cur-time in this-procedure
      440       (output v-date
      441       ,output v-time
      442       ) .
      443     return integer(v-date) - 2400002 + (v-time / 86400) .
      444   end.
      445   function cur-time-get-ending-index returns integer
      446   (input p-number as integer
      447   )
      448   :
      449     if p-number < 0
      450     or p-number = ?
      451     then do:
      452       return 1 .
      453     end.
      454     define variable v-rest as integer   no-undo .
      455     assign
      456       p-number = p-number modulo 100
      457     .
      458     if p-number < 20
      459     then do:
      460       assign
      461         v-rest = p-number
      462       .
      463     end.
      464     else do:
      465       assign
      466         v-rest = p-number modulo 10
      467       .
      468     end.
      469     case v-rest :
      470       when 1
      471       then do:
      472         return 2 .
      473       end.
      474       when 2 or
      475       when 3 or
      476       when 4
      477       then do:
      478         return 3 .
      479       end.
      480       otherwise do:
      481         return 1 .
      482       end.
      483     end case .
      484   end.
      485   procedure cur-time-mjd-to-date :
      486      define input  parameter i-mjd-diff as decimal no-undo.
      487      define output parameter o-Date     as date    no-undo.
      488      define output parameter o-Time     as integer no-undo.
      489      define variable v-day-number as integer   no-undo .
      490      if    i-mjd-diff < 0
      491         or i-mjd-diff = ?
      492      then do:
      493         return "?" .
      494      end.
      495      assign
      496         v-day-number = truncate(i-mjd-diff,0).
      497         o-Date = date(v-day-number + 2400002).
      498         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      499     .
      500   end.
      501   function cur-time-mjd-to-string returns character
      502   (input p-mjd-diff as decimal
      503   )
      504   :
      505     define variable v-day-number as integer   no-undo .
      506     define variable v-seconds    as integer   no-undo .
      507     define variable v-hour       as integer   no-undo .
      508     define variable v-min        as integer   no-undo .
      509     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      510     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      511     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      512     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      513     if p-mjd-diff < 0
      514     or p-mjd-diff = ?
      515     then do:
      516       return "?" .
      517     end.
      518     assign
      519       v-day-number = integer(truncate(p-mjd-diff,0))
      520       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      521     .
      522     if v-seconds > 86400
      523     then do:
      524       assign
      525         v-seconds = 86400 - 1
      526       .
      527     end.
      528     if v-seconds < 0
      529     then do:
      530       assign
      531         v-seconds = 0
      532       .
      533     end.
      534     assign
      535       v-hour = truncate(v-seconds / 3600, 0)
      536     .
      537     assign
      538       v-seconds = v-seconds modulo 3600
      539     .
      540     assign
      541       v-min = truncate(v-seconds / 60, 0)
      542     .
      543     assign
      544       v-seconds = v-seconds modulo 60
      545     .
      546     return
      547         (if v-day-number <> 0
      548           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      549           else ""
      550         )
      551       + (if v-day-number <> 0 or v-hour <> 0
      552           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      553           else ""
      554         )
      555       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      556           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      557           else ""
      558         )
      559       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      560       .
      561   end.
      562   function cur-time-string returns character
      563   :
      564     define variable v-date as date      no-undo .
      565     define variable v-time as integer   no-undo .
      566     run cur-time in this-procedure
      567       (output v-date
      568       ,output v-time
      569       ) .
      570     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      571   end.
      572   function cur-time-string-sec returns character
      573   :
      574     define variable v-date as date      no-undo .
      575     define variable v-time as integer   no-undo .
      576     run cur-time in this-procedure
      577       (output v-date
      578       ,output v-time
      579       ) .
      580     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      581   end.
      582   function cur-time-custom  returns character
      583   (input p-prefix as character
      584   ,input p-date-format as character
      585   ,input p-delimiter as character
      586   ,input p-time-format as character
      587   ,input p-suffix as character
      588   )
      589   :
      590     define variable v-date as date      no-undo .
      591     define variable v-time as integer   no-undo .
      592     run cur-time in this-procedure
      593       (output v-date
      594       ,output v-time
      595       ) .
      596     return
      597       p-prefix
      598       + string(v-date, p-date-format)
      599       + p-delimiter
      600       + string(v-time, p-time-format)
      601       + p-suffix
      602       .
      603   end.
      604   function cur-time-print  returns character
      605   :
      606     define variable v-date as date      no-undo .
      607     define variable v-time as integer   no-undo .
      608     run cur-time in this-procedure
      609       (output v-date
      610       ,output v-time
      611       ) .
      612     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      613   end.
      614   function cur-time-datetime returns datetime
      615   :
      616     define variable v-char as character no-undo .
      617     define variable v-datetime as datetime no-undo .
      618     v-char = cur-time-string().
      619     v-datetime = datetime(v-char).
      620     return  v-datetime.
      621   end.
      622   function cur-time-string-msec returns character
      623   :
      624     define variable v-date as datetime  no-undo .
      625     v-date = now.
      626     return string(v-date) .
      627   end.
