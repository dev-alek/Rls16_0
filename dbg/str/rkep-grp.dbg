        1   define temp-table temp-cd-grp no-undo like cd-grp
        2   field name as character
        3   field lft as integer
        4   field rgt as integer
        5   index pi is primary unique
        6   grp-code
        7   index lft
        8   lft
        9   index rgt
       10   rgt
       11   .
       12   DEFINE BUFFER find_cd-grp FOR ub.cd-grp.
