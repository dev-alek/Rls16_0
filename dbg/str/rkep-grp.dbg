     4277   MAIN-BLOCK:
     4278   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4279      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4280     v-count = 0.
     4281     i = 0.
     4282     for each cd-grp no-lock where cd-grp.obj-code = p-curr-obj-code and
     4283                                   cd-grp.obj-type = p-curr-obj-type    :
     4284       create temp-cd-grp.
     4285       buffer-copy cd-grp to temp-cd-grp
     4286       assign temp-cd-grp.lft = 0
     4287             temp-cd-grp.rgt = 0
     4288       .
     4289       if temp-cd-grp.upper-grp-code = 0 then do :
     4290         i = i + 1.
     4291         temp-cd-grp.lft = i.
     4292         i = i + 1.
     4293         temp-cd-grp.rgt = i.
     4294       end.
     4295       temp-cd-grp.name = fill("   ", temp-cd-grp.key#_one) + temp-cd-grp.grp-name.
     4296     end.
     4297     forever_ :
     4298     repeat :
     4299       v-parent-id = 0.
     4300       for each t_temp-cd-grp,
     4301           first tc_temp-cd-grp no-lock where tc_temp-cd-grp.upper-grp-code = t_temp-cd-grp.grp-code and
     4302                                              tc_temp-cd-grp.lft = 0 and
     4303                                              t_temp-cd-grp.rgt <> 0 by t_temp-cd-grp.rgt :
     4304           assign
     4305             v-parent-id = t_temp-cd-grp.grp-code
     4306             v-parent-right = t_temp-cd-grp.rgt
     4307           .
     4308       end.
     4309       if v-parent-id = 0 then leave forever_.
     4310       v-current-left = v-parent-right.
     4311       v-count = 0.
     4312       for each t_temp-cd-grp no-lock where t_temp-cd-grp.upper-grp-code = v-parent-id :
     4313         v-count = v-count + 1.
     4314       end.
     4315       v-parent-right = v-current-left + v-count * 2.
     4316       v-current-lenth = v-parent-right - v-current-left.
     4317       for each temp-cd-grp exclusive-lock   :
     4318         if temp-cd-grp.rgt >= v-current-left then assign temp-cd-grp.rgt = temp-cd-grp.rgt + v-current-lenth.
     4319       end.
     4320       for each temp-cd-grp exclusive-lock   :
     4321         if temp-cd-grp.lft > v-current-left then assign temp-cd-grp.lft = temp-cd-grp.lft + v-current-lenth.
     4322       end.
     4323       i = v-current-left - 1.
     4324       for each t_temp-cd-grp no-lock where t_temp-cd-grp.upper-grp-code = v-parent-id :
     4325         assign
     4326           i = i + 1
     4327           t_temp-cd-grp.lft = i
     4328           i = i + 1
     4329           t_temp-cd-grp.rgt = i
     4330         .
     4331       end.
     4332     end.
     4333   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4334     run mainmenu_getcntxt in parparentproc
     4335       (output v-cntxt-db-num
     4336       ,output v-cntxt-userid
     4337       ,output v-cntxt-level
     4338       ,output v-cntxt-host-code-obj
     4339       ,output v-cntxt-obj-type
     4340       ,output v-cntxt-obj-code
     4341       ,output v-cntxt-db-num-obj
     4342       ,output v-cntxt-is-admin
     4343       ) .
     4344     v-rid-list = p-rid-list.
     4345     if p-mode <> 'все':U and p-mode <> "+":U
     4346         AND p-mode <> "-":U then dO:
     4347       message
     4348       vss-workfile vss-revision vss-description skip
     4349       "Неверное значение параметров вызова p-mode"
     4350       p-mode
     4351       view-as alert-box ERROR.
     4352       return.
     4353    end.
     4354    find first X_clients no-lock where
     4355                   X_clients.obj-type = p-curr-obj-type
     4356               and X_clients.obj-code = p-curr-obj-code no-error.
     4357       if not available X_clients then do:
     4358           message
     4359           vss-workfile vss-revision vss-description skip
     4360           "Неверное значение параметра вызова p-curr-obj-type и/или p-curr-obj-code"
     4361             view-as alert-box ERROR.
     4362           return.
     4363       end.
     4364     if v-rid-list <> "" then do:
     4365         FIND FIRST find_cd-grp No-LOCK where
     4366                    recid(find_cd-grp) = integer(entry(1, v-rid-list)) No-ERROR.
     4367         if not avail find_cd-grp then do:
