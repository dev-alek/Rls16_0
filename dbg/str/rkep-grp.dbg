      873       index fn obj-type obj-code full-name
      874       index nc is unique obj-type obj-code node-code
      875       index sl obj-type obj-code sel
      876       index uc obj-type obj-code upper-code
      877   .
      878   define temp-table temp_fbrglib_found-grp no-undo
      879       field full-name   as character
      880       field sort-name   as character
      881       field node-code   as integer
      882       field level       as integer
      883       field is-terminal as logical
      884       field obj-type      as character
      885       field obj-code      as integer
      886       index pi is primary unique obj-type obj-code sort-name
      887       index fn obj-type obj-code full-name
      888       index lv obj-type obj-code level
      889       index it obj-type obj-code is-terminal
      890   .
      891   define temp-table temp_found-result-nodelist no-undo
      892       field node-code     as integer
      893       field processed     as logical
      894       field sort-name     as character
      895       field full-name     as character
      896       index pi is primary unique node-code
      897       index ps processed
      898   .
      899   procedure fbrglib-get-sort-name :
      900   do
      901   on error undo, return error
      902   :
      903   define input parameter p-obj-type   as character    no-undo.
      904   define input parameter p-obj-code   as integer      no-undo.
      905   define input parameter p-node-code  as integer      no-undo.
      906   define output parameter p-sort-name as character    no-undo.
      907       define variable v-upper-code    as integer           no-undo.
      908       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      909       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      910       find first buf_fbr-gds-grp no-lock
      911            where buf_fbr-gds-grp.obj-type  = p-obj-type
      912              and buf_fbr-gds-grp.obj-code  = p-obj-code
      913              and buf_fbr-gds-grp.node-code = p-node-code
      914       no-error.
      915       if not available buf_fbr-gds-grp
      916       then do:
      917           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      918       end.
      919       assign
      920           p-sort-name  = ""
      921           v-upper-code = 1
      922       .
      923       do while true
      924       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
      925       :
      926           assign
      927               p-sort-name  = buf_fbr-gds-grp.node-name
      928                            + (if p-sort-name <> "" then chr(2) else "")
      929                            + p-sort-name
      930               v-upper-code = buf_fbr-gds-grp.upper-code
      931           .
      932           if buf_fbr-gds-grp.upper-code = 1
      933           then do:
      934               leave.
      935           end.
      936           find first buf_fbr-gds-grp no-lock
      937                where buf_fbr-gds-grp.obj-type  = p-obj-type
      938                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      939                  and buf_fbr-gds-grp.node-code = v-upper-code
      940           no-error.
      941           if not available buf_fbr-gds-grp
      942           then do:
      943               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
      944                                   + string( v-upper-code )
      945                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      946           end.
      947       end.
      948   end.
      949   end procedure.
      950   procedure fbrglib-get-full-name :
      951   do
      952   on error undo, return error
      953   :
      954   define input parameter p-obj-type   as character    no-undo.
      955   define input parameter p-obj-code   as integer      no-undo.
      956   define input parameter p-node-code  as integer      no-undo.
      957   define output parameter p-full-name as character    no-undo.
      958       define variable v-upper-code    as integer           no-undo.
      959       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      960       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      961       if p-node-code = 1
      962       then do:
      963           assign
      964               p-full-name = ""
      965           .
      966       end.
      967       else do:
      968           find first buf_fbr-gds-grp no-lock
      969                where buf_fbr-gds-grp.obj-type  = p-obj-type
      970                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      971                  and buf_fbr-gds-grp.node-code = p-node-code
      972           no-error.
      973           if not available buf_fbr-gds-grp
      974           then do:
      975               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      976           end.
      977           assign
      978               p-full-name  = ""
      979               v-upper-code = 1
      980           .
      981           do while true
      982           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
      983           :
      984               assign
      985                   p-full-name  = buf_fbr-gds-grp.node-name
      986                               + (if p-full-name <> "" then chr(47) else "")
      987                               + p-full-name
      988                   v-upper-code = buf_fbr-gds-grp.upper-code
      989               .
      990               if buf_fbr-gds-grp.upper-code = 1
      991               then do:
      992                   leave.
      993               end.
      994               find first buf_fbr-gds-grp no-lock
      995                    where buf_fbr-gds-grp.obj-type  = p-obj-type
      996                      and buf_fbr-gds-grp.obj-code  = p-obj-code
      997                      and buf_fbr-gds-grp.node-code = v-upper-code
      998               no-error.
      999               if not available buf_fbr-gds-grp
     1000               then do:
     1001                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
     1002                                       + string( v-upper-code )
     1003                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1004               end.
     1005           end.
     1006           assign
     1007               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1008           .
     1009       end.
     1010   end.
     1011   end procedure.
     1012   procedure fbrglib-get-root-code :
     1013   do
     1014   on error undo, return error
     1015   :
     1016   define output parameter p-root-code as integer      no-undo.
     1017       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1018       find first buf_fbr-gds-grp no-lock
     1019            where buf_fbr-gds-grp.upper-code = 0
     1020       no-error .
     1021       if not available buf_fbr-gds-grp
     1022       then do:
     1023           undo, return error .
     1024       end.
     1025       else do:
     1026           assign
     1027               p-root-code = buf_fbr-gds-grp.node-code
     1028           .
     1029       end.
     1030   end.
     1031   end procedure.
     1032   procedure fbrglib-find-grp-by-full-name :
     1033   do
     1034   on error undo, return error
     1035   :
     1036   define input parameter p-obj-type     as character    no-undo.
     1037   define input parameter p-obj-code     as integer      no-undo.
     1038   define input parameter p-search-name  as character    no-undo.
     1039   define input parameter p-fill-path    as logical      no-undo.
     1040       define variable v-upper-code    as integer          no-undo.
     1041       define variable v-not-found     as logical init yes no-undo.
     1042       define variable v-counter       as integer           no-undo.
     1043       define variable v-level         as integer           no-undo.
     1044       define variable v-full-name     as character         no-undo.
     1045       define variable v-sort-name     as character         no-undo.
     1046       define variable v-node-name     as character      no-undo.
     1047       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1048       assign
     1049           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1050       .
     1051       run fbrglib-get-root-code ( output v-upper-code ) no-error .
     1052       if error-status :error
     1053       then do:
     1054           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
     1055       end.
     1056       assign
     1057           v-full-name  = ""
     1058           v-level      = num-entries( p-search-name, chr(2) )
     1059       .
     1060       for each temp_fbrglib_found-grp
     1061       :
     1062           delete temp_fbrglib_found-grp.
     1063       end.
     1064       start-name-analyze:
     1065       do v-counter = 1 to v-level
     1066       :
     1067           if v-counter < v-level
     1068           then do:
     1069               assign
     1070                   v-node-name = entry( v-counter, p-search-name, chr(2) )
     1071               .
     1072               find first buf_fbr-gds-grp no-lock
     1073                    where buf_fbr-gds-grp.obj-type   = p-obj-type
     1074                      and buf_fbr-gds-grp.obj-code   = p-obj-code
     1075                      and buf_fbr-gds-grp.upper-code = v-upper-code
     1076                      and buf_fbr-gds-grp.node-name  = v-node-name
     1077               no-error .
     1078               if not available buf_fbr-gds-grp
     1079               then do:
     1080                   assign
     1081                       v-full-name  = p-search-name
     1082                       v-sort-name  = p-search-name
     1083                   .
     1084                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
     1085               end.
     1086               else do:
     1087                   assign
     1088                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
     1089                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
     1090                       v-upper-code = buf_fbr-gds-grp.node-code
     1091                   .
     1092                   if p-fill-path = yes
     1093                   then do:
     1094                       create temp_fbrglib_found-grp.
     1095                       assign
     1096                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
     1097                           temp_fbrglib_found-grp.sort-name = v-sort-name
     1098                           temp_fbrglib_found-grp.node-code = v-upper-code
     1099                           temp_fbrglib_found-grp.level     = v-counter
     1100                           temp_fbrglib_found-grp.obj-type  = p-obj-type
     1101                           temp_fbrglib_found-grp.obj-code  = p-obj-code
     1102                       .
     1103                   end.
     1104               end.
     1105           end.
     1106           else do:
     1107               for each buf_fbr-gds-grp no-lock
     1108                  where buf_fbr-gds-grp.obj-type   = p-obj-type
     1109                    and buf_fbr-gds-grp.obj-code   = p-obj-code
     1110                    and buf_fbr-gds-grp.upper-code = v-upper-code
     1111                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1112               :
     1113                   assign
     1114                       v-not-found = no
     1115                   .
     1116                   create temp_fbrglib_found-grp.
     1117                   assign
     1118                       temp_fbrglib_found-grp.full-name = v-full-name
     1119                                                           + (if v-full-name = "" then "" else chr(47) )
     1120                                                           + buf_fbr-gds-grp.node-name + chr(47)
     1121                       temp_fbrglib_found-grp.sort-name = v-sort-name
     1122                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1123                                                           + buf_fbr-gds-grp.node-name
     1124                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
     1125                       temp_fbrglib_found-grp.level     = v-level
     1126                       temp_fbrglib_found-grp.obj-type  = p-obj-type
     1127                       temp_fbrglib_found-grp.obj-code  = p-obj-code
     1128                   .
     1129               end.
     1130               if v-not-found = yes
     1131               then do:
     1132                   assign
     1133                       v-full-name  = p-search-name
     1134                       v-sort-name  = p-search-name
     1135                   .
     1136                   for each temp_fbrglib_found-grp
     1137                   :
     1138                       delete temp_fbrglib_found-grp.
     1139                   end.
     1140                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1141               end.
     1142           end.
     1143       end.
     1144   end.
     1145   end procedure.
     1146   procedure fbrglib-find-all-subgroup :
     1147   do
     1148   on error undo, return error
     1149   :
     1150   define input parameter p-start-obj-type     as character    no-undo.
     1151   define input parameter p-start-obj-code     as integer      no-undo.
     1152   define input parameter p-start-node-code    as integer      no-undo.
     1153   define input parameter p-terminal-only      as logical      no-undo.
     1154       define variable v-start-full-name   as character     no-undo.
     1155       define variable v-start-sort-name   as character     no-undo.
     1156       define variable v-not-found         as logical       no-undo.
     1157       define variable v-is-terminal       as logical       no-undo.
     1158       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1159       create temp_found-result-nodelist.
     1160       assign
     1161           temp_found-result-nodelist.node-code = p-start-node-code
     1162           temp_found-result-nodelist.processed = no
     1163       .
     1164       run fbrglib-get-full-name in this-procedure (
     1165             input p-start-obj-type
     1166           , input p-start-obj-code
     1167           , input p-start-node-code
     1168           , output v-start-full-name
     1169       ).
     1170       run fbrglib-get-full-name in this-procedure (
     1171             input p-start-obj-type
     1172           , input p-start-obj-code
     1173           , input p-start-node-code
     1174           , output v-start-sort-name
     1175       ).
     1176       process-nodes:
     1177       do while yes
     1178       :
     1179           find first temp_found-result-nodelist
     1180                where temp_found-result-nodelist.node-code = p-start-node-code
     1181           .
     1182           assign
     1183               temp_found-result-nodelist.processed = yes
     1184           .
     1185           for each buf_fbr-gds-grp no-lock
     1186              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
     1187                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
     1188                and buf_fbr-gds-grp.upper-code = p-start-node-code
     1189           on error undo, return error
     1190           :
     1191               run fbrglib-is-terminal in this-procedure (
     1192                     input buf_fbr-gds-grp.obj-type
     1193                   , input buf_fbr-gds-grp.obj-code
     1194                   , input buf_fbr-gds-grp.node-code
     1195                   , output v-is-terminal
     1196               ).
     1197               if v-is-terminal = yes
     1198               then do:
     1199                   create temp_fbrglib_found-grp.
     1200                   assign
     1201                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1202                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1203                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1204                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1205                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     1206                       temp_fbrglib_found-grp.is-terminal = yes
     1207                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     1208                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     1209                   .
     1210               end.
     1211               else do:
     1212                   create temp_found-result-nodelist.
     1213                   assign
     1214                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
     1215                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1216                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1217                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1218                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1219                       temp_found-result-nodelist.processed = no
     1220                   .
     1221                   if p-terminal-only = no
     1222                   then do:
     1223                       create temp_fbrglib_found-grp.
     1224                       assign
     1225                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1226                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1227                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1228                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1229                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     1230                           temp_fbrglib_found-grp.is-terminal = no
     1231                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     1232                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     1233                       .
     1234                   end.
     1235               end.
     1236           end.
     1237           find first temp_found-result-nodelist
     1238                where temp_found-result-nodelist.processed = no
     1239           no-error.
     1240           if not available temp_found-result-nodelist
     1241           then do:
     1242               leave process-nodes.
     1243           end.
     1244           else do:
     1245               assign
     1246                   p-start-node-code = temp_found-result-nodelist.node-code
     1247                   v-start-full-name = temp_found-result-nodelist.full-name
     1248                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1249               .
     1250           end.
     1251       end.
     1252   end.
     1253   end procedure.
     1254   procedure fbrglib-expand-name :
     1255   do
     1256   on error undo, return error
     1257   :
     1258   define input parameter p-obj-type   as character    no-undo.
     1259   define input parameter p-obj-code   as integer      no-undo.
     1260   define input parameter p-start-name as character    no-undo.
     1261   define output parameter p-end-name  as character    no-undo.
     1262       define variable v-is-terminal     as logical           no-undo.
     1263       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
     1264       run fbrglib-find-grp-by-full-name in this-procedure (
     1265             input p-obj-type
     1266           , input p-obj-code
     1267           , input p-start-name
     1268           , input no
     1269       ) no-error.
     1270       run fbrglib-get-max-substring in this-procedure (
     1271              input p-obj-type
     1272           ,  input p-obj-code
     1273           ,  input length( p-start-name )
     1274           , output p-end-name
     1275       ) no-error .
     1276       if error-status :error
     1277       then do:
     1278           assign
     1279               p-end-name = ""
     1280           .
     1281       end.
     1282       else do:
     1283           find first temp_fbrglib_found-grp
     1284                where temp_fbrglib_found-grp.full-name = p-end-name
     1285                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     1286                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1287                        no-error.
     1288           if available temp_fbrglib_found-grp
     1289           then do:
     1290               find first buf_temp_fbrglib_found-grp
     1291                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
     1292                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
     1293                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     1294                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1295               no-error.
     1296               if not available buf_temp_fbrglib_found-grp
     1297               then do:
     1298                   run fbrglib-is-terminal in this-procedure (
     1299                         input p-obj-type
     1300                       , input p-obj-code
     1301                       , input temp_fbrglib_found-grp.node-code
     1302                       , output v-is-terminal
     1303                   ).
     1304               end.
     1305           end.
     1306       end.
     1307   end.
     1308   end procedure.
     1309   procedure fbrglib-get-max-substring :
     1310   do
     1311   on error undo, return error
     1312   :
     1313   define input parameter p-obj-type as character no-undo .
     1314   define input parameter p-obj-code as integer no-undo .
     1315   define input parameter p-min-substring-length   as integer      no-undo.
     1316   define output parameter p-substring             as character    no-undo.
     1317           define variable v-char-counter  as integer           no-undo.
     1318           define variable v-current-char  as character         no-undo.
     1319           define variable v-names-counter  as integer           no-undo.
     1320           define variable v-base-string   as character         no-undo.
     1321           assign
     1322               v-char-counter  = p-min-substring-length
     1323           .
     1324           find first temp_fbrglib_found-grp  where
     1325                      temp_fbrglib_found-grp.obj-type  = p-obj-type
     1326                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1327           no-error.
     1328           if not available temp_fbrglib_found-grp
     1329           then do:
     1330               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
     1331           end.
     1332           else do:
     1333               assign
     1334                   v-base-string = temp_fbrglib_found-grp.full-name
     1335               .
     1336               counter-block:
     1337               do while yes
     1338               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1339               :
     1340                   assign
     1341                       v-char-counter  = v-char-counter + 1
     1342                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1343                       v-names-counter = 0
     1344                   .
     1345                   compare-block:
     1346                   for each temp_fbrglib_found-grp
     1347                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
     1348                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1349                   :
     1350                       assign
     1351                           v-names-counter = v-names-counter + 1
     1352                       .
     1353                       if v-names-counter = 1
     1354                       then do:
     1355                           next compare-block.
     1356                       end.
     1357                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1358                       then do:
     1359                           leave counter-block.
     1360                       end.
     1361                   end.
     1362                   if v-names-counter = 1
     1363                   then do:
     1364                       assign
     1365                           p-substring = v-base-string
     1366                       .
     1367                       return.
     1368                   end.
     1369               end.
     1370               assign
     1371                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1372               .
     1373           end.
     1374   end.
     1375   end procedure.
     1376   procedure fbrglib-is-terminal :
     1377   do
     1378   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
     1379   :
     1380   define input parameter p-obj-type       as character    no-undo.
     1381   define input parameter p-obj-code       as integer      no-undo.
     1382   define input parameter p-node-code      as integer      no-undo.
     1383   define output parameter p-is-terminal   as logical      no-undo.
     1384       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1385       find first buf_fbr-gds-grp no-lock
     1386            where buf_fbr-gds-grp.obj-type   = p-obj-type
     1387              and buf_fbr-gds-grp.obj-code   = p-obj-code
     1388              and buf_fbr-gds-grp.upper-code = p-node-code
     1389       no-error .
     1390       if not available buf_fbr-gds-grp
     1391       then do:
     1392           assign
     1393               p-is-terminal = yes
     1394           .
     1395       end.
     1396       else do:
     1397           assign
     1398               p-is-terminal = no
     1399           .
     1400       end.
     1401   end.
     1402   end procedure.
     1403   procedure fbrglib-have-goods :
     1404   do
     1405   on error undo, return error
     1406   :
     1407   define input parameter p-obj-type           as character    no-undo.
     1408   define input parameter p-obj-code           as integer      no-undo.
     1409   define input parameter p-node-code          as integer      no-undo.
     1410   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
     1411       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
     1412       find first buf_fbr-gds-obj no-lock
     1413            where buf_fbr-gds-obj.obj-type     = p-obj-type
     1414              and buf_fbr-gds-obj.obj-code     = p-obj-code
     1415              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1416       no-error .
     1417       if available buf_fbr-gds-obj
     1418       then do:
     1419           assign
     1420               p-have-fbr-gds-obj = yes
     1421           .
     1422       end.
     1423       else do:
     1424           assign
     1425               p-have-fbr-gds-obj = no
     1426           .
     1427       end.
     1428   end.
     1429   end procedure.
     1430   procedure fbrglib-find-by-substring :
     1431   do
     1432   on error undo, return error
     1433   :
     1434   define input parameter p-start-obj-type     as character    no-undo.
     1435   define input parameter p-start-obj-code     as integer      no-undo.
     1436   define input parameter p-start-code         as integer      no-undo.
     1437   define input parameter p-full-search-string as character    no-undo.
     1438   define output parameter p-found-code        as integer      no-undo.
     1439   define output parameter p-full-name         as character    no-undo.
     1440       define variable v-start-code     as integer           no-undo.
     1441       define variable v-found          as logical  init no  no-undo.
     1442       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1443       search-grp:
     1444       for each buf_fbr-gds-grp no-lock
     1445           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     1446             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     1447             and buf_fbr-gds-grp.node-code > p-start-code
     1448       :
     1449           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     1450           then do:
     1451               assign
     1452                   p-found-code = buf_fbr-gds-grp.node-code
     1453                   v-found      = yes
     1454               .
     1455               run fbrglib-get-full-name in this-procedure (
     1456                     input p-start-obj-type
     1457                   , input p-start-obj-code
     1458                   , input p-found-code
     1459                   , output p-full-name
     1460               ) no-error .
     1461               if error-status :error
     1462               then do:
     1463                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1464               end.
     1465               leave search-grp.
     1466           end.
     1467       end.
     1468       if v-found = yes
     1469       then do:
     1470       end.
     1471       else do:
     1472           assign
     1473               p-full-name  = ""
     1474               p-found-code = 0
     1475           .
     1476       end.
     1477   end.
     1478   end procedure.
     1479   procedure fbrglib-analyze-grp-name :
     1480   do
     1481   on error undo, return error
     1482   :
     1483   define input parameter p-grp-name       as character            no-undo.
     1484   define input parameter p-obj-type       as character            no-undo.
     1485   define input parameter p-obj-code       as integer              no-undo.
     1486   define input parameter p-upper-code     as integer              no-undo.
     1487   define output parameter p-error-message as character init ""    no-undo.
     1488       define variable v-char-list     as character    no-undo.
     1489       define variable v-char-counter  as integer      no-undo.
     1490       define variable v-full-name     as character    no-undo.
     1491       if p-grp-name = "" then do:
     1492           assign
     1493               p-error-message = "Название группы не может быть пустым.".
     1494           .
     1495       end.
     1496       else do:
     1497           assign
     1498               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1499           .
     1500           do v-char-counter = 1 to num-entries( v-char-list )
     1501           :
     1502               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1503               then do:
     1504                   assign
     1505                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1506                   .
     1507                   return.
     1508               end.
     1509           end.
     1510           run fbrglib-get-full-name in this-procedure (
     1511                 input p-obj-type
     1512               , input p-obj-code
     1513               , input p-upper-code
     1514               , output v-full-name
     1515           ) no-error .
     1516           if error-status :error
     1517           then do:
     1518               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1519           end.
     1520           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1521           then do:
     1522               assign
     1523                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1524               .
     1525           end.
     1526       end.
     1527   end.
     1528   end procedure.
     1529   procedure fbrglib-delete-grp :
     1530   do
     1531   on error undo, return error
     1532   :
     1533   define input parameter p-obj-type   as character    no-undo.
     1534   define input parameter p-obj-code   as integer      no-undo.
     1535   define input parameter p-node-code  as integer      no-undo.
     1536   define output parameter p-deleted   as logical      no-undo.
     1537       define variable v-have-goods    as logical        no-undo.
     1538       define variable v-yesno         as logical        no-undo.
     1539       define variable v-upper-code    as integer        no-undo.
     1540       define variable v-root-code     as integer        no-undo.
     1541       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1542       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     1543       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     1544       run fbrglib-get-root-code in this-procedure (
     1545           output v-root-code
     1546       ) no-error.
     1547       if error-status :error
     1548       then do:
     1549           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     1550       end.
     1551       if p-node-code = v-root-code
     1552       then do:
     1553           message
     1554               "Корневую группу удалить невозможно."
     1555           view-as alert-box error.
     1556           assign
     1557               p-deleted = no
     1558           .
     1559           undo, return.
     1560       end.
     1561       find first buf_fbr-gds-grp no-lock
     1562            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1563              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1564              and buf_fbr-gds-grp.upper-code   = p-node-code
     1565       no-error.
     1566       if available buf_fbr-gds-grp
     1567       then do:
     1568           message
     1569               "Не терминальную группу удалить невозможно."
     1570           view-as alert-box error.
     1571           assign
     1572               p-deleted = no
     1573           .
     1574           undo, return.
     1575       end.
     1576       find first buf_fbr-gds-grp no-lock
     1577            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1578              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1579              and buf_fbr-gds-grp.node-code    = p-node-code
     1580       .
     1581       assign
     1582           v-upper-code = buf_fbr-gds-grp.upper-code
     1583       .
     1584       run fbrglib-have-goods in this-procedure (
     1585             input p-obj-type
     1586           , input p-obj-code
     1587           , input p-node-code
     1588           , output v-have-goods
     1589       ).
     1590       if v-have-goods = yes
     1591       then do:
     1592           find first buf_second_fbr-gds-grp no-lock
     1593                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     1594                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     1595                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     1596                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     1597           no-error.
     1598           if available buf_second_fbr-gds-grp
     1599           then do:
     1600               message
     1601                   "В группе есть товары,"
     1602                   skip "которые нельзя перенести в родительскую группу,"
     1603                   skip "потому что у родительской группы есть еще одна подгруппа."
     1604                   skip(1)
     1605                   skip "Перенесите товары в другую группу"
     1606                   skip "или удалите все остальные подгруппы родительской группы."
     1607               view-as alert-box error.
     1608               assign
     1609                   p-deleted = no
     1610               .
     1611               undo, return.
     1612           end.
     1613           message
     1614               "В группе есть товары."
     1615               skip "После удаления группы"
     1616               skip "все ее товары будут привязаны"
     1617               skip "к ее родительской группе."
     1618               skip(1)
     1619               skip "Удалить группу?"
     1620           view-as alert-box warning
     1621           buttons yes-no
     1622           title "Удаление группы"
     1623           update v-yesno
     1624           .
     1625           if v-yesno = yes
     1626           then do:
     1627               do transaction
     1628               on error undo, return error
     1629               :
     1630                   for each buf_fbr-gds-obj exclusive-lock
     1631                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     1632                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     1633                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1634                   on error undo, return error
     1635                   :
     1636                       assign
     1637                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     1638                       .
     1639                   end.
     1640               end.
     1641               do transaction
     1642               on error undo, return error
     1643               :
     1644                   find current buf_fbr-gds-grp exclusive-lock .
     1645                   delete buf_fbr-gds-grp no-error .
     1646                   if error-status:error then do:
     1647                     undo, return error return-value .
     1648                   end.
     1649               end.
     1650           end.
     1651       end.
     1652       else do:
     1653           message
     1654               "Имя группы: " buf_fbr-gds-grp.node-name
     1655               "Код группы: " buf_fbr-gds-grp.node-code
     1656               skip(1)
     1657               skip "Удалить группу?"
     1658           view-as alert-box warning
     1659           buttons yes-no
     1660           title "Удаление группы"
     1661           update v-yesno
     1662           .
     1663           if v-yesno = yes
     1664           then do:
     1665               do transaction
     1666               on error undo, return error
     1667               :
     1668                   find current buf_fbr-gds-grp exclusive-lock .
     1669                   delete buf_fbr-gds-grp no-error.
     1670                   if error-status:error then do:
     1671                     undo, return error return-value .
     1672                   end.
     1673               end.
     1674           end.
     1675       end.
     1676   end.
     1677   end procedure.
     1678   procedure fbrglib-add-grp :
     1679   do
     1680   on error undo, return error
     1681   :
     1682   define input parameter p-obj-type       as character    no-undo.
     1683   define input parameter p-obj-code       as integer      no-undo.
     1684   define input parameter p-node-code      as integer      no-undo.
     1685   define input parameter p-interface      as logical      no-undo.
     1686   define input parameter p-node-name      as character    no-undo.
     1687   define input parameter p-out-code       as integer      no-undo.
     1688   define input parameter p-global-code    as integer      no-undo.
     1689   define output parameter p-new-node-code as integer      no-undo.
     1690   define output parameter p-cancel        as logical      no-undo.
     1691       define variable v-have-goods    as logical  no-undo.
     1692       define variable v-host-code     as integer        no-undo.
     1693       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1694       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     1695       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     1696       run fbrglib-have-goods in this-procedure (
     1697             input p-obj-type
     1698           , input p-obj-code
     1699           , input p-node-code
     1700           , output v-have-goods
     1701       ) no-error .
     1702       if error-status :error
     1703       then do:
     1704           message
     1705                    vss-workfile vss-revision vss-description
     1706               skip "Ошибка определения наличия товаров в группе."
     1707               skip return-value
     1708               skip trim(error-status :get-message(1))
     1709                    trim(error-status :get-message(2))
     1710                    trim(error-status :get-message(3))
     1711           view-as alert-box error.
     1712           undo, return error .
     1713       end.
     1714   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1715   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1716     (input  p-obj-type
     1717     ,input  p-obj-code
     1718     ,output v-host-code
     1719     )  .
     1720       find first buf_fbr-gds-grp no-lock where
     1721                 buf_fbr-gds-grp.upper-code = p-node-code
     1722             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1723             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     1724             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     1725       if available buf_fbr-gds-grp then do:
     1726           if p-node-code <> 1 then do:
     1727             find first buf_fbr-gds-grp no-lock where
     1728                       buf_fbr-gds-grp.node-code = p-node-code
     1729                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1730                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     1731           end.
     1732                   message
     1733           "Для объекта" p-obj-type p-obj-code
     1734           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     1735           view-as alert-box error .
     1736           undo, return error .
     1737       end.
     1738       do transaction
     1739       on error undo, return error
     1740       :
     1741           create buf_fbr-gds-grp.
     1742           assign
     1743               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     1744               p-new-node-code             = buf_fbr-gds-grp.node-code
     1745               buf_fbr-gds-grp.upper-code  = p-node-code
     1746               buf_fbr-gds-grp.host-code   = v-host-code
     1747               buf_fbr-gds-grp.obj-type    = p-obj-type
     1748               buf_fbr-gds-grp.obj-code    = p-obj-code
     1749               buf_fbr-gds-grp.node-name    = ""
     1750               buf_fbr-gds-grp.out-code    = 0
     1751           .
     1752           if p-interface then do:
     1753             run ref/fbrggrpd.w (
     1754                   input parparentproc
     1755                 , input 'ИЗМЕНЕНИЕ':U
     1756                 , input p-obj-type
     1757                 , input p-obj-code
     1758                 , input buf_fbr-gds-grp.node-code
     1759                 , input buf_fbr-gds-grp.upper-code
     1760                 , input buf_fbr-gds-grp.node-name
     1761                 , input buf_fbr-gds-grp.out-code
     1762                 , output buf_fbr-gds-grp.node-name
     1763                 , output buf_fbr-gds-grp.out-code
     1764                 , output p-cancel
     1765             ).
     1766             if p-cancel = yes
     1767             then do:
     1768                 delete buf_fbr-gds-grp.
     1769                 undo, return.
     1770             end.
     1771           end.
     1772           else do:
     1773             find first bf_fbr-gds-grp no-lock
     1774                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     1775                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     1776                   and bf_fbr-gds-grp.out-code   = p-out-code
     1777             no-error.
     1778             assign
     1779             buf_fbr-gds-grp.node-name    = p-node-name
     1780             buf_fbr-gds-grp.global-code  = p-global-code
     1781             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     1782             .
     1783           end.
     1784           if v-have-goods = yes
     1785           then do:
     1786               for each buf_fbr-gds-obj exclusive-lock
     1787                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     1788                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     1789                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     1790               on error undo, return error
     1791               :
     1792                   assign
     1793                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     1794                   .
     1795               end.
     1796           end.
     1797       end.
     1798   end.
     1799   end procedure.
     1800   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1801   define variable varscales-pref9 as character no-undo .
     1802   define variable varpgscales-pref9 as character no-undo .
     1803   define variable varscales-pref-type9 as character no-undo.
     1804   define variable varpgscales-pref-type9 as character no-undo.
     1805   varscales-pref9  = ?.
     1806   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1807     (input  'sclspref':u
     1808     ,input  '':u
     1809     ,input  '':u
     1810     ,input  0
     1811     ,input  '':u
     1812     ,input  '':u
     1813     ,input  '':u
     1814     ,input  no
     1815     ,output varscales-pref9
     1816     ,output varscales-pref-type9
     1817     ) no-error .
     1818     if varscales-pref9 = ? then do:
     1819       assign
     1820         varscales-pref9 = '21,23,25':U.
     1821     end.
     1822   varpgscales-pref9  = ?.
     1823   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1824     (input  'scpgpref':u
     1825     ,input  '':u
     1826     ,input  '':u
     1827     ,input  0
     1828     ,input  '':u
     1829     ,input  '':u
     1830     ,input  '':u
     1831     ,input  no
     1832     ,output varpgscales-pref9
     1833     ,output varpgscales-pref-type9
     1834     ) no-error .
     1835     if varpgscales-pref9 = ? then do:
     1836       assign
     1837         varpgscales-pref9 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     1838     end.
     1839   function get-rkgTH-price returns decimal(input p-obj-type as character
     1840                                          , input p-obj-code as integer
     1841                                          , input p-b-code as integer
     1842                                          , output p-doc-num as character):
     1843   define variable v-price-sale as decimal   no-undo init ?.
     1844   define variable v-road-tax   as decimal   no-undo .
     1845   define variable v-excise     as decimal   no-undo .
     1846   define variable v-vat-pc     as decimal   no-undo .
     1847   define variable v-slt-pc     as decimal   no-undo .
     1848   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1849   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     1850     (input  p-obj-type
     1851     ,input  p-obj-code
     1852     ,input  p-b-code
     1853     ,input  0
     1854     ,input  0
     1855     ,output p-doc-num
     1856     ,output v-price-sale
     1857     ,output v-road-tax
     1858     ,output v-excise
     1859     ,output v-vat-pc
     1860     ,output v-slt-pc
     1861     ) no-error .
     1862   if not error-status:error then return v-price-sale.
     1863   END FUNCTION.
     1864   function get-rkgTH-name returns character(input p-obj-type as character
     1865                                             ,input p-obj-code as integer
     1866                                             ,input p-b-code as integer
     1867                                             , buffer buf_goods for ub.goods):
     1868   define variable v-gds-name as character no-undo .
     1869   define VARIABLE varresult   as character                no-undo.
     1870   define VARIABLE vartype-bc  as character                no-undo.
     1871   define VARIABLE varweight   as decimal                  no-undo.
     1872   DEFINE VARIABLE v-unit-cli AS CHARACTER NO-UNDO.
     1873   DEFINE VARIABLE v-f-name AS CHARACTER NO-UNDO.
     1874   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
     1875   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     1876   DEFINE BUFFER buf_place FOR ub.place.
     1877   DEFINE BUFFER buf_gds-prt FOR ub.gds-prt.
     1878   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1879   (
     1880    input  parparentproc
     1881   ,input  STRING(p-b-code)
     1882   ,input  0
     1883   ,input  p-obj-type
     1884   ,input  p-obj-code
     1885   ,input  NO
     1886   ,input  YES
     1887   ,input  varscales-pref9
     1888   ,input  varpgscales-pref9
     1889   ,output varresult
     1890   ,output vartype-bc
     1891   ,output varweight
     1892   ,buffer buf_bar-code
     1893   ,buffer buf_prod-bc
     1894   ,buffer buf_place
     1895   ) no-error.
     1896   if not available buf_bar-code then
     1897   return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
     1898   FIND FIRST buf_goods NO-LOCK WHERE
     1899             buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
     1900   IF NOT AVAILABLE buf_goods THEN DO:
     1901     return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
     1902   END.
     1903   else do:
     1904     assign
     1905     v-gds-name = buf_goods.chk-name
     1906     .
     1907   end.
     1908   IF buf_bar-code.unit-cli <> buf_goods.unit-base THEN DO:
     1909     ASSIGN
     1910     v-unit-cli = "*" + string(buf_bar-code.cli-base-rate).
     1911   END.
     1912   FIND FIRST buf_gds-prt NO-LOCK WHERE
     1913             buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     1914   if buf_gds-prt.node-name <>  '_Пустая шкала':U THEN DO:
     1915       FIND FIRST buf_gds-prt NO-LOCK WHERE
     1916                 buf_gds-prt.node-code = buf_bar-code.node-code NO-ERROR.
     1917   END.
     1918   ASSIGN
     1919   v-f-name = (IF AVAILABLE buf_gds-prt THEN buf_gds-prt.f-name ELSE "":U).
     1920   ASSIGN
     1921   v-gds-name = v-gds-name + chr(32) + v-f-name + v-unit-cli.
     1922   return v-gds-name.
     1923   END FUNCTION.
     1924   function get-rkgTH-group returns integer(input p-obj-type as character
     1925                                           , input p-obj-code  as integer
     1926                                           , input p-gds-code as integer
     1927                                           , output p-grp-name as character
     1928                                           ):
     1929   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
     1930   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1931   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
     1932           buf_fbr-gds-obj.obj-type = p-obj-type
     1933       AND buf_fbr-gds-obj.obj-code = p-obj-code
     1934       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
     1935   IF AVAILABLE buf_fbr-gds-obj THEN DO:
     1936     RUN fbrglib-get-full-name IN THIS-PROCEDURE(
     1937                                                 input p-obj-type
     1938                                                 ,INPUT p-obj-code
     1939                                                 ,INPUT buf_fbr-gds-obj.fbr-grp-code
     1940                                                 ,OUTPUT p-grp-name) NO-ERROR.
     1941     return buf_fbr-gds-obj.fbr-grp-code.
     1942   END.
     1943   return ?.
     1944   END FUNCTION.
     1945   function get-rkgTH-modificator returns logical(input p-obj-type as character
     1946                                           , input p-obj-code  as integer
     1947                                           , input p-gds-code as integer
     1948                                           , output p-is-null-price as logical
     1949                                           ):
     1950   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
     1951   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
     1952           buf_fbr-gds-obj.obj-type = p-obj-type
     1953       AND buf_fbr-gds-obj.obj-code = p-obj-code
     1954       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
     1955   IF AVAILABLE buf_fbr-gds-obj THEN DO:
     1956     assign
     1957     p-is-null-price = buf_fbr-gds-obj.is-null-price
     1958     .
     1959     return buf_fbr-gds-obj.is-modificator.
     1960   END.
     1961   assign
     1962   p-is-null-price = no.
     1963   return no.
     1964   END FUNCTION.
     1965   function get-rkgTH-group-name returns character(input p-obj-type as character
     1966                                                 , input p-obj-code  as integer
     1967                                                 , input p-out-code as integer):
     1968   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1969   find first buf_fbr-gds-grp no-lock where
     1970             buf_fbr-gds-grp.obj-type = p-obj-type
     1971         AND buf_fbr-gds-grp.obj-code = p-obj-code
     1972         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     1973   if not available buf_fbr-gds-grp then return ?.
     1974   return buf_fbr-gds-grp.node-name.
     1975   END FUNCTION.
     1976   function get-rkgTH-parent returns integer(input p-obj-type as character
     1977                                             , input p-obj-code  as integer
     1978                                             , input p-out-code as integer):
     1979   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1980   DEFINE BUFFER upper_fbr-gds-grp FOR ub.fbr-gds-grp.
     1981   find first buf_fbr-gds-grp no-lock where
     1982             buf_fbr-gds-grp.obj-type = p-obj-type
     1983         AND buf_fbr-gds-grp.obj-code = p-obj-code
     1984         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     1985   if not available buf_fbr-gds-grp then return ?.
     1986   find first upper_fbr-gds-grp no-lock where
     1987             upper_fbr-gds-grp.obj-type = p-obj-type
     1988         AND upper_fbr-gds-grp.obj-code = p-obj-code
     1989         and upper_fbr-gds-grp.out-code = buf_fbr-gds-grp.upper-code no-error .
     1990   if not available upper_fbr-gds-grp then return ?.
     1991   return upper_fbr-gds-grp.out-code.
     1992   END FUNCTION.
     1993   procedure get-rkep-full-grp-name :
     1994   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1995   DEFINE INPUT PARAMETER p-grp-code LIKE ub.cd-grp.grp-code NO-UNDO.
     1996   define output parameter p-full-name as character    no-undo.
     1997   define variable v-upper-code    as integer  no-undo.
     1998   define buffer buf_cd-grp       for ub.cd-grp.
     1999   define buffer buf_upper_cd-grp for ub.cd-grp.
     2000   do
     2001   on error undo, return error
     2002   :
     2003       if P-grp-code = 0
     2004       then do:
     2005           assign
     2006               p-full-name = ""
     2007           .
     2008       end.
     2009       else do:
     2010           find first buf_cd-grp no-lock where
     2011                  buf_cd-grp.obj-type = 'маг':U
     2012              and buf_cd-grp.obj-code = p-obj-code
     2013              and buf_cd-grp.pos-type = 'r-keeper':U
     2014              and buf_cd-grp.grp-type = '':U
     2015              and buf_cd-grp.grp-code = p-grp-code
     2016           no-error.
     2017           if not available buf_cd-grp
     2018           then do:
     2019               undo, return error substitute("get-rkep-grp-name: Не найдена группа меню на кассе R-KEEPER с кодом &1", p-grp-code).
     2020           end.
     2021           assign
     2022               p-full-name  = ""
     2023               v-upper-code = 0
     2024           .
     2025           do while true
     2026           on error undo, return error "get-rkep-grp-name: Ошибка составления полного имени группы"
     2027           :
     2028               assign
     2029               p-full-name  = buf_cd-grp.grp-name
     2030                           + (if p-full-name <> "" then chr(47) else "")
     2031                           + p-full-name
     2032               v-upper-code = buf_cd-grp.upper-grp-code
     2033               .
     2034               if buf_cd-grp.grp-code = 0
     2035               then do:
     2036                   leave.
     2037               end.
     2038               find first buf_cd-grp no-lock where
     2039                         buf_cd-grp.obj-type = 'маг':U
     2040                     and buf_cd-grp.obj-code = p-obj-code
     2041                     and buf_cd-grp.pos-type = 'r-keeper':U
     2042                     and buf_cd-grp.grp-type = '':U
     2043                     and buf_cd-grp.grp-code = v-upper-code no-error.
     2044               if not available buf_cd-grp
     2045               then do:
     2046                   undo, return error "get-rkep-grp-name: Не найдена группа товаров с кодом "
     2047                                       + string( v-upper-code )
     2048                                       + ". Ошибка ссылки в дереве товаров для узла p-id".
     2049               end.
     2050           end.
     2051           assign
     2052               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2053           .
     2054       end.
     2055   end.
     2056   end procedure.
     2057   function get-price-id-from-int returns character ( input p-file-num as integer):
     2058     return ('price-list':U + chr(32) +  string(p-file-num)).
     2059   end function.
     2060   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2061     define variable v-cntxt-db-num        as integer   no-undo .
