     2611     if error-status:error then return no-apply.
     2612   END.
     2613   ON RETURN OF sch-name IN FRAME Dialog-Frame
     2614   DO:
     2615     run proc-find-name in this-procedure(no, input frame Dialog-Frame sch-name) no-error.
     2616     if error-status:error then return no-apply.
     2617   END.
     2618   ON VALUE-CHANGED OF T-batch IN FRAME Dialog-Frame
     2619   DO:
     2620   define variable GLOG as logical no-undo .
     2621     assign
     2622     t-batch.
     2623     run proc-buttons in this-procedure(t-batch).
     2624     if t-batch = no
     2625     and b-mark:sensitive = no then do:
     2626       assign
