     2342        SIZE 11 BY 1 NO-UNDO.
     2343   DEFINE QUERY BR-rkep-grp FOR
     2344         X_cd-grp,
     2345         X_fbr-gds-grp,
     2346         X_upper-fbr-gds-grp SCROLLING.
     2347   DEFINE BROWSE BR-rkep-grp
