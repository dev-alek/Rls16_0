     2310         VIEW-AS TEXT
     2311        SIZE 68.5 BY .67
     2312        FGCOLOR 4  NO-UNDO.
     2313   DEFINE VARIABLE v-rkep-grp-name AS CHARACTER FORMAT "X(256)":U
