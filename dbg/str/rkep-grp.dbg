     2070   FUNCTION mark-string RETURNS CHARACTER
     2071     ( input p-recid as recid, input mark-list as character  ) :
     2072     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
