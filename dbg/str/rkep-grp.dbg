     5049         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     5050                             ,input QUERY br-rkep-grp:handle
     5051                             ,input parameter-3-39
     5052                             ,input parameter-4-39
     5053                             ,input parameter-5-39
     5054                             ,input parameter-6-39
     5055                             ,input parameter-7-39
     5056                             )
     5057         .
     5058         assign
     5059           l-filter-open-39 = true
     5060         .
     5061       end.
     5062       if l-filter-open-39 = false then do:
     5063         message
     5064           "Ошибка при фильтрации / сортировке" skip
     5065           "Будут показаны записи без учета фильтра" skip
     5066           view-as alert-box .
     5067       end.
     5068       else do:
     5069           assign
     5070             l-query-was-opened = true
     5071           .
     5072       end.
     5073     end.
     5074     if l-filter-open-39 = false then do:
     5075       OPEN QUERY br-rkep-grp FOR EACH X_cd-grp
     5076         where  X_cd-grp.obj-type = p-curr-obj-type and X_cd-grp.obj-code = p-curr-obj-code and                         X_cd-grp.pos-type = 'r-keeper':U and X_cd-grp.grp-type = '':U
     5077       , FIRST X_fbr-gds-grp NO-LOCK WHERE X_fbr-gds-grp.obj-type = X_cd-grp.obj-type                                   AND X_fbr-gds-grp.obj-code = X_cd-grp.obj-code                                   AND X_fbr-gds-grp.out-CODE = X_cd-grp.grp-code                                   and (not t-name or X_cd-grp.grp-name <> X_fbr-gds-grp.node-name)                                   , first X_upper-fbr-gds-grp where (not t-group or                                     (X_upper-fbr-gds-grp.node-code = X_fbr-gds-grp.node-code                                        and not (                                               (X_upper-fbr-gds-grp.out-code = X_cd-grp.grp-code)                                               AnD                                               (X_upper-fbr-gds-grp.lvl-num = X_cd-grp.key#_one)                                               )                                       )                                                                     )
     5078         indexed-reposition
     5079     .
     5080         assign
     5081           l-query-was-opened = true
     5082         .
     5083     end.
     5084   end.
     5085   else do:
     5086     assign
     5087       v-doc-rec = recid( X_cd-grp )
     5088     .
     5089     do
     5090     on stop undo, leave
     5091     on error undo, leave
     5092     :
     5093       if QUERY br-rkep-grp:handle:get-buffer-handle(1) = (buffer X_cd-grp:handle) then do:
     5094         assign
     5095         parameter-2-39 = (if p-find-next then "true":u else "false":u )
     5096         parameter-4-39 =
     5097           "where ":u +  substitute('X_cd-grp.obj-type = &1&2&1 and X_cd-grp.obj-code = &3 and                         X_cd-grp.pos-type = &1&4&1 and X_cd-grp.grp-type = &1&1', chr(34), p-curr-obj-type, p-curr-obj-code, 'r-keeper':U) + " ":u + where-phrase-39 + " ":u + p-find-condition + " " + ""
     5098         parameter-5-39 = "  "
     5099       .
     5100         run fltopend_fltfindd in this-procedure  (
     5101                             input this-procedure:handle
     5102                             ,input QUERY br-rkep-grp:handle
     5103                             ,input rowid(X_cd-grp)
     5104                             ,input logical(parameter-2-39)
     5105                             ,input no-lock
     5106                             ,input (buffer X_cd-grp:handle)
     5107                             ,input parameter-4-39
     5108                             ,input parameter-5-39
     5109                             ) no-error.
     5110         .
     5111         assign
     5112           v-doc-rec = integer(return-value)
     5113           v-fltopend-rowid[1] = ?
     5114         .
     5115       end.
     5116       else do:
     5117         assign
     5118         parameter-2-39 = (if p-find-next then "true":u else "false":u )
     5119         parameter-3-39 =  "FOR EACH X_cd-grp"
     5120         parameter-4-39 =
     5121           (
     5122             if (" X_cd-grp.obj-type = p-curr-obj-type and X_cd-grp.obj-code = p-curr-obj-code and                         X_cd-grp.pos-type = 'r-keeper':U and X_cd-grp.grp-type = '':U " + " " + where-phrase-39) <> ""
     5123             then  substitute('X_cd-grp.obj-type = &1&2&1 and X_cd-grp.obj-code = &3 and                         X_cd-grp.pos-type = &1&4&1 and X_cd-grp.grp-type = &1&1', chr(34), p-curr-obj-type, p-curr-obj-code, 'r-keeper':U) + " " + where-phrase-39
     5124             else "true"
     5125           )
     5126         parameter-5-39 = (" " + "" + " " + ", FIRST X_fbr-gds-grp NO-LOCK WHERE X_fbr-gds-grp.obj-type = X_cd-grp.obj-type                                   AND X_fbr-gds-grp.obj-code = X_cd-grp.obj-code                                   AND X_fbr-gds-grp.out-CODE = X_cd-grp.grp-code                                   and (not t-name or X_cd-grp.grp-name <> X_fbr-gds-grp.node-name)                                   , first X_upper-fbr-gds-grp where (not t-group or                                     (X_upper-fbr-gds-grp.node-code = X_fbr-gds-grp.node-code                                        and not (                                               (X_upper-fbr-gds-grp.out-code = X_cd-grp.grp-code)                                               AnD                                               (X_upper-fbr-gds-grp.lvl-num = X_cd-grp.key#_one)                                               )                                       )                                                                     )" + " " + p-find-condition)
     5127         parameter-6-39 = if sort-phrase-39 = ''
     5128                              then
     5129           (
     5130           " " + "  " +
     5131             " " + sort-column-phrase +
     5132           " " + "  "
     5133           )
     5134                              else
     5135           (
     5136           " " + "  " +
     5137             " " + sort-column-phrase +
     5138           " " + sort-phrase-39
     5139           )
     5140         parameter-7-39 =
     5141           " indexed-reposition  "
     5142       .
     5143         run fltopend_fltfindq in this-procedure  (
     5144                             input this-procedure:handle
     5145                             ,input QUERY br-rkep-grp:handle
     5146                             ,input logical(parameter-2-39)
     5147                             ,input no-lock
     5148                             ,input parameter-3-39
     5149                             ,input parameter-4-39
     5150                             ,input parameter-5-39
     5151                             ,input parameter-6-39
     5152                             ,input parameter-7-39
     5153                             ,output v-fltopend-rowid
     5154                             ) no-error.
     5155         .
     5156         v-doc-rec = ?.
     5157       end.
     5158       assign
     5159         l-query-was-opened = true
     5160       .
     5161     end.
     5162   end.
     5163     run waitfram-hide in this-procedure .
     5164      END.
     5165   END CASE.
     5166   if not p-open-query and v-doc-rec <> ? then
     5167   REPOSITION br-rkep-grp to recid v-doc-rec No-ERROR.
     5168   if not p-open-query and v-fltopend-rowid[1] <> ? then
     5169   query br-rkep-grp:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     5170   run waitfram-hide in this-procedure .
     5171   APPLY "VALUE-CHANGED" TO br-rkep-grp in frame Dialog-Frame.
     5172   APPLY "ENTRY" TO br-rkep-grp.
     5173   END PROCEDURE.
     5174   PROCEDURE proc-b-print :
     5175   define variable v-doc-rec as recid no-undo .
     5176   define variable accum-count as integer.
     5177   define variable date_string     as      CHARACTER    no-undo.
     5178   define variable Line            as      CHARACTER    no-undo.
     5179   define variable v-group-name    as      CHARACTER    no-undo.
     5180   DEFINE variable v-loc-grp-name  as      CHARACTER    no-undo.
     5181   DEFINE variable v-loc-rkep-grp-name  as      CHARACTER    no-undo.
     5182   DEFINE variable v-loc-id               as CHARACTER    no-undo.
     5183   define variable for-time        as      CHARACTER    no-undo.
     5184   DEFINE VARIABLE v-loc-name AS LOGICAL NO-UNDO.
     5185   DEFINE VARIABLE v-loc-parent AS LOGICAL NO-UNDO.
     5186   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     5187   DEFINE FRAME cd-grp-list
     5188   X_cd-grp.grp-code COLUMN-LABEL "Код группы" FORMAT "9999":U
     5189   X_cd-grp.grp-name COLUMN-LABEL "Название группы на кассе R-KEEPER/!       в IBS TH" FORMAT "X(27)":U
     5190   v-loc-parent COLUMN-LABEL "Г" FORMAT "+/-"
     5191   v-loc-name COLUMN-LABEL "Н" FORMAT "+/-"
     5192   v-group-name COLUMN-LABEL "Полн. Название группы на кассе R-KEEPER/!       в IBS TH" FORMAT "X(80)":U
     5193   HEADER  date_string AT 5 format "X(35)"
     5194    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5195   Line format "X(195)" AT 1
     5196   with width 232 down stream-io use-text    .
     5197   Line = fill("-", 195).
     5198   date_string = cur-time-print() .
     5199   run prn-lib-open-stream  in this-procedure (
     5200                                                input parParentProc
     5201                                               ,input 43
     5202                                               ,input yes
     5203                                               ,input no
     5204                                               ).
     5205   PUT  STREAM PrnLibStream
     5206   SPACE(25) ( frame Dialog-Frame:title )
     5207   format "x(90)" SKIP(1) .
     5208   FORM HEADER
     5209   Line format "X(195)" AT 1 SKIP
     5210   "Продолжение - на следующей странице" AT 30 SKIP
     5211   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5212   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5213   FORM with FRAME cd-grp-list  .
     5214   run waitfram-show in this-procedure ( input "Ждите...").
     5215   v-doc-rec = recid(X_cd-grp).
     5216   DO WHILE available X_cd-grp:
     5217     GET prev br-rkep-grp.
     5218   END.
     5219   GET next br-rkep-grp.
     5220   DO WHILE available X_cd-grp:
     5221   ASSIGN
     5222   v-loc-grp-name = "":U
     5223   v-loc-rkep-grp-name = "":U
     5224   .
     5225   run get-rkep-full-grp-name(
     5226                               input p-curr-obj-code
     5227                              ,INPUT X_cd-grp.grp-code
     5228                              ,OUTPUT v-loc-rkep-grp-name) NO-ERROR.
     5229     Display STREAM PrnLibStream
     5230     X_cd-grp.grp-code
     5231     X_cd-grp.grp-name
     5232     v-loc-rkep-grp-name @ v-group-name
     5233     get-gname-diff(buffer X_fbr-gds-grp) @ v-loc-name
     5234     get-gparent-diff(buffer X_fbr-gds-grp) @ v-loc-parent
     5235     with FRAME cd-grp-list .
     5236     DOWN STREAM PrnLibStream 1
     5237     with FRAME cd-grp-list  .
     5238     IF AVAILABLE X_fbr-gds-grp THEN DO:
     5239         RUN proc-value-changed IN THIS-PROCEDURE(
     5240                                          OUTPUT v-loc-grp-name
     5241                                        , output v-loc-rkep-grp-name
     5242                                                               ) NO-ERROR.
     5243       Display STREAM PrnLibStream
     5244       X_fbr-gds-grp.node-name @ X_cd-grp.grp-name
     5245       v-loc-grp-name @ v-group-name
     5246       with FRAME cd-grp-list .
     5247       DOWN STREAM PrnLibStream 1
     5248       with FRAME cd-grp-list  .
     5249     END.
     5250     ELSE DO:
     5251       DOWN STREAM PrnLibStream 1
     5252       with FRAME cd-grp-list .
     5253     END.
     5254     assign
     5255     accum-count = accum-count + 1
     5256     .
     5257     GET next br-rkep-grp.
     5258   END.
     5259   UNDERLINE  STREAM PrnLibStream
     5260   X_cd-grp.grp-code
     5261   X_cd-grp.grp-name
     5262   v-group-name
     5263   with FRAME cd-grp-list .
     5264   DISPLAY STREAM PrnLibStream
     5265   "ИТОГО" @ X_cd-grp.grp-code
     5266   accum-count @ X_cd-grp.grp-NAME
     5267   with frame cd-grp-list.
     5268   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5269   HIDE  STREAM PrnLibStream FRAME cd-grp-List.
     5270   output  STREAM PrnLibStream CLOSE.
     5271   REPOSITION br-rkep-grp to recid v-doc-rec no-error.
     5272   APPLY "entry" to br-rkep-grp.
     5273   run waitfram-hide in this-procedure .
     5274   run prn-lib-prn-file in this-procedure (
     5275                                             input parParentProc
     5276                                             ,input 8
     5277                                             ).
     5278   END PROCEDURE.
     5279   PROCEDURE proc-b-sch :
     5280   assign
     5281     tbl = 'cd-grp'
     5282     join-tbl = 'X_cd-grp'
     5283     fld = ""
     5284     lab = ""
     5285     spr = ""
     5286     dim = '0'
     5287     .
     5288   run fltfield-add in this-procedure('grp-name', 'Название', '',
     5289   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5290   run fltfield-add in this-procedure('upper-grp-code', 'Код группы-родителя', '',
     5291   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5292   Filter-Block:
     5293   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5294       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5295       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5296     run gbl/filter.w ( INPUT parparentproc
     5297                       , INPUT (filter-point + chr(4) +
     5298                           filter-label + chr(4) +
     5299                           string(yes))
     5300                       , INPUT tbl
     5301                       , INPUT join-tbl
     5302                       , INPUT fld
     5303                       , INPUT lab
     5304                       , INPUT spr
     5305                       , INPUT dim ).
     5306     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5307   END.
     5308   END PROCEDURE.
     5309   PROCEDURE proc-buttons :
     5310   define input parameter p-is-batch as logical no-undo.
     5311   CASE p-is-batch:
     5312       when yes then do:
     5313           ENABLE
     5314           B-mark
     5315           with frame Dialog-Frame.
     5316           disable
     5317           b-link
     5318           with frame Dialog-Frame.
     5319       end.
     5320       when no then do:
     5321           ENABLE
     5322           B-mark when lookup("b-mark":U, bttns) > 0
     5323           B-link
     5324           with frame Dialog-Frame.
     5325           DISABLE
     5326           b-mark when lookup("b-mark":U, bttns) = 0
     5327           with frame Dialog-Frame.
     5328       end.
     5329   END CASE.
     5330   END PROCEDURE.
     5331   PROCEDURE proc-find-id :
     5332   define input parameter p-next as logical no-undo.
     5333   define input parameter p-id AS integer no-undo.
     5334   run OpenBr in this-procedure
     5335       (input false
     5336       ,input p-next
     5337       ,input substitute("and X_cd-grp.grp-code = &1 "
     5338         , p-id)
     5339       ).
     5340   apply "entry":u to sch-id in frame Dialog-Frame .
     5341   END PROCEDURE.
     5342   PROCEDURE proc-find-name :
     5343   define input parameter p-next as logical no-undo.
     5344   define input parameter p-name like ub.cd-grp.grp-name no-undo.
     5345   assign
     5346   p-name = replace(p-name, chr(34), "":U)
     5347   p-name = replace(p-name, chr(39), chr(39) + chr(39))
     5348   p-name = chr(34) + p-name + chr(34).
     5349   run OpenBr in this-procedure
     5350       (input false
     5351       ,input p-next
     5352       ,input substitute("and X_cd-grp.grp-name begins &1 "
     5353         , p-name)
     5354       ).
     5355   apply "entry":u to sch-name in frame Dialog-Frame .
     5356   END PROCEDURE.
     5357   PROCEDURE proc-rs-sch :
     5358   case input frame Dialog-Frame rs-sch :
     5359       when "id" then do:
     5360         enable
     5361         sch-id
     5362         with frame Dialog-Frame.
     5363         display
     5364         sch-id
     5365         with frame Dialog-Frame.
     5366         hide
     5367         sch-name
     5368         in frame Dialog-Frame.
     5369         apply "entry" to sch-id in frame Dialog-Frame.
     5370       end.
     5371       when "name" then do:
     5372         enable
     5373         sch-name
     5374         with frame Dialog-Frame.
     5375         display
     5376         sch-name
     5377         with frame Dialog-Frame.
     5378         hide
     5379         sch-id
     5380         in frame Dialog-Frame.
     5381         apply "entry" to sch-name in frame Dialog-Frame.
     5382       end.
     5383     end.
     5384   END PROCEDURE.
     5385   PROCEDURE proc-value-changed :
     5386   DEFINE OUTPUT PARAMETER p-grp-name AS CHARACTER NO-UNDO.
     5387   DEFINE OUTPUT PARAMETER p-rkep-grp-name AS CHARACTER NO-UNDO.
     5388   define variable v-grp-code as integer no-undo .
     5389   IF NOT AVAILABLE X_cd-grp THEN DO:
     5390     ASSIGN
     5391     p-grp-name = "":U
     5392     p-rkep-grp-name = "":u
     5393     .
     5394     RETURN.
     5395   END.
     5396   run get-rkep-full-grp-name(
     5397                               input p-curr-obj-code
     5398                              ,INPUT X_cd-grp.grp-code
     5399                              ,OUTPUT p-rkep-grp-name) NO-ERROR.
     5400   IF AVAILABLE X_fbr-gds-grp THEN DO:
     5401     RUN fbrglib-get-full-name IN THIS-PROCEDURE(
     5402                                                 input p-curr-obj-type
     5403                                                 ,INPUT p-curr-obj-code
     5404                                                 ,INPUT X_fbr-gds-grp.node-code
     5405                                                 ,OUTPUT p-grp-name) NO-ERROR.
     5406   END.
     5407   END PROCEDURE.
     5408   FUNCTION fget-rkep-full-grp-name RETURNS CHARACTER
     5409     ( BUFFER loc-cd-grp FOR ub.cd-grp) :
     5410   DEFINE VARIABLE v-fgrp-name AS CHARACTER NO-UNDO.
     5411   RUN get-rkep-full-grp-name IN THIS-PROCEDURE
     5412       (
     5413           input p-curr-obj-code
     5414           ,INPUT loc-cd-grp.grp-code
     5415           ,OUTPUT v-fgrp-name
     5416        )
     5417       NO-ERROR.
     5418   IF ERROR-STATUS:ERROR THEN RETURN "!!!Ошибка".
     5419   RETURN v-fgrp-name.
     5420   END FUNCTION.
     5421   FUNCTION get-gname-diff RETURNS LOGICAL
     5422     ( BUFFER loc-fbr-gds-grp FOR ub.fbr-gds-grp ) :
     5423     IF AVAILABLE loc-fbr-gds-grp THEN
     5424    RETURN (loc-fbr-gds-grp.node-name <> X_cd-grp.grp-name).
     5425    RETURN NO.
     5426   END FUNCTION.
     5427   FUNCTION get-gparent-diff RETURNS LOGICAL
     5428     ( BUFFER loc-fbr-gds-grp FOR ub.fbr-gds-grp ) :
     5429   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     5430   IF AVAILABLE loc-fbr-gds-grp  THEN DO:
     5431     RETURN not ((loc-fbr-gds-grp.out-code = X_cd-grp.grp-code)
     5432                 and
     5433                 (loc-fbr-gds-grp.lvl-num = X_cd-grp.key#_one)).
     5434   END.
     5435   RETURN YES.
     5436   END FUNCTION.
