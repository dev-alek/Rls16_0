     4371           view-as alert-box error .
     4372           return error.
     4373         end.
     4374         v-doc-rec = integer(entry(1, v-rid-list)).
     4375       end.
     4376   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4378     (output v-db-num
     4379     )  .
     4380     if v-db-num <> X_clients.db-num then do:
     4381       message
     4382       "Нельзя работать с группами блюд кассы объекта удаленной БД"
     4383       view-as alert-box error .
     4384       undo, return error .
     4385     end.
     4386     do transaction
     4387     on error undo main-block, return error
     4388     :
     4389       FIND FIRST LOCKED_cash-desk EXCLUSIVE-LOCK WHERE
     4390                 LOCKED_cash-desk.obj-code = p-curr-obj-code
     4391             AND LOCKED_cash-desk.db-num = v-db-num
     4392             AND LOCKED_cash-desk.pos-type = 'r-keeper':U
     4393             NO-WAIT NO-ERROR.
     4394       IF NOT AVAILABLE locked_cash-desk AND NOT LOCKED locked_cash-desk THEN DO:
     4395           MESSAGE
     4396           SUBSTITUTE("На &1&2 не определена касса типа &3&4" +
     4397                     "Нельзя работать с товарами на кассе"
     4398                     , p-curr-obj-type
     4399                     , p-curr-obj-code
     4400                     , 'r-keeper':U
     4401                     , chr(10)
     4402                     )
     4403         VIEW-AS ALERT-BOX ERROR.
     4404         UNDO main-block, RETURN ERROR.
     4405       END.
     4406       IF LOCKED locked_cash-desk THEN DO:
     4407           MESSAGE
     4408           SUBSTITUTE("На &1&2 в настоящее время занята запись кассы типа &3&4" +
     4409                     "Нельзя работать с товарами на кассе"
     4410                     , p-curr-obj-type
     4411                     , p-curr-obj-code
     4412                     , 'r-keeper':U
     4413                     , chr(10))
     4414         VIEW-AS ALERT-BOX ERROR.
     4415         UNDO main-block, RETURN ERROR.
     4416       END.
     4417     end.
     4418     RUN MyEnable.
     4419     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     4420     HIDE mark-num in frame Dialog-Frame .
     4421     if v-rid-list <> "":U then
     4422     REPOSITION br-rkep-grp to recid integer(entry(1, v-rid-list)) No-ERROR.
     4423   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4424   DEF VAR cur-clmn-numbr-rkep-grp as INT EXTENT 7 no-undo.
     4425   DEF VAR varmvibr-rkep-grp       as INT no-undo.
     4426   DEF VAR varmvjbr-rkep-grp       as INT no-undo.
     4427   DEF VAR varmvkbr-rkep-grp       as INT no-undo.
     4428   DEF VAR varmvlbr-rkep-grp       as INT no-undo.
     4429   DEF VAR move-elementbr-rkep-grp as INT no-undo.
     4430   def var jjbr-rkep-grp           as int no-undo.
     4431   do varmvibr-rkep-grp = 1 to EXTENT(cur-clmn-numbr-rkep-grp):
     4432     ASSIGN cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = varmvibr-rkep-grp.
     4433   END.
     4434   RUN start-mv-clmnbr-rkep-grp.
     4435   PROCEDURE start-mv-clmnbr-rkep-grp:
     4436   def var old-session as logical no-undo.
     4437      old-session = SESSION:IMMEDIATE-DISPLAY.
     4438      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4439          IF  true  THEN DO:
     4440      DO jjbr-rkep-grp = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     4441        RUN re-move-clmnbr-rkep-grp ( cur-clmn-numbr-rkep-grp[INTEGER(ENTRY (jjbr-rkep-grp, '1,2,3,4,5,6,7'))] , 1).
     4442      END.
     4443          END.
     4444      SESSION:IMMEDIATE-DISPLAY = old-session.
     4445   END.
     4446   ON ctrl-cursor-right OF BROWSE br-rkep-grp do:
     4447     RUN re-move-clmnbr-rkep-grp ( 1, 7).
     4448   END.
     4449   ON ctrl-cursor-left OF BROWSE br-rkep-grp do:
     4450     RUN re-move-clmnbr-rkep-grp (7, 1).
     4451   END.
     4452   PROCEDURE re-move-clmnbr-rkep-grp:
     4453     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4454     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4455     DO varmvibr-rkep-grp = 1 TO EXTENT(cur-clmn-numbr-rkep-grp):
     4456       if cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = source-column THEN cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = -1.
     4457     END.
     4458     if br-rkep-grp:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     4459     if source-column > target-column THEN
     4460     DO varmvjbr-rkep-grp = source-column - 1 to target-column BY -1:
     4461       DO varmvibr-rkep-grp = 1 TO EXTENT(cur-clmn-numbr-rkep-grp):
     4462           if cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = varmvjbr-rkep-grp THEN DO:
     4463             cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] + 1.
     4464           END.
     4465       END.
     4466     END.
     4467     ELSE
     4468     DO varmvjbr-rkep-grp = source-column + 1 to target-column:
     4469       DO varmvibr-rkep-grp = 1 TO EXTENT(cur-clmn-numbr-rkep-grp):
     4470         if cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = varmvjbr-rkep-grp THEN DO:
     4471           cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] - 1.
     4472         END.
     4473       END.
     4474     END.
     4475     DO varmvibr-rkep-grp = 1 TO EXTENT(cur-clmn-numbr-rkep-grp):
     4476       if cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = -1 THEN cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = target-column.
     4477     END.
     4478   END PROCEDURE.
     4479   PROCEDURE ch-clmnbr-rkep-grp:
     4480     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4481     if cur-clmn-loc <= 1 then do:
     4482       return .
     4483     end.
     4484     DO varmvibr-rkep-grp = 1 TO EXTENT(cur-clmn-numbr-rkep-grp):
     4485       if cur-clmn-numbr-rkep-grp[varmvibr-rkep-grp] = cur-clmn-loc THEN move-elementbr-rkep-grp = varmvibr-rkep-grp.
     4486     END.
     4487     RUN re-move-clmnbr-rkep-grp (cur-clmn-loc, 1).
     4488   END PROCEDURE.
     4489   PROCEDURE mv-brw-defaultbr-rkep-grp:
     4490   def var old-session as logical no-undo.
     4491     old-session = SESSION:IMMEDIATE-DISPLAY.
     4492     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4493     do varmvlbr-rkep-grp = 1 to EXTENT(cur-clmn-numbr-rkep-grp):
     4494       RUN re-move-clmnbr-rkep-grp (cur-clmn-numbr-rkep-grp[varmvlbr-rkep-grp], varmvlbr-rkep-grp).
     4495     END.
     4496     RUN start-mv-clmnbr-rkep-grp.
     4497     SESSION:IMMEDIATE-DISPLAY = old-session.
     4498   END PROCEDURE.
     4499   .
     4500     WAIT-FOR GO OF FRAME Dialog-Frame.
     4501   END.
     4502   RUN disable_UI.
     4503   PROCEDURE disable_UI :
     4504     HIDE FRAME Dialog-Frame.
     4505   END PROCEDURE.
     4506   PROCEDURE enable_UI :
     4507     DISPLAY T-batch rs-mode T-group T-name RS-sch sch-name sch-id mark-num
     4508             v-rkep-grp-name v-grp-name
     4509         WITH FRAME Dialog-Frame.
     4510     ENABLE b-quit B-mark b-sel B-link b-chg B-print B-sch B-Help T-batch rs-mode
     4511            T-group T-name RS-sch sch-name sch-id BR-rkep-grp mark-num
     4512            v-rkep-grp-name v-grp-name
     4513         WITH FRAME Dialog-Frame.
     4514     VIEW FRAME Dialog-Frame.
     4515     OPEN QUERY BR-rkep-grp FOR EACH X_cd-grp NO-LOCK,                                    FIRST X_fbr-gds-grp OUTER-JOIN where                                   X_fbr-gds-grp.obj-type = 'маг':U                               AND X_fbr-gds-grp.obj-code = p-curr-obj-code                               AND X_fbr-gds-grp.out-code = X_cd-grp.grp-code,                                    FIRST X_upper-fbr-gds-grp  by lft    INDEXED-REPOSITION .
     4516   END PROCEDURE.
     4517   PROCEDURE Myenable :
     4518   assign
     4519   v-tab-order = "b-quit,b-mark,b-sel,b-link,b-chg,b-sch,b-print,b-help," +
     4520                 "t-batch,rs-mode,t-name,t-group," +
     4521                  "rs-sch,sch-id,sch-full_name,br-rkep-grp"
     4522   br-rkep-grp:num-locked-columns in frame Dialog-Frame = 1
