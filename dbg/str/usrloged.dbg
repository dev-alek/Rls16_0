        1   define input  parameter parparentproc               as widget-handle no-undo .
        2   define input  parameter p-input-mode                as character no-undo .
        3   define input-output parameter p-db-num                    as integer   no-undo .
        4   define input  parameter p-user-id                   as character no-undo .
        5   define input  parameter p-user-login                as character no-undo .
        6   define input  parameter p-user-administrator        as logical   no-undo .
        7   define input  parameter p-max-discnt                as decimal   no-undo .
        8   define input  parameter p-quest-print               as logical   no-undo .
        9   define output parameter v-update-data               as logical   no-undo .
       10   define output parameter v-output-user-login         as character no-undo .
       11   define output parameter v-output-user-administrator as logical   no-undo .
       12   define output parameter v-output-max-discnt         as decimal   no-undo .
       13   define output parameter v-output-quest-print        as logical   no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Редактирование данных для логина пользователя".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define new global shared variable g#language as character no-undo .
      120   if g#language <> '' and g#language <> 'rus':U then do:
      121     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      122   end.
      123   DEFINE BUTTON b-choice-bd
      124        LABEL "Выбор"
      125        SIZE 11 BY 1.
      126   DEFINE BUTTON b-exit AUTO-GO
      127        LABEL "&Ввод"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE BUTTON b-help
      131        LABEL "Помо&щь"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON b-quit AUTO-END-KEY
      135        LABEL "&Отмена"
      136        SIZE 10 BY 1
      137        BGCOLOR 8 .
      138   DEFINE VARIABLE fi-db-num LIKE user-login.db-num
      139        VIEW-AS FILL-IN
      140        SIZE 6 BY 1
      141        FGCOLOR 4  NO-UNDO.
      142   DEFINE VARIABLE fi-max-discnt LIKE user-login.max-discnt
      143        VIEW-AS FILL-IN
      144        SIZE 7 BY 1 NO-UNDO.
      145   DEFINE VARIABLE fi-user-id LIKE user-login.user-id
      146        VIEW-AS FILL-IN
      147        SIZE 16 BY 1
      148        FGCOLOR 4  NO-UNDO.
      149   DEFINE VARIABLE fi-user-login LIKE user-login.user-login
      150        VIEW-AS FILL-IN
      151        SIZE 13 BY 1 NO-UNDO.
      152   DEFINE VARIABLE fi-user-name AS CHARACTER FORMAT "X(256)":U
      153         VIEW-AS TEXT
      154        SIZE 79 BY .67
      155        FGCOLOR 4  NO-UNDO.
      156   DEFINE VARIABLE t-quest-print LIKE user-login.quest-print
      157        VIEW-AS TOGGLE-BOX
      158        SIZE 43.13 BY .83 NO-UNDO.
      159   DEFINE VARIABLE t-user-administrator LIKE user-login.user-administrator
      160        VIEW-AS TOGGLE-BOX
      161        SIZE 16.13 BY .83 NO-UNDO.
      162   DEFINE FRAME Dialog-Frame
      163        b-exit AT ROW 1 COL 1
      164        b-quit AT ROW 1 COL 11
      165        b-help AT ROW 1 COL 73
      166        fi-db-num AT ROW 2.75 COL 25.5 COLON-ALIGNED HELP
      167             "" WIDGET-ID 2
      168             FGCOLOR 4
      169        b-choice-bd AT ROW 2.75 COL 37.5 WIDGET-ID 20
      170        fi-user-id AT ROW 4 COL 25.5 COLON-ALIGNED HELP
      171             "" WIDGET-ID 4
      172             FGCOLOR 4
      173        fi-user-login AT ROW 6.75 COL 25.5 COLON-ALIGNED HELP
      174             "" WIDGET-ID 6
      175        t-user-administrator AT ROW 8 COL 27.5 HELP
      176             "" WIDGET-ID 14
      177        fi-max-discnt AT ROW 9 COL 25.5 COLON-ALIGNED HELP
      178             "" WIDGET-ID 10
      179        t-quest-print AT ROW 10.25 COL 27.5 HELP
      180             "" WIDGET-ID 16
      181        fi-user-name AT ROW 5.25 COL 1.5 COLON-ALIGNED NO-LABEL WIDGET-ID 18
      182        SPACE(1.62) SKIP(6.36)
      183       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      184            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      185            TITLE "Логин пользователя"
      186            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      187   ASSIGN
      188          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      189          FRAME Dialog-Frame:HIDDEN           = TRUE.
      190   ASSIGN
      191          t-user-administrator:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      192   ON GO OF FRAME Dialog-Frame
      193   DO:
      194     run update-record in this-procedure
      195       no-error .
      196     if error-status :error
      197     then do:
      198       return no-apply .
      199     end.
      200   END.
      201   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      202   DO:
      203     APPLY "END-ERROR":U TO SELF.
      204   END.
      205   ON CHOOSE OF b-choice-bd IN FRAME Dialog-Frame
      206   DO:
      207     define variable ri as recid no-undo.
      208     define buffer buf_db for ub.db.
      209     run adm/dbs.w (
      210                   input parparentproc
      211                  ,input 'ПРОСМОТР':U
      212                  ,output ri) no-error.
      213     if ri <> ?
      214     then do:
      215       find buf_db where recid (buf_db) = ri .
      216       display
      217       buf_db.db-num @ fi-db-num
      218       with frame Dialog-Frame.
      219       assign
      220          fi-db-num = buf_db.db-num.
      221     end.
      222     else do:
      223       assign
      224         fi-db-num = ?
      225         p-db-num  = ?.
      226       display
      227       ? @ fi-db-num
      228       with frame Dialog-Frame.
      229     end.
      230   END.
      231   ON VALUE-CHANGED OF fi-db-num IN FRAME Dialog-Frame
      232   DO:
      233       assign
      234           fi-db-num
      235       .
      236   END.
      237   ON LEAVE OF fi-db-num IN FRAME Dialog-Frame
      238   DO:
      239     define buffer buf_db for ub.db.
      240     if fi-db-num <> ? and
      241      not can-find (buf_db where buf_db.db-num = input frame Dialog-Frame fi-db-num no-lock ) then do:
      242       message "Нет БД с таким номером."
      243               view-as alert-box error.
      244       assign
      245         fi-db-num = ?
      246         p-db-num  = ?.
      247       display
      248       ? @ fi-db-num
      249       with frame Dialog-Frame.
      250     end.
      251   END.
      252   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      253   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      254   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   on help of frame Dialog-Frame
      256   do:
      257     run gbl/app_help.p
      258       (input this-procedure :file-name
      259       ,input ''
      260       ,input ?
      261       ) no-error.
      262     if error-status :error then do:
      263       message
      264         "Ошибка при вызове помощи"
      265         error-status :get-message(1)
      266         view-as alert-box .
      267     end.
      268   end.
      269   run minbtn-set in this-procedure .
      270   on choose of b-help in frame Dialog-Frame
      271   do:
      272     apply "help":u to frame Dialog-Frame .
      273   end.
      274   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      275   procedure minbtn-set :
      276       do
      277           on error undo, return error return-value
      278           :
      279           define variable ii              as integer       no-undo .
      280           define variable fh              as widget-handle no-undo .
      281           define variable hh              as widget-handle no-undo .
      282           define variable v-h             as handle        extent 4 no-undo .
      283           define variable v-name-button   as character     no-undo .
      284           define variable v-help-old-x    as decimal       no-undo .
      285           define variable v-help-old-y    as decimal       no-undo .
      286           define variable v-help-old-size as decimal       no-undo .
      287           define variable v-frame-width   as decimal       no-undo .
      288           define variable jj              as integer       no-undo .
      289           do
      290               on error undo, return error
      291               :
      292               assign
      293                   v-frame-width = frame Dialog-Frame:width - 0.3
      294                   fh            = frame Dialog-Frame:first-child
      295                   hh            = fh:first-child
      296                   ii            = 1
      297                   .
      298               do while valid-handle(hh):
      299                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      300                   do:
      301                       case lc(hh:name) :
      302                           when "b-help" then
      303                               do:
      304                                   hh:load-image-up("cmp/b-help.bmp":u) .
      305                                   hh:load-image-down("cmp/b-help.bmp":u) .
      306                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      307                                   hh:TOOLTIP = "Помощь" .
      308                                   v-help-old-x = hh:column .
      309                                   v-help-old-y = hh:row    .
      310                                   v-help-old-size = hh:width .
      311                                   hh:width-chars = 2.5 .
      312                               end.
      313                           when "b-print" then
      314                               do:
      315                                   hh:load-image("cmp/b-print.bmp":u) .
      316                                   hh:TOOLTIP = "Печать" .
      317                                   v-h[ii] = hh:handle .
      318                                   ii = ii + 1 .
      319                                   hh:width-chars = 3 .
      320                               end.
      321                           when "b-history" or
      322                           when "b-hist" then
      323                               do:
      324                                   hh:load-image("cmp/b-hist.bmp":u) .
      325                                   hh:TOOLTIP = "История" .
      326                                   v-h[ii] = hh:handle .
      327                                   ii = ii + 1 .
      328                                   hh:width-chars = 3 .
      329                               end.
      330                           when "b-sch" then
      331                               do:
      332                                   hh:load-image("cmp/b-sch.bmp":u) .
      333                                   hh:TOOLTIP = "Установка Фильтра" .
      334                                   v-h[ii] = hh:handle .
      335                                   ii = ii + 1 .
      336                                   hh:width-chars = 3 .
      337                               end.
      338                           when "b-hist-user" then
      339                               do:
      340                                   hh:load-image("cmp/b-hist.bmp":u) .
      341                                   hh:TOOLTIP = "История пользователя" .
      342                                   ii = ii + 1 .
      343                               end.
      344                       end case.
      345                   end.
      346                   hh = hh:next-sibling.
      347               end.
      348               b-help:column = v-frame-width - b-help:width-chars.
      349               jj = 0.
      350               repeat ii = 4 to 1 by -1 :
      351                   if valid-handle (v-h[ii] ) then
      352                   do:
      353                       jj  = jj + 1 .
      354                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      355                       v-h[ii]:row    = v-help-old-y .
      356                   end.
      357               end.
      358           end.
      359       end.
      360   end procedure.
      361   MAIN-BLOCK:
      362   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      363      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      364     RUN enable_UI.
      365     run display-data in this-procedure .
      366     run enable-fields in this-procedure .
      367     WAIT-FOR GO OF FRAME Dialog-Frame.
      368   END.
      369   RUN disable_UI.
      370   PROCEDURE disable_UI :
      371     HIDE FRAME Dialog-Frame.
      372   END PROCEDURE.
      373   PROCEDURE display-data :
      374     define buffer buf_user-account for ub.user-account .
      375     do
      376     on error undo, return error return-value
      377     :
      378       do with frame Dialog-Frame
      379       :
      380         assign
      381           fi-user-id            = p-user-id
      382           fi-user-login         = p-user-login
      383           t-user-administrator  = p-user-administrator
      384           fi-max-discnt         = p-max-discnt
      385           t-quest-print         = p-quest-print
      386         .
      387         if p-db-num ne ? then do:
      388           fi-db-num = p-db-num .
      389         end.
      390         display
      391           fi-db-num    when p-db-num ne ?
      392           fi-user-id
      393           fi-user-login
      394           fi-max-discnt
      395           t-quest-print
      396           with frame Dialog-Frame .
      397           b-choice-bd:visible = p-db-num ne ?.
      398           fi-db-num:visible   = p-db-num ne ?.
      399       end.
      400     end.
      401   END PROCEDURE.
      402   PROCEDURE enable-fields :
      403     do
      404     on error undo, return error return-value
      405     :
      406       do with frame Dialog-Frame
      407       :
      408         if p-input-mode = 'ИЗМЕНЕНИЕ':U
      409         then do:
      410           assign
      411             fi-user-login        :sensitive = true
      412             t-user-administrator :sensitive = true
      413             fi-max-discnt        :sensitive = true
      414             t-quest-print        :sensitive = true
      415           .
      416         end.
      417         else do:
      418           assign
      419             fi-user-login        :sensitive = false
      420             t-user-administrator :sensitive = false
      421             fi-max-discnt        :sensitive = false
      422             t-quest-print        :sensitive = false
      423             t-user-administrator :HIDDEN    = false
      424           .
      425         end.
      426       end.
      427     end.
      428   END PROCEDURE.
      429   PROCEDURE enable_UI :
      430     DISPLAY fi-db-num fi-user-id fi-user-login fi-max-discnt t-quest-print
      431             fi-user-name
      432         WITH FRAME Dialog-Frame.
      433     ENABLE b-exit b-quit b-help fi-db-num b-choice-bd fi-user-name
      434         WITH FRAME Dialog-Frame.
      435     VIEW FRAME Dialog-Frame.
      436   END PROCEDURE.
      437   PROCEDURE update-record :
      438     define buffer buf_user-login for ub.user-login .
      439     do
      440     on error undo, return error return-value
      441     :
      442       do with frame Dialog-Frame
      443       :
      444         assign
      445           fi-user-login
      446           fi-max-discnt
      447           t-quest-print
      448         .
      449         if fi-user-login = ?
      450         or fi-user-login = '':U
      451         then do:
      452           message
      453             "Необходимо ввести логин пользователя" skip
      454             view-as alert-box error .
      455           apply 'entry':U to fi-user-login .
      456           undo, return error return-value .
      457         end.
      458         if     p-db-num  ne ?
      459            and fi-db-num eq ?
      460         then do:
      461           message
      462             "Необходимо ввести номер базы данных" skip
      463             view-as alert-box error .
      464           apply 'entry':U to fi-db-num .
      465           undo, return error return-value .
      466         end.
      467         find first buf_user-login no-lock
      468           where buf_user-login.db-num = fi-db-num
      469             and buf_user-login.user-login = fi-user-login
      470             and buf_user-login.user-id <> p-user-id
      471           no-error .
      472         if available buf_user-login
      473         then do:
      474           message
      475             "У другого пользователя уже существует логин" fi-user-login skip
      476             "для БД" fi-db-num SKIP
      477             view-as alert-box error .
      478           apply 'entry':U to fi-user-login .
      479           undo, return error return-value .
      480         end.
      481         assign
      482           v-update-data               = true
      483           v-output-user-login         = fi-user-login
      484           v-output-user-administrator = t-user-administrator
      485           v-output-max-discnt         = fi-max-discnt
      486           v-output-quest-print        = t-quest-print
      487           p-db-num                    = fi-db-num
      488         .
      489       end.
      490     end.
      491   END PROCEDURE.
