     2607   define variable mode-erprn as logical no-undo.
     2608   _main:
     2609   do
     2610   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2611   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
