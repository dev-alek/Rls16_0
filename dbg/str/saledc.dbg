     2584   procedure clear-from-rec-ord :
     2585   define input parameter p-rec-ord as integer no-undo .
     2586   define buffer buf_temp-no-route for temp-no-route.
     2587   define buffer buf_temp-smart-link for temp-smart-link.
     2588   do
     2589   on error undo, return error
     2590   :
     2591   for each buf_temp-no-route where
     2592           buf_temp-no-route.rec-ord > p-rec-ord:
     2593     delete buf_temp-no-route.
     2594   end.
     2595   for each buf_temp-smart-link where
     2596           buf_temp-smart-link.rec-ord > p-rec-ord:
     2597      delete buf_temp-smart-link.
     2598   end.
     2599   end.
     2600   end procedure.
