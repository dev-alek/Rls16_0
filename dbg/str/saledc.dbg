     1286       define buffer out-vatp_doc-line    for ub.doc-line.
     1287       define buffer out-vatp_goods       for ub.goods.
     1288       define buffer out-vatp_trn-doc     for ub.trn-doc.
     1289       define buffer out-vatp_doc-attr    for ub.doc-attr.
     1290       define variable varprice-base-cons      like ub.doc-line.price-base initial 0.00 no-undo.
     1291       define variable varprice-rubl-cons      like ub.doc-line.price-rubl initial 0.00 no-undo.
     1292       define variable varfrm-cnsv-type         as   character                           no-undo.
     1293       define variable varfrm-cnsv              as   character                           no-undo.
     1294       define variable varroot-node             as   integer                             no-undo.
     1295       define variable varempty-scale           as   logical                             no-undo.
     1296       define variable varis-cons-parts-have    as   logical                             no-undo.
     1297       define variable varsum-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1298       define variable varslt-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1299       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1300       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
     1301       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1302       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1303       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1304       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1305       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
     1306       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1307       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
