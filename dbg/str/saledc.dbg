     3092         temp-d-card.pay-tot-base = temp-d-card.pay-tot-base + sign * abs( v-sum-base)
     3093         temp-d-card.gds-tot-rubl = temp-d-card.gds-tot-rubl + sign * abs( (v-sum-rubl + v-other-rubl))
     3094         temp-d-card.gds-tot-base = temp-d-card.gds-tot-base + sign * abs( (v-sum-base + v-other-base))
     3095         temp-d-card.gds-dis-rubl = temp-d-card.gds-dis-rubl + sign * abs( v-other-rubl)
     3096         temp-d-card.gds-dis-base = temp-d-card.gds-dis-base + sign * abs( v-other-base)
     3097         .
     3098         run r-cost in this-procedure (
