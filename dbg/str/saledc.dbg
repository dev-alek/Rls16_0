     1309       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1310       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
     1311       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1312       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1313       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
