     2198   FUNCTION get-region RETURNS CHARACTER
     2199     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     2200     define variable par-region as character no-undo.
     2201     if parhost-code = 0 and
     2202          parobj-type = "":U and
     2203          parobj-code = 0 then do:
     2204          par-region = "Глобально".
     2205          return par-region.
     2206       end.
     2207       if parobj-type = 'орг':U then do:
     2208          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     2209          return par-region.
     2210       end.
     2211       if parobj-type = 'регион':U
     2212       then do:
     2213          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     2214          return par-region.
     2215       end.
     2216       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     2217       return par-region.
     2218   END FUNCTION.
     2219   FUNCTION get-objregion RETURNS CHARACTER
     2220     (  input parobj-type as character, input parobj-code as integer ) :
     2221     define variable par-region as character no-undo.
     2222     if  parobj-type = "":U and
     2223         parobj-code = 0
     2224     then do:
     2225        par-region = "Глобально".
     2226     end.
     2227     else if parobj-type = 'орг':U
     2228     then do:
     2229        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     2230     end.
     2231     else if parobj-type = 'регион':U
     2232     then do:
     2233        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     2234     end.
     2235     else
     2236        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     2237     return par-region.
     2238   END FUNCTION.
     2239   FUNCTION calldscr returns character ( input p-call-id as character):
     2240   define variable v-descr as character no-undo .
     2241   define variable v-field-list as character no-undo .
     2242   define variable v-value-list as character no-undo.
     2243   define variable v-prop-label as character no-undo .
     2244   define variable v-node-label as character no-undo .
     2245   define variable v-dt-code as integer no-undo .
     2246   define variable v-host-code as integer no-undo .
     2247   define variable v-obj-type as character no-undo .
     2248   define variable v-obj-code as integer no-undo .
     2249   define variable v-label as character no-undo .
     2250   define variable v-node-code as integer no-undo .
     2251   define buffer buf_prop-head for ub.prop-head.
     2252   define buffer buf_prop-ref for ub.prop-ref.
     2253   define buffer buf_prop-map for ub.prop-map.
     2254   run gen-key-fv in this-procedure ( input p-call-id
     2255                                     ,output v-field-list
     2256                                     ,output v-value-list) no-error .
     2257   if error-status:error then return p-call-id.
     2258   CASE entry(1, p-call-id, chr(3)):
     2259     when 'dis-card-type':U then do:
     2260       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     2261                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     2262                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     2263                            ).
     2264     end.
     2265     when 'dis-card':U then do:
     2266       v-descr = substitute("ДК: № &1"
     2267                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     2268                            ).
     2269     end.
     2270     when 'dis-card-property':U then do:
     2271       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     2272       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     2273       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     2274       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     2275       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     2276       find first buf_prop-ref no-lock where
     2277                 buf_prop-ref.dt-code = v-dt-code no-error .
     2278       if available buf_prop-ref then do:
     2279         find first buf_prop-head no-lock where
     2280                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     2281         v-prop-label = buf_prop-head.prop-label.
     2282         find first buf_prop-map no-lock where
     2283                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     2284               and buf_prop-map.node-code = v-node-code no-error .
     2285         if available buf_prop-map then do:
     2286           v-label = buf_prop-map.node-label.
     2287         end.
     2288       end.
     2289       v-descr = substitute("ДК: № &1 &2:&3 &4"
     2290                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     2291                            ,v-prop-label
     2292                            ,v-label
     2293                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     2294                            ).
     2295     end.
     2296     when 'clients':U then do:
     2297       v-descr = substitute("&1&2"
     2298                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     2299                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     2300                            ).
     2301     end.
     2302     when 'ext-system':U then do:
     2303       v-descr = substitute("Внешняя система &1"
     2304                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     2305                            ).
     2306     end.
     2307     WHEN 'thbj-attr':U then do:
     2308       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     2309       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     2310       then do:
     2311         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     2312           v-descr = "Операции с товарами".
     2313         end.
     2314         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     2315           v-descr = "Операции с клиентами".
     2316         end.
     2317         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     2318           v-descr = "Операции с группами товаров".
     2319         end.
     2320         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     2321           v-descr = "Операции с группами клиентов".
     2322         end.
     2323         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     2324           v-descr = "Операции с чеками на POS IBS-TH".
     2325         end.
     2326         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     2327           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     2328         end.
     2329         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     2330           v-descr = "Операции в системе электронного документооборота".
     2331         end.
     2332         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     2333           v-descr = "Операции со справочниками".
     2334         end.
     2335         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     2336           v-descr = "Операции с ДНЦ и переоценками".
     2337         end.
     2338         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     2339           v-descr = "Отчеты".
     2340         end.
     2341         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     2342           v-descr = "Операции с заказами".
     2343         end.
     2344       end.
     2345     end.
     2346     when 'cash-desk':U then do:
     2347       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     2348                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     2349                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     2350                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     2351                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     2352                            ).
     2353     end.
     2354     when 'ext-file':U then do:
     2355       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     2356                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     2357                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     2358                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     2359                            ).
     2360     end.
     2361   end case.
     2362   return v-descr.
     2363   end function.
