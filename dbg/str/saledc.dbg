     3682                     string(v-doc-date) + chr(6) +
     3683                     string((if v-fact-date = ? then v-doc-date else v-fact-date)) + chr(6) +
     3684                     string(sign) + chr(6) +
     3685                     string((if cre-pay = ? then 0 else cre-pay)).
     3686       end.
     3687       when 'batch-card-recalc':U
     3688       or
     3689       when 'one-card-check':U
     3690       or
     3691       when ('one-card-add':U)
     3692       then do:
     3693         v-command = 'cmd-process-saledc':U + chr(6) +
     3694                     string(p-step) + chr(6) +
     3695                     string(g#db-num)             + chr(6) +
     3696                     '':U + chr(6) +
     3697                     string(v-obj-code) + chr(6) +
     3698                     '':U + chr(6) +
     3699                     p-process + chr(6) +
     3700                     '':U + chr(6) +
     3701                     string(v-doc-date) + chr(6) +
     3702                     string(v-fact-date) + chr(6) +
     3703                     string(par-sign) + chr(6) +
     3704                     string((if cre-pay = ? then 0 else cre-pay)).
     3705       end.
     3706       when 'text-import':U
     3707       or
     3708       when 'sale-xml-import':U
     3709       then do:
     3710         v-command = 'cmd-process-saledc':U + chr(6) +
     3711                     string(p-step) + chr(6) +
     3712                     string(g#db-num)             + chr(6) +
     3713                     v-cntxt-obj-type + chr(6) +
     3714                     string(v-cntxt-obj-code) + chr(6) +
     3715                     v-doc-code + chr(6) +
     3716                     p-process + chr(6) +
     3717                     '':U + chr(6) +
     3718                     string(v-doc-date) + chr(6) +
     3719                     string(v-fact-date) + chr(6) +
     3720                     string(par-sign) + chr(6) +
     3721                     string(cre-pay).
     3722       end.
     3723       when 'payment-on-card':U then do:
     3724         v-command = 'cmd-process-saledc':U + chr(6) +
     3725                     string(p-step) + chr(6) +
     3726                     string(g#db-num)             + chr(6) +
     3727                     '':U + chr(6) +
     3728                     string(v-obj-code) + chr(6) +
     3729                     '':U + chr(6) +
     3730                     p-process + chr(6) +
     3731                     '':U + chr(6) +
     3732                     string(v-doc-date) + chr(6) +
     3733                     string(v-fact-date) + chr(6) +
     3734                     string(par-sign) + chr(6) +
     3735                     string(cre-pay).
     3736       end.
     3737       when 'fin-doc-on-card':U
