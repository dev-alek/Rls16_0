      502   procedure gen-key-rec :
      503     define input  parameter p-tbl-name    as character no-undo.
      504     define input  parameter p-bh_tbl-name as handle    no-undo.
      505     define output parameter p-key-rec     as character no-undo.
      506     do
      507     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      508     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      509     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      510     :
      511       define variable fh               as handle    no-undo .
      512       define variable v-ok             as logical   no-undo .
      513       define variable v-inform         as character no-undo .
      514       define variable v-ind            as integer   no-undo .
      515       define variable v-idx-field-qnty as integer   no-undo .
      516       if p-tbl-name = ?
      517         or p-tbl-name = "":U
      518       then do:
      519         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
      520       end.
      521       if not p-bh_tbl-name:available then do:
      522         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
      523       end.
      524       assign
      525         p-key-rec = p-tbl-name
      526         v-inform  = p-bh_tbl-name:index-information(1)
      527         v-ind     = 2
      528       .
      529       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      530       on error undo, return error
      531       :
      532         assign
      533           v-inform = p-bh_tbl-name:index-information( v-ind )
      534           v-ind    = v-ind + 1
      535         .
      536       end.
      537       if v-inform = ?
      538         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      539         or entry( 3, v-inform, ",":U ) <> "1":U
      540       then do:
      541         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
      542       end.
      543       else do:
      544         assign
      545           v-idx-field-qnty = num-entries( v-inform ) - 4
      546         .
      547         if v-idx-field-qnty < 2 then do:
      548           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
      549         end.
      550         do v-ind = 1 to v-idx-field-qnty by 2
      551         on error undo, return error
      552         :
      553           assign
      554             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      555             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      556           .
      557         end.
      558       end.
      559       if p-key-rec = ? then do:
      560         assign
      561           p-key-rec = "":U
      562         .
      563         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
      564       end.
      565     end.
      566     return.
      567   end procedure.
      568   procedure gen-where-keyr-tab :
      569     define input  parameter i-tableSerach as character no-undo.
      570     define input  parameter i-tablekey   as character  no-undo.
      571     define input  parameter p-key-rec    as character  no-undo.
      572     define input  parameter p-key-handle as handle     no-undo .
      573     define input  parameter p-db-name    as character  no-undo .
      574     define input  parameter p-tt-handle  as handle     no-undo .
      575     define output parameter o-Where      as character  no-undo.
      576     do
      577     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      578     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      579     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      580     :
      581       define variable v-full-tbl-name  as character no-undo .
      582       define variable bh_tbl-name      as handle    no-undo .
      583       define variable fh_key           as handle    no-undo .
      584       define variable fh_search        as handle    no-undo .
      585       define variable v-field-num      as integer   no-undo .
      586       define variable v-count-fld      as integer   no-undo .
      587       define variable v-inform         as character no-undo .
      588       define variable v-ind            as integer   no-undo .
      589       define variable v-idx-field-qnty as integer   no-undo .
      590       define variable v-field-name     as character no-undo .
      591       define variable v-field-val      as character no-undo .
      592       define variable v-word-link      as character no-undo .
      593       define variable vTable           as character no-undo.
      594       define variable bh_tbl-key       as handle    no-undo .
      595       assign
      596         p-key-rec = trim( p-key-rec )
      597       .
      598       if p-key-handle <> ? then do:
      599         if not valid-handle(p-key-handle)
      600            or p-key-handle:type <> "buffer"
      601         then do:
      602           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
      603         end.
      604         if num-entries( p-key-rec, chr(3) ) > 1
      605           or p-key-rec = ?
      606           or p-key-rec = "":U
      607         then do:
      608           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
      609         end.
      610       end.
      611       else do:
      612         if p-key-rec = ?
      613           or p-key-rec = "":U
      614         then do:
      615           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
      616         end.
      617       end.
      618       assign
      619         vTable = entry( 1 , p-key-rec, chr(3) )
      620       .
      621       if p-tt-handle <> ?
      622         and ( not valid-handle(p-tt-handle)
      623               or p-tt-handle:type <> "buffer"
      624             )
      625       then do:
      626         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
      627       end.
      628       if p-tt-handle = ? then do:
      629         assign
      630           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      631         .
      632         create buffer bh_tbl-name for table v-full-tbl-name .
      633       end.
      634       else do:
      635         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      636       end.
      637       assign
      638         v-inform = bh_tbl-name:index-information(1)
      639         v-ind    = 2
      640       .
      641       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      642       on error undo, return error
      643       :
      644         assign
      645           v-inform = bh_tbl-name:index-information( v-ind )
      646           v-ind    = v-ind + 1
      647         .
      648       end.
      649       if v-inform = ?
      650         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      651         or entry( 3, v-inform, ",":U ) <> "1":U
      652       then do:
      653         delete object bh_tbl-name no-error.
      654         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
      655       end.
      656       assign
      657         v-idx-field-qnty = num-entries( v-inform ) - 4
      658       .
      659       if v-idx-field-qnty < 2 then do:
      660         delete object bh_tbl-name no-error.
      661         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
      662       end.
      663       assign
      664         o-where     = "where":U
      665         v-word-link = "":U
      666         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      667         v-count-fld = 0
      668       .
      669       if i-tablekey ne "" and i-tablekey ne ?
      670       then do:
      671         assign
      672           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      673         .
      674         create buffer bh_tbl-key for table v-full-tbl-name .
      675       end.
      676       if i-tableSerach ne "" and i-tableSerach ne ?
      677       then do:
      678         delete object bh_tbl-name no-error.
      679         assign
      680           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      681         .
      682         create buffer bh_tbl-name for table v-full-tbl-name .
      683       end.
      684       block_where:
      685       do v-ind = 1 to v-idx-field-qnty by 2
      686       on error undo, return error
      687       :
      688         assign
      689           v-count-fld = v-count-fld + 1
      690         .
      691         if p-key-handle = ?
      692           and v-count-fld > v-field-num
      693         then do:
      694           leave block_where.
      695         end.
      696         define variable VfieldKeyTable as handle no-undo.
      697         assign
      698           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      699           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      700         .
      701         if     bh_tbl-key ne ?
      702         then do:
      703            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      704            if VfieldKeyTable eq ?
      705            then next block_where.
      706         end.
      707         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      708         then
      709            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      710         else
      711            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      712         if p-key-handle = ? then do:
      713           assign
      714             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      715           .
      716         end.
      717         else do:
      718           assign
      719             fh_key = p-key-handle:buffer-field( v-field-name )
      720           .
      721           if fh_key = ?
      722             or not valid-handle( fh_key )
      723           then do:
      724             delete object bh_tbl-name.
      725             if     bh_tbl-key ne ?
      726             then
      727                delete object bh_tbl-key.
      728             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
      729           end.
      730           assign
      731             v-field-val = fh_key:buffer-value
      732           .
      733         end.
      734         if fh_search:data-type ="character":U then do:
      735           assign
      736             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      737             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      738             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      739             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      740             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      741             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      742             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      743             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      744             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      745             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      746             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      747             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      748             v-field-val = substitute( '"&1"', v-field-val )
      749           .
      750         end.
      751         assign
      752           o-where = substitute( "&1 &2", o-where, v-field-val )
      753         .
      754         if v-word-link = "":U then do:
      755           assign
      756             v-word-link = "and":U
      757           .
      758         end.
      759       end.
      760       delete object bh_tbl-name.
      761       if     bh_tbl-key ne ?
      762       then
      763          delete object bh_tbl-key.
      764       if p-key-handle = ?
      765         and v-count-fld <> v-field-num
      766       then do:
      767         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
      768       end.
      769     end.
      770   end procedure.
      771   procedure gen-hn-keyr-tab :
      772     define input  parameter i-tableSerach as character no-undo.
      773     define input  parameter i-tablekey   as character no-undo.
      774     define input  parameter p-key-rec    as character no-undo.
      775     define input  parameter p-key-handle as handle    no-undo .
      776     define input  parameter p-db-name    as character no-undo .
      777     define input  parameter p-tt-handle  as handle    no-undo .
      778     define input  parameter p-stts-lock  as integer   no-undo .
      779     define output parameter o-hn         as handle    no-undo.
      780     define variable v-full-tbl-name as character no-undo.
      781     define variable v-where         as character no-undo.
      782     define variable bh_tbl-name     as handle    no-undo.
      783     define variable vTable          as character no-undo.
      784     do
      785     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      786     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      787     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      788         run gen-where-keyr-tab(i-tableSerach,
      789                                i-tablekey,
      790                                p-key-rec,
      791                                p-key-handle,
      792                                p-db-name,
      793                                p-tt-handle,
      794                                output v-where).
      795         if i-tableSerach ne "" and i-tableSerach ne ?
      796         then do:
      797            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      798            create buffer bh_tbl-name for table v-full-tbl-name .
      799         end.
      800         else do:
      801            if p-tt-handle = ? then do:
      802               assign
      803                  vTable = entry( 1 , p-key-rec, chr(3) )
      804               .
      805               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      806               create buffer bh_tbl-name for table v-full-tbl-name .
      807            end.
      808            else do:
      809               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      810            end.
      811         end.
      812         if p-tt-handle = ? then do:
      813            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      814         end.
      815         else do:
      816            bh_tbl-name:find-first( v-where ) no-error .
      817         end.
      818         o-hn = bh_tbl-name.
      819      end.
      820   end procedure.
      821   procedure gen-hn-keyr :
      822     define input  parameter p-key-rec    as character no-undo.
      823     define input  parameter p-key-handle as handle    no-undo .
      824     define input  parameter p-db-name    as character no-undo .
      825     define input  parameter p-tt-handle  as handle    no-undo .
      826     define input  parameter p-stts-lock  as integer   no-undo .
      827     define output parameter o-hn         as handle    no-undo.
      828     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      829   end.
      830   procedure gen-row-keyr :
      831     define input  parameter p-key-rec    as character no-undo.
      832     define input  parameter p-key-handle as handle    no-undo .
      833     define input  parameter p-db-name    as character no-undo .
      834     define input  parameter p-tt-handle  as handle    no-undo .
      835     define input  parameter p-stts-lock  as integer   no-undo .
      836     define output parameter p-tbl-row    as rowid     no-undo.
      837     define output parameter p-tbl-name   as character no-undo.
      838     define variable vHn as handle no-undo.
      839       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      840       p-tbl-row = if vHn:available then vHn:rowid else ?.
      841       p-tbl-name =  vHn:table.
      842       delete object vHn no-error.
      843     if p-tbl-row = ? then do:
      844       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
      845     end.
      846     else do:
      847       return.
      848     end.
      849   end procedure.
      850   procedure gen-key-fv :
      851     define input  parameter p-key-rec    as character no-undo .
      852     define output parameter p-field-list as character no-undo .
      853     define output parameter p-value-list as character no-undo.
      854     do
      855     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      856     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      857     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      858     :
      859       define variable v-full-tbl-name  as character no-undo .
      860       define variable bh_tbl-name      as handle    no-undo .
      861       define variable v-tbl-name       as character no-undo .
      862       define variable v-field-num      as integer   no-undo .
      863       define variable v-count-fld      as integer   no-undo .
      864       define variable v-inform         as character no-undo .
      865       define variable v-ind            as integer   no-undo .
      866       define variable v-idx-field-qnty as integer   no-undo .
      867       define variable v-delim-key      as character no-undo .
      868       if p-key-rec = ?
      869         or p-key-rec = "":U
      870       then do:
      871         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
      872       end.
      873       assign
      874         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      875         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      876       .
      877       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      878       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
      879       assign
      880         v-inform = bh_tbl-name:index-information(1)
      881         v-ind    = 2
      882       .
      883       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      884       on error undo, return error
      885       :
      886         assign
      887           v-inform = bh_tbl-name:index-information( v-ind )
      888           v-ind    = v-ind + 1
      889         .
      890       end.
      891       if v-inform = ?
      892         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      893         or entry( 3, v-inform, ",":U ) <> "1":U
      894       then do:
      895         delete object bh_tbl-name no-error.
      896         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
      897       end.
      898       assign
      899         v-idx-field-qnty = num-entries( v-inform ) - 4
      900       .
      901       if v-idx-field-qnty < 2 then do:
      902         delete object bh_tbl-name no-error.
      903         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
      904       end.
      905       assign
      906         p-field-list = "":U
      907         p-value-list = "":U
      908         v-delim-key  = "":U
      909         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      910         v-count-fld  = 0
      911       .
      912       block_where:
      913       do v-ind = 1 to v-idx-field-qnty by 2
      914       on error undo, return error
      915       :
      916         assign
      917           v-count-fld = v-count-fld + 1
      918         .
      919         if v-count-fld > v-field-num then do:
      920           leave block_where.
      921         end.
      922         assign
      923           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      924           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      925         .
      926         if v-ind = 1 then do:
      927           assign
      928             v-delim-key = chr(3)
      929           .
      930         end.
      931       end.
      932       delete object bh_tbl-name.
      933       if v-count-fld <> v-field-num then do:
      934         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
      935       end.
      936     end.
      937   end procedure.
      938   procedure gen-key-field :
      939     define input  parameter p-table      as character no-undo .
      940     define output parameter p-field-list as character no-undo .
      941     do
      942     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      943     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      944     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      945     :
      946       define variable v-full-tbl-name  as character no-undo .
      947       define variable bh_tbl-name      as handle    no-undo .
      948       define variable v-tbl-name       as character no-undo .
      949       define variable v-field-num      as integer   no-undo .
      950       define variable v-count-fld      as integer   no-undo .
      951       define variable v-inform         as character no-undo .
      952       define variable v-ind            as integer   no-undo .
      953       define variable v-idx-field-qnty as integer   no-undo .
      954       define variable v-delim-key      as character no-undo .
      955       if p-table = ?
      956         or p-table = "":U
      957       then do:
      958         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
      959       end.
      960       assign
      961         v-tbl-name      = p-table
      962         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      963       .
      964       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      965       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
      966       assign
      967         v-inform = bh_tbl-name:index-information(1)
      968         v-ind    = 2
      969       .
      970       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      971       on error undo, return error
      972       :
      973         assign
      974           v-inform = bh_tbl-name:index-information( v-ind )
      975           v-ind    = v-ind + 1
      976         .
      977       end.
      978       if v-inform = ?
      979         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      980         or entry( 3, v-inform, ",":U ) <> "1":U
      981       then do:
      982         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
      983       end.
      984       assign
      985         v-idx-field-qnty = num-entries( v-inform ) - 4
      986       .
      987       if v-idx-field-qnty < 2 then do:
      988         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
      989       end.
      990       assign
      991         p-field-list = "":U
      992         v-delim-key  = "":U
      993         v-count-fld  = 0
      994       .
      995       block_where:
      996       do v-ind = 1 to v-idx-field-qnty by 2
      997       on error undo, return error
      998       :
      999         assign
     1000           v-count-fld = v-count-fld + 1
     1001         .
     1002         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1003         if v-ind = 1 then do:
     1004           assign
     1005             v-delim-key = chr(3)
     1006           .
     1007         end.
     1008       end.
     1009       delete object bh_tbl-name.
     1010     end.
     1011   end procedure.
     1012   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1013   procedure cur-time :
     1014      define output parameter p-today as date      no-undo .
     1015      define output parameter p-time  as integer   no-undo .
     1016     do
     1017     on error undo, return error
     1018     :
     1019       define variable v-date1 as date      no-undo .
     1020       define variable v-date2 as date      no-undo .
     1021       define variable v-time  as integer   no-undo .
     1022       assign
     1023         v-date1 = today
     1024         v-time  = time
     1025         v-date2 = today
     1026       .
     1027       if v-date1 <> v-date2
     1028       then do:
     1029         assign
     1030           v-date1 = today
     1031           v-time  = v-time
     1032         .
     1033       end.
     1034       assign
     1035         p-today = v-date1
     1036         p-time  = v-time
     1037       .
     1038     end.
     1039   end.
     1040   function cur-time-date returns character
     1041   :
     1042     return string(today, '99/99/9999':U) .
     1043   end.
     1044   function cur-time-mjd returns decimal
     1045   :
     1046     define variable v-date as date      no-undo .
     1047     define variable v-time as integer   no-undo .
     1048     run cur-time in this-procedure
     1049       (output v-date
     1050       ,output v-time
     1051       ) .
     1052     return integer(v-date) - 2400002 + (v-time / 86400) .
     1053   end.
     1054   function cur-time-get-ending-index returns integer
     1055   (input p-number as integer
     1056   )
     1057   :
     1058     if p-number < 0
     1059     or p-number = ?
     1060     then do:
     1061       return 1 .
     1062     end.
     1063     define variable v-rest as integer   no-undo .
     1064     assign
     1065       p-number = p-number modulo 100
     1066     .
     1067     if p-number < 20
     1068     then do:
     1069       assign
     1070         v-rest = p-number
     1071       .
     1072     end.
     1073     else do:
     1074       assign
     1075         v-rest = p-number modulo 10
     1076       .
     1077     end.
     1078     case v-rest :
     1079       when 1
     1080       then do:
     1081         return 2 .
     1082       end.
     1083       when 2 or
     1084       when 3 or
     1085       when 4
     1086       then do:
     1087         return 3 .
     1088       end.
     1089       otherwise do:
     1090         return 1 .
     1091       end.
     1092     end case .
     1093   end.
     1094   procedure cur-time-mjd-to-date :
     1095      define input  parameter i-mjd-diff as decimal no-undo.
     1096      define output parameter o-Date     as date    no-undo.
     1097      define output parameter o-Time     as integer no-undo.
     1098      define variable v-day-number as integer   no-undo .
     1099      if    i-mjd-diff < 0
     1100         or i-mjd-diff = ?
     1101      then do:
     1102         return "?" .
     1103      end.
     1104      assign
     1105         v-day-number = truncate(i-mjd-diff,0).
     1106         o-Date = date(v-day-number + 2400002).
     1107         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1108     .
     1109   end.
     1110   function cur-time-mjd-to-string returns character
     1111   (input p-mjd-diff as decimal
     1112   )
     1113   :
     1114     define variable v-day-number as integer   no-undo .
     1115     define variable v-seconds    as integer   no-undo .
     1116     define variable v-hour       as integer   no-undo .
     1117     define variable v-min        as integer   no-undo .
     1118     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1119     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1120     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1121     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1122     if p-mjd-diff < 0
     1123     or p-mjd-diff = ?
     1124     then do:
     1125       return "?" .
     1126     end.
     1127     assign
     1128       v-day-number = integer(truncate(p-mjd-diff,0))
     1129       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1130     .
     1131     if v-seconds > 86400
     1132     then do:
     1133       assign
     1134         v-seconds = 86400 - 1
     1135       .
     1136     end.
     1137     if v-seconds < 0
     1138     then do:
     1139       assign
     1140         v-seconds = 0
     1141       .
     1142     end.
     1143     assign
     1144       v-hour = truncate(v-seconds / 3600, 0)
     1145     .
     1146     assign
     1147       v-seconds = v-seconds modulo 3600
     1148     .
     1149     assign
     1150       v-min = truncate(v-seconds / 60, 0)
     1151     .
     1152     assign
     1153       v-seconds = v-seconds modulo 60
     1154     .
     1155     return
     1156         (if v-day-number <> 0
     1157           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1158           else ""
     1159         )
     1160       + (if v-day-number <> 0 or v-hour <> 0
     1161           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1162           else ""
     1163         )
     1164       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1165           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1166           else ""
     1167         )
     1168       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1169       .
     1170   end.
     1171   function cur-time-string returns character
     1172   :
     1173     define variable v-date as date      no-undo .
     1174     define variable v-time as integer   no-undo .
     1175     run cur-time in this-procedure
     1176       (output v-date
     1177       ,output v-time
     1178       ) .
     1179     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1180   end.
     1181   function cur-time-string-sec returns character
     1182   :
     1183     define variable v-date as date      no-undo .
     1184     define variable v-time as integer   no-undo .
     1185     run cur-time in this-procedure
     1186       (output v-date
     1187       ,output v-time
     1188       ) .
     1189     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1190   end.
     1191   function cur-time-custom  returns character
     1192   (input p-prefix as character
     1193   ,input p-date-format as character
     1194   ,input p-delimiter as character
     1195   ,input p-time-format as character
     1196   ,input p-suffix as character
     1197   )
     1198   :
     1199     define variable v-date as date      no-undo .
     1200     define variable v-time as integer   no-undo .
     1201     run cur-time in this-procedure
     1202       (output v-date
     1203       ,output v-time
     1204       ) .
     1205     return
     1206       p-prefix
     1207       + string(v-date, p-date-format)
     1208       + p-delimiter
     1209       + string(v-time, p-time-format)
     1210       + p-suffix
     1211       .
     1212   end.
     1213   function cur-time-print  returns character
     1214   :
     1215     define variable v-date as date      no-undo .
     1216     define variable v-time as integer   no-undo .
     1217     run cur-time in this-procedure
     1218       (output v-date
     1219       ,output v-time
     1220       ) .
     1221     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1222   end.
     1223   function cur-time-datetime returns datetime
     1224   :
     1225     define variable v-char as character no-undo .
     1226     define variable v-datetime as datetime no-undo .
     1227     v-char = cur-time-string().
     1228     v-datetime = datetime(v-char).
     1229     return  v-datetime.
     1230   end.
     1231   function cur-time-string-msec returns character
     1232   :
     1233     define variable v-date as datetime  no-undo .
     1234     v-date = now.
     1235     return string(v-date) .
     1236   end.
     1237   define variable vss-include-info11 as character format "X(65)" no-undo
     1238   initial "@(#)$Workfile$ $Revision$".
     1239   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1240   procedure r-sale :
     1241     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
