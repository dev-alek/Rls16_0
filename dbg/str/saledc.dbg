      321   define   temp-table temp-pers-proc no-undo
      322   field proc-name as character
      323   field vproc-handle as handle
      324   field vparent-handle as handle
      325   field user-name as character
      326   field id as integer
      327   field vpar as character
      328   field rank-to-delete as integer
      329   index pi is unique primary
      330   proc-name
      331   id
      332   index puser
      333   proc-name
      334   user-name
      335   index ppar
      336   proc-name
      337   vpar
      338   index iparent
      339   vparent-handle
      340   proc-name
      341   index iid
      342   id
      343   index ird
      344   rank-to-delete
      345   .
      346   define variable v-per-proc-num as integer no-undo .
      347   procedure perproc-create-proc :
      348   define input  parameter p-parent-handle as handle no-undo .
      349   define input  parameter p-proc-name as character no-undo .
      350   define input  parameter p-proc-handle  as handle no-undo .
      351   define input  parameter p-run        as logical no-undo .
      352   define input  parameter p-parameter as character no-undo .
      353   define input  parameter p-userid as character no-undo .
      354   define input  parameter p-rank-to-delete as integer no-undo .
      355   define output parameter p-id as integer   no-undo .
      356   define variable ii as integer   no-undo .
      357   define variable v-proc-handle as handle no-undo .
      358   define buffer buf_temp-pers-proc for temp-pers-proc.
      359   define buffer buf0_temp-pers-proc for temp-pers-proc.
      360     do
      361     on error undo, return error return-value
      362     :
      363       if v-per-proc-num > 100 then return error '>'.
      364       find first buf0_temp-pers-proc no-lock where
      365                 buf0_temp-pers-proc.proc-name = p-proc-name use-index pi    no-error.
      366       if not available buf0_temp-pers-proc then do:
      367         if p-run then do:
      368           run value(p-proc-name) persistent SET v-proc-handle (input p-parameter) no-error.
      369           if error-status :error then undo, return error return-value .
      370         end.
      371         else v-proc-handle = p-proc-handle.
      372         find last buf0_temp-pers-proc no-lock use-index iid  no-error.
      373         create buf_temp-pers-proc.
      374         assign
      375         buf_temp-pers-proc.proc-name = p-proc-name
      376         buf_temp-pers-proc.id = (if not available buf0_temp-pers-proc
      377                                   then  0
      378                                   else buf0_temp-pers-proc.id + 1)
      379         buf_temp-pers-proc.user-name = p-userid
      380         buf_temp-pers-proc.vpar      = p-parameter
      381         buf_temp-pers-proc.vparent-handle = p-parent-handle
      382         buf_temp-pers-proc.vproc-handle = v-proc-handle
      383         buf_temp-pers-proc.rank-to-delete = p-rank-to-delete
      384         p-id = buf_temp-pers-proc.id
      385         v-per-proc-num = v-per-proc-num + 1
      386         .
      387       end.
      388       else p-id = buf0_temp-pers-proc.id.
      389     end.
      390   end procedure.
      391   procedure perproc-delete-proc-user :
      392   define input  parameter p-proc-name as character no-undo .
      393   define input  parameter p-user-name as character no-undo .
      394   define buffer buf_temp-pers-proc for temp-pers-proc.
      395     do
      396     on error undo, return error return-value
      397     :
      398        for each buf_temp-pers-proc where
      399               buf_temp-pers-proc.proc-name = p-proc-name
      400          AND  buf_temp-pers-proc.user-name = p-user-name:
      401           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      402           delete procedure buf_temp-pers-proc.vproc-handle.
      403           delete buf_temp-pers-proc.
      404           v-per-proc-num = v-per-proc-num - 1.
      405        end.
      406     end.
      407   end procedure.
      408   procedure perproc-delete-proc-id :
      409   define input  parameter p-id        as integer   no-undo .
      410   define buffer buf_temp-pers-proc for temp-pers-proc.
      411     do
      412     on error undo, return error return-value
      413     :
      414        for each buf_temp-pers-proc where
      415           buf_temp-pers-proc.id        = p-id:
      416           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      417           delete procedure buf_temp-pers-proc.vproc-handle.
      418           delete buf_temp-pers-proc.
      419           v-per-proc-num = v-per-proc-num - 1.
      420        end.
      421     end.
      422   end procedure.
      423   procedure perproc-delete-by-rank :
      424   define buffer buf_temp-pers-proc for temp-pers-proc.
      425     do
      426     on error undo, return error return-value
      427     :
      428       for each buf_temp-pers-proc where
      429       by buf_temp-pers-proc.rank-to-delete:
      430         APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      431         delete procedure buf_temp-pers-proc.vproc-handle.
      432         delete buf_temp-pers-proc.
      433         v-per-proc-num = v-per-proc-num - 1.
      434       end.
      435     end.
      436   end procedure.
      437   procedure perproc-delete-proc-name-id :
      438   define input  parameter p-proc-name as character no-undo .
      439   define input  parameter p-id        as integer   no-undo .
      440   define buffer buf_temp-pers-proc for temp-pers-proc.
      441     do
      442     on error undo, return error return-value
      443     :
      444        for each buf_temp-pers-proc where
      445               buf_temp-pers-proc.proc-name = p-proc-name
      446          AND  buf_temp-pers-proc.id        = p-id:
      447           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      448           delete procedure buf_temp-pers-proc.vproc-handle.
      449           delete buf_temp-pers-proc.
      450           v-per-proc-num = v-per-proc-num - 1.
      451        end.
      452     end.
      453   end procedure.
      454   procedure perproc-delete-par :
      455   define input  parameter p-proc-name as character no-undo .
      456   define input  parameter p-parameter as character no-undo .
      457   define buffer buf_temp-pers-proc for temp-pers-proc.
      458     do
      459     on error undo, return error return-value
      460     :
      461        for each buf_temp-pers-proc where
      462               buf_temp-pers-proc.proc-name = p-proc-name
      463          AND  buf_temp-pers-proc.vpar      = p-parameter:
      464           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      465           delete procedure buf_temp-pers-proc.vproc-handle.
      466           delete buf_temp-pers-proc.
      467           v-per-proc-num = v-per-proc-num - 1.
      468        end.
      469     end.
      470   end procedure.
      471   procedure perproc-delete-from-parent :
      472   define input  parameter p-parent-handle as handle no-undo .
      473   define input  parameter p-proc-name as character no-undo .
      474   define buffer buf_temp-pers-proc for temp-pers-proc.
      475     do
      476     on error undo, return error return-value
      477     :
      478        if p-proc-name = "":u then do:
      479         for each buf_temp-pers-proc where
      480            buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      481             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      482             delete procedure buf_temp-pers-proc.vproc-handle.
      483             delete buf_temp-pers-proc.
      484             v-per-proc-num = v-per-proc-num - 1.
      485         end.
      486        end.
      487        else do:
      488         for each buf_temp-pers-proc where
      489                 buf_temp-pers-proc.proc-name = p-proc-name
      490           AND  buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      491             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      492             delete procedure buf_temp-pers-proc.vproc-handle.
      493             delete buf_temp-pers-proc.
      494             v-per-proc-num = v-per-proc-num - 1.
      495         end.
      496       end.
      497     end.
      498   end procedure.
