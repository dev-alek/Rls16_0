     1327       define buffer   in-vatp-partso    for ub.parts   .
     1328       define buffer   in-vatp-doco      for ub.trn-doc .
     1329       define buffer   in-vatp-goodso    for ub.goods   .
     1330       define buffer   in-vatp-sysconfo  for ub.sysconf .
     1331       define buffer   in-vatp_doc-attro for ub.doc-attr.
     1332       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     1333       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     1334       define variable varinvprbo                  as   character              no-undo.
     1335       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     1336       define variable cli-base-rateo              as   decimal                no-undo.
     1337       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     1338       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
