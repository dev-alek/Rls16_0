     2897                 undo _main, return error substitute("&1&2 Невозможно определить курс базовой валюты для чека &3 по ДК &4"
     2898                                                     , vss-description
     2899                                                     , chr(10)
     2900                                                     , chk-doc.doc-code
     2901                                                     , chk-doc.d-card).
     2902             end.
     2903           end.
     2904         end.
     2905         else do:
     2906           assign
     2907           v-rate = ACCUM-tot-rubl  / ACCUM-tot-base
     2908           no-error
     2909           .
     2910           if v-rate <> ?
     2911           and v-rate <> 0 then do:
     2912             chk-exch = v-rate.
     2913           end.
     2914           else do:
     2915             FIND LAST buf_curr-shop NO-LOCK WHERE
     2916                       buf_curr-shop.obj-type = ub.chk-doc.obj-type AND
     2917                       buf_curr-shop.obj-code = ub.chk-doc.obj-code AND
     2918                       buf_curr-shop.curr-code = v-base-code AND
     2919                       ( ( buf_curr-shop.exch-date = ub.chk-doc.chk-date AND
     2920                           buf_curr-shop.exch-time <= ub.chk-doc.chk-time ) OR
     2921                           buf_curr-shop.exch-date < ub.chk-doc.chk-date ) NO-ERROR .
     2922             if available buf_curr-shop then do:
     2923               assign
     2924               v-rate = buf_Curr-shop.exch-rate / buf_curr-shop.exch-scale
     2925               no-error .
     2926               if v-rate <> ?
     2927               and v-rate <> 0 then do:
     2928                 chk-exch = v-rate.
     2929               end.
     2930               else do:
     2931                   undo _main, return error substitute("&1&2 Невозможно определить курс базовой валюты для чека &3 по ДК &4"
     2932                                                       , vss-description
     2933                                                       , chr(10)
     2934                                                       , chk-doc.doc-code
     2935                                                       , chk-doc.d-card).
     2936               end.
     2937             end.
     2938           end.
     2939         end.
     2940       end.
     2941       assign
     2942       chk-exch-rubl = (if v-curr-r-b = 'rubl':U then 1 else chk-exch)
     2943       chk-exch-base = (if v-curr-r-b = 'base':U then 1 else chk-exch )
     2944       .
     2945       Assign
     2946       temp-d-card.sum-tot-r-b = temp-d-card.sum-tot-r-b + 0
     2947       temp-d-card.sum-tot-rubl = temp-d-card.sum-tot-rubl + 0
     2948       temp-d-card.sum-tot-base = temp-d-card.sum-tot-base + 0
     2949       temp-d-card.gds-tot-r-b  = temp-d-card.gds-tot-r-b  + sign * ub.chk-doc.tot-doc
     2950       temp-d-card.gds-tot-rubl = temp-d-card.gds-tot-rubl + sign * ub.chk-doc.tot-doc * chk-exch-rubl
     2951       temp-d-card.gds-tot-base = temp-d-card.gds-tot-base + sign * ub.chk-doc.tot-doc / chk-exch-base
     2952       temp-d-card.gds-dis-r-b  = temp-d-card.gds-dis-r-b  + sign * ub.chk-doc.discnt
     2953       temp-d-card.gds-dis-rubl = temp-d-card.gds-dis-rubl + sign * ub.chk-doc.discnt * chk-exch-rubl
     2954       temp-d-card.gds-dis-base = temp-d-card.gds-dis-base + sign * ub.chk-doc.discnt / chk-exch-base
     2955       temp-d-card.num-chk      = temp-d-card.num-chk      + sign * 1
     2956       .
     2957       run ref/calctur4.p ( input ub.chk-doc.doc-code ) .
     2958    END.
     2959       end.
     2960       when 'trn-doc-close':U
     2961       or
     2962       when 'trn-doc-delete':U
     2963       then do:
     2964         assign
     2965         v-codex-id-list = (if g#db-num = 0
     2966                            then "1,2"
     2967                            else "1")
     2968         v-ruleset-id-list[1] = string(if par-sign = 1
     2969                                     then 3
     2970                                     else 4)
     2971         v-ruleset-id-list[2] = (if g#db-num = 0
     2972                                 then (string(if par-sign = 1
     2973                                               then 3
     2974                                               else 4)
     2975                                     )
     2976                                 else '':U)
     2977         v-ruleset-id-list[2] = (if g#db-num = 0
     2978                                 then (v-ruleset-id-list[2] + chr(44) + string(9))
     2979                                 else v-ruleset-id-list[2])
     2980         .
     2981         sign  = par-direction * par-sign.
     2982         if p-save then do:
