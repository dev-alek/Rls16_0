     3795                   buf_dis-card-type.type = temp-d-card.type
     3796              and  buf_dis-card-type.emitent-host-code = temp-d-card.emitent-host-code.
     3797         v-dct-uniq-key-rec = buf_dis-card-type.uniq-key-rec.
     3798         if p-save and (not mode-erprn or p-process = 'one-card-add':U) then do:
     3799           run create-nws-outline in this-procedure (
     3800                                                      input v-cmd-proc-handle
     3801                                                     ,input buf_temp-cmd.cmd-code
     3802                                                     ,input 'dis-card-type':U
     3803                                                     ,input v-charkey_one
     3804                                                     ,input '':U
     3805                                                     ,input '':U
     3806                                                     ,input 0
     3807                                                     ,input 0
     3808                                                     ,input 0
     3809                                                     ).
     3810            v-charkey_one = v-dct-uniq-key-rec.
     3811          if p-process = 'batch-card-recalc':U then do:
     3812            run create-nws-outline in this-procedure (
     3813                                                      input v-cmd-proc-handle
     3814                                                     ,input buf_temp-cmd.cmd-code
     3815                                                     ,input 'dis-card':U
     3816                                                     ,input v-charkey_one-2
     3817                                                     ,input '':U
     3818                                                     ,input '':U
     3819                                                     ,input 0
     3820                                                     ,input 0
     3821                                                     ,input 0
     3822                                                     ).
     3823             v-charkey_one-2 = temp-d-card.d-card.
     3824           end.
     3825         end.
     3826         define buffer buf_rule-process for ub.rule-process.
     3827         _codex:
     3828         do v-jj = 1 to num-entries(v-codex-id-list):
     3829           if entry(v-jj, v-codex-id-list) = '':U then next _codex.
     3830           v-codex-id = integer(entry(v-jj, v-codex-id-list)).
     3831           do v-ii = 1 to num-entries(v-ruleset-id-list[v-jj]):
     3832              if entry(v-ii, v-ruleset-id-list[v-jj]) = '':U then next.
     3833              v-ruleset-id = integer(entry(v-ii, v-ruleset-id-list[v-jj])).
     3834             _rule-by-call:
     3835             for each buf_rule-by-call no-lock where
     3836                       buf_rule-by-call.call_id = v-dct-uniq-key-rec
     3837                 and buf_rule-by-call.can-calc = yes
     3838                 and buf_rule-by-call.codex_id = v-codex-id
     3839                 and buf_rule-by-call.ruleset_id = v-ruleset-id
     3840             by buf_rule-by-call.call_Id
     3841             by buf_rule-by-call.codex_id
     3842             by buf_rule-by-call.ruleset_id
     3843             by buf_rule-by-call.order_id
     3844             on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3845             on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3846             on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ) :
     3847               if p-save then do:
     3848                 if not available buf_temp-cmd then do:
     3849                   find first buf_temp-cmd use-index pi .
     3850                 end.
     3851               end.
     3852               if (
     3853               (p-process = 'text-import':U
     3854               or p-process = 'sale-xml-import':U)
     3855                  and v-codex-id = 4
     3856               or (p-process = 'text-export':U and v-codex-id = 5)
     3857               or ((p-process = 'stop-list-import':U + chr(4) + 'ДОБАВЛЕНИЕ':U
     3858               or p-process = 'stop-list-import':U + chr(4) + 'ИЗМЕНЕНИЕ':U)
     3859                  and v-codex-id = 6
     3860                  )
     3861               )
     3862               then do:
     3863                 if buf_rule-by-call.profile_id <> v-profile-id then next _rule-by-call.
     3864               end.
     3865               if p-process = 'sale-xml-import':U
     3866               and buf_rule-by-call.ruleset_id = 3
     3867               and buf_rule-by-call.codex_id = 4
     3868               then do:
     3869                 find first buf_rule-call-param no-lock where
     3870                           buf_rule-call-param.call_id = buf_rule-by-call.call_id
     3871                       and buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     3872                       and buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     3873                       and buf_rule-call-param.order_id = buf_rule-by-call.order_id
     3874                       and buf_rule-call-param.param-name = v-param-name
     3875                       and buf_rule-call-param.param-value-character = v-xsd-file no-error.
     3876                 if not available buf_rule-call-param then next _rule-by-call.
     3877                 find first buf_rule-call-param no-lock where
     3878                           buf_rule-call-param.call_id = buf_rule-by-call.call_id
     3879                       and buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     3880                       and buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     3881                       and buf_rule-call-param.order_id = buf_rule-by-call.order_id
     3882                       and buf_rule-call-param.param-name = "p-esys-id"
     3883                       and buf_rule-call-param.param-value-integer = int(v-doc-code) no-error.
     3884                 if not available buf_rule-call-param then next _rule-by-call.
     3885               end.
     3886               if p-process = 'batch-card-recalc':U then do:
     3887                 if v-calc-chr <> '*' then do:
     3888                   run is-to-calc-algo in p-parent-handle ( input buf_rule-by-call.uniq-key-rec, output v-calc-chr) no-error.
     3889                   if error-status:error then do:
     3890                     undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3891                   end.
     3892                   if v-calc-chr <> '*':U and logical(v-calc-chr) = no then do:
     3893                     next _rule-by-call.
     3894                   end.
     3895                    if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input substitute("&1&2Выполнение правила &3&2&4"                                      , calldscr(buf_rule-by-call.call_id)                                 ,chr(10)                                                       , buf_rule-by-call.rule_id                                           ,buf_rule-by-call.algo-des)).
     3896                 end.
     3897               end.
     3898               v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
     3899               run value(v-proc-name)  (
     3900                                                                     input parparentproc
     3901                                                                   ,input this-procedure:handle
     3902                                                                   ,input p-log-handle
     3903                                                                   ,input v-cont-handle
     3904                                                                   ,input v-codex-id
     3905                                                                   ,input v-ruleset-id
     3906                                                                   ,input buf_rule-by-call.call_id
     3907                                                                   ,input buf_rule-by-call.order_id
     3908                                                                   ,input buf_rule-by-call.rule_id
     3909                                                                   ,input buf_rule-by-call.profile_id
     3910                                                                   ,input buf_rule-by-call.is_dynamic
     3911                                                                   ,input v-doc-type
     3912                                                                   ,input v-host-code
     3913                                                                   ,input v-obj-type
     3914                                                                   ,input v-obj-code
     3915                                                                   ,input v-doc-code
     3916                                                                   ,input v-process-file-name
     3917                                                                   ,input v-doc-date
     3918                                                                   ,input v-fact-date
     3919                                                                   ,input v-save-int
     3920                                                                   ,input v-curr-r-b
     3921                                                                   ,input v-cmd-proc-handle
     3922                                                                   ,input (if p-save
     3923                                                                           then buf_temp-cmd.cmd-code
     3924                                                                           else 0)
     3925                                                                   ,input temp-d-card.type
     3926                                                                   ,input temp-d-card.emitent-host-code
     3927                                                                   ,input table temp-d-card
     3928                                                                   ) no-error .
     3929               if error-status:error
     3930               then do:
     3931                 if p-save then  do:
     3932                   delete procedure v-cmd-proc-handle .
     3933                 end.
     3934                 undo _main, return error substitute("&1&2Ошибка при обработке ДК типа &3 эмитент &4&2" +
     3935                                                     "&5&2&6"
     3936                                                     ,vss-workfile
     3937                                                     ,chr(10)
     3938                                                     ,temp-d-card.type
     3939                                                     ,temp-d-card.emitent-host-code
     3940                                                     , error-status:get-message(1)
     3941                                                     , return-value
     3942                                                       ).
     3943               end.
     3944               if v-stop-leave-status > '' then do:
     3945                 if p-save then  do:
     3946                   delete procedure v-cmd-proc-handle .
     3947                 end.
     3948                 undo _main, return error substitute("&1&2Процесс обработке ДК типа &3 эмитент &4 ПРЕРВАН&2" +
     3949                                                     "&5&2&6"
     3950                                                     ,vss-workfile
     3951                                                     ,chr(10)
     3952                                                     ,temp-d-card.type
     3953                                                     ,temp-d-card.emitent-host-code
     3954                                                     , error-status:get-message(1)
     3955                                                     , return-value
     3956                                                       ).
     3957               end.
     3958             end.
     3959           end.
     3960         end.
     3961       end.
     3962     end.
     3963     if p-save and (not mode-erprn or p-process = 'one-card-add':U) then do:
     3964     find first buf_temp-cmd.
     3965     run after-command in this-procedure ( buffer buf_temp-cmd) no-error.
     3966           if error-status:error then do:
     3967             delete procedure v-cmd-proc-handle .
     3968             undo _main, return error substitute("&1 &2 &3&4Ошибка при отправке в новости команды с кодом &5 &8&4" +
     3969                                                 "&6&4&7"
     3970                                                 ,vss-workfile
     3971                                                 ,vss-revision
     3972                                                 ,vss-description
     3973                                                 ,chr(10)
     3974                                                 ,v-cmd-code
     3975                                                 ,error-status:get-message(1)
     3976                                                 ,return-value
     3977                                                 ,(if buf_temp-cmd.db-list = '':u then '':u else substitute(" - БД № &1", buf_temp-cmd.db-list))
     3978                                                 ).
     3979         end.
     3980       delete procedure v-cmd-proc-handle .
     3981     end.
     3982   end.
     3983   if not p-process = 'sale-xml-import':U and (g#db-num = 0 and p-save) AND can-find(first dc-list NO-LOCK)  then do:
     3984     run str/diallog.w (
     3985                     input parparentproc
     3986                   , input this-procedure
     3987                   , input 'str/sendclia.p':U
     3988                   , input(string(g#db-num) + chr(4)  + chr(4) + "no":U + chr(4) + "S":U)
     3989                   , input yes
     3990                   , input '':U
     3991                   , input 'Отправка информации по клиентским картам на кассу') no-error .
     3992   end.
     3993   procedure fill-for-dcpcuq :
     3994   define input parameter p-doc-code as character no-undo .
     3995   define input parameter p-d-card as character no-undo .
     3996   define variable v-tbl-row as rowid no-undo .
     3997   define variable v-tbl-name as character no-undo .
     3998   define variable v-num-dc as integer no-undo .
     3999   define variable v-ii as integer no-undo .
     4000   define variable v-create-chr as character no-undo .
     4001   define variable v-current-d-card as character no-undo .
     4002   define buffer buf_dis-card for ub.dis-card.
     4003   define buffer buf_dis-card-type for ub.dis-card-type.
     4004   main-block:
     4005   do
     4006   on error undo, return error
     4007   :
     4008     run gen-row-keyr in this-procedure
     4009       ( input p-doc-code
     4010        ,input ?
     4011        ,input "ub"
     4012        ,input ?
     4013        ,input NO-LOCK
     4014        ,output v-tbl-row
     4015        ,output v-tbl-name
     4016       ) no-error.
     4017     find first buf_Dis-card-type no-lock where
     4018               rowid(buf_dis-card-type) = v-tbl-row no-error.
     4019     if not available buf_dis-card-type then do:
     4020       message
     4021         vss-workfile vss-revision vss-description skip
     4022         "Ошибка задания входных параметров" skip
     4023         "Не найден ТИП ДК" p-doc-code skip
     4024         view-as alert-box error .
     4025       undo main-block, return error .
     4026     end.
     4027     _dis-card:
     4028     for each buf_dis-card no-lock where
     4029             buf_dis-card.type              =  buf_Dis-card-type.type
     4030         and buf_dis-card.emitent-host-code =  buf_dis-card-type.emitent-host-code
     4031         and buf_dis-card.d-card > p-d-card
     4032     by buf_dis-card.d-card
     4033     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4034     :
     4035       if v-create-chr <> '*':U then do:
     4036         run is-to-create-d-card in p-parent-handle ( input buf_dis-card.d-card, output v-create-chr) no-error.
     4037         if error-status:error then do:
     4038           undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4039         end.
     4040         if v-create-chr = "*"  then do:
     4041           assign
     4042           v-dc-list-mode = "*".
     4043         end.
     4044         else if v-create-chr = 'no' then do:
     4045           v-create-chr = '':U.
     4046           next _dis-card.
     4047         end.
     4048       end.
     4049       v-ii = v-ii + 1.
     4050       create temp-d-card.
     4051       buffer-copy buf_dis-card to temp-d-card
     4052       assign
     4053       temp-d-card.sale-type = 'recalc':U
     4054       v-current-d-card = buf_dis-card.d-card.
     4055       if v-ii = 50 then do:
     4056         run set-current-d-card in p-parent-handle  ( input temp-d-card.d-card).
     4057         release temp-d-card.
     4058         leave _dis-card.
     4059       end.
     4060     end.
     4061     run str/lock-dc.p ( input ?
     4062                       ,input this-procedure:handle
     4063                       ,input 'dis-card-type':U
     4064                       ,input p-doc-code
     4065                       ,input p-d-card
     4066                       ,input 1
     4067                       ,input no
     4068                       ,input '':U
     4069                       ,output v-num-dc) no-error.
     4070     if error-status:error then do:
     4071       undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4072     end.
     4073     find first buf_Dis-card no-lock where
     4074               buf_Dis-card.type = buf_dis-card-type.type
     4075           and buf_Dis-card.emitent-host-code = buf_dis-card-type.emitent-host-code
     4076           and buf_Dis-card.d-card > v-current-d-card no-error.
     4077     if not available buf_Dis-card then do:
     4078       run set-current-d-card in p-parent-handle  ( input "z").
     4079     end.
     4080   end.
     4081   end procedure.
     4082   procedure fill-for-dcardi :
     4083   define input parameter p-d-card as character no-undo .
     4084   define buffer buf_dis-card for ub.dis-card.
     4085   define variable v-num-dc as integer no-undo .
     4086   main-block:
     4087   do
     4088   on error undo, return error
     4089   :
     4090     find first buf_dis-card no-lock where
     4091          buf_dis-card.d-card = p-d-card no-error.
     4092     if not available buf_dis-card then do:
     4093        return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4094     end.
     4095     if p-process = 'one-card-check':U then do:
     4096       create temp-d-card.
     4097       buffer-copy buf_dis-card
     4098       except type
     4099       emitent-host-code
     4100       to temp-d-card
     4101       assign
     4102       temp-d-card.type = v-type
     4103       temp-d-card.emitent-host-code = v-emitent-host-code
     4104       temp-d-card.sale-type = 'recalc':U
     4105       .
     4106     end.
     4107     if p-process = 'one-card-add':U then do:
     4108       create temp-d-card.
     4109       buffer-copy buf_dis-card
     4110       to temp-d-card
     4111       assign
     4112       temp-d-card.sale-type = 'recalc':U
     4113       .
     4114     end.
     4115     run str/lock-dc.p ( input ?
     4116                       ,input this-procedure:handle
     4117                       ,input 'dis-card':U
     4118                       ,input p-doc-code
     4119                       ,input temp-d-card.d-card
     4120                       ,input 1
     4121                       ,input no
     4122                       ,input '':U
     4123                       ,output v-num-dc) no-error.
     4124     if error-status:error then do:
     4125       undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4126     end.
     4127     release temp-d-card.
     4128   end.
     4129   end procedure.
     4130   procedure is-to-lock-d-card :
     4131   define input parameter p-d-card as character no-undo .
     4132   define output parameter p-lock-chr as character no-undo .
     4133   do
     4134   on error undo, return error
     4135   :
     4136     if v-dc-list-mode = "*":U then do:
     4137       p-lock-chr = "*".
     4138     end.
     4139     else do:
     4140       find first temp-d-card no-lock where
     4141                 temp-d-card.d-card = p-d-card no-error.
     4142       if not available temp-d-card then do:
     4143         p-lock-chr = string(no).
     4144       end.
     4145       else do:
     4146         p-lock-chr = string(yes).
     4147       end.
     4148     end.
     4149   end.
     4150   end procedure.
     4151   procedure set-num-rec :
     4152   define input parameter p-num-rec as integer no-undo .
     4153   define input parameter p-num-rec-calc-err as integer no-undo .
     4154   define input parameter p-num-rec-value-err as integer no-undo .
     4155   define input parameter p-num-rec-ok as integer no-undo .
     4156   define input parameter p-display as logical no-undo .
     4157   define variable v-ok as logical no-undo .
     4158   do
     4159   on error undo, return error
     4160   :
     4161     if not (p-process = 'batch-card-recalc':U) then do:
     4162       return.
     4163     end.
     4164     run set-num-rec in p-parent-handle ( input p-num-rec
     4165                                         ,input p-num-rec-calc-err
     4166                                         ,input p-num-rec-value-err
     4167                                         ,input p-num-rec-ok
     4168                                         ,buffer buf_rule-by-call
     4169                                         ,input p-display
     4170                                         ).
     4171   end.
     4172   end procedure.
     4173   procedure create-temp-d-card :
     4174   define input parameter p-bh as handle no-undo .
     4175   define variable glog as logical no-undo .
     4176   define variable v-num-dc as integer no-undo .
     4177   define buffer buf_temp-d-card for temp-d-card.
     4178   main-block:
     4179   do
     4180   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4181   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4182   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4183   :
     4184       find first buf_temp-d-card where
     4185               buf_temp-d-card.d-card = p-bh::d-card
     4186           and buf_temp-d-card.obj-type = p-bh::obj-type
     4187           and buf_temp-d-card.obj-code = p-bh::obj-code no-error .
     4188       if not available buf_temp-d-card then do:
     4189         create buf_temp-d-card.
     4190         glog = buffer buf_temp-d-card:handle:buffer-copy( p-bh) no-error .
     4191         if error-status:error
     4192         or not glog
     4193         then do:
     4194           undo main-block, return error substitute("&1&2&3"
     4195                                                    , error-status:get-message(1)
     4196                                                    , chr(10)
     4197                                                    , return-value ).
     4198         end.
     4199         run str/lock-dc.p ( input ?
     4200                           ,input this-procedure:handle
     4201                           ,input 'dis-card':U
     4202                           ,input buf_temp-d-card.d-card
     4203                           ,input '':U
     4204                           ,input 1
     4205                           ,input no
     4206                           ,input '':U
     4207                           ,output v-num-dc) no-error.
     4208         if error-status:error then do:
     4209           undo main-block, return error substitute("&1&2&3"
     4210                                                    , error-status:get-message(1)
     4211                                                    , chr(10)
     4212                                                    , return-value ).
     4213         end.
     4214       end.
     4215   end.
     4216   end procedure.
     4217   procedure reset-context :
     4218   define input parameter p-obj-type as character no-undo .
     4219   define input parameter p-obj-code as integer no-undo .
     4220   define input parameter p-doc-code as character no-undo .
     4221   define input parameter p-doc-date as date no-undo .
     4222   define input parameter p-doc-type as character no-undo .
     4223   do
     4224   on error undo, return error
     4225   :
     4226     assign
     4227     v-obj-type = p-obj-type
     4228     v-obj-code = p-obj-code
     4229     v-doc-date = p-doc-date
     4230     v-fact-date = v-today
     4231     v-doc-type = p-doc-type
     4232     v-doc-code = p-doc-code
     4233     .
     4234     if v-obj-type = 'маг':U
     4235     or v-obj-type = 'скл':U then do:
     4236   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4238     (input  v-obj-type
     4239     ,input  v-obj-code
     4240     ,output v-host-code
     4241     )  .
     4242     end.
     4243   end.
     4244   end procedure.
     4245   procedure set-stop-leave-status :
     4246   define input parameter p-stop-leave-status as character no-undo .
     4247   do
     4248   on error undo, return error
     4249   :
     4250     assign
     4251     v-stop-leave-status = p-stop-leave-status.
     4252   end.
     4253   end procedure.
     4254   procedure before-command :
     4255   define parameter buffer buf_temp-cmd for temp-cmd.
     4256   main-block:
     4257   do
     4258   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4259   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4260   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4261   :
     4262     for each buf_temp-cmd:
     4263       delete buf_temp-cmd.
     4264     end.
     4265     for each buf_temp-smart-route:
     4266       delete buf_temp-smart-route.
     4267     end.
     4268     for each buf_temp-smart-link:
     4269       delete buf_temp-smart-link.
     4270     end.
     4271     for each buf_temp-nws-outline:
     4272       delete buf_temp-nws-outline.
     4273     end.
     4274     for each buf_temp-no-route:
     4275       delete buf_temp-no-route.
     4276     end.
     4277     if p-save then do:
     4278       if g#db-num = 0 then do:
     4279         create buf_temp-cmd.
     4280         assign
     4281         buf_temp-cmd.db-list = string( -1)
     4282         .
     4283         for each buf_db no-lock:
     4284           if buf_db.db-num = 0 then next.
     4285           create buf_temp-cmd.
     4286           assign
     4287           buf_temp-cmd.db-list = string(buf_db.db-num)
     4288           .
     4289         end.
     4290       end.
     4291       else do:
     4292         create buf_temp-cmd.
     4293         assign
     4294         buf_temp-cmd.db-list = string(0)
     4295         .
     4296       end.
     4297       for each buf_temp-cmd:
     4298         run begin-create-command in v-cmd-proc-handle
     4299           (input  v-command
     4300           ,INPUT  buf_temp-cmd.db-list
     4301           ,output buf_temp-cmd.cmd-code
     4302           ) no-error.
     4303         if error-status :error
     4304         then do:
     4305           undo,  return error substitute("&1 &2 &3&4Ошибка при создании команды &5&4" +
     4306                                               "&6&4&7"
     4307                                               ,vss-workfile
     4308                                               ,vss-revision
     4309                                               ,vss-description
     4310                                               ,chr(10)
     4311                                               ,'cmd-process-saledc':U
     4312                                               ,error-status:get-message(1)
     4313                                               ,return-value ).
     4314         end.
     4315       end.
     4316       find first buf_temp-cmd use-index pi.
     4317     end.
     4318   end.
     4319   end procedure.
     4320   procedure after-command :
     4321   define parameter buffer buf_temp-cmd for temp-cmd.
     4322   _main:
     4323   do transaction
     4324   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4325   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4326   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4327   :
     4328   if p-save and (not mode-erprn or p-process = 'one-card-add':U) then do:
     4329     run create-nws-outline in this-procedure (
     4330                                                 input v-cmd-proc-handle
     4331                                               ,input buf_temp-cmd.cmd-code
     4332                                               ,input 'dis-card-type':U
     4333                                               ,input v-charkey_one
     4334                                               ,input '':U
     4335                                               ,input '':U
     4336                                               ,input 0
     4337                                               ,input 0
     4338                                               ,input 0
     4339                                               ).
     4340   end.
     4341   if no then do:
     4342     run perproc-delete-from-parent  in this-procedure (
     4343                                                         input this-procedure:handle
     4344                                                         ,input '':U  ).
     4345   end.
     4346   if p-save and (not mode-erprn or p-process = 'one-card-add':U) then do:
     4347     if g#db-num = 0 then do:
     4348       find first buf1_temp-cmd where buf1_temp-cmd.db-list = string(-1).
     4349     end.
     4350     _temp-cmd:
     4351     for each buf_temp-cmd
     4352     on error undo _main, return error :
     4353       if buf_temp-cmd.db-list = string(-1) then next _temp-cmd.
     4354       if g#db-num = 0 then do:
     4355         for each buf_temp-smart-link ,
     4356         first buf_temp-smart-route
     4357         where buf_temp-smart-route.key-field = buf_temp-smart-link.key-field
     4358           and (buf_temp-smart-link.is-smart = no
     4359                 or buf_temp-smart-route.db-num = integer(buf_temp-cmd.db-list))
     4360         by buf_temp-smart-link.rec-ord:
     4361           find first buf_temp-no-route where
     4362                       buf_temp-no-route.db-num = integer(buf_temp-cmd.db-list)
     4363                   and buf_temp-no-route.rec-ord = buf_temp-smart-link.rec-ord no-error .
     4364           if not available buf_temp-no-route then do:
     4365                                                               run copy-dump in v-cmd-proc-handle                                                                           (input buf1_temp-cmd.cmd-code                                                                                         ,input buf_temp-cmd.cmd-code                                                                                          ,input buf_temp-smart-link.rec-ord                                                                                    ,input buf_temp-smart-link.uniq-key-rec                                                                                    ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при копировании записи &5 из команды с кодом &6 в команду с кодом &7&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,buf_temp-smart-link.uniq-key-rec                                                                                           ,buf1_temp-cmd.cmd-code                                                                                           ,buf_temp-cmd.cmd-code                                                                                           ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     4366           end.
     4367           else do:
     4368             delete buf_temp-no-route.
     4369           end.
     4370         end.
     4371         for each buf_temp-smart-route where
     4372                 buf_temp-smart-route.db-num = integer(buf_temp-cmd.db-list):
     4373           delete buf_temp-smart-route.
     4374         end.
     4375         v-is-empty = no.
     4376       end.
     4377       if not v-is-empty then do:
     4378         run send-command in v-cmd-proc-handle
     4379           ( input buf_temp-cmd.cmd-code
     4380             ,input buf_temp-cmd.db-list
     4381             ) no-error .
     4382         if error-status :error then do:
     4383           undo _main, return error substitute("&1 &2 &3&4Ошибка при отправке в новости команды с кодом &5 &8&4" +
     4384                                               "&6&4&7"
     4385                                               ,vss-workfile
     4386                                               ,vss-revision
     4387                                               ,vss-description
     4388                                               ,chr(10)
     4389                                               ,v-cmd-code
     4390                                               ,error-status:get-message(1)
     4391                                               ,return-value
     4392                                               ,(if buf_temp-cmd.db-list = '':u then '':u else substitute(" - БД № &1", buf_temp-cmd.db-list))
     4393                                               ).
     4394         end.
     4395       end.
     4396     end.
     4397   end.
     4398   end.
     4399   end procedure.
     4400   procedure cb_create-dc-list :
     4401   define input parameter p-bh as handle no-undo .
     4402   define variable v-dch as handle no-undo .
     4403     do
     4404     on error undo, return error return-value
     4405     :
     4406       if not g#news then do:
     4407         find first dc-list where
     4408                   dc-list.d-card = p-bh::d-card no-error .
     4409         if not available dc-list then do:
     4410           create dc-list.
     4411         end.
     4412         v-dch = buffer dc-list:handle.
     4413         v-dch:buffer-copy(p-bh).
     4414         v-dch:buffer-release().
     4415       end.
     4416     end.
     4417   end procedure.
