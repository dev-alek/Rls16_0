     3059   define variable v-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     3060   DEFINE VARIABLE accumdl-sum-rubl as decimal no-undo .
     3061   DEFINE VARIABLE accumdl-sum-base as decimal no-undo .
     3062   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3063   if v-cntxt-db-num = 0 then do:
     3064     FOR EACH buf_doc-line no-lock where
     3065             buf_doc-line.doc-code = p-doc-code
     3066        On error undo _main, return error:
     3067       run r-sale in this-procedure (
     3068                                       input p-doc-code
     3069                                      ,input buf_doc-line.artic
     3070                                      ,input buf_doc-line.prod-type
     3071                                      ,input buf_doc-line.prod-code
     3072                                      ,output v-fact-qnty
     3073                                      ,output v-vat-pc
     3074                                      ,output v-slt-pc
     3075                                      ,output v-sum-base
     3076                                      ,output v-sum-rubl
     3077                                      ,output v-vat-base
     3078                                      ,output v-vat-rubl
     3079                                      ,output v-slt-base
     3080                                      ,output v-slt-rubl
     3081                                      ,output v-road-tax-base
     3082                                      ,output v-road-tax-rubl
