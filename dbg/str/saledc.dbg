     3044   define variable v-vat-pc            like ub.doc-line.vat-pc         no-undo .
     3045   define variable v-slt-pc            like ub.doc-line.slt-pc         no-undo .
     3046   define variable v-sum-base          like ub.ot-line.sum-base        no-undo .
     3047   define variable v-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     3048   define variable v-vat-base          like ub.ot-line.vat-base        no-undo .
     3049   define variable v-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     3050   define variable v-slt-base          like ub.ot-line.slt-base        no-undo .
