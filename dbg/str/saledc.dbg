     3115                                      ,output v-transport-rubl
     3116                                      ,output v-other-base
     3117                                      ,output v-other-rubl
     3118                                      ,output v-excise-base
     3119                                      ,output v-excise-rubl
     3120                                       ) .
     3121       assign
     3122       temp-d-card.gds-tot-r0 = temp-d-card.gds-tot-r0 + sign * abs( v-sum-rubl)
     3123       temp-d-card.gds-tot-b0 = temp-d-card.gds-tot-b0 + sign * abs( v-sum-base)
     3124       .
     3125     END.
     3126   end.
     3127   if v-curr-r-b = 'base':U then
     3128   assign
     3129   temp-d-card.gds-tot-r-b = temp-d-card.gds-tot-base
     3130   temp-d-card.gds-dis-r-b = temp-d-card.gds-dis-base
