     1316       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1317       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
     1318       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     1319       define variable varis-one-gds-dtl        as   logical                             no-undo.
     1320       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
     1321       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
     1322       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     1323       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     1324       define variable varoutvprb               as   character                           no-undo.
     1325       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
