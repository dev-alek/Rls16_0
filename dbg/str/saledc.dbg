     3671       when 'trn-doc-close':U
     3672       or
     3673       when 'trn-doc-delete':U then do:
     3674         v-command = 'cmd-process-saledc':U + chr(6) +
     3675                     string(p-step) + chr(6) +
     3676                     string(g#db-num)             + chr(6) +
     3677                     bf_trn-doc.obj-type + chr(6) +
