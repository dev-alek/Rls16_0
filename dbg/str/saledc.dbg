     1256     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
     1257     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
     1258     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
     1259     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
     1260     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
     1261     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     1262     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
     1263     do
     1264     on error undo, return error
     1265     :
