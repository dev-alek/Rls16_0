     1637       assign
     1638               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1639               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1640        .
     1641     end.
     1642   end.
     1643   assign
     1644   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1645   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1646               ASSIGN
     1647                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1648                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1649                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1650                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1651                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1652                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1653                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1654                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1655                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1656                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1657                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1658                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1659                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1660               .
     1661           end.
     1662       end.
     1663       assign
     1664           p-transport-base      = 0
     1665           p-transport-rubl      = 0
     1666           p-vat-pc              = buf_doc-line.vat-pc
     1667           p-slt-pc              = buf_doc-line.slt-pc
     1668       .
     1669     end.
     1670     if p-fact-qnty      = ?
     1671     or p-vat-pc         = ?
     1672     or p-slt-pc         = ?
     1673     or p-sum-base       = ?
     1674     or p-sum-rubl       = ?
     1675     or p-vat-base       = ?
     1676     or p-vat-rubl       = ?
     1677     or p-slt-base       = ?
     1678     or p-slt-rubl       = ?
     1679     or p-road-tax-base  = ?
     1680     or p-road-tax-rubl  = ?
     1681     or p-transport-base = ?
     1682     or p-transport-rubl = ?
     1683     or p-other-base     = ?
     1684     or p-other-rubl     = ?
     1685     or p-excise-base    = ?
     1686     or p-excise-rubl    = ?
     1687     then do:
     1688       message
     1689         vss-workfile vss-revision vss-description skip
     1690         vss-include-info12 skip
     1691         "Получены неопределенные значения" skip
     1692         "Документ" p-doc-code skip
     1693         "Артикул" p-artic p-prod-type p-prod-code skip
     1694         "fact-qnty     " p-fact-qnty      skip
     1695         "vat-pc        " p-vat-pc         skip
     1696         "slt-pc        " p-slt-pc         skip
     1697         "sum-base      " p-sum-base       skip
     1698         "sum-rubl      " p-sum-rubl       skip
     1699         "vat-base      " p-vat-base       skip
     1700         "vat-rubl      " p-vat-rubl       skip
     1701         "slt-base      " p-slt-base       skip
     1702         "slt-rubl      " p-slt-rubl       skip
     1703         "road-tax-base " p-road-tax-base  skip
     1704         "road-tax-rubl " p-road-tax-rubl  skip
     1705         "transport-base" p-transport-base skip
     1706         "transport-rubl" p-transport-rubl skip
     1707         "other-base    " p-other-base     skip
     1708         "other-rubl    " p-other-rubl     skip
     1709         "excise-base   " p-excise-base    skip
     1710         "excise-rubl   " p-excise-rubl    skip
     1711         view-as alert-box error .
     1712       undo, return error .
     1713     end.
     1714   end procedure.
     1715   define variable vss-include-info16 as character format "X(65)" no-undo
     1716   initial "@(#)$Workfile$ $Revision$".
     1717   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1718   procedure r-cost :
     1719     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1720     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1721     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1722     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1723     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1724     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1725     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1726     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1727     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1728     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1729     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1730     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1731     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1732     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1733     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1734     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1735     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1736     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1737     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1738     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1739     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1740     do
     1741     on error undo, return error
     1742     :
     1743       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1744       define buffer   in-vatp-parts    for ub.parts   .
     1745       define buffer   in-vatp-doc      for ub.trn-doc .
     1746       define buffer   in-vatp-goods    for ub.goods   .
     1747       define buffer   in-vatp-sysconf  for ub.sysconf .
     1748       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1749       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1750       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1751       define variable varinvprb                  as   character              no-undo.
     1752       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1753       define variable cli-base-rate              as   decimal                no-undo.
     1754       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1755       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1756       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1757       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1758       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1759       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1760       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1761       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1762       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1763       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1764       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1765       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1766       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1767       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1768       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1769       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1770       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1771       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1772       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1773       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1774       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1775       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1776       define variable varinvatp-envd             as   character              no-undo.
     1777       define variable varinvatp-type             as   character              no-undo.
     1778       def var v-parts-fact-qnty as decimal   no-undo .
     1779       define buffer buf_parts    for ub.parts    .
     1780       define buffer buf_goods    for ub.goods    .
     1781       define buffer buf_trn-doc  for ub.trn-doc  .
     1782       define buffer buf_doc-line for ub.doc-line .
     1783       find first buf_doc-line no-lock
     1784         where buf_doc-line.doc-code  = v-doc-code
     1785           and buf_doc-line.artic     = v-artic
     1786           and buf_doc-line.prod-type = v-prod-type
     1787           and buf_doc-line.prod-code = v-prod-code
     1788         no-error .
     1789       if not available buf_doc-line then do:
     1790         message
     1791           vss-workfile vss-revision vss-description skip
     1792           vss-include-info17 skip
     1793           "Ошибка задания входных параметров" skip
     1794           "Не найдена строка документа"  skip
     1795           "Документ" v-doc-code skip
     1796           "Артикул" v-artic v-prod-type v-prod-code skip
     1797           view-as alert-box error .
     1798         return error .
     1799       end.
     1800       find first buf_trn-doc no-lock
     1801         where buf_trn-doc.doc-code = v-doc-code
     1802         no-error .
     1803       if not available buf_trn-doc then do:
     1804         message
     1805           vss-workfile vss-revision vss-description skip
     1806           vss-include-info17 skip
     1807           "Ошибка задания входных параметров" skip
     1808           "Не найден документ" skip
     1809           "Документ" v-doc-code skip
     1810           "Артикул" v-artic v-prod-type v-prod-code skip
     1811           view-as alert-box error .
     1812         undo, return error .
     1813       end.
     1814       find first buf_goods no-lock
     1815         where buf_goods.artic     = buf_doc-line.artic
     1816           and buf_goods.prod-type = buf_doc-line.prod-type
     1817           and buf_goods.prod-code = buf_doc-line.prod-code
     1818         no-error .
     1819       if not available buf_goods then do:
     1820         message
     1821           vss-workfile vss-revision vss-description skip
     1822           vss-include-info17 skip
     1823           "Ошибка задания входных параметров" skip
     1824           "Не найден товар" skip
     1825           "Документ" v-doc-code skip
     1826           "Артикул" v-artic v-prod-type v-prod-code skip
     1827           view-as alert-box error .
     1828         undo, return error .
     1829       end.
     1830       if buf_goods.gds-type = 'т':U then do:
     1831             for each buf_parts no-lock
     1832               where buf_parts.out-code  = buf_trn-doc.doc-code
     1833                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1834                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1835                 and buf_parts.artic     = buf_doc-line.artic
     1836                 and buf_parts.prod-type = buf_doc-line.prod-type
     1837                 and buf_parts.prod-code = buf_doc-line.prod-code
     1838             on error undo, return error
     1839             :
     1840   assign
     1841     price-rubl-with-tax-loc = buf_parts.price-rubl
     1842     price-base-with-tax-loc = buf_parts.price-base
     1843   .
     1844   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1846     (output varinvprb
     1847     )  .
     1848     if buf_parts.out-code = 'free-zone':U     or
     1849        buf_parts.out-code = 'out-zone':U   or
     1850        buf_parts.doc-type = 'акт':U then do:
     1851       assign
     1852         in-vatp-have-vat-slt = yes.
     1853     end.
     1854     else do:
     1855       find first in-vatp_doc-attr no-lock
     1856         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1857           and in-vatp_doc-attr.attr-code = 'envd':U
     1858         no-error .
     1859       if not available in-vatp_doc-attr then do:
     1860         assign
     1861           in-vatp-have-vat-slt = yes.
     1862       end.
     1863       else do:
     1864            in-vatp-have-vat-slt = no.
     1865       end.
     1866     end.
     1867     assign
     1868      price-cli-with-tax-loc = buf_parts.price-cli
     1869      cli-base-rate          = buf_parts.cli-base-rate.
     1870     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1871              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1872     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1873             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1874             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1875             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1876             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1877             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1878             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1879       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1880     assign
     1881       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1882     assign
     1883       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1884       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1885       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1886       transport-cli-loc  = 0
     1887       other-cli-loc      = 0
     1888     .
     1889   ASSIGN
     1890             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1891       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1892   .
     1893               assign
     1894                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     1895                                       or buf_trn-doc.doc-type = 'возврат':U
     1896                                       or buf_trn-doc.doc-type = 'инв':U
     1897                                       then buf_parts.fact-qnty
     1898                                       else - buf_parts.fact-qnty
     1899                                      )
     1900               .
     1901               assign
     1902                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1903                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1904                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1905                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     1906                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     1907                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     1908                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     1909                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     1910                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1911                 v-excise-base         =   0
     1912                 v-excise-rubl         =   0
     1913                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1914                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1915                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1916                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1917               .
     1918           end.
     1919   assign
     1920     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1921     price-base-with-tax-loc = buf_doc-line.price-base
     1922   .
     1923   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
