     2750     if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _cards.
     2751       find first temp-d-card where
     2752                 temp-d-card.d-card = ub.chk-doc.d-card
     2753             AND temp-d-card.obj-type = ub.chk-doc.obj-type
     2754             AND temp-d-card.obj-code = ub.chk-doc.obj-code  no-error .
     2755       if not available temp-d-card then do:
     2756         find first ub.dis-card no-lock
     2757           where ub.dis-card.d-card = ub.chk-doc.d-card
     2758           no-error .
     2759         if not avail dis-card then do:
     2760           next _cards.
     2761         end.
     2762         FIND FIRST ub.clients WHERE
     2763                     ub.clients.obj-type = ub.dis-card.cli-type AND
     2764                     ub.clients.obj-code = ub.dis-card.cli-code No-ERROR.
     2765         if not avail ub.clients then do:
     2766           undo _main, return error "Не найден клиент для дисконтной карты " + ub.dis-card.d-card.
     2767         end.
     2768         assign
     2769           ub.clients.buy-gds = ub.clients.buy-gds OR ( NOT buf_inkas.office )
     2770           ub.clients.buy-serv = ub.clients.buy-serv OR buf_inkas.office
     2771         .
     2772         create temp-d-card.
     2773         assign
     2774         temp-d-card.d-card = ub.chk-doc.d-card
     2775         temp-d-card.pay-tot-base = 0
     2776         temp-d-card.pay-tot-rubl = 0
     2777         temp-d-card.gds-tot-b0 = 0
     2778         temp-d-card.gds-tot-r0 = 0
     2779         temp-d-card.first-main-card   = ub.dis-card.first-main-card
     2780         temp-d-card.main-card         = ub.dis-card.main-card
     2781         temp-d-card.first-card        = ub.dis-card.first-card
     2782         temp-d-card.cli-type          = ub.dis-card.cli-type
     2783         temp-d-card.cli-code          = ub.dis-card.cli-code
     2784         temp-d-card.card-num          = ub.dis-card.card-num
     2785         temp-d-card.emitent-host-code = ub.dis-card.emitent-host-code
     2786         temp-d-card.type              = ub.dis-card.type
     2787         temp-d-card.obj-type          = ub.chk-doc.obj-type
     2788         temp-d-card.obj-code          = ub.chk-doc.obj-code
     2789         temp-d-card.host-code         = buf_inkas.host-code
     2790         temp-d-card.sale-doc          = buf_inkas.inkas-code
     2791         temp-d-card.sale-type         = 'inkas':U
     2792         temp-d-card.doc-date          = ub.chk-doc.chk-date
     2793         temp-d-card.action            = sign
     2794         .
     2795       end.
     2796       FOR EACH ub.chk-gds WHERE
     2797                 ub.chk-gds.doc-code = ub.chk-doc.doc-code AND
     2798                 ub.chk-gds.b-code <> 0 NO-LOCK ,
     2799           FIRST ub.bar-code where
     2800                 ub.bar-code.b-code = ub.chk-gds.b-code No-LOCK,
     2801           FIRST ub.goods where
     2802                 ub.goods.gds-code = ub.bar-code.gds-code No-LOCK,
     2803           FIRST ub.doc-line WHERE
     2804                 ub.doc-line.doc-code = (if ub.chk-doc.netto >= 0 then buf_trn-doc.doc-code else ret-doc-code) AND
     2805                 ub.doc-line.prod-code = ub.goods.prod-code AND
     2806                 ub.doc-line.prod-type = ub.goods.prod-type AND
     2807                 ub.doc-line.artic = ub.goods.artic NO-LOCK
     2808                 On error undo _main, return error
     2809                 :
     2810         if ub.chk-gds.write-off-code <> ?
     2811         and ub.chk-gds.write-off-code > 0 then NEXT.
     2812         assign
     2813         temp-d-card.gds-tot-r0 = temp-d-card.gds-tot-r0 +  sign * ( ub.doc-line.price-rubl * ub.chk-gds.doc-qnty )
     2814         temp-d-card.gds-tot-b0 = temp-d-card.gds-tot-b0 +  sign * ( ub.doc-line.price-base * ub.chk-gds.doc-qnty )
     2815         .
     2816       END.
     2817       assign
     2818       accum-tot-base = 0
     2819       accum-tot-rubl = 0
     2820       accum-cre-pay-base =0
     2821       accum-cre-pay-rubl =0
     2822       .
     2823       FOR EACH ub.chk-pay WHERE
     2824                ub.chk-pay.doc-code = ub.chk-doc.doc-code NO-LOCK
     2825       On error undo _main, return error
     2826       :
     2827           if ub.chk-pay.pay-code = cre-pay
     2828             then
     2829           assign
     2830           cre-pay-base = ub.chk-pay.tot-base
     2831           cre-pay-rubl   = ub.chk-pay.tot-rubl .
     2832             else
     2833           assign
     2834           cre-pay-base = 0
     2835           cre-pay-rubl   = 0 .
     2836           Assign
     2837           accum-tot-rubl     = accum-tot-rubl +  ub.chk-pay.tot-rubl
     2838           accum-tot-base     = accum-tot-base +  ub.chk-pay.tot-base
     2839           accum-cre-pay-base = accum-cre-pay-base +  cre-pay-base
     2840           accum-cre-pay-rubl = accum-cre-pay-rubl +  cre-pay-rubl
     2841           .
     2842           if v-cntxt-db-num = 0 and ub.chk-pay.pay-code <> cre-pay then do:
     2843             FIND FIRST vchk-pay No-LOCK WHERE
     2844                         vchk-pay.d-card = ub.chk-doc.d-card AND
     2845                         vchk-pay.pay-code = ub.chk-pay.pay-code AND
     2846                         vchk-pay.curr-code = ub.chk-pay.curr-code AND
     2847                         vchk-pay.doc-date = ub.chk-pay.chk-date AND
     2848                         vchk-pay.cre-pay = (ub.chk-pay.pay-code = cre-pay) AND
     2849                         vchk-pay.exch-rate = (ub.chk-pay.tot-sum / chk-pay.tot-rubl) AND
     2850                       vchk-pay.base-rate = (ub.chk-pay.tot-rubl / chk-pay.tot-base ) No-ERROR.
     2851             IF NOT AVAIL vchk-pay then do:
     2852               create vchk-pay.
     2853               assign
     2854               vchk-pay.d-card   = ub.chk-doc.d-card
     2855               vchk-pay.doc-date = ub.chk-pay.chk-date
     2856               vchk-pay.pay-code = ub.chk-pay.pay-code
     2857               vchk-pay.curr-code = ub.chk-pay.curr-code
     2858               vchk-pay.cre-pay = (ub.chk-pay.pay-code = cre-pay)
     2859               vchk-pay.exch-rate =  (ub.chk-pay.tot-sum / ub.chk-pay.tot-rubl)
     2860               vchk-pay.base-rate = (ub.chk-pay.tot-rubl / ub.chk-pay.tot-base)
     2861               .
     2862             end.
     2863             assign
     2864             vchk-pay.tot-sum  = vchk-pay.tot-sum  + ub.chk-pay.tot-sum
     2865             vchk-pay.tot-base = vchk-pay.tot-base + ub.chk-pay.tot-base
     2866             vchk-pay.tot-rubl = vchk-pay.tot-rubl + ub.chk-pay.tot-rubl
     2867             .
     2868         END.
     2869       END .
     2870       assign
     2871       temp-d-card.pay-tot-base = temp-d-card.pay-tot-base + sign * (ACCUM-tot-base -  ACCUM-cre-pay-base)
     2872       temp-d-card.pay-tot-rubl = temp-d-card.pay-tot-rubl + sign * (ACCUM-tot-rubl -  ACCUM-cre-pay-rubl)
     2873       .
     2874       if v-base-code = 0 then
     2875       chk-exch =  1.
     2876       else do:
     2877         v-rate = ?.
     2878         if v-curr-r-b = 'base':U then do:
     2879           assign
     2880           v-rate = ub.chk-doc.cash-rate / ub.chk-doc.cash-scale
     2881           no-error
     2882           .
     2883           if v-rate <> 0
     2884           and v-rate <> ? then do:
     2885             chk-exch = v-rate.
     2886           end.
     2887           else do:
     2888             assign
     2889             v-rate = ACCUM-tot-rubl  / ACCUM-tot-base
     2890             no-error
     2891             .
     2892             if v-rate <> ?
     2893             and v-rate <> 0 then do:
     2894               chk-exch = v-rate.
     2895             end.
