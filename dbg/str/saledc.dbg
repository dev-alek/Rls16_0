     3625         release temp-d-card.
     3626       end.
     3627       otherwise do:
     3628         undo _main, return error substitute("&1 &2 &3&4Ошибка входных параметров процедуры saledc.p&4Невернoе значение p-process = &5"
     3629                                             ,vss-workfile
     3630                                             ,vss-revision
     3631                                             ,vss-description
     3632                                             ,chr(10)
     3633                                             ,p-process
     3634                                              ).
     3635       end.
     3636     END CASE.
     3637     if p-save then do:
     3638       if not valid-handle(v-cmd-proc-handle ) then dO:
     3639         run nws/cmd-bush.p persistent set v-cmd-proc-handle no-error .
     3640         if error-status :error
     3641         then do:
     3642           delete procedure v-cmd-proc-handle .
     3643           undo _main, return error substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     3644                                               "&5&4&6"
     3645                                               ,vss-workfile
     3646                                               ,vss-revision
     3647                                               ,vss-description
     3648                                               ,chr(10)
     3649                                               ,error-status:get-message(1)
     3650                                               ,return-value ).
     3651         end.
     3652       end.
     3653     end.
     3654     CASE p-process:
     3655       when 'sale-close':U
     3656       or
     3657       when 'sale-delete':U then do:
     3658         v-command = 'cmd-process-saledc':U + chr(6) +
     3659                     string(p-step) + chr(6) +
     3660                     string(g#db-num)             + chr(6) +
     3661                     buf_inkas.obj-type + chr(6) +
