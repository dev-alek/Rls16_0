     3766                     (if v-fact-date = ? then chr(63) else string(v-fact-date)) + chr(6) +
     3767                     string(par-sign) + chr(6) +
     3768                     string(cre-pay).
     3769       end.
     3770       otherwise do:
     3771       end.
     3772     END CASE.
     3773     run before-command in this-procedure ( buffer buf_temp-cmd ) no-error.
     3774     if error-status:error then do:
     3775           delete procedure v-cmd-proc-handle .
     3776           undo _main, return error substitute("&1 &2 &3&4Ошибка при создании команды &5&4" +
