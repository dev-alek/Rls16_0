     1247     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
     1248     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
     1249     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     1250     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
     1251     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     1252     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
