     2187   define variable accum-tot-base     like ub.chk-pay.tot-rubl  no-undo .
     2188   define variable accum-cre-pay-base like ub.chk-pay.tot-rubl  no-undo .
     2189   define variable accum-cre-pay-rubl like ub.chk-pay.tot-rubl  no-undo .
     2190   define variable ret-doc-code as character no-undo .
