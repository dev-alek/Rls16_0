     1340       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     1341       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     1342       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     1343       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     1344       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1345       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     1346       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     1347       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1348       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     1349       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     1350       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     1351       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     1352       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     1353       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     1354       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     1355       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     1356       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1357       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1358       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1359       define variable varinvatp-envdo             as   character              no-undo.
     1360       define variable varinvatp-typeo             as   character              no-undo.
     1361       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     1362       define buffer buf_gds-dtl  for ub.gds-dtl .
     1363       define buffer buf_goods    for ub.goods .
     1364       define buffer buf_trn-doc  for ub.trn-doc .
     1365       define buffer buf_doc-line for ub.doc-line .
     1366       find first buf_doc-line no-lock
     1367         where buf_doc-line.doc-code  = p-doc-code
     1368           and buf_doc-line.artic     = p-artic
     1369           and buf_doc-line.prod-type = p-prod-type
     1370           and buf_doc-line.prod-code = p-prod-code
     1371         no-error .
     1372       if not available buf_doc-line then do:
     1373         message
     1374           vss-workfile vss-revision vss-description skip
     1375           vss-include-info12 skip
     1376           "Ошибка задания входных параметров" skip
     1377           "Не найдена строка документа" skip
     1378           "Документ" p-doc-code skip
     1379           "Артикул" p-artic p-prod-type p-prod-code skip
     1380           view-as alert-box error .
