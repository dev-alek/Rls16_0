     2472   like ub.nws-outline.
     2473   procedure create-smart-route :
     2474   define input parameter p-key-field as character no-undo .
     2475   define input parameter p-db-num as integer no-undo .
     2476   define buffer buf_temp-smart-route for temp-smart-route.
     2477     do
     2478     on error undo, return error
     2479     :
     2480       find first buf_temp-smart-route where
     2481                 buf_temp-smart-route.key-field = p-key-field
     2482             and buf_temp-smart-route.db-num = p-db-num no-error.
     2483       if not available buf_temp-smart-route then do:
     2484         create buf_temp-smart-route.
     2485         assign
     2486         buf_temp-smart-route.key-field = p-key-field
     2487         buf_temp-smart-route.db-num = p-db-num
     2488         .
     2489       end.
     2490     end.
     2491   end procedure.
     2492   procedure create-smart-route-link :
     2493   define input parameter p-tbl-name as character no-undo .
     2494   define input parameter p-bh_tbl-name as handle no-undo .
     2495   define input parameter p-key-field as character no-undo .
     2496   define input parameter p-rec-ord as integer no-undo .
     2497   define input parameter p-is-smart as logical no-undo .
     2498   define variable v-key-rec as character no-undo .
     2499   define buffer buf_temp-smart-link for temp-smart-link.
     2500     do
     2501     on error undo, return error
     2502     :
     2503       run gen-key-rec in this-procedure ( input p-tbl-name
     2504                                          ,input p-bh_tbl-name
     2505                                          ,output v-key-rec     ).
     2506      find first buf_temp-smart-link where
     2507                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     2508              and buf_temp-smart-link.key-field = p-key-field
     2509              and buf_temp-smart-link.rec-ord = p-rec-ord
     2510              no-error .
     2511      if not available buf_temp-smart-link then do:
     2512        create buf_temp-smart-link.
     2513        assign
     2514        buf_temp-smart-link.uniq-key-rec = v-key-rec
     2515        buf_temp-smart-link.key-field = p-key-field
     2516        buf_temp-smart-link.rec-ord = p-rec-ord
     2517        buf_temp-smart-link.is-smart = p-is-smart
     2518        .
     2519      end.
     2520     end.
     2521   end procedure.
     2522   procedure create-nws-outline :
     2523   define input parameter p-cmd-proc-handle as handle no-undo .
     2524   define input parameter p-cmd-code as integer no-undo .
     2525   define input parameter p-outline-type as character no-undo .
     2526   define input parameter p-charkey_one as character no-undo .
     2527   define input parameter p-charkey_two as character no-undo .
     2528   define input parameter p-charkey_three as character no-undo .
     2529   define input parameter p-key#_one as integer no-undo .
     2530   define input parameter p-key#_two as integer no-undo .
     2531   define input parameter p-key#_three as integer no-undo .
     2532   define variable v-no-id as integer no-undo .
     2533   define variable v-rec-ord as integer no-undo .
     2534     do
     2535     on error undo, return error return-value
     2536     :
     2537       find last temp-nws-outline use-index pi no-error .
     2538       v-no-id = (if available temp-nws-outline
     2539                  then (temp-nws-outline.no-id  + 1)
     2540                  else 1).
     2541       create temp-nws-outline.
     2542       assign
     2543       temp-nws-outline.charkeY_one = p-charkey_one
     2544       temp-nws-outline.charkeY_two = p-charkey_two
     2545       temp-nws-outline.charkeY_three = p-charkey_three
     2546       temp-nws-outline.key#_one = p-key#_one
     2547       temp-nws-outline.key#_two = p-key#_two
     2548       temp-nws-outline.key#_three = p-key#_three
     2549       temp-nws-outline.no-id = v-no-id
     2550       temp-nws-outline.outline-type = p-outline-type
     2551       .
     2552                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2553       run  create-smart-route in this-procedure (
     2554                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     2555                                                  ,input -1).
     2556       run create-smart-route-link in this-procedure (
     2557                                                      input 'nws-outline':U
     2558                                                     ,input (buffer temp-nws-outline:handle)
     2559                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     2560                                                     ,input v-rec-ord
     2561                                                     ,input no
     2562                                                     ).
     2563     end.
     2564   end procedure.
     2565   procedure create-no-route :
     2566   define input parameter p-rec-ord as integer no-undo .
