     3033         temp-d-card.cli-code          = bf_dis-card.cli-code
     3034         temp-d-card.sale-doc          = bf_trn-doc.doc-code
     3035         temp-d-card.sale-type         = 'trn-doc':U
     3036         temp-d-card.doc-date          = bf_trn-doc.doc-date
