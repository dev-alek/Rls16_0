     1360   procedure proc-step-400 :
     1361   define input parameter p-curr-obj-type    like ub.clients.obj-type no-undo .
     1362   define input parameter p-curr-obj-code    like ub.clients.obj-code no-undo .
     1363   define input parameter p-process-only-new as logical no-undo .
     1364   define variable v-parameter as character no-undo .
     1365   define buffer buf_inkas for ub.inkas.
     1366   define buffer buf_chk-doc for ub.chk-doc.
     1367     do
     1368     on error undo, return error
     1369     :
     1370       _inkas:
     1371       for each buf_inkas where
     1372               buf_Inkas.obj-type = p-curr-obj-type
     1373           AND buf_Inkas.obj-code = p-curr-obj-code
     1374           AND buf_Inkas.status_ = 'новый':U:
     1375         if p-process-only-new then do:
     1376           find first temp-inkas where temp-inkas.inkas-code = buf_inkas.inkas-code no-error.
     1377           if not available temp-inkas then next _inkas.
     1378         end.
     1379         find first buf_chk-doc no-lock where
     1380                   buf_chk-doc.obj-type = p-curr-obj-type
     1381               AND buf_chk-doc.obj-code = p-curr-obj-code
     1382               AND buf_chk-doc.out-code = buf_inkas.inkas-code no-error.
     1383         if not available buf_chk-doc then do:
     1384           assign
     1385           v-parameter = string(2)                 + chr(4) +
     1386                         p-curr-obj-type           + chr(4) +
     1387                         string(p-curr-obj-code)   + chr(4) +
     1388                         string(no)                + chr(4) +
     1389                         buf_inkas.inkas-code
     1390           .
     1391           run str/del-sale.p (
     1392                           input parparentproc
     1393                         ,input this-procedure
     1394                         ,input p-log-handle
     1395                         ,input v-parameter
     1396                         )  no-error.
     1397           if error-status:error
     1398           and return-value <> "error"
     1399           then do:
     1400             run write-to-log in p-log-handle (
     1401                   input substitute( "!!!Ошибка при удалении пустой (без чеков) продажи &1 в &2&3&4" +
     1402                                     "&5 &6"
     1403                                   , buf_inkas.inkas-code
     1404                                   , p-curr-obj-type
     1405                                   , p-curr-obj-code
     1406                                   , chr(10)
     1407                                   , error-status:get-message(1)
     1408                                   , return-value
     1409                                   )            ).
     1410             next _inkas.
     1411           end.
     1412         end.
     1413       end.
     1414     end.
     1415   end procedure.
     1416   procedure get-db-num:
     1417     define output parameter pDbNum as integer no-undo.
     1418     pDbNum = g#db-num.
     1419   end.
     1420   procedure get-userid:
     1421     define output parameter pUserId as character no-undo.
     1422     assign
     1423       pUserId  = g#userid
     1424       .
     1425   end.
     1426   define buffer buf_chk-doc for ub.chk-doc.
     1427   define buffer buf_inkas for ub.inkas.
     1428   define buffer buf_shop for ub.shop.
     1429   DEFINE NEW SHARED BUFFER X_chk-doc FOR ub.chk-doc.
     1430   if num-entries(p-parameter, chr(4) ) <> 3 then do:
     1431       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1 &2 &3&4Неверное кол-во entry в составном параметре p-parameter = &5, должно быть 3"                               ,vss-workfile                               ,vss-revision                               ,vss-description                               ,chr(10)                               , num-entries(p-parameter, chr(4) )                               )).
     1432     .
     1433     return.
     1434   end.
     1435   assign
     1436   p-obj-type = entry(1, p-parameter, chr(4))
     1437   p-obj-code = integer(entry(2, p-parameter, chr(4)))
     1438   p-doc-code = entry(3, p-parameter, chr(4))
     1439   no-error
     1440   .
     1441   if error-status:error then do:
