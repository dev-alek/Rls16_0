     1212   define variable v-param-type as character no-undo .
     1213   define variable v-value-character as character no-undo .
     1214   define variable v-value-date as date no-undo .
     1215   define variable v-value-decimal as decimal no-undo .
     1216   define variable v-value-integer as INTEGER no-undo .
     1217   define variable v-value-logical AS LOGICAL no-undo .
