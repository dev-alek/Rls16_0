     1301       restingr = restingr and autofbr
     1302       resttpsi = resttpsi and v-is-tpsi-obj
     1303       neg-tpsi-weight = neg-tpsi-weight and v-is-tpsi-obj
     1304       neg-tpsi-oper = neg-tpsi-oper and v-is-tpsi-obj
     1305       .
     1306       _inkas:
     1307       for each buf_inkas where
