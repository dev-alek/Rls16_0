     1260             and thbjattr_thbj-attr.obj-code = p-curr-obj-code
     1261             and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     1262       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     1263         case thbjattr_thbj-attr.prop-code:
     1264           when 'autocomp':U then do:
     1265             auto-comp = thbjattr_thbj-attr.property-value-logical.
     1266           end.
     1267           when 'autofbr':U then do:
     1268             autofbr = thbjattr_thbj-attr.property-value-logical.
     1269           end.
     1270           when 'one-curs':U then do:
     1271             one-curs = thbjattr_thbj-attr.property-value-logical.
     1272           end.
     1273           when 'restdish':U then do:
     1274             restdish = thbjattr_thbj-attr.property-value-logical.
     1275           end.
     1276           when 'restingr':U then do:
     1277             restingr = thbjattr_thbj-attr.property-value-logical.
     1278           end.
     1279           when 'resttpsi':U then do:
     1280             resttpsi = thbjattr_thbj-attr.property-value-logical.
     1281           end.
     1282           when 'neg-tpsi-weight':U then do:
     1283             neg-tpsi-weight = thbjattr_thbj-attr.property-value-logical.
     1284           end.
     1285           when 'neg-tpsi-oper':U then do:
     1286             neg-tpsi-oper = thbjattr_thbj-attr.property-value-logical.
     1287           end.
     1288           when 'neg-tpsi-qnty':U then do:
     1289             neg-tpsi-qnty = thbjattr_thbj-attr.property-value-decimal.
     1290           end.
     1291           when 'close-in-rfsl':U then do:
