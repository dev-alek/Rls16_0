        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: afgetchk.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/afgetchk.p $":U .
       11   define variable vss-description as character no-undo init "Закачка чеков в продажу и резервирование после приема чеков (пробития чеков на кассе)".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
       83   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
       84     field cst-code                like ub.trn-doc.cst-code
       85     field part-code               like ub.parts.part-code
       86     .
       87   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
       88   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
       89   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define new global shared variable g#trdcalib as handle no-undo.
       92   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define NEW SHARED temp-table tt0-info no-undo
       94   field doc-code   like ub.trn-doc.doc-code
       95   field artic      like ub.doc-line.artic
       96   field prod-type  like ub.doc-line.prod-type
       97   field prod-code  like ub.doc-line.prod-code
       98   field prt-code  like ub.gds-dtl.prt-code
       99   field obj-type   like ub.doc-line.obj-type
      100   field obj-code   like ub.doc-line.obj-code
      101   field error-message as character
      102   field a-to-res as decimal
      103   field was-res as decimal
      104   field to-res as decimal
      105   field is-res as decimal
      106   field o-was-res as decimal
      107   field o-to-res as decimal
      108   field o-is-res as decimal
      109   index pi is unique primary
      110   obj-type
      111   obj-code
      112   artic
      113   prod-type
      114   prod-code
      115   index iartic
      116   artic
      117   prod-type
      118   prod-code
      119   .
      120   define NEW SHARED temp-table tt0-doc-line no-undo like lib-trn_ret-line.
      121   define NEW SHARED temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
      122   define NEW SHARED temp-table tt0-parts    no-undo like ub.parts.
      123   define NEW SHARED temp-table temp-tpsi-clients  no-undo like ub.clients.
      124   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      125   define variable v-ps as character no-undo .
      126   assign
      127   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
      128                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
      129                     , buf_sale-doc.out-code
      130                     , buf_sale-doc.obj-type
      131                     , buf_sale-doc.obj-code
      132                     , chr(4)
      133                     , buf_sale-doc.tot-lines
      134                     , buf_sale-doc.tot-dtl
      135                     ).
      136   return v-Ps.
      137   END FUNCTION.
      138   procedure create-tt0-doc-line-gds-dtl :
      139   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
      140   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
      141   define input parameter p-ext-doc-type        as character no-undo .
      142   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
      143   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
      144   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
      145   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
      146   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
      147   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
      148   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
      149   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
      150   define parameter buffer b-doc-line           for ub.doc-line.
      151   define parameter buffer b-gds-dtl            for ub.gds-dtl.
      152   define parameter buffer buf_sale-doc for ub.sale-doc.
      153   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
      154   define buffer other_doc-line for ub.doc-line.
      155   define buffer other_gds-dtl for ub.gds-dtl.
      156     do
      157     on error undo, return error return-value
      158     :
      159       find first tt0-doc-line where
      160                 tt0-doc-line.obj-type = p-proprietor-obj-type
      161             AND tt0-doc-line.obj-code = p-proprietor-obj-code
      162             AND tt0-doc-line.prod-type = p-prod-type
      163             AND tt0-doc-line.prod-code = p-prod-code
      164             AND tt0-doc-line.artic     = p-artic
      165             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
      166             AND tt0-doc-line.status_      = 'нередакт':U no-error .
      167       if not available tt0-doc-line then do:
      168         create tt0-doc-line.
      169         buffer-copy b-doc-line
      170         except
      171         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
      172         to tt0-doc-line
      173         assign
      174         tt0-doc-line.status_ = 'нередакт':U
      175         tt0-doc-line.ext-doc-type = p-ext-doc-type
      176         tt0-doc-line.obj-type = p-proprietor-obj-type
      177         tt0-doc-line.obj-code = p-proprietor-obj-code
      178         tt0-doc-line.doc-code = p-doc-code
      179         .
      180       end.
      181       if p-doc-code <> "":U then do:
      182         find first other_doc-line no-lock where
      183                 other_doc-line.doc-code = p-doc-code
      184             AND  other_doc-line.artic    = p-artic
      185             AND  other_doc-line.prod-type = p-prod-type
      186             AND  other_doc-line.prod-code = p-prod-code no-error .
      187         if available other_doc-line then do:
      188           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
      189           assign
      190           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
      191           .
      192         end.
      193         else do:
      194           assign
      195           tt0-doc-line.doc-code = '':U
      196           .
      197         end.
      198       end.
      199       find first tt0-gds-dtl where
      200               tt0-gds-dtl.obj-type = p-proprietor-obj-type
      201           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
      202           AND tt0-gds-dtl.prod-type = p-prod-type
      203           AND tt0-gds-dtl.prod-code = p-prod-code
      204           AND tt0-gds-dtl.artic     = p-artic
      205           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
      206       if not available tt0-gds-dtl then do:
      207         create tt0-gds-dtl.
      208         buffer-copy b-gds-dtl
      209         except
      210         obj-type obj-code doc-code doc-qnty fact-qnty
      211         to tt0-gds-dtl
      212         assign
      213         tt0-gds-dtl.obj-type = p-proprietor-obj-type
      214         tt0-gds-dtl.obj-code = p-proprietor-obj-code
      215         tt0-gds-dtl.doc-code = p-doc-code
      216         .
      217       end.
      218       if p-doc-code <> "":U then do:
      219           find first other_gds-dtl no-lock where
      220                   other_gds-dtl.doc-code = p-doc-code
      221               AND  other_gds-dtl.artic    = p-artic
      222               AND  other_gds-dtl.prod-type    = p-prod-type
      223               AND  other_gds-dtl.prod-code    = p-prod-code
      224               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
      225           if available other_gds-dtl then do:
      226             assign
      227             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
      228             .
      229           end.
      230           else do:
      231             assign
      232             tt0-gds-dtl.doc-code = '':U
      233             .
      234           end.
      235       end.
      236       assign
      237       old-qnty = tt0-gds-dtl.doc-qnty
      238       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
      239       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
      240       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
      241       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
      242       .
      243     end.
      244   end procedure.
      245   procedure fill-tt-tpsi-table :
      246   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
      247   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
      248   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
      249   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
      250   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
      251   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
      252   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
      253   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
      254   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
      255   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
      256   define buffer buf_goods for ub.goods.
      257   define buffer buf_doc-line for ub.doc-line.
      258   define buffer buf_gds-dtl for ub.gds-dtl.
      259   define buffer buf_sale-doc for ub.sale-doc.
      260     do
      261     on error undo, return error
      262     :
      263       _doc-line:
      264       for each buf_Doc-line no-lock where
      265             buf_doc-line.doc-code = p-doc-code,
      266         first buf_goods no-lock where
      267             buf_goods.artic = buf_doc-line.artic
      268        AND  buf_goods.prod-type  = buf_doc-line.prod-type
      269        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
      270           each buf_gds-dtl no-lock where
      271             buf_gds-dtl.doc-code = buf_doc-line.doc-code
      272         AND  buf_gds-dtl.artic    = buf_doc-line.artic
      273         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
      274         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
      275         assign
      276         v-ext-doc-type = "":U.
      277         run tpsi-preselect-gds-proprietor in this-procedure (
      278                                                     input buf_goods.gds-code
      279                                                   ,input g#db-num
      280                                                   ,output v-proprietor-host-code
      281                                                   ,output v-proprietor-obj-type
      282                                                   ,output v-proprietor-obj-code ) no-error .
      283         if v-proprietor-host-code = p-host-code then do:
      284           assign
      285           v-ext-doc-type = 'ev':U .
      286         end.
      287         else do:
      288           assign
      289           v-ext-doc-type =  'ee':U .
      290         end.
      291         if  (v-proprietor-obj-type = p-obj-type
      292         AND v-proprietor-obj-code = p-obj-code)
      293         OR (v-proprietor-obj-type = "":U
      294         AND v-proprietor-obj-code = 0)
      295         OR v-proprietor-obj-code = ?
      296         then next _doc-line.
      297         find first buf_sale-doc no-lock where
      298                   buf_sale-doc.inkas-code = p-doc-code
      299              AND buf_sale-doc.obj-type = v-proprietor-obj-type
      300              AND buf_sale-doc.obj-code = v-proprietor-obj-code
      301              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
      302              no-error .
      303         run create-tt0-doc-line-gds-dtl  in this-procedure (
      304                                                              input v-proprietor-obj-type
      305                                                             ,input v-proprietor-obj-code
      306                                                             ,input v-ext-doc-type
      307                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
      308                                                             ,input buf_doc-line.artic
      309                                                             ,input buf_Doc-line.prod-type
      310                                                             ,input buf_doc-line.prod-code
      311                                                             ,input buf_gds-dtl.prt-code
      312                                                             ,input 0
      313                                                             ,output v-was-gds-dtl-fact-qnty
      314                                                             ,output v-gds-dtl-fact-qnty
      315                                                             ,buffer buf_doc-line
      316                                                             ,buffer buf_gds-dtl
      317                                                             ,buffer buf_sale-doc
      318                                                           ).
      319       end.
      320     end.
      321   end procedure.
      322   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      324   procedure get-alias-type-price-obj :
      325   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      326   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      327   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      328   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
      329   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
      330   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
      331   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
      332   define output parameter p-alias-type-price as character no-undo .
      333   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
      334   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
      335   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
      336   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
      337   define variable v-mediat-objf               as character no-undo .
      338   define variable v-param-type as character no-undo .
      339   define variable v-value-character as character no-undo .
      340   define variable v-value-date as date no-undo .
      341   define variable v-value-decimal as decimal no-undo .
      342   define variable v-value-integer as INTEGER no-undo .
      343   define variable v-value-logical AS LOGICAL no-undo .
      344   define variable v-tth as handle no-undo .
      345   assign
      346   v-tth = buffer thbjattr_thbj-attr:table-handle .
      347   define buffer buf_trn-doc for ub.trn-doc.
      348     _main:
      349     do
      350     on error undo, return error return-value
      351     :
      352       run adm/shattri.p (
      353         input "get":U
      354         ,input  p-prop-obj-type
      355         ,input  p-prop-obj-code
      356         ,input  'alias-tpsi':U
      357         ,input  '':U
      358         ,output v-value-character
      359         ,output v-value-date
      360         ,output v-value-decimal
      361         ,output v-value-integer
      362         ,output v-value-logical
      363         ,output v-param-type
      364         ,INPUT-OUTPUT table-handle v-tth
      365         ) no-error .
      366       if error-status:error
      367       then do:
      368         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      369                                 , p-prop-obj-type
      370                                 , p-prop-obj-code).
      371       end.
      372       find first thbjattr_thbj-attr where
      373                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
      374             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
      375             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
      376             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
      377       if not available thbjattr_thbj-attr
      378       or thbjattr_thbj-attr.property-value-integer = 0 then do:
      379         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      380                                 , p-prop-obj-type
      381                                 , p-prop-obj-code).
      382       end.
      383       assign
      384       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
      385       if p-prop-host-code = p-host-code
      386       and (p-alias-type-price = '':U
      387       or   p-alias-type-price <> '5':U)
      388       then  do:
      389         assign
      390         p-ext-doc-type = 'ev':U
      391         p-price-obj-type = p-obj-type
      392         p-price-obj-code = p-obj-code
      393         p-alias-type-price = '3':U
      394         .
      395       end.
      396       else do:
      397         if p-prop-host-code = p-host-code  then do:
      398           assign
      399           p-ext-doc-type = 'ev':U
      400           p-price-obj-type = p-obj-type
      401           p-price-obj-code = p-obj-code
      402           .
      403         end.
      404         else do:
      405           assign
      406           p-ext-doc-type = 'ee':U.
      407           assign
      408           v-mediat-obj-type = "":U
      409           v-mediat-obj-code = 0
      410           v-mediat-objf = "":U
      411           .
      412           if p-alias-type-price = '4':U then do:
      413             find first thbjattr_thbj-attr where
      414                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
      415                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
      416                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
      417                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
      418             if not available thbjattr_thbj-attr
      419             or thbjattr_thbj-attr.property-value-character = "":U then do:
      420               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
      421                                       , p-prop-obj-type
      422                                       , p-prop-obj-code).
      423             end.
      424             assign
      425             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
      426             v-mediat-obj-type = entry(1, v-mediat-objf)
      427             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
      428             no-error
      429             .
      430             if error-status:error then do:
      431               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
      432                                       , p-prop-obj-type
      433                                       , p-prop-obj-code).
      434             end.
      435           end.
      436           CASE p-alias-type-price:
      437             when '1':U then do:
      438               assign
      439               p-price-obj-type = p-prop-obj-type
      440               p-price-obj-code = p-prop-obj-code
      441               .
      442             end.
      443             when '2':U then do:
      444               assign
      445               p-price-obj-type = p-prop-obj-type
      446               p-price-obj-code = p-prop-obj-code
      447               .
      448             end.
      449             when '3':U
      450             or
      451             when '5':U
      452             then do:
      453               assign
      454               p-price-obj-type = p-obj-type
      455               p-price-obj-code = p-obj-code
      456               .
      457             end.
      458             when '4':U then do:
      459               assign
      460               p-price-obj-type = v-mediat-obj-type
      461               p-price-obj-code = v-mediat-obj-code
      462               .
      463             end.
      464           END CASE.
      465         end.
      466       end.
      467     end.
      468   end procedure.
      469   procedure write-tt0-info:
      470   define input parameter p-artic as character no-undo .
      471   define input parameter p-prod-type as character no-undo .
      472   define input parameter p-prod-code as integer no-undo .
      473   define input parameter p-prt-code as integer no-undo .
      474   define input parameter p-obj-type as character no-undo .
      475   define input parameter p-obj-code as integer no-undo .
      476   define input parameter p-doc-code as character no-undo .
      477   define input parameter p-from-tpsi as logical no-undo .
      478   define input parameter p-all-qnty as decimal no-undo .
      479   define input parameter p-was-res as decimal no-undo .
      480   define input parameter p-to-res as decimal no-undo .
      481   define input parameter p-is-res as decimal no-undo .
      482   define input parameter p-o-was-res as decimal no-undo .
      483   define input parameter p-o-to-res as decimal no-undo .
      484   define input parameter p-o-is-res as decimal no-undo .
      485   define input parameter p-mess   as character no-undo .
      486   define buffer buf_tt0-info for tt0-info.
      487     do
      488     on error undo, return error return-value
      489     :
      490       find first buf_tt0-info where
      491                buf_tt0-info.artic = p-artic
      492            and buf_tt0-info.prod-type = p-prod-type
      493            and buf_tt0-info.prod-code = p-prod-code
      494            and buf_tt0-info.prt-code = p-prt-code
      495            no-error .
      496       if not available buf_tt0-info then do:
      497         create buf_tt0-info.
      498         assign
      499         buf_tt0-info.artic = p-artic
      500         buf_tt0-info.prod-type = p-prod-type
      501         buf_tt0-info.prod-code = p-prod-code
      502         buf_tt0-info.prt-code  = p-prt-code
      503         buf_tt0-info.obj-type  = p-obj-type
      504         buf_tt0-info.obj-code  = p-obj-code
      505         buf_tt0-info.a-to-res  = ?
      506         buf_tt0-info.to-res    = ?
      507         buf_tt0-info.was-res   = ?
      508         buf_tt0-info.o-was-res = ?
      509         buf_tt0-info.o-to-res  = ?
      510         buf_tt0-info.o-is-res  = ?
      511         buf_tt0-info.is-res    = ?
      512         .
      513       end.
      514       assign
      515       buf_tt0-info.a-to-res  =
      516                                 (if buf_tt0-info.a-to-res <> ?
      517                                 and p-all-qnty = ?
      518                                 then buf_tt0-info.a-to-res
      519                                 else p-all-qnty)
      520       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
      521                                 and p-was-res = ?
      522                                 then buf_tt0-info.was-res
      523                                 else p-was-res)
      524       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
      525                                 and p-to-res = ?
      526                                 then buf_tt0-info.to-res
      527                                 else p-to-res)
      528       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
      529                                 and p-is-res = ?
      530                                 then buf_tt0-info.is-res
      531                                 else p-is-res)
      532       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
      533                                 and p-o-was-res = ?
      534                                 then buf_tt0-info.o-was-res
      535                                 else p-o-was-res)
      536       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
      537                                 and p-o-to-res = ?
      538                                 then buf_tt0-info.o-to-res
      539                                 else p-o-to-res)
      540       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
      541                                 and p-o-is-res = ?
      542                                 then buf_tt0-info.o-is-res
      543                                 else p-o-is-res)
      544       .
      545       assign
      546       buf_tt0-info.doc-code  = p-doc-code
      547       buf_tt0-info.error-message   = p-mess
      548       .
      549     end.
      550   end procedure.
      551   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   define NEW SHARED temp-table dtl-rests-mark no-undo
      553   field artic like ub.gds-dtl.artic
      554   field prod-type like ub.gds-dtl.prod-type
      555   field prod-code like ub.gds-dtl.prod-code
      556   index   pi  is primary
      557   artic
      558   prod-type
      559   prod-code
      560   .
      561   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      562   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   procedure cur-time :
      564      define output parameter p-today as date      no-undo .
      565      define output parameter p-time  as integer   no-undo .
      566     do
      567     on error undo, return error
      568     :
      569       define variable v-date1 as date      no-undo .
      570       define variable v-date2 as date      no-undo .
      571       define variable v-time  as integer   no-undo .
      572       assign
      573         v-date1 = today
      574         v-time  = time
      575         v-date2 = today
      576       .
      577       if v-date1 <> v-date2
      578       then do:
      579         assign
      580           v-date1 = today
      581           v-time  = v-time
      582         .
      583       end.
      584       assign
      585         p-today = v-date1
      586         p-time  = v-time
      587       .
      588     end.
      589   end.
      590   function cur-time-date returns character
      591   :
      592     return string(today, '99/99/9999':U) .
      593   end.
      594   function cur-time-mjd returns decimal
      595   :
      596     define variable v-date as date      no-undo .
      597     define variable v-time as integer   no-undo .
      598     run cur-time in this-procedure
      599       (output v-date
      600       ,output v-time
      601       ) .
      602     return integer(v-date) - 2400002 + (v-time / 86400) .
      603   end.
      604   function cur-time-get-ending-index returns integer
      605   (input p-number as integer
      606   )
      607   :
      608     if p-number < 0
      609     or p-number = ?
      610     then do:
      611       return 1 .
      612     end.
      613     define variable v-rest as integer   no-undo .
      614     assign
      615       p-number = p-number modulo 100
      616     .
      617     if p-number < 20
      618     then do:
      619       assign
      620         v-rest = p-number
      621       .
      622     end.
      623     else do:
      624       assign
      625         v-rest = p-number modulo 10
      626       .
      627     end.
      628     case v-rest :
      629       when 1
      630       then do:
      631         return 2 .
      632       end.
      633       when 2 or
      634       when 3 or
      635       when 4
      636       then do:
      637         return 3 .
      638       end.
      639       otherwise do:
      640         return 1 .
      641       end.
      642     end case .
      643   end.
      644   procedure cur-time-mjd-to-date :
      645      define input  parameter i-mjd-diff as decimal no-undo.
      646      define output parameter o-Date     as date    no-undo.
      647      define output parameter o-Time     as integer no-undo.
      648      define variable v-day-number as integer   no-undo .
      649      if    i-mjd-diff < 0
      650         or i-mjd-diff = ?
      651      then do:
      652         return "?" .
      653      end.
      654      assign
      655         v-day-number = truncate(i-mjd-diff,0).
      656         o-Date = date(v-day-number + 2400002).
      657         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      658     .
      659   end.
      660   function cur-time-mjd-to-string returns character
      661   (input p-mjd-diff as decimal
      662   )
      663   :
      664     define variable v-day-number as integer   no-undo .
      665     define variable v-seconds    as integer   no-undo .
      666     define variable v-hour       as integer   no-undo .
      667     define variable v-min        as integer   no-undo .
      668     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      669     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      670     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      671     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      672     if p-mjd-diff < 0
      673     or p-mjd-diff = ?
      674     then do:
      675       return "?" .
      676     end.
      677     assign
      678       v-day-number = integer(truncate(p-mjd-diff,0))
      679       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      680     .
      681     if v-seconds > 86400
      682     then do:
      683       assign
      684         v-seconds = 86400 - 1
      685       .
      686     end.
      687     if v-seconds < 0
      688     then do:
      689       assign
      690         v-seconds = 0
      691       .
      692     end.
      693     assign
      694       v-hour = truncate(v-seconds / 3600, 0)
      695     .
      696     assign
      697       v-seconds = v-seconds modulo 3600
      698     .
      699     assign
      700       v-min = truncate(v-seconds / 60, 0)
      701     .
      702     assign
      703       v-seconds = v-seconds modulo 60
      704     .
      705     return
      706         (if v-day-number <> 0
      707           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      708           else ""
      709         )
      710       + (if v-day-number <> 0 or v-hour <> 0
      711           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      712           else ""
      713         )
      714       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      715           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      716           else ""
      717         )
      718       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      719       .
      720   end.
      721   function cur-time-string returns character
      722   :
      723     define variable v-date as date      no-undo .
      724     define variable v-time as integer   no-undo .
      725     run cur-time in this-procedure
      726       (output v-date
      727       ,output v-time
      728       ) .
      729     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      730   end.
      731   function cur-time-string-sec returns character
      732   :
      733     define variable v-date as date      no-undo .
      734     define variable v-time as integer   no-undo .
      735     run cur-time in this-procedure
      736       (output v-date
      737       ,output v-time
      738       ) .
      739     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      740   end.
      741   function cur-time-custom  returns character
      742   (input p-prefix as character
      743   ,input p-date-format as character
      744   ,input p-delimiter as character
      745   ,input p-time-format as character
      746   ,input p-suffix as character
      747   )
      748   :
      749     define variable v-date as date      no-undo .
      750     define variable v-time as integer   no-undo .
      751     run cur-time in this-procedure
      752       (output v-date
      753       ,output v-time
      754       ) .
      755     return
      756       p-prefix
      757       + string(v-date, p-date-format)
      758       + p-delimiter
      759       + string(v-time, p-time-format)
      760       + p-suffix
      761       .
      762   end.
      763   function cur-time-print  returns character
      764   :
      765     define variable v-date as date      no-undo .
      766     define variable v-time as integer   no-undo .
      767     run cur-time in this-procedure
      768       (output v-date
      769       ,output v-time
      770       ) .
      771     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      772   end.
      773   function cur-time-datetime returns datetime
      774   :
      775     define variable v-char as character no-undo .
      776     define variable v-datetime as datetime no-undo .
      777     v-char = cur-time-string().
      778     v-datetime = datetime(v-char).
      779     return  v-datetime.
      780   end.
      781   function cur-time-string-msec returns character
      782   :
      783     define variable v-date as datetime  no-undo .
      784     v-date = now.
      785     return string(v-date) .
      786   end.
      787   define variable p-obj-type as character no-undo .
      788   define variable p-obj-code as integer no-undo .
      789   define variable p-doc-code as character no-undo .
      790   define variable log-file-name as character no-undo .
      791   define variable v-inkas-code as character no-undo .
      792   define variable v-curr-r-b as character no-undo .
      793   define variable v-start as logical no-undo .
      794   define variable v-rid-list as character no-undo .
      795   define variable v-len as integer no-undo .
      796   define variable v-ii as integer no-undo .
      797   define variable v-obj-db-num as integer no-undo .
      798   define variable l-shift-on as logical no-undo .
      799   define variable v-ok as logical no-undo .
      800   define variable v-parameter as character no-undo .
      801   log-file-name = "ext-sale.log".
      802   define new shared temp-table temp-inkas no-undo like ub.inkas.
      803   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   procedure proc-step-100 :
      805   define input parameter p-curr-obj-type    like ub.clients.obj-type no-undo .
      806   define input parameter p-curr-obj-code    like ub.clients.obj-code no-undo .
      807   define input parameter p-process-only-new as logical no-undo .
      808   define input parameter p-finalize         as logical no-undo .
      809   DEFINE VARIABLE compensed AS LOGICAL NO-UNDO.
      810   DEFINE VARIABLE auto-comp AS LOGICAL NO-UNDO.
      811   DEFINE VARIABLE autofbr AS LOGICAL NO-UNDO.
      812   DEFINE VARIABLE one-curs AS LOGICAL NO-UNDO.
      813   DEFINE VARIABLE restdish AS LOGICAL NO-UNDO.
      814   DEFINE VARIABLE restingr AS LOGICAL NO-UNDO.
      815   DEFINE VARIABLE resttpsi AS LOGICAL NO-UNDO.
      816   DEFINE VARIABLE v-is-tpsi-obj AS LOGICAL NO-UNDO.
      817   DEFINE VARIABLE conf-attr AS character NO-UNDO.
      818   DEFINE VARIABLE conf-par AS character NO-UNDO.
      819   DEFINE VARIABLE par-type AS character NO-UNDO.
      820   define variable v-parameter as character no-undo .
      821   define variable v-is-wth as character no-undo .
      822   define variable is-wth as logical   no-undo .
      823   define variable sale-filter as logical no-undo .
      824   define variable cas-shft    as logical no-undo init no.
      825   define variable cas-curs    as logical no-undo init no.
      826   define variable prcl-spl    as logical no-undo init no.
      827   define variable pay-gds-algo as character no-undo.
      828   define variable rdtaxcd     as INTEGER                  no-undo.
      829   define variable exctaxcd    as INTEGER                  no-undo.
      830   define variable factorrt    as decimal no-undo.
      831   define variable btltaxcd    as INTEGER                  no-undo.
      832   define variable p-day-only  as logical no-undo .
      833   define variable v-param-type as character no-undo .
      834   define variable v-value-character as character no-undo .
      835   define variable v-value-date as date no-undo .
      836   define variable v-value-decimal as decimal no-undo .
      837   define variable v-value-integer as INTEGER no-undo .
      838   define variable v-value-logical AS LOGICAL no-undo .
      839   define variable v-tth as handle no-undo .
      840   assign
      841   v-tth = buffer thbjattr_thbj-attr:table-handle .
      842   define buffer buf_inkas for ub.inkas.
      843   DEFINE BUFFER buf_shop FOR ub.shop.
      844   define buffer buf_trn-doc for ub.trn-doc.
      845     do
      846     on error undo, return error return-value
      847     :
      848   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      849     (input  'is-wth':u
      850     ,input  '':u
      851     ,input  '':u
      852     ,input  0
      853     ,input  '':u
      854     ,input  '':u
      855     ,input  '':u
      856     ,input  no
      857     ,output v-is-wth
      858     ,output par-type
      859     ) no-error .
      860       if error-status :error
      861       or par-type <> 'L':U
      862       or v-is-wth <> 'yes':u
      863       then do:
      864         assign
      865         is-wth = no
      866         .
      867       end.
      868       else do:
      869         is-wth = yes.
      870       end.
      871       FIND FIRST buf_shop NO-LOCK WHERE
      872                 buf_shop.obj-code = p-curr-obj-code .
      873       run gbl/tpsi-obj.p ( input p-curr-obj-type
      874                           ,input p-curr-obj-code
      875                           ,output v-is-tpsi-obj) no-error .
      876       for each thbjattr_thbj-attr:
      877         delete thbjattr_thbj-attr.
      878       end.
      879       run adm/shattri.p (
      880           input "get":U
      881           ,input  p-curr-obj-type
      882           ,input  p-curr-obj-code
      883           ,input  'autosale':U
      884           ,input  "":U
      885           ,output v-value-character
      886           ,output v-value-date
      887           ,output v-value-decimal
      888           ,output v-value-integer
      889           ,output v-value-logical
      890           ,output v-param-type
      891           ,INPUT-OUTPUT table-handle v-tth
      892           ) no-error .
      893       IF error-status:error then do:
      894         run write-to-log in p-log-handle (
      895               input substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
      896                 , p-curr-obj-type
      897                 , p-curr-obj-code
      898                 , chr(10)
      899                 , error-status:get-message(1)
      900                 , return-value )).
      901          undo, return.
      902       end.
      903       for each  thbjattr_thbj-attr where
      904                 thbjattr_thbj-attr.obj-type = p-curr-obj-type
      905             and thbjattr_thbj-attr.obj-code = p-curr-obj-code
      906             and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
      907       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      908         case thbjattr_thbj-attr.prop-code:
      909           when 'autocomp':U then do:
      910             auto-comp = thbjattr_thbj-attr.property-value-logical.
      911           end.
      912           when 'autofbr':U then do:
      913             autofbr = thbjattr_thbj-attr.property-value-logical.
      914           end.
      915           when 'one-curs':U then do:
      916             one-curs = thbjattr_thbj-attr.property-value-logical.
      917           end.
      918           when 'restdish':U then do:
      919             restdish = thbjattr_thbj-attr.property-value-logical.
      920           end.
      921           when 'restingr':U then do:
      922             restingr = thbjattr_thbj-attr.property-value-logical.
      923           end.
      924           when 'resttpsi':U then do:
      925             resttpsi = thbjattr_thbj-attr.property-value-logical.
      926           end.
      927           when 'prcl-spl':U then do:
      928             prcl-spl = thbjattr_thbj-attr.property-value-logical.
      929           end.
      930           when 'pay-gds-algo':U then do:
      931             pay-gds-algo = thbjattr_thbj-attr.property-value-character.
      932           end.
      933           when 'sale-filter':U then do:
      934             sale-filter = thbjattr_thbj-attr.property-value-logical.
      935           end.
      936         end case.
      937         assign
      938         restdish = restdish and autofbr
      939         restingr = restingr and autofbr
      940         resttpsi = resttpsi and v-is-tpsi-obj
      941         .
      942       end.
      943       run adm/shattri.p (
      944           input "get":U
      945           ,input  p-curr-obj-type
      946           ,input  p-curr-obj-code
      947           ,input  'get-chk':U
      948           ,input  "":U
      949           ,output v-value-character
      950           ,output v-value-date
      951           ,output v-value-decimal
      952           ,output v-value-integer
      953           ,output v-value-logical
      954           ,output v-param-type
      955           ,INPUT-OUTPUT table-handle v-tth
      956           ) no-error .
      957       IF error-status:error then do:
      958         run write-to-log in p-log-handle (
      959               input substitute("Ошибка при получении опций закачик чеков НА ОБЪЕКТЕ &1&2:&3&4 &5"
      960                 , p-curr-obj-type
      961                 , p-curr-obj-code
      962                 , chr(10)
      963                 , error-status:get-message(1)
      964                 , return-value )).
      965          undo, return.
      966       end.
      967       for each  thbjattr_thbj-attr where
      968                 thbjattr_thbj-attr.obj-type = p-curr-obj-type
      969             and thbjattr_thbj-attr.obj-code = p-curr-obj-code
      970             and thbjattr_thbj-attr.upper-prop-code = 'get-chk':U
      971       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      972         case thbjattr_thbj-attr.prop-code:
      973           when 'cas-shft':U then do:
      974             assign
      975             cas-shft = thbjattr_thbj-attr.property-value-logical.
      976           end.
      977           when 'cas-curs':U then do:
      978             assign
      979             cas-curs = thbjattr_thbj-attr.property-value-logical.
      980           end.
      981         end case.
      982       end.
      983       assign
      984       rdtaxcd  = integer('3':U)
      985       exctaxcd = integer('4':U)
      986       btltaxcd = integer('3':U).
      987       _inkas:
      988       for each buf_inkas where
      989               buf_Inkas.obj-type = p-curr-obj-type
      990           AND buf_Inkas.obj-code = p-curr-obj-code
      991           AND buf_Inkas.status_ = 'новый':U,
      992         first buf_trn-doc where
      993              buf_trn-doc.doc-code = buf_inkas.inkas-code:
      994         if p-process-only-new then do:
      995           find first temp-inkas where temp-inkas.inkas-code = buf_inkas.inkas-code no-error.
      996           if not available temp-inkas then next _inkas.
      997         end.
      998         if buf_trn-doc.flag_ <> no then NEXT _inkas.
      999         assign
     1000         v-parameter =     string(if p-finalize then 3 else 2)
     1001                                                           + chr(4) +
     1002                           buf_inkas.inkas-code            + chr(4) +
     1003                           string(sale-filter)             + chr(4) +
     1004                           v-curr-r-b                      + chr(4) +
     1005                           string(is-wth)                  + chr(4) +
     1006                           string(cas-shft)                + chr(4) +
     1007                           string(one-curs)                + chr(4) +
     1008                           string(cas-curs)                + chr(4) +
     1009                           string(prcl-spl)                + chr(4) +
     1010                           pay-gds-algo                    + chr(4) +
     1011                           string(rdtaxcd)                 + chr(4) +
     1012                           string(exctaxcd)                + chr(4) +
     1013                           string(factorrt)                + chr(4) +
     1014                           string(btltaxcd)                + chr(4) +
     1015                           string(buf_shop.day-only)
     1016         .
     1017         run str/saleincl.p (
     1018                         input parparentproc
     1019                        ,input this-procedure
     1020                        ,input p-log-handle
     1021                        ,input v-parameter
     1022                        )  no-error.
     1023         if error-status:error
     1024         and return-value <> "error"
     1025         then do:
     1026           run write-to-log in p-log-handle (
     1027                 input substitute( "!!!Ошибка при закачке чеков в документ продажи &1 в &2&3&4" +
     1028                                   "&5 &6"
     1029                                 , buf_inkas.inkas-code
     1030                                 , p-curr-obj-type
     1031                                 , p-curr-obj-code
     1032                                 , chr(10)
     1033                                 , error-status:get-message(1)
     1034                                 , return-value
     1035                                 )            ).
     1036            next _inkas.
     1037         end.
     1038       end.
     1039     end.
     1040   end procedure.
     1041   procedure proc-step-200 :
     1042   define input parameter p-curr-obj-type    like ub.clients.obj-type no-undo .
     1043   define input parameter p-curr-obj-code    like ub.clients.obj-code no-undo .
     1044   define input parameter p-process-only-new as logical no-undo .
     1045   define input parameter p-finalize         as logical no-undo .
     1046   DEFINE VARIABLE compensed AS LOGICAL NO-UNDO.
     1047   DEFINE VARIABLE auto-comp AS LOGICAL NO-UNDO.
     1048   DEFINE VARIABLE autofbr AS LOGICAL NO-UNDO.
     1049   DEFINE VARIABLE one-curs AS LOGICAL NO-UNDO.
     1050   DEFINE VARIABLE restdish AS LOGICAL NO-UNDO.
     1051   DEFINE VARIABLE restingr AS LOGICAL NO-UNDO.
     1052   DEFINE VARIABLE resttpsi AS LOGICAL NO-UNDO.
     1053   define variable neg-tpsi-weight as logical no-undo .
     1054   define variable neg-tpsi-oper as logical no-undo .
     1055   define variable neg-tpsi-qnty as decimal no-undo .
     1056   DEFINE VARIABLE v-is-tpsi-obj AS LOGICAL NO-UNDO.
     1057   define variable v-parameter as character no-undo .
     1058   define variable v-param-type as character no-undo .
     1059   define variable v-value-character as character no-undo .
     1060   define variable v-value-date as date no-undo .
     1061   define variable v-value-decimal as decimal no-undo .
     1062   define variable v-value-integer as INTEGER no-undo .
     1063   define variable v-value-logical AS LOGICAL no-undo .
     1064   define variable v-tth as handle no-undo .
     1065   assign
     1066   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1067   DEFINE BUFFER buf_shop FOR ub.shop.
     1068   define buffer buf_inkas for ub.inkas.
     1069   define buffer buf_trn-doc for ub.trn-doc.
     1070     do
     1071     on error undo, return error
     1072     :
     1073      FIND FIRST buf_shop NO-LOCK WHERE
     1074                buf_shop.obj-code = p-curr-obj-code.
     1075      run gbl/tpsi-obj.p (
     1076                     input p-curr-obj-type
     1077                   , input p-curr-obj-code
     1078                   , output v-is-tpsi-obj) no-error .
     1079     for each thbjattr_thbj-attr:
     1080       delete thbjattr_thbj-attr.
     1081     end.
     1082     run adm/shattri.p (
     1083         input "get":U
     1084         ,input  p-curr-obj-type
     1085         ,input  p-curr-obj-code
     1086         ,input  'autosale':U
     1087         ,input  "":U
     1088         ,output v-value-character
     1089         ,output v-value-date
     1090         ,output v-value-decimal
     1091         ,output v-value-integer
     1092         ,output v-value-logical
     1093         ,output v-param-type
     1094         ,INPUT-OUTPUT table-handle v-tth
     1095         ) no-error .
     1096     IF error-status:error then do:
     1097       run write-to-log in p-log-handle (
     1098             input substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
     1099               , p-curr-obj-type
     1100               , p-curr-obj-code
     1101               , chr(10)
     1102               , error-status:get-message(1)
     1103               , return-value )).
     1104         undo, return.
     1105     end.
     1106     for each  thbjattr_thbj-attr where
     1107               thbjattr_thbj-attr.obj-type = p-curr-obj-type
     1108           and thbjattr_thbj-attr.obj-code = p-curr-obj-code
     1109           and thbjattr_thbj-attr.upper-prop-code = 'autosale':U
     1110     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     1111       case thbjattr_thbj-attr.prop-code:
     1112         when 'autofbr':U then do:
     1113           autofbr = thbjattr_thbj-attr.property-value-logical.
     1114         end.
     1115         when 'one-curs':U then do:
     1116           one-curs = thbjattr_thbj-attr.property-value-logical.
     1117         end.
     1118         when 'restdish':U then do:
     1119           restdish = thbjattr_thbj-attr.property-value-logical.
     1120         end.
     1121         when 'restingr':U then do:
     1122           restingr = thbjattr_thbj-attr.property-value-logical.
     1123         end.
     1124         when 'resttpsi':U then do:
     1125           resttpsi = thbjattr_thbj-attr.property-value-logical.
     1126         end.
     1127         when 'neg-tpsi-weight':U then do:
     1128           neg-tpsi-weight = thbjattr_thbj-attr.property-value-logical.
     1129         end.
     1130         when 'neg-tpsi-qnty':U then do:
     1131           neg-tpsi-qnty = thbjattr_thbj-attr.property-value-decimal.
     1132         end.
     1133         when 'neg-tpsi-oper':U then do:
     1134           neg-tpsi-oper = thbjattr_thbj-attr.property-value-logical.
     1135         end.
     1136       end case.
     1137       assign
     1138       restdish = restdish and autofbr
     1139       restingr = restingr and autofbr
     1140       resttpsi = resttpsi and v-is-tpsi-obj
     1141       .
     1142     end.
     1143       _inkas:
     1144       for each buf_inkas where
     1145               buf_Inkas.obj-type = p-curr-obj-type
     1146           AND buf_Inkas.obj-code = p-curr-obj-code
     1147           AND buf_Inkas.status_ = 'новый':U,
     1148           first buf_trn-doc where
     1149                 buf_trn-doc.doc-code = buf_inkas.inkas-code:
     1150         if p-process-only-new then do:
     1151           find first temp-inkas where temp-inkas.inkas-code = buf_inkas.inkas-code no-error.
     1152           if not available temp-inkas then next _inkas.
     1153         end.
     1154         assign
     1155         v-parameter =   v-curr-r-b                       + chr(4) +
     1156                         buf_inkas.inkas-code             + chr(4) +
     1157                         string(if p-finalize then 3 else 2)
     1158                                                          + chr(4) +
     1159                         string(autofbr)                  + chr(4) +
     1160                         string(buf_shop.is-catering)     + chr(4) +
     1161                         string(v-is-tpsi-obj)            + chr(4) +
     1162                         string(restdish)                 + chr(4) +
     1163                         string(restingr)                 + chr(4) +
     1164                         string(resttpsi)                 + chr(4) +
     1165                         string(neg-tpsi-weight)          + chr(4) +
     1166                         string(neg-tpsi-qnty)            + chr(4) +
     1167                         string(neg-tpsi-oper)
     1168         .
     1169   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Обработка продажи &1............"                                                      , buf_inkas.inkas-code)).
     1170         run str/salersrv.p (
     1171                         input parparentproc
     1172                        ,input this-procedure
     1173                        ,input p-log-handle
     1174                        ,input v-parameter
     1175                        )  no-error.
     1176         if error-status:error
     1177         and return-value <> "error"
     1178         then do:
     1179           run write-to-log in p-log-handle (
     1180                 input substitute( "!!!Ошибка при резервировании в документе продажи &1 в &2&3&4" +
     1181                                   "&5 &6"
     1182                                 , buf_inkas.inkas-code
     1183                                 , p-curr-obj-type
     1184                                 , p-curr-obj-code
     1185                                 , chr(10)
     1186                                 , error-status:get-message(1)
     1187                                 , return-value
     1188                                 )            ).
     1189            next _inkas.
     1190         end.
     1191       end.
     1192     end.
     1193   end procedure.
     1194   procedure proc-step-300 :
     1195   define input parameter p-curr-obj-type    like ub.clients.obj-type no-undo .
     1196   define input parameter p-curr-obj-code    like ub.clients.obj-code no-undo .
     1197   define input parameter p-process-only-new as logical no-undo .
     1198   DEFINE VARIABLE compensed AS LOGICAL NO-UNDO.
     1199   DEFINE VARIABLE auto-comp AS LOGICAL NO-UNDO.
     1200   DEFINE VARIABLE autofbr AS LOGICAL NO-UNDO.
     1201   DEFINE VARIABLE one-curs AS LOGICAL NO-UNDO.
     1202   DEFINE VARIABLE restdish AS LOGICAL NO-UNDO.
     1203   DEFINE VARIABLE restingr AS LOGICAL NO-UNDO.
     1204   DEFINE VARIABLE resttpsi AS LOGICAL NO-UNDO.
     1205   define variable neg-tpsi-weight as logical no-undo .
     1206   define variable neg-tpsi-oper as logical no-undo .
     1207   define variable neg-tpsi-qnty as decimal no-undo .
     1208   define variable close-in-rfsl as integer no-undo .
