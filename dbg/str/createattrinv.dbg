     1234       run adm/shattri.p (
     1235           input "get":U
     1236           ,input  p-curr-obj-type
     1237           ,input  p-curr-obj-code
     1238           ,input  'autosale':U
     1239           ,input  "":U
     1240           ,output v-value-character
     1241           ,output v-value-date
     1242           ,output v-value-decimal
     1243           ,output v-value-integer
     1244           ,output v-value-logical
     1245           ,output v-param-type
     1246           ,INPUT-OUTPUT table-handle v-tth
     1247           ) no-error .
     1248       IF error-status:error then do:
     1249         run write-to-log in p-log-handle (
     1250               input substitute("Ошибка при получении опций продажи НА ОБЪЕКТЕ &1&2:&3&4 &5"
     1251                 , p-curr-obj-type
     1252                 , p-curr-obj-code
     1253                 , chr(10)
     1254                 , error-status:get-message(1)
     1255                 , return-value )).
     1256          undo, return.
     1257       end.
     1258       for each  thbjattr_thbj-attr where
