     1309           AND buf_Inkas.obj-code = p-curr-obj-code
     1310           AND buf_Inkas.status_ = 'нередакт':U:
     1311         if p-process-only-new then do:
     1312           find first temp-inkas where temp-inkas.inkas-code = buf_inkas.inkas-code no-error.
     1313           if not available temp-inkas then next _inkas.
     1314         end.
     1315         assign
     1316         v-parameter =   v-curr-r-b                       + chr(4) +
     1317                         buf_inkas.inkas-code             + chr(4) +
     1318                         string(2)              + chr(4) +
     1319                         string(YES)        + chr(4) +
     1320                         string(no)     + chr(4) +
     1321                         string(auto-comp)                + chr(4) +
     1322                         string(autofbr)                  + chr(4) +
     1323                         string(one-curs)                 + chr(4) +
     1324                         string(buf_shop.is-catering)     + chr(4) +
     1325                         string(v-is-tpsi-obj)            + chr(4) +
     1326                         string(restdish)                 + chr(4) +
     1327                         string(restingr)                 + chr(4) +
     1328                         string(resttpsi)                 + chr(4) +
     1329                         string(neg-tpsi-weight)          + chr(4) +
     1330                         string(neg-tpsi-qnty)            + chr(4) +
     1331                         string(neg-tpsi-oper)            + chr(4) +
     1332                         string(close-in-rfsl)            + chr(4) +
     1333                         pay-gds-algo
     1334         .
     1335   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Обработка продажи &1........."                                                      , buf_inkas.inkas-code)).
     1336         run str/saleclos.p (
     1337                         input parparentproc
     1338                        ,input this-procedure
     1339                        ,input p-log-handle
     1340                        ,input v-parameter
     1341                        )  no-error.
     1342         if error-status:error
