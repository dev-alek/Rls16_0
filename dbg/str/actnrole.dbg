      134   define temp-table temp_actntw_items no-undo
      135       field itm-key       as integer
      136       field itmExtKey     as character
      137       field itmType       as character
      138       field itmName       as character
      139       field itmDesc       as character
      140       field itmGdsList    as character
      141       field itmGds        as logical
      142       field itmGrpList    as character
      143       field itmGrp        as logical
      144       field itmSelected   as logical
      145       field selLeft       as logical
      146       field selRight      as logical
      147       index pi is primary unique
      148           itm-key
      149       index ie
      150           itmExtKey
      151       index tp
      152           itmType
      153           itmName
      154       index sel
      155           itmSelected
      156   .
      157   define temp-table temp_actntw_itemsSelected no-undo
      158       field its-key       as integer
      159       field itm-key       as integer
      160       field itmExtKey     as character
      161       field itmGdsList    as character
      162       field itmGds        as logical
      163       field itmGrpList    as character
      164       field itmGrp        as logical
      165       index pi is primary unique
      166           its-key
      167       index im
      168           itm-key
      169   .
      170   define variable v-actntw2-itm-key    as integer      no-undo.
      171   procedure actntw_clear :
      172       define buffer buf_temp_actntw_items        for temp_actntw_items.
      173   do
      174   for buf_temp_actntw_items
      175   on error undo, return error
      176   :
      177       empty temp-table buf_temp_actntw_items.
      178   end.
      179   end procedure.
      180   procedure actntw_add-item :
      181   define input parameter p-ext-key   as character        no-undo.
      182   define input parameter p-item-type as character        no-undo.
      183   define input parameter p-item-name as character        no-undo.
      184   define input parameter p-item-desc as character        no-undo.
      185   define input parameter p-selected  as logical          no-undo.
      186   define input parameter p-gds       as logical          no-undo.
      187   define input parameter p-grp       as logical          no-undo.
      188   define input parameter p-list      as character        no-undo.
      189       define buffer buf_temp_actntw_items        for temp_actntw_items.
      190   do
      191   for buf_temp_actntw_items
      192   on error undo, return error
      193   :
      194       assign
      195           v-actntw2-itm-key = v-actntw2-itm-key + 1
      196       .
      197       create temp_actntw_items.
      198       assign
      199           temp_actntw_items.itm-key      = v-actntw2-itm-key
      200           temp_actntw_items.itmExtKey    = p-ext-key
      201           temp_actntw_items.itmType      = p-item-type
      202           temp_actntw_items.itmName      = p-item-name
      203           temp_actntw_items.itmDesc      = p-item-desc
      204           temp_actntw_items.itmSelected  = p-selected
      205           temp_actntw_items.selLeft      = no
      206           temp_actntw_items.selRight     = no
      207           temp_actntw_items.itmGds       = p-gds
      208           temp_actntw_items.itmGrp       = p-grp
      209           temp_actntw_items.itmGdsList   = IF p-gds THEN p-list ELSE "":U
      210           temp_actntw_items.itmGrpList   = IF p-grp THEN p-list ELSE "":U
      211       .
      212   end.
      213   end procedure.
      214   define variable vss-include-info3 as character format "X(65)" no-undo
      215   initial "@(#)$Workfile$ $Revision$".
      216   define temp-table temp_onewin_items no-undo
      217       field itm-key       as integer
      218       field itmExtKey     as character
      219       field itmName       as character
      220       field itmDesc       as character
      221       field itmSelected   as logical
      222       index pi is primary unique
      223           itm-key
      224       index ie
      225           itmExtKey
      226   .
      227   define temp-table temp_onewin_itemsSelected no-undo
      228       field its-key   as integer
      229       field itm-key   as integer
      230       field itmExtKey as character
      231       index pi is primary unique
      232           its-key
      233       index im
      234           itm-key
      235   .
      236   define variable v-onewin3-itm-key    as integer      no-undo.
      237   procedure onewin_clear :
      238       define buffer buf_temp_onewin_items        for temp_onewin_items.
      239   do
      240   for buf_temp_onewin_items
      241   on error undo, return error
      242   :
      243       empty temp-table buf_temp_onewin_items.
      244   end.
      245   end procedure.
      246   procedure onewin_add-item :
      247   define input parameter p-ext-key   as character        no-undo.
      248   define input parameter p-item-name as character        no-undo.
      249   define input parameter p-item-desc as character        no-undo.
      250   define input parameter p-selected  as logical          no-undo.
      251       define buffer buf_temp_onewin_items        for temp_onewin_items.
      252   do
      253   for buf_temp_onewin_items
      254   on error undo, return error
      255   :
      256       find last buf_temp_onewin_items no-error.
      257       if available buf_temp_onewin_items then do:
      258         v-onewin3-itm-key = buf_temp_onewin_items.itm-key.
      259       end.
      260       else do:
      261         v-onewin3-itm-key = 0.
      262       end.
      263       assign
      264           v-onewin3-itm-key = v-onewin3-itm-key + 1
      265       .
      266       create buf_temp_onewin_items.
      267       assign
      268       buf_temp_onewin_items.itm-key      = v-onewin3-itm-key
      269       buf_temp_onewin_items.itmExtKey    = p-ext-key
      270       buf_temp_onewin_items.itmName      = p-item-name
      271       buf_temp_onewin_items.itmDesc      = p-item-desc
      272       buf_temp_onewin_items.itmSelected  = p-selected
      273       .
      274   end.
      275   end procedure.
      276   procedure onewin_create-selection :
      277   define input parameter p-itm-key as integer no-undo .
      278   define input parameter p-itmextkey as character no-undo .
      279   define variable v-counter as integer no-undo .
      280   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      281   do
      282   on error undo, return error
      283   :
      284     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      285     if available buf_temp_onewin_itemsSelected then do:
      286       v-counter = buf_temp_onewin_itemsSelected.its-key.
      287     end.
      288     find first buf_temp_onewin_itemsSelected where
      289          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      290     if not available buf_temp_onewin_itemsSelected then do:
      291       create buf_temp_onewin_itemsSelected.
      292       assign
      293       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      294       v-counter = v-counter + 1
      295       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      296       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      297       .
      298     end.
      299   end.
      300   end procedure.
      301   procedure onewin_check-item :
      302   define input parameter p-ext-key   as character        no-undo.
      303   define output parameter p-exists as logical no-undo .
      304   define buffer buf_temp_onewin_items for temp_onewin_items.
      305   find first buf_temp_onewin_items where
      306   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      307   if available buf_temp_onewin_items then do:
      308     p-exists = yes.
      309   end.
      310   end procedure.
      311   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      313   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      314   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      315   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      316   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      317   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      318   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      319   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      320   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      321   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      322   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      323   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      324   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      325   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      326   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      327   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      328   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      329   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330   define variable v-waitfram-action01         as character   no-undo .
      331   define variable v-waitfram-action02         as character   no-undo .
      332   define variable v-waitfram-action03         as character   no-undo .
      333   define variable mWaitFramTextBeg            as character   no-undo.
      334   define variable mWaitFramTextEnd            as character   no-undo.
      335   define variable mWaitFramView               as logical     no-undo.
      336   define variable mWaitProcEvent              as logical     no-undo init yes.
      337   define variable mWaitFramInterval           as integer     no-undo init 1 .
      338   define variable mWaitFramStop               as logical     no-undo.
      339   define variable mWaitFramStopUser           as logical     no-undo.
      340   define variable mWaitFramStopTimeOut        as logical     no-undo.
      341   define variable mWaitFramStartProc          as datetime-tz no-undo.
      342   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      343   define button B-WaitFramStop auto-end-key
      344        label "Стоп"
      345        size 10 by 1 tooltip "Остоновить процесс".
      346   define button B-viewProcInfo
      347        label "Информация"
      348        size 15 by 1 tooltip "Информация о процесс".
      349   define frame waitfram
      350     v-waitfram-action01 format "x(72)" no-label skip
      351     v-waitfram-action02 format "x(72)" no-label skip
      352     v-waitfram-action03 format "x(72)" no-label skip
      353     B-viewProcInfo
      354     B-WaitFramStop at row 4 col 30
      355     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      356     .
      357   define new global shared variable mBatchMode as logical no-undo init ?.
      358   define variable mFramBachModHandle as handle no-undo.
      359   mFramBachModHandle = frame waitfram:handle.
      360   define variable mFameOldVis as logical no-undo.
      361   define variable mVisCUrentVin as logical no-undo.
      362   if session:batch-mode
      363   then
      364      mBatchMode = yes.
      365   if mBatchMode = ? then do:
      366     mVisCUrentVin = current-window:visible.
      367     mFameOldVis = mFramBachModHandle:visible.
      368     mFramBachModHandle:visible  = yes.
      369     mBatchMode = mFramBachModHandle:visible ne yes.
      370     mFramBachModHandle:visible = mFameOldVis.
      371     current-window:visible = mVisCUrentVin.
      372   end.
      373    if  log-manager:logfile-name ne ?
      374     then DO:
      375         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      376         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      377         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      378     end.
      379   on choose of B-WaitFramStop in frame waitfram
      380   do:
      381     mWaitFramStop = yes.
      382     mWaitFramStopUser = yes.
      383   end.
      384   function waitfram-check-timeout returns logical():
      385      define variable vtime as int64 no-undo.
      386      if mWaitFramStopTimeOut
      387      then
      388         return yes.
      389      vtime = ( now - mWaitFramStartProc ) / 1000 .
      390      if     mWaitFramTimeOut ne ?
      391         and mWaitFramTimeOut ne 0
      392         and mWaitFramTimeOut lt vtime
      393      then do:
      394         mWaitFramStopTimeOut = yes.
      395      end.
      396      return mWaitFramStopTimeOut.
      397   end.
      398   procedure waitfram-hide :
      399     if not session:batch-mode
      400     then do
      401     on error undo, return error return-value
      402     :
      403       pause 0 before-hide .
      404       if not mBatchMode then
      405         hide frame waitfram .
      406     if     not mWaitFramView
      407        and mWaitProcEvent
      408     then
      409       process events .
      410     end.
      411   end procedure.
      412   procedure waitfram-show :
      413     define input  parameter p-message as character no-undo .
      414     define variable v-left-margin as integer   no-undo .
      415     if not session:batch-mode
      416     then do
      417     on error undo, return error return-value
      418     :
      419       if length(p-message) <= 70 then do:
      420         assign
      421           v-left-margin = integer((70 - length(p-message)) / 2)
      422         .
      423         assign
      424           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      425         .
      426         assign
      427           v-waitfram-action01 = " "
      428           v-waitfram-action02 = " "
      429                                    + fill(" ", v-left-margin)
      430                                    + p-message
      431           v-waitfram-action03 = " "
      432         .
      433       end.
      434       else do:
      435         define variable vRindex1 as integer no-undo.
      436         define variable vRindex2 as integer no-undo.
      437         vRindex1 = r-index(p-message," ",70).
      438         if vRindex1 = 0
      439         then
      440            vRindex1 = 70.
      441         if length(p-message)  <= vRindex1 + 70 then do:
      442           assign
      443             v-waitfram-action01 = " "
      444             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      445             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      446           .
      447         end.
      448         else do:
      449           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      450           if vRindex2 <= vRindex1
      451           then
      452              vRindex2 = vRindex1 + 70.
      453           assign
      454             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      455             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      456             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      457           .
      458         end.
      459       end.
      460       B-viewProcInfo:visible   in frame waitfram = no.
      461       B-viewProcInfo:sensitive in frame waitfram = no.
      462       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      463       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      464       if  (   mWaitFramView
      465          or  mWaitProcEvent)
      466          and not mBatchMode
      467       then
      468          display
      469             v-waitfram-action01 skip
      470             v-waitfram-action02 skip
      471             v-waitfram-action03 skip
      472          with frame waitfram .
      473       if     mWaitFramView
      474          then do:
      475             if     mWaitFramInterval ne ?
      476                and not mBatchMode
      477             then
      478                wait-for go of frame waitfram pause mWaitFramInterval.
      479          end.
      480          else
      481             if     mWaitProcEvent
      482                and not mBatchMode
      483             then
      484                process events .
      485     end.
      486   end procedure.
      487      procedure waitfram-show-this:
      488         define input  parameter iInterval as int64 no-undo.
      489         define variable vtime as int64 no-undo.
      490         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      491         mWaitFramInterval = iInterval.
      492         run waitfram-show (substitute("&1&2 &3&4" ,
      493                                       mWaitFramTextBeg ,
      494                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      495                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      496                                       mWaitFramTextEnd
      497                                      )
      498                           ).
      499      end.
      500      procedure WaitFramRunPause:
      501         define input  parameter iInterval as dec no-undo.
      502         define variable vStart  as datetime-tz no-undo.
      503         define variable vend    as datetime-tz no-undo.
      504         define variable vint as int64 no-undo.
      505         define variable vOk as logical no-undo.
      506         vStart = now.
      507         vend   = vStart.
      508         publish "WaitFramPause" (iInterval,output vOk).
      509         vend   =  now.
      510         vint = vend - vStart.
      511         vint = iInterval - vint / 1000.
      512         if     not mWaitFramStop
      513            and (   vint > 0
      514                 or (    not vOk
      515                     and iInterval eq ?
      516                     )
      517                 )
      518         then
      519            run waitfram-show-this (iInterval).
      520         vend   =  now.
      521         vint = vend - vStart.
      522         vint = iInterval - vint / 1000.
      523         if     not mWaitFramStop
      524            and vint > 0
      525         then do:
      526            run gbl/pause.p (vint * 1000).
      527         end.
      528         if iInterval ne ?
      529         then
      530            publish "WaitFramStop".
      531         waitfram-check-timeout().
      532      end.
      533      procedure WaitFramWaitFor:
      534         define input  parameter iInterval as dec no-undo.
      535         assign
      536            mWaitFramStartProc   = now
      537            mWaitFramStopUser    = no
      538            mWaitFramStopTimeOut = no
      539         .
      540         block-wait:
      541         do while not mWaitFramStop:
      542            run WaitFramRunPause (iInterval).
      543            if  waitfram-check-timeout()
      544            then do:
      545               leave block-wait.
      546            end.
      547         end.
      548         run waitfram-hide.
      549      end.
      550   procedure waitfram-join :
      551     define input  parameter p-line-1  as character no-undo .
      552     define input  parameter p-line-2  as character no-undo .
      553     define input  parameter p-line-3  as character no-undo .
      554     define output parameter p-message as character no-undo .
      555     do
      556     on error undo, return error return-value
      557     :
      558       assign
      559         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      560                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      561                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      562       .
      563     end.
      564   end procedure.
      565   function waitfram-join-function returns character
      566     (input p-line-1 as character
      567     ,input p-line-2 as character
      568     ,input p-line-3 as character
      569     ).
      570     define variable v-message as character no-undo .
      571     run waitfram-join in this-procedure
      572       (input  p-line-1
      573       ,input  p-line-2
      574       ,input  p-line-3
      575       ,output v-message
      576       ) .
      577     return v-message .
      578   end function .
      579   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   define new shared stream PrnLibStream.
      581   procedure prn-lib-prn-file :
      582     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      583     define input parameter p-DIsabledoptions as integer no-undo .
      584     define variable v-report-name as character no-undo .
      585     define variable v-user-action as character no-undo .
      586     define variable v-printed     as logical   no-undo .
      587     define variable v-exist       as logical   no-undo .
      588     do
      589       on error undo, return error
      590       :
      591       run prn-lib-get-report-name  in this-procedure (
      592         input parParentProc
      593         ,output v-report-name
      594         ).
      595   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      596   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      597     (input  v-report-name
      598     ,input  2
      599     ,output v-exist
      600     )  .
      601       if NOT v-exist then
      602       DO:
      603         Message
      604           "Нет заданий на печать ! "
      605           view-as alert-box .
      606         Return  .
      607       End.
      608       run gbl/prnfilen.w
      609         (input  ""
      610         ,input  p-DisabledOptions
      611         ,input  string(v-report-name )
      612         ,input  7
      613         ,output v-user-action
      614         ,output v-printed
      615         ) .
      616       if v-printed then
      617       do:
      618         return "YES" .
      619       end.
      620       else
      621       do:
      622         return "NO" .
      623       end.
      624     end.
      625   end procedure.
      626   procedure prn-lib-open-stream :
      627     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      628     define input parameter p-page-size    as integer no-undo .
      629     define input parameter p-is-stream    as logical no-undo .
      630     define input parameter p-append       as logical no-undo .
      631     define variable v-report-name as character no-undo .
      632     do
      633       on error undo, return error
      634       :
      635       run prn-lib-get-report-name  in this-procedure (
      636         input parParentProc
      637         ,output v-report-name
      638         ).
      639       if p-is-stream then
      640       do:
      641         if p-append then
      642         do:
      643           output stream PrnLibStream to value( v-report-name )
      644             page-size value(p-page-size) append .
      645         end.
      646         if not p-append then
      647         do:
      648           output stream PrnLibStream to value( v-report-name )
      649             page-size value(p-page-size) .
      650         end.
      651       end.
      652       if not p-is-stream then
      653       do:
      654         if p-append then
      655         do:
      656           output to value( v-report-name )
      657             page-size value(p-page-size) append .
      658         end.
      659         if not p-append then
      660         do:
      661           output to value( v-report-name )
      662             page-size value(p-page-size) .
      663         end.
      664       end.
      665     end.
      666   end procedure.
      667   procedure prn-lib-open-exp :
      668     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      669     define input parameter p-is-stream    as logical no-undo .
      670     define input parameter p-is-append    as logical no-undo .
      671     define output parameter p-ReportFileName as char init "report" no-undo.
      672     define output parameter p-process as logical no-undo .
      673     define variable glog as logical no-undo .
      674     do
      675       on error undo, return error
      676       :
      677       SYSTEM-DIALOG GET-FILE p-ReportFileName
      678         TITLE      "Укажите путь"
      679         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      680         ASK-OVERWRITE
      681         CREATE-TEST-FILE
      682         SAVE-AS
      683         USE-FILENAME
      684         DEFAULT-EXTENSION "txt"
      685         UPDATE glog
      686         .
      687       if not glog then  return.
      688       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      689       if p-is-stream then
      690       do:
      691         if p-is-append then
      692         do:
      693           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      694         end.
      695         else
      696         do:
      697           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      698         end.
      699       end.
      700       else
      701       do:
      702         if p-is-append then
      703         do:
      704           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      705         end.
      706         else
      707         do:
      708           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      709         end.
      710       end.
      711       p-process = yes.
      712     end.
      713   end procedure.
      714   procedure prn-lib-get-report-name :
      715     define input parameter parParentProc  as widget-handle no-undo.
      716     define output parameter p-report-name as character no-undo .
      717     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      718   end procedure.
      719   procedure prn-lib-reportviewer-report-name :
      720     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      721     define input parameter p-report-name-html as character no-undo .
      722     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      723   end procedure.
      724   procedure prn-lib-reportviewer :
      725     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      726     define input parameter p-report-name-html as character no-undo .
      727     define input parameter p-param        as character no-undo .
      728     define variable v-excel           as character no-undo init 'TRUE' .
      729     define variable v-value-character as character no-undo .
      730     define variable v-value-integer   as character no-undo .
      731     define variable v-value-date      as date      no-undo .
      732     define variable v-value-decimal   as decimal   no-undo .
      733     define variable rep-excel         as logical   no-undo .
      734     define variable excel-string      as character no-undo .
      735     define variable v-param-type      as character no-undo .
      736     define variable v-tth             as handle    no-undo .
      737     run adm/shattri.p (
      738       input "get":U
      739       ,input  ""
      740       ,input  0
      741       ,input  'report-glob':U
      742       ,input  'rep-excel':U
      743       ,output v-value-character
      744       ,output v-value-date
      745       ,output v-value-decimal
      746       ,output v-value-integer
      747       ,output rep-excel
      748       ,output v-param-type
      749       ,INPUT-OUTPUT table-handle v-tth
      750       )  .
      751     if rep-excel then v-excel = "TRUE" .
      752     else v-excel = "FALSE" .
      753     if p-param eq ""
      754     then
      755        p-param = "EXCEL:" + v-excel.
      756     else
      757        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      758     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      759   end procedure.
      760   define stream OutStr-html.
      761   define variable v-current-db-num              as integer   no-undo .
      762   define variable v-can-edit-action-role        as logical   no-undo .
      763   define variable v-current-db-num-screen-value as character no-undo .
      764   define variable v-current-context             as character no-undo .
      765   define variable v-on-gbl                      as logical   no-undo.
      766   define variable v-action-role-context         as character no-undo format "x(8)" column-label "Контекст".
      767   define variable v-action-role-item-state      as character no-undo format "x(3)" column-label "Вкл" .
      768   define variable v-action-role-select          as character no-undo format "x(1)" column-label "*" .
      769   DEFINE VARIABLE g#log                         AS LOGICAL   NO-UNDO.
      770   define variable v-ok                          as logical   no-undo .
      771   define temp-table temp_filter-fields no-undo
      772       field action-role-code as integer
      773       field record-on        as logical
      774       index pi is primary unique
      775       action-role-code
      776       .
      777   define temp-table temp_actnrole-user no-undo
      778       field user-id    as character
      779       field nik        as character
      780       field lastName   as character
      781       field firstName  as character
      782       field secondName as character
      783       index pi is primary unique
      784       user-id
      785       .
      786   define temp-table temp_filter-fields-item no-undo
      787       field action-item-code as integer
      788       field record-on        as logical INIT YES
      789       index pi is primary unique
      790       action-item-code
      791       .
      792   FUNCTION get-action-role-context RETURNS CHARACTER
      793       ( BUFFER buf_action-role FOR action-role )  FORWARD.
      794   FUNCTION get-action-role-item-state RETURNS CHARACTER
      795       ( BUFFER buf_action-item FOR action-item )  FORWARD.
      796   DEFINE BUTTON b-add
      797       LABEL "&Добавить"
      798       SIZE 9 BY 1 TOOLTIP "Добавить группу прав".
      799   DEFINE BUTTON b-chg
      800       LABEL "&Изменить"
      801       SIZE 9 BY 1 TOOLTIP "Изменить группу прав".
      802   DEFINE BUTTON b-del
      803       LABEL "&Удалить"
      804       SIZE 9 BY 1 TOOLTIP "Удалить группу прав".
      805   DEFINE BUTTON b-filter-item DEFAULT
      806       LABEL "&ФПоиск"
      807       SIZE 10 BY 1 TOOLTIP "Поиск с фильтром строки во всех текстовых полях"
      808       BGCOLOR 8 .
      809   DEFINE BUTTON b-filter-role
      810       LABEL "Ф&Поиск"
      811       SIZE 10 BY 1 TOOLTIP "Поиск с фильтрацией строки во всех текстовых полях формы".
      812   DEFINE BUTTON b-help
      813       LABEL "&Помощь"
      814       SIZE 10 BY 1
      815       BGCOLOR 8 .
      816   DEFINE BUTTON b-hist
      817       LABEL "Печать"
      818       SIZE 3 BY 1.
      819   DEFINE BUTTON b-mark
      820       LABEL "&*"
      821       SIZE 3 BY 1.
      822   DEFINE BUTTON b-print
      823       LABEL "Печать"
      824       SIZE 9.63 BY .96.
      825   DEFINE BUTTON b-quit AUTO-END-KEY
      826       LABEL "&Выход"
      827       SIZE 10 BY 1
      828       BGCOLOR 8 .
      829   DEFINE BUTTON b-sel AUTO-GO
      830       LABEL "Вы&брать"
      831       SIZE 10 BY 1.
      832   DEFINE BUTTON b-set-current-db
      833       LABEL "Тек"
      834       SIZE 5 BY 1 TOOLTIP "Выбрать текущую базу данных".
      835   DEFINE BUTTON b-toggle
      836       LABEL "&Права"
      837       SIZE 10 BY 1 TOOLTIP "Изменить список прав, привязанных к группе".
      838   DEFINE BUTTON b-users
      839       LABEL "&Польз"
      840       SIZE 9 BY 1 TOOLTIP "Список пользователей с выбранной группой прав".
      841   DEFINE VARIABLE cb-db          AS CHARACTER FORMAT "X(256)":U
      842       LABEL "БД"
      843       VIEW-AS COMBO-BOX INNER-LINES 5
      844       LIST-ITEMS "Item 1"
      845       DROP-DOWN-LIST
      846       SIZE 12.63 BY 1 NO-UNDO.
      847   DEFINE VARIABLE item-EDITOR    AS CHARACTER
      848       VIEW-AS EDITOR SCROLLBAR-VERTICAL
      849       SIZE 58 BY 1.58 TOOLTIP "описание права"
      850       FGCOLOR 4 NO-UNDO.
      851   DEFINE VARIABLE role-editor    AS CHARACTER
      852       VIEW-AS EDITOR SCROLLBAR-VERTICAL
      853       SIZE 39.63 BY 1.58 TOOLTIP "Описание группы"
      854       FGCOLOR 4 NO-UNDO.
      855   DEFINE VARIABLE v-filter-item  AS CHARACTER FORMAT "X(256)":U
      856       VIEW-AS FILL-IN
      857       SIZE 20.75 BY 1 NO-UNDO.
      858   DEFINE VARIABLE v-filter-role  AS CHARACTER FORMAT "X(40)":U
      859       VIEW-AS FILL-IN
      860       SIZE 25 BY 1
      861       FGCOLOR 4 NO-UNDO.
      862   DEFINE VARIABLE rs-scope       AS INTEGER
      863       VIEW-AS RADIO-SET HORIZONTAL
      864       RADIO-BUTTONS
      865       "Все", 1,
      866       "Без привязки", 2,
      867       "Фирма", 3,
      868       "Объект", 4
      869       SIZE 40.63 BY .75
      870       FGCOLOR 4 NO-UNDO.
      871   DEFINE VARIABLE tb-filter-item AS LOGICAL   INITIAL no
      872       LABEL ""
      873       VIEW-AS TOGGLE-BOX
      874       SIZE 2.63 BY .79 TOOLTIP "Снятие поиска с фильтром" NO-UNDO.
      875   DEFINE VARIABLE tb-filter-role AS LOGICAL   INITIAL no
      876       LABEL ""
      877       VIEW-AS TOGGLE-BOX
      878       SIZE 2.63 BY .79 TOOLTIP "Временно отключить фильтрацию" NO-UNDO.
      879   DEFINE QUERY browse-action-item FOR
      880       action-item,
      881       temp_filter-fields-item,
      882       action-group,
      883       action-role-item SCROLLING.
      884   DEFINE QUERY browse-action-role FOR
      885       action-role,
      886       temp_filter-fields SCROLLING.
      887   DEFINE BROWSE browse-action-item
      888       QUERY browse-action-item DISPLAY
      889       action-group.action-group-name format "X(14)" column-label "Тема"
      890       action-item.action-item-name format "X(58)"
      891       action-item.action-item-id column-label "Идентификатор"
      892       WITH NO-ROW-MARKERS SEPARATORS SIZE 58 BY 16.75.
      893   DEFINE BROWSE browse-action-role
      894       QUERY browse-action-role DISPLAY
      895       mark-string(recid(action-role), p-rid-list) @ v-action-role-select
      896       get-action-role-context(BUFFER action-role) @ v-action-role-context COLUMN-LABEL "Привязка" format "x(12)"
      897       action-role.db-num column-label "БД"
      898       action-role.action-role-name COLUMN-LABEL "Название группы прав"
      899       action-role.action-role-description
      900       WITH NO-ROW-MARKERS SEPARATORS SIZE 39.63 BY 16.75 ROW-HEIGHT-CHARS .53.
      901   DEFINE FRAME Dialog-Frame
      902       b-quit AT ROW 1 COL 1
      903       b-sel AT ROW 1 COL 11 WIDGET-ID 16
      904       cb-db AT ROW 1 COL 68.63 COLON-ALIGNED WIDGET-ID 2
      905       b-set-current-db AT ROW 1 COL 83 WIDGET-ID 4
      906       b-help AT ROW 1 COL 89.63
      907       rs-scope AT ROW 1.25 COL 23.63 NO-LABEL WIDGET-ID 42
      908       b-print AT ROW 1.96 COL 90 WIDGET-ID 70
      909       b-mark AT ROW 2 COL 1 WIDGET-ID 14
      910       b-add AT ROW 2 COL 4 WIDGET-ID 6
      911       b-chg AT ROW 2 COL 13 WIDGET-ID 10
      912       b-del AT ROW 2 COL 22 WIDGET-ID 8
      913       b-toggle AT ROW 2 COL 31 WIDGET-ID 12
      914       b-users AT ROW 2 COL 41 WIDGET-ID 48
      915       b-hist AT ROW 2 COL 87 WIDGET-ID 74
      916       b-filter-role AT ROW 3 COL 1 WIDGET-ID 24
      917       v-filter-role AT ROW 3 COL 10 COLON-ALIGNED NO-LABEL WIDGET-ID 28 NO-TAB-STOP
      918       tb-filter-role AT ROW 3 COL 38 WIDGET-ID 52
      919       b-filter-item AT ROW 3 COL 63.63 WIDGET-ID 64 NO-TAB-STOP
      920       v-filter-item AT ROW 3 COL 71.75 COLON-ALIGNED NO-LABEL WIDGET-ID 66
      921       tb-filter-item AT ROW 3 COL 95.63 WIDGET-ID 68
      922       browse-action-role AT ROW 4.25 COL 1 WIDGET-ID 200
      923       browse-action-item AT ROW 4.25 COL 41.63 WIDGET-ID 300
      924       role-editor AT ROW 21.25 COL 1 NO-LABEL WIDGET-ID 20
      925       item-EDITOR AT ROW 21.25 COL 41.63 NO-LABEL WIDGET-ID 22
      926       SPACE(0.00) SKIP(0.27)
      927       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      928       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      929       TITLE "Группы прав"
      930       DEFAULT-BUTTON b-quit CANCEL-BUTTON b-quit WIDGET-ID 100.
      931   ASSIGN
      932       FRAME Dialog-Frame:SCROLLABLE = FALSE
      933       FRAME Dialog-Frame:HIDDEN     = TRUE.
      934   ASSIGN
      935       b-set-current-db:HIDDEN IN FRAME Dialog-Frame = TRUE.
      936   ASSIGN
      937       cb-db:HIDDEN IN FRAME Dialog-Frame = TRUE.
      938   ASSIGN
      939       item-EDITOR:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      940   ASSIGN
      941       role-editor:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      942   ASSIGN
      943       v-filter-item:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      944   ASSIGN
      945       v-filter-role:READ-ONLY IN FRAME Dialog-Frame = TRUE.
      946   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      947       DO:
      948           APPLY "END-ERROR":U TO SELF.
      949       END.
      950   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      951       DO:
      952           DEFINE VARIABLE v-recid AS RECID NO-UNDO.
      953           run str/actnrold.w ( INPUT parparentproc
      954               , INPUT FALSE
      955               , INPUT-OUTPUT v-recid
      956               ) NO-ERROR.
      957           IF ERROR-STATUS:ERROR THEN
      958           DO:
      959               MESSAGE RETURN-VALUE SKIP
      960                   ERROR-STATUS:GET-MESSAGE(1)
      961                   VIEW-AS ALERT-BOX.
      962               UNDO, RETURN NO-APPLY.
      963           END.
      964           run assign-filter-mark-role in this-procedure ( input v-filter-role ) .
      965           RUN enable_UI.
      966           RUN post_enable_UI.
      967           run set-brw-pos in this-procedure ( input v-recid ).
      968           run refresh-query-action-item in this-procedure .
      969       END.
      970   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      971       DO:
      972           DEFINE VARIABLE v-recid AS RECID   NO-UNDO.
      973           define variable v-ok    as logical no-undo.
      974           IF AVAILABLE action-role THEN
      975           DO:
      976               ASSIGN
      977                   v-recid = RECID(action-role)
      978                   .
      979               run str/actnrold.w ( INPUT parparentproc
      980                   , INPUT TRUE
      981                   , INPUT-OUTPUT v-recid
      982                   ) NO-ERROR.
      983               IF ERROR-STATUS:ERROR THEN
      984               DO:
      985                   MESSAGE RETURN-VALUE SKIP
      986                       ERROR-STATUS:GET-MESSAGE(1)
      987                       VIEW-AS ALERT-BOX.
      988                   UNDO, RETURN NO-APPLY.
      989               END.
      990               v-ok = browse-action-role:refresh( )  in frame Dialog-Frame.
      991           END.
      992       END.
      993   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      994       DO:
      995           IF AVAILABLE action-role THEN
      996           DO:
      997               RUN delete-action-role IN THIS-PROCEDURE.
      998               run enable_UI IN THIS-PROCEDURE .
      999               RUN post_enable_UI IN THIS-PROCEDURE.
     1000           END.
     1001       END.
     1002   ON CHOOSE OF b-filter-item IN FRAME Dialog-Frame
     1003       DO:
     1004           define variable v-new-filter as character no-undo.
     1005           define variable v-accepted   as logical   no-undo.
     1006           run gbl/twowinf.w (
     1007               input v-filter-item
     1008               , output v-new-filter
     1009               , output v-accepted
     1010               ).
     1011           if v-accepted = yes
     1012               then
     1013           do:
     1014               assign
     1015                   v-filter-item = v-new-filter
     1016                   .
     1017               if v-filter-item = "":U
     1018                   then
     1019               do:
     1020                   assign
     1021                       tb-filter-item            = no
     1022                       tb-filter-item :sensitive = no
     1023                       .
     1024               end.
     1025               else
     1026               do:
     1027                   assign
     1028                       tb-filter-item            = yes
     1029                       tb-filter-item :sensitive = yes
     1030                       .
     1031               end.
     1032               display
     1033                   v-filter-item
     1034                   tb-filter-item
     1035                   with frame Dialog-Frame.
     1036               run assign-filter-mark-item IN THIS-PROCEDURE
     1037                   ( input v-filter-item
     1038                   ) .
     1039               RUN refresh-query-action-item .
     1040               apply "entry":U to browse-action-role.
     1041               apply "VALUE-CHANGED":U to browse-action-role.
     1042           end.
     1043       END.
     1044   ON CHOOSE OF b-filter-role IN FRAME Dialog-Frame
     1045       DO:
     1046           define variable v-new-filter as character no-undo.
     1047           define variable v-accepted   as logical   no-undo.
     1048           run gbl/twowinf.w (
     1049               input v-filter-role
     1050               , output v-new-filter
     1051               , output v-accepted
     1052               ).
     1053           if v-accepted = yes
     1054               then
     1055           do:
     1056               assign
     1057                   v-filter-role = v-new-filter
     1058                   .
     1059               if v-filter-role = "":U
     1060                   then
     1061               do:
     1062                   assign
     1063                       tb-filter-role            = no
     1064                       tb-filter-role :sensitive = no
     1065                       .
     1066               end.
     1067               else
     1068               do:
     1069                   assign
     1070                       tb-filter-role            = yes
     1071                       tb-filter-role :sensitive = yes
     1072                       .
     1073               end.
     1074           end.
     1075   if session :set-wait-state( "compiler" ) then.
     1076           run assign-filter-mark-role IN THIS-PROCEDURE
     1077               ( input v-filter-role
     1078               ) .
     1079           run enable_UI IN THIS-PROCEDURE .
     1080           RUN post_enable_UI IN THIS-PROCEDURE.
     1081           apply "VALUE-CHANGED":U to browse-action-role.
     1082   if session :set-wait-state( "" ) then.
     1083       END.
     1084   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     1085       DO:
     1086           define variable rid-list as character no-undo.
     1087           run ref/cactnrole.w (
     1088               INPUT parparentproc
     1089               , INPUT "":U
     1090               , INPUT "one":U
     1091               , OUTPUT  rid-list
     1092               , INPUT ub.action-role.db-num
     1093               , INPUT ub.action-role.action-head-code
     1094               , INPUT ub.action-role.action-role-code
     1095               , input "":U
     1096               ).
     1097       END.
     1098   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1099       DO:
     1100           DEFINE VARIABLE v-log AS LOGICAL NO-UNDO .
     1101           IF NOT AVAILABLE action-role THEN RETURN NO-APPLY.
     1102   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1103   define variable v-str-recid9 as character no-undo .
     1104   define variable v-num-entry9 as integer   no-undo .
     1105   assign
     1106     v-str-recid9 = trim( string( recid( action-role ) , "->>>>>>>>>>>9":U ) )
     1107     v-num-entry9 = lookup( v-str-recid9 , p-rid-list )
     1108   .
     1109   if v-num-entry9 > 0 then do:
     1110     assign
     1111       entry( v-num-entry9, p-rid-list ) = "":U
     1112       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1113     .
     1114   end.
     1115   else do:
     1116     assign
     1117       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
     1118     .
     1119   end.
     1120           v-log = browse-action-role:refresh() IN FRAME Dialog-Frame.
     1121           IF last-event:function <> "MOUSE-SELECT-DBLCLICK" THEN
     1122           DO:
     1123               g#log = browse-action-role:select-next-row ().
     1124               APPLY "ITERATION-CHANGED" TO browse-action-role IN FRAME Dialog-Frame.
     1125           END.
     1126           APPLY "ENTRY" TO browse-action-role IN FRAME Dialog-Frame.
     1127       END.
     1128   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1129       DO:
     1130           def var v-prn-ff as char no-undo.
     1131           v-prn-ff = session:temp-directory + "rpt" +  "actnrole.html".
     1132           run waitfram-show in this-procedure ( input "Ждите...").
     1133           output stream OutStr-html to value(v-prn-ff) convert target 'UTF-8'.
     1134           put stream outstr-html unformatted
     1135               substitute(
     1136               '<!doctype html>
     1137               <html>
     1138                 <head>
     1139                 <meta charset="UTF-8">
     1140                     <!-- Стили документа -->
     1141                 <style>
     1142                      table ~{
     1143                          border-collapse: collapse;
     1144                          width: 1400px;  
     1145                      ~}
     1146                      tbody td, th ~{
     1147                          border: 1px solid black;
     1148                          border-collapse: collapse;
     1149                    height: 5px;
     1150                      ~}
     1151             
     1152                 </style>
     1153                  </head>
     1154                       <body>
     1155                     <table orientation="landscape" name="Группы прав" fit_to_page="true" > 
     1156                       <thead> 
     1157                      <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     1158                   <tr class="set_columns">                       
     1159                   <td style="width:250px"></td>
     1160                           
     1161                          <td style="width:250px"></td>
     1162                           <td style="width:250px"></td>
     1163                               
     1164           
     1165                    </tr>
     1166           <tr>
     1167               <td colspan="2" style="front-weight: bold; text-align: center;">Список групп прав</td>
     1168           </tr>
     1169           </thead>
     1170   
     1171           <tbody>
     1172           <tr>
     1173           <th>Привязка</th>
     1174           <th>Наименование</th>
     1175          
     1176           </tr>'  ).
     1177           get first browse-action-role.
     1178           do while available action-role:
     1179               for each  action-role-item no-lock
     1180                   where action-role-item.db-num           = action-role.db-num
     1181                   and action-role-item.action-head-code = action-role.action-head-code
     1182                   and action-role-item.action-role-code = action-role.action-role-code:
     1183                   put stream OutStr-html unformatted
     1184                       substitute(
     1185                       '<tr style="height: 50px;">
     1186                     <td text_wrap="true"> &1 </td>
     1187                      <td text_wrap="true"> &2 </td> 
     1188                      </tr> ',
     1189                       get-action-role-context(BUFFER action-role),
     1190                       action-role.action-role-name
     1191                       ).
     1192               end.
     1193               get next browse-action-role.
     1194           end.
     1195           put stream OutStr-html unformatted
     1196               substitute('
     1197               </table>'
     1198               ,chr(123), chr(125)).
     1199           put stream OutStr-html unformatted
     1200               substitute(
     1201               '  <table orientation="landscape" name="Списки прав" fit_to_page="true"> 
     1202                       <thead> 
     1203                      <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     1204                   <tr class="set_columns">                       
     1205                   <td style="width:250px"></td>
     1206                           
     1207                          <td style="width:250px"></td>
     1208                           <td style="width:250px"></td>
     1209                           <td style="width:250px"></td>  
     1210                           <td style="width:250px"></td>              
     1211          
     1212                    </tr>
     1213           <tr>
     1214               <td colspan="4" style="front-weight: bold; text-align: center;">Список прав</td>
     1215           </tr>
     1216           </thead>
     1217   
     1218           <tbody>
     1219           <tr>
     1220           <th>Привязка</th>
     1221           <th>Название группы прав</th>
     1222           <th>Тема</th>
     1223           <th>Имя права</th>
     1224           </tr>').
     1225           get first browse-action-role.
     1226           do while available action-role:
     1227               for each  action-role-item no-lock
     1228                   where action-role-item.db-num           = action-role.db-num
     1229                   and action-role-item.action-head-code = action-role.action-head-code
     1230                   and action-role-item.action-role-code = action-role.action-role-code
     1231                   ,
     1232                   FIRST action-item  where action-role-item.action-item-code = action-item.action-item-code
     1233                   NO-LOCK
     1234                   ,
     1235                   FIRST temp_filter-fields-item
     1236                   WHERE temp_filter-fields-item.action-item-code = action-item.action-item-code
     1237                   and (    temp_filter-fields-item.record-on = YES
     1238                   or tb-filter-item = no
     1239                   )
     1240                   NO-LOCK
     1241                   ,
     1242                   FIRST action-group  where action-group.action-head-code  = action-item.action-head-code
     1243                   and action-group.action-group-id = action-item.action-group-id no-lock
     1244                   :
     1245                   put stream OutStr-html unformatted
     1246                       substitute(
     1247                       '<tr style="height: 50px;">
     1248                     <td text_wrap="true"> &1 </td>
     1249                      <td text_wrap="true"> &2 </td>
     1250                      <td text_wrap="true"> &3 </td>
     1251                      <td text_wrap="true"> &4 </td>
     1252                      </tr>
     1253                       
     1254                       ',
     1255                       get-action-role-context(BUFFER action-role),
     1256                       action-role.action-role-name,
     1257                       action-group.action-group-name,
     1258                       action-item.action-item-name
     1259                       ).
     1260               end.
     1261               get next browse-action-role.
     1262           end.
     1263           run waitfram-hide in this-procedure.
     1264                     put stream outstr-html unformatted
     1265                       substitute(
     1266                       '</tbody>
     1267         </body>
     1268         </html>',chr(123), chr(125)
     1269                       ).
     1270           output stream OutStr-html close.
     1271           run prn-lib-reportviewer-report-name in this-procedure (
     1272               input parParentProc
     1273               ,input v-prn-ff
     1274               ).
     1275       end.
     1276   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1277       DO:
     1278           assign
     1279               p-rid-list         = ""
     1280               p-action-role-code = ?
     1281               .
     1282       END.
     1283   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1284       DO:
     1285           define variable v-ind         as integer no-undo .
     1286           define variable v-num-entries as integer no-undo .
     1287           if not avail action-role then return no-apply.
     1288           if p-rid-list = "" then
     1289           do:
     1290               p-rid-list = string (recid (action-role)).
     1291           end.
     1292           ASSIGN
     1293               p-action-role-code = action-role.action-role-code
     1294               .
     1295       END.
     1296   ON CHOOSE OF b-set-current-db IN FRAME Dialog-Frame
     1297       DO:
     1298           assign
     1299               v-current-db-num    = v-cntxt-db-num
     1300               cb-db :screen-value = v-current-db-num-screen-value
     1301               .
     1302           run can-edit-action-role
     1303               (input  v-current-db-num
     1304               ,output v-can-edit-action-role
     1305               ) .
     1306           run enable_UI IN THIS-PROCEDURE .
     1307           RUN post_enable_UI IN THIS-PROCEDURE.
     1308       END.
     1309   ON CHOOSE OF b-toggle IN FRAME Dialog-Frame
     1310       DO:
     1311           IF AVAILABLE action-role THEN
     1312           DO:
     1313               run change-items in this-procedure
     1314                   ( input action-role.action-head-code
     1315                   , input action-role.db-num
     1316                   , input action-role.action-role-code
     1317                   , input action-role.action-role-context
     1318                   ) no-error.
     1319               if error-status :error
     1320                   then
     1321               do:
     1322                   message
     1323                       vss-workfile vss-revision vss-description
     1324                       skip(1)
     1325                       skip
     1326                       "Ошибка изменения списка прав"
     1327                       skip return-value
     1328                       skip trim( error-status :get-message( 1 ) )
     1329                       trim( error-status :get-message( 2 ) )
     1330                       trim( error-status :get-message( 3 ) )
     1331                       view-as alert-box error.
     1332                   undo, return no-apply.
     1333               end.
     1334               run refresh-query-action-item in this-procedure .
     1335               APPLY "ENTRY" TO browse-action-item IN FRAME Dialog-Frame.
     1336           end.
     1337       END.
     1338   ON CHOOSE OF b-users IN FRAME Dialog-Frame
     1339       DO:
     1340           if available action-role
     1341               then
     1342           do:
     1343               run show-users-for-role in this-procedure (
     1344                   input action-role.db-num
     1345                   , input action-role.action-head-code
     1346                   , input action-role.action-role-code
     1347                   , input action-role.action-role-name
     1348                   ).
     1349           end.
     1350       END.
     1351   ON VALUE-CHANGED OF browse-action-item IN FRAME Dialog-Frame
     1352       DO:
     1353           if available action-item then
     1354           do:
     1355               assign
     1356                   item-editor = action-item.action-item-description
     1357                   .
     1358           end.
     1359           else
     1360           do:
     1361               assign
     1362                   item-editor = "":U
     1363                   .
     1364           end.
     1365           display
     1366               item-editor
     1367               with frame Dialog-Frame.
     1368       END.
     1369   ON MOUSE-SELECT-DBLCLICK OF browse-action-role IN FRAME Dialog-Frame
     1370       DO:
     1371           if (lookup  ( "b-add" , p-bttns) > 0 ) then
     1372           do:
     1373               apply "CHOOSE" to b-chg.
     1374           end.
     1375           else
     1376           do:
     1377               apply "CHOOSE" to b-mark.
     1378           end.
     1379       END.
     1380   ON VALUE-CHANGED OF browse-action-role IN FRAME Dialog-Frame
     1381       DO:
     1382           run refresh-query-action-item in this-procedure .
     1383           if available action-role then
     1384           do:
     1385               assign
     1386                   role-editor = action-role.action-role-description
     1387                   .
     1388               if available action-item then
     1389               do:
     1390                   assign
     1391                       item-editor = action-item.action-item-description
     1392                       .
     1393               end.
     1394               else
     1395               do:
     1396                   assign
     1397                       item-editor = "":U
     1398                       .
     1399               end.
     1400               display
     1401                   item-editor
     1402                   with frame Dialog-Frame.
     1403           end.
     1404           else
     1405           do:
     1406               assign
     1407                   role-editor = "":U
     1408                   .
     1409           end.
     1410           display
     1411               role-editor
     1412               with frame Dialog-Frame.
     1413       END.
     1414   ON VALUE-CHANGED OF cb-db IN FRAME Dialog-Frame
     1415       DO:
     1416           assign
     1417               cb-db
     1418               .
     1419           assign
     1420               v-current-db-num = integer(entry(1, cb-db, ' ':U))
     1421               .
     1422           run can-edit-action-role
     1423               (input  v-current-db-num
     1424               ,output v-can-edit-action-role
     1425               ) .
     1426           run enable_UI IN THIS-PROCEDURE .
     1427           RUN post_enable_UI IN THIS-PROCEDURE.
     1428           apply 'entry':U to browse browse-action-role .
     1429       END.
     1430   ON VALUE-CHANGED OF rs-scope IN FRAME Dialog-Frame
     1431       DO:
     1432           assign
     1433               rs-scope
     1434               .
     1435           assign
     1436               p-context = entry( rs-scope, substitute( "&1,&2,&3,&4",'All', 'global':U, 'firm':U, 'object':U ) )
     1437               .
     1438           run enable_UI IN THIS-PROCEDURE .
     1439           RUN post_enable_UI IN THIS-PROCEDURE.
     1440           apply 'entry':U to browse browse-action-role .
     1441       END.
     1442   ON VALUE-CHANGED OF tb-filter-item IN FRAME Dialog-Frame
     1443       DO:
     1444           assign
     1445               tb-filter-item
     1446               .
     1447           RUN refresh-query-action-item .
     1448           apply "entry":U to browse-action-item.
     1449       END.
     1450   ON VALUE-CHANGED OF tb-filter-role IN FRAME Dialog-Frame
     1451       DO:
     1452           assign
     1453               tb-filter-role
     1454               .
     1455           RUN enable_UI.
     1456           RUN post_enable_UI IN THIS-PROCEDURE.
     1457       END.
     1458   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1459       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1460   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1461     run mainmenu_getcntxt in parparentproc
     1462       (output v-cntxt-db-num
     1463       ,output v-cntxt-userid
     1464       ,output v-cntxt-level
     1465       ,output v-cntxt-host-code-obj
     1466       ,output v-cntxt-obj-type
     1467       ,output v-cntxt-obj-code
     1468       ,output v-cntxt-db-num-obj
     1469       ,output v-cntxt-is-admin
     1470       ) .
     1471   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1472   do:
     1473     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1474       (input  v-cntxt-db-num
     1475       ,input  v-cntxt-userid
     1476       ,input  0
     1477       ,input  'actn_actn-lookup':U
     1478       ,input  'global':U
     1479       ,input  0
     1480       ,input  '':U
     1481       ,input  0
     1482       ,input  0
     1483       ,input  0
     1484       ,input  0
     1485       ,input  false
     1486       ,output v-ok
     1487       )  .
     1488   end.
     1489   IF NOT v-ok then
     1490   do:
     1491       message
     1492           "У вас нет прав для просмотра справочника прав"
     1493           view-as alert-box information.
     1494       return.
     1495   end.
     1496   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1497   on help of frame Dialog-Frame
     1498   do:
     1499     run gbl/app_help.p
     1500       (input this-procedure :file-name
     1501       ,input ''
     1502       ,input ?
     1503       ) no-error.
     1504     if error-status :error then do:
     1505       message
     1506         "Ошибка при вызове помощи"
     1507         error-status :get-message(1)
     1508         view-as alert-box .
     1509     end.
     1510   end.
     1511   run minbtn-set in this-procedure .
     1512   on choose of b-help in frame Dialog-Frame
     1513   do:
     1514     apply "help":u to frame Dialog-Frame .
     1515   end.
     1516   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1517   procedure minbtn-set :
     1518       do
     1519           on error undo, return error return-value
     1520           :
     1521           define variable ii              as integer       no-undo .
     1522           define variable fh              as widget-handle no-undo .
     1523           define variable hh              as widget-handle no-undo .
     1524           define variable v-h             as handle        extent 4 no-undo .
     1525           define variable v-name-button   as character     no-undo .
     1526           define variable v-help-old-x    as decimal       no-undo .
     1527           define variable v-help-old-y    as decimal       no-undo .
     1528           define variable v-help-old-size as decimal       no-undo .
     1529           define variable v-frame-width   as decimal       no-undo .
     1530           define variable jj              as integer       no-undo .
     1531           do
     1532               on error undo, return error
     1533               :
     1534               assign
     1535                   v-frame-width = frame Dialog-Frame:width - 0.3
     1536                   fh            = frame Dialog-Frame:first-child
     1537                   hh            = fh:first-child
     1538                   ii            = 1
     1539                   .
     1540               do while valid-handle(hh):
     1541                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1542                   do:
     1543                       case lc(hh:name) :
     1544                           when "b-help" then
     1545                               do:
     1546                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1547                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1548                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1549                                   hh:TOOLTIP = "Помощь" .
     1550                                   v-help-old-x = hh:column .
     1551                                   v-help-old-y = hh:row    .
     1552                                   v-help-old-size = hh:width .
     1553                                   hh:width-chars = 2.5 .
     1554                               end.
     1555                           when "b-print" then
     1556                               do:
     1557                                   hh:load-image("cmp/b-print.bmp":u) .
     1558                                   hh:TOOLTIP = "Печать" .
     1559                                   v-h[ii] = hh:handle .
     1560                                   ii = ii + 1 .
     1561                                   hh:width-chars = 3 .
     1562                               end.
     1563                           when "b-history" or
     1564                           when "b-hist" then
     1565                               do:
     1566                                   hh:load-image("cmp/b-hist.bmp":u) .
     1567                                   hh:TOOLTIP = "История" .
     1568                                   v-h[ii] = hh:handle .
     1569                                   ii = ii + 1 .
     1570                                   hh:width-chars = 3 .
     1571                               end.
     1572                           when "b-sch" then
     1573                               do:
     1574                                   hh:load-image("cmp/b-sch.bmp":u) .
     1575                                   hh:TOOLTIP = "Установка Фильтра" .
     1576                                   v-h[ii] = hh:handle .
     1577                                   ii = ii + 1 .
     1578                                   hh:width-chars = 3 .
     1579                               end.
     1580                           when "b-hist-user" then
     1581                               do:
     1582                                   hh:load-image("cmp/b-hist.bmp":u) .
     1583                                   hh:TOOLTIP = "История пользователя" .
     1584                                   ii = ii + 1 .
     1585                               end.
     1586                       end case.
     1587                   end.
     1588                   hh = hh:next-sibling.
     1589               end.
     1590               b-help:column = v-frame-width - b-help:width-chars.
     1591               jj = 0.
     1592               repeat ii = 4 to 1 by -1 :
     1593                   if valid-handle (v-h[ii] ) then
     1594                   do:
     1595                       jj  = jj + 1 .
     1596                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1597                       v-h[ii]:row    = v-help-old-y .
     1598                   end.
     1599               end.
     1600           end.
     1601       end.
     1602   end procedure.
     1603   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1604   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1605   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1606   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1607   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1608   define variable v-diasize-current-frame-height as decimal   no-undo .
     1609   define variable v-diasize-change-size          as logical   no-undo .
     1610   define variable v-diasize-resize-button        as handle    no-undo .
     1611   define variable v-diasize-wndmax               as logical   no-undo .
     1612   define variable v-diasize-wndstore             as logical   no-undo .
     1613   define variable v-diasize-proc-name            as character no-undo .
     1614   define variable v-diasize-browse-handle        as handle    no-undo .
     1615   define variable v-diasize-browse-number        as integer   no-undo .
     1616   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1617   define temp-table temp-diasize-handle no-undo
     1618     field handle-value  as handle
     1619     field save-position as decimal
     1620     index xpk is primary unique handle-value
     1621     .
     1622   define temp-table temp-browse-handle no-undo
     1623     field browse-type   as character
     1624     field browse-number as integer
     1625     field browse-handle as handle
     1626     field original-size as decimal
     1627     index xpk is primary unique browse-type browse-number
     1628     index xie browse-type browse-handle
     1629   .
     1630   procedure diasize_change-height :
     1631     define input  parameter p-change-value  as decimal   no-undo .
     1632     define input  parameter p-move-resize   as logical   no-undo .
     1633     define variable v-field-group-handle    as handle    no-undo .
     1634     define variable v-object-handle         as handle    no-undo .
     1635     define variable v-frame-height          as decimal   no-undo .
     1636     define variable v-frame-virtual-height  as decimal   no-undo .
     1637     define variable v-browse-height         as decimal   no-undo .
     1638     define variable v-window-height         as decimal   no-undo .
     1639     define variable v-window-virtual-height as decimal   no-undo .
     1640     define variable v-change-sign           as integer   no-undo .
     1641     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1642     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1643     if p-change-value > 0
     1644     then do:
     1645       if frame Dialog-Frame :height + p-change-value
     1646           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1647       then do:
     1648         assign
     1649           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1650                           - (frame Dialog-Frame :height-chars)
     1651         .
     1652         if p-change-value <= 0
     1653         then do:
     1654           run diasize_position-resize-button in this-procedure .
     1655           return .
     1656         end.
     1657       end.
     1658     end.
     1659     if p-change-value < 0
     1660     then do:
     1661       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1662       then do:
     1663         assign
     1664           p-change-value = v-diasize-orig-frame-height
     1665                          - (frame Dialog-Frame :height-chars)
     1666         .
     1667         if p-change-value >= 0
     1668         then do:
     1669           run diasize_position-resize-button in this-procedure .
     1670           return .
     1671         end.
     1672       end.
     1673     end.
     1674     if p-change-value >= 0
     1675     then do:
     1676       assign
     1677         v-change-sign = 1
     1678       .
     1679     end.
     1680     else do:
     1681       assign
     1682         v-change-sign = -1
     1683       .
     1684     end.
     1685     assign
     1686       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1687     .
     1688     if p-change-value = 0
     1689     then do:
     1690       run diasize_position-resize-button in this-procedure .
     1691       return .
     1692     end.
     1693     move_block:
     1694     do
     1695     on error undo move_block, retry move_block
     1696     :
     1697       if retry
     1698       then do:
     1699         do
     1700         on error undo move_block, leave move_block
     1701         :
     1702           if p-change-value > 0
     1703           then do:
     1704             for each buf_temp-diasize-handle
     1705             on error undo, next
     1706             :
     1707               assign
     1708                 v-object-handle = buf_temp-diasize-handle.handle-value
     1709               .
     1710               if v-object-handle <> v-diasize-resize-button
     1711               then do:
     1712                 assign
     1713                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1714                 .
     1715               end.
     1716             end.
     1717             assign
     1718               v-diasize-browse-handle :height = v-browse-height
     1719             .
     1720             for each buf_temp-browse-handle
     1721               where buf_temp-browse-handle.browse-type = 'height':u
     1722             on error undo, next
     1723             :
     1724               assign
     1725                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1726               .
     1727             end.
     1728             assign
     1729               frame Dialog-Frame :height = v-frame-height
     1730             .
     1731             if frame Dialog-Frame :scrollable = true
     1732             then do:
     1733               assign
     1734                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1735               .
     1736             end.
     1737             run diasize_position-resize-button in this-procedure .
     1738           end.
     1739           else do:
     1740             if frame Dialog-Frame :scrollable = true
     1741             then do:
     1742               assign
     1743                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1744               .
     1745             end.
     1746             assign
     1747               frame Dialog-Frame :height = v-frame-height
     1748             .
     1749             assign
     1750               v-diasize-browse-handle :height = v-browse-height
     1751             .
     1752             for each buf_temp-browse-handle
     1753               where buf_temp-browse-handle.browse-type = 'height':u
     1754             on error undo, next
     1755             :
     1756               assign
     1757                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1758               .
     1759             end.
     1760             for each buf_temp-diasize-handle
     1761             on error undo, next
     1762             :
     1763               assign
     1764                 v-object-handle = buf_temp-diasize-handle.handle-value
     1765               .
     1766               if v-object-handle <> v-diasize-resize-button
     1767               then do:
     1768                 assign
     1769                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1770                 .
     1771               end.
     1772             end.
     1773             run diasize_position-resize-button in this-procedure .
     1774           end.
     1775           assign
     1776             v-diasize-change-size = false
     1777           .
     1778           leave move_block .
     1779         end.
     1780       end.
     1781       assign
     1782         v-diasize-need-full-display = true
     1783       .
     1784       if v-diasize-change-size = false
     1785       then do:
     1786         assign
     1787           v-diasize-change-size = true
     1788         .
     1789       end.
     1790       else do:
     1791         return .
     1792       end.
     1793       assign
     1794         v-frame-height = frame Dialog-Frame :height
     1795         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1796         v-browse-height = v-diasize-browse-handle :height
     1797       .
     1798       for each buf_temp-browse-handle
     1799         where buf_temp-browse-handle.browse-type = 'height':u
     1800       :
     1801         assign
     1802           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1803         .
     1804       end.
     1805       for each buf_temp-diasize-handle
     1806       :
     1807         delete buf_temp-diasize-handle .
     1808       end.
     1809       assign
     1810         v-field-group-handle = frame Dialog-Frame :first-child
     1811       .
     1812       do while valid-handle(v-field-group-handle)
     1813       :
     1814         assign
     1815           v-object-handle = v-field-group-handle :first-child
     1816         .
     1817         do while valid-handle(v-object-handle)
     1818         :
     1819           if  v-object-handle <> v-diasize-browse-handle :handle
     1820           and can-query(v-object-handle, "row")
     1821           and can-query(v-object-handle, "height")
     1822           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1823           then do:
     1824             find first buf_temp-browse-handle
     1825               where buf_temp-browse-handle.browse-type   = 'height':u
     1826                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1827               no-error .
     1828             if available buf_temp-browse-handle
     1829             then do:
     1830             end.
     1831             else do:
     1832               create buf_temp-diasize-handle .
     1833               assign
     1834                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1835                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1836               .
     1837             end.
     1838           end.
     1839           assign
     1840             v-object-handle = v-object-handle :next-sibling
     1841           .
     1842         end.
     1843         assign
     1844           v-field-group-handle = v-field-group-handle :next-sibling
     1845         .
     1846       end.
     1847       do with frame Dialog-Frame
     1848       :
     1849         hide v-diasize-resize-button .
     1850         assign
     1851           v-diasize-resize-button :row    = 1
     1852           v-diasize-resize-button :column = 1
     1853         .
     1854       end.
     1855       if p-change-value > 0
     1856       then do:
     1857         if frame Dialog-Frame :scrollable = true
     1858         then do:
     1859           assign
     1860             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1861             no-error .
     1862           if error-status :error
     1863           or error-status :get-message(1) <> ""
     1864           then do:
     1865             undo move_block, retry move_block .
     1866           end.
     1867         end.
     1868         assign
     1869           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1870           no-error .
     1871         if error-status :error
     1872         or error-status :get-message(1) <> ""
     1873         then do:
     1874           undo move_block, retry move_block .
     1875         end.
     1876         assign
     1877           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1878           no-error .
     1879         if error-status :error
     1880         or error-status :get-message(1) <> ""
     1881         then do:
     1882           undo move_block, retry move_block .
     1883         end.
     1884         for each buf_temp-browse-handle
     1885           where buf_temp-browse-handle.browse-type = 'height':u
     1886         on error undo move_block, retry move_block
     1887         :
     1888           assign
     1889             buf_temp-browse-handle.browse-handle :height
     1890               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1891             no-error .
     1892           if error-status :error
     1893           or error-status :get-message(1) <> ""
     1894           then do:
     1895             undo move_block, retry move_block .
     1896           end.
     1897         end.
     1898         for each buf_temp-diasize-handle
     1899         on error undo move_block, retry move_block
     1900         :
     1901           assign
     1902             v-object-handle = buf_temp-diasize-handle.handle-value
     1903           .
     1904           if v-object-handle <> v-diasize-resize-button
     1905           then do:
     1906             assign
     1907               v-object-handle :row = v-object-handle :row + p-change-value
     1908               no-error .
     1909             if error-status :error
     1910             or error-status :get-message(1) <> ""
     1911             then do:
     1912               undo move_block, retry move_block .
     1913             end.
     1914           end.
     1915         end.
     1916       end.
     1917       else do:
     1918         for each buf_temp-diasize-handle
     1919         on error undo move_block, retry move_block
     1920         :
     1921           assign
     1922             v-object-handle = buf_temp-diasize-handle.handle-value
     1923           .
     1924           if v-object-handle <> v-diasize-resize-button
     1925           then do:
     1926             assign
     1927               v-object-handle :row = v-object-handle :row + p-change-value
     1928               no-error .
     1929             if error-status :error
     1930             or error-status :get-message(1) <> ""
     1931             then do:
     1932               undo move_block, retry move_block .
     1933             end.
     1934           end.
     1935         end.
     1936         assign
     1937           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1938           no-error .
     1939         if error-status :error
     1940         or error-status :get-message(1) <> ""
     1941         then do:
     1942           undo move_block, retry move_block .
     1943         end.
     1944         for each buf_temp-browse-handle
     1945           where buf_temp-browse-handle.browse-type = 'height':u
     1946         on error undo move_block, retry move_block
     1947         :
     1948           assign
     1949             buf_temp-browse-handle.browse-handle :height
     1950               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1951             no-error .
     1952           if error-status :error
     1953           or error-status :get-message(1) <> ""
     1954           then do:
     1955             undo move_block, retry move_block .
     1956           end.
     1957         end.
     1958         assign
     1959           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1960           no-error .
     1961         if error-status :error
     1962         or error-status :get-message(1) <> ""
     1963         then do:
     1964           undo move_block, retry move_block .
     1965         end.
     1966         if frame Dialog-Frame :scrollable = true
     1967         then do:
     1968           assign
     1969             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1970             no-error .
     1971           if error-status :error
     1972           or error-status :get-message(1) <> ""
     1973           then do:
     1974             undo move_block, retry move_block .
     1975           end.
     1976         end.
     1977       end.
     1978       if p-move-resize = true
     1979       then do:
     1980         run diasize_position-resize-button in this-procedure .
     1981       end.
     1982       if v-diasize-wndstore = true
     1983       then do:
     1984         if connected("ub") = true
     1985         then do:
     1986           define variable v-cntxt-db-num        as integer   no-undo .
     1987           define variable v-cntxt-userid        as character no-undo .
     1988           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1989                                             , OUTPUT v-cntxt-userid
     1990                                             ) .
     1991           run gbl/wndsizew.p
     1992             (input  v-cntxt-db-num
     1993             ,input  v-cntxt-userid
     1994             ,input  v-diasize-proc-name
     1995             ,input  'height':u
     1996             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1997             ) .
     1998         end.
     1999       end.
     2000     end.
     2001     assign
     2002       v-diasize-change-size = false
     2003     .
     2004   end procedure.
     2005   procedure diasize_set-height :
     2006     define input  parameter p-new-height  as decimal   no-undo .
     2007     define input  parameter p-move-resize as logical   no-undo .
     2008     do
     2009     on error undo, return error return-value
     2010     :
     2011       run diasize_change-height in this-procedure
     2012         (input  (p-new-height - frame Dialog-Frame :height)
     2013         ,input  p-move-resize
     2014         ) .
     2015     end.
     2016   end procedure.
     2017   procedure diasize_change-width :
     2018     define input  parameter p-change-value as decimal   no-undo .
     2019     define input  parameter p-move-resize  as logical   no-undo .
     2020     define variable v-field-group-handle   as handle    no-undo .
     2021     define variable v-object-handle        as handle    no-undo .
     2022     define variable v-frame-width          as decimal   no-undo .
     2023     define variable v-frame-virtual-width  as decimal   no-undo .
     2024     define variable v-browse-width         as decimal   no-undo .
     2025     define variable v-window-width         as decimal   no-undo .
     2026     define variable v-window-virtual-width as decimal   no-undo .
     2027     define variable v-change-sign          as integer   no-undo .
     2028     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2029     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2030     if p-change-value > 0
     2031     then do:
     2032       if frame Dialog-Frame :width + p-change-value >
     2033           session :width-chars
     2034       then do:
     2035         assign
     2036           p-change-value = session :width-chars - frame Dialog-Frame :width
     2037         .
     2038         if p-change-value <= 0
     2039         then do:
     2040           run diasize_position-resize-button in this-procedure .
     2041           return .
     2042         end.
     2043       end.
     2044     end.
     2045     if p-change-value < 0
     2046     then do:
     2047       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2048       then do:
     2049         assign
     2050           p-change-value = v-diasize-orig-frame-width
     2051                          - frame Dialog-Frame :width
     2052         .
     2053         if p-change-value >= 0
     2054         then do:
     2055           run diasize_position-resize-button in this-procedure .
     2056           return .
     2057         end.
     2058       end.
     2059     end.
     2060     if p-change-value >= 0
     2061     then do:
     2062       assign
     2063         v-change-sign = 1
     2064       .
     2065     end.
     2066     else do:
     2067       assign
     2068         v-change-sign = -1
     2069       .
     2070     end.
     2071     assign
     2072       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2073     .
     2074     if p-change-value = 0
     2075     then do:
     2076       run diasize_position-resize-button in this-procedure .
     2077       return .
     2078     end.
     2079     move_block:
     2080     do
     2081     on error undo move_block, leave move_block
     2082     :
     2083       if retry
     2084       then do:
     2085         do
     2086         on error undo move_block, leave move_block
     2087         :
     2088           if p-change-value > 0
     2089           then do:
     2090             for each buf_temp-diasize-handle
     2091             on error undo, next
     2092             :
     2093               assign
     2094                 v-object-handle = buf_temp-diasize-handle.handle-value
     2095               .
     2096               if v-object-handle <> v-diasize-resize-button
     2097               then do:
     2098                 assign
     2099                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2100                 .
     2101               end.
     2102             end.
     2103             assign
     2104               v-diasize-browse-handle :width = v-browse-width
     2105             .
     2106             for each buf_temp-browse-handle
     2107               where buf_temp-browse-handle.browse-type = 'width':u
     2108             on error undo, next
     2109             :
     2110               assign
     2111                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2112               .
     2113             end.
     2114             assign
     2115               frame Dialog-Frame :width = v-frame-width
     2116             .
     2117             if frame Dialog-Frame :scrollable = true
     2118             then do:
     2119               assign
     2120                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2121               .
     2122             end.
     2123             run diasize_position-resize-button in this-procedure .
     2124           end.
     2125           else do:
     2126             if frame Dialog-Frame :scrollable = true
     2127             then do:
     2128               assign
     2129                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2130               .
     2131             end.
     2132             assign
     2133               frame Dialog-Frame :width = v-frame-width
     2134             .
     2135             for each buf_temp-browse-handle
     2136               where buf_temp-browse-handle.browse-type = 'width':u
     2137             on error undo, next
     2138             :
     2139               assign
     2140                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2141               .
     2142             end.
     2143             assign
     2144               v-diasize-browse-handle :width = v-browse-width
     2145             .
     2146             for each buf_temp-diasize-handle
     2147             on error undo, next
     2148             :
     2149               assign
     2150                 v-object-handle = buf_temp-diasize-handle.handle-value
     2151               .
     2152               if v-object-handle <> v-diasize-resize-button
     2153               then do:
     2154                 assign
     2155                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2156                 .
     2157               end.
     2158             end.
     2159             run diasize_position-resize-button in this-procedure .
     2160           end.
     2161           assign
     2162             v-diasize-change-size = false
     2163           .
     2164           leave move_block .
     2165         end.
     2166       end.
     2167       assign
     2168         v-diasize-need-full-display = true
     2169       .
     2170       if v-diasize-change-size = false
     2171       then do:
     2172         assign
     2173           v-diasize-change-size = true
     2174         .
     2175       end.
     2176       else do:
     2177         return .
     2178       end.
     2179       assign
     2180         v-frame-width = frame Dialog-Frame :width
     2181         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2182         v-browse-width = v-diasize-browse-handle :width
     2183       .
     2184       for each buf_temp-browse-handle
     2185         where buf_temp-browse-handle.browse-type = 'width':u
     2186       :
     2187         assign
     2188           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2189         .
     2190       end.
     2191       for each buf_temp-diasize-handle
     2192       :
     2193         delete buf_temp-diasize-handle .
     2194       end.
     2195       assign
     2196         v-field-group-handle = frame Dialog-Frame :first-child
     2197       .
     2198       do while valid-handle(v-field-group-handle)
     2199       :
     2200         assign
     2201           v-object-handle = v-field-group-handle :first-child
     2202         .
     2203         do while valid-handle(v-object-handle)
     2204         :
     2205           if  v-object-handle <> v-diasize-browse-handle :handle
     2206           and v-object-handle <> v-diasize-resize-button
     2207           and can-query(v-object-handle, "row")
     2208           and can-query(v-object-handle, "height")
     2209           and ( v-object-handle :col + v-object-handle :width
     2210                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2211               )
     2212           then do:
     2213             find first buf_temp-browse-handle
     2214               where buf_temp-browse-handle.browse-type   = 'width':u
     2215                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2216               no-error .
     2217             if available buf_temp-browse-handle
     2218             then do:
     2219             end.
     2220             else do:
     2221               create buf_temp-diasize-handle .
     2222               assign
     2223                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2224                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2225               .
     2226             end.
     2227           end.
     2228           assign
     2229             v-object-handle = v-object-handle :next-sibling
     2230           .
     2231         end.
     2232         assign
     2233           v-field-group-handle = v-field-group-handle :next-sibling
     2234         .
     2235       end.
     2236       do with frame Dialog-Frame
     2237       :
     2238         hide v-diasize-resize-button .
     2239         v-diasize-resize-button :row = 1.
     2240         v-diasize-resize-button :column = 1.
     2241       end.
     2242       if p-change-value > 0
     2243       then do:
     2244         if frame Dialog-Frame :scrollable = true
     2245         then do:
     2246           assign
     2247             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2248             no-error .
     2249           if error-status :error
     2250           or error-status :get-message(1) <> ""
     2251           then do:
     2252             undo move_block, retry move_block.
     2253           end.
     2254         end.
     2255         assign
     2256           frame Dialog-Frame :width = v-frame-width + p-change-value
     2257           no-error .
     2258         if error-status :error
     2259         or error-status :get-message(1) <> ""
     2260         then do:
     2261           undo move_block, retry move_block.
     2262         end.
     2263         assign
     2264           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2265         no-error .
     2266         if error-status :error
     2267         or error-status :get-message(1) <> ""
     2268         then do:
     2269           undo move_block, retry move_block.
     2270         end.
     2271         for each buf_temp-browse-handle
     2272           where buf_temp-browse-handle.browse-type = 'width':u
     2273         on error undo move_block, retry move_block
     2274         :
     2275           assign
     2276             buf_temp-browse-handle.browse-handle :width
     2277               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2278             no-error .
     2279           if error-status :error
     2280           or error-status :get-message(1) <> ""
     2281           then do:
     2282             undo move_block, retry move_block .
     2283           end.
     2284         end.
     2285         for each buf_temp-diasize-handle
     2286         on error undo move_block, retry move_block
     2287         :
     2288           assign
     2289             v-object-handle = buf_temp-diasize-handle.handle-value
     2290           .
     2291           if v-object-handle <> v-diasize-resize-button
     2292           then do:
     2293             assign
     2294               v-object-handle :col = v-object-handle :col + p-change-value
     2295               no-error .
     2296             if error-status :error
     2297             or error-status :get-message(1) <> ""
     2298             then do:
     2299               undo move_block, retry move_block .
     2300             end.
     2301           end.
     2302         end.
     2303       end.
     2304       else do:
     2305         for each buf_temp-diasize-handle
     2306         on error undo move_block, retry move_block
     2307         :
     2308           assign
     2309             v-object-handle = buf_temp-diasize-handle.handle-value
     2310           .
     2311           if v-object-handle <> v-diasize-resize-button
     2312           then do:
     2313             assign
     2314               v-object-handle :col = v-object-handle :col + p-change-value
     2315               no-error .
     2316             if error-status :error
     2317             or error-status :get-message(1) <> ""
     2318             then do:
     2319               undo move_block, retry move_block .
     2320             end.
     2321           end.
     2322         end.
     2323         for each buf_temp-browse-handle
     2324           where buf_temp-browse-handle.browse-type = 'width':u
     2325         on error undo move_block, retry move_block
     2326         :
     2327           assign
     2328             buf_temp-browse-handle.browse-handle :width
     2329               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2330             no-error .
     2331           if error-status :error
     2332           or error-status :get-message(1) <> ""
     2333           then do:
     2334             undo move_block, retry move_block .
     2335           end.
     2336         end.
     2337         assign
     2338           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2339           no-error .
     2340         if error-status :error
     2341         or error-status :get-message(1) <> ""
     2342         then do:
     2343           undo move_block, retry move_block.
     2344         end.
     2345         assign
     2346           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2347         no-error .
     2348         if error-status :error
     2349         or error-status :get-message(1) <> ""
     2350         then do:
     2351           undo move_block, retry move_block.
     2352         end.
     2353         if frame Dialog-Frame :scrollable = true
     2354         then do:
     2355           assign
     2356             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2357           no-error .
     2358           if error-status :error
     2359           or error-status :get-message(1) <> ""
     2360           then do:
     2361             undo move_block, retry move_block.
     2362           end.
     2363         end.
     2364       end.
     2365       if p-move-resize
     2366       then do:
     2367         run diasize_position-resize-button in this-procedure .
     2368       end.
     2369       if v-diasize-wndstore = true
     2370       then do:
     2371         if connected("ub") = true
     2372         then do:
     2373           define variable v-cntxt-db-num        as integer   no-undo .
     2374           define variable v-cntxt-userid        as character no-undo .
     2375           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2376                                             , OUTPUT v-cntxt-userid
     2377                                             ) .
     2378           run gbl/wndsizew.p
     2379             (input  v-cntxt-db-num
     2380             ,input  v-cntxt-userid
     2381             ,input  v-diasize-proc-name
     2382             ,input  'width':u
     2383             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2384             ) .
     2385         end.
     2386       end.
     2387     end.
     2388     assign
     2389       v-diasize-change-size = false
     2390     .
     2391   end procedure.
     2392   procedure diasize_set-width :
     2393     define input  parameter p-new-width  as decimal   no-undo .
     2394     define input  parameter p-move-resize as logical   no-undo .
     2395     do
     2396     on error undo, return error return-value
     2397     :
     2398       run diasize_change-width in this-procedure
     2399         (input  (p-new-width - frame Dialog-Frame :width)
     2400         ,input  p-move-resize
     2401         ) .
     2402     end.
     2403   end procedure.
     2404   procedure diasize_position-resize-button :
     2405     do with frame Dialog-Frame
     2406     :
     2407       hide v-diasize-resize-button .
     2408       assign
     2409         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2410                     - 1
     2411                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2412         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2413                     - 1
     2414                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2415       .
     2416       view v-diasize-resize-button .
     2417     end.
     2418   end procedure.
     2419   on alt-right anywhere
     2420   do:
     2421     run diasize_change-width in this-procedure
     2422       (input 1
     2423       ,input true
     2424       ) .
     2425     return no-apply .
     2426   end.
     2427   on alt-left anywhere
     2428   do:
     2429     run diasize_change-width in this-procedure
     2430       (input -1
     2431       ,input true
     2432       ) .
     2433     return no-apply .
     2434   end.
     2435   on alt-down anywhere
     2436   do:
     2437     run diasize_change-height in this-procedure
     2438       (input 1
     2439       ,input true
     2440       ) .
     2441     return no-apply .
     2442   end.
     2443   on alt-up anywhere
     2444   do:
     2445     run diasize_change-height in this-procedure
     2446       (input -1
     2447       ,input true
     2448       ) .
     2449     return no-apply .
     2450   end.
     2451   on alt-enter of frame Dialog-Frame
     2452   do:
     2453     run diasize_maximize in this-procedure
     2454       (input  ?
     2455       ).
     2456     return no-apply .
     2457   end.
     2458   procedure diasize_end-move :
     2459     do
     2460     on error undo, return error return-value
     2461     :
     2462       define variable v-row-delta as decimal   no-undo .
     2463       define variable v-col-delta as decimal   no-undo .
     2464       define variable v-new-row as decimal   no-undo .
     2465       define variable v-new-col as decimal   no-undo .
     2466       assign
     2467         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2468         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2469       .
     2470       assign
     2471         v-row-delta = v-new-row - frame Dialog-Frame :height
     2472         v-col-delta = v-new-col - frame Dialog-Frame :width
     2473       .
     2474       run diasize_change-height in this-procedure
     2475         (input v-row-delta
     2476         ,input true
     2477         ) .
     2478       run diasize_change-width in this-procedure
     2479         (input v-col-delta
     2480         ,input true
     2481         ) .
     2482     end.
     2483   end procedure.
     2484   procedure diasize_maximize :
     2485     define input  parameter p-action as logical   no-undo .
     2486     do
     2487     on error undo, return error return-value
     2488     :
     2489       if p-action = ?
     2490       then do:
     2491         if v-diasize-need-maximize = true
     2492         then do:
     2493           assign
     2494             p-action = true
     2495           .
     2496         end.
     2497         else do:
     2498           assign
     2499             p-action = false
     2500           .
     2501         end.
     2502       end.
     2503       if p-action = true
     2504       then do:
     2505         run diasize_change-height in this-procedure
     2506           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2507               - frame Dialog-Frame :height-chars
     2508           ,input true
     2509           ) .
     2510         run diasize_change-width in this-procedure
     2511           (input session :width-chars
     2512               - frame Dialog-Frame :width-chars
     2513           ,input true
     2514           ) .
     2515         assign
     2516           v-diasize-need-maximize = false
     2517         .
     2518       end.
     2519       else do:
     2520         run diasize_change-width in this-procedure
     2521           (input v-diasize-orig-frame-width
     2522               - frame Dialog-Frame :width-chars
     2523           ,input true
     2524           ) .
     2525         run diasize_change-height in this-procedure
     2526           (input v-diasize-orig-frame-height
     2527               - frame Dialog-Frame :height-chars
     2528           ,input true
     2529           ) .
     2530         assign
     2531           v-diasize-need-maximize = true
     2532         .
     2533       end.
     2534     end.
     2535   end procedure.
     2536   procedure diasize_restore-orig-size :
     2537     do
     2538     on error undo, return error return-value
     2539     :
     2540       assign
     2541         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2542         v-diasize-current-frame-height = frame Dialog-Frame :height
     2543       .
     2544       run diasize_set-height in this-procedure
     2545         (input  v-diasize-orig-frame-height
     2546         ,input  true
     2547         ) .
     2548       run diasize_set-width in this-procedure
     2549         (input  v-diasize-orig-frame-width
     2550         ,input  true
     2551         ) .
     2552     end.
     2553   end procedure.
     2554   procedure diasize_restore-current-size :
     2555     do
     2556     on error undo, return error return-value
     2557     :
     2558       run diasize_set-height in this-procedure
     2559         (input  v-diasize-current-frame-height
     2560         ,input  true
     2561         ) .
     2562       run diasize_set-width in this-procedure
     2563         (input  v-diasize-current-frame-width
     2564         ,input  true
     2565         ) .
     2566     end.
     2567   end procedure.
     2568   procedure diasize_set-browse-handle :
     2569     define input  parameter p-browse-handle as handle   no-undo .
     2570     define buffer buf_temp-browse-handle for temp-browse-handle .
     2571     do
     2572     on error undo, return error return-value
     2573     :
     2574       assign
     2575         v-diasize-browse-handle = p-browse-handle
     2576       .
     2577       for each buf_temp-browse-handle
     2578       on error undo, return error return-value
     2579       :
     2580         delete buf_temp-browse-handle .
     2581       end.
     2582     end.
     2583   end procedure.
     2584   procedure diasize_add_browse :
     2585     define input  parameter p-browse-type   as character no-undo .
     2586     define input  parameter p-browse-handle as handle    no-undo .
     2587     define buffer buf_temp-browse-handle for temp-browse-handle .
     2588     do
     2589     on error undo, return error return-value
     2590     :
     2591       assign
     2592         v-diasize-browse-number = v-diasize-browse-number + 1
     2593       .
     2594       create buf_temp-browse-handle .
     2595       assign
     2596         buf_temp-browse-handle.browse-type   = p-browse-type
     2597         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2598         buf_temp-browse-handle.browse-handle = p-browse-handle
     2599       .
     2600     end.
     2601   end procedure.
     2602   procedure diasize_init :
     2603     define variable v-default-value    as logical   no-undo .
     2604     define variable v-restore-saved    as logical   no-undo .
     2605     define variable v-resize-value-str as character no-undo .
     2606     do
     2607     on error undo, return error return-value
     2608     :
     2609       do with frame Dialog-Frame
     2610       :
     2611         assign
     2612           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2613           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2614           v-diasize-browse-handle     = browse browse-action-item :handle
     2615         .
     2616         create button v-diasize-resize-button
     2617         assign
     2618           parent        = frame Dialog-Frame :first-child
     2619           label         = "s"
     2620           height-pixels = 16
     2621           width-pixels  = 16
     2622           visible       = true
     2623           sensitive     = true
     2624           movable       = true
     2625           triggers:
     2626             on end-move persistent run diasize_end-move in this-procedure .
     2627           end triggers.
     2628         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2629         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2630         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2631         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2632         assign
     2633           v-diasize-wndmax = false
     2634         .
     2635         if connected("ub") = true
     2636         then do:
     2637           define variable v-cntxt-db-num        as integer   no-undo .
     2638           define variable v-cntxt-userid        as character no-undo .
     2639           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2640                                             , OUTPUT v-cntxt-userid
     2641                                             ) .
     2642           run gbl/wndpar_r.p
     2643             (input  v-cntxt-db-num
     2644             ,input  v-cntxt-userid
     2645             ,input  'wndmax':U
     2646             ,output v-diasize-wndmax
     2647             ,output v-default-value
     2648             ) .
     2649         end.
     2650         assign
     2651           v-diasize-wndstore = false
     2652         .
     2653         if connected("ub") = true
     2654         then do:
     2655           run gbl/wndpar_r.p
     2656             (input  v-cntxt-db-num
     2657             ,input  v-cntxt-userid
     2658             ,input  'wndstore':U
     2659             ,output v-diasize-wndstore
     2660             ,output v-default-value
     2661             ) .
     2662         end.
     2663         assign
     2664           v-diasize-proc-name = entry(1, program-name(2), '.')
     2665         .
     2666         if v-diasize-wndstore = true
     2667         then do:
     2668           assign
     2669             v-restore-saved = false
     2670           .
     2671           if connected("ub") = true
     2672           then do:
     2673             run gbl/wndsizer.p
     2674               (input  v-cntxt-db-num
     2675               ,input  v-cntxt-userid
     2676               ,input  v-diasize-proc-name
     2677               ,input  'height':u
     2678               ,output v-resize-value-str
     2679               ) .
     2680             if v-resize-value-str <> '':U
     2681             then do:
     2682               run diasize_change-height in this-procedure
     2683                 (input  integer(v-resize-value-str)
     2684                 ,input  true
     2685                 ) .
     2686               assign
     2687                 v-restore-saved = true
     2688               .
     2689             end.
     2690           end.
     2691           if connected("ub") = true
     2692           then do:
     2693             run gbl/wndsizer.p
     2694               (input  v-cntxt-db-num
     2695               ,input  v-cntxt-userid
     2696               ,input  v-diasize-proc-name
     2697               ,input  'width':u
     2698               ,output v-resize-value-str
     2699               ) .
     2700             if v-resize-value-str <> '':U
     2701             then do:
     2702               run diasize_change-width in this-procedure
     2703                 (input  integer(v-resize-value-str)
     2704                 ,input  true
     2705                 ) .
     2706               assign
     2707                 v-restore-saved = true
     2708               .
     2709             end.
     2710           end.
     2711           if v-restore-saved <> true
     2712           then do:
     2713             if v-diasize-wndmax = true
     2714             then do:
     2715               run diasize_maximize in this-procedure
     2716                 (input  true
     2717                 ) .
     2718             end.
     2719           end.
     2720         end.
     2721         else do:
     2722           if v-diasize-wndmax = true
     2723           then do:
     2724             run diasize_maximize in this-procedure
     2725               (input  true
     2726               ) .
     2727           end.
     2728         end.
     2729       end.
     2730     end.
     2731   end procedure.
     2732   procedure diasize_need-full-display :
     2733     define output parameter p-need-full-display as logical   no-undo .
     2734     do
     2735     on error undo, return error return-value
     2736     :
     2737       assign
     2738         p-need-full-display = v-diasize-need-full-display
     2739       .
     2740       assign
     2741         v-diasize-need-full-display = false
     2742       .
     2743     end.
     2744   end procedure.
     2745   procedure get-context :
     2746      define output parameter p-db-num as integer          no-undo.
     2747      define output parameter p-user-id as character        no-undo.
     2748      define variable v-login               as character    no-undo.
     2749      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2750      define buffer buf_user-login  for ub.user-login .
     2751      do
     2752      on error undo, return error
     2753      :
     2754            FIND FIRST buf_sys-ctrl no-lock.
     2755            ASSIGN
     2756               v-login = USERID("ub")
     2757               p-db-num = buf_sys-ctrl.db-num
     2758            .
     2759            FIND FIRST buf_user-login
     2760                 WHERE buf_user-login.db-num = p-db-num
     2761                   AND buf_user-login.user-login = v-login
     2762                 no-lock
     2763                 no-error
     2764                 .
     2765            IF AVAILABLE buf_user-login
     2766            THEN DO:
     2767               assign
     2768                  p-user-id = buf_user-login.user-id
     2769               .
     2770            END.
     2771      end.
     2772   end procedure.
     2773       run diasize_init in this-procedure .
     2774   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2775   on INS of frame Dialog-Frame anywhere do:
     2776     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2777     return no-apply.
     2778   end.
     2779   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2780   on F2 of frame Dialog-Frame anywhere do:
     2781     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2782     return no-apply.
     2783   end.
     2784   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2785   on f5 of frame Dialog-Frame anywhere
     2786   do:
     2787     run refresh-query-action-role in this-procedure .
     2788      run refresh-query-action-item in this-procedure .
     2789       apply "VALUE-CHANGED" to browse-action-item.
     2790   end.
     2791   define variable vss-include-info18 as character format "X(65)" no-undo
     2792   initial "@(#)$Workfile$ $Revision$".
     2793   do:
     2794     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run actn-gbl in g#library2
     2795       ( output v-on-gbl
     2796       ) no-error .
     2797   end.
     2798   MAIN-BLOCK:
     2799   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2800       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2801   if p-db-num = 0 then do:
     2802       assign
     2803           v-current-db-num = v-cntxt-db-num
     2804           .
     2805     end.
     2806     else v-current-db-num = p-db-num .
     2807     if v-on-gbl then v-current-db-num = 0.
     2808       run can-edit-action-role
     2809           (input  v-current-db-num
     2810           ,output v-can-edit-action-role
     2811           ) .
     2812       run fill-db-num-list in this-procedure .
     2813       run assign-filter-mark-role IN THIS-PROCEDURE ( input v-filter-role ) .
     2814       run init-filter-item  IN THIS-procedure.
     2815       RUN enable_UI.
     2816       RUN post_enable_UI.
     2817       WAIT-FOR GO OF FRAME Dialog-Frame.
     2818   END.
     2819   RUN disable_UI.
     2820   PROCEDURE add-gds-grp :
     2821       define input parameter p-gds-list as character        no-undo.
     2822       define buffer buf_action-role-item-gds-grp for ub.action-role-item-gds-grp .
     2823       define variable v-count as integer no-undo.
     2824       do
     2825           on error undo, return error
     2826           :
     2827           FOR EACH  buf_action-role-item-gds-grp
     2828               where buf_action-role-item-gds-grp.db-num           = action-role-item.db-num
     2829               AND buf_action-role-item-gds-grp.action-head-code = action-role-item.action-head-code
     2830               AND buf_action-role-item-gds-grp.action-role-code = action-role-item.action-role-code
     2831               AND buf_action-role-item-gds-grp.action-item-code = action-role-item.action-item-code
     2832               exclusive-lock
     2833               :
     2834               IF LOOKUP(STRING(buf_action-role-item-gds-grp.gds-grp-code), p-Gds-List, chr(4)) = 0
     2835                   THEN
     2836               DO:
     2837                   DELETE buf_action-role-item-gds-grp.
     2838               END.
     2839           END.
     2840           DO v-count = 1 TO NUM-ENTRIES(p-Gds-List, chr(4))
     2841               on error undo, next
     2842               :
     2843               FIND   FIRST buf_action-role-item-gds-grp
     2844                   where buf_action-role-item-gds-grp.db-num               = action-role-item.db-num
     2845                   AND buf_action-role-item-gds-grp.action-head-code     = action-role-item.action-head-code
     2846                   AND buf_action-role-item-gds-grp.action-role-code = action-role-item.action-role-code
     2847                   AND buf_action-role-item-gds-grp.action-item-code         = action-role-item.action-item-code
     2848                   AND buf_action-role-item-gds-grp.gds-grp-code             = INTEGER(ENTRY(v-count, p-Gds-List, chr(4)))
     2849                   no-lock
     2850                   no-error
     2851                   .
     2852               IF NOT AVAILABLE buf_action-role-item-gds-grp THEN
     2853               DO:
     2854                   CREATE buf_action-role-item-gds-grp.
     2855                   ASSIGN
     2856                       buf_action-role-item-gds-grp.db-num                = action-role-item.db-num
     2857                       buf_action-role-item-gds-grp.action-head-code      = action-role-item.action-head-code
     2858                       buf_action-role-item-gds-grp.action-role-code      = action-role-item.action-role-code
     2859                       buf_action-role-item-gds-grp.action-item-code      = action-role-item.action-item-code
     2860                       buf_action-role-item-gds-grp.action-role-item-code = action-role-item.action-role-item-code
     2861                       buf_action-role-item-gds-grp.action-item-id        = action-role-item.action-item-id
     2862                       buf_action-role-item-gds-grp.gds-grp-code          = INTEGER(ENTRY(v-count, p-Gds-List, chr(4)))
     2863                       .
     2864               END.
     2865           END.
     2866       end.
     2867   END PROCEDURE.
     2868   PROCEDURE add-goods :
     2869       define input parameter p-gds-list as character        no-undo.
     2870       define buffer buf_action-role-item-gds for ub.action-role-item-gds .
     2871       define variable v-count as integer no-undo.
     2872       do
     2873           on error undo, return error
     2874           :
     2875           FOR EACH  buf_action-role-item-gds
     2876               where buf_action-role-item-gds.db-num           = action-role-item.db-num
     2877               AND buf_action-role-item-gds.action-head-code = action-role-item.action-head-code
     2878               AND buf_action-role-item-gds.action-role-code = action-role-item.action-role-code
     2879               AND buf_action-role-item-gds.action-item-code = action-role-item.action-item-code
     2880               exclusive-lock
     2881               :
     2882               IF LOOKUP(STRING(buf_action-role-item-gds.gds-code), p-Gds-List, chr(4)) = 0
     2883                   THEN
     2884               DO:
     2885                   DELETE buf_action-role-item-gds.
     2886               END.
     2887           END.
     2888           DO v-count = 1 TO NUM-ENTRIES(p-Gds-List, chr(4))
     2889               on error undo, next
     2890               :
     2891               FIND FIRST buf_action-role-item-gds
     2892                   where buf_action-role-item-gds.db-num            = action-role-item.db-num
     2893                   AND buf_action-role-item-gds.action-head-code = action-role-item.action-head-code
     2894                   AND buf_action-role-item-gds.action-role-code = action-role-item.action-role-code
     2895                   AND buf_action-role-item-gds.action-item-code = action-role-item.action-item-code
     2896                   AND buf_action-role-item-gds.gds-code         = INTEGER(ENTRY(v-count, p-Gds-List, chr(4)))
     2897                   no-lock
     2898                   no-error
     2899                   .
     2900               IF NOT AVAILABLE buf_action-role-item-gds THEN
     2901               DO:
     2902                   CREATE buf_action-role-item-gds.
     2903                   ASSIGN
     2904                       buf_action-role-item-gds.db-num                = action-role-item.db-num
     2905                       buf_action-role-item-gds.action-head-code      = action-role-item.action-head-code
     2906                       buf_action-role-item-gds.action-role-code      = action-role-item.action-role-code
     2907                       buf_action-role-item-gds.action-item-code      = action-role-item.action-item-code
     2908                       buf_action-role-item-gds.action-role-item-code = action-role-item.action-role-item-code
     2909                       buf_action-role-item-gds.action-item-id        = action-role-item.action-item-id
     2910                       buf_action-role-item-gds.gds-code              = INTEGER(ENTRY(v-count, p-Gds-List, chr(4)))
     2911                       .
     2912               END.
     2913           END.
     2914       end.
     2915   END PROCEDURE.
     2916   PROCEDURE assign-filter-mark-item :
     2917       define input parameter p-name-filter    as character        no-undo.
     2918       define buffer buf_temp_filter-fields-item for temp_filter-fields-item .
     2919       define buffer buf_action-item             for action-item .
     2920       do
     2921           on error undo, return error
     2922           :
     2923           for each buf_action-item no-lock
     2924               :
     2925               find first buf_temp_filter-fields-item
     2926                   where buf_temp_filter-fields-item.action-item-code = buf_action-item.action-item-code
     2927                   no-error.
     2928               if not available buf_temp_filter-fields-item
     2929                   then
     2930               do:
     2931                   create buf_temp_filter-fields-item.
     2932                   assign
     2933                       buf_temp_filter-fields-item.action-item-code = buf_action-item.action-item-code
     2934                       buf_temp_filter-fields-item.record-on        = no
     2935                       .
     2936               end.
     2937               if ( p-name-filter = "":U )
     2938                   or index( buf_action-item.action-item-name, p-name-filter ) <> 0
     2939                   or index( buf_action-item.action-item-description, p-name-filter ) <> 0
     2940                   or index( buf_action-item.action-item-id, p-name-filter ) <> 0
     2941                   then
     2942               do:
     2943                   assign
     2944                       buf_temp_filter-fields-item.record-on = yes
     2945                       .
     2946               end.
     2947               else
     2948               do:
     2949                   assign
     2950                       buf_temp_filter-fields-item.record-on = no
     2951                       .
     2952               end.
     2953           end.
     2954       end.
     2955   END PROCEDURE.
     2956   PROCEDURE assign-filter-mark-role :
     2957       define input parameter p-name-filter    as character        no-undo.
     2958       define buffer buf_action-role        for action-role .
     2959       define buffer buf_temp_filter-fields for temp_filter-fields .
     2960       do
     2961           on error undo, return error
     2962           :
     2963           for each buf_action-role no-lock
     2964               where buf_action-role.db-num              = v-current-db-num
     2965               and   buf_action-role.action-head-code    = 0
     2966               :
     2967               find first buf_temp_filter-fields
     2968                   where buf_temp_filter-fields.action-role-code = buf_action-role.action-role-code
     2969                   no-error.
     2970               if not available buf_temp_filter-fields
     2971                   then
     2972               do:
     2973                   create buf_temp_filter-fields.
     2974                   assign
     2975                       buf_temp_filter-fields.action-role-code = buf_action-role.action-role-code
     2976                       buf_temp_filter-fields.record-on        = no
     2977                       .
     2978               end.
     2979               if ( p-name-filter = "":U )
     2980                   OR index(buf_action-role.action-role-name , p-name-filter ) <> 0
     2981                   or index(buf_action-role.action-role-description , p-name-filter ) <> 0
     2982                   then
     2983               do:
     2984                   assign
     2985                       buf_temp_filter-fields.record-on = yes
     2986                       .
     2987               end.
     2988               else
     2989               do:
     2990                   assign
     2991                       buf_temp_filter-fields.record-on = no
     2992                       .
     2993               end.
     2994           end.
     2995       end.
     2996   END PROCEDURE.
     2997   PROCEDURE can-edit-action-role :
     2998       define input  parameter p-db-num   as integer   no-undo .
     2999       define output parameter p-can-edit as logical   no-undo .
     3000       define buffer buf_db for ub.db .
     3001       do
     3002           on error undo, return error return-value
     3003           :
     3004           find first buf_db no-lock
     3005               where buf_db.db-num = v-current-db-num
     3006               no-error .
     3007           if not available buf_db
     3008               then
     3009           do:
     3010               message
     3011                   vss-workfile vss-revision vss-description skip
     3012                   "Внутренняя ошибка" skip
     3013                   "Неизвестный номер БД" v-current-db-num skip
     3014                   view-as alert-box error .
     3015               undo, return error return-value .
     3016           end.
     3017           assign
     3018               p-can-edit = (v-current-db-num = v-cntxt-db-num
     3019                       or
     3020                       buf_db.db-key = '':U
     3021                      )
     3022               .
     3023       end.
     3024   END PROCEDURE.
     3025   PROCEDURE change-items :
     3026       define input parameter p-action-head-code    as integer          no-undo.
     3027       define input parameter p-db-num              as integer          no-undo.
     3028       define input parameter p-action-role-code    as integer          no-undo.
     3029       define input parameter p-action-role-context as character        no-undo.
     3030       DEFINE VARIABLE v-accepted              AS LOGICAL NO-UNDO.
     3031       define variable v-changed               as logical no-undo.
     3032       define variable v-action-item-code      as integer no-undo.
     3033       define variable v-action-role-item-code as integer no-undo .
     3034       define variable v-count                 as integer no-undo .
     3035       define buffer buf_action-item              for ub.action-item .
     3036       define buffer buf_action-role-item         for ub.action-role-item .
     3037       define buffer buf_action-group             for ub.action-group .
     3038       define buffer buf_action-role-item-gds     for ub.action-role-item-gds .
     3039       define buffer buf_action-role-item-gds-grp for ub.action-role-item-gds-grp .
     3040       do for buf_action-item
     3041           , buf_action-role-item
     3042           on error undo, return error
     3043           :
     3044           run actntw_clear in this-procedure.
     3045           each-item_:
     3046           for each  buf_action-item
     3047               where buf_action-item.action-head-code      = p-action-head-code
     3048               and buf_action-item.action-item-context   = p-action-role-context
     3049               no-lock
     3050               on error undo, return error
     3051               :
     3052               find first buf_action-group no-lock
     3053                   where buf_action-group.action-head-code  = buf_action-item.action-head-code
     3054                   and buf_action-group.action-group-code = buf_action-item.action-group-code
     3055                   OR  buf_action-group.action-head-code  = buf_action-item.action-head-code
     3056                   and buf_action-group.action-group-id   = buf_action-item.action-group-id
     3057                   no-error
     3058                   .
     3059               IF NOT AVAILABLE buf_action-group THEN
     3060               DO:
     3061                   next each-item_.
     3062               END.
     3063               find first buf_action-role-item no-lock
     3064                   where buf_action-role-item.db-num           = p-db-num
     3065                   and buf_action-role-item.action-head-code = p-action-head-code
     3066                   and buf_action-role-item.action-role-code = p-action-role-code
     3067                   and buf_action-role-item.action-item-code = buf_action-item.action-item-code
     3068                   no-error
     3069                   .
     3070               define variable v-list as character no-undo.
     3071               IF available buf_action-role-item
     3072                   THEN
     3073               DO:
     3074                   IF ( buf_action-item.action-group-id = "gds":U )
     3075                       THEN
     3076                   DO:
     3077                       assign
     3078                           v-list = "":U
     3079                           .
     3080                       FOR EACH  buf_action-role-item-gds
     3081                           where buf_action-role-item-gds.db-num            = p-db-num
     3082                           AND buf_action-role-item-gds.action-head-code = p-action-head-code
     3083                           AND buf_action-role-item-gds.action-role-code = p-action-role-code
     3084                           AND buf_action-role-item-gds.action-item-code = buf_action-item.action-item-code
     3085                           no-lock
     3086                           :
     3087                           assign
     3088                               v-list = IF v-list = "":U THEN STRING(buf_action-role-item-gds.gds-code)
     3089                                             ELSE v-list + chr(4) + STRING(buf_action-role-item-gds.gds-code)
     3090                               .
     3091                       END.
     3092                   END.
     3093                   IF ( buf_action-item.action-group-id = "gds-grp":U )
     3094                       THEN
     3095                   DO:
     3096                       assign
     3097                           v-list = "":U
     3098                           .
     3099                       FOR EACH  buf_action-role-item-gds-grp
     3100                           where buf_action-role-item-gds-grp.db-num           = p-db-num
     3101                           AND buf_action-role-item-gds-grp.action-head-code = p-action-head-code
     3102                           AND buf_action-role-item-gds-grp.action-role-code = p-action-role-code
     3103                           AND buf_action-role-item-gds-grp.action-item-code = buf_action-item.action-item-code
     3104                           no-lock
     3105                           :
     3106                           assign
     3107                               v-list = IF v-list = "":U THEN STRING(buf_action-role-item-gds-grp.gds-grp-code)
     3108                                             ELSE v-list + chr(4) + STRING(buf_action-role-item-gds-grp.gds-grp-code)
     3109                               .
     3110                       END.
     3111                   END.
     3112               END.
     3113               run actntw_add-item in this-procedure
     3114                   ( input buf_action-item.action-item-code
     3115                   , input buf_action-group.action-group-name
     3116                   , input buf_action-item.action-item-name
     3117                   , input SUBSTITUTE('Тема "&2" &1', string( buf_action-item.action-item-description  ), buf_action-group.action-group-name)
     3118                   , input ( available buf_action-role-item )
     3119                   , INPUT ( buf_action-item.action-group-id = "gds":U )
     3120                   , INPUT ( buf_action-item.action-group-id = "gds-grp":U ) OR ( buf_action-item.action-group-id = "gds":U )
     3121                   , INPUT v-list
     3122                   ) .
     3123           end.
     3124           run str/actntw.w
     3125               ( input parparentproc
     3126               , input 1
     3127               , input "Добавление прав в группу"
     3128               , input "":U
     3129               , input "&Тест"
     3130               , input  table temp_actntw_items
     3131               , input  p-action-head-code
     3132               , input  p-action-role-code
     3133               , output table temp_actntw_itemsSelected
     3134               , output v-changed
     3135               , output v-accepted
     3136               ) .
     3137           IF NOT v-accepted
     3138               THEN
     3139           DO:
     3140               RETURN.
     3141           END.
     3142   if session :set-wait-state( "compiler" ) then.
     3143           IF v-changed then
     3144           do:
     3145               for each  buf_action-item
     3146                 where buf_action-item.action-head-code      = p-action-head-code
     3147                 and buf_action-item.action-item-context   = p-action-role-context
     3148                 no-lock
     3149                 on error undo, return error
     3150                 :
     3151                 for each  buf_action-role-item
     3152                     where buf_action-role-item.db-num            = p-db-num
     3153                     and buf_action-role-item.action-head-code = p-action-head-code
     3154                     and buf_action-role-item.action-role-code = p-action-role-code
     3155                     and buf_action-role-item.action-item-code = buf_action-item.action-item-code
     3156                     exclusive-lock
     3157                     on error undo, return error
     3158                     :
     3159                     find first temp_actntw_itemsSelected
     3160                         where temp_actntw_itemsSelected.itmExtKey = string( buf_action-role-item.action-item-code  )
     3161                         no-error.
     3162                     if not available temp_actntw_itemsSelected
     3163                         then
     3164                     do:
     3165                         delete buf_action-role-item.
     3166                     end.
     3167                 end.
     3168               end.
     3169               for each temp_actntw_itemsSelected
     3170                   :
     3171                   assign
     3172                       v-action-item-code = integer( temp_actntw_itemsSelected.itmExtKey )
     3173            no-error.
     3174                   if error-status :error
     3175                       then
     3176                   do:
     3177                       message
     3178                           vss-workfile vss-revision vss-description
     3179                           skip(1)
     3180                           skip
     3181                           "Ошибка передачи первичного ключа из двухоконного интерфейса."
     3182                           skip return-value
     3183                           skip trim( error-status :get-message( 1 ) )
     3184                           trim( error-status :get-message( 2 ) )
     3185                           trim( error-status :get-message( 3 ) )
     3186                           view-as alert-box error.
     3187                       undo, return error.
     3188                   end.
     3189                   find first buf_action-role-item
     3190                       where buf_action-role-item.db-num           = p-db-num
     3191                       and buf_action-role-item.action-head-code = p-action-head-code
     3192                       and buf_action-role-item.action-role-code = p-action-role-code
     3193                       and buf_action-role-item.action-item-code = v-action-item-code
     3194                       exclusive-lock
     3195                       no-error
     3196                       .
     3197                   if not available buf_action-role-item
     3198                       then
     3199                   do:
     3200                       find first buf_action-item share-lock
     3201                           where buf_action-item.action-head-code = p-action-head-code
     3202                           and buf_action-item.action-item-code = v-action-item-code
     3203                           no-error.
     3204                       if error-status :error
     3205                           then
     3206                       do:
     3207                           message
     3208                               vss-workfile vss-revision vss-description
     3209                               skip(1)
     3210                               skip
     3211                               "Ошибка поиска прав в системе."
     3212                               skip return-value
     3213                               skip trim( error-status :get-message( 1 ) )
     3214                               trim( error-status :get-message( 2 ) )
     3215                               trim( error-status :get-message( 3 ) )
     3216                               view-as alert-box error.
     3217                           undo, return error.
     3218                       end.
     3219                       assign
     3220                           v-action-role-item-code = NEXT-VALUE(s-action-role-item)
     3221                           .
     3222                       create buf_action-role-item.
     3223                       assign
     3224                           buf_action-role-item.db-num                = p-db-num
     3225                           buf_action-role-item.action-head-code      = p-action-head-code
     3226                           buf_action-role-item.action-role-code      = p-action-role-code
     3227                           buf_action-role-item.action-item-code      = v-action-item-code
     3228                           buf_action-role-item.action-item-id        = buf_action-item.action-item-id
     3229                           buf_action-role-item.action-role-item-code = v-action-role-item-code
     3230                           .
     3231                   end.
     3232                   IF temp_actntw_itemsSelected.itmGds
     3233                       THEN
     3234                   DO:
     3235                       FOR EACH  buf_action-role-item-gds
     3236                           where buf_action-role-item-gds.db-num           = buf_action-role-item.db-num
     3237                           AND buf_action-role-item-gds.action-head-code = buf_action-role-item.action-head-code
     3238                           AND buf_action-role-item-gds.action-role-code = buf_action-role-item.action-role-code
     3239                           AND buf_action-role-item-gds.action-item-code = buf_action-role-item.action-item-code
     3240                           exclusive-lock
     3241                           :
     3242                           IF LOOKUP(STRING(buf_action-role-item-gds.gds-code), temp_actntw_itemsSelected.itmGdsList, chr(4)) = 0
     3243                               THEN
     3244                           DO:
     3245                               DELETE buf_action-role-item-gds.
     3246                           END.
     3247                       END.
     3248                       DO v-count = 1 TO NUM-ENTRIES(temp_actntw_itemsSelected.itmGdsList, chr(4))
     3249                           on error undo, next
     3250                           :
     3251                           FIND FIRST buf_action-role-item-gds
     3252                               where buf_action-role-item-gds.db-num           = buf_action-role-item.db-num
     3253                               AND buf_action-role-item-gds.action-head-code = buf_action-role-item.action-head-code
     3254                               AND buf_action-role-item-gds.action-role-code = buf_action-role-item.action-role-code
     3255                               AND buf_action-role-item-gds.action-item-code = buf_action-role-item.action-item-code
     3256                               AND buf_action-role-item-gds.gds-code         = INTEGER(ENTRY(v-count, temp_actntw_itemsSelected.itmGdsList, chr(4)))
     3257                               no-lock
     3258                               no-error
     3259                               .
     3260                           IF NOT AVAILABLE buf_action-role-item-gds THEN
     3261                           DO:
     3262                               CREATE buf_action-role-item-gds.
     3263                               ASSIGN
     3264                                   buf_action-role-item-gds.db-num                = buf_action-role-item.db-num
     3265                                   buf_action-role-item-gds.action-head-code      = buf_action-role-item.action-head-code
     3266                                   buf_action-role-item-gds.action-role-code      = buf_action-role-item.action-role-code
     3267                                   buf_action-role-item-gds.action-item-code      = buf_action-role-item.action-item-code
     3268                                   buf_action-role-item-gds.action-role-item-code = buf_action-role-item.action-role-item-code
     3269                                   buf_action-role-item-gds.action-item-id        = buf_action-role-item.action-item-id
     3270                                   buf_action-role-item-gds.gds-code              = INTEGER(ENTRY(v-count, temp_actntw_itemsSelected.itmGdsList, chr(4)))
     3271                                   .
     3272                           END.
     3273                       END.
     3274                   END.
     3275                   IF temp_actntw_itemsSelected.itmGrp
     3276                       THEN
     3277                   DO:
     3278                       FOR EACH  buf_action-role-item-gds-grp
     3279                           where buf_action-role-item-gds-grp.db-num           = buf_action-role-item.db-num
     3280                           AND buf_action-role-item-gds-grp.action-head-code = buf_action-role-item.action-head-code
     3281                           AND buf_action-role-item-gds-grp.action-role-code = buf_action-role-item.action-role-code
     3282                           AND buf_action-role-item-gds-grp.action-item-code = buf_action-role-item.action-item-code
     3283                           exclusive-lock
     3284                           :
     3285                           IF LOOKUP(STRING(buf_action-role-item-gds-grp.gds-grp-code), temp_actntw_itemsSelected.itmGrpList, chr(4)) = 0
     3286                               THEN
     3287                           DO:
     3288                               DELETE buf_action-role-item-gds-grp.
     3289                           END.
     3290                       END.
     3291                       DO v-count = 1 TO NUM-ENTRIES(temp_actntw_itemsSelected.itmGrpList, chr(4))
     3292                           on error undo, next
     3293                           :
     3294                           FIND FIRST buf_action-role-item-gds-grp
     3295                               where buf_action-role-item-gds-grp.db-num           = buf_action-role-item.db-num
     3296                               AND buf_action-role-item-gds-grp.action-head-code = buf_action-role-item.action-head-code
     3297                               AND buf_action-role-item-gds-grp.action-role-code = buf_action-role-item.action-role-code
     3298                               AND buf_action-role-item-gds-grp.action-item-code = buf_action-role-item.action-item-code
     3299                               AND buf_action-role-item-gds-grp.gds-grp-code         = INTEGER(ENTRY(v-count, temp_actntw_itemsSelected.itmGrpList, chr(4)))
     3300                               no-lock
     3301                               no-error
     3302                               .
     3303                           IF NOT AVAILABLE buf_action-role-item-gds-grp THEN
     3304                           DO:
     3305                               CREATE buf_action-role-item-gds-grp.
     3306                               ASSIGN
     3307                                   buf_action-role-item-gds-grp.db-num                = buf_action-role-item.db-num
     3308                                   buf_action-role-item-gds-grp.action-head-code      = buf_action-role-item.action-head-code
     3309                                   buf_action-role-item-gds-grp.action-role-code      = buf_action-role-item.action-role-code
     3310                                   buf_action-role-item-gds-grp.action-item-code      = buf_action-role-item.action-item-code
     3311                                   buf_action-role-item-gds-grp.action-role-item-code = buf_action-role-item.action-role-item-code
     3312                                   buf_action-role-item-gds-grp.action-item-id        = buf_action-role-item.action-item-id
     3313                                   buf_action-role-item-gds-grp.gds-grp-code          = INTEGER(ENTRY(v-count, temp_actntw_itemsSelected.itmGrpList, chr(4)))
     3314                                   .
     3315                           END.
     3316                       END.
     3317                   END.
     3318               end.
     3319           end.
     3320   if session :set-wait-state( "" ) then.
     3321       end.
     3322   END PROCEDURE.
     3323   PROCEDURE delete-action-role :
     3324       define buffer buf_user-login-action-role for user-login-action-role.
     3325       define buffer buf_action-role-item       for action-role-item.
     3326       define buffer buf_action-role            for action-role.
     3327       do
     3328           on error undo, return error return-value
     3329           :
     3330           MESSAGE SUBSTITUTE('Удалить группу прав "&1"?', action-role.action-role-name )
     3331               VIEW-AS ALERT-BOX QUESTION
     3332               BUTTONS YES-NO
     3333               UPDATE v-yes AS LOGICAL.
     3334           IF NOT v-yes THEN RETURN ERROR.
     3335           IF NOT CAN-FIND (FIRST buf_action-role-item
     3336               WHERE buf_action-role-item.db-num           = action-role.db-num
     3337               AND buf_action-role-item.action-head-code = action-role.action-head-code
     3338               AND buf_action-role-item.action-role-code = action-role.action-role-code
     3339               no-lock) THEN
     3340           DO:
     3341               FOR EACH buf_user-login-action-role WHERE buf_user-login-action-role.db-num           = action-role.db-num
     3342                   AND buf_user-login-action-role.action-head-code = action-role.action-head-code
     3343                   AND buf_user-login-action-role.action-role-code = action-role.action-role-code
     3344                   EXCLUSIVE-LOCK
     3345                   :
     3346                   DELETE buf_user-login-action-role.
     3347               END.
     3348           END.
     3349           else
     3350           do:
     3351               IF CAN-FIND( FIRST buf_user-login-action-role WHERE buf_user-login-action-role.db-num           = action-role.db-num
     3352                   AND buf_user-login-action-role.action-head-code = action-role.action-head-code
     3353                   AND buf_user-login-action-role.action-role-code = action-role.action-role-code
     3354                   NO-LoCK) THEN
     3355               DO:
     3356                   message
     3357                       "В группе прав присутствуют права и группа выдана пользователям."
     3358                       skip
     3359                       "Удалить группу нельзя"
     3360                       view-as alert-box information.
     3361                   RETURN.
     3362               END.
     3363           end.
     3364           FOR EACH buf_action-role-item WHERE buf_action-role-item.db-num           = action-role.db-num
     3365               AND buf_action-role-item.action-head-code = action-role.action-head-code
     3366               AND buf_action-role-item.action-role-code = action-role.action-role-code
     3367               EXCLUSIVE-LOCK
     3368               :
     3369               DELETE buf_action-role-item.
     3370           END.
     3371           find first buf_action-role
     3372               where recid(buf_action-role) = recid(action-role)
     3373               exclusive-lock
     3374               .
     3375           delete buf_action-role.
     3376       end.
     3377   END PROCEDURE.
     3378   PROCEDURE disable_UI :
     3379       HIDE FRAME Dialog-Frame.
     3380   END PROCEDURE.
     3381   PROCEDURE enable_UI :
     3382       DISPLAY rs-scope v-filter-role tb-filter-role v-filter-item tb-filter-item
     3383           role-editor item-EDITOR
     3384           WITH FRAME Dialog-Frame.
     3385       ENABLE b-quit b-sel b-help rs-scope b-print b-mark b-add b-chg b-del b-toggle
     3386           b-users b-hist b-filter-role v-filter-role b-filter-item v-filter-item
     3387           browse-action-role browse-action-item role-editor item-EDITOR
     3388           WITH FRAME Dialog-Frame.
     3389       VIEW FRAME Dialog-Frame.
     3390       RUN refresh-query-action-item .    RUN refresh-query-action-role IN THIS-PROCEDURE .
     3391   END PROCEDURE.
     3392   PROCEDURE fill-db-num-list :
     3393       define buffer buf_db for ub.db .
     3394       define variable v-db-num-list as character no-undo .
     3395       do
     3396           on error undo, return error return-value
     3397           :
     3398           assign
     3399               v-db-num-list = '':U
     3400               .
     3401           for each buf_db
     3402               where (v-cntxt-db-num = 0
     3403               or buf_db.db-num = v-cntxt-db-num
     3404               )
     3405               on error undo, return error return-value
     3406               :
     3407               assign
     3408                   v-db-num-list = v-db-num-list
     3409                         + (if v-db-num-list <> '':U then ',':U else '':U)
     3410                         + string(buf_db.db-num) + ' ':U + replace(string(buf_db.db-name), ',':U, '':U)
     3411                   .
     3412               if buf_db.db-num = v-cntxt-db-num
     3413                   then
     3414               do:
     3415                   assign
     3416                       v-current-db-num-screen-value = string(buf_db.db-num) + ' ':U + replace(string(buf_db.db-name), ',':U, '':U)
     3417                       .
     3418               end.
     3419           end.
     3420           do with frame Dialog-Frame
     3421               :
     3422               assign
     3423                   cb-db :list-items   = v-db-num-list
     3424                   cb-db :screen-value = v-current-db-num-screen-value
     3425                   .
     3426           end.
     3427       end.
     3428   END PROCEDURE.
     3429   PROCEDURE local-open-query-action-item :
     3430       do
     3431           with frame Dialog-Frame
     3432           on error undo, return error return-value
     3433           :
     3434           if available action-role
     3435               then
     3436           do:
     3437               IF tb-filter-item
     3438                   THEN
     3439               DO:
     3440                   assign
     3441                       v-filter-item :bgcolor = RED_COLOR
     3442                       .
     3443               END.
     3444               ELSE
     3445               DO:
     3446                   assign
     3447                       v-filter-item :bgcolor = GREY_COLOR
     3448                       .
     3449               END.
     3450               open query browse-action-item
     3451                   for each action-item
     3452                   where action-item.action-head-code = 0
     3453                   and action-item.action-item-context = action-role.action-role-context
     3454                   NO-LOCK
     3455                   ,
     3456                   FIRST temp_filter-fields-item
     3457                   WHERE temp_filter-fields-item.action-item-code = action-item.action-item-code
     3458                   and (    temp_filter-fields-item.record-on = YES
     3459                   or tb-filter-item = no
     3460                   )
     3461                   NO-LOCK
     3462                   ,
     3463                   FIRST action-group
     3464                   where action-group.action-head-code  = action-item.action-head-code
     3465                   and action-group.action-group-id = action-item.action-group-id
     3466                   NO-LOCK
     3467                   ,
     3468                   first action-role-item no-lock
     3469                   where action-role-item.db-num           = action-role.db-num
     3470                   and action-role-item.action-head-code = action-role.action-head-code
     3471                   and action-role-item.action-role-code = action-role.action-role-code
     3472                   and action-role-item.action-item-code = action-item.action-item-code
     3473                   BY action-item.action-head-code
     3474                   by action-group.action-group-name
     3475                   BY action-item.action-item-context
     3476                   BY action-item.action-group-id
     3477                   BY action-item.action-item-name
     3478                   indexed-reposition .
     3479           end.
     3480           else
     3481           do:
     3482               open query browse-action-item
     3483                   for each action-item
     3484                   where action-item.action-head-code = 0
     3485                   and action-item.action-item-context = '':U
     3486                   no-lock ,
     3487                   FIRST temp_filter-fields-item
     3488                   WHERE temp_filter-fields-item.action-item-code = action-item.action-item-code
     3489                   and temp_filter-fields-item.record-on = YES
     3490                   NO-LOCK
     3491                   ,
     3492                   FIRST action-group
     3493                   where action-group.action-head-code  = action-item.action-head-code
     3494                   and action-group.action-group-code = action-item.action-group-code
     3495                   no-lock,
     3496                   first action-role-item no-lock
     3497                   where action-role-item.db-num           = action-role.db-num
     3498                   and action-role-item.action-head-code = action-role.action-head-code
     3499                   and action-role-item.action-role-code = action-role.action-role-code
     3500                   and action-role-item.action-item-code = action-item.action-item-code
     3501                   indexed-reposition .
     3502           end.
     3503       end.
     3504   END PROCEDURE.
     3505   PROCEDURE local-open-query-action-role :
     3506     define variable v-num-db    as integer      no-undo.
     3507       do
     3508           with frame Dialog-Frame
     3509           on error undo, return error return-value
     3510           :
     3511           IF tb-filter-role
     3512               THEN
     3513           DO:
     3514               assign
     3515                   v-filter-role :bgcolor = RED_COLOR
     3516                   .
     3517           END.
     3518           ELSE
     3519           DO:
     3520               assign
     3521                   v-filter-role :bgcolor = GREY_COLOR
     3522                   .
     3523           END.
     3524           v-num-db = if v-on-gbl then 0
     3525                      else v-current-db-num
     3526           .
     3527           case p-context:
     3528               WHEN 'global':U OR
     3529               WHEN 'firm':U   OR
     3530               WHEN 'object':U THEN
     3531                   DO:
     3532                       open query browse-action-role
     3533                           for each  action-role no-lock
     3534                           where action-role.db-num            = v-num-db
     3535                           and action-role.action-head-code    = 0
     3536                           and action-role.action-role-context = p-context
     3537                           , first temp_filter-fields
     3538                           where temp_filter-fields.action-role-code  = action-role.action-role-code
     3539                           and (     temp_filter-fields.record-on     = yes
     3540                           or tb-filter-role = no
     3541                           )
     3542                           by action-role.action-role-name
     3543                           indexed-reposition .
     3544                   END.
     3545               OTHERWISE
     3546               DO:
     3547                   open query browse-action-role
     3548                       for each action-role no-lock
     3549                       where action-role.db-num                = v-num-db
     3550                       and action-role.action-head-code        = 0
     3551                       , first temp_filter-fields
     3552                       where temp_filter-fields.action-role-code = action-role.action-role-code
     3553                       and (     temp_filter-fields.record-on    = yes
     3554                       or tb-filter-role = no
     3555                       )
     3556                       by action-role.action-role-context
     3557                       by action-role.action-role-name
     3558                       indexed-reposition .
     3559               END.
     3560           END.
     3561       end.
     3562   END PROCEDURE.
     3563   PROCEDURE post_enable_UI :
     3564       DISABLE
     3565           b-quit
     3566           b-sel
     3567           b-help
     3568           b-mark
     3569           b-add
     3570           b-chg
     3571           b-del
     3572           rs-scope
     3573           b-toggle
     3574           browse-action-role browse-action-item
     3575           WITH FRAME Dialog-Frame.
     3576       ENABLE
     3577           b-quit
     3578           b-sel
     3579           WHEN  (lookup  ( "b-sel" , p-bttns) > 0 )
     3580           b-help
     3581           b-mark
     3582           WHEN  (lookup  ( "b-mark" , p-bttns) > 0 )
     3583           b-add
     3584           WHEN  (lookup  ( "b-add" , p-bttns) > 0 )
     3585           b-chg
     3586           WHEN  (lookup  ( "b-add" , p-bttns) > 0 )
     3587           b-del
     3588           WHEN  (lookup  ( "b-add" , p-bttns) > 0 )
     3589           rs-scope
     3590           WHEN  (lookup  ( "rs-scope" , p-bttns) > 0 )
     3591           b-toggle
     3592           WHEN  (lookup  ( "b-add" , p-bttns) > 0 )
     3593           browse-action-role browse-action-item
     3594           WITH FRAME Dialog-Frame.
     3595   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3596   do:
     3597     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3598       (input  v-cntxt-db-num
     3599       ,input  v-cntxt-userid
     3600       ,input  0
     3601       ,input  'actn_actn-update':U
     3602       ,input  'global':U
     3603       ,input  0
     3604       ,input  '':U
     3605       ,input  0
     3606       ,input  0
     3607       ,input  0
     3608       ,input  0
     3609       ,input  FALSE
     3610       ,output v-ok
     3611       )  .
     3612   end.
     3613       if v-ok = FALSE or
     3614         (v-on-gbl and v-cntxt-db-num <> 0)
     3615           then
     3616       do:
     3617           disable
     3618               b-add
     3619               b-chg
     3620               b-del
     3621               b-toggle
     3622               WITH FRAME Dialog-Frame.
     3623       end.
     3624       VIEW FRAME Dialog-Frame.
     3625       RUN refresh-query-action-item .    RUN refresh-query-action-role IN THIS-PROCEDURE .
     3626   END PROCEDURE.
     3627   PROCEDURE procedure-get-action-role-context :
     3628       define input  parameter p-action-context as character no-undo .
     3629       define output parameter p-action-name    as character no-undo .
     3630       do
     3631           on error undo, return error return-value
     3632           :
     3633           case p-action-context
     3634               :
     3635               when 'global':U
     3636               then
     3637                   do:
     3638                       assign
     3639                           p-action-name = "Без привязки"
     3640                           .
     3641                   end.
     3642               when 'firm':U
     3643               then
     3644                   do:
     3645                       assign
     3646                           p-action-name = "фирма"
     3647                           .
     3648                   end.
     3649               when 'object':U
     3650               then
     3651                   do:
     3652                       assign
     3653                           p-action-name = "объект"
     3654                           .
     3655                   end.
     3656               otherwise
     3657               do:
     3658                   message
     3659                       vss-workfile vss-revision vss-description skip
     3660                       "Незвестное значение контекста" skip
     3661                       "p-action-context" p-action-context skip
     3662                       view-as alert-box error .
     3663               end.
     3664           end case .
     3665       end.
     3666   END PROCEDURE.
     3667   PROCEDURE procedure-get-action-role-item-state :
     3668       define input  parameter p-action-item-code       as integer   no-undo .
     3669       define output parameter p-action-role-item-state as character no-undo .
     3670       define buffer buf_action-role-item for ub.action-role-item .
     3671       do
     3672           on error undo, return error return-value
     3673           :
     3674           if available action-role
     3675               then
     3676           do:
     3677               find first buf_action-role-item no-lock
     3678                   where buf_action-role-item.db-num           = action-role.db-num
     3679                   and buf_action-role-item.action-head-code = action-role.action-head-code
     3680                   and buf_action-role-item.action-role-code = action-role.action-role-code
     3681                   and buf_action-role-item.action-item-code = p-action-item-code
     3682                   no-error .
     3683               if available buf_action-role-item
     3684                   then
     3685               do:
     3686                   assign
     3687                       p-action-role-item-state = '*':U
     3688                       .
     3689               end.
     3690               else
     3691               do:
     3692                   assign
     3693                       p-action-role-item-state = '':U
     3694                       .
     3695               end.
     3696           end.
     3697       end.
     3698   END PROCEDURE.
     3699   PROCEDURE refresh-query-action-item :
     3700       do
     3701           on error undo, return error return-value
     3702           :
     3703           run local-open-query-action-item in this-procedure .
     3704           if available action-item then
     3705           do:
     3706               assign
     3707                   item-editor = action-item.action-item-description
     3708                   .
     3709               display
     3710                   item-editor
     3711                   with frame Dialog-Frame.
     3712           end.
     3713       end.
     3714   END PROCEDURE.
     3715   PROCEDURE refresh-query-action-role :
     3716       do
     3717           on error undo, return error return-value
     3718           :
     3719           run local-open-query-action-role in this-procedure .
     3720           if available action-role then
     3721           do:
     3722               assign
     3723                   role-editor = action-role.action-role-description
     3724                   .
     3725               display
     3726                   role-editor
     3727                   with frame Dialog-Frame.
     3728           end.
     3729           run refresh-query-action-item in this-procedure .
     3730       end.
     3731   END PROCEDURE.
     3732   PROCEDURE set-brw-pos :
     3733       define input parameter p-recid        as integer no-undo.
     3734       do
     3735           on error undo, return error return-value
     3736           :
     3737           if p-recid <> ? then
     3738           do:
     3739               reposition browse-action-role to recid p-recid.
     3740           end.
     3741       end.
     3742   END PROCEDURE.
     3743   PROCEDURE show-users-for-role :
     3744       define input parameter p-db-num             as integer          no-undo.
     3745       define input parameter p-action-head-code   as integer          no-undo.
     3746       define input parameter p-action-role-code   as integer          no-undo.
     3747       define input parameter p-action-role-name   as character        no-undo.
     3748       define variable v-accepted    as logical   no-undo.
     3749       define variable v-cur-ext-key as character no-undo.
     3750       define buffer buf_user-login-action-role for user-login-action-role.
     3751       define buffer buf_temp_actnrole-user     for temp_actnrole-user.
     3752       define buffer buf_user-account           for user-account.
     3753       define buffer buf_user-login             for user-login.
     3754       do
     3755           for buf_user-login-action-role
     3756           , buf_temp_actnrole-user
     3757           , buf_user-account
     3758           , buf_user-login
     3759           on error undo, return error
     3760           :
     3761           run onewin_clear in this-procedure.
     3762           empty temp-table buf_temp_actnrole-user.
     3763           for each buf_user-login-action-role no-lock
     3764               where buf_user-login-action-role.db-num              = p-db-num
     3765               and buf_user-login-action-role.action-head-code    = p-action-head-code
     3766               and buf_user-login-action-role.action-role-code    = p-action-role-code
     3767               use-index ie03
     3768               on error undo, return error
     3769               :
     3770               find first buf_temp_actnrole-user
     3771                   where buf_temp_actnrole-user.user-id = buf_user-login-action-role.user-id
     3772                   no-error.
     3773               if not available buf_temp_actnrole-user
     3774                   then
     3775               do:
     3776                   create buf_temp_actnrole-user.
     3777                   assign
     3778                       buf_temp_actnrole-user.user-id = buf_user-login-action-role.user-id
     3779                       .
     3780                   find first buf_user-account no-lock
     3781                       where buf_user-account.user-id = buf_user-login-action-role.user-id
     3782                       .
     3783                   assign
     3784                       buf_temp_actnrole-user.nik        = buf_user-account.nik
     3785                       buf_temp_actnrole-user.lastName   = buf_user-account.last-name
     3786                       buf_temp_actnrole-user.firstName  = buf_user-account.first-name
     3787                       buf_temp_actnrole-user.secondName = buf_user-account.second-name
     3788                       .
     3789               end.
     3790           end.
     3791           for each buf_temp_actnrole-user
     3792               on error undo, return error
     3793               :
     3794               run onewin_add-item in this-procedure (
     3795                   input buf_temp_actnrole-user.user-id
     3796                   , input ( if buf_temp_actnrole-user.nik = "":U then buf_temp_actnrole-user.lastName else buf_temp_actnrole-user.nik )
     3797                   , input substitute( "&1 &2 &3", buf_temp_actnrole-user.lastName, buf_temp_actnrole-user.firstName, buf_temp_actnrole-user.secondName )
     3798                   , input no
     3799                   ).
     3800           end.
     3801           run gbl/onewin.w (
     3802               input parparentproc
     3803               , input 0
     3804               , input substitute( "Список пользователей для группы прав < &1 >", p-action-role-name )
     3805               , input "":U
     3806               , input "&Тест"
     3807               , input table temp_onewin_items
     3808               , output table temp_onewin_itemsSelected
     3809               , output v-cur-ext-key
     3810               , output v-accepted
     3811               ).
     3812       end.
     3813   END PROCEDURE.
     3814   PROCEDURE show-users-for-role-item :
     3815       define input parameter p-db-num             as integer          no-undo.
     3816       define input parameter p-action-head-code   as integer          no-undo.
     3817       define input parameter p-action-item-code   as integer          no-undo.
     3818       define input parameter p-action-item-name   as character        no-undo.
     3819       define variable v-accepted    as logical   no-undo.
     3820       define variable v-cur-ext-key as character no-undo.
     3821       define buffer buf_action-role-item       for action-role-item.
     3822       define buffer buf_user-login-action-role for user-login-action-role.
     3823       define buffer buf_temp_actnrole-user     for temp_actnrole-user.
     3824       define buffer buf_user-account           for user-account.
     3825       define buffer buf_user-login             for user-login.
     3826       do
     3827           for buf_action-role-item
     3828           , buf_user-login-action-role
     3829           , buf_temp_actnrole-user
     3830           , buf_user-account
     3831           , buf_user-login
     3832           on error undo, return error
     3833           :
     3834           run onewin_clear in this-procedure.
     3835           empty temp-table buf_temp_actnrole-user.
     3836           for each buf_action-role-item no-lock
     3837               where buf_action-role-item.db-num           = p-db-num
     3838               and buf_action-role-item.action-head-code = p-action-head-code
     3839               and buf_action-role-item.action-item-code = p-action-item-code
     3840               on error undo, return error
     3841               :
     3842               for each buf_user-login-action-role no-lock
     3843                   where buf_user-login-action-role.db-num              = buf_action-role-item.db-num
     3844                   and buf_user-login-action-role.action-head-code    = buf_action-role-item.action-head-code
     3845                   and buf_user-login-action-role.action-role-code    = buf_action-role-item.action-role-code
     3846                   use-index ie03
     3847                   on error undo, return error
     3848                   :
     3849                   find first buf_temp_actnrole-user
     3850                       where buf_temp_actnrole-user.user-id = buf_user-login-action-role.user-id
     3851                       no-error.
     3852                   if not available buf_temp_actnrole-user
     3853                       then
     3854                   do:
     3855                       create buf_temp_actnrole-user.
     3856                       assign
     3857                           buf_temp_actnrole-user.user-id = buf_user-login-action-role.user-id
     3858                           .
     3859                       find first buf_user-account no-lock
     3860                           where buf_user-account.user-id = buf_user-login-action-role.user-id
     3861                           .
     3862                       assign
     3863                           buf_temp_actnrole-user.nik        = buf_user-account.nik
     3864                           buf_temp_actnrole-user.lastName   = buf_user-account.last-name
     3865                           buf_temp_actnrole-user.firstName  = buf_user-account.first-name
     3866                           buf_temp_actnrole-user.secondName = buf_user-account.second-name
     3867                           .
     3868                   end.
     3869               end.
     3870           end.
     3871           for each buf_temp_actnrole-user
     3872               on error undo, return error
     3873               :
     3874               run onewin_add-item in this-procedure (
     3875                   input buf_temp_actnrole-user.user-id
     3876                   , input ( if buf_temp_actnrole-user.nik = "":U
     3877                   then buf_temp_actnrole-user.lastName else buf_temp_actnrole-user.nik )
     3878                   , input substitute( "&1 &2 &3 (&4)"
     3879                   , buf_temp_actnrole-user.lastName
     3880                   , buf_temp_actnrole-user.firstName
     3881                   , buf_temp_actnrole-user.secondName
     3882                   , buf_temp_actnrole-user.user-id )
     3883                   , input no
     3884                   ).
     3885           end.
     3886           run gbl/onewin.w (
     3887               input parparentproc
     3888               , input 0
     3889               , input substitute( "Список пользователей для права < &1 >", p-action-item-name )
     3890               , input "":U
     3891               , input "&Тест"
     3892               , input table temp_onewin_items
     3893               , output table temp_onewin_itemsSelected
     3894               , output v-cur-ext-key
     3895               , output v-accepted
     3896               ).
     3897       end.
     3898   END PROCEDURE.
     3899   procedure init-filter-item :
     3900       do
     3901           on error undo, return error
     3902           :
     3903           define buffer buf_action-item             for action-item .
     3904           define buffer buf_temp_filter-fields-item for temp_filter-fields-item .
     3905           for each buf_action-item no-lock
     3906               :
     3907               find first buf_temp_filter-fields-item
     3908                   where buf_temp_filter-fields-item.action-item-code = buf_action-item.action-item-code
     3909                   no-error.
     3910               if not available buf_temp_filter-fields-item
     3911                   then
     3912               do:
     3913                   create buf_temp_filter-fields-item.
     3914                   assign
     3915                       buf_temp_filter-fields-item.action-item-code = buf_action-item.action-item-code
     3916                       buf_temp_filter-fields-item.record-on        = no
     3917                       .
     3918               end.
     3919           END.
     3920       end.
     3921   end procedure.
     3922   FUNCTION get-action-role-context RETURNS CHARACTER
     3923       ( BUFFER buf_action-role FOR action-role ) :
     3924       define variable v-return-value as character no-undo .
     3925       run procedure-get-action-role-context in this-procedure
     3926           (input  buf_action-role.action-role-context
     3927           ,output v-return-value
     3928           ) .
     3929       return v-return-value .
     3930   END FUNCTION.
     3931   FUNCTION get-action-role-item-state RETURNS CHARACTER
     3932       ( BUFFER buf_action-item FOR action-item ) :
     3933       define variable v-return-value as character no-undo .
     3934       run procedure-get-action-role-item-state in this-procedure
     3935           (input  buf_action-item.action-item-code
     3936           ,output v-return-value
     3937           ) .
     3938       return v-return-value .
     3939   END FUNCTION.
