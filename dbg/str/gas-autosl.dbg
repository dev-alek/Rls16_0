     1411   end procedure.
     1412   procedure partscr_check-valid-supp :
     1413     define input parameter  p-supp-type         like ub.parts.supp-type no-undo .
     1414     define input parameter  p-supp-code         like ub.parts.supp-code no-undo .
     1415     define input parameter  p-trn-doc-supp-type like ub.parts.supp-type no-undo .
     1416     define input parameter  p-trn-doc-supp-code like ub.parts.supp-code no-undo .
     1417     define input parameter  p-extended-doc-type as character no-undo .
     1418     define output parameter p-old-return        as logical no-undo .
     1419     define output parameter p-reason            as character no-undo .
     1420     assign
     1421       p-old-return = false
     1422       p-reason     = ""
     1423     .
     1424     if p-supp-type <> p-trn-doc-supp-type
     1425     or p-supp-code <> p-trn-doc-supp-code
     1426     then do:
     1427       if p-extended-doc-type = 're':U
     1428       or p-extended-doc-type = 'rs':U
     1429       or p-extended-doc-type = 'vt':U
     1430       or p-extended-doc-type = 'vp':U
     1431       then do:
     1432         if p-supp-type = 'чел':U
     1433         or p-supp-type = 'орг':U
     1434         then do:
     1435           assign
     1436             p-old-return = true
     1437           .
     1438         end.
     1439         else do:
     1440           assign
     1441             p-reason = "Поставщиком партии старого возврата может быть только человек или организация"
     1442           .
     1443           return .
     1444         end.
     1445       end.
     1446       else do:
     1447         assign
     1448           p-reason = "Поставщиком порожденной партии может быть только объект документа"
     1449         .
     1450         return .
     1451       end.
     1452     end.
     1453     return .
     1454   end procedure.
     1455   procedure partscr_get-default-values :
     1456     define parameter buffer buf_doc-line for ub.doc-line .
     1457     define output parameter p-vat-type   as character no-undo .
     1458     define output parameter p-vat-pc     as decimal   no-undo .
     1459     define output parameter p-slt-type   as character no-undo .
     1460     define output parameter p-slt-pc     as decimal   no-undo .
     1461     define buffer buf_trn-doc for ub.trn-doc .
     1462     define buffer buf_goods for ub.goods .
     1463     define variable v-vat-pc as decimal   no-undo .
     1464     define variable v-host-code as integer   no-undo .
     1465     do
     1466     on error undo, return error return-value
     1467     :
     1468       if not available buf_doc-line
     1469       then do:
     1470         message
     1471           vss-workfile vss-revision vss-description skip
     1472           "Ошибка задания входных параметров" skip
     1473           "Не задана строка документа" skip
     1474           view-as alert-box error .
     1475         undo, return error return-value .
     1476       end.
     1477       find first buf_trn-doc no-lock
     1478         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1479         no-error .
     1480       if not available buf_trn-doc
     1481       then do:
     1482         message
     1483           vss-workfile vss-revision vss-description skip
     1484           "Не найден документ" skip
     1485           "Код документа" buf_doc-line.doc-code skip
     1486           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1487           view-as alert-box error .
     1488         undo, return error return-value .
     1489       end.
     1490       find first buf_goods no-lock
     1491         where buf_goods.artic     = buf_doc-line.artic
     1492           and buf_goods.prod-type = buf_doc-line.prod-type
     1493           and buf_goods.prod-code = buf_doc-line.prod-code
     1494         no-error .
     1495       if not available buf_goods
     1496       then do:
     1497         message
     1498           vss-workfile vss-revision vss-description skip
     1499           "Ошибка поиска товара" skip
     1500           "Товар" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1501           view-as alert-box error .
     1502         undo, return error return-value .
     1503       end.
     1504       if buf_trn-doc.ext-doc-type = 'ie':U
     1505       or buf_trn-doc.ext-doc-type = 'im':U
     1506       then do:
     1507         assign
     1508           p-vat-type = buf_trn-doc.vat-type
     1509           p-vat-pc   = buf_doc-line.vat-pc
     1510           p-slt-type = buf_trn-doc.slt-type
     1511           p-slt-pc   = buf_doc-line.slt-pc
     1512         .
     1513       end.
     1514       else do:
     1515   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1516   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
