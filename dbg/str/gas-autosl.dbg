     1757   FUNCTION set-sale-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1758   define variable v-ps as character no-undo .
     1759   if available buf_sale-doc then
     1760   assign
     1761   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1762                       , chr(4)
     1763                       , (if buf_sale-doc.chr-office = 'у':U then "УСЛУГИ." else "ТОВАРЫ." )
     1764                       , entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1765                       , buf_sale-doc.chk-amount
     1766                       , buf_sale-doc.gds-amount
     1767                       , buf_sale-doc.tot-lines
     1768                       , buf_sale-doc.tot-dtl
     1769                       ).
     1770   else  do:
     1771   assign
     1772   v-PS = substitute('&1&2 &1&3&1Кол-во_чеков &4&1строк_чеков &5&1товаров &6&1признаков &7&1'
     1773                       , chr(4)
     1774                       , '':U
     1775                       , entry (lookup ('es':U, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )
     1776                       , 0
     1777                       , 0
     1778                       , 0
     1779                       , 0
     1780                       ).
     1781   end.
     1782   return v-ps.
     1783   END FUNCTION.
     1784   FUNCTION get-sale-doc-kind returns character (
     1785                                                input p-doc-kind as character
     1786                                              , input p-ext-doc-type as character
     1787                                              , output p-order as integer
     1788                                              , output p-msign as integer
     1789                                              , output p-main as logical
     1790                                              , output p-in-inkas as logical
     1791                                              , output p-dir_ as integer
     1792                                              ):
     1793   define variable v-doc-kind as character no-undo.
     1794   define variable v-type as character no-undo .
     1795   define variable v-value as character no-undo .
     1796   CASE p-doc-kind:
     1797     when 'es':U then do:
     1798       assign
     1799       p-order = 100
     1800       p-msign = 1
     1801       p-main = yes
     1802       p-in-inkas = yes
     1803       p-dir_ = 1
     1804       .
     1805       return p-ext-doc-type.
     1806     end.
     1807     when  'rs':U then do:
     1808       assign
     1809       p-order = 200
     1810       p-msign = - 1
     1811       p-main = no
     1812       p-in-inkas = yes
     1813       p-dir_ = - 1
     1814       .
     1815       return p-ext-doc-type.
     1816     end.
     1817     when 'rwo':U then do:
     1818       assign
     1819       p-msign = - 1
     1820       p-main = no
     1821       p-in-inkas = no
     1822       p-order = 300
     1823       p-dir_ = 1
     1824       .
     1825       return 'rwo':U.
     1826     end.
     1827     when 'trf':U then do:
     1828       assign
     1829       p-msign = 1
     1830       p-main = no
     1831       p-in-inkas = no
     1832       p-order = 400
     1833       p-dir_ = 1
     1834       .
     1835       return 'trf':U.
     1836     end.
     1837     when 'swo':U then do:
     1838      assign
     1839      p-msign = 1
     1840      p-main = no
     1841      p-in-inkas = no
     1842      p-order =  500
     1843      p-dir_ = 1
     1844      .
     1845      return 'swo':U.
     1846    end.
     1847    when 'vir':U then do:
     1848      assign
     1849      p-msign = 1
     1850      p-main = no
     1851      p-in-inkas = no
     1852      p-order = 600
     1853      p-dir_ = 1
     1854      .
     1855      return 'vir':U.
     1856    end.
     1857    when 'itr':U then do:
     1858      assign
     1859      p-msign = 1
     1860      p-main = no
     1861      p-in-inkas = no
     1862      p-order = -1
     1863      p-dir_ = -1
     1864      .
     1865     return 'itr':U.
     1866    end.
     1867    when 'ngs':U then do:
     1868      assign
     1869      p-msign = 1
     1870      p-main = no
     1871      p-in-inkas = no
     1872      p-order = 700
     1873      p-dir_ = 1
     1874      .
     1875      return 'ngs':U.
     1876    end.
     1877    when 'rgs':U then do:
     1878      assign
     1879      p-msign = -1
     1880      p-main = no
     1881      p-in-inkas = no
     1882      p-order = 701
     1883      p-dir_ = -1
     1884      .
     1885      return 'rgs':U.
     1886    end.
     1887    otherwise do:
     1888       assign
     1889       p-msign = 1
     1890       p-main = no
     1891       p-in-inkas = no
     1892       p-order = -1.
     1893       return p-ext-doc-type.
     1894     end.
     1895   END CASE.
     1896   END FUNCTION.
     1897   procedure saledoc-create :
     1898   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     1899   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1900   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1901   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1902   define input parameter p-doc-kind as character no-undo .
     1903   define input parameter p-office as character no-undo .
     1904   define input parameter p-tpsidoc as logical no-undo .
     1905   define input parameter p-alias-type-price as character no-undo .
     1906   define input parameter p-price-obj-type as character no-undo .
     1907   define input parameter p-price-obj-code as integer no-undo .
     1908   define parameter buffer buf_trn-doc for ub.trn-doc.
     1909   define variable v-order as integer no-undo.
     1910   define variable v-main as logical no-undo .
     1911   define variable v-in-inkas as logical no-undo .
     1912   define variable v-msign as integer no-undo .
     1913   define variable v-dir_ as integer no-undo .
     1914   define variable v-trn-doc-code as character no-undo .
     1915   define buffer buf_sale-doc for ub.sale-doc.
     1916   main-block:
     1917   do
     1918   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1919   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1920   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1921   :
     1922      if available buf_trn-doc then do:
     1923        v-trn-doc-code = buf_trn-doc.doc-code.
     1924      end.
     1925      find first buf_sale-doc where
     1926               buf_sale-doc.inkas-code = p-inkas-code
     1927           and buf_sale-doc.doc-kind = p-doc-kind
     1928           and buf_sale-doc.chr-office = p-office
     1929           and (v-trn-doc-code = '' or buf_sale-doc.doc-code = v-trn-doc-code)
     1930           no-error .
     1931      if not available buf_sale-doc  then do:
     1932         create buf_sale-doc.
     1933         assign
     1934         buf_sale-doc.inkas-code = p-inkas-code
     1935         buf_sale-doc.storage =  'trn-doc':U
     1936         buf_sale-doc.host-code = p-host-code
     1937         buf_sale-doc.obj-type = p-obj-type
     1938         buf_sale-doc.obj-code = p-obj-code
     1939         buf_sale-doc.doc-kind  = p-doc-kind
     1940         buf_sale-doc.order = lookup(p-doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) * 100 + (if p-office = 'у':U then 5 else 0)
     1941         buf_sale-doc.chr-office = p-office
     1942         buf_sale-doc.doc-code = v-trn-doc-code
     1943         .
     1944      end.
     1945      if available buf_trn-doc then
     1946      buffer-copy buf_trn-doc
     1947      to buf_sale-doc
     1948      .
     1949     assign
     1950     buf_sale-doc.doc-kind = get-sale-doc-kind (
     1951                                                input p-doc-kind
     1952                                               ,input buf_sale-doc.ext-doc-type
     1953                                               ,output v-order
     1954                                               ,output v-msign
     1955                                               ,output v-main
     1956                                               ,output v-in-inkas
     1957                                               ,output v-dir_).
     1958     assign
     1959     buf_sale-doc.order = v-order + (if p-office = 'у':U then 5 else 0)
     1960     buf_sale-doc.main-doc = v-main
     1961     buf_sale-doc.in-inkas = v-in-inkas
     1962     buf_sale-doc.msign = v-msign
     1963     buf_sale-doc.dir = v-dir_
     1964     buf_sale-doc.fbrsale = lookup(buf_sale-doc.doc-kind, 'es,swo':U) > 0
     1965     buf_sale-doc.main-receipt-type = integer(entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,1,6,96,17,69,17,17':U))
     1966     buf_sale-doc.poss-wro-codes = '':U
     1967     buf_sale-doc.chr-office = p-office
     1968     buf_sale-doc.tpsidoc = p-tpsidoc
     1969     buf_sale-doc.alias-type-price = p-alias-type-price
     1970     buf_sale-doc.price-obj-type = (if p-tpsidoc
     1971                                    then p-price-obj-type
     1972                                    else '':U)
     1973     buf_sale-doc.price-obj-code = (if p-tpsidoc
     1974                                    then p-price-obj-code
     1975                                    else 0)
     1976     .
     1977     assign
     1978     buf_sale-doc.poss-wro-codes = (if (v-order > 0 and buf_sale-doc.doc-kind <> 'vir':U) then entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U) + 1, '0,2,-2,-6;-3;-9;-4,17,1;3':U) else '':U)
     1979     no-error.
     1980   end.
     1981   END.
     1982   procedure fbr-saledoc-create :
     1983   define input parameter p-inkas-code as character no-undo .
     1984   define variable v-pri-prvo-doc-qnty like ub.trn-doc.doc-qnty no-undo .
     1985   define variable v-pri-prvo-fact-qnty like ub.trn-doc.doc-qnty no-undo .
     1986   define variable v-pri-prvo-tot-lines like ub.trn-doc.tot-lines no-undo .
     1987   define buffer buf_fbr-doc for ub.fbr-doc.
     1988   define buffer buf_trn-doc for ub.trn-doc.
     1989   define buffer buf_sale-doc for ub.sale-doc.
     1990   define buffer buf2_sale-doc for ub.sale-doc.
     1991   define buffer buf2_trn-doc for ub.trn-doc.
     1992   define buffer buf_doc-line for ub.doc-line.
     1993   define buffer buf_gds-dtl for ub.gds-dtl.
     1994   define buffer buf_chk-gds for ub.chk-gds.
     1995   define buffer buf_chk-doc for ub.chk-doc.
     1996   do
     1997   on error undo, return error
     1998   :
     1999     for each buf_fbr-doc no-lock where
     2000           buf_fbr-doc.out-code = p-inkas-code:
     2001       for each buf_trn-doc no-lock where
     2002             buf_trn-doc.out-code = buf_fbr-doc.doc-code
     2003       by buf_trn-doc.fact-order
     2004       on error undo, return error:
     2005         if buf_trn-doc.ext-doc-type = 'em':U
     2006         or buf_trn-doc.ext-doc-type = 'im':U
     2007         or buf_trn-doc.ext-doc-type = 'wm':U
     2008         or buf_trn-doc.ext-doc-type = 'ev':U
     2009         or buf_trn-doc.ext-doc-type = 'iv':U
     2010         then do:
     2011           find first buf_sale-doc where
     2012                   buf_sale-doc.inkas-code = p-inkas-code
     2013               and buf_sale-doc.doc-code = buf_trn-doc.doc-code
     2014               AND buf_sale-doc.storage  = 'trn-doc':U
     2015                   no-error .
     2016           if not available buf_sale-doc then do:
     2017           create buf_sale-doc.                                                                                             buffer-copy buf_trn-doc                                                                                             to buf_sale-doc.                                                                                                assign                                                                                                                  buf_sale-doc.storage  =  'trn-doc':U                                                                          buf_sale-doc.doc-kind = buf_trn-doc.ext-doc-type                                                                buf_sale-doc.order =  - 1                                                                                          buf_sale-doc.main-doc = no                                                                                             buf_sale-doc.in-inkas = no                                                                                         buf_sale-doc.fbrsale = yes                                                                                         buf_sale-doc.msign = 1                                                                                             buf_sale-doc.filled   = buf_sale-doc.fact-qnty <> 0 or buf_sale-doc.tot-lines <> 0                       buf_sale-doc.doc-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf_sale-doc.doc-qnty)                                                          buf_sale-doc.fact-qnty = (if buf_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf_sale-doc.fact-qnty)                                                        buf_sale-doc.inkas-code = p-inkas-code.
     2018           end.
     2019           if buf_trn-doc.ext-doc-type = 'im':U then do:
     2020             assign
     2021             v-pri-prvo-doc-qnty = buf_trn-doc.doc-qnty
     2022             v-pri-prvo-fact-qnty = buf_trn-doc.fact-qnty
     2023             v-pri-prvo-tot-lines = buf_trn-doc.tot-lines
     2024             .
     2025           end.
     2026           for each buf2_trn-doc no-lock where
     2027                   buf2_trn-doc.out-code = buf_sale-doc.doc-code:
     2028             find first buf2_sale-doc where
     2029                     buf2_sale-doc.inkas-code = p-inkas-code
     2030                 and buf2_sale-doc.doc-code = buf2_trn-doc.doc-code
     2031                 AND buf2_sale-doc.storage = 'trn-doc':U no-error .
     2032             if not available buf2_sale-doc then do:
     2033               create buf2_sale-doc.                                                                                             buffer-copy buf2_trn-doc                                                                                             to buf2_sale-doc.                                                                                                assign                                                                                                                  buf2_sale-doc.storage  =  'trn-doc':U                                                                          buf2_sale-doc.doc-kind = buf2_trn-doc.ext-doc-type                                                                buf2_sale-doc.order =  - 1                                                                                          buf2_sale-doc.main-doc = no                                                                                             buf2_sale-doc.in-inkas = no                                                                                         buf2_sale-doc.fbrsale = yes                                                                                         buf2_sale-doc.msign = 1                                                                                             buf2_sale-doc.filled   = buf2_sale-doc.fact-qnty <> 0 or buf2_sale-doc.tot-lines <> 0                       buf2_sale-doc.doc-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                           then ?                                                                                                                  else buf2_sale-doc.doc-qnty)                                                          buf2_sale-doc.fact-qnty = (if buf2_sale-doc.ext-doc-type = 'pc':U                                                          then ?                                                                                                                  else buf2_sale-doc.fact-qnty)                                                        buf2_sale-doc.inkas-code = p-inkas-code.
     2034             end.
     2035           end.
     2036         end.
     2037       end.
     2038       find first buf_sale-doc where
     2039                 buf_sale-doc.inkas-code = p-inkas-code
     2040             AND buf_sale-doc.storage = 'fbr-doc':U
     2041             AND buf_sale-doc.doc-code = buf_fbr-doc.doc-code no-error .
     2042       if not available buf_sale-doc then do:
     2043         create buf_sale-doc.
     2044         assign
     2045         buf_sale-doc.storage       =  'fbr-doc':U
     2046         buf_sale-doc.doc-type      = 'производство':U
     2047         buf_sale-doc.doc-code      = buf_fbr-doc.doc-code
     2048         buf_sale-doc.ext-doc-type  = 'производство':U
     2049         buf_sale-doc.doc-kind      = 'производство':U
     2050         buf_sale-doc.obj-type      = buf_fbr-doc.obj-type
     2051         buf_sale-doc.obj-code      = buf_fbr-doc.obj-code
     2052         buf_sale-doc.cli-type      = buf_fbr-doc.obj-type
     2053         buf_sale-doc.cli-code      = buf_fbr-doc.obj-code
     2054         buf_sale-doc.doc-qnty      = v-pri-prvo-doc-qnty
     2055         buf_sale-doc.fact-qnty     = v-pri-prvo-fact-qnty
     2056         buf_sale-doc.tot-lines     = v-pri-prvo-tot-lines
     2057         buf_sale-doc.tot-dtl       = v-pri-prvo-tot-lines
     2058         buf_sale-doc.fbrsale       = yes
     2059         buf_sale-doc.inkas-code    = p-inkas-code
     2060         .
     2061       end.
     2062     end.
     2063   end.
     2064   end procedure.
     2065   run saledoc-create in this-procedure (
     2066       input p-inkas-code,
     2067       input buf-sale_trn-doc.host-code,
     2068       input buf-sale_trn-doc.obj-type,
     2069       input buf-sale_trn-doc.obj-code,
     2070       input 'ngs':U,
     2071       input 'т':U,
     2072       input no,
     2073       input '':U,
     2074       input '':U,
     2075       input 0,
     2076       buffer buf-new_trn-doc) no-error.
     2077   find first buf_sysconf where buf_sysconf.host-code = buf-new_trn-doc.host-code no-lock.
     2078   assign
     2079   v-cntxt-rsrv-time = buf_sysconf.rsrv-time
     2080   v-cntxt-load-time = buf_sysconf.load-time
     2081   v-cntxt-holidays = buf_sysconf.holidays.
     2082   run partscr_get-default-values in this-procedure (buffer buf-new_doc-line,
     2083                                                     output v-vat-type,
     2084                                                     output v-vat-pc,
     2085                                                     output v-slt-type,
     2086                                                     output v-slt-pc).
     2087   run partscr in this-procedure
     2088         (input  parparentproc,
     2089          input  buf-new_trn-doc.cr-db-num,
     2090          input  g#userid,
     2091          input
     2092           ( if buf-new_trn-doc.doc-type = 'при':U then buf-new_trn-doc.cli-type else buf-new_trn-doc.obj-type )
     2093    ,
     2094          input
     2095           ( if buf-new_trn-doc.doc-type = 'при':U then buf-new_trn-doc.cli-code else buf-new_trn-doc.obj-code )
     2096    ,
     2097          input  '':U,
     2098          input  '':U,
     2099          input  '':U,
     2100          input  '':U,
     2101          input  buf-new_doc-line.price-base,
     2102          input  buf-new_doc-line.price-rubl,
     2103          input  v-vat-type,
     2104          input  v-vat-pc,
     2105          input  v-slt-type,
     2106          input  v-slt-pc,
     2107          input  buf-new_doc-line.fact-qnty,
     2108          input  "prompt=disable-create",
     2109          input  buf-new_doc-line.cli-qnty,
     2110          input  ?,
     2111          input  ?,
     2112          input  buf_pl-gds.pl-code,
     2113          buffer buf-new_doc-line,
     2114          buffer buf_parts) no-error.
     2115   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_calc-in in g#lib-trn
     2116   ( input parparentproc  ,
     2117     input recid(buf-new_trn-doc)  ,
     2118     input this-procedure   )
     2119   no-error.
     2120   buf-new_trn-doc.tot-calc = buf-new_trn-doc.tot-cli .
     2121   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input buf-new_trn-doc.doc-code ,
     2122                          input 'is-auto-trn':U ,
     2123                          input yes ) no-error .
     2124   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input buf-new_trn-doc.doc-code ,
     2125                          input 'is-fuel':U ,
     2126                          input yes ) no-error .
     2127   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2128   empty temp-table thbjattr_thbj-attr.
     2129   run adm/shattri.p (
     2130      input "get":U
     2131     ,input buf-new_trn-doc.obj-type
     2132     ,input buf-new_trn-doc.obj-code
     2133     ,input 'autosale':U
     2134     ,input  ""
     2135     ,output v-value-character
     2136     ,output v-value-date
     2137     ,output v-value-decimal
     2138     ,output v-value-integer
     2139     ,output v-value-logical
     2140     ,output par-type
     2141     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2142     ) no-error .
     2143   for each thbjattr_thbj-attr :
     2144     if thbjattr_thbj-attr.prop-code = 'wrkr':U then assign v-wrkr = thbjattr_thbj-attr.property-value-integer .
     2145     if thbjattr_thbj-attr.prop-code = 'agnt':U then assign v-agnt = thbjattr_thbj-attr.property-value-integer .
     2146     if thbjattr_thbj-attr.prop-code = 'boss':U then assign v-boss = thbjattr_thbj-attr.property-value-integer .
     2147   end.
     2148   assign
     2149     buf-new_trn-doc.wrkr  = v-wrkr
     2150     buf-new_trn-doc.agnt  = v-agnt
     2151     buf-new_trn-doc.boss  = v-boss
     2152   .
     2153   run str/trn-stat.p (
