      104   procedure doc-code:
      105   define input  parameter parmode          as   character           no-undo.
      106   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      107   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      108   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      109   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      110   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      111   define variable vardb-remote     as   logical             no-undo.
      112   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      113   define variable v-delimiter as character no-undo .
      114   do
      115   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      116   :
      117   find first buf_sys-ctrl no-lock .
      118   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      119     CASE parmode:
      120       when "main":u then do:
      121         if vardb-remote then do:
      122           assign
      123             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      124         end.
      125         else do:
      126           assign
      127             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      128         end.
      129       end.
      130       when "trio" then do:
      131         assign
      132           pardoc-code = replace (parroot-doc-code, "=", "*").
      133       end.
      134       otherwise do:
      135         assign
      136         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      137         no-error
      138         .
      139         if error-status:error  then do:
      140           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      141                                         ,chr(10)
      142                                         ,parmode
      143                                         ).
      144         end.
      145         if num-entries(parmode) = 1
      146         and parmode <> "chip":U
      147         and parmode <> "chip_s":U
      148         then do:
      149           assign
      150           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      151         end.
      152         else if (lookup("chip":U, parmode) > 0
      153                  or
      154                  lookup("chip_s":U, parmode) > 0) then do:
      155           assign
      156             vartemp-doc-code = parroot-doc-code.
      157           do while true:
      158             if index (vartemp-doc-code , ".") = 0 then
      159               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      160             else
      161               vartemp-doc-code  =
      162               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      163               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      164               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      165             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      166           end.
      167           assign
      168             pardoc-code = vartemp-doc-code.
      169         end.
      170       end.
      171     end CASE.
      172     if pardoc-code = '':U
      173     or (parroot-doc-code <> '':U
      174     and pardoc-code = parroot-doc-code) then do:
      175       undo, return error substitute("Ошибка при генерации номера документа&1"
      176                                     ,chr(10)).
      177     end.
      178   end.
      179   end. // procedure/method
      180   function get-doc-code-int64 returns int64
      181     ( input p-doc-code as character ) :
      182     define variable v-ind              as integer   no-undo .
      183     define variable v-num-entries      as integer   no-undo .
      184     define variable v-doc-code-int64   as int64     no-undo .
      185     define variable v-canonic-doc-code as character no-undo .
      186     assign
      187       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      188       v-canonic-doc-code = p-doc-code
      189     .
      190     do v-ind = 1 to v-num-entries
      191     :
      192       assign
      193         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      194       .
      195     end.
      196     assign
      197       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      198     .
      199     return v-doc-code-int64 .
      200   end. // function/method
      201   define variable vss-include-info3 as character format "x(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
