        1   block-level on error undo, throw.
        2   define input  parameter p-chk-doc-code  as character no-undo .
        3   define input  parameter p-trn-doc-close as logical   no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: trnsupds.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: str/trnsupds.p $":U .
        9   def var vss-description as character no-undo init "Расчет cli-gds по ДК".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2', p-chk-doc-code, p-trn-doc-close)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "X(65)" no-undo
       83   initial "@(#)$Workfile$ $Revision$".
       84   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure r-sale :
       86     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
       87     define input parameter  p-artic             like ub.doc-line.artic             no-undo .
       88     define input parameter  p-prod-type         like ub.doc-line.prod-type         no-undo .
       89     define input parameter  p-prod-code         like ub.doc-line.prod-code         no-undo .
       90     define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
       91     define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
       92     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
       93     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
       94     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
       95     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
       96     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
       97     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
       98     define output parameter p-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
       99     define output parameter p-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
      100     define output parameter p-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
      101     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
      102     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
      103     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
      104     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
      105     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
      106     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
      107     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
      108     do
      109     on error undo, return error
      110     :
      111       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
      112       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
      113       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
      114       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
      115       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
      116       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
      117       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
      118       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
      119       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
      120       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
      121       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
      122       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
      123       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
      124       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
      125       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
      126       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
      127       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
      128       define buffer buf_out-vatp_gds-dtl for ub.gds-dtl.
      129       define buffer out-vatp_parts       for ub.parts.
      130       define buffer out-vatp_sysconf     for ub.sysconf.
      131       define buffer out-vatp_doc-line    for ub.doc-line.
      132       define buffer out-vatp_goods       for ub.goods.
      133       define buffer out-vatp_trn-doc     for ub.trn-doc.
      134       define buffer out-vatp_doc-attr    for ub.doc-attr.
      135       define variable varprice-base-cons      like ub.doc-line.price-base initial 0.00 no-undo.
      136       define variable varprice-rubl-cons      like ub.doc-line.price-rubl initial 0.00 no-undo.
      137       define variable varfrm-cnsv-type         as   character                           no-undo.
      138       define variable varfrm-cnsv              as   character                           no-undo.
      139       define variable varroot-node             as   integer                             no-undo.
      140       define variable varempty-scale           as   logical                             no-undo.
      141       define variable varis-cons-parts-have    as   logical                             no-undo.
      142       define variable varsum-base-factovp      like ub.gds-dtl.price-base               no-undo.
      143       define variable varslt-base-factovp      like ub.gds-dtl.price-base               no-undo.
      144       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
      145       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
      146       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
      147       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
      148       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
      149       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
      150       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
      151       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
      152       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      153       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      154       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      155       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
      156       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      157       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      158       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      159       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      160       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
      161       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      162       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
      163       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
      164       define variable varis-one-gds-dtl        as   logical                             no-undo.
      165       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
      166       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
      167       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
      168       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
      169       define variable varoutvprb               as   character                           no-undo.
      170       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
      171       define buffer   in-vatp-trn-doco  for ub.trn-doc .
      172       define buffer   in-vatp-partso    for ub.parts   .
      173       define buffer   in-vatp-doco      for ub.trn-doc .
      174       define buffer   in-vatp-goodso    for ub.goods   .
      175       define buffer   in-vatp-sysconfo  for ub.sysconf .
      176       define buffer   in-vatp_doc-attro for ub.doc-attr.
      177       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
      178       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
      179       define variable varinvprbo                  as   character              no-undo.
      180       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
      181       define variable cli-base-rateo              as   decimal                no-undo.
      182       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
      183       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
      184       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
      185       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
      186       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
      187       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
      188       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
      189       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
      190       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
      191       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
      192       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
      193       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
      194       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
      195       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
      196       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
      197       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
      198       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
      199       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
      200       define variable other-base-loco             like ub.doc-line.price-base no-undo.
      201       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
      202       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
      203       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
      204       define variable varinvatp-envdo             as   character              no-undo.
      205       define variable varinvatp-typeo             as   character              no-undo.
      206       define variable v-gds-dtl-fact-qnty as decimal no-undo .
      207       define buffer buf_gds-dtl  for ub.gds-dtl .
      208       define buffer buf_goods    for ub.goods .
      209       define buffer buf_trn-doc  for ub.trn-doc .
      210       define buffer buf_doc-line for ub.doc-line .
      211       find first buf_doc-line no-lock
      212         where buf_doc-line.doc-code  = p-doc-code
      213           and buf_doc-line.artic     = p-artic
      214           and buf_doc-line.prod-type = p-prod-type
      215           and buf_doc-line.prod-code = p-prod-code
      216         no-error .
      217       if not available buf_doc-line then do:
      218         message
      219           vss-workfile vss-revision vss-description skip
      220           vss-include-info1 skip
      221           "Ошибка задания входных параметров" skip
      222           "Не найдена строка документа" skip
      223           "Документ" p-doc-code skip
      224           "Артикул" p-artic p-prod-type p-prod-code skip
      225           view-as alert-box error .
      226         undo, return error .
      227       end.
      228       find first buf_trn-doc no-lock
      229         where buf_trn-doc.doc-code = buf_doc-line.doc-code
      230         no-error .
      231       if not available buf_trn-doc then do:
      232         message
      233           vss-workfile vss-revision vss-description skip
      234           vss-include-info1 skip
      235           "Не найден документ" skip
      236           "Документ" p-doc-code skip
      237           "Артикул" p-artic p-prod-type p-prod-code skip
      238           view-as alert-box error .
      239         undo, return error .
      240       end.
      241       for each buf_gds-dtl no-lock
      242         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
      243           and buf_gds-dtl.artic     = buf_doc-line.artic
      244           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
      245           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
      246       on error undo, return error
      247       :
      248           if buf_trn-doc.doc-type <> 'инв':U
      249           then do:
      250               if buf_trn-doc.doc-type = 'при':U
      251               or buf_trn-doc.doc-type = 'возврат':U
      252               then do:
      253                   assign
      254                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
      255                   .
      256               end.
      257               else do:
      258                   assign
      259                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
      260                   .
      261               end.
      262           end.
      263           else do:
      264               assign
      265                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
      266               .
      267           end.
      268           if v-gds-dtl-fact-qnty <> 0
      269           then do:
      270   if buf_trn-doc.ext-doc-type = 'ot':U or
      271      buf_trn-doc.ext-doc-type = ?                 then do:
      272     assign
      273      out-vatp-have-vat-slt = yes.
      274   end.
      275   else do:
      276     find first out-vatp_doc-attr no-lock
      277       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
      278         and out-vatp_doc-attr.attr-code = 'envd':U
      279         no-error .
      280     if not available out-vatp_doc-attr then do:
      281       assign
      282         out-vatp-have-vat-slt = yes.
      283     end.
      284     else do:
      285        out-vatp-have-vat-slt = no.
      286     end.
      287   end.
      288   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
      289                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
      290                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
      291   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      293     (input  buf_doc-line.artic
      294     ,input  buf_doc-line.prod-type
      295     ,input  buf_doc-line.prod-code
      296     ,output varroot-node
      297     ) no-error .
      298   if error-status :error then do:
      299     message
      300       vss-workfile vss-revision vss-description skip
      301       "Ошибка при определении корневого признака товара" skip
      302       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      303       error-status :get-message(1) skip
      304       return-value skip
      305       view-as alert-box error .
      306     undo, return error .
      307   end.
      308   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      309     (input  varroot-node
      310     ,input  'empty-scale=request'
      311     ,output varempty-scale
      312     ) no-error .
      313   if error-status :error then do:
      314     message
      315       vss-workfile vss-revision vss-description skip
      316       "Ошибка при определении атрибута признака" skip
      317       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      318       "Признак" varroot-node skip
      319       "Запрашивался атрибут" "empty-scale=request" skip
      320       error-status :get-message(1) skip
      321       return-value skip
      322       view-as alert-box error .
      323     undo, return error .
      324   end.
      325   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      326   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      327     (output varoutvprb
      328     )  .
      329   if varoutvprb = "base":u then do:
      330     assign
      331           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
      332       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
      333     .
      334   end.
      335   else do:
      336     assign
      337           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
      338       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
      339     .
      340   end.
      341   if varoutvprb = "rubl":u then do:
      342     assign
      343           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
      344       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
      345   end.
      346   else do:
      347     assign
      348           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
      349       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
      350   end.
      351   assign
      352     varis-cons-parts-have =  no.
      353   assign
      354     varfact-qnty       = 0
      355     varcons-qnty       = 0
      356     varprice-base-cons = 0
      357     varprice-rubl-cons = 0.
      358   find first out-vatp_doc-line where
      359              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
      360          and out-vatp_doc-line.artic      = buf_doc-line.artic
      361          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
      362          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
      363   if available out-vatp_doc-line           and
      364     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
      365     assign
      366       varfact-qnty = out-vatp_doc-line.fact-qnty.
      367   end.
      368   else do:
      369     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
      370                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
      371                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
      372                                  and out-vatp_parts.artic      = buf_doc-line.artic
      373                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
      374                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
      375       if out-vatp_parts.purch-code = 2 then do:
      376   assign
      377     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
      378     price-base-with-tax-loco = out-vatp_parts.price-base
      379   .
      380   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      381   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      382     (output varinvprbo
      383     )  .
      384     if out-vatp_parts.out-code = 'free-zone':U     or
      385        out-vatp_parts.out-code = 'out-zone':U   or
      386        out-vatp_parts.doc-type = 'акт':U then do:
      387       assign
      388         in-vatp-have-vat-slto = yes.
      389     end.
      390     else do:
      391       find first in-vatp_doc-attro no-lock
      392         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
      393           and in-vatp_doc-attro.attr-code = 'envd':U
      394         no-error .
      395       if not available in-vatp_doc-attro then do:
      396         assign
      397           in-vatp-have-vat-slto = yes.
      398       end.
      399       else do:
      400            in-vatp-have-vat-slto = no.
      401       end.
      402     end.
      403     assign
      404      price-cli-with-tax-loco = out-vatp_parts.price-cli
      405      cli-base-rateo          = out-vatp_parts.cli-base-rate.
      406     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
      407              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
      408     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
      409             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
      410             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
      411             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
      412             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
      413             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
      414             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
      415       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
      416     assign
      417       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
      418     assign
      419       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
      420       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
      421       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
      422       transport-cli-loco  = 0
      423       other-cli-loco      = 0
      424     .
      425   ASSIGN
      426             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
      427       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
      428   .
      429         assign
      430           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
      431           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
      432         assign
      433           varis-cons-parts-have = yes
      434           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
      435       end.
      436       assign
      437         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
      438     end.
      439   end.
      440   assign
      441     varprice-base-cons = varprice-base-cons / varcons-qnty
      442     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
      443   if varprice-base-cons = ? then do:
      444     assign
      445       varprice-base-cons = 0.
      446   end.
      447   if varprice-rubl-cons = ? then do:
      448     assign
      449       varprice-rubl-cons = 0.
      450   end.
      451   assign
      452       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
      453     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
      454     discnt-base-sale            = buf_gds-dtl.discnt-base
      455     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
      456       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
      457     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
      458     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
      459     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
      460     .
      461   if buf_trn-doc.doc-type = 'инв':U then do:
      462     assign
      463       varfact-qnty = buf_gds-dtl.doc-qnty.
      464   end.
      465   else do:
      466     assign
      467       varfact-qnty = buf_gds-dtl.fact-qnty.
      468   end.
      469   if varis-cons-parts-have = no then do:
      470     assign
      471           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
      472           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
      473   end.
      474   else do:
      475     if buf_trn-doc.doc-type = 'инв':U then do:
      476       assign
      477               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      478               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      479        .
      480     end.
      481     else do:
      482       assign
      483               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      484               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
      485        .
      486     end.
      487   end.
      488   assign
      489   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
      490   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
      491               ASSIGN
      492                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
      493                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
      494                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
      495                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
      496                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
      497                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
      498                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
      499                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
      500                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
      501                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
      502                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
      503                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
      504                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
      505               .
      506           end.
      507       end.
      508       assign
      509           p-transport-base      = 0
      510           p-transport-rubl      = 0
      511           p-vat-pc              = buf_doc-line.vat-pc
      512           p-slt-pc              = buf_doc-line.slt-pc
      513       .
      514     end.
      515     if p-fact-qnty      = ?
      516     or p-vat-pc         = ?
      517     or p-slt-pc         = ?
      518     or p-sum-base       = ?
      519     or p-sum-rubl       = ?
      520     or p-vat-base       = ?
      521     or p-vat-rubl       = ?
      522     or p-slt-base       = ?
      523     or p-slt-rubl       = ?
      524     or p-road-tax-base  = ?
      525     or p-road-tax-rubl  = ?
      526     or p-transport-base = ?
      527     or p-transport-rubl = ?
      528     or p-other-base     = ?
      529     or p-other-rubl     = ?
      530     or p-excise-base    = ?
      531     or p-excise-rubl    = ?
      532     then do:
      533       message
      534         vss-workfile vss-revision vss-description skip
      535         vss-include-info1 skip
      536         "Получены неопределенные значения" skip
      537         "Документ" p-doc-code skip
      538         "Артикул" p-artic p-prod-type p-prod-code skip
      539         "fact-qnty     " p-fact-qnty      skip
      540         "vat-pc        " p-vat-pc         skip
      541         "slt-pc        " p-slt-pc         skip
      542         "sum-base      " p-sum-base       skip
      543         "sum-rubl      " p-sum-rubl       skip
      544         "vat-base      " p-vat-base       skip
      545         "vat-rubl      " p-vat-rubl       skip
      546         "slt-base      " p-slt-base       skip
      547         "slt-rubl      " p-slt-rubl       skip
      548         "road-tax-base " p-road-tax-base  skip
      549         "road-tax-rubl " p-road-tax-rubl  skip
      550         "transport-base" p-transport-base skip
      551         "transport-rubl" p-transport-rubl skip
      552         "other-base    " p-other-base     skip
      553         "other-rubl    " p-other-rubl     skip
      554         "excise-base   " p-excise-base    skip
      555         "excise-rubl   " p-excise-rubl    skip
      556         view-as alert-box error .
      557       undo, return error .
      558     end.
      559   end procedure.
      560   define variable v-host-code like ub.sysconf.host-code no-undo .
      561   define variable v-sign as integer no-undo .
      562   define variable v-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
      563   define variable v-vat-pc            like ub.doc-line.vat-pc         no-undo .
      564   define variable v-slt-pc            like ub.doc-line.slt-pc         no-undo .
      565   define variable v-sum-base          like ub.ot-line.sum-base        no-undo .
      566   define variable v-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
      567   define variable v-vat-base          like ub.ot-line.vat-base        no-undo .
      568   define variable v-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
      569   define variable v-slt-base          like ub.ot-line.slt-base        no-undo .
      570   define variable v-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
      571   define variable v-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
      572   define variable v-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
      573   define variable v-transport-base    like ub.ot-line.transport-base  no-undo .
      574   define variable v-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
      575   define variable v-other-base        like ub.ot-line.other-base      no-undo .
      576   define variable v-other-rubl        like ub.ot-line.other-rubl      no-undo .
      577   define variable v-excise-base       like ub.ot-line.excise-base     no-undo .
      578   define variable v-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
      579   define variable v-curr-r-b          as character                    no-undo .
      580   DEFINE VARIABLE  pay-sum-base as decimal no-undo.
      581   DEFINE VARIABLE  pay-sum-rubl as decimal no-undo.
      582   DEFINE VARIABLE  discnt-sum-base as decimal no-undo .
      583   DEFINE VARIABLE  discnt-sum-rubl as decimal no-undo .
      584   define variable v-doc-code like ub.trn-doc.doc-code no-undo .
      585   define variable ret-doc-code like ub.trn-doc.doc-code no-undo .
      586   define buffer buf_chk-doc for ub.chk-doc.
      587   define buffer buf_chk-gds for ub.chk-gds.
      588   define buffer buf_bar-code for ub.bar-code.
      589   define buffer buf_goods for ub.goods.
      590   define buffer buf_gds-dtl for ub.gds-dtl.
      591   define buffer buf_doc-line for ub.doc-line.
      592   define buffer buf_cli-gds for ub.cli-gds.
      593   define buffer buf_clients for ub.clients.
      594   define buffer buf_trn-doc for ub.trn-doc.
      595   define buffer buf_ret-doc for ub.trn-doc.
      596   define buffer buf_dis-card for ub.dis-card.
      597   _main:
      598   do
      599   on error undo, return error
      600   :
      601     find first buf_chk-doc no-lock where
      602               buf_Chk-doc.doc-code = p-chk-doc-code no-error .
      603     if not available buf_chk-doc then do:
      604        undo _main, return error substitute("Не найден чек с номером &1", p-chk-doc-code).
      605     end.
      606     find first buf_dis-card no-lock where
      607               buf_dis-card.d-card = buf_chk-doc.d-card no-error .
      608     if not available buf_dis-card then do:
      609         undo _main, return error substitute("Не найдена дисконтная карта с номером &1 по чеку &2 в продаже &3"
      610                                           , buf_chk-doc.d-card
      611                                           , buf_chk-doc.doc-code
      612                                           , buf_chk-doc.out-code).
      613     end.
      614     find first buf_trn-doc no-lock where
      615               buf_trn-doc.doc-code = buf_chk-doc.out-code no-error .
      616     if not available buf_trn-doc then do:
      617        undo _main, return error substitute("Не найден документ с номером &1", buf_chk-doc.out-code).
      618     end.
      619     if buf_chk-doc.netto < 0 then do:
      620       find first buf_ret-doc no-lock where
      621                 buf_ret-doc.doc-code = buf_trn-doc.out-code no-error .
      622       if available buf_ret-doc then do:
      623         ret-doc-code = buf_ret-doc.doc-code.
      624       end.
      625       else do:
      626         ret-doc-code = '':U.
      627       end.
      628     end.
      629     assign
      630     v-host-code = buf_trn-doc.host-code
      631     v-sign = (if p-trn-doc-close then 1 else - 1)
      632     v-doc-code = (if buf_chk-doc.netto >= 0 then buf_trn-doc.doc-code else ret-doc-code)
      633     .
      634   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      635   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      636     (output v-curr-r-b
      637     )  .
      638     _chk-gds:
      639     for  EACH buf_chk-gds WHERE
      640                 buf_chk-gds.doc-code = buf_chk-doc.doc-code AND
      641                 buf_chk-gds.b-code <> 0 NO-LOCK ,
      642           FIRST buf_bar-code where
      643                 buf_bar-code.b-code = buf_chk-gds.b-code No-LOCK,
      644           FIRST buf_goods where
      645                 buf_goods.gds-code = buf_bar-code.gds-code No-LOCK,
      646           FIRST buf_doc-line WHERE
      647                 buf_doc-line.doc-code = v-doc-code AND
      648                 buf_doc-line.prod-code = buf_goods.prod-code AND
      649                 buf_doc-line.prod-type = buf_goods.prod-type AND
      650                 buf_doc-line.artic     = buf_goods.artic NO-LOCK
      651                 On error undo _main, return error
      652                 :
      653         if buf_chk-gds.write-off-code <> ?
      654         and buf_chk-gds.write-off-code > 0 then NEXT _chk-gds.
      655         FIND FIRST buf_cli-gds WHERE
      656                     buf_cli-gds.cli-type  = buf_dis-card.cli-type AND
      657                     buf_cli-gds.cli-code  = buf_dis-card.cli-code AND
      658                     buf_cli-gds.artic     = buf_goods.artic AND
      659                     buf_cli-gds.prod-type = buf_goods.prod-type AND
      660                     buf_cli-gds.prod-code = buf_goods.prod-code AND
      661                     buf_cli-gds.host-code = v-host-code NO-ERROR .
      662         if NOT available buf_cli-gds then do:
      663           CREATE buf_cli-gds.
      664           assign
      665           buf_cli-gds.artic      = buf_goods.artic
      666           buf_cli-gds.prod-code  = buf_goods.prod-code
      667           buf_cli-gds.prod-type  = buf_goods.prod-type
      668           buf_cli-gds.host-code  = v-host-code
      669           buf_cli-gds.cli-type   = buf_dis-card.cli-type
      670           buf_cli-gds.cli-code   = buf_dis-card.cli-code
      671           buf_cli-gds.out-qnty   = 0
      672           buf_cli-gds.out-sum    = 0
      673           buf_cli-gds.ret-qnty   = 0
      674           buf_cli-gds.ret-sum    = 0
      675           buf_cli-gds.out-discnt = 0
      676           buf_cli-gds.ret-discnt = 0
      677           .
      678         end.
      679         if buf_chk-gds.doc-qnty > 0 then
      680         assign
      681         buf_cli-gds.out-qnty = buf_cli-gds.out-qnty + v-sign * buf_chk-gds.doc-qnty
      682         buf_cli-gds.out-sum = buf_cli-gds.out-sum +
      683                             v-sign * ( buf_chk-gds.price-base - buf_chk-gds.discnt ) * buf_chk-gds.doc-qnty
      684         buf_cli-gds.out-discnt = buf_cli-gds.out-discnt +
      685                                 v-sign * buf_chk-gds.discnt * buf_chk-gds.doc-qnty
      686         .
      687         else
      688         assign
      689         buf_cli-gds.ret-qnty = buf_cli-gds.ret-qnty - v-sign * buf_chk-gds.doc-qnty
      690         buf_cli-gds.ret-sum = buf_cli-gds.ret-sum -
      691                             v-sign * ( buf_chk-gds.price-base - buf_chk-gds.discnt ) * buf_chk-gds.doc-qnty
      692         buf_cli-gds.ret-discnt = buf_cli-gds.ret-discnt -
      693                                 v-sign * buf_chk-gds.discnt * buf_chk-gds.doc-qnty
      694         .
      695     END.
      696   end.
