        1   define input parameter parhost-code like ub.clients.obj-code no-undo.
        2   define input parameter pardefobj-type like ub.clients.obj-type no-undo.
        3   define input parameter pardefobj-code like ub.clients.obj-code no-undo.
        4   define output parameter parobj-type like ub.clients.obj-type no-undo.
        5   define output parameter parobj-code like ub.clients.obj-code no-undo.
        6   define temp-table tt-shst no-undo
        7   field obj-type like ub.clients.obj-type
        8   field obj-code like ub.clients.obj-code
        9   field obj-name like ub.clients.obj-name
       10   index pi is unique primary obj-type obj-code.
       11   define buffer bf_tt-shst for tt-shst.
       12   define new global shared variable g#language as character no-undo .
       13   if g#language <> '' and g#language <> 'rus':U then do:
       14     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       15   end.
       16   procedure proc-alt-shift-f2:
       17     if not ibs.th.gbl.gbl-var:rcode
       18   then
       19     run gbl\inidebug.p .
       20   end.
       21   procedure proc-alt-shift-f3:
       22     run gbl/prvssinf.p
       23       ( input this-procedure
       24       ) .
       25   end.
       26   define variable v-inform-launched as logical no-undo initial false .
       27   procedure proc-alt-shift-f4:
       28     define variable v-action as character no-undo .
       29     if v-inform-launched = false then do:
       30       assign
       31         v-inform-launched = true
       32       .
       33       run gbl/d-inform.w
       34         (  input self
       35         ,  input this-procedure
       36         , output v-action
       37         ) no-error .
       38       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       39       assign
       40         v-inform-launched = false
       41       .
       42     end.
       43   end.
       44   procedure proc-alt-f1:
       45     run gbl/corrhelp.p
       46       (input this-procedure
       47       ) .
       48   end .
       49   on alt-shift-f2 anywhere do:
       50     run proc-alt-shift-f2.
       51   end.
       52   on alt-shift-f3 anywhere do:
       53     run proc-alt-shift-f3 in this-procedure .
       54   end.
       55   on alt-shift-f4 anywhere do:
       56     run proc-alt-shift-f4 in this-procedure.
       57   end.
       58   on alt-f1 anywhere do:
       59     run proc-alt-f1 in this-procedure .
       60   end.
       61   DEFINE BUTTON b-cancel AUTO-END-KEY
       62        LABEL "&Отмена"
       63        SIZE 10 BY 1
       64        BGCOLOR 8 .
       65   DEFINE BUTTON b-chs AUTO-GO
       66        LABEL "&Выбор"
       67        SIZE 10 BY 1
       68        BGCOLOR 8 .
       69   DEFINE BUTTON b-help
       70        LABEL "&Помощь"
       71        SIZE 10 BY 1
       72        BGCOLOR 8 .
       73   DEFINE QUERY b-shst FOR
       74         tt-shst SCROLLING.
       75   DEFINE BROWSE b-shst
       76     QUERY b-shst DISPLAY
       77         tt-shst.obj-code
       78   tt-shst.obj-type
       79   tt-shst.obj-name
       80       WITH NO-ROW-MARKERS SEPARATORS SIZE 46.13 BY 9.88.
       81   DEFINE FRAME Dialog-Frame
       82        b-chs AT ROW 1.08 COL 1.63
       83        b-cancel AT ROW 1.08 COL 12.13
       84        b-help AT ROW 1.08 COL 22.63
       85        b-shst AT ROW 2.29 COL 1.38
       86        SPACE(0.23) SKIP(0.11)
       87       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       88            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       89            TITLE "Выбор объекта"
       90            DEFAULT-BUTTON b-chs CANCEL-BUTTON b-cancel.
       91   ASSIGN
       92          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       93          FRAME Dialog-Frame:HIDDEN           = TRUE.
       94   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       95   DO:
       96     APPLY "END-ERROR":U TO SELF.
       97   END.
       98   ON CHOOSE OF b-chs IN FRAME Dialog-Frame
       99   DO:
      100     if available tt-shst then do:
      101       assign
      102         parobj-type = tt-shst.obj-type
      103         parobj-code = tt-shst.obj-code.
      104     end.
      105   END.
      106   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      107   DO:
      108   END.
      109   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      110   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      111   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   on help of frame Dialog-Frame
      113   do:
      114     run gbl/app_help.p
      115       (input this-procedure :file-name
      116       ,input ''
      117       ,input ?
      118       ) no-error.
      119     if error-status :error then do:
      120       message
      121         "Ошибка при вызове помощи"
      122         error-status :get-message(1)
      123         view-as alert-box .
      124     end.
      125   end.
      126   run minbtn-set in this-procedure .
      127   on choose of b-help in frame Dialog-Frame
      128   do:
      129     apply "help":u to frame Dialog-Frame .
      130   end.
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   procedure minbtn-set :
      133       do
      134           on error undo, return error return-value
      135           :
      136           define variable ii              as integer       no-undo .
      137           define variable fh              as widget-handle no-undo .
      138           define variable hh              as widget-handle no-undo .
      139           define variable v-h             as handle        extent 4 no-undo .
      140           define variable v-name-button   as character     no-undo .
      141           define variable v-help-old-x    as decimal       no-undo .
      142           define variable v-help-old-y    as decimal       no-undo .
      143           define variable v-help-old-size as decimal       no-undo .
      144           define variable v-frame-width   as decimal       no-undo .
      145           define variable jj              as integer       no-undo .
      146           do
      147               on error undo, return error
      148               :
      149               assign
      150                   v-frame-width = frame Dialog-Frame:width - 0.3
      151                   fh            = frame Dialog-Frame:first-child
      152                   hh            = fh:first-child
      153                   ii            = 1
      154                   .
      155               do while valid-handle(hh):
      156                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      157                   do:
      158                       case lc(hh:name) :
      159                           when "b-help" then
      160                               do:
      161                                   hh:load-image-up("cmp/b-help.bmp":u) .
      162                                   hh:load-image-down("cmp/b-help.bmp":u) .
      163                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      164                                   hh:TOOLTIP = "Помощь" .
      165                                   v-help-old-x = hh:column .
      166                                   v-help-old-y = hh:row    .
      167                                   v-help-old-size = hh:width .
      168                                   hh:width-chars = 2.5 .
      169                               end.
      170                           when "b-print" then
      171                               do:
      172                                   hh:load-image("cmp/b-print.bmp":u) .
      173                                   hh:TOOLTIP = "Печать" .
      174                                   v-h[ii] = hh:handle .
      175                                   ii = ii + 1 .
      176                                   hh:width-chars = 3 .
      177                               end.
      178                           when "b-history" or
      179                           when "b-hist" then
      180                               do:
      181                                   hh:load-image("cmp/b-hist.bmp":u) .
      182                                   hh:TOOLTIP = "История" .
      183                                   v-h[ii] = hh:handle .
      184                                   ii = ii + 1 .
      185                                   hh:width-chars = 3 .
      186                               end.
      187                           when "b-sch" then
      188                               do:
      189                                   hh:load-image("cmp/b-sch.bmp":u) .
      190                                   hh:TOOLTIP = "Установка Фильтра" .
      191                                   v-h[ii] = hh:handle .
      192                                   ii = ii + 1 .
      193                                   hh:width-chars = 3 .
      194                               end.
      195                           when "b-hist-user" then
      196                               do:
      197                                   hh:load-image("cmp/b-hist.bmp":u) .
      198                                   hh:TOOLTIP = "История пользователя" .
      199                                   ii = ii + 1 .
      200                               end.
      201                       end case.
      202                   end.
      203                   hh = hh:next-sibling.
      204               end.
      205               b-help:column = v-frame-width - b-help:width-chars.
      206               jj = 0.
      207               repeat ii = 4 to 1 by -1 :
      208                   if valid-handle (v-h[ii] ) then
      209                   do:
      210                       jj  = jj + 1 .
      211                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      212                       v-h[ii]:row    = v-help-old-y .
      213                   end.
      214               end.
      215           end.
      216       end.
      217   end procedure.
      218   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      219   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      220   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      221   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      222   define variable v-diasize-current-frame-width  as decimal   no-undo .
      223   define variable v-diasize-current-frame-height as decimal   no-undo .
      224   define variable v-diasize-change-size          as logical   no-undo .
      225   define variable v-diasize-resize-button        as handle    no-undo .
      226   define variable v-diasize-wndmax               as logical   no-undo .
      227   define variable v-diasize-wndstore             as logical   no-undo .
      228   define variable v-diasize-proc-name            as character no-undo .
      229   define variable v-diasize-browse-handle        as handle    no-undo .
      230   define variable v-diasize-browse-number        as integer   no-undo .
      231   define variable v-diasize-need-full-display    as logical   no-undo init false .
      232   define temp-table temp-diasize-handle no-undo
      233     field handle-value  as handle
      234     field save-position as decimal
      235     index xpk is primary unique handle-value
      236     .
      237   define temp-table temp-browse-handle no-undo
      238     field browse-type   as character
      239     field browse-number as integer
      240     field browse-handle as handle
      241     field original-size as decimal
      242     index xpk is primary unique browse-type browse-number
      243     index xie browse-type browse-handle
      244   .
      245   procedure diasize_change-height :
      246     define input  parameter p-change-value  as decimal   no-undo .
      247     define input  parameter p-move-resize   as logical   no-undo .
      248     define variable v-field-group-handle    as handle    no-undo .
      249     define variable v-object-handle         as handle    no-undo .
      250     define variable v-frame-height          as decimal   no-undo .
      251     define variable v-frame-virtual-height  as decimal   no-undo .
      252     define variable v-browse-height         as decimal   no-undo .
      253     define variable v-window-height         as decimal   no-undo .
      254     define variable v-window-virtual-height as decimal   no-undo .
      255     define variable v-change-sign           as integer   no-undo .
      256     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      257     define buffer buf_temp-browse-handle  for temp-browse-handle .
      258     if p-change-value > 0
      259     then do:
      260       if frame Dialog-Frame :height + p-change-value
      261           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      262       then do:
      263         assign
      264           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      265                           - (frame Dialog-Frame :height-chars)
      266         .
      267         if p-change-value <= 0
      268         then do:
      269           run diasize_position-resize-button in this-procedure .
      270           return .
      271         end.
      272       end.
      273     end.
      274     if p-change-value < 0
      275     then do:
      276       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      277       then do:
      278         assign
      279           p-change-value = v-diasize-orig-frame-height
      280                          - (frame Dialog-Frame :height-chars)
      281         .
      282         if p-change-value >= 0
      283         then do:
      284           run diasize_position-resize-button in this-procedure .
      285           return .
      286         end.
      287       end.
      288     end.
      289     if p-change-value >= 0
      290     then do:
      291       assign
      292         v-change-sign = 1
      293       .
      294     end.
      295     else do:
      296       assign
      297         v-change-sign = -1
      298       .
      299     end.
      300     assign
      301       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      302     .
      303     if p-change-value = 0
      304     then do:
      305       run diasize_position-resize-button in this-procedure .
      306       return .
      307     end.
      308     move_block:
      309     do
      310     on error undo move_block, retry move_block
      311     :
      312       if retry
      313       then do:
      314         do
      315         on error undo move_block, leave move_block
      316         :
      317           if p-change-value > 0
      318           then do:
      319             for each buf_temp-diasize-handle
      320             on error undo, next
      321             :
      322               assign
      323                 v-object-handle = buf_temp-diasize-handle.handle-value
      324               .
      325               if v-object-handle <> v-diasize-resize-button
      326               then do:
      327                 assign
      328                   v-object-handle :row = buf_temp-diasize-handle.save-position
      329                 .
      330               end.
      331             end.
      332             assign
      333               v-diasize-browse-handle :height = v-browse-height
      334             .
      335             for each buf_temp-browse-handle
      336               where buf_temp-browse-handle.browse-type = 'height':u
      337             on error undo, next
      338             :
      339               assign
      340                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      341               .
      342             end.
      343             assign
      344               frame Dialog-Frame :height = v-frame-height
      345             .
      346             if frame Dialog-Frame :scrollable = true
      347             then do:
      348               assign
      349                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      350               .
      351             end.
      352             run diasize_position-resize-button in this-procedure .
      353           end.
      354           else do:
      355             if frame Dialog-Frame :scrollable = true
      356             then do:
      357               assign
      358                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      359               .
      360             end.
      361             assign
      362               frame Dialog-Frame :height = v-frame-height
      363             .
      364             assign
      365               v-diasize-browse-handle :height = v-browse-height
      366             .
      367             for each buf_temp-browse-handle
      368               where buf_temp-browse-handle.browse-type = 'height':u
      369             on error undo, next
      370             :
      371               assign
      372                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      373               .
      374             end.
      375             for each buf_temp-diasize-handle
      376             on error undo, next
      377             :
      378               assign
      379                 v-object-handle = buf_temp-diasize-handle.handle-value
      380               .
      381               if v-object-handle <> v-diasize-resize-button
      382               then do:
      383                 assign
      384                   v-object-handle :row = buf_temp-diasize-handle.save-position
      385                 .
      386               end.
      387             end.
      388             run diasize_position-resize-button in this-procedure .
      389           end.
      390           assign
      391             v-diasize-change-size = false
      392           .
      393           leave move_block .
      394         end.
      395       end.
      396       assign
      397         v-diasize-need-full-display = true
      398       .
      399       if v-diasize-change-size = false
      400       then do:
      401         assign
      402           v-diasize-change-size = true
      403         .
      404       end.
      405       else do:
      406         return .
      407       end.
      408       assign
      409         v-frame-height = frame Dialog-Frame :height
      410         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      411         v-browse-height = v-diasize-browse-handle :height
      412       .
      413       for each buf_temp-browse-handle
      414         where buf_temp-browse-handle.browse-type = 'height':u
      415       :
      416         assign
      417           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      418         .
      419       end.
      420       for each buf_temp-diasize-handle
      421       :
      422         delete buf_temp-diasize-handle .
      423       end.
      424       assign
      425         v-field-group-handle = frame Dialog-Frame :first-child
      426       .
      427       do while valid-handle(v-field-group-handle)
      428       :
      429         assign
      430           v-object-handle = v-field-group-handle :first-child
      431         .
      432         do while valid-handle(v-object-handle)
      433         :
      434           if  v-object-handle <> v-diasize-browse-handle :handle
      435           and can-query(v-object-handle, "row")
      436           and can-query(v-object-handle, "height")
      437           and ( v-object-handle :row > v-diasize-browse-handle :row )
      438           then do:
      439             find first buf_temp-browse-handle
      440               where buf_temp-browse-handle.browse-type   = 'height':u
      441                 and buf_temp-browse-handle.browse-handle = v-object-handle
      442               no-error .
      443             if available buf_temp-browse-handle
      444             then do:
      445             end.
      446             else do:
      447               create buf_temp-diasize-handle .
      448               assign
      449                 buf_temp-diasize-handle.handle-value  = v-object-handle
      450                 buf_temp-diasize-handle.save-position = v-object-handle :row
      451               .
      452             end.
      453           end.
      454           assign
      455             v-object-handle = v-object-handle :next-sibling
      456           .
      457         end.
      458         assign
      459           v-field-group-handle = v-field-group-handle :next-sibling
      460         .
      461       end.
      462       do with frame Dialog-Frame
      463       :
      464         hide v-diasize-resize-button .
      465         assign
      466           v-diasize-resize-button :row    = 1
      467           v-diasize-resize-button :column = 1
      468         .
      469       end.
      470       if p-change-value > 0
      471       then do:
      472         if frame Dialog-Frame :scrollable = true
      473         then do:
      474           assign
      475             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      476             no-error .
      477           if error-status :error
      478           or error-status :get-message(1) <> ""
      479           then do:
      480             undo move_block, retry move_block .
      481           end.
      482         end.
      483         assign
      484           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      485           no-error .
      486         if error-status :error
      487         or error-status :get-message(1) <> ""
      488         then do:
      489           undo move_block, retry move_block .
      490         end.
      491         assign
      492           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      493           no-error .
      494         if error-status :error
      495         or error-status :get-message(1) <> ""
      496         then do:
      497           undo move_block, retry move_block .
      498         end.
      499         for each buf_temp-browse-handle
      500           where buf_temp-browse-handle.browse-type = 'height':u
      501         on error undo move_block, retry move_block
      502         :
      503           assign
      504             buf_temp-browse-handle.browse-handle :height
      505               = buf_temp-browse-handle.browse-handle :height + p-change-value
      506             no-error .
      507           if error-status :error
      508           or error-status :get-message(1) <> ""
      509           then do:
      510             undo move_block, retry move_block .
      511           end.
      512         end.
      513         for each buf_temp-diasize-handle
      514         on error undo move_block, retry move_block
      515         :
      516           assign
      517             v-object-handle = buf_temp-diasize-handle.handle-value
      518           .
      519           if v-object-handle <> v-diasize-resize-button
      520           then do:
      521             assign
      522               v-object-handle :row = v-object-handle :row + p-change-value
      523               no-error .
      524             if error-status :error
      525             or error-status :get-message(1) <> ""
      526             then do:
      527               undo move_block, retry move_block .
      528             end.
      529           end.
      530         end.
      531       end.
      532       else do:
      533         for each buf_temp-diasize-handle
      534         on error undo move_block, retry move_block
      535         :
      536           assign
      537             v-object-handle = buf_temp-diasize-handle.handle-value
      538           .
      539           if v-object-handle <> v-diasize-resize-button
      540           then do:
      541             assign
      542               v-object-handle :row = v-object-handle :row + p-change-value
      543               no-error .
      544             if error-status :error
      545             or error-status :get-message(1) <> ""
      546             then do:
      547               undo move_block, retry move_block .
      548             end.
      549           end.
      550         end.
      551         assign
      552           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      553           no-error .
      554         if error-status :error
      555         or error-status :get-message(1) <> ""
      556         then do:
      557           undo move_block, retry move_block .
      558         end.
      559         for each buf_temp-browse-handle
      560           where buf_temp-browse-handle.browse-type = 'height':u
      561         on error undo move_block, retry move_block
      562         :
      563           assign
      564             buf_temp-browse-handle.browse-handle :height
      565               = buf_temp-browse-handle.browse-handle :height + p-change-value
      566             no-error .
      567           if error-status :error
      568           or error-status :get-message(1) <> ""
      569           then do:
      570             undo move_block, retry move_block .
      571           end.
      572         end.
      573         assign
      574           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      575           no-error .
      576         if error-status :error
      577         or error-status :get-message(1) <> ""
      578         then do:
      579           undo move_block, retry move_block .
      580         end.
      581         if frame Dialog-Frame :scrollable = true
      582         then do:
      583           assign
      584             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      585             no-error .
      586           if error-status :error
      587           or error-status :get-message(1) <> ""
      588           then do:
      589             undo move_block, retry move_block .
      590           end.
      591         end.
      592       end.
      593       if p-move-resize = true
      594       then do:
      595         run diasize_position-resize-button in this-procedure .
      596       end.
      597       if v-diasize-wndstore = true
      598       then do:
      599         if connected("ub") = true
      600         then do:
      601           define variable v-cntxt-db-num        as integer   no-undo .
      602           define variable v-cntxt-userid        as character no-undo .
      603           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      604                                             , OUTPUT v-cntxt-userid
      605                                             ) .
      606           run gbl/wndsizew.p
      607             (input  v-cntxt-db-num
      608             ,input  v-cntxt-userid
      609             ,input  v-diasize-proc-name
      610             ,input  'height':u
      611             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      612             ) .
      613         end.
      614       end.
      615     end.
      616     assign
      617       v-diasize-change-size = false
      618     .
      619   end procedure.
      620   procedure diasize_set-height :
      621     define input  parameter p-new-height  as decimal   no-undo .
      622     define input  parameter p-move-resize as logical   no-undo .
      623     do
      624     on error undo, return error return-value
      625     :
      626       run diasize_change-height in this-procedure
      627         (input  (p-new-height - frame Dialog-Frame :height)
      628         ,input  p-move-resize
      629         ) .
      630     end.
      631   end procedure.
      632   procedure diasize_change-width :
      633     define input  parameter p-change-value as decimal   no-undo .
      634     define input  parameter p-move-resize  as logical   no-undo .
      635     define variable v-field-group-handle   as handle    no-undo .
      636     define variable v-object-handle        as handle    no-undo .
      637     define variable v-frame-width          as decimal   no-undo .
      638     define variable v-frame-virtual-width  as decimal   no-undo .
      639     define variable v-browse-width         as decimal   no-undo .
      640     define variable v-window-width         as decimal   no-undo .
      641     define variable v-window-virtual-width as decimal   no-undo .
      642     define variable v-change-sign          as integer   no-undo .
      643     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      644     define buffer buf_temp-browse-handle  for temp-browse-handle .
      645     if p-change-value > 0
      646     then do:
      647       if frame Dialog-Frame :width + p-change-value >
      648           session :width-chars
      649       then do:
      650         assign
      651           p-change-value = session :width-chars - frame Dialog-Frame :width
      652         .
      653         if p-change-value <= 0
      654         then do:
      655           run diasize_position-resize-button in this-procedure .
      656           return .
      657         end.
      658       end.
      659     end.
      660     if p-change-value < 0
      661     then do:
      662       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      663       then do:
      664         assign
      665           p-change-value = v-diasize-orig-frame-width
      666                          - frame Dialog-Frame :width
      667         .
      668         if p-change-value >= 0
      669         then do:
      670           run diasize_position-resize-button in this-procedure .
      671           return .
      672         end.
      673       end.
      674     end.
      675     if p-change-value >= 0
      676     then do:
      677       assign
      678         v-change-sign = 1
      679       .
      680     end.
      681     else do:
      682       assign
      683         v-change-sign = -1
      684       .
      685     end.
      686     assign
      687       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      688     .
      689     if p-change-value = 0
      690     then do:
      691       run diasize_position-resize-button in this-procedure .
      692       return .
      693     end.
      694     move_block:
      695     do
      696     on error undo move_block, leave move_block
      697     :
      698       if retry
      699       then do:
      700         do
      701         on error undo move_block, leave move_block
      702         :
      703           if p-change-value > 0
      704           then do:
      705             for each buf_temp-diasize-handle
      706             on error undo, next
      707             :
      708               assign
      709                 v-object-handle = buf_temp-diasize-handle.handle-value
      710               .
      711               if v-object-handle <> v-diasize-resize-button
      712               then do:
      713                 assign
      714                   v-object-handle :col = buf_temp-diasize-handle.save-position
      715                 .
      716               end.
      717             end.
      718             assign
      719               v-diasize-browse-handle :width = v-browse-width
      720             .
      721             for each buf_temp-browse-handle
      722               where buf_temp-browse-handle.browse-type = 'width':u
      723             on error undo, next
      724             :
      725               assign
      726                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      727               .
      728             end.
      729             assign
      730               frame Dialog-Frame :width = v-frame-width
      731             .
      732             if frame Dialog-Frame :scrollable = true
      733             then do:
      734               assign
      735                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      736               .
      737             end.
      738             run diasize_position-resize-button in this-procedure .
      739           end.
      740           else do:
      741             if frame Dialog-Frame :scrollable = true
      742             then do:
      743               assign
      744                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      745               .
      746             end.
      747             assign
      748               frame Dialog-Frame :width = v-frame-width
      749             .
      750             for each buf_temp-browse-handle
      751               where buf_temp-browse-handle.browse-type = 'width':u
      752             on error undo, next
      753             :
      754               assign
      755                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      756               .
      757             end.
      758             assign
      759               v-diasize-browse-handle :width = v-browse-width
      760             .
      761             for each buf_temp-diasize-handle
      762             on error undo, next
      763             :
      764               assign
      765                 v-object-handle = buf_temp-diasize-handle.handle-value
      766               .
      767               if v-object-handle <> v-diasize-resize-button
      768               then do:
      769                 assign
      770                   v-object-handle :col = buf_temp-diasize-handle.save-position
      771                 .
      772               end.
      773             end.
      774             run diasize_position-resize-button in this-procedure .
      775           end.
      776           assign
      777             v-diasize-change-size = false
      778           .
      779           leave move_block .
      780         end.
      781       end.
      782       assign
      783         v-diasize-need-full-display = true
      784       .
      785       if v-diasize-change-size = false
      786       then do:
      787         assign
      788           v-diasize-change-size = true
      789         .
      790       end.
      791       else do:
      792         return .
      793       end.
      794       assign
      795         v-frame-width = frame Dialog-Frame :width
      796         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      797         v-browse-width = v-diasize-browse-handle :width
      798       .
      799       for each buf_temp-browse-handle
      800         where buf_temp-browse-handle.browse-type = 'width':u
      801       :
      802         assign
      803           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      804         .
      805       end.
      806       for each buf_temp-diasize-handle
      807       :
      808         delete buf_temp-diasize-handle .
      809       end.
      810       assign
      811         v-field-group-handle = frame Dialog-Frame :first-child
      812       .
      813       do while valid-handle(v-field-group-handle)
      814       :
      815         assign
      816           v-object-handle = v-field-group-handle :first-child
      817         .
      818         do while valid-handle(v-object-handle)
      819         :
      820           if  v-object-handle <> v-diasize-browse-handle :handle
      821           and v-object-handle <> v-diasize-resize-button
      822           and can-query(v-object-handle, "row")
      823           and can-query(v-object-handle, "height")
      824           and ( v-object-handle :col + v-object-handle :width
      825                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      826               )
      827           then do:
      828             find first buf_temp-browse-handle
      829               where buf_temp-browse-handle.browse-type   = 'width':u
      830                 and buf_temp-browse-handle.browse-handle = v-object-handle
      831               no-error .
      832             if available buf_temp-browse-handle
      833             then do:
      834             end.
      835             else do:
      836               create buf_temp-diasize-handle .
      837               assign
      838                 buf_temp-diasize-handle.handle-value  = v-object-handle
      839                 buf_temp-diasize-handle.save-position = v-object-handle :col
      840               .
      841             end.
      842           end.
      843           assign
      844             v-object-handle = v-object-handle :next-sibling
      845           .
      846         end.
      847         assign
      848           v-field-group-handle = v-field-group-handle :next-sibling
      849         .
      850       end.
      851       do with frame Dialog-Frame
      852       :
      853         hide v-diasize-resize-button .
      854         v-diasize-resize-button :row = 1.
      855         v-diasize-resize-button :column = 1.
      856       end.
      857       if p-change-value > 0
      858       then do:
      859         if frame Dialog-Frame :scrollable = true
      860         then do:
      861           assign
      862             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      863             no-error .
      864           if error-status :error
      865           or error-status :get-message(1) <> ""
      866           then do:
      867             undo move_block, retry move_block.
      868           end.
      869         end.
      870         assign
      871           frame Dialog-Frame :width = v-frame-width + p-change-value
      872           no-error .
      873         if error-status :error
      874         or error-status :get-message(1) <> ""
      875         then do:
      876           undo move_block, retry move_block.
      877         end.
      878         assign
      879           v-diasize-browse-handle :width = v-browse-width + p-change-value
      880         no-error .
      881         if error-status :error
      882         or error-status :get-message(1) <> ""
      883         then do:
      884           undo move_block, retry move_block.
      885         end.
      886         for each buf_temp-browse-handle
      887           where buf_temp-browse-handle.browse-type = 'width':u
      888         on error undo move_block, retry move_block
      889         :
      890           assign
      891             buf_temp-browse-handle.browse-handle :width
      892               = buf_temp-browse-handle.browse-handle :width + p-change-value
      893             no-error .
      894           if error-status :error
      895           or error-status :get-message(1) <> ""
      896           then do:
      897             undo move_block, retry move_block .
      898           end.
      899         end.
      900         for each buf_temp-diasize-handle
      901         on error undo move_block, retry move_block
      902         :
      903           assign
      904             v-object-handle = buf_temp-diasize-handle.handle-value
      905           .
      906           if v-object-handle <> v-diasize-resize-button
      907           then do:
      908             assign
      909               v-object-handle :col = v-object-handle :col + p-change-value
      910               no-error .
      911             if error-status :error
      912             or error-status :get-message(1) <> ""
      913             then do:
      914               undo move_block, retry move_block .
      915             end.
      916           end.
      917         end.
      918       end.
      919       else do:
      920         for each buf_temp-diasize-handle
      921         on error undo move_block, retry move_block
      922         :
      923           assign
      924             v-object-handle = buf_temp-diasize-handle.handle-value
      925           .
      926           if v-object-handle <> v-diasize-resize-button
      927           then do:
      928             assign
      929               v-object-handle :col = v-object-handle :col + p-change-value
      930               no-error .
      931             if error-status :error
      932             or error-status :get-message(1) <> ""
      933             then do:
      934               undo move_block, retry move_block .
      935             end.
      936           end.
      937         end.
      938         for each buf_temp-browse-handle
      939           where buf_temp-browse-handle.browse-type = 'width':u
      940         on error undo move_block, retry move_block
      941         :
      942           assign
      943             buf_temp-browse-handle.browse-handle :width
      944               = buf_temp-browse-handle.browse-handle :width + p-change-value
      945             no-error .
      946           if error-status :error
      947           or error-status :get-message(1) <> ""
      948           then do:
      949             undo move_block, retry move_block .
      950           end.
      951         end.
      952         assign
      953           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
      954           no-error .
      955         if error-status :error
      956         or error-status :get-message(1) <> ""
      957         then do:
      958           undo move_block, retry move_block.
      959         end.
      960         assign
      961           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
      962         no-error .
      963         if error-status :error
      964         or error-status :get-message(1) <> ""
      965         then do:
      966           undo move_block, retry move_block.
      967         end.
      968         if frame Dialog-Frame :scrollable = true
      969         then do:
      970           assign
      971             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      972           no-error .
      973           if error-status :error
      974           or error-status :get-message(1) <> ""
      975           then do:
      976             undo move_block, retry move_block.
      977           end.
      978         end.
      979       end.
      980       if p-move-resize
      981       then do:
      982         run diasize_position-resize-button in this-procedure .
      983       end.
      984       if v-diasize-wndstore = true
      985       then do:
      986         if connected("ub") = true
      987         then do:
      988           define variable v-cntxt-db-num        as integer   no-undo .
      989           define variable v-cntxt-userid        as character no-undo .
      990           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      991                                             , OUTPUT v-cntxt-userid
      992                                             ) .
      993           run gbl/wndsizew.p
      994             (input  v-cntxt-db-num
      995             ,input  v-cntxt-userid
      996             ,input  v-diasize-proc-name
      997             ,input  'width':u
      998             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
      999             ) .
     1000         end.
     1001       end.
     1002     end.
     1003     assign
     1004       v-diasize-change-size = false
     1005     .
     1006   end procedure.
     1007   procedure diasize_set-width :
     1008     define input  parameter p-new-width  as decimal   no-undo .
     1009     define input  parameter p-move-resize as logical   no-undo .
     1010     do
     1011     on error undo, return error return-value
     1012     :
     1013       run diasize_change-width in this-procedure
     1014         (input  (p-new-width - frame Dialog-Frame :width)
     1015         ,input  p-move-resize
     1016         ) .
     1017     end.
     1018   end procedure.
     1019   procedure diasize_position-resize-button :
     1020     do with frame Dialog-Frame
     1021     :
     1022       hide v-diasize-resize-button .
     1023       assign
     1024         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1025                     - 1
     1026                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1027         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1028                     - 1
     1029                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1030       .
     1031       view v-diasize-resize-button .
     1032     end.
     1033   end procedure.
     1034   on alt-right anywhere
     1035   do:
     1036     run diasize_change-width in this-procedure
     1037       (input 1
     1038       ,input true
     1039       ) .
     1040     return no-apply .
     1041   end.
     1042   on alt-left anywhere
     1043   do:
     1044     run diasize_change-width in this-procedure
     1045       (input -1
     1046       ,input true
     1047       ) .
     1048     return no-apply .
     1049   end.
     1050   on alt-down anywhere
     1051   do:
     1052     run diasize_change-height in this-procedure
     1053       (input 1
     1054       ,input true
     1055       ) .
     1056     return no-apply .
     1057   end.
     1058   on alt-up anywhere
     1059   do:
     1060     run diasize_change-height in this-procedure
     1061       (input -1
     1062       ,input true
     1063       ) .
     1064     return no-apply .
     1065   end.
     1066   on alt-enter of frame Dialog-Frame
     1067   do:
     1068     run diasize_maximize in this-procedure
     1069       (input  ?
     1070       ).
     1071     return no-apply .
     1072   end.
     1073   procedure diasize_end-move :
     1074     do
     1075     on error undo, return error return-value
     1076     :
     1077       define variable v-row-delta as decimal   no-undo .
     1078       define variable v-col-delta as decimal   no-undo .
     1079       define variable v-new-row as decimal   no-undo .
     1080       define variable v-new-col as decimal   no-undo .
     1081       assign
     1082         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1083         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1084       .
     1085       assign
     1086         v-row-delta = v-new-row - frame Dialog-Frame :height
     1087         v-col-delta = v-new-col - frame Dialog-Frame :width
     1088       .
     1089       run diasize_change-height in this-procedure
     1090         (input v-row-delta
     1091         ,input true
     1092         ) .
     1093       run diasize_change-width in this-procedure
     1094         (input v-col-delta
     1095         ,input true
     1096         ) .
     1097     end.
     1098   end procedure.
     1099   procedure diasize_maximize :
     1100     define input  parameter p-action as logical   no-undo .
     1101     do
     1102     on error undo, return error return-value
     1103     :
     1104       if p-action = ?
     1105       then do:
     1106         if v-diasize-need-maximize = true
     1107         then do:
     1108           assign
     1109             p-action = true
     1110           .
     1111         end.
     1112         else do:
     1113           assign
     1114             p-action = false
     1115           .
     1116         end.
     1117       end.
     1118       if p-action = true
     1119       then do:
     1120         run diasize_change-height in this-procedure
     1121           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1122               - frame Dialog-Frame :height-chars
     1123           ,input true
     1124           ) .
     1125         run diasize_change-width in this-procedure
     1126           (input session :width-chars
     1127               - frame Dialog-Frame :width-chars
     1128           ,input true
     1129           ) .
     1130         assign
     1131           v-diasize-need-maximize = false
     1132         .
     1133       end.
     1134       else do:
     1135         run diasize_change-width in this-procedure
     1136           (input v-diasize-orig-frame-width
     1137               - frame Dialog-Frame :width-chars
     1138           ,input true
     1139           ) .
     1140         run diasize_change-height in this-procedure
     1141           (input v-diasize-orig-frame-height
     1142               - frame Dialog-Frame :height-chars
     1143           ,input true
     1144           ) .
     1145         assign
     1146           v-diasize-need-maximize = true
     1147         .
     1148       end.
     1149     end.
     1150   end procedure.
     1151   procedure diasize_restore-orig-size :
     1152     do
     1153     on error undo, return error return-value
     1154     :
     1155       assign
     1156         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1157         v-diasize-current-frame-height = frame Dialog-Frame :height
     1158       .
     1159       run diasize_set-height in this-procedure
     1160         (input  v-diasize-orig-frame-height
     1161         ,input  true
     1162         ) .
     1163       run diasize_set-width in this-procedure
     1164         (input  v-diasize-orig-frame-width
     1165         ,input  true
     1166         ) .
     1167     end.
     1168   end procedure.
     1169   procedure diasize_restore-current-size :
     1170     do
     1171     on error undo, return error return-value
     1172     :
     1173       run diasize_set-height in this-procedure
     1174         (input  v-diasize-current-frame-height
     1175         ,input  true
     1176         ) .
     1177       run diasize_set-width in this-procedure
     1178         (input  v-diasize-current-frame-width
     1179         ,input  true
     1180         ) .
     1181     end.
     1182   end procedure.
     1183   procedure diasize_set-browse-handle :
     1184     define input  parameter p-browse-handle as handle   no-undo .
     1185     define buffer buf_temp-browse-handle for temp-browse-handle .
     1186     do
     1187     on error undo, return error return-value
     1188     :
     1189       assign
     1190         v-diasize-browse-handle = p-browse-handle
     1191       .
     1192       for each buf_temp-browse-handle
     1193       on error undo, return error return-value
     1194       :
     1195         delete buf_temp-browse-handle .
     1196       end.
     1197     end.
     1198   end procedure.
     1199   procedure diasize_add_browse :
     1200     define input  parameter p-browse-type   as character no-undo .
     1201     define input  parameter p-browse-handle as handle    no-undo .
     1202     define buffer buf_temp-browse-handle for temp-browse-handle .
     1203     do
     1204     on error undo, return error return-value
     1205     :
     1206       assign
     1207         v-diasize-browse-number = v-diasize-browse-number + 1
     1208       .
     1209       create buf_temp-browse-handle .
     1210       assign
     1211         buf_temp-browse-handle.browse-type   = p-browse-type
     1212         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1213         buf_temp-browse-handle.browse-handle = p-browse-handle
     1214       .
     1215     end.
     1216   end procedure.
     1217   procedure diasize_init :
     1218     define variable v-default-value    as logical   no-undo .
     1219     define variable v-restore-saved    as logical   no-undo .
     1220     define variable v-resize-value-str as character no-undo .
     1221     do
     1222     on error undo, return error return-value
     1223     :
     1224       do with frame Dialog-Frame
     1225       :
     1226         assign
     1227           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1228           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1229           v-diasize-browse-handle     = browse b-shst :handle
     1230         .
     1231         create button v-diasize-resize-button
     1232         assign
     1233           parent        = frame Dialog-Frame :first-child
     1234           label         = "s"
     1235           height-pixels = 16
     1236           width-pixels  = 16
     1237           visible       = true
     1238           sensitive     = true
     1239           movable       = true
     1240           triggers:
     1241             on end-move persistent run diasize_end-move in this-procedure .
     1242           end triggers.
     1243         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1244         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1245         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1246         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1247         assign
     1248           v-diasize-wndmax = false
     1249         .
     1250         if connected("ub") = true
     1251         then do:
     1252           define variable v-cntxt-db-num        as integer   no-undo .
     1253           define variable v-cntxt-userid        as character no-undo .
     1254           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1255                                             , OUTPUT v-cntxt-userid
     1256                                             ) .
     1257           run gbl/wndpar_r.p
     1258             (input  v-cntxt-db-num
     1259             ,input  v-cntxt-userid
     1260             ,input  'wndmax':U
     1261             ,output v-diasize-wndmax
     1262             ,output v-default-value
     1263             ) .
     1264         end.
     1265         assign
     1266           v-diasize-wndstore = false
     1267         .
     1268         if connected("ub") = true
     1269         then do:
     1270           run gbl/wndpar_r.p
     1271             (input  v-cntxt-db-num
     1272             ,input  v-cntxt-userid
     1273             ,input  'wndstore':U
     1274             ,output v-diasize-wndstore
     1275             ,output v-default-value
     1276             ) .
     1277         end.
     1278         assign
     1279           v-diasize-proc-name = entry(1, program-name(2), '.')
     1280         .
     1281         if v-diasize-wndstore = true
     1282         then do:
     1283           assign
     1284             v-restore-saved = false
     1285           .
     1286           if connected("ub") = true
     1287           then do:
     1288             run gbl/wndsizer.p
     1289               (input  v-cntxt-db-num
     1290               ,input  v-cntxt-userid
     1291               ,input  v-diasize-proc-name
     1292               ,input  'height':u
     1293               ,output v-resize-value-str
     1294               ) .
     1295             if v-resize-value-str <> '':U
     1296             then do:
     1297               run diasize_change-height in this-procedure
     1298                 (input  integer(v-resize-value-str)
     1299                 ,input  true
     1300                 ) .
     1301               assign
     1302                 v-restore-saved = true
     1303               .
     1304             end.
     1305           end.
     1306           if connected("ub") = true
     1307           then do:
     1308             run gbl/wndsizer.p
     1309               (input  v-cntxt-db-num
     1310               ,input  v-cntxt-userid
     1311               ,input  v-diasize-proc-name
     1312               ,input  'width':u
     1313               ,output v-resize-value-str
     1314               ) .
     1315             if v-resize-value-str <> '':U
     1316             then do:
     1317               run diasize_change-width in this-procedure
     1318                 (input  integer(v-resize-value-str)
     1319                 ,input  true
     1320                 ) .
     1321               assign
     1322                 v-restore-saved = true
     1323               .
     1324             end.
     1325           end.
     1326           if v-restore-saved <> true
     1327           then do:
     1328             if v-diasize-wndmax = true
     1329             then do:
     1330               run diasize_maximize in this-procedure
     1331                 (input  true
     1332                 ) .
     1333             end.
     1334           end.
     1335         end.
     1336         else do:
     1337           if v-diasize-wndmax = true
     1338           then do:
     1339             run diasize_maximize in this-procedure
     1340               (input  true
     1341               ) .
     1342           end.
     1343         end.
     1344       end.
     1345     end.
     1346   end procedure.
     1347   procedure diasize_need-full-display :
     1348     define output parameter p-need-full-display as logical   no-undo .
     1349     do
     1350     on error undo, return error return-value
     1351     :
     1352       assign
     1353         p-need-full-display = v-diasize-need-full-display
     1354       .
     1355       assign
     1356         v-diasize-need-full-display = false
     1357       .
     1358     end.
     1359   end procedure.
     1360   procedure get-context :
     1361      define output parameter p-db-num as integer          no-undo.
     1362      define output parameter p-user-id as character        no-undo.
     1363      define variable v-login               as character    no-undo.
     1364      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1365      define buffer buf_user-login  for ub.user-login .
     1366      do
     1367      on error undo, return error
     1368      :
     1369            FIND FIRST buf_sys-ctrl no-lock.
     1370            ASSIGN
     1371               v-login = USERID("ub")
     1372               p-db-num = buf_sys-ctrl.db-num
     1373            .
     1374            FIND FIRST buf_user-login
     1375                 WHERE buf_user-login.db-num = p-db-num
     1376                   AND buf_user-login.user-login = v-login
     1377                 no-lock
     1378                 no-error
     1379                 .
     1380            IF AVAILABLE buf_user-login
     1381            THEN DO:
     1382               assign
     1383                  p-user-id = buf_user-login.user-id
     1384               .
     1385            END.
     1386      end.
     1387   end procedure.
     1388       run diasize_init in this-procedure .
     1389   MAIN-BLOCK:
     1390   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1391      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1392     run load-tt.
     1393     RUN enable_UI.
     1394     find first bf_tt-shst where bf_tt-shst.obj-type = pardefobj-type and
     1395                                 bf_tt-shst.obj-code = pardefobj-code no-error.
     1396     if available bf_tt-shst then do:
     1397       reposition b-shst to recid recid(bf_tt-shst).
     1398     end.
     1399     WAIT-FOR GO OF FRAME Dialog-Frame.
     1400   END.
     1401   RUN disable_UI.
     1402   PROCEDURE disable_UI :
     1403     HIDE FRAME Dialog-Frame.
     1404   END PROCEDURE.
     1405   PROCEDURE enable_UI :
     1406     ENABLE b-chs b-cancel b-help b-shst
     1407         WITH FRAME Dialog-Frame.
     1408     VIEW FRAME Dialog-Frame.
     1409     OPEN QUERY b-shst FOR EACH tt-shst indexed-reposition.
     1410   END PROCEDURE.
     1411   PROCEDURE load-tt :
     1412   if parhost-code = ? then do:
     1413    for each shop no-lock,
     1414      first clients where clients.obj-type = 'маг':U       and
     1415                          clients.obj-code = shop.obj-code and
     1416                          clients.stts     = 0
     1417                          no-lock on error undo, return error return-value :
     1418      create tt-shst.
     1419      assign
     1420        tt-shst.obj-type = 'маг':U
     1421        tt-shst.obj-code =  shop.obj-code
     1422        tt-shst.obj-name = clients.obj-name.
     1423    end.
     1424    for each store no-lock,
     1425      first clients where clients.obj-type = 'скл':U       and
     1426                          clients.obj-code = store.obj-code and
     1427                          clients.stts     = 0              no-lock on error undo, return error return-value :
     1428      create tt-shst.
     1429      assign
     1430        tt-shst.obj-type = 'скл':U
     1431        tt-shst.obj-code =  store.obj-code
     1432        tt-shst.obj-name = clients.obj-name.
     1433    end.
     1434   end.
     1435   else do:
     1436    for each shop where shop.host-code = parhost-code no-lock,
     1437      first clients where clients.obj-type = 'маг':U       and
     1438                          clients.obj-code = shop.obj-code and
     1439                          clients.stts     = 0             no-lock on error undo, return error return-value :
     1440      create tt-shst.
     1441      assign
     1442        tt-shst.obj-type = 'маг':U
     1443        tt-shst.obj-code =  shop.obj-code
     1444        tt-shst.obj-name = clients.obj-name.
     1445    end.
     1446    for each store where store.host-code = parhost-code no-lock,
     1447      first clients where clients.obj-type = 'скл':U       and
     1448                          clients.obj-code = store.obj-code and
     1449                          clients.stts     = 0              no-lock on error undo, return error return-value :
     1450      create tt-shst.
     1451      assign
     1452        tt-shst.obj-type = 'скл':U
     1453        tt-shst.obj-code = store.obj-code
     1454        tt-shst.obj-name = clients.obj-name.
     1455    end.
     1456   end.
     1457   END PROCEDURE.
