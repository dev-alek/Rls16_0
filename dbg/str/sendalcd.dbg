        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: sendalcd.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/sendalcd.p $":U .
       11   define variable vss-description as character no-undo init "Отправка на кассу изменений товаров или клиентов, накопленных в результате работы со справочниками".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable p-gds as logical no-undo .
       82   define variable p-dcard as logical no-undo .
       83   define variable p-seller as logical no-undo .
       84   define variable p-cashier as logical no-undo .
       85   define variable p-fgrp as logical no-undo .
       86   define variable v-view-log as logical no-undo .
       87   define variable log-file-name as character no-undo init "send-cd.txt".
       88   define variable v-stop as logical no-undo .
       89   define buffer buf_BatchProcess for ub.batchProcess .
       90   assign
       91   p-gds = (if entry(1, p-parameter, chr(4)) = "yes"
       92           then yes
       93           else (if entry(1, p-parameter, chr(4)) = "no"
       94                 then no
       95                 else ?)
       96           )
       97   p-dcard = (if entry(2, p-parameter, chr(4)) = "yes"
       98           then yes
       99           else (if entry(2, p-parameter, chr(4)) = "no"
      100                 then no
      101                 else ?)
      102           )
      103   p-seller = (if entry(3, p-parameter, chr(4)) = "yes"
      104           then yes
      105           else (if entry(3, p-parameter, chr(4)) = "no"
      106                 then no
      107                 else ?)
      108           )
      109   p-cashier = (if entry(4, p-parameter, chr(4)) = "yes"
      110           then yes
      111           else (if entry(4, p-parameter, chr(4)) = "no"
      112                 then no
      113                 else ?)
      114           )
      115   p-fgrp   = (if entry(5, p-parameter, chr(4)) = "yes"
      116           then yes
      117           else (if entry(5, p-parameter, chr(4)) = "no"
      118                 then no
      119                 else ?)
      120           )
      121   no-error
      122   .
      123   if error-status:error
      124   or p-gds = ?
      125   or p-dcard = ?
      126   or p-seller = ?
      127   or p-cashier = ?
      128   then return error.
      129   run write-log-and-file in p-log-handle (
      130         input 1
      131       , input log-file-name
      132       , input 1
      133       , input substitute( "Пересылка на кассы БД &1 изменений, сделанных в справочнике", g#db-num )
      134                                         ).
      135   if p-gds and  can-find (first  buf_BatchProcess no-lock
      136         where buf_BatchProcess.bp_type       = 'gds':U
      137           and buf_BatchProcess.bp_status     = 'N':U
      138                  ) then do:
      139       run set-title in p-log-handle (
      140             input "Отправка товаров на кассу"
      141                                      ).
      142     run trg/bt_gds.p (
      143                   parparentproc
      144                  , input p-log-handle
      145                  ,no) no-error .
      146     if error-status:error or
      147     return-value = "yes":U then do:
      148       run set-view-log in p-log-handle(yes).
      149     end.
      150   end.
      151   run set-counter-value in p-log-handle ( input '':U ).
      152   run hide-counter in p-log-handle.
      153   run get-stop-state in p-log-handle (output v-stop).
      154   if p-dcard
      155   and not  v-stop
      156   and can-find (first  buf_BatchProcess no-lock
      157         where buf_BatchProcess.bp_type       = 'dcard':U
      158           and buf_BatchProcess.bp_status     = 'N':U
      159                  ) then do:
      160       run set-title in p-log-handle (
      161             input 'Отправка информации по клиентским картам на кассу'
      162                                       ).
      163     run trg/bt_dcard.p (
      164                      input parparentproc
      165                    , input p-log-handle
      166                    , input no) no-error .
      167     if error-status:error or
      168     return-value = "yes":U then do:
      169       run set-view-log in p-log-handle(yes).
      170     end.
      171   end.
      172   run set-counter-value in p-log-handle ( input '':U ).
      173   run hide-counter in p-log-handle.
      174   if p-seller
      175   and not  v-stop
      176   and can-find (first  buf_BatchProcess no-lock
      177         where buf_BatchProcess.bp_type       = 'slr':U
      178           and buf_BatchProcess.bp_status     = 'N':U
      179                  ) then do:
      180       run set-title in p-log-handle (
      181             input 'Отправка информации по продавцам на кассу'
      182                                       ).
      183     run trg/bt_slr.p (
      184                    input parparentproc
      185                   ,input p-log-handle
      186                   ,input string(no)
      187                   ) no-error .
      188     if error-status:error or
      189     return-value = "yes":U then do:
      190       run set-view-log in p-log-handle(yes).
      191     end.
      192   end.
      193   run set-counter-value in p-log-handle ( input '':U ).
      194   run hide-counter in p-log-handle.
      195   if p-cashier
      196   and not  v-stop
      197   and can-find (first  buf_BatchProcess no-lock
      198         where buf_BatchProcess.bp_type       = 'cshr':U
      199           and buf_BatchProcess.bp_status     = 'N':U
      200                  ) then do:
      201       run set-title in p-log-handle (
      202             input 'Отправка информации по кассирам на кассу'
      203                                       ).
      204     run trg/bt_cshr.p ( input parparentproc
      205                   ,input p-log-handle
      206                   ,input string(no)
      207                   ) no-error .
      208     if error-status:error or
      209     return-value = "yes":U then do:
      210       run set-view-log in p-log-handle(yes).
      211     end.
      212   end.
      213   run set-counter-value in p-log-handle ( input '':U ).
      214   run hide-counter in p-log-handle.
      215   if p-fgrp
      216   and not  v-stop
      217   and can-find (first  buf_BatchProcess no-lock
      218         where buf_BatchProcess.bp_type       = 'fgrp':U
      219           and buf_BatchProcess.bp_status     = 'N':U
      220                  ) then do:
      221       run set-title in p-log-handle (
      222             input 'Отправка информации по группам блюд на кассу'
      223                                       ).
      224     run trg/bt_fgrp.p ( input parparentproc
      225                   ,input p-log-handle
      226                   ,input string(no)
      227                   ) no-error .
      228     if error-status:error or
      229     return-value = "yes":U then do:
      230       run set-view-log in p-log-handle(yes).
      231     end.
      232   end.
      233   run set-counter-value in p-log-handle ( input '':U ).
      234   run hide-counter in p-log-handle.
      235    run get-view-log in p-log-handle(output v-view-log).
      236   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   if v-view-log
      238   and not g#news
      239   and not g#auto
      240   then do:
      241     message
      242     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
      243     "!!!Внимательно прочитайте Log-file!!"
      244     view-as alert-box error .
      245        define variable v-user-action1   as character no-undo .
      246     define variable v-printed1       as logical   no-undo .
      247     run gbl/prnfilen.w
      248       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
      249       ,input  0
      250       ,input  (string("./":U) + 'send-cd.txt')
      251       ,input  7
      252       ,output v-user-action1
      253       ,output v-printed1
      254       ) .
      255   end.
      256   if v-view-log = true
      257   and (g#news
      258   or g#auto)
      259   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      260   then do:
      261      run cb_set-view-log in p-parent-handle ( input yes).
      262   end.
      263   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      264     OS-DELETE value(string("./":U) + 'send-cd.txt').
      265   end.
