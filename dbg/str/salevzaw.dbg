      427   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   define variable c-point  as character no-undo .
      429   define variable tbl      as character no-undo .
      430   define variable join-tbl as character no-undo .
