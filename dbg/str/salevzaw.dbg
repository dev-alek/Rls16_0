     1891   procedure diasize_set-height :
     1892     define input  parameter p-new-height  as decimal   no-undo .
     1893     define input  parameter p-move-resize as logical   no-undo .
     1894     do
     1895     on error undo, return error return-value
     1896     :
     1897       run diasize_change-height in this-procedure
     1898         (input  (p-new-height - frame Dialog-Frame :height)
     1899         ,input  p-move-resize
     1900         ) .
     1901     end.
     1902   end procedure.
     1903   procedure diasize_change-width :
     1904     define input  parameter p-change-value as decimal   no-undo .
     1905     define input  parameter p-move-resize  as logical   no-undo .
     1906     define variable v-field-group-handle   as handle    no-undo .
     1907     define variable v-object-handle        as handle    no-undo .
