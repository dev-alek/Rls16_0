     3820   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3821   define variable  l-disable-where-29  as logical   no-undo .
     3822   define variable  l-filter-open-29    as logical   .
     3823   define variable  flt-rec-29       as recid     no-undo .
     3824   define variable  filter-name-29      as character no-undo .
     3825   define variable  where-phrase-29     as character no-undo .
     3826   define variable  sort-phrase-29      as character no-undo .
     3827   define variable  where-phrase-rus-29 as character no-undo .
     3828   define variable  sort-phrase-rus-29  as character no-undo .
     3829     run waitfram-show in this-procedure
     3830       (input "ЖДИТЕ ..."
     3831       ).
     3832   run gbl/flt-get.p
     3833     (input filter-point
     3834     ,output flt-rec-29
     3835     ,output filter-name-29
     3836     ,output where-phrase-29
     3837     ,output sort-phrase-29
     3838     ,output where-phrase-rus-29
     3839     ,output sort-phrase-rus-29
     3840     ).
     3841   if p-open-query then do:
     3842       run set-filter-name in this-procedure
     3843         (INPUT filter-name-29
     3844         ) no-error .
     3845     assign
     3846       l-filter-open-29 = false
     3847     .
     3848     if flt-rec-29 <> ?
     3849       or sort-column-phrase > ""
     3850     then do:
     3851       define variable  parameter-2-29 as character no-undo .
     3852       define variable  parameter-3-29 as character no-undo .
     3853       define variable  parameter-4-29 as character no-undo .
     3854       define variable  parameter-5-29 as character no-undo .
     3855       define variable  parameter-6-29 as character no-undo .
     3856       define variable  parameter-7-29 as character no-undo .
     3857         assign
     3858         parameter-3-29 =
     3859                                 "FOR EACH X_sj-print"
     3860         parameter-4-29 =
     3861           (
     3862             if (" X_sj-print.is-out  = rs-r-v AND                             (rs-vzak = 0 or X_sj-print.var-purch = rs-vzak) AND                             X_sj-print.is-cash = rs-cash " + " " + where-phrase-29) <> ""
     3863             then  substitute('X_sj-print.is-out  = &1 AND                             (&2 = 0 or X_sj-print.var-purch = &2) AND                             X_sj-print.is-cash = &3 ', rs-r-v, rs-vzak, rs-cash) + " " + where-phrase-29
     3864             else "true"
     3865           )
     3866         parameter-5-29 = (" " + "" + " " + "")
     3867         parameter-6-29 = if sort-phrase-29 = ''
     3868                              then
     3869           (
     3870           " " + "  " +
     3871             " " + sort-column-phrase +
     3872           " " + "  "
     3873           )
     3874                              else
     3875           (
     3876           " " + "  " +
     3877             " " + sort-column-phrase +
     3878           " " + sort-phrase-29
     3879           )
     3880         parameter-7-29 =
     3881           " indexed-reposition  "
     3882       .
     3883       do
     3884       on stop undo, leave
     3885       on error undo, leave
     3886       :
     3887         assign
     3888           l-disable-where-29 =
     3889             (" X_sj-print.is-out  = rs-r-v AND                             (rs-vzak = 0 or X_sj-print.var-purch = rs-vzak) AND                             X_sj-print.is-cash = rs-cash " + " " + where-phrase-29 = "")
     3890         .
     3891         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3892                             ,input QUERY br-sj:handle
     3893                             ,input parameter-3-29
     3894                             ,input parameter-4-29
     3895                             ,input parameter-5-29
     3896                             ,input parameter-6-29
     3897                             ,input parameter-7-29
     3898                             )
     3899         .
     3900         assign
     3901           l-filter-open-29 = true
     3902         .
     3903       end.
     3904       if l-filter-open-29 = false then do:
     3905         message
     3906           "Ошибка при фильтрации / сортировке" skip
     3907           "Будут показаны записи без учета фильтра" skip
     3908           view-as alert-box .
     3909       end.
     3910       else do:
     3911           assign
     3912             l-query-was-opened = true
     3913           .
     3914       end.
     3915     end.
     3916     if l-filter-open-29 = false then do:
     3917       OPEN QUERY br-sj FOR EACH X_sj-print
     3918         where  X_sj-print.is-out  = rs-r-v AND                             (rs-vzak = 0 or X_sj-print.var-purch = rs-vzak) AND                             X_sj-print.is-cash = rs-cash
     3919         indexed-reposition
     3920     .
     3921         assign
     3922           l-query-was-opened = true
     3923         .
     3924     end.
     3925   end.
     3926   else do:
     3927     assign
     3928       v-doc-rec = recid( X_sj-print )
     3929     .
     3930     do
     3931     on stop undo, leave
     3932     on error undo, leave
     3933     :
     3934       if QUERY br-sj:handle:get-buffer-handle(1) = (buffer X_sj-print:handle) then do:
     3935         assign
     3936         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3937         parameter-4-29 =
     3938           "where ":u +  substitute('X_sj-print.is-out  = &1 AND                             (&2 = 0 or X_sj-print.var-purch = &2) AND                             X_sj-print.is-cash = &3 ', rs-r-v, rs-vzak, rs-cash) + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3939         parameter-5-29 = "  "
     3940       .
     3941         run fltopend_fltfindd in this-procedure  (
     3942                             input this-procedure:handle
     3943                             ,input QUERY br-sj:handle
     3944                             ,input rowid(X_sj-print)
     3945                             ,input logical(parameter-2-29)
     3946                             ,input no-lock
     3947                             ,input (buffer X_sj-print:handle)
     3948                             ,input parameter-4-29
     3949                             ,input parameter-5-29
     3950                             ) no-error.
     3951         .
     3952         assign
     3953           v-doc-rec = integer(return-value)
     3954           v-fltopend-rowid[1] = ?
     3955         .
     3956       end.
     3957       else do:
     3958         assign
     3959         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3960         parameter-3-29 =  "FOR EACH X_sj-print"
     3961         parameter-4-29 =
     3962           (
     3963             if (" X_sj-print.is-out  = rs-r-v AND                             (rs-vzak = 0 or X_sj-print.var-purch = rs-vzak) AND                             X_sj-print.is-cash = rs-cash " + " " + where-phrase-29) <> ""
     3964             then  substitute('X_sj-print.is-out  = &1 AND                             (&2 = 0 or X_sj-print.var-purch = &2) AND                             X_sj-print.is-cash = &3 ', rs-r-v, rs-vzak, rs-cash) + " " + where-phrase-29
     3965             else "true"
     3966           )
     3967         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3968         parameter-6-29 = if sort-phrase-29 = ''
     3969                              then
     3970           (
     3971           " " + "  " +
     3972             " " + sort-column-phrase +
     3973           " " + "  "
     3974           )
     3975                              else
     3976           (
     3977           " " + "  " +
     3978             " " + sort-column-phrase +
     3979           " " + sort-phrase-29
     3980           )
     3981         parameter-7-29 =
     3982           " indexed-reposition  "
     3983       .
     3984         run fltopend_fltfindq in this-procedure  (
     3985                             input this-procedure:handle
     3986                             ,input QUERY br-sj:handle
     3987                             ,input logical(parameter-2-29)
     3988                             ,input no-lock
     3989                             ,input parameter-3-29
     3990                             ,input parameter-4-29
     3991                             ,input parameter-5-29
     3992                             ,input parameter-6-29
     3993                             ,input parameter-7-29
     3994                             ,output v-fltopend-rowid
     3995                             ) no-error.
     3996         .
     3997         v-doc-rec = ?.
     3998       end.
     3999       assign
     4000         l-query-was-opened = true
     4001       .
     4002     end.
     4003   end.
     4004     run waitfram-hide in this-procedure .
     4005           end.
     4006         end case.
     4007       end.
     4008     end case.
     4009   if not p-open-query and v-doc-rec <> ? then
     4010   REPOSITION br-sj to recid v-doc-rec No-ERROR.
     4011   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4012   query br-sj:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4013   run waitfram-hide in this-procedure .
     4014   APPLY "VALUE-CHANGED" TO br-sj in frame Dialog-Frame.
     4015   APPLY "ENTRY" TO br-sj.
     4016   END PROCEDURE.
     4017   PROCEDURE proc-b-print :
     4018   define variable v-r-b-abbr as character no-undo .
     4019   define variable date_string as character no-undo.
     4020   define variable v-header-base-curr as character no-undo .
     4021   DEFINE VARIABLE Line                as character                    no-undo .
     4022   DEFINE VARIABLE var-sale-sum AS DECIMAL NO-UNDO.
     4023   DEFINE VARIABLE var-qnty AS DECIMAL NO-UNDO.
     4024   DEFINE FRAME Purch-frame
     4025   X_sj-print.gds-code     column-label "Код товара"
     4026   X_sj-print.gds-name     column-label "Название товара" format "X(30)"
     4027   X_sj-print.var-purch    column-label "Вар!закуп"   format "9"
     4028   X_sj-print.price-sale   column-label "Цена нетто"
     4029   X_sj-print.price-flag   column-label "При-!веден"            format "+/"
     4030   X_sj-print.is-cash      column-label "Нал"                format "+/"
     4031   X_sj-print.qnty         column-label "Количество"
     4032   X_sj-print.sale-sum     column-label "Сумма нетто"
     4033   X_sj-print.artic        column-label "Артикул"
     4034   X_sj-print.prod-name    column-label "Производитель"   format "X(30)"
     4035   v-supp                column-label "Поставщик"       format "X(12)"
     4036   v-supp-name           column-label "Поставщик-название" format "X(30)"
     4037   HEADER  date_string AT 5 format "X(35)"
     4038   v-header-base-curr        format "X(20)" AT 42
     4039   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4040   Line format "X(177)" AT 1
     4041   with width 232 down stream-io use-text    .
     4042   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4043   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
     4044     (input  buf_inkas.host-code
     4045     ,output v-r-b-abbr
     4046     )  .
     4047     date_string = cur-time-print() .
     4048     if v-curr-r-b = 'base':U then do:
     4049       assign
     4050       v-header-base-curr = string( "( Б.Вал. - " + caps( v-r-b-abbr ) + " )" )
     4051       .
     4052     end.
     4053     run prn-lib-open-stream  in this-procedure (
     4054                                                 input parParentProc
     4055                                                 ,input 43
     4056                                                 ,input yes
     4057                                                 ,input no
     4058                                                 ).
     4059     PUT  STREAM PrnLibStream
     4060     SPACE(25) ( substitute("Отчет по зарезервированным партиям продажи &1 по вариантам закупки", buf_inkas.inkas-code) )
     4061     format "x(90)" SKIP(2) .
     4062     PUT  STREAM PrnLibStream unformatted
     4063     SPACE(25) (IF rs-r-v  THEN "РАСХОД" ELSE (IF rs-r-v =  no THEN "ВОЗВРАТ" ELSE "РАСХОД+ВОЗВРАТ"))
     4064     SPACE(25) (IF rs-vzak = 1 THEN "Вариант закупки 1" ELSE (IF rs-vzak = 1 THEN "Вариант закупки 2" ELSE "Все варианты закупки")) SKIP(0)
     4065     SPACE(25) (IF rs-cash THEN "НАЛИЧНЫЕ" ELSE (IF rs-cash = NO THEN "БЕЗНАЛИЧНЫЕ" ELSE "НАЛИЧНЫЕ+БЕЗНАЛИЧНЫЕ")) SKIP(0)
     4066    .
     4067     Line = fill("-", integer(frame Purch-frame:width-chars)).
     4068     FORM HEADER
     4069     string(Line, "X(" + string(frame Purch-frame:width-chars) + ")") AT 1 SKIP
     4070     "Продолжение - на следующей странице" AT 30 SKIP
     4071     with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4072     VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4073     FORM with FRAME Purch-frame .
     4074     run waitfram-show in this-procedure ("Ждите...").
     4075     v-doc-rec = recid(X_sj-print).
     4076   DO WHILE available X_sj-print :
     4077     GET prev br-sj.
     4078   END.
     4079   GET next br-sj.
     4080   DO WHILE available X_sj-print :
     4081       Display STREAM PrnLibStream
     4082       X_sj-print.gds-code
     4083       X_sj-print.artic
     4084       X_sj-print.gds-name
     4085       X_sj-print.prod-name
     4086       X_sj-print.var-purch
     4087       (X_sj-print.supp-type + string(X_sj-print.supp-code)) @ v-supp
     4088       get-supp-name(BUFFER X_sj-print) @ v-supp-name
     4089       (if X_sj-print.price-flag
     4090       then X_sj-print.price-sale
     4091       else X_sj-print.sale-sum / X_sj-print.qnty) @ X_sj-print.price-sale
     4092       (X_sj-print.price-flag = no) @ X_sj-print.price-flag
     4093       X_sj-print.is-cash
     4094       X_sj-print.qnty
     4095       X_sj-print.sale-sum
     4096       with FRAME Purch-Frame .
     4097       DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     4098       assign
     4099       var-sale-sum = var-sale-sum + X_sj-print.sale-sum
     4100       var-qnty = var-qnty + X_sj-print.qnty
     4101       .
     4102       GET next br-sj.
     4103     END.
     4104     UNDERLINE stream PrnLibStream    X_sj-print.gds-code                X_sj-print.artic                   X_sj-print.gds-name                X_sj-print.prod-name               X_sj-print.var-purch               v-supp                           v-supp-name                      X_sj-print.price-sale              X_sj-print.qnty                    X_sj-print.sale-sum                with frame Purch-Frame.
     4105     display stream PrnLibStream
     4106     "ИТОГО ПО ВСЕМ" @ X_sj-print.gds-name
     4107     var-qnty @ X_sj-print.qnty
     4108     var-sale-sum @ X_sj-print.sale-sum
     4109     with frame Purch-Frame.
     4110     DOWN STREAM PrnLibStream 1 with FRAME Purch-Frame.
     4111     UNDERLINE stream PrnLibStream    X_sj-print.gds-code                X_sj-print.artic                   X_sj-print.gds-name                X_sj-print.prod-name               X_sj-print.var-purch               v-supp                           v-supp-name                      X_sj-print.price-sale              X_sj-print.qnty                    X_sj-print.sale-sum                with frame Purch-Frame.
     4112   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4113   output  STREAM PrnLibStream CLOSE.
     4114   run waitfram-hide in this-procedure .
     4115   REPOSITION br-sj to recid v-doc-rec no-error.
     4116   APPLY "entry" to br-sj in frame Dialog-Frame .
     4117   run prn-lib-prn-file in this-procedure (
     4118                                             input parParentProc
     4119                                             ,input 8
     4120                                             ).
     4121   END PROCEDURE.
     4122   PROCEDURE proc-b-sch :
     4123   assign
     4124     tbl = 'parts'
     4125     join-tbl = 'X_sj-print'
     4126     fld = ""
     4127     lab = ""
     4128     spr = ""
     4129     dim = '0'
     4130     .
     4131   run fltfield-add in this-procedure('gds-code', 'Код товара', 'function_integer',
     4132   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4133   run fltfield-add in this-procedure('artic', 'Артикул', 'function_character',
     4134   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4135   run fltfield-add in this-procedure('prod-type*prod-code', 'Производитель', 'cli',
     4136   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4137   run fltfield-add in this-procedure('supp-type*supp-code', 'Поставщик', 'cli',
     4138   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4139   run fltfield-add in this-procedure('gds-name', 'Название товара', 'function_character',
     4140   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4141   run fltfield-add in this-procedure('prod-name', 'Название производителя', 'function_character',
     4142   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4143   run fltfield-add in this-procedure('qnty', 'Количество', 'function_decimal',
     4144   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4145   run fltfield-add in this-procedure('sale-sum', 'Сумма', 'function_decimal',
     4146   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4147   run fltfield-add in this-procedure('price-sale', 'Цена', 'function_decimal',
     4148   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4149   run fltfield-add in this-procedure('var-purch', 'Вариант закупки', 'function_integer',
     4150   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4151   run fltfield-add in this-procedure('is-cash', 'Наличные', 'function_logical',
     4152   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4153   run fltfield-add in this-procedure('is-out', 'Расход?', 'function_logical',
     4154   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4155   Filter-Block:
     4156   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4157       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4158       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4159     run gbl/filter.w ( INPUT parparentproc
     4160                      , INPUT (filter-point + chr(4) + filter-label)
     4161                      , INPUT tbl
     4162                      , INPUT join-tbl
     4163                      , INPUT fld
     4164                      , INPUT lab
     4165                      , INPUT spr
     4166                      , INPUT dim ).
     4167     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4168   END.
     4169   END PROCEDURE.
     4170   PROCEDURE proc-check-tovar :
     4171   DEFINE INPUT PARAMETER p-is-out AS LOGICAL NO-UNDO.
     4172   DEFINE INPUT PARAMETER p-gds-code LIKE UB.GOODS.GDS-CODE NO-UNDO.
     4173   DEFINE VARIABLE rid-list as character no-undo .
     4174   DEFINE BUFFER buf_GOODS FOR ub.GOODS.
     4175   find FIRST buf_goods NO-LOCK WHERE buf_goods.gds-code = p-gds-code .
     4176    run ref/gds-chks.w (
     4177                    input parparentproc
     4178                   ,input RECID(buf_GOODS)
     4179                   ,input "":U
     4180                   ,input 'продажа':U
     4181                   ,input ?
     4182                   ,input buf_inkas.obj-type
     4183                   ,input buf_inkas.obj-code
     4184                   ,input buf_inkas.inkas-code
     4185                   ,input "":U
     4186                   ,output rid-list
     4187                    ).
     4188   END PROCEDURE.
     4189   FUNCTION get-supp-name RETURNS CHARACTER
     4190     ( BUFFER buf_sj-print FOR sj-print ) :
     4191   DEFINE BUFFER buf_clients FOR ub.clients.
     4192       find first buf_clients no-lock where
     4193                 buf_clients.obj-type = buf_sj-print.supp-type
     4194             AND buf_clients.obj-code = buf_sj-print.supp-code no-error .
     4195   IF NOT AVAILABLE buf_clients THEN
     4196   RETURN "Неизвестен".
     4197   RETURN buf_clients.obj-name.
     4198   END FUNCTION.
