     1911     define variable v-window-width         as decimal   no-undo .
     1912     define variable v-window-virtual-width as decimal   no-undo .
     1913     define variable v-change-sign          as integer   no-undo .
     1914     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1915     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1916     if p-change-value > 0
     1917     then do:
     1918       if frame Dialog-Frame :width + p-change-value >
     1919           session :width-chars
     1920       then do:
     1921         assign
     1922           p-change-value = session :width-chars - frame Dialog-Frame :width
     1923         .
     1924         if p-change-value <= 0
     1925         then do:
     1926           run diasize_position-resize-button in this-procedure .
     1927           return .
     1928         end.
     1929       end.
     1930     end.
     1931     if p-change-value < 0
     1932     then do:
     1933       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1934       then do:
     1935         assign
     1936           p-change-value = v-diasize-orig-frame-width
     1937                          - frame Dialog-Frame :width
     1938         .
     1939         if p-change-value >= 0
     1940         then do:
     1941           run diasize_position-resize-button in this-procedure .
     1942           return .
     1943         end.
     1944       end.
     1945     end.
     1946     if p-change-value >= 0
     1947     then do:
     1948       assign
     1949         v-change-sign = 1
     1950       .
     1951     end.
     1952     else do:
     1953       assign
     1954         v-change-sign = -1
     1955       .
     1956     end.
     1957     assign
     1958       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1959     .
     1960     if p-change-value = 0
     1961     then do:
     1962       run diasize_position-resize-button in this-procedure .
     1963       return .
     1964     end.
     1965     move_block:
