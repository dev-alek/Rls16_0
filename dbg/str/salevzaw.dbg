     1111        FGCOLOR 4  NO-UNDO.
     1112   DEFINE VARIABLE fvzakr-2 AS DECIMAL FORMAT "->>9.999":U INITIAL 0
     1113        LABEL "р"
     1114         VIEW-AS TEXT
     1115        SIZE 8 BY .67
     1116        FGCOLOR 4  NO-UNDO.
     1117   DEFINE VARIABLE fvzakv-1 AS DECIMAL FORMAT "->>9.999":U INITIAL 0
     1118        LABEL "в"
     1119         VIEW-AS TEXT
     1120        SIZE 8 BY .67
     1121        FGCOLOR 4  NO-UNDO.
     1122   DEFINE VARIABLE fvzakv-2 AS DECIMAL FORMAT "->>9.999":U INITIAL 0
     1123        LABEL "в"
     1124         VIEW-AS TEXT
     1125        SIZE 8 BY .67
     1126        FGCOLOR 4  NO-UNDO.
     1127   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1128         VIEW-AS TEXT
     1129        SIZE 6 BY 1
     1130        FGCOLOR 4  NO-UNDO.
     1131   DEFINE VARIABLE rs-cash AS LOGICAL
     1132        VIEW-AS RADIO-SET HORIZONTAL
     1133        RADIO-BUTTONS
     1134             "Все", ?,
     1135   "Наличные", yes,
     1136   "Безналичные", no
     1137        SIZE 33.5 BY 1 NO-UNDO.
     1138   DEFINE VARIABLE rs-r-v AS LOGICAL
     1139        VIEW-AS RADIO-SET HORIZONTAL
     1140        RADIO-BUTTONS
     1141             "Все", ?,
     1142   "Расход", yes,
     1143   "Возврат", no
     1144        SIZE 33.5 BY 1 NO-UNDO.
     1145   DEFINE VARIABLE rs-vzak AS INTEGER
     1146        VIEW-AS RADIO-SET HORIZONTAL
     1147        RADIO-BUTTONS
     1148             "Все", 0,
     1149   "Вариант закупки 1", 1,
     1150   "Вариант закупки 2", 2
     1151        SIZE 52.5 BY 1 NO-UNDO.
     1152   DEFINE QUERY BR-sj FOR
     1153         X_sj-print SCROLLING.
     1154   DEFINE BROWSE BR-sj
     1155     QUERY BR-sj DISPLAY
     1156         X_sj-print.gds-code     column-label "Код товара"
     1157   X_sj-print.gds-name     column-label "Название товара" format "X(30)"
     1158   X_sj-print.var-purch    column-label "Вар.!закуп"   format "9"
     1159   (IF X_sj-print.price-flag
     1160    THEN  X_sj-print.sale-sum / X_sj-print.qnty
     1161    ELSE X_sj-print.price-sale)
     1162   @ X_sj-print.price-sale   column-label "Цена нетто"
     1163   X_sj-print.price-flag   column-label "При!веден."         format "+/"
     1164   X_sj-print.is-cash      column-label "Нал"                format "+/"
     1165   X_sj-print.qnty         column-label "Количество"
     1166   X_sj-print.sale-sum     column-label "Сумма нетто"
     1167   X_sj-print.artic        column-label "Артикул"
     1168   X_sj-print.prod-name    column-label "Производитель"   format "X(30)"
     1169   X_sj-print.supp-type + string(X_sj-print.supp-code) @ v-supp                column-label "Поставщик"       format "X(12)"
     1170   get-supp-name(BUFFER X_sj-print)  @ v-supp-name           column-label "Поставщик-название" format "X(30)"
     1171   ENABLE
     1172   X_sj-print.sale-sum
     1173       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17 FIT-LAST-COLUMN.
     1174   DEFINE FRAME Dialog-Frame
     1175        b-quit AT ROW 1 COL 1
     1176        B-mark AT ROW 1 COL 11
     1177        b-sel AT ROW 1 COL 21
     1178        B-parts AT ROW 1 COL 41
     1179        B-chk AT ROW 1 COL 51
     1180        B-print AT ROW 1 COL 89
     1181        B-sch AT ROW 1 COL 92
     1182        B-Help AT ROW 1 COL 95
     1183        rs-r-v AT ROW 2 COL 1.5 NO-LABEL
     1184        rs-vzak AT ROW 2 COL 39.5 NO-LABEL
     1185        rs-cash AT ROW 3 COL 1.5 NO-LABEL
     1186        BR-sj AT ROW 5 COL 1
     1187        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1188        fvzak-1 AT ROW 3 COL 67 COLON-ALIGNED
     1189        fvzakr-1 AT ROW 3 COL 78 COLON-ALIGNED
     1190        fvzakv-1 AT ROW 3 COL 89 COLON-ALIGNED
     1191        fvzak-2 AT ROW 4 COL 67 COLON-ALIGNED
     1192        fvzakr-2 AT ROW 4 COL 78 COLON-ALIGNED
     1193        fvzakv-2 AT ROW 4 COL 89 COLON-ALIGNED
     1194        SPACE(0.24) SKIP(17.36)
     1195       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1196            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1197            TITLE "Зарезервированные партии продажи по вариантам закупки"
     1198            DEFAULT-BUTTON b-quit.
     1199   ASSIGN
     1200          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1201          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1202   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1203   DO:
     1204     APPLY "END-ERROR":U TO SELF.
     1205   END.
     1206   ON CHOOSE OF B-chk IN FRAME Dialog-Frame
     1207   DO:
     1208     if not available X_sj-print then return no-apply.
     1209     RUN proc-check-tovar IN THIS-PROCEDURE (X_sj-print.is-out, X_sj-print.gds-code) NO-ERROR.
     1210     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     1211     apply "entry" to br-sj in frame Dialog-Frame.
     1212   END.
     1213   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1214   DO:
     1215   define variable loc#log as logical no-undo .
     1216     if available sj-print then do:
     1217   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1218   define variable v-str-recid11 as character no-undo .
     1219   define variable v-num-entry11 as integer   no-undo .
     1220   assign
     1221     v-str-recid11 = trim( string( recid( sj-print ) , "->>>>>>>>>>>9":U ) )
     1222     v-num-entry11 = lookup( v-str-recid11 , p-rid-list )
     1223   .
     1224   if v-num-entry11 > 0 then do:
     1225     assign
     1226       entry( v-num-entry11, p-rid-list ) = "":U
     1227       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1228     .
     1229   end.
     1230   else do:
     1231     assign
     1232       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid11
     1233     .
     1234   end.
     1235       loc#log = br-sj:refresh() .
     1236       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1237           loc#log = br-sj:select-next-row ().
     1238           apply "VALUE-CHANGED" to br-sj in frame Dialog-Frame.
     1239       end.
     1240       if num-entries( p-rid-list ) = 0
     1241       then
     1242           hide mark-num in frame Dialog-Frame.
     1243       else
     1244           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1245     end.
     1246     apply "entry" to br-sj in frame Dialog-Frame.
     1247   END.
     1248   ON CHOOSE OF B-parts IN FRAME Dialog-Frame
     1249   DO:
     1250     DEFINE variable v-doc-qnty LIKE ub.doc-line.doc-qnty NO-UNDO.
     1251     define variable what-mode as logical no-undo init yes.
     1252     define variable v-prt-rec as recid no-undo .
     1253     define buffer buf_doc-line for ub.doc-line.
     1254     if not available X_sj-print then return no-apply.
     1255     FIND FIRST buf_doc-line No-LOCK WHERE
     1256               buf_doc-line.doc-code = (if X_sj-print.is-out then buf_trn-doc.doc-code else buf_trn-doc.out-code)
     1257         AND  buf_doc-line.artic = X_sj-print.artic
     1258         AND  buf_doc-line.prod-type = X_sj-print.prod-type
     1259         AND  buf_doc-line.prod-code = X_sj-print.prod-code No-ERROR.
     1260    assign
     1261    v-doc-qnty = buf_doc-line.doc-qnty
     1262    .
     1263     if can-find(first ub.doc-prts where
     1264                   ub.doc-prts.gds-code = X_sj-print.gds-code AND
     1265                   ub.doc-prts.out-code = buf_doc-line.doc-code) OR
     1266     can-find(first ub.doc-pl where
     1267                   ub.doc-pl.gds-code = X_sj-print.gds-code AND
     1268                   ub.doc-pl.out-code = buf_doc-line.doc-code) OR
     1269     can-find(first ub.doc-pl-pump where
     1270                   ub.doc-pl-pump.gds-code = X_sj-print.gds-code AND
     1271                   ub.doc-pl-pump.out-code = buf_doc-line.doc-code) or
     1272     can-find(first ub.doc-fbr-gds where
     1273                   ub.doc-fbr-gds.gds-code = X_sj-print.gds-code AND
     1274                   ub.doc-fbr-gds.out-code = buf_doc-line.doc-code) then
     1275     what-mode = no.
     1276     if what-mode = no
     1277     and p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1278       message
     1279       substitute("Для строки накладной продажи &1 &2&3 (код товара &4) НЕВОЗМОЖНО РУЧНОЕ ПЕРЕЗЕРВИРОВАНИЕ партий:&5" +
     1280                  "в строке проводилось резерирование по партиям и/или по складским местам и/или с учетом дальнейшего автопроизводства,&5" +
     1281                  "список партий будет доступен ТОЛЬКО ДЛЯ ПРОСМОТРА"
     1282                  , X_sj-print.artic
     1283                  , X_sj-print.prod-type
     1284                  , X_sj-print.prod-code
     1285                  , X_sj-print.gds-code
     1286                  , chr(10))
     1287       view-as alert-box WARNING.
     1288     end.
     1289     run str/parts-l.w
     1290       (input parparentproc
     1291       ,input buf_inkas.obj-type
     1292       ,input buf_inkas.obj-code
     1293       ,input X_sj-print.gds-code
     1294       ,input buf_doc-line.doc-code
     1295       ,input (if  (p-mode = 'ИЗМЕНЕНИЕ':U
     1296                     and what-mode
     1297                     )
     1298               then 'ИЗМЕНЕНИЕ':U
     1299               else 'ПРОСМОТР':U
     1300               )
     1301       ,input (if buf_inkas.status_ = 'факт':U
     1302               then 'все':U
     1303               else 'документ':U
     1304               )
     1305       ,input 'текущий':U
     1306       ,input 'документ':U
     1307       ,output v-prt-rec
     1308       ).
     1309     apply "entry" to br-sj in frame Dialog-Frame.
     1310     FIND FIRST buf_doc-line No-LOCK WHERE
     1311               buf_doc-line.doc-code = (if X_sj-print.is-out then buf_trn-doc.doc-code else buf_trn-doc.out-code)
     1312         AND  buf_doc-line.artic = X_sj-print.artic
     1313         AND  buf_doc-line.prod-type = X_sj-print.prod-type
     1314         AND  buf_doc-line.prod-code = X_sj-print.prod-code No-ERROR.
     1315     assign
     1316     v-doc-rec = recid(X_sj-print).
     1317     if  (p-mode = 'ИЗМЕНЕНИЕ':U
     1318                     and what-mode
     1319                     ) then do:
     1320       run cre-sj in p-parent-handle (
     1321                                     input v-curr-r-b
     1322                                   , buf_inkas.inkas-code
     1323                                   , input X_sj-print.gds-code
     1324                                   , input X_sj-print.artic
     1325                                   , input X_sj-print.prod-type
     1326                                   , input X_sj-print.prod-code
     1327                                   , input X_sj-print.is-out
     1328                                   , input recid(buf_doc-line)
     1329                                     ).
     1330       run process-two-tables in p-parent-handle (X_sj-print.gds-code, X_sj-print.is-out)  .
     1331       run openbr in this-procedure ( input yes, input no, input '':U).
     1332       run display-pcnt in this-procedure .
     1333     end.
     1334   END.
     1335   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1336   DO:
     1337     if not avail X_sj-print then return no-apply.
     1338     run proc-b-print in this-procedure  no-error.
     1339     if error-status:error then do:
     1340        return no-apply.
     1341     end.
     1342     APPLY "ENTRY" to br-sj.
     1343   END.
     1344   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1345   DO:
     1346     run proc-b-sch in this-procedure no-error.
     1347     if error-status:error then return no-apply.
     1348   END.
     1349   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1350   DO:
     1351     if ( available sj-print ) then do:
     1352       if ( p-rid-list = "" ) or b-mark:sensitive = no then
     1353       p-rid-list = string( recid( sj-print ) ) .
     1354     end.
     1355   END.
     1356   ON VALUE-CHANGED OF rs-cash IN FRAME Dialog-Frame
     1357   DO:
     1358     ASSIGN
     1359     rs-cash
     1360     .
     1361     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     1362     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1363   END.
     1364   ON VALUE-CHANGED OF rs-r-v IN FRAME Dialog-Frame
     1365   DO:
     1366     ASSIGN
     1367     rs-r-v
     1368     .
     1369     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     1370     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1371   END.
     1372   ON VALUE-CHANGED OF rs-vzak IN FRAME Dialog-Frame
     1373   DO:
     1374     ASSIGN
     1375     rs-vzak
     1376     .
     1377     RUN openbr IN  THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     1378     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1379   END.
     1380   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1381   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1382   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1383   on help of frame Dialog-Frame
     1384   do:
     1385     run gbl/app_help.p
     1386       (input this-procedure :file-name
     1387       ,input ''
     1388       ,input ?
     1389       ) no-error.
     1390     if error-status :error then do:
     1391       message
     1392         "Ошибка при вызове помощи"
     1393         error-status :get-message(1)
     1394         view-as alert-box .
     1395     end.
     1396   end.
     1397   run minbtn-set in this-procedure .
     1398   on choose of b-help in frame Dialog-Frame
     1399   do:
     1400     apply "help":u to frame Dialog-Frame .
     1401   end.
     1402   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1403   procedure minbtn-set :
     1404       do
     1405           on error undo, return error return-value
     1406           :
     1407           define variable ii              as integer       no-undo .
     1408           define variable fh              as widget-handle no-undo .
     1409           define variable hh              as widget-handle no-undo .
     1410           define variable v-h             as handle        extent 4 no-undo .
     1411           define variable v-name-button   as character     no-undo .
     1412           define variable v-help-old-x    as decimal       no-undo .
     1413           define variable v-help-old-y    as decimal       no-undo .
     1414           define variable v-help-old-size as decimal       no-undo .
     1415           define variable v-frame-width   as decimal       no-undo .
     1416           define variable jj              as integer       no-undo .
     1417           do
     1418               on error undo, return error
     1419               :
     1420               assign
     1421                   v-frame-width = frame Dialog-Frame:width - 0.3
     1422                   fh            = frame Dialog-Frame:first-child
     1423                   hh            = fh:first-child
     1424                   ii            = 1
     1425                   .
     1426               do while valid-handle(hh):
     1427                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1428                   do:
     1429                       case lc(hh:name) :
     1430                           when "b-help" then
     1431                               do:
     1432                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1433                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1434                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1435                                   hh:TOOLTIP = "Помощь" .
     1436                                   v-help-old-x = hh:column .
     1437                                   v-help-old-y = hh:row    .
     1438                                   v-help-old-size = hh:width .
     1439                                   hh:width-chars = 2.5 .
     1440                               end.
     1441                           when "b-print" then
     1442                               do:
     1443                                   hh:load-image("cmp/b-print.bmp":u) .
     1444                                   hh:TOOLTIP = "Печать" .
     1445                                   v-h[ii] = hh:handle .
     1446                                   ii = ii + 1 .
     1447                                   hh:width-chars = 3 .
     1448                               end.
     1449                           when "b-history" or
     1450                           when "b-hist" then
     1451                               do:
     1452                                   hh:load-image("cmp/b-hist.bmp":u) .
     1453                                   hh:TOOLTIP = "История" .
     1454                                   v-h[ii] = hh:handle .
     1455                                   ii = ii + 1 .
     1456                                   hh:width-chars = 3 .
     1457                               end.
     1458                           when "b-sch" then
     1459                               do:
     1460                                   hh:load-image("cmp/b-sch.bmp":u) .
     1461                                   hh:TOOLTIP = "Установка Фильтра" .
     1462                                   v-h[ii] = hh:handle .
     1463                                   ii = ii + 1 .
     1464                                   hh:width-chars = 3 .
     1465                               end.
     1466                           when "b-hist-user" then
     1467                               do:
     1468                                   hh:load-image("cmp/b-hist.bmp":u) .
     1469                                   hh:TOOLTIP = "История пользователя" .
     1470                                   ii = ii + 1 .
     1471                               end.
     1472                       end case.
     1473                   end.
     1474                   hh = hh:next-sibling.
     1475               end.
     1476               b-help:column = v-frame-width - b-help:width-chars.
     1477               jj = 0.
     1478               repeat ii = 4 to 1 by -1 :
     1479                   if valid-handle (v-h[ii] ) then
     1480                   do:
     1481                       jj  = jj + 1 .
     1482                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1483                       v-h[ii]:row    = v-help-old-y .
     1484                   end.
     1485               end.
     1486           end.
     1487       end.
     1488   end procedure.
     1489   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1490   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1491   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1492   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1493   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1494   define variable v-diasize-current-frame-height as decimal   no-undo .
     1495   define variable v-diasize-change-size          as logical   no-undo .
     1496   define variable v-diasize-resize-button        as handle    no-undo .
     1497   define variable v-diasize-wndmax               as logical   no-undo .
     1498   define variable v-diasize-wndstore             as logical   no-undo .
     1499   define variable v-diasize-proc-name            as character no-undo .
     1500   define variable v-diasize-browse-handle        as handle    no-undo .
     1501   define variable v-diasize-browse-number        as integer   no-undo .
     1502   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1503   define temp-table temp-diasize-handle no-undo
     1504     field handle-value  as handle
     1505     field save-position as decimal
     1506     index xpk is primary unique handle-value
     1507     .
     1508   define temp-table temp-browse-handle no-undo
     1509     field browse-type   as character
     1510     field browse-number as integer
     1511     field browse-handle as handle
     1512     field original-size as decimal
     1513     index xpk is primary unique browse-type browse-number
     1514     index xie browse-type browse-handle
     1515   .
     1516   procedure diasize_change-height :
     1517     define input  parameter p-change-value  as decimal   no-undo .
     1518     define input  parameter p-move-resize   as logical   no-undo .
     1519     define variable v-field-group-handle    as handle    no-undo .
     1520     define variable v-object-handle         as handle    no-undo .
     1521     define variable v-frame-height          as decimal   no-undo .
     1522     define variable v-frame-virtual-height  as decimal   no-undo .
     1523     define variable v-browse-height         as decimal   no-undo .
     1524     define variable v-window-height         as decimal   no-undo .
     1525     define variable v-window-virtual-height as decimal   no-undo .
     1526     define variable v-change-sign           as integer   no-undo .
     1527     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1528     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1529     if p-change-value > 0
     1530     then do:
     1531       if frame Dialog-Frame :height + p-change-value
     1532           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1533       then do:
     1534         assign
     1535           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1536                           - (frame Dialog-Frame :height-chars)
     1537         .
     1538         if p-change-value <= 0
     1539         then do:
     1540           run diasize_position-resize-button in this-procedure .
     1541           return .
     1542         end.
     1543       end.
     1544     end.
     1545     if p-change-value < 0
     1546     then do:
     1547       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1548       then do:
     1549         assign
     1550           p-change-value = v-diasize-orig-frame-height
     1551                          - (frame Dialog-Frame :height-chars)
     1552         .
     1553         if p-change-value >= 0
     1554         then do:
     1555           run diasize_position-resize-button in this-procedure .
     1556           return .
     1557         end.
     1558       end.
     1559     end.
     1560     if p-change-value >= 0
     1561     then do:
     1562       assign
     1563         v-change-sign = 1
     1564       .
     1565     end.
     1566     else do:
     1567       assign
     1568         v-change-sign = -1
     1569       .
     1570     end.
     1571     assign
     1572       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1573     .
     1574     if p-change-value = 0
     1575     then do:
     1576       run diasize_position-resize-button in this-procedure .
     1577       return .
     1578     end.
     1579     move_block:
     1580     do
     1581     on error undo move_block, retry move_block
     1582     :
     1583       if retry
     1584       then do:
     1585         do
     1586         on error undo move_block, leave move_block
     1587         :
     1588           if p-change-value > 0
     1589           then do:
     1590             for each buf_temp-diasize-handle
     1591             on error undo, next
     1592             :
     1593               assign
     1594                 v-object-handle = buf_temp-diasize-handle.handle-value
     1595               .
     1596               if v-object-handle <> v-diasize-resize-button
     1597               then do:
     1598                 assign
     1599                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1600                 .
     1601               end.
     1602             end.
     1603             assign
     1604               v-diasize-browse-handle :height = v-browse-height
     1605             .
