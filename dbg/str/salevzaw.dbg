      709   procedure prn-lib-prn-file :
      710     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      711     define input parameter p-DIsabledoptions as integer no-undo .
      712     define variable v-report-name as character no-undo .
      713     define variable v-user-action as character no-undo .
      714     define variable v-printed     as logical   no-undo .
      715     define variable v-exist       as logical   no-undo .
      716     do
      717       on error undo, return error
      718       :
      719       run prn-lib-get-report-name  in this-procedure (
      720         input parParentProc
      721         ,output v-report-name
      722         ).
      723   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      724   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      725     (input  v-report-name
      726     ,input  2
      727     ,output v-exist
      728     )  .
      729       if NOT v-exist then
      730       DO:
      731         Message
      732           "Нет заданий на печать ! "
      733           view-as alert-box .
      734         Return  .
      735       End.
      736       run gbl/prnfilen.w
      737         (input  ""
      738         ,input  p-DisabledOptions
      739         ,input  string(v-report-name )
      740         ,input  7
      741         ,output v-user-action
      742         ,output v-printed
      743         ) .
      744       if v-printed then
      745       do:
      746         return "YES" .
      747       end.
      748       else
      749       do:
      750         return "NO" .
      751       end.
      752     end.
      753   end procedure.
      754   procedure prn-lib-open-stream :
      755     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      756     define input parameter p-page-size    as integer no-undo .
      757     define input parameter p-is-stream    as logical no-undo .
      758     define input parameter p-append       as logical no-undo .
      759     define variable v-report-name as character no-undo .
      760     do
      761       on error undo, return error
      762       :
      763       run prn-lib-get-report-name  in this-procedure (
      764         input parParentProc
      765         ,output v-report-name
      766         ).
      767       if p-is-stream then
      768       do:
      769         if p-append then
      770         do:
      771           output stream PrnLibStream to value( v-report-name )
      772             page-size value(p-page-size) append .
      773         end.
      774         if not p-append then
      775         do:
      776           output stream PrnLibStream to value( v-report-name )
      777             page-size value(p-page-size) .
      778         end.
      779       end.
      780       if not p-is-stream then
      781       do:
      782         if p-append then
      783         do:
      784           output to value( v-report-name )
      785             page-size value(p-page-size) append .
      786         end.
      787         if not p-append then
      788         do:
      789           output to value( v-report-name )
      790             page-size value(p-page-size) .
      791         end.
      792       end.
      793     end.
      794   end procedure.
      795   procedure prn-lib-open-exp :
      796     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      797     define input parameter p-is-stream    as logical no-undo .
      798     define input parameter p-is-append    as logical no-undo .
      799     define output parameter p-ReportFileName as char init "report" no-undo.
      800     define output parameter p-process as logical no-undo .
      801     define variable glog as logical no-undo .
      802     do
      803       on error undo, return error
      804       :
      805       SYSTEM-DIALOG GET-FILE p-ReportFileName
      806         TITLE      "Укажите путь"
      807         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      808         ASK-OVERWRITE
      809         CREATE-TEST-FILE
      810         SAVE-AS
      811         USE-FILENAME
      812         DEFAULT-EXTENSION "txt"
      813         UPDATE glog
      814         .
      815       if not glog then  return.
      816       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      817       if p-is-stream then
      818       do:
      819         if p-is-append then
      820         do:
      821           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      822         end.
      823         else
      824         do:
      825           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      826         end.
      827       end.
      828       else
      829       do:
      830         if p-is-append then
      831         do:
      832           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      833         end.
      834         else
      835         do:
      836           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      837         end.
      838       end.
      839       p-process = yes.
      840     end.
      841   end procedure.
      842   procedure prn-lib-get-report-name :
      843     define input parameter parParentProc  as widget-handle no-undo.
      844     define output parameter p-report-name as character no-undo .
      845     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      846   end procedure.
      847   procedure prn-lib-reportviewer-report-name :
      848     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      849     define input parameter p-report-name-html as character no-undo .
      850     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
