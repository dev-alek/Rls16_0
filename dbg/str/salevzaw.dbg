     2125         v-diasize-resize-button :row = 1.
     2126         v-diasize-resize-button :column = 1.
     2127       end.
     2128       if p-change-value > 0
     2129       then do:
     2130         if frame Dialog-Frame :scrollable = true
     2131         then do:
     2132           assign
     2133             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2134             no-error .
