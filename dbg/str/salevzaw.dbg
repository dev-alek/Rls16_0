     1741       if p-change-value > 0
     1742       then do:
     1743         if frame Dialog-Frame :scrollable = true
     1744         then do:
     1745           assign
     1746             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1747             no-error .
