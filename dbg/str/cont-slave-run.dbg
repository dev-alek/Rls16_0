        1   block-level on error undo, throw.
        2   DEFINE VARIABLE vss-revision    AS CHARACTER NO-UNDO INIT "$Revision: aea5316774be, 0, rls $":U .
        3   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INIT "$Author: expertek $":U .
        4   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INIT "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INIT "$Workfile: cont-slave-run.p $":U .
        6   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INIT "$Archive: str/cont-slave-run.p $":U .
        7   DEFINE VARIABLE vss-description AS CHARACTER NO-UNDO INIT "Создает или удаляет подчиненный договор".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define new global shared variable g#library  as handle no-undo .
      112   define new global shared variable g#library2 as handle no-undo .
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   procedure gen-b-code :
      115     define input  parameter type-code like ub.code-range.range-type no-undo .
      116     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      117     do
      118     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      119     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      120     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      121     :
      122       define buffer buf_thbj-attr     for ub.thbj-attr .
      123       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      124       define buffer buf_code-range for ub.code-range .
      125       define variable l-code         as   integer              no-undo .
      126       define variable v-db-num       like ub.db.db-num         no-undo .
      127       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      128       if type-code = 'sslc':U
      129       or type-code = 'ssgb':U
      130       then do:
      131         message
      132           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      133           "Обратитесь к администратору системы."
      134           view-as alert-box error .
      135         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      136       end.
      137       run trg/getpcode.p ( input  type-code
      138                      ,output cfg-param-code
      139                     ).
      140       run get-next-seq( input  type-code,
      141                         output l-code
      142                       ).
      143       find first buf_sys-ctrl no-lock.
      144       if type-code = 'sclc':U
      145       or type-code = 'pglc':U
      146       then do:
      147         assign
      148           v-db-num = 0
      149         .
      150       end.
      151       else do:
      152         assign
      153           v-db-num = buf_sys-ctrl.db-num
      154         .
      155       end.
      156       find first buf_code-range no-lock
      157         where buf_code-range.db-num     = v-db-num
      158           and buf_code-range.range-type = type-code
      159           and buf_code-range.stts       = "a"
      160         use-index stts
      161         no-error .
      162       if available buf_code-range
      163          and l-code <= buf_code-range.last-code
      164          and l-code >= buf_code-range.first-code then do:
      165         assign
      166           p-b-code = l-code
      167         .
      168       end.
      169       else do:
      170         if available buf_code-range
      171            and l-code < buf_code-range.last-code then do:
      172           message
      173             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      174             "Обратитесь к администратору системы."
      175             view-as alert-box error .
      176           undo, return error "sequence":U .
      177         end.
      178         do transaction
      179         on error undo, return error
      180         :
      181           find first buf_thbj-attr exclusive-lock
      182             where buf_thbj-attr.upper-prop-code = 'code-range':U
      183               and buf_thbj-attr.prop-code = cfg-param-code
      184               and buf_thbj-attr.obj-type   = 'БД':U
      185               and buf_thbj-attr.obj-code   = v-db-num
      186             no-error .
      187           if not available buf_thbj-attr then do:
      188             find first buf_thbj-attr exclusive-lock
      189               where buf_thbj-attr.upper-prop-code = 'code-range':U
      190                 and buf_thbj-attr.prop-code = cfg-param-code
      191                 and buf_thbj-attr.obj-type   = ''
      192                 and buf_thbj-attr.obj-code   = 0
      193               no-error .
      194             if not available buf_thbj-attr then do:
      195               if not locked buf_thbj-attr then do:
      196                 message
      197                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      198                   "Обратитесь к администратору системы."
      199                   view-as alert-box error .
      200               end.
      201               undo, return error "config":U .
      202             end.
      203           end.
      204           run get-next-seq( input type-code,
      205                             output l-code
      206                           ).
      207           find first buf_code-range
      208             where buf_code-range.db-num     = v-db-num
      209               and buf_code-range.range-type = type-code
      210               and buf_code-range.stts       = "a"
      211             use-index stts
      212             no-error .
      213           if available buf_code-range
      214           and l-code <= buf_code-range.last-code
      215           and l-code >= buf_code-range.first-code
      216           then do:
      217             assign
      218               p-b-code = l-code
      219             .
      220           end.
      221           else do:
      222             if available buf_code-range then do:
      223               assign
      224                 buf_code-range.stts = "u"
      225               .
      226             end.
      227             find first buf_code-range
      228               where buf_code-range.db-num     = v-db-num
      229                 and buf_code-range.range-type = type-code
      230                 and buf_code-range.stts       = "f"
      231               use-index stts
      232               no-error .
      233             if not available buf_code-range then do:
      234               message
      235                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      236                 "Обратитесь к администратору системы"
      237                 view-as alert-box error .
      238               undo, return error "code-range":U .
      239             end.
      240             assign
      241               buf_code-range.stts           = "a"
      242             .
      243             if buf_code-range.first-code = 1 then do:
      244               run set-seq-cr( input type-code,
      245                               input buf_code-range.first-code
      246                             ).
      247               assign
      248                 p-b-code = 1
      249               .
      250             end.
      251             else do:
      252               run set-seq-cr( input type-code,
      253                               input ( buf_code-range.first-code - 1 )
      254                             ).
      255               run get-next-seq( input type-code,
      256                                 output p-b-code
      257                               ).
      258             end.
      259           end.
      260         end.
      261       end.
      262     end.
      263   end procedure.
      264   procedure get-next-seq :
      265     define input  parameter type-code like ub.code-range.range-type no-undo .
      266     define output parameter next-seq  as   integer                  no-undo .
      267     do
      268     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      269     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      270     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      271     :
      272       case type-code:
      273         when 'bcgb':U then do:
      274           assign
      275             next-seq = next-value(s-bcgb-code, ub)
      276           .
      277         end.
      278         when 'scgb':U then do:
      279           assign
      280             next-seq = next-value(s-scgb-code, ub)
      281           .
      282         end.
      283         when 'sclc':U then do:
      284           assign
      285             next-seq = next-value(s-sclc-code, ub)
      286           .
      287         end.
      288         when 'pglc':U then do:
      289           assign
      290             next-seq = next-value(s-pglc-code, ub)
      291           .
      292         end.
      293         when 'dcgb':U then do:
      294           assign
      295             next-seq = next-value(s-dcgb-code, ub)
      296           .
      297         end.
      298         when 'ctgb':U then do:
      299           assign
      300             next-seq = next-value(s-ctgb-code, ub)
      301           .
      302         end.
      303         when 'drgb':U then do:
      304           assign
      305             next-seq = next-value(s-drgb-code, ub)
      306           .
      307         end.
      308         when 'fmgb':U then do:
      309           assign
      310             next-seq = next-value(s-fmgb-code, ub)
      311           .
      312         end.
      313         when 'pngb':U then do:
      314           assign
      315             next-seq = next-value(s-pngb-code, ub)
      316           .
      317         end.
      318         when 'cagb':U then do:
      319           assign
      320             next-seq = next-value(s-cagb-code, ub)
      321           .
      322         end.
      323         when 'fdgb':U then do:
      324           assign
      325             next-seq = next-value(s-fin-doc, ub)
      326           .
      327         end.
      328       end case.
      329     end.
      330   end procedure.
      331   procedure set-seq-cr :
      332     define input parameter type-code like ub.code-range.range-type no-undo .
      333     define input parameter set-val   like ub.code-range.first-code no-undo .
      334     do
      335     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      336     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      337     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      338     :
      339       case type-code:
      340         when 'bcgb':U then do:
      341           assign
      342             current-value(s-bcgb-code, ub) = set-val
      343           .
      344         end.
      345         when 'scgb':U then do:
      346           assign
      347             current-value(s-scgb-code, ub) = set-val
      348           .
      349         end.
      350         when 'sclc':U then do:
      351           assign
      352             current-value(s-sclc-code, ub) = set-val
      353           .
      354         end.
      355         when 'pglc':U then do:
      356           assign
      357             current-value(s-pglc-code, ub) = set-val
      358           .
      359         end.
      360         when 'dcgb':U then do:
      361           assign
      362             current-value(s-dcgb-code, ub) = set-val
      363           .
      364         end.
      365         when 'ctgb':U then do:
      366           assign
      367             current-value(s-ctgb-code, ub) = set-val
      368           .
      369         end.
      370         when 'drgb':U then do:
      371           assign
      372             current-value(s-drgb-code, ub) = set-val
      373           .
      374         end.
      375         when 'fmgb':U then do:
      376           assign
      377             current-value(s-fmgb-code, ub) = set-val
      378           .
      379         end.
      380         when 'pngb':U then do:
      381           assign
      382             current-value(s-pngb-code, ub) = set-val
      383           .
      384         end.
      385         when 'cagb':U then do:
      386           assign
      387             current-value(s-cagb-code, ub) = set-val
      388           .
      389         end.
      390         when 'fdgb':U then do:
      391           assign
      392             current-value(s-fin-doc, ub) = set-val
      393           .
      394         end.
      395       end case.
      396     end.
      397   end procedure.
      398   procedure new-bcod-gen-code-range :
      399     do
      400     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      401     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      402     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      403     :
      404       define input parameter p-db-num  like ub.db.db-num             no-undo .
      405       define input parameter type-code like ub.code-range.range-type no-undo .
      406       define buffer buf_code-range      for ub.code-range .
      407       define buffer last_code-range     for ub.code-range .
      408       define buffer last-1_code-range   for ub.code-range .
      409       define buffer last-2_code-range   for ub.code-range .
      410       define buffer last-3_code-range   for ub.code-range .
      411       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      412       define variable conf-par       as character no-undo .
      413       define variable par-type       as character no-undo .
      414       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      415       define variable v-cre-cdrg as logical   no-undo .
      416       define variable v-cre-str  as character no-undo .
      417       define variable v-cr1      as integer no-undo .
      418       define variable v-cr2      as integer no-undo .
      419       define variable v-cr3      as integer no-undo .
      420       define variable v-cmax     as integer no-undo .
      421       find first buf_sys-ctrl no-lock .
      422       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      423         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      424                                       ,vss-workfile
      425                                       ,vss-revision
      426                                       ,vss-description
      427                                       ,chr(10)
      428                                       , p-db-num
      429                                      ).
      430       end.
      431       run trg/getpcode.p ( input  type-code
      432                      ,output cfg-param-code
      433                     ).
      434       for each buf_code-range
      435         where buf_code-range.db-num     = -1
      436           and buf_code-range.range-type = type-code
      437           and buf_code-range.stts       = "f"
      438       by buf_code-range.first-code
      439       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      440       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      441       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      442       :
      443         assign
      444           buf_code-range.db-num = p-db-num
      445         .
      446         return .
      447       end.
      448       assign
      449         v-cre-cdrg = TRUE
      450       .
      451       case type-code:
      452         when 'sclc':U
      453         or when 'scgb':U
      454         or when 'pglc':U
      455         then do:
      456           find last last-1_code-range no-lock
      457             where last-1_code-range.range-type = 'sclc':U
      458             no-error .
      459           if available last-1_code-range then do:
      460             v-cr1 = last-1_code-range.last-code.
      461           end.
      462           find last last-2_code-range no-lock
      463             where last-2_code-range.range-type = 'scgb':U
      464             no-error .
      465           if available last-2_code-range then do:
      466             v-cr2 = last-2_code-range.last-code.
      467             end.
      468           find last last-3_code-range no-lock
      469             where last-3_code-range.range-type = 'pglc':U
      470             no-error .
      471           if available last-3_code-range then do:
      472             v-cr3 = last-3_code-range.last-code.
      473           end.
      474           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      475           .
      476           if v-cmax = v-cr1  then do:
      477               find last last_code-range no-lock
      478                 where recid( last_code-range ) = recid( last-1_code-range )
      479                 .
      480             end.
      481           if v-cmax = v-cr2  then do:
      482               find last last_code-range no-lock
      483                 where recid( last_code-range ) = recid( last-2_code-range )
      484                 .
      485             end.
      486           if v-cmax = v-cr3  then do:
      487             find last last_code-range no-lock
      488               where recid( last_code-range ) = recid( last-3_code-range )
      489               .
      490           end.
      491           if last_code-range.last-code + 1 > 99999 then do:
      492             assign
      493               v-cre-cdrg = FALSE
      494             .
      495           end.
      496         end.
      497         when 'bcgb':U
      498         or when 'sslc':U
      499         or when 'ssgb':U
      500         then do:
      501           find last last-1_code-range no-lock
      502             where last-1_code-range.range-type = 'sslc':U
      503             no-error .
      504           if available last-1_code-range then do:
      505             v-cr1 = last-1_code-range.last-code.
      506           end.
      507           find last last-2_code-range no-lock
      508             where last-2_code-range.range-type = 'bcgb':U
      509             no-error .
      510           if available last-2_code-range then do:
      511             v-cr2 = last-2_code-range.last-code.
      512             end.
      513           find last last-3_code-range no-lock
      514             where last-3_code-range.range-type = 'ssgb':U
      515             no-error .
      516           if available last-3_code-range then do:
      517             v-cr3 = last-3_code-range.last-code.
      518           end.
      519           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      520           .
      521           if v-cmax = v-cr1  then do:
      522               find last last_code-range no-lock
      523                 where recid( last_code-range ) = recid( last-1_code-range )
      524                 .
      525             end.
      526           if v-cmax = v-cr2  then do:
      527               find last last_code-range no-lock
      528                 where recid( last_code-range ) = recid( last-2_code-range )
      529                 .
      530             end.
      531           if v-cmax = v-cr3  then do:
      532             find last last_code-range no-lock
      533               where recid( last_code-range ) = recid( last-3_code-range )
      534               .
      535           end.
      536         end.
      537         otherwise do:
      538           find last last_code-range no-lock
      539             where last_code-range.range-type = type-code
      540             no-error .
      541         end.
      542       end case.
      543       if not available last_code-range then do:
      544         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      545                                       ,vss-workfile
      546                                       ,vss-revision
      547                                       ,vss-description
      548                                       , chr(10)
      549                                       , type-code
      550                                      ) .
      551       end.
      552       define variable v-mes0 as character no-undo .
      553       define variable v-param-type0 as character no-undo .
      554       define variable v-value-character0 as INTEGER no-undo .
      555       define variable v-value-date0 as date no-undo .
      556       define variable v-value-decimal0 as decimal no-undo .
      557       define variable v-value-integer0 AS integer no-undo .
      558       define variable v-value-logical0 AS LOGICAL no-undo .
      559       define variable v-tth0 as handle no-undo .
      560       run adm/shattri.p (
      561           input "get":U
      562           ,input  'БД':U
      563           ,input  p-db-num
      564           ,input  'code-range':U
      565           ,input  cfg-param-code
      566           ,output v-value-character0
      567           ,output v-value-date0
      568           ,output v-value-decimal0
      569           ,output v-value-integer0
      570           ,output v-value-logical0
      571           ,output v-param-type0
      572           ,INPUT-OUTPUT table-handle v-tth0
      573           ) no-error .
      574       if error-status :error then do:
      575         delete object v-tth0.
      576         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      577                            , error-status:get-message(1)
      578                            , chr(10)
      579                            , return-value ).
      580         undo, return error v-mes0.
      581       end.
      582       delete object v-tth0.
      583       if v-cre-cdrg = TRUE then do:
      584         create buf_code-range .
      585         assign
      586           buf_code-range.db-num     = p-db-num
      587           buf_code-range.range-type = type-code
      588           buf_code-range.stts       = "f"
      589           buf_code-range.first-code = last_code-range.last-code + 1
      590           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      591           v-cre-str = "Свободный диапазон успешно создан"
      592         .
      593       end.
      594       else do:
      595         assign
      596           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      597                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      598         .
      599       end.
      600     end.
      601     return v-cre-str .
      602   end procedure.
      603   procedure gen-new-code-range-if-neces :
      604     define input parameter v-db-num           like ub.db.db-num             no-undo .
      605     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      606     define input parameter v-cur-code         as   integer                  no-undo .
      607     define input parameter v-g#news           as   logical                  no-undo .
      608     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      609     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      610     do
      611     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      612     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      613     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      614     :
      615       define variable l-code-range-exist as logical   no-undo init false .
      616       define variable v-db-for-send      as character no-undo .
      617       define buffer buf_code-range  for ub.code-range .
      618       define buffer buf1_code-range for ub.code-range .
      619       define buffer buf_db          for ub.db .
      620       find first buf_code-range
      621         where buf_code-range.range-type = v-range-type
      622           and buf_code-range.last-code >= v-cur-code
      623         use-index last-codei
      624         no-error .
      625       if
      626       (
      627          available buf_code-range
      628          and
      629         (buf_code-range.db-num = v-db-num
      630           and
      631         buf_code-range.first-code <= v-cur-code
      632         )
      633       or
      634         (
      635           v-range-type = 'drgb':U
      636           AND
      637           v-cur-code = 0
      638         )
      639      )
      640      then do:
      641         assign
      642           l-code-range-exist = true
      643         .
      644         if v-g#news
      645         and buf_code-range.stts = "f" then do:
      646           assign
      647             buf_code-range.stts = "u"
      648           .
      649         end.
      650       end.
      651       if not l-code-range-exist
      652          and v-g#news-source-db <> 0
      653       then do:
      654         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      655                                       ,vss-workfile
      656                                       ,vss-revision
      657                                       ,vss-description
      658                                       ,chr(10)
      659                                       ,v-db-num
      660                                       ,v-range-type
      661                                       ,v-cur-code
      662                                      ).
      663       end.
      664       if (not l-code-range-exist
      665           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      666          )
      667       and ( not can-find (first buf1_code-range no-lock
      668                           where buf1_code-range.db-num = v-db-num
      669                             and buf1_code-range.range-type = v-range-type
      670                             and buf1_code-range.stts = "f"
      671                          )
      672           )
      673       then do:
      674         if v-g#db-num = 0 then do:
      675           run new-bcod-gen-code-range in this-procedure
      676             (input v-db-num,
      677              input v-range-type
      678             ) no-error .
      679           if error-status :error then do:
      680             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      681                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      682                                           ,v-db-num
      683                                           ,v-range-type
      684                                           ,v-cur-code
      685                                           ,chr(10)
      686                                           ,error-status:get-message(1)
      687                                           ,return-value
      688                                          ).
      689           end.
      690         end.
      691         else do:
      692           if v-range-type = 'sclc':U
      693           or v-range-type = 'pglc':U
      694           then do:
      695             assign
      696               v-db-for-send = "":U
      697             .
      698             if v-g#db-num = 0 then do:
      699               for each buf_db no-lock
      700                 where buf_db.db-num > 0
      701                   and buf_db.db-num <> v-g#news-source-db
      702               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      703               :
      704                 assign
      705                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      706                 .
      707               end.
      708               assign
      709                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      710               .
      711             end.
      712             else do:
      713               if not v-g#news then do:
      714                 assign
      715                   v-db-for-send = "0":U
      716                 .
      717               end.
      718             end.
      719             run nws/cr-route.p ( input 'send-cmd':U
      720                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      721                                  "code-range":U + chr(1) +
      722                                  (if v-range-type = 'sclc':U
      723                                   then string( current-value(s-sclc-code, ub))
      724                                   else string( current-value(s-pglc-code, ub))
      725                                   ) + chr(1) +
      726                                   v-range-type)
      727                           ,input ?
      728                           ,input v-db-for-send
      729                           ) no-error .
      730             if error-status :error then do:
      731               undo, return error return-value.
      732             end.
      733           end.
      734         end.
      735       end.
      736     end.
      737   end procedure.
      738   procedure cre-loc-sc-code-range :
      739     define input parameter v-cur-code as integer no-undo .
      740   define input parameter p-cdrg-type as character no-undo .
      741     do
      742     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      743     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      744     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      745     :
      746       define buffer buf_code-range for ub.code-range .
      747       find first buf_code-range
      748            where buf_code-range.range-type = p-cdrg-type
      749              and buf_code-range.first-code >= v-cur-code
      750            no-error .
      751       if not available buf_code-range then do:
      752         run new-bcod-gen-code-range in this-procedure
      753           ( input 0,
      754             input p-cdrg-type
      755           ) no-error .
      756         if error-status :error then do:
      757           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      758                                          + "Код &2&1&3 &4"
      759                                         , chr(10)
      760                                         , v-cur-code
      761                                         , error-status:get-message(1)
      762                                         , return-value
      763                                        ) .
      764         end.
      765       end.
      766     end.
      767   end procedure.
      768   procedure mark-used-if-need :
      769   define input parameter p-cur-code as integer no-undo .
      770   define input parameter p-range-type like ub.code-range.range-type no-undo .
      771   define input parameter p-db-num like ub.code-range.db-num no-undo .
      772     do
      773     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      774     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      775     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      776     :
      777       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      778       define buffer buf_code-range for ub.code-range .
      779       assign
      780       v-db-num = if p-range-type = 'sclc':U
      781                  then 0
      782                  else p-db-num
      783       .
      784   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      785   define buffer locK-batchprocess1 for ub.batchprocess.
      786   run gbl/lock-prc.p
      787       (input 'lscc':U
      788       ,input 0
      789       ,input 0
      790       ,input 0
      791       ,input ""
      792       ,input ""
      793       ,input ""
      794       ,input (
      795               ",,,Вкл/выкл лок. вес. кодов"
      796              )
      797       ,input true
      798       ,buffer lock-batchprocess1
      799       ) no-error .
      800     if error-status :error then do:
      801       message
      802         vss-workfile vss-revision vss-description skip
      803         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      804         view-as alert-box error .
      805       undo, return error .
      806     end.
      807       find first buf_code-range
      808            where buf_code-range.range-type = p-range-type
      809              and buf_code-range.first-code >= p-cur-code
      810              and buf_code-range.last-code <= p-cur-code
      811              and buf_code-range.db-num = v-db-num
      812            no-error .
      813       if not available buf_code-range then do:
      814         message
      815           vss-workfile vss-revision vss-description skip
      816           "Ошибка при создании поиске диапазона" skip
      817           "База данных" p-db-num skip
      818           "Код" p-cur-code skip
      819           "Тип" p-range-type
      820           error-status :get-message(1) skip
      821           return-value skip
      822           view-as alert-box error .
      823         undo, return error .
      824       end.
      825       if buf_code-range.stts = "f":U then do:
      826         assign
      827         buf_code-range.stts = "u":U
      828         .
      829       end.
      830     end.
      831   end procedure.
      832   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833     define variable v-cntxt-db-num        as integer   no-undo .
      834     define variable v-cntxt-userid        as character no-undo .
      835     define variable v-cntxt-level         as character no-undo .
      836     define variable v-cntxt-host-code-obj as integer   no-undo .
      837     define variable v-cntxt-obj-type      as character no-undo .
      838     define variable v-cntxt-obj-code      as integer   no-undo .
      839     define variable v-cntxt-db-num-obj    as integer   no-undo .
      840     define variable v-cntxt-is-admin      as logical   no-undo .
      841   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      842   procedure gen-key-rec :
      843     define input  parameter p-tbl-name    as character no-undo.
      844     define input  parameter p-bh_tbl-name as handle    no-undo.
      845     define output parameter p-key-rec     as character no-undo.
      846     do
      847     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      848     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      849     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      850     :
      851       define variable fh               as handle    no-undo .
      852       define variable v-ok             as logical   no-undo .
      853       define variable v-inform         as character no-undo .
      854       define variable v-ind            as integer   no-undo .
      855       define variable v-idx-field-qnty as integer   no-undo .
      856       if p-tbl-name = ?
      857         or p-tbl-name = "":U
      858       then do:
      859         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      860       end.
      861       if not p-bh_tbl-name:available then do:
      862         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      863       end.
      864       assign
      865         p-key-rec = p-tbl-name
      866         v-inform  = p-bh_tbl-name:index-information(1)
      867         v-ind     = 2
      868       .
      869       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      870       on error undo, return error
      871       :
      872         assign
      873           v-inform = p-bh_tbl-name:index-information( v-ind )
      874           v-ind    = v-ind + 1
      875         .
      876       end.
      877       if v-inform = ?
      878         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      879         or entry( 3, v-inform, ",":U ) <> "1":U
      880       then do:
      881         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      882       end.
      883       else do:
      884         assign
      885           v-idx-field-qnty = num-entries( v-inform ) - 4
      886         .
      887         if v-idx-field-qnty < 2 then do:
      888           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      889         end.
      890         do v-ind = 1 to v-idx-field-qnty by 2
      891         on error undo, return error
      892         :
      893           assign
      894             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      895             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      896           .
      897         end.
      898       end.
      899       if p-key-rec = ? then do:
      900         assign
      901           p-key-rec = "":U
      902         .
      903         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      904       end.
      905     end.
      906     return.
      907   end procedure.
      908   procedure gen-where-keyr-tab :
      909     define input  parameter i-tableSerach as character no-undo.
      910     define input  parameter i-tablekey   as character  no-undo.
      911     define input  parameter p-key-rec    as character  no-undo.
      912     define input  parameter p-key-handle as handle     no-undo .
      913     define input  parameter p-db-name    as character  no-undo .
      914     define input  parameter p-tt-handle  as handle     no-undo .
      915     define output parameter o-Where      as character  no-undo.
      916     do
      917     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      918     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      919     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      920     :
      921       define variable v-full-tbl-name  as character no-undo .
      922       define variable bh_tbl-name      as handle    no-undo .
      923       define variable fh_key           as handle    no-undo .
      924       define variable fh_search        as handle    no-undo .
      925       define variable v-field-num      as integer   no-undo .
      926       define variable v-count-fld      as integer   no-undo .
      927       define variable v-inform         as character no-undo .
      928       define variable v-ind            as integer   no-undo .
      929       define variable v-idx-field-qnty as integer   no-undo .
      930       define variable v-field-name     as character no-undo .
      931       define variable v-field-val      as character no-undo .
      932       define variable v-word-link      as character no-undo .
      933       define variable vTable           as character no-undo.
      934       define variable bh_tbl-key       as handle    no-undo .
      935       assign
      936         p-key-rec = trim( p-key-rec )
      937       .
      938       if p-key-handle <> ? then do:
      939         if not valid-handle(p-key-handle)
      940            or p-key-handle:type <> "buffer"
      941         then do:
      942           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      943         end.
      944         if num-entries( p-key-rec, chr(3) ) > 1
      945           or p-key-rec = ?
      946           or p-key-rec = "":U
      947         then do:
      948           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      949         end.
      950       end.
      951       else do:
      952         if p-key-rec = ?
      953           or p-key-rec = "":U
      954         then do:
      955           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      956         end.
      957       end.
      958       assign
      959         vTable = entry( 1 , p-key-rec, chr(3) )
      960       .
      961       if p-tt-handle <> ?
      962         and ( not valid-handle(p-tt-handle)
      963               or p-tt-handle:type <> "buffer"
      964             )
      965       then do:
      966         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      967       end.
      968       if p-tt-handle = ? then do:
      969         assign
      970           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      971         .
      972         create buffer bh_tbl-name for table v-full-tbl-name .
      973       end.
      974       else do:
      975         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      976       end.
      977       assign
      978         v-inform = bh_tbl-name:index-information(1)
      979         v-ind    = 2
      980       .
      981       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      982       on error undo, return error
      983       :
      984         assign
      985           v-inform = bh_tbl-name:index-information( v-ind )
      986           v-ind    = v-ind + 1
      987         .
      988       end.
      989       if v-inform = ?
      990         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      991         or entry( 3, v-inform, ",":U ) <> "1":U
      992       then do:
      993         delete object bh_tbl-name no-error.
      994         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      995       end.
      996       assign
      997         v-idx-field-qnty = num-entries( v-inform ) - 4
      998       .
      999       if v-idx-field-qnty < 2 then do:
     1000         delete object bh_tbl-name no-error.
     1001         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
     1002       end.
     1003       assign
     1004         o-where     = "where":U
     1005         v-word-link = "":U
     1006         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1007         v-count-fld = 0
     1008       .
     1009       if i-tablekey ne "" and i-tablekey ne ?
     1010       then do:
     1011         assign
     1012           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1013         .
     1014         create buffer bh_tbl-key for table v-full-tbl-name .
     1015       end.
     1016       if i-tableSerach ne "" and i-tableSerach ne ?
     1017       then do:
     1018         delete object bh_tbl-name no-error.
     1019         assign
     1020           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1021         .
     1022         create buffer bh_tbl-name for table v-full-tbl-name .
     1023       end.
     1024       block_where:
     1025       do v-ind = 1 to v-idx-field-qnty by 2
     1026       on error undo, return error
     1027       :
     1028         assign
     1029           v-count-fld = v-count-fld + 1
     1030         .
     1031         if p-key-handle = ?
     1032           and v-count-fld > v-field-num
     1033         then do:
     1034           leave block_where.
     1035         end.
     1036         define variable VfieldKeyTable as handle no-undo.
     1037         assign
     1038           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1039           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1040         .
     1041         if     bh_tbl-key ne ?
     1042         then do:
     1043            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1044            if VfieldKeyTable eq ?
     1045            then next block_where.
     1046         end.
     1047         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1048         then
     1049            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1050         else
     1051            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1052         if p-key-handle = ? then do:
     1053           assign
     1054             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1055           .
     1056         end.
     1057         else do:
     1058           assign
     1059             fh_key = p-key-handle:buffer-field( v-field-name )
     1060           .
     1061           if fh_key = ?
     1062             or not valid-handle( fh_key )
     1063           then do:
     1064             delete object bh_tbl-name.
     1065             if     bh_tbl-key ne ?
     1066             then
     1067                delete object bh_tbl-key.
     1068             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
     1069           end.
     1070           assign
     1071             v-field-val = fh_key:buffer-value
     1072           .
     1073         end.
     1074         if fh_search:data-type ="character":U then do:
     1075           assign
     1076             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1077             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1078             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1079             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1080             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1081             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1082             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1083             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1084             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1085             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1086             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1087             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1088             v-field-val = substitute( '"&1"', v-field-val )
     1089           .
     1090         end.
     1091         assign
     1092           o-where = substitute( "&1 &2", o-where, v-field-val )
     1093         .
     1094         if v-word-link = "":U then do:
     1095           assign
     1096             v-word-link = "and":U
     1097           .
     1098         end.
     1099       end.
     1100       delete object bh_tbl-name.
     1101       if     bh_tbl-key ne ?
     1102       then
     1103          delete object bh_tbl-key.
     1104       if p-key-handle = ?
     1105         and v-count-fld <> v-field-num
     1106       then do:
     1107         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
     1108       end.
     1109     end.
     1110   end procedure.
     1111   procedure gen-hn-keyr-tab :
     1112     define input  parameter i-tableSerach as character no-undo.
     1113     define input  parameter i-tablekey   as character no-undo.
     1114     define input  parameter p-key-rec    as character no-undo.
     1115     define input  parameter p-key-handle as handle    no-undo .
     1116     define input  parameter p-db-name    as character no-undo .
     1117     define input  parameter p-tt-handle  as handle    no-undo .
     1118     define input  parameter p-stts-lock  as integer   no-undo .
     1119     define output parameter o-hn         as handle    no-undo.
     1120     define variable v-full-tbl-name as character no-undo.
     1121     define variable v-where         as character no-undo.
     1122     define variable bh_tbl-name     as handle    no-undo.
     1123     define variable vTable          as character no-undo.
     1124     do
     1125     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1126     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1127     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1128         run gen-where-keyr-tab(i-tableSerach,
     1129                                i-tablekey,
     1130                                p-key-rec,
     1131                                p-key-handle,
     1132                                p-db-name,
     1133                                p-tt-handle,
     1134                                output v-where).
     1135         if i-tableSerach ne "" and i-tableSerach ne ?
     1136         then do:
     1137            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1138            create buffer bh_tbl-name for table v-full-tbl-name .
     1139         end.
     1140         else do:
     1141            if p-tt-handle = ? then do:
     1142               assign
     1143                  vTable = entry( 1 , p-key-rec, chr(3) )
     1144               .
     1145               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1146               create buffer bh_tbl-name for table v-full-tbl-name .
     1147            end.
     1148            else do:
     1149               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1150            end.
     1151         end.
     1152         if p-tt-handle = ? then do:
     1153            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1154         end.
     1155         else do:
     1156            bh_tbl-name:find-first( v-where ) no-error .
     1157         end.
     1158         o-hn = bh_tbl-name.
     1159      end.
     1160   end procedure.
     1161   procedure gen-hn-keyr :
     1162     define input  parameter p-key-rec    as character no-undo.
     1163     define input  parameter p-key-handle as handle    no-undo .
     1164     define input  parameter p-db-name    as character no-undo .
     1165     define input  parameter p-tt-handle  as handle    no-undo .
     1166     define input  parameter p-stts-lock  as integer   no-undo .
     1167     define output parameter o-hn         as handle    no-undo.
     1168     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1169   end.
     1170   procedure gen-row-keyr :
     1171     define input  parameter p-key-rec    as character no-undo.
     1172     define input  parameter p-key-handle as handle    no-undo .
     1173     define input  parameter p-db-name    as character no-undo .
     1174     define input  parameter p-tt-handle  as handle    no-undo .
     1175     define input  parameter p-stts-lock  as integer   no-undo .
     1176     define output parameter p-tbl-row    as rowid     no-undo.
     1177     define output parameter p-tbl-name   as character no-undo.
     1178     define variable vHn as handle no-undo.
     1179       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1180       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1181       p-tbl-name =  vHn:table.
     1182       delete object vHn no-error.
     1183     if p-tbl-row = ? then do:
     1184       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
     1185     end.
     1186     else do:
     1187       return.
     1188     end.
     1189   end procedure.
     1190   procedure gen-key-fv :
     1191     define input  parameter p-key-rec    as character no-undo .
     1192     define output parameter p-field-list as character no-undo .
     1193     define output parameter p-value-list as character no-undo.
     1194     do
     1195     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1196     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1197     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1198     :
     1199       define variable v-full-tbl-name  as character no-undo .
     1200       define variable bh_tbl-name      as handle    no-undo .
     1201       define variable v-tbl-name       as character no-undo .
     1202       define variable v-field-num      as integer   no-undo .
     1203       define variable v-count-fld      as integer   no-undo .
     1204       define variable v-inform         as character no-undo .
     1205       define variable v-ind            as integer   no-undo .
     1206       define variable v-idx-field-qnty as integer   no-undo .
     1207       define variable v-delim-key      as character no-undo .
     1208       if p-key-rec = ?
     1209         or p-key-rec = "":U
     1210       then do:
     1211         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
     1212       end.
     1213       assign
     1214         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1215         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1216       .
     1217       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1218       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
     1219       assign
     1220         v-inform = bh_tbl-name:index-information(1)
     1221         v-ind    = 2
     1222       .
     1223       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1224       on error undo, return error
     1225       :
     1226         assign
     1227           v-inform = bh_tbl-name:index-information( v-ind )
     1228           v-ind    = v-ind + 1
     1229         .
     1230       end.
     1231       if v-inform = ?
     1232         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1233         or entry( 3, v-inform, ",":U ) <> "1":U
     1234       then do:
     1235         delete object bh_tbl-name no-error.
     1236         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1237       end.
     1238       assign
     1239         v-idx-field-qnty = num-entries( v-inform ) - 4
     1240       .
     1241       if v-idx-field-qnty < 2 then do:
     1242         delete object bh_tbl-name no-error.
     1243         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1244       end.
     1245       assign
     1246         p-field-list = "":U
     1247         p-value-list = "":U
     1248         v-delim-key  = "":U
     1249         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1250         v-count-fld  = 0
     1251       .
     1252       block_where:
     1253       do v-ind = 1 to v-idx-field-qnty by 2
     1254       on error undo, return error
     1255       :
     1256         assign
     1257           v-count-fld = v-count-fld + 1
     1258         .
     1259         if v-count-fld > v-field-num then do:
     1260           leave block_where.
     1261         end.
     1262         assign
     1263           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1264           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1265         .
     1266         if v-ind = 1 then do:
     1267           assign
     1268             v-delim-key = chr(3)
     1269           .
     1270         end.
     1271       end.
     1272       delete object bh_tbl-name.
     1273       if v-count-fld <> v-field-num then do:
     1274         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
     1275       end.
     1276     end.
     1277   end procedure.
     1278   procedure gen-key-field :
     1279     define input  parameter p-table      as character no-undo .
     1280     define output parameter p-field-list as character no-undo .
     1281     do
     1282     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1283     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1284     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1285     :
     1286       define variable v-full-tbl-name  as character no-undo .
     1287       define variable bh_tbl-name      as handle    no-undo .
     1288       define variable v-tbl-name       as character no-undo .
     1289       define variable v-field-num      as integer   no-undo .
     1290       define variable v-count-fld      as integer   no-undo .
     1291       define variable v-inform         as character no-undo .
     1292       define variable v-ind            as integer   no-undo .
     1293       define variable v-idx-field-qnty as integer   no-undo .
     1294       define variable v-delim-key      as character no-undo .
     1295       if p-table = ?
     1296         or p-table = "":U
     1297       then do:
     1298         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1299       end.
     1300       assign
     1301         v-tbl-name      = p-table
     1302         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1303       .
     1304       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1305       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1306       assign
     1307         v-inform = bh_tbl-name:index-information(1)
     1308         v-ind    = 2
     1309       .
     1310       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1311       on error undo, return error
     1312       :
     1313         assign
     1314           v-inform = bh_tbl-name:index-information( v-ind )
     1315           v-ind    = v-ind + 1
     1316         .
     1317       end.
     1318       if v-inform = ?
     1319         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1320         or entry( 3, v-inform, ",":U ) <> "1":U
     1321       then do:
     1322         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1323       end.
     1324       assign
     1325         v-idx-field-qnty = num-entries( v-inform ) - 4
     1326       .
     1327       if v-idx-field-qnty < 2 then do:
     1328         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1329       end.
     1330       assign
     1331         p-field-list = "":U
     1332         v-delim-key  = "":U
     1333         v-count-fld  = 0
     1334       .
     1335       block_where:
     1336       do v-ind = 1 to v-idx-field-qnty by 2
     1337       on error undo, return error
     1338       :
     1339         assign
     1340           v-count-fld = v-count-fld + 1
     1341         .
     1342         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1343         if v-ind = 1 then do:
     1344           assign
     1345             v-delim-key = chr(3)
     1346           .
     1347         end.
     1348       end.
     1349       delete object bh_tbl-name.
     1350     end.
     1351   end procedure.
     1352   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1353   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1354   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1355   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1356   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1357   ASSIGN
     1358      v-S_CONTRACT                = "Contract":U
     1359      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1360      v-DELIM_CHR_3               = ","
     1361      .
     1362   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1363   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1364   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1365   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1366      INPUT iHost-Code    AS INTEGER,
     1367      INPUT iContract-Num AS INTEGER,
     1368      INPUT iGds-Code     AS INTEGER ):
     1369      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1370      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1371      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1372      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1373      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1374      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1375          INPUT  iHost-Code,
     1376          INPUT  iContract-Num,
     1377          OUTPUT iTmp-Extent3
     1378          ).
     1379      IF iTmp-Extent3[1] = 2 THEN DO:
     1380         ASSIGN
     1381            iTmp-Host-Code      = iTmp-Extent3[2]
     1382            iTmp-Contract-Num   = iTmp-Extent3[3]
     1383            .
     1384      END. ELSE DO:
     1385         ASSIGN
     1386            iTmp-Host-Code      = iHost-Code
     1387            iTmp-Contract-Num   = iContract-Num
     1388            .
     1389      END.
     1390      IF iGds-Code = ? THEN DO:
     1391         ASSIGN
     1392            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1393                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1394                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1395                           ).
     1396      END. ELSE DO:
     1397            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1398                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1399                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1400                              AND buf_Spec.Gds-Code      = iGds-Code
     1401                            ).
     1402      END.
     1403      RETURN (lRet).
     1404   END FUNCTION.
     1405   PROCEDURE MS-Contract-EXTENT-3:
     1406      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1407      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1408      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1409      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1410      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1411      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1412      FIND FIRST buf_Cont-2 WHERE
     1413                 buf_Cont-2.Host-Code      = i-Host-Code
     1414             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1415           NO-LOCK NO-ERROR.
     1416      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1417         RETURN.
     1418      END.
     1419      FOR FIRST buf_Ext-Classif WHERE
     1420                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1421           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1422                                               STRING(i-Contract-code)
     1423           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1424          NO-LOCK,
     1425          EACH buf_Cont WHERE
     1426               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1427           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1428          NO-LOCK:
     1429          ASSIGN
     1430             i-Ret[1] = 1
     1431             i-Ret[2] = buf_Cont.Host-code
     1432             i-Ret[3] = buf_Cont.Contract-code
     1433             .
     1434          LEAVE.
     1435      END.
     1436      IF i-Ret[1] <> 1 THEN DO:
     1437         FOR FIRST buf_Ext-Classif WHERE
     1438                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1439              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1440                                                  STRING(i-Contract-code)
     1441              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1442             NO-LOCK,
     1443             EACH buf_Cont WHERE
     1444                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1445              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1446             NO-LOCK:
     1447             ASSIGN
     1448                i-Ret[1] = 2
     1449                i-Ret[2] = buf_Cont.Host-code
     1450                i-Ret[3] = buf_Cont.Contract-code
     1451                .
     1452             LEAVE.
     1453         END.
     1454      END.
     1455      RETURN.
     1456   END PROCEDURE.
     1457   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1458   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
     1459   FUNCTION Get-Contract-Attr RETURN CHARACTER(
     1460            INPUT iHost-Code AS INTEGER,
     1461            INPUT iContract-Code  AS INTEGER,
     1462            INPUT cAttr-code      AS CHARACTER):
     1463      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
     1464      FIND FIRST buf_Contract-Attr WHERE
     1465                 buf_Contract-Attr.Host-code     = iHost-Code
     1466             AND buf_Contract-Attr.Contract-code = iContract-Code
     1467             AND buf_Contract-Attr.Attr-code     = cAttr-code
     1468           NO-LOCK NO-ERROR.
     1469      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
     1470   END FUNCTION.
     1471   PROCEDURE Modify-Contract-Attr:
     1472      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1473      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1474      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1475      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1476      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1477      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1478      Tran:
     1479      DO TRANSACTION
     1480         ON ENDKEY UNDO Tran, RETRY Tran
     1481         ON ERROR  UNDO Tran, RETRY Tran
     1482         ON QUIT   UNDO Tran, RETRY Tran
     1483         ON STOP   UNDO Tran, RETRY Tran:
     1484         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1485         FIND FIRST buf_Contract-Attr WHERE
     1486                    buf_Contract-Attr.Host-Code      = iHost-Code
     1487                AND buf_Contract-Attr.Contract-Code  = iContract-Code
     1488                AND buf_Contract-Attr.Attr-code      = cAttr-code
     1489              NO-LOCK NO-ERROR.
     1490         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
     1491            CREATE buf_Contract-Attr NO-ERROR.
     1492            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1493         END. ELSE DO:
     1494            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
     1495            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1496         END.
     1497         ASSIGN
     1498            buf_Contract-Attr.Host-Code      = iHost-Code
     1499            buf_Contract-Attr.Contract-Code  = iContract-Code
     1500            buf_Contract-Attr.Attr-code      = cAttr-code
     1501            buf_Contract-Attr.Attr-value     = cAttr-value
     1502            NO-ERROR.
     1503         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1504         RELEASE buf_Contract-Attr NO-ERROR.
     1505         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1506      END.
     1507      RETURN.
     1508   END PROCEDURE.
     1509   PROCEDURE Create-Contract-Attr:
     1510      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1511      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1512      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1513      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1514      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1515      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1516      Tran:
     1517      DO TRANSACTION
     1518         ON ENDKEY UNDO Tran, RETRY Tran
     1519         ON ERROR  UNDO Tran, RETRY Tran
     1520         ON QUIT   UNDO Tran, RETRY Tran
     1521         ON STOP   UNDO Tran, RETRY Tran:
     1522         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1523         CREATE buf_Contract-Attr NO-ERROR.
     1524         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1525         ASSIGN
     1526            buf_Contract-Attr.Host-Code      = iHost-Code
     1527            buf_Contract-Attr.Contract-Code  = iContract-Code
     1528            buf_Contract-Attr.Attr-code      = cAttr-code
     1529            buf_Contract-Attr.Attr-value     = cAttr-value
     1530            NO-ERROR.
     1531         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1532         RELEASE buf_Contract-Attr NO-ERROR.
     1533         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1534      END.
     1535      RETURN.
     1536   END PROCEDURE.
     1537   FUNCTION Is-MS-Contract RETURN LOGICAL(BUFFER buf_Master FOR ub.Contract, BUFFER buf_Slave  FOR ub.Contract) FORWARD.
     1538   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1539   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1540   PROCEDURE Delete-Contract-Specif:
     1541      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
     1542      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1543      DEFINE BUFFER buf_Specif      FOR ub.Contract-Specif.
     1544      DEFINE BUFFER buf_Specif-Attr FOR ub.Contract-Specif-Attr.
     1545      Tran:
     1546      DO TRANSACTION
     1547         ON ENDKEY UNDO Tran, RETRY Tran
     1548         ON ERROR  UNDO Tran, RETRY Tran
     1549         ON QUIT   UNDO Tran, RETRY Tran
     1550         ON STOP   UNDO Tran, RETRY Tran:
     1551         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1552         FOR EACH buf_Specif-Attr WHERE
     1553                  buf_Specif-Attr.Host-code     = buf_Contract.Host-code
     1554              AND buf_Specif-Attr.Contract-Num  = buf_Contract.Contract-code
     1555             EXCLUSIVE-LOCK:
     1556             DELETE buf_Specif-Attr NO-ERROR.
     1557             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1558         END.
     1559         FOR EACH buf_Specif WHERE
     1560                  buf_Specif.Host-code     = buf_Contract.Host-code
     1561              AND buf_Specif.Contract-Num  = buf_Contract.Contract-code
     1562             EXCLUSIVE-LOCK:
     1563             DELETE buf_Specif NO-ERROR.
     1564            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1565         END.
     1566      END.
     1567      RETURN.
     1568   END PROCEDURE.
     1569   PROCEDURE Modify-Slave-Contract:
     1570      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1571      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1572      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1573      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1574      Tran:
     1575      DO TRANSACTION
     1576         ON ENDKEY UNDO Tran, RETRY Tran
     1577         ON ERROR  UNDO Tran, RETRY Tran
     1578         ON QUIT   UNDO Tran, RETRY Tran
     1579         ON STOP   UNDO Tran, RETRY Tran:
     1580         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1581         FOR EACH buf_Ext-Classif WHERE
     1582                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1583              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1584              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1585             NO-LOCK,
     1586             FIRST buf_Slave WHERE
     1587                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1588               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1589             EXCLUSIVE-LOCK:
     1590             BUFFER-COPY
     1591               buf_Master
     1592             EXCEPT
     1593               Host-code                               Contract-code                           Own-name                                an-uchet-code-out                       cel-nazn-code-out                       cor-acc-out                             cor-acc1-out                            an-uchet-code-in                        cel-nazn-code-in                        cor-acc-in                              cor-acc1-in                             an-uchet-code-out-cash                  cel-nazn-code-out-cash                  cor-acc-out-cash                        cor-acc1-out-cash                       an-uchet-code-in-cash                   cel-nazn-code-in-cash                   cor-acc-in-cash                         cor-acc1-in-cash                        an-uchet-code-out-payoff                cel-nazn-code-out-payoff                cor-acc-out-payoff                      cor-acc1-out-payoff                     an-uchet-code-in-payoff                 cel-nazn-code-in-payoff                 cor-acc-in-payoff                       cor-acc1-in-payoff                      transport-cli-type                      transport-cli-code                      transport-host                          transport-contract                      transport-uslov                         transport-value                         own-code-schet-start                    own-sign-post                           own-sign                                contract-city                           fin-VAT-pc                              srok-opl                                gen-factur-srok                         own-addres                              own-inn                                 own-kpp
     1594             TO buf_Slave
     1595             NO-ERROR.
     1596             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1597             RELEASE buf_Slave NO-ERROR.
     1598             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1599         END.
     1600      END.
     1601      RETURN.
     1602   END PROCEDURE.
     1603   PROCEDURE Change-Stat-Slave-Contract:
     1604      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1605      DEFINE INPUT PARAMETER cStatus  AS CHARACTER NO-UNDO.
     1606      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1607      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1608      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1609      Tran:
     1610      DO TRANSACTION
     1611         ON ENDKEY UNDO Tran, RETRY Tran
     1612         ON ERROR  UNDO Tran, RETRY Tran
     1613         ON QUIT   UNDO Tran, RETRY Tran
     1614         ON STOP   UNDO Tran, RETRY Tran:
     1615         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1616         FOR EACH buf_Ext-Classif WHERE
     1617                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1618              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1619              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1620             NO-LOCK,
     1621             FIRST buf_Slave WHERE
     1622                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1623               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1624             EXCLUSIVE-LOCK:
     1625             ASSIGN
     1626                buf_Slave.Status_ = cStatus
     1627                NO-ERROR.
     1628             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1629             RELEASE buf_Slave NO-ERROR.
     1630             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1631         END.
     1632      END.
     1633      RETURN.
     1634   END PROCEDURE.
     1635   PROCEDURE Delete-Ref-Master-Slave:
     1636      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1637      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1638      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1639      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1640      IF NOT Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1641         cError = PROGRAM-NAME(1) + ":" + "Между договорами нет связи Master->Slave".
     1642         RETURN.
     1643      END.
     1644      Tran:
     1645      FOR FIRST buf_Ext-Classif WHERE
     1646                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1647            AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1648            AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1649            AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1650          EXCLUSIVE-LOCK
     1651          TRANSACTION
     1652          ON ENDKEY UNDO Tran, RETRY Tran
     1653          ON ERROR  UNDO Tran, RETRY Tran
     1654          ON QUIT   UNDO Tran, RETRY Tran
     1655          ON STOP   UNDO Tran, RETRY Tran:
     1656          IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1657          DELETE buf_Ext-Classif NO-ERROR.
     1658          IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1659      END.
     1660      RETURN.
     1661   END PROCEDURE.
     1662   PROCEDURE Create-Ref-Master-Slave:
     1663      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1664      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1665      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1666      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1667      DEFINE VARIABLE cKeyRec AS CHARACTER NO-UNDO INITIAL "".
     1668      IF Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1669         cError = PROGRAM-NAME(1) + ":" + "Между договорами  уже есть связь Master->Slave".
     1670         RETURN.
     1671      END.
     1672      RUN gen-key-rec IN THIS-PROCEDURE(
     1673          INPUT  v-S_CONTRACT,
     1674          INPUT  BUFFER buf_Master:HANDLE,
     1675          OUTPUT cKeyRec
     1676          ) NO-ERROR.
     1677      IF ERROR-STATUS:ERROR THEN DO:
     1678         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     1679         RETURN.
     1680      END.
     1681      Tran:
     1682      DO TRANSACTION
     1683         ON ENDKEY UNDO Tran, RETRY Tran
     1684         ON ERROR  UNDO Tran, RETRY Tran
     1685         ON QUIT   UNDO Tran, RETRY Tran
     1686         ON STOP   UNDO Tran, RETRY Tran:
     1687         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1688         CREATE buf_Ext-Classif NO-ERROR.
     1689         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1690         ASSIGN
     1691            buf_Ext-Classif.Classif-name    = v-S_CONTRACT
     1692            buf_Ext-Classif.Classif-subject = v-S_CONTRACT
     1693            buf_Ext-Classif.CharKey_One     = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1694            buf_Ext-Classif.CharKey_Two     = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1695            buf_Ext-Classif.DB-num          = buf_Master.Db-num
     1696            buf_Ext-Classif.Uniq-key-rec    = cKeyRec
     1697            NO-ERROR.
     1698         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1699         RELEASE buf_Ext-Classif NO-ERROR.
     1700         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1701      END.
     1702      RETURN.
     1703   END PROCEDURE.
     1704   FUNCTION Is-MS-Contract-Int-2 RETURN INTEGER (
     1705                                 i-Host-Code AS INTEGER,
     1706                                 i-Contract-Code AS INTEGER):
     1707      DEFINE BUFFER buf_Contract FOR ub.Contract.
     1708      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1709      FIND FIRST buf_Contract WHERE
     1710                 buf_Contract.Host-Code      = i-Host-Code
     1711             AND buf_Contract.Contract-code  = i-Contract-Code
     1712           NO-LOCK NO-ERROR.
     1713      IF AVAILABLE buf_Contract THEN DO:
     1714         ASSIGN
     1715            iRet = Is-MS-Contract-Int(BUFFER buf_Contract).
     1716      END.
     1717      RETURN (iRet).
     1718   END FUNCTION.
     1719   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract):
     1720      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1721      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1722      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1723      FOR FIRST buf_Ext-Classif WHERE
     1724                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1725           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1726                                               STRING(buf_Contract.contract-code)
     1727           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1728          NO-LOCK,
     1729          EACH buf_Cont WHERE
     1730               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1731           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1732          NO-LOCK:
     1733          ASSIGN
     1734             iRet = 1.
     1735          LEAVE.
     1736      END.
     1737      IF iRet <> 1 THEN DO:
     1738         FOR FIRST buf_Ext-Classif WHERE
     1739                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1740              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1741                                                  STRING(buf_Contract.contract-code)
     1742              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1743             NO-LOCK,
     1744             EACH buf_Cont WHERE
     1745                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1746              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1747             NO-LOCK:
     1748             ASSIGN
     1749                iRet = 2.
     1750             LEAVE.
     1751         END.
     1752      END.
     1753      RETURN (iRet).
     1754   END FUNCTION.
     1755   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract):
     1756      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1757      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1758      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1759      FOR FIRST buf_Ext-Classif WHERE
     1760                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1761           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1762                                               STRING(buf_Contract.contract-code)
     1763           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1764          NO-LOCK,
     1765          EACH buf_Cont WHERE
     1766               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1767           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1768          NO-LOCK:
     1769          ASSIGN
     1770             cRet = "+".
     1771          LEAVE.
     1772      END.
     1773      IF cRet = "" THEN DO:
     1774         FOR FIRST buf_Ext-Classif WHERE
     1775                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1776              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1777                                                  STRING(buf_Contract.contract-code)
     1778              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1779             NO-LOCK,
     1780             EACH buf_Cont WHERE
     1781                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1782              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1783             NO-LOCK:
     1784             ASSIGN
     1785                cRet = (IF buf_Cont.Contract-prn-code = "" THEN  STRING(buf_Cont.Contract-code) ELSE buf_Cont.Contract-prn-code).
     1786             LEAVE.
     1787         END.
     1788      END.
     1789      RETURN (cRet).
     1790   END FUNCTION.
     1791   FUNCTION Is-MS-Contract RETURN LOGICAL(
     1792            BUFFER buf_Master FOR ub.Contract,
     1793            BUFFER buf_Slave  FOR ub.Contract):
     1794      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1795      RETURN CAN-FIND ( FIRST buf_Ext-Classif WHERE
     1796                          buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1797                      AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1798                      AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1799                      AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1800                    NO-LOCK).
     1801   END FUNCTION.
     1802   FUNCTION Get-Num-Slave-Contract RETURN CHARACTER(
     1803            BUFFER buf_Master FOR ub.Contract,
     1804            INPUT iSlave-Host-Code AS INTEGER
     1805            ):
     1806      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1807      DEFINE BUFFER buf_Contract    FOR ub.Contract.
     1808      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1809      FIND FIRST buf_Ext-Classif WHERE
     1810                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1811             AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1812             AND buf_Ext-Classif.CharKey_Two  BEGINS STRING(iSlave-Host-Code) + v-DELIM_CHR_3
     1813             AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1814           NO-LOCK NO-ERROR.
     1815      IF AVAILABLE buf_Ext-Classif THEN DO:
     1816         IF CAN-FIND (FIRST buf_Contract WHERE
     1817                            buf_Contract.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1818                        AND buf_Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1819                       NO-LOCK) THEN DO:
     1820            ASSIGN
     1821               cRet = ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3).
     1822         END. ELSE DO:
     1823            ASSIGN
     1824               cRet = "ERROR:" + "Ошибка связи мастер договора " +
     1825                      STRING(buf_Master.Host-Code) + "," + STRING(buf_Master.Contract-code) + " " +
     1826                      "c Host-code=" + STRING(iSlave-Host-Code).
     1827         END.
     1828      END.
     1829      RETURN (cRet).
     1830   END FUNCTION.
     1831   FUNCTION PutStr RETURN LOGICAL (INPUT v-cStr AS CHARACTER, INPUT v-lSkip AS LOGICAL) FORWARD.
     1832   FUNCTION Get-Name-Org RETURN CHARACTER (INPUT cObj-type AS CHARACTER, INPUT iObj-code AS INTEGER) FORWARD.
     1833   DEFINE INPUT PARAMETER   parParentProc     AS WIDGET-HANDLE NO-UNDO.
     1834   DEFINE INPUT parameter   p-CallBack-Handle AS HANDLE        NO-UNDO.
     1835   DEFINE PARAMETER BUFFER  buf_M-Contract    FOR ub.Contract.
     1836   DEFINE PARAMETER BUFFER  buf_S-Contract    FOR ub.Contract.
     1837   DEFINE INPUT  PARAMETER  p-cMode           AS CHARACTER NO-UNDO.
     1838   DEFINE INPUT  PARAMETER  p-cList-Host      AS CHARACTER NO-UNDO.
     1839   DEFINE OUTPUT PARAMETER  p-cError          AS CHARACTER NO-UNDO.
     1840   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1841     run mainmenu_getcntxt in parparentproc
     1842       (output v-cntxt-db-num
     1843       ,output v-cntxt-userid
     1844       ,output v-cntxt-level
     1845       ,output v-cntxt-host-code-obj
     1846       ,output v-cntxt-obj-type
     1847       ,output v-cntxt-obj-code
     1848       ,output v-cntxt-db-num-obj
     1849       ,output v-cntxt-is-admin
     1850       ) .
     1851   DEFINE STREAM s_Log.
     1852   DEFINE BUFFER buf_Contract    FOR ub.Contract.
     1853   DEFINE BUFFER buf_Slave       FOR ub.Contract.
     1854   DEFINE VARIABLE v-user-action    AS CHARACTER  NO-UNDO.
     1855   DEFINE VARIABLE v-printed        AS LOGICAL    NO-UNDO.
     1856   DEFINE VARIABLE v-proc-name-err  AS CHARACTER  NO-UNDO.
     1857   DEFINE VARIABLE i                   AS INTEGER   NO-UNDO INITIAL 0.
     1858   DEFINE VARIABLE v-iNewHost          AS INTEGER   NO-UNDO INITIAL 0.
     1859   DEFINE VARIABLE v-iCountCr          AS INTEGER   NO-UNDO INITIAL 0.
     1860   DEFINE VARIABLE v-iCountRef         AS INTEGER   NO-UNDO INITIAL 0.
     1861   DEFINE VARIABLE v-iCountDel         AS INTEGER   NO-UNDO INITIAL 0.
     1862   DEFINE VARIABLE v-iMS-Contract      AS INTEGER   NO-UNDO INITIAL 0.
     1863   DEFINE VARIABLE v-lIs-Host-Cli      AS LOGICAL   NO-UNDO INITIAL FALSE.
     1864   DEFINE VARIABLE lChoice             AS LOGICAL   NO-UNDO INITIAL FALSE.
     1865   DEFINE VARIABLE cTmp                AS CHARACTER NO-UNDO INITIAL "".
     1866   DEFINE VARIABLE v-Rid-List          AS CHARACTER NO-UNDO INITIAL "".
     1867   DEFINE VARIABLE v-IsOk              AS LOGICAL   NO-UNDO INITIAL FALSE.
     1868   IF NOT CAN-DO("add,del":U, p-cMode) THEN DO:
     1869      p-cError = PROGRAM-NAME(1) + " Неверно задан режим p-cMode = " + p-cMode.
     1870      RETURN.
     1871   END.
     1872   IF p-cMode = "add":U AND ( p-cList-Host = "" OR p-cList-Host = ? )THEN DO:
     1873      p-cError = PROGRAM-NAME(1) + " Не задан список фирм p-cList-Host".
     1874      RETURN.
     1875   END.
     1876   v-proc-name-err = STRING(SESSION:TEMP-DIRECTORY) + "ContractSlave.log":U.
     1877   IF SEARCH(v-proc-name-err) <> ? THEN DO:
     1878      OS-DELETE VALUE(v-proc-name-err).
     1879   END.
     1880   OUTPUT STREAM s_Log TO VALUE(v-Proc-Name-Err).
     1881   CASE p-cMode:
     1882      WHEN "add":U THEN DO:
     1883         Label-do:
     1884         DO i = 1 TO NUM-ENTRIES(p-cList-Host):
     1885            ASSIGN
     1886               v-iNewHost     = INTEGER(ENTRY(i, p-cList-Host))
     1887               v-lIs-Host-Cli = FALSE
     1888               NO-ERROR.
     1889            IF ERROR-STATUS:ERROR THEN DO:
     1890               MESSAGE "Такого быть не может !" SKIP
     1891                 PROGRAM-NAME(1) SKIP
     1892                 ERROR-STATUS:GET-MESSAGE(1)
     1893                 VIEW-AS ALERT-BOX INFO BUTTONS OK.
     1894                 NEXT Label-do.
     1895            END.
     1896            IF INTEGER(ENTRY(i, p-cList-Host)) = buf_M-Contract.Host-code THEN DO:
     1897               NEXT Label-do.
     1898            END.
     1899            ASSIGN
     1900               cTmp = Get-Num-Slave-Contract(BUFFER buf_M-Contract, v-iNewHost).
     1901            IF cTmp BEGINS "ERROR" THEN DO:
     1902               ASSIGN
     1903                  p-cError = cTmp.
     1904               PutStr(p-cError, TRUE).
     1905               LEAVE Label-do.
     1906            END.
     1907            IF cTmp <> "" THEN DO:
     1908               NEXT Label-do.
     1909            END.
     1910   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1911   do:
     1912     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1913       (input  v-cntxt-db-num
     1914       ,input  v-cntxt-userid
     1915       ,input  0
     1916       ,input  'actn_fo-mc_slave-add-del':U
     1917       ,input  'firm':U
     1918       ,input  v-iNewHost
     1919       ,input  ''
     1920       ,input  0
     1921       ,input  0
     1922       ,input  0
     1923       ,input  0
     1924       ,input  true
     1925       ,output v-IsOk
     1926       ) no-error .
     1927   end.
     1928            IF ERROR-STATUS:ERROR THEN DO:
     1929               ASSIGN
     1930                  v-IsOk = FALSE.
     1931            END.
     1932            IF NOT v-IsOk THEN DO:
     1933               ASSIGN
     1934                  p-cError = RETURN-VALUE.
     1935               PutStr(p-cError, TRUE).
     1936               LEAVE Label-do.
     1937            END.
     1938            Label-for:
     1939            REPEAT
     1940            PRESELECT   EACH buf_Contract WHERE
     1941                     buf_Contract.Host-Code = v-iNewHost
     1942                 AND buf_Contract.Cli-type  = buf_M-Contract.Cli-type
     1943                 AND buf_Contract.Cli-code  = buf_M-Contract.Cli-code
     1944                 AND buf_Contract.Status_   <> 'зкр':U
     1945                 NO-LOCK:
     1946                 FIND NEXT buf_Contract.
     1947                 ASSIGN
     1948                    v-iMS-Contract = Is-MS-Contract-Int(BUFFER buf_Contract).
     1949                 CASE v-iMS-Contract:
     1950                      WHEN 0 THEN DO:
     1951                           MESSAGE
     1952                              "У фирмы " v-iNewHost Get-Name-Org('орг':U, v-iNewHost ) SKIP
     1953                              "существует текущий договор с контрагентом  " SKIP
     1954                              buf_M-Contract.Cli-type buf_M-Contract.Cli-code buf_M-Contract.Cli-name
     1955                                SKIP
     1956                              " " SKIP
     1957                              "Создать новый или привязать существующий ? " SKIP
     1958                              "" SKIP
     1959                              "Да  - Создать новый договор" SKIP
     1960                              "Нет - Привязать существующий" SKIP
     1961                              "Отмена - Ничего не делать по этой фирме" SKIP
     1962                              VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO-CANCEL
     1963                              TITLE "Что делать?"
     1964                              UPDATE lChoice.
     1965                           CASE lChoice:
     1966                                WHEN ? THEN DO:
     1967                                     NEXT Label-do.
     1968                                END.
     1969                                WHEN TRUE THEN DO:
     1970                                     RUN Create-New-Contract IN THIS-PROCEDURE(
     1971                                         BUFFER buf_M-Contract,
     1972                                         INPUT v-iNewHost,
     1973                                         INPUT-OUTPUT v-iCountCr,
     1974                                         OUTPUT p-cError
     1975                                         ).
     1976                                     IF p-cError <> "" THEN DO:
     1977                                        LEAVE Label-do.
     1978                                     END. ELSE DO:
     1979                                        NEXT Label-do.
     1980                                     END.
     1981                                END.
     1982                                WHEN FALSE THEN DO:
     1983                                     RUN str/cont-all.w (
     1984                                         INPUT parParentProc
     1985                                        ,INPUT v-iNewHost
     1986                                        ,INPUT "b-sel"
     1987                                        ,INPUT 'фирма':U + "|0"
     1988                                        ,INPUT buf_M-Contract.cli-type
     1989                                        ,INPUT buf_M-Contract.Cli-code
     1990                                        ,INPUT ?
     1991                                        ,INPUT ?
     1992                                        ,INPUT "current"
     1993                                        ,INPUT 'при':U
     1994                                        ,INPUT-OUTPUT v-rid-list)
     1995                                        .
     1996                                     IF v-rid-list = "" OR v-rid-list = ? THEN DO:
     1997                                         PutStr("Отказ от выбора подчиненного договора в интерфейсе str/cont-all.w", TRUE).
     1998                                         NEXT Label-do.
     1999                                     END.
     2000                                     FIND FIRST buf_Slave WHERE
     2001                                                RECID(buf_Slave) = INTEGER(v-Rid-List)
     2002                                          NO-LOCK NO-ERROR.
     2003                                     IF NOT AVAILABLE buf_Slave THEN DO:
     2004                                        PutStr("NOT AVAILABLE buf_Slave RECID(buf_Slave)=" + STRING(v-Rid-List) , TRUE).
     2005                                        LEAVE Label-do.
     2006                                     END.
     2007                                     RUN Ref-New-Contract IN THIS-PROCEDURE(
     2008                                         BUFFER buf_M-Contract,
     2009                                         BUFFER buf_Slave,
     2010                                         INPUT-OUTPUT v-iCountRef,
     2011                                         OUTPUT p-cError
     2012                                         ).
     2013                                     IF p-cError <> "" THEN DO:
     2014                                        LEAVE Label-do.
     2015                                     END. ELSE DO:
     2016                                        NEXT Label-do.
     2017                                     END.
     2018                                END.
     2019                           END CASE.
     2020                      END.
     2021                      WHEN 1 THEN DO:
     2022                           NEXT Label-for.
     2023                      END.
     2024                      WHEN 2 THEN DO:
     2025                           NEXT Label-for.
     2026                      END.
     2027                      OTHERWISE DO:
     2028                           NEXT Label-for.
     2029                      END.
     2030                 END CASE.
     2031                 ASSIGN
     2032                    v-lIs-Host-Cli = TRUE.
     2033            END.
     2034            IF NOT v-lIs-Host-Cli THEN DO:
     2035               RUN Create-New-Contract IN THIS-PROCEDURE(
     2036                   BUFFER buf_M-Contract,
     2037                   INPUT v-iNewHost,
     2038                   INPUT-OUTPUT v-iCountCr,
     2039                   OUTPUT p-cError
     2040                   ).
     2041               IF p-cError <> "" THEN DO:
     2042                  LEAVE Label-do.
     2043               END. ELSE DO:
     2044                  NEXT Label-do.
     2045               END.
     2046            END.
     2047         END.
     2048      END.
     2049      WHEN "del":U THEN DO:
     2050         RUN Close-Slave-Contract IN THIS-PROCEDURE (
     2051                BUFFER buf_M-Contract,
     2052                BUFFER buf_S-Contract,
     2053                INPUT-OUTPUT v-iCountDel,
     2054                OUTPUT p-cError
     2055                ).
     2056      END.
     2057   END CASE.
     2058   IF v-iCountCr <> 0 THEN DO:
     2059      PutStr("Всего созданных договоров: " + STRING(v-iCountCr), TRUE).
     2060   END.
     2061   IF v-iCountRef <> 0 THEN DO:
     2062      PutStr("Всего привязанных договоров: " + STRING(v-iCountRef), TRUE).
     2063   END.
     2064   IF v-iCountDel <> 0 THEN DO:
     2065      PutStr("Всего удаленных (закрытых договоров) : " + STRING(v-iCountDel), TRUE).
     2066   END.
     2067   OUTPUT STREAM s_Log CLOSE.
     2068   IF p-cError = "" THEN DO:
     2069      IF p-cMode = "add":U THEN DO:
     2070         MESSAGE
     2071            "Всего созданных договоров   : " v-iCountCr    SKIP
     2072            "Всего привязанных договоров : " v-iCountRef   SKIP
     2073             VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2074      END. ELSE DO:
     2075         MESSAGE
     2076            "Всего удаленных (закрытых договоров) : " v-iCountDel   SKIP
     2077             VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2078      END.
     2079   END. ELSE DO:
     2080      IF SEARCH (v-proc-name-err) <> ? THEN DO:
     2081         RUN gbl/prnfilen.w (
     2082             input  "Протокол работы процедуры:":U + vss-workfile
     2083            ,input  0
     2084            ,input  v-proc-name-err
     2085            ,input  7
     2086            ,output v-user-action
     2087            ,output v-printed
     2088            ).
     2089      END.
     2090   END.
     2091   RETURN.
     2092   PROCEDURE Close-Slave-Contract:
     2093      DEFINE PARAMETER BUFFER  buf_Master    FOR ub.Contract.
     2094      DEFINE PARAMETER BUFFER  buf_Slave     FOR ub.Contract.
     2095      DEFINE INPUT-OUTPUT PARAMETER v-iCount AS INTEGER NO-UNDO.
     2096      DEFINE OUTPUT PARAMETER  p-cError      AS CHARACTER NO-UNDO INITIAL "".
     2097      DEFINE BUFFER buf_Mod-Slave FOR ub.Contract.
     2098      DEFINE VARIABLE lChoice AS LOGICAL NO-UNDO INITIAL FALSE.
     2099      DEFINE VARIABLE v-iUser-Db-Num AS INTEGER   NO-UNDO INITIAL 0.
     2100      DEFINE VARIABLE v-cUser-Name   AS CHARACTER NO-UNDO INITIAL "".
     2101      DEFINE VARIABLE v-Sys-Date     AS DATE      NO-UNDO INITIAL ?.
     2102      DEFINE VARIABLE v-Sys-Time     AS CHARACTER NO-UNDO INITIAL "".
     2103      DEFINE VARIABLE v-Sys-Time-Int AS INTEGER   NO-UNDO INITIAL 0.
     2104      IF NOT AVAILABLE buf_Master THEN DO:
     2105         ASSIGN
     2106            p-cError = PROGRAM-NAME(1) + ":NOT AVAILABLE buf_Master".
     2107         RETURN.
     2108      END.
     2109      IF NOT AVAILABLE buf_Slave THEN DO:
     2110         ASSIGN
     2111            p-cError = PROGRAM-NAME(1) + ":NOT AVAILABLE buf_Slave".
     2112         RETURN.
     2113      END.
     2114      MESSAGE
     2115         "Закрыть договор №" buf_Slave.Contract-prn-code
     2116         "от" buf_Slave.contract-date "?"
     2117         VIEW-AS ALERT-BOX INFO BUTTONS YES-NO
     2118         UPDATE lChoice.
     2119      IF lChoice <> TRUE THEN DO:
     2120         RETURN.
     2121      END.
     2122   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2123   do:
     2124     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2125       (input  v-cntxt-db-num
     2126       ,input  v-cntxt-userid
     2127       ,input  0
     2128       ,input  'actn_fin-contract_deletion':U
     2129       ,input  'firm':U
     2130       ,input  buf_Slave.Host-code
     2131       ,input  '':U
     2132       ,input  0
     2133       ,input  0
     2134       ,input  0
     2135       ,input  0
     2136       ,input  true
     2137       ,output lChoice
     2138       )  .
     2139   end.
     2140      IF lChoice <> TRUE THEN DO:
     2141         RETURN.
     2142      END.
     2143      Tran:
     2144      DO TRANSACTION
     2145         ON ENDKEY UNDO Tran, RETRY Tran
     2146         ON ERROR  UNDO Tran, RETRY Tran
     2147         ON QUIT   UNDO Tran, RETRY Tran
     2148         ON STOP   UNDO Tran, RETRY Tran:
     2149         IF RETRY  THEN DO:
     2150            p-cError = p-cError + (IF p-cError = "" THEN "" ELSE "~n") +
     2151                       " Ошибка транзакции " + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     2152            PutStr(p-cError, TRUE).
     2153            UNDO Tran, LEAVE Tran.
     2154         END.
     2155         FIND FIRST buf_Mod-Slave WHERE
     2156                    RECID(buf_Mod-Slave) = RECID(buf_Slave)
     2157              EXCLUSIVE-LOCK NO-WAIT NO-ERROR.
     2158         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2159   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2160   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     2161     (output v-iUser-Db-Num
     2162     ,output v-cUser-Name
     2163     ,output v-Sys-Date
     2164     ,output v-Sys-Time
     2165     ,output v-Sys-Time-Int
     2166     )  .
     2167         ASSIGN
     2168            buf_Mod-Slave.user-db-num = v-iUser-Db-Num
     2169            buf_Mod-Slave.user-name   = v-cUser-Name
     2170            buf_Mod-Slave.Status_     = 'зкр':U
     2171            NO-ERROR.
     2172         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2173         RUN Create-Contract-Attr IN THIS-PROCEDURE(
     2174             buf_Slave.Host-code,
     2175             buf_Slave.Contract-code,
     2176             v-S_CODE_LAST_MASTER_NUM,
     2177             STRING(buf_Master.Host-code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code),
     2178             OUTPUT p-cError
     2179             ).
     2180         IF p-cError <> "" THEN DO:
     2181            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2182         END.
     2183         RUN Delete-Ref-Master-Slave IN THIS-PROCEDURE (
     2184             BUFFER buf_Master,
     2185             BUFFER buf_Slave,
     2186             OUTPUT p-cError
     2187             ).
     2188         IF p-cError <> "" THEN DO:
     2189            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2190         END.
     2191         PutStr("Закрыт " +
     2192                STRING(buf_Slave.Host-code) + "," +
     2193                STRING(buf_Slave.Contract-code) + "," +
     2194                "-" +
     2195                "Ok!",
     2196                TRUE).
     2197         ASSIGN
     2198            v-iCount = v-iCount + 1.
     2199      END.
     2200      RETURN.
     2201   END PROCEDURE.
     2202   PROCEDURE Ref-New-Contract:
     2203      DEFINE PARAMETER BUFFER  buf_Master FOR ub.Contract.
     2204      DEFINE PARAMETER BUFFER  buf_Slave  FOR ub.Contract.
     2205      DEFINE INPUT-OUTPUT PARAMETER v-iCount AS INTEGER NO-UNDO.
     2206      DEFINE OUTPUT PARAMETER  p-cError      AS CHARACTER NO-UNDO INITIAL "".
     2207      PutStr(
     2208             "Фирма " + STRING(buf_Slave.Host-code) + " " +
     2209             "Привязка договора с контрагентом " +
     2210              buf_Master.Cli-type + " " + STRING(buf_Master.Cli-code) +
     2211              "...",
     2212              FALSE
     2213              ).
     2214      Tran:
     2215      DO TRANSACTION
     2216         ON ENDKEY UNDO Tran, RETRY Tran
     2217         ON ERROR  UNDO Tran, RETRY Tran
     2218         ON QUIT   UNDO Tran, RETRY Tran
     2219         ON STOP   UNDO Tran, RETRY Tran:
     2220         IF RETRY  THEN DO:
     2221            p-cError = p-cError + (IF p-cError = "" THEN "" ELSE "~n") +
     2222                       " Ошибка транзакции " + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     2223            PutStr(p-cError, TRUE).
     2224            UNDO Tran, LEAVE Tran.
     2225         END.
     2226         RUN Create-Ref-Master-Slave IN THIS-PROCEDURE(
     2227             BUFFER buf_Master,
     2228             BUFFER buf_Slave,
     2229             OUTPUT p-cError).
     2230         IF p-cError <> "" THEN DO:
     2231            UNDO Tran, RETRY Tran.
     2232         END.
     2233         RUN Delete-Contract-Specif IN THIS-PROCEDURE(
     2234             BUFFER buf_Slave,
     2235             OUTPUT p-cError).
     2236         IF p-cError <> "" THEN DO:
     2237            UNDO Tran, RETRY Tran.
     2238         END.
     2239      END.
     2240      IF p-cError = "" THEN DO:
     2241         PutStr("Ok!", TRUE).
     2242         ASSIGN
     2243            v-iCount = v-iCount + 1.
     2244      END. ELSE DO:
     2245         PutStr("Error!" + " " + p-cError, TRUE).
     2246      END.
     2247      RETURN.
     2248   END PROCEDURE.
     2249   PROCEDURE Create-New-Contract:
     2250      DEFINE PARAMETER BUFFER  buf_M-Contract FOR ub.Contract.
     2251      DEFINE INPUT  PARAMETER  p-iNewHost      AS INTEGER NO-UNDO.
     2252      DEFINE INPUT-OUTPUT PARAMETER v-iCount   AS INTEGER NO-UNDO.
     2253      DEFINE OUTPUT PARAMETER  p-cError        AS CHARACTER NO-UNDO INITIAL "".
     2254      DEFINE BUFFER buf_Cr-Contract FOR ub.Contract.
     2255      DEFINE VARIABLE f-Code           AS INTEGER    NO-UNDO INITIAL 0.
     2256      DEFINE VARIABLE p-sys-date       AS DATE       NO-UNDO.
     2257      DEFINE VARIABLE p-sys-time       AS CHARACTER  NO-UNDO.
     2258      DEFINE VARIABLE p-sys-time-int   AS INTEGER    NO-UNDO.
     2259      PutStr(
     2260             "Фирма " + STRING(p-iNewHost) + " " +
     2261             "Создание договора с контрагентом " +
     2262              buf_M-Contract.Cli-type + " " + STRING(buf_M-Contract.Cli-code) + "...",
     2263              FALSE
     2264              ).
     2265      Tran:
     2266      DO TRANSACTION
     2267         ON ENDKEY UNDO Tran, RETRY Tran
     2268         ON ERROR  UNDO Tran, RETRY Tran
     2269         ON QUIT   UNDO Tran, RETRY Tran
     2270         ON STOP   UNDO Tran, RETRY Tran:
     2271         IF RETRY  THEN DO:
     2272            p-cError = p-cError + (IF p-cError = "" THEN "" ELSE "~n") +
     2273                       " Ошибка транзакции " + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     2274            PutStr(p-cError, TRUE).
     2275            UNDO Tran, LEAVE Tran.
     2276         END.
     2277         RUN gen-b-code IN THIS-PROCEDURE (
     2278            INPUT 'ctgb':U, OUTPUT f-code
     2279            ) NO-ERROR.
     2280         IF ERROR-STATUS:ERROR THEN DO:
     2281            p-cError = "Ошибка при генерации внутреннего № договора".
     2282            MESSAGE p-cError
     2283                VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2284            UNDO Tran, RETRY Tran.
     2285         END.
     2286         CREATE buf_Cr-Contract NO-ERROR.
     2287         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2288         BUFFER-COPY
     2289               buf_M-Contract
     2290            EXCEPT
     2291               Host-code
     2292               Contract-code
     2293               user-db-num
     2294               user-name
     2295            TO buf_Cr-Contract
     2296            ASSIGN
     2297               buf_Cr-Contract.Host-code      = p-iNewHost
     2298               buf_Cr-Contract.Contract-code  = f-Code
     2299            NO-ERROR.
     2300         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     2301   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2302   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     2303     (output buf_Cr-contract.user-db-num
     2304     ,output buf_Cr-contract.user-name
     2305     ,output p-sys-date
     2306     ,output p-sys-time
     2307     ,output p-sys-time-int
     2308     )  .
     2309         RUN Set-Param-New-Firm IN THIS-PROCEDURE (
     2310             BUFFER buf_Cr-Contract,
     2311             INPUT p-iNewHost,
     2312             OUTPUT p-cError
     2313             ).
     2314         IF p-cError <> "" THEN DO:
     2315            UNDO Tran, RETRY Tran.
     2316         END.
     2317         RUN Create-Ref-Master-Slave IN THIS-PROCEDURE(
     2318             BUFFER buf_M-Contract,
     2319             BUFFER buf_Cr-Contract,
     2320             OUTPUT p-cError).
     2321         IF p-cError <> "" THEN DO:
     2322            UNDO Tran, RETRY Tran.
     2323         END.
     2324      END.
     2325      IF p-cError = "" THEN DO:
     2326         PutStr("Ok!", TRUE).
     2327         ASSIGN
     2328            v-iCount = v-iCount + 1.
     2329      END. ELSE DO:
     2330         PutStr("Error!" + " " + p-cError, TRUE).
     2331      END.
     2332      RETURN.
     2333   END PROCEDURE.
     2334   PROCEDURE Set-Param-New-Firm:
     2335      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
     2336      DEFINE INPUT PARAMETER  iNewHost AS INTEGER   NO-UNDO.
     2337      DEFINE OUTPUT PARAMETER cError   AS CHARACTER NO-UNDO INITIAL "".
     2338      DEFINE BUFFER buf_SysConf  FOR ub.SysConf.
     2339      DEFINE BUFFER buf_Clients  FOR ub.Clients.
     2340      DEFINE BUFFER buf_Firm     FOR ub.Firm.
     2341      FIND FIRST buf_SysConf WHERE
     2342                 buf_SysConf.Host-code = iNewHost
     2343           NO-LOCK NO-ERROR.
     2344      IF NOT AVAILABLE buf_SysConf THEN DO:
     2345         ASSIGN
     2346            cError =  PROGRAM-NAME(1) + ":NOT AVAILABLE buf_SysConf.Host-code =  " + STRING(iNewHost).
     2347         RETURN.
     2348      END.
     2349      FIND FIRST buf_Clients WHERE
     2350                 buf_Clients.Obj-type = 'орг':U
     2351             AND buf_Clients.Obj-code = iNewHost
     2352           NO-LOCK NO-ERROR.
     2353      IF NOT AVAILABLE buf_Clients THEN DO:
     2354         ASSIGN
     2355            cError =  PROGRAM-NAME(1) + ":NOT AVAILABLE buf_Clients.Obj-type = 'орг':U AND AND buf_Clients.Obj-code = iNewHost = " + STRING(iNewHost).
     2356         RETURN.
     2357      END.
     2358      FIND FIRST buf_Firm WHERE
     2359                 buf_Firm.Firm-code = iNewHost
     2360           NO-LOCK NO-ERROR.
     2361      IF NOT AVAILABLE buf_Firm THEN DO:
     2362         ASSIGN
     2363            cError =  PROGRAM-NAME(1) + ": NOT AVAILABLE buf_Firm.Firm-code = " + STRING(iNewHost).
     2364         RETURN.
     2365      END.
     2366      ASSIGN
     2367         buf_Contract.Own-name                 = buf_Clients.Obj-name
     2368         buf_contract.an-uchet-code-out        = buf_sysconf.an-uchet-code-out
     2369         buf_contract.cel-nazn-code-out        = buf_sysconf.cel-nazn-code-out
     2370         buf_contract.cor-acc-out              = buf_sysconf.cor-acc-out
     2371         buf_contract.cor-acc1-out             = buf_sysconf.cor-acc1-out
     2372         buf_contract.an-uchet-code-in         = buf_sysconf.an-uchet-code-in
     2373         buf_contract.cel-nazn-code-in         = buf_sysconf.cel-nazn-code-in
     2374         buf_contract.cor-acc-in               = buf_sysconf.cor-acc-in
     2375         buf_contract.cor-acc1-in              = buf_sysconf.cor-acc1-in
     2376         buf_contract.an-uchet-code-out-cash   = buf_sysconf.an-uchet-code-out-cash
     2377         buf_contract.cel-nazn-code-out-cash   = buf_sysconf.cel-nazn-code-out-cash
     2378         buf_contract.cor-acc-out-cash         = buf_sysconf.cor-acc-out-cash
     2379         buf_contract.cor-acc1-out-cash        = buf_sysconf.cor-acc1-out-cash
     2380         buf_contract.an-uchet-code-in-cash    = buf_sysconf.an-uchet-code-in-cash
     2381         buf_contract.cel-nazn-code-in-cash    = buf_sysconf.cel-nazn-code-in-cash
     2382         buf_contract.cor-acc-in-cash          = buf_sysconf.cor-acc-in-cash
     2383         buf_contract.cor-acc1-in-cash         = buf_sysconf.cor-acc1-in-cash
     2384         buf_contract.an-uchet-code-out-payoff = buf_sysconf.an-uchet-code-out-payoff
     2385         buf_contract.cel-nazn-code-out-payoff = buf_sysconf.cel-nazn-code-out-payoff
     2386         buf_contract.cor-acc-out-payoff       = buf_sysconf.cor-acc-out-payoff
     2387         buf_contract.cor-acc1-out-payoff      = buf_sysconf.cor-acc1-out-payoff
     2388         buf_contract.an-uchet-code-in-payoff  = buf_sysconf.an-uchet-code-in-payoff
     2389         buf_contract.cel-nazn-code-in-payoff  = buf_sysconf.cel-nazn-code-in-payoff
     2390         buf_contract.cor-acc-in-payoff        = buf_sysconf.cor-acc-in-payoff
     2391         buf_contract.cor-acc1-in-payoff       = buf_sysconf.cor-acc1-in-payoff
     2392         buf_contract.transport-cli-type       = buf_sysconf.transport-cli-type
     2393         buf_contract.transport-cli-code       = buf_sysconf.transport-cli-code
     2394         buf_contract.transport-host           = buf_sysconf.transport-host
     2395         buf_contract.transport-contract       = buf_sysconf.transport-contract
     2396         buf_contract.transport-uslov          = buf_sysconf.transport-uslov
     2397         buf_contract.transport-value          = buf_sysconf.transport-value
     2398         buf_contract.own-code-schet-start     = (IF buf_sysconf.pay-code-schet-rubl > 0
     2399                                                     THEN buf_sysconf.pay-code-schet-rubl
     2400                                                     ELSE buf_contract.own-code-schet-start
     2401                                                  )
     2402         buf_contract.own-sign-post            = buf_sysconf.pay-sign-post
     2403         buf_contract.own-sign                 = buf_sysconf.pay-sign
     2404         buf_contract.contract-city            = buf_sysconf.contract-city
     2405         buf_Contract.fin-VAT-pc               = buf_sysconf.fin-VAT-pc
     2406         buf_Contract.srok-opl                 = buf_sysconf.srok-opl
     2407         buf_Contract.gen-factur-srok          = buf_sysconf.srok-opl-sf
     2408         buf_contract.own-addres               = buf_firm.addres1
     2409         buf_contract.own-inn                  = buf_firm.inn
     2410         buf_contract.own-kpp                  = buf_firm.kpp
     2411         NO-ERROR.
     2412      IF ERROR-STATUS:ERROR THEN DO:
     2413         ASSIGN
     2414            cError =  PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     2415         RETURN.
     2416      END.
     2417      RETURN.
     2418   END PROCEDURE.
     2419   FUNCTION Get-Name-Org RETURN CHARACTER (INPUT cObj-type AS CHARACTER, INPUT iObj-code AS INTEGER):
     2420      DEFINE BUFFER buf_Clients FOR ub.Clients.
     2421      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     2422      FIND FIRST buf_Clients WHERE
     2423                 buf_Clients.Obj-type = cObj-type
     2424             AND buf_Clients.Obj-code = iObj-code
     2425           NO-LOCK NO-ERROR.
     2426      IF AVAILABLE buf_Clients THEN DO:
     2427         ASSIGN
     2428            cRet = buf_Clients.Obj-name
     2429            .
     2430      END.
     2431      RETURN (cRet).
     2432   END FUNCTION.
     2433   FUNCTION PutStr RETURN LOGICAL (INPUT v-cStr AS CHARACTER, INPUT v-lSkip AS LOGICAL):
     2434       PUT STREAM s_Log UNFORMATTED v-cStr.
     2435       IF v-lSkip THEN DO:
     2436          PUT STREAM s_Log UNFORMATTED SKIP.
     2437       END.
     2438       RETURN TRUE.
     2439   END FUNCTION.
