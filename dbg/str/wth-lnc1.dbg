        1   block-level on error undo, throw.
        2   define temp-table tt-par-dtl  no-undo like ub.wth-par
        3   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
        4   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
        5   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
        6   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
        7   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам ()"
        8   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
        9   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!()"
       10   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
       11   FIELD w-p-code     like ub.wth-dtl.w-p-code
       12   FIELD doc-code     like ub.wth-dtl.doc-code
       13   FIELD gds-code     like ub.wth-gds.gds-code
       14   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
       15   INDEX tt-i1                        par-feat par-unit par-val
       16   INDEX tt-i2                        doc-sum  q-ty-doc
       17   .
       18   define input-output parameter par-rid as recid no-undo .
       19   define input parameter par-mode    as character no-undo .
       20   define input parameter p-silent    as logical no-undo .
       21   define input parameter pardoc-code like ub.wth-line.doc-code no-undo .
       22   define input parameter parwth-code like ub.wth-line.wth-code no-undo .
       23   define input parameter parw-p-code like ub.wth-line.w-p-code no-undo .
       24   define input parameter parout-code like ub.wth-line.out-code no-undo .
       25   define input parameter pardoc-sum  like ub.wth-line.doc-sum no-undo .
       26   define input parameter parfact-sum  like ub.wth-line.doc-sum no-undo .
       27   define input parameter table for tt-par-dtl.
       28   define input parameter parline-exist as logical no-undo .
       29   define input parameter parext-type like ub.wth-doc.ext-doc-type no-undo.
       30   define input parameter parsum-gds-rubl  like ub.wth-line.sum-gds-rubl no-undo .
       31   define input parameter parsum-gds-base  like ub.wth-line.sum-gds-base no-undo .
       32   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       33   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       34   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       35   define variable vss-workfile    as character no-undo init "$Workfile: wth-lnc1.p $":U .
       36   define variable vss-archive     as character no-undo init "$Archive: str/wth-lnc1.p $":U .
       37   define variable vss-description as character no-undo init "Сохранение изменений в карточке ставки налога".
       38   procedure vss-get-info :
       39     define output parameter p-vss-revision    like vss-revision    no-undo .
       40     define output parameter p-vss-author      like vss-author      no-undo .
       41     define output parameter p-vss-date        like vss-date        no-undo .
       42     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       43     define output parameter p-vss-archive     like vss-archive     no-undo .
       44     define output parameter p-vss-description like vss-description no-undo .
       45     assign
       46       p-vss-revision    = vss-revision
       47       p-vss-author      = vss-author
       48       p-vss-date        = vss-date
       49       p-vss-workfile    = vss-workfile
       50       p-vss-archive     = vss-archive
       51       p-vss-description = vss-description
       52     .
       53   end procedure.
       54   procedure vss-get-parameters :
       55     define output parameter p-vss-parameters as character no-undo .
       56   end procedure.
       57   define new global shared variable g#vssrevis-logger as handle    no-undo .
       58   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       59   define variable v-vssrevis-logger                   as handle    no-undo .
       60   procedure vss-logevent :
       61     define input  parameter p-extra-paramters as character no-undo .
       62     define variable v-vssrevis-parameters as character no-undo .
       63     do
       64     on error undo, return error return-value
       65     :
       66       if  valid-handle(v-vssrevis-logger)
       67       and v-vssrevis-logger :get-signature("logevent") <> ""
       68       then do:
       69         run vss-get-parameters in this-procedure
       70           (output v-vssrevis-parameters
       71           ).
       72         run logevent in v-vssrevis-logger
       73           (input vss-workfile
       74           ,input vss-revision
       75           ,input v-vssrevis-parameters
       76           ,input p-extra-paramters
       77           ).
       78       end.
       79     end.
       80   end procedure.
       81   assign
       82     v-vssrevis-logger = g#vssrevis-logger
       83   .
       84   if  valid-handle(v-vssrevis-logger)
       85   and v-vssrevis-logger :get-signature("logevent") <> ""
       86   then do:
       87     assign
       88       v-vssrevis-logevent = true
       89     .
       90     run vss-logevent in this-procedure (input vss-description) .
       91   end.
       92   define new global shared variable g#language as character no-undo .
       93   if g#language <> '' and g#language <> 'rus':U then do:
       94     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       95   end.
       96   define new global shared variable g#library  as handle no-undo .
       97   define new global shared variable g#library2 as handle no-undo .
       98   define   shared variable g#auto as logical no-undo.
       99   define   shared variable g#news as logical no-undo.
      100   define   shared variable g#oxml as logical no-undo.
      101   define   shared variable g#esys as logical no-undo.
      102   define   shared variable g#news-source-db as integer no-undo.
      103   define   shared variable g#esys-source-esys as integer no-undo.
      104   define   shared variable g#db-num as integer   no-undo .
      105   define   shared variable g#userid as character no-undo .
      106   define   shared variable g#passwd as character no-undo .
      107   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108   procedure cur-time :
      109      define output parameter p-today as date      no-undo .
      110      define output parameter p-time  as integer   no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       define variable v-date1 as date      no-undo .
      115       define variable v-date2 as date      no-undo .
      116       define variable v-time  as integer   no-undo .
      117       assign
      118         v-date1 = today
      119         v-time  = time
      120         v-date2 = today
      121       .
      122       if v-date1 <> v-date2
      123       then do:
      124         assign
      125           v-date1 = today
      126           v-time  = v-time
      127         .
      128       end.
      129       assign
      130         p-today = v-date1
      131         p-time  = v-time
      132       .
      133     end.
      134   end.
      135   function cur-time-date returns character
      136   :
      137     return string(today, '99/99/9999':U) .
      138   end.
      139   function cur-time-mjd returns decimal
      140   :
      141     define variable v-date as date      no-undo .
      142     define variable v-time as integer   no-undo .
      143     run cur-time in this-procedure
      144       (output v-date
      145       ,output v-time
      146       ) .
      147     return integer(v-date) - 2400002 + (v-time / 86400) .
      148   end.
      149   function cur-time-get-ending-index returns integer
      150   (input p-number as integer
      151   )
      152   :
      153     if p-number < 0
      154     or p-number = ?
      155     then do:
      156       return 1 .
      157     end.
      158     define variable v-rest as integer   no-undo .
      159     assign
      160       p-number = p-number modulo 100
      161     .
      162     if p-number < 20
      163     then do:
      164       assign
      165         v-rest = p-number
      166       .
      167     end.
      168     else do:
      169       assign
      170         v-rest = p-number modulo 10
      171       .
      172     end.
      173     case v-rest :
      174       when 1
      175       then do:
      176         return 2 .
      177       end.
      178       when 2 or
      179       when 3 or
      180       when 4
      181       then do:
      182         return 3 .
      183       end.
      184       otherwise do:
      185         return 1 .
      186       end.
      187     end case .
      188   end.
      189   procedure cur-time-mjd-to-date :
      190      define input  parameter i-mjd-diff as decimal no-undo.
      191      define output parameter o-Date     as date    no-undo.
      192      define output parameter o-Time     as integer no-undo.
      193      define variable v-day-number as integer   no-undo .
      194      if    i-mjd-diff < 0
      195         or i-mjd-diff = ?
      196      then do:
      197         return "?" .
      198      end.
      199      assign
      200         v-day-number = truncate(i-mjd-diff,0).
      201         o-Date = date(v-day-number + 2400002).
      202         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204   end.
      205   function cur-time-mjd-to-string returns character
      206   (input p-mjd-diff as decimal
      207   )
      208   :
      209     define variable v-day-number as integer   no-undo .
      210     define variable v-seconds    as integer   no-undo .
      211     define variable v-hour       as integer   no-undo .
      212     define variable v-min        as integer   no-undo .
      213     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      214     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      215     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      216     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      217     if p-mjd-diff < 0
      218     or p-mjd-diff = ?
      219     then do:
      220       return "?" .
      221     end.
      222     assign
      223       v-day-number = integer(truncate(p-mjd-diff,0))
      224       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      225     .
      226     if v-seconds > 86400
      227     then do:
      228       assign
      229         v-seconds = 86400 - 1
      230       .
      231     end.
      232     if v-seconds < 0
      233     then do:
      234       assign
      235         v-seconds = 0
      236       .
      237     end.
      238     assign
      239       v-hour = truncate(v-seconds / 3600, 0)
      240     .
      241     assign
      242       v-seconds = v-seconds modulo 3600
      243     .
      244     assign
      245       v-min = truncate(v-seconds / 60, 0)
      246     .
      247     assign
      248       v-seconds = v-seconds modulo 60
      249     .
      250     return
      251         (if v-day-number <> 0
      252           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      253           else ""
      254         )
      255       + (if v-day-number <> 0 or v-hour <> 0
      256           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      257           else ""
      258         )
      259       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      260           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      261           else ""
      262         )
      263       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      264       .
      265   end.
      266   function cur-time-string returns character
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      275   end.
      276   function cur-time-string-sec returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      285   end.
      286   function cur-time-custom  returns character
      287   (input p-prefix as character
      288   ,input p-date-format as character
      289   ,input p-delimiter as character
      290   ,input p-time-format as character
      291   ,input p-suffix as character
      292   )
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return
      301       p-prefix
      302       + string(v-date, p-date-format)
      303       + p-delimiter
      304       + string(v-time, p-time-format)
      305       + p-suffix
      306       .
      307   end.
      308   function cur-time-print  returns character
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      317   end.
      318   function cur-time-datetime returns datetime
      319   :
      320     define variable v-char as character no-undo .
      321     define variable v-datetime as datetime no-undo .
      322     v-char = cur-time-string().
      323     v-datetime = datetime(v-char).
      324     return  v-datetime.
      325   end.
      326   function cur-time-string-msec returns character
      327   :
      328     define variable v-date as datetime  no-undo .
      329     v-date = now.
      330     return string(v-date) .
      331   end.
      332   DEFINE VARIABLE var-entry as character no-undo .
      333   define variable v-mes     as character no-undo .
      334   DEFINE VARIABLE loc#log as logical no-undo .
      335   DEFINE VARIABLE vardtl-rec as recid no-undo .
      336   DEFINE VARIABLE varis-dtl as logical no-undo .
      337   DEFINE VARIABLE vardtl-doc-sum as decimal no-undo .
      338   DEFINE VARIABLE vardtl-fact-sum as decimal no-undo .
      339   DEFINE VARIABLE varline-doc-sum as decimal no-undo .
      340   DEFINE VARIABLE varline-fact-sum as decimal no-undo .
      341   DEFINE VARIABLE end-doc-sum like ub.wth-line.doc-sum no-undo .
      342   DEFINE VARIABLE end-fact-sum like ub.wth-line.fact-sum no-undo .
      343   DEFINE VARIABLE v-is-deletion as logical no-undo .
      344   DEFINE VARIABLE v-stts like ub.wealth.wth-code no-undo .
      345   DEFINE VARIABLE v-today as date no-undo .
      346   DEFINE VARIABLE v-time as integer no-undo .
      347   define buffer buf_wth-doc for ub.wth-doc .
      348   define buffer buf_wth-line for ub.wth-line .
      349   define buffer inv_wth-doc for ub.wth-doc.
      350   define buffer check_chk-doc for ub.chk-doc .
      351   define buffer buf_wealth for ub.wealth.
      352   _main:
      353   do
      354   on error undo, return error
      355   :
      356   if NOT (par-mode = 'ДОБАВЛЕНИЕ':U OR par-mode = 'ИЗМЕНЕНИЕ':U or par-mode = 'удаление':U) then do:
      357     message
      358     vss-workfile vss-revision vss-description skip
      359     "Неверный параметр вызова par-mode" par-mode
      360     view-as alert-box ERROR.
      361     return error '':U.
      362   end.
      363   if par-mode = 'удаление':U then do:
      364     assign
      365     par-mode = 'ИЗМЕНЕНИЕ':U
      366     v-is-deletion = yes
      367     .
      368   end.
      369   FIND FIRST buf_wth-doc EXCLUSIVE-LOCK WHERE
      370              buf_wth-doc.doc-code = pardoc-code No-ERROR No-WAIT.
      371   IF LOCKED buf_wth-doc then do:
      372     assign
      373     v-mes = "Запись документа МЦ занята, добавление/изменение строки невозможно".
      374     run err-mess(input-output v-mes).
      375     undo _main, return error v-mes.
      376   end.
      377   IF NOT available buf_wth-doc then do:
      378     assign
      379     v-mes = "Не найден документ МЦ".
      380     run err-mess(input-output v-mes).
      381     undo _main, return error v-mes.
      382   end.
      383   if buf_wth-doc.status_ = 'факт':U then do:
      384     assign
      385     v-mes = substitute("Документ имеет статус &1, добавление/изменение строки невозможно", buf_wth-doc.status_).
      386     run err-mess(input-output v-mes).
      387     undo _main, return error v-mes.
      388   end.
      389   if buf_wth-doc.status_ = 'разрешен':U
      390   and par-mode = 'ДОБАВЛЕНИЕ':U then dO:
      391     assign
      392     v-mes = substitute("Документ имеет статус &1, добавление строки невозможно", buf_wth-doc.status_).
      393     run err-mess(input-output v-mes).
      394     undo _main, return error v-mes.
      395   end.
      396   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      397     par-rid = ?.
      398     if  parline-exist = yes then do:
      399       FIND FIRST ub.wth-line No-LOCK WHERE
      400                 ub.wth-line.doc-code = pardoc-code AND
      401                 ub.wth-line.wth-code = parwth-code AND
      402                 ub.wth-line.w-p-code = parw-p-code No-ERROR.
      403       if available ub.wth-line then do:
      404         par-rid = recid(ub.wth-line).
      405         assign
      406         pardoc-sum = pardoc-sum + ub.wth-line.doc-sum
      407         parfact-sum = parfact-sum + ub.wth-line.fact-sum
      408         .
      409       end.
      410     end.
      411   end.
      412   if not v-is-deletion then do:
      413     run trg/wth-lnc2.p (
      414                   input pardoc-code,
      415                   input buf_wth-doc.host-code,
      416                   input buf_wth-doc.obj-type,
      417                   input buf_wth-doc.obj-code,
      418                   input buf_wth-doc.cli-type,
      419                   input buf_wth-doc.cli-code,
      420                   input buf_wth-doc.auto-fill,
      421                   input buf_wth-doc.borned,
      422                   input buf_wth-doc.exter_,
      423                   input par-rid,
      424                   input parwth-code,
      425                   input parw-p-code,
      426                   input parout-code,
      427                   input pardoc-sum,
      428                   input parfact-sum,
      429                   output v-stts ) no-error.
      430     if error-status:error then return error return-value.
      431     if par-mode = 'ДОБАВЛЕНИЕ':U and buf_wth-doc.auto-fill = no
      432        and v-stts <> 0 then do:
      433       assign
      434       v-mes = substitute("МЦ &1 удалена, добавление строки невозможно", parwth-code).
      435       run err-mess(input-output v-mes).
      436       undo _main, return error v-mes.
      437     end.
      438   end.
      439   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      440     FIND FIRST buf_wth-line NO-LOCK WHERE
      441               buf_wth-line.obj-type    = buf_wth-doc.obj-type   AND
      442               buf_wth-line.obj-code    = buf_wth-doc.obj-code   AND
      443               buf_wth-line.w-p-code    = parw-p-code   AND
      444               buf_wth-line.shift-date  = buf_wth-doc.shift-date AND
      445               buf_wth-line.shift-num   = buf_wth-doc.shift-num  AND
      446               buf_wth-line.wth-code    = parwth-code   AND
      447               buf_wth-line.status_    <> 'факт':U           AND
      448               RECID( buf_wth-line )   <>  par-rid  NO-ERROR.
      449     IF AVAIL buf_wth-line THEN DO:
      450       FIND FIRST inv_wth-doc NO-LOCK WHERE
      451                   inv_wth-doc.doc-code = buf_wth-line.doc-code No-ERROR.
      452       IF inv_wth-doc.doc-type = 'инв':U THEN DO:
      453       FIND FIRST check_chk-doc No-LOCK WHERE
      454                 check_chk-doc.out-code = inv_wth-doc.doc-code NO-ERROR.
      455       if avail check_chk-doc and string(check_chk-doc.chk-type) = '4':U then.
      456         else do:
      457           assign
      458           v-mes = substitute("Материальная ценность &1 есть в незакрытой инвентаризации &2 по МХ &3&4добавление строки невозможно"
      459                             , parwth-code
      460                             , buf_wth-line.doc-code
      461                             , parw-p-code
      462                             , chr(10)
      463                             ).
      464           run err-mess(input-output v-mes).
      465           undo _main, return error v-mes.
      466         END.
      467       END.
      468     END.
      469   end.
      470   DO ON ERROR UNDO, return '':U
      471      On STOP UNDO, return '':U:
      472     if par-mode = 'ДОБАВЛЕНИЕ':U and par-rid = ? then do:
      473     run cur-time in this-procedure(output v-today, output v-time).
      474   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      475   CREATE wth-line.
      476   ASSIGN
      477     wth-line.doc-code     = buf_wth-doc.doc-code
      478     wth-line.w-p-code     = parw-p-code
      479     wth-line.out-code     = parout-code
      480     wth-line.obj-type     = buf_wth-doc.obj-type
      481     wth-line.obj-code     = buf_wth-doc.obj-code
      482     wth-line.shift-date   = buf_wth-doc.shift-date
      483     wth-line.shift-num    = buf_wth-doc.shift-num
      484     wth-line.shift-name   = buf_wth-doc.shift-name
      485     wth-line.creid        = g#userid
      486     wth-line.credate      = v-today
      487   .
      488       assign par-rid = recid(ub.wth-line).
      489     end.
      490     else do:
      491       FIND FIRST ub.wth-line EXCLUSIVE-LOCK WHERE
      492                 recid(ub.wth-line) = par-rid No-WAIT No-ERROR.
      493       if locked ub.wth-line then do:
      494         assign
      495         v-mes = substitute("Строка документа занята").
      496         run err-mess(input-output v-mes).
      497         undo _main, return error v-mes.
      498       end.
      499       if not avail ub.wth-line then do:
      500         assign
      501         v-mes = substitute("Не найжена строка документа").
      502         run err-mess(input-output v-mes).
      503         undo _main, return error v-mes.
      504       end.
      505       if buf_wth-doc.status_ = 'разрешен':U and
      506         (ub.wth-line.doc-code <> pardoc-code OR
      507         ub.wth-line.wth-code <> parwth-code OR
      508         ub.wth-line.w-p-code <> parw-p-code OR
      509         ub.wth-line.out-code <> parout-code OR
      510         ub.wth-line.doc-sum <> pardoc-sum ) then dO:
      511         assign
      512         v-mes = substitute("Документ МЦ имеет статус &1, можно изменить только сумму факт", buf_wth-doc.status_).
      513         run err-mess(input-output v-mes).
      514         undo _main, return error v-mes.
      515       end.
      516     end.
      517     assign
      518     ub.wth-line.doc-code = pardoc-code
      519     ub.wth-line.wth-code = parwth-code
      520     ub.wth-line.w-p-code = parw-p-code
      521     ub.wth-line.out-code = parout-code
      522     ub.wth-line.ext-doc-type = parext-type
      523     buf_wth-doc.doc-sum = buf_wth-doc.doc-sum - ub.wth-line.doc-sum + pardoc-sum
      524     ub.wth-line.doc-sum = pardoc-sum
      525     buf_wth-doc.sum-gds-rubl = buf_wth-doc.sum-gds-rubl - ub.wth-line.sum-gds-rubl + parsum-gds-rubl
      526     buf_wth-doc.sum-gds-base = buf_wth-doc.sum-gds-base - ub.wth-line.sum-gds-base + parsum-gds-base
      527     ub.wth-line.sum-gds-base = parsum-gds-base
      528     ub.wth-line.sum-gds-rubl = parsum-gds-rubl
      529     buf_wth-doc.fact-sum = buf_wth-doc.fact-sum - ub.wth-line.fact-sum + parfact-sum
      530     ub.wth-line.fact-sum = parfact-sum
      531     end-doc-sum  = ub.wth-line.doc-sum
      532     end-fact-sum = ub.wth-line.fact-sum
      533     ub.wth-line.price-rubl = ub.wth-line.sum-gds-rubl / ub.wth-line.fact-sum
      534     ub.wth-line.price-base = ub.wth-line.sum-gds-base / ub.wth-line.fact-sum
      535     .
      536     assign
      537     varline-doc-sum = (IF buf_wth-doc.doc-type = 'инв':U
      538                       THEN ub.wth-line.bef-sum
      539                       ELSE ub.wth-line.doc-sum
      540                       )
      541     varline-fact-sum = (IF buf_wth-doc.doc-type = 'инв':U
      542                       THEN ub.wth-line.aft-sum
      543                       ELSE ub.wth-line.fact-sum
      544                       )
      545     .
      546     if par-mode = 'ДОБАВЛЕНИЕ':U then dO:
      547       release ub.wth-line no-error.
      548       if error-status:error then do:
      549               v-mes = return-value.
      550               run err-mess(input-output v-mes).
      551               return error (if p-silent = yes then v-mes else '':U).
      552       end.
      553     end.
      554     if not v-is-deletion then do:
      555       for each tt-par-dtl:
      556         if tt-par-dtl.wth-code <> parwth-code then next.
      557         varis-dtl = yes.
      558         run str/wth-dtl1.p (output vardtl-rec,
      559                       input par-mode,
      560                       input pardoc-code,
      561                       input parwth-code,
      562                       input parw-p-code,
      563                       input tt-par-dtl.par-code,
      564                       input tt-par-dtl.doc-sum,
      565                       input tt-par-dtl.fact-sum,
      566                       input tt-par-dtl.sum-gds-rubl ,
      567                       input tt-par-dtl.sum-gds-base ,
      568                       input parline-exist
      569                       ) no-error.
      570         if error-status:error or vardtl-rec = ? then do:
      571           var-entry = "b-par":U.
      572           return error var-entry.
      573         end.
      574         assign
      575         vardtl-doc-sum = vardtl-doc-sum + tt-par-dtl.doc-sum
      576         vardtl-fact-sum = vardtl-fact-sum + tt-par-dtl.fact-sum
      577         .
      578       END.
      579       if varis-dtl then dO:
      580         case buf_wth-doc.status_ :
      581           when 'накл':U then dO:
      582             if varline-doc-sum <> vardtl-doc-sum and
      583               NOT (vardtl-doc-sum  = 0 and
      584                     not can-find(first ub.wth-dtl No-LOCK WHERE
      585                                         ub.wth-dtl.doc-code = pardoc-code AND
      586                                         ub.wth-dtl.wth-code = parwth-code AND
      587                                         ub.wth-dtl.w-p-code = parw-p-code)
      588                     )
      589                 then dO:
      590               assign
      591               v-mes = substitute("Сумма по номиналам &1 не совпадает с суммой движения материального средства &2"
      592                                , vardtl-doc-sum
      593                                , varline-doc-sum
      594                                ).
      595               run err-mess(input-output v-mes).
      596               return error (if p-silent = yes then v-mes else 'doc-sum':U).
      597             end.
      598           end.
      599           when 'разрешен':U then do:
      600             if varline-fact-sum <> vardtl-fact-sum and
      601               NOT (vardtl-fact-sum  = 0 and
      602                     not can-find(first ub.wth-dtl No-LOCK WHERE
      603                                        ub.wth-dtl.doc-code = pardoc-code AND
      604                                        ub.wth-dtl.wth-code = parwth-code AND
      605                                        ub.wth-dtl.w-p-code = parw-p-code)
      606                     )
      607                 then dO:
      608               assign
      609               v-mes = substitute("Сумма по номиналам &1 не совпадает с суммой движения материального средства &2"
      610                                , vardtl-fact-sum
      611                                , varline-fact-sum
      612                                ).
      613               run err-mess(input-output v-mes).
      614               return error (if p-silent = yes then v-mes else 'wth-dtl':U).
      615             end.
      616           end.
      617         END CASE.
      618       end.
      619       else do:
      620         if can-find(first ub.wth-dtl No-LOCK WHERE
      621                           ub.wth-dtl.doc-code = pardoc-code AND
      622                           ub.wth-dtl.wth-code = parwth-code AND
      623                           ub.wth-dtl.w-p-code = parw-p-code) then do:
      624           FOR EACH ub.wth-dtl No-LOCK WHERE
      625                     wth-dtl.doc-code = ub.wth-line.doc-code AND
      626                     wth-dtl.wth-code = ub.wth-line.wth-code AND
      627                     wth-dtl.w-p-code = ub.wth-line.w-p-code:
      628             assign
      629             vardtl-doc-sum = vardtl-doc-sum + wth-dtl.doc-sum
      630             vardtl-fact-sum = vardtl-fact-sum + wth-dtl.fact-sum
      631             .
      632           END.
      633           if varline-doc-sum <> vardtl-doc-sum or
      634             varline-fact-sum <> vardtl-fact-sum then dO:
      635             if varline-doc-sum <> vardtl-doc-sum then
      636             assign
      637             v-mes = substitute("Сумма по номиналам &1 не совпадает с суммой движения материального средства &2"
      638                               , vardtl-doc-sum
      639                               , varline-doc-sum
      640                               ).
      641             else
      642             assign
      643             v-mes = substitute("Сумма по номиналам &1 не совпадает с суммой движения материального средства &2"
      644                               , vardtl-fact-sum
      645                               , varline-fact-sum
      646                               ).
      647             run err-mess(input-output v-mes).
      648             return error (if p-silent = yes then v-mes else 'wth-dtl':U).
      649           end.
      650         end.
      651       end.
      652     end.
      653     if v-is-deletion then do:
      654     assign
      655       buf_wth-doc.doc-sum      = buf_wth-doc.doc-sum - ub.wth-line.doc-sum
      656       buf_wth-doc.sum-gds-rubl = buf_wth-doc.sum-gds-rubl - ub.wth-line.sum-gds-rubl
      657       buf_wth-doc.sum-gds-base = buf_wth-doc.sum-gds-base - ub.wth-line.sum-gds-base
      658       buf_wth-doc.fact-sum     = buf_wth-doc.fact-sum - ub.wth-line.fact-sum
      659     .
      660     end.
      661     if parline-exist and
      662     end-doc-sum = 0 AND
      663     end-fact-sum = 0
      664     then do:
      665       FIND FIRSt ub.wth-line exclusive-lock where
      666                  recid(ub.wth-line) = par-rid.
      667       delete ub.wth-line no-error.
      668       if error-status:error then do:
      669         v-mes = return-value .
      670         run err-mess(input-output v-mes).
      671         return error (if p-silent = yes then v-mes else '':U).
      672       end.
      673       par-rid = ?.
      674     end.
      675   END.
      676   return '':U.
      677   end.
      678   PROCEDURE err-mess:
      679     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      680     CASE p-silent:
      681       when yes then do:
      682       p-mess = substitute("Документ МЦ №&1 строка с МЦ &2 МЗ &3: &4&5"
      683                      , pardoc-code
      684                      , parwth-code
      685                      , parw-p-code
      686                      , chr(10)
      687                      , p-mess).
      688       end.
      689       when no then do:
      690         message
      691         p-mess
      692         view-as alert-box error .
      693       end.
      694     end.
      695   END PROCEDURE.
