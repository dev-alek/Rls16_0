      471   FUNCTION fnc-shift-name RETURN char (cur-lev  as integer,
      472                                        cur-mark as char,
      473                                        cur-name as char).
      474     return (fill ("  ", cur-lev) +
      475             cur-mark +
      476             " " +
      477             cur-name).
      478   END FUNCTION.
      479   define  query   br-gds-prt for prt-tree SCROLLING.
      480   define  browse  br-gds-prt
      481          query br-gds-prt
      482          disp
      483          fnc-shift-name (prt-tree.level, prt-tree.mark, prt-tree.n-name) @ shift-name
      484          format "x(23)" column-label "Признак"
      485   WITH SIZE 26 BY 14.3 separators.
      486   DEFINE BUTTON b-exit AUTO-go
      487        LABEL "&Выход ":L
      488        SIZE 10 BY 1.
      489   DEFINE BUTTON b-exp-nd
      490        LABEL "&>>":L
      491        SIZE 10 BY 1.
      492   DEFINE BUTTON b-exp-tree
      493        LABEL ">>&->>":L
      494        SIZE 10 BY 1.
      495   DEFINE BUTTON b-rest
      496        LABEL "&Остатки":L
      497        SIZE 10 BY 1.
      498   DEFINE BUTTON b-hist
      499        LABEL "Ис&тория":L
      500        SIZE 10 BY 1.
      501   DEFINE BUTTON b-help
      502        LABEL "Помо&щь":L
      503        SIZE 10 BY 1.
      504   DEFINE FRAME d-gds-prt
      505     b-exit     AT ROW 1.25  COL 1
      506     b-exp-nd   AT ROW 1.25  COL 11
      507     b-exp-tree AT ROW 1.25  COL 21
      508     b-rest     AT ROW 1.25  COL 31
      509     b-hist     AT ROW 1.25  COL 41
      510     b-help     AT ROW 1.25  COL 51
      511     br-gds-prt      AT ROW 2.5   COL 12
      512     WITH size 64 by 19 VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D.
      513     br-gds-prt :set-repositioned-row (10, "conditional").
      514     ASSIGN
      515       FRAME d-gds-prt:SCROLLABLE = FALSE
      516       .
      517   on row-display of br-gds-prt do:
      518     if prt-tree.is-root then
      519       shift-name :fgcolor in browse br-gds-prt = BLUE_COLOR.
      520     else
      521       if not prt-tree.is-term then
      522         shift-name :fgcolor in browse br-gds-prt = BROWN_COLOR.
      523   end.
      524   ON CHOOSE OF b-exit IN FRAME d-gds-prt  DO:
      525     p-prt-rec = prt-tree.rid.
      526   END.
      527   ON choose of b-exp-nd IN FRAME d-gds-prt DO:
      528     gds-prt-row = current-result-row ("br-gds-prt").
      529     run exp-nd (?).
      530     run UI-on.
      531   END.
      532   ON choose of b-exp-tree IN FRAME d-gds-prt DO:
      533     gds-prt-row = current-result-row ("br-gds-prt").
      534     run exp-tree.
      535     run UI-on.
      536   END.
      537   ON MOUSE-SELECT-DBLCLICK, return OF br-gds-prt IN FRAME d-gds-prt DO:
      538     gds-prt-row = current-result-row ("br-gds-prt").
      539     if prt-tree.is-term = false then do:
      540       apply "choose" to b-exp-nd in frame d-gds-prt.
      541     end.
      542     return no-apply.
      543   END.
      544   ON CHOOSE OF b-rest IN FRAME d-gds-prt do:
      545     run rep/prt-rest.w (
      546                    input parparentproc
      547                   ,input p-curr-obj-type
      548                   ,input p-curr-obj-code
      549                   ,input prt-tree.rid).
      550     apply "entry" to br-gds-prt in frame d-gds-prt.
      551   END.
      552   ON CHOOSE OF b-hist IN FRAME d-gds-prt DO:
      553    DEFINE VARIABLE rid-list AS character NO-UNDO.
      554    IF NOT AVAILABLE prt-tree THEN RETURN NO-APPLY.
      555      run ref/cgdsprts.w (
      556                        input parparentproc
      557                       ,INPUT "":U
      558                       ,INPUT "one":U
      559                       ,INPUT prt-tree.n-code
      560                       ,INPUT NO
      561                       ,OUTPUT rid-list
      562          ) .
      563    apply "ENTRY":U to br-gds-prt .
      564   END.
      565   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED THEN
      566     CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      567   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568   on help of frame d-gds-prt
      569   do:
      570     run gbl/app_help.p
      571       (input this-procedure :file-name
      572       ,input ''
      573       ,input ?
      574       ) no-error.
      575     if error-status :error then do:
      576       message
      577         "Ошибка при вызове помощи"
      578         error-status :get-message(1)
      579         view-as alert-box .
      580     end.
      581   end.
      582   run minbtn-set in this-procedure .
      583   on choose of b-help in frame d-gds-prt
      584   do:
      585     apply "help":u to frame d-gds-prt .
      586   end.
      587   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      588   procedure minbtn-set :
      589       do
      590           on error undo, return error return-value
      591           :
      592           define variable ii              as integer       no-undo .
      593           define variable fh              as widget-handle no-undo .
      594           define variable hh              as widget-handle no-undo .
      595           define variable v-h             as handle        extent 4 no-undo .
      596           define variable v-name-button   as character     no-undo .
      597           define variable v-help-old-x    as decimal       no-undo .
      598           define variable v-help-old-y    as decimal       no-undo .
      599           define variable v-help-old-size as decimal       no-undo .
      600           define variable v-frame-width   as decimal       no-undo .
      601           define variable jj              as integer       no-undo .
      602           do
      603               on error undo, return error
      604               :
      605               assign
      606                   v-frame-width = frame d-gds-prt:width - 0.3
      607                   fh            = frame d-gds-prt:first-child
      608                   hh            = fh:first-child
      609                   ii            = 1
      610                   .
      611               do while valid-handle(hh):
      612                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      613                   do:
      614                       case lc(hh:name) :
      615                           when "b-help" then
      616                               do:
      617                                   hh:load-image-up("cmp/b-help.bmp":u) .
      618                                   hh:load-image-down("cmp/b-help.bmp":u) .
      619                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      620                                   hh:TOOLTIP = "Помощь" .
      621                                   v-help-old-x = hh:column .
      622                                   v-help-old-y = hh:row    .
      623                                   v-help-old-size = hh:width .
      624                                   hh:width-chars = 2.5 .
      625                               end.
      626                           when "b-print" then
      627                               do:
      628                                   hh:load-image("cmp/b-print.bmp":u) .
      629                                   hh:TOOLTIP = "Печать" .
      630                                   v-h[ii] = hh:handle .
      631                                   ii = ii + 1 .
      632                                   hh:width-chars = 3 .
      633                               end.
      634                           when "b-history" or
      635                           when "b-hist" then
      636                               do:
      637                                   hh:load-image("cmp/b-hist.bmp":u) .
      638                                   hh:TOOLTIP = "История" .
      639                                   v-h[ii] = hh:handle .
      640                                   ii = ii + 1 .
      641                                   hh:width-chars = 3 .
      642                               end.
      643                           when "b-sch" then
      644                               do:
      645                                   hh:load-image("cmp/b-sch.bmp":u) .
      646                                   hh:TOOLTIP = "Установка Фильтра" .
      647                                   v-h[ii] = hh:handle .
      648                                   ii = ii + 1 .
      649                                   hh:width-chars = 3 .
      650                               end.
      651                           when "b-hist-user" then
      652                               do:
      653                                   hh:load-image("cmp/b-hist.bmp":u) .
      654                                   hh:TOOLTIP = "История пользователя" .
      655                                   ii = ii + 1 .
      656                               end.
      657                       end case.
      658                   end.
      659                   hh = hh:next-sibling.
      660               end.
      661               b-help:column = v-frame-width - b-help:width-chars.
      662               jj = 0.
      663               repeat ii = 4 to 1 by -1 :
      664                   if valid-handle (v-h[ii] ) then
      665                   do:
      666                       jj  = jj + 1 .
      667                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      668                       v-h[ii]:row    = v-help-old-y .
      669                   end.
      670               end.
      671           end.
      672       end.
      673   end procedure.
      674   ON WINDOW-CLOSE OF FRAME d-gds-prt APPLY "END-ERROR":U TO SELF.
      675   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676     run mainmenu_getcntxt in parparentproc
      677       (output v-cntxt-db-num
      678       ,output v-cntxt-userid
      679       ,output v-cntxt-level
      680       ,output v-cntxt-host-code-obj
      681       ,output v-cntxt-obj-type
      682       ,output v-cntxt-obj-code
      683       ,output v-cntxt-db-num-obj
      684       ,output v-cntxt-is-admin
      685       ) .
      686   find ub.gds-prt no-lock where
      687        recid (ub.gds-prt) = p-prt-rec.
      688   glog = session:set-wait-state ("COMPILER") .
      689   ENABLE br-gds-prt
      690          b-exit
      691          b-hist
      692          b-help
      693          b-rest
      694          b-exp-nd
      695          b-exp-tree with FRAME d-gds-prt.
      696   run cre-nd (buffer ub.gds-prt, buffer prt-tree, 0).
      697   find first prt-tree.
      698   run exp-nd (yes).
      699   FRAME d-gds-prt:title =
      700     "Шкала : " + ub.gds-prt.node-name + "  -  " + p-prt-mode.
      701   RUN UI-on.
      702   glog = session:set-wait-state ( "" ) .
      703   do on endkey undo, leave  on error undo, leave:
      704     WAIT-FOR GO OF FRAME d-gds-prt.
      705   end.
      706   RUN disable_UI.
      707   PROCEDURE disable_UI :
      708     HIDE FRAME d-gds-prt.
      709   END PROCEDURE.
      710   PROCEDURE UI-on :
      711   OPEN QUERY  br-gds-prt
      712     FOR EACH  prt-tree where
      713               prt-tree.visible = yes no-lock.
      714   reposition br-gds-prt to row gds-prt-row no-error.
      715   apply "ENTRY":U to br-gds-prt in frame d-gds-prt.
      716   END PROCEDURE.
      717   PROCEDURE exp-nd :
      718   define input param make-visible as logical no-undo.
      719   define variable nd-level as integer no-undo.
      720   define buffer b-prt-tree for prt-tree.
      721   if prt-tree.exp then do:
      722     nd-level = prt-tree.level.
      723     find b-prt-tree where
      724          recid (b-prt-tree) = recid (prt-tree).
      725     inverse:
      726     do while true:
      727       find next b-prt-tree no-error.
      728       if not available b-prt-tree then
      729         leave inverse.
      730       if b-prt-tree.level > nd-level then do:
      731         if make-visible = ? then
      732           make-visible = not (b-prt-tree.visible).
      733         if not make-visible or
      734            b-prt-tree.level - nd-level = 1 then do:
      735           b-prt-tree.visible = make-visible.
      736           if not b-prt-tree.is-term then
      737             b-prt-tree.mark = "»".
      738         end.
      739       end.
      740       else
      741         leave inverse.
      742     end.
      743   end.
      744   else do:
      745     prt-tree.exp = yes.
      746     run cre-level (recid (prt-tree), prt-tree.level + 1).
      747     make-visible = yes.
      748   end.
      749   if not prt-tree.is-term then
      750     if make-visible then
      751       prt-tree.mark = " ".
      752     else
      753       prt-tree.mark = "»".
      754   END PROCEDURE.
      755   PROCEDURE exp-tree :
      756   define variable rid as recid no-undo.
      757   tree-level = prt-tree.level.
      758   run waitfram-show in this-procedure
      759     (input "Раскрывается шкала. Ждите..."
      760     ).
      761   tree:
      762   do while true:
      763     rid = recid (prt-tree).
      764     run exp-nd (yes).
      765     find prt-tree where rid = recid (prt-tree).
      766     find next prt-tree no-error.
      767     if not available prt-tree or
      768        prt-tree.level <= tree-level
      769        then
      770       leave tree.
      771   end.
      772   run waitfram-hide in this-procedure .
      773   END PROCEDURE.
      774   PROCEDURE cre-level:
      775   define input param prt-tree-rec as recid   no-undo.
      776   define input param cur-lev      as integer no-undo.
      777   define buffer b-gds-prt  for ub.gds-prt.
      778   define buffer b-prt-tree for prt-tree.
      779   define variable up-code like ub.gds-prt.node-code no-undo.
      780   find b-prt-tree where
      781        recid (b-prt-tree) = prt-tree-rec.
      782   up-code = b-prt-tree.n-code.
      783   for each b-gds-prt no-lock where
      784            b-gds-prt.upper-code = up-code
      785            by b-gds-prt.prt-num:
      786     run cre-nd (buffer b-gds-prt, buffer b-prt-tree, cur-lev).
      787   end.
      788   END PROCEDURE.
      789   PROCEDURE cre-nd:
      790   define parameter buffer b-gds-prt  for ub.gds-prt.
      791   define parameter buffer b-prt-tree for prt-tree.
      792   define input  parameter  cur-lev as integer no-undo.
      793   create b-prt-tree.
      794   assign
      795     b-prt-tree.n-code   = b-gds-prt.node-code
      796     b-prt-tree.level    = cur-lev
      797     b-prt-tree.n-name   = b-gds-prt.node-name
      798     b-prt-tree.rid      = recid (b-gds-prt)
      799     b-prt-tree.visible  = yes
      800     b-prt-tree.is-term  = b-gds-prt.is-term
      801     b-prt-tree.is-root  = b-gds-prt.root
      802     .
      803   if b-gds-prt.is-term then
      804     assign
      805       b-prt-tree.mark = " "
      806       b-prt-tree.exp = yes
      807       .
      808   else
      809     assign
      810       b-prt-tree.mark = "»"
      811       b-prt-tree.exp = no
      812       .
      813   END PROCEDURE.
