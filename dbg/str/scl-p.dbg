      463     field mark      as   char
      464     .
      465   define variable tree-level  as   integer           no-undo.
      466   define variable gds-prt-row as   integer init 1    no-undo.
      467   define variable old_qnty    like ub.doc-line.doc-qnty no-undo.
      468   define variable shift-name  as   char              no-undo.
      469   define variable rec-list    as   char              no-undo.
