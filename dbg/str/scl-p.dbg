      453   define work-table prt-tree no-undo
      454     field bc        like ub.bar-code.b-code    format "9999999999" column-label "Осн. код"
      455     field n-code    like ub.gds-prt.node-code
      456     field n-name    like ub.gds-prt.node-name
      457     field rid       as   recid
      458     field visible   as   log
      459     field exp       as   log
