        1   define input  parameter parparentproc as widget-handle no-undo .
        2   define input  parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input  parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input  parameter p-prt-mode as character no-undo .
        5   define input  parameter p-prt-rec  as recid     no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init " работа с деревом признаков   ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define new shared temp-table tt-goods no-undo like ub.goods.
      128   define new shared temp-table tt-clients no-undo like ub.clients.
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130     define variable v-cntxt-db-num        as integer   no-undo .
      131     define variable v-cntxt-userid        as character no-undo .
      132     define variable v-cntxt-level         as character no-undo .
      133     define variable v-cntxt-host-code-obj as integer   no-undo .
      134     define variable v-cntxt-obj-type      as character no-undo .
      135     define variable v-cntxt-obj-code      as integer   no-undo .
      136     define variable v-cntxt-db-num-obj    as integer   no-undo .
      137     define variable v-cntxt-is-admin      as logical   no-undo .
      138   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      140   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      141   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      142   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      143   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      144   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      145   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      146   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      147   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      148   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      149   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      150   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      151   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      152   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      153   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      154   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      155   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      156   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      157   define variable v-waitfram-action01         as character   no-undo .
      158   define variable v-waitfram-action02         as character   no-undo .
      159   define variable v-waitfram-action03         as character   no-undo .
      160   define variable mWaitFramTextBeg            as character   no-undo.
      161   define variable mWaitFramTextEnd            as character   no-undo.
      162   define variable mWaitFramView               as logical     no-undo.
      163   define variable mWaitProcEvent              as logical     no-undo init yes.
      164   define variable mWaitFramInterval           as integer     no-undo init 1 .
      165   define variable mWaitFramStop               as logical     no-undo.
      166   define variable mWaitFramStopUser           as logical     no-undo.
      167   define variable mWaitFramStopTimeOut        as logical     no-undo.
      168   define variable mWaitFramStartProc          as datetime-tz no-undo.
      169   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      170   define button B-WaitFramStop auto-end-key
      171        label "Стоп"
      172        size 10 by 1 tooltip "Остоновить процесс".
      173   define button B-viewProcInfo
      174        label "Информация"
      175        size 15 by 1 tooltip "Информация о процесс".
      176   define frame waitfram
      177     v-waitfram-action01 format "x(72)" no-label skip
      178     v-waitfram-action02 format "x(72)" no-label skip
      179     v-waitfram-action03 format "x(72)" no-label skip
      180     B-viewProcInfo
      181     B-WaitFramStop at row 4 col 30
      182     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      183     .
      184   define new global shared variable mBatchMode as logical no-undo init ?.
      185   define variable mFramBachModHandle as handle no-undo.
      186   mFramBachModHandle = frame waitfram:handle.
      187   define variable mFameOldVis as logical no-undo.
      188   define variable mVisCUrentVin as logical no-undo.
      189   if session:batch-mode
      190   then
      191      mBatchMode = yes.
      192   if mBatchMode = ? then do:
      193     mVisCUrentVin = current-window:visible.
      194     mFameOldVis = mFramBachModHandle:visible.
      195     mFramBachModHandle:visible  = yes.
      196     mBatchMode = mFramBachModHandle:visible ne yes.
      197     mFramBachModHandle:visible = mFameOldVis.
      198     current-window:visible = mVisCUrentVin.
      199   end.
      200    if  log-manager:logfile-name ne ?
      201     then DO:
      202         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      203         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      204         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      205     end.
      206   on choose of B-WaitFramStop in frame waitfram
      207   do:
      208     mWaitFramStop = yes.
      209     mWaitFramStopUser = yes.
      210   end.
      211   function waitfram-check-timeout returns logical():
      212      define variable vtime as int64 no-undo.
      213      if mWaitFramStopTimeOut
      214      then
      215         return yes.
      216      vtime = ( now - mWaitFramStartProc ) / 1000 .
      217      if     mWaitFramTimeOut ne ?
      218         and mWaitFramTimeOut ne 0
      219         and mWaitFramTimeOut lt vtime
      220      then do:
      221         mWaitFramStopTimeOut = yes.
      222      end.
      223      return mWaitFramStopTimeOut.
      224   end.
      225   procedure waitfram-hide :
      226     if not session:batch-mode
      227     then do
      228     on error undo, return error return-value
      229     :
      230       pause 0 before-hide .
      231       if not mBatchMode then
      232         hide frame waitfram .
      233     if     not mWaitFramView
      234        and mWaitProcEvent
      235     then
      236       process events .
      237     end.
      238   end procedure.
      239   procedure waitfram-show :
      240     define input  parameter p-message as character no-undo .
      241     define variable v-left-margin as integer   no-undo .
      242     if not session:batch-mode
      243     then do
      244     on error undo, return error return-value
      245     :
      246       if length(p-message) <= 70 then do:
      247         assign
      248           v-left-margin = integer((70 - length(p-message)) / 2)
      249         .
      250         assign
      251           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      252         .
      253         assign
      254           v-waitfram-action01 = " "
      255           v-waitfram-action02 = " "
      256                                    + fill(" ", v-left-margin)
      257                                    + p-message
      258           v-waitfram-action03 = " "
      259         .
      260       end.
      261       else do:
      262         define variable vRindex1 as integer no-undo.
      263         define variable vRindex2 as integer no-undo.
      264         vRindex1 = r-index(p-message," ",70).
      265         if vRindex1 = 0
      266         then
      267            vRindex1 = 70.
      268         if length(p-message)  <= vRindex1 + 70 then do:
      269           assign
      270             v-waitfram-action01 = " "
      271             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      272             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      273           .
      274         end.
      275         else do:
      276           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      277           if vRindex2 <= vRindex1
      278           then
      279              vRindex2 = vRindex1 + 70.
      280           assign
      281             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      282             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      283             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      284           .
      285         end.
      286       end.
      287       B-viewProcInfo:visible   in frame waitfram = no.
      288       B-viewProcInfo:sensitive in frame waitfram = no.
      289       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      290       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      291       if  (   mWaitFramView
      292          or  mWaitProcEvent)
      293          and not mBatchMode
      294       then
      295          display
      296             v-waitfram-action01 skip
      297             v-waitfram-action02 skip
      298             v-waitfram-action03 skip
      299          with frame waitfram .
      300       if     mWaitFramView
      301          then do:
      302             if     mWaitFramInterval ne ?
      303                and not mBatchMode
      304             then
      305                wait-for go of frame waitfram pause mWaitFramInterval.
      306          end.
      307          else
      308             if     mWaitProcEvent
      309                and not mBatchMode
      310             then
      311                process events .
      312     end.
      313   end procedure.
      314      procedure waitfram-show-this:
      315         define input  parameter iInterval as int64 no-undo.
      316         define variable vtime as int64 no-undo.
      317         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      318         mWaitFramInterval = iInterval.
      319         run waitfram-show (substitute("&1&2 &3&4" ,
      320                                       mWaitFramTextBeg ,
      321                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      322                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      323                                       mWaitFramTextEnd
      324                                      )
      325                           ).
      326      end.
      327      procedure WaitFramRunPause:
      328         define input  parameter iInterval as dec no-undo.
      329         define variable vStart  as datetime-tz no-undo.
      330         define variable vend    as datetime-tz no-undo.
      331         define variable vint as int64 no-undo.
      332         define variable vOk as logical no-undo.
      333         vStart = now.
      334         vend   = vStart.
      335         publish "WaitFramPause" (iInterval,output vOk).
      336         vend   =  now.
      337         vint = vend - vStart.
      338         vint = iInterval - vint / 1000.
      339         if     not mWaitFramStop
      340            and (   vint > 0
      341                 or (    not vOk
      342                     and iInterval eq ?
      343                     )
      344                 )
      345         then
      346            run waitfram-show-this (iInterval).
      347         vend   =  now.
      348         vint = vend - vStart.
      349         vint = iInterval - vint / 1000.
      350         if     not mWaitFramStop
      351            and vint > 0
      352         then do:
      353            run gbl/pause.p (vint * 1000).
      354         end.
      355         if iInterval ne ?
      356         then
      357            publish "WaitFramStop".
      358         waitfram-check-timeout().
      359      end.
      360      procedure WaitFramWaitFor:
      361         define input  parameter iInterval as dec no-undo.
      362         assign
      363            mWaitFramStartProc   = now
      364            mWaitFramStopUser    = no
      365            mWaitFramStopTimeOut = no
      366         .
      367         block-wait:
      368         do while not mWaitFramStop:
      369            run WaitFramRunPause (iInterval).
      370            if  waitfram-check-timeout()
      371            then do:
      372               leave block-wait.
      373            end.
      374         end.
      375         run waitfram-hide.
      376      end.
      377   procedure waitfram-join :
      378     define input  parameter p-line-1  as character no-undo .
      379     define input  parameter p-line-2  as character no-undo .
      380     define input  parameter p-line-3  as character no-undo .
      381     define output parameter p-message as character no-undo .
      382     do
      383     on error undo, return error return-value
      384     :
      385       assign
      386         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      387                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      388                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      389       .
      390     end.
      391   end procedure.
      392   function waitfram-join-function returns character
      393     (input p-line-1 as character
      394     ,input p-line-2 as character
      395     ,input p-line-3 as character
      396     ).
      397     define variable v-message as character no-undo .
      398     run waitfram-join in this-procedure
      399       (input  p-line-1
      400       ,input  p-line-2
      401       ,input  p-line-3
      402       ,output v-message
      403       ) .
      404     return v-message .
      405   end function .
      406   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
