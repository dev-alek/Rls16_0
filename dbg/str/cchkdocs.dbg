     4049             " " + sort-column-phrase +
     4050           " " + "  "
     4051           )
     4052                              else
     4053           (
     4054           " " + " use-index idel " +
     4055             " " + sort-column-phrase +
     4056           " " + sort-phrase-34
     4057           )
     4058         parameter-7-34 =
     4059           " indexed-reposition  "
     4060       .
     4061         run fltopend_fltfindq in this-procedure  (
     4062                             input this-procedure:handle
     4063                             ,input QUERY br-docs:handle
     4064                             ,input logical(parameter-2-34)
     4065                             ,input no-lock
     4066                             ,input parameter-3-34
     4067                             ,input parameter-4-34
     4068                             ,input parameter-5-34
     4069                             ,input parameter-6-34
     4070                             ,input parameter-7-34
     4071                             ,output v-fltopend-rowid
     4072                             ) no-error.
     4073         .
     4074         v-doc-rec = ?.
     4075       end.
     4076       assign
     4077         l-query-was-opened = true
     4078       .
     4079     end.
     4080   end.
     4081     run waitfram-hide in this-procedure .
     4082       END.
     4083       WHEN 'ДОБАВЛЕНИЕ':U        THEN DO:
     4084        assign
     4085        filter-point = filter-point0 + p-mode
     4086        filter-label = substitute("&1 созданные вручную чеки", filter-label0)
     4087        frame Dialog-Frame :title = substitute("Чеки, созданные вручную  в &1&2", p-obj-type, p-obj-code)
     4088        .
     4089   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4090   define variable  l-disable-where-36  as logical   no-undo .
     4091   define variable  l-filter-open-36    as logical   .
     4092   define variable  flt-rec-36       as recid     no-undo .
     4093   define variable  filter-name-36      as character no-undo .
     4094   define variable  where-phrase-36     as character no-undo .
     4095   define variable  sort-phrase-36      as character no-undo .
     4096   define variable  where-phrase-rus-36 as character no-undo .
     4097   define variable  sort-phrase-rus-36  as character no-undo .
     4098     run waitfram-show in this-procedure
     4099       (input "ЖДИТЕ ..."
     4100       ).
     4101   run gbl/flt-get.p
     4102     (input filter-point
     4103     ,output flt-rec-36
     4104     ,output filter-name-36
     4105     ,output where-phrase-36
     4106     ,output sort-phrase-36
     4107     ,output where-phrase-rus-36
     4108     ,output sort-phrase-rus-36
     4109     ).
     4110   if p-open-query then do:
     4111       run set-filter-name in this-procedure
     4112         (INPUT filter-name-36
     4113         ) no-error .
     4114     assign
     4115       l-filter-open-36 = false
     4116     .
     4117     if flt-rec-36 <> ?
     4118       or sort-column-phrase > ""
     4119     then do:
     4120       define variable  parameter-2-36 as character no-undo .
     4121       define variable  parameter-3-36 as character no-undo .
     4122       define variable  parameter-4-36 as character no-undo .
     4123       define variable  parameter-5-36 as character no-undo .
     4124       define variable  parameter-6-36 as character no-undo .
     4125       define variable  parameter-7-36 as character no-undo .
     4126         assign
     4127         parameter-3-36 =
     4128                                 "FOR EACH X_c-chk-doc"
     4129         parameter-4-36 =
     4130           (
     4131             if (" X_c-chk-doc.obj-type = p-obj-type and X_c-chk-doc.obj-code = p-obj-code and X_c-chk-doc.is-add = yes " + " " + where-phrase-36) <> ""
     4132             then  substitute('X_c-chk-doc.obj-type = &1&2&1 and X_c-chk-doc.obj-code = &3 and X_c-chk-doc.is-add = yes '                                 , chr(34), p-obj-type, p-obj-code) + " " + where-phrase-36
     4133             else "true"
     4134           )
     4135         parameter-5-36 = (" " + "" + " " + "")
     4136         parameter-6-36 = if sort-phrase-36 = ''
     4137                              then
     4138           (
     4139           " " + " use-index iadd " +
     4140             " " + sort-column-phrase +
     4141           " " + "  "
     4142           )
     4143                              else
     4144           (
     4145           " " + " use-index iadd " +
     4146             " " + sort-column-phrase +
     4147           " " + sort-phrase-36
     4148           )
     4149         parameter-7-36 =
     4150           " indexed-reposition  "
     4151       .
     4152       do
     4153       on stop undo, leave
     4154       on error undo, leave
     4155       :
     4156         assign
     4157           l-disable-where-36 =
     4158             (" X_c-chk-doc.obj-type = p-obj-type and X_c-chk-doc.obj-code = p-obj-code and X_c-chk-doc.is-add = yes " + " " + where-phrase-36 = "")
     4159         .
     4160         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4161                             ,input QUERY br-docs:handle
     4162                             ,input parameter-3-36
     4163                             ,input parameter-4-36
     4164                             ,input parameter-5-36
     4165                             ,input parameter-6-36
     4166                             ,input parameter-7-36
     4167                             )
     4168         .
     4169         assign
     4170           l-filter-open-36 = true
     4171         .
     4172       end.
     4173       if l-filter-open-36 = false then do:
     4174         message
     4175           "Ошибка при фильтрации / сортировке" skip
     4176           "Будут показаны записи без учета фильтра" skip
     4177           view-as alert-box .
     4178       end.
     4179       else do:
     4180           assign
     4181             l-query-was-opened = true
     4182           .
     4183       end.
     4184     end.
     4185     if l-filter-open-36 = false then do:
     4186       OPEN QUERY br-docs FOR EACH X_c-chk-doc
     4187         where  X_c-chk-doc.obj-type = p-obj-type and X_c-chk-doc.obj-code = p-obj-code and X_c-chk-doc.is-add = yes
     4188          use-index iadd
     4189         indexed-reposition
     4190     .
     4191         assign
     4192           l-query-was-opened = true
     4193         .
     4194     end.
     4195   end.
     4196   else do:
     4197     assign
     4198       v-doc-rec = recid( X_c-chk-doc )
     4199     .
     4200     do
     4201     on stop undo, leave
     4202     on error undo, leave
     4203     :
     4204       if QUERY br-docs:handle:get-buffer-handle(1) = (buffer X_c-chk-doc:handle) then do:
     4205         assign
     4206         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     4207         parameter-4-36 =
     4208           "where ":u +  substitute('X_c-chk-doc.obj-type = &1&2&1 and X_c-chk-doc.obj-code = &3 and X_c-chk-doc.is-add = yes '                                 , chr(34), p-obj-type, p-obj-code) + " ":u + where-phrase-36 + " ":u + p-find-condition + " " + ""
     4209         parameter-5-36 = " use-index iadd "
     4210       .
     4211         run fltopend_fltfindd in this-procedure  (
     4212                             input this-procedure:handle
     4213                             ,input QUERY br-docs:handle
     4214                             ,input rowid(X_c-chk-doc)
     4215                             ,input logical(parameter-2-36)
     4216                             ,input no-lock
     4217                             ,input (buffer X_c-chk-doc:handle)
     4218                             ,input parameter-4-36
     4219                             ,input parameter-5-36
     4220                             ) no-error.
     4221         .
     4222         assign
     4223           v-doc-rec = integer(return-value)
     4224           v-fltopend-rowid[1] = ?
     4225         .
     4226       end.
     4227       else do:
     4228         assign
     4229         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     4230         parameter-3-36 =  "FOR EACH X_c-chk-doc"
     4231         parameter-4-36 =
     4232           (
     4233             if (" X_c-chk-doc.obj-type = p-obj-type and X_c-chk-doc.obj-code = p-obj-code and X_c-chk-doc.is-add = yes " + " " + where-phrase-36) <> ""
     4234             then  substitute('X_c-chk-doc.obj-type = &1&2&1 and X_c-chk-doc.obj-code = &3 and X_c-chk-doc.is-add = yes '                                 , chr(34), p-obj-type, p-obj-code) + " " + where-phrase-36
     4235             else "true"
     4236           )
     4237         parameter-5-36 = (" " + "" + " " + "" + " " + p-find-condition)
     4238         parameter-6-36 = if sort-phrase-36 = ''
     4239                              then
     4240           (
     4241           " " + " use-index iadd " +
     4242             " " + sort-column-phrase +
     4243           " " + "  "
     4244           )
     4245                              else
     4246           (
     4247           " " + " use-index iadd " +
     4248             " " + sort-column-phrase +
     4249           " " + sort-phrase-36
     4250           )
     4251         parameter-7-36 =
     4252           " indexed-reposition  "
     4253       .
     4254         run fltopend_fltfindq in this-procedure  (
     4255                             input this-procedure:handle
     4256                             ,input QUERY br-docs:handle
     4257                             ,input logical(parameter-2-36)
     4258                             ,input no-lock
     4259                             ,input parameter-3-36
     4260                             ,input parameter-4-36
     4261                             ,input parameter-5-36
     4262                             ,input parameter-6-36
     4263                             ,input parameter-7-36
     4264                             ,output v-fltopend-rowid
     4265                             ) no-error.
     4266         .
     4267         v-doc-rec = ?.
     4268       end.
     4269       assign
     4270         l-query-was-opened = true
     4271       .
     4272     end.
     4273   end.
     4274     run waitfram-hide in this-procedure .
     4275       END.
     4276   END CASE.
     4277   if not p-open-query then
     4278   REPOSITION br-docs to recid v-doc-rec No-ERROR.
     4279   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4280   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4281   run waitfram-hide in this-procedure .
     4282   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     4283   APPLY "ENTRY" TO br-docs.
     4284   END PROCEDURE.
     4285   PROCEDURE proc-b-lkp :
     4286   define variable next-prev as character no-undo .
     4287   define variable v-doc-rec as recid no-undo .
     4288   if not available X_c-chk-doc then return.
     4289   v-doc-rec = recid(X_c-chk-doc).
     4290   DO WHILE next-prev = '':U:
     4291     if NOT available X_c-chk-doc then do:
     4292       message "Неправильно выбрана запись истории чека." view-as alert-box ERROR.
     4293       return no-apply.
     4294     end.
     4295     v-doc-rec = recid (X_c-chk-doc).
     4296     run str/suprcchk.w (
     4297                      input parparentproc
     4298                     ,input 'ПРОСМОТР':U
     4299                     ,input X_c-chk-doc.obj-type
     4300                     ,input X_c-chk-doc.obj-code
     4301                     ,input-output v-doc-rec
     4302                     ,input this-procedure:handle
     4303                     ,input-output next-prev
     4304                                 ) no-error.
     4305     END .
     4306   reposition br-docs to recid v-doc-rec no-error.
     4307   apply "entry" to br-docs in frame Dialog-Frame.
     4308   apply "value-changed" to br-docs in frame Dialog-Frame.
     4309   END PROCEDURE.
     4310   PROCEDURE proc-b-print :
     4311   define variable date_string     as      char    no-undo.
     4312   define variable Line                as      char    no-undo.
     4313   define variable for-time as char.
     4314   define variable accum-count as integer.
     4315   define variable v-time as character no-undo .
     4316   define variable v-shift-name-num as character no-undo .
     4317   define variable v-header-base-curr as character no-undo .
     4318   define variable v-curr-r-b as character no-undo .
     4319   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     4320   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4321   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4322     (output v-curr-r-b
     4323     )  .
     4324   if v-curr-r-b = 'base':U then do:
     4325     assign
     4326     v-header-base-curr = string( "( Б.Вал. - " + caps( v-base-type ) + " )" )
     4327     .
     4328   end.
     4329   DEFINE FRAME Chk-List
     4330   X_c-chk-doc.corr-date COLUMN-LABEL "Дата корр"
     4331   v-time                COLUMN-LABEL "Время корр"
     4332   X_c-chk-doc.corr-user-db-num
     4333   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     4334   X_c-chk-doc.is-add FORMAT "+/"
     4335   X_c-chk-doc.is-del FORMAT "+/"
     4336   X_c-chk-doc.office       column-label "Тип_"                format "X(8)"
     4337   X_c-chk-doc.doc-code      column-label "Номер_чека"  format "X(17)"
     4338   X_c-chk-doc.chk-num       column-label "N_по_кассе" format "->>>>>>9"
     4339   X_c-chk-doc.chk-date       column-label "Дата" format "99/99/9999"
     4340   for-time                  column-label "Время"   format "X(5)"
     4341   X_c-chk-doc.shift-date      column-label "Смена_от" format "99/99/9999"
     4342   v-shift-name-num      column-label "N_см."  FORMAT "X(6)"
     4343   X_c-chk-doc.netto             column-label "Сумма_оплат"
     4344   X_c-chk-doc.pay-desk      column-label "Касса"
     4345   X_c-chk-doc.cashier         column-label "Кассир"       format ">>>>9"
     4346   X_c-chk-doc.sales-man    column-label "Прод-ц"       format ">>>>9"
     4347   X_c-chk-doc.out-code       column-label "Номер_РН"
     4348   v_d-card           column-label "Номер_диск._карты"              space(0)
     4349   HEADER  date_string AT 5 format "X(35)"
     4350   v-header-base-curr        format "X(20)" AT 42
     4351   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     4352   Line format "X(198)" AT 1
     4353   with width 232 down stream-io use-text    .
     4354   Line = fill("-", 198).
     4355   date_string = cur-time-print() .
     4356   run prn-lib-open-stream  in this-procedure (
     4357                                       input parParentProc
     4358                                       ,input 43
     4359                                       ,input yes
     4360                                       ,input no
     4361                                       ).
     4362   v-doc-rec = recid( X_c-chk-doc ).
     4363   DO WHILE available X_c-chk-doc :
     4364         GET prev br-docs.
     4365   END.
     4366   PUT  STREAM PrnLibStream
     4367   SPACE(25) ( frame Dialog-Frame:title )
     4368   format "x(90)" SKIP(1) .
     4369   FORM HEADER
     4370   Line format "X(198)" AT 1 SKIP
     4371   "Продолжение - на следующей странице" AT 30 SKIP
     4372   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4373   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4374   FORM with FRAME Chk-List  .
     4375   run waitfram-show in this-procedure ( input "Ждите...").
     4376   GET next br-docs.
     4377   DO WHILE available X_c-chk-doc :
     4378     if par-l-mask then v_d-card = substring(X_c-chk-doc.d-card,1,6) + "XXXXXX" + substring (X_c-chk-doc.d-card,13,4).
     4379     else v_d-card = X_c-chk-doc.d-card .
     4380     Display STREAM PrnLibStream
     4381     X_c-chk-doc.corr-date
     4382     string(X_c-chk-doc.corr-time, "HH:MM") @ v-time
     4383     X_c-chk-doc.corr-user-db-num
     4384     usrfulnf(X_c-chk-doc.corr-user-name) @ v-for-user-name
     4385     X_c-chk-doc.is-add
     4386     X_c-chk-doc.is-del
     4387     X_c-chk-doc.office
     4388     X_c-chk-doc.doc-code
     4389     X_c-chk-doc.chk-num
     4390     X_c-chk-doc.chk-date
     4391     string(X_c-chk-doc.chk-time, "HH:mm") @ for-time
     4392     X_c-chk-doc.shift-date
     4393     shift-name-no-err(buffer X_c-chk-doc) @ v-shift-name-num
     4394     X_c-chk-doc.netto
     4395     X_c-chk-doc.pay-desk
     4396     X_c-chk-doc.cashier
     4397     X_c-chk-doc.sales-man
     4398     if X_c-chk-doc.out-code <> ? then X_c-chk-doc.out-code else "" @ X_c-chk-doc.out-code
     4399     v_d-card
     4400     with FRAME Chk-List .
     4401   DOWN STREAM PrnLibStream 1 with FRAME CHk-List  .
     4402   assign
     4403   accum-count = accum-count + 1
     4404   .
     4405   GET next br-docs.
     4406   END.
     4407   UNDERLINE  STREAM PrnLibStream
     4408   X_c-chk-doc.corr-date
     4409   v-time
     4410   X_c-chk-doc.corr-user-db-num
     4411   v-for-user-name
     4412   X_c-chk-doc.is-add
     4413   X_c-chk-doc.is-del
     4414   X_c-chk-doc.office
     4415   X_c-chk-doc.doc-code
     4416   X_c-chk-doc.chk-num
     4417   X_c-chk-doc.chk-date
     4418   for-time
     4419   X_c-chk-doc.shift-date
     4420   v-shift-name-num
     4421   X_c-chk-doc.netto
     4422   X_c-chk-doc.pay-desk
     4423   X_c-chk-doc.cashier
     4424   X_c-chk-doc.sales-man
     4425   X_c-chk-doc.out-code
     4426   v_d-card
     4427   with FRAME Chk-List .
     4428   DISPLAY STREAM PrnLibStream
     4429   "ИТОГО"  @ X_c-chk-doc.doc-code
     4430   accum-count @ X_c-chk-doc.chk-num
     4431   with frame Chk-List.
     4432   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4433   HIDE  STREAM PrnLibStream FRAME fin-bank-List.
     4434   output  STREAM PrnLibStream CLOSE.
     4435   REPOSITION br-docs to recid v-doc-rec no-error.
     4436   APPLY "entry" to br-docs.
     4437   run waitfram-hide in this-procedure .
     4438   run prn-lib-prn-file in this-procedure (
     4439                                             input parParentProc
     4440                                             ,input 8
     4441                                             ).
     4442   END PROCEDURE.
     4443   PROCEDURE proc-b-restore :
     4444   define variable glog as logical no-undo .
     4445     if available X_c-chk-doc
     4446     then do:
     4447       define variable v-chk-act-host-code as integer   no-undo .
     4448   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4450     (input  X_c-chk-doc.obj-type
     4451     ,input  X_c-chk-doc.obj-code
     4452     ,output v-chk-act-host-code
     4453     )  .
     4454   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4455   do:
     4456     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4457       (input  v-cntxt-db-num
     4458       ,input  v-cntxt-userid
     4459       ,input  0
     4460       ,input  'actn_receipt_input':U
     4461       ,input  'object':U
     4462       ,input  v-chk-act-host-code
     4463       ,input  X_c-chk-doc.obj-type
     4464       ,input  X_c-chk-doc.obj-code
     4465       ,input  0
     4466       ,input  0
     4467       ,input  0
     4468       ,input  true
     4469       ,output glog
     4470       )  .
     4471   end.
     4472       if NOT glog then  return error.
     4473       glog = no.
     4474       message
     4475       "Вы уверены, что хотите ВОССТАНОВИТЬ данный чек?"
     4476       view-as alert-box question buttons yes-no update glog.
     4477       if not glog then return.
     4478       run str/chk-rest.p ( input X_c-chk-doc.doc-code) no-error.
     4479       if error-status:error then do:
     4480         message
     4481         substitute("Ошибка при восстановлении чека &1&2&3&2&4"
     4482                     , X_c-chk-doc.doc-code
     4483                     ,chr(10)
     4484                     , error-status:get-message(1)
     4485                     , return-value
     4486                     )
     4487         view-as alert-box error.
     4488       end.
     4489     end.
     4490     get prev br-docs.
     4491     if available X_c-chk-doc then do:
     4492       assign
     4493       v-doc-rec = recid(X_c-chk-doc).
     4494     end.
     4495     run OpenBr in this-procedure ( input yes, input no, input '':U).
     4496     APPLY "ENTRY" to br-docs in frame Dialog-Frame .
     4497   END PROCEDURE.
     4498   PROCEDURE proc-b-sch :
     4499   assign
     4500     tbl = 'c-chk-doc'
     4501     join-tbl = 'X_c-chk-doc'
     4502     fld = ""
     4503     lab = ""
     4504     spr = ""
     4505     dim = '0'
     4506     .
     4507   run fltfield-add in this-procedure('corr-date', '', '',
     4508   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4509   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4510   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4511   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4512   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4513   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4514   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4515   run fltfield-add in this-procedure('doc-code', 'Номер в базе', '',
     4516   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4517   run fltfield-add in this-procedure('chk-date', '', '',
     4518   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4519   run fltfield-add in this-procedure('chk-time', '', 'time',
     4520   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4521   run fltfield-add in this-procedure('office', '', '',
     4522   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4523   run fltfield-add in this-procedure('shift-date', 'Смена от', '',
     4524   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4525   run fltfield-add in this-procedure('shift-num', 'Порядок смен', '',
     4526   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4527   run fltfield-add in this-procedure('chk-num', 'Номер по кассе', '',
     4528   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4529   run fltfield-add in this-procedure('pay-desk', '', '',
     4530   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4531   run fltfield-add in this-procedure('cashier', '', '',
     4532   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4533   run fltfield-add in this-procedure('sales-man', '', '',
     4534   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4535   run fltfield-add in this-procedure('tot-doc', '', '',
     4536   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4537   run fltfield-add in this-procedure('discnt', '', '',
     4538   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4539   run fltfield-add in this-procedure('sub-discnt', 'Списания', '',
     4540   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4541   run fltfield-add in this-procedure('netto', 'Нетто сумма (выручка)', '',
     4542   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4543   run fltfield-add in this-procedure('out-code', 'Номер продажи', '',
     4544   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4545   run fltfield-add in this-procedure('d-card', 'N дис.карты', '',
     4546   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4547   Filter-Block:
     4548   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4549       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4550       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4551     run gbl/filter.w (
     4552                       input parparentproc
     4553                     , INPUT (filter-point + chr(4) + filter-label)
     4554                     , INPUT tbl
     4555                     , INPUT join-tbl
     4556                     , INPUT fld
     4557                     , INPUT lab
     4558                     , INPUT spr
     4559                     , INPUT dim ).
     4560     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4561   END.
     4562   END PROCEDURE.
     4563   PROCEDURE proc-view-changes :
     4564   define buffer new_c-chk-doc for ub.c-chk-doc.
     4565   define buffer current_chk-doc for ub.chk-doc.
     4566   define variable v-chg-fields as character no-undo.
     4567   define variable v-old-fields as character no-undo.
     4568   define variable v-new-fields as character no-undo.
     4569   define variable ii as integer no-undo.
     4570   define variable jj as integer no-undo .
     4571   define variable v-field-name as character no-undo .
     4572   define variable v-field-label as character no-undo .
     4573   define variable v-field-function as character no-undo .
     4574   define variable v-real-field-name as character no-undo .
     4575   for each temp-changes:
     4576       delete temp-changes.
     4577   END.
     4578   if not available X_c-chk-doc then do:
     4579     Open QUery br-changes for each temp-changes.
     4580     return.
     4581   end.
     4582   if X_c-chk-doc.is-del then do:
     4583     assign
     4584     v-chg-fields = get-all-fields("chk-doc")
     4585     .
     4586     run get-line-changes-hist in this-procedure (
     4587                                                  input X_c-chk-doc.doc-code
     4588                                                , input X_c-chk-doc.chip-num
     4589                                                , input X_c-chk-doc.chip-num
     4590                                                , input X_c-chk-doc.is-add and X_c-chk-doc.chip-num = 1
     4591                                                , input X_c-chk-doc.is-del).
     4592   end.
     4593   else do:
     4594     find first new_c-chk-doc no-lock where
     4595                 new_c-chk-doc.doc-code = X_c-chk-doc.doc-code
     4596                   AND new_c-chk-doc.chip-num > X_c-chk-doc.chip-num no-error.
     4597     if not available new_c-chk-doc then do:
     4598         find first current_chk-doc no-lock where
     4599                     current_chk-doc.doc-code = X_c-chk-doc.doc-code no-error.
     4600         if not available current_chk-doc then do:
     4601             return error.
     4602         end.
     4603         buffer-compare current_chk-doc except PS to X_c-chk-doc
     4604         case-sensitive
     4605         save result in v-chg-fields.
     4606         run get-line-changes-current in this-procedure ( input X_c-chk-doc.chip-num).
     4607     end.
     4608     else do:
     4609         buffer-compare new_c-chk-doc except PS  chip-num corr-date corr-user-name corr-user-db-num  to X_c-chk-doc
     4610         case-sensitive
     4611         save result in v-chg-fields.
     4612         run get-line-changes-hist in this-procedure (
     4613                                                      input X_c-chk-doc.doc-code
     4614                                                    , input X_c-chk-doc.chip-num
     4615                                                    , input new_c-chk-doc.chip-num
     4616                                                    , input X_c-chk-doc.is-add and X_c-chk-doc.chip-num = 1
     4617                                                    , input X_c-chk-doc.is-del
     4618                                                    ).
     4619     end.
     4620   end.
     4621     _ii:
     4622     do ii = 1 to num-entries(v-chg-fields):
     4623       assign
     4624       v-field-name = entry(ii, v-chg-fields)
     4625       jj = lookup(v-field-name, "cash-rate,cash-scale,cashier,cashier-psn-code,chk-date,chk-num,chk-time,chk-type," +                        "correct,d-card,d-pcnt,discnt,doc-code,doc-num,doc-qnty,netto,obj-code,obj-type,office," +                        "out-code,pay-desk,price-type,PS,sales-man,salesman-psn-code,shift-date,shift-num,src-d-pcnt," +                        "src-shift-date,tot-doc,z-number").
     4626       if jj = 0 then next _ii.
     4627       assign
     4628       v-field-label = entry(jj, "Курс валюты кассы,Масштаб ваюты кассы,Кассир,Код кассира в БД,Дата,№ Чек на кассе,Время,Тип чека,"  +                          "OK,Дисконтная карта,Процент скидки,Скидка общая,Номер,Номер документа,Количество,Сумма оплат,Код объекта,Тип объекта,Тип," +                          "Номер РН,Касса,Тип цены,Примечание,Продавец,Код продавца в БД,Дата смены (учета),Порядок Смен,Процент скидки на кассе," +                          "Дата смены на кассе,Сумма ценах продажи,Номер z-отчета")
     4629       v-real-field-name = entry(1, v-field-name, ':')
     4630       .
     4631       create temp-changes.
     4632       assign
     4633       temp-changes.f_name = substitute("chk-doc&1&2"
     4634                                        ,chr(4)
     4635                                        ,v-field-name)
     4636       temp-changes.l_name = substitute("Шапка чека &1"
     4637                                        ,v-field-label)
     4638       temp-changes.v_old = (if X_c-chk-doc.is-add  and X_c-chk-doc.chip-num = 1
     4639                             then "":U
     4640                             else string(buffer X_c-chk-doc:buffer-field(v-field-name):buffer-value))
     4641       temp-changes.v_new = (if X_c-chk-doc.is-del
     4642                             then "":U
     4643                             else (if X_c-chk-doc.is-add  and X_c-chk-doc.chip-num = 1
     4644                                   then string(buffer X_c-chk-doc:buffer-field(v-field-name):buffer-value)
     4645                                   else (if available new_c-chk-doc
     4646                                           then string(buffer new_c-chk-doc:buffer-field(v-field-name):buffer-value)
     4647                                           else string(buffer current_chk-doc:buffer-field(v-field-name):buffer-value)
     4648                                         )
     4649                                 )
     4650                             )
     4651       .
     4652   end.
     4653   Open QUery br-changes for each temp-changes.
     4654   END PROCEDURE.
     4655   PROCEDURE reposition-c-chk-doc :
     4656   define input  parameter p-direction   as character no-undo .
     4657   define output parameter p-chk-doc-recid as recid no-undo .
     4658     case p-direction :
     4659       when "first":U
     4660       then do:
     4661         get first br-docs.
     4662       end.
     4663       when "last":U
     4664       then do:
     4665         get last br-docs.
     4666       end.
     4667       when "prev":U
     4668       then do:
     4669         get prev br-docs.
     4670         if not available X_c-chk-doc then do:
     4671           message
     4672           "Это первый чек списка"
     4673           view-as alert-box.
     4674         end.
     4675       end.
     4676       when "next":U
     4677       then do:
     4678         get next br-docs.
     4679         if not available X_c-chk-doc then do:
     4680           message
     4681           "Это последний чек списка"
     4682           view-as alert-box.
     4683         end.
     4684       end.
     4685     end case .
     4686     assign
     4687     p-chk-doc-recid = recid(X_c-chk-doc)
     4688     .
     4689     run reposition-query in this-procedure
     4690       (input p-chk-doc-recid
     4691       ).
     4692   END PROCEDURE.
     4693   PROCEDURE reposition-query :
     4694   define input parameter p-recid as recid no-undo .
     4695     if p-recid <> ?
     4696     then do:
     4697       reposition br-docs to recid p-recid no-error.
     4698     end.
     4699     do with frame Dialog-Frame:
     4700       apply "entry":u to browse BR-changes .
     4701       apply "VALUE-CHANGED":u to browse BR-changes .
     4702     end.
     4703   END PROCEDURE.
