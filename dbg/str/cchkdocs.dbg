     1405   define variable v-value-decimal as decimal no-undo .
     1406   define variable v-value-integer as INTEGER no-undo .
     1407   define variable v-value-logical AS LOGICAL no-undo .
     1408   define variable v-tth as handle no-undo .
     1409   define variable par-l-mask  as logical no-undo .
     1410   define variable v-param-type as character no-undo .
     1411   define variable v_d-card  as character no-undo .
     1412   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1413   define variable paycardv as character no-undo .
     1414   FUNCTION f-paycardv RETURNS CHARACTER(input p-pay-card as character, p-cash-pay-obj-code as integer, p-cash-pay-curr-code as integer):
     1415   define variable kk as integer no-undo .
     1416   define variable pay-card-num as character no-undo .
     1417   define buffer buf_cash-pay for ub.cash-pay.
     1418   find first buf_cash-pay no-lock where
     1419              buf_cash-pay.cdpay-code = p-cash-pay-obj-code
     1420          AND buf_cash-pay.curr-code = p-cash-pay-curr-code no-error .
     1421   if not avail buf_cash-pay then return "":U.
     1422   if p-pay-card = "":u
     1423   or p-pay-card = ? then return "":U.
     1424   assign
     1425   pay-card-num = "":U
     1426   .
     1427   _kk:
     1428   do kk = 1 to num-entries(buf_cash-pay.pay-card-view):
     1429     if p-pay-card begins entry(kk, buf_cash-pay.pay-card-view) then do:
     1430       assign
     1431       pay-card-num = p-pay-card
     1432       .
     1433       return pay-card-num.
     1434     end.
     1435   end.
     1436   if pay-card-num = "":u then do:
     1437     if length(p-pay-card) > 4 then
     1438     assign
     1439     pay-card-num = fill("*":U, length(p-pay-card) - 4) +
     1440                     substr(p-pay-card, (length(p-pay-card) - 3), 4)
     1441     .
     1442     else
     1443     return fill("*":U, length(p-pay-card)).
     1444   end.
     1445   return pay-card-num.
     1446   END FUNCTION.
     1447   FUNCTION get-wro-name returns character(input p-write-off-code as integer):
     1448   return entry (lookup ((if p-write-off-code = ? then chr(63) else string(p-write-off-code)),  '?,0,1,-6,-9,2,-2,3,-3,-4,17':U), ',,Без_оплаты,Отмена_позиции,Полн_Отмена,Модификатор,Модификатор,Модификатор(+спис),Модификатор(-спис),Модификатор(-спис),Техпролив':U).
     1449   END FUNCTION.
