     1535        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1536        SPACE(78.50) SKIP(18.67)
     1537       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1538            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1539            TITLE ""
     1540            CANCEL-BUTTON b-quit.
     1541   ASSIGN
     1542          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1543          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1544   ASSIGN
     1545          BR-docs:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1546   ON GO OF FRAME Dialog-Frame
     1547   DO:
     1548     p-rid-list = v-rid-list.
     1549   END.
     1550   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1551   DO:
     1552     APPLY "END-ERROR":U TO SELF.
     1553   END.
     1554   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1555   DO:
     1556     run proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     1557     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1558   END.
     1559   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1560   DO:
     1561     if available X_c-chk-doc then do:
     1562   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1563   define variable v-str-recid19 as character no-undo .
     1564   define variable v-num-entry19 as integer   no-undo .
     1565   assign
     1566     v-str-recid19 = trim( string( recid( X_c-chk-doc ) , "->>>>>>>>>>>9":U ) )
     1567     v-num-entry19 = lookup( v-str-recid19 , v-rid-list )
     1568   .
     1569   if v-num-entry19 > 0 then do:
     1570     assign
     1571       entry( v-num-entry19, v-rid-list ) = "":U
     1572       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1573     .
     1574   end.
     1575   else do:
     1576     assign
     1577       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid19
     1578     .
     1579   end.
     1580       glog = br-docs:refresh() .
     1581       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1582           glog = br-docs:select-next-row ().
     1583           apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1584       end.
     1585       if num-entries( v-rid-list ) = 0
     1586       then
     1587           hide mark-num in frame Dialog-Frame.
     1588       else
     1589           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1590     end.
     1591     apply "entry" to br-docs in frame Dialog-Frame.
     1592   END.
     1593   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1594   DO:
     1595       run proc-b-print in this-procedure no-error.
     1596     if error-status:error then return no-apply.
     1597   END.
     1598   ON CHOOSE OF b-restore IN FRAME Dialog-Frame
     1599   DO:
     1600     run proc-b-restore IN THIS-PROCEDURE NO-ERROR.
     1601     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1602   END.
     1603   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1604   DO:
     1605     run proc-b-sch in this-procedure no-error.
     1606     if error-status:error then return no-apply.
     1607   END.
     1608   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1609   DO:
     1610     if ( available X_c-chk-doc ) AND
     1611     ( v-rid-list = ""
     1612     or
     1613     b-mark:sensitive = no
     1614     ) then
     1615       v-rid-list = string( recid( X_c-chk-doc ) ) .
     1616   END.
     1617   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     1618   DO:
     1619     if b-mark:sensitive in frame Dialog-Frame then
     1620     APPLY "CHOOSE" to b-mark.
     1621   END.
     1622   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     1623   DO:
     1624     if b-mark:sensitive in frame Dialog-Frame then
     1625     APPLY "CHOOSE" to b-mark.
     1626       else do:
     1627         if b-sel:sensitive in frame Dialog-Frame then
     1628         APPLY "CHOOSE" to b-sel.
     1629       end.
     1630   END.
     1631   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1632   OR MOUSE-SELECT-DBLCLICK OF BR-docs IN FRAME Dialog-Frame
     1633   DO:
     1634   if b-sel:sensitive in frame Dialog-Frame then dO:
     1635       if b-mark:sensitive then do:
     1636           apply "choose" to b-mark in frame Dialog-Frame.
     1637       end.
     1638       else do:
     1639           apply "choose" to b-sel in frame Dialog-Frame.
     1640       end.
     1641   end.
     1642   END.
     1643   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
     1644   DO:
     1645       DEFINE VARIABLE dops as character no-undo .
     1646     dops = if available X_c-chk-doc then X_c-chk-doc.ps else '':U.
     1647     ED-notes:screen-value = dops.
     1648     run proc-view-changes in this-procedure .
     1649   END.
     1650   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1651   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1652   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1653   on help of frame Dialog-Frame
     1654   do:
     1655     run gbl/app_help.p
     1656       (input this-procedure :file-name
     1657       ,input ''
     1658       ,input ?
     1659       ) no-error.
     1660     if error-status :error then do:
     1661       message
     1662         "Ошибка при вызове помощи"
     1663         error-status :get-message(1)
     1664         view-as alert-box .
     1665     end.
     1666   end.
     1667   run minbtn-set in this-procedure .
     1668   on choose of b-help in frame Dialog-Frame
     1669   do:
     1670     apply "help":u to frame Dialog-Frame .
     1671   end.
     1672   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673   procedure minbtn-set :
     1674       do
     1675           on error undo, return error return-value
     1676           :
     1677           define variable ii              as integer       no-undo .
     1678           define variable fh              as widget-handle no-undo .
     1679           define variable hh              as widget-handle no-undo .
     1680           define variable v-h             as handle        extent 4 no-undo .
     1681           define variable v-name-button   as character     no-undo .
     1682           define variable v-help-old-x    as decimal       no-undo .
     1683           define variable v-help-old-y    as decimal       no-undo .
     1684           define variable v-help-old-size as decimal       no-undo .
     1685           define variable v-frame-width   as decimal       no-undo .
     1686           define variable jj              as integer       no-undo .
     1687           do
     1688               on error undo, return error
     1689               :
     1690               assign
     1691                   v-frame-width = frame Dialog-Frame:width - 0.3
     1692                   fh            = frame Dialog-Frame:first-child
     1693                   hh            = fh:first-child
     1694                   ii            = 1
     1695                   .
     1696               do while valid-handle(hh):
     1697                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1698                   do:
     1699                       case lc(hh:name) :
     1700                           when "b-help" then
     1701                               do:
     1702                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1703                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1704                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1705                                   hh:TOOLTIP = "Помощь" .
     1706                                   v-help-old-x = hh:column .
     1707                                   v-help-old-y = hh:row    .
     1708                                   v-help-old-size = hh:width .
     1709                                   hh:width-chars = 2.5 .
     1710                               end.
     1711                           when "b-print" then
     1712                               do:
     1713                                   hh:load-image("cmp/b-print.bmp":u) .
     1714                                   hh:TOOLTIP = "Печать" .
     1715                                   v-h[ii] = hh:handle .
     1716                                   ii = ii + 1 .
     1717                                   hh:width-chars = 3 .
     1718                               end.
     1719                           when "b-history" or
     1720                           when "b-hist" then
     1721                               do:
     1722                                   hh:load-image("cmp/b-hist.bmp":u) .
     1723                                   hh:TOOLTIP = "История" .
     1724                                   v-h[ii] = hh:handle .
     1725                                   ii = ii + 1 .
     1726                                   hh:width-chars = 3 .
     1727                               end.
     1728                           when "b-sch" then
     1729                               do:
     1730                                   hh:load-image("cmp/b-sch.bmp":u) .
     1731                                   hh:TOOLTIP = "Установка Фильтра" .
     1732                                   v-h[ii] = hh:handle .
     1733                                   ii = ii + 1 .
     1734                                   hh:width-chars = 3 .
     1735                               end.
     1736                           when "b-hist-user" then
     1737                               do:
     1738                                   hh:load-image("cmp/b-hist.bmp":u) .
     1739                                   hh:TOOLTIP = "История пользователя" .
     1740                                   ii = ii + 1 .
     1741                               end.
     1742                       end case.
     1743                   end.
     1744                   hh = hh:next-sibling.
     1745               end.
     1746               b-help:column = v-frame-width - b-help:width-chars.
     1747               jj = 0.
     1748               repeat ii = 4 to 1 by -1 :
     1749                   if valid-handle (v-h[ii] ) then
     1750                   do:
     1751                       jj  = jj + 1 .
     1752                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1753                       v-h[ii]:row    = v-help-old-y .
     1754                   end.
     1755               end.
     1756           end.
     1757       end.
     1758   end procedure.
     1759   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1760   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1761   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1762   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1763   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1764   define variable v-diasize-current-frame-height as decimal   no-undo .
     1765   define variable v-diasize-change-size          as logical   no-undo .
     1766   define variable v-diasize-resize-button        as handle    no-undo .
     1767   define variable v-diasize-wndmax               as logical   no-undo .
     1768   define variable v-diasize-wndstore             as logical   no-undo .
     1769   define variable v-diasize-proc-name            as character no-undo .
     1770   define variable v-diasize-browse-handle        as handle    no-undo .
     1771   define variable v-diasize-browse-number        as integer   no-undo .
     1772   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1773   define temp-table temp-diasize-handle no-undo
     1774     field handle-value  as handle
     1775     field save-position as decimal
     1776     index xpk is primary unique handle-value
     1777     .
     1778   define temp-table temp-browse-handle no-undo
     1779     field browse-type   as character
     1780     field browse-number as integer
     1781     field browse-handle as handle
     1782     field original-size as decimal
     1783     index xpk is primary unique browse-type browse-number
     1784     index xie browse-type browse-handle
     1785   .
     1786   procedure diasize_change-height :
     1787     define input  parameter p-change-value  as decimal   no-undo .
     1788     define input  parameter p-move-resize   as logical   no-undo .
     1789     define variable v-field-group-handle    as handle    no-undo .
     1790     define variable v-object-handle         as handle    no-undo .
     1791     define variable v-frame-height          as decimal   no-undo .
     1792     define variable v-frame-virtual-height  as decimal   no-undo .
     1793     define variable v-browse-height         as decimal   no-undo .
     1794     define variable v-window-height         as decimal   no-undo .
     1795     define variable v-window-virtual-height as decimal   no-undo .
     1796     define variable v-change-sign           as integer   no-undo .
     1797     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1798     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1799     if p-change-value > 0
     1800     then do:
     1801       if frame Dialog-Frame :height + p-change-value
     1802           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1803       then do:
     1804         assign
     1805           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1806                           - (frame Dialog-Frame :height-chars)
     1807         .
     1808         if p-change-value <= 0
     1809         then do:
     1810           run diasize_position-resize-button in this-procedure .
     1811           return .
     1812         end.
     1813       end.
     1814     end.
     1815     if p-change-value < 0
     1816     then do:
     1817       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1818       then do:
     1819         assign
     1820           p-change-value = v-diasize-orig-frame-height
     1821                          - (frame Dialog-Frame :height-chars)
     1822         .
     1823         if p-change-value >= 0
     1824         then do:
     1825           run diasize_position-resize-button in this-procedure .
     1826           return .
     1827         end.
     1828       end.
     1829     end.
     1830     if p-change-value >= 0
     1831     then do:
     1832       assign
     1833         v-change-sign = 1
     1834       .
     1835     end.
     1836     else do:
     1837       assign
     1838         v-change-sign = -1
     1839       .
     1840     end.
     1841     assign
     1842       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1843     .
     1844     if p-change-value = 0
     1845     then do:
     1846       run diasize_position-resize-button in this-procedure .
     1847       return .
     1848     end.
     1849     move_block:
     1850     do
     1851     on error undo move_block, retry move_block
     1852     :
     1853       if retry
     1854       then do:
     1855         do
     1856         on error undo move_block, leave move_block
     1857         :
     1858           if p-change-value > 0
     1859           then do:
     1860             for each buf_temp-diasize-handle
     1861             on error undo, next
     1862             :
     1863               assign
     1864                 v-object-handle = buf_temp-diasize-handle.handle-value
     1865               .
     1866               if v-object-handle <> v-diasize-resize-button
     1867               then do:
     1868                 assign
     1869                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1870                 .
     1871               end.
     1872             end.
     1873             assign
     1874               v-diasize-browse-handle :height = v-browse-height
     1875             .
     1876             for each buf_temp-browse-handle
     1877               where buf_temp-browse-handle.browse-type = 'height':u
     1878             on error undo, next
     1879             :
     1880               assign
     1881                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1882               .
     1883             end.
     1884             assign
     1885               frame Dialog-Frame :height = v-frame-height
     1886             .
     1887             if frame Dialog-Frame :scrollable = true
     1888             then do:
     1889               assign
     1890                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1891               .
     1892             end.
     1893             run diasize_position-resize-button in this-procedure .
     1894           end.
     1895           else do:
     1896             if frame Dialog-Frame :scrollable = true
     1897             then do:
     1898               assign
     1899                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1900               .
     1901             end.
     1902             assign
     1903               frame Dialog-Frame :height = v-frame-height
     1904             .
     1905             assign
     1906               v-diasize-browse-handle :height = v-browse-height
     1907             .
     1908             for each buf_temp-browse-handle
     1909               where buf_temp-browse-handle.browse-type = 'height':u
     1910             on error undo, next
     1911             :
     1912               assign
     1913                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1914               .
     1915             end.
     1916             for each buf_temp-diasize-handle
     1917             on error undo, next
     1918             :
     1919               assign
     1920                 v-object-handle = buf_temp-diasize-handle.handle-value
     1921               .
     1922               if v-object-handle <> v-diasize-resize-button
     1923               then do:
     1924                 assign
     1925                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1926                 .
     1927               end.
     1928             end.
     1929             run diasize_position-resize-button in this-procedure .
     1930           end.
     1931           assign
     1932             v-diasize-change-size = false
     1933           .
     1934           leave move_block .
     1935         end.
     1936       end.
     1937       assign
     1938         v-diasize-need-full-display = true
     1939       .
     1940       if v-diasize-change-size = false
     1941       then do:
     1942         assign
     1943           v-diasize-change-size = true
     1944         .
     1945       end.
     1946       else do:
     1947         return .
     1948       end.
     1949       assign
     1950         v-frame-height = frame Dialog-Frame :height
     1951         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1952         v-browse-height = v-diasize-browse-handle :height
     1953       .
     1954       for each buf_temp-browse-handle
     1955         where buf_temp-browse-handle.browse-type = 'height':u
     1956       :
     1957         assign
     1958           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1959         .
     1960       end.
     1961       for each buf_temp-diasize-handle
     1962       :
     1963         delete buf_temp-diasize-handle .
     1964       end.
     1965       assign
     1966         v-field-group-handle = frame Dialog-Frame :first-child
     1967       .
     1968       do while valid-handle(v-field-group-handle)
     1969       :
     1970         assign
     1971           v-object-handle = v-field-group-handle :first-child
     1972         .
     1973         do while valid-handle(v-object-handle)
     1974         :
     1975           if  v-object-handle <> v-diasize-browse-handle :handle
     1976           and can-query(v-object-handle, "row")
     1977           and can-query(v-object-handle, "height")
     1978           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1979           then do:
     1980             find first buf_temp-browse-handle
     1981               where buf_temp-browse-handle.browse-type   = 'height':u
     1982                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1983               no-error .
     1984             if available buf_temp-browse-handle
     1985             then do:
     1986             end.
     1987             else do:
     1988               create buf_temp-diasize-handle .
     1989               assign
     1990                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1991                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1992               .
     1993             end.
     1994           end.
     1995           assign
     1996             v-object-handle = v-object-handle :next-sibling
     1997           .
     1998         end.
     1999         assign
     2000           v-field-group-handle = v-field-group-handle :next-sibling
     2001         .
     2002       end.
     2003       do with frame Dialog-Frame
     2004       :
     2005         hide v-diasize-resize-button .
     2006         assign
     2007           v-diasize-resize-button :row    = 1
     2008           v-diasize-resize-button :column = 1
     2009         .
     2010       end.
     2011       if p-change-value > 0
     2012       then do:
     2013         if frame Dialog-Frame :scrollable = true
     2014         then do:
     2015           assign
     2016             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2017             no-error .
     2018           if error-status :error
     2019           or error-status :get-message(1) <> ""
     2020           then do:
     2021             undo move_block, retry move_block .
     2022           end.
     2023         end.
     2024         assign
     2025           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2026           no-error .
     2027         if error-status :error
     2028         or error-status :get-message(1) <> ""
     2029         then do:
     2030           undo move_block, retry move_block .
     2031         end.
     2032         assign
     2033           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2034           no-error .
     2035         if error-status :error
     2036         or error-status :get-message(1) <> ""
     2037         then do:
     2038           undo move_block, retry move_block .
     2039         end.
     2040         for each buf_temp-browse-handle
     2041           where buf_temp-browse-handle.browse-type = 'height':u
     2042         on error undo move_block, retry move_block
     2043         :
     2044           assign
     2045             buf_temp-browse-handle.browse-handle :height
     2046               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2047             no-error .
     2048           if error-status :error
     2049           or error-status :get-message(1) <> ""
     2050           then do:
     2051             undo move_block, retry move_block .
     2052           end.
     2053         end.
     2054         for each buf_temp-diasize-handle
     2055         on error undo move_block, retry move_block
     2056         :
     2057           assign
     2058             v-object-handle = buf_temp-diasize-handle.handle-value
     2059           .
     2060           if v-object-handle <> v-diasize-resize-button
     2061           then do:
     2062             assign
     2063               v-object-handle :row = v-object-handle :row + p-change-value
     2064               no-error .
     2065             if error-status :error
     2066             or error-status :get-message(1) <> ""
     2067             then do:
     2068               undo move_block, retry move_block .
     2069             end.
     2070           end.
     2071         end.
     2072       end.
     2073       else do:
     2074         for each buf_temp-diasize-handle
     2075         on error undo move_block, retry move_block
     2076         :
     2077           assign
     2078             v-object-handle = buf_temp-diasize-handle.handle-value
     2079           .
     2080           if v-object-handle <> v-diasize-resize-button
     2081           then do:
     2082             assign
     2083               v-object-handle :row = v-object-handle :row + p-change-value
     2084               no-error .
     2085             if error-status :error
     2086             or error-status :get-message(1) <> ""
     2087             then do:
     2088               undo move_block, retry move_block .
     2089             end.
     2090           end.
     2091         end.
     2092         assign
     2093           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2094           no-error .
     2095         if error-status :error
     2096         or error-status :get-message(1) <> ""
     2097         then do:
     2098           undo move_block, retry move_block .
     2099         end.
     2100         for each buf_temp-browse-handle
     2101           where buf_temp-browse-handle.browse-type = 'height':u
     2102         on error undo move_block, retry move_block
     2103         :
     2104           assign
     2105             buf_temp-browse-handle.browse-handle :height
     2106               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2107             no-error .
     2108           if error-status :error
     2109           or error-status :get-message(1) <> ""
     2110           then do:
     2111             undo move_block, retry move_block .
     2112           end.
     2113         end.
     2114         assign
     2115           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2116           no-error .
     2117         if error-status :error
     2118         or error-status :get-message(1) <> ""
     2119         then do:
     2120           undo move_block, retry move_block .
     2121         end.
     2122         if frame Dialog-Frame :scrollable = true
     2123         then do:
     2124           assign
     2125             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2126             no-error .
     2127           if error-status :error
     2128           or error-status :get-message(1) <> ""
     2129           then do:
     2130             undo move_block, retry move_block .
     2131           end.
     2132         end.
     2133       end.
     2134       if p-move-resize = true
     2135       then do:
     2136         run diasize_position-resize-button in this-procedure .
     2137       end.
     2138       if v-diasize-wndstore = true
     2139       then do:
     2140         if connected("ub") = true
     2141         then do:
     2142           define variable v-cntxt-db-num        as integer   no-undo .
     2143           define variable v-cntxt-userid        as character no-undo .
     2144           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2145                                             , OUTPUT v-cntxt-userid
     2146                                             ) .
     2147           run gbl/wndsizew.p
     2148             (input  v-cntxt-db-num
     2149             ,input  v-cntxt-userid
     2150             ,input  v-diasize-proc-name
     2151             ,input  'height':u
     2152             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2153             ) .
     2154         end.
     2155       end.
     2156     end.
     2157     assign
     2158       v-diasize-change-size = false
     2159     .
     2160   end procedure.
     2161   procedure diasize_set-height :
     2162     define input  parameter p-new-height  as decimal   no-undo .
     2163     define input  parameter p-move-resize as logical   no-undo .
     2164     do
     2165     on error undo, return error return-value
     2166     :
     2167       run diasize_change-height in this-procedure
     2168         (input  (p-new-height - frame Dialog-Frame :height)
     2169         ,input  p-move-resize
     2170         ) .
     2171     end.
     2172   end procedure.
     2173   procedure diasize_change-width :
     2174     define input  parameter p-change-value as decimal   no-undo .
     2175     define input  parameter p-move-resize  as logical   no-undo .
     2176     define variable v-field-group-handle   as handle    no-undo .
     2177     define variable v-object-handle        as handle    no-undo .
     2178     define variable v-frame-width          as decimal   no-undo .
     2179     define variable v-frame-virtual-width  as decimal   no-undo .
     2180     define variable v-browse-width         as decimal   no-undo .
     2181     define variable v-window-width         as decimal   no-undo .
     2182     define variable v-window-virtual-width as decimal   no-undo .
     2183     define variable v-change-sign          as integer   no-undo .
     2184     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2185     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2186     if p-change-value > 0
     2187     then do:
     2188       if frame Dialog-Frame :width + p-change-value >
     2189           session :width-chars
     2190       then do:
     2191         assign
     2192           p-change-value = session :width-chars - frame Dialog-Frame :width
     2193         .
     2194         if p-change-value <= 0
     2195         then do:
     2196           run diasize_position-resize-button in this-procedure .
     2197           return .
     2198         end.
     2199       end.
     2200     end.
     2201     if p-change-value < 0
     2202     then do:
     2203       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2204       then do:
     2205         assign
     2206           p-change-value = v-diasize-orig-frame-width
     2207                          - frame Dialog-Frame :width
     2208         .
     2209         if p-change-value >= 0
     2210         then do:
     2211           run diasize_position-resize-button in this-procedure .
     2212           return .
     2213         end.
     2214       end.
     2215     end.
     2216     if p-change-value >= 0
     2217     then do:
     2218       assign
     2219         v-change-sign = 1
     2220       .
     2221     end.
     2222     else do:
     2223       assign
     2224         v-change-sign = -1
     2225       .
     2226     end.
     2227     assign
     2228       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2229     .
     2230     if p-change-value = 0
     2231     then do:
     2232       run diasize_position-resize-button in this-procedure .
     2233       return .
     2234     end.
     2235     move_block:
     2236     do
     2237     on error undo move_block, leave move_block
     2238     :
     2239       if retry
     2240       then do:
     2241         do
     2242         on error undo move_block, leave move_block
     2243         :
     2244           if p-change-value > 0
     2245           then do:
     2246             for each buf_temp-diasize-handle
     2247             on error undo, next
     2248             :
     2249               assign
     2250                 v-object-handle = buf_temp-diasize-handle.handle-value
     2251               .
     2252               if v-object-handle <> v-diasize-resize-button
     2253               then do:
     2254                 assign
     2255                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2256                 .
     2257               end.
     2258             end.
     2259             assign
     2260               v-diasize-browse-handle :width = v-browse-width
     2261             .
     2262             for each buf_temp-browse-handle
     2263               where buf_temp-browse-handle.browse-type = 'width':u
     2264             on error undo, next
     2265             :
     2266               assign
     2267                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2268               .
     2269             end.
     2270             assign
     2271               frame Dialog-Frame :width = v-frame-width
     2272             .
     2273             if frame Dialog-Frame :scrollable = true
     2274             then do:
     2275               assign
     2276                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2277               .
     2278             end.
     2279             run diasize_position-resize-button in this-procedure .
     2280           end.
     2281           else do:
     2282             if frame Dialog-Frame :scrollable = true
     2283             then do:
     2284               assign
     2285                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2286               .
     2287             end.
     2288             assign
     2289               frame Dialog-Frame :width = v-frame-width
     2290             .
     2291             for each buf_temp-browse-handle
     2292               where buf_temp-browse-handle.browse-type = 'width':u
     2293             on error undo, next
     2294             :
     2295               assign
     2296                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2297               .
     2298             end.
     2299             assign
     2300               v-diasize-browse-handle :width = v-browse-width
     2301             .
     2302             for each buf_temp-diasize-handle
     2303             on error undo, next
     2304             :
     2305               assign
     2306                 v-object-handle = buf_temp-diasize-handle.handle-value
     2307               .
     2308               if v-object-handle <> v-diasize-resize-button
     2309               then do:
     2310                 assign
     2311                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2312                 .
     2313               end.
     2314             end.
     2315             run diasize_position-resize-button in this-procedure .
     2316           end.
     2317           assign
     2318             v-diasize-change-size = false
     2319           .
     2320           leave move_block .
     2321         end.
     2322       end.
     2323       assign
     2324         v-diasize-need-full-display = true
     2325       .
     2326       if v-diasize-change-size = false
     2327       then do:
     2328         assign
     2329           v-diasize-change-size = true
     2330         .
     2331       end.
     2332       else do:
     2333         return .
     2334       end.
     2335       assign
     2336         v-frame-width = frame Dialog-Frame :width
     2337         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2338         v-browse-width = v-diasize-browse-handle :width
     2339       .
     2340       for each buf_temp-browse-handle
     2341         where buf_temp-browse-handle.browse-type = 'width':u
     2342       :
     2343         assign
     2344           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2345         .
     2346       end.
     2347       for each buf_temp-diasize-handle
     2348       :
     2349         delete buf_temp-diasize-handle .
     2350       end.
     2351       assign
     2352         v-field-group-handle = frame Dialog-Frame :first-child
     2353       .
     2354       do while valid-handle(v-field-group-handle)
     2355       :
     2356         assign
     2357           v-object-handle = v-field-group-handle :first-child
     2358         .
     2359         do while valid-handle(v-object-handle)
     2360         :
     2361           if  v-object-handle <> v-diasize-browse-handle :handle
     2362           and v-object-handle <> v-diasize-resize-button
     2363           and can-query(v-object-handle, "row")
     2364           and can-query(v-object-handle, "height")
     2365           and ( v-object-handle :col + v-object-handle :width
     2366                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2367               )
     2368           then do:
     2369             find first buf_temp-browse-handle
     2370               where buf_temp-browse-handle.browse-type   = 'width':u
     2371                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2372               no-error .
     2373             if available buf_temp-browse-handle
     2374             then do:
     2375             end.
     2376             else do:
     2377               create buf_temp-diasize-handle .
     2378               assign
     2379                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2380                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2381               .
     2382             end.
     2383           end.
     2384           assign
     2385             v-object-handle = v-object-handle :next-sibling
     2386           .
     2387         end.
     2388         assign
     2389           v-field-group-handle = v-field-group-handle :next-sibling
     2390         .
     2391       end.
     2392       do with frame Dialog-Frame
     2393       :
     2394         hide v-diasize-resize-button .
     2395         v-diasize-resize-button :row = 1.
     2396         v-diasize-resize-button :column = 1.
     2397       end.
     2398       if p-change-value > 0
     2399       then do:
     2400         if frame Dialog-Frame :scrollable = true
     2401         then do:
     2402           assign
     2403             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2404             no-error .
     2405           if error-status :error
     2406           or error-status :get-message(1) <> ""
     2407           then do:
     2408             undo move_block, retry move_block.
     2409           end.
     2410         end.
     2411         assign
     2412           frame Dialog-Frame :width = v-frame-width + p-change-value
     2413           no-error .
     2414         if error-status :error
     2415         or error-status :get-message(1) <> ""
     2416         then do:
     2417           undo move_block, retry move_block.
     2418         end.
     2419         assign
     2420           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2421         no-error .
     2422         if error-status :error
     2423         or error-status :get-message(1) <> ""
     2424         then do:
     2425           undo move_block, retry move_block.
     2426         end.
     2427         for each buf_temp-browse-handle
     2428           where buf_temp-browse-handle.browse-type = 'width':u
     2429         on error undo move_block, retry move_block
     2430         :
     2431           assign
     2432             buf_temp-browse-handle.browse-handle :width
     2433               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2434             no-error .
     2435           if error-status :error
     2436           or error-status :get-message(1) <> ""
     2437           then do:
     2438             undo move_block, retry move_block .
     2439           end.
     2440         end.
     2441         for each buf_temp-diasize-handle
     2442         on error undo move_block, retry move_block
     2443         :
     2444           assign
     2445             v-object-handle = buf_temp-diasize-handle.handle-value
     2446           .
     2447           if v-object-handle <> v-diasize-resize-button
     2448           then do:
     2449             assign
     2450               v-object-handle :col = v-object-handle :col + p-change-value
     2451               no-error .
     2452             if error-status :error
     2453             or error-status :get-message(1) <> ""
     2454             then do:
     2455               undo move_block, retry move_block .
     2456             end.
     2457           end.
     2458         end.
     2459       end.
     2460       else do:
     2461         for each buf_temp-diasize-handle
     2462         on error undo move_block, retry move_block
     2463         :
     2464           assign
     2465             v-object-handle = buf_temp-diasize-handle.handle-value
     2466           .
     2467           if v-object-handle <> v-diasize-resize-button
     2468           then do:
     2469             assign
     2470               v-object-handle :col = v-object-handle :col + p-change-value
     2471               no-error .
     2472             if error-status :error
     2473             or error-status :get-message(1) <> ""
     2474             then do:
     2475               undo move_block, retry move_block .
     2476             end.
     2477           end.
     2478         end.
     2479         for each buf_temp-browse-handle
     2480           where buf_temp-browse-handle.browse-type = 'width':u
     2481         on error undo move_block, retry move_block
     2482         :
     2483           assign
     2484             buf_temp-browse-handle.browse-handle :width
     2485               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2486             no-error .
     2487           if error-status :error
     2488           or error-status :get-message(1) <> ""
     2489           then do:
     2490             undo move_block, retry move_block .
     2491           end.
     2492         end.
     2493         assign
     2494           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2495           no-error .
     2496         if error-status :error
     2497         or error-status :get-message(1) <> ""
     2498         then do:
     2499           undo move_block, retry move_block.
     2500         end.
     2501         assign
     2502           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2503         no-error .
     2504         if error-status :error
     2505         or error-status :get-message(1) <> ""
     2506         then do:
     2507           undo move_block, retry move_block.
     2508         end.
     2509         if frame Dialog-Frame :scrollable = true
     2510         then do:
     2511           assign
     2512             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2513           no-error .
     2514           if error-status :error
     2515           or error-status :get-message(1) <> ""
     2516           then do:
     2517             undo move_block, retry move_block.
     2518           end.
     2519         end.
     2520       end.
     2521       if p-move-resize
     2522       then do:
     2523         run diasize_position-resize-button in this-procedure .
     2524       end.
     2525       if v-diasize-wndstore = true
     2526       then do:
     2527         if connected("ub") = true
     2528         then do:
     2529           define variable v-cntxt-db-num        as integer   no-undo .
     2530           define variable v-cntxt-userid        as character no-undo .
     2531           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2532                                             , OUTPUT v-cntxt-userid
     2533                                             ) .
     2534           run gbl/wndsizew.p
     2535             (input  v-cntxt-db-num
     2536             ,input  v-cntxt-userid
     2537             ,input  v-diasize-proc-name
     2538             ,input  'width':u
     2539             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2540             ) .
     2541         end.
     2542       end.
     2543     end.
     2544     assign
     2545       v-diasize-change-size = false
     2546     .
     2547   end procedure.
     2548   procedure diasize_set-width :
     2549     define input  parameter p-new-width  as decimal   no-undo .
     2550     define input  parameter p-move-resize as logical   no-undo .
     2551     do
     2552     on error undo, return error return-value
     2553     :
     2554       run diasize_change-width in this-procedure
     2555         (input  (p-new-width - frame Dialog-Frame :width)
     2556         ,input  p-move-resize
     2557         ) .
     2558     end.
     2559   end procedure.
     2560   procedure diasize_position-resize-button :
     2561     do with frame Dialog-Frame
     2562     :
     2563       hide v-diasize-resize-button .
     2564       assign
     2565         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2566                     - 1
     2567                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2568         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2569                     - 1
     2570                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2571       .
     2572       view v-diasize-resize-button .
     2573     end.
     2574   end procedure.
     2575   on alt-right anywhere
     2576   do:
     2577     run diasize_change-width in this-procedure
     2578       (input 1
     2579       ,input true
     2580       ) .
     2581     return no-apply .
     2582   end.
     2583   on alt-left anywhere
     2584   do:
     2585     run diasize_change-width in this-procedure
     2586       (input -1
     2587       ,input true
     2588       ) .
     2589     return no-apply .
     2590   end.
     2591   on alt-down anywhere
     2592   do:
     2593     run diasize_change-height in this-procedure
     2594       (input 1
     2595       ,input true
     2596       ) .
     2597     return no-apply .
     2598   end.
     2599   on alt-up anywhere
     2600   do:
     2601     run diasize_change-height in this-procedure
     2602       (input -1
     2603       ,input true
     2604       ) .
     2605     return no-apply .
     2606   end.
     2607   on alt-enter of frame Dialog-Frame
     2608   do:
     2609     run diasize_maximize in this-procedure
     2610       (input  ?
     2611       ).
     2612     return no-apply .
     2613   end.
     2614   procedure diasize_end-move :
     2615     do
     2616     on error undo, return error return-value
     2617     :
     2618       define variable v-row-delta as decimal   no-undo .
     2619       define variable v-col-delta as decimal   no-undo .
     2620       define variable v-new-row as decimal   no-undo .
     2621       define variable v-new-col as decimal   no-undo .
     2622       assign
     2623         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2624         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2625       .
     2626       assign
     2627         v-row-delta = v-new-row - frame Dialog-Frame :height
     2628         v-col-delta = v-new-col - frame Dialog-Frame :width
     2629       .
     2630       run diasize_change-height in this-procedure
     2631         (input v-row-delta
     2632         ,input true
     2633         ) .
     2634       run diasize_change-width in this-procedure
     2635         (input v-col-delta
     2636         ,input true
     2637         ) .
     2638     end.
     2639   end procedure.
     2640   procedure diasize_maximize :
     2641     define input  parameter p-action as logical   no-undo .
     2642     do
     2643     on error undo, return error return-value
     2644     :
     2645       if p-action = ?
     2646       then do:
     2647         if v-diasize-need-maximize = true
     2648         then do:
     2649           assign
     2650             p-action = true
     2651           .
     2652         end.
     2653         else do:
     2654           assign
     2655             p-action = false
     2656           .
     2657         end.
     2658       end.
     2659       if p-action = true
     2660       then do:
     2661         run diasize_change-height in this-procedure
     2662           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2663               - frame Dialog-Frame :height-chars
     2664           ,input true
     2665           ) .
     2666         run diasize_change-width in this-procedure
     2667           (input session :width-chars
     2668               - frame Dialog-Frame :width-chars
     2669           ,input true
     2670           ) .
     2671         assign
     2672           v-diasize-need-maximize = false
     2673         .
     2674       end.
     2675       else do:
     2676         run diasize_change-width in this-procedure
     2677           (input v-diasize-orig-frame-width
     2678               - frame Dialog-Frame :width-chars
     2679           ,input true
     2680           ) .
     2681         run diasize_change-height in this-procedure
     2682           (input v-diasize-orig-frame-height
     2683               - frame Dialog-Frame :height-chars
     2684           ,input true
     2685           ) .
     2686         assign
     2687           v-diasize-need-maximize = true
     2688         .
     2689       end.
     2690     end.
     2691   end procedure.
     2692   procedure diasize_restore-orig-size :
     2693     do
     2694     on error undo, return error return-value
     2695     :
     2696       assign
     2697         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2698         v-diasize-current-frame-height = frame Dialog-Frame :height
     2699       .
     2700       run diasize_set-height in this-procedure
     2701         (input  v-diasize-orig-frame-height
     2702         ,input  true
     2703         ) .
     2704       run diasize_set-width in this-procedure
     2705         (input  v-diasize-orig-frame-width
     2706         ,input  true
     2707         ) .
     2708     end.
     2709   end procedure.
     2710   procedure diasize_restore-current-size :
     2711     do
     2712     on error undo, return error return-value
     2713     :
     2714       run diasize_set-height in this-procedure
     2715         (input  v-diasize-current-frame-height
     2716         ,input  true
     2717         ) .
     2718       run diasize_set-width in this-procedure
     2719         (input  v-diasize-current-frame-width
     2720         ,input  true
     2721         ) .
     2722     end.
     2723   end procedure.
     2724   procedure diasize_set-browse-handle :
     2725     define input  parameter p-browse-handle as handle   no-undo .
     2726     define buffer buf_temp-browse-handle for temp-browse-handle .
     2727     do
     2728     on error undo, return error return-value
     2729     :
     2730       assign
     2731         v-diasize-browse-handle = p-browse-handle
     2732       .
     2733       for each buf_temp-browse-handle
     2734       on error undo, return error return-value
     2735       :
     2736         delete buf_temp-browse-handle .
     2737       end.
     2738     end.
     2739   end procedure.
     2740   procedure diasize_add_browse :
     2741     define input  parameter p-browse-type   as character no-undo .
     2742     define input  parameter p-browse-handle as handle    no-undo .
     2743     define buffer buf_temp-browse-handle for temp-browse-handle .
     2744     do
     2745     on error undo, return error return-value
     2746     :
     2747       assign
     2748         v-diasize-browse-number = v-diasize-browse-number + 1
     2749       .
     2750       create buf_temp-browse-handle .
     2751       assign
     2752         buf_temp-browse-handle.browse-type   = p-browse-type
     2753         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2754         buf_temp-browse-handle.browse-handle = p-browse-handle
     2755       .
     2756     end.
     2757   end procedure.
     2758   procedure diasize_init :
     2759     define variable v-default-value    as logical   no-undo .
     2760     define variable v-restore-saved    as logical   no-undo .
     2761     define variable v-resize-value-str as character no-undo .
     2762     do
     2763     on error undo, return error return-value
     2764     :
     2765       do with frame Dialog-Frame
     2766       :
     2767         assign
     2768           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2769           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2770           v-diasize-browse-handle     = browse BR-docs :handle
     2771         .
     2772         create button v-diasize-resize-button
     2773         assign
     2774           parent        = frame Dialog-Frame :first-child
     2775           label         = "s"
     2776           height-pixels = 16
     2777           width-pixels  = 16
     2778           visible       = true
     2779           sensitive     = true
     2780           movable       = true
     2781           triggers:
     2782             on end-move persistent run diasize_end-move in this-procedure .
     2783           end triggers.
     2784         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2785         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2786         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2787         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2788         assign
     2789           v-diasize-wndmax = false
     2790         .
     2791         if connected("ub") = true
     2792         then do:
     2793           define variable v-cntxt-db-num        as integer   no-undo .
     2794           define variable v-cntxt-userid        as character no-undo .
     2795           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2796                                             , OUTPUT v-cntxt-userid
     2797                                             ) .
     2798           run gbl/wndpar_r.p
     2799             (input  v-cntxt-db-num
     2800             ,input  v-cntxt-userid
     2801             ,input  'wndmax':U
     2802             ,output v-diasize-wndmax
     2803             ,output v-default-value
     2804             ) .
     2805         end.
     2806         assign
     2807           v-diasize-wndstore = false
     2808         .
     2809         if connected("ub") = true
     2810         then do:
     2811           run gbl/wndpar_r.p
     2812             (input  v-cntxt-db-num
     2813             ,input  v-cntxt-userid
     2814             ,input  'wndstore':U
     2815             ,output v-diasize-wndstore
     2816             ,output v-default-value
     2817             ) .
     2818         end.
     2819         assign
     2820           v-diasize-proc-name = entry(1, program-name(2), '.')
     2821         .
     2822         if v-diasize-wndstore = true
     2823         then do:
     2824           assign
     2825             v-restore-saved = false
     2826           .
     2827           if connected("ub") = true
     2828           then do:
     2829             run gbl/wndsizer.p
     2830               (input  v-cntxt-db-num
     2831               ,input  v-cntxt-userid
     2832               ,input  v-diasize-proc-name
     2833               ,input  'height':u
     2834               ,output v-resize-value-str
     2835               ) .
     2836             if v-resize-value-str <> '':U
     2837             then do:
     2838               run diasize_change-height in this-procedure
     2839                 (input  integer(v-resize-value-str)
     2840                 ,input  true
     2841                 ) .
     2842               assign
     2843                 v-restore-saved = true
     2844               .
     2845             end.
     2846           end.
     2847           if connected("ub") = true
     2848           then do:
     2849             run gbl/wndsizer.p
     2850               (input  v-cntxt-db-num
     2851               ,input  v-cntxt-userid
     2852               ,input  v-diasize-proc-name
     2853               ,input  'width':u
     2854               ,output v-resize-value-str
     2855               ) .
     2856             if v-resize-value-str <> '':U
     2857             then do:
     2858               run diasize_change-width in this-procedure
     2859                 (input  integer(v-resize-value-str)
     2860                 ,input  true
     2861                 ) .
     2862               assign
     2863                 v-restore-saved = true
     2864               .
     2865             end.
     2866           end.
     2867           if v-restore-saved <> true
     2868           then do:
     2869             if v-diasize-wndmax = true
     2870             then do:
     2871               run diasize_maximize in this-procedure
     2872                 (input  true
     2873                 ) .
     2874             end.
     2875           end.
     2876         end.
     2877         else do:
     2878           if v-diasize-wndmax = true
     2879           then do:
     2880             run diasize_maximize in this-procedure
     2881               (input  true
     2882               ) .
     2883           end.
     2884         end.
     2885       end.
     2886     end.
     2887   end procedure.
     2888   procedure diasize_need-full-display :
     2889     define output parameter p-need-full-display as logical   no-undo .
     2890     do
     2891     on error undo, return error return-value
     2892     :
     2893       assign
     2894         p-need-full-display = v-diasize-need-full-display
     2895       .
     2896       assign
     2897         v-diasize-need-full-display = false
     2898       .
     2899     end.
     2900   end procedure.
     2901   procedure get-context :
     2902      define output parameter p-db-num as integer          no-undo.
     2903      define output parameter p-user-id as character        no-undo.
     2904      define variable v-login               as character    no-undo.
     2905      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2906      define buffer buf_user-login  for ub.user-login .
     2907      do
     2908      on error undo, return error
     2909      :
     2910            FIND FIRST buf_sys-ctrl no-lock.
     2911            ASSIGN
     2912               v-login = USERID("ub")
     2913               p-db-num = buf_sys-ctrl.db-num
     2914            .
     2915            FIND FIRST buf_user-login
     2916                 WHERE buf_user-login.db-num = p-db-num
     2917                   AND buf_user-login.user-login = v-login
     2918                 no-lock
     2919                 no-error
     2920                 .
     2921            IF AVAILABLE buf_user-login
     2922            THEN DO:
     2923               assign
     2924                  p-user-id = buf_user-login.user-id
     2925               .
     2926            END.
     2927      end.
     2928   end procedure.
     2929   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2930   on INS of frame Dialog-Frame anywhere do:
     2931     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2932     return no-apply.
     2933   end.
     2934   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2935   on F2 of frame Dialog-Frame anywhere do:
     2936     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2937     return no-apply.
     2938   end.
     2939   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2940   procedure set-filter-name :
     2941   define input parameter p-filter-name as character no-undo .
     2942     do with frame Dialog-Frame:
     2943       if p-filter-name > "" then do:
     2944         assign
     2945           frame Dialog-Frame:title
     2946             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2947         .
     2948         assign
     2949           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2950         .
     2951       end.
     2952       else do:
     2953         assign
     2954           b-sch :tooltip = ""
     2955         .
     2956       end.
     2957     end.
     2958   end procedure.
     2959   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2960   on f5 of frame Dialog-Frame anywhere
     2961   do:
     2962     v-doc-rec = recid(X_c-chk-doc). run OpenBr in this-procedure ( input yes, input no, input '':U). reposition br-docs to recid v-doc-rec no-error. v-doc-rec = ?.               apply 'value-changed' to br-docs.
     2963       apply "VALUE-CHANGED" to BR-changes.
     2964   end.
     2965   def var sort-labelbr-docs   as character no-undo .
     2966   def var sort-clmnbr-docs    as handle    no-undo .
     2967   def var cur-clmnbr-docs     as handle    no-undo .
     2968   def var cur-clmn-locbr-docs as integer   no-undo .
     2969   def var re-querybr-docs     as logical   initial no no-undo .
     2970   on start-search, ctrl-o of br-docs in frame Dialog-Frame do:
     2971      run sort-brbr-docs
     2972        (input (if available X_c-chk-doc
     2973                then recid(X_c-chk-doc)
     2974                else ?
     2975               )
     2976        ).
     2977   end.
     2978   PROCEDURE sort-brbr-docs :
     2979     define input parameter p-recid as recid no-undo .
     2980     if re-querybr-docs = no then do:
     2981       assign
     2982          cur-clmnbr-docs = br-docs:current-column in frame Dialog-Frame
     2983       .
     2984       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     2985       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     2986         assign
     2987            sort-labelbr-docs = ""
     2988            sort-clmnbr-docs = ?
     2989         .
     2990        end.
     2991        else do:
     2992          assign
     2993            sort-labelbr-docs = cur-clmnbr-docs:label
     2994            sort-clmnbr-docs  = cur-clmnbr-docs
     2995            sort-clmnbr-docs:column-fgcolor = 4
     2996          .
     2997        end.
     2998      end.
     2999     assign
     3000       cur-clmn-locbr-docs = 1
     3001     .
     3002     def var column-handle as handle no-undo .
     3003     column-handle = br-docs:first-column.
     3004     do while valid-handle(column-handle) :
     3005       if column-handle = cur-clmnbr-docs then do:
     3006         leave .
     3007       end.
     3008       column-handle = column-handle:NEXT-COLUMN.
     3009       assign
     3010         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     3011       .
     3012     end.
     3013     case sort-labelbr-docs:
     3014           when X_c-chk-doc.corr-date:label in browse br-docs then DO:    assign       sort-column-name = "X_c-chk-doc.corr-date"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     3015           when X_c-chk-doc.doc-code:label in browse br-docs then DO:    assign       sort-column-name = "X_c-chk-doc.doc-code"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     3016           when X_c-chk-doc.chk-date:label in browse br-docs then DO:    assign       sort-column-name = "X_c-chk-doc.chk-date"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     3017           when X_c-chk-doc.shift-date:label in browse br-docs then DO:    assign       sort-column-name = "X_c-chk-doc.shift-date"     .     run OpenBr  in this-procedure ( input yes, input no, input '').   . END.
     3018       otherwise do:
     3019         assign
     3020           sort-column-name = ""
     3021         .
     3022         run OpenBr in this-procedure ( input yes, input no, input '').
     3023           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-docs') then do:
     3024             run mv-brw-defaultbr-docs.
     3025           end.
     3026         if sort-labelbr-docs <> "" then do:
     3027           assign
     3028             cur-clmnbr-docs:column-fgcolor = 0
     3029           .
     3030         end.
     3031         assign
     3032           cur-clmn-locbr-docs = ?
     3033         .
     3034       end.
     3035     end case.
     3036     if p-recid <> ? then do:
     3037       reposition br-docs to recid p-recid no-error.
     3038       apply "value-changed" to br-docs in frame Dialog-Frame.
     3039     end.
     3040     apply "entry" to br-docs in frame Dialog-Frame.
     3041   END PROCEDURE.
     3042   procedure re-open-query-srt-clmnbr-docs:
     3043   if cur-clmnbr-docs = ? then do:
     3044      run OpenBr in this-procedure ( input yes, input no, input '').
     3045   end.
     3046   else do:
     3047      assign re-querybr-docs = yes.
     3048      run sort-brbr-docs
     3049        (input (if available X_c-chk-doc
     3050                then recid(X_c-chk-doc)
     3051                else ?
     3052               )
     3053        ).
     3054      assign re-querybr-docs = no.
     3055   end.
     3056   end.
     3057   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3058   DEF VAR cur-clmn-numbr-docs as INT EXTENT 17 no-undo.
     3059   DEF VAR varmvibr-docs       as INT no-undo.
     3060   DEF VAR varmvjbr-docs       as INT no-undo.
     3061   DEF VAR varmvkbr-docs       as INT no-undo.
     3062   DEF VAR varmvlbr-docs       as INT no-undo.
     3063   DEF VAR move-elementbr-docs as INT no-undo.
     3064   def var jjbr-docs           as int no-undo.
     3065   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     3066     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     3067   END.
     3068   RUN start-mv-clmnbr-docs.
     3069   PROCEDURE start-mv-clmnbr-docs:
     3070   def var old-session as logical no-undo.
     3071      old-session = SESSION:IMMEDIATE-DISPLAY.
     3072      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3073      SESSION:IMMEDIATE-DISPLAY = old-session.
     3074   END.
     3075   ON ctrl-cursor-right OF BROWSE br-docs do:
     3076     RUN re-move-clmnbr-docs ( 7, 17).
     3077   END.
     3078   ON ctrl-cursor-left OF BROWSE br-docs do:
     3079     RUN re-move-clmnbr-docs (17, 7).
     3080   END.
     3081   PROCEDURE re-move-clmnbr-docs:
     3082     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3083     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3084     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3085       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     3086     END.
     3087     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3088     if source-column > target-column THEN
     3089     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     3090       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3091           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3092             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     3093           END.
     3094       END.
     3095     END.
     3096     ELSE
     3097     DO varmvjbr-docs = source-column + 1 to target-column:
     3098       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3099         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3100           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     3101         END.
     3102       END.
     3103     END.
     3104     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3105       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     3106     END.
     3107   END PROCEDURE.
     3108   PROCEDURE ch-clmnbr-docs:
     3109     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3110     if cur-clmn-loc <= 7 then do:
     3111       return .
     3112     end.
     3113     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3114       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     3115     END.
     3116     RUN re-move-clmnbr-docs (cur-clmn-loc, 7).
     3117   END PROCEDURE.
     3118   PROCEDURE mv-brw-defaultbr-docs:
     3119   def var old-session as logical no-undo.
     3120     old-session = SESSION:IMMEDIATE-DISPLAY.
     3121     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3122     do varmvlbr-docs = 7 to EXTENT(cur-clmn-numbr-docs):
     3123       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     3124     END.
     3125     RUN start-mv-clmnbr-docs.
     3126     SESSION:IMMEDIATE-DISPLAY = old-session.
     3127   END PROCEDURE.
     3128   .
     3129   MAIN-BLOCK:
     3130   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3131      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3132   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3133     run mainmenu_getcntxt in parparentproc
     3134       (output v-cntxt-db-num
     3135       ,output v-cntxt-userid
     3136       ,output v-cntxt-level
     3137       ,output v-cntxt-host-code-obj
     3138       ,output v-cntxt-obj-type
     3139       ,output v-cntxt-obj-code
     3140       ,output v-cntxt-db-num-obj
     3141       ,output v-cntxt-is-admin
     3142       ) .
     3143   if p-mode <> "one":U
     3144   and p-mode <> 'удаление':U
     3145   and p-mode <> 'ДОБАВЛЕНИЕ':U
     3146   then do:
     3147     message vss-workfile vss-revision vss-description skip
     3148     "Неверное значение параметра вызова p-mode" p-mode
     3149     view-as alert-box ERROR.
     3150     return.
     3151   end.
     3152     define variable n_MyEnable AS LOGICAL no-undo .
     3153     if p-mode = "one":U then do:
     3154       FIND FIRST X_c-chk-doc No-LOCK where
     3155                   X_c-chk-doc.doc-code = p-doc-code
     3156                   No-ERROR.
     3157       if not avail X_c-chk-doc then do:
     3158       n_MyEnable = yes .
     3159         message "История изменений для чека " p-doc-code " не найдена." view-as alert-box .
     3160       end.
     3161     end.
     3162   if not n_MyEnable then do:
     3163     v-rid-list = p-rid-list.
     3164     if v-rid-list <> "" then do:
     3165         FIND FIRST find_c-chk-doc No-LOCK where
     3166                    recid(find_c-chk-doc) = integer(entry(1, v-rid-list)) No-ERROR.
     3167         if not avail find_c-chk-doc then do:
     3168           message
     3169           vss-workfile vss-revision vss-description skip
     3170           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3171           view-as alert-box error .
     3172           return error.
     3173         end.
     3174         v-doc-rec = integer(entry(1, v-rid-list)).
     3175     end.
     3176     run adm/shattri.p (
     3177         input "get":U
     3178       ,input  p-obj-type
     3179       ,input  p-obj-code
     3180       ,input  'dc-ref':U
     3181       ,input  'l-mask':U
     3182       ,output v-value-character
     3183       ,output v-value-date
     3184       ,output v-value-decimal
     3185       ,output v-value-integer
     3186       ,output par-l-mask
     3187       ,output v-param-type
     3188       ,INPUT-OUTPUT table-handle v-tth
     3189       ) no-error .
     3190   for each thbjattr_thbj-attr where
     3191          thbjattr_thbj-attr.obj-type = p-obj-type
     3192      and thbjattr_thbj-attr.obj-code = p-obj-code
     3193      and thbjattr_thbj-attr.upper-prop-code = 'dc-ref':U
     3194   on error undo, return error return-value :
     3195     case thbjattr_thbj-attr.prop-code:
     3196       when 'l-mask':U then do:
     3197         assign
     3198         par-l-mask = thbjattr_thbj-attr.property-value-logical.
     3199       end.
     3200     end case.
     3201   end.
     3202       run MyEnable in this-procedure .
     3203       RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     3204       HIDE mark-num in frame Dialog-Frame .
     3205       REPOSITION br-docs to row 1 No-ERROR.
     3206       run diasize_add_browse in this-procedure
     3207       (input  'width':u
     3208       ,input  browse br-changes :handle
     3209       ) .
     3210       run diasize_init in this-procedure .
     3211       WAIT-FOR GO OF FRAME Dialog-Frame.
     3212   end.
     3213   END.
     3214   RUN disable_UI.
     3215   PROCEDURE disable_UI :
     3216     HIDE FRAME Dialog-Frame.
     3217   END PROCEDURE.
     3218   PROCEDURE enable_UI :
     3219     DISPLAY ED-notes mark-num
     3220         WITH FRAME Dialog-Frame.
     3221     ENABLE b-quit B-mark b-sel B-lkp b-restore B-print B-sch B-Help BR-docs
     3222            ED-notes BR-changes mark-num
     3223         WITH FRAME Dialog-Frame.
     3224     VIEW FRAME Dialog-Frame.
     3225   END PROCEDURE.
     3226   PROCEDURE get-line-changes-current :
     3227   define input parameter p-chip-num like ub.c-chk-doc.chip-num no-undo .
     3228   define variable v-chg-fields as character no-undo .
     3229   define variable ii as integer no-undo .
     3230   define variable jj as integer no-undo .
     3231   define variable v-field-name as character no-undo .
     3232   define variable v-field-label as character no-undo .
     3233   define variable v-field-function as character no-undo .
     3234   define variable v-real-field-name as character no-undo .
     3235   define buffer buf_chk-gds for ub.chk-gds.
     3236   define buffer buf_chk-pay for ub.chk-pay.
     3237   define buffer buf_chk-discnt for ub.chk-discnt.
     3238   define buffer buf_chk-doc-attr for ub.chk-doc-attr.
     3239   define buffer buf_c-chk-gds for ub.c-chk-gds.
     3240   define buffer buf_c-chk-pay for ub.c-chk-pay.
     3241   define buffer buf_c-chk-discnt for ub.c-chk-discnt.
     3242   define buffer buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     3243   for each buf_chk-gds no-lock where
     3244               buf_chk-gds.doc-code = p-doc-code,
     3245       first buf_c-chk-gds no-lock where
     3246            buf_c-chk-gds.doc-code = p-doc-code
     3247        AND buf_c-chk-gds.chip-num = p-chip-num
     3248        AND buf_c-chk-gds.line-num = buf_chk-gds.line-num
     3249               :
     3250     buffer-compare
     3251     buf_chk-gds to buf_c-chk-gds
     3252     case-sensitive
     3253     save result in v-chg-fields.
     3254     _ii:
     3255     do ii = 1 to num-entries(v-chg-fields):
     3256       assign
     3257       v-field-name = entry(ii, v-chg-fields)
     3258       jj = lookup(v-field-name, "b-code,depart-code,depart-id,depart-type,discnt,doc-qnty,is-error," +                         "line-num,line-sign,line-type,loc1,nozzle-code,pass-gds,price-base,price-list-id,price-service,pump," +                         "road-tax,sales-man,salesman-psn-code,src-code,src-discnt,src-price,src-qnty," +                         "src-sum,sum-base,time-oper,write-off-code").
     3259       if jj = 0 then next _ii.
     3260       assign
     3261       v-field-label = entry(jj, "Бар-код в БД,Код подразделения,ID подразделения,Тип подразделения,Скидка в БД,Количество,Ош," +                         "Номер строки,Знак строки,Тип,Резервуар,Пистолет,Ввод кода товара,Цена в БД,Прайс-лист,Цена серв. эл-та,Номер ТРК," +                         "Дорожный налог,Продавец,Код продавца в БД,Исходный бар-код,Скидка в чеке,Цена чека,Количество в чеке," +                         "Сумма строки в чеке,Сумма строки в БД,Время в сек,Код списания")
     3262       v-field-function = entry(jj, ",,,,,,," +                         ",,,,,,,,,," +                         ",,,,,,," +                         ",,,get-wro-name")
     3263       v-real-field-name = entry(1, v-field-name, ':')
     3264       .
     3265       create temp-changes.
     3266       assign
     3267       temp-changes.f_name = substitute("chk-gds&1&2&1&3"
     3268                                        ,chr(4)
     3269                                        ,buf_chk-gds.line-num
     3270                                        ,v-field-name)
     3271       temp-changes.l_name = substitute("Строка товара &1 &2"
     3272                                        ,buf_chk-gds.line-num
     3273                                        ,v-field-label)
     3274       temp-changes.v_old = string(buffer buf_c-chk-gds:buffer-field(v-real-field-name):buffer-value)
     3275       temp-changes.v_new = string(buffer buf_chk-gds:buffer-field(v-real-field-name):buffer-value)
     3276       .
     3277       if v-field-function <> '':U then do:
     3278         assign
     3279         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     3280         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     3281         .
     3282       end.
     3283     end.
     3284   end.
     3285   for each buf_chk-pay no-lock where
     3286               buf_chk-pay.doc-code = p-doc-code,
     3287       first buf_c-chk-pay no-lock where
     3288            buf_c-chk-pay.doc-code = p-doc-code
     3289        AND buf_c-chk-pay.chip-num = p-chip-num
     3290        AND buf_c-chk-pay.line-num = buf_chk-pay.line-num:
     3291     buffer-compare
     3292     buf_chk-pay to buf_c-chk-pay
     3293     case-sensitive
     3294     save result in v-chg-fields.
     3295     _ii:
     3296     do ii = 1 to num-entries(v-chg-fields):
     3297       assign
     3298       v-field-name = entry(ii, v-chg-fields)
     3299       jj = lookup(v-field-name, "bank-rate,bank-scale,cash-rate,curr-code,is-error,line-num,line-sign," +                        "line-type,pass-pay,pay-card,pay-code,time-oper," +                        "tot-base,tot-rubl,tot-sum").
     3300       if jj = 0 then next _ii.
     3301       assign
     3302       v-field-label = entry(jj, "Курс ЦБ РФ,Масштаб курса банка ЦБ РФ,Курс,Код валюты,Ош,Номер строки,Знак строки," +                         "Тип,Прохождение платежа (картой или вручную),Номер пл карты карты,код оплаты,Время в сек," +                         "Сумма в баз.в.,Сумма в руб.,Сумма в валюте оплаты")
     3303       v-real-field-name = entry(1, v-field-name, ':')
     3304       .
     3305       create temp-changes.
     3306       assign
     3307       temp-changes.f_name = substitute("chk-pay&1&2&2&3"
     3308                                        ,chr(4)
     3309                                        ,buf_chk-pay.line-num
     3310                                        ,v-field-name)
     3311       temp-changes.l_name = substitute("Строка оплат &1 &2"
     3312                                         ,buf_chk-pay.line-num
     3313                                         ,v-field-label)
     3314       temp-changes.v_old = string(buffer buf_c-chk-pay:buffer-field(v-real-field-name):buffer-value)
     3315       temp-changes.v_new = string(buffer buf_chk-pay:buffer-field(v-real-field-name):buffer-value)
     3316       .
     3317     end.
     3318   end.
     3319   for each buf_chk-discnt no-lock where
     3320               buf_chk-discnt.doc-code = p-doc-code,
     3321       first buf_c-chk-discnt no-lock where
     3322             buf_c-chk-discnt.doc-code = p-doc-code
     3323         AND buf_c-chk-discnt.chip-num = p-chip-num
     3324         AND buf_c-chk-discnt.line-num = buf_chk-discnt.line-num
     3325     :
     3326     if buf_c-chk-discnt.record-type = 2 then NEXT.
     3327     buffer-compare
     3328     buf_chk-discnt to buf_c-chk-discnt
     3329     case-sensitive
     3330     save result in v-chg-fields.
     3331     _ii:
     3332     do ii = 1 to num-entries(v-chg-fields):
     3333       assign
     3334       v-field-name = entry(ii, v-chg-fields)
     3335       jj = lookup(v-field-name, "discnt-id,discnt-type,discnt-value-abs,discnt-value-pcnt,is-error,line-num,line-sign," +                         "line-type,object-line-num,object-qnty,object-sum,pass-discnt,record-type,time-oper,value-type").
     3336       if jj = 0 then next _ii.
     3337       assign
     3338       v-field-label = entry(jj, "Вн.№ скидки,Тип скидки,Abs значение скидки,Проц значение скидки,Ош,№ строки скидки,Знак строки," +                          "Тип,№ товарной строки для скидки,Количество,Сумма до скидки,Ввод скидки (картой или вручную),Тип записи,Время в сек,Тип значения")
     3339       v-real-field-name = entry(1, v-field-name, ':')
     3340       .
     3341       create temp-changes.
     3342       assign
     3343       temp-changes.f_name = substitute("chk-discnt&1&2&1&3&1&4&1&5&1&6"
     3344                                        ,chr(4)
     3345                                        ,buf_chk-discnt.record-type
     3346                                        ,buf_chk-discnt.line-num
     3347                                        ,buf_chk-discnt.object-line-num
     3348                                        ,buf_chk-discnt.discnt-id
     3349                                        ,v-field-name)
     3350       temp-changes.l_name = substitute("Строка скидки &1 &2 к строке &3 &4"
     3351                                        ,buf_chk-discnt.line-num
     3352                                        ,(if buf_chk-discnt.record-type = 0 then ' (исх) ' else ' (выч) ')
     3353                                        ,buf_chk-discnt.object-line-num
     3354                                        ,v-field-label)
     3355       temp-changes.v_old = string(buffer buf_c-chk-discnt:buffer-field(v-real-field-name):buffer-value)
     3356       temp-changes.v_new = string(buffer buf_chk-discnt:buffer-field(v-real-field-name):buffer-value)
     3357       .
     3358     end.
     3359   end.
     3360   for each buf_chk-doc-attr no-lock where
     3361               buf_chk-doc-attr.doc-code = p-doc-code,
     3362       first buf_c-chk-doc-attr no-lock where
     3363            buf_c-chk-doc-attr.chip-num = p-chip-num
     3364         AND buf_c-chk-doc-attr.doc-code = p-doc-code
     3365      AND buf_c-chk-doc-attr.attr-code = buf_chk-doc-attr.attr-code:
     3366     buffer-compare
     3367     buf_chk-doc-attr to buf_c-chk-doc-attr
     3368     case-sensitive
     3369     save result in v-chg-fields.
     3370     _ii:
     3371     do ii = 1 to num-entries(v-chg-fields):
     3372       assign
     3373       v-field-name = entry(ii, v-chg-fields)
     3374       jj = lookup(v-field-name, "attr-code,attr-value").
     3375       if jj = 0 then next _ii.
     3376       assign
     3377       v-field-label = entry(jj, "Код атрибута,Значение атрибута")
     3378       v-real-field-name = entry(1, v-field-name, ':')
     3379       .
     3380       create temp-changes.
     3381       assign
     3382       temp-changes.f_name = substitute("chk-doc-attr&1&2&2&3"
     3383                                        ,chr(4)
     3384                                        ,buf_chk-doc-attr.attr-code
     3385                                        ,v-field-name)
     3386       temp-changes.l_name = substitute("Атрибут чека &1 &2"
     3387                                         ,buf_chk-doc-attr.attr-code
     3388                                         ,v-field-label)
     3389       temp-changes.v_old = string(buffer buf_c-chk-doc-attr:buffer-field(v-field-name):buffer-value)
     3390       temp-changes.v_new = string(buffer buf_chk-doc-attr:buffer-field(v-field-name):buffer-value)
     3391       .
     3392     end.
     3393   end.
     3394   END PROCEDURE.
     3395   PROCEDURE get-line-changes-hist :
     3396   define input parameter p-doc-code like ub.c-chk-doc.doc-code no-undo .
     3397   define input parameter p-chip-num like ub.c-chk-doc.chip-num no-undo.
     3398   define input parameter p-new-chip-num like ub.c-chk-doc.chip-num no-undo.
     3399   define input parameter p-is-add      like ub.c-chk-doc.is-add no-undo .
     3400   define input parameter p-is-del      like ub.c-chk-doc.is-del no-undo .
     3401   define variable v-chg-fields as character no-undo .
     3402   define variable ii as integer no-undo .
     3403   define variable jj as integer no-undo .
     3404   define variable v-field-name as character no-undo .
     3405   define variable v-field-label as character no-undo .
     3406   define variable v-field-function as character no-undo .
     3407   define variable v-real-field-name as character no-undo .
     3408   define buffer new_c-chk-gds for ub.c-chk-gds.
     3409   define buffer new_c-chk-pay for ub.c-chk-pay.
     3410   define buffer new_c-chk-discnt for ub.c-chk-discnt.
     3411   define buffer new_c-chk-doc-attr for ub.c-chk-doc-attr.
     3412   define buffer buf_c-chk-gds for ub.c-chk-gds.
     3413   define buffer buf_c-chk-pay for ub.c-chk-pay.
     3414   define buffer buf_c-chk-discnt for ub.c-chk-discnt.
     3415   define buffer buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     3416   if p-is-del or p-is-add then do:
     3417     assign
     3418     v-chg-fields = get-all-fields("chk-gds":U)
     3419     v-chg-fields = replace(v-chg-fields, "obj-type,":U, "":U)
     3420     v-chg-fields = replace(v-chg-fields, "obj-code,":U, "":U)
     3421     v-chg-fields = replace(v-chg-fields, "doc-code,":U, "":U)
     3422     v-chg-fields = replace(v-chg-fields, "out-code,":U, "":U)
     3423     v-chg-fields = replace(v-chg-fields, chr(44), chr(44))
     3424     v-chg-fields = trim(v-chg-fields, chr(44))
     3425     .
     3426   end.
     3427   for each new_c-chk-gds no-lock where
     3428               new_c-chk-gds.doc-code = p-doc-code
     3429           AND new_c-chk-gds.chip-num = p-new-chip-num
     3430               ,
     3431       first buf_c-chk-gds no-lock where
     3432            buf_c-chk-gds.doc-code = p-doc-code
     3433        AND buf_c-chk-gds.chip-num = p-chip-num
     3434        AND buf_c-chk-gds.line-num = new_c-chk-gds.line-num
     3435               :
     3436     if not (p-is-del or p-is-add ) then
     3437     buffer-compare
     3438     new_c-chk-gds to buf_c-chk-gds
     3439     case-sensitive
     3440     save result in v-chg-fields.
     3441     _ii:
     3442     do ii = 1 to num-entries(v-chg-fields):
     3443       assign
     3444       v-field-name = entry(ii, v-chg-fields)
     3445       jj = lookup(v-field-name, "b-code,depart-code,depart-id,depart-type,discnt,doc-qnty,is-error," +                         "line-num,line-sign,line-type,loc1,nozzle-code,pass-gds,price-base,price-list-id,price-service,pump," +                         "road-tax,sales-man,salesman-psn-code,src-code,src-discnt,src-price,src-qnty," +                         "src-sum,sum-base,time-oper,write-off-code").
     3446       if jj = 0 then next _ii.
     3447       assign
     3448       v-field-label = entry(jj, "Бар-код в БД,Код подразделения,ID подразделения,Тип подразделения,Скидка в БД,Количество,Ош," +                         "Номер строки,Знак строки,Тип,Резервуар,Пист,Ввод кода товара,Цена в БД,Прайс-лист,Цена серв. эл-та,Номер ТРК," +                         "Дорожный налог,Продавец,Код продавца в БД,Исходный бар-код,Скидка в чеке,Цена чека,Количество в чеке," +                         "Сумма строки в чеке,Сумма строки в БД,Время в сек,Код списания")
     3449       v-field-function = entry(jj, ",,,,,,," +                         ",,,,,,,,,," +                         ",,,,,,," +                         ",,,")
     3450       v-real-field-name = entry(1, v-field-name, ":")
     3451       .
     3452       create temp-changes.
     3453       assign
     3454       temp-changes.f_name = substitute("chk-gds&1&2&1&3"
     3455                                         ,chr(4)
     3456                                         ,new_c-chk-gds.line-num
     3457                                         ,v-field-name)
     3458       temp-changes.l_name = substitute("Строка товара &1 &2"
     3459                                         ,new_c-chk-gds.line-num
     3460                                         ,v-field-label)
     3461       temp-changes.v_old = (if p-is-add
     3462                             then "":U
     3463                             else string(buffer buf_c-chk-gds:buffer-field(v-real-field-name):buffer-value))
     3464       temp-changes.v_new = (if p-is-del
     3465                             then "":U
     3466                             else string(buffer new_c-chk-gds:buffer-field(v-real-field-name):buffer-value))
     3467       .
     3468       if v-field-function <> '':U then do:
     3469         assign
     3470         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     3471         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     3472         .
     3473       end.
     3474     end.
     3475   end.
     3476   if p-is-del or p-is-add
     3477   then
     3478   assign
     3479   v-chg-fields = get-all-fields("chk-pay":U)
     3480   v-chg-fields = replace(v-chg-fields, "obj-type,":U, "":U)
     3481   v-chg-fields = replace(v-chg-fields, "obj-code,":U, "":U)
     3482   v-chg-fields = replace(v-chg-fields, "doc-code,":U, "":U)
     3483   v-chg-fields = replace(v-chg-fields, "out-code,":U, "":U)
     3484   .
     3485   for each new_c-chk-pay no-lock where
     3486               new_c-chk-pay.doc-code = p-doc-code
     3487           AND new_c-chk-pay.chip-num = p-new-chip-num
     3488               ,
     3489       first buf_c-chk-pay no-lock where
     3490             buf_c-chk-pay.doc-code = p-doc-code
     3491         AND buf_c-chk-pay.chip-num = p-chip-num
     3492         AND buf_c-chk-pay.line-num = new_c-chk-pay.line-num:
     3493     if not (p-is-del or p-is-add ) then
     3494     buffer-compare
     3495     new_c-chk-pay to buf_c-chk-pay
     3496     case-sensitive
     3497     save result in v-chg-fields.
     3498     _ii:
     3499     do ii = 1 to num-entries(v-chg-fields):
     3500       assign
     3501       v-field-name = entry(ii, v-chg-fields)
     3502       jj = lookup(v-field-name, "bank-rate,bank-scale,cash-rate,curr-code,is-error,line-num,line-sign," +                        "line-type,pass-pay,pay-card,pay-code,time-oper," +                        "tot-base,tot-rubl,tot-sum").
     3503       if jj = 0 then next _ii.
     3504       assign
     3505       v-field-label = entry(jj, "Курс ЦБ РФ,Масштаб курса банка ЦБ РФ,Курс,Код валюты,Ош,Номер строки,Знак строки," +                         "Тип,Прохождение платежа (картой или вручную),Номер пл карты карты,код оплаты,Время в сек," +                         "Сумма в баз.в.,Сумма в руб.,Сумма в валюте оплаты")
     3506       v-real-field-name = entry(1, v-field-name, ':')
     3507       .
     3508       create temp-changes.
     3509       assign
     3510       temp-changes.f_name = substitute("chk-pay &1&2&1&3":U
     3511                                        ,chr(4)
     3512                                        ,new_c-chk-pay.line-num
     3513                                        ,v-field-name)
     3514       temp-changes.l_name = substitute("Строка оплат &1 &2"
     3515                                         ,new_c-chk-pay.line-num
     3516                                         ,v-field-label)
     3517       temp-changes.v_old = (if p-is-add
     3518                            then '':U
     3519                            else string(buffer buf_c-chk-pay:buffer-field(v-field-name):buffer-value))
     3520       temp-changes.v_new = (if p-is-del
     3521                            then '':U
     3522                            else string(buffer new_c-chk-pay:buffer-field(v-field-name):buffer-value))
     3523       .
     3524     end.
     3525   end.
     3526   if p-is-del or p-is-add
     3527   then
     3528   assign
     3529   v-chg-fields = get-all-fields("chk-discnt":U)
     3530   v-chg-fields = replace(v-chg-fields, "obj-type,":U, "":U)
     3531   v-chg-fields = replace(v-chg-fields, "obj-code,":U, "":U)
     3532   v-chg-fields = replace(v-chg-fields, "doc-code,":U, "":U)
     3533   v-chg-fields = replace(v-chg-fields, "out-code,":U, "":U)
     3534   .
     3535   for each new_c-chk-discnt no-lock where
     3536               new_c-chk-discnt.doc-code = p-doc-code
     3537           AND new_c-chk-discnt.chip-num = p-new-chip-num
     3538               ,
     3539       first buf_c-chk-discnt no-lock where
     3540            buf_c-chk-discnt.doc-code = p-doc-code
     3541        AND buf_c-chk-discnt.chip-num = p-chip-num
     3542        AND buf_c-chk-discnt.line-num = new_c-chk-discnt.line-num
     3543     :
     3544     if not (p-is-del or p-is-add ) then
     3545     buffer-compare
     3546     new_c-chk-discnt to buf_c-chk-discnt
     3547     case-sensitive
     3548     save result in v-chg-fields.
     3549     _ii:
     3550     do ii = 1 to num-entries(v-chg-fields):
     3551       assign
     3552       v-field-name = entry(ii, v-chg-fields)
     3553       jj = lookup(v-field-name, "discnt-id,discnt-type,discnt-value-abs,discnt-value-pcnt,is-error,line-num,line-sign," +                         "line-type,object-line-num,object-qnty,object-sum,pass-discnt,record-type,time-oper,value-type").
     3554       if jj = 0 then next _ii.
     3555       assign
     3556       v-field-label = entry(jj, "Вн.№ скидки,Тип скидки,Abs значение скидки,Проц значение скидки,Ош,№ строки скидки,Знак строки," +                          "Тип,№ товарной строки для скидки,Количество,Сумма до скидки,Ввод скидки (картой или вручную),Тип записи,Время в сек,Тип значения")
     3557       v-real-field-name = entry(1, v-field-name, ':')
     3558       .
     3559       create temp-changes.
     3560       assign
     3561       temp-changes.f_name = substitute("chk-discnt&1&2&1&3&1&4&1&5&1&6"
     3562                                        ,chr(4)
     3563                                        ,new_c-chk-discnt.record-type
     3564                                        ,new_c-chk-discnt.line-num
     3565                                        ,new_c-chk-discnt.object-line-num
     3566                                        ,new_c-chk-discnt.discnt-id
     3567                                        ,v-field-name)
     3568       temp-changes.l_name = substitute("Строка скидки &1 &2 к строке товара &3 &4"
     3569                                        ,new_c-chk-discnt.line-num
     3570                                        ,(if new_c-chk-discnt.record-type = 0 then ' (исх) ' else ' (выч) ')
     3571                                        ,new_c-chk-discnt.object-line-num
     3572                                        ,v-field-label)
     3573       temp-changes.v_old = (if p-is-add
     3574                            then '':U
     3575                            else string(buffer buf_c-chk-discnt:buffer-field(v-real-field-name):buffer-value))
     3576       temp-changes.v_new = (if p-is-del
     3577                            then '':U
     3578                            else string(buffer new_c-chk-discnt:buffer-field(v-real-field-name):buffer-value))
     3579       .
     3580     end.
     3581   end.
     3582   assign
     3583   v-chg-fields = get-all-fields("chk-doc-attr":U)
     3584   .
     3585   for each new_c-chk-doc-attr no-lock where
     3586               new_c-chk-doc-attr.doc-code = p-doc-code
     3587           AND new_c-chk-doc-attr.chip-num = p-new-chip-num
     3588               ,
     3589       first buf_c-chk-doc-attr no-lock where
     3590            buf_c-chk-doc-attr.doc-code = p-doc-code
     3591        AND buf_c-chk-doc-attr.chip-num = p-chip-num
     3592      AND buf_c-chk-doc-attr.attr-code = new_c-chk-doc-attr.attr-code:
     3593     if not (p-is-del or p-is-add ) then
     3594     buffer-compare
     3595     new_c-chk-doc-attr to buf_c-chk-doc-attr
     3596     case-sensitive
     3597     save result in v-chg-fields.
     3598     _ii:
     3599     do ii = 1 to num-entries(v-chg-fields):
     3600       assign
     3601       v-field-name = entry(ii, v-chg-fields)
     3602       jj = lookup(v-field-name, "attr-code,attr-value").
     3603       if jj = 0 then next _ii.
     3604       assign
     3605       v-field-label = entry(jj, "Код атрибута,Значение атрибута")
     3606       v-real-field-name = entry(1, v-field-name, ':')
     3607       .
     3608       create temp-changes.
     3609       assign
     3610       temp-changes.f_name = substitute("chk-doc-attr&1&2&2&3"
     3611                                        ,chr(4)
     3612                                        ,new_c-chk-doc-attr.attr-code
     3613                                        ,v-field-name)
     3614       temp-changes.l_name = substitute("Атрибут чека &1 &2"
     3615                                         ,new_c-chk-doc-attr.attr-code
     3616                                         ,v-field-label)
     3617       temp-changes.v_old = string(buffer buf_c-chk-doc-attr:buffer-field(v-field-name):buffer-value)
     3618       temp-changes.v_new = string(buffer new_c-chk-doc-attr:buffer-field(v-field-name):buffer-value)
     3619       .
     3620     end.
     3621   end.
     3622   END PROCEDURE.
     3623   PROCEDURE MyEnable :
     3624   define buffer buf_currency for ub.currency.
     3625   ASSIGN
     3626   br-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 6
     3627   X_c-chk-doc.cashier:READ-ONLY IN BROWSE br-docs = YES
     3628   temp-changes.l_name:resizable in browse br-changes = true
     3629   temp-changes.v_old:resizable in browse br-changes = true
     3630   temp-changes.v_new:resizable in browse br-changes = true
     3631   temp-changes.l_name:width in browse br-changes = 50
     3632   temp-changes.v_old:width in browse br-changes = 20
     3633   temp-changes.v_new:width in browse br-changes = 20
     3634   .
     3635   if p-mode =  "one":u then do:
     3636     assign
     3637     p-obj-type = X_c-chk-doc.obj-type
     3638     p-obj-code = X_c-chk-doc.obj-code
     3639     .
     3640   end.
     3641   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3642   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3643     (input  p-obj-type
     3644     ,input  p-obj-code
     3645     ,output v-host-code
     3646     )  .
     3647   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3649     (input  v-host-code
     3650     ,output v-base-code
     3651     )  .
     3652   find first buf_currency no-lock where
     3653           buf_currency.curr-code = v-base-code.
     3654   assign
     3655   v-base-type = buf_currency.curr-abbr.
     3656   DISPLAY
     3657   ED-notes
     3658   mark-num
     3659   WITH FRAME Dialog-Frame.
     3660   ENABLE
     3661   b-quit
     3662   b-help
     3663   br-docs
     3664   b-lkp
     3665   b-restore WHEN (LOOKUP("b-restore", bttns) > 0 and p-mode = 'удаление':U)
     3666   b-sel  when LOOKUP("b-sel":U, bttns) > 0
     3667   b-mark when LOOKUP("b-mark":U, bttns) > 0
     3668   b-sch
     3669   b-print
     3670   br-changes
     3671   WITH FRAME Dialog-Frame.
     3672   VIEW FRAME Dialog-Frame.
     3673   END PROCEDURE.
     3674   PROCEDURE OpenBr :
     3675   define input  parameter p-open-query     as logical   no-undo .
     3676   define input  parameter p-find-next      as logical   no-undo .
     3677   define input  parameter p-find-condition as character no-undo .
     3678   define variable l-query-was-opened as logical no-undo .
     3679   define variable title0 as character no-undo.
     3680   title0 = "Список истории чеков" + chr(32).
     3681   run waitfram-show in this-procedure ( input "Ждите...").
     3682   define variable sort-column-phrase as character no-undo .
     3683   case sort-column-name :
     3684     when "" then do:
     3685       assign
     3686         sort-column-phrase = ""
     3687       .
     3688     end.
     3689     otherwise do:
     3690       assign
     3691         sort-column-phrase = "by " + sort-column-name
     3692       .
     3693     end.
     3694   end case.
     3695   define variable l-open-query as logical   no-undo .
     3696     CASE p-mode :
     3697       WHEN "one":U        THEN DO:
     3698        assign
     3699        filter-point = filter-point0 + p-mode
     3700        filter-label = substitute("&1", filter-label0)
     3701        frame Dialog-Frame :title = substitute("История изменения чека &1", p-doc-code)
     3702        .
     3703   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3704   define variable  l-disable-where-32  as logical   no-undo .
     3705   define variable  l-filter-open-32    as logical   .
     3706   define variable  flt-rec-32       as recid     no-undo .
     3707   define variable  filter-name-32      as character no-undo .
     3708   define variable  where-phrase-32     as character no-undo .
     3709   define variable  sort-phrase-32      as character no-undo .
     3710   define variable  where-phrase-rus-32 as character no-undo .
     3711   define variable  sort-phrase-rus-32  as character no-undo .
     3712     run waitfram-show in this-procedure
     3713       (input "ЖДИТЕ ..."
     3714       ).
     3715   run gbl/flt-get.p
     3716     (input filter-point
     3717     ,output flt-rec-32
     3718     ,output filter-name-32
     3719     ,output where-phrase-32
     3720     ,output sort-phrase-32
     3721     ,output where-phrase-rus-32
     3722     ,output sort-phrase-rus-32
     3723     ).
     3724   if p-open-query then do:
     3725       run set-filter-name in this-procedure
     3726         (INPUT filter-name-32
     3727         ) no-error .
     3728     assign
     3729       l-filter-open-32 = false
     3730     .
     3731     if flt-rec-32 <> ?
     3732       or sort-column-phrase > ""
     3733     then do:
     3734       define variable  parameter-2-32 as character no-undo .
     3735       define variable  parameter-3-32 as character no-undo .
     3736       define variable  parameter-4-32 as character no-undo .
     3737       define variable  parameter-5-32 as character no-undo .
     3738       define variable  parameter-6-32 as character no-undo .
     3739       define variable  parameter-7-32 as character no-undo .
     3740         assign
     3741         parameter-3-32 =
     3742                                 "FOR EACH X_c-chk-doc"
     3743         parameter-4-32 =
     3744           (
     3745             if (" X_c-chk-doc.doc-code = p-doc-code " + " " + where-phrase-32) <> ""
     3746             then  substitute('X_c-chk-doc.doc-code = &1&2&1', chr(34), p-doc-code ) + " " + where-phrase-32
     3747             else "true"
     3748           )
     3749         parameter-5-32 = (" " + "" + " " + "")
     3750         parameter-6-32 = if sort-phrase-32 = ''
     3751                              then
     3752           (
     3753           " " + "  " +
     3754             " " + sort-column-phrase +
     3755           " " + " by X_c-chk-doc.chip-num descending "
     3756           )
     3757                              else
     3758           (
     3759           " " + "  " +
     3760             " " + sort-column-phrase +
     3761           " " + sort-phrase-32
     3762           )
     3763         parameter-7-32 =
     3764           " indexed-reposition  "
     3765       .
     3766       do
     3767       on stop undo, leave
     3768       on error undo, leave
     3769       :
     3770         assign
     3771           l-disable-where-32 =
     3772             (" X_c-chk-doc.doc-code = p-doc-code " + " " + where-phrase-32 = "")
     3773         .
     3774         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3775                             ,input QUERY br-docs:handle
     3776                             ,input parameter-3-32
     3777                             ,input parameter-4-32
     3778                             ,input parameter-5-32
     3779                             ,input parameter-6-32
     3780                             ,input parameter-7-32
     3781                             )
     3782         .
     3783         assign
     3784           l-filter-open-32 = true
     3785         .
     3786       end.
     3787       if l-filter-open-32 = false then do:
     3788         message
     3789           "Ошибка при фильтрации / сортировке" skip
     3790           "Будут показаны записи без учета фильтра" skip
     3791           view-as alert-box .
     3792       end.
     3793       else do:
     3794           assign
     3795             l-query-was-opened = true
     3796           .
     3797       end.
     3798     end.
     3799     if l-filter-open-32 = false then do:
     3800       OPEN QUERY br-docs FOR EACH X_c-chk-doc
     3801         where  X_c-chk-doc.doc-code = p-doc-code
     3802          by X_c-chk-doc.chip-num descending
     3803         indexed-reposition
     3804     .
     3805         assign
     3806           l-query-was-opened = true
     3807         .
     3808     end.
     3809   end.
     3810   else do:
     3811     assign
     3812       v-doc-rec = recid( X_c-chk-doc )
     3813     .
     3814     do
     3815     on stop undo, leave
     3816     on error undo, leave
     3817     :
     3818       if QUERY br-docs:handle:get-buffer-handle(1) = (buffer X_c-chk-doc:handle) then do:
     3819         assign
     3820         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3821         parameter-4-32 =
     3822           "where ":u +  substitute('X_c-chk-doc.doc-code = &1&2&1', chr(34), p-doc-code ) + " ":u + where-phrase-32 + " ":u + p-find-condition + " " + ""
     3823         parameter-5-32 = "  "
     3824       .
     3825         run fltopend_fltfindd in this-procedure  (
     3826                             input this-procedure:handle
     3827                             ,input QUERY br-docs:handle
     3828                             ,input rowid(X_c-chk-doc)
     3829                             ,input logical(parameter-2-32)
     3830                             ,input no-lock
     3831                             ,input (buffer X_c-chk-doc:handle)
     3832                             ,input parameter-4-32
     3833                             ,input parameter-5-32
     3834                             ) no-error.
     3835         .
     3836         assign
     3837           v-doc-rec = integer(return-value)
     3838           v-fltopend-rowid[1] = ?
     3839         .
     3840       end.
     3841       else do:
     3842         assign
     3843         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3844         parameter-3-32 =  "FOR EACH X_c-chk-doc"
     3845         parameter-4-32 =
     3846           (
     3847             if (" X_c-chk-doc.doc-code = p-doc-code " + " " + where-phrase-32) <> ""
     3848             then  substitute('X_c-chk-doc.doc-code = &1&2&1', chr(34), p-doc-code ) + " " + where-phrase-32
     3849             else "true"
     3850           )
     3851         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
     3852         parameter-6-32 = if sort-phrase-32 = ''
     3853                              then
     3854           (
     3855           " " + "  " +
     3856             " " + sort-column-phrase +
     3857           " " + " by X_c-chk-doc.chip-num descending "
     3858           )
     3859                              else
     3860           (
     3861           " " + "  " +
     3862             " " + sort-column-phrase +
     3863           " " + sort-phrase-32
     3864           )
     3865         parameter-7-32 =
     3866           " indexed-reposition  "
     3867       .
     3868         run fltopend_fltfindq in this-procedure  (
     3869                             input this-procedure:handle
     3870                             ,input QUERY br-docs:handle
     3871                             ,input logical(parameter-2-32)
     3872                             ,input no-lock
     3873                             ,input parameter-3-32
     3874                             ,input parameter-4-32
     3875                             ,input parameter-5-32
     3876                             ,input parameter-6-32
     3877                             ,input parameter-7-32
     3878                             ,output v-fltopend-rowid
     3879                             ) no-error.
     3880         .
     3881         v-doc-rec = ?.
     3882       end.
     3883       assign
     3884         l-query-was-opened = true
     3885       .
     3886     end.
     3887   end.
     3888     run waitfram-hide in this-procedure .
     3889       END.
     3890       WHEN 'удаление':U        THEN DO:
     3891        assign
     3892        filter-point = filter-point0 + p-mode
     3893        filter-label = substitute("&1 удаленные чеки", filter-label0)
     3894        frame Dialog-Frame :title = substitute("Чеки, удаленные в &1&2", p-obj-type, p-obj-code)
     3895        .
     3896   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
