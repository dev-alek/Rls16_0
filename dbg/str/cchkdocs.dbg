       15   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive: str/cchkdocs.w $":U.
       16   define variable vss-description AS CHAR NO-UNDO INIT "Список истории чеков":U.
       17   procedure vss-get-info :
