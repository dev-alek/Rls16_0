     1223   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1224   procedure fltopend_fltopend :
     1225   define input parameter p-parent-handle as handle no-undo .
     1226   define input parameter p-qh as handle no-undo .
     1227   define input parameter p-flt-open-open-query  as character no-undo .
     1228   define input parameter p-where-cond as character no-undo .
     1229   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1230   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1231   define input parameter p-indexed-reposition as character no-undo .
     1232     do
     1233     on error undo, return error
     1234     :
     1235   define variable v-prepare-string as character no-undo .
     1236   define variable glog as logical no-undo .
     1237   assign
     1238   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1239                      p-where-cond + chr(32)  +
     1240                      p-use-indFIRST-query-tail + chr(32) +
     1241                      p-use-ind-sort-clmn-by + chr(32) +
     1242                      p-indexed-reposition
     1243   .
     1244   assign
     1245   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1246   if not glog
     1247   or error-status:error then do:
     1248     message error-status:get-message(1) view-as alert-box .
     1249     undo, return error .
     1250   end.
     1251   assign
     1252   glog = p-qh:query-open no-error .
     1253   if not glog
     1254   or error-status:error then do:
     1255     message error-status:get-message(1) view-as alert-box .
     1256     undo, return error .
     1257   end.
     1258     end.
     1259   end procedure.
     1260   procedure fltopend_fltfindd :
     1261   define input parameter p-parent-handle as handle no-undo .
     1262   define input parameter p-qh as handle no-undo .
     1263   define input parameter p-rowid as rowid no-undo .
     1264   define input parameter p-next as logical no-undo .
     1265   define input parameter p-lock as integer no-undo .
     1266   define input parameter p-bh as handle no-undo .
     1267   define input parameter p-where-cond as character no-undo .
     1268   define input parameter p-use-index-phrase as character no-undo .
     1269   define variable glog as logical no-undo .
     1270   define variable v-qh as handle no-undo .
     1271   define variable v-bh as handle no-undo .
     1272   define variable v-recid as recid no-undo .
     1273   define variable v-prepare-string as character no-undo .
     1274   do
     1275   on error undo, return error
     1276   on stop undo, return error
     1277   :
     1278     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1279     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1280     create query v-qh.
     1281     v-qh:set-buffers(v-bh).
     1282     v-prepare-string = substitute("for each &1 &2 &3"
     1283                                     ,v-bh:name
     1284                                     ,p-where-cond
     1285                                     ,p-use-index-phrase).
     1286     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1287     if not glog then do:
     1288       delete object v-qh.
     1289       delete object v-bh.
     1290       undo, return error .
     1291     end.
     1292     glog = v-qh:query-open no-error .
     1293     if not glog then do:
     1294       delete object v-qh.
     1295       delete object v-bh.
     1296       undo, return error .
     1297     end.
     1298     if p-next then do:
     1299       v-qh:reposition-to-rowid(p-rowid) no-error .
     1300       glog = v-qh:get-next( p-lock) no-error .
     1301       glog = v-qh:get-next( p-lock) no-error .
     1302       if not glog or v-qh:query-off-end = yes then do:
     1303         glog = v-qh:get-first( p-lock) no-error .
     1304       end.
     1305     end.
     1306     else do:
     1307       glog = v-qh:get-first( p-lock) no-error .
     1308     end.
     1309     v-recid = v-bh:recid no-error .
     1310     delete object v-qh.
     1311     delete object v-bh.
     1312     return string(v-recid) .
     1313   end.
     1314   end procedure.
     1315   procedure fltopend_fltfindq :
     1316   define input parameter p-parent-handle as handle no-undo .
     1317   define input parameter p-qh as handle no-undo .
     1318   define input parameter p-next as logical no-undo .
     1319   define input parameter p-lock as integer no-undo .
     1320   define input parameter p-flt-open-open-query  as character no-undo .
     1321   define input parameter p-where-cond as character no-undo .
     1322   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1323   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1324   define input parameter p-indexed-reposition as character no-undo .
     1325   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1326   define variable glog as logical no-undo .
     1327   define variable v-qh as handle no-undo .
     1328   define variable v-bh as handle no-undo extent 18.
     1329   define variable v-rowid as rowid no-undo extent 18.
     1330   define variable v-ii as integer no-undo .
     1331   define variable v-prepare-string as character no-undo .
     1332   do
     1333   on error undo, return error
     1334   on stop undo, return error
     1335   :
     1336     create query v-qh.
     1337     do v-ii = 1 to p-qh:num-buffers:
     1338       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1339       assign
     1340       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1341       no-error.
     1342       v-qh:add-buffer(v-bh[v-ii]).
     1343     end.
     1344     assign
     1345     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1346                       p-where-cond + chr(32)  +
     1347                       p-use-indFIRST-query-tail + chr(32) +
     1348                       p-use-ind-sort-clmn-by + chr(32) +
     1349                       p-indexed-reposition
     1350     .
     1351     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1352     if not glog then do:
     1353       delete object v-qh.
     1354       do v-ii = 1 to p-qh:num-buffers:
     1355         delete object v-bh[v-ii].
     1356       end.
     1357       undo, return error .
     1358     end.
     1359     glog = v-qh:query-open no-error .
     1360     if not glog then do:
     1361       delete object v-qh.
     1362       do v-ii = 1 to p-qh:num-buffers:
     1363         delete object v-bh[v-ii].
     1364       end.
     1365       undo, return error .
     1366     end.
     1367     if p-next then do:
     1368       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1369       glog = v-qh:get-next( p-lock) no-error .
     1370       glog = v-qh:get-next( p-lock) no-error .
     1371       if not glog or v-qh:query-off-end = yes then do:
     1372         glog = v-qh:get-first( p-lock) no-error .
     1373       end.
     1374     end.
     1375     else do:
     1376       glog = v-qh:get-first( p-lock) no-error .
     1377     end.
     1378     do v-ii = 1 to p-qh:num-buffers:
     1379       assign
     1380       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1381       no-error.
     1382     end.
     1383     delete object v-qh.
     1384     do v-ii = 1 to p-qh:num-buffers:
     1385       delete object v-bh[v-ii].
     1386     end.
     1387   end.
     1388   end procedure.
     1389   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1390   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1391   define variable filter-label as character no-undo init "Список истории чеков" .
     1392   define variable filter-label0 as character no-undo init "Список истории чеков" .
     1393   define variable filter-point as character no-undo init "cchkdocs" .
     1394   define variable filter-point0 as character no-undo init "cchkdocs" .
