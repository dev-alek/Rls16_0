     3939             then  substitute('X_c-chk-doc.obj-type = &1&2&1 and X_c-chk-doc.obj-code = &3 and X_c-chk-doc.is-del = yes '                               , chr(34), p-obj-type, p-obj-code) + " " + where-phrase-34
