       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define variable c-point  as character no-undo .
       79   define variable tbl      as character no-undo .
       80   define variable join-tbl as character no-undo .
       81   define variable fld      as character no-undo .
       82   define variable lab      as character no-undo .
       83   define variable spr      as character no-undo .
       84   define variable dim      as character no-undo .
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure fltfield-clear :
       87     define output parameter loc-fld as character no-undo.
       88     define output parameter loc-lab as character no-undo .
       89     define output parameter loc-spr as character no-undo .
       90     define output parameter loc-dim as character no-undo .
       91     assign
       92       loc-fld = ""
       93       loc-lab = ""
       94       loc-spr = ""
       95       loc-dim = "0"
       96     .
       97   end procedure .
       98   procedure fltfield-add :
       99     define input        parameter par-fld as character no-undo.
      100     define input        parameter par-lab as character no-undo .
      101     define input        parameter par-spr as character no-undo .
      102     define input-output parameter loc-fld as character no-undo.
      103     define input-output parameter loc-lab as character no-undo .
      104     define input-output parameter loc-spr as character no-undo .
      105     define input-output parameter loc-dim as character no-undo .
      106     do
      107     on error undo, return error
      108     :
      109       assign
      110       loc-fld = if loc-dim = '0'
      111                 then par-fld
      112                 else (loc-fld + chr(44) + par-fld)
      113       loc-lab = if loc-dim = '0'
      114                 then par-lab
      115                 else (loc-lab + chr(44) + par-lab)
      116       loc-spr = if loc-dim = '0'
      117                 then par-spr
      118                 else (loc-spr + chr(44) + par-spr)
      119       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      120                 string(integer(if num-entries(loc-dim) > 1
      121                               then entry(2, loc-dim)
      122                               else entry(1, loc-dim)
      123                               ) + 1)
      124       no-error
      125       .
      126     end.
      127   end procedure.
      128   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      130   define new shared variable RepPathName        as character no-undo .
      131   define new shared variable PrintRubl          as logical   no-undo .
      132   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define  stream PrnLibStream.
      134   procedure prn-lib-prn-file :
      135     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      136     define input parameter p-DIsabledoptions as integer no-undo .
      137     define variable v-report-name as character no-undo .
      138     define variable v-user-action as character no-undo .
      139     define variable v-printed     as logical   no-undo .
      140     define variable v-exist       as logical   no-undo .
      141     do
      142       on error undo, return error
      143       :
      144       run prn-lib-get-report-name  in this-procedure (
      145         input parParentProc
      146         ,output v-report-name
      147         ).
      148   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      150     (input  v-report-name
      151     ,input  2
      152     ,output v-exist
      153     )  .
      154       if NOT v-exist then
      155       DO:
      156         Message
      157           "Нет заданий на печать ! "
      158           view-as alert-box .
      159         Return  .
      160       End.
      161       run gbl/prnfilen.w
      162         (input  ""
      163         ,input  p-DisabledOptions
      164         ,input  string(v-report-name )
      165         ,input  7
      166         ,output v-user-action
      167         ,output v-printed
      168         ) .
      169       if v-printed then
      170       do:
      171         return "YES" .
      172       end.
      173       else
      174       do:
      175         return "NO" .
      176       end.
      177     end.
      178   end procedure.
      179   procedure prn-lib-open-stream :
      180     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      181     define input parameter p-page-size    as integer no-undo .
      182     define input parameter p-is-stream    as logical no-undo .
      183     define input parameter p-append       as logical no-undo .
      184     define variable v-report-name as character no-undo .
      185     do
      186       on error undo, return error
      187       :
      188       run prn-lib-get-report-name  in this-procedure (
      189         input parParentProc
      190         ,output v-report-name
      191         ).
      192       if p-is-stream then
      193       do:
      194         if p-append then
      195         do:
      196           output stream PrnLibStream to value( v-report-name )
      197             page-size value(p-page-size) append .
      198         end.
      199         if not p-append then
      200         do:
      201           output stream PrnLibStream to value( v-report-name )
      202             page-size value(p-page-size) .
      203         end.
      204       end.
      205       if not p-is-stream then
      206       do:
      207         if p-append then
      208         do:
      209           output to value( v-report-name )
      210             page-size value(p-page-size) append .
      211         end.
      212         if not p-append then
      213         do:
      214           output to value( v-report-name )
      215             page-size value(p-page-size) .
      216         end.
      217       end.
      218     end.
      219   end procedure.
      220   procedure prn-lib-open-exp :
      221     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      222     define input parameter p-is-stream    as logical no-undo .
      223     define input parameter p-is-append    as logical no-undo .
      224     define output parameter p-ReportFileName as char init "report" no-undo.
      225     define output parameter p-process as logical no-undo .
      226     define variable glog as logical no-undo .
      227     do
      228       on error undo, return error
      229       :
      230       SYSTEM-DIALOG GET-FILE p-ReportFileName
      231         TITLE      "Укажите путь"
      232         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      233         ASK-OVERWRITE
      234         CREATE-TEST-FILE
      235         SAVE-AS
      236         USE-FILENAME
      237         DEFAULT-EXTENSION "txt"
      238         UPDATE glog
      239         .
      240       if not glog then  return.
      241       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      242       if p-is-stream then
      243       do:
      244         if p-is-append then
      245         do:
      246           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      247         end.
      248         else
      249         do:
      250           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      251         end.
      252       end.
      253       else
      254       do:
      255         if p-is-append then
      256         do:
      257           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      258         end.
      259         else
      260         do:
      261           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      262         end.
      263       end.
      264       p-process = yes.
      265     end.
      266   end procedure.
      267   procedure prn-lib-get-report-name :
      268     define input parameter parParentProc  as widget-handle no-undo.
      269     define output parameter p-report-name as character no-undo .
      270     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      271   end procedure.
      272   procedure prn-lib-reportviewer-report-name :
      273     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      274     define input parameter p-report-name-html as character no-undo .
      275     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      276   end procedure.
      277   procedure prn-lib-reportviewer :
      278     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      279     define input parameter p-report-name-html as character no-undo .
      280     define input parameter p-param        as character no-undo .
      281     define variable v-excel           as character no-undo init 'TRUE' .
      282     define variable v-value-character as character no-undo .
      283     define variable v-value-integer   as character no-undo .
      284     define variable v-value-date      as date      no-undo .
      285     define variable v-value-decimal   as decimal   no-undo .
      286     define variable rep-excel         as logical   no-undo .
      287     define variable excel-string      as character no-undo .
      288     define variable v-param-type      as character no-undo .
      289     define variable v-tth             as handle    no-undo .
      290     run adm/shattri.p (
      291       input "get":U
      292       ,input  ""
      293       ,input  0
      294       ,input  'report-glob':U
      295       ,input  'rep-excel':U
      296       ,output v-value-character
      297       ,output v-value-date
      298       ,output v-value-decimal
      299       ,output v-value-integer
      300       ,output rep-excel
      301       ,output v-param-type
      302       ,INPUT-OUTPUT table-handle v-tth
      303       )  .
      304     if rep-excel then v-excel = "TRUE" .
      305     else v-excel = "FALSE" .
      306     if p-param eq ""
      307     then
      308        p-param = "EXCEL:" + v-excel.
      309     else
      310        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      311     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      312   end procedure.
      313   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      314   define  temp-table temp-changes no-undo
      315   field f_name as character
      316   field l_name as character
      317   field v_old as character
      318   field v_new as character
      319   field t_name as character
      320   field num_ as integer
      321   field uniq-key-rec as character
      322   field action as integer
      323   field fNotChange as logical
      324   index pi is unique primary
      325   num_
      326   t_name
      327   f_name
      328   index
      329   Chan
      330   fnotChange
      331   t_name
      332   f_name
      333   index imain uniq-key-rec
      334   .
      335   FUNCTION get-all-fields returns character (p-file-name as character ):
      336   define variable v-dop as character no-undo .
      337     find first _file no-lock where _file._file-name = p-file-name no-error .
      338     if not available _file then return "":U.
      339     for each _field no-lock where
      340              _field._file-recid = recid(_file) :
      341       assign
      342       v-dop = v-dop + _field._field-name + chr(44)
      343       .
      344     end.
      345     return trim(v-dop).
      346   END FUNCTION.
      347   PROCEDURE proc-full-temp-changes :
      348     define input  parameter p-hst-handle as handle    no-undo .
      349     define input  parameter p-main-table as character no-undo .
      350     define input  parameter p-field-list as character no-undo .
      351     define input  parameter p-label-form as character no-undo .
      352     define variable h-new-buf         as handle    no-undo .
      353     define variable h-main-buf        as handle    no-undo .
      354     define variable h-for-comp        as handle    no-undo .
      355     define variable v-inform          as character no-undo .
      356     define variable v-ind             as integer   no-undo .
      357     define variable v-idx-field-qnty  as integer   no-undo .
      358     define variable v-num-entries     as integer   no-undo .
      359     define variable fh                as handle    no-undo .
      360     define variable fh-main           as handle    no-undo .
      361     define variable fh-old            as handle    no-undo .
      362     define variable fh-new            as handle    no-undo .
      363     define variable v-field-name      as character no-undo .
      364     define variable v-field-lvl       as character no-undo .
      365     define variable v-field-form      as character no-undo .
      366     define variable v-search-exp      as character no-undo .
      367     define variable v-srch-main       as character no-undo .
      368     define variable v-word-link       as character no-undo .
      369     define variable v-av-chip-num     as logical   no-undo .
      370     define variable v-main-pi-fld-lst as character no-undo .
      371     define variable v-main-fld-lst    as character no-undo .
      372     define variable v-delim-list      as character no-undo .
      373     define variable v-label           as character no-undo .
      374     define variable v-old-value       as character no-undo case-sensitive.
      375     define variable v-new-value       as character no-undo case-sensitive.
      376     define variable v-chg-fields as character no-undo.
      377     for each temp-changes:
      378       delete temp-changes.
      379     end.
      380     if not p-hst-handle:available then do:
      381       return .
      382     end.
      383     create buffer h-new-buf  for table p-hst-handle .
      384     create buffer h-main-buf for table p-main-table .
      385     assign
      386       v-inform = h-main-buf:index-information(1)
      387       v-ind    = 2
      388     .
      389     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      390     on error undo, return error
      391     :
      392       assign
      393         v-inform = h-main-buf:index-information( v-ind )
      394         v-ind    = v-ind + 1
      395       .
      396     end.
      397     if v-inform = ?
      398       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      399       or entry( 3, v-inform, ",":U ) <> "1":U
      400     then do:
      401       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      402     end.
      403     assign
      404       v-idx-field-qnty = num-entries( v-inform ) - 4
      405     .
      406     if v-idx-field-qnty < 2 then do:
      407       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      408     end.
      409     assign
      410       v-srch-main   = "where":U
      411       v-word-link   = "":U
      412       v-av-chip-num = false
      413       v-delim-list  = "":U
      414     .
      415     do v-ind = 1 to v-idx-field-qnty by 2
      416     on error undo, return error
      417     :
      418       assign
      419         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      420         fh                = p-hst-handle:buffer-field( v-field-name )
      421         fh-main           = h-main-buf:buffer-field( v-field-name )
      422         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      423         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      424       .
      425       if fh:data-type ="character":U then do:
      426         assign
      427           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      428         .
      429       end.
      430       else do:
      431         assign
      432           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      433         .
      434       end.
      435       if v-delim-list = "":U then do:
      436         assign
      437           v-delim-list = ",":U
      438         .
      439       end.
      440       if v-word-link = "":U then do:
      441         assign
      442           v-word-link = "and":U
      443         .
      444       end.
      445     end.
      446     assign
      447       v-delim-list  = "":U
      448     .
      449     do v-ind = 1 to h-main-buf:num-fields
      450     on error undo, return error
      451     :
      452       assign
      453         fh-main      = h-main-buf:buffer-field( v-ind )
      454         v-field-name = fh-main:name
      455       .
      456         assign
      457           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      458         .
      459         if v-delim-list = "":U then do:
      460           assign
      461             v-delim-list = ",":U
      462           .
      463         end.
      464     end.
      465     assign
      466       v-inform = p-hst-handle:index-information(1)
      467       v-ind    = 2
      468     .
      469     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      470     on error undo, return error
      471     :
      472       assign
      473         v-inform = p-hst-handle:index-information( v-ind )
      474         v-ind    = v-ind + 1
      475       .
      476     end.
      477     if v-inform = ?
      478       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      479       or entry( 3, v-inform, ",":U ) <> "1":U
      480     then do:
      481       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      482     end.
      483     assign
      484       v-idx-field-qnty = num-entries( v-inform ) - 4
      485     .
      486     if v-idx-field-qnty < 2 then do:
      487       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      488     end.
      489     assign
      490       v-search-exp  = "where":U
      491       v-word-link   = "":U
      492       v-av-chip-num = false
      493     .
      494     do v-ind = 1 to v-idx-field-qnty by 2
      495     on error undo, return error
      496     :
      497       assign
      498         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      499         fh           = p-hst-handle:buffer-field( v-field-name )
      500         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      501       .
      502       if v-field-name = "chip-num":U then do:
      503         assign
      504           v-search-exp  = substitute( "&1 >", v-search-exp )
      505           v-av-chip-num = true
      506         .
      507       end.
      508       else do:
      509         assign
      510           v-search-exp = substitute( "&1 =", v-search-exp )
      511         .
      512       end.
      513       if fh:data-type ="character":U then do:
      514         assign
      515           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      516         .
      517       end.
      518       else do:
      519         assign
      520           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      521         .
      522       end.
      523       if v-word-link = "":U then do:
      524         assign
      525           v-word-link = "and":U
      526         .
      527       end.
      528     end.
      529     if v-av-chip-num = false then do:
      530       message
      531         vss-workfile vss-revision vss-description skip
      532         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      533         "Использование данной процедуры невозможно!" skip
      534         view-as alert-box error .
      535       return error .
      536     end.
      537     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      538     if not h-new-buf:available then do:
      539       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      540       if not h-main-buf:available then do:
      541         assign
      542           h-for-comp = ?
      543         .
      544       end.
      545       else do:
      546         assign
      547           h-for-comp = h-main-buf
      548         .
      549       end.
      550     end.
      551     else do:
      552       assign
      553         h-for-comp = h-new-buf
      554       .
      555     end.
      556     assign
      557       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      558     .
      559     do v-ind = 1 to v-num-entries
      560     on error undo, return error return-value
      561     :
      562       assign
      563         v-field-name = entry( v-ind, v-main-fld-lst )
      564         fh-old       = p-hst-handle:buffer-field( v-field-name )
      565         v-old-value  = fh-old:buffer-value()
      566         v-label      = trim( fh-old:label )
      567       .
      568       if ( trim( p-field-list ) <> "":U
      569            and lookup( v-field-name, p-field-list ) > 0
      570          )
      571          or trim( p-field-list ) = "":U
      572       then do:
      573         if h-for-comp <> ? then do:
      574           assign
      575             fh-new      = h-for-comp:buffer-field( v-field-name )
      576             v-new-value = fh-new:buffer-value()
      577           .
      578         end.
      579         else do:
      580           assign
      581             v-new-value = "":U
      582           .
      583         end.
      584         if v-old-value <> v-new-value
      585         then do:
      586           create temp-changes.
      587           assign
      588             temp-changes.t_name = p-main-table
      589             temp-changes.f_name = v-field-name
      590             temp-changes.l_name = replace( v-label, "&":U, "":U )
      591             temp-changes.v_old  = trim( v-old-value )
      592             temp-changes.v_new  = trim( v-new-value )
      593             temp-changes.num_   = 0
      594             temp-changes.fNotChange = v-old-value eq v-new-value
      595           .
      596         end.
      597       end.
      598     end.
      599     assign
      600       v-num-entries = num-entries( p-label-form, chr(8) )
      601     .
      602     do v-ind = 1 to v-num-entries
      603     on error undo, return error return-value
      604     :
      605       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      606         assign
      607           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      608           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      609           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      610         .
      611         find first temp-changes
      612           where temp-changes.f_name = v-field-name
      613           no-error .
      614         if available temp-changes then do:
      615           if trim( v-field-lvl ) <> "":U then do:
      616             assign
      617               temp-changes.l_name = v-field-lvl
      618             .
      619           end.
      620           if trim( v-field-form ) <> "":U then do:
      621             assign
      622               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      623             .
      624             if h-for-comp <> ? then do:
      625               assign
      626                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      627               .
      628             end.
      629           end.
      630         end.
      631       end.
      632       else do:
      633         message
      634           vss-workfile vss-revision vss-description skip
      635           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      636           substitute( "список для поля '&1': '&2'"
      637                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      638                       ,entry( v-ind, p-label-form, chr(8) )
      639                     ) skip
      640           substitute( "полный список: &2", p-label-form ) skip
      641           view-as alert-box error .
      642       end.
      643     end.
      644     delete object h-new-buf .
      645     delete object h-main-buf .
      646   END PROCEDURE.
      647   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      648   define variable v-waitfram-action01         as character   no-undo .
      649   define variable v-waitfram-action02         as character   no-undo .
      650   define variable v-waitfram-action03         as character   no-undo .
      651   define variable mWaitFramTextBeg            as character   no-undo.
      652   define variable mWaitFramTextEnd            as character   no-undo.
      653   define variable mWaitFramView               as logical     no-undo.
      654   define variable mWaitProcEvent              as logical     no-undo init yes.
      655   define variable mWaitFramInterval           as integer     no-undo init 1 .
      656   define variable mWaitFramStop               as logical     no-undo.
      657   define variable mWaitFramStopUser           as logical     no-undo.
      658   define variable mWaitFramStopTimeOut        as logical     no-undo.
      659   define variable mWaitFramStartProc          as datetime-tz no-undo.
      660   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      661   define button B-WaitFramStop auto-end-key
      662        label "Стоп"
      663        size 10 by 1 tooltip "Остоновить процесс".
      664   define button B-viewProcInfo
      665        label "Информация"
      666        size 15 by 1 tooltip "Информация о процесс".
      667   define frame waitfram
      668     v-waitfram-action01 format "x(72)" no-label skip
      669     v-waitfram-action02 format "x(72)" no-label skip
      670     v-waitfram-action03 format "x(72)" no-label skip
      671     B-viewProcInfo
      672     B-WaitFramStop at row 4 col 30
      673     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      674     .
      675   define new global shared variable mBatchMode as logical no-undo init ?.
      676   define variable mFramBachModHandle as handle no-undo.
      677   mFramBachModHandle = frame waitfram:handle.
      678   define variable mFameOldVis as logical no-undo.
      679   define variable mVisCUrentVin as logical no-undo.
      680   if session:batch-mode
      681   then
      682      mBatchMode = yes.
      683   if mBatchMode = ? then do:
      684     mVisCUrentVin = current-window:visible.
      685     mFameOldVis = mFramBachModHandle:visible.
      686     mFramBachModHandle:visible  = yes.
      687     mBatchMode = mFramBachModHandle:visible ne yes.
      688     mFramBachModHandle:visible = mFameOldVis.
      689     current-window:visible = mVisCUrentVin.
      690   end.
      691    if  log-manager:logfile-name ne ?
      692     then DO:
      693         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      694         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      695         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      696     end.
      697   on choose of B-WaitFramStop in frame waitfram
      698   do:
      699     mWaitFramStop = yes.
      700     mWaitFramStopUser = yes.
      701   end.
      702   function waitfram-check-timeout returns logical():
      703      define variable vtime as int64 no-undo.
      704      if mWaitFramStopTimeOut
      705      then
      706         return yes.
      707      vtime = ( now - mWaitFramStartProc ) / 1000 .
      708      if     mWaitFramTimeOut ne ?
      709         and mWaitFramTimeOut ne 0
      710         and mWaitFramTimeOut lt vtime
      711      then do:
      712         mWaitFramStopTimeOut = yes.
      713      end.
      714      return mWaitFramStopTimeOut.
      715   end.
      716   procedure waitfram-hide :
      717     if not session:batch-mode
      718     then do
      719     on error undo, return error return-value
      720     :
      721       pause 0 before-hide .
      722       if not mBatchMode then
      723         hide frame waitfram .
      724     if     not mWaitFramView
      725        and mWaitProcEvent
      726     then
      727       process events .
      728     end.
      729   end procedure.
      730   procedure waitfram-show :
      731     define input  parameter p-message as character no-undo .
      732     define variable v-left-margin as integer   no-undo .
      733     if not session:batch-mode
      734     then do
      735     on error undo, return error return-value
      736     :
      737       if length(p-message) <= 70 then do:
      738         assign
      739           v-left-margin = integer((70 - length(p-message)) / 2)
      740         .
      741         assign
      742           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      743         .
      744         assign
      745           v-waitfram-action01 = " "
      746           v-waitfram-action02 = " "
      747                                    + fill(" ", v-left-margin)
      748                                    + p-message
      749           v-waitfram-action03 = " "
      750         .
      751       end.
      752       else do:
      753         define variable vRindex1 as integer no-undo.
      754         define variable vRindex2 as integer no-undo.
      755         vRindex1 = r-index(p-message," ",70).
      756         if vRindex1 = 0
      757         then
      758            vRindex1 = 70.
      759         if length(p-message)  <= vRindex1 + 70 then do:
      760           assign
      761             v-waitfram-action01 = " "
      762             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      763             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      764           .
      765         end.
      766         else do:
      767           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      768           if vRindex2 <= vRindex1
      769           then
      770              vRindex2 = vRindex1 + 70.
      771           assign
      772             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      773             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      774             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      775           .
      776         end.
      777       end.
      778       B-viewProcInfo:visible   in frame waitfram = no.
      779       B-viewProcInfo:sensitive in frame waitfram = no.
      780       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      781       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      782       if  (   mWaitFramView
      783          or  mWaitProcEvent)
      784          and not mBatchMode
      785       then
      786          display
      787             v-waitfram-action01 skip
      788             v-waitfram-action02 skip
      789             v-waitfram-action03 skip
      790          with frame waitfram .
      791       if     mWaitFramView
      792          then do:
      793             if     mWaitFramInterval ne ?
      794                and not mBatchMode
      795             then
      796                wait-for go of frame waitfram pause mWaitFramInterval.
      797          end.
      798          else
      799             if     mWaitProcEvent
      800                and not mBatchMode
      801             then
      802                process events .
      803     end.
      804   end procedure.
      805      procedure waitfram-show-this:
      806         define input  parameter iInterval as int64 no-undo.
      807         define variable vtime as int64 no-undo.
      808         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      809         mWaitFramInterval = iInterval.
      810         run waitfram-show (substitute("&1&2 &3&4" ,
      811                                       mWaitFramTextBeg ,
      812                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      813                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      814                                       mWaitFramTextEnd
      815                                      )
      816                           ).
      817      end.
      818      procedure WaitFramRunPause:
      819         define input  parameter iInterval as dec no-undo.
      820         define variable vStart  as datetime-tz no-undo.
      821         define variable vend    as datetime-tz no-undo.
      822         define variable vint as int64 no-undo.
      823         define variable vOk as logical no-undo.
      824         vStart = now.
      825         vend   = vStart.
      826         publish "WaitFramPause" (iInterval,output vOk).
      827         vend   =  now.
      828         vint = vend - vStart.
      829         vint = iInterval - vint / 1000.
      830         if     not mWaitFramStop
      831            and (   vint > 0
      832                 or (    not vOk
      833                     and iInterval eq ?
      834                     )
      835                 )
      836         then
      837            run waitfram-show-this (iInterval).
      838         vend   =  now.
      839         vint = vend - vStart.
      840         vint = iInterval - vint / 1000.
      841         if     not mWaitFramStop
      842            and vint > 0
      843         then do:
      844            run gbl/pause.p (vint * 1000).
      845         end.
      846         if iInterval ne ?
      847         then
      848            publish "WaitFramStop".
      849         waitfram-check-timeout().
      850      end.
      851      procedure WaitFramWaitFor:
      852         define input  parameter iInterval as dec no-undo.
      853         assign
      854            mWaitFramStartProc   = now
      855            mWaitFramStopUser    = no
      856            mWaitFramStopTimeOut = no
      857         .
      858         block-wait:
      859         do while not mWaitFramStop:
      860            run WaitFramRunPause (iInterval).
      861            if  waitfram-check-timeout()
      862            then do:
      863               leave block-wait.
      864            end.
      865         end.
      866         run waitfram-hide.
      867      end.
      868   procedure waitfram-join :
      869     define input  parameter p-line-1  as character no-undo .
      870     define input  parameter p-line-2  as character no-undo .
      871     define input  parameter p-line-3  as character no-undo .
      872     define output parameter p-message as character no-undo .
      873     do
      874     on error undo, return error return-value
      875     :
      876       assign
      877         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      878                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      879                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      880       .
      881     end.
      882   end procedure.
      883   function waitfram-join-function returns character
      884     (input p-line-1 as character
      885     ,input p-line-2 as character
      886     ,input p-line-3 as character
      887     ).
      888     define variable v-message as character no-undo .
      889     run waitfram-join in this-procedure
      890       (input  p-line-1
      891       ,input  p-line-2
      892       ,input  p-line-3
      893       ,output v-message
      894       ) .
      895     return v-message .
      896   end function .
      897   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   procedure cur-time :
      899      define output parameter p-today as date      no-undo .
      900      define output parameter p-time  as integer   no-undo .
      901     do
      902     on error undo, return error
      903     :
      904       define variable v-date1 as date      no-undo .
      905       define variable v-date2 as date      no-undo .
      906       define variable v-time  as integer   no-undo .
      907       assign
      908         v-date1 = today
      909         v-time  = time
      910         v-date2 = today
      911       .
      912       if v-date1 <> v-date2
      913       then do:
      914         assign
      915           v-date1 = today
      916           v-time  = v-time
      917         .
      918       end.
      919       assign
      920         p-today = v-date1
      921         p-time  = v-time
      922       .
      923     end.
      924   end.
      925   function cur-time-date returns character
      926   :
      927     return string(today, '99/99/9999':U) .
      928   end.
      929   function cur-time-mjd returns decimal
      930   :
      931     define variable v-date as date      no-undo .
      932     define variable v-time as integer   no-undo .
      933     run cur-time in this-procedure
      934       (output v-date
      935       ,output v-time
      936       ) .
      937     return integer(v-date) - 2400002 + (v-time / 86400) .
      938   end.
      939   function cur-time-get-ending-index returns integer
      940   (input p-number as integer
      941   )
      942   :
      943     if p-number < 0
      944     or p-number = ?
      945     then do:
      946       return 1 .
      947     end.
      948     define variable v-rest as integer   no-undo .
      949     assign
      950       p-number = p-number modulo 100
      951     .
      952     if p-number < 20
      953     then do:
      954       assign
      955         v-rest = p-number
      956       .
      957     end.
      958     else do:
      959       assign
      960         v-rest = p-number modulo 10
      961       .
      962     end.
      963     case v-rest :
      964       when 1
      965       then do:
      966         return 2 .
      967       end.
      968       when 2 or
      969       when 3 or
      970       when 4
      971       then do:
      972         return 3 .
      973       end.
      974       otherwise do:
      975         return 1 .
      976       end.
      977     end case .
      978   end.
      979   procedure cur-time-mjd-to-date :
      980      define input  parameter i-mjd-diff as decimal no-undo.
      981      define output parameter o-Date     as date    no-undo.
      982      define output parameter o-Time     as integer no-undo.
      983      define variable v-day-number as integer   no-undo .
      984      if    i-mjd-diff < 0
      985         or i-mjd-diff = ?
      986      then do:
      987         return "?" .
      988      end.
      989      assign
      990         v-day-number = truncate(i-mjd-diff,0).
      991         o-Date = date(v-day-number + 2400002).
      992         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      993     .
      994   end.
      995   function cur-time-mjd-to-string returns character
      996   (input p-mjd-diff as decimal
      997   )
      998   :
      999     define variable v-day-number as integer   no-undo .
     1000     define variable v-seconds    as integer   no-undo .
     1001     define variable v-hour       as integer   no-undo .
     1002     define variable v-min        as integer   no-undo .
     1003     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1004     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1005     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1006     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1007     if p-mjd-diff < 0
     1008     or p-mjd-diff = ?
     1009     then do:
     1010       return "?" .
     1011     end.
     1012     assign
     1013       v-day-number = integer(truncate(p-mjd-diff,0))
     1014       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1015     .
     1016     if v-seconds > 86400
     1017     then do:
     1018       assign
     1019         v-seconds = 86400 - 1
     1020       .
     1021     end.
     1022     if v-seconds < 0
     1023     then do:
     1024       assign
     1025         v-seconds = 0
     1026       .
     1027     end.
     1028     assign
     1029       v-hour = truncate(v-seconds / 3600, 0)
     1030     .
     1031     assign
     1032       v-seconds = v-seconds modulo 3600
     1033     .
     1034     assign
     1035       v-min = truncate(v-seconds / 60, 0)
     1036     .
     1037     assign
     1038       v-seconds = v-seconds modulo 60
     1039     .
     1040     return
     1041         (if v-day-number <> 0
     1042           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1043           else ""
     1044         )
     1045       + (if v-day-number <> 0 or v-hour <> 0
     1046           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1047           else ""
     1048         )
     1049       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1050           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1051           else ""
     1052         )
     1053       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1054       .
     1055   end.
     1056   function cur-time-string returns character
     1057   :
     1058     define variable v-date as date      no-undo .
     1059     define variable v-time as integer   no-undo .
     1060     run cur-time in this-procedure
     1061       (output v-date
     1062       ,output v-time
     1063       ) .
     1064     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1065   end.
     1066   function cur-time-string-sec returns character
     1067   :
     1068     define variable v-date as date      no-undo .
     1069     define variable v-time as integer   no-undo .
     1070     run cur-time in this-procedure
     1071       (output v-date
     1072       ,output v-time
     1073       ) .
     1074     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1075   end.
     1076   function cur-time-custom  returns character
     1077   (input p-prefix as character
     1078   ,input p-date-format as character
     1079   ,input p-delimiter as character
     1080   ,input p-time-format as character
     1081   ,input p-suffix as character
     1082   )
     1083   :
     1084     define variable v-date as date      no-undo .
     1085     define variable v-time as integer   no-undo .
     1086     run cur-time in this-procedure
     1087       (output v-date
     1088       ,output v-time
     1089       ) .
     1090     return
     1091       p-prefix
     1092       + string(v-date, p-date-format)
     1093       + p-delimiter
     1094       + string(v-time, p-time-format)
     1095       + p-suffix
     1096       .
     1097   end.
     1098   function cur-time-print  returns character
     1099   :
     1100     define variable v-date as date      no-undo .
     1101     define variable v-time as integer   no-undo .
     1102     run cur-time in this-procedure
     1103       (output v-date
     1104       ,output v-time
     1105       ) .
     1106     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1107   end.
     1108   function cur-time-datetime returns datetime
     1109   :
     1110     define variable v-char as character no-undo .
     1111     define variable v-datetime as datetime no-undo .
     1112     v-char = cur-time-string().
     1113     v-datetime = datetime(v-char).
     1114     return  v-datetime.
     1115   end.
     1116   function cur-time-string-msec returns character
     1117   :
