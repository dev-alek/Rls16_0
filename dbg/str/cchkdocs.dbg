        1   DEFINE TEMP-TABLE find_c-chk-doc NO-UNDO LIKE c-chk-doc.
        2   DEFINE BUFFER X_c-chk-doc FOR c-chk-doc.
        3   DEFINE BUFFER X_chk-doc FOR chk-doc.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter bttns  as char   no-undo .
        6   define input parameter p-mode  as char   no-undo .
        7   define input parameter p-doc-code like ub.chk-doc.doc-code no-undo .
        8   define input parameter p-obj-type like ub.chk-doc.obj-type no-undo.
        9   define input parameter p-obj-code like ub.chk-doc.obj-code no-undo.
       10   define input-output param p-rid-list    as  char no-undo .
       11   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision: eb58aa57459c, 2002, rls $":U.
       12   define variable vss-author      AS CHAR NO-UNDO INIT "$Author: EShklyar $":U.
       13   define variable vss-date        AS CHAR NO-UNDO INIT "$Date: Wed Sep 18 21:01:08 2019 +0300 $":U.
