        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-rid-list as character no-undo .
        6   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        7   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: rkepsyng.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/rkepsyng.p $":U .
       13   define variable vss-description as character no-undo init "Синхронизация названий групп блюд в IBS TH с названиями групп блюд на кассе R-keeper".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "X(65)" no-undo
       84   initial "@(#)$Workfile$ $Revision$".
       85   define temp-table temp_fbrglib_grp no-undo
       86       field sel           as character
       87       field full-name     as character
       88       field out-code      as integer
       89       field sort-name     as character
       90       field node-code     as integer
       91       field upper-code    as integer
       92       field name          as character
       93       field level         as integer
       94       field mark          as character
       95       field obj-type      as character
       96       field obj-code      as integer
       97       field global-code   as integer
       98       index pi is primary unique obj-type obj-code sort-name
       99       index fn obj-type obj-code full-name
      100       index nc is unique obj-type obj-code node-code
      101       index sl obj-type obj-code sel
      102       index uc obj-type obj-code upper-code
      103   .
      104   define temp-table temp_fbrglib_found-grp no-undo
      105       field full-name   as character
      106       field sort-name   as character
      107       field node-code   as integer
      108       field level       as integer
      109       field is-terminal as logical
      110       field obj-type      as character
      111       field obj-code      as integer
      112       index pi is primary unique obj-type obj-code sort-name
      113       index fn obj-type obj-code full-name
      114       index lv obj-type obj-code level
      115       index it obj-type obj-code is-terminal
      116   .
      117   define temp-table temp_found-result-nodelist no-undo
      118       field node-code     as integer
      119       field processed     as logical
      120       field sort-name     as character
      121       field full-name     as character
      122       index pi is primary unique node-code
      123       index ps processed
      124   .
      125   procedure fbrglib-get-sort-name :
      126   do
      127   on error undo, return error
      128   :
      129   define input parameter p-obj-type   as character    no-undo.
      130   define input parameter p-obj-code   as integer      no-undo.
      131   define input parameter p-node-code  as integer      no-undo.
      132   define output parameter p-sort-name as character    no-undo.
      133       define variable v-upper-code    as integer           no-undo.
      134       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      135       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      136       find first buf_fbr-gds-grp no-lock
      137            where buf_fbr-gds-grp.obj-type  = p-obj-type
      138              and buf_fbr-gds-grp.obj-code  = p-obj-code
      139              and buf_fbr-gds-grp.node-code = p-node-code
      140       no-error.
      141       if not available buf_fbr-gds-grp
      142       then do:
      143           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      144       end.
      145       assign
      146           p-sort-name  = ""
      147           v-upper-code = 1
      148       .
      149       do while true
      150       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
      151       :
      152           assign
      153               p-sort-name  = buf_fbr-gds-grp.node-name
      154                            + (if p-sort-name <> "" then chr(2) else "")
      155                            + p-sort-name
      156               v-upper-code = buf_fbr-gds-grp.upper-code
      157           .
      158           if buf_fbr-gds-grp.upper-code = 1
      159           then do:
      160               leave.
      161           end.
      162           find first buf_fbr-gds-grp no-lock
      163                where buf_fbr-gds-grp.obj-type  = p-obj-type
      164                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      165                  and buf_fbr-gds-grp.node-code = v-upper-code
      166           no-error.
      167           if not available buf_fbr-gds-grp
      168           then do:
      169               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
      170                                   + string( v-upper-code )
      171                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      172           end.
      173       end.
      174   end.
      175   end procedure.
      176   procedure fbrglib-get-full-name :
      177   do
      178   on error undo, return error
      179   :
      180   define input parameter p-obj-type   as character    no-undo.
      181   define input parameter p-obj-code   as integer      no-undo.
      182   define input parameter p-node-code  as integer      no-undo.
      183   define output parameter p-full-name as character    no-undo.
      184       define variable v-upper-code    as integer           no-undo.
      185       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      186       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      187       if p-node-code = 1
      188       then do:
      189           assign
      190               p-full-name = ""
      191           .
      192       end.
      193       else do:
      194           find first buf_fbr-gds-grp no-lock
      195                where buf_fbr-gds-grp.obj-type  = p-obj-type
      196                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      197                  and buf_fbr-gds-grp.node-code = p-node-code
      198           no-error.
      199           if not available buf_fbr-gds-grp
      200           then do:
      201               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      202           end.
      203           assign
      204               p-full-name  = ""
      205               v-upper-code = 1
      206           .
      207           do while true
      208           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
      209           :
      210               assign
      211                   p-full-name  = buf_fbr-gds-grp.node-name
      212                               + (if p-full-name <> "" then chr(47) else "")
      213                               + p-full-name
      214                   v-upper-code = buf_fbr-gds-grp.upper-code
      215               .
      216               if buf_fbr-gds-grp.upper-code = 1
      217               then do:
      218                   leave.
      219               end.
      220               find first buf_fbr-gds-grp no-lock
      221                    where buf_fbr-gds-grp.obj-type  = p-obj-type
      222                      and buf_fbr-gds-grp.obj-code  = p-obj-code
      223                      and buf_fbr-gds-grp.node-code = v-upper-code
      224               no-error.
      225               if not available buf_fbr-gds-grp
      226               then do:
      227                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
      228                                       + string( v-upper-code )
      229                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      230               end.
      231           end.
      232           assign
      233               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      234           .
      235       end.
      236   end.
      237   end procedure.
      238   procedure fbrglib-get-root-code :
      239   do
      240   on error undo, return error
      241   :
      242   define output parameter p-root-code as integer      no-undo.
      243       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      244       find first buf_fbr-gds-grp no-lock
      245            where buf_fbr-gds-grp.upper-code = 0
      246       no-error .
      247       if not available buf_fbr-gds-grp
      248       then do:
      249           undo, return error .
      250       end.
      251       else do:
      252           assign
      253               p-root-code = buf_fbr-gds-grp.node-code
      254           .
      255       end.
      256   end.
      257   end procedure.
      258   procedure fbrglib-find-grp-by-full-name :
      259   do
      260   on error undo, return error
      261   :
      262   define input parameter p-obj-type     as character    no-undo.
      263   define input parameter p-obj-code     as integer      no-undo.
      264   define input parameter p-search-name  as character    no-undo.
      265   define input parameter p-fill-path    as logical      no-undo.
      266       define variable v-upper-code    as integer          no-undo.
      267       define variable v-not-found     as logical init yes no-undo.
      268       define variable v-counter       as integer           no-undo.
      269       define variable v-level         as integer           no-undo.
      270       define variable v-full-name     as character         no-undo.
      271       define variable v-sort-name     as character         no-undo.
      272       define variable v-node-name     as character      no-undo.
      273       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      274       assign
      275           p-search-name = replace( p-search-name, chr(47), chr(2) )
      276       .
      277       run fbrglib-get-root-code ( output v-upper-code ) no-error .
      278       if error-status :error
      279       then do:
      280           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
      281       end.
      282       assign
      283           v-full-name  = ""
      284           v-level      = num-entries( p-search-name, chr(2) )
      285       .
      286       for each temp_fbrglib_found-grp
      287       :
      288           delete temp_fbrglib_found-grp.
      289       end.
      290       start-name-analyze:
      291       do v-counter = 1 to v-level
      292       :
      293           if v-counter < v-level
      294           then do:
      295               assign
      296                   v-node-name = entry( v-counter, p-search-name, chr(2) )
      297               .
      298               find first buf_fbr-gds-grp no-lock
      299                    where buf_fbr-gds-grp.obj-type   = p-obj-type
      300                      and buf_fbr-gds-grp.obj-code   = p-obj-code
      301                      and buf_fbr-gds-grp.upper-code = v-upper-code
      302                      and buf_fbr-gds-grp.node-name  = v-node-name
      303               no-error .
      304               if not available buf_fbr-gds-grp
      305               then do:
      306                   assign
      307                       v-full-name  = p-search-name
      308                       v-sort-name  = p-search-name
      309                   .
      310                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
      311               end.
      312               else do:
      313                   assign
      314                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
      315                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
      316                       v-upper-code = buf_fbr-gds-grp.node-code
      317                   .
      318                   if p-fill-path = yes
      319                   then do:
      320                       create temp_fbrglib_found-grp.
      321                       assign
      322                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
      323                           temp_fbrglib_found-grp.sort-name = v-sort-name
      324                           temp_fbrglib_found-grp.node-code = v-upper-code
      325                           temp_fbrglib_found-grp.level     = v-counter
      326                           temp_fbrglib_found-grp.obj-type  = p-obj-type
      327                           temp_fbrglib_found-grp.obj-code  = p-obj-code
      328                       .
      329                   end.
      330               end.
      331           end.
      332           else do:
      333               for each buf_fbr-gds-grp no-lock
      334                  where buf_fbr-gds-grp.obj-type   = p-obj-type
      335                    and buf_fbr-gds-grp.obj-code   = p-obj-code
      336                    and buf_fbr-gds-grp.upper-code = v-upper-code
      337                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      338               :
      339                   assign
      340                       v-not-found = no
      341                   .
      342                   create temp_fbrglib_found-grp.
      343                   assign
      344                       temp_fbrglib_found-grp.full-name = v-full-name
      345                                                           + (if v-full-name = "" then "" else chr(47) )
      346                                                           + buf_fbr-gds-grp.node-name + chr(47)
      347                       temp_fbrglib_found-grp.sort-name = v-sort-name
      348                                                           + ( if v-sort-name = "" then "" else chr(2) )
      349                                                           + buf_fbr-gds-grp.node-name
      350                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
      351                       temp_fbrglib_found-grp.level     = v-level
      352                       temp_fbrglib_found-grp.obj-type  = p-obj-type
      353                       temp_fbrglib_found-grp.obj-code  = p-obj-code
      354                   .
      355               end.
      356               if v-not-found = yes
      357               then do:
      358                   assign
      359                       v-full-name  = p-search-name
      360                       v-sort-name  = p-search-name
      361                   .
      362                   for each temp_fbrglib_found-grp
      363                   :
      364                       delete temp_fbrglib_found-grp.
      365                   end.
      366                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      367               end.
      368           end.
      369       end.
      370   end.
      371   end procedure.
      372   procedure fbrglib-find-all-subgroup :
      373   do
      374   on error undo, return error
      375   :
      376   define input parameter p-start-obj-type     as character    no-undo.
      377   define input parameter p-start-obj-code     as integer      no-undo.
      378   define input parameter p-start-node-code    as integer      no-undo.
      379   define input parameter p-terminal-only      as logical      no-undo.
      380       define variable v-start-full-name   as character     no-undo.
      381       define variable v-start-sort-name   as character     no-undo.
      382       define variable v-not-found         as logical       no-undo.
      383       define variable v-is-terminal       as logical       no-undo.
      384       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      385       create temp_found-result-nodelist.
      386       assign
      387           temp_found-result-nodelist.node-code = p-start-node-code
      388           temp_found-result-nodelist.processed = no
      389       .
      390       run fbrglib-get-full-name in this-procedure (
      391             input p-start-obj-type
      392           , input p-start-obj-code
      393           , input p-start-node-code
      394           , output v-start-full-name
      395       ).
      396       run fbrglib-get-full-name in this-procedure (
      397             input p-start-obj-type
      398           , input p-start-obj-code
      399           , input p-start-node-code
      400           , output v-start-sort-name
      401       ).
      402       process-nodes:
      403       do while yes
      404       :
      405           find first temp_found-result-nodelist
      406                where temp_found-result-nodelist.node-code = p-start-node-code
      407           .
      408           assign
      409               temp_found-result-nodelist.processed = yes
      410           .
      411           for each buf_fbr-gds-grp no-lock
      412              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
      413                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
      414                and buf_fbr-gds-grp.upper-code = p-start-node-code
      415           on error undo, return error
      416           :
      417               run fbrglib-is-terminal in this-procedure (
      418                     input buf_fbr-gds-grp.obj-type
      419                   , input buf_fbr-gds-grp.obj-code
      420                   , input buf_fbr-gds-grp.node-code
      421                   , output v-is-terminal
      422               ).
      423               if v-is-terminal = yes
      424               then do:
      425                   create temp_fbrglib_found-grp.
      426                   assign
      427                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      428                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      429                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      430                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      431                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      432                       temp_fbrglib_found-grp.is-terminal = yes
      433                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      434                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      435                   .
      436               end.
      437               else do:
      438                   create temp_found-result-nodelist.
      439                   assign
      440                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
      441                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      442                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      443                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      444                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      445                       temp_found-result-nodelist.processed = no
      446                   .
      447                   if p-terminal-only = no
      448                   then do:
      449                       create temp_fbrglib_found-grp.
      450                       assign
      451                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      452                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      453                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      454                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      455                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      456                           temp_fbrglib_found-grp.is-terminal = no
      457                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      458                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      459                       .
      460                   end.
      461               end.
      462           end.
      463           find first temp_found-result-nodelist
      464                where temp_found-result-nodelist.processed = no
      465           no-error.
      466           if not available temp_found-result-nodelist
      467           then do:
      468               leave process-nodes.
      469           end.
      470           else do:
      471               assign
      472                   p-start-node-code = temp_found-result-nodelist.node-code
      473                   v-start-full-name = temp_found-result-nodelist.full-name
      474                   v-start-sort-name = temp_found-result-nodelist.sort-name
      475               .
      476           end.
      477       end.
      478   end.
      479   end procedure.
      480   procedure fbrglib-expand-name :
      481   do
      482   on error undo, return error
      483   :
      484   define input parameter p-obj-type   as character    no-undo.
      485   define input parameter p-obj-code   as integer      no-undo.
      486   define input parameter p-start-name as character    no-undo.
      487   define output parameter p-end-name  as character    no-undo.
      488       define variable v-is-terminal     as logical           no-undo.
      489       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
      490       run fbrglib-find-grp-by-full-name in this-procedure (
      491             input p-obj-type
      492           , input p-obj-code
      493           , input p-start-name
      494           , input no
      495       ) no-error.
      496       run fbrglib-get-max-substring in this-procedure (
      497              input p-obj-type
      498           ,  input p-obj-code
      499           ,  input length( p-start-name )
      500           , output p-end-name
      501       ) no-error .
      502       if error-status :error
      503       then do:
      504           assign
      505               p-end-name = ""
      506           .
      507       end.
      508       else do:
      509           find first temp_fbrglib_found-grp
      510                where temp_fbrglib_found-grp.full-name = p-end-name
      511                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      512                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      513                        no-error.
      514           if available temp_fbrglib_found-grp
      515           then do:
      516               find first buf_temp_fbrglib_found-grp
      517                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
      518                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
      519                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      520                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      521               no-error.
      522               if not available buf_temp_fbrglib_found-grp
      523               then do:
      524                   run fbrglib-is-terminal in this-procedure (
      525                         input p-obj-type
      526                       , input p-obj-code
      527                       , input temp_fbrglib_found-grp.node-code
      528                       , output v-is-terminal
      529                   ).
      530               end.
      531           end.
      532       end.
      533   end.
      534   end procedure.
      535   procedure fbrglib-get-max-substring :
      536   do
      537   on error undo, return error
      538   :
      539   define input parameter p-obj-type as character no-undo .
      540   define input parameter p-obj-code as integer no-undo .
      541   define input parameter p-min-substring-length   as integer      no-undo.
      542   define output parameter p-substring             as character    no-undo.
      543           define variable v-char-counter  as integer           no-undo.
      544           define variable v-current-char  as character         no-undo.
      545           define variable v-names-counter  as integer           no-undo.
      546           define variable v-base-string   as character         no-undo.
      547           assign
      548               v-char-counter  = p-min-substring-length
      549           .
      550           find first temp_fbrglib_found-grp  where
      551                      temp_fbrglib_found-grp.obj-type  = p-obj-type
      552                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      553           no-error.
      554           if not available temp_fbrglib_found-grp
      555           then do:
      556               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
      557           end.
      558           else do:
      559               assign
      560                   v-base-string = temp_fbrglib_found-grp.full-name
      561               .
      562               counter-block:
      563               do while yes
      564               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
      565               :
      566                   assign
      567                       v-char-counter  = v-char-counter + 1
      568                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      569                       v-names-counter = 0
      570                   .
      571                   compare-block:
      572                   for each temp_fbrglib_found-grp
      573                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
      574                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      575                   :
      576                       assign
      577                           v-names-counter = v-names-counter + 1
      578                       .
      579                       if v-names-counter = 1
      580                       then do:
      581                           next compare-block.
      582                       end.
      583                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      584                       then do:
      585                           leave counter-block.
      586                       end.
      587                   end.
      588                   if v-names-counter = 1
      589                   then do:
      590                       assign
      591                           p-substring = v-base-string
      592                       .
      593                       return.
      594                   end.
      595               end.
      596               assign
      597                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      598               .
      599           end.
      600   end.
      601   end procedure.
      602   procedure fbrglib-is-terminal :
      603   do
      604   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
      605   :
      606   define input parameter p-obj-type       as character    no-undo.
      607   define input parameter p-obj-code       as integer      no-undo.
      608   define input parameter p-node-code      as integer      no-undo.
      609   define output parameter p-is-terminal   as logical      no-undo.
      610       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      611       find first buf_fbr-gds-grp no-lock
      612            where buf_fbr-gds-grp.obj-type   = p-obj-type
      613              and buf_fbr-gds-grp.obj-code   = p-obj-code
      614              and buf_fbr-gds-grp.upper-code = p-node-code
      615       no-error .
      616       if not available buf_fbr-gds-grp
      617       then do:
      618           assign
      619               p-is-terminal = yes
      620           .
      621       end.
      622       else do:
      623           assign
      624               p-is-terminal = no
      625           .
      626       end.
      627   end.
      628   end procedure.
      629   procedure fbrglib-have-goods :
      630   do
      631   on error undo, return error
      632   :
      633   define input parameter p-obj-type           as character    no-undo.
      634   define input parameter p-obj-code           as integer      no-undo.
      635   define input parameter p-node-code          as integer      no-undo.
      636   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
      637       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
      638       find first buf_fbr-gds-obj no-lock
      639            where buf_fbr-gds-obj.obj-type     = p-obj-type
      640              and buf_fbr-gds-obj.obj-code     = p-obj-code
      641              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      642       no-error .
      643       if available buf_fbr-gds-obj
      644       then do:
      645           assign
      646               p-have-fbr-gds-obj = yes
      647           .
      648       end.
      649       else do:
      650           assign
      651               p-have-fbr-gds-obj = no
      652           .
      653       end.
      654   end.
      655   end procedure.
      656   procedure fbrglib-find-by-substring :
      657   do
      658   on error undo, return error
      659   :
      660   define input parameter p-start-obj-type     as character    no-undo.
      661   define input parameter p-start-obj-code     as integer      no-undo.
      662   define input parameter p-start-code         as integer      no-undo.
      663   define input parameter p-full-search-string as character    no-undo.
      664   define output parameter p-found-code        as integer      no-undo.
      665   define output parameter p-full-name         as character    no-undo.
      666       define variable v-start-code     as integer           no-undo.
      667       define variable v-found          as logical  init no  no-undo.
      668       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      669       search-grp:
      670       for each buf_fbr-gds-grp no-lock
      671           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
      672             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
      673             and buf_fbr-gds-grp.node-code > p-start-code
      674       :
      675           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
      676           then do:
      677               assign
      678                   p-found-code = buf_fbr-gds-grp.node-code
      679                   v-found      = yes
      680               .
      681               run fbrglib-get-full-name in this-procedure (
      682                     input p-start-obj-type
      683                   , input p-start-obj-code
      684                   , input p-found-code
      685                   , output p-full-name
      686               ) no-error .
      687               if error-status :error
      688               then do:
      689                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      690               end.
      691               leave search-grp.
      692           end.
      693       end.
      694       if v-found = yes
      695       then do:
      696       end.
      697       else do:
      698           assign
      699               p-full-name  = ""
      700               p-found-code = 0
      701           .
      702       end.
      703   end.
      704   end procedure.
      705   procedure fbrglib-analyze-grp-name :
      706   do
      707   on error undo, return error
      708   :
      709   define input parameter p-grp-name       as character            no-undo.
      710   define input parameter p-obj-type       as character            no-undo.
      711   define input parameter p-obj-code       as integer              no-undo.
      712   define input parameter p-upper-code     as integer              no-undo.
      713   define output parameter p-error-message as character init ""    no-undo.
      714       define variable v-char-list     as character    no-undo.
      715       define variable v-char-counter  as integer      no-undo.
      716       define variable v-full-name     as character    no-undo.
      717       if p-grp-name = "" then do:
      718           assign
      719               p-error-message = "Название группы не может быть пустым.".
      720           .
      721       end.
      722       else do:
      723           assign
      724               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      725           .
      726           do v-char-counter = 1 to num-entries( v-char-list )
      727           :
      728               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      729               then do:
      730                   assign
      731                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      732                   .
      733                   return.
      734               end.
      735           end.
      736           run fbrglib-get-full-name in this-procedure (
      737                 input p-obj-type
      738               , input p-obj-code
      739               , input p-upper-code
      740               , output v-full-name
      741           ) no-error .
      742           if error-status :error
      743           then do:
      744               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      745           end.
      746           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
      747           then do:
      748               assign
      749                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
      750               .
      751           end.
      752       end.
      753   end.
      754   end procedure.
      755   procedure fbrglib-delete-grp :
      756   do
      757   on error undo, return error
      758   :
      759   define input parameter p-obj-type   as character    no-undo.
      760   define input parameter p-obj-code   as integer      no-undo.
      761   define input parameter p-node-code  as integer      no-undo.
      762   define output parameter p-deleted   as logical      no-undo.
      763       define variable v-have-goods    as logical        no-undo.
      764       define variable v-yesno         as logical        no-undo.
      765       define variable v-upper-code    as integer        no-undo.
      766       define variable v-root-code     as integer        no-undo.
      767       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      768       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
      769       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
      770       run fbrglib-get-root-code in this-procedure (
      771           output v-root-code
      772       ) no-error.
      773       if error-status :error
      774       then do:
      775           undo, return error "Не найден корневой узел." + chr(10) + return-value.
      776       end.
      777       if p-node-code = v-root-code
      778       then do:
      779           message
      780               "Корневую группу удалить невозможно."
      781           view-as alert-box error.
      782           assign
      783               p-deleted = no
      784           .
      785           undo, return.
      786       end.
      787       find first buf_fbr-gds-grp no-lock
      788            where buf_fbr-gds-grp.obj-type     = p-obj-type
      789              and buf_fbr-gds-grp.obj-code     = p-obj-code
      790              and buf_fbr-gds-grp.upper-code   = p-node-code
      791       no-error.
      792       if available buf_fbr-gds-grp
      793       then do:
      794           message
      795               "Не терминальную группу удалить невозможно."
      796           view-as alert-box error.
      797           assign
      798               p-deleted = no
      799           .
      800           undo, return.
      801       end.
      802       find first buf_fbr-gds-grp no-lock
      803            where buf_fbr-gds-grp.obj-type     = p-obj-type
      804              and buf_fbr-gds-grp.obj-code     = p-obj-code
      805              and buf_fbr-gds-grp.node-code    = p-node-code
      806       .
      807       assign
      808           v-upper-code = buf_fbr-gds-grp.upper-code
      809       .
      810       run fbrglib-have-goods in this-procedure (
      811             input p-obj-type
      812           , input p-obj-code
      813           , input p-node-code
      814           , output v-have-goods
      815       ).
      816       if v-have-goods = yes
      817       then do:
      818           find first buf_second_fbr-gds-grp no-lock
      819                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
      820                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
      821                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
      822                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
      823           no-error.
      824           if available buf_second_fbr-gds-grp
      825           then do:
      826               message
      827                   "В группе есть товары,"
      828                   skip "которые нельзя перенести в родительскую группу,"
      829                   skip "потому что у родительской группы есть еще одна подгруппа."
      830                   skip(1)
      831                   skip "Перенесите товары в другую группу"
      832                   skip "или удалите все остальные подгруппы родительской группы."
      833               view-as alert-box error.
      834               assign
      835                   p-deleted = no
      836               .
      837               undo, return.
      838           end.
      839           message
      840               "В группе есть товары."
      841               skip "После удаления группы"
      842               skip "все ее товары будут привязаны"
      843               skip "к ее родительской группе."
      844               skip(1)
      845               skip "Удалить группу?"
      846           view-as alert-box warning
      847           buttons yes-no
      848           title "Удаление группы"
      849           update v-yesno
      850           .
      851           if v-yesno = yes
      852           then do:
      853               do transaction
      854               on error undo, return error
      855               :
      856                   for each buf_fbr-gds-obj exclusive-lock
      857                      where buf_fbr-gds-obj.obj-type     = p-obj-type
      858                        and buf_fbr-gds-obj.obj-code     = p-obj-code
      859                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      860                   on error undo, return error
      861                   :
      862                       assign
      863                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
      864                       .
      865                   end.
      866               end.
      867               do transaction
      868               on error undo, return error
      869               :
      870                   find current buf_fbr-gds-grp exclusive-lock .
      871                   delete buf_fbr-gds-grp no-error .
      872                   if error-status:error then do:
      873                     undo, return error return-value .
      874                   end.
      875               end.
      876           end.
      877       end.
      878       else do:
      879           message
      880               "Имя группы: " buf_fbr-gds-grp.node-name
      881               "Код группы: " buf_fbr-gds-grp.node-code
      882               skip(1)
      883               skip "Удалить группу?"
      884           view-as alert-box warning
      885           buttons yes-no
      886           title "Удаление группы"
      887           update v-yesno
      888           .
      889           if v-yesno = yes
      890           then do:
      891               do transaction
      892               on error undo, return error
      893               :
      894                   find current buf_fbr-gds-grp exclusive-lock .
      895                   delete buf_fbr-gds-grp no-error.
      896                   if error-status:error then do:
      897                     undo, return error return-value .
      898                   end.
      899               end.
      900           end.
      901       end.
      902   end.
      903   end procedure.
      904   procedure fbrglib-add-grp :
      905   do
      906   on error undo, return error
      907   :
      908   define input parameter p-obj-type       as character    no-undo.
      909   define input parameter p-obj-code       as integer      no-undo.
      910   define input parameter p-node-code      as integer      no-undo.
      911   define input parameter p-interface      as logical      no-undo.
      912   define input parameter p-node-name      as character    no-undo.
      913   define input parameter p-out-code       as integer      no-undo.
      914   define input parameter p-global-code    as integer      no-undo.
      915   define output parameter p-new-node-code as integer      no-undo.
      916   define output parameter p-cancel        as logical      no-undo.
      917       define variable v-have-goods    as logical  no-undo.
      918       define variable v-host-code     as integer        no-undo.
      919       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      920       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
      921       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
      922       run fbrglib-have-goods in this-procedure (
      923             input p-obj-type
      924           , input p-obj-code
      925           , input p-node-code
      926           , output v-have-goods
      927       ) no-error .
      928       if error-status :error
      929       then do:
      930           message
      931                    vss-workfile vss-revision vss-description
      932               skip "Ошибка определения наличия товаров в группе."
      933               skip return-value
      934               skip trim(error-status :get-message(1))
      935                    trim(error-status :get-message(2))
      936                    trim(error-status :get-message(3))
      937           view-as alert-box error.
      938           undo, return error .
      939       end.
      940   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      942     (input  p-obj-type
      943     ,input  p-obj-code
      944     ,output v-host-code
      945     )  .
      946       find first buf_fbr-gds-grp no-lock where
      947                 buf_fbr-gds-grp.upper-code = p-node-code
      948             AND buf_fbr-gds-grp.obj-type   = p-obj-type
      949             AND buf_fbr-gds-grp.obj-code   = p-obj-code
      950             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
      951       if available buf_fbr-gds-grp then do:
      952           if p-node-code <> 1 then do:
      953             find first buf_fbr-gds-grp no-lock where
      954                       buf_fbr-gds-grp.node-code = p-node-code
      955                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
      956                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
      957           end.
      958                   message
      959           "Для объекта" p-obj-type p-obj-code
      960           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
      961           view-as alert-box error .
      962           undo, return error .
      963       end.
      964       do transaction
      965       on error undo, return error
      966       :
      967           create buf_fbr-gds-grp.
      968           assign
      969               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
      970               p-new-node-code             = buf_fbr-gds-grp.node-code
      971               buf_fbr-gds-grp.upper-code  = p-node-code
      972               buf_fbr-gds-grp.host-code   = v-host-code
      973               buf_fbr-gds-grp.obj-type    = p-obj-type
      974               buf_fbr-gds-grp.obj-code    = p-obj-code
      975               buf_fbr-gds-grp.node-name    = ""
      976               buf_fbr-gds-grp.out-code    = 0
      977           .
      978           if p-interface then do:
      979             run ref/fbrggrpd.w (
      980                   input parparentproc
      981                 , input 'ИЗМЕНЕНИЕ':U
      982                 , input p-obj-type
      983                 , input p-obj-code
      984                 , input buf_fbr-gds-grp.node-code
      985                 , input buf_fbr-gds-grp.upper-code
      986                 , input buf_fbr-gds-grp.node-name
      987                 , input buf_fbr-gds-grp.out-code
      988                 , output buf_fbr-gds-grp.node-name
      989                 , output buf_fbr-gds-grp.out-code
      990                 , output p-cancel
      991             ).
      992             if p-cancel = yes
      993             then do:
      994                 delete buf_fbr-gds-grp.
      995                 undo, return.
      996             end.
      997           end.
      998           else do:
      999             find first bf_fbr-gds-grp no-lock
     1000                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     1001                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     1002                   and bf_fbr-gds-grp.out-code   = p-out-code
     1003             no-error.
     1004             assign
     1005             buf_fbr-gds-grp.node-name    = p-node-name
     1006             buf_fbr-gds-grp.global-code  = p-global-code
     1007             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     1008             .
     1009           end.
     1010           if v-have-goods = yes
     1011           then do:
     1012               for each buf_fbr-gds-obj exclusive-lock
     1013                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     1014                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     1015                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     1016               on error undo, return error
     1017               :
     1018                   assign
     1019                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     1020                   .
     1021               end.
     1022           end.
     1023       end.
     1024   end.
     1025   end procedure.
     1026   define new global shared variable g#libbcrcn as handle no-undo .
     1027   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   define variable varscales-pref2 as character no-undo .
     1029   define variable varpgscales-pref2 as character no-undo .
     1030   define variable varscales-pref-type2 as character no-undo.
     1031   define variable varpgscales-pref-type2 as character no-undo.
     1032   varscales-pref2  = ?.
     1033   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1034     (input  'sclspref':u
     1035     ,input  '':u
     1036     ,input  '':u
     1037     ,input  0
     1038     ,input  '':u
     1039     ,input  '':u
     1040     ,input  '':u
     1041     ,input  no
     1042     ,output varscales-pref2
     1043     ,output varscales-pref-type2
     1044     ) no-error .
     1045     if varscales-pref2 = ? then do:
     1046       assign
     1047         varscales-pref2 = '21,23,25':U.
     1048     end.
     1049   varpgscales-pref2  = ?.
     1050   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1051     (input  'scpgpref':u
     1052     ,input  '':u
     1053     ,input  '':u
     1054     ,input  0
     1055     ,input  '':u
     1056     ,input  '':u
     1057     ,input  '':u
     1058     ,input  no
     1059     ,output varpgscales-pref2
     1060     ,output varpgscales-pref-type2
     1061     ) no-error .
     1062     if varpgscales-pref2 = ? then do:
     1063       assign
     1064         varpgscales-pref2 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     1065     end.
     1066   function get-rkgTH-price returns decimal(input p-obj-type as character
     1067                                          , input p-obj-code as integer
     1068                                          , input p-b-code as integer
     1069                                          , output p-doc-num as character):
     1070   define variable v-price-sale as decimal   no-undo init ?.
     1071   define variable v-road-tax   as decimal   no-undo .
     1072   define variable v-excise     as decimal   no-undo .
     1073   define variable v-vat-pc     as decimal   no-undo .
     1074   define variable v-slt-pc     as decimal   no-undo .
     1075   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1076   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     1077     (input  p-obj-type
     1078     ,input  p-obj-code
     1079     ,input  p-b-code
     1080     ,input  0
     1081     ,input  0
     1082     ,output p-doc-num
     1083     ,output v-price-sale
     1084     ,output v-road-tax
     1085     ,output v-excise
     1086     ,output v-vat-pc
     1087     ,output v-slt-pc
     1088     ) no-error .
     1089   if not error-status:error then return v-price-sale.
     1090   END FUNCTION.
     1091   function get-rkgTH-name returns character(input p-obj-type as character
     1092                                             ,input p-obj-code as integer
     1093                                             ,input p-b-code as integer
     1094                                             , buffer buf_goods for ub.goods):
     1095   define variable v-gds-name as character no-undo .
     1096   define VARIABLE varresult   as character                no-undo.
     1097   define VARIABLE vartype-bc  as character                no-undo.
     1098   define VARIABLE varweight   as decimal                  no-undo.
     1099   DEFINE VARIABLE v-unit-cli AS CHARACTER NO-UNDO.
     1100   DEFINE VARIABLE v-f-name AS CHARACTER NO-UNDO.
     1101   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
     1102   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     1103   DEFINE BUFFER buf_place FOR ub.place.
     1104   DEFINE BUFFER buf_gds-prt FOR ub.gds-prt.
     1105   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1106   (
     1107    input  parparentproc
     1108   ,input  STRING(p-b-code)
     1109   ,input  0
     1110   ,input  p-obj-type
     1111   ,input  p-obj-code
     1112   ,input  NO
     1113   ,input  YES
     1114   ,input  varscales-pref2
     1115   ,input  varpgscales-pref2
     1116   ,output varresult
     1117   ,output vartype-bc
     1118   ,output varweight
     1119   ,buffer buf_bar-code
     1120   ,buffer buf_prod-bc
     1121   ,buffer buf_place
     1122   ) no-error.
     1123   if not available buf_bar-code then
     1124   return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
     1125   FIND FIRST buf_goods NO-LOCK WHERE
     1126             buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
     1127   IF NOT AVAILABLE buf_goods THEN DO:
     1128     return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
     1129   END.
     1130   else do:
     1131     assign
     1132     v-gds-name = buf_goods.chk-name
     1133     .
     1134   end.
     1135   IF buf_bar-code.unit-cli <> buf_goods.unit-base THEN DO:
     1136     ASSIGN
     1137     v-unit-cli = "*" + string(buf_bar-code.cli-base-rate).
     1138   END.
     1139   FIND FIRST buf_gds-prt NO-LOCK WHERE
     1140             buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     1141   if buf_gds-prt.node-name <>  '_Пустая шкала':U THEN DO:
     1142       FIND FIRST buf_gds-prt NO-LOCK WHERE
     1143                 buf_gds-prt.node-code = buf_bar-code.node-code NO-ERROR.
     1144   END.
     1145   ASSIGN
     1146   v-f-name = (IF AVAILABLE buf_gds-prt THEN buf_gds-prt.f-name ELSE "":U).
     1147   ASSIGN
     1148   v-gds-name = v-gds-name + chr(32) + v-f-name + v-unit-cli.
     1149   return v-gds-name.
     1150   END FUNCTION.
     1151   function get-rkgTH-group returns integer(input p-obj-type as character
     1152                                           , input p-obj-code  as integer
     1153                                           , input p-gds-code as integer
     1154                                           , output p-grp-name as character
     1155                                           ):
     1156   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
     1157   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1158   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
     1159           buf_fbr-gds-obj.obj-type = p-obj-type
     1160       AND buf_fbr-gds-obj.obj-code = p-obj-code
     1161       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
     1162   IF AVAILABLE buf_fbr-gds-obj THEN DO:
     1163     RUN fbrglib-get-full-name IN THIS-PROCEDURE(
     1164                                                 input p-obj-type
     1165                                                 ,INPUT p-obj-code
     1166                                                 ,INPUT buf_fbr-gds-obj.fbr-grp-code
     1167                                                 ,OUTPUT p-grp-name) NO-ERROR.
     1168     return buf_fbr-gds-obj.fbr-grp-code.
     1169   END.
     1170   return ?.
     1171   END FUNCTION.
     1172   function get-rkgTH-modificator returns logical(input p-obj-type as character
     1173                                           , input p-obj-code  as integer
     1174                                           , input p-gds-code as integer
     1175                                           , output p-is-null-price as logical
     1176                                           ):
     1177   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
     1178   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
     1179           buf_fbr-gds-obj.obj-type = p-obj-type
     1180       AND buf_fbr-gds-obj.obj-code = p-obj-code
     1181       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
     1182   IF AVAILABLE buf_fbr-gds-obj THEN DO:
     1183     assign
     1184     p-is-null-price = buf_fbr-gds-obj.is-null-price
     1185     .
     1186     return buf_fbr-gds-obj.is-modificator.
     1187   END.
     1188   assign
     1189   p-is-null-price = no.
     1190   return no.
     1191   END FUNCTION.
     1192   function get-rkgTH-group-name returns character(input p-obj-type as character
     1193                                                 , input p-obj-code  as integer
     1194                                                 , input p-out-code as integer):
     1195   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1196   find first buf_fbr-gds-grp no-lock where
     1197             buf_fbr-gds-grp.obj-type = p-obj-type
     1198         AND buf_fbr-gds-grp.obj-code = p-obj-code
     1199         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     1200   if not available buf_fbr-gds-grp then return ?.
     1201   return buf_fbr-gds-grp.node-name.
     1202   END FUNCTION.
     1203   function get-rkgTH-parent returns integer(input p-obj-type as character
     1204                                             , input p-obj-code  as integer
     1205                                             , input p-out-code as integer):
     1206   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     1207   DEFINE BUFFER upper_fbr-gds-grp FOR ub.fbr-gds-grp.
     1208   find first buf_fbr-gds-grp no-lock where
     1209             buf_fbr-gds-grp.obj-type = p-obj-type
     1210         AND buf_fbr-gds-grp.obj-code = p-obj-code
     1211         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     1212   if not available buf_fbr-gds-grp then return ?.
     1213   find first upper_fbr-gds-grp no-lock where
     1214             upper_fbr-gds-grp.obj-type = p-obj-type
     1215         AND upper_fbr-gds-grp.obj-code = p-obj-code
     1216         and upper_fbr-gds-grp.out-code = buf_fbr-gds-grp.upper-code no-error .
     1217   if not available upper_fbr-gds-grp then return ?.
     1218   return upper_fbr-gds-grp.out-code.
     1219   END FUNCTION.
     1220   procedure get-rkep-full-grp-name :
     1221   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1222   DEFINE INPUT PARAMETER p-grp-code LIKE ub.cd-grp.grp-code NO-UNDO.
     1223   define output parameter p-full-name as character    no-undo.
     1224   define variable v-upper-code    as integer  no-undo.
     1225   define buffer buf_cd-grp       for ub.cd-grp.
     1226   define buffer buf_upper_cd-grp for ub.cd-grp.
     1227   do
     1228   on error undo, return error
     1229   :
     1230       if P-grp-code = 0
     1231       then do:
     1232           assign
     1233               p-full-name = ""
     1234           .
     1235       end.
     1236       else do:
     1237           find first buf_cd-grp no-lock where
     1238                  buf_cd-grp.obj-type = 'маг':U
     1239              and buf_cd-grp.obj-code = p-obj-code
     1240              and buf_cd-grp.pos-type = 'r-keeper':U
     1241              and buf_cd-grp.grp-type = '':U
     1242              and buf_cd-grp.grp-code = p-grp-code
     1243           no-error.
     1244           if not available buf_cd-grp
     1245           then do:
     1246               undo, return error substitute("get-rkep-grp-name: Не найдена группа меню на кассе R-KEEPER с кодом &1", p-grp-code).
     1247           end.
     1248           assign
     1249               p-full-name  = ""
     1250               v-upper-code = 0
     1251           .
     1252           do while true
     1253           on error undo, return error "get-rkep-grp-name: Ошибка составления полного имени группы"
     1254           :
     1255               assign
     1256               p-full-name  = buf_cd-grp.grp-name
     1257                           + (if p-full-name <> "" then chr(47) else "")
     1258                           + p-full-name
     1259               v-upper-code = buf_cd-grp.upper-grp-code
     1260               .
     1261               if buf_cd-grp.grp-code = 0
     1262               then do:
     1263                   leave.
     1264               end.
     1265               find first buf_cd-grp no-lock where
     1266                         buf_cd-grp.obj-type = 'маг':U
     1267                     and buf_cd-grp.obj-code = p-obj-code
     1268                     and buf_cd-grp.pos-type = 'r-keeper':U
     1269                     and buf_cd-grp.grp-type = '':U
     1270                     and buf_cd-grp.grp-code = v-upper-code no-error.
     1271               if not available buf_cd-grp
     1272               then do:
     1273                   undo, return error "get-rkep-grp-name: Не найдена группа товаров с кодом "
     1274                                       + string( v-upper-code )
     1275                                       + ". Ошибка ссылки в дереве товаров для узла p-id".
     1276               end.
     1277           end.
     1278           assign
     1279               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1280           .
     1281       end.
     1282   end.
     1283   end procedure.
     1284   function get-price-id-from-int returns character ( input p-file-num as integer):
     1285     return ('price-list':U + chr(32) +  string(p-file-num)).
     1286   end function.
     1287   define variable log-file-name                as character      no-undo init "rkepsyn.txt".
     1288   define variable v-view-log                   as logical        no-undo .
     1289   define variable v-stop                       as logical        no-undo .
     1290   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1291   DEFINE VARIABLE ii0 AS INTEGER NO-UNDO.
     1292   define variable ii-ok as integer no-undo .
     1293   define variable v-lvl-num as integer no-undo .
     1294   define variable v-upper-num as character no-undo .
     1295   define variable v-stop-state as logical no-undo .
     1296   define buffer buf_cd-grp for ub.cd-grp.
     1297   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     1298   define buffer upper_fbr-gds-grp for ub.fbr-gds-grp.
     1299   do
     1300   on error undo, return error return-value
     1301   :
     1302     assign
     1303     ii0 = num-entries(p-rid-list)
     1304     .
     1305     _ii:
     1306     DO ii = 1 TO ii0:
     1307       FIND FIRST buf_cd-grp Exclusive-lock WHERE
     1308                 RECID(buf_cd-grp) = INTEGER(ENTRY(ii, p-rid-list)) NO-ERROR.
     1309       IF not AVAILABLE  buf_cd-grp  THEN do:
     1310           run write-log-and-file in p-log-handle (
     1311                 input 1
     1312               , input log-file-name
     1313               , input 1
     1314               , input substitute("Не найдена или занята запись группы блюд на кассе R-keeper c recid &1", INTEGER(ENTRY(ii, p-rid-list)))).
     1315           assign
     1316           v-view-log = yes.
     1317           next _ii.
     1318       end.
     1319       find first buf_Fbr-gds-grp exclusive-lock where
     1320                 buf_Fbr-gds-grp.obj-type = p-curr-obj-type
     1321           AND  buf_Fbr-gds-grp.obj-code = p-curr-obj-code
     1322           and  buf_Fbr-gds-grp.out-code = buf_cd-grp.grp-code NO-WAIT no-error .
     1323       if not available buf_Fbr-gds-grp and not locked buf_Fbr-gds-grp then do:
     1324         run write-log-and-file in p-log-handle (
     1325               input 1
     1326             , input log-file-name
     1327             , input 1
     1328             , input substitute( "!!!Группа блюд на кассе R-KEEPER с кодом &1 <&2>&3 - не найдена соответствующая группа блюд на  &4&5 в IBS TH"
     1329                                 , buf_cd-grp.grp-code
     1330                                 , buf_cd-grp.grp-name
     1331                                 , chr(10)
     1332                                 , p-curr-obj-type
     1333                                 , p-curr-obj-code
     1334                               )).
     1335         assign
     1336         v-view-log = yes.
     1337         next _ii.
     1338       end.
     1339       if locked buf_Fbr-gds-grp then do:
     1340         run write-log-and-file in p-log-handle (
     1341               input 1
     1342             , input log-file-name
     1343             , input 1
     1344             , input substitute( "!!!Группа блюд на кассе R-KEEPER с кодом &1 <&2>&3 - запись для соответствующей группа блюд на &4&5 в IBS TH ЗАНЯТА"
     1345                                 , buf_cd-grp.grp-code
     1346                                 , buf_cd-grp.grp-name
     1347                                 , chr(10)
     1348                                 , p-curr-obj-type
     1349                                 , p-curr-obj-code
     1350                               )).
     1351         assign
     1352         v-view-log = yes.
     1353         next _ii.
     1354       end.
     1355       if buf_Fbr-gds-grp.node-name <> buf_cd-grp.grp-name then do:
     1356         assign
     1357         buf_Fbr-gds-grp.node-name = buf_cd-grp.grp-name
     1358         .
     1359         release
     1360         buf_fbr-gds-grp no-error.
     1361         if error-status:error then do:
     1362           run write-log-and-file in p-log-handle (
     1363                 input 1
     1364               , input log-file-name
     1365               , input 1
     1366               , input substitute( "!!!Ошибка при переименовании группа блюд с кодом на кассе &1&2" +
     1367                                   "c <&3>&2 на <&4>:&2&5 &6"
     1368                                   , buf_fbr-gds-grp.out-code
     1369                                   , chr(10)
     1370                                   , buf_fbr-gds-grp.node-name
     1371                                   , buf_cd-grp.grp-name
     1372                                   , error-status:get-message(1)
     1373                                   , return-value
     1374                                 )).
     1375           assign
     1376           v-view-log = yes.
     1377           next _ii.
     1378         end.
     1379       end.
     1380       ii-ok = ii-ok + 1.
     1381       run show-counter in p-log-handle .
     1382       run write-counter in p-log-handle (substitute("Обработано &1 групп блюд, из них упешно &2"
     1383                                         , ii
     1384                                         , ii-ok
     1385                                         )) no-error.
     1386       run get-stop-state in p-log-handle(output v-stop-state).
     1387       if v-stop-state then do:
     1388         run write-log-and-file in p-log-handle (
     1389               input 1
     1390             , input log-file-name
     1391             , input 1
     1392             , input substitute( "!!!Процесс прерван пользователем"
     1393                               )).
     1394         assign
     1395         v-view-log = yes.
     1396         LEAVE _II.
     1397       end.
     1398     end.
     1399     run write-log-and-file in p-log-handle (
     1400           input 1
     1401         , input log-file-name
     1402         , input 1
     1403         , input substitute( "!!!Из &1 групп блюд успешно синхронизировано &2"
     1404                             , ii0
     1405                             , ii-ok
     1406                           )).
     1407   end.
