        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: sendgrup.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/sendgrup.p $":U .
       11   define variable vss-description as character no-undo init "Пересылка групп товаров на кассу - пускальник".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable i-obj-code like ub.shop.obj-code no-undo.
       82   define variable mode as char no-undo.
       83   define variable log-file-name as character no-undo init "send-cd.txt":U .
       84   define variable v-view-log as logical no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   DEFINE NEW SHARED TEMP-TABLE cash-grp no-undo
       87   FIELD stts like ub.clients.stts
       88   FIELD grp-code like ub.sum-grp.grp-code
       89   FIELD upper-code like ub.gds-grp.upper-code
       90   FIELD grp-name like ub.sum-grp.grp-name
       91   FIELD news-action as logical
       92   index pi IS UNIQUE PRIMARY
       93   grp-code
       94   .
       95   DEFINE NEW SHARED TEMP-TABLE cash-units no-undo  like ub.units
       96   .
       97   DEFINE NEW SHARED TEMP-TABLE cash-gds-prt no-undo like ub.gds-prt
       98   .
       99   DEFINE NEW SHARED TEMP-TABLE cash-country no-undo like ub.country
      100   .
      101   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   def
      103    shared
      104   temp-table  obj-list no-undo
      105     field obj-type like ub.clients.obj-type
      106     field obj-code like ub.clients.obj-code
      107     field obj-name like ub.clients.obj-name
      108     field obj-id   as integer
      109     field db-num   as integer
      110     index pi is primary unique obj-id
      111     index ie1 obj-type obj-code
      112     index ie2 obj-name
      113   .
      114   procedure create_obj-list :
      115      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      116      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      117      do
      118      on error undo, return error return-value
      119      :
      120         define buffer cli-obj for ub.clients .
      121         define variable p-var as integer no-undo .
      122         define buffer buf_obj-list for obj-list .
      123         find last buf_obj-list  use-index pi no-error .
      124         if available buf_obj-list
      125         then
      126            p-var = buf_obj-list.obj-id + 1.
      127         else
      128            p-var = 1.
      129         find first cli-obj where
      130                   cli-obj.obj-type = p-obj-type
      131               and cli-obj.obj-code = p-obj-code
      132         no-lock no-error.
      133         if available cli-obj
      134         then do:
      135            create buf_obj-list.
      136            assign
      137               buf_obj-list.obj-id   = p-var
      138               buf_obj-list.obj-code = cli-obj.obj-code
      139               buf_obj-list.obj-type = cli-obj.obj-type
      140               buf_obj-list.obj-name = cli-obj.obj-name
      141               buf_obj-list.db-num   = cli-obj.db-num
      142            .
      143         end.
      144      end.
      145   end.
      146   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147     define variable v-cntxt-db-num        as integer   no-undo .
      148     define variable v-cntxt-userid        as character no-undo .
      149     define variable v-cntxt-level         as character no-undo .
      150     define variable v-cntxt-host-code-obj as integer   no-undo .
      151     define variable v-cntxt-obj-type      as character no-undo .
      152     define variable v-cntxt-obj-code      as integer   no-undo .
      153     define variable v-cntxt-db-num-obj    as integer   no-undo .
      154     define variable v-cntxt-is-admin      as logical   no-undo .
      155   DEFINE VARIABLE choice as integer no-undo.
      156   DEFINE VARIABLE grp-list            as char no-undo.
      157   DEFINE VARIABLE kk                  as int      no-undo.
      158   DEFINE VARIABLE callpoint as char no-undo.
      159   define variable glog as logical no-undo .
      160   define variable is-bo as character no-undo .
      161   define variable is-bo-name as character no-undo .
      162   assign
      163   i-obj-code = integer(entry(1, p-parameter, chr(4)))
      164   mode       = entry(2, p-parameter, chr(4))
      165   is-bo      = (if num-entries(p-parameter, chr(4)) > 2
      166                 then entry(3, p-parameter, chr(4))
      167                 else '':U
      168                )
      169   no-error
      170   .
      171   if error-status:error then return error.
      172   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173     run mainmenu_getcntxt in parparentproc
      174       (output v-cntxt-db-num
      175       ,output v-cntxt-userid
      176       ,output v-cntxt-level
      177       ,output v-cntxt-host-code-obj
      178       ,output v-cntxt-obj-type
      179       ,output v-cntxt-obj-code
      180       ,output v-cntxt-db-num-obj
      181       ,output v-cntxt-is-admin
      182       ) .
      183   assign
      184   callpoint = mode.
      185   mode = if mode = "R" then "U" else mode.
      186   mode = if mode = "A" then "U" else mode.
      187   for each cash-grp:
      188     delete cash-grp.
      189   end.
      190   CASE is-bo:
      191     when '':U then do:
      192       assign
      193       is-bo-name = "группы товара на кассе"
      194       .
      195     end.
      196     when 'group-BO':U then do:
      197       assign
      198       is-bo-name = "группы товара TH"
      199       .
      200     end.
      201     when 'units':U then do:
      202       assign
      203       is-bo-name = "единицы измерения"
      204       .
      205     end.
      206     when 'gds-prt':U then do:
      207       assign
      208       is-bo-name = "шкалы"
      209       .
      210     end.
      211     when 'country':U then do:
      212       assign
      213       is-bo-name = "страны"
      214       .
      215     end.
      216   END.
      217   if is-bo = '':U then do:
      218     FIND FIRST ub.cash-desk NO-LOCK WHERE
      219               ub.cash-desk.db-num = g#db-num
      220           AND (ub.cash-desk.pos-type = 'IBM':U
      221               or
      222               ub.cash-desk.pos-type = 'IBM-XML':U
      223               or
      224               ub.cash-desk.pos-type = 'NCR-AS@R':U
      225               )
      226           AND ub.cash-desk.obj-code = i-obj-code No-error.
      227   end.
      228   else do:
      229     FIND FIRST ub.cash-desk NO-LOCK WHERE
      230               ub.cash-desk.db-num = g#db-num
      231           AND ub.cash-desk.pos-type = 'InfoKiosk':U
      232           AND ub.cash-desk.obj-code = i-obj-code No-error.
      233   end.
      234   IF not avail(ub.cash-desk)
      235   then do:
      236     if callpoint <> "R" then do:
      237       run write-log-and-file in p-log-handle (
      238             input 1
      239           , input log-file-name
      240           , input 1
      241           , input substitute( "!!!&1 &2 реализуется только для касс &3"
      242                               , (if mode = "U" then "Передача" else "Удаление")
      243                               , is-bo-name
      244                               , (if is-bo = '':U
      245                                  then substitute("&1 &2 &3"
      246                                                 , 'IBM':U
      247                                                 , 'IBM-XML':U
      248                                                 , 'NCR-AS@R':U
      249                                                 )
      250                                  else 'InfoKiosk':U
      251                                 )
      252                             )
      253                                            ) .
      254       return.
      255     end.
      256   end.
      257   else do:
      258     if callpoint = "R"
      259     then do:
      260       glog = yes.
      261     end.
      262     else do:
      263       define variable v-host-code as integer   no-undo .
      264   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      266     (input  'маг':U
      267     ,input  abs(i-obj-code)
      268     ,output v-host-code
      269     )  .
      270   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   do:
      272     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      273       (input  v-cntxt-db-num
      274       ,input  v-cntxt-userid
      275       ,input  0
      276       ,input  'actn_cashdesk-goods-groups_update':U
      277       ,input  'object':U
      278       ,input  v-host-code
      279       ,input  'маг':U
      280       ,input  abs(i-obj-code)
      281       ,input  0
      282       ,input  0
      283       ,input  0
      284       ,input  true
      285       ,output glog
      286       )  .
      287   end.
      288     end.
      289     if NOT glog then return .
      290     glog = yes.
      291     if callpoint = "R" then choice = 2.
      292     if callpoint = "A" then choice = 1.
      293     if choice = 0 then do:
      294       run gbl/d-askw.w (
      295                     input substitute("Выбор для пересылки: &1", is-bo-name)
      296                   ,input ( (if mode = "U"
      297                             then "Переслать на кассу"
      298                             else "Удалить из кассы" ) +
      299                             chr(10) + substitute("информацию по: &1", is-bo-name)
      300                             )
      301                   ,input "|"
      302                   ,input substitute("Все  имеющиеся в базе|&1Отказ от пересылки", (if is-bo <> '' then '':U else "Выборочно|"))
      303                   ,input (if is-bo <> '':U then "|" else "||")
      304                   ,input 1
      305                   ,input (if is-bo <> '':U then 2 else 3)
      306                   ,output choice).
      307     end.
      308     CASE choice :
      309       when 3 then return .
      310       when 2 then do:
      311         if is-bo <> '':U then return.
      312         if callpoint = "R" then do:
      313             run write-log-and-file in p-log-handle (
      314                   input 1
      315                 , input log-file-name
      316                 , input 1
      317                 , input substitute("Подготовка данных")
      318                                                 ).
      319           FOR EACH obj-list No-LOCK:
      320             find first ub.sum-grp NO-LOCK WHERE
      321                     ub.sum-grp.grp-code = obj-list.obj-code no-error .
      322             FIND FIRST cash-grp WHERE
      323                         cash-grp.grp-code = ub.sum-grp.grp-code NO-ERROR.
      324             if not avail cash-grp and
      325             (available ub.sum-grp or obj-list.obj-name = "D":U) then do:
      326               create cash-grp.
      327               assign
      328               cash-grp.grp-code = obj-list.obj-code
      329               cash-grp.grp-name = (if available ub.sum-grp
      330                                    then ub.sum-grp.grp-name
      331                                    else "":U)
      332               cash-grp.news-action = (if obj-list.obj-name = "D":U then yes else no)
      333               .
      334             end.
      335           END.
      336         end.
      337         else do:
      338           run ref/sum-grps.w ( input parparentproc, "b-sel,b-mark", input-output grp-list ) .
      339           if grp-list <> "" then do:
      340             run write-log-and-file in p-log-handle (
      341                   input 1
      342                 , input log-file-name
      343                 , input 1
      344                 , input substitute("&1 магазина &2: выборочная пересылка: &3"
      345                                   , (if mode = "U" then "Пересылка на кассы" else "Удаление с касс" )
      346                                   , i-obj-code
      347                                   , is-bo-name
      348                                   )
      349                 ).
      350             run write-log-and-file in p-log-handle (
      351                   input 1
      352                 , input log-file-name
      353                 , input 1
      354                 , input substitute("Подготовка данных")
      355                                                 ).
      356             DO kk = 1 TO num-entries( grp-list ) :
      357               FIND FIRST ub.sum-grp NO-LOCK WHERE
      358                         recid(ub.sum-grp) = integer(ENTRY(kk, grp-list)) NO-ERROR.
      359               IF AVAIL ub.sum-grp then do:
      360                 FIND FIRST cash-grp WHERE
      361                           cash-grp.grp-code = ub.sum-grp.grp-code NO-ERROR.
      362                 if not avail cash-grp then do:
      363                   create cash-grp.
      364                   assign
      365                   cash-grp.grp-code = ub.sum-grp.grp-code
      366                   cash-grp.grp-name = ub.sum-grp.grp-name
      367                   cash-grp.news-action = no
      368                   .
      369                 end.
      370               END.
      371             END.
      372           end.
      373           else  do:
      374             run write-log-and-file in p-log-handle (
      375                   input 1
      376                 , input log-file-name
      377                 , input 1
      378                 , input substitute("Не определен список для пересылки: &1", is-bo-name)
      379                                                 ).
      380             return .
      381           end.
      382         end.
      383       end.
      384       when 1 then do:
      385         run write-log-and-file in p-log-handle (
      386                   input 1
      387                 , input log-file-name
      388                 , input 1
      389                 , input substitute("Подготовка данных")
      390                                                 ).
      391         CASE is-bo:
      392           when "group-BO" then do:
      393             FOR EACH ub.gds-grp NO-LOCK:
      394               FIND FIRST cash-grp WHERE
      395                       cash-grp.grp-code = ub.gds-grp.node-code NO-ERROR.
      396               if not avail cash-grp then do:
      397                 create cash-grp.
      398                 assign
      399                 cash-grp.grp-code = ub.gds-grp.node-code
      400                 cash-grp.upper-code = ub.gds-grp.upper-code
      401                 cash-grp.grp-name = ub.gds-grp.node-name
      402                 cash-grp.news-action = no
      403                 .
      404               end.
      405             END.
      406           end.
      407           when '':U then do:
      408             FOR EACH ub.sum-grp NO-LOCK:
      409               FIND FIRST cash-grp WHERE
      410                       cash-grp.grp-code = ub.sum-grp.grp-code NO-ERROR.
      411               if not avail cash-grp then do:
      412                 create cash-grp.
      413                 assign
      414                 cash-grp.grp-code = ub.sum-grp.grp-code
      415                 cash-grp.grp-name = ub.sum-grp.grp-name
      416                 cash-grp.news-action = no
      417                 .
      418               end.
      419             END.
      420           END.
      421           when "units":U then do:
      422             FOR EACH ub.units NO-LOCK:
      423               FIND FIRST cash-units WHERE
      424                       cash-units.unit-name = ub.units.unit-name NO-ERROR.
      425               if not avail cash-units then do:
      426                 create cash-units.
      427                 assign
      428                 cash-units.unit-name = ub.units.unit-name
      429                 cash-units.long-name = ub.units.long-name
      430                 .
      431               end.
      432             END.
      433           end.
      434           when "gds-prt":U then do:
      435             FOR EACH ub.gds-prt NO-LOCK:
      436               FIND FIRST cash-gds-prt WHERE
      437                       cash-gds-prt.node-code = ub.gds-prt.node-code NO-ERROR.
      438               if not avail cash-gds-prt then do:
      439                 create cash-gds-prt.
      440                 buffer-copy ub.gds-prt to cash-gds-prt.
      441               end.
      442             END.
      443           end.
      444           when "country":U then do:
      445             FOR EACH ub.country NO-LOCK:
      446               FIND FIRST cash-country WHERE
      447                       cash-country.alpha1 = ub.country.alpha1 NO-ERROR.
      448               if not avail cash-country then do:
      449                 create cash-country.
      450                 buffer-copy ub.country to cash-country.
      451               end.
      452             END.
      453           end.
      454         end CASE.
      455       end.
      456     END CASE.
      457     if ((is-bo = '':U or is-bo = "group-BO")
      458        and
      459        can-find(first cash-grp)
      460        )
      461     or (is-bo = "Units"
      462         and
      463         can-find(first cash-units)
      464        )
      465     or (is-bo = "gds-prt":U
      466         and
      467         can-find(first cash-gds-prt)
      468        )
      469     or (is-bo = "country":U
      470         and
      471         can-find(first cash-country)
      472        )
      473          then do:
      474         run str/send-grp.p (
      475                         input parparentproc
      476                       , input p-parent-handle
      477                       , input p-log-handle
      478                       , input i-obj-code
      479                       , input  mode
      480                       , input is-bo
      481                       , input log-file-name
      482                       , input-output v-view-log
      483                       ) no-error.
      484         run write-log-and-file in p-log-handle (
      485               input 1
      486             , input log-file-name
      487             , input 1
      488             , input substitute("&1 маг&2 &3"
      489                                 , (if mode = "U"
      490                                   then substitute("&1 Передача на кассы", is-bo-name)
      491                                   else substitute("&1 Удаление с касс", is-bo-name)
      492                                   )
      493                                 , i-obj-code
      494                                 , (if mode = "U"
      495                                   then "проведена"
      496                                   else "проведено")
      497                                 )
      498                                             ).
      499     end.
      500     else do:
      501        run write-log-and-file in p-log-handle (
      502               input 1
      503             , input log-file-name
      504             , input 1
      505             , input substitute("Не найдено информации по: &1 для передачи на кассы маг&2"
      506                                , is-bo-name
      507                                , i-obj-code
      508                                             )).
      509     end.
      510   end.
