        1   define input-output parameter p-InfoSec as class ibs.th.str.InfoSection .
        2   DEFINE BUTTON Btn_OK AUTO-GO
        3        LABEL "OK"
        4        SIZE 15 BY 1.14
        5        BGCOLOR 8 .
        6   DEFINE VARIABLE e-pokmi-warnings AS CHARACTER
        7        VIEW-AS EDITOR SCROLLBAR-VERTICAL
        8        SIZE 73 BY 2.62 NO-UNDO.
        9   DEFINE VARIABLE f-deficit AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       10        LABEL "Масса недостачи НП (кг)"
       11         VIEW-AS TEXT
       12        SIZE 14 BY .62 NO-UNDO.
       13   DEFINE VARIABLE f-delta-1 AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       14        LABEL "ПОкМИ (%)"
       15         VIEW-AS TEXT
       16        SIZE 14 BY .62 NO-UNDO.
       17   DEFINE VARIABLE f-delta-2 AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       18        LABEL "Относительная погрешность измерения массы нефтепродукта (%)"
       19         VIEW-AS TEXT
       20        SIZE 14 BY .62 NO-UNDO.
       21   DEFINE VARIABLE f-density AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       22        LABEL "Плотность НП (г/см3)"
       23         VIEW-AS TEXT
       24        SIZE 14 BY .62 NO-UNDO.
       25   DEFINE VARIABLE f-density-2 AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       26        LABEL "модуля ПОкМИ (кг/м3)"
       27         VIEW-AS TEXT
       28        SIZE 14 BY .62 NO-UNDO.
       29   DEFINE VARIABLE f-excess AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       30        LABEL "Масса излишка НП (кг)"
       31         VIEW-AS TEXT
       32        SIZE 14 BY .62 NO-UNDO.
       33   DEFINE VARIABLE f-fact-kg-qnty AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       34        LABEL "Масса НП, подлежащая оприходованию по результатам приема (кг)"
       35         VIEW-AS TEXT
       36        SIZE 14 BY .62 NO-UNDO.
       37   DEFINE VARIABLE f-fact-qnty AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       38        LABEL "Объем НП, подлежащий оприходованию по результатам приема (л)"
       39         VIEW-AS TEXT
       40        SIZE 14 BY .62 NO-UNDO.
       41   DEFINE VARIABLE f-limit AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       42        LABEL "Масса допустимого расхождения (кг)"
       43         VIEW-AS TEXT
       44        SIZE 14 BY .62 NO-UNDO.
       45   DEFINE VARIABLE f-norm-loss AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       46        LABEL "Масса естественной убыли НП при перевозке (кг)"
       47         VIEW-AS TEXT
       48        SIZE 14 BY .62 NO-UNDO.
       49   DEFINE VARIABLE f-pokmi-kg-qnty AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       50        LABEL "Масса НП, по результатам расчета модуля ПОкМИ (кг)"
       51         VIEW-AS TEXT
       52        SIZE 14 BY .62 NO-UNDO.
       53   DEFINE VARIABLE f-pokmi-qnty AS CHARACTER FORMAT "X(20)":U INITIAL "0"
       54        LABEL "ПОкМИ (л)"
       55         VIEW-AS TEXT
       56        SIZE 14 BY .62 NO-UNDO.
       57   DEFINE FRAME Dialog-Frame
       58        e-pokmi-warnings AT ROW 15.52 COL 2 NO-LABEL WIDGET-ID 40
       59        Btn_OK AT ROW 18.38 COL 61
       60        f-fact-kg-qnty AT ROW 1.48 COL 2 WIDGET-ID 4
       61        f-pokmi-kg-qnty AT ROW 2.43 COL 2 WIDGET-ID 6
       62        f-limit AT ROW 3.38 COL 2 WIDGET-ID 8
       63        f-delta-1 AT ROW 4.95 COL 2 WIDGET-ID 34
       64        f-delta-2 AT ROW 5.71 COL 2 WIDGET-ID 36
       65        f-excess AT ROW 6.52 COL 2 WIDGET-ID 10
       66        f-deficit AT ROW 7.48 COL 2 WIDGET-ID 12
       67        f-norm-loss AT ROW 8.43 COL 2 WIDGET-ID 14
       68        f-fact-qnty AT ROW 9.33 COL 2 WIDGET-ID 16
       69        f-pokmi-qnty AT ROW 11 COL 2 WIDGET-ID 18
       70        f-density AT ROW 11.86 COL 2 WIDGET-ID 20
       71        f-density-2 AT ROW 13.62 COL 2 WIDGET-ID 24
       72        "Объем НП при температуре его измерения по результатам расчета модуля" VIEW-AS TEXT
       73             SIZE 79 BY .62 AT ROW 10.19 COL 2 WIDGET-ID 26
       74        "Предупреждения:" VIEW-AS TEXT
       75             SIZE 22 BY .62 AT ROW 14.81 COL 3 WIDGET-ID 38
       76        "Относительная погрешность измерения массы нефтепродукта по результатам" VIEW-AS TEXT
       77             SIZE 82 BY .62 AT ROW 4.19 COL 2 WIDGET-ID 30
       78        "Плотность НП, приведенная к стандартным условиям по результатам расчета" VIEW-AS TEXT
       79             SIZE 83 BY .62 AT ROW 12.81 COL 2 WIDGET-ID 28
       80        SPACE(2.00) SKIP(1.5)
       81       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       82            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       83            TITLE "Результат расчета АЦ"
       84            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
       85   ASSIGN
       86          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       87          FRAME Dialog-Frame:HIDDEN           = TRUE.
       88   ASSIGN
       89          e-pokmi-warnings:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       90   ASSIGN
       91          f-deficit:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       92   ASSIGN
       93          f-delta-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       94   ASSIGN
       95          f-delta-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       96   ASSIGN
       97          f-density:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       98   ASSIGN
       99          f-density-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      100   ASSIGN
      101          f-excess:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      102   ASSIGN
      103          f-fact-kg-qnty:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      104   ASSIGN
      105          f-fact-qnty:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      106   ASSIGN
      107          f-limit:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      108   ASSIGN
      109          f-norm-loss:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      110   ASSIGN
      111          f-pokmi-kg-qnty:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      112   ASSIGN
      113          f-pokmi-qnty:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      114   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      115   DO:
      116     APPLY "END-ERROR":U TO SELF.
      117   END.
      118   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      119   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      120   MAIN-BLOCK:
      121   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      122      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      123     if p-InfoSec:AccMeth = 0
      124     then do :
      125       assign
      126         frame Dialog-Frame:title = frame Dialog-Frame:title + " (Принято к учёту)"
      127         f-fact-kg-qnty    = trim(string(p-InfoSec:FactKgQnty, "->>,>>>,>>9.9":U))
      128         f-pokmi-kg-qnty   = trim(string(p-InfoSec:TankWeight, "->>,>>>,>>9.9":U))
      129         f-limit           = trim(string(p-InfoSec:AccAbsFact, "->>,>>>,>>9.9":U))
      130         f-delta-1         = trim(string(p-InfoSec:AccPomiReal, "->>,>>>,>>9.99":U))
      131         f-delta-2         = trim(string(p-InfoSec:AccPomi, "->>,>>>,>>9.99":U))
      132         f-excess          = trim(string(p-InfoSec:Excess, "->>,>>>,>>9.9":U))
      133         f-deficit         = trim(string(p-InfoSec:Deficit, "->>,>>>,>>9.9":U))
      134         f-norm-loss       = trim(string(p-InfoSec:NaturalLoss, "->>,>>>,>>9.9":U))
      135         f-fact-qnty       = trim(string(p-InfoSec:FactQnty, "->>,>>>,>>9":U))
      136         f-pokmi-qnty      = trim(string(p-InfoSec:TankVolPomiReal, "->>,>>>,>>9":U))
      137         f-density         = trim(string((p-InfoSec:FactKgQnty / p-InfoSec:FactQnty), "9.9999"))
      138         f-density-2       = trim(string((p-InfoSec:TankDensityPomi * 1000), "->>,>>>,>>9.9":U))
      139         e-pokmi-warnings  = p-InfoSec:PokmiWarnings
      140       .
      141     end .
      142     else do :
      143       assign
      144         frame Dialog-Frame:title = frame Dialog-Frame:title + " (Справка)"
      145         f-fact-kg-qnty    = ""
      146         f-pokmi-kg-qnty   = trim(string(p-InfoSec:TankWeight, "->>,>>>,>>9.9":U))
      147         f-limit           = trim(string(p-InfoSec:AccAbsFact, "->>,>>>,>>9.9":U))
      148         f-delta-1         = trim(string(p-InfoSec:AccPomiReal, "->>,>>>,>>9.99":U))
      149         f-delta-2         = trim(string(p-InfoSec:AccPomi, "->>,>>>,>>9.99":U))
      150         f-excess          = ""
      151         f-deficit         = ""
      152         f-norm-loss       = trim(string(p-InfoSec:NaturalLoss, "->>,>>>,>>9.9":U))
      153         f-fact-qnty       = ""
      154         f-pokmi-qnty      = trim(string(p-InfoSec:TankVolPomiReal, "->>,>>>,>>9":U))
      155         f-density         = trim(string((p-InfoSec:TankWeight / p-InfoSec:TankVolPomiReal), "9.9999"))
      156         f-density-2       = trim(string((p-InfoSec:TankDensityPomi * 1000), "->>,>>>,>>9.9":U))
      157         e-pokmi-warnings  = p-InfoSec:PokmiWarnings
      158       .
      159     end .
      160     RUN enable_UI.
      161     WAIT-FOR GO OF FRAME Dialog-Frame.
      162   END.
      163   RUN disable_UI.
      164   PROCEDURE disable_UI :
      165     HIDE FRAME Dialog-Frame.
      166   END PROCEDURE.
      167   PROCEDURE enable_UI :
      168     DISPLAY e-pokmi-warnings f-fact-kg-qnty f-pokmi-kg-qnty f-limit f-delta-1
      169             f-delta-2 f-excess f-deficit f-norm-loss f-fact-qnty f-pokmi-qnty
      170             f-density f-density-2
      171         WITH FRAME Dialog-Frame.
      172     ENABLE e-pokmi-warnings Btn_OK
      173         WITH FRAME Dialog-Frame.
      174     VIEW FRAME Dialog-Frame.
      175   END PROCEDURE.
