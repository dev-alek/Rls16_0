        1   define input parameter parparentproc        as widget-handle    no-undo .
        2   define input parameter p-name-filter        as character        no-undo.
        3   define input parameter p-login-filter       as character        no-undo.
        4   define output parameter p-new-name-filter   as character        no-undo.
        5   define output parameter p-new-login-filter  as character        no-undo.
        6   define output parameter p-filter-comment    as character        no-undo.
        7   define output parameter p-accepted          as logical          no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Выбор фильтра для интерфейса пользователей".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable v-usersf-can-exit   as logical      no-undo.
       73   DEFINE BUTTON b-cancel AUTO-END-KEY
       74        LABEL "&Отмена"
       75        SIZE 12 BY 1 TOOLTIP "Снять фильтр (ESC)"
       76        BGCOLOR 8 .
       77   DEFINE BUTTON b-exit AUTO-GO
       78        LABEL "&Ввод"
       79        SIZE 12 BY 1 TOOLTIP "Установить фильтр (ENTER)"
       80        BGCOLOR 8 .
       81   DEFINE BUTTON b-help
       82        LABEL "Помо&щь"
       83        SIZE 10 BY 1
       84        BGCOLOR 8 .
       85   DEFINE VARIABLE fi-login-filter AS CHARACTER FORMAT "X(256)":U
       86        LABEL "В логине"
       87        VIEW-AS FILL-IN
       88        SIZE 26 BY 1 NO-UNDO.
       89   DEFINE VARIABLE fi-name-filter AS CHARACTER FORMAT "X(256)":U
       90        LABEL "В имени"
       91        VIEW-AS FILL-IN
       92        SIZE 26 BY 1 NO-UNDO.
       93   DEFINE FRAME Dialog-Frame
       94        b-exit AT ROW 1 COL 1
       95        b-cancel AT ROW 1 COL 13
       96        b-help AT ROW 1 COL 29
       97        fi-name-filter AT ROW 3.25 COL 11 COLON-ALIGNED WIDGET-ID 2
       98        fi-login-filter AT ROW 4.5 COL 11 COLON-ALIGNED WIDGET-ID 4
       99        SPACE(0.49) SKIP(0.82)
      100       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      101            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      102            TITLE "Выбор полей фильтра"
      103            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel WIDGET-ID 100.
      104   ASSIGN
      105          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      106          FRAME Dialog-Frame:HIDDEN           = TRUE.
      107   ON GO OF FRAME Dialog-Frame
      108   DO:
      109   END.
      110   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      111   DO:
      112       if v-usersf-can-exit = no
      113       then do:
      114           undo, return no-apply.
      115       end.
      116       APPLY "END-ERROR":U TO SELF.
      117   END.
      118   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      119   DO:
      120   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   if lookup(self :type
      122            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      123            ) = 0
      124   then do:
      125     message
      126       "$Workfile$"
      127       "Указанному интерфейсному элементу фокус не может быть передан" skip
      128       "Интерфейсный элемент" self :name  skip
      129       "Тип" self :type  skip
      130       "Процедура" this-procedure :file-name skip
      131       view-as alert-box .
      132   end.
      133   else do:
      134     apply "entry":u to self  .
      135     if focus :handle <> self :handle  then do:
      136       return no-apply .
      137     end.
      138   end.
      139       assign
      140           v-usersf-can-exit   = yes
      141           p-accepted          = no
      142       .
      143   END.
      144   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      145   DO:
      146   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147   if lookup(self :type
      148            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      149            ) = 0
      150   then do:
      151     message
      152       "$Workfile$"
      153       "Указанному интерфейсному элементу фокус не может быть передан" skip
      154       "Интерфейсный элемент" self :name  skip
      155       "Тип" self :type  skip
      156       "Процедура" this-procedure :file-name skip
      157       view-as alert-box .
      158   end.
      159   else do:
      160     apply "entry":u to self  .
      161     if focus :handle <> self :handle  then do:
      162       return no-apply .
      163     end.
      164   end.
      165       assign
      166           fi-name-filter
      167           fi-login-filter
      168       .
      169       run set-parameters in this-procedure (
      170           input no
      171       ).
      172       assign
      173           v-usersf-can-exit   = yes
      174           p-accepted          = yes
      175       .
      176   END.
      177   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      178   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      179   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   on help of frame Dialog-Frame
      181   do:
      182     run gbl/app_help.p
      183       (input this-procedure :file-name
      184       ,input ''
      185       ,input ?
      186       ) no-error.
      187     if error-status :error then do:
      188       message
      189         "Ошибка при вызове помощи"
      190         error-status :get-message(1)
      191         view-as alert-box .
      192     end.
      193   end.
      194   run minbtn-set in this-procedure .
      195   on choose of b-help in frame Dialog-Frame
      196   do:
      197     apply "help":u to frame Dialog-Frame .
      198   end.
      199   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   procedure minbtn-set :
      201       do
      202           on error undo, return error return-value
      203           :
      204           define variable ii              as integer       no-undo .
      205           define variable fh              as widget-handle no-undo .
      206           define variable hh              as widget-handle no-undo .
      207           define variable v-h             as handle        extent 4 no-undo .
      208           define variable v-name-button   as character     no-undo .
      209           define variable v-help-old-x    as decimal       no-undo .
      210           define variable v-help-old-y    as decimal       no-undo .
      211           define variable v-help-old-size as decimal       no-undo .
      212           define variable v-frame-width   as decimal       no-undo .
      213           define variable jj              as integer       no-undo .
      214           do
      215               on error undo, return error
      216               :
      217               assign
      218                   v-frame-width = frame Dialog-Frame:width - 0.3
      219                   fh            = frame Dialog-Frame:first-child
      220                   hh            = fh:first-child
      221                   ii            = 1
      222                   .
      223               do while valid-handle(hh):
      224                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      225                   do:
      226                       case lc(hh:name) :
      227                           when "b-help" then
      228                               do:
      229                                   hh:load-image-up("cmp/b-help.bmp":u) .
      230                                   hh:load-image-down("cmp/b-help.bmp":u) .
      231                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      232                                   hh:TOOLTIP = "Помощь" .
      233                                   v-help-old-x = hh:column .
      234                                   v-help-old-y = hh:row    .
      235                                   v-help-old-size = hh:width .
      236                                   hh:width-chars = 2.5 .
      237                               end.
      238                           when "b-print" then
      239                               do:
      240                                   hh:load-image("cmp/b-print.bmp":u) .
      241                                   hh:TOOLTIP = "Печать" .
      242                                   v-h[ii] = hh:handle .
      243                                   ii = ii + 1 .
      244                                   hh:width-chars = 3 .
      245                               end.
      246                           when "b-history" or
      247                           when "b-hist" then
      248                               do:
      249                                   hh:load-image("cmp/b-hist.bmp":u) .
      250                                   hh:TOOLTIP = "История" .
      251                                   v-h[ii] = hh:handle .
      252                                   ii = ii + 1 .
      253                                   hh:width-chars = 3 .
      254                               end.
      255                           when "b-sch" then
      256                               do:
      257                                   hh:load-image("cmp/b-sch.bmp":u) .
      258                                   hh:TOOLTIP = "Установка Фильтра" .
      259                                   v-h[ii] = hh:handle .
      260                                   ii = ii + 1 .
      261                                   hh:width-chars = 3 .
      262                               end.
      263                           when "b-hist-user" then
      264                               do:
      265                                   hh:load-image("cmp/b-hist.bmp":u) .
      266                                   hh:TOOLTIP = "История пользователя" .
      267                                   ii = ii + 1 .
      268                               end.
      269                       end case.
      270                   end.
      271                   hh = hh:next-sibling.
      272               end.
      273               b-help:column = v-frame-width - b-help:width-chars.
      274               jj = 0.
      275               repeat ii = 4 to 1 by -1 :
      276                   if valid-handle (v-h[ii] ) then
      277                   do:
      278                       jj  = jj + 1 .
      279                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      280                       v-h[ii]:row    = v-help-old-y .
      281                   end.
      282               end.
      283           end.
      284       end.
      285   end procedure.
      286   MAIN-BLOCK:
      287   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      288      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      289      run init-fields in this-procedure.
      290     RUN enable_UI.
      291     apply "entry":U to fi-name-filter.
      292     WAIT-FOR GO OF FRAME Dialog-Frame.
      293   END.
      294   RUN disable_UI.
      295   PROCEDURE disable_UI :
      296     HIDE FRAME Dialog-Frame.
      297   END PROCEDURE.
      298   PROCEDURE enable_UI :
      299     DISPLAY fi-name-filter fi-login-filter
      300         WITH FRAME Dialog-Frame.
      301     ENABLE b-exit b-cancel b-help fi-name-filter fi-login-filter
      302         WITH FRAME Dialog-Frame.
      303     VIEW FRAME Dialog-Frame.
      304   END PROCEDURE.
      305   PROCEDURE init-fields :
      306   do
      307   with frame Dialog-Frame
      308   on error undo, return error
      309   :
      310       assign
      311           fi-name-filter      = p-name-filter
      312           fi-login-filter     = p-login-filter
      313           v-usersf-can-exit   = no
      314       .
      315   end.
      316   END PROCEDURE.
      317   PROCEDURE set-parameters :
      318   define input parameter p-cancel     as logical          no-undo.
      319   do
      320   on error undo, return error
      321   :
      322       if p-cancel = yes
      323       then do:
      324           assign
      325               p-new-name-filter   = "":U
      326               p-new-login-filter  = "":U
      327               p-filter-comment    = "":U
      328           .
      329       end.
      330       else do:
      331           assign
      332               p-new-name-filter   = fi-name-filter
      333               p-new-login-filter  = fi-login-filter
      334           .
      335           if p-new-name-filter <> "":U
      336           then do:
      337               assign
      338                   p-filter-comment    = substitute( "Имя: &1  ", fi-name-filter )
      339               .
      340           end.
      341           if p-new-login-filter <> "":U
      342           then do:
      343               assign
      344                   p-filter-comment    = substitute( "&1Логин: &2", p-filter-comment, fi-login-filter )
      345               .
      346           end.
      347       end.
      348   end.
      349   END PROCEDURE.
