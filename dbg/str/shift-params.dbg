        1   define input parameter p-obj-type as character no-undo .
        2   define input parameter p-obj-code as integer no-undo .
        3   define input parameter p-shift-date like ub.shift-obj.shift-date no-undo .
        4   define input parameter p-shift-num like ub.shift-obj.shift-num no-undo .
        5   define input parameter p-shift-name like ub.shift-obj.shift-name no-undo .
        6   define buffer buf_reportShift for ub.reportShift .
        7   define buffer buf_report      for ub.reportShift .
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   DEFINE BUTTON b-quit AUTO-END-KEY
       13       LABEL "&Выход"
       14       SIZE 10 BY 1 TOOLTIP "Выход"
       15       BGCOLOR 8 .
       16   DEFINE VARIABLE Dev-paid-trans AS DECIMAL   FORMAT "->9.99":U INITIAL 1
       17       VIEW-AS FILL-IN
       18       SIZE 8.5 BY 1
       19       NO-UNDO.
       20   DEFINE VARIABLE f-shift        AS CHARACTER FORMAT "X(256)":U INITIAL "Смена: 19/08/2024 Номер: 1 Порядок: 1"
       21       VIEW-AS FILL-IN
       22       SIZE 39.5 BY 1 NO-UNDO.
       23   DEFINE VARIABLE id-check       AS INTEGER   FORMAT "999999999":U INITIAL 1
       24       VIEW-AS FILL-IN
       25       SIZE 11.5 BY 1
       26       NO-UNDO.
       27   DEFINE VARIABLE id-shift       AS INTEGER   FORMAT "999999999":U INITIAL 1
       28       VIEW-AS FILL-IN
       29       SIZE 11.5 BY 1
       30       NO-UNDO.
       31   DEFINE VARIABLE Prc-dev-mass   AS DECIMAL   FORMAT "->9.99":U INITIAL .65
       32       VIEW-AS FILL-IN
       33       SIZE 8.5 BY 1
       34       NO-UNDO.
       35   DEFINE RECTANGLE RECT-1
       36       EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
       37       SIZE 62 BY 7.75.
       38   DEFINE FRAME Dialog-Frame
       39       b-quit AT ROW 1 COL 1 WIDGET-ID 24
       40       f-shift AT ROW 1 COL 12 COLON-ALIGNED NO-LABEL WIDGET-ID 4
       41       Prc-dev-mass AT ROW 3 COL 58 RIGHT-ALIGNED NO-LABEL WIDGET-ID 6
       42       Dev-paid-trans AT ROW 5.04 COL 58 RIGHT-ALIGNED NO-LABEL WIDGET-ID 8
       43       id-check AT ROW 7.33 COL 61 RIGHT-ALIGNED NO-LABEL WIDGET-ID 32
       44       id-shift AT ROW 8.79 COL 61 RIGHT-ALIGNED NO-LABEL WIDGET-ID 34
       45       "топлива на кассе и объемом по счетчик" VIEW-AS TEXT
       46       SIZE 45 BY .58 AT ROW 6.04 COL 2.5 WIDGET-ID 22
       47       "Идентификатор сменного отчета" VIEW-AS TEXT
       48       SIZE 45 BY 1 AT ROW 8.79 COL 2.5 WIDGET-ID 30
       49       "Идентификатор чек-листа" VIEW-AS TEXT
       50       SIZE 45 BY 1 AT ROW 7.33 COL 2.5 WIDGET-ID 28
       51       "л." VIEW-AS TEXT
       52       SIZE 2.5 BY 1 AT ROW 5.04 COL 60 WIDGET-ID 10
       53       "%" VIEW-AS TEXT
       54       SIZE 2.5 BY 1 AT ROW 3 COL 60 WIDGET-ID 12
       55       "Процент допустимого отклонения массы топлива" VIEW-AS TEXT
       56       SIZE 45 BY 1 AT ROW 3 COL 2.5 WIDGET-ID 14
       57       "на конец смены" VIEW-AS TEXT
       58       SIZE 45 BY .58 AT ROW 4 COL 2.5 WIDGET-ID 16
       59       "Допустимое отклонение между объемом продаж" VIEW-AS TEXT
       60       SIZE 45 BY 1 AT ROW 5.04 COL 2.5 WIDGET-ID 20
       61       RECT-1 AT ROW 2.5 COL 1.5 WIDGET-ID 26
       62       SPACE(1.62) SKIP(0.32)
       63       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       64       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       65       TITLE "Параметры по смене" WIDGET-ID 100.
       66   ASSIGN
       67       FRAME Dialog-Frame:SCROLLABLE = FALSE
       68       FRAME Dialog-Frame:HIDDEN     = TRUE.
       69   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       70       DO:
       71           APPLY "END-ERROR":U TO SELF.
       72       END.
       73   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       74       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       75   MAIN-BLOCK:
       76   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       77       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       78       f-shift = "Смена: " + string(p-shift-date,"99/99/9999") + " Номер: " + string(p-shift-num) + " Порядок: " + string(p-shift-name) .
       79       find first ub.shift-obj no-lock where ub.shift-obj.obj-code = p-obj-code and
       80           ub.shift-obj.obj-type = p-obj-type and
       81           ub.shift-obj.shift-date = p-shift-date and
       82           ub.shift-obj.shift-num = p-shift-num and
       83           ub.shift-obj.shift-name = p-shift-name no-error .
       84       if ub.shift-obj.status_ = 'зкр':U then
       85       do:
       86           find first ub.shift-param no-lock where ub.shift-param.obj-code = p-obj-code and
       87               ub.shift-param.obj-type = p-obj-type and
       88               ub.shift-param.shift-date = p-shift-date and
       89               ub.shift-param.shift-name = p-shift-name and
       90               ub.shift-param.shift-num = p-shift-num and
       91               ub.shift-param.gds-code = 0 and
       92               ub.shift-param.pl-code = 0 no-error .
       93           if available (ub.shift-param) then
       94           do:
       95               assign
       96                   dev-paid-trans = ub.shift-param.dev-paid-trans
       97                   prc-dev-mass   = ub.shift-param.prc-dev-mass
       98                   .
       99               find first buf_reportShift exclusive-lock where buf_reportShift.shift-date = p-shift-date and
      100                   buf_reportShift.shift-num = p-shift-num and buf_reportShift.obj-code = p-obj-code and
      101                   buf_reportShift.obj-type = p-obj-type and buf_reportShift.report-type = 1 no-error .
      102               if available (buf_reportShift) then
      103               do:
      104                   id-shift = buf_reportShift.id .
      105               end.
      106               else id-shift = 0 .
      107               find first buf_reportShift exclusive-lock where buf_reportShift.shift-date = p-shift-date and
      108                   buf_reportShift.shift-num = p-shift-num and buf_reportShift.obj-code = p-obj-code and
      109                   buf_reportShift.obj-type = p-obj-type and buf_reportShift.report-type = 0 no-error .
      110               if available (buf_reportShift) then
      111               do:
      112                   id-check = buf_reportShift.id .
      113               end.
      114               else id-check = 0 .
      115           end.
      116           else
      117           do:
      118               return .
      119           end.
      120       end.
      121       else
      122       do:
      123           find first ub.shift-param no-lock where ub.shift-param.obj-code = p-obj-code and
      124               ub.shift-param.obj-type = p-obj-type and
      125               ub.shift-param.shift-date = p-shift-date and
      126               ub.shift-param.shift-name = p-shift-name and
      127               ub.shift-param.shift-num = p-shift-num and
      128               ub.shift-param.gds-code = 0 and
      129               ub.shift-param.pl-code = 0 no-error .
      130           if not available (ub.shift-param) then do:
      131           find first ub.shift-param no-lock where ub.shift-param.obj-code = 0 and
      132               ub.shift-param.obj-type = "" and
      133               ub.shift-param.shift-date = 01.01.1900  no-error .
      134           if available (ub.shift-param) then
      135           do:
      136               assign
      137                   dev-paid-trans = ub.shift-param.dev-paid-trans
      138                   prc-dev-mass   = ub.shift-param.prc-dev-mass
      139                   .
      140           end.
      141           else return .
      142           end.
      143           else do:
      144               assign
      145                   dev-paid-trans = ub.shift-param.dev-paid-trans
      146                   prc-dev-mass   = ub.shift-param.prc-dev-mass
      147                   .
      148           end.
      149       end.
      150       RUN enable_UI.
      151       if ub.shift-obj.status_ <> 'зкр':U then do:
      152           hide id-check id-shift in frame Dialog-Frame .
      153       end.
      154       WAIT-FOR GO OF FRAME Dialog-Frame.
      155   END.
      156   RUN disable_UI.
      157   PROCEDURE disable_UI :
      158       HIDE FRAME Dialog-Frame.
      159   END PROCEDURE.
      160   PROCEDURE enable_UI :
      161       DISPLAY f-shift Prc-dev-mass Dev-paid-trans id-check id-shift
      162           WITH FRAME Dialog-Frame.
      163       ENABLE b-quit RECT-1
      164           WITH FRAME Dialog-Frame.
      165       VIEW FRAME Dialog-Frame.
      166   END PROCEDURE.
