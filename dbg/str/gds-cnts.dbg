     2838   ON CHOOSE OF b-all IN FRAME Dialog-Frame
     2839   DO:
     2840   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2841   do:
     2842     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2843       (input  v-cntxt-db-num
     2844       ,input  v-cntxt-userid
     2845       ,input  0
     2846       ,input  'actn_fin-contract_modernization':U
     2847       ,input  'firm':U
     2848       ,input  v-cntxt-host-code-obj
     2849       ,input  '':U
     2850       ,input  0
     2851       ,input  0
     2852       ,input  0
     2853       ,input  0
     2854       ,input  true
     2855       ,output g-log
     2856       )  .
     2857   end.
     2858     if not g-log then  return .
     2859     message "Вы действительно хотите изменить % по спецификации ?" view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
     2860     if g-log = no then return no-apply.
     2861     assign FILL-prc .
     2862       do transaction :
     2863       for each  contract-specif exclusive-lock where
     2864                 contract-specif.host-code    = p-host-code and
     2865                 contract-specif.contract-num = p-doc-num
     2866       , first temp-trn-doc where  ( r-2 = 1 or contract-specif.gds-code = temp-trn-doc.gds-code )  :
     2867         assign
     2868           contract-specif.prc = FILL-prc
     2869           .
     2870       end.
     2871       assign
     2872        is-new = yes
     2873        .
     2874     end.
     2875     run openbr in this-procedure (yes, no, '':u).
     2876   END.
