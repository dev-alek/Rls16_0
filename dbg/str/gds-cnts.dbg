     2817   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2818   do:
     2819     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2820       (input  v-cntxt-db-num
     2821       ,input  v-cntxt-userid
     2822       ,input  0
     2823       ,input  'actn_fin-contract_modernization':U
     2824       ,input  'firm':U
     2825       ,input  v-cntxt-host-code-obj
     2826       ,input  '':U
     2827       ,input  0
     2828       ,input  0
     2829       ,input  0
     2830       ,input  0
     2831       ,input  true
     2832       ,output g-log
     2833       )  .
