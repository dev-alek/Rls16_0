     3045   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     3046   DO:
     3047     if not available buf_contract-specif then return no-apply.
     3048     find first temp-conn where temp-conn.ri = recid( buf_contract-specif ) no-error  .
     3049     if available temp-conn then do:
     3050       delete temp-conn .
     3051       assign  mark-num = mark-num - 1 .
     3052     end.
     3053     else do:
     3054       if b-sel:sensitive and mark-num >= 4000 then do:
     3055         message "Превышено максимально допустимое количество выбранных строк." skip
     3056                 "Отбирайте необходимые товары по частям"
     3057         view-as alert-box WARNING.
     3058         apply "entry" to spec-List .
     3059         return no-apply.
     3060       end.
     3061       create temp-conn .
     3062       assign
     3063         temp-conn.ri = recid( buf_contract-specif )
     3064         mark-num = mark-num + 1
     3065       .
     3066     end.
     3067     g-log = spec-List:refresh() .
     3068     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     3069       g-log = spec-List:select-next-row ().
     3070       apply "value-changed" to spec-List in frame Dialog-Frame.
     3071     end.
     3072     if mark-num = 0 then hide mark-num in frame Dialog-Frame.
     3073     else              display mark-num with frame Dialog-Frame.
     3074     apply "entry" to spec-List .
     3075   END.
