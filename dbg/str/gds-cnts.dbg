     3004   ON CHOOSE OF b-filter-ext IN FRAME Dialog-Frame
     3005   DO:
     3006     if r-2 = 1 then r-2 = 2 .
     3007                else r-2 = 1.
     3008     if r-2 = 2 then do:
     3009        find first gds-list-flt where gds-list-flt.gds-code = 0 no-error .
     3010        if available gds-list-flt then delete gds-list-flt.
     3011        release gds-list-flt .
     3012       run str/fext-gds.w
     3013           ( parparentproc ,
     3014           v-cntxt-host-code-obj,
     3015           v-cntxt-obj-type,
     3016           v-cntxt-obj-code
     3017           ).
     3018       if not can-find (first gds-list-flt ) then  do:
     3019           create gds-list-flt.
     3020           gds-list-flt.gds-code = 0 .
     3021           release gds-list-flt .
     3022           message "Расширенный фильтр пуст!" view-as alert-box information .
     3023       end.
     3024       b-filter-ext:LOAD-IMAGE ("cmp/b-sche.bmp") .
     3025       find last gds-list-flt-hist.
     3026        b-filter-ext:tooltip =  gds-list-flt-hist.des .
     3027     end.
     3028     else do:
     3029        b-filter-ext:LOAD-IMAGE ("cmp/b-schef.bmp") .
     3030        b-filter-ext:tooltip = "Расширенный фильтр не установлен" .
     3031     end.
     3032     run OpenBr in this-procedure ( yes, no, '':U ) .
     3033   END.
     3034   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     3035   DO:
     3036     if available buf_contract-specif then DO:
     3037        run str/contsp-c.w (
     3038                input parparentproc,
     3039                input buf_contract-specif.host-code,
     3040                input buf_contract-specif.contract-num,
