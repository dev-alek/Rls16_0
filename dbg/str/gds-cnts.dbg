     1932   PROCEDURE write-retro-bonus :
     1933   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     1934   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     1935   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     1936   define input  parameter v-retro-bonus as character   no-undo .
     1937     do
     1938     on error undo, return error return-value
     1939     :
     1940       find first ub.contract-specif-attr exclusive-lock  where
     1941                 ub.contract-specif-attr.contract-num = p-contract-num  and
     1942                 ub.contract-specif-attr.host-code    = p-host-code     and
     1943                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     1944                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     1945                 no-error .
     1946         if not available ub.contract-specif-attr then do:
     1947            create ub.contract-specif-attr .
     1948            assign
     1949                 ub.contract-specif-attr.contract-num = p-contract-num
     1950                 ub.contract-specif-attr.host-code    = p-host-code
     1951                 ub.contract-specif-attr.gds-code     = p-gds-code
     1952                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     1953            .
     1954            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     1955            if error-status:error then
     1956               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     1957         end.
     1958         else do:
     1959            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     1960            if error-status:error then
     1961               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     1962         end.
     1963       find first ub.contract-specif exclusive-lock where
     1964           ub.contract-specif.contract-num = p-contract-num and
     1965           ub.contract-specif.host-code    = p-host-code    and
     1966           ub.contract-specif.gds-code     = p-gds-code.
     1967           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     1968   end.
     1969   END PROCEDURE.
