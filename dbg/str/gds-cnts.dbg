     3318   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3319   on help of frame Dialog-Frame
     3320   do:
     3321     run gbl/app_help.p
     3322       (input this-procedure :file-name
     3323       ,input ''
     3324       ,input ?
     3325       ) no-error.
     3326     if error-status :error then do:
     3327       message
     3328         "Ошибка при вызове помощи"
     3329         error-status :get-message(1)
