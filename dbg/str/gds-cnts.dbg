     2898     message "Вы действительно хотите изменить % по спецификации ?" view-as alert-box QUESTION BUTTONS YES-NO UPDATE g-log .
     2899     if g-log = no then return no-apply.
     2900     assign FILL-prc-2 .
     2901       do transaction :
     2902       for each  contract-specif exclusive-lock where
     2903                 contract-specif.host-code = p-host-code and
     2904                 contract-specif.contract-num = p-doc-num
     2905       , first temp-trn-doc where  ( r-2 = 1 or contract-specif.gds-code = temp-trn-doc.gds-code ) :
     2906         run write-prc-min in this-procedure (
     2907             contract-specif.contract-num  ,
     2908             contract-specif.host-code     ,
     2909             contract-specif.gds-code      ,
     2910             FILL-prc-2 ).
     2911       end.
     2912       assign
     2913       is-new = yes
     2914       .
     2915     end.
     2916     run openbr in this-procedure (yes, no, '':u).
     2917   END.
