     2024   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2025   procedure correct-message :
     2026   define input  parameter p-longchar as longchar no-undo .
     2027   define variable v-longchar as longchar no-undo .
     2028   define variable v-err-ext  as logical  no-undo .
     2029     do
     2030     on error undo, return error return-value
     2031     :
     2032      run get-long-message in this-procedure  (output v-longchar ).
     2033       v-longchar = v-longchar + p-longchar.
     2034       v-err-ext  = true .
     2035       run set-long-message  in this-procedure  (input v-longchar,  input v-err-ext ).
     2036     end.
     2037   end procedure.
     2038   define variable v-longchar as longchar no-undo .
     2039   define variable v-err-ext as logical   no-undo .
     2040   procedure get-long-message  :
     2041   define output parameter p-longchar  as longchar no-undo .
     2042     do
     2043     on error undo, return error return-value
     2044     :
     2045        p-longchar = v-longchar .
     2046     end.
     2047   end procedure.
     2048   procedure set-long-message :
     2049   define input  parameter  p-longchar as longchar   no-undo .
     2050   define input  parameter  p-err-ext as logical   no-undo .
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       v-longchar  =  p-longchar .
     2055       v-err-ext   =  p-err-ext  .
     2056     end.
     2057   end procedure.
     2058   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2059   define new global shared variable g#attr-lib  as handle no-undo .
     2060   define variable v-attr-lib-variable as handle no-undo .
     2061   procedure assmatat-code :
     2062     define input  parameter p-code           as character no-undo .
     2063     define output parameter p-type           as character no-undo .
     2064     define output parameter p-format         as character no-undo .
     2065     define output parameter p-label          as character no-undo .
     2066     define output parameter p-user-can-edit  as logical   no-undo .
     2067     define output parameter p-output-display as logical   no-undo .
     2068     define output parameter p-other          as character no-undo .
     2069     do
     2070     on error undo, return error
     2071     :
     2072           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run assmatat-code in g#attr-lib
     2073         (input  p-code
     2074         ,output p-type
     2075         ,output p-format
     2076         ,output p-label
     2077         ,output p-user-can-edit
     2078         ,output p-output-display
     2079         ,output p-other
     2080         ) no-error .
     2081       if error-status :error
     2082       then do:
     2083         undo, return error return-value .
     2084       end.
