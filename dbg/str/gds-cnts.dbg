     1093   procedure uf-get :
     1094     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1095     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1096     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1097     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1098     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1099     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1100     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1101     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1102     do
     1103     on error undo, return error
     1104     :
     1105       define buffer buf_usr-flt for ubflt.usr-flt .
     1106       define variable v-use-List_     as logical   no-undo .
     1107       define variable v-type-List_     as character no-undo .
     1108       define variable v-format-List_   as character no-undo .
     1109       define variable v-use-Naim      as logical   no-undo .
     1110       define variable v-type-Naim      as character no-undo .
     1111       define variable v-format-Naim    as character no-undo .
     1112       define variable v-use-print-graft as logical   no-undo .
     1113       define variable v-use-sort-gr     as logical   no-undo .
     1114       define variable v-use-type-price  as logical   no-undo .
     1115       define variable v-use-type-val    as logical   no-undo .
     1116       define variable v-label          as character no-undo .
     1117       define variable v-tooltip        as character no-undo .
     1118       define variable v-user-can-edit  as logical   no-undo .
     1119       define variable v-output-display as logical   no-undo .
     1120       define variable v-other          as character no-undo .
     1121       run uf-name in this-procedure
     1122          (input  entry(1, p-code, chr(4))
     1123         ,output v-use-List_
     1124         ,output v-type-List_
     1125         ,output v-format-List_
     1126         ,output v-use-Naim
     1127         ,output v-type-Naim
     1128         ,output v-format-Naim
     1129         ,output v-use-print-graft
     1130         ,output v-use-sort-gr
     1131         ,output v-use-type-price
     1132         ,output v-use-type-val
     1133         ,output v-label
     1134         ,output v-tooltip
     1135         ,output v-user-can-edit
     1136         ,output v-output-display
     1137         ,output v-other
     1138         ) no-error .
     1139       if error-status :error then do:
     1140         undo, return error return-value .
     1141       end.
     1142       find first buf_usr-flt no-lock where
     1143                  buf_usr-flt.Call-point     = p-code AND
     1144                  buf_usr-flt.user-name       = p-user-name
     1145         no-error .
     1146       if avail buf_usr-flt then do:
     1147         assign
     1148         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1149         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1150         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1151         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1152         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1153         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1154         .
     1155       end.
     1156       else do:
     1157         assign
     1158         p-List_        = (if v-use-List_       then "":U                    else ?)
     1159         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1160         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1161         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1162         p-type-price   = (if v-use-type-price  then no                      else ?)
     1163         p-type-val     = (if v-use-List_       then no                      else ?)
     1164         .
     1165       end.
     1166     end.
     1167   end procedure.
     1168   procedure uf-set :
     1169     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1170     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1171     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1172     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1173     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1174     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1175     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1176     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1177     do
     1178     on error undo, return error
     1179     :
     1180       define buffer buf_usr-flt for ubflt.usr-flt .
     1181       define variable v-use-List_     as logical   no-undo .
     1182       define variable v-type-List_     as character no-undo .
     1183       define variable v-format-List_   as character no-undo .
     1184       define variable v-use-Naim      as logical   no-undo .
     1185       define variable v-type-Naim      as character no-undo .
     1186       define variable v-format-Naim    as character no-undo .
     1187       define variable v-use-print-graft as logical   no-undo .
     1188       define variable v-use-sort-gr   as logical   no-undo .
     1189       define variable v-use-type-price as logical   no-undo .
     1190       define variable v-use-type-val  as logical   no-undo .
     1191       define variable v-tooltip        as character no-undo .
     1192       define variable v-label          as character no-undo .
     1193       define variable v-user-can-edit  as logical   no-undo .
     1194       define variable v-output-display as logical   no-undo .
     1195       define variable v-other          as character no-undo .
     1196       run uf-name in this-procedure
     1197         (input  entry(1, p-code, chr(4))
     1198         ,output v-use-List_
     1199         ,output v-type-List_
     1200         ,output v-format-List_
     1201         ,output v-use-Naim
     1202         ,output v-type-Naim
     1203         ,output v-format-Naim
     1204         ,output v-use-print-graft
     1205         ,output v-use-sort-gr
     1206         ,output v-use-type-price
     1207         ,output v-use-type-val
     1208         ,output v-label
     1209         ,output v-tooltip
     1210         ,output v-user-can-edit
     1211         ,output v-output-display
     1212         ,output v-other
     1213         ) no-error .
     1214       if error-status :error then do:
     1215         undo, return error return-value .
     1216       end.
     1217       find first buf_usr-flt where
     1218                  buf_usr-flt.Call-point     = p-code AND
     1219                  buf_usr-flt.user-name       = p-user-name
     1220         no-error .
     1221       if not avail buf_usr-flt then do:
     1222           create buf_usr-flt .
     1223           assign
     1224           buf_usr-flt.call-point = p-code
     1225           buf_usr-flt.user-name  = p-user-name
     1226           .
     1227       end.
     1228       if avail buf_usr-flt then do:
     1229        assign
     1230        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1231        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1232        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1233        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1234        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1235        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1236       .
     1237       release buf_usr-flt.
     1238       end.
     1239       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1240     end.
     1241   end procedure.
     1242   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1243     define variable v-cntxt-db-num        as integer   no-undo .
     1244     define variable v-cntxt-userid        as character no-undo .
     1245     define variable v-cntxt-level         as character no-undo .
     1246     define variable v-cntxt-host-code-obj as integer   no-undo .
     1247     define variable v-cntxt-obj-type      as character no-undo .
     1248     define variable v-cntxt-obj-code      as integer   no-undo .
     1249     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1250     define variable v-cntxt-is-admin      as logical   no-undo .
     1251   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1252   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1253   procedure fltopend_fltopend :
     1254   define input parameter p-parent-handle as handle no-undo .
     1255   define input parameter p-qh as handle no-undo .
     1256   define input parameter p-flt-open-open-query  as character no-undo .
     1257   define input parameter p-where-cond as character no-undo .
     1258   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1259   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1260   define input parameter p-indexed-reposition as character no-undo .
     1261     do
     1262     on error undo, return error
     1263     :
     1264   define variable v-prepare-string as character no-undo .
     1265   define variable glog as logical no-undo .
     1266   assign
     1267   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1268                      p-where-cond + chr(32)  +
     1269                      p-use-indFIRST-query-tail + chr(32) +
     1270                      p-use-ind-sort-clmn-by + chr(32) +
     1271                      p-indexed-reposition
     1272   .
     1273   assign
     1274   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1275   if not glog
     1276   or error-status:error then do:
     1277     message error-status:get-message(1) view-as alert-box .
     1278     undo, return error .
     1279   end.
     1280   assign
     1281   glog = p-qh:query-open no-error .
     1282   if not glog
     1283   or error-status:error then do:
     1284     message error-status:get-message(1) view-as alert-box .
     1285     undo, return error .
     1286   end.
     1287     end.
     1288   end procedure.
     1289   procedure fltopend_fltfindd :
     1290   define input parameter p-parent-handle as handle no-undo .
     1291   define input parameter p-qh as handle no-undo .
     1292   define input parameter p-rowid as rowid no-undo .
     1293   define input parameter p-next as logical no-undo .
     1294   define input parameter p-lock as integer no-undo .
     1295   define input parameter p-bh as handle no-undo .
     1296   define input parameter p-where-cond as character no-undo .
     1297   define input parameter p-use-index-phrase as character no-undo .
     1298   define variable glog as logical no-undo .
     1299   define variable v-qh as handle no-undo .
     1300   define variable v-bh as handle no-undo .
     1301   define variable v-recid as recid no-undo .
     1302   define variable v-prepare-string as character no-undo .
     1303   do
     1304   on error undo, return error
     1305   on stop undo, return error
     1306   :
     1307     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1308     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1309     create query v-qh.
     1310     v-qh:set-buffers(v-bh).
     1311     v-prepare-string = substitute("for each &1 &2 &3"
     1312                                     ,v-bh:name
     1313                                     ,p-where-cond
     1314                                     ,p-use-index-phrase).
     1315     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1316     if not glog then do:
     1317       delete object v-qh.
     1318       delete object v-bh.
     1319       undo, return error .
     1320     end.
     1321     glog = v-qh:query-open no-error .
     1322     if not glog then do:
     1323       delete object v-qh.
     1324       delete object v-bh.
     1325       undo, return error .
     1326     end.
     1327     if p-next then do:
     1328       v-qh:reposition-to-rowid(p-rowid) no-error .
     1329       glog = v-qh:get-next( p-lock) no-error .
     1330       glog = v-qh:get-next( p-lock) no-error .
     1331       if not glog or v-qh:query-off-end = yes then do:
     1332         glog = v-qh:get-first( p-lock) no-error .
     1333       end.
     1334     end.
     1335     else do:
     1336       glog = v-qh:get-first( p-lock) no-error .
     1337     end.
     1338     v-recid = v-bh:recid no-error .
     1339     delete object v-qh.
     1340     delete object v-bh.
     1341     return string(v-recid) .
     1342   end.
     1343   end procedure.
     1344   procedure fltopend_fltfindq :
     1345   define input parameter p-parent-handle as handle no-undo .
     1346   define input parameter p-qh as handle no-undo .
     1347   define input parameter p-next as logical no-undo .
     1348   define input parameter p-lock as integer no-undo .
     1349   define input parameter p-flt-open-open-query  as character no-undo .
     1350   define input parameter p-where-cond as character no-undo .
     1351   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1352   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1353   define input parameter p-indexed-reposition as character no-undo .
     1354   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1355   define variable glog as logical no-undo .
     1356   define variable v-qh as handle no-undo .
     1357   define variable v-bh as handle no-undo extent 18.
     1358   define variable v-rowid as rowid no-undo extent 18.
     1359   define variable v-ii as integer no-undo .
     1360   define variable v-prepare-string as character no-undo .
     1361   do
     1362   on error undo, return error
     1363   on stop undo, return error
     1364   :
     1365     create query v-qh.
     1366     do v-ii = 1 to p-qh:num-buffers:
     1367       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1368       assign
     1369       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1370       no-error.
     1371       v-qh:add-buffer(v-bh[v-ii]).
     1372     end.
     1373     assign
     1374     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1375                       p-where-cond + chr(32)  +
     1376                       p-use-indFIRST-query-tail + chr(32) +
     1377                       p-use-ind-sort-clmn-by + chr(32) +
     1378                       p-indexed-reposition
     1379     .
     1380     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1381     if not glog then do:
     1382       delete object v-qh.
     1383       do v-ii = 1 to p-qh:num-buffers:
     1384         delete object v-bh[v-ii].
     1385       end.
     1386       undo, return error .
     1387     end.
     1388     glog = v-qh:query-open no-error .
     1389     if not glog then do:
     1390       delete object v-qh.
     1391       do v-ii = 1 to p-qh:num-buffers:
     1392         delete object v-bh[v-ii].
     1393       end.
     1394       undo, return error .
     1395     end.
     1396     if p-next then do:
     1397       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1398       glog = v-qh:get-next( p-lock) no-error .
     1399       glog = v-qh:get-next( p-lock) no-error .
     1400       if not glog or v-qh:query-off-end = yes then do:
     1401         glog = v-qh:get-first( p-lock) no-error .
     1402       end.
     1403     end.
     1404     else do:
     1405       glog = v-qh:get-first( p-lock) no-error .
     1406     end.
     1407     do v-ii = 1 to p-qh:num-buffers:
     1408       assign
     1409       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1410       no-error.
     1411     end.
     1412     delete object v-qh.
     1413     do v-ii = 1 to p-qh:num-buffers:
     1414       delete object v-bh[v-ii].
     1415     end.
     1416   end.
     1417   end procedure.
     1418   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1419   procedure ass-grp-gds-code-yes :
     1420   define input  parameter p-gds-code   as integer   no-undo .
     1421   define input  parameter p-node-code  as integer   no-undo .
     1422   define input  parameter p-id         as integer   no-undo .
     1423   define input  parameter p-db-num     as integer   no-undo .
     1424   define output parameter p-ask        as logical   no-undo .
     1425   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1426   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1427   define buffer buf_goods   for ub.goods  .
     1428   define buffer buf_gds-grp for ub.gds-grp  .
     1429   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
     1430   define variable v-grp-qnty as integer   no-undo .
     1431   define variable v-grp-lim as integer   no-undo .
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435   p-ask = ? .
     1436   find first  ub.assortment-matrix no-lock where
     1437               ub.assortment-matrix.asmt-id  = p-id and
     1438               ub.assortment-matrix.db-num   = p-db-num and
     1439               ub.assortment-matrix.asmt-type =  'Шаблон':U
     1440               no-error .
     1441   if available ub.assortment-matrix then do:
     1442     p-ask = true .
     1443     return .
     1444   end.
     1445   find first buf_gds-obj-prop no-lock where
     1446             buf_gds-obj-prop.gds-code = p-gds-code and
     1447             buf_gds-obj-prop.obj-type = ub.assortment-matrix.obj-type and
     1448             buf_gds-obj-prop.obj-code = ub.assortment-matrix.obj-code and
     1449             buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U no-error .
     1450   if available buf_gds-obj-prop then do:
     1451     p-ask = true .
     1452     return .
     1453   end.
     1454   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
     1455   find first buf_gds-grp-obj-attr no-lock where
     1456              buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U and
     1457              buf_gds-grp-obj-attr.obj-type  = string(p-id) and
     1458              buf_gds-grp-obj-attr.obj-code  = p-db-num and
     1459              buf_gds-grp-obj-attr.host-code = 0 and
     1460              buf_gds-grp-obj-attr.node-code = p-node-code no-error .
     1461   if error-status :error then do:
     1462     p-ask = true .
     1463     return .
     1464   end.
     1465   if buf_gds-grp-obj-attr.attr-value  = "0" then do:
     1466     p-ask = false  .
     1467     return .
     1468   end.
     1469     if buf_gds-grp-obj-attr.attr-value  = "" or
     1470       buf_gds-grp-obj-attr.attr-value  = ?  or
     1471       buf_gds-grp-obj-attr.attr-value  = "?" then do:
     1472       find first buf_gds-grp no-lock where
     1473                   buf_gds-grp.node-code = p-node-code no-error .
     1474         if available buf_gds-grp  then do:
     1475             if buf_gds-grp.upper-code = 0 then do:
     1476                 p-ask = true .
     1477                 return .
     1478             end.
     1479             else do:
     1480                 run ass-grp-gds-code-yes (
     1481                    input   p-gds-code
     1482                   ,input   buf_gds-grp.upper-code
     1483                   ,input   p-id
     1484                   ,input   p-db-num
     1485                   ,output  p-ask
     1486                   ).
     1487                 if p-ask <> ? then return .
     1488           end.
     1489         end.
     1490     end.
     1491     else do:
     1492       v-grp-lim = int (buf_gds-grp-obj-attr.attr-value) no-error  .
     1493       if v-grp-lim > 0 then do:
     1494           v-grp-qnty = 0 .
     1495           find first buf1_gds-grp-obj-attr no-lock where
     1496                      buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
     1497                      buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
     1498                      buf1_gds-grp-obj-attr.obj-code  = p-db-num and
     1499                      buf1_gds-grp-obj-attr.host-code = 0 and
     1500                      buf1_gds-grp-obj-attr.node-code = p-node-code no-error .
     1501           if available buf1_gds-grp-obj-attr then do:
     1502             v-grp-qnty = int(buf1_gds-grp-obj-attr.attr-value) .
     1503           end.
     1504           if v-grp-lim >= v-grp-qnty + 1 then p-ask = true .
     1505           else p-ask = false .
     1506           return .
     1507       end.
     1508     end.
     1509     end.
     1510   end procedure.
     1511   procedure recalc-gds-assgrp :
     1512   define input  parameter p-action     as character no-undo .
     1513   define input  parameter p-gds-code  as integer   no-undo .
     1514   define input  parameter p-node-code  as integer   no-undo .
     1515   define input  parameter p-id         as integer   no-undo .
     1516   define input  parameter p-db-num     as integer   no-undo .
     1517   define buffer buf_gds-grp for ub.gds-grp  .
     1518   define buffer curr_gds-grp for ub.gds-grp  .
     1519   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1520   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
     1521   define variable kk as character no-undo .
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525   find first  ub.assortment-matrix no-lock where
     1526               ub.assortment-matrix.asmt-id  = p-id and
     1527               ub.assortment-matrix.db-num   = p-db-num and
     1528               ub.assortment-matrix.asmt-type =  'Шаблон':U
     1529               no-error .
     1530       if available ub.assortment-matrix then do:
     1531         return .
     1532       end.
     1533       find first buf_gds-obj-prop no-lock where
     1534                  buf_gds-obj-prop.gds-code = p-gds-code and
     1535                  buf_gds-obj-prop.obj-type = ub.assortment-matrix.obj-type and
     1536                  buf_gds-obj-prop.obj-code = ub.assortment-matrix.obj-code and
     1537                  buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U
     1538                  no-error .
     1539       if available buf_gds-obj-prop then do:
     1540         if p-action <> '--' then  do:
     1541            return .
     1542         end.
     1543       end.
     1544       find first buf1_gds-grp-obj-attr exclusive-lock where
     1545                  buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
     1546                  buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
     1547                  buf1_gds-grp-obj-attr.obj-code  = p-db-num and
     1548                  buf1_gds-grp-obj-attr.host-code = 0 and
     1549                  buf1_gds-grp-obj-attr.node-code = p-node-code
     1550                  no-error .
     1551       if available buf1_gds-grp-obj-attr then do:
     1552          if p-action = '+' then  do:
     1553             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) + 1 ).
     1554          end.
     1555          else do:
     1556             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) - 1 ).
     1557          end.
     1558          buf1_gds-grp-obj-attr.attr-value = kk .
     1559       end.
     1560       else do:
     1561           if p-action = '+' then  do:
     1562               create buf1_gds-grp-obj-attr .
     1563                 assign
     1564                   buf1_gds-grp-obj-attr.attr-code  = 'QntyAssMat':U
     1565                   buf1_gds-grp-obj-attr.obj-type   = string(p-id)
     1566                   buf1_gds-grp-obj-attr.obj-code   = p-db-num
     1567                   buf1_gds-grp-obj-attr.host-code  = 0
     1568                   buf1_gds-grp-obj-attr.node-code  = p-node-code
     1569                   buf1_gds-grp-obj-attr.attr-value = "1"
     1570                 .
     1571           end.
     1572       end.
     1573      FIND FIRST curr_gds-grp WHERE
     1574                 curr_gds-grp.node-code = p-node-code
     1575           NO-LOCK NO-ERROR.
     1576      if AVAILABLE curr_gds-grp AND curr_gds-grp.upper-code > 0 then do:
     1577         run recalc-gds-assgrp (p-action ,p-gds-code , curr_gds-grp.upper-code,p-id,p-db-num ) .
     1578      end.
     1579     end.
     1580   end procedure.
     1581   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1582   procedure SpecGr-gds-code-yes :
     1583   define input  parameter p-gds-code   as integer   no-undo .
     1584   define input  parameter p-node-code  as integer   no-undo .
     1585   define input  parameter p-contract-num         as integer   no-undo .
     1586   define input  parameter p-host-code     as integer   no-undo .
     1587   define output parameter p-ask        as logical   no-undo .
     1588   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1589   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1590   define buffer buf_goods   for ub.goods  .
     1591   define buffer buf_gds-grp for ub.gds-grp  .
     1592   define variable v-grp-qnty as integer   no-undo .
     1593   define variable v-grp-lim as integer   no-undo .
     1594     do
     1595     on error undo, return error return-value
     1596     :
     1597   p-ask = ? .
     1598   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
     1599   find first buf_gds-grp-obj-attr no-lock where
     1600              buf_gds-grp-obj-attr.attr-code = 'LimSpecGr':U and
     1601              buf_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
     1602              buf_gds-grp-obj-attr.obj-code  = p-host-code and
     1603              buf_gds-grp-obj-attr.host-code = 0 and
     1604              buf_gds-grp-obj-attr.node-code = p-node-code no-error .
     1605   if error-status :error then do:
     1606     p-ask = true .
     1607     return .
     1608   end.
     1609   if buf_gds-grp-obj-attr.attr-value  = "0" then do:
     1610     p-ask = false  .
     1611     return .
     1612   end.
     1613     if buf_gds-grp-obj-attr.attr-value  = "" or
     1614       buf_gds-grp-obj-attr.attr-value  = ?  or
     1615       buf_gds-grp-obj-attr.attr-value  = "?" then do:
     1616       find first buf_gds-grp no-lock where
     1617                   buf_gds-grp.node-code = p-node-code no-error .
     1618         if available buf_gds-grp  then do:
     1619             if buf_gds-grp.upper-code = 0 then do:
     1620                 p-ask = true .
     1621                 return .
     1622             end.
     1623             else do:
     1624                 run SpecGr-gds-code-yes (
     1625                    input   p-gds-code
     1626                   ,input   buf_gds-grp.upper-code
     1627                   ,input   p-contract-num
     1628                   ,input   p-host-code
     1629                   ,output  p-ask
     1630                   ).
     1631                 if p-ask <> ? then return .
     1632           end.
     1633         end.
     1634     end.
     1635     else do:
     1636       v-grp-lim = int (buf_gds-grp-obj-attr.attr-value) no-error  .
     1637       if v-grp-lim > 0 then do:
     1638           v-grp-qnty = 0 .
     1639           find first buf1_gds-grp-obj-attr no-lock where
     1640                      buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
     1641                      buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
     1642                      buf1_gds-grp-obj-attr.obj-code  = p-host-code and
     1643                      buf1_gds-grp-obj-attr.host-code = 0 and
     1644                      buf1_gds-grp-obj-attr.node-code = p-node-code no-error .
     1645           if available buf1_gds-grp-obj-attr then do:
     1646             v-grp-qnty = int(buf1_gds-grp-obj-attr.attr-value) .
     1647           end.
     1648           if v-grp-lim >= v-grp-qnty + 1 then p-ask = true .
     1649           else p-ask = false .
     1650           return .
     1651       end.
     1652     end.
     1653     end.
     1654   end procedure.
     1655   procedure recalc-gds-SpecGr :
     1656   define input  parameter p-action     as character no-undo .
     1657   define input  parameter p-node-code  as integer   no-undo .
     1658   define input  parameter p-contract-num         as integer   no-undo .
     1659   define input  parameter p-host-code     as integer   no-undo .
     1660   define buffer buf_gds-grp for ub.gds-grp  .
     1661   define buffer curr_gds-grp for ub.gds-grp  .
     1662   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1663   define variable kk as character no-undo .
     1664     do
     1665     on error undo, return error return-value
     1666     :
     1667       find first buf1_gds-grp-obj-attr exclusive-lock where
     1668                  buf1_gds-grp-obj-attr.attr-code = 'QntySpecGr':U and
     1669                  buf1_gds-grp-obj-attr.obj-type  = string(p-contract-num) and
     1670                  buf1_gds-grp-obj-attr.obj-code  = p-host-code and
     1671                  buf1_gds-grp-obj-attr.host-code = 0 and
     1672                  buf1_gds-grp-obj-attr.node-code = p-node-code
     1673                  no-error .
     1674       if available buf1_gds-grp-obj-attr then do:
     1675          if p-action = '+' then  do:
     1676             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) + 1 ).
     1677          end.
     1678          else do:
     1679             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) - 1 ).
     1680          end.
     1681          buf1_gds-grp-obj-attr.attr-value = kk .
     1682       end.
     1683       else do:
     1684           if p-action = '+' then  do:
     1685               create buf1_gds-grp-obj-attr .
     1686                 assign
     1687                   buf1_gds-grp-obj-attr.attr-code  = 'QntySpecGr':U
     1688                   buf1_gds-grp-obj-attr.obj-type   = string(p-contract-num)
     1689                   buf1_gds-grp-obj-attr.obj-code   = p-host-code
     1690                   buf1_gds-grp-obj-attr.host-code  = 0
     1691                   buf1_gds-grp-obj-attr.node-code  = p-node-code
     1692                   buf1_gds-grp-obj-attr.attr-value = "1"
     1693                 .
     1694           end.
     1695       end.
     1696      FIND FIRST curr_gds-grp WHERE
     1697                 curr_gds-grp.node-code = p-node-code
     1698           NO-LOCK NO-ERROR.
     1699      if AVAILABLE curr_gds-grp AND curr_gds-grp.upper-code > 0 then do:
     1700         run recalc-gds-SpecGr (p-action ,curr_gds-grp.upper-code,p-contract-num,p-host-code ) .
     1701      end.
     1702     end.
     1703   end procedure.
     1704   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1705   procedure spedlass-proc :
     1706   define input  parameter parParentProc   as handle no-undo .
     1707   define input  parameter p-gds-code      as integer   no-undo .
     1708   define input  parameter p-contract-code as integer   no-undo .
     1709   define input  parameter p-host-code     as integer   no-undo .
     1710   define input  parameter p-ask           as logical   no-undo .
     1711   define input-output     parameter v-list-mat as character no-undo .
     1712   define input-output     parameter v-err-ext  as logical   no-undo .
     1713   define input-output     parameter v-longchar as longchar no-undo .
     1714   define buffer buf_contract-specif for ub.contract-specif  .
     1715   define buffer buf_contract        for ub.contract  .
     1716   define variable v-log as logical   no-undo .
     1717     do
     1718     on error undo, return error return-value
     1719     :
     1720   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1721   do:
     1722     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1723       (input  v-cntxt-db-num
     1724       ,input  v-cntxt-userid
     1725       ,input  0
     1726       ,input  'actn_assort-matr-gds_deletion':U
     1727       ,input  'global':U
     1728       ,input  0
     1729       ,input  '':U
     1730       ,input  0
     1731       ,input  0
     1732       ,input  0
     1733       ,input  0
     1734       ,input  false
     1735       ,output v-log
     1736       )  .
     1737   end.
     1738    if not v-log then return  .
     1739       for each buf_contract-specif  no-lock where
     1740                buf_contract-specif.gds-code = p-gds-code  and not
     1741              ( buf_contract-specif.contract-num  = p-contract-code and
     1742                buf_contract-specif.host-code     = p-host-code ) ,
     1743               first buf_contract no-lock where
     1744                     buf_contract.contract-code = buf_contract.contract-code and
     1745                     buf_contract.host-code     = buf_contract.host-code    and
     1746                     buf_contract.status_       =  'тек':U
     1747                       :
     1748                       return .
     1749       end.
     1750   define variable v-ass-m as logical   no-undo init false .
     1751   if can-find ( first ub.assortment-matrix no-lock where
     1752                       ub.assortment-matrix.asmt-status = integer ('0':U))
     1753                       then v-ass-m = true.
     1754   if p-ask then do:
     1755       if v-ass-m = true then do:
     1756         message "Удалить товары спецификации из Ассортиментных матриц ?"
     1757                 "Если ДА , укажите в каких."
     1758                 view-as alert-box question
     1759                         buttons yes-no
     1760                         update v-okk as logical
     1761                         .
     1762         if v-okk then do:
     1763             run ref/assmatr.w (
     1764                   input parParentProc
     1765                   ,input "b-sel,b-mark"
     1766                   ,input v-cntxt-obj-type
     1767                   ,input v-cntxt-obj-code
     1768                   ,input ?
     1769                   ,input ?
     1770                   ,input-output v-list-mat
     1771                   ) no-error  .
     1772             if error-status :error then message
     1773               vss-workfile vss-revision vss-description skip
     1774               error-status :get-message(1) skip
     1775               return-value skip
     1776               ""
     1777               view-as alert-box error
     1778             .
     1779         end.
     1780       end.
     1781   end.
     1782   if num-entries(v-list-mat) = 0 then return .
     1783   define buffer buf_gds-obj-prop          for ub.gds-obj-prop  .
     1784   define buffer buf_assortment-matrix     for ub.assortment-matrix  .
     1785   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
     1786   define variable i as integer   no-undo .
     1787   define variable v-sts as integer   no-undo .
     1788   repeat i = 1 to num-entries(v-list-mat) :
     1789     find first buf_assortment-matrix no-lock where
     1790                recid(buf_assortment-matrix) = int(entry(i,v-list-mat)) no-error .
     1791     for each buf_assortment-matrix-goods no-lock where
     1792              buf_assortment-matrix-goods.asmt-id  = buf_assortment-matrix.asmt-id and
     1793              buf_assortment-matrix-goods.db-num   = buf_assortment-matrix.db-num  and
     1794              buf_assortment-matrix-goods.gds-code = p-gds-code
     1795              :
     1796       for each buf_gds-obj-prop exclusive-lock where
     1797               buf_gds-obj-prop.obj-type = buf_assortment-matrix.obj-type and
     1798               buf_gds-obj-prop.obj-code = buf_assortment-matrix.obj-code and
     1799               buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code
     1800               :
     1801               if not (buf_gds-obj-prop.gdop-igt = 'Пусто':U or
     1802                       buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U ) then do:
     1803                 v-err-ext = true .
     1804                 v-longchar = v-longchar +
     1805                 substitute("Принудительная смена ИЖТ &1 на ПУСТО у товара &2 на объекте &3 &4&5" ,
     1806                   buf_gds-obj-prop.gdop-igt ,
     1807                   buf_gds-obj-prop.gds-code ,
     1808                   buf_assortment-matrix.obj-type ,
     1809                   buf_assortment-matrix.obj-code , chr(10) )   .
     1810               assign
     1811                 buf_gds-obj-prop.gdop-igt = 'Пусто':U
     1812                 .
     1813               end.
     1814       end.
     1815       release buf_gds-obj-prop .
     1816       if buf_assortment-matrix-goods.asmg-status = int('0':U) then do:
     1817           v-sts = int('1':U) .
     1818   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     1819    (input this-procedure
     1820    ,input recid(buf_assortment-matrix-goods)
     1821    ,input-output v-sts
     1822    ,input no
     1823     ) no-error .
     1824              if error-status :error then message
     1825                 error-status :get-message(1)
     1826                 return-value
     1827                 "Ошибка изменения статуса товара в ассортиментной матрице" skip
     1828                 buf_assortment-matrix-goods.asmg-status  v-sts
     1829                 .
     1830       end.
     1831     end.
     1832   end.
     1833   end.
     1834   end procedure.
