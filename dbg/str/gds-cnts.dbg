     2235   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2236   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2237   DEFINE VARIABLE vss-include-info22 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     2238   FUNCTION indicator-life-gds-n RETURNS CHARACTER ( input p-rec as recid ) FORWARD.
     2239   DEFINE VARIABLE v-gl-iProc-Otkl AS DECIMAL NO-UNDO INITIAL 0.
     2240   DEFINE VARIABLE v-gl-lAM-Is-Obj         AS LOGICAL NO-UNDO INITIAL FALSE.
     2241   DEFINE VARIABLE v-gl-iAM-Gds-All        AS INTEGER NO-UNDO INITIAL 0.
     2242   DEFINE VARIABLE v-gl-iAM-Sbl-Gds-All    AS INTEGER NO-UNDO INITIAL 0.
     2243   DEFINE VARIABLE v-gl-iAM-Gds-Vyv        AS INTEGER NO-UNDO INITIAL 0.
     2244   DEFINE VARIABLE v-gl-lAM-Ref-Shablon    AS LOGICAL NO-UNDO INITIAL FALSE.
     2245   DEFINE VARIABLE v-gl-dAM-Proc-Otkl      AS DECIMAL NO-UNDO INITIAL 0.
     2246   DEFINE VARIABLE v-gl-dAM-Proc-Otkl-Ras  AS DECIMAL NO-UNDO INITIAL 0.
     2247   FUNCTION Is-Gds-In-AssMatr RETURN LOGICAL(
     2248      p-Gds-code AS INTEGER,
     2249      p-Asmt-id  AS INTEGER,
     2250      p-Db-num   AS INTEGER):
     2251      DEFINE BUFFER buf_Gds FOR Ub.Assortment-matrix-goods.
     2252      RETURN CAN-FIND(FIRST buf_Gds WHERE
     2253                            buf_Gds.Asmt-id     = p-Asmt-id
     2254                        AND buf_Gds.Db-num      = p-Db-num
     2255                        AND buf_Gds.Gds-code    = p-Gds-code
     2256                        AND buf_Gds.Asmg-status = INTEGER('0':U)
     2257                      NO-LOCK).
     2258   END FUNCTION.
     2259   PROCEDURE Get-Delta-Gds-2-Matrix:
     2260      DEFINE PARAMETER BUFFER buf_AM-1 FOR ub.Assortment-matrix.
     2261      DEFINE PARAMETER BUFFER buf_AM-2 FOR ub.Assortment-matrix.
     2262      DEFINE OUTPUT PARAMETER iDelta AS INTEGER NO-UNDO INITIAL 0.
     2263      DEFINE BUFFER buf_Gds-1 FOR ub.Assortment-matrix-goods.
     2264      DEFINE BUFFER buf_Gds-2 FOR ub.Assortment-matrix-goods.
     2265      FOR EACH buf_Gds-1 WHERE
     2266               buf_Gds-1.Asmt-id = buf_AM-1.Asmt-id
     2267           AND buf_Gds-1.Db-num  = buf_AM-1.Db-num
     2268           AND buf_Gds-1.Asmg-status = INTEGER('0':U)
     2269          NO-LOCK:
     2270          IF NOT CAN-FIND(FIRST buf_Gds-2 WHERE
     2271                                buf_Gds-2.Asmt-id     = buf_AM-2.Asmt-id
     2272                            AND buf_Gds-2.Db-num      = buf_AM-2.Db-num
     2273                            AND buf_Gds-2.Gds-code    = buf_Gds-1.Gds-code
     2274                            AND buf_Gds-2.Asmg-status = INTEGER('0':U)
     2275                            NO-LOCK) THEN DO:
     2276             ASSIGN
     2277                iDelta = iDelta + 1.
     2278          END.
     2279      END.
     2280      RETURN.
     2281   END PROCEDURE.
     2282   PROCEDURE Cntrl-AM-Add-1:
     2283      DEFINE INPUT PARAMETER iDelta  AS INTEGER   NO-UNDO.
     2284      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2285      IF v-gl-iProc-Otkl = 0      THEN RETURN.
     2286      IF NOT v-gl-lAM-Is-Obj      THEN RETURN.
     2287      IF NOT v-gl-lAM-Ref-Shablon THEN RETURN.
     2288      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(iDelta).
     2289      IF iDelta = 0 THEN DO:
     2290         IF v-gl-dAM-Proc-Otkl >= v-gl-iProc-Otkl THEN DO:
     2291            cError = "В данной матрице процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl) + ")" + chr(10) +
     2292                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl) +  ")." + chr(10) +
     2293                     "Добавление товаров невозможно !".
     2294         END.
     2295      END. ELSE DO:
     2296         IF v-gl-dAM-Proc-Otkl-Ras >= v-gl-iProc-Otkl THEN DO:
     2297            cError = "В данной матрице будущий расчетный процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl-Ras) + ")" + chr(10) +
     2298                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl ) +  ")." + chr(10) +
     2299                     " Добавление товаров невозможно !".
     2300         END.
     2301      END.
     2302      RETURN.
     2303   END PROCEDURE.
     2304   PROCEDURE Get-Gl-Param-Proc-Otkl:
     2305      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2306      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2307      DEFINE OUTPUT PARAMETER  cError    AS CHARACTER  NO-UNDO INITIAL "".
     2308      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2309      FIND FIRST buf_AM WHERE
     2310                 buf_AM.asmt-id = p-Asmt-id
     2311             AND buf_AM.db-num  = p-Db-num
     2312           NO-LOCK NO-ERROR.
     2313      IF NOT AVAILABLE buf_AM THEN DO:
     2314         cError = PROGRAM-NAME(1) +  ":Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2315         RETURN.
     2316      END.
     2317      RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
     2318          buf_AM.obj-type,
     2319          buf_AM.obj-code
     2320          ).
     2321      RUN Get-Gl-Param-AM-All in THIS-PROCEDURE(
     2322          buf_AM.Asmt-id,
     2323          buf_AM.db-num
     2324          ).
     2325      RETURN.
     2326   END PROCEDURE.
     2327   PROCEDURE Get-Gl-Param-AM-All:
     2328      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2329      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2330      DEFINE VARIABLE lIsAmObj    AS LOGICAL    NO-UNDO INITIAL FALSE.
     2331      DEFINE VARIABLE iSh-Asmt-id AS INTEGER    NO-UNDO INITIAL 0.
     2332      DEFINE VARIABLE iSh-Db-num  AS INTEGER    NO-UNDO INITIAL 0.
     2333      DEFINE VARIABLE cSh-Type    AS CHARACTER  NO-UNDO INITIAL "".
     2334      DEFINE VARIABLE cError      AS CHARACTER  NO-UNDO INITIAL "".
     2335      DEFINE VARIABLE dAmt        AS DECIMAL    EXTENT 2  NO-UNDO INITIAL 0.
     2336      DEFINE VARIABLE cMode       AS CHARACTER  NO-UNDO INITIAL "".
     2337      ASSIGN
     2338         v-gl-iAM-Gds-All     = 0
     2339         v-gl-iAM-Sbl-Gds-All = 0
     2340         v-gl-iAM-Gds-Vyv     = 0
     2341         v-gl-dAM-Proc-Otkl   = 0
     2342         v-gl-lAM-Ref-Shablon = FALSE
     2343         .
     2344      RUN Get-Param-AM IN THIS-PROCEDURE (
     2345          p-Asmt-id,
     2346          p-Db-num,
     2347          OUTPUT lIsAmObj,
     2348          OUTPUT iSh-Asmt-id,
     2349          OUTPUT iSh-Db-num,
     2350          OUTPUT cSh-Type,
     2351          OUTPUT cError
     2352          ).
     2353      IF cError <> "" THEN DO:
     2354         MESSAGE
     2355            PROGRAM-NAME(1) ":" SKIP
     2356            "Такого быть не должно !!!" SKIP
     2357            cError SKIP
     2358            VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2359         RETURN.
     2360      END.
     2361      ASSIGN
     2362         cMode                 = (IF lIsAmObj THEN "IL_GDS":U ELSE "")
     2363         v-gl-lAM-Ref-Shablon  = (IF iSh-Asmt-id = 0 THEN FALSE ELSE TRUE)
     2364         .
     2365      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2366          p-Asmt-Id,
     2367          p-Db-num,
     2368          '0':U,
     2369          cMode,
     2370          OUTPUT dAmt
     2371          ).
     2372      ASSIGN
     2373         v-gl-iAM-Gds-All = dAmt[1]
     2374         v-gl-iAM-Gds-Vyv = (IF lIsAmObj THEN dAmt[2] ELSE 0)
     2375         .
     2376       IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2377          RETURN.
     2378       END.
     2379      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2380          iSh-Asmt-id,
     2381          iSh-Db-num,
     2382          '0':U,
     2383          "",
     2384          OUTPUT dAmt
     2385          ).
     2386      ASSIGN
     2387         v-gl-iAM-Sbl-Gds-All = dAmt[1].
     2388      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(0).
     2389      RETURN.
     2390   END PROCEDURE.
     2391   PROCEDURE Get-Param-AM-Gds:
     2392      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2393      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2394      DEFINE INPUT PARAMETER   p-Stat    AS INTEGER    NO-UNDO.
     2395      DEFINE INPUT PARAMETER   p-Mode    AS CHARACTER  NO-UNDO.
     2396      DEFINE OUTPUT PARAMETER  o-dAmt    AS DECIMAL    EXTENT 2 NO-UNDO INITIAL 0.
     2397      DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
     2398      FOR EACH buf_AM-goods WHERE
     2399               buf_AM-goods.Asmt-id      = p-Asmt-Id
     2400           AND buf_AM-goods.Db-num       = p-Db-num
     2401           AND buf_AM-goods.asmg-status  = p-Stat
     2402          NO-LOCK:
     2403          ASSIGN
     2404             o-dAmt[1] = o-dAmt[1] + 1.
     2405          IF CAN-DO("IL_GDS":U, p-Mode) THEN DO:
     2406             IF Indicator-life-gds-n(recid(buf_AM-goods)) = 'На вывод из ассортимента':U THEN DO:
     2407                ASSIGN
     2408                   o-dAmt[2] = o-dAmt[2] + 1.
     2409             END.
     2410          END.
     2411      END.
     2412      RETURN.
     2413   END PROCEDURE.
     2414   PROCEDURE Get-Param-AM:
     2415      DEFINE INPUT  PARAMETER  p-Asmt-id   AS INTEGER   NO-UNDO.
     2416      DEFINE INPUT  PARAMETER  p-Db-num    AS INTEGER   NO-UNDO.
     2417      DEFINE OUTPUT PARAMETER  lIsObj      AS LOGICAL   NO-UNDO INITIAL FALSE.
     2418      DEFINE OUTPUT PARAMETER  o-Asmt-id   AS INTEGER   NO-UNDO INITIAL 0.
     2419      DEFINE OUTPUT PARAMETER  o-Db-Num    AS INTEGER   NO-UNDO INITIAL 0.
     2420      DEFINE OUTPUT PARAMETER  v-Type      AS CHARACTER NO-UNDO INITIAL "".
     2421      DEFINE OUTPUT PARAMETER  cError      AS CHARACTER NO-UNDO INITIAL "".
     2422      DEFINE VARIABLE v-value AS  CHARACTER NO-UNDO INITIAL "".
     2423      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2424      DEFINE BUFFER buf_AM-2 FOR ub.Assortment-Matrix.
     2425      ASSIGN
     2426         v-gl-lAM-Is-Obj = FALSE.
     2427      FIND FIRST buf_AM WHERE
     2428                 buf_AM.asmt-id = p-Asmt-id
     2429             AND buf_AM.db-num  = p-Db-num
     2430           NO-LOCK NO-ERROR.
     2431      IF NOT AVAILABLE buf_AM THEN DO:
     2432         cError = "Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2433         RETURN.
     2434      END.
     2435      IF buf_AM.asmt-type <> 'Объект':U THEN DO:
     2436         RETURN.
     2437      END. ELSE DO:
     2438         ASSIGN
     2439            lIsObj           = TRUE
     2440            v-gl-lAM-Is-Obj  = TRUE
     2441            .
     2442      END.
     2443      run assmatat-value (
     2444          input buf_AM.asmt-id
     2445         ,input buf_AM.db-num
     2446         ,input 'RootShablon':U
     2447         ,output v-value
     2448         ,output v-type
     2449         ) .
     2450      IF v-value = "" OR v-value = ? THEN DO:
     2451         RETURN.
     2452      END.
     2453      ASSIGN
     2454         o-Asmt-id = INTEGER(ENTRY(1, v-value, chr(4)))
     2455         o-Db-num  = INTEGER(ENTRY(2, v-value, chr(4)))
     2456         NO-ERROR.
     2457      IF ERROR-STATUS:ERROR THEN DO:
     2458         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1).
     2459         RETURN.
     2460      END.
     2461      FIND FIRST buf_AM-2 WHERE
     2462                 buf_AM-2.asmt-id = o-Asmt-id
     2463             AND buf_AM-2.db-num  = o-Db-num
     2464           NO-LOCK NO-ERROR.
     2465      IF NOT AVAILABLE buf_AM-2 THEN DO:
     2466         cError = "Не найден шаблон АМ id=" + STRING(o-Asmt-id) + " db-num=" + STRING(o-Db-num).
     2467         RETURN.
     2468      END.
     2469      RETURN.
     2470   END PROCEDURE.
     2471   PROCEDURE Get-Gl-Set-Proc-Otkl:
     2472      DEFINE INPUT PARAMETER  cObj-type AS CHARACTER NO-UNDO.
     2473      DEFINE INPUT PARAMETER  iObj-code AS INTEGER   NO-UNDO.
     2474      DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
     2475      DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
     2476      DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
     2477      DEFINE VARIABLE v-Integer     AS INTEGER    NO-UNDO .
     2478      DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
     2479      DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
     2480      ASSIGN
     2481         v-gl-iProc-Otkl = 0
     2482         .
     2483      EMPTY TEMP-TABLE thbjattr_thbj-attr .
     2484      RUN adm/shattri.p (
     2485              INPUT  "get":U,
     2486              INPUT  cObj-type,
     2487              INPUT  iObj-code,
     2488              INPUT  'Ass-obj':U,
     2489              INPUT  'ass-proc-matr-shabl':U ,
     2490              OUTPUT v-Character,
     2491              OUTPUT v-Date,
     2492              OUTPUT v-Decimal,
     2493              OUTPUT v-Integer,
     2494              OUTPUT v-Logical,
     2495              OUTPUT v-Param-Type,
     2496              INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2497          ) NO-ERROR.
     2498      IF ERROR-STATUS:ERROR THEN DO:
     2499         ASSIGN
     2500            v-Integer  = 0
     2501            v-Decimal  = 0.
     2502      END. ELSE DO:
     2503         ASSIGN
     2504            v-gl-iProc-Otkl = v-Integer
     2505            .
     2506      END.
     2507      RETURN.
     2508   END PROCEDURE.
     2509   PROCEDURE Calc-Proc-Otkl:
     2510      DEFINE INPUT PARAMETER iDeltaGds AS INTEGER NO-UNDO.
     2511      DEFINE VARIABLE iTmp AS INTEGER NO-UNDO INITIAL 0.
     2512      ASSIGN
     2513         v-gl-dAM-Proc-Otkl     = 0
     2514         v-gl-dAM-Proc-Otkl-Ras = 0
     2515         .
     2516      IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2517         RETURN.
     2518      END.
     2519      IF v-gl-iAM-Sbl-Gds-All = 0 THEN DO:
     2520         ASSIGN
     2521            v-gl-dAM-Proc-Otkl     = 999999
     2522            v-gl-dAM-Proc-Otkl-Ras = 999999
     2523            .
     2524         RETURN.
     2525      END.
     2526      ASSIGN
     2527         iTmp = (v-gl-iAM-Gds-All - v-gl-iAM-Sbl-Gds-All)
     2528         v-gl-dAM-Proc-Otkl     = ROUND(iTmp * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2529         v-gl-dAM-Proc-Otkl-Ras = ROUND((iTmp + iDeltaGds)  * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2530         .
     2531      RETURN.
     2532   END PROCEDURE.
     2533   FUNCTION indicator-life-gds-n RETURNS CHARACTER
     2534   ( input p-rec as recid ) :
     2535   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
     2536   define variable v-gdop-min-stock              as decimal   no-undo .
     2537   define variable v-grop-max-stock              as decimal   no-undo .
     2538   define variable v-grop-level-always-presence  as decimal   no-undo .
     2539   define variable v-grop-min-order              as decimal   no-undo .
     2540   define variable v-assort-min                  as LOGICAL   NO-UNDO.
     2541   DEFINE variable v-indicator-life-gds          as CHARACTER NO-UNDO.
     2542   find first buf_matrix-goods no-lock where recid (buf_matrix-goods) = p-rec no-error .
     2543   if error-status :error then return '' .
     2544   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2545   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     2546     (input  buf_Matrix-goods.obj-type
     2547     ,input  buf_Matrix-goods.obj-code
     2548     ,input  ?
     2549     ,input  ?
     2550     ,input  ?
     2551     ,input  buf_Matrix-goods.gds-code
     2552     ,output v-assort-min
     2553     ,output v-indicator-life-gds
     2554     ,output v-gdop-min-stock
     2555     ,output v-grop-max-stock
     2556     ,output v-grop-level-always-presence
     2557     ,output v-grop-min-order
     2558     )  .
     2559     return v-indicator-life-gds.
     2560   end function.
