        1   define input  parameter  ParParentProc as handle no-undo .
        2   define input  parameter  P-Parent as handle no-undo .
        3   define input-output parameter  p-value     as character no-undo .
        4   define input-output parameter  p-full-name as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable v-mode as character no-undo .
       70   v-mode = 'ИЗМЕНЕНИЕ':U .
       71   DEFINE BUTTON B-Cancel AUTO-END-KEY
       72        LABEL "&Отмена"
       73        SIZE 10 BY 1
       74        BGCOLOR 8 .
       75   DEFINE BUTTON B-clear
       76        LABEL "&Очистить"
       77        SIZE 10 BY 1 TOOLTIP "Очистить значение"
       78        BGCOLOR 8 .
       79   DEFINE BUTTON B-Help
       80        LABEL "&Help"
       81        SIZE 6 BY 1
       82        BGCOLOR 8 .
       83   DEFINE BUTTON B-OK AUTO-GO
       84        LABEL "&Ввод"
       85        SIZE 10 BY 1
       86        BGCOLOR 8 .
       87   DEFINE VARIABLE gos-num AS CHARACTER FORMAT "X(10)":U
       88        LABEL "Гос.номер"
       89        VIEW-AS FILL-IN
       90        SIZE 11 BY 1 NO-UNDO.
       91   DEFINE VARIABLE model AS CHARACTER FORMAT "X(256)":U
       92        LABEL "Модель"
       93        VIEW-AS FILL-IN
       94        SIZE 41.5 BY 1 NO-UNDO.
       95   DEFINE FRAME Dialog-Frame
       96        B-OK AT ROW 1 COL 1
       97        B-Cancel AT ROW 1 COL 11
       98        B-clear AT ROW 1 COL 21 WIDGET-ID 10
       99        B-Help AT ROW 1 COL 74
      100        model AT ROW 3.75 COL 17 COLON-ALIGNED WIDGET-ID 2
      101        gos-num AT ROW 5 COL 17 COLON-ALIGNED WIDGET-ID 4
      102        SPACE(49.99) SKIP(2.99)
      103       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      104            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      105            TITLE "<insert dialog title>"
      106            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel WIDGET-ID 100.
      107   ASSIGN
      108          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      109          FRAME Dialog-Frame:HIDDEN           = TRUE.
      110   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      111   DO:
      112     APPLY "END-ERROR":U TO SELF.
      113   END.
      114   ON CHOOSE OF B-clear IN FRAME Dialog-Frame
      115   DO:
      116     if v-mode = 'ПРОСМОТР':U then return.
      117     assign
      118       model   = ""
      119       gos-num = ""
      120       p-value      = ""
      121       p-full-name  = ""
      122     .
      123       display model gos-num with frame Dialog-Frame .
      124   END.
      125   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      126   OR HELP OF FRAME Dialog-Frame
      127   DO:
      128   END.
      129   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      130   DO:
      131     if v-mode = 'ПРОСМОТР':U then return.
      132     assign
      133       model
      134       gos-num
      135     .
      136       if model = "" and gos-num = "" then do:
      137           p-value      = "" .
      138           p-full-name  = "" .
      139       end.
      140       else do:
      141         p-value      = trim(model) + "," + trim(gos-num) .
      142         p-full-name  = "" .
      143       end.
      144   END.
      145   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      146   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      147   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   on help of frame Dialog-Frame
      149   do:
      150     run gbl/app_help.p
      151       (input this-procedure :file-name
      152       ,input ''
      153       ,input ?
      154       ) no-error.
      155     if error-status :error then do:
      156       message
      157         "Ошибка при вызове помощи"
      158         error-status :get-message(1)
      159         view-as alert-box .
      160     end.
      161   end.
      162   run minbtn-set in this-procedure .
      163   on choose of b-help in frame Dialog-Frame
      164   do:
      165     apply "help":u to frame Dialog-Frame .
      166   end.
      167   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   procedure minbtn-set :
      169       do
      170           on error undo, return error return-value
      171           :
      172           define variable ii              as integer       no-undo .
      173           define variable fh              as widget-handle no-undo .
      174           define variable hh              as widget-handle no-undo .
      175           define variable v-h             as handle        extent 4 no-undo .
      176           define variable v-name-button   as character     no-undo .
      177           define variable v-help-old-x    as decimal       no-undo .
      178           define variable v-help-old-y    as decimal       no-undo .
      179           define variable v-help-old-size as decimal       no-undo .
      180           define variable v-frame-width   as decimal       no-undo .
      181           define variable jj              as integer       no-undo .
      182           do
      183               on error undo, return error
      184               :
      185               assign
      186                   v-frame-width = frame Dialog-Frame:width - 0.3
      187                   fh            = frame Dialog-Frame:first-child
      188                   hh            = fh:first-child
      189                   ii            = 1
      190                   .
      191               do while valid-handle(hh):
      192                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      193                   do:
      194                       case lc(hh:name) :
      195                           when "b-help" then
      196                               do:
      197                                   hh:load-image-up("cmp/b-help.bmp":u) .
      198                                   hh:load-image-down("cmp/b-help.bmp":u) .
      199                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      200                                   hh:TOOLTIP = "Помощь" .
      201                                   v-help-old-x = hh:column .
      202                                   v-help-old-y = hh:row    .
      203                                   v-help-old-size = hh:width .
      204                                   hh:width-chars = 2.5 .
      205                               end.
      206                           when "b-print" then
      207                               do:
      208                                   hh:load-image("cmp/b-print.bmp":u) .
      209                                   hh:TOOLTIP = "Печать" .
      210                                   v-h[ii] = hh:handle .
      211                                   ii = ii + 1 .
      212                                   hh:width-chars = 3 .
      213                               end.
      214                           when "b-history" or
      215                           when "b-hist" then
      216                               do:
      217                                   hh:load-image("cmp/b-hist.bmp":u) .
      218                                   hh:TOOLTIP = "История" .
      219                                   v-h[ii] = hh:handle .
      220                                   ii = ii + 1 .
      221                                   hh:width-chars = 3 .
      222                               end.
      223                           when "b-sch" then
      224                               do:
      225                                   hh:load-image("cmp/b-sch.bmp":u) .
      226                                   hh:TOOLTIP = "Установка Фильтра" .
      227                                   v-h[ii] = hh:handle .
      228                                   ii = ii + 1 .
      229                                   hh:width-chars = 3 .
      230                               end.
      231                           when "b-hist-user" then
      232                               do:
      233                                   hh:load-image("cmp/b-hist.bmp":u) .
      234                                   hh:TOOLTIP = "История пользователя" .
      235                                   ii = ii + 1 .
      236                               end.
      237                       end case.
      238                   end.
      239                   hh = hh:next-sibling.
      240               end.
      241               b-help:column = v-frame-width - b-help:width-chars.
      242               jj = 0.
      243               repeat ii = 4 to 1 by -1 :
      244                   if valid-handle (v-h[ii] ) then
      245                   do:
      246                       jj  = jj + 1 .
      247                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      248                       v-h[ii]:row    = v-help-old-y .
      249                   end.
      250               end.
      251           end.
      252       end.
      253   end procedure.
      254   MAIN-BLOCK:
      255   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      256      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      257     frame Dialog-Frame:title = "Автомобиль, Гос.номер" .
      258     RUN enable_UI.
      259     if v-mode <> 'ИЗМЕНЕНИЕ':U then do:
      260        disable model gos-num  b-clear  with frame Dialog-Frame.
      261        B-ok:label = "Вы&ход"  .
      262        hide B-cancel in frame Dialog-Frame .
      263     END.
      264     WAIT-FOR GO OF FRAME Dialog-Frame.
      265   END.
      266   RUN disable_UI.
      267   PROCEDURE disable_UI :
      268     HIDE FRAME Dialog-Frame.
      269   END PROCEDURE.
      270   PROCEDURE enable_UI :
      271     if p-value <> "" then do :
      272       assign
      273         model = entry (1, p-value )
      274         gos-num = entry (2, p-value )
      275       .
      276     end.
      277     DISPLAY model gos-num
      278         WITH FRAME Dialog-Frame.
      279     ENABLE B-OK B-Cancel B-clear B-Help model gos-num
      280         WITH FRAME Dialog-Frame.
      281     VIEW FRAME Dialog-Frame.
      282   END PROCEDURE.
