     2109   define variable v-is-spool-file as logical no-undo .
     2110   define variable v-start-err as integer no-undo .
     2111   define variable v-num-errors as integer no-undo .
     2112   define variable v-dec-sep as character no-undo init ".":U.
     2113   define variable v-encoding as character no-undo .
     2114   define variable v-db-key-enc as character no-undo .
     2115   define variable cri as integer no-undo .
     2116   define variable crai as integer no-undo .
     2117   define variable v-id as character no-undo .
     2118   define variable m-head-db-num   as integer no-undo.
     2119   define variable m-head-obj-code as integer no-undo.
     2120   define variable m-head-pos-type as character no-undo.
     2121   define variable m-head-cash-num as integer no-undo.
     2122   define variable v-ctrl as character no-undo .
     2123   define variable v-time as integer no-undo .
     2124   define variable v-time-char as character no-undo .
     2125   define variable v-cd-fatal-error as logical no-undo .
     2126   define variable v-cd-fatal-message as character no-undo .
     2127   define variable v-errorSeverity as integer no-undo .
     2128   define variable v-errormessage as character no-undo .
     2129   define variable v-errornum as character no-undo .
     2130   define variable v-group as character no-undo .
     2131   define variable v-key as character no-undo .
     2132   define variable ErrorMessage as character no-undo.
     2133   define variable mOk as logical no-undo.
     2134   define variable mtagbeg as int64  no-undo.
     2135   define variable mtagend as int64 no-undo.
     2136   procedure get-xml-ibm-c-buff-or-file.
     2137      define input parameter p-Type as character  no-undo.
     2138      define input parameter p-str  as longchar   no-undo.
     2139      define variable hParser as handle no-undo.
     2140      mtagbeg = 0.
     2141      mtagend = 0.
     2142      create sax-reader hParser.
     2143      if p-Type eq "file"
     2144      then
     2145         hParser:set-input-source(p-Type, string(p-str)).
     2146      else do:
     2147         if p-Type = "longchar"
     2148         then do:
     2149            define variable vmemptr as memptr no-undo.
     2150            copy-lob p-str to vmemptr.
     2151            hParser:set-input-source("memptr", vmemptr).
     2152         end.
     2153         else
     2154            hParser:set-input-source(p-Type, p-str).
     2155      end.
     2156      hParser:sax-parse () no-error.
     2157      if error-status:error then do:
     2158         delete object hParser.
     2159         if error-status:num-messages > 0
     2160         then do:
     2161             run write-log-and-file in p-log-handle (
     2162              input 1
     2163            , input log-file-name
     2164            , input 1
     2165            , input substitute( "!!!При  произошла ошибка при получении полного пути файлу: &1 &2"
     2166                                , ErrorMessage
     2167                                , return-value
     2168                              )
     2169                                        ).
     2170             return error error-status:get-message(1).
     2171         end.
     2172         else do:
     2173              return error return-value.
     2174         end.
     2175      end.
     2176      delete object hParser.
     2177      if ErrorMessage <> ""
     2178      then do:
     2179         run write-log-and-file in p-log-handle (
     2180              input 1
     2181            , input log-file-name
     2182            , input 1
     2183            , input substitute( "!!!При  произошла ошибка при получении полного пути файлу: &1 "
     2184                                , ErrorMessage
     2185                              )
     2186                                        ).
     2187         return error ErrorMessage .
     2188      end.
     2189   end.
     2190   procedure StartDocument:
     2191   end procedure.
     2192   procedure StartElement:
     2193      define input parameter namespaceURI as character.
     2194      define input parameter localName    as character.
     2195      define input parameter qname        as character.
     2196      define input parameter ihAttributes as handle.
     2197      define variable v-attr-num    as integer   no-undo.
     2198      define variable v-temp-string as character no-undo.
     2199      do v-attr-num = 1 to ihAttributes:num-items:
     2200         v-temp-string = substitute ('&1 &2="&3"',
     2201                                     v-temp-string,
     2202                                     ihAttributes:get-qname-by-index(v-attr-num),
     2203                                     ihAttributes:get-value-by-index(v-attr-num)).
     2204      end.
     2205      v-temp-string = trim(v-temp-string).
     2206        mtagbeg =  mtagbeg + 1.
     2207       run run-callback-procedure in this-procedure (
     2208                         input this-procedure:handle
     2209                       , input "call-all":U
     2210                       , input "tag-start"
     2211                       , input qname
     2212                       , input v-temp-string
     2213                   ).
     2214   end procedure.
     2215   define variable mcurrentContent as character no-undo.
     2216   procedure Characters:
     2217       define input parameter charData as memptr.
     2218       define input parameter numChars as integer.
     2219       define variable mcurrentContent as character no-undo.
     2220       mcurrentContent = get-string(charData, 1, get-size(charData)).
     2221       run run-callback-procedure in this-procedure (
     2222                         input this-procedure:handle
     2223                       , input "call-all":U
     2224                       , input "text"
     2225                       , input ""
     2226                       , input mcurrentContent
     2227                   ).
     2228   end procedure.
     2229   procedure EndElement:
     2230   define input parameter name_     as character.
     2231   define input parameter localName as character.
     2232   define input parameter qName     as character.
     2233       if qname = "ErrorMessage" then do:
     2234         ErrorMessage = mcurrentContent.
     2235         self:stop-parsing ().
     2236       end.
     2237       mtagend = mtagend + 1.
     2238       if mtagend mod 100 = 0 or qName eq "check"
     2239       then do:
     2240         run show-counter in p-log-handle .
     2241         run write-counter in p-log-handle (substitute("Прочитано открытых тегов &1 из них закрытых &2", mtagbeg, mtagend)).
     2242       end.
     2243       run run-callback-procedure in this-procedure (
     2244                         input this-procedure:handle
     2245                       , input "call-all":U
     2246                       , input "tag-end"
     2247                       , input qname
     2248                       , input ""
     2249                   ).
     2250   end procedure.
     2251   procedure EndDocument:
     2252       run hide-counter in p-log-handle .
     2253       mOk = true.
     2254   end procedure.
     2255   procedure Warning:
     2256       define input parameter ErrMessage as character no-undo.
     2257       message "The following WARNING was generated:~n" + ErrMessage
     2258           view-as alert-box information buttons ok.
     2259   end procedure.
     2260   procedure Error:
     2261       define input parameter ErrMessage as character no-undo.
     2262       mOk = false.
     2263       message "The following NONFATAL ERROR was generated:~n" + ErrMessage
     2264           view-as alert-box information buttons ok.
     2265   end procedure.
     2266   procedure FatalError:
     2267       define input parameter ErrMessage as character no-undo.
     2268       mOk = false.
     2269       return error "The following FATAL ERROR was generated:~n" + ErrMessage.
     2270   end procedure.
     2271   PROCEDURE get-xml-ibm-c.
     2272   define input parameter p-filename as char no-undo.
     2273   define variable v-new-filename-full     as character         no-undo.
     2274   define variable v-xml-buffer as character no-undo.
     2275   define variable v-my-string as character no-undo .
     2276   define variable v-read-char as character no-undo .
     2277   define buffer buf_cash-desk for ub.cash-desk.
     2278   error-status:error = FALSE.
     2279   run gbl/fileapnd.p
     2280     ( input p-filename
     2281      ,input ""
     2282      ,input 5
     2283     ) no-error .
     2284   if error-status:error then do:
     2285      run write-log-and-file in p-log-handle (
     2286          input 1
     2287        , input log-file-name
     2288        , input 1
     2289        , input return-value
     2290        ).
     2291      assign
     2292         p-view-log = yes
     2293         .
     2294      undo, return.
     2295   end.
     2296   if p-encoding = "utf-8":U  then  do:
     2297     input stream ChkStream from value( p-filename ) convert source "utf-8".
     2298   end.
     2299   else do:
     2300     input stream ChkStream from value( p-filename ) .
     2301   end.
     2302   _repeat:
     2303   REPEAT :
     2304     if v-exit-processing then leave _repeat.
     2305     _line:
     2306     DO TRANSACTION:
     2307       import stream Chkstream unformatted  v-xml-buffer  .
     2308       if v-xml-buffer = "":U then do:
     2309         NEXT _repeat.
     2310       end.
     2311       assign
     2312       var-file-line-num = var-file-line-num + 1
     2313       .
     2314       if left-trim(v-xml-buffer)  begins "<?xml":U then do:
     2315         assign
     2316         v-encoding = cb-xmlparse-get-attr(
     2317                                 input this-procedure:handle
     2318                                ,input "xml":U
     2319                                ,input trim(v-xml-buffer, "?>")
     2320                                ,input "encoding":U
     2321                                ,input yes)
     2322        .
     2323        if v-encoding <> p-encoding
     2324        then do:
     2325           run write-log-and-file in p-log-handle (
     2326                 input 1
     2327               , input log-file-name
     2328               , input 1
     2329               , input substitute( "!!!Ошибка чтения файла &1: кодировка НЕ &2"
     2330                                   , p-filename
     2331                                   , p-encoding
     2332                                 )
     2333                                               ).
     2334         assign
     2335         p-view-log = yes
     2336         .
     2337         undo, return .
     2338        end.
     2339       end.
     2340       run xmlvalid in this-procedure (
     2341             input this-procedure:handle
     2342           , input v-xml-buffer
     2343           , input 'fatal':u
     2344       ) no-error .
     2345       if error-status:error  then do:
     2346           run write-log-and-file in p-log-handle (
     2347                 input 1
     2348               , input log-file-name
     2349               , input 1
     2350               , input substitute( "!!!Ошибка импорта файла &1: &2"
     2351                                   , p-filename
     2352                                   , return-value
     2353                                 )
     2354                                               ).
     2355         assign
     2356         p-view-log = yes
     2357         .
     2358         undo, return .
     2359       end.
     2360       if v-cd-fatal-error then do:
     2361         run write-log-and-file in p-log-handle (
     2362               input 1
     2363             , input log-file-name
     2364             , input 1
     2365             , input substitute( "!!!Файл &1 строка &2 фатальные ошибки: &3 - импорт прекращен"
     2366                                 , p-filename
     2367                                 , var-file-line-num
     2368                                 , v-cd-fatal-message
     2369                               )
     2370                                             ).
     2371         assign
     2372         p-view-log = yes
     2373         .
     2374         undo, return.
     2375       end.
     2376       if var-file-line-num modulo 100 = 0 then do:
     2377         run show-counter in p-log-handle .
     2378         run write-counter in p-log-handle (substitute("Файл &1: прочитано строк &2", p-filename, var-file-line-num)).
     2379       end.
     2380     END .
     2381   end.
     2382   input stream ChkStream close.
     2383   END PROCEDURE.
     2384   procedure cb-xmlparse-tag-start-Header :
     2385   do
     2386   on error undo, return error
     2387   :
     2388     assign
     2389         v-mail-parameters-start = yes
     2390     .
     2391   end.
     2392   end procedure.
     2393   procedure cb-xmlparse-tag-end-Header :
     2394   do
     2395   on error undo, return error
     2396   :
     2397     assign
     2398         v-mail-parameters-start = no
     2399     .
     2400   end.
     2401   end procedure.
     2402   procedure cb-xmlparse-tag-start-data :
     2403   define input parameter p-parameter as character no-undo .
     2404   define variable v-file-type as character no-undo .
     2405   define variable v-adresat as character no-undo .
     2406   define variable v-FO-version as character no-undo .
     2407   define variable v-OptVersion as character no-undo .
     2408   define variable v-OptVersion1 as character no-undo .
     2409   define variable v-OptVersion2 as character no-undo .
     2410   define variable v-OptVersion3 as character no-undo .
     2411   define variable v-OptVersion4 as character no-undo .
     2412   define variable v-OptVer      as character no-undo .
     2413   define variable v-old-fo-version as character no-undo .
     2414   define variable v-pay-desk as integer no-undo .
     2415   define variable v-dop as character no-undo .
     2416   define buffer cash-desk for ub.cash-desk.
     2417   define variable v-date as date no-undo .
     2418   define variable v-decimal as decimal no-undo .
     2419   define variable v-integer as integer no-undo .
     2420   define variable v-logical as logical no-undo .
     2421   define variable v-err-message as character no-undo .
     2422   do
     2423   on error undo, return error
     2424   :
     2425     if v-is-spool-file = no then do:
     2426       IF INDEX(p-parameter,"OptVersion") > 0 THEN v-OptVer = 'OptVer'.
     2427       assign
     2428       v-file-type = cb-xmlparse-get-attr(
     2429                                 input this-procedure:handle
     2430                                ,input p-spool-or-data
     2431                                ,input p-parameter
     2432                                ,input "type":U
     2433                                ,input yes)
     2434       v-adresat =  cb-xmlparse-get-attr(
     2435                                 input this-procedure:handle
     2436                                ,input p-spool-or-data
     2437                                ,input p-parameter
     2438                                ,input "to":U
     2439                                ,input no)
     2440       .
     2441       if v-file-type = "REPLY":U AND
     2442       (v-adresat begins ('маг':U + string(p-obj-code))
     2443        or v-adresat begins ("БД" + string(g#db-num))
     2444        or p-spool-or-data = "config"
     2445        or p-spool-or-data = "control"
     2446       )
     2447       then do:
     2448         assign
     2449         v-is-spool-file = yes
     2450         .
     2451         if v-from begins ('маг':U + string(p-obj-code) + "_" + "касса") then do:
     2452           v-pay-desk = ?.
     2453           v-pay-desk = integer(replace(v-from, ('маг':U + string(p-obj-code) + "_" + "касса"), "")) no-error.
     2454           assign
     2455              m-head-db-num    = ?
     2456              m-head-obj-code  = ?
     2457              m-head-pos-type  = ?
     2458              m-head-cash-num  = ?
     2459           .
     2460           find first cash-desk where
     2461                            cash-desk.db-num = g#db-num
     2462                        and cash-desk.obj-code = p-obj-code
     2463                        and cash-desk.cash-num = v-pay-desk
     2464           no-lock no-error.
     2465           if available cash-desk
     2466           then do transaction :
     2467              assign
     2468                 m-head-db-num    = cash-desk.db-num
     2469                 m-head-obj-code  = cash-desk.obj-code
     2470                 m-head-pos-type  = cash-desk.pos-type
     2471                 m-head-cash-num  = cash-desk.cash-num
     2472              .
     2473             if p-pos-type = 'IBM-XML':U then
     2474             do:
     2475               run cd-attr-write in this-procedure (
     2476                 input cash-desk.db-num
     2477                 ,input cash-desk.obj-code
     2478                 ,input cash-desk.pos-type
     2479                 ,input cash-desk.cash-num
     2480                 ,input  (if p-pos-type = 'IBM-XML':U
     2481                 then 'IBM-XML_operative':U
     2482                 else 'AUTOTANK_operative':U)
     2483                 ,input 'last-date-polls':U
     2484                 ,input string (today,"99.99.9999")
     2485                 ,input ?
     2486                 ,input 0
     2487                 ,input 0
     2488                 ,input no
     2489                 ) .
     2490               run cd-attr-write in this-procedure (
     2491                 input cash-desk.db-num
     2492                 ,input cash-desk.obj-code
     2493                 ,input cash-desk.pos-type
     2494                 ,input cash-desk.cash-num
     2495                 ,input  (if p-pos-type = 'IBM-XML':U
     2496                 then 'IBM-XML_operative':U
     2497                 else 'AUTOTANK_operative':U)
     2498                 ,input 'last-time-polls':U
     2499                 ,input string (time,"HH:MM:SS")
     2500                 ,input ?
     2501                 ,input 0
     2502                 ,input 0
     2503                 ,input no
     2504                 ) .
     2505             end.
     2506             IF v-OptVer = 'OptVer' THEN DO:
     2507               v-OptVer = "".
     2508               IF v-OptVersion  <> ? THEN v-OptVer = TRIM(v-OptVersion," ").
     2509               IF v-OptVersion1 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion1," ")) .
     2510               IF v-OptVersion2 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion2," ")) .
     2511               IF v-OptVersion3 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion3," ")) .
     2512               IF v-OptVersion4 <> ? THEN v-OptVer = substitute("&1,&2",v-OptVer,TRIM(v-OptVersion4," ")) .
     2513               v-OptVer = TRIM(v-OptVer,",").
     2514                   IF v-OptVer = "" THEN v-OptVer = "?" .
     2515                       run cd-attr-write in this-procedure (
     2516                                                      input cash-desk.db-num
     2517                                                     ,input cash-desk.obj-code
     2518                                                     ,input cash-desk.pos-type
     2519                                                     ,input cash-desk.cash-num
     2520                                                     ,input  (if cash-desk.pos-type = 'IBM-XML':U
     2521                                                              then 'IBM-XML_operative':U
     2522                                                              else 'AUTOTANK_operative':U)
     2523                                                     ,input  (if cash-desk.pos-type = 'IBM-XML':U
     2524                                                          then 'OptVer':U
     2525                                                          else 'OptVer':U)
     2526                                                     ,input v-OptVer
     2527                                                     ,input no
     2528                                                     ,input no
     2529                                                     ,input no
     2530                                                     ,input no
     2531                                                     ) no-error.
     2532                  v-OptVer = '' .
     2533              END.
     2534             if error-status:error then do :
     2535                 v-err-message = return-value .
     2536                 run write-log-and-file in p-log-handle (
     2537               input 1
     2538             , input log-file-name
     2539             , input 1
     2540             , input v-err-message
     2541                                             ).
     2542                 p-view-log = yes .
     2543               end .
     2544              run cd-attr-value in this-procedure (
     2545                                                  input cash-desk.db-num
     2546                                                 ,input cash-desk.obj-code
     2547                                                 ,input cash-desk.pos-type
     2548                                                 ,input cash-desk.cash-num
     2549                                                 ,input  (if cash-desk.pos-type = 'IBM-XML':U
     2550                                                         then 'IBM-XML_operative':U
     2551                                                         else 'AUTOTANK_operative':U)
     2552                                                 ,input  (if cash-desk.pos-type = 'IBM-XML':U
     2553                                                          then 'fo-version':U
     2554                                                          else 'fo-version':U)
     2555                                                 ,output v-old-fo-version
     2556                                                 ,output v-date
     2557                                                 ,output v-decimal
     2558                                                 ,output v-integer
     2559                                                 ,output v-logical
     2560                                                 ,output v-dop) no-error.
     2561              if     v-old-fo-version <> v-fo-version
     2562                 and v-FO-version <> ?
     2563              then do:
     2564                 run cd-attr-write in this-procedure (
     2565                                                      input cash-desk.db-num
     2566                                                     ,input cash-desk.obj-code
     2567                                                     ,input cash-desk.pos-type
     2568                                                     ,input cash-desk.cash-num
     2569                                                     ,input  (if cash-desk.pos-type = 'IBM-XML':U
     2570                                                              then 'IBM-XML_operative':U
     2571                                                              else 'AUTOTANK_operative':U)
     2572                                                     ,input (if cash-desk.pos-type = 'IBM-XML':U
     2573                                                             then 'fo-version':U
     2574                                                             else 'fo-version':U)
     2575                                                     ,input v-fo-version
     2576                                                     ,input ?
     2577                                                     ,input 0
     2578                                                     ,input 0
     2579                                                     ,input no
     2580                                                     ) no-error.
     2581               if error-status:error then do :
     2582                 v-err-message = return-value .
     2583                 run write-log-and-file in p-log-handle (
     2584               input 1
     2585             , input log-file-name
     2586             , input 1
     2587             , input v-err-message
     2588                                             ).
     2589                 p-view-log = yes .
     2590               end .
     2591             end.
     2592           end.
     2593         end.
     2594       end.
     2595       else do:
     2596         run write-log-and-file in p-log-handle (
     2597               input 1
     2598             , input log-file-name
     2599             , input 1
     2600             , input substitute( "!!!В директории приема файлов обнаружен файл с неизвестным адресатом: &1 и/или неизвестного типа: &2"
     2601                                 , v-adresat
     2602                                 , v-file-type
     2603                               )
     2604                                             ).
     2605         assign
     2606         p-view-log = yes
     2607         v-exit-processing = yes
     2608         .
     2609       end.
     2610     end.
     2611     else do:
     2612         run write-log-and-file in p-log-handle (
     2613               input 1
     2614             , input log-file-name
     2615             , input 1
     2616             , input substitute( "!!!Нарушение протокола обмена : тэг <&1>", p-spool-or-data
     2617                               )
     2618                                             ).
     2619         assign
     2620         p-view-log = yes
     2621         .
     2622     end.
     2623   end.
     2624   end procedure.
     2625   procedure cb-xmlparse-tag-start-config :
     2626   define input parameter p-parameter as character no-undo .
     2627     run cb-xmlparse-tag-start-data in this-procedure ( input p-parameter) no-error.
     2628     if error-status:error then return error return-value .
     2629   end procedure.
     2630   procedure cb-xmlparse-tag-start-control :
     2631   define input parameter p-parameter as character no-undo .
     2632     run cb-xmlparse-tag-start-data in this-procedure ( input p-parameter) no-error.
     2633     if error-status:error then return error return-value .
     2634   end procedure.
     2635   procedure cb-xmlparse-tag-end-data :
     2636   define input parameter p-parameter as character no-undo .
     2637   do
     2638   on error undo, return error
     2639   :
     2640     assign
     2641     v-is-spool-file = no
     2642     .
     2643     end.
     2644   end procedure.
     2645   procedure cb-xmlparse-tag-end-config :
     2646   define input parameter p-parameter as character no-undo .
     2647   run cb-xmlparse-tag-end-data  in this-procedure ( input p-parameter) no-error.
     2648   if error-status:error then return error return-value .
     2649   end procedure.
     2650   procedure cb-xmlparse-tag-end-control :
     2651   define input parameter p-parameter as character no-undo .
     2652   run cb-xmlparse-tag-end-data  in this-procedure ( input p-parameter) no-error.
     2653   if error-status:error then return error return-value .
     2654   end procedure.
     2655   procedure cb-xmlparse-tag-start-spool :
     2656   define input parameter p-parameter as character no-undo .
     2657   do
     2658   on error undo, return error
     2659   :
     2660     if v-is-spool-file = yes then do:
     2661         run write-log-and-file in p-log-handle (
     2662               input 1
     2663             , input log-file-name
     2664             , input 1
     2665             , input substitute( "!!!Нарушение протокола обмена : тэг <&1>",
     2666    "spool":U
     2667                              )
     2668                                             ).
     2669         assign
     2670         p-view-log = yes
     2671         .
     2672     end.
     2673     else do:
     2674       assign
     2675       v-exit-processing = yes
     2676       .
     2677     end.
     2678   end.
     2679   end procedure.
     2680   procedure cb-xmlparse-tag-end-spool :
     2681   define input parameter p-parameter as character no-undo .
     2682   do
     2683   on error undo, return error
     2684   :
     2685   end.
     2686   end procedure.
     2687   procedure cb-xmlparse-tag-start-error:
     2688   define input parameter p-parameter as character no-undo .
     2689   run cb-xmlparse-tag-start-err in this-procedure ( input p-parameter)  .
     2690   end procedure .
     2691   procedure cb-xmlparse-tag-end-error :
     2692   define input parameter p-parameter as character no-undo .
     2693   run cb-xmlparse-tag-end-err in this-procedure ( input p-parameter)  .
     2694   end procedure .
     2695   procedure cb-xmlparse-tag-end-ErrorMessage :
     2696   define input parameter p-parameter as character no-undo .
     2697   assign
     2698   v-ErrorMessage = v-xmlvalid-tag-value
     2699   .
     2700   if p-pos-type = 'IBM-XML':U
     2701   or p-pos-type = 'Autotank':U
     2702   then do:
     2703       run write-log-and-file in p-log-handle (
     2704             input 1
     2705           , input log-file-name
     2706           , input 1
     2707           , input substitute( "!!!&1"
     2708                               ,v-ErrorMessage
     2709                             )
     2710                                           ).
     2711       assign
     2712       p-view-log = yes
     2713       .
     2714   end.
     2715   end procedure .
     2716   procedure cb-xmlparse-tag-end-ErrorSeverity :
     2717   define input parameter p-parameter as character no-undo .
     2718   assign
     2719   v-Errorseverity = integer(v-xmlvalid-tag-value)
     2720   no-error
     2721   .
     2722   if p-pos-type = 'IBM-XML':U
     2723   or p-pos-type = 'Autotank':U
     2724   then do:
     2725       run write-log-and-file in p-log-handle (
     2726             input 1
     2727           , input log-file-name
     2728           , input 1
     2729           , input substitute( "!!!&1"
     2730                             , (if v-errorseverity = 0
     2731                                 then "Информация"
     2732                                 else (if v-Errorseverity = 1
     2733                                       then "Предупреждение"
     2734                                       else "Ошибка"
     2735                                       )
     2736                                 ))
     2737                                 ).
     2738       assign
     2739       p-view-log = yes
     2740       .
     2741   end.
     2742   end procedure .
     2743   procedure cb-xmlparse-tag-start-err:
     2744   define input parameter p-parameter as character no-undo .
     2745   do
     2746   on error undo, return error
     2747   :
     2748     if v-is-spool-file
     2749     then do:
     2750       assign
     2751       v-start-err = v-start-err + 1
     2752       v-num-errors = v-num-errors + 1
     2753       v-errormessage = '':U
     2754       v-errorseverity = 0
     2755       v-errornum = '':U
     2756       .
     2757       if p-pos-type = 'MAGIA-XML':U then do:
     2758         assign
     2759         v-ErrorMessage = cb-xmlparse-get-attr(
     2760                                   input this-procedure:handle
     2761                                 ,input p-spool-or-data
     2762                                 ,input p-parameter
     2763                                 ,input "ErrorMessage":U
     2764                                 ,input yes)
     2765         v-ErrorNum =  cb-xmlparse-get-attr(
     2766                                   input this-procedure:handle
     2767                                 ,input p-spool-or-data
     2768                                 ,input p-parameter
     2769                                 ,input "Error":U
     2770                                 ,input no)
     2771         v-ErrorSeverity =  integer(cb-xmlparse-get-attr(
     2772                                   input this-procedure:handle
     2773                                 ,input p-spool-or-data
     2774                                 ,input p-parameter
     2775                                 ,input "ErrorSeverity":U
     2776                                 ,input no))
     2777         no-error
     2778         .
     2779         run write-log-and-file in p-log-handle (
     2780               input 1
     2781             , input log-file-name
     2782             , input 1
     2783             , input substitute( "!!!&1: &2 &3                   Код &4"
     2784                                 , (if v-errorseverity = 0
     2785                                   then "Информация"
     2786                                   else (if v-Errorseverity = 1
     2787                                         then "Предупреждение"
     2788                                         else "Ошибка"
     2789                                         )
     2790                                   )
     2791                                 , v-ErrorMessage
     2792                                 , chr(10)
     2793                                 , v-ErrorNum
     2794                               )
     2795                                             ).
     2796         assign
     2797         p-view-log = yes
     2798         .
     2799       end.
     2800     end.
     2801     else do:
     2802         run write-log-and-file in p-log-handle (
     2803               input 1
     2804             , input log-file-name
     2805             , input 1
     2806             , input substitute( "!!!Нарушение протокола обмена : тэг Err", p-spool-or-data
     2807                               )
     2808                                             ).
     2809         assign
     2810         p-view-log = yes
     2811         .
     2812     end.
     2813   end.
     2814   end procedure.
     2815   procedure cb-xmlparse-tag-end-err :
     2816   define input parameter p-parameter as character no-undo .
     2817   do
     2818   on error undo, return error
     2819   :
     2820     if p-pos-type = 'MAGIA-XML':U then do:
     2821       if v-start-err =  1 then do:
     2822         assign
     2823         v-start-err = 0
     2824         .
     2825       end.
     2826       else do:
     2827         assign
     2828         v-start-err = v-start-err - 1
     2829         .
     2830       end.
     2831     end.
     2832     if p-pos-type = 'IBM-XML':U
     2833     or p-pos-type = 'Autotank':U
     2834     then do:
     2835       assign
     2836       v-errornum = v-xmlvalid-tag-value
     2837       no-error .
     2838       run write-log-and-file in p-log-handle (
     2839             input 1
     2840           , input log-file-name
     2841           , input 1
     2842           , input substitute( "!!!           Код &1"
     2843                               , v-ErrorNum  )
     2844                                           ).
     2845       assign
     2846       p-view-log = yes
     2847       .
     2848     end.
     2849   end.
     2850   end procedure.
     2851   PROCEDURE fill-doc-property :
     2852   do
     2853   on error undo, return error
     2854   :
     2855   define input parameter p-tag-name   as character    no-undo.
     2856   define input parameter p-tag-value  as character    no-undo.
     2857   define buffer buf_db for ub.db.
     2858   if v-mail-parameters-start = yes
     2859   then do:
     2860     CASE p-tag-name:
     2861       when "DocumentName":U
     2862       then do:
     2863         if p-tag-value = p-spool-or-data then do:
     2864         end.
     2865         else do:
     2866         end.
     2867       end.
     2868       when "DateFormat":U
     2869       then do:
     2870         assign
     2871         v-date-format = p-tag-value
     2872         .
     2873       end.
     2874       when "DocumentVersion":U
     2875       then do:
     2876         assign
     2877         v-version = p-tag-value
     2878         .
     2879       end.
     2880       when "DecimalSeparator":U
     2881       then do:
     2882         assign
     2883         v-dec-sep = p-tag-value
     2884         .
     2885       end.
     2886       when "objList":U then do:
     2887       end.
     2888       when "dbEncKey":U then do:
     2889         assign
     2890         v-db-key-enc = p-tag-value
     2891         .
     2892         find first buf_db where buf_db.db-num = g#db-num no-lock.
     2893         if buf_db.db-key-enc = v-db-key-enc then do:
     2894           return error
     2895           substitute("Кодир. значение ключа БД-приемника &1 совпадает с кодир. значением ключа БД-источника &2&3- импорт данных со своей БД на свою БД невозможен"
     2896                      , buf_Db.db-key-enc
     2897                      , v-db-key-enc
     2898                      , chr(10)).
     2899         end.
     2900       end.
     2901     end case.
     2902   end.
     2903   end.
     2904   end PROCEDURE.
     2905   procedure create-temp-table-record :
     2906   define input parameter p-record-name as character no-undo .
     2907   define input parameter p-field-name as character no-undo .
     2908   define input parameter p-field-value as character no-undo .
     2909     do
     2910     on error undo, return error
     2911     :
     2912       if p-record-name = "Param" or p-record-name = "FuelPump" then do:
     2913       find first temp-param where
     2914                  temp-param.cr = cri + 1 no-error .
     2915       if not avail temp-param then do:
     2916         create
     2917         temp-param.
     2918         assign
     2919         temp-param.cr = cri + 1
     2920         .
     2921       end.
     2922       assign
     2923       temp-param.record-name = p-record-name
     2924       temp-param.field-name  = p-field-name
     2925       temp-param.field-value = p-field-value
     2926       temp-param.desk        = m-head-cash-num
     2927       temp-param.key-name    = v-key
     2928       temp-param.group-name  = v-group
     2929       cri                   = cri + 1
     2930       .
     2931       end.
     2932       else do:
     2933       find first temp-temp where
     2934                  temp-temp.cr = cri + 1 no-error .
     2935       if not avail temp-temp then do:
     2936         create
     2937         temp-temp.
     2938         assign
     2939         temp-temp.cr = cri + 1
     2940         .
     2941       end.
     2942       assign
     2943       temp-temp.record-name = p-record-name
     2944       temp-temp.field-name  = p-field-name
     2945       temp-temp.field-value = p-field-value
     2946       temp-temp.id          = v-id
     2947       temp-temp.ctime       = v-time
     2948       cri                   = cri + 1
     2949       .
     2950       end.
     2951     end.
     2952   end procedure.
     2953   if p-spool-or-data = "config"
     2954   or p-spool-or-data = "control" then do:
     2955     p-need-save = yes.
     2956     if lookup("cb_set-log-file-name", this-procedure:instantiating-procedure:internal-entries) > 0 then do:
     2957       run cb_set-log-file-name in  (this-procedure:instantiating-procedure) ( output log-file-name) no-error.
     2958     end.
     2959   end.
     2960   process events.
     2961   RUN get-xml-ibm-c(input file_) no-error .
     2962   if error-status :error
     2963   then do:
     2964       run write-log-and-file in p-log-handle (
     2965             input 1
     2966           , input log-file-name
     2967           , input 1
     2968           , input substitute( "!!!Ошибка при обработке файла &1: &2"
     2969                               , file_
     2970                               , return-value
     2971                             )
     2972                                            ).
     2973     assign
     2974     p-view-log = yes
     2975     .
     2976     undo, return .
     2977   end.
     2978   if v-num-errors > 0 then do:
     2979     assign
     2980     p-need-save = yes
     2981     .
     2982   end.
