       90   procedure xmlchar-test :
       91   define input parameter p-in-string          as character        no-undo.
       92   define output parameter p-out-string-enc    as character        no-undo.
       93   define output parameter p-out-string-dec    as character        no-undo.
       94   do
       95   on error undo, return error
       96   :
       97          run xmlchar-encode in this-procedure
       98       (
       99             input p-in-string
      100           , output p-out-string-enc
      101       ).
      102          run xmlchar-decode in this-procedure
      103       (
      104             input p-out-string-enc
      105           , output p-out-string-dec
      106       ).
      107   end.
      108   end .
      109   procedure xmlchar-encode :
      110   define input parameter p-in-string      as character        no-undo.
      111   define output parameter p-out-string    as character        no-undo.
      112       define variable v-position      as integer      no-undo.
      113       define variable v-current-char  as character    no-undo.
      114   do
      115   on error undo, return error
      116   :
      117       assign
      118           p-out-string = "":U
      119       .
      120       case p-in-string
      121       :
      122           when ?
      123           then do:
      124               assign
      125                   p-out-string = "?":U
      126               .
      127           end.
      128           when "?":U
      129           then do:
      130               assign
      131                   p-out-string = "&#63;":U
      132               .
      133           end.
      134           otherwise do:
      135               do v-position = 1 to length( p-in-string )
      136               :
      137                   assign
      138                       v-current-char = substring( p-in-string, v-position, 1 )
      139                   .
      140                   case v-current-char
      141                   :
      142                       when "&":U
      143                       then do:
      144                           assign
      145                               p-out-string = p-out-string + "&amp;":U
      146                           .
      147                       end.
      148                       when ">":U
      149                       then do:
      150                           assign
      151                               p-out-string = p-out-string + "&gt;":U
      152                           .
      153                       end.
      154                       when "<":U
      155                       then do:
      156                           assign
      157                               p-out-string = p-out-string + "&lt;":U
      158                           .
      159                       end.
      160                       when "'":U
      161                       then do:
      162                           assign
      163                               p-out-string = p-out-string + "&apos;":U
      164                           .
      165                       end.
      166                       when '"':U
      167                       then do:
      168                           assign
      169                               p-out-string = p-out-string + "&quot;":U
      170                           .
      171                       end.
      172                       when chr(1)
      173                       then do:
      174                           assign
      175                               p-out-string = p-out-string + "":U
      176                           .
      177                       end.
      178                       when chr(2)
      179                       then do:
      180                           assign
      181                               p-out-string = p-out-string + "":U
      182                           .
      183                       end.
      184                       when chr(3)
      185                       then do:
      186                           assign
      187                               p-out-string = p-out-string + "":U
      188                           .
      189                       end.
      190                       when chr(4)
      191                       then do:
      192                           assign
      193                               p-out-string = p-out-string + "":U
      194                           .
      195                       end.
      196                       when chr(5)
      197                       then do:
      198                           assign
      199                               p-out-string = p-out-string + "":U
      200                           .
      201                       end.
      202                       when chr(6)
      203                       then do:
      204                           assign
      205                               p-out-string = p-out-string + "":U
      206                           .
      207                       end.
      208                       when chr(7)
      209                       then do:
      210                           assign
      211                               p-out-string = p-out-string + "":U
      212                           .
      213                       end.
      214                       when chr(8)
      215                       then do:
      216                           assign
      217                               p-out-string = p-out-string + "":U
      218                           .
      219                       end.
      220                       when chr(9)
      221                       then do:
      222                           assign
      223                               p-out-string = p-out-string + "":U
      224                           .
      225                       end.
      226                       when chr(29)
      227                       then do:
      228                           assign
      229                               p-out-string = p-out-string + "":U
      230                           .
      231                       end.
      232                       when chr(10)
      233                       then do:
      234                           assign
      235                               p-out-string = p-out-string + "&#10;":U
      236                           .
      237                       end.
      238                       when chr(13)
      239                       then do:
      240                           assign
      241                               p-out-string = p-out-string + "&#13;":U
      242                           .
      243                       end.
      244                       otherwise do:
      245                           assign
      246                               p-out-string = p-out-string + v-current-char
      247                           .
      248                       end.
      249                   end case.
      250               end.
      251           end.
      252       end case.
      253   end.
      254   end .
      255   procedure xmlchar-encode-1c :
      256   define input parameter p-in-string      as character        no-undo.
      257   define output parameter p-out-string    as character        no-undo.
      258       define variable v-position      as integer      no-undo.
      259       define variable v-current-char  as character    no-undo.
      260   do
      261   on error undo, return error
      262   :
      263       assign
      264           p-out-string = "":U
      265       .
      266       case p-in-string
      267       :
      268           when ?
      269           then do:
      270               assign
      271                   p-out-string = "?":U
      272               .
