      365   procedure xmlchar-decode :
      366   define input parameter p-in-string      as character        no-undo.
      367   define output parameter p-out-string    as character        no-undo.
      368       define variable v-position      as integer      no-undo.
      369       define variable v-last-position as integer      no-undo.
      370       define variable v-temp-integer  as integer      no-undo.
      371       define variable v-current-char  as character    no-undo.
      372       define variable v-next-char     as character    no-undo.
      373       define variable v-success       as logical      no-undo.
      374   do
      375   on error undo, return error
      376   :
      377       assign
      378           p-out-string = "":U
      379           v-position   = 0
      380       .
      381       replace-cycle:
      382       do while yes
      383       on error undo, return error
      384       :
      385           assign
      386               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      387           .
      388           if v-last-position <= v-position
      389           then do:
      390               if v-position = 0
      391               then do:
      392                   assign
      393                       p-out-string = p-in-string
      394                   .
      395               end.
      396               else do:
      397                   assign
      398                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      399                   .
      400               end.
      401               leave replace-cycle.
      402           end.
      403           else do:
      404               assign
      405                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      406                   v-position      = v-last-position
      407                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      408               .
      409               if v-current-char = "#":U
      410               then do:
      411                   assign
      412                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      413                   .
      414                   if v-last-position > 0
      415                   then do:
      416                       run xmlchar-read-integer in this-procedure
      417                        (
      418                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      419                           , output v-temp-integer
      420                           , output v-success
      421                       ).
      422                       if v-success = yes
      423                       and v-temp-integer >= 1
      424                       and v-temp-integer <= 255
      425                       then do:
      426                           assign
      427                               p-out-string = p-out-string + chr( v-temp-integer )
      428                               v-position   = v-last-position + 1
      429                           .
      430                       end.
      431                       else do:
      432                           assign
      433                               p-out-string = p-out-string + "&":U
      434                               v-position   = v-position   + 1
      435                           .
      436                       end.
      437                   end.
      438                   else do:
      439                       assign
      440                           p-out-string = p-out-string + "&":U
      441                           v-position   = v-position   + 1
      442                       .
      443                   end.
      444               end.
      445               else do:
      446                   case substring( p-in-string, v-position + 1, 3 )
      447                   :
      448                       when "lt;":U
      449                       then do:
      450                           assign
      451                               p-out-string = p-out-string + "<":U
      452                               v-position   = v-position   + 3
      453                           .
      454                       end.
      455                       when "gt;":U
      456                       then do:
      457                           assign
      458                               p-out-string = p-out-string + ">":U
      459                               v-position   = v-position   + 3
      460                           .
      461                       end.
      462                       otherwise do:
      463                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      464                           then do:
      465                               assign
      466                                   p-out-string = p-out-string + "&":U
      467                                   v-position   = v-position   + 4
      468                               .
      469                           end.
      470                           else do:
      471                               case substring( p-in-string, v-position + 1, 5 )
      472                               :
      473                                   when "quot;":U
      474                                   then do:
      475                                       assign
      476                                           p-out-string = p-out-string + '"':U
      477                                           v-position   = v-position   + 5
      478                                       .
      479                                   end.
      480                                   when "apos;":U
      481                                   then do:
      482                                       assign
      483                                           p-out-string = p-out-string + "'":U
      484                                           v-position   = v-position   + 5
      485                                       .
      486                                   end.
      487                                   otherwise do:
      488                                       assign
      489                                           p-out-string = p-out-string + "&":U
      490                                       .
      491                                   end.
      492                               end case.
      493                           end.
      494                       end.
      495                   end case.
      496               end.
      497           end.
      498       end.
      499   end.
      500   end .
      501   procedure xmlchar-read-integer :
      502   define input parameter p-input-string      as character        no-undo.
      503   define output parameter p-output-integer   as integer          no-undo.
      504   define output parameter p-success       as logical          no-undo.
      505   do
      506   on error undo, return error
      507   :
      508       assign
      509           p-output-integer = integer( p-input-string )
      510       no-error.
      511       if error-status :error
      512       then do:
      513           assign
      514               p-success           = no
      515               p-output-integer    = 0
      516           .
      517       end.
      518       else do:
      519           assign
      520               p-success           = yes
      521           .
      522       end.
      523   end.
      524   end.
      525   define variable vss-include-info1 as character format "X(65)" no-undo
      526   initial "@(#)$Workfile$ $Revision$".
      527   define temp-table temp_xmlparse-attrs no-undo
      528   field field-name as character
      529   field attr-code as character
      530   field attr-value as character
      531   index pi is unique primary
      532   field-name attr-code
      533   .
      534   procedure xmlparse :
      535   define input parameter p-handle         as handle           no-undo.
      536   define input parameter p-XML-buffer     as character        no-undo.
      537   define input parameter p-call-mode      as character        no-undo.
      538       define variable v-procedure-type        as character    no-undo.
      539       define variable v-procedure-name        as character    no-undo.
      540       define variable v-temp-string           as character    no-undo.
      541       define variable v-current-position      as integer      no-undo.
      542       define variable v-end-position          as integer      no-undo.
      543       define variable v-text-position         as integer      no-undo.
      544       define variable v-input-buffer-length   as integer      no-undo.
      545       define variable v-handle                as handle       no-undo.
      546       define variable v-call-mode             as character    no-undo.
      547       define variable v-proc-type             as character    no-undo.
      548       define variable v-proc-name             as character    no-undo.
      549       define variable v-decode-string         as character    no-undo.
      550   do
      551   on error undo, return error
      552   :
      553       if not valid-handle( p-handle )
      554       then do:
      555           return.
      556       end.
      557       assign
      558           v-end-position          = 1
      559           v-current-position      = 1
      560           v-input-buffer-length   = length( p-XML-buffer )
      561       .
      562       do
      563       while v-end-position < v-input-buffer-length
      564       :
      565           assign
      566               v-current-position = index( p-XML-buffer, "<":U, v-end-position )
      567           .
      568           if v-current-position = 0
      569           then do:
      570               assign
      571                   v-decode-string = substring( p-XML-buffer, v-end-position )
      572               .
      573               run xmlchar-decode in this-procedure (
      574                     input v-decode-string
      575                   , output v-temp-string
      576               ).
      577               assign
      578                   v-handle     = p-handle
      579                   v-call-mode  = p-call-mode
      580                   v-proc-type  = 'text':U
      581                   v-proc-name  = '':U
      582               .
      583               run run-callback-procedure in this-procedure (
      584                     input v-handle
      585                   , input v-call-mode
      586                   , input v-proc-type
      587                   , input v-proc-name
      588                   , input v-temp-string
      589               ).
      590               assign
      591                   v-end-position = v-input-buffer-length
      592               .
      593           end.
      594           else do:
      595               if v-current-position > v-end-position
      596               then do:
      597                   assign
      598                       v-decode-string = substring( p-XML-buffer, v-end-position, v-current-position - v-end-position )
      599                   .
      600                   run xmlchar-decode in this-procedure (
      601                         input v-decode-string
      602                       , output v-temp-string
      603                   ).
      604                   assign
      605                       v-end-position = v-current-position
      606                   .
      607                   assign
      608                       v-handle     = p-handle
      609                       v-call-mode  = p-call-mode
      610                       v-proc-type  = 'text':U
      611                       v-proc-name  = '':U
      612                   .
      613                   run run-callback-procedure in this-procedure (
      614                         input v-handle
      615                       , input v-call-mode
      616                       , input v-proc-type
      617                       , input v-proc-name
      618                       , input v-temp-string
      619                   ).
      620               end.
      621               assign
      622                   v-decode-string = substring( p-XML-buffer, v-end-position + 1, 1 )
      623               .
      624               if v-decode-string = "/":U
      625               then do:
      626                   assign
      627                       v-procedure-type    = "tag-end":U
      628                       v-end-position      = v-current-position + 1
      629                   .
      630               end.
      631               else do:
      632                   assign
      633                       v-procedure-type    = "tag-start":U
      634                       v-end-position      = v-current-position
      635                   .
      636               end.
      637               assign
      638                   v-current-position  = index(p-XML-buffer, "/>":U, v-end-position)
      639               .
      640               if v-current-position <= v-end-position
      641               then do:
      642                   assign
      643                       v-current-position  = index(p-XML-buffer, ">":U, v-end-position)
      644                   .
      645               end.
      646               assign
      647                   v-end-position      = v-end-position + 1
      648               .
      649               if v-current-position <= v-end-position
      650               then do:
      651                   run run-cb-xmlparse-error in this-procedure
      652                                           (   input p-handle
      653                                           ,   input 'Ошибка: знак < без завершающего > на той же строке'
      654                                           ).
      655                   assign
      656                       v-temp-string   = "<":U + substring(p-XML-buffer, v-end-position)
      657                       v-end-position  = v-input-buffer-length
      658                   .
      659                   assign
      660                       v-handle     = p-handle
      661                       v-call-mode  = p-call-mode
      662                       v-proc-type  = 'text':U
      663                       v-proc-name  = '':U
      664                   .
      665                   run run-callback-procedure in this-procedure (
      666                         input v-handle
      667                       , input v-call-mode
      668                       , input v-proc-type
      669                       , input v-proc-name
      670                       , input v-temp-string
      671                   ).
      672               end.
      673               else do:
      674                   assign
      675                       v-temp-string   = trim( substring(      p-XML-buffer
      676                                                           ,   v-end-position
      677                                                           ,   v-current-position - v-end-position
      678                                             )          )
      679                       v-text-position = index( v-temp-string, " ":U )
      680                   .
      681                   if v-text-position <> 0
      682                   then do:
      683                       assign
      684                           v-procedure-name    =   trim( substring(      v-temp-string
      685                                                                       ,   1
      686                                                                       ,   v-text-position
      687                                                         )          )
      688                           v-temp-string       =   trim( substring(    v-temp-string
      689                                                                   ,   v-text-position + 1
      690                                                       )          )
      691                       .
      692                   end.
      693                   else do:
      694                       assign
      695                           v-procedure-name    =   v-temp-string
      696                           v-temp-string       =   "":U
      697                       .
      698                   end.
      699                   assign
      700                       v-end-position      = v-current-position + 1
      701                   .
      702                   assign
      703                       v-handle          = p-handle
      704                       v-call-mode       = p-call-mode
      705                   .
      706                   run run-callback-procedure in this-procedure (
      707                         input v-handle
      708                       , input v-call-mode
      709                       , input v-procedure-type
      710                       , input v-procedure-name
      711                       , input v-temp-string
      712                   ).
      713               end.
      714           end.
      715       end.
      716   end.
      717   end procedure.
      718   procedure run-callback-procedure :
      719   define input parameter p-handle             as handle           no-undo.
      720   define input parameter p-call-mode          as character        no-undo.
      721   define input parameter p-procedure-type     as character        no-undo.
      722   define input parameter p-procedure-name     as character        no-undo.
      723   define input parameter p-param-value        as character        no-undo.
      724       define variable v-data-type         as character            no-undo.
      725       define variable v-data-value        as character            no-undo.
      726       define variable v-procedure-name    as character            no-undo.
      727       define variable v-procedure-exists  as logical      no-undo.
      728   do
      729   on error undo, return error
      730   :
      731       if p-call-mode = "call-all":U
      732       or p-call-mode = "call-named":U
      733       then do:
      734           case p-procedure-type :
      735               when "text":U
      736               then do:
      737                   assign
      738                       v-procedure-name = "cb-xmlparse-text":U
      739                   .
      740               end.
      741               when "tag-end":U
      742               then do:
      743                   assign
      744                       v-procedure-name = "cb-xmlparse-tag-end-":U + p-procedure-name
      745                   .
      746               end.
      747               when "tag-start":U
      748               then do:
      749                   assign
      750                       v-procedure-name = "cb-xmlparse-tag-start-":U + p-procedure-name
      751                   .
      752               end.
      753               otherwise do:
      754                   assign
      755                       v-procedure-name = p-procedure-name
      756                   .
      757               end.
      758           end case.
      759           if p-handle :get-signature( v-procedure-name ) = "":U
      760           then do:
      761               assign
      762                   v-procedure-exists = no
      763               .
      764           end.
      765           else do:
      766               assign
      767                   v-procedure-exists = yes
      768               .
      769           end.
      770           if v-procedure-exists = yes
      771           then do:
      772               run value(v-procedure-name) in p-handle (input p-param-value) no-error.
      773               if error-status :error
      774               then do:
      775                   run run-cb-xmlparse-error in this-procedure (
      776                       input p-handle
      777                       , input "Ошибка при вызове программы " + v-procedure-name
      778                   ).
      779               end.
      780           end.
      781       end.
      782       if ( p-call-mode = "call-all":U
      783           and v-procedure-exists <> yes )
      784       or p-call-mode = "call-unnamed":U
      785       then do:
      786           case p-procedure-type :
      787               when 'text':U
      788               then do:
      789                   assign
      790                       v-data-type     = 'text':U
      791                       v-data-value    = p-param-value
      792                   .
      793               end.
      794               when 'tag-end':U
      795               then do:
      796                   assign
      797                       v-data-type     = 'tag-end':U
      798                       v-data-value    = p-procedure-name
      799                   .
      800               end.
      801               when 'tag-start':U
      802               then do:
      803                   assign
      804                       v-data-type     = 'tag-start':U
      805                       v-data-value    = p-procedure-name
      806                   .
      807               end.
      808               otherwise do:
      809                   assign
      810                       v-data-type     = 'text':U
      811                       v-data-value    = p-procedure-name
      812                   .
      813               end.
      814           end case.
      815           run run-cb-xmlparse-procedure-not-found in this-procedure (
      816                 input p-handle
      817               , input v-data-type
      818               , input v-data-value
      819               , input p-param-value
      820           ).
      821       end.
      822   end.
      823   end procedure.
      824   procedure run-cb-xmlparse-error :
      825   do
      826   on error undo, return error
      827   :
      828       def input parameter p-handle            as handle no-undo.
      829       def input parameter p-error-message as char no-undo.
      830       if lookup("cb-xmlparse-error", p-handle :internal-entries) > 0
      831       then do:
      832           run cb-xmlparse-error in p-handle  (input p-error-message).
      833       end.
      834   end.
      835   end procedure.
      836   procedure run-cb-xmlparse-procedure-not-found :
      837   do
      838   on error undo, return error
      839   :
      840       def input parameter p-handle            as handle no-undo.
      841       def input parameter p-data-type         as char no-undo.
      842       def input parameter p-data-value        as char no-undo.
      843       def input parameter p-param-value       as char no-undo.
      844       if lookup("cb-xmlparse-procedure-not-found", p-handle :internal-entries) > 0
      845       then do:
      846           run cb-xmlparse-procedure-not-found in p-handle    (   input p-data-type
      847                                                             , input p-data-value
      848                                                             , input p-param-value
      849                                                           ) no-error.
      850           if error-status :error
      851           then do:
      852               run run-cb-xmlparse-error in this-procedure
      853                                       (   input p-handle
      854                                       ,   input "Ошибка при вызове программы cb-xmlparse-procedure-not-found"
      855                                       ).
      856           end.
      857       end.
      858       else do:
      859           run run-cb-xmlparse-error in this-procedure
      860                                   (   input p-handle
      861                                   ,   input "Ошибка: Не определена программа cb-xmlparse-procedure-not-found"
      862                                   ).
      863       end.
      864   end.
      865   end procedure.
      866   procedure cb-xmlparse-attributes :
      867   define input  parameter p-handle            as handle no-undo.
      868   define input  parameter p-field-name        as character no-undo .
      869   define input  parameter p-field-value       as character no-undo .
      870   define variable ii as integer no-undo init 1.
      871   define variable v-input-buffer-length   as integer no-undo.
      872   define variable v-dc as logical no-undo .
      873   define variable v-sc as logical no-undo .
      874   define variable v-eq as logical no-undo .
      875   define variable v-char as character no-undo .
      876   define variable v-code as character no-undo .
      877   define variable v-value as character no-undo .
      878   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
      879     do
      880     on error undo, return error
      881     :
      882       if index(p-field-value, '>':U) > 0 then do:
      883         run run-cb-xmlparse-error in this-procedure
      884                                 (   input p-handle
      885                                 ,   input substitute("Ошибка: тэг &1 содержит другие тэги", p-field-name)
      886                                 ).
      887       end.
      888       assign
      889       p-field-value = trim(p-field-value)
      890       .
      891       for each buf_temp_xmlparse-attrs where
      892               buf_temp_xmlparse-attrs.field-name = p-field-name:
      893         delete buf_temp_xmlparse-attrs.
      894       end.
      895       assign
      896       v-input-buffer-length = length( p-field-value )
      897       .
      898       do while ii <= v-input-buffer-length:
      899         assign
      900         v-char = substr(p-field-value, ii, 1)
      901         ii = ii + 1
      902         .
      903         CASE v-char:
      904           when "=":U then do:
      905             if v-eq
      906             and not v-dc
      907             and not v-sc then do:
      908               return error.
      909             end.
      910             assign
      911             v-eq = yes
      912             .
      913           end.
      914           when chr(34) then do:
      915           if v-eq then
      916           assign
      917           v-dc = not(v-dc)
      918           .
      919           else return error.
      920           end.
      921           when chr(39) then do:
      922           if v-eq then
      923           assign
      924           v-sc = not(v-sc)
      925           .
      926           else return error.
      927           end.
      928           when chr(32) then do:
      929             if not v-dc
      930             and not v-sc
      931             then do:
      932               assign
      933               v-sc = no
      934               v-dc = no
      935               v-eq = no
      936               .
      937               create buf_temp_xmlparse-attrs.
      938               assign
      939               buf_temp_xmlparse-attrs.field-name = p-field-name
      940               buf_temp_xmlparse-attrs.attr-code  = v-code
      941               buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
      942               v-code = "":U
      943               v-value = "":U
      944               .
      945             end.
      946           end.
      947         END CASE.
      948         if not v-eq
      949         then do:
      950           if not v-char = chr(32) then
      951           assign
      952           v-code = v-code + v-char
      953           .
      954         end.
      955         else do:
      956           if v-char <> "=":U
      957           then
      958           assign
      959           v-value = v-value + v-char
      960           .
      961         end.
      962       end.
      963       if v-code <> "":U then do:
      964         create buf_temp_xmlparse-attrs.
      965         assign
      966         buf_temp_xmlparse-attrs.field-name = p-field-name
      967         buf_temp_xmlparse-attrs.attr-code  = v-code
      968         buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
      969         .
      970       end.
      971     end.
      972   end procedure.
      973   FUNCTION cb-xmlparse-get-attr returns character (
      974         input p-handle        as handle
      975       , input p-field-name    as character
      976       , input p-field-value   as character
      977       , input p-attr-code     as character
      978       , input p-reparse       as logical
      979   ) :
      980   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
      981     do
      982     on error undo, return error
      983     :
      984       if p-reparse then do:
      985         run cb-xmlparse-attributes in this-procedure (
      986                                                       input p-handle
      987                                                     , input p-field-name
      988                                                     , input p-field-value) no-error .
      989         if error-status:error then return ? .
      990       end.
      991       find first buf_temp_xmlparse-attrs no-lock where
      992                 buf_temp_xmlparse-attrs.field-name = p-field-name
      993             AND buf_temp_xmlparse-attrs.attr-code   = p-attr-code no-error .
      994       if not avail buf_temp_xmlparse-attrs then return ?.
      995       return buf_temp_xmlparse-attrs.attr-value.
      996     end.
      997   end FUNCTION.
      998   FUNCTION cb-xmlparse-get-date returns date (
      999                                               input p-string as character):
     1000   define variable v-date as date.
     1001   if index(p-string, "-":U) = 0
     1002   or NOT (length(p-string) = 10
     1003           or
     1004           length(p-string) = 19)
     1005   then return error.
     1006   assign
     1007   v-date =  date(
     1008             int( substr( p-string, 6, 2 ) ) ,
     1009             int( substr( p-string, 9, 2 ) ),
     1010             int( substr( p-string, 1, 4 ) )
     1011               )
     1012   no-error .
     1013   if error-status:error then return error.
     1014   return v-date.
     1015   END FUNCTION.
     1016   FUNCTION cb-xmlparse-get-time returns integer (input p-string as character):
     1017   define variable v-time as integer no-undo .
     1018   define variable v-shift as integer no-undo .
     1019   if index(p-string, ":":U) = 0
     1020   or not (
     1021           length(p-string) = 19
     1022           or
     1023           length(p-string) = 8
     1024           )
     1025   then return error.
     1026   if length(p-string) = 19 then v-shift = 11.
     1027   assign
     1028   v-time =  int( substr( p-string, v-shift + 1, 2 ) ) * 3600 +
     1029             int( substr( p-string, v-shift + 4, 2 ) ) * 60  +
     1030             int( substr( p-string, v-shift + 7, 2) )
     1031   no-error .
     1032   if error-status:error then return error.
     1033   return v-time.
     1034   END FUNCTION.
     1035   define variable vss-include-info2 as character format "X(65)" no-undo
     1036   initial "@(#)$Workfile$ $Revision$".
     1037   define variable v-xmlvalid-error-mode       as character    no-undo.
     1038   define variable v-xmlvalid-tag-value        as character    no-undo.
     1039   define variable v-xmlvalid-current-level    as integer      no-undo.
     1040   define variable v-xmlvalid-in-tag           as logical      no-undo.
     1041   define variable v-xmlvalid-read-vartype     as logical      no-undo.
     1042   define temp-table temp_xmlvalid-taglist no-undo
     1043       field level-num as integer
     1044       field tag-name  as character
     1045       index lv  is primary unique level-num
     1046   .
     1047   define temp-table temp_xmlvalid-field-types no-undo
     1048       field field-name as character
     1049       field field-type as character
     1050       index fn is primary unique field-name
     1051   .
     1052   procedure xmlvalid :
     1053     do
     1054     on error undo, return error
     1055     :
     1056       def input parameter p-handle                as handle   no-undo.
     1057       def input parameter p-buffer-string         as char     no-undo.
     1058       def input parameter p-xmlvalid-error-mode   as char     no-undo.
     1059       assign
     1060           v-xmlvalid-error-mode   = p-xmlvalid-error-mode
     1061       .
     1062       run xmlparse in this-procedure (
     1063                 input p-handle
     1064               , input p-buffer-string
     1065               , input "call-all":U
     1066       ).
     1067     end.
     1068   end procedure.
     1069   procedure cb-xmlparse-tag-start-varType :
     1070   do
     1071   on error undo, return error
     1072   :
     1073   define input parameter p-param as character    no-undo.
     1074       assign
     1075           v-xmlvalid-read-vartype = yes
     1076       .
     1077       run cb-xmlparse-procedure-not-found in this-procedure (
     1078             input "tag-start":U
     1079           , input "varType":U
     1080           , input p-param
     1081       ).
     1082   end.
     1083   end procedure.
     1084   procedure cb-xmlparse-tag-end-varType :
     1085   do
     1086   on error undo, return error
     1087   :
     1088   define input parameter p-param as character    no-undo.
     1089       assign
     1090           v-xmlvalid-read-vartype = no
     1091       .
     1092       define variable v-vartype-list     as character         no-undo.
     1093       for each temp_xmlvalid-field-types
     1094       :
     1095           if index( "character,integer,decimal,date,logical", temp_xmlvalid-field-types.field-type ) = 0
     1096           then do:
     1097               run run-cb-xmlvalid-error  in this-procedure
     1098                                           (     input this-procedure :handle
     1099                                               , input "Замечание: Тип переменной в секции varType определен неверно. "
     1100                                                       + "Тэг " + temp_xmlvalid-field-types.field-name
     1101                                                       + " не будет проверен на соответствие типу данных"
     1102                                           ).
     1103               delete temp_xmlvalid-field-types.
     1104           end.
     1105           else do:
     1106                                           assign
     1107                                               v-vartype-list = v-vartype-list + temp_xmlvalid-field-types.field-name
     1108                                               + temp_xmlvalid-field-types.field-type + chr(10)
     1109                                           .
     1110           end.
     1111       end.
     1112       run cb-xmlparse-procedure-not-found in this-procedure (
     1113                                           input "tag-end":U
     1114                                           , input "varType":U
     1115                                           , input p-param
     1116                                                           ).
     1117   end.
     1118   end procedure.
     1119   procedure cb-xmlparse-procedure-not-found :
     1120   do
     1121   on error undo, return error
     1122   :
     1123   def input parameter p-tag-type      as char no-undo.
     1124   def input parameter p-tag-value     as char no-undo.
     1125   def input parameter p-param-value   as char no-undo.
     1126   def buffer buf_temp_xmlvalid-taglist for temp_xmlvalid-taglist.
     1127   def var v-found    as logical  no-undo.
     1128   if p-tag-type = "tag-start"
     1129   then do:
     1130       assign
     1131           v-xmlvalid-current-level = v-xmlvalid-current-level + 1
     1132           v-xmlvalid-in-tag        = yes
     1133       .
     1134       find first temp_xmlvalid-taglist
     1135            where temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     1136       no-error.
     1137       if not available temp_xmlvalid-taglist
     1138       then do:
     1139           create temp_xmlvalid-taglist.
     1140           assign
     1141               temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     1142           .
     1143       end.
     1144       assign
     1145           temp_xmlvalid-taglist.tag-name = p-tag-value
     1146           v-xmlvalid-tag-value = ""
     1147       .
     1148       if v-xmlvalid-read-vartype = yes and p-tag-value <> "varType":U
     1149       then do:
     1150           find first temp_xmlvalid-field-types
     1151                where temp_xmlvalid-field-types.field-name = p-tag-value
     1152           no-error.
     1153           if available temp_xmlvalid-field-types
     1154           then do:
     1155               run run-cb-xmlvalid-error  in this-procedure
     1156                                           (     input this-procedure :handle
     1157                                               , input "Замечание: Тип переменной в секции varType определен повторно"
     1158                                           ).
     1159           end.
     1160           else do:
     1161               create temp_xmlvalid-field-types.
     1162               assign
     1163                   temp_xmlvalid-field-types.field-name = p-tag-value
     1164               .
     1165           end.
     1166       end.
     1167   end.
     1168   if p-tag-type = "tag-end"
     1169   then do:
     1170       find first temp_xmlvalid-taglist
     1171            where temp_xmlvalid-taglist.level-num = v-xmlvalid-current-level
     1172              and temp_xmlvalid-taglist.tag-name  = p-tag-value
     1173       no-error.
     1174       if available temp_xmlvalid-taglist
     1175       then do:
     1176           assign
     1177               v-xmlvalid-current-level = v-xmlvalid-current-level - 1
     1178               v-xmlvalid-in-tag        = no
     1179           .
     1180       end.
     1181       else do:
     1182           if v-xmlvalid-error-mode = 'fatal'
     1183           then do:
     1184               run run-cb-xmlvalid-error  in this-procedure
     1185                                           (     input this-procedure :handle
     1186                                               , input "Ошибка: Попытка закрыть не открытый тэг"
     1187                                           ).
     1188           end.
     1189           else do:
     1190               find first temp_xmlvalid-taglist
     1191                    where temp_xmlvalid-taglist.tag-name = p-tag-value
     1192               no-error.
     1193               if not available temp_xmlvalid-taglist
     1194               then do:
     1195                   assign
     1196                       v-xmlvalid-tag-value = v-xmlvalid-tag-value + "</" + p-tag-value + ">" + chr(10)
     1197                   .
     1198               end.
     1199               else do:
     1200                   for each buf_temp_xmlvalid-taglist
     1201                      where buf_temp_xmlvalid-taglist.level-num > temp_xmlvalid-taglist.level-num
     1202                   :
     1203                       assign
     1204                           v-xmlvalid-tag-value = "<" + buf_temp_xmlvalid-taglist.tag-name + ">" + chr(10) + v-xmlvalid-tag-value
     1205                           v-xmlvalid-current-level = temp_xmlvalid-taglist.level-num - 1
     1206                       .
     1207                   end.
     1208               end.
     1209           end.
     1210       end.
     1211   end.
     1212   if p-tag-type = "text"
     1213   then do:
     1214       if v-xmlvalid-read-vartype = yes
     1215       then do:
     1216           if available temp_xmlvalid-field-types
     1217           then do:
     1218               assign
     1219                   temp_xmlvalid-field-types.field-type = v-xmlvalid-tag-value
     1220               .
     1221           end.
     1222       end.
     1223       else do:
     1224           find first temp_xmlvalid-field-types
     1225               where temp_xmlvalid-field-types.field-name = temp_xmlvalid-taglist.tag-name
     1226           no-error.
     1227           if available temp_xmlvalid-field-types
     1228           then do:
     1229           end.
     1230           else do:
     1231           end.
     1232       end.
     1233       assign
     1234           v-xmlvalid-tag-value = v-xmlvalid-tag-value + p-tag-value
     1235       .
     1236   end.
     1237   run run-cb-xmlvalid-procedure-not-found in this-procedure
     1238                                           (     input this-procedure :handle
     1239                                               , input p-tag-type
     1240                                               , input p-tag-value
     1241                                               , input p-param-value
     1242                                           ).
     1243   end.
     1244   end procedure.
     1245   procedure run-cb-xmlvalid-procedure-not-found :
     1246   do
     1247   on error undo, return error
     1248   :
     1249       def input parameter p-handle            as handle   no-undo.
     1250       def input parameter p-data-type         as char     no-undo.
     1251       def input parameter p-data-value        as char     no-undo.
     1252       def input parameter p-param-value       as char     no-undo.
     1253       if lookup("cb-xmlvalid-procedure-not-found", p-handle :internal-entries) > 0
     1254       then do:
     1255           run cb-xmlvalid-procedure-not-found in p-handle (   input p-data-type
     1256                                                             , input p-data-value
     1257                                                             , input p-param-value
     1258                                                           ) no-error.
     1259           if error-status :error
     1260           then do:
     1261               run run-cb-xmlvalid-error in this-procedure
     1262                                       (   input p-handle
     1263                                       ,   input "Ошибка при вызове программы cb-xmlvalid-procedure-not-found"
     1264                                       ).
     1265           end.
     1266       end.
     1267       else do:
     1268           run run-cb-xmlvalid-error in this-procedure
     1269                                   (   input p-handle
     1270                                   ,   input "Ошибка: Не определена программа cb-xmlvalid-procedure-not-found"
     1271                                   ).
     1272       end.
     1273   end.
     1274   end procedure.
     1275   procedure run-cb-xmlvalid-error :
     1276   do
     1277   on error undo, return error
     1278   :
     1279       def input parameter p-handle            as handle no-undo.
     1280       def input parameter p-error-message as char no-undo.
     1281       if lookup("cb-xmlvalid-error", p-handle :internal-entries) > 0
     1282       then do:
     1283           run cb-xmlvalid-error in p-handle  (input p-error-message).
     1284       end.
     1285   end.
     1286   end procedure.
     1287   procedure run-cb-xmlvalid-procedure :
     1288   do
     1289   on error undo, return error
     1290   :
     1291   def input parameter p-handle            as handle no-undo.
     1292   def input parameter p-procedure-name    as char no-undo.
     1293   def var v-data-type     as char no-undo.
     1294   def var v-data-value    as char no-undo.
     1295   def var v-param-value   as char no-undo.
     1296       if lookup( p-procedure-name, p-handle :internal-entries) > 0
     1297       then do:
     1298           run value(p-procedure-name) in p-handle no-error.
     1299           if error-status :error
     1300           then do:
     1301               run run-cb-xmlvalid-error in this-procedure
     1302                                       (   input p-handle
     1303                                       ,   input "Ошибка при вызове программы " + p-procedure-name
     1304                                       ).
     1305           end.
     1306       end.
     1307       else do:
     1308           if substring(p-procedure-name, 1, 20) = "cb-xmlvalid-tag-end-"
     1309           then do:
     1310               assign
     1311                   v-data-type     = "tag-end"
     1312                   v-data-value    = substring(p-procedure-name, 21)
     1313               .
     1314           end.
     1315           else do:
     1316               if substring(p-procedure-name, 1, 22) = "cb-xmlvalid-tag-start-"
     1317               then do:
     1318                   assign
     1319                       v-data-type     = "tag-start"
     1320                       v-data-value    = substring(p-procedure-name, 23)
     1321                   .
     1322               end.
     1323               else do:
     1324                   assign
     1325                       v-data-type     = "text"
     1326                       v-data-value    = p-procedure-name
     1327                   .
     1328               end.
     1329           end.
     1330           run run-cb-xmlvalid-procedure-not-found in this-procedure
     1331                                                  (   input p-handle
     1332                                                     , input v-data-type
     1333                                                     , input v-data-value
     1334                                                     , input v-param-value
     1335                                                   ).
     1336       end.
     1337   end.
     1338   end procedure.
     1339   define stream stmXMLOut.
     1340   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1341   define variable v-xml-file-name     as character            no-undo.
     1342   define variable v-xml-file-name-path as character            no-undo.
     1343   define variable v-log-file-name     as character            no-undo.
     1344   define variable v-locked            as logical              no-undo.
     1345   define variable v-log-string        as character            no-undo.
     1346   define variable v-oper-num          as integer              no-undo.
     1347   define variable v-obj-list          as character            no-undo.
     1348   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     1349   DEF VAR intRep      AS INT NO-UNDO.
     1350   define variable hEDT             AS HANDLE NO-UNDO.
     1351   define variable hCNT             AS HANDLE NO-UNDO.
     1352   procedure xml-cd-write-header:
     1353   do
     1354   on error undo, return error
     1355   :
     1356   define input parameter p-xml-file-name       as character    no-undo.
     1357   define input parameter p-xml-file-name-path  as character    no-undo.
     1358   define input parameter p-doc-name            as character    no-undo.
     1359   define input parameter p-version             as character    no-undo.
     1360   define input parameter p-obj-list            as character    no-undo.
     1361   define input parameter p-correspondent       as character    no-undo .
     1362   define input parameter p-write-header        as logical      no-undo .
     1363   define variable OS-time as character no-undo .
     1364   define variable id as character no-undo .
     1365   define buffer buf_db for ub.db.
     1366   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1367   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1368   assign
     1369   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1370   .
     1371   run bgelib-tag-open in this-procedure (
     1372                                        1
     1373                                       ,p-doc-name
     1374                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1375                                         ).
     1376   if p-write-header then do:
     1377     run bgelib-tag-open(2, "Header","").
     1378     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1379     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1380     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1381     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1382     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1383     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1384     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1385     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1386     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1387     run bgelib-tag-close( 2, "Header" ).
     1388   end.
     1389   output stream stmXMLOut close.
     1390   end.
     1391   end procedure.
     1392   procedure xml-cd-write-footer:
     1393   do
     1394   on error undo, return error
     1395   :
     1396   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1397   define input parameter p-xml-file-name as character    no-undo.
     1398   define input parameter p-doc-name      as character    no-undo .
     1399   define variable v-error-num     as integer           no-undo.
     1400   define variable v-md5-signature as character no-undo .
     1401   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1402   run bgelib-tag-close( 0, p-doc-name ).
     1403   put stream stmXMLOut unformatted skip.
     1404   output stream stmXMLOut close.
     1405   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1406   if v-error-num > 0
     1407   then do:
     1408      return error.
     1409   end.
     1410   if opsys = "unix"
     1411   then do:
     1412       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1413   end.
     1414   end.
     1415   end procedure.
     1416   procedure xml-cd-filename :
     1417   do
     1418   on error undo, return error
     1419   :
     1420   define input parameter  p-out               as character no-undo .
     1421   define output parameter p-xml-file-name     as character    no-undo.
     1422   define output parameter p-xml-file-name-path   as character    no-undo.
     1423   define output parameter p-log-file-name     as character    no-undo.
     1424   define output parameter p-locked            as logical      no-undo.
     1425   define variable v-out as character     no-undo.
     1426   define variable loc#log as logical no-undo .
     1427   define variable BadFlag as logical no-undo .
     1428   define variable fq as integer no-undo .
     1429   define variable v-remote as character no-undo .
     1430   assign
     1431   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1432   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1433   p-log-file-name = p-out + "actions.log"
     1434   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1435   .
     1436   end.
     1437   end procedure.
     1438   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1439   define variable v-date-str as character no-undo .
     1440   assign
     1441   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1442                string(Month(p-date), "99":U) + "-":U +
     1443                string(DAY(p-date), "99":U).
     1444   return v-date-str.
     1445   END FUNCTION.
     1446   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1447   define variable v-date-str as character no-undo .
     1448   assign
     1449   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1450                string(Month(p-date), "99":U) + "-":U +
     1451                string(DAY(p-date), "99":U) + chr(32) +
     1452                string(p-time, "HH:MM:SS").
     1453   return v-date-str.
     1454   END FUNCTION.
     1455   function string-to-date returns date ( input p-string  as character):
     1456     define variable v-date as date no-undo .
     1457     assign
     1458     v-date = date(integer(substring(p-string, 4, 2))
     1459                   ,integer(substring(p-string, 1, 2))
     1460                   ,integer(substring(p-string, 7, 4))
     1461                  ) no-error .
     1462     if error-status:error then return ?.
     1463     return v-date.
     1464   END FUNCTION.
     1465   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1466   define variable v-time as integer no-undo init ?.
     1467   define variable v-dop1 as character no-undo .
     1468   define variable v-dop2 as character no-undo .
     1469   assign
     1470   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1471   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1472   no-error .
     1473   if error-status:error then return ?.
     1474   assign
     1475   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1476             integer(entry(2, v-dop2, ";":U)) * 60 +
     1477             integer(entry(3, v-dop2, ";":U)) no-error .
     1478   return v-time.
     1479   END FUNCTION.
     1480   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1481   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
     1482   def var vl_bin as char no-undo init "".
     1483   if vl_int < 0 OR vl_int = ? then return ?.
     1484   do while vl_int > 0:
     1485     assign
     1486     vl_bin = (if vl_int modulo 2 = 0
     1487                 then "0":U
     1488                 else "1":U) + vl_bin
     1489     vl_int = truncate(vl_int / 2,0).
     1490   end.
     1491   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
     1492   END FUNCTION.
     1493   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
     1494                                    input vl_binm as character):
     1495   DEFINE VARIABLE vl_bin as character no-undo.
     1496   DEFINE VARIABLE ii as integer no-undo.
     1497   DEFINE VARIABLE ii-len as integer no-undo.
     1498   DEFINE VARIABLE ii-lenm as integer no-undo.
     1499   DEFINE VARIABLE mchar as character no-undo.
     1500   DEFINE VARIABLE ichar as character no-undo.
     1501   if vl_binm = ? then return ?.
     1502   vl_bin = CIntBinS(vl_int).
     1503   if vl_bin = ? then return ?.
     1504   assign
     1505   vl_binm = LEFT-TRIM(vl_binm, "X":U)
     1506   ii-lenm = LENGTH(vl_binm)
     1507   ii-len = LENGTH(vl_bin) - ii-lenm
     1508   .
     1509   if II-LENM > 32 THEN RETURN ?.
     1510   DO II = 1 to II-LENm:
     1511     assign
     1512     mchar = SUBSTR(vl_binm, ii, 1)
     1513     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
     1514     .
     1515     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
     1516     IF ichar <> mchar AND mchar <> "X":U then return no.
     1517   END.
     1518   return yes.
     1519   END FUNCTION.
