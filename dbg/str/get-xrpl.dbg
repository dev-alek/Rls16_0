      301                       then do:
      302                           assign
      303                               p-out-string = p-out-string + " ":U
      304                           .
      305                       end.
      306                       when chr(5)
      307                       then do:
      308                           assign
      309                               p-out-string = p-out-string + " ":U
      310                           .
      311                       end.
      312                       when chr(6)
      313                       then do:
      314                           assign
      315                               p-out-string = p-out-string + " ":U
      316                           .
      317                       end.
      318                       when chr(7)
      319                       then do:
      320                           assign
      321                               p-out-string = p-out-string + " ":U
      322                           .
      323                       end.
      324                       when chr(8)
      325                       then do:
      326                           assign
      327                               p-out-string = p-out-string + " ":U
