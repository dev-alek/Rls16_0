     2313               run waitfram-hide in this-procedure .
     2314               var-mes =
     2315               vss-workfile + chr(32) + vss-revision + chr(32) + vss-description + chr(10) +
     2316               "Ошибка при определении фактического номера МЦ!" + chr(10) +
     2317               "doc-code"   + buf_out_wth-doc.doc-code + chr(10) +
     2318               "fact-date"  + string( d_fact-date) + chr(10) +
     2319               "fact-time"  + string(j_fact-time, "HH:MM:SS")  + chr(10) +
     2320               "fact-num"   + string(j_fact-num) + chr(10) +
     2321               "shift-date" + string( buf_out_wth-doc.shift-date) + chr(10) +
     2322               "shift-name" +  string(buf_out_wth-doc.shift-name) + chr(10) +
     2323               "shift-num"  +  string(buf_out_wth-doc.shift-num) + chr(10) +
     2324               "d-fact-order" + string(d-fact-ord) + chr(10) +
     2325               "d-shift-order" + string(d-shift-ord) + chr(10) +
     2326               "day-end-order" + string(day-end-ord) + chr(10) +
     2327               ERROR-STATUS:GET-MESSAGE( 1 ) + chr(10) + RETURN-VALUE.
     2328               if par-talk then
     2329               MESSAGE
     2330               var-mes
     2331               VIEW-AS ALERT-BOX ERROR.
     2332               UNDO Main-Block, RETURN ERROR var-mes.
     2333             END.
     2334             ASSIGN
     2335             buf_out_wth-doc.status_    = 'факт':U
     2336             buf_out_wth-doc.fact-date  = d_fact-date
     2337             buf_out_wth-doc.fact-time  = j_fact-time
     2338             buf_out_wth-doc.fact-num   = j_fact-num
     2339             buf_out_wth-doc.fact-order = d-fact-ord
     2340             buf_out_wth-doc.is-back-date = buf_wth-doc.is-back-date
     2341             .
     2342             run str/stkotwth.p ( INPUT RECID( buf_out_wth-doc ),
     2343                                  INPUT YES,
     2344                                  input yes,
     2345                                  input 0 ) NO-ERROR.
     2346             IF ERROR-STATUS:ERROR THEN DO:
     2347               run waitfram-hide in this-procedure .
     2348               var-mes = var-mes + ERROR-STATUS:GET-MESSAGE( 1 ) + chr(10) + RETURN-VALUE.
     2349               if par-talk then
     2350               MESSAGE
     2351               var-mes
     2352               VIEW-AS ALERT-BOX ERROR.
     2353               UNDO Main-Block, RETURN ERROR var-mes.
     2354             END.
     2355           end.
     2356           release buf_out_wth-doc no-error .
     2357           if error-status:error then do:
     2358               run waitfram-hide in this-procedure .
     2359               var-mes = var-mes + ERROR-STATUS:GET-MESSAGE( 1 ) + chr(10) + RETURN-VALUE.
     2360               if par-talk then
     2361               MESSAGE
     2362               var-mes
     2363               VIEW-AS ALERT-BOX ERROR.
     2364               UNDO Main-Block, RETURN ERROR var-mes.
     2365           end.
     2366           if v-is-back-date then do:
     2367                       DEFINE VARIABLE v-today as date no-undo .
     2368             DEFINE VARIABLE v-time as integer no-undo .
     2369             run cur-time in this-procedure ( output v-today, output v-time).
     2370             FOR EACH buf_wth-line NO-LOCK WHERE
     2371             buf_wth-line.doc-code = buf_wth-doc.doc-code ON ERROR UNDO Main-Block, RETURN ERROR :
     2372               run str/reclcwtl.p
     2373                 (input parobj-type
     2374                 ,input parobj-code
     2375                 ,input v-recalc-fact-ord
     2376                 ,input buf_wth-line.wth-code
     2377                 ,input no
     2378                 ,input 'close':U
     2379                 ,input v-wth-doc-code
     2380                 ,input d_fact-date
     2381                 ,input g#db-num
     2382                 ,input g#userid
     2383                 ,input v-today
     2384                 ,input v-time
     2385                 ,input string(v-time, "HH:MM:SS")
     2386                 ) no-error .
     2387               if error-status :error then do:
     2388                 var-mes = substitute("&1 &2 &3&4" +
     2389                                       "Ошибка при пересчете остатков при закрытии док-та МЦ &5 задним числом&4"  +
     2390                                       "&6&4&7"
     2391                                       ,vss-workfile
     2392                                       ,vss-revision
     2393                                       ,vss-description
     2394                                       ,chr(10)
     2395                                       ,error-status :get-message(1)
     2396                                       , return-value ).
     2397                 if par-talk then
     2398                 MESSAGE
     2399                 var-mes
     2400                 VIEW-AS ALERT-BOX ERROR.
     2401                 UNDO Main-Block, RETURN ERROR var-mes.
     2402               end.
     2403             end.
     2404           end.
     2405           release buf_wth-doc no-error.
     2406           if error-status:error then do:
     2407               run waitfram-hide in this-procedure .
     2408               var-mes = var-mes + ERROR-STATUS:GET-MESSAGE( 1 ) + chr(10) + RETURN-VALUE.
     2409               if par-talk then
     2410               MESSAGE
     2411               var-mes
     2412               VIEW-AS ALERT-BOX ERROR.
     2413               UNDO Main-Block, RETURN ERROR var-mes.
     2414           end.
     2415           end.
     2416         END.
     2417         if var-status_ =  'факт':U THEN DO:
     2418           run waitfram-hide in this-procedure .
     2419           var-mes  = "Документ закрыт на ФАКТ! ".
     2420           IF par-talk THEN DO:
     2421             MESSAGE var-mes
     2422             VIEW-AS ALERT-BOX ERROR.
     2423           END.
     2424           UNDO Main-Block, RETURN ERROR var-mes.
     2425         END.
     2426     END.
     2427     ELSE IF par-mode = "-":U THEN DO:
     2428       CASE buf_wth-doc.status_:
     2429         when 'факт':U then do:
     2430           var-mes = "Нельзя открыть документ в статусе" +  chr(32) + buf_wth-doc.status_.
     2431           run waitfram-hide in this-procedure .
     2432           IF par-talk THEN DO:
     2433             MESSAGE var-mes
     2434             VIEW-AS ALERT-BOX ERROR.
     2435           END.
     2436           UNDO Main-Block, RETURN ERROR var-mes.
     2437         end.
     2438         when 'разрешен':U THEN DO:
     2439           ASSIGN
     2440           buf_wth-doc.status_ = 'накл':U.
     2441         END.
     2442         when 'накл':U THEN DO:
     2443           var-mes = "Документ открыт!".
     2444           run waitfram-hide in this-procedure .
     2445           IF par-talk THEN DO:
     2446             MESSAGE var-mes
     2447             VIEW-AS ALERT-BOX ERROR.
     2448           END.
     2449           run waitfram-hide in this-procedure .
     2450           UNDO Main-Block, RETURN ERROR var-mes.
     2451         end.
     2452       END CASE.
     2453     END.
     2454     run waitfram-hide in this-procedure .
     2455   END.
     2456   procedure corr-date:
     2457   define input parameter parobj-type    like ub.trn-doc.obj-type   no-undo.
     2458   define input parameter parobj-code    like ub.trn-doc.obj-code   no-undo.
     2459   define input parameter parfact-date   like ub.trn-doc.fact-date  no-undo.
     2460   define input parameter parshift-date  like ub.trn-doc.shift-date no-undo.
     2461   define input parameter parshift-num   like ub.trn-doc.shift-num  no-undo.
     2462   define input parameter parshift-name  like ub.trn-doc.shift-name no-undo.
     2463   define variable l-shift-on as logical no-undo .
     2464   define buffer bf_shift-obj for ub.shift-obj.
     2465   do on error undo, return error return-value :
     2466   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2467   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2468     (input  parobj-type
     2469     ,input  parobj-code
     2470     ,input  'shift-on=request'
     2471     ,output l-shift-on
     2472     )  .
     2473   if l-shift-on = yes
     2474   then do:
     2475     find first bf_shift-obj where bf_shift-obj.obj-type   = parobj-type   and
     2476                                   bf_shift-obj.obj-code   = parobj-code   and
     2477                                   bf_shift-obj.shift-date = parshift-date and
     2478                                   bf_shift-obj.shift-num  = parshift-num  no-lock no-error.
     2479     if not available bf_shift-obj
     2480     then do:
     2481       run waitfram-hide in this-procedure no-error.
     2482       undo, return error substitute( "Нет смены &1 &2 на объекте &3 &4.", parshift-date, parshift-name + string(parshift-num), parobj-type, parobj-code).
     2483     end.
     2484     if bf_shift-obj.status_ <> 'зкр':U  and
     2485        bf_shift-obj.status_ <> 'тек':U
     2486     then do:
     2487       run waitfram-hide in this-procedure no-error.
     2488       undo, return error substitute( "Смена &1 &2 на объекте &3 &4 имеет статус &5. Оформлять документы можно только в смене со статусом &6 или &7.",
     2489                                 bf_shift-obj.shift-date,
     2490                                 bf_shift-obj.shift-name + string(bf_shift-obj.shift-num),
     2491                                 bf_shift-obj.obj-type,
     2492                                 bf_shift-obj.obj-code,
     2493                                 bf_shift-obj.status_,
     2494                                 'зкр':U,
     2495                                 'тек':U).
     2496     end.
     2497     if parfact-date < bf_shift-obj.open-date
     2498     then do:
     2499       run waitfram-hide in this-procedure no-error.
     2500       undo, return error substitute( "Фактическая дата документа должна быть больше либо равна дате открытия смены. Фактическая дата: &1. Дата открытия смены &2 &3 на объекте &4 &5: &6.",
     2501                                parfact-date,
     2502                                bf_shift-obj.shift-date,
     2503                                bf_shift-obj.shift-name + string(bf_shift-obj.shift-num),
     2504                                bf_shift-obj.obj-type,
     2505                                bf_shift-obj.obj-code,
     2506                                bf_shift-obj.open-date).
     2507     end.
     2508     if bf_shift-obj.status_ = 'зкр':U
     2509     then do:
     2510       if parfact-date > bf_shift-obj.close-date
     2511       then do:
     2512         run waitfram-hide in this-procedure no-error.
     2513         undo, return error substitute( "Фактическая дата документа должна быть меньше либо равна дате закрытия смены. Фактическая дата: &1. Дата закрытия смены &2 &3 на объекте &4 &5: &6.",
     2514                                  parfact-date,
     2515                                  bf_shift-obj.shift-date,
     2516                                  bf_shift-obj.shift-name + string(bf_shift-obj.shift-num),
     2517                                  bf_shift-obj.obj-type,
     2518                                  bf_shift-obj.obj-code,
     2519                                  bf_shift-obj.close-date).
     2520       end.
     2521     end.
     2522   end.
     2523   end.
     2524   end procedure.
     2525   if v-warning then return 'warning':U.
