     1807                     then
     1808                     string(
     1809                     "Сумма расхождений по номиналам=" + string(varfact-sum-dtl) + chr(32) +
     1810                     "Сумма расхождений по строке=" + string(buf_wth-line.fact-sum)
     1811                     )
     1812                     else
     1813                     string(
     1814                     "Сумма факт по номиналам=" + string(varfact-sum-dtl) + chr(32) +
     1815                     "Сумма факт по строке=" + string(buf_wth-line.fact-sum))
     1816                     ).
     1817           if par-talk then
     1818           message var-mes
     1819           view-as alert-box error .
     1820           UNDO Main-Block,  return error var-mes.
     1821         end.
     1822       end.
     1823       if varbef-sum-dtl <> buf_wth-line.bef-sum then do:
     1824         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1825                   "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1826                   "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1827                   "Сумма по номиналам не равна сумме по строке" + chr(32) +  chr(10) +
     1828                   "Сумма план по номиналам=" + string(varbef-sum-dtl) + chr(32) +
     1829                   "Сумма план по строке=" + string(buf_wth-line.bef-sum).
     1830         if par-talk then
     1831         message var-mes
     1832         view-as alert-box error .
     1833         UNDO Main-Block,  return error var-mes.
     1834       end.
     1835       if buf_wth-doc.doc-type = 'инв':U then do:
     1836         if buf_wth-doc.status_ = 'факт':U then do:
     1837           if varaft-sum-dtl <> buf_wth-line.aft-sum then do:
     1838             var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1839                       "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1840                       "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1841                       "Сумма по номиналам не равна сумме по строке" + chr(32) +  chr(10) +
     1842                       "Сумма факт по номиналам=" + string(varaft-sum-dtl) + chr(32) +
     1843                       "Сумма факт по строке=" + string(buf_wth-line.aft-sum).
     1844             if par-talk then
