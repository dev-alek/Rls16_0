     1846             view-as alert-box error .
     1847             UNDO Main-Block,  return error var-mes.
     1848           end.
     1849         end.
     1850       end.
     1851       if varsum-gds-rubl-dtl <> buf_wth-line.sum-gds-rubl then do:
     1852         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1853                   "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1854                   "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1855                   "Сумма по связанным товарам в рублях  по номиналам не равна сумме по строке" + chr(32) + chr(10) +
     1856                   "Сумма по связанным товарам в рублях  по номиналам=" + string(varsum-gds-rubl-dtl) + chr(32) +
     1857                   "Сумма по связанным товарам в рублях  по строке=" + string(buf_wth-line.sum-gds-rubl).
     1858         if par-talk then
     1859         message var-mes
