     1907                 "Сумма факт по строкам=" + string(varfact-sum-line) + chr(32) +
     1908                 "Сумма факт по шапке=" + string(buf_wth-doc.fact-sum))
     1909                 ).
     1910       if par-talk then
     1911       message var-mes
     1912       view-as alert-box error .
     1913       UNDO Main-Block,  return error var-mes.
     1914     end.
     1915   end.
     1916   if varbef-sum-line <> buf_wth-doc.bef-sum then do:
     1917     var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1918               "Сумма по строкам не равна сумме по шапке" + chr(32) + chr(10) +
     1919               "Сумма план по строкам=" + string(varbef-sum-line) + chr(32) +
     1920               "Сумма план по шапке=" + string(buf_wth-doc.bef-sum).
