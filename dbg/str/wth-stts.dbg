                      stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      810   end procedure.
      811   FUNCTION get-curr RETURNS CHARACTER
      812     (buffer loc-wealth for ub.wealth ) :
      813   define buffer buf_currency for ub.currency.
      814   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      815   return loc-wealth.unit-base.
      816   FIND FIRST buf_currency no-lock where
      817             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      818   if avail buf_currency then
      819     RETURN buf_currency.curr-abbr.
      820   else return "".
      821   END FUNCTION.
      822   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   procedure cur-time :
      824      define output parameter p-today as date      no-undo .
      825      define output parameter p-time  as integer   no-undo .
      826     do
      827     on error undo, return error
      828     :
      829       define variable v-date1 as date      no-undo .
      830       define variable v-date2 as date      no-undo .
      831       define variable v-time  as integer   no-undo .
      832       assign
      833         v-date1 = today
      834         v-time  = time
      835         v-date2 = today
      836       .
      837       if v-date1 <> v-date2
      838       then do:
      839         assign
      840           v-date1 = today
      841           v-time  = v-time
      842         .
      843       end.
      844       assign
      845         p-today = v-date1
      846         p-time  = v-time
      847       .
      848     end.
      849   end.
      850   function cur-time-date returns character
      851   :
      852     return string(today, '99/99/9999':U) .
      853   end.
      854   function cur-time-mjd returns decimal
      855   :
      856     define variable v-date as date      no-undo .
      857     define variable v-time as integer   no-undo .
      858     run cur-time in this-procedure
      859       (output v-date
      860       ,output v-time
      861       ) .
      862     return integer(v-date) - 2400002 + (v-time / 86400) .
      863   end.
      864   function cur-time-get-ending-index returns integer
      865   (input p-number as integer
      866   )
      867   :
      868     if p-number < 0
      869     or p-number = ?
      870     then do:
      871       return 1 .
      872     end.
      873     define variable v-rest as integer   no-undo .
      874     assign
      875       p-number = p-number modulo 100
      876     .
      877     if p-number < 20
      878     then do:
      879       assign
      880         v-rest = p-number
      881       .
      882     end.
      883     else do:
      884       assign
      885         v-rest = p-number modulo 10
      886       .
      887     end.
      888     case v-rest :
      889       when 1
      890       then do:
      891         return 2 .
      892       end.
      893       when 2 or
      894       when 3 or
      895       when 4
      896       then do:
      897         return 3 .
      898       end.
      899       otherwise do:
      900         return 1 .
      901       end.
      902     end case .
      903   end.
      904   procedure cur-time-mjd-to-date :
      905      define input  parameter i-mjd-diff as decimal no-undo.
      906      define output parameter o-Date     as date    no-undo.
      907      define output parameter o-Time     as integer no-undo.
      908      define variable v-day-number as integer   no-undo .
      909      if    i-mjd-diff < 0
      910         or i-mjd-diff = ?
      911      then do:
      912         return "?" .
      913      end.
      914      assign
      915         v-day-number = truncate(i-mjd-diff,0).
      916         o-Date = date(v-day-number + 2400002).
      917         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      918     .
      919   end.
      920   function cur-time-mjd-to-string returns character
      921   (input p-mjd-diff as decimal
      922   )
      923   :
      924     define variable v-day-number as integer   no-undo .
      925     define variable v-seconds    as integer   no-undo .
      926     define variable v-hour       as integer   no-undo .
      927     define variable v-min        as integer   no-undo .
      928     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      929     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      930     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      931     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      932     if p-mjd-diff < 0
      933     or p-mjd-diff = ?
      934     then do:
      935       return "?" .
      936     end.
      937     assign
      938       v-day-number = integer(truncate(p-mjd-diff,0))
      939       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      940     .
      941     if v-seconds > 86400
      942     then do:
      943       assign
      944         v-seconds = 86400 - 1
      945       .
      946     end.
      947     if v-seconds < 0
      948     then do:
      949       assign
      950         v-seconds = 0
      951       .
      952     end.
      953     assign
      954       v-hour = truncate(v-seconds / 3600, 0)
      955     .
      956     assign
      957       v-seconds = v-seconds modulo 3600
      958     .
      959     assign
      960       v-min = truncate(v-seconds / 60, 0)
      961     .
      962     assign
      963       v-seconds = v-seconds modulo 60
      964     .
      965     return
      966         (if v-day-number <> 0
      967           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      968           else ""
      969         )
      970       + (if v-day-number <> 0 or v-hour <> 0
      971           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      972           else ""
      973         )
      974       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      975           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      976           else ""
      977         )
      978       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      979       .
      980   end.
      981   function cur-time-string returns character
      982   :
      983     define variable v-date as date      no-undo .
      984     define variable v-time as integer   no-undo .
      985     run cur-time in this-procedure
      986       (output v-date
      987       ,output v-time
      988       ) .
      989     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      990   end.
      991   function cur-time-string-sec returns character
      992   :
      993     define variable v-date as date      no-undo .
      994     define variable v-time as integer   no-undo .
      995     run cur-time in this-procedure
      996       (output v-date
      997       ,output v-time
      998       ) .
      999     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1000   end.
     1001   function cur-time-custom  returns character
     1002   (input p-prefix as character
     1003   ,input p-date-format as character
     1004   ,input p-delimiter as character
     1005   ,input p-time-format as character
     1006   ,input p-suffix as character
     1007   )
     1008   :
     1009     define variable v-date as date      no-undo .
     1010     define variable v-time as integer   no-undo .
     1011     run cur-time in this-procedure
     1012       (output v-date
     1013       ,output v-time
     1014       ) .
     1015     return
     1016       p-prefix
     1017       + string(v-date, p-date-format)
     1018       + p-delimiter
     1019       + string(v-time, p-time-format)
     1020       + p-suffix
     1021       .
     1022   end.
     1023   function cur-time-print  returns character
     1024   :
     1025     define variable v-date as date      no-undo .
     1026     define variable v-time as integer   no-undo .
     1027     run cur-time in this-procedure
     1028       (output v-date
     1029       ,output v-time
     1030       ) .
     1031     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1032   end.
     1033   function cur-time-datetime returns datetime
     1034   :
     1035     define variable v-char as character no-undo .
     1036     define variable v-datetime as datetime no-undo .
     1037     v-char = cur-time-string().
     1038     v-datetime = datetime(v-char).
     1039     return  v-datetime.
     1040   end.
     1041   function cur-time-string-msec returns character
     1042   :
     1043     define variable v-date as datetime  no-undo .
     1044     v-date = now.
     1045     return string(v-date) .
     1046   end.
     1047   DEFINE VARIABLE j_fact-num  LIKE ub.wth-doc.fact-num   NO-UNDO.
     1048   DEFINE VARIABLE j_fact-time LIKE ub.wth-doc.fact-time  NO-UNDO.
     1049   DEFINE VARIABLE d_fact-date LIKE ub.wth-doc.fact-date  NO-UNDO.
     1050   DEFINE VARIABLE d-fact-ord  LIKE ub.wth-doc.fact-order NO-UNDO.
     1051   DEFINE VARIABLE d-shift-ord LIKE ub.wth-doc.fact-order NO-UNDO.
     1052   DEFINE VARIABLE day-end-ord LIKE ub.wth-doc.fact-order NO-UNDO.
     1053   define variable v-obj-date  as date no-undo .
     1054   define variable v-obj-shift-date as date no-undo .
     1055   define variable v-obj-shift-num as integer no-undo .
     1056   define variable v-obj-shift-name as character no-undo .
     1057   DEFINE VARIABLE l-shift-on  AS   LOGICAL               NO-UNDO.
     1058   DEFINE VARIABLE var-mes as character no-undo .
     1059   DEFINE VARIABLE l-need-check-inv as logical no-undo init false .
     1060   DEFINE VARIABLE l-fact-close as logical no-undo .
     1061   DEFINE VARIABLE loc#log as logical no-undo .
     1062   DEFINE VARIABLE  not-all-doced as logical init no.
     1063   DEFINE VARIABLE not-all-normal as logical init no.
     1064   DEFINE VARIABLE  not-all-closed as logical no-undo init no.
     1065   DEFINE VARIABLE var-status_ like ub.wth-doc.status_ no-undo .
     1066   DEFINE VARIABLE varchk-doc-exist as logical no-undo .
     1067   define variable v-rec as recid no-undo .
     1068   define variable v-notes as character no-undo .
     1069   define variable v-vararh-mode  as integer      no-undo.
     1070   define variable v-warning    as logical      no-undo.
     1071   define variable v-is-back-date as logical no-undo .
     1072   define variable v-recalc-fact-ord as decimal no-undo .
     1073   define variable v-wth-doc-code as character no-undo .
     1074   define variable v-fact-date as date no-undo .
     1075   define variable var-log     as logical no-undo .
     1076   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1077   DEFINE VARIABLE vardoc-sum-dtl like ub.wth-dtl.doc-sum no-undo .
     1078   DEFINE VARIABLE varfact-sum-dtl like ub.wth-dtl.fact-sum no-undo .
     1079   DEFINE VARIABLE varbef-sum-dtl like ub.wth-dtl.bef-sum no-undo .
     1080   DEFINE VARIABLE varaft-sum-dtl like ub.wth-dtl.aft-sum no-undo .
     1081   DEFINE VARIABLE vardoc-sum-line like ub.wth-line.doc-sum no-undo .
     1082   DEFINE VARIABLE varfact-sum-line like ub.wth-line.fact-sum no-undo .
     1083   DEFINE VARIABLE varbef-sum-line like ub.wth-line.bef-sum no-undo .
     1084   DEFINE VARIABLE varaft-sum-line like ub.wth-line.aft-sum no-undo .
     1085   DEFINE VARIABLE varsum-gds-rubl-line  like ub.wth-line.sum-gds-rubl no-undo .
     1086   DEFINE VARIABLE varsum-gds-base-line  like ub.wth-line.sum-gds-base no-undo .
     1087   DEFINE VARIABLE varsum-gds-rubl-dtl   like ub.wth-dtl.sum-gds-rubl no-undo .
     1088   DEFINE VARIABLE varsum-gds-base-dtl   like ub.wth-dtl.sum-gds-base no-undo .
     1089   DEFINE VARIABLE varsum-gds-rubl-parts like ub.wth-dtl.sum-gds-rubl no-undo .
     1090   DEFINE VARIABLE varsum-gds-base-parts like ub.wth-dtl.sum-gds-base no-undo .
     1091   DEFINE VARIABLE varis-dtl as logical no-undo .
     1092   DEFINE VARIABLE varis-part as logical no-undo .
     1093   DEFINE VARIABLE varinst-sum like ub.chk-pay.tot-sum no-undo .
     1094   DEFINE VARIABLE varchk-type like ub.chk-doc.chk-type no-undo .
     1095   define buffer check_chk-pay for ub.chk-pay .
     1096   define buffer check_chk-doc for ub.chk-doc .
     1097   define buffer bufdsum_wealth   for ub.wealth.
     1098   define buffer buf_clients   FOR ub.clients.
     1099   define buffer buf_wth-line  FOR ub.wth-line.
     1100   define buffer buf_wth-dtl   FOR ub.wth-dtl.
     1101   define buffer buf_wth-obj   FOR ub.wth-obj.
     1102   define buffer buf_wth-parts for ub.wth-parts.
     1103   define buffer buf_wealth    for ub.wealth.
     1104   define buffer buf_sysconf   FOR ub.sysconf.
     1105   define buffer buf_out_wth-doc for ub.wth-doc.
     1106   IF NOT AVAIL buf_wth-doc THEN DO:
     1107     var-mes = "Документ движения МЦ не найден!".
     1108     IF par-talk
     1109     then
     1110     MESSAGE var-mes VIEW-AS ALERT-BOX ERROR.
     1111     RETURN ERROR var-mes.
     1112   END.
     1113   ELSE DO:
     1114     ASSIGN v-rec = RECID( buf_wth-doc ).
     1115   END.
     1116   assign
     1117   v-wth-doc-code = buf_wth-doc.doc-code.
     1118   IF buf_wth-doc.status_ = 'факт':U THEN DO:
     1119     var-mes = "Документ " + buf_wth-doc.doc-code + " уже закрыт на ФАКТ!".
     1120     IF par-talk
     1121     then
     1122     MESSAGE var-mes VIEW-AS ALERT-BOX ERROR.
     1123     RETURN error var-mes.
     1124   END.
     1125   run waitfram-show in this-procedure ( Input "Ждите..." ).
     1126   if buf_wth-doc.doc-type = 'декл':U then
     1127   l-need-check-inv  = no.
     1128   if buf_wth-doc.doc-type = 'инв':U and
     1129      buf_wth-doc.status_ = 'накл':U and
     1130      par-mode = "+":U then
     1131      l-need-check-inv  = yes
     1132      .
     1133   if buf_wth-doc.doc-type = 'инв':U and
     1134      buf_wth-doc.status_ = 'разрешен':U and
     1135      par-mode = "+":U then
     1136      l-need-check-inv  = no
     1137      .
     1138   if buf_wth-doc.doc-type = 'инв':U and
     1139      buf_wth-doc.status_ = 'разрешен':U and
     1140      par-mode = "-":U then
     1141      l-need-check-inv  = no
     1142      .
     1143   if buf_wth-doc.auto-fill then do:
     1144   FIND FIRST buf_sysconf No-LOCK WHERE
     1145              buf_sysconf.host-code = buf_wth-doc.host-code No-ERROR.
     1146   if not available buf_sysconf then return error.
     1147   if buf_wth-doc.cli-type = buf_sysconf.sale-type AND
     1148      buf_wth-doc.cli-code = buf_sysconf.sale-code then
     1149      varchk-doc-exist = no.
     1150    else varchk-doc-exist = yes.
     1151   end.
     1152   find first ub.sys-ctrl No-LOCK.
     1153   Main-Block:
     1154   DO TRANSACTION ON ERROR UNDO Main-Block, RETURN ERROR :
     1155     FIND buf_wth-doc EXCLUSIVE-LOCK WHERE
     1156          RECID( buf_wth-doc ) = v-rec.
     1157   l-fact-close = (if (buf_wth-doc.status_ = 'разрешен':U or buf_wth-doc.auto-fill) and par-mode = "+":U
     1158                   then yes
     1159                   else no).
     1160   if l-fact-close and
     1161      buf_wth-doc.auto-fill = yes and
     1162      varchk-doc-exist then do:
     1163       run str/chk-winf.p (
     1164                   input parparentproc
     1165                  ,input buf_wth-doc.host-code
     1166                  ,input buf_wth-doc.obj-type
     1167                  ,input buf_wth-doc.obj-code
     1168                  ,INPUT no
     1169                  ,INPUT yes
     1170                  ,INPUT recid(buf_wth-doc)
     1171                  ,output v-notes
     1172                  ,output not-all-doced
     1173                  ,output not-all-normal
     1174                  ,output not-all-closed) no-error.
     1175       if error-status:error  then do:
     1176          run waitfram-hide in this-procedure .
     1177          return error.
     1178       end.
     1179       if par-talk then do:
     1180         message
     1181         v-notes skip
     1182         "Закрытие автодокумента МЦ" +
     1183         ( if ub.sys-ctrl.db-num <> 0 then " и отправка его в офис." else "." ) skip (2)
     1184         "Вы уверены ?" skip (2)
     1185         "Закрытый документ нельзя исправить или удалить." skip
     1186         "Чтобы ПРОВЕРИТЬ ДОКУМЕНТ еще раз, выберите CANCEL."
     1187         view-as alert-box question buttons OK-Cancel update loc#log.
     1188         if NOT loc#log  then do:
     1189             run waitfram-hide in this-procedure .
     1190             return error.
     1191         end.
     1192       end.
     1193    end.
     1194     run trg/lock-wth.p
     1195       (input buf_wth-doc.doc-code
     1196       ,input l-need-check-inv
     1197       ,input 0
     1198       ,input l-fact-close
     1199       ,input false
     1200       ) no-error.
     1201     if error-status :error then do:
     1202       run waitfram-hide in this-procedure .
     1203       undo Main-Block, return error .
     1204     end.
     1205     if buf_wth-doc.doc-type <> 'обмен':U then do:
     1206   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   assign
     1208   vardoc-sum-dtl = 0
     1209   varfact-sum-dtl = 0
     1210   varbef-sum-dtl = 0
     1211   varaft-sum-dtl = 0
     1212   vardoc-sum-line = 0
     1213   varfact-sum-line = 0
     1214   varbef-sum-line = 0
     1215   varaft-sum-line = 0
     1216   varinst-sum = 0
     1217   varsum-gds-rubl-line = 0
     1218   varsum-gds-base-line = 0
     1219   varsum-gds-rubl-dtl = 0
     1220   varsum-gds-base-dtl = 0
     1221   varsum-gds-rubl-parts = 0
     1222   varsum-gds-base-parts = 0
     1223   .
     1224   FOR EACH buf_wth-line No-LOCK WHERE
     1225            buf_wth-line.doc-code = buf_wth-doc.doc-code:
     1226     assign
     1227     vardoc-sum-dtl = 0
     1228     varfact-sum-dtl = 0
     1229     varbef-sum-dtl = 0
     1230     varaft-sum-dtl = 0
     1231     varsum-gds-rubl-dtl = 0
     1232     varsum-gds-base-dtl = 0
     1233     varis-dtl = no
     1234     .
     1235     FOR EACH buf_wth-dtl No-LOCK WHERE
     1236              buf_wth-dtl.doc-code = buf_wth-line.doc-code AND
     1237              buf_wth-dtl.wth-code = buf_wth-line.wth-code AND
     1238              buf_wth-dtl.w-p-code = buf_wth-line.w-p-code:
     1239       assign
     1240       varis-dtl = yes
     1241       vardoc-sum-dtl = vardoc-sum-dtl + buf_wth-dtl.doc-sum
     1242       varfact-sum-dtl = varfact-sum-dtl + buf_wth-dtl.fact-sum
     1243       varbef-sum-dtl = varbef-sum-dtl + buf_wth-dtl.bef-sum
     1244       varaft-sum-dtl = varaft-sum-dtl + buf_wth-dtl.aft-sum
     1245       varsum-gds-rubl-dtl = varsum-gds-rubl-dtl + buf_wth-dtl.sum-gds-rubl
     1246       varsum-gds-base-dtl = varsum-gds-base-dtl + buf_wth-dtl.sum-gds-base
     1247       .
     1248       assign varsum-gds-rubl-parts = 0
     1249       varsum-gds-base-parts = 0
     1250       varis-part = no.
     1251       for each buf_wth-parts no-lock where
     1252         buf_wth-parts.w-p-code = buf_wth-dtl.w-p-code and
     1253         buf_wth-parts.wth-code = buf_wth-dtl.wth-code and
     1254         buf_wth-parts.par-code = buf_wth-dtl.par-code and
     1255         buf_wth-parts.out-code = buf_wth-dtl.doc-code and
     1256         buf_wth-parts.stts = 0 :
     1257         assign
     1258         varis-part = yes
     1259         varsum-gds-rubl-parts = varsum-gds-rubl-parts + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1260         varsum-gds-base-parts = varsum-gds-base-parts + buf_wth-parts.fact-qnty * buf_wth-parts.price-base
     1261         .
     1262       end.
     1263       if varis-part or can-find(first bufdsum_wealth where bufdsum_wealth.wth-code = buf_wth-dtl.wth-code and bufdsum_wealth.is-ser = 1 no-lock  ) then do:
     1264         if varsum-gds-rubl-parts <> buf_wth-dtl.sum-gds-rubl then do:
     1265           var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1266                     "Код МЦ" +  chr(32) +  string(buf_wth-dtl.wth-code) + chr(10) +
     1267                     "Код МХ" + chr(32) + string(buf_wth-dtl.w-p-code) + chr(10) +
     1268                     "Код номинала" + chr(32) + string(buf_wth-dtl.par-code) + chr(10) +
     1269                     "Сумма по связанным товарам в рублях по партиям не равна сумме по номиналу" + chr(10) + chr(10) +
     1270                     "Сумма по связанным товарам в рублях   по партиям=" + string(varsum-gds-rubl-parts) + chr(32) +
     1271                     "Сумма по связанным товарам в рублях   по номиналу=" + string(buf_wth-dtl.sum-gds-rubl).
     1272           if par-talk then
     1273           message var-mes
     1274           view-as alert-box error .
     1275             return error var-mes.
     1276         end.
     1277         if varsum-gds-base-parts <> buf_wth-dtl.sum-gds-base then do:
     1278           var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1279                     "Код МЦ" +  chr(32) +  string(buf_wth-dtl.wth-code) + chr(10) +
     1280                     "Код МХ" + chr(32) + string(buf_wth-dtl.w-p-code) + chr(10) +
     1281                     "Код номинала" + chr(32) + string(buf_wth-dtl.par-code) + chr(10) +
     1282                     "Сумма по связанным товарам в базовой валюте по партиям не равна сумме по номиналу" + chr(32) +  chr(10) +
     1283                     "Сумма по связанным товарам в базовой валюте по партиям=" + string(varsum-gds-base-parts) + chr(32) +
     1284                     "Сумма по связанным товарам в базовой валюте по номиналу=" + string(buf_wth-dtl.sum-gds-base).
     1285           if par-talk then
     1286           message var-mes
     1287           view-as alert-box error .
     1288             return error var-mes.
     1289         end.
     1290       end.
     1291     END.
     1292     if varis-dtl then do:
     1293       if vardoc-sum-dtl <> buf_wth-line.doc-sum then do:
     1294         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1295                   "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1296                   "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1297                   "Сумма по номиналам не равна сумме по строке" + chr(32) +  chr(10) +
     1298                   "Сумма по документу по номиналам=" + string(vardoc-sum-dtl) + chr(32) +
     1299                   "Сумма по документу по строке=" + string(buf_wth-line.doc-sum).
     1300         if par-talk then
     1301         message var-mes
     1302         view-as alert-box error .
     1303           return error var-mes.
     1304       end.
     1305       if buf_wth-doc.status_ = 'факт':U then do:
     1306         if varfact-sum-dtl <> buf_wth-line.fact-sum then do:
     1307           var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1308                     "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1309                     "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1310                     "Сумма по номиналам не равна сумме по строке" + chr(32) +  chr(10) +
     1311                     (if buf_wth-doc.doc-type = 'инв':U
     1312                     then
     1313                     string(
     1314                     "Сумма расхождений по номиналам=" + string(varfact-sum-dtl) + chr(32) +
     1315                     "Сумма расхождений по строке=" + string(buf_wth-line.fact-sum)
     1316                     )
     1317                     else
     1318                     string(
     1319                     "Сумма факт по номиналам=" + string(varfact-sum-dtl) + chr(32) +
     1320                     "Сумма факт по строке=" + string(buf_wth-line.fact-sum))
     1321                     ).
     1322           if par-talk then
     1323           message var-mes
     1324           view-as alert-box error .
     1325             return error var-mes.
     1326         end.
     1327       end.
     1328       if varbef-sum-dtl <> buf_wth-line.bef-sum then do:
     1329         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1330                   "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1331                   "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1332                   "Сумма по номиналам не равна сумме по строке" + chr(32) +  chr(10) +
     1333                   "Сумма план по номиналам=" + string(varbef-sum-dtl) + chr(32) +
     1334                   "Сумма план по строке=" + string(buf_wth-line.bef-sum).
     1335         if par-talk then
     1336         message var-mes
     1337         view-as alert-box error .
     1338           return error var-mes.
     1339       end.
     1340       if buf_wth-doc.doc-type = 'инв':U then do:
     1341         if buf_wth-doc.status_ = 'факт':U then do:
     1342           if varaft-sum-dtl <> buf_wth-line.aft-sum then do:
     1343             var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1344                       "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1345                       "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1346                       "Сумма по номиналам не равна сумме по строке" + chr(32) +  chr(10) +
     1347                       "Сумма факт по номиналам=" + string(varaft-sum-dtl) + chr(32) +
     1348                       "Сумма факт по строке=" + string(buf_wth-line.aft-sum).
     1349             if par-talk then
     1350             message var-mes
     1351             view-as alert-box error .
     1352               return error var-mes.
     1353           end.
     1354         end.
     1355       end.
     1356       if varsum-gds-rubl-dtl <> buf_wth-line.sum-gds-rubl then do:
     1357         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1358                   "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1359                   "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1360                   "Сумма по связанным товарам в рублях  по номиналам не равна сумме по строке" + chr(32) + chr(10) +
     1361                   "Сумма по связанным товарам в рублях  по номиналам=" + string(varsum-gds-rubl-dtl) + chr(32) +
     1362                   "Сумма по связанным товарам в рублях  по строке=" + string(buf_wth-line.sum-gds-rubl).
     1363         if par-talk then
     1364         message var-mes
     1365         view-as alert-box error .
     1366           return error var-mes.
     1367       end.
     1368       if varsum-gds-base-dtl <> buf_wth-line.sum-gds-base then do:
     1369         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1370                   "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1371                   "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1372                   "Сумма по связанным товарам в базовой валюте по номиналам не равна сумме по строке" + chr(32) +  chr(10) +
     1373                   "Сумма по связанным товарам в базовой валюте по номиналам=" + string(varsum-gds-base-dtl) + chr(32) +
     1374                   "Сумма по связанным товарам в базовой валюте по строке=" + string(buf_wth-line.sum-gds-base).
     1375         if par-talk then
     1376         message var-mes
     1377         view-as alert-box error .
     1378           return error var-mes.
     1379       end.
     1380     end .
     1381     assign
     1382     vardoc-sum-line = vardoc-sum-line + buf_wth-line.doc-sum
     1383     varfact-sum-line = varfact-sum-line + buf_wth-line.fact-sum
     1384     varbef-sum-line = varbef-sum-line + buf_wth-line.bef-sum
     1385     varaft-sum-line = varaft-sum-line + buf_wth-line.aft-sum
     1386     varsum-gds-rubl-line = varsum-gds-rubl-line + buf_wth-line.sum-gds-rubl
     1387     varsum-gds-base-line = varsum-gds-base-line + buf_wth-line.sum-gds-base
     1388     .
     1389   END.
     1390   if vardoc-sum-line <> buf_wth-doc.doc-sum then do:
     1391     var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1392               "Сумма по строкам не равна сумме по шапке" + chr(32) + chr(10) +
     1393               "Сумма по документу по строкам=" + string(vardoc-sum-line) + chr(32) +
     1394               "Сумма по документу по шапке=" + string(buf_wth-doc.doc-sum).
     1395     if par-talk then
     1396     message var-mes
     1397     view-as alert-box error .
     1398       return error var-mes.
     1399   end.
     1400   if buf_wth-doc.status_ = 'факт':U then do:
     1401     if varfact-sum-line <> buf_wth-doc.fact-sum then do:
     1402       var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1403                 "Сумма по строкам не равна сумме по шапке" + chr(32) + chr(10) +
     1404                 (if buf_wth-doc.doc-type = 'инв':U
     1405                 then
     1406                   string(
     1407                   "Сумма расхождений по строкам=" + string(varfact-sum-line) + chr(32) +
     1408                   "Сумма расхождений по шапке=" + string(buf_wth-doc.fact-sum)
     1409                   )
     1410                 else
     1411                 string(
     1412                 "Сумма факт по строкам=" + string(varfact-sum-line) + chr(32) +
     1413                 "Сумма факт по шапке=" + string(buf_wth-doc.fact-sum))
     1414                 ).
     1415       if par-talk then
     1416       message var-mes
     1417       view-as alert-box error .
     1418         return error var-mes.
     1419     end.
     1420   end.
     1421   if varbef-sum-line <> buf_wth-doc.bef-sum then do:
     1422     var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1423               "Сумма по строкам не равна сумме по шапке" + chr(32) + chr(10) +
     1424               "Сумма план по строкам=" + string(varbef-sum-line) + chr(32) +
     1425               "Сумма план по шапке=" + string(buf_wth-doc.bef-sum).
     1426     if par-talk then
     1427     message var-mes
     1428     view-as alert-box error .
     1429       return error var-mes.
     1430   end.
     1431   if buf_wth-doc.doc-type = 'инв':U then do:
     1432     if varaft-sum-line <> buf_wth-doc.aft-sum then do:
     1433       var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1434                 "Сумма по строкам не равна сумме по шапке" + chr(32) + chr(10) +
     1435                 "Сумма факт по строкам=" + string(varaft-sum-line) + chr(32) +
     1436                 "Сумма факт по шапке=" + string(buf_wth-doc.aft-sum).
     1437       if par-talk then
     1438       message var-mes
     1439       view-as alert-box error .
     1440         return error var-mes.
     1441     end.
     1442   end.
     1443   if varsum-gds-rubl-line <> buf_wth-doc.sum-gds-rubl then do:
     1444     var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1445               "Сумма по связанным товарам в рублях  по строкам не равна сумме по шапке" + chr(32) + chr(10) +
     1446               "Сумма по связанным товарам в рублях  по строкам=" + string(varsum-gds-rubl-line) + chr(32) +
     1447               "Сумма по связанным товарам в рублях  по шапке=" + string(buf_wth-doc.sum-gds-rubl).
     1448     if par-talk then
     1449     message var-mes   varsum-gds-rubl-line  buf_wth-doc.sum-gds-rubl
     1450     view-as alert-box error .
     1451       return error var-mes.
     1452   end.
     1453   if varsum-gds-base-line <> buf_wth-doc.sum-gds-base then do:
     1454     var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1455               "Сумма по связанным товарам в базовой валюте по строкам не равна сумме по шапке" + chr(32) +   chr(10) +
     1456               "Сумма по связанным товарам в базовой валюте по строкам=" + string(varsum-gds-base-line) + chr(32) +
     1457               "Сумма по связанным товарам в базовой валюте по шапке=" + string(buf_wth-doc.sum-gds-base).
     1458     if par-talk then
     1459     message var-mes
     1460     view-as alert-box error .
     1461       return error var-mes.
     1462   end.
     1463   if buf_wth-doc.auto-fill and varchk-doc-exist then do:
     1464     for each check_chk-doc WHERE
     1465              check_chk-doc.out-code = buf_wth-doc.doc-code AND
     1466              check_chk-doc.obj-type = buf_wth-doc.obj-type AND
     1467              check_chk-doc.obj-code = buf_wth-doc.obj-code,
     1468         EACH check_chk-pay No-LOCK WHERE
     1469              check_chk-pay.doc-code = check_chk-doc.doc-code:
     1470       varinst-sum = varinst-sum + check_chk-pay.tot-sum.
     1471       varchk-type = check_chk-doc.chk-type.
     1472     end.
     1473     if buf_wth-doc.doc-type = 'рас':U then do:
     1474       assign
     1475       varinst-sum = - varinst-sum
     1476       .
     1477     end.
     1478     if buf_wth-doc.doc-type = 'инв':U then do:
     1479       if string(varchk-type) = '4':U then dO:
     1480       end.
     1481       else do:
     1482         if varinst-sum <> buf_wth-doc.aft-sum then do:
     1483           var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1484                     "Сумма по строкам чеков МЦ не равна сумме факт по шапке" + chr(32) + chr(10) +
     1485                     "Сумма по строкам чеков МЦ=" + string(varinst-sum) + chr(32) +
     1486                     "Сумма факт по шапке=" + string(buf_wth-doc.aft-sum).
     1487           if par-talk then
     1488           message var-mes
     1489           view-as alert-box error .
     1490             return error var-mes.
     1491         end.
     1492       end.
     1493     end.
     1494     else do:
     1495       if varinst-sum <> buf_wth-doc.doc-sum then do:
     1496         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1497                   "Сумма по строкам чеков МЦ не равна сумме документа по шапке" + chr(32) + chr(10) +
     1498                   "Сумма по строкам чеков МЦ=" + string(varinst-sum) + chr(32) +
     1499                   "Сумма документа по шапке=" + string(buf_wth-doc.doc-sum).
     1500           if par-talk then
     1501           message var-mes
     1502           view-as alert-box error .
     1503             return error var-mes.
     1504       end.
     1505       if varinst-sum <> buf_wth-doc.fact-sum
     1506       and buf_wth-doc.doc-type <> 'декл':U
     1507       then do:
     1508         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1509                   "Сумма по строкам чеков МЦ не равна сумме факт по шапке" + chr(32) + chr(10) +
     1510                   "Сумма по строкам чеков МЦ=" + string(varinst-sum) + chr(32) +
     1511                   "Сумма факт по шапке=" + string(buf_wth-doc.fact-sum).
     1512         if par-talk then
     1513         message var-mes
     1514         view-as alert-box error .
     1515           return error var-mes.
     1516       end.
     1517       if buf_wth-doc.doc-type = 'декл':U
     1518       and buf_wth-doc.fact-sum <> 0 then do:
     1519         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1520                   "Тип" + chr(32) + buf_wth-doc.doc-type +
     1521                   "Сумма факт по шапке <> 0" .
     1522         if par-talk then
     1523         message var-mes
     1524         view-as alert-box error .
     1525           return error var-mes.
     1526       end.
     1527     end.
     1528   end.
     1529     end.
     1530     var-status_ = buf_wth-doc.status_.
     1531     if var-status_ = 'накл':U and (buf_wth-doc.auto-fill or not buf_wth-doc.doc-type = 'инв':U) then var-status_ = "auto":U.
     1532     IF par-mode = "+":U THEN DO:
     1533         if var-status_ =  'накл':U or
     1534            var-status_  = "auto":U THEN DO:
     1535           FOR EACH buf_wth-line NO-LOCK WHERE
     1536                    buf_wth-line.doc-code = buf_wth-doc.doc-code ON ERROR UNDO Main-Block, RETURN ERROR :
     1537             FIND FIRST ub.wth-line EXCLUSIVE-LOCK WHERE
     1538                 RECID( ub.wth-line ) = RECID( buf_wth-line ).
     1539             IF buf_wth-doc.doc-type = 'инв':U THEN DO:
     1540               if buf_wth-doc.auto-fill and
     1541                  can-find(first ub.chk-doc No-LOCK WHERE
     1542                                 ub.chk-doc.obj-type = buf_wth-doc.obj-type AND
     1543                                 ub.chk-doc.obj-code = buf_wth-doc.obj-code AND
     1544                                 ub.chk-doc.out-code = buf_wth-doc.doc-code AND
     1545                                 ub.chk-doc.chk-type = integer('4':U)) then do:
     1546                 run wth-lib_cur-stock-place in this-procedure (
     1547                                                                  input  buf_wth-doc.obj-type
     1548                                                                 ,input  buf_wth-doc.obj-code
     1549                                                                 ,input  buf_wth-line.w-p-code
     1550                                                                 ,input  buf_wth-line.wth-code
     1551                                                                 ,output buf_wth-line.bef-sum
     1552                                                                 ) no-error.
     1553                 ASSIGN
     1554                 Buf_wth-line.aft-sum  = Buf_wth-line.bef-sum + buf_wth-line.fact-sum
     1555                 Buf_wth-line.doc-sum  = 0
     1556                 buf_wth-line.status_ = 'разрешен':U
     1557                 .
     1558               end.
     1559               else do:
     1560                 ASSIGN
     1561                 Buf_wth-line.aft-sum  = Buf_wth-line.bef-sum
     1562                 Buf_wth-line.doc-sum  = 0
     1563                 buf_wth-line.status_ = 'разрешен':U
     1564                 .
     1565               end.
     1566             END.
     1567             ELSE DO:
     1568             END.
     1569             FOR EACH buf_wth-dtl NO-LOCK WHERE
     1570                     buf_wth-dtl.doc-code = buf_wth-line.doc-code AND
     1571                     buf_wth-dtl.wth-code = buf_wth-line.wth-code AND
     1572                     buf_wth-dtl.w-p-code = buf_wth-line.w-p-code  ON ERROR UNDO Main-Block, RETURN ERROR :
     1573               FIND FIRST ub.wth-dtl EXCLUSIVE-LOCK WHERE
     1574                         RECID( ub.wth-dtl ) = RECID( buf_wth-dtl ).
     1575               IF buf_wth-doc.doc-type = 'инв':U THEN DO:
     1576                 ASSIGN
     1577                 Buf_wth-dtl.aft-sum  = Buf_wth-dtl.bef-sum
     1578                 Buf_wth-dtl.doc-sum  = 0
     1579                 .
     1580               END.
     1581               ELSE DO:
     1582               END.
     1583             END.
     1584           END.
     1585           IF buf_wth-doc.doc-type = 'инв':U THEN DO:
     1586             if buf_wth-doc.auto-fill and
     1587                  can-find(first ub.chk-doc No-LOCK WHERE
     1588                                 ub.chk-doc.obj-type = buf_wth-doc.obj-type AND
     1589                                 ub.chk-doc.obj-code = buf_wth-doc.obj-code AND
     1590                                 ub.chk-doc.out-code = buf_wth-doc.doc-code AND
     1591                                 ub.chk-doc.chk-type = integer('4':U)) then do:
     1592               ASSIGN
     1593               buf_wth-doc.aft-sum = buf_wth-doc.bef-sum + buf_wth-doc.fact-sum
     1594               buf_wth-doc.doc-sum = 0
     1595               .
     1596             end.
     1597             else do:
     1598              ASSIGN
     1599               buf_wth-doc.aft-sum = buf_wth-doc.bef-sum
     1600               buf_wth-doc.doc-sum = 0
     1601               .
     1602             end.
     1603           END.
     1604           else do:
     1605           end.
     1606           ASSIGN buf_wth-doc.status_ = 'разрешен':U.
     1607         END.
     1608         if var-status_ = 'разрешен':U or
     1609            var-status_ = "auto":U THEN DO:
     1610           if not buf_wth-doc.status_ = 'разрешен':U then.
     1611           else do:
     1612           FIND FIRST buf_clients NO-LOCK WHERE
     1613                     buf_clients.obj-type = parobj-type AND
     1614                     buf_clients.obj-code = parobj-code NO-ERROR.
     1615           IF NOT AVAIL buf_clients THEN DO:
     1616             var-mes = "Нет объекта" + parobj-type + string(parobj-code) +  "в справочнике клиентов!".
     1617             IF par-talk THEN DO:
     1618               MESSAGE var-mes
     1619               VIEW-AS ALERT-BOX ERROR.
     1620             END.
     1621             run waitfram-hide in this-procedure .
     1622             UNDO Main-Block, RETURN ERROR var-mes.
     1623           END.
     1624           IF buf_wth-doc.obj-type <> parobj-type OR
     1625              buf_wth-doc.obj-code <> parobj-code OR
     1626              buf_clients.db-num <> g#db-num THEN DO:
     1627             var-mes = "Закрыть на ФАКТ можно только на объекте!".
     1628             IF par-talk THEN DO:
     1629               MESSAGE var-mes
     1630               VIEW-AS ALERT-BOX ERROR.
     1631             END.
     1632             run waitfram-hide in this-procedure .
     1633             UNDO Main-Block, RETURN ERROR var-mes.
     1634           END.
     1635           FOR EACH buf_wth-line NO-LOCK WHERE
     1636                   buf_wth-line.doc-code = buf_wth-doc.doc-code ON ERROR UNDO Main-Block, RETURN ERROR :
     1637             FIND FIRST ub.wth-line EXCLUSIVE-LOCK WHERE
     1638                 RECID( ub.wth-line ) = RECID( buf_wth-line ).
     1639             IF buf_wth-doc.doc-type = 'инв':U THEN DO:
     1640               if buf_wth-doc.auto-fill and
     1641                   can-find(first ub.chk-doc No-LOCK WHERE
     1642                                   ub.chk-doc.obj-type = buf_wth-doc.obj-type AND
     1643                                   ub.chk-doc.obj-code = buf_wth-doc.obj-code AND
     1644                                   ub.chk-doc.out-code = buf_wth-doc.doc-code AND
     1645                                   ub.chk-doc.chk-type = integer('4':U)) then do:
     1646                 run wth-lib_cur-stock-place in this-procedure (
     1647                                                                  input  buf_wth-doc.obj-type
     1648                                                                 ,input  buf_wth-doc.obj-code
     1649                                                                 ,input  buf_wth-line.w-p-code
     1650                                                                 ,input  buf_wth-line.wth-code
     1651                                                                 ,output buf_wth-line.bef-sum
     1652                                                                 ) no-error.
     1653                 ASSIGN
     1654                 Buf_wth-line.aft-sum  = Buf_wth-line.bef-sum + buf_wth-line.fact-sum
     1655                 buf_wth-line.status_ = 'факт':U
     1656                 .
     1657               end.
     1658               else do:
     1659                 ASSIGN
     1660                 Buf_wth-line.fact-sum  = Buf_wth-line.aft-sum - buf_wth-line.bef-sum
     1661                 buf_wth-line.status_ = 'факт':U
     1662                 .
     1663               end.
     1664             END.
     1665             else do:
     1666               ASSIGN
     1667               buf_wth-line.status_ = 'факт':U
     1668               .
     1669             end.
     1670             FOR EACH buf_wth-dtl NO-LOCK WHERE
     1671                     buf_wth-dtl.doc-code = buf_wth-line.doc-code AND
     1672                     buf_wth-dtl.wth-code = buf_wth-line.wth-code AND
     1673                     buf_wth-dtl.w-p-code = buf_wth-line.w-p-code  ON ERROR UNDO Main-Block, RETURN ERROR :
     1674               FIND FIRST ub.wth-dtl EXCLUSIVE-LOCK WHERE
     1675                         RECID( ub.wth-dtl ) = RECID( buf_wth-dtl ).
     1676               IF buf_wth-doc.doc-type = 'инв':U THEN DO:
     1677                 ASSIGN
     1678                 Buf_wth-dtl.fact-sum  = Buf_wth-dtl.aft-sum - buf_wth-dtl.bef-sum
     1679                 .
     1680               END.
     1681             END.
     1682           END.
     1683           IF buf_wth-doc.doc-type = 'инв':U THEN DO:
     1684             if buf_wth-doc.auto-fill and
     1685                 can-find(first ub.chk-doc No-LOCK WHERE
     1686                                 ub.chk-doc.obj-type = buf_wth-doc.obj-type AND
     1687                                 ub.chk-doc.obj-code = buf_wth-doc.obj-code AND
     1688                                 ub.chk-doc.out-code = buf_wth-doc.doc-code AND
     1689                                 ub.chk-doc.chk-type = integer('4':U)) then do:
     1690               ASSIGN
     1691               buf_wth-doc.aft-sum = buf_wth-doc.bef-sum + buf_wth-doc.fact-sum
     1692               .
     1693              end.
     1694              else do:
     1695               ASSIGN
     1696               buf_wth-doc.fact-sum = buf_wth-doc.aft-sum - buf_wth-doc.bef-sum
     1697               .
     1698              end.
     1699           END.
     1700           if buf_wth-doc.doc-type <> 'обмен':U then do:
     1701   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1702   assign
     1703   vardoc-sum-dtl = 0
     1704   varfact-sum-dtl = 0
     1705   varbef-sum-dtl = 0
     1706   varaft-sum-dtl = 0
     1707   vardoc-sum-line = 0
     1708   varfact-sum-line = 0
     1709   varbef-sum-line = 0
     1710   varaft-sum-line = 0
     1711   varinst-sum = 0
     1712   varsum-gds-rubl-line = 0
     1713   varsum-gds-base-line = 0
     1714   varsum-gds-rubl-dtl = 0
     1715   varsum-gds-base-dtl = 0
     1716   varsum-gds-rubl-parts = 0
     1717   varsum-gds-base-parts = 0
     1718   .
     1719   FOR EACH buf_wth-line No-LOCK WHERE
     1720            buf_wth-line.doc-code = buf_wth-doc.doc-code:
     1721     assign
     1722     vardoc-sum-dtl = 0
     1723     varfact-sum-dtl = 0
     1724     varbef-sum-dtl = 0
     1725     varaft-sum-dtl = 0
     1726     varsum-gds-rubl-dtl = 0
     1727     varsum-gds-base-dtl = 0
     1728     varis-dtl = no
     1729     .
     1730     FOR EACH buf_wth-dtl No-LOCK WHERE
     1731              buf_wth-dtl.doc-code = buf_wth-line.doc-code AND
     1732              buf_wth-dtl.wth-code = buf_wth-line.wth-code AND
     1733              buf_wth-dtl.w-p-code = buf_wth-line.w-p-code:
     1734       assign
     1735       varis-dtl = yes
     1736       vardoc-sum-dtl = vardoc-sum-dtl + buf_wth-dtl.doc-sum
     1737       varfact-sum-dtl = varfact-sum-dtl + buf_wth-dtl.fact-sum
     1738       varbef-sum-dtl = varbef-sum-dtl + buf_wth-dtl.bef-sum
     1739       varaft-sum-dtl = varaft-sum-dtl + buf_wth-dtl.aft-sum
     1740       varsum-gds-rubl-dtl = varsum-gds-rubl-dtl + buf_wth-dtl.sum-gds-rubl
     1741       varsum-gds-base-dtl = varsum-gds-base-dtl + buf_wth-dtl.sum-gds-base
     1742       .
     1743       assign varsum-gds-rubl-parts = 0
     1744       varsum-gds-base-parts = 0
     1745       varis-part = no.
     1746       for each buf_wth-parts no-lock where
     1747         buf_wth-parts.w-p-code = buf_wth-dtl.w-p-code and
     1748         buf_wth-parts.wth-code = buf_wth-dtl.wth-code and
     1749         buf_wth-parts.par-code = buf_wth-dtl.par-code and
     1750         buf_wth-parts.out-code = buf_wth-dtl.doc-code and
     1751         buf_wth-parts.stts = 0 :
     1752         assign
     1753         varis-part = yes
     1754         varsum-gds-rubl-parts = varsum-gds-rubl-parts + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1755         varsum-gds-base-parts = varsum-gds-base-parts + buf_wth-parts.fact-qnty * buf_wth-parts.price-base
     1756         .
     1757       end.
     1758       if varis-part or can-find(first bufdsum_wealth where bufdsum_wealth.wth-code = buf_wth-dtl.wth-code and bufdsum_wealth.is-ser = 1 no-lock  ) then do:
     1759         if varsum-gds-rubl-parts <> buf_wth-dtl.sum-gds-rubl then do:
     1760           var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1761                     "Код МЦ" +  chr(32) +  string(buf_wth-dtl.wth-code) + chr(10) +
     1762                     "Код МХ" + chr(32) + string(buf_wth-dtl.w-p-code) + chr(10) +
     1763                     "Код номинала" + chr(32) + string(buf_wth-dtl.par-code) + chr(10) +
     1764                     "Сумма по связанным товарам в рублях по партиям не равна сумме по номиналу" + chr(10) + chr(10) +
     1765                     "Сумма по связанным товарам в рублях   по партиям=" + string(varsum-gds-rubl-parts) + chr(32) +
     1766                     "Сумма по связанным товарам в рублях   по номиналу=" + string(buf_wth-dtl.sum-gds-rubl).
     1767           if par-talk then
     1768           message var-mes
     1769           view-as alert-box error .
     1770           UNDO Main-Block,  return error var-mes.
     1771         end.
     1772         if varsum-gds-base-parts <> buf_wth-dtl.sum-gds-base then do:
     1773           var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1774                     "Код МЦ" +  chr(32) +  string(buf_wth-dtl.wth-code) + chr(10) +
     1775                     "Код МХ" + chr(32) + string(buf_wth-dtl.w-p-code) + chr(10) +
     1776                     "Код номинала" + chr(32) + string(buf_wth-dtl.par-code) + chr(10) +
     1777                     "Сумма по связанным товарам в базовой валюте по партиям не равна сумме по номиналу" + chr(32) +  chr(10) +
     1778                     "Сумма по связанным товарам в базовой валюте по партиям=" + string(varsum-gds-base-parts) + chr(32) +
     1779                     "Сумма по связанным товарам в базовой валюте по номиналу=" + string(buf_wth-dtl.sum-gds-base).
     1780           if par-talk then
     1781           message var-mes
     1782           view-as alert-box error .
     1783           UNDO Main-Block,  return error var-mes.
     1784         end.
     1785       end.
     1786     END.
     1787     if varis-dtl then do:
     1788       if vardoc-sum-dtl <> buf_wth-line.doc-sum then do:
     1789         var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1790                   "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1791                   "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1792                   "Сумма по номиналам не равна сумме по строке" + chr(32) +  chr(10) +
     1793                   "Сумма по документу по номиналам=" + string(vardoc-sum-dtl) + chr(32) +
     1794                   "Сумма по документу по строке=" + string(buf_wth-line.doc-sum).
     1795         if par-talk then
     1796         message var-mes
     1797         view-as alert-box error .
     1798         UNDO Main-Block,  return error var-mes.
     1799       end.
     1800       if buf_wth-doc.status_ = 'факт':U then do:
     1801         if varfact-sum-dtl <> buf_wth-line.fact-sum then do:
     1802           var-mes = "Документ МЦ" + chr(32) + buf_wth-doc.doc-code + chr(10) +
     1803                     "Код МЦ" +  chr(32) +  string(buf_wth-line.wth-code) + chr(10) +
     1804                     "Код МХ" + chr(32) + string(buf_wth-line.w-p-code) + chr(10) +
     1805                     "Сумма по номиналам не равна сумме по строке" + chr(32) +  chr(10) +
