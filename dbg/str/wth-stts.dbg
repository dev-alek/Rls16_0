     1868                   "Сумма по связанным товарам в базовой валюте по номиналам=" + string(varsum-gds-base-dtl) + chr(32) +
     1869                   "Сумма по связанным товарам в базовой валюте по строке=" + string(buf_wth-line.sum-gds-base).
     1870         if par-talk then
     1871         message var-mes
     1872         view-as alert-box error .
     1873         UNDO Main-Block,  return error var-mes.
     1874       end.
     1875     end .
     1876     assign
     1877     vardoc-sum-line = vardoc-sum-line + buf_wth-line.doc-sum
     1878     varfact-sum-line = varfact-sum-line + buf_wth-line.fact-sum
     1879     varbef-sum-line = varbef-sum-line + buf_wth-line.bef-sum
     1880     varaft-sum-line = varaft-sum-line + buf_wth-line.aft-sum
     1881     varsum-gds-rubl-line = varsum-gds-rubl-line + buf_wth-line.sum-gds-rubl
     1882     varsum-gds-base-line = varsum-gds-base-line + buf_wth-line.sum-gds-base
     1883     .
     1884   END.
     1885   if vardoc-sum-line <> buf_wth-doc.doc-sum then do:
