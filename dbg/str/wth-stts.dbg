        1   block-level on error undo, throw.
        2   define input parameter parparentproc  as widget-handle no-undo .
        3   DEFINE       PARAM BUFFER buf_wth-doc  FOR ub.wth-doc .
        4   DEFINE INPUT PARAMETER    par-mode AS  CHAR NO-UNDO .
        5   DEFINE INPUT PARAMETER    par-talk AS  LOG  NO-UNDO .
        6   define input parameter parobj-type like ub.clients.obj-type no-undo .
        7   define input parameter parobj-code like ub.clients.obj-code no-undo .
        8   define input parameter p-file-name-err    as   char         no-undo.
        9   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision: aea5316774be, 0, rls $":U.
       10   define variable vss-author      AS CHAR NO-UNDO INIT "$Author: expertek $":U.
       11   define variable vss-date        AS CHAR NO-UNDO INIT "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
       12   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile: wth-stts.p $":U.
       13   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive: str/wth-stts.p $":U.
       14   define variable vss-description AS CHAR NO-UNDO INIT "изменение статуса (открытие/закрытие) документов МЦ":U.
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure factord :
       86     define input  parameter p-fact-date            as date    no-undo .
       87     define input  parameter p-fact-time            as integer no-undo .
       88     define input  parameter p-fact-num             as integer no-undo .
       89     define input  parameter p-shift-date           as date    no-undo .
       90     define input  parameter p-shift-num            as integer no-undo .
       91     define input  parameter p-shift-on             as logical no-undo .
       92     define output parameter p-fact-order           as decimal no-undo .
       93     define output parameter p-shift-end-fact-order as decimal no-undo .
       94     define output parameter p-day-end-fact-order   as decimal no-undo .
       95     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       96     if p-fact-date = ?
       97     then do:
       98       return error "Не указана фактическая дата" .
       99     end.
      100     define variable v-fact-date-num as integer no-undo .
      101     assign
      102       v-fact-date-num = integer(p-fact-date)
      103     .
      104     if p-fact-num = ?
      105     or p-fact-num = 0
      106     then do:
      107       return error "Не задан p-fact-num " + string(p-fact-num) .
      108     end.
      109     if p-fact-num < 0
      110     then do:
      111       return error "Отрицательный fact-num " + string(p-fact-num) .
      112     end.
      113     if p-fact-num >= 100000000
      114     then do:
      115       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      116     end.
      117     if p-shift-on = true
      118     then do:
      119       if p-shift-date = ?
      120       then do:
      121         return error "Не задана дата смены" .
      122       end.
      123       if p-shift-num = ?
      124       or p-shift-num = 0
      125       then do:
      126         return error "Не задан номер смены" .
      127       end.
      128     end.
      129     else do:
      130       assign
      131         p-shift-date = p-fact-date
      132         p-shift-num  = 24
      133       .
      134     end.
      135     define variable v-shift-offset as integer no-undo .
      136     if p-shift-date = p-fact-date
      137     then do:
      138       assign
      139         v-shift-offset = 1
      140       .
      141     end.
      142     if p-shift-date < p-fact-date
      143     then do:
      144       assign
      145         v-shift-offset = 0
      146       .
      147     end.
      148     if p-shift-date > p-fact-date
      149     then do:
      150       message
      151         vss-workfile vss-revision vss-description skip
      152         "Неправильная дата закрытия смены" skip
      153         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      154         view-as alert-box error .
      155       undo, return error
      156         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      157           ,string(p-fact-date, '99/99/9999':U)
      158           ,string(p-shift-date, '99/99/9999':U)
      159           )
      160       .
      161     end.
      162     if p-shift-num < 1
      163     or p-shift-num > 24
      164     then do:
      165       message
      166         vss-workfile vss-revision vss-description skip
      167         "Неправильный номер смены" skip
      168         "p-shift-num" p-shift-num skip
      169         view-as alert-box error .
      170       undo, return error return-value .
      171     end.
      172     assign
      173       p-fact-order           = v-fact-date-num
      174                              + v-shift-offset * 0.5
      175                              + p-shift-num    * 0.02 - 0.01
      176                              + p-fact-num     * 0.0000000001
      177       p-shift-end-fact-order = v-fact-date-num
      178                              + v-shift-offset * 0.5
      179                              + p-shift-num    * 0.02
      180       p-day-end-fact-order   = v-fact-date-num
      181                              + 0.99
      182     .
      183     if p-fact-order           <= v-fact-date-num
      184     or p-shift-end-fact-order <= v-fact-date-num
      185     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      186     or p-shift-end-fact-order >= p-day-end-fact-order
      187     then do:
      188       message
      189         vss-workfile vss-revision vss-description skip
      190         "Внутренняя ошибка при генерации фактического номера" skip
      191         "p-fact-date"            p-fact-date            skip
      192         "p-fact-time"            p-fact-time            skip
      193         "p-fact-num"             p-fact-num             skip
      194         "p-shift-date"           p-shift-date           skip
      195         "p-shift-num"            p-shift-num            skip
      196         "p-shift-on"             p-shift-on             skip
      197         "p-shift-end-fact-order" p-shift-end-fact-order skip
      198         "p-day-end-fact-order"   p-day-end-fact-order   skip
      199         "v-fact-date-num"        v-fact-date-num        skip
      200         view-as alert-box error .
      201       undo, return error return-value .
      202     end.
      203   end procedure.
      204   procedure day-begin-fact-order :
      205     define input  parameter p-fact-date            as date    no-undo .
      206     define output parameter p-day-begin-fact-order as decimal no-undo .
      207     do
      208     on error undo, return error return-value
      209     :
      210       if p-fact-date = ?
      211       then do:
      212         assign
      213           p-day-begin-fact-order = 0
      214         .
      215       end.
      216       else do:
      217         assign
      218           p-day-begin-fact-order = integer(p-fact-date)
      219         .
      220       end.
      221     end.
      222   end procedure.
      223   procedure factord-max-fact-order :
      224     define output parameter p-max-fact-order as decimal   no-undo .
      225     do
      226     on error undo, return error return-value
      227     :
      228       run day-begin-fact-order in this-procedure
      229         (input  date(1, 1, 5000)
      230         ,output p-max-fact-order
      231         ) .
      232     end.
      233   end procedure.
      234   procedure factord-cut-archive :
      235     define input  parameter p-obj-type             as character no-undo .
      236     define input  parameter p-obj-code             as integer   no-undo .
      237     define input  parameter p-fact-date            as date      no-undo .
      238     define output parameter p-shift-on             as logical   no-undo .
      239     define output parameter p-shift-date           as date      no-undo .
      240     define output parameter p-shift-num            as integer   no-undo .
      241     define output parameter p-day-end-fact-order   as decimal   no-undo .
      242     define output parameter p-shift-end-fact-order as decimal   no-undo .
      243     define variable v-fact-order as decimal   no-undo .
      244     define buffer buf_shift-obj for ub.shift-obj .
      245     do
      246     on error undo, return error return-value
      247     :
      248   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      249   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      250     (input  p-obj-type
      251     ,input  p-obj-code
      252     ,input  'shift-on=request'
      253     ,output p-shift-on
      254     ) no-error .
      255       if error-status :error
      256       then do:
      257         message
      258           vss-workfile vss-revision vss-description skip
      259           "Ошибка при определении атрибута объекта" skip
      260           "Объект" p-obj-type p-obj-code skip
      261           error-status :get-message(1) skip
      262           return-value skip
      263           view-as alert-box error .
      264         undo, return error return-value .
      265       end.
      266       if p-shift-on = false
      267       then do:
      268         assign
      269           p-shift-date               = ?
      270           p-shift-num                = 0
      271         .
      272       end.
      273       else do:
      274         find first buf_shift-obj share-lock
      275           where buf_shift-obj.obj-type   = p-obj-type
      276             and buf_shift-obj.obj-code   = p-obj-code
      277             and buf_shift-obj.shift-date > p-fact-date
      278           use-index pi
      279           no-error .
      280         if not available buf_shift-obj
      281         or buf_shift-obj.status_ <> 'зкр':U
      282         then do:
      283           message
      284             vss-workfile vss-revision vss-description skip
      285             "Невозможно вычислить последнюю смену" skip
      286             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      287             "Объект" p-obj-type p-obj-code skip
      288             "Дата" p-fact-date skip
      289             view-as alert-box error .
      290           undo, return error return-value .
      291         end.
      292         find last buf_shift-obj share-lock
      293           where buf_shift-obj.obj-type = p-obj-type
      294             and buf_shift-obj.obj-code = p-obj-code
      295             and buf_shift-obj.shift-date <= p-fact-date
      296           use-index pi
      297           no-error .
      298         if available buf_shift-obj
      299         then do:
      300           if  buf_shift-obj.status_ = 'зкр':U
      301           then do:
      302             assign
      303               p-shift-date = buf_shift-obj.shift-date
      304               p-shift-num  = buf_shift-obj.shift-num
      305             .
      306           end.
      307           else do:
      308             message
      309               vss-workfile vss-revision vss-description skip
      310               "Невозможно вычислить последнюю смену" skip
      311               "Статус смены отличен от статуса" 'зкр':U skip
      312               "Объект" p-obj-type p-obj-code skip
      313               "Дата" p-fact-date skip
      314               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      315               view-as alert-box error .
      316             undo, return error return-value .
      317           end.
      318         end.
      319         else do:
      320           assign
      321             p-shift-date = p-fact-date - 1
      322             p-shift-num  = 1
      323           .
      324         end.
      325       end.
      326       run factord in this-procedure
      327         (input  p-fact-date
      328         ,input  1
      329         ,input  1
      330         ,input  p-shift-date
      331         ,input  p-shift-num
      332         ,input  p-shift-on
      333         ,output v-fact-order
      334         ,output p-shift-end-fact-order
      335         ,output p-day-end-fact-order
      336         ) no-error .
      337       if error-status :error
      338       then do:
      339         message
      340           vss-workfile vss-revision vss-description skip
      341           "Ошибка при вызове процедуры factord"
      342           error-status :get-message(1) skip
      343           return-value skip
      344           view-as alert-box error .
      345         undo, return error return-value .
      346       end.
      347     end.
      348   end procedure.
      349   procedure factord-lock-shift :
      350     define input  parameter p-obj-type  as character no-undo .
      351     define input  parameter p-obj-code  as integer   no-undo .
      352     define input  parameter p-fact-date as date      no-undo .
      353     define parameter buffer buf_shift-obj for ub.shift-obj .
      354     define variable v-shift-on      as logical   no-undo .
      355     define variable v-extra-message as character no-undo .
      356     define variable v-error as character no-undo .
      357     do
      358     on error undo, return error return-value
      359     :
      360   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      362     (input  p-obj-type
      363     ,input  p-obj-code
      364     ,input  'shift-on=request'
      365     ,output v-shift-on
      366     ) no-error .
      367       if error-status :error
      368       then do:
      369         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      370         undo, return error v-error .
      371       end.
      372       if v-shift-on = true
      373       then do:
      374         find first buf_shift-obj share-lock
      375           where buf_shift-obj.obj-type   = p-obj-type
      376             and buf_shift-obj.obj-code   = p-obj-code
      377             and buf_shift-obj.shift-date > p-fact-date
      378           use-index pi
      379           no-error .
      380         if not available buf_shift-obj
      381         or buf_shift-obj.status_ <> 'зкр':U
      382         then do:
      383           find last buf_shift-obj
      384             where buf_shift-obj.obj-type = p-obj-type
      385               and buf_shift-obj.obj-code = p-obj-code
      386               and buf_shift-obj.status_  = 'зкр':U
      387             use-index stts
      388             no-error .
      389           if available buf_shift-obj
      390           then do:
      391             assign
      392               v-extra-message =
      393                     substitute("Дата начала последеней закрытой смены на объекте &1"
      394                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      395                               )
      396             .
      397           end.
      398           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      399           undo, return error v-error .
      400         end.
      401       end.
      402     end.
      403   end procedure.
      404   procedure factord-end-day :
      405     define input  parameter p-fact-date            as date    no-undo .
      406     define output parameter p-day-end-fact-order   as decimal no-undo .
      407     do
      408     on error undo, return error return-value
      409     :
      410       if p-fact-date = ?
      411       then do:
      412         return error "Не указана фактическая дата" .
      413       end.
      414       assign
      415         p-day-end-fact-order = integer(p-fact-date) + 0.99
      416       .
      417     end.
      418   end procedure.
      419   procedure factord-to-date :
      420     define input  parameter p-fact-order as decimal no-undo .
      421     define output parameter p-fact-date  as date    no-undo .
      422     define variable v-ref-date  as date      no-undo .
      423     define variable v-ref-delta as integer   no-undo .
      424     do
      425     on error undo, return error return-value
      426     :
      427       if p-fact-order = ?
      428       or p-fact-order = 0
      429       then do:
      430         return error "Не указан fact-order" .
      431       end.
      432       assign
      433         v-ref-date  = date(1, 1, 2000)
      434       .
      435       assign
      436         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      437       .
      438       assign
      439         p-fact-date = v-ref-date + v-ref-delta
      440       .
      441     end.
      442   end procedure.
      443   procedure factord-to-fact-num :
      444     define input  parameter p-fact-order as decimal no-undo .
      445     define output parameter p-fact-num   as integer no-undo .
      446     define variable v-fact-order-trunc as decimal no-undo .
      447     do
      448     on error undo, return error return-value
      449     :
      450       if p-fact-order = ?
      451       or p-fact-order = 0
      452       then do:
      453         return error "Не указан fact-order" .
      454       end.
      455       assign
      456        v-fact-order-trunc = truncate(p-fact-order, 2)
      457       .
      458       assign
      459         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      460       .
      461     end.
      462   end procedure.
      463   procedure factord-to-shift-num :
      464     define input  parameter p-fact-order as decimal no-undo .
      465     define output parameter p-shift-num   as integer no-undo .
      466     define variable  p-shift-numd  as decimal   no-undo .
      467     define variable v-fact-order-trunc as decimal no-undo .
      468     do
      469     on error undo, return error return-value
      470     :
      471       if p-fact-order = ?
      472       or p-fact-order = 0
      473       then do:
      474         return error "Не указан fact-order" .
      475       end.
      476       assign
      477        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      478       .
      479       if v-fact-order-trunc < 0.5 then do:
      480         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      481       end.
      482       assign
      483         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      484         .
      485        assign
      486         p-shift-num = truncate (p-shift-numd , 0)
      487       .
      488     end.
      489   end procedure.
      490   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      491   define variable v-waitfram-action01         as character   no-undo .
      492   define variable v-waitfram-action02         as character   no-undo .
      493   define variable v-waitfram-action03         as character   no-undo .
      494   define variable mWaitFramTextBeg            as character   no-undo.
      495   define variable mWaitFramTextEnd            as character   no-undo.
      496   define variable mWaitFramView               as logical     no-undo.
      497   define variable mWaitProcEvent              as logical     no-undo init yes.
      498   define variable mWaitFramInterval           as integer     no-undo init 1 .
      499   define variable mWaitFramStop               as logical     no-undo.
      500   define variable mWaitFramStopUser           as logical     no-undo.
      501   define variable mWaitFramStopTimeOut        as logical     no-undo.
      502   define variable mWaitFramStartProc          as datetime-tz no-undo.
      503   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      504   define button B-WaitFramStop auto-end-key
      505        label "Стоп"
      506        size 10 by 1 tooltip "Остоновить процесс".
      507   define button B-viewProcInfo
      508        label "Информация"
      509        size 15 by 1 tooltip "Информация о процесс".
      510   define frame waitfram
      511     v-waitfram-action01 format "x(72)" no-label skip
      512     v-waitfram-action02 format "x(72)" no-label skip
      513     v-waitfram-action03 format "x(72)" no-label skip
      514     B-viewProcInfo
      515     B-WaitFramStop at row 4 col 30
      516     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      517     .
      518   define new global shared variable mBatchMode as logical no-undo init ?.
      519   define variable mFramBachModHandle as handle no-undo.
      520   mFramBachModHandle = frame waitfram:handle.
      521   define variable mFameOldVis as logical no-undo.
      522   define variable mVisCUrentVin as logical no-undo.
      523   if session:batch-mode
      524   then
      525      mBatchMode = yes.
      526   if mBatchMode = ? then do:
      527     mVisCUrentVin = current-window:visible.
      528     mFameOldVis = mFramBachModHandle:visible.
      529     mFramBachModHandle:visible  = yes.
      530     mBatchMode = mFramBachModHandle:visible ne yes.
      531     mFramBachModHandle:visible = mFameOldVis.
      532     current-window:visible = mVisCUrentVin.
      533   end.
      534    if  log-manager:logfile-name ne ?
      535     then DO:
      536         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      537         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      538         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      539     end.
      540   on choose of B-WaitFramStop in frame waitfram
      541   do:
      542     mWaitFramStop = yes.
      543     mWaitFramStopUser = yes.
      544   end.
      545   function waitfram-check-timeout returns logical():
      546      define variable vtime as int64 no-undo.
      547      if mWaitFramStopTimeOut
      548      then
      549         return yes.
      550      vtime = ( now - mWaitFramStartProc ) / 1000 .
      551      if     mWaitFramTimeOut ne ?
      552         and mWaitFramTimeOut ne 0
      553         and mWaitFramTimeOut lt vtime
      554      then do:
      555         mWaitFramStopTimeOut = yes.
      556      end.
      557      return mWaitFramStopTimeOut.
      558   end.
      559   procedure waitfram-hide :
      560     if not session:batch-mode
      561     then do
      562     on error undo, return error return-value
      563     :
      564       pause 0 before-hide .
      565       if not mBatchMode then
      566         hide frame waitfram .
      567     if     not mWaitFramView
      568        and mWaitProcEvent
      569     then
      570       process events .
      571     end.
      572   end procedure.
      573   procedure waitfram-show :
      574     define input  parameter p-message as character no-undo .
      575     define variable v-left-margin as integer   no-undo .
      576     if not session:batch-mode
      577     then do
      578     on error undo, return error return-value
      579     :
      580       if length(p-message) <= 70 then do:
      581         assign
      582           v-left-margin = integer((70 - length(p-message)) / 2)
      583         .
      584         assign
      585           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      586         .
      587         assign
      588           v-waitfram-action01 = " "
      589           v-waitfram-action02 = " "
      590                                    + fill(" ", v-left-margin)
      591                                    + p-message
      592           v-waitfram-action03 = " "
      593         .
      594       end.
      595       else do:
      596         define variable vRindex1 as integer no-undo.
      597         define variable vRindex2 as integer no-undo.
      598         vRindex1 = r-index(p-message," ",70).
      599         if vRindex1 = 0
      600         then
      601            vRindex1 = 70.
      602         if length(p-message)  <= vRindex1 + 70 then do:
      603           assign
      604             v-waitfram-action01 = " "
      605             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      606             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      607           .
      608         end.
      609         else do:
      610           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      611           if vRindex2 <= vRindex1
      612           then
      613              vRindex2 = vRindex1 + 70.
      614           assign
      615             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      616             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      617             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      618           .
      619         end.
      620       end.
      621       B-viewProcInfo:visible   in frame waitfram = no.
      622       B-viewProcInfo:sensitive in frame waitfram = no.
      623       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      624       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      625       if  (   mWaitFramView
      626          or  mWaitProcEvent)
      627          and not mBatchMode
      628       then
      629          display
      630             v-waitfram-action01 skip
      631             v-waitfram-action02 skip
      632             v-waitfram-action03 skip
      633          with frame waitfram .
      634       if     mWaitFramView
      635          then do:
      636             if     mWaitFramInterval ne ?
      637                and not mBatchMode
      638             then
      639                wait-for go of frame waitfram pause mWaitFramInterval.
      640          end.
      641          else
      642             if     mWaitProcEvent
      643                and not mBatchMode
      644             then
      645                process events .
      646     end.
      647   end procedure.
      648      procedure waitfram-show-this:
      649         define input  parameter iInterval as int64 no-undo.
      650         define variable vtime as int64 no-undo.
      651         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      652         mWaitFramInterval = iInterval.
      653         run waitfram-show (substitute("&1&2 &3&4" ,
      654                                       mWaitFramTextBeg ,
      655                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      656                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      657                                       mWaitFramTextEnd
      658                                      )
      659                           ).
      660      end.
      661      procedure WaitFramRunPause:
      662         define input  parameter iInterval as dec no-undo.
      663         define variable vStart  as datetime-tz no-undo.
      664         define variable vend    as datetime-tz no-undo.
      665         define variable vint as int64 no-undo.
      666         define variable vOk as logical no-undo.
      667         vStart = now.
      668         vend   = vStart.
      669         publish "WaitFramPause" (iInterval,output vOk).
      670         vend   =  now.
      671         vint = vend - vStart.
      672         vint = iInterval - vint / 1000.
      673         if     not mWaitFramStop
      674            and (   vint > 0
      675                 or (    not vOk
      676                     and iInterval eq ?
      677                     )
      678                 )
      679         then
      680            run waitfram-show-this (iInterval).
      681         vend   =  now.
      682         vint = vend - vStart.
      683         vint = iInterval - vint / 1000.
      684         if     not mWaitFramStop
      685            and vint > 0
      686         then do:
      687            run gbl/pause.p (vint * 1000).
      688         end.
      689         if iInterval ne ?
      690         then
      691            publish "WaitFramStop".
      692         waitfram-check-timeout().
      693      end.
      694      procedure WaitFramWaitFor:
      695         define input  parameter iInterval as dec no-undo.
      696         assign
      697            mWaitFramStartProc   = now
      698            mWaitFramStopUser    = no
      699            mWaitFramStopTimeOut = no
      700         .
      701         block-wait:
      702         do while not mWaitFramStop:
      703            run WaitFramRunPause (iInterval).
      704            if  waitfram-check-timeout()
      705            then do:
      706               leave block-wait.
      707            end.
      708         end.
      709         run waitfram-hide.
      710      end.
      711   procedure waitfram-join :
      712     define input  parameter p-line-1  as character no-undo .
      713     define input  parameter p-line-2  as character no-undo .
      714     define input  parameter p-line-3  as character no-undo .
      715     define output parameter p-message as character no-undo .
      716     do
      717     on error undo, return error return-value
      718     :
      719       assign
      720         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      721                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      722                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      723       .
      724     end.
      725   end procedure.
      726   function waitfram-join-function returns character
      727     (input p-line-1 as character
      728     ,input p-line-2 as character
      729     ,input p-line-3 as character
      730     ).
      731     define variable v-message as character no-undo .
      732     run waitfram-join in this-procedure
      733       (input  p-line-1
      734       ,input  p-line-2
      735       ,input  p-line-3
      736       ,output v-message
      737       ) .
      738     return v-message .
      739   end function .
      740   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   procedure wth-lib_cur-stock-place:
      742   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      743   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      744   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      745   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      746   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      747   define buffer bf_wth-pobj for ub.wth-pobj.
      748   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      749                                bf_wth-pobj.obj-code = parobj-code and
      750                                bf_wth-pobj.w-p-code = parw-p-code and
      751                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      752   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      753                            else assign parstock = 0.
      754   end procedure.
      755   procedure wth-lib_cur-stock-obj:
      756   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      757   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      758   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      759   define output parameter parstock    like ub.wth-obj.income     no-undo.
      760   define buffer bf_wth-obj for ub.wth-obj.
      761   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      762                               bf_wth-obj.obj-code = parobj-code and
      763                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      764   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      765                           else assign parstock = 0.
      766   end.
      767   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      768                                                        INPUT parobj-code AS INTEGER,
      769                                                        INPUT parwth-code AS INTEGER):
      770   define buffer bf_wth-obj for ub.wth-obj.
      771   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      772                               bf_wth-obj.obj-code = parobj-code and
      773                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      774   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      775                           else return 0.00.
      776   end function.
      777   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      778                                                         INPUT parwth-code  AS INTEGER):
      779   define buffer bf_wth-obj for ub.wth-obj.
      780   define variable v-stock like ub.wth-obj.income no-undo.
      781   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      782                                     bf_wth-obj.wth-code = parwth-code :
      783     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      784   end.
      785   return v-stock.
      786   end function.
      787   procedure wth-lib_full-inf-shift:
      788   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      789   end procedure.
      790   procedure wth-lib_full-inf-shift-inter:
      791   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        ((cur_wth-line.shift-date = parshift-date1 and                           cur_wth-line.shift-num  <= parshift-num1)  or                            cur_wth-line.shift-date < parshift-date1 ) and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      792   end procedure.
      793   procedure wth-lib_full-inf-shift-period-place:
      794   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parw-p-code     like ub.wth-pobj.w-p-code  no-undo.                        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code = parw-p-code and     