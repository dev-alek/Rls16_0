        1   define new global shared variable g#language as character no-undo .
        2   if g#language <> '' and g#language <> 'rus':U then do:
        3     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        4   end.
        5   procedure proc-alt-shift-f2:
        6     if not ibs.th.gbl.gbl-var:rcode
        7   then
        8     run gbl\inidebug.p .
        9   end.
       10   procedure proc-alt-shift-f3:
       11     run gbl/prvssinf.p
       12       ( input this-procedure
       13       ) .
       14   end.
       15   define variable v-inform-launched as logical no-undo initial false .
       16   procedure proc-alt-shift-f4:
       17     define variable v-action as character no-undo .
       18     if v-inform-launched = false then do:
       19       assign
       20         v-inform-launched = true
       21       .
       22       run gbl/d-inform.w
       23         (  input self
       24         ,  input this-procedure
       25         , output v-action
       26         ) no-error .
       27       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       28       assign
       29         v-inform-launched = false
       30       .
       31     end.
       32   end.
       33   procedure proc-alt-f1:
       34     run gbl/corrhelp.p
       35       (input this-procedure
       36       ) .
       37   end .
       38   on alt-shift-f2 anywhere do:
       39     run proc-alt-shift-f2.
       40   end.
       41   on alt-shift-f3 anywhere do:
       42     run proc-alt-shift-f3 in this-procedure .
       43   end.
       44   on alt-shift-f4 anywhere do:
       45     run proc-alt-shift-f4 in this-procedure.
       46   end.
       47   on alt-f1 anywhere do:
       48     run proc-alt-f1 in this-procedure .
       49   end.
