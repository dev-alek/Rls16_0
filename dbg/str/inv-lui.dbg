      585         tt-result.scan-1 COLUMN-LABEL "Рез-т!1-ого!сканир.":C FORMAT ">>>,>>9.999":U
      586         tt-result.scan-2 COLUMN-LABEL "Рез-т!2-ого!сканир.":C FORMAT ">>>,>>9.999":U
      587         tt-result.diff-1-2 COLUMN-LABEL "Разница!между!1 и 2!сканир.":C FORMAT ">>>,>>9.999":U
      588         fill(" ", 11 - length(tt-result.scan-3)) + tt-result.scan-3 COLUMN-LABEL "Рез-т!3-его!сканир.":C FORMAT "x(11)":U
      589         tt-result.itog COLUMN-LABEL "Итоги!по!инвентар.":C FORMAT ">>>,>>9.999":U
      590         tt-result.b-code COLUMN-LABEL "Бар-!код!товара":C FORMAT "999999999":U
      591         ENABLE tt-result.itog
      592       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20.63 EXPANDABLE.
      593   DEFINE FRAME Dialog-Frame
      594        b-exit AT ROW 1 COL 1
      595        b-save AT ROW 1 COL 11
      596        b-scan-1 AT ROW 1 COL 22
      597        b-clear-scan-1 AT ROW 1 COL 32
      598        b-scan-2 AT ROW 1 COL 42
      599        b-clear-scan-2 AT ROW 1 COL 52
      600        b-scan-3 AT ROW 1 COL 62
      601        b-clear-scan-3 AT ROW 1 COL 72
      602        b-help AT ROW 1 COL 82
      603        b-print AT ROW 2 COL 1
      604        b-export AT ROW 2 COL 16
      605        b-result AT ROW 3 COL 1
      606       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      607            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      608            TITLE "Экран инвентаризации".
      609   ASSIGN
      610          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      611          FRAME Dialog-Frame:HIDDEN           = TRUE.
      612   ON END-ERROR OF FRAME Dialog-Frame
      613   DO:
      614     RETURN NO-APPLY.
      615   END.
      616   ON ENDKEY OF FRAME Dialog-Frame
      617   DO:
      618     RETURN NO-APPLY.
      619   END.
      620   ON return OF FRAME Dialog-Frame
      621   DO:
      622     RETURN NO-APPLY.
      623   END.
      624   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      625   DO:
      626     APPLY "END-ERROR":U TO SELF.
      627   END.
      628   ON CHOOSE OF b-clear-scan-1 IN FRAME Dialog-Frame
      629   DO:
      630       IF varscan-1 <> YES THEN DO:
      631         MESSAGE "Первое сканирование еще не было сделано." VIEW-AS ALERT-BOX.
      632         RETURN NO-APPLY.
      633       END.
      634       IF varscan-3 = YES THEN DO:
      635         MESSAGE "Есть третье сканирование. Нельзя аннулировать второе." VIEW-AS ALERT-BOX.
      636         RETURN NO-APPLY.
      637       END.
      638       FOR EACH tt-result:
      639          ASSIGN
      640            tt-result.scan-1 = ?
      641            tt-result.diff-1-2 = 0
      642            tt-result.itog = ?.
      643       END.
      644       ASSIGN
      645         varscan-1 = NO.
      646       RUN open-query IN THIS-PROCEDURE.
      647   END.
      648   ON CHOOSE OF b-clear-scan-2 IN FRAME Dialog-Frame
      649   DO:
      650     IF varscan-2 <> YES THEN DO:
      651       MESSAGE "Второе сканирование еще не было сделано." VIEW-AS ALERT-BOX.
      652       RETURN NO-APPLY.
      653     END.
      654     IF varscan-3 = YES THEN DO:
      655       MESSAGE "Есть третье сканирование. Нельзя аннулировать второе." VIEW-AS ALERT-BOX.
      656       RETURN NO-APPLY.
      657     END.
      658     FOR EACH tt-result:
      659        ASSIGN
      660          tt-result.scan-2 = ?
      661          tt-result.diff-1-2 = 0
      662          tt-result.itog = ?.
      663     END.
      664     ASSIGN
      665       varscan-2 = NO.
      666     RUN open-query IN THIS-PROCEDURE.
      667   END.
      668   ON CHOOSE OF b-clear-scan-3 IN FRAME Dialog-Frame
      669   DO:
      670     IF varscan-3 = NO THEN DO:
      671       MESSAGE "Третье сканирование еще не было сделано." VIEW-AS ALERT-BOX.
      672       RETURN NO-APPLY.
      673     END.
      674     IF varscan-1 <> YES THEN DO:
      675       MESSAGE "Критическая ошибка. Не было сделано первое сканирование." VIEW-AS ALERT-BOX.
      676       RETURN NO-APPLY.
      677     END.
      678     IF varscan-2 <> YES THEN DO:
      679       MESSAGE "Критическая ошибка. Не было сделано второе сканирование." VIEW-AS ALERT-BOX.
      680       RETURN NO-APPLY.
      681     END.
      682     FOR EACH tt-result :
      683       ASSIGN
      684         tt-result.scan-3 = "":u.
      685       IF tt-result.scan-1 = tt-result.scan-2 THEN DO:
      686         ASSIGN
      687           tt-result.itog = tt-result.scan-1.
      688       END.
      689       ELSE DO:
      690         ASSIGN
      691           tt-result.itog = ?.
      692       END.
      693     END.
      694     ASSIGN
      695       varscan-3 = NO.
      696     RUN open-query IN THIS-PROCEDURE.
      697   END.
      698   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      699   DO:
      700     DEFINE VARIABLE varlog AS LOGICAL INITIAL YES.
      701     message "Вы действительно хотите выйти из интерфейса сравнения результатов?"
      702     view-as alert-box QUESTION BUTTONS YES-NO UPDATE varlog.
      703     if varlog <> yes then do:
      704       return no-apply.
      705     end.
      706     IF varsave-result = NO THEN DO:
      707       MESSAGE "Вы не сохранили в файл результаты. Хотите сохранить информацию?"
      708       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE varlog.
      709       IF varlog = YES THEN DO:
      710         RUN save-itog IN THIS-PROCEDURE NO-ERROR.
      711         IF ERROR-STATUS:ERROR THEN DO:
      712           RETURN NO-APPLY.
      713         END.
      714       END.
      715     END.
      716     APPLY "go" TO FRAME Dialog-Frame.
      717   END.
      718   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      719   DO:
      720     RUN save-diff IN THIS-PROCEDURE.
      721   END.
      722   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      723   OR HELP OF FRAME Dialog-Frame
      724   DO:
      725     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\str\inv-lui.w" VIEW-AS ALERT-BOX INFORMATION.
      726   END.
      727   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      728   DO:
      729     run rep/invlui2p.p (parparentproc  , INPUT TABLE tt-result).
      730   END.
      731   ON END-ERROR OF b-result IN FRAME Dialog-Frame
      732   DO:
      733     RETURN NO-APPLY.
      734   END.
      735   ON ENDKEY OF b-result IN FRAME Dialog-Frame
      736   DO:
      737     RETURN NO-APPLY.
      738   END.
      739   ON GO OF b-result IN FRAME Dialog-Frame
      740   DO:
      741     RETURN NO-APPLY.
      742   END.
      743   ON ROW-LEAVE OF b-result IN FRAME Dialog-Frame
      744   DO:
      745     ASSIGN BROWSE b-result
      746         tt-result.itog.
      747   END.
      748   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      749   DO:
      750     RUN save-itog IN THIS-PROCEDURE.
      751   END.
      752   ON CHOOSE OF b-scan-1 IN FRAME Dialog-Frame
      753   DO:
      754     IF varscan-3 = YES THEN DO:
      755       MESSAGE "Третье сканирование должно быть аннулировано, если производиться первое или второе."
      756       VIEW-AS ALERT-BOX.
      757       RETURN NO-APPLY.
      758     END.
      759     IF varscan-1 THEN DO:
      760       MESSAGE "Первое сканирование уже было сделано." VIEW-AS ALERT-BOX.
      761       RETURN NO-APPLY.
      762     END.
      763     RUN scan-file (INPUT 1).
      764     ASSIGN
      765       varscan-1      = YES.
      766     IF varscan-2 = YES THEN DO:
      767       ASSIGN
      768         varsave-result = NO.
      769     END.
      770   END.
      771   ON CHOOSE OF b-scan-2 IN FRAME Dialog-Frame
      772   DO:
      773       IF varscan-3 = YES THEN DO:
      774         MESSAGE "Третье сканирование должно быть аннулировано, если производиться первое или второе."
      775         VIEW-AS ALERT-BOX.
      776         RETURN NO-APPLY.
      777       END.
      778       IF varscan-2 THEN DO:
      779         MESSAGE "Второе сканирование уже было сделано." VIEW-AS ALERT-BOX.
      780         RETURN NO-APPLY.
      781       END.
      782       RUN scan-file (INPUT 2).
      783       ASSIGN
      784         varscan-2      = YES.
      785       IF varscan-1 = YES THEN DO:
      786         ASSIGN
      787           varsave-result = NO.
      788       END.
      789   END.
      790   ON CHOOSE OF b-scan-3 IN FRAME Dialog-Frame
      791   DO:
      792      IF varscan-1 <> YES OR varscan-2 <> YES THEN DO:
      793         MESSAGE "Третье сканирование может быть сделано только после первого и второго."
      794         VIEW-AS ALERT-BOX.
      795         RETURN NO-APPLY.
      796       END.
      797       RUN scan-file (INPUT 3).
      798       ASSIGN
      799           varscan-3 = YES
      800           varsave-result = NO.
      801   END.
      802   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      803   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      804   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      805   on help of frame Dialog-Frame
      806   do:
      807     run gbl/app_help.p
      808       (input this-procedure :file-name
      809       ,input ''
      810       ,input ?
      811       ) no-error.
      812     if error-status :error then do:
      813       message
      814         "Ошибка при вызове помощи"
      815         error-status :get-message(1)
      816         view-as alert-box .
      817     end.
      818   end.
      819   run minbtn-set in this-procedure .
      820   on choose of b-help in frame Dialog-Frame
      821   do:
      822     apply "help":u to frame Dialog-Frame .
      823   end.
      824   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      825   procedure minbtn-set :
      826       do
      827           on error undo, return error return-value
      828           :
      829           define variable ii              as integer       no-undo .
      830           define variable fh              as widget-handle no-undo .
      831           define variable hh              as widget-handle no-undo .
      832           define variable v-h             as handle        extent 4 no-undo .
      833           define variable v-name-button   as character     no-undo .
      834           define variable v-help-old-x    as decimal       no-undo .
      835           define variable v-help-old-y    as decimal       no-undo .
      836           define variable v-help-old-size as decimal       no-undo .
      837           define variable v-frame-width   as decimal       no-undo .
      838           define variable jj              as integer       no-undo .
      839           do
      840               on error undo, return error
      841               :
      842               assign
      843                   v-frame-width = frame Dialog-Frame:width - 0.3
      844                   fh            = frame Dialog-Frame:first-child
      845                   hh            = fh:first-child
      846                   ii            = 1
      847                   .
      848               do while valid-handle(hh):
      849                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      850                   do:
      851                       case lc(hh:name) :
      852                           when "b-help" then
      853                               do:
      854                                   hh:load-image-up("cmp/b-help.bmp":u) .
      855                                   hh:load-image-down("cmp/b-help.bmp":u) .
      856                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      857                                   hh:TOOLTIP = "Помощь" .
      858                                   v-help-old-x = hh:column .
      859                                   v-help-old-y = hh:row    .
      860                                   v-help-old-size = hh:width .
      861                                   hh:width-chars = 2.5 .
      862                               end.
      863                           when "b-print" then
      864                               do:
      865                                   hh:load-image("cmp/b-print.bmp":u) .
      866                                   hh:TOOLTIP = "Печать" .
      867                                   v-h[ii] = hh:handle .
      868                                   ii = ii + 1 .
      869                                   hh:width-chars = 3 .
      870                               end.
      871                           when "b-history" or
      872                           when "b-hist" then
      873                               do:
      874                                   hh:load-image("cmp/b-hist.bmp":u) .
      875                                   hh:TOOLTIP = "История" .
      876                                   v-h[ii] = hh:handle .
      877                                   ii = ii + 1 .
      878                                   hh:width-chars = 3 .
      879                               end.
      880                           when "b-sch" then
      881                               do:
      882                                   hh:load-image("cmp/b-sch.bmp":u) .
      883                                   hh:TOOLTIP = "Установка Фильтра" .
      884                                   v-h[ii] = hh:handle .
      885                                   ii = ii + 1 .
      886                                   hh:width-chars = 3 .
      887                               end.
      888                           when "b-hist-user" then
      889                               do:
      890                                   hh:load-image("cmp/b-hist.bmp":u) .
      891                                   hh:TOOLTIP = "История пользователя" .
      892                                   ii = ii + 1 .
      893                               end.
      894                       end case.
      895                   end.
      896                   hh = hh:next-sibling.
      897               end.
      898               b-help:column = v-frame-width - b-help:width-chars.
      899               jj = 0.
      900               repeat ii = 4 to 1 by -1 :
      901                   if valid-handle (v-h[ii] ) then
      902                   do:
      903                       jj  = jj + 1 .
      904                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      905                       v-h[ii]:row    = v-help-old-y .
      906                   end.
      907               end.
      908           end.
      909       end.
      910   end procedure.
      911   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      912   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      913   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      914   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      915   define variable v-diasize-current-frame-width  as decimal   no-undo .
      916   define variable v-diasize-current-frame-height as decimal   no-undo .
      917   define variable v-diasize-change-size          as logical   no-undo .
      918   define variable v-diasize-resize-button        as handle    no-undo .
      919   define variable v-diasize-wndmax               as logical   no-undo .
      920   define variable v-diasize-wndstore             as logical   no-undo .
      921   define variable v-diasize-proc-name            as character no-undo .
      922   define variable v-diasize-browse-handle        as handle    no-undo .
      923   define variable v-diasize-browse-number        as integer   no-undo .
      924   define variable v-diasize-need-full-display    as logical   no-undo init false .
      925   define temp-table temp-diasize-handle no-undo
      926     field handle-value  as handle
      927     field save-position as decimal
      928     index xpk is primary unique handle-value
      929     .
      930   define temp-table temp-browse-handle no-undo
      931     field browse-type   as character
      932     field browse-number as integer
      933     field browse-handle as handle
      934     field original-size as decimal
      935     index xpk is primary unique browse-type browse-number
      936     index xie browse-type browse-handle
      937   .
      938   procedure diasize_change-height :
      939     define input  parameter p-change-value  as decimal   no-undo .
      940     define input  parameter p-move-resize   as logical   no-undo .
      941     define variable v-field-group-handle    as handle    no-undo .
      942     define variable v-object-handle         as handle    no-undo .
      943     define variable v-frame-height          as decimal   no-undo .
      944     define variable v-frame-virtual-height  as decimal   no-undo .
      945     define variable v-browse-height         as decimal   no-undo .
      946     define variable v-window-height         as decimal   no-undo .
      947     define variable v-window-virtual-height as decimal   no-undo .
      948     define variable v-change-sign           as integer   no-undo .
      949     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      950     define buffer buf_temp-browse-handle  for temp-browse-handle .
      951     if p-change-value > 0
      952     then do:
      953       if frame Dialog-Frame :height + p-change-value
      954           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      955       then do:
      956         assign
      957           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      958                           - (frame Dialog-Frame :height-chars)
      959         .
      960         if p-change-value <= 0
      961         then do:
      962           run diasize_position-resize-button in this-procedure .
      963           return .
      964         end.
      965       end.
      966     end.
      967     if p-change-value < 0
      968     then do:
      969       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      970       then do:
      971         assign
      972           p-change-value = v-diasize-orig-frame-height
      973                          - (frame Dialog-Frame :height-chars)
      974         .
      975         if p-change-value >= 0
      976         then do:
      977           run diasize_position-resize-button in this-procedure .
      978           return .
      979         end.
      980       end.
      981     end.
      982     if p-change-value >= 0
      983     then do:
      984       assign
      985         v-change-sign = 1
      986       .
      987     end.
      988     else do:
      989       assign
      990         v-change-sign = -1
      991       .
      992     end.
      993     assign
      994       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      995     .
      996     if p-change-value = 0
      997     then do:
      998       run diasize_position-resize-button in this-procedure .
      999       return .
     1000     end.
     1001     move_block:
     1002     do
     1003     on error undo move_block, retry move_block
     1004     :
     1005       if retry
     1006       then do:
     1007         do
     1008         on error undo move_block, leave move_block
     1009         :
     1010           if p-change-value > 0
     1011           then do:
     1012             for each buf_temp-diasize-handle
     1013             on error undo, next
     1014             :
     1015               assign
     1016                 v-object-handle = buf_temp-diasize-handle.handle-value
     1017               .
     1018               if v-object-handle <> v-diasize-resize-button
     1019               then do:
     1020                 assign
     1021                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1022                 .
     1023               end.
     1024             end.
     1025             assign
     1026               v-diasize-browse-handle :height = v-browse-height
     1027             .
     1028             for each buf_temp-browse-handle
     1029               where buf_temp-browse-handle.browse-type = 'height':u
     1030             on error undo, next
     1031             :
     1032               assign
     1033                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1034               .
     1035             end.
     1036             assign
     1037               frame Dialog-Frame :height = v-frame-height
     1038             .
     1039             if frame Dialog-Frame :scrollable = true
     1040             then do:
     1041               assign
     1042                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1043               .
     1044             end.
     1045             run diasize_position-resize-button in this-procedure .
     1046           end.
     1047           else do:
     1048             if frame Dialog-Frame :scrollable = true
     1049             then do:
     1050               assign
     1051                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1052               .
     1053             end.
     1054             assign
     1055               frame Dialog-Frame :height = v-frame-height
     1056             .
     1057             assign
     1058               v-diasize-browse-handle :height = v-browse-height
     1059             .
     1060             for each buf_temp-browse-handle
     1061               where buf_temp-browse-handle.browse-type = 'height':u
     1062             on error undo, next
     1063             :
     1064               assign
     1065                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1066               .
     1067             end.
     1068             for each buf_temp-diasize-handle
     1069             on error undo, next
     1070             :
     1071               assign
     1072                 v-object-handle = buf_temp-diasize-handle.handle-value
     1073               .
     1074               if v-object-handle <> v-diasize-resize-button
     1075               then do:
     1076                 assign
     1077                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1078                 .
     1079               end.
     1080             end.
     1081             run diasize_position-resize-button in this-procedure .
     1082           end.
     1083           assign
     1084             v-diasize-change-size = false
     1085           .
     1086           leave move_block .
     1087         end.
     1088       end.
     1089       assign
     1090         v-diasize-need-full-display = true
     1091       .
     1092       if v-diasize-change-size = false
     1093       then do:
     1094         assign
     1095           v-diasize-change-size = true
     1096         .
     1097       end.
     1098       else do:
     1099         return .
     1100       end.
     1101       assign
     1102         v-frame-height = frame Dialog-Frame :height
     1103         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1104         v-browse-height = v-diasize-browse-handle :height
     1105       .
     1106       for each buf_temp-browse-handle
     1107         where buf_temp-browse-handle.browse-type = 'height':u
     1108       :
     1109         assign
     1110           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1111         .
     1112       end.
     1113       for each buf_temp-diasize-handle
     1114       :
     1115         delete buf_temp-diasize-handle .
     1116       end.
     1117       assign
     1118         v-field-group-handle = frame Dialog-Frame :first-child
     1119       .
     1120       do while valid-handle(v-field-group-handle)
     1121       :
     1122         assign
     1123           v-object-handle = v-field-group-handle :first-child
     1124         .
     1125         do while valid-handle(v-object-handle)
     1126         :
     1127           if  v-object-handle <> v-diasize-browse-handle :handle
     1128           and can-query(v-object-handle, "row")
     1129           and can-query(v-object-handle, "height")
     1130           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1131           then do:
     1132             find first buf_temp-browse-handle
     1133               where buf_temp-browse-handle.browse-type   = 'height':u
     1134                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1135               no-error .
     1136             if available buf_temp-browse-handle
     1137             then do:
     1138             end.
     1139             else do:
     1140               create buf_temp-diasize-handle .
     1141               assign
     1142                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1143                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1144               .
     1145             end.
     1146           end.
     1147           assign
     1148             v-object-handle = v-object-handle :next-sibling
     1149           .
     1150         end.
     1151         assign
     1152           v-field-group-handle = v-field-group-handle :next-sibling
     1153         .
     1154       end.
     1155       do with frame Dialog-Frame
     1156       :
     1157         hide v-diasize-resize-button .
     1158         assign
     1159           v-diasize-resize-button :row    = 1
     1160           v-diasize-resize-button :column = 1
     1161         .
     1162       end.
     1163       if p-change-value > 0
     1164       then do:
     1165         if frame Dialog-Frame :scrollable = true
     1166         then do:
     1167           assign
     1168             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1169             no-error .
     1170           if error-status :error
     1171           or error-status :get-message(1) <> ""
     1172           then do:
     1173             undo move_block, retry move_block .
     1174           end.
     1175         end.
     1176         assign
     1177           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1178           no-error .
     1179         if error-status :error
     1180         or error-status :get-message(1) <> ""
     1181         then do:
     1182           undo move_block, retry move_block .
     1183         end.
     1184         assign
     1185           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1186           no-error .
     1187         if error-status :error
     1188         or error-status :get-message(1) <> ""
     1189         then do:
     1190           undo move_block, retry move_block .
     1191         end.
     1192         for each buf_temp-browse-handle
     1193           where buf_temp-browse-handle.browse-type = 'height':u
     1194         on error undo move_block, retry move_block
     1195         :
     1196           assign
     1197             buf_temp-browse-handle.browse-handle :height
     1198               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1199             no-error .
     1200           if error-status :error
     1201           or error-status :get-message(1) <> ""
     1202           then do:
     1203             undo move_block, retry move_block .
     1204           end.
     1205         end.
     1206         for each buf_temp-diasize-handle
     1207         on error undo move_block, retry move_block
     1208         :
     1209           assign
     1210             v-object-handle = buf_temp-diasize-handle.handle-value
     1211           .
     1212           if v-object-handle <> v-diasize-resize-button
     1213           then do:
     1214             assign
     1215               v-object-handle :row = v-object-handle :row + p-change-value
     1216               no-error .
     1217             if error-status :error
     1218             or error-status :get-message(1) <> ""
     1219             then do:
     1220               undo move_block, retry move_block .
     1221             end.
     1222           end.
     1223         end.
     1224       end.
     1225       else do:
     1226         for each buf_temp-diasize-handle
     1227         on error undo move_block, retry move_block
     1228         :
     1229           assign
     1230             v-object-handle = buf_temp-diasize-handle.handle-value
     1231           .
     1232           if v-object-handle <> v-diasize-resize-button
     1233           then do:
     1234             assign
     1235               v-object-handle :row = v-object-handle :row + p-change-value
     1236               no-error .
     1237             if error-status :error
     1238             or error-status :get-message(1) <> ""
     1239             then do:
     1240               undo move_block, retry move_block .
     1241             end.
     1242           end.
     1243         end.
     1244         assign
     1245           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1246           no-error .
     1247         if error-status :error
     1248         or error-status :get-message(1) <> ""
     1249         then do:
     1250           undo move_block, retry move_block .
     1251         end.
     1252         for each buf_temp-browse-handle
     1253           where buf_temp-browse-handle.browse-type = 'height':u
     1254         on error undo move_block, retry move_block
     1255         :
     1256           assign
     1257             buf_temp-browse-handle.browse-handle :height
     1258               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1259             no-error .
     1260           if error-status :error
     1261           or error-status :get-message(1) <> ""
     1262           then do:
     1263             undo move_block, retry move_block .
     1264           end.
     1265         end.
     1266         assign
     1267           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1268           no-error .
     1269         if error-status :error
     1270         or error-status :get-message(1) <> ""
     1271         then do:
     1272           undo move_block, retry move_block .
     1273         end.
     1274         if frame Dialog-Frame :scrollable = true
     1275         then do:
     1276           assign
     1277             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1278             no-error .
     1279           if error-status :error
     1280           or error-status :get-message(1) <> ""
     1281           then do:
     1282             undo move_block, retry move_block .
     1283           end.
     1284         end.
     1285       end.
     1286       if p-move-resize = true
     1287       then do:
     1288         run diasize_position-resize-button in this-procedure .
     1289       end.
     1290       if v-diasize-wndstore = true
     1291       then do:
     1292         if connected("ub") = true
     1293         then do:
     1294           define variable v-cntxt-db-num        as integer   no-undo .
     1295           define variable v-cntxt-userid        as character no-undo .
     1296           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1297                                             , OUTPUT v-cntxt-userid
     1298                                             ) .
     1299           run gbl/wndsizew.p
     1300             (input  v-cntxt-db-num
     1301             ,input  v-cntxt-userid
     1302             ,input  v-diasize-proc-name
     1303             ,input  'height':u
     1304             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1305             ) .
     1306         end.
     1307       end.
     1308     end.
     1309     assign
     1310       v-diasize-change-size = false
     1311     .
     1312   end procedure.
     1313   procedure diasize_set-height :
     1314     define input  parameter p-new-height  as decimal   no-undo .
     1315     define input  parameter p-move-resize as logical   no-undo .
     1316     do
     1317     on error undo, return error return-value
     1318     :
     1319       run diasize_change-height in this-procedure
     1320         (input  (p-new-height - frame Dialog-Frame :height)
     1321         ,input  p-move-resize
     1322         ) .
     1323     end.
     1324   end procedure.
     1325   procedure diasize_change-width :
     1326     define input  parameter p-change-value as decimal   no-undo .
     1327     define input  parameter p-move-resize  as logical   no-undo .
     1328     define variable v-field-group-handle   as handle    no-undo .
     1329     define variable v-object-handle        as handle    no-undo .
     1330     define variable v-frame-width          as decimal   no-undo .
     1331     define variable v-frame-virtual-width  as decimal   no-undo .
     1332     define variable v-browse-width         as decimal   no-undo .
     1333     define variable v-window-width         as decimal   no-undo .
     1334     define variable v-window-virtual-width as decimal   no-undo .
     1335     define variable v-change-sign          as integer   no-undo .
     1336     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1337     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1338     if p-change-value > 0
     1339     then do:
     1340       if frame Dialog-Frame :width + p-change-value >
     1341           session :width-chars
     1342       then do:
     1343         assign
     1344           p-change-value = session :width-chars - frame Dialog-Frame :width
     1345         .
     1346         if p-change-value <= 0
     1347         then do:
     1348           run diasize_position-resize-button in this-procedure .
     1349           return .
     1350         end.
     1351       end.
     1352     end.
     1353     if p-change-value < 0
     1354     then do:
     1355       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1356       then do:
     1357         assign
     1358           p-change-value = v-diasize-orig-frame-width
     1359                          - frame Dialog-Frame :width
     1360         .
     1361         if p-change-value >= 0
     1362         then do:
     1363           run diasize_position-resize-button in this-procedure .
     1364           return .
     1365         end.
     1366       end.
     1367     end.
     1368     if p-change-value >= 0
     1369     then do:
     1370       assign
     1371         v-change-sign = 1
     1372       .
     1373     end.
     1374     else do:
     1375       assign
     1376         v-change-sign = -1
     1377       .
     1378     end.
     1379     assign
     1380       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1381     .
     1382     if p-change-value = 0
     1383     then do:
     1384       run diasize_position-resize-button in this-procedure .
     1385       return .
     1386     end.
     1387     move_block:
     1388     do
     1389     on error undo move_block, leave move_block
     1390     :
     1391       if retry
     1392       then do:
     1393         do
     1394         on error undo move_block, leave move_block
     1395         :
     1396           if p-change-value > 0
     1397           then do:
     1398             for each buf_temp-diasize-handle
     1399             on error undo, next
     1400             :
     1401               assign
     1402                 v-object-handle = buf_temp-diasize-handle.handle-value
     1403               .
     1404               if v-object-handle <> v-diasize-resize-button
     1405               then do:
     1406                 assign
     1407                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1408                 .
     1409               end.
     1410             end.
     1411             assign
     1412               v-diasize-browse-handle :width = v-browse-width
     1413             .
     1414             for each buf_temp-browse-handle
     1415               where buf_temp-browse-handle.browse-type = 'width':u
     1416             on error undo, next
     1417             :
     1418               assign
     1419                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1420               .
     1421             end.
     1422             assign
     1423               frame Dialog-Frame :width = v-frame-width
     1424             .
     1425             if frame Dialog-Frame :scrollable = true
     1426             then do:
     1427               assign
     1428                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1429               .
     1430             end.
     1431             run diasize_position-resize-button in this-procedure .
     1432           end.
     1433           else do:
     1434             if frame Dialog-Frame :scrollable = true
     1435             then do:
     1436               assign
     1437                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1438               .
     1439             end.
     1440             assign
     1441               frame Dialog-Frame :width = v-frame-width
     1442             .
     1443             for each buf_temp-browse-handle
     1444               where buf_temp-browse-handle.browse-type = 'width':u
     1445             on error undo, next
     1446             :
     1447               assign
     1448                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1449               .
     1450             end.
     1451             assign
     1452               v-diasize-browse-handle :width = v-browse-width
     1453             .
     1454             for each buf_temp-diasize-handle
     1455             on error undo, next
     1456             :
     1457               assign
     1458                 v-object-handle = buf_temp-diasize-handle.handle-value
     1459               .
     1460               if v-object-handle <> v-diasize-resize-button
     1461               then do:
     1462                 assign
     1463                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1464                 .
     1465               end.
     1466             end.
     1467             run diasize_position-resize-button in this-procedure .
     1468           end.
     1469           assign
     1470             v-diasize-change-size = false
     1471           .
     1472           leave move_block .
     1473         end.
     1474       end.
     1475       assign
     1476         v-diasize-need-full-display = true
     1477       .
     1478       if v-diasize-change-size = false
     1479       then do:
     1480         assign
     1481           v-diasize-change-size = true
     1482         .
     1483       end.
     1484       else do:
     1485         return .
     1486       end.
     1487       assign
     1488         v-frame-width = frame Dialog-Frame :width
     1489         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1490         v-browse-width = v-diasize-browse-handle :width
     1491       .
     1492       for each buf_temp-browse-handle
     1493         where buf_temp-browse-handle.browse-type = 'width':u
     1494       :
     1495         assign
     1496           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1497         .
     1498       end.
     1499       for each buf_temp-diasize-handle
     1500       :
     1501         delete buf_temp-diasize-handle .
     1502       end.
     1503       assign
     1504         v-field-group-handle = frame Dialog-Frame :first-child
     1505       .
     1506       do while valid-handle(v-field-group-handle)
     1507       :
     1508         assign
     1509           v-object-handle = v-field-group-handle :first-child
     1510         .
     1511         do while valid-handle(v-object-handle)
     1512         :
     1513           if  v-object-handle <> v-diasize-browse-handle :handle
     1514           and v-object-handle <> v-diasize-resize-button
     1515           and can-query(v-object-handle, "row")
     1516           and can-query(v-object-handle, "height")
     1517           and ( v-object-handle :col + v-object-handle :width
     1518                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1519               )
     1520           then do:
     1521             find first buf_temp-browse-handle
     1522               where buf_temp-browse-handle.browse-type   = 'width':u
     1523                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1524               no-error .
     1525             if available buf_temp-browse-handle
     1526             then do:
     1527             end.
     1528             else do:
     1529               create buf_temp-diasize-handle .
     1530               assign
     1531                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1532                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1533               .
     1534             end.
     1535           end.
     1536           assign
     1537             v-object-handle = v-object-handle :next-sibling
     1538           .
     1539         end.
     1540         assign
     1541           v-field-group-handle = v-field-group-handle :next-sibling
     1542         .
     1543       end.
     1544       do with frame Dialog-Frame
     1545       :
     1546         hide v-diasize-resize-button .
     1547         v-diasize-resize-button :row = 1.
     1548         v-diasize-resize-button :column = 1.
     1549       end.
     1550       if p-change-value > 0
     1551       then do:
     1552         if frame Dialog-Frame :scrollable = true
     1553         then do:
     1554           assign
     1555             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1556             no-error .
     1557           if error-status :error
     1558           or error-status :get-message(1) <> ""
     1559           then do:
     1560             undo move_block, retry move_block.
     1561           end.
     1562         end.
     1563         assign
     1564           frame Dialog-Frame :width = v-frame-width + p-change-value
     1565           no-error .
     1566         if error-status :error
     1567         or error-status :get-message(1) <> ""
     1568         then do:
     1569           undo move_block, retry move_block.
     1570         end.
     1571         assign
     1572           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1573         no-error .
     1574         if error-status :error
     1575         or error-status :get-message(1) <> ""
     1576         then do:
     1577           undo move_block, retry move_block.
     1578         end.
     1579         for each buf_temp-browse-handle
     1580           where buf_temp-browse-handle.browse-type = 'width':u
     1581         on error undo move_block, retry move_block
     1582         :
     1583           assign
     1584             buf_temp-browse-handle.browse-handle :width
     1585               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1586             no-error .
     1587           if error-status :error
     1588           or error-status :get-message(1) <> ""
     1589           then do:
     1590             undo move_block, retry move_block .
     1591           end.
     1592         end.
     1593         for each buf_temp-diasize-handle
     1594         on error undo move_block, retry move_block
     1595         :
     1596           assign
     1597             v-object-handle = buf_temp-diasize-handle.handle-value
     1598           .
     1599           if v-object-handle <> v-diasize-resize-button
     1600           then do:
     1601             assign
     1602               v-object-handle :col = v-object-handle :col + p-change-value
     1603               no-error .
     1604             if error-status :error
     1605             or error-status :get-message(1) <> ""
     1606             then do:
     1607               undo move_block, retry move_block .
     1608             end.
     1609           end.
     1610         end.
     1611       end.
     1612       else do:
     1613         for each buf_temp-diasize-handle
     1614         on error undo move_block, retry move_block
     1615         :
     1616           assign
     1617             v-object-handle = buf_temp-diasize-handle.handle-value
     1618           .
     1619           if v-object-handle <> v-diasize-resize-button
     1620           then do:
     1621             assign
     1622               v-object-handle :col = v-object-handle :col + p-change-value
     1623               no-error .
     1624             if error-status :error
     1625             or error-status :get-message(1) <> ""
     1626             then do:
     1627               undo move_block, retry move_block .
     1628             end.
     1629           end.
     1630         end.
     1631         for each buf_temp-browse-handle
     1632           where buf_temp-browse-handle.browse-type = 'width':u
     1633         on error undo move_block, retry move_block
     1634         :
     1635           assign
     1636             buf_temp-browse-handle.browse-handle :width
     1637               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1638             no-error .
     1639           if error-status :error
     1640           or error-status :get-message(1) <> ""
     1641           then do:
     1642             undo move_block, retry move_block .
     1643           end.
     1644         end.
     1645         assign
     1646           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1647           no-error .
     1648         if error-status :error
     1649         or error-status :get-message(1) <> ""
     1650         then do:
     1651           undo move_block, retry move_block.
     1652         end.
     1653         assign
     1654           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1655         no-error .
     1656         if error-status :error
     1657         or error-status :get-message(1) <> ""
     1658         then do:
     1659           undo move_block, retry move_block.
     1660         end.
     1661         if frame Dialog-Frame :scrollable = true
     1662         then do:
     1663           assign
     1664             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1665           no-error .
     1666           if error-status :error
     1667           or error-status :get-message(1) <> ""
     1668           then do:
     1669             undo move_block, retry move_block.
     1670           end.
     1671         end.
     1672       end.
     1673       if p-move-resize
     1674       then do:
     1675         run diasize_position-resize-button in this-procedure .
     1676       end.
     1677       if v-diasize-wndstore = true
     1678       then do:
     1679         if connected("ub") = true
     1680         then do:
     1681           define variable v-cntxt-db-num        as integer   no-undo .
     1682           define variable v-cntxt-userid        as character no-undo .
     1683           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1684                                             , OUTPUT v-cntxt-userid
     1685                                             ) .
     1686           run gbl/wndsizew.p
     1687             (input  v-cntxt-db-num
     1688             ,input  v-cntxt-userid
     1689             ,input  v-diasize-proc-name
     1690             ,input  'width':u
     1691             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1692             ) .
     1693         end.
     1694       end.
     1695     end.
     1696     assign
     1697       v-diasize-change-size = false
     1698     .
     1699   end procedure.
     1700   procedure diasize_set-width :
     1701     define input  parameter p-new-width  as decimal   no-undo .
     1702     define input  parameter p-move-resize as logical   no-undo .
     1703     do
     1704     on error undo, return error return-value
     1705     :
     1706       run diasize_change-width in this-procedure
     1707         (input  (p-new-width - frame Dialog-Frame :width)
     1708         ,input  p-move-resize
     1709         ) .
     1710     end.
     1711   end procedure.
     1712   procedure diasize_position-resize-button :
     1713     do with frame Dialog-Frame
     1714     :
     1715       hide v-diasize-resize-button .
     1716       assign
     1717         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1718                     - 1
     1719                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1720         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1721                     - 1
     1722                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1723       .
     1724       view v-diasize-resize-button .
     1725     end.
     1726   end procedure.
     1727   on alt-right anywhere
     1728   do:
     1729     run diasize_change-width in this-procedure
     1730       (input 1
     1731       ,input true
     1732       ) .
     1733     return no-apply .
     1734   end.
     1735   on alt-left anywhere
     1736   do:
     1737     run diasize_change-width in this-procedure
     1738       (input -1
     1739       ,input true
     1740       ) .
     1741     return no-apply .
     1742   end.
     1743   on alt-down anywhere
     1744   do:
     1745     run diasize_change-height in this-procedure
     1746       (input 1
     1747       ,input true
     1748       ) .
     1749     return no-apply .
     1750   end.
     1751   on alt-up anywhere
     1752   do:
     1753     run diasize_change-height in this-procedure
     1754       (input -1
     1755       ,input true
     1756       ) .
     1757     return no-apply .
     1758   end.
     1759   on alt-enter of frame Dialog-Frame
     1760   do:
     1761     run diasize_maximize in this-procedure
     1762       (input  ?
     1763       ).
     1764     return no-apply .
     1765   end.
     1766   procedure diasize_end-move :
     1767     do
     1768     on error undo, return error return-value
     1769     :
     1770       define variable v-row-delta as decimal   no-undo .
     1771       define variable v-col-delta as decimal   no-undo .
     1772       define variable v-new-row as decimal   no-undo .
     1773       define variable v-new-col as decimal   no-undo .
     1774       assign
     1775         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1776         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1777       .
     1778       assign
     1779         v-row-delta = v-new-row - frame Dialog-Frame :height
     1780         v-col-delta = v-new-col - frame Dialog-Frame :width
     1781       .
     1782       run diasize_change-height in this-procedure
     1783         (input v-row-delta
     1784         ,input true
     1785         ) .
     1786       run diasize_change-width in this-procedure
     1787         (input v-col-delta
     1788         ,input true
     1789         ) .
     1790     end.
     1791   end procedure.
     1792   procedure diasize_maximize :
     1793     define input  parameter p-action as logical   no-undo .
     1794     do
     1795     on error undo, return error return-value
     1796     :
     1797       if p-action = ?
     1798       then do:
     1799         if v-diasize-need-maximize = true
     1800         then do:
     1801           assign
     1802             p-action = true
     1803           .
     1804         end.
     1805         else do:
     1806           assign
     1807             p-action = false
     1808           .
     1809         end.
     1810       end.
     1811       if p-action = true
     1812       then do:
     1813         run diasize_change-height in this-procedure
     1814           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1815               - frame Dialog-Frame :height-chars
     1816           ,input true
     1817           ) .
     1818         run diasize_change-width in this-procedure
     1819           (input session :width-chars
     1820               - frame Dialog-Frame :width-chars
     1821           ,input true
     1822           ) .
     1823         assign
     1824           v-diasize-need-maximize = false
     1825         .
     1826       end.
     1827       else do:
     1828         run diasize_change-width in this-procedure
     1829           (input v-diasize-orig-frame-width
     1830               - frame Dialog-Frame :width-chars
     1831           ,input true
     1832           ) .
     1833         run diasize_change-height in this-procedure
     1834           (input v-diasize-orig-frame-height
     1835               - frame Dialog-Frame :height-chars
     1836           ,input true
     1837           ) .
     1838         assign
     1839           v-diasize-need-maximize = true
     1840         .
     1841       end.
     1842     end.
     1843   end procedure.
     1844   procedure diasize_restore-orig-size :
     1845     do
     1846     on error undo, return error return-value
     1847     :
     1848       assign
     1849         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1850         v-diasize-current-frame-height = frame Dialog-Frame :height
     1851       .
     1852       run diasize_set-height in this-procedure
     1853         (input  v-diasize-orig-frame-height
     1854         ,input  true
     1855         ) .
     1856       run diasize_set-width in this-procedure
     1857         (input  v-diasize-orig-frame-width
     1858         ,input  true
     1859         ) .
     1860     end.
     1861   end procedure.
     1862   procedure diasize_restore-current-size :
     1863     do
     1864     on error undo, return error return-value
     1865     :
     1866       run diasize_set-height in this-procedure
     1867         (input  v-diasize-current-frame-height
     1868         ,input  true
     1869         ) .
     1870       run diasize_set-width in this-procedure
     1871         (input  v-diasize-current-frame-width
     1872         ,input  true
     1873         ) .
     1874     end.
     1875   end procedure.
     1876   procedure diasize_set-browse-handle :
     1877     define input  parameter p-browse-handle as handle   no-undo .
     1878     define buffer buf_temp-browse-handle for temp-browse-handle .
     1879     do
     1880     on error undo, return error return-value
     1881     :
     1882       assign
     1883         v-diasize-browse-handle = p-browse-handle
     1884       .
     1885       for each buf_temp-browse-handle
     1886       on error undo, return error return-value
     1887       :
     1888         delete buf_temp-browse-handle .
     1889       end.
     1890     end.
     1891   end procedure.
     1892   procedure diasize_add_browse :
     1893     define input  parameter p-browse-type   as character no-undo .
     1894     define input  parameter p-browse-handle as handle    no-undo .
     1895     define buffer buf_temp-browse-handle for temp-browse-handle .
     1896     do
     1897     on error undo, return error return-value
     1898     :
     1899       assign
     1900         v-diasize-browse-number = v-diasize-browse-number + 1
     1901       .
     1902       create buf_temp-browse-handle .
     1903       assign
     1904         buf_temp-browse-handle.browse-type   = p-browse-type
     1905         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1906         buf_temp-browse-handle.browse-handle = p-browse-handle
     1907       .
     1908     end.
     1909   end procedure.
     1910   procedure diasize_init :
     1911     define variable v-default-value    as logical   no-undo .
     1912     define variable v-restore-saved    as logical   no-undo .
     1913     define variable v-resize-value-str as character no-undo .
     1914     do
     1915     on error undo, return error return-value
     1916     :
     1917       do with frame Dialog-Frame
     1918       :
     1919         assign
     1920           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1921           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1922           v-diasize-browse-handle     = browse b-result :handle
     1923         .
     1924         create button v-diasize-resize-button
     1925         assign
     1926           parent        = frame Dialog-Frame :first-child
     1927           label         = "s"
     1928           height-pixels = 16
     1929           width-pixels  = 16
     1930           visible       = true
     1931           sensitive     = true
     1932           movable       = true
     1933           triggers:
     1934             on end-move persistent run diasize_end-move in this-procedure .
     1935           end triggers.
     1936         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1937         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1938         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1939         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1940         assign
     1941           v-diasize-wndmax = false
     1942         .
     1943         if connected("ub") = true
     1944         then do:
     1945           define variable v-cntxt-db-num        as integer   no-undo .
     1946           define variable v-cntxt-userid        as character no-undo .
     1947           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1948                                             , OUTPUT v-cntxt-userid
     1949                                             ) .
     1950           run gbl/wndpar_r.p
     1951             (input  v-cntxt-db-num
     1952             ,input  v-cntxt-userid
     1953             ,input  'wndmax':U
     1954             ,output v-diasize-wndmax
     1955             ,output v-default-value
     1956             ) .
     1957         end.
     1958         assign
     1959           v-diasize-wndstore = false
     1960         .
     1961         if connected("ub") = true
     1962         then do:
     1963           run gbl/wndpar_r.p
     1964             (input  v-cntxt-db-num
     1965             ,input  v-cntxt-userid
     1966             ,input  'wndstore':U
     1967             ,output v-diasize-wndstore
     1968             ,output v-default-value
     1969             ) .
     1970         end.
     1971         assign
     1972           v-diasize-proc-name = entry(1, program-name(2), '.')
     1973         .
     1974         if v-diasize-wndstore = true
     1975         then do:
     1976           assign
     1977             v-restore-saved = false
     1978           .
     1979           if connected("ub") = true
     1980           then do:
     1981             run gbl/wndsizer.p
     1982               (input  v-cntxt-db-num
     1983               ,input  v-cntxt-userid
     1984               ,input  v-diasize-proc-name
     1985               ,input  'height':u
     1986               ,output v-resize-value-str
     1987               ) .
     1988             if v-resize-value-str <> '':U
     1989             then do:
     1990               run diasize_change-height in this-procedure
     1991                 (input  integer(v-resize-value-str)
     1992                 ,input  true
     1993                 ) .
     1994               assign
     1995                 v-restore-saved = true
     1996               .
     1997             end.
     1998           end.
     1999           if connected("ub") = true
     2000           then do:
     2001             run gbl/wndsizer.p
     2002               (input  v-cntxt-db-num
     2003               ,input  v-cntxt-userid
     2004               ,input  v-diasize-proc-name
     2005               ,input  'width':u
     2006               ,output v-resize-value-str
     2007               ) .
     2008             if v-resize-value-str <> '':U
     2009             then do:
     2010               run diasize_change-width in this-procedure
     2011                 (input  integer(v-resize-value-str)
     2012                 ,input  true
     2013                 ) .
     2014               assign
     2015                 v-restore-saved = true
     2016               .
     2017             end.
     2018           end.
     2019           if v-restore-saved <> true
     2020           then do:
     2021             if v-diasize-wndmax = true
     2022             then do:
     2023               run diasize_maximize in this-procedure
     2024                 (input  true
     2025                 ) .
     2026             end.
     2027           end.
     2028         end.
     2029         else do:
     2030           if v-diasize-wndmax = true
     2031           then do:
     2032             run diasize_maximize in this-procedure
     2033               (input  true
     2034               ) .
     2035           end.
     2036         end.
     2037       end.
     2038     end.
     2039   end procedure.
     2040   procedure diasize_need-full-display :
     2041     define output parameter p-need-full-display as logical   no-undo .
     2042     do
     2043     on error undo, return error return-value
     2044     :
     2045       assign
     2046         p-need-full-display = v-diasize-need-full-display
     2047       .
     2048       assign
     2049         v-diasize-need-full-display = false
     2050       .
     2051     end.
     2052   end procedure.
     2053   procedure get-context :
     2054      define output parameter p-db-num as integer          no-undo.
     2055      define output parameter p-user-id as character        no-undo.
     2056      define variable v-login               as character    no-undo.
     2057      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2058      define buffer buf_user-login  for ub.user-login .
     2059      do
     2060      on error undo, return error
     2061      :
     2062            FIND FIRST buf_sys-ctrl no-lock.
     2063            ASSIGN
     2064               v-login = USERID("ub")
     2065               p-db-num = buf_sys-ctrl.db-num
     2066            .
     2067            FIND FIRST buf_user-login
     2068                 WHERE buf_user-login.db-num = p-db-num
     2069                   AND buf_user-login.user-login = v-login
     2070                 no-lock
     2071                 no-error
     2072                 .
     2073            IF AVAILABLE buf_user-login
     2074            THEN DO:
     2075               assign
     2076                  p-user-id = buf_user-login.user-id
     2077               .
     2078            END.
     2079      end.
     2080   end procedure.
     2081       run diasize_init in this-procedure .
     2082   MAIN-BLOCK:
     2083   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2084      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2085   def var sort-labelb-result   as character no-undo .
     2086   def var sort-clmnb-result    as handle    no-undo .
     2087   def var cur-clmnb-result     as handle    no-undo .
     2088   def var cur-clmn-locb-result as integer   no-undo .
     2089   def var re-queryb-result     as logical   initial no no-undo .
     2090   on start-search, ctrl-o of b-result in frame Dialog-Frame do:
     2091      run sort-brb-result
     2092        (input (if available tt-result
     2093                then recid(tt-result)
     2094                else ?
     2095               )
     2096        ).
     2097   end.
     2098   PROCEDURE sort-brb-result :
     2099     define input parameter p-recid as recid no-undo .
     2100     if re-queryb-result = no then do:
     2101       assign
     2102          cur-clmnb-result = b-result:current-column in frame Dialog-Frame
     2103       .
     2104       if sort-clmnb-result <> ? then sort-clmnb-result:column-fgcolor = 0.
     2105       if cur-clmnb-result = sort-clmnb-result then do:
     2106         assign
     2107            sort-labelb-result = ""
     2108            sort-clmnb-result = ?
     2109         .
     2110        end.
     2111        else do:
     2112          assign
     2113            sort-labelb-result = cur-clmnb-result:label
     2114            sort-clmnb-result  = cur-clmnb-result
     2115            sort-clmnb-result:column-fgcolor = 4
     2116          .
     2117        end.
     2118      end.
     2119     assign
     2120       cur-clmn-locb-result = 1
     2121     .
     2122     def var column-handle as handle no-undo .
     2123     column-handle = b-result:first-column.
     2124     do while valid-handle(column-handle) :
     2125       if column-handle = cur-clmnb-result then do:
     2126         leave .
     2127       end.
     2128       column-handle = column-handle:NEXT-COLUMN.
     2129       assign
     2130         cur-clmn-locb-result = cur-clmn-locb-result + 1
     2131       .
     2132     end.
     2133     case sort-labelb-result:
     2134           when 'Артикул'  then DO:   OPEN QUERY b-result FOR EACH tt-result NO-LOCK by tt-result.artic INDEXED-REPOSITION    . END.
     2135           when 'Наимен.!товара'  then DO:   OPEN QUERY b-result FOR EACH tt-result NO-LOCK by tt-result.gds-name INDEXED-REPOSITION    . END.
     2136           when 'Рез-т!1-ого!сканир.'  then DO:   OPEN QUERY b-result FOR EACH tt-result NO-LOCK by tt-result.scan-1 INDEXED-REPOSITION    . END.
     2137           when 'Рез-т!2-ого!сканир.'  then DO:   OPEN QUERY b-result FOR EACH tt-result NO-LOCK by tt-result.scan-2 INDEXED-REPOSITION    . END.
     2138           when 'Разница!между!1 и 2!сканир.'  then DO:   OPEN QUERY b-result FOR EACH tt-result NO-LOCK by tt-result.diff-1-2 INDEXED-REPOSITION    . END.
     2139           when 'Рез-т!3-его!сканир.'  then DO:   OPEN QUERY b-result FOR EACH tt-result NO-LOCK by tt-result.scan-3 INDEXED-REPOSITION    . END.
     2140           when 'Итоги!по!инвентар.'  then DO:   OPEN QUERY b-result FOR EACH tt-result NO-LOCK by tt-result.itog INDEXED-REPOSITION    . END.
     2141           when 'Бар-!код!товара'  then DO:   OPEN QUERY b-result FOR EACH tt-result NO-LOCK by tt-result.b-code INDEXED-REPOSITION    . END.
     2142       otherwise do:
     2143         OPEN QUERY b-result FOR EACH tt-result NO-LOCK INDEXED-REPOSITION.
     2144         if sort-labelb-result <> "" then do:
     2145           assign
     2146             cur-clmnb-result:column-fgcolor = 0
     2147           .
     2148         end.
     2149         assign
     2150           cur-clmn-locb-result = ?
     2151         .
     2152       end.
     2153     end case.
     2154     if p-recid <> ? then do:
     2155       reposition b-result to recid p-recid no-error.
     2156       apply "value-changed" to b-result in frame Dialog-Frame.
     2157     end.
     2158     apply "entry" to b-result in frame Dialog-Frame.
     2159   END PROCEDURE.
     2160   procedure re-open-query-srt-clmnb-result:
     2161   if cur-clmnb-result = ? then do:
     2162      OPEN QUERY b-result FOR EACH tt-result NO-LOCK INDEXED-REPOSITION.
     2163   end.
     2164   else do:
     2165      assign re-queryb-result = yes.
     2166      run sort-brb-result
     2167        (input (if available tt-result
     2168                then recid(tt-result)
     2169                else ?
     2170               )
     2171        ).
     2172      assign re-queryb-result = no.
     2173   end.
     2174   end.
     2175     RUN enable_UI.
     2176     ASSIGN
     2177         tt-result.gds-name:resizable in browse b-result = true
     2178         tt-result.gds-name:WIDTH = 10.
     2179     WAIT-FOR GO OF FRAME Dialog-Frame.
     2180   END.
     2181   RUN disable_UI.
     2182   PROCEDURE disable_UI :
     2183     HIDE FRAME Dialog-Frame.
     2184   END PROCEDURE.
     2185   PROCEDURE enable_UI :
     2186     ENABLE b-exit b-save b-scan-1 b-clear-scan-1 b-scan-2 b-clear-scan-2 b-scan-3
     2187            b-clear-scan-3 b-help b-print b-export b-result
     2188         WITH FRAME Dialog-Frame.
     2189     VIEW FRAME Dialog-Frame.
     2190     OPEN QUERY b-result FOR EACH tt-result NO-LOCK INDEXED-REPOSITION.
     2191   END PROCEDURE.
     2192   PROCEDURE open-query :
     2193   IF AVAILABLE tt-result THEN DO:
     2194     ASSIGN
     2195       varrowid = ROWID(tt-result).
     2196   END.
     2197   ELSE DO:
     2198     ASSIGN
     2199       varrowid = ?.
     2200   END.
     2201   OPEN QUERY b-result FOR EACH tt-result NO-LOCK INDEXED-REPOSITION.
     2202   IF VARrowid <> ? THEN DO:
     2203     REPOSITION b-result TO ROWID varrowid.
     2204   END.
     2205   END PROCEDURE.
     2206   PROCEDURE save-diff :
     2207   DEFINE BUFFER bf-diff_goods    FOR ub.goods.
     2208   define buffer bf-diff_bar-code for ub.bar-code.
     2209   define buffer bf-diff_prod-bc  for ub.prod-bc.
     2210   FOR EACH gds-list :
     2211     DELETE gds-list.
     2212   END.
     2213   for each bb-list :
     2214     delete bb-list.
     2215   end.
     2216   FOR EACH tt-result WHERE tt-result.diff-1-2 <> 0 BREAK BY tt-result.artic BY tt-result.prod-type BY tt-result.prod-code:
     2217     FIND FIRST bf-diff_goods WHERE bf-diff_goods.artic     = tt-result.artic     AND
     2218                                    bf-diff_goods.prod-type = tt-result.prod-type AND
     2219                                    bf-diff_goods.prod-code = tt-result.prod-code NO-LOCK.
     2220     find first bf-diff_bar-code where bf-diff_bar-code.b-code = tt-result.b-code no-lock.
     2221     find first bf-diff_prod-bc where bf-diff_prod-bc.b-code = bf-diff_bar-code.b-code NO-LOCK NO-ERROR.
     2222     IF FIRST-OF(tt-result.prod-code) THEN DO:
     2223   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2224   find gds-list
     2225     where gds-list.prod-type = bf-diff_goods.prod-type
     2226       and gds-list.prod-code = bf-diff_goods.prod-code
     2227       and gds-list.artic     = bf-diff_goods.artic
     2228     no-error .
     2229   if available gds-list then do:
     2230     assign
     2231       gds-list.to-del = no
     2232     .
     2233   end.
     2234   else do:
     2235     define variable v-last11 as integer no-undo .
     2236     find last gds-list use-index oi no-error.
     2237     if available gds-list then do:
     2238       v-last11 = gds-list.order-num .
     2239     end.
     2240     else do:
     2241       v-last11 = 0 .
     2242     end.
     2243     create gds-list .
     2244     buffer-copy bf-diff_goods to gds-list
     2245     assign
     2246       gds-list.to-del = no
     2247       gds-list.order-num = v-last11 + 1
     2248     .
     2249     assign
     2250       lns-cnt = lns-cnt + 1
     2251       line-rec = recid (gds-list)
     2252     .
     2253   end.
     2254     END.
     2255   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2256   find first bb-list
     2257     where bb-list.gds-code = bf-diff_bar-code.gds-code
     2258       and bb-list.b-code   = bf-diff_bar-code.b-code
     2259       and bb-list.b-str    = '':u
     2260     no-error .
     2261   if available bb-list then do:
     2262     assign
     2263       bb-list.to-del = no
     2264     .
     2265   end.
     2266   else do:
     2267     define variable v-last12 as integer no-undo .
     2268     find last bb-list use-index oi no-error.
     2269     if available bb-list then do:
     2270       v-last12 = bb-list.order-num .
     2271     end.
     2272     else do:
     2273       v-last12 = 0 .
     2274     end.
     2275     create bb-list .
     2276     buffer-copy bf-diff_goods to bb-list
     2277     assign
     2278       bb-list.to-del = no
     2279       bb-list.order-num = v-last12 + 1
     2280       bb-list.b-code = bf-diff_bar-code.b-code
     2281       bb-list.bc-cli-base-rate = bf-diff_bar-code.cli-base-rate
     2282       bb-list.bc-cr-db-num     = bf-diff_bar-code.cr-db-num
     2283       bb-list.in-code       = bf-diff_bar-code.in-code
     2284       bb-list.node-code     = bf-diff_bar-code.node-code
     2285       bb-list.part-code     = bf-diff_bar-code.part-code
     2286       bb-list.stts_         = bf-diff_bar-code.stts_
     2287       bb-list.bc-unit-cli   = bf-diff_bar-code.unit-cli
     2288       bb-list.b-str         = '':u
     2289       bb-list.f-name        = '':u
     2290       bb-list.loc-ean       = ?
     2291       .
     2292       if available bf-diff_prod-bc
     2293       then
     2294       assign
     2295       bb-list.bc-on-type    = bf-diff_prod-bc.bc-on-type
     2296       bb-list.bc-on         = bf-diff_prod-bc.bc-on
     2297       bb-list.pbc-cr-db-num = bf-diff_prod-bc.cr-db-num
     2298       .
     2299     assign
     2300       lns-cnt = lns-cnt + 1
     2301       line-rec = recid (bb-list)
     2302     .
     2303   end.
     2304   END.
     2305   run str/diallog.w (parparentproc
     2306               , this-procedure
     2307               , 'str/send-tsd.p':U
     2308               , (parcurr-obj-type + chr(4) + string(parcurr-obj-code) + chr(4) + "bar-code")
     2309               , no
     2310               , '':U
     2311               , 'Пересылка товаров на ТСД') no-error .
     2312   END PROCEDURE.
     2313   PROCEDURE save-itog :
     2314   DEFINE VARIABLE varlog AS LOGICAL   NO-UNDO.
     2315   DEFINE VARIABLE fname  AS character NO-UNDO.
     2316   FIND FIRST tt-result WHERE tt-result.itog = ? NO-ERROR.
     2317   IF AVAILABLE tt-result THEN DO:
     2318     MESSAGE "Не определен итог у товара." tt-result.artic tt-result.gds-name tt-result.b-code VIEW-AS ALERT-BOX.
     2319     RETURN ERROR.
     2320   END.
     2321   SYSTEM-DIALOG GET-FILE Fname
     2322   FILTERS "Все файлы"  "*.*"
     2323   TITLE "Выберите файл для хранения результата"
     2324   USE-FILENAME
     2325   UPDATE varlog.
     2326   if varlog then do:
     2327     OUTPUT STREAM cur TO VALUE(Fname).
     2328     FOR EACH tt-result:
     2329       PUT STREAM cur UNFORMATTED tt-result.b-c "," tt-result.itog SKIP.
     2330     END.
     2331     assign
     2332       varsave-result = yes.
     2333     OUTPUT STREAM cur CLOSE.
     2334   end.
     2335   END PROCEDURE.
     2336   PROCEDURE scan-file :
     2337   DEFINE INPUT PARAMETER parscan AS INTEGER NO-UNDO.
     2338   DEFINE VARIABLE scan-txt  AS CHARACTER NO-UNDO.
     2339   DEFINE VARIABLE scan-name AS CHARACTER NO-UNDO.
     2340   DEFINE VARIABLE varlog    AS LOGICAL   NO-UNDO.
     2341   DEFINE VARIABLE varview   AS INTEGER   NO-UNDO.
     2342   DEFINE VARIABLE varwork        AS INTEGER   NO-UNDO.
     2343   define variable varnoapnd      as logical   no-undo .
     2344   define variable vartype        as character no-undo.
     2345   define variable varerr         as logical   no-undo.
     2346   define variable is-err         as logical   no-undo initial no .
     2347   define variable vari           as integer   no-undo.
     2348   define variable vartime        as integer   no-undo.
     2349   define variable varuser-action as character no-undo.
     2350   define variable varprinted     as logical   no-undo.
     2351   define buffer bf_bar-code for ub.bar-code.
     2352   define buffer bf_goods    for ub.goods.
     2353   define buffer bf_gds-prt  for ub.gds-prt.
     2354   define frame a
     2355       varview format ">>>>9" label "Просмотрено" space (20) skip
     2356       varwork format ">>>>9" label "Обработано"
     2357       with view-as dialog-box side-labels three-d title "".
     2358   system-dialog get-file scan-txt
     2359     title "Выберите файл со сканера"
     2360          filters "WorkAbout MS15"         "*.dbs",
     2361                  "WorkAbout"              "*.imp",
     2362                  "Инвентаризация с кассы" "*.inv",
     2363                  "Все файлы"               "*.*"
     2364          update varlog.
     2365   if not varlog then return error.
     2366   if entry (2, scan-txt, ".") = "log" then do:
     2367     message "Файл с расширением '.log' не может быть обработан. Переименуйте его.".
     2368     return error.
     2369   end.
     2370   if entry (2, scan-txt, ".") = "err" then do:
     2371     message "Файл с расширением '.err' не может быть обработан. Переименуйте его.".
     2372     return error.
     2373   end.
     2374   if entry (2, scan-txt, ".") = "ler" then do:
     2375     message "Файл с расширением '.ler' не может быть обработан. Переименуйте его.".
     2376     return error.
     2377   end.
     2378   assign
     2379     scan-name = entry (1, scan-txt, ".").
     2380   ASSIGN
     2381     frame a:title = "Разбор файла : " + scan-txt.
     2382   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2383   empty temp-table thbjattr_thbj-attr.
     2384   run adm/shattri.p (
     2385      input "get":U
     2386     ,input ''
     2387     ,input 0
     2388     ,input 'nakl-glob':U
     2389     ,input  ""
     2390     ,output v-value-character
     2391     ,output v-value-date
     2392     ,output v-value-decimal
     2393     ,output v-value-integer
     2394     ,output v-value-logical
     2395     ,output par-type
     2396     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2397     ) no-error .
     2398   for each thbjattr_thbj-attr :
     2399       if thbjattr_thbj-attr.prop-code = 'noapndsc' then varnoapnd = thbjattr_thbj-attr.property-value-logical  .
     2400   end.
     2401   if varnoapnd  then do:
     2402     output stream log to value (scan-name + ".log").
     2403     output stream err to value (scan-name + ".err").
     2404     output stream ler to value (scan-name + ".ler").
     2405   end.
     2406   else do:
     2407     output stream log to value (scan-name + ".log") append.
     2408     output stream err to value (scan-name + ".err") append.
     2409     output stream ler to value (scan-name + ".ler") append.
     2410   end.
     2411   put stream log unformatted "  " skip.
     2412   put stream log unformatted cur-time-string-sec() skip.
     2413   put stream ler unformatted "  " skip.
     2414   put stream ler unformatted cur-time-string-sec() skip.
     2415   view frame a.
     2416   input stream cur from value (scan-txt).
     2417   for each un-bc on error undo, return error return-value :
     2418       delete un-bc.
     2419   end.
     2420   for each in-bc on error undo, return error return-value :
     2421       delete in-bc.
     2422   end.
     2423   for each anlz-bc on error undo, return error return-value :
     2424       delete anlz-bc.
     2425   end.
     2426   for each main-bc on error undo, return error return-value :
     2427       delete main-bc.
     2428   end.
     2429   run str/bc-anlz.p (parparentproc, "file", scan-txt, yes, output varerr, output table in-bc) no-error.
     2430   if error-status:error then do:
     2431     message "Ошибка при обработке файла сканера." skip
     2432     view-as alert-box error buttons ok.
     2433     return error.
     2434   end.
     2435   if varerr = yes then is-err = yes.
     2436   assign
     2437     vari    = 0.
     2438     vartime = time.
     2439   for each in-bc on error undo, return error return-value :
     2440     assign
     2441       vari = vari + 1.
     2442     if in-bc.rez = "err" then do:
     2443       put stream log unformatted in-bc.err-msg skip.
     2444       put stream ler unformatted in-bc.err-msg skip.
     2445       put stream err unformatted in-bc.bar-str skip.
     2446       assign is-err = yes.
     2447     end.
     2448     if in-bc.des <> "" and in-bc.des <> ? then put stream log unformatted in-bc.des.
     2449   end.
     2450   for each un-bc on error undo, return error return-value :
     2451     assign
     2452       vari = vari + 1.
     2453     if un-bc.rez = "err" then do:
     2454       put stream log unformatted un-bc.err-msg skip.
     2455       put stream ler unformatted un-bc.err-msg skip.
     2456       put stream err unformatted un-bc.bar-code ", " un-bc.file-qnty skip.
     2457       assign
     2458         is-err = yes.
     2459     end.
     2460   end.
     2461   assign
     2462     varview = 0
     2463     varwork = 0
     2464     .
     2465   for each main-bc on error undo, return error return-value :
     2466     varview = varview + 1.
     2467     display varview with frame a.
     2468     find first bf_bar-code where bf_bar-code.b-code   = main-bc.b-c           no-lock.
     2469     find first bf_goods    where bf_goods.gds-code    = bf_bar-code.gds-code  no-lock.
     2470     find first bf_gds-prt  where bf_gds-prt.node-code = bf_bar-code.node-code no-lock.
     2471     if bf_gds-prt.is-term <> yes then do:
     2472       put stream log unformatted "Бар-код " bf_bar-code.b-code " не является кодом терминального признака." skip.
     2473       put stream ler unformatted "Бар-код " bf_bar-code.b-code " не является кодом терминального признака." skip.
     2474       put stream err unformatted main-bc.b-c ", " main-bc.scn-qnty skip.
     2475       assign is-err = yes.
     2476       next.
     2477     end.
     2478     CASE parscan:
     2479       WHEN 1 THEN DO:
     2480         IF varscan-3 = YES THEN DO:
     2481           RETURN ERROR "Третье сканирование должно быть аннулировано, когда производиться первое".
     2482         END.
     2483         FIND FIRST tt-result WHERE tt-result.artic     = bf_goods.artic       and
     2484                                    tt-result.prod-type = bf_goods.prod-type   and
     2485                                    tt-result.prod-code = bf_goods.prod-code   and
     2486                                    tt-result.node-code = bf_gds-prt.node-code NO-ERROR.
     2487         IF NOT AVAILABLE tt-result THEN DO:
     2488           CREATE tt-result.
     2489           ASSIGN
     2490             tt-result.artic     = bf_goods.artic
     2491             tt-result.prod-type = bf_goods.prod-type
     2492             tt-result.prod-code = bf_goods.prod-code
     2493             tt-result.node-code = bf_gds-prt.node-code
     2494             tt-result.b-code    = main-bc.b-c
     2495             tt-result.gds-name  = (if bf_gds-prt.node-name <> '_Пустая шкала':U and bf_gds-prt.upper-code <> bf_goods.prt-root then bf_goods.gds-name + ' - ' + bf_gds-prt.f-name else bf_goods.gds-name)
     2496            .
     2497           IF varscan-2 = YES THEN DO:
     2498             ASSIGN
     2499               tt-result.scan-2 = 0.
     2500           END.
     2501         END.
     2502         ASSIGN
     2503           tt-result.scan-1 = main-bc.scn-qnty.
     2504         IF varscan-2 = YES THEN DO:
     2505           IF tt-result.scan-1 = tt-result.scan-2 THEN DO:
     2506             ASSIGN
     2507              tt-result.diff-1-2 = 0
     2508              tt-result.itog     = tt-result.scan-1.
     2509           END.
     2510           ELSE DO:
     2511             ASSIGN
     2512               tt-result.diff-1-2 = ABS(tt-result.scan-1 - tt-result.scan-2)
     2513               tt-result.itog     = ?.
     2514           END.
     2515         END.
     2516         ELSE DO:
     2517           ASSIGN
     2518             tt-result.diff-1-2 = 0
     2519             tt-result.itog     = ?.
     2520         END.
     2521       END.
     2522       WHEN 2 THEN DO:
     2523         IF varscan-3 = YES THEN DO:
     2524           RETURN ERROR "Третье сканирование должно быть аннулировано, когда производиться первое".
     2525         END.
     2526         FIND FIRST tt-result WHERE tt-result.artic     = bf_goods.artic       and
     2527                                    tt-result.prod-type = bf_goods.prod-type   and
     2528                                    tt-result.prod-code = bf_goods.prod-code   and
     2529                                    tt-result.node-code = bf_gds-prt.node-code NO-ERROR.
     2530         IF NOT AVAILABLE tt-result THEN DO:
     2531           CREATE tt-result.
     2532           ASSIGN
     2533             tt-result.artic     = bf_goods.artic
     2534             tt-result.prod-type = bf_goods.prod-type
     2535             tt-result.prod-code = bf_goods.prod-code
     2536             tt-result.node-code = bf_gds-prt.node-code
     2537             tt-result.b-code    = main-bc.b-c
     2538             tt-result.gds-name  = (if bf_gds-prt.node-name <> '_Пустая шкала':U and bf_gds-prt.upper-code <> bf_goods.prt-root then bf_goods.gds-name + ' - ' + bf_gds-prt.f-name else bf_goods.gds-name)
     2539           .
     2540           IF varscan-1 = YES THEN DO:
     2541             ASSIGN
     2542               tt-result.scan-1 = 0.
     2543           END.
     2544         END.
     2545         ASSIGN
     2546           tt-result.scan-2 = main-bc.scn-qnty.
     2547         IF varscan-1 = YES THEN DO:
     2548           IF tt-result.scan-1 = tt-result.scan-2 THEN DO:
     2549             ASSIGN
     2550              tt-result.diff-1-2 = 0
     2551              tt-result.itog     = tt-result.scan-1.
     2552           END.
     2553           ELSE DO:
     2554             ASSIGN
     2555               tt-result.diff-1-2 = ABS(tt-result.scan-1 - tt-result.scan-2)
     2556               tt-result.itog     = ?.
     2557           END.
     2558         END.
     2559         ELSE DO:
     2560           ASSIGN
     2561             tt-result.diff-1-2 = 0
     2562             tt-result.itog     = ?.
     2563         END.
     2564       END.
     2565       WHEN 3 THEN DO:
     2566         IF varscan-1 <> YES THEN DO:
     2567           RETURN ERROR "Не было произведено первое сканирование.".
     2568         END.
     2569         IF varscan-2 <> YES THEN DO:
     2570           RETURN ERROR "Не было произведено второе сканирование.".
     2571         END.
     2572         FIND FIRST tt-result WHERE tt-result.artic     = bf_goods.artic       and
     2573                                    tt-result.prod-type = bf_goods.prod-type   and
     2574                                    tt-result.prod-code = bf_goods.prod-code   and
     2575                                    tt-result.node-code = bf_gds-prt.node-code NO-ERROR.
     2576         IF NOT AVAILABLE tt-result THEN DO:
     2577           put stream log unformatted "Бар-код " bf_bar-code.b-code " учавствовал в третьем сканировании. Но товара " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " по этому бар-коду не было в первых двух сканированиях." skip.
     2578           put stream ler unformatted "Бар-код " bf_bar-code.b-code " учавствовал в третьем сканировании. Но товара " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " по этому бар-коду не было в первых двух сканированиях." skip.
     2579           put stream err unformatted main-bc.b-c ", " main-bc.scn-qnty skip.
     2580         END.
     2581         ELSE DO:
     2582           IF tt-result.scan-1 = tt-result.scan-2 THEN DO:
     2583             put stream log unformatted "Бар-код " bf_bar-code.b-code " учавствовал в третьем сканировании. Но по этому товару " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " не было различия в первых двух сканированиях." skip.
     2584             put stream ler unformatted "Бар-код " bf_bar-code.b-code " учавствовал в третьем сканировании. Но по этому товару " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " не было различия в первых двух сканированиях." skip.
     2585             put stream err unformatted main-bc.b-c ", " main-bc.scn-qnty skip.
     2586           END.
     2587           ELSE DO:
     2588             ASSIGN
     2589               tt-result.scan-3 = string(main-bc.scn-qnty)
     2590               tt-result.itog   = main-bc.scn-qnty.
     2591           END.
     2592         END.
     2593       END.
     2594       OTHERWISE DO:
     2595         MESSAGE "Неизвестный номер сканирования: " parscan VIEW-AS ALERT-BOX ERROR.
     2596         RETURN ERROR.
     2597       END.
     2598     END CASE.
     2599     assign
     2600       varwork = varwork + 1.
     2601       display varwork with frame a.
     2602   end.
     2603   IF parscan = 1 OR parscan = 2 THEN DO:
     2604     FOR EACH tt-result :
     2605       FIND FIRST main-bc WHERE main-bc.b-c = tt-result.b-c NO-ERROR.
     2606       IF NOT AVAILABLE main-bc THEN DO:
     2607         IF parscan = 1 THEN DO:
     2608           ASSIGN
     2609             tt-result.scan-1 = 0.
     2610         END.
     2611         ELSE DO:
     2612            ASSIGN
     2613              tt-result.scan-2 = 0.
     2614         END.
     2615         IF tt-result.scan-1 = tt-result.scan-2 THEN DO:
     2616           ASSIGN
     2617            tt-result.diff-1-2 = 0
     2618            tt-result.itog     = tt-result.scan-1.
     2619         END.
     2620         ELSE DO:
     2621           ASSIGN
     2622             tt-result.diff-1-2 = ABS(tt-result.scan-1 - tt-result.scan-2)
     2623             tt-result.itog     = ?.
     2624         END.
     2625       END.
     2626     END.
     2627   END.
     2628   if is-err then do:
     2629     message "Во время загрузки файла:" scan-txt "обнаружены ошибки." skip
     2630             "Смотрите ler файл."
     2631     view-as alert-box error buttons ok.
     2632     if search (scan-name + ".ler") <> ? then do:
     2633       run gbl/prnfilen.w
     2634         (input  substitute("Ошибки, обнаруженные во время загрузки файла &1", scan-txt)
     2635         ,input  0
     2636         ,input  scan-name + ".ler"
     2637         ,input  7
     2638         ,output varuser-action
     2639         ,output varprinted
     2640         ).
     2641     end.
     2642   end.
     2643   output stream cur CLOSE.
     2644   output stream log CLOSE.
     2645   output stream err CLOSE.
     2646   output stream ler CLOSE.
     2647   RUN open-query IN THIS-PROCEDURE.
     2648   END PROCEDURE.
