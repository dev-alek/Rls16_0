      479   define new global shared variable g#vssrevis-logger as handle    no-undo .
      480   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      481   define variable v-vssrevis-logger                   as handle    no-undo .
      482   procedure vss-logevent :
      483     define input  parameter p-extra-paramters as character no-undo .
      484     define variable v-vssrevis-parameters as character no-undo .
      485     do
      486     on error undo, return error return-value
      487     :
      488       if  valid-handle(v-vssrevis-logger)
      489       and v-vssrevis-logger :get-signature("logevent") <> ""
      490       then do:
      491         run vss-get-parameters in this-procedure
      492           (output v-vssrevis-parameters
      493           ).
      494         run logevent in v-vssrevis-logger
      495           (input vss-workfile
      496           ,input vss-revision
      497           ,input v-vssrevis-parameters
      498           ,input p-extra-paramters
      499           ).
      500       end.
      501     end.
      502   end procedure.
      503   assign
      504     v-vssrevis-logger = g#vssrevis-logger
      505   .
      506   if  valid-handle(v-vssrevis-logger)
      507   and v-vssrevis-logger :get-signature("logevent") <> ""
      508   then do:
      509     assign
      510       v-vssrevis-logevent = true
      511     .
      512     run vss-logevent in this-procedure (input vss-description) .
      513   end.
