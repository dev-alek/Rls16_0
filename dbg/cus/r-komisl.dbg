     1398          varslt-base-docovp  = varslt-base-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     1399          varvat-base-docovp  = varvat-base-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     1400          varvatcons-base-docovp  = varvatcons-base-docovp  + (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1401          vardsc-base-docovp  = vardsc-base-docovp  + out-vatp_gds-dtl.discnt-base * out-vatp_gds-dtl.doc-qnty
     1402         .
     1403         assign
     1404                varsum-rubl-factovp = varsum-rubl-factovp + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.fact-qnty
     1405          varslt-rubl-factovp = varslt-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     1406          varvat-rubl-factovp = varvat-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     1407          varvatcons-rubl-factovp = varvatcons-rubl-factovp + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1408          vardsc-rubl-factovp = vardsc-rubl-factovp + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.fact-qnty
     1409          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
     1410          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     1411          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     1412          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1413          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     1414       end.
     1415       if t-doc.doc-type = 'инв':U then do:
     1416         ASSIGN
     1417                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     1418           slt-base-sale               = varslt-base-docovp / varfact-qnty
     1419           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     1420           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     1421           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     1422                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     1423           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     1424           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     1425           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     1426           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     1427       end.
     1428       else do:
     1429         ASSIGN
     1430                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     1431           slt-base-sale               = varslt-base-factovp / varfact-qnty
     1432           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     1433           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     1434           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     1435                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     1436           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     1437           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     1438           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     1439           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     1440       end.
     1441     end.
     1442   end.
     1443   assign
     1444     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1445     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1446     assign
     1447     price-rubl-without-tax-sale-b = price-rubl-with-tax-sale - vat-rubl-buyer - slt-rubl-sale - road-tax-rubl-sale
     1448     .
     1449     _parts:
     1450     FOR EACH ub.parts NO-LOCK WHERE
     1451             ub.parts.artic = ub.doc-line.artic
     1452         AND ub.parts.prod-type = ub.doc-line.prod-type
     1453         AND ub.parts.prod-code = ub.doc-line.prod-code
     1454         AND ub.parts.out-code = doc-num
     1455         AND ub.parts.obj-type = ub.doc-line.obj-type
     1456         AND ub.parts.obj-code = ub.doc-line.obj-code
     1457         :
     1458       find first buf_parts-attr no-lock where
     1459                  buf_parts-attr.in-code = ub.parts.in-code
     1460              AND buf_parts-attr.gds-code = v-gds-code
     1461              AND buf_parts-attr.part-code = ub.parts.part-code no-error .
     1462       if available buf_parts-attr then do:
     1463         if not can-find(first cli-list no-lock where
     1464                cli-list.obj-type = buf_parts-attr.supp-type
     1465            AND cli-list.obj-code = buf_parts-attr.supp-code) then NEXT _parts.
     1466         if buf_parts-attr.purch-code <> ocons-pay
     1467         AND buf_parts-attr.purch-code <> ocons-pay-2
     1468         then next _parts.
     1469         assign
     1470         v-parts-VAt-pc = buf_parts-attr.vat-pc
     1471         v-parts-SLT-pc = buf_parts-attr.SLT-pc
     1472         v-in-code = buf_parts-attr.income-in-code
     1473         v-part-code  = buf_parts-attr.income-part-code
     1474         .
     1475       end.
     1476       else do:
     1477         if not can-find(first cli-list no-lock where
     1478                cli-list.obj-type = ub.parts.supp-type
     1479            AND cli-list.obj-code = ub.parts.supp-code) then NEXT _parts.
     1480         if ub.parts.purch-code <> ocons-pay
     1481         AND ub.parts.purch-code <> ocons-pay-2
     1482         then next _parts.
     1483         assign
     1484         v-parts-VAt-pc = ub.parts.vat-pc
     1485         v-parts-SLT-pc = ub.parts.SLT-pc
     1486         v-in-code = ub.parts.in-code
     1487         v-part-code = ub.parts.part-code
     1488         .
     1489       end.
     1490   assign
     1491     price-rubl-with-tax-loc  = ub.parts.price-rubl
     1492     price-base-with-tax-loc  = ub.parts.price-base
     1493   .
     1494   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1495   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1496     (output varinvprb
     1497     )  .
     1498     if ub.parts.out-code = 'free-zone':U     or
     1499        ub.parts.out-code = 'out-zone':U   or
     1500        ub.parts.doc-type = 'акт':U then do:
     1501       assign
     1502         in-vatp-have-vat-slt  = yes.
     1503     end.
     1504     else do:
     1505       find first in-vatp_doc-attr  no-lock
     1506         where in-vatp_doc-attr .doc-code  = ub.parts.out-code
     1507           and in-vatp_doc-attr .attr-code = 'envd':U
     1508         no-error .
     1509       if not available in-vatp_doc-attr  then do:
     1510         assign
     1511           in-vatp-have-vat-slt  = yes.
     1512       end.
     1513       else do:
     1514            in-vatp-have-vat-slt  = no.
     1515       end.
     1516     end.
     1517     assign
     1518      price-cli-with-tax-loc  = ub.parts.price-cli
     1519      cli-base-rate           = ub.parts.cli-base-rate.
     1520     ASSIGN   road-tax-base-loc   = (if ub.parts.road-tax-base  = ? then 0 else ub.parts.road-tax-base)
     1521              road-tax-rubl-loc   = (if ub.parts.road-tax-rubl  = ? then 0 else ub.parts.road-tax-rubl).
     1522     ASSIGN  transport-base-loc  = (if ub.parts.transport-base = ? then 0 else ub.parts.transport-base)
     1523             transport-rubl-loc  = (if ub.parts.transport-rubl = ? then 0 else ub.parts.transport-rubl)
     1524             other-base-loc      = (if ub.parts.other-base     = ? then 0 else ub.parts.other-base)
     1525             other-rubl-loc      = (if ub.parts.other-rubl     = ? then 0 else ub.parts.other-rubl)
     1526             vat-pc-loc          = (if ub.parts.vat-pc         = ? then 0 else ub.parts.vat-pc)
     1527             slt-pc-loc          = (if ub.parts.slt-pc         = ? then 0 else ub.parts.slt-pc).
     1528             ASSIGN   slt-base-loc     = (if in-vatp-have-vat-slt  = no then 0 else (price-base-with-tax-loc  - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc  / (100 + slt-pc-loc ))                        vat-base-loc     = (if in-vatp-have-vat-slt  = no then 0 else (price-base-with-tax-loc  - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc  / (100 + slt-pc-loc )) * vat-pc-loc  / (100 + vat-pc-loc )).
     1529       ASSIGN   slt-rubl-loc     = (if in-vatp-have-vat-slt  = no then 0 else (price-rubl-with-tax-loc  - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc  / (100 + slt-pc-loc ))                        vat-rubl-loc     = (if in-vatp-have-vat-slt  = no then 0 else (price-rubl-with-tax-loc  - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc  / (100 + slt-pc-loc )) * vat-pc-loc  / (100 + vat-pc-loc )).
     1530     assign
     1531       exch-rate-cli-loc  = (ub.parts.price-rubl - transport-rubl-loc  - other-rubl-loc  - road-tax-rubl-loc  - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc  else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc  else 0)) / ub.parts.price-cli .
     1532     assign
     1533       slt-cli-loc         = slt-rubl-loc        / exch-rate-cli-loc
     1534       vat-cli-loc         = vat-rubl-loc        / exch-rate-cli-loc
     1535       road-tax-cli-loc    = road-tax-rubl-loc   / exch-rate-cli-loc
     1536       transport-cli-loc   = 0
     1537       other-cli-loc       = 0
     1538     .
     1539   ASSIGN
     1540             price-base-without-tax-loc  = price-base-with-tax-loc  - vat-base-loc  - slt-base-loc  - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1541       price-rubl-without-tax-loc  = price-rubl-with-tax-loc  - vat-rubl-loc  - slt-rubl-loc  - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1542   .
     1543         FIND FIRST sj-goods WHERE
     1544                   sj-goods.supp-type = ub.parts.supp-type
     1545               AND sj-goods.supp-code = ub.parts.supp-code
     1546               No-error.
     1547       if not avail sj-goods
     1548       then do:
     1549         FIND FIRST ub.goods No-LOCK WHERE
     1550                   ub.goods.artic = ub.doc-line.artic
     1551               AND ub.goods.prod-type = ub.doc-line.prod-type
     1552               AND ub.goods.prod-code = ub.doc-line.prod-code No-ERROR.
     1553         create sj-goods.
     1554         assign
     1555         sj-goods.supp-type = ub.parts.supp-type
     1556         sj-goods.supp-code = ub.parts.supp-code
     1557         .
     1558       END.
     1559       assign
     1560       prt-qnty =  is-out * ub.parts.fact-qnty
     1561       sj-goods.qnty = sj-goods.qnty +  prt-qnty
     1562       sj-goods.price-without-tax-cost_ = price-rubl-without-tax-loc
     1563       sj-goods.sum-without-tax-cost_  =  sj-goods.sum-without-tax-cost_ + price-rubl-without-tax-loc * prt-qnty
     1564       sj-goods.sum-vat-cost_ = sj-goods.sum-vat-cost_ + vat-rubl-loc * prt-qnty
     1565       sj-goods.sum-with-tax-cost_   =  sj-goods.sum-with-tax-cost_ + price-rubl-with-tax-loc * prt-qnty
     1566       sj-goods.sum-without-tax-sale_ = sj-goods.sum-without-tax-sale_ + price-rubl-without-tax-sale-b * prt-qnty
     1567       sj-goods.price-without-tax-sale_ = sj-goods.sum-without-tax-sale_ / sj-goods.qnty
     1568       sj-goods.sum-vat-sale_ = sj-goods.sum-vat-sale + vat-rubl-buyer * prt-qnty
     1569       sj-goods.sum-slt-sale_ = sj-goods.sum-slt-sale + slt-rubl-sale * prt-qnty
     1570       sj-goods.sum-with-tax-sale_ = sj-goods.sum-with-tax-sale_ + price-rubl-with-tax-sale * prt-qnty
     1571       .
     1572     END.
     1573   END.
     1574     end.
     1575   end procedure.
     1576   procedure filltable :
     1577   DEFINE VARiable v-host-code like ub.sysconf.host-code no-undo.
     1578   DEFINE VARIABLE loc#retail as logical no-undo.
     1579   DEFINE VARIABLE real-code like ub.clients.obj-code no-undo.
     1580   DEFINE VARIABLE real-type like ub.clients.obj-type no-undo.
     1581   DEFINE VARIABLE ocons-pay like ub.sysconf.purch-code no-undo.
     1582   DEFINE VARIABLE ocons-pay-2 like ub.sysconf.purch-code no-undo.
     1583   DEFINE VARIABLE is-out as integer no-undo .
     1584   DEFINE VARIABLE doc-num like ub.trn-doc.doc-code no-undo.
     1585   DEFINE VARIABLE offc as logical no-undo.
     1586   DEFINE VARIABLE prt-qnty as decimal no-undo .
     1587     do
     1588     on error undo, return error
     1589     :
     1590       run waitfram-show in this-procedure ( input "Ждите") .
     1591       FOR EACH sj-goods :
     1592           delete sj-goods .
     1593       END .
     1594       _obj-list:
     1595       FOR EACH obj-list NO-LOCK:
     1596   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1598     (input  obj-list.obj-type
     1599     ,input  obj-list.obj-code
     1600     ,output v-host-code
     1601     )  .
     1602         FIND FIRST ub.sysconf NO-LOCK WHERE ub.sysconf.host-code = v-host-code.
     1603         IF AVAIL ub.sysconf
     1604         then
     1605         assign
     1606         loc#retail = ub.sysconf.ord-prt
     1607         real-code = ub.sysconf.sale-code
     1608         real-type = ub.sysconf.sale-type
     1609         ocons-pay = integer('2':U)
     1610         ocons-pay-2 = integer('4':U)
     1611         .
     1612         else NEXT _obj-list.
     1613         CASE RS-by:
     1614           when 1 then do:
     1615           _inkas:
     1616             FOR EACH ub.inkas WHERE
     1617                     ub.inkas.doc-date >= X-date-start and
     1618                     ub.inkas.doc-date <= X-date-end AND
     1619                     ub.inkas.obj-code = obj-list.obj-code and
     1620                     ub.inkas.obj-type = obj-list.obj-type AND
     1621                     ub.inkas.status_ = 'факт':U NO-LOCK,
     1622                 each ub.sale-doc no-lock where
     1623                       ub.sale-doc.inkas-code = ub.inkas.inkas-code
     1624                   and ub.sale-doc.order > 0:
     1625               if ub.sale-doc.in-inkas then do:
     1626                 FIND FIRST t-doc No-LOCK WHERE
     1627                         t-doc.doc-code = ub.sale-doc.doc-code no-error.
     1628                 if available t-doc then do:
     1629                   assign
     1630                   doc-num = t-doc.doc-code
     1631                   is-out = ub.sale-doc.dir
     1632                   .
     1633                   if t-doc.office then NEXT _inkas.
     1634                   run cr-sj-goods in this-procedure (
     1635                                                     input doc-num
     1636                                                     ,input is-out
     1637                                                     ,input ocons-pay
     1638                                                     ,input ocons-pay-2
     1639                                                     ).
     1640                 end.
     1641               end.
     1642             END.
     1643           END.
     1644           when 2 then do:
     1645           _trn-doc:
     1646             FOR EACH t-doc NO-LOCK WHERE
     1647                     t-doc.obj-type = obj-list.obj-type AND
     1648                     t-doc.obj-code = obj-list.obj-code AND
     1649                     t-doc.cli-type = real-type AND
     1650                     t-doc.cli-code = real-code AND
     1651                     t-doc.status_ = 'факт':U AND
     1652                     t-doc.doc-date >= X-date-start AND
     1653                     t-doc.doc-date <= X-date-end AND
     1654                     t-doc.ext-doc-type = 'ee':U
     1655                     :
     1656               assign
     1657               doc-num = t-doc.doc-code
     1658               offc = t-doc.office
     1659               is-out = 1.
     1660               if offc then NEXT _trn-doc.
     1661               run cr-sj-goods in this-procedure (
     1662                                                   input doc-num
     1663                                                  ,input is-out
     1664                                                  ,input ocons-pay
     1665                                                  ,input ocons-pay-2
     1666                                                  ).
     1667             END.
     1668             _ret-doc:
     1669             FOR EACH t-doc NO-LOCK WHERE
     1670                     t-doc.obj-type = obj-list.obj-type AND
     1671                     t-doc.obj-code = obj-list.obj-code AND
     1672                     t-doc.cli-type = real-type AND
     1673                     t-doc.cli-code = real-code AND
     1674                     t-doc.status_ = 'факт':U AND
     1675                     t-doc.doc-date >= X-date-start AND
     1676                     t-doc.doc-date <= X-date-end AND
     1677                     t-doc.ext-doc-type = 're':U:
     1678               assign
     1679               doc-num = t-doc.doc-code
     1680               offc = t-doc.office
     1681               is-out = -1.
     1682               if offc then NEXT _ret-doc.
     1683               run cr-sj-goods in this-procedure (
     1684                                                   input doc-num
     1685                                                  ,input is-out
     1686                                                  ,input ocons-pay
     1687                                                  ,input ocons-pay-2
     1688                                                  ).
     1689             END.
     1690           END.
     1691           WHEN 3 or when 4 then do:
     1692             _3trn-doc:
     1693             FOR EACH t-doc NO-LOCK WHERE
     1694                     t-doc.obj-type = obj-list.obj-type AND
     1695                     t-doc.obj-code = obj-list.obj-code AND
     1696                     t-doc.status_ = 'факт':U AND
     1697                     t-doc.doc-date >= X-date-start AND
     1698                     t-doc.doc-date <= X-date-end AND
     1699                     (t-doc.ext-doc-type = 'ee':U
     1700                     or t-doc.ext-doc-type = 'es':U) :
     1701               assign
     1702               doc-num = t-doc.doc-code
     1703               offc = t-doc.office
     1704               is-out = 1.
     1705               if offc then NEXT _3trn-doc.
     1706               run cr-sj-goods in this-procedure (
     1707                                                   input doc-num
     1708                                                  ,input is-out
     1709                                                  ,input ocons-pay
     1710                                                  ,input ocons-pay-2
     1711                                                  ).
     1712               if Rs-by = 3 then do:
     1713                 if t-doc.ext-doc-type = 'es':U then NEXT _3trn-doc.
     1714               end.
     1715             END.
     1716             if Rs-by = 4 then do:
     1717               _3trn-doc-ret:
     1718               FOR EACH t-doc NO-LOCK WHERE
     1719                       t-doc.obj-type = obj-list.obj-type AND
     1720                       t-doc.obj-code = obj-list.obj-code AND
     1721                       t-doc.status_ = 'факт':U AND
     1722                       t-doc.doc-date >= X-date-start AND
     1723                       t-doc.doc-date <= X-date-end AND
     1724                       (t-doc.ext-doc-type = 're':U OR
     1725                       t-doc.ext-doc-type = 'rs':U):
     1726                 assign
     1727                 doc-num = t-doc.doc-code
     1728                 offc = t-doc.office
     1729                 is-out = - 1.
     1730                 if offc then NEXT _3trn-doc-ret.
     1731                 run cr-sj-goods in this-procedure (
     1732                                                     input doc-num
     1733                                                   ,input is-out
     1734                                                   ,input ocons-pay
     1735                                                   ,input ocons-pay-2
     1736                                                   ).
     1737               END.
     1738             end.
     1739             _spitrn-doc:
     1740             FOR EACH t-doc NO-LOCK WHERE
     1741                     t-doc.obj-type = obj-list.obj-type AND
     1742                     t-doc.obj-code = obj-list.obj-code AND
     1743                     t-doc.status_ = 'факт':U AND
     1744                     t-doc.doc-date >= X-date-start AND
     1745                     t-doc.doc-date <= X-date-end AND
     1746                     t-doc.internal = no AND
     1747                     (t-doc.ext-doc-type = 'wm':U
     1748                     OR (Rs-by = 4 and
     1749                         t-doc.ext-doc-type = 'we':U)
     1750                     )
     1751                     :
     1752               assign
     1753               doc-num = t-doc.doc-code
     1754               offc = t-doc.office
     1755               is-out = 1.
     1756               if offc then NEXT _spitrn-doc.
     1757               run cr-sj-goods in this-procedure (
     1758                                                   input doc-num
     1759                                                 ,input is-out
     1760                                                 ,input ocons-pay
     1761                                                 ,input ocons-pay-2
     1762                                                 ).
     1763             END.
     1764           end.
     1765         END CASE.
     1766       END.
     1767       run waitfram-hide in this-procedure .
     1768     end.
     1769   end procedure.
     1770   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1771   define variable v-waitfram-action01         as character   no-undo .
     1772   define variable v-waitfram-action02         as character   no-undo .
     1773   define variable v-waitfram-action03         as character   no-undo .
     1774   define variable mWaitFramTextBeg            as character   no-undo.
     1775   define variable mWaitFramTextEnd            as character   no-undo.
     1776   define variable mWaitFramView               as logical     no-undo.
     1777   define variable mWaitProcEvent              as logical     no-undo init yes.
     1778   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1779   define variable mWaitFramStop               as logical     no-undo.
     1780   define variable mWaitFramStopUser           as logical     no-undo.
     1781   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1782   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1783   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1784   define button B-WaitFramStop auto-end-key
     1785        label "Стоп"
     1786        size 10 by 1 tooltip "Остоновить процесс".
     1787   define button B-viewProcInfo
     1788        label "Информация"
     1789        size 15 by 1 tooltip "Информация о процесс".
     1790   define frame waitfram
     1791     v-waitfram-action01 format "x(72)" no-label skip
     1792     v-waitfram-action02 format "x(72)" no-label skip
     1793     v-waitfram-action03 format "x(72)" no-label skip
     1794     B-viewProcInfo
     1795     B-WaitFramStop at row 4 col 30
     1796     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1797     .
     1798   define new global shared variable mBatchMode as logical no-undo init ?.
     1799   define variable mFramBachModHandle as handle no-undo.
     1800   mFramBachModHandle = frame waitfram:handle.
     1801   define variable mFameOldVis as logical no-undo.
     1802   define variable mVisCUrentVin as logical no-undo.
     1803   if session:batch-mode
     1804   then
     1805      mBatchMode = yes.
     1806   if mBatchMode = ? then do:
     1807     mVisCUrentVin = current-window:visible.
     1808     mFameOldVis = mFramBachModHandle:visible.
     1809     mFramBachModHandle:visible  = yes.
     1810     mBatchMode = mFramBachModHandle:visible ne yes.
     1811     mFramBachModHandle:visible = mFameOldVis.
     1812     current-window:visible = mVisCUrentVin.
     1813   end.
     1814    if  log-manager:logfile-name ne ?
     1815     then DO:
     1816         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1817         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1818         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1819     end.
     1820   on choose of B-WaitFramStop in frame waitfram
     1821   do:
     1822     mWaitFramStop = yes.
     1823     mWaitFramStopUser = yes.
     1824   end.
     1825   function waitfram-check-timeout returns logical():
     1826      define variable vtime as int64 no-undo.
     1827      if mWaitFramStopTimeOut
     1828      then
     1829         return yes.
     1830      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1831      if     mWaitFramTimeOut ne ?
     1832         and mWaitFramTimeOut ne 0
     1833         and mWaitFramTimeOut lt vtime
     1834      then do:
     1835         mWaitFramStopTimeOut = yes.
     1836      end.
     1837      return mWaitFramStopTimeOut.
     1838   end.
     1839   procedure waitfram-hide :
     1840     if not session:batch-mode
     1841     then do
     1842     on error undo, return error return-value
     1843     :
     1844       pause 0 before-hide .
     1845       if not mBatchMode then
     1846         hide frame waitfram .
     1847     if     not mWaitFramView
     1848        and mWaitProcEvent
     1849     then
     1850       process events .
     1851     end.
     1852   end procedure.
     1853   procedure waitfram-show :
     1854     define input  parameter p-message as character no-undo .
     1855     define variable v-left-margin as integer   no-undo .
     1856     if not session:batch-mode
     1857     then do
     1858     on error undo, return error return-value
     1859     :
     1860       if length(p-message) <= 70 then do:
     1861         assign
     1862           v-left-margin = integer((70 - length(p-message)) / 2)
     1863         .
     1864         assign
     1865           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1866         .
     1867         assign
     1868           v-waitfram-action01 = " "
     1869           v-waitfram-action02 = " "
     1870                                    + fill(" ", v-left-margin)
     1871                                    + p-message
     1872           v-waitfram-action03 = " "
     1873         .
     1874       end.
     1875       else do:
     1876         define variable vRindex1 as integer no-undo.
     1877         define variable vRindex2 as integer no-undo.
     1878         vRindex1 = r-index(p-message," ",70).
     1879         if vRindex1 = 0
     1880         then
     1881            vRindex1 = 70.
     1882         if length(p-message)  <= vRindex1 + 70 then do:
     1883           assign
     1884             v-waitfram-action01 = " "
     1885             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1886             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1887           .
     1888         end.
     1889         else do:
     1890           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1891           if vRindex2 <= vRindex1
     1892           then
     1893              vRindex2 = vRindex1 + 70.
     1894           assign
     1895             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1896             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1897             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1898           .
     1899         end.
     1900       end.
     1901       B-viewProcInfo:visible   in frame waitfram = no.
     1902       B-viewProcInfo:sensitive in frame waitfram = no.
     1903       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1904       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1905       if  (   mWaitFramView
     1906          or  mWaitProcEvent)
     1907          and not mBatchMode
     1908       then
     1909          display
     1910             v-waitfram-action01 skip
     1911             v-waitfram-action02 skip
     1912             v-waitfram-action03 skip
     1913          with frame waitfram .
     1914       if     mWaitFramView
     1915          then do:
     1916             if     mWaitFramInterval ne ?
     1917                and not mBatchMode
     1918             then
     1919                wait-for go of frame waitfram pause mWaitFramInterval.
     1920          end.
     1921          else
     1922             if     mWaitProcEvent
     1923                and not mBatchMode
     1924             then
     1925                process events .
     1926     end.
     1927   end procedure.
     1928      procedure waitfram-show-this:
     1929         define input  parameter iInterval as int64 no-undo.
     1930         define variable vtime as int64 no-undo.
     1931         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1932         mWaitFramInterval = iInterval.
     1933         run waitfram-show (substitute("&1&2 &3&4" ,
     1934                                       mWaitFramTextBeg ,
     1935                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1936                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1937                                       mWaitFramTextEnd
     1938                                      )
     1939                           ).
     1940      end.
     1941      procedure WaitFramRunPause:
     1942         define input  parameter iInterval as dec no-undo.
     1943         define variable vStart  as datetime-tz no-undo.
     1944         define variable vend    as datetime-tz no-undo.
     1945         define variable vint as int64 no-undo.
     1946         define variable vOk as logical no-undo.
     1947         vStart = now.
     1948         vend   = vStart.
     1949         publish "WaitFramPause" (iInterval,output vOk).
     1950         vend   =  now.
     1951         vint = vend - vStart.
     1952         vint = iInterval - vint / 1000.
     1953         if     not mWaitFramStop
     1954            and (   vint > 0
     1955                 or (    not vOk
     1956                     and iInterval eq ?
     1957                     )
     1958                 )
     1959         then
     1960            run waitfram-show-this (iInterval).
     1961         vend   =  now.
     1962         vint = vend - vStart.
     1963         vint = iInterval - vint / 1000.
     1964         if     not mWaitFramStop
     1965            and vint > 0
     1966         then do:
     1967            run gbl/pause.p (vint * 1000).
     1968         end.
     1969         if iInterval ne ?
     1970         then
     1971            publish "WaitFramStop".
     1972         waitfram-check-timeout().
     1973      end.
     1974      procedure WaitFramWaitFor:
     1975         define input  parameter iInterval as dec no-undo.
     1976         assign
     1977            mWaitFramStartProc   = now
     1978            mWaitFramStopUser    = no
     1979            mWaitFramStopTimeOut = no
     1980         .
     1981         block-wait:
     1982         do while not mWaitFramStop:
     1983            run WaitFramRunPause (iInterval).
     1984            if  waitfram-check-timeout()
     1985            then do:
     1986               leave block-wait.
     1987            end.
     1988         end.
     1989         run waitfram-hide.
     1990      end.
     1991   procedure waitfram-join :
     1992     define input  parameter p-line-1  as character no-undo .
     1993     define input  parameter p-line-2  as character no-undo .
     1994     define input  parameter p-line-3  as character no-undo .
     1995     define output parameter p-message as character no-undo .
     1996     do
     1997     on error undo, return error return-value
     1998     :
     1999       assign
     2000         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2001                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2002                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2003       .
     2004     end.
     2005   end procedure.
     2006   function waitfram-join-function returns character
     2007     (input p-line-1 as character
     2008     ,input p-line-2 as character
     2009     ,input p-line-3 as character
     2010     ).
     2011     define variable v-message as character no-undo .
     2012     run waitfram-join in this-procedure
     2013       (input  p-line-1
     2014       ,input  p-line-2
     2015       ,input  p-line-3
     2016       ,output v-message
     2017       ) .
     2018     return v-message .
     2019   end function .
     2020   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2021   procedure cur-time :
     2022      define output parameter p-today as date      no-undo .
     2023      define output parameter p-time  as integer   no-undo .
     2024     do
     2025     on error undo, return error
     2026     :
     2027       define variable v-date1 as date      no-undo .
     2028       define variable v-date2 as date      no-undo .
     2029       define variable v-time  as integer   no-undo .
     2030       assign
     2031         v-date1 = today
     2032         v-time  = time
     2033         v-date2 = today
     2034       .
     2035       if v-date1 <> v-date2
     2036       then do:
     2037         assign
     2038           v-date1 = today
     2039           v-time  = v-time
     2040         .
     2041       end.
     2042       assign
     2043         p-today = v-date1
     2044         p-time  = v-time
     2045       .
     2046     end.
     2047   end.
     2048   function cur-time-date returns character
     2049   :
     2050     return string(today, '99/99/9999':U) .
     2051   end.
     2052   function cur-time-mjd returns decimal
     2053   :
     2054     define variable v-date as date      no-undo .
     2055     define variable v-time as integer   no-undo .
     2056     run cur-time in this-procedure
     2057       (output v-date
     2058       ,output v-time
     2059       ) .
     2060     return integer(v-date) - 2400002 + (v-time / 86400) .
     2061   end.
     2062   function cur-time-get-ending-index returns integer
     2063   (input p-number as integer
     2064   )
     2065   :
     2066     if p-number < 0
     2067     or p-number = ?
     2068     then do:
     2069       return 1 .
     2070     end.
     2071     define variable v-rest as integer   no-undo .
     2072     assign
     2073       p-number = p-number modulo 100
     2074     .
     2075     if p-number < 20
     2076     then do:
     2077       assign
     2078         v-rest = p-number
     2079       .
     2080     end.
     2081     else do:
     2082       assign
     2083         v-rest = p-number modulo 10
     2084       .
     2085     end.
     2086     case v-rest :
     2087       when 1
     2088       then do:
     2089         return 2 .
     2090       end.
     2091       when 2 or
     2092       when 3 or
     2093       when 4
     2094       then do:
     2095         return 3 .
     2096       end.
     2097       otherwise do:
     2098         return 1 .
     2099       end.
     2100     end case .
     2101   end.
     2102   procedure cur-time-mjd-to-date :
     2103      define input  parameter i-mjd-diff as decimal no-undo.
     2104      define output parameter o-Date     as date    no-undo.
     2105      define output parameter o-Time     as integer no-undo.
     2106      define variable v-day-number as integer   no-undo .
     2107      if    i-mjd-diff < 0
     2108         or i-mjd-diff = ?
     2109      then do:
     2110         return "?" .
     2111      end.
     2112      assign
     2113         v-day-number = truncate(i-mjd-diff,0).
     2114         o-Date = date(v-day-number + 2400002).
     2115         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2116     .
     2117   end.
     2118   function cur-time-mjd-to-string returns character
     2119   (input p-mjd-diff as decimal
     2120   )
     2121   :
     2122     define variable v-day-number as integer   no-undo .
     2123     define variable v-seconds    as integer   no-undo .
     2124     define variable v-hour       as integer   no-undo .
     2125     define variable v-min        as integer   no-undo .
     2126     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2127     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2128     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2129     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2130     if p-mjd-diff < 0
     2131     or p-mjd-diff = ?
     2132     then do:
     2133       return "?" .
     2134     end.
     2135     assign
     2136       v-day-number = integer(truncate(p-mjd-diff,0))
     2137       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2138     .
     2139     if v-seconds > 86400
     2140     then do:
     2141       assign
     2142         v-seconds = 86400 - 1
     2143       .
     2144     end.
     2145     if v-seconds < 0
     2146     then do:
     2147       assign
     2148         v-seconds = 0
     2149       .
     2150     end.
     2151     assign
     2152       v-hour = truncate(v-seconds / 3600, 0)
     2153     .
     2154     assign
     2155       v-seconds = v-seconds modulo 3600
     2156     .
     2157     assign
     2158       v-min = truncate(v-seconds / 60, 0)
     2159     .
     2160     assign
     2161       v-seconds = v-seconds modulo 60
     2162     .
     2163     return
     2164         (if v-day-number <> 0
     2165           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2166           else ""
     2167         )
     2168       + (if v-day-number <> 0 or v-hour <> 0
     2169           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2170           else ""
     2171         )
     2172       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2173           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2174           else ""
     2175         )
     2176       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2177       .
     2178   end.
     2179   function cur-time-string returns character
     2180   :
     2181     define variable v-date as date      no-undo .
     2182     define variable v-time as integer   no-undo .
     2183     run cur-time in this-procedure
     2184       (output v-date
     2185       ,output v-time
     2186       ) .
     2187     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2188   end.
     2189   function cur-time-string-sec returns character
     2190   :
     2191     define variable v-date as date      no-undo .
     2192     define variable v-time as integer   no-undo .
     2193     run cur-time in this-procedure
     2194       (output v-date
     2195       ,output v-time
     2196       ) .
     2197     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2198   end.
     2199   function cur-time-custom  returns character
     2200   (input p-prefix as character
     2201   ,input p-date-format as character
     2202   ,input p-delimiter as character
     2203   ,input p-time-format as character
     2204   ,input p-suffix as character
     2205   )
     2206   :
     2207     define variable v-date as date      no-undo .
     2208     define variable v-time as integer   no-undo .
     2209     run cur-time in this-procedure
     2210       (output v-date
     2211       ,output v-time
     2212       ) .
     2213     return
     2214       p-prefix
     2215       + string(v-date, p-date-format)
     2216       + p-delimiter
     2217       + string(v-time, p-time-format)
     2218       + p-suffix
     2219       .
     2220   end.
     2221   function cur-time-print  returns character
     2222   :
     2223     define variable v-date as date      no-undo .
     2224     define variable v-time as integer   no-undo .
     2225     run cur-time in this-procedure
     2226       (output v-date
     2227       ,output v-time
     2228       ) .
     2229     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2230   end.
     2231   function cur-time-datetime returns datetime
     2232   :
     2233     define variable v-char as character no-undo .
     2234     define variable v-datetime as datetime no-undo .
     2235     v-char = cur-time-string().
     2236     v-datetime = datetime(v-char).
     2237     return  v-datetime.
     2238   end.
     2239   function cur-time-string-msec returns character
     2240   :
     2241     define variable v-date as datetime  no-undo .
     2242     v-date = now.
     2243     return string(v-date) .
     2244   end.
     2245   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2246   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2247   procedure lhistprex-print-cli-list-hist-excel :
     2248   define input parameter p-text  as logical no-undo .
     2249   define input parameter p-excel as logical no-undo .
     2250   define input parameter p-sheet-num as integer no-undo .
     2251   define buffer buf_lh-sheetf for sheetf.
     2252   define buffer buf_cli-list-hist for cli-list-hist.
     2253     do
     2254     on error undo, return error
     2255     :
     2256       find first buf_cli-list-hist no-lock where buf_cli-list-hist.id = 0 no-error .
     2257       if p-excel then do:
     2258         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     2259         FInd first buf_lh-Sheetf where
     2260                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     2261         if not avail buf_lh-sheetf then
     2262         create buf_lh-sheetf.
     2263         assign
     2264         buf_lh-Sheetf.Sheet-num = 2
     2265         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     2266         buf_lh-sheetf.sizes = "9,9,9,12,155"
     2267         .
     2268         run rep/extitlee.p (input p-sheet-num
     2269                       , input  substitute("История создания списка &1 &2"
     2270                                   ,
     2271   ''
     2272                                   ,(if available buf_cli-list-hist
     2273                                   then buf_cli-list-hist.des
     2274                                   else "БЕЗЫМЯННЫЙ"))
     2275                       ) .
     2276       end.
     2277       if p-text then do:
     2278         Page stream PrnLibStream.
     2279         PUT  STREAM PrnLibStream unformatted
     2280         SPACE(25) substitute("История создания списка &1 &2"
     2281                             , ''
     2282                             ,(if available buf_cli-list-hist
     2283                             then buf_cli-list-hist.des
     2284                             else "БЕЗЫМЯННЫЙ")) skip(0)
     2285         space(25) cur-time-print() skip(1)
     2286         .
     2287         put stream PrnLibStream unformatted
     2288         string("№", "X(9)") chr(32)
     2289         string("Действие", "X(9)") chr(32)
     2290         string("записей", "X(9)") chr(32)
     2291         string(" = итого", "X(12)") chr(32)
     2292         (if page-size(PrnLibStream) > 43
     2293         then string("Множество", "X(" + string(136 - 43) + ")")
     2294         else string("Множество", "X(" + string(198 - 43) + ")")
     2295         )
     2296         skip(0)
     2297         fill('-':U, 9) chr(32)
     2298         fill('-':U, 9) chr(32)
     2299         fill('-':U, 9) chr(32)
     2300         fill('-':U, 12) chr(32)
     2301         (if page-size(PrnLibStream) > 43
     2302         then fill('-':U, 136 - 43)
     2303         else fill('-':U, 198 - 43))
     2304         skip(0)
     2305         .
     2306       end.
     2307       for each buf_cli-list-hist where buf_cli-list-hist.id > 0
     2308       by buf_cli-list-hist.id
     2309       :
     2310         if p-text then do:
     2311           put stream PrnLibStream unformatted
     2312           (if buf_cli-list-hist.line = 0
     2313           then string(buf_cli-list-hist.id, ">>>>>>>>9")
     2314           else fill(chr(32) , 9)
     2315           )  chr(32)
     2316           (if buf_cli-list-hist.item_ <> '':U
     2317           then string(buf_cli-list-hist.hist-mode, "X(8)")
     2318           else fill( chr(32), 8)) chr(32)
     2319           string(buf_cli-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     2320           string(buf_cli-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     2321           (if page-size(PrnLibStream) > 43
     2322           then string(buf_cli-list-hist.des, "X(" + string(136 - 43) + ")")
     2323           else string(buf_cli-list-hist.des, "X(" + string(198 - 43) + ")"))
     2324           skip.
     2325         end.
     2326         if p-excel then do:
     2327           if Make-Excel then  put   stream ForExcel unformatted
     2328           (if buf_cli-list-hist.line = 0
     2329           then string(buf_cli-list-hist.id, ">>>>>>>>9")
     2330           else '':U)
     2331           CHR(9)
     2332           (if buf_cli-list-hist.item_ <> '':U
     2333           then buf_cli-list-hist.hist-mode
     2334           else '':U)  CHR(9)
     2335           (if buf_cli-list-hist.item_ <> '':U
     2336           then string(buf_cli-list-hist.num-add, "->>>>>>>>9")
     2337           else '':U)  CHR(9)
     2338           (if buf_cli-list-hist.item_ <> '':U
     2339           then string(buf_cli-list-hist.num-recs, ">>>>>>>>9")
     2340           else '':U)  CHR(9)
     2341           buf_cli-list-hist.des
     2342           skip.
     2343         end.
     2344       end.
     2345     end.
     2346   end procedure.
     2347   DEFINE VARIABLE Line as character no-undo .
     2348   DEFINE VARIABLE date_string as character no-undo .
     2349   DEFINE VARIABLE v-nn as integer no-undo .
     2350   DEFINE VARIABLE v-supp-name like ub.clients.obj-name no-undo .
     2351   DEFINE VARIABLE v-sum-without-slt-sale like ub.doc-line.price-rubl no-undo .
     2352   DEFINE VARIABLE v-sum-with-tax-cost    like ub.doc-line.price-rubl no-undo .
     2353   DEFINE VARIABLE v-sum-benefit-with-VAT like ub.doc-line.price-rubl no-undo .
     2354   DEFINE VARIABLE v-sum-benefit-without-VAT like ub.doc-line.price-rubl no-undo .
     2355   DEFINE VARIABLE a-sum-without-slt-sale like ub.doc-line.price-rubl no-undo .
     2356   DEFINE VARIABLE a-sum-with-tax-cost    like ub.doc-line.price-rubl no-undo .
     2357   DEFINE VARIABLE a-sum-benefit-with-VAT like ub.doc-line.price-rubl no-undo .
     2358   DEFINE VARIABLE a-sum-benefit-without-VAT like ub.doc-line.price-rubl no-undo .
     2359   define buffer buf_clients for ub.clients.
     2360   DEFINE FRAME Fkomis
     2361   v-nn                      column-label "№" format ">>9"
     2362   v-supp-name               column-label "Наименование поставщика" format "X(35)"
     2363   v-sum-without-slt-sale    column-label "Получено!комиссионером" format "->>,>>>,>>>,>>9.99"
     2364   v-sum-with-tax-cost       column-label "Подлежит!перечислению!комитенту" format "->>,>>>,>>>,>>9.99"
     2365   v-sum-benefit-with-VAT    column-label "Комиссионное!вознаграждение!с НДС" format "->>,>>>,>>>,>>9.99"
     2366   v-sum-benefit-without-VAT column-label "Комиссионное!вознаграждение!без НДС" format "->>,>>>,>>>,>>9.99"
     2367   HEADER  date_string AT 1 format "X(35)"
     2368   string( "Страница " ) format "X(9)" AT 59 PAGE-NUMBER(PrnLibStream) AT 69 FORMAT ">>9" SKIP
     2369   Line format "X(115)" AT 1
     2370   with width 232 down stream-io use-text    .
     2371   if not can-find( first cli-list no-lock) then do:
     2372     message "Не выбрано ни одного поставщика"
     2373     view-as alert-box ERROR.
     2374     return.
     2375   end.
     2376   if RS-BY < 1 AND RS-by > 4 then do:
     2377     message
     2378     vss-workfile vss-revision vss-description skip
     2379     "Неверное значение параметра RS-by = "RS-by
     2380     view-as alert-box error .
     2381     return error .
     2382   end.
     2383   run FillTable in this-procedure no-error  .
     2384   if error-status:error then do:
     2385     run waitfram-hide in this-procedure .
     2386     return error .
     2387   end.
     2388   if not avail sj-goods then do:
     2389     run waitfram-hide in this-procedure .
     2390     message
     2391     "Нет данных для отчета"
     2392     view-as alert-box .
     2393     return.
     2394   end.
     2395   Line = fill("-", 115).
     2396   date_string = cur-time-print() .
     2397   assign
     2398   str3 = str3 + chr(10) + "НДС принимается равным" + chr(32) + string(18.00, ">9.99%")
     2399   sheetf.Excel-Column-Lable =
     2400   "№"  + chr(44) +
     2401   "Наименование поставщика" + chr(44) +
     2402   "Получено комиссионером" + chr(44) +
     2403   "Подлежит перечислению комитенту" + chr(44) +
     2404   "Комиссионное вознаграждение с НДС" + chr(44) +
     2405   "Комиссионное вознаграждение без НДС"
     2406   sheetf.sizes =
     2407   "3" + chr(44) +
     2408   "35"  + chr(44) +
     2409   "18"  + chr(44) +
     2410   "18"  + chr(44) +
     2411   "18"  + chr(44) +
     2412   "18"
     2413   .
     2414   run prn-lib-open-stream  in this-procedure (
     2415                                                input parParentProc
     2416                                               ,input 62
     2417                                               ,input yes
     2418                                               ,input no
     2419                                               ).
     2420   run rep/extitle.p (1).
     2421   FORM with FRAME FKomis .
     2422   PUT stream PrnLibStream UNFORMATTED
     2423   p-Report-header skip(0)
     2424   "НДС принимается равным" chr(32) string(18.00, ">9.99%") skip(0)
     2425   .
     2426   FORM HEADER
     2427   Line format "X(115)" AT 1 SKIP
     2428   "Продолжение - на следующей странице" AT 30 SKIP
     2429   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2430   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2431   FORM with FRAME Fkomis  .
     2432   run waitfram-show in this-procedure ("Ждите...").
     2433   for each sj-goods no-lock
     2434   by sj-goods.supp-type
     2435   by sj-goods.supp-code:
     2436     assign
     2437     v-nn = v-nn + 1
     2438     v-sum-benefit-with-VAT = sj-goods.sum-with-tax-sale_ - sj-goods.sum-slt-sale_ - sj-goods.sum-with-tax-cost
     2439     v-sum-benefit-without-VAT = v-sum-benefit-with-VAT / (1 + 18.00 / 100 )
     2440     a-sum-without-slt-sale    = a-sum-without-slt-sale    + sj-goods.sum-with-tax-sale_ - sj-goods.sum-slt-sale_
     2441     a-sum-with-tax-cost       = a-sum-with-tax-cost       + sj-goods.sum-with-tax-cost
     2442     a-sum-benefit-with-VAT    = a-sum-benefit-with-VAT    + v-sum-benefit-with-VAT
     2443     a-sum-benefit-without-VAT = a-sum-benefit-without-VAT + v-sum-benefit-without-VAT
     2444     .
     2445     find first buf_clients no-lock where
     2446               buf_clients.obj-type = sj-goods.supp-type
     2447          AND  buf_clients.obj-code = sj-goods.supp-code no-error .
     2448     if avail buf_clients then do:
     2449       assign
     2450       v-supp-name = buf_clients.obj-name
     2451       .
     2452     end.
     2453     else do:
     2454       assign
     2455       v-supp-name = sj-goods.supp-type + string(sj-goods.supp-code)
     2456       .
     2457     end.
     2458     DISPLAY stream PrnLibStream
     2459     v-nn
     2460     v-supp-name
     2461     (sj-goods.sum-with-tax-sale_ - sj-goods.sum-slt-sale_) @  v-sum-without-slt-sale
     2462     sj-goods.sum-with-tax-cost @ v-sum-with-tax-cost
     2463     v-sum-benefit-with-VAT
     2464     v-sum-benefit-without-VAT
     2465     with frame Fkomis.
     2466     DOWN 1 stream PrnLibStream with frame Fkomis.
     2467     if Make-Excel then  put   stream ForExcel unformatted
     2468     v-nn                                                   CHR(9)
     2469     v-supp-name                                            CHR(9)
     2470     (sj-goods.sum-with-tax-sale_ - sj-goods.sum-slt-sale_) CHR(9)
     2471     sj-goods.sum-with-tax-cost                             CHR(9)
     2472     v-sum-benefit-with-VAT                                 CHR(9)
     2473     v-sum-benefit-without-VAT
     2474     skip.
     2475   END.
     2476   underline stream PrnLibStream
     2477   v-nn
     2478   v-supp-name
     2479   v-sum-without-slt-sale
     2480   v-sum-with-tax-cost
     2481   v-sum-benefit-with-VAT
     2482   v-sum-benefit-without-VAT
     2483   with frame Fkomis.
     2484   DOWN 1 stream PrnLibStream with frame Fkomis.
     2485   display stream PrnLibStream
     2486   "ИТОГО" @ v-supp-name
     2487   a-sum-without-slt-sale    @ v-sum-without-slt-sale
     2488   a-sum-with-tax-cost       @ v-sum-with-tax-cost
     2489   a-sum-benefit-with-VAT    @ v-sum-benefit-with-VAT
     2490   a-sum-benefit-without-VAT @ v-sum-benefit-without-VAT
     2491   with frame Fkomis.
     2492   DOWN 1 stream PrnLibStream with frame Fkomis.
     2493   if Make-Excel then  put   stream ForExcel unformatted
     2494                             CHR(9)
     2495   "ИТОГО"                   CHR(9)
     2496   a-sum-without-slt-sale    CHR(9)
     2497   a-sum-with-tax-cost       CHR(9)
     2498   a-sum-benefit-with-VAT    CHR(9)
     2499   a-sum-benefit-without-VAT
     2500   skip.
     2501   HIDE STREAM PrnLibStream FRAME FKomis .
     2502   HIDE STREAM PrnLibStream FRAME top-Frame .
     2503   HIDE stream PrnLibStream FRAME BottomFrame .
     2504   if Print-List-hist
     2505   and can-find(first cli-list) then do:
     2506     run lhistprex-print-cli-list-hist-excel  in this-procedure (input yes, input yes, 2).
     2507   end.
     2508   output stream PrnLibStream CLOSE .
     2509   if Make-Excel then output stream ForExcel close.
     2510   run waitfram-hide in this-procedure .
     2511   run prn-lib-prn-file in this-procedure (
     2512                                             input parParentProc
     2513                                             ,input 0
     2514                                             ).
