     1103     do
     1104     on error undo, return error
     1105     :
     1106   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1107   FOR  each ub.doc-line NO-LOCk WHERE
     1108            ub.doc-line.doc-code = doc-num:
     1109   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1110   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run doclicod in g#library
     1111     (input  recid(ub.doc-line)
     1112     ,output v-gds-code
     1113     ) no-error .
     1114     if error-status:error then do:
     1115      next.
     1116     end.
     1117     assign
     1118     my-accum = my-accum + 1
     1119     .
     1120     IF my-accum MODULO 50  = 0 then do:
     1121       run waitfram-show in this-procedure ("Обработано " + string(my-accum) + " строк накладных ").
     1122     end.
     1123   if t-doc.ext-doc-type = 'ot':U or
     1124      t-doc.ext-doc-type = ?                 then do:
     1125     assign
     1126      out-vatp-have-vat-slt = yes.
     1127   end.
     1128   else do:
     1129     find first out-vatp_doc-attr no-lock
     1130       where out-vatp_doc-attr.doc-code  = t-doc.doc-code
     1131         and out-vatp_doc-attr.attr-code = 'envd':U
     1132         no-error .
     1133     if not available out-vatp_doc-attr then do:
     1134       assign
     1135         out-vatp-have-vat-slt = yes.
     1136     end.
     1137     else do:
     1138        out-vatp-have-vat-slt = no.
     1139     end.
     1140   end.
     1141   find first out-vatp_goods where out-vatp_goods.artic     = ub.doc-line.artic     and
     1142                                      out-vatp_goods.prod-type = ub.doc-line.prod-type and
     1143                                      out-vatp_goods.prod-code = ub.doc-line.prod-code no-lock.
     1144   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1146     (input  ub.doc-line.artic
     1147     ,input  ub.doc-line.prod-type
     1148     ,input  ub.doc-line.prod-code
     1149     ,output varroot-node
     1150     ) no-error .
     1151   if error-status :error then do:
     1152     message
     1153       vss-workfile vss-revision vss-description skip
     1154       "Ошибка при определении корневого признака товара" skip
     1155       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     1156       error-status :get-message(1) skip
     1157       return-value skip
     1158       view-as alert-box error .
     1159     undo, return error .
     1160   end.
     1161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1162     (input  varroot-node
     1163     ,input  'empty-scale=request'
     1164     ,output varempty-scale
     1165     ) no-error .
     1166   if error-status :error then do:
     1167     message
     1168       vss-workfile vss-revision vss-description skip
     1169       "Ошибка при определении атрибута признака" skip
     1170       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     1171       "Признак" varroot-node skip
     1172       "Запрашивался атрибут" "empty-scale=request" skip
     1173       error-status :get-message(1) skip
     1174       return-value skip
     1175       view-as alert-box error .
     1176     undo, return error .
     1177   end.
     1178   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1179   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1180     (output varoutvprb
     1181     )  .
     1182   if varoutvprb = "base":u then do:
     1183     assign
     1184           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
     1185       excise-base-sale      =  (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * 1)
     1186     .
     1187   end.
     1188   else do:
     1189     assign
     1190           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax / t-doc.base-rate * t-doc.base-scale)
     1191       excise-base-sale      =  (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   / t-doc.base-rate * t-doc.base-scale)
     1192     .
     1193   end.
     1194   if varoutvprb = "rubl":u then do:
     1195     assign
     1196           road-tax-rubl-sale    = (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
     1197       excise-rubl-sale      = (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * 1) .
     1198   end.
     1199   else do:
     1200     assign
     1201           road-tax-rubl-sale    = (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * t-doc.base-rate / t-doc.base-scale)
     1202       excise-rubl-sale      = (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * t-doc.base-rate / t-doc.base-scale) .
     1203   end.
     1204   assign
     1205     varis-cons-parts-have =  no.
     1206   assign
     1207     varfact-qnty       = 0
     1208     varcons-qnty       = 0
     1209     varprice-base-cons = 0
     1210     varprice-rubl-cons = 0.
     1211   find first out-vatp_doc-line where
     1212              out-vatp_doc-line.doc-code   = t-doc.doc-code
     1213          and out-vatp_doc-line.artic      = ub.doc-line.artic
     1214          and out-vatp_doc-line.prod-type  = ub.doc-line.prod-type
     1215          and out-vatp_doc-line.prod-code  = ub.doc-line.prod-code no-lock no-error.
     1216   if available out-vatp_doc-line           and
     1217     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1218     assign
     1219       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1220   end.
     1221   else do:
     1222     for each out-vatp_parts where out-vatp_parts.out-code   = t-doc.doc-code
     1223                                  and out-vatp_parts.obj-type   = t-doc.obj-type
     1224                                  and out-vatp_parts.obj-code   = t-doc.obj-code
     1225                                  and out-vatp_parts.artic      = ub.doc-line.artic
     1226                                  and out-vatp_parts.prod-type  = ub.doc-line.prod-type
     1227                                  and out-vatp_parts.prod-code  = ub.doc-line.prod-code no-lock :
     1228       if out-vatp_parts.purch-code = 2 then do:
     1229   assign
     1230     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1231     price-base-with-tax-loco = out-vatp_parts.price-base
     1232   .
     1233   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1234   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1235     (output varinvprbo
