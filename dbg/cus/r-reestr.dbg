        1   define input  parameter parParentProc  as widget-handle no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Отчет Реестр документов по секциям".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define new global shared variable g#library  as handle no-undo .
      112   define new global shared variable g#library2 as handle no-undo .
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      115   define new shared variable RepPathName        as character no-undo .
      116   define new shared variable PrintRubl          as logical   no-undo .
      117   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      118   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      119   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      120   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      121   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      122   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      123   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      124   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      125   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      126   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      127   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      128   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      129   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      130   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      131   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      132   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      133   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      134   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      135   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      136   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      137   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      138   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      139   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      140   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      141   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      142   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      143   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      144   define variable temp1 as integer   no-undo.
      145   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   procedure cur-time :
      147      define output parameter p-today as date      no-undo .
      148      define output parameter p-time  as integer   no-undo .
      149     do
      150     on error undo, return error
      151     :
      152       define variable v-date1 as date      no-undo .
      153       define variable v-date2 as date      no-undo .
      154       define variable v-time  as integer   no-undo .
      155       assign
      156         v-date1 = today
      157         v-time  = time
      158         v-date2 = today
      159       .
      160       if v-date1 <> v-date2
      161       then do:
      162         assign
      163           v-date1 = today
      164           v-time  = v-time
      165         .
      166       end.
      167       assign
      168         p-today = v-date1
      169         p-time  = v-time
      170       .
      171     end.
      172   end.
      173   function cur-time-date returns character
      174   :
      175     return string(today, '99/99/9999':U) .
      176   end.
      177   function cur-time-mjd returns decimal
      178   :
      179     define variable v-date as date      no-undo .
      180     define variable v-time as integer   no-undo .
      181     run cur-time in this-procedure
      182       (output v-date
      183       ,output v-time
      184       ) .
      185     return integer(v-date) - 2400002 + (v-time / 86400) .
      186   end.
      187   function cur-time-get-ending-index returns integer
      188   (input p-number as integer
      189   )
      190   :
      191     if p-number < 0
      192     or p-number = ?
      193     then do:
      194       return 1 .
      195     end.
      196     define variable v-rest as integer   no-undo .
      197     assign
      198       p-number = p-number modulo 100
      199     .
      200     if p-number < 20
      201     then do:
      202       assign
      203         v-rest = p-number
      204       .
      205     end.
      206     else do:
      207       assign
      208         v-rest = p-number modulo 10
      209       .
      210     end.
      211     case v-rest :
      212       when 1
      213       then do:
      214         return 2 .
      215       end.
      216       when 2 or
      217       when 3 or
      218       when 4
      219       then do:
      220         return 3 .
      221       end.
      222       otherwise do:
      223         return 1 .
      224       end.
      225     end case .
      226   end.
      227   procedure cur-time-mjd-to-date :
      228      define input  parameter i-mjd-diff as decimal no-undo.
      229      define output parameter o-Date     as date    no-undo.
      230      define output parameter o-Time     as integer no-undo.
      231      define variable v-day-number as integer   no-undo .
      232      if    i-mjd-diff < 0
      233         or i-mjd-diff = ?
      234      then do:
      235         return "?" .
      236      end.
      237      assign
      238         v-day-number = truncate(i-mjd-diff,0).
      239         o-Date = date(v-day-number + 2400002).
      240         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      241     .
      242   end.
      243   function cur-time-mjd-to-string returns character
      244   (input p-mjd-diff as decimal
      245   )
      246   :
      247     define variable v-day-number as integer   no-undo .
      248     define variable v-seconds    as integer   no-undo .
      249     define variable v-hour       as integer   no-undo .
      250     define variable v-min        as integer   no-undo .
      251     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      252     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      253     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      254     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      255     if p-mjd-diff < 0
      256     or p-mjd-diff = ?
      257     then do:
      258       return "?" .
      259     end.
      260     assign
      261       v-day-number = integer(truncate(p-mjd-diff,0))
      262       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      263     .
      264     if v-seconds > 86400
      265     then do:
      266       assign
      267         v-seconds = 86400 - 1
      268       .
      269     end.
      270     if v-seconds < 0
      271     then do:
      272       assign
      273         v-seconds = 0
      274       .
      275     end.
      276     assign
      277       v-hour = truncate(v-seconds / 3600, 0)
      278     .
      279     assign
      280       v-seconds = v-seconds modulo 3600
      281     .
      282     assign
      283       v-min = truncate(v-seconds / 60, 0)
      284     .
      285     assign
      286       v-seconds = v-seconds modulo 60
      287     .
      288     return
      289         (if v-day-number <> 0
      290           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      291           else ""
      292         )
      293       + (if v-day-number <> 0 or v-hour <> 0
      294           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      295           else ""
      296         )
      297       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      298           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      299           else ""
      300         )
      301       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      302       .
      303   end.
      304   function cur-time-string returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      313   end.
      314   function cur-time-string-sec returns character
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      323   end.
      324   function cur-time-custom  returns character
      325   (input p-prefix as character
      326   ,input p-date-format as character
      327   ,input p-delimiter as character
      328   ,input p-time-format as character
      329   ,input p-suffix as character
      330   )
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return
      339       p-prefix
      340       + string(v-date, p-date-format)
      341       + p-delimiter
      342       + string(v-time, p-time-format)
      343       + p-suffix
      344       .
      345   end.
      346   function cur-time-print  returns character
      347   :
      348     define variable v-date as date      no-undo .
      349     define variable v-time as integer   no-undo .
      350     run cur-time in this-procedure
      351       (output v-date
      352       ,output v-time
      353       ) .
      354     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      355   end.
      356   function cur-time-datetime returns datetime
      357   :
      358     define variable v-char as character no-undo .
      359     define variable v-datetime as datetime no-undo .
      360     v-char = cur-time-string().
      361     v-datetime = datetime(v-char).
      362     return  v-datetime.
      363   end.
      364   function cur-time-string-msec returns character
      365   :
      366     define variable v-date as datetime  no-undo .
      367     v-date = now.
      368     return string(v-date) .
      369   end.
      370   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   function func-get-name-from-ext-type   returns char
      372     ( p-ext-type as character   ,
      373       p-caps     as logical ).
      374   define variable v-ext-name as character no-undo .
      375   run get-name-from-ext-type in this-procedure (
      376       input p-ext-type  ,
      377       input p-caps  ,
      378       output v-ext-name )
      379       no-error .
      380       if error-status :error then do:
      381          assign
      382            v-ext-name = p-ext-type
      383          .
      384       end.
      385    return (v-ext-name) .
      386   end.
      387   procedure get-name-from-ext-type :
      388    do
      389    on error undo, return error return-value
      390    :
      391   define input  parameter p-ext-type as character no-undo .
      392   define input  parameter p-caps     as logical no-undo   .
      393   define output parameter p-ext-name as character no-undo .
      394   define variable v-num as integer no-undo .
      395     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      396       message
      397         vss-include-info2 skip
      398         "Неправильно задано значение входящего параметра! "
      399         "Нет такого типа документов " p-ext-type
      400         view-as alert-box error .
      401         undo, return error .
      402     end.
      403     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      404     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      405     if p-caps  = true then do :
      406        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      407     end .
      408     end.
      409   end procedure.
      410   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      411   define variable v-waitfram-action01         as character   no-undo .
      412   define variable v-waitfram-action02         as character   no-undo .
      413   define variable v-waitfram-action03         as character   no-undo .
      414   define variable mWaitFramTextBeg            as character   no-undo.
      415   define variable mWaitFramTextEnd            as character   no-undo.
      416   define variable mWaitFramView               as logical     no-undo.
      417   define variable mWaitProcEvent              as logical     no-undo init yes.
      418   define variable mWaitFramInterval           as integer     no-undo init 1 .
      419   define variable mWaitFramStop               as logical     no-undo.
      420   define variable mWaitFramStopUser           as logical     no-undo.
      421   define variable mWaitFramStopTimeOut        as logical     no-undo.
      422   define variable mWaitFramStartProc          as datetime-tz no-undo.
      423   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      424   define button B-WaitFramStop auto-end-key
      425        label "Стоп"
      426        size 10 by 1 tooltip "Остоновить процесс".
      427   define button B-viewProcInfo
      428        label "Информация"
      429        size 15 by 1 tooltip "Информация о процесс".
      430   define frame waitfram
      431     v-waitfram-action01 format "x(72)" no-label skip
      432     v-waitfram-action02 format "x(72)" no-label skip
      433     v-waitfram-action03 format "x(72)" no-label skip
      434     B-viewProcInfo
      435     B-WaitFramStop at row 4 col 30
      436     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      437     .
      438   define new global shared variable mBatchMode as logical no-undo init ?.
      439   define variable mFramBachModHandle as handle no-undo.
      440   mFramBachModHandle = frame waitfram:handle.
      441   define variable mFameOldVis as logical no-undo.
      442   define variable mVisCUrentVin as logical no-undo.
      443   if session:batch-mode
      444   then
      445      mBatchMode = yes.
      446   if mBatchMode = ? then do:
      447     mVisCUrentVin = current-window:visible.
      448     mFameOldVis = mFramBachModHandle:visible.
      449     mFramBachModHandle:visible  = yes.
      450     mBatchMode = mFramBachModHandle:visible ne yes.
      451     mFramBachModHandle:visible = mFameOldVis.
      452     current-window:visible = mVisCUrentVin.
      453   end.
      454    if  log-manager:logfile-name ne ?
      455     then DO:
      456         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      457         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      458         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      459     end.
      460   on choose of B-WaitFramStop in frame waitfram
      461   do:
      462     mWaitFramStop = yes.
      463     mWaitFramStopUser = yes.
      464   end.
      465   function waitfram-check-timeout returns logical():
      466      define variable vtime as int64 no-undo.
      467      if mWaitFramStopTimeOut
      468      then
      469         return yes.
      470      vtime = ( now - mWaitFramStartProc ) / 1000 .
      471      if     mWaitFramTimeOut ne ?
      472         and mWaitFramTimeOut ne 0
      473         and mWaitFramTimeOut lt vtime
      474      then do:
      475         mWaitFramStopTimeOut = yes.
      476      end.
      477      return mWaitFramStopTimeOut.
      478   end.
      479   procedure waitfram-hide :
      480     if not session:batch-mode
      481     then do
      482     on error undo, return error return-value
      483     :
      484       pause 0 before-hide .
      485       if not mBatchMode then
      486         hide frame waitfram .
      487     if     not mWaitFramView
      488        and mWaitProcEvent
      489     then
      490       process events .
      491     end.
      492   end procedure.
      493   procedure waitfram-show :
      494     define input  parameter p-message as character no-undo .
      495     define variable v-left-margin as integer   no-undo .
      496     if not session:batch-mode
      497     then do
      498     on error undo, return error return-value
      499     :
      500       if length(p-message) <= 70 then do:
      501         assign
      502           v-left-margin = integer((70 - length(p-message)) / 2)
      503         .
      504         assign
      505           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      506         .
      507         assign
      508           v-waitfram-action01 = " "
      509           v-waitfram-action02 = " "
      510                                    + fill(" ", v-left-margin)
      511                                    + p-message
      512           v-waitfram-action03 = " "
      513         .
      514       end.
      515       else do:
      516         define variable vRindex1 as integer no-undo.
      517         define variable vRindex2 as integer no-undo.
      518         vRindex1 = r-index(p-message," ",70).
      519         if vRindex1 = 0
      520         then
      521            vRindex1 = 70.
      522         if length(p-message)  <= vRindex1 + 70 then do:
      523           assign
      524             v-waitfram-action01 = " "
      525             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      526             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      527           .
      528         end.
      529         else do:
      530           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      531           if vRindex2 <= vRindex1
      532           then
      533              vRindex2 = vRindex1 + 70.
      534           assign
      535             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      536             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      537             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      538           .
      539         end.
      540       end.
      541       B-viewProcInfo:visible   in frame waitfram = no.
      542       B-viewProcInfo:sensitive in frame waitfram = no.
      543       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      544       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      545       if  (   mWaitFramView
      546          or  mWaitProcEvent)
      547          and not mBatchMode
      548       then
      549          display
      550             v-waitfram-action01 skip
      551             v-waitfram-action02 skip
      552             v-waitfram-action03 skip
      553          with frame waitfram .
      554       if     mWaitFramView
      555          then do:
      556             if     mWaitFramInterval ne ?
      557                and not mBatchMode
      558             then
      559                wait-for go of frame waitfram pause mWaitFramInterval.
      560          end.
      561          else
      562             if     mWaitProcEvent
      563                and not mBatchMode
      564             then
      565                process events .
      566     end.
      567   end procedure.
      568      procedure waitfram-show-this:
      569         define input  parameter iInterval as int64 no-undo.
      570         define variable vtime as int64 no-undo.
      571         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      572         mWaitFramInterval = iInterval.
      573         run waitfram-show (substitute("&1&2 &3&4" ,
      574                                       mWaitFramTextBeg ,
      575                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      576                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      577                                       mWaitFramTextEnd
      578                                      )
      579                           ).
      580      end.
      581      procedure WaitFramRunPause:
      582         define input  parameter iInterval as dec no-undo.
      583         define variable vStart  as datetime-tz no-undo.
      584         define variable vend    as datetime-tz no-undo.
      585         define variable vint as int64 no-undo.
      586         define variable vOk as logical no-undo.
      587         vStart = now.
      588         vend   = vStart.
      589         publish "WaitFramPause" (iInterval,output vOk).
      590         vend   =  now.
      591         vint = vend - vStart.
      592         vint = iInterval - vint / 1000.
      593         if     not mWaitFramStop
      594            and (   vint > 0
      595                 or (    not vOk
      596                     and iInterval eq ?
      597                     )
      598                 )
      599         then
      600            run waitfram-show-this (iInterval).
      601         vend   =  now.
      602         vint = vend - vStart.
      603         vint = iInterval - vint / 1000.
      604         if     not mWaitFramStop
      605            and vint > 0
      606         then do:
      607            run gbl/pause.p (vint * 1000).
      608         end.
      609         if iInterval ne ?
      610         then
      611            publish "WaitFramStop".
      612         waitfram-check-timeout().
      613      end.
      614      procedure WaitFramWaitFor:
      615         define input  parameter iInterval as dec no-undo.
      616         assign
      617            mWaitFramStartProc   = now
      618            mWaitFramStopUser    = no
      619            mWaitFramStopTimeOut = no
      620         .
      621         block-wait:
      622         do while not mWaitFramStop:
      623            run WaitFramRunPause (iInterval).
      624            if  waitfram-check-timeout()
      625            then do:
      626               leave block-wait.
      627            end.
      628         end.
      629         run waitfram-hide.
      630      end.
      631   procedure waitfram-join :
      632     define input  parameter p-line-1  as character no-undo .
      633     define input  parameter p-line-2  as character no-undo .
      634     define input  parameter p-line-3  as character no-undo .
      635     define output parameter p-message as character no-undo .
      636     do
      637     on error undo, return error return-value
      638     :
      639       assign
      640         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      641                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      642                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      643       .
      644     end.
      645   end procedure.
      646   function waitfram-join-function returns character
      647     (input p-line-1 as character
      648     ,input p-line-2 as character
      649     ,input p-line-3 as character
      650     ).
      651     define variable v-message as character no-undo .
      652     run waitfram-join in this-procedure
      653       (input  p-line-1
      654       ,input  p-line-2
      655       ,input  p-line-3
      656       ,output v-message
      657       ) .
      658     return v-message .
      659   end function .
