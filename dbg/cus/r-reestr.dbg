      946            size 45 by 17.29
      947            BGCOLOR 8 FGCOLOR 0
      948            TITLE BGCOLOR 8 FGCOLOR 0 "Реестр документов  по секциям":L
      949            CANCEL-BUTTON b-quit.
      950   ASSIGN
      951          FRAME DLGOKCAN:SCROLLABLE       = FALSE
      952          FRAME DLGOKCAN:PRIVATE-DATA     =
      953                   "DLGCLOSE".
      954   ON CHOOSE OF b-print IN FRAME DLGOKCAN
      955   DO:
      956     if INPUT FRAME DLGOKCAN startdate > INPUT FRAME DLGOKCAN enddate
      957     then do:
      958       message
      959         "Дата окончания должна быть не меньше даты начала!"
      960         .
      961     end.
      962     else do:
      963       assign
      964         startdate
      965         enddate
      966         .
      967   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      968   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      969     (input  v-cntxt-obj-type
      970     ,input  v-cntxt-obj-code
      971     ,output v-today
      972     )  .
      973       if enddate > v-today
      974       then do:
      975         message
      976           "Дата окончания превышает текущую дату!"
      977           .
      978       end.
      979       else do:
      980         assign
      981           PayType = integer(SET_PAY_TYPE :screen-value)
      982         .
      983       end.
      984       define variable v-start-date as date      no-undo .
      985       define variable v-end-date   as date      no-undo .
      986       assign
      987         v-start-date = startdate
      988         v-end-date   = enddate
      989       .
      990       run rep/chk-ahz.p
      991         (input        v-cntxt-obj-type
      992         ,input        v-cntxt-obj-code
      993         ,input        false
      994         ,input        true
      995         ,input        false
      996         ,input        false
      997         ,input        true
      998         ,input        v-cntxt-db-num
      999         ,input        v-cntxt-userid
     1000         ,input-output v-start-date
     1001         ,input-output v-end-date
     1002         ,output       v-archive-ok
     1003         ,output       v-comment
     1004         ,output       v-can-print
     1005         ).
     1006       if v-archive-ok = false
     1007       then do:
     1008         if v-can-print = true
     1009         then do:
     1010           define variable v-choice as logical   no-undo .
     1011           message
     1012             "ВНИМАНИЕ!" skip
     1013             v-comment skip
     1014             "" skip
     1015             "Продолжить формирование отчета ?" skip
     1016             view-as alert-box question buttons yes-no update v-choice .
     1017           if v-choice = false
     1018           then do:
     1019             return .
     1020           end.
     1021         end.
     1022         else do:
     1023           message
     1024             "ВНИМАНИЕ !!!" skip
     1025             "Отчет не может быть сформирован!" skip
     1026             "На запрошенную дату нет архивов или они сжаты" skip
     1027             v-comment skip
     1028             view-as alert-box information .
     1029           return .
     1030         end.
     1031       end.
     1032       else do:
     1033         run main-proc in this-procedure .
     1034       end.
     1035     end.
     1036   END.
     1037   ON VALUE-CHANGED OF combo-node IN FRAME DLGOKCAN
     1038   DO:
     1039   RES = 'все':U.
     1040     Assign combo-node.
     1041     if combo-node = 2 Then DO:
     1042       run cus/sel-grp0.w (1).
     1043       RES = return-value .
     1044       if RES = 'все':U OR RES = '' Then DO:
     1045               Assign combo-node = 1 RES = 'все':U.
     1046               Display combo-node  with frame DLGOKCAN .
     1047               End.
     1048       END.
     1049       IF RES <> 'все':U THEN DO:
     1050       find first ub.gds-grp where ub.gds-grp.node-code = integer(res) no-lock no-error.
     1051       if available ub.gds-grp THEN DO:
     1052         enable ub.gds-grp.node-name  with frame DLGOKCAN .
     1053         Display ub.gds-grp.node-name  with frame DLGOKCAN .
     1054         End.
     1055       END.
     1056       IF RES = 'все':U THEN hide ub.gds-grp.node-name  in frame DLGOKCAN .
     1057       Display combo-node  with frame DLGOKCAN .
     1058   END.
     1059   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   on help of frame DLGOKCAN
     1061   do:
     1062     run gbl/app_help.p
     1063       (input this-procedure :file-name
     1064       ,input ''
     1065       ,input ?
     1066       ) no-error.
     1067     if error-status :error then do:
     1068       message
     1069         "Ошибка при вызове помощи"
     1070         error-status :get-message(1)
     1071         view-as alert-box .
     1072     end.
     1073   end.
     1074   run minbtn-set in this-procedure .
     1075   on choose of b-help in frame DLGOKCAN
     1076   do:
     1077     apply "help":u to frame DLGOKCAN .
     1078   end.
     1079   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   procedure minbtn-set :
     1081       do
     1082           on error undo, return error return-value
     1083           :
     1084           define variable ii              as integer       no-undo .
     1085           define variable fh              as widget-handle no-undo .
     1086           define variable hh              as widget-handle no-undo .
     1087           define variable v-h             as handle        extent 4 no-undo .
     1088           define variable v-name-button   as character     no-undo .
     1089           define variable v-help-old-x    as decimal       no-undo .
     1090           define variable v-help-old-y    as decimal       no-undo .
     1091           define variable v-help-old-size as decimal       no-undo .
     1092           define variable v-frame-width   as decimal       no-undo .
     1093           define variable jj              as integer       no-undo .
     1094           do
     1095               on error undo, return error
     1096               :
     1097               assign
     1098                   v-frame-width = frame DLGOKCAN:width - 0.3
     1099                   fh            = frame DLGOKCAN:first-child
     1100                   hh            = fh:first-child
     1101                   ii            = 1
     1102                   .
     1103               do while valid-handle(hh):
     1104                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1105                   do:
     1106                       case lc(hh:name) :
     1107                           when "b-help" then
     1108                               do:
     1109                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1110                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1111                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1112                                   hh:TOOLTIP = "Помощь" .
     1113                                   v-help-old-x = hh:column .
     1114                                   v-help-old-y = hh:row    .
     1115                                   v-help-old-size = hh:width .
     1116                                   hh:width-chars = 2.5 .
     1117                               end.
     1118                           when "b-print" then
     1119                               do:
     1120                                   hh:load-image("cmp/b-print.bmp":u) .
     1121                                   hh:TOOLTIP = "Печать" .
     1122                                   v-h[ii] = hh:handle .
     1123                                   ii = ii + 1 .
     1124                                   hh:width-chars = 3 .
     1125                               end.
     1126                           when "b-history" or
     1127                           when "b-hist" then
     1128                               do:
     1129                                   hh:load-image("cmp/b-hist.bmp":u) .
     1130                                   hh:TOOLTIP = "История" .
     1131                                   v-h[ii] = hh:handle .
     1132                                   ii = ii + 1 .
     1133                                   hh:width-chars = 3 .
     1134                               end.
     1135                           when "b-sch" then
     1136                               do:
     1137                                   hh:load-image("cmp/b-sch.bmp":u) .
     1138                                   hh:TOOLTIP = "Установка Фильтра" .
     1139                                   v-h[ii] = hh:handle .
     1140                                   ii = ii + 1 .
     1141                                   hh:width-chars = 3 .
     1142                               end.
     1143                           when "b-hist-user" then
     1144                               do:
     1145                                   hh:load-image("cmp/b-hist.bmp":u) .
     1146                                   hh:TOOLTIP = "История пользователя" .
     1147                                   ii = ii + 1 .
     1148                               end.
     1149                       end case.
     1150                   end.
     1151                   hh = hh:next-sibling.
     1152               end.
     1153               b-help:column = v-frame-width - b-help:width-chars.
     1154               jj = 0.
     1155               repeat ii = 4 to 1 by -1 :
     1156                   if valid-handle (v-h[ii] ) then
     1157                   do:
     1158                       jj  = jj + 1 .
     1159                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1160                       v-h[ii]:row    = v-help-old-y .
     1161                   end.
     1162               end.
     1163           end.
     1164       end.
     1165   end procedure.
     1166   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
