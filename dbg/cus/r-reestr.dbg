     2203   PROCEDURE NSum :
     2204   Assign
     2205              qnty          = 0
     2206              SumSale    = 0
     2207              SumCrsa    = 0
     2208              SumVat = 0
     2209              SumSLT    = 0
     2210              SumOv      = 0
     2211              SumDisc      = 0
     2212              Sum-qnty      = 0
     2213              Sum-Coast     = 0
     2214              Sum-NDS       = 0
     2215              Sum-SLT       = 0.
     2216   END PROCEDURE.
     2217   PROCEDURE on-same-page :
     2218     define input parameter p-line-number as integer  no-undo .
     2219     if p-line-number > page-size( OutStream ) then do:
     2220       return .
     2221     end.
     2222     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     2223       page stream OutStream .
     2224     end.
     2225   end procedure.
     2226   PROCEDURE P-line :
     2227   if paytype = 2 then DO:
     2228   Underline stream OutStream
     2229           sym11
     2230           sym3 T-fact-date
     2231           sym4 T-doc-num
     2232           sym5 T-cli-name
     2233           sym6 qnty
     2234           sym7 SumSale
     2235           sym8 SumVat
     2236           SumSLT
     2237           with FRAME DocsRep-cost.
     2238           DOWN stream OutStream 1 with FRAME DocsRep-cost.
     2239           end.
     2240           Else do:
     2241   Underline stream OutStream
     2242           sym11 sym12
     2243           sym3 T-fact-date
     2244           sym4 T-doc-num
     2245           sym5 T-cli-name
     2246           sym6 qnty
     2247           sym7 SumSale
     2248           sym8 SumVat
     2249           sym9 SumSLT
     2250           sym10 sumcrsa
     2251           sumov sumdisc
     2252           with FRAME DocsRep.
     2253           DOWN stream OutStream 1 with FRAME DocsRep.
     2254          End.
     2255   END PROCEDURE.
     2256   PROCEDURE PrintDetaile2 :
     2257   if paytype =  2 then
     2258     DISPLAY stream OutStream
     2259          T-NAme-node
     2260          sym1  T-fact-date
     2261          sym2  T-doc-num
     2262          sym3  T-cli-name
     2263          sym4  qnty    format "->>>>>>>9.999"
     2264          sym5  SumSale format "->>>>>>>>>9.99"
     2265          sym6  SumVat  format "->>>>>>>>>9.99"
     2266          sym7  SumSLT  format "->>>>>>>>>9.99"
     2267          sym8
     2268          sym11
     2269            with FRAME DocsRep-cost.
     2270       ELSE
     2271     DISPLAY stream OutStream
     2272           T-NAme-node
     2273          sym1  T-fact-date
     2274          sym2  T-doc-num
     2275          sym3  T-cli-name
     2276          sym4  qnty    format "->>>>>>>9.999"
     2277          sym5  SumSale format "->>>>>>>>>9.99" when NOT (TRIM(T-NAme-node)  begins "Остаток")
     2278          sym6  SumVat  format "->>>>>>>>>9.99" when NOT (TRIM(T-NAme-node)  begins "Остаток")
     2279          sym7  SumSLT  format "->>>>>>>>>9.99" when NOT (TRIM(T-NAme-node)  begins "Остаток")
     2280          sym8  SumCrsa format "->>>>>>>>>9.99"
     2281          sym9
     2282          SumOv   format "->>>>>>>>>9.99"       when NOT (TRIM(T-NAme-node)  begins "Остаток")
     2283          sym10
     2284          SumDisc format "->>>>>>>>>9.99"       when NOT (TRIM(T-NAme-node)  begins "Остаток")
     2285          sym11
     2286          sym12
     2287            with FRAME DocsRep.
     2288       if PayType = 2
     2289       then DOWN stream OutStream 1 with FRAME DocsRep-cost.
     2290       else DOWN stream OutStream 1 with FRAME DocsRep.
     2291   END PROCEDURE.
     2292   PROCEDURE PrintDetItogo :
     2293   if paytype = 2 THEN
     2294       Put Stream OutStream UNFORMATTED
     2295       sym11
     2296       string(T-NAme-node  ,"x(40)")
     2297       sym1  space(10)
     2298       sym2  space(10)
     2299       sym3  String(T-cli-name   ,"x(28)")
     2300       sym4  space(13)
     2301       sym5  space(14)
     2302       sym6  space(14)
     2303       sym7  space(14)
     2304       sym8
     2305       skip.
     2306    Else
     2307       Put Stream OutStream UNFORMATTED
     2308       sym11
     2309       string(T-NAme-node  ,"x(40)")
     2310       sym1  space(10)
     2311       sym2  space(10)
     2312       sym3  String(T-cli-name   ,"x(28)")
     2313       sym4  space(13)
     2314       sym5  space(14)
     2315       sym6  space(14)
     2316       sym7  space(14)
     2317       sym8  space(14)
     2318       sym9  space(14)
     2319       sym10 space(14)
     2320       sym12
     2321       skip.
     2322   END PROCEDURE.
     2323   PROCEDURE PrintFooter :
     2324    run u-line.
     2325     run on-same-page in this-procedure (input 11) .
     2326     hide stream OutStream frame bottomframe .
     2327       Quantity = Quantity2 - Quantity1.
     2328       Coast = Coast2 - Coast1 .
     2329       Coast-vat = Coast-vat2 - Coast-vat1 .
     2330   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2331   CASE "" :
     2332   WHEN  "1" then
     2333   TEMPSTR =  string( "Остаток на начало периода (" + string( startdate, "99/99/9999" ) + ")" )   .
     2334   WHEN "2" then
     2335   TEMPSTR = string( "Остаток на конец периода (" + string( enddate, "99/99/9999" ) + ")" )  .
     2336   OTHERWISE
     2337   TEMPSTR =string( "Оборот с " + string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) )  .
     2338   end CASE.
     2339   PUT STREAM OutStream
     2340   SKIP
     2341   SPACE(5)
     2342   TEMPSTR format "x(72)"
     2343   SKIP
     2344   SPACE(32) string( "Количество: " + trim( string( Quantity, "->>>,>>>,>>9.<<<" ) ) ) format "x(72)"
     2345   SKIP.
     2346   IF PayType = 2 OR PayType = 0  then do:
     2347   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2348   do:
     2349     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2350       (input  v-cntxt-db-num
     2351       ,input  v-cntxt-userid
     2352       ,input  0
     2353       ,input  'actn_reports_lookup-cost':U
     2354       ,input  'object':U
     2355       ,input  v-cntxt-host-code-obj
     2356       ,input  v-cntxt-obj-type
     2357       ,input  v-cntxt-obj-code
     2358       ,input  0
     2359       ,input  0
     2360       ,input  0
     2361       ,input  false
     2362       ,output v-log
     2363       )  .
     2364   end.
     2365   if  v-log = true  then
     2366   PUT STREAM OutStream
     2367   SPACE(23) string( "Cумма   УЧЕТНЫХ  цен: " +
     2368               trim( string( Coast , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2369               curr-rep
     2370             ) format "x(72)"
     2371             SKIP.
     2372   PUT STREAM OutStream
     2373   SPACE(23) string( "Cумма УЧЕТНЫХ цен без НДС: " +
     2374        trim( string( (Coast - Coast-vat  ) , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2375        curr-rep
     2376        ) format "x(72)"
     2377        SKIP.
     2378   end.
     2379   Else   PUT STREAM OutStream
     2380   SPACE(23) string(  "Cумма ПРОДАЖНЫХ цен: " +
     2381               trim( string( Coast, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2382               curr-rep
     2383             ) format "x(72)"
     2384             SKIP.
     2385   .
     2386   if CalcRest then
     2387       do:
     2388           PUT STREAM OutStream "По всем секциям " skip.
     2389   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2390   CASE "2" :
     2391   WHEN  "1" then
     2392   TEMPSTR =  string( "Остаток на начало периода (" + string( startdate, "99/99/9999" ) + ")" )   .
     2393   WHEN "2" then
     2394   TEMPSTR = string( "Остаток на конец периода (" + string( enddate, "99/99/9999" ) + ")" )  .
     2395   OTHERWISE
     2396   TEMPSTR =string( "Оборот с " + string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) )  .
     2397   end CASE.
     2398   PUT STREAM OutStream
     2399   SKIP
     2400   SPACE(5)
     2401   TEMPSTR format "x(72)"
     2402   SKIP
     2403   SPACE(32) string( "Количество: " + trim( string( Quantity2, "->>>,>>>,>>9.<<<" ) ) ) format "x(72)"
     2404   SKIP.
     2405   IF PayType = 2 OR PayType = 0  then do:
     2406   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2407   do:
     2408     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2409       (input  v-cntxt-db-num
     2410       ,input  v-cntxt-userid
     2411       ,input  0
     2412       ,input  'actn_reports_lookup-cost':U
