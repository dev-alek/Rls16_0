     2421       ,output v-log
     2422       )  .
     2423   end.
     2424   if  v-log = true  then
     2425   PUT STREAM OutStream
     2426   SPACE(23) string( "Cумма   УЧЕТНЫХ  цен: " +
     2427               trim( string( Coast2 , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2428               curr-rep
     2429             ) format "x(72)"
     2430             SKIP.
     2431   PUT STREAM OutStream
     2432   SPACE(23) string( "Cумма УЧЕТНЫХ цен без НДС: " +
     2433        trim( string( (Coast2 - Coast-vat2  ) , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2434        curr-rep
     2435        ) format "x(72)"
     2436        SKIP.
     2437   end.
     2438   Else   PUT STREAM OutStream
     2439   SPACE(23) string(  "Cумма ПРОДАЖНЫХ цен: " +
     2440               trim( string( Coast2, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2441               curr-rep
     2442             ) format "x(72)"
     2443             SKIP.
     2444   .
     2445       end.
     2446   PUT STREAM OutStream " " SKIP(2)
     2447       SPACE(20) "Заведующий __________________" format "X(32)"
     2448       SPACE(20) "Ст. продавец __________________" format "X(32)"
     2449       SPACE(20) "Бухгалтер __________________" format "X(32)" SKIP
     2450       .
     2451      run on-same-page in this-procedure (input 10) .
     2452   END PROCEDURE.
     2453   PROCEDURE PrintHeader :
     2454   PUT STREAM OutStream SPACE(27)
     2455           "Р Е Е С Т Р   Д О К У М Е Н Т О В ( Т О В А Р Н Ы Й   О Т Ч Е Т )"
     2456               format "X(80)" SKIP(1)
     2457           SPACE(40) "за период  с  " format "X(14)" startdate format "99.99.9999"
     2458               "  по  " enddate format "99.99.9999"
     2459           SPACE(32) string("По объекту  : " + ub.clients.obj-name ) format "X(80)" SKIP
     2460           If paytype = 2 Then "Суммы указаны в УЧЕТНЫХ ценах"
     2461                          Else "Суммы указаны в ЦЕНАХ ДОКУМЕНТА"  format "X(80)"
     2462           SKIP
     2463           .
     2464   if CalcRest then
     2465       do:
     2466           PUT STREAM OutStream "По всем секциям " skip.
     2467   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2468   CASE "1" :
     2469   WHEN  "1" then
     2470   TEMPSTR =  string( "Остаток на начало периода (" + string( startdate, "99/99/9999" ) + ")" )   .
     2471   WHEN "2" then
     2472   TEMPSTR = string( "Остаток на конец периода (" + string( enddate, "99/99/9999" ) + ")" )  .
     2473   OTHERWISE
     2474   TEMPSTR =string( "Оборот с " + string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) )  .
     2475   end CASE.
     2476   PUT STREAM OutStream
     2477   SKIP
     2478   SPACE(5)
     2479   TEMPSTR format "x(72)"
     2480   SKIP
     2481   SPACE(32) string( "Количество: " + trim( string( Quantity1, "->>>,>>>,>>9.<<<" ) ) ) format "x(72)"
     2482   SKIP.
     2483   IF PayType = 2 OR PayType = 0  then do:
     2484   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2485   do:
     2486     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2487       (input  v-cntxt-db-num
     2488       ,input  v-cntxt-userid
     2489       ,input  0
     2490       ,input  'actn_reports_lookup-cost':U
     2491       ,input  'object':U
     2492       ,input  v-cntxt-host-code-obj
     2493       ,input  v-cntxt-obj-type
     2494       ,input  v-cntxt-obj-code
     2495       ,input  0
     2496       ,input  0
     2497       ,input  0
     2498       ,input  false
     2499       ,output v-log
     2500       )  .
     2501   end.
     2502   if  v-log = true  then
     2503   PUT STREAM OutStream
     2504   SPACE(23) string( "Cумма   УЧЕТНЫХ  цен: " +
     2505               trim( string( Coast1 , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2506               curr-rep
     2507             ) format "x(72)"
     2508             SKIP.
     2509   PUT STREAM OutStream
     2510   SPACE(23) string( "Cумма УЧЕТНЫХ цен без НДС: " +
     2511        trim( string( (Coast1 - Coast-vat1  ) , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2512        curr-rep
     2513        ) format "x(72)"
     2514        SKIP.
     2515   end.
     2516   Else   PUT STREAM OutStream
     2517   SPACE(23) string(  "Cумма ПРОДАЖНЫХ цен: " +
     2518               trim( string( Coast1, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2519               curr-rep
     2520             ) format "x(72)"
     2521             SKIP.
     2522   .
     2523       end.
     2524   END PROCEDURE.
     2525   PROCEDURE u-line :
     2526   if PayType = 2 then
     2527   Underline stream OutStream
     2528           sym1 T-NAme-node
     2529           sym2 T-fact-date
     2530           sym3 T-doc-num
     2531           sym4 T-cli-name
     2532           sym5 qnty
     2533           sym6
     2534           SumSale
     2535           sym7 SumVat
     2536           sym8 SumSLT
     2537           sym11
     2538           with FRAME DocsRep-cost.
     2539   Else
     2540   Underline stream OutStream
     2541           sym1 T-NAme-node
     2542           sym2 T-fact-date
     2543           sym3 T-doc-num
     2544           sym4 T-cli-name
     2545           sym5 qnty
     2546           sym6
     2547           SumSale
     2548           SumCrsa
     2549           SumOv
     2550           SumDisc
     2551           sym7 SumVat
     2552           sym8 SumSLT
     2553           sym9
     2554           sym10
     2555           sym11
     2556           sym12
     2557           with FRAME DocsRep.
     2558    if PayType = 2 then
     2559    DOWN stream OutStream 1 with FRAME DocsRep-cost.
     2560    Else DOWN stream OutStream 1 with FRAME DocsRep.
     2561   END PROCEDURE.
     2562   PROCEDURE Print-o :
     2563   if PayType = 2 then
     2564   Put Stream OutStream UNFORMATTED
     2565     sym11  string(T-NAme-node  ,"x(51)")
     2566     sym1   space(10)
     2567     sym3   space(28)
     2568     sym4  qnty     format "->>>>>>>9.999"
     2569     sym5  SumSale  format "->>>>>>>>>9.99"
     2570     sym6  SumVat   format "->>>>>>>>>9.99"
     2571     sym7  SumSLT   format "->>>>>>>>>9.99"
     2572     sym8
     2573     skip.
     2574     Else
     2575   Put Stream OutStream UNFORMATTED
     2576     sym11  string(T-NAme-node  ,"x(51)")
     2577     sym1   space(10)
     2578     sym3   space(28)
     2579     sym4  qnty     format "->>>>>>>9.999"
     2580     sym5  SumSale  format "->>>>>>>>>9.99"
     2581     sym6  SumVat   format "->>>>>>>>>9.99"
     2582     sym7  SumSLT   format "->>>>>>>>>9.99"
     2583     sym8  Sumdisc  format "->>>>>>>>>9.99"
     2584     sym9  Sumov    format "->>>>>>>>>9.99"
     2585     sym10 SumCrsa  format "->>>>>>>>>9.99"
     2586     sym12
     2587     skip.
     2588   END PROCEDURE.
