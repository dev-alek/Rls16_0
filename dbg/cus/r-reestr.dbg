     1542       end.
     1543       define variable v-ok            as logical   no-undo .
     1544       define variable v-curr-sv-date  as date      no-undo .
     1545       define variable v-description   as character no-undo .
     1546       assign
     1547         v-curr-sv-date = date(self :screen-value) no-error
     1548       .
     1549       if v-curr-sv-date = ?
     1550       then do:
     1551         run gbl/getcurdt.p
     1552           (output v-curr-sv-date
     1553           ) .
     1554       end.
     1555       if v-curr-sv-date <> ?
     1556       then do:
     1557         run gbl/d-inpday.w
     1558           (input ?
     1559           ,input "Выбор даты"
     1560           ,input v-description
     1561           ,input ""
     1562           ,input-output v-curr-sv-date
     1563           ,output v-ok
     1564           ).
     1565         if v-ok = true
     1566         then do:
     1567           assign
     1568             self :screen-value = string(v-curr-sv-date) .
     1569           .
     1570         end.
     1571       end.
     1572     end.
     1573     return no-apply .
     1574   end.
     1575     define MENU m-ed-date14
     1576       MENU-ITEM m-ed-date14-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1577       MENU-ITEM m-ed-date14-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1578       MENU-ITEM m-ed-date14-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1579       MENU-ITEM m-ed-date14-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1580       .
     1581     if enddate :POPUP-MENU in frame DLGOKCAN = ?
     1582     then do:
     1583       ASSIGN
     1584         enddate :POPUP-MENU in frame DLGOKCAN = MENU m-ed-date14 :HANDLE
     1585         enddate :MENU-MOUSE in frame DLGOKCAN = 3
     1586       .
     1587     end.
     1588     define variable v-label-handle14 as handle no-undo .
     1589     assign
     1590       v-label-handle14 = enddate :side-label-handle in frame DLGOKCAN
     1591     .
     1592     if valid-handle (v-label-handle14)
     1593     then do:
     1594       if v-label-handle14 :tooltip = ""
     1595       or v-label-handle14 :tooltip = ?
     1596       then do:
     1597         assign
     1598           v-label-handle14 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1599         .
     1600       end.
     1601     end.
     1602     ON CHOOSE OF MENU-ITEM m-ed-date14-1 in menu m-ed-date14 DO:
     1603       apply "ctrl-b":U to enddate in frame DLGOKCAN .
     1604     END.
     1605     ON CHOOSE OF MENU-ITEM m-ed-date14-2 in menu m-ed-date14 DO:
     1606       apply "ctrl-d":U to enddate in frame DLGOKCAN .
     1607     END.
     1608     ON CHOOSE OF MENU-ITEM m-ed-date14-3 in menu m-ed-date14 DO:
     1609       apply "ctrl-e":U to enddate in frame DLGOKCAN .
     1610     END.
     1611     ON CHOOSE OF MENU-ITEM m-ed-date14-4 in menu m-ed-date14 DO:
     1612       apply "ctrl-f":U to enddate in frame DLGOKCAN .
     1613     END.
     1614   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
     1615   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1617     (input  v-cntxt-obj-type
     1618     ,input  v-cntxt-obj-code
     1619     ,output v-today
     1620     )  .
     1621   ASSIGN
     1622       startdate = v-today - 7
     1623       enddate   = v-today .
     1624   Find first ub.gds-grp where ub.gds-grp.upper-code =0 no-lock no-error.
     1625        If AVAILABLE ub.gds-grp then Rootgrp = ub.gds-grp.node-code.
     1626           Else DO:
     1627                message "Отчет пуст ! Не заполнен классификатор групп товаров!".
     1628                Return.
     1629                End.
     1630   MAIN-BLOCK:
     1631   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1632      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1633       if session:set-wait-state("COMPILER") then.
     1634       run enable_ui.
     1635       WAIT-FOR GO OF FRAME DLGOKCAN.
     1636   END.
     1637   run disable_ui.
     1638   PROCEDURE Calc-Itog-node :
     1639   if CalcRest then
     1640       do:
     1641         FIND LAST ub.stk-line WHERE ub.stk-line.obj-type  = v-cntxt-obj-type
     1642                             AND ub.stk-line.obj-code   = v-cntxt-obj-code
     1643                             AND ub.stk-line.prod-code  = ub.gds-obj.prod-code
     1644                             AND ub.stk-line.prod-type  = ub.gds-obj.prod-type
     1645                             AND ub.stk-line.artic      = ub.gds-obj.artic
     1646                             AND ub.stk-line.fact-order <= fact-order-1
     1647                             AND ub.stk-line.sum-type   =  (IF PayType = 2  then  'cost':U
     1648                                                                       else  'crsa':U )
     1649                             AND ub.stk-line.cat-id     = '##,##':U
     1650                             USE-INDEX category no-lock no-error.
     1651         If Available ub.stk-line then Assign Quantity3-1    = Quantity3-1 + ub.stk-line.fact-qnty
     1652                                           Coast3-1       = Coast3-1 + ub.stk-line.sum-rubl
     1653                                           coast-vat3-1     = coast-vat3-1 + ub.stk-line.VAT-rubl
     1654                                           CoastSLT-1     = CoastSLT-1 + ub.stk-line.SLT-rubl
     1655                                           .
     1656         FIND LAST stk-line2 WHERE stk-line2.obj-type  = v-cntxt-obj-type
     1657                             AND stk-line2.obj-code   = v-cntxt-obj-code
     1658                             AND stk-line2.prod-code  = ub.gds-obj.prod-code
     1659                             AND stk-line2.prod-type  = ub.gds-obj.prod-type
     1660                             AND stk-line2.artic      = ub.gds-obj.artic
     1661                             AND stk-line2.fact-order <= fact-order-1
     1662                             AND stk-line2.sum-type   =  'crsa':U no-lock no-error.
     1663         If Available stk-line2 then Assign QuantityCrsa-1    = QuantityCrsa-1 + stk-line2.fact-qnty
     1664                                            CoastCrsa-1       = CoastCrsa-1 + stk-line2.sum-rubl .
     1665      End.
     1666    END PROCEDURE.
     1667   PROCEDURE Calc-Itog-node-end :
     1668   if CalcRest then
     1669       do:
     1670         FIND LAST ub.stk-line WHERE ub.stk-line.obj-type  = v-cntxt-obj-type
     1671                             AND ub.stk-line.obj-code   = v-cntxt-obj-code
     1672                             AND ub.stk-line.prod-code  = ub.gds-obj.prod-code
     1673                             AND ub.stk-line.prod-type  = ub.gds-obj.prod-type
     1674                             AND ub.stk-line.artic      = ub.gds-obj.artic
     1675                             AND ub.stk-line.fact-order <= fact-order-2
     1676                             AND ub.stk-line.sum-type   =  (IF PayType = 2  then  'cost':U
     1677                                                                         else  'crsa':U )
     1678                             AND ub.stk-line.cat-id     = '##,##':U
     1679                             USE-INDEX category no-lock no-error.
     1680         If Available ub.stk-line then Assign Quantity3    = Quantity3 + ub.stk-line.fact-qnty
     1681                                           Coast3       = Coast3 + ub.stk-line.sum-rubl
     1682                                           coast-vat     = coast-vat + ub.stk-line.VAT-rubl
     1683                                           CoastSLT     = CoastSLT + ub.stk-line.SLT-rubl
     1684                                           .
     1685         FIND LAST stk-line2 WHERE stk-line2.obj-type   = v-cntxt-obj-type
     1686                             AND stk-line2.obj-code     = v-cntxt-obj-code
     1687                             AND stk-line2.prod-code    = ub.gds-obj.prod-code
     1688                             AND stk-line2.prod-type    = ub.gds-obj.prod-type
     1689                             AND stk-line2.artic        = ub.gds-obj.artic
     1690                             AND stk-line2.fact-order   <= fact-order-2
     1691                             AND stk-line2.sum-type     = 'crsa':U
     1692                             no-lock no-error.
     1693         If Available stk-line2 then Assign QuantityCrsa   = QuantityCrsa + stk-line2.fact-qnty
     1694                                           CoastCrsa       = CoastCrsa + stk-line2.sum-rubl.
     1695      End.
     1696    END PROCEDURE.
     1697   PROCEDURE CalcItog :
     1698   FIND FIRST ub.stk-tot WHERE ub.stk-tot.obj-type = v-cntxt-obj-type
     1699                                      AND ub.stk-tot.obj-code   = v-cntxt-obj-code
     1700                                      AND ub.stk-tot.Fact-date >= startdate - 1
     1701                                      AND ub.stk-tot.Fact-date <= Enddate
     1702                                      AND ub.stk-tot.sum-type = (IF PayType = 2  then  'cost':U
     1703                                                                               else  'crsa':U )
     1704                                      AND ub.stk-tot.cat-id  = '##,##':U
     1705                                      USE-INDEX fact-date no-lock no-error.
     1706   If Available ub.stk-tot then Assign Fact-order-1 = ub.stk-tot.Fact-order.
     1707                         Else Assign Fact-order-1 = 0.
     1708   FIND last ub.stk-tot WHERE ub.stk-tot.obj-type = v-cntxt-obj-type
     1709                                      AND ub.stk-tot.obj-code   = v-cntxt-obj-code
     1710                                      AND ub.stk-tot.Fact-date <= startdate - 1
     1711                                      AND ub.stk-tot.sum-type = (IF PayType = 2  then  'cost':U
     1712                                                                               else  'crsa':U )
     1713                                      AND ub.stk-tot.cat-id  = '##,##':U
     1714                                      USE-INDEX fact-date no-lock no-error.
     1715   If Available ub.stk-tot then Assign Fact-order-1 = ub.stk-tot.Fact-order
     1716                                    Quantity1    = ub.stk-tot.fact-qnty
     1717                                    Coast1       = ub.stk-tot.sum-rubl
     1718                                    Coast-vat1   = ub.stk-tot.vat-rubl
     1719                                    .
     1720                         Else Assign Fact-order-1 = 0
     1721                                    Quantity1    = 0
     1722                                    Coast1       = 0
     1723                                    Coast-vat1   = 0
     1724                                    .
     1725   FIND LAST ub.stk-tot WHERE ub.stk-tot.obj-type = v-cntxt-obj-type
     1726                                      AND ub.stk-tot.obj-code   = v-cntxt-obj-code
     1727                                      AND ub.stk-tot.Fact-date >= startdate
     1728                                      AND ub.stk-tot.Fact-date <= Enddate
     1729                                      AND ub.stk-tot.sum-type = (IF PayType = 2  then  'cost':U
     1730                                                                              else  'crsa':U )
     1731                                      AND ub.stk-tot.cat-id  = '##,##':U
     1732                                      USE-INDEX fact-date no-lock no-error.
     1733   If Available ub.stk-tot then Assign Fact-order-2 = ub.stk-tot.Fact-order .
     1734                        else Assign Fact-order-2 = 0.
     1735   FIND LAST ub.stk-tot WHERE ub.stk-tot.obj-type = v-cntxt-obj-type
     1736                                      AND ub.stk-tot.obj-code   = v-cntxt-obj-code
     1737                                      AND ub.stk-tot.Fact-date <= Enddate
     1738                                      AND ub.stk-tot.sum-type = (IF PayType = 2  then  'cost':U
     1739                                                                              else  'crsa':U )
     1740                                      AND ub.stk-tot.cat-id  = '##,##':U
     1741                                      USE-INDEX fact-date no-lock no-error.
     1742   If Available ub.stk-tot then Assign Quantity2    = ub.stk-tot.fact-qnty
     1743                                    Coast2       = ub.stk-tot.sum-rubl
     1744                                    Coast-vat2    = ub.stk-tot.vat-rubl
     1745                                    .
     1746                        else Assign Quantity2    = 0
     1747                                    Coast2       = 0
     1748                                    Coast-vat2   = 0
     1749                                    .
     1750   END PROCEDURE.
     1751   PROCEDURE disable_UI :
     1752     HIDE FRAME DLGOKCAN.
     1753   END PROCEDURE.
     1754   PROCEDURE enable_UI :
     1755     DISPLAY text2 startdate enddate CalcRest SET_PAY_TYPE COMBO-node
     1756         WITH FRAME DLGOKCAN.
     1757     ENABLE RECT-11 RECT-14 RECT-15 text2 startdate enddate CalcRest SET_PAY_TYPE
     1758            COMBO-node b-print b-help b-quit
     1759         WITH FRAME DLGOKCAN.
     1760   END PROCEDURE.
     1761   PROCEDURE Foreach :
     1762   For each ub.gds-grp where ub.gds-grp.upper-code = Rootgrp no-lock:
     1763     IF res <> 'все':U Then  If ub.gds-grp.node-code <> integer(res) then NEXT.
     1764       T-NAme-node = ub.gds-grp.node-name.
     1765       NAmenode = ub.gds-grp.node-name.
     1766       run u-line.
     1767       run printdetitogo.
     1768   For each ub.gds-obj where ub.gds-obj.grp-name begins ub.gds-grp.node-name
     1769                              AND ub.gds-obj.obj-code = v-cntxt-obj-code
     1770                              AND ub.gds-obj.obj-type = v-cntxt-obj-type no-lock:
     1771     run calc-itog-node.
     1772     run calc-itog-node-end .
     1773     For each ot-line-crsa
     1774                      where   ot-line-crsa.sum-type = 'crsa':U
     1775                             AND ot-line-crsa.fact-order >  fact-order-1
     1776                             AND ot-line-crsa.fact-order <= fact-order-2
     1777                             AND ot-line-crsa.obj-code   = v-cntxt-obj-code
     1778                             AND ot-line-crsa.obj-type   = v-cntxt-obj-type
     1779                             AND ot-line-crsa.prod-code  = ub.gds-obj.prod-code
     1780                             AND ot-line-crsa.prod-type  = ub.gds-obj.prod-type
     1781                             AND ot-line-crsa.artic      = ub.gds-obj.artic
     1782                             no-lock
     1783                             BREAK  BY ot-line-crsa.ext-doc-type  BY ot-line-crsa.doc-code  :
     1784                         Find  First ub.ot-line where
     1785                                 ub.ot-line.fact-order = ot-line-crsa.fact-order
     1786                             AND ub.ot-line.obj-code   = ot-line-crsa.obj-code
     1787                             AND ub.ot-line.obj-type   = ot-line-crsa.obj-type
     1788                             AND ub.ot-line.prod-code  = ot-line-crsa.prod-code
     1789                             AND ub.ot-line.prod-type  = ot-line-crsa.prod-type
     1790                             AND ub.ot-line.artic      = ot-line-crsa.artic
     1791                             and ub.ot-line.sum-type   =
     1792                              (IF PayType = 2  then  'cost':U  else  'sale':U )
     1793                             no-lock  no-error .
     1794                         Find  First ot-line-sale where
     1795                                 ot-line-sale.fact-order = ot-line-crsa.fact-order
     1796                             AND ot-line-sale.obj-code   = ot-line-crsa.obj-code
     1797                             AND ot-line-sale.obj-type   = ot-line-crsa.obj-type
     1798                             AND ot-line-sale.prod-code  = ot-line-crsa.prod-code
     1799                             AND ot-line-sale.prod-type  = ot-line-crsa.prod-type
     1800                             AND ot-line-sale.artic      = ot-line-crsa.artic
     1801                             and ot-line-sale.sum-type   = 'sale':U
     1802                             no-lock  no-error .
     1803         ii = ii + 1.
     1804   If Integer(25) = 0 Then Temp1  = 100  .
     1805                         Else Temp1 = Integer(25) .
     1806        IF ( ii modulo Temp1 = 0 ) AND ( ii >= Temp1 ) then
     1807            RUN waitfram-show( "Обработано строк : " + string( ii )) .
     1808      if available  ub.ot-line then do :
     1809         Accumulate ub.ot-line.fact-qnty      (TOTAL BY ot-line-crsa.doc-code).
     1810         Accumulate ub.ot-line.sum-rubl       (TOTAL BY ot-line-crsa.doc-code).
     1811         Accumulate ub.ot-line.VAT-rubl       (TOTAL BY ot-line-crsa.doc-code).
     1812         Accumulate ub.ot-line.SLT-rubl       (TOTAL BY ot-line-crsa.doc-code).
     1813         Accumulate ub.ot-line.other-rubl     (TOTAL BY ot-line-crsa.doc-code).
     1814         Quantity-Itog0 = Quantity-Itog0    + ub.ot-line.fact-qnty.
     1815         Coast-Itog0    = Coast-Itog0       + ub.ot-line.sum-rubl.
     1816         Coast-ItogVAT    = Coast-ItogVAt       + ub.ot-line.VAT-rubl.
     1817         Coast-ItogSLT    = Coast-ItogSLT       + ub.ot-line.SLT-rubl.
     1818         Coast-ItogOther  = Coast-ItogOther     + ub.ot-line.other-rubl.
     1819         End.
     1820         Accumulate ot-line-crsa.sum-rubl  (TOTAL BY ot-line-crsa.doc-code).
     1821         Coast-ItogCRSA    = Coast-ItogCRSA + ot-line-crsa.sum-rubl.
     1822      FIND First TDEDT where tdedt.id = ot-line-crsa.ext-doc-type no-error .
     1823      If LAST-OF (ot-line-crsa.doc-code) Then DO:
     1824         Find Last ub.trn-doc where ub.trn-doc.doc-code = ot-line-crsa.doc-code no-lock no-error.
     1825              If NOT Available ub.trn-doc then
     1826                 Find Last ub.price-doc where ub.price-doc.doc-num = ot-line-crsa.doc-code no-lock no-error.
     1827         Create Tmp.
     1828         Assign
     1829              Tmp.T-fact-date_   = If Available ub.trn-doc then  ub.trn-doc.fact-date Else (If Available ub.price-doc THEN ub.price-doc.fact-date ELSE DATE(''))
     1830              Tmp.T-cli-name_    = If Available ub.trn-doc then ub.trn-doc.cli-name Else ""
     1831              Tmp.T-NAme-node_   = ( If available tdedt then tdedt.n + tdedt.name else ( ot-line-crsa.ext-doc-type + ' нет в справочнике!'))
     1832              Tmp.T-doc-num_     = ot-line-crsa.doc-code.
     1833              Tmp.qnty_          = (Accum TOTAL BY ot-line-crsa.doc-code ub.ot-line.fact-qnty).
     1834              Tmp.SumSale_       = (Accum TOTAL BY ot-line-crsa.doc-code ub.ot-line.sum-rubl)  .
     1835              Tmp.SumVat_        = (Accum TOTAL BY ot-line-crsa.doc-code ub.ot-line.VAT-rubl).
     1836              Tmp.SumSLT_        = (Accum TOTAL BY ot-line-crsa.doc-code ub.ot-line.SLT-rubl).
     1837              Tmp.SumCrsa_       = (Accum TOTAL BY ot-line-crsa.doc-code ot-line-crsa.sum-rubl).
     1838              Tmp.SumDisc_       = (Accum TOTAL BY ot-line-crsa.doc-code ub.ot-line.other-rubl) .
     1839              Tmp.SumOv_         = Tmp.SumCrsa_ - Tmp.SumSale_ - Tmp.SumDisc_ .
     1840         if ot-line-crsa.ext-doc-type = 'rs':U or ot-line-crsa.ext-doc-type = 'es':U  tHEN do:
     1841            Assign  Tmp.T-NAme-node_   = "16" + "касса"
     1842                    Tmp.T-doc-num_     = Substring(ot-line-crsa.doc-code,1, LENGTH(trim(ot-line-crsa.doc-code)) - 1 ).
     1843            eND.
     1844        End.
     1845       End.
     1846      End.
     1847          For each tmp Break BY Tmp.T-NAme-node_ BY Tmp.T-doc-num_:
     1848                       Accumulate Tmp.qnty_        (TOTAL BY Tmp.T-doc-num_).
     1849                       Accumulate Tmp.SumSale_     (TOTAL BY Tmp.T-doc-num_).
     1850                       Accumulate Tmp.SumCrsa_     (TOTAL BY Tmp.T-doc-num_).
     1851                       Accumulate Tmp.Sumov_       (TOTAL BY Tmp.T-doc-num_).
     1852                       Accumulate Tmp.Sumdisc_     (TOTAL BY Tmp.T-doc-num_).
     1853                       Accumulate Tmp.SumVat_      (TOTAL BY Tmp.T-doc-num_).
     1854                       Accumulate Tmp.SumSLT_      (TOTAL BY Tmp.T-doc-num_).
     1855                       Accumulate Tmp.qnty_        (TOTAL BY Tmp.T-NAme-node_).
     1856                       Accumulate Tmp.SumSale_     (TOTAL BY Tmp.T-NAme-node_).
     1857                       Accumulate Tmp.SumVat_      (TOTAL BY Tmp.T-NAme-node_).
     1858                       Accumulate Tmp.SumSLT_      (TOTAL BY Tmp.T-NAme-node_).
     1859                       Accumulate Tmp.SumCrsa_     (TOTAL BY Tmp.T-NAme-node_).
     1860                       Accumulate Tmp.Sumov_       (TOTAL BY Tmp.T-NAme-node_).
     1861                       Accumulate Tmp.Sumdisc_     (TOTAL BY Tmp.T-NAme-node_).
     1862               If FIRST-OF (Tmp.T-NAme-node_) Then DO:
     1863                 Assign
     1864                      T-NAme-node   = ''
     1865                      T-doc-num     = ''
     1866                      T-fact-date   = Date('')
     1867                      T-cli-name    = Substring(Tmp.T-NAme-node_,3)
     1868                      qnty          = 0
     1869                      SumSale       = 0
     1870                      SumCrsa       = 0
     1871                      SumDisc       = 0
     1872                      Sumov         = 0
     1873                      SumVat        = 0
     1874                      SumSLT        = 0   .
     1875                      run printdetitogo.
     1876                   End.
     1877              If LAST-OF (Tmp.T-doc-num_) Then DO:
     1878                  Assign
     1879                      T-NAme-node   = ''
     1880                      T-doc-num     = Tmp.T-doc-num_
     1881                      T-fact-date   = Tmp.T-fact-date_
     1882                      T-cli-name    = Tmp.T-cli-name_
     1883                      qnty          = (Accum TOTAL BY Tmp.T-doc-num_ Tmp.qnty_)
     1884                      SumSale    = (Accum TOTAL BY Tmp.T-doc-num_ Tmp.SumSale_)
     1885                      SumCrsa    = (Accum TOTAL BY Tmp.T-doc-num_ Tmp.SumCrsa_)
     1886                      SumOv      = (Accum TOTAL BY Tmp.T-doc-num_ Tmp.SumOv_)
     1887                      SumDisc    = (Accum TOTAL BY Tmp.T-doc-num_ Tmp.SumDisc_)
     1888                      SumVat     = (Accum TOTAL BY Tmp.T-doc-num_ Tmp.SumVat_)
     1889                      SumSLT     = (Accum TOTAL BY Tmp.T-doc-num_ tmp.SumSLT_).
     1890                      if PayType = 2 then DO:
     1891                      if NOT (qnty  = 0 and  SumSale = 0 )  then
     1892                                  run printdetaile2.
     1893                                  End.
     1894                      Else do:
     1895                      if NOT (qnty  = 0 and  SumSale = 0  and  SumCRSA = 0)  then
     1896                                  run printdetaile2.
     1897                                  End.
     1898                End.
     1899                If LAST-OF (Tmp.T-NAme-node_) Then DO:
     1900                 Assign
     1901                      T-NAme-node = ''
     1902                      T-doc-num   = ''
     1903                      T-fact-date = Date('')
     1904                      T-cli-name  = "Итого по типу " + Substring(Tmp.T-NAme-node_,3)
     1905                      qnty       = (Accum TOTAL BY Tmp.T-NAme-node_ Tmp.qnty_)
     1906                      SumSale    = (Accum TOTAL BY Tmp.T-NAme-node_ Tmp.SumSale_)
     1907                      SumCrsa    = (Accum TOTAL BY Tmp.T-NAme-node_ Tmp.SumCrsa_)
     1908                      SumOv      = (Accum TOTAL BY Tmp.T-NAme-node_ Tmp.SumOv_)
     1909                      SumDisc    = (Accum TOTAL BY Tmp.T-NAme-node_ Tmp.SumDisc_)
     1910                      SumVat     = (Accum TOTAL BY Tmp.T-NAme-node_ Tmp.SumVat_)
     1911                      SumSLT     = (Accum TOTAL BY Tmp.T-NAme-node_ tmp.SumSLT_).
     1912                      run printdetaile2.
     1913                      run p-line.
     1914                End.
     1915          End.
     1916       For each tmp: delete tmp. end.
     1917       run itog0.
     1918     End .
     1919   END PROCEDURE.
     1920   PROCEDURE Itog0 :
     1921     run itog0start.
     1922         Assign
     1923              T-NAme-node = trim(NAmenode) + "   ИТОГО оборот"
     1924              T-doc-num     = ''
     1925              T-fact-date = Date('')
     1926              T-cli-name    =''
     1927              qnty       = Quantity-Itog0
     1928              SumSale    = Coast-Itog0
     1929              SumCrsa    = Coast-ItogCRSA
     1930              SumDisc    = Coast-ItogOther
     1931              SumOv      = Coast-ItogCRSA - Coast-Itog0 -  Coast-ItogOther
     1932              SumVat     = Coast-ItogVAt
     1933              SumSLT     = Coast-ItogSLT                .
     1934              run print-o.
     1935              Quantity-Itog0 = 0 .
     1936              Coast-Itog0    = 0 .
     1937              Coast-ItogCRSA = 0 .
     1938              Coast-ItogOther = 0 .
     1939              Coast-ItogVAT   = 0 .
     1940              Coast-ItogSLT   = 0 .
     1941   if CalcRest then
     1942       do:
     1943          Assign
     1944              T-NAme-node = string( "   Остаток на конец периода (" + string( enddate, "99/99/9999" ) + ")" )
     1945              T-doc-num     = ''
     1946              T-fact-date = Date('')
     1947              T-cli-name    =''
     1948              qnty          = Quantity3
     1949              SumSale       = Coast3
     1950              SumCrsa       = CoastCRSA
     1951              SumDisc       = 0
     1952              SumOv         = 0
     1953              SumVat        = coast-vat
     1954              SumSLT        = CoastSLT               .
     1955              run printdetaile2.
     1956       end.
     1957       Quantity3 = 0 .
     1958       Coast3    = 0 .
     1959       CoastCRSA = 0 .
     1960       coast-vat = 0 .
     1961       CoastSLT = 0 .
     1962   END PROCEDURE.
     1963   PROCEDURE Itog0Start :
     1964   if CalcRest then
     1965       do:
     1966          Assign
     1967              T-NAme-node = string( "   Остаток на начало периода(" + string( startdate, "99/99/9999" ) + ")" )
     1968              T-doc-num     = ''
     1969              T-fact-date = Date('')
     1970              T-cli-name    =''
     1971              qnty          = Quantity3-1
     1972              SumSale       = Coast3-1
     1973              SumCrsa       = CoastCRSA-1
     1974              SumVat        = coast-vat3-1
     1975              SumDisc       = 0
     1976              SumOv         = 0
     1977              SumSLT        = COASTSLT-1     .
     1978              run printdetaile2.
     1979       end.
     1980       Quantity3-1 = 0 .
     1981       Coast3-1    = 0 .
     1982       CoastCRSA-1 = 0 .
     1983       coast-vat3-1  = 0 .
     1984       CoastSLT-1  = 0 .
     1985   END PROCEDURE.
     1986   PROCEDURE main-proc :
     1987   run maketemptabl.
     1988   define variable last_day as integer no-undo .
     1989   define variable firstdate as date no-undo .
     1990   define variable m-str as char no-undo .
     1991   define variable doc_str   as char no-undo.
     1992   define variable doc_str1 as char no-undo.
     1993   Line = fill("-", 214).
     1994   assign frame DLGOKCAN
     1995       CalcRest Enddate startdate Set_Pay_Type combo-node.
     1996   assign
     1997       II=0
     1998       tot-qnty     = 0
     1999       tot-doc-sum  = 0
     2000       tot-cost-sum = 0
     2001       tot-sale-sum = 0
     2002       .
     2003   run nsum.
     2004   FIND ub.clients WHERE ub.clients.obj-type = v-cntxt-obj-type
     2005                                      AND ub.clients.obj-code = v-cntxt-obj-code
     2006                                      NO-LOCK .
     2007   run waitfram-show ( 'Подождите ...' ) .
     2008   output STREAM OutStream to value( string( session:temp-directory +
     2009                                        "rpt" + string( g#report-num ) ) )
     2010                                        page-size  value(43) .
     2011   if PayType = 2 then
     2012      FORM with FRAME DocsRep-cost .
     2013      Else
     2014      FORM with FRAME DocsRep .
     2015   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2016   form header
     2017     line format "X(197)" at 1 skip
     2018     "Продолжение - на следующей странице" at 30 skip
     2019     with frame bottomframe width 232 page-bottom no-labels no-box .
     2020   view stream outstream frame bottomframe .
     2021    run calcitog.
     2022    run printheader.
     2023   if paytype = 2 then
     2024      form with frame docsrep-cost .
     2025      else
     2026      form with frame docsrep .
     2027     run foreach.
     2028     hide stream outstream frame bottomframe .
     2029     run printfooter.
     2030     if paytype = 2 then
     2031     hide stream outstream frame docsrep-cost .
     2032     else hide stream outstream frame docsrep .
     2033     output stream outstream close.
     2034     run waitfram-hide .
     2035   define variable v-user-action as character no-undo .
     2036   define variable v-printed as logical   no-undo .
     2037   define variable DisabledOptions as integer   no-undo .
     2038   DisabledOptions = 8.
     2039   run gbl/prnfilen.w
     2040     (input  ""
     2041     ,input  DisabledOptions
     2042     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2043     ,input  7
     2044     ,output v-user-action
     2045     ,output v-printed
     2046     ) .
     2047   END PROCEDURE.
