     4207                             ,input parameter-6-35
     4208                             ,input parameter-7-35
     4209                             ,output v-fltopend-rowid
     4210                             ) no-error.
     4211         .
     4212         doc-rec = ?.
     4213       end.
     4214       assign
     4215         l-query-was-opened = true
     4216       .
     4217     end.
     4218   end.
     4219       END.
     4220   END CASE.
     4221   if not p-open-query then
     4222     REPOSITION br-docs to recid doc-rec No-ERROR.
     4223   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4224   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4225   apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame  .
     4226     end.
     4227   END PROCEDURE.
     4228   PROCEDURE ord-close :
     4229    do
     4230    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4231    :
     4232   define input parameter p-loc-recid as recid no-undo .
     4233   message "Закрыть заказ ?"
     4234   view-as alert-box question
     4235   buttons yes-no
     4236   update g-log.
     4237   if g-log = false then return no-apply.
     4238     run cus/ordoocls.p
     4239       ( input parParentProc ,
     4240         input p-loc-recid ,
     4241         input true
     4242       ) no-error .
     4243     if error-status :error then do:
     4244     message vss-workfile vss-revision vss-description skip
     4245            "Ошибка ordoocls.p " skip
     4246             skip
     4247             error-status :get-message(1) skip
     4248             return-value skip
     4249             view-as alert-box error
     4250     .
     4251     return error .
     4252     end.
     4253     else do:
     4254       run OpenBr in this-procedure (yes, no, '':U).
     4255     end.
     4256     end.
     4257   END PROCEDURE.
     4258   PROCEDURE ord-del :
     4259    do
     4260    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4261    :
     4262   define input parameter p-loc-recid as recid no-undo .
     4263   find current buf-oo_ord-doc  exclusive-lock    no-error .
     4264   if not available buf-oo_ord-doc  then return .
     4265   define variable g-log as log no-undo.
     4266   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4267   do:
     4268     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4269       (input  v-cntxt-db-num
     4270       ,input  v-cntxt-userid
     4271       ,input  0
     4272       ,input  'actn_o-o_deletion':U
     4273       ,input  'object':U
     4274       ,input  buf-oo_ord-doc.host-code
     4275       ,input  buf-oo_ord-doc.obj-type
     4276       ,input  buf-oo_ord-doc.obj-code
     4277       ,input  0
     4278       ,input  0
     4279       ,input  0
     4280       ,input  true
     4281       ,output g-log
     4282       )  .
     4283   end.
     4284   if not g-log then  return .
     4285   if  buf-oo_ord-doc.status_ = 'факт':U  then do:
     4286       message "Заказ в статусе ФАКТ не может быть удален !!!"
     4287       view-as alert-box information .
     4288       return error .
     4289   end.
     4290   message "Удалить запись ?"
     4291   view-as alert-box question
     4292   buttons yes-no
     4293   update g-log.
     4294   if g-log = false then return no-apply.
     4295   delete buf-oo_ord-doc .
     4296   run openbr in this-procedure (yes, no, '':u).
     4297     end.
     4298   END PROCEDURE.
