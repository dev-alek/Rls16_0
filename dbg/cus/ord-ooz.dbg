     1102   DEFINE BUTTON B-close-trn
     1103        LABEL "Закр&ыть"
     1104        SIZE 10 BY 1 TOOLTIP "Закрыть накладную".
     1105   DEFINE BUTTON b-del
     1106        LABEL "&Удалить":L
     1107        SIZE 12 BY 1 TOOLTIP "Удалитиь заказ".
     1108   DEFINE BUTTON b-help
     1109        LABEL "Помо&щь":L
     1110        SIZE 3 BY 1.
     1111   DEFINE BUTTON b-history
     1112        LABEL "&История":L
     1113        SIZE 3 BY 1 TOOLTIP "История заказа".
     1114   DEFINE BUTTON b-lkp
     1115        LABEL "&Просмотр":L
     1116        SIZE 12 BY 1 TOOLTIP "Просмотр заказа без корректировки".
     1117   DEFINE BUTTON B-lkp-2
     1118        LABEL "Просмо&тр"
     1119        SIZE 10 BY 1 TOOLTIP "Просмотр запроса".
     1120   DEFINE BUTTON b-mark
     1121        LABEL "&*":L
     1122        SIZE 3 BY 1.
     1123   DEFINE BUTTON b-move
     1124        LABEL "Р&аспределить":L
     1125        SIZE 16.8 BY 1 TOOLTIP "Сформировать заявки по заказам".
     1126   DEFINE BUTTON b-move-to
     1127        LABEL "Отправить":L
     1128        SIZE 16.8 BY 1 TOOLTIP "Перенаправить заказ новый+ на распределение".
     1129   DEFINE BUTTON b-open
     1130        LABEL "&Открыть":L
     1131        SIZE 12 BY 1 TOOLTIP "Открыть запр+ до запр-".
     1132   DEFINE BUTTON b-print
     1133        LABEL "Пе&чать":L
     1134        SIZE 3 BY 1 TOOLTIP "Печать заказа".
     1135   DEFINE BUTTON b-quit AUTO-GO
     1136        LABEL "&Выход ":L
     1137        SIZE 12 BY 1 TOOLTIP "Выход из режима".
     1138   DEFINE BUTTON B-rez
     1139        LABEL "Резе&рв"
     1140        SIZE 10 BY 1 TOOLTIP "Создать расходный запрос у контрагента".
     1141   DEFINE BUTTON b-sch
     1142        LABEL "&Фильтр":L
     1143        SIZE 3 BY 1 TOOLTIP "Фильтр по списку заказов".
     1144   DEFINE BUTTON b-sel
     1145        LABEL "Вы&бор ":L
     1146        SIZE 12 BY 1 TOOLTIP "Выход из режима и выбор текущего номера  заказа".
     1147   DEFINE VARIABLE loc-ps AS CHARACTER
     1148        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1149        SIZE 94.6 BY 1.76 TOOLTIP "Примечание"
     1150        FGCOLOR 4 NO-UNDO.
     1151   DEFINE VARIABLE loc-agnt AS CHARACTER FORMAT "X(256)":U
     1152        LABEL "Исп"
     1153         VIEW-AS TEXT
     1154        SIZE 17.2 BY .67
     1155        FGCOLOR 4  NO-UNDO.
     1156   DEFINE VARIABLE loc-boss AS CHARACTER FORMAT "X(256)":U
     1157        LABEL "М-р"
     1158         VIEW-AS TEXT
     1159        SIZE 17.2 BY .67
     1160        FGCOLOR 4  NO-UNDO.
     1161   DEFINE VARIABLE loc-creid AS CHARACTER FORMAT "X(256)":U
     1162        LABEL "Создал"
     1163         VIEW-AS TEXT
     1164        SIZE 14 BY .67
     1165        FGCOLOR 4  NO-UNDO.
     1166   DEFINE VARIABLE loc-wrkr AS CHARACTER FORMAT "X(256)":U
     1167        LABEL "Кл-к"
     1168         VIEW-AS TEXT
     1169        SIZE 17.2 BY .67
     1170        FGCOLOR 4  NO-UNDO.
     1171   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "x(12)"
     1172        LABEL "&Начало номера"
     1173        VIEW-AS FILL-IN
     1174        SIZE 12 BY 1 NO-UNDO.
     1175   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999"
     1176        LABEL "Д&ата"
     1177        VIEW-AS FILL-IN
     1178        SIZE 12 BY 1 NO-UNDO.
     1179   DEFINE VARIABLE sch-fact AS DATE FORMAT "99/99/9999"
     1180        LABEL "Фа&кт"
     1181        VIEW-AS FILL-IN
     1182        SIZE 12 BY 1 NO-UNDO.
     1183   DEFINE VARIABLE sch-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1184         VIEW-AS TEXT
     1185        SIZE 14 BY .67 NO-UNDO.
     1186   DEFINE new shared QUERY br-docs FOR
     1187         buf-oo_ord-doc SCROLLING.
     1188   DEFINE QUERY br-zapr FOR
     1189         buf-oo_ord-doc-rcv,
     1190         ord-chain,
     1191         buf-oo_trn-doc SCROLLING.
     1192   DEFINE BROWSE br-docs
     1193     QUERY  br-docs NO-LOCK DISPLAY
     1194         mark-string(recid(ub.buf-oo_ord-doc), rid-list) COLUMN-LABEL '*' FORMAT "X(1)"
     1195         buf-oo_ord-doc.status_ COLUMN-LABEL 'Статус' Format "X(6)"
     1196         buf-oo_ord-doc.flag_ COLUMN-LABEL 'OK' format "+/-"
     1197         buf-oo_ord-doc.doc-code COLUMN-LABEL '№ док-та' Format "X(9)"
     1198         buf-oo_ord-doc.doc-date COLUMN-LABEL 'Создан' FORMAT "99/99/99"
     1199         buf-oo_ord-doc.fact-date COLUMN-LABEL 'Факт' FORMAT "99/99/99"
     1200         buf-oo_ord-doc.ship-date COLUMN-LABEL 'Поставка' FORMAT "99/99/99"
     1201         buf-oo_ord-doc.obj-code COLUMN-LABEL 'Объект' format ">>>>>9"
     1202         buf-oo_ord-doc.obj-type COLUMN-LABEL 'Тип' format "x(3)"
     1203         buf-oo_ord-doc.out-code COLUMN-LABEL 'Нераспред.!остаток' Format "X(9)"
     1204         buf-oo_ord-doc.qnty COLUMN-LABEL 'Количество'
     1205         buf-oo_ord-doc.sum-rubl COLUMN-LABEL 'Сумма в руб.' format ">,>>>,>>>,>>9.99"
     1206         f-direct(recid( ub.buf-oo_ord-doc)) COLUMN-LABEL '>' format "x(1)"
     1207         buf-oo_ord-doc.ship-date COLUMN-LABEL 'Поставка' FORMAT "99/99/99"
     1208     ENABLE
     1209          buf-oo_ord-doc.status_
     1210       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.4 BY 9.81
     1211            BGCOLOR 15 .
     1212   DEFINE BROWSE br-zapr
     1213     QUERY br-zapr NO-LOCK DISPLAY
     1214         buf-oo_trn-doc.doc-code
     1215         buf-oo_trn-doc.doc-type FORMAT "X(3)"
     1216         buf-oo_trn-doc.status_ COLUMN-LABEL "Стат" FORMAT "X(4)"
     1217         buf-oo_trn-doc.flag_ COLUMN-LABEL "Ок" FORMAT "+/-"
     1218         buf-oo_trn-doc.cli-type + string(buf-oo_trn-doc.cli-code)  COLUMN-LABEL "Контрагент"
     1219         buf-oo_trn-doc.obj-type + string(buf-oo_trn-doc.obj-code)  COLUMN-LABEL "Объект"
     1220         buf-oo_trn-doc.doc-date
     1221         buf-oo_trn-doc.fact-date
     1222         buf-oo_trn-doc.tot-lines
     1223         buf-oo_trn-doc.fact-qnty COLUMN-LABEL "Количество" FORMAT ">>>>>>>>9.<<<"
     1224         buf-oo_trn-doc.tot-rubl  COLUMN-LABEL "Сумма руб." FORMAT ">>>>>>>>>9.99"
     1225       WITH NO-ROW-MARKERS SEPARATORS SIZE 94.8 BY 5.57.
     1226   DEFINE FRAME Dialog-Frame
     1227        b-quit AT ROW 1 COL 2
     1228        b-sel AT ROW 1 COL 14
     1229        b-close AT ROW 1 COL 26
     1230        b-open AT ROW 1 COL 38
     1231        b-move-to AT ROW 1 COL 50
     1232        b-sch AT ROW 1 COL 87
     1233        b-history AT ROW 1 COL 90
     1234        b-help AT ROW 1 COL 93
     1235        b-mark AT ROW 2 COL 2
     1236        b-add AT ROW 2 COL 5
     1237        b-lkp AT ROW 2 COL 14
     1238        b-chg AT ROW 2 COL 26
     1239        b-del AT ROW 2 COL 38
     1240        b-move AT ROW 2 COL 50
     1241        b-print AT ROW 2 COL 93
     1242        sch-code AT ROW 3.1 COL 26 COLON-ALIGNED
     1243        sch-date AT ROW 3.1 COL 47 COLON-ALIGNED
     1244        sch-fact AT ROW 3.1 COL 65.8 COLON-ALIGNED
     1245        br-docs AT ROW 4.19 COL 1
     1246        loc-ps AT ROW 15.1 COL 1.6 NO-LABEL WIDGET-ID 6
     1247        B-lkp-2 AT ROW 16.95 COL 1
     1248        B-close-trn AT ROW 16.95 COL 11
     1249        B-rez AT ROW 16.95 COL 21
     1250        br-zapr AT ROW 18.14 COL 1.6
     1251        sch-num AT ROW 3.24 COL 80.4 COLON-ALIGNED NO-LABEL
     1252        loc-boss AT ROW 14.38 COL 4.6 COLON-ALIGNED
     1253        loc-agnt AT ROW 14.38 COL 27.8 COLON-ALIGNED
     1254        loc-wrkr AT ROW 14.38 COL 53 COLON-ALIGNED
     1255        loc-creid AT ROW 14.38 COL 80.4 COLON-ALIGNED
     1256        " Поиск по:" VIEW-AS TEXT
     1257             SIZE 10.2 BY .67 AT ROW 3.24 COL 1.6
     1258             BGCOLOR 3 FGCOLOR 15
     1259        SPACE(84.59) SKIP(19.79)
     1260       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1261            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1262            TITLE "Список заказов ОО".
     1263   ASSIGN
     1264          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1265          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1266   ASSIGN
     1267          B-close-trn:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1268   ASSIGN
     1269          B-rez:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1270   ASSIGN
     1271          br-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     1272   ASSIGN
     1273          loc-ps:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1274   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1275   DO:
     1276     APPLY "END-ERROR":U TO SELF.
     1277   END.
     1278   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1279   DO:
     1280     run proc-add in this-procedure .
     1281   END.
     1282   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1283   DO:
     1284   if not available buf-oo_ord-doc then return.
     1285   do on stop undo, return no-apply :
     1286     find current buf-OO_ord-doc exclusive-lock.
     1287   end.
     1288    define variable rr as recid no-undo .
     1289   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1290   do:
     1291     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1292       (input  v-cntxt-db-num
     1293       ,input  v-cntxt-userid
     1294       ,input  0
     1295       ,input  'actn_o-o_update':U
     1296       ,input  'object':U
     1297       ,input  buf-oo_ord-doc.host-code
     1298       ,input  buf-oo_ord-doc.obj-type
     1299       ,input  buf-oo_ord-doc.obj-code
     1300       ,input  0
     1301       ,input  0
     1302       ,input  0
     1303       ,input  true
     1304       ,output g-log
     1305       )  .
     1306   end.
     1307    if not g-log then  return .
     1308      if not( buf-oo_ord-doc.status_ = 'новый':U and buf-oo_ord-doc.flag_ = false ) then do:
     1309         message "Нельзя корректировать заказ! " view-as alert-box  .
     1310         return.
     1311     end.
     1312    rr = recid(buf-oo_ord-doc) .
     1313       run cus/ord-oou.w (
     1314       input parParentProc ,
     1315       input 'ИЗМЕНЕНИЕ':U ,
     1316       input-output rr  ,
     1317       input-output br-handle ,
     1318       input-output next-prev ) .
     1319     v-doc-rec = rr .
     1320     g#log =  br-docs:refresh() .
     1321     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1322     apply "entry" TO BR-docs IN FRAME Dialog-Frame.
     1323   END.
     1324   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     1325   DO:
     1326     define variable rr as recid no-undo .
     1327     if not available buf-oo_ord-doc then return.
     1328     rr = recid(buf-oo_ord-doc) .
     1329     run ord-close in this-procedure (recid(buf-oo_ord-doc)) .
     1330     run openbr in this-procedure ( yes, no, '':u).
     1331     reposition br-docs to recid rr no-error.
     1332     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1333     apply "entry" TO BR-docs IN FRAME Dialog-Frame.
     1334   END.
     1335   ON CHOOSE OF B-close-trn IN FRAME Dialog-Frame
     1336   DO:
     1337    if not available buf-oo_trn-doc   then return.
     1338    message "Закрыть внутренний запрос ?"
     1339     view-as alert-box question
     1340     buttons yes-no
     1341     update g-log.
     1342     if g-log = false then return no-apply.
     1343     if not (buf-oo_trn-doc.status_  = 'запрос':U   ) then do:
     1344       message "Закрыть можно только ЗАПР !"
     1345               view-as alert-box information .
     1346       return no-apply.
     1347     end.
     1348     run close-zapr in this-procedure (buf-oo_trn-doc.doc-code) .
     1349     OPEN QUERY br-zapr FOR EACH buf-oo_ord-doc-rcv WHERE                   buf-oo_ord-doc-rcv.doc-code = buf-oo_ord-doc.doc-code NO-LOCK,            each ub.ord-chain no-lock where             ub.ord-chain.doc-code = buf-oo_ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and             ub.ord-chain.rel-doc-type = 'trn'    ,              EACH buf-oo_trn-doc  where                  buf-oo_trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK.
     1350   END.
     1351   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1352   DO:
     1353     if not available buf-oo_ord-doc then return.
     1354     do on stop undo, return no-apply :
     1355       find current buf-OO_ord-doc exclusive-lock .
     1356     end.
     1357     if not( buf-oo_ord-doc.status_ = 'новый':U and buf-oo_ord-doc.flag_ = false ) then do:
     1358       message "Нельзя удалять заказ ! " view-as alert-box  .
     1359       return .
     1360     end.
     1361     run ord-del in this-procedure ( recid(buf-oo_ord-doc)) .
     1362   END.
     1363   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1364   DO:
     1365   if not available buf-oo_ord-doc then return .
     1366       run cus/ordcdoc.w
     1367       (
     1368       parParentProc,
     1369       buf-oo_ord-doc.host-code,
     1370       buf-oo_ord-doc.doc-code,
     1371       "" ) .
     1372   END.
     1373   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1374   DO:
     1375    define variable rr as recid no-undo .
     1376    rr = recid(buf-oo_ord-doc) .
     1377         br-handle = br-docs:handle in frame Dialog-Frame .
     1378         next-prev = no.
     1379         do while next-prev <> ?:
     1380           if not available buf-oo_ord-doc then do:
     1381             message "Неправильный выбор документа.".
     1382             return no-apply.
     1383           end.
     1384       run cus/ord-oou.w (
     1385           input parParentProc ,
     1386           input 'ПРОСМОТР':U ,
     1387           input-output rr  ,
     1388           input-output br-handle ,
     1389           input-output next-prev ) .
     1390             v-doc-rec = rr .
     1391           if br-handle = ? then reposition br-docs to recid rr no-error.
     1392         end.
     1393   apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1394   END.
     1395   ON CHOOSE OF B-lkp-2 IN FRAME Dialog-Frame
     1396   DO:
     1397      if available buf-oo_trn-doc then
     1398         run str/showdoc.p
     1399             (input parparentproc
     1400             ,input buf-oo_trn-doc.doc-code
     1401             ,input ""
     1402             ,input ""
     1403             ,input 0
     1404             ,input true
     1405             ) no-error .
     1406             if error-status :error then message
     1407               vss-workfile vss-revision vss-description skip
     1408               error-status :get-message(1) skip
     1409               return-value skip
     1410               "Ошибка из showdoc.p"
     1411               view-as alert-box error
     1412             .
     1413   END.
     1414   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1415   DO:
     1416       if available buf-oo_ord-doc then do:
     1417   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1418   define variable v-str-recid17 as character no-undo .
     1419   define variable v-num-entry17 as integer   no-undo .
     1420   assign
     1421     v-str-recid17 = trim( string( recid( buf-oo_ord-doc ) , "->>>>>>>>>>>9":U ) )
     1422     v-num-entry17 = lookup( v-str-recid17 , rid-list )
     1423   .
     1424   if v-num-entry17 > 0 then do:
     1425     assign
     1426       entry( v-num-entry17, rid-list ) = "":U
     1427       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1428     .
     1429   end.
     1430   else do:
     1431     assign
     1432       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1433     .
     1434   end.
     1435       g-log = br-docs:refresh() .
     1436       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1437           g-log = br-docs:select-next-row ().
     1438           apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1439       end.
     1440   end.
     1441   apply "entry" to br-docs in frame Dialog-Frame.
     1442   END.
     1443   ON CHOOSE OF b-move IN FRAME Dialog-Frame
     1444   DO:
     1445   if not available buf-oo_ord-doc then return.
     1446   if not( buf-oo_ord-doc.status_ = 'запрос':U and
     1447          buf-oo_ord-doc.flag_ = false  )  then do :
     1448           Message
     1449             "Нельзя распределять  заказ в статусе " caps(buf-oo_ord-doc.status_) + string(buf-oo_ord-doc.flag_,"+/-") skip
     1450             "Документ" buf-oo_ord-doc.doc-code view-as alert-box information
     1451             .
     1452           return.
     1453         end.
     1454    if v-cntxt-db-num = 0 and buf-oo_ord-doc.order-type = 3 then do:
     1455           Message
     1456             "Распределение заказа указано в Удаленной БД!" skip
     1457             "Документ" buf-oo_ord-doc.doc-code view-as alert-box information
     1458             .
     1459           return.
     1460     end.
     1461    if v-cntxt-db-num <> 0 and buf-oo_ord-doc.order-type = 2 then do:
     1462           Message
     1463             "Распределение заказа указано в Главной БД!"   skip
     1464             "Документ" buf-oo_ord-doc.doc-code view-as alert-box information
     1465             .
     1466           return.
     1467     end.
     1468    define variable rr as recid no-undo .
     1469   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1470   do:
     1471     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1472       (input  v-cntxt-db-num
     1473       ,input  v-cntxt-userid
     1474       ,input  0
     1475       ,input  'actn_o-o_add-def':U
     1476       ,input  'object':U
     1477       ,input  buf-oo_ord-doc.host-code
     1478       ,input  buf-oo_ord-doc.obj-type
     1479       ,input  buf-oo_ord-doc.obj-code
     1480       ,input  0
     1481       ,input  0
     1482       ,input  0
     1483       ,input  true
     1484       ,output g-log
     1485       )  .
     1486   end.
     1487    if not g-log then  return .
     1488       rr = recid(buf-oo_ord-doc) .
     1489       message "Распределить заказ автоматически ?"
     1490           view-as alert-box question
     1491           buttons yes-no
     1492           update g-log.
     1493           if g-log = true then do:
     1494               run cus/ord-ooam.p
     1495                   ( input parParentProc ,
     1496                     input-output rr ) .
     1497               v-doc-rec = rr .
     1498           end.
     1499           else do:
     1500               run cus/ord-oorm.w
     1501                  ( input parParentProc ,
     1502                    input-output rr ) .
     1503               v-doc-rec = rr .
     1504           end.
     1505     run openbr in this-procedure ( yes, no, '':u).
     1506     reposition br-docs to recid rr no-error.
     1507     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1508     apply "entry" TO BR-docs IN FRAME Dialog-Frame.
     1509   END.
     1510   ON CHOOSE OF b-move-to IN FRAME Dialog-Frame
     1511   DO:
     1512   if not available buf-oo_ord-doc then return.
     1513   if not( buf-oo_ord-doc.status_ = 'новый':U  and
     1514          buf-oo_ord-doc.flag_ = yes )  then do :
     1515           Message
     1516             "Нельзя перенаправить распределять  заказ в статусе "
     1517             caps(buf-oo_ord-doc.status_) + string(buf-oo_ord-doc.flag_,"+/-") skip
     1518             "Документ" buf-oo_ord-doc.doc-code view-as alert-box information
     1519             .
     1520           return.
     1521         end.
     1522    if v-cntxt-db-num = 0 and buf-oo_ord-doc.order-type = 3 then do:
     1523           Message
     1524             "Распределение заказа уже указано в Удаленной БД!" skip
     1525             "Изменить нельзя." skip
     1526             "Документ" buf-oo_ord-doc.doc-code view-as alert-box information
     1527             .
     1528           return.
     1529     end.
     1530    if v-cntxt-db-num <> 0 and buf-oo_ord-doc.order-type = 2 then do:
     1531           Message
     1532             "Распределение заказа уже указано в Главной БД!"   skip
     1533             "Изменить нельзя." skip
     1534             "Документ" buf-oo_ord-doc.doc-code view-as alert-box information
     1535             .
