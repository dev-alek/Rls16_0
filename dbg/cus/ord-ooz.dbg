      893   FUNCTION mark-string RETURNS CHARACTER
      894     ( input p-recid as recid, input mark-list as character  ) :
      895     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      896   END FUNCTION.
      897   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      899   procedure fltopend_fltopend :
      900   define input parameter p-parent-handle as handle no-undo .
      901   define input parameter p-qh as handle no-undo .
      902   define input parameter p-flt-open-open-query  as character no-undo .
      903   define input parameter p-where-cond as character no-undo .
      904   define input parameter p-use-indFIRST-query-tail as character no-undo .
      905   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      906   define input parameter p-indexed-reposition as character no-undo .
      907     do
      908     on error undo, return error
      909     :
      910   define variable v-prepare-string as character no-undo .
      911   define variable glog as logical no-undo .
      912   assign
      913   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      914                      p-where-cond + chr(32)  +
      915                      p-use-indFIRST-query-tail + chr(32) +
      916                      p-use-ind-sort-clmn-by + chr(32) +
      917                      p-indexed-reposition
      918   .
      919   assign
      920   glog = p-qh:query-prepare(v-prepare-string) no-error .
      921   if not glog
      922   or error-status:error then do:
      923     message error-status:get-message(1) view-as alert-box .
      924     undo, return error .
      925   end.
      926   assign
      927   glog = p-qh:query-open no-error .
      928   if not glog
      929   or error-status:error then do:
      930     message error-status:get-message(1) view-as alert-box .
      931     undo, return error .
      932   end.
      933     end.
      934   end procedure.
      935   procedure fltopend_fltfindd :
      936   define input parameter p-parent-handle as handle no-undo .
      937   define input parameter p-qh as handle no-undo .
      938   define input parameter p-rowid as rowid no-undo .
      939   define input parameter p-next as logical no-undo .
      940   define input parameter p-lock as integer no-undo .
      941   define input parameter p-bh as handle no-undo .
      942   define input parameter p-where-cond as character no-undo .
      943   define input parameter p-use-index-phrase as character no-undo .
      944   define variable glog as logical no-undo .
      945   define variable v-qh as handle no-undo .
      946   define variable v-bh as handle no-undo .
      947   define variable v-recid as recid no-undo .
      948   define variable v-prepare-string as character no-undo .
      949   do
      950   on error undo, return error
      951   on stop undo, return error
      952   :
      953     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      954     create buffer v-bh for table p-bh buffer-name p-bh:name.
      955     create query v-qh.
      956     v-qh:set-buffers(v-bh).
      957     v-prepare-string = substitute("for each &1 &2 &3"
      958                                     ,v-bh:name
      959                                     ,p-where-cond
      960                                     ,p-use-index-phrase).
      961     glog = v-qh:query-prepare(v-prepare-string) no-error.
      962     if not glog then do:
      963       delete object v-qh.
      964       delete object v-bh.
      965       undo, return error .
      966     end.
      967     glog = v-qh:query-open no-error .
      968     if not glog then do:
      969       delete object v-qh.
      970       delete object v-bh.
      971       undo, return error .
      972     end.
      973     if p-next then do:
      974       v-qh:reposition-to-rowid(p-rowid) no-error .
      975       glog = v-qh:get-next( p-lock) no-error .
      976       glog = v-qh:get-next( p-lock) no-error .
      977       if not glog or v-qh:query-off-end = yes then do:
      978         glog = v-qh:get-first( p-lock) no-error .
      979       end.
      980     end.
      981     else do:
      982       glog = v-qh:get-first( p-lock) no-error .
      983     end.
      984     v-recid = v-bh:recid no-error .
      985     delete object v-qh.
      986     delete object v-bh.
      987     return string(v-recid) .
      988   end.
      989   end procedure.
      990   procedure fltopend_fltfindq :
      991   define input parameter p-parent-handle as handle no-undo .
      992   define input parameter p-qh as handle no-undo .
      993   define input parameter p-next as logical no-undo .
      994   define input parameter p-lock as integer no-undo .
      995   define input parameter p-flt-open-open-query  as character no-undo .
      996   define input parameter p-where-cond as character no-undo .
      997   define input parameter p-use-indFIRST-query-tail as character no-undo .
      998   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      999   define input parameter p-indexed-reposition as character no-undo .
     1000   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1001   define variable glog as logical no-undo .
     1002   define variable v-qh as handle no-undo .
     1003   define variable v-bh as handle no-undo extent 18.
     1004   define variable v-rowid as rowid no-undo extent 18.
     1005   define variable v-ii as integer no-undo .
     1006   define variable v-prepare-string as character no-undo .
     1007   do
     1008   on error undo, return error
     1009   on stop undo, return error
     1010   :
     1011     create query v-qh.
     1012     do v-ii = 1 to p-qh:num-buffers:
     1013       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1014       assign
     1015       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1016       no-error.
     1017       v-qh:add-buffer(v-bh[v-ii]).
     1018     end.
     1019     assign
     1020     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1021                       p-where-cond + chr(32)  +
     1022                       p-use-indFIRST-query-tail + chr(32) +
     1023                       p-use-ind-sort-clmn-by + chr(32) +
     1024                       p-indexed-reposition
     1025     .
     1026     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1027     if not glog then do:
     1028       delete object v-qh.
     1029       do v-ii = 1 to p-qh:num-buffers:
     1030         delete object v-bh[v-ii].
     1031       end.
     1032       undo, return error .
     1033     end.
     1034     glog = v-qh:query-open no-error .
     1035     if not glog then do:
     1036       delete object v-qh.
     1037       do v-ii = 1 to p-qh:num-buffers:
     1038         delete object v-bh[v-ii].
     1039       end.
     1040       undo, return error .
     1041     end.
     1042     if p-next then do:
     1043       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1044       glog = v-qh:get-next( p-lock) no-error .
     1045       glog = v-qh:get-next( p-lock) no-error .
     1046       if not glog or v-qh:query-off-end = yes then do:
     1047         glog = v-qh:get-first( p-lock) no-error .
     1048       end.
     1049     end.
     1050     else do:
     1051       glog = v-qh:get-first( p-lock) no-error .
     1052     end.
     1053     do v-ii = 1 to p-qh:num-buffers:
     1054       assign
     1055       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1056       no-error.
     1057     end.
     1058     delete object v-qh.
     1059     do v-ii = 1 to p-qh:num-buffers:
     1060       delete object v-bh[v-ii].
     1061     end.
     1062   end.
     1063   end procedure.
