     4362   PROCEDURE proc-b-sch :
     4363    do
     4364    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4365    :
     4366   assign
     4367     tbl = 'ord-doc'
     4368     join-tbl = 'buf-oo_ord-doc'
     4369     fld = ""
     4370     lab = ""
     4371     spr = ""
     4372     dim = '0'
     4373     .
     4374   run fltfield-add in this-procedure('doc-code'                      , '№ заказа'  , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4375   run fltfield-add in this-procedure('status_'                       , 'Статус'    , 'order-status-all',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4376   run fltfield-add in this-procedure('flag_'                         , 'ОК'        , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4377   run fltfield-add in this-procedure('doc-date'                      , 'Дата док-та', '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4378   run fltfield-add in this-procedure('fact-date'                     , 'Дата факт'  , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4379   run fltfield-add in this-procedure('obj-type*obj-code'  , 'Объект'     , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4380   run fltfield-add in this-procedure('agnt'                          , 'Исполнитель', 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4381   run fltfield-add in this-procedure('boss'                          , 'Менеджер'   , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4382   run fltfield-add in this-procedure('wrkr'                          , 'Кладовщик'  , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4383   run fltfield-add in this-procedure('creid'                         , 'Создал'     , 'usr',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4384   run fltfield-add in this-procedure('host-code'                     , 'Фирма'      , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4385   run fltfield-add in this-procedure('pay-code'                      , 'Код оплаты' , 'pay',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4386   run fltfield-add in this-procedure('ship-date'                     , 'Дата доставки заказа' , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4387   run fltfield-add in this-procedure('ship-time'                     , 'Время доставки заказа', 'time',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4388   run fltfield-add in this-procedure('PS'                            , 'Примечание', '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4389   run fltfield-add in this-procedure('exch-code'                      , 'Валюта','curr',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4390   run fltfield-add in this-procedure('user-name'                      , 'Правил', 'usr',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4391   Filter-Block:
     4392   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4393       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4394       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4395     run gbl/filter.w ( input parParentProc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     4396     run openbr in this-procedure (yes, no, '':U).
     4397   END.
     4398     end.
     4399   END PROCEDURE.
     4400   PROCEDURE proc-sch-code :
     4401    do
     4402    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4403    :
     4404   define input parameter par-next as logical no-undo.
     4405   define input parameter pardoc-code as character  no-undo.
     4406   display "" @ sch-date with frame Dialog-Frame.
     4407   display "" @ sch-fact with frame Dialog-Frame.
     4408   assign
     4409     pardoc-code = chr(34) + pardoc-code + chr(34) .
     4410   run OpenBr in this-procedure
     4411       (input false
     4412       ,input par-next
     4413       ,input substitute("and buf-oo_ord-doc.doc-code begins &1 "
     4414       , pardoc-code)
     4415       ) no-error .
     4416       if error-status :error or return-value = ? then
     4417          message "Не найдено ни одной записи !" view-as alert-box .
     4418    apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     4419     end.
     4420   END PROCEDURE.
     4421   PROCEDURE proc-sch-date :
     4422    do
     4423    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4424    :
     4425   define input parameter par-next as logical no-undo.
     4426   define input parameter pardoc-code as date no-undo.
     4427   define variable ppp as character no-undo .
     4428   display "" @ sch-fact with frame Dialog-Frame.
     4429   display "" @ sch-code with frame Dialog-Frame.
     4430   ppp =  string( day(pardoc-code)) + "/" +  string(month (pardoc-code)) + "/" +  string( year(pardoc-code)) .
     4431   run OpenBr in this-procedure
     4432       (input false
     4433       ,input par-next
     4434       ,input substitute(" and buf-oo_ord-doc.doc-date = &1 " , ppp )
     4435       ) no-error .
     4436       if error-status :error or return-value = ? then
     4437          message "За эту дату не найдено ни одной записи !" view-as alert-box .
     4438   apply "VALUE-CHANGED" to br-docs  in frame Dialog-Frame.
     4439     end.
     4440   END PROCEDURE.
     4441   PROCEDURE proc-sch-fact :
     4442    do
     4443    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4444    :
     4445   define input parameter par-next as logical no-undo.
     4446   define input parameter pardoc-code as date no-undo.
     4447   define variable ppp as character no-undo .
     4448   display "" @ sch-date with frame Dialog-Frame.
     4449   display "" @ sch-code with frame Dialog-Frame.
     4450   ppp =  string( day(pardoc-code)) + "/" +  string( month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
     4451   run OpenBr in this-procedure
     4452       (input false
     4453       ,input par-next
     4454       ,input substitute("and buf-oo_ord-doc.fact-date = &1 "
     4455         , ppp )
     4456       ) no-error .
     4457       if error-status :error or return-value = ? then
     4458          message "За эту дату не найдено ни одной записи !" view-as alert-box .
     4459   apply "VALUE-CHANGED" to br-docs  in frame Dialog-Frame.
     4460     end.
     4461   END PROCEDURE.
     4462   PROCEDURE UI-on :
     4463    do
     4464    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4465    :
     4466    run openbr in this-procedure ( yes, no, '':u).
     4467     end.
     4468   END PROCEDURE.
     4469   FUNCTION f-direct RETURNS CHARACTER
     4470   ( par1 as recid ):
     4471   define buffer fl for ub.ord-doc.
     4472   define variable v-res as character no-undo .
     4473   define variable v-res-0 as character no-undo .
     4474   find first fl no-lock where recid(fl) = par1 no-error .
     4475   if error-status :error then return chr(32) .
     4476   v-res = chr(42) .
     4477   v-res-0 = chr(32) .
     4478   if v-cntxt-db-num = 0 then
     4479       if fl.order-type = 3  then return v-res.
     4480         else return v-res-0 .
     4481   else
     4482      if fl.order-type = 2  then return v-res.
     4483         else return v-res-0 .
     4484   END FUNCTION.
