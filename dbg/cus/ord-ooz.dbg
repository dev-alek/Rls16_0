        9   define input parameter p-obj-code    like ub.clients.obj-code no-undo.
       10   define input parameter p-obj-type    like ub.clients.obj-type no-undo.
       11   define input parameter p-doc-type    as character no-undo .
       12   define input parameter p-status_     as character no-undo .
