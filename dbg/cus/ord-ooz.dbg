     1091   FUNCTION f-direct RETURNS CHARACTER
     1092   ( par1 as recid ) FORWARD.
     1093   DEFINE BUTTON b-add
     1094        LABEL "&Добавить":L
     1095        SIZE 9 BY 1 TOOLTIP "Добавить новый заказ".
