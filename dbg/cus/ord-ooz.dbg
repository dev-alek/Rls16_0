     2078   end.
     2079   on ctrl-f of sch-fact in frame Dialog-Frame
     2080   do:
     2081     if (can-query (self, "sensitive")
     2082        and
     2083        self :sensitive = true
     2084        )
     2085     or (can-query (self, "read-only")
     2086        and
     2087        self :read-only = false
     2088        )
     2089     then do:
     2090       if self :handle <> focus :handle
     2091       then do:
     2092         apply "entry":u to self .
     2093       end.
     2094       define variable v-ok            as logical   no-undo .
     2095       define variable v-curr-sv-date  as date      no-undo .
     2096       define variable v-description   as character no-undo .
     2097       assign
     2098         v-curr-sv-date = date(self :screen-value) no-error
     2099       .
     2100       if v-curr-sv-date = ?
     2101       then do:
     2102         run gbl/getcurdt.p
     2103           (output v-curr-sv-date
     2104           ) .
     2105       end.
     2106       if v-curr-sv-date <> ?
     2107       then do:
     2108         run gbl/d-inpday.w
     2109           (input ?
     2110           ,input "Выбор даты"
     2111           ,input v-description
     2112           ,input ""
     2113           ,input-output v-curr-sv-date
     2114           ,output v-ok
     2115           ).
     2116         if v-ok = true
     2117         then do:
     2118           assign
     2119             self :screen-value = string(v-curr-sv-date) .
     2120           .
     2121         end.
     2122       end.
     2123     end.
     2124     return no-apply .
     2125   end.
     2126     define MENU m-ed-date26
     2127       MENU-ITEM m-ed-date26-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2128       MENU-ITEM m-ed-date26-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2129       MENU-ITEM m-ed-date26-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2130       MENU-ITEM m-ed-date26-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     2131       .
     2132     if sch-fact :POPUP-MENU in frame Dialog-Frame = ?
     2133     then do:
     2134       ASSIGN
     2135         sch-fact :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date26 :HANDLE
     2136         sch-fact :MENU-MOUSE in frame Dialog-Frame = 3
     2137       .
     2138     end.
     2139     define variable v-label-handle26 as handle no-undo .
     2140     assign
     2141       v-label-handle26 = sch-fact :side-label-handle in frame Dialog-Frame
     2142     .
     2143     if valid-handle (v-label-handle26)
     2144     then do:
     2145       if v-label-handle26 :tooltip = ""
     2146       or v-label-handle26 :tooltip = ?
     2147       then do:
     2148         assign
     2149           v-label-handle26 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     2150         .
     2151       end.
     2152     end.
     2153     ON CHOOSE OF MENU-ITEM m-ed-date26-1 in menu m-ed-date26 DO:
     2154       apply "ctrl-b":U to sch-fact in frame Dialog-Frame .
     2155     END.
     2156     ON CHOOSE OF MENU-ITEM m-ed-date26-2 in menu m-ed-date26 DO:
     2157       apply "ctrl-d":U to sch-fact in frame Dialog-Frame .
     2158     END.
     2159     ON CHOOSE OF MENU-ITEM m-ed-date26-3 in menu m-ed-date26 DO:
     2160       apply "ctrl-e":U to sch-fact in frame Dialog-Frame .
     2161     END.
     2162     ON CHOOSE OF MENU-ITEM m-ed-date26-4 in menu m-ed-date26 DO:
     2163       apply "ctrl-f":U to sch-fact in frame Dialog-Frame .
     2164     END.
     2165   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2166   on help of frame Dialog-Frame
     2167   do:
     2168     run gbl/app_help.p
     2169       (input this-procedure :file-name
     2170       ,input ''
     2171       ,input ?
     2172       ) no-error.
     2173     if error-status :error then do:
     2174       message
     2175         "Ошибка при вызове помощи"
     2176         error-status :get-message(1)
     2177         view-as alert-box .
     2178     end.
     2179   end.
     2180   run minbtn-set in this-procedure .
     2181   on choose of b-help in frame Dialog-Frame
     2182   do:
     2183     apply "help":u to frame Dialog-Frame .
     2184   end.
     2185   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2186   procedure minbtn-set :
     2187       do
     2188           on error undo, return error return-value
     2189           :
     2190           define variable ii              as integer       no-undo .
     2191           define variable fh              as widget-handle no-undo .
     2192           define variable hh              as widget-handle no-undo .
     2193           define variable v-h             as handle        extent 4 no-undo .
     2194           define variable v-name-button   as character     no-undo .
     2195           define variable v-help-old-x    as decimal       no-undo .
     2196           define variable v-help-old-y    as decimal       no-undo .
     2197           define variable v-help-old-size as decimal       no-undo .
     2198           define variable v-frame-width   as decimal       no-undo .
     2199           define variable jj              as integer       no-undo .
     2200           do
     2201               on error undo, return error
     2202               :
     2203               assign
     2204                   v-frame-width = frame Dialog-Frame:width - 0.3
     2205                   fh            = frame Dialog-Frame:first-child
     2206                   hh            = fh:first-child
     2207                   ii            = 1
     2208                   .
     2209               do while valid-handle(hh):
     2210                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2211                   do:
     2212                       case lc(hh:name) :
     2213                           when "b-help" then
     2214                               do:
     2215                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2216                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2217                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2218                                   hh:TOOLTIP = "Помощь" .
     2219                                   v-help-old-x = hh:column .
     2220                                   v-help-old-y = hh:row    .
     2221                                   v-help-old-size = hh:width .
     2222                                   hh:width-chars = 2.5 .
     2223                               end.
     2224                           when "b-print" then
     2225                               do:
     2226                                   hh:load-image("cmp/b-print.bmp":u) .
     2227                                   hh:TOOLTIP = "Печать" .
     2228                                   v-h[ii] = hh:handle .
     2229                                   ii = ii + 1 .
     2230                                   hh:width-chars = 3 .
     2231                               end.
     2232                           when "b-history" or
     2233                           when "b-hist" then
     2234                               do:
     2235                                   hh:load-image("cmp/b-hist.bmp":u) .
     2236                                   hh:TOOLTIP = "История" .
     2237                                   v-h[ii] = hh:handle .
     2238                                   ii = ii + 1 .
     2239                                   hh:width-chars = 3 .
     2240                               end.
     2241                           when "b-sch" then
     2242                               do:
     2243                                   hh:load-image("cmp/b-sch.bmp":u) .
     2244                                   hh:TOOLTIP = "Установка Фильтра" .
     2245                                   v-h[ii] = hh:handle .
     2246                                   ii = ii + 1 .
     2247                                   hh:width-chars = 3 .
     2248                               end.
     2249                           when "b-hist-user" then
     2250                               do:
     2251                                   hh:load-image("cmp/b-hist.bmp":u) .
     2252                                   hh:TOOLTIP = "История пользователя" .
     2253                                   ii = ii + 1 .
     2254                               end.
     2255                       end case.
     2256                   end.
     2257                   hh = hh:next-sibling.
     2258               end.
     2259               b-help:column = v-frame-width - b-help:width-chars.
     2260               jj = 0.
     2261               repeat ii = 4 to 1 by -1 :
     2262                   if valid-handle (v-h[ii] ) then
     2263                   do:
     2264                       jj  = jj + 1 .
     2265                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2266                       v-h[ii]:row    = v-help-old-y .
     2267                   end.
     2268               end.
     2269           end.
     2270       end.
     2271   end procedure.
     2272   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2273   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2274   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2275   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2276   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2277   define variable v-diasize-current-frame-height as decimal   no-undo .
     2278   define variable v-diasize-change-size          as logical   no-undo .
     2279   define variable v-diasize-resize-button        as handle    no-undo .
     2280   define variable v-diasize-wndmax               as logical   no-undo .
     2281   define variable v-diasize-wndstore             as logical   no-undo .
     2282   define variable v-diasize-proc-name            as character no-undo .
     2283   define variable v-diasize-browse-handle        as handle    no-undo .
     2284   define variable v-diasize-browse-number        as integer   no-undo .
     2285   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2286   define temp-table temp-diasize-handle no-undo
     2287     field handle-value  as handle
     2288     field save-position as decimal
     2289     index xpk is primary unique handle-value
     2290     .
     2291   define temp-table temp-browse-handle no-undo
     2292     field browse-type   as character
     2293     field browse-number as integer
     2294     field browse-handle as handle
     2295     field original-size as decimal
     2296     index xpk is primary unique browse-type browse-number
     2297     index xie browse-type browse-handle
     2298   .
     2299   procedure diasize_change-height :
     2300     define input  parameter p-change-value  as decimal   no-undo .
     2301     define input  parameter p-move-resize   as logical   no-undo .
     2302     define variable v-field-group-handle    as handle    no-undo .
     2303     define variable v-object-handle         as handle    no-undo .
     2304     define variable v-frame-height          as decimal   no-undo .
     2305     define variable v-frame-virtual-height  as decimal   no-undo .
     2306     define variable v-browse-height         as decimal   no-undo .
     2307     define variable v-window-height         as decimal   no-undo .
     2308     define variable v-window-virtual-height as decimal   no-undo .
     2309     define variable v-change-sign           as integer   no-undo .
     2310     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2311     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2312     if p-change-value > 0
     2313     then do:
     2314       if frame Dialog-Frame :height + p-change-value
     2315           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2316       then do:
     2317         assign
     2318           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2319                           - (frame Dialog-Frame :height-chars)
     2320         .
     2321         if p-change-value <= 0
     2322         then do:
     2323           run diasize_position-resize-button in this-procedure .
     2324           return .
     2325         end.
     2326       end.
     2327     end.
     2328     if p-change-value < 0
     2329     then do:
     2330       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2331       then do:
     2332         assign
     2333           p-change-value = v-diasize-orig-frame-height
     2334                          - (frame Dialog-Frame :height-chars)
     2335         .
     2336         if p-change-value >= 0
     2337         then do:
     2338           run diasize_position-resize-button in this-procedure .
     2339           return .
     2340         end.
     2341       end.
     2342     end.
     2343     if p-change-value >= 0
     2344     then do:
     2345       assign
     2346         v-change-sign = 1
     2347       .
     2348     end.
     2349     else do:
     2350       assign
     2351         v-change-sign = -1
     2352       .
     2353     end.
     2354     assign
     2355       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2356     .
     2357     if p-change-value = 0
     2358     then do:
     2359       run diasize_position-resize-button in this-procedure .
     2360       return .
     2361     end.
     2362     move_block:
     2363     do
     2364     on error undo move_block, retry move_block
     2365     :
     2366       if retry
     2367       then do:
     2368         do
     2369         on error undo move_block, leave move_block
     2370         :
     2371           if p-change-value > 0
     2372           then do:
     2373             for each buf_temp-diasize-handle
     2374             on error undo, next
     2375             :
     2376               assign
     2377                 v-object-handle = buf_temp-diasize-handle.handle-value
     2378               .
     2379               if v-object-handle <> v-diasize-resize-button
     2380               then do:
     2381                 assign
     2382                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2383                 .
     2384               end.
     2385             end.
     2386             assign
     2387               v-diasize-browse-handle :height = v-browse-height
     2388             .
     2389             for each buf_temp-browse-handle
     2390               where buf_temp-browse-handle.browse-type = 'height':u
     2391             on error undo, next
     2392             :
     2393               assign
     2394                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2395               .
     2396             end.
     2397             assign
     2398               frame Dialog-Frame :height = v-frame-height
     2399             .
     2400             if frame Dialog-Frame :scrollable = true
     2401             then do:
     2402               assign
     2403                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2404               .
     2405             end.
     2406             run diasize_position-resize-button in this-procedure .
     2407           end.
     2408           else do:
     2409             if frame Dialog-Frame :scrollable = true
     2410             then do:
     2411               assign
     2412                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2413               .
     2414             end.
     2415             assign
     2416               frame Dialog-Frame :height = v-frame-height
     2417             .
     2418             assign
     2419               v-diasize-browse-handle :height = v-browse-height
     2420             .
     2421             for each buf_temp-browse-handle
     2422               where buf_temp-browse-handle.browse-type = 'height':u
     2423             on error undo, next
     2424             :
     2425               assign
     2426                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2427               .
     2428             end.
     2429             for each buf_temp-diasize-handle
     2430             on error undo, next
     2431             :
     2432               assign
     2433                 v-object-handle = buf_temp-diasize-handle.handle-value
     2434               .
     2435               if v-object-handle <> v-diasize-resize-button
     2436               then do:
     2437                 assign
     2438                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2439                 .
     2440               end.
     2441             end.
     2442             run diasize_position-resize-button in this-procedure .
     2443           end.
     2444           assign
     2445             v-diasize-change-size = false
     2446           .
     2447           leave move_block .
     2448         end.
     2449       end.
     2450       assign
     2451         v-diasize-need-full-display = true
     2452       .
     2453       if v-diasize-change-size = false
     2454       then do:
     2455         assign
     2456           v-diasize-change-size = true
     2457         .
     2458       end.
     2459       else do:
     2460         return .
     2461       end.
     2462       assign
     2463         v-frame-height = frame Dialog-Frame :height
     2464         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2465         v-browse-height = v-diasize-browse-handle :height
     2466       .
     2467       for each buf_temp-browse-handle
     2468         where buf_temp-browse-handle.browse-type = 'height':u
     2469       :
     2470         assign
     2471           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2472         .
     2473       end.
     2474       for each buf_temp-diasize-handle
     2475       :
     2476         delete buf_temp-diasize-handle .
     2477       end.
     2478       assign
     2479         v-field-group-handle = frame Dialog-Frame :first-child
     2480       .
     2481       do while valid-handle(v-field-group-handle)
     2482       :
     2483         assign
     2484           v-object-handle = v-field-group-handle :first-child
     2485         .
     2486         do while valid-handle(v-object-handle)
     2487         :
     2488           if  v-object-handle <> v-diasize-browse-handle :handle
     2489           and can-query(v-object-handle, "row")
     2490           and can-query(v-object-handle, "height")
     2491           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2492           then do:
     2493             find first buf_temp-browse-handle
     2494               where buf_temp-browse-handle.browse-type   = 'height':u
     2495                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2496               no-error .
     2497             if available buf_temp-browse-handle
     2498             then do:
     2499             end.
     2500             else do:
     2501               create buf_temp-diasize-handle .
     2502               assign
     2503                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2504                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2505               .
     2506             end.
     2507           end.
     2508           assign
     2509             v-object-handle = v-object-handle :next-sibling
     2510           .
     2511         end.
     2512         assign
     2513           v-field-group-handle = v-field-group-handle :next-sibling
     2514         .
     2515       end.
     2516       do with frame Dialog-Frame
     2517       :
     2518         hide v-diasize-resize-button .
     2519         assign
     2520           v-diasize-resize-button :row    = 1
     2521           v-diasize-resize-button :column = 1
     2522         .
     2523       end.
     2524       if p-change-value > 0
     2525       then do:
     2526         if frame Dialog-Frame :scrollable = true
     2527         then do:
     2528           assign
     2529             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2530             no-error .
     2531           if error-status :error
     2532           or error-status :get-message(1) <> ""
     2533           then do:
     2534             undo move_block, retry move_block .
     2535           end.
     2536         end.
     2537         assign
     2538           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2539           no-error .
     2540         if error-status :error
     2541         or error-status :get-message(1) <> ""
     2542         then do:
     2543           undo move_block, retry move_block .
     2544         end.
     2545         assign
     2546           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2547           no-error .
     2548         if error-status :error
     2549         or error-status :get-message(1) <> ""
     2550         then do:
     2551           undo move_block, retry move_block .
     2552         end.
     2553         for each buf_temp-browse-handle
     2554           where buf_temp-browse-handle.browse-type = 'height':u
     2555         on error undo move_block, retry move_block
     2556         :
     2557           assign
     2558             buf_temp-browse-handle.browse-handle :height
     2559               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2560             no-error .
     2561           if error-status :error
     2562           or error-status :get-message(1) <> ""
     2563           then do:
     2564             undo move_block, retry move_block .
     2565           end.
     2566         end.
     2567         for each buf_temp-diasize-handle
     2568         on error undo move_block, retry move_block
     2569         :
     2570           assign
     2571             v-object-handle = buf_temp-diasize-handle.handle-value
     2572           .
     2573           if v-object-handle <> v-diasize-resize-button
     2574           then do:
     2575             assign
     2576               v-object-handle :row = v-object-handle :row + p-change-value
     2577               no-error .
     2578             if error-status :error
     2579             or error-status :get-message(1) <> ""
     2580             then do:
     2581               undo move_block, retry move_block .
     2582             end.
     2583           end.
     2584         end.
     2585       end.
     2586       else do:
     2587         for each buf_temp-diasize-handle
     2588         on error undo move_block, retry move_block
     2589         :
     2590           assign
     2591             v-object-handle = buf_temp-diasize-handle.handle-value
     2592           .
     2593           if v-object-handle <> v-diasize-resize-button
     2594           then do:
     2595             assign
     2596               v-object-handle :row = v-object-handle :row + p-change-value
     2597               no-error .
     2598             if error-status :error
     2599             or error-status :get-message(1) <> ""
     2600             then do:
     2601               undo move_block, retry move_block .
     2602             end.
     2603           end.
     2604         end.
     2605         assign
     2606           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2607           no-error .
     2608         if error-status :error
     2609         or error-status :get-message(1) <> ""
     2610         then do:
     2611           undo move_block, retry move_block .
     2612         end.
     2613         for each buf_temp-browse-handle
     2614           where buf_temp-browse-handle.browse-type = 'height':u
     2615         on error undo move_block, retry move_block
     2616         :
     2617           assign
     2618             buf_temp-browse-handle.browse-handle :height
     2619               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2620             no-error .
     2621           if error-status :error
     2622           or error-status :get-message(1) <> ""
     2623           then do:
     2624             undo move_block, retry move_block .
     2625           end.
     2626         end.
     2627         assign
     2628           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2629           no-error .
     2630         if error-status :error
     2631         or error-status :get-message(1) <> ""
     2632         then do:
     2633           undo move_block, retry move_block .
     2634         end.
     2635         if frame Dialog-Frame :scrollable = true
     2636         then do:
     2637           assign
     2638             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2639             no-error .
     2640           if error-status :error
     2641           or error-status :get-message(1) <> ""
     2642           then do:
     2643             undo move_block, retry move_block .
     2644           end.
     2645         end.
     2646       end.
     2647       if p-move-resize = true
     2648       then do:
     2649         run diasize_position-resize-button in this-procedure .
     2650       end.
     2651       if v-diasize-wndstore = true
     2652       then do:
     2653         if connected("ub") = true
     2654         then do:
     2655           define variable v-cntxt-db-num        as integer   no-undo .
     2656           define variable v-cntxt-userid        as character no-undo .
     2657           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2658                                             , OUTPUT v-cntxt-userid
     2659                                             ) .
     2660           run gbl/wndsizew.p
     2661             (input  v-cntxt-db-num
     2662             ,input  v-cntxt-userid
     2663             ,input  v-diasize-proc-name
     2664             ,input  'height':u
     2665             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2666             ) .
     2667         end.
     2668       end.
     2669     end.
     2670     assign
     2671       v-diasize-change-size = false
     2672     .
     2673   end procedure.
     2674   procedure diasize_set-height :
     2675     define input  parameter p-new-height  as decimal   no-undo .
     2676     define input  parameter p-move-resize as logical   no-undo .
     2677     do
     2678     on error undo, return error return-value
     2679     :
     2680       run diasize_change-height in this-procedure
     2681         (input  (p-new-height - frame Dialog-Frame :height)
     2682         ,input  p-move-resize
     2683         ) .
     2684     end.
     2685   end procedure.
     2686   procedure diasize_change-width :
     2687     define input  parameter p-change-value as decimal   no-undo .
     2688     define input  parameter p-move-resize  as logical   no-undo .
     2689     define variable v-field-group-handle   as handle    no-undo .
     2690     define variable v-object-handle        as handle    no-undo .
     2691     define variable v-frame-width          as decimal   no-undo .
     2692     define variable v-frame-virtual-width  as decimal   no-undo .
     2693     define variable v-browse-width         as decimal   no-undo .
     2694     define variable v-window-width         as decimal   no-undo .
     2695     define variable v-window-virtual-width as decimal   no-undo .
     2696     define variable v-change-sign          as integer   no-undo .
     2697     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2698     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2699     if p-change-value > 0
     2700     then do:
     2701       if frame Dialog-Frame :width + p-change-value >
     2702           session :width-chars
     2703       then do:
     2704         assign
     2705           p-change-value = session :width-chars - frame Dialog-Frame :width
     2706         .
     2707         if p-change-value <= 0
     2708         then do:
     2709           run diasize_position-resize-button in this-procedure .
     2710           return .
     2711         end.
     2712       end.
     2713     end.
     2714     if p-change-value < 0
     2715     then do:
     2716       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2717       then do:
     2718         assign
     2719           p-change-value = v-diasize-orig-frame-width
     2720                          - frame Dialog-Frame :width
     2721         .
     2722         if p-change-value >= 0
     2723         then do:
     2724           run diasize_position-resize-button in this-procedure .
     2725           return .
     2726         end.
     2727       end.
     2728     end.
     2729     if p-change-value >= 0
     2730     then do:
     2731       assign
     2732         v-change-sign = 1
     2733       .
     2734     end.
     2735     else do:
     2736       assign
     2737         v-change-sign = -1
     2738       .
     2739     end.
     2740     assign
     2741       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2742     .
     2743     if p-change-value = 0
     2744     then do:
     2745       run diasize_position-resize-button in this-procedure .
     2746       return .
     2747     end.
     2748     move_block:
     2749     do
     2750     on error undo move_block, leave move_block
     2751     :
     2752       if retry
     2753       then do:
     2754         do
     2755         on error undo move_block, leave move_block
     2756         :
     2757           if p-change-value > 0
     2758           then do:
     2759             for each buf_temp-diasize-handle
     2760             on error undo, next
     2761             :
     2762               assign
     2763                 v-object-handle = buf_temp-diasize-handle.handle-value
     2764               .
     2765               if v-object-handle <> v-diasize-resize-button
     2766               then do:
     2767                 assign
     2768                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2769                 .
     2770               end.
     2771             end.
     2772             assign
     2773               v-diasize-browse-handle :width = v-browse-width
     2774             .
     2775             for each buf_temp-browse-handle
     2776               where buf_temp-browse-handle.browse-type = 'width':u
     2777             on error undo, next
     2778             :
     2779               assign
     2780                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2781               .
     2782             end.
     2783             assign
     2784               frame Dialog-Frame :width = v-frame-width
     2785             .
     2786             if frame Dialog-Frame :scrollable = true
     2787             then do:
     2788               assign
     2789                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2790               .
     2791             end.
     2792             run diasize_position-resize-button in this-procedure .
     2793           end.
     2794           else do:
     2795             if frame Dialog-Frame :scrollable = true
     2796             then do:
     2797               assign
     2798                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2799               .
     2800             end.
     2801             assign
     2802               frame Dialog-Frame :width = v-frame-width
     2803             .
     2804             for each buf_temp-browse-handle
     2805               where buf_temp-browse-handle.browse-type = 'width':u
     2806             on error undo, next
     2807             :
     2808               assign
     2809                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2810               .
     2811             end.
     2812             assign
     2813               v-diasize-browse-handle :width = v-browse-width
     2814             .
     2815             for each buf_temp-diasize-handle
     2816             on error undo, next
     2817             :
     2818               assign
     2819                 v-object-handle = buf_temp-diasize-handle.handle-value
     2820               .
     2821               if v-object-handle <> v-diasize-resize-button
     2822               then do:
     2823                 assign
     2824                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2825                 .
     2826               end.
     2827             end.
     2828             run diasize_position-resize-button in this-procedure .
     2829           end.
     2830           assign
     2831             v-diasize-change-size = false
     2832           .
     2833           leave move_block .
     2834         end.
     2835       end.
     2836       assign
     2837         v-diasize-need-full-display = true
     2838       .
     2839       if v-diasize-change-size = false
     2840       then do:
     2841         assign
     2842           v-diasize-change-size = true
     2843         .
     2844       end.
     2845       else do:
     2846         return .
     2847       end.
     2848       assign
     2849         v-frame-width = frame Dialog-Frame :width
     2850         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2851         v-browse-width = v-diasize-browse-handle :width
     2852       .
     2853       for each buf_temp-browse-handle
     2854         where buf_temp-browse-handle.browse-type = 'width':u
     2855       :
     2856         assign
     2857           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2858         .
     2859       end.
     2860       for each buf_temp-diasize-handle
     2861       :
     2862         delete buf_temp-diasize-handle .
     2863       end.
     2864       assign
     2865         v-field-group-handle = frame Dialog-Frame :first-child
     2866       .
     2867       do while valid-handle(v-field-group-handle)
     2868       :
     2869         assign
     2870           v-object-handle = v-field-group-handle :first-child
     2871         .
     2872         do while valid-handle(v-object-handle)
     2873         :
     2874           if  v-object-handle <> v-diasize-browse-handle :handle
     2875           and v-object-handle <> v-diasize-resize-button
     2876           and can-query(v-object-handle, "row")
     2877           and can-query(v-object-handle, "height")
     2878           and ( v-object-handle :col + v-object-handle :width
     2879                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2880               )
     2881           then do:
     2882             find first buf_temp-browse-handle
     2883               where buf_temp-browse-handle.browse-type   = 'width':u
     2884                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2885               no-error .
     2886             if available buf_temp-browse-handle
     2887             then do:
     2888             end.
     2889             else do:
     2890               create buf_temp-diasize-handle .
     2891               assign
     2892                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2893                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2894               .
     2895             end.
     2896           end.
     2897           assign
     2898             v-object-handle = v-object-handle :next-sibling
     2899           .
     2900         end.
     2901         assign
     2902           v-field-group-handle = v-field-group-handle :next-sibling
     2903         .
     2904       end.
     2905       do with frame Dialog-Frame
     2906       :
     2907         hide v-diasize-resize-button .
     2908         v-diasize-resize-button :row = 1.
     2909         v-diasize-resize-button :column = 1.
     2910       end.
     2911       if p-change-value > 0
     2912       then do:
     2913         if frame Dialog-Frame :scrollable = true
     2914         then do:
     2915           assign
     2916             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2917             no-error .
     2918           if error-status :error
     2919           or error-status :get-message(1) <> ""
     2920           then do:
     2921             undo move_block, retry move_block.
     2922           end.
     2923         end.
     2924         assign
     2925           frame Dialog-Frame :width = v-frame-width + p-change-value
     2926           no-error .
     2927         if error-status :error
     2928         or error-status :get-message(1) <> ""
     2929         then do:
     2930           undo move_block, retry move_block.
     2931         end.
     2932         assign
     2933           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2934         no-error .
     2935         if error-status :error
     2936         or error-status :get-message(1) <> ""
     2937         then do:
     2938           undo move_block, retry move_block.
     2939         end.
     2940         for each buf_temp-browse-handle
     2941           where buf_temp-browse-handle.browse-type = 'width':u
     2942         on error undo move_block, retry move_block
     2943         :
     2944           assign
     2945             buf_temp-browse-handle.browse-handle :width
     2946               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2947             no-error .
     2948           if error-status :error
     2949           or error-status :get-message(1) <> ""
     2950           then do:
     2951             undo move_block, retry move_block .
     2952           end.
     2953         end.
     2954         for each buf_temp-diasize-handle
     2955         on error undo move_block, retry move_block
     2956         :
     2957           assign
     2958             v-object-handle = buf_temp-diasize-handle.handle-value
     2959           .
     2960           if v-object-handle <> v-diasize-resize-button
     2961           then do:
     2962             assign
     2963               v-object-handle :col = v-object-handle :col + p-change-value
     2964               no-error .
     2965             if error-status :error
     2966             or error-status :get-message(1) <> ""
     2967             then do:
     2968               undo move_block, retry move_block .
     2969             end.
     2970           end.
     2971         end.
     2972       end.
     2973       else do:
     2974         for each buf_temp-diasize-handle
     2975         on error undo move_block, retry move_block
     2976         :
     2977           assign
     2978             v-object-handle = buf_temp-diasize-handle.handle-value
     2979           .
     2980           if v-object-handle <> v-diasize-resize-button
     2981           then do:
     2982             assign
     2983               v-object-handle :col = v-object-handle :col + p-change-value
     2984               no-error .
     2985             if error-status :error
     2986             or error-status :get-message(1) <> ""
     2987             then do:
     2988               undo move_block, retry move_block .
     2989             end.
     2990           end.
     2991         end.
     2992         for each buf_temp-browse-handle
     2993           where buf_temp-browse-handle.browse-type = 'width':u
     2994         on error undo move_block, retry move_block
     2995         :
     2996           assign
     2997             buf_temp-browse-handle.browse-handle :width
     2998               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2999             no-error .
     3000           if error-status :error
     3001           or error-status :get-message(1) <> ""
     3002           then do:
     3003             undo move_block, retry move_block .
     3004           end.
     3005         end.
     3006         assign
     3007           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3008           no-error .
     3009         if error-status :error
     3010         or error-status :get-message(1) <> ""
     3011         then do:
     3012           undo move_block, retry move_block.
     3013         end.
     3014         assign
     3015           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3016         no-error .
     3017         if error-status :error
     3018         or error-status :get-message(1) <> ""
     3019         then do:
     3020           undo move_block, retry move_block.
     3021         end.
     3022         if frame Dialog-Frame :scrollable = true
     3023         then do:
     3024           assign
     3025             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3026           no-error .
     3027           if error-status :error
     3028           or error-status :get-message(1) <> ""
     3029           then do:
     3030             undo move_block, retry move_block.
     3031           end.
     3032         end.
     3033       end.
     3034       if p-move-resize
     3035       then do:
     3036         run diasize_position-resize-button in this-procedure .
     3037       end.
     3038       if v-diasize-wndstore = true
     3039       then do:
     3040         if connected("ub") = true
     3041         then do:
     3042           define variable v-cntxt-db-num        as integer   no-undo .
     3043           define variable v-cntxt-userid        as character no-undo .
     3044           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3045                                             , OUTPUT v-cntxt-userid
     3046                                             ) .
     3047           run gbl/wndsizew.p
     3048             (input  v-cntxt-db-num
     3049             ,input  v-cntxt-userid
     3050             ,input  v-diasize-proc-name
     3051             ,input  'width':u
     3052             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3053             ) .
     3054         end.
     3055       end.
     3056     end.
     3057     assign
     3058       v-diasize-change-size = false
     3059     .
     3060   end procedure.
     3061   procedure diasize_set-width :
     3062     define input  parameter p-new-width  as decimal   no-undo .
     3063     define input  parameter p-move-resize as logical   no-undo .
     3064     do
     3065     on error undo, return error return-value
     3066     :
     3067       run diasize_change-width in this-procedure
     3068         (input  (p-new-width - frame Dialog-Frame :width)
     3069         ,input  p-move-resize
     3070         ) .
     3071     end.
     3072   end procedure.
     3073   procedure diasize_position-resize-button :
     3074     do with frame Dialog-Frame
     3075     :
     3076       hide v-diasize-resize-button .
     3077       assign
     3078         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3079                     - 1
     3080                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3081         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3082                     - 1
     3083                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3084       .
     3085       view v-diasize-resize-button .
     3086     end.
     3087   end procedure.
     3088   on alt-right anywhere
     3089   do:
     3090     run diasize_change-width in this-procedure
     3091       (input 1
     3092       ,input true
     3093       ) .
     3094     return no-apply .
     3095   end.
     3096   on alt-left anywhere
     3097   do:
     3098     run diasize_change-width in this-procedure
     3099       (input -1
     3100       ,input true
     3101       ) .
     3102     return no-apply .
     3103   end.
     3104   on alt-down anywhere
     3105   do:
     3106     run diasize_change-height in this-procedure
     3107       (input 1
     3108       ,input true
     3109       ) .
     3110     return no-apply .
     3111   end.
     3112   on alt-up anywhere
     3113   do:
     3114     run diasize_change-height in this-procedure
     3115       (input -1
     3116       ,input true
     3117       ) .
     3118     return no-apply .
     3119   end.
     3120   on alt-enter of frame Dialog-Frame
     3121   do:
     3122     run diasize_maximize in this-procedure
     3123       (input  ?
     3124       ).
     3125     return no-apply .
     3126   end.
     3127   procedure diasize_end-move :
     3128     do
     3129     on error undo, return error return-value
     3130     :
     3131       define variable v-row-delta as decimal   no-undo .
     3132       define variable v-col-delta as decimal   no-undo .
     3133       define variable v-new-row as decimal   no-undo .
     3134       define variable v-new-col as decimal   no-undo .
     3135       assign
     3136         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3137         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3138       .
     3139       assign
     3140         v-row-delta = v-new-row - frame Dialog-Frame :height
     3141         v-col-delta = v-new-col - frame Dialog-Frame :width
     3142       .
     3143       run diasize_change-height in this-procedure
     3144         (input v-row-delta
     3145         ,input true
     3146         ) .
     3147       run diasize_change-width in this-procedure
     3148         (input v-col-delta
     3149         ,input true
     3150         ) .
     3151     end.
     3152   end procedure.
     3153   procedure diasize_maximize :
     3154     define input  parameter p-action as logical   no-undo .
     3155     do
     3156     on error undo, return error return-value
     3157     :
     3158       if p-action = ?
     3159       then do:
     3160         if v-diasize-need-maximize = true
     3161         then do:
     3162           assign
     3163             p-action = true
     3164           .
     3165         end.
     3166         else do:
     3167           assign
     3168             p-action = false
     3169           .
     3170         end.
     3171       end.
     3172       if p-action = true
     3173       then do:
     3174         run diasize_change-height in this-procedure
     3175           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3176               - frame Dialog-Frame :height-chars
     3177           ,input true
     3178           ) .
     3179         run diasize_change-width in this-procedure
     3180           (input session :width-chars
     3181               - frame Dialog-Frame :width-chars
     3182           ,input true
     3183           ) .
     3184         assign
     3185           v-diasize-need-maximize = false
     3186         .
     3187       end.
     3188       else do:
     3189         run diasize_change-width in this-procedure
     3190           (input v-diasize-orig-frame-width
     3191               - frame Dialog-Frame :width-chars
     3192           ,input true
     3193           ) .
     3194         run diasize_change-height in this-procedure
     3195           (input v-diasize-orig-frame-height
     3196               - frame Dialog-Frame :height-chars
     3197           ,input true
     3198           ) .
     3199         assign
     3200           v-diasize-need-maximize = true
     3201         .
     3202       end.
     3203     end.
     3204   end procedure.
     3205   procedure diasize_restore-orig-size :
     3206     do
     3207     on error undo, return error return-value
     3208     :
     3209       assign
     3210         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3211         v-diasize-current-frame-height = frame Dialog-Frame :height
     3212       .
     3213       run diasize_set-height in this-procedure
     3214         (input  v-diasize-orig-frame-height
     3215         ,input  true
     3216         ) .
     3217       run diasize_set-width in this-procedure
     3218         (input  v-diasize-orig-frame-width
     3219         ,input  true
     3220         ) .
     3221     end.
     3222   end procedure.
     3223   procedure diasize_restore-current-size :
     3224     do
     3225     on error undo, return error return-value
     3226     :
     3227       run diasize_set-height in this-procedure
     3228         (input  v-diasize-current-frame-height
     3229         ,input  true
     3230         ) .
     3231       run diasize_set-width in this-procedure
     3232         (input  v-diasize-current-frame-width
     3233         ,input  true
     3234         ) .
     3235     end.
     3236   end procedure.
     3237   procedure diasize_set-browse-handle :
     3238     define input  parameter p-browse-handle as handle   no-undo .
     3239     define buffer buf_temp-browse-handle for temp-browse-handle .
     3240     do
     3241     on error undo, return error return-value
     3242     :
     3243       assign
     3244         v-diasize-browse-handle = p-browse-handle
     3245       .
     3246       for each buf_temp-browse-handle
     3247       on error undo, return error return-value
     3248       :
     3249         delete buf_temp-browse-handle .
     3250       end.
     3251     end.
     3252   end procedure.
     3253   procedure diasize_add_browse :
     3254     define input  parameter p-browse-type   as character no-undo .
     3255     define input  parameter p-browse-handle as handle    no-undo .
     3256     define buffer buf_temp-browse-handle for temp-browse-handle .
     3257     do
     3258     on error undo, return error return-value
     3259     :
     3260       assign
     3261         v-diasize-browse-number = v-diasize-browse-number + 1
     3262       .
     3263       create buf_temp-browse-handle .
     3264       assign
     3265         buf_temp-browse-handle.browse-type   = p-browse-type
     3266         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3267         buf_temp-browse-handle.browse-handle = p-browse-handle
     3268       .
     3269     end.
     3270   end procedure.
     3271   procedure diasize_init :
     3272     define variable v-default-value    as logical   no-undo .
     3273     define variable v-restore-saved    as logical   no-undo .
     3274     define variable v-resize-value-str as character no-undo .
     3275     do
     3276     on error undo, return error return-value
     3277     :
     3278       do with frame Dialog-Frame
     3279       :
     3280         assign
     3281           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3282           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3283           v-diasize-browse-handle     = browse BR-docs :handle
     3284         .
     3285         create button v-diasize-resize-button
     3286         assign
     3287           parent        = frame Dialog-Frame :first-child
     3288           label         = "s"
     3289           height-pixels = 16
     3290           width-pixels  = 16
     3291           visible       = true
     3292           sensitive     = true
     3293           movable       = true
     3294           triggers:
     3295             on end-move persistent run diasize_end-move in this-procedure .
     3296           end triggers.
     3297         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3298         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3299         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3300         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3301         assign
     3302           v-diasize-wndmax = false
     3303         .
     3304         if connected("ub") = true
     3305         then do:
     3306           define variable v-cntxt-db-num        as integer   no-undo .
     3307           define variable v-cntxt-userid        as character no-undo .
     3308           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3309                                             , OUTPUT v-cntxt-userid
     3310                                             ) .
     3311           run gbl/wndpar_r.p
     3312             (input  v-cntxt-db-num
     3313             ,input  v-cntxt-userid
     3314             ,input  'wndmax':U
     3315             ,output v-diasize-wndmax
     3316             ,output v-default-value
     3317             ) .
     3318         end.
     3319         assign
     3320           v-diasize-wndstore = false
     3321         .
     3322         if connected("ub") = true
     3323         then do:
     3324           run gbl/wndpar_r.p
     3325             (input  v-cntxt-db-num
     3326             ,input  v-cntxt-userid
     3327             ,input  'wndstore':U
     3328             ,output v-diasize-wndstore
     3329             ,output v-default-value
     3330             ) .
     3331         end.
     3332         assign
     3333           v-diasize-proc-name = entry(1, program-name(2), '.')
     3334         .
     3335         if v-diasize-wndstore = true
     3336         then do:
     3337           assign
     3338             v-restore-saved = false
     3339           .
     3340           if connected("ub") = true
     3341           then do:
     3342             run gbl/wndsizer.p
     3343               (input  v-cntxt-db-num
     3344               ,input  v-cntxt-userid
     3345               ,input  v-diasize-proc-name
     3346               ,input  'height':u
     3347               ,output v-resize-value-str
     3348               ) .
     3349             if v-resize-value-str <> '':U
     3350             then do:
     3351               run diasize_change-height in this-procedure
     3352                 (input  integer(v-resize-value-str)
     3353                 ,input  true
     3354                 ) .
     3355               assign
     3356                 v-restore-saved = true
     3357               .
     3358             end.
     3359           end.
     3360           if connected("ub") = true
     3361           then do:
     3362             run gbl/wndsizer.p
     3363               (input  v-cntxt-db-num
     3364               ,input  v-cntxt-userid
     3365               ,input  v-diasize-proc-name
     3366               ,input  'width':u
     3367               ,output v-resize-value-str
     3368               ) .
     3369             if v-resize-value-str <> '':U
     3370             then do:
     3371               run diasize_change-width in this-procedure
     3372                 (input  integer(v-resize-value-str)
     3373                 ,input  true
     3374                 ) .
     3375               assign
     3376                 v-restore-saved = true
     3377               .
     3378             end.
     3379           end.
     3380           if v-restore-saved <> true
     3381           then do:
     3382             if v-diasize-wndmax = true
     3383             then do:
     3384               run diasize_maximize in this-procedure
     3385                 (input  true
     3386                 ) .
     3387             end.
     3388           end.
     3389         end.
     3390         else do:
     3391           if v-diasize-wndmax = true
     3392           then do:
     3393             run diasize_maximize in this-procedure
     3394               (input  true
     3395               ) .
     3396           end.
     3397         end.
     3398       end.
     3399     end.
     3400   end procedure.
     3401   procedure diasize_need-full-display :
     3402     define output parameter p-need-full-display as logical   no-undo .
     3403     do
     3404     on error undo, return error return-value
     3405     :
     3406       assign
     3407         p-need-full-display = v-diasize-need-full-display
     3408       .
     3409       assign
     3410         v-diasize-need-full-display = false
     3411       .
     3412     end.
     3413   end procedure.
     3414   procedure get-context :
     3415      define output parameter p-db-num as integer          no-undo.
     3416      define output parameter p-user-id as character        no-undo.
     3417      define variable v-login               as character    no-undo.
     3418      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3419      define buffer buf_user-login  for ub.user-login .
     3420      do
     3421      on error undo, return error
     3422      :
     3423            FIND FIRST buf_sys-ctrl no-lock.
     3424            ASSIGN
     3425               v-login = USERID("ub")
     3426               p-db-num = buf_sys-ctrl.db-num
     3427            .
     3428            FIND FIRST buf_user-login
     3429                 WHERE buf_user-login.db-num = p-db-num
     3430                   AND buf_user-login.user-login = v-login
     3431                 no-lock
     3432                 no-error
     3433                 .
     3434            IF AVAILABLE buf_user-login
     3435            THEN DO:
     3436               assign
     3437                  p-user-id = buf_user-login.user-id
     3438               .
     3439            END.
     3440      end.
     3441   end procedure.
     3442   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3443   on f5 of frame Dialog-Frame anywhere
     3444   do:
     3445     run OpenBr(yes, no, '':U).
     3446       apply "VALUE-CHANGED" to br-docs.
     3447   end.
     3448   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3449   DEF VAR cur-clmn-numbr-docs as INT EXTENT 12 no-undo.
     3450   DEF VAR varmvibr-docs       as INT no-undo.
     3451   DEF VAR varmvjbr-docs       as INT no-undo.
     3452   DEF VAR varmvkbr-docs       as INT no-undo.
     3453   DEF VAR varmvlbr-docs       as INT no-undo.
     3454   DEF VAR move-elementbr-docs as INT no-undo.
     3455   def var jjbr-docs           as int no-undo.
     3456   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     3457     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     3458   END.
     3459   RUN start-mv-clmnbr-docs.
     3460   PROCEDURE start-mv-clmnbr-docs:
     3461   def var old-session as logical no-undo.
     3462      old-session = SESSION:IMMEDIATE-DISPLAY.
     3463      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3464      SESSION:IMMEDIATE-DISPLAY = old-session.
     3465   END.
     3466   ON ctrl-cursor-right OF BROWSE br-docs do:
     3467     RUN re-move-clmnbr-docs ( 5, 12).
     3468   END.
     3469   ON ctrl-cursor-left OF BROWSE br-docs do:
     3470     RUN re-move-clmnbr-docs (12, 5).
     3471   END.
     3472   PROCEDURE re-move-clmnbr-docs:
     3473     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3474     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3475     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3476       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     3477     END.
     3478     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3479     if source-column > target-column THEN
     3480     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     3481       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3482           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3483             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     3484           END.
     3485       END.
     3486     END.
     3487     ELSE
     3488     DO varmvjbr-docs = source-column + 1 to target-column:
     3489       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3490         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3491           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     3492         END.
     3493       END.
     3494     END.
     3495     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3496       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     3497     END.
     3498   END PROCEDURE.
     3499   PROCEDURE ch-clmnbr-docs:
     3500     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3501     if cur-clmn-loc <= 5 then do:
     3502       return .
     3503     end.
     3504     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3505       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     3506     END.
     3507     RUN re-move-clmnbr-docs (cur-clmn-loc, 5).
     3508   END PROCEDURE.
     3509   PROCEDURE mv-brw-defaultbr-docs:
     3510   def var old-session as logical no-undo.
     3511     old-session = SESSION:IMMEDIATE-DISPLAY.
     3512     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3513     do varmvlbr-docs = 5 to EXTENT(cur-clmn-numbr-docs):
     3514       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     3515     END.
     3516     RUN start-mv-clmnbr-docs.
     3517     SESSION:IMMEDIATE-DISPLAY = old-session.
     3518   END PROCEDURE.
     3519   .
     3520   def var sort-labelbr-docs   as character no-undo .
     3521   def var sort-clmnbr-docs    as handle    no-undo .
     3522   def var cur-clmnbr-docs     as handle    no-undo .
     3523   def var cur-clmn-locbr-docs as integer   no-undo .
     3524   def var re-querybr-docs     as logical   initial no no-undo .
     3525   on start-search, ctrl-o of br-docs in frame Dialog-Frame do:
     3526      run sort-brbr-docs
     3527        (input (if available buf-oo_ord-doc
     3528                then recid(buf-oo_ord-doc)
     3529                else ?
     3530               )
     3531        ).
     3532   end.
     3533   PROCEDURE sort-brbr-docs :
     3534     define input parameter p-recid as recid no-undo .
     3535     if re-querybr-docs = no then do:
     3536       assign
     3537          cur-clmnbr-docs = br-docs:current-column in frame Dialog-Frame
     3538       .
     3539       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     3540       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     3541         assign
     3542            sort-labelbr-docs = ""
     3543            sort-clmnbr-docs = ?
     3544         .
     3545        end.
     3546        else do:
     3547          assign
     3548            sort-labelbr-docs = cur-clmnbr-docs:label
     3549            sort-clmnbr-docs  = cur-clmnbr-docs
     3550            sort-clmnbr-docs:column-fgcolor = 4
     3551          .
     3552        end.
     3553      end.
     3554     assign
     3555       cur-clmn-locbr-docs = 1
     3556     .
     3557     def var column-handle as handle no-undo .
     3558     column-handle = br-docs:first-column.
     3559     do while valid-handle(column-handle) :
     3560       if column-handle = cur-clmnbr-docs then do:
     3561         leave .
     3562       end.
     3563       column-handle = column-handle:NEXT-COLUMN.
     3564       assign
     3565         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     3566       .
     3567     end.
     3568     case sort-labelbr-docs:
     3569           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf-oo_ord-doc), &1&2&1)', chr(34), rid-list)     .     run OpenBr(yes, no, '':U).   . END.
     3570           when 'Статус'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.status_"     .     run OpenBr(yes, no, '':U).   . END.
     3571           when 'OK'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.flag_"     .     run OpenBr(yes, no, '':U).   . END.
     3572           when '№ док-та'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3573           when 'Создан'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.doc-date"     .     run OpenBr(yes, no, '':U).   . END.
     3574           when 'Факт'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.fact-date"     .     run OpenBr(yes, no, '':U).   . END.
     3575           when 'Объект'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.obj-code"     .     run OpenBr(yes, no, '':U).   . END.
     3576           when 'Тип'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.obj-type"     .     run OpenBr(yes, no, '':U).   . END.
     3577           when 'Нераспред.!остаток'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.out-code"     .     run OpenBr(yes, no, '':U).   . END.
     3578           when 'Количество'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.qnty"     .     run OpenBr(yes, no, '':U).   . END.
     3579           when 'Сумма в руб.'  then DO:    assign       sort-column-name = "buf-oo_ord-doc.sum-rubl"     .     run OpenBr(yes, no, '':U).   . END.
     3580           when '>'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-direct&1, recid(buf-oo_ord-doc))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     3581       otherwise do:
     3582         assign
     3583           sort-column-name = ""
     3584         .
     3585         run OpenBr(yes, no, '':U).
     3586           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-docs') then do:
     3587             run mv-brw-defaultbr-docs.
     3588           end.
     3589         if sort-labelbr-docs <> "" then do:
     3590           assign
     3591             cur-clmnbr-docs:column-fgcolor = 0
     3592           .
     3593         end.
     3594         assign
     3595           cur-clmn-locbr-docs = ?
     3596         .
     3597       end.
     3598     end case.
     3599       if cur-clmn-locbr-docs <> ? then do:
     3600         if can-do( this-procedure:internal-entries, 'ch-clmnbr-docs') then do:
     3601           run ch-clmnbr-docs in this-procedure (cur-clmn-locbr-docs).
     3602         end.
     3603       end.
     3604     if p-recid <> ? then do:
     3605       reposition br-docs to recid p-recid no-error.
     3606       apply "value-changed" to br-docs in frame Dialog-Frame.
     3607     end.
     3608     apply "entry" to br-docs in frame Dialog-Frame.
     3609   END PROCEDURE.
     3610   procedure re-open-query-srt-clmnbr-docs:
     3611   if cur-clmnbr-docs = ? then do:
     3612      run OpenBr(yes, no, '':U).
     3613   end.
     3614   else do:
     3615      assign re-querybr-docs = yes.
     3616      run sort-brbr-docs
     3617        (input (if available buf-oo_ord-doc
     3618                then recid(buf-oo_ord-doc)
     3619                else ?
     3620               )
     3621        ).
     3622      assign re-querybr-docs = no.
     3623   end.
     3624   end.
     3625   MAIN-BLOCK:
     3626   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3627      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3628      buf-oo_ord-doc.status_:read-only in browse br-docs = true .
     3629      buf-oo_ord-doc.doc-code:resizable in browse br-docs = true .
     3630      buf-oo_ord-doc.out-code:resizable in browse br-docs = true .
     3631      define buffer find_code for ub.ord-doc.
     3632         if pardoc-rec <> ? then do:
     3633         FIND FIRST find_code No-LOCK where
     3634                    recid(find_code) = pardoc-rec No-ERROR.
     3635         if not avail find_code then do:
     3636           message
     3637           vss-workfile vss-revision vss-description skip
     3638           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3639           view-as alert-box error .
     3640           return error.
     3641         end.
     3642         doc-rec = pardoc-rec.
     3643       end.
     3644     run my-enable_ui in this-procedure .
     3645     run openbr in this-procedure (yes, no, '':u).
     3646     if pardoc-rec <> ? then
     3647     reposition br-docs to recid doc-rec no-error.
     3648     run diasize_add_browse in this-procedure
     3649         (input  'width':u
     3650         ,input  browse br-zapr :handle
     3651         ) .
     3652     run diasize_init in this-procedure .
     3653     WAIT-FOR GO OF FRAME Dialog-Frame focus br-docs.
     3654   END.
     3655   run disable_ui in this-procedure .
     3656   PROCEDURE close-zapr :
     3657    do
     3658    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3659    :
     3660   define input parameter p-trn-code as character no-undo .
     3661   define buffer buf_s-trn-doc for ub.trn-doc.
     3662   define variable varmode            as   character           no-undo.
     3663   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3664   define variable varflag            like ub.trn-doc.flag     no-undo.
     3665   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3666   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3667   define variable varcheck-return as logical no-undo .
     3668   define variable varchg-inv as logical no-undo .
     3669   assign
     3670     varmode        =  '<закрытие документа>':U
     3671     varstatus      = 'запрос':U
     3672     varflag        = false
     3673     varcopystatus  = 'запрос':U
     3674     varcopyflag    = true
     3675     varcheck-return = true
     3676     varchg-inv = true
     3677     .
     3678   run str/trn-graf.p
     3679       (input  p-trn-code,
     3680        input  v-cntxt-db-num,
     3681        input  varmode,
     3682        output varstatus,
     3683        output varflag,
     3684        output varcopystatus,
     3685        output varcopyflag
     3686       ) no-error.
     3687   .
     3688   if error-status:error then do:
     3689      if error-status :get-message(1) <> "" or
     3690         return-value = ""                  then do:
     3691        message "Ошибка при вызове trn-graf.p." skip
     3692        error-status :get-message(1) skip
     3693        return-value skip
     3694        view-as alert-box error.
     3695      end.
     3696      else do:
     3697        message return-value
     3698        view-as alert-box error.
     3699      end.
     3700      return error.
     3701   end.
     3702   define variable g#in-ov       like  ub.sysconf.in-ov     no-undo .
     3703   define variable g#rsrv-time   like  ub.sysconf.rsrv-time no-undo .
     3704   define variable g#load-time   like  ub.sysconf.load-time no-undo .
     3705   define variable g#holidays    like  ub.sysconf.holidays  no-undo .
     3706   define buffer buf_sysconf for ub.sysconf  .
     3707   find first buf_sysconf no-lock where   buf_sysconf.host-code = par-host-code no-error .
     3708   if error-status :error then message
     3709     vss-workfile vss-revision vss-description skip
     3710     error-status :get-message(1) skip
     3711     return-value skip
     3712     "Не верный код фирмы" par-host-code
     3713     view-as alert-box error
     3714   .
     3715   assign
     3716       g#in-ov      = buf_sysconf.in-ov
     3717       g#rsrv-time  = buf_sysconf.rsrv-time
     3718       g#load-time  = buf_sysconf.load-time
     3719       g#holidays   = buf_sysconf.holidays
     3720   .
     3721   run str/trn-stat.p (
     3722                   input  parParentProc ,
     3723                   input this-procedure ,
     3724                   input  varmode,
     3725                   input  p-trn-code,
     3726                   input  varcheck-return,
     3727                   input  v-cntxt-db-num,
     3728                   input  g#in-ov,
     3729                   input  g#rsrv-time,
     3730                   input  g#load-time,
     3731                   input  g#holidays,
     3732                   input  yes,
     3733                   output varchg-inv,
     3734                   output table gds-list) no-error.
     3735   if error-status:error then do:
     3736      message
     3737        vss-workfile vss-revision vss-description skip
     3738        "Ошибка при принудительном закрытии документа " p-trn-code skip
     3739        return-value skip
     3740        trim(error-status :get-message(1))
     3741        trim(error-status :get-message(2))
     3742        trim(error-status :get-message(3))
     3743        trim(error-status :get-message(4))
     3744        trim(error-status :get-message(5)) skip
     3745        view-as alert-box error.
     3746      return error.
     3747   end.
     3748     end.
     3749   END PROCEDURE.
     3750   PROCEDURE disable_UI :
     3751     HIDE FRAME Dialog-Frame.
     3752   END PROCEDURE.
     3753   PROCEDURE enable_UI :
     3754     DISPLAY sch-code sch-date sch-fact loc-ps sch-num loc-boss loc-agnt
     3755             loc-wrkr loc-creid
     3756         WITH FRAME Dialog-Frame.
     3757     ENABLE b-quit b-sel b-close b-open b-move-to b-sch b-history b-help b-mark
     3758            b-add b-lkp b-chg b-del b-move b-print sch-code sch-date sch-fact
     3759            br-docs loc-ps B-lkp-2 br-zapr sch-num loc-boss loc-agnt
     3760            loc-wrkr loc-creid
     3761         WITH FRAME Dialog-Frame.
     3762     VIEW FRAME Dialog-Frame.
     3763     OPEN QUERY br-docs FOR EACH buf-oo_ord-doc NO-LOCK.    OPEN QUERY br-zapr FOR EACH buf-oo_ord-doc-rcv WHERE                   buf-oo_ord-doc-rcv.doc-code = buf-oo_ord-doc.doc-code NO-LOCK,            each ub.ord-chain no-lock where             ub.ord-chain.doc-code = buf-oo_ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and             ub.ord-chain.rel-doc-type = 'trn'    ,              EACH buf-oo_trn-doc  where                  buf-oo_trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK.
     3764   END PROCEDURE.
     3765   PROCEDURE main-ord :
     3766    do
     3767    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3768    :
     3769   define input parameter   p-in-ord-num as character no-undo .
     3770   define output parameter  p-out-ord-num as character no-undo .
     3771   if num-entries(p-in-ord-num , "." ) = 1 then
     3772      p-out-ord-num = p-in-ord-num .
     3773      else do:
     3774        p-out-ord-num = entry(1, entry( 1 , p-in-ord-num , "." ) , "-" )  + "-" + entry( 2 , p-in-ord-num , "."  ) .
     3775      end.
     3776     end.
     3777   END PROCEDURE.
     3778   PROCEDURE my-enable_UI :
     3779    do
     3780    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3781    :
     3782     if v-cntxt-db-num = 0 then
     3783     assign
     3784       b-move-to:label in frame Dialog-Frame  = "---> УБД"
     3785     .
     3786     else
     3787     assign
     3788       b-move-to:label in frame Dialog-Frame  = "---> ГБД"
     3789     .
     3790     DISPLAY
     3791        sch-code sch-date sch-fact
     3792         WITH FRAME Dialog-Frame.
     3793     ENABLE b-quit
     3794            b-mark       when LOOKUP("b-mark":U,  bttns) > 0
     3795            b-sel        when LOOKUP("b-sel":U,   bttns) > 0
     3796            b-history
     3797            b-sch
     3798            b-help
     3799            b-add        when LOOKUP("b-add":U,  bttns) > 0
     3800            b-lkp
     3801            b-lkp-2
     3802            b-chg        when LOOKUP("b-chg":U,  bttns) > 0
     3803            b-del        when LOOKUP("b-del":U,  bttns) > 0
     3804            b-close
     3805            b-open
     3806            b-print
     3807            b-move
     3808            b-move-to
     3809            sch-code sch-date sch-fact
     3810            br-docs br-zapr
     3811            loc-ps
     3812         WITH FRAME Dialog-Frame.
     3813     VIEW FRAME Dialog-Frame.
     3814     end.
     3815   END PROCEDURE.
     3816   PROCEDURE OpenBr :
     3817    do
     3818    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3819    :
     3820   define input  parameter p-open-query     as logical   no-undo .
     3821   define input  parameter p-find-next      as logical   no-undo .
     3822   define input  parameter p-find-condition as character no-undo .
     3823   define variable l-query-was-opened as logical no-undo .
     3824   define variable title0 as character no-undo.
     3825   define variable p-file-label as character no-undo .
     3826   p-file-label = "Заказы Объект-Объект".
     3827   title0 = caps(p-file-label) + chr(32).
     3828   define variable sort-column-phrase as character no-undo .
     3829   case sort-column-name :
     3830     when "" then do:
     3831       assign
     3832         sort-column-phrase = ""
     3833       .
     3834     end.
     3835     otherwise do:
     3836       assign
     3837         sort-column-phrase = "by " + sort-column-name
     3838       .
     3839     end.
     3840   end case.
     3841   define variable l-open-query as logical   no-undo .
     3842   find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3843   if not available buf_clients then return .
     3844   filter-point = filter-point0 + par-mode.
     3845     CASE par-mode :
     3846       WHEN 'объ':U THEN DO:
     3847          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name
     3848                                             + " Объект: " +  p-obj-type
     3849                                             + "  " +   string (p-obj-code)
     3850                                             .
     3851   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3852   define variable  l-disable-where-33  as logical   no-undo .
     3853   define variable  l-filter-open-33    as logical   .
     3854   define variable  flt-rec-33       as recid     no-undo .
     3855   define variable  filter-name-33      as character no-undo .
     3856   define variable  where-phrase-33     as character no-undo .
     3857   define variable  sort-phrase-33      as character no-undo .
     3858   define variable  where-phrase-rus-33 as character no-undo .
     3859   define variable  sort-phrase-rus-33  as character no-undo .
     3860   run gbl/flt-get.p
     3861     (input filter-point
     3862     ,output flt-rec-33
     3863     ,output filter-name-33
     3864     ,output where-phrase-33
     3865     ,output sort-phrase-33
     3866     ,output where-phrase-rus-33
     3867     ,output sort-phrase-rus-33
     3868     ).
     3869   if p-open-query then do:
     3870       run set-filter-name in this-procedure
     3871         (INPUT filter-name-33
     3872         ) no-error .
     3873     assign
     3874       l-filter-open-33 = false
     3875     .
     3876     if flt-rec-33 <> ?
     3877       or sort-column-phrase > ""
     3878     then do:
     3879       define variable  parameter-2-33 as character no-undo .
     3880       define variable  parameter-3-33 as character no-undo .
     3881       define variable  parameter-4-33 as character no-undo .
     3882       define variable  parameter-5-33 as character no-undo .
     3883       define variable  parameter-6-33 as character no-undo .
     3884       define variable  parameter-7-33 as character no-undo .
     3885         assign
     3886         parameter-3-33 =
     3887                                 "FOR EACH buf-oo_ord-doc"
     3888         parameter-4-33 =
     3889           (
     3890             if (" buf-oo_ord-doc.host-code = par-host-code and buf-oo_ord-doc.obj-code = p-obj-code and buf-oo_ord-doc.obj-type = p-obj-type and buf-oo_ord-doc.doc-type = p-doc-type" + " " + where-phrase-33) <> ""
     3891             then  substitute('buf-oo_ord-doc.host-code = &2 and buf-oo_ord-doc.obj-code = &3 and buf-oo_ord-doc.obj-type = &1&4&1 and buf-oo_ord-doc.doc-type = &1&5&1', chr(34) ,par-host-code , p-obj-code , p-obj-type , p-doc-type)  + " " + where-phrase-33
     3892             else "true"
     3893           )
     3894         parameter-5-33 = (" " + "" + " " + "")
     3895         parameter-6-33 = if sort-phrase-33 = ''
     3896                              then
     3897           (
     3898           " " + " USE-INDEX by-obj " +
     3899             " " + sort-column-phrase +
     3900           " " + " "
     3901           )
     3902                              else
     3903           (
     3904           " " + " USE-INDEX by-obj " +
     3905             " " + sort-column-phrase +
     3906           " " + sort-phrase-33
     3907           )
     3908         parameter-7-33 =
     3909           "   "
     3910       .
     3911       do
     3912       on stop undo, leave
     3913       on error undo, leave
     3914       :
     3915         assign
     3916           l-disable-where-33 =
     3917             (" buf-oo_ord-doc.host-code = par-host-code and buf-oo_ord-doc.obj-code = p-obj-code and buf-oo_ord-doc.obj-type = p-obj-type and buf-oo_ord-doc.doc-type = p-doc-type" + " " + where-phrase-33 = "")
     3918         .
     3919         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3920                             ,input query br-docs:handle
     3921                             ,input parameter-3-33
     3922                             ,input parameter-4-33
     3923                             ,input parameter-5-33
     3924                             ,input parameter-6-33
     3925                             ,input parameter-7-33
     3926                             )
     3927         .
     3928         assign
     3929           l-filter-open-33 = true
     3930         .
     3931       end.
     3932       if l-filter-open-33 = false then do:
     3933         message
     3934           "Ошибка при фильтрации / сортировке" skip
     3935           "Будут показаны записи без учета фильтра" skip
     3936           view-as alert-box .
     3937       end.
     3938       else do:
     3939           assign
     3940             l-query-was-opened = true
     3941           .
     3942       end.
     3943     end.
     3944     if l-filter-open-33 = false then do:
     3945       OPEN QUERY br-docs FOR EACH buf-oo_ord-doc
     3946         where  buf-oo_ord-doc.host-code = par-host-code and buf-oo_ord-doc.obj-code = p-obj-code and buf-oo_ord-doc.obj-type = p-obj-type and buf-oo_ord-doc.doc-type = p-doc-type
     3947          USE-INDEX by-obj
     3948     .
     3949         assign
     3950           l-query-was-opened = true
     3951         .
     3952     end.
     3953   end.
     3954   else do:
     3955     assign
     3956       doc-rec = recid( buf-oo_ord-doc )
     3957     .
     3958     do
     3959     on stop undo, leave
     3960     on error undo, leave
     3961     :
     3962       if query br-docs:handle:get-buffer-handle(1) = (buffer buf-oo_ord-doc:handle) then do:
     3963         assign
     3964         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3965         parameter-4-33 =
     3966           "where ":u +  substitute('buf-oo_ord-doc.host-code = &2 and buf-oo_ord-doc.obj-code = &3 and buf-oo_ord-doc.obj-type = &1&4&1 and buf-oo_ord-doc.doc-type = &1&5&1', chr(34) ,par-host-code , p-obj-code , p-obj-type , p-doc-type)  + " ":u + where-phrase-33 + " ":u + p-find-condition + " " + ""
     3967         parameter-5-33 = " USE-INDEX by-obj "
     3968       .
     3969         run fltopend_fltfindd in this-procedure  (
     3970                             input this-procedure:handle
     3971                             ,input query br-docs:handle
     3972                             ,input rowid(buf-oo_ord-doc)
     3973                             ,input logical(parameter-2-33)
     3974                             ,input no-lock
     3975                             ,input (buffer buf-oo_ord-doc:handle)
     3976                             ,input parameter-4-33
     3977                             ,input parameter-5-33
     3978                             ) no-error.
     3979         .
     3980         assign
     3981           doc-rec = integer(return-value)
     3982           v-fltopend-rowid[1] = ?
     3983         .
     3984       end.
     3985       else do:
     3986         assign
     3987         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3988         parameter-3-33 =  "FOR EACH buf-oo_ord-doc"
     3989         parameter-4-33 =
     3990           (
     3991             if (" buf-oo_ord-doc.host-code = par-host-code and buf-oo_ord-doc.obj-code = p-obj-code and buf-oo_ord-doc.obj-type = p-obj-type and buf-oo_ord-doc.doc-type = p-doc-type" + " " + where-phrase-33) <> ""
     3992             then  substitute('buf-oo_ord-doc.host-code = &2 and buf-oo_ord-doc.obj-code = &3 and buf-oo_ord-doc.obj-type = &1&4&1 and buf-oo_ord-doc.doc-type = &1&5&1', chr(34) ,par-host-code , p-obj-code , p-obj-type , p-doc-type)  + " " + where-phrase-33
     3993             else "true"
     3994           )
     3995         parameter-5-33 = (" " + "" + " " + "" + " " + p-find-condition)
     3996         parameter-6-33 = if sort-phrase-33 = ''
     3997                              then
     3998           (
     3999           " " + " USE-INDEX by-obj " +
     4000             " " + sort-column-phrase +
     4001           " " + " "
     4002           )
     4003                              else
     4004           (
     4005           " " + " USE-INDEX by-obj " +
     4006             " " + sort-column-phrase +
     4007           " " + sort-phrase-33
     4008           )
     4009         parameter-7-33 =
     4010           "   "
     4011       .
     4012         run fltopend_fltfindq in this-procedure  (
     4013                             input this-procedure:handle
     4014                             ,input query br-docs:handle
     4015                             ,input logical(parameter-2-33)
     4016                             ,input no-lock
     4017                             ,input parameter-3-33
     4018                             ,input parameter-4-33
     4019                             ,input parameter-5-33
     4020                             ,input parameter-6-33
     4021                             ,input parameter-7-33
     4022                             ,output v-fltopend-rowid
     4023                             ) no-error.
     4024         .
     4025         doc-rec = ?.
     4026       end.
     4027       assign
