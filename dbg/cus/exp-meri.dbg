        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Экспорт результатов продаж".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     define variable v-cntxt-db-num        as integer   no-undo .
      115     define variable v-cntxt-userid        as character no-undo .
      116     define variable v-cntxt-level         as character no-undo .
      117     define variable v-cntxt-host-code-obj as integer   no-undo .
      118     define variable v-cntxt-obj-type      as character no-undo .
      119     define variable v-cntxt-obj-code      as integer   no-undo .
      120     define variable v-cntxt-db-num-obj    as integer   no-undo .
      121     define variable v-cntxt-is-admin      as logical   no-undo .
      122   define stream txt.
      123   define variable prt-name as char no-undo.
      124   define variable t1 as char no-undo.
      125   define variable ref-list as char no-undo.
      126   define buffer ret-doc for ub.trn-doc.
      127   define variable parts_qnty as dec no-undo.
      128   define variable p-t like ub.doc-line.prod-type no-undo.
      129   define variable p-c like ub.doc-line.prod-code no-undo.
      130   define variable p-a like ub.doc-line.artic no-undo.
      131   define variable b-c like ub.chk-gds.src-code no-undo.
      132   define variable chk-qnty like ub.doc-line.fact-qnty no-undo.
      133   define variable chk-price like ub.doc-line.price-base no-undo.
      134   DEFINE BUTTON B-file
      135        IMAGE-UP FILE "btn-down-arrow":U
      136        IMAGE-DOWN FILE "btn-down-arrow":U
      137        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      138        LABEL ""
      139        SIZE 3 BY 1.
      140   DEFINE BUTTON B-file-2
      141        IMAGE-UP FILE "btn-down-arrow":U
      142        IMAGE-DOWN FILE "btn-down-arrow":U
      143        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      144        LABEL ""
      145        SIZE 3 BY 1.25.
      146   DEFINE BUTTON b-help
      147        LABEL "Помо&щь"
      148        SIZE 10 BY 1.
      149   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      150        LABEL "&Отмена"
      151        SIZE 10 BY 1
      152        BGCOLOR 8 .
      153   DEFINE BUTTON Btn_OK AUTO-GO
      154        LABEL "&Ввод"
      155        SIZE 10 BY 1
      156        BGCOLOR 8 .
      157   DEFINE VARIABLE cli-code AS INTEGER FORMAT ">>>>>>>>>9":U INITIAL 0
      158        LABEL "Поставщик"
      159        VIEW-AS FILL-IN
      160        SIZE 10 BY 1 NO-UNDO.
      161   DEFINE VARIABLE cli-name AS CHARACTER FORMAT "X(25)":U
      162        VIEW-AS FILL-IN
      163        SIZE 24.5 BY 1 NO-UNDO.
      164   DEFINE VARIABLE date-beg AS DATE FORMAT "99/99/9999":U
      165        LABEL "Даты С"
      166        VIEW-AS FILL-IN
      167        SIZE 12 BY 1 NO-UNDO.
      168   DEFINE VARIABLE date-End AS DATE FORMAT "99/99/9999":U
      169        LABEL "По"
      170        VIEW-AS FILL-IN
      171        SIZE 11.5 BY 1 NO-UNDO.
      172   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      173        LABEL "Файл"
      174        VIEW-AS FILL-IN
      175        SIZE 40 BY 1 NO-UNDO.
      176   DEFINE FRAME Dialog-Frame
      177        Btn_OK AT ROW 1 COL 1
      178        Btn_Cancel AT ROW 1 COL 11
      179        b-help AT ROW 1 COL 21
      180        date-beg AT ROW 2.75 COL 10.5 COLON-ALIGNED
      181        date-End AT ROW 2.75 COL 30 COLON-ALIGNED
      182        cli-code AT ROW 4.25 COL 11.5 COLON-ALIGNED
      183        cli-name AT ROW 4.25 COL 22 COLON-ALIGNED NO-LABEL
      184        B-file AT ROW 4.25 COL 48.5
      185        B-file-2 AT ROW 5.5 COL 48.5
      186        file-name AT ROW 5.75 COL 2.5
      187        SPACE(4.62) SKIP(0.62)
      188       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      189            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      190            TITLE "Экспорт чеков по поставщику в файл"
      191            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      192   ASSIGN
      193          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      194          FRAME Dialog-Frame:HIDDEN           = TRUE.
      195   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      196   DO:
      197     APPLY "END-ERROR":U TO SELF.
      198   END.
      199   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      200   DO:
      201     run ref/cli-all.w (input parparentproc, "b-sel,b-add", ?, ?, ?, ?, ?, ?, output ref-list).
      202     if ref-list = "" then
      203       return no-apply.
      204     find ub.clients where recid (ub.clients) = integer (ref-list) no-lock.
      205     if avail ub.clients then do:
      206        assign
      207            cli-code = ub.clients.obj-code
      208            cli-name = ub.clients.obj-name.
      209            DISP cli-code cli-name WITH FRAME Dialog-Frame.
      210     end.
      211     else     return no-apply.
      212   END.
      213   ON CHOOSE OF B-file-2 IN FRAME Dialog-Frame
      214   DO:
      215       DEF VAR ll_commit AS LOG    NO-UNDO INIT NO.
      216       SYSTEM-DIALOG GET-FILE file-name
      217           TITLE "Выберите файл для экспорта"
      218           FILTERS
      219             " Текстовые файлы (*.txt) " "*.txt",
      220             " Все файлы (*.*) "                      "*.*"
      221           ask-overwrite
      222           save-as
      223           use-filename
      224           update ll_commit
      225           default-extension "txt"
      226           .
      227       IF ll_commit <> YES THEN do:
      228          RETURN NO-APPLY.
      229       end.
      230       IF file-name = PROGRAM-NAME( 1 ) THEN DO:
      231           BELL.
      232           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      233           RETURN NO-APPLY.
      234       END.
      235       ASSIGN file-name = ( IF SEARCH( file-name ) = ? THEN file-name ELSE SEARCH( file-name ) ).
      236       DISP file-name WITH FRAME Dialog-Frame.
      237   END.
      238   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      239   DO:
      240   define buffer buf_inkas for ub.inkas.
      241   define buffer buf_trn-doc for ub.trn-doc.
      242   define buffer buf_chk-doc for ub.chk-doc.
      243   define buffer buf_chk-gds for ub.chk-gds.
      244   define buffer buf_goods for ub.goods.
      245   define buffer buf_bar-code for ub.bar-code.
      246   define buffer buf_parts for ub.parts.
      247   define buffer buf_doc-line for ub.doc-line.
      248   define variable v-gds-code as integer no-undo .
      249   assign
      250   date-beg
      251   date-end
      252   .
      253   if date-beg > date-end then do:
      254     message
      255     "Дата начала периода должна быть меньше даты конца"
      256     view-as alert-box error .
      257     undo, return no-apply.
      258   end.
      259   if date-beg = ? then do:
      260     message
      261     "Не задана дата C"
      262     view-as alert-box error .
      263     undo, return no-apply.
      264   end.
      265   if date-end = ? then do:
      266     message
      267     "Не задана дата По"
      268     view-as alert-box error .
      269     undo, return no-apply.
      270   end.
      271   if trim(file-name) = "" then do:
      272     message
      273     "Не задан файл для экспорта"
      274     view-as alert-box error .
      275     undo, return no-apply.
      276   end.
      277   output stream txt to value (file-name) no-echo.
      278   FOR EACH buf_inkas no-LOCK where
      279   buf_inkas.doc-date >= date-beg AND
      280   buf_inkas.doc-date <= date-end AND
      281   buf_inkas.obj-type = v-cntxt-obj-type AND
      282   buf_inkas.obj-code = v-cntxt-obj-code AND
      283   buf_inkas.status_ = 'факт':U
      284   by buf_inkas.doc-date :
      285     FIND FIRST buf_trn-doc No-LOCK WHERE buf_trn-doc.doc-code = buf_inkas.inkas-code   NO-ERROR.
      286     if avail buf_trn-doc
      287     then do:
      288       assign
      289       b-c = ""
      290       chk-price = 0
      291       chk-qnty = 0
      292       p-t = ""
      293       p-c = ?
      294       p-a = ""
      295       parts_qnty = 0
      296       v-gds-code = 0
      297       .
      298       FOR  each buf_doc-line NO-LOCk WHERE buf_doc-line.doc-code = buf_trn-doc.doc-code
      299       by buf_doc-line.prod-type
      300       by buf_doc-line.prod-code
      301       by buf_doc-line.artic
      302       :
      303         display
      304         buf_doc-line.doc-code
      305         buf_doc-line.artic
      306         with frame ff view-as dialog-box
      307         title ": Экспорт чеков в файл".
      308         pause 0.
      309         if p-c <> ? then do:
      310           if  p-t <> buf_doc-line.prod-type
      311           or  p-c <> buf_doc-line.prod-code
      312           or p-a <> buf_doc-line.artic   then do:
      313             if  parts_qnty <> 0 then do:
      314               for each buf_CHK-GDS no-lock where
      315               buf_CHK-GDS.out-code = buf_trn-doc.doc-code   and
      316               buf_CHK-GDS.doc-qnty <> 0          :
      317                 find buf_bar-code where buf_bar-code.b-code = buf_CHK-GDS.b-code no-lock no-error.
      318                 if not avail buf_bar-code then next.
      319                 if  buf_bar-code.gds-code = v-gds-code then do:
      320                   chk-qnty = chk-qnty + buf_CHK-GDS.doc-qnty.
      321                   chk-price = chk-price + ((buf_CHK-GDS.price-base - buf_CHK-GDS.discnt) * buf_CHK-GDS.doc-qnty).
      322                   b-c = entry(1, buf_CHK-GDS.src-code, chr(4)).
      323                 end.
      324               end.
      325               if parts_qnty > 0 then do:
      326                 put stream txt unformatted
      327                 trim(string(buf_trn-doc.fact-date, "99/99/9999"))  ";"
      328                 trim(string(b-c)) ";"
      329                 trim(string(parts_qnty)) ";"
      330                 trim(string(chk-price / chk-qnty, "->>>,>>>,>>9.99"))  ";1;"
      331                 trim(string(cli-code))
      332                 skip.
      333                 assign
      334                 b-c = ""
      335                 chk-price = 0
      336                 chk-qnty = 0
      337                 parts_qnty = 0.
      338               end.
      339             end.
      340             assign
      341             p-t  = buf_doc-line.prod-type
      342             p-c  = buf_doc-line.prod-code
      343             p-a  = buf_doc-line.artic
      344             b-c = ""
      345             chk-price = 0
      346             chk-qnty = 0
      347             parts_qnty = 0.
      348           end.
      349         end.
      350         find buf_goods  where
      351             buf_goods.prod-type = buf_doc-line.prod-type and
      352             buf_goods.prod-code = buf_doc-line.prod-code and
      353             buf_goods.artic         = buf_doc-line.artic no-lock no-error.
      354         assign
      355         p-t  = buf_doc-line.prod-type
      356         p-c  = buf_doc-line.prod-code
      357         p-a  = buf_doc-line.artic
      358         b-c = ""
      359         v-gds-code = buf_goods.gds-code
      360         chk-price = 0
      361         chk-qnty = 0
      362         parts_qnty = 0.
      363         FOR EACH buf_parts NO-LOCK WHERE
      364                 buf_parts.obj-type  = buf_doc-line.obj-type AND
      365                 buf_parts.obj-code  = buf_doc-line.obj-code AND
      366                 buf_parts.artic        = buf_doc-line.artic AND
      367                 buf_parts.prod-type = buf_doc-line.prod-type AND
      368                 buf_parts.prod-code = buf_doc-line.prod-code AND
      369                 buf_parts.out-code   = buf_doc-line.doc-code
      370                 :
      371           if buf_parts.supp-code <> cli-code  then next.
      372           parts_qnty = parts_qnty + buf_parts.fact-qnty.
      373         end.
      374         if  parts_qnty <> 0 then do:
      375           for each buf_CHK-GDS no-lock where
      376           buf_CHK-GDS.out-code = buf_trn-doc.doc-code and
      377           buf_CHK-GDS.doc-qnty <> 0
      378         :
      379             find buf_bar-code where buf_bar-code.b-code = buf_CHK-GDS.b-code no-lock no-error.
      380             if not avail buf_bar-code then next.
      381             if buf_bar-code.gds-code = buf_goods.gds-code then do:
      382               chk-qnty = chk-qnty + buf_CHK-GDS.doc-qnty.
      383               chk-price = chk-price + ((buf_CHK-GDS.price-base - buf_CHK-GDS.discnt) * buf_CHK-GDS.doc-qnty).
      384               b-c = entry(1, buf_CHK-GDS.src-code, chr(4)).
      385             end.
      386           end.
      387           if parts_qnty > 0 then do:
      388             put stream txt unformatted
      389             trim(string(buf_trn-doc.fact-date, "99/99/9999"))  ";"
      390             trim(string(b-c)) ";"
      391             trim(string(parts_qnty)) ";"
      392             trim(string(chk-price / chk-qnty, "->>>,>>>,>>9.99"))  ";1;"
      393             trim(string(cli-code))
      394             skip.
      395             assign
      396             b-c = ""
      397             chk-price = 0
      398             chk-qnty = 0
      399             parts_qnty = 0.
      400           end.
      401         end.
      402       end.
      403     end.
      404   FIND FIRST ret-doc No-LOCK WHERE ret-doc.doc-code = buf_trn-doc.out-code No-ERROR.
      405   if avail ret-doc
      406   and ret-doc.office = no
      407   then do:
      408     assign
      409     b-c = ""
      410     chk-price = 0
      411     chk-qnty = 0
      412     p-t = ""
      413     p-c = ?
      414     p-a = ""
      415     v-gds-code = 0
      416     .
      417     FOR  each buf_doc-line NO-LOCk WHERE buf_doc-line.doc-code = ret-doc.doc-code
      418     by buf_doc-line.prod-type
      419     by buf_doc-line.prod-code
      420     by buf_doc-line.artic
      421     :
      422       if p-c <> ? then do:
      423         if  p-t <> buf_doc-line.prod-type
      424         or  p-c <> buf_doc-line.prod-code
      425         or p-a <> buf_doc-line.artic   then do:
      426           if  parts_qnty <> 0 then do:
      427             for each buf_CHK-GDS no-lock where
      428                 buf_CHK-GDS.out-code = buf_trn-doc.doc-code and
      429                 buf_CHK-GDS.doc-qnty < 0
      430                 :
      431               find buf_bar-code where buf_bar-code.b-code = buf_CHK-GDS.b-code no-lock no-error.
      432               if not avail buf_bar-code then next.
      433               if buf_bar-code.gds-code = buf_goods.gds-code then do:
      434                 chk-qnty = chk-qnty + buf_CHK-GDS.doc-qnty.
      435                 chk-price = chk-price + ((buf_CHK-GDS.price-base - buf_CHK-GDS.discnt) * buf_CHK-GDS.doc-qnty).
      436                 b-c = entry(1, buf_CHK-GDS.src-code, chr(4)).
      437               end.
      438             end.
      439             if parts_qnty > 0 then do:
      440               put stream txt unformatted
      441               trim(string(ret-doc.fact-date, "99/99/9999"))  ";"
      442               trim(string(b-c)) ";"
      443               trim(string(parts_qnty)) ";"
      444               trim(string(chk-price / chk-qnty, "->>>,>>>,>>9.99"))  ";0;"
      445               trim(string(cli-code))
      446               skip.
      447               assign
      448               b-c = ""
      449               chk-price = 0
      450               chk-qnty = 0
      451               parts_qnty = 0.
      452             end.
      453           end.
      454           assign
      455           p-t  = buf_doc-line.prod-type
      456           p-c  = buf_doc-line.prod-code
      457           p-a  = buf_doc-line.artic
      458           parts_qnty = 0.
      459         end.
      460       end.
      461       find buf_goods  where
      462           buf_goods.prod-type = buf_doc-line.prod-type and
      463           buf_goods.prod-code = buf_doc-line.prod-code and
      464           buf_goods.artic     = buf_doc-line.artic no-lock no-error.
      465       assign
      466       p-t  = buf_doc-line.prod-type
      467       p-c  = buf_doc-line.prod-code
      468       p-a  = buf_doc-line.artic
      469       parts_qnty = 0.
      470       FOR EACH buf_parts NO-LOCK WHERE
      471             buf_parts.obj-type  = buf_doc-line.obj-type AND
      472             buf_parts.obj-code  = buf_doc-line.obj-code AND
      473             buf_parts.artic     = buf_doc-line.artic AND
      474             buf_parts.prod-type = buf_doc-line.prod-type AND
      475             buf_parts.prod-code = buf_doc-line.prod-code AND
      476             buf_parts.out-code   = buf_doc-line.doc-code
      477           :
      478         if buf_parts.supp-code <> cli-code then next.
      479         parts_qnty = parts_qnty + buf_parts.fact-qnty.
      480       end.
      481     end.
      482     if  parts_qnty <> 0 then do:
      483       for each buf_CHK-GDS no-lock where
      484               buf_CHK-GDS.out-code = buf_trn-doc.doc-code and
      485               buf_CHK-GDS.doc-qnty < 0
      486           :
      487         find buf_bar-code where buf_bar-code.b-code = buf_CHK-GDS.b-code no-lock no-error.
      488         if not avail buf_bar-code then next.
      489         if buf_bar-code.gds-code = buf_goods.gds-code then do:
      490           chk-qnty = chk-qnty + buf_CHK-GDS.doc-qnty.
      491           chk-price = chk-price + ((buf_CHK-GDS.price-base - buf_CHK-GDS.discnt) * buf_CHK-GDS.doc-qnty).
      492           b-c = entry(1, buf_CHK-GDS.src-code, chr(4)).
      493         end.
      494       end.
      495       if parts_qnty > 0 then do:
      496         put stream txt unformatted
      497         trim(string(buf_trn-doc.fact-date, "99/99/9999"))  ";"
      498         trim(string(b-c)) ";"
      499         trim(string(parts_qnty)) ";"
      500         trim(string(chk-price / chk-qnty, "->>>,>>>,>>9.99"))  ";0;"
      501         trim(string(cli-code))
      502         skip.
      503         assign
      504         b-c = ""
      505         chk-price = 0
      506         chk-qnty = 0
      507         parts_qnty = 0.
      508       end.
      509     end.
      510   end.
      511   end.
      512   output stream txt close.
      513   message
      514   " Экспорт в файл закончен. "
      515   view-as alert-box information .
      516   END.
      517   ON LEAVE OF cli-code IN FRAME Dialog-Frame
      518   DO:
      519     assign
      520         cli-code.
      521     if cli-code <> 0 then do:
      522          find ub.clients where ub.clients.obj-type = "орг" and
      523                ub.clients.obj-code = cli-code
      524          no-lock no-error.
      525          if avail ub.clients then do:
      526             assign
      527                 cli-code = ub.clients.obj-code
      528                 cli-name = ub.clients.obj-name.
      529                 DISP cli-code cli-name WITH FRAME Dialog-Frame.
      530          end.
      531          else  do:
      532                message "Такой поставщик не существует !!!!!!!!!!!!!!!!!!!!!!!!!!"
      533                view-as alert-box ERROR.
      534                assign
      535                    cli-code = 0
      536                    cli-name = "".
      537                return no-apply.
      538          end.
      539     end.
      540   END.
      541   ON LEAVE OF file-name IN FRAME Dialog-Frame
      542   DO:
      543       ASSIGN file-name.
      544       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      545           ASSIGN FILE-INFO:FILE-NAME = file-name.
      546           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      547           DISP file-name WITH FRAME Dialog-Frame.
      548       END.
      549       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
      550   END.
      551   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      552   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      553   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   on help of frame Dialog-Frame
      555   do:
      556     run gbl/app_help.p
      557       (input this-procedure :file-name
      558       ,input ''
      559       ,input ?
      560       ) no-error.
      561     if error-status :error then do:
      562       message
      563         "Ошибка при вызове помощи"
      564         error-status :get-message(1)
      565         view-as alert-box .
      566     end.
      567   end.
      568   run minbtn-set in this-procedure .
      569   on choose of b-help in frame Dialog-Frame
      570   do:
      571     apply "help":u to frame Dialog-Frame .
      572   end.
      573   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   procedure minbtn-set :
      575       do
      576           on error undo, return error return-value
      577           :
      578           define variable ii              as integer       no-undo .
      579           define variable fh              as widget-handle no-undo .
      580           define variable hh              as widget-handle no-undo .
      581           define variable v-h             as handle        extent 4 no-undo .
      582           define variable v-name-button   as character     no-undo .
      583           define variable v-help-old-x    as decimal       no-undo .
      584           define variable v-help-old-y    as decimal       no-undo .
      585           define variable v-help-old-size as decimal       no-undo .
      586           define variable v-frame-width   as decimal       no-undo .
      587           define variable jj              as integer       no-undo .
      588           do
      589               on error undo, return error
      590               :
      591               assign
      592                   v-frame-width = frame Dialog-Frame:width - 0.3
      593                   fh            = frame Dialog-Frame:first-child
      594                   hh            = fh:first-child
      595                   ii            = 1
      596                   .
      597               do while valid-handle(hh):
      598                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      599                   do:
      600                       case lc(hh:name) :
      601                           when "b-help" then
      602                               do:
      603                                   hh:load-image-up("cmp/b-help.bmp":u) .
      604                                   hh:load-image-down("cmp/b-help.bmp":u) .
      605                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      606                                   hh:TOOLTIP = "Помощь" .
      607                                   v-help-old-x = hh:column .
      608                                   v-help-old-y = hh:row    .
      609                                   v-help-old-size = hh:width .
      610                                   hh:width-chars = 2.5 .
      611                               end.
      612                           when "b-print" then
      613                               do:
      614                                   hh:load-image("cmp/b-print.bmp":u) .
      615                                   hh:TOOLTIP = "Печать" .
      616                                   v-h[ii] = hh:handle .
      617                                   ii = ii + 1 .
      618                                   hh:width-chars = 3 .
      619                               end.
      620                           when "b-history" or
      621                           when "b-hist" then
      622                               do:
      623                                   hh:load-image("cmp/b-hist.bmp":u) .
      624                                   hh:TOOLTIP = "История" .
      625                                   v-h[ii] = hh:handle .
      626                                   ii = ii + 1 .
      627                                   hh:width-chars = 3 .
      628                               end.
      629                           when "b-sch" then
      630                               do:
      631                                   hh:load-image("cmp/b-sch.bmp":u) .
      632                                   hh:TOOLTIP = "Установка Фильтра" .
      633                                   v-h[ii] = hh:handle .
      634                                   ii = ii + 1 .
      635                                   hh:width-chars = 3 .
      636                               end.
      637                           when "b-hist-user" then
      638                               do:
      639                                   hh:load-image("cmp/b-hist.bmp":u) .
      640                                   hh:TOOLTIP = "История пользователя" .
      641                                   ii = ii + 1 .
      642                               end.
      643                       end case.
      644                   end.
      645                   hh = hh:next-sibling.
      646               end.
      647               b-help:column = v-frame-width - b-help:width-chars.
      648               jj = 0.
      649               repeat ii = 4 to 1 by -1 :
      650                   if valid-handle (v-h[ii] ) then
      651                   do:
      652                       jj  = jj + 1 .
      653                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      654                       v-h[ii]:row    = v-help-old-y .
      655                   end.
      656               end.
      657           end.
      658       end.
      659   end procedure.
      660   MAIN-BLOCK:
      661   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      662      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      663   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664     run mainmenu_getcntxt in parparentproc
      665       (output v-cntxt-db-num
      666       ,output v-cntxt-userid
      667       ,output v-cntxt-level
      668       ,output v-cntxt-host-code-obj
      669       ,output v-cntxt-obj-type
      670       ,output v-cntxt-obj-code
      671       ,output v-cntxt-db-num-obj
      672       ,output v-cntxt-is-admin
      673       ) .
      674     if v-cntxt-obj-type <> 'маг':U then do:
      675       message "Текущий объект не МАГАЗИН!"
      676       view-as alert-box ERROR.
      677       BELL.
      678       undo, return error.
      679     end.
      680     date-beg = today.
      681     date-end = today.
      682     assign
      683     date-beg
      684     date-end.
      685     RUN enable_UI.
      686     WAIT-FOR GO OF FRAME Dialog-Frame.
      687   END.
      688   RUN disable_UI.
      689   PROCEDURE disable_UI :
      690     HIDE FRAME Dialog-Frame.
      691   END PROCEDURE.
      692   PROCEDURE enable_UI :
      693     DISPLAY date-beg date-End cli-code cli-name file-name
      694         WITH FRAME Dialog-Frame.
      695     ENABLE Btn_OK Btn_Cancel b-help date-beg date-End cli-code B-file B-file-2
      696            file-name
      697         WITH FRAME Dialog-Frame.
      698     VIEW FRAME Dialog-Frame.
      699   END PROCEDURE.
