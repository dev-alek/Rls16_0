     3804     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3805         INPUT p-page#).
     3806     END PROCEDURE.
     3807   if not this-procedure :persistent
     3808   then do:
     3809     message
     3810       vss-workfile vss-revision vss-description skip
     3811       "Ошибка при запуске процедуры" skip
     3812       "Данную процедуру следует запускать только с параметром persistent" skip
     3813       view-as alert-box error .
     3814     undo, return error .
     3815   end.
     3816   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3817   PROCEDURE no-benq.
     3818   DEFINE OUTPUT PARAMETER found as logical init no.
     3819   define buffer buf_chk-doc for ub.chk-doc.
     3820   FOR EACH obj-list WHERE
     3821           obj-list.obj-type = 'маг':U NO-LOCK :
     3822     CASE X-Radio-Task > 1 :
     3823       WHEN YES THEN DO:
     3824         FOR EACH buf_chk-doc NO-LOCK WHERE
     3825                 buf_chk-doc.obj-type = obj-list.obj-type AND
     3826                 buf_chk-doc.obj-code = obj-list.obj-code AND
     3827                 (
     3828                   buf_chk-doc.shift-date >= X-date-start AND
     3829                   buf_chk-doc.shift-date <= X-date-end)
     3830                   AND
     3831                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     3832           IF X-Radio-Task = 3 AND
     3833           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     3834             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     3835           IF X-Radio-Task = 4 AND
     3836           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     3837           found = yes.
     3838           return.
     3839         END.
     3840       END.
     3841       WHEN NO THEN DO:
     3842         FOR EACH buf_chk-doc NO-LOCK WHERE
     3843               buf_chk-doc.obj-type = obj-list.obj-type AND
     3844               buf_chk-doc.obj-code = obj-list.obj-code AND
     3845               buf_chk-doc.chk-date >= X-date-start AND
     3846               buf_chk-doc.chk-date <= X-date-end   AND
     3847               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     3848           found = yes.
     3849           return.
     3850         END.
     3851        END.
     3852      END CASE.
     3853    END.
     3854   END PROCEDURE.
     3855   PROCEDURE no-benqi.
     3856   DEFINE OUTPUT PARAMETER found as logical init no.
     3857   define buffer buf_chk-doc for ub.chk-doc.
     3858   define buffer buf_inkas for ub.inkas.
     3859   FOR EACH obj-list WHERE
     3860         obj-list.obj-type = 'маг':U NO-LOCK :
     3861     CASE X-Radio-Task > 1 :
     3862       WHEN YES THEN DO:
     3863         FOR EACH buf_chk-doc No-LOCK WHERE
     3864                 buf_chk-doc.obj-type = obj-list.obj-type AND
     3865                 buf_chk-doc.obj-code = obj-list.obj-code AND
     3866                 (
     3867                   buf_chk-doc.shift-date >= X-date-start AND
     3868                   buf_chk-doc.shift-date <= X-date-end)
     3869                   AND
     3870                   buf_Chk-doc.out-code = ? AND
     3871                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     3872           IF X-Radio-Task = 3 AND
     3873           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     3874             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     3875           IF X-Radio-Task = 4 AND
     3876           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     3877           found = yes.
     3878           return.
     3879         END.
     3880         FOR EACH buf_inkas No-LOCK WHERE
     3881                   buf_inkas.obj-type = obj-list.obj-type AND
     3882                   buf_inkas.obj-code = obj-list.obj-code AND
     3883                   (
     3884                   buf_inkas.shift-date >= X-date-start AND
     3885                   buf_inkas.shift-date <= X-date-end):
     3886           if buf_inkas.status_ = 'факт':U
     3887           or buf_inkas.status_ = 'запрос':U then next.
     3888           IF X-Radio-Task = 3 AND
     3889           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     3890             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     3891           IF X-Radio-Task = 4 AND
     3892           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     3893           found = yes.
     3894           return.
     3895         END.
     3896       END.
     3897       WHEN NO THEN DO:
     3898         FOR EACH buf_chk-doc NO-LOCK WHERE
     3899                 buf_chk-doc.obj-type = obj-list.obj-type AND
     3900                 buf_chk-doc.obj-code = obj-list.obj-code AND
     3901                 buf_chk-doc.chk-date >= X-date-start AND
     3902                 buf_chk-doc.chk-date <= X-date-end   AND
     3903                 buf_Chk-doc.out-code = ? AND
     3904                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     3905           found = yes.
     3906           return.
     3907         END.
     3908         FOR EACH buf_inkas NO-LOCK WHERE
     3909                 buf_inkas.obj-type = obj-list.obj-type AND
     3910                 buf_inkas.obj-code = obj-list.obj-code AND
     3911                 buf_inkas.doc-date >= X-date-start AND
     3912                 buf_inkas.doc-date <= X-date-end :
     3913           if buf_inkas.status_ = 'факт':U
     3914           or buf_inkas.status_ = 'запрос':U then next.
     3915           found = yes.
     3916           return.
     3917         END.
     3918       END.
     3919     END CASE.
     3920   END.
     3921   END PROCEDURE.
     3922   PROCEDURE no-benq-i.
     3923   DEFINE OUTPUT PARAMETER found as logical init no.
     3924   define buffer buf_inkas for ub.inkas.
     3925   CASE X-Radio-Task > 1:
     3926     WHEN YES then do:
     3927       FOR EACH obj-list WHERE
     3928               obj-list.obj-type = 'маг':U NO-LOCK :
     3929         FOR EACH buf_inkas NO-LOCK WHERE
     3930                 buf_inkas.obj-type = obj-list.obj-type AND
     3931                 buf_inkas.obj-code = obj-list.obj-code AND
     3932                 buf_inkas.status_ = 'факт':U AND
     3933                 (
     3934                 buf_inkas.shift-date >= X-date-start AND
     3935                 buf_inkas.shift-date <= X-date-end):
     3936           IF X-Radio-Task = 3 AND
     3937           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     3938             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     3939           IF X-Radio-Task = 4 AND
     3940           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     3941           found = yes.
     3942           return.
     3943         END.
     3944     END.
     3945     END.
     3946     WHEN NO THEN DO:
     3947       FOR EACH obj-list WHERE
     3948               obj-list.obj-type = 'маг':U NO-LOCK :
     3949         FOR EACH buf_inkas NO-LOCK WHERE
     3950                 buf_inkas.obj-type = obj-list.obj-type AND
     3951                 buf_inkas.obj-code = obj-list.obj-code AND
     3952                 buf_inkas.status_ = 'факт':U AND
     3953                 buf_inkas.doc-date >= X-date-start AND
     3954                 buf_inkas.doc-date <= X-date-end :
     3955            found = yes.
     3956            return.
     3957         END.
     3958       END.
     3959     END.
     3960   END CASE.
     3961   END PROCEDURE.
     3962   PROCEDURE no-benq-i-office.
     3963   DEFINE OUTPUT PARAMETER found as logical init no.
     3964   define buffer buf_sale-doc for ub.sale-doc.
     3965   CASE X-Radio-Task > 1:
     3966     WHEN YES then do:
     3967       FOR EACH obj-list WHERE
     3968               obj-list.obj-type = 'маг':U NO-LOCK :
     3969         FOR EACH buf_sale-doc NO-LOCK WHERE
     3970                  buf_Sale-doc.obj-type = obj-list.obj-type
     3971              AND buf_sale-doc.obj-code = obj-list.obj-code
     3972              AND buf_sale-doc.status_ = 'факт':U
     3973              AND buf_sale-doc.chr-office = 'у':U
     3974              AND (
     3975                 buf_sale-doc.shift-date >= X-date-start
     3976                 AND
     3977                 buf_sale-doc.shift-date <= X-date-end):
     3978           IF X-Radio-Task = 3 AND
     3979           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     3980             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     3981           IF X-Radio-Task = 4 AND
     3982           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     3983           found = yes.
     3984           return.
     3985         END.
     3986       END.
     3987     END.
     3988     WHEN NO THEN DO:
     3989       FOR EACH obj-list WHERE
     3990               obj-list.obj-type = 'маг':U NO-LOCK :
     3991         FOR EACH buf_sale-doc NO-LOCK WHERE
     3992                 buf_sale-doc.obj-type = obj-list.obj-type
     3993            AND  buf_sale-doc.obj-code = obj-list.obj-code
     3994            AND  buf_sale-doc.status_ = 'факт':U
     3995            AND  buf_sale-doc.chr-office = 'у':U
     3996            AND  buf_sale-doc.doc-date >= X-date-start
     3997            AND  buf_sale-doc.doc-date <= X-date-end :
     3998           found = yes.
     3999           return.
     4000         END.
     4001       END.
     4002     END.
     4003   END CASE.
     4004   END PROCEDURE.
     4005   PROCEDURE adm-create-objects :
     4006   END PROCEDURE.
     4007   PROCEDURE adm-row-available :
     4008     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     4009     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     4010     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     4011     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     4012     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     4013     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     4014     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     4015     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     4016     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     4017     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     4018     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     4019     IF adm-updating-record THEN RETURN.
     4020     RUN get-attribute ('FIELDS-ENABLED':U).
     4021     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     4022     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     4023         OUTPUT link-handle) NO-ERROR.
     4024     IF link-handle = "":U THEN
     4025         RETURN.
     4026     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     4027     IF NUM-ENTRIES(link-handle) > 1 THEN
     4028         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     4029             "encountered more than one RECORD-SOURCE.":U SKIP
     4030             "The first - ":U record-source-hdl:file-name " - will be used.":U
     4031                VIEW-AS ALERT-BOX ERROR.
     4032     RUN get-attribute ('Key-Name':U).
     4033     key-name = RETURN-VALUE.
     4034     IF key-name = "":U THEN key-name = ?.
     4035     IF key-name NE ? THEN DO:
     4036       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     4037         NO-ERROR.
     4038       IF key-value NE ? THEN
     4039         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     4040     END.
     4041   IF VALID-HANDLE (adm-object-hdl) THEN
     4042       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     4043   RUN notify IN THIS-PROCEDURE ('row-available':U).
     4044   END PROCEDURE.
     4045   PROCEDURE cre-sj :
     4046   define input parameter v-curr-r-b as character no-undo .
     4047   define input parameter  doc-num like ub.trn-doc.doc-code no-undo.
     4048   define input parameter is-out as integer init 1.
     4049   define input parameter offc as logical no-undo.
     4050   define variable s-price as decimal no-undo .
     4051   define variable cur-discnt as decimal no-undo .
     4052   define variable cur-quant like ub.gds-dtl.doc-qnty no-undo.
     4053   define variable slt-calc as dec.
     4054   define variable vat-cost as dec.
     4055   define variable r-bar-code like ub.bar-code.b-code no-undo.
     4056   DEFINE VARIABLE varsum-dsc-r-b-acc as decimal no-undo .
     4057   DEFINE VARIABLE varvat-r-b-acc     as decimal no-undo .
     4058   DEFINE VARIABLE var-qnty              as decimal no-undo .
     4059   DEFINE VARIABLE varvat-r-b-doc     as decimal no-undo .
     4060   DEFINE VARIABLE varslt-r-b-doc     as decimal no-undo .
     4061   define buffer buf-bar for ub.bar-code.
     4062   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4063   _docline:
     4064   FOR EACH ub.doc-line WHERE ub.doc-line.doc-code = doc-num NO-LOCK:
     4065     PROCESS EVENTS.
     4066     jj = jj + 1 .
     4067     if ( jj  modulo 10 ) = 0  then
     4068     run waitfram-show in this-procedure (input ("Обработано строк накладных : " +   string(  jj ) ) ).
     4069     IF good-choice  AND NOT (can-find(FIRST gds-list WHERE
     4070                                       gds-list.artic = ub.doc-line.artic AND
     4071                                       gds-list.prod-type = ub.doc-line.prod-type AND
     4072                                       gds-list.prod-code = ub.doc-line.prod-code)) THEN NEXT.
     4073     run clcprtsl_calc-line in this-procedure (input recid (ub.doc-line)).
     4074     assign
     4075     s-price = 0
     4076     cur-quant = 0
     4077     varsum-dsc-r-b-acc   = 0
     4078     var-qnty                = 0
     4079     .
     4080     find first tt-allsum-line where
     4081                tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     4082     if not available tt-allsum-line then do:
     4083     end.
     4084     else do:
     4085      assign
     4086      varsum-dsc-r-b-acc   = (if v-curr-r-b = 'rubl':U then tt-allsum-line.sum-dsc-rubl-acc else tt-allsum-line.sum-dsc-base-acc)
     4087      var-qnty                = ub.doc-line.fact-qnty
     4088      cur-quant = is-out * ub.doc-line.fact-qnty
     4089      s-price = varsum-dsc-r-b-acc  / var-qnty
     4090      .
     4091     end.
     4092     if NOT offc AND cur-quant = 0 and negparts then next _docline.
     4093     FOR EACH ub.gds-dtl WHERE
     4094             ub.gds-dtl.doc-code = doc-num AND
     4095             ub.gds-dtl.artic = ub.doc-line.artic AND
     4096             ub.gds-dtl.prod-type = ub.doc-line.prod-type AND
     4097             ub.gds-dtl.prod-code = ub.doc-line.prod-code
     4098             NO-LOCK:
     4099       if method = "b-code":U then do:
     4100         FIND FIRST ub.goods No-LOCK WHERE
     4101                  ub.goods.artic = ub.gds-dtl.artic AND
     4102                   ub.goods.prod-type = ub.gds-dtl.prod-type AND
     4103                   ub.goods.prod-code = ub.gds-dtl.prod-code No-ERROR.
     4104         FIND FIRST ub.bar-code WHERE
     4105                   ub.bar-code.gds-code = ub.goods.gds-code AND
     4106                   ub.bar-code.in-code = "" AND
     4107                   ub.bar-code.unit-cli = ub.goods.unit-base AND
     4108                   ub.bar-code.part-code = "" AND
     4109                   ub.bar-code.node-code = ub.gds-dtl.prt-code
     4110                   NO-LOCK   NO-ERROR.
     4111       end.
     4112       assign
     4113       cur-discnt = (if v-curr-r-b = 'rubl':U then ub.gds-dtl.discnt-rubl else ub.gds-dtl.discnt-base)
     4114       .
     4115       CASE method :
     4116         when "b-code":U THEN dO:
     4117           FIND FIRST sj-goods WHERE
     4118                     sj-goods.b-code = ub.bar-code.b-code
     4119                 AND sj-goods.is-out = (is-out > 0) NO-ERROR .
     4120         END.
     4121         when "Group" THEN do:
     4122           FIND ub.goods WHERE
     4123               ub.goods.prod-type = ub.doc-line.prod-type AND
     4124               ub.goods.prod-code = ub.doc-line.prod-code AND
     4125               ub.goods.artic = ub.doc-line.artic NO-LOCK .
     4126           FIND FIRST t-3 where
     4127                     ub.goods.grp-name begins t-3.serv-name No-ERROR.
     4128           FIND FIRST sj-goods WHERE
     4129                     sj-goods.grp-code = (if available t-3 then t-3.grp-code-sheet else 0)
     4130                 AND sj-goods.is-out = (is-out > 0) NO-ERROR .
     4131         end.
     4132       END CASE.
     4133       if NOT available sj-goods then do:
     4134         CREATE sj-goods.
     4135         CASE method:
     4136           WHEN  "b-code":U then DO:
     4137             FIND ub.goods WHERE
     4138                 ub.goods.prod-type = ub.doc-line.prod-type AND
     4139                 ub.goods.prod-code = ub.doc-line.prod-code AND
     4140                 ub.goods.artic = ub.doc-line.artic NO-LOCK .
     4141             assign
     4142             sj-goods.b-code = ub.bar-code.b-code
     4143             sj-goods.name = ub.goods.gds-name
     4144             sj-goods.artic = ub.goods.artic
     4145             sj-goods.unit  = ub.goods.unit-base
     4146             sj-goods.is-out = (is-out > 0)
     4147             sj-goods.prod-type = ub.goods.prod-type
     4148             sj-goods.prod-code = ub.goods.prod-code
     4149             .
     4150           END.
     4151           WHEN "GROUP":U then do:
     4152             assign
     4153             sj-goods.grp-code = (if available t-3 then t-3.grp-code-sheet else 0)
     4154             sj-goods.is-out = (is-out > 0)
     4155             .
     4156           END.
     4157         END CASE.
     4158       end.
     4159       assign
     4160       cur-quant = is-out * ub.gds-dtl.fact-qnty
     4161       sj-goods.qnty = sj-goods.qnty + cur-quant
     4162       sj-goods.brutto-sum = sj-goods.brutto-sum + ( cur-quant * (if v-curr-r-b = 'rubl':U then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base))
     4163       sj-goods.discnt-sum = sj-goods.discnt-sum + ( cur-discnt * cur-quant )
     4164       sj-goods.netto-sum = sj-goods.brutto-sum -  sj-goods.discnt-sum
     4165       sj-goods.uchet-sum = sj-goods.uchet-sum + s-price * cur-quant
     4166       .
     4167     END.
     4168   END.
     4169   END PROCEDURE.
     4170   PROCEDURE disable_UI :
     4171     HIDE FRAME F-Main.
     4172     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     4173   END PROCEDURE.
     4174   PROCEDURE enable_UI :
     4175     DISPLAY RS-Method T-neg
     4176         WITH FRAME F-Main.
     4177     ENABLE RECT-6 RECT-7 RS-Method T-neg
     4178         WITH FRAME F-Main.
     4179   END PROCEDURE.
     4180   PROCEDURE Main_cycle :
     4181   define variable i as integer no-undo .
     4182   define variable tdoc-code     as      char    no-undo.
     4183   define variable real-code like ub.clients.obj-code no-undo.
     4184   define variable real-type like ub.clients.obj-type no-undo.
     4185   define variable doc-num like ub.trn-doc.doc-code no-undo.
     4186   define variable is-out as integer init 1.
     4187   define variable offc as logical no-undo.
     4188   define variable v-host-code like ub.sysconf.host-code no-undo.
     4189   define variable v-curr-r-b as character no-undo .
     4190   define buffer buf_inkas for ub.inkas.
     4191   define buffer buf_sale-doc for ub.sale-doc.
     4192   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4194     (output v-curr-r-b
     4195     )  .
     4196   define buffer buf_sysconf for ub.sysconf.
     4197   define buffer b-tr-doc  for ub.trn-doc .
     4198   FOR EACH sj-goods :
     4199       delete sj-goods .
     4200   END .
     4201   _obj-list:
     4202   FOR EACH obj-list NO-LOCK:
     4203   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4204   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4205     (input  obj-list.obj-type
     4206     ,input  obj-list.obj-code
     4207     ,output v-host-code
     4208     )  .
     4209     FIND FIRST buf_sysconf NO-LOCK WHERE buf_sysconf.host-code = v-host-code.
     4210     IF AVAIL buf_sysconf
     4211     then
     4212     assign
     4213     real-code = buf_sysconf.sale-code
     4214     real-type = buf_sysconf.sale-type
     4215     .
     4216     else NEXT _obj-list.
     4217     _inkas:
     4218     FOR EACH buf_inkas WHERE
     4219               buf_inkas.doc-date >= X-date-start and
     4220               buf_inkas.doc-date <= X-date-end AND
     4221               buf_inkas.obj-code = obj-list.obj-code and
     4222               buf_inkas.obj-type = obj-list.obj-type AND
     4223               buf_inkas.status_ = 'факт':U NO-LOCK,
     4224         each buf_sale-doc no-lock where
     4225               buf_sale-doc.inkas-code = buf_inkas.inkas-code
     4226           and buf_sale-doc.order > 0:
     4227       if buf_sale-doc.in-inkas then do:
     4228         FIND FIRST t-doc No-LOCK WHERE
     4229                 t-doc.doc-code = buf_sale-doc.doc-code no-error.
     4230         if not available t-doc then do:
     4231           next _inkas.
     4232         end.
     4233         assign
     4234         doc-num = t-doc.doc-code
     4235         is-out = buf_sale-doc.dir
     4236         offc = t-doc.office
     4237         .
     4238         if buf_sale-doc.chr-office = 'у':U
     4239         and negparts then NEXT _inkas.
     4240         run cre-sj in this-procedure (
     4241                                 input v-curr-r-b
     4242                               ,input doc-num
     4243                               ,input is-out
     4244                               ,input offc
     4245                               ).
     4246       end.
     4247     END.
     4248   END.
     4249   END PROCEDURE.
     4250   PROCEDURE My-report :
     4251   define variable glog as logical no-undo .
     4252   run My-var.
     4253   glog = no.
     4254   run no-benq-i(output glog).
     4255   if NOT glog then do:
     4256       message "Не было никаких закрытых продаж на выбранных объектах в течение заданного Вами периода времени." view-as alert-box.
     4257       return.
     4258   end.
     4259   assign
     4260   date_string = cur-time-print()
     4261   Line = fill( "-", 187 )
     4262   jj = 0
     4263   jj-tot = 0
     4264   .
     4265   if RS-METHOD = "GROUP":U then do:
     4266     run rep/r-shftgr.p
     4267                 (input "":U,
     4268                   input 0,
     4269                   input ?,
     4270                   input ?,
     4271                   input "n-level",
     4272                   input "":U,
     4273                   input no,
     4274                   input 1   ) no-error.
     4275   end.
     4276   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     4277   CASE RS-METHOD:
     4278     when "b-code":u then do:
     4279       RUN PrintProc in this-procedure .
     4280     end.
     4281     when "GROUP":u then do:
     4282       RUN PrintProcGroup in this-procedure .
     4283     end.
     4284   END CASE.
     4285   END PROCEDURE.
     4286   PROCEDURE My-var :
     4287   Assign
     4288   frame F-Main RS-Method
     4289   frame F-Main T-neg
     4290   good-choice = (IF X-selectGood = 1 then no else yes)
     4291   method = RS-method
     4292   .
     4293   Assign
     4294    STR-obj-type = ''
     4295    STR-obj-code = ''
     4296    STR-obj-name = ''
     4297    STR-obj      = ''.
     4298   For each obj-list no-lock:
     4299    Assign
     4300    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     4301    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     4302    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     4303    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     4304   End.
     4305   Reportname = "Отчет о движении товаров через кассу".
     4306   ReportHeader =  "Детализация: " +
     4307                   radio-label(string(RS-method), RS-method:radio-buttons) + chr(10) +
     4308                   (if T-neg then t-neg:label else "")
     4309                   .
     4310   END PROCEDURE.
     4311   PROCEDURE PrintProc :
     4312   define variable i as integer no-undo .
     4313   define variable Line                as      char    no-undo.
     4314   define variable cash_string     as      char    no-undo.
     4315   define variable sale_string     as      char    no-undo.
     4316   define variable date_string     as      char    no-undo.
     4317   define variable namebuf1     as      char    no-undo.
     4318   define variable namebuf2     as      char    no-undo.
     4319   define variable prodbuf1     as      char    no-undo.
     4320   define variable prodbuf2     as      char    no-undo.
     4321   define variable v-header-base-curr as character no-undo .
     4322   define variable v-curr-r-b as character no-undo .
     4323   define buffer buf_clients for ub.clients.
     4324   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4325   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4326     (output v-curr-r-b
     4327     )  .
     4328   if v-curr-r-b = 'base':U then do:
     4329     assign
     4330     v-header-base-curr = string( "( Вал. продаж - баз.вал. )" )
     4331     .
     4332   end.
     4333   else do:
     4334     assign
     4335     v-header-base-curr = string( "( Вал. продаж - РУБЛИ )" )
     4336     .
     4337   end.
     4338   DEFINE FRAME SJ-Base
     4339   jj-tot column-label "  N  "                                                 format ">>>>>9"
     4340   sj-goods.b-code column-label "Код ! "                                       format ">>>>>>>>>9"
     4341   sj-goods.artic column-label "Артикул   ! "                                  format "x(16)"
     4342   sj-goods.name column-label "Наименование  ! "                               format "x(34)"
     4343   ub.clients.obj-name column-label "(Производитель)"                             format "x(25)"
     4344   sj-goods.unit column-label "Ед.!изм"                                        format "X(3)"
     4345   sj-goods.qnty column-label "Количество ! "                                  format "->>>>>9.<<<"
     4346   sj-goods.brutto-sum column-label  "Сумма брутто!в ценах продажи"            format "->>>>>>>>9.99"
     4347   sj-goods.discnt-sum column-label  "Сумма скидок!в ценах продажи"            format "->>>>>>>>9.99"
     4348   sj-goods.netto-sum column-label  "Сумма нетто!в ценах продажи"              format "->>>>>>>>9.99"
     4349   sj-goods.uchet-sum column-label  "Сумма!в учетных ценах"                    format "->>>>>>>>9.99"
     4350   sj-goods.u-pcnt column-label  "Торг.!нацен. %"                              format "->>9.99%"
     4351   sj-goods.n-u-sum column-label "Эффективность"                               format "->>>>>>>>9.99"
     4352   HEADER  date_string AT 5 format "X(35)"
     4353   v-header-base-curr  format "X(25)"
     4354   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER ( PrnLibStream)
     4355     AT 125 FORMAT ">>>>9" SKIP
     4356   Line format "X(188)" AT 1
     4357   with width 232  down stream-io use-text.
     4358       Line = fill("-", 250).
     4359   run waitfram-show in this-procedure ( "Подождите ..." ).
     4360   run Main_Cycle.
     4361   date_string = cur-time-print() .
