      593   def
      594    shared
      595   temp-table  obj-list no-undo
      596     field obj-type like ub.clients.obj-type
      597     field obj-code like ub.clients.obj-code
      598     field obj-name like ub.clients.obj-name
      599     field obj-id   as integer
      600     field db-num   as integer
      601     index pi is primary unique obj-id
      602     index ie1 obj-type obj-code
      603     index ie2 obj-name
      604   .
      605   procedure create_obj-list :
      606      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      607      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      608      do
      609      on error undo, return error return-value
      610      :
      611         define buffer cli-obj for ub.clients .
      612         define variable p-var as integer no-undo .
      613         define buffer buf_obj-list for obj-list .
      614         find last buf_obj-list  use-index pi no-error .
      615         if available buf_obj-list
      616         then
      617            p-var = buf_obj-list.obj-id + 1.
      618         else
      619            p-var = 1.
      620         find first cli-obj where
      621                   cli-obj.obj-type = p-obj-type
      622               and cli-obj.obj-code = p-obj-code
      623         no-lock no-error.
      624         if available cli-obj
      625         then do:
      626            create buf_obj-list.
      627            assign
      628               buf_obj-list.obj-id   = p-var
      629               buf_obj-list.obj-code = cli-obj.obj-code
      630               buf_obj-list.obj-type = cli-obj.obj-type
      631               buf_obj-list.obj-name = cli-obj.obj-name
      632               buf_obj-list.db-num   = cli-obj.db-num
      633            .
      634         end.
      635      end.
      636   end.
