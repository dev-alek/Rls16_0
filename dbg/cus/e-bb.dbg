     3129   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3130   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3131   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3132   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3133   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3134   define input parameter parr-b              as   character               no-undo.
     3135   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3136   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3137   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3138   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3139   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3140   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3141   define buffer bf_tt-allsum      for tt-allsum.
     3142   define buffer bf_tt-clcparts    for tt-clcparts.
     3143   define buffer bf_tt-allsum-line for tt-allsum-line.
     3144   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3145   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3146   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3147   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3148   define variable varexcise          like ub.price-list.excise     no-undo.
     3149   do on error undo, return error return-value :
     3150   for each bf_tt-allsum-line
     3151   on error undo, return error return-value
     3152    :
     3153     delete bf_tt-allsum-line.
     3154   end.
     3155   for each bf_tt-allsum
     3156   on error undo, return error return-value
     3157   :
     3158     delete bf_tt-allsum.
     3159   end.
     3160   for each bf_tt-clcparts
     3161   on error undo, return error return-value
     3162   :
     3163   if v-calcbypart then do:
     3164             assign
     3165             parcur-base =   bf_tt-clcparts.part-cur-base
     3166             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3167             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3168             .
     3169   end.
     3170      run clcprtsl_calc-parts in this-procedure (
     3171        input recid(bf_tt-clcparts),
     3172        input paris-doc,
     3173        input paris-cur,
     3174        input parroad-tax,
     3175        input parexcise,
     3176        input parvat-pc,
     3177        input parcons-vat-pc,
     3178        input parslt-pc,
     3179        input parbase-rate,
     3180        input parbase-scale,
     3181        input parr-b,
     3182        input parcur-base,
     3183        input parcur-road-tax,
     3184        input parcur-excise,
     3185        input parcur-vat-pc,
     3186        input parcurcons-vat-pc,
     3187        input parcurslt-pc
     3188        ) no-error.
     3189     if error-status:error then do:
     3190       message
     3191         vss-workfile vss-revision vss-description skip
     3192         vss-include-info13 skip
     3193         "Ошибка при обсчете партии" skip
     3194         "Документ партии " bf_tt-clcparts.out-code skip
     3195         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3196         return-value skip
     3197         error-status:get-message(1) skip
     3198         error-status:get-message(2) skip
     3199         error-status:get-message(3) skip
     3200         view-as alert-box error .
     3201       undo, return error .
     3202     end.
     3203     for each bf_tt-allsum on error undo, return error return-value :
     3204       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3205       if not available bf_tt-allsum-line then do:
