     3694   PROCEDURE dispatch :
     3695       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     3696       RUN broker-dispatch IN adm-broker-hdl
     3697           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     3698       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     3699   END PROCEDURE.
     3700   PROCEDURE ensure-broker :
     3701   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     3702   IF RETURN-VALUE NE "ADM-Broker":U THEN
     3703   DO:
     3704       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     3705       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     3706   END.
     3707   END PROCEDURE.
     3708   PROCEDURE get-attribute :
     3709     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     3710     RUN broker-get-attribute IN adm-broker-hdl
     3711         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     3712     RETURN RETURN-VALUE.
     3713   END PROCEDURE.
     3714   PROCEDURE get-attribute-list :
     3715     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     3716     RUN broker-get-attribute-list IN adm-broker-hdl
     3717         (INPUT THIS-PROCEDURE,
     3718          INPUT ?,
     3719          OUTPUT p-attr-list) NO-ERROR.
     3720     RETURN.
