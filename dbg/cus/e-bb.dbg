     3117           trim(error-status :get-message(5)) skip
     3118           view-as alert-box error.
     3119         undo, return error .
     3120       end.
     3121     end.
     3122   end.
     3123   end.
     3124   procedure clcprtsl_calc-ttable :
     3125   define input parameter paris-doc           as   logical                 no-undo.
     3126   define input parameter paris-cur           as   logical                 no-undo.
     3127   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
