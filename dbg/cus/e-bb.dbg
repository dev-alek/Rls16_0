     4363   run prn-lib-open-stream  in this-procedure (
     4364                                                input my-handle
     4365                                               ,input 43
     4366                                               ,input yes
     4367                                               ,input no
     4368                                               ).
     4369   PUT STREAM PrnLibStream unformatted
     4370   SPACE(25)  "Отчет о движении товаров через кассу " + str1 + " ПО ОБЪЕКТАМ"  format "x(90)"  SKIP(0)
     4371   str2  skip(0)
     4372   ReportHeader skip(0)
     4373   SPACE(25) (if negparts then "(только порожденные партии)" else "") FORMAT "X(42)" SKIP(0)
     4374      .
     4375   FOR EACH obj-list :
     4376       FIND clients WHERE clients.obj-type = obj-list.obj-type AND
     4377                                     clients.obj-code = obj-list.obj-code NO-LOCK .
     4378       PUT  STREAM PrnLibStream SPACE(21) clients.obj-name format "X(100)" SKIP.
     4379   END.
     4380   PUT STREAM PrnLibStream " " SKIP(1) .
     4381   FORM HEADER
     4382   Line format "X(188)" AT 1 SKIP
     4383   "Продолжение - на следующей странице" AT 30 SKIP
     4384   with FRAME BottomFrame width 232  PAGE-BOTTOM NO-LABELS NO-BOX .
     4385   VIEW STREAM PrnLibStream FRAME BottomFrame .
     4386   FORM with FRAME SJ-Base .
     4387   FOR EACH sj-goods use-index p2 BREAK BY sj-goods.is-out DESCENDING :
     4388       assign
     4389       sj-goods.netto-sum = sj-goods.brutto-sum - sj-goods.discnt-sum
     4390       sj-goods.n-u-sum = (if sj-goods.is-out then 1 else - 1) * (abs(sj-goods.netto-sum) -  abs(sj-goods.uchet-sum))
     4391       sj-goods.u-pcnt =  ( sj-goods.netto-sum / sj-goods.uchet-sum ) * 100.
     4392       if t-neg and abs(sj-goods.uchet-sum) >= abs(sj-goods.netto-sum ) then
     4393       assign
     4394       sj-goods.n-u-sum = 0
     4395       sj-goods.u-pcnt = 0
     4396       .
     4397       find first buf_clients no-lock where
     4398                 buf_Clients.obj-type = sj-goods.prod-type
     4399            AND  buf_Clients.obj-code = sj-goods.prod-code no-error.
     4400       ACCUMULATE sj-goods.b-code (SUB-COUNT BY sj-goods.is-out).
     4401       namebuf1 = breakstr(sj-goods.name, 18, namebuf1, namebuf2).
     4402       DISPLAY STREAM PrnLibStream
     4403       ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code @ jj-tot
     4404       sj-goods.b-code
     4405       sj-goods.artic
     4406       sj-goods.name
     4407       (if available buf_Clients
     4408        then buf_clients.obj-name
     4409        else (sj-goods.prod-type + string(sj-goods.prod-code))
     4410       ) @ clients.obj-name
     4411       sj-goods.qnty
     4412       sj-goods.unit
     4413       sj-goods.brutto-sum
     4414       sj-goods.discnt-sum
     4415       sj-goods.netto-sum
     4416       sj-goods.uchet-sum
     4417       sj-goods.u-pcnt
     4418       sj-goods.n-u-sum
     4419       with FRAME SJ-Base .
     4420       IF method <> "TOTALS":U THEN DO:
     4421       DOWN STREAM PrnLibStream 1 with FRAME SJ-Base .
     4422   END.
     4423   ACCUMULATE
     4424   sj-goods.qnty (TOTAL)
     4425   sj-goods.qnty ( SUB-TOTAL BY sj-goods.is-out )
     4426   sj-goods.brutto-sum (TOTAL)
     4427   sj-goods.brutto-sum (SUB-TOTAL BY sj-goods.is-out)
     4428   sj-goods.discnt-sum (TOTAL)
     4429   sj-goods.discnt-sum (SUB-TOTAL BY sj-goods.is-out)
     4430   sj-goods.netto-sum (TOTAL)
     4431   sj-goods.netto-sum (SUB-TOTAL BY sj-goods.is-out)
     4432   sj-goods.uchet-sum (TOTAL)
     4433   sj-goods.uchet-sum (SUB-TOTAL BY sj-goods.is-out)
     4434   sj-goods.n-u-sum (TOTAL)
     4435   sj-goods.n-u-sum (SUB-TOTAL BY sj-goods.is-out)
     4436   .
     4437   if last-of( sj-goods.is-out ) then do:
     4438       UNDERLINE STREAM PrnLibStream
     4439       jj-tot
     4440       sj-goods.b-code
     4441       sj-goods.artic
     4442       sj-goods.name
     4443       clients.obj-name
     4444       sj-goods.qnty
     4445       sj-goods.unit
     4446       sj-goods.brutto-sum
     4447       sj-goods.discnt-sum
     4448       sj-goods.netto-sum
     4449       sj-goods.uchet-sum
     4450       sj-goods.u-pcnt
     4451       sj-goods.n-u-sum
     4452       with FRAME SJ-Base .
     4453       DISPLAY STREAM PrnLibStream
     4454       IF method = "TOTALS":U
     4455       THEN ""
     4456       ELSE
     4457       string(ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code , ">>>>9") @ sj-goods.b-code
     4458       IF method = "TOTALS":U
     4459       THEN ""
     4460       ELSE " наименований"  @ sj-goods.artic
     4461       string( "Итого " + ( if sj-goods.is-out then "продажи" else "возвраты" ) )
     4462               @ sj-goods.name
     4463       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.qnty @ sj-goods.qnty
     4464       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.brutto-sum @ sj-goods.brutto-sum
     4465       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.discnt-sum @ sj-goods.discnt-sum
     4466       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.netto-sum @ sj-goods.netto-sum
     4467       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.uchet-sum @ sj-goods.uchet-sum
     4468       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.n-u-sum @ sj-goods.n-u-sum
     4469       with FRAME SJ-Base .
     4470       jj-tot = jj-tot  + ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code.
     4471       if NOT last( sj-goods.is-out ) then
     4472       UNDERLINE STREAM PrnLibStream
     4473       jj-tot
     4474       sj-goods.b-code
     4475       sj-goods.artic
     4476       sj-goods.name
     4477       clients.obj-name
     4478       sj-goods.brutto-sum
     4479       sj-goods.discnt-sum
     4480       sj-goods.netto-sum
     4481       sj-goods.uchet-sum
     4482       sj-goods.n-u-sum
     4483       with FRAME SJ-Base .
     4484   end.
     4485   END .
     4486   PUT STREAM PrnLibStream Line format "X(188)" .
     4487   DOWN STREAM PrnLibStream 1 with FRAME SJ-Base .
     4488   UNDERLINE STREAM PrnLibStream
     4489   jj-tot
     4490   sj-goods.b-code
     4491   sj-goods.artic
     4492   sj-goods.name
     4493   clients.obj-name
     4494   sj-goods.qnty
     4495   sj-goods.unit
     4496   sj-goods.brutto-sum
     4497   sj-goods.discnt-sum
     4498   sj-goods.netto-sum
     4499   sj-goods.uchet-sum
     4500   sj-goods.u-pcnt
     4501   sj-goods.n-u-sum
     4502   with FRAME SJ-Base .
