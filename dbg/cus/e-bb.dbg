     2999                 varroad-tax   = 0
     3000                 varexcise     = 0
     3001               .
     3002             end.
     3003             assign
     3004               varlastcur-base     = varprice-sale
     3005               varlastcur-road-tax = varroad-tax
     3006               varlastcur-excise   = varexcise
     3007               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3008               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3009               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3010               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3011             .
     3012         end.
     3013       end.
     3014       if varcur-fact-qnty = 0 then do:
     3015         assign
     3016           varcur-base      = varlastcur-base
     3017           varcur-road-tax  = varlastcur-road-tax
     3018           varcur-excise    = varlastcur-excise
     3019         .
     3020       end.
     3021       else do:
     3022         assign
     3023           varcur-base      = varcur-base      / varcur-fact-qnty
     3024           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3025           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3026         .
     3027       end.
     3028       if varcur-vat-pc = ?
