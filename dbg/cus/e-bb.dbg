     2629       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     2630       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     2631       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2632       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     2633       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     2634       bfsacc_tt-allsum.vat-base-doc        = 0
     2635       bfsacc_tt-allsum.vat-rubl-doc        = 0
     2636       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     2637       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     2638       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     2639       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     2640       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     2641       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     2642       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
