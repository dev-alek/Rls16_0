     3613             SIZE 33.13 BY .88 AT ROW 1.42 COL 3.25
     3614             FGCOLOR 4
     3615        RECT-6 AT ROW 1.25 COL 2.25
     3616        RECT-7 AT ROW 11.33 COL 2.25
     3617       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     3618            SIDE-LABELS NO-UNDERLINE THREE-D
     3619            AT COL 1 ROW 1
     3620            SIZE 47.63 BY 15.
     3621   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     3622   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     3623   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     3624   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     3625   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     3626   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     3627   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     3628   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     3629       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     3630   RUN ensure-broker.
     3631   THIS-PROCEDURE:ADM-DATA =
     3632        'ADM1.1~`':U +
     3633        'SmartObject~`':U +
     3634        'FRAME~`':U +
     3635        'NO ~`':U +
     3636        '~`':U +
     3637        '~`':U +
     3638        '~`':U +
     3639        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     3640           + "~`":U +
     3641        'Layout,Hide-on-Init~`':U +
     3642        '~`':U +
     3643        '~`':U +
     3644        '~`~`~`~`~`~`~`~`~`~`~`':U +
     3645        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     3646            THEN "^^":U
     3647        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     3648             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     3649   PROCEDURE adm-apply-entry :
     3650     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3651   END PROCEDURE.
     3652   PROCEDURE adm-destroy :
