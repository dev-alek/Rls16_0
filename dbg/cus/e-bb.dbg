     4504   IF method = "TOTALS":U
     4505   THEN ""
     4506   ELSE string(jj-tot, ">>>>9")  @ sj-goods.b-code
     4507   IF method = "TOTALS":U
     4508   THEN ""
     4509   ELSE " наименований"  @ sj-goods.artic
     4510   "ИТОГО" @ sj-goods.name
     4511   (ACCUM TOTAL sj-goods.qnty  ) @ sj-goods.qnty
     4512   (ACCUM TOTAL sj-goods.brutto-sum ) @ sj-goods.brutto-sum
     4513   (ACCUM TOTAL sj-goods.discnt-sum ) @ sj-goods.discnt-sum
     4514   (ACCUM TOTAL sj-goods.netto-sum ) @ sj-goods.netto-sum
     4515   (ACCUM TOTAL sj-goods.uchet-sum) @ sj-goods.uchet-sum
     4516   (ACCUM TOTAL sj-goods.n-u-sum  ) @ sj-goods.n-u-sum
     4517   with FRAME SJ-Base .
     4518   UNDERLINE STREAM PrnLibStream
     4519   jj-tot
     4520   sj-goods.b-code
     4521   sj-goods.artic
     4522   sj-goods.name
     4523   clients.obj-name
     4524   sj-goods.qnty
     4525   sj-goods.unit
     4526   sj-goods.brutto-sum
     4527   sj-goods.discnt-sum
     4528   sj-goods.netto-sum
     4529   sj-goods.uchet-sum
     4530   sj-goods.u-pcnt
     4531   sj-goods.n-u-sum
     4532   with FRAME SJ-Base .
