     1654       define variable varinvatp-envdocur             as   character              no-undo.
     1655       define variable varinvatp-typeocur             as   character              no-undo.
     1656   do on error undo, return error return-value :
     1657   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     1658   for each bf_tt-allsum on error undo, return error return-value :
     1659     delete bf_tt-allsum.
     1660   end.
     1661   assign
     1662     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     1663     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     1664   .
     1665   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1667     (output varinvprbcl
     1668     )  .
     1669     if cl_tt-clcparts.out-code = 'free-zone':U     or
     1670        cl_tt-clcparts.out-code = 'out-zone':U   or
     1671        cl_tt-clcparts.doc-type = 'акт':U then do:
     1672       assign
     1673         in-vatp-have-vat-sltcl = yes.
     1674     end.
     1675     else do:
     1676       find first in-vatp_doc-attrcl no-lock
     1677         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     1678           and in-vatp_doc-attrcl.attr-code = 'envd':U
     1679         no-error .
     1680       if not available in-vatp_doc-attrcl then do:
     1681         assign
     1682           in-vatp-have-vat-sltcl = yes.
     1683       end.
     1684       else do:
     1685            in-vatp-have-vat-sltcl = no.
     1686       end.
     1687     end.
     1688     assign
     1689      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     1690      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     1691     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     1692              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     1693     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     1694             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     1695             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     1696             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     1697             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     1698             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     1699             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     1700       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     1701     assign
     1702       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
     1703     assign
     1704       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
     1705       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
     1706       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
     1707       transport-cli-loccl  = 0
     1708       other-cli-loccl      = 0
     1709     .
     1710   ASSIGN
     1711             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
     1712       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
     1713   .
     1714   if paris-doc then do:
     1715     assign
     1716       parartic     = cl_tt-clcparts.artic
     1717       parprod-type = cl_tt-clcparts.prod-type
     1718       parprod-code = cl_tt-clcparts.prod-code
     1719       pardoc-type  = cl_tt-clcparts.doc-type
     1720       pardoc-code  = cl_tt-clcparts.out-code
     1721       parobj-type  = cl_tt-clcparts.obj-type
     1722       parobj-code  = cl_tt-clcparts.obj-code.
