     3727   PROCEDURE notify :
     3728     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     3729     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     3730     IF RETURN-VALUE = "ADM-ERROR":U THEN
     3731         RETURN "ADM-ERROR":U.
     3732     RETURN.
     3733   END PROCEDURE.
     3734   PROCEDURE set-attribute-list :
     3735     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     3736     RUN ensure-broker.
     3737     RUN broker-set-attribute-list IN adm-broker-hdl
     3738         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     3739     RETURN.
     3740   END PROCEDURE.
     3741   PROCEDURE set-position :
     3742       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     3743       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     3744       IF VALID-HANDLE(adm-object-hdl) THEN
     3745       DO:
     3746           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     3747           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     3748           DO:
     3749             IF p-row = 0 THEN p-row =
     3750               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     3751             IF p-col = 0 THEN p-col =
     3752               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     3753           END.
     3754           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     3755           DO:
     3756             parent-hdl = adm-object-hdl:PARENT.
     3757             IF p-row = 0 THEN p-row =
     3758               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     3759                 parent-hdl:ROW.
     3760             IF p-col = 0 THEN p-col =
     3761               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     3762                 parent-hdl:COL.
     3763           END.
     3764           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     3765           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     3766         ASSIGN adm-object-hdl:ROW    =   p-row
     3767                adm-object-hdl:COLUMN =   p-col.
     3768       END.
     3769       RETURN.
     3770   END PROCEDURE.
     3771   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     3772       STRING(adm-object-hdl)).
     3773   PAUSE 0 BEFORE-HIDE.
     3774   PROCEDURE adm-change-page :
     3775     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     3776     END PROCEDURE.
     3777   PROCEDURE delete-page :
     3778     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     3779     RUN broker-delete-page IN adm-broker-hdl
     3780         (INPUT THIS-PROCEDURE, INPUT p-page#).
     3781     END PROCEDURE.
     3782   PROCEDURE init-object :
     3783     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     3784     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     3785     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     3786     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     3787     RUN broker-init-object IN adm-broker-hdl
     3788         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     3789          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     3790     RETURN.
     3791   END PROCEDURE.
     3792   PROCEDURE init-pages :
