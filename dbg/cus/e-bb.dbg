     4543   PROCEDURE PrintProcGroup :
     4544   define variable i as integer no-undo .
     4545   define variable Line                as      char    no-undo.
     4546   define variable cash_string     as      char    no-undo.
     4547   define variable sale_string     as      char    no-undo.
