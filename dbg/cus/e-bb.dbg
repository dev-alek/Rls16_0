     3269   end procedure.
     3270   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3271   define variable v-waitfram-action01         as character   no-undo .
     3272   define variable v-waitfram-action02         as character   no-undo .
     3273   define variable v-waitfram-action03         as character   no-undo .
     3274   define variable mWaitFramTextBeg            as character   no-undo.
     3275   define variable mWaitFramTextEnd            as character   no-undo.
     3276   define variable mWaitFramView               as logical     no-undo.
     3277   define variable mWaitProcEvent              as logical     no-undo init yes.
     3278   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3279   define variable mWaitFramStop               as logical     no-undo.
     3280   define variable mWaitFramStopUser           as logical     no-undo.
     3281   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3282   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3283   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3284   define button B-WaitFramStop auto-end-key
     3285        label "Стоп"
     3286        size 10 by 1 tooltip "Остоновить процесс".
     3287   define button B-viewProcInfo
     3288        label "Информация"
     3289        size 15 by 1 tooltip "Информация о процесс".
     3290   define frame waitfram
     3291     v-waitfram-action01 format "x(72)" no-label skip
     3292     v-waitfram-action02 format "x(72)" no-label skip
     3293     v-waitfram-action03 format "x(72)" no-label skip
     3294     B-viewProcInfo
     3295     B-WaitFramStop at row 4 col 30
     3296     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3297     .
     3298   define new global shared variable mBatchMode as logical no-undo init ?.
     3299   define variable mFramBachModHandle as handle no-undo.
     3300   mFramBachModHandle = frame waitfram:handle.
     3301   define variable mFameOldVis as logical no-undo.
     3302   define variable mVisCUrentVin as logical no-undo.
     3303   if session:batch-mode
     3304   then
     3305      mBatchMode = yes.
     3306   if mBatchMode = ? then do:
     3307     mVisCUrentVin = current-window:visible.
     3308     mFameOldVis = mFramBachModHandle:visible.
     3309     mFramBachModHandle:visible  = yes.
     3310     mBatchMode = mFramBachModHandle:visible ne yes.
     3311     mFramBachModHandle:visible = mFameOldVis.
     3312     current-window:visible = mVisCUrentVin.
     3313   end.
     3314    if  log-manager:logfile-name ne ?
     3315     then DO:
     3316         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3317         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3318         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3319     end.
     3320   on choose of B-WaitFramStop in frame waitfram
     3321   do:
     3322     mWaitFramStop = yes.
     3323     mWaitFramStopUser = yes.
     3324   end.
     3325   function waitfram-check-timeout returns logical():
     3326      define variable vtime as int64 no-undo.
     3327      if mWaitFramStopTimeOut
     3328      then
     3329         return yes.
     3330      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3331      if     mWaitFramTimeOut ne ?
     3332         and mWaitFramTimeOut ne 0
     3333         and mWaitFramTimeOut lt vtime
     3334      then do:
     3335         mWaitFramStopTimeOut = yes.
     3336      end.
     3337      return mWaitFramStopTimeOut.
     3338   end.
     3339   procedure waitfram-hide :
     3340     if not session:batch-mode
     3341     then do
     3342     on error undo, return error return-value
     3343     :
     3344       pause 0 before-hide .
     3345       if not mBatchMode then
     3346         hide frame waitfram .
     3347     if     not mWaitFramView
     3348        and mWaitProcEvent
     3349     then
     3350       process events .
     3351     end.
     3352   end procedure.
     3353   procedure waitfram-show :
     3354     define input  parameter p-message as character no-undo .
     3355     define variable v-left-margin as integer   no-undo .
     3356     if not session:batch-mode
     3357     then do
     3358     on error undo, return error return-value
     3359     :
     3360       if length(p-message) <= 70 then do:
     3361         assign
     3362           v-left-margin = integer((70 - length(p-message)) / 2)
     3363         .
     3364         assign
     3365           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3366         .
     3367         assign
     3368           v-waitfram-action01 = " "
     3369           v-waitfram-action02 = " "
     3370                                    + fill(" ", v-left-margin)
     3371                                    + p-message
     3372           v-waitfram-action03 = " "
     3373         .
     3374       end.
     3375       else do:
     3376         define variable vRindex1 as integer no-undo.
     3377         define variable vRindex2 as integer no-undo.
     3378         vRindex1 = r-index(p-message," ",70).
     3379         if vRindex1 = 0
     3380         then
     3381            vRindex1 = 70.
     3382         if length(p-message)  <= vRindex1 + 70 then do:
     3383           assign
     3384             v-waitfram-action01 = " "
     3385             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3386             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3387           .
     3388         end.
     3389         else do:
     3390           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3391           if vRindex2 <= vRindex1
     3392           then
     3393              vRindex2 = vRindex1 + 70.
     3394           assign
     3395             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3396             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3397             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3398           .
     3399         end.
     3400       end.
     3401       B-viewProcInfo:visible   in frame waitfram = no.
     3402       B-viewProcInfo:sensitive in frame waitfram = no.
     3403       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3404       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3405       if  (   mWaitFramView
     3406          or  mWaitProcEvent)
     3407          and not mBatchMode
     3408       then
     3409          display
     3410             v-waitfram-action01 skip
     3411             v-waitfram-action02 skip
     3412             v-waitfram-action03 skip
     3413          with frame waitfram .
     3414       if     mWaitFramView
     3415          then do:
     3416             if     mWaitFramInterval ne ?
     3417                and not mBatchMode
     3418             then
     3419                wait-for go of frame waitfram pause mWaitFramInterval.
     3420          end.
     3421          else
     3422             if     mWaitProcEvent
     3423                and not mBatchMode
     3424             then
     3425                process events .
     3426     end.
     3427   end procedure.
     3428      procedure waitfram-show-this:
     3429         define input  parameter iInterval as int64 no-undo.
     3430         define variable vtime as int64 no-undo.
     3431         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3432         mWaitFramInterval = iInterval.
     3433         run waitfram-show (substitute("&1&2 &3&4" ,
     3434                                       mWaitFramTextBeg ,
     3435                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3436                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3437                                       mWaitFramTextEnd
     3438                                      )
     3439                           ).
     3440      end.
     3441      procedure WaitFramRunPause:
     3442         define input  parameter iInterval as dec no-undo.
     3443         define variable vStart  as datetime-tz no-undo.
     3444         define variable vend    as datetime-tz no-undo.
     3445         define variable vint as int64 no-undo.
     3446         define variable vOk as logical no-undo.
     3447         vStart = now.
     3448         vend   = vStart.
     3449         publish "WaitFramPause" (iInterval,output vOk).
     3450         vend   =  now.
     3451         vint = vend - vStart.
     3452         vint = iInterval - vint / 1000.
     3453         if     not mWaitFramStop
     3454            and (   vint > 0
     3455                 or (    not vOk
     3456                     and iInterval eq ?
     3457                     )
     3458                 )
     3459         then
     3460            run waitfram-show-this (iInterval).
     3461         vend   =  now.
     3462         vint = vend - vStart.
     3463         vint = iInterval - vint / 1000.
     3464         if     not mWaitFramStop
     3465            and vint > 0
     3466         then do:
     3467            run gbl/pause.p (vint * 1000).
     3468         end.
     3469         if iInterval ne ?
     3470         then
     3471            publish "WaitFramStop".
     3472         waitfram-check-timeout().
     3473      end.
     3474      procedure WaitFramWaitFor:
     3475         define input  parameter iInterval as dec no-undo.
     3476         assign
     3477            mWaitFramStartProc   = now
     3478            mWaitFramStopUser    = no
     3479            mWaitFramStopTimeOut = no
     3480         .
     3481         block-wait:
     3482         do while not mWaitFramStop:
     3483            run WaitFramRunPause (iInterval).
     3484            if  waitfram-check-timeout()
     3485            then do:
     3486               leave block-wait.
     3487            end.
     3488         end.
     3489         run waitfram-hide.
     3490      end.
     3491   procedure waitfram-join :
     3492     define input  parameter p-line-1  as character no-undo .
     3493     define input  parameter p-line-2  as character no-undo .
     3494     define input  parameter p-line-3  as character no-undo .
     3495     define output parameter p-message as character no-undo .
     3496     do
     3497     on error undo, return error return-value
     3498     :
     3499       assign
     3500         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3501                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3502                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3503       .
     3504     end.
     3505   end procedure.
     3506   function waitfram-join-function returns character
     3507     (input p-line-1 as character
     3508     ,input p-line-2 as character
     3509     ,input p-line-3 as character
     3510     ).
     3511     define variable v-message as character no-undo .
     3512     run waitfram-join in this-procedure
     3513       (input  p-line-1
     3514       ,input  p-line-2
     3515       ,input  p-line-3
     3516       ,output v-message
     3517       ) .
     3518     return v-message .
     3519   end function .
