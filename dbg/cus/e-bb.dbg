     1034   function diff-list returns character (
     1035     input parfirst-list  as character,
     1036     input parsecond-list as character,
     1037     input pardelim       as character).
     1038     if pardelim = ""
     1039     or pardelim = ?
     1040     then do:
     1041       assign
     1042         pardelim = ","
     1043       .
     1044     end.
     1045     def var ind as integer no-undo .
     1046     def var v-elem as character no-undo .
     1047     def var v-result-list as character no-undo init "".
     1048     def var v-num-parfirst-list as integer no-undo .
     1049     assign
     1050       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1051     .
     1052     do ind = 1 to v-num-parfirst-list
     1053     :
     1054       assign
     1055         v-elem = entry(ind, parfirst-list, pardelim)
     1056       .
     1057       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1058         assign
     1059           v-result-list = v-result-list
     1060                         + (if v-result-list > "" then pardelim else "")
     1061                         + v-elem
     1062         .
     1063       end.
     1064     end.
     1065     return v-result-list .
     1066   end function.
     1067   function add-list returns character (
     1068    input parfirst-list  as character,
     1069    input parsecond-list as character,
     1070    input pardelim       as character).
     1071     if pardelim = ""
     1072     or pardelim = ?
     1073     then do:
     1074       assign
     1075         pardelim = ","
     1076       .
     1077     end.
     1078     def var ind as integer no-undo .
     1079     def var v-elem as character no-undo .
     1080     def var v-result-list as character no-undo init "".
     1081     def var v-num-parfirst-list as integer no-undo .
     1082     assign
     1083       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1084     .
     1085     do ind = 1 to v-num-parfirst-list
     1086     :
     1087       assign
     1088         v-elem = entry(ind, parfirst-list, pardelim)
     1089       .
     1090       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1091         assign
     1092           v-result-list = v-result-list
     1093                         + (if v-result-list > "" then pardelim else "")
     1094                         + v-elem
     1095         .
     1096       end.
     1097     end.
     1098     def var v-num-parsecond-list as integer no-undo .
     1099     assign
     1100       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1101     .
     1102     do ind = 1 to v-num-parsecond-list
     1103     :
     1104       assign
     1105         v-elem = entry(ind, parsecond-list, pardelim)
     1106       .
     1107       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1108         assign
     1109           v-result-list = v-result-list
     1110                         + (if v-result-list > "" then pardelim else "")
     1111                         + v-elem
     1112         .
     1113       end.
     1114     end.
     1115     return v-result-list .
     1116   end function.
     1117   function cross-list returns character (
     1118    input parfirst-list  as character,
     1119    input parsecond-list as character,
     1120    input pardelim       as character).
     1121     if pardelim = ""
     1122     or pardelim = ?
     1123     then do:
     1124       assign
     1125         pardelim = ","
     1126       .
     1127     end.
     1128     def var ind as integer no-undo .
     1129     def var v-elem as character no-undo .
     1130     def var v-result-list as character no-undo init "".
     1131     def var v-num-parfirst-list as integer no-undo .
     1132     assign
     1133       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1134     .
     1135     do ind = 1 to v-num-parfirst-list
     1136     :
     1137       assign
     1138         v-elem = entry(ind, parfirst-list, pardelim)
     1139       .
     1140       if lookup(v-elem, v-result-list, pardelim) = 0
     1141       and lookup(v-elem, parsecond-list, pardelim) > 0
     1142       then do:
     1143         assign
     1144           v-result-list = v-result-list
     1145                         + (if v-result-list > "" then pardelim else "")
     1146                         + v-elem
     1147         .
     1148       end.
     1149     end.
     1150     return v-result-list .
     1151   end function.
     1152   function radio-label returns character (
     1153    input par-rs-value  as character,
     1154    input par-rs-radio-buttons as character)
     1155    .
     1156    DEFINE variable v-result-label as character no-undo.
     1157    assign
     1158    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1159                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1160                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1161                             ), par-rs-radio-buttons
     1162                           )
     1163    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1164    .
     1165   return v-result-label.
     1166   end function.
     1167   function m-radio-label returns character (
     1168    input par-rs-value  as character,
     1169    input par-rs-radio-buttons as character,
     1170    input par-delim as character
     1171    )
     1172    .
     1173    DEFINE variable v-result-label as character no-undo.
     1174    assign
     1175    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1176                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1177                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1178                             ), par-rs-radio-buttons, par-delim
     1179                           )
     1180    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1181    .
     1182   return v-result-label.
     1183   end function.
     1184   FUNCTION mixlist returns character
     1185   (
     1186    input parfirst-list  as character
     1187    ,input parsecond-list as character
     1188    ,input pardelim       as character
     1189    ,input pardelim-result as character ) :
     1190     if pardelim = ""
     1191     or pardelim = ?
     1192     then do:
     1193       assign
     1194         pardelim = ","
     1195       .
     1196     end.
     1197     def var ind as integer no-undo .
     1198     def var v-elem1 as character no-undo .
     1199     def var v-elem2 as character no-undo .
     1200     def var v-result-list as character no-undo init "".
     1201     do ind = 1 to num-entries(parfirst-list, pardelim)
     1202     :
     1203       assign
     1204         v-elem1 = entry(ind, parfirst-list, pardelim)
     1205         v-elem2 = entry(ind, parsecond-list, pardelim)
     1206       .
     1207         assign
     1208           v-result-list = v-result-list
     1209                         + (if v-result-list > "" then pardelim-result else "")
     1210                         + v-elem1 + pardelim-result + v-elem2
     1211         .
     1212     end.
     1213     return v-result-list .
     1214   END FUNCTION.
     1215   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1216   function breakstr returns character ( input        for-name    as character,
     1217                                         input        line-length as integer,
     1218                                         input-output line1       as character,
     1219                                         input-output line2       as character ) :
     1220     define variable ii as integer no-undo.
     1221     if length( for-name ) > line-length then do:
     1222       assign ii    = 1
     1223              line1 = "":u
     1224              line2 = "":u.
     1225       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
     1226         assign line1 =       substring( for-name, 1, line-length     )
     1227                line2 = trim( substring( for-name,    line-length + 1 ) ).
     1228       end.                                                     else do:
     1229         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
     1230           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
     1231                  ii    = ii    + 1.
     1232           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
     1233             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
     1234           end.
     1235         end.
     1236         assign line2 = trim( substring( for-name, length( line1 ) ) ).
     1237       end.
     1238     end.                                else do:
     1239       assign line1 = for-name
     1240              line2 = "":u.
     1241     end.
     1242     return ( line1 ).
     1243   end function.
