     4573   sj-goods.brutto-sum column-label  "Сумма брутто!в ценах продажи"            format "->>>>>>>>9.99"
     4574   sj-goods.discnt-sum column-label  "Сумма скидок!в ценах продажи"            format "->>>>>>>>9.99"
     4575   sj-goods.netto-sum column-label  "Сумма нетто!в ценах продажи"              format "->>>>>>>>9.99"
     4576   sj-goods.uchet-sum column-label  "Сумма!в учетных ценах"                    format "->>>>>>>>9.99"
     4577   sj-goods.u-pcnt column-label  "Торг.!нацен. %"                              format "->>9.99%"
     4578   sj-goods.n-u-sum column-label "Эффективность"                               format "->>>>>>>>9.99"
