     2623       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     2624       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     2625       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     2626       .
     2627     assign
