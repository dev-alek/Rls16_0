     2680       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2681       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2682       .
     2683   end.
     2684   otherwise do:
     2685     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2686                              cl_tt-clcparts.purch-code,
     2687                              cl_tt-clcparts.part-code,
     2688                              cl_tt-clcparts.out-code,
     2689                              cl_tt-clcparts.in-code,
     2690                              cl_tt-clcparts.artic,
     2691                              cl_tt-clcparts.prod-type,
     2692                              cl_tt-clcparts.prod-code).
     2693   end.
     2694   end case.
     2695   end.
     2696   end procedure.
     2697   procedure clcprtsl_calc-line :
     2698   define input  parameter parrec-line as recid no-undo.
     2699   define variable v-tax-date         as   date                     no-undo.
     2700   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2701   define variable varr-b             as   character                no-undo.
     2702   define variable varr-btype         as   character                no-undo.
     2703   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2704   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2705   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2706   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2707   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2708   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2709   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2710   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2711   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2712   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2713   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2714   define variable varexcise          like ub.price-list.excise     no-undo.
     2715   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2716   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2717   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2718   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2719   define variable v-varsum           as decimal                  no-undo.
     2720   define variable varprice-salef as decimal   no-undo .
     2721   define buffer bf_trn-doc             for ub.trn-doc.
     2722   define buffer bf_doc-line            for ub.doc-line.
     2723   define buffer bf_gds-dtl             for ub.gds-dtl.
     2724   define buffer bf_goods               for ub.goods.
     2725   define buffer bf_parts               for ub.parts.
     2726   define buffer bf_sysconf             for ub.sysconf.
     2727   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2728   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2729   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2730   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2731   define buffer buf_parts        for ub.parts.
     2732   v-calcbypart = no.
     2733   do on error undo, return error return-value :
     2734   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2735   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2736     (output varr-b
     2737     )  .
     2738     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2739     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2740     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2741                               bf_goods.prod-type = bf_doc-line.prod-type and
     2742                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2743     if bf_trn-doc.fact-date <> ?        then do:
     2744       assign v-tax-date = bf_trn-doc.fact-date.
     2745     end.
     2746     else do:
     2747       assign v-tax-date = ?.
     2748     end.
     2749   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2750   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2751     (input  bf_goods.gds-code
     2752     ,input  '1':U
     2753     ,input  v-tax-date
     2754     ,input  bf_trn-doc.host-code
     2755     ,input  bf_trn-doc.obj-type
     2756     ,input  bf_trn-doc.obj-code
     2757     ,output v-vat-pc
     2758     ) no-error .
     2759     if error-status :error
     2760     or v-vat-pc = ? then do:
     2761        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2762     end.
     2763     if bf_goods.gds-type = 'у':U or
     2764        bf_trn-doc.status_ = 'запрос':U then do:
     2765       for each bf_tt-allsum-line
     2766       on error undo, return error return-value
     2767        :
     2768         delete bf_tt-allsum-line.
     2769       end.
     2770       create bf_tt-allsum-line.
     2771       assign
     2772        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2773       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2774                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2775                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2776                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2777         assign
     2778           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2779           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2780           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2781           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2782           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2783           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2784           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2785           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2786           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2787           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2788           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2789           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2790           bf_tt-allsum-line.vat-cli-acc          =  ?
     2791           .
     2792       end.
     2793       assign
     2794         bf_tt-allsum-line.cli-qnty             =  ?
     2795         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2796         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2797         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2798         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2799         bf_tt-allsum-line.road-tax-base-doc    =  0
     2800         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2801         bf_tt-allsum-line.excise-base-doc      =  0
     2802         bf_tt-allsum-line.excise-rubl-doc      =  0
     2803         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
