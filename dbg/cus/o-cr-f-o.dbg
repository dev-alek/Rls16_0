      599   DEFINE RECTANGLE RECT-1
      600        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      601        SIZE 55.13 BY 4.46.
      602   DEFINE FRAME InfoFrame
      603        StopBtn AT ROW 4.25 COL 21.75
      604        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      605        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      606        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      607        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      608        RECT-1 AT ROW 1 COL 1
      609       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      610            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      611            TITLE "Процесс"
      612            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      613   define variable mFrameView      as logical   no-undo init yes.
      614     define variable mFramHandle as handle no-undo.
      615     mFramHandle = frame InfoFrame:handle.
      616     if  log-manager:logfile-name ne ?
      617     then DO:
      618         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      619         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      620         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      621     end.
      622     mFrameView = not session:batch-mode and mFramHandle:visible.
      623     if mFrameView
      624     then do:
      625       ASSIGN
      626          FRAME InfoFrame:HIDDEN                           = TRUE
      627          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      628     end.
      629   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      630   DO:
      631     IF not StopProcessing THEN
      632       Message "Вы действительно хотите прервать" SKIP
      633               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      634                 UPDATE StopProcessing.
      635     IF StopProcessing THEN do:
      636        if mFrameView
      637        then do:
      638           HIDE FRAME InfoFrame.
      639        end.
      640     End.
      641   END.
      642   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
      643     if  log-manager:logfile-name ne ?
      644     then DO:
      645         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      646     end.
      647     if not session:batch-mode then
      648     do:
      649       VIEW FRAME InfoFrame.
      650       mFrameView = true.
      651     end.
      652      v-button-stop = false .
      653         if mFrameView
      654         then do:
      655         if v-button-stop then view STOPBTN in frame InfoFrame.
      656                          else Hide STOPBTN in frame InfoFrame.
      657         end.
