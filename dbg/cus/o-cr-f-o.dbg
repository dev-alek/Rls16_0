      766   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      767   procedure proc-ord-code :
      768   define input  parameter  p-type as character no-undo .
      769   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      770   define input  parameter  v-cntxt-obj-type as character no-undo .
      771   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      772   define input  parameter  p-i-doc    as character no-undo .
      773   define output parameter  p-ord-doc  as character no-undo .
      774   define variable          v-idop     as character no-undo .
      775     do
      776     on error undo, return error return-value
      777     :
      778   case p-type :
      779       when "main-no-ver" then do:
      780         if  (v-cntxt-db-num <> 0) then
      781           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      782         else
      783           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      784       end.
      785       when "main" then do:
      786             do while true:
      787             if  (v-cntxt-db-num <> 0) then
      788               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      789             else
      790               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      791             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      792             End.
      793       end.
      794       when "chip" then do:
      795         assign
      796           v-idop = p-i-doc .
      797         do while true :
      798           if index (v-idop , ".") = 0 then
      799             v-idop  = replace (v-idop , "-", "-1.").
      800           else
      801             v-idop  =
      802             substring (v-idop , 1, index (v-idop, "-")) +
      803             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      804             substring (v-idop, index (v-idop, ".")).
      805           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      806         end.
      807         assign
      808           p-ord-doc = v-idop.
      809       end.
      810   end case.
      811     end.
      812   end procedure.
      813   define variable i-i as integer no-undo .
      814   define variable i-m as integer no-undo .
      815   define buffer of-ord-doc  for ub.ord-doc.
      816   define buffer of-ord-line for ub.ord-line.
      817   define buffer of-ord-dtl  for ub.ord-dtl.
      818   define buffer cz-ord-doc  for ub.ord-cons.
      819   define buffer cz-ord-line for ub.ord-gds-cons.
      820   define buffer cz-ord-dtl  for ub.ord-dtl-cons.
      821   define variable loc-ord-num    like ub.ord-doc.doc-code no-undo .
      822   define variable loc-sum-qnty   as   decimal init 0 no-undo .
      823   define variable loc-sum-qnty-2 as   decimal init 0 no-undo .
      824   define variable v-i-doc as character no-undo .
      825   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      826   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      827     (input  v-cntxt-obj-type
      828     ,input  v-cntxt-obj-code
      829     ,output to-day
      830     )  .
      831   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   run proc-ord-code in this-procedure
      833    (input   'main' ,
      834     input   v-cntxt-db-num ,
      835     input   v-cntxt-obj-type ,
      836     input   v-cntxt-obj-code ,
      837     input   v-i-doc ,
      838     output  loc-ord-num
      839    ) .
      840   for each obj-list no-lock ,
      841       each of-ord-doc  where
      842       of-ord-doc.obj-code   = obj-list.obj-code  and
      843       of-ord-doc.obj-type   = obj-list.obj-type  and
      844       of-ord-doc.status_    = 'согласование':U   and
      845       of-ord-doc.doc-date  >= x-date-start and
      846       of-ord-doc.doc-date  <= x-date-end   and
      847       of-ord-doc.doc-type   = 'ОФ':U       and
      848       of-ord-doc.cons-code  =    ""       and
      849       of-ord-doc.host-code  =  v-cntxt-host-code-obj  and
      850       ( (t-sale = false)  or
      851         (of-ord-doc.date-sale-1  >= p-date-sale-1   and
      852          of-ord-doc.date-sale-2  <= p-date-sale-2 ))
      853       no-lock :
      854       i-i = i-i + 1 .
      855   end.
      856         loc-sum-qnty = 0.
      857         loc-sum-qnty-2 = 0.
      858   for each obj-list no-lock ,
      859     each of-ord-doc  where
      860       of-ord-doc.obj-code   = obj-list.obj-code   and
      861       of-ord-doc.obj-type   = obj-list.obj-type   and
      862       of-ord-doc.status_    = 'согласование':U       and
      863       of-ord-doc.doc-date  >= x-date-start        and
      864       of-ord-doc.doc-date  <= x-date-end          and
      865       of-ord-doc.doc-type   = 'ОФ':U              and
      866       of-ord-doc.cons-code  =    ""               and
      867       of-ord-doc.host-code  =  v-cntxt-host-code-obj        and
      868       ( (t-sale = false)                          or
      869         (of-ord-doc.date-sale-1  >= p-date-sale-1   and
      870          of-ord-doc.date-sale-2  <= p-date-sale-2 ))  no-lock  ,
      871       each  of-ord-dtl where
      872             of-ord-dtl.doc-code     = of-ord-doc.doc-code        NO-LOCK  break
      873                 by of-ord-dtl.node-code :
      874                       assign
      875                         loc-sum-qnty-2 = loc-sum-qnty-2  + of-ord-dtl.qnty
      876                       .
      877                       if last-of (of-ord-dtl.node-code) then do:
      878                       find first cz-ord-dtl  exclusive-lock  where
      879                         cz-ord-dtl.cons-code = loc-ord-num   and
      880                         cz-ord-dtl.artic     = of-ord-dtl.artic and
      881                         cz-ord-dtl.prod-code = of-ord-dtl.prod-code  and
      882                         cz-ord-dtl.prod-type = of-ord-dtl.prod-type  and
      883                         cz-ord-dtl.node-code = of-ord-dtl.node-code  no-error .
      884                       if not available cz-ord-dtl then do:
      885                          create cz-ord-dtl.
      886                          end.
      887                       assign
      888                         cz-ord-dtl.cons-code = loc-ord-num
      889                         cz-ord-dtl.artic     = of-ord-dtl.artic
      890                         cz-ord-dtl.prod-code = of-ord-dtl.prod-code
      891                         cz-ord-dtl.prod-type = of-ord-dtl.prod-type
      892                         cz-ord-dtl.node-code = of-ord-dtl.node-code
      893                         cz-ord-dtl.sum-qnty  = cz-ord-dtl.sum-qnty + loc-sum-qnty-2
      894                         loc-sum-qnty-2 = 0
      895                         .
      896                       end.
      897   IF ( i-m modulo v-account = 0 )  then DO:
      898             if  log-manager:logfile-name ne ?
      899             then DO:
      900                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      901             end.
      902              if mFrameView
      903              then do:
      904               DISPLAY
      905                 i-m @ RecordsDone
      906                 WITH FRAME InfoFrame.
      907              end.
      908   End.
      909      if v-button-stop then  DO:
      910            if mFrameView
      911            then
      912               PROCESS EVENTS.
      913            IF StopProcessing THEN DO:
      914            RETURN error.
      915            End.
      916      end.
      917   end.
      918   i-m = 0 .
      919         loc-sum-qnty = 0.
      920         loc-sum-qnty-2 = 0.
      921   for each obj-list no-lock ,
      922     each of-ord-doc  where
      923       of-ord-doc.obj-code   = obj-list.obj-code  and
      924       of-ord-doc.obj-type   = obj-list.obj-type  and
      925       of-ord-doc.status_    = 'согласование':U   and
      926       of-ord-doc.doc-date  >= x-date-start and
      927       of-ord-doc.doc-date  <= x-date-end   and
      928       of-ord-doc.doc-type   = 'ОФ':U       and
      929       of-ord-doc.cons-code  =    ""       and
      930       of-ord-doc.host-code  =  v-cntxt-host-code-obj and
      931       ( (t-sale = false)  or
      932         (of-ord-doc.date-sale-1  >= p-date-sale-1   and
      933          of-ord-doc.date-sale-2  <= p-date-sale-2 ))
      934       exclusive-lock ,
      935       each of-ord-line where
      936             of-ord-doc.doc-code = of-ord-line.doc-code
      937             exclusive-lock
      938             break by of-ord-line.prod-code
      939                   by of-ord-line.prod-type
      940                   by of-ord-line.artic
      941       :
      942       assign
      943         loc-sum-qnty = loc-sum-qnty  + of-ord-line.qnty
      944       .
      945       if last-of (of-ord-line.artic) then do:
      946       create cz-ord-line.
      947       assign
      948         cz-ord-line.cons-code = loc-ord-num
      949         cz-ord-line.artic     = of-ord-line.artic
      950         cz-ord-line.prod-code = of-ord-line.prod-code
      951         cz-ord-line.prod-type = of-ord-line.prod-type
      952         cz-ord-line.sum-qnty  = loc-sum-qnty
      953         loc-sum-qnty = 0
      954         i-m = i-m + 1
      955          .
      956   IF ( i-m modulo v-account = 0 )  then DO:
      957             if  log-manager:logfile-name ne ?
      958             then DO:
      959                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      960             end.
      961              if mFrameView
      962              then do:
      963               DISPLAY
      964                 i-m @ RecordsDone
      965                 WITH FRAME InfoFrame.
      966              end.
      967   End.
      968      if v-button-stop then  DO:
      969            if mFrameView
      970            then
      971               PROCESS EVENTS.
      972            IF StopProcessing THEN DO:
      973            RETURN error.
      974            End.
      975      end.
      976       end.
      977   end.
      978   if  i-m  <> 0 then do:
      979       create cz-ord-doc.
      980       assign
      981           cz-ord-doc.cons-code  = loc-ord-num
      982           cz-ord-doc.creid      = v-cntxt-userid
      983           cz-ord-doc.doc-date   = to-day
      984           cz-ord-doc.host-code  = v-cntxt-host-code-obj
      985           cz-ord-doc.input-obj-type = v-cntxt-obj-type
      986           cz-ord-doc.input-obj-code = v-cntxt-obj-code
      987           cz-ord-doc.status_    = 'новый':U
      988           cz-ord-doc.PS         = str1 + " " + str2 + " " + str3 + " " + str4 + " " + ReportHeader
      989           .
      990   end.
      991   for each obj-list no-lock ,
      992       each of-ord-doc  where
      993       of-ord-doc.obj-code   = obj-list.obj-code  and
      994       of-ord-doc.obj-type   = obj-list.obj-type  and
      995       of-ord-doc.status_    = 'согласование':U   and
      996       of-ord-doc.doc-date  >= x-date-start and
      997       of-ord-doc.doc-date  <= x-date-end   and
      998       of-ord-doc.doc-type   = 'ОФ':U       and
      999       of-ord-doc.cons-code  =  ""          and
     1000       of-ord-doc.host-code  =  v-cntxt-host-code-obj and
     1001       ( (t-sale = false)  or
     1002         (of-ord-doc.date-sale-1  >= p-date-sale-1   and
     1003          of-ord-doc.date-sale-2  <= p-date-sale-2 ))
     1004       exclusive-lock :
     1005       assign
     1006         of-ord-doc.cons-code  = loc-ord-num
     1007         .
     1008   end.
     1009   if mFrameView
     1010   then do:
     1011      HIDE FRAME InfoFrame.
     1012   end.
     1013   if i-i = 0 then
     1014       message "Нет заявок ОФ " view-as alert-box .
     1015   else
     1016      message "Формирование закончено! " skip
     1017              "Согласовано" i-i "заявок  ОФ." skip
     1018              "cоздана заявка n " loc-ord-num view-as alert-box .
