      579   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      580   DEFINE BUTTON StopBtn AUTO-END-KEY
      581        LABEL "Стоп"
      582        SIZE 10 BY 1.
      583   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      584        LABEL "Обработано записей"
      585         VIEW-AS TEXT
      586        SIZE 14 BY .67 NO-UNDO.
      587   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      588         VIEW-AS TEXT
      589        SIZE 53.25 BY .67
      590        FGCOLOR 1  NO-UNDO.
      591   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      592         VIEW-AS TEXT
      593        SIZE 53.25 BY .67
      594        FGCOLOR 1  NO-UNDO.
      595   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
