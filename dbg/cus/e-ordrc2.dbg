      960   PROCEDURE adm-update-record :
      961       MESSAGE
      962         "Object ":U THIS-PROCEDURE:FILE-NAME
      963           "must have at least one Enabled Table to perform Update.":U
      964             VIEW-AS ALERT-BOX ERROR.
      965      RETURN.
      966   END PROCEDURE.
      967   PROCEDURE check-modified :
      968   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      969   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      970   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      971   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      972     IF check-state = "check":U THEN
      973     DO:
      974       RUN get-link-handle IN adm-broker-hdl
      975         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      976            OUTPUT group-target-list).
      977       IF group-target-list NE "":U THEN
      978       DO i = 1 TO NUM-ENTRIES(group-target-list):
      979         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      980         RUN check-modified IN curr-widget ('group-check':U).
      981         IF RETURN-VALUE NE "":U THEN
      982         DO:
      983           RUN check-modified-message(RETURN-VALUE).
      984           RETURN "":U.
      985         END.
      986       END.
      987     END.
      988     RETURN "":U.
      989   END PROCEDURE.
      990   PROCEDURE check-modified-message :
      991     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      992        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      993           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      994        IF RETURN-VALUE = "YES":U THEN
      995           RUN notify ('view,CONTAINER-SOURCE':U).
      996        MESSAGE IF p-changed-table NE ? THEN
      997           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      998           ELSE "Current values have been changed."
      999           SKIP "  Do you wish to save those changes?"
     1000           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1001        IF ANS THEN
     1002        DO:
     1003           IF group-assign-target THEN
     1004             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1005           ELSE RUN dispatch('update-record':U).
     1006           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1007           DO:
     1008               MESSAGE "Changes to the previous record were not saved."
     1009                 VIEW-AS ALERT-BOX ERROR.
     1010               IF group-assign-target THEN
     1011                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1012               ELSE RUN dispatch ('cancel-record':U).
     1013           END.
     1014        END.
     1015        ELSE DO:
     1016          IF group-assign-target THEN
     1017             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1018          ELSE RUN dispatch('cancel-record':U).
     1019        END.
     1020        RETURN.
     1021   END PROCEDURE.
     1022   PROCEDURE get-rowid :
     1023       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1024       ASSIGN
     1025       p-table   =   adm-first-table.
     1026       RETURN.
     1027   END PROCEDURE.
     1028   PROCEDURE init-group-assign :
     1029       RUN request-attribute IN adm-broker-hdl
     1030         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1031       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1032         group-assign-target = yes.
     1033       ELSE group-assign-target = no.
     1034       RETURN.
     1035   END PROCEDURE.
     1036   PROCEDURE set-editors :
     1037       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1038       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1039       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1040       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1041       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1042       DO WHILE VALID-HANDLE (curr-widget):
     1043           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1044              curr-widget:HIDDEN = no THEN DO:
     1045             CASE p-field-setting:
     1046               WHEN "INITIALIZE":U THEN
     1047               DO:
     1048                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1049                     read-only-list +
     1050                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1051                        STRING(curr-widget).
     1052               END.
     1053               WHEN "DISABLE":U OR
     1054               WHEN "ENABLE":U THEN
     1055               DO:
     1056                   curr-widget:SENSITIVE = yes.
     1057                   RUN get-attribute ('Read-Only-Editors':U).
     1058                   IF RETURN-VALUE = ? OR
     1059                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1060                       curr-widget:READ-ONLY =
     1061                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1062               END.
     1063               WHEN "CLEAR":U THEN
     1064                   curr-widget:SCREEN-VALUE = "":U.
     1065             END CASE.
     1066           END.
     1067           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1068       END.
     1069       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1070         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1071           + '"':U).
     1072       RETURN.
     1073   END PROCEDURE.
     1074   PROCEDURE use-check-modified-all :
     1075    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1076     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1077     RETURN.
     1078   END PROCEDURE.
     1079   PROCEDURE use-create-on-add :
     1080   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1081      RETURN.
     1082   END PROCEDURE.
     1083   PROCEDURE use-initial-lock :
     1084     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1085     ASSIGN adm-initial-lock = p-attr-value.
     1086     RETURN.
     1087   END PROCEDURE.
     1088     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1089   ASSIGN
     1090          FRAME F-Main:SCROLLABLE       = FALSE
     1091          FRAME F-Main:HIDDEN           = TRUE
     1092          FRAME F-Main:PRIVATE-DATA     =
     1093                   "DLGCLOSE".
     1094   if not this-procedure :persistent
     1095   then do:
     1096     message
     1097       vss-workfile vss-revision vss-description skip
     1098       "Ошибка при запуске процедуры" skip
     1099       "Данную процедуру следует запускать только с параметром persistent" skip
     1100       view-as alert-box error .
     1101     undo, return error .
     1102   end.
     1103   PROCEDURE disable_UI :
     1104     HIDE FRAME F-Main.
     1105     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1106   END PROCEDURE.
     1107   PROCEDURE local-initialize :
     1108     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1109      T-fact:screen-value in frame F-Main = 'yes'.
     1110      T-new:screen-value in frame F-Main = 'yes'.
     1111      T-per:screen-value in frame F-Main = 'yes'.
     1112      T-req:screen-value in frame F-Main = 'yes'.
     1113      T-ship:screen-value in frame F-Main = 'yes'.
     1114   END PROCEDURE.
     1115   PROCEDURE my-report :
     1116   run cus/r-ordrc2.p
     1117    ( input t-fact,
     1118      input t-new ,
     1119      input t-per,
     1120      input t-req,
     1121      input t-ship ,
     1122      input p-mode,
     1123      input OrdDate ) .
     1124   END PROCEDURE.
     1125   PROCEDURE my-var :
     1126   define variable t-OrdDate as character no-undo .
     1127   assign frame F-Main T-fact T-new T-per T-req T-ship OrdDate.
     1128   if X-SelectGood =  1 then do:
     1129      empty TEMP-TABLE gds-list.
     1130   end.
     1131   case OrdDate :
     1132    when "doc-date" then t-OrdDate = "дате создания заказа" .
     1133    when "ship-date" then t-OrdDate = "дате поставки" .
     1134   end case.
     1135   ReportHeader = "Статусы: " .
     1136    if T-new:screen-value  in frame F-Main = 'yes' then ReportHeader =  ReportHeader  + T-new:label + chr(10) .
     1137    if T-req:screen-value  in frame F-Main = 'yes'  then ReportHeader =  ReportHeader + T-req:label + chr(10) .
     1138    if T-per:screen-value  in frame F-Main = 'yes'  then ReportHeader =  ReportHeader + T-per:label + chr(10) .
     1139    if T-ship:screen-value in frame F-Main = 'yes'  then ReportHeader =  ReportHeader + T-ship:label + chr(10) .
     1140    if T-fact:screen-value in frame F-Main = 'yes'  then ReportHeader =  ReportHeader + T-fact:label + chr(10) .
     1141   ReportHeader = ReportHeader + chr(10) + "Формировать отчет по " + t-OrdDate .
     1142   END PROCEDURE.
     1143   PROCEDURE state-changed :
     1144     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1145     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1146     CASE p-state:
     1147     END CASE.
     1148   END PROCEDURE.
