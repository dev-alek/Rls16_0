      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   define variable p-mode as character no-undo .
      678   CREATE WIDGET-POOL.
      679   define variable State-source as  WIDGET-HANDLE.
      680   if reportname begins "2." then
      681       assign
      682         p-mode = "RC":U
      683         reportname = "ОТЧЕТ ПО ЗАКАЗАМ ОРЦ на РЦ"
      684       .
      685     else assign
      686       p-mode = ""
      687       reportname = "ОТЧЕТ ПО ЗАКАЗАМ ОРЦ на объекте"
      688     .
      689   DEFINE VARIABLE OrdDate AS CHARACTER
      690        VIEW-AS RADIO-SET VERTICAL
      691        RADIO-BUTTONS
      692             "дате создания заказа", "doc-date":U,
      693   "дате поставки", "ship-date":U
      694        SIZE 26 BY 2.52 NO-UNDO.
      695   DEFINE RECTANGLE RECT-5
      696        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      697        SIZE 15.8 BY 6.81.
      698   DEFINE RECTANGLE RECT-7
      699        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      700        SIZE 30 BY 6.67.
      701   DEFINE VARIABLE T-fact AS LOGICAL INITIAL yes
      702        LABEL "Факт"
      703        VIEW-AS TOGGLE-BOX
      704        SIZE 11.6 BY .81 NO-UNDO.
      705   DEFINE VARIABLE T-new AS LOGICAL INITIAL yes
      706        LABEL "Новый"
      707        VIEW-AS TOGGLE-BOX
      708        SIZE 8.6 BY .81 NO-UNDO.
      709   DEFINE VARIABLE T-per AS LOGICAL INITIAL yes
      710        LABEL "Разрешено"
      711        VIEW-AS TOGGLE-BOX
      712        SIZE 14 BY .81 NO-UNDO.
      713   DEFINE VARIABLE T-req AS LOGICAL INITIAL yes
      714        LABEL "Запрос"
      715        VIEW-AS TOGGLE-BOX
      716        SIZE 8.6 BY .81 NO-UNDO.
      717   DEFINE VARIABLE T-ship AS LOGICAL INITIAL yes
      718        LABEL "Отгружено"
      719        VIEW-AS TOGGLE-BOX
      720        SIZE 14 BY .81 NO-UNDO.
      721   DEFINE FRAME F-Main
      722        T-new AT ROW 2.95 COL 2.6
      723        OrdDate AT ROW 3.24 COL 19.2 NO-LABEL WIDGET-ID 10
      724        T-req AT ROW 3.71 COL 2.6
      725        T-per AT ROW 4.52 COL 2.6
      726        T-ship AT ROW 5.24 COL 2.6
      727        T-fact AT ROW 6.1 COL 2.6
      728        "Формировать отчет по :" VIEW-AS TEXT
      729             SIZE 31 BY .67 AT ROW 1.95 COL 19 WIDGET-ID 16
      730             FGCOLOR 4
      731        "Статус" VIEW-AS TEXT
      732             SIZE 7 BY .67 AT ROW 2 COL 3
      733             FGCOLOR 4
      734        RECT-5 AT ROW 1.19 COL 1.8
      735        RECT-7 AT ROW 1.24 COL 18 WIDGET-ID 14
      736       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      737            SIDE-LABELS NO-UNDERLINE THREE-D
      738            AT COL 1 ROW 1 SCROLLABLE .
      739   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      740   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      741   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      742   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      743   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      744   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      745   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      746   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      747         adm-object-hdl = FRAME F-Main:HANDLE.
      748   RUN ensure-broker.
      749   THIS-PROCEDURE:ADM-DATA =
      750        'ADM1.1~`':U +
      751        'SmartObject~`':U +
      752        '~`':U +
      753        'NO ~`':U +
      754        '~`':U +
      755        '~`':U +
      756        '~`':U +
      757        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      758           + "~`":U +
      759        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      760        'Record-Source,Record-Target,TableIO-Target~`':U +
      761        '~`':U +
      762        '~`~`~`~`~`~`~`~`~`~`~`':U +
      763        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      764            THEN "^^":U
      765        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      766             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      767   PROCEDURE adm-apply-entry :
      768     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      769   END PROCEDURE.
      770   PROCEDURE adm-destroy :
      771    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      772   END PROCEDURE.
      773   PROCEDURE adm-disable :
      774       DISABLE RECT-5 RECT-7 T-new OrdDate T-req T-per T-ship T-fact WITH FRAME F-Main.
      775       RUN dispatch ('disable-fields':U).
      776       RUN set-attribute-list ('ENABLED=no':U).
      777       RETURN.
      778   END PROCEDURE.
      779   PROCEDURE adm-edit-attribute-list :
      780         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      781         RETURN.
      782   END PROCEDURE.
      783   PROCEDURE adm-enable :
      784       ENABLE UNLESS-HIDDEN RECT-5 RECT-7 T-new OrdDate T-req T-per T-ship T-fact WITH FRAME F-Main.
      785       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      786       RUN set-attribute-list ('ENABLED=yes':U).
      787       RETURN.
      788   END PROCEDURE.
      789   PROCEDURE adm-exit :
      790        RUN notify ('exit':U).
      791     RETURN.
      792   END PROCEDURE.
      793   PROCEDURE adm-hide :
      794     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      795   END PROCEDURE.
      796   PROCEDURE adm-initialize :
      797     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      798   END PROCEDURE.
      799   PROCEDURE adm-show-errors :
      800       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      801       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      802           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      803       END.
      804       RETURN.
      805   END PROCEDURE.
      806   PROCEDURE adm-UIB-mode :
      807     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      808   END PROCEDURE.
      809   PROCEDURE adm-view :
      810     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      811   END PROCEDURE.
      812   PROCEDURE dispatch :
      813       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      814       RUN broker-dispatch IN adm-broker-hdl
      815           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      816       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      817   END PROCEDURE.
      818   PROCEDURE ensure-broker :
      819   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      820   IF RETURN-VALUE NE "ADM-Broker":U THEN
      821   DO:
      822       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      823       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      824   END.
      825   END PROCEDURE.
      826   PROCEDURE get-attribute :
      827     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      828     RUN broker-get-attribute IN adm-broker-hdl
      829         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      830     RETURN RETURN-VALUE.
      831   END PROCEDURE.
      832   PROCEDURE get-attribute-list :
      833     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      834     RUN broker-get-attribute-list IN adm-broker-hdl
      835         (INPUT THIS-PROCEDURE,
      836          INPUT ?,
      837          OUTPUT p-attr-list) NO-ERROR.
      838     RETURN.
      839   END PROCEDURE.
      840   PROCEDURE new-state :
      841     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      842     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      843     RETURN.
      844   END PROCEDURE.
      845   PROCEDURE notify :
      846     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      847     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      848     IF RETURN-VALUE = "ADM-ERROR":U THEN
      849         RETURN "ADM-ERROR":U.
      850     RETURN.
      851   END PROCEDURE.
      852   PROCEDURE set-attribute-list :
      853     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      854     RUN ensure-broker.
      855     RUN broker-set-attribute-list IN adm-broker-hdl
      856         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      857     RETURN.
      858   END PROCEDURE.
      859   PROCEDURE set-position :
      860       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      861       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      862       IF VALID-HANDLE(adm-object-hdl) THEN
      863       DO:
      864         ASSIGN adm-object-hdl:ROW    =   p-row
      865                adm-object-hdl:COLUMN =   p-col.
      866       END.
      867       RETURN.
      868   END PROCEDURE.
      869   PROCEDURE adm-display-fields :
      870       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      871       RETURN.
      872   END PROCEDURE.
      873   PROCEDURE adm-open-query :
      874     RETURN.
      875   END PROCEDURE.
      876   PROCEDURE adm-row-changed :
      877         IF VALID-HANDLE(adm-object-hdl) THEN
      878           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      879         RUN notify ('row-available':U).
      880         RETURN.
      881   END PROCEDURE.
      882   PROCEDURE reposition-query :
      883       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      884       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      885       RETURN.
      886   END PROCEDURE.
      887     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      888     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      889     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      890     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      891     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      892     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      893     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      894     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      895     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      896     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      897     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      898     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      899     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      900     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      901     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      902     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      903     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      904     IF "":U = "":U THEN
      905       RUN modify-list-attribute IN adm-broker-hdl
      906         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      907     RUN use-create-on-add(?).
      908   PROCEDURE adm-add-record :
      909       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      910          "must have at least one Enabled Table to perform Add.":U
      911          VIEW-AS ALERT-BOX ERROR.
      912       RETURN.
      913   END PROCEDURE.
      914   PROCEDURE adm-assign-record :
      915    MESSAGE
      916          "Object ":U THIS-PROCEDURE:FILE-NAME
      917            "must have at least one Enabled Table to perform Assign.":U
      918              VIEW-AS ALERT-BOX ERROR.
      919      RETURN.
      920     END PROCEDURE.
      921   PROCEDURE adm-assign-statement :
      922     RETURN.
      923   END PROCEDURE.
      924   PROCEDURE adm-cancel-record :
      925      RETURN.
      926     END PROCEDURE.
      927   PROCEDURE adm-copy-record :
      928       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      929        "must have at least one Enabled Table to perform Copy.":U
      930          VIEW-AS ALERT-BOX ERROR.
      931       RETURN.
      932   END PROCEDURE.
      933   PROCEDURE adm-create-record :
      934      RETURN.
      935   END PROCEDURE.
      936   PROCEDURE adm-current-changed :
      937     RETURN.
      938   END PROCEDURE.
      939   PROCEDURE adm-delete-record :
      940    MESSAGE
      941          "Object ":U THIS-PROCEDURE:FILE-NAME
      942            "must have at least one Enabled Table to perform Delete.":U
      943              VIEW-AS ALERT-BOX ERROR.
      944       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      945       RETURN.
      946   END PROCEDURE.
      947   PROCEDURE adm-disable-fields :
      948         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
