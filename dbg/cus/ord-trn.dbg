      902             tt-doc-line.price-cli      = v-price-cli
      903             tt-doc-line.price-rubl     = v-price-rubl
      904             tt-doc-line.artic          = ttt_ord-line-rcv.artic
      905             tt-doc-line.prod-code      = ttt_ord-line-rcv.prod-code
      906             tt-doc-line.prod-type      = ttt_ord-line-rcv.prod-type
      907             tt-doc-line.prt-root       = t_goods.prt-root
      908             tt-doc-line.road-tax       = ttt_ord-line-rcv.road-tax
      909             tt-doc-line.transport-base = ttt_ord-line-rcv.transport-base
      910             tt-doc-line.transport-rubl = ttt_ord-line-rcv.transport-rubl
      911             tt-doc-line.unit-cli       = ttt_ord-line-rcv.unit-cli
      912             tt-doc-line.doc-density     = 1 / tt-doc-line.cli-base-rate
      913             tt-doc-line.fact-density    = 1 / tt-doc-line.cli-base-rate
      914             .
      915             create  tt2-doc-line .
      916             BUFFER-COPY tt-doc-line to tt2-doc-line.
      917   p-q = 0 .
      918   kkk = 0 .
      919        kkk = 0 .
      920        for each   ttt_ord-dtl-rcv where
      921                   ttt_ord-doc-rcv.rcv-code   = ttt_ord-dtl-rcv.rcv-code   and
      922                   ttt_ord-doc-rcv.doc-code   = ttt_ord-dtl-rcv.doc-code   and
      923                   ttt_ord-line-rcv.artic     = ttt_ord-dtl-rcv.artic      and
      924                   ttt_ord-line-rcv.prod-code = ttt_ord-dtl-rcv.prod-code  and
      925                   ttt_ord-line-rcv.prod-type = ttt_ord-dtl-rcv.prod-type  :
      926         kkk = kkk + 1 .
      927         create tt-gds-dtl .
      928         buffer-copy  tt-doc-line to  tt-gds-dtl.
      929         assign
      930           tt-gds-dtl.fact-qnty =  ttt_ord-dtl-rcv.qnty
      931           tt-gds-dtl.doc-qnty  =  ttt_ord-dtl-rcv.qnty
      932           tt-gds-dtl.prt-code  =  ttt_ord-dtl-rcv.node-code
      933           p-q = ttt_ord-dtl-rcv.qnty
      934         .
      935        end.
      936        if kkk = 0 then do:
      937             create tt-gds-dtl.
      938             buffer-copy  tt-doc-line  to  tt-gds-dtl.
      939             assign
      940               tt-gds-dtl.prt-code  =  tt-doc-line.prt-root
      941               p-q = tt-doc-line.doc-qnty
      942             .
      943         end.
      944         if p-q <> tt-doc-line.doc-qnty then
      945            message "В поставке :"  ttt_ord-doc-rcv.rcv-code skip
      946                    "по товару :"
      947                    tt-doc-line.artic
      948                    tt-doc-line.prod-type
      949                    tt-doc-line.prod-code
      950                   "По признакам разнесено только :"  p-q skip
      951                   "Надо разнести еще :" ( tt-doc-line.doc-qnty  -  p-q ) skip
      952                   "Исправьте данные по признакам в накладной " view-as alert-box .
      953   end.
      954   for each tt2-doc-line :
