       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: ord-trn.p $ $Revision: e470dcf1e011, 295, rls $".
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define new global shared variable g#lib-trn  as handle no-undo .
       82   define new global shared variable g#lib-trn2 as handle no-undo .
       83   define new global shared variable g#lib-trn3 as handle no-undo .
       84   define new global shared variable g#lib-trn4 as handle no-undo .
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
       87   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
       88     field cst-code                like ub.trn-doc.cst-code
       89     field part-code               like ub.parts.part-code
       90     .
       91   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
       92   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
       93   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
       94   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   define variable to-day       as date no-undo .
       96   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   procedure doc-code:
       98   define input  parameter parmode          as   character           no-undo.
       99   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      100   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      101   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      102   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      103   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      104   define variable vardb-remote     as   logical             no-undo.
      105   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      106   define variable v-delimiter as character no-undo .
      107   do
      108   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      109   :
      110   find first buf_sys-ctrl no-lock .
      111   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      112     CASE parmode:
      113       when "main":u then do:
      114         if vardb-remote then do:
      115           assign
      116             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      117         end.
      118         else do:
      119           assign
      120             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      121         end.
      122       end.
      123       when "trio" then do:
      124         assign
      125           pardoc-code = replace (parroot-doc-code, "=", "*").
      126       end.
      127       otherwise do:
      128         assign
      129         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      130         no-error
      131         .
      132         if error-status:error  then do:
      133           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      134                                         ,chr(10)
      135                                         ,parmode
      136                                         ).
      137         end.
      138         if num-entries(parmode) = 1
      139         and parmode <> "chip":U
      140         and parmode <> "chip_s":U
      141         then do:
      142           assign
      143           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      144         end.
      145         else if (lookup("chip":U, parmode) > 0
      146                  or
      147                  lookup("chip_s":U, parmode) > 0) then do:
      148           assign
      149             vartemp-doc-code = parroot-doc-code.
      150           do while true:
      151             if index (vartemp-doc-code , ".") = 0 then
      152               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      153             else
      154               vartemp-doc-code  =
      155               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      156               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      157               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      158             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      159           end.
      160           assign
      161             pardoc-code = vartemp-doc-code.
      162         end.
      163       end.
      164     end CASE.
      165     if pardoc-code = '':U
      166     or (parroot-doc-code <> '':U
      167     and pardoc-code = parroot-doc-code) then do:
      168       undo, return error substitute("Ошибка при генерации номера документа&1"
      169                                     ,chr(10)).
      170     end.
      171   end.
      172   end. // procedure/method
      173   function get-doc-code-int64 returns int64
      174     ( input p-doc-code as character ) :
      175     define variable v-ind              as integer   no-undo .
      176     define variable v-num-entries      as integer   no-undo .
      177     define variable v-doc-code-int64   as int64     no-undo .
      178     define variable v-canonic-doc-code as character no-undo .
      179     assign
      180       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      181       v-canonic-doc-code = p-doc-code
      182     .
      183     do v-ind = 1 to v-num-entries
      184     :
      185       assign
      186         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      187       .
      188     end.
      189     assign
      190       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      191     .
      192     return v-doc-code-int64 .
      193   end. // function/method
      194   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   define variable v-waitfram-action01         as character   no-undo .
      196   define variable v-waitfram-action02         as character   no-undo .
      197   define variable v-waitfram-action03         as character   no-undo .
      198   define variable mWaitFramTextBeg            as character   no-undo.
      199   define variable mWaitFramTextEnd            as character   no-undo.
      200   define variable mWaitFramView               as logical     no-undo.
      201   define variable mWaitProcEvent              as logical     no-undo init yes.
      202   define variable mWaitFramInterval           as integer     no-undo init 1 .
      203   define variable mWaitFramStop               as logical     no-undo.
      204   define variable mWaitFramStopUser           as logical     no-undo.
      205   define variable mWaitFramStopTimeOut        as logical     no-undo.
      206   define variable mWaitFramStartProc          as datetime-tz no-undo.
      207   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      208   define button B-WaitFramStop auto-end-key
      209        label "Стоп"
      210        size 10 by 1 tooltip "Остоновить процесс".
      211   define button B-viewProcInfo
      212        label "Информация"
      213        size 15 by 1 tooltip "Информация о процесс".
      214   define frame waitfram
      215     v-waitfram-action01 format "x(72)" no-label skip
      216     v-waitfram-action02 format "x(72)" no-label skip
      217     v-waitfram-action03 format "x(72)" no-label skip
      218     B-viewProcInfo
      219     B-WaitFramStop at row 4 col 30
      220     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      221     .
      222   define new global shared variable mBatchMode as logical no-undo init ?.
      223   define variable mFramBachModHandle as handle no-undo.
      224   mFramBachModHandle = frame waitfram:handle.
      225   define variable mFameOldVis as logical no-undo.
      226   define variable mVisCUrentVin as logical no-undo.
      227   if session:batch-mode
      228   then
      229      mBatchMode = yes.
      230   if mBatchMode = ? then do:
      231     mVisCUrentVin = current-window:visible.
      232     mFameOldVis = mFramBachModHandle:visible.
      233     mFramBachModHandle:visible  = yes.
      234     mBatchMode = mFramBachModHandle:visible ne yes.
      235     mFramBachModHandle:visible = mFameOldVis.
      236     current-window:visible = mVisCUrentVin.
      237   end.
      238    if  log-manager:logfile-name ne ?
      239     then DO:
      240         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      241         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      242         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      243     end.
      244   on choose of B-WaitFramStop in frame waitfram
      245   do:
      246     mWaitFramStop = yes.
      247     mWaitFramStopUser = yes.
      248   end.
      249   function waitfram-check-timeout returns logical():
      250      define variable vtime as int64 no-undo.
      251      if mWaitFramStopTimeOut
      252      then
      253         return yes.
      254      vtime = ( now - mWaitFramStartProc ) / 1000 .
      255      if     mWaitFramTimeOut ne ?
      256         and mWaitFramTimeOut ne 0
      257         and mWaitFramTimeOut lt vtime
      258      then do:
      259         mWaitFramStopTimeOut = yes.
      260      end.
      261      return mWaitFramStopTimeOut.
      262   end.
      263   procedure waitfram-hide :
      264     if not session:batch-mode
      265     then do
      266     on error undo, return error return-value
      267     :
      268       pause 0 before-hide .
      269       if not mBatchMode then
      270         hide frame waitfram .
      271     if     not mWaitFramView
      272        and mWaitProcEvent
      273     then
      274       process events .
      275     end.
      276   end procedure.
      277   procedure waitfram-show :
      278     define input  parameter p-message as character no-undo .
      279     define variable v-left-margin as integer   no-undo .
      280     if not session:batch-mode
      281     then do
      282     on error undo, return error return-value
      283     :
      284       if length(p-message) <= 70 then do:
      285         assign
      286           v-left-margin = integer((70 - length(p-message)) / 2)
      287         .
      288         assign
      289           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      290         .
      291         assign
      292           v-waitfram-action01 = " "
      293           v-waitfram-action02 = " "
      294                                    + fill(" ", v-left-margin)
      295                                    + p-message
      296           v-waitfram-action03 = " "
      297         .
      298       end.
      299       else do:
      300         define variable vRindex1 as integer no-undo.
      301         define variable vRindex2 as integer no-undo.
      302         vRindex1 = r-index(p-message," ",70).
      303         if vRindex1 = 0
      304         then
      305            vRindex1 = 70.
      306         if length(p-message)  <= vRindex1 + 70 then do:
      307           assign
      308             v-waitfram-action01 = " "
      309             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      310             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      311           .
      312         end.
      313         else do:
      314           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      315           if vRindex2 <= vRindex1
      316           then
      317              vRindex2 = vRindex1 + 70.
      318           assign
      319             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      320             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      321             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      322           .
      323         end.
      324       end.
      325       B-viewProcInfo:visible   in frame waitfram = no.
      326       B-viewProcInfo:sensitive in frame waitfram = no.
      327       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      328       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      329       if  (   mWaitFramView
      330          or  mWaitProcEvent)
      331          and not mBatchMode
      332       then
      333          display
      334             v-waitfram-action01 skip
      335             v-waitfram-action02 skip
      336             v-waitfram-action03 skip
      337          with frame waitfram .
      338       if     mWaitFramView
      339          then do:
      340             if     mWaitFramInterval ne ?
      341                and not mBatchMode
      342             then
      343                wait-for go of frame waitfram pause mWaitFramInterval.
      344          end.
      345          else
      346             if     mWaitProcEvent
      347                and not mBatchMode
      348             then
      349                process events .
      350     end.
      351   end procedure.
      352      procedure waitfram-show-this:
      353         define input  parameter iInterval as int64 no-undo.
      354         define variable vtime as int64 no-undo.
      355         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      356         mWaitFramInterval = iInterval.
      357         run waitfram-show (substitute("&1&2 &3&4" ,
      358                                       mWaitFramTextBeg ,
      359                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      360                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      361                                       mWaitFramTextEnd
      362                                      )
      363                           ).
      364      end.
      365      procedure WaitFramRunPause:
      366         define input  parameter iInterval as dec no-undo.
      367         define variable vStart  as datetime-tz no-undo.
      368         define variable vend    as datetime-tz no-undo.
      369         define variable vint as int64 no-undo.
      370         define variable vOk as logical no-undo.
      371         vStart = now.
      372         vend   = vStart.
      373         publish "WaitFramPause" (iInterval,output vOk).
      374         vend   =  now.
      375         vint = vend - vStart.
      376         vint = iInterval - vint / 1000.
      377         if     not mWaitFramStop
      378            and (   vint > 0
      379                 or (    not vOk
      380                     and iInterval eq ?
      381                     )
      382                 )
      383         then
      384            run waitfram-show-this (iInterval).
      385         vend   =  now.
      386         vint = vend - vStart.
      387         vint = iInterval - vint / 1000.
      388         if     not mWaitFramStop
      389            and vint > 0
      390         then do:
      391            run gbl/pause.p (vint * 1000).
      392         end.
      393         if iInterval ne ?
      394         then
      395            publish "WaitFramStop".
      396         waitfram-check-timeout().
      397      end.
      398      procedure WaitFramWaitFor:
      399         define input  parameter iInterval as dec no-undo.
      400         assign
      401            mWaitFramStartProc   = now
      402            mWaitFramStopUser    = no
      403            mWaitFramStopTimeOut = no
      404         .
      405         block-wait:
      406         do while not mWaitFramStop:
      407            run WaitFramRunPause (iInterval).
      408            if  waitfram-check-timeout()
      409            then do:
      410               leave block-wait.
      411            end.
      412         end.
      413         run waitfram-hide.
      414      end.
      415   procedure waitfram-join :
      416     define input  parameter p-line-1  as character no-undo .
      417     define input  parameter p-line-2  as character no-undo .
      418     define input  parameter p-line-3  as character no-undo .
      419     define output parameter p-message as character no-undo .
      420     do
      421     on error undo, return error return-value
      422     :
      423       assign
      424         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      425                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      426                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      427       .
      428     end.
      429   end procedure.
      430   function waitfram-join-function returns character
      431     (input p-line-1 as character
      432     ,input p-line-2 as character
      433     ,input p-line-3 as character
      434     ).
      435     define variable v-message as character no-undo .
      436     run waitfram-join in this-procedure
      437       (input  p-line-1
      438       ,input  p-line-2
      439       ,input  p-line-3
      440       ,output v-message
      441       ) .
      442     return v-message .
      443   end function .
      444   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      445   procedure create-chain :
      446   define input  parameter p-doc-code as character no-undo .
      447   define input  parameter p-doc-type as character no-undo .
      448   define input  parameter p-rel-doc-code as character no-undo .
      449   define input  parameter p-rel-doc-type as character no-undo .
      450   define input  parameter p-type as character no-undo .
      451   define input  parameter p-ps as character no-undo .
      452   define variable v-db-num as integer   no-undo .
      453     do
      454     on error undo, return error return-value
      455     :
      456     find first ub.sys-ctrl no-lock .
      457     v-db-num = ub.sys-ctrl.db-num .
      458     find first ub.ord-chain no-lock where
      459       ub.ord-chain.doc-code     = p-doc-code     and
      460       ub.ord-chain.doc-type     = p-doc-type     and
      461       ub.ord-chain.rel-type     = p-type         and
      462       ub.ord-chain.rel-doc-code = p-rel-doc-code and
      463       ub.ord-chain.rel-doc-type = p-rel-doc-type   no-error .
      464     if available ub.ord-chain then return .
      465     create ub.ord-chain.
      466     assign
      467       ub.ord-chain.doc-code     = p-doc-code
      468       ub.ord-chain.doc-type     = p-doc-type
      469       ub.ord-chain.ps           = p-ps
      470       ub.ord-chain.rel-doc-code = p-rel-doc-code
      471       ub.ord-chain.rel-doc-type = p-rel-doc-type
      472       ub.ord-chain.rel-id       = next-value( s-ord-ch, ub )
      473       ub.ord-chain.db-num       = v-db-num
      474       ub.ord-chain.rel-type     = p-type
      475       .
      476     end.
      477   end procedure.
      478   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   define new global shared variable g#trdcalib as handle no-undo.
      480   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
      481   define temp-table tt-doc-line no-undo like ub.doc-line.
      482   define temp-table tt2-doc-line      no-undo like lib-trn_ret-line.
      483   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
      484   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
      485   define temp-table tt-parts    no-undo like ub.parts.
      486   define buffer ttt_ord-doc-rcv  for ub.ord-doc-rcv.
      487   define buffer ttt_ord-line-rcv for ub.ord-line-rcv.
