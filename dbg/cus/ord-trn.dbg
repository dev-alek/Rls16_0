      827   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
      829     (input  v-event-code
      830     ,input  t_goods.gds-code
      831     ,input  tt-trn-doc.obj-type
      832     ,input  tt-trn-doc.obj-code
      833     ,input  false
      834     ,output v-Ok
      835     ,output v-mess
      836     ) no-error.
      837          if v-Ok = false then do:
      838             v-ps = v-ps + v-mess.
      839             next.
      840          end.
      841       if  ttt_ord-line-rcv.price-rubl  = 0 or ttt_ord-line-rcv.price-rubl  = ? then do:
      842           assign
      843            v-price-base  =  ub.gds-obj.last-base
      844            v-price-rubl  =  ub.gds-obj.last-rubl
      845           .
      846       end.
      847       else do:
      848           assign
      849            v-price-base  =   ttt_ord-line-rcv.price-base
      850            v-price-cli   =   ttt_ord-line-rcv.price-cli
      851            v-price-rubl  =   ttt_ord-line-rcv.price-rubl
      852           .
      853       end.
      854       assign
      855         v-cli-qnty  = 0
      856         v-doc-qnty  = 0
      857         v-fact-qnty = 0
      858       .
      859       if  p-allow-chain-trn-qnty then do:
      860          for each bf_ord-chain
      861             where bf_ord-chain.doc-code = ttt_ord-doc-rcv.rcv-code
      862               and bf_ord-chain.doc-type = "rcv":U
      863               no-lock :
      864               find first bf_trn-doc
      865                    where bf_trn-doc.doc-code = bf_ord-chain.rel-doc-code
      866               no-error.
      867               if available bf_trn-doc then do:
      868                 find first bf_doc-line
      869                      where bf_doc-line.artic     = ttt_ord-line-rcv.artic
      870                        and bf_doc-line.prod-code = ttt_ord-line-rcv.prod-code
      871                        and bf_doc-line.prod-type = ttt_ord-line-rcv.prod-type
      872                        and bf_doc-line.doc-code  = bf_trn-doc.doc-code
      873                        no-error.
      874                 if available bf_doc-line then do:
      875                    assign
      876                      v-cli-qnty    = v-cli-qnty   + bf_doc-line.cli-qnty
      877                      v-doc-qnty    = v-doc-qnty   + bf_doc-line.doc-qnty
      878                      v-fact-qnty   = v-fact-qnty  + bf_doc-line.fact-qnty
      879                    .
      880                 end.
      881               end.
      882          end.
      883       end.
      884         create  tt-doc-line  .
      885           assign
      886             tt-doc-line.doc-code       = n-d
      887             tt-doc-line.status_        = "temp"
      888             tt-doc-line.obj-code       = tt-trn-doc.obj-code
      889             tt-doc-line.obj-type       = tt-trn-doc.obj-type
      890             tt-doc-line.slt-pc         = ttt_ord-line-rcv.slt-pc
      891             tt-doc-line.vat-pc         = ttt_ord-line-rcv.vat-pc
      892             tt-doc-line.cli-base-rate  = ttt_ord-line-rcv.cli-base-rate
      893             tt-doc-line.cli-qnty       = if v-cli-qnty  >= ttt_ord-line-rcv.cli-qnty  then 0 else ( ttt_ord-line-rcv.cli-qnty - v-cli-qnty )
      894             tt-doc-line.doc-qnty       = if v-doc-qnty  >= ttt_ord-line-rcv.qnty      then 0 else ( ttt_ord-line-rcv.qnty     - v-doc-qnty )
      895             tt-doc-line.fact-qnty      = if v-fact-qnty >= ttt_ord-line-rcv.qnty      then 0 else ( ttt_ord-line-rcv.qnty     - v-fact-qnty )
      896             tt-doc-line.excise         = ttt_ord-line-rcv.excise
      897             tt-doc-line.ext-doc-type   = v-ext-doc-type
      898             tt-doc-line.line-num       = next-value (s-line-num, ub)
      899             tt-doc-line.other-base     = ttt_ord-line-rcv.other-base
      900             tt-doc-line.other-rubl     = ttt_ord-line-rcv.other-rubl
