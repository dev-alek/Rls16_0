      964           tt-parts.price-rubl     = tt2-doc-line.price-cli
      965           tt-parts.qnty           = tt2-doc-line.doc-qnty
      966           tt-parts.obj-type       = new_trn-doc.obj-type
      967           tt-parts.obj-code       = new_trn-doc.obj-code
      968           tt-parts.fact-date      = new_trn-doc.fact-date
      969           tt-parts.fact-num       = new_trn-doc.fact-num
      970           tt-parts.VAT-pc         = tt2-doc-line.vat-pc
      971           tt-parts.part-code      = ""
      972           tt-parts.PS             = "Партия создана по заказу"
      973           tt-parts.pay-code       = new_trn-doc.pay-code
      974           tt-parts.status_        = no
