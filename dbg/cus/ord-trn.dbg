        1   block-level on error undo, throw.
        2   define input  parameter parParentProc   as widget-handle no-undo.
        3   define input  parameter tp-rec as recid no-undo .
        4   define input  parameter p-allow-chain-trn-qnty as logical no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: e470dcf1e011, 295, rls $":U .
