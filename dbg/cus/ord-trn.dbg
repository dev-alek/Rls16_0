      976           tt-parts.supp-type      = new_trn-doc.cli-type
      977           tt-parts.supp-code      = new_trn-doc.cli-code
      978           tt-parts.rsrv-free      = ?
      979           tt-parts.doc-type       = new_trn-doc.doc-type
      980           tt-parts.cli-qnty       = tt2-doc-line.cli-qnty
      981           tt-parts.pl-code        = 0
      982           tt-parts.VAT-type       = new_trn-doc.vat-type
      983           tt-parts.exch-code      = 0
      984           tt-parts.price-cli      = tt2-doc-line.price-cli
