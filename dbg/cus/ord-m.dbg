     1400   procedure userobjs_clear :
     1401     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1402     do
     1403     on error undo, return error return-value
     1404     :
     1405       for each buf_userobjs_temp-user-obj
     1406       on error undo, return error return-value
     1407       :
     1408         delete buf_userobjs_temp-user-obj .
     1409       end.
     1410     end.
     1411   end .
     1412   procedure userobjs_object-count :
     1413     define output parameter p-total-count as integer   no-undo .
     1414     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1415     do
     1416     on error undo, return error return-value
     1417     :
     1418       assign
     1419         p-total-count = 0
     1420       .
     1421       for each buf_userobjs_temp-user-obj
     1422       on error undo, return error return-value
     1423       :
     1424         assign
     1425           p-total-count = p-total-count + 1
     1426         .
     1427       end.
     1428     end.
     1429   end.
     1430   procedure userobjs_append :
     1431      define input  parameter p-obj-type as character no-undo .
     1432      define input  parameter p-obj-code as integer   no-undo .
     1433     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1434     do
     1435     on error undo, return error return-value
     1436     :
     1437       find first buf_userobjs_temp-user-obj
     1438         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1439           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1440         no-error .
     1441       if not available buf_userobjs_temp-user-obj
     1442       then do:
     1443         create buf_userobjs_temp-user-obj .
     1444         assign
     1445           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1446           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1447         .
     1448       end.
     1449     end.
     1450   end.
     1451   procedure userobjs_object-exist :
     1452     define output parameter p-object-exist as logical   no-undo .
     1453     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1454     do
     1455     on error undo, return error return-value
     1456     :
     1457       find first buf_userobjs_temp-user-obj
     1458         no-error .
     1459       if not available buf_userobjs_temp-user-obj
     1460       then do:
     1461         assign
     1462           p-object-exist = false
     1463         .
     1464       end.
     1465       else do:
     1466         assign
     1467           p-object-exist = true
     1468         .
     1469       end.
     1470     end.
     1471   end.
     1472   procedure userobjs_transfer :
     1473     define input  parameter p-callback-handle as handle no-undo .
     1474     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1475     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1476     do
     1477     on error undo, return error return-value
     1478     :
     1479       if valid-handle(p-callback-handle) <> true
     1480       then do:
     1481         message
     1482           vss-workfile vss-revision vss-description skip
     1483           "Ошибка задания входных параметров" skip
     1484           "Неизвестный указатель на процедуру" skip
     1485           view-as alert-box error .
     1486         undo, return error return-value .
     1487       end.
     1488       if p-callback-handle :get-signature("userobjs_append") = ""
     1489       then do:
     1490         message
     1491           vss-workfile vss-revision vss-description skip
     1492           "Ошибка задания входных параметров" skip
     1493           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1494                     ,p-callback-handle :file-name
     1495                     ) skip
     1496           view-as alert-box error .
     1497         undo, return error return-value .
     1498       end.
     1499       for each buf_userobjs_temp-user-obj
     1500       on error undo, return error return-value
     1501       :
     1502         run userobjs_append in p-callback-handle
     1503           (input  buf_userobjs_temp-user-obj.obj-type
     1504           ,input  buf_userobjs_temp-user-obj.obj-code
     1505           ) .
     1506       end.
     1507     end.
     1508   end procedure.
