     5629           browse-1:bgcolor  in frame Dialog-Frame  = 8 .
     5630           g#log = R-min-rest:enable( 'На фирме' ) .
     5631               OPEN QUERY BROWSE-abc-day FOR EACH temp-abc-day .
     5632     end.
     5633      otherwise do:
     5634         message "Нет!!! " .
     5635      end.
     5636     end case.
     5637     if date-sale-1 = ? and date-sale-2 = ? then do:
     5638         t-way = false .
     5639         hide t-way FILL-IN-8 T-clos T-rcv r-min-rest3 in frame Dialog-Frame .
     5640     end.
     5641     if r-algoritm <>  2 and
     5642        r-algoritm <>  5 and
     5643        r-algoritm <>  6
     5644        then do:
     5645        run v-c-2 in this-procedure .
     5646        end.
     5647    end.
     5648   END PROCEDURE.
     5649   PROCEDURE v-c-way :
     5650     assign frame   Dialog-Frame   t-way.
     5651     if  t-way then do:
     5652         if loc-doc-type = 'ОО':U then do:
     5653            T-rcv:label = 'запрос':U      .
     5654            hide T-clos  in frame Dialog-Frame .
     5655         end.
     5656         display T-clos when loc-doc-type <> 'ОО':U
     5657                 T-rcv
     5658                 FILL-IN-8  with frame Dialog-Frame .
     5659         enable T-clos  when loc-doc-type <> 'ОО':U
     5660                T-rcv
     5661                FILL-IN-8 with frame Dialog-Frame .
     5662         end.
     5663     else do:
     5664           disable T-clos T-rcv FILL-IN-8 with frame Dialog-Frame .
     5665           hide T-clos T-rcv FILL-IN-8 in frame Dialog-Frame .
     5666           end.
     5667   END PROCEDURE.
     5668   PROCEDURE verify-check :
     5669   END PROCEDURE.
