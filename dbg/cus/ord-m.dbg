      759   def
      760    shared
      761   temp-table  obj-list no-undo
      762     field obj-type like ub.clients.obj-type
      763     field obj-code like ub.clients.obj-code
      764     field obj-name like ub.clients.obj-name
      765     field obj-id   as integer
