     1200   function diff-list returns character (
     1201     input parfirst-list  as character,
     1202     input parsecond-list as character,
     1203     input pardelim       as character).
     1204     if pardelim = ""
     1205     or pardelim = ?
     1206     then do:
     1207       assign
     1208         pardelim = ","
     1209       .
     1210     end.
     1211     def var ind as integer no-undo .
     1212     def var v-elem as character no-undo .
     1213     def var v-result-list as character no-undo init "".
     1214     def var v-num-parfirst-list as integer no-undo .
     1215     assign
     1216       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1217     .
     1218     do ind = 1 to v-num-parfirst-list
     1219     :
     1220       assign
     1221         v-elem = entry(ind, parfirst-list, pardelim)
     1222       .
     1223       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1224         assign
     1225           v-result-list = v-result-list
     1226                         + (if v-result-list > "" then pardelim else "")
     1227                         + v-elem
     1228         .
     1229       end.
     1230     end.
     1231     return v-result-list .
     1232   end function.
     1233   function add-list returns character (
     1234    input parfirst-list  as character,
     1235    input parsecond-list as character,
     1236    input pardelim       as character).
     1237     if pardelim = ""
     1238     or pardelim = ?
     1239     then do:
     1240       assign
     1241         pardelim = ","
     1242       .
     1243     end.
     1244     def var ind as integer no-undo .
     1245     def var v-elem as character no-undo .
     1246     def var v-result-list as character no-undo init "".
     1247     def var v-num-parfirst-list as integer no-undo .
     1248     assign
     1249       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1250     .
     1251     do ind = 1 to v-num-parfirst-list
     1252     :
     1253       assign
     1254         v-elem = entry(ind, parfirst-list, pardelim)
     1255       .
     1256       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1257         assign
     1258           v-result-list = v-result-list
     1259                         + (if v-result-list > "" then pardelim else "")
     1260                         + v-elem
     1261         .
     1262       end.
     1263     end.
     1264     def var v-num-parsecond-list as integer no-undo .
     1265     assign
     1266       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1267     .
     1268     do ind = 1 to v-num-parsecond-list
     1269     :
     1270       assign
     1271         v-elem = entry(ind, parsecond-list, pardelim)
     1272       .
     1273       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1274         assign
     1275           v-result-list = v-result-list
     1276                         + (if v-result-list > "" then pardelim else "")
     1277                         + v-elem
     1278         .
     1279       end.
     1280     end.
     1281     return v-result-list .
     1282   end function.
     1283   function cross-list returns character (
     1284    input parfirst-list  as character,
     1285    input parsecond-list as character,
     1286    input pardelim       as character).
     1287     if pardelim = ""
     1288     or pardelim = ?
     1289     then do:
     1290       assign
     1291         pardelim = ","
     1292       .
     1293     end.
     1294     def var ind as integer no-undo .
     1295     def var v-elem as character no-undo .
     1296     def var v-result-list as character no-undo init "".
     1297     def var v-num-parfirst-list as integer no-undo .
     1298     assign
     1299       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1300     .
     1301     do ind = 1 to v-num-parfirst-list
     1302     :
     1303       assign
     1304         v-elem = entry(ind, parfirst-list, pardelim)
     1305       .
     1306       if lookup(v-elem, v-result-list, pardelim) = 0
     1307       and lookup(v-elem, parsecond-list, pardelim) > 0
     1308       then do:
     1309         assign
     1310           v-result-list = v-result-list
     1311                         + (if v-result-list > "" then pardelim else "")
     1312                         + v-elem
     1313         .
     1314       end.
     1315     end.
     1316     return v-result-list .
     1317   end function.
     1318   function radio-label returns character (
     1319    input par-rs-value  as character,
     1320    input par-rs-radio-buttons as character)
     1321    .
     1322    DEFINE variable v-result-label as character no-undo.
     1323    assign
     1324    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1325                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1326                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1327                             ), par-rs-radio-buttons
     1328                           )
     1329    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1330    .
     1331   return v-result-label.
     1332   end function.
     1333   function m-radio-label returns character (
     1334    input par-rs-value  as character,
     1335    input par-rs-radio-buttons as character,
     1336    input par-delim as character
     1337    )
     1338    .
     1339    DEFINE variable v-result-label as character no-undo.
     1340    assign
     1341    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1342                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1343                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1344                             ), par-rs-radio-buttons, par-delim
     1345                           )
     1346    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1347    .
     1348   return v-result-label.
     1349   end function.
     1350   FUNCTION mixlist returns character
     1351   (
     1352    input parfirst-list  as character
     1353    ,input parsecond-list as character
     1354    ,input pardelim       as character
     1355    ,input pardelim-result as character ) :
     1356     if pardelim = ""
     1357     or pardelim = ?
     1358     then do:
     1359       assign
     1360         pardelim = ","
     1361       .
     1362     end.
     1363     def var ind as integer no-undo .
     1364     def var v-elem1 as character no-undo .
     1365     def var v-elem2 as character no-undo .
     1366     def var v-result-list as character no-undo init "".
     1367     do ind = 1 to num-entries(parfirst-list, pardelim)
     1368     :
     1369       assign
     1370         v-elem1 = entry(ind, parfirst-list, pardelim)
     1371         v-elem2 = entry(ind, parsecond-list, pardelim)
     1372       .
     1373         assign
     1374           v-result-list = v-result-list
     1375                         + (if v-result-list > "" then pardelim-result else "")
     1376                         + v-elem1 + pardelim-result + v-elem2
     1377         .
     1378     end.
     1379     return v-result-list .
     1380   END FUNCTION.
