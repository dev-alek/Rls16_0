     4419   do:
     4420     define variable v-curr-sv-date as date no-undo .
     4421     if (can-query (self, "sensitive")
     4422        and
     4423        self :sensitive = true
     4424        )
     4425     or (can-query (self, "read-only")
     4426        and
     4427        self :read-only = false
     4428        )
     4429     then do:
     4430       if self :handle <> focus :handle
     4431       then do:
     4432         apply "entry":u to self .
     4433       end.
     4434       run gbl/getcurdt.p
     4435         (output v-curr-sv-date
     4436         ) .
     4437       assign
     4438         self :screen-value = string(v-curr-sv-date) .
     4439       .
     4440     end.
     4441     return no-apply.
     4442   end.
