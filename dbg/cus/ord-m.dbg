     5009        ENABLE  BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code  WITH FRAME Dialog-Frame.
     5010        end.
     5011     ENABLE RECT-1 RECT-3 RECT-5 RECT-6 RECT-7 RECT-8  R-algoritm R-min-rest p-neg-sale T-gar r-min-rest3 T-min-ost T-min-zapas R-algoritm2 SelectObject BR-obj-list T-DeadLine BUTTON-obj date-p-1 date-p-2 t-way BROWSE-1 B-10 B-1 B-2 T-clos B-3 T-rcv t-rv t-rvc B-4 t-rvz T-rvzc B-5 T-sppv-4 T-sp T-sppv-2 t-sppv-3 B-6 B-7 v-round-m p-prt-art Btn_OK Btn_Cancel B-Help i-exit FILL-IN-2 FILL-IN-17 FILL-IN-3 t-gar-1 t-gar-2 t-min-ost-1 t-min-ost-2 FILL-IN-5 FILL-IN-15 FILL-IN-13 FILL-IN-7 t-1 FILL-IN-8 FILL-IN-14 t-2 t-3 t-4 t-5 t-6 t-7 FILL-IN-16
     5012            WITH FRAME Dialog-Frame.
     5013   .
     5014     VIEW FRAME Dialog-Frame.
     5015     OPEN QUERY br-obj-list  FOR EACH obj-list .    OPEN QUERY browse-1 FOR EACH tt-date .    OPEN QUERY BROWSE-abc-day FOR EACH temp-abc-day .
     5016   END PROCEDURE.
     5017   PROCEDURE loc-init :
     5018   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5019   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5020   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     5021     (input  store-type
     5022     ,input  store-code
     5023     ,output to-day
     5024     )  .
     5025   define variable i as integer no-undo .
     5026   if v-mode = ? then  do:
     5027   find first buf_usr-flt  no-lock where
     5028            buf_usr-flt.user-name = loc-ord-num and
     5029            buf_usr-flt.call-point   = "ord-m":U    no-error .
     5030   end.
     5031   else do:
     5032      if v-mode = "all-ord":U then do:
     5033           find first buf_usr-flt  no-lock where
     5034                   buf_usr-flt.user-name   = g#userid and
     5035                   buf_usr-flt.call-point  = "all-ord":U    no-error .
     5036      end.
     5037      else do:
     5038             find first buf_usr-flt  no-lock where
     5039                   buf_usr-flt.user-name = loc-ord-num and
     5040                   buf_usr-flt.call-point   = "ord-m":U  + v-mode   no-error .
     5041                   if not available buf_usr-flt  then do:
     5042                     find first buf_usr-flt  no-lock where
     5043                             buf_usr-flt.user-name = loc-ord-num and
     5044                             buf_usr-flt.call-point   = "ord-m":U  no-error .
     5045                   end.
     5046      end.
     5047   end.
     5048   if not available buf_usr-flt  then do:
     5049      find first buf_usr-flt  no-lock where
     5050            buf_usr-flt.user-name    = g#userid and
     5051            buf_usr-flt.call-point   = "ord-m":U    no-error .
     5052   end.
     5053   if available buf_usr-flt  then do:
     5054     run init-screen ( buf_usr-flt.list_ ) .
     5055   end.
     5056   else do:
     5057       assign
     5058           date-p-1  = to-day - 30
     5059           date-p-2  = to-day
     5060           t-rv   = true
     5061           t-rvz  = true
     5062           t-rvc  = true
     5063           t-rvzc = true
     5064           r-algoritm = 1
     5065       .
     5066     if v-round-m = "" or v-round-m = ? then v-round-m = 'Отключено':U .
     5067     display v-round-m with frame Dialog-Frame .
     5068       find first ub.tmp-sale no-lock no-error .
     5069       if error-status :error then do:
     5070             create  ub.tmp-sale.
     5071             assign  ub.tmp-sale.tmp-code = "1"
     5072                     ub.tmp-sale.desc_    = "Пустой"
     5073                     .
     5074       end.
     5075       find current ub.tmp-sale no-lock no-error .
     5076       if available ub.tmp-sale then
     5077           display  ub.tmp-sale.tmp-code
     5078                     ub.tmp-sale.desc_   with frame Dialog-Frame .
     5079       if available ub.tmp-sale then  rr = recid(ub.tmp-sale) .
     5080   end.
     5081    display R-algoritm R-min-rest p-neg-sale T-gar r-min-rest3 T-min-ost T-min-zapas R-algoritm2 SelectObject BR-obj-list T-DeadLine BUTTON-obj date-p-1 date-p-2 t-way BROWSE-1 B-10 B-1 B-2 T-clos B-3 T-rcv t-rv t-rvc B-4 t-rvz T-rvzc B-5 T-sppv-4 T-sp T-sppv-2 t-sppv-3 B-6 B-7 v-round-m p-prt-art Btn_OK Btn_Cancel B-Help i-exit FILL-IN-2 FILL-IN-17 FILL-IN-3 t-gar-1 t-gar-2 t-min-ost-1 t-min-ost-2 FILL-IN-5 FILL-IN-15 FILL-IN-13 FILL-IN-7 t-1 FILL-IN-8 FILL-IN-14 t-2 t-3 t-4 t-5 t-6 t-7 FILL-IN-16 with frame Dialog-Frame.
     5082     if g#type = 'ФП':U then do:
     5083           ENABLE
     5084             SelectObject
     5085             br-obj-list
     5086             BUTTON-obj
     5087             FILL-IN-13
     5088             rect-7
     5089             WITH FRAME Dialog-Frame.
     5090     end.
     5091     else do:
     5092         hide  SelectObject  br-obj-list  BUTTON-obj  FILL-IN-13 rect-7            in frame Dialog-Frame .
     5093         for each obj-list
     5094             on error undo, return error :
     5095             delete obj-list.
     5096         end.
     5097   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5098   run create_obj-list in this-procedure
     5099    ( input store-type ,
     5100      input store-code )
     5101      .
     5102     end.
     5103   define variable v-value  as character no-undo .
     5104   define variable v-i      as integer   no-undo .
     5105   define variable v-dec as integer   no-undo .
     5106   define variable p-prop-code as character no-undo .
     5107   define variable v-value-character like ub.thbj-attr.property-value-character no-undo .
     5108   define variable v-value-date    like ub.thbj-attr.property-value-date no-undo .
     5109   define variable v-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
     5110   define variable v-value-logical like ub.thbj-attr.property-value-logical no-undo .
     5111   define variable v-value-integer like ub.thbj-attr.property-value-integer no-undo .
     5112   define variable v-type     as character no-undo .
     5113   define variable v-found as decimal no-undo .
     5114    empty TEMP-TABLE  thbjattr_thbj-attr .
     5115    empty TEMP-TABLE temp-abc-day .
     5116    repeat v-i = 1 to 6:
     5117       run adm/shattri.p (
     5118         input "get":U
     5119         ,input store-type
     5120         ,input store-code
     5121         ,input 'abc-sale-day':U
     5122         ,input  chr ( 64 + v-i )
     5123         ,output v-value-character
     5124         ,output v-value-date
     5125         ,output v-value-decimal
     5126         ,output v-value-integer
     5127         ,output v-value-logical
     5128         ,output par-type
     5129         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     5130         ) no-error .
     5131           v-dec = v-value-integer no-error .
     5132           if v-dec = ? then v-dec = 0 .
     5133           create temp-abc-day.
     5134           assign
     5135             temp-abc-day.abc-type = chr ( 64 + v-i )
     5136             temp-abc-day.gar-day  = v-dec
     5137           .
     5138    end.
     5139    run v-c-alg in this-procedure .
     5140    run v-c-way in this-procedure .
     5141   END PROCEDURE.
     5142   PROCEDURE p-calc :
     5143   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     5144   define input-output parameter n-day as logical no-undo .
     5145   define input parameter n-i as integer no-undo .
     5146   define variable t-i as date no-undo.
     5147   define variable p-modulo as integer no-undo .
     5148   assign frame Dialog-Frame
     5149      date-p-1 date-p-2.
     5150     if date-p-1 = ? or  date-p-2 = ? then
     5151     apply "entry " to date-p-1 .
     5152   if date-p-1 <> ? and  date-p-2 <> ? then do:
     5153     if n-day = true then do:
     5154           n-day = false.
     5155            repeat t-i = date-p-1 To date-p-2 :
     5156               p-modulo = if (integer(t-i) MODULO 7 ) = 0 then 7 else (integer(t-i) MODULO 7 ).
     5157               if p-modulo = n-i then do:
     5158                    find first tt-date where  tt-date.exch-date =  t-i no-error.
     5159                       if available  tt-date then delete tt-date.
     5160               end.
     5161            end.
     5162     end.
     5163     else do:
     5164           n-day = true.
     5165            repeat t-i = date-p-1 To date-p-2 :
     5166              p-modulo = if (integer(t-i) MODULO 7 ) = 0 then 7 else (integer(t-i) MODULO 7 ).
     5167               if p-modulo = n-i
     5168               then do:
     5169                   if not can-find ( first tt-date where tt-date.exch-date =  t-i ) then do:
     5170                       create tt-date.
     5171                       assign tt-date.exch-date =  t-i.
     5172                       end.
     5173               end.
     5174            end.
     5175     end.
     5176      OPEN QUERY browse-1 FOR EACH tt-date .
     5177     end.
     5178    end.
     5179   END PROCEDURE.
     5180   PROCEDURE remember-screen :
     5181    do
     5182    on error undo, return error return-value
     5183    :
     5184   define input-output parameter p-val as character no-undo .
     5185            p-val =
     5186               string( "v-round-m=" )  + string( v-round-m ) + "," +
     5187               string( "v-round-base=" )  + string( v-round-base,">>>>>>>>>9.99" ) + "," +
     5188               string( "R-algoritm=" )  + string( R-algoritm ) + "," +
     5189               string( "R-algoritm2=" ) + string( R-algoritm2 ) + "," +
     5190               string( "tmp-sale.tmp-code=" ) + (
     5191               if available ub.tmp-sale and R-algoritm = 2
     5192                     then   string( ub.tmp-sale.tmp-code )
     5193                                 else ( " " ) )                          + "," +
     5194               string( "R-min-rest3=" ) + string( R-min-rest3,"yes/no" ) + "," +
     5195               string( "R-min-rest=" )  + string( R-min-rest ) + "," +
     5196               ( if date-p-1 = ?  then ""
     5197                                  else string( "date-p-1=" )    + string( date-p-1,"99/99/9999" )
     5198                                  )
     5199                                + "," +
     5200               ( if date-p-2 = ?  then ""
     5201                                  else string( "date-p-2=" )    + string( date-p-2,"99/99/9999" )
     5202                                  )
     5203                                + "," +
     5204               string( "t-way="    )    + string( t-way   ,"yes/no" ) + "," +
     5205               string( "t-rcv="    )    + string( t-rcv   ,"yes/no" ) + "," +
     5206               string( "t-clos="   )    + string( t-clos  ,"yes/no" ) + "," +
     5207               string( "t-rv="     )    + string( t-rv    ,"yes/no" ) + "," +
     5208               string( "t-rvz="    )    + string( t-rvz   ,"yes/no" ) + "," +
     5209               string( "t-rvc="    )    + string( t-rvc   ,"yes/no" ) + "," +
     5210               string( "t-rvzc="   )    + string( t-rvzc  ,"yes/no" ) + "," +
     5211               string( "t-sp="     )    + string( t-sp    ,"yes/no" ) + "," +
     5212               string( "t-sppv-2=" )    + string( t-sppv-2,"yes/no" ) + "," +
     5213               string( "t-sppv-3=" )    + string( t-sppv-3,"yes/no" ) + "," +
     5214               string( "t-sppv-4=" )    + string( t-sppv-4,"yes/no" ) + "," +
     5215               string( "p-neg-sale=" )  + string( p-neg-sale,"yes/no" ) + "," +
     5216               string( "t-gar=" )       + string( t-gar,"yes/no" ) + "," +
     5217               string( "t-min-zapas=" ) + string( t-min-zapas,"yes/no" ) + "," +
     5218               string( "t-min-ost=" ) + string( t-min-ost,"yes/no" ) + "," +
     5219               string( "t-deadline=" ) + string( t-deadline,"yes/no" ) + "," +
     5220               string( "SelectObject=" ) + string( SelectObject )
     5221               .
     5222     if g#type <> 'ФП':U then do:
     5223         for each  obj-list : delete obj-list . end.
     5224   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5225   run create_obj-list in this-procedure
     5226    ( input store-type ,
     5227      input store-code )
     5228      .
     5229     end.
     5230     p-val = p-val +  "," + "Объекты :&"  .
     5231         for each obj-list :
     5232                 p-val = p-val +  obj-list.obj-type + " " + string(obj-list.obj-code) + ","    .
     5233         end.
     5234     end.
     5235   END PROCEDURE.
     5236   PROCEDURE select-objects-proc :
     5237    do
     5238    on error undo, return error return-value
     5239    :
     5240     define input parameter p-e-m as character no-undo .
     5241     my-handle = parparentproc .
     5242     define variable v-all-object as logical   no-undo .
     5243   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5244   for each obj-list :
     5245    delete obj-list.
     5246   end.
     5247   str-obj#  = "" .
     5248   str-obj2# = "" .
     5249   str-obj3# = "" .
     5250   case selectobject :
     5251   when "currency":U then do:
     5252    run verify-check.
     5253   end.
     5254   when 'все':U then   do:
     5255    run sss.
     5256   end.
     5257   when "all" then   do:
     5258    run sss.
     5259   end.
     5260   when "firm":U then   do:
     5261    run sss.
     5262   end.
     5263   when "choice":U then do:
     5264     for each obj-list :
     5265         delete obj-list.
     5266     end.
     5267     define variable v-object-exist as logical   no-undo .
     5268   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5269   run userobjs_object-exist in this-procedure
     5270     (output v-object-exist
     5271     )  .
     5272     if not params-only and v-object-exist = false then do:
     5273   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5274   run userobjs_append in this-procedure
     5275     (input  v-cntxt-obj-type
     5276     ,input  v-cntxt-obj-code
     5277     )  .
     5278        v-object-exist = true .
     5279     end.
     5280     if my-request     = false
     5281     or v-object-exist = false
     5282     then do:
     5283       define variable v-user-select as logical   no-undo .
     5284       define variable v-recids as character no-undo .
     5285       if params-only then do:
     5286       run ref/thobjs.w
     5287           ( input my-handle
     5288           , input this-procedure:handle
     5289           , input (if params-only-mode = 'ПРОСМОТР':U then "b-mark-hidden" else "b-mark,b-sel")
     5290           , input 'все':U
     5291           , input ''
     5292           , input ?
     5293           , input ?
     5294           , input-output v-recids ) no-error .
     5295        end.
     5296        else do:
     5297   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5298   run userobjs_select-many in this-procedure
     5299     (input  my-handle
     5300     ,input  v-cntxt-db-num
     5301     ,input  v-cntxt-userid
     5302     ,input  v-cntxt-host-code-obj
     5303     ,input  v-cntxt-obj-type
     5304     ,input  v-cntxt-obj-code
     5305     ,output v-user-select
     5306     )  .
     5307        end.
     5308     end.
     5309     my-request = true .
     5310   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5311   run userobjs_object-exist in this-procedure
     5312     (output v-object-exist
     5313     )  .
     5314     if v-object-exist = false
     5315     then do:
     5316       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u then do:
     5317         assign selectobject = "firm":U .
     5318       end.
     5319       else do:
     5320         assign selectobject =  "currency":u .
     5321       end.
     5322       display selectobject with frame Dialog-Frame .
     5323       disable button-obj   with frame Dialog-Frame .
     5324       find cli-obj where cli-obj.obj-type = v-cntxt-obj-type and
     5325                           cli-obj.obj-code = v-cntxt-obj-code no-lock .
     5326       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u
     5327       then do:
     5328         run sss.
     5329       end.
     5330       else do:
     5331         run verify-check.
     5332       end.
     5333     end.
     5334     else do:
     5335         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     5336         define buffer buf_clients for ub.clients .
     5337         define buffer buf_db for ub.db .
     5338         define buffer buf_shop for ub.shop .
     5339         define buffer buf_store for ub.store .
     5340         define buffer buf_sysconf for ub.sysconf .
     5341         for each buf_userobjs_temp-user-obj
     5342         :
     5343           find first buf_clients no-lock
     5344             where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     5345               and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     5346             .
     5347             if verify-send-check  and buf_clients.db-num <> v-cntxt-db-num  and v-all-object = false then do:
     5348                   find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
     5349                   if buf_db.send-check = false then do:
     5350                     str-obj2# = str-obj2#  + " " + buf_clients.obj-name + ",".
     5351                     next.
     5352                   end.
     5353             end.
     5354             if temp-param-obj-type = 'shop':u and v-all-object = false then do:
     5355                 if buf_userobjs_temp-user-obj.obj-type = 'скл':U then do:
     5356                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     5357                     next.
     5358                   end.
     5359             end.
     5360             if temp-param-obj-type = 'stock':u and v-all-object = false then do:
     5361                 if buf_userobjs_temp-user-obj.obj-type = 'маг':U then do:
     5362                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     5363                     next.
     5364                 end.
     5365             end.
     5366             case buf_userobjs_temp-user-obj.obj-type:
     5367                 when 'скл':U then
     5368                     do:
     5369                         find buf_store where buf_store.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     5370                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_store.host-code no-error.
     5371                         find first buf_clients no-lock where
     5372                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     5373                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     5374                             .
     5375                         if buf_sysconf.base-code = base-code or v-all-object = true
     5376                             then do:
     5377   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5378   run create_obj-list in this-procedure
     5379    ( input buf_userobjs_temp-user-obj.obj-type ,
     5380      input buf_userobjs_temp-user-obj.obj-code )
     5381      .
     5382                             end.
     5383                             else do:
     5384                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     5385                             end.
     5386                     end.
     5387                 when 'маг':U then
     5388                     do:
     5389                         find first buf_shop where buf_shop.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     5390                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_shop.host-code no-error.
     5391                         find first buf_clients no-lock where
     5392                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     5393                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code no-error.
     5394                         if buf_sysconf.base-code = base-code or v-all-object = true
     5395                               then do:
     5396   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5397   run create_obj-list in this-procedure
     5398    ( input buf_userobjs_temp-user-obj.obj-type ,
     5399      input buf_userobjs_temp-user-obj.obj-code )
     5400      .
     5401                             end.
     5402                             else do:
     5403                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     5404                             end.
     5405                     end.
     5406             end case.
     5407           end.
     5408       end.
     5409   end.
     5410   end case.
     5411   if SelectObject = "currency":U  or g#type <> 'ФП':U then do:
     5412       for each  obj-list : delete obj-list . end.
     5413   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5414   run create_obj-list in this-procedure
     5415    ( input store-type ,
     5416      input store-code )
     5417      .
     5418   end.
     5419   if SelectObject = 'order':U then do:
     5420       for each  obj-list : delete obj-list . end.
     5421       define variable str-pos as integer no-undo .
     5422       define variable str-pos2 as integer no-undo .
     5423       define variable str-1 as character no-undo .
     5424       define variable i as integer no-undo .
     5425       define variable e1 as character no-undo .
     5426       define variable e2 as integer no-undo .
     5427       define variable v-nn as integer   no-undo .
     5428       str-pos = index (  p-e-m , "&" ) .
     5429       str-pos2 = LENGTH ( p-e-m ) - str-pos .
     5430       str-1 = substring (p-e-m , str-pos + 1 , str-pos2 ).
     5431       v-nn = num-entries (str-1) .
     5432       do i = 1 to v-nn :
     5433           assign
     5434             e1 = entry(1, (entry( i , str-1, "," )) , " ")
     5435             e2 = integer(entry(2, (entry( i , str-1, "," )), " " ))
     5436             no-error .
     5437             if error-status :error then next.
     5438   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5439   run create_obj-list in this-procedure
     5440    ( input e1 ,
     5441      input e2 )
     5442      .
     5443       end.
     5444   end.
     5445   OPEN QUERY br-obj-list  FOR EACH obj-list .
     5446     end.
     5447   END PROCEDURE.
     5448   PROCEDURE sss :
     5449     do
     5450     on error undo, return error return-value
     5451     :
     5452   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5453     for each obj-list :  delete obj-list.  end.
     5454     assign
     5455       str-obj#  = ''
     5456       str-obj2# = ''
     5457       str-obj3# = ''.
     5458     define buffer buf_user-obj for ub.user-obj .
     5459     for each buf_user-obj no-lock
     5460       where buf_user-obj.db-num  = v-cntxt-db-num
     5461         and buf_user-obj.user-id = v-cntxt-userid
     5462     ,each cli-obj no-lock
     5463       where cli-obj.obj-type = buf_user-obj.obj-type
     5464         and cli-obj.obj-code = buf_user-obj.obj-code
     5465         and ( ( cli-obj.db-num = g#db-num ) or g#db-num = 0 )
     5466     :
     5467             find first ub.clients no-lock
     5468               where ub.clients.obj-type = buf_user-obj.obj-type
     5469                 and ub.clients.obj-code = buf_user-obj.obj-code
     5470               no-error .
     5471             if verify-send-check  and ub.clients.db-num <> g#db-num  then do:
     5472                find first ub.db where ub.db.db-num = ub.clients.db-num no-lock.
     5473                if ub.db.send-check = false
     5474                then do:
     5475                  assign
     5476                    str-obj2# = str-obj2#  + " " + ub.clients.obj-name + ","
     5477                  .
     5478                  next.
     5479                end.
     5480             end.
     5481             if temp-param-obj-type = 'shop':u
     5482             then do:
     5483               if buf_user-obj.obj-type = 'скл':U
     5484               then do:
     5485                 assign
     5486                   str-obj# = str-obj#  +  " " + ub.clients.obj-name + ","
     5487                 .
     5488                 next.
     5489               end.
     5490             end.
     5491             if temp-param-obj-type = 'stock':u
     5492             then do:
     5493               if buf_user-obj.obj-type = 'маг':U then do:
     5494                 assign
     5495                   str-obj# = str-obj#  +  " " +  ub.clients.obj-name + ","
     5496                 .
     5497                 next.
     5498               end.
     5499             end.
     5500                   case buf_user-obj.obj-type
     5501                   :
     5502                       when 'скл':U then
     5503                           do:
     5504                               find ub.store where ub.store.obj-code = buf_user-obj.obj-code no-lock.
     5505                               if selectobject = "firm":U then do:
     5506                                 if ub.store.host-code <> g#host-code then do:
     5507                                     str-obj3# = str-obj3#  + " " + ub.clients.obj-name + ",".
     5508                                     next.
     5509                                     end.
     5510                               end.
     5511                               find first ub.sysconf no-lock where ub.sysconf.host-code = ub.store.host-code no-error.
     5512                               find first ub.clients no-lock
     5513                                 where ub.clients.obj-type = buf_user-obj.obj-type
     5514                                   and ub.clients.obj-code = buf_user-obj.obj-code
     5515                                 no-error .
     5516                               if ub.sysconf.base-code = base-code then
     5517                                   do:
     5518   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5519   run create_obj-list in this-procedure
     5520    ( input buf_user-obj.obj-type ,
     5521      input buf_user-obj.obj-code )
     5522      .
     5523                                   end.
     5524                                   else str-obj# = str-obj#  +  " " +   ub.clients.obj-name + "," .
     5525                           end.
     5526                       when 'маг':U then
     5527                           do:
     5528                               find ub.shop where ub.shop.obj-code = buf_user-obj.obj-code no-lock.
     5529                               if selectobject = "firm":U then do:
     5530                                 if ub.shop.host-code <> g#host-code then do:
     5531                                     str-obj3# = str-obj3#  + " " + ub.clients.obj-name + ",".
     5532                                     next.
     5533                                     end.
     5534                               end.
     5535                               find first ub.sysconf no-lock where ub.sysconf.host-code = ub.shop.host-code no-error.
     5536                               find first ub.clients no-lock where
     5537                                           ub.clients.obj-type = buf_user-obj.obj-type and
     5538                                           ub.clients.obj-code = buf_user-obj.obj-code no-error.
     5539                               if ub.sysconf.base-code = base-code
     5540                               then do:
     5541   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5542   run create_obj-list in this-procedure
     5543    ( input buf_user-obj.obj-type ,
     5544      input buf_user-obj.obj-code )
     5545      .
     5546                               end.
     5547                               else do:
     5548                                 assign
     5549                                   str-obj# = str-obj#  +  " " +  ub.clients.obj-name +  ","
     5550                                 .
     5551                               end.
     5552                           end.
     5553                   end case.
     5554     end.
     5555     end.
     5556   END PROCEDURE.
     5557   PROCEDURE v-c-2 :
     5558     assign frame   Dialog-Frame   r-algoritm2.
     5559     case  r-algoritm2:
     5560     when 1 then do:
     5561            enable  RECT-3 RECT-8 R-algoritm2 date-p-1 date-p-2 t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14      with frame Dialog-Frame .
     5562            disable BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7    with frame Dialog-Frame .
     5563            hide    BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7    in   frame Dialog-Frame .
     5564            browse-1:bgcolor      in   frame Dialog-Frame  = 8 .
     5565     end.
     5566     when 2 then do:
     5567           enable  RECT-3 RECT-8 R-algoritm2 date-p-1 date-p-2 t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14    with frame Dialog-Frame .
     5568           disable BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame .
     5569           hide    BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  in   frame Dialog-Frame .
     5570           browse-1:bgcolor    in   frame Dialog-Frame  = 8 .
     5571     end.
     5572     when 3 then do:
     5573           enable   RECT-3 RECT-8 R-algoritm2 date-p-1 date-p-2 t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7   with frame Dialog-Frame .
     5574           browse-1:bgcolor  in frame Dialog-Frame  = ? .
     5575      end.
     5576      otherwise do:
     5577         message "Нет!!! " .
     5578      end.
     5579     end case.
     5580   END PROCEDURE.
     5581   PROCEDURE v-c-alg :
     5582    do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     5583    define variable g#log  as logical   no-undo .
     5584     assign frame   Dialog-Frame   r-algoritm.
     5585     g#log = R-algoritm2:enable(radio-label("2", R-algoritm2:radio-buttons)) .
     5586     case  r-algoritm:
     5587     when 1 then do:
     5588            enable  RECT-3 RECT-8 R-algoritm2 date-p-1 date-p-2 t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14 p-neg-sale r-min-rest3 T-min-zapas FILL-IN-3 FILL-IN-5 FILL-IN-7 with frame Dialog-Frame .
     5589            disable BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code  T-gar t-gar-1 t-gar-2 with frame Dialog-Frame .
