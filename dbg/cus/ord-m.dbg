     2726                       input t-sppv-3,
     2727                       input t-sppv-4,
     2728                       input t-way,
     2729                       input t-rcv,
     2730                       input t-clos,
     2731                       input table tt-date ,
     2732                       input table temp-abc-day ,
     2733                       input p-neg-sale,
     2734                       input t-gar,
     2735                       input t-min-zapas ,
