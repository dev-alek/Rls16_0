     4338           .
     4339         end.
     4340       end.
     4341     end.
     4342     return no-apply .
     4343   end.
     4344     define MENU m-ed-date19
     4345       MENU-ITEM m-ed-date19-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     4346       MENU-ITEM m-ed-date19-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
