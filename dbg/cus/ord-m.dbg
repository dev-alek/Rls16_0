     5597           hide    RECT-3 RECT-8 R-algoritm2 date-p-1 date-p-2 t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14 BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  T-gar t-gar-1 t-gar-2 browse-abc-day  in frame Dialog-Frame .
     5598           browse-1:bgcolor  in frame Dialog-Frame  = 8 .
     5599           g#log = R-min-rest:enable( 'На фирме' ) .
     5600     end.
     5601     when 3 then do:
     5602           enable   RECT-3 RECT-8 R-algoritm2 date-p-1 date-p-2 t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14  p-neg-sale r-min-rest3 T-min-zapas FILL-IN-3 FILL-IN-5 FILL-IN-7   T-gar t-gar-1 t-gar-2   with frame Dialog-Frame .
     5603           disable  BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame .
     5604           hide     BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7   in  frame Dialog-Frame .
     5605           browse-1:bgcolor  in frame Dialog-Frame  = ? .
     5606           g#log = R-min-rest:enable( 'На фирме' ) .
     5607      end.
     5608      when 4 then do:
     5609           enable   RECT-3 RECT-8 R-algoritm2 date-p-1 date-p-2 t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 FILL-IN-15 FILL-IN-14 p-neg-sale r-min-rest3 T-min-zapas FILL-IN-3 FILL-IN-5 FILL-IN-7   with frame Dialog-Frame .
     5610           disable  BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 T-gar t-gar-1 t-gar-2  with frame Dialog-Frame .
     5611           hide     BROWSE-abc-day B-spis FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 T-gar t-gar-1 t-gar-2  in frame Dialog-Frame .
