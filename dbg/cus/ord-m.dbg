     4292         .
     4293       end.
     4294     end.
     4295     return no-apply .
     4296   end.
     4297   on ctrl-f of date-p-1 in frame Dialog-Frame
     4298   do:
     4299     if (can-query (self, "sensitive")
     4300        and
     4301        self :sensitive = true
     4302        )
     4303     or (can-query (self, "read-only")
     4304        and
