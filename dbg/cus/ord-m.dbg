     2880   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2881   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2882   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2883   on help of frame Dialog-Frame
     2884   do:
     2885     run gbl/app_help.p
     2886       (input this-procedure :file-name
     2887       ,input ''
     2888       ,input ?
     2889       ) no-error.
     2890     if error-status :error then do:
     2891       message
     2892         "Ошибка при вызове помощи"
     2893         error-status :get-message(1)
     2894         view-as alert-box .
     2895     end.
     2896   end.
     2897   run minbtn-set in this-procedure .
     2898   on choose of b-help in frame Dialog-Frame
     2899   do:
     2900     apply "help":u to frame Dialog-Frame .
     2901   end.
     2902   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2903   procedure minbtn-set :
     2904       do
     2905           on error undo, return error return-value
     2906           :
     2907           define variable ii              as integer       no-undo .
     2908           define variable fh              as widget-handle no-undo .
     2909           define variable hh              as widget-handle no-undo .
     2910           define variable v-h             as handle        extent 4 no-undo .
     2911           define variable v-name-button   as character     no-undo .
     2912           define variable v-help-old-x    as decimal       no-undo .
     2913           define variable v-help-old-y    as decimal       no-undo .
     2914           define variable v-help-old-size as decimal       no-undo .
     2915           define variable v-frame-width   as decimal       no-undo .
     2916           define variable jj              as integer       no-undo .
     2917           do
     2918               on error undo, return error
     2919               :
     2920               assign
     2921                   v-frame-width = frame Dialog-Frame:width - 0.3
     2922                   fh            = frame Dialog-Frame:first-child
     2923                   hh            = fh:first-child
     2924                   ii            = 1
     2925                   .
     2926               do while valid-handle(hh):
     2927                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2928                   do:
     2929                       case lc(hh:name) :
     2930                           when "b-help" then
     2931                               do:
     2932                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2933                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2934                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2935                                   hh:TOOLTIP = "Помощь" .
     2936                                   v-help-old-x = hh:column .
     2937                                   v-help-old-y = hh:row    .
     2938                                   v-help-old-size = hh:width .
     2939                                   hh:width-chars = 2.5 .
     2940                               end.
     2941                           when "b-print" then
     2942                               do:
     2943                                   hh:load-image("cmp/b-print.bmp":u) .
     2944                                   hh:TOOLTIP = "Печать" .
     2945                                   v-h[ii] = hh:handle .
     2946                                   ii = ii + 1 .
     2947                                   hh:width-chars = 3 .
     2948                               end.
     2949                           when "b-history" or
     2950                           when "b-hist" then
     2951                               do:
     2952                                   hh:load-image("cmp/b-hist.bmp":u) .
     2953                                   hh:TOOLTIP = "История" .
     2954                                   v-h[ii] = hh:handle .
     2955                                   ii = ii + 1 .
     2956                                   hh:width-chars = 3 .
     2957                               end.
     2958                           when "b-sch" then
     2959                               do:
     2960                                   hh:load-image("cmp/b-sch.bmp":u) .
     2961                                   hh:TOOLTIP = "Установка Фильтра" .
     2962                                   v-h[ii] = hh:handle .
     2963                                   ii = ii + 1 .
     2964                                   hh:width-chars = 3 .
     2965                               end.
     2966                           when "b-hist-user" then
     2967                               do:
     2968                                   hh:load-image("cmp/b-hist.bmp":u) .
     2969                                   hh:TOOLTIP = "История пользователя" .
     2970                                   ii = ii + 1 .
     2971                               end.
     2972                       end case.
     2973                   end.
     2974                   hh = hh:next-sibling.
     2975               end.
     2976               b-help:column = v-frame-width - b-help:width-chars.
     2977               jj = 0.
     2978               repeat ii = 4 to 1 by -1 :
     2979                   if valid-handle (v-h[ii] ) then
     2980                   do:
     2981                       jj  = jj + 1 .
     2982                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2983                       v-h[ii]:row    = v-help-old-y .
     2984                   end.
     2985               end.
     2986           end.
     2987       end.
     2988   end procedure.
     2989   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2990   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2991   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2992   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2993   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2994   define variable v-diasize-current-frame-height as decimal   no-undo .
     2995   define variable v-diasize-change-size          as logical   no-undo .
     2996   define variable v-diasize-resize-button        as handle    no-undo .
     2997   define variable v-diasize-wndmax               as logical   no-undo .
     2998   define variable v-diasize-wndstore             as logical   no-undo .
     2999   define variable v-diasize-proc-name            as character no-undo .
     3000   define variable v-diasize-browse-handle        as handle    no-undo .
     3001   define variable v-diasize-browse-number        as integer   no-undo .
     3002   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3003   define temp-table temp-diasize-handle no-undo
     3004     field handle-value  as handle
     3005     field save-position as decimal
     3006     index xpk is primary unique handle-value
     3007     .
     3008   define temp-table temp-browse-handle no-undo
     3009     field browse-type   as character
     3010     field browse-number as integer
     3011     field browse-handle as handle
     3012     field original-size as decimal
     3013     index xpk is primary unique browse-type browse-number
     3014     index xie browse-type browse-handle
     3015   .
     3016   procedure diasize_change-height :
     3017     define input  parameter p-change-value  as decimal   no-undo .
     3018     define input  parameter p-move-resize   as logical   no-undo .
     3019     define variable v-field-group-handle    as handle    no-undo .
     3020     define variable v-object-handle         as handle    no-undo .
     3021     define variable v-frame-height          as decimal   no-undo .
     3022     define variable v-frame-virtual-height  as decimal   no-undo .
     3023     define variable v-browse-height         as decimal   no-undo .
     3024     define variable v-window-height         as decimal   no-undo .
     3025     define variable v-window-virtual-height as decimal   no-undo .
     3026     define variable v-change-sign           as integer   no-undo .
     3027     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3028     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3029     if p-change-value > 0
     3030     then do:
     3031       if frame Dialog-Frame :height + p-change-value
     3032           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3033       then do:
     3034         assign
     3035           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3036                           - (frame Dialog-Frame :height-chars)
     3037         .
     3038         if p-change-value <= 0
     3039         then do:
     3040           run diasize_position-resize-button in this-procedure .
     3041           return .
     3042         end.
     3043       end.
     3044     end.
     3045     if p-change-value < 0
     3046     then do:
     3047       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3048       then do:
     3049         assign
     3050           p-change-value = v-diasize-orig-frame-height
     3051                          - (frame Dialog-Frame :height-chars)
     3052         .
     3053         if p-change-value >= 0
     3054         then do:
     3055           run diasize_position-resize-button in this-procedure .
     3056           return .
     3057         end.
     3058       end.
     3059     end.
     3060     if p-change-value >= 0
     3061     then do:
     3062       assign
     3063         v-change-sign = 1
     3064       .
     3065     end.
     3066     else do:
     3067       assign
     3068         v-change-sign = -1
     3069       .
     3070     end.
     3071     assign
     3072       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3073     .
     3074     if p-change-value = 0
     3075     then do:
     3076       run diasize_position-resize-button in this-procedure .
     3077       return .
     3078     end.
     3079     move_block:
     3080     do
     3081     on error undo move_block, retry move_block
     3082     :
     3083       if retry
     3084       then do:
     3085         do
     3086         on error undo move_block, leave move_block
     3087         :
     3088           if p-change-value > 0
     3089           then do:
     3090             for each buf_temp-diasize-handle
     3091             on error undo, next
     3092             :
     3093               assign
     3094                 v-object-handle = buf_temp-diasize-handle.handle-value
     3095               .
     3096               if v-object-handle <> v-diasize-resize-button
     3097               then do:
     3098                 assign
     3099                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3100                 .
     3101               end.
     3102             end.
     3103             assign
     3104               v-diasize-browse-handle :height = v-browse-height
     3105             .
     3106             for each buf_temp-browse-handle
     3107               where buf_temp-browse-handle.browse-type = 'height':u
     3108             on error undo, next
     3109             :
     3110               assign
     3111                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3112               .
     3113             end.
     3114             assign
     3115               frame Dialog-Frame :height = v-frame-height
     3116             .
     3117             if frame Dialog-Frame :scrollable = true
     3118             then do:
     3119               assign
     3120                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3121               .
     3122             end.
     3123             run diasize_position-resize-button in this-procedure .
     3124           end.
     3125           else do:
     3126             if frame Dialog-Frame :scrollable = true
     3127             then do:
     3128               assign
     3129                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3130               .
     3131             end.
     3132             assign
     3133               frame Dialog-Frame :height = v-frame-height
     3134             .
     3135             assign
     3136               v-diasize-browse-handle :height = v-browse-height
     3137             .
     3138             for each buf_temp-browse-handle
     3139               where buf_temp-browse-handle.browse-type = 'height':u
     3140             on error undo, next
     3141             :
     3142               assign
     3143                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3144               .
     3145             end.
     3146             for each buf_temp-diasize-handle
     3147             on error undo, next
     3148             :
     3149               assign
     3150                 v-object-handle = buf_temp-diasize-handle.handle-value
     3151               .
     3152               if v-object-handle <> v-diasize-resize-button
     3153               then do:
     3154                 assign
     3155                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3156                 .
     3157               end.
     3158             end.
     3159             run diasize_position-resize-button in this-procedure .
     3160           end.
     3161           assign
     3162             v-diasize-change-size = false
     3163           .
     3164           leave move_block .
     3165         end.
     3166       end.
     3167       assign
     3168         v-diasize-need-full-display = true
     3169       .
     3170       if v-diasize-change-size = false
     3171       then do:
     3172         assign
     3173           v-diasize-change-size = true
     3174         .
     3175       end.
     3176       else do:
     3177         return .
     3178       end.
     3179       assign
     3180         v-frame-height = frame Dialog-Frame :height
     3181         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3182         v-browse-height = v-diasize-browse-handle :height
     3183       .
     3184       for each buf_temp-browse-handle
     3185         where buf_temp-browse-handle.browse-type = 'height':u
     3186       :
     3187         assign
     3188           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3189         .
     3190       end.
     3191       for each buf_temp-diasize-handle
     3192       :
     3193         delete buf_temp-diasize-handle .
     3194       end.
     3195       assign
     3196         v-field-group-handle = frame Dialog-Frame :first-child
     3197       .
     3198       do while valid-handle(v-field-group-handle)
     3199       :
     3200         assign
     3201           v-object-handle = v-field-group-handle :first-child
     3202         .
     3203         do while valid-handle(v-object-handle)
     3204         :
     3205           if  v-object-handle <> v-diasize-browse-handle :handle
     3206           and can-query(v-object-handle, "row")
     3207           and can-query(v-object-handle, "height")
     3208           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3209           then do:
     3210             find first buf_temp-browse-handle
     3211               where buf_temp-browse-handle.browse-type   = 'height':u
     3212                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3213               no-error .
     3214             if available buf_temp-browse-handle
     3215             then do:
     3216             end.
     3217             else do:
     3218               create buf_temp-diasize-handle .
     3219               assign
     3220                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3221                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3222               .
     3223             end.
     3224           end.
     3225           assign
     3226             v-object-handle = v-object-handle :next-sibling
     3227           .
     3228         end.
     3229         assign
     3230           v-field-group-handle = v-field-group-handle :next-sibling
     3231         .
     3232       end.
     3233       do with frame Dialog-Frame
     3234       :
     3235         hide v-diasize-resize-button .
     3236         assign
     3237           v-diasize-resize-button :row    = 1
     3238           v-diasize-resize-button :column = 1
     3239         .
     3240       end.
     3241       if p-change-value > 0
     3242       then do:
     3243         if frame Dialog-Frame :scrollable = true
     3244         then do:
     3245           assign
     3246             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3247             no-error .
     3248           if error-status :error
     3249           or error-status :get-message(1) <> ""
     3250           then do:
     3251             undo move_block, retry move_block .
     3252           end.
     3253         end.
     3254         assign
     3255           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3256           no-error .
     3257         if error-status :error
     3258         or error-status :get-message(1) <> ""
     3259         then do:
     3260           undo move_block, retry move_block .
     3261         end.
     3262         assign
     3263           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3264           no-error .
     3265         if error-status :error
     3266         or error-status :get-message(1) <> ""
     3267         then do:
     3268           undo move_block, retry move_block .
     3269         end.
     3270         for each buf_temp-browse-handle
     3271           where buf_temp-browse-handle.browse-type = 'height':u
     3272         on error undo move_block, retry move_block
     3273         :
     3274           assign
     3275             buf_temp-browse-handle.browse-handle :height
     3276               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3277             no-error .
     3278           if error-status :error
     3279           or error-status :get-message(1) <> ""
     3280           then do:
     3281             undo move_block, retry move_block .
     3282           end.
     3283         end.
     3284         for each buf_temp-diasize-handle
     3285         on error undo move_block, retry move_block
     3286         :
     3287           assign
     3288             v-object-handle = buf_temp-diasize-handle.handle-value
     3289           .
     3290           if v-object-handle <> v-diasize-resize-button
     3291           then do:
     3292             assign
     3293               v-object-handle :row = v-object-handle :row + p-change-value
     3294               no-error .
     3295             if error-status :error
     3296             or error-status :get-message(1) <> ""
     3297             then do:
     3298               undo move_block, retry move_block .
     3299             end.
     3300           end.
     3301         end.
     3302       end.
     3303       else do:
     3304         for each buf_temp-diasize-handle
     3305         on error undo move_block, retry move_block
     3306         :
     3307           assign
     3308             v-object-handle = buf_temp-diasize-handle.handle-value
     3309           .
     3310           if v-object-handle <> v-diasize-resize-button
     3311           then do:
     3312             assign
     3313               v-object-handle :row = v-object-handle :row + p-change-value
     3314               no-error .
     3315             if error-status :error
     3316             or error-status :get-message(1) <> ""
     3317             then do:
     3318               undo move_block, retry move_block .
     3319             end.
     3320           end.
     3321         end.
     3322         assign
     3323           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3324           no-error .
     3325         if error-status :error
     3326         or error-status :get-message(1) <> ""
     3327         then do:
     3328           undo move_block, retry move_block .
     3329         end.
     3330         for each buf_temp-browse-handle
     3331           where buf_temp-browse-handle.browse-type = 'height':u
     3332         on error undo move_block, retry move_block
     3333         :
     3334           assign
     3335             buf_temp-browse-handle.browse-handle :height
     3336               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3337             no-error .
     3338           if error-status :error
     3339           or error-status :get-message(1) <> ""
     3340           then do:
     3341             undo move_block, retry move_block .
     3342           end.
     3343         end.
     3344         assign
     3345           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3346           no-error .
     3347         if error-status :error
     3348         or error-status :get-message(1) <> ""
     3349         then do:
     3350           undo move_block, retry move_block .
     3351         end.
     3352         if frame Dialog-Frame :scrollable = true
     3353         then do:
     3354           assign
     3355             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3356             no-error .
     3357           if error-status :error
     3358           or error-status :get-message(1) <> ""
     3359           then do:
     3360             undo move_block, retry move_block .
     3361           end.
     3362         end.
     3363       end.
     3364       if p-move-resize = true
     3365       then do:
     3366         run diasize_position-resize-button in this-procedure .
     3367       end.
     3368       if v-diasize-wndstore = true
     3369       then do:
     3370         if connected("ub") = true
     3371         then do:
     3372           define variable v-cntxt-db-num        as integer   no-undo .
     3373           define variable v-cntxt-userid        as character no-undo .
     3374           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3375                                             , OUTPUT v-cntxt-userid
     3376                                             ) .
     3377           run gbl/wndsizew.p
     3378             (input  v-cntxt-db-num
     3379             ,input  v-cntxt-userid
     3380             ,input  v-diasize-proc-name
     3381             ,input  'height':u
     3382             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3383             ) .
     3384         end.
     3385       end.
     3386     end.
     3387     assign
     3388       v-diasize-change-size = false
     3389     .
     3390   end procedure.
     3391   procedure diasize_set-height :
     3392     define input  parameter p-new-height  as decimal   no-undo .
     3393     define input  parameter p-move-resize as logical   no-undo .
     3394     do
     3395     on error undo, return error return-value
     3396     :
     3397       run diasize_change-height in this-procedure
     3398         (input  (p-new-height - frame Dialog-Frame :height)
     3399         ,input  p-move-resize
     3400         ) .
     3401     end.
     3402   end procedure.
     3403   procedure diasize_change-width :
     3404     define input  parameter p-change-value as decimal   no-undo .
     3405     define input  parameter p-move-resize  as logical   no-undo .
     3406     define variable v-field-group-handle   as handle    no-undo .
     3407     define variable v-object-handle        as handle    no-undo .
     3408     define variable v-frame-width          as decimal   no-undo .
     3409     define variable v-frame-virtual-width  as decimal   no-undo .
     3410     define variable v-browse-width         as decimal   no-undo .
     3411     define variable v-window-width         as decimal   no-undo .
     3412     define variable v-window-virtual-width as decimal   no-undo .
     3413     define variable v-change-sign          as integer   no-undo .
     3414     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3415     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3416     if p-change-value > 0
     3417     then do:
     3418       if frame Dialog-Frame :width + p-change-value >
     3419           session :width-chars
     3420       then do:
     3421         assign
     3422           p-change-value = session :width-chars - frame Dialog-Frame :width
     3423         .
     3424         if p-change-value <= 0
     3425         then do:
     3426           run diasize_position-resize-button in this-procedure .
     3427           return .
     3428         end.
     3429       end.
     3430     end.
     3431     if p-change-value < 0
     3432     then do:
     3433       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3434       then do:
     3435         assign
     3436           p-change-value = v-diasize-orig-frame-width
     3437                          - frame Dialog-Frame :width
     3438         .
     3439         if p-change-value >= 0
     3440         then do:
     3441           run diasize_position-resize-button in this-procedure .
     3442           return .
     3443         end.
     3444       end.
     3445     end.
     3446     if p-change-value >= 0
     3447     then do:
     3448       assign
     3449         v-change-sign = 1
     3450       .
     3451     end.
     3452     else do:
     3453       assign
     3454         v-change-sign = -1
     3455       .
     3456     end.
     3457     assign
     3458       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3459     .
     3460     if p-change-value = 0
     3461     then do:
     3462       run diasize_position-resize-button in this-procedure .
     3463       return .
     3464     end.
     3465     move_block:
     3466     do
     3467     on error undo move_block, leave move_block
     3468     :
     3469       if retry
     3470       then do:
     3471         do
     3472         on error undo move_block, leave move_block
     3473         :
     3474           if p-change-value > 0
     3475           then do:
     3476             for each buf_temp-diasize-handle
     3477             on error undo, next
     3478             :
     3479               assign
     3480                 v-object-handle = buf_temp-diasize-handle.handle-value
     3481               .
     3482               if v-object-handle <> v-diasize-resize-button
     3483               then do:
     3484                 assign
     3485                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3486                 .
     3487               end.
     3488             end.
     3489             assign
     3490               v-diasize-browse-handle :width = v-browse-width
     3491             .
     3492             for each buf_temp-browse-handle
     3493               where buf_temp-browse-handle.browse-type = 'width':u
     3494             on error undo, next
     3495             :
     3496               assign
     3497                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3498               .
     3499             end.
     3500             assign
     3501               frame Dialog-Frame :width = v-frame-width
     3502             .
     3503             if frame Dialog-Frame :scrollable = true
     3504             then do:
     3505               assign
     3506                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3507               .
     3508             end.
     3509             run diasize_position-resize-button in this-procedure .
     3510           end.
     3511           else do:
     3512             if frame Dialog-Frame :scrollable = true
     3513             then do:
     3514               assign
     3515                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3516               .
     3517             end.
     3518             assign
     3519               frame Dialog-Frame :width = v-frame-width
     3520             .
     3521             for each buf_temp-browse-handle
     3522               where buf_temp-browse-handle.browse-type = 'width':u
     3523             on error undo, next
     3524             :
     3525               assign
     3526                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3527               .
     3528             end.
     3529             assign
     3530               v-diasize-browse-handle :width = v-browse-width
     3531             .
     3532             for each buf_temp-diasize-handle
     3533             on error undo, next
     3534             :
     3535               assign
     3536                 v-object-handle = buf_temp-diasize-handle.handle-value
     3537               .
     3538               if v-object-handle <> v-diasize-resize-button
     3539               then do:
     3540                 assign
     3541                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3542                 .
     3543               end.
     3544             end.
     3545             run diasize_position-resize-button in this-procedure .
     3546           end.
     3547           assign
     3548             v-diasize-change-size = false
     3549           .
     3550           leave move_block .
     3551         end.
     3552       end.
     3553       assign
     3554         v-diasize-need-full-display = true
     3555       .
     3556       if v-diasize-change-size = false
     3557       then do:
     3558         assign
     3559           v-diasize-change-size = true
     3560         .
     3561       end.
     3562       else do:
     3563         return .
     3564       end.
     3565       assign
     3566         v-frame-width = frame Dialog-Frame :width
     3567         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3568         v-browse-width = v-diasize-browse-handle :width
     3569       .
     3570       for each buf_temp-browse-handle
     3571         where buf_temp-browse-handle.browse-type = 'width':u
     3572       :
     3573         assign
     3574           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3575         .
     3576       end.
     3577       for each buf_temp-diasize-handle
     3578       :
     3579         delete buf_temp-diasize-handle .
     3580       end.
     3581       assign
     3582         v-field-group-handle = frame Dialog-Frame :first-child
     3583       .
     3584       do while valid-handle(v-field-group-handle)
     3585       :
     3586         assign
     3587           v-object-handle = v-field-group-handle :first-child
     3588         .
     3589         do while valid-handle(v-object-handle)
     3590         :
     3591           if  v-object-handle <> v-diasize-browse-handle :handle
     3592           and v-object-handle <> v-diasize-resize-button
     3593           and can-query(v-object-handle, "row")
     3594           and can-query(v-object-handle, "height")
     3595           and ( v-object-handle :col + v-object-handle :width
     3596                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3597               )
     3598           then do:
     3599             find first buf_temp-browse-handle
     3600               where buf_temp-browse-handle.browse-type   = 'width':u
     3601                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3602               no-error .
     3603             if available buf_temp-browse-handle
     3604             then do:
     3605             end.
     3606             else do:
     3607               create buf_temp-diasize-handle .
     3608               assign
     3609                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3610                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3611               .
     3612             end.
     3613           end.
     3614           assign
     3615             v-object-handle = v-object-handle :next-sibling
     3616           .
     3617         end.
     3618         assign
     3619           v-field-group-handle = v-field-group-handle :next-sibling
     3620         .
     3621       end.
     3622       do with frame Dialog-Frame
     3623       :
     3624         hide v-diasize-resize-button .
     3625         v-diasize-resize-button :row = 1.
     3626         v-diasize-resize-button :column = 1.
     3627       end.
     3628       if p-change-value > 0
     3629       then do:
     3630         if frame Dialog-Frame :scrollable = true
     3631         then do:
     3632           assign
     3633             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3634             no-error .
     3635           if error-status :error
     3636           or error-status :get-message(1) <> ""
     3637           then do:
     3638             undo move_block, retry move_block.
     3639           end.
     3640         end.
     3641         assign
     3642           frame Dialog-Frame :width = v-frame-width + p-change-value
     3643           no-error .
     3644         if error-status :error
     3645         or error-status :get-message(1) <> ""
     3646         then do:
     3647           undo move_block, retry move_block.
     3648         end.
     3649         assign
     3650           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3651         no-error .
     3652         if error-status :error
     3653         or error-status :get-message(1) <> ""
     3654         then do:
     3655           undo move_block, retry move_block.
     3656         end.
     3657         for each buf_temp-browse-handle
     3658           where buf_temp-browse-handle.browse-type = 'width':u
     3659         on error undo move_block, retry move_block
     3660         :
     3661           assign
     3662             buf_temp-browse-handle.browse-handle :width
     3663               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3664             no-error .
     3665           if error-status :error
     3666           or error-status :get-message(1) <> ""
     3667           then do:
     3668             undo move_block, retry move_block .
     3669           end.
     3670         end.
     3671         for each buf_temp-diasize-handle
     3672         on error undo move_block, retry move_block
     3673         :
     3674           assign
     3675             v-object-handle = buf_temp-diasize-handle.handle-value
     3676           .
     3677           if v-object-handle <> v-diasize-resize-button
     3678           then do:
     3679             assign
     3680               v-object-handle :col = v-object-handle :col + p-change-value
     3681               no-error .
     3682             if error-status :error
     3683             or error-status :get-message(1) <> ""
     3684             then do:
     3685               undo move_block, retry move_block .
     3686             end.
     3687           end.
     3688         end.
     3689       end.
     3690       else do:
     3691         for each buf_temp-diasize-handle
     3692         on error undo move_block, retry move_block
     3693         :
     3694           assign
     3695             v-object-handle = buf_temp-diasize-handle.handle-value
     3696           .
     3697           if v-object-handle <> v-diasize-resize-button
     3698           then do:
     3699             assign
     3700               v-object-handle :col = v-object-handle :col + p-change-value
     3701               no-error .
     3702             if error-status :error
     3703             or error-status :get-message(1) <> ""
     3704             then do:
     3705               undo move_block, retry move_block .
     3706             end.
     3707           end.
     3708         end.
     3709         for each buf_temp-browse-handle
     3710           where buf_temp-browse-handle.browse-type = 'width':u
     3711         on error undo move_block, retry move_block
     3712         :
     3713           assign
     3714             buf_temp-browse-handle.browse-handle :width
     3715               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3716             no-error .
     3717           if error-status :error
     3718           or error-status :get-message(1) <> ""
     3719           then do:
     3720             undo move_block, retry move_block .
     3721           end.
     3722         end.
     3723         assign
     3724           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3725           no-error .
     3726         if error-status :error
     3727         or error-status :get-message(1) <> ""
     3728         then do:
     3729           undo move_block, retry move_block.
     3730         end.
     3731         assign
     3732           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3733         no-error .
     3734         if error-status :error
     3735         or error-status :get-message(1) <> ""
     3736         then do:
     3737           undo move_block, retry move_block.
     3738         end.
     3739         if frame Dialog-Frame :scrollable = true
     3740         then do:
     3741           assign
     3742             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3743           no-error .
     3744           if error-status :error
     3745           or error-status :get-message(1) <> ""
     3746           then do:
     3747             undo move_block, retry move_block.
     3748           end.
     3749         end.
     3750       end.
     3751       if p-move-resize
     3752       then do:
     3753         run diasize_position-resize-button in this-procedure .
     3754       end.
     3755       if v-diasize-wndstore = true
     3756       then do:
     3757         if connected("ub") = true
     3758         then do:
     3759           define variable v-cntxt-db-num        as integer   no-undo .
     3760           define variable v-cntxt-userid        as character no-undo .
     3761           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3762                                             , OUTPUT v-cntxt-userid
     3763                                             ) .
     3764           run gbl/wndsizew.p
     3765             (input  v-cntxt-db-num
     3766             ,input  v-cntxt-userid
     3767             ,input  v-diasize-proc-name
     3768             ,input  'width':u
     3769             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3770             ) .
     3771         end.
     3772       end.
     3773     end.
     3774     assign
     3775       v-diasize-change-size = false
     3776     .
     3777   end procedure.
     3778   procedure diasize_set-width :
     3779     define input  parameter p-new-width  as decimal   no-undo .
     3780     define input  parameter p-move-resize as logical   no-undo .
     3781     do
     3782     on error undo, return error return-value
     3783     :
     3784       run diasize_change-width in this-procedure
     3785         (input  (p-new-width - frame Dialog-Frame :width)
     3786         ,input  p-move-resize
     3787         ) .
     3788     end.
     3789   end procedure.
     3790   procedure diasize_position-resize-button :
     3791     do with frame Dialog-Frame
     3792     :
     3793       hide v-diasize-resize-button .
     3794       assign
     3795         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3796                     - 1
     3797                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3798         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3799                     - 1
     3800                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3801       .
     3802       view v-diasize-resize-button .
     3803     end.
     3804   end procedure.
     3805   on alt-right anywhere
     3806   do:
     3807     run diasize_change-width in this-procedure
     3808       (input 1
     3809       ,input true
     3810       ) .
     3811     return no-apply .
     3812   end.
     3813   on alt-left anywhere
     3814   do:
     3815     run diasize_change-width in this-procedure
     3816       (input -1
     3817       ,input true
     3818       ) .
     3819     return no-apply .
     3820   end.
     3821   on alt-down anywhere
     3822   do:
     3823     run diasize_change-height in this-procedure
     3824       (input 1
     3825       ,input true
     3826       ) .
     3827     return no-apply .
     3828   end.
     3829   on alt-up anywhere
     3830   do:
     3831     run diasize_change-height in this-procedure
     3832       (input -1
     3833       ,input true
     3834       ) .
     3835     return no-apply .
     3836   end.
     3837   on alt-enter of frame Dialog-Frame
     3838   do:
     3839     run diasize_maximize in this-procedure
     3840       (input  ?
     3841       ).
     3842     return no-apply .
     3843   end.
     3844   procedure diasize_end-move :
     3845     do
     3846     on error undo, return error return-value
     3847     :
     3848       define variable v-row-delta as decimal   no-undo .
     3849       define variable v-col-delta as decimal   no-undo .
     3850       define variable v-new-row as decimal   no-undo .
     3851       define variable v-new-col as decimal   no-undo .
     3852       assign
     3853         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3854         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3855       .
     3856       assign
     3857         v-row-delta = v-new-row - frame Dialog-Frame :height
     3858         v-col-delta = v-new-col - frame Dialog-Frame :width
     3859       .
     3860       run diasize_change-height in this-procedure
     3861         (input v-row-delta
     3862         ,input true
     3863         ) .
     3864       run diasize_change-width in this-procedure
     3865         (input v-col-delta
     3866         ,input true
     3867         ) .
     3868     end.
     3869   end procedure.
     3870   procedure diasize_maximize :
     3871     define input  parameter p-action as logical   no-undo .
     3872     do
     3873     on error undo, return error return-value
     3874     :
     3875       if p-action = ?
     3876       then do:
     3877         if v-diasize-need-maximize = true
     3878         then do:
     3879           assign
     3880             p-action = true
     3881           .
     3882         end.
     3883         else do:
     3884           assign
     3885             p-action = false
     3886           .
     3887         end.
     3888       end.
     3889       if p-action = true
     3890       then do:
     3891         run diasize_change-height in this-procedure
     3892           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3893               - frame Dialog-Frame :height-chars
     3894           ,input true
     3895           ) .
     3896         run diasize_change-width in this-procedure
     3897           (input session :width-chars
     3898               - frame Dialog-Frame :width-chars
     3899           ,input true
     3900           ) .
     3901         assign
     3902           v-diasize-need-maximize = false
     3903         .
     3904       end.
     3905       else do:
     3906         run diasize_change-width in this-procedure
     3907           (input v-diasize-orig-frame-width
     3908               - frame Dialog-Frame :width-chars
     3909           ,input true
     3910           ) .
     3911         run diasize_change-height in this-procedure
     3912           (input v-diasize-orig-frame-height
     3913               - frame Dialog-Frame :height-chars
     3914           ,input true
     3915           ) .
     3916         assign
     3917           v-diasize-need-maximize = true
     3918         .
     3919       end.
     3920     end.
     3921   end procedure.
     3922   procedure diasize_restore-orig-size :
     3923     do
     3924     on error undo, return error return-value
     3925     :
     3926       assign
     3927         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3928         v-diasize-current-frame-height = frame Dialog-Frame :height
     3929       .
     3930       run diasize_set-height in this-procedure
     3931         (input  v-diasize-orig-frame-height
     3932         ,input  true
     3933         ) .
     3934       run diasize_set-width in this-procedure
     3935         (input  v-diasize-orig-frame-width
     3936         ,input  true
     3937         ) .
     3938     end.
     3939   end procedure.
     3940   procedure diasize_restore-current-size :
     3941     do
     3942     on error undo, return error return-value
     3943     :
     3944       run diasize_set-height in this-procedure
     3945         (input  v-diasize-current-frame-height
     3946         ,input  true
     3947         ) .
     3948       run diasize_set-width in this-procedure
     3949         (input  v-diasize-current-frame-width
     3950         ,input  true
     3951         ) .
     3952     end.
     3953   end procedure.
     3954   procedure diasize_set-browse-handle :
     3955     define input  parameter p-browse-handle as handle   no-undo .
     3956     define buffer buf_temp-browse-handle for temp-browse-handle .
     3957     do
     3958     on error undo, return error return-value
     3959     :
     3960       assign
     3961         v-diasize-browse-handle = p-browse-handle
     3962       .
     3963       for each buf_temp-browse-handle
     3964       on error undo, return error return-value
     3965       :
     3966         delete buf_temp-browse-handle .
     3967       end.
     3968     end.
     3969   end procedure.
     3970   procedure diasize_add_browse :
     3971     define input  parameter p-browse-type   as character no-undo .
     3972     define input  parameter p-browse-handle as handle    no-undo .
     3973     define buffer buf_temp-browse-handle for temp-browse-handle .
     3974     do
     3975     on error undo, return error return-value
     3976     :
     3977       assign
     3978         v-diasize-browse-number = v-diasize-browse-number + 1
     3979       .
     3980       create buf_temp-browse-handle .
     3981       assign
     3982         buf_temp-browse-handle.browse-type   = p-browse-type
     3983         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3984         buf_temp-browse-handle.browse-handle = p-browse-handle
     3985       .
     3986     end.
     3987   end procedure.
     3988   procedure diasize_init :
     3989     define variable v-default-value    as logical   no-undo .
     3990     define variable v-restore-saved    as logical   no-undo .
     3991     define variable v-resize-value-str as character no-undo .
     3992     do
     3993     on error undo, return error return-value
     3994     :
     3995       do with frame Dialog-Frame
     3996       :
     3997         assign
     3998           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3999           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4000           v-diasize-browse-handle     = browse BR-obj-list :handle
     4001         .
     4002         create button v-diasize-resize-button
     4003         assign
     4004           parent        = frame Dialog-Frame :first-child
     4005           label         = "s"
     4006           height-pixels = 16
     4007           width-pixels  = 16
     4008           visible       = true
     4009           sensitive     = true
     4010           movable       = true
     4011           triggers:
     4012             on end-move persistent run diasize_end-move in this-procedure .
     4013           end triggers.
     4014         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4015         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4016         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4017         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4018         assign
     4019           v-diasize-wndmax = false
     4020         .
     4021         if connected("ub") = true
     4022         then do:
     4023           define variable v-cntxt-db-num        as integer   no-undo .
     4024           define variable v-cntxt-userid        as character no-undo .
     4025           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4026                                             , OUTPUT v-cntxt-userid
     4027                                             ) .
     4028           run gbl/wndpar_r.p
     4029             (input  v-cntxt-db-num
     4030             ,input  v-cntxt-userid
     4031             ,input  'wndmax':U
     4032             ,output v-diasize-wndmax
     4033             ,output v-default-value
     4034             ) .
     4035         end.
     4036         assign
     4037           v-diasize-wndstore = false
     4038         .
     4039         if connected("ub") = true
     4040         then do:
     4041           run gbl/wndpar_r.p
     4042             (input  v-cntxt-db-num
     4043             ,input  v-cntxt-userid
     4044             ,input  'wndstore':U
     4045             ,output v-diasize-wndstore
     4046             ,output v-default-value
     4047             ) .
     4048         end.
     4049         assign
     4050           v-diasize-proc-name = entry(1, program-name(2), '.')
     4051         .
     4052         if v-diasize-wndstore = true
     4053         then do:
     4054           assign
     4055             v-restore-saved = false
     4056           .
     4057           if connected("ub") = true
     4058           then do:
     4059             run gbl/wndsizer.p
     4060               (input  v-cntxt-db-num
     4061               ,input  v-cntxt-userid
     4062               ,input  v-diasize-proc-name
     4063               ,input  'height':u
     4064               ,output v-resize-value-str
     4065               ) .
     4066             if v-resize-value-str <> '':U
     4067             then do:
     4068               run diasize_change-height in this-procedure
     4069                 (input  integer(v-resize-value-str)
     4070                 ,input  true
     4071                 ) .
     4072               assign
     4073                 v-restore-saved = true
     4074               .
     4075             end.
     4076           end.
     4077           if connected("ub") = true
     4078           then do:
     4079             run gbl/wndsizer.p
     4080               (input  v-cntxt-db-num
     4081               ,input  v-cntxt-userid
     4082               ,input  v-diasize-proc-name
     4083               ,input  'width':u
     4084               ,output v-resize-value-str
     4085               ) .
     4086             if v-resize-value-str <> '':U
     4087             then do:
     4088               run diasize_change-width in this-procedure
     4089                 (input  integer(v-resize-value-str)
     4090                 ,input  true
     4091                 ) .
     4092               assign
     4093                 v-restore-saved = true
     4094               .
     4095             end.
     4096           end.
     4097           if v-restore-saved <> true
     4098           then do:
     4099             if v-diasize-wndmax = true
     4100             then do:
     4101               run diasize_maximize in this-procedure
     4102                 (input  true
     4103                 ) .
     4104             end.
     4105           end.
     4106         end.
     4107         else do:
     4108           if v-diasize-wndmax = true
     4109           then do:
     4110             run diasize_maximize in this-procedure
     4111               (input  true
     4112               ) .
     4113           end.
     4114         end.
     4115       end.
     4116     end.
     4117   end procedure.
     4118   procedure diasize_need-full-display :
     4119     define output parameter p-need-full-display as logical   no-undo .
     4120     do
     4121     on error undo, return error return-value
     4122     :
     4123       assign
     4124         p-need-full-display = v-diasize-need-full-display
     4125       .
     4126       assign
     4127         v-diasize-need-full-display = false
     4128       .
     4129     end.
     4130   end procedure.
     4131   procedure get-context :
     4132      define output parameter p-db-num as integer          no-undo.
     4133      define output parameter p-user-id as character        no-undo.
     4134      define variable v-login               as character    no-undo.
     4135      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4136      define buffer buf_user-login  for ub.user-login .
     4137      do
     4138      on error undo, return error
     4139      :
     4140            FIND FIRST buf_sys-ctrl no-lock.
     4141            ASSIGN
     4142               v-login = USERID("ub")
     4143               p-db-num = buf_sys-ctrl.db-num
     4144            .
     4145            FIND FIRST buf_user-login
     4146                 WHERE buf_user-login.db-num = p-db-num
     4147                   AND buf_user-login.user-login = v-login
     4148                 no-lock
     4149                 no-error
     4150                 .
     4151            IF AVAILABLE buf_user-login
     4152            THEN DO:
     4153               assign
     4154                  p-user-id = buf_user-login.user-id
     4155               .
     4156            END.
     4157      end.
     4158   end procedure.
     4159       run diasize_init in this-procedure .
     4160   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4161   on ' ' of date-p-1 in frame Dialog-Frame
     4162   do:
     4163     if (can-query (self, "sensitive")
     4164        and
     4165        self :sensitive = true
     4166        )
     4167     or (can-query (self, "read-only")
     4168        and
     4169        self :read-only = false
     4170        )
     4171     then do:
     4172       assign
     4173         self :screen-value = ?
     4174       .
     4175     end.
     4176     return no-apply.
     4177   end.
     4178   on delete-character of date-p-1 in frame Dialog-Frame
     4179   do:
     4180     if (can-query (self, "sensitive")
     4181        and
     4182        self :sensitive = true
     4183        )
     4184     or (can-query (self, "read-only")
     4185        and
     4186        self :read-only = false
     4187        )
     4188     then do:
     4189       assign
     4190         self :screen-value = ?
     4191       .
     4192     end.
     4193     return no-apply.
     4194   end.
     4195   on ctrl-d of date-p-1 in frame Dialog-Frame
     4196   do:
     4197     define variable v-curr-sv-date as date no-undo .
     4198     if (can-query (self, "sensitive")
     4199        and
     4200        self :sensitive = true
     4201        )
     4202     or (can-query (self, "read-only")
     4203        and
     4204        self :read-only = false
     4205        )
     4206     then do:
     4207       if self :handle <> focus :handle
     4208       then do:
     4209         apply "entry":u to self .
     4210       end.
     4211       run gbl/getcurdt.p
     4212         (output v-curr-sv-date
     4213         ) .
     4214       assign
     4215         self :screen-value = string(v-curr-sv-date) .
     4216       .
     4217     end.
     4218     return no-apply.
     4219   end.
     4220   on ctrl-b of date-p-1 in frame Dialog-Frame
     4221   do:
     4222     if (can-query (self, "sensitive")
     4223        and
     4224        self :sensitive = true
     4225        )
     4226     or (can-query (self, "read-only")
     4227        and
     4228        self :read-only = false
     4229        )
     4230     then do:
     4231       if self :handle <> focus :handle
     4232       then do:
     4233         apply "entry":u to self .
     4234       end.
     4235       define variable v-curr-sv-date as date no-undo .
     4236       define variable v-new-sv-date  as date no-undo .
     4237       assign
     4238         v-curr-sv-date = date(self :screen-value) no-error
     4239       .
     4240       if v-curr-sv-date = ?
     4241       then do:
     4242         run gbl/getcurdt.p
     4243           (output v-curr-sv-date
     4244           ) .
     4245       end.
     4246       if v-curr-sv-date <> ?
     4247       then do:
     4248         assign
     4249           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     4250         .
     4251         assign
     4252           self :screen-value = string(v-new-sv-date) .
     4253         .
     4254       end.
     4255     end.
     4256     return no-apply .
     4257   end.
     4258   on ctrl-e of date-p-1 in frame Dialog-Frame
     4259   do:
     4260     if (can-query (self, "sensitive")
     4261        and
     4262        self :sensitive = true
     4263        )
     4264     or (can-query (self, "read-only")
     4265        and
     4266        self :read-only = false
     4267        )
     4268     then do:
     4269       if self :handle <> focus :handle
     4270       then do:
     4271         apply "entry":u to self .
     4272       end.
     4273       define variable v-curr-sv-date as date no-undo .
     4274       define variable v-new-sv-date  as date no-undo .
