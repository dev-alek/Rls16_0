     4321           (output v-curr-sv-date
     4322           ) .
     4323       end.
     4324       if v-curr-sv-date <> ?
     4325       then do:
     4326         run gbl/d-inpday.w
     4327           (input ?
     4328           ,input "Выбор даты"
     4329           ,input v-description
     4330           ,input ""
     4331           ,input-output v-curr-sv-date
     4332           ,output v-ok
     4333           ).
     4334         if v-ok = true
     4335         then do:
     4336           assign
