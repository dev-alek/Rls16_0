      770   .
      771   procedure create_obj-list :
      772      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      773      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      774      do
      775      on error undo, return error return-value
      776      :
      777         define buffer cli-obj for ub.clients .
      778         define variable p-var as integer no-undo .
      779         define buffer buf_obj-list for obj-list .
      780         find last buf_obj-list  use-index pi no-error .
      781         if available buf_obj-list
      782         then
      783            p-var = buf_obj-list.obj-id + 1.
      784         else
      785            p-var = 1.
      786         find first cli-obj where
      787                   cli-obj.obj-type = p-obj-type
      788               and cli-obj.obj-code = p-obj-code
      789         no-lock no-error.
      790         if available cli-obj
      791         then do:
      792            create buf_obj-list.
      793            assign
      794               buf_obj-list.obj-id   = p-var
      795               buf_obj-list.obj-code = cli-obj.obj-code
      796               buf_obj-list.obj-type = cli-obj.obj-type
      797               buf_obj-list.obj-name = cli-obj.obj-name
      798               buf_obj-list.db-num   = cli-obj.db-num
      799            .
      800         end.
      801      end.
      802   end.
