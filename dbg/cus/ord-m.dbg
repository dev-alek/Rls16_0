     1589      define output parameter p-label          as character no-undo .
     1590      define output parameter p-user-can-edit  as logical   no-undo .
     1591      define output parameter p-output-display as logical   no-undo .
     1592      define output parameter p-other          as character no-undo .
     1593      define output parameter p-prop-list      as character no-undo .
     1594      define output parameter p-prop-type-list as character no-undo .
     1595      define output parameter p-prop-label-list as character no-undo .
     1596      define output parameter p-global          as logical no-undo .
     1597      define output parameter p-host           as logical no-undo .
     1598      define output parameter p-shop           as logical no-undo .
     1599      define output parameter p-store          as logical no-undo .
     1600      define output parameter p-db             as logical no-undo .
     1601      define variable p-region as logical no-undo.
     1602      run thbjattr_code_reg in this-procedure (
     1603                                               p-upper-code,
     1604                                               p-code,
     1605                                               output p-label,
     1606                                               output p-user-can-edit,
     1607                                               output p-output-display,
     1608                                               output p-other,
     1609                                               output p-prop-list,
     1610                                               output p-prop-type-list,
     1611                                               output p-prop-label-list,
     1612                                               output p-global,
     1613                                               output p-host,
     1614                                               output p-shop,
     1615                                               output p-store,
     1616                                               output p-db,
     1617                                               output p-region
     1618                                               ).
     1619   end procedure.
     1620   procedure thbjattr_code_reg :
     1621   define input  parameter p-upper-code     as character no-undo .
     1622   define input  parameter p-code           as character no-undo .
     1623   define output parameter p-label          as character no-undo .
     1624   define output parameter p-user-can-edit  as logical   no-undo .
     1625   define output parameter p-output-display as logical   no-undo .
     1626   define output parameter p-other          as character no-undo .
     1627   define output parameter p-prop-list      as character no-undo .
