     2799                           shar_ord-line.prod-type = tmp#zakaz.prod-type and
     2800                           shar_ord-line.prod-code = tmp#zakaz.prod-code no-error  .
     2801                     if available shar_ord-line then do:
     2802                       BUFFER-COPY tmp#zakaz  to  shar_ord-line .
     2803                     end.
     2804                 end.
     2805             end.
     2806    end.
     2807   t-ret =  session:SET-WAIT-STATE("") .
     2808   END.
     2809   ON CHOOSE OF BUTTON-obj IN FRAME Dialog-Frame
     2810   DO:
     2811     assign SelectObject.
     2812     my-request = false .
     2813     run select-objects-proc in this-procedure (input e-method).
