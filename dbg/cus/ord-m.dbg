     4800   PROCEDURE calc-sum-vat :
     4801    do
     4802    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4803    :
     4804   define variable varprice-cli-dt                like ub.doc-line.price-rubl no-undo.
     4805   define variable varprice-cli-unit-base-dt      like ub.doc-line.price-rubl no-undo.
     4806   define variable varprice-road-tax-dt           like ub.doc-line.price-rubl no-undo.
     4807   define variable varprice-other-exp-dt          like ub.doc-line.price-rubl no-undo.
     4808   define variable varprice-transport-exp-dt      like ub.doc-line.price-rubl no-undo.
     4809   define variable varprice-without-abs-dt        like ub.doc-line.price-rubl no-undo.
     4810   define variable varprice-slt-dt                like ub.doc-line.price-rubl no-undo.
     4811   define variable varprice-no-slt-dt             like ub.doc-line.price-rubl no-undo.
     4812   define variable varprice-vat-dt                like ub.doc-line.price-rubl no-undo.
     4813   define variable varprice-no-vat-slt-dt         like ub.doc-line.price-rubl no-undo.
     4814   define variable varprice-rubl-dt               like ub.doc-line.price-rubl no-undo.
     4815   define variable varprice-road-tax-rubl-dt      like ub.doc-line.price-rubl no-undo.
     4816   define variable varprice-other-exp-rubl-dt     like ub.doc-line.price-rubl no-undo.
     4817   define variable varprice-transport-exp-rubl-dt like ub.doc-line.price-rubl no-undo.
     4818   define variable varprice-without-abs-rubl-dt   like ub.doc-line.price-rubl no-undo.
     4819   define variable varprice-slt-rubl-dt           like ub.doc-line.price-rubl no-undo.
     4820   define variable varprice-no-slt-rubl-dt        like ub.doc-line.price-rubl no-undo.
     4821   define variable varprice-vat-rubl-dt           like ub.doc-line.price-rubl no-undo.
     4822   define variable varprice-no-vat-slt-rubl-dt    like ub.doc-line.price-rubl no-undo.
     4823   define variable varprice-base-dt               like ub.doc-line.price-base no-undo.
     4824   define variable varprice-road-tax-base-dt      like ub.doc-line.price-base no-undo.
     4825   define variable varprice-other-exp-base-dt     like ub.doc-line.price-base no-undo.
     4826   define variable varprice-transport-exp-base-dt like ub.doc-line.price-base no-undo.
     4827   define variable varprice-without-abs-base-dt   like ub.doc-line.price-base no-undo.
     4828   define variable varprice-slt-base-dt           like ub.doc-line.price-base no-undo.
     4829   define variable varprice-no-slt-base-dt        like ub.doc-line.price-base no-undo.
     4830   define variable varprice-vat-base-dt           like ub.doc-line.price-base no-undo.
     4831   define variable varprice-no-vat-slt-base-dt    like ub.doc-line.price-base no-undo.
     4832   for each  tmp#zakaz
     4833       on error undo, return error :
     4834   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
     4835     (
     4836      input   'zakaz':u
     4837     ,input   loc-base-rate
     4838     ,input   loc-base-scale
     4839     ,input   loc-exch-rate
     4840     ,input   loc-exch-scale
     4841     ,input   vat_type
     4842     ,input   slt_type
     4843     ,input   tmp#zakaz.artic
     4844     ,input   tmp#zakaz.prod-type
     4845     ,input   tmp#zakaz.prod-code
     4846     ,input   tmp#zakaz.price-cli
     4847     ,input   tmp#zakaz.cli-base-rate
     4848     ,input   tmp#zakaz.price-rubl
     4849     ,input   tmp#zakaz.vat-pc
     4850     ,input   tmp#zakaz.slt-pc
     4851     ,input   tmp#zakaz.road-tax
     4852     ,input   tmp#zakaz.transport-rubl
     4853     ,input   tmp#zakaz.other-rubl
     4854     ,output  varprice-cli-dt
     4855     ,output  varprice-cli-unit-base-dt
     4856     ,output  varprice-road-tax-dt
     4857     ,output  varprice-other-exp-dt
     4858     ,output  varprice-transport-exp-dt
     4859     ,output  varprice-without-abs-dt
     4860     ,output  varprice-slt-dt
     4861     ,output  varprice-no-slt-dt
     4862     ,output  varprice-vat-dt
     4863     ,output  varprice-no-vat-slt-dt
     4864     ,output  varprice-rubl-dt
     4865     ,output  varprice-road-tax-rubl-dt
     4866     ,output  varprice-other-exp-rubl-dt
     4867     ,output  varprice-transport-exp-rubl-dt
     4868     ,output  varprice-without-abs-rubl-dt
     4869     ,output  varprice-slt-rubl-dt
     4870     ,output  varprice-no-slt-rubl-dt
     4871     ,output  varprice-vat-rubl-dt
     4872     ,output  varprice-no-vat-slt-rubl-dt
     4873     ,output  varprice-base-dt
     4874     ,output  varprice-road-tax-base-dt
     4875     ,output  varprice-other-exp-base-dt
     4876     ,output  varprice-transport-exp-base-dt
     4877     ,output  varprice-without-abs-base-dt
     4878     ,output  varprice-slt-base-dt
     4879     ,output  varprice-no-slt-base-dt
     4880     ,output  varprice-vat-base-dt
     4881     ,output  varprice-no-vat-slt-base-dt
     4882     ) no-error.
     4883       if error-status:error then do:
     4884         return error "Ошибка при пересчете НДС".
     4885       end.
     4886      assign
     4887       tmp#zakaz.sum-vat    = varprice-vat-dt  * tmp#zakaz.cli-qnty
     4888       tmp#zakaz.sum-slt    = varprice-slt-dt
     4889       tmp#zakaz.road-tax   = if var-report-r-b = "rubl" then   varprice-road-tax-rubl-dt else varprice-road-tax-base-dt
     4890       tmp#zakaz.other-base = varprice-other-exp-base-dt
     4891       tmp#zakaz.other-rubl = varprice-other-exp-rubl-dt
     4892       tmp#zakaz.price-rubl = varprice-rubl-dt
     4893       tmp#zakaz.price-base = varprice-base-dt
     4894       tmp#zakaz.price-cli  = varprice-cli-dt
     4895        .
     4896     end.
     4897     end.
     4898   END PROCEDURE.
     4899   PROCEDURE disable_UI :
     4900     HIDE FRAME Dialog-Frame.
     4901   END PROCEDURE.
     4902   PROCEDURE enable_UI :
     4903     OPEN QUERY Dialog-Frame FOR EACH tmp-sale NO-LOCK.
     4904     GET FIRST Dialog-Frame.
     4905     DISPLAY R-algoritm R-min-rest p-neg-sale T-gar r-min-rest3 T-min-ost
     4906             T-min-zapas R-algoritm2 SelectObject T-DeadLine date-p-1 date-p-2
     4907             t-way T-clos T-rcv t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2
     4908             t-sppv-3 v-round-m v-round-base v-name p-prt-art FILL-IN-2 FILL-IN-17
     4909             FILL-IN-3 t-gar-1 t-gar-2 t-min-ost-1 t-min-ost-2 FILL-IN-5 FILL-IN-15
     4910             FILL-IN-13 FILL-IN-7 t-1 FILL-IN-8 FILL-IN-14 t-2 t-3 t-4 t-5 t-6 t-7
     4911             FILL-IN-16
     4912         WITH FRAME Dialog-Frame.
     4913     IF AVAILABLE tmp-sale THEN
     4914       DISPLAY tmp-sale.desc_ tmp-sale.tmp-code
     4915         WITH FRAME Dialog-Frame.
     4916     ENABLE RECT-1 RECT-3 RECT-5 RECT-6 RECT-7 RECT-8 R-algoritm R-min-rest
     4917            p-neg-sale T-gar r-min-rest3 T-min-ost T-min-zapas R-algoritm2
     4918            SelectObject BR-obj-list T-DeadLine BUTTON-obj date-p-1 date-p-2 t-way
     4919            BROWSE-1 BROWSE-abc-day B-10 B-1 B-2 T-clos B-3 T-rcv t-rv t-rvc B-4
     4920            t-rvz T-rvzc B-5 T-sppv-4 T-sp T-sppv-2 t-sppv-3 B-6 B-7 v-round-m
     4921            v-round-base B-spis p-prt-art Btn_OK Btn_Cancel B-Help i-exit
     4922            FILL-IN-17 FILL-IN-3 t-gar-1 t-gar-2 t-min-ost-1 t-min-ost-2 FILL-IN-5
     4923            FILL-IN-15 FILL-IN-13 FILL-IN-7 t-1 FILL-IN-8 FILL-IN-14 t-2 t-3 t-4
     4924            t-5 t-6 t-7 FILL-IN-16 tmp-sale.desc_ tmp-sale.tmp-code
     4925         WITH FRAME Dialog-Frame.
     4926     VIEW FRAME Dialog-Frame.
     4927     OPEN QUERY br-obj-list  FOR EACH obj-list .    OPEN QUERY browse-1 FOR EACH tt-date .    OPEN QUERY BROWSE-abc-day FOR EACH temp-abc-day .
     4928   END PROCEDURE.
     4929   PROCEDURE init-screen :
     4930    do
     4931    on error undo, return error return-value
     4932    :
     4933   define input parameter p-val as character no-undo .
     4934   define variable i as integer no-undo .
     4935     if g#type <> 'ФП':U then do:
     4936         for each  obj-list : delete obj-list . end.
     4937   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4938   run create_obj-list in this-procedure
     4939    ( input store-type ,
     4940      input store-code )
     4941      .
     4942     end.
     4943   define variable v-nn as integer   no-undo .
     4944     v-nn = num-entries(p-val) .
     4945     do i = 1 to v-nn :
     4946        case  entry(1,(entry(i,p-val)), "=" ) :
     4947           when string( "v-round-m" )              then v-round-m =          entry(2,(entry(i,p-val)), "=" ).
     4948           when string( "v-round-base" )           then v-round-base = decimal( entry(2,(entry(i,p-val)), "=" )).
     4949           when string( "R-min-rest" )             then R-min-rest = integer(entry(2,(entry(i,p-val)), "=" )).
     4950           when string( "R-algoritm" )             then R-algoritm = integer(entry(2,(entry(i,p-val)), "=" )).
     4951           when string( "R-algoritm2" )            then R-algoritm2 = integer(entry(2,(entry(i,p-val)), "=" )).
     4952           when string( "tmp-sale.tmp-code" )      then do:
     4953                find first ub.tmp-sale no-lock where ub.tmp-sale.tmp-code = entry(2,(entry(i,p-val)), "=" ) no-error.
     4954                if available ub.tmp-sale then do:
     4955                   rr = recid(ub.tmp-sale) .
     4956                    display  ub.tmp-sale.tmp-code
     4957                                ub.tmp-sale.desc_   with frame Dialog-Frame .
     4958                    reposition Dialog-Frame to recid rr no-error  .
     4959                    if error-status :error then error-status :get-message(1) .
     4960                end.
     4961                else do:
     4962                find first ub.tmp-sale no-lock no-error .
     4963                   if available ub.tmp-sale then rr = recid(ub.tmp-sale) .
     4964                end.
     4965           end.
     4966           when string( "SelectObject" ) then  do:
     4967                   SelectObject = string(entry(2,(entry(i,p-val)), "=" )) no-error .
     4968                   if error-status :error then SelectObject = "firm":U  .
     4969                   if SelectObject = "choice":U then SelectObject = "order":U .
     4970                   run select-objects-proc in this-procedure (input p-val).
     4971                end.
     4972           when string( "date-p-1" ) then  date-p-1 = date(entry(2,(entry(i,p-val)), "=" )).
     4973           when string( "date-p-2" ) then  date-p-2 = date(entry(2,(entry(i,p-val)), "=" )).
     4974           when string( "t-way"    )   then  t-way    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4975           when string( "t-rcv"    )   then  t-rcv    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4976           when string( "t-clos"   )   then  t-clos    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4977           when string( "t-rv"   )   then  t-rv    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4978           when string( "t-rvz"  )   then  t-rvz   = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4979           when string( "t-rvc"  )   then  t-rvc   = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4980           when string( "t-rvzc" )   then  t-rvzc  = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4981           when string( "t-sp"   )   then  t-sp    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false  .
     4982           when string( "t-sppv-2")  then  t-sppv-2 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false.
     4983           when string( "t-sppv-3")  then  t-sppv-3 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4984           when string( "t-sppv-4")  then  t-sppv-4 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4985           when string( "p-neg-sale")   then  p-neg-sale = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4986           when string( "t-gar")         then  t-gar = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4987           when string( "t-min-zapas") then  t-min-zapas = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4988           when string( "t-min-ost") then  t-min-ost = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4989           when string( "t-deadline") then  t-deadline = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4990           when string( "R-min-rest3")  then  R-min-rest3 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     4991       end case.
     4992      g#log = SelectObject:disable(radio-label("all":U , SelectObject:radio-buttons)).
     4993     end.
     4994     if lookup ( v-round-m , 'Произвольно':U ) > 0 then do:
     4995           enable  v-round-base with frame Dialog-Frame .
     4996           display v-round-base with frame Dialog-Frame .
     4997        end.
     4998   end.
     4999   END PROCEDURE.
     5000   PROCEDURE loc-enable-UI :
     5001     OPEN QUERY Dialog-Frame FOR EACH tmp-sale NO-LOCK.
     5002     GET FIRST Dialog-Frame.
     5003     reposition Dialog-Frame to recid rr no-error  .
