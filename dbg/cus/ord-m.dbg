     1632   define output parameter p-shop           as logical no-undo .
     1633   define output parameter p-store          as logical no-undo .
     1634   define output parameter p-db             as logical no-undo .
     1635   define output parameter p-region         as logical no-undo .
     1636   do
     1637   on error undo, return error return-value
     1638   :
     1639       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1640       (input  p-upper-code
     1641       ,input  p-code
     1642       ,output p-label
     1643       ,output p-user-can-edit
     1644       ,output p-output-display
     1645       ,output p-other
     1646       ,output p-prop-list
     1647       ,output p-prop-type-list
     1648       ,output p-prop-label-list
     1649       ,output p-global
     1650       ,output p-host
     1651       ,output p-shop
     1652       ,output p-store
     1653       ,output p-db
     1654       ,output p-region
     1655       ) no-error .
     1656     if error-status :error
     1657     then do:
     1658       undo, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1)).
     1659     end.
     1660   end.
     1661   end procedure.
