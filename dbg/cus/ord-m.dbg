     2279        B-save AT ROW 20.5 COL 51.63
     2280        Btn_OK AT ROW 20.5 COL 66.75
     2281        Btn_Cancel AT ROW 20.5 COL 82
     2282        B-Help AT ROW 20.5 COL 97.5
     2283        i-exit AT ROW 20.71 COL 66.88 WIDGET-ID 10
     2284        FILL-IN-2 AT ROW 1.21 COL 41.13 COLON-ALIGNED NO-LABEL
     2285        FILL-IN-17 AT ROW 1.25 COL 1.88 NO-LABEL
     2286        FILL-IN-3 AT ROW 2.25 COL 85.5 COLON-ALIGNED NO-LABEL
     2287        t-gar-1 AT ROW 3.15 COL 82.38 COLON-ALIGNED NO-LABEL
     2288        t-gar-2 AT ROW 3.75 COL 68 COLON-ALIGNED NO-LABEL
     2289        t-min-ost-1 AT ROW 4.5 COL 82.38 COLON-ALIGNED NO-LABEL WIDGET-ID 4
     2290        t-min-ost-2 AT ROW 5.1 COL 68 COLON-ALIGNED NO-LABEL WIDGET-ID 6
     2291        FILL-IN-5 AT ROW 6 COL 82 COLON-ALIGNED NO-LABEL
     2292        FILL-IN-15 AT ROW 6.25 COL 1.63 NO-LABEL
     2293        FILL-IN-13 AT ROW 6.33 COL 32.25 COLON-ALIGNED NO-LABEL
     2294        FILL-IN-7 AT ROW 6.55 COL 68 COLON-ALIGNED NO-LABEL
     2295        t-1 AT ROW 10.58 COL 2.63 COLON-ALIGNED NO-LABEL
     2296        FILL-IN-8 AT ROW 11.25 COL 77 COLON-ALIGNED NO-LABEL
     2297        FILL-IN-14 AT ROW 11.54 COL 32.5 COLON-ALIGNED NO-LABEL
     2298        t-2 AT ROW 11.67 COL 2.63 COLON-ALIGNED NO-LABEL
     2299        t-3 AT ROW 12.54 COL 2.63 COLON-ALIGNED NO-LABEL
     2300        t-4 AT ROW 13.67 COL 2.63 COLON-ALIGNED NO-LABEL
     2301        t-5 AT ROW 14.71 COL 2.63 COLON-ALIGNED NO-LABEL
     2302        t-6 AT ROW 15.67 COL 2.63 COLON-ALIGNED NO-LABEL
     2303        t-7 AT ROW 16.58 COL 2.63 COLON-ALIGNED NO-LABEL
     2304        FILL-IN-16 AT ROW 18.04 COL 1.75 NO-LABEL
     2305        tmp-sale.desc_ AT ROW 18.21 COL 11 COLON-ALIGNED NO-LABEL FORMAT "X(120)"
     2306              VIEW-AS TEXT
     2307             SIZE 59.88 BY .67
     2308             FGCOLOR 1
     2309        tmp-sale.tmp-code AT ROW 19.04 COL 11 COLON-ALIGNED NO-LABEL FORMAT "X(120)"
     2310              VIEW-AS TEXT
     2311             SIZE 59.75 BY .67
     2312        "Дополнительные условия расчета":C32 VIEW-AS TEXT
     2313             SIZE 32 BY .67 AT ROW 1.25 COL 67.25
     2314             BGCOLOR 8 FGCOLOR 4
     2315       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2316            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2317            FGCOLOR 0
     2318            CANCEL-BUTTON Btn_Cancel.
     2319   DEFINE FRAME Dialog-Frame
     2320        RECT-1 AT ROW 1.08 COL 1
     2321        RECT-3 AT ROW 6 COL 1.13
     2322        RECT-5 AT ROW 1.08 COL 42.38
     2323        RECT-6 AT ROW 1.13 COL 66.88
     2324        RECT-7 AT ROW 6 COL 33.5
     2325        RECT-8 AT ROW 11.42 COL 33.5
     2326        SPACE(21.99) SKIP(4.95)
     2327       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2328            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2329            FGCOLOR 0
     2330            TITLE "Параметры расчета заказа"
     2331            CANCEL-BUTTON Btn_Cancel.
     2332   ASSIGN
     2333          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2334          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2335   ASSIGN
     2336          B-save:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2337   ASSIGN
     2338          v-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2339   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2340   DO:
     2341     APPLY "END-ERROR":U TO SELF.
     2342   END.
     2343   ON CHOOSE OF B-1 IN FRAME Dialog-Frame
     2344   DO:
     2345     run p-calc in this-procedure ( input-output t-1 , input 1) .
     2346     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     2347   END.
     2348   ON CHOOSE OF B-10 IN FRAME Dialog-Frame
     2349   DO:
     2350        for each tt-date :
     2351            delete tt-date.
     2352      end.
     2353      assign
     2354       t-1 = false
     2355       t-2 = false
     2356       t-3 = false
     2357       t-4 = false
     2358       t-5 = false
     2359       t-6 = false
     2360       t-7 = false
     2361    .
     2362    display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2363     OPEN QUERY browse-1 FOR EACH tt-date .
     2364   END.
     2365   ON CHOOSE OF B-2 IN FRAME Dialog-Frame
     2366   DO:
     2367     run p-calc in this-procedure (input-output t-2 ,input 2) .
     2368     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2369   END.
     2370   ON CHOOSE OF B-3 IN FRAME Dialog-Frame
     2371   DO:
     2372     run p-calc in this-procedure  (input-output t-3 ,input 3) .
     2373     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2374   END.
     2375   ON CHOOSE OF B-4 IN FRAME Dialog-Frame
     2376   DO:
     2377     run p-calc in this-procedure (input-output t-4 ,input 4) .
     2378     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2379   END.
     2380   ON CHOOSE OF B-5 IN FRAME Dialog-Frame
     2381   DO:
     2382     run p-calc in this-procedure (input-output t-5 ,input 5) .
     2383     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2384   END.
     2385   ON CHOOSE OF B-6 IN FRAME Dialog-Frame
     2386   DO:
     2387     run p-calc in this-procedure (input-output t-6 ,input 6) .
     2388     display  BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7  with frame Dialog-Frame.
     2389   END.
     2390   ON CHOOSE OF B-7 IN FRAME Dialog-Frame
     2391   DO:
     2392     run p-calc in this-procedure (input-output t-7 ,input 7) .
     2393     display BROWSE-1 B-10 B-1 B-2 B-3 B-4 B-5 B-6 B-7 t-1 t-2 t-3 t-4 t-5 t-6 t-7 with frame Dialog-Frame.
     2394   END.
     2395   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     2396   DO:
     2397   apply "choose" to btn_ok  in frame Dialog-Frame .
     2398    find first buf_usr-flt  exclusive-lock  where
     2399            buf_usr-flt.user-name    = g#userid and
     2400            buf_usr-flt.call-point   = "all-ord":U   no-error .
     2401        if NOT available buf_usr-flt then  create buf_usr-flt.
     2402        find first ub.tmp-sale where recid(ub.tmp-sale) = rr  no-lock no-error .
     2403          Assign
     2404            buf_usr-flt.user-name    = g#userid
     2405            buf_usr-flt.call-point   = "all-ord":U
     2406            buf_usr-flt.list_ = "".
     2407            run remember-screen ( input-output buf_usr-flt.list_ ).
     2408   t-ret =  session:SET-WAIT-STATE("") .
     2409   END.
     2410   ON CHOOSE OF B-spis IN FRAME Dialog-Frame
     2411   DO:
     2412   define variable t-recid as recid no-undo .
     2413   define variable s-recid as character no-undo .
     2414       if r-algoritm = 6 then do:
     2415         define buffer buf_abc-analysis for ub.abc-analysis  .
     2416         define buffer buff_abc-analysis for ub.abc-analysis  .
     2417         run cus/abc-run.p (input parparentproc, output s-recid ).
     2418         if num-entries(s-recid) <> 2 THEN DO:
     2419           message "Для данного метода расчета надо выбрать 2 анализа" view-as alert-box information .
     2420           return no-apply.
     2421         END.
     2422         find first buff_abc-analysis  where recid(buff_abc-analysis) = int(entry(1,s-recid)) no-lock no-error .
     2423         if available buff_abc-analysis and not error-status :error  then do:
     2424           v-p-code = buff_abc-analysis.abc-id .
     2425           display ( buff_abc-analysis.abc-name  + " от " +  string(buff_abc-analysis.abc-date-create, "99/99/9999")) @ ub.tmp-sale.desc_
     2426                     with frame Dialog-Frame .
     2427                     v-name = "1." + ( buff_abc-analysis.abc-name + " от " + string(buff_abc-analysis.abc-date-create, "99/99/9999")) .
     2428          end.
     2429         if num-entries(s-recid) > 1 then do:
     2430             find first buf_abc-analysis  where recid(buf_abc-analysis) = int(entry(2,s-recid)) no-lock no-error .
     2431             rr = ? .
     2432             if available buf_abc-analysis and not error-status :error  then do:
     2433               display ( buf_abc-analysis.abc-name  + " от " +  string(buf_abc-analysis.abc-date-create, "99/99/9999")) @  ub.tmp-sale.tmp-code
     2434                         with frame Dialog-Frame .
     2435                         v-name = v-name + " 2." + ( buf_abc-analysis.abc-name  + " от " +  string(buf_abc-analysis.abc-date-create, "99/99/9999")) .
     2436               end.
     2437         end.
     2438     end.
     2439     else do:
     2440         run ref/tmp-sale.w
     2441           (input parparentproc
     2442           ,input "b-sel"
     2443           ,output t-recid
     2444           ).
     2445         find first ub.tmp-sale  where recid(ub.tmp-sale) = int(t-recid) no-lock no-error .
     2446         rr = t-recid.
     2447         if available  ub.tmp-sale and not error-status :error  then
     2448           display  ub.tmp-sale.tmp-code
     2449                    ub.tmp-sale.desc_
     2450                    with frame Dialog-Frame .
     2451           else do:
     2452           display "" @ ub.tmp-sale.tmp-code
     2453                   "" @ ub.tmp-sale.desc_
     2454                    with frame Dialog-Frame .
     2455           end.
     2456         end.
     2457   END.
     2458   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     2459   DO:
     2460   define variable p-code as character no-undo .
     2461   define variable p-desc as character no-undo .
     2462   define variable obj-jj as integer no-undo .
     2463   define variable Ret as logical no-undo .
     2464   define variable t-type as character no-undo .
     2465   define variable loc-sum-min as decimal no-undo .
     2466   Assign frame Dialog-Frame R-algoritm R-min-rest p-neg-sale T-gar r-min-rest3 T-min-ost T-min-zapas R-algoritm2 T-DeadLine date-p-1 date-p-2 t-way T-clos T-rcv t-rv t-rvc t-rvz T-rvzc T-sppv-4 T-sp T-sppv-2 t-sppv-3 v-round-m p-prt-art FILL-IN-2 FILL-IN-17 FILL-IN-3 t-gar-1 t-gar-2 t-min-ost-1 t-min-ost-2 FILL-IN-5 FILL-IN-15 FILL-IN-13 FILL-IN-7 FILL-IN-8 FILL-IN-16  no-error .
     2467   Assign frame Dialog-Frame v-round-base no-error .
     2468   if date-p-1 <> ? and date-p-2 <> ? then do:
     2469      if date-p-1 >  date-p-2 then do:
     2470                                    message "Не верно задан интервал дат для расчета объема продаж !"
     2471                                    view-as alert-box information.
     2472                                    return no-apply .
     2473                                   end.
     2474   end.
     2475   if (t-rv      = false  and
     2476       t-rvz     = false  and
     2477       t-rvc     = false  and
     2478       t-rvzc    = false  and
     2479       t-sp      = false  and
     2480       t-sppv-2  = false  and
     2481       t-sppv-3  = false  and
     2482       t-sppv-4  = false ) and
     2483       ( R-algoritm <> 2  and R-algoritm <> 6  and  R-algoritm <> 5)  then do:
     2484        message  " Не выбран ни один тип документа, по которым рассчитывается объем продаж !"
     2485        view-as alert-box information.
     2486        return no-apply .
     2487   end.
     2488   if v-round-m = 'Кол-во_в_коробке':U then do:
     2489      for each  tmp#zakaz :
     2490          if tmp#zakaz.cli-base-rate <> 1 then do:
     2491           message
     2492           substitute("При методе округления до числа в упаковке не учитывается ед.измерения Поставщика.
     2493           &3Измените ед.изм. поставщика в заказе у товара &3артикул &1 код &2  &3на &4"
     2494             , tmp#zakaz.artic, tmp#zakaz.gds-code, chr(10) , tmp#zakaz.unit-base)
     2495             view-as alert-box information.
     2496             return no-apply.
     2497          end.
     2498      end.
     2499   end.
     2500   if t-way:visible = false then t-way = false .
     2501   if t-way = false then
     2502   assign
     2503     t-clos  = false
     2504     t-rcv   = false
     2505   .
     2506   if NOT ( t-way = true and  ( t-clos  = true  or  t-rcv  = true  )
     2507            or
     2508            t-way = false )
     2509   then do:
     2510   message "При учете предыдущих заказов надо выбрать хотя бы один статус !"
     2511     view-as alert-box information.
     2512      return no-apply.
     2513   end.
     2514   if t-way:visible = false then t-way = false .
     2515   if R-algoritm2 = 3 and R-algoritm2:visible  and not can-find (  first  tt-date  )  then do:
     2516   message "При календарном методе расчета должна быть заполнена таблица - даты"
     2517     view-as alert-box information.
     2518   return no-apply.
     2519   end.
     2520   if  R-algoritm = 2 then do:
     2521   if not available ub.tmp-sale then
     2522      find ub.tmp-sale  where recid(ub.tmp-sale) = rr no-lock no-error  .
     2523       if available ub.tmp-sale then
     2524           assign
     2525               p-code = ub.tmp-sale.tmp-code
     2526               p-desc = ub.tmp-sale.desc_
     2527               .
     2528   end.
     2529   if  R-algoritm = 2  and ( ub.tmp-sale.tmp-code:screen-value in frame Dialog-Frame = ? OR ub.tmp-sale.tmp-code:screen-value in frame Dialog-Frame = "" ) then do:
     2530       message "Не выбран список темпов продаж!!!"
     2531       view-as alert-box information.
     2532       return no-apply.
     2533   end.
     2534   if  R-algoritm = 6  then do:
     2535       assign
     2536           p-code = ?
     2537           p-desc = v-name
     2538       .
     2539   end.
     2540   if v-mode <> "all-ord":U then dO:
     2541      run ord-mm in this-procedure .
     2542   end.
     2543   e-method =  FILL-IN-17 + " : " + entry(R-algoritm * 2 - 1 , R-algoritm:RADIO-BUTTONS)   +
     2544              (  if R-algoritm = 2 or R-algoritm = 6 then ( " : " +  p-desc   + chr(10)) else "" ) +  ";" .
     2545   if R-algoritm <> 2  and R-algoritm <> 5 and  R-algoritm <> 6 then
     2546   e-method =  e-method  +  FILL-IN-15 + " : " + entry(R-algoritm2 * 2 - 1 , R-algoritm2:RADIO-BUTTONS) +  ";" + chr(10) +
     2547              (  if date-p-1 <> ? and R-algoritm <> 2 and R-algoritm <> 6 and R-algoritm <> 5 then "c  "  + string(date-p-1,"99/99/9999") else " " ) +
     2548              (  if date-p-2 <> ? and R-algoritm <> 2 and R-algoritm <> 6 and R-algoritm <> 5 then " по " + string(date-p-2,"99/99/9999") else " " ) +  ";" +  chr(10) +
     2549              (  if t-1 then " " + b-1:label   else "" ) +
     2550              (  if t-2 then " " + b-2:label   else "" ) +
     2551              (  if t-3 then " " + b-3:label   else "" ) +
     2552              (  if t-4 then " " + b-4:label   else "" ) +
     2553              (  if t-5 then " " + b-5:label   else "" ) +
     2554              (  if t-6 then " " + b-6:label   else "" ) +
     2555              (  if t-7 then " " + b-7:label   else "" ) .
     2556   e-method =  e-method  +      ";" +  chr(10) +
     2557              FILL-IN-2 + " : " + entry(R-min-rest * 2 - 1 , R-min-rest:RADIO-BUTTONS)  .
     2558    e-method = e-method +   chr(10) +
     2559            ( if  r-min-rest3    then  " : " + r-min-rest3:label  else "" ) + ";" .
     2560    e-method = e-method +   chr(10)   +
     2561            ( if  FILL-IN-14:visible             then  FILL-IN-14 + " : "     else "" ) +
     2562            ( if  t-rv     and t-rv:visible      then  " " + t-rv  :label     else "" ) +
     2563            ( if  t-rvz    and t-rvz:visible     then  " " + t-rvz :label     else "" ) +
     2564            ( if  t-rvc    and t-rvc:visible     then  " " + t-rvc :label     else "" ) +
     2565            ( if  t-rvzc   and t-rvzc:visible    then  " " + t-rvzc:label     else "" ) +
     2566            ( if  t-sp     and t-sp:visible      then  " " + t-sp  :label     else "" ) +
     2567            ( if  t-sppv-2 and t-sppv-2:visible  then  " " + t-sppv-2:label   else "" ) +
     2568            ( if  t-sppv-3 and t-sppv-3:visible  then  " " + t-sppv-3:label   else "" ) +
     2569            ( if  t-sppv-4 and t-sppv-4:visible  then  " " + t-sppv-4:label   else "" )
     2570              .
     2571    e-method = e-method +   chr(10) +
     2572            ( if  t-way    and t-way:visible   then  " " + t-way  :label + " : "    else "" ) +
     2573            ( if  t-rcv    and t-rcv:visible   then  " " + t-rcv  :label            else "" ) +
     2574            ( if  t-clos   and t-clos:visible  then  " " + t-clos :label            else "" ) + ";"
     2575            .
     2576    e-method = e-method +   chr(10) +
     2577            ( if  p-neg-sale  and  p-neg-sale:visible   then  " " + p-neg-sale  :tooltip + " : "    else "" ) +
     2578            ( if  t-gar       and  t-gar:visible        then  " " + t-gar  :tooltip            else "" ) +
     2579            ( if  t-min-ost   and  t-min-ost:visible    then  " " + t-min-ost  :tooltip + " : "    else "" ) +
     2580            ( if  t-DeadLine  and  t-DeadLine:visible    then  " " + t-DeadLine :tooltip + " : "    else "" ) +
     2581            ( if  t-min-zapas and  t-min-zapas:visible  then  " " + t-min-zapas :tooltip            else "" ) + ";"
     2582            .
     2583    e-method = e-method +  chr(10) + "Объекты :&"  .
     2584             for each obj-list :
     2585                     e-method = e-method +  obj-list.obj-type + " " + string(obj-list.obj-code) + ","    .
     2586             end.
     2587    if v-mode <> "all-ord":U then dO:
     2588         find first buf_usr-flt  exclusive-lock  where
     2589                 buf_usr-flt.user-name    = loc-ord-num and
     2590                 buf_usr-flt.call-point   = "ord-m":U + ( if v-mode <> ? then v-mode else "" )  no-error .
     2591             if NOT available buf_usr-flt then  create buf_usr-flt.
     2592             find first ub.tmp-sale where recid(ub.tmp-sale) = rr  no-lock no-error .
     2593               Assign
     2594                 buf_usr-flt.user-name    = loc-ord-num
     2595                 buf_usr-flt.call-point   = "ord-m":U + ( if v-mode <> ? then v-mode else "" )
     2596                 buf_usr-flt.list_ = "".
     2597                 run remember-screen ( input-output buf_usr-flt.list_ ).
     2598         find first buf_usr-flt  exclusive-lock  where
     2599                 buf_usr-flt.user-name    = g#userid and
     2600                 buf_usr-flt.call-point   = "ord-m":U  no-error .
     2601             if NOT available buf_usr-flt then  create buf_usr-flt.
     2602               Assign
     2603                 buf_usr-flt.user-name    = g#userid
     2604                 buf_usr-flt.call-point   = "ord-m":U
     2605                 buf_usr-flt.list_ = "".
     2606                 run remember-screen ( input-output buf_usr-flt.list_ ).
     2607         t-ret =  session:SET-WAIT-STATE("GENERAL") .
     2608             for each obj-list :
     2609               obj-jj = obj-jj + 1.
     2610             end.
     2611             if g#type = 'ФП':U and R-min-rest = 1 then  do:
     2612                if R-algoritm = 6  then do:
     2613                   run cus/qnty-obj.p
     2614                   (     input parParentProc,
     2615                         input v-round-m ,
     2616                         input v-round-base ,
     2617                         input e-method ,
     2618                         input v-mode,
     2619                         input loc-ord-num ,
     2620                         input date-p-1,
     2621                         input date-p-2,
     2622                         input "calc":U,
     2623                         input no,
     2624                         input 2  ,
     2625                         input R-algoritm2,
     2626                         input R-min-rest ,
     2627                         input R-min-rest3,
     2628                         input p-code     ,
