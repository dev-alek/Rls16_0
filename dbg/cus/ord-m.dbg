     1829       ) no-error .
     1830     if error-status :error
     1831     then do:
     1832       undo, return error return-value .
     1833     end.
     1834   end.
     1835   end procedure.
     1836   procedure thbjattr_delete-section :
     1837   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
     1838   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
     1839   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
     1840   do
     1841   on error undo, return error return-value
     1842   :
     1843       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
     1844       (input  p-obj-type
     1845       ,input  p-obj-code
     1846       ,input  p-upper-code
     1847       ) no-error .
     1848     if error-status :error
     1849     then do:
     1850       undo, return error return-value .
     1851     end.
     1852   end.
     1853   end procedure.
     1854   procedure thbjattr_manual-edit :
     1855   define input  parameter p-ucode          as character no-undo .
     1856   define input  parameter p-code           as character no-undo .
     1857   define output parameter p-section-num    as integer no-undo .
     1858   do
     1859   on error undo, return error return-value
     1860   :
     1861       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
     1862       (input  p-ucode
     1863       ,input  p-code
     1864       ,output  p-section-num
     1865       ) no-error .
     1866     if error-status :error
     1867     then do:
     1868       undo, return error return-value .
     1869     end.
     1870   end.
     1871   end procedure.
