      352                                      ub.ord-chain.doc-type = 'rcv'                  and
      353                                      ub.ord-chain.rel-doc-type = 'trn'
      354                                      :
      355                               for each  t-trn-line where t-trn-line.doc-code  = ub.ord-chain.rel-doc-code and
      356                                                          t-trn-line.artic     = t-ord-line-rcv.artic        and
      357                                                          t-trn-line.prod-type = t-ord-line-rcv.prod-type    and
      358                                                          t-trn-line.prod-code = t-ord-line-rcv.prod-code
      359                                                          no-lock  ,
      360                                        first  t-trn-doc where    t-trn-doc.doc-code  = t-trn-line.doc-code
      361                                                           and (  t-trn-doc.status_   = 'факт':U ) no-lock  :
      362                                   sum-trn = sum-trn + t-trn-line.fact-qnty.
      363                               end.
      364                             end.
      365                     sum-rcv = sum-rcv + t-ord-line-rcv.qnty .
      366                   end.
      367                   sum-ord = sum-ord + t-ord-line.qnty.
      368                   run calc-rcv-in in this-procedure (
      369                       input t-ord-line.artic    ,
      370                       input t-ord-line.prod-type,
      371                       input t-ord-line.prod-code,
      372                       output sum-rcv-in ,
      373                       output sum-trn-in   ) no-error .
      374                   sum-rcv = sum-rcv  + sum-rcv-in.
      375                   sum-trn = sum-trn  + sum-trn-in.
      376                end.
      377              end.
      378               if  sum-rcv > sum-trn then do:
      379                   message "СЗФП  " t-ord-cons.cons-code " не покрыт ПН полностью ! Закрыть в статус (ФАКТ-) ? " skip
      380                     "Поставок " sum-rcv              skip
      381                     "из них Внутренних "  sum-rcv-in skip
      382                     "Накладных" sum-trn              skip
      383                     view-as alert-box question
      384                     buttons yes-no
      385                     title "Закрыть СЗФП"
      386                     update g#log
      387                   .
      388                   if not g#log then return.
      389                   t-ord-cons.flag_ = false .
      390               end.
      391               if  sum-rcv =  sum-trn then do:
      392                   t-ord-cons.flag_ = true  .
      393               end.
      394               if  sum-rcv <  sum-trn then do:
      395                   message "На СЗФП  " t-ord-cons.cons-code " превышено количество по ПН ! Закрыть в статус (ФАКТ+) ? "
      396                     "Поставок " sum-rcv  skip
      397                     "Накладных" sum-trn
      398                     view-as alert-box question
      399                     buttons yes-no
      400                     title "Закрыть СЗФП"
      401                     update g#log
      402                   .
      403                   if not g#log then return.
      404                   t-ord-cons.flag_ = true  .
      405               end.
      406               assign
      407                      t-ord-cons.status_ = 'факт':U
      408                      t-ord-cons.fact-date = to-day.
      409                 .
      410                if old-flag_ = false then t-ord-cons.flag_ = false  .
      411                if can-find (first t-ord-doc-rcv where t-ord-doc-rcv.cons-code = t-ord-cons.cons-code and t-ord-doc-rcv.flag_ = false no-lock )
      412                   then t-ord-cons.flag_ = false  .
      413              for each t-ord-doc where t-ord-doc.cons-code     = t-ord-cons.cons-code
      414                                 and  t-ord-doc.doc-type = 'ОФ':U
      415                                 and not ( t-ord-doc.status_ = 'отказ':U   OR
      416                                           t-ord-doc.status_ = 'факт':U)
      417                                  exclusive-lock   :
      418                sum-ord = 0.
      419                sum-rcv = 0.
      420                sum-trn = 0.
      421                for each t-ord-line       where t-ord-line.doc-code     = t-ord-doc.doc-code  no-lock :
      422                     for each  t-ord-doc-rcv where  t-ord-doc-rcv.obj-code  = t-ord-doc.obj-code
      423                               and t-ord-doc-rcv.obj-type  = t-ord-doc.obj-type
      424                               and t-ord-doc-rcv.cons-code = t-ord-doc.cons-code
      425                               exclusive-lock   ,
      426                        each t-ord-line-rcv where
      427                             t-ord-line-rcv.doc-code   = t-ord-doc-rcv.doc-code and
      428                             t-ord-line-rcv.rcv-code   = t-ord-doc-rcv.rcv-code and
      429                             t-ord-line-rcv.artic      = t-ord-line.artic       and
      430                             t-ord-line-rcv.prod-type  = t-ord-line.prod-type   and
      431                             t-ord-line-rcv.prod-code  = t-ord-line.prod-code   no-lock :
      432                               sum-rcv = sum-rcv + t-ord-line-rcv.qnty.
      433                             for each ub.ord-chain no-lock where
      434                                      ub.ord-chain.doc-code = t-ord-doc-rcv.rcv-code and
      435                                      ub.ord-chain.doc-type = 'rcv'                  and
      436                                      ub.ord-chain.rel-doc-type = 'trn'
      437                                      :
      438                                       for each  t-trn-line where t-trn-line.doc-code  = ub.ord-chain.rel-doc-code and
      439                                                           t-trn-line.artic     = t-ord-line-rcv.artic         and
      440                                                           t-trn-line.prod-type = t-ord-line-rcv.prod-type     and
      441                                                           t-trn-line.prod-code = t-ord-line-rcv.prod-code
      442                                                           no-lock ,
      443                                       first  t-trn-doc where  t-trn-doc.doc-code = t-trn-line.doc-code
      444                                                         and  t-trn-doc.status_  = 'факт':U  no-lock :
      445                                           sum-trn = sum-trn + t-trn-line.fact-qnty.
      446                                       end.
      447                               end.
      448                           if t-ord-doc-rcv.status_ <> 'факт':U then do:
      449                               t-ord-doc-rcv.status_ = 'факт':U.
      450                               if  sum-rcv > sum-trn  or  ( sum-rcv = sum-trn  and  sum-trn = 0 )  then  t-ord-doc-rcv.flag_ = false .
      451                                                     else  t-ord-doc-rcv.flag_ = true  .
      452                               if not g#news then do:  run str/callnews.p     (input "ord-doc-rcv"      ,input (buffer t-ord-doc-rcv:handle)     ) no-error .        if error-status:error then do:     assign t-ord-doc-rcv.flag_ = old-flag  t-ord-doc-rcv.status_ = old-state .     message                                                      vss-workfile vss-revision vss-description skip             "Ошибка при передаче СЗФП (ord-doc-rcv) в новости" skip                  "Возвращает процедура callnews.p" skip                                   " - " error-status :get-message(1) skip                                  "Документ" t-ord-doc-rcv.rcv-code (t-ord-doc-rcv.doc-code) skip          view-as alert-box error .                                  return no-apply.                                       end. end.
      453                           end.
      454                     end.
      455                     sum-ord = sum-ord + t-ord-line.qnty.
      456                   run calc-rcv-in in this-procedure (
      457                       input t-ord-line.artic    ,
      458                       input t-ord-line.prod-type,
      459                       input t-ord-line.prod-code,
      460                       output sum-rcv-in ,
      461                       output sum-trn-in   ) no-error .
      462                   sum-rcv = sum-rcv  + sum-rcv-in.
      463                   sum-trn = sum-trn  + sum-trn-in.
      464                end.
      465               t-ord-doc.status_ = 'факт':U.
      466               if  sum-rcv > sum-trn  or  ( sum-rcv = sum-trn  and  sum-trn = 0 )  then  t-ord-doc.flag_ = false .
      467                                     else  t-ord-doc.flag_ = true  .
      468               if t-ord-cons.flag_ = true then  t-ord-doc.flag_ = true  .
      469               if not g#news then do:  run str/callnews.p     (input "ord-doc"      ,input (buffer t-ord-doc:handle)     ) no-error .        if error-status:error then do:     assign t-ord-doc.flag_ = old-flag  t-ord-doc.status_ = old-state .     message                                                      vss-workfile vss-revision vss-description skip             "Ошибка при передаче СЗФП (ord-doc) в новости" skip        "Возвращает процедура callnews.p" skip                      " - " error-status :get-message(1) skip                   "Документ" t-ord-doc.doc-code skip                         view-as alert-box error.                                   return no-apply.                                       end. end.
      470              end.
      471          if not g#news then do:  run str/callnews.p     (input "ord-cons"      ,input (buffer t-ord-cons:handle)     ) no-error .        if error-status:error then do:     assign t-ord-cons.flag_ = old-flag  t-ord-cons.status_ = old-state .     message                                                       vss-workfile vss-revision vss-description skip              "Ошибка при передаче СЗФП (ord-cons) в новости" skip        "Возвращает процедура callnews.p" skip                       " - "    error-status :get-message(1) skip                 "Документ" t-ord-cons.cons-code skip                        view-as alert-box error .                                   return no-apply.                                        end. end.
      472         end.
      473    end case.
      474    end.
      475   procedure calc-rcv-in :
      476   do
      477   on error undo, return error return-value
      478   :
      479   define buffer locb-ord-doc  for ub.ord-doc .
      480   define buffer locb-ord-line for ub.ord-line .
      481   define buffer locb-ord-dtl  for ub.ord-dtl .
      482   define buffer locb-rcv-doc  for ub.ord-doc-rcv .
      483   define buffer locb-rcv-line for ub.ord-line-rcv .
      484   define buffer locb-rcv-dtl  for ub.ord-dtl-rcv .
      485   define buffer locb-z-doc    for ub.ord-doc .
      486   define buffer locb-z-line   for ub.ord-line .
      487   define buffer locb-z-dtl    for ub.ord-dtl .
      488   define buffer locb-t-doc    for ub.trn-doc .
      489   define buffer locb-t-line   for ub.doc-line .
      490   define buffer locb-t-dtl    for ub.gds-dtl  .
      491   define input parameter p-artic     like ub.goods.artic     no-undo .
      492   define input parameter p-prod-type like ub.goods.prod-type no-undo .
      493   define input parameter p-prod-code like ub.goods.prod-code no-undo .
      494   define output parameter l-sum-rcv-in as decimal no-undo .
      495   define output parameter l-sum-trn-in as decimal no-undo .
      496   l-sum-trn-in  = 0 .
      497   l-sum-rcv-in  = 0 .
      498     for each  locb-z-doc no-lock where
      499                                 locb-z-doc.cons-code = t-ord-cons.cons-code   and
      500                                 locb-z-doc.doc-type  = 'ОФ':U
      501                                 ,
      502         each locb-z-line no-lock where
      503                                   locb-z-doc.doc-code = locb-z-line.doc-code    and
      504                                   p-artic        = locb-z-line.artic     and
      505                                   p-prod-code    = locb-z-line.prod-code and
      506                                   p-prod-type    = locb-z-line.prod-type
      507                                   ,
      508         each  locb-rcv-doc no-lock where
      509                                 locb-rcv-doc.cons-code = t-ord-cons.cons-code   and
      510                                 locb-rcv-doc.doc-type  = "in":U              and
      511                                 locb-rcv-doc.obj-code  = locb-z-doc.obj-code and
      512                                 locb-rcv-doc.obj-type  = locb-z-doc.obj-type
      513                                 ,
      514         each locb-rcv-line no-lock  where
      515                                   locb-rcv-doc.doc-code = locb-rcv-line.doc-code  and
      516                                   locb-rcv-doc.rcv-code = locb-rcv-line.rcv-code  and
      517                                   p-artic        = locb-rcv-line.artic     and
      518                                   p-prod-code    = locb-rcv-line.prod-code and
      519                                   p-prod-type    = locb-rcv-line.prod-type
      520                                   :
      521       assign
      522         l-sum-rcv-in  = l-sum-rcv-in + locb-rcv-line.qnty
      523       .
      524       for each ub.ord-chain no-lock where
      525                ub.ord-chain.doc-code =  locb-rcv-doc.rcv-code and
      526                ub.ord-chain.doc-type = 'rcv'                  and
      527                ub.ord-chain.rel-doc-type = 'trn'
      528                :
      529                 for each  locb-t-line where
      530                           locb-t-line.doc-code     = ub.ord-chain.rel-doc-code   and
      531                           locb-t-line.artic        = locb-rcv-line.artic     and
      532                           locb-t-line.prod-code    = locb-rcv-line.prod-code and
      533                           locb-t-line.prod-type    = locb-rcv-line.prod-type
      534                           :
      535                   assign
      536                     l-sum-trn-in  = l-sum-trn-in + locb-t-line.fact-qnty
      537                   .
      538          end.
      539          end.
      540     end.
      541     for each  locb-z-doc no-lock where
      542               locb-z-doc.cons-code = t-ord-cons.cons-code   and
      543               locb-z-doc.doc-type  = 'ОФ':U
      544               ,
      545         each locb-z-line no-lock where
      546             locb-z-doc.doc-code = locb-z-line.doc-code    and
      547             p-artic        = locb-z-line.artic     and
      548             p-prod-code    = locb-z-line.prod-code and
      549             p-prod-type    = locb-z-line.prod-type
      550             ,
      551         each  locb-rcv-doc no-lock where
      552               locb-rcv-doc.cons-code = t-ord-cons.cons-code   and
      553               locb-rcv-doc.doc-type  = "in":U              and
      554               locb-rcv-doc.cli-code  = locb-z-doc.obj-code and
      555               locb-rcv-doc.cli-type  = locb-z-doc.obj-type
      556               ,
      557         each locb-rcv-line no-lock  where
      558              locb-rcv-doc.doc-code = locb-rcv-line.doc-code  and
      559              locb-rcv-doc.rcv-code = locb-rcv-line.rcv-code  and
      560              p-artic        = locb-rcv-line.artic     and
      561              p-prod-code    = locb-rcv-line.prod-code and
      562              p-prod-type    = locb-rcv-line.prod-type
      563             :
      564       assign
      565         l-sum-rcv-in  = l-sum-rcv-in - locb-rcv-line.qnty
      566       .
      567       for each ub.ord-chain no-lock where
      568                ub.ord-chain.doc-code =  locb-rcv-doc.rcv-code and
      569                ub.ord-chain.doc-type = 'rcv'                  and
      570                ub.ord-chain.rel-doc-type = 'trn'
      571                :
      572          for each  locb-t-line where
      573                    locb-t-line.doc-code     = ub.ord-chain.rel-doc-code and
      574                    locb-t-line.artic        = locb-rcv-line.artic     and
      575                    locb-t-line.prod-code    = locb-rcv-line.prod-code and
      576                    locb-t-line.prod-type    = locb-rcv-line.prod-type
      577                   :
      578               assign
      579                 l-sum-trn-in  = l-sum-trn-in + locb-t-line.fact-qnty
      580               .
      581          end.
      582        end.
      583     end.
      584   end.
      585   end procedure.
