      178                             ", закрыть СЗФП до статуса ЗАКРЫТО невозможно ! Закройте заказ ФП " t-ord-doc.doc-code
      179                             "до статуса ЗАКРЫТО " view-as alert-box error Title "Закрытие СЗФП" .
      180                     return.
      181               end.
      182               for each t-ord-doc-rcv where  t-ord-doc-rcv.cons-code     = t-ord-cons.cons-code
      183                                                  and NOT ( t-ord-doc-rcv.status_   = 'поставка':U
      184                                                      or t-ord-doc-rcv.status_   = 'запрос':U
      185                                                      OR  t-ord-doc-rcv.status_   = 'факт':U ) no-lock :
      186                     message "Поставка " t-ord-doc-rcv.rcv-code " имеет статус " CAPS(t-ord-doc-rcv.status_)
