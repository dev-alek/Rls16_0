      192                                           and  t-ord-doc.doc-type = 'ФП':U
      193                                           and ( t-ord-doc.status_ = 'закрыто':U   OR
      194                                                 t-ord-doc.status_ = 'факт':U)
      195                                            no-lock   :
      196                for each t-ord-line        where t-ord-line.doc-code     = t-ord-doc.doc-code  no-lock :
      197                  for each  t-ord-line-rcv where t-ord-line-rcv.doc-code = t-ord-line.doc-code and
