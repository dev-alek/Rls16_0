      201                           first  t-ord-doc-rcv where  t-ord-line-rcv.doc-code  = t-ord-doc-rcv.doc-code
      202                                                  and  t-ord-line-rcv.rcv-code  = t-ord-doc-rcv.rcv-code
      203                                                  and ( t-ord-doc-rcv.status_   = 'поставка':U
      204                                                  OR  t-ord-doc-rcv.status_   = 'факт':U )
      205                           no-lock :
      206                     sum-rcv = sum-rcv + t-ord-line-rcv.qnty.
      207                   end.
      208                   sum-ord = sum-ord + t-ord-line.qnty.
      209                end.
      210               run calc-rcv-in in this-procedure (
