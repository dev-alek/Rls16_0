      161           end.
      162          when 'распределение':U then do :
      163               message "Закрывать СЗФП до статуса " caps('закрыто':U) " ?"
      164                       view-as alert-box question
      165                       button yes-no  update v-ok
      166                       .
      167               if v-ok = false then return.
      168            assign
      169              sum-ord = 0
      170              sum-rcv = 0
      171             .
      172              for each t-ord-doc           where
      173                                                (t-ord-doc.cons-code     = t-ord-cons.cons-code  and  t-ord-doc.doc-type = 'ФП':U)
