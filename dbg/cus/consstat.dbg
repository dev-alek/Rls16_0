      264                               and t-ord-doc-rcv.cons-code = t-ord-doc.cons-code
      265                               no-lock ,
      266                        each t-ord-line-rcv where t-ord-line-rcv.doc-code = t-ord-doc-rcv.doc-code and
      267                             t-ord-line-rcv.rcv-code   = t-ord-doc-rcv.rcv-code  and
      268                             t-ord-line-rcv.artic      = t-ord-line.artic       and
      269                             t-ord-line-rcv.prod-type  = t-ord-line.prod-type   and
      270                             t-ord-line-rcv.prod-code  = t-ord-line.prod-code   no-lock :
      271                             sum-rcv = sum-rcv + t-ord-line-rcv.qnty .
      272                     end.
      273                   sum-ord = sum-ord + t-ord-line.qnty.
      274                   run calc-rcv-in in this-procedure (
