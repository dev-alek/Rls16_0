        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: edocrok.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: cus/edocrok.p $":U .
        8   define variable vss-description as character no-undo init "Процедура приема ответов и прописания статусов EDOC-nn".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure gen-key-rec :
       80     define input  parameter p-tbl-name    as character no-undo.
       81     define input  parameter p-bh_tbl-name as handle    no-undo.
       82     define output parameter p-key-rec     as character no-undo.
       83     do
       84     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       85     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       86     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       87     :
       88       define variable fh               as handle    no-undo .
       89       define variable v-ok             as logical   no-undo .
       90       define variable v-inform         as character no-undo .
       91       define variable v-ind            as integer   no-undo .
       92       define variable v-idx-field-qnty as integer   no-undo .
       93       if p-tbl-name = ?
       94         or p-tbl-name = "":U
       95       then do:
       96         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       97       end.
       98       if not p-bh_tbl-name:available then do:
       99         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      100       end.
      101       assign
      102         p-key-rec = p-tbl-name
      103         v-inform  = p-bh_tbl-name:index-information(1)
      104         v-ind     = 2
      105       .
      106       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      107       on error undo, return error
      108       :
      109         assign
      110           v-inform = p-bh_tbl-name:index-information( v-ind )
      111           v-ind    = v-ind + 1
      112         .
      113       end.
      114       if v-inform = ?
      115         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      116         or entry( 3, v-inform, ",":U ) <> "1":U
      117       then do:
      118         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      119       end.
      120       else do:
      121         assign
      122           v-idx-field-qnty = num-entries( v-inform ) - 4
      123         .
      124         if v-idx-field-qnty < 2 then do:
      125           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      126         end.
      127         do v-ind = 1 to v-idx-field-qnty by 2
      128         on error undo, return error
      129         :
      130           assign
      131             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      132             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      133           .
      134         end.
      135       end.
      136       if p-key-rec = ? then do:
      137         assign
      138           p-key-rec = "":U
      139         .
      140         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      141       end.
      142     end.
      143     return.
      144   end procedure.
      145   procedure gen-where-keyr-tab :
      146     define input  parameter i-tableSerach as character no-undo.
      147     define input  parameter i-tablekey   as character  no-undo.
      148     define input  parameter p-key-rec    as character  no-undo.
      149     define input  parameter p-key-handle as handle     no-undo .
      150     define input  parameter p-db-name    as character  no-undo .
      151     define input  parameter p-tt-handle  as handle     no-undo .
      152     define output parameter o-Where      as character  no-undo.
      153     do
      154     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      155     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      156     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      157     :
      158       define variable v-full-tbl-name  as character no-undo .
      159       define variable bh_tbl-name      as handle    no-undo .
      160       define variable fh_key           as handle    no-undo .
      161       define variable fh_search        as handle    no-undo .
      162       define variable v-field-num      as integer   no-undo .
      163       define variable v-count-fld      as integer   no-undo .
      164       define variable v-inform         as character no-undo .
      165       define variable v-ind            as integer   no-undo .
      166       define variable v-idx-field-qnty as integer   no-undo .
      167       define variable v-field-name     as character no-undo .
      168       define variable v-field-val      as character no-undo .
      169       define variable v-word-link      as character no-undo .
      170       define variable vTable           as character no-undo.
      171       define variable bh_tbl-key       as handle    no-undo .
      172       assign
      173         p-key-rec = trim( p-key-rec )
      174       .
      175       if p-key-handle <> ? then do:
      176         if not valid-handle(p-key-handle)
      177            or p-key-handle:type <> "buffer"
      178         then do:
      179           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      180         end.
      181         if num-entries( p-key-rec, chr(3) ) > 1
      182           or p-key-rec = ?
      183           or p-key-rec = "":U
      184         then do:
      185           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      186         end.
      187       end.
      188       else do:
      189         if p-key-rec = ?
      190           or p-key-rec = "":U
      191         then do:
      192           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      193         end.
      194       end.
      195       assign
      196         vTable = entry( 1 , p-key-rec, chr(3) )
      197       .
      198       if p-tt-handle <> ?
      199         and ( not valid-handle(p-tt-handle)
      200               or p-tt-handle:type <> "buffer"
      201             )
      202       then do:
      203         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      204       end.
      205       if p-tt-handle = ? then do:
      206         assign
      207           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      208         .
      209         create buffer bh_tbl-name for table v-full-tbl-name .
      210       end.
      211       else do:
      212         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      213       end.
      214       assign
      215         v-inform = bh_tbl-name:index-information(1)
      216         v-ind    = 2
      217       .
      218       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      219       on error undo, return error
      220       :
      221         assign
      222           v-inform = bh_tbl-name:index-information( v-ind )
      223           v-ind    = v-ind + 1
      224         .
      225       end.
      226       if v-inform = ?
      227         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      228         or entry( 3, v-inform, ",":U ) <> "1":U
      229       then do:
      230         delete object bh_tbl-name no-error.
      231         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      232       end.
      233       assign
      234         v-idx-field-qnty = num-entries( v-inform ) - 4
      235       .
      236       if v-idx-field-qnty < 2 then do:
      237         delete object bh_tbl-name no-error.
      238         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      239       end.
      240       assign
      241         o-where     = "where":U
      242         v-word-link = "":U
      243         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      244         v-count-fld = 0
      245       .
      246       if i-tablekey ne "" and i-tablekey ne ?
      247       then do:
      248         assign
      249           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      250         .
      251         create buffer bh_tbl-key for table v-full-tbl-name .
      252       end.
      253       if i-tableSerach ne "" and i-tableSerach ne ?
      254       then do:
      255         delete object bh_tbl-name no-error.
      256         assign
      257           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      258         .
      259         create buffer bh_tbl-name for table v-full-tbl-name .
      260       end.
      261       block_where:
      262       do v-ind = 1 to v-idx-field-qnty by 2
      263       on error undo, return error
      264       :
      265         assign
      266           v-count-fld = v-count-fld + 1
      267         .
      268         if p-key-handle = ?
      269           and v-count-fld > v-field-num
      270         then do:
      271           leave block_where.
      272         end.
      273         define variable VfieldKeyTable as handle no-undo.
      274         assign
      275           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      276           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      277         .
      278         if     bh_tbl-key ne ?
      279         then do:
      280            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      281            if VfieldKeyTable eq ?
      282            then next block_where.
      283         end.
      284         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      285         then
      286            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      287         else
      288            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      289         if p-key-handle = ? then do:
      290           assign
      291             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      292           .
      293         end.
      294         else do:
      295           assign
      296             fh_key = p-key-handle:buffer-field( v-field-name )
      297           .
      298           if fh_key = ?
      299             or not valid-handle( fh_key )
      300           then do:
      301             delete object bh_tbl-name.
      302             if     bh_tbl-key ne ?
      303             then
      304                delete object bh_tbl-key.
      305             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      306           end.
      307           assign
      308             v-field-val = fh_key:buffer-value
      309           .
      310         end.
      311         if fh_search:data-type ="character":U then do:
      312           assign
      313             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      314             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      315             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      316             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      317             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      318             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      319             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      320             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      321             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      322             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      323             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      324             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      325             v-field-val = substitute( '"&1"', v-field-val )
      326           .
      327         end.
      328         assign
      329           o-where = substitute( "&1 &2", o-where, v-field-val )
      330         .
      331         if v-word-link = "":U then do:
      332           assign
      333             v-word-link = "and":U
      334           .
      335         end.
      336       end.
      337       delete object bh_tbl-name.
      338       if     bh_tbl-key ne ?
      339       then
      340          delete object bh_tbl-key.
      341       if p-key-handle = ?
      342         and v-count-fld <> v-field-num
      343       then do:
      344         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      345       end.
      346     end.
      347   end procedure.
      348   procedure gen-hn-keyr-tab :
      349     define input  parameter i-tableSerach as character no-undo.
      350     define input  parameter i-tablekey   as character no-undo.
      351     define input  parameter p-key-rec    as character no-undo.
      352     define input  parameter p-key-handle as handle    no-undo .
      353     define input  parameter p-db-name    as character no-undo .
      354     define input  parameter p-tt-handle  as handle    no-undo .
      355     define input  parameter p-stts-lock  as integer   no-undo .
      356     define output parameter o-hn         as handle    no-undo.
      357     define variable v-full-tbl-name as character no-undo.
      358     define variable v-where         as character no-undo.
      359     define variable bh_tbl-name     as handle    no-undo.
      360     define variable vTable          as character no-undo.
      361     do
      362     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      363     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      364     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      365         run gen-where-keyr-tab(i-tableSerach,
      366                                i-tablekey,
      367                                p-key-rec,
      368                                p-key-handle,
      369                                p-db-name,
      370                                p-tt-handle,
      371                                output v-where).
      372         if i-tableSerach ne "" and i-tableSerach ne ?
      373         then do:
      374            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      375            create buffer bh_tbl-name for table v-full-tbl-name .
      376         end.
      377         else do:
      378            if p-tt-handle = ? then do:
      379               assign
      380                  vTable = entry( 1 , p-key-rec, chr(3) )
      381               .
      382               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      383               create buffer bh_tbl-name for table v-full-tbl-name .
      384            end.
      385            else do:
      386               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      387            end.
      388         end.
      389         if p-tt-handle = ? then do:
      390            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      391         end.
      392         else do:
      393            bh_tbl-name:find-first( v-where ) no-error .
      394         end.
      395         o-hn = bh_tbl-name.
      396      end.
      397   end procedure.
      398   procedure gen-hn-keyr :
      399     define input  parameter p-key-rec    as character no-undo.
      400     define input  parameter p-key-handle as handle    no-undo .
      401     define input  parameter p-db-name    as character no-undo .
      402     define input  parameter p-tt-handle  as handle    no-undo .
      403     define input  parameter p-stts-lock  as integer   no-undo .
      404     define output parameter o-hn         as handle    no-undo.
      405     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      406   end.
      407   procedure gen-row-keyr :
      408     define input  parameter p-key-rec    as character no-undo.
      409     define input  parameter p-key-handle as handle    no-undo .
      410     define input  parameter p-db-name    as character no-undo .
      411     define input  parameter p-tt-handle  as handle    no-undo .
      412     define input  parameter p-stts-lock  as integer   no-undo .
      413     define output parameter p-tbl-row    as rowid     no-undo.
      414     define output parameter p-tbl-name   as character no-undo.
      415     define variable vHn as handle no-undo.
      416       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      417       p-tbl-row = if vHn:available then vHn:rowid else ?.
      418       p-tbl-name =  vHn:table.
      419       delete object vHn no-error.
      420     if p-tbl-row = ? then do:
      421       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      422     end.
      423     else do:
      424       return.
      425     end.
      426   end procedure.
      427   procedure gen-key-fv :
      428     define input  parameter p-key-rec    as character no-undo .
      429     define output parameter p-field-list as character no-undo .
      430     define output parameter p-value-list as character no-undo.
      431     do
      432     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      433     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      434     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      435     :
      436       define variable v-full-tbl-name  as character no-undo .
      437       define variable bh_tbl-name      as handle    no-undo .
      438       define variable v-tbl-name       as character no-undo .
      439       define variable v-field-num      as integer   no-undo .
      440       define variable v-count-fld      as integer   no-undo .
      441       define variable v-inform         as character no-undo .
      442       define variable v-ind            as integer   no-undo .
      443       define variable v-idx-field-qnty as integer   no-undo .
      444       define variable v-delim-key      as character no-undo .
      445       if p-key-rec = ?
      446         or p-key-rec = "":U
      447       then do:
      448         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      449       end.
      450       assign
      451         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      452         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      453       .
      454       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      455       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      456       assign
      457         v-inform = bh_tbl-name:index-information(1)
      458         v-ind    = 2
      459       .
      460       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      461       on error undo, return error
      462       :
      463         assign
      464           v-inform = bh_tbl-name:index-information( v-ind )
      465           v-ind    = v-ind + 1
      466         .
      467       end.
      468       if v-inform = ?
      469         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      470         or entry( 3, v-inform, ",":U ) <> "1":U
      471       then do:
      472         delete object bh_tbl-name no-error.
      473         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      474       end.
      475       assign
      476         v-idx-field-qnty = num-entries( v-inform ) - 4
      477       .
      478       if v-idx-field-qnty < 2 then do:
      479         delete object bh_tbl-name no-error.
      480         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      481       end.
      482       assign
      483         p-field-list = "":U
      484         p-value-list = "":U
      485         v-delim-key  = "":U
      486         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      487         v-count-fld  = 0
      488       .
      489       block_where:
      490       do v-ind = 1 to v-idx-field-qnty by 2
      491       on error undo, return error
      492       :
      493         assign
      494           v-count-fld = v-count-fld + 1
      495         .
      496         if v-count-fld > v-field-num then do:
      497           leave block_where.
      498         end.
      499         assign
      500           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      501           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      502         .
      503         if v-ind = 1 then do:
      504           assign
      505             v-delim-key = chr(3)
      506           .
      507         end.
      508       end.
      509       delete object bh_tbl-name.
      510       if v-count-fld <> v-field-num then do:
      511         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      512       end.
      513     end.
      514   end procedure.
      515   procedure gen-key-field :
      516     define input  parameter p-table      as character no-undo .
      517     define output parameter p-field-list as character no-undo .
      518     do
      519     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      520     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      521     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      522     :
      523       define variable v-full-tbl-name  as character no-undo .
      524       define variable bh_tbl-name      as handle    no-undo .
      525       define variable v-tbl-name       as character no-undo .
      526       define variable v-field-num      as integer   no-undo .
      527       define variable v-count-fld      as integer   no-undo .
      528       define variable v-inform         as character no-undo .
      529       define variable v-ind            as integer   no-undo .
      530       define variable v-idx-field-qnty as integer   no-undo .
      531       define variable v-delim-key      as character no-undo .
      532       if p-table = ?
      533         or p-table = "":U
      534       then do:
      535         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      536       end.
      537       assign
      538         v-tbl-name      = p-table
      539         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      540       .
      541       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      542       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      543       assign
      544         v-inform = bh_tbl-name:index-information(1)
      545         v-ind    = 2
      546       .
      547       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      548       on error undo, return error
      549       :
      550         assign
      551           v-inform = bh_tbl-name:index-information( v-ind )
      552           v-ind    = v-ind + 1
      553         .
      554       end.
      555       if v-inform = ?
      556         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      557         or entry( 3, v-inform, ",":U ) <> "1":U
      558       then do:
      559         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      560       end.
      561       assign
      562         v-idx-field-qnty = num-entries( v-inform ) - 4
      563       .
      564       if v-idx-field-qnty < 2 then do:
      565         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      566       end.
      567       assign
      568         p-field-list = "":U
      569         v-delim-key  = "":U
      570         v-count-fld  = 0
      571       .
      572       block_where:
      573       do v-ind = 1 to v-idx-field-qnty by 2
      574       on error undo, return error
      575       :
      576         assign
      577           v-count-fld = v-count-fld + 1
      578         .
      579         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      580         if v-ind = 1 then do:
      581           assign
      582             v-delim-key = chr(3)
      583           .
      584         end.
      585       end.
      586       delete object bh_tbl-name.
      587     end.
      588   end procedure.
      589   define buffer buf_ord-doc for ub.ord-doc.
      590   define buffer buf_trn-doc for ub.trn-doc.
      591   message
      592   "Прием документов по электронному документообороту проводится автоматически подсистемой OXML" skip
      593   "Обновите список заказов нажатием клавиши F5, чтобы увидеть изменения состояния заказов"
      594   view-as alert-box .
