     1720   PUT stream PrnLibStream UNFORMATTED
     1721   replace(sheetf.Excel-Column-Lable, chr(44), p-XL-delim)
     1722   SKIP(0).
     1723   run rep/extitle.p (1).
     1724   _obj-list:
     1725   FOR EACH obj-list NO-LOCK:
     1726     CASE p-by:
     1727       when 1 or
     1728       when 2 or
     1729       when 3
     1730       then do:
     1731         if p-by2 = 1
     1732         or p-by2 = 3 then  do:
     1733           if p-by = 1
     1734           or p-by = 3 then do:
     1735             is-out = 1.
     1736             for each buf_trn-doc where
     1737                     buf_trn-doc.fact-date >= p-start-date
     1738                 AND buf_trn-doc.fact-date <= p-end-date
     1739                 AND buf_trn-doc.obj-code = obj-list.obj-code
     1740                 AND buf_trn-doc.obj-type = obj-list.obj-type
     1741                 AND buf_trn-doc.ext-doc-type = 'es':U
     1742                 AND buf_trn-doc.status_ = 'факт':U
     1743                 AND buf_trn-doc.internal = no
     1744                 AND buf_trn-doc.doc-type = 'рас':U:
     1745               run cr-sj-goods in this-procedure (buf_trn-doc.doc-code) no-error .
     1746             end.
     1747           end.
     1748           if p-by = 1
     1749           or p-by = 3 then do:
     1750             is-out =  - 1.
     1751             for each buf_trn-doc where
     1752                     buf_trn-doc.fact-date >= p-start-date
     1753                 AND buf_trn-doc.fact-date <= p-end-date
     1754                 AND buf_trn-doc.obj-code = obj-list.obj-code
     1755                 AND buf_trn-doc.obj-type = obj-list.obj-type
     1756                 AND buf_trn-doc.ext-doc-type = 'rs':U
     1757                 AND buf_trn-doc.status_ = 'факт':U
     1758                 AND buf_trn-doc.internal = no
     1759                 AND buf_trn-doc.doc-type = 'возврат':U:
     1760               run cr-sj-goods in this-procedure (buf_trn-doc.doc-code) no-error .
     1761             end.
     1762           end.
     1763         end.
     1764         if p-by2 = 2
     1765         or p-by2 = 3 then do:
     1766           if p-by = 1
     1767           or p-by = 2
     1768           then do:
     1769             is-out = 1.
     1770             for each buf_trn-doc where
     1771                     buf_trn-doc.fact-date >= p-start-date
     1772                 AND buf_trn-doc.fact-date <= p-end-date
     1773                 AND buf_trn-doc.obj-code = obj-list.obj-code
     1774                 AND buf_trn-doc.obj-type = obj-list.obj-type
     1775                 AND buf_trn-doc.ext-doc-type = 'ee':U
     1776                 AND buf_trn-doc.status_ = 'факт':U
     1777                 AND buf_trn-doc.internal = no
     1778                 AND buf_trn-doc.doc-type = 'рас':U:
     1779               run cr-sj-goods in this-procedure (buf_trn-doc.doc-code) no-error .
     1780             end.
     1781           end.
     1782           if p-by = 1
     1783           or p-by = 3
     1784           then do:
     1785             is-out =  - 1.
     1786             for each buf_trn-doc where
     1787                     buf_trn-doc.fact-date >= p-start-date
     1788                 AND buf_trn-doc.fact-date <= p-end-date
     1789                 AND buf_trn-doc.obj-code = obj-list.obj-code
     1790                 AND buf_trn-doc.obj-type = obj-list.obj-type
     1791                 AND buf_trn-doc.ext-doc-type = 're':U
     1792                 AND buf_trn-doc.status_ = 'факт':U
     1793                 AND buf_trn-doc.internal = no
     1794                 AND buf_trn-doc.doc-type = 'возврат':U:
     1795               run cr-sj-goods in this-procedure (buf_trn-doc.doc-code) no-error .
     1796             end.
     1797           end.
     1798         end.
     1799       end.
     1800       when 4 then do:
     1801         is-out = 1.
     1802         for each buf_trn-doc where
     1803                 buf_trn-doc.fact-date >= p-start-date
     1804             AND buf_trn-doc.fact-date <= p-end-date
     1805             AND buf_trn-doc.obj-code = obj-list.obj-code
     1806             AND buf_trn-doc.obj-type = obj-list.obj-type
     1807             AND buf_trn-doc.ext-doc-type = 'we':U
     1808             AND buf_trn-doc.status_ = 'факт':U
     1809             AND buf_trn-doc.internal = no :
     1810           run cr-sj-goods in this-procedure (buf_trn-doc.doc-code) no-error .
     1811         end.
     1812       end.
     1813       when 5 then do:
     1814         for each doc-list no-lock:
     1815            if doc-list.fact-date < p-start-date
     1816            or doc-list.fact-date > p-end-date
     1817            or doc-list.obj-code <> obj-list.obj-code
     1818            or doc-list.obj-type <> obj-list.obj-type then NEXT.
     1819            if doc-list.ext-doc-type = 'es':U
