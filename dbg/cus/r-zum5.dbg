     1950     ASSIGN   road-tax-base-loc   = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1951              road-tax-rubl-loc   = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1952     ASSIGN  transport-base-loc  = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1953             transport-rubl-loc  = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
