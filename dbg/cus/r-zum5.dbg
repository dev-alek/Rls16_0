     1275   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1276   procedure cur-time :
     1277      define output parameter p-today as date      no-undo .
     1278      define output parameter p-time  as integer   no-undo .
     1279     do
     1280     on error undo, return error
     1281     :
     1282       define variable v-date1 as date      no-undo .
     1283       define variable v-date2 as date      no-undo .
     1284       define variable v-time  as integer   no-undo .
     1285       assign
     1286         v-date1 = today
     1287         v-time  = time
     1288         v-date2 = today
     1289       .
     1290       if v-date1 <> v-date2
     1291       then do:
     1292         assign
     1293           v-date1 = today
     1294           v-time  = v-time
     1295         .
     1296       end.
     1297       assign
     1298         p-today = v-date1
     1299         p-time  = v-time
     1300       .
     1301     end.
     1302   end.
     1303   function cur-time-date returns character
     1304   :
     1305     return string(today, '99/99/9999':U) .
     1306   end.
     1307   function cur-time-mjd returns decimal
     1308   :
     1309     define variable v-date as date      no-undo .
     1310     define variable v-time as integer   no-undo .
     1311     run cur-time in this-procedure
     1312       (output v-date
     1313       ,output v-time
     1314       ) .
     1315     return integer(v-date) - 2400002 + (v-time / 86400) .
     1316   end.
     1317   function cur-time-get-ending-index returns integer
     1318   (input p-number as integer
     1319   )
     1320   :
     1321     if p-number < 0
     1322     or p-number = ?
     1323     then do:
     1324       return 1 .
     1325     end.
     1326     define variable v-rest as integer   no-undo .
     1327     assign
     1328       p-number = p-number modulo 100
     1329     .
     1330     if p-number < 20
     1331     then do:
     1332       assign
     1333         v-rest = p-number
     1334       .
     1335     end.
     1336     else do:
     1337       assign
     1338         v-rest = p-number modulo 10
     1339       .
     1340     end.
     1341     case v-rest :
     1342       when 1
     1343       then do:
     1344         return 2 .
     1345       end.
     1346       when 2 or
     1347       when 3 or
     1348       when 4
     1349       then do:
     1350         return 3 .
     1351       end.
     1352       otherwise do:
     1353         return 1 .
     1354       end.
     1355     end case .
     1356   end.
     1357   procedure cur-time-mjd-to-date :
     1358      define input  parameter i-mjd-diff as decimal no-undo.
     1359      define output parameter o-Date     as date    no-undo.
     1360      define output parameter o-Time     as integer no-undo.
     1361      define variable v-day-number as integer   no-undo .
     1362      if    i-mjd-diff < 0
     1363         or i-mjd-diff = ?
     1364      then do:
     1365         return "?" .
     1366      end.
     1367      assign
     1368         v-day-number = truncate(i-mjd-diff,0).
     1369         o-Date = date(v-day-number + 2400002).
     1370         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1371     .
     1372   end.
     1373   function cur-time-mjd-to-string returns character
     1374   (input p-mjd-diff as decimal
     1375   )
     1376   :
     1377     define variable v-day-number as integer   no-undo .
     1378     define variable v-seconds    as integer   no-undo .
     1379     define variable v-hour       as integer   no-undo .
     1380     define variable v-min        as integer   no-undo .
     1381     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1382     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1383     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1384     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1385     if p-mjd-diff < 0
     1386     or p-mjd-diff = ?
     1387     then do:
     1388       return "?" .
     1389     end.
     1390     assign
     1391       v-day-number = integer(truncate(p-mjd-diff,0))
     1392       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1393     .
     1394     if v-seconds > 86400
     1395     then do:
     1396       assign
     1397         v-seconds = 86400 - 1
     1398       .
     1399     end.
     1400     if v-seconds < 0
     1401     then do:
     1402       assign
     1403         v-seconds = 0
     1404       .
     1405     end.
     1406     assign
     1407       v-hour = truncate(v-seconds / 3600, 0)
     1408     .
     1409     assign
     1410       v-seconds = v-seconds modulo 3600
     1411     .
     1412     assign
     1413       v-min = truncate(v-seconds / 60, 0)
     1414     .
     1415     assign
     1416       v-seconds = v-seconds modulo 60
     1417     .
     1418     return
     1419         (if v-day-number <> 0
     1420           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1421           else ""
     1422         )
     1423       + (if v-day-number <> 0 or v-hour <> 0
     1424           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1425           else ""
     1426         )
     1427       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1428           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1429           else ""
     1430         )
     1431       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1432       .
     1433   end.
     1434   function cur-time-string returns character
     1435   :
     1436     define variable v-date as date      no-undo .
     1437     define variable v-time as integer   no-undo .
     1438     run cur-time in this-procedure
     1439       (output v-date
     1440       ,output v-time
     1441       ) .
     1442     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1443   end.
     1444   function cur-time-string-sec returns character
     1445   :
     1446     define variable v-date as date      no-undo .
     1447     define variable v-time as integer   no-undo .
     1448     run cur-time in this-procedure
     1449       (output v-date
     1450       ,output v-time
     1451       ) .
     1452     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1453   end.
     1454   function cur-time-custom  returns character
     1455   (input p-prefix as character
     1456   ,input p-date-format as character
     1457   ,input p-delimiter as character
     1458   ,input p-time-format as character
     1459   ,input p-suffix as character
     1460   )
     1461   :
     1462     define variable v-date as date      no-undo .
     1463     define variable v-time as integer   no-undo .
     1464     run cur-time in this-procedure
     1465       (output v-date
     1466       ,output v-time
     1467       ) .
     1468     return
     1469       p-prefix
     1470       + string(v-date, p-date-format)
     1471       + p-delimiter
     1472       + string(v-time, p-time-format)
     1473       + p-suffix
     1474       .
     1475   end.
     1476   function cur-time-print  returns character
     1477   :
     1478     define variable v-date as date      no-undo .
     1479     define variable v-time as integer   no-undo .
     1480     run cur-time in this-procedure
     1481       (output v-date
     1482       ,output v-time
     1483       ) .
     1484     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1485   end.
     1486   function cur-time-datetime returns datetime
     1487   :
     1488     define variable v-char as character no-undo .
     1489     define variable v-datetime as datetime no-undo .
     1490     v-char = cur-time-string().
     1491     v-datetime = datetime(v-char).
     1492     return  v-datetime.
     1493   end.
     1494   function cur-time-string-msec returns character
     1495   :
     1496     define variable v-date as datetime  no-undo .
     1497     v-date = now.
     1498     return string(v-date) .
     1499   end.
     1500   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1501   FUNCTION IsEngFrm RETURNS Logical  ( INPUT p-str as char) :
     1502   DEFINE VARIABLE ii as integer no-undo .
     1503   DEFINE VARIABLE v-int as integer no-undo .
     1504   DEFINE VARIABLE v-char as character no-undo .
     1505   DEFINE VARIABLE v-dec as decimal no-undo .
     1506   if p-str begins '0':U then return yes.
     1507   if index(p-str, "E":U ) = 0 then return no.
     1508   if index(p-str, "+":U ) = 0
     1509   AND index(p-str, "-":U ) = 0 then return no.
     1510   assign
     1511   v-dec = decimal(entry(1, p-str, "E":U))
     1512   no-error .
     1513   if error-status:error then return no.
     1514   assign
     1515   v-int = integer(entry(2, p-str, "E":U))
     1516   no-error .
     1517   if error-status:error then return no.
     1518   assign
     1519   v-char = entry(2, p-str, "E":U)
     1520   .
     1521   if (substr(v-char, 1, 1) = "+":U and index(v-char, "-":U) = 0 )
     1522   OR
     1523   (substr(v-char, 1, 1) = "-":U and index(v-char, "+":U) = 0 )
     1524   then return yes.
     1525   END FUNCTION.
     1526   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527     define variable v-cntxt-db-num        as integer   no-undo .
     1528     define variable v-cntxt-userid        as character no-undo .
     1529     define variable v-cntxt-level         as character no-undo .
     1530     define variable v-cntxt-host-code-obj as integer   no-undo .
     1531     define variable v-cntxt-obj-type      as character no-undo .
     1532     define variable v-cntxt-obj-code      as integer   no-undo .
     1533     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1534     define variable v-cntxt-is-admin      as logical   no-undo .
     1535   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1536   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1537   procedure lhistprex-print-doc-list-hist-excel :
     1538   define input parameter p-text  as logical no-undo .
     1539   define input parameter p-excel as logical no-undo .
     1540   define input parameter p-sheet-num as integer no-undo .
     1541   define buffer buf_lh-sheetf for sheetf.
     1542   define buffer buf_doc-list-hist for doc-list-hist.
     1543     do
     1544     on error undo, return error
     1545     :
     1546       find first buf_doc-list-hist no-lock where buf_doc-list-hist.id = 0 no-error .
     1547       if p-excel then do:
     1548         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1549         FInd first buf_lh-Sheetf where
     1550                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1551         if not avail buf_lh-sheetf then
     1552         create buf_lh-sheetf.
     1553         assign
     1554         buf_lh-Sheetf.Sheet-num = 2
     1555         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1556         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1557         .
     1558         run rep/extitlee.p (input p-sheet-num
     1559                       , input  substitute("История создания списка &1 &2"
     1560                                   ,
     1561   ''
     1562                                   ,(if available buf_doc-list-hist
     1563                                   then buf_doc-list-hist.des
     1564                                   else "БЕЗЫМЯННЫЙ"))
     1565                       ) .
     1566       end.
     1567       if p-text then do:
     1568         Page stream PrnLibStream.
     1569         PUT  STREAM PrnLibStream unformatted
     1570         SPACE(25) substitute("История создания списка &1 &2"
     1571                             , ''
     1572                             ,(if available buf_doc-list-hist
     1573                             then buf_doc-list-hist.des
     1574                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1575         space(25) cur-time-print() skip(1)
     1576         .
     1577         put stream PrnLibStream unformatted
     1578         string("№", "X(9)") chr(32)
     1579         string("Действие", "X(9)") chr(32)
     1580         string("записей", "X(9)") chr(32)
     1581         string(" = итого", "X(12)") chr(32)
     1582         (if page-size(PrnLibStream) > 43
     1583         then string("Множество", "X(" + string(136 - 43) + ")")
     1584         else string("Множество", "X(" + string(198 - 43) + ")")
     1585         )
     1586         skip(0)
     1587         fill('-':U, 9) chr(32)
     1588         fill('-':U, 9) chr(32)
     1589         fill('-':U, 9) chr(32)
     1590         fill('-':U, 12) chr(32)
     1591         (if page-size(PrnLibStream) > 43
     1592         then fill('-':U, 136 - 43)
     1593         else fill('-':U, 198 - 43))
     1594         skip(0)
     1595         .
     1596       end.
     1597       for each buf_doc-list-hist where buf_doc-list-hist.id > 0
     1598       by buf_doc-list-hist.id
     1599       :
     1600         if p-text then do:
     1601           put stream PrnLibStream unformatted
     1602           (if buf_doc-list-hist.line = 0
     1603           then string(buf_doc-list-hist.id, ">>>>>>>>9")
     1604           else fill(chr(32) , 9)
     1605           )  chr(32)
     1606           (if buf_doc-list-hist.item_ <> '':U
     1607           then string(buf_doc-list-hist.hist-mode, "X(8)")
     1608           else fill( chr(32), 8)) chr(32)
     1609           string(buf_doc-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1610           string(buf_doc-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1611           (if page-size(PrnLibStream) > 43
     1612           then string(buf_doc-list-hist.des, "X(" + string(136 - 43) + ")")
     1613           else string(buf_doc-list-hist.des, "X(" + string(198 - 43) + ")"))
     1614           skip.
     1615         end.
     1616         if p-excel then do:
     1617           if Make-Excel then  put   stream ForExcel unformatted
     1618           (if buf_doc-list-hist.line = 0
     1619           then string(buf_doc-list-hist.id, ">>>>>>>>9")
     1620           else '':U)
     1621           CHR(9)
     1622           (if buf_doc-list-hist.item_ <> '':U
     1623           then buf_doc-list-hist.hist-mode
     1624           else '':U)  CHR(9)
     1625           (if buf_doc-list-hist.item_ <> '':U
     1626           then string(buf_doc-list-hist.num-add, "->>>>>>>>9")
     1627           else '':U)  CHR(9)
     1628           (if buf_doc-list-hist.item_ <> '':U
     1629           then string(buf_doc-list-hist.num-recs, ">>>>>>>>9")
     1630           else '':U)  CHR(9)
     1631           buf_doc-list-hist.des
     1632           skip.
     1633         end.
     1634       end.
     1635     end.
     1636   end procedure.
