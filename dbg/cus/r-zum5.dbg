     1845                                             ).
     1846   procedure cr-sj-goods :
     1847   define input parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     1848   define variable jj as integer no-undo .
     1849   define variable cur-quant like ub.gds-dtl.doc-qnty no-undo.
     1850   define variable v-is-attr       as logical no-undo .
     1851   define variable v-supp-type         like ub.parts-attr.supp-type no-undo .
     1852   define variable v-supp-code         like ub.parts-attr.supp-code no-undo .
     1853   define variable v-supp-pay-code     like ub.parts-attr.pay-code no-undo .
     1854   define variable v-purch-code        like ub.parts-attr.purch-code no-undo .
     1855   define variable v-in-code           like ub.parts-attr.income-in-code no-undo .
     1856   define variable v-part-code         like ub.parts-attr.part-code no-undo .
     1857   define variable v-supp-vat-pc       like ub.parts-attr.vat-pc no-undo .
     1858   define variable v-price-sale        like ub.price-list.price-sale no-undo .
     1859   define variable v-doc-num           like ub.price-list.doc-num no-undo .
     1860   define variable v-road-tax          like ub.price-list.road-tax no-undo .
     1861   define variable v-excise            like ub.price-list.excise no-undo .
     1862   define variable v-leave-cycle      as logical no-undo .
     1863   define buffer buf_trn-doc for ub.trn-doc.
     1864   define buffer buf_doc-line for ub.doc-line.
     1865   define buffer buf_gds-dtl for ub.gds-dtl.
     1866   define buffer buf_goods for ub.goods.
     1867   define buffer buf_bar-code for ub.bar-code.
     1868   define buffer buf_gds-prt for ub.gds-prt.
     1869   define buffer buf_parts for ub.parts.
     1870   define buffer buf_parts-attr for ub.parts-attr.
     1871   define buffer buf_clients for ub.clients.
     1872   define buffer buf_sup_clients for ub.clients.
     1873   define buffer buf_sj-gds-dtl for sj-gds-dtl.
     1874     do
     1875     on error undo, return error
     1876     :
     1877       find first buf_trn-doc no-lock where
     1878                 buf_trn-doc.doc-code = p-doc-code .
     1879       if buf_trn-doc.office then return.
     1880       if buf_trn-doc.status_ <> 'факт':U
     1881       or buf_trn-doc.internal <> no
     1882       then return.
     1883       is-out = if lookup(buf_trn-doc.ext-doc-type, 'ie,re,rs,vt,im':U) > 0 then 1 else -1.
     1884      _docline:
     1885       FOR EACH buf_doc-line WHERE
     1886               buf_doc-line.doc-code = p-doc-code NO-LOCK:
     1887         PROCESS EVENTS.
     1888         jj = jj + 1 .
     1889         if ( jj  modulo 10 ) = 0  then
     1890         run waitfram-show in this-procedure (input ("Обработано строк накладных : " +   string(  jj ) ) ).
     1891         FIND FIRST buf_goods No-LOCK WHERE
