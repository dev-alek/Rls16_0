     2357          varslt-rubl-factovp = varslt-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     2358          varvat-rubl-factovp = varvat-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     2359          varvatcons-rubl-factovp = varvatcons-rubl-factovp + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     2360          vardsc-rubl-factovp = vardsc-rubl-factovp + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.fact-qnty
     2361          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
     2362          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     2363          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     2364          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     2365          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     2366       end.
     2367       if buf_trn-doc.doc-type = 'инв':U then do:
     2368         ASSIGN
     2369                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     2370           slt-base-sale               = varslt-base-docovp / varfact-qnty
     2371           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     2372           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     2373           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     2374                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     2375           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     2376           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     2377           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     2378           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     2379       end.
     2380       else do:
     2381         ASSIGN
     2382                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     2383           slt-base-sale               = varslt-base-factovp / varfact-qnty
     2384           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     2385           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     2386           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     2387                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     2388           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     2389           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     2390           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     2391           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     2392       end.
     2393     end.
     2394   end.
     2395   assign
     2396     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     2397     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     2398           assign
     2399           cur-quant = buf_gds-dtl.fact-qnty
     2400           vat-cost = vat-rubl-sale * cur-quant
     2401           vat-cost = if buf_gds-dtl.fact-qnty = 0 then 0 else vat-cost
     2402           sj-gds-dtl.qnty           = sj-gds-dtl.qnty + cur-quant
     2403           sj-gds-dtl.doc-sum        = sj-gds-dtl.doc-sum + ( cur-quant * buf_gds-dtl.price-rubl )
     2404           sj-gds-dtl.doc-price      = sj-gds-dtl.doc-sum  / cur-quant
     2405           sj-gds-dtl.doc-discnt-sum = sj-gds-dtl.doc-discnt-sum + ( buf_gds-dtl.discnt-rubl * cur-quant )
     2406           sj-gds-dtl.doc-discnt     = sj-gds-dtl.doc-discnt-sum / cur-quant
     2407           sj-gds-dtl.VAT-sum        = sj-gds-dtl.VAT-sum + vat-cost
     2408           sj-gds-dtl.VAT-price      = sj-gds-dtl.VAT-sum / cur-quant
     2409           sj-gds-dtl.sale-price     = v-price-sale
     2410           sj-gds-dtl.sale-sum       = sj-gds-dtl.sale-sum + (v-price-sale * cur-quant)
     2411           sj-gds-dtl.sale-price-pr  = sj-gds-dtl.sale-sum / cur-quant
     2412           .
     2413         END.
     2414         assign
     2415         v-leave-cycle = no
     2416         .
     2417         do while v-leave-cycle = no:
     2418           for each sj-gds-dtl where
     2419                   sj-gds-dtl.gds-code = buf_goods.gds-code:
     2420             find first sj-parts where
     2421                       sj-parts.gds-code = sj-gds-dtl.gds-code no-error .
     2422             if not available sj-parts then do:
     2423               for each sj-goods:
     2424                 delete sj-goods.
     2425               end.
     2426               for each sj-parts:
     2427                 delete sj-parts.
     2428               end.
     2429               for each buf_sj-gds-dtl:
     2430                 delete buf_sj-gds-dtl.
     2431               end.
     2432               return.
     2433             end.
     2434             create sj-goods.
     2435             buffer-copy sj-gds-dtl except qnty to sj-goods.
     2436             buffer-copy sj-parts except qnty to sj-goods.
     2437             assign
     2438             sj-goods.qnty = min(sj-gds-dtl.qnty, sj-parts.qnty)
     2439             sj-goods.doc-sum        = sj-goods.doc-price * sj-goods.qnty
     2440             sj-goods.doc-discnt-sum = sj-goods.doc-discnt * sj-goods.qnty
     2441             sj-goods.vat-sum        = sj-goods.vat-price * sj-goods.qnty
     2442             sj-goods.uchet-with-vat-sum = sj-goods.uchet-with-vat-price * sj-goods.qnty
     2443             sj-goods.supp-vat-sum   = sj-goods.supp-vat-price * sj-goods.qnty
     2444             sj-goods.sale-sum       = sj-goods.sale-price-pr * sj-goods.qnty
     2445             .
     2446             if sj-gds-dtl.qnty = sj-parts.qnty then do:
     2447               v-leave-cycle = yes.
     2448               delete sj-parts.
     2449               delete  sj-gds-dtl.
     2450             end.
     2451             else do:
     2452               if sj-gds-dtl.qnty > sj-parts.qnty then do:
     2453                 assign
     2454                 sj-gds-dtl.qnty  = sj-gds-dtl.qnty - sj-parts.qnty
     2455                 .
     2456                 delete sj-parts.
     2457               end.
     2458               else do:
     2459                 assign
     2460                 sj-parts.qnty = sj-parts.qnty - sj-gds-dtl.qnty
     2461                 v-leave-cycle = yes
     2462                 .
     2463                 delete sj-gds-dtl.
     2464               end.
     2465             end.
     2466           end.
     2467         end.
     2468         for each sj-goods :
     2469           find first buf_sup_clients no-lock where
     2470                      buf_sup_clients.obj-type = sj-goods.supp-type
     2471                 AND buf_sup_clients.obj-code = sj-goods.supp-code no-error .
     2472           find first buf_gds-prt no-lock where
     2473                     buf_gds-prt.node-code = sj-goods.prt-code no-error.
     2474           Put Stream PrnLibStream Unformatted
     2475           entry(lookup(buf_trn-doc.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U)  p-XL-delim
     2476           p-doc-code     p-XL-delim
     2477           (obj-list.obj-type + string(obj-list.obj-code)) p-XL-delim
     2478           string(buf_trn-doc.doc-date, "99/99/9999") p-XL-delim
     2479           string(buf_trn-doc.fact-date, "99/99/9999") p-XL-delim
     2480           string(buf_trn-doc.cli-type + string(buf_trn-doc.cli-code)) p-XL-delim
     2481           buf_trn-doc.pay-code p-XL-delim
     2482           buf_goods.gds-code p-XL-delim
     2483           sj-goods.b-code p-XL-delim
     2484           buf_goods.gds-name p-XL-delim
     2485           buf_goods.grp-name p-XL-delim
     2486           (if available buf_gds-prt
     2487           then buf_gds-prt.f-name
     2488           else "Неизвестный признак!!!") p-XL-delim
     2489           buf_goods.artic                p-XL-delim
     2490           string(buf_goods.prod-type + string(buf_goods.prod-code))            p-XL-delim
     2491           (if avail buf_clients
     2492           then buf_clients.obj-name
     2493           else string(buf_goods.prod-type  + string( buf_goods.prod-code)))
     2494                                          p-XL-delim
     2495           buf_goods.struct               p-XL-delim
     2496           buf_goods.unit-base            p-XL-delim
     2497           (is-out * sj-goods.qnty)       p-XL-delim
     2498           string(sj-goods.supp-type  + string( sj-goods.supp-code))           p-XL-delim
     2499           (if avail buf_sup_clients
     2500           then buf_sup_clients.obj-name
     2501           else string(sj-goods.supp-type  + string( sj-goods.supp-code)))
     2502                                          p-XL-delim
     2503           sj-goods.supp-purch-code       p-XL-delim
     2504           sj-goods.supp-pay-code         p-XL-delim
     2505           sj-goods.in-code               p-XL-delim
     2506           sj-goods.part-code             p-XL-delim
     2507           sj-goods.uchet-with-vat-price  p-XL-delim
     2508           (is-out * sj-goods.uchet-with-vat-sum)
     2509                                          p-XL-delim
     2510           sj-goods.supp-vat-pc           p-XL-delim
     2511           (is-out *
     2512           sj-goods.supp-vat-sum)          p-XL-delim
     2513           sj-goods.VAT-pc                p-XL-delim
     2514           (is-out *
     2515           sj-goods.VAT-sum)              p-XL-delim
     2516           sj-goods.sale-price            p-XL-delim
     2517           (is-out *
     2518           sj-goods.sale-sum)              p-XL-delim
     2519           sj-goods.doc-price             p-XL-delim
     2520           (is-out *
     2521           sj-goods.doc-sum)               p-XL-delim
     2522           (is-out *
     2523           sj-goods.doc-discnt-sum)
     2524           skip.
     2525           if Make-Excel then  put   stream ForExcel unformatted
     2526           entry(lookup(buf_trn-doc.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U) CHR(9)
     2527           p-doc-code     CHR(9)
     2528           (obj-list.obj-type + string(obj-list.obj-code)) CHR(9)
     2529           string(buf_trn-doc.doc-date, "99/99/9999") CHR(9)
     2530           string(buf_trn-doc.fact-date, "99/99/9999") CHR(9)
     2531           string(buf_trn-doc.cli-type + string(buf_trn-doc.cli-code)) CHR(9)
     2532           buf_trn-doc.pay-code CHR(9)
     2533           buf_goods.gds-code CHR(9)
     2534           sj-goods.b-code CHR(9)
     2535           buf_goods.gds-name CHR(9)
     2536           buf_goods.grp-name CHR(9)
     2537           (if available buf_gds-prt
     2538           then buf_gds-prt.f-name
     2539           else "Неизвестный признак!!!") CHR(9)
     2540           string(if IsEngFrm(sj-goods.artic)
     2541               then (chr(4) + buf_goods.artic)
     2542               else buf_goods.artic) CHR(9)
     2543           string(buf_goods.prod-type + string(buf_goods.prod-code))            CHR(9)
     2544           (if avail buf_clients
     2545           then buf_clients.obj-name
     2546           else string(buf_goods.prod-type  + string( buf_goods.prod-code)))
     2547                                          CHR(9)
     2548           buf_goods.struct               CHR(9)
     2549           buf_goods.unit-base            CHR(9)
     2550           (is-out *
     2551           sj-goods.qnty)                  CHR(9)
     2552           string(sj-goods.supp-type  + string( sj-goods.supp-code))           CHR(9)
     2553           (if avail buf_sup_clients
     2554           then buf_sup_clients.obj-name
     2555           else string(sj-goods.supp-type  + string( sj-goods.supp-code)))
     2556                                           CHR(9)
     2557           sj-goods.supp-purch-code       CHR(9)
     2558           sj-goods.supp-pay-code         CHR(9)
     2559           sj-goods.in-code               CHR(9)
     2560           sj-goods.part-code             CHR(9)
     2561           sj-goods.uchet-with-vat-price  CHR(9)
     2562           (is-out *
     2563           sj-goods.uchet-with-vat-sum)    CHR(9)
     2564           sj-goods.supp-vat-pc           CHR(9)
     2565           (is-out *
     2566           sj-goods.supp-vat-sum)          CHR(9)
     2567           sj-goods.VAT-pc                CHR(9)
     2568           (is-out *
     2569           sj-goods.VAT-sum)               CHR(9)
     2570           sj-goods.sale-price            CHR(9)
     2571           (is-out *
     2572           sj-goods.sale-sum)              CHR(9)
     2573           sj-goods.doc-price             CHR(9)
     2574           (is-out *
     2575           sj-goods.doc-sum)               CHR(9)
     2576           (is-out *
     2577           sj-goods.doc-discnt-sum)
     2578           skip.
     2579           delete sj-goods.
     2580         end.
     2581       END.
     2582     end.
     2583   end procedure.
