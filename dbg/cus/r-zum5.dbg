      401   procedure create_obj-list :
      402      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      403      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      404      do
      405      on error undo, return error return-value
      406      :
      407         define buffer cli-obj for ub.clients .
      408         define variable p-var as integer no-undo .
      409         define buffer buf_obj-list for obj-list .
      410         find last buf_obj-list  use-index pi no-error .
      411         if available buf_obj-list
      412         then
      413            p-var = buf_obj-list.obj-id + 1.
      414         else
      415            p-var = 1.
      416         find first cli-obj where
      417                   cli-obj.obj-type = p-obj-type
      418               and cli-obj.obj-code = p-obj-code
      419         no-lock no-error.
      420         if available cli-obj
      421         then do:
      422            create buf_obj-list.
      423            assign
      424               buf_obj-list.obj-id   = p-var
      425               buf_obj-list.obj-code = cli-obj.obj-code
      426               buf_obj-list.obj-type = cli-obj.obj-type
      427               buf_obj-list.obj-name = cli-obj.obj-name
      428               buf_obj-list.db-num   = cli-obj.db-num
      429            .
      430         end.
      431      end.
      432   end.
