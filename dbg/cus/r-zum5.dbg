      827   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      828     (output var-report-r-b
      829     )  .
      830   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      831   define  stream PrnLibStream.
      832   procedure prn-lib-prn-file :
      833     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      834     define input parameter p-DIsabledoptions as integer no-undo .
      835     define variable v-report-name as character no-undo .
      836     define variable v-user-action as character no-undo .
      837     define variable v-printed     as logical   no-undo .
      838     define variable v-exist       as logical   no-undo .
      839     do
      840       on error undo, return error
      841       :
      842       run prn-lib-get-report-name  in this-procedure (
      843         input parParentProc
      844         ,output v-report-name
      845         ).
      846   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      848     (input  v-report-name
      849     ,input  2
      850     ,output v-exist
      851     )  .
      852       if NOT v-exist then
      853       DO:
      854         Message
      855           "Нет заданий на печать ! "
      856           view-as alert-box .
      857         Return  .
      858       End.
      859       run gbl/prnfilen.w
      860         (input  ""
      861         ,input  p-DisabledOptions
      862         ,input  string(v-report-name )
      863         ,input  7
      864         ,output v-user-action
      865         ,output v-printed
      866         ) .
      867       if v-printed then
      868       do:
      869         return "YES" .
      870       end.
      871       else
      872       do:
      873         return "NO" .
      874       end.
      875     end.
      876   end procedure.
      877   procedure prn-lib-open-stream :
      878     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      879     define input parameter p-page-size    as integer no-undo .
      880     define input parameter p-is-stream    as logical no-undo .
      881     define input parameter p-append       as logical no-undo .
      882     define variable v-report-name as character no-undo .
      883     do
      884       on error undo, return error
      885       :
      886       run prn-lib-get-report-name  in this-procedure (
      887         input parParentProc
      888         ,output v-report-name
      889         ).
      890       if p-is-stream then
      891       do:
      892         if p-append then
      893         do:
      894           output stream PrnLibStream to value( v-report-name )
      895             page-size value(p-page-size) append .
      896         end.
      897         if not p-append then
      898         do:
      899           output stream PrnLibStream to value( v-report-name )
      900             page-size value(p-page-size) .
      901         end.
      902       end.
      903       if not p-is-stream then
      904       do:
      905         if p-append then
      906         do:
      907           output to value( v-report-name )
      908             page-size value(p-page-size) append .
      909         end.
      910         if not p-append then
      911         do:
      912           output to value( v-report-name )
      913             page-size value(p-page-size) .
      914         end.
      915       end.
      916     end.
      917   end procedure.
      918   procedure prn-lib-open-exp :
      919     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      920     define input parameter p-is-stream    as logical no-undo .
      921     define input parameter p-is-append    as logical no-undo .
      922     define output parameter p-ReportFileName as char init "report" no-undo.
      923     define output parameter p-process as logical no-undo .
      924     define variable glog as logical no-undo .
      925     do
      926       on error undo, return error
      927       :
      928       SYSTEM-DIALOG GET-FILE p-ReportFileName
      929         TITLE      "Укажите путь"
      930         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      931         ASK-OVERWRITE
      932         CREATE-TEST-FILE
      933         SAVE-AS
      934         USE-FILENAME
      935         DEFAULT-EXTENSION "txt"
      936         UPDATE glog
      937         .
      938       if not glog then  return.
      939       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      940       if p-is-stream then
      941       do:
      942         if p-is-append then
      943         do:
      944           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      945         end.
      946         else
      947         do:
      948           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      949         end.
      950       end.
      951       else
      952       do:
      953         if p-is-append then
      954         do:
      955           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      956         end.
      957         else
      958         do:
      959           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      960         end.
      961       end.
      962       p-process = yes.
      963     end.
      964   end procedure.
      965   procedure prn-lib-get-report-name :
      966     define input parameter parParentProc  as widget-handle no-undo.
      967     define output parameter p-report-name as character no-undo .
      968     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      969   end procedure.
      970   procedure prn-lib-reportviewer-report-name :
      971     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      972     define input parameter p-report-name-html as character no-undo .
      973     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      974   end procedure.
      975   procedure prn-lib-reportviewer :
      976     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      977     define input parameter p-report-name-html as character no-undo .
      978     define input parameter p-param        as character no-undo .
      979     define variable v-excel           as character no-undo init 'TRUE' .
      980     define variable v-value-character as character no-undo .
      981     define variable v-value-integer   as character no-undo .
      982     define variable v-value-date      as date      no-undo .
      983     define variable v-value-decimal   as decimal   no-undo .
      984     define variable rep-excel         as logical   no-undo .
      985     define variable excel-string      as character no-undo .
      986     define variable v-param-type      as character no-undo .
      987     define variable v-tth             as handle    no-undo .
      988     run adm/shattri.p (
      989       input "get":U
      990       ,input  ""
      991       ,input  0
      992       ,input  'report-glob':U
      993       ,input  'rep-excel':U
      994       ,output v-value-character
      995       ,output v-value-date
      996       ,output v-value-decimal
      997       ,output v-value-integer
      998       ,output rep-excel
      999       ,output v-param-type
     1000       ,INPUT-OUTPUT table-handle v-tth
     1001       )  .
     1002     if rep-excel then v-excel = "TRUE" .
     1003     else v-excel = "FALSE" .
     1004     if p-param eq ""
     1005     then
     1006        p-param = "EXCEL:" + v-excel.
     1007     else
     1008        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1009     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1010   end procedure.
     1011   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
