     1697   run prn-lib-open-stream  in this-procedure (
     1698                                                input parParentProc
     1699                                               ,input 0
     1700                                               ,input yes
     1701                                               ,input no
     1702                                               ).
     1703   run waitfram-show in this-procedure ("Ждите...").
     1704   PUT stream PrnLibStream UNFORMATTED
     1705   ("Отчет по документам с " +
     1706   string( X-date-start, "99/99/9999" ) + " по " + string(X-date-end, "99/99/9999") + ".")
     1707   format "x(110)" SKIP(1).
     1708   PUT stream PrnLibStream p-report-header format "X(100)" SKIP(0).
     1709   PUT stream PrnLibStream string("По объектам: "  )
     1710       format "X(20)" SKIP.
     1711   FOR EACH obj-list :
     1712   FIND FIRST obj_clients WHERE
     1713             obj_clients.obj-type = obj-list.obj-type
     1714         AND obj_clients.obj-code = obj-list.obj-code NO-LOCK .
