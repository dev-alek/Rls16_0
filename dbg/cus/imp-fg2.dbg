     1042         VIEW-AS TEXT
     1043        SIZE 8.88 BY 1.13
     1044        BGCOLOR 15  NO-UNDO.
     1045   DEFINE VARIABLE Cli-Name AS CHARACTER FORMAT "X(256)":U
     1046         VIEW-AS TEXT
     1047        SIZE 34.5 BY 1.13
     1048        BGCOLOR 15  NO-UNDO.
     1049   DEFINE VARIABLE Cli-type AS CHARACTER FORMAT "X(8)":U
     1050         VIEW-AS TEXT
     1051        SIZE 4.63 BY 1.13
     1052        BGCOLOR 15  NO-UNDO.
     1053   DEFINE VARIABLE grp-txt AS CHARACTER FORMAT "X(256)":U
     1054         VIEW-AS TEXT
     1055        SIZE 53 BY 1.21
     1056        BGCOLOR 15  NO-UNDO.
     1057   DEFINE FRAME Dialog-Frame
     1058        Imply-Cli AT ROW 2.25 COL 1
     1059        grp AT ROW 5 COL 1
     1060        Imly-City AT ROW 6.75 COL 1
     1061        Btn_OK AT ROW 8.25 COL 11
     1062        Btn_Cancel AT ROW 8.25 COL 43
     1063        Cli-code AT ROW 2.25 COL 14 COLON-ALIGNED NO-LABEL
     1064        Cli-type AT ROW 2.25 COL 23.5 COLON-ALIGNED NO-LABEL
     1065        Cli-Name AT ROW 2.25 COL 28.5 COLON-ALIGNED NO-LABEL
     1066        grp-txt AT ROW 5 COL 10 COLON-ALIGNED NO-LABEL
     1067        city1 AT ROW 6.75 COL 10 COLON-ALIGNED NO-LABEL
     1068        city2 AT ROW 6.75 COL 14.5 COLON-ALIGNED NO-LABEL
     1069        "                         Необходимо указать" VIEW-AS TEXT
     1070             SIZE 64 BY .92 AT ROW 1 COL 1
     1071             BGCOLOR 8 FGCOLOR 0
     1072        "       Не обязательные параметры подставляемые по умолчанию" VIEW-AS TEXT
     1073             SIZE 64 BY 1 AT ROW 3.75 COL 1
     1074             BGCOLOR 8 FGCOLOR 0
     1075        SPACE(0.00) SKIP(4.74)
     1076       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1077            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1078            TITLE "Импорт товаров из текстового файла"
     1079            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
     1080   ASSIGN
     1081          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1082          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1083   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1084   DO:
     1085     APPLY "END-ERROR":U TO SELF.
     1086   END.
     1087   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1088   DO:
     1089       define variable l-is-weight as logical no-undo .
     1090       define variable l-is-pgweight as logical no-undo .
     1091       define variable l-is-petrolium as logical no-undo .
     1092      if cli-code = 0 then do:
     1093               message "Не задан производитель "
     1094               view-as alert-box ERROR.
     1095               return no-apply.
     1096      end.
     1097      if trim(grp-txt) = "" then do:
     1098               message "Не задана группа товаров "
     1099               view-as alert-box ERROR.
     1100               return no-apply.
     1101      end.
     1102      if trim(city1) = "" then do:
     1103               message "Не задана страна "
     1104               view-as alert-box ERROR.
     1105               return no-apply.
     1106      end.
     1107      if trim(file-name) = "" then do:
     1108               message "Не задан файл для импорта "
     1109               view-as alert-box ERROR.
     1110               return no-apply.
     1111      end.
     1112      add-scale = false.
     1113      input stream imp from value (file-name) .
     1114      repeat:
     1115           IMPORT stream imp UNFORMATTED text-string  .
     1116           if trim(text-string) = "" then   leave.
     1117           impc = impc + 1.
     1118           if num-entries (text-string, ";") < 24 then do:
     1119                  N-param = num-entries (text-string, ";").
     1120                  OUTPUT stream Err TO value ("Imp_goods.err") append.
     1121                     put stream Err unformatted
     1122                       string(today, "99/99/9999") " "
     1123                       string(time, "HH:MM")
     1124                       " Неправильное число параметров в строке, должно быть 24 "  N-param skip.
     1125                     export stream  Err text-string .
     1126                  output stream Err close.
     1127                  next.
     1128           end.
     1129           IF trim(ENTRY( 9, text-string, ";")) = "Article name" THEN NEXT.
     1130           assign
     1131               i-artic  = trim(ENTRY( 9, text-string, ";") + "-" + ENTRY( 10, text-string, ";"))
     1132               i-size   = ENTRY( 11, text-string, ";")
     1133               i-color  = ENTRY( 13, text-string, ";")
     1134               i-prod-bc = ENTRY( 19, text-string, ";")
     1135               i-name   = trim(ENTRY( 8, text-string, ";"))
     1136               i-scale  =  i-size + "/" +  i-color
     1137               i-sertif = trim(ENTRY( 14, text-string, ";") + " " + ENTRY( 15, text-string, ";") + " " + ENTRY( 16, text-string, ";"))
     1138               i-sostav = trim(ENTRY( 23, text-string, ";"))
     1139               i-prav   = trim(ENTRY( 24, text-string, ";"))
     1140               log-save      = false
     1141           .
     1142           if num-entries (text-string, ";") = 21 THEN
     1143              ASSIGN i-name  = i-name + " " + TRIM(ENTRY( 21, text-string, ";")).
     1144           if trim(i-artic) = "" THEN DO:
     1145               OUTPUT stream Err TO value ("Imp_goods.err") append.
     1146                  put stream Err unformatted
     1147                     string(today, "99/99/9999") " "
     1148                     string(time, "HH:MM")
     1149                     " Не задан артикул товара, см. строку " impc skip.
     1150                  export stream  Err text-string .
     1151               output stream Err close.
     1152               next.
     1153           END.
     1154           if trim(i-size) = "" AND trim(i-color) = "" THEN
     1155              ASSIGN  i-scale =  "_Пустая шкала".
     1156           ELSE DO:
     1157              if trim(i-size) = "" THEN i-size = "Б.Р.".
     1158              if trim(i-color) = "" THEN i-color = "Б.Ц.".
     1159              i-scale =  i-size + "/" +  i-color.
     1160           END.
     1161           if trim(i-prod-bc) = "" THEN DO:
     1162               OUTPUT stream Err TO value ("Imp_goods.err") append.
     1163                  put stream Err unformatted
     1164                     string(today, "99/99/9999") " "
     1165                     string(time, "HH:MM")
     1166                     " Не задан бар-код товара, см. строку " impc  skip.
     1167                  export stream  Err text-string .
     1168               output stream Err close.
     1169               next.
     1170           END.
     1171           IF trim(i-name) = "" THEN DO:
     1172               OUTPUT stream Err TO value ("Imp_goods.err") append.
     1173                  put stream Err unformatted
     1174                     string(today, "99/99/9999") " "
     1175                     string(time, "HH:MM")
     1176                     " Не заданно наименование товара, см. строку " impc skip.
     1177                  export stream  Err text-string .
     1178               output stream Err close.
     1179               next.
     1180           END.
     1181           display
     1182                    impc  label "Прочитано"
     1183                    imp-save label "Сохранено"
     1184                    i-artic format "x(10)" label "Артикул"
     1185                    text-string format "x(40)" label "Строка файла"
     1186                 with frame ff view-as dialog-box
     1187                 title ": Импорт справочника товаров из файла".
     1188           pause 0.
     1189           find first buf-prt where
     1190                buf-prt.root    = no and
     1191                buf-prt.f-name = i-scale  no-lock no-error.
     1192           if not avail buf-prt then do:
     1193                   find first buf-prt where
     1194                buf-prt.upper-code = cod-size-color and
     1195                         buf-prt.root       = no and
     1196                         buf-prt.node-name = i-size  no-lock no-error.
     1197                   if not avail buf-prt then do:
     1198                         run add-color (input i-size, output reply ).
     1199                         if reply = false then do:
     1200                                  OUTPUT stream Err TO value ("Imp_goods.err") append.
     1201                                  put stream err unformatted
     1202                                     string(today, "99/99/9999") " "
     1203                                     string(time, "HH:MM")
     1204                                     " Такая шкала  размера отсутствует в БД, см. строку " impc skip.
     1205                                  export stream  err text-string .
     1206                                  output stream err close.
     1207                            next.
     1208                         end.
     1209                         add-scale = true.
     1210                   end.
     1211                   find first buf-prt where
     1212                        buf-prt.root    = no and
     1213                        buf-prt.node-name = i-color  no-lock no-error.
     1214                   if not avail buf-prt then do:
     1215                        run add-size (input i-color, output reply ).
     1216                        if reply = false then do:
     1217                            OUTPUT stream Err TO value ("Imp_goods.err") append.
     1218                            put stream err unformatted
     1219                              string(today, "99/99/9999") " "
     1220                              string(time, "HH:MM")
     1221                              " Такая шкала цвета отсутствует в БД, см. строку " impc skip.
     1222                            export stream  err text-string .
     1223                            output stream err close.
     1224                           next.
     1225                        end.
     1226                        add-scale = true.
     1227                   end.
     1228           end.
     1229           if  trim(city1) <> "" then  i-city = city1 .
     1230           find first ub.lvl-name no-lock no-error.
     1231           find first ub.gds-prt where
     1232                ub.gds-prt.prt-root  = ub.lvl-name.upper-code and
     1233                ub.gds-prt.is-term   = no  and
     1234                ub.gds-prt.upper-code = ub.lvl-name.upper-code
     1235           no-lock no-error.
     1236           if not avail gds-prt then do:
     1237                     OUTPUT stream Err TO value ("Imp_goods.err") append.
     1238                     put stream err unformatted
     1239                       string(today, "99/99/9999") " "
     1240                       string(time, "HH:MM")
     1241                       " Корневая шкала не найдена" skip.
     1242                     export stream  err text-string .
     1243                     output stream err close.
     1244                     next.
     1245           end.
     1246           find goods where
     1247                      goods.artic = i-artic and
     1248                      goods.prod-type = cli-type and
     1249                      goods.prod-code = cli-code
     1250           no-lock no-error.
     1251           if not avail goods then do:
     1252                do transaction:
     1253                        define variable v-host-code     as integer           no-undo.
     1254   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1255   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1256     (input  v-cntxt-obj-type
     1257     ,input  v-cntxt-obj-code
     1258     ,output v-host-code
     1259     )  .
     1260                        run ref/dtaxgdss.p (
     1261                              input no
     1262                            , input   "шт."
     1263                            , input   grp-code
     1264                            , input ?
     1265                            , input ?
     1266                            , input    v-host-code
     1267                            , input    v-cntxt-obj-type
     1268                            , input   v-cntxt-obj-code
     1269                        ).
     1270                        define variable v-recid         as recid             no-undo.
     1271               run ref/goods01.p (
     1272                     input parparentproc
     1273                   , input 'ДОБАВЛЕНИЕ':U
     1274                   , input no
     1275                   , input 0
     1276                   , input no
     1277                   , input yes
     1278                   , input YES
     1279                   , input no
     1280                   , input yes
     1281                   , input v-host-code
     1282                   , input v-cntxt-obj-type
     1283                   , input v-cntxt-obj-code
     1284                   , input yes
     1285                   , input ?
     1286                   , input 0
     1287                   , input i-artic
     1288                   , input cli-type
     1289                   , input cli-code
     1290                   , input gds-prt.node-code
     1291                   , input  grp-code
     1292                   , input i-name
     1293                   , input ""
     1294                   , input ""
     1295                   , input i-name
     1296                   , input replace( replace( i-name, chr( 39 ), "" ), chr( 34 ), "" )
     1297                   , input i-city
     1298                   , input "шт."
     1299                   , input "шт."
     1300                   , input 0.0
     1301                   , input 0.0
     1302                   , input 1
     1303                   , input 1
     1304                   , input 0
     1305                   , input 0
     1306                   , input 0
     1307                   , input 0
     1308                   , input 'Группа':U
     1309                   , input 0
     1310                   , input yes
     1311                   , input 0
     1312                   , input 0
     1313                   , input ""
     1314                   , input ""
     1315                   , input ""
     1316                   , input i-prav
     1317                   , input i-sertif
     1318                   , input i-sostav
     1319                   , input 0
     1320                   , input 0
     1321                   , input ""
     1322                   , input 0.0
     1323                   , input 0
     1324                   , input 0
     1325                   , input ""
     1326                   , input ""
     1327                   , input ""
     1328                   , input 0
     1329                   , input ?
     1330                   , input ""
     1331                   , input no
     1332                   , input no
     1333                   , input no
     1334                   , input no
     1335                   , input "no"
     1336                   , input yes
     1337                   , input no
     1338                   , input no
     1339                   , input 0
     1340                   , input-output v-recid
     1341                   , output j-gds-code
     1342               ) no-error .
     1343               if error-status :error
     1344               then do:
     1345                   message
     1346                            vss-workfile vss-revision vss-description
     1347                       skip "Ошибка создания или изменения карточки товара."
     1348                       skip return-value
     1349                       skip i-artic
     1350                       skip trim(error-status :get-message(1))
     1351                            trim(error-status :get-message(2))
     1352                            trim(error-status :get-message(3))
     1353                   view-as alert-box error.
     1354               end.
     1355                       log-save = true.
     1356                end.
     1357           end.
     1358           find goods where
     1359                      goods.artic = i-artic and
     1360                      goods.prod-type = cli-type and
     1361                      goods.prod-code = cli-code
     1362           no-lock no-error.
     1363           if not avail goods then do:
     1364                  OUTPUT stream Err TO value ("Imp_goods.err") append.
     1365                     put stream Err unformatted
     1366                       string(today, "99/99/9999") " "
     1367                       string(time, "HH:MM")
     1368                       " Уже есть такой товар, см. строку " impc skip.
     1369                     export stream  Err text-string .
     1370                  output stream Err close.
     1371           end.
     1372           find first ub.prod-bc where  ub.prod-bc.b-str  = i-prod-bc no-lock no-error.
     1373           if  not avail ub.prod-bc then do:
     1374                 find ub.gds-prt where
     1375                     ub.gds-prt.prt-root = ub.lvl-name.upper-code and
     1376                     ub.gds-prt.f-name = i-scale  no-lock no-error.
     1377                 if  avail gds-prt then do:
     1378                      do transaction  :
     1379                            find first ub.bar-code where ub.bar-code.gds-code = ub.goods.gds-code and
     1380                                ub.bar-code.node-code = ub.gds-prt.node-code no-lock no-error.
     1381                            if not avail ub.bar-code then do:
     1382                                   run gen-b-code IN THIS-PROCEDURE (
     1383                                                  input 'bcgb':U
     1384                                                 ,output var-bc-code
     1385                                                 ) no-error.
     1386                                   if error-status:error then do:
     1387                                        return .
     1388                                   end.
     1389                                   else do:
     1390                                      create buf_bar-code.
     1391                                      assign
     1392                                            buf_bar-code.b-code        = var-bc-code
     1393                                            buf_bar-code.node-code     = ub.gds-prt.node-code
     1394                                            buf_bar-code.gds-code      = ub.goods.gds-code
     1395                                            buf_bar-code.in-code       = "":U
     1396                                            buf_bar-code.part-code     = "":U
     1397                                            buf_bar-code.unit-cli      = ub.goods.unit-base
     1398                                            buf_bar-code.cli-base-rate = 1
     1399                                      .
     1400                                   end.
     1401                                   find first ub.bar-code where ub.bar-code.gds-code = ub.goods.gds-code and
     1402                                          ub.bar-code.node-code = ub.gds-prt.node-code no-lock no-error.
     1403                            end.
     1404                      end.
     1405   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     1407     (input i-prod-bc
     1408     ,input  ub.bar-code.unit-cli
     1409     ,input  ub.goods.unit-base
     1410     ,input  'weight=request':u
     1411     ,output l-is-weight
     1412     )  .
     1413   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     1415     (input i-prod-bc
     1416     ,input  ub.bar-code.unit-cli
     1417     ,input  ub.goods.unit-base
     1418     ,input  'pgweight=request':u
     1419     ,output l-is-pgweight
     1420     )  .
     1421   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     1423     (input i-prod-bc
     1424     ,input  ub.bar-code.unit-cli
     1425     ,input  ub.goods.unit-base
     1426     ,input  'petrolium=request':u
     1427     ,output l-is-petrolium
     1428     )  .
     1429                     if (l-is-weight
     1430                     or l-is-pgweight
     1431                     or l-is-petrolium
     1432                     ) then do:
     1433                      OUTPUT stream Err TO value ("Imp_goods.err") append.
     1434                         put stream err unformatted
     1435                          string(today, "99/99/9999") " "
     1436                          string(time, "HH:MM")
     1437                          " ДопБК Весовой или топливый невозможно проимпортировать, см. строку " impc skip.
     1438                         export stream  err text-string .
     1439                      output stream err close.
     1440                     end.
     1441                     else do:
     1442                      do transaction:
     1443                         define variable rid as recid no-undo .
     1444                         rid = ?.
     1445                         run trg/prod-bc1.p (
     1446                                             input  parparentproc
     1447                                             ,input yes
     1448                                             ,input dif-pdbc
     1449                                             ,input pbc-veto
     1450                                             ,input no
     1451                                             ,input ''
     1452                                             ,input ""
     1453                                             ,buffer ub.goods
     1454                                             ,input ub.bar-code.b-code
     1455                                             ,input-output i-prod-bc
     1456                                             ,output rid
     1457                                             ) no-error.
     1458                         if error-status :error then do:
     1459                           OUTPUT stream Err TO value ("Imp_goods.err") append.
     1460                               put stream err unformatted
     1461                               string(today, "99/99/9999") " "
     1462                               string(time, "HH:MM")
     1463                               substitute(" Ошибка при импорте ДопБК (&1&2&3), см. строку &4"
     1464                                         , error-status:get-message(1)
     1465                                         , chr(10)
     1466                                         , return-value
     1467                                         ,impc )
     1468                                         skip.
     1469                               export stream  err text-string .
     1470                           output stream err close.
     1471                         end.
     1472                         else if rid = ? then do:
     1473                           OUTPUT stream Err TO value ("Imp_goods.err") append.
     1474                               put stream err unformatted
     1475                               string(today, "99/99/9999") " "
     1476                               string(time, "HH:MM")
     1477                               substitute(" Невозможен импорт ДопБК (&1), см. строку &2"
     1478                                         , return-value
     1479                                         ,impc )
     1480                                         skip.
     1481                               export stream  err text-string .
     1482                           output stream err close.
     1483                         end.
     1484                            log-save = true.
     1485                      end.
     1486                      end.
     1487                 end.
     1488                 else do:
     1489                      OUTPUT stream Err TO value ("Imp_goods.err") append.
     1490                         put stream err unformatted
     1491                          string(today, "99/99/9999") " "
     1492                          string(time, "HH:MM")
     1493                          " Такая шкала отсутствует в БД, см. строку " impc skip.
     1494                         export stream  err text-string .
     1495                      output stream err close.
     1496                 end.
     1497           end.
     1498           else do:
     1499                      OUTPUT stream Err TO value ("Imp_goods.err") append.
     1500                         put stream err unformatted
     1501                           string(today, "99/99/9999") " "
     1502                           string(time, "HH:MM")
     1503                           " Такой Доп-БК уже существует в БД, см. строку " impc skip.
     1504                         export stream  err text-string .
     1505                      output stream err close.
     1506           end.
     1507           if   log-save = true then imp-save = imp-save + 1.
     1508      end.
     1509      input stream imp close.
     1510       message ("Импорт из файла " + file-name + " закончен, прочитано " + string(impc) +
     1511                ",  сохранено " + string(imp-save) ) skip
     1512                "Все строки из файла которые не удалось импортировать можно посмотреть в файле Imp_goods.err "
     1513       view-as alert-box  INFORMATION.
     1514   END.
     1515   ON CHOOSE OF grp IN FRAME Dialog-Frame
     1516   DO:
     1517       run ref/gds-grp.w ( input parparentproc
     1518                    , input "b-sel"
     1519                    , input v-cntxt-obj-type
     1520                    , input v-cntxt-obj-code
     1521                    , input-output g-grp ).
     1522       if g-grp <> "" then do:
     1523          FIND FIRST ub.gds-grp WHERE
     1524            recid (ub.gds-grp) = integer (g-grp) NO-LOCK.
     1525          if avail ub.gds-grp then do:
     1526               g-grp = "".
     1527               run grplib-get-full-name in this-procedure ( input ub.gds-grp.node-code, output g-grp ) .
     1528               assign
     1529                  grp-code = ub.gds-grp.node-code
     1530                  grp-txt = g-grp.
     1531               disp
     1532                   grp-txt
     1533               with frame Dialog-Frame.
     1534               FOR EACH ub.tax No-LOCK WHERE
     1535                        ub.tax.individual = no:
     1536                     if ub.tax.individual = yes then next .
     1537                     FIND LAST ub.tax-rate-gds-grp No-LOCK WHERE
     1538                           ub.tax-rate-gds-grp.node-code = grp-code AND
     1539                           ub.tax-rate-gds-grp.tax-code = ub.tax.tax-code AND
     1540                           ub.tax-rate-gds-grp.host-code = 0 AND
     1541                           ub.tax-rate-gds-grp.obj-type = "" AND
     1542                           ub.tax-rate-gds-grp.obj-code = 0 NO-ERROR.
     1543                     if avail ub.tax-rate-gds-grp THEN
     1544                       assign
     1545                             varrate-code = ub.tax-rate-gds-grp.rate-code.
     1546                     FIND FIRST ub.tax-rate No-LOCK WHERE
     1547                                 ub.tax-rate.tax-code = ub.tax.tax-code AND
     1548                                 ub.tax-rate.rate-code = varrate-code No-ERROR.
     1549                     if error-status:error or not avail ub.tax-rate then do:
     1550                       message
     1551                            vss-workfile vss-revision vss-description skip
     1552                            "Не найдена запись ставки налога:"
     1553                            "код налога" ub.tax.tax-code "код ставки" varrate-code
     1554                        view-as alert-box error .
     1555                     end.
     1556                     IF ub.tax-rate-gds-grp.tax-code = 1 THEN NDS-code = ub.tax-rate-gds-grp.rate-code.
     1557                     IF ub.tax-rate-gds-grp.tax-code = 2 THEN NP-code = ub.tax-rate-gds-grp.rate-code.
     1558               end.
     1559          end.
     1560       end.
     1561   END.
     1562   ON CHOOSE OF Imly-City IN FRAME Dialog-Frame
     1563   DO:
     1564   define variable v-rid-list as character no-undo .
     1565       run ref/countris.w ( input parparentproc
     1566                     , input "b-sel"
     1567                     , input-output v-rid-list ).
     1568   if v-rid-list <> '' then  do:
     1569     FIND ub.country WHERE recid (ub.country) = integer(v-rid-list) NO-LOCK.
     1570     if avail country then
     1571             assign
     1572             city1 = ub.country.alpha1
     1573             city2 = ub.country.long-name.
     1574               disp
     1575                 city1
     1576                 city2
     1577            with frame Dialog-Frame.
     1578       end.
     1579   END.
     1580   ON CHOOSE OF Imply-Cli IN FRAME Dialog-Frame
     1581   DO:
     1582   define variable ref-rec as recid no-undo .
     1583       run ref/cli-all.w ( parparentproc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  ref-list).
     1584       if ref-list = '' then do:
     1585         return no-apply.
     1586       end.
     1587       ref-rec = integer (ref-list).
     1588       if  ref-rec <> ? then do:
     1589           FIND ub.clients WHERE recid (ub.clients) = ref-rec NO-LOCK .
     1590           if avail ub.clients then
     1591              assign
     1592              Cli-type = ub.clients.obj-type
     1593              Cli-code = ub.clients.obj-code
     1594              Cli-name = ub.clients.obj-name .
     1595              disp
     1596                Cli-type
     1597                Cli-code
     1598                Cli-name
     1599           with frame Dialog-Frame.
     1600       end.
     1601   END.
     1602   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1603   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1604   MAIN-BLOCK:
     1605   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1606      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1607   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1608     run mainmenu_getcntxt in parparentproc
     1609       (output v-cntxt-db-num
     1610       ,output v-cntxt-userid
     1611       ,output v-cntxt-level
     1612       ,output v-cntxt-host-code-obj
     1613       ,output v-cntxt-obj-type
     1614       ,output v-cntxt-obj-code
     1615       ,output v-cntxt-db-num-obj
     1616       ,output v-cntxt-is-admin
     1617       ) .
     1618      find gds-prt where
     1619           gds-prt.root    = YES and
     1620           gds-prt.node-name = "Размер + Цвет" no-lock no-error.
     1621      if not avail gds-prt then do:
     1622               message "Не найдена шкала - Размер + Цвет  "
     1623               view-as alert-box ERROR.
     1624               return no-apply.
     1625      end.
     1626      else
     1627         assign
     1628             end-cod = gds-prt.upper-code
     1629             cod-size-color = gds-prt.node-code.
     1630      enable Imply-Cli with frame Dialog-Frame.
     1631     run adm/shattri.p (
     1632         input "get":U
     1633         ,input  '':U
     1634         ,input  0
     1635         ,input  'gds-ref':U
     1636         ,input  'dif-pdbc':U
     1637         ,output v-value-character
     1638         ,output v-value-date
     1639         ,output v-value-decimal
     1640         ,output v-value-integer
     1641         ,output dif-pdbc
     1642         ,output v-param-type
     1643         ,INPUT-OUTPUT table-handle v-tth
     1644         ) no-error.
     1645     delete object v-tth.
     1646     run adm/shattri.p (
     1647         input "get":U
     1648         ,input  '':U
     1649         ,input  0
     1650         ,input  'gds-ref':U
     1651         ,input  'pbc-veto':U
     1652         ,output v-value-character
     1653         ,output v-value-date
     1654         ,output v-value-decimal
     1655         ,output v-value-integer
     1656         ,output pbc-veto
     1657         ,output v-param-type
     1658         ,INPUT-OUTPUT table-handle v-tth
     1659         ) no-error.
     1660     delete object v-tth.
     1661     RUN enable_UI.
     1662     WAIT-FOR GO OF FRAME Dialog-Frame.
     1663   END.
     1664   RUN disable_UI.
     1665   PROCEDURE add-color :
     1666   define input  parameter new-scale like ub.gds-prt.f-name no-undo .
     1667   define output parameter reply  as log no-undo .
     1668   define buffer buf-gds-prt-1  for ub.gds-prt.
     1669   define buffer buf-gds-prt-2  for ub.gds-prt.
     1670   define variable u-c like ub.gds-prt.upper-code no-undo.
     1671   define variable p-n like ub.gds-prt.prt-num no-undo.
     1672   define variable n-c like ub.gds-prt.node-code no-undo.
     1673   define variable p-r like ub.gds-prt.prt-root no-undo.
     1674   for each ld :
     1675     delete ld.
     1676   end.
     1677        reply = false.
     1678        for each ub.gds-prt where
     1679              ub.gds-prt.upper-code = 1233  and
     1680              ub.gds-prt.node-name <> ub.gds-prt.f-name and
     1681              ub.gds-prt.is-term = yes
     1682         no-lock:
     1683             find ld where ld.name = ub.gds-prt.node-name no-lock no-error.
     1684             if not avail ld then do:
     1685                 create ld.
     1686                    assign
     1687                       ld.name = ub.gds-prt.node-name
     1688                       ld.num    = ub.gds-prt.prt-num .
     1689             end.
     1690        end.
     1691        find first ub.lvl-name no-lock no-error.
     1692         if not avail ub.lvl-name then do:
     1693               reply = false.
     1694               return.
     1695         end.
     1696        find gds-prt where
     1697              gds-prt.upper-code = lvl-name.upper-code and
     1698              gds-prt.prt-num    = 0
     1699         no-lock no-error.
     1700         if not avail gds-prt then do:
     1701               reply = false.
     1702               return.
     1703         end.
     1704         u-c = gds-prt.node-code .
     1705         find last gds-prt  no-lock use-index pi no-error.
     1706         if not avail gds-prt then do:
     1707               reply = false.
     1708               return.
     1709         end.
     1710         n-c = gds-prt.node-code.
     1711         find last gds-prt no-lock  where
     1712             gds-prt.upper-code =  u-c
     1713         use-index level no-error.
     1714         if not avail gds-prt then do:
     1715               reply = false.
     1716               return.
     1717         end.
     1718         p-n = gds-prt.prt-num.
     1719         do transaction:
     1720              create buf-gds-prt-1.
     1721              assign
     1722                  buf-gds-prt-1.node-code   =  n-c + 1
     1723                  buf-gds-prt-1.upper-code  = u-c
     1724                  buf-gds-prt-1.node-name    = new-scale
     1725                  buf-gds-prt-1.prt-num     = p-n + 1
     1726                  buf-gds-prt-1.root        = no
     1727                  buf-gds-prt-1.lvl-num     = lvl-name.level
     1728                  buf-gds-prt-1.f-name      = new-scale
     1729                  buf-gds-prt-1.is-term     = no
     1730                  buf-gds-prt-1.prt-root    = lvl-name.upper-code
     1731               .
     1732               n-c = n-c + 1.
     1733               for each ld no-lock :
     1734                    create buf-gds-prt-2.
     1735                    assign
     1736                        buf-gds-prt-2.node-code   = n-c  + 1
     1737                        buf-gds-prt-2.upper-code  = buf-gds-prt-1.node-code
     1738                        buf-gds-prt-2.node-name    = ld.name
     1739                        buf-gds-prt-2.prt-num     = ld.num
     1740                        buf-gds-prt-2.root        = no
     1741                        buf-gds-prt-2.lvl-num     = 1
     1742                        buf-gds-prt-2.f-name      = trim(buf-gds-prt-1.f-name) + "/" + trim(ld.name)                     buf-gds-prt-2.is-term     = yes
     1743                        buf-gds-prt-2.prt-root    = lvl-name.upper-code
     1744                    .
     1745                    n-c = n-c + 1.
     1746               end.
     1747               reply = true.
     1748         end.
     1749         current-value (s-gds-prt, ub) = n-c.
     1750   END PROCEDURE.
     1751   PROCEDURE add-size :
     1752   define input  parameter new-scale like ub.gds-prt.f-name no-undo .
     1753   define output parameter reply  as log no-undo .
     1754   define buffer buf-gds-prt-1  for ub.gds-prt.
     1755   define buffer buf-gds-prt-2  for ub.gds-prt.
     1756   define variable u-c like ub.gds-prt.upper-code no-undo.
     1757   define variable p-n like ub.gds-prt.prt-num no-undo.
     1758   define variable n-c like ub.gds-prt.node-code no-undo.
     1759   define variable p-r like ub.gds-prt.prt-root no-undo.
     1760   for each ld :
     1761     delete ld.
     1762   end.
     1763         reply = false.
     1764         p-n = 0.
     1765         find last ub.gds-prt no-lock where
     1766              ub.gds-prt.upper-code = 1233  use-index level no-error.
     1767         if not avail ub.gds-prt then do:
     1768               reply = false.
     1769               return.
     1770         end.
     1771         p-n = ub.gds-prt.prt-num.
     1772         for each ub.gds-prt where
     1773              ub.gds-prt.upper-code = 1232  and
     1774              ub.gds-prt.node-name = ub.gds-prt.f-name and
     1775              ub.gds-prt.is-term = no
     1776         no-lock:
     1777             find ld where ld.name = ub.gds-prt.node-name no-lock no-error.
     1778             if not avail ld then do:
     1779                 create ld.
     1780                    assign
     1781                       ld.name = ub.gds-prt.node-name
     1782                       ld.num    = ub.gds-prt.prt-num
     1783                       ld.ord     = ub.gds-prt.node-code .
     1784             end.
     1785         end.
     1786        find first ub.lvl-name no-lock no-error.
     1787         if not avail ub.lvl-name then do:
     1788               reply = false.
     1789               return.
     1790         end.
     1791         find last ub.gds-prt  no-lock use-index pi no-error.
     1792         if not avail ub.gds-prt then do:
     1793               reply = false.
     1794               return.
     1795         end.
     1796         n-c = ub.gds-prt.node-code.
     1797         do transaction:
     1798              for each ld no-lock:
     1799                   create buf-gds-prt-1.
     1800                   assign
     1801                       buf-gds-prt-1.node-code    =  n-c + 1
     1802                       buf-gds-prt-1.upper-code   = ld.ord
     1803                       buf-gds-prt-1.node-name    = new-scale
     1804                       buf-gds-prt-1.prt-num      = p-n + 1
     1805                       buf-gds-prt-1.root         = no
     1806                       buf-gds-prt-1.lvl-num      = 1
     1807                       buf-gds-prt-1.f-name       = ld.name + "/" + new-scale
     1808                       buf-gds-prt-1.is-term      = yes
     1809                       buf-gds-prt-1.prt-root     = ub.lvl-name.upper-code
     1810                    .
     1811               n-c = n-c + 1.
     1812               reply = true.
     1813              end.
     1814         end.
     1815         current-value (s-gds-prt, ub) = n-c.
     1816   END PROCEDURE.
     1817   PROCEDURE disable_UI :
     1818     HIDE FRAME Dialog-Frame.
     1819   END PROCEDURE.
     1820   PROCEDURE enable_UI :
     1821     DISPLAY Cli-code Cli-type Cli-Name grp-txt city1 city2
     1822         WITH FRAME Dialog-Frame.
     1823     ENABLE grp Imly-City Btn_OK Btn_Cancel Cli-code Cli-type Cli-Name grp-txt
     1824            city1 city2
     1825         WITH FRAME Dialog-Frame.
     1826     VIEW FRAME Dialog-Frame.
     1827   END PROCEDURE.
     1828   PROCEDURE res-t :
     1829   END PROCEDURE.
