        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input  parameter file-name as char no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   procedure proc-alt-shift-f2:
       64     if not ibs.th.gbl.gbl-var:rcode
       65   then
       66     run gbl\inidebug.p .
       67   end.
       68   procedure proc-alt-shift-f3:
       69     run gbl/prvssinf.p
       70       ( input this-procedure
       71       ) .
       72   end.
       73   define variable v-inform-launched as logical no-undo initial false .
       74   procedure proc-alt-shift-f4:
       75     define variable v-action as character no-undo .
       76     if v-inform-launched = false then do:
       77       assign
       78         v-inform-launched = true
       79       .
       80       run gbl/d-inform.w
       81         (  input self
       82         ,  input this-procedure
       83         , output v-action
       84         ) no-error .
       85       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       86       assign
       87         v-inform-launched = false
       88       .
       89     end.
       90   end.
       91   procedure proc-alt-f1:
       92     run gbl/corrhelp.p
       93       (input this-procedure
       94       ) .
       95   end .
       96   on alt-shift-f2 anywhere do:
       97     run proc-alt-shift-f2.
       98   end.
       99   on alt-shift-f3 anywhere do:
      100     run proc-alt-shift-f3 in this-procedure .
      101   end.
      102   on alt-shift-f4 anywhere do:
      103     run proc-alt-shift-f4 in this-procedure.
      104   end.
      105   on alt-f1 anywhere do:
      106     run proc-alt-f1 in this-procedure .
      107   end.
      108   define new global shared variable g#language as character no-undo .
      109   if g#language <> '' and g#language <> 'rus':U then do:
      110     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      111   end.
      112   define new global shared variable g#library  as handle no-undo .
      113   define new global shared variable g#library2 as handle no-undo .
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   procedure gen-b-code :
      116     define input  parameter type-code like ub.code-range.range-type no-undo .
      117     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      118     do
      119     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      120     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      121     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      122     :
      123       define buffer buf_thbj-attr     for ub.thbj-attr .
      124       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      125       define buffer buf_code-range for ub.code-range .
      126       define variable l-code         as   integer              no-undo .
      127       define variable v-db-num       like ub.db.db-num         no-undo .
      128       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      129       if type-code = 'sslc':U
      130       or type-code = 'ssgb':U
      131       then do:
      132         message
      133           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      134           "Обратитесь к администратору системы."
      135           view-as alert-box error .
      136         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      137       end.
      138       run trg/getpcode.p ( input  type-code
      139                      ,output cfg-param-code
      140                     ).
      141       run get-next-seq( input  type-code,
      142                         output l-code
      143                       ).
      144       find first buf_sys-ctrl no-lock.
      145       if type-code = 'sclc':U
      146       or type-code = 'pglc':U
      147       then do:
      148         assign
      149           v-db-num = 0
      150         .
      151       end.
      152       else do:
      153         assign
      154           v-db-num = buf_sys-ctrl.db-num
      155         .
      156       end.
      157       find first buf_code-range no-lock
      158         where buf_code-range.db-num     = v-db-num
      159           and buf_code-range.range-type = type-code
      160           and buf_code-range.stts       = "a"
      161         use-index stts
      162         no-error .
      163       if available buf_code-range
      164          and l-code <= buf_code-range.last-code
      165          and l-code >= buf_code-range.first-code then do:
      166         assign
      167           p-b-code = l-code
      168         .
      169       end.
      170       else do:
      171         if available buf_code-range
      172            and l-code < buf_code-range.last-code then do:
      173           message
      174             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      175             "Обратитесь к администратору системы."
      176             view-as alert-box error .
      177           undo, return error "sequence":U .
      178         end.
      179         do transaction
      180         on error undo, return error
      181         :
      182           find first buf_thbj-attr exclusive-lock
      183             where buf_thbj-attr.upper-prop-code = 'code-range':U
      184               and buf_thbj-attr.prop-code = cfg-param-code
      185               and buf_thbj-attr.obj-type   = 'БД':U
      186               and buf_thbj-attr.obj-code   = v-db-num
      187             no-error .
      188           if not available buf_thbj-attr then do:
      189             find first buf_thbj-attr exclusive-lock
      190               where buf_thbj-attr.upper-prop-code = 'code-range':U
      191                 and buf_thbj-attr.prop-code = cfg-param-code
      192                 and buf_thbj-attr.obj-type   = ''
      193                 and buf_thbj-attr.obj-code   = 0
      194               no-error .
      195             if not available buf_thbj-attr then do:
      196               if not locked buf_thbj-attr then do:
      197                 message
      198                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      199                   "Обратитесь к администратору системы."
      200                   view-as alert-box error .
      201               end.
      202               undo, return error "config":U .
      203             end.
      204           end.
      205           run get-next-seq( input type-code,
      206                             output l-code
      207                           ).
      208           find first buf_code-range
      209             where buf_code-range.db-num     = v-db-num
      210               and buf_code-range.range-type = type-code
      211               and buf_code-range.stts       = "a"
      212             use-index stts
      213             no-error .
      214           if available buf_code-range
      215           and l-code <= buf_code-range.last-code
      216           and l-code >= buf_code-range.first-code
      217           then do:
      218             assign
      219               p-b-code = l-code
      220             .
      221           end.
      222           else do:
      223             if available buf_code-range then do:
      224               assign
      225                 buf_code-range.stts = "u"
      226               .
      227             end.
      228             find first buf_code-range
      229               where buf_code-range.db-num     = v-db-num
      230                 and buf_code-range.range-type = type-code
      231                 and buf_code-range.stts       = "f"
      232               use-index stts
      233               no-error .
      234             if not available buf_code-range then do:
      235               message
      236                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      237                 "Обратитесь к администратору системы"
      238                 view-as alert-box error .
      239               undo, return error "code-range":U .
      240             end.
      241             assign
      242               buf_code-range.stts           = "a"
      243             .
      244             if buf_code-range.first-code = 1 then do:
      245               run set-seq-cr( input type-code,
      246                               input buf_code-range.first-code
      247                             ).
      248               assign
      249                 p-b-code = 1
      250               .
      251             end.
      252             else do:
      253               run set-seq-cr( input type-code,
      254                               input ( buf_code-range.first-code - 1 )
      255                             ).
      256               run get-next-seq( input type-code,
      257                                 output p-b-code
      258                               ).
      259             end.
      260           end.
      261         end.
      262       end.
      263     end.
      264   end procedure.
      265   procedure get-next-seq :
      266     define input  parameter type-code like ub.code-range.range-type no-undo .
      267     define output parameter next-seq  as   integer                  no-undo .
      268     do
      269     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      270     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      271     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      272     :
      273       case type-code:
      274         when 'bcgb':U then do:
      275           assign
      276             next-seq = next-value(s-bcgb-code, ub)
      277           .
      278         end.
      279         when 'scgb':U then do:
      280           assign
      281             next-seq = next-value(s-scgb-code, ub)
      282           .
      283         end.
      284         when 'sclc':U then do:
      285           assign
      286             next-seq = next-value(s-sclc-code, ub)
      287           .
      288         end.
      289         when 'pglc':U then do:
      290           assign
      291             next-seq = next-value(s-pglc-code, ub)
      292           .
      293         end.
      294         when 'dcgb':U then do:
      295           assign
      296             next-seq = next-value(s-dcgb-code, ub)
      297           .
      298         end.
      299         when 'ctgb':U then do:
      300           assign
      301             next-seq = next-value(s-ctgb-code, ub)
      302           .
      303         end.
      304         when 'drgb':U then do:
      305           assign
      306             next-seq = next-value(s-drgb-code, ub)
      307           .
      308         end.
      309         when 'fmgb':U then do:
      310           assign
      311             next-seq = next-value(s-fmgb-code, ub)
      312           .
      313         end.
      314         when 'pngb':U then do:
      315           assign
      316             next-seq = next-value(s-pngb-code, ub)
      317           .
      318         end.
      319         when 'cagb':U then do:
      320           assign
      321             next-seq = next-value(s-cagb-code, ub)
      322           .
      323         end.
      324         when 'fdgb':U then do:
      325           assign
      326             next-seq = next-value(s-fin-doc, ub)
      327           .
      328         end.
      329       end case.
      330     end.
      331   end procedure.
      332   procedure set-seq-cr :
      333     define input parameter type-code like ub.code-range.range-type no-undo .
      334     define input parameter set-val   like ub.code-range.first-code no-undo .
      335     do
      336     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      337     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      338     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      339     :
      340       case type-code:
      341         when 'bcgb':U then do:
      342           assign
      343             current-value(s-bcgb-code, ub) = set-val
      344           .
      345         end.
      346         when 'scgb':U then do:
      347           assign
      348             current-value(s-scgb-code, ub) = set-val
      349           .
      350         end.
      351         when 'sclc':U then do:
      352           assign
      353             current-value(s-sclc-code, ub) = set-val
      354           .
      355         end.
      356         when 'pglc':U then do:
      357           assign
      358             current-value(s-pglc-code, ub) = set-val
      359           .
      360         end.
      361         when 'dcgb':U then do:
      362           assign
      363             current-value(s-dcgb-code, ub) = set-val
      364           .
      365         end.
      366         when 'ctgb':U then do:
      367           assign
      368             current-value(s-ctgb-code, ub) = set-val
      369           .
      370         end.
      371         when 'drgb':U then do:
      372           assign
      373             current-value(s-drgb-code, ub) = set-val
      374           .
      375         end.
      376         when 'fmgb':U then do:
      377           assign
      378             current-value(s-fmgb-code, ub) = set-val
      379           .
      380         end.
      381         when 'pngb':U then do:
      382           assign
      383             current-value(s-pngb-code, ub) = set-val
      384           .
      385         end.
      386         when 'cagb':U then do:
      387           assign
      388             current-value(s-cagb-code, ub) = set-val
      389           .
      390         end.
      391         when 'fdgb':U then do:
      392           assign
      393             current-value(s-fin-doc, ub) = set-val
      394           .
      395         end.
      396       end case.
      397     end.
      398   end procedure.
      399   procedure new-bcod-gen-code-range :
      400     do
      401     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      402     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      403     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      404     :
      405       define input parameter p-db-num  like ub.db.db-num             no-undo .
      406       define input parameter type-code like ub.code-range.range-type no-undo .
      407       define buffer buf_code-range      for ub.code-range .
      408       define buffer last_code-range     for ub.code-range .
      409       define buffer last-1_code-range   for ub.code-range .
      410       define buffer last-2_code-range   for ub.code-range .
      411       define buffer last-3_code-range   for ub.code-range .
      412       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      413       define variable conf-par       as character no-undo .
      414       define variable par-type       as character no-undo .
      415       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      416       define variable v-cre-cdrg as logical   no-undo .
      417       define variable v-cre-str  as character no-undo .
      418       define variable v-cr1      as integer no-undo .
      419       define variable v-cr2      as integer no-undo .
      420       define variable v-cr3      as integer no-undo .
      421       define variable v-cmax     as integer no-undo .
      422       find first buf_sys-ctrl no-lock .
      423       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      424         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      425                                       ,vss-workfile
      426                                       ,vss-revision
      427                                       ,vss-description
      428                                       ,chr(10)
      429                                       , p-db-num
      430                                      ).
      431       end.
      432       run trg/getpcode.p ( input  type-code
      433                      ,output cfg-param-code
      434                     ).
      435       for each buf_code-range
      436         where buf_code-range.db-num     = -1
      437           and buf_code-range.range-type = type-code
      438           and buf_code-range.stts       = "f"
      439       by buf_code-range.first-code
      440       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      441       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      442       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      443       :
      444         assign
      445           buf_code-range.db-num = p-db-num
      446         .
      447         return .
      448       end.
      449       assign
      450         v-cre-cdrg = TRUE
      451       .
      452       case type-code:
      453         when 'sclc':U
      454         or when 'scgb':U
      455         or when 'pglc':U
      456         then do:
      457           find last last-1_code-range no-lock
      458             where last-1_code-range.range-type = 'sclc':U
      459             no-error .
      460           if available last-1_code-range then do:
      461             v-cr1 = last-1_code-range.last-code.
      462           end.
      463           find last last-2_code-range no-lock
      464             where last-2_code-range.range-type = 'scgb':U
      465             no-error .
      466           if available last-2_code-range then do:
      467             v-cr2 = last-2_code-range.last-code.
      468             end.
      469           find last last-3_code-range no-lock
      470             where last-3_code-range.range-type = 'pglc':U
      471             no-error .
      472           if available last-3_code-range then do:
      473             v-cr3 = last-3_code-range.last-code.
      474           end.
      475           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      476           .
      477           if v-cmax = v-cr1  then do:
      478               find last last_code-range no-lock
      479                 where recid( last_code-range ) = recid( last-1_code-range )
      480                 .
      481             end.
      482           if v-cmax = v-cr2  then do:
      483               find last last_code-range no-lock
      484                 where recid( last_code-range ) = recid( last-2_code-range )
      485                 .
      486             end.
      487           if v-cmax = v-cr3  then do:
      488             find last last_code-range no-lock
      489               where recid( last_code-range ) = recid( last-3_code-range )
      490               .
      491           end.
      492           if last_code-range.last-code + 1 > 99999 then do:
      493             assign
      494               v-cre-cdrg = FALSE
      495             .
      496           end.
      497         end.
      498         when 'bcgb':U
      499         or when 'sslc':U
      500         or when 'ssgb':U
      501         then do:
      502           find last last-1_code-range no-lock
      503             where last-1_code-range.range-type = 'sslc':U
      504             no-error .
      505           if available last-1_code-range then do:
      506             v-cr1 = last-1_code-range.last-code.
      507           end.
      508           find last last-2_code-range no-lock
      509             where last-2_code-range.range-type = 'bcgb':U
      510             no-error .
      511           if available last-2_code-range then do:
      512             v-cr2 = last-2_code-range.last-code.
      513             end.
      514           find last last-3_code-range no-lock
      515             where last-3_code-range.range-type = 'ssgb':U
      516             no-error .
      517           if available last-3_code-range then do:
      518             v-cr3 = last-3_code-range.last-code.
      519           end.
      520           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      521           .
      522           if v-cmax = v-cr1  then do:
      523               find last last_code-range no-lock
      524                 where recid( last_code-range ) = recid( last-1_code-range )
      525                 .
      526             end.
      527           if v-cmax = v-cr2  then do:
      528               find last last_code-range no-lock
      529                 where recid( last_code-range ) = recid( last-2_code-range )
      530                 .
      531             end.
      532           if v-cmax = v-cr3  then do:
      533             find last last_code-range no-lock
      534               where recid( last_code-range ) = recid( last-3_code-range )
      535               .
      536           end.
      537         end.
      538         otherwise do:
      539           find last last_code-range no-lock
      540             where last_code-range.range-type = type-code
      541             no-error .
      542         end.
      543       end case.
      544       if not available last_code-range then do:
      545         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      546                                       ,vss-workfile
      547                                       ,vss-revision
      548                                       ,vss-description
      549                                       , chr(10)
      550                                       , type-code
      551                                      ) .
      552       end.
      553       define variable v-mes0 as character no-undo .
      554       define variable v-param-type0 as character no-undo .
      555       define variable v-value-character0 as INTEGER no-undo .
      556       define variable v-value-date0 as date no-undo .
      557       define variable v-value-decimal0 as decimal no-undo .
      558       define variable v-value-integer0 AS integer no-undo .
      559       define variable v-value-logical0 AS LOGICAL no-undo .
      560       define variable v-tth0 as handle no-undo .
      561       run adm/shattri.p (
      562           input "get":U
      563           ,input  'БД':U
      564           ,input  p-db-num
      565           ,input  'code-range':U
      566           ,input  cfg-param-code
      567           ,output v-value-character0
      568           ,output v-value-date0
      569           ,output v-value-decimal0
      570           ,output v-value-integer0
      571           ,output v-value-logical0
      572           ,output v-param-type0
      573           ,INPUT-OUTPUT table-handle v-tth0
      574           ) no-error .
      575       if error-status :error then do:
      576         delete object v-tth0.
      577         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      578                            , error-status:get-message(1)
      579                            , chr(10)
      580                            , return-value ).
      581         undo, return error v-mes0.
      582       end.
      583       delete object v-tth0.
      584       if v-cre-cdrg = TRUE then do:
      585         create buf_code-range .
      586         assign
      587           buf_code-range.db-num     = p-db-num
      588           buf_code-range.range-type = type-code
      589           buf_code-range.stts       = "f"
      590           buf_code-range.first-code = last_code-range.last-code + 1
      591           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      592           v-cre-str = "Свободный диапазон успешно создан"
      593         .
      594       end.
      595       else do:
      596         assign
      597           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      598                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      599         .
      600       end.
      601     end.
      602     return v-cre-str .
      603   end procedure.
      604   procedure gen-new-code-range-if-neces :
      605     define input parameter v-db-num           like ub.db.db-num             no-undo .
      606     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      607     define input parameter v-cur-code         as   integer                  no-undo .
      608     define input parameter v-g#news           as   logical                  no-undo .
      609     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      610     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      611     do
      612     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      613     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      614     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      615     :
      616       define variable l-code-range-exist as logical   no-undo init false .
      617       define variable v-db-for-send      as character no-undo .
      618       define buffer buf_code-range  for ub.code-range .
      619       define buffer buf1_code-range for ub.code-range .
      620       define buffer buf_db          for ub.db .
      621       find first buf_code-range
      622         where buf_code-range.range-type = v-range-type
      623           and buf_code-range.last-code >= v-cur-code
      624         use-index last-codei
      625         no-error .
      626       if
      627       (
      628          available buf_code-range
      629          and
      630         (buf_code-range.db-num = v-db-num
      631           and
      632         buf_code-range.first-code <= v-cur-code
      633         )
      634       or
      635         (
      636           v-range-type = 'drgb':U
      637           AND
      638           v-cur-code = 0
      639         )
      640      )
      641      then do:
      642         assign
      643           l-code-range-exist = true
      644         .
      645         if v-g#news
      646         and buf_code-range.stts = "f" then do:
      647           assign
      648             buf_code-range.stts = "u"
      649           .
      650         end.
      651       end.
      652       if not l-code-range-exist
      653          and v-g#news-source-db <> 0
      654       then do:
      655         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      656                                       ,vss-workfile
      657                                       ,vss-revision
      658                                       ,vss-description
      659                                       ,chr(10)
      660                                       ,v-db-num
      661                                       ,v-range-type
      662                                       ,v-cur-code
      663                                      ).
      664       end.
      665       if (not l-code-range-exist
      666           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      667          )
      668       and ( not can-find (first buf1_code-range no-lock
      669                           where buf1_code-range.db-num = v-db-num
      670                             and buf1_code-range.range-type = v-range-type
      671                             and buf1_code-range.stts = "f"
      672                          )
      673           )
      674       then do:
      675         if v-g#db-num = 0 then do:
      676           run new-bcod-gen-code-range in this-procedure
      677             (input v-db-num,
      678              input v-range-type
      679             ) no-error .
      680           if error-status :error then do:
      681             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      682                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      683                                           ,v-db-num
      684                                           ,v-range-type
      685                                           ,v-cur-code
      686                                           ,chr(10)
      687                                           ,error-status:get-message(1)
      688                                           ,return-value
      689                                          ).
      690           end.
      691         end.
      692         else do:
      693           if v-range-type = 'sclc':U
      694           or v-range-type = 'pglc':U
      695           then do:
      696             assign
      697               v-db-for-send = "":U
      698             .
      699             if v-g#db-num = 0 then do:
      700               for each buf_db no-lock
      701                 where buf_db.db-num > 0
      702                   and buf_db.db-num <> v-g#news-source-db
      703               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      704               :
      705                 assign
      706                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      707                 .
      708               end.
      709               assign
      710                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      711               .
      712             end.
      713             else do:
      714               if not v-g#news then do:
      715                 assign
      716                   v-db-for-send = "0":U
      717                 .
      718               end.
      719             end.
      720             run nws/cr-route.p ( input 'send-cmd':U
      721                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      722                                  "code-range":U + chr(1) +
      723                                  (if v-range-type = 'sclc':U
      724                                   then string( current-value(s-sclc-code, ub))
      725                                   else string( current-value(s-pglc-code, ub))
      726                                   ) + chr(1) +
      727                                   v-range-type)
      728                           ,input ?
      729                           ,input v-db-for-send
      730                           ) no-error .
      731             if error-status :error then do:
      732               undo, return error return-value.
      733             end.
      734           end.
      735         end.
      736       end.
      737     end.
      738   end procedure.
      739   procedure cre-loc-sc-code-range :
      740     define input parameter v-cur-code as integer no-undo .
      741   define input parameter p-cdrg-type as character no-undo .
      742     do
      743     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      744     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      745     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      746     :
      747       define buffer buf_code-range for ub.code-range .
      748       find first buf_code-range
      749            where buf_code-range.range-type = p-cdrg-type
      750              and buf_code-range.first-code >= v-cur-code
      751            no-error .
      752       if not available buf_code-range then do:
      753         run new-bcod-gen-code-range in this-procedure
      754           ( input 0,
      755             input p-cdrg-type
      756           ) no-error .
      757         if error-status :error then do:
      758           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      759                                          + "Код &2&1&3 &4"
      760                                         , chr(10)
      761                                         , v-cur-code
      762                                         , error-status:get-message(1)
      763                                         , return-value
      764                                        ) .
      765         end.
      766       end.
      767     end.
      768   end procedure.
      769   procedure mark-used-if-need :
      770   define input parameter p-cur-code as integer no-undo .
      771   define input parameter p-range-type like ub.code-range.range-type no-undo .
      772   define input parameter p-db-num like ub.code-range.db-num no-undo .
      773     do
      774     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      775     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      776     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      777     :
      778       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      779       define buffer buf_code-range for ub.code-range .
      780       assign
      781       v-db-num = if p-range-type = 'sclc':U
      782                  then 0
      783                  else p-db-num
      784       .
      785   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      786   define buffer locK-batchprocess1 for ub.batchprocess.
      787   run gbl/lock-prc.p
      788       (input 'lscc':U
      789       ,input 0
      790       ,input 0
      791       ,input 0
      792       ,input ""
      793       ,input ""
      794       ,input ""
      795       ,input (
      796               ",,,Вкл/выкл лок. вес. кодов"
      797              )
      798       ,input true
      799       ,buffer lock-batchprocess1
      800       ) no-error .
      801     if error-status :error then do:
      802       message
      803         vss-workfile vss-revision vss-description skip
      804         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      805         view-as alert-box error .
      806       undo, return error .
      807     end.
      808       find first buf_code-range
      809            where buf_code-range.range-type = p-range-type
      810              and buf_code-range.first-code >= p-cur-code
      811              and buf_code-range.last-code <= p-cur-code
      812              and buf_code-range.db-num = v-db-num
      813            no-error .
      814       if not available buf_code-range then do:
      815         message
      816           vss-workfile vss-revision vss-description skip
      817           "Ошибка при создании поиске диапазона" skip
      818           "База данных" p-db-num skip
      819           "Код" p-cur-code skip
      820           "Тип" p-range-type
      821           error-status :get-message(1) skip
      822           return-value skip
      823           view-as alert-box error .
      824         undo, return error .
      825       end.
      826       if buf_code-range.stts = "f":U then do:
      827         assign
      828         buf_code-range.stts = "u":U
      829         .
      830       end.
      831     end.
      832   end procedure.
      833   define variable vss-include-info2 as character format "X(65)" no-undo
      834   initial "@(#)$Workfile$ $Revision$".
      835   procedure grplib-get-full-name :
      836      define input parameter p-node-code  as integer      no-undo.
      837      define output parameter p-full-name as character    no-undo.
      838      do
      839   on error undo, return error
      840   :
      841       define variable v-upper-code    as integer           no-undo.
      842       define buffer buf_gds-grp       for ub.gds-grp.
      843       define buffer buf_upper_gds-grp for ub.gds-grp.
      844       find first buf_gds-grp no-lock
      845            where buf_gds-grp.node-code = p-node-code
      846       no-error.
      847       if not available buf_gds-grp
      848       then do:
      849           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      850       end.
      851       assign
      852           p-full-name  = ""
      853           v-upper-code = 1
      854       .
      855       do while buf_gds-grp.upper-code <> 0
      856       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      857       :
      858           assign
      859               p-full-name  = buf_gds-grp.node-name
      860                            + (if p-full-name <> "" then chr(47) else "")
      861                            + p-full-name
      862               v-upper-code = buf_gds-grp.upper-code
      863           .
      864           find first buf_gds-grp no-lock
      865                where buf_gds-grp.node-code = v-upper-code
      866           no-error.
      867           if not available buf_gds-grp
      868           then do:
      869               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      870                                   + string( v-upper-code )
      871                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      872           end.
      873       end.
      874       assign
      875       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      876       .
      877   end.
      878   end .
      879   procedure grplib-get-node-from-full-name :
      880   define input parameter p-full-name as character no-undo .
      881   define output parameter p-node-code as integer no-undo .
      882   define variable v-ii as integer no-undo .
      883   define variable v-upper-code as integer no-undo .
      884   define variable v-root-code as integer no-undo .
      885   define variable v-entry as character no-undo .
      886   define buffer buf_gds-grp       for ub.gds-grp.
      887   do
      888   on error undo, return error
      889   :
      890     find first buf_gds-grp no-lock
      891         where buf_gds-grp.upper-code = 0
      892     no-error .
      893     if not available buf_gds-grp
      894     then do:
      895         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      896     end.
      897     else do:
      898       assign
      899       v-root-code = buf_gds-grp.node-code
      900       .
      901     end.
      902     v-upper-code = v-root-code.
      903     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      904       assign
      905       v-entry = entry(v-ii, p-full-name, chr(47)).
      906       if v-entry = '' then leave.
      907       find first buf_gds-grp no-lock where
      908                 buf_gds-grp.node-name = v-entry
      909             and buf_gds-grp.upper-code = v-upper-code
      910             no-error.
      911       if not available buf_gds-grp then do:
      912         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      913       end.
      914       else do:
      915         p-node-code = buf_gds-grp.node-code.
      916         v-upper-code = buf_gds-grp.node-code.
      917       end.
      918     end.
      919   end.
      920   end .
