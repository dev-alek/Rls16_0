     1175   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   define  stream PrnLibStream.
     1177   procedure prn-lib-prn-file :
     1178     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1179     define input parameter p-DIsabledoptions as integer no-undo .
     1180     define variable v-report-name as character no-undo .
     1181     define variable v-user-action as character no-undo .
     1182     define variable v-printed     as logical   no-undo .
     1183     define variable v-exist       as logical   no-undo .
     1184     do
     1185       on error undo, return error
     1186       :
     1187       run prn-lib-get-report-name  in this-procedure (
     1188         input parParentProc
     1189         ,output v-report-name
     1190         ).
     1191   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1192   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1193     (input  v-report-name
     1194     ,input  2
     1195     ,output v-exist
     1196     )  .
     1197       if NOT v-exist then
     1198       DO:
     1199         Message
     1200           "Нет заданий на печать ! "
     1201           view-as alert-box .
     1202         Return  .
     1203       End.
     1204       run gbl/prnfilen.w
     1205         (input  ""
     1206         ,input  p-DisabledOptions
     1207         ,input  string(v-report-name )
     1208         ,input  7
     1209         ,output v-user-action
     1210         ,output v-printed
     1211         ) .
     1212       if v-printed then
     1213       do:
     1214         return "YES" .
     1215       end.
     1216       else
     1217       do:
     1218         return "NO" .
     1219       end.
     1220     end.
     1221   end procedure.
     1222   procedure prn-lib-open-stream :
     1223     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1224     define input parameter p-page-size    as integer no-undo .
     1225     define input parameter p-is-stream    as logical no-undo .
     1226     define input parameter p-append       as logical no-undo .
     1227     define variable v-report-name as character no-undo .
     1228     do
     1229       on error undo, return error
     1230       :
     1231       run prn-lib-get-report-name  in this-procedure (
     1232         input parParentProc
     1233         ,output v-report-name
     1234         ).
     1235       if p-is-stream then
     1236       do:
     1237         if p-append then
     1238         do:
     1239           output stream PrnLibStream to value( v-report-name )
     1240             page-size value(p-page-size) append .
     1241         end.
     1242         if not p-append then
     1243         do:
     1244           output stream PrnLibStream to value( v-report-name )
     1245             page-size value(p-page-size) .
     1246         end.
     1247       end.
     1248       if not p-is-stream then
     1249       do:
     1250         if p-append then
     1251         do:
     1252           output to value( v-report-name )
     1253             page-size value(p-page-size) append .
     1254         end.
     1255         if not p-append then
     1256         do:
     1257           output to value( v-report-name )
     1258             page-size value(p-page-size) .
     1259         end.
     1260       end.
     1261     end.
     1262   end procedure.
     1263   procedure prn-lib-open-exp :
     1264     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1265     define input parameter p-is-stream    as logical no-undo .
     1266     define input parameter p-is-append    as logical no-undo .
     1267     define output parameter p-ReportFileName as char init "report" no-undo.
     1268     define output parameter p-process as logical no-undo .
     1269     define variable glog as logical no-undo .
     1270     do
     1271       on error undo, return error
     1272       :
     1273       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1274         TITLE      "Укажите путь"
     1275         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1276         ASK-OVERWRITE
     1277         CREATE-TEST-FILE
     1278         SAVE-AS
     1279         USE-FILENAME
     1280         DEFAULT-EXTENSION "txt"
     1281         UPDATE glog
     1282         .
     1283       if not glog then  return.
     1284       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1285       if p-is-stream then
     1286       do:
     1287         if p-is-append then
     1288         do:
     1289           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1290         end.
     1291         else
     1292         do:
     1293           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1294         end.
     1295       end.
     1296       else
     1297       do:
     1298         if p-is-append then
     1299         do:
     1300           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1301         end.
     1302         else
     1303         do:
     1304           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1305         end.
     1306       end.
     1307       p-process = yes.
     1308     end.
     1309   end procedure.
     1310   procedure prn-lib-get-report-name :
     1311     define input parameter parParentProc  as widget-handle no-undo.
     1312     define output parameter p-report-name as character no-undo .
     1313     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1314   end procedure.
     1315   procedure prn-lib-reportviewer-report-name :
     1316     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1317     define input parameter p-report-name-html as character no-undo .
     1318     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1319   end procedure.
     1320   procedure prn-lib-reportviewer :
     1321     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1322     define input parameter p-report-name-html as character no-undo .
     1323     define input parameter p-param        as character no-undo .
     1324     define variable v-excel           as character no-undo init 'TRUE' .
     1325     define variable v-value-character as character no-undo .
     1326     define variable v-value-integer   as character no-undo .
     1327     define variable v-value-date      as date      no-undo .
     1328     define variable v-value-decimal   as decimal   no-undo .
     1329     define variable rep-excel         as logical   no-undo .
     1330     define variable excel-string      as character no-undo .
     1331     define variable v-param-type      as character no-undo .
     1332     define variable v-tth             as handle    no-undo .
     1333     run adm/shattri.p (
     1334       input "get":U
     1335       ,input  ""
     1336       ,input  0
     1337       ,input  'report-glob':U
     1338       ,input  'rep-excel':U
     1339       ,output v-value-character
     1340       ,output v-value-date
     1341       ,output v-value-decimal
     1342       ,output v-value-integer
     1343       ,output rep-excel
     1344       ,output v-param-type
     1345       ,INPUT-OUTPUT table-handle v-tth
     1346       )  .
     1347     if rep-excel then v-excel = "TRUE" .
     1348     else v-excel = "FALSE" .
     1349     if p-param eq ""
     1350     then
     1351        p-param = "EXCEL:" + v-excel.
     1352     else
     1353        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1354     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1355   end procedure.
     1356   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1357   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1358   procedure fltopend_fltopend :
     1359   define input parameter p-parent-handle as handle no-undo .
     1360   define input parameter p-qh as handle no-undo .
     1361   define input parameter p-flt-open-open-query  as character no-undo .
     1362   define input parameter p-where-cond as character no-undo .
     1363   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1364   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1365   define input parameter p-indexed-reposition as character no-undo .
     1366     do
     1367     on error undo, return error
     1368     :
     1369   define variable v-prepare-string as character no-undo .
     1370   define variable glog as logical no-undo .
     1371   assign
     1372   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1373                      p-where-cond + chr(32)  +
     1374                      p-use-indFIRST-query-tail + chr(32) +
     1375                      p-use-ind-sort-clmn-by + chr(32) +
     1376                      p-indexed-reposition
     1377   .
     1378   assign
     1379   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1380   if not glog
     1381   or error-status:error then do:
     1382     message error-status:get-message(1) view-as alert-box .
     1383     undo, return error .
     1384   end.
     1385   assign
     1386   glog = p-qh:query-open no-error .
     1387   if not glog
     1388   or error-status:error then do:
     1389     message error-status:get-message(1) view-as alert-box .
     1390     undo, return error .
     1391   end.
     1392     end.
     1393   end procedure.
     1394   procedure fltopend_fltfindd :
     1395   define input parameter p-parent-handle as handle no-undo .
     1396   define input parameter p-qh as handle no-undo .
     1397   define input parameter p-rowid as rowid no-undo .
     1398   define input parameter p-next as logical no-undo .
     1399   define input parameter p-lock as integer no-undo .
     1400   define input parameter p-bh as handle no-undo .
     1401   define input parameter p-where-cond as character no-undo .
     1402   define input parameter p-use-index-phrase as character no-undo .
     1403   define variable glog as logical no-undo .
     1404   define variable v-qh as handle no-undo .
     1405   define variable v-bh as handle no-undo .
     1406   define variable v-recid as recid no-undo .
     1407   define variable v-prepare-string as character no-undo .
     1408   do
     1409   on error undo, return error
     1410   on stop undo, return error
     1411   :
     1412     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1413     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1414     create query v-qh.
     1415     v-qh:set-buffers(v-bh).
     1416     v-prepare-string = substitute("for each &1 &2 &3"
     1417                                     ,v-bh:name
     1418                                     ,p-where-cond
     1419                                     ,p-use-index-phrase).
     1420     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1421     if not glog then do:
     1422       delete object v-qh.
     1423       delete object v-bh.
     1424       undo, return error .
     1425     end.
     1426     glog = v-qh:query-open no-error .
     1427     if not glog then do:
     1428       delete object v-qh.
     1429       delete object v-bh.
     1430       undo, return error .
     1431     end.
     1432     if p-next then do:
     1433       v-qh:reposition-to-rowid(p-rowid) no-error .
     1434       glog = v-qh:get-next( p-lock) no-error .
     1435       glog = v-qh:get-next( p-lock) no-error .
     1436       if not glog or v-qh:query-off-end = yes then do:
     1437         glog = v-qh:get-first( p-lock) no-error .
     1438       end.
     1439     end.
     1440     else do:
     1441       glog = v-qh:get-first( p-lock) no-error .
     1442     end.
     1443     v-recid = v-bh:recid no-error .
     1444     delete object v-qh.
     1445     delete object v-bh.
     1446     return string(v-recid) .
     1447   end.
     1448   end procedure.
     1449   procedure fltopend_fltfindq :
     1450   define input parameter p-parent-handle as handle no-undo .
     1451   define input parameter p-qh as handle no-undo .
     1452   define input parameter p-next as logical no-undo .
     1453   define input parameter p-lock as integer no-undo .
     1454   define input parameter p-flt-open-open-query  as character no-undo .
     1455   define input parameter p-where-cond as character no-undo .
     1456   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1457   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1458   define input parameter p-indexed-reposition as character no-undo .
     1459   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1460   define variable glog as logical no-undo .
     1461   define variable v-qh as handle no-undo .
     1462   define variable v-bh as handle no-undo extent 18.
     1463   define variable v-rowid as rowid no-undo extent 18.
     1464   define variable v-ii as integer no-undo .
     1465   define variable v-prepare-string as character no-undo .
     1466   do
     1467   on error undo, return error
     1468   on stop undo, return error
     1469   :
     1470     create query v-qh.
     1471     do v-ii = 1 to p-qh:num-buffers:
     1472       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1473       assign
     1474       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1475       no-error.
     1476       v-qh:add-buffer(v-bh[v-ii]).
     1477     end.
     1478     assign
     1479     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1480                       p-where-cond + chr(32)  +
     1481                       p-use-indFIRST-query-tail + chr(32) +
     1482                       p-use-ind-sort-clmn-by + chr(32) +
     1483                       p-indexed-reposition
     1484     .
     1485     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1486     if not glog then do:
     1487       delete object v-qh.
     1488       do v-ii = 1 to p-qh:num-buffers:
     1489         delete object v-bh[v-ii].
     1490       end.
     1491       undo, return error .
     1492     end.
     1493     glog = v-qh:query-open no-error .
     1494     if not glog then do:
     1495       delete object v-qh.
     1496       do v-ii = 1 to p-qh:num-buffers:
     1497         delete object v-bh[v-ii].
     1498       end.
     1499       undo, return error .
     1500     end.
     1501     if p-next then do:
     1502       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1503       glog = v-qh:get-next( p-lock) no-error .
     1504       glog = v-qh:get-next( p-lock) no-error .
     1505       if not glog or v-qh:query-off-end = yes then do:
     1506         glog = v-qh:get-first( p-lock) no-error .
     1507       end.
     1508     end.
     1509     else do:
     1510       glog = v-qh:get-first( p-lock) no-error .
     1511     end.
     1512     do v-ii = 1 to p-qh:num-buffers:
     1513       assign
     1514       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1515       no-error.
     1516     end.
     1517     delete object v-qh.
     1518     do v-ii = 1 to p-qh:num-buffers:
     1519       delete object v-bh[v-ii].
     1520     end.
     1521   end.
     1522   end procedure.
     1523   define variable sort-column-name as character no-undo.
     1524   define variable filter-point     as character NO-UNDO INIT "соответствие_клиентов ДИАДОК".
     1525   define variable filter-label     as character NO-UNDO INIT "Коды соответствия клиентов ДИАДОК".
     1526   define variable filter-point0    as character NO-UNDO INIT "соответствие_клиентов ДИАДОК".
     1527   define variable filter-label0    as character NO-UNDO INIT "Коды соответствия клиентов ДИАДОК".
     1528   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1529   define variable v-host-code as integer no-undo .
     1530   FUNCTION get-client-name RETURNS CHARACTER
     1531     ( INPUT p-obj-code AS character, INPUT p-obj-type AS character )   FORWARD.
     1532   DEFINE BUTTON b-add
     1533        LABEL "&Добавить"
     1534        SIZE 10 BY 1.
     1535   DEFINE BUTTON b-cli
     1536        LABEL "Клиент"
     1537        SIZE 10 BY 1.
     1538   DEFINE BUTTON b-del
     1539        LABEL "&Удалить"
     1540        SIZE 10 BY 1.
     1541   DEFINE BUTTON B-Help
     1542        LABEL "Помо&щь"
     1543        SIZE 3 BY 1
     1544        BGCOLOR 8 .
     1545   DEFINE BUTTON B-mark
     1546        LABEL "&*"
     1547        SIZE 3 BY 1.
     1548   DEFINE BUTTON b-print
     1549        LABEL "&Печать"
     1550        SIZE 3 BY 1.
     1551   DEFINE BUTTON b-quit AUTO-END-KEY
     1552        LABEL "&Выход"
     1553        SIZE 10 BY 1
     1554        BGCOLOR 8 .
     1555   DEFINE BUTTON b-sch
     1556        LABEL "Фильтр"
     1557        SIZE 3 BY 1.
     1558   DEFINE BUTTON B-sel AUTO-GO
     1559        LABEL "Вы&бор"
     1560        SIZE 10 BY 1.
     1561   DEFINE VARIABLE fill-in-code-system AS CHARACTER FORMAT "X(256)":U
     1562        LABEL "ИД Диадок"
     1563        VIEW-AS FILL-IN
     1564        SIZE 47.5 BY 1 NO-UNDO.
     1565   DEFINE VARIABLE fill-in-code-th AS CHARACTER FORMAT "X(256)":U
     1566        LABEL "Код клиента в ТН"
     1567        VIEW-AS FILL-IN
     1568        SIZE 14 BY 1 NO-UNDO.
     1569   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1570         VIEW-AS TEXT
     1571        SIZE 6 BY 1
     1572        FGCOLOR 4  NO-UNDO.
     1573   DEFINE QUERY br-ext-contragent FOR X_ext-classif, X_clients SCROLLING.
     1574   DEFINE BROWSE br-ext-contragent
     1575     QUERY br-ext-contragent NO-LOCK DISPLAY
     1576         mark-string(recid(X_ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     1577   X_ext-classif.CharKey_One COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     1578   X_ext-classif.KEY#_one  COLUMN-LABEL "Код!клиента" FORMAT ">>>>>>>>>>>9"
     1579   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(30)"
     1580   X_ext-classif.charkey_three COLUMN-LABEL "ИД  Диадок" FORMAT "X(50)"
     1581       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.25 BY 20.38 FIT-LAST-COLUMN.
     1582   DEFINE FRAME Dialog-Frame
     1583        b-quit AT ROW 1 COL 1
     1584        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1585        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     1586        b-add AT ROW 1 COL 31 WIDGET-ID 14
     1587        b-del AT ROW 1 COL 41 WIDGET-ID 16
     1588        b-cli AT ROW 1 COL 51 WIDGET-ID 2
     1589        b-sch AT ROW 1 COL 86 WIDGET-ID 12
     1590        b-print AT ROW 1 COL 89 WIDGET-ID 10
     1591        B-Help AT ROW 1 COL 95
     1592        fill-in-code-th AT ROW 2.5 COL 20 COLON-ALIGNED WIDGET-ID 2
     1593        fill-in-code-system AT ROW 2.5 COL 49 COLON-ALIGNED WIDGET-ID 2
     1594        br-ext-contragent AT ROW 4 COL 1.5 WIDGET-ID 100
     1595        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1596        SPACE(79.30) SKIP(22.38)
     1597       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1598            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1599            TITLE ""
     1600            CANCEL-BUTTON b-quit.
     1601   ASSIGN
     1602          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1603          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1604   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1605   DO:
     1606     APPLY "END-ERROR":U TO SELF.
     1607   END.
     1608   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1609   DO:
     1610     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1611     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1612   END.
     1613   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1614   DO:
     1615     IF NOT AVAILABLE X_clients THEN RETURN NO-APPLY.
     1616     run ref/showcli.p ( INPUT parparentproc
     1617                        ,INPUT X_clients.obj-type
     1618                        ,INPUT X_clients.obj-code) NO-ERROR.
     1619     APPLY "entry" TO br-ext-contragent.
     1620   END.
     1621   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1622   DO:
     1623     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1624     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1625     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1626   END.
     1627   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1628   DO:
     1629     define variable loc#log as logical no-undo .
     1630     if available X_ext-classif then do:
     1631   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1632   define variable v-str-recid14 as character no-undo .
     1633   define variable v-num-entry14 as integer   no-undo .
     1634   assign
     1635     v-str-recid14 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
     1636     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1637   .
     1638   if v-num-entry14 > 0 then do:
     1639     assign
     1640       entry( v-num-entry14, v-rid-list ) = "":U
     1641       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1642     .
     1643   end.
     1644   else do:
     1645     assign
     1646       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1647     .
     1648   end.
     1649       loc#log = br-ext-contragent:refresh() .
     1650       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1651           loc#log = br-ext-contragent:select-next-row ().
     1652           apply "VALUE-CHANGED" to br-ext-contragent in frame Dialog-Frame.
     1653       end.
     1654       if num-entries( v-rid-list ) = 0
     1655       then
     1656           hide mark-num in frame Dialog-Frame.
     1657       else
     1658           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1659     end.
     1660     apply "entry" to br-ext-contragent in frame Dialog-Frame.
     1661   END.
     1662   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1663   DO:
     1664     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1665     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1666   END.
     1667   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1668   DO:
     1669     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1670     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1671   END.
     1672   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1673   DO:
     1674       if ( available X_ext-classif ) then do:
     1675       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1676       then
     1677       v-rid-list = string( recid( X_ext-classif ) ) .
     1678     end.
     1679   END.
     1680   ON ENTER OF fill-in-code-th IN FRAME Dialog-Frame
     1681   DO:
     1682      find first X_ext-classif no-lock   where X_ext-classif.Key#_One=integer(fill-in-code-th:screen-value)
     1683                                            and (if fill-in-code-system:screen-value>"" then
     1684                                                 X_ext-classif.CharKey_Three = fill-in-code-system:screen-value else true )
     1685                                            and X_ext-classif.classif-subject = 'clients':U
     1686                                            and X_ext-classif.classif-name = 'id_diadok_client':U no-error.
     1687     if available X_ext-classif then reposition br-ext-contragent to rowid rowid(X_ext-classif).
     1688                              else message "Указанный код клиента в TH отсутствует. ".
     1689     apply "entry" to br-ext-contragent in frame Dialog-Frame .
     1690     return no-apply.
     1691   END.
     1692   ON ENTER OF fill-in-code-system IN FRAME Dialog-Frame
     1693   DO:
     1694      find first X_ext-classif no-lock  where
     1695                                           X_ext-classif.CharKey_Three begins fill-in-code-system:screen-value
     1696                                           and (if fill-in-code-th:screen-value > "" then
     1697                                                X_ext-classif.Key#_One = integer(fill-in-code-th:screen-value) else true)
     1698                                           and X_ext-classif.classif-subject = 'clients':U
     1699                                           and X_ext-classif.classif-name = 'id_diadok_client':U no-error.
     1700     if available X_ext-classif then reposition br-ext-contragent to rowid rowid(X_ext-classif).
     1701                              else message "Указанный ИД Диадок отсутствует. ".
     1702     apply "entry" to br-ext-contragent in frame Dialog-Frame .
     1703     return no-apply.
     1704   END.
     1705   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1706   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1707   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1708   on help of frame Dialog-Frame
     1709   do:
     1710     run gbl/app_help.p
     1711       (input this-procedure :file-name
     1712       ,input ''
     1713       ,input ?
     1714       ) no-error.
     1715     if error-status :error then do:
     1716       message
     1717         "Ошибка при вызове помощи"
     1718         error-status :get-message(1)
     1719         view-as alert-box .
     1720     end.
     1721   end.
     1722   run minbtn-set in this-procedure .
     1723   on choose of b-help in frame Dialog-Frame
     1724   do:
     1725     apply "help":u to frame Dialog-Frame .
     1726   end.
     1727   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1728   procedure minbtn-set :
     1729       do
     1730           on error undo, return error return-value
     1731           :
     1732           define variable ii              as integer       no-undo .
     1733           define variable fh              as widget-handle no-undo .
     1734           define variable hh              as widget-handle no-undo .
     1735           define variable v-h             as handle        extent 4 no-undo .
     1736           define variable v-name-button   as character     no-undo .
     1737           define variable v-help-old-x    as decimal       no-undo .
     1738           define variable v-help-old-y    as decimal       no-undo .
     1739           define variable v-help-old-size as decimal       no-undo .
     1740           define variable v-frame-width   as decimal       no-undo .
     1741           define variable jj              as integer       no-undo .
     1742           do
     1743               on error undo, return error
     1744               :
     1745               assign
     1746                   v-frame-width = frame Dialog-Frame:width - 0.3
     1747                   fh            = frame Dialog-Frame:first-child
     1748                   hh            = fh:first-child
     1749                   ii            = 1
     1750                   .
     1751               do while valid-handle(hh):
     1752                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1753                   do:
     1754                       case lc(hh:name) :
     1755                           when "b-help" then
     1756                               do:
     1757                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1758                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1759                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1760                                   hh:TOOLTIP = "Помощь" .
     1761                                   v-help-old-x = hh:column .
     1762                                   v-help-old-y = hh:row    .
     1763                                   v-help-old-size = hh:width .
     1764                                   hh:width-chars = 2.5 .
     1765                               end.
     1766                           when "b-print" then
     1767                               do:
     1768                                   hh:load-image("cmp/b-print.bmp":u) .
     1769                                   hh:TOOLTIP = "Печать" .
     1770                                   v-h[ii] = hh:handle .
     1771                                   ii = ii + 1 .
     1772                                   hh:width-chars = 3 .
     1773                               end.
     1774                           when "b-history" or
     1775                           when "b-hist" then
     1776                               do:
     1777                                   hh:load-image("cmp/b-hist.bmp":u) .
     1778                                   hh:TOOLTIP = "История" .
     1779                                   v-h[ii] = hh:handle .
     1780                                   ii = ii + 1 .
     1781                                   hh:width-chars = 3 .
     1782                               end.
     1783                           when "b-sch" then
     1784                               do:
     1785                                   hh:load-image("cmp/b-sch.bmp":u) .
     1786                                   hh:TOOLTIP = "Установка Фильтра" .
     1787                                   v-h[ii] = hh:handle .
     1788                                   ii = ii + 1 .
     1789                                   hh:width-chars = 3 .
     1790                               end.
     1791                           when "b-hist-user" then
     1792                               do:
     1793                                   hh:load-image("cmp/b-hist.bmp":u) .
     1794                                   hh:TOOLTIP = "История пользователя" .
     1795                                   ii = ii + 1 .
     1796                               end.
     1797                       end case.
     1798                   end.
     1799                   hh = hh:next-sibling.
     1800               end.
     1801               b-help:column = v-frame-width - b-help:width-chars.
     1802               jj = 0.
     1803               repeat ii = 4 to 1 by -1 :
     1804                   if valid-handle (v-h[ii] ) then
     1805                   do:
     1806                       jj  = jj + 1 .
     1807                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1808                       v-h[ii]:row    = v-help-old-y .
     1809                   end.
     1810               end.
     1811           end.
     1812       end.
     1813   end procedure.
     1814   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1815   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1816   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1817   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1818   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1819   define variable v-diasize-current-frame-height as decimal   no-undo .
     1820   define variable v-diasize-change-size          as logical   no-undo .
     1821   define variable v-diasize-resize-button        as handle    no-undo .
     1822   define variable v-diasize-wndmax               as logical   no-undo .
     1823   define variable v-diasize-wndstore             as logical   no-undo .
     1824   define variable v-diasize-proc-name            as character no-undo .
     1825   define variable v-diasize-browse-handle        as handle    no-undo .
     1826   define variable v-diasize-browse-number        as integer   no-undo .
     1827   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1828   define temp-table temp-diasize-handle no-undo
     1829     field handle-value  as handle
     1830     field save-position as decimal
     1831     index xpk is primary unique handle-value
     1832     .
     1833   define temp-table temp-browse-handle no-undo
     1834     field browse-type   as character
     1835     field browse-number as integer
     1836     field browse-handle as handle
     1837     field original-size as decimal
     1838     index xpk is primary unique browse-type browse-number
     1839     index xie browse-type browse-handle
     1840   .
     1841   procedure diasize_change-height :
     1842     define input  parameter p-change-value  as decimal   no-undo .
     1843     define input  parameter p-move-resize   as logical   no-undo .
     1844     define variable v-field-group-handle    as handle    no-undo .
     1845     define variable v-object-handle         as handle    no-undo .
     1846     define variable v-frame-height          as decimal   no-undo .
     1847     define variable v-frame-virtual-height  as decimal   no-undo .
     1848     define variable v-browse-height         as decimal   no-undo .
     1849     define variable v-window-height         as decimal   no-undo .
     1850     define variable v-window-virtual-height as decimal   no-undo .
     1851     define variable v-change-sign           as integer   no-undo .
     1852     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1853     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1854     if p-change-value > 0
     1855     then do:
     1856       if frame Dialog-Frame :height + p-change-value
     1857           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1858       then do:
     1859         assign
     1860           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1861                           - (frame Dialog-Frame :height-chars)
     1862         .
     1863         if p-change-value <= 0
     1864         then do:
     1865           run diasize_position-resize-button in this-procedure .
     1866           return .
     1867         end.
     1868       end.
     1869     end.
     1870     if p-change-value < 0
     1871     then do:
     1872       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1873       then do:
     1874         assign
     1875           p-change-value = v-diasize-orig-frame-height
     1876                          - (frame Dialog-Frame :height-chars)
     1877         .
     1878         if p-change-value >= 0
     1879         then do:
     1880           run diasize_position-resize-button in this-procedure .
     1881           return .
     1882         end.
     1883       end.
     1884     end.
     1885     if p-change-value >= 0
     1886     then do:
     1887       assign
     1888         v-change-sign = 1
     1889       .
     1890     end.
     1891     else do:
     1892       assign
     1893         v-change-sign = -1
     1894       .
     1895     end.
     1896     assign
     1897       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1898     .
     1899     if p-change-value = 0
     1900     then do:
     1901       run diasize_position-resize-button in this-procedure .
     1902       return .
     1903     end.
     1904     move_block:
     1905     do
     1906     on error undo move_block, retry move_block
     1907     :
     1908       if retry
     1909       then do:
     1910         do
     1911         on error undo move_block, leave move_block
     1912         :
     1913           if p-change-value > 0
     1914           then do:
     1915             for each buf_temp-diasize-handle
     1916             on error undo, next
     1917             :
     1918               assign
     1919                 v-object-handle = buf_temp-diasize-handle.handle-value
     1920               .
     1921               if v-object-handle <> v-diasize-resize-button
     1922               then do:
     1923                 assign
     1924                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1925                 .
     1926               end.
     1927             end.
     1928             assign
     1929               v-diasize-browse-handle :height = v-browse-height
     1930             .
     1931             for each buf_temp-browse-handle
     1932               where buf_temp-browse-handle.browse-type = 'height':u
     1933             on error undo, next
     1934             :
     1935               assign
     1936                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1937               .
     1938             end.
     1939             assign
     1940               frame Dialog-Frame :height = v-frame-height
     1941             .
     1942             if frame Dialog-Frame :scrollable = true
     1943             then do:
     1944               assign
     1945                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1946               .
     1947             end.
     1948             run diasize_position-resize-button in this-procedure .
     1949           end.
     1950           else do:
     1951             if frame Dialog-Frame :scrollable = true
     1952             then do:
     1953               assign
     1954                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1955               .
     1956             end.
     1957             assign
     1958               frame Dialog-Frame :height = v-frame-height
     1959             .
     1960             assign
     1961               v-diasize-browse-handle :height = v-browse-height
     1962             .
     1963             for each buf_temp-browse-handle
     1964               where buf_temp-browse-handle.browse-type = 'height':u
     1965             on error undo, next
     1966             :
     1967               assign
     1968                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1969               .
     1970             end.
     1971             for each buf_temp-diasize-handle
     1972             on error undo, next
     1973             :
     1974               assign
     1975                 v-object-handle = buf_temp-diasize-handle.handle-value
     1976               .
     1977               if v-object-handle <> v-diasize-resize-button
     1978               then do:
     1979                 assign
     1980                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1981                 .
     1982               end.
     1983             end.
     1984             run diasize_position-resize-button in this-procedure .
     1985           end.
     1986           assign
     1987             v-diasize-change-size = false
     1988           .
     1989           leave move_block .
     1990         end.
     1991       end.
     1992       assign
     1993         v-diasize-need-full-display = true
     1994       .
     1995       if v-diasize-change-size = false
     1996       then do:
     1997         assign
     1998           v-diasize-change-size = true
     1999         .
     2000       end.
     2001       else do:
     2002         return .
     2003       end.
     2004       assign
     2005         v-frame-height = frame Dialog-Frame :height
     2006         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2007         v-browse-height = v-diasize-browse-handle :height
     2008       .
     2009       for each buf_temp-browse-handle
     2010         where buf_temp-browse-handle.browse-type = 'height':u
     2011       :
     2012         assign
     2013           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2014         .
     2015       end.
     2016       for each buf_temp-diasize-handle
     2017       :
     2018         delete buf_temp-diasize-handle .
     2019       end.
     2020       assign
     2021         v-field-group-handle = frame Dialog-Frame :first-child
     2022       .
     2023       do while valid-handle(v-field-group-handle)
     2024       :
     2025         assign
     2026           v-object-handle = v-field-group-handle :first-child
     2027         .
     2028         do while valid-handle(v-object-handle)
     2029         :
     2030           if  v-object-handle <> v-diasize-browse-handle :handle
     2031           and can-query(v-object-handle, "row")
     2032           and can-query(v-object-handle, "height")
     2033           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2034           then do:
     2035             find first buf_temp-browse-handle
     2036               where buf_temp-browse-handle.browse-type   = 'height':u
     2037                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2038               no-error .
     2039             if available buf_temp-browse-handle
     2040             then do:
     2041             end.
     2042             else do:
     2043               create buf_temp-diasize-handle .
     2044               assign
     2045                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2046                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2047               .
     2048             end.
     2049           end.
     2050           assign
     2051             v-object-handle = v-object-handle :next-sibling
     2052           .
     2053         end.
     2054         assign
     2055           v-field-group-handle = v-field-group-handle :next-sibling
     2056         .
     2057       end.
     2058       do with frame Dialog-Frame
     2059       :
     2060         hide v-diasize-resize-button .
     2061         assign
     2062           v-diasize-resize-button :row    = 1
     2063           v-diasize-resize-button :column = 1
     2064         .
     2065       end.
     2066       if p-change-value > 0
     2067       then do:
     2068         if frame Dialog-Frame :scrollable = true
     2069         then do:
     2070           assign
     2071             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2072             no-error .
     2073           if error-status :error
     2074           or error-status :get-message(1) <> ""
     2075           then do:
     2076             undo move_block, retry move_block .
     2077           end.
     2078         end.
     2079         assign
     2080           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2081           no-error .
     2082         if error-status :error
     2083         or error-status :get-message(1) <> ""
     2084         then do:
     2085           undo move_block, retry move_block .
     2086         end.
     2087         assign
     2088           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2089           no-error .
     2090         if error-status :error
     2091         or error-status :get-message(1) <> ""
     2092         then do:
     2093           undo move_block, retry move_block .
     2094         end.
     2095         for each buf_temp-browse-handle
     2096           where buf_temp-browse-handle.browse-type = 'height':u
     2097         on error undo move_block, retry move_block
     2098         :
     2099           assign
     2100             buf_temp-browse-handle.browse-handle :height
     2101               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2102             no-error .
     2103           if error-status :error
     2104           or error-status :get-message(1) <> ""
     2105           then do:
     2106             undo move_block, retry move_block .
     2107           end.
     2108         end.
     2109         for each buf_temp-diasize-handle
     2110         on error undo move_block, retry move_block
     2111         :
     2112           assign
     2113             v-object-handle = buf_temp-diasize-handle.handle-value
     2114           .
     2115           if v-object-handle <> v-diasize-resize-button
     2116           then do:
     2117             assign
     2118               v-object-handle :row = v-object-handle :row + p-change-value
     2119               no-error .
     2120             if error-status :error
     2121             or error-status :get-message(1) <> ""
     2122             then do:
     2123               undo move_block, retry move_block .
     2124             end.
     2125           end.
     2126         end.
     2127       end.
     2128       else do:
     2129         for each buf_temp-diasize-handle
     2130         on error undo move_block, retry move_block
     2131         :
     2132           assign
     2133             v-object-handle = buf_temp-diasize-handle.handle-value
     2134           .
     2135           if v-object-handle <> v-diasize-resize-button
     2136           then do:
     2137             assign
     2138               v-object-handle :row = v-object-handle :row + p-change-value
     2139               no-error .
     2140             if error-status :error
     2141             or error-status :get-message(1) <> ""
     2142             then do:
     2143               undo move_block, retry move_block .
     2144             end.
     2145           end.
     2146         end.
     2147         assign
     2148           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2149           no-error .
     2150         if error-status :error
     2151         or error-status :get-message(1) <> ""
     2152         then do:
     2153           undo move_block, retry move_block .
     2154         end.
     2155         for each buf_temp-browse-handle
     2156           where buf_temp-browse-handle.browse-type = 'height':u
     2157         on error undo move_block, retry move_block
     2158         :
     2159           assign
     2160             buf_temp-browse-handle.browse-handle :height
     2161               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2162             no-error .
     2163           if error-status :error
     2164           or error-status :get-message(1) <> ""
     2165           then do:
     2166             undo move_block, retry move_block .
     2167           end.
     2168         end.
     2169         assign
     2170           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2171           no-error .
     2172         if error-status :error
     2173         or error-status :get-message(1) <> ""
     2174         then do:
     2175           undo move_block, retry move_block .
     2176         end.
     2177         if frame Dialog-Frame :scrollable = true
     2178         then do:
     2179           assign
     2180             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2181             no-error .
     2182           if error-status :error
     2183           or error-status :get-message(1) <> ""
     2184           then do:
     2185             undo move_block, retry move_block .
     2186           end.
     2187         end.
     2188       end.
     2189       if p-move-resize = true
     2190       then do:
     2191         run diasize_position-resize-button in this-procedure .
     2192       end.
     2193       if v-diasize-wndstore = true
     2194       then do:
     2195         if connected("ub") = true
     2196         then do:
     2197           define variable v-cntxt-db-num        as integer   no-undo .
     2198           define variable v-cntxt-userid        as character no-undo .
     2199           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2200                                             , OUTPUT v-cntxt-userid
     2201                                             ) .
     2202           run gbl/wndsizew.p
     2203             (input  v-cntxt-db-num
     2204             ,input  v-cntxt-userid
     2205             ,input  v-diasize-proc-name
     2206             ,input  'height':u
     2207             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2208             ) .
     2209         end.
     2210       end.
     2211     end.
     2212     assign
     2213       v-diasize-change-size = false
     2214     .
     2215   end procedure.
     2216   procedure diasize_set-height :
     2217     define input  parameter p-new-height  as decimal   no-undo .
     2218     define input  parameter p-move-resize as logical   no-undo .
     2219     do
     2220     on error undo, return error return-value
     2221     :
     2222       run diasize_change-height in this-procedure
     2223         (input  (p-new-height - frame Dialog-Frame :height)
     2224         ,input  p-move-resize
     2225         ) .
     2226     end.
     2227   end procedure.
     2228   procedure diasize_change-width :
     2229     define input  parameter p-change-value as decimal   no-undo .
     2230     define input  parameter p-move-resize  as logical   no-undo .
     2231     define variable v-field-group-handle   as handle    no-undo .
     2232     define variable v-object-handle        as handle    no-undo .
     2233     define variable v-frame-width          as decimal   no-undo .
     2234     define variable v-frame-virtual-width  as decimal   no-undo .
     2235     define variable v-browse-width         as decimal   no-undo .
     2236     define variable v-window-width         as decimal   no-undo .
     2237     define variable v-window-virtual-width as decimal   no-undo .
     2238     define variable v-change-sign          as integer   no-undo .
     2239     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2240     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2241     if p-change-value > 0
     2242     then do:
     2243       if frame Dialog-Frame :width + p-change-value >
     2244           session :width-chars
     2245       then do:
     2246         assign
     2247           p-change-value = session :width-chars - frame Dialog-Frame :width
     2248         .
     2249         if p-change-value <= 0
     2250         then do:
     2251           run diasize_position-resize-button in this-procedure .
     2252           return .
     2253         end.
     2254       end.
     2255     end.
     2256     if p-change-value < 0
     2257     then do:
     2258       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2259       then do:
     2260         assign
     2261           p-change-value = v-diasize-orig-frame-width
     2262                          - frame Dialog-Frame :width
     2263         .
     2264         if p-change-value >= 0
     2265         then do:
     2266           run diasize_position-resize-button in this-procedure .
     2267           return .
     2268         end.
     2269       end.
     2270     end.
     2271     if p-change-value >= 0
     2272     then do:
     2273       assign
     2274         v-change-sign = 1
     2275       .
     2276     end.
     2277     else do:
     2278       assign
     2279         v-change-sign = -1
     2280       .
     2281     end.
     2282     assign
     2283       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2284     .
     2285     if p-change-value = 0
     2286     then do:
     2287       run diasize_position-resize-button in this-procedure .
     2288       return .
     2289     end.
     2290     move_block:
     2291     do
     2292     on error undo move_block, leave move_block
     2293     :
     2294       if retry
     2295       then do:
     2296         do
     2297         on error undo move_block, leave move_block
     2298         :
     2299           if p-change-value > 0
     2300           then do:
     2301             for each buf_temp-diasize-handle
     2302             on error undo, next
     2303             :
     2304               assign
     2305                 v-object-handle = buf_temp-diasize-handle.handle-value
     2306               .
     2307               if v-object-handle <> v-diasize-resize-button
     2308               then do:
     2309                 assign
     2310                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2311                 .
     2312               end.
     2313             end.
     2314             assign
     2315               v-diasize-browse-handle :width = v-browse-width
     2316             .
     2317             for each buf_temp-browse-handle
     2318               where buf_temp-browse-handle.browse-type = 'width':u
     2319             on error undo, next
     2320             :
     2321               assign
     2322                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2323               .
     2324             end.
     2325             assign
     2326               frame Dialog-Frame :width = v-frame-width
     2327             .
     2328             if frame Dialog-Frame :scrollable = true
     2329             then do:
     2330               assign
     2331                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2332               .
     2333             end.
     2334             run diasize_position-resize-button in this-procedure .
     2335           end.
     2336           else do:
     2337             if frame Dialog-Frame :scrollable = true
     2338             then do:
     2339               assign
     2340                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2341               .
     2342             end.
     2343             assign
     2344               frame Dialog-Frame :width = v-frame-width
     2345             .
     2346             for each buf_temp-browse-handle
     2347               where buf_temp-browse-handle.browse-type = 'width':u
     2348             on error undo, next
     2349             :
     2350               assign
     2351                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2352               .
     2353             end.
     2354             assign
     2355               v-diasize-browse-handle :width = v-browse-width
     2356             .
     2357             for each buf_temp-diasize-handle
     2358             on error undo, next
     2359             :
     2360               assign
     2361                 v-object-handle = buf_temp-diasize-handle.handle-value
     2362               .
     2363               if v-object-handle <> v-diasize-resize-button
     2364               then do:
