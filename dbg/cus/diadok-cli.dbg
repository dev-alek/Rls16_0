     2380       .
     2381       if v-diasize-change-size = false
     2382       then do:
     2383         assign
     2384           v-diasize-change-size = true
     2385         .
     2386       end.
     2387       else do:
     2388         return .
     2389       end.
     2390       assign
     2391         v-frame-width = frame Dialog-Frame :width
     2392         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2393         v-browse-width = v-diasize-browse-handle :width
     2394       .
     2395       for each buf_temp-browse-handle
     2396         where buf_temp-browse-handle.browse-type = 'width':u
     2397       :
     2398         assign
     2399           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2400         .
     2401       end.
     2402       for each buf_temp-diasize-handle
     2403       :
     2404         delete buf_temp-diasize-handle .
     2405       end.
     2406       assign
     2407         v-field-group-handle = frame Dialog-Frame :first-child
     2408       .
     2409       do while valid-handle(v-field-group-handle)
     2410       :
     2411         assign
     2412           v-object-handle = v-field-group-handle :first-child
     2413         .
     2414         do while valid-handle(v-object-handle)
     2415         :
     2416           if  v-object-handle <> v-diasize-browse-handle :handle
     2417           and v-object-handle <> v-diasize-resize-button
     2418           and can-query(v-object-handle, "row")
     2419           and can-query(v-object-handle, "height")
     2420           and ( v-object-handle :col + v-object-handle :width
     2421                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2422               )
     2423           then do:
     2424             find first buf_temp-browse-handle
     2425               where buf_temp-browse-handle.browse-type   = 'width':u
     2426                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2427               no-error .
     2428             if available buf_temp-browse-handle
     2429             then do:
     2430             end.
     2431             else do:
     2432               create buf_temp-diasize-handle .
     2433               assign
     2434                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2435                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2436               .
     2437             end.
     2438           end.
     2439           assign
     2440             v-object-handle = v-object-handle :next-sibling
     2441           .
     2442         end.
     2443         assign
     2444           v-field-group-handle = v-field-group-handle :next-sibling
     2445         .
     2446       end.
     2447       do with frame Dialog-Frame
     2448       :
     2449         hide v-diasize-resize-button .
     2450         v-diasize-resize-button :row = 1.
     2451         v-diasize-resize-button :column = 1.
     2452       end.
     2453       if p-change-value > 0
     2454       then do:
     2455         if frame Dialog-Frame :scrollable = true
     2456         then do:
     2457           assign
     2458             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2459             no-error .
     2460           if error-status :error
     2461           or error-status :get-message(1) <> ""
     2462           then do:
     2463             undo move_block, retry move_block.
     2464           end.
     2465         end.
     2466         assign
     2467           frame Dialog-Frame :width = v-frame-width + p-change-value
     2468           no-error .
     2469         if error-status :error
     2470         or error-status :get-message(1) <> ""
     2471         then do:
     2472           undo move_block, retry move_block.
     2473         end.
     2474         assign
     2475           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2476         no-error .
     2477         if error-status :error
     2478         or error-status :get-message(1) <> ""
     2479         then do:
     2480           undo move_block, retry move_block.
     2481         end.
     2482         for each buf_temp-browse-handle
     2483           where buf_temp-browse-handle.browse-type = 'width':u
     2484         on error undo move_block, retry move_block
     2485         :
     2486           assign
     2487             buf_temp-browse-handle.browse-handle :width
     2488               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2489             no-error .
     2490           if error-status :error
     2491           or error-status :get-message(1) <> ""
     2492           then do:
     2493             undo move_block, retry move_block .
     2494           end.
     2495         end.
     2496         for each buf_temp-diasize-handle
     2497         on error undo move_block, retry move_block
     2498         :
     2499           assign
     2500             v-object-handle = buf_temp-diasize-handle.handle-value
     2501           .
     2502           if v-object-handle <> v-diasize-resize-button
     2503           then do:
     2504             assign
     2505               v-object-handle :col = v-object-handle :col + p-change-value
     2506               no-error .
     2507             if error-status :error
     2508             or error-status :get-message(1) <> ""
     2509             then do:
     2510               undo move_block, retry move_block .
     2511             end.
     2512           end.
     2513         end.
     2514       end.
     2515       else do:
     2516         for each buf_temp-diasize-handle
     2517         on error undo move_block, retry move_block
     2518         :
     2519           assign
     2520             v-object-handle = buf_temp-diasize-handle.handle-value
     2521           .
     2522           if v-object-handle <> v-diasize-resize-button
     2523           then do:
     2524             assign
     2525               v-object-handle :col = v-object-handle :col + p-change-value
     2526               no-error .
     2527             if error-status :error
     2528             or error-status :get-message(1) <> ""
     2529             then do:
     2530               undo move_block, retry move_block .
     2531             end.
     2532           end.
     2533         end.
     2534         for each buf_temp-browse-handle
     2535           where buf_temp-browse-handle.browse-type = 'width':u
     2536         on error undo move_block, retry move_block
     2537         :
     2538           assign
     2539             buf_temp-browse-handle.browse-handle :width
     2540               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2541             no-error .
     2542           if error-status :error
     2543           or error-status :get-message(1) <> ""
     2544           then do:
     2545             undo move_block, retry move_block .
     2546           end.
     2547         end.
     2548         assign
     2549           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2550           no-error .
     2551         if error-status :error
     2552         or error-status :get-message(1) <> ""
     2553         then do:
     2554           undo move_block, retry move_block.
     2555         end.
     2556         assign
     2557           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2558         no-error .
     2559         if error-status :error
     2560         or error-status :get-message(1) <> ""
     2561         then do:
     2562           undo move_block, retry move_block.
     2563         end.
     2564         if frame Dialog-Frame :scrollable = true
     2565         then do:
     2566           assign
     2567             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2568           no-error .
     2569           if error-status :error
     2570           or error-status :get-message(1) <> ""
     2571           then do:
     2572             undo move_block, retry move_block.
     2573           end.
     2574         end.
     2575       end.
     2576       if p-move-resize
     2577       then do:
     2578         run diasize_position-resize-button in this-procedure .
     2579       end.
     2580       if v-diasize-wndstore = true
     2581       then do:
     2582         if connected("ub") = true
     2583         then do:
     2584           define variable v-cntxt-db-num        as integer   no-undo .
     2585           define variable v-cntxt-userid        as character no-undo .
     2586           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2587                                             , OUTPUT v-cntxt-userid
     2588                                             ) .
     2589           run gbl/wndsizew.p
     2590             (input  v-cntxt-db-num
     2591             ,input  v-cntxt-userid
     2592             ,input  v-diasize-proc-name
     2593             ,input  'width':u
     2594             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2595             ) .
     2596         end.
     2597       end.
     2598     end.
     2599     assign
     2600       v-diasize-change-size = false
     2601     .
     2602   end procedure.
     2603   procedure diasize_set-width :
     2604     define input  parameter p-new-width  as decimal   no-undo .
     2605     define input  parameter p-move-resize as logical   no-undo .
     2606     do
     2607     on error undo, return error return-value
     2608     :
     2609       run diasize_change-width in this-procedure
     2610         (input  (p-new-width - frame Dialog-Frame :width)
     2611         ,input  p-move-resize
     2612         ) .
     2613     end.
     2614   end procedure.
     2615   procedure diasize_position-resize-button :
     2616     do with frame Dialog-Frame
     2617     :
     2618       hide v-diasize-resize-button .
     2619       assign
     2620         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2621                     - 1
     2622                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2623         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2624                     - 1
     2625                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2626       .
     2627       view v-diasize-resize-button .
     2628     end.
     2629   end procedure.
     2630   on alt-right anywhere
     2631   do:
     2632     run diasize_change-width in this-procedure
     2633       (input 1
     2634       ,input true
     2635       ) .
     2636     return no-apply .
     2637   end.
     2638   on alt-left anywhere
     2639   do:
     2640     run diasize_change-width in this-procedure
     2641       (input -1
     2642       ,input true
     2643       ) .
     2644     return no-apply .
     2645   end.
     2646   on alt-down anywhere
     2647   do:
     2648     run diasize_change-height in this-procedure
     2649       (input 1
     2650       ,input true
     2651       ) .
     2652     return no-apply .
     2653   end.
     2654   on alt-up anywhere
     2655   do:
     2656     run diasize_change-height in this-procedure
     2657       (input -1
     2658       ,input true
     2659       ) .
     2660     return no-apply .
     2661   end.
     2662   on alt-enter of frame Dialog-Frame
     2663   do:
     2664     run diasize_maximize in this-procedure
     2665       (input  ?
     2666       ).
     2667     return no-apply .
     2668   end.
     2669   procedure diasize_end-move :
     2670     do
     2671     on error undo, return error return-value
     2672     :
     2673       define variable v-row-delta as decimal   no-undo .
     2674       define variable v-col-delta as decimal   no-undo .
     2675       define variable v-new-row as decimal   no-undo .
     2676       define variable v-new-col as decimal   no-undo .
     2677       assign
     2678         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2679         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2680       .
     2681       assign
     2682         v-row-delta = v-new-row - frame Dialog-Frame :height
     2683         v-col-delta = v-new-col - frame Dialog-Frame :width
     2684       .
     2685       run diasize_change-height in this-procedure
     2686         (input v-row-delta
     2687         ,input true
     2688         ) .
     2689       run diasize_change-width in this-procedure
     2690         (input v-col-delta
     2691         ,input true
     2692         ) .
     2693     end.
     2694   end procedure.
     2695   procedure diasize_maximize :
     2696     define input  parameter p-action as logical   no-undo .
     2697     do
     2698     on error undo, return error return-value
     2699     :
     2700       if p-action = ?
     2701       then do:
     2702         if v-diasize-need-maximize = true
     2703         then do:
     2704           assign
     2705             p-action = true
     2706           .
     2707         end.
     2708         else do:
     2709           assign
     2710             p-action = false
     2711           .
     2712         end.
     2713       end.
     2714       if p-action = true
     2715       then do:
     2716         run diasize_change-height in this-procedure
     2717           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2718               - frame Dialog-Frame :height-chars
     2719           ,input true
     2720           ) .
     2721         run diasize_change-width in this-procedure
     2722           (input session :width-chars
     2723               - frame Dialog-Frame :width-chars
     2724           ,input true
     2725           ) .
     2726         assign
     2727           v-diasize-need-maximize = false
     2728         .
     2729       end.
     2730       else do:
     2731         run diasize_change-width in this-procedure
     2732           (input v-diasize-orig-frame-width
     2733               - frame Dialog-Frame :width-chars
     2734           ,input true
     2735           ) .
     2736         run diasize_change-height in this-procedure
     2737           (input v-diasize-orig-frame-height
     2738               - frame Dialog-Frame :height-chars
     2739           ,input true
     2740           ) .
     2741         assign
     2742           v-diasize-need-maximize = true
     2743         .
     2744       end.
     2745     end.
     2746   end procedure.
     2747   procedure diasize_restore-orig-size :
     2748     do
     2749     on error undo, return error return-value
     2750     :
     2751       assign
     2752         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2753         v-diasize-current-frame-height = frame Dialog-Frame :height
     2754       .
     2755       run diasize_set-height in this-procedure
     2756         (input  v-diasize-orig-frame-height
     2757         ,input  true
     2758         ) .
     2759       run diasize_set-width in this-procedure
     2760         (input  v-diasize-orig-frame-width
     2761         ,input  true
     2762         ) .
     2763     end.
     2764   end procedure.
     2765   procedure diasize_restore-current-size :
     2766     do
     2767     on error undo, return error return-value
     2768     :
     2769       run diasize_set-height in this-procedure
     2770         (input  v-diasize-current-frame-height
     2771         ,input  true
     2772         ) .
     2773       run diasize_set-width in this-procedure
     2774         (input  v-diasize-current-frame-width
     2775         ,input  true
     2776         ) .
     2777     end.
     2778   end procedure.
     2779   procedure diasize_set-browse-handle :
     2780     define input  parameter p-browse-handle as handle   no-undo .
     2781     define buffer buf_temp-browse-handle for temp-browse-handle .
     2782     do
     2783     on error undo, return error return-value
     2784     :
     2785       assign
     2786         v-diasize-browse-handle = p-browse-handle
     2787       .
     2788       for each buf_temp-browse-handle
     2789       on error undo, return error return-value
     2790       :
     2791         delete buf_temp-browse-handle .
     2792       end.
     2793     end.
     2794   end procedure.
     2795   procedure diasize_add_browse :
     2796     define input  parameter p-browse-type   as character no-undo .
     2797     define input  parameter p-browse-handle as handle    no-undo .
     2798     define buffer buf_temp-browse-handle for temp-browse-handle .
     2799     do
     2800     on error undo, return error return-value
     2801     :
     2802       assign
     2803         v-diasize-browse-number = v-diasize-browse-number + 1
     2804       .
     2805       create buf_temp-browse-handle .
     2806       assign
     2807         buf_temp-browse-handle.browse-type   = p-browse-type
     2808         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2809         buf_temp-browse-handle.browse-handle = p-browse-handle
     2810       .
     2811     end.
     2812   end procedure.
     2813   procedure diasize_init :
     2814     define variable v-default-value    as logical   no-undo .
     2815     define variable v-restore-saved    as logical   no-undo .
     2816     define variable v-resize-value-str as character no-undo .
     2817     do
     2818     on error undo, return error return-value
     2819     :
     2820       do with frame Dialog-Frame
     2821       :
     2822         assign
     2823           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2824           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2825           v-diasize-browse-handle     = browse br-ext-contragent :handle
     2826         .
     2827         create button v-diasize-resize-button
     2828         assign
     2829           parent        = frame Dialog-Frame :first-child
     2830           label         = "s"
     2831           height-pixels = 16
     2832           width-pixels  = 16
     2833           visible       = true
     2834           sensitive     = true
     2835           movable       = true
     2836           triggers:
     2837             on end-move persistent run diasize_end-move in this-procedure .
     2838           end triggers.
     2839         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2840         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2841         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2842         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2843         assign
     2844           v-diasize-wndmax = false
     2845         .
     2846         if connected("ub") = true
     2847         then do:
     2848           define variable v-cntxt-db-num        as integer   no-undo .
     2849           define variable v-cntxt-userid        as character no-undo .
     2850           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2851                                             , OUTPUT v-cntxt-userid
     2852                                             ) .
     2853           run gbl/wndpar_r.p
     2854             (input  v-cntxt-db-num
     2855             ,input  v-cntxt-userid
     2856             ,input  'wndmax':U
     2857             ,output v-diasize-wndmax
     2858             ,output v-default-value
     2859             ) .
     2860         end.
     2861         assign
     2862           v-diasize-wndstore = false
     2863         .
     2864         if connected("ub") = true
     2865         then do:
     2866           run gbl/wndpar_r.p
     2867             (input  v-cntxt-db-num
     2868             ,input  v-cntxt-userid
     2869             ,input  'wndstore':U
     2870             ,output v-diasize-wndstore
     2871             ,output v-default-value
     2872             ) .
     2873         end.
     2874         assign
     2875           v-diasize-proc-name = entry(1, program-name(2), '.')
     2876         .
     2877         if v-diasize-wndstore = true
     2878         then do:
     2879           assign
     2880             v-restore-saved = false
     2881           .
     2882           if connected("ub") = true
     2883           then do:
     2884             run gbl/wndsizer.p
     2885               (input  v-cntxt-db-num
     2886               ,input  v-cntxt-userid
     2887               ,input  v-diasize-proc-name
     2888               ,input  'height':u
     2889               ,output v-resize-value-str
     2890               ) .
     2891             if v-resize-value-str <> '':U
     2892             then do:
     2893               run diasize_change-height in this-procedure
     2894                 (input  integer(v-resize-value-str)
     2895                 ,input  true
     2896                 ) .
     2897               assign
     2898                 v-restore-saved = true
     2899               .
     2900             end.
     2901           end.
     2902           if connected("ub") = true
     2903           then do:
     2904             run gbl/wndsizer.p
     2905               (input  v-cntxt-db-num
     2906               ,input  v-cntxt-userid
     2907               ,input  v-diasize-proc-name
     2908               ,input  'width':u
     2909               ,output v-resize-value-str
     2910               ) .
     2911             if v-resize-value-str <> '':U
     2912             then do:
     2913               run diasize_change-width in this-procedure
     2914                 (input  integer(v-resize-value-str)
     2915                 ,input  true
     2916                 ) .
     2917               assign
     2918                 v-restore-saved = true
     2919               .
     2920             end.
     2921           end.
     2922           if v-restore-saved <> true
     2923           then do:
     2924             if v-diasize-wndmax = true
     2925             then do:
     2926               run diasize_maximize in this-procedure
     2927                 (input  true
     2928                 ) .
     2929             end.
     2930           end.
     2931         end.
     2932         else do:
     2933           if v-diasize-wndmax = true
     2934           then do:
     2935             run diasize_maximize in this-procedure
     2936               (input  true
     2937               ) .
     2938           end.
     2939         end.
     2940       end.
     2941     end.
     2942   end procedure.
     2943   procedure diasize_need-full-display :
     2944     define output parameter p-need-full-display as logical   no-undo .
     2945     do
     2946     on error undo, return error return-value
     2947     :
     2948       assign
     2949         p-need-full-display = v-diasize-need-full-display
     2950       .
     2951       assign
     2952         v-diasize-need-full-display = false
     2953       .
     2954     end.
     2955   end procedure.
     2956   procedure get-context :
     2957      define output parameter p-db-num as integer          no-undo.
     2958      define output parameter p-user-id as character        no-undo.
     2959      define variable v-login               as character    no-undo.
     2960      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2961      define buffer buf_user-login  for ub.user-login .
     2962      do
     2963      on error undo, return error
     2964      :
     2965            FIND FIRST buf_sys-ctrl no-lock.
     2966            ASSIGN
     2967               v-login = USERID("ub")
     2968               p-db-num = buf_sys-ctrl.db-num
     2969            .
     2970            FIND FIRST buf_user-login
     2971                 WHERE buf_user-login.db-num = p-db-num
     2972                   AND buf_user-login.user-login = v-login
     2973                 no-lock
     2974                 no-error
     2975                 .
     2976            IF AVAILABLE buf_user-login
     2977            THEN DO:
     2978               assign
     2979                  p-user-id = buf_user-login.user-id
     2980               .
     2981            END.
     2982      end.
     2983   end procedure.
     2984       run diasize_init in this-procedure .
     2985   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2986   procedure set-filter-name :
     2987   define input parameter p-filter-name as character no-undo .
     2988     do with frame Dialog-Frame:
     2989       if p-filter-name > "" then do:
     2990         assign
     2991           frame Dialog-Frame:title
     2992             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2993         .
     2994         assign
     2995           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2996         .
     2997       end.
     2998       else do:
     2999         assign
     3000           b-sch :tooltip = ""
     3001         .
     3002       end.
     3003     end.
     3004   end procedure.
     3005   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3006   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3007     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3008     return no-apply.
     3009   end.
     3010   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3011   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3012     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3013     return no-apply.
     3014   end.
     3015   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3016   on F8 of frame Dialog-Frame anywhere do:
     3017     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3018     return no-apply.
     3019   end.
     3020   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3021   on INS of frame Dialog-Frame anywhere do:
     3022     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3023     return no-apply.
     3024   end.
     3025   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3026   on F2 of frame Dialog-Frame anywhere do:
     3027     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3028     return no-apply.
     3029   end.
     3030   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3031   on F2 of frame Dialog-Frame anywhere do:
     3032     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3033     return no-apply.
     3034   end.
     3035   MAIN-BLOCK:
     3036   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3037      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3038   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3039     run mainmenu_getcntxt in parparentproc
     3040       (output v-cntxt-db-num
     3041       ,output v-cntxt-userid
     3042       ,output v-cntxt-level
     3043       ,output v-cntxt-host-code-obj
     3044       ,output v-cntxt-obj-type
     3045       ,output v-cntxt-obj-code
     3046       ,output v-cntxt-db-num-obj
     3047       ,output v-cntxt-is-admin
     3048       ) .
     3049     case p-list-mode:
     3050       when 'все':U then do:
     3051       end.
     3052       otherwise do:
     3053          message
     3054          substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3055          view-as alert-box error.
     3056          undo, return error .
     3057       end.
     3058     end.
     3059     v-rid-list = p-rid-list.
     3060     RUN Myenable.
     3061     WAIT-FOR GO OF FRAME Dialog-Frame.
     3062   END.
     3063   RUN disable_UI.
     3064   PROCEDURE disable_UI :
     3065     HIDE FRAME Dialog-Frame.
     3066   END PROCEDURE.
     3067   PROCEDURE enable_UI :
     3068     DISPLAY  mark-num
     3069         WITH FRAME Dialog-Frame.
     3070     ENABLE b-quit B-mark B-sel b-add b-del b-cli b-sch b-print B-Help
     3071            fill-in-code-th fill-in-code-system br-ext-contragent mark-num
     3072         WITH FRAME Dialog-Frame.
     3073     VIEW FRAME Dialog-Frame.
     3074     OPEN QUERY br-ext-contragent FOR EACH X_ext-classif NO-LOCK,        FIRST X_clients NO-LOCK INDEXED-REPOSITION.
     3075   END PROCEDURE.
     3076   PROCEDURE MyEnable :
     3077   ENABLE
     3078   b-quit
     3079   b-cli
     3080   b-print
     3081   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3082   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3083   b-sch
     3084   B-Help
     3085   br-ext-contragent
     3086   fill-in-code-th
     3087   fill-in-code-system
     3088   WITH FRAME Dialog-Frame.
     3089   VIEW FRAME Dialog-Frame.
     3090   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3091   END PROCEDURE.
     3092   PROCEDURE OpenBr :
     3093   define input  parameter p-open-query     as logical   no-undo .
     3094   define input  parameter p-find-next      as logical   no-undo .
     3095   define input  parameter p-find-condition as character no-undo .
     3096   define variable sort-column-phrase as character no-undo .
     3097   define variable l-query-was-opened as logical no-undo .
     3098   define variable title0 as character no-undo .
     3099   define buffer buf_clients for ub.clients.
     3100   case sort-column-name :
     3101     when "" then do:
     3102       assign
     3103         sort-column-phrase = ""
     3104       .
     3105     end.
     3106     otherwise do:
     3107       assign
     3108         sort-column-phrase = "by " + sort-column-name
     3109       .
     3110     end.
     3111   end case.
     3112   filter-point = filter-point0 + p-list-mode .
     3113   case p-list-mode:
     3114    when 'все':U then do:
     3115     title0 = "Коды соответствия клиентов ДИАДОК".
     3116     ASSIGN
     3117     frame Dialog-Frame:title = substitute("&1", title0)
     3118     filter-label = SUBSTITUTE("&1"
     3119                               , frame Dialog-Frame:title
     3120                               )
     3121     .
     3122   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3123   define variable  l-disable-where-27  as logical   no-undo .
     3124   define variable  l-filter-open-27    as logical   .
     3125   define variable  flt-rec-27       as recid     no-undo .
     3126   define variable  filter-name-27      as character no-undo .
     3127   define variable  where-phrase-27     as character no-undo .
     3128   define variable  sort-phrase-27      as character no-undo .
     3129   define variable  where-phrase-rus-27 as character no-undo .
     3130   define variable  sort-phrase-rus-27  as character no-undo .
     3131   run gbl/flt-get.p
     3132     (input filter-point
     3133     ,output flt-rec-27
     3134     ,output filter-name-27
     3135     ,output where-phrase-27
     3136     ,output sort-phrase-27
     3137     ,output where-phrase-rus-27
     3138     ,output sort-phrase-rus-27
     3139     ).
     3140       run set-filter-name in this-procedure
     3141         (INPUT filter-name-27
     3142         ) no-error .
     3143     assign
     3144       l-filter-open-27 = false
     3145     .
     3146     if flt-rec-27 <> ?
     3147       or sort-column-phrase > ""
     3148     then do:
     3149       define variable  parameter-2-27 as character no-undo .
     3150       define variable  parameter-3-27 as character no-undo .
     3151       define variable  parameter-4-27 as character no-undo .
     3152       define variable  parameter-5-27 as character no-undo .
     3153       define variable  parameter-6-27 as character no-undo .
     3154       define variable  parameter-7-27 as character no-undo .
     3155         assign
     3156         parameter-3-27 =
     3157                                 "FOR EACH X_ext-classif"
     3158         parameter-4-27 =
     3159           (
     3160             if (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'id_diadok_client':U" + " " + where-phrase-27) <> ""
     3161             then  substitute('X_ext-classif.classif-subject = &1&2&1                           and X_ext-classif.classif-name = &1&3&1', chr(34), 'clients':U, 'id_diadok_client':U) + " " + where-phrase-27
     3162             else "true"
     3163           )
     3164         parameter-5-27 = (" " + "" + " " + substitute(', FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))'))
     3165         parameter-6-27 = if sort-phrase-27 = ''
     3166                              then
     3167           (
     3168           " " + "  " +
     3169             " " + sort-column-phrase +
     3170           " " + "  "
     3171           )
     3172                              else
     3173           (
     3174           " " + "  " +
     3175             " " + sort-column-phrase +
     3176           " " + sort-phrase-27
     3177           )
     3178         parameter-7-27 =
     3179           " INDEXED-REPOSITION  "
     3180       .
     3181       do
     3182       on stop undo, leave
     3183       on error undo, leave
     3184       :
     3185         assign
     3186           l-disable-where-27 =
     3187             (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'id_diadok_client':U" + " " + where-phrase-27 = "")
     3188         .
     3189         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3190                             ,input QUERY br-ext-contragent:handle
     3191                             ,input parameter-3-27
     3192                             ,input parameter-4-27
     3193                             ,input parameter-5-27
     3194                             ,input parameter-6-27
     3195                             ,input parameter-7-27
     3196                             )
     3197         .
     3198         assign
     3199           l-filter-open-27 = true
     3200         .
     3201       end.
     3202       if l-filter-open-27 = false then do:
     3203         message
     3204           "Ошибка при фильтрации / сортировке" skip
     3205           "Будут показаны записи без учета фильтра" skip
     3206           view-as alert-box .
     3207       end.
     3208       else do:
     3209           assign
     3210             l-query-was-opened = true
     3211           .
     3212       end.
     3213     end.
     3214     if l-filter-open-27 = false then do:
     3215       OPEN QUERY br-ext-contragent FOR EACH X_ext-classif
     3216         where  X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'id_diadok_client':U
     3217       , FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))
     3218         INDEXED-REPOSITION
     3219     .
     3220         assign
     3221           l-query-was-opened = true
     3222         .
     3223     end.
     3224    end.
     3225   end case.
     3226   APPLY "entry" TO br-ext-contragent.
     3227   if available X_ext-classif then do:
     3228       APPLY "VALUE-CHANGED":U to br-ext-contragent.
     3229   END.
     3230   END PROCEDURE.
     3231   PROCEDURE proc-b-add :
     3232   DEFINE VARIABLE v-obj-type AS CHARACTER NO-UNDO.
     3233   define variable v-obj-code as integer no-undo .
     3234   DEFINE VARIABLE v-ext-obj-type AS CHARACTER NO-UNDO.
     3235   define variable v-ext-obj-code as character no-undo .
     3236   DEFINE VARIABLE v-ok AS logical NO-UNDO.
     3237   define variable v-uniq-key-rec as character no-undo .
     3238   define variable v-rid as recid no-undo .
     3239   define buffer buf_db for ub.db .
     3240   define buffer buf_clients for ub.clients.
     3241   run ref\cli-dadd.w( parparentproc
     3242                     , output v-obj-type
     3243                     , output v-obj-code
     3244                     , output v-ext-obj-type
     3245                     , output v-ext-obj-code
     3246                     , output v-ok
     3247                     ).
     3248   if v-ok then do:
     3249     find first buf_clients no-lock
     3250       where buf_clients.obj-type = v-obj-type
     3251         and buf_clients.obj-code = v-obj-code
     3252       no-error.
     3253     if not avail buf_clients then do:
     3254       message
     3255         substitute( "Не возможно найти клиента &1 &2", v-obj-type, string( v-obj-code ) )
     3256         view-as alert-box error .
     3257       undo, return error .
     3258     end.
     3259     run gen-key-rec IN THIS-PROCEDURE
     3260       ( input 'clients':U
     3261        ,input (buffer buf_clients:handle)
     3262        ,output v-uniq-key-rec ).
     3263     run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     3264                         ,INPUT NO
     3265                         ,INPUT-OUTPUT v-rid
     3266                         ,INPUT 'clients':U
     3267                         ,INPUT 'id_diadok_client':U
     3268                         ,input  (-1)
     3269                         ,input v-obj-code
     3270                                             ,input 0
     3271                         ,input 0
     3272                         ,input v-obj-type
     3273                         ,input v-ext-obj-type
     3274                         ,input v-ext-obj-code
     3275                         ,input (if buf_clients.obj-type = 'орг':U then 1000000000 else 0) + buf_clients.obj-code
     3276                         ,input v-uniq-key-rec ) no-error.
     3277     if error-status:error then do:
     3278       undo, return error .
     3279     end.
     3280   end.
     3281   if v-rid <> ? then do:
     3282     run openbr in this-procedure ( input yes, input no, input '':U).
     3283     reposition br-ext-contragent to recid v-rid no-error .
     3284     apply "entry" to br-ext-contragent in frame Dialog-Frame .
     3285   end.
     3286   END PROCEDURE.
     3287   PROCEDURE proc-b-del :
     3288   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3289   DEFINE VARIABLE glog AS logical NO-UNDO.
     3290   IF NOT AVAILABLE X_ext-classif THEN UNDO, RETURN ERROR.
     3291   v-rec = recid(X_ext-classif).
     3292   MESSAGE
     3293   "Вы действительно хотитет удалить эту запись?"
     3294   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3295   IF NOT glog THEN RETURN ERROR.
     3296   run ref/extclas3.p ( INPUT NO
     3297                       ,INPUT v-rec) NO-ERROR.
     3298   if not error-status:error then do:
     3299     run openbr in this-procedure ( input yes, input no, input '':U).
     3300     reposition br-ext-contragent to row 1 no-error .
     3301     apply "entry" to br-ext-contragent in frame Dialog-Frame .
     3302   end.
     3303   END PROCEDURE.
     3304   PROCEDURE proc-b-print :
     3305   DEFINE VARIABLE date_string              as   character no-undo .
     3306   DEFINE VARIABLE Line                     as   character no-undo .
     3307   DEFINE VARIABLE for-time                 as   character no-undo .
     3308   DEFINE VARIABLE accum-count              as   integer   no-undo .
     3309   define variable v-rid                    as   recid no-undo .
     3310   DEFINE VARIABLE v-firm-name AS CHARACTER NO-UNDO.
     3311   DEFINE FRAME list1
     3312   X_ext-classif.CharKey_One COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     3313   X_ext-classif.KEY#_one  COLUMN-LABEL "Код!клиента" FORMAT ">>>>9"
     3314   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(45)"
     3315   X_ext-classif.CharKey_two COLUMN-LABEL "Тип!контрагента" FORMAT "X(3)"
     3316   X_ext-classif.charkey_three COLUMN-LABEL "Код!контрагента" FORMAT "X(15)"
     3317   v-firm-name COLUMN-LABEL "Название контрагента" FORMAT "X(45)"
     3318   HEADER  date_string AT 5 format "X(35)"
     3319   string( "Страница " ) format "X(9)" AT 75 PAGE-NUMBER(PrnLibStream) AT 85 FORMAT ">>9" SKIP
     3320   Line format "X(131)" AT 1
     3321   with width 232 down stream-io use-text    .
     3322   Line = fill("-", 131).
     3323   date_string = cur-time-print() .
     3324   run prn-lib-open-stream  in this-procedure (
     3325                                                input parParentProc
     3326                                               ,input  62
     3327                                               ,input yes
     3328                                               ,input no
     3329                                               ).
     3330   PUT  STREAM PrnLibStream
     3331   SPACE(25) ( frame Dialog-Frame:title )
     3332   format "x(131)" SKIP(1) .
     3333   FORM HEADER
     3334   Line format "X(131)" AT 1 SKIP
     3335   "Продолжение - на следующей странице" AT 30 SKIP
     3336   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3337   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3338   v-rid = recid(X_ext-classif).
     3339   FORM with FRAME List1.
     3340   run waitfram-show in this-procedure ( input "Ждите...").
     3341   DO WHILE available X_ext-classif :
     3342      GET prev br-ext-contragent.
     3343   END.
     3344   GET next br-ext-contragent.
     3345   DO WHILE available X_ext-classif :
     3346     v-firm-name = get-client-name(X_ext-classif.charkey_three,X_ext-classif.CharKey_two).
     3347     Display STREAM PrnLibStream
     3348     X_ext-classif.CharKey_One
     3349     X_ext-classif.KEY#_one
     3350     X_clients.obj-name
     3351     X_ext-classif.CharKey_two
     3352     X_ext-classif.charkey_three
     3353     v-firm-name
     3354     with FRAME List1.
     3355     DOWN STREAM PrnLibStream
     3356     1
     3357     with FRAME List1.
     3358     assign
     3359     accum-count = accum-count + 1
     3360     .
     3361     GET next br-ext-contragent.
     3362   END.
     3363   UNDERLINE  STREAM PrnLibStream
     3364   X_ext-classif.CharKey_One
     3365   X_ext-classif.KEY#_one
     3366   X_clients.obj-name
     3367   X_ext-classif.CharKey_two
     3368   X_ext-classif.charkey_three
     3369   v-firm-name
     3370   with FRAME List1.
     3371   DISPLAY STREAM PrnLibStream
     3372   accum-count @ X_ext-classif.key#_one
     3373   with frame List1.
     3374   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3375   HIDE  STREAM PrnLibStream FRAME List1.
     3376   output  STREAM PrnLibStream CLOSE.
     3377   reposition br-ext-contragent to recid v-rid no-error .
     3378   apply "ENTRY" to br-ext-contragent in frame Dialog-Frame .
     3379   run waitfram-hide in this-procedure .
     3380   run prn-lib-prn-file in this-procedure (
     3381                                             input parParentProc
     3382                                             ,input 0
     3383                                             ).
     3384   END PROCEDURE.
     3385   PROCEDURE proc-b-sch :
     3386   define variable v-ri as recid no-undo .
     3387   assign
     3388   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     3389   .
     3390   assign
     3391   tbl = 'ext-classif':U
     3392   join-tbl = 'X_ext-classif'
     3393   fld = ""
     3394   lab = ""
     3395   spr = ""
     3396   dim = '0'
     3397   .
     3398   run fltfield-add in this-procedure('key#_one', 'Код Фирмы', '',
     3399   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3400   DO on stop undo, leave:
     3401       run gbl/filter.w ( INPUT parparentproc
     3402                    ,INPUT filter-point + chr(4) + filter-label
     3403                    ,INPUT tbl
     3404                    ,INPUT join-tbl
     3405                    ,INPUT fld
     3406                    ,INput lab
     3407                    ,INPUT spr
     3408                    ,INPUT  dim).
     3409       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3410       if v-ri <> ? then do:
     3411         reposition br-ext-contragent to recid v-ri no-error.
     3412       end.
     3413       APPLY "ENTRY" to br-ext-contragent in frame Dialog-Frame .
     3414       APPLY "VALUE-CHANGED" to br-ext-contragent.
     3415   END .
     3416   END PROCEDURE.
     3417   FUNCTION get-client-name RETURNS CHARACTER
     3418     ( INPUT p-obj-code AS character, INPUT p-obj-type AS character )  :
     3419     define variable v-client-name as character no-undo .
     3420     define buffer buf_clients for ub.clients .
     3421     do
     3422     on error undo, return error return-value
     3423     :
     3424       find first buf_clients no-lock
     3425         where buf_clients.obj-type = p-obj-type
     3426           and buf_clients.obj-code = integer(p-obj-code)
     3427         no-error .
     3428       if available buf_clients
     3429       then do:
     3430         assign
     3431           v-client-name = (if buf_clients.stts = 0
     3432                          then buf_clients.obj-name
     3433                          else (substring (buf_clients.obj-name, 1, 20)
     3434                               + fill (" " , 20 - length (substring (buf_clients.obj-name, 1, 20)))
     3435                               + '---  УДАЛЕН  ---':U
     3436                               )
     3437                         )
     3438         .
     3439       end.
     3440     end.
     3441     return v-client-name .
     3442   END FUNCTION.
