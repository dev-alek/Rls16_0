      814   define variable v-kol-spice2 as integer no-undo .
      815   define variable v-kol-spice3 as integer no-undo .
      816   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      817   DEFINE BUTTON StopBtn AUTO-END-KEY
      818        LABEL "Стоп"
      819        SIZE 10 BY 1.
      820   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      821        LABEL "Обработано записей"
      822         VIEW-AS TEXT
      823        SIZE 14 BY .67 NO-UNDO.
      824   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      825         VIEW-AS TEXT
      826        SIZE 53.25 BY .67
      827        FGCOLOR 1  NO-UNDO.
      828   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      829         VIEW-AS TEXT
      830        SIZE 53.25 BY .67
      831        FGCOLOR 1  NO-UNDO.
      832   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      833         VIEW-AS TEXT
      834        SIZE 53.25 BY .67
      835        FGCOLOR 1  NO-UNDO.
      836   DEFINE RECTANGLE RECT-1
      837        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      838        SIZE 55.13 BY 4.46.
      839   DEFINE FRAME InfoFrame
      840        StopBtn AT ROW 4.25 COL 21.75
      841        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      842        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      843        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      844        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      845        RECT-1 AT ROW 1 COL 1
      846       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      847            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      848            TITLE "Процесс"
      849            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      850   define variable mFrameView      as logical   no-undo init yes.
      851     define variable mFramHandle as handle no-undo.
      852     mFramHandle = frame InfoFrame:handle.
      853     if  log-manager:logfile-name ne ?
      854     then DO:
      855         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      856         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      857         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      858     end.
      859     mFrameView = not session:batch-mode and mFramHandle:visible.
      860     if mFrameView
      861     then do:
      862       ASSIGN
      863          FRAME InfoFrame:HIDDEN                           = TRUE
      864          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      865     end.
      866   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      867   DO:
      868     IF not StopProcessing THEN
      869       Message "Вы действительно хотите прервать" SKIP
      870               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      871                 UPDATE StopProcessing.
      872     IF StopProcessing THEN do:
      873        if mFrameView
      874        then do:
      875           HIDE FRAME InfoFrame.
      876        end.
      877     End.
      878   END.
      879   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      880     if num-entries(string(p-dec), '.') = 2
      881       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      882       else return( string(p-dec)) .
      883   end function.
      884   function format-point-to-comma returns char (input orig as char ) .
      885   define variable rtext as character no-undo .
      886   define variable strt as integer no-undo .
      887   define variable leng as integer no-undo .
      888   assign rtext = orig .
      889   repeat:
      890     strt =  index(rtext,'.').
      891     if strt = 0 then leave.
      892     leng = 1.
      893     substring(rtext,strt,leng,"character") = v-delim .
      894   end.
      895   return rtext.
      896   end function.
      897   function format-excel-text returns char ( input start-text as char ) :
      898   def var  i    as int no-undo.
      899   def var  ch   as char no-undo.
      900   def var  n    as int no-undo.
      901   def var  ipos as int no-undo.
      902     n = num-entries(trim(start-text), chr(10)) - 1 .
      903     do i = 1 to n :
      904       ipos = index( start-text, chr(10)).
      905       if ipos > 0 then
      906         substr( start-text, ipos, 1 ) = ' '.
      907     end.
      908     n = num-entries(trim(start-text), chr(13)) - 1 .
      909     do i = 1 to n :
      910       ipos = index( start-text, chr(13)).
      911       if ipos > 0 then
      912         substr( start-text, ipos, 1 ) = ' '.
      913     end.
      914     if index( start-text, '"' ) = 0 then
      915       start-text =  '="'   + trim( start-text) + '"'   .
      916       else do:
      917         n = num-entries(trim(start-text), '"') - 1.
      918         do i = 1 to n :
      919           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      920         end.
      921         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      922         start-text = '="'  + ch  + '"' .
      923       end.
      924     return start-text.
      925   end.
      926   function excel-sum returns char (input p-dec as decimal ).
      927     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      928   end function.
      929   function excel-qnty returns char (input p-dec as decimal ).
      930     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      931   end function.
      932   function format-excel-text-macr returns char ( input start-text as char ) :
      933   def var  i    as int no-undo.
      934   def var  ch   as char no-undo.
      935   def var  n    as int no-undo.
      936   def var  ipos as int no-undo.
      937     n = num-entries(trim(start-text), chr(10)) - 1 .
      938     do i = 1 to n :
      939       ipos = index( start-text, chr(10)).
      940       if ipos > 0 then
      941         substring( start-text, ipos , 1 ) = ' '.
      942     end.
      943     n = num-entries(trim(start-text), chr(13)) - 1 .
      944     do i = 1 to n :
      945       ipos = index( start-text, chr(13)).
      946       if ipos > 0 then
      947         substring( start-text, ipos, 1 ) = ' '.
      948     end.
      949     if index( start-text, '"' ) = 0 then
      950       start-text =  '"'   + trim( start-text) + '"'   .
      951       else do:
      952         n = num-entries(trim(start-text), '"') - 1.
      953         do i = 1 to n :
      954           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      955         end.
      956         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      957         start-text = '"'  + ch  + '"' .
      958       end.
      959     n = num-entries(trim(start-text), chr(10)) - 1 .
      960     do i = 1 to n :
      961       ipos = index( start-text, chr(10)).
      962       if ipos > 0 then
      963         substring( start-text, ipos , 1 ) = ' '.
      964     end.
      965       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      966     return start-text.
      967   end.
      968   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      969   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      970   procedure paramls-clear :
      971     define buffer buf_temp-param for temp-param .
      972     do
      973     on error undo, return error return-value
      974     :
      975       for each buf_temp-param
      976       on error undo, return error
      977       :
      978         delete buf_temp-param .
      979       end.
      980     end.
      981   end procedure.
      982   procedure paramls-write :
      983     define input  parameter p-code     as character no-undo .
      984     define input  parameter p-sub-code as character no-undo .
      985     define input  parameter p-value    as character no-undo .
      986     define buffer buf_temp-param for temp-param .
      987     do
      988     on error undo, return error return-value
      989     :
      990       find first buf_temp-param
      991         where buf_temp-param.param-code     = p-code
      992           and buf_temp-param.param-sub-code = p-sub-code
      993         no-error .
      994       if not available buf_temp-param then do:
      995         create buf_temp-param .
      996         assign
      997           buf_temp-param.param-code     = p-code
      998           buf_temp-param.param-sub-code = p-sub-code
      999         .
     1000       end.
     1001       assign
     1002         buf_temp-param.param-value = p-value
     1003       .
     1004     end.
     1005   end procedure.
     1006   procedure paramls-read :
     1007     define input  parameter p-code          as character no-undo .
     1008     define input  parameter p-sub-code      as character no-undo .
     1009     define input  parameter p-default-value as character no-undo .
     1010     define output parameter p-value         as character no-undo .
     1011     define buffer buf_temp-param for temp-param .
     1012     do
     1013     on error undo, return error return-value
     1014     :
     1015       find first buf_temp-param
     1016         where buf_temp-param.param-code     = p-code
     1017           and buf_temp-param.param-sub-code = p-sub-code
     1018         no-error .
     1019       if available buf_temp-param then do:
     1020         assign
     1021           p-value = buf_temp-param.param-value
     1022         .
     1023       end.
     1024       else do:
     1025         assign
     1026           p-value = p-default-value
     1027         .
     1028       end.
     1029     end.
     1030   end procedure.
     1031   procedure paramls-append :
     1032     define input  parameter p-code     as character no-undo .
     1033     define input  parameter p-sub-code as character no-undo .
     1034     define input  parameter p-value    as character no-undo .
     1035     define buffer buf_temp-param for temp-param .
     1036     do
     1037     on error undo, return error return-value
     1038     :
     1039       find first buf_temp-param
     1040            where buf_temp-param.param-code     = p-code
     1041              and buf_temp-param.param-sub-code = p-sub-code
     1042         no-error .
     1043       if not available buf_temp-param then do:
     1044         create buf_temp-param .
     1045         assign
     1046           buf_temp-param.param-code     = p-code
     1047           buf_temp-param.param-sub-code = p-sub-code
     1048           buf_temp-param.param-value    = p-value
     1049         .
     1050       end.
     1051       else do:
     1052           assign
     1053               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1054           .
     1055       end.
     1056     end.
     1057   end procedure.
