     2537               run macr_excel_dec in this-procedure (s-sum-rubl   , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2538               run macr_excel_dec in this-procedure (s-qnty-rashkassa , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2539                num#col# = num#col# + 1 .
     2540               run macr_excel_dec in this-procedure (s-qnty-stk       , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2541               run macr_excel_dec in this-procedure (s-qnty-prih      , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2542               run macr_excel_dec in this-procedure (s-qnty-rash      , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2543               run macr_excel_dec in this-procedure (s-qnty-kassa     , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2544               num#col# =  31.
     2545               run macr_excel_dec in this-procedure (s-gds-way-all    , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2546               run macr_excel_dec in this-procedure (s-l-all-day      , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2547               run macr_cell_format in this-procedure
     2548                         ( 10    ,
