     1665       ,output v-cntxp-obj-type
     1666       ,output v-cntxp-obj-code
     1667       ,output v-cntxp-db-num-obj
     1668       ,output v-cntxp-is-admin
     1669       ) .
     1670     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     1671        v-cntxp-obj-code <> 0 then do:
     1672   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1673     (input  'is-prt'
     1674     ,input  0
     1675     ,input  ''
     1676     ,input  0
     1677     ,input  ''
     1678     ,input  ''
     1679     ,input  ''
     1680     ,input  yes
     1681     ,output v-cntxp-conf-par
     1682     ,output v-cntxp-par-type
     1683     ) no-error .
     1684       case v-cntxp-obj-type :
     1685         when 'скл':U then do:
     1686           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     1687           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     1688           assign
     1689             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     1690             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     1691             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     1692             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     1693             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     1694             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     1695             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     1696             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     1697             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     1698             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     1699             v-cntxp-load-time       = bf-cntxp_store.load-time
     1700             v-cntxp-holidays        = bf-cntxp_store.holidays
     1701             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     1702             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     1703             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     1704             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     1705             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     1706             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     1707             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     1708             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1709             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1710             .
     1711         end.
     1712         when 'маг':U then do:
     1713           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     1714           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     1715           assign
     1716             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     1717             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     1718             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     1719             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     1720             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     1721             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     1722             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     1723             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     1724             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     1725             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     1726             v-cntxp-load-time       = bf-cntxp_shop.load-time
     1727             v-cntxp-holidays        = bf-cntxp_shop.holidays
     1728             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     1729             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     1730             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     1731             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     1732             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     1733             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     1734             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     1735             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1736             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1737             .
     1738         end.
     1739       end case.
     1740     end.
