     1811   define variable  p-ship-date like ub.ord-doc.ship-date no-undo .
     1812   define variable  p-ship-time like ub.ord-doc.ship-time no-undo .
     1813   define variable  p-host-code like ub.ord-doc.host-code no-undo .
     1814   define variable is-l as integer no-undo .
     1815   FUNCTION excel-qnty-null RETURNS char (INPUT p-dec as decimal ).
     1816   if p-dec = 0 then Return ("").
     1817      else RETURN(format-excel-text(excel-format-dec-to-char(Round(p-dec,3)))) .
     1818   END FUNCTION.
     1819   main-block :
     1820   do on error undo main-block, return error
     1821   :
     1822   run adm/shattri.p (
     1823     input "get":U
     1824     ,input ""
     1825     ,input 0
     1826     ,input 'ord-global':U
     1827     ,input 'ord-min-ost-day':U
     1828     ,output v-value-character
     1829     ,output v-value-date
     1830     ,output v-value-decimal
     1831     ,output v-value-integer
     1832     ,output par-ord-min-ost
     1833     ,output p-type
     1834     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1835     ) no-error .
     1836     if error-status :error then par-ord-min-ost = false .
     1837   p-file-name =  string( session:temp-directory + "rpt" + string( g#report-num ) + ".txt" ) .
     1838   output stream outstream to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) )      .
     1839   output stream outstream2 to value(p-file-name).
     1840   v-ind = 1    .
     1841   num#str# = 1 .
     1842   num#col# = 1 .
     1843   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1844     if  log-manager:logfile-name ne ?
     1845     then DO:
     1846         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1847     end.
     1848     if not session:batch-mode then
     1849     do:
     1850       VIEW FRAME InfoFrame.
     1851       mFrameView = true.
     1852     end.
     1853      v-button-stop = false .
     1854         if mFrameView
     1855         then do:
     1856         if v-button-stop then view STOPBTN in frame InfoFrame.
     1857                          else Hide STOPBTN in frame InfoFrame.
     1858         end.
     1859   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1860   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1861     (input  v-cntxt-obj-type
     1862     ,input  v-cntxt-obj-code
     1863     ,output to-day
     1864     )  .
     1865   find first buf_ord-doc no-lock where  buf_ord-doc.doc-code = p-ord-doc no-error .
     1866   if error-status :error then do:
     1867     assign
     1868       p-obj-type  = loc-store-type
     1869       p-obj-code  = loc-store-code
     1870       p-cli-type  = loc-cli-type
     1871       p-cli-code  = loc-cli-code
     1872       p-doc-type  = loc-doc-type
     1873       p-doc-date  = doc-date
     1874       p-ship-date = loc-date-ship
     1875       p-host-code = v-cntxt-host-code-obj
     1876       .
     1877   end.
     1878   else do:
     1879     assign
     1880       p-obj-type = buf_ord-doc.obj-type
     1881       p-obj-code = buf_ord-doc.obj-code
     1882       p-cli-type = buf_ord-doc.cli-type
     1883       p-cli-code = buf_ord-doc.cli-code
     1884       p-doc-type = buf_ord-doc.doc-type
     1885       p-doc-date = buf_ord-doc.doc-date
     1886       p-ship-date = buf_ord-doc.ship-date
     1887       p-ship-date = loc-date-ship
     1888       p-ship-time = buf_ord-doc.ship-time
     1889       p-host-code = buf_ord-doc.host-code
     1890       .
     1891       if p-cli-type = ? or p-cli-code = ? then do:
     1892           assign
     1893           p-cli-type  =  loc-cli-type
     1894           p-cli-code  =  loc-cli-code
     1895           p-obj-type  =  loc-store-type
     1896           p-obj-code  =  loc-store-code
     1897           .
     1898       end.
     1899   end.
     1900   find first ubflt.usr-flt  no-lock where
     1901            ubflt.usr-flt.user-name = loc-ord-num and
     1902            ubflt.usr-flt.call-point   = "ord-m":U  + "export":U   no-error .
     1903            if not avail ubflt.usr-flt  then do:
     1904             find first ubflt.usr-flt  no-lock where
     1905                     ubflt.usr-flt.user-name = loc-ord-num and
     1906                     ubflt.usr-flt.call-point   = "ord-m":U  no-error .
     1907            end.
     1908   define variable i          as integer no-undo .
     1909   define variable R-algoritm as integer no-undo .
     1910   define variable R-min-rest as integer no-undo .
     1911   define variable v-nn as integer   no-undo .
     1912   v-nn = num-entries(ubflt.usr-flt.list_) .
     1913     do i = 1 to v-nn :
     1914        case  entry(1,(entry(i,ubflt.usr-flt.list_)), "=" ) :
     1915           when string( "R-algoritm" )             then R-algoritm = integer(entry(2,(entry(i,ubflt.usr-flt.list_)), "=" )).
     1916           when string( "date-p-1" ) then  date-1 = date(entry(2,(entry(i,ubflt.usr-flt.list_)), "=" )).
     1917           when string( "date-p-2" ) then  date-2 = date(entry(2,(entry(i,ubflt.usr-flt.list_)), "=" )).
     1918           when string( "R-min-rest" )             then R-min-rest = integer(entry(2,(entry(i,ubflt.usr-flt.list_)), "=" )).
     1919           otherwise do:
     1920           end.
     1921        end case.
     1922     end.
     1923     kol-obj = num-entries( entry(2,ubflt.usr-flt.list_,"&" ) , ",") - 1 .
     1924        if kol-obj  = ? then kol-obj  = 0 .
     1925   define variable p-name as character no-undo .
     1926   define buffer post-clients for ub.clients.
     1927   define buffer sh-clients for ub.clients.
     1928   find first sh-clients no-lock where
     1929              sh-clients.obj-type =   p-obj-type and
     1930              sh-clients.obj-code =   p-obj-code no-error  .
     1931              if error-status :error then next.
     1932   find first post-clients no-lock where
     1933              post-clients.obj-type =   p-cli-type and
     1934              post-clients.obj-code =   p-cli-code no-error  .
     1935              if error-status :error then next.
     1936   reportname =  ( if p-doc-type = 'ОФ':U then "Заявка " else  "Заказ " )
     1937                   + p-ord-doc +
     1938                  " от " +
     1939                  string( p-doc-date,"99/99/9999")
     1940                 .
     1941    run mf in this-procedure .
     1942    num#str#  = 0 .
     1943    num#col# = 1 .
     1944    num#str# = num#str# + 1 .
     1945    run macr_excel_char_with_format in this-procedure ( reportname , num#str# , num#col#  ).
     1946    run macr_cell_format in this-procedure
     1947             ( 12    ,
     1948               true  ,
     1949               false ,
     1950               ?     ,
     1951               num#str# ,
     1952               num#col# ,
     1953               ? ,
     1954               ?         ) .
     1955       run make-str-1 in this-procedure .
     1956       Output stream Macr_Excel  close .
     1957       run paramls-write in this-procedure
     1958         (input "file"
     1959         ,input "Результат"
     1960         ,input v-file-name
     1961         ) .
     1962       run mf in this-procedure .
     1963       run make-str-3 in this-procedure .
     1964       Output stream Macr_Excel  close .
     1965       run paramls-write in this-procedure
     1966         (input "file"
     1967         ,input "Экспорт данных расчета заказа"
     1968         ,input v-file-name
     1969         ) .
     1970    Output stream OutStream   close .
     1971   if mFrameView
     1972   then do:
     1973      HIDE FRAME InfoFrame.
     1974   end.
     1975     run paramls-write in this-procedure
     1976     (input "command"
     1977     ,input ""
     1978     ,input 'workbook.select("Экспорт данных расчета заказа","Экспорт данных расчета заказа")'
     1979     ) .
     1980     run paramls-write in this-procedure
     1981           (input "charcol"
     1982           ,input ""
     1983           ,input "1,2,4,5,6,7"
     1984           ) .
     1985    run end-proc in this-procedure .
     1986    run rep/runexcel.p ( string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1987    end.
     1988   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1989   procedure macr_excel_char :
     1990    do
     1991    on error undo, return error return-value
     1992    :
     1993    define input parameter  p-val as character no-undo .
     1994    define input parameter  p-row as integer no-undo .
     1995    define input parameter  p-col as integer no-undo .
     1996    if p-val = ? then p-val = "" .
     1997       put stream macr_excel unformatted
     1998             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1999    end.
     2000   end procedure.
     2001   procedure macr_excel_char_with_format :
     2002    do
     2003    on error undo, return error return-value
     2004    :
     2005    define input parameter  p-val as character no-undo .
     2006    define input parameter  p-row as integer no-undo .
     2007    define input parameter  p-col as integer no-undo .
     2008    if p-val = ? then p-val = "" .
     2009       put stream macr_excel unformatted
     2010             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2011       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2012       put stream macr_excel unformatted
     2013             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2014    end.
     2015   end procedure.
     2016   procedure macr_excel_cell_format :
     2017    do
     2018    on error undo, return error return-value
     2019    :
     2020    define input parameter  p-val    as character no-undo .
     2021    define input parameter  p-row    as integer   no-undo .
     2022    define input parameter  p-col    as integer   no-undo .
     2023    define input parameter  p-format as character no-undo .
     2024    if p-val = ? then p-val = "" .
     2025       put stream macr_excel unformatted
     2026             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2027       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2028       put stream macr_excel unformatted
     2029             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2030    end.
     2031   end procedure.
     2032   procedure macr_excel_sum :
     2033    do
     2034    on error undo, return error return-value
     2035    :
     2036    define input parameter  p-row as integer no-undo .
     2037    define input parameter  p-col as integer no-undo .
     2038    define input parameter  p-row1 as integer no-undo .
     2039    define input parameter  p-col1 as integer no-undo .
     2040    define input parameter  p-row2 as integer no-undo .
     2041    define input parameter  p-col2 as integer no-undo .
     2042       put stream macr_excel unformatted
     2043             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2044    end.
     2045   end procedure.
     2046   procedure macr_excel_dec :
     2047    do
     2048    on error undo, return error return-value
     2049    :
     2050    define input parameter  p-val as character no-undo .
     2051    define input parameter  p-row as integer   no-undo .
     2052    define input parameter  p-col as integer   no-undo .
     2053     if p-val = ? then p-val =  "" .
     2054      put  stream macr_excel unformatted
     2055           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2056    end.
     2057   end procedure.
     2058   procedure macr_cell_format :
     2059    do
     2060    on error undo, return error return-value
     2061    :
     2062    define input parameter  p-size   as integer   no-undo .
     2063    define input parameter  p-bold   as logical   no-undo .
     2064    define input parameter  p-italic as logical   no-undo .
     2065    define input parameter  p-color  as integer   no-undo .
     2066    define input parameter  p-row    as integer   no-undo .
     2067    define input parameter  p-col    as integer   no-undo .
     2068    define input parameter  p-row-2  as integer   no-undo .
     2069    define input parameter  p-col-2  as integer   no-undo .
     2070     if p-size = ? then p-size = 10 .
     2071     if p-bold = ? then p-bold = false .
     2072     if p-italic = ? then p-italic = false .
     2073     if p-row-2 = ? then p-row-2 = p-row .
     2074     if p-col-2 = ? then p-col-2 = p-col .
     2075     put  stream macr_excel unformatted
     2076      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2077     if p-color <> ? then do:
     2078        put  stream macr_excel unformatted
     2079          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2080     end.
     2081     put  stream macr_excel unformatted
     2082          substitute('format.font(,&1,&2,&3)' , p-size,
     2083                                           string ( p-bold  , "true/false" ) ,
     2084                                           string ( p-italic , "true/false" )
     2085                                           ) + chr(10) .
     2086    end.
     2087   end procedure.
     2088   procedure macr_cell_size :
     2089    do
     2090    on error undo, return error return-value
     2091    :
     2092    define input parameter  p-w   as integer   no-undo .
     2093    define input parameter  p-l   as integer   no-undo .
     2094    define input parameter  p-row    as integer   no-undo .
     2095    define input parameter  p-col    as integer   no-undo .
     2096    define input parameter  p-row-2  as integer   no-undo .
     2097    define input parameter  p-col-2  as integer   no-undo .
     2098     if p-row-2 = ? then p-row-2 = p-row .
     2099     if p-col-2 = ? then p-col-2 = p-col .
     2100     if p-w = ? then    p-w = 0 .
     2101     if p-l = ? then    p-l = 0 .
     2102    define variable s-w as character no-undo .
     2103    define variable s-l as character no-undo .
     2104    if p-w = 0 then s-w = "" .
     2105               else s-w = string(p-w)  .
     2106    if p-l = 0 then s-l = "" .
     2107               else s-l = string(p-l)  .
     2108   put  stream macr_excel unformatted
     2109        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2110   put  stream macr_excel unformatted
     2111        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2112   put  stream macr_excel unformatted
     2113        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2114    end.
     2115   end procedure.
     2116   procedure proc-print-header :
     2117    do
     2118    on error undo, return error return-value
     2119    :
     2120      find first sheetf .
     2121        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2122        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2123        var-1 =  num#str# .
     2124        repeat c-c = 1 to sheetf.excel-row-title :
     2125        num#str# = num#str# + 1 .
     2126        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2127        do c-i = 1 to p-var :
     2128           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2129           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2130           num#col# = c-i .
     2131           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2132           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2133        end.
     2134       c-i = 0.
     2135       end.
     2136       run macr_cell_format (
     2137           10       ,
     2138           true     ,
     2139           false    ,
     2140           35       ,
     2141           var-1 + 1,
     2142           1        ,
     2143           num#str# ,
     2144           num#col# )
     2145           .
     2146     put  stream macr_excel unformatted
     2147          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2148          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2149          .
     2150    end.
     2151   end procedure.
     2152   procedure end-proc :
     2153    do
     2154    on error undo, return error return-value
     2155    :
     2156     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2157     OUTPUT to VALUE (v-file-name) .
     2158     for each temp-param :
     2159       export  temp-param  .
     2160     end.
     2161    end.
     2162   end procedure.
     2163   procedure make-str-1 :
     2164    do
     2165    on error undo, return error return-value
     2166    :
     2167   num#col# =  0.
     2168   num#str# = num#str# + 1 .
     2169   num#col# = num#col# + 1 .
     2170   p-name = "Артикул" .
     2171   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2172   num#col# = num#col# + 1 .
     2173   p-name = "Тип производителя " .
     2174   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2175   num#col# = num#col# + 1 .
     2176   p-name = "Код производителя " .
     2177   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2178   num#col# = num#col# + 1 .
     2179   p-name = "Название товара" .
     2180   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2181   num#col# = num#col# + 1 .
     2182   p-name = "Артикул поставщика" .
     2183   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2184   num#col# = num#col# + 1 .
     2185   p-name = "Цена в валюте поставщика в баз.ед.изм" .
     2186   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2187   num#col# = num#col# + 1 .
     2188   p-name = "Количество в баз.ед.изм" .
     2189   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2190   for each  buf_ord-line no-lock where  buf_ord-line.doc-code = p-ord-doc  ,
     2191       first ub.goods no-lock where
     2192             ub.goods.artic     = buf_ord-line.artic      and
     2193             ub.goods.prod-type = buf_ord-line.prod-type  and
     2194             ub.goods.prod-code = buf_ord-line.prod-code  break by ub.goods.gds-code :
     2195       find first ub.clients no-lock where
     2196             ub.goods.prod-type = ub.clients.obj-type and
     2197             ub.goods.prod-code = ub.clients.obj-code no-error .
     2198             if error-status :error then next.
     2199       num#col# = 1 .
     2200       num#str# = num#str# + 1 .
     2201       run macr_excel_char_with_format in this-procedure ( buf_ord-line.artic , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2202       run macr_excel_char_with_format in this-procedure ( buf_ord-line.prod-type , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2203       run macr_excel_char_with_format in this-procedure ( buf_ord-line.prod-code , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2204       run macr_excel_char_with_format in this-procedure ( ub.goods.gds-name , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2205       run macr_excel_char_with_format in this-procedure ( (if buf_ord-line.cli-art <> ? then buf_ord-line.cli-art  else "") , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2206       run macr_excel_dec in this-procedure ( determined ( buf_ord-line.price-cli / buf_ord-line.cli-base-rate ), num#str# , num#col#  ). num#col# = num#col# + 1 .
     2207       run macr_excel_dec in this-procedure ( buf_ord-line.qnty       , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2208   end.
     2209    end.
     2210   end procedure.
     2211   procedure make-str-3 :
     2212    do
     2213    on error undo, return error return-value
     2214    :
     2215   define variable loc-sum-min1 as character no-undo .
     2216   define variable loc-sum-min2 as character no-undo .
     2217   define variable loc-sum-min3 as character no-undo .
     2218   define variable t-type       as character no-undo .
     2219   define variable lp-in-qnty     as decimal no-undo .
     2220   define variable lp-out-qnty    as decimal no-undo .
     2221   define variable lp-out-sum     as decimal no-undo .
     2222   define variable lp-Temp-rash   as decimal no-undo .
     2223   define variable lp-min-stock   as decimal no-undo .
     2224   define variable lp-qnty-sale   as decimal no-undo .
     2225   define variable lp-zero-day    as decimal no-undo .
     2226   define variable lp-in-out-qnty as decimal no-undo .
     2227   define variable lp-supp-qnty   as decimal no-undo .
     2228   define variable lp-qnty-kassa  as decimal no-undo .
     2229   define variable lp-qnty-stk   as decimal no-undo .
     2230   define variable lp-qnty-prih  as decimal no-undo .
     2231   define variable lp-qnty-rash  as decimal no-undo .
     2232    num#str# = 0 .
     2233    num#col# = 1 .
     2234    num#str# = num#str# + 1 .
     2235    run macr_excel_char_with_format in this-procedure ( reportname , num#str# , num#col#  ).
     2236    run macr_cell_format in this-procedure
     2237             ( 12    ,
     2238               true  ,
     2239               false ,
     2240               ?     ,
     2241               num#str# ,
     2242               num#col# ,
     2243               ? ,
     2244               ?         ) .
     2245   reportheader =   cur-time-print() .
     2246   num#str# = num#str# + 1 .
     2247   num#col# = 1 .
     2248   p-name = "Покупатель: " .
     2249   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2250   num#col# =  4 .
     2251   run macr_excel_char_with_format in this-procedure ( sh-clients.obj-name , num#str# , num#col#  ).
     2252   num#str# = num#str# + 1 .
     2253   num#col# =  1 .
     2254   p-name = "Поставщик: " .
     2255   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2256   num#col# =  4 .
     2257   run macr_excel_char_with_format in this-procedure ( post-clients.obj-name , num#str# , num#col#  ).
     2258   num#str# = num#str# + 1 .
     2259   num#col# = 1 .
     2260   p-name = "Дата печати: " .
     2261   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2262   num#col# = 4 .
     2263   run macr_excel_char_with_format in this-procedure ( string( today ,"99/99/9999") , num#str# , num#col#  ).
     2264   num#str# = num#str# + 1 .
     2265   num#col# = 1 .
     2266   p-name = "Планируемая дата доставки: " .
     2267   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2268   num#col# = 4 .
     2269   run macr_excel_char_with_format in this-procedure ( string( p-ship-date,"99/99/9999") , num#str# , num#col#  ).
     2270   num#col# = 5 .
     2271   run macr_excel_char_with_format in this-procedure ( "Время : " + string( p-ship-time,"hh:mm") , num#str# , num#col#  ).
     2272    run macr_cell_format in this-procedure  (
     2273           10       ,
     2274           true     ,
     2275           false    ,
     2276           34       ,
     2277           6        ,
     2278           1        ,
     2279           6        ,
     2280           max-col )
     2281           .
     2282   num#col# =  0 .
     2283   num#str# = num#str# + 1 .
     2284   num#col# = num#col# + 1 .
     2285   define variable p-fi as character no-undo .
     2286   define variable name-tt as character no-undo .
     2287   if loc-doc-type = 'ФП':U then do:
     2288       p-fi  = " по фирме " .
     2289   end.
     2290   else do:
     2291      p-fi  = " по объекту " .
     2292   end.
     2293   case R-algoritm :
     2294     when 2 then do:
     2295         name-tt =  "Темп продаж из списка" .
     2296     end.
     2297     when 4 then do:
     2298         name-tt =  "Максимальная продажа" .
     2299     end.
     2300     otherwise do:
     2301         name-tt =  "Темп продаж с " + String(date-1) + " по " + String(date-2) .
     2302     end.
     2303   end case.
     2304    run macr_excel_char_with_format in this-procedure ("Артикул"                                                         , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2305    run macr_excel_char_with_format in this-procedure ("Название товара"                                                 , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2306    put  stream macr_excel unformatted  'COLUMN.WIDTH(30,,,,)'  skip.
     2307    run macr_excel_char_with_format in this-procedure ("Ед.изм."                                                         , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2308    run macr_excel_char_with_format in this-procedure ("Код производителя ", num#str# , num#col#  ).                                                num#col# = num#col# + 1 .
     2309    run macr_excel_char_with_format in this-procedure ("Название производителя ", num#str# , num#col#  ).                                           num#col# = num#col# + 1 .
     2310    put  stream macr_excel unformatted  'COLUMN.WIDTH(30,,,,)'  skip.
     2311    run macr_excel_char_with_format in this-procedure ("Артикул контрагента"                                             , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2312    run macr_excel_char_with_format in this-procedure ("Ед.изм. контрагента"                                             , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2313    run macr_excel_char_with_format in this-procedure ("Кол-во приход по контрагенту"                                    , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2314    run macr_excel_char_with_format in this-procedure ("Кол-во расход по контрагенту"                                    , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2315    run macr_excel_char_with_format in this-procedure ("Продаж.цены(вал.продаж) расход"                                  , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2316    run macr_excel_char_with_format in this-procedure ("Последн.цена контрагента на баз.ед.изм."                         , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2317    run macr_excel_char_with_format in this-procedure ("Кол-во остатки по контрагенту"                                   , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2318    run macr_excel_char_with_format in this-procedure ("Приход / Расход"                                                 , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2319    run macr_excel_char_with_format in this-procedure ("Срок хранения"                                                   , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2320    run macr_excel_char_with_format in this-procedure ("Коэффициент пересчета ед.изм."                                   , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2321    run macr_excel_char_with_format in this-procedure ("Количество в упаковке"                                                  , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2322    run macr_excel_char_with_format in this-procedure ( name-tt      , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2323    run macr_excel_char_with_format in this-procedure ("ЗАКАЗ кол-во"                                                    , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2324    run macr_excel_char_with_format in this-procedure ("ЗАКАЗ сумма"                                                     , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2325    run macr_excel_char_with_format in this-procedure ( if R-algoritm = 2 then "Расход (не рассчитывается)" else "Расход с " + String(date-1) + " по " + String(date-2)            , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2326    run macr_excel_char_with_format in this-procedure ("Дней без продаж и остатков"                                      , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2327    run macr_excel_char_with_format in this-procedure ("Остаток на " + String(to-day)                              , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2328    run macr_excel_char_with_format in this-procedure ("Приход "                                                   , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2329    run macr_excel_char_with_format in this-procedure ("Внешний расход "                                           , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2330    run macr_excel_char_with_format in this-procedure ("Касса "                                                    , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     2331   define variable v-tooltip as character no-undo .
     2332   define variable v-label   as character no-undo .
     2333   if R-min-rest = 1 then dO:
     2334       run macr_excel_char_with_format in this-procedure ( "Минимальный остаток" , num#str# , num#col# ).    num#col# = num#col# + 1 .
     2335       run macr_excel_char_with_format in this-procedure ( "Уровень постоянного присутствия", num#str# , num#col# ).    num#col# = num#col# + 1 .
     2336       run macr_excel_char_with_format in this-procedure ( "Минимальный заказ" , num#str# , num#col# ).                 num#col# = num#col# + 1 .
     2337   end.
     2338   if R-min-rest = 2 then dO:
     2339       run macr_excel_char_with_format in this-procedure ( "Минимальный остаток на фирме" , num#str# , num#col# ).    num#col# = num#col# + 1 .
     2340       run macr_excel_char_with_format in this-procedure ( "Уровень постоянного присутствия на фирме", num#str# , num#col# ).    num#col# = num#col# + 1 .
     2341       run macr_excel_char_with_format in this-procedure ( "Минимальный заказ на фирме" , num#str# , num#col# ).                 num#col# = num#col# + 1 .
     2342   end.
     2343   run macr_excel_char_with_format in this-procedure ("Код объекта ", num#str# , num#col#  ).       num#col# = num#col# + 1 .
     2344   run macr_excel_char_with_format in this-procedure ("Разрешены отриц.остатки ", num#str# , num#col#  ).       num#col# = num#col# + 1 .
     2345   run macr_excel_char_with_format in this-procedure ("В пути ", num#str# , num#col#  ).       num#col# = num#col# + 1 .
     2346   run macr_excel_char_with_format in this-procedure ("Дней в продаже ", num#str# , num#col#  ).       num#col# = num#col# + 1 .
     2347     put  stream macr_excel unformatted
     2348          substitute('select("r&1c&2:r&3c&4 ")' , 6  , 1 , num#str# ,  max-col ) + chr(10)  +
     2349           'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     2350          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2351          .
     2352   num#col# =  0.
     2353   define variable l-all-day as integer no-undo .
     2354   define variable s-in-qnty   as decimal no-undo .
     2355   define variable s-out-qnty  as decimal no-undo .
     2356   define variable s-out-sum   as decimal no-undo .
     2357   define variable s-supp-qnty as decimal no-undo .
     2358   define variable ss-in-qnty  as decimal no-undo .
     2359   define variable ss-out-qnty as decimal no-undo .
     2360   define variable ss-out-sum  as decimal no-undo .
     2361   define variable ss-supp-qnty as decimal no-undo .
     2362   define variable s-qnty       as decimal no-undo .
     2363   define variable s-sum-rubl   as decimal no-undo .
     2364   define variable s-qnty-rashkassa  as decimal no-undo .
     2365   define variable s-zero-day        as decimal no-undo .
     2366   define variable s-qnty-stk        as decimal no-undo .
     2367   define variable s-qnty-prih       as decimal no-undo .
     2368   define variable s-qnty-rash       as decimal no-undo .
     2369   define variable s-qnty-kassa      as decimal no-undo .
     2370   define variable s-min-stock       as decimal no-undo .
     2371   define variable s-service-order   as decimal no-undo .
     2372   define variable s-min-order       as decimal no-undo .
     2373   define variable s-gds-way-all     as decimal no-undo .
     2374   define variable s-l-all-day       as decimal no-undo .
     2375   define variable ss-qnty       as decimal no-undo .
     2376   define variable ss-sum-rubl   as decimal no-undo .
     2377   define variable ss-qnty-rashkassa  as decimal no-undo .
     2378   define variable ss-zero-day        as decimal no-undo .
     2379   define variable ss-qnty-stk        as decimal no-undo .
     2380   define variable ss-qnty-prih       as decimal no-undo .
     2381   define variable ss-qnty-rash       as decimal no-undo .
     2382   define variable ss-qnty-kassa      as decimal no-undo .
     2383   define variable ss-min-stock       as decimal no-undo .
     2384   define variable ss-service-order   as decimal no-undo .
     2385   define variable ss-min-order       as decimal no-undo .
     2386   define variable ss-gds-way-all     as decimal no-undo .
     2387   define variable ss-l-all-day       as decimal no-undo .
     2388   for each  export-ras where  break by export-ras.gds-code :
     2389       find first ub.goods no-lock where
     2390             ub.goods.artic     = export-ras.artic     and
     2391             ub.goods.prod-type = export-ras.prod-type and
     2392             ub.goods.prod-code = export-ras.prod-code no-error .
     2393             if error-status :error then next.
     2394       find first ub.clients no-lock where
     2395             ub.goods.prod-type = ub.clients.obj-type and
     2396             ub.goods.prod-code = ub.clients.obj-code no-error .
     2397             if error-status :error then next.
     2398       num#col# = 1 .
     2399       num#str# = num#str# + 1 .
     2400       if first-of(export-ras.gds-code) then do:
     2401          assign
     2402             s-in-qnty    = 0
     2403             s-out-qnty   = 0
     2404             s-out-sum    = 0
     2405             s-supp-qnty  = 0
     2406             s-qnty                 = 0
     2407             s-sum-rubl             = 0
     2408             s-qnty-rashkassa       = 0
     2409             s-zero-day             = 0
     2410             s-qnty-stk             = 0
     2411             s-qnty-prih            = 0
     2412             s-qnty-rash            = 0
     2413             s-qnty-kassa           = 0
     2414             s-min-stock            = 0
     2415             s-service-order        = 0
     2416             s-min-order            = 0
     2417             s-gds-way-all          = 0
     2418             s-l-all-day           = 0
     2419           .
     2420           run macr_excel_char_with_format in this-procedure ( export-ras.artic , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2421           run macr_excel_char_with_format in this-procedure ( ub.goods.gds-name   , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2422           run macr_excel_char_with_format in this-procedure ( ub.goods.unit-base  , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2423           run macr_excel_char_with_format in this-procedure ( export-ras.prod-type + " " + string(export-ras.prod-code) , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2424           run macr_excel_char_with_format in this-procedure ( ub.clients.obj-name      , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2425           run macr_excel_char_with_format in this-procedure ( export-ras.cli-art    , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2426           run macr_excel_char_with_format in this-procedure ( export-ras.unit-cli   , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2427           run macr_excel_dec in this-procedure (  export-ras.in-qnty     , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2428           run macr_excel_dec in this-procedure (  export-ras.out-qnty    , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2429           run macr_excel_dec in this-procedure (  export-ras.out-sum     , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2430           run macr_excel_dec in this-procedure (  determined ( export-ras.price-cli / export-ras.cli-base-rate )  , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2431           run macr_excel_dec in this-procedure (  export-ras.supp-qnty   , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2432           run macr_excel_dec in this-procedure (  determined (  export-ras.in-qnty / export-ras.out-qnty )    , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2433           run macr_excel_dec in this-procedure (  ub.goods.deadline         , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2434           run macr_excel_dec in this-procedure (  export-ras.cli-base-rate         , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2435           run macr_excel_dec in this-procedure (  ub.goods.qnty-cart          , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2436          assign
     2437             s-in-qnty    = s-in-qnty   +  export-ras.in-qnty
     2438             s-out-qnty   = s-out-qnty  +  export-ras.out-qnty
     2439             s-out-sum    = s-out-sum   +  export-ras.out-sum
     2440             s-supp-qnty  = s-supp-qnty +  export-ras.supp-qnty
     2441             ss-in-qnty   = ss-in-qnty   +  export-ras.in-qnty
     2442             ss-out-qnty  = ss-out-qnty  +  export-ras.out-qnty
     2443             ss-out-sum   = ss-out-sum   +  export-ras.out-sum
     2444             ss-supp-qnty = ss-supp-qnty +  export-ras.supp-qnty
     2445          .
     2446       end.
     2447       else do:
     2448         num#col# = num#col# + 16 .
     2449       end.
     2450      if (p-doc-type = 'ФП':U and R-min-rest = 2 and first-of ( export-ras.gds-code )) or
     2451         (p-doc-type = 'ФП':U and R-min-rest = 1 ) or
     2452          p-doc-type <> 'ФП':U
     2453       then do :
     2454       run macr_excel_dec in this-procedure (  export-ras.Temp-rash           , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2455       run macr_excel_dec in this-procedure (  export-ras.qnty      , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2456       run macr_excel_dec in this-procedure (  export-ras.sum-rubl  , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2457       run macr_excel_dec in this-procedure (  (export-ras.qnty-rash + export-ras.qnty-kassa)           , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2458       run macr_excel_dec in this-procedure (  export-ras.zero-day            , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2459       run macr_excel_dec in this-procedure (  export-ras.qnty-stk            , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2460       run macr_excel_dec in this-procedure (  export-ras.qnty-prih           , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2461       run macr_excel_dec in this-procedure (  export-ras.qnty-rash           , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2462       run macr_excel_dec in this-procedure (  export-ras.qnty-kassa          , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2463       if par-ord-min-ost = true then do:
     2464          run macr_excel_dec in this-procedure
     2465             ((export-ras.min-stock * export-ras.Temp-rash)   ,
     2466               num#str# ,
     2467               num#col#
     2468               ) .
     2469          num#col# = num#col# + 1 .
     2470       end.
     2471       else do:
     2472          run macr_excel_dec in this-procedure
     2473          ( export-ras.min-stock ,
     2474            num#str# ,
     2475            num#col#
     2476            ).
     2477          num#col# = num#col# + 1 .
     2478       end.
     2479       run macr_excel_dec in this-procedure (  export-ras.service-order , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2480       run macr_excel_dec in this-procedure (  export-ras.min-order   , num#str# , num#col#  ).   num#col# = num#col# + 1 .
     2481           if ( p-doc-type = 'ФП':U and R-min-rest = 2 ) then do:
     2482          run macr_excel_char_with_format in this-procedure  ( "список" , num#str# , num#col#  ) .
     2483       end.
     2484       else do:
     2485          run macr_excel_char_with_format in this-procedure ( export-ras.obj-type + " " + string(export-ras.obj-code) , num#str# , num#col#  ) .
     2486       end.
     2487       if p-prt-all then do:
     2488          run macr_excel_char_with_format in this-procedure ( export-ras.artic , num#str# , 1  ) .
     2489       end.
     2490       num#col# = num#col# + 1 .
     2491       run macr_excel_char_with_format in this-procedure ( export-ras.negative-rest  , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2492       run macr_excel_dec in this-procedure ( export-ras.gds-way-all  , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2493            l-all-day =  export-ras.all-day  .   if l-all-day = ? then l-all-day = 0 .
     2494       run macr_excel_dec in this-procedure ( l-all-day  , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2495       assign
     2496        s-qnty                =  s-qnty        +  export-ras.qnty
     2497        s-sum-rubl            =  s-sum-rubl    +  export-ras.sum-rubl
     2498        s-qnty-rashkassa      =  s-qnty-rashkassa +   (export-ras.qnty-rash + export-ras.qnty-kassa)
     2499        s-zero-day            =  s-zero-day    +  export-ras.zero-day
     2500        s-qnty-stk            =  s-qnty-stk    +  export-ras.qnty-stk
     2501        s-qnty-prih           =  s-qnty-prih   +  export-ras.qnty-prih
     2502        s-qnty-rash           =  s-qnty-rash   +  export-ras.qnty-rash
     2503        s-qnty-kassa          =  s-qnty-kassa  +  export-ras.qnty-kassa
     2504        s-min-stock           =  s-min-stock   +  export-ras.min-stock
     2505        s-service-order       =  s-service-order + export-ras.service-order
     2506        s-min-order           =  s-min-order     + export-ras.min-order
     2507        s-gds-way-all         =  s-gds-way-all   + export-ras.gds-way-all
     2508        s-l-all-day           =  s-l-all-day     +           l-all-day
     2509        ss-qnty                =  ss-qnty        +  export-ras.qnty
     2510        ss-sum-rubl            =  ss-sum-rubl    +  export-ras.sum-rubl
     2511        ss-qnty-rashkassa      =  ss-qnty-rashkassa +   (export-ras.qnty-rash + export-ras.qnty-kassa)
     2512        ss-zero-day            =  ss-zero-day    +  export-ras.zero-day
     2513        ss-qnty-stk            =  ss-qnty-stk    +  export-ras.qnty-stk
     2514        ss-qnty-prih           =  ss-qnty-prih   +  export-ras.qnty-prih
