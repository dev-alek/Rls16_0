     1356   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1357   procedure thbjattr_code :
     1358      define input  parameter p-upper-code     as character no-undo .
     1359      define input  parameter p-code           as character no-undo .
     1360      define output parameter p-label          as character no-undo .
     1361      define output parameter p-user-can-edit  as logical   no-undo .
     1362      define output parameter p-output-display as logical   no-undo .
     1363      define output parameter p-other          as character no-undo .
     1364      define output parameter p-prop-list      as character no-undo .
     1365      define output parameter p-prop-type-list as character no-undo .
     1366      define output parameter p-prop-label-list as character no-undo .
     1367      define output parameter p-global          as logical no-undo .
     1368      define output parameter p-host           as logical no-undo .
     1369      define output parameter p-shop           as logical no-undo .
     1370      define output parameter p-store          as logical no-undo .
     1371      define output parameter p-db             as logical no-undo .
     1372      define variable p-region as logical no-undo.
     1373      run thbjattr_code_reg in this-procedure (
     1374                                               p-upper-code,
     1375                                               p-code,
     1376                                               output p-label,
     1377                                               output p-user-can-edit,
     1378                                               output p-output-display,
     1379                                               output p-other,
     1380                                               output p-prop-list,
     1381                                               output p-prop-type-list,
     1382                                               output p-prop-label-list,
     1383                                               output p-global,
     1384                                               output p-host,
     1385                                               output p-shop,
     1386                                               output p-store,
     1387                                               output p-db,
     1388                                               output p-region
     1389                                               ).
     1390   end procedure.
     1391   procedure thbjattr_code_reg :
     1392   define input  parameter p-upper-code     as character no-undo .
     1393   define input  parameter p-code           as character no-undo .
     1394   define output parameter p-label          as character no-undo .
     1395   define output parameter p-user-can-edit  as logical   no-undo .
     1396   define output parameter p-output-display as logical   no-undo .
     1397   define output parameter p-other          as character no-undo .
     1398   define output parameter p-prop-list      as character no-undo .
     1399   define output parameter p-prop-type-list as character no-undo .
     1400   define output parameter p-prop-label-list as character no-undo .
     1401   define output parameter p-global          as logical no-undo .
     1402   define output parameter p-host           as logical no-undo .
     1403   define output parameter p-shop           as logical no-undo .
     1404   define output parameter p-store          as logical no-undo .
     1405   define output parameter p-db             as logical no-undo .
     1406   define output parameter p-region         as logical no-undo .
     1407   do
     1408   on error undo, return error return-value
     1409   :
     1410       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1411       (input  p-upper-code
     1412       ,input  p-code
     1413       ,output p-label
     1414       ,output p-user-can-edit
     1415       ,output p-output-display
     1416       ,output p-other
     1417       ,output p-prop-list
     1418       ,output p-prop-type-list
     1419       ,output p-prop-label-list
     1420       ,output p-global
     1421       ,output p-host
     1422       ,output p-shop
     1423       ,output p-store
     1424       ,output p-db
     1425       ,output p-region
     1426       ) no-error .
     1427     if error-status :error
     1428     then do:
     1429       undo, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1)).
     1430     end.
     1431   end.
     1432   end procedure.
     1433   procedure thbjattr_tooltip :
     1434   define input  parameter p-upper-code  as character no-undo .
     1435   define input  parameter p-code      as character no-undo .
     1436   define output parameter p-tooltip   as character no-undo .
     1437   define output parameter p-label     as character no-undo .
     1438   define output parameter p-tooltip-code as character no-undo .
     1439   do
