     2607   run macr_excel_char in this-procedure (  "Параметры расчета заказа", num#str# , num#col#     )   .
     2608    run macr_cell_format  in this-procedure
     2609             ( 12    ,
     2610               true  ,
     2611               false ,
     2612               15     ,
     2613               num#str# ,
     2614               1 ,
     2615               ? ,
     2616               3       ) .
     2617       define variable jjj as integer no-undo .
     2618       define variable pp-str as character no-undo .
     2619       define variable pp-str2 as character no-undo .
     2620       num#col# =  1.
     2621       iii= 0.
     2622   define variable l-jj  as integer no-undo .
     2623   define variable l-len as integer no-undo .
     2624   define variable l-m   as integer no-undo .
     2625   define variable v-nn as integer   no-undo .
     2626   define variable v-nn2 as integer   no-undo .
     2627   v-nn = num-entries( p-e-method ,"chr(10)") .
     2628   v-nn2 = num-entries( pp-str ,";") .
     2629       repeat iii = 1 to v-nn  :
     2630           pp-str = entry (iii, p-e-method , "chr(10)").
     2631           v-nn2 = num-entries( pp-str ,";") .
     2632             repeat jjj = 1 to v-nn2 :
     2633               pp-str2 = entry (jjj, pp-str , ";").
     2634               if pp-str2 <> "" and pp-str2 <> ? and  pp-str2 <> " " then do:
     2635                       l-len = length (pp-str2  ) .
     2636                       l-m = integer( l-len / 220 ) + 1 .
     2637                       do l-jj = 1 to  l-m  :
     2638                           num#str# = num#str# + 1 .
     2639                           run macr_excel_char in this-procedure (
     2640                               substring( pp-str2, (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .
     2641                       end.                                                                                                       ~
     2642               end.
     2643             end.
     2644       end.
     2645   end.
     2646   end procedure.
     2647   procedure mf :
     2648    do
