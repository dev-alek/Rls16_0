     1295                       .
     1296                   end.
     1297                 end.
     1298              end.
     1299       assign ub.ord-doc.order-type = 0.
     1300   end.
     1301   define variable flag-all as logical   no-undo .
     1302   for each ub.ord-doc exclusive-lock where
