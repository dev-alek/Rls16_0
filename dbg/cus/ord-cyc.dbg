      830     on error undo, return error return-value
      831     :
      832       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
      833       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
      834       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
      835       define output parameter p-exist   as logical  no-undo .
      836       define buffer buf_ord-line-attr for ub.ord-line-attr .
      837       define variable v-type           as character no-undo .
      838       define variable v-format         as character no-undo .
      839       define variable v-fillin_width   as integer   no-undo .
      840       define variable v-fillin_height  as integer   no-undo .
      841       define variable v-label          as character no-undo .
      842       define variable v-user-can-edit  as logical   no-undo .
      843       define variable v-output-display as logical   no-undo .
      844       define variable v-other          as character no-undo .
      845       define variable v-proc           as character no-undo .
      846       define variable v-func           as character no-undo .
      847       define variable v-sort           as integer   no-undo .
      848       run ordlineattr-code in this-procedure
      849         (input  p-code
      850         ,output v-type
      851         ,output v-format
      852         ,output v-fillin_width
      853         ,output v-fillin_height
      854         ,output v-label
      855         ,output v-user-can-edit
      856         ,output v-output-display
      857         ,output v-proc
      858         ,output v-func
      859         ,output v-sort
      860         ,output v-other
      861         ) no-error .
      862       if error-status :error then do:
      863         undo, return error return-value .
      864       end.
      865       find first buf_ord-line-attr no-lock
      866         where buf_ord-line-attr.doc-code  = p-doc-code
      867           and buf_ord-line-attr.gds-code = p-gds-code
      868           and buf_ord-line-attr.attr-code = p-code
      869         no-error .
      870       if  available buf_ord-line-attr then do:
      871         p-exist = yes.
      872       end.
      873     end.
      874   end procedure.
      875   procedure ordlineattr-delete :
      876     do
      877     on error undo, return error return-value
      878     :
      879       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
      880       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
      881       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
      882       define output parameter p-deleted  as logical no-undo.
      883       define buffer buf_ord-line-attr for ub.ord-line-attr .
      884       define variable v-type           as character no-undo .
      885       define variable v-format         as character no-undo .
      886       define variable v-fillin_width   as integer   no-undo .
      887       define variable v-fillin_height  as integer   no-undo .
      888       define variable v-label          as character no-undo .
      889       define variable v-user-can-edit  as logical   no-undo .
      890       define variable v-output-display as logical   no-undo .
      891       define variable v-proc           as character no-undo .
      892       define variable v-func           as character no-undo .
      893       define variable v-sort           as integer   no-undo .
      894       define variable v-other          as character no-undo .
      895       run ordlineattr-code in this-procedure
      896         (input  p-code
      897         ,output v-type
      898         ,output v-format
      899         ,output v-fillin_width
      900         ,output v-fillin_height
      901         ,output v-label
      902         ,output v-user-can-edit
      903         ,output v-output-display
      904         ,output v-proc
      905         ,output v-func
      906         ,output v-sort
      907         ,output v-other
      908         ) no-error .
      909       if error-status :error then do:
      910         undo, return error return-value .
      911       end.
      912       find first buf_ord-line-attr exclusive-lock
      913         where buf_ord-line-attr.doc-code  = p-doc-code
      914           and buf_ord-line-attr.gds-code  = p-gds-code
      915           and buf_ord-line-attr.attr-code = p-code
      916         no-error NO-WAIT.
      917       if not available buf_ord-line-attr then do:
      918         p-deleted = no.
      919       end.
      920       else do:
      921         delete buf_ord-line-attr.
      922         p-deleted = yes.
      923       end.
      924     end.
      925   end procedure.
      926   procedure ordlineattr-code :
      927     do on error undo, return error return-value
      928     :
      929       define input  parameter p-code           as character no-undo .
      930       define output parameter p-type           as character no-undo .
      931       define output parameter p-format         as character no-undo .
      932       define output parameter p-fillin_width   as integer   no-undo .
      933       define output parameter p-fillin_height  as integer   no-undo .
      934       define output parameter p-label          as character no-undo .
      935       define output parameter p-user-can-edit  as logical   no-undo .
      936       define output parameter p-output-display as logical   no-undo .
      937       define output parameter p-proc           as character no-undo .
      938       define output parameter p-func           as character no-undo .
      939       define output parameter p-sort           as integer   no-undo .
      940       define output parameter p-other          as character no-undo .
      941       case p-code :
      942               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      943               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      944         otherwise do:
      945           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
      946         end.
      947       end.
      948     end.
      949   end procedure.
      950   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
      952   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
      953   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
      954   ASSIGN
      955      v-S_CONTRACT                = "Contract":U
      956      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
      957      v-DELIM_CHR_3               = ","
      958      .
      959   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
      960   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      961   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      962   FUNCTION Can-Find-Spec RETURN LOGICAL (
      963      INPUT iHost-Code    AS INTEGER,
      964      INPUT iContract-Num AS INTEGER,
      965      INPUT iGds-Code     AS INTEGER ):
      966      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      967      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      968      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      969      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      970      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      971      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      972          INPUT  iHost-Code,
      973          INPUT  iContract-Num,
      974          OUTPUT iTmp-Extent3
      975          ).
      976      IF iTmp-Extent3[1] = 2 THEN DO:
      977         ASSIGN
      978            iTmp-Host-Code      = iTmp-Extent3[2]
      979            iTmp-Contract-Num   = iTmp-Extent3[3]
      980            .
      981      END. ELSE DO:
      982         ASSIGN
      983            iTmp-Host-Code      = iHost-Code
      984            iTmp-Contract-Num   = iContract-Num
      985            .
      986      END.
      987      IF iGds-Code = ? THEN DO:
      988         ASSIGN
      989            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      990                                  buf_Spec.Host-Code     = iTmp-Host-Code
      991                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      992                           ).
      993      END. ELSE DO:
      994            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      995                                  buf_Spec.Host-Code     = iTmp-Host-Code
      996                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      997                              AND buf_Spec.Gds-Code      = iGds-Code
      998                            ).
      999      END.
     1000      RETURN (lRet).
     1001   END FUNCTION.
     1002   PROCEDURE MS-Contract-EXTENT-3:
     1003      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1004      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1005      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1006      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1007      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1008      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1009      FIND FIRST buf_Cont-2 WHERE
     1010                 buf_Cont-2.Host-Code      = i-Host-Code
     1011             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1012           NO-LOCK NO-ERROR.
     1013      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1014         RETURN.
     1015      END.
     1016      FOR FIRST buf_Ext-Classif WHERE
     1017                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1018           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1019                                               STRING(i-Contract-code)
     1020           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1021          NO-LOCK,
     1022          EACH buf_Cont WHERE
     1023               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1024           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1025          NO-LOCK:
     1026          ASSIGN
     1027             i-Ret[1] = 1
     1028             i-Ret[2] = buf_Cont.Host-code
     1029             i-Ret[3] = buf_Cont.Contract-code
     1030             .
     1031          LEAVE.
     1032      END.
     1033      IF i-Ret[1] <> 1 THEN DO:
     1034         FOR FIRST buf_Ext-Classif WHERE
     1035                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1036              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1037                                                  STRING(i-Contract-code)
     1038              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1039             NO-LOCK,
     1040             EACH buf_Cont WHERE
     1041                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1042              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1043             NO-LOCK:
     1044             ASSIGN
     1045                i-Ret[1] = 2
     1046                i-Ret[2] = buf_Cont.Host-code
     1047                i-Ret[3] = buf_Cont.Contract-code
     1048                .
     1049             LEAVE.
     1050         END.
     1051      END.
     1052      RETURN.
     1053   END PROCEDURE.
     1054   define variable log-file-name   as character no-undo init "ord-cycle.txt".
     1055   define variable v-error         as logical   no-undo .
