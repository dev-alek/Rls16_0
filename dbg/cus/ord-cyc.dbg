      589       define variable v-format         as character no-undo .
      590       define variable v-fillin_width   as integer   no-undo .
      591       define variable v-fillin_height  as integer   no-undo .
      592       define variable v-label          as character no-undo .
      593       define variable v-user-can-edit  as logical   no-undo .
      594       define variable v-output-display as logical   no-undo .
      595       define variable v-other          as character no-undo .
      596       define variable v-proc           as character no-undo .
      597       define variable v-func           as character no-undo .
      598       define variable v-sort           as integer   no-undo .
      599       run orddocattr-code in this-procedure
      600         (input  p-code
      601         ,output v-type
      602         ,output v-format
      603         ,output v-fillin_width
      604         ,output v-fillin_height
      605         ,output v-label
      606         ,output v-user-can-edit
      607         ,output v-output-display
      608         ,output v-proc
      609         ,output v-func
      610         ,output v-sort
      611         ,output v-other
      612         ) no-error .
      613       if error-status :error then do:
      614         undo, return error return-value .
      615       end.
      616       find first buf_ord-doc-attr no-lock
      617         where buf_ord-doc-attr.doc-code  = p-doc-code
      618           and buf_ord-doc-attr.attr-code = p-code
      619         no-error .
      620       if  available buf_ord-doc-attr then do:
      621         p-exist = yes.
      622       end.
      623     end.
      624   end procedure.
      625   procedure orddocattr-delete :
      626     do
      627     on error undo, return error return-value
      628     :
      629       define input parameter p-doc-code like ub.ord-doc-attr.doc-code   no-undo .
      630       define input parameter p-code     like ub.ord-doc-attr.attr-code  no-undo .
      631       define output parameter p-deleted  as logical no-undo.
      632       define buffer buf_ord-doc-attr for ub.ord-doc-attr .
      633       define variable v-type           as character no-undo .
      634       define variable v-format         as character no-undo .
      635       define variable v-fillin_width   as integer   no-undo .
      636       define variable v-fillin_height  as integer   no-undo .
      637       define variable v-label          as character no-undo .
      638       define variable v-user-can-edit  as logical   no-undo .
      639       define variable v-output-display as logical   no-undo .
      640       define variable v-proc           as character no-undo .
      641       define variable v-func           as character no-undo .
      642       define variable v-sort           as integer   no-undo .
      643       define variable v-other          as character no-undo .
      644       run orddocattr-code in this-procedure
      645         (input  p-code
      646         ,output v-type
      647         ,output v-format
      648         ,output v-fillin_width
      649         ,output v-fillin_height
      650         ,output v-label
      651         ,output v-user-can-edit
      652         ,output v-output-display
      653         ,output v-proc
      654         ,output v-func
      655         ,output v-sort
      656         ,output v-other
      657         ) no-error .
      658       if error-status :error then do:
      659         undo, return error return-value .
      660       end.
      661       find first buf_ord-doc-attr exclusive-lock
      662         where buf_ord-doc-attr.doc-code  = p-doc-code
      663           and buf_ord-doc-attr.attr-code = p-code
      664         no-error NO-WAIT.
      665       if not available buf_ord-doc-attr then do:
      666         p-deleted = no.
      667       end.
      668       else do:
      669         delete buf_ord-doc-attr.
      670         p-deleted = yes.
      671       end.
      672     end.
      673   end procedure.
      674   procedure orddocattr-code :
      675     do on error undo, return error return-value
      676     :
      677       define input  parameter p-code           as character no-undo .
      678       define output parameter p-type           as character no-undo .
      679       define output parameter p-format         as character no-undo .
      680       define output parameter p-fillin_width   as integer   no-undo .
      681       define output parameter p-fillin_height  as integer   no-undo .
      682       define output parameter p-label          as character no-undo .
      683       define output parameter p-user-can-edit  as logical   no-undo .
      684       define output parameter p-output-display as logical   no-undo .
      685       define output parameter p-proc           as character no-undo .
      686       define output parameter p-func           as character no-undo .
      687       define output parameter p-sort           as integer   no-undo .
      688       define output parameter p-other          as character no-undo .
      689       case p-code :
      690               when 'cycle-doc-code':U then do:     assign     p-label          = "Номер заказа цикличного"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Номер заказа цикличного"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      691               when 'cycle-day':U then do:     assign     p-label          = "период цикличности"     p-type           = 'I':U      p-format         = ">>>>>>9"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период цикличности"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      692               when 'cycle-done':U then do:     assign     p-label          = "Заказ рассчитан"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Заказ рассчитан"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      693               when 'exch-code':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      694               when 'exch-rate':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      695               when 'exch-scale':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      696               when 'base-rate':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      697               when 'base-scale':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      698               when 'cycle-contract-code':U then do:     assign     p-label          = "договор"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "договор"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      699               when 'cycle-ship-date':U then do:     assign     p-label          = "дата доставки"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "дата доставки"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      700               when 'cycle-ship-time':U then do:     assign     p-label          = "время доставки"     p-type           = 'I':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "время доставки"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      701               when 'cycle-date1':U then do:     assign     p-label          = "период продаж"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период продаж"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      702               when 'cycle-date2':U then do:     assign     p-label          = "период продаж"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период продаж"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      703               when 'cycle-doc-date':U then do:     assign     p-label          = "дата заказа"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "дата заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      704               when 'ora-exp-seq-num':U then do:     assign     p-label          = "Номер выгрузки в Oracle Retail"     p-type           = 'I':U      p-format         = "999999999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Номер выгрузки в Oracle Retail"     p-user-can-edit  = false     p-output-display = false     p-sort           = 100     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
      705         otherwise do:
      706           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
      707         end.
      708       end.
      709     end.
      710   end procedure.
