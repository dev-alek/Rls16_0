     1410            grpb_contract-specif.Host-code    = i-gl-Host-Code
     1411        AND grpb_contract-specif.Contract-num = i-gl-Contract-Code
     1412                          ,
     1413                                  first grpb_goods no-lock where
     1414                                        grpb_goods.gds-code = grpb_contract-specif.gds-code and
     1415                                        grpb_goods.grp-code  = buf_goods.grp-code :
     1416                                    find first newb_ord-line no-lock where
     1417                                               newb_ord-line.doc-code = loc-ord-num and
     1418                                               newb_ord-line.gds-code =  grpb_contract-specif.gds-code no-error .
     1419                                           if not available  newb_ord-line then do:
     1420                                               kk = kk + 1 .
     1421                                               create newb_ord-line.
     1422                                               assign
     1423                                                 newb_ord-line.doc-code      = loc-ord-num
     1424                                                 newb_ord-line.artic         = grpb_goods.artic
     1425                                                 newb_ord-line.prod-type     = grpb_goods.prod-type
     1426                                                 newb_ord-line.prod-code     = grpb_goods.prod-code
     1427                                                 newb_ord-line.gds-code      = grpb_goods.gds-code
     1428                                                 newb_ord-line.cli-qnty      =  ?
     1429                                                 newb_ord-line.price-cli     = grpb_contract-specif.price-cli
     1430                                                 newb_ord-line.vat-pc        = grpb_contract-specif.vat-pc
     1431                                                 newb_ord-line.cli-base-rate = grpb_contract-specif.cli-base-rate
     1432                                                 newb_ord-line.unit-cli      = grpb_contract-specif.unit-base
     1433                                                 newb_ord-line.price-rubl    = grpb_contract-specif.price-cli * tt-ord-doc.exch-rate / tt-ord-doc.exch-scale / newb_ord-line.cli-base-rate
     1434                                                 newb_ord-line.price-base    = newb_ord-line.price-rubl / tt-ord-doc.base-rate * tt-ord-doc.base-scale
     1435                                                 newb_ord-line.qnty          = newb_ord-line.cli-qnty * newb_ord-line.cli-base-rate
     1436                                                 newb_ord-line.sum-rubl      = newb_ord-line.qnty * newb_ord-line.price-rubl
     1437                                                 newb_ord-line.sum-base      = newb_ord-line.qnty * newb_ord-line.price-base
     1438                                                 newb_ord-line.sum-cli       = newb_ord-line.cli-qnty * newb_ord-line.price-cli
     1439                                                 newb_ord-line.line-num      = kk
     1440                                              .
     1441                                               find first ub.ext-artic no-lock  where
     1442                                                             ub.ext-artic.cli-type = tt-ord-doc.cli-type
     1443                                                         and ub.ext-artic.cli-code = tt-ord-doc.cli-code
     1444                                                         and ub.ext-artic.gds-code = grpb_goods.gds-code
     1445                                                         and ub.ext-artic.status_  = 'тек':U
     1446                                                         no-error .
     1447                                               if available ub.ext-artic then do:
     1448                                                 newb_ord-line.cli-art = ub.ext-artic.ext-artic.
     1449                                               end.
     1450                                               else do:
     1451                                                 newb_ord-line.cli-art = ''.
     1452                                               end.
     1453                                           end.
     1454                         end.
     1455                     end.
     1456                     else do:
     1457                     end.
     1458                 end.
     1459                 else do:
     1460                     create newb_ord-line.
     1461                     buffer-copy tt-ord-line except tt-ord-line.doc-code to newb_ord-line
     1462                     assign
     1463                       newb_ord-line.doc-code = loc-ord-num
     1464                       .
     1465                 end.
     1466              end.
     1467     end.
     1468     flag-all = true .
     1469     for each tt-ord-doc :
     1470         if not ( integer(to-day - tt-ord-doc.doc-date) >= tt-ord-doc.cycle-day ) then do:
     1471             flag-all = false .
     1472             next.
     1473         end.
     1474     end.
     1475     if flag-all = true then
     1476        assign
     1477          ub.ord-doc.order-type = 0
     1478          .
     1479   end.
     1480   p-kol-zakz = i .
     1481   if i > 0 then  do:
     1482          v-message = substitute("&4&5 Добавлено &1 ЗАКАЗОВ. Номера С &2 ПО &3 ." , i , loc-ord-num1 , loc-ord-num , p-obj-type, p-obj-code) .
     1483          if g#auto = false then do:
     1484             message v-message  view-as alert-box information .
     1485          end.
     1486          else do:
     1487             run write-log-and-file in p-log-handle (
     1488                   input 1
     1489                 , input log-file-name
     1490                 , input 1
     1491                 , input v-message ) no-error .
     1492          end.
     1493   end.
     1494   else  do:
     1495          if can-find (first ub.ord-doc  where ub.ord-doc.cycle-day > 0
     1496                          and ub.ord-doc.doc-date = to-day
     1497                          and ub.ord-doc.obj-type = p-obj-type
     1498                          and ub.ord-doc.obj-code = p-obj-code
     1499                          and ub.ord-doc.host-code = g#host-code
     1500                          and ub.ord-doc.order-type = 1  ) then do:
     1501               v-message = substitute("&2&3 На сегодня повторяющиеся заказы уже рассчитаны !  &1" , to-day , p-obj-type, p-obj-code) .
     1502               if g#auto = false then do:
     1503                 message v-message  view-as alert-box  information.
     1504               end.
     1505               else do:
     1506                 run write-log-and-file in p-log-handle (
     1507                       input 1
     1508                     , input log-file-name
     1509                     , input 1
     1510                     , input v-message ) no-error .
     1511               end.
     1512           end.
     1513           else do:
     1514             v-message = substitute("&2&3 Повторяющиеся заказы не обнаружены !  &1" , to-day , p-obj-type, p-obj-code ) .
     1515             if g#auto = false then do:
     1516               message v-message view-as alert-box  information.
     1517             end.
     1518               else do:
     1519                 run write-log-and-file in p-log-handle (
     1520                       input 1
     1521                     , input log-file-name
     1522                     , input 1
     1523                     , input v-message ) no-error .
     1524               end.
     1525           end.
     1526   end.
     1527   procedure clear-tt-doc :
     1528     do
     1529     on error undo, return error return-value
     1530     :
     1531      for each tt-ord-doc:
     1532        delete tt-ord-doc.
     1533      end.
     1534      for each tt-ord-line:
     1535        delete tt-ord-line.
     1536      end.
     1537     end.
     1538   end procedure.
     1539   procedure make-tt-doc :
     1540   define parameter buffer  buf_ord-doc  for ub.ord-doc .
     1541   define variable v-type as character no-undo .
     1542   define buffer buf_ord-doc-attr   for ub.ord-doc-attr  .
     1543   define buffer buf_ord-line-attr  for ub.ord-line-attr  .
     1544   define buffer buf_ord-line       for ub.ord-line  .
     1545   define variable v-new-code as character no-undo .
     1546   define variable v-date as character no-undo .
     1547   define variable v-ok-done as character no-undo .
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551     run clear-tt-doc.
     1552     for each buf_ord-doc-attr no-lock where
     1553              buf_ord-doc-attr.doc-code   begins  string( buf_ord-doc.doc-code + chr(4) ) and
     1554              buf_ord-doc-attr.attr-code = 'cycle-doc-code':U :
     1555         v-new-code = buf_ord-doc-attr.doc-code .
     1556         run orddocattr-value (
     1557             input  v-new-code,
     1558             input  'cycle-done':U ,
     1559             output v-ok-done,
     1560             output v-type ) .
     1561         if v-ok-done = "yes" then next .
     1562         create tt-ord-doc.
     1563         buffer-copy buf_ord-doc to tt-ord-doc
     1564         assign
     1565           tt-ord-doc.doc-code = buf_ord-doc-attr.attr-value
     1566           tt-ord-doc.order-type = 1
     1567           .
     1568         run orddocattr-value (
     1569             input  v-new-code,
     1570             input  'cycle-day':U ,
     1571             output tt-ord-doc.cycle-day,
     1572             output v-type ) .
     1573         run orddocattr-value (
     1574             input  v-new-code,
     1575             input  'cycle-contract-code':U,
     1576             output tt-ord-doc.contract-code,
     1577             output v-type ) .
     1578         run orddocattr-value (
     1579             input  v-new-code,
     1580             input  'cycle-ship-date':U ,
     1581             output v-date,
     1582             output v-type ) .
     1583         tt-ord-doc.ship-date =string-to-date(v-date) .
     1584         run orddocattr-value (
     1585             input  v-new-code,
     1586             input  'cycle-ship-time':U ,
     1587             output tt-ord-doc.ship-time,
     1588             output v-type ) .
     1589         run orddocattr-value (
     1590             input  v-new-code,
     1591             input  'cycle-date1':U  ,
     1592             output v-date ,
     1593             output v-type ) .
     1594             tt-ord-doc.date-sale-1 = string-to-date(v-date) .
     1595         run orddocattr-value (
     1596             input  v-new-code,
     1597             input  'cycle-date2':U ,
     1598             output v-date,
     1599             output v-type ) .
     1600             tt-ord-doc.date-sale-2 = string-to-date(v-date).
     1601         run orddocattr-value (
     1602             input  v-new-code,
     1603             input  'cycle-doc-date':U  ,
     1604             output  v-date,
     1605             output v-type ) .
     1606             tt-ord-doc.doc-date =string-to-date(v-date) .
     1607             for each buf_ord-line-attr no-lock where
     1608                      buf_ord-line-attr.doc-code = v-new-code and
     1609                      buf_ord-line-attr.attr-code = 'cycle-cli-qnty':U ,
     1610                first buf_ord-line no-lock where
     1611                      buf_ord-line.doc-code = buf_ord-doc.doc-code  and
     1612                      buf_ord-line.gds-code = buf_ord-line-attr.gds-code
     1613                      :
     1614                 create  tt-ord-line .
     1615                 buffer-copy buf_ord-line to tt-ord-line
     1616                 assign
     1617                     tt-ord-line.doc-code = tt-ord-doc.doc-code
     1618                     tt-ord-line.cli-qnty = decimal (buf_ord-line-attr.attr-value)
     1619                     tt-ord-line.qnty     = tt-ord-line.cli-qnty * tt-ord-line.cli-base-rate
     1620                     tt-ord-line.sum-rubl = tt-ord-line.qnty * tt-ord-line.price-rubl
     1621                     tt-ord-line.sum-base = tt-ord-line.qnty * tt-ord-line.price-base
     1622                     tt-ord-line.sum-cli  = tt-ord-line.cli-qnty * tt-ord-line.price-cli
     1623                 .
     1624             end.
     1625     end.
     1626     end.
     1627   end procedure.
     1628   procedure ver-izt :
     1629   define input  parameter p-event-code as character no-undo .
     1630   define input  parameter p-gds-code as integer   no-undo .
     1631   define input  parameter p-obj-type as character no-undo .
     1632   define input  parameter p-obj-code as integer   no-undo .
     1633   define output parameter p-error as logical   no-undo .
     1634   define variable p-Ok as logical   no-undo .
     1635   define variable p-mess as character no-undo .
     1636     do
     1637     on error undo, return error return-value
     1638     :
     1639     p-error = false .
     1640   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1641   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     1642     (input  p-event-code
     1643     ,input  p-gds-code
     1644     ,input  p-obj-type
     1645     ,input  p-obj-code
     1646     ,input  no
     1647     ,output p-Ok
     1648     ,output p-mess
     1649     ) no-error.
     1650        if p-mess <> "" then do:
     1651             run write-log-and-file in p-log-handle (
     1652                   input 1
     1653                 , input log-file-name
     1654                 , input 1
     1655                 , input p-mess ) no-error .
     1656        end.
     1657       if p-ok = false then p-error = true  .
     1658     end.
     1659   end procedure.
     1660   procedure current-contract :
     1661   define input  parameter p-ord-doc       as character no-undo .
     1662   define output parameter p-contract-code as integer   no-undo .
     1663   define buffer buf_ord-doc for ub.ord-doc  .
     1664   define buffer buf-contract for ub.contract  .
     1665     do
     1666     on error undo, return error return-value
     1667     :
     1668     p-contract-code = 0.
     1669     find first buf_ord-doc no-lock where
     1670                 buf_ord-doc.doc-code = p-ord-doc no-error .
     1671     find first buf-contract no-lock where
     1672                buf-contract.host-code = buf_ord-doc.host-code    and
     1673                buf-contract.cli-type  = buf_ord-doc.cli-type     and
     1674                buf-contract.cli-code  = buf_ord-doc.cli-code     and
     1675                buf-contract.status_   = 'тек':U         and
     1676                buf-contract.contract-date-beg <= buf_ord-doc.ship-date and
     1677                ( buf-contract.contract-date-end >= buf_ord-doc.ship-date  or
     1678                  buf-contract.contract-date-end = date('') )
     1679                no-error .
     1680         if not available buf-contract then do:
     1681             find first buf-contract no-lock where
     1682                        buf-contract.host-code = buf_ord-doc.host-code    and
     1683                        buf-contract.cli-type  = buf_ord-doc.cli-type     and
     1684                        buf-contract.cli-code  = buf_ord-doc.cli-code     and
     1685                        buf-contract.status_   = 'тек':U         no-error .
     1686         end.
     1687         if available buf-contract then do:
     1688            p-contract-code = buf-contract.contract-code.
     1689         end.
     1690     end.
     1691   end procedure.
