     1377                       :
     1378                 if v-ordcyclg then do:
     1379                     if  v-contract-curr <> 0 and
     1380                         Can-Find-Spec  ( tt-ord-doc.host-code,
     1381                                          v-contract-curr,
     1382                                          tt-ord-line.gds-code)
     1383                     then do:
     1384   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   ASSIGN
     1386      i-gl-Host-Code      = 0
     1387      i-gl-Contract-Code  = 0
     1388      i-gl-Extent3        = 0
     1389      .
     1390   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
