     1058   function string-to-date returns date ( input p-string  as character):
     1059     define variable v-date as date no-undo .
     1060     assign
     1061     v-date =  date(integer(substring(p-string, 4, 2))
     1062                   ,integer(substring(p-string, 1, 2))
     1063                   , year(date(p-string))
     1064                  ) no-error .
     1065     if error-status:error then return ?.
     1066     return v-date.
     1067   END FUNCTION.
