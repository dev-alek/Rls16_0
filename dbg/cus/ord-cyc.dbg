     1228   FOR EACH
     1229       grpb_contract-specif
     1230        NO-LOCK
     1231        WHERE
     1232            grpb_contract-specif.Host-code    = i-gl-Host-Code
     1233        AND grpb_contract-specif.Contract-num = i-gl-Contract-Code
     1234                          ,
