     1364                     newb_ord-doc.date-sale-2 = tt-ord-doc.date-sale-2  + tt-ord-doc.cycle-day
     1365                     newb_ord-doc.PS         =  substitute("по &1 " ,  tt-ord-doc.doc-code   )
     1366              .
     1367              kk = 0.
     1368              run current-contract (input tt-ord-doc.doc-code , output v-contract-curr ) .
     1369              newb_ord-doc.contract-code = v-contract-curr.
     1370              for each ub.ord-line no-lock where
     1371                       ub.ord-line.doc-code = ub.ord-doc.doc-code ,
     1372                 first tt-ord-line where
     1373                       tt-ord-line.doc-code = tt-ord-doc.doc-code and
     1374                       tt-ord-line.gds-code = ub.ord-line.gds-code ,
     1375                 first buf_goods no-lock where
