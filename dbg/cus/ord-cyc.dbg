     1237                                        grpb_goods.grp-code  = buf_goods.grp-code :
     1238                                    find first newb_ord-line no-lock where
     1239                                               newb_ord-line.doc-code = loc-ord-num and
     1240                                               newb_ord-line.gds-code =  grpb_contract-specif.gds-code no-error .
     1241                                           if not available  newb_ord-line then do:
     1242                                               run ver-izt (
