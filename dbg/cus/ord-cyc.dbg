      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129     define variable v-cntxt-db-num        as integer   no-undo .
      130     define variable v-cntxt-userid        as character no-undo .
      131     define variable v-cntxt-level         as character no-undo .
      132     define variable v-cntxt-host-code-obj as integer   no-undo .
      133     define variable v-cntxt-obj-type      as character no-undo .
      134     define variable v-cntxt-obj-code      as integer   no-undo .
      135     define variable v-cntxt-db-num-obj    as integer   no-undo .
      136     define variable v-cntxt-is-admin      as logical   no-undo .
      137   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   procedure proc-ord-code :
      139   define input  parameter  p-type as character no-undo .
      140   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      141   define input  parameter  v-cntxt-obj-type as character no-undo .
      142   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      143   define input  parameter  p-i-doc    as character no-undo .
      144   define output parameter  p-ord-doc  as character no-undo .
      145   define variable          v-idop     as character no-undo .
      146     do
      147     on error undo, return error return-value
      148     :
      149   case p-type :
      150       when "main-no-ver" then do:
      151         if  (v-cntxt-db-num <> 0) then
      152           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      153         else
      154           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      155       end.
      156       when "main" then do:
      157             do while true:
      158             if  (v-cntxt-db-num <> 0) then
      159               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      160             else
      161               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      162             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      163             End.
      164       end.
      165       when "chip" then do:
      166         assign
      167           v-idop = p-i-doc .
      168         do while true :
      169           if index (v-idop , ".") = 0 then
      170             v-idop  = replace (v-idop , "-", "-1.").
      171           else
      172             v-idop  =
      173             substring (v-idop , 1, index (v-idop, "-")) +
      174             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      175             substring (v-idop, index (v-idop, ".")).
      176           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      177         end.
      178         assign
      179           p-ord-doc = v-idop.
      180       end.
      181   end case.
      182     end.
      183   end procedure.
      184   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
