     1202                         Can-Find-Spec  ( ub.ord-doc.host-code,
     1203                                          v-contract-curr,
     1204                                          ub.ord-line.gds-code)
     1205                     then do:
     1206   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   ASSIGN
     1208      i-gl-Host-Code      = 0
