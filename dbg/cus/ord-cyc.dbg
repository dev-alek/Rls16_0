     1253                                                 newb_ord-line.artic         = grpb_goods.artic
     1254                                                 newb_ord-line.prod-type     = grpb_goods.prod-type
     1255                                                 newb_ord-line.prod-code     = grpb_goods.prod-code
     1256                                                 newb_ord-line.gds-code      = grpb_goods.gds-code
     1257                                                 newb_ord-line.cli-qnty      =  ?
     1258                                                 newb_ord-line.price-cli     = grpb_contract-specif.price-cli
     1259                                                 newb_ord-line.vat-pc        = grpb_contract-specif.vat-pc
     1260                                                 newb_ord-line.cli-base-rate = grpb_contract-specif.cli-base-rate
