     1147   for each ub.ord-doc where ub.ord-doc.cycle-day > 0
     1148                          and ub.ord-doc.host-code = G#host-code
     1149                          and ub.ord-doc.obj-type  = p-obj-type
     1150                          and ub.ord-doc.obj-code  = p-obj-code
     1151                          and (integer(to-day - ub.ord-doc.doc-date) >= ub.ord-doc.cycle-day)
     1152                          and ub.ord-doc.order-type = 1
     1153                          and ub.ord-doc.status_ <> 'новый':U
     1154                            exclusive-lock   :
     1155   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1156   run proc-ord-code in this-procedure
     1157    (input   'main' ,
     1158     input   g#db-num ,
     1159     input   ub.ord-doc.obj-type ,
     1160     input   ub.ord-doc.obj-code ,
     1161     input   v-i-doc ,
     1162     output  loc-ord-num
     1163    ) .
     1164       if g#auto then do:
     1165         v-message = substitute("&3&4 Создание нового заказа № &1 по заказу &2 " , loc-ord-num , ub.ord-doc.doc-code , ub.ord-doc.obj-type, ub.ord-doc.obj-code ) .
     1166         run write-log-and-file in p-log-handle (
     1167               input 1
     1168             , input log-file-name
     1169             , input 1
     1170             , input v-message ) no-error .
     1171       end.
     1172       Assign
     1173       i = i + 1
     1174       loc-date-ship = ub.ord-doc.ship-date
     1175       no-error.
     1176       if i = 1 then loc-ord-num1 = loc-ord-num .
     1177       create newb_ord-doc.
     1178       buffer-copy ub.ord-doc except ub.ord-doc.doc-code to newb_ord-doc
     1179              Assign newb_ord-doc.doc-code  = loc-ord-num
     1180                     newb_ord-doc.doc-date  = to-day
     1181                     newb_ord-doc.ship-date = if ( (loc-date-ship + ub.ord-doc.cycle-day) < to-day ) then  to-day
     1182                                          else (loc-date-ship + ub.ord-doc.cycle-day)
     1183                     newb_ord-doc.status_  = 'новый':U
     1184                     newb_ord-doc.ord-int1 = 0
     1185                     newb_ord-doc.ord-int2 = 0
     1186                     newb_ord-doc.fact-date = ?
     1187                     newb_ord-doc.fact-order = 0
     1188                     newb_ord-doc.date-sale-1 = ub.ord-doc.date-sale-1 + ub.ord-doc.cycle-day
     1189                     newb_ord-doc.date-sale-2 = ub.ord-doc.date-sale-2 + ub.ord-doc.cycle-day
     1190                     newb_ord-doc.PS         =  substitute("по &1 " , ub.ord-doc.doc-code  )
     1191              .
     1192              kk = 0.
     1193              run current-contract (input ub.ord-doc.doc-code , output v-contract-curr ) .
     1194              newb_ord-doc.contract-code = v-contract-curr.
     1195              for each ub.ord-line no-lock where
