      475   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   procedure orddocattr-value :
      477     do
      478     on error undo, return error return-value
      479     :
      480       define input  parameter p-doc-code like ub.ord-doc-attr.doc-code   no-undo .
      481       define input  parameter p-code     like ub.ord-doc-attr.attr-code  no-undo .
      482       define output parameter p-value    like ub.ord-doc-attr.attr-value no-undo .
      483       define output parameter p-type     as character no-undo .
      484       define buffer buf_ord-doc-attr for ub.ord-doc-attr .
      485       define variable v-format         as character no-undo .
      486       define variable v-fillin_width   as integer   no-undo .
      487       define variable v-fillin_height  as integer   no-undo .
      488       define variable v-label          as character no-undo .
      489       define variable v-user-can-edit  as logical   no-undo .
      490       define variable v-output-display as logical   no-undo .
      491       define variable v-other          as character no-undo .
      492       define variable v-proc           as character no-undo .
      493       define variable v-func           as character no-undo .
      494       define variable v-sort           as integer   no-undo .
      495       run orddocattr-code in this-procedure
      496         (input  p-code
      497         ,output p-type
      498         ,output v-format
      499         ,output v-fillin_width
      500         ,output v-fillin_height
      501         ,output v-label
      502         ,output v-user-can-edit
      503         ,output v-output-display
      504         ,output v-proc
      505         ,output v-func
      506         ,output v-sort
      507         ,output v-other
      508         ) no-error .
      509       if error-status :error then do:
      510         undo, return error return-value .
      511       end.
      512       find first buf_ord-doc-attr no-lock
      513         where buf_ord-doc-attr.doc-code  = p-doc-code
      514           and buf_ord-doc-attr.attr-code = p-code
      515         no-error .
      516       if avail buf_ord-doc-attr then do:
      517         assign
      518           p-value =  buf_ord-doc-attr.attr-value
      519         .
      520       end.
      521       else do:
      522         assign
      523           p-value = if p-type = 'L':U then "no":U else ""
      524         .
      525       end.
      526     end.
      527   end procedure.
      528   procedure orddocattr-write :
      529     do
      530     on error undo, return error return-value
      531     :
      532       define input parameter p-doc-code like ub.ord-doc-attr.doc-code   no-undo .
      533       define input parameter p-code     like ub.ord-doc-attr.attr-code  no-undo .
      534       define input parameter p-value    like ub.ord-doc-attr.attr-value no-undo .
      535       define buffer buf_ord-doc-attr for ub.ord-doc-attr .
      536       define variable v-type           as character no-undo .
      537       define variable v-format         as character no-undo .
      538       define variable v-fillin_width   as integer   no-undo .
      539       define variable v-fillin_height  as integer   no-undo .
      540       define variable v-label          as character no-undo .
      541       define variable v-user-can-edit  as logical   no-undo .
      542       define variable v-output-display as logical   no-undo .
      543       define variable v-other          as character no-undo .
      544       define variable v-proc           as character no-undo .
      545       define variable v-func           as character no-undo .
      546       define variable v-sort           as integer   no-undo .
      547       run orddocattr-code in this-procedure
      548         (input  p-code
      549         ,output v-type
      550         ,output v-format
      551         ,output v-fillin_width
      552         ,output v-fillin_height
      553         ,output v-label
      554         ,output v-user-can-edit
      555         ,output v-output-display
      556         ,output v-proc
      557         ,output v-func
      558         ,output v-sort
      559         ,output v-other
      560         ) no-error .
      561       if error-status :error then do:
      562         undo, return error return-value .
      563       end.
      564       find first buf_ord-doc-attr exclusive-lock
      565         where buf_ord-doc-attr.doc-code  = p-doc-code
      566           and buf_ord-doc-attr.attr-code = p-code
      567         no-error .
      568       if not available buf_ord-doc-attr then do:
      569         create buf_ord-doc-attr .
      570         assign
      571           buf_ord-doc-attr.doc-code  = p-doc-code
      572           buf_ord-doc-attr.attr-code = p-code
      573         .
      574       end.
      575       assign
      576         buf_ord-doc-attr.attr-value = p-value
      577       .
      578   end.
      579   end procedure.
      580   procedure orddocattr-exist :
      581     do
