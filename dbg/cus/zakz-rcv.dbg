     6257   ON CHOOSE OF b-close IN FRAME d-all-docs
     6258   DO:
     6259   define variable ll-recid as recid no-undo .
     6260   define variable mark-list as character no-undo.
     6261   define buffer buf_clients for ub.clients  .
     6262   define buffer buf_ext-classif for ub.ext-classif  .
     6263   define buffer buf1_ord-doc for ub.ord-doc.
     6264     find current shar-buf_ord-doc no-lock no-error.
     6265     if del-list = "" then
     6266       assign
     6267         mark-list = string(recid(shar-buf_ord-doc))
     6268         .
     6269     else
     6270       assign
     6271         mark-list = del-list
     6272         .
     6273     do kk = 1 to num-entries(mark-list) :
     6274       for each shar-buf_ord-doc share-lock where recid(shar-buf_ord-doc) = integer(entry(kk,mark-list)):
     6275         if shar-buf_ord-doc.status_ = 'факт':U and shar-buf_ord-doc.flag_= true  then do:
     6276            message "Заказ закрыт до статуса ФАКТ .".
     6277            next.
     6278         end.
     6279     if ( shar-buf_ord-doc.status_ = 'новый':U or
     6280          shar-buf_ord-doc.status_ = 'поставка':U) and
     6281          shar-buf_ord-doc.doc-type = 'ОП':U then do:
     6282       if status-is-edoc-nn ( input is-edoc-nn
     6283                             , input shar-buf_ord-doc.cli-type
     6284                             , input shar-buf_ord-doc.cli-code
     6285                             , input shar-buf_ord-doc.obj-type
     6286                             , input shar-buf_ord-doc.obj-code
     6287                             )
     6288        or  (status-is-edi ( input is-edi
     6289                         , input shar-buf_ord-doc.cli-type
     6290                         , input shar-buf_ord-doc.cli-code
     6291                         , input shar-buf_ord-doc.obj-type
     6292                         , input shar-buf_ord-doc.obj-code
     6293                         , output v-dm-edi
     6294                         )
     6295             and
     6296             shar-buf_ord-doc.whole-send-news = integer('2':U)
     6297             )
     6298       then do:
     6299         if shar-buf_ord-doc.status_ = 'новый':U then do:
     6300           message
     6301           substitute(" По ПОСТАВЩИКУ &1&2 система работает по EDOC\EDI , Закрыть можно будет при корректировке заказа в статусе EDOC\EDI ПОДТВЕРЖДЕН"
     6302                      ,shar-buf_ord-doc.cli-type
     6303                      ,shar-buf_ord-doc.cli-code
     6304                      )
     6305           view-as alert-box information .
     6306               next .
     6307         end.
     6308         if shar-buf_ord-doc.status_ = 'поставка':U then do:
     6309          define variable vv-ok as logical   no-undo .
     6310          vv-ok = false .
     6311          message
     6312           substitute(" По ПОСТАВЩИКУ &1&2 система работает по EDOC\EDI. Заказ ожидает поставку. Вы уверены что хотите закрыть заказ без поставки?"
     6313                      ,shar-buf_ord-doc.cli-type
     6314                      ,shar-buf_ord-doc.cli-code)
     6315              view-as alert-box question
     6316              buttons yes-no
     6317              update vv-ok
     6318             .
     6319               if not vv-ok then  next .
     6320         end.
     6321       end.
     6322     end.
     6323     message
     6324       "Закрыть " (if shar-buf_ord-doc.doc-type  =  'ОФ':U then " заявку " else " заказ " ) shar-buf_ord-doc.doc-code  " ?"
     6325       view-as alert-box question
     6326       buttons yes-no
     6327       update g#log .
     6328         if not g#log then next.
     6329         ll-recid = recid(shar-buf_ord-doc).
     6330         run cus/ord-clos.p
     6331           (input  parParentProc
     6332           ,input  recid(shar-buf_ord-doc)
     6333           ,input  store-type
     6334           ,input  store-code
     6335           ,input  v-cntxt-db-num
     6336           ,input  true
     6337           ,input  "no"
     6338           ) no-error .
     6339           if error-status :error or return-value <> "" then do:
     6340               message return-value         skip
     6341               error-status :get-message(1) skip
     6342               view-as alert-box error
     6343               title "Закрытие заказа"
     6344             .
     6345           end.
     6346       end.
     6347     end.
     6348     find current shar-buf_ord-doc no-lock no-error.
     6349     run ui-on in this-procedure (yes, no, '':U).
     6350     reposition br-docs to recid ll-recid no-error.
     6351     apply "value-changed" to br-docs in frame d-all-docs .
     6352     return no-apply.
     6353    END.
