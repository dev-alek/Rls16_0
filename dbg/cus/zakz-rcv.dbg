     2160   DEFINE new shared QUERY br-docs for shar-buf_ord-doc SCROLLING.
     2161   DEFINE QUERY BR-rcv FOR
     2162         ub.ord-doc-rcv,
     2163         bufs_ord-doc-rcv,
     2164         ub.ord-chain ,
     2165         ub.trn-doc SCROLLING.
     2166   FUNCTION f-fo RETURNS CHARACTER
     2167     ( buffer loc-t-doc for ub.ord-doc ) :
     2168   define buffer bufb_contract for ub.contract  .
     2169   define variable v-proc as character no-undo .
     2170      find first bufb_contract no-lock where
     2171                 bufb_contract.contract-code = loc-t-doc.contract-code and
     2172                 bufb_contract.host-code     = loc-t-doc.host-code and
     2173                 bufb_contract.usl-opl       = 'Предоплата(%)':U
     2174                 no-error .
     2175       if available bufb_contract then v-proc = "%" + trim( string(bufb_contract.srok-opl)).
     2176                                  else v-proc = "".
     2177   if v-proc = ? then v-proc = "err" .
     2178    if loc-t-doc.cr-fo = yes then do:
     2179      if loc-t-doc.status_ = 'факт':U
     2180      then do:
     2181       if loc-t-doc.cr-fo2 = yes then return substring(string ( loc-t-doc.fo-date, "99/99/99"),1,5) + "-" + substring (string (loc-t-doc.fo-date2, "99/99/99"),1,5)  .
     2182       else return string (loc-t-doc.fo-date, "99/99/99") + v-proc.
     2183      end.
     2184      else return string (loc-t-doc.fo-date, "99/99/99") + v-proc.
     2185    end.
     2186    else do:
     2187      if loc-t-doc.need-fo = 0 then do:
     2188        return "--------".
     2189      end.
     2190      if loc-t-doc.need-fo = 1 then do:
     2191        return "".
     2192      end.
     2193      if loc-t-doc.need-fo = 2 then do:
     2194        return "не опред".
     2195      end.
     2196    end.
     2197   END FUNCTION.
     2198   FUNCTION mark-string RETURN CHAR (buffer loc-t-doc for shar-buf_ord-doc ).
     2199     if can-do (del-list, string (recid (loc-t-doc))) then RETURN "*".
     2200     else RETURN "".
     2201   END FUNCTION.
     2202     define variable str-status-edoc-nn as character no-undo .
     2203   define variable v-color as integer no-undo init ?.
     2204   DEFINE BROWSE br-docs QUERY br-docs NO-LOCK DISPLAY
     2205         mark-string (buffer shar-buf_ord-doc) @ mark COLUMN-LABEL "*" FORMAT "x(1)"
     2206         if shar-buf_ord-doc.order-type = 1 then "*" Else (if shar-buf_ord-doc.order-type = 4 then chr(176) Else "" ) COLUMN-LABEL "Ц" FORMAT "x(1)"    COLUMN-FGCOLOR 3
     2207         (substring (shar-buf_ord-doc.doc-type, 1, 2)) COLUMN-LABEL "Т" FORMAT "x(2)"
     2208         IF (shar-buf_ord-doc.status_ = 'факт':U or shar-buf_ord-doc.status_ = 'закрыто':U) THEN (shar-buf_ord-doc.status_ + string(shar-buf_ord-doc.flag_,"+/-")) ELSE (shar-buf_ord-doc.status_) COLUMN-LABEL "Статус" format "x(8)"
     2209         status-edoc-edi-light (buffer shar-buf_ord-doc,
     2210                                 input is-edoc-nn,
     2211                                 input is-edi,
     2212                                 output v-color)
     2213                                 @ str-status-edoc-nn COLUMN-LABEL "Статус EDOC/EDI" FORMAT "x(20)"
     2214         shar-buf_ord-doc.doc-date   format "99/99/9999" column-label "Дата"
     2215         shar-buf_ord-doc.fact-date  format "99/99/9999" COLUMN-LABEL "Факт"
     2216         shar-buf_ord-doc.cli-type + " " + String(shar-buf_ord-doc.cli-code)   format "x(13)" column-label "Код"
     2217         shar-buf_ord-doc.cli-name  format "x(27)"
     2218         shar-buf_ord-doc.doc-code   format "x(12)"
     2219         shar-buf_ord-doc.cons-code  column-label "СЗФП"
     2220         shar-buf_ord-doc.host-code  format "9999999999" column-label "Фирма"
     2221         shar-buf_ord-doc.obj-type + " " + string(shar-buf_ord-doc.obj-code)  column-label "Объект"
     2222         shar-buf_ord-doc.ship-date column-label "Доставка"
     2223         string(shar-buf_ord-doc.ship-time,"hh:mm") column-label "Время" format "x(5)"
     2224         entry(1, shar-buf_ord-doc.cli-out-doc, chr(4)) format "x(12)" column-label "№ по ПОСТ-КУ"
     2225         shar-buf_ord-doc.contract-code format ">>>>>>>>>>>>9" column-label "№ договора"
     2226         f-fo ( buffer shar-buf_ord-doc ) @ v-fo column-label "ФО" format "x(11)"
     2227         shar-buf_ord-doc.ord-date1 format  "99/99/9999" column-label "Выгрузка"
     2228       WITH SIZE 99 BY 9 separators
     2229        TITLE "Список заказов".
     2230       DEFINE BROWSE BR-rcv  QUERY BR-rcv NO-LOCK DISPLAY
     2231         if ub.ord-doc-rcv.ord-int2 = integer('2':U) then "!" else "" column-label "!" FORMAT "x(1)"  COLUMN-FGCOLOR 12
     2232         ub.ord-doc-rcv.rcv-code column-label "№ пост-ки"
     2233         ub.ord-doc-rcv.status_
     2234         ub.ord-doc-rcv.doc-date FORMAT "99/99/99"
