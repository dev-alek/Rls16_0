     3684       define variable v-user-can-edit  as logical   no-undo .
     3685       define variable v-output-display as logical   no-undo .
     3686       define variable v-other          as character no-undo .
     3687       define variable v-proc           as character no-undo .
     3688       define variable v-func           as character no-undo .
     3689       define variable v-sort           as integer   no-undo .
     3690       run ordlineattr-code in this-procedure
     3691         (input  p-code
     3692         ,output v-type
     3693         ,output v-format
     3694         ,output v-fillin_width
     3695         ,output v-fillin_height
     3696         ,output v-label
     3697         ,output v-user-can-edit
     3698         ,output v-output-display
     3699         ,output v-proc
     3700         ,output v-func
     3701         ,output v-sort
     3702         ,output v-other
