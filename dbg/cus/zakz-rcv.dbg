    12135           error-status :get-message(1) skip
    12136           return-value skip
    12137           "Ошибка из orddocattr-write"
    12138           view-as alert-box error
    12139         .
    12140     run orddocattr-write (
    12141          input v-new-code
    12142         ,input 'cycle-day':U
    12143         ,input string(buf_ord-doc.cycle-day)) no-error .
    12144         if error-status :error then
    12145         message
    12146           vss-workfile vss-revision vss-description skip
    12147           error-status :get-message(1) skip
    12148           return-value skip
    12149           "Ошибка из orddocattr-write"
    12150           view-as alert-box error
    12151         .
    12152     run orddocattr-write (
    12153          input v-new-code
    12154         ,input 'cycle-doc-date':U
    12155         ,input string(buf_ord-doc.doc-date , "99/99/9999" )) no-error .
    12156         if error-status :error then
    12157         message
    12158           vss-workfile vss-revision vss-description skip
    12159           error-status :get-message(1) skip
    12160           return-value skip
    12161           "Ошибка из orddocattr-write"
    12162           view-as alert-box error
    12163         .
    12164     run orddocattr-write (
    12165          input v-new-code
    12166         ,input 'exch-code':U
    12167         ,input string(buf_ord-doc.exch-code)) no-error .
    12168         if error-status :error then
    12169         message
    12170           vss-workfile vss-revision vss-description skip
    12171           error-status :get-message(1) skip
    12172           return-value skip
