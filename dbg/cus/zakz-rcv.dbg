     3616   procedure ordlineattr-value :
     3617     do
     3618     on error undo, return error return-value
     3619     :
     3620       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     3621       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     3622       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     3623       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     3624       define output parameter p-type     as character no-undo .
     3625       define buffer buf_ord-line-attr for ub.ord-line-attr .
     3626       define variable v-format         as character no-undo .
     3627       define variable v-fillin_width   as integer   no-undo .
     3628       define variable v-fillin_height  as integer   no-undo .
     3629       define variable v-label          as character no-undo .
     3630       define variable v-user-can-edit  as logical   no-undo .
     3631       define variable v-output-display as logical   no-undo .
     3632       define variable v-other          as character no-undo .
     3633       define variable v-proc           as character no-undo .
     3634       define variable v-func           as character no-undo .
     3635       define variable v-sort           as integer   no-undo .
     3636       run ordlineattr-code in this-procedure
     3637         (input  p-code
     3638         ,output p-type
     3639         ,output v-format
     3640         ,output v-fillin_width
     3641         ,output v-fillin_height
     3642         ,output v-label
     3643         ,output v-user-can-edit
     3644         ,output v-output-display
     3645         ,output v-proc
     3646         ,output v-func
     3647         ,output v-sort
     3648         ,output v-other
     3649         ) no-error .
     3650       if error-status :error then do:
     3651         undo, return error return-value .
     3652       end.
     3653       find first buf_ord-line-attr no-lock
     3654         where buf_ord-line-attr.doc-code  = p-doc-code
     3655           and buf_ord-line-attr.gds-code  = p-gds-code
     3656           and buf_ord-line-attr.attr-code = p-code
     3657         no-error .
     3658       if avail buf_ord-line-attr then do:
     3659         assign
     3660           p-value =  buf_ord-line-attr.attr-value
     3661         .
     3662       end.
     3663       else do:
     3664         assign
     3665           p-value = if p-type = 'L':U then "no":U else ""
     3666         .
     3667       end.
     3668     end.
     3669   end procedure.
     3670   procedure ordlineattr-write :
     3671     do
     3672     on error undo, return error return-value
     3673     :
     3674       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
