     5793   apply "go" to frame d-all-docs.
     5794   END.
     5795   ON CHOOSE OF b-quit IN FRAME d-all-docs
     5796   DO:
     5797     if not ( del-list = ?  or  del-list = "" )  then do:
     5798         run gbl/markqwa.p (
     5799                       input b-mark:sensitive
     5800                     , input ? ) no-error.
     5801         if error-status:error then return no-apply.
     5802     end.
     5803     doc-rec = ?.
     5804     del-list = ? .
     5805     DELETE WIDGET-POOL "My-pool" no-error  .
     5806   END.
     5807   ON entry OF ed-notes IN FRAME d-all-docs
     5808   DO:
     5809   if not available shar-buf_ord-doc then do:
     5810     message "Неправильный выбор документа.".
     5811     return no-apply.
     5812   end.
     5813   doc-rec = recid (shar-buf_ord-doc).
     5814   if shar-buf_ord-doc.status_ <> 'факт':U and substring (shar-buf_ord-doc.PS, 1, 1) = "@" then
     5815     message "Чтобы программа не могла заново переписать Ваше примечание, удалите знак @.".
     5816   END.
     5817   on leave of ed-notes in frame d-all-docs
     5818   do:
     5819     do on stop undo, return no-apply:
     5820       find first t-d-b where t-d-b.doc-code = shar-buf_ord-doc.doc-code exclusive-lock no-error .
     5821       if available t-d-b then
     5822         t-d-b.ps = input frame d-all-docs ed-notes.
     5823       find first t-d-b where t-d-b.doc-code = shar-buf_ord-doc.doc-code no-lock  no-error .
     5824     end.
     5825   end.
     5826   ON RETURN, MOUSE-SELECT-DBLCLICK OF ed-notes IN FRAME d-all-docs DO:
     5827   apply "entry" to br-docs in frame d-all-docs.
     5828   return no-apply.
     5829   END.
     5830   ON RETURN, MOUSE-SELECT-DBLCLICK OF br-docs IN FRAME d-all-docs DO:
     5831   apply "choose" to b-lkp in frame d-all-docs.
     5832   END.
