     2297   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2298   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2299   define variable v-waitfram-action01         as character   no-undo .
     2300   define variable v-waitfram-action02         as character   no-undo .
     2301   define variable v-waitfram-action03         as character   no-undo .
     2302   define variable mWaitFramTextBeg            as character   no-undo.
     2303   define variable mWaitFramTextEnd            as character   no-undo.
     2304   define variable mWaitFramView               as logical     no-undo.
     2305   define variable mWaitProcEvent              as logical     no-undo init yes.
     2306   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2307   define variable mWaitFramStop               as logical     no-undo.
     2308   define variable mWaitFramStopUser           as logical     no-undo.
     2309   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2310   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2311   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2312   define button B-WaitFramStop auto-end-key
     2313        label "Стоп"
     2314        size 10 by 1 tooltip "Остоновить процесс".
     2315   define button B-viewProcInfo
     2316        label "Информация"
     2317        size 15 by 1 tooltip "Информация о процесс".
     2318   define frame waitfram
     2319     v-waitfram-action01 format "x(72)" no-label skip
     2320     v-waitfram-action02 format "x(72)" no-label skip
     2321     v-waitfram-action03 format "x(72)" no-label skip
     2322     B-viewProcInfo
     2323     B-WaitFramStop at row 4 col 30
     2324     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2325     .
     2326   define new global shared variable mBatchMode as logical no-undo init ?.
     2327   define variable mFramBachModHandle as handle no-undo.
     2328   mFramBachModHandle = frame waitfram:handle.
     2329   define variable mFameOldVis as logical no-undo.
     2330   define variable mVisCUrentVin as logical no-undo.
     2331   if session:batch-mode
     2332   then
     2333      mBatchMode = yes.
     2334   if mBatchMode = ? then do:
     2335     mVisCUrentVin = current-window:visible.
     2336     mFameOldVis = mFramBachModHandle:visible.
     2337     mFramBachModHandle:visible  = yes.
     2338     mBatchMode = mFramBachModHandle:visible ne yes.
     2339     mFramBachModHandle:visible = mFameOldVis.
     2340     current-window:visible = mVisCUrentVin.
     2341   end.
     2342    if  log-manager:logfile-name ne ?
     2343     then DO:
     2344         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2345         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2346         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2347     end.
     2348   on choose of B-WaitFramStop in frame waitfram
     2349   do:
     2350     mWaitFramStop = yes.
     2351     mWaitFramStopUser = yes.
     2352   end.
     2353   function waitfram-check-timeout returns logical():
     2354      define variable vtime as int64 no-undo.
     2355      if mWaitFramStopTimeOut
     2356      then
     2357         return yes.
     2358      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2359      if     mWaitFramTimeOut ne ?
     2360         and mWaitFramTimeOut ne 0
     2361         and mWaitFramTimeOut lt vtime
     2362      then do:
     2363         mWaitFramStopTimeOut = yes.
     2364      end.
     2365      return mWaitFramStopTimeOut.
     2366   end.
     2367   procedure waitfram-hide :
     2368     if not session:batch-mode
     2369     then do
     2370     on error undo, return error return-value
     2371     :
     2372       pause 0 before-hide .
     2373       if not mBatchMode then
     2374         hide frame waitfram .
     2375     if     not mWaitFramView
     2376        and mWaitProcEvent
     2377     then
     2378       process events .
     2379     end.
     2380   end procedure.
     2381   procedure waitfram-show :
     2382     define input  parameter p-message as character no-undo .
     2383     define variable v-left-margin as integer   no-undo .
     2384     if not session:batch-mode
     2385     then do
     2386     on error undo, return error return-value
     2387     :
     2388       if length(p-message) <= 70 then do:
     2389         assign
     2390           v-left-margin = integer((70 - length(p-message)) / 2)
     2391         .
     2392         assign
     2393           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2394         .
     2395         assign
     2396           v-waitfram-action01 = " "
     2397           v-waitfram-action02 = " "
     2398                                    + fill(" ", v-left-margin)
     2399                                    + p-message
     2400           v-waitfram-action03 = " "
     2401         .
     2402       end.
     2403       else do:
     2404         define variable vRindex1 as integer no-undo.
     2405         define variable vRindex2 as integer no-undo.
     2406         vRindex1 = r-index(p-message," ",70).
     2407         if vRindex1 = 0
     2408         then
     2409            vRindex1 = 70.
     2410         if length(p-message)  <= vRindex1 + 70 then do:
     2411           assign
     2412             v-waitfram-action01 = " "
     2413             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2414             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2415           .
     2416         end.
     2417         else do:
     2418           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2419           if vRindex2 <= vRindex1
     2420           then
     2421              vRindex2 = vRindex1 + 70.
     2422           assign
     2423             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2424             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2425             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2426           .
     2427         end.
     2428       end.
     2429       B-viewProcInfo:visible   in frame waitfram = no.
     2430       B-viewProcInfo:sensitive in frame waitfram = no.
     2431       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2432       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2433       if  (   mWaitFramView
     2434          or  mWaitProcEvent)
     2435          and not mBatchMode
     2436       then
     2437          display
     2438             v-waitfram-action01 skip
     2439             v-waitfram-action02 skip
     2440             v-waitfram-action03 skip
     2441          with frame waitfram .
     2442       if     mWaitFramView
     2443          then do:
     2444             if     mWaitFramInterval ne ?
     2445                and not mBatchMode
     2446             then
     2447                wait-for go of frame waitfram pause mWaitFramInterval.
     2448          end.
     2449          else
     2450             if     mWaitProcEvent
     2451                and not mBatchMode
     2452             then
     2453                process events .
     2454     end.
     2455   end procedure.
     2456      procedure waitfram-show-this:
     2457         define input  parameter iInterval as int64 no-undo.
     2458         define variable vtime as int64 no-undo.
     2459         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2460         mWaitFramInterval = iInterval.
     2461         run waitfram-show (substitute("&1&2 &3&4" ,
     2462                                       mWaitFramTextBeg ,
     2463                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2464                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2465                                       mWaitFramTextEnd
     2466                                      )
     2467                           ).
     2468      end.
     2469      procedure WaitFramRunPause:
     2470         define input  parameter iInterval as dec no-undo.
     2471         define variable vStart  as datetime-tz no-undo.
     2472         define variable vend    as datetime-tz no-undo.
     2473         define variable vint as int64 no-undo.
     2474         define variable vOk as logical no-undo.
     2475         vStart = now.
     2476         vend   = vStart.
     2477         publish "WaitFramPause" (iInterval,output vOk).
     2478         vend   =  now.
     2479         vint = vend - vStart.
     2480         vint = iInterval - vint / 1000.
     2481         if     not mWaitFramStop
     2482            and (   vint > 0
     2483                 or (    not vOk
     2484                     and iInterval eq ?
     2485                     )
     2486                 )
     2487         then
     2488            run waitfram-show-this (iInterval).
     2489         vend   =  now.
     2490         vint = vend - vStart.
     2491         vint = iInterval - vint / 1000.
     2492         if     not mWaitFramStop
     2493            and vint > 0
     2494         then do:
     2495            run gbl/pause.p (vint * 1000).
     2496         end.
     2497         if iInterval ne ?
     2498         then
     2499            publish "WaitFramStop".
     2500         waitfram-check-timeout().
     2501      end.
     2502      procedure WaitFramWaitFor:
     2503         define input  parameter iInterval as dec no-undo.
     2504         assign
     2505            mWaitFramStartProc   = now
     2506            mWaitFramStopUser    = no
     2507            mWaitFramStopTimeOut = no
     2508         .
     2509         block-wait:
     2510         do while not mWaitFramStop:
     2511            run WaitFramRunPause (iInterval).
     2512            if  waitfram-check-timeout()
     2513            then do:
     2514               leave block-wait.
     2515            end.
     2516         end.
     2517         run waitfram-hide.
     2518      end.
     2519   procedure waitfram-join :
     2520     define input  parameter p-line-1  as character no-undo .
     2521     define input  parameter p-line-2  as character no-undo .
     2522     define input  parameter p-line-3  as character no-undo .
     2523     define output parameter p-message as character no-undo .
     2524     do
     2525     on error undo, return error return-value
     2526     :
     2527       assign
     2528         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2529                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2530                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2531       .
     2532     end.
     2533   end procedure.
     2534   function waitfram-join-function returns character
     2535     (input p-line-1 as character
     2536     ,input p-line-2 as character
     2537     ,input p-line-3 as character
     2538     ).
     2539     define variable v-message as character no-undo .
     2540     run waitfram-join in this-procedure
     2541       (input  p-line-1
     2542       ,input  p-line-2
     2543       ,input  p-line-3
     2544       ,output v-message
     2545       ) .
     2546     return v-message .
     2547   end function .
