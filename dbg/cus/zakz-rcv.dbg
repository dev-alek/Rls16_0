    11855   procedure clip-ord :
    11856   define output parameter p-recid as recid no-undo .
    11857   define buffer buf_ord-doc  for ub.ord-doc  .
    11858   define buffer new_ord-doc  for ub.ord-doc  .
    11859   define buffer new_ord-line for ub.ord-line  .
    11860   define buffer buf_ord-line for ub.ord-line  .
    11861   define buffer bb2_ord-line for ub.ord-line.
    11862   define buffer bb_ord-line  for ub.ord-line.
    11863   define buffer bb_goods for ub.goods  .
    11864   define variable loc-ord-num as character no-undo .
    11865     do
    11866     on error undo, return error return-value
    11867     :
    11868   for each tempclip-orddoc :
    11869     delete tempclip-orddoc.
    11870   end.
    11871   find current shar-buf_ord-doc no-lock .
    11872   p-recid = recid(shar-buf_ord-doc) .
    11873    if num-entries (del-list) < 2 then do:
    11874       message "Для объединения в один заказ нужно выделить не менее двух заказов!"  view-as alert-box information .
    11875       return .
    11876    end.
    11877   define variable v-nn   as integer   no-undo .
    11878   define variable v-i    as integer   no-undo .
    11879   define variable v-str  as character no-undo .
    11880   define variable v-diff as character no-undo .
    11881   define variable v-diff-contract as character no-undo init "" .
    11882   v-nn = num-entries (del-list).
    11883   find first buf_ord-doc exclusive-lock where
    11884         recid(buf_ord-doc) = integer ( entry (1, del-list)) no-error .
    11885   if error-status :error then return .
    11886   if buf_ord-doc.ord-int1 <> 0 then do:
    11887      message "Нельзя объединять заказы , которые уже начали обработку по EDOC\EDI !"
    11888      view-as alert-box information .
    11889      return .
    11890   end.
    11891    create tempclip-orddoc.
    11892    buffer-copy buf_ord-doc to tempclip-orddoc .
    11893    find first tempclip-orddoc.
    11894   define variable v-longchar as longchar no-undo .
    11895   define variable v-err-clip as logical   no-undo .
    11896   v-err-clip = false .
    11897     do v-i = 1 to v-nn :
    11898       find first  buf_ord-doc exclusive-lock where
    11899            recid (buf_ord-doc) = integer ( entry (v-i, del-list))  .
    11900            if not available buf_ord-doc then next.
    11901       if buf_ord-doc.status_ <> 'новый':U then do:
    11902         message "Объединять заказы  можно только в статусе НОВЫЙ !"
    11903         view-as alert-box information .
    11904         return .
    11905       end.
    11906       if buf_ord-doc.doc-type <> 'ОП':U then do:
    11907         message "Объединять  можно только заказы ОП !"
    11908         view-as alert-box information .
    11909         return .
    11910       end.
    11911       buffer-compare tempclip-orddoc EXCEPT
    11912         agnt
    11913         boss
    11914         cli-qnty
    11915         creid
    11916         date-sale-1
    11917         date-sale-2
    11918         doc-code
    11919         doc-date
    11920         e-method
    11921         end-date
    11922         exch-date
    11923         ord-method
    11924         out-code
    11925         qnty
    11926         real-date-create
    11927         real-time-create
    11928         start-date
    11929         sub-par
    11930         sum-base
    11931         sum-cli
    11932         sum-rubl
    11933         sys-date
    11934         sys-time-int
    11935         sys-time
    11936         tot-lines
    11937         user-db-num
    11938         user-name
    11939         whole-send-news
    11940         wrkr
    11941         fact-num
    11942         ps
    11943         cli-name
    11944         exch-date
    11945         transport-cli-code
    11946         transport-cli-type
    11947         transport-condition
    11948         transport-contract
    11949         transport-host-code
    11950         transport-value
    11951         transport-VAT
    11952         pay-day
    11953         contract-code
    11954         order-type
    11955         cycle-day
    11956         cli-out-doc
    11957       to buf_ord-doc save result in v-diff .
    11958       .
    11959       if entry(1, buf_ord-doc.cli-out-doc, chr(4)) <> entry(1, tempclip-orddoc.cli-out-doc, chr(4)) then do:
    11960         v-diff = v-diff + (if v-diff = '' then '' else chr(44)) + "cli-out-doc".
    11961       end.
    11962       if v-diff <> ""
    11963       then do:
    11964             define variable v-str2 as character no-undo .
    11965             define variable newstr as character no-undo .
    11966             define variable i as integer   no-undo .
    11967             define variable l as integer   no-undo .
    11968             v-str2 = v-diff .
    11969             newstr = "" .
    11970             repeat i = 1 to num-entries (v-str2) :
    11971               l = lookup ( entry (i,v-str2) , "base-rate,base-scale,buyer-out-code,cli-code,cli-out-doc,cli-point-code,cli-point-db-num,cli-type,cons-code,contract-code,cycle-day,date-pay,deliv-subj-code,deliv-type-code,doc-type,exch-code,exch-rate,exch-scale,fact-date,fact-order,fact-time,flag_,host-code,obj-code,obj-point-code,obj-point-db-num,obj-type,ord-date1,ord-date2,ord-date3,ord-dec1,ord-dec2,ord-dec3,ord-int1,ord-int2,ord-int3,order-type,pay-code,pay-day,shift-date,shift-name,shift-num,ship-date,ship-time,slt-type,vat-type,status_,sum-service,sum-ship,transport-cli-code,transport-cli-type,transport-condition,transport-contract,transport-host-code,transport-value,transport-VAT" )  .
    11972               newstr  = newstr + entry ( l , "Баз.валюта_м.б.,Баз.валюта_шкала,Номер по поставщику,Код Поставщика,Номер по Поставщику,Пункты доставки,Пункты доставки,Тип Поставщика,Код,Договор,Цикл,Дата платежа,Код доставки,Код доставки,Тип заказа,Валюта,Курс валюты поставщика,М.б. валюты поставщика,факт дата,факт номер,факт врем,флаг,фирма,Объект код,Доставка код,Доставка БД,Объект тип,ord-date1,ord-date2,ord-date3,ord-dec1,ord-dec2,ord-dec3,Статус Edoc-NN\EDI,ord-int2,ord-int3,тип заказа,код платежа,дней продаж,сменная дата,смена,смена №,Дата доставки (Заказ на),Время доставки,Тип НсП,Тип НДС,Статус,Сумма обслуживани,Сумма доставки,Транспортный договор (Контрагент код),Транспортный договор (Контрагент тип),Транспортный договор (условия),Транспортный договор (№ договора),Транспортный договор (код фирмы),Транспортный договор,Транспортный договор (НДС)" )  + ", " .
    11973             end.
    11974             newstr = trim(trim(newstr),"," ).
    11975             v-err-clip = true .
    11976             v-longchar = v-longchar +
    11977             substitute ( "Нельзя объединить заказ &1 c &2 , есть несовпадения (&3)&4" ,buf_ord-doc.doc-code,tempclip-orddoc.doc-code, newstr,chr(10) ) .
    11978       end.
    11979       else do:
    11980           buffer-compare tempclip-orddoc USING
    11981             contract-code
    11982           to buf_ord-doc save result in v-diff-contract .
    11983             if v-diff-contract <> "" then do:
    11984               v-diff-contract = "".
    11985             end.
    11986             else do:
    11987                 v-diff-contract = string (buf_ord-doc.contract-code) .
    11988             end.
    11989       end.
    11990       v-str = v-str + buf_ord-doc.doc-code + ", ".
    11991             for each  bb_ord-line no-lock where
    11992                    bb_ord-line.doc-code = tempclip-orddoc.doc-code :
    11993              find first bb2_ord-line no-lock where
    11994                         bb2_ord-line.doc-code = buf_ord-doc.doc-code and
    11995                         bb2_ord-line.gds-code = bb_ord-line.gds-code and
    11996                         bb2_ord-line.cli-art <> bb_ord-line.cli-art
    11997                         no-error .
    11998               if available bb2_ord-line then do:
    11999                   find first bb_goods no-lock where
    12000                              bb_goods.gds-code = bb2_ord-line.gds-code no-error .
    12001                   v-err-clip = true .
    12002                   v-longchar = v-longchar +
    12003                   substitute ( "Нельзя объединить заказ &1 c &2 , есть несовпадения по артикулу поставщика Товар &3 &4&5 &6 &7" ,buf_ord-doc.doc-code,tempclip-orddoc.doc-code,bb_ord-line.artic,bb_ord-line.prod-type,bb_ord-line.prod-code ,bb_goods.gds-name,chr(10)) .
    12004               end.
    12005              find first bb2_ord-line no-lock where
    12006                         bb2_ord-line.doc-code = buf_ord-doc.doc-code and
    12007                         bb2_ord-line.gds-code = bb_ord-line.gds-code and
    12008                         bb2_ord-line.price-cli <>  bb_ord-line.price-cli
    12009                         no-error .
    12010               if available bb2_ord-line then do:
    12011                   find first bb_goods no-lock where
    12012                              bb_goods.gds-code = bb2_ord-line.gds-code no-error .
    12013                   v-err-clip = true .
    12014                   v-longchar = v-longchar +
    12015                   substitute ( "Нельзя объединить заказ &1 c &2 , есть несовпадения по цене поставщика Товар &3 &4&5 &6 (&8 и &9)&7" ,buf_ord-doc.doc-code,tempclip-orddoc.doc-code,bb_ord-line.artic,bb_ord-line.prod-type,bb_ord-line.prod-code ,bb_goods.gds-name,chr(10), bb2_ord-line.price-cli , bb_ord-line.price-cli) .
    12016               end.
    12017           end.
    12018     end.
    12019     if v-err-clip = true   then do:
    12020         run gbl/d-longchar.w (
    12021                 ?,
    12022                 'Editor_row=2\':u
    12023               + 'title=Ошибки объединения заказов\':u
    12024               + 'Editor_col=1\':u
    12025               + 'Editor_width=96\':u
    12026               + 'Editor_height=21\':u
    12027               + 'readonly=yes\':u
    12028             ,input-output v-longchar
    12029             ,output v-ok ) no-error .
    12030             if error-status :error then message
    12031               vss-workfile vss-revision vss-description skip
    12032               error-status :get-message(1) skip
    12033               return-value skip
    12034               "4"
    12035               view-as alert-box error
    12036             .
    12037             assign
    12038             v-longchar = '':U.
    12039       return error "Заказ не может быть закрыт ! Исправьте внешние артикулы Поставщика" .
    12040     end.
    12041     v-str = trim(trim(v-str),"," ).
    12042     message "Объединять заказы " v-str
    12043             "в один ? "
    12044             view-as alert-box question
    12045             buttons yes-no
    12046             update v-okk as logical
    12047           .
    12048     if v-okk = false then return .
    12049   define variable v-i-doc as character no-undo .
    12050   define variable vss-include-info108 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12051   run proc-ord-code in this-procedure
    12052    (input   'main' ,
    12053     input   v-cntxt-db-num ,
    12054     input   v-cntxt-obj-type ,
    12055     input   v-cntxt-obj-code ,
    12056     input   v-i-doc ,
    12057     output  loc-ord-num
    12058    ) .
    12059     define variable v-ln as integer   no-undo .
    12060     v-ln = 0.
    12061     do v-i = 1 to v-nn :
    12062       find first buf_ord-doc exclusive-lock where
    12063            recid(buf_ord-doc) = integer ( entry (v-i, del-list))  no-error .
    12064            if not available buf_ord-doc then next.
    12065            run save-orddoc ( buffer buf_ord-doc , input loc-ord-num) .
    12066             for each buf_ord-line exclusive-lock where
    12067                      buf_ord-line.doc-code =  buf_ord-doc.doc-code by  buf_ord-line.line-num :
    12068                      run save-ordline
    12069                          ( input loc-ord-num ,
    12070                            input buf_ord-line.doc-code,
    12071                            input buf_ord-line.gds-code,
    12072                            input buf_ord-line.cli-qnty,
    12073                            input buf_ord-doc.order-type
    12074                            ) no-error  .
    12075                      if error-status :error then message
    12076                        vss-workfile vss-revision vss-description skip
    12077                        error-status :get-message(1) skip
    12078                        return-value skip
    12079                        "save-ordline"
    12080                        view-as alert-box error
    12081                      .
    12082                     find first new_ord-line exclusive-lock where
    12083                                new_ord-line.doc-code =  loc-ord-num and
    12084                                new_ord-line.gds-code =  buf_ord-line.gds-code no-error .
    12085                     if available new_ord-line then do:
    12086                         new_ord-line.qnty     =  new_ord-line.qnty     + buf_ord-line.qnty .
    12087                         new_ord-line.cli-qnty =  new_ord-line.cli-qnty + buf_ord-line.cli-qnty.
    12088                         new_ord-line.sum-rubl =  new_ord-line.sum-rubl + buf_ord-line.sum-rubl.
    12089                         new_ord-line.sum-base =  new_ord-line.sum-base + buf_ord-line.sum-base.
    12090                         new_ord-line.sum-cli  =  new_ord-line.sum-cli  + buf_ord-line.sum-cli.
    12091                         new_ord-line.sum-vat  =  new_ord-line.sum-vat  + buf_ord-line.sum-vat.
    12092                     end.
    12093                     else do:
    12094                        v-ln = v-ln + 1.
    12095                        assign
    12096                         buf_ord-line.doc-code = loc-ord-num
    12097                         buf_ord-line.line-num = v-ln
    12098                         .
    12099                     end.
    12100               end.
    12101     delete buf_ord-doc.
    12102     end.
    12103     create new_ord-doc.
    12104     buffer-copy tempclip-orddoc to new_ord-doc
    12105       assign
    12106         new_ord-doc.doc-code     = loc-ord-num
    12107         new_ord-doc.doc-date     = to-day
    12108         new_ord-doc.contract-code = integer(v-diff-contract)
    12109       .
    12110       p-recid = recid ( new_ord-doc ) .
    12111       del-list = "" .
    12112   end.
    12113   end procedure.
    12114   procedure save-orddoc :
    12115   define parameter buffer  buf_ord-doc for ub.ord-doc.
    12116   define input  parameter p-new-ord-num as character no-undo .
    12117   define variable v-new-code as character no-undo .
    12118     do
    12119     on error undo, return error return-value
    12120     :
    12121     if buf_ord-doc.order-type = 0 then return .
    12122     assign
    12123       tempclip-orddoc.order-type    = 4
    12124       tempclip-orddoc.contract-code = 0
    12125       tempclip-orddoc.cycle-day     = 0
    12126     .
    12127     v-new-code = p-new-ord-num + chr(4) + buf_ord-doc.doc-code .
    12128     run orddocattr-write (
    12129          input v-new-code
    12130         ,input 'cycle-doc-code':U
    12131         ,input buf_ord-doc.doc-code) no-error .
