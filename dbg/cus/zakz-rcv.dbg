     8121    x-mode =  list-mode.
     8122   MAIN-BLOCK:
     8123   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     8124      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     8125      ON STOP    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     8126   find sch-cli where recid (sch-cli) = p-doc-rec no-lock no-error.
     8127   find sch-cons where recid (sch-cons) = p-doc-rec no-lock no-error.
     8128   find sch-contract where recid (sch-contract) = p-doc-rec no-lock no-error.
     8129   doc-rec = ?.
     8130   define variable v-ok as logical   no-undo .
     8131   define variable v-mail as logical no-undo.
     8132   v-mail = b-email:load-image ("cmp/www.bmp").
     8133   v-ok = b-cons:load-IMAGE ("cmp/group.bmp") .
     8134   ENABLE b-quit  b-print b-sch b-history b-help br-docs  sch-code sch-date sch-fact ed-notes  b-rep  b-exec b-cons b-email
     8135    b-print-rcv
     8136    br-rcv
     8137   WITH FRAME d-all-docs.
     8138    hide b-open in frame d-all-docs .
     8139   if is-edoc-nn = false and is-edi = false then  do:
     8140      str-status-edoc-nn:VISIBLE IN BROWSE br-docs = FALSE.
     8141   end.
     8142   if g#type = 'ФП':U or  g#type = 'ОФ':U then
     8143       assign
     8144         str-status-edoc-nn:VISIBLE IN BROWSE br-docs = FALSE
     8145       .
     8146   if lookup (x-mode,"firm-fin,firm-fintypestatus,without-fotypestatus,without-fo,with-fotypestatus,with-fo") > 0 then
     8147   br-docs:MOVE-COLUMN ( 15, 8 ) IN FRAME d-all-docs .
     8148   run diasize_add_browse in this-procedure
     8149       (input  'width':u
     8150       ,input  browse br-rcv :handle
     8151       ) .
     8152   run diasize_init in this-procedure .
     8153   run UI-on in this-procedure (yes, no, '':U).
     8154   run mode-g#type in this-procedure.
     8155   apply "value-changed" to br-docs in frame d-all-docs   .
     8156   WAIT-FOR GO OF FRAME d-all-docs focus br-docs.
     8157   END.
     8158   run disable_UI in this-procedure .
     8159   PROCEDURE disable_UI :
     8160     HIDE FRAME d-all-docs.
     8161   END PROCEDURE.
     8162   PROCEDURE UI-on :
     8163   define input  parameter   p-open-query     as logical   no-undo init true .
     8164   define input  parameter   p-find-next      as logical   no-undo init false .
     8165   define input  parameter   p-find-condition as character no-undo .
     8166     if p-open-query then frame d-all-docs:title = "ВСЕ  ДОКУМЕНТЫ".
     8167     sch-num = 0.
     8168     hide sch-num in frame d-all-docs.
     8169   define variable v-l-mode as character no-undo .
     8170   v-l-mode = list-mode .
     8171   x-mode  = list-mode.
     8172   if g#type <> "all" and g#type <> ? then x-mode  = list-mode + "type" .
     8173   if g#stat <> "all" and g#stat <> ? then x-mode  = list-mode + "type" + "status".
     8174   Disable b-payment  WITH FRAME d-all-docs.
     8175   define variable l-query-was-opened as logical no-undo .
     8176   define variable title0 as character no-undo.
     8177   filter-point = filter-point0 + v-l-mode.
     8178   define variable sort-column-phrase as character no-undo .
     8179   case sort-column-name :
     8180     when "" then do:
     8181       assign
     8182         sort-column-phrase = ""
     8183       .
     8184     end.
     8185     otherwise do:
     8186       assign
     8187         sort-column-phrase = "by " + sort-column-name
     8188       .
     8189     end.
     8190   end case.
     8191   define variable l-open-query as logical   no-undo .
     8192   if Lookup("nob-exec",p-buttons) <> 0 then disable b-exec WITH FRAME d-all-docs. else enable b-exec  WITH FRAME d-all-docs.
     8193   if Lookup("nob-copy",p-buttons) <> 0 then disable b-copy WITH FRAME d-all-docs. else enable b-copy  WITH FRAME d-all-docs.
     8194   enable b-mark WITH FRAME d-all-docs.
     8195   if Lookup("b-sel",p-buttons) <> 0 then enable  b-sel WITH FRAME d-all-docs.  else disable b-sel   WITH FRAME d-all-docs.
     8196   if Lookup("b-del",p-buttons) <> 0 then
     8197      enable  b-del   b-del-2 WITH FRAME d-all-docs.
     8198      else disable b-del b-del-2  WITH FRAME d-all-docs.
     8199   if Lookup("b-lkp",p-buttons) <> 0 then
     8200      enable b-lkp  b-lkp-2 WITH FRAME d-all-docs.
     8201      else  disable b-lkp b-lkp-2 WITH FRAME d-all-docs.
     8202   if Lookup("b-chg",p-buttons) <> 0 then
     8203      enable b-chg  b-chg-2 WITH FRAME d-all-docs.
     8204      else  disable b-chg b-chg-2 WITH FRAME d-all-docs.
     8205   if Lookup("b-add",p-buttons) <> 0 then
     8206      enable b-add  b-add-2 WITH FRAME d-all-docs.
     8207      else  disable b-add b-add-2 WITH FRAME d-all-docs.
     8208   if Lookup("b-close",p-buttons) <> 0 then
     8209      enable b-close b-close-2 WITH FRAME d-all-docs.
     8210      else  disable b-close b-close-2 WITH FRAME d-all-docs.
     8211   if Lookup("fin-block",p-buttons) <> 0 then
     8212      disable b-close b-payment  b-copy
     8213              b-add-2
     8214              b-chg-2
     8215              b-close-2
     8216              b-del-2
     8217              b-add-obj-2
     8218              WITH FRAME d-all-docs.
     8219   if g#type = ?  then  do:
     8220     disable b-add with frame d-all-docs .
     8221   end.
     8222   if g#type = 'ОФ':U and v-cntxt-db-num = 0  then  do:
     8223     disable  b-copy   with frame d-all-docs .
     8224   end.
     8225   if g#type = 'ОП':U and v-cntxt-db-num = 0  then  do:
     8226     disable b-copy with frame d-all-docs .
     8227   end.
     8228   CASE x-mode :
     8229     when "firm":U then do:
     8230         if p-open-query then frame d-all-docs:title = " Фирма : " + g#host-name.
     8231         Disable b-add b-chg b-del b-close   b-close b-copy b-sost  WITH FRAME d-all-docs.
     8232         Enable b-lkp
     8233         WITH FRAME d-all-docs.
     8234         if v-cntxt-level <>  'object':U then do:
     8235           Disable b-payment   WITH FRAME d-all-docs.
     8236           disable b-add-2
     8237                 b-chg-2
     8238                 b-del-2
     8239                 b-close-2
     8240                 with frame d-all-docs .
     8241         end.
     8242   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8243   define variable  l-disable-where-79  as logical   no-undo .
     8244   define variable  l-filter-open-79    as logical   .
     8245   define variable  flt-rec-79       as recid     no-undo .
     8246   define variable  filter-name-79      as character no-undo .
     8247   define variable  where-phrase-79     as character no-undo .
     8248   define variable  sort-phrase-79      as character no-undo .
     8249   define variable  where-phrase-rus-79 as character no-undo .
     8250   define variable  sort-phrase-rus-79  as character no-undo .
     8251     run waitfram-show in this-procedure
     8252       (input "ЖДИТЕ ..."
     8253       ).
     8254   run gbl/flt-get.p
     8255     (input filter-point
     8256     ,output flt-rec-79
     8257     ,output filter-name-79
     8258     ,output where-phrase-79
     8259     ,output sort-phrase-79
     8260     ,output where-phrase-rus-79
     8261     ,output sort-phrase-rus-79
     8262     ).
     8263   if p-open-query then do:
     8264       run set-filter-name in this-procedure
     8265         (INPUT filter-name-79
     8266         ) no-error .
     8267     assign
     8268       l-filter-open-79 = false
     8269     .
     8270     if flt-rec-79 <> ?
     8271       or sort-column-phrase > ""
     8272     then do:
     8273       define variable  parameter-2-79 as character no-undo .
     8274       define variable  parameter-3-79 as character no-undo .
     8275       define variable  parameter-4-79 as character no-undo .
     8276       define variable  parameter-5-79 as character no-undo .
     8277       define variable  parameter-6-79 as character no-undo .
     8278       define variable  parameter-7-79 as character no-undo .
     8279         assign
     8280         parameter-3-79 =
     8281                                 "FOR EACH shar-buf_ord-doc"
     8282         parameter-4-79 =
     8283           (
     8284             if (" shar-buf_ord-doc.host-code = g#host-code " + " " + where-phrase-79) <> ""
     8285             then  substitute(' shar-buf_ord-doc.host-code =  &1 ' , g#host-code )  + " " + where-phrase-79
     8286             else "true"
     8287           )
     8288         parameter-5-79 = (" " + "" + " " + "")
     8289         parameter-6-79 = if sort-phrase-79 = ''
     8290                              then
     8291           (
     8292           " " + " USE-INDEX ByFirm " +
     8293             " " + sort-column-phrase +
     8294           " " + " "
     8295           )
     8296                              else
     8297           (
     8298           " " + " USE-INDEX ByFirm " +
     8299             " " + sort-column-phrase +
     8300           " " + sort-phrase-79
     8301           )
     8302         parameter-7-79 =
     8303           " indexed-reposition  "
