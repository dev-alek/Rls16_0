     5836       if available cli-buf then boss-name = cli-buf.obj-name. else boss-name = ?.
     5837       find cli-buf where cli-buf.obj-type = 'чел':U and cli-buf.obj-code = shar-buf_ord-doc.agnt no-lock no-error.
