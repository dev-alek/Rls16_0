     6524     index xie browse-type browse-handle
     6525   .
     6526   procedure diasize_change-height :
     6527     define input  parameter p-change-value  as decimal   no-undo .
     6528     define input  parameter p-move-resize   as logical   no-undo .
     6529     define variable v-field-group-handle    as handle    no-undo .
     6530     define variable v-object-handle         as handle    no-undo .
     6531     define variable v-frame-height          as decimal   no-undo .
     6532     define variable v-frame-virtual-height  as decimal   no-undo .
     6533     define variable v-browse-height         as decimal   no-undo .
     6534     define variable v-window-height         as decimal   no-undo .
     6535     define variable v-window-virtual-height as decimal   no-undo .
     6536     define variable v-change-sign           as integer   no-undo .
     6537     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6538     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6539     if p-change-value > 0
     6540     then do:
