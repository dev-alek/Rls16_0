     6207                         input 'Контрагент':U ,
     6208                         input recid(clients),
     6209                         input ?,
     6210                         input "",
     6211                         input "",
     6212                         input "",
     6213                         output ri-list) no-error.
     6214         end.
     6215       end case.
     6216       assign
     6217       payment-type = "".
     6218       .
