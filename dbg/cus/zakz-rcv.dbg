     3830   procedure ordlineattr-code :
     3831     do on error undo, return error return-value
     3832     :
     3833       define input  parameter p-code           as character no-undo .
     3834       define output parameter p-type           as character no-undo .
     3835       define output parameter p-format         as character no-undo .
     3836       define output parameter p-fillin_width   as integer   no-undo .
     3837       define output parameter p-fillin_height  as integer   no-undo .
     3838       define output parameter p-label          as character no-undo .
     3839       define output parameter p-user-can-edit  as logical   no-undo .
     3840       define output parameter p-output-display as logical   no-undo .
     3841       define output parameter p-proc           as character no-undo .
     3842       define output parameter p-func           as character no-undo .
     3843       define output parameter p-sort           as integer   no-undo .
     3844       define output parameter p-other          as character no-undo .
     3845       case p-code :
     3846               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3847               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3848         otherwise do:
     3849           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     3850         end.
     3851       end.
     3852     end.
     3853   end procedure.
     3854   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3855   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3856   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3857   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3858   define variable par-type          as character no-undo.
     3859   define variable v-value-character as character no-undo .
     3860   define variable v-value-date      as date      no-undo .
     3861   define variable v-value-decimal   as decimal   no-undo .
     3862   define variable v-value-integer   as integer   no-undo .
     3863   define variable v-value-logical   as logical   no-undo .
     3864   procedure ver-qnty-rcv-from-ord :
     3865   define input  parameter p-ord-doc as character no-undo .
     3866   define output parameter p-is-lim as logical    no-undo .
     3867   define buffer buf_ord-doc     for ub.ord-doc      .
     3868   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
     3869   define variable v-kol as integer   no-undo .
     3870   define variable v-ver as logical   no-undo .
     3871     do
     3872     on error undo, return error return-value
     3873     :
     3874      p-is-lim = false .
     3875     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = p-ord-doc no-error .
     3876     if buf_ord-doc.doc-type <> 'ОП':U then return .
     3877   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3878   empty temp-table thbjattr_thbj-attr.
     3879   run adm/shattri.p (
     3880      input "get":U
     3881     ,input buf_ord-doc.obj-type
     3882     ,input buf_ord-doc.obj-code
     3883     ,input 'ord-obj':U
     3884     ,input  ""
     3885     ,output v-value-character
     3886     ,output v-value-date
     3887     ,output v-value-decimal
     3888     ,output v-value-integer
     3889     ,output v-value-logical
     3890     ,output par-type
     3891     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3892     ) no-error .
     3893     for each thbjattr_thbj-attr :
     3894         if thbjattr_thbj-attr.prop-code = 'ord-11':U then v-ver = thbjattr_thbj-attr.property-value-logical .
     3895     end.
     3896   v-kol = 0.
     3897     if v-ver then do:
     3898        for each buf_ord-doc-rcv no-lock where
     3899                 buf_ord-doc-rcv.doc-code = p-ord-doc :
     3900          v-kol = v-kol + 1.
     3901          leave.
     3902        end.
     3903      if v-kol > 0 then p-is-lim = true .
     3904     end.
     3905   end.
     3906   end procedure.
     3907   procedure ver-qnty-trn-from-rcv :
     3908   define input  parameter p-rcv-code as character no-undo .
     3909   define output parameter p-is-lim as logical   no-undo .
     3910   define buffer buf_ord-doc for ub.ord-doc  .
     3911   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
     3912   define buffer buf_ord-chain for ub.ord-chain .
     3913   define buffer buf_trn-doc for ub.trn-doc  .
     3914   define variable v-kol as integer   no-undo .
     3915   define variable v-ver as logical   no-undo .
     3916     do
     3917     on error undo, return error return-value
     3918     :
     3919      p-is-lim = false .
     3920     find first buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.rcv-code = p-rcv-code no-error .
     3921     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code no-error .
     3922     if buf_ord-doc.doc-type <> 'ОП':U then return .
     3923   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3924   empty temp-table thbjattr_thbj-attr.
     3925   run adm/shattri.p (
     3926      input "get":U
     3927     ,input buf_ord-doc.obj-type
     3928     ,input buf_ord-doc.obj-code
     3929     ,input 'ord-obj':U
     3930     ,input  ""
     3931     ,output v-value-character
     3932     ,output v-value-date
     3933     ,output v-value-decimal
     3934     ,output v-value-integer
     3935     ,output v-value-logical
     3936     ,output par-type
     3937     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3938     ) no-error .
     3939     for each thbjattr_thbj-attr :
     3940         if thbjattr_thbj-attr.prop-code = 'ord-11':U then v-ver = thbjattr_thbj-attr.property-value-logical .
     3941     end.
     3942       if v-ver then do:
     3943       v-kol = 0.
     3944           for each buf_ord-chain no-lock where
     3945                   buf_ord-chain.doc-code = p-rcv-code and
     3946                   buf_ord-chain.doc-type = 'rcv' and
     3947                   buf_ord-chain.rel-doc-type = 'trn' ,
     3948               first buf_trn-doc NO-LOCK where
     3949                     buf_trn-doc.doc-code = buf_ord-chain.rel-doc-code
     3950                     :
     3951               v-kol = v-kol + 1.
     3952               leave.
     3953           end.
     3954           if v-kol > 0 then p-is-lim = true .
     3955       end.
     3956     end.
     3957   end procedure.
     3958   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3959   FUNCTION isoraret_on returns logical :
     3960   define buffer buf_ext-system for ub.ext-system.
     3961   define buffer buf_db for ub.db  .
     3962   find first buf_db no-lock where buf_db.db-num > 0 no-error .
     3963   if available buf_db then  do:
     3964      return no.
     3965   end.
     3966   find first buf_ext-system no-lock no-error .
     3967   if available buf_ext-system
     3968   and buf_ext-system.esys-type = integer('3':U)
     3969   and buf_ext-system.delivery-method = integer('3':U) then return yes.
     3970   return no.
     3971   end function.
     3972   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3973   procedure ver-clients-calc :
     3974   define input  parameter p-cli-type as character no-undo .
     3975   define input  parameter p-cli-code as integer   no-undo .
