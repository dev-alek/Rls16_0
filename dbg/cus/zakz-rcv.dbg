     3553         ,output v-fillin_height
     3554         ,output v-label
     3555         ,output v-user-can-edit
     3556         ,output v-output-display
     3557         ,output v-proc
     3558         ,output v-func
     3559         ,output v-sort
     3560         ,output v-other
     3561         ) no-error .
     3562       if error-status :error then do:
     3563         undo, return error return-value .
     3564       end.
     3565       find first buf_ord-doc-attr exclusive-lock
     3566         where buf_ord-doc-attr.doc-code  = p-doc-code
     3567           and buf_ord-doc-attr.attr-code = p-code
     3568         no-error NO-WAIT.
     3569       if not available buf_ord-doc-attr then do:
     3570         p-deleted = no.
     3571       end.
     3572       else do:
     3573         delete buf_ord-doc-attr.
     3574         p-deleted = yes.
     3575       end.
     3576     end.
     3577   end procedure.
     3578   procedure orddocattr-code :
     3579     do on error undo, return error return-value
     3580     :
     3581       define input  parameter p-code           as character no-undo .
     3582       define output parameter p-type           as character no-undo .
     3583       define output parameter p-format         as character no-undo .
     3584       define output parameter p-fillin_width   as integer   no-undo .
     3585       define output parameter p-fillin_height  as integer   no-undo .
     3586       define output parameter p-label          as character no-undo .
     3587       define output parameter p-user-can-edit  as logical   no-undo .
     3588       define output parameter p-output-display as logical   no-undo .
     3589       define output parameter p-proc           as character no-undo .
     3590       define output parameter p-func           as character no-undo .
     3591       define output parameter p-sort           as integer   no-undo .
     3592       define output parameter p-other          as character no-undo .
     3593       case p-code :
     3594               when 'cycle-doc-code':U then do:     assign     p-label          = "Номер заказа цикличного"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Номер заказа цикличного"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3595               when 'cycle-day':U then do:     assign     p-label          = "период цикличности"     p-type           = 'I':U      p-format         = ">>>>>>9"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период цикличности"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3596               when 'cycle-done':U then do:     assign     p-label          = "Заказ рассчитан"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Заказ рассчитан"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3597               when 'exch-code':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3598               when 'exch-rate':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3599               when 'exch-scale':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3600               when 'base-rate':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3601               when 'base-scale':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3602               when 'cycle-contract-code':U then do:     assign     p-label          = "договор"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "договор"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3603               when 'cycle-ship-date':U then do:     assign     p-label          = "дата доставки"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "дата доставки"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3604               when 'cycle-ship-time':U then do:     assign     p-label          = "время доставки"     p-type           = 'I':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "время доставки"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3605               when 'cycle-date1':U then do:     assign     p-label          = "период продаж"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период продаж"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3606               when 'cycle-date2':U then do:     assign     p-label          = "период продаж"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период продаж"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3607               when 'cycle-doc-date':U then do:     assign     p-label          = "дата заказа"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "дата заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3608               when 'ora-exp-seq-num':U then do:     assign     p-label          = "Номер выгрузки в Oracle Retail"     p-type           = 'I':U      p-format         = "999999999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Номер выгрузки в Oracle Retail"     p-user-can-edit  = false     p-output-display = false     p-sort           = 100     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3609         otherwise do:
     3610           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     3611         end.
     3612       end.
     3613     end.
     3614   end procedure.
