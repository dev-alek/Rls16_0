     7153           no-error .
     7154         if error-status :error
     7155         or error-status :get-message(1) <> ""
     7156         then do:
     7157           undo move_block, retry move_block.
     7158         end.
     7159         assign
     7160           v-diasize-browse-handle :width = v-browse-width + p-change-value
     7161         no-error .
     7162         if error-status :error
     7163         or error-status :get-message(1) <> ""
     7164         then do:
     7165           undo move_block, retry move_block.
     7166         end.
     7167         for each buf_temp-browse-handle
     7168           where buf_temp-browse-handle.browse-type = 'width':u
     7169         on error undo move_block, retry move_block
     7170         :
     7171           assign
     7172             buf_temp-browse-handle.browse-handle :width
     7173               = buf_temp-browse-handle.browse-handle :width + p-change-value
     7174             no-error .
     7175           if error-status :error
     7176           or error-status :get-message(1) <> ""
     7177           then do:
     7178             undo move_block, retry move_block .
     7179           end.
     7180         end.
     7181         for each buf_temp-diasize-handle
     7182         on error undo move_block, retry move_block
     7183         :
     7184           assign
     7185             v-object-handle = buf_temp-diasize-handle.handle-value
     7186           .
     7187           if v-object-handle <> v-diasize-resize-button
     7188           then do:
     7189             assign
     7190               v-object-handle :col = v-object-handle :col + p-change-value
     7191               no-error .
     7192             if error-status :error
     7193             or error-status :get-message(1) <> ""
     7194             then do:
     7195               undo move_block, retry move_block .
     7196             end.
     7197           end.
     7198         end.
     7199       end.
     7200       else do:
     7201         for each buf_temp-diasize-handle
     7202         on error undo move_block, retry move_block
     7203         :
     7204           assign
     7205             v-object-handle = buf_temp-diasize-handle.handle-value
     7206           .
     7207           if v-object-handle <> v-diasize-resize-button
     7208           then do:
     7209             assign
     7210               v-object-handle :col = v-object-handle :col + p-change-value
     7211               no-error .
     7212             if error-status :error
     7213             or error-status :get-message(1) <> ""
     7214             then do:
     7215               undo move_block, retry move_block .
     7216             end.
     7217           end.
     7218         end.
     7219         for each buf_temp-browse-handle
     7220           where buf_temp-browse-handle.browse-type = 'width':u
     7221         on error undo move_block, retry move_block
     7222         :
     7223           assign
     7224             buf_temp-browse-handle.browse-handle :width
     7225               = buf_temp-browse-handle.browse-handle :width + p-change-value
     7226             no-error .
     7227           if error-status :error
     7228           or error-status :get-message(1) <> ""
     7229           then do:
     7230             undo move_block, retry move_block .
     7231           end.
     7232         end.
     7233         assign
     7234           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     7235           no-error .
     7236         if error-status :error
     7237         or error-status :get-message(1) <> ""
     7238         then do:
     7239           undo move_block, retry move_block.
     7240         end.
     7241         assign
     7242           frame d-all-docs :width = frame d-all-docs :width + p-change-value
     7243         no-error .
     7244         if error-status :error
     7245         or error-status :get-message(1) <> ""
     7246         then do:
     7247           undo move_block, retry move_block.
     7248         end.
     7249         if frame d-all-docs :scrollable = true
     7250         then do:
     7251           assign
     7252             frame d-all-docs :virtual-width = frame d-all-docs :virtual-width + p-change-value
     7253           no-error .
     7254           if error-status :error
     7255           or error-status :get-message(1) <> ""
     7256           then do:
     7257             undo move_block, retry move_block.
     7258           end.
     7259         end.
     7260       end.
     7261       if p-move-resize
     7262       then do:
     7263         run diasize_position-resize-button in this-procedure .
     7264       end.
     7265       if v-diasize-wndstore = true
     7266       then do:
     7267         if connected("ub") = true
     7268         then do:
     7269           define variable v-cntxt-db-num        as integer   no-undo .
     7270           define variable v-cntxt-userid        as character no-undo .
     7271           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7272                                             , OUTPUT v-cntxt-userid
     7273                                             ) .
     7274           run gbl/wndsizew.p
     7275             (input  v-cntxt-db-num
     7276             ,input  v-cntxt-userid
     7277             ,input  v-diasize-proc-name
     7278             ,input  'width':u
     7279             ,input  string(frame d-all-docs :width - v-diasize-orig-frame-width)
     7280             ) .
     7281         end.
     7282       end.
     7283     end.
     7284     assign
     7285       v-diasize-change-size = false
     7286     .
     7287   end procedure.
     7288   procedure diasize_set-width :
     7289     define input  parameter p-new-width  as decimal   no-undo .
     7290     define input  parameter p-move-resize as logical   no-undo .
     7291     do
     7292     on error undo, return error return-value
     7293     :
     7294       run diasize_change-width in this-procedure
     7295         (input  (p-new-width - frame d-all-docs :width)
     7296         ,input  p-move-resize
     7297         ) .
     7298     end.
     7299   end procedure.
     7300   procedure diasize_position-resize-button :
     7301     do with frame d-all-docs
     7302     :
     7303       hide v-diasize-resize-button .
     7304       assign
     7305         v-diasize-resize-button :row = frame d-all-docs :height - v-diasize-resize-button :height
     7306                     - 1
     7307                     - (frame d-all-docs :border-bottom-pixels / session :pixels-per-row)
     7308         v-diasize-resize-button :col = frame d-all-docs :width - v-diasize-resize-button :width
     7309                     - 1
     7310                     - (frame d-all-docs :border-right-pixels / session :pixels-per-column)
     7311       .
     7312       view v-diasize-resize-button .
     7313     end.
     7314   end procedure.
     7315   on alt-right anywhere
     7316   do:
     7317     run diasize_change-width in this-procedure
     7318       (input 1
     7319       ,input true
     7320       ) .
     7321     return no-apply .
     7322   end.
     7323   on alt-left anywhere
     7324   do:
     7325     run diasize_change-width in this-procedure
     7326       (input -1
     7327       ,input true
     7328       ) .
     7329     return no-apply .
     7330   end.
     7331   on alt-down anywhere
     7332   do:
     7333     run diasize_change-height in this-procedure
     7334       (input 1
     7335       ,input true
     7336       ) .
     7337     return no-apply .
     7338   end.
     7339   on alt-up anywhere
     7340   do:
     7341     run diasize_change-height in this-procedure
     7342       (input -1
     7343       ,input true
     7344       ) .
     7345     return no-apply .
     7346   end.
     7347   on alt-enter of frame d-all-docs
     7348   do:
     7349     run diasize_maximize in this-procedure
     7350       (input  ?
     7351       ).
     7352     return no-apply .
     7353   end.
     7354   procedure diasize_end-move :
     7355     do
     7356     on error undo, return error return-value
     7357     :
     7358       define variable v-row-delta as decimal   no-undo .
     7359       define variable v-col-delta as decimal   no-undo .
     7360       define variable v-new-row as decimal   no-undo .
     7361       define variable v-new-col as decimal   no-undo .
     7362       assign
     7363         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     7364         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     7365       .
     7366       assign
     7367         v-row-delta = v-new-row - frame d-all-docs :height
     7368         v-col-delta = v-new-col - frame d-all-docs :width
     7369       .
     7370       run diasize_change-height in this-procedure
     7371         (input v-row-delta
     7372         ,input true
     7373         ) .
     7374       run diasize_change-width in this-procedure
     7375         (input v-col-delta
     7376         ,input true
     7377         ) .
     7378     end.
     7379   end procedure.
     7380   procedure diasize_maximize :
     7381     define input  parameter p-action as logical   no-undo .
     7382     do
     7383     on error undo, return error return-value
     7384     :
     7385       if p-action = ?
     7386       then do:
     7387         if v-diasize-need-maximize = true
     7388         then do:
     7389           assign
     7390             p-action = true
     7391           .
     7392         end.
     7393         else do:
     7394           assign
     7395             p-action = false
     7396           .
     7397         end.
     7398       end.
     7399       if p-action = true
     7400       then do:
     7401         run diasize_change-height in this-procedure
     7402           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     7403               - frame d-all-docs :height-chars
     7404           ,input true
     7405           ) .
     7406         run diasize_change-width in this-procedure
     7407           (input session :width-chars
     7408               - frame d-all-docs :width-chars
     7409           ,input true
     7410           ) .
     7411         assign
     7412           v-diasize-need-maximize = false
     7413         .
     7414       end.
     7415       else do:
     7416         run diasize_change-width in this-procedure
     7417           (input v-diasize-orig-frame-width
     7418               - frame d-all-docs :width-chars
     7419           ,input true
     7420           ) .
     7421         run diasize_change-height in this-procedure
     7422           (input v-diasize-orig-frame-height
     7423               - frame d-all-docs :height-chars
     7424           ,input true
     7425           ) .
     7426         assign
     7427           v-diasize-need-maximize = true
     7428         .
     7429       end.
     7430     end.
     7431   end procedure.
     7432   procedure diasize_restore-orig-size :
     7433     do
     7434     on error undo, return error return-value
     7435     :
     7436       assign
     7437         v-diasize-current-frame-width  = frame d-all-docs :width
     7438         v-diasize-current-frame-height = frame d-all-docs :height
     7439       .
     7440       run diasize_set-height in this-procedure
     7441         (input  v-diasize-orig-frame-height
     7442         ,input  true
     7443         ) .
     7444       run diasize_set-width in this-procedure
     7445         (input  v-diasize-orig-frame-width
     7446         ,input  true
     7447         ) .
     7448     end.
     7449   end procedure.
     7450   procedure diasize_restore-current-size :
     7451     do
     7452     on error undo, return error return-value
     7453     :
     7454       run diasize_set-height in this-procedure
     7455         (input  v-diasize-current-frame-height
     7456         ,input  true
     7457         ) .
     7458       run diasize_set-width in this-procedure
     7459         (input  v-diasize-current-frame-width
     7460         ,input  true
     7461         ) .
     7462     end.
     7463   end procedure.
     7464   procedure diasize_set-browse-handle :
     7465     define input  parameter p-browse-handle as handle   no-undo .
     7466     define buffer buf_temp-browse-handle for temp-browse-handle .
     7467     do
     7468     on error undo, return error return-value
     7469     :
     7470       assign
     7471         v-diasize-browse-handle = p-browse-handle
     7472       .
     7473       for each buf_temp-browse-handle
     7474       on error undo, return error return-value
     7475       :
     7476         delete buf_temp-browse-handle .
     7477       end.
     7478     end.
     7479   end procedure.
     7480   procedure diasize_add_browse :
     7481     define input  parameter p-browse-type   as character no-undo .
     7482     define input  parameter p-browse-handle as handle    no-undo .
     7483     define buffer buf_temp-browse-handle for temp-browse-handle .
     7484     do
     7485     on error undo, return error return-value
     7486     :
     7487       assign
     7488         v-diasize-browse-number = v-diasize-browse-number + 1
     7489       .
     7490       create buf_temp-browse-handle .
     7491       assign
     7492         buf_temp-browse-handle.browse-type   = p-browse-type
     7493         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     7494         buf_temp-browse-handle.browse-handle = p-browse-handle
     7495       .
     7496     end.
     7497   end procedure.
     7498   procedure diasize_init :
     7499     define variable v-default-value    as logical   no-undo .
     7500     define variable v-restore-saved    as logical   no-undo .
     7501     define variable v-resize-value-str as character no-undo .
     7502     do
     7503     on error undo, return error return-value
     7504     :
     7505       do with frame d-all-docs
     7506       :
     7507         assign
     7508           v-diasize-orig-frame-height = frame d-all-docs :height
     7509           v-diasize-orig-frame-width  = frame d-all-docs :width
     7510           v-diasize-browse-handle     = browse BR-docs :handle
     7511         .
     7512         create button v-diasize-resize-button
     7513         assign
     7514           parent        = frame d-all-docs :first-child
     7515           label         = "s"
     7516           height-pixels = 16
     7517           width-pixels  = 16
     7518           visible       = true
     7519           sensitive     = true
     7520           movable       = true
     7521           triggers:
     7522             on end-move persistent run diasize_end-move in this-procedure .
     7523           end triggers.
     7524         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     7525         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     7526         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     7527         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     7528         assign
     7529           v-diasize-wndmax = false
     7530         .
     7531         if connected("ub") = true
     7532         then do:
     7533           define variable v-cntxt-db-num        as integer   no-undo .
     7534           define variable v-cntxt-userid        as character no-undo .
     7535           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7536                                             , OUTPUT v-cntxt-userid
     7537                                             ) .
     7538           run gbl/wndpar_r.p
     7539             (input  v-cntxt-db-num
     7540             ,input  v-cntxt-userid
     7541             ,input  'wndmax':U
     7542             ,output v-diasize-wndmax
     7543             ,output v-default-value
     7544             ) .
     7545         end.
     7546         assign
     7547           v-diasize-wndstore = false
     7548         .
     7549         if connected("ub") = true
     7550         then do:
     7551           run gbl/wndpar_r.p
     7552             (input  v-cntxt-db-num
     7553             ,input  v-cntxt-userid
     7554             ,input  'wndstore':U
     7555             ,output v-diasize-wndstore
     7556             ,output v-default-value
     7557             ) .
     7558         end.
     7559         assign
     7560           v-diasize-proc-name = entry(1, program-name(2), '.')
     7561         .
     7562         if v-diasize-wndstore = true
     7563         then do:
     7564           assign
     7565             v-restore-saved = false
     7566           .
     7567           if connected("ub") = true
     7568           then do:
     7569             run gbl/wndsizer.p
     7570               (input  v-cntxt-db-num
     7571               ,input  v-cntxt-userid
     7572               ,input  v-diasize-proc-name
     7573               ,input  'height':u
     7574               ,output v-resize-value-str
     7575               ) .
     7576             if v-resize-value-str <> '':U
     7577             then do:
     7578               run diasize_change-height in this-procedure
     7579                 (input  integer(v-resize-value-str)
     7580                 ,input  true
     7581                 ) .
     7582               assign
     7583                 v-restore-saved = true
     7584               .
     7585             end.
     7586           end.
     7587           if connected("ub") = true
     7588           then do:
     7589             run gbl/wndsizer.p
     7590               (input  v-cntxt-db-num
     7591               ,input  v-cntxt-userid
     7592               ,input  v-diasize-proc-name
     7593               ,input  'width':u
     7594               ,output v-resize-value-str
     7595               ) .
     7596             if v-resize-value-str <> '':U
     7597             then do:
     7598               run diasize_change-width in this-procedure
     7599                 (input  integer(v-resize-value-str)
     7600                 ,input  true
     7601                 ) .
     7602               assign
     7603                 v-restore-saved = true
     7604               .
     7605             end.
     7606           end.
     7607           if v-restore-saved <> true
     7608           then do:
     7609             if v-diasize-wndmax = true
     7610             then do:
     7611               run diasize_maximize in this-procedure
     7612                 (input  true
     7613                 ) .
     7614             end.
     7615           end.
     7616         end.
     7617         else do:
     7618           if v-diasize-wndmax = true
     7619           then do:
     7620             run diasize_maximize in this-procedure
     7621               (input  true
     7622               ) .
     7623           end.
     7624         end.
     7625       end.
     7626     end.
     7627   end procedure.
     7628   procedure diasize_need-full-display :
     7629     define output parameter p-need-full-display as logical   no-undo .
     7630     do
     7631     on error undo, return error return-value
     7632     :
     7633       assign
     7634         p-need-full-display = v-diasize-need-full-display
     7635       .
     7636       assign
     7637         v-diasize-need-full-display = false
     7638       .
     7639     end.
     7640   end procedure.
     7641   procedure get-context :
     7642      define output parameter p-db-num as integer          no-undo.
     7643      define output parameter p-user-id as character        no-undo.
     7644      define variable v-login               as character    no-undo.
     7645      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     7646      define buffer buf_user-login  for ub.user-login .
     7647      do
     7648      on error undo, return error
     7649      :
     7650            FIND FIRST buf_sys-ctrl no-lock.
     7651            ASSIGN
     7652               v-login = USERID("ub")
     7653               p-db-num = buf_sys-ctrl.db-num
     7654            .
     7655            FIND FIRST buf_user-login
     7656                 WHERE buf_user-login.db-num = p-db-num
     7657                   AND buf_user-login.user-login = v-login
     7658                 no-lock
     7659                 no-error
     7660                 .
     7661            IF AVAILABLE buf_user-login
     7662            THEN DO:
     7663               assign
     7664                  p-user-id = buf_user-login.user-id
     7665               .
     7666            END.
     7667      end.
     7668   end procedure.
     7669   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7670   on f5 of frame d-all-docs anywhere
     7671   do:
     7672     run UI-on (yes, no, '':U) .
     7673       apply "VALUE-CHANGED" to br-docs.
     7674   end.
     7675   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7676   on ' ' of sch-date in frame d-all-docs
     7677   do:
     7678     if (can-query (self, "sensitive")
     7679        and
     7680        self :sensitive = true
     7681        )
     7682     or (can-query (self, "read-only")
     7683        and
     7684        self :read-only = false
     7685        )
     7686     then do:
     7687       assign
     7688         self :screen-value = ?
     7689       .
     7690     end.
     7691     return no-apply.
     7692   end.
     7693   on delete-character of sch-date in frame d-all-docs
     7694   do:
     7695     if (can-query (self, "sensitive")
     7696        and
     7697        self :sensitive = true
     7698        )
     7699     or (can-query (self, "read-only")
     7700        and
     7701        self :read-only = false
     7702        )
     7703     then do:
     7704       assign
     7705         self :screen-value = ?
     7706       .
     7707     end.
     7708     return no-apply.
     7709   end.
     7710   on ctrl-d of sch-date in frame d-all-docs
     7711   do:
     7712     define variable v-curr-sv-date as date no-undo .
     7713     if (can-query (self, "sensitive")
     7714        and
     7715        self :sensitive = true
     7716        )
     7717     or (can-query (self, "read-only")
     7718        and
     7719        self :read-only = false
     7720        )
     7721     then do:
     7722       if self :handle <> focus :handle
     7723       then do:
     7724         apply "entry":u to self .
     7725       end.
     7726       run gbl/getcurdt.p
     7727         (output v-curr-sv-date
     7728         ) .
     7729       assign
     7730         self :screen-value = string(v-curr-sv-date) .
     7731       .
     7732     end.
     7733     return no-apply.
     7734   end.
     7735   on ctrl-b of sch-date in frame d-all-docs
     7736   do:
     7737     if (can-query (self, "sensitive")
     7738        and
     7739        self :sensitive = true
     7740        )
     7741     or (can-query (self, "read-only")
     7742        and
     7743        self :read-only = false
     7744        )
     7745     then do:
     7746       if self :handle <> focus :handle
     7747       then do:
     7748         apply "entry":u to self .
     7749       end.
     7750       define variable v-curr-sv-date as date no-undo .
     7751       define variable v-new-sv-date  as date no-undo .
     7752       assign
     7753         v-curr-sv-date = date(self :screen-value) no-error
     7754       .
     7755       if v-curr-sv-date = ?
     7756       then do:
     7757         run gbl/getcurdt.p
     7758           (output v-curr-sv-date
     7759           ) .
     7760       end.
     7761       if v-curr-sv-date <> ?
     7762       then do:
     7763         assign
     7764           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     7765         .
     7766         assign
     7767           self :screen-value = string(v-new-sv-date) .
     7768         .
     7769       end.
     7770     end.
     7771     return no-apply .
     7772   end.
     7773   on ctrl-e of sch-date in frame d-all-docs
     7774   do:
     7775     if (can-query (self, "sensitive")
     7776        and
