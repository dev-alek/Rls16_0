     3464         ) no-error .
     3465       if error-status :error then do:
     3466         undo, return error return-value .
     3467       end.
     3468       find first buf_ord-doc-attr exclusive-lock
     3469         where buf_ord-doc-attr.doc-code  = p-doc-code
     3470           and buf_ord-doc-attr.attr-code = p-code
     3471         no-error .
     3472       if not available buf_ord-doc-attr then do:
     3473         create buf_ord-doc-attr .
     3474         assign
     3475           buf_ord-doc-attr.doc-code  = p-doc-code
     3476           buf_ord-doc-attr.attr-code = p-code
     3477         .
     3478       end.
     3479       assign
     3480         buf_ord-doc-attr.attr-value = p-value
     3481       .
     3482   end.
     3483   end procedure.
