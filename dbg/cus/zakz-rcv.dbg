     6407   run minbtn-set in this-procedure .
     6408   on choose of b-help in frame d-all-docs
     6409   do:
     6410     apply "help":u to frame d-all-docs .
     6411   end.
     6412   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6413   procedure minbtn-set :
     6414       do
     6415           on error undo, return error return-value
     6416           :
     6417           define variable ii              as integer       no-undo .
     6418           define variable fh              as widget-handle no-undo .
     6419           define variable hh              as widget-handle no-undo .
     6420           define variable v-h             as handle        extent 4 no-undo .
     6421           define variable v-name-button   as character     no-undo .
     6422           define variable v-help-old-x    as decimal       no-undo .
     6423           define variable v-help-old-y    as decimal       no-undo .
     6424           define variable v-help-old-size as decimal       no-undo .
     6425           define variable v-frame-width   as decimal       no-undo .
     6426           define variable jj              as integer       no-undo .
     6427           do
     6428               on error undo, return error
     6429               :
     6430               assign
     6431                   v-frame-width = frame d-all-docs:width - 0.3
     6432                   fh            = frame d-all-docs:first-child
     6433                   hh            = fh:first-child
     6434                   ii            = 1
     6435                   .
     6436               do while valid-handle(hh):
     6437                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     6438                   do:
     6439                       case lc(hh:name) :
     6440                           when "b-help" then
     6441                               do:
     6442                                   hh:load-image-up("cmp/b-help.bmp":u) .
     6443                                   hh:load-image-down("cmp/b-help.bmp":u) .
     6444                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     6445                                   hh:TOOLTIP = "Помощь" .
     6446                                   v-help-old-x = hh:column .
     6447                                   v-help-old-y = hh:row    .
     6448                                   v-help-old-size = hh:width .
     6449                                   hh:width-chars = 2.5 .
     6450                               end.
     6451                           when "b-print" then
     6452                               do:
     6453                                   hh:load-image("cmp/b-print.bmp":u) .
     6454                                   hh:TOOLTIP = "Печать" .
     6455                                   v-h[ii] = hh:handle .
     6456                                   ii = ii + 1 .
     6457                                   hh:width-chars = 3 .
     6458                               end.
     6459                           when "b-history" or
     6460                           when "b-hist" then
     6461                               do:
     6462                                   hh:load-image("cmp/b-hist.bmp":u) .
     6463                                   hh:TOOLTIP = "История" .
     6464                                   v-h[ii] = hh:handle .
     6465                                   ii = ii + 1 .
     6466                                   hh:width-chars = 3 .
     6467                               end.
     6468                           when "b-sch" then
     6469                               do:
     6470                                   hh:load-image("cmp/b-sch.bmp":u) .
     6471                                   hh:TOOLTIP = "Установка Фильтра" .
     6472                                   v-h[ii] = hh:handle .
     6473                                   ii = ii + 1 .
     6474                                   hh:width-chars = 3 .
     6475                               end.
     6476                           when "b-hist-user" then
     6477                               do:
     6478                                   hh:load-image("cmp/b-hist.bmp":u) .
     6479                                   hh:TOOLTIP = "История пользователя" .
     6480                                   ii = ii + 1 .
     6481                               end.
     6482                       end case.
     6483                   end.
     6484                   hh = hh:next-sibling.
     6485               end.
     6486               b-help:column = v-frame-width - b-help:width-chars.
     6487               jj = 0.
     6488               repeat ii = 4 to 1 by -1 :
     6489                   if valid-handle (v-h[ii] ) then
     6490                   do:
     6491                       jj  = jj + 1 .
     6492                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     6493                       v-h[ii]:row    = v-help-old-y .
     6494                   end.
     6495               end.
     6496           end.
     6497       end.
     6498   end procedure.
     6499   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     6500   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     6501   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     6502   define variable v-diasize-orig-frame-width     as decimal   no-undo .
