     3704       if error-status :error then do:
     3705         message
     3706           vss-workfile vss-revision vss-description skip
     3707           error-status :get-message(1) skip
     3708           return-value skip
     3709           ""
     3710           view-as alert-box error
     3711         .
     3712         undo, return error return-value .
     3713       end.
     3714       find first buf_ord-line-attr exclusive-lock
     3715         where buf_ord-line-attr.doc-code  = p-doc-code
     3716           and buf_ord-line-attr.gds-code  = p-gds-code
     3717           and buf_ord-line-attr.attr-code = p-code
     3718         no-error .
     3719       if not available buf_ord-line-attr then do:
     3720         create buf_ord-line-attr .
     3721         assign
     3722           buf_ord-line-attr.doc-code   = p-doc-code
     3723           buf_ord-line-attr.gds-code   = p-gds-code
     3724           buf_ord-line-attr.attr-code  = p-code
     3725         .
     3726       end.
     3727       assign
     3728         buf_ord-line-attr.attr-value = p-value
     3729       .
     3730   end.
     3731   end procedure.
