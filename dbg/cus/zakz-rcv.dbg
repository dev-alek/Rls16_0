     3529   procedure orddocattr-delete :
     3530     do
     3531     on error undo, return error return-value
     3532     :
     3533       define input parameter p-doc-code like ub.ord-doc-attr.doc-code   no-undo .
     3534       define input parameter p-code     like ub.ord-doc-attr.attr-code  no-undo .
     3535       define output parameter p-deleted  as logical no-undo.
     3536       define buffer buf_ord-doc-attr for ub.ord-doc-attr .
