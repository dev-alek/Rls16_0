      644   function cross-list returns logical (
      645     input parfirst-stream  as character,
      646     input parsecond-stream as character,
      647     input pardelim         as character).
      648     if pardelim = ""
      649     or pardelim = ?
      650     then do:
      651       assign
      652         pardelim = ","
      653       .
      654     end.
      655     define variable vari            as integer no-undo .
      656     define variable varresult-cross as logical no-undo .
      657     assign
      658       varresult-cross = no
      659     .
      660     def var v-num-parfirst-stream as integer no-undo .
      661     assign
      662       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      663     .
      664     do vari = 1 to v-num-parfirst-stream
      665     :
      666       if lookup(entry(vari, parfirst-stream, pardelim)
      667                ,parsecond-stream
      668                ,pardelim
      669                ) > 0 then do:
      670         assign
      671           varresult-cross = yes
      672         .
      673         leave.
      674       end.
      675     end.
      676     return varresult-cross .
      677   end function.
      678   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679   function octal-to-char return character
      680   ( p-string as character ) :
      681     def var v-asc     as integer no-undo .
      682     def var v-new-asc as integer no-undo .
      683     def var ind       as integer no-undo .
      684     if length(p-string) <> 3 then do:
      685       return ? .
      686     end.
      687     assign
      688       v-asc = 0
      689     .
      690     do ind = 1 to length(p-string)
      691     :
      692       assign
      693         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      694       .
      695       if v-new-asc < 0 or v-new-asc >= 8 then do:
      696         return ? .
      697       end.
      698       assign
      699         v-asc = v-asc * 8 + v-new-asc
      700       .
      701     end.
      702     return chr(v-asc) .
      703   end function .
      704   function char-to-octal return character
      705   ( p-chr as character ) :
      706     def var v-asc    as integer   no-undo .
      707     def var ind      as integer   no-undo .
      708     def var v-string as character no-undo .
      709     if length(p-chr) <> 1 then do:
      710       return ? .
      711     end.
      712     assign
      713       v-asc    = asc(p-chr)
      714       v-string = ""
      715     .
      716     do ind = 1 to 3
      717     :
      718       assign
      719         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      720       .
      721       assign
      722         v-asc = truncate(v-asc / 8, 0)
      723       .
      724     end.
      725     return v-string .
      726   end.
      727   function str-encode return character
      728   (   p-init-string       as character
      729     , p-encode-char       as character
      730     , p-special-char-list as character
      731   ) :
      732     def var p-encode-string as character no-undo .
      733     def var ind                as integer no-undo .
      734     def var v-num-special-char as integer no-undo .
      735     def var v-special-char     as character no-undo .
      736     if p-encode-char = ?
      737     or p-encode-char = "" then do:
      738       assign
      739         p-encode-char = "~~"
      740       .
      741     end.
      742     if p-init-string = ? then do:
      743       return "?" .
      744     end.
      745     if p-init-string = "?" then do:
      746       return p-encode-char + char-to-octal("?") .
      747     end.
      748     assign
      749       v-num-special-char = length(p-special-char-list)
      750       p-encode-string    = replace(p-init-string
      751                                   ,p-encode-char
      752                                   ,p-encode-char + char-to-octal(p-encode-char)
      753                                   )
      754     .
      755     do ind = 1 to v-num-special-char
      756     :
      757       assign
      758         v-special-char = substring(p-special-char-list, ind, 1)
      759       .
      760       if v-special-char <> p-encode-char then do:
      761         assign
      762           p-encode-string = replace (p-encode-string
      763                                     ,v-special-char
      764                                     ,p-encode-char + char-to-octal(v-special-char)
      765                                     )
      766         .
      767       end.
      768     end.
      769     return p-encode-string .
      770   end.
      771   function str-decode returns character
      772     (p-init-string   as character
      773     ,p-encode-char   as character
      774     ) :
      775     def var p-decode-string as character no-undo .
      776     def var ind                       as integer no-undo .
      777     def var v-num-entries-init-string as integer no-undo .
      778     def var v-sub-phrase              as character no-undo .
      779     def var v-special-char            as character no-undo .
      780     if p-encode-char = ?
      781     or p-encode-char = "" then do:
      782       assign
      783         p-encode-char = "~~"
      784       .
      785     end.
      786     if p-init-string = "?" then do:
      787       return ? .
      788     end.
      789     assign
      790       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      791     .
      792     if v-num-entries-init-string > 1 then do:
      793       assign
      794         p-decode-string = entry(1, p-init-string, p-encode-char)
      795       .
      796       do ind = 2 to v-num-entries-init-string
      797       :
      798         assign
      799           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      800         .
      801         assign
      802           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      803         .
      804         if v-special-char <> ? then do:
      805           assign
      806             p-decode-string = p-decode-string
      807                             + v-special-char
      808                             + substring(v-sub-phrase, 4)
      809           .
      810         end.
      811         else do:
      812           assign
      813             p-decode-string = p-decode-string
      814                             + p-encode-char
      815                             + v-sub-phrase
      816           .
      817         end.
      818       end.
      819     end.
      820     else do:
      821       assign
      822         p-decode-string = p-init-string
      823       .
      824     end.
      825     return p-decode-string .
      826   end.
