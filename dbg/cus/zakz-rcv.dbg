    10739             " " + sort-column-phrase +
    10740           " " + sort-phrase-103
    10741           )
    10742         parameter-7-103 =
    10743           " indexed-reposition  "
    10744       .
    10745         run fltopend_fltfindq in this-procedure  (
    10746                             input this-procedure:handle
    10747                             ,input query br-docs:handle
    10748                             ,input logical(parameter-2-103)
    10749                             ,input no-lock
    10750                             ,input parameter-3-103
    10751                             ,input parameter-4-103
    10752                             ,input parameter-5-103
    10753                             ,input parameter-6-103
    10754                             ,input parameter-7-103
    10755                             ,output v-fltopend-rowid
    10756                             ) no-error.
    10757         .
    10758         doc-rec = ?.
    10759       end.
    10760       assign
    10761         l-query-was-opened = true
    10762       .
    10763     end.
    10764   end.
    10765     run waitfram-hide in this-procedure .
    10766     end.
    10767   end case.
    10768   if not p-open-query then do:
    10769      reposition br-docs to recid doc-rec no-error.
    10770      if error-status :error then message "Документ не найден." view-as alert-box information .
    10771      apply "value-changed" to br-docs in frame d-all-docs .
    10772   end.
    10773   apply "entry" to br-docs in frame d-all-docs.
    10774       OPEN QUERY BR-rcv FOR EACH ub.ord-doc-rcv no-lock where ub.ord-doc-rcv.doc-code = shar-buf_ord-doc.doc-code,       first bufs_ord-doc-rcv no-lock  where bufs_ord-doc-rcv.rcv-code =  ub.ord-doc-rcv.rcv-code and       bufs_ord-doc-rcv.doc-code =  ub.ord-doc-rcv.doc-code  ,       first ub.ord-chain no-lock where              ub.ord-chain.doc-code = ub.ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and              ub.ord-chain.rel-doc-type = 'trn' OUTER-JOIN,       EACH ub.trn-doc no-lock WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code OUTER-JOIN.
    10775   END PROCEDURE.
    10776   PROCEDURE local-mark:
    10777     if not available shar-buf_ord-doc then do:
    10778       message "Неправильный выбор строки.".
    10779       return error.
    10780     end.
    10781   define variable vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10782   define variable v-str-recid105 as character no-undo .
    10783   define variable v-num-entry105 as integer   no-undo .
    10784   assign
    10785     v-str-recid105 = trim( string( recid( shar-buf_ord-doc ) , "->>>>>>>>>>>9":U ) )
    10786     v-num-entry105 = lookup( v-str-recid105 , del-list )
    10787   .
    10788   if v-num-entry105 > 0 then do:
    10789     assign
    10790       entry( v-num-entry105, del-list ) = "":U
    10791       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
    10792     .
    10793   end.
    10794   else do:
    10795     assign
    10796       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid105
    10797     .
    10798   end.
    10799     if lookup(string( recid(shar-buf_ord-doc) ), del-list ) > 0
    10800         then disp "*"  @ mark with browse  br-docs.
    10801         else disp "" @ mark with browse  br-docs.
    10802   END PROCEDURE.
    10803   procedure set-reject :
    10804   define buffer t-ord-line for ub.ord-line.
    10805   if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec exclusive-lock .   end. if shar-buf_ord-doc.status_     = 'факт':U and shar-buf_ord-doc.flag_= true  then do:    find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.    message "Заказ закрыт до статуса ФАКТ .".    return no-apply. end.
    10806    find current shar-buf_ord-doc no-lock  no-error.
    10807     if avail shar-buf_ord-doc and shar-buf_ord-doc.status_ = 'отказ':U then do:
    10808         Message "Документ уже находится в статусе " shar-buf_ord-doc.status_ view-as alert-box.
    10809         return.
    10810     end.
    10811     if not( shar-buf_ord-doc.status_ = 'новый':U OR
    10812             shar-buf_ord-doc.status_ = 'согласование':U or
    10813             shar-buf_ord-doc.status_ = 'поставка':U
    10814             ) then do:
    10815         Message "Документ  находится в статусе " CAPS(shar-buf_ord-doc.status_) " Отказать нельзя !" view-as alert-box.
    10816         return.
    10817     end.
    10818     if shar-buf_ord-doc.status_ = 'поставка':U then do:
    10819     g#log = false .
    10820     Message "Вы собираетесь проставить статус ОТКАЗАТЬ заказу в статусе ПОСТАВКА !" skip (2)
    10821             "Это означает, что ВЫ не сможете по нему сформировать или получить ПН !" skip(2)
    10822              " Если поставки и накладные уже созданы, то они будут существовать самостоятельно !" skip(2)
    10823             "Отказать заказу № " shar-buf_ord-doc.doc-code  " ?"
    10824              view-as alert-box question
    10825              buttons YES-NO
    10826              title "В Н И М А Н И Е !!! "
    10827              update g#log
    10828              .
    10829              if NOT g#log then return .
    10830     end.
    10831     Message "Отказать заказу № " shar-buf_ord-doc.doc-code  " ?" view-as alert-box
    10832              QUESTION buttons YES-NO update g#log.
    10833              if NOT g#log then return .
    10834    if shar-buf_ord-doc.cons-code <> "" and shar-buf_ord-doc.cons-code <> ? then do:
    10835    define buffer b_ord-cons for ub.ord-cons.
    10836       find first b_ord-cons where b_ord-cons.cons-code = shar-buf_ord-doc.cons-code no-lock no-error .
    10837       if avail b_ord-cons and b_ord-cons.status_ <> 'новый':U then do:
    10838           Message "Нельзя отказать заказу № " shar-buf_ord-doc.doc-code  " , так как СЗФП уже находится в статусе " b_ord-cons.status_ view-as alert-box.
    10839           return.
    10840       end.
    10841    end.
    10842    define variable tt as character no-undo .
    10843    define variable tt2 as character no-undo .
    10844    find current shar-buf_ord-doc EXCLUSIVE-LOCK no-error.
    10845       if available shar-buf_ord-doc then do:
    10846         if shar-buf_ord-doc.status_ = 'поставка':U then do:
    10847            shar-buf_ord-doc.PS =  substitute("ОТКАЗ со статуса ПОСТАВКА !!! &1" ,shar-buf_ord-doc.PS ) .
    10848         end.
    10849         assign
    10850           tt = shar-buf_ord-doc.cons-code
    10851           shar-buf_ord-doc.status_ = 'отказ':U
    10852           shar-buf_ord-doc.fact-date = to-day
    10853           shar-buf_ord-doc.cons-code  = shar-buf_ord-doc.cons-code + 'отказ':U .
    10854           .
    10855          if tt <> "" and tt <> ? then do:
    10856             for each t-ord-line where t-ord-line.doc-code = shar-buf_ord-doc.doc-code :
    10857                   find first  ub.ord-gds-cons where
    10858                     ub.ord-gds-cons.cons-code = tt                    and
    10859                     ub.ord-gds-cons.artic =     t-ord-line.artic       and
    10860                     ub.ord-gds-cons.prod-code = t-ord-line.prod-code   and
    10861                     ub.ord-gds-cons.prod-type = t-ord-line.prod-type   exclusive-lock use-index pi no-error .
    10862                     if available ub.ord-gds-cons then do:
    10863                         ub.ord-gds-cons.sum-qnty = ub.ord-gds-cons.sum-qnty - t-ord-line.qnty.
    10864                         if ub.ord-gds-cons.sum-qnty  = 0 then do:
    10865                           delete ub.ord-gds-cons.
    10866                         end.
    10867                     end.
    10868             end.
    10869           end.
    10870          find current shar-buf_ord-doc  no-lock  no-error .
    10871          define variable v-recid as recid no-undo .
    10872          if error-status :error then
    10873             message 'ошибка поиска shar-buf_ord-doc'skip
    10874             vss-workfile vss-revision vss-description skip
    10875             error-status :get-message(1) .
    10876           v-recid = recid (shar-buf_ord-doc) .
    10877          run str/callnews.p     (input "ord-doc"      ,input (buffer shar-buf_ord-doc:handle)    ) no-error .        if error-status:error then do:     Assign shar-buf_ord-doc.flag_ = True  shar-buf_ord-doc.status_ = 'новый':U.     Message                                                      vss-workfile vss-revision vss-description skip             "Ошибка при передаче заказа в новости" skip                "Документ" shar-buf_ord-doc.doc-code skip                             view-as alert-box .                                        return no-apply.                                       end.
    10878           run UI-on in this-procedure (yes, no, '':U) no-error .
    10879           if error-status :error then
    10880               message 'ошибка процедуры UI-on' skip
    10881               vss-workfile vss-revision vss-description skip
    10882               error-status :get-message(1) .
    10883            reposition br-docs to recid v-recid no-error .
    10884            apply "value-changed" to br-docs in frame d-all-docs .
    10885       end.
    10886   END PROCEDURE.
    10887   PROCEDURE mode-g#type :
    10888   define variable  m-i-of  as widget-handle.
    10889   define variable  m-i-op  as widget-handle.
    10890   define variable  m-i-fp  as widget-handle.
    10891   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
    10892   if  g#type <> 'ОФ':U
    10893   and g#type <> 'ОП':U
    10894   and g#type <> 'ФП':U
    10895   then do:
    10896     disable b-rep with frame d-all-docs .
    10897   end.
    10898   if g#type = 'ОФ':U then  do:
    10899   frame d-all-docs:title = "ЗАЯВКИ   " + frame d-all-docs:title .
    10900       create menu-item m-i-of IN WIDGET-POOL "My-pool"
    10901         assign parent = menu m-rep:handle
    10902         label = 'Отчет об исполнении заявок'
    10903         .
    10904         ON CHOOSE OF m-i-of PERSISTENT
    10905          run run-rep (1) .
    10906   end.
    10907   if g#type = 'ОП':U then  do:
    10908   frame d-all-docs:title = "ЗАКАЗЫ   " + frame d-all-docs:title .
    10909       create menu-item m-i-op IN WIDGET-POOL "My-pool"
    10910         assign parent = menu m-rep:handle
    10911               label = 'Отчет об исполнении заказов ОП'
    10912         .
    10913         ON CHOOSE OF m-i-op PERSISTENT run run-rep (2) .
    10914         g#log =  br-docs:MOVE-COLUMN(10, 14) IN FRAME d-all-docs  no-error .
    10915         shar-buf_ord-doc.cons-code:label in browse  br-docs = "Ссылка".
    10916   end.
    10917   if g#type = 'ФП':U then  do:
    10918   frame d-all-docs:title = "ЗАКАЗЫ   " + frame d-all-docs:title .
    10919       create menu-item m-i-fp IN WIDGET-POOL "My-pool"
    10920         assign parent = menu m-rep:handle
    10921               label = 'Отчет об исполнении заказов ФП'
    10922         .
    10923         ON CHOOSE OF m-i-fp PERSISTENT run run-rep (3) .
    10924   end.
    10925   end procedure.
    10926   procedure run-rep :
    10927   define input parameter j as integer no-undo .
    10928   if j = 1 then do:
    10929      run cus/g-isp-zy.p
    10930        (input parparentproc
    10931        ) .
    10932   end.
    10933   if j = 2 then do:
    10934      run cus/g-isp-zk.p
    10935        (input parparentproc
    10936        ) .
    10937   end.
    10938   if j = 3 then do:
    10939      run cus/g-isp-zf.p
    10940        (input parparentproc
    10941        ) .
    10942   end.
    10943   end procedure.
    10944   procedure proc-b-chg:
    10945    if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec exclusive-lock .   end. if shar-buf_ord-doc.status_     = 'факт':U and shar-buf_ord-doc.flag_= true  then do:    find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.    message "Заказ закрыт до статуса ФАКТ .".    return no-apply. end.
    10946     if (( shar-buf_ord-doc.ord-int1 = int('1':U)
    10947        or shar-buf_ord-doc.ord-int1 = int('2':U) )
    10948       and shar-buf_ord-doc.whole-send-news = integer('1':U))
    10949     or (( shar-buf_ord-doc.ord-int1 = int('1':U)
    10950        or shar-buf_ord-doc.ord-int1 = int('2':U) )
    10951       and shar-buf_ord-doc.whole-send-news = integer('2':U))
    10952     then do:
    10953       message
    10954       "Документ "  shar-buf_ord-doc.doc-code  " нельзя корректировать, по системе EDOC\EDI заказ направлен поставщику"  view-as  alert-box .
    10955           return .
    10956     end.
    10957     if v-cntxt-db-num = 0 then do:
    10958       if not (shar-buf_ord-doc.status_  = 'новый':U or
    10959               shar-buf_ord-doc.status_  = 'согласование':U)
    10960           or (shar-buf_ord-doc.status_  = 'новый':U and not v-obj-active = "yes")
    10961       then do:
    10962           message "Документ "  shar-buf_ord-doc.doc-code  " нельзя корректировать ,  статус " caps(shar-buf_ord-doc.status_) if v-not-activ then "на неактивном складе" else ""  view-as  alert-box .
    10963           return .
    10964       end.
    10965     end.
    10966     else do:
    10967       if shar-buf_ord-doc.status_  <> 'новый':U then do:
    10968           message "Документ "  shar-buf_ord-doc.doc-code  " нельзя корректировать ,  статус " caps(shar-buf_ord-doc.status_) view-as  alert-box .
    10969           return .
    10970       end.
    10971     end.
    10972    if shar-buf_ord-doc.doc-type  =  'ФП':U and v-not-activ then do :
    10973       message "Заказ "  shar-buf_ord-doc.doc-code  " нельзя корректировать ,  статус " shar-buf_ord-doc.status_ " на неактивном складе "
    10974       view-as alert-box information.
    10975       return .
    10976     end.
    10977   define variable v-ri as recid no-undo .
    10978   v-ri = recid (shar-buf_ord-doc) .
    10979   run cus/ord-zakz.p
    10980     (  input parParentProc ,
    10981        input 'ИЗМЕНЕНИЕ':U ,
    10982        input shar-buf_ord-doc.doc-type ,
    10983        output doc-rec ,
    10984        input-output  br-handle ,
    10985        input-output  bf-handle ,
    10986        input-output  next-prev
    10987       ) .
    10988   run UI-on in this-procedure (yes, no, '':U).
    10989   reposition br-docs to recid v-ri no-error.
    10990   apply "value-changed" to br-docs in frame d-all-docs .
    10991   end procedure.
    10992   PROCEDURE make-fp-rcv :
    10993   define output param r-rec as recid no-undo.
    10994   define variable l-recid as recid no-undo.
    10995   define variable ks          as  integer no-undo .
    10996   define variable loc-ord-num as  character no-undo .
    10997   define variable ii          as  integer no-undo .
    10998   define buffer   b-goods     for ub.goods .
    10999   define buffer   bfp-ord-doc for ub.ord-doc .
    11000   define buffer   buf2-ord-line-rcv for ub.ord-line-rcv.
    11001   define variable last-all-rcv as decimal no-undo .
    11002   define variable glog as logical no-undo .
    11003   ks = 0.
    11004   define variable v-i-doc as character no-undo .
    11005   if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec exclusive-lock .   end. if shar-buf_ord-doc.status_     = 'факт':U and shar-buf_ord-doc.flag_= true  then do:    find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.    message "Заказ закрыт до статуса ФАКТ .".    return no-apply. end.
    11006      find current shar-buf_ord-doc  no-lock no-error .
    11007         if not available  shar-buf_ord-doc then do:
    11008           message "Не выбран Заказ ФП !!! " .
    11009           return.
    11010         end.
    11011     find first bfp-ord-doc where bfp-ord-doc.doc-code = shar-buf_ord-doc.doc-code no-lock no-error.
    11012               if error-status :error  then return.
    11013      if bfp-ord-doc.status_ <> 'поставка':U
    11014        then do:
    11015           message "Нельзя делать Поставку на  Заказ в статусе " caps(bfp-ord-doc.status_) " !"
    11016                    view-as alert-box information .
    11017           return.
    11018      end.
    11019      if (( bfp-ord-doc.ord-int1 = int('5':U)
    11020         or bfp-ord-doc.ord-int1 = int('6':U))
    11021        and is-edoc-nn
    11022        and bfp-ord-doc.whole-send-news = integer('1':U) )
    11023     or  (
    11024     is-edi
    11025        and bfp-ord-doc.whole-send-news = integer('2':U) )
    11026           and bfp-ord-doc.doc-type = 'ОП':U
    11027        then do:
    11028       if is-edi
    11029       and bfp-ord-doc.whole-send-news = integer('2':U) then do:
    11030   define variable vss-include-info106 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11031   do:
    11032     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    11033       (input  v-cntxt-db-num
    11034       ,input  v-cntxt-userid
    11035       ,input  0
    11036       ,input  'actn_ord-rcv_add-def-bypass-EDI':U
    11037       ,input  'object':U
    11038       ,input  g#host-code
    11039       ,input  store-type
    11040       ,input  store-code
    11041       ,input  0
    11042       ,input  0
    11043       ,input  0
    11044       ,input  true
    11045       ,output g-log
    11046       )  .
    11047   end.
    11048         if g-log = false then do:
    11049           return.
    11050         end.
    11051         else do:
    11052           glog = no.
    11053           message
    11054           "Вы уверены, что хотите сделать вручную поставку на Заказ, маршрутизируемый по EDI?" skip
    11055           view-as alert-box question buttons yes-no update glog .
    11056           if not glog then return.
    11057         end.
    11058       end.
    11059       if is-edoc-nn
    11060       and bfp-ord-doc.whole-send-news = integer('1':U) then do:
    11061        message
    11062         "Нельзя делать Поставку на Заказ при работе в EDOC ! Она придет в электронном виде от поставщика."
    11063                    view-as alert-box information .
    11064           return.
    11065      end.
    11066      end.
    11067      if ( trim(bfp-ord-doc.cons-code) = ""  or  bfp-ord-doc.cons-code = ? ) and bfp-ord-doc.doc-type = 'ОП':U  and v-edoc-ora then do:
    11068        message
    11069        "Нельзя делать Поставку на Заказ . Заказ отправлен во внешнюю систему ! Ждем подтверждения от внешней системы."
    11070                    view-as alert-box information .
    11071           return.
    11072      end.
    11073      define variable v-is-limit as logical   no-undo .
    11074      run ver-qnty-rcv-from-ord (input bfp-ord-doc.doc-code , output v-is-limit ) .
    11075      if v-is-limit then do:
    11076           message "Нельзя делать Поставку на Заказ. Система настроена на работу 1:1."
    11077                    view-as alert-box information .
    11078           return.
    11079      end.
    11080   define variable vss-include-info107 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11081   run proc-ord-code in this-procedure
    11082    (input   'main' ,
    11083     input   v-cntxt-db-num ,
    11084     input   v-cntxt-obj-type ,
    11085     input   v-cntxt-obj-code ,
    11086     input   v-i-doc ,
    11087     output  loc-ord-num
    11088    ) .
    11089   create ub.ord-doc-rcv.
    11090   buffer-copy bfp-ord-doc
    11091   except whole-send-news
    11092   to ub.ord-doc-rcv
    11093      assign
    11094         ub.ord-doc-rcv.rcv-code  = loc-ord-num
    11095         ub.ord-doc-rcv.doc-type  = "out":u
    11096         ub.ord-doc-rcv.doc-date  = to-day
    11097         ub.ord-doc-rcv.status_   = 'новый':U
    11098         ub.ord-doc-rcv.sub-par   = trim(entry(1, bfp-ord-doc.cli-out-doc, chr(4))) + chr(4) +
    11099                                 trim(bfp-ord-doc.vat-type) + chr(4)
    11100      .
    11101   v-doc-mode  = 'ДОБАВЛЕНИЕ':U.
    11102   x-make-avto = 2 .
    11103   define variable loc-make-avto as logical no-undo .
    11104           run cus/or-obj.w
    11105           ( input  parParentProc
    11106           , input  ub.ord-doc-rcv.host-code
    11107           , input  recid(ub.ord-doc-rcv)
    11108           , input  1
    11109           , input  'ИЗМЕНЕНИЕ':U
    11110           , input  'ИЗМЕНЕНИЕ':U
    11111           , input-output  v-doc-mode  ) .
    11112           case x-make-avto :
    11113             when 1 then loc-make-avto = true  .
    11114             when 4 then loc-make-avto = true  .
    11115             when 2 then loc-make-avto = false  .
    11116             when 3 then loc-make-avto = ? .
    11117           end case.
    11118     if v-doc-mode = "cancel":U then do :
    11119         find first ub.ord-doc-rcv where ub.ord-doc-rcv.rcv-code  = loc-ord-num  exclusive-lock  no-error .
    11120         delete ub.ord-doc-rcv .
    11121         r-rec = ? .
    11122         return .
    11123     end .
    11124    r-rec = recid ( ub.ord-doc-rcv ) .
    11125   v-doc-mode  = 'ДОБАВЛЕНИЕ':U .
    11126   if loc-make-avto <> ? then do:
    11127      for each ub.ord-line where ub.ord-line.doc-code = bfp-ord-doc.doc-code  no-lock :
    11128           ks = ks + 1 .
    11129           if not can-find  (first ub.ord-line-rcv where
    11130             ub.ord-line-rcv.doc-code  = ub.ord-doc-rcv.doc-code and
    11131             ub.ord-line-rcv.rcv-code  = ub.ord-doc-rcv.rcv-code and
    11132             ub.ord-line-rcv.artic     = ub.ord-line.artic and
    11133             ub.ord-line-rcv.prod-code = ub.ord-line.prod-code and
    11134             ub.ord-line-rcv.prod-type = ub.ord-line.prod-type no-lock ) then do:
    11135             last-all-rcv = 0 .
    11136             for each buf2-ord-line-rcv where
    11137                     buf2-ord-line-rcv.doc-code  = ub.ord-doc-rcv.doc-code and
    11138                     buf2-ord-line-rcv.artic     = ub.ord-line.artic and
    11139                     buf2-ord-line-rcv.prod-code = ub.ord-line.prod-code and
    11140                     buf2-ord-line-rcv.prod-type = ub.ord-line.prod-type no-lock
    11141                     :
    11142                     last-all-rcv =  last-all-rcv + buf2-ord-line-rcv.qnty .
    11143             end.
    11144            create ub.ord-line-rcv.
    11145            buffer-copy ub.ord-line to ub.ord-line-rcv
    11146            assign
    11147              ub.ord-line-rcv.rcv-code  = ub.ord-doc-rcv.rcv-code
    11148              ub.ord-line-rcv.line-num  = ks
    11149              ub.ord-line-rcv.qnty      = if (ub.ord-line.qnty - last-all-rcv) < 0 then 0 else  (ub.ord-line.qnty - last-all-rcv)
    11150              ub.ord-line-rcv.cli-qnty  = ub.ord-line-rcv.qnty / ub.ord-line-rcv.cli-base-rate
    11151            .
    11152            l-recid = recid(ub.ord-line-rcv) .
    11153            case loc-make-avto :
    11154                 when false  then do:
    11155                       v-doc-mode  = 'ДОБАВЛЕНИЕ':U.
    11156                       run cus/or-obj.w
    11157                       ( input  parParentProc
    11158                       , input  bfp-ord-doc.host-code
    11159                       , input  recid(ub.ord-line-rcv)
    11160                       , input  2
    11161                       , input  'ИЗМЕНЕНИЕ':U
    11162                       , input "ЦИКЛ":U
    11163                       , input-output  v-doc-mode  ) .
    11164                       if v-doc-mode =  "stopcycle":U   then do:
    11165                             find first ub.ord-line-rcv where
    11166                                 recid(ub.ord-line-rcv) = l-recid exclusive-lock  no-error .
    11167                             delete ub.ord-line-rcv.
    11168                             ks = ks - 1 .
    11169                             leave .
    11170                         end.
    11171                       if v-doc-mode =  "cancel":U   then do:
    11172                             find first ub.ord-line-rcv where
    11173                                 recid(ub.ord-line-rcv) = l-recid exclusive-lock  no-error .
    11174                             delete ub.ord-line-rcv.
    11175                             ks = ks - 1 .
    11176                         end.
    11177                     l-recid = recid(ub.ord-line-rcv).
    11178                 end.
    11179                 when true then do:
    11180                     l-recid = recid(ub.ord-line-rcv).
    11181                 end.
    11182              end case.
    11183            end.
    11184      end.
    11185   end.
    11186   if x-make-avto = 3 then do:
    11187      ks = 1.
    11188      run cus/scan-r.p (parparentproc,ub.ord-doc-rcv.rcv-code,ub.ord-doc-rcv.doc-code) .
    11189   end.
    11190    if ks > 0 then do:
    11191       r-rec = recid(ord-doc-rcv).
    11192       define variable g-log as logical   no-undo .
    11193       if x-make-avto = 4 then do:
    11194      find first ord-doc-rcv exclusive-lock where recid(ord-doc-rcv) =  r-rec .
    11195       run cus/rcv-clos.p
    11196       (
    11197           input parparentproc ,
    11198           input ord-doc-rcv.rcv-code ,
    11199           input yes ,
    11200           input store-type ,
    11201           input store-code ,
    11202           input false
    11203           ) no-error .
    11204       if error-status :error then do:
    11205             message  return-value  view-as alert-box error .
    11206             release ord-doc-rcv .
    11207             find first ord-doc-rcv no-lock where recid(ord-doc-rcv) = r-rec no-error .
    11208             return .
    11209       end.
    11210       OPEN QUERY BR-rcv FOR EACH ub.ord-doc-rcv no-lock where ub.ord-doc-rcv.doc-code = shar-buf_ord-doc.doc-code,       first bufs_ord-doc-rcv no-lock  where bufs_ord-doc-rcv.rcv-code =  ub.ord-doc-rcv.rcv-code and       bufs_ord-doc-rcv.doc-code =  ub.ord-doc-rcv.doc-code  ,       first ub.ord-chain no-lock where              ub.ord-chain.doc-code = ub.ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and              ub.ord-chain.rel-doc-type = 'trn' OUTER-JOIN,       EACH ub.trn-doc no-lock WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code OUTER-JOIN.
    11211       reposition BR-rcv to recid r-rec no-error  .
    11212       g-log =  br-docs:refresh()  in frame d-all-docs .
    11213       release ord-doc-rcv .
    11214       find first ord-doc-rcv no-lock where recid(ord-doc-rcv) = r-rec no-error .
    11215          run cus/ord-trn.p ( parParentProc ,  recid(ord-doc-rcv), no) no-error .
    11216          if error-status :error then do:
    11217          message
    11218            vss-workfile vss-revision vss-description skip
    11219            error-status :get-message(1) skip
    11220            return-value skip
    11221            "Ошибка при создании накладной"
    11222            view-as alert-box error
    11223          .
    11224          end.
    11225       end.
    11226     message "Сделана поставка № " loc-ord-num .
    11227    end.
    11228    else do:
    11229      find first ord-doc-rcv where ord-doc-rcv.rcv-code  = loc-ord-num  exclusive-lock  .
    11230      delete ord-doc-rcv .
    11231      r-rec = ?.
    11232    end.
    11233   END PROCEDURE.
    11234   procedure proc-close-2:
    11235     define variable g-log as logical   no-undo .
    11236     define variable ll-rec as recid no-undo .
    11237     find current ub.ord-doc-rcv no-lock no-error.
    11238     if not available ub.ord-doc-rcv then return .
    11239     ll-rec = recid(ub.ord-doc-rcv) .
    11240       run cus/rcv-clos.p
    11241       (
    11242           input parparentproc ,
    11243           input ub.ord-doc-rcv.rcv-code ,
    11244           input yes ,
    11245           input store-type ,
    11246           input store-code ,
    11247           input yes
    11248           ) no-error .
    11249       if error-status :error then do:
    11250             message  return-value  view-as alert-box error .
    11251             release ub.ord-doc-rcv .
    11252             find first ub.ord-doc-rcv no-lock where recid(ub.ord-doc-rcv) = ll-rec no-error .
    11253             return .
    11254       end.
    11255       OPEN QUERY BR-rcv FOR EACH ub.ord-doc-rcv no-lock where ub.ord-doc-rcv.doc-code = shar-buf_ord-doc.doc-code,       first bufs_ord-doc-rcv no-lock  where bufs_ord-doc-rcv.rcv-code =  ub.ord-doc-rcv.rcv-code and       bufs_ord-doc-rcv.doc-code =  ub.ord-doc-rcv.doc-code  ,       first ub.ord-chain no-lock where              ub.ord-chain.doc-code = ub.ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and              ub.ord-chain.rel-doc-type = 'trn' OUTER-JOIN,       EACH ub.trn-doc no-lock WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code OUTER-JOIN.
    11256       reposition BR-rcv to recid ll-rec no-error  .
    11257       g-log =  br-docs:refresh() in frame d-all-docs .
    11258       release ub.ord-doc-rcv .
    11259       find first ub.ord-doc-rcv no-lock where recid(ub.ord-doc-rcv) = ll-rec no-error .
    11260   END procedure.
    11261   procedure proc-b-del-2 :
    11262   define variable t-ret as logical no-undo .
    11263   if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec exclusive-lock .   end. if shar-buf_ord-doc.status_     = 'факт':U and shar-buf_ord-doc.flag_= true  then do:    find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.    message "Заказ закрыт до статуса ФАКТ .".    return no-apply. end.
    11264     t-ret =  session:SET-WAIT-STATE("GENERAL") .
    11265   find current ub.ord-doc-rcv no-lock no-error.
    11266   if available ub.ord-doc-rcv then do:
    11267     find current ub.ord-doc-rcv exclusive-lock no-error.
    11268     if available ub.ord-doc-rcv then do:
    11269       if ub.ord-doc-rcv.status_ <> 'новый':U then do :
    11270       message "Статус" ub.ord-doc-rcv.status_ "удалять нельзя! " view-as alert-box error .
    11271       return.
    11272       end.
    11273       message "Удалить поставку №"  ub.ord-doc-rcv.rcv-code "?" view-as alert-box
    11274             question buttons yes-no title "Вопрос" update g#log.
    11275         if g#log then do:
    11276           delete  ub.ord-doc-rcv .
    11277           OPEN QUERY BR-rcv FOR EACH ub.ord-doc-rcv no-lock where ub.ord-doc-rcv.doc-code = shar-buf_ord-doc.doc-code,       first bufs_ord-doc-rcv no-lock  where bufs_ord-doc-rcv.rcv-code =  ub.ord-doc-rcv.rcv-code and       bufs_ord-doc-rcv.doc-code =  ub.ord-doc-rcv.doc-code  ,       first ub.ord-chain no-lock where              ub.ord-chain.doc-code = ub.ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and              ub.ord-chain.rel-doc-type = 'trn' OUTER-JOIN,       EACH ub.trn-doc no-lock WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code OUTER-JOIN.
    11278         end.
    11279       end.
    11280   end.
    11281     t-ret =  session:SET-WAIT-STATE("") .
    11282   END PROCEDURE.
    11283   PROCEDURE proc-b-add :
    11284    define variable v-par-prt as logical no-undo .
    11285    define buffer buff_ord-doc for ub.ord-doc  .
    11286    if g#type = 'ОП':U  then do:
    11287       if v-cntxt-db-num <> v-cntxt-db-num-obj then do:
    11288          message  substitute("Заказ &1 можно создать только в  БД №  &2" ,  g#type,v-cntxt-db-num-obj )
    11289                   view-as alert-box information .
    11290          return .
    11291       end.
    11292    end.
    11293     run cus/ord-zakz.p
    11294       (input  parParentProc,
    11295        input  'ДОБАВЛЕНИЕ':U ,
    11296        input  g#type,
    11297        output doc-rec ,
    11298        input-output  br-handle ,
    11299        input-output  bf-handle ,
    11300        input-output  next-prev
    11301         ) no-error .
    11302        if error-status :error then
    11303        message
    11304          vss-workfile vss-revision vss-description skip
    11305          error-status :get-message(1) skip
    11306          return-value skip
    11307          "Ошибка при создании заказа"
    11308          view-as alert-box error
    11309        .
    11310     find first buff_ord-doc no-lock where recid(buff_ord-doc) =  doc-rec no-error .
    11311     if  available buff_ord-doc then do:
    11312         run UI-on in this-procedure (yes, no, '':U).
    11313         reposition br-docs to recid doc-rec no-error.
    11314         apply "value-changed" to br-docs in frame d-all-docs .
    11315     end.
    11316   END PROCEDURE.
    11317   procedure pp-1 :
    11318    do
    11319    on error undo, return error return-value
    11320    :
    11321     if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock .   end.
    11322     run cus/ord-zakz.p
    11323    (input parParentProc,
    11324     input "copy":u ,
    11325     input  shar-buf_ord-doc.doc-type ,
    11326     output doc-rec ,
    11327     input-output  br-handle ,
    11328     input-output  bf-handle ,
    11329     input-output  next-prev
    11330     ) .
    11331     run UI-on in this-procedure (yes, no, '':U).
    11332     reposition br-docs to recid doc-rec no-error.
    11333     apply "value-changed" to br-docs in frame d-all-docs .
    11334    end.
    11335   end procedure.
    11336   procedure pp-2 :
    11337    do
    11338    on error undo, return error return-value
    11339    :
    11340   define variable del-rec as recid no-undo.
    11341   define variable unrv-qnty as dec no-undo.
    11342       if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec exclusive-lock .   end. if shar-buf_ord-doc.status_     = 'факт':U and shar-buf_ord-doc.flag_= true  then do:    find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.    message "Заказ закрыт до статуса ФАКТ .".    return no-apply. end.
    11343       find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.
    11344       if shar-buf_ord-doc.status_ <> 'новый':U or (shar-buf_ord-doc.status_ = 'новый':U and not v-obj-active = "yes") then do:
    11345         message "Документ в статусе" shar-buf_ord-doc.status_ "удалять нельзя! " view-as alert-box error .
    11346         return no-apply.
    11347       end.
    11348       if (( shar-buf_ord-doc.ord-int1 = int('1':U)
    11349          or shar-buf_ord-doc.ord-int1 = int('2':U) )
    11350         and is-edoc-nn
    11351         and shar-buf_ord-doc.whole-send-news = integer('1':U) )
    11352       or (( shar-buf_ord-doc.ord-int1 = int('1':U)
    11353          or shar-buf_ord-doc.ord-int1 = int('2':U) )
    11354         and is-edi
    11355         and shar-buf_ord-doc.whole-send-news = integer('2':U) )
    11356         then do:
    11357         message
    11358         "Документ "  shar-buf_ord-doc.doc-code  " нельзя удалить ,  статус EDOC\EDI " caps('отправлен':U) "(Отправлен поставщику)"  view-as  alert-box .
    11359             return .
    11360       end.
    11361       if (( shar-buf_ord-doc.ord-int1 = int('3':U)
    11362          or shar-buf_ord-doc.ord-int1 = int('4':U) )
    11363         and is-edoc-nn
    11364         and shar-buf_ord-doc.whole-send-news = integer('1':U) )
    11365       or (( shar-buf_ord-doc.ord-int1 = int('3':U)
    11366          or shar-buf_ord-doc.ord-int1 = int('5':U))
    11367         and is-edi
    11368         and shar-buf_ord-doc.whole-send-news = integer('2':U) )
    11369         then do:
    11370         message
    11371         "Документ "  shar-buf_ord-doc.doc-code  " нельзя удалить ,  статус EDOC\EDI " caps('отправлен':U) "(Ожидает решения)"  view-as  alert-box .
    11372             return .
    11373       end.
    11374       g#log = no.
    11375       message "Удалить документ №" shar-buf_ord-doc.doc-code "?   Вы уверены ?"
    11376                       view-as alert-box question buttons OK-Cancel update g#log.
    11377       if not g#log then do:   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.   return no-apply. end.
    11378       run waitfram-show in this-procedure ("Удаление документа № " + shar-buf_ord-doc.doc-code + ". Ждите...").
    11379       br-handle  = br-docs:handle  in frame d-all-docs .
    11380       if valid-handle (br-handle) then do:
    11381         g#log = br-handle:select-next-row().
    11382         if not g#log then g#log = br-handle:select-prev-row().
    11383         del-rec = recid (shar-buf_ord-doc).
    11384       end.
    11385       find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec.
    11386       del-doc:
    11387       do on stop undo del-doc, return no-apply on error undo del-doc, return no-apply:
    11388         delete shar-buf_ord-doc.
    11389       end.
    11390       doc-rec = del-rec.
    11391       run waitfram-hide in this-procedure .
    11392       run UI-on in this-procedure (yes, no, '':U).
    11393    end.
    11394   end procedure.
    11395   PROCEDURE set-filter-name :
    11396   define input parameter p-filter-name as character no-undo .
    11397     do with frame d-all-docs:
    11398       if p-filter-name > "" then do:
    11399         assign
    11400           frame d-all-docs:title
    11401             = frame d-all-docs:title + "   ФИЛЬТР: " + p-filter-name.
    11402         .
    11403         assign
    11404           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
    11405         .
    11406       end.
    11407       else do:
    11408         assign
    11409           b-sch :TOOLTIP = ""
    11410         .
    11411       end.
    11412     end.
    11413   END PROCEDURE.
    11414   procedure proc-doc-code :
    11415   define input parameter par-next as logical no-undo.
    11416   define input parameter pardoc-code as char no-undo.
    11417     do
    11418     on error undo, return error return-value
    11419     :
    11420   display "" @ sch-date with frame d-all-docs.
    11421   display "" @ sch-fact with frame d-all-docs.
    11422   assign
    11423     pardoc-code = chr(34) + pardoc-code + chr(34) .
    11424        run Ui-on in this-procedure
    11425             (input false
    11426             ,input par-next
    11427             ,input substitute ( "and shar-buf_ord-doc.doc-code begins &1 "
    11428               , pardoc-code)
    11429             ) no-error .
    11430       if error-status :error then
    11431       message
    11432         vss-workfile vss-revision vss-description skip
    11433         error-status :get-message(1) skip
    11434         return-value skip
    11435         "ui-on"
    11436         view-as alert-box error
    11437       .
    11438    apply "VALUE-CHANGED" to br-docs in frame d-all-docs.
    11439    apply "entry" to sch-code in frame d-all-docs.
    11440     end.
    11441   end procedure.
    11442   procedure proc-doc-date :
    11443   define input parameter par-next as logical no-undo.
    11444   define input parameter pardoc-code as date      no-undo .
    11445     do
    11446     on error undo, return error return-value
    11447     :
    11448   define variable ppp as character no-undo .
    11449   display "" @ sch-code with frame d-all-docs.
    11450   display "" @ sch-fact with frame d-all-docs.
    11451   assign
    11452     ppp =  string( day(pardoc-code)) + "/" +  string( month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
    11453        run Ui-on in this-procedure
    11454             (input false
    11455             ,input par-next
    11456             ,input substitute ( "and shar-buf_ord-doc.doc-date = &1 "
    11457               , ppp)
    11458             ) no-error .
    11459       if error-status :error then
    11460       message
    11461         vss-workfile vss-revision vss-description skip
    11462         error-status :get-message(1) skip
    11463         return-value skip
    11464         "ui-on"
    11465         view-as alert-box error
    11466       .
    11467    apply "VALUE-CHANGED" to br-docs in frame d-all-docs.
    11468    apply "entry" to sch-date in frame d-all-docs.
    11469     end.
    11470   end procedure.
    11471   procedure proc-fact-date :
    11472   define input parameter par-next as logical no-undo.
    11473   define input parameter pardoc-code as date      no-undo .
    11474     do
    11475     on error undo, return error return-value
    11476     :
    11477   define variable ppp as character no-undo .
    11478   display "" @ sch-code with frame d-all-docs.
    11479   display "" @ sch-date with frame d-all-docs.
    11480   assign
    11481     ppp =  string( day(pardoc-code)) + "/" +  string(  month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
    11482        run Ui-on in this-procedure
    11483             (input false
    11484             ,input par-next
    11485             ,input substitute ( "and shar-buf_ord-doc.fact-date = &1 "
    11486               , ppp)
    11487             ) no-error .
    11488       if error-status :error then
    11489       message
    11490         vss-workfile vss-revision vss-description skip
    11491         error-status :get-message(1) skip
    11492         return-value skip
    11493         "ui-on"
    11494         view-as alert-box error
    11495       .
    11496    apply "VALUE-CHANGED" to br-docs in frame d-all-docs.
    11497    apply "entry" to sch-fact in frame d-all-docs.
    11498     end.
    11499   end procedure.
    11500   procedure  proc-m_gen-1 :
    11501     do
    11502     on error undo, return error return-value
    11503     :
    11504       if num-entries(del-list) = 0 then do:
    11505         message "Не выделено ни одного Заказа для генерации ФО !".
    11506         return error .
    11507       end.
    11508       run str/gen-fl.w
    11509       (
    11510           input parparentproc,
    11511           input g#host-code,
    11512           input del-list,
    11513           input "order"
    11514           ) .
    11515       assign del-list = "" .
    11516       run UI-on in this-procedure (yes, no, '':U) .
    11517     end.
    11518   end procedure.
    11519   procedure  proc-m_gen-1_buyer :
    11520     do
    11521     on error undo, return error return-value
    11522     :
    11523       if num-entries(del-list) = 0 then do:
    11524         message "Не выделено ни одного Заказа для генерации ФО !".
    11525         return error .
    11526       end.
    11527       run str/gen-fbuy.w
    11528       (   input parparentproc,
    11529           input g#host-code,
    11530           input del-list,
    11531           input "order"
    11532           ) .
    11533       assign del-list = "" .
    11534       run UI-on in this-procedure (yes, no, '':U) .
    11535     end.
    11536   end procedure.
    11537   PROCEDURE proc-m_gen-2 :
    11538   define buffer bf_sysconf for ub.sysconf.
    11539   define buffer bf_ord-doc for ub.ord-doc.
    11540   define variable v-i as integer no-undo.
    11541   define variable v-doc-code as integer no-undo.
    11542   do on error undo, return error return-value
    11543   :
    11544   if del-list = "" then do:
    11545     if available shar-buf_ord-doc then assign del-list = string(recid(shar-buf_ord-doc)).
    11546   end.
    11547   define variable v-nn as integer   no-undo .
    11548   v-nn = num-entries (del-list).
    11549   v-i-cycle:
    11550     do v-i = 1 to v-nn :
    11551       assign v-doc-code = integer(entry (v-i, del-list)).
    11552       find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code exclusive-lock.
    11553       if bf_ord-doc.status_ <> 'факт':U then do:
    11554         message "Документ " bf_ord-doc.status_ " не в статусе " 'факт':U " . Пропускаем." view-as alert-box.
    11555         next v-i-cycle.
    11556       end.
    11557       find first bf_sysconf where bf_sysconf.host-code = bf_ord-doc.host-code no-lock.
    11558       if bf_ord-doc.doc-type <> 'ПО':U then do:
    11559           if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
    11560             message "Главная БД для фирмы по документу с кодом " bf_ord-doc.doc-code " не является текущей БД." skip
    11561                     "Текущая БД: " v-cntxt-db-num skip "Главная БД фирмы: " bf_sysconf.firm-db-num
    11562             view-as alert-box error.
    11563             next v-i-cycle.
    11564           end.
    11565       end.
    11566       if bf_ord-doc.cr-fo = yes then do:
    11567         message "По документу " bf_ord-doc.doc-code " уже создавался ФО от " bf_ord-doc.fo-date " числа." view-as alert-box.
    11568         next v-i-cycle.
    11569       end.
    11570       else do:
    11571         if bf_ord-doc.need-fo = 1 or bf_ord-doc.need-fo = 2 then assign  bf_ord-doc.need-fo = 0.
    11572         else do:
    11573           message "Данный документ не нуждался в генерации ФО." view-as alert-box.
    11574           next v-i-cycle.
    11575         end.
    11576         reposition br-docs to recid recid(bf_ord-doc) no-error.
    11577         if not error-status:error then do:
    11578            apply "value-changed" to br-docs in frame d-all-docs .
    11579            display f-fo (buffer bf_ord-doc) @ v-fo  mark  with browse br-docs.
    11580         end.
    11581       end.
    11582     end.
    11583     find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code no-lock no-error .
    11584     assign del-list = "".
    11585   end.
    11586   end procedure.
    11587   PROCEDURE proc-m_gen-3 :
    11588   define buffer bf_sysconf for ub.sysconf.
    11589   define buffer bf_ord-doc for ub.ord-doc.
    11590   define variable v-i as integer no-undo.
    11591   define variable v-doc-code as integer no-undo.
    11592   define variable v-log as logical   no-undo .
    11593   do on error undo, return error return-value
    11594   :
    11595     if del-list = "" then do:
    11596       if available shar-buf_ord-doc then assign del-list = string(recid(shar-buf_ord-doc)).
    11597     end.
    11598   define variable v-nn as integer   no-undo .
    11599   v-nn = num-entries (del-list).
    11600   v-i-cycle:
    11601     do v-i = 1 to v-nn :
    11602       assign v-doc-code = integer(entry (v-i, del-list)).
    11603       find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code exclusive-lock.
    11604       find first bf_sysconf where bf_sysconf.host-code = bf_ord-doc.host-code no-lock.
    11605       if lookup(bf_ord-doc.status_, 'факт':U + "," + 'поставка':U) = 0 then do:
    11606         message "Документ " bf_ord-doc.status_ " не в статусе " 'факт':U " . Пропускаем." view-as alert-box.
    11607         next v-i-cycle.
    11608       end.
    11609       if bf_ord-doc.doc-type <> 'ПО':U then do:
    11610           if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
    11611             message "Главная БД для фирмы по документу с кодом " bf_ord-doc.doc-code " не является текущей БД." skip
    11612                     "Текущая БД: " v-cntxt-db-num skip   "Главная БД фирмы: " bf_sysconf.firm-db-num
    11613             view-as alert-box error.
    11614             next v-i-cycle.
    11615           end.
    11616       end.
    11617       if bf_ord-doc.cr-fo = yes then do:
    11618         assign
    11619           v-log = no.
    11620           message "По документу " bf_ord-doc.doc-code " был создан ФО от " bf_ord-doc.fo-date " ." skip
    11621                   "Вы действительно хотите снять признак, чтобы по этому документу был ФО?"
    11622           view-as alert-box question buttons yes-no update v-log.
    11623          if v-log <> yes then  next v-i-cycle.
    11624          assign
    11625            bf_ord-doc.cr-fo   = no
    11626            bf_ord-doc.fo-date = 01/01/1990
    11627          .
    11628          reposition br-docs to recid recid(bf_ord-doc) no-error.
    11629         if not error-status:error then do:
    11630           apply "value-changed" to br-docs in frame d-all-docs .
    11631           display f-fo (buffer bf_ord-doc) @ v-fo mark with browse br-docs.
    11632         end.
    11633       end.
    11634       else do:
    11635         message "По документу " bf_ord-doc.doc-code " не было генерации."
    11636         view-as alert-box.
    11637      end.
    11638    end.
    11639    assign del-list = "".
    11640   end.
    11641   end procedure.
    11642   PROCEDURE proc-m_gen-4 :
    11643   define buffer bf_sysconf for ub.sysconf.
    11644   define buffer bf_ord-doc for ub.ord-doc.
    11645   define variable v-i as integer no-undo.
    11646   define variable v-doc-code as integer no-undo.
    11647   define variable v-need-fo as logical no-undo.
    11648   define buffer bf_contract for ub.contract.
    11649   do on error undo, return error return-value
    11650   :
    11651     if del-list = "" then do:
    11652       if available shar-buf_ord-doc then assign del-list = string(recid(shar-buf_ord-doc)).
    11653     end.
    11654   define variable v-nn as integer   no-undo .
    11655   v-nn = num-entries (del-list) .
    11656   v-i-cycle:
    11657     do v-i = 1 to v-nn:
    11658       assign v-doc-code = integer(entry (v-i, del-list)) .
    11659       find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code exclusive-lock.
    11660       find first bf_sysconf where bf_sysconf.host-code = bf_ord-doc.host-code no-lock.
    11661       if bf_ord-doc.status_ <> 'факт':U then do:
    11662         message "Документ " bf_ord-doc.doc-code " не в статусе " 'факт':U " . Пропускаем."  view-as alert-box.
    11663         next.
    11664       end.
    11665       if bf_ord-doc.doc-type <> 'ПО':U then do:
    11666           if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
    11667             message "Главная БД для фирмы по документу с кодом " bf_ord-doc.doc-code " не является текущей БД." skip
    11668                     "Текущая БД: " v-cntxt-db-num skip "Главная БД фирмы: " bf_sysconf.firm-db-num
    11669             view-as alert-box error.
    11670             return error.
    11671           end.
    11672       end.
    11673       if bf_ord-doc.need-FO = 2 then do:
    11674         if bf_ord-doc.contract-code <> 0 then do:
    11675           find first bf_contract where bf_contract.host-code     = bf_ord-doc.host-code   and
    11676                                        bf_contract.contract-code = bf_ord-doc.contract-code no-lock no-error.
    11677           if available bf_contract then do:
    11678             if  true  then do:
    11679               assign bf_ord-doc.need-FO = 1  .
    11680               reposition br-docs to recid recid(bf_ord-doc) no-error.
    11681               if not error-status:error then do:
    11682                 apply "value-changed" to br-docs in frame d-all-docs .
    11683                 display f-FO (buffer bf_ord-doc) @ v-FO  mark with browse br-docs.
    11684               end.
    11685             end.
    11686             else message "По документу " bf_ord-doc.doc-code " нет договоров для генерации ФО."  view-as alert-box.
    11687           end.
    11688         end.
    11689       end.
    11690       else do:
    11691         message "Документ " bf_ord-doc.doc-code "не имеет признака 'не опред' генерация ФО."
    11692         view-as alert-box.
    11693         next v-i-cycle.
    11694       end.
    11695     end.
    11696     assign del-list = "" .
    11697   find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code no-lock no-error .
    11698   end.
    11699   end procedure.
