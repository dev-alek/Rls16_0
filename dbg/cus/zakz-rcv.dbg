     3982     do
     3983     on error undo, return error return-value
     3984     :
     3985    p-error = false .
     3986    v-not-corr-op  = 'no' .
     3987    run clntattr-value (
     3988       input   p-obj-type
     3989     , input   p-obj-code
     3990     , input   'not-corr-op':U
     3991     , output  v-not-corr-op
     3992     , output  v-type
     3993     ) no-error .
     3994     if error-status :error then v-not-corr-op  = 'no' .
     3995     if v-not-corr-op = 'yes' and  p-method = ""  then do:
     3996       assign v-not-corr-op = 'no' .
     3997       run clntattr-value (
     3998       input   p-cli-type
     3999     , input   p-cli-code
     4000     , input   'not-corr-op':U
     4001     , output  v-not-corr-op
     4002     , output  v-type
     4003     ) no-error .
     4004     if error-status :error then v-not-corr-op  = 'no' .
     4005     if v-not-corr-op = 'yes'  and  p-method = ""  then p-error = true .
     4006     end.
     4007     end.
     4008   end procedure.
