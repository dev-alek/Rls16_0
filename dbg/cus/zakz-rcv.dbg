      193   procedure create_obj-list :
      194      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      195      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      196      do
      197      on error undo, return error return-value
      198      :
      199         define buffer cli-obj for ub.clients .
      200         define variable p-var as integer no-undo .
      201         define buffer buf_obj-list for obj-list .
      202         find last buf_obj-list  use-index pi no-error .
      203         if available buf_obj-list
      204         then
      205            p-var = buf_obj-list.obj-id + 1.
      206         else
      207            p-var = 1.
      208         find first cli-obj where
      209                   cli-obj.obj-type = p-obj-type
      210               and cli-obj.obj-code = p-obj-code
      211         no-lock no-error.
      212         if available cli-obj
      213         then do:
      214            create buf_obj-list.
      215            assign
      216               buf_obj-list.obj-id   = p-var
      217               buf_obj-list.obj-code = cli-obj.obj-code
      218               buf_obj-list.obj-type = cli-obj.obj-type
      219               buf_obj-list.obj-name = cli-obj.obj-name
      220               buf_obj-list.db-num   = cli-obj.db-num
      221            .
      222         end.
      223      end.
      224   end.
