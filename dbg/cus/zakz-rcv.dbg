    12271         .
    12272     run orddocattr-write (
    12273          input v-new-code
    12274         ,input 'cycle-date2':U
    12275         ,input string(buf_ord-doc.date-sale-2, "99/99/9999")) no-error .
    12276         if error-status :error then
    12277         message
    12278           vss-workfile vss-revision vss-description skip
    12279           error-status :get-message(1) skip
    12280           return-value skip
    12281           "Ошибка из orddocattr-write"
    12282           view-as alert-box error
    12283         .
    12284     end.
    12285   end procedure.
    12286   procedure save-ordline :
    12287   define input  parameter p-new-code as character no-undo .
    12288   define input  parameter p-doc-code as character no-undo .
    12289   define input  parameter p-gds-code  as integer   no-undo .
    12290   define input  parameter p-cli-qnty as decimal   no-undo .
    12291   define input  parameter p-order-type as integer   no-undo .
    12292     do
    12293     on error undo, return error return-value
    12294     :
    12295     if p-order-type = 0 then return .
    12296     run ordlineattr-write (
    12297          input p-new-code + chr(4) + p-doc-code
    12298         ,input p-gds-code
    12299         ,input 'cycle-cli-qnty':U
    12300         ,input string(p-cli-qnty)) no-error .
    12301         if error-status :error then
    12302         message
    12303           vss-workfile vss-revision vss-description skip
    12304           error-status :get-message(1) skip
    12305           return-value skip
    12306           "Ошибка из ordlineattr-write"
    12307           view-as alert-box error
    12308         .
    12309     end.
    12310   end procedure.
