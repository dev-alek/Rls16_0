    12178         ,input 'exch-rate':U
    12179         ,input string(buf_ord-doc.exch-rate)) no-error .
    12180         if error-status :error then
    12181         message
    12182           vss-workfile vss-revision vss-description skip
    12183           error-status :get-message(1) skip
    12184           return-value skip
    12185           "Ошибка из orddocattr-write"
    12186           view-as alert-box error
    12187         .
    12188     run orddocattr-write (
    12189          input v-new-code
    12190         ,input 'base-rate':U
    12191         ,input string(buf_ord-doc.base-rate)) no-error .
    12192         if error-status :error then
    12193         message
    12194           vss-workfile vss-revision vss-description skip
    12195           error-status :get-message(1) skip
    12196           return-value skip
    12197           "Ошибка из orddocattr-write"
    12198           view-as alert-box error
    12199         .
    12200     run orddocattr-write (
    12201          input v-new-code
    12202         ,input 'base-scale':U
    12203         ,input string(buf_ord-doc.base-scale)) no-error .
    12204         if error-status :error then
    12205         message
    12206           vss-workfile vss-revision vss-description skip
    12207           error-status :get-message(1) skip
    12208           return-value skip
    12209           "Ошибка из orddocattr-write"
    12210           view-as alert-box error
    12211         .
    12212     run orddocattr-write (
    12213          input v-new-code
    12214         ,input 'cycle-done':U
    12215         ,input "no") no-error .
    12216         if error-status :error then
    12217         message
