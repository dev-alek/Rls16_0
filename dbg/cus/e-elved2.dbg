     1329   field gds-name like ub.goods.gds-name
     1330   index pi
     1331   is unique primary
     1332   gds-code
     1333   .
     1334   define variable State-source as Widget-handle no-undo.
     1335   define variable StrBuf              as character         no-undo.
     1336   define variable Line            as character         no-undo.
     1337   define variable ii                      as  integer     no-undo.
     1338   define variable i as integer no-undo.
     1339   define variable namebuf1     as      character    no-undo.
     1340   define variable namebuf2     as      character    no-undo.
     1341   define variable v-curr-r-b as character no-undo .
     1342   DEFINE BUFFER buf_clients FOR ub.clients.
     1343   DEFINE BUTTON B-cli
     1344        IMAGE-UP FILE "btn-down-arrow":U
     1345        IMAGE-DOWN FILE "btn-down-arrow":U
     1346        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
