     1552   PROCEDURE view-page :
     1553     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1554     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1555         INPUT p-page#).
     1556     END PROCEDURE.
     1557   ON CHOOSE OF B-cli IN FRAME F-Main
     1558   DO:
     1559   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1560   run ref/cli-all.w (
     1561                     INPUT parparentproc
     1562                   , INPUT "b-sel"
     1563                   , INPUT 'орг':U
     1564                   , INPUT 'все':U
     1565                   , INPUT 'текущие':U
     1566                   , INPUT ?
     1567                   , INPUT ",,,,,,NO,,"
     1568                   , INPUT ""
     1569                   , output v-rid-list ) NO-ERROR.
     1570     IF v-rid-list = '':U THEN RETURN NO-APPLY.
     1571     FIND FIRST buf_clients NO-LOCK WHERE
     1572               recid(buf_clients) = integer(ENTRY(1, v-rid-list)) NO-ERROR.
     1573     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1574     ASSIGN
     1575     f-cli-type-code = buf_clients.obj-type + STRING(buf_clients.obj-code)
     1576     f-cli-name = buf_clients.obj-name
     1577     .
     1578     display
     1579     f-cli-type-code
     1580     f-cli-name
     1581     with frame F-Main .
     1582   END.
     1583   if not this-procedure :persistent
     1584   then do:
     1585     message
     1586       vss-workfile vss-revision vss-description skip
     1587       "Ошибка при запуске процедуры" skip
     1588       "Данную процедуру следует запускать только с параметром persistent" skip
     1589       view-as alert-box error .
     1590     undo, return error .
     1591   end.
     1592   PROCEDURE adm-create-objects :
     1593   END PROCEDURE.
     1594   PROCEDURE adm-row-available :
     1595     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1596     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1597     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1598     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1599     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1600     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1601     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1602     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1603     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1604     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1605     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1606     IF adm-updating-record THEN RETURN.
     1607     RUN get-attribute ('FIELDS-ENABLED':U).
     1608     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1609     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1610         OUTPUT link-handle) NO-ERROR.
     1611     IF link-handle = "":U THEN
     1612         RETURN.
     1613     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1614     IF NUM-ENTRIES(link-handle) > 1 THEN
     1615         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1616             "encountered more than one RECORD-SOURCE.":U SKIP
     1617             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1618                VIEW-AS ALERT-BOX ERROR.
     1619     RUN get-attribute ('Key-Name':U).
     1620     key-name = RETURN-VALUE.
     1621     IF key-name = "":U THEN key-name = ?.
     1622     IF key-name NE ? THEN DO:
     1623       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1624         NO-ERROR.
     1625       IF key-value NE ? THEN
     1626         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1627     END.
     1628   IF VALID-HANDLE (adm-object-hdl) THEN
     1629       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1630   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1631   END PROCEDURE.
     1632   PROCEDURE disable_UI :
     1633     HIDE FRAME F-Main.
     1634     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1635   END PROCEDURE.
     1636   PROCEDURE enable_UI :
     1637     DISPLAY f-cli-type-code f-cli-name
     1638         WITH FRAME F-Main.
     1639     ENABLE RECT-client B-cli f-cli-type-code f-cli-name
     1640         WITH FRAME F-Main.
     1641   END PROCEDURE.
     1642   PROCEDURE local-initialize :
     1643     run dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1644   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1646     (output v-curr-r-b
     1647     )  .
     1648     parparentproc = my-handle.
     1649   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1650     run mainmenu_getcntxt in parparentproc
     1651       (output v-cntxt-db-num
     1652       ,output v-cntxt-userid
     1653       ,output v-cntxt-level
     1654       ,output v-cntxt-host-code-obj
     1655       ,output v-cntxt-obj-type
     1656       ,output v-cntxt-obj-code
     1657       ,output v-cntxt-db-num-obj
     1658       ,output v-cntxt-is-admin
     1659       ) .
     1660   END PROCEDURE.
     1661   PROCEDURE My-report :
     1662   define variable v-header-base-curr as character no-undo .
     1663   define variable accum-sum-cli      as decimal no-undo .
     1664   define variable v-d-card           like ub.dis-card.d-card no-undo .
     1665   define variable v-ii as integer no-undo .
     1666   define variable stream-pos as integer no-undo .
     1667   define variable v-root-card like ub.dis-card.d-card no-undo .
     1668   define variable ii as integer no-undo .
     1669   define variable v-base-code like ub.sysconf.base-code no-undo .
     1670   DEFINE VARIABLE v-date-time AS CHARACTER NO-UNDO.
     1671   DEFINE VARIABLE v-obj-name AS CHARACTER NO-UNDO.
     1672   DEFINE VARIABLE v-gds-name AS CHARACTER NO-UNDO.
     1673   define variable v-value as character no-undo .
     1674   define variable v-type as character no-undo .
     1675   define variable v-found as logical no-undo .
     1676   define variable v-account as character no-undo format "X(26)".
     1677   define variable v-car-name as character no-undo format "X(14)".
     1678   define variable v-car-number as character no-undo format "X(16)".
     1679   define variable accum-sum-netto as decimal no-undo .
     1680   define buffer buf_dis-card for ub.dis-card.
     1681   define buffer buf_currency for ub.currency.
     1682   define buffer buf_obj for ub.clients.
     1683   define buffer buf_goods for ub.goods.
     1684   define buffer buf_temp-obj  for temp-obj.
     1685   define buffer buf_temp-goods for temp-goods.
     1686   define buffer buf_Dis-card-property for ub.dis-card-property.
     1687   define buffer card_dcards for dcards.
     1688   define buffer pet_dcards for dcards.
     1689   IF NOT AVAILABLE buf_clients THEN do:
     1690     MESSAGE
     1691     "Не выбран клиент"
     1692      VIEW-AS ALERT-BOX ERROR.
     1693     UNDO, RETURN ERROR.
     1694   END.
     1695   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1697     (input  v-cntxt-host-code-obj
     1698     ,output v-base-code
     1699     )  .
     1700   find first buf_currency where
     1701   buf_currency.curr-code = v-base-code.
     1702   assign
     1703   v-header-base-curr = string( "( Все цены указаны в " +
     1704                               (if v-curr-r-b = 'base':U
     1705                               then caps( trim( buf_currency.curr-abbr ) )
     1706                               else  "РУБ") + " )" )
     1707   .
     1708   DEFINE FRAME X123
     1709   v-date-time COLUMN-LABEL "Время" FORMAT "X(14)"
     1710   V-OBJ-NAME COLUMN-LABEL "АЗС" FORMAT "X(30)"
     1711   dcards.pump COLUMN-LABEL "ТРК" FORMAT ">>9"
     1712   v-gds-name COLUMN-LABEL "НП" FORMAT "X(15)"
     1713   dcards.doc-qnty COLUMN-LABEL "Кол-во" FORMAT "->>>,>>>,>>9.999"
     1714   dcards.price-real COLUMN-LABEL "Цена" FORMAT ">>>,>>>,>>9.99"
     1715   dcards.SUM-netto COLUMN-LABEL "Сумма" FORMAT "->>,>>>,>>>,>>>,>>>,>>9.99"
     1716   HEADER
     1717   cur-time-print() AT 5 format "x(35)"
     1718   v-header-base-curr  format "X(40)" AT 50
     1719   "Страница " AT 100 PAGE-NUMBER( PrnLibStream ) AT 110 FORMAT ">>>>9" SKIP
     1720   Line format "X(134)" AT 1
     1721   with width 136 down stream-io use-text .
     1722   run My-var IN THIS-PROCEDURE.
     1723   assign
     1724   sheetf.Excel-Column-Lable =
     1725   "Время" + chr(44) +
     1726   "АЗС"  + chr(44) +
     1727   "ТРК"  + chr(44) +
     1728   "НП"  + chr(44) +
     1729   "Кол-во" + chr(44) +
     1730   "Цена" + chr(44) +
     1731   "Сумма"
     1732   sheetf.sizes =
     1733   "14" + chr(44) +
     1734   "30"  + chr(44) +
     1735   "4"  + chr(44) +
     1736   "15"  + chr(44) +
     1737   "16"  + chr(44) +
     1738   "16"  + chr(44) +
     1739   "16"
     1740   str3 = " "
     1741   .
     1742   run waitfram-show in this-procedure ( input "Подождите ..." ) .
     1743   run cus/e-elvd2q.p (
     1744                input X-date-Start
     1745               ,input X-date-End
     1746               ,input buf_clients.obj-type
     1747               ,input buf_clients.obj-code
     1748               )
     1749         .
     1750   for each temp-obj:
     1751     delete temp-obj.
     1752   end.
     1753   for each temp-goods:
     1754     delete temp-goods.
     1755   end.
     1756   run waitfram-hide in this-procedure .
     1757   if can-find( first dcards ) then do:
     1758     run rep/extitle.p ( input 1).
     1759     run prn-lib-open-stream  in this-procedure (
     1760                                                   input my-handle
     1761                                                 ,input 62
     1762                                                 ,input yes
     1763                                                 ,input no
     1764                                                 ).
     1765     Line = fill( "-", 136 - 2) .
     1766     FORM HEADER
     1767     Line format "X(134)" AT 1 SKIP
     1768     "Продолжение - на следующей странице" AT 30 SKIP
     1769     with FRAME BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     1770     VIEW stream PrnLibStream FRAME BottomFrame .
     1771     PUT stream PrnLibStream
     1772     space(40)
     1773     "Ведомость клиента" skip
     1774     space(40) str1 format "X(136)" skip(0).
     1775     PUT stream PrnLibStream "" skip .
     1776     PUT stream PrnLibStream space(20) f-cli-name format "x(105)" skip.
     1777     form with frame X123.
     1778     FOR EACH dcards WHERE
     1779         dcards.d-card > '':U
     1780         AND
     1781         dcards.chk-date > 01/01/1990
     1782     break
     1783     by dcards.d-card
     1784     by dcards.chk-date
     1785     by dcards.chk-time
     1786     by dcards.gds-code
     1787     by dcards.obj-type
     1788     by dcards.obj-code:
     1789       if first-of (dcards.d-card) then do:
     1790         assign
     1791           v-account = string(substitute("Счет № &1", dcards.d-card), "X(26)")
     1792         .
     1793         for each buf_Dis-card-property no-lock where
     1794                   buf_dis-card-property.dtm-code = 18
     1795               and buf_dis-card-property.d-card = dcards.d-card
     1796         break
     1797         by buf_dis-card-property.d-card
     1798         by buf_dis-card-property.dt-code
     1799         by buf_dis-card-property.sum-id :
     1800           if first-of( buf_dis-card-property.sum-id ) then do:
     1801             assign
     1802               v-car-name = ""
     1803               v-car-number = ""
     1804             .
     1805           end.
     1806           if buf_dis-card-property.node-code = 2 then do:
     1807             assign
     1808             v-car-name = buf_dis-card-property.property-value-character.
     1809           end.
     1810           if buf_dis-card-property.node-code = 1 then do:
     1811             assign
     1812             v-car-number = buf_dis-card-property.property-value-character.
     1813           end.
     1814           if last-of( buf_dis-card-property.sum-id ) then do:
     1815             display stream PrnLibstream
     1816             v-car-name @ v-date-time
     1817             v-car-number  @ dcards.doc-qnty
     1818             v-account @  dcards.SUM-netto
     1819             with frame X123 .
     1820             down 1 stream prnlibstream
     1821             with frame X123.
     1822             v-found = yes.
     1823             if Make-Excel then  put   stream ForExcel unformatted
     1824             v-car-name CHR(9)
     1825             CHR(9)
     1826             CHR(9)
     1827             CHR(9)
     1828             v-car-number CHR(9)
     1829             CHR(9)
     1830             v-account
     1831             skip.
     1832           end.
     1833         end.
     1834       end.
     1835       find first buf_temp-obj no-lock where
     1836                 buf_temp-obj.obj-type = dcards.obj-type
     1837             and buf_temp-obj.obj-code = dcards.obj-code no-error.
     1838       if not available buf_temp-obj then do:
     1839         find first buf_obj no-lock where
     1840                   buf_obj.obj-type = dcards.obj-type
     1841               and buf_obj.obj-code = dcards.obj-code no-error.
     1842       if available buf_obj then do:
     1843           create buf_temp-obj.
     1844           assign
     1845           buf_temp-obj.obj-type = buf_obj.obj-type
     1846           buf_temp-obj.obj-code = buf_obj.obj-code
     1847           buf_temp-obj.obj-name = buf_obj.obj-name
     1848           .
     1849       end.
     1850       else do:
     1851           create buf_temp-obj.
     1852           assign
     1853           buf_temp-obj.obj-type = dcards.obj-type
     1854           buf_temp-obj.obj-code = dcards.obj-code
     1855           buf_temp-obj.obj-name = substitute("&1&2", dcards.obj-type, dcards.obj-code)
     1856           .
     1857       end.
     1858       end.
     1859       find first buf_temp-goods no-lock where
     1860                 buf_temp-goods.gds-code = dcards.gds-code no-error.
     1861       if not available buf_temp-goods then do:
     1862         find first buf_goods no-lock where
     1863                   buf_goods.gds-code = dcards.gds-code no-error.
     1864       if available buf_goods then do:
     1865           create buf_temp-goods.
     1866           assign
     1867           buf_temp-goods.gds-code = buf_goods.gds-code
     1868           buf_temp-goods.gds-name = buf_goods.gds-name
     1869           .
     1870       end.
     1871       else do:
     1872           create buf_temp-goods.
     1873           assign
     1874           buf_temp-goods.gds-code = dcards.gds-code
     1875           buf_temp-goods.gds-name = substitute("Неизвестный товар с кодом &1", dcards.gds-code)
     1876           .
     1877       end.
     1878       end.
     1879       display stream PrnLibstream
     1880       substitute("&1 &2"
     1881                 ,string(dcards.chk-date, "99.99.99")
     1882                 ,string(dcards.chk-time, "HH:MM")) @ v-date-time
     1883       buf_temp-obj.obj-name @ V-OBJ-NAME
     1884       dcards.pump
     1885       buf_temp-goods.gds-name @ v-gds-name
     1886       dcards.doc-qnty
     1887       dcards.price-real
     1888       dcards.SUM-netto
     1889       with frame X123 .
     1890       down 1 stream prnlibstream
     1891       with frame X123.
     1892       if Make-Excel then  put   stream ForExcel unformatted
     1893       substitute("&1 &2"
     1894                 ,string(dcards.chk-date, "99.99.99")
     1895                 ,string(dcards.chk-time, "HH:MM")) CHR(9)
     1896       buf_temp-obj.obj-name CHR(9)
     1897       dcards.pump CHR(9)
     1898       buf_temp-goods.gds-name CHR(9)
     1899       dcards.doc-qnty CHR(9)
     1900       dcards.price-real CHR(9)
     1901       dcards.SUM-netto
     1902       skip.
     1903       if last-of(dcards.d-card) then do:
     1904         find first card_dcards where
     1905                   card_dcards.d-card = dcards.d-card
     1906               and card_dcards.chk-date = 01/01/1990
     1907               and card_dcards.chk-time = 0
     1908               and card_dcards.obj-type = '':U
     1909               and card_dcards.obj-code = 0
     1910               and card_dcards.gds-code = 0
     1911               and card_dcards.pump = 0
     1912               no-error.
     1913         display stream PrnLibstream
     1914         "ИТОГО:" @ v-gds-name
     1915         (if available card_dcards
     1916         then card_dcards.doc-qnty
     1917         else 0) @ dcards.doc-qnty
     1918         (if available card_dcards
     1919         then card_dcards.sum-netto
     1920         else 0) @ dcards.sum-netto
     1921         with frame X123 .
     1922         down 1 stream prnlibstream
     1923         with frame X123.
     1924         if Make-Excel then  put   stream ForExcel unformatted
     1925         CHR(9)
     1926         CHR(9)
     1927         CHR(9)
     1928         "ИТОГО" CHR(9)
     1929         (if available card_dcards
     1930         then card_dcards.doc-qnty
     1931         else 0)  CHR(9)
     1932         CHR(9)
     1933         (if available card_dcards
     1934         then card_dcards.sum-netto
     1935         else 0)
     1936         skip.
     1937         if available card_dcards then do:
     1938           assign
     1939           accum-sum-netto = accum-sum-netto + card_dcards.sum-netto.
     1940         end.
     1941       end.
     1942     end.
     1943     down 1 stream prnlibstream
     1944     with frame X123.
     1945     Put stream Prnlibstream unformatted
     1946     "Отчет по видам топлива" at 50 skip.
     1947     if Make-Excel then  put   stream ForExcel unformatted
     1948     "Итого" CHR(9)
     1949     CHR(9)
     1950     CHR(9)
     1951     "по видам топлива" skip skip.
     1952     UNDERLINE stream PrnLibStream
     1953     v-gds-name
     1954     dcards.doc-qnty
     1955     dcards.price-real
     1956     dcards.SUM-netto
     1957     with frame X123 .
     1958     display stream PrnLibstream
     1959     "НП" @ v-gds-name
     1960     "Кол-во" @ dcards.doc-qnty
     1961     "Цена" @ dcards.price-real
     1962     "Сумма" @ dcards.SUM-netto
     1963     with frame X123 .
     1964     down 1 stream prnlibstream
     1965     with frame X123.
     1966     if Make-Excel then  put   stream ForExcel unformatted
     1967     CHR(9)
     1968     CHR(9)
     1969     CHR(9)
     1970     "НП" CHR(9)
     1971     "Кол-во" CHR(9)
     1972     "Цена" CHR(9)
     1973     "Сумма"
     1974     skip.
     1975     for each pet_dcards no-lock where
     1976             pet_dcards.cli-type = buf_clients.obj-type
     1977         and pet_dcards.cli-code = buf_clients.obj-code
     1978         and pet_dcards.d-card = '':U
     1979     by pet_dcards.gds-code
     1980     by pet_dcards.price-real:
     1981       find first buf_temp-goods no-lock where
     1982                 buf_temp-goods.gds-code = pet_dcards.gds-code .
     1983       display stream PrnLibstream
     1984       buf_temp-goods.gds-name @ v-gds-name
     1985       pet_dcards.doc-qnty @ dcards.doc-qnty
     1986       pet_dcards.price-real @ dcards.price-real
     1987       pet_dcards.sum-netto @ dcards.SUM-netto
     1988       with frame X123.
     1989       down 1 stream prnlibstream
     1990       with frame X123.
     1991       if Make-Excel then  put   stream ForExcel unformatted
     1992       CHR(9)
     1993       CHR(9)
     1994       CHR(9)
     1995       buf_temp-goods.gds-name CHR(9)
     1996       pet_dcards.doc-qnty CHR(9)
     1997       pet_dcards.price-real CHR(9)
     1998       pet_dcards.sum-netto
     1999       skip.
     2000     end.
     2001     UNDERLINE stream PrnLibStream
     2002     v-gds-name
     2003     dcards.doc-qnty
     2004     dcards.price-real
     2005     dcards.SUM-netto
     2006     with frame X123 .
     2007     DISPLAY stream PrnLibStream
     2008     "Отпущено за период" @ v-gds-name
     2009     accum-sum-netto @ dcards.sum-netto
     2010     with frame X123.
     2011     if Make-Excel then  put   stream ForExcel unformatted
     2012     "ИТОГО"  CHR(9)
     2013     CHR(9)
     2014     CHR(9)
     2015     "Отпущено за период" CHR(9)
     2016     CHR(9)
     2017     CHR(9)
     2018     accum-sum-netto
     2019     skip.
     2020     HIDE stream PrnLibStream FRAME BottomFrame .
     2021     output stream PrnLibStream CLOSE .
     2022     if Make-Excel then output stream ForExcel close.
     2023     run prn-lib-prn-file in this-procedure (
     2024                                               input my-handle
     2025                                               ,input 0
     2026                                               ).
     2027   end.
     2028   else
     2029   message
     2030   "Не было продаж клиенту" skip
     2031   "в течение заданного Вами периода времени."
     2032   view-as alert-box INFORMATION .
     2033   FOR EACH dcards :
     2034     delete dcards .
     2035   END.
     2036   FOR EACH temp-obj :
     2037     delete temp-obj .
     2038   END.
     2039   FOR EACH temp-goods :
     2040     delete temp-goods .
     2041   END.
     2042   END PROCEDURE.
     2043   PROCEDURE My-Var :
     2044   assign
     2045   frame F-Main f-cli-type-code
     2046   f-cli-name
     2047   .
     2048   Assign
     2049    STR-obj-type = ''
     2050    STR-obj-code = ''
     2051    STR-obj-name = ''
     2052    STR-obj      = ''.
     2053   For each obj-list no-lock:
     2054    Assign
     2055    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2056    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2057    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2058    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2059   End.
     2060   Reportname = "Ведомость клиента".
     2061   ReportHeader = substitute("Клиент: &1 &2"
     2062                              , f-cli-type-code
     2063                             , f-cli-name).
     2064   END PROCEDURE.
     2065   PROCEDURE send-records :
     2066   END PROCEDURE.
     2067   PROCEDURE state-changed :
     2068     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2069     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2070   END PROCEDURE.
