     1370            SIZE 58.13 BY 15.21.
     1371   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1372   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1373   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1374   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1375   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1376   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1377   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1378   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1379       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1380   RUN ensure-broker.
     1381   THIS-PROCEDURE:ADM-DATA =
     1382        'ADM1.1~`':U +
     1383        'SmartObject~`':U +
     1384        'FRAME~`':U +
     1385        'NO ~`':U +
     1386        '~`':U +
     1387        '~`':U +
     1388        '~`':U +
     1389        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1390           + "~`":U +
     1391        'Layout,Hide-on-Init~`':U +
     1392        '~`':U +
     1393        '~`':U +
     1394        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1395        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1396            THEN "^^":U
     1397        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1398             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1399   PROCEDURE adm-apply-entry :
     1400     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1401   END PROCEDURE.
     1402   PROCEDURE adm-destroy :
     1403    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1404   END PROCEDURE.
     1405   PROCEDURE adm-disable :
     1406       DISABLE RECT-client B-cli f-cli-type-code f-cli-name WITH FRAME F-Main.
     1407       RUN dispatch ('disable-fields':U).
     1408       RUN set-attribute-list ('ENABLED=no':U).
     1409       RETURN.
     1410   END PROCEDURE.
     1411   PROCEDURE adm-edit-attribute-list :
     1412         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1413         RETURN.
     1414   END PROCEDURE.
     1415   PROCEDURE adm-enable :
     1416       ENABLE UNLESS-HIDDEN RECT-client B-cli f-cli-type-code f-cli-name WITH FRAME F-Main.
     1417       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1418       RUN set-attribute-list ('ENABLED=yes':U).
     1419       RETURN.
     1420   END PROCEDURE.
     1421   PROCEDURE adm-exit :
     1422        RUN notify ('exit':U).
     1423     RETURN.
     1424   END PROCEDURE.
     1425   PROCEDURE adm-hide :
     1426     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1427   END PROCEDURE.
     1428   PROCEDURE adm-initialize :
     1429     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1430   END PROCEDURE.
     1431   PROCEDURE adm-show-errors :
     1432       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1433       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1434           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1435       END.
     1436       RETURN.
     1437   END PROCEDURE.
     1438   PROCEDURE adm-UIB-mode :
