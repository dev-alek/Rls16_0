     1068   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1069   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1070   define variable v-waitfram-action01         as character   no-undo .
     1071   define variable v-waitfram-action02         as character   no-undo .
     1072   define variable v-waitfram-action03         as character   no-undo .
     1073   define variable mWaitFramTextBeg            as character   no-undo.
     1074   define variable mWaitFramTextEnd            as character   no-undo.
     1075   define variable mWaitFramView               as logical     no-undo.
     1076   define variable mWaitProcEvent              as logical     no-undo init yes.
     1077   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1078   define variable mWaitFramStop               as logical     no-undo.
     1079   define variable mWaitFramStopUser           as logical     no-undo.
     1080   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1081   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1082   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1083   define button B-WaitFramStop auto-end-key
     1084        label "Стоп"
     1085        size 10 by 1 tooltip "Остоновить процесс".
     1086   define button B-viewProcInfo
     1087        label "Информация"
     1088        size 15 by 1 tooltip "Информация о процесс".
     1089   define frame waitfram
     1090     v-waitfram-action01 format "x(72)" no-label skip
     1091     v-waitfram-action02 format "x(72)" no-label skip
     1092     v-waitfram-action03 format "x(72)" no-label skip
     1093     B-viewProcInfo
     1094     B-WaitFramStop at row 4 col 30
     1095     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1096     .
     1097   define new global shared variable mBatchMode as logical no-undo init ?.
     1098   define variable mFramBachModHandle as handle no-undo.
     1099   mFramBachModHandle = frame waitfram:handle.
     1100   define variable mFameOldVis as logical no-undo.
     1101   define variable mVisCUrentVin as logical no-undo.
     1102   if session:batch-mode
     1103   then
     1104      mBatchMode = yes.
     1105   if mBatchMode = ? then do:
     1106     mVisCUrentVin = current-window:visible.
     1107     mFameOldVis = mFramBachModHandle:visible.
     1108     mFramBachModHandle:visible  = yes.
     1109     mBatchMode = mFramBachModHandle:visible ne yes.
     1110     mFramBachModHandle:visible = mFameOldVis.
     1111     current-window:visible = mVisCUrentVin.
     1112   end.
     1113    if  log-manager:logfile-name ne ?
     1114     then DO:
     1115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1118     end.
     1119   on choose of B-WaitFramStop in frame waitfram
     1120   do:
     1121     mWaitFramStop = yes.
     1122     mWaitFramStopUser = yes.
     1123   end.
     1124   function waitfram-check-timeout returns logical():
     1125      define variable vtime as int64 no-undo.
     1126      if mWaitFramStopTimeOut
     1127      then
     1128         return yes.
     1129      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1130      if     mWaitFramTimeOut ne ?
     1131         and mWaitFramTimeOut ne 0
     1132         and mWaitFramTimeOut lt vtime
     1133      then do:
     1134         mWaitFramStopTimeOut = yes.
     1135      end.
     1136      return mWaitFramStopTimeOut.
     1137   end.
     1138   procedure waitfram-hide :
     1139     if not session:batch-mode
     1140     then do
     1141     on error undo, return error return-value
     1142     :
     1143       pause 0 before-hide .
     1144       if not mBatchMode then
     1145         hide frame waitfram .
     1146     if     not mWaitFramView
     1147        and mWaitProcEvent
     1148     then
     1149       process events .
     1150     end.
     1151   end procedure.
     1152   procedure waitfram-show :
     1153     define input  parameter p-message as character no-undo .
     1154     define variable v-left-margin as integer   no-undo .
     1155     if not session:batch-mode
     1156     then do
     1157     on error undo, return error return-value
     1158     :
     1159       if length(p-message) <= 70 then do:
     1160         assign
     1161           v-left-margin = integer((70 - length(p-message)) / 2)
     1162         .
     1163         assign
     1164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1165         .
     1166         assign
     1167           v-waitfram-action01 = " "
     1168           v-waitfram-action02 = " "
     1169                                    + fill(" ", v-left-margin)
     1170                                    + p-message
     1171           v-waitfram-action03 = " "
     1172         .
     1173       end.
     1174       else do:
     1175         define variable vRindex1 as integer no-undo.
     1176         define variable vRindex2 as integer no-undo.
     1177         vRindex1 = r-index(p-message," ",70).
     1178         if vRindex1 = 0
     1179         then
     1180            vRindex1 = 70.
     1181         if length(p-message)  <= vRindex1 + 70 then do:
     1182           assign
     1183             v-waitfram-action01 = " "
     1184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1186           .
     1187         end.
     1188         else do:
     1189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1190           if vRindex2 <= vRindex1
     1191           then
     1192              vRindex2 = vRindex1 + 70.
     1193           assign
     1194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1197           .
     1198         end.
     1199       end.
     1200       B-viewProcInfo:visible   in frame waitfram = no.
     1201       B-viewProcInfo:sensitive in frame waitfram = no.
     1202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1204       if  (   mWaitFramView
     1205          or  mWaitProcEvent)
     1206          and not mBatchMode
     1207       then
     1208          display
     1209             v-waitfram-action01 skip
     1210             v-waitfram-action02 skip
     1211             v-waitfram-action03 skip
     1212          with frame waitfram .
     1213       if     mWaitFramView
     1214          then do:
     1215             if     mWaitFramInterval ne ?
     1216                and not mBatchMode
     1217             then
     1218                wait-for go of frame waitfram pause mWaitFramInterval.
     1219          end.
     1220          else
     1221             if     mWaitProcEvent
     1222                and not mBatchMode
     1223             then
     1224                process events .
     1225     end.
     1226   end procedure.
     1227      procedure waitfram-show-this:
     1228         define input  parameter iInterval as int64 no-undo.
     1229         define variable vtime as int64 no-undo.
     1230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1231         mWaitFramInterval = iInterval.
     1232         run waitfram-show (substitute("&1&2 &3&4" ,
     1233                                       mWaitFramTextBeg ,
     1234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1236                                       mWaitFramTextEnd
     1237                                      )
     1238                           ).
     1239      end.
     1240      procedure WaitFramRunPause:
     1241         define input  parameter iInterval as dec no-undo.
     1242         define variable vStart  as datetime-tz no-undo.
     1243         define variable vend    as datetime-tz no-undo.
     1244         define variable vint as int64 no-undo.
     1245         define variable vOk as logical no-undo.
     1246         vStart = now.
     1247         vend   = vStart.
     1248         publish "WaitFramPause" (iInterval,output vOk).
     1249         vend   =  now.
     1250         vint = vend - vStart.
     1251         vint = iInterval - vint / 1000.
     1252         if     not mWaitFramStop
     1253            and (   vint > 0
     1254                 or (    not vOk
     1255                     and iInterval eq ?
     1256                     )
     1257                 )
     1258         then
     1259            run waitfram-show-this (iInterval).
     1260         vend   =  now.
     1261         vint = vend - vStart.
     1262         vint = iInterval - vint / 1000.
     1263         if     not mWaitFramStop
     1264            and vint > 0
     1265         then do:
     1266            run gbl/pause.p (vint * 1000).
     1267         end.
     1268         if iInterval ne ?
     1269         then
     1270            publish "WaitFramStop".
     1271         waitfram-check-timeout().
     1272      end.
     1273      procedure WaitFramWaitFor:
     1274         define input  parameter iInterval as dec no-undo.
     1275         assign
     1276            mWaitFramStartProc   = now
     1277            mWaitFramStopUser    = no
     1278            mWaitFramStopTimeOut = no
     1279         .
     1280         block-wait:
     1281         do while not mWaitFramStop:
     1282            run WaitFramRunPause (iInterval).
     1283            if  waitfram-check-timeout()
     1284            then do:
     1285               leave block-wait.
     1286            end.
     1287         end.
     1288         run waitfram-hide.
     1289      end.
     1290   procedure waitfram-join :
     1291     define input  parameter p-line-1  as character no-undo .
     1292     define input  parameter p-line-2  as character no-undo .
     1293     define input  parameter p-line-3  as character no-undo .
     1294     define output parameter p-message as character no-undo .
     1295     do
     1296     on error undo, return error return-value
     1297     :
     1298       assign
     1299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1302       .
     1303     end.
     1304   end procedure.
     1305   function waitfram-join-function returns character
     1306     (input p-line-1 as character
     1307     ,input p-line-2 as character
     1308     ,input p-line-3 as character
     1309     ).
     1310     define variable v-message as character no-undo .
     1311     run waitfram-join in this-procedure
     1312       (input  p-line-1
     1313       ,input  p-line-2
     1314       ,input  p-line-3
     1315       ,output v-message
     1316       ) .
     1317     return v-message .
     1318   end function .
     1319   define temp-table temp-obj no-undo
