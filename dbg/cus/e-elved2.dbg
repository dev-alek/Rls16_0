     1443   END PROCEDURE.
     1444   PROCEDURE dispatch :
     1445       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1446       RUN broker-dispatch IN adm-broker-hdl
     1447           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1448       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1449   END PROCEDURE.
     1450   PROCEDURE ensure-broker :
     1451   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1452   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1453   DO:
     1454       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1455       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1456   END.
     1457   END PROCEDURE.
     1458   PROCEDURE get-attribute :
     1459     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1460     RUN broker-get-attribute IN adm-broker-hdl
     1461         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1462     RETURN RETURN-VALUE.
     1463   END PROCEDURE.
     1464   PROCEDURE get-attribute-list :
     1465     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1466     RUN broker-get-attribute-list IN adm-broker-hdl
     1467         (INPUT THIS-PROCEDURE,
     1468          INPUT ?,
     1469          OUTPUT p-attr-list) NO-ERROR.
     1470     RETURN.
     1471   END PROCEDURE.
     1472   PROCEDURE new-state :
     1473     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1474     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1475     RETURN.
     1476   END PROCEDURE.
     1477   PROCEDURE notify :
     1478     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1479     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1480     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1481         RETURN "ADM-ERROR":U.
     1482     RETURN.
     1483   END PROCEDURE.
     1484   PROCEDURE set-attribute-list :
     1485     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1486     RUN ensure-broker.
     1487     RUN broker-set-attribute-list IN adm-broker-hdl
     1488         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1489     RETURN.
     1490   END PROCEDURE.
     1491   PROCEDURE set-position :
     1492       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1493       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1494       IF VALID-HANDLE(adm-object-hdl) THEN
     1495       DO:
     1496           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1497           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1498           DO:
     1499             IF p-row = 0 THEN p-row =
     1500               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1501             IF p-col = 0 THEN p-col =
     1502               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1503           END.
     1504           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1505           DO:
     1506             parent-hdl = adm-object-hdl:PARENT.
     1507             IF p-row = 0 THEN p-row =
     1508               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1509                 parent-hdl:ROW.
     1510             IF p-col = 0 THEN p-col =
     1511               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1512                 parent-hdl:COL.
     1513           END.
     1514           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1515           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1516         ASSIGN adm-object-hdl:ROW    =   p-row
     1517                adm-object-hdl:COLUMN =   p-col.
     1518       END.
     1519       RETURN.
     1520   END PROCEDURE.
     1521   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1522       STRING(adm-object-hdl)).
     1523   PAUSE 0 BEFORE-HIDE.
