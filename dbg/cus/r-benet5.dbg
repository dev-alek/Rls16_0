     1283   procedure run1 :
     1284          case select-good :
     1285           when 1  then do:
     1286   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1288       for each gds-obj  where
     1289             gds-obj.obj-type = x-store-type  and
     1290             gds-obj.obj-code = x-store-code
     1291             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1292                   no-lock,
     1293             First goods  where  gds-obj.gds-code   = goods.gds-code
     1294   no-lock
     1295   BREAK
     1296       BY (temp-gds-list.artic) :
     1297         run item-goods ( "1" , "goods" ) .
     1298         if return-value <> "" then NEXT.
     1299       End.
     1300     END.
     1301     Else DO:
     1302      For each obj-list no-lock :
     1303                     FOR EACH gds-obj where
     1304                   gds-obj.obj-type = obj-list.obj-type    and
     1305                   gds-obj.obj-code = obj-list.obj-code
     1306                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1307                   no-lock :
     1308                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1309                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1310                       Create temp-gds-list.
     1311                       Assign
     1312                         temp-gds-list.prod-code = gds-obj.prod-code
     1313                         temp-gds-list.grp-name  = gds-obj.grp-name
     1314                         temp-gds-list.gds-name  = goods.gds-name
     1315                         temp-gds-list.gds-code  = gds-obj.gds-code
     1316                         temp-gds-list.artic     = gds-obj.artic
     1317                       .
     1318                   End.
     1319               End.
     1320     End.
     1321     for each temp-gds-list no-lock
     1322       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     1323         BREAK
     1324       BY temp-gds-list.artic :
     1325       run item-goods ( "1" , "goods" ) .
     1326         if return-value <> "" then NEXT.
     1327     End.
     1328   End.
     1329     end.
     1330           when 2  then do:
     1331   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1332     if x-selectobject = "currency":u  or  xtog-obj then do:
     1333         for  each gds-obj
     1334                     where gds-obj.obj-code   = x-store-code
     1335                      and  gds-obj.obj-type   = x-store-type
     1336                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1337                           no-lock ,
     1338                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1339                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     1340                     break
     1341                     by temp-gds-list.artic :
     1342                     run item-goods ( input "1" , input "goods" ) .
     1343                     if return-value <> "" then next.
     1344         end.
     1345     end.
     1346     else do:
     1347         for each obj-list no-lock :
     1348               for  each gds-obj
     1349                 where  gds-obj.obj-code   = obj-list.obj-code
     1350                   and  gds-obj.obj-type   = obj-list.obj-type
     1351                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1352                 no-lock ,
     1353                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1354                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     1355                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1356                           create temp-gds-list.
     1357                           assign
     1358                             temp-gds-list.prod-code = gds-obj.prod-code
     1359                             temp-gds-list.grp-name  = gds-obj.grp-name
     1360                             temp-gds-list.gds-name  = goods.grp-name
     1361                             temp-gds-list.gds-code  = gds-obj.gds-code
     1362                             temp-gds-list.artic     = gds-obj.artic
     1363                           .
     1364                       end.
     1365               end.
     1366       end.
     1367     for each temp-gds-list no-lock
     1368       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     1369         break
     1370       by temp-gds-list.artic :
     1371       run item-goods ( "1" , "goods" ) .
     1372         if return-value <> "" then next.
     1373     end.
     1374   end.
     1375     end.
     1376           when 3 then do:
     1377   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1378   if x-selectobject = "currency":u  or  xtog-obj then do:
     1379     for  each gds-obj
     1380         where  gds-obj.obj-code   = x-store-code
     1381           and  gds-obj.obj-type   = x-store-type
     1382                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1383                 no-lock ,
     1384     first g#cli
     1385           where gds-obj.prod-code  = g#cli.obj-code
     1386           and  gds-obj.prod-type   = g#cli.obj-type
     1387           no-lock,
     1388     first goods
     1389           where gds-obj.gds-code = goods.gds-code no-lock
     1390           break
     1391           by temp-gds-list.artic :
     1392           run item-goods ( "1" , "goods" ) .
     1393           if return-value <> "" then next.
     1394         end.
     1395     end.
     1396     else do:
     1397       for each obj-list no-lock :
     1398             for  each gds-obj
     1399               where  gds-obj.obj-code   = obj-list.obj-code
     1400                 and  gds-obj.obj-type   = obj-list.obj-type
     1401                       and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1402                       no-lock ,
     1403             first g#cli
     1404                 where gds-obj.prod-code  = g#cli.obj-code
     1405                 and  gds-obj.prod-type   = g#cli.obj-type
     1406                 no-lock,
     1407             first goods
     1408                 where gds-obj.gds-code = goods.gds-code no-lock :
     1409                   if not can-find (first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1410                       create temp-gds-list.
     1411                       assign
     1412                         temp-gds-list.prod-code = gds-obj.prod-code
     1413                         temp-gds-list.grp-name  = gds-obj.grp-name
     1414                         temp-gds-list.gds-name  = goods.gds-name
     1415                         temp-gds-list.gds-code  = gds-obj.gds-code
     1416                         temp-gds-list.artic     = gds-obj.artic
     1417                       .
     1418                   end.
     1419             end.
     1420       end.
     1421         for each temp-gds-list no-lock
     1422           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     1423             break
     1424               by temp-gds-list.artic :
     1425           run item-goods ( "1" , "goods" ) .
     1426             if return-value <> "" then next.
     1427         end.
     1428   end.
     1429     end.
     1430           otherwise do:
     1431   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1432   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1433       for each gds-obj  where
     1434             gds-obj.obj-type = x-store-type  and
     1435             gds-obj.obj-code = x-store-code
     1436             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1437                   no-lock,
     1438             First goods  where  gds-obj.gds-code   = goods.gds-code
     1439         no-lock,
     1440   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     1441   no-lock
     1442   BREAK
     1443       BY (gds-list.artic) :
     1444         run item-goods ( "1" , "gds-list" ) .
     1445         if return-value <> "" then NEXT.
     1446       End.
     1447     END.
     1448     Else DO:
     1449      For each obj-list no-lock :
     1450                     FOR EACH gds-obj where
     1451                   gds-obj.obj-type = obj-list.obj-type    and
     1452                   gds-obj.obj-code = obj-list.obj-code
     1453                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1454                   no-lock,
     1455             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     1456                   no-lock :
     1457                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1458                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1459                       Create temp-gds-list.
     1460                       Assign
     1461                         temp-gds-list.prod-code = gds-obj.prod-code
     1462                         temp-gds-list.grp-name  = gds-obj.grp-name
     1463                         temp-gds-list.gds-name  = goods.gds-name
     1464                         temp-gds-list.gds-code  = gds-obj.gds-code
     1465                         temp-gds-list.artic     = gds-obj.artic
     1466                       .
     1467                   End.
     1468               End.
     1469     End.
     1470     for each temp-gds-list no-lock
     1471       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     1472         BREAK
     1473       BY gds-list.artic :
     1474       run item-goods ( "1" , "gds-list" ) .
     1475         if return-value <> "" then NEXT.
     1476     End.
     1477   End.
     1478           end.
     1479          end case.
     1480   end procedure.
     1481   procedure ost-line :
     1482     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1483     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1484     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1485     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1486     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1487     define input  parameter x-tog-shift  as logical no-undo .
     1488     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1489     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1490     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1491     define input  parameter xtog-obj     as logical no-undo .
     1492     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1493     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1494     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1495     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1496     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1497     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1498     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1499     define buffer buff-obj-list  for obj-list .
     1500     define buffer buff-stk-line  for ub.stk-line .
     1501     assign
     1502       Quantity = 0
     1503       Coast_R  = 0
     1504       Coast_V  = 0
     1505       VAT_R    = 0
     1506       VAT_V    = 0
     1507       SLT_R    = 0
     1508       SLT_V    = 0
     1509     .
     1510     if  x-tog-shift = false then do:
     1511       for each buff-obj-list no-lock
     1512         where xtog-obj = false
     1513            or (buff-obj-list.obj-type = x-store-type
     1514               and buff-obj-list.obj-code = x-store-code
     1515               )
     1516       on error undo, return error
     1517       :
     1518       find last buff-stk-line no-lock
     1519         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1520           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1521           and buff-stk-line.artic      = x-artic
     1522           and buff-stk-line.prod-type  = x-prod-type
     1523           and buff-stk-line.prod-code  = x-prod-code
     1524           and buff-stk-line.sum-type   = x-sum-type
     1525           and buff-stk-line.cat-id     = '##,##':U
     1526           and buff-stk-line.fact-order <= x-fact-order
     1527           and buff-stk-line.shift-num  = 0
     1528         use-index category
     1529         no-error .
     1530       if available buff-stk-line then do:
     1531         assign
     1532           Quantity = Quantity + buff-stk-line.fact-qnty
     1533           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1534           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1535           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1536           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1537           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1538           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1539         .
     1540       end.
     1541      end.
     1542     end.
     1543     else do:
     1544       for each buff-obj-list no-lock
     1545         where xtog-obj = false
     1546            or (buff-obj-list.obj-type = x-store-type
     1547               and buff-obj-list.obj-code = x-store-code
     1548               )
     1549       on error undo, return error
     1550       :
     1551         find last buff-stk-line no-lock
     1552           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1553             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1554             and buff-stk-line.artic      = x-artic
     1555             and buff-stk-line.prod-type  = x-prod-type
     1556             and buff-stk-line.prod-code  = x-prod-code
     1557             and buff-stk-line.sum-type   = x-sum-type
     1558             and buff-stk-line.cat-id     = '##,##':U
     1559             and buff-stk-line.fact-order <= x-fact-order
     1560             and buff-stk-line.shift-num  > 0
     1561           use-index category
     1562           no-error .
     1563         if available buff-stk-line then do:
     1564           assign
     1565             Quantity = Quantity +  buff-stk-line.fact-qnty
     1566             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1567             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1568             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1569             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1570             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1571             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1572           .
     1573         end.
     1574       end.
     1575     end.
     1576   end procedure.
     1577   procedure ost-lineother-tax :
     1578     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1579     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1580     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1581     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1582     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1583     define input  parameter x-tog-shift  as logical no-undo .
     1584     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1585     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1586     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1587     define input  parameter xTog-obj     as logical no-undo .
     1588     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1589     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1590     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1591     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1592     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1593     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1594     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1595     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1596     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1597     define buffer buff-obj-list  for obj-list .
     1598     define buffer buff-stk-line  for ub.stk-line .
     1599     assign
     1600       Quantity = 0
     1601       Coast_R  = 0
     1602       Coast_V  = 0
     1603       VAT_R    = 0
     1604       VAT_V    = 0
     1605       SLT_R    = 0
     1606       SLT_V    = 0
     1607       other_R  = 0
     1608       other_V  = 0
     1609     .
     1610     if  x-tog-shift = false then do:
     1611       for each buff-obj-list no-lock
     1612         where xtog-obj = false
     1613            or (buff-obj-list.obj-type = x-store-type
     1614               and buff-obj-list.obj-code = x-store-code
     1615               )
     1616       on error undo, return error
     1617       :
     1618       find last buff-stk-line no-lock
     1619         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1620           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1621           and buff-stk-line.artic      = x-artic
     1622           and buff-stk-line.prod-type  = x-prod-type
     1623           and buff-stk-line.prod-code  = x-prod-code
     1624           and buff-stk-line.sum-type   = x-sum-type
     1625           and buff-stk-line.cat-id     = '##,##':U
     1626           and buff-stk-line.fact-order <= x-fact-order
     1627           and buff-stk-line.shift-num  = 0
     1628         use-index category
     1629         no-error .
     1630       if available buff-stk-line then do:
     1631         assign
     1632           Quantity = Quantity + buff-stk-line.fact-qnty
     1633           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1634           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1635           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1636           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1637           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1638           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1639           other_R  = other_R  + buff-stk-line.other-rubl
     1640           other_V  = other_V  + buff-stk-line.other-base
     1641         .
     1642       end.
     1643    end.
     1644     end.
     1645     else do:
     1646       for each buff-obj-list no-lock
     1647         where xtog-obj = false
     1648            or (buff-obj-list.obj-type = x-store-type
     1649               and buff-obj-list.obj-code = x-store-code
     1650               )
     1651       on error undo, return error
     1652       :
     1653         find last buff-stk-line no-lock
     1654           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1655             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1656             and buff-stk-line.artic      = x-artic
     1657             and buff-stk-line.prod-type  = x-prod-type
     1658             and buff-stk-line.prod-code  = x-prod-code
     1659             and buff-stk-line.sum-type   = x-sum-type
     1660             and buff-stk-line.cat-id     = '##,##':U
     1661             and buff-stk-line.fact-order <= x-fact-order
     1662             and buff-stk-line.shift-num  > 0
     1663           use-index category
     1664           no-error .
     1665         if available buff-stk-line then do:
     1666           assign
     1667             Quantity = Quantity +  buff-stk-line.fact-qnty
     1668             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1669             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1670             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1671             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1672             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1673             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1674             other_R = other_R   +  buff-stk-line.other-rubl
     1675             other_V = other_V   +  buff-stk-line.other-base
     1676           .
     1677         end.
     1678       end.
     1679     end.
     1680   end procedure.
     1681   procedure ost-line-kg :
     1682     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1683     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1684     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1685     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1686     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1687     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1688     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1689     define buffer buff-obj-list  for obj-list .
     1690     define buffer buf_doc-line for ub.doc-line .
     1691     define buffer buf_inv-line for ub.inv-line .
     1692     do
     1693     on error undo, return error
     1694     :
     1695       for each buf_doc-line no-lock where
     1696                buf_doc-line.obj-type    = p-obj-type   and
     1697                buf_doc-line.obj-code    = p-obj-code   and
     1698                buf_doc-line.prod-type   = p-prod-type  and
     1699                buf_doc-line.prod-code   = p-prod-code  and
     1700                buf_doc-line.artic       = p-artic      and
     1701                buf_doc-line.status_     = 'факт':U      and
     1702                buf_doc-line.fact-order <= p-fact-order
     1703             by buf_doc-line.fact-order    descending
     1704       :
     1705         find first buf_inv-line no-lock where
     1706                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1707                    buf_inv-line.artic     = buf_doc-line.artic     and
     1708                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1709                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1710         if available buf_inv-line
     1711         then do:
     1712           if buf_inv-line.after-cli-qnty <> ?
     1713           then do:
     1714             assign
     1715               p-quantity-kg = buf_inv-line.after-cli-qnty
     1716             .
     1717             leave .
     1718           end.
     1719         end.
     1720       end.
     1721       if p-quantity-kg = ?
     1722       then do:
     1723         assign
     1724           p-quantity-kg = 0
     1725         .
     1726       end.
     1727     end.
     1728   end procedure.
     1729   PROCEDURE ostatok :
     1730   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1731   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1732   def input parameter x-tog-shift   as   logical             no-undo.
     1733   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1734   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1735   def input parameter x-shift-start as integer               no-undo.
     1736   def input parameter x-shift-end   as integer               no-undo.
     1737   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1738   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1739   def input parameter xTog-obj   as log no-undo.
     1740   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1741   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1742   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1743   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1744   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1745   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1746   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1747   def var              Fact-orderS   as char  no-undo.
     1748   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1749      Assign
     1750         Fact-order   = 0
     1751         Quantity     = 0
     1752         Coast_R      = 0
     1753         Coast_V      = 0
     1754         VAT_R        = 0
     1755         VAT_V        = 0 .
     1756    x-date-start-t  = x-date-start + 1 .
     1757   IF x-date-end = date('') then DO:
     1758      Fact-order = 0 .
     1759      for each obj-list
     1760          where  ( not xtog-obj or
     1761                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1762                 no-lock :
     1763         if  x-tog-shift = false then do:
     1764                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1765                               ub.stk-tot.Fact-date <=  x-date-start
     1766                               and ub.stk-tot.shift-num = 0
     1767                               USE-INDEX fact-date no-lock no-error .
     1768              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1769         End.
     1770         Else  DO :
     1771             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1772              (ub.stk-tot.shift-date  = x-date-start-t and
     1773               ub.stk-tot.shift-num  < x-shift-start or
     1774               ub.stk-tot.shift-date  < x-date-start-t  )
     1775               and ub.stk-tot.shift-num  > 0
     1776               USE-INDEX Shift-num no-lock no-error .
     1777            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1778           END.
     1779       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1780     End.
     1781   End.
     1782   Else DO:
     1783     For each obj-list  WHERE
     1784        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1785         no-lock :
     1786      IF  x-TOG-Shift = False Then DO:
     1787          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1788               ub.stk-tot.Fact-date <= x-date-end
     1789               and ub.stk-tot.shift-num = 0
     1790               USE-INDEX fact-date no-lock no-error.
     1791          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1792      END.
     1793      Else DO:
     1794           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1795               (ub.stk-tot.shift-date  = x-date-end and
     1796               ub.stk-tot.shift-num  <= x-shift-end or
     1797               ub.stk-tot.shift-date  < x-date-end       ) and
     1798               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1799               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1800       End.
     1801       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1802     End.
     1803   End.
     1804   END PROCEDURE.
     1805   PROCEDURE report-execute :
     1806     If (ValType = 0 and var-report-r-b = 'rubl' )  Or ValType = 1
     1807                                   then   assign tPrintRubl = yes .
     1808                                   else   assign tPrintRubl = no .
     1809     run waitfram-show ( 'Подождите ...' ) .
     1810     output stream OutStream to value( string( session:temp-directory +
     1811                               "rpt" + string( g#report-num ) ) )      .
     1812      run report-exec1.
     1813      Output stream OutStream close.
     1814      run waitfram-hide.
     1815     if Make-Excel then output stream ForExcel close.
     1816     run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1817   END PROCEDURE.
     1818   PROCEDURE foreach :
     1819   define variable tt# as integer no-undo .
     1820   define buffer buf-obj-list  for obj-list .
     1821    R = R + 1.
     1822   If Integer(25) = 0 Then Temp1  = 100  .
     1823                         Else Temp1 = Integer(25) .
     1824        IF ( R modulo Temp1 = 0 ) AND ( R >= Temp1 ) then
     1825            RUN waitfram-show( "Обработано строк : " + string( R )) .
     1826     run clear-item.
     1827    tt# = 0 .
     1828   define variable gds-zap-b-code-ed as integer no-undo .
     1829      if flag-dop-bc = true then do:
     1830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1831     (input  gds-zap-b-code
     1832     ,input  ?
     1833     ,output gds-zap-b-code-ed
     1834     )  .
     1835         v-dop-bc = ""   .
     1836           for each ub.prod-bc no-lock where
     1837               ub.prod-bc.b-code = gds-zap-b-code-ed
     1838               on error undo, return error :
     1839               v-dop-bc = v-dop-bc + ub.prod-bc.b-str + chr(44) .
     1840           end.
     1841           v-dop-bc = substring(v-dop-bc, 1 , length(v-dop-bc) - 1 ) .
     1842      end.
     1843   For each  buf-obj-list no-lock :
     1844     run ost-line (  input   buf-obj-list.obj-code ,
     1845                     input   buf-obj-list.obj-type ,
     1846                     INPUT   gds-zap-artic     ,
     1847                     INPUT   gds-zap-prod-code ,
     1848                     INPUT   gds-zap-prod-type ,
     1849                     input   x-tog-shift       ,
     1850                     INPUT   fact-order-2      ,
     1851                     input   type-a       ,
     1852                     input   '##,##':U    ,
     1853                     input   true        ,
     1854                     output  Quantity    ,
     1855                     output  Coast_R     ,
     1856                     output  Coast_V     ,
     1857                     output  VAT_R       ,
     1858                     output  VAT_V       ,
     1859                     output  SLT_R       ,
     1860                     output  SLT_V       ) .
     1861      If not can-find  (tmp#obj-list where
     1862         buf-obj-list.obj-code = tmp#obj-list.obj-code and
     1863         buf-obj-list.obj-type = tmp#obj-list.obj-type  ) then do:
     1864               create tmp#obj-list.
     1865               Assign
     1866                 tmp#obj-list.obj-code = buf-obj-list.obj-code
     1867                 tmp#obj-list.obj-type = buf-obj-list.obj-type .
     1868           End.
     1869     Find first tmp#obj-list where
     1870         buf-obj-list.obj-code = tmp#obj-list.obj-code and
     1871         buf-obj-list.obj-type = tmp#obj-list.obj-type
     1872     share-lock no-error .
     1873     Assign
     1874     tmp#obj-list.ostatok-end [1 + tt#]  = Quantity
     1875     tmp#obj-list.ostatok-end [2 + tt#]  = if tprintrubl then Coast_R else Coast_V
     1876     tmp#obj-list.b1-ostatok-end [1 + tt# ] =  tmp#obj-list.b1-ostatok-end [1 + tt#] + tmp#obj-list.ostatok-end [1 + tt#]
     1877     tmp#obj-list.b1-ostatok-end [2 + tt# ] =  tmp#obj-list.b1-ostatok-end [2 + tt#] + tmp#obj-list.ostatok-end [2 + tt#]
     1878     tmp#obj-list.bi-ostatok-end [1 + tt# ] =  tmp#obj-list.bi-ostatok-end [1 + tt#] + tmp#obj-list.ostatok-end [1 + tt#]
     1879     tmp#obj-list.bi-ostatok-end [2 + tt# ] =  tmp#obj-list.bi-ostatok-end [2 + tt#] + tmp#obj-list.ostatok-end [2 + tt#]
     1880     .
     1881   End.
     1882   END PROCEDURE.
     1883   PROCEDURE display-line :
     1884           IF NOT Sums-Only then DO:
     1885              ii = ii + 1.
     1886              run display-str1.
     1887             End.
     1888     END PROCEDURE.
     1889   PROCEDURE print-header :
     1890   if NOT FirstLine Then  run display-title.
     1891       FirstLine = TRUE .
     1892         run clear-b1 .
     1893         run clear-bi .
     1894         run clear-item.
     1895         break_group = true.
     1896         break_group1 = true.
     1897      END PROCEDURE.
     1898   PROCEDURE Print-Footer :
     1899          gds-zap-artic = "ИТОГО" .
     1900          run display-bi.
     1901          END PROCEDURE.
     1902   PROCEDURE U-LINE :
     1903           END PROCEDURE.
     1904   PROCEDURE P-LINE :
     1905           END PROCEDURE.
     1906   PROCEDURE CalcItog :
     1907       run ostatok (
     1908           input x-store-code  ,
     1909           input x-store-type  , x-TOG-Shift,
     1910           input x-date-start - 1 ,
     1911           input date('')      , x-Shift-Start,x-Shift-End,
     1912           input type-a   ,
     1913           input '##,##':U,
     1914           input xTog-obj ,
     1915           output  Quantity1  ,
     1916           output  Coast_R1   ,
     1917           output  Coast_V1   ,
     1918           output  VAT_R1     ,
     1919           output  VAT_V1     ,
     1920           output  Fact-order-1 ).
     1921       run ostatok (
     1922           input x-store-code  ,
     1923           input x-store-type  ,x-TOG-Shift,
     1924           input x-date-start  ,
     1925           input x-date-end    , x-Shift-Start,x-Shift-End,
     1926           input type-a   ,
     1927           input '##,##':U,
     1928           input xTog-obj ,
     1929           output  Quantity1  ,
     1930           output  Coast_R1   ,
     1931           output  Coast_V1   ,
     1932           output  VAT_R1     ,
     1933           output  VAT_V1     ,
     1934           output  Fact-order-2 ).
     1935             Quantity1  = 0.
     1936             Coast_R1   = 0.
     1937             Coast_V1   = 0.
     1938             VAT_R1     = 0.
     1939             VAT_V1     = 0.
     1940   END PROCEDURE.
     1941   PROCEDURE display-str1  :
     1942              run di ("кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     1943   END PROCEDURE.
     1944   PROCEDURE display-Bi  :
     1945      v-dop-bc = ""     .
     1946      run di ("кол-во",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     1947   END PROCEDURE.
     1948   PROCEDURE display-B1  :
     1949      v-dop-bc = ""     .
     1950      run di ("кол-во"  ,1, (s-bar-code + " " + caps( gds-zap-artic + gds-zap-gds-name)), "" ,"","","b1":u).
     1951   END PROCEDURE.
     1952   PROCEDURE Clear-B1  :
     1953    For each tmp#obj-list  :
     1954       REPEAT kk = 1 to 6 :
     1955        tmp#obj-list.b1-ostatok-end    [kk]    = 0
     1956        .
     1957       End.
     1958     End.
     1959    END PROCEDURE.
     1960   PROCEDURE Clear-B2  :
     1961    For each tmp#obj-list :
     1962       REPEAT kk = 1 to 6 :
     1963        tmp#obj-list.b1-ostatok-end    [kk]    = 0
     1964        .
     1965       End.
     1966     End.
     1967   END PROCEDURE.
     1968   PROCEDURE Clear-Bi  :
     1969    For each tmp#obj-list :
     1970       REPEAT kk = 1 to 6 :
     1971        tmp#obj-list.bi-ostatok-end    [kk]    = 0
     1972        .
     1973       End.
     1974     End .
     1975   END PROCEDURE.
     1976   PROCEDURE Display-title :
     1977       i = 0.
     1978       run rep/extitle.p (1) .
     1979   END PROCEDURE.
     1980   PROCEDURE report-exec1  :
     1981      FIND FIRST clients where x-store-type = clients.obj-type AND
     1982                               x-store-code = clients.obj-code no-lock no-error.
     1983              If available clients then  ObjName = clients.obj-name.
     1984                                            else  ObjName="объект не определен".
     1985     run calcitog.
     1986     run print-header.
     1987      CASE RetClassify :
     1988       when "no-classify":u  then            run run1.
     1989       otherwise do:
     1990         message "Ошибка вызова!" view-as alert-box error .
     1991       end.
     1992      end case.
     1993      run print-footer.
     1994     END PROCEDURE.
     1995   PROCEDURE Clear-item :
     1996    For each tmp#obj-list :
     1997       REPEAT kk = 1 to 6 :
     1998        ostatok-end                                     [kk]    = 0
     1999        .
     2000       End.
     2001     End.
     2002    END PROCEDURE.
     2003   PROCEDURE Item-Goods :
     2004    define input parameter  par-3 as character  no-undo.
     2005    define input parameter  par-4 as character  no-undo.
     2006         if par-4 = "goods":U  Then DO:
     2007             FIND FIRST clients WHERE clients.obj-type = Goods.prod-type AND
     2008                                 clients.obj-code = Goods.prod-code use-index pi NO-LOCK .
     2009                                   assign
     2010                                       gds-zap-unit-base  = Goods.unit-base
     2011                                       gds-zap-prt-root   = Goods.prt-root
     2012                                       gds-zap-prod-type  = Goods.prod-type
     2013                                       gds-zap-prod-code  = Goods.prod-code
     2014                                       gds-zap-artic      = Goods.artic
     2015                                       gds-zap-grp-name   = Goods.grp-name
     2016                                       gds-zap-b-code     = Goods.gds-code
     2017                                       gds-zap-prod-name  = clients.obj-name .
     2018                                   if g#gds-engl then
     2019                                       assign gds-zap-gds-name = Goods.engl-name.
     2020                                   else
     2021                                       assign gds-zap-gds-name = Goods.gds-name.
     2022                               End.
     2023        if par-4 = "gds-list":U  Then DO:
     2024             FIND FIRST clients WHERE clients.obj-type = gds-list.prod-type AND
     2025                                 clients.obj-code = gds-list.prod-code use-index pi NO-LOCK .
     2026                                   assign
     2027                                       gds-zap-unit-base  = gds-list.unit-base
     2028                                       gds-zap-prt-root   = gds-list.prt-root
     2029                                       gds-zap-prod-type  = gds-list.prod-type
     2030                                       gds-zap-prod-code  = gds-list.prod-code
     2031                                       gds-zap-artic      = gds-list.artic
     2032                                       gds-zap-grp-name   = gds-list.grp-name
     2033                                       gds-zap-b-code     = gds-list.gds-code
     2034                                       gds-zap-prod-name  = clients.obj-name .
     2035                                   if g#gds-engl then
     2036                                       assign gds-zap-gds-name = gds-list.engl-name.
     2037                                   else
     2038                                       assign gds-zap-gds-name = gds-list.gds-name.
     2039                               End.
     2040      run foreach.
     2041       If  break_group = true  and par-3 <> "1"  then DO :
     2042            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     2043            gds-zap-prod-name  = clients.obj-name.
     2044             If break_group1 = true  THEN  DO :
     2045               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     2046                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     2047                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     2048               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     2049                           fr0 = true .
     2050                   tmp#stroka0 = temp-str.
     2051                   if Make-Excel then  put   stream ForExcel unformatted tmp#stroka0  skip.
     2052               End.
     2053             End.
     2054             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     2055               if par-3 = "4"
     2056                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     2057                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     2058               if NOT xSumsOnly THEN DO:
     2059                   fr = true .
     2060                   if Make-Excel then  put   stream ForExcel unformatted CHR(9) temp-str  skip.
     2061               End.
     2062               break_group1 = false.
     2063             END.
     2064          break_group = false.
     2065       End.
     2066       run display-line.
     2067    END PROCEDURE.
     2068   PROCEDURE Di :
     2069   define input parameter p1 as character  no-undo.
     2070   define input parameter p2 as integer   no-undo.
     2071   define input parameter p3 as character  no-undo.
     2072   define input parameter p4 as character  no-undo.
     2073   define input parameter p5 as character  no-undo.
     2074   define input parameter p6 as character  no-undo.
     2075   define input parameter p7 as character  no-undo.
     2076   define variable tot-qnty as decimal no-undo .
     2077   define variable tot-sum as decimal no-undo .
     2078   assign
     2079     tot-qnty = 0
     2080     tot-sum  = 0
     2081   .
     2082    CASE CAPS(p7) :
     2083      WHEN "B1":U  Then DO:
     2084         if Make-Excel then  put   stream ForExcel unformatted
     2085             p3   CHR(9)
     2086             ( if flag-dop-bc = true   then  CHR(9) else "" )
     2087             p4   CHR(9)
     2088             p5   CHR(9)
     2089             p6   CHR(9)
     2090             .
     2091             For each tmp#obj-list :
     2092             if Make-Excel then  put   stream ForExcel unformatted
     2093             excel-qnty (tmp#obj-list.b1-ostatok-end[1] ) CHR(9)
     2094             excel-sum  (tmp#obj-list.b1-ostatok-end[2] ) CHR(9).
     2095             assign
     2096               tot-qnty = tot-qnty + decimal(tmp#obj-list.b1-ostatok-end[1])
     2097               tot-sum  = tot-sum  + decimal(tmp#obj-list.b1-ostatok-end[2])
     2098             .
     2099             End.
     2100             if Make-Excel then  put   stream ForExcel unformatted
     2101             excel-qnty (tot-qnty ) CHR(9)
     2102             excel-sum  (tot-sum  ) CHR(9)
     2103             Skip.
     2104             run clear-b1 .
     2105         End.
     2106      WHEN "BI":U Then DO:
     2107         if Make-Excel then  put   stream ForExcel unformatted
     2108             p3   CHR(9)
     2109             ( if flag-dop-bc = true   then  CHR(9) else "" )
     2110             p4   CHR(9)
     2111             p5   CHR(9)
     2112             p6   CHR(9)
     2113             .
     2114             For each tmp#obj-list :
     2115             if Make-Excel then  put   stream ForExcel unformatted
     2116             excel-qnty  (tmp#obj-list.bi-ostatok-end[1] ) CHR(9)
     2117             excel-sum   (tmp#obj-list.bi-ostatok-end[2] ) CHR(9).
     2118             assign
     2119               tot-qnty = tot-qnty + decimal(tmp#obj-list.bi-ostatok-end[1])
     2120               tot-sum  = tot-sum  + decimal(tmp#obj-list.bi-ostatok-end[2])
     2121             .
     2122             End.
     2123             if Make-Excel then  put   stream ForExcel unformatted
     2124             excel-qnty (tot-qnty ) CHR(9)
     2125             excel-sum  (tot-sum  ) CHR(9)
     2126             Skip.
     2127         End.
     2128      WHEN ""  Then DO:
     2129        if Show-Negativ = true OR  (Show-Negativ = false and NOT can-find ( first tmp#obj-list where tmp#obj-list.ostatok-end[1] = 0 and
     2130                                                          tmp#obj-list.ostatok-end[2] = 0 ))
     2131                THEN  DO:
     2132                  if Make-Excel then  put   stream ForExcel unformatted
     2133                  ( p3)   CHR(9)
     2134                  ( if flag-dop-bc = true   then ( v-dop-bc + CHR(9)) else "" )
     2135                  ( p4)   CHR(9)
     2136                  ( p5)   CHR(9)
     2137                  ( p6)   CHR(9)
     2138                   .
     2139                   assign
     2140                     tot-qnty = 0
     2141                     tot-sum  = 0
     2142                   .
     2143                  For each tmp#obj-list :
     2144                  if Make-Excel then  put   stream ForExcel unformatted
     2145                   excel-qnty ( tmp#obj-list.ostatok-end[1] ) CHR(9)
     2146                   excel-sum  ( tmp#obj-list.ostatok-end[2] ) CHR(9).
     2147                   assign
     2148                     tot-qnty = tot-qnty + decimal(tmp#obj-list.ostatok-end[1])
     2149                     tot-sum  = tot-sum  + decimal(tmp#obj-list.ostatok-end[2])
     2150                   .
     2151                  End.
     2152                  if Make-Excel then  put   stream ForExcel unformatted
     2153                   excel-qnty (tot-qnty ) CHR(9)
     2154                   excel-sum  (tot-sum  ) CHR(9)
     2155                  Skip.
     2156               End.
     2157      End.
     2158     End case.
     2159    END PROCEDURE.
