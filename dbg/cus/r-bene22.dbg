     2150         run clear-b1 in this-procedure .
     2151         run clear-b2 in this-procedure .
     2152      end.
     2153     end.
     2154                     end.
     2155                 end case.
     2156      end procedure.
     2157   PROCEDURE CalcItog :
     2158       run ostatok (
     2159           input x-store-code  ,
     2160           input x-store-type  ,x-TOG-Shift,
     2161           input x-date-start - 1 ,
     2162           input date('')      , x-Shift-Start,x-Shift-End,
     2163           input 'crsa':U   ,
     2164           input '##,##':U,
     2165           input xTog-obj ,
     2166           output  Quantity1  ,
     2167           output  Coast_R1   ,
     2168           output  Coast_V1   ,
     2169           output  VAT_R1     ,
     2170           output  VAT_V1     ,
     2171           output  Fact-order-1 ).
     2172       run ostatok (
     2173           input x-store-code  ,
     2174           input x-store-type  , x-TOG-Shift,
     2175           input x-date-start  ,
     2176           input x-date-end    ,  x-Shift-Start,x-Shift-End,
     2177           input 'crsa':U   ,
     2178           input '##,##':U,
     2179           input xTog-obj ,
     2180           output  Quantity1  ,
     2181           output  Coast_R1   ,
     2182           output  Coast_V1   ,
     2183           output  VAT_R1     ,
     2184           output  VAT_V1     ,
     2185           output  Fact-order-2 ).
     2186             Quantity1  = 0.
     2187             Coast_R1   = 0.
     2188             Coast_V1   = 0.
     2189             VAT_R1     = 0.
     2190             VAT_V1     = 0.
     2191   END PROCEDURE.
     2192   PROCEDURE display-str1  :
     2193   END PROCEDURE.
