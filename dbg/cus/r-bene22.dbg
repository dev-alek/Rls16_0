     2202    Assign
     2203       b1-Prih           [kk]= 0
     2204       b1-Rash           [kk]= 0
     2205       b1-KAssa          [kk]= 0
     2206       b1-Overturn       [kk]= 0
     2207       b1-ostatok-end    [kk]= 0
     2208       b1-ostatok-start  [kk]= 0
