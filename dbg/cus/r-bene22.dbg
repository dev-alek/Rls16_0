     1412         INPUT   Fo0,
     1413         INPUT   Fo02,
     1414         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xTog-obj ,
     1415         input   2 ,
     1416         output kassa[1] ,
     1417         output ret-str[2]  ).
     1418    if Showorders = false THEN DO:
     1419      run ob-line-1 ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1420         input   fo1,
     1421         input   fo12,
     1422         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1423         input   2 ,
     1424         output kassa[2] ,
     1425         output ret-str[3]  ).
     1426      run ob-line-1 ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1427         input   fo2,
     1428         input   fo22,
     1429         input   'crsa':U    ,   input   '##,##':U,   input   ""      ,   input   xtog-obj ,
     1430         input   2 ,
     1431         output kassa[3] ,
     1432         output ret-str[4]  ).
     1433      run ob-line-1 ( input   x-store-code   , input   x-store-type   , input   gds-zap-artic       ,  input   gds-zap-prod-code   ,      input   gds-zap-prod-type   ,
     1434         input   fo3,
