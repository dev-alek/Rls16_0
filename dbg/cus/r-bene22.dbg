     2221       b2-Rash                                            [kk]    = 0
     2222       b2-KAssa                                           [kk]    = 0
     2223       b2-Inv                                             [kk]    = 0
     2224       b2-Overturn                                        [kk]    = 0
     2225       b2-ostatok-end                                     [kk]    = 0
     2226       b2-ostatok-start                                   [kk]    = 0
     2227       b2-f-zakaz        = 0
     2228       b2-F-Center-stock = 0
     2229       b2-F-avr          = 0  .
