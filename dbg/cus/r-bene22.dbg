     1453         output ret-str[7]  ).
     1454   End.
     1455      f-avr =  round(kassa[1] / If integer(Fo02 - Fo0) = 0 then 1 else integer(Fo02 - Fo0) , 3) .
     1456        IF   f-zakaz  = 0 AND
     1457             Prih[1] = 0 and
     1458             kassa[1] = 0 and
     1459             kassa[2] = 0 and
     1460             kassa[3] = 0 and
     1461             kassa[4] = 0 and
     1462             kassa[5] = 0 and
     1463             kassa[6] = 0 and
     1464             ostatok-end[1] = 0
     1465             THEN RETURN.
     1466         rr = rr + 1 .
     1467         run maketemptable  .
