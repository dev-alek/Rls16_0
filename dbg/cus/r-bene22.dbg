     1213   FUNCTION format-return  RETURNS decimal (INPUT orig as char ) .
     1214   define variable rtext AS CHARACTER no-undo .
     1215   define variable strt AS INTEGER no-undo .
     1216   define variable leng AS INTEGER no-undo .
     1217   Assign rtext = orig .
     1218     leng = 1.
     1219     strt =  index(rtext,'=').
     1220     if strt = 0 then Return decimal(rtext).
     1221     SUBSTRING(rtext,strt,leng,"CHARACTER") = "" .
     1222      strt =  index(rtext,'"').
     1223     if strt > 0 then
     1224     SUBSTRING(rtext,strt,leng,"CHARACTER") = "" .
     1225     strt =  index(rtext, v-delim).
     1226     if strt > 0 then
     1227        SUBSTRING(rtext,strt,leng,"CHARACTER") = "." .
     1228     strt =  index(rtext,'"').
     1229     if strt > 0 then
     1230     SUBSTRING(rtext,strt,leng,"CHARACTER") = "" .
     1231   Return decimal(rtext).
     1232   END FUNCTION.
