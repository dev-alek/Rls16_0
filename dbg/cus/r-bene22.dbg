     2254   PROCEDURE ob-line  :
     2255   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     2256   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     2257   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     2258   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     2259   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     2260   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     2261   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     2262   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     2263   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     2264   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2265   define input  parameter xTog-obj         as log no-undo.
     2266   define input  parameter xi               as int no-undo.
     2267   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     2268   define output  parameter ret-str         as char  no-undo.
     2269   define variable  First-sum   like ub.stk-line.fact-qnty   no-undo.
     2270   define variable  Second-sum  like ub.stk-line.fact-qnty   no-undo.
     2271   define variable  Temp-First-sum  like ub.stk-line.fact-qnty   no-undo.
     2272   define variable  Temp-Second-sum  like ub.stk-line.fact-qnty   no-undo.
     2273     Assign First-sum = 0 Second-sum = 0 Temp-First-sum = 0 Temp-Second-sum = 0 ret-str = "".
     2274     For EAch Temp#obj-list  no-lock BREAK by Temp#obj-list.grp-name :
     2275         FIND LAST ub.stk-line where
     2276                                 ub.stk-line.artic         = x-artic
     2277                           AND   ub.stk-line.fact-order   <= x-fact-order-2
     2278                           AND   ub.stk-line.obj-code     = Temp#obj-list.obj-code
     2279                           AND   ub.stk-line.obj-type     = Temp#obj-list.obj-type
     2280                           AND   ub.stk-line.prod-code    = x-prod-code
     2281                           AND   ub.stk-line.prod-type    = x-prod-type
     2282                           AND   ub.stk-line.sum-type     = 'crsa':U
     2283                           AND   ub.stk-line.cat-id       = '##,##':U
     2284                           USE-index category no-lock  no-error.
     2285                 if available ub.stk-LINE THEN Second-sum = Second-sum + ub.stk-line.fact-qnty.
     2286                 if available ub.stk-LINE THEN Temp-Second-sum = Temp-Second-sum + ub.stk-line.fact-qnty.
     2287       if LAST-of (Temp#obj-list.grp-name) Then
     2288         Assign ret-str = ret-str + excel-sum ( Temp-Second-sum )
     2289                ret-str = ret-str + CHR(9)
     2290                Temp-First-sum  = 0
     2291                Temp-Second-sum = 0.
     2292      End.
     2293      Quntity = Second-sum .
     2294   END PROCEDURE.
     2295   PROCEDURE ostatok :
     2296   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2297   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2298   def input parameter x-tog-shift   as   logical             no-undo.
     2299   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2300   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2301   def input parameter x-shift-start as integer               no-undo.
     2302   def input parameter x-shift-end   as integer               no-undo.
     2303   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2304   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2305   def input parameter xTog-obj   as log no-undo.
     2306   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2307   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2308   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2309   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2310   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2311   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2312   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2313   def var              Fact-orderS   as char  no-undo.
     2314   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2315      Assign
     2316         Fact-order   = 0
     2317         Quantity     = 0
     2318         Coast_R      = 0
     2319         Coast_V      = 0
     2320         VAT_R        = 0
     2321         VAT_V        = 0 .
     2322    x-date-start-t  = x-date-start + 1 .
     2323   IF x-date-end = date('') then DO:
     2324      Fact-order = 0 .
     2325      for each obj-list
     2326          where  ( not xtog-obj or
     2327                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2328                 no-lock :
     2329         if  x-tog-shift = false then do:
     2330                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2331                               ub.stk-tot.Fact-date <=  x-date-start
     2332                               and ub.stk-tot.shift-num = 0
     2333                               USE-INDEX fact-date no-lock no-error .
     2334              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2335         End.
     2336         Else  DO :
     2337             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2338              (ub.stk-tot.shift-date  = x-date-start-t and
     2339               ub.stk-tot.shift-num  < x-shift-start or
     2340               ub.stk-tot.shift-date  < x-date-start-t  )
     2341               and ub.stk-tot.shift-num  > 0
     2342               USE-INDEX Shift-num no-lock no-error .
     2343            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2344           END.
     2345       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2346     End.
     2347   End.
     2348   Else DO:
     2349     For each obj-list  WHERE
     2350        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2351         no-lock :
     2352      IF  x-TOG-Shift = False Then DO:
     2353          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2354               ub.stk-tot.Fact-date <= x-date-end
     2355               and ub.stk-tot.shift-num = 0
     2356               USE-INDEX fact-date no-lock no-error.
     2357          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2358      END.
     2359      Else DO:
     2360           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2361               (ub.stk-tot.shift-date  = x-date-end and
     2362               ub.stk-tot.shift-num  <= x-shift-end or
     2363               ub.stk-tot.shift-date  < x-date-end       ) and
     2364               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2365               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2366       End.
     2367       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2368     End.
     2369   End.
     2370   END PROCEDURE.
     2371   PROCEDURE report-exec1  :
     2372      FIND FIRST ub.clients where x-store-type = ub.clients.obj-type AND
     2373                                  x-store-code = ub.clients.obj-code no-lock no-error.
     2374              If available ub.clients then  ObjName = ub.clients.obj-name.
     2375                                            else  ObjName="объект не определен".
     2376     run waitfram-show in this-procedure (objname) .
     2377     run calcitog in this-procedure .
     2378     run print-header in this-procedure .
     2379     run run2 in this-procedure .
     2380     run printtemptable in this-procedure .
     2381     run print-footer in this-procedure .
     2382     END PROCEDURE.
     2383   PROCEDURE Calc-Sub-itog :
     2384   define input parameter tt as int no-undo.
     2385   define variable b as int no-undo.
     2386   define variable c as int no-undo.
     2387   define variable temp-sum1 as decimal no-undo .
     2388   define variable temp-sum2 as decimal no-undo .
     2389   define variable temp-sumi as decimal no-undo .
     2390   define variable temp-sum1# as decimal no-undo .
     2391   define variable temp-sum2# as decimal no-undo .
     2392   define variable temp-sumi# as decimal no-undo .
     2393   define variable ret-str-1 as character no-undo .
     2394   define variable ret-str-2 as character no-undo .
     2395   define variable ret-str-i as character no-undo .
     2396   define variable v-nn as integer   no-undo .
     2397     b1-ostatok-end [1] =  b1-ostatok-end [1] + TMP#bs.ostatok-end.
     2398     b2-ostatok-end [1] =  b2-ostatok-end [1] + TMP#bs.ostatok-end.
     2399     bi-ostatok-end [1] =  bi-ostatok-end [1] + TMP#bs.ostatok-end.
     2400     B1-Prih[1]    = B1-Prih[1]    + TMP#bs.Prih.
     2401     B2-Prih[1]    = B2-Prih[1]    + TMP#bs.Prih .
     2402     Bi-Prih[1]    = Bi-Prih[1]    + TMP#bs.Prih  .
     2403     B1-f-zakaz    = B1-f-zakaz   + TMP#bs.f-zakaz.
     2404     B2-f-zakaz    = B2-f-zakaz   + TMP#bs.f-zakaz.
     2405     Bi-f-zakaz    = Bi-f-zakaz   + TMP#bs.f-zakaz.
     2406     B1-F-Center-stock = B1-F-Center-stock  +  TMP#bs.F-Center-stock.
     2407     B2-F-Center-stock = B2-F-Center-stock  +  TMP#bs.F-Center-stock.
     2408     Bi-F-Center-stock = Bi-F-Center-stock  +  TMP#bs.F-Center-stock.
     2409     B1-KAssa[1]    = B1-KAssa[1]   +  TMP#bs.KAssa1 .  B2-kassa[1]    = B2-kassa[1]   +  TMP#bs.kassa1 .  Bi-Kassa[1]    = Bi-Kassa[1]   +  TMP#bs.Kassa1 .
     2410     B1-KAssa[2]    = B1-KAssa[2]   +  TMP#bs.KAssa2 .  B2-kassa[2]    = B2-kassa[2]   +  TMP#bs.kassa2 .  Bi-Kassa[2]    = Bi-Kassa[2]   +  TMP#bs.Kassa2 .
     2411     B1-KAssa[3]    = B1-KAssa[3]   +  TMP#bs.KAssa3 .  B2-kassa[3]    = B2-kassa[3]   +  TMP#bs.kassa3 .  Bi-Kassa[3]    = Bi-Kassa[3]   +  TMP#bs.Kassa3 .
     2412     B1-KAssa[4]    = B1-KAssa[4]   +  TMP#bs.KAssa4 .  B2-kassa[4]    = B2-kassa[4]   +  TMP#bs.kassa4 .  Bi-Kassa[4]    = Bi-Kassa[4]   +  TMP#bs.Kassa4 .
     2413     B1-KAssa[5]    = B1-KAssa[5]   +  TMP#bs.KAssa5 .  B2-kassa[5]    = B2-kassa[5]   +  TMP#bs.kassa5 .  Bi-Kassa[5]    = Bi-Kassa[5]   +  TMP#bs.Kassa5 .
     2414     B1-KAssa[6]    = B1-KAssa[6]   +  TMP#bs.KAssa6 .  B2-kassa[6]    = B2-kassa[6]   +  TMP#bs.kassa6 .  Bi-Kassa[6]    = Bi-Kassa[6]   +  TMP#bs.Kassa6 .
     2415     B1-F-avr =  round(b1-kassa[1] / If integer(Fo02 - Fo0) = 0 then 1 else integer(Fo02 - Fo0) , 3) .
     2416     B2-F-avr =  round(b2-kassa[1] / If integer(Fo02 - Fo0) = 0 then 1 else integer(Fo02 - Fo0) , 3) .
     2417     Bi-F-avr =  round(bi-kassa[1] / If integer(Fo02 - Fo0) = 0 then 1 else integer(Fo02 - Fo0) , 3) .
     2418     repeat   c = 1 to 8 :
     2419         Assign
     2420         Temp-sum1  = 0 ret-str-1 = ""
     2421         Temp-sum2  = 0 ret-str-2 = ""
     2422         Temp-sumi  = 0 ret-str-i = "" .
     2423         v-nn = num-entries(tmp#bs.ret-str [c] , CHR(9)) - 1 .
     2424         repeat  b = 1 to v-nn :
     2425             Temp-sum1# = format-return(entry(b,B1-Ret-str [c],CHR(9))) no-error . if ERROR-STATUS :error then Temp-sum1# = 0.
     2426             Temp-sum2# = format-return(entry(b,B2-Ret-str [c],CHR(9))) no-error . if ERROR-STATUS :error then Temp-sum2# = 0.
     2427             Temp-sumi# = format-return(entry(b,Bi-Ret-str [c],CHR(9))) no-error . if ERROR-STATUS :error then Temp-sumi# = 0.
     2428             Temp-sum1 = Temp-sum1# + format-return(entry(b,TMP#bs.Ret-str [c],CHR(9))) no-error.
     2429             Temp-sum2 = Temp-sum2# + format-return(entry(b,TMP#bs.Ret-str [c],CHR(9))) no-error.
     2430             Temp-sumi = Temp-sumi# + format-return(entry(b,TMP#bs.Ret-str [c],CHR(9))) no-error.
     2431             Assign
     2432                    ret-str-1 = ret-str-1 + excel-sum((decimal(Temp-sum1) ))
     2433                    ret-str-1 = ret-str-1 + CHR(9)
     2434                    ret-str-2 = ret-str-2 + excel-sum((decimal(Temp-sum2) ))
     2435                    ret-str-2 = ret-str-2 + CHR(9)
     2436                    ret-str-i = ret-str-i + excel-sum((decimal(Temp-sumi) ))
     2437                    ret-str-i = ret-str-i + CHR(9).
     2438         End.
     2439         b1-ret-str[c] =  ret-str-1.
     2440         b2-ret-str[c] =  ret-str-2.
     2441         bi-ret-str[c] =  ret-str-i.
     2442     End.
     2443   END PROCEDURE.
     2444   PROCEDURE Clear-item :
     2445   define variable kk as int no-undo.
     2446    REPEAT kk = 1 to 6:
     2447    Assign
     2448       prih                 [kk]    = 0
     2449       rash                 [kk]    = 0
     2450       kassa                [kk]    = 0
     2451       Inv                  [kk]    = 0
     2452       Overturn             [kk]    = 0
     2453       ostatok-end      [kk] =   0
     2454       ostatok-start    [kk] =   0   .
     2455          End.
     2456      REPEAT kk = 1 to 8 :
     2457      B1-ret-str[kk] = s#ret-str.
     2458      B2-ret-str[kk] = s#ret-str.
     2459      Bi-ret-str[kk] = s#ret-str.
     2460      End.
     2461    END PROCEDURE.
     2462   PROCEDURE Item-Goods :
     2463    define input parameter  par-3 as char no-undo.
     2464    define input parameter  par-4 as char no-undo.
     2465         if par-4 = "goods":U  Then
     2466                                   assign
     2467                                       gds-zap-prt-root   = ub.goods.prt-root
     2468                                       gds-zap-prod-type  = ub.goods.prod-type
     2469                                       gds-zap-prod-code  = ub.goods.prod-code
     2470                                       gds-zap-artic      = ub.goods.artic
     2471                                       gds-zap-grp-name   = ub.goods.grp-name
     2472                                       gds-zap-b-code     = ub.goods.gds-code.
     2473        if par-4 = "gds-list":U  Then
     2474                                   assign
     2475                                       gds-zap-prt-root   = gds-list.prt-root
     2476                                       gds-zap-prod-type  = gds-list.prod-type
     2477                                       gds-zap-prod-code  = gds-list.prod-code
     2478                                       gds-zap-artic      = gds-list.artic
     2479                                       gds-zap-grp-name   = gds-list.grp-name
     2480                                       gds-zap-b-code     = gds-list.gds-code.
     2481             FIND FIRST ub.clients WHERE ub.clients.obj-type = gds-zap-prod-type AND
     2482                                      ub.clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     2483                                      gds-zap-prod-name  = ub.clients.obj-name .
     2484      if xtog-lavel = true  and  xLavel > 0 then
     2485         gds-zap-grp-name = n-lavel(INPUT gds-zap-grp-name, Input xLavel ) .
     2486      run foreach in this-procedure .
     2487      Return error.
     2488    END PROCEDURE.
     2489   PROCEDURE Di :
     2490   define input parameter p1 as char no-undo.
     2491   define input parameter p2 as int no-undo.
     2492   define input parameter p3 as char no-undo.
     2493   define input parameter p4 as char no-undo.
     2494   define input parameter p5 as char no-undo.
     2495   define input parameter p6 as char no-undo.
     2496   define input parameter p7 as char no-undo.
     2497    CASE CAPS(p7) :
     2498      WHEN "B1":U  Then
     2499               run display-str-ex ( '' ,
     2500                   p3                  ,
     2501                   p4                  ,
     2502                   b1-F-zakaz          ,
     2503                   b1-F-center-stock   ,
     2504                   b1-Prih       [1]   ,
     2505                   b1-ostatok-end[1]   ,
     2506                   b1-F-avr            ,
     2507                   b1-KAssa      [1]   ,
     2508                   b1-KAssa      [2]   ,
     2509                   b1-KAssa      [3]   ,
     2510                   b1-KAssa      [4]   ,
     2511                   b1-KAssa      [5]   ,
     2512                   b1-KAssa      [6]  , "B1":U ).
     2513      WHEN "B2":U  Then
     2514                run display-str-ex ( '',
     2515                   p3                  ,
     2516                   p4                  ,
     2517                   b2-F-zakaz          ,
     2518                   b2-F-center-stock   ,
     2519                   b2-Prih [1]         ,
     2520                   b2-ostatok-end[1]   ,
     2521                   b2-F-avr            ,
     2522                   b2-KAssa      [1]   ,
     2523                   b2-KAssa      [2]   ,
     2524                   b2-KAssa      [3]   ,
     2525                   b2-KAssa      [4]   ,
     2526                   b2-KAssa      [5]   ,
     2527                   b2-KAssa      [6]  , "B2":U ).
     2528      WHEN "BI":U Then
     2529                run display-str-ex ( '',
     2530                   ''                   ,
     2531                   p4                   ,
     2532                   bi-F-zakaz           ,
     2533                   bi-F-center-stock    ,
     2534                   bi-Prih          [1] ,
     2535                   bi-ostatok-end   [1] ,
     2536                   bi-f-avr             ,
     2537                   bi-kAssa       [1]   ,
     2538                   bi-KAssa         [2] ,
     2539                   bi-KAssa         [3] ,
     2540                   bi-KAssa         [4] ,
     2541                   bi-KAssa         [5] ,
     2542                   bi-KAssa         [6] , "BI":U).
     2543      WHEN ""  Then
     2544                run display-str-ex ( ':',
     2545                   ii                    ,
     2546                   p4                    ,
     2547                   F-zakaz               ,
     2548                   F-center-stock        ,
     2549                   Prih          [1]     ,
     2550                   ostatok-end   [1]     ,
     2551                   f-avr                 ,
     2552                   kASSA         [1]     ,
     2553                   KAssa         [2]     ,
     2554                   KAssa         [3]     ,
     2555                   KAssa         [4]     ,
     2556                   KAssa         [5]     ,
     2557                   KAssa         [6]    , "":U ).
     2558          End case.
     2559    END PROCEDURE.
     2560   procedure zakaz :
     2561      F-zakaz = 0.
     2562      For each Temp#obj-list :
     2563      For each ub.trn-doc where
     2564             ub.trn-doc.doc-date <= x-date-end
     2565       AND   ub.trn-doc.doc-date >= x-date-start
     2566       AND   ub.trn-doc.status_   = 'запрос':U
     2567       AND   ub.trn-doc.internal  = false
     2568       AND   ub.trn-doc.obj-code   = Temp#obj-list.obj-code
     2569       AND   ub.trn-doc.obj-type   = Temp#obj-list.obj-type
     2570        no-lock :
     2571         For each ub.doc-line where
     2572                 ub.trn-doc.doc-code =  ub.doc-line.doc-code
     2573           AND   ub.doc-line.obj-code   = Temp#obj-list.obj-code
     2574           AND   ub.doc-line.obj-type   = Temp#obj-list.obj-type
     2575           AND   ub.doc-line.prod-code  = gds-zap-prod-code
     2576           AND   ub.doc-line.prod-type  = gds-zap-prod-type
     2577           AND   ub.doc-line.status_    = 'запрос':U
     2578           AND   ub.doc-line.artic      = gds-zap-artic    no-lock :
     2579                 F-zakaz = F-zakaz  +  ub.doc-line.doc-qnty   .
     2580         End.
     2581      End.
     2582   End.
     2583   End procedure.
     2584   Procedure maket :
     2585     Create temp#sum-type no-error.
     2586     Assign temp#sum-type.sum-type =   'ie':U       temp#sum-type.xi = 1      .
     2587     Create temp#sum-type no-error.
     2588     Assign temp#sum-type.sum-type =   'iv':U       temp#sum-type.xi = 1      .
     2589     Create temp#sum-type no-error.
     2590     Assign temp#sum-type.sum-type =  'ev':U       temp#sum-type.xi = 1      .
     2591     Create temp#sum-type no-error.
     2592     Assign temp#sum-type.sum-type =  'es':U       temp#sum-type.xi = 2  .
     2593     Create temp#sum-type no-error.
     2594     Assign temp#sum-type.sum-type =  'rs':U   temp#sum-type.xi = 2  .
     2595     if tog-voz then DO:
     2596       Create temp#sum-type no-error.
     2597       Assign temp#sum-type.sum-type =  're':U        temp#sum-type.xi = 2  .
     2598     End.
     2599     Create temp#sum-type no-error.
     2600     Assign temp#sum-type.sum-type = 'crsa':U  temp#sum-type.xi = 3  .
     2601    End procedure.
     2602   Procedure Display-str-ex :
     2603    define input parameter  p0  as char no-undo.
     2604    define input parameter  p1  as char no-undo.
     2605    define input parameter  p2  as char no-undo.
     2606    define input parameter  p3  as decimal   no-undo.
     2607    define input parameter  p4  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2608    define input parameter  p5  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2609    define input parameter  p6  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2610    define input parameter  p7  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2611    define input parameter  p8  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2612    define input parameter  p9  as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2613    define input parameter  p10 as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2614    define input parameter  p11 as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2615    define input parameter  p12 as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2616    define input parameter  p13 as decimal Format "->>>>>>>>>>>>9.<<<"  no-undo.
     2617    define input parameter  B as char no-undo.
     2618   define variable v-nn as integer   no-undo .
     2619    if p0 <> ':' THEN DO:
     2620                  if Make-Excel then  put   stream ForExcel unformatted
     2621                   p1   CHR(9)
     2622                   p2   CHR(9)
     2623                   excel-sum(p3)   CHR(9)
     2624                   excel-sum(p4)   CHR(9)
     2625                   excel-sum(p5)   CHR(9)
     2626                    if b <> "BI":U THEN string(b1-ret-str[1])
     2627                                   ELSE string(bi-ret-str[1])
     2628                   excel-sum(p6)   CHR(9)
     2629                    if b <> "BI":U THEN string(b1-ret-str[8])
     2630                                   ELSE string(bi-ret-str[8])
     2631                   excel-sum(p7)   CHR(9)
     2632                   excel-sum(p8)   CHR(9)
     2633                    if b <> "BI":U THEN string(b1-ret-str[2])
     2634                                   ELSE string(bi-ret-str[2])
     2635                                   .
     2636                   if Showorders = false THEN DO:
     2637                   if Make-Excel then  put   stream ForExcel unformatted
     2638                    excel-sum(p9)   CHR(9)
     2639                    if b <> "BI":U THEN string(b1-ret-str[3])
     2640                                   ELSE string(bi-ret-str[3])
     2641                    excel-sum(p10)  CHR(9)
     2642                    if b <> "BI":U THEN string(b1-ret-str[4])
     2643                                   ELSE string(bi-ret-str[4])
     2644                   excel-sum(p11)  CHR(9)
     2645                    if b <> "BI":U THEN string(b1-ret-str[5])
     2646                                   ELSE string(bi-ret-str[5])
     2647                   excel-sum(p12)  CHR(9)
     2648                    if b <> "BI":U THEN string(b1-ret-str[6])
     2649                                   ELSE string(bi-ret-str[6])
     2650                   excel-sum(p13)  CHR(9)
     2651                    if b <> "BI":U THEN string(b1-ret-str[7])
     2652                                   ELSE string(bi-ret-str[7]) Skip.
     2653                                  End.
     2654                     if Make-Excel then  put   stream ForExcel unformatted Skip.
     2655                    End.
     2656                  Else DO:
     2657    define variable i as integer no-undo .
     2658    qnty-orders = "".
     2659   if showorders = true then DO:
     2660       v-nn = num-entries(Number-Orders) .
     2661       repeat i = 1 to  v-nn :
     2662       If entry(i,Number-Orders) <> ?
     2663          and entry(i,Number-Orders) <> "."
     2664          and entry(i,Number-Orders) <> ""
     2665          and entry(i,Number-Orders) <> "0" Then DO:
     2666         Find first ub.doc-line where
     2667               entry(i,Number-Orders)    = ub.doc-line.doc-code
     2668               AND   ub.doc-line.prod-code  = TMP#bs.prod-code
     2669               AND   ub.doc-line.prod-type  = TMP#bs.prod-type
     2670               AND   ub.doc-line.status_    = 'запрос':U
     2671               AND   ub.doc-line.artic      = TMP#bs.artic
     2672               no-lock no-error .
     2673               qnty-orders =  qnty-orders  +
     2674                         (if avail ub.doc-line then
     2675                         string(ub.doc-line.fact-qnty)  Else "0")  +  CHR(9) .
     2676        End.
     2677       End.
     2678    End.
     2679    Else qnty-orders = "".
     2680         if Make-Excel then  put   stream ForExcel unformatted
     2681           p1   CHR(9)
     2682           p2   CHR(9)
     2683           excel-sum(p3)   CHR(9)
     2684           excel-sum(p4)   CHR(9)
     2685           excel-sum(p5)   CHR(9)
     2686           string(TMP#bs.ret-str[1])
     2687           excel-sum(p6)   CHR(9)
     2688           string(TMP#bs.ret-str[8])
     2689           excel-sum(p7)   CHR(9)
     2690           excel-sum(p8)   CHR(9)
     2691           string(TMP#bs.ret-str[2] )
     2692           .
     2693         if Showorders = false THEN DO:
     2694         if Make-Excel then  put   stream ForExcel unformatted
     2695           excel-sum(p9)   CHR(9)
     2696           string(TMP#bs.ret-str[3]  )
     2697           excel-sum(p10)  CHR(9)
     2698           string(TMP#bs.ret-str[4])
     2699           excel-sum(p11)  CHR(9)
     2700           string(TMP#bs.ret-str[5])
     2701           excel-sum(p12)  CHR(9)
     2702           string(TMP#bs.ret-str[6])
     2703           excel-sum(p13)  CHR(9)
     2704           string(TMP#bs.ret-str[7])
     2705           Skip.
     2706         End.
     2707         if Showorders = true  THEN DO:
     2708            if Make-Excel then  put   stream ForExcel unformatted qnty-orders       skip  .
     2709         End.
     2710         if Make-Excel then  put   stream ForExcel unformatted Skip.
     2711     End.
     2712   End procedure.
     2713   PROCEDURE Maketemptable :
     2714      Assign
     2715       v#b-code        = gds-zap-b-code
     2716       v#artic         = gds-zap-artic
     2717       v#prod-code     = gds-zap-prod-code
     2718       v#prod-type     = gds-zap-prod-type
     2719       v#prt-root      = gds-zap-prt-root
     2720       v#grp-name      = gds-zap-grp-name
     2721       v#F-zakaz       =  F-zakaz
     2722       v#F-center-stock=  F-center-stock
     2723       v#Prih          =  Prih          [1]
     2724       v#ostatok-end   =  ostatok-end   [1]
     2725       v#f-avr         =  f-avr
     2726       v#kASSA1        =  kASSA         [1]
     2727       v#KAssa2        =  KAssa         [2]
     2728       v#KAssa3        =  KAssa         [3]
     2729       v#KAssa4        =  KAssa         [4]
     2730       v#KAssa5        =  KAssa         [5]
     2731       v#KAssa6        =  KAssa         [6]
     2732       no-error.
     2733        Repeat l = 1 to 8 :
     2734          V#ret-str[l] = (ret-str[l]).
     2735        End.
     2736      Create TMP#bs no-error.
     2737      run eqq no-error.
     2738   END PROCEDURE.
     2739   PROCEDURE Eqq :
     2740      Assign
     2741       TMP#bs.b-code        = v#b-code
     2742       TMP#bs.artic         = v#artic
     2743       TMP#bs.prod-code     = v#prod-code
     2744       TMP#bs.prod-type     = v#prod-type
     2745       TMP#bs.prt-root      = v#prt-root
     2746       TMP#bs.grp-name      = v#grp-name
     2747       TMP#bs.F-zakaz       = v#F-zakaz
     2748       TMP#bs.F-center-stock= v#F-center-stock
     2749       TMP#bs.Prih          = v#Prih
     2750       TMP#bs.ostatok-end   = v#ostatok-end
     2751       TMP#bs.f-avr         = v#f-avr
     2752       TMP#bs.kASSA1        = v#kASSA1
     2753       TMP#bs.KAssa2        = v#KAssa2
     2754       TMP#bs.KAssa3        = v#KAssa3
     2755       TMP#bs.KAssa4        = v#KAssa4
     2756       TMP#bs.KAssa5        = v#KAssa5
     2757       TMP#bs.KAssa6        = v#KAssa6
     2758       TMP#bs.KAssa6        = v#KAssa6    no-error    .
     2759        Repeat l = 1 to 8 :
     2760          TMP#bs.ret-str[l] = v#ret-str[l] no-error.
     2761        End.
     2762   END PROCEDURE.
     2763   PROCEDURE PrintTempTAble :
     2764   define variable i as int init 0  no-undo.
     2765    Case RetClassify  :
     2766     WHEN "no-classify":U then DO:
     2767           For each TMP#bs   no-lock by
     2768           (if xSorttype = "sort-code":U  THEN string(TMP#bs.b-code)
     2769             ELSE if xSorttype = "sort-artic":U  THEN TMP#bs.artic
     2770                   ELSE  string( TMP#bs.f-avr,"-9999999999.999"))  :
     2771                       i = i + 1 .
     2772           If  Tog-Qnty = true   and  TMP#bs.f-avr = 0 then next.
     2773           If  Tog-Qnty = true  and I <= xBSAmount Then DO:
     2774                run display-line-tmp in this-procedure (i).  end.
     2775           If  Tog-Qnty = false  Then  DO:
     2776               run display-line-tmp in this-procedure (i). end.
     2777           End.
     2778       End.
     2779       when  "grp-goods":U then do:
     2780         if xtog-lavel = false then do:
     2781           For each TMP#bs where
     2782           ( Tog-Qnty = false OR TMP#bs.f-avr <> 0 )
     2783            no-lock  BREAK by TMP#bs.grp-name BY
     2784           (if xSorttype = "sort-code":U  THEN string(TMP#bs.b-code)
     2785             ELSE if xSorttype = "sort-artic":U  THEN TMP#bs.artic
     2786                   ELSE  string(TMP#bs.f-avr,"-9999999999.999"))  :
     2787                       i = i + 1 .
     2788               if First-of(TMP#bs.grp-name) then do:
     2789                 run sub-head in this-procedure (tmp#bs.grp-name).
     2790                 End.
     2791               If  Tog-Qnty = true  and I <= xBSAmount Then  Run display-line-tMP(i).
     2792               If  Tog-Qnty = false Then   Run display-line-tMP(i).
     2793               if last-of(TMP#bs.grp-name) then do :
     2794                  i = 0.
     2795                  run sub-foot in this-procedure (tmp#bs.grp-name).
     2796                  End.
     2797               End.
     2798          end.
     2799          else do:
     2800           for each tmp#bs where
     2801           ( tog-qnty = false or tmp#bs.f-avr <> 0 )
     2802            no-lock  break
     2803             by (n-lavel(tmp#bs.grp-name,xlavel))
     2804             by str
     2805             by (if xsorttype = "sort-code":u  then string(tmp#bs.b-code)
     2806                                               else
     2807                                                 if xsorttype = "sort-artic":u
     2808                                                    then tmp#bs.artic
     2809                                                    else  string(tmp#bs.f-avr,"-9999999999.999"))  :
     2810              str = n-lavel(input tmp#bs.grp-name, input xlavel ) .
     2811              i = i + 1 .
     2812               if First-of(str) then do:
     2813                 run sub-head in this-procedure (str).
     2814                 End.
     2815               If  Tog-Qnty = true  and I <= xBSAmount Then  run display-line-tmp in this-procedure (i).
     2816               If  Tog-Qnty = false Then   run display-line-tmp in this-procedure (i).
     2817               if last-of(str) then do :
     2818                  i = 0.
     2819                  run sub-foot in this-procedure (str).
     2820                  End.
     2821           end.
     2822          end.
     2823        end.
     2824     End case.
     2825   END PROCEDURE.
     2826   PROCEDURE display-line-tMP :
     2827   define input parameter i as int no-undo.
     2828   run display-str-ex ( ':',
     2829     i                     ,
     2830     TMP#bs.artic          ,
     2831     TMP#bs.F-zakaz        ,
     2832     TMP#bs.F-center-stock ,
     2833     TMP#bs.Prih           ,
     2834     TMP#bs.ostatok-end    ,
     2835     TMP#bs.f-avr          ,
     2836     TMP#bs.kASSA1         ,
     2837     TMP#bs.KAssa2         ,
     2838     TMP#bs.KAssa3         ,
     2839     TMP#bs.KAssa4         ,
     2840     TMP#bs.KAssa5         ,
     2841     TMP#bs.KAssa6
     2842     , "":U).
     2843   run calc-sub-itog in this-procedure (0).
     2844   END PROCEDURE.
     2845   PROCEDURE ob-line-1  :
     2846   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     2847   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     2848   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     2849   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     2850   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     2851   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     2852   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     2853   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     2854   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     2855   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2856   define input  parameter xTog-obj         as log no-undo.
     2857   define input  parameter xi               as int no-undo.
     2858   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     2859   define output  parameter ret-str         as char  no-undo.
     2860   define variable  First-sum   like ub.stk-line.fact-qnty   no-undo.
     2861   define variable  Second-sum  like ub.stk-line.fact-qnty   no-undo.
     2862   define variable  Temp-First-sum   like ub.stk-line.fact-qnty   no-undo.
     2863   define variable  Temp-Second-sum  like ub.stk-line.fact-qnty   no-undo.
     2864     if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     2865     Assign First-sum = 0 Second-sum = 0 Temp-First-sum = 0 Temp-Second-sum = 0 ret-str = "" .
     2866     For each Temp#obj-list   no-lock BREAK by Temp#obj-list.grp-name :
     2867       FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     2868         For each  ub.ot-line where
     2869                                 ub.ot-line.artic         = x-artic
     2870                           AND   ub.ot-line.fact-order   <= x-fact-order-2
     2871                           AND   ub.ot-line.fact-order   >= x-fact-order-1
     2872                           AND   ub.ot-line.obj-code     = Temp#obj-list.obj-code
     2873                           AND   ub.ot-line.obj-type     = Temp#obj-list.obj-type
     2874                           AND   ub.ot-line.prod-code    = x-prod-code
     2875                           AND   ub.ot-line.prod-type    = x-prod-type
     2876                           AND   ub.ot-line.sum-type     = 'crsa':U
     2877                           AND   ub.ot-line.ext-doc-type = temp#sum-type.sum-type
     2878                              no-lock  :
     2879               Assign
     2880               First-sum      = First-sum + ub.ot-line.fact-qnty
     2881               Temp-First-sum = Temp-First-sum + ub.ot-line.fact-qnty.
     2882         End.
     2883       End.
     2884       if LAST-of (Temp#obj-list.grp-name) Then
     2885         Assign ret-str = ret-str + String(decimal(Temp-first-sum) )
     2886                ret-str = ret-str + CHR(9)
     2887                Temp-First-sum  = 0 .
     2888    End.
     2889    Quntity = first-sum.
     2890   END PROCEDURE.
     2891   Procedure Sub-head :
     2892   define input parameter p1 as character no-undo .
     2893     temp-str = string("ГРУППА : " + p1 ).
     2894                if Make-Excel then  put   stream ForExcel unformatted temp-str format "X(100)" SKIP.
     2895    End procedure.
     2896   Procedure Sub-Foot :
     2897   define input parameter p1 as character no-undo .
     2898     temp-str = string("Итого по"+ CHR(9) + " ГРУППА : " + p1 ).
     2899     run di ("b1", 1, "Итого по",p1,"","","b1").
     2900     run clear-b1.
     2901    End procedure.
     2902    procedure display-line :
     2903     do
     2904     on error undo, return error return-value
     2905     :
     2906     end.
     2907    end procedure.
