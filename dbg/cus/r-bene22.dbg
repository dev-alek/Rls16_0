     2241       bi-ostatok-end                                     [kk]    = 0
     2242       bi-ostatok-start                                   [kk]    = 0
     2243       bi-f-zakaz                                                = 0
     2244       bi-F-Center-stock                                         = 0
     2245       bi-F-avr                                                  = 0  .
