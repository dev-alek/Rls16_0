      810   procedure cur-time :
      811      define output parameter p-today as date      no-undo .
      812      define output parameter p-time  as integer   no-undo .
      813     do
      814     on error undo, return error
      815     :
      816       define variable v-date1 as date      no-undo .
      817       define variable v-date2 as date      no-undo .
      818       define variable v-time  as integer   no-undo .
      819       assign
      820         v-date1 = today
      821         v-time  = time
      822         v-date2 = today
      823       .
      824       if v-date1 <> v-date2
      825       then do:
      826         assign
      827           v-date1 = today
      828           v-time  = v-time
      829         .
      830       end.
      831       assign
      832         p-today = v-date1
      833         p-time  = v-time
      834       .
      835     end.
      836   end.
      837   function cur-time-date returns character
      838   :
      839     return string(today, '99/99/9999':U) .
      840   end.
      841   function cur-time-mjd returns decimal
      842   :
      843     define variable v-date as date      no-undo .
      844     define variable v-time as integer   no-undo .
      845     run cur-time in this-procedure
      846       (output v-date
      847       ,output v-time
      848       ) .
      849     return integer(v-date) - 2400002 + (v-time / 86400) .
      850   end.
      851   function cur-time-get-ending-index returns integer
      852   (input p-number as integer
      853   )
      854   :
      855     if p-number < 0
      856     or p-number = ?
      857     then do:
      858       return 1 .
      859     end.
      860     define variable v-rest as integer   no-undo .
      861     assign
      862       p-number = p-number modulo 100
      863     .
      864     if p-number < 20
      865     then do:
      866       assign
      867         v-rest = p-number
      868       .
      869     end.
      870     else do:
      871       assign
      872         v-rest = p-number modulo 10
      873       .
      874     end.
      875     case v-rest :
      876       when 1
      877       then do:
      878         return 2 .
      879       end.
      880       when 2 or
      881       when 3 or
      882       when 4
      883       then do:
      884         return 3 .
      885       end.
      886       otherwise do:
      887         return 1 .
      888       end.
      889     end case .
      890   end.
      891   procedure cur-time-mjd-to-date :
      892      define input  parameter i-mjd-diff as decimal no-undo.
      893      define output parameter o-Date     as date    no-undo.
      894      define output parameter o-Time     as integer no-undo.
      895      define variable v-day-number as integer   no-undo .
      896      if    i-mjd-diff < 0
      897         or i-mjd-diff = ?
      898      then do:
      899         return "?" .
      900      end.
      901      assign
      902         v-day-number = truncate(i-mjd-diff,0).
      903         o-Date = date(v-day-number + 2400002).
      904         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      905     .
      906   end.
      907   function cur-time-mjd-to-string returns character
      908   (input p-mjd-diff as decimal
      909   )
      910   :
      911     define variable v-day-number as integer   no-undo .
      912     define variable v-seconds    as integer   no-undo .
      913     define variable v-hour       as integer   no-undo .
      914     define variable v-min        as integer   no-undo .
      915     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      916     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      917     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      918     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      919     if p-mjd-diff < 0
      920     or p-mjd-diff = ?
      921     then do:
      922       return "?" .
      923     end.
      924     assign
      925       v-day-number = integer(truncate(p-mjd-diff,0))
      926       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      927     .
      928     if v-seconds > 86400
      929     then do:
      930       assign
      931         v-seconds = 86400 - 1
      932       .
      933     end.
      934     if v-seconds < 0
      935     then do:
      936       assign
      937         v-seconds = 0
      938       .
      939     end.
      940     assign
      941       v-hour = truncate(v-seconds / 3600, 0)
      942     .
      943     assign
      944       v-seconds = v-seconds modulo 3600
      945     .
      946     assign
      947       v-min = truncate(v-seconds / 60, 0)
      948     .
      949     assign
      950       v-seconds = v-seconds modulo 60
      951     .
      952     return
      953         (if v-day-number <> 0
      954           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      955           else ""
      956         )
      957       + (if v-day-number <> 0 or v-hour <> 0
      958           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      959           else ""
      960         )
      961       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      962           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      963           else ""
      964         )
      965       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      966       .
      967   end.
      968   function cur-time-string returns character
      969   :
      970     define variable v-date as date      no-undo .
      971     define variable v-time as integer   no-undo .
      972     run cur-time in this-procedure
      973       (output v-date
      974       ,output v-time
      975       ) .
      976     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      977   end.
      978   function cur-time-string-sec returns character
      979   :
      980     define variable v-date as date      no-undo .
      981     define variable v-time as integer   no-undo .
      982     run cur-time in this-procedure
      983       (output v-date
      984       ,output v-time
      985       ) .
      986     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      987   end.
      988   function cur-time-custom  returns character
      989   (input p-prefix as character
      990   ,input p-date-format as character
      991   ,input p-delimiter as character
      992   ,input p-time-format as character
      993   ,input p-suffix as character
      994   )
      995   :
      996     define variable v-date as date      no-undo .
      997     define variable v-time as integer   no-undo .
      998     run cur-time in this-procedure
      999       (output v-date
     1000       ,output v-time
     1001       ) .
     1002     return
     1003       p-prefix
     1004       + string(v-date, p-date-format)
     1005       + p-delimiter
     1006       + string(v-time, p-time-format)
     1007       + p-suffix
     1008       .
     1009   end.
     1010   function cur-time-print  returns character
     1011   :
     1012     define variable v-date as date      no-undo .
     1013     define variable v-time as integer   no-undo .
     1014     run cur-time in this-procedure
     1015       (output v-date
     1016       ,output v-time
     1017       ) .
     1018     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1019   end.
     1020   function cur-time-datetime returns datetime
     1021   :
     1022     define variable v-char as character no-undo .
     1023     define variable v-datetime as datetime no-undo .
     1024     v-char = cur-time-string().
     1025     v-datetime = datetime(v-char).
     1026     return  v-datetime.
     1027   end.
     1028   function cur-time-string-msec returns character
     1029   :
     1030     define variable v-date as datetime  no-undo .
     1031     v-date = now.
     1032     return string(v-date) .
     1033   end.
     1034   define variable v-account as integer init 0 no-undo .
     1035   define variable v-account-lavel as character no-undo .
     1036   define variable v-button-stop as logical no-undo .
     1037   define variable v-kol-spice as integer no-undo .
     1038   define variable v-kol-spice2 as integer no-undo .
     1039   define variable v-kol-spice3 as integer no-undo .
     1040   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1041   DEFINE BUTTON StopBtn AUTO-END-KEY
     1042        LABEL "Стоп"
     1043        SIZE 10 BY 1.
     1044   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1045        LABEL "Обработано записей"
     1046         VIEW-AS TEXT
     1047        SIZE 14 BY .67 NO-UNDO.
     1048   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1049         VIEW-AS TEXT
     1050        SIZE 53.25 BY .67
     1051        FGCOLOR 1  NO-UNDO.
     1052   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1053         VIEW-AS TEXT
     1054        SIZE 53.25 BY .67
     1055        FGCOLOR 1  NO-UNDO.
     1056   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1057         VIEW-AS TEXT
     1058        SIZE 53.25 BY .67
     1059        FGCOLOR 1  NO-UNDO.
     1060   DEFINE RECTANGLE RECT-1
     1061        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1062        SIZE 55.13 BY 4.46.
     1063   DEFINE FRAME InfoFrame
     1064        StopBtn AT ROW 4.25 COL 21.75
     1065        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1066        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1067        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1068        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1069        RECT-1 AT ROW 1 COL 1
     1070       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1071            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1072            TITLE "Процесс"
     1073            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1074   define variable mFrameView      as logical   no-undo init yes.
     1075     define variable mFramHandle as handle no-undo.
     1076     mFramHandle = frame InfoFrame:handle.
     1077     if  log-manager:logfile-name ne ?
     1078     then DO:
     1079         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1080         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1081         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1082     end.
     1083     mFrameView = not session:batch-mode and mFramHandle:visible.
     1084     if mFrameView
     1085     then do:
     1086       ASSIGN
     1087          FRAME InfoFrame:HIDDEN                           = TRUE
     1088          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1089     end.
     1090   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1091   DO:
     1092     IF not StopProcessing THEN
     1093       Message "Вы действительно хотите прервать" SKIP
     1094               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1095                 UPDATE StopProcessing.
     1096     IF StopProcessing THEN do:
     1097        if mFrameView
     1098        then do:
     1099           HIDE FRAME InfoFrame.
     1100        end.
     1101     End.
     1102   END.
     1103   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1104     if num-entries(string(p-dec), '.') = 2
     1105       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1106       else return( string(p-dec)) .
     1107   end function.
     1108   function format-point-to-comma returns char (input orig as char ) .
     1109   define variable rtext as character no-undo .
     1110   define variable strt as integer no-undo .
     1111   define variable leng as integer no-undo .
     1112   assign rtext = orig .
     1113   repeat:
     1114     strt =  index(rtext,'.').
     1115     if strt = 0 then leave.
     1116     leng = 1.
     1117     substring(rtext,strt,leng,"character") = v-delim .
     1118   end.
     1119   return rtext.
     1120   end function.
     1121   function format-excel-text returns char ( input start-text as char ) :
     1122   def var  i    as int no-undo.
     1123   def var  ch   as char no-undo.
     1124   def var  n    as int no-undo.
     1125   def var  ipos as int no-undo.
     1126     n = num-entries(trim(start-text), chr(10)) - 1 .
     1127     do i = 1 to n :
     1128       ipos = index( start-text, chr(10)).
     1129       if ipos > 0 then
     1130         substr( start-text, ipos, 1 ) = ' '.
     1131     end.
     1132     n = num-entries(trim(start-text), chr(13)) - 1 .
     1133     do i = 1 to n :
     1134       ipos = index( start-text, chr(13)).
     1135       if ipos > 0 then
     1136         substr( start-text, ipos, 1 ) = ' '.
     1137     end.
     1138     if index( start-text, '"' ) = 0 then
     1139       start-text =  '="'   + trim( start-text) + '"'   .
     1140       else do:
     1141         n = num-entries(trim(start-text), '"') - 1.
     1142         do i = 1 to n :
     1143           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1144         end.
     1145         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1146         start-text = '="'  + ch  + '"' .
     1147       end.
     1148     return start-text.
     1149   end.
     1150   function excel-sum returns char (input p-dec as decimal ).
     1151     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1152   end function.
     1153   function excel-qnty returns char (input p-dec as decimal ).
     1154     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1155   end function.
     1156   function format-excel-text-macr returns char ( input start-text as char ) :
     1157   def var  i    as int no-undo.
     1158   def var  ch   as char no-undo.
     1159   def var  n    as int no-undo.
     1160   def var  ipos as int no-undo.
     1161     n = num-entries(trim(start-text), chr(10)) - 1 .
     1162     do i = 1 to n :
     1163       ipos = index( start-text, chr(10)).
     1164       if ipos > 0 then
     1165         substring( start-text, ipos , 1 ) = ' '.
     1166     end.
     1167     n = num-entries(trim(start-text), chr(13)) - 1 .
     1168     do i = 1 to n :
     1169       ipos = index( start-text, chr(13)).
     1170       if ipos > 0 then
     1171         substring( start-text, ipos, 1 ) = ' '.
     1172     end.
     1173     if index( start-text, '"' ) = 0 then
     1174       start-text =  '"'   + trim( start-text) + '"'   .
     1175       else do:
     1176         n = num-entries(trim(start-text), '"') - 1.
     1177         do i = 1 to n :
     1178           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1179         end.
     1180         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1181         start-text = '"'  + ch  + '"' .
     1182       end.
     1183     n = num-entries(trim(start-text), chr(10)) - 1 .
     1184     do i = 1 to n :
     1185       ipos = index( start-text, chr(10)).
     1186       if ipos > 0 then
     1187         substring( start-text, ipos , 1 ) = ' '.
     1188     end.
     1189       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1190     return start-text.
     1191   end.
     1192   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1194   procedure paramls-clear :
     1195     define buffer buf_temp-param for temp-param .
     1196     do
     1197     on error undo, return error return-value
     1198     :
     1199       for each buf_temp-param
     1200       on error undo, return error
     1201       :
     1202         delete buf_temp-param .
     1203       end.
     1204     end.
     1205   end procedure.
     1206   procedure paramls-write :
     1207     define input  parameter p-code     as character no-undo .
     1208     define input  parameter p-sub-code as character no-undo .
     1209     define input  parameter p-value    as character no-undo .
     1210     define buffer buf_temp-param for temp-param .
     1211     do
     1212     on error undo, return error return-value
     1213     :
     1214       find first buf_temp-param
     1215         where buf_temp-param.param-code     = p-code
     1216           and buf_temp-param.param-sub-code = p-sub-code
     1217         no-error .
     1218       if not available buf_temp-param then do:
     1219         create buf_temp-param .
     1220         assign
     1221           buf_temp-param.param-code     = p-code
     1222           buf_temp-param.param-sub-code = p-sub-code
     1223         .
     1224       end.
     1225       assign
     1226         buf_temp-param.param-value = p-value
     1227       .
     1228     end.
     1229   end procedure.
     1230   procedure paramls-read :
     1231     define input  parameter p-code          as character no-undo .
     1232     define input  parameter p-sub-code      as character no-undo .
     1233     define input  parameter p-default-value as character no-undo .
     1234     define output parameter p-value         as character no-undo .
     1235     define buffer buf_temp-param for temp-param .
     1236     do
     1237     on error undo, return error return-value
     1238     :
     1239       find first buf_temp-param
     1240         where buf_temp-param.param-code     = p-code
     1241           and buf_temp-param.param-sub-code = p-sub-code
     1242         no-error .
     1243       if available buf_temp-param then do:
     1244         assign
     1245           p-value = buf_temp-param.param-value
     1246         .
     1247       end.
     1248       else do:
     1249         assign
     1250           p-value = p-default-value
     1251         .
     1252       end.
     1253     end.
     1254   end procedure.
     1255   procedure paramls-append :
     1256     define input  parameter p-code     as character no-undo .
     1257     define input  parameter p-sub-code as character no-undo .
     1258     define input  parameter p-value    as character no-undo .
     1259     define buffer buf_temp-param for temp-param .
     1260     do
     1261     on error undo, return error return-value
     1262     :
     1263       find first buf_temp-param
     1264            where buf_temp-param.param-code     = p-code
     1265              and buf_temp-param.param-sub-code = p-sub-code
     1266         no-error .
     1267       if not available buf_temp-param then do:
     1268         create buf_temp-param .
     1269         assign
     1270           buf_temp-param.param-code     = p-code
     1271           buf_temp-param.param-sub-code = p-sub-code
     1272           buf_temp-param.param-value    = p-value
     1273         .
     1274       end.
     1275       else do:
     1276           assign
     1277               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1278           .
     1279       end.
     1280     end.
     1281   end procedure.
