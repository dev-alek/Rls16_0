     1328   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1329   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     1330   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     1331   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1332   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1333   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
     1334   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     1335   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     1336   procedure uf-name :
     1337     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1338     define output parameter p-use-List_     as logical   no-undo .
     1339     define output parameter p-type-List_     as character no-undo .
     1340     define output parameter p-format-List_   as character no-undo .
     1341     define output parameter p-use-Naim      as logical   no-undo .
     1342     define output parameter p-type-Naim      as character no-undo .
     1343     define output parameter p-format-Naim    as character no-undo .
     1344     define output parameter p-use-print-graft as logical   no-undo .
     1345     define output parameter p-use-sort-gr   as logical   no-undo .
     1346     define output parameter p-use-type-price as logical   no-undo .
     1347     define output parameter p-use-type-val  as logical   no-undo .
     1348     define output parameter p-label          as character no-undo .
     1349     define output parameter p-tooltip        as character no-undo .
     1350     define output parameter p-user-can-edit  as logical   no-undo .
     1351     define output parameter p-output-display as logical   no-undo .
     1352     define output parameter p-other          as character no-undo .
     1353     do
     1354     on error undo, return error
     1355     :
     1356       case p-code :
     1357               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1358               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1359               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1360               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
