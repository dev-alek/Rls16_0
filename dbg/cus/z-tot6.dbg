     1433   procedure uf-get :
     1434     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1435     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1436     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1437     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1438     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1439     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1440     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1441     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1442     do
     1443     on error undo, return error
     1444     :
     1445       define buffer buf_usr-flt for ubflt.usr-flt .
     1446       define variable v-use-List_     as logical   no-undo .
     1447       define variable v-type-List_     as character no-undo .
     1448       define variable v-format-List_   as character no-undo .
     1449       define variable v-use-Naim      as logical   no-undo .
     1450       define variable v-type-Naim      as character no-undo .
     1451       define variable v-format-Naim    as character no-undo .
     1452       define variable v-use-print-graft as logical   no-undo .
     1453       define variable v-use-sort-gr     as logical   no-undo .
     1454       define variable v-use-type-price  as logical   no-undo .
     1455       define variable v-use-type-val    as logical   no-undo .
     1456       define variable v-label          as character no-undo .
     1457       define variable v-tooltip        as character no-undo .
     1458       define variable v-user-can-edit  as logical   no-undo .
     1459       define variable v-output-display as logical   no-undo .
     1460       define variable v-other          as character no-undo .
     1461       run uf-name in this-procedure
     1462          (input  entry(1, p-code, chr(4))
     1463         ,output v-use-List_
     1464         ,output v-type-List_
     1465         ,output v-format-List_
     1466         ,output v-use-Naim
     1467         ,output v-type-Naim
     1468         ,output v-format-Naim
     1469         ,output v-use-print-graft
     1470         ,output v-use-sort-gr
     1471         ,output v-use-type-price
     1472         ,output v-use-type-val
     1473         ,output v-label
     1474         ,output v-tooltip
     1475         ,output v-user-can-edit
     1476         ,output v-output-display
     1477         ,output v-other
     1478         ) no-error .
     1479       if error-status :error then do:
     1480         undo, return error return-value .
     1481       end.
     1482       find first buf_usr-flt no-lock where
     1483                  buf_usr-flt.Call-point     = p-code AND
     1484                  buf_usr-flt.user-name       = p-user-name
     1485         no-error .
     1486       if avail buf_usr-flt then do:
     1487         assign
     1488         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1489         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1490         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1491         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1492         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1493         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1494         .
     1495       end.
     1496       else do:
     1497         assign
     1498         p-List_        = (if v-use-List_       then "":U                    else ?)
     1499         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1500         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1501         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1502         p-type-price   = (if v-use-type-price  then no                      else ?)
     1503         p-type-val     = (if v-use-List_       then no                      else ?)
     1504         .
     1505       end.
     1506     end.
     1507   end procedure.
     1508   procedure uf-set :
     1509     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1510     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1511     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1512     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1513     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1514     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1515     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1516     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1517     do
     1518     on error undo, return error
     1519     :
     1520       define buffer buf_usr-flt for ubflt.usr-flt .
     1521       define variable v-use-List_     as logical   no-undo .
     1522       define variable v-type-List_     as character no-undo .
     1523       define variable v-format-List_   as character no-undo .
     1524       define variable v-use-Naim      as logical   no-undo .
     1525       define variable v-type-Naim      as character no-undo .
     1526       define variable v-format-Naim    as character no-undo .
     1527       define variable v-use-print-graft as logical   no-undo .
     1528       define variable v-use-sort-gr   as logical   no-undo .
     1529       define variable v-use-type-price as logical   no-undo .
     1530       define variable v-use-type-val  as logical   no-undo .
     1531       define variable v-tooltip        as character no-undo .
     1532       define variable v-label          as character no-undo .
     1533       define variable v-user-can-edit  as logical   no-undo .
     1534       define variable v-output-display as logical   no-undo .
     1535       define variable v-other          as character no-undo .
     1536       run uf-name in this-procedure
     1537         (input  entry(1, p-code, chr(4))
     1538         ,output v-use-List_
     1539         ,output v-type-List_
     1540         ,output v-format-List_
     1541         ,output v-use-Naim
     1542         ,output v-type-Naim
     1543         ,output v-format-Naim
     1544         ,output v-use-print-graft
     1545         ,output v-use-sort-gr
     1546         ,output v-use-type-price
     1547         ,output v-use-type-val
     1548         ,output v-label
     1549         ,output v-tooltip
     1550         ,output v-user-can-edit
     1551         ,output v-output-display
     1552         ,output v-other
     1553         ) no-error .
     1554       if error-status :error then do:
     1555         undo, return error return-value .
     1556       end.
     1557       find first buf_usr-flt where
     1558                  buf_usr-flt.Call-point     = p-code AND
     1559                  buf_usr-flt.user-name       = p-user-name
     1560         no-error .
     1561       if not avail buf_usr-flt then do:
     1562           create buf_usr-flt .
     1563           assign
     1564           buf_usr-flt.call-point = p-code
     1565           buf_usr-flt.user-name  = p-user-name
     1566           .
     1567       end.
     1568       if avail buf_usr-flt then do:
     1569        assign
     1570        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1571        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1572        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1573        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1574        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1575        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1576       .
     1577       release buf_usr-flt.
     1578       end.
     1579       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1580     end.
     1581   end procedure.
     1582   define temp-table temp-err no-undo  LIKE ub.rep-line
