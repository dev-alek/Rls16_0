     1967    run rep/runexcel.p ( string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1968    end.
     1969   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1970   procedure macr_excel_char :
     1971    do
     1972    on error undo, return error return-value
     1973    :
     1974    define input parameter  p-val as character no-undo .
     1975    define input parameter  p-row as integer no-undo .
     1976    define input parameter  p-col as integer no-undo .
     1977    if p-val = ? then p-val = "" .
     1978       put stream macr_excel unformatted
     1979             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1980    end.
     1981   end procedure.
     1982   procedure macr_excel_char_with_format :
     1983    do
     1984    on error undo, return error return-value
     1985    :
     1986    define input parameter  p-val as character no-undo .
     1987    define input parameter  p-row as integer no-undo .
     1988    define input parameter  p-col as integer no-undo .
     1989    if p-val = ? then p-val = "" .
     1990       put stream macr_excel unformatted
     1991             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1992       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1993       put stream macr_excel unformatted
     1994             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1995    end.
     1996   end procedure.
     1997   procedure macr_excel_cell_format :
     1998    do
     1999    on error undo, return error return-value
     2000    :
     2001    define input parameter  p-val    as character no-undo .
     2002    define input parameter  p-row    as integer   no-undo .
     2003    define input parameter  p-col    as integer   no-undo .
     2004    define input parameter  p-format as character no-undo .
     2005    if p-val = ? then p-val = "" .
     2006       put stream macr_excel unformatted
     2007             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2008       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2009       put stream macr_excel unformatted
     2010             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2011    end.
     2012   end procedure.
     2013   procedure macr_excel_sum :
     2014    do
     2015    on error undo, return error return-value
     2016    :
     2017    define input parameter  p-row as integer no-undo .
     2018    define input parameter  p-col as integer no-undo .
     2019    define input parameter  p-row1 as integer no-undo .
     2020    define input parameter  p-col1 as integer no-undo .
     2021    define input parameter  p-row2 as integer no-undo .
     2022    define input parameter  p-col2 as integer no-undo .
     2023       put stream macr_excel unformatted
     2024             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2025    end.
     2026   end procedure.
     2027   procedure macr_excel_dec :
     2028    do
     2029    on error undo, return error return-value
     2030    :
     2031    define input parameter  p-val as character no-undo .
     2032    define input parameter  p-row as integer   no-undo .
     2033    define input parameter  p-col as integer   no-undo .
     2034     if p-val = ? then p-val =  "" .
     2035      put  stream macr_excel unformatted
     2036           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2037    end.
     2038   end procedure.
     2039   procedure macr_cell_format :
     2040    do
     2041    on error undo, return error return-value
     2042    :
     2043    define input parameter  p-size   as integer   no-undo .
     2044    define input parameter  p-bold   as logical   no-undo .
     2045    define input parameter  p-italic as logical   no-undo .
     2046    define input parameter  p-color  as integer   no-undo .
     2047    define input parameter  p-row    as integer   no-undo .
     2048    define input parameter  p-col    as integer   no-undo .
     2049    define input parameter  p-row-2  as integer   no-undo .
     2050    define input parameter  p-col-2  as integer   no-undo .
     2051     if p-size = ? then p-size = 10 .
     2052     if p-bold = ? then p-bold = false .
     2053     if p-italic = ? then p-italic = false .
     2054     if p-row-2 = ? then p-row-2 = p-row .
     2055     if p-col-2 = ? then p-col-2 = p-col .
     2056     put  stream macr_excel unformatted
     2057      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2058     if p-color <> ? then do:
     2059        put  stream macr_excel unformatted
     2060          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2061     end.
     2062     put  stream macr_excel unformatted
     2063          substitute('format.font(,&1,&2,&3)' , p-size,
     2064                                           string ( p-bold  , "true/false" ) ,
     2065                                           string ( p-italic , "true/false" )
     2066                                           ) + chr(10) .
     2067    end.
     2068   end procedure.
     2069   procedure macr_cell_size :
     2070    do
     2071    on error undo, return error return-value
     2072    :
     2073    define input parameter  p-w   as integer   no-undo .
     2074    define input parameter  p-l   as integer   no-undo .
     2075    define input parameter  p-row    as integer   no-undo .
     2076    define input parameter  p-col    as integer   no-undo .
     2077    define input parameter  p-row-2  as integer   no-undo .
     2078    define input parameter  p-col-2  as integer   no-undo .
     2079     if p-row-2 = ? then p-row-2 = p-row .
     2080     if p-col-2 = ? then p-col-2 = p-col .
     2081     if p-w = ? then    p-w = 0 .
     2082     if p-l = ? then    p-l = 0 .
     2083    define variable s-w as character no-undo .
     2084    define variable s-l as character no-undo .
     2085    if p-w = 0 then s-w = "" .
     2086               else s-w = string(p-w)  .
     2087    if p-l = 0 then s-l = "" .
     2088               else s-l = string(p-l)  .
     2089   put  stream macr_excel unformatted
     2090        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2091   put  stream macr_excel unformatted
     2092        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2093   put  stream macr_excel unformatted
     2094        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2095    end.
     2096   end procedure.
     2097   procedure proc-print-header :
     2098    do
     2099    on error undo, return error return-value
     2100    :
     2101      find first sheetf .
     2102        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2103        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2104        var-1 =  num#str# .
     2105        repeat c-c = 1 to sheetf.excel-row-title :
     2106        num#str# = num#str# + 1 .
     2107        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2108        do c-i = 1 to p-var :
     2109           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2110           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2111           num#col# = c-i .
     2112           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2113           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2114        end.
     2115       c-i = 0.
     2116       end.
     2117       run macr_cell_format (
     2118           10       ,
     2119           true     ,
     2120           false    ,
     2121           35       ,
     2122           var-1 + 1,
     2123           1        ,
     2124           num#str# ,
     2125           num#col# )
     2126           .
     2127     put  stream macr_excel unformatted
     2128          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2129          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2130          .
     2131    end.
     2132   end procedure.
     2133   procedure end-proc :
     2134    do
     2135    on error undo, return error return-value
     2136    :
     2137     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2138     OUTPUT to VALUE (v-file-name) .
     2139     for each temp-param :
     2140       export  temp-param  .
     2141     end.
     2142    end.
     2143   end procedure.
     2144   procedure make-str-1 :
     2145    do
     2146    on error undo, return error return-value
     2147    :
     2148   define variable loc-sum-min1 as character no-undo .
     2149   define variable loc-sum-min2 as character no-undo .
     2150   define variable loc-sum-min3 as character no-undo .
     2151   define variable t-type       as character no-undo .
     2152   define variable lp-in-qnty     as decimal no-undo .
     2153   define variable lp-out-qnty    as decimal no-undo .
     2154   define variable lp-out-sum     as decimal no-undo .
     2155   define variable lp-Temp-rash   as decimal no-undo .
     2156   define variable lp-min-stock   as decimal no-undo .
     2157   define variable lp-qnty-sale   as decimal no-undo .
     2158   define variable lp-zero-day    as decimal no-undo .
     2159   define variable lp-in-out-qnty as decimal no-undo .
     2160   define variable lp-supp-qnty   as decimal no-undo .
     2161   define variable lp-qnty-kassa  as decimal no-undo .
     2162   define variable lp-qnty-stk    as decimal no-undo .
     2163   define variable lp-qnty-prih   as decimal no-undo .
     2164   define variable lp-qnty-rash   as decimal no-undo .
     2165    reportname =  "Расчет потребности товаров"    .
     2166    run mf in this-procedure .
     2167    num#str#  = 1 .
     2168   if NOT p-val-rad then do :
     2169       num#col# = new-n(v-first-column) .
     2170       run macr_excel_char_with_format in this-procedure ( reportname , num#str# , num#col#  ).
     2171       run macr_cell_format in this-procedure
     2172         ( 12    ,
     2173           true  ,
     2174           false ,
     2175           ?     ,
     2176           num#str# ,
     2177           num#col# ,
     2178           ? ,
     2179           ?         ) .
     2180       reportheader =   cur-time-print() .
     2181       num#str# = num#str# + 1 .
     2182       p-name = "Дата печати: " + string( today ,"99/99/9999") .
     2183       run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2184       num#str# = num#str# + 1 .
     2185       p-name = "Планируемая дата доставки: " + string( p-ship-date,"99/99/9999") +
     2186                ". Период продаж с: "         + string( date-sale-1,"99/99/9999") +
     2187                              " по "          + string( date-sale-2,"99/99/9999") .
     2188       run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2189   end.
     2190   else do :
     2191       num#col# = 1 .
     2192       run macr_excel_char_with_format in this-procedure ( reportname , num#str# , num#col#  ).
     2193       run macr_cell_format in this-procedure
     2194         ( 12    ,
     2195           true  ,
     2196           false ,
     2197           ?     ,
     2198           num#str# ,
     2199           num#col# ,
     2200           ? ,
     2201           ?         ) .
     2202       reportheader =   cur-time-print() .
     2203       num#str# = num#str# + 1 .
     2204       num#col# = 1 .
     2205       p-name = "Дата печати: " .
     2206       run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2207       num#col# = 4 .
     2208       run macr_excel_char_with_format in this-procedure ( string( today ,"99/99/9999") , num#str# , num#col#  ).
     2209       num#str# = num#str# + 1 .
     2210       num#col# = 1 .
     2211       p-name = "Планируемая дата доставки: " .
     2212       run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2213       num#col# = 4 .
     2214       run macr_excel_char_with_format in this-procedure ( string( p-ship-date,"99/99/9999") , num#str# , num#col#  ).
     2215       num#col# = 5 .
     2216       p-name = "Период продаж с: " .
     2217       run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2218       num#col# = 7 .
     2219       run macr_excel_char_with_format in this-procedure ( string( date-sale-1,"99/99/9999") , num#str# , num#col#  ).
     2220       num#col# = 8.
     2221       p-name = "по " .
     2222       run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2223       num#col# = 9 .
     2224       run macr_excel_char_with_format in this-procedure ( string( date-sale-2,"99/99/9999") , num#str# , num#col#  ).
     2225   end.
     2226    run macr_cell_format in this-procedure  (
     2227       10       ,
     2228       true     ,
     2229       false    ,
     2230       34       ,
     2231       4        ,
     2232       1        ,
     2233       4        ,
     2234       dr-col - 1 )
     2235       .
     2236    run macr_cell_format  in this-procedure (
     2237       10       ,
     2238       true     ,
     2239       false    ,
     2240       40       ,
     2241       4        ,
     2242       dr-col   ,
     2243       4        ,
     2244       max-col )
     2245       .
     2246   num#col# =  0 .
     2247   num#str# = num#str# + 1 .
     2248   num#col# = num#col# + 1 .
     2249   define variable p-fi as character no-undo .
     2250   define variable name-tt as character no-undo .
     2251   if loc-doc-type = 'ФП':U then do:
     2252       p-fi  = " по фирме " .
     2253   end.
     2254   else do:
     2255      p-fi  = " по объекту " .
     2256   end.
     2257   case R-algoritm :
     2258     when 2 then do:
     2259         name-tt =  "Темп продаж из списка" .
     2260     end.
     2261     when 4 then do:
     2262         name-tt =  "Максимальная продажа" .
     2263     end.
     2264     otherwise do:
     2265         name-tt =  "Темп продаж с " + String(date-1) + " по " + String(date-2) .
     2266     end.
     2267   end case.
     2268   num#col# = new-n(1).  run macr_excel_char_with_format in this-procedure ("Код товара"             , num#str# , num#col#  ) .
     2269   if not print-col-1 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2270   num#col# = new-n(2).  run macr_excel_char_with_format in this-procedure ("Артикул"                , num#str# , num#col#  ) .
     2271   if not print-col-2 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2272   num#col# = new-n(3).  run macr_excel_char_with_format in this-procedure ("Название товара"        , num#str# , num#col#  ) .
     2273   put  stream macr_excel unformatted  (if print-col-3 then 'COLUMN.WIDTH(30,,,,)' else 'COLUMN.WIDTH(0,,,,)')  skip.
     2274   num#col# = new-n(4).  run macr_excel_char_with_format in this-procedure ("Группа"                 , num#str# , num#col#  ) .
     2275   put  stream macr_excel unformatted  (if print-col-4 then 'COLUMN.WIDTH(30,,,,)' else 'COLUMN.WIDTH(0,,,,)')  skip.
     2276   num#col# = new-n(5).  run macr_excel_char_with_format in this-procedure ("Ед. изм."               , num#str# , num#col#  ) .
     2277   put  stream macr_excel unformatted  (if print-col-5 then 'COLUMN.WIDTH(4,,,,)'  else 'COLUMN.WIDTH(0,,,,)')  skip.
     2278   num#col# = new-n(6).  run macr_excel_char_with_format in this-procedure ("Код производителя "     , num#str# , num#col#  ).
     2279   if not print-col-6 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2280   num#col# = new-n(7).  run macr_excel_char_with_format in this-procedure ("Название производителя ", num#str# , num#col#  ).
     2281   put  stream macr_excel unformatted  (if print-col-7 then 'COLUMN.WIDTH(30,,,,)'  else 'COLUMN.WIDTH(0,,,,)')  skip.
     2282   num#col# = new-n(8).  run macr_excel_char_with_format in this-procedure ("Артикул контрагента"    , num#str# , num#col#  ) .
     2283   if not print-col-8 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2284   num#col# = new-n(9).  run macr_excel_char_with_format in this-procedure ("Ед.изм. контрагента"    , num#str# , num#col#  ) .
     2285   put  stream macr_excel unformatted  (if print-col-9 then 'COLUMN.WIDTH(5,,,,)'  else 'COLUMN.WIDTH(0,,,,)')  skip.
     2286   num#col# = new-n(10).   run macr_excel_char_with_format in this-procedure ("Срок хранения"        , num#str# , num#col#  ) .
     2287   if not print-col-10 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2288   num#col# = new-n(11).  run macr_excel_char_with_format in this-procedure ("Коэффициент пересчета ед.изм." , num#str# , num#col#  ) .
     2289   if not print-col-11 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2290   num#col# = new-n(12).  run macr_excel_char_with_format in this-procedure ("Количество в упаковке" , num#str# , num#col#  ) .
     2291   if not print-col-12 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2292   num#col# = new-n(13).  run macr_excel_char_with_format in this-procedure ( name-tt                , num#str# , num#col#  ) .
     2293   if not print-col-13 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2294   num#col# = new-n(14).  run macr_excel_char_with_format in this-procedure ( if R-algoritm = 2 then "Расход (не рассчитывается)" else "Расход с " + String(date-1) + " по " + String(date-2) , num#str# , num#col#  ) .
     2295   if not print-col-14 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2296   num#col# = new-n(15).  run macr_excel_char_with_format in this-procedure ("Дней без продаж и остатков" , num#str# , num#col#  ) .
     2297   if not print-col-15 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2298   num#col# = new-n(16).  run macr_excel_char_with_format in this-procedure ("Дней в продаже "       , num#str# , num#col#  ).
     2299   if not print-col-16 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2300   num#col# = new-n(17).  run macr_excel_char_with_format in this-procedure ("Остаток на " + String(to-day) , num#str# , num#col#  ) .
     2301   if not print-col-17 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2302   num#col# = new-n(18).  run macr_excel_char_with_format in this-procedure ("Приход "               , num#str# , num#col#  ) .
     2303   if not print-col-18 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2304   num#col# = new-n(32).  run macr_excel_char_with_format in this-procedure ("Название объекта"      , num#str# , num#col#  ) .
     2305   if not print-col-32 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2306   put  stream macr_excel unformatted  (if print-col-32 then 'COLUMN.WIDTH(20,,,,)'  else 'COLUMN.WIDTH(0,,,,)')  skip.
     2307   num#col# = new-n(33).  run macr_excel_char_with_format in this-procedure ("Расчет кол-во "        , num#str# , num#col#  ) .
     2308   if not print-col-33 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2309   put  stream macr_excel unformatted  (if print-col-33 then 'COLUMN.WIDTH(7,,,,)'  else 'COLUMN.WIDTH(0,,,,)')  skip.
     2310   num#col# = new-n(34).  run macr_excel_char_with_format in this-procedure ("Штрихкод производителя", num#str# , num#col#  ) .
     2311   if not print-col-34 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2312   put  stream macr_excel unformatted  (if print-col-34 then 'COLUMN.WIDTH(20,,,,)'  else 'COLUMN.WIDTH(0,,,,)')  skip.
     2313   define variable v-tooltip as character no-undo .
     2314   define variable v-label   as character no-undo .
     2315   if R-min-rest = 1 then do:
     2316       num#col# = new-n(19). run macr_excel_char_with_format in this-procedure ( "Минимальный остаток" , num#str# , num#col# ).
     2317       if not print-col-19 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2318       num#col# = new-n(20). run macr_excel_char_with_format in this-procedure ( "Уровень постоянного присутствия", num#str# , num#col# ).
     2319       if not print-col-20 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2320       num#col# = new-n(21). run macr_excel_char_with_format in this-procedure ( "Минимальный заказ" , num#str# , num#col# ).
     2321       if not print-col-21 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     2322   end.
