     2618             num#str# = num#str# + 1
     2619           .
     2620           if first-of(export-ras.obj-code) then do:
     2621             num#col# = v-first-column. run macr_excel_char in this-procedure ( substitute(" По объекту: &1", bufo_clients.obj-name), num#str# , num#col# ).
     2622             run macr_cell_format in this-procedure
     2623                       ( 10    ,
     2624                         true  ,
     2625                         false ,
     2626                         ?     ,
     2627                         num#str# ,
     2628                         1     ,
     2629                         ?     ,
     2630                         max-col     ) .
     2631             num#str# = num#str# + 1 .
     2632             assign
     2633                 s-in-qnty       = 0
     2634                 s-out-qnty      = 0
     2635                 s-out-sum       = 0
     2636                 s-supp-qnty     = 0
     2637                 s-qnty          = 0
     2638                 s-sum-rubl      = 0
     2639                 s-qnty-rashkassa= 0
     2640                 s-zero-day      = 0
     2641                 s-qnty-stk      = 0
     2642                 s-qnty-prih     = 0
     2643                 s-qnty-rash     = 0
     2644                 s-qnty-kassa    = 0
     2645                 s-min-stock     = 0
     2646                 s-service-order = 0
     2647                 s-min-order     = 0
     2648                 s-gds-way-all   = 0
     2649                 s-l-all-day     = 0
     2650               .
     2651           end.
     2652           num#col# = new-n(1).  run macr_excel_char_with_format in this-procedure ( export-ras.gds-code , num#str# , num#col#  ).
     2653           num#col# = new-n(2).  run macr_excel_char_with_format in this-procedure ( export-ras.artic    , num#str# , num#col#  ).
     2654           num#col# = new-n(3).  run macr_excel_char_with_format in this-procedure ( ub.goods.gds-name   , num#str# , num#col#  ).
     2655           num#col# = new-n(4).  run macr_excel_char_with_format in this-procedure ( ub.goods.grp-name   , num#str# , num#col#  ).
     2656           num#col# = new-n(5).  run macr_excel_char_with_format in this-procedure ( ub.goods.unit-base  , num#str# , num#col#  ).
     2657           num#col# = new-n(6).  run macr_excel_char_with_format in this-procedure ( export-ras.prod-type + " " + string(export-ras.prod-code) , num#str# , num#col#  ).
     2658           num#col# = new-n(7).  run macr_excel_char_with_format in this-procedure ( ub.clients.obj-name   , num#str# , num#col#  ).
     2659           num#col# = new-n(8).  run macr_excel_char_with_format in this-procedure ( export-ras.cli-art    , num#str# , num#col#  ).
     2660           num#col# = new-n(9).  run macr_excel_char_with_format in this-procedure ( export-ras.unit-cli   , num#str# , num#col#  ).
     2661           num#col# = new-n(10). run macr_excel_dec in this-procedure (  ub.goods.deadline         , num#str# , num#col#  ).
     2662           num#col# = new-n(11). run macr_excel_dec in this-procedure (  export-ras.cli-base-rate  , num#str# , num#col#  ).
     2663           num#col# = new-n(12). run macr_excel_dec in this-procedure (  ub.goods.qnty-cart        , num#str# , num#col#  ).
     2664           num#col# = new-n(13). run macr_excel_dec in this-procedure (  export-ras.Temp-rash  , num#str# , num#col#  ).
     2665           num#col# = new-n(14). run macr_excel_dec in this-procedure (  (export-ras.qnty-rash + export-ras.qnty-kassa) , num#str# , num#col#  ).
     2666           num#col# = new-n(15). run macr_excel_dec in this-procedure (  export-ras.zero-day   , num#str# , num#col#  ).
     2667           l-all-day =  export-ras.all-day  .   if l-all-day = ? then l-all-day = 0 .
     2668           num#col# = new-n(16). run macr_excel_dec in this-procedure ( l-all-day , num#str# , num#col# ).
     2669           num#col# = new-n(17). run macr_excel_dec in this-procedure ( export-ras.qnty-stk , num#str# , num#col# ).
     2670           num#col# = new-n(18). run macr_excel_dec in this-procedure ( export-ras.qnty-prih , num#str# , num#col# ).
     2671           num#col# = new-n(19). run macr_excel_dec in this-procedure ( export-ras.min-stock , num#str# , num#col# ).
     2672           num#col# = new-n(20). run macr_excel_dec in this-procedure ( export-ras.service-order , num#str# , num#col# ).
     2673           num#col# = new-n(21). run macr_excel_dec in this-procedure ( export-ras.min-order , num#str# , num#col# ).
     2674           num#col# = new-n(22). run macr_excel_char_with_format in this-procedure ( export-ras.obj-type + " " + string(export-ras.obj-code) , num#str# , num#col#  ).
     2675           num#col# = new-n(32). run macr_excel_char_with_format in this-procedure ( bufo_clients.obj-name , num#str# , num#col# ).
     2676           num#col# = new-n(23). run macr_excel_char_with_format in this-procedure ( export-ras.negative-rest , num#str# , num#col# ).
     2677           num#col# = new-n(24). run macr_excel_dec in this-procedure ( export-ras.gds-way-all , num#str# , num#col# ).
     2678           num#col# = new-n(25). run macr_excel_dec in this-procedure ( export-ras.qnty , num#str# , num#col# ).
     2679           num#col# = new-n(33). run macr_excel_dec in this-procedure ( export-ras.order-qnty , num#str# , num#col# ).
     2680           assign v-b-str = "".
     2681           for each buf_bar-code no-lock
     2682           where buf_bar-code.gds-code = export-ras.gds-code
     2683           :
     2684             for each buf_prod-bc no-lock
     2685               where buf_prod-bc.b-code = buf_bar-code.b-code
     2686                 :
     2687                 if available buf_prod-bc then do:
     2688                   if v-b-str = "" then do:
     2689                       assign v-b-str = buf_prod-bc.b-str .
     2690                   end.
     2691                   else do:
     2692                       assign v-b-str = v-b-str + "," + buf_prod-bc.b-str .
     2693                   end.
     2694                 end.
     2695             end.
     2696           end.
     2697           num#col# = new-n(34). run macr_excel_char_with_format in this-procedure ( v-b-str , num#str# , num#col#  ).
     2698           if g#type = 'ОФ':U and p-det-post then run spis-post in this-procedure .
     2699           for each tmp#zakaz-prn where tmp#zakaz-prn.artic     = export-ras.artic     and
     2700                                        tmp#zakaz-prn.prod-type = export-ras.prod-type and
     2701                                        tmp#zakaz-prn.prod-code = export-ras.prod-code and
     2702                                        tmp#zakaz-prn.obj-type  = export-ras.obj-type  and
     2703                                        tmp#zakaz-prn.obj-code  = export-ras.obj-code  no-lock
     2704           :
     2705               num#str# = num#str# + 1 .
     2706               find first gds-prt where gds-prt.node-code = tmp#zakaz-prn.prt-code .
     2707               num#col# = new-n(1).  run macr_excel_char_with_format in this-procedure ( export-ras.gds-code , num#str# , num#col#  ).
     2708               num#col# = new-n(3).  run macr_excel_char_with_format in this-procedure ( "__" + ub.goods.gds-name + " " + gds-prt.f-name  , num#str# , num#col#  ).
     2709               num#col# = new-n(4).  run macr_excel_char_with_format in this-procedure ( ub.goods.grp-name   , num#str# , num#col#  ).
     2710               num#col# = new-n(5).  run macr_excel_char_with_format in this-procedure ( ub.goods.unit-base  , num#str# , num#col#  ).
     2711               num#col# = new-n(6).  run macr_excel_char_with_format in this-procedure ( tmp#zakaz-prn.prod-type + " " + string(tmp#zakaz-prn.prod-code) , num#str# , num#col#  ).
     2712               num#col# = new-n(7).  run macr_excel_char_with_format in this-procedure ( ub.clients.obj-name , num#str# , num#col#  ).
     2713               num#col# = new-n(8).  run macr_excel_char_with_format in this-procedure ( export-ras.cli-art  , num#str# , num#col#  ).
     2714               num#col# = new-n(9).  run macr_excel_char_with_format in this-procedure ( export-ras.unit-cli , num#str# , num#col#  ).
     2715               num#col# = new-n(10). run macr_excel_dec in this-procedure (  ub.goods.deadline               , num#str# , num#col#  ).
     2716               num#col# = new-n(11). run macr_excel_dec in this-procedure (  export-ras.cli-base-rate        , num#str# , num#col#  ).
     2717               num#col# = new-n(12). run macr_excel_dec in this-procedure (  ub.goods.qnty-cart              , num#str# , num#col#  ).
     2718               num#col# = new-n(14). run macr_excel_dec in this-procedure (  tmp#zakaz-prn.qnty-sale , num#str# , num#col#  ).
     2719               find first bufo_clients no-lock
     2720                   where bufo_clients.obj-type = export-ras.obj-type
     2721                     and bufo_clients.obj-code = export-ras.obj-code
     2722                   no-error .
     2723               num#col# = new-n(22). run macr_excel_char_with_format in this-procedure ( export-ras.obj-type + " " + string(export-ras.obj-code) , num#str# , num#col#  ).
     2724               num#col# = new-n(32). run macr_excel_char_with_format in this-procedure ( bufo_clients.obj-name , num#str# , num#col# ).
     2725               num#col# = new-n(23). run macr_excel_char_with_format in this-procedure ( export-ras.negative-rest , num#str# , num#col# ).
     2726               num#col# = new-n(25). run macr_excel_dec in this-procedure ( tmp#zakaz-prn.qnty-ord , num#str# , num#col# ).
     2727           end.
     2728           find first tmp#zakaz-prn where tmp#zakaz-prn.artic     = export-ras.artic     and
     2729                                          tmp#zakaz-prn.prod-type = export-ras.prod-type and
     2730                                          tmp#zakaz-prn.prod-code = export-ras.prod-code and
     2731                                          tmp#zakaz-prn.obj-type  = export-ras.obj-type  and
     2732                                          tmp#zakaz-prn.obj-code  = export-ras.obj-code  no-lock no-error .
     2733           if available tmp#zakaz-prn and p-det-post and tog-det-prizn then num#str# = num#str# + 1 .
     2734           assign
     2735           s-qnty                =  s-qnty        +  export-ras.qnty
     2736           s-sum-rubl            =  s-sum-rubl    +  export-ras.sum-rubl
     2737           s-qnty-rashkassa      =  s-qnty-rashkassa +   (export-ras.qnty-rash + export-ras.qnty-kassa)
     2738           s-zero-day            =  s-zero-day    +  export-ras.zero-day
     2739           s-qnty-stk            =  s-qnty-stk    +  export-ras.qnty-stk
     2740           s-qnty-prih           =  s-qnty-prih   +  export-ras.qnty-prih
     2741           s-qnty-rash           =  s-qnty-rash   +  export-ras.qnty-rash
     2742           s-qnty-kassa          =  s-qnty-kassa  +  export-ras.qnty-kassa
     2743           s-min-stock           = (if R-min-rest = 2 then 0 else s-min-stock     ) +  export-ras.min-stock
     2744           s-service-order       = (if R-min-rest = 2 then 0 else s-service-order ) + export-ras.service-order
     2745           s-min-order           = (if R-min-rest = 2 then 0 else s-min-order     ) + export-ras.min-order
     2746           s-gds-way-all         =  s-gds-way-all   + export-ras.gds-way-all
     2747           s-l-all-day           =  s-l-all-day     +  l-all-day
     2748           ss-qnty                =  ss-qnty        +  export-ras.qnty
     2749           ss-sum-rubl            =  ss-sum-rubl    +  export-ras.sum-rubl
     2750           ss-qnty-rashkassa      =  ss-qnty-rashkassa +   (export-ras.qnty-rash + export-ras.qnty-kassa)
     2751           ss-zero-day            =  ss-zero-day    +  export-ras.zero-day
     2752           ss-qnty-stk            =  ss-qnty-stk    +  export-ras.qnty-stk
     2753           ss-qnty-prih           =  ss-qnty-prih   +  export-ras.qnty-prih
     2754           ss-qnty-rash           =  ss-qnty-rash   +  export-ras.qnty-rash
     2755           ss-qnty-kassa          =  ss-qnty-kassa  +  export-ras.qnty-kassa
     2756           ss-min-stock           =  ss-min-stock   +  export-ras.min-stock
     2757           ss-service-order       =  ss-service-order + export-ras.service-order
     2758           ss-min-order           =  ss-min-order     + export-ras.min-order
     2759           ss-gds-way-all         =  ss-gds-way-all   + export-ras.gds-way-all
     2760           ss-l-all-day           =  ss-l-all-day     + l-all-day
     2761           .
     2762           if p-det-post then run spis-post in this-procedure .
     2763           if last-of(export-ras.obj-code) and g#type = 'ФП':U and kol-obj > 1 then do:
     2764                   num#str# = num#str# + 1 .
     2765                   num#col# = v-first-column. run macr_excel_char in this-procedure ( substitute(" Итого по объекту &1", bufo_clients.obj-name), num#str# , num#col# ).
     2766                   num#col# = new-n(14). run macr_excel_dec in this-procedure (s-qnty-rashkassa , num#str# , num#col# ).
     2767                   num#col# = new-n(17). run macr_excel_dec in this-procedure (s-qnty-stk       , num#str# , num#col# ).
     2768                   num#col# = new-n(18). run macr_excel_dec in this-procedure (s-qnty-prih      , num#str# , num#col# ).
     2769                   num#col# = new-n(24). run macr_excel_dec in this-procedure (s-gds-way-all    , num#str# , num#col# ).
     2770                   num#col# = new-n(25). run macr_excel_dec in this-procedure (s-qnty           , num#str# , num#col# ).
     2771                   run macr_cell_format in this-procedure
     2772                             ( 10    ,
     2773                               true  ,
     2774                               false ,
     2775                               ?     ,
     2776                               num#str# ,
     2777                               1 ,
     2778                               ? ,
     2779                               max-col     ) .
     2780           end.
     2781       end.
     2782   end.
     2783   assign
     2784     num#str# = num#str# + 1
     2785     num#col# = 1
     2786     p-name = "END FILE":U
     2787   .
     2788   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2789   end.
     2790   end procedure.
     2791   procedure init-screen :
     2792    do
     2793    on error undo, return error return-value
     2794    :
     2795   find first ubflt.usr-flt  no-lock where
     2796            ubflt.usr-flt.user-name    = v-cntxt-userid and
     2797            ubflt.usr-flt.call-point   = "all-ord":U    no-error .
     2798            if not available ubflt.usr-flt  then do:
     2799               message error-status :get-message(1) .
     2800            end.
     2801   assign p-val = ubflt.usr-flt.list_ .
     2802   define variable v-nn as integer   no-undo .
     2803   define variable v-ii as integer   no-undo .
     2804   assign v-nn = num-entries(p-val).
     2805     do i = 1 to v-nn :
     2806        case  entry(1,(entry(i,p-val)), "=" ) :
     2807           when string( "R-min-rest" )        then R-min-rest  = integer(entry(2,(entry(i,p-val)), "=" )).
     2808           when string( "R-algoritm" )        then R-algoritm  = integer(entry(2,(entry(i,p-val)), "=" )).
     2809           when string( "R-algoritm2" )       then R-algoritm2 = integer(entry(2,(entry(i,p-val)), "=" )).
     2810           when string( "tmp-sale.tmp-code" ) then do:
     2811                find first ub.tmp-sale no-lock where ub.tmp-sale.tmp-code = entry(2,(entry(i,p-val)), "=" ) no-error.
     2812                if available ub.tmp-sale then do:
     2813                end.
     2814                else do:
     2815                end.
     2816           end.
     2817           when string( "SelectObject" ) then  do:
     2818                   SelectObject = string(entry(2,(entry(i,p-val)), "=" )) no-error .
     2819                end.
     2820           when string( "date-p-1"   ) then date-p-1    = date(entry(2,(entry(i,p-val)), "=" )).
     2821           when string( "date-p-2"   ) then date-p-2    = date(entry(2,(entry(i,p-val)), "=" )).
     2822           when string( "t-way"      ) then t-way       = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2823           when string( "t-rcv"      ) then t-rcv       = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2824           when string( "t-clos"     ) then t-clos      = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2825           when string( "t-rv"       ) then t-rv        = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2826           when string( "t-rvz"      ) then t-rvz       = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2827           when string( "t-rvc"      ) then t-rvc       = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2828           when string( "t-rvzc"     ) then t-rvzc      = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2829           when string( "t-sp"       ) then t-sp        = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2830           when string( "t-sppv"     ) then t-sppv      = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2831           when string( "t-sppv-2"   ) then t-sppv-2    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2832           when string( "t-sppv-3"   ) then t-sppv-3    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2833           when string( "t-sppv-4"   ) then t-sppv-4    = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2834           when string( "p-neg-sale" ) then p-neg-sale  = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2835           when string( "t-gar"      ) then t-gar       = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2836           when string( "t-min-zapas") then t-min-zapas = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2837           when string( "R-min-rest3") then R-min-rest3 = if (entry(2,(entry(i,p-val)), "=" )) = "yes" then true else false .
     2838           otherwise do:
     2839           end.
     2840        end case.
     2841     end.
     2842   assign
     2843     date-1 = date-p-1
     2844     date-2 = date-p-2
     2845   .
     2846     kol-obj = num-entries( entry(2,ubflt.usr-flt.list_,"&" ) , ",") - 1 .
     2847        if kol-obj  = ? then kol-obj  = 0 .
     2848   find first ubflt.usr-flt  no-lock where
     2849            ubflt.usr-flt.user-name    = v-cntxt-userid and
     2850            ubflt.usr-flt.call-point   = "selrdallo":U    no-error .
     2851            if available ubflt.usr-flt then do :
     2852               DO v-ii = 1 TO NUM-ENTRIES( ubflt.usr-flt.list_, chr(4)):
     2853                 CASE v-ii:
     2854                     WHEN 1 THEN DO:
     2855                       p-val-rad     = logical(entry(v-ii, ubflt.usr-flt.list_, chr(4))) .
     2856                     END.
     2857                     WHEN 2 THEN DO:
     2858                       p-val-gds-obj = logical(entry(v-ii, ubflt.usr-flt.list_, chr(4))) .
     2859                     END.
     2860                     WHEN 3 THEN DO:
     2861                       p-det-post    = logical(entry(v-ii, ubflt.usr-flt.list_, chr(4))) .
     2862                     END.
     2863                     WHEN 4 THEN DO:
     2864                       p-only-am     = logical(entry(v-ii, ubflt.usr-flt.list_, chr(4))) .
     2865                     END.
     2866                     WHEN 5 THEN DO:
     2867                       tog-det-prizn = logical(entry(v-ii, ubflt.usr-flt.list_, chr(4))) .
     2868                     END.
     2869                 end case.
     2870               end.
     2871            end.
     2872            else do:
     2873               assign
     2874                 p-val-rad = yes
     2875                 p-only-am = no
     2876               .
     2877            end.
     2878            if p-val-rad = yes then do :
     2879               assign
     2880                   p-val-gds-obj = yes
     2881               .
     2882            end.
     2883   find first ubflt.usr-flt  no-lock where
     2884            ubflt.usr-flt.user-name    = v-cntxt-userid and
     2885            ubflt.usr-flt.call-point   = "selcolallo":U    no-error .
     2886            if available ubflt.usr-flt then do :
     2887               assign p-val-col = ubflt.usr-flt.list_ .
     2888            end.
     2889   if p-val-col <> "" then do:
     2890     assign
     2891       print-col-1  = if p-val-rad then yes else logical(entry( 1 , p-val-col, chr(4)))
     2892       print-col-2  = if p-val-rad then yes else logical(entry( 2 , p-val-col, chr(4)))
     2893       print-col-3  = if p-val-rad then yes else logical(entry( 3 , p-val-col, chr(4)))
     2894       print-col-4  = if p-val-rad then yes else logical(entry( 4 , p-val-col, chr(4)))
     2895       print-col-5  = if p-val-rad then yes else logical(entry( 5 , p-val-col, chr(4)))
     2896       print-col-6  = if p-val-rad then yes else logical(entry( 6 , p-val-col, chr(4)))
     2897       print-col-7  = if p-val-rad then yes else logical(entry( 7 , p-val-col, chr(4)))
     2898       print-col-8  = if p-val-rad then yes else logical(entry( 8 , p-val-col, chr(4)))
     2899       print-col-9  = if p-val-rad then yes else logical(entry( 9 , p-val-col, chr(4)))
     2900       print-col-10 = if p-val-rad then yes else logical(entry( 10, p-val-col, chr(4)))
     2901       print-col-11 = if p-val-rad then yes else logical(entry( 11, p-val-col, chr(4)))
     2902       print-col-12 = if p-val-rad then yes else logical(entry( 12, p-val-col, chr(4)))
     2903       print-col-13 = if p-val-rad then yes else logical(entry( 13, p-val-col, chr(4)))
     2904       print-col-14 = if p-val-rad then yes else logical(entry( 14, p-val-col, chr(4)))
     2905       print-col-15 = if p-val-rad then yes else logical(entry( 15, p-val-col, chr(4)))
     2906       print-col-16 = if p-val-rad then yes else logical(entry( 16, p-val-col, chr(4)))
     2907       print-col-17 = if p-val-rad then yes else logical(entry( 17, p-val-col, chr(4)))
     2908       print-col-18 = if p-val-rad then yes else logical(entry( 18, p-val-col, chr(4)))
     2909       print-col-19 = if p-val-rad then yes else logical(entry( 19, p-val-col, chr(4)))
     2910       print-col-20 = if p-val-rad then yes else logical(entry( 20, p-val-col, chr(4)))
     2911       print-col-21 = if p-val-rad then yes else logical(entry( 21, p-val-col, chr(4)))
     2912       print-col-22 = if p-val-rad then yes else logical(entry( 22, p-val-col, chr(4)))
     2913       print-col-23 = if p-val-rad then yes else logical(entry( 23, p-val-col, chr(4)))
     2914       print-col-24 = if p-val-rad then yes else logical(entry( 24, p-val-col, chr(4)))
     2915       print-col-25 = if p-val-rad then yes else logical(entry( 25, p-val-col, chr(4)))
     2916       print-col-26 = if p-val-rad then yes else logical(entry( 26, p-val-col, chr(4)))
     2917       print-col-27 = if p-val-rad then yes else logical(entry( 27, p-val-col, chr(4)))
     2918       print-col-28 = if p-val-rad then yes else logical(entry( 28, p-val-col, chr(4)))
     2919       print-col-29 = if p-val-rad then yes else logical(entry( 29, p-val-col, chr(4)))
     2920       print-col-30 = if p-val-rad then yes else logical(entry( 30, p-val-col, chr(4)))
     2921       print-col-31 = if p-val-rad then yes else logical(entry( 31, p-val-col, chr(4)))
     2922       print-col-32 = if p-val-rad then yes else logical(entry( 32, p-val-col, chr(4)))
     2923       print-col-33 = if p-val-rad then yes else logical(entry( 33, p-val-col, chr(4)))
     2924       print-col-34 = if p-val-rad then yes else logical(entry( 34, p-val-col, chr(4)))
     2925     no-error .
     2926   end.
     2927   else do:
     2928     if p-val-rad then do:
     2929     assign
     2930         print-col-1  = yes
     2931         print-col-2  = yes
     2932         print-col-3  = yes
     2933         print-col-4  = yes
     2934         print-col-5  = yes
     2935         print-col-6  = yes
     2936         print-col-7  = yes
     2937         print-col-8  = yes
     2938         print-col-9  = yes
     2939         print-col-10 = yes
     2940         print-col-11 = yes
     2941         print-col-12 = yes
     2942         print-col-13 = yes
     2943         print-col-14 = yes
     2944         print-col-15 = yes
     2945         print-col-16 = yes
     2946         print-col-17 = yes
     2947         print-col-18 = yes
     2948         print-col-19 = yes
     2949         print-col-20 = yes
     2950         print-col-21 = yes
     2951         print-col-22 = yes
     2952         print-col-23 = yes
     2953         print-col-24 = yes
     2954         print-col-25 = yes
     2955         print-col-26 = yes
     2956         print-col-27 = yes
     2957         print-col-28 = yes
     2958         print-col-29 = yes
     2959         print-col-30 = yes
     2960         print-col-31 = yes
     2961         print-col-32 = yes
     2962         print-col-33 = yes
     2963         print-col-34 = yes
     2964     .
     2965     end.
     2966     else do:
     2967       message
     2968         "Не были выбраны колонки для печати!" skip
     2969         "В созданном файле данные будут скрыты!" skip
     2970       view-as alert-box information.
     2971     end.
     2972   end.
     2973   run uf-get in this-procedure (
     2974        input  'seqeallo':U
     2975       ,input  'adm'
     2976       ,output v-uf-List_
     2977       ,output v-uf-Naim
     2978       ,output v-uf-print-graft
     2979       ,output v-uf-sort-gr
     2980       ,output v-uf-type-price
     2981       ,output v-uf-type-val
     2982   )  no-error.
     2983   define variable iv as integer   no-undo .
     2984   define variable i-kol as integer   no-undo .
     2985   define variable st as character no-undo .
     2986   if v-uf-List_ <> "" then do:
     2987   i-kol = num-entries (v-uf-List_, chr(4)) .
     2988       repeat Iv = 1 to i-kol :
     2989         st = entry(Iv,v-uf-List_, chr(4)).
     2990         create tt-table.
     2991         assign
     2992           tt-table.id = integer(entry(1, st))
     2993           tt-table.new-id = integer(entry(2, st))
     2994         .
     2995       end.
     2996   end.
     2997   else do:
     2998       repeat Iv = 1 to 34 :
     2999         create tt-table.
     3000         assign
     3001           tt-table.id = iv
     3002           tt-table.new-id = iv
     3003         .
     3004       end.
     3005   end.
     3006   if p-val-col <> "" then do:
     3007     repeat i = 1 to num-entries(p-val-col, chr(4)) :
     3008        if entry( i , p-val-col, chr(4) ) = "yes" then do :
     3009          assign v-first-column = i .
     3010          leave.
     3011        end.
     3012     end.
     3013   end.
     3014   else do:
     3015     assign v-first-column = 1 .
     3016   end.
     3017    end.
     3018   end procedure.
     3019   procedure mf :
     3020    do
     3021    on error undo, return error return-value
     3022    :
     3023       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     3024       output stream  Macr_Excel to value(v-file-name) .
     3025       assign
     3026         v-ind = v-ind + 1
     3027         num#str# = 0
     3028       .
     3029    end.
     3030   end procedure.
     3031   procedure make-str-2 :
     3032    do
     3033    on error undo, return error return-value
     3034    :
     3035   assign
     3036     num#str# = 1
     3037     num#col# =  1
     3038   .
     3039   run macr_excel_char in this-procedure ( "Параметры расчета заказа", num#str# , num#col# ) .
     3040    run macr_cell_format in this-procedure
     3041             ( 12    ,
     3042               true  ,
     3043               false ,
     3044               15    ,
     3045               num#str# ,
     3046               1 ,
     3047               ? ,
     3048               3       ) .
     3049   define variable jjj     as integer   no-undo .
     3050   define variable pp-str  as character no-undo .
     3051   define variable pp-str2 as character no-undo .
     3052   define variable l-jj  as integer no-undo .
     3053   define variable l-len as integer no-undo .
     3054   define variable l-m   as integer no-undo .
     3055   define variable iii   as integer no-undo .
     3056   num#col# =  1.
     3057   define variable v-nn  as integer no-undo .
     3058   define variable v-nn2 as integer no-undo .
     3059   v-nn = num-entries ( e-method ,"chr(10)")  .
     3060       repeat iii = 1 to v-nn :
     3061           pp-str = entry (iii, e-method , "chr(10)").
     3062           v-nn2 = num-entries ( pp-str ,";") .
     3063             repeat jjj = 1 to v-nn2 :
     3064               pp-str2 = entry (jjj, pp-str , ";").
     3065               if pp-str2 <> "" and pp-str2 <> ? and  pp-str2 <> " " then do:
     3066                       l-len = length (pp-str2  ) .
     3067                       l-m = integer( l-len / 220 ) + 1 .
     3068                       do l-jj = 1 to  l-m  :
     3069                           num#str# = num#str# + 1 .
     3070                           run macr_excel_char in this-procedure (
     3071                               substring( pp-str2, (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .
     3072                       end.
     3073               end.
     3074             end.
     3075       end.
     3076    end.
     3077   end procedure.
     3078   procedure spis-post :
     3079    do
     3080    on error undo, return error return-value
     3081    :
     3082   define variable ig        as integer no-undo .
     3083   define variable v-pr-rubl as decimal no-undo .
     3084   define buffer buf_doc-line   for ub.doc-line .
     3085   if G#type = 'ОФ':U then do:
     3086     num#col# = new-n(25). run macr_excel_dec  in this-procedure ( export-ras.qnty        , num#str# , num#col#  ).
     3087     num#col# = new-n(26). run macr_excel_char in this-procedure ( v-cntxt-host-name-obj  , num#str# , num#col#  ).
     3088     num#col# = new-n(28). run macr_excel_char in this-procedure ('орг':U                  , num#str# , num#col#  ).
     3089     num#col# = new-n(29). run macr_excel_dec  in this-procedure ( v-cntxt-host-code-obj  , num#str# , num#col#  ).
     3090     num#col# = new-n(31). run macr_excel_char in this-procedure ( "*"                    , num#str# , num#col#  ).
     3091   end.
     3092   else do:
     3093    find first G#Customer no-error.
     3094    if not available G#Customer then do:
     3095       for each ub.cli-gds where ub.cli-gds.artic      = export-ras.artic      and
     3096                                ub.cli-gds.prod-code   = export-ras.prod-code  and
     3097                                ub.cli-gds.prod-type   = export-ras.prod-type  and
     3098                                ub.cli-gds.host-code   = v-cntxt-host-code-obj and
     3099                                ub.cli-gds.price-cli   > 0                     and
     3100                              ( ub.cli-gds.cancel-date = ? or
     3101                                ub.cli-gds.cancel-date > p-ship-date )
     3102                               no-lock ,
     3103           first ub.clients where  ub.clients.obj-type = ub.cli-gds.cli-type and
     3104                                   ub.clients.obj-code = ub.cli-gds.cli-code and
     3105                                 ( ub.clients.sup-gds  = true or
     3106                                   ub.clients.sup-cons = true)
     3107                               no-lock
     3108                               break by ub.cli-gds.price-cli :
     3109                     find first buf_doc-line no-lock where
     3110                                buf_doc-line.doc-code   = ub.cli-gds.in-code and
     3111                                buf_doc-line.artic      = ub.cli-gds.artic and
     3112                                buf_doc-line.prod-type  = ub.cli-gds.prod-type and
     3113                                buf_doc-line.prod-code  = ub.cli-gds.prod-code no-error
     3114                                 .
     3115                   if available buf_doc-line then do:
     3116                     assign
     3117                       v-pr-rubl = buf_doc-line.price-rubl
     3118                     .
     3119                   end.
     3120                   else do:
     3121                     assign
     3122                       v-pr-rubl = ub.cli-gds.price-cli / export-ras.cli-base-rate
     3123                     .
     3124                   end.
     3125                   assign
     3126                     Ig = Ig + 1
     3127                     num#col# = new-n(25)
     3128                   .
     3129                   if NOT p-val-gds-obj then do:
     3130                       run macr_excel_dec in this-procedure ( export-ras.qnty , num#str# , num#col#  ).
     3131                   end.
     3132                   else do:
     3133                     if kol-obj > 1 then do :
     3134                       run macr_excel_sum in this-procedure ( num#str# , num#col# , (v-stroka - kol-obj + 1 ) , num#col# , v-stroka , num#col#  ).
     3135                     end.
     3136                     else do:
     3137                       run macr_excel_dec in this-procedure ( export-ras.qnty , num#str# , num#col#  ).
     3138                     end.
     3139                   end.
     3140                   num#col# = new-n(26). run macr_excel_char in this-procedure (clients.obj-name +
     3141                                   if (cli-gds.cli-type = saletype And
     3142                                       cli-gds.cli-code = salecode )  then "    ЭТО РЕАЛИЗАЦИЯ !!!" else ""     , num#str# , num#col#  ).
     3143                   num#col# = new-n(27). run macr_excel_dec  in this-procedure (v-pr-rubl                       , num#str# , num#col#  ).
     3144                   num#col# = new-n(28). run macr_excel_char in this-procedure (ub.cli-gds.cli-type             , num#str# , num#col#  ).
     3145                   num#col# = new-n(29). run macr_excel_dec  in this-procedure (ub.cli-gds.cli-code             , num#str# , num#col#  ).
     3146                   num#col# = new-n(30). run macr_excel_char_with_format in this-procedure (ub.cli-gds.cli-art  , num#str# , num#col#  ).
     3147                   num#col# = new-n(31). run macr_excel_char in this-procedure ((If ig = 1 Then  "*" Else "")   , num#str# , num#col#  ).
     3148                   num#str# = num#str# + 1 .
     3149     end.
     3150    end.
     3151    else do:
     3152       for each G#Customer no-lock :
     3153           for each ub.cli-gds where ub.cli-gds.artic     = export-ras.artic      and
     3154                                   ub.cli-gds.prod-code   = export-ras.prod-code  and
     3155                                   ub.cli-gds.prod-type   = export-ras.prod-type  and
     3156                                   ub.cli-gds.host-code   = v-cntxt-host-code-obj and
     3157                                   ub.cli-gds.cli-type    = G#Customer.obj-type   and
     3158                                   ub.cli-gds.cli-code    = G#Customer.obj-code   and
     3159                                   ub.cli-gds.price-cli   > 0                     and
     3160                                 ( ub.cli-gds.cancel-date = ? or
     3161                                   ub.cli-gds.cancel-date > p-ship-date )
     3162                                   no-lock ,
     3163               first ub.clients where  ub.clients.obj-type = ub.cli-gds.cli-type and
     3164                                       ub.clients.obj-code = ub.cli-gds.cli-code and
     3165                                     ( ub.clients.sup-gds  = true or
     3166                                       ub.clients.sup-cons = true)
     3167                                   no-lock
     3168                                   break by ub.cli-gds.price-cli :
     3169                         find first buf_doc-line no-lock where
     3170                                   buf_doc-line.doc-code   = ub.cli-gds.in-code and
     3171                                   buf_doc-line.artic      = ub.cli-gds.artic and
     3172                                   buf_doc-line.prod-type  = ub.cli-gds.prod-type and
     3173                                   buf_doc-line.prod-code  = ub.cli-gds.prod-code no-error
     3174                                     .
     3175                       if available buf_doc-line then do:
     3176                         assign
     3177                           v-pr-rubl = buf_doc-line.price-rubl
     3178                         .
     3179                       end.
     3180                       else do:
     3181                         assign
     3182                           v-pr-rubl = ub.cli-gds.price-cli / export-ras.cli-base-rate
     3183                         .
     3184                       end.
     3185                       assign
     3186                         Ig = Ig + 1
     3187                         num#col# = new-n(25)
     3188                       .
     3189                       if NOT p-val-gds-obj then do:
     3190                           run macr_excel_dec in this-procedure ( export-ras.qnty , num#str# , num#col#  ).
     3191                       end.
     3192                       else do:
     3193                         if kol-obj > 1 then do :
     3194                           run macr_excel_sum in this-procedure ( num#str# , num#col# , (v-stroka - kol-obj + 1 ) , num#col# , v-stroka , num#col#  ).
     3195                         end.
     3196                         else do:
     3197                           run macr_excel_dec in this-procedure ( export-ras.qnty , num#str# , num#col#  ).
     3198                         end.
     3199                       end.
     3200                       num#col# = new-n(26). run macr_excel_char in this-procedure (clients.obj-name +
     3201                                       if (cli-gds.cli-type = saletype And
     3202                                           cli-gds.cli-code = salecode )  then "    ЭТО РЕАЛИЗАЦИЯ !!!" else ""     , num#str# , num#col#  ).
     3203                       num#col# = new-n(27). run macr_excel_dec  in this-procedure (v-pr-rubl                       , num#str# , num#col#  ).
     3204                       num#col# = new-n(28). run macr_excel_char in this-procedure (ub.cli-gds.cli-type             , num#str# , num#col#  ).
     3205                       num#col# = new-n(29). run macr_excel_dec  in this-procedure (ub.cli-gds.cli-code             , num#str# , num#col#  ).
     3206                       num#col# = new-n(30). run macr_excel_char_with_format in this-procedure (ub.cli-gds.cli-art  , num#str# , num#col#  ).
     3207                       num#col# = new-n(31). run macr_excel_char in this-procedure ((If ig = 1 Then  "*" Else "")   , num#str# , num#col#  ).
     3208                       num#str# = num#str# + 1 .
     3209         end.
     3210       end.
     3211    end.
     3212   end.
     3213   end.
     3214   end procedure.
     3215   procedure head-post :
     3216    do
     3217    on error undo, return error return-value
     3218    :
     3219   if G#type <> 'ОФ':U then do:
     3220       num#col# = new-n(26). run macr_excel_char_with_format in this-procedure ("Поставщики"        , num#str# , num#col#  ).
     3221       put  stream macr_excel unformatted  (if print-col-26 then 'COLUMN.WIDTH(30,,,,)' else 'COLUMN.WIDTH(0,,,,)')  skip.
     3222       num#col# = new-n(27). run macr_excel_char_with_format in this-procedure ("Цены  поставщиков" , num#str# , num#col#  ).
     3223       if not print-col-27 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     3224       num#col# = new-n(28). run macr_excel_char_with_format in this-procedure ("Тип"               , num#str# , num#col#  ).
     3225       put  stream macr_excel unformatted  (if print-col-28 then 'COLUMN.WIDTH(4,,,,)' else 'COLUMN.WIDTH(0,,,,)')  skip.
     3226       num#col# = new-n(29). run macr_excel_char_with_format in this-procedure ("Код"               , num#str# , num#col#  ).
     3227       if not print-col-29 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     3228       num#col# = new-n(30). run macr_excel_char_with_format in this-procedure ("Артикул поставщика", num#str# , num#col#  ).
     3229       if not print-col-30 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     3230       num#col# = new-n(31). run macr_excel_char_with_format in this-procedure ("Выбор поставщика"  , num#str# , num#col#  ).
     3231       if not print-col-31 then put  stream macr_excel unformatted  'COLUMN.WIDTH(0,,,,)'  skip.
     3232           put  stream macr_excel unformatted
     3233               substitute('patterns(1,,&1,true)', 3 ) + chr(10)  .
     3234           put  stream macr_excel unformatted
     3235               substitute('format.font(,,,,,,&1)' , 2 ) + chr(10) .
     3236   end.
     3237   if G#type = 'ОФ':U then do:
     3238       num#col# = new-n(26). run macr_excel_char_with_format in this-procedure ("Фирма" , num#str# , num#col#  ).
     3239       put  stream macr_excel unformatted  (if print-col-26 then 'COLUMN.WIDTH(30,,,,)' else 'COLUMN.WIDTH(0,,,,)')  skip.
     3240       num#col# = new-n(27). run macr_excel_char_with_format in this-procedure ("Тип"   , num#str# , num#col#  ).
     3241       put  stream macr_excel unformatted  (if print-col-27 then 'COLUMN.WIDTH(4,,,,)' else 'COLUMN.WIDTH(0,,,,)')  skip.
     3242       num#col# = new-n(29). run macr_excel_char_with_format in this-procedure ("Код"   , num#str# , num#col#  ).
     3243       num#col# = new-n(31). run macr_excel_char_with_format in this-procedure ("Выбор строки (будем заказывать - * )"  , num#str# , num#col#  ).
     3244   end.
     3245   end.
     3246   end procedure.
