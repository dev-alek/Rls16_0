     7911   def var v-total-road-tax-rubl     as decimal no-undo .
     7912   def var v-all-total-road-tax-base as decimal no-undo .
     7913   def var v-all-total-road-tax-rubl as decimal no-undo .
     7914   assign
     7915     p-road-tax-base = ?
     7916     p-road-tax-rubl = ?
     7917     .
     7918     Find first buff-goods no-lock where
     7919           buff-goods.artic     = p-artic and
     7920           buff-goods.prod-type = p-prod-type and
     7921           buff-goods.prod-code = p-prod-code
     7922           no-error .
     7923         if available buff-goods then do:
     7924              v-rec = recid (buff-goods).
     7925              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     7926   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7927     (
     7928        input p-artic
     7929     ,  input p-prod-type
