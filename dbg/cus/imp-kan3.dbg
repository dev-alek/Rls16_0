     7893       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     7894       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     7895       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     7896       define variable varinvatp-envd             as   character              no-undo.
     7897       define variable varinvatp-type             as   character              no-undo.
     7898   define buffer buf_trn-doc for ub.trn-doc  .
