     7956             and buf_parts.prod-code = p-prod-code
     7957             and buf_parts.status_   = no
     7958             and buf_parts.out-code  = 'free-zone':U
     7959             and buf_parts.qnty      > 0
     7960         on error undo, return error
     7961         :
