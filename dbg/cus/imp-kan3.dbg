        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter file-name     as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: 8c1a0fd433e1, 1120, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        6   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:53 2017 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: imp-kan3.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: cus/imp-kan3.p $":U .
        9   define variable vss-description as character no-undo init "Импорт  в документ ДНЦ для КАН".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69     define variable v-cntxt-db-num        as integer   no-undo .
       70     define variable v-cntxt-userid        as character no-undo .
       71     define variable v-cntxt-level         as character no-undo .
       72     define variable v-cntxt-host-code-obj as integer   no-undo .
       73     define variable v-cntxt-obj-type      as character no-undo .
       74     define variable v-cntxt-obj-code      as integer   no-undo .
       75     define variable v-cntxt-db-num-obj    as integer   no-undo .
       76     define variable v-cntxt-is-admin      as logical   no-undo .
       77   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       80   define variable par-type          as character no-undo.
       81   define variable v-value-character as character no-undo .
       82   define variable v-value-date      as date      no-undo .
       83   define variable v-value-decimal   as decimal   no-undo .
       84   define variable v-value-integer   as integer   no-undo .
       85   define variable v-value-logical   as logical   no-undo .
       86   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define temp-table x_obj-group no-undo like ub.clients  .
       88   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
       89   procedure metod-gop-obj :
       90     do
       91     on error undo, return error return-value
       92     :
       93   define input  parameter p-cntxt-db-num as integer   no-undo .
       94   define input  parameter p-gop-id       as integer   no-undo .
       95   define input  parameter p-gop-db-num   as integer   no-undo .
       96   define buffer buf1_clients for ub.clients  .
       97   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
       98   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
       99   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      100   for each  x_obj-group : delete x_obj-group. end.
      101   if p-gop-id = 0 or p-gop-id = ?  then do:
      102      if p-cntxt-db-num = 0  then do:
      103           for each buf1_clients no-lock where
      104                   (buf1_clients.obj-type = 'маг':U  or
      105                    buf1_clients.obj-type = 'скл':U  )
      106                   and
      107                   buf1_clients.db-num >= 0  and
      108                   buf1_clients.stts = 0
      109                   :
      110             create x_obj-group .
      111             assign
      112               x_obj-group.obj-code   = buf1_clients.obj-code
      113               x_obj-group.obj-type   = buf1_clients.obj-type
      114               x_obj-group.obj-name   = buf1_clients.obj-name
      115               x_obj-group.db-num     = buf1_clients.db-num
      116             .
      117           end.
      118      end.
      119      else do:
      120           for each buf1_clients no-lock where
      121                   (buf1_clients.obj-type = 'маг':U  or
      122                    buf1_clients.obj-type = 'скл':U  ) and
      123                    buf1_clients.db-num = p-cntxt-db-num  and
      124                    buf1_clients.stts = 0
      125                   :
      126             create x_obj-group .
      127             assign
      128               x_obj-group.obj-code   = buf1_clients.obj-code
      129               x_obj-group.obj-type   = buf1_clients.obj-type
      130               x_obj-group.obj-name   = buf1_clients.obj-name
      131               x_obj-group.db-num     = buf1_clients.db-num
      132             .
      133           end.
      134      end.
      135   end.
      136   else do:
      137         for each buf_db-grp-obj-price  where
      138                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      139                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      140                 buf_db-grp-obj-price.stts = 0  no-lock :
      141           for each buf1_clients no-lock where
      142                  (buf1_clients.obj-type = 'маг':U  or
      143                   buf1_clients.obj-type = 'скл':U  ) and
      144                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      145                   buf1_clients.stts = 0
      146                   :
      147             create x_obj-group .
      148             assign
      149               x_obj-group.obj-code   = buf1_clients.obj-code
      150               x_obj-group.obj-type   = buf1_clients.obj-type
      151               x_obj-group.obj-name   = buf1_clients.obj-name
      152               x_obj-group.db-num     = buf1_clients.db-num
      153             .
      154           end.
      155         end.
      156       for each buf_host-grp-obj-price where
      157               buf_host-grp-obj-price.gop-id     = p-gop-id and
      158               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      159               buf_host-grp-obj-price.stts = 0
      160               no-lock :
      161         for each buf1_clients no-lock where
      162                (buf1_clients.obj-type = 'маг':U  or
      163                 buf1_clients.obj-type = 'скл':U  ) and
      164                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      165                 buf1_clients.stts = 0
      166                 :
      167             find first x_obj-group no-lock  where
      168                       x_obj-group.obj-code   = buf1_clients.obj-code and
      169                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      170             if not available  x_obj-group then   create x_obj-group .
      171             assign
      172               x_obj-group.obj-code   = buf1_clients.obj-code
      173               x_obj-group.obj-type   = buf1_clients.obj-type
      174               x_obj-group.obj-name   = buf1_clients.obj-name
      175               x_obj-group.db-num     = buf1_clients.db-num
      176             .
      177         end.
      178       end.
      179       for each buf_obj-grp-obj-price where
      180               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      181               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      182               buf_obj-grp-obj-price.stts = 0
      183               no-lock :
      184         for each buf1_clients no-lock where
      185                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      186                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      187                   buf1_clients.stts     = 0
      188                   :
      189             find first  x_obj-group no-lock  where
      190                         x_obj-group.obj-code   = buf1_clients.obj-code and
      191                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      192             if not available  x_obj-group then   create x_obj-group .
      193             assign
      194               x_obj-group.obj-code   = buf1_clients.obj-code
      195               x_obj-group.obj-type   = buf1_clients.obj-type
      196               x_obj-group.obj-name   = buf1_clients.obj-name
      197               x_obj-group.db-num     = buf1_clients.db-num
      198             .
      199         end.
      200       end.
      201   end.
      202   end.
      203   end procedure.
      204   procedure metod-obj-in-gop :
      205   define input  parameter p-curr-db-num as integer   no-undo .
      206   define input  parameter p-obj-type as character no-undo .
      207   define input  parameter p-obj-code as integer   no-undo .
      208   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      209     do
      210     on error undo, return error return-value
      211     :
      212       empty temp-table x_grp-obj-price.
      213       for each buf_grp-obj-price where
      214                buf_grp-obj-price.stts = 0
      215                no-lock :
      216                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      217                  for each x_obj-group where
      218                           x_obj-group.obj-type = p-obj-type and
      219                           x_obj-group.obj-code = p-obj-code :
      220                       create  x_grp-obj-price.
      221                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      222                  end.
      223       end.
      224     end.
      225   end procedure.
      226   procedure metod-delobj-usr :
      227   define input  parameter p-pdf-id  as integer   no-undo .
      228   define input  parameter p-pdf-db  as integer   no-undo .
      229   define input  parameter p-plt-id  as integer   no-undo .
      230   define input  parameter p-plt-db-num as integer   no-undo .
      231   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      232     do
      233     on error undo, return error return-value
      234     :
      235   for each buf_price-doc-forming-attr no-lock  where
      236            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      237            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      238            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      239            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      240            buf_price-doc-forming-attr.attr-code begins "obj" :
      241      for each x_obj-group  where
      242               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      243               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      244        delete x_obj-group.
      245      end.
      246   end.
      247     if not can-find (first x_obj-group) then do:
      248        return "nullobj" .
      249     end.
      250   end.
      251   end procedure.
      252   procedure metod-obj-pdf :
      253   define input  parameter p-cntxt-db-num as integer   no-undo .
      254   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      255   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      256   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      257   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      258   define buffer buf_price-list-type for ub.price-list-type  .
      259   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      260     do
      261     on error undo, return error return-value
      262     :
      263    for each  x_obj-group : delete x_obj-group. end.
      264    find first buf_price-list-type no-lock where
      265               buf_price-list-type.plt-id = p-plt-id and
      266               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      267   if error-status :error then return error return-value .
      268    find first buf_price-doc-forming no-lock where
      269               buf_price-doc-forming.plt-id     = p-plt-id and
      270               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      271               buf_price-doc-forming.pdf-id     = p-pdf-id and
      272               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      273               no-error .
      274   if error-status :error then return error return-value .
      275     run metod-gop-obj in this-procedure (
      276         p-cntxt-db-num,
      277         buf_price-list-type.gop-id ,
      278         buf_price-list-type.gop-db-num
      279         ) no-error .
      280     run metod-delobj-usr in this-procedure (
      281       buf_price-doc-forming.pdf-id ,
      282       buf_price-doc-forming.pdf-db ,
      283       buf_price-doc-forming.plt-id ,
      284       buf_price-doc-forming.plt-db-num
      285       ) no-error .
      286     end.
      287   end procedure.
      288   function hvrdtax return logical (input parrecid as recid):
      289   define variable varresult as logical no-undo.
      290   run hvrdtax-proc (input parrecid, output varresult).
      291   return varresult.
      292   end function.
      293   procedure hvrdtax-proc:
      294   define input  parameter parrecid  as recid   no-undo.
      295   define output parameter parresult as logical no-undo.
      296   define buffer bf_goods for ub.goods.
      297   define buffer bf_units for ub.units.
      298   define buffer rt_tax   for ub.tax.
      299   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      300   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      301   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      302   if available rt_tax and
      303       can-find(first ub.tax-units No-LOCK WHERE
      304                      ub.tax-units.tax-code = rt_tax.tax-code AND
      305                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      306                                                       else assign parresult = no.
      307   end procedure.
      308   define new global shared variable g#library  as handle no-undo .
      309   define new global shared variable g#library2 as handle no-undo .
      310   define new global shared variable g#lib-trn  as handle no-undo .
      311   define new global shared variable g#lib-trn2 as handle no-undo .
      312   define new global shared variable g#lib-trn3 as handle no-undo .
      313   define new global shared variable g#lib-trn4 as handle no-undo .
      314   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      315   procedure doc-code:
      316   define input  parameter parmode          as   character           no-undo.
      317   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      318   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      319   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      320   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      321   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      322   define variable vardb-remote     as   logical             no-undo.
      323   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      324   define variable v-delimiter as character no-undo .
      325   do
      326   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      327   :
      328   find first buf_sys-ctrl no-lock .
      329   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      330     CASE parmode:
      331       when "main":u then do:
      332         if vardb-remote then do:
      333           assign
      334             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      335         end.
      336         else do:
      337           assign
      338             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      339         end.
      340       end.
      341       when "trio" then do:
      342         assign
      343           pardoc-code = replace (parroot-doc-code, "=", "*").
      344       end.
      345       otherwise do:
      346         assign
      347         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      348         no-error
      349         .
      350         if error-status:error  then do:
      351           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      352                                         ,chr(10)
      353                                         ,parmode
      354                                         ).
      355         end.
      356         if num-entries(parmode) = 1
      357         and parmode <> "chip":U
      358         and parmode <> "chip_s":U
      359         then do:
      360           assign
      361           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      362         end.
      363         else if (lookup("chip":U, parmode) > 0
      364                  or
      365                  lookup("chip_s":U, parmode) > 0) then do:
      366           assign
      367             vartemp-doc-code = parroot-doc-code.
      368           do while true:
      369             if index (vartemp-doc-code , ".") = 0 then
      370               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      371             else
      372               vartemp-doc-code  =
      373               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      374               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      375               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      376             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      377           end.
      378           assign
      379             pardoc-code = vartemp-doc-code.
      380         end.
      381       end.
      382     end CASE.
      383     if pardoc-code = '':U
      384     or (parroot-doc-code <> '':U
      385     and pardoc-code = parroot-doc-code) then do:
      386       undo, return error substitute("Ошибка при генерации номера документа&1"
      387                                     ,chr(10)).
      388     end.
      389   end.
      390   end. // procedure/method
      391   function get-doc-code-int64 returns int64
      392     ( input p-doc-code as character ) :
      393     define variable v-ind              as integer   no-undo .
      394     define variable v-num-entries      as integer   no-undo .
      395     define variable v-doc-code-int64   as int64     no-undo .
      396     define variable v-canonic-doc-code as character no-undo .
      397     assign
      398       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      399       v-canonic-doc-code = p-doc-code
      400     .
      401     do v-ind = 1 to v-num-entries
      402     :
      403       assign
      404         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      405       .
      406     end.
      407     assign
      408       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      409     .
      410     return v-doc-code-int64 .
      411   end. // function/method
      412   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      413   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      414   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
      415                                           local-doc-num as char).
      416   define buffer base-price        for ub.price-list.
      417   define variable local-main-code like ub.bar-code.b-code no-undo.
      418   define variable local-base-code like ub.bar-code.b-code no-undo.
      419     run prc-base-code (input local-bc, output local-base-code).
      420     find base-price no-lock where
      421          base-price.doc-num = local-doc-num and
      422          base-price.b-code  = local-base-code and
      423          base-price.price-type = "" no-error.
      424     if not available base-price then do:
      425       run prc-main-code (input local-bc, output local-main-code).
      426       find  base-price no-lock where
      427             base-price.doc-num = local-doc-num and
      428             base-price.b-code  = local-main-code and
      429             base-price.price-type = "" no-error.
      430     end.
      431     if available base-price then
      432       return (base-price.price-sale).
      433     else
      434       return (?).
      435   END FUNCTION.
      436   procedure prc-main-code:
      437   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      438   define output parameter local-main-code like ub.bar-code.b-code no-undo.
      439   define buffer local-bar-code        for ub.bar-code.
      440   define buffer local-goods           for ub.goods.
      441   define buffer main-code             for ub.bar-code.
      442   define buffer main-prt              for ub.gds-prt.
      443     local-main-code = ?.
      444     find local-bar-code no-lock where
      445          local-bar-code.b-code = local-bc no-error.
      446     if not available local-bar-code then
      447       return.
      448     find local-goods no-lock where
      449          local-goods.gds-code = local-bar-code.gds-code.
      450     find first  main-prt no-lock where
      451                 main-prt.upper-code = local-goods.prt-root.
      452     find  main-code no-lock where
      453           main-code.gds-code  = local-bar-code.gds-code and
      454           main-code.in-code   = "" and
      455           main-code.part-code = "" and
      456           main-code.unit-cli  = local-goods.unit-base and
      457           main-code.node-code = main-prt.node-code.
      458     local-main-code = main-code.b-code.
      459   end procedure.
      460   procedure prc-base-code:
      461   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      462   define output parameter local-base-code like ub.bar-code.b-code no-undo.
      463   define buffer local-bar-code for ub.bar-code.
      464   define buffer local-goods    for ub.goods.
      465   define buffer base-code      for ub.bar-code.
      466     local-base-code = ?.
      467     find local-bar-code no-lock where
      468          local-bar-code.b-code = local-bc no-error.
      469     if not available local-bar-code then
      470       return.
      471     find local-goods no-lock where
      472          local-goods.gds-code = local-bar-code.gds-code.
      473     find base-code no-lock where
      474          base-code.gds-code  = local-bar-code.gds-code and
      475          base-code.node-code = local-bar-code.node-code and
      476          base-code.in-code   = local-bar-code.in-code and
      477          base-code.part-code = local-bar-code.part-code and
      478          base-code.unit-cli  = local-goods.unit-base.
      479     local-base-code = base-code.b-code.
      480   end procedure.
      481   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      482   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      483   procedure prcreate-new-price-doc :
      484   do
      485   on error undo, return error return-value
      486   :
      487   define input  parameter p-curr-db-num  as integer   no-undo .
      488   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
      489   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
      490   define input  parameter p-plt-id       as integer   no-undo .
      491   define input  parameter p-plt-db-num   as integer   no-undo .
      492   define input  parameter p-pdf-id       as integer   no-undo .
      493   define input  parameter p-pdf-db-num   as integer   no-undo .
      494   define output parameter p-price-doc-recid  as recid                no-undo.
      495   define variable v-host-code         like ub.sysconf.host-code        no-undo.
      496   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
      497   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
      498   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
      499   define buffer buf_price-doc-forming for ub.price-doc-forming.
      500   define buffer buf_price-doc         for ub.price-doc.
      501   find first buf_price-doc-forming no-lock where
      502              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      503              buf_price-doc-forming.pdf-id     = p-pdf-id     and
      504              buf_price-doc-forming.plt-db-num = p-plt-db-num and
      505              buf_price-doc-forming.plt-id     = p-plt-id
      506              no-error .
      507   if not available buf_price-doc-forming and p-plt-id = ? then do:
      508      run create_new_price-doc-forming
      509           ( input p-obj-type ,
      510             input p-obj-code ,
      511             output p-pdf-db-num ,
      512             output p-pdf-id ,
      513             output p-plt-db-num ,
      514             output p-plt-id
      515             ).
      516       find first buf_price-doc-forming no-lock where
      517                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      518                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
      519                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
      520                 buf_price-doc-forming.plt-id     = p-plt-id
      521                 no-error .
      522   end.
      523       create buf_price-doc .
      524       run doc-code in this-procedure
      525       (input  "main",
      526        input  p-obj-type  ,
      527        input  p-obj-code  ,
      528        input  ?,
      529        output buf_price-doc.doc-num) no-error.
      530       if error-status:error then do:
      531         message vss-workfile vss-revision vss-description skip
      532                error-status :get-message(1)
      533               "Ошибка при генерации номера документа." return-value view-as alert-box error.
      534         return error.
      535       end.
      536   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      538     (input  p-obj-type
      539     ,input  p-obj-code
      540     ,output v-host-code
      541     )  .
      542       v-obj-current-date  = today .
      543       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
      544           v-base-rate   =  buf_price-doc-forming.base-rate  .
      545           v-base-scale  =  buf_price-doc-forming.base-scale .
      546       end.
      547       else do:
      548   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      549   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      550     (input  v-host-code
      551     ,input  v-obj-current-date
      552     ,output v-base-rate
      553     ,output v-base-scale
      554     )  .
      555       end.
      556      assign
      557       buf_price-doc.base-rate      = v-base-rate
      558       buf_price-doc.base-scale     = v-base-scale
      559       buf_price-doc.cr-db-num      = p-curr-db-num
      560       buf_price-doc.doc-date       = v-obj-current-date
      561       buf_price-doc.fact-num       = 0
      562       buf_price-doc.host-code      = v-host-code
      563       buf_price-doc.is-corr        = false
      564       buf_price-doc.is-del         = false
      565       buf_price-doc.obj-code       = p-obj-code
      566       buf_price-doc.obj-type       = p-obj-type
      567       buf_price-doc.out-code       = ""
      568       buf_price-doc.pdf-db         = p-pdf-db-num
      569       buf_price-doc.pdf-id         = p-pdf-id
      570       buf_price-doc.plt-db-num     = p-plt-db-num
      571       buf_price-doc.plt-id         = p-plt-id
      572       buf_price-doc.PS             = "@ "
      573       buf_price-doc.rest-base      = 0
      574       buf_price-doc.rest-last      = 0
      575       buf_price-doc.rest-qnty      = 0
      576       buf_price-doc.rest-sale      = 0
      577       buf_price-doc.sale-base      = 0
      578       buf_price-doc.status_        = 'новый':U
      579       .
      580       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
      581       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
      582       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
      583       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
      584       assign
      585           p-price-doc-recid = recid ( buf_price-doc )
      586       .
      587   end.
      588   end procedure.
      589   procedure prcreate-new-price-list :
      590   do
      591   on error undo, return error return-value
      592   :
      593   define input parameter p-price-doc-recid   as recid                    no-undo.
      594   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
      595   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
      596   define output parameter p-update           as logical                  no-undo.
      597   define variable kk as integer no-undo .
      598   define var v-b-code    like ub.bar-code.b-code     no-undo.
      599   define variable p-hostcode as int no-undo .
      600   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
      601   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
      602   define buffer buf_price-doc        for ub.price-doc.
      603   define buffer buf_price-list       for ub.price-list.
      604   define buffer buf_bar-code         for ub.bar-code.
      605   define buffer buf_goods            for ub.goods.
      606   define buffer buf_root_gds-prt     for ub.gds-prt.
      607   define buffer buf_gds-prt          for ub.gds-prt.
      608   find first buf_price-doc no-lock
      609        where recid( buf_price-doc ) = p-price-doc-recid
      610   .
      611   find first buf_goods no-lock
      612        where buf_goods.gds-code = p-gds-code
      613   .
      614   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      615     (input  p-gds-code
      616     ,input  ?
      617     ,output v-b-code
      618     ) no-error .
      619   if error-status :error
      620   then do:
      621       message
      622           "Не найден основной бар-код"
      623           skip "для товара "
      624           skip string(buf_goods.artic)
      625           skip buf_goods.gds-name
      626       view-as alert-box
      627       title "Ошибка при выполнении prcreate.i".
      628       undo, return error .
      629   end.
      630   find first buf_bar-code no-lock
      631        where buf_bar-code.b-code = v-b-code
      632   no-error.
      633   if error-status :error
      634   then do:
      635       message
      636           "Не найдена запись bar-code"
      637           skip "для товара "
      638           skip string(buf_goods.artic)
      639           skip buf_goods.gds-name
      640           skip "С основным бар-кодом"
      641           skip string(v-b-code)
      642       view-as alert-box
      643       title "Ошибка при выполнении prcreate.i".
      644       undo, return error .
      645   end.
      646   find first buf_root_gds-prt no-lock
      647        where buf_root_gds-prt.upper-code = buf_goods.prt-root
      648   .
      649   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
      650     and buf_bar-code.in-code <> ""
      651   then do:
      652       message
      653           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
      654           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
      655           view-as alert-box error.
      656       undo, return error.
      657   end.
      658   find first buf_gds-prt no-lock
      659        where buf_gds-prt.node-code = buf_bar-code.node-code
      660   .
      661   find first buf_price-list
      662        where buf_price-list.doc-num = buf_price-doc.doc-num
      663          and buf_price-list.b-code  = v-b-code
      664   no-error.
      665   if available buf_price-list
      666   then do:
      667       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
      668          skip "  Цена:   " buf_price-list.price-sale
      669          skip "Цена будет изменена"
      670       view-as alert-box warning.
      671       assign
      672           p-update = yes
      673       .
      674   end.
      675   else do:
      676   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      678     (input  buf_price-doc.obj-type
      679     ,input  buf_price-doc.obj-code
      680     ,output p-hostcode
      681     ) no-error .
      682   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      684     (input  buf_goods.gds-code
      685     ,input  '1':U
      686     ,input  ?
      687     ,input  p-hostcode
      688     ,input  buf_price-doc.obj-type
      689     ,input  buf_price-doc.obj-code
      690     ,output local_vat-pc
      691     ) no-error .
      692   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      694     (input  buf_goods.gds-code
      695     ,input  '2':U
      696     ,input  ?
      697     ,input  p-hostcode
      698     ,input  buf_price-doc.obj-type
      699     ,input  buf_price-doc.obj-code
      700     ,output local_slt-pc
      701     ) no-error .
      702       kk = kk + 1.
      703   define variable v-main-bar-code as integer   no-undo .
      704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      705     (input  buf_goods.gds-code
      706     ,input  ?
      707     ,output v-main-bar-code
      708     )  .
      709       create buf_price-list.
      710       assign
      711           buf_price-list.line-num    = kk
      712           buf_price-list.doc-num     = buf_price-doc.doc-num
      713           buf_price-list.b-code      = buf_bar-code.b-code
      714           buf_price-list.artic       = buf_goods.artic
      715           buf_price-list.prod-type   = buf_goods.prod-type
      716           buf_price-list.prod-code   = buf_goods.prod-code
      717           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
      718           buf_price-list.calc-method = 'Отсутствует':U
      719           buf_price-list.obj-type    = buf_price-doc.obj-type
      720           buf_price-list.obj-code    = buf_price-doc.obj-code
      721           buf_price-list.price-sale  = p-price-sale
      722           buf_price-list.vat-pc      = local_vat-pc
      723           buf_price-list.slt-pc      = local_slt-pc
      724           p-update                   = no
      725       .
      726   end.
      727   end.
      728   end procedure.
      729   procedure create_new_price-doc-forming :
      730   define input  parameter p-obj-type   as character no-undo .
      731   define input  parameter p-obj-code   as integer   no-undo .
      732   define output parameter p-pdf-db-num as integer   no-undo .
      733   define output parameter p-pdf-id     as integer   no-undo .
      734   define output parameter p-plt-db-num as integer   no-undo .
      735   define output parameter p-plt-id     as integer   no-undo .
      736   define buffer buf_price-list-type for ub.price-list-type  .
      737   define variable v-host-code  as integer   no-undo .
      738   define variable v-base-rate  as decimal   no-undo .
      739   define variable v-base-scale as integer   no-undo .
      740   define variable v-exch-rate  as decimal   no-undo .
      741   define variable v-exch-scale as integer   no-undo .
      742   define variable v-base as logical   no-undo .
      743     do
