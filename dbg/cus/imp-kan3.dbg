     5490         assign
     5491            temp-exp-partbc.b-code = buf-bar-code.b-code
     5492         .
     5493    end.
     5494   end.
     5495   for each  buf-price-list where
     5496             buf-price-list.pdf-id     = buf-price-doc-forming.pdf-id and
     5497             buf-price-list.plt-id     = buf-price-doc-forming.plt-id and
     5498             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5499             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5500             buf-price-list.b-code     <> p-main-code         and
     5501             buf-price-list.artic       = buf-goods.artic     and
     5502             buf-price-list.prod-type   = buf-goods.prod-type and
     5503             buf-price-list.prod-code   = buf-goods.prod-code ,
     5504       first buf-bar-code no-lock where
     5505             buf-bar-code.b-code   = buf-price-list.b-code and
     5506             buf-bar-code.unit-cli = buf-goods.unit-base and
     5507             buf-bar-code.in-code <> "" ,
     5508       first buf_parts no-lock where
     5509             buf_parts.out-code    = 'free-zone':U and
     5510             buf_parts.rsrv-free   = true  and
     5511             buf_parts.status_     = false and
     5512             buf_parts.artic       = buf-goods.artic and
     5513             buf_parts.prod-type   = buf-goods.prod-type and
     5514             buf_parts.prod-code   = buf-goods.prod-code and
     5515             buf_parts.obj-type   = v-cntxt-obj-type and
     5516             buf_parts.obj-code   = v-cntxt-obj-code and
     5517             buf_parts.part-code   = buf-bar-code.part-code and
     5518             buf_parts.in-code     = buf-bar-code.in-code
     5519             :
     5520             find first temp-exp-partbc where
     5521                        temp-exp-partbc.b-code = buf-bar-code.b-code no-error .
     5522           if available temp-exp-partbc then next.
     5523      run create-calc-bc in this-procedure
     5524          ( input  recid( new-price-doc-forming )
     5525           ,input  'Старая':U
     5526           ,input  0
     5527           ,input  'Отключено':U
     5528           ,input  0
     5529           ,input  buf-bar-code.b-code
     5530           ,input  buf-goods.gds-code
     5531           ,input  buf-goods.artic
     5532           ,input  buf-goods.prod-type
     5533           ,input  buf-goods.prod-code
     5534           ,input  new-price-doc-forming.base-rate
     5535           ,input  new-price-doc-forming.base-scale
     5536           ,input  new-price-doc-forming.exch-scale
     5537           ,input  new-price-doc-forming.exch-rate
     5538           ,input v-doc-code
     5539           ,input v-common-price
     5540           ,input v-copy-type
     5541           ,input v-copy-code
     5542           ,input-output v-line-num
     5543           ,input-output v-sec
     5544         ) no-error .
     5545         if error-status:error then do:
     5546           message
     5547             "Ошибка cre-pr-list.3" skip
     5548             "Код:" buf-bar-code.b-code
     5549             view-as alert-box.
     5550           next.
     5551         end.
     5552       end.
     5553     for each buf_parts no-lock where
     5554             buf_parts.out-code    = 'free-zone':U and
     5555             buf_parts.rsrv-free   = true  and
     5556             buf_parts.status_     = false and
     5557             buf_parts.artic       = buf-goods.artic and
     5558             buf_parts.prod-type   = buf-goods.prod-type and
     5559             buf_parts.prod-code   = buf-goods.prod-code and
     5560             buf_parts.obj-type    = v-cntxt-obj-type and
     5561             buf_parts.obj-code    = v-cntxt-obj-code and
     5562             buf_parts.part-code   = buf-bar-code.part-code and
     5563             buf_parts.in-code     = buf-bar-code.in-code,
     5564           first buf-bar-code no-lock where
     5565                 buf-bar-code.gds-code  = buf-goods.gds-code and
     5566                 buf-bar-code.unit-cli  = buf-goods.unit-base and
     5567                 buf-bar-code.in-code   = buf_parts.in-code and
     5568                 buf-bar-code.part-code = buf_parts.part-code
     5569             :
     5570             find first temp-exp-partbc where
     5571                        temp-exp-partbc.b-code = buf-bar-code.b-code no-error .
     5572           if available temp-exp-partbc then next.
     5573             find first new-price-doc-forming-gds where
     5574                        new-price-doc-forming-gds.pdf-id     = new-price-doc-forming.pdf-id and
     5575                        new-price-doc-forming-gds.pdf-db     = new-price-doc-forming.pdf-db and
     5576                        new-price-doc-forming-gds.plt-id     = new-price-doc-forming.plt-id and
     5577                        new-price-doc-forming-gds.plt-db-num = new-price-doc-forming.plt-db-num  and
     5578                        new-price-doc-forming-gds.b-code = buf-bar-code.b-code
     5579                        no-error .
     5580           if available new-price-doc-forming-gds then next.
     5581      run create-calc-bc in this-procedure
     5582          ( input recid( new-price-doc-forming )
     5583           ,input 'Старая':U
     5584           ,input 0
     5585           ,input 'Отключено':U
     5586           ,input 0
     5587           ,input buf-bar-code.b-code
     5588           ,input buf-goods.gds-code
     5589           ,input buf-goods.artic
     5590           ,input buf-goods.prod-type
     5591           ,input buf-goods.prod-code
     5592           ,input new-price-doc-forming.base-rate
     5593           ,input new-price-doc-forming.base-scale
     5594           ,input new-price-doc-forming.exch-scale
     5595           ,input new-price-doc-forming.exch-rate
     5596           ,input v-doc-code
     5597           ,input v-common-price
