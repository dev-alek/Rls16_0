     2727   FUNCTION fnc-base-price-doc RETURN decimal
     2728     ( local-bc as integer, p-recid as recid ).
     2729   define buffer   base-price       for ub.price-doc-forming-gds .
     2730   define variable local-main-code like ub.bar-code.b-code no-undo.
     2731   define variable local-base-code like ub.bar-code.b-code no-undo.
     2732   define buffer   buf_main-pdf     for ub.price-doc-forming .
     2733   find first buf_main-pdf no-lock where recid (buf_main-pdf) = p-recid .
     2734     run prc-base-code in this-procedure (input local-bc, output local-base-code).
     2735     find base-price no-lock where
     2736          base-price.pdf-id = buf_main-pdf.pdf-id and
     2737          base-price.pdf-db = buf_main-pdf.pdf-db and
     2738          base-price.plt-id = buf_main-pdf.plt-id and
     2739          base-price.plt-db-num = buf_main-pdf.plt-db-num and
     2740          base-price.b-code  = local-base-code
     2741          no-error.
     2742     if not available base-price then do:
     2743       run prc-main-code in this-procedure
     2744          ( input local-bc, output local-main-code ).
     2745       find  base-price no-lock where
     2746             base-price.pdf-id = buf_main-pdf.pdf-id and
     2747             base-price.pdf-db = buf_main-pdf.pdf-db and
     2748             base-price.plt-id = buf_main-pdf.plt-id and
     2749             base-price.plt-db-num = buf_main-pdf.plt-db-num and
     2750             base-price.b-code  = local-main-code
     2751             no-error.
     2752     end.
     2753     if available base-price then
     2754       return (base-price.price-sale-doc).
     2755     else
     2756       return (?).
     2757   END FUNCTION.
