     2644         end.
     2645       find first ub.contract-specif exclusive-lock where
     2646           ub.contract-specif.contract-num = p-contract-num and
     2647           ub.contract-specif.host-code    = p-host-code    and
     2648           ub.contract-specif.gds-code     = p-gds-code.
     2649           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2650   end.
