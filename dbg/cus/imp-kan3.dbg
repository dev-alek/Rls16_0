     4207               ( input ""            ,
     4208                 input 'Накладная':U ,
     4209                 input v1               ,
     4210                 input v2               ,
     4211                 input v3               ,
     4212                 input v-doc-code       ,
     4213                 input ""               ,
     4214                 input p-gds-code       ,
     4215                 input p-artic          ,
     4216                 input p-prod-type      ,
     4217                 input p-prod-code      ,
     4218                 input v4               ,
     4219                 input 0                ,
     4220                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-rubl else buf_gds-dtl.price-rubl ) ,
     4221                 input (if buf_trn-doc.ext-doc-type = 'ie':U then buf_doc-line.price-base else buf_gds-dtl.price-base ) ,
     4222                 output cost-base       ,
     4223                 output v4
     4224                 ) no-error .
     4225             end.
     4226             if not error-status :error then
     4227                 assign
     4228                   p-new-calc-method = 'Накладная':U + " " + v-doc-code
     4229                .
     4230       end.
     4231       when 'Переоценка':U then do:
     4232         find prev-list where
     4233              prev-list.b-code     = p-b-code and
     4234              prev-list.price-type = "" and
     4235              prev-list.doc-num    = v-doc-code no-lock no-error.
     4236         if available prev-list then
     4237           assign
     4238             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     4239             cur-rt-base = prev-list.road-tax
     4240             cur-rt-rubl = prev-list.road-tax
     4241             cost-rubl = prev-list.price-sale
     4242             cost-base = prev-list.price-sale
     4243             .
     4244         else
     4245           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     4246                   "- расчет невозможен."
     4247                   view-as alert-box information .
     4248       end.
     4249       when 'ДокФормЦены':U then do:
     4250       find first b_price-doc-forming no-lock where
     4251                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     4252                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     4253                  no-error .
     4254         find b_price-doc-forming-gds no-lock where
