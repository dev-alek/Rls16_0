     3329         if available prev-list then
     3330           assign
     3331             p-new-calc-method = 'Переоценка':U + " " + v-doc-code
     3332             cur-rt-base = prev-list.road-tax
     3333             cur-rt-rubl = prev-list.road-tax
     3334             cost-rubl = prev-list.price-sale
     3335             cost-base = prev-list.price-sale
     3336             .
     3337         else
     3338           message "Нет строки в переоценке :" v-doc-code "для товара :" p-artic
     3339                   "- расчет невозможен."
     3340                   view-as alert-box information .
     3341       end.
     3342       when 'ДокФормЦены':U then do:
     3343       find first b_price-doc-forming no-lock where
     3344                  b_price-doc-forming.pdf-id     = integer(entry(1,v-doc-code,"|")) and
     3345                  b_price-doc-forming.pdf-db     = integer(entry(2,v-doc-code,"|"))
     3346                  no-error .
     3347         find b_price-doc-forming-gds no-lock where
     3348              b_price-doc-forming-gds.b-code     = p-b-code and
     3349              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     3350              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     3351              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     3352              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     3353              no-error.
     3354         if available b_price-doc-forming-gds then
     3355           assign
     3356             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     3357             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     3358             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     3359             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     3360             cost-base   = b_price-doc-forming-gds.price-sale-base
     3361             .
     3362         else
     3363           message "Нет строки в ДНЦ :" integer(entry(1,v-doc-code,"|")) integer(entry(2,v-doc-code,"|")) skip
     3364                   "для товара :" skip
     3365                    "Бар-код" p-b-code     skip
     3366                    "Артикул" p-artic      skip
     3367                     p-prod-type  skip
     3368                     p-prod-code  skip
     3369                   "- расчет невозможен."
     3370                   view-as alert-box information .
     3371       end.
     3372       when 'Единая':U then do:
     3373           assign
     3374             p-new-calc-method = 'Единая':U + " " + string(common-price)
     3375             cost-rubl = common-price
     3376             cost-base = common-price
     3377             .
     3378       end.
     3379       when 'Объект':U then do:
     3380       find first buf_gds-obj no-lock where
     3381                  buf_gds-obj.gds-code = p-gds-code and
     3382                  buf_gds-obj.obj-type = v-copy-type and
     3383                  buf_gds-obj.obj-code = v-copy-code no-error .
     3384           if available buf_gds-obj then do:
     3385           assign
     3386             p-new-calc-method = 'Объект':U + " " + v-copy-type + string(v-copy-code)
     3387             cost-rubl = buf_gds-obj.price-sale
     3388             cost-base = buf_gds-obj.price-sale
     3389             .
     3390           end.
     3391           else do:
     3392               message "Нет товара на объекте :" v-copy-type v-copy-code skip
     3393                       "для товара :" p-artic  "- расчет невозможен."
     3394                       view-as alert-box information .
     3395           end.
     3396       end.
     3397      when 'Отсутствует':U or
     3398      when "" then do:
     3399         run str/mplnovat.p
     3400           ( input  'Отсутствует':U    ,
     3401             input  table x_obj-group ,
     3402             input  p-b-code    ,
     3403             input  p-artic     ,
     3404             input  p-prod-type ,
     3405             input  p-prod-code ,
     3406             input  0 ,
     3407             input  v-doc-code ,
     3408             input  p-vat-pc      ,
     3409             input  p-slt-pc      ,
     3410             output vd  ,
     3411             output vd  ,
     3412             output cost-base   ,
     3413             output cost-rubl   ,
     3414             output cur-rt-base ,
     3415             output cur-rt-rubl
     3416             ).
     3417             cost-rubl = vd * p-exch-rate / p-exch-scale .
     3418             cost-base = cost-rubl / p-base-rate * p-base-scale .
     3419             p-new-calc-method = 'Отсутствует':U .
     3420      end.
     3421      when 'Основная':U then do:
     3422      end.
     3423     when 'ПорогПр-НДС':U then do:
     3424       message 1.
     3425     end.
     3426     when 'ПорогПр+НДС':U then do:
     3427       message 2.
     3428     end.
     3429     when 'Производит':U
     3430        then do:
     3431         find first x_obj-group .
     3432   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3434   (  input  p-b-code
     3435    , input  x_obj-group.obj-type
     3436    , input  x_obj-group.obj-code
     3437    , output v-PriceWithVat
     3438    , output vd
     3439    , output v-prod-vat
     3440    , output v-str1
     3441    , output v-str1
     3442           ) no-error .
     3443         if vd = 0 or vd = ?  then do:
     3444           message "Нет ПН для товара :" p-artic  p-b-code
     3445                   "- расчет по производителю от последней приходной накладной невозможен."
     3446                   view-as alert-box question buttons OK-Cancel title "#2" update g#log as logical .
     3447         end.
     3448         else do:
     3449             cost-rubl = vd * p-exch-rate / p-exch-scale .
     3450             cost-base = cost-rubl / p-base-rate * p-base-scale .
     3451         end.
     3452     end.
     3453     when 'Произв-НДС':U
     3454       then do:
     3455         find first x_obj-group .
     3456   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3457   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     3458   (  input  p-b-code
     3459    , input  x_obj-group.obj-type
     3460    , input  x_obj-group.obj-code
     3461    , output vd
     3462    , output v-PriceWithVat
     3463    , output v-prod-vat
     3464    , output v-str1
     3465    , output v-str1
     3466           ) no-error .
     3467         if vd = 0 or vd = ?  then do:
     3468           message "Нет ПН для товара :" p-artic  p-b-code
     3469                   "- расчет по производителю от последней приходной накладной невозможен."
     3470                   view-as alert-box .
     3471         end.
     3472         else do:
     3473             cost-rubl = vd * p-exch-rate / p-exch-scale .
     3474             cost-base = cost-rubl / p-base-rate * p-base-scale .
     3475         end.
     3476       end.
     3477      otherwise do:
     3478        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     3479                  p-new-calc-method  skip
     3480                 "p-price-prev-doc " p-price-prev-doc  skip
     3481                 "mpl-lib ERR !!! " skip
     3482                 'артикул ' p-artic skip
     3483                 view-as alert-box information .
     3484      end.
     3485    end case.
     3486   run main-road-taxs in this-procedure
     3487     ( input p-artic     ,
     3488       input p-prod-type ,
     3489       input p-prod-code ,
     3490       input-output cur-rt-base ,
     3491       input-output cur-rt-rubl )
     3492       no-error .
     3493       if error-status :error then do:
     3494          message
     3495            error-status :get-message(1) skip
     3496            return-value skip
     3497            "main-road-taxs"
     3498            view-as alert-box error
     3499          .
     3500       end.
     3501     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     3502       return error "Не определен курс валюты документа" .
     3503     end.
     3504     if p-base-scale = 0  or  p-base-scale = ?  then do:
     3505        return error "Не определен курс базовой валюты " .
     3506     end.
     3507   if v-base = false then var-pr-r-b = "rubl":U .
     3508                     else var-pr-r-b =  "base":U .
     3509       if var-pr-r-b = "rubl":U then do:
     3510           case p-calc-method :
     3511            when 'ПорогПр-НДС':U then do:
     3512               message 3.
     3513            end.
     3514            when 'ПорогПр+НДС':U then do:
     3515                message 4.
     3516            end.
     3517            when 'Производит':U then do:
     3518               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)   .
     3519            end.
     3520            when 'Произв-НДС':U then do:
     3521               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 +  p-vat-pc / 100)  .
     3522            end.
     3523            otherwise do:
     3524               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     3525            end.
     3526           end case.
     3527           assign
     3528             p-price-calc-rubl  =  cost-rubl
     3529             p-road-tax-rubl    =  cur-rt-rubl
     3530             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     3531             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     3532             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     3533           .
     3534       end.
     3535       else dO:
     3536            case p-calc-method :
     3537            when 'ПорогПр-НДС':U then do:
     3538               message 5.
     3539            end.
     3540            when 'ПорогПр+НДС':U then do:
     3541                message 6.
     3542            end.
     3543            when 'Производит':U then do:
     3544               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     3545            end.
     3546            when 'Произв-НДС':U then do:
     3547               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     3548            end.
     3549            otherwise do:
     3550               p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     3551            end.
     3552            end case.
     3553           assign
     3554             p-price-calc-base  =  cost-base
     3555             p-road-tax-base    =  cur-rt-base
     3556             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     3557             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     3558             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     3559             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     3560             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     3561             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     3562           .
     3563       end.
     3564   case p-round-method :
     3565     when '9-окончание':U then do:
     3566       if p-price-sale-doc < 29 then do:
     3567         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     3568           assign
     3569             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     3570           .
     3571         end.
     3572       end.
     3573       else do:
     3574         if (p-price-sale-doc modulo 10) < 3 then do:
     3575           assign
     3576             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     3577                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     3578                   - 1 ) * 10
     3579                 + 9
     3580           .
     3581         end.
     3582         else do:
     3583           assign
     3584             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     3585                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     3586                   ) * 10
     3587                 + 9
     3588           .
     3589         end.
     3590         assign
     3591           p-price-sale-doc = round (p-price-sale-doc, 0)
     3592         .
     3593       end.
     3594     end.
     3595     when '9-99окончание':U then do:
     3596       if p-price-sale-doc < p-round-base then do:
     3597         assign
     3598           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     3599         .
     3600       end.
     3601       else do:
     3602         assign
     3603           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     3604         .
     3605       end.
     3606     end.
     3607     when 'Без-дробных':U then do:
     3608       assign
     3609         p-price-sale-doc = round (p-price-sale-doc, 0)
     3610       .
     3611     end.
     3612     when 'Произвольно':U then do:
     3613       if p-round-base <> 0 then do:
     3614         assign
     3615           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     3616         .
     3617         if p-price-sale-doc = 0 then do:
     3618           assign
     3619             p-price-sale-doc = p-round-base
     3620           .
     3621         end.
     3622       end.
     3623     end.
     3624     when 'Вверх':U then do:
     3625       if p-round-base <> 0 then do:
     3626         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     3627           assign
     3628             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     3629           .
     3630         end.
     3631       end.
     3632       if p-price-sale-doc = 0 then do:
     3633         assign
     3634           p-price-sale-doc = p-round-base
     3635         .
     3636       end.
     3637     end.
     3638     when 'Коэффициент':U then do:
     3639       if p-round-base <> 0 then do:
     3640         assign
     3641           p-price-sale-doc = p-price-sale-doc * p-round-base
     3642         .
     3643       end.
     3644     end.
     3645     when 'Отключено':U then do:
     3646     end.
     3647     otherwise do:
     3648       message
     3649         vss-workfile vss-revision vss-description skip
     3650         "Неизвестный метод округления продажной цены" skip
     3651         "round-method" p-round-method skip
     3652         "round-base"   p-round-base   skip
     3653         "price"        p-price-sale-doc             skip
     3654         view-as alert-box error .
     3655     end.
     3656   end.
     3657       if error-status :error then do:
     3658       message
     3659         error-status :get-message(1) skip
     3660         return-value skip
     3661         "pr-99"
     3662         view-as alert-box error
     3663       .
     3664       end.
     3665     p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale .
     3666     p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale .
     3667     p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale .
     3668     p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale .
     3669     p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale .
     3670     p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale .
     3671     p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale .
     3672     p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale .
     3673     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     3674     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     3675     p-prev-doc-code = if available bufold_price-doc-forming
     3676                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     3677                          else "" .
     3678     end.
     3679   end procedure.
     3680   PROCEDURE calc-price-line :
     3681   define input  parameter  p-calc-method      as character no-undo .
     3682   define input  parameter  p-increase-pc      as decimal   no-undo .
     3683   define input  parameter  p-round-method     as character no-undo .
     3684   define input  parameter  p-round-base       as decimal   no-undo .
     3685   define input  parameter  p-b-code           as integer   no-undo .
     3686   define input  parameter  p-gds-code         as integer   no-undo .
     3687   define input  parameter  p-artic            as character no-undo .
     3688   define input  parameter  p-prod-type        as character no-undo .
     3689   define input  parameter  p-prod-code        as integer   no-undo .
     3690   define input  parameter  p-base-rate        as decimal   no-undo .
     3691   define input  parameter  p-base-scale       as decimal   no-undo .
     3692   define input  parameter  p-exch-scale       as decimal   no-undo .
     3693   define input  parameter  p-exch-rate        as decimal   no-undo .
     3694   define input  parameter  v-doc-code         as character no-undo .
