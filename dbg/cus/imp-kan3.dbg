     4089     p-d-pcnt = 0 .
     4090   end.
     4091   case p-calc-method :
     4092      when 'Новая':U or
     4093      when 'Не-считать':U then do:
     4094       assign
     4095         p-new-calc-method = p-calc-method
     4096         cost-rubl = ?
     4097         cost-base = ?
     4098       .
     4099         if available buf_price-doc-forming then do:
     4100           assign
     4101             v-pdf-id      = buf_price-doc-forming.pdf-id
     4102             v-pdf-db-num  = buf_price-doc-forming.pdf-db
     4103             v-plt-id2     = buf_price-doc-forming.plt-id
     4104             v-plt-db-num2 = buf_price-doc-forming.plt-db-num
     4105           .
     4106           find first buf_buf_price-doc-forming-gds no-lock where
     4107                 buf_buf_price-doc-forming-gds.pdf-id =  v-pdf-id and
     4108                 buf_buf_price-doc-forming-gds.pdf-db =  v-pdf-db-num and
     4109                 buf_buf_price-doc-forming-gds.plt-id =  v-plt-id2     and
     4110                 buf_buf_price-doc-forming-gds.plt-db-num =  v-plt-db-num2 and
     4111                 buf_buf_price-doc-forming-gds.b-code =  p-b-code
     4112                 no-error .
     4113               if available buf_buf_price-doc-forming-gds then do:
     4114                   assign
     4115                     cost-rubl = buf_buf_price-doc-forming-gds.price-sale-rubl
     4116                     cost-base = buf_buf_price-doc-forming-gds.price-sale-base
     4117                   .
     4118               end.
     4119         end.
     4120      end.
     4121      when 'УчетнаяS':U  or
     4122      when 'Учет-рзрвS':U  or
     4123      when 'ПриходнаяS':U
     4124      then do:
     4125         run str/sgdsavrg.p
     4126         (   input  p-calc-method    ,
     4127             input  table x_obj-group ,
     4128             input  p-b-code    ,
     4129             input  p-artic     ,
     4130             input  p-prod-type ,
     4131             input  p-prod-code ,
     4132             output cost-base   ,
     4133             output cost-rubl   ,
     4134             output cur-rt-base ,
     4135             output cur-rt-rubl
     4136             ).
     4137      end.
     4138      when 'Учет-НДСS':U or
     4139      when 'Накл-безНДС':U or
     4140      when 'Стар-безНДС':U or
     4141      when 'Старая':U or
     4142      when 'Учет+накл':U or
     4143      when 'Уч+накл-НДС':U or
     4144      when 'Откат_цен':U then do:
     4145         run str/mplnovat.p
     4146           ( input  p-calc-method    ,
     4147             input  table x_obj-group ,
     4148             input  p-b-code    ,
     4149             input  p-artic     ,
     4150             input  p-prod-type ,
     4151             input  p-prod-code ,
     4152             input  0 ,
     4153             input  v-doc-code ,
     4154             input  p-vat-pc      ,
     4155             input  p-slt-pc      ,
     4156             output vd  ,
     4157             output vd  ,
     4158             output cost-base   ,
     4159             output cost-rubl   ,
     4160             output cur-rt-base ,
     4161             output cur-rt-rubl
     4162             ).
     4163      end.
     4164      when 'Накладная':U then do:
     4165           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = v-doc-code no-error .
     4166           find first buf_doc-line  no-lock where
     4167                     buf_doc-line.doc-code = v-doc-code      and
     4168                     buf_doc-line.artic    = p-artic         and
     4169                     buf_doc-line.prod-type   = p-prod-type  and
     4170                     buf_doc-line.prod-code   = p-prod-code no-error .
     4171           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     4172           find first buf_gds-dtl no-lock where
     4173                      buf_gds-dtl.doc-code  = v-doc-code   and
     4174                      buf_gds-dtl.artic     = p-artic      and
     4175                      buf_gds-dtl.prod-type = p-prod-type  and
     4176                      buf_gds-dtl.prod-code = p-prod-code  and
     4177                      buf_gds-dtl.prt-code  = buf_bar-code.node-code no-error .
     4178           assign
     4179             v1 = recid (buf_trn-doc)
     4180             v2 = recid (buf_doc-line)
     4181             v3 = recid (buf_gds-dtl)
     4182             v4  = buf_gds-dtl.prt-code
     4183             no-error .
     4184             if not v-base then do:
     4185               run str/pr-wbil.p
     4186               ( input ""            ,
