      793       p-plt-db-num  = ub.price-doc-forming.plt-db-num
      794       p-plt-id      = ub.price-doc-forming.plt-id
      795      .
      796     end.
      797   end procedure.
      798   procedure prcreate-new-price-doc-forming-gds :
      799   define input  parameter p-price-doc-forming-recid as recid  no-undo.
      800   define input  parameter p-obj-type   as character no-undo .
      801   define input  parameter p-obj-code   as integer   no-undo .
      802   define input  parameter par-pr-notls as character no-undo .
      803   define input  parameter par-pr-altex as character no-undo .
      804   define input  parameter par-pr-sclex as character no-undo .
      805   define input  parameter p-line-num    as integer   no-undo .
      806   define input  parameter p-gds-code    as integer   no-undo .
      807   define input  parameter p-price-sale  as decimal   no-undo .
      808   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      809   define buffer buf_goods for ub.goods  .
      810   define buffer buf_bar-code for ub.bar-code  .
      811   define buffer main_bar-code for ub.bar-code  .
      812   define variable main-b-code as integer   no-undo .
      813   define variable v-sec as integer   no-undo .
      814     do
      815     on error undo, return error return-value
      816     :
      817   define variable v-cur-dn as character no-undo .
      818   define variable v-cur-pr as decimal   no-undo .
      819   define variable v-cur-rt as decimal   no-undo .
      820   define variable v-cur-ex as decimal   no-undo .
      821   find first buf_price-doc-forming no-lock where
      822              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
      823              if error-status :error then return error .
      824   find first buf_goods no-lock where
      825              buf_goods.gds-code  = p-gds-code no-error .
      826              if error-status :error then return error .
      827   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      828     (input  buf_goods.gds-code
      829     ,input  ?
      830     ,output main-b-code
      831     ) no-error .
      832   run check-use-bar-code (main-b-code) no-error .
      833   if error-status :error then return .
      834   run create-line-pdf-mpl-lib (
      835        input buf_price-doc-forming.plt-db-num
      836       ,input buf_price-doc-forming.plt-id
      837       ,input buf_price-doc-forming.pdf-db
      838       ,input buf_price-doc-forming.pdf-id
