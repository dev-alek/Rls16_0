     6324           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     6325                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6326               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6327         assign
     6328           vat-cli-loc            = ?
     6329           slt-cli-loc            = ?
     6330           price-cli-with-tax-loc = ?.
     6331      end.
     6332      else do:
     6333                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     6334                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     6335                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     6336                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     6337                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     6338                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     6339                            use-index out-code no-lock:
     6340             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     6341                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     6342                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     6343                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     6344                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     6345                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     6346                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     6347                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     6348                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     6349                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     6350                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     6351                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     6352                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     6353                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     6354                         .
     6355         end.
     6356         ASSIGN
     6357           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6358           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6359           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6360           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6361           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6362           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     6363                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     6364           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     6365                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     6366           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     6367           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     6368           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     6369         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     6370         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     6371         if transport-base-loc = ? then transport-base-loc = 0.
     6372         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     6373         if other-base-loc     = ? then other-base-loc     = 0.
     6374         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     6375         assign
     6376           transport-cli-loc      = 0
     6377           other-cli-loc          = 0
     6378           road-tax-cli-loc       = ?
     6379           vat-cli-loc            = ?
     6380           slt-cli-loc            = ?
     6381           price-cli-with-tax-loc = ?.
     6382      end.
     6383   ASSIGN
     6384             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6385       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6386   .
     6387                 assign
     6388                   p-road-tax-rubl =  road-tax-rubl-loc
     6389                   p-road-tax-base =  road-tax-base-loc
     6390                   .
     6391               end.
     6392         end.
     6393     end.
     6394   end procedure.
     6395   procedure calc-sigma :
     6396    do
     6397    on error undo, return error return-value
     6398    :
     6399   define input parameter l-bcode like ub.price-list.b-code no-undo .
     6400   define input-output parameter new-price as decimal no-undo .
     6401   define input parameter l-host as integer no-undo .
     6402   define input parameter l-code as integer no-undo .
     6403   define input parameter l-type as character no-undo .
     6404   define output parameter p-ret as logical no-undo .
     6405   define variable conf-par     as character no-undo.
     6406   define variable par-type     as character no-undo.
     6407   define variable i-sigma as decimal no-undo .
     6408   define variable cur-pr like ub.price-list.price-sale no-undo.
     6409   define variable cur-rt like ub.price-list.road-tax   no-undo.
     6410   define variable cur-ex like ub.price-list.excise     no-undo.
     6411   define variable cur-dn like ub.price-list.doc-num    no-undo.
     6412   define variable old-price as decimal no-undo .
     6413   p-ret = true  .
     6414   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     6415   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     6417     (input  l-type
     6418     ,input  l-code
     6419     ,input  l-bcode
     6420     ,input  0
     6421     ,input  0
     6422     ,output cur-dn
     6423     ,output cur-pr
     6424     ,output cur-rt
     6425     ,output cur-ex
     6426     )  .
     6427   old-price = cur-pr .
     6428   if old-price =  new-price then do:
     6429      p-ret = true .
     6430      return.
     6431   end.
     6432      i-sigma = decimal(par-pr-sigma) .
     6433      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     6434          p-ret = false .
     6435          new-price = old-price.
     6436          end.
     6437      else p-ret = true .
     6438   end.
     6439    end.
     6440   end procedure.
     6441   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6442   define variable var-pr-r-b as character no-undo .
     6443   define variable v-str2 as character no-undo .
     6444   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6446     (output var-pr-r-b
     6447     )  .
     6448   function f-base-code return integer ( p-b-code as integer ).
     6449     define variable main-b-code as integer   no-undo .
     6450     define buffer buf_bar-code for ub.bar-code  .
     6451     find first buf_bar-code no-lock where
     6452               buf_bar-code.b-code = p-b-code no-error .
     6453   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6454     (input  buf_bar-code.gds-code
     6455     ,input  ?
     6456     ,output main-b-code
     6457     )  .
     6458     return (main-b-code).
     6459   end function.
     6460   function fnc-cost-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     6461     define variable f-cost     as decimal no-undo .
     6462     define variable f-cost-pc  as decimal no-undo .
     6463     define variable v-qnty     as decimal no-undo .
     6464     define variable v-sum      as decimal no-undo .
     6465     define variable fact_price as decimal no-undo .
     6466     find first ub.goods where ub.goods.artic     = local-price-list.artic and
     6467                               ub.goods.prod-type = local-price-list.prod-type and
     6468                               ub.goods.prod-code = local-price-list.prod-code no-lock
     6469                               no-error .
     6470     assign
     6471       v-sum  =  0
     6472       v-qnty =  0
     6473       .
     6474     for each x_obj-group :
     6475         find ub.gds-obj no-lock where
     6476             ub.gds-obj.gds-code = ub.goods.gds-code and
     6477             ub.gds-obj.obj-type = x_obj-group.obj-type and
     6478             ub.gds-obj.obj-code = x_obj-group.obj-code no-error.
     6479         if  available ub.gds-obj then
     6480           if ub.goods.gds-type = 'т':U then
     6481             assign
     6482               v-sum  = v-sum  + ( if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base) * ub.gds-obj.avrg-qnty
     6483               v-qnty =  v-qnty + ub.gds-obj.avrg-qnty
     6484               .
     6485             else  v-sum = ?.
     6486         else v-sum = ?.
     6487     end.
     6488     f-cost = v-sum / v-qnty .
     6489     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     6490     f-cost-pc = ( round ( fact_price / f-cost , 2 ) -  1 ) * 100.
     6491     return (f-cost-pc).
     6492   end function.
     6493   function fnc-pr-pc return decimal (buffer local-price-list for ub.price-doc-forming-gds ).
     6494   define variable f-pr     as decimal no-undo .
     6495   define variable f-pr-pc  as decimal no-undo.
     6496   define variable v-qnty as decimal   no-undo .
     6497   define variable v-sum as decimal   no-undo .
     6498   define variable fact_price as decimal   no-undo .
     6499   find first ub.goods where ub.goods.artic = local-price-list.artic and
     6500                          ub.goods.prod-type = local-price-list.prod-type and
     6501                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     6502    assign
     6503      v-sum  =  0
     6504      v-qnty =  0
     6505      .
     6506   for each x_obj-group :
     6507   find ub.gds-obj no-lock where
     6508        ub.gds-obj.gds-code = ub.goods.gds-code and
     6509        ub.gds-obj.obj-type = x_obj-group.obj-type and
     6510        ub.gds-obj.obj-code = x_obj-group.obj-code  no-error .
     6511   if  available ub.gds-obj then do:
     6512     if ub.goods.gds-type = 'т':U then
     6513       assign
     6514         f-pr = (if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl else ub.gds-obj.last-base)
     6515         .
     6516       else f-pr = ?.
     6517   end.
     6518   else f-pr = ?.
     6519   end.
     6520     fact_price = if var-pr-r-b = "rubl" then local-price-list.price-sale-rubl else local-price-list.price-sale-base .
     6521     f-pr-pc = ( round( fact_price / f-pr , 2 ) - 1 ) * 100 .
     6522     return (f-pr-pc).
     6523   end function.
     6524   function fnc-cost return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     6525   define variable f-cost   as decimal no-undo .
     6526   find first  x_obj-group.
     6527   find first ub.goods where ub.goods.artic = local-price-list.artic and
     6528                          ub.goods.prod-type = local-price-list.prod-type and
     6529                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     6530   find ub.gds-obj no-lock where
     6531        ub.gds-obj.gds-code = ub.goods.gds-code  and
     6532        ub.gds-obj.obj-type = x_obj-group.obj-type and
     6533        ub.gds-obj.obj-code = x_obj-group.obj-code
     6534        no-error.
     6535   if  available ub.gds-obj then
     6536     if ub.goods.gds-type = 'т':U then
     6537       assign
     6538         f-cost = if var-pr-r-b = "rubl" then ub.gds-obj.avrg-rubl else ub.gds-obj.avrg-base
     6539         .
     6540       else  f-cost = ?.
     6541   else f-cost = ?.
     6542     return ( f-cost ).
     6543   end function.
     6544   function fnc-pr return decimal (buffer local-price-list for ub.price-doc-forming-gds).
     6545   define variable f-pr   as decimal no-undo .
     6546   find first x_obj-group .
     6547   find first ub.goods where ub.goods.artic = local-price-list.artic and
     6548                          ub.goods.prod-type = local-price-list.prod-type and
     6549                          ub.goods.prod-code = local-price-list.prod-code no-lock  no-error .
     6550   find ub.gds-obj no-lock where
     6551        ub.gds-obj.gds-code = ub.goods.gds-code and
     6552        ub.gds-obj.obj-type = x_obj-group.obj-type and
     6553        ub.gds-obj.obj-code = x_obj-group.obj-code
     6554        no-error.
     6555   if  available ub.gds-obj then
     6556     if ub.goods.gds-type = 'т':U then
     6557       assign
     6558         f-pr = if var-pr-r-b = "rubl" then ub.gds-obj.last-rubl  else ub.gds-obj.last-base
     6559         .
     6560       else  f-pr = ?.
     6561   else f-pr = ?.
     6562      return ( f-pr ).
     6563   end function.
     6564   procedure make-fact-order-lib3 :
     6565   define input  parameter p-recid as recid no-undo .
     6566   define output parameter p-fact-order-sys-from as decimal   no-undo .
     6567   define output parameter p-fact-order-sys-to   as decimal   no-undo .
     6568   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     6569   define buffer buf_price-list-type for ub.price-list-type  .
     6570   define variable v-shift-end-fact-order as decimal no-undo .
     6571   define variable v-day-end-fact-order   as decimal no-undo .
     6572   define variable v-fact-order           as decimal no-undo .
     6573     do
     6574     on error undo, return error return-value
     6575     :
     6576   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     6577     if error-status :error then return error error-status :get-message(1) .
     6578   find first buf_price-list-type  no-lock where
     6579              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     6580              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     6581     if error-status :error then return error error-status :get-message(1) .
     6582    if buf_price-doc-forming.have-start-period = 1 then do:
     6583       case buf_price-list-type.work-date :
     6584         when int('1':U)  then
     6585           do :
     6586              run day-begin-fact-order
     6587                   ( buf_price-doc-forming.start-date ,
     6588                    output p-fact-order-sys-from ) no-error .
     6589                    if error-status :error then
     6590                    return error substitute ( "Ошибка из day-begin-fact-order &1 &2" ,
     6591                                               error-status :get-message(1) ,
     6592                                               return-value ).
     6593           end.
     6594         when int('2':U)   then
     6595           do :
     6596             run factord (
     6597                input   buf_price-doc-forming.start-shift-date
     6598               ,input   buf_price-doc-forming.sys-time
     6599               ,input   1
     6600               ,input   buf_price-doc-forming.start-shift-date
     6601               ,input   buf_price-doc-forming.start-shift-num
     6602               ,input   true
     6603               ,output  p-fact-order-sys-from
     6604               ,output  v-shift-end-fact-order
     6605               ,output  v-day-end-fact-order
     6606               ) no-error  .
     6607               if error-status :error then
     6608                    return error substitute ( "Ошибка из factord &1 &2" ,
     6609                                               error-status :get-message(1) ,
     6610                                               return-value ).
     6611           end.
     6612         when int('3':U)   then
     6613           do :
     6614             run factord (
     6615               input    buf_price-doc-forming.start-sys-date
     6616               ,input   buf_price-doc-forming.start-sys-time
     6617               ,input   (if buf_price-doc-forming.start-sys-time = 0 or buf_price-doc-forming.start-sys-time = ? then 1 else buf_price-doc-forming.start-sys-time )
     6618               ,input   ?
     6619               ,input   ?
     6620               ,input   false
     6621               ,output  p-fact-order-sys-from
     6622               ,output  v-shift-end-fact-order
     6623               ,output  v-day-end-fact-order
     6624               ) no-error .
     6625               if error-status :error then
     6626                    return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     6627                                               error-status :get-message(1) ,
     6628                                               return-value ).
     6629           end.
     6630       end case.
     6631     end.
     6632    if buf_price-doc-forming.have-end-period = 1 then do:
     6633       case buf_price-list-type.work-date :
     6634         when int('1':U)   then
     6635           do :
     6636              run factord-end-day
     6637                 ( buf_price-doc-forming.end-date ,
     6638                   output p-fact-order-sys-to ) no-error .
     6639                   if error-status :error then
     6640                    return error substitute ( "Ошибка из factord-end-day дата на объекте на конец периода &1 &2" ,
     6641                                               error-status :get-message(1) ,
     6642                                               return-value ).
     6643           end.
     6644         when int('2':U)   then
     6645           do :
     6646             run factord (
     6647                input   buf_price-doc-forming.end-shift-date
     6648               ,input   buf_price-doc-forming.sys-time
     6649               ,input   1
     6650               ,input   buf_price-doc-forming.end-shift-date
     6651               ,input   buf_price-doc-forming.end-shift-num
     6652               ,input   true
     6653               ,output  v-fact-order
     6654               ,output  p-fact-order-sys-to
     6655               ,output  v-day-end-fact-order
     6656               ) no-error .
     6657               if error-status :error then
     6658                 return error substitute ( "Ошибка из factord сменная дата на конец &1 &2" ,
     6659                                           error-status :get-message(1) ,
     6660                                           return-value ).
     6661           end.
     6662         when int('3':U)   then
     6663           do :
     6664             run factord (
     6665                input   buf_price-doc-forming.end-sys-date
     6666               ,input   buf_price-doc-forming.end-sys-time
     6667               ,input   (if buf_price-doc-forming.end-sys-time  = 0 or buf_price-doc-forming.end-sys-time = ? then 1 else buf_price-doc-forming.end-sys-time )
     6668               ,input   ?
     6669               ,input   ?
     6670               ,input   false
     6671               ,output  p-fact-order-sys-to
     6672               ,output  v-shift-end-fact-order
     6673               ,output  v-day-end-fact-order
     6674               ) no-error .
     6675               if error-status :error then
     6676                 return error substitute ( "Ошибка из factord  - дата сервера &1 &2" ,
     6677                                           error-status :get-message(1) ,
     6678                                           return-value ).
     6679           end.
     6680       end case.
     6681     end.
     6682     end.
     6683   end procedure.
     6684   procedure ver-dfc-mpl-lib3 :
     6685   define input  parameter p-recid as recid no-undo .
     6686   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     6687   define buffer buf_price-list-type for ub.price-list-type  .
     6688   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     6689   define buffer buf_price-doc-forming-gds-qnty for ub.price-doc-forming-gds-qnty  .
     6690   define buffer buf_price-doc-sum  for ub.price-doc-forming-gds-sum  .
     6691   define buffer buf_price-doc-forming-gds-tnv  for ub.price-doc-forming-gds-tnv  .
     6692   define variable v-fact-order-sys-from   as decimal   no-undo .
     6693   define variable v-fact-order-sys-to     as decimal   no-undo .
     6694     do
     6695     on error undo, return error return-value
     6696    :
     6697   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming ) = p-recid no-error .
     6698     if error-status :error then return error error-status :get-message(1) .
     6699   find first buf_price-list-type  no-lock where
     6700              buf_price-list-type.plt-id = buf_price-doc-forming.plt-id and
     6701              buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     6702     if error-status :error then return error error-status :get-message(1) .
     6703     if buf_price-list-type.stts = integer('1':U) then do:
     6704        return error substitute(" ТПЛ &1 в статусе УДАЛЕН ! Закрывать с ним новые ДНЦ нельзя !" , buf_price-list-type.name )  .
     6705     end.
     6706     if buf_price-list-type.bgr-id > 0 then do:
     6707         find ub.buyer-group where
     6708               ub.buyer-group.stts       = 0  and
     6709               ub.buyer-group.bgr-db-num = buf_price-list-type.bgr-db-num and
     6710               ub.buyer-group.bgr-id     = buf_price-list-type.bgr-id
     6711               no-lock no-error .
     6712         if not available ub.buyer-group then
     6713         return error substitute(" ТПЛ &1 содержит некорректную группу по покупателям &2(&3) !" , buf_price-list-type.name,buf_price-list-type.bgr-id,buf_price-list-type.bgr-db-num )  .
     6714     end.
     6715     if buf_price-list-type.sgr-id > 0 then do:
     6716         find ub.sum-group where
     6717               ub.sum-group.stts       = 0  and
     6718               ub.sum-group.sgr-db-num = buf_price-list-type.sgr-db-num and
     6719               ub.sum-group.sgr-id     = buf_price-list-type.sgr-id
     6720               no-lock no-error .
     6721         if not available ub.sum-group then
     6722         return error substitute(" ТПЛ &1 содержит некорректную суммовую группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.sgr-id,buf_price-list-type.sgr-db-num )  .
     6723     end.
     6724     if buf_price-list-type.qgr-id > 0 then do:
     6725         find ub.qnty-group where
     6726              ub.qnty-group.stts       = 0  and
     6727              ub.qnty-group.qgr-db-num = buf_price-list-type.qgr-db-num and
     6728              ub.qnty-group.qgr-id     = buf_price-list-type.qgr-id
     6729              no-lock no-error .
     6730         if not available ub.qnty-group then
     6731         return error substitute(" ТПЛ &1 содержит некорректную количественную группу &2(&3) !" , buf_price-list-type.name,buf_price-list-type.qgr-id,buf_price-list-type.qgr-db-num )  .
     6732     end.
     6733     if buf_price-list-type.tog-id > 0 then do:
     6734         find ub.turnover-group where
     6735              ub.turnover-group.stts       = 0  and
     6736              ub.turnover-group.tog-db-num = buf_price-list-type.tog-db-num and
     6737              ub.turnover-group.tog-id     = buf_price-list-type.tog-id
     6738             no-lock no-error .
     6739         if not available ub.turnover-group then
     6740         return error substitute(" ТПЛ &1 содержит некорректную группу по оборотам &2(&3) !" , buf_price-list-type.name , buf_price-list-type.tog-id , buf_price-list-type.tog-db-num )  .
     6741     end.
     6742     if buf_price-list-type.gop-id > 0 then do:
     6743         find ub.grp-obj-price where
     6744               ub.grp-obj-price.stts       = 0  and
     6745               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num and
     6746               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id
     6747               no-lock no-error .
     6748         if not available ub.grp-obj-price then
     6749         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id,buf_price-list-type.gop-db-num )  .
     6750     end.
     6751     if buf_price-list-type.gop-id-for-calc-turnover > 0 then do:
     6752         find ub.grp-obj-price where
     6753               ub.grp-obj-price.stts       = 0  and
     6754               ub.grp-obj-price.gop-db-num = buf_price-list-type.gop-db-num-for-calc-turnover and
     6755               ub.grp-obj-price.gop-id     = buf_price-list-type.gop-id-for-calc-turnover
     6756               no-lock no-error .
     6757         if not available ub.grp-obj-price then
     6758         return error substitute(" ТПЛ &1 содержит некорректную группу по объектам &2(&3) !" , buf_price-list-type.name,buf_price-list-type.gop-id-for-calc-turnover,buf_price-list-type.gop-db-num-for-calc-turnover )  .
     6759     end.
     6760      if buf_price-doc-forming.have-start-period = integer(true) then do:
     6761         case buf_price-list-type.work-date :
     6762             when int('1':U)     then
     6763               do :
     6764                  if buf_price-doc-forming.start-date = ? then return error "Не задана дата начала действия цен !" .
     6765               end.
     6766             when int('2':U)   then
     6767               do :
     6768                   if buf_price-doc-forming.start-shift-date = ? then return error "Не задана сменная дата начала действия цен !" .
     6769                   if buf_price-doc-forming.start-shift-num  = ? or
     6770                      buf_price-doc-forming.start-shift-num = 0  then return error "Не задан порядок смены начала действия цен !" .
     6771               end.
     6772             when int('3':U)     then
     6773               do :
     6774                   if buf_price-doc-forming.start-sys-date = ? then return error "Не задана дата начала действия цен !" .
     6775                   if buf_price-doc-forming.start-sys-time = ? then return error "Не задано время начала действия цен !" .
     6776               end.
     6777         end case.
     6778      end.
     6779      if buf_price-doc-forming.have-end-period = integer(true) then do:
     6780         case buf_price-list-type.work-date :
     6781             when int('1':U)     then
     6782               do :
     6783                  if buf_price-doc-forming.end-date = ? then return error "Не задана дата окончания действия цен !" .
     6784               end.
     6785             when int('2':U)   then
     6786               do :
     6787                   if buf_price-doc-forming.end-shift-date = ? then return error "Не задана сменная дата окончания действия цен !" .
     6788                   if buf_price-doc-forming.end-shift-num  = ? or
     6789                      buf_price-doc-forming.end-shift-num = 0  then return error "Не задан порядок смены окончания  действия цен !" .
     6790               end.
     6791             when int('3':U)     then
     6792               do :
     6793                   if buf_price-doc-forming.end-sys-date = ? then return error "Не задана дата окончания действия цен !" .
     6794                   if buf_price-doc-forming.end-sys-time = ? then return error "Не задано время окончания действия цен !" .
     6795               end.
     6796         end case.
     6797      end.
     6798      if buf_price-doc-forming.have-start-period = integer(true) and
     6799         buf_price-doc-forming.have-end-period = integer(true) then do:
     6800         case buf_price-list-type.work-date :
     6801             when int('1':U)     then
     6802               do :
     6803                  if buf_price-doc-forming.end-date < buf_price-doc-forming.start-date then return error "Не верно задан интервал дат !" .
     6804               end.
     6805             when int('2':U)   then
     6806               do :
     6807                   if buf_price-doc-forming.end-shift-date < buf_price-doc-forming.start-shift-date then return error "Не верно задан интервал дат !" .
     6808                   if buf_price-doc-forming.end-shift-date = buf_price-doc-forming.start-shift-date then do:
     6809                      if buf_price-doc-forming.end-shift-num < buf_price-doc-forming.start-shift-num then return error "Не верно задан интервал смен !" .
     6810                   end.
     6811               end.
     6812             when int('3':U)     then
     6813               do :
     6814                   if buf_price-doc-forming.end-sys-date < buf_price-doc-forming.start-sys-date then return error "Не верно задан интервал дат !" .
     6815                   if buf_price-doc-forming.end-sys-date = buf_price-doc-forming.start-sys-date then do:
     6816                      if buf_price-doc-forming.end-sys-time < buf_price-doc-forming.start-sys-time then return error "Не верно задан интервал времени !" .
     6817                   end.
     6818               end.
     6819         end case.
     6820      end.
     6821   if buf_price-doc-forming.name = "" then return error "Не задано название ДНЦ !" .
     6822   if buf_price-list-type.main = false then do:
     6823       run make-fact-order-lib3 in this-procedure
     6824           ( input  p-recid ,
     6825             output v-fact-order-sys-from ,
     6826             output v-fact-order-sys-to   ) .
     6827   end.
     6828   define variable old-price as decimal   no-undo .
     6829   define variable v-kol-rec as integer   no-undo .
     6830   define variable v-gds-null-price as character no-undo initial "" .
     6831   define variable v-type as character no-undo .
     6832   v-kol-rec = 0.
     6833   for each buf_price-doc-forming-gds no-lock where
     6834            buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id      and
     6835            buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num  and
     6836            buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id      and
     6837            buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db      :
     6838       find first ub.bar-code no-lock where
     6839                  ub.bar-code.b-code = buf_price-doc-forming-gds.b-code no-error .
     6840                  if error-status :error then return error substitute ("Не найден бар-код &1" ,  buf_price-doc-forming-gds.b-code ) .
     6841       find first ub.goods no-lock where
     6842                  ub.goods.artic = buf_price-doc-forming-gds.artic         and
     6843                  ub.goods.prod-type = buf_price-doc-forming-gds.prod-type and
     6844                  ub.goods.prod-code = buf_price-doc-forming-gds.prod-code no-error .
     6845                  if error-status :error then return error substitute ("Не найден товар &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     6846       if ub.bar-code.gds-code <> ub.goods.gds-code then return error substitute ("Бар-код &4 не соответствует товару &1 &2 &3" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.b-code ) .
     6847       run gds-attr-value in this-procedure (input ub.goods.gds-code
     6848                                            ,input 'null-price':U
     6849                                            ,output v-gds-null-price
     6850                                            ,output v-type ) no-error .
     6851       if buf_price-doc-forming-gds.price-sale-doc   = ? or (buf_price-doc-forming-gds.price-sale-doc   = 0 and not logical(v-gds-null-price) )
     6852                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-doc  ) .
     6853       if buf_price-doc-forming-gds.price-sale-rubl  = ? or (buf_price-doc-forming-gds.price-sale-rubl  = 0 and not logical(v-gds-null-price) )
     6854                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-rubl ) .
     6855       if buf_price-doc-forming-gds.price-sale-base  = ? or (buf_price-doc-forming-gds.price-sale-base  = 0 and not logical(v-gds-null-price) )
     6856                   then return error substitute ("Продажная цена по товару &1 &2 &3 = &4" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds.price-sale-base ) .
     6857       if buf_price-doc-forming-gds.slt-pc = ? then return error substitute ("НсП по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     6858       if buf_price-doc-forming-gds.vat-pc = ? then return error substitute ("НДС по товару &1 &2 &3 не определен" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code) .
     6859   old-price = ? .
     6860     for each buf_price-doc-forming-gds-qnty no-lock where
     6861              buf_price-doc-forming-gds-qnty.plt-id = buf_price-doc-forming-gds.plt-id and
     6862              buf_price-doc-forming-gds-qnty.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     6863              buf_price-doc-forming-gds-qnty.pdf-id = buf_price-doc-forming-gds.pdf-id and
     6864              buf_price-doc-forming-gds-qnty.pdf-db = buf_price-doc-forming-gds.pdf-db and
     6865              buf_price-doc-forming-gds-qnty.b-code = buf_price-doc-forming-gds.b-code
     6866              by buf_price-doc-forming-gds-qnty.ggr-qnty :
     6867              if old-price < buf_price-doc-forming-gds-qnty.price-sale-doc and old-price <> ? then do:
     6868                 return error substitute ("Цена по товару &1 &2 &3 по категории количество покупки >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds-qnty.ggr-qnty ,old-price , buf_price-doc-forming-gds-qnty.price-sale-doc) .
     6869              end.
     6870              old-price = buf_price-doc-forming-gds-qnty.price-sale-doc .
     6871     end.
     6872   old-price = ? .
     6873     for each buf_price-doc-sum no-lock where
     6874              buf_price-doc-sum.plt-id     = buf_price-doc-forming-gds.plt-id and
     6875              buf_price-doc-sum.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     6876              buf_price-doc-sum.pdf-id     = buf_price-doc-forming-gds.pdf-id and
     6877              buf_price-doc-sum.pdf-db     = buf_price-doc-forming-gds.pdf-db and
     6878              buf_price-doc-sum.b-code     = buf_price-doc-forming-gds.b-code
     6879              by buf_price-doc-sum.ssg-summa
     6880              :
     6881              if old-price < buf_price-doc-sum.price-sale-doc and old-price <> ? then do:
     6882                 return error substitute ("Цена по товару &1 &2 &3 по категории сумма покупки >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-sum.ssg-summa , old-price , buf_price-doc-sum.price-sale-doc) .
     6883              end.
     6884              old-price = buf_price-doc-sum.price-sale-doc .
     6885     end.
     6886   old-price = ? .
     6887     for each buf_price-doc-forming-gds-tnv no-lock where
     6888              buf_price-doc-forming-gds-tnv.plt-id     = buf_price-doc-forming-gds.plt-id and
     6889              buf_price-doc-forming-gds-tnv.plt-db-num = buf_price-doc-forming-gds.plt-db-num and
     6890              buf_price-doc-forming-gds-tnv.pdf-id     = buf_price-doc-forming-gds.pdf-id and
     6891              buf_price-doc-forming-gds-tnv.pdf-db     = buf_price-doc-forming-gds.pdf-db and
     6892              buf_price-doc-forming-gds-tnv.b-code     = buf_price-doc-forming-gds.b-code
     6893              by buf_price-doc-forming-gds-tnv.ttg-summa :
     6894              if old-price < buf_price-doc-forming-gds-tnv.price-sale-doc and old-price <> ? then do:
     6895                 return error substitute ("Цена по товару &1 &2 &3 по категории сумма оборота покупателя >= &4  больше предыдущей категории (&5 и  &6)" ,  buf_price-doc-forming-gds.artic , buf_price-doc-forming-gds.prod-type ,buf_price-doc-forming-gds.prod-code, buf_price-doc-forming-gds-tnv.ttg-summa ,old-price , buf_price-doc-forming-gds-tnv.price-sale-doc) .
     6896              end.
     6897              old-price = buf_price-doc-forming-gds-tnv.price-sale-doc .
     6898     end.
     6899     define buffer old_price-doc-forming for ub.price-doc-forming  .
     6900     define buffer old_price-doc-forming-gds for ub.price-doc-forming-gds  .
     6901     define buffer old_price-all for ub.price-all.
     6902     if buf_price-list-type.main = false then do:
     6903        for each old_price-doc-forming no-lock where
     6904                 old_price-doc-forming.plt-id     = buf_price-list-type.plt-id     and
     6905                 old_price-doc-forming.plt-db-num = buf_price-list-type.plt-db-num and
     6906                 old_price-doc-forming.stts       = integer('3':U)  ,
     6907                 each old_price-doc-forming-gds no-lock where
     6908                       old_price-doc-forming-gds.plt-id     = buf_price-list-type.plt-id      and
     6909                       old_price-doc-forming-gds.plt-db-num = buf_price-list-type.plt-db-num  and
     6910                       old_price-doc-forming-gds.pdf-id     = old_price-doc-forming.pdf-id    and
     6911                       old_price-doc-forming-gds.pdf-db     = old_price-doc-forming.pdf-db    and
     6912                       old_price-doc-forming-gds.b-code     = buf_price-doc-forming-gds.b-code :
     6913                for each old_price-all no-lock where
     6914                         old_price-all.plt-id     = old_price-doc-forming-gds.plt-id      and
     6915                         old_price-all.plt-db-num = old_price-doc-forming-gds.plt-db-num  and
     6916                         old_price-all.pdf-id     = old_price-doc-forming-gds.pdf-id      and
     6917                         old_price-all.pdf-db     = old_price-doc-forming-gds.pdf-db      and
     6918                         old_price-all.b-code     = old_price-doc-forming-gds.b-code      and
     6919                         old_price-all.fact-order-sys-to   >= v-fact-order-sys-from       and
     6920                         old_price-all.fact-order-sys-from <= v-fact-order-sys-to         :
     6921                        return error substitute ("По товару &1 &2 &3 есть цена &6 в пересекающийся период с таким же приоритетом &7 (ДНЦ &4 &5) " ,
     6922                                                  buf_price-doc-forming-gds.artic ,
     6923                                                  buf_price-doc-forming-gds.prod-type ,
     6924                                                  buf_price-doc-forming-gds.prod-code,
     6925                                                  old_price-all.pdf-id ,
     6926                                                  old_price-all.pdf-db ,
     6927                                                  old_price-doc-forming-gds.price-sale-doc ,
     6928                                                  old_price-all.plt-priority
     6929                                                  ) .
     6930                end.
     6931        end.
     6932        end.
     6933       assign v-kol-rec = v-kol-rec + 1 .
     6934   end.
     6935     run ver-pr-equ-qS in this-procedure
     6936       ( input buf_price-doc-forming.plt-id ,
     6937         input buf_price-doc-forming.plt-db-num,
     6938         input buf_price-doc-forming.pdf-id ,
     6939         input buf_price-doc-forming.pdf-db
     6940         ) no-error .
     6941     if error-status :error then  return error  "Ошибка при удалении строки ДНЦ "   .
     6942   if v-kol-rec = 0 then return error "no-records":U.
     6943   end.
     6944   end procedure.
     6945   procedure ver-pr-equ-qS :
     6946   define input parameter  p-plt-id      as integer   no-undo .
     6947   define input parameter  p-plt-db-num  as integer   no-undo .
     6948   define input parameter  p-pdf-id      as integer   no-undo .
     6949   define input parameter  p-pdf-db      as integer   no-undo .
     6950     do
     6951     on error undo, return error return-value
     6952     :
     6953   define variable  l-doc-num2   like ub.price-list.doc-num    no-undo .
     6954   define buffer pdf_price-list  for ub.price-doc-forming-gds .
     6955   define buffer pp_price-list   for ub.price-doc-forming-gds .
     6956   define buffer main_price-list for ub.price-doc-forming-gds .
     6957   define buffer alt_price-list  for ub.price-doc-forming-gds .
     6958   define buffer buf1-bar-code   for ub.bar-code .
     6959   define buffer buf2-bar-code   for ub.bar-code .
     6960   define buffer buf_goods for ub.goods  .
     6961   define buffer buf2_goods for ub.goods  .
     6962   define variable v-num as integer init 0 no-undo .
     6963   define variable bbb   as logical no-undo .
     6964   define variable l-price-sale like ub.price-list.price-sale no-undo .
     6965   define variable l-road-tax   like ub.price-list.road-tax   no-undo .
     6966   define variable l-excise     like ub.price-list.excise     no-undo .
     6967   define variable l-ok          as logical no-undo .
     6968   define variable check-par     as logical no-undo .
     6969   define variable main-b-code   as integer no-undo .
     6970   define variable par-pr-equ-dq as integer no-undo .
     6971   define variable v-price-sale  as decimal no-undo .
     6972   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6973   empty temp-table thbjattr_thbj-attr.
     6974   run adm/shattri.p (
     6975      input "get":U
     6976     ,input v-cntxt-obj-type
     6977     ,input v-cntxt-obj-code
     6978     ,input 'overval':U
     6979     ,input  ""
     6980     ,output v-value-character
     6981     ,output v-value-date
     6982     ,output v-value-decimal
     6983     ,output v-value-integer
     6984     ,output v-value-logical
     6985     ,output par-type
     6986     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6987     ) no-error .
     6988   for each thbjattr_thbj-attr :
     6989       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     6990   end.
     6991   if par-pr-equ-dq = 1 then return .
     6992   for each pdf_price-list exclusive-lock where
     6993            pdf_price-list.plt-id     = p-plt-id     and
     6994            pdf_price-list.plt-db-num = p-plt-db-num and
     6995            pdf_price-list.pdf-id     = p-pdf-id     and
     6996            pdf_price-list.pdf-db     = p-pdf-db     by pdf_price-list.line-num
     6997           :
     6998       if not (pdf_price-list.b-code     = f-base-code (pdf_price-list.b-code) ) then next .
     6999       check-par = false .
     7000      find first x_obj-group no-error .
     7001   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7002   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7003     (input  x_obj-group.obj-type
     7004     ,input  x_obj-group.obj-code
     7005     ,input  pdf_price-list.b-code
     7006     ,input  0
     7007     ,input  0
     7008     ,output l-doc-num2
     7009     ,output l-price-sale
     7010     ,output l-road-tax
     7011     ,output l-excise
     7012     ) no-error .
     7013       v-price-sale = l-price-sale .
     7014      for each x_obj-group :
     7015   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7016   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7017     (input  x_obj-group.obj-type
     7018     ,input  x_obj-group.obj-code
     7019     ,input  pdf_price-list.b-code
     7020     ,input  0
     7021     ,input  0
     7022     ,output l-doc-num2
     7023     ,output l-price-sale
     7024     ,output l-road-tax
     7025     ,output l-excise
     7026     ) no-error .
     7027       if v-price-sale <> l-price-sale  then do :
     7028         v-price-sale = l-price-sale.
     7029         leave .
     7030       end.
     7031      end.
     7032      find first x_obj-group no-error .
     7033   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7034   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7035     (input  x_obj-group.obj-type
     7036     ,input  x_obj-group.obj-code
     7037     ,input  pdf_price-list.b-code
     7038     ,input  0
     7039     ,input  0
     7040     ,output l-doc-num2
     7041     ,output l-price-sale
     7042     ,output l-road-tax
     7043     ,output l-excise
     7044     ) no-error .
     7045         if l-doc-num2 <> ? then do :
     7046           if l-price-sale = pdf_price-list.price-sale-doc
     7047           and v-price-sale = pdf_price-list.price-sale-doc
     7048           then do:
     7049                find first buf_goods no-lock where
     7050                           buf_goods.artic     =  pdf_price-list.artic and
     7051                           buf_goods.prod-type =  pdf_price-list.prod-type and
     7052                           buf_goods.prod-code =  pdf_price-list.prod-code no-error .
     7053               check-par = false .
     7054                  for each pp_price-list no-lock where
     7055                           pp_price-list.plt-id     = p-plt-id     and
     7056                           pp_price-list.plt-db-num = p-plt-db-num and
     7057                           pp_price-list.pdf-id     = p-pdf-id     and
     7058                           pp_price-list.pdf-db     = p-pdf-db     and
     7059                           pp_price-list.artic      = pdf_price-list.artic and
     7060                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     7061                           pp_price-list.prod-code  = pdf_price-list.prod-code ,
     7062                        first buf1-bar-code no-lock where
     7063                             buf1-bar-code.b-code   = pp_price-list.b-code and
     7064                             buf1-bar-code.unit-cli <> buf_goods.unit-base
     7065                       :
     7066                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     7067                       check-par = true  .
     7068                       leave.
     7069                   end.
     7070                  for each pp_price-list no-lock where
     7071                           pp_price-list.plt-id     = p-plt-id     and
     7072                           pp_price-list.plt-db-num = p-plt-db-num and
     7073                           pp_price-list.pdf-id     = p-pdf-id     and
     7074                           pp_price-list.pdf-db     = p-pdf-db     and
     7075                           pp_price-list.artic      = pdf_price-list.artic and
     7076                           pp_price-list.prod-type  = pdf_price-list.prod-type  and
     7077                           pp_price-list.prod-code  = pdf_price-list.prod-code and
     7078                           pp_price-list.price-sale-doc <> pdf_price-list.price-sale-doc  ,
     7079                        first buf1-bar-code no-lock where
     7080                             buf1-bar-code.b-code   = pp_price-list.b-code and
     7081                             buf1-bar-code.unit-cli = buf_goods.unit-base
     7082                       :
     7083                       if  pp_price-list.b-code = f-base-code (pp_price-list.b-code) then next .
     7084                       check-par = true  .
     7085                       leave.
     7086                   end.
     7087               if check-par = true then next.
     7088               if par-pr-equ-dq = 2 then do:
     7089                     if  ( v-num <= 2  and check-par = false ) then
     7090                         run gbl/d-askw.w
     7091                           (input "Удалить строку?"
     7092                           ,input      "Предыдущая цена РАВНА цене по закрываемому документу " + chr(10)
     7093                                       + " Объект "  + v-cntxt-obj-type + String(v-cntxt-obj-code)
     7094                                       + " Артикул " + pdf_price-list.artic + " " +  buf_goods.gds-name + chr(10)
     7095                                       + " Бар-код " + string(pdf_price-list.b-code)
     7096                                       + " Цена по предыдущему документу переоценки № " + l-doc-num2 + " = "
     7097                                       + string(pdf_price-list.price-sale-doc) + chr(10)
     7098                                       + " Удалить строку? "
     7099                           ,input "|^"
     7100                           ,input "Да|Нет|Да для всех^confirm|Нет для всех^confirm"
     7101                           ,input "Удалить строку|"
     7102                               + "Не удалять строку|"
     7103                               + "Удалять у всех товаров, цена на которые не изменилась|"
     7104                               + "Не удалять у всех товаров, цена на которые не изменилась"
     7105                           ,input 1
     7106                           ,input 2
     7107                           ,output v-num
     7108                           ).
     7109                 end.
     7110                 else do:
     7111                   v-num = 3 .
     7112                 end.
     7113                   if v-num = 1 then do:
     7114                     run del-doc-line ( input recid(pdf_price-list)) no-error  .
     7115                                     if error-status :error then do:
     7116                                             message  vss-workfile vss-revision vss-description skip
     7117                                             "Ошибка при удаление строки ДНЦ"
     7118                                             pdf_price-list.b-code skip
     7119                                             error-status :get-message(1) .
     7120                                             return error.
     7121                                     end.
     7122                   end.
     7123                   if v-num = 3  then do:
     7124                      run del-doc-line ( input recid(pdf_price-list)) no-error  .
     7125                   end.
     7126           end.
     7127          end.
     7128   end.
     7129     for each main_price-list no-lock where
     7130                 main_price-list.plt-id      = p-plt-id and
     7131                 main_price-list.plt-db-num  = p-plt-db-num and
     7132                 main_price-list.pdf-id      = p-pdf-id and
     7133                 main_price-list.pdf-db      = p-pdf-db
     7134                 :
     7135                 if main_price-list.b-code <> f-base-code (main_price-list.b-code) then next.
     7136                   for each pp_price-list no-lock where
     7137                             pp_price-list.plt-id       = main_price-list.plt-id     and
     7138                             pp_price-list.plt-db-num   = main_price-list.plt-db-num and
     7139                             pp_price-list.pdf-id       = main_price-list.pdf-id     and
     7140                             pp_price-list.pdf-db       = main_price-list.pdf-db     and
     7141                             pp_price-list.artic        = main_price-list.artic      and
     7142                             pp_price-list.prod-type    = main_price-list.prod-type  and
     7143                             pp_price-list.prod-code    = main_price-list.prod-code  and
     7144                             pp_price-list.b-code      <> main_price-list.b-code     and
     7145                             pp_price-list.price-sale-doc = main_price-list.price-sale-doc  ,
     7146                       first buf_goods no-lock where
     7147                             buf_goods.artic     =  pp_price-list.artic and
     7148                             buf_goods.prod-type =  pp_price-list.prod-type and
     7149                             buf_goods.prod-code =  pp_price-list.prod-code ,
     7150                       first buf1-bar-code no-lock where
     7151                             buf1-bar-code.b-code   = pp_price-list.b-code and
     7152                             buf1-bar-code.unit-cli = buf_goods.unit-base
     7153                             :
     7154                             bbb = true .
     7155                             for each alt_price-list no-lock where
     7156                                     alt_price-list.plt-id     = pp_price-list.plt-id     and
     7157                                     alt_price-list.plt-db-num = pp_price-list.plt-db-num and
     7158                                     alt_price-list.pdf-id     = pp_price-list.pdf-id     and
     7159                                     alt_price-list.pdf-db     = pp_price-list.pdf-db     and
     7160                                     alt_price-list.artic      = pp_price-list.artic      and
     7161                                     alt_price-list.prod-type  = pp_price-list.prod-type  and
     7162                                     alt_price-list.b-code     <> main_price-list.b-code  and
     7163                                     alt_price-list.b-code     <> pp_price-list.b-code    and
     7164                                     alt_price-list.prod-code  = pp_price-list.prod-code ,
     7165                               first buf2_goods no-lock where
     7166                                     buf2_goods.artic     =  pp_price-list.artic     and
     7167                                     buf2_goods.prod-type =  pp_price-list.prod-type and
     7168                                     buf2_goods.prod-code =  pp_price-list.prod-code ,
     7169                               first buf2-bar-code no-lock where
     7170                                     buf2-bar-code.b-code   = alt_price-list.b-code and
     7171                                     buf2-bar-code.unit-cli <> buf2_goods.unit-base and
     7172                                     buf2-bar-code.node-code = buf1-bar-code.node-code
     7173                                   :
     7174                                   bbb = false.
     7175                                   leave.
     7176                             end.
     7177                             if bbb = true  then do:
     7178                                 run del-doc-line ( input recid (pp_price-list)) no-error  .
     7179                                 if error-status :error then do:
