     7319     if v-ok = true then return .
     7320   if trim(par-pr-discm) = "" then return .
     7321   if par-pr-discm = 'sale-' then par-pr-discm = 'sale' .
     7322   for each  b_price-doc-forming-gds no-lock where
     7323             b_price-doc-forming-gds.plt-id     = p-plt-id      and
     7324             b_price-doc-forming-gds.plt-db-num = p-plt-db-num  and
