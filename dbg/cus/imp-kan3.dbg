     4453         :
     4454   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4455   ASSIGN
     4456      i-gl-Host-Code      = 0
     4457      i-gl-Contract-Code  = 0
     4458      i-gl-Extent3        = 0
     4459      .
     4460   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4461       INPUT  v-cntxt-host-code-obj,
     4462       INPUT  buf_contract.contract-code,
     4463       OUTPUT i-gl-Extent3
     4464      ).
     4465   IF i-gl-Extent3[1] = 2 THEN DO:
     4466      ASSIGN
     4467         i-gl-Host-Code      = i-gl-Extent3[2]
     4468         i-gl-Contract-Code  = i-gl-Extent3[3]
     4469         .
     4470   END. ELSE DO:
     4471      ASSIGN
     4472         i-gl-Host-Code      = v-cntxt-host-code-obj
     4473         i-gl-Contract-Code  = buf_contract.contract-code
     4474         .
     4475   END.
     4476   FOR EACH
     4477       buf_contract-specif
     4478        NO-LOCK
     4479        WHERE
     4480            buf_contract-specif.Host-code    = i-gl-Host-Code
     4481        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     4482              :
     4483               if buf_contract-specif.gds-code = p-gds-code then do:
     4484                 assign
     4485                   v-num-specif = v-num-specif + 1
     4486                   v-contract-code = buf_contract.contract-code
     4487                 .
     4488               end.
     4489           end.
     4490         end.
     4491         if v-num-specif > 1 then do:
     4492            run str/gds-cnts.w
     4493               (input parparentproc
     4494               ,input p-gds-code
     4495               , "b-sel":U
     4496               ,output v-spis
     4497             ) no-error.
     4498           find first buf_contract-specif no-lock
     4499           where recid(buf_contract-specif) = integer(v-spis)
     4500             no-error.
     4501             if available buf_contract-specif then do:
     4502                 run read-bonus (
     4503                     input  buf_contract-specif.contract-num  ,
     4504                     input  buf_contract-specif.host-code     ,
     4505                     input  buf_contract-specif.gds-code      ,
     4506                     output v-bonus  ) .
     4507                 assign
     4508                   cost-rubl = buf_contract-specif.price-cli
     4509                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     4510                   p-new-calc-method = 'Спецификация':U
     4511                 .
     4512                 if v-bonus <> ? and v-bonus <> 0 then do:
     4513                    assign
     4514                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     4515                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     4516                    .
     4517                 end.
     4518             end.
     4519             else do:
     4520               message "Не найдена спецификация с recid " v-spis skip
     4521                       "для товара с артикулом " p-artic skip
     4522                       "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     4523                       view-as alert-box information .
     4524             end.
     4525         end.
     4526         if v-num-specif = 0 then do:
     4527             message "Не найдена ни одна спецификация" skip
     4528                     "для товара с артикулом " p-artic skip
     4529                     "на объекте " x_obj-group.obj-type x_obj-group.obj-code skip
     4530                     view-as alert-box information .
     4531         end.
     4532         if v-num-specif = 1 then do:
     4533   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
