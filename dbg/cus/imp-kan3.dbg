     7857   def input param p-prod-code like ub.gds-obj.prod-code no-undo .
     7858   def input-output param p-road-tax-base as decimal no-undo .
     7859   def input-output param p-road-tax-rubl as decimal no-undo .
     7860   define buffer     buff-goods    for ub.goods   .
     7861   define buffer     buf_gds-obj   for ub.gds-obj .
     7862   define buffer     buf_parts     for ub.parts   .
     7863       define buffer   in-vatp-trn-doc  for ub.trn-doc .
