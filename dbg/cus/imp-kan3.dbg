     7425                       fact_price =  if var-pr-r-b = "rubl" then b_price-doc-forming-gds.price-sale-rubl else b_price-doc-forming-gds.price-sale-base
     7426                     .
     7427                     t-prc      =  (fact_price / l_price - 1) * 100  .
     7428                 end.
     7429               when "cost":u       then do:
     7430                 t-prc =  fnc-cost-pc (buffer b_price-doc-forming-gds) .
     7431               end.
     7432               when "sale":u then do:
     7433                 t-prc =  fnc-pr-pc   (buffer b_price-doc-forming-gds) .
