      943   end.
      944   end procedure.
      945   procedure copy_new_price-doc-forming :
      946   define input  parameter       p-recid      as recid no-undo .
      947   define input-output parameter p-plt-db-num as integer   no-undo .
      948   define input-output parameter p-plt-id     as integer   no-undo .
      949   define output parameter       p-pdf-db-num as integer   no-undo .
      950   define output parameter       p-pdf-id     as integer   no-undo .
      951   define buffer buf_price-list-type        for ub.price-list-type  .
      952   define buffer buf_price-doc-forming      for ub.price-doc-forming .
      953   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
      954   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
      955   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
      956   define variable v-host-code  as integer   no-undo .
      957   define variable v-base-rate  as decimal   no-undo .
      958   define variable v-base-scale as integer   no-undo .
      959   define variable v-exch-rate  as decimal   no-undo .
      960   define variable v-exch-scale as integer   no-undo .
      961   define variable v-base as logical   no-undo .
      962   define variable v-name as character no-undo .
      963     do
      964     on error undo, return error return-value
      965     :
      966   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      967   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      968     (output v-base
      969     )  .
      970   find first buf_price-list-type no-lock where
      971              buf_price-list-type.plt-db-num = p-plt-db-num and
      972              buf_price-list-type.plt-id     = p-plt-id no-error .
      973   if error-status :error then return error "Не найден ТПЛ".
      974   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
      975   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
      976       if available buf_price-doc-forming then do :
      977           assign
      978             v-base-rate  = buf_price-doc-forming.base-rate
      979             v-base-scale = buf_price-doc-forming.base-scale
      980             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
      981           .
      982       end.
      983       else do:
      984           assign
      985             v-base-rate  = 1
      986             v-base-scale = 1
      987             v-name       = "Автосоздание"
      988           .
      989       end.
      990      create ub.price-doc-forming.
      991      assign
      992         ub.price-doc-forming.plt-id       = p-plt-id
      993         ub.price-doc-forming.plt-db-num   = p-plt-db-num
      994         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
      995         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
      996         ub.price-doc-forming.base-rate    = v-base-rate
      997         ub.price-doc-forming.base-scale   = v-base-scale
      998         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
      999         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1000         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1001         ub.price-doc-forming.stts         = 0
     1002         ub.price-doc-forming.sys-date     = today
     1003         ub.price-doc-forming.sys-time     = time
     1004         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1005         ub.price-doc-forming.who          = v-cntxt-userid
     1006         ub.price-doc-forming.name         = v-name
     1007      .
     1008      assign
     1009       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1010       p-pdf-id      = ub.price-doc-forming.pdf-id
     1011       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1012       p-plt-id      = ub.price-doc-forming.plt-id
     1013      .
     1014     end.
     1015     if not available buf_price-doc-forming then return .
     1016   for each buf_price-doc-forming-attr no-lock where
     1017            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1018            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1019            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1020            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1021       create ub.price-doc-forming-attr.
     1022       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1023       assign
     1024         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1025         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1026         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1027         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     1028         .
     1029   end.
     1030   for each buf_price-doc-forming-gds no-lock where
     1031            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1032            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     1033            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1034            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     1035       create ub.price-doc-forming-gds.
     1036       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     1037       assign
     1038         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     1039         ub.price-doc-forming-gds.plt-id      = p-plt-id
     1040         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     1041         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     1042       .
     1043   end.
     1044   for each buf_pd-forming-gds-attr no-lock where
     1045            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1046            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1047            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1048            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1049       create ub.price-doc-forming-gdsattr.
     1050       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     1051       assign
     1052         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     1053         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     1054         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     1055         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     1056       .
     1057   end.
     1058   end procedure.
     1059   define variable par-pr-incpc as character no-undo.
     1060   define variable par-pr-rndmt as character no-undo.
     1061   define variable par-pr-rndbs as character no-undo.
     1062   define variable par-pr-clt-q as character no-undo.
     1063   define variable par-pr-dpl-q as character no-undo.
     1064   define variable par-pr-rdc-q as character no-undo.
     1065   define variable par-pr-abs-d as character no-undo.
     1066   define variable par-pr-altex as character no-undo.
     1067   define variable par-pr-parex as character no-undo.
     1068   define variable par-pr-sclex as character no-undo.
     1069   define variable par-pr-notls as character no-undo.
     1070   define variable par-pr-equ-dq as integer  no-undo.
     1071   define variable par-pr-discm as character no-undo .
     1072   define variable par-pr-dscnt as character no-undo .
     1073   define variable par-pr-print as character no-undo .
     1074   define variable par-pr-sigma as character no-undo .
