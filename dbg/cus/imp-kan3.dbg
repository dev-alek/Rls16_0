      933                         ,input buf_goods.prod-code
      934                         ,input ""
      935                         ,input 0
      936                         ,input old_price-list.price-sale
      937                         ,input ""
      938                         ,input 0
      939                       ,input-output v-sec ) no-error .
      940           end.
      941       end.
