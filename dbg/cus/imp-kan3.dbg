     3750   define buffer buf_trn-doc                   for ub.trn-doc  .
     3751   define buffer buf_doc-line                  for ub.doc-line  .
     3752   define buffer buf_bar-code                  for ub.bar-code  .
     3753   define buffer buf_gds-dtl                   for ub.gds-dtl  .
     3754   define buffer buf-goods                     for ub.goods  .
     3755   define buffer buf-gds-grp                   for ub.gds-grp  .
     3756   define buffer buf_contract-specif           for ub.contract-specif .
     3757   define buffer buf_contract                  for ub.contract .
     3758   define variable loc-increase-pc       as decimal   no-undo .
