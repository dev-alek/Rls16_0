      764   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
      765     (input  ?
      766     ,input  p-obj-type
      767     ,input  p-obj-code
      768     ,input  yes
      769     ,output p-plt-id
      770     ,output p-plt-db-num
      771     )  .
      772      create ub.price-doc-forming.
      773      assign
      774         ub.price-doc-forming.plt-id       = p-plt-id
      775         ub.price-doc-forming.plt-db-num   = p-plt-db-num
      776         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
      777         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
      778         ub.price-doc-forming.base-rate    = v-base-rate
      779         ub.price-doc-forming.base-scale   = v-base-scale
      780         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
      781         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
      782         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
      783         ub.price-doc-forming.stts         = 0
      784         ub.price-doc-forming.sys-date     = today
      785         ub.price-doc-forming.sys-time     = time
      786         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
      787         ub.price-doc-forming.who          = v-cntxt-userid
      788         ub.price-doc-forming.name         = "автосоздание"
      789      .
      790      assign
