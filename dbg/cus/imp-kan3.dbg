     4271                   "для товара :" skip
     4272                    "Бар-код" p-b-code     skip
     4273                    "Артикул" p-artic      skip
     4274                     p-prod-type  skip
     4275                     p-prod-code  skip
     4276                   "- расчет невозможен."
     4277                   view-as alert-box information .
     4278       end.
     4279       when 'Единая':U then do:
     4280           assign
     4281             p-new-calc-method = 'Единая':U + " " + string(common-price)
     4282             cost-rubl = common-price
     4283             cost-base = common-price
     4284             .
     4285       end.
     4286       when 'Объект':U then do:
     4287       find first buf_gds-obj no-lock where
     4288                  buf_gds-obj.gds-code = p-gds-code and
     4289                  buf_gds-obj.obj-type = v-copy-type and
