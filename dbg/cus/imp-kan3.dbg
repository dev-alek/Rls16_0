     5614   procedure create-calc-bc :
     5615   define input parameter  v-new-recid as recid no-undo .
     5616   define input parameter  p-calc-method  as character no-undo .
     5617   define input parameter  p-increase-pc  as decimal   no-undo .
     5618   define input parameter  round-method as character no-undo .
     5619   define input parameter  round-base   as decimal   no-undo .
     5620   define input parameter  p-b-code     as integer   no-undo .
     5621   define input parameter  p-gds-code   as integer   no-undo .
     5622   define input parameter  p-artic      as character no-undo .
     5623   define input parameter  p-prod-type  as character no-undo .
     5624   define input parameter  p-prod-code  as integer   no-undo .
     5625   define input parameter  v-base-rate  as decimal   no-undo .
     5626   define input parameter  v-base-scale as decimal   no-undo .
     5627   define input parameter  v-exch-scale as decimal   no-undo .
     5628   define input parameter  v-exch-rate  as decimal   no-undo .
     5629   define input parameter  v-doc-code   as character no-undo .
     5630   define input parameter  v-common-price as decimal   no-undo .
     5631   define input parameter  v-copy-type as character no-undo .
     5632   define input parameter  v-copy-code as integer   no-undo .
     5633   define input-output parameter v-line-num as integer   no-undo .
     5634   define input-output parameter v-sec     as integer   no-undo .
     5635   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     5636   define variable v-price-calc-base as decimal   no-undo .
     5637   define variable v-price-calc-doc  as decimal   no-undo .
     5638   define variable v-price-calc-rubl as decimal   no-undo .
     5639   define variable v-price-prev-base as decimal   no-undo .
     5640   define variable v-price-prev-doc  as decimal   no-undo .
     5641   define variable v-price-prev-rubl as decimal   no-undo .
     5642   define variable v-price-sale-base as decimal   no-undo .
     5643   define variable v-price-sale-doc  as decimal   no-undo .
     5644   define variable v-price-sale-rubl as decimal   no-undo .
     5645   define variable v-road-tax-base   as decimal   no-undo .
     5646   define variable v-road-tax-doc    as decimal   no-undo .
     5647   define variable v-road-tax-rubl   as decimal   no-undo .
     5648   define variable v-excise-base     as decimal   no-undo .
     5649   define variable v-excise-doc      as decimal   no-undo .
     5650   define variable v-excise-rubl     as decimal   no-undo .
     5651   define variable v-vat-pc          as decimal   no-undo .
     5652   define variable v-slt-pc          as decimal   no-undo .
     5653   define variable v-prev-doc-code   as character no-undo .
     5654   define variable v-d-pcnt as decimal   no-undo .
     5655     do
     5656     on error undo, return error return-value
     5657     :
     5658     find  buf_price-doc-forming no-lock where
     5659           recid(buf_price-doc-forming) = v-new-recid no-error .
     5660      if error-status :error then return error error-status :get-message(1) .
     5661      v-line-num = v-line-num + 1.
     5662      run calc-price-line  in this-procedure (
     5663        input  p-calc-method
     5664      , input  p-increase-pc
     5665      , input  round-method
     5666      , input  round-base
     5667      , input  p-b-code
     5668      , input  p-gds-code
     5669      , input  p-artic
     5670      , input  p-prod-type
     5671      , input  p-prod-code
     5672      , input  v-base-rate
     5673      , input  v-base-scale
     5674      , input  v-exch-scale
     5675      , input  v-exch-rate
     5676      , input  v-doc-code
     5677      , input  v-common-price
     5678      , input  v-copy-type
     5679      , input  v-copy-code
     5680      , output p-calc-method
     5681      , output v-price-calc-base
     5682      , output v-price-calc-doc
     5683      , output v-price-calc-rubl
     5684      , output v-price-prev-base
     5685      , output v-price-prev-doc
     5686      , output v-price-prev-rubl
     5687      , output v-price-sale-base
     5688      , output v-price-sale-doc
     5689      , output v-price-sale-rubl
     5690      , output v-road-tax-base
     5691      , output v-road-tax-doc
     5692      , output v-road-tax-rubl
     5693      , output v-excise-base
     5694      , output v-excise-doc
     5695      , output v-excise-rubl
     5696      , output v-vat-pc
     5697      , output v-slt-pc
     5698      , output v-prev-doc-code
     5699      , output v-d-pcnt
     5700      ) no-error .
     5701      if error-status :error then
     5702      message
     5703        vss-workfile vss-revision vss-description skip
     5704        error-status :get-message(1) skip
     5705        return-value skip
     5706        "123calc-price-line"
     5707        "p-calc-method     "  p-calc-method     skip
     5708        "p-increase-pc     "  p-increase-pc     skip
     5709        "round-method      "    round-method    skip
     5710        "round-base        "    round-base      skip
     5711        "p-b-code          "    p-b-code        skip
     5712        "p-gds-code        "    p-gds-code      skip
     5713        "p-artic           "    p-artic         skip
     5714        "p-prod-type       "    p-prod-type     skip
     5715        "p-prod-code       "    p-prod-code     skip
     5716        "v-base-rate       "   v-base-rate     skip
     5717        "v-base-scale      "  v-base-scale    skip
     5718        "v-exch-scale      "  v-exch-scale    skip
     5719        "v-exch-rate       "  v-exch-rate     skip
     5720        "v-doc-code        "  v-doc-code      skip
     5721        "v-common-price    "  v-common-price  skip
     5722        "v-copy-type       "  v-copy-type     skip
     5723        "v-copy-code       "  v-copy-code     skip
     5724        "v-d-pcnt          "  v-d-pcnt
     5725        view-as alert-box error
     5726      .
     5727      run create-line  in this-procedure (
     5728        buf_price-doc-forming.plt-db-num
     5729       ,buf_price-doc-forming.plt-id
     5730       ,buf_price-doc-forming.pdf-db
     5731       ,buf_price-doc-forming.pdf-id
     5732       ,v-line-num
     5733       ,p-b-code
     5734       ,p-artic
     5735       ,p-prod-type
     5736       ,p-prod-code
     5737       ,p-calc-method
     5738       ,v-d-pcnt
     5739       ,buf_price-doc-forming.have-start-period
     5740       ,buf_price-doc-forming.start-date
     5741       ,buf_price-doc-forming.start-shift-date
     5742       ,buf_price-doc-forming.start-shift-name
     5743       ,buf_price-doc-forming.start-shift-num
     5744       ,buf_price-doc-forming.start-sys-date
     5745       ,buf_price-doc-forming.start-sys-time
     5746       ,buf_price-doc-forming.have-end-period
     5747       ,buf_price-doc-forming.end-date
     5748       ,buf_price-doc-forming.end-shift-date
     5749       ,buf_price-doc-forming.end-shift-name
     5750       ,buf_price-doc-forming.end-shift-num
     5751       ,buf_price-doc-forming.end-sys-date
     5752       ,buf_price-doc-forming.end-sys-time
     5753       ,v-price-calc-base
     5754       ,v-price-calc-doc
     5755       ,v-price-calc-rubl
     5756       ,v-price-prev-base
     5757       ,v-price-prev-doc
     5758       ,v-price-prev-rubl
     5759       ,v-price-sale-base
     5760       ,v-price-sale-doc
     5761       ,v-price-sale-rubl
     5762       ,v-road-tax-base
     5763       ,v-road-tax-doc
     5764       ,v-road-tax-rubl
     5765       ,v-excise-base
     5766       ,v-excise-doc
     5767       ,v-excise-rubl
     5768       ,v-vat-pc
     5769       ,v-slt-pc
     5770       ,v-prev-doc-code
     5771       ,0
     5772       ,input-output v-sec
     5773        ) no-error  .
     5774        if error-status :error then
     5775        message
     5776          vss-workfile vss-revision vss-description skip
     5777          error-status :get-message(1) skip
     5778          return-value skip
     5779          "4567"
     5780          view-as alert-box error
     5781        .
     5782     end.
     5783   end procedure.
     5784   procedure re-define :
     5785   define input-output parameter p-calc-method      as character no-undo .
     5786   define input        parameter p-gds-code         as integer   no-undo .
     5787     do
     5788     on error undo, return error return-value
     5789     :
     5790   define buffer buf_goods for ub.goods  .
     5791   define buffer buf_gds-grp for ub.gds-grp  .
     5792       case p-calc-method :
     5793         when 'Товар':U then do:
     5794              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     5795                   case buf_goods.calc-method:
     5796                     when 'Группа':U then do:
     5797                       find first buf_gds-grp no-lock where
     5798                                  buf_gds-grp.node-code = buf_goods.grp-code no-error .
     5799                       p-calc-method  = buf_gds-grp.calc-method.
     5800                     end.
     5801                   otherwise do:
     5802                       p-calc-method  =  buf_goods.calc-method .
     5803                   end.
     5804                   end case.
     5805              run  re-define in this-procedure (
     5806                         input-output  p-calc-method ,
     5807                         input p-gds-code )  .
     5808         end.
     5809         when 'Группа':U then do:
     5810              find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     5811              find first buf_gds-grp no-lock where
     5812                         buf_gds-grp.node-code = buf_goods.grp-code no-error .
     5813              run re-define in this-procedure (
     5814                         input-output buf_gds-grp.calc-method ,
     5815                         input p-gds-code )  .
     5816         end.
     5817         when 'Учетная':U or
     5818         when 'Учет-объект':U then do:
     5819              p-calc-method = 'УчетнаяS':U .
     5820         end.
     5821         when 'Учет-резерв':U then do:
     5822              p-calc-method = 'Учет-рзрвS':U.
     5823         end.
     5824         when 'Приходная':U or
     5825         when 'Прих-объект':U then do:
     5826              p-calc-method = 'ПриходнаяS':U.
     5827         end.
     5828         when 'Учет-безНДС':U then do:
     5829              p-calc-method = 'Учет-НДСS':U .
     5830         end.
     5831       end case.
     5832     end.
     5833   end procedure.
     5834   procedure create-line-pdf-mpl-lib :
     5835   define input  parameter  p-plt-db-num as integer   no-undo .
     5836   define input  parameter  p-plt-id     as integer   no-undo .
     5837   define input  parameter  p-pdf-db     as integer   no-undo .
     5838   define input  parameter  p-pdf-id     as integer   no-undo .
     5839   define input  parameter  p-line-num   as integer   no-undo .
     5840   define input  parameter  p-b-code     as integer   no-undo .
     5841   define input  parameter  p-artic      as character no-undo .
     5842   define input  parameter  p-prod-type  as character no-undo .
     5843   define input  parameter  p-prod-code  as integer   no-undo .
     5844   define input  parameter  p-met    as character no-undo .
     5845   define input  parameter  p-d-pcnt as decimal   no-undo .
     5846   define input  parameter  p-price  as decimal   no-undo .
     5847   define input  parameter  p-out-code as character no-undo .
     5848   define input  parameter  p-stts as integer   no-undo .
     5849   define input-output  parameter v-sec   as integer   no-undo .
     5850   define variable v-price-calc-base  as decimal   no-undo .
     5851   define variable v-price-calc-doc   as decimal   no-undo .
     5852   define variable v-price-calc-rubl  as decimal   no-undo .
     5853   define variable v-price-prev-base  as decimal   no-undo .
     5854   define variable v-price-prev-doc   as decimal   no-undo .
     5855   define variable v-price-prev-rubl  as decimal   no-undo .
     5856   define variable v-price-sale-base  as decimal   no-undo .
     5857   define variable v-price-sale-doc   as decimal   no-undo .
     5858   define variable v-price-sale-rubl  as decimal   no-undo .
     5859   define variable v-road-tax-base    as decimal   no-undo .
     5860   define variable v-road-tax-doc     as decimal   no-undo .
     5861   define variable v-road-tax-rubl    as decimal   no-undo .
     5862   define variable v-excise-base      as decimal   no-undo .
     5863   define variable v-excise-doc       as decimal   no-undo .
     5864   define variable v-excise-rubl      as decimal   no-undo .
     5865   define variable V-base-rate       as decimal   no-undo .
     5866   define variable V-base-scale      as decimal   no-undo .
     5867   define variable V-exch-scale      as decimal   no-undo .
     5868   define variable V-exch-rate       as decimal   no-undo .
     5869   define variable v-curr-abbr as character no-undo .
     5870   define variable p-vat-pc as decimal   no-undo .
     5871   define variable p-slt-pc as decimal   no-undo .
     5872     do
     5873     on error undo, return error return-value
     5874     :
     5875   find first ub.price-list-type  no-lock  where
     5876              ub.price-list-type.plt-db-num = p-plt-db-num  and
     5877              ub.price-list-type.plt-id     = p-plt-id
     5878              no-error .
     5879   if error-status :error then message
     5880     vss-workfile vss-revision vss-description skip
     5881     error-status :get-message(1) skip
     5882     return-value skip
     5883     "Ошибка!"
     5884     view-as alert-box error
     5885   .
     5886   find first ub.price-doc-forming no-lock  where
     5887              ub.price-doc-forming.plt-db-num = p-plt-db-num and
     5888              ub.price-doc-forming.plt-id     = p-plt-id     and
     5889              ub.price-doc-forming.pdf-db     = p-pdf-db     and
     5890              ub.price-doc-forming.pdf-id     = p-pdf-id
     5891               no-error .
     5892   if error-status :error then message
     5893     vss-workfile vss-revision vss-description skip
     5894     error-status :get-message(1) skip
     5895     return-value skip
     5896     "Ошибка!"
     5897     view-as alert-box error
     5898   .
     5899   find first ub.goods no-lock where
     5900    ub.goods.artic = p-artic and
     5901    ub.goods.prod-type = p-prod-type and
     5902    ub.goods.prod-code = p-prod-code no-error .
     5903   if error-status :error then message
     5904     vss-workfile vss-revision vss-description skip
     5905     error-status :get-message(1) skip
     5906     return-value skip
     5907     "Ошибка!"
     5908     view-as alert-box error
     5909   .
     5910   if ub.price-list-type.fix-cource-crc-base = true then do:
     5911       assign
     5912         V-base-rate  = ub.price-doc-forming.base-rate
     5913         V-base-scale = ub.price-doc-forming.base-scale
