     7945             v-total-road-tax-base =  0
     7946             v-total-road-tax-rubl =  0
     7947             v-all-total-road-tax-base =  0
     7948             v-all-total-road-tax-rubl =  0
     7949             .
     7950         for each x_obj-group,
