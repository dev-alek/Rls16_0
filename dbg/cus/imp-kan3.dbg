     7549                                        in-vatp-goods.prod-type = b_doc-line.prod-type and
     7550                                        in-vatp-goods.prod-code = b_doc-line.prod-code no-lock.
     7551      if (not b_trn-doc.internal and
     7552              b_trn-doc.doc-type = 'при':U) or
     7553         in-vatp-goods.gds-type = 'у':U then do:
     7554         if varinvprb = "base":u then do:
     7555           assign
     7556             road-tax-base-loc = b_doc-line.road-tax
     7557             road-tax-rubl-loc = b_doc-line.road-tax * b_trn-doc.base-rate / b_trn-doc.base-scale.
     7558         end.
     7559         else do:
     7560           ASSIGN
     7561             road-tax-rubl-loc = b_doc-line.road-tax
     7562             road-tax-base-loc = b_doc-line.road-tax / b_trn-doc.base-rate * b_trn-doc.base-scale.
     7563         end.
     7564         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     7565         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     7566         assign
     7567           road-tax-cli-loc = ?.
     7568         ASSIGN
     7569           transport-base-loc = (if b_doc-line.transport-base = ? then 0 else b_doc-line.transport-base)
     7570           transport-rubl-loc = (if b_doc-line.transport-rubl = ? then 0 else b_doc-line.transport-rubl)
     7571           transport-cli-loc  = 0
     7572           other-base-loc     = (if b_doc-line.other-base     = ? then 0 else b_doc-line.other-base)
     7573           other-rubl-loc     = (if b_doc-line.other-rubl     = ? then 0 else b_doc-line.other-rubl)
     7574           other-cli-loc      = 0
     7575           vat-pc-loc         = (if b_doc-line.vat-pc         = ? then 0 else b_doc-line.vat-pc)
     7576           slt-pc-loc         = (if b_doc-line.slt-pc         = ? then 0 else b_doc-line.slt-pc).
     7577                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     7578               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     7579         assign
     7580           vat-cli-loc            = ?
     7581           slt-cli-loc            = ?
     7582           price-cli-with-tax-loc = ?.
     7583      end.
     7584      else do:
     7585                                                   for each in-vatp-parts where in-vatp-parts.out-code  = b_doc-line.doc-code  and
     7586                                         in-vatp-parts.obj-type  = b_doc-line.obj-type  and
     7587                                         in-vatp-parts.obj-code  = b_doc-line.obj-code  and
     7588                                         in-vatp-parts.artic     = b_doc-line.artic     and
     7589                                         in-vatp-parts.prod-type = b_doc-line.prod-type and
     7590                                         in-vatp-parts.prod-code = b_doc-line.prod-code
     7591                            use-index out-code no-lock:
     7592             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     7593                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     7594                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     7595                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     7596                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     7597                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     7598                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     7599                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     7600                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     7601                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     7602                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     7603                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     7604                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     7605                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     7606                         .
     7607         end.
     7608         ASSIGN
     7609           road-tax-base-loc   = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7610           road-tax-rubl-loc   = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7611           transport-base-loc  = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7612           transport-rubl-loc  = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7613           other-base-loc      = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7614           other-rubl-loc      = if b_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / b_doc-line.fact-qnty  else 0
     7615                                           vat-base-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b_doc-line.fact-qnty   else 0
     7616           slt-base-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b_doc-line.fact-qnty   else 0
     7617                   vat-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / b_doc-line.fact-qnty   else 0
     7618           slt-rubl-loc        = if b_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / b_doc-line.fact-qnty   else 0
     7619           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     7620           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     7621         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     7622         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     7623         if transport-base-loc = ? then transport-base-loc = 0.
     7624         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     7625         if other-base-loc     = ? then other-base-loc     = 0.
     7626         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     7627         assign
     7628           transport-cli-loc      = 0
     7629           other-cli-loc          = 0
     7630           road-tax-cli-loc       = ?
     7631           vat-cli-loc            = ?
     7632           slt-cli-loc            = ?
     7633           price-cli-with-tax-loc = ?.
     7634      end.
     7635   ASSIGN
     7636             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     7637       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     7638   .
     7639                if var-pr-r-b = "rubl" then
     7640                    s-cost = price-rubl-with-tax-loc.
     7641                  else
     7642                    s-cost = price-base-with-tax-loc.
     7643                s-qnty = b_doc-line.fact-qnty .
     7644              end.
     7645              else do:
     7646                assign
     7647                 s-cost = 0
     7648                 s-qnty = 0
     7649                .
     7650              end.
     7651              l_price  =  (f-cost * f-qnty + s-cost * s-qnty ) / (f-qnty + s-qnty)  .
     7652           end.
     7653           when "cost-vat":u then do:
     7654                run str/gdsnovat.p ('Уч+накл-НДС':U,
     7655                        b_trn-doc.obj-type,
     7656                        b_trn-doc.obj-code,
     7657                        b_trn-doc.host-code,
     7658                        b_doc-line.artic,
     7659                        b_doc-line.prod-type,
     7660                        b_doc-line.prod-code,
     7661                        0 ,
     7662                        b_doc-line.doc-code,
     7663                        ?,
     7664                        ?,
     7665                        output cost-base   ,
     7666                        output cost-rubl   ,
     7667                        output v-price-base  ,
     7668                        output v-price-rubl  ,
     7669                        output cur-rt-base ,
     7670                        output cur-rt-rubl ).
     7671                        if var-pr-r-b = "rubl"
     7672                           then l_price = v-price-rubl.
     7673                           else l_price = v-price-base.
     7674           end.
     7675           when "sale":u then do:
     7676                 l_price = ( if var-pr-r-b = "rubl"
     7677                                then b_doc-line.price-rubl
     7678                                else b_doc-line.price-base ).
     7679           end.
     7680           when "prod":u then do:
     7681   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7682   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     7683   (  input  b_price-doc-forming-gds.b-code
     7684    , input  p-obj-type
     7685    , input  p-obj-code
     7686    , output l_pricewithoutvat
     7687    , output l_price
     7688    , output l_prod-vat
     7689    , output v-str2
     7690    , output v-str2
     7691           )  .
     7692       end.
     7693      when "prod-vat":u then do:
     7694   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7695   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     7696   (  input  b_price-doc-forming-gds.b-code
     7697    , input  p-obj-type
     7698    , input  p-obj-code
     7699    , output l_price
     7700    , output l_pricewithvat
     7701    , output l_prod-vat
     7702    , output v-str2
     7703    , output v-str2
     7704           )  .
     7705       end.
     7706         end case.
     7707           tt-price-sale = b_price-doc-forming-gds.price-sale-rubl .
     7708           t-prc = (( tt-price-sale /  v-koff ) / l_price - 1) * 100.
     7709      end.
     7710   end.
     7711     if  p-prc-max <> ? then do:
     7712       if  t-prc <> ? and ( p-prc-max < t-prc  or p-prc-min > t-prc)
     7713       then do:
     7714         message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     7715             else "По признаку"  )
     7716             b_price-doc-forming-gds.artic
     7717             b_price-doc-forming-gds.prod-type
     7718             b_price-doc-forming-gds.prod-code skip
     7719             "бар-код: " b_price-doc-forming-gds.b-code
     7720              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     7721                else "" ) skip
     7722             fnc-pr  (buffer b_price-doc-forming-gds)
     7723             skip
     7724           "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     7725           "Процент не менее :" p-prc-min "%" skip
     7726           "Процент не более :" p-prc-max "%" skip
     7727           "Процент фактический :" t-prc  "%"  skip
     7728           "ДНЦ №: " b_price-doc-forming-gds.pdf-id         skip
     7729           "БД" b_price-doc-forming-gds.pdf-db
     7730             view-as alert-box error .
     7731                 p-err = true .
     7732                 undo , return error .
     7733       end.
     7734       else do:
     7735          if  t-prc = ? then  do:
     7736             message (if v-main-b-code = b_price-doc-forming-gds.b-code then "По товару :"
     7737             else "По признаку"  )
     7738             b_price-doc-forming-gds.artic
     7739             b_price-doc-forming-gds.prod-type
     7740             b_price-doc-forming-gds.prod-code skip
     7741             "бар-код: " b_price-doc-forming-gds.b-code
     7742              ( if v-koff > 1 then substitute("Упаковка на: &1" , v-koff)
     7743                else "" ) skip
     7744             fnc-pr  (buffer b_price-doc-forming-gds)
     7745             skip
     7746             "Нет базовой цены для расчета процента наценки !" skip
     7747             "Процент торговой наценки вышел за интервал возможных значений !!! " skip
     7748             "Процент не менее :" p-prc-min "%" skip
     7749             "Процент не более :" p-prc-max "%" skip
     7750             "Процент фактический :" t-prc  "%"  skip
     7751             "ДНЦ №_: " b_price-doc-forming-gds.pdf-id         skip
     7752             "БД" b_price-doc-forming-gds.pdf-db
     7753             view-as alert-box error .
     7754             p-err = true .
     7755             undo , return error .
     7756          end.
     7757       end.
     7758     end.
     7759   end.
     7760     end.
     7761   end procedure.
     7762   procedure del-doc-line :
     7763   define input  parameter p-recid as recid no-undo .
     7764     do
     7765     on error undo, return error return-value
     7766     :
     7767     find first ub.price-doc-forming-gds exclusive-lock where
     7768          recid ( ub.price-doc-forming-gds ) = p-recid  no-error .
     7769      if available ub.price-doc-forming-gds then do:
     7770         delete ub.price-doc-forming-gds no-error .
     7771      end.
     7772     end.
     7773   end procedure.
     7774   def var vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7775   procedure check-use-bar-code :
     7776     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     7777     do
     7778     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info77, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     7779     on stop   undo, return error substitute( "&1. stop", vss-include-info77 )
     7780     on endkey undo, return error substitute( "&1. endkey", vss-include-info77 )
     7781     :
     7782       define buffer buf_bar-code for ub.bar-code .
     7783       find first buf_bar-code no-lock
     7784         where buf_bar-code.b-code     = p-b-code
     7785         no-error .
     7786       if not available buf_bar-code then do:
     7787         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info77, p-b-code ) .
     7788       end.
     7789       if buf_bar-code.stts = integer('99':U) then do:
     7790         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     7791                                 + "Выполняется удаление бар-кода"
     7792                                 ,vss-include-info77
     7793                                 ,p-b-code
     7794                                 ,chr(10)
     7795                               ) .
     7796       end.
     7797       if buf_bar-code.stts = integer('79':U) then do:
     7798         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     7799                                 + "Бар-код выключен"
     7800                                 ,vss-include-info77
     7801                                 ,p-b-code
     7802                                 ,chr(10)
     7803                               ) .
     7804       end.
     7805       return .
     7806     end.
     7807   end procedure.
     7808   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7809   procedure last-incom-S :
     7810   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
     7811   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
     7812   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
     7813   define output parameter p-in-code   as character no-undo .
     7814   define output parameter p-obj-type  as character no-undo .
     7815   define output parameter p-obj-code  as integer   no-undo .
     7816     do
     7817     on error undo, return error return-value
     7818     :
     7819     define buffer buf_trn-doc for ub.trn-doc .
     7820     define buffer buf_gds-obj for ub.gds-obj  .
     7821     do
     7822     on error undo, return error
     7823     :
     7824       assign
     7825         p-in-code  = ""
     7826         p-obj-type = ""
     7827         p-obj-code = 0
     7828       .
     7829        for each x_obj-group ,
     7830         each buf_gds-obj no-lock
     7831         where buf_gds-obj.obj-type  = x_obj-group.obj-type
     7832           and buf_gds-obj.obj-code  = x_obj-group.obj-code
     7833           and buf_gds-obj.artic     = p-artic
     7834           and buf_gds-obj.prod-type = p-prod-type
     7835           and buf_gds-obj.prod-code = p-prod-code
     7836       , first buf_trn-doc no-lock
     7837         where buf_trn-doc.doc-code = buf_gds-obj.in-code
     7838           and buf_trn-doc.status_  = 'факт':U
     7839       on error undo, return error
     7840       by buf_trn-doc.fact-order descending
     7841       :
     7842         assign
     7843           p-in-code  = buf_gds-obj.in-code
     7844           p-obj-type = buf_gds-obj.obj-type
     7845           p-obj-code = buf_gds-obj.obj-code
     7846         .
     7847         leave .
     7848       end.
     7849     end.
     7850     end.
     7851   end procedure.
     7852   procedure main-road-tax :
     7853   def input param p-obj-type  like ub.gds-obj.obj-type  no-undo .
     7854   def input param p-obj-code  like ub.gds-obj.obj-code  no-undo .
     7855   def input param p-artic     like ub.gds-obj.artic     no-undo .
