     7882       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     7883       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     7884       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
