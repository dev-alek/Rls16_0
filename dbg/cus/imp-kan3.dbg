     4342           message "Нет ПН для товара или цена = 0 :" p-artic  p-b-code skip
     4343                   "На объекте" x_obj-group.obj-type x_obj-group.obj-code skip
     4344                   "- расчет по производителю от последней приходной накладной c пороговой наценкой невозможен."
     4345                   view-as alert-box question buttons OK-Cancel title "#4" update g#log1 as logical .
     4346         end.
     4347         else do:
     4348             cost-rubl = vd .
     4349             cost-base = cost-rubl / p-base-rate * p-base-scale .
     4350             p-new-calc-method = substitute("&1&2&3" ,p-calc-method, chr(4),v-descript ) .
     4351         end.
     4352       end.
     4353       when 'ПорогПр+НДС':U then do:
     4354         find first x_obj-group.
     4355             run calc-price-levelprod (
