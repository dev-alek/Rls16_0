     7886       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     7887       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     7888       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     7889       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
