     6084   procedure main-road-taxs :
     6085   define input param p-artic     like ub.gds-obj.artic     no-undo .
     6086   define input param p-prod-type like ub.gds-obj.prod-type no-undo .
     6087   define input param p-prod-code like ub.gds-obj.prod-code no-undo .
     6088   define input-output param p-road-tax-base as decimal no-undo .
     6089   define input-output param p-road-tax-rubl as decimal no-undo .
     6090       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     6091       define buffer   in-vatp-parts    for ub.parts   .
     6092       define buffer   in-vatp-doc      for ub.trn-doc .
     6093       define buffer   in-vatp-goods    for ub.goods   .
     6094       define buffer   in-vatp-sysconf  for ub.sysconf .
     6095       define buffer   in-vatp_doc-attr for ub.doc-attr.
     6096       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     6097       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     6098       define variable varinvprb                  as   character              no-undo.
     6099       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     6100       define variable cli-base-rate              as   decimal                no-undo.
     6101       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     6102       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     6103       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     6104       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     6105       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     6106       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     6107       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     6108       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6109       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     6110       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     6111       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     6112       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     6113       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     6114       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     6115       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     6116       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     6117       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     6118       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     6119       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     6120       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     6121       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     6122       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     6123       define variable varinvatp-envd             as   character              no-undo.
     6124       define variable varinvatp-type             as   character              no-undo.
     6125     do
     6126     on error undo, return error return-value
     6127     :
     6128   define buffer buff-goods   for ub.goods    .
     6129   define buffer buf_gds-obj  for ub.gds-obj  .
     6130   define buffer buf_parts    for ub.parts    .
     6131   define buffer buf_trn-doc  for ub.trn-doc  .
     6132   define buffer buf_doc-line for ub.doc-line .
     6133   define variable is-petrolium as logical   no-undo .
     6134   define variable is-pieces   as  logical   no-undo .
     6135   define variable p-in-code   as  character no-undo .
     6136   define variable p-obj-type  as  character no-undo .
     6137   define variable p-obj-code  as  integer   no-undo .
     6138   define variable v-rec as recid no-undo .
     6139   define variable t-ret as logical no-undo .
     6140   define variable v-total-avrg-base as decimal no-undo .
     6141   define variable v-total-avrg-rubl as decimal no-undo .
     6142   define variable v-total-avrg-qnty as decimal no-undo .
     6143   define variable v-total-road-tax-base     as decimal no-undo .
     6144   define variable v-total-road-tax-rubl     as decimal no-undo .
     6145   define variable v-all-total-road-tax-base as decimal no-undo .
     6146   define variable v-all-total-road-tax-rubl as decimal no-undo .
     6147   assign
     6148     p-road-tax-base = 0
     6149     p-road-tax-rubl = 0
     6150     .
     6151     Find first buff-goods no-lock where
     6152                buff-goods.artic     = p-artic and
     6153                buff-goods.prod-type = p-prod-type and
     6154                buff-goods.prod-code = p-prod-code
     6155         no-error .
     6156         if available buff-goods then do:
     6157            v-rec = recid (buff-goods).
     6158            t-ret =  session:SET-WAIT-STATE("GENERAL") .
     6159   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     6160     (
     6161        input p-artic
     6162     ,  input p-prod-type
     6163     ,  input p-prod-code
     6164     , output is-petrolium
     6165     , output is-pieces
     6166     ) .
     6167              t-ret =  session:SET-WAIT-STATE("") .
     6168              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     6169                 assign
     6170                   p-road-tax-base = 0
     6171                   p-road-tax-rubl = 0
     6172                   .
     6173                  return.
     6174              end.
     6175         end.
     6176         assign
     6177             v-total-avrg-qnty = 0
     6178             v-total-road-tax-base =  0
     6179             v-total-road-tax-rubl =  0
     6180             v-all-total-road-tax-base =  0
     6181             v-all-total-road-tax-rubl =  0
     6182             .
     6183       for each  x_obj-group ,
     6184           each buf_parts no-lock
     6185           where buf_parts.obj-type  = x_obj-group.obj-type
     6186             and buf_parts.obj-code  = x_obj-group.obj-code
     6187             and buf_parts.artic     = p-artic
     6188             and buf_parts.prod-type = p-prod-type
     6189             and buf_parts.prod-code = p-prod-code
     6190             and buf_parts.status_   = no
     6191             and buf_parts.out-code  = 'free-zone':U
     6192             and buf_parts.qnty      > 0
     6193         on error undo, return error
     6194         :
     6195            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     6196   assign
     6197     price-rubl-with-tax-loc = buf_parts.price-rubl
     6198     price-base-with-tax-loc = buf_parts.price-base
     6199   .
     6200   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6201   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6202     (output varinvprb
     6203     )  .
     6204     if buf_parts.out-code = 'free-zone':U     or
     6205        buf_parts.out-code = 'out-zone':U   or
     6206        buf_parts.doc-type = 'акт':U then do:
     6207       assign
     6208         in-vatp-have-vat-slt = yes.
     6209     end.
     6210     else do:
     6211       find first in-vatp_doc-attr no-lock
     6212         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     6213           and in-vatp_doc-attr.attr-code = 'envd':U
     6214         no-error .
     6215       if not available in-vatp_doc-attr then do:
     6216         assign
     6217           in-vatp-have-vat-slt = yes.
     6218       end.
     6219       else do:
     6220            in-vatp-have-vat-slt = no.
     6221       end.
     6222     end.
     6223     assign
     6224      price-cli-with-tax-loc = buf_parts.price-cli
     6225      cli-base-rate          = buf_parts.cli-base-rate.
     6226     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     6227              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     6228     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     6229             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     6230             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     6231             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     6232             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     6233             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     6234             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6235       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6236     assign
     6237       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     6238     assign
     6239       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     6240       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     6241       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     6242       transport-cli-loc  = 0
     6243       other-cli-loc      = 0
     6244     .
     6245   ASSIGN
     6246             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     6247       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     6248   .
     6249           assign
     6250             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     6251             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     6252            .
     6253        end.
     6254         if v-total-avrg-qnty > 0 then  do :
     6255         assign
     6256             p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     6257             p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     6258             .
     6259         end.
     6260         if v-total-avrg-qnty <= 0 then do :
     6261             run last-incom-S in this-procedure
     6262                ( input p-artic
     6263                 ,input p-prod-type
     6264                 ,input p-prod-code
     6265                 ,output p-in-code
     6266                 ,output p-obj-type
     6267                 ,output p-obj-code ).
     6268               find first  buf_trn-doc no-lock  where buf_trn-doc.doc-code  = p-in-code no-error .
     6269               find first  buf_doc-line no-lock where  buf_doc-line.doc-code = p-in-code
     6270                       and buf_doc-line.artic     = p-artic
     6271                       and buf_doc-line.prod-type = p-prod-type
     6272                       and buf_doc-line.prod-code = p-prod-code
     6273               no-error.
     6274               if available buf_doc-line then do :
     6275   assign
     6276     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     6277     price-base-with-tax-loc = buf_doc-line.price-base
     6278   .
     6279   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6280   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6281     (output varinvprb
     6282     )  .
     6283      find first in-vatp_doc-attr no-lock
     6284       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     6285         and in-vatp_doc-attr.attr-code = 'envd':U
     6286       no-error .
     6287       if available in-vatp_doc-attr
     6288          then do:
     6289          assign
     6290            in-vatp-have-vat-slt = no.
     6291      end.
     6292      else do:
     6293        assign
     6294          in-vatp-have-vat-slt = yes.
     6295      end.
     6296      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     6297                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     6298                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     6299      if (not buf_trn-doc.internal and
     6300              buf_trn-doc.doc-type = 'при':U) or
     6301         in-vatp-goods.gds-type = 'у':U then do:
     6302         if varinvprb = "base":u then do:
     6303           assign
     6304             road-tax-base-loc = buf_doc-line.road-tax
     6305             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     6306         end.
     6307         else do:
     6308           ASSIGN
     6309             road-tax-rubl-loc = buf_doc-line.road-tax
     6310             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     6311         end.
     6312         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     6313         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     6314         assign
     6315           road-tax-cli-loc = ?.
     6316         ASSIGN
     6317           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     6318           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     6319           transport-cli-loc  = 0
