     4541       INPUT  v-contract-code,
     4542       OUTPUT i-gl-Extent3
     4543      ).
     4544   IF i-gl-Extent3[1] = 2 THEN DO:
     4545      ASSIGN
     4546         i-gl-Host-Code      = i-gl-Extent3[2]
     4547         i-gl-Contract-Code  = i-gl-Extent3[3]
     4548         .
     4549   END. ELSE DO:
     4550      ASSIGN
     4551         i-gl-Host-Code      = v-cntxt-host-code-obj
     4552         i-gl-Contract-Code  = v-contract-code
     4553         .
     4554   END.
     4555   FOR EACH
     4556       buf_contract-specif
     4557        NO-LOCK
     4558        WHERE
     4559            buf_contract-specif.Host-code    = i-gl-Host-Code
     4560        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     4561               :
     4562               if buf_contract-specif.gds-code = p-gds-code then do:
     4563                 run read-bonus (
     4564                     input  buf_contract-specif.contract-num  ,
     4565                     input  buf_contract-specif.host-code     ,
     4566                     input  buf_contract-specif.gds-code      ,
     4567                     output v-bonus  ) .
     4568                 assign
     4569                   cost-rubl = buf_contract-specif.price-cli
     4570                   cost-base = buf_contract-specif.price-cli / p-base-rate * p-base-scale
     4571                   p-new-calc-method = 'Спецификация':U
     4572                 .
     4573                 if v-bonus <> ? and v-bonus <> 0 then do:
     4574                    assign
     4575                    cost-rubl = cost-rubl + ( cost-rubl * v-bonus / 100 )
     4576                    cost-base = cost-base + ( cost-base * v-bonus / 100 )
     4577                    .
     4578                 end.
     4579               end.
     4580             end.
     4581         end.
     4582      end.
     4583      otherwise do:
     4584        message  "Не просчитывается метод p-calc-method = " p-calc-method  skip
     4585                  p-new-calc-method  skip
     4586                 "p-price-prev-doc " p-price-prev-doc  skip
     4587                 "mpl-lib ERR !!! " skip
     4588                 'артикул ' p-artic skip
     4589                 view-as alert-box information .
     4590      end.
     4591    end case.
     4592   run main-road-taxs in this-procedure
     4593     ( input p-artic     ,
     4594       input p-prod-type ,
     4595       input p-prod-code ,
     4596       input-output cur-rt-base ,
     4597       input-output cur-rt-rubl )
     4598       .
     4599     if p-exch-scale = 0  or  p-exch-scale = ?  then do:
     4600       return error "Не определен курс валюты документа" .
     4601     end.
     4602     if p-base-scale = 0  or  p-base-scale = ?  then do:
     4603        return error "Не определен курс базовой валюты " .
     4604     end.
     4605   if v-base = false then var-pr-r-b = "rubl":U .
     4606                     else var-pr-r-b =  "base":U .
     4607       if var-pr-r-b = "rubl":U then do:
     4608            case p-calc-method :
     4609            when 'ПорогПр-НДС':U then do:
     4610               p-price-sale-rubl  =  cost-rubl + (cost-rubl * p-vat-pc / 100)  .
     4611            end.
     4612            when 'ПорогПр+НДС':U then do:
     4613               p-price-sale-rubl  =  cost-rubl .
     4614            end.
     4615            when  'Производит':U then do:
     4616               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100)  .
     4617            end.
     4618            when  'Произв-НДС':U then do:
     4619               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)   .
     4620            end.
     4621            otherwise do:
     4622               p-price-sale-rubl  =  cost-rubl * (1 + p-increase-pc / 100) .
     4623            end.
     4624           end case.
     4625           assign
     4626             p-price-calc-rubl  =  cost-rubl
     4627             p-road-tax-rubl    =  cur-rt-rubl
     4628             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4629             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4630             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4631           .
     4632       end.
     4633       else do:
     4634            case p-calc-method:
     4635               when 'ПорогПр-НДС':U then do:
     4636                   p-price-sale-base  =  cost-base + (cost-base * p-vat-pc / 100)  .
     4637               end.
     4638               when 'ПорогПр+НДС':U then do:
     4639                   p-price-sale-base  =  cost-base .
     4640               end.
     4641               when 'Производит':U then do:
     4642                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100)  .
     4643               end.
     4644               when 'Произв-НДС':U then do:
     4645                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) * (1 + p-vat-pc / 100)  .
     4646               end.
     4647               otherwise do:
     4648                   p-price-sale-base  =  cost-base * (1 + p-increase-pc / 100) .
     4649               end.
     4650            end case.
     4651           assign
     4652             p-price-calc-base  =  cost-base
     4653             p-road-tax-base    =  cur-rt-base
     4654             p-price-calc-rubl  =  p-price-calc-base * p-base-rate / p-base-scale
     4655             p-price-sale-rubl  =  p-price-sale-base * p-base-rate / p-base-scale
     4656             p-road-tax-rubl    =  p-road-tax-base   * p-base-rate / p-base-scale
     4657             p-price-calc-doc   =  p-price-calc-rubl / p-exch-rate * p-exch-scale
     4658             p-price-sale-doc   =  p-price-sale-rubl / p-exch-rate * p-exch-scale
     4659             p-road-tax-doc     =  p-road-tax-rubl   / p-exch-rate * p-exch-scale
     4660           .
     4661       end.
     4662      if p-price-sale-doc <> 0 then do:
     4663   case p-round-method :
     4664     when '9-окончание':U then do:
     4665       if p-price-sale-doc < 29 then do:
     4666         if (p-price-sale-doc - truncate (p-price-sale-doc, 0)) <> 0 then do:
     4667           assign
     4668             p-price-sale-doc = truncate (p-price-sale-doc, 0) + 1
     4669           .
     4670         end.
     4671       end.
     4672       else do:
     4673         if (p-price-sale-doc modulo 10) < 3 then do:
     4674           assign
     4675             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4676                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4677                   - 1 ) * 10
     4678                 + 9
     4679           .
     4680         end.
     4681         else do:
     4682           assign
     4683             p-price-sale-doc = (p-price-sale-doc - (p-price-sale-doc modulo 100))
     4684                 + ( truncate (((p-price-sale-doc modulo 100) / 10), 0)
     4685                   ) * 10
     4686                 + 9
     4687           .
     4688         end.
     4689         assign
     4690           p-price-sale-doc = round (p-price-sale-doc, 0)
     4691         .
     4692       end.
     4693     end.
     4694     when '9-99окончание':U then do:
     4695       if p-price-sale-doc < p-round-base then do:
     4696         assign
     4697           p-price-sale-doc = truncate (p-price-sale-doc, 0) + 0.99
     4698         .
     4699       end.
     4700       else do:
     4701         assign
     4702           p-price-sale-doc = truncate (p-price-sale-doc / 10 , 0) * 10 + 9.99
     4703         .
     4704       end.
     4705     end.
     4706     when 'Без-дробных':U then do:
     4707       assign
     4708         p-price-sale-doc = round (p-price-sale-doc, 0)
     4709       .
     4710     end.
     4711     when 'Произвольно':U then do:
     4712       if p-round-base <> 0 then do:
     4713         assign
     4714           p-price-sale-doc = round (p-price-sale-doc / p-round-base, 0) * p-round-base
     4715         .
     4716         if p-price-sale-doc = 0 then do:
     4717           assign
     4718             p-price-sale-doc = p-round-base
     4719           .
     4720         end.
     4721       end.
     4722     end.
     4723     when 'Вверх':U then do:
     4724       if p-round-base <> 0 then do:
     4725         if truncate ( p-price-sale-doc / p-round-base, 0 ) <> (p-price-sale-doc / p-round-base) then do:
     4726           assign
     4727             p-price-sale-doc = truncate (p-price-sale-doc / p-round-base, 0) * p-round-base + p-round-base
     4728           .
     4729         end.
     4730       end.
     4731       if p-price-sale-doc = 0 then do:
     4732         assign
     4733           p-price-sale-doc = p-round-base
     4734         .
     4735       end.
     4736     end.
     4737     when 'Коэффициент':U then do:
     4738       if p-round-base <> 0 then do:
     4739         assign
     4740           p-price-sale-doc = p-price-sale-doc * p-round-base
     4741         .
     4742       end.
     4743     end.
     4744     when 'Отключено':U then do:
     4745     end.
     4746     otherwise do:
     4747       message
     4748         vss-workfile vss-revision vss-description skip
     4749         "Неизвестный метод округления продажной цены" skip
     4750         "round-method" p-round-method skip
     4751         "round-base"   p-round-base   skip
     4752         "price"        p-price-sale-doc             skip
     4753         view-as alert-box error .
     4754     end.
     4755   end.
     4756     end.
     4757     assign
     4758       p-price-calc-rubl = p-price-calc-doc * p-exch-rate / p-exch-scale
     4759       p-price-sale-rubl = p-price-sale-doc * p-exch-rate / p-exch-scale
     4760       p-road-tax-rubl   = p-road-tax-doc   * p-exch-rate / p-exch-scale
     4761       p-price-prev-rubl = p-price-prev-doc * p-exch-rate / p-exch-scale
     4762      .
     4763     assign
     4764       p-price-calc-base = p-price-calc-rubl / p-base-rate * p-base-scale
     4765       p-price-sale-base = p-price-sale-rubl / p-base-rate * p-base-scale
     4766       p-road-tax-base   = p-road-tax-rubl   / p-base-rate * p-base-scale
     4767       p-price-prev-base = p-price-prev-rubl / p-base-rate * p-base-scale
     4768     .
     4769     define buffer bufold_price-doc-forming for ub.price-doc-forming  .
     4770     find first bufold_price-doc-forming where  recid(bufold_price-doc-forming) = v1-recid no-lock no-error .
     4771     p-prev-doc-code = if available bufold_price-doc-forming
     4772                          then (string(bufold_price-doc-forming.pdf-id) + " БД" + string(bufold_price-doc-forming.pdf-db))
     4773                          else "" .
     4774   END PROCEDURE.
     4775   PROCEDURE create-line :
     4776   define input  parameter p-plt-db-num        like ub.price-doc-forming-gds.plt-db-num  no-undo .
     4777   define input  parameter p-plt-id            like ub.price-doc-forming-gds.plt-id      no-undo .
     4778   define input  parameter p-pdf-db            like ub.price-doc-forming-gds.pdf-db      no-undo .
     4779   define input  parameter p-pdf-id            like ub.price-doc-forming-gds.pdf-id  no-undo .
     4780   define input  parameter p-line-num          like ub.price-doc-forming-gds.line-num no-undo .
     4781   define input  parameter p-b-code            like ub.price-doc-forming-gds.b-code   no-undo .
     4782   define input  parameter p-artic             like ub.price-doc-forming-gds.artic    no-undo .
     4783   define input  parameter p-prod-type         like ub.price-doc-forming-gds.prod-type no-undo .
     4784   define input  parameter p-prod-code         like ub.price-doc-forming-gds.prod-code no-undo .
     4785   define input  parameter p-calc-method       like ub.price-doc-forming-gds.calc-method  no-undo .
     4786   define input  parameter p-d-pcnt            like ub.price-doc-forming-gds.d-pcnt       no-undo .
     4787   define input  parameter p-have-start-period like ub.price-doc-forming-gds.have-start-period no-undo .
     4788   define input  parameter p-start-date        like ub.price-doc-forming-gds.start-date        no-undo .
     4789   define input  parameter p-start-shift-date  like ub.price-doc-forming-gds.start-shift-date  no-undo .
     4790   define input  parameter p-start-shift-name  like ub.price-doc-forming-gds.start-shift-name  no-undo .
     4791   define input  parameter p-start-shift-num   like ub.price-doc-forming-gds.start-shift-num   no-undo .
     4792   define input  parameter p-start-sys-date    like ub.price-doc-forming-gds.start-sys-date    no-undo .
     4793   define input  parameter p-start-sys-time    like ub.price-doc-forming-gds.start-sys-time    no-undo .
     4794   define input  parameter p-have-end-period   like ub.price-doc-forming-gds.have-end-period   no-undo .
     4795   define input  parameter p-end-date          like ub.price-doc-forming-gds.end-date          no-undo .
     4796   define input  parameter p-end-shift-date    like ub.price-doc-forming-gds.end-shift-date    no-undo .
     4797   define input  parameter p-end-shift-name    like ub.price-doc-forming-gds.end-shift-name    no-undo .
     4798   define input  parameter p-end-shift-num     like ub.price-doc-forming-gds.end-shift-num     no-undo .
     4799   define input  parameter p-end-sys-date      like ub.price-doc-forming-gds.end-sys-date      no-undo .
     4800   define input  parameter p-end-sys-time      like ub.price-doc-forming-gds.end-sys-time      no-undo .
     4801   define input  parameter p-price-calc-base   like ub.price-doc-forming-gds.price-calc-base   no-undo .
     4802   define input  parameter p-price-calc-doc    like ub.price-doc-forming-gds.price-calc-doc    no-undo .
     4803   define input  parameter p-price-calc-rubl   like ub.price-doc-forming-gds.price-calc-rubl   no-undo .
     4804   define input  parameter p-price-prev-base   like ub.price-doc-forming-gds.price-prev-base   no-undo .
     4805   define input  parameter p-price-prev-doc    like ub.price-doc-forming-gds.price-prev-doc    no-undo .
     4806   define input  parameter p-price-prev-rubl   like ub.price-doc-forming-gds.price-prev-rubl   no-undo .
     4807   define input  parameter p-price-sale-base   like ub.price-doc-forming-gds.price-sale-base   no-undo .
     4808   define input  parameter p-price-sale-doc    like ub.price-doc-forming-gds.price-sale-doc    no-undo .
     4809   define input  parameter p-price-sale-rubl   like ub.price-doc-forming-gds.price-sale-rubl   no-undo .
     4810   define input  parameter p-road-tax-base     like ub.price-doc-forming-gds.road-tax-base     no-undo .
     4811   define input  parameter p-road-tax-doc      like ub.price-doc-forming-gds.road-tax-doc      no-undo .
     4812   define input  parameter p-road-tax-rubl     like ub.price-doc-forming-gds.road-tax-rubl     no-undo .
     4813   define input  parameter p-excise-base       like ub.price-doc-forming-gds.excise-base       no-undo .
     4814   define input  parameter p-excise-doc        like ub.price-doc-forming-gds.excise-doc        no-undo .
     4815   define input  parameter p-excise-rubl       like ub.price-doc-forming-gds.excise-rubl       no-undo .
     4816   define input  parameter p-vat-pc            like ub.price-doc-forming-gds.vat-pc            no-undo .
     4817   define input  parameter p-slt-pc            like ub.price-doc-forming-gds.slt-pc            no-undo .
     4818   define input  parameter p-prev-doc-code     as character no-undo .
     4819   define input  parameter p-stts              like ub.price-doc-forming-gds.stts              no-undo .
     4820   define input-output parameter  v-sec        as integer   no-undo .
     4821     run check-use-bar-code ( p-b-code ) no-error .
     4822     if error-status :error then do:
     4823       message
     4824         return-value skip
     4825         "Ошибка !"
     4826         view-as alert-box error
     4827       .
     4828       undo, return error return-value.
     4829     end.
     4830   find first ub.price-doc-forming-gds exclusive-lock where
     4831              ub.price-doc-forming-gds.plt-db-num  =  p-plt-db-num and
     4832              ub.price-doc-forming-gds.plt-id      =  p-plt-id     and
     4833              ub.price-doc-forming-gds.pdf-db      =  p-pdf-db     and
     4834              ub.price-doc-forming-gds.pdf-id      =  p-pdf-id     and
     4835              ub.price-doc-forming-gds.b-code      =  p-b-code     no-error .
     4836       if not available ub.price-doc-forming-gds then
     4837       do:
     4838         create ub.price-doc-forming-gds .
     4839          assign
     4840           ub.price-doc-forming-gds.plt-db-num = p-plt-db-num
     4841           ub.price-doc-forming-gds.plt-id     = p-plt-id
     4842           ub.price-doc-forming-gds.pdf-db     = p-pdf-db
     4843           ub.price-doc-forming-gds.pdf-id     = p-pdf-id
     4844           ub.price-doc-forming-gds.b-code     = p-b-code
     4845           ub.price-doc-forming-gds.line-num   = p-line-num
     4846          .
     4847       end.
     4848     assign
     4849       ub.price-doc-forming-gds.artic            = p-artic
     4850       ub.price-doc-forming-gds.prod-type        = p-prod-type
     4851       ub.price-doc-forming-gds.prod-code        = p-prod-code
     4852       ub.price-doc-forming-gds.calc-method      = p-calc-method
     4853       ub.price-doc-forming-gds.d-pcnt            = p-d-pcnt
     4854       ub.price-doc-forming-gds.have-start-period = p-have-start-period
     4855       ub.price-doc-forming-gds.start-date       = p-start-date
     4856       ub.price-doc-forming-gds.start-shift-date = p-start-shift-date
     4857       ub.price-doc-forming-gds.start-shift-name = p-start-shift-name
     4858       ub.price-doc-forming-gds.start-shift-num  = p-start-shift-num
     4859       ub.price-doc-forming-gds.start-sys-date   = p-start-sys-date
     4860       ub.price-doc-forming-gds.start-sys-time   = p-start-sys-time
     4861       ub.price-doc-forming-gds.have-end-period  = p-have-end-period
     4862       ub.price-doc-forming-gds.end-date         = p-end-date
     4863       ub.price-doc-forming-gds.end-shift-date   = p-end-shift-date
     4864       ub.price-doc-forming-gds.end-shift-name   = p-end-shift-name
     4865       ub.price-doc-forming-gds.end-shift-num    = p-end-shift-num
     4866       ub.price-doc-forming-gds.end-sys-date     = p-end-sys-date
     4867       ub.price-doc-forming-gds.end-sys-time     = p-end-sys-time
     4868       ub.price-doc-forming-gds.price-calc-base  = p-price-calc-base
     4869       ub.price-doc-forming-gds.price-calc-doc   = p-price-calc-doc
     4870       ub.price-doc-forming-gds.price-calc-rubl  = p-price-calc-rubl
     4871       ub.price-doc-forming-gds.price-prev-base  = p-price-prev-base
     4872       ub.price-doc-forming-gds.price-prev-doc   = p-price-prev-doc
     4873       ub.price-doc-forming-gds.price-prev-rubl  = p-price-prev-rubl
     4874       ub.price-doc-forming-gds.road-tax-base    = p-road-tax-base
     4875       ub.price-doc-forming-gds.road-tax-doc     = p-road-tax-doc
     4876       ub.price-doc-forming-gds.road-tax-rubl    = p-road-tax-rubl
     4877       ub.price-doc-forming-gds.excise-base      = p-excise-base
     4878       ub.price-doc-forming-gds.excise-doc       = p-excise-doc
     4879       ub.price-doc-forming-gds.excise-rubl      = p-excise-rubl
     4880       ub.price-doc-forming-gds.vat-pc           = p-vat-pc
     4881       ub.price-doc-forming-gds.slt-pc           = p-slt-pc
     4882       ub.price-doc-forming-gds.prev-doc-code    = p-prev-doc-code
     4883       ub.price-doc-forming-gds.stts             = p-stts
     4884       ub.price-doc-forming-gds.price-sale-base  = p-price-sale-base
     4885       ub.price-doc-forming-gds.price-sale-doc   = p-price-sale-doc
     4886       ub.price-doc-forming-gds.price-sale-rubl  = p-price-sale-rubl
     4887       .
     4888     run ref/h-pdfgds.p
     4889       ( buffer ub.price-doc-forming-gds ,
     4890         input p-price-sale-doc ,
     4891         input-output v-sec
     4892         ) .
     4893   END PROCEDURE.
     4894   PROCEDURE last-num :
     4895   define input  parameter p-recid as recid no-undo .
     4896   define output parameter p-last-id as integer   no-undo .
     4897   define buffer buf2_price-doc-forming     for ub.price-doc-forming  .
     4898   define buffer buf2_price-doc-forming-gds for ub.price-doc-forming-gds  .
     4899   find first buf2_price-doc-forming no-lock where recid(buf2_price-doc-forming) = p-recid no-error .
     4900         if error-status :error then do:
     4901           p-last-id = ? .
     4902           return .
     4903         end.
     4904       for each buf2_price-doc-forming-gds no-lock  where
     4905               buf2_price-doc-forming-gds.plt-id     = buf2_price-doc-forming.plt-id     and
     4906               buf2_price-doc-forming-gds.plt-db-num = buf2_price-doc-forming.plt-db-num and
     4907               buf2_price-doc-forming-gds.pdf-id     = buf2_price-doc-forming.pdf-id     and
     4908               buf2_price-doc-forming-gds.pdf-db     = buf2_price-doc-forming.pdf-db
     4909               by buf2_price-doc-forming-gds.line-num
     4910               :
     4911               p-last-id = buf2_price-doc-forming-gds.line-num .
     4912       end.
     4913   END PROCEDURE.
     4914   PROCEDURE calc-price-alt :
     4915   define input parameter bc         like ub.bar-code.b-code   no-undo.
     4916   define input parameter p-recid as recid no-undo .
     4917   define input parameter d-pcnt as decimal   no-undo .
     4918   define input parameter r-method   as character no-undo .
     4919   define input parameter r-base     as decimal   no-undo .
     4920   define output parameter pa-price-sale-base  as decimal   no-undo .
     4921   define output parameter pa-price-sale-doc   as decimal   no-undo .
     4922   define output parameter pa-price-sale-rubl  as decimal   no-undo .
     4923   pr-alt:
     4924   do on error undo pr-alt, return error:
     4925     if r-method = ? or
     4926        r-base = ? then do:
     4927       message
     4928         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     4929         "Код:" bc skip
     4930         view-as alert-box error.
     4931       undo pr-alt, return error.
     4932     end.
     4933   define buffer buf_bar-code for ub.bar-code  .
     4934   define buffer buf_main_bar-code for ub.bar-code  .
     4935   define buffer buf_main_price-doc-forming for ub.price-doc-forming  .
     4936   define buffer buf_main_price-doc-forming-gds for ub.price-doc-forming-gds  .
     4937   find first buf_main_price-doc-forming no-lock where recid(buf_main_price-doc-forming) = p-recid  no-error .
     4938   if error-status :error then
     4939   message
     4940     vss-workfile vss-revision vss-description skip
     4941     error-status :get-message(1) skip
     4942     return-value skip
     4943     "Ошибка "
     4944     view-as alert-box error
     4945   .
     4946   find first buf_bar-code no-lock where
     4947              buf_bar-code.b-code = bc no-error .
     4948   if error-status :error then
     4949   message
     4950     vss-workfile vss-revision vss-description skip
     4951     error-status :get-message(1) skip
     4952     return-value skip
     4953     "3"
     4954     view-as alert-box error
     4955   .
     4956         assign
     4957           pa-price-sale-doc = fnc-base-price-doc ( input bc , input p-recid ) *
     4958                               buf_bar-code.cli-base-rate *
     4959                               (1 - d-pcnt / 100)
     4960                                 .
     4961     if pa-price-sale-doc <> 0 then do:
     4962   case r-method :
     4963     when '9-окончание':U then do:
     4964       if pa-price-sale-doc < 29 then do:
     4965         if (pa-price-sale-doc - truncate (pa-price-sale-doc, 0)) <> 0 then do:
     4966           assign
     4967             pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 1
     4968           .
     4969         end.
     4970       end.
     4971       else do:
     4972         if (pa-price-sale-doc modulo 10) < 3 then do:
     4973           assign
     4974             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     4975                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     4976                   - 1 ) * 10
     4977                 + 9
     4978           .
     4979         end.
     4980         else do:
     4981           assign
     4982             pa-price-sale-doc = (pa-price-sale-doc - (pa-price-sale-doc modulo 100))
     4983                 + ( truncate (((pa-price-sale-doc modulo 100) / 10), 0)
     4984                   ) * 10
     4985                 + 9
     4986           .
     4987         end.
     4988         assign
     4989           pa-price-sale-doc = round (pa-price-sale-doc, 0)
     4990         .
     4991       end.
     4992     end.
     4993     when '9-99окончание':U then do:
     4994       if pa-price-sale-doc < r-base then do:
     4995         assign
     4996           pa-price-sale-doc = truncate (pa-price-sale-doc, 0) + 0.99
     4997         .
     4998       end.
     4999       else do:
     5000         assign
     5001           pa-price-sale-doc = truncate (pa-price-sale-doc / 10 , 0) * 10 + 9.99
     5002         .
     5003       end.
     5004     end.
     5005     when 'Без-дробных':U then do:
     5006       assign
     5007         pa-price-sale-doc = round (pa-price-sale-doc, 0)
     5008       .
     5009     end.
     5010     when 'Произвольно':U then do:
     5011       if r-base <> 0 then do:
     5012         assign
     5013           pa-price-sale-doc = round (pa-price-sale-doc / r-base, 0) * r-base
     5014         .
     5015         if pa-price-sale-doc = 0 then do:
     5016           assign
     5017             pa-price-sale-doc = r-base
     5018           .
     5019         end.
     5020       end.
     5021     end.
     5022     when 'Вверх':U then do:
     5023       if r-base <> 0 then do:
     5024         if truncate ( pa-price-sale-doc / r-base, 0 ) <> (pa-price-sale-doc / r-base) then do:
     5025           assign
     5026             pa-price-sale-doc = truncate (pa-price-sale-doc / r-base, 0) * r-base + r-base
     5027           .
     5028         end.
     5029       end.
     5030       if pa-price-sale-doc = 0 then do:
     5031         assign
     5032           pa-price-sale-doc = r-base
     5033         .
     5034       end.
     5035     end.
     5036     when 'Коэффициент':U then do:
     5037       if r-base <> 0 then do:
     5038         assign
     5039           pa-price-sale-doc = pa-price-sale-doc * r-base
     5040         .
     5041       end.
     5042     end.
     5043     when 'Отключено':U then do:
     5044     end.
     5045     otherwise do:
     5046       message
     5047         vss-workfile vss-revision vss-description skip
     5048         "Неизвестный метод округления продажной цены" skip
     5049         "round-method" r-method skip
     5050         "round-base"   r-base   skip
     5051         "price"        pa-price-sale-doc             skip
     5052         view-as alert-box error .
     5053     end.
     5054   end.
     5055     end.
     5056     pa-price-sale-rubl = pa-price-sale-doc * buf_main_price-doc-forming.exch-rate / buf_main_price-doc-forming.exch-scale .
     5057     pa-price-sale-base = pa-price-sale-rubl / buf_main_price-doc-forming.base-rate * buf_main_price-doc-forming.base-scale .
     5058   end.
     5059   END PROCEDURE.
     5060   procedure calc-price-discnt :
     5061     do
     5062     on error undo, return error return-value
     5063     :
     5064   define input parameter p-recid as recid no-undo .
     5065   define input parameter bc    like ub.bar-code.b-code   no-undo.
     5066   define buffer buf-price-doc-forming             for ub.price-doc-forming.
     5067   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5068   define buffer buf-bar-code                      for ub.bar-code.
     5069   define buffer buf-goods                         for ub.goods.
     5070   define buffer old-price-doc-forming-gds         for ub.price-doc-forming-gds.
     5071   define variable pr-rec   as   recid                     no-undo.
     5072   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     5073   pr-discnt:
     5074   do on error undo pr-discnt, return error:
     5075     find  buf-price-doc-forming no-lock where
     5076           recid(buf-price-doc-forming) = p-recid .
     5077     find  buf-bar-code no-lock where
     5078           buf-bar-code.b-code = bc.
     5079     find  buf-goods no-lock where
     5080           buf-goods.gds-code = buf-bar-code.gds-code.
     5081     find  buf-price-doc-forming-gds exclusive-lock where
     5082           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5083           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5084           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5085           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5086           buf-price-doc-forming-gds.b-code  = bc.
     5087      if available buf-price-doc-forming-gds then do:
     5088         buf-price-doc-forming-gds.d-pcnt =
     5089         (1 - buf-price-doc-forming-gds.price-sale-doc /
     5090               fnc-base-price-doc ( buf-bar-code.b-code, p-recid ) /
     5091               buf-bar-code.cli-base-rate) * 100 .
     5092      end.
     5093   end.
     5094     end.
     5095   end procedure.
     5096   procedure calc-price-sub :
     5097   define  input  parameter bc           like ub.price-doc-forming-gds.b-code no-undo.
     5098   define  input  parameter p-recid      as recid no-undo .
     5099   define  input  parameter calc-method  as character         no-undo.
     5100   define  input  parameter increase-pc  as decimal           no-undo.
     5101   define  input  parameter round-method as character         no-undo.
     5102   define  input  parameter round-base   as decimal           no-undo.
     5103   define  input  parameter doc-code     as character no-undo .
     5104   define  input  parameter common-price as decimal   no-undo .
     5105   define  input  parameter copy-type    as character no-undo .
     5106   define  input  parameter copy-code    as integer   no-undo .
     5107   define  output parameter calc-rec     as recid             no-undo.
     5108   define  buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5109   define  buffer buf-bar-code              for ub.bar-code.
     5110   define  buffer buf-goods                 for ub.goods.
     5111   define  buffer buf-gds-prt               for ub.gds-prt.
     5112   define  buffer buf-gds-grp               for ub.gds-grp.
     5113   define  buffer buf-price-doc-forming     for ub.price-doc-forming.
     5114   calc-sub:
     5115   do on error undo calc-sub, return error:
     5116     find  buf-price-doc-forming no-lock where
     5117           recid (buf-price-doc-forming) =  p-recid .
     5118     find  buf-bar-code no-lock where
     5119           buf-bar-code.b-code = bc.
     5120     find  buf-goods no-lock where
     5121           buf-goods.gds-code = buf-bar-code.gds-code.
     5122     find  buf-gds-prt no-lock where
     5123           buf-gds-prt.node-code = buf-bar-code.node-code.
     5124     find  buf-price-doc-forming-gds where
     5125           buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5126           buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5127           buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5128           buf-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5129           buf-price-doc-forming-gds.b-code      = bc no-error .
     5130     calc-rec = recid (buf-price-doc-forming-gds).
     5131     if buf-gds-prt.upper-code = buf-goods.prt-root and  buf-goods.unit-base = buf-bar-code.unit-cli  then do:
     5132       for each  buf-price-doc-forming-gds exclusive-lock where
     5133                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5134                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5135                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5136                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5137                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5138                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5139                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5140           first buf-bar-code no-lock where
     5141                 buf-bar-code.b-code   = buf-price-doc-forming-gds.b-code and
     5142                 buf-bar-code.unit-cli = buf-goods.unit-base ,
     5143           first buf-gds-prt no-lock where
     5144                 buf-gds-prt.node-code = buf-bar-code.node-code and
     5145                 buf-gds-prt.upper-code <> buf-goods.prt-root
     5146           on error undo calc-sub, return error:
     5147             run calc-price-line  in this-procedure
     5148               ( input  calc-method
     5149               , input  increase-pc
     5150               , input  round-method
     5151               , input  round-base
     5152               , input  buf-bar-code.b-code
     5153               , input  buf-goods.gds-code
     5154               , input  buf-goods.artic
     5155               , input  buf-goods.prod-type
     5156               , input  buf-goods.prod-code
     5157               , input  buf-price-doc-forming.base-rate
     5158               , input  buf-price-doc-forming.base-scale
     5159               , input  buf-price-doc-forming.exch-scale
     5160               , input  buf-price-doc-forming.exch-rate
     5161               , input  doc-code
     5162               , input  common-price
     5163               , input  copy-type
     5164               , input  copy-code
     5165               , output buf-price-doc-forming-gds.calc-method
     5166               , output buf-price-doc-forming-gds.price-calc-base
     5167               , output buf-price-doc-forming-gds.price-calc-doc
     5168               , output buf-price-doc-forming-gds.price-calc-rubl
     5169               , output buf-price-doc-forming-gds.price-prev-base
     5170               , output buf-price-doc-forming-gds.price-prev-doc
     5171               , output buf-price-doc-forming-gds.price-prev-rubl
     5172               , output buf-price-doc-forming-gds.price-sale-base
     5173               , output buf-price-doc-forming-gds.price-sale-doc
     5174               , output buf-price-doc-forming-gds.price-sale-rubl
     5175               , output buf-price-doc-forming-gds.road-tax-base
     5176               , output buf-price-doc-forming-gds.road-tax-doc
     5177               , output buf-price-doc-forming-gds.road-tax-rubl
     5178               , output buf-price-doc-forming-gds.excise-base
     5179               , output buf-price-doc-forming-gds.excise-doc
     5180               , output buf-price-doc-forming-gds.excise-rubl
     5181               , output buf-price-doc-forming-gds.vat-pc
     5182               , output buf-price-doc-forming-gds.slt-pc
     5183               , output buf-price-doc-forming-gds.prev-doc-code
     5184               , output buf-price-doc-forming-gds.d-pcnt
     5185               ) no-error .
     5186             if error-status :error then do :
     5187               message
     5188                 vss-workfile vss-revision vss-description skip
     5189                 error-status :get-message(1) skip
     5190                 return-value skip
     5191                 "calc-price-line"
     5192                 view-as alert-box error
     5193               .
     5194               undo calc-sub, return error.
     5195               end.
     5196         calc-rec = recid (buf-price-doc-forming-gds).
     5197       end.
     5198       for each  buf-price-doc-forming-gds exclusive-lock where
     5199                 buf-price-doc-forming-gds.pdf-id    = buf-price-doc-forming.pdf-id and
     5200                 buf-price-doc-forming-gds.plt-id    = buf-price-doc-forming.plt-id and
     5201                 buf-price-doc-forming-gds.pdf-db    = buf-price-doc-forming.pdf-db and
     5202                 buf-price-doc-forming-gds.plt-db-num    = buf-price-doc-forming.plt-db-num and
     5203                 buf-price-doc-forming-gds.artic      = buf-goods.artic and
     5204                 buf-price-doc-forming-gds.prod-type  = buf-goods.prod-type and
     5205                 buf-price-doc-forming-gds.prod-code  = buf-goods.prod-code,
     5206           first buf-bar-code no-lock where
     5207                 buf-bar-code.b-code    = buf-price-doc-forming-gds.b-code and
     5208                 buf-bar-code.unit-cli <> buf-goods.unit-base ,
     5209           first buf-gds-prt no-lock where
     5210                 buf-gds-prt.node-code = buf-bar-code.node-code
     5211           on error undo calc-sub, return error:
     5212       end.
     5213     end.
     5214     else do:
     5215     end.
     5216   end.
     5217   end procedure.
     5218   procedure calc-base-update :
     5219   define input parameter bc           like ub.bar-code.b-code   no-undo.
     5220   define input parameter p-recid      as recid no-undo .
     5221   define input parameter round-method as character    no-undo.
     5222   define input parameter round-base   as decimal      no-undo.
     5223   define buffer alt-bar-code              for ub.bar-code.
     5224   define buffer alt-price-doc-forming-gds for ub.price-doc-forming-gds.
     5225   define buffer buf-bar-code              for ub.bar-code.
     5226   define buffer buf-goods                 for ub.goods.
     5227   define buffer buf-price-doc-forming     for ub.price-doc-forming  .
     5228   calc-base:
     5229   do on error undo calc-base, return error :
     5230     find  buf-price-doc-forming no-lock where
     5231           recid (buf-price-doc-forming) =  p-recid .
     5232     find  buf-bar-code no-lock where
     5233           buf-bar-code.b-code = bc.
     5234     find  buf-goods no-lock where
     5235           buf-goods.gds-code = buf-bar-code.gds-code.
     5236     for each  alt-bar-code no-lock where
     5237               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     5238               alt-bar-code.node-code = buf-bar-code.node-code and
     5239               alt-bar-code.part-code = buf-bar-code.part-code and
     5240               alt-bar-code.in-code   = buf-bar-code.in-code and
     5241               alt-bar-code.unit-cli <> buf-goods.unit-base,
     5242         each  alt-price-doc-forming-gds exclusive-lock where
     5243               alt-price-doc-forming-gds.pdf-id      = buf-price-doc-forming.pdf-id and
     5244               alt-price-doc-forming-gds.plt-id      = buf-price-doc-forming.plt-id and
     5245               alt-price-doc-forming-gds.pdf-db      = buf-price-doc-forming.pdf-db and
     5246               alt-price-doc-forming-gds.plt-db-num  = buf-price-doc-forming.plt-db-num and
     5247               alt-price-doc-forming-gds.b-code      = alt-bar-code.b-code
     5248         on error undo calc-base, return error:
     5249     run calc-price-alt in this-procedure
     5250         ( input  alt-price-doc-forming-gds.b-code
     5251         , input  p-recid
     5252         , input  alt-price-doc-forming-gds.d-pcnt
     5253         , input  round-method
     5254         , input  round-base
     5255         , output alt-price-doc-forming-gds.price-sale-base
     5256         , output alt-price-doc-forming-gds.price-sale-doc
     5257         , output alt-price-doc-forming-gds.price-sale-rubl
     5258         ) no-error .
     5259       if error-status:error then do:
     5260       message
     5261         vss-workfile vss-revision vss-description skip
     5262         error-status :get-message(1) skip
     5263         return-value skip
     5264         "calc-price-alt"
     5265         view-as alert-box error
     5266       .
     5267         undo calc-base, return error.
     5268       end.
     5269     end.
     5270   end.
     5271   end procedure.
     5272   define temp-table temp-exp-partbc no-undo
     5273   field b-code  as integer
     5274   index pi b-code
     5275   .
     5276   procedure expose-prt :
     5277   define input  parameter p-calc-method  as character no-undo .
     5278   define input  parameter p-increase-pc as decimal   no-undo .
     5279   define input  parameter p-main-code    like ub.goods.gds-code    no-undo.
     5280   define input  parameter old-recid      as recid no-undo .
     5281   define input  parameter new-recid      as recid no-undo .
     5282   define input  parameter p-round-method as character no-undo .
     5283   define input  parameter p-round-base   as decimal   no-undo .
     5284   define input  parameter v-doc-code     as character no-undo .
     5285   define input  parameter v-common-price as decimal   no-undo .
     5286   define input  parameter v-copy-type    as character no-undo .
     5287   define input  parameter v-copy-code    as integer   no-undo .
     5288   define input-output parameter v-line-num as integer   no-undo .
     5289   define input-output parameter v-sec      as integer   no-undo .
     5290   define output parameter new-rec-str      as recid   no-undo.
     5291   define buffer buf-bar-code              for ub.bar-code.
     5292   define buffer buf-goods                 for ub.goods.
     5293   define buffer buf-price-doc-forming-gds for ub.price-doc-forming-gds.
     5294   define buffer buf-price-list            for ub.price-doc-forming-gds.
     5295   define buffer buf-price-doc-forming     for ub.price-doc-forming.
     5296   define buffer new-price-doc-forming     for ub.price-doc-forming.
     5297   define buffer new-price-doc-forming-gds for ub.price-doc-forming-gds  .
     5298   define buffer buf-gds-prt               for ub.gds-prt  .
     5299   define buffer buf_parts for ub.parts  .
     5300   define buffer buf_goods for ub.goods  .
     5301     do
     5302     on error undo, return error return-value
     5303     :
     5304     find  buf-price-doc-forming no-lock where
     5305           recid(buf-price-doc-forming) = old-recid .
     5306     find  new-price-doc-forming no-lock where
     5307           recid(new-price-doc-forming) = new-recid .
     5308     find  buf-bar-code no-lock where
     5309           buf-bar-code.b-code = p-main-code.
     5310     find  buf-goods no-lock where
     5311           buf-goods.gds-code = buf-bar-code.gds-code.
     5312     find  buf-price-doc-forming-gds no-lock  where
     5313           buf-price-doc-forming-gds.pdf-id = buf-price-doc-forming.pdf-id and
     5314           buf-price-doc-forming-gds.plt-id = buf-price-doc-forming.plt-id and
     5315           buf-price-doc-forming-gds.pdf-db     = buf-price-doc-forming.pdf-db and
     5316           buf-price-doc-forming-gds.plt-db-num = buf-price-doc-forming.plt-db-num and
     5317           buf-price-doc-forming-gds.b-code  = p-main-code no-error .
     5318     if error-status :error then return .
     5319     find  buf-gds-prt no-lock where
     5320           buf-gds-prt.node-code = buf-bar-code.node-code.
     5321   if par-pr-altex = "yes" and
     5322      par-pr-notls = "yes" then do:
     5323   for each  buf-price-list where
     5324             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     5325             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     5326             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5327             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5328             buf-price-list.b-code     <> p-main-code and
     5329             buf-price-list.artic       = buf-goods.artic  and
     5330             buf-price-list.prod-type   = buf-goods.prod-type and
     5331             buf-price-list.prod-code   = buf-goods.prod-code
     5332             ,
     5333       first buf-bar-code no-lock where
     5334             buf-bar-code.b-code   = buf-price-list.b-code and
     5335             buf-bar-code.unit-cli <> buf-goods.unit-base:
     5336      run create-calc-bc in this-procedure
     5337          ( input  recid( new-price-doc-forming )
     5338           ,input  p-calc-method
     5339           ,input  p-increase-pc
     5340           ,input  p-round-method
     5341           ,input  p-round-base
     5342           ,input  buf-bar-code.b-code
     5343           ,input  buf-goods.gds-code
     5344           ,input  buf-goods.artic
     5345           ,input  buf-goods.prod-type
     5346           ,input  buf-goods.prod-code
     5347           ,input  new-price-doc-forming.base-rate
     5348           ,input  new-price-doc-forming.base-scale
     5349           ,input  new-price-doc-forming.exch-scale
     5350           ,input  new-price-doc-forming.exch-rate
     5351           ,input  v-doc-code
     5352           ,input  v-common-price
     5353           ,input  v-copy-type
     5354           ,input  v-copy-code
     5355           ,input-output v-line-num
     5356           ,input-output v-sec
     5357         ) no-error .
     5358     if error-status:error then do:
     5359       message
     5360         "Ошибка cre-pr-list."                skip
     5361         "Код:" buf-bar-code.b-code           skip
     5362         error-status :get-message(1)         skip
     5363         return-value                         skip
     5364          "pdf" new-price-doc-forming.pdf-id  skip
     5365         view-as alert-box.
     5366       next.
     5367     end.
     5368   end.
     5369   end.
     5370   if par-pr-sclex = "yes" and
     5371      par-pr-notls = "yes" then do:
     5372   for each  buf-price-list where
     5373             buf-price-list.pdf-id = buf-price-doc-forming.pdf-id and
     5374             buf-price-list.plt-id = buf-price-doc-forming.plt-id and
     5375             buf-price-list.pdf-db     = buf-price-doc-forming.pdf-db and
     5376             buf-price-list.plt-db-num = buf-price-doc-forming.plt-db-num and
     5377             buf-price-list.b-code     <> p-main-code and
     5378             buf-price-list.artic       = buf-goods.artic  and
     5379             buf-price-list.prod-type   = buf-goods.prod-type and
     5380             buf-price-list.prod-code   = buf-goods.prod-code  ,
     5381       first buf-bar-code no-lock where
     5382             buf-bar-code.b-code   = buf-price-list.b-code and
     5383             buf-bar-code.unit-cli = buf-goods.unit-base and
     5384             buf-bar-code.in-code = ""
     5385             :
     5386      run create-calc-bc in this-procedure
     5387          ( input  recid( new-price-doc-forming )
     5388           ,input  p-calc-method
     5389           ,input  p-increase-pc
     5390           ,input  p-round-method
     5391           ,input  p-round-base
     5392           ,input  buf-bar-code.b-code
     5393           ,input  buf-goods.gds-code
     5394           ,input  buf-goods.artic
     5395           ,input  buf-goods.prod-type
     5396           ,input  buf-goods.prod-code
     5397           ,input  new-price-doc-forming.base-rate
     5398           ,input  new-price-doc-forming.base-scale
     5399           ,input  new-price-doc-forming.exch-scale
     5400           ,input  new-price-doc-forming.exch-rate
     5401           ,input v-doc-code
     5402           ,input v-common-price
     5403           ,input v-copy-type
     5404           ,input v-copy-code
     5405           ,input-output v-line-num
     5406           ,input-output v-sec
     5407         ) no-error .
     5408         if error-status:error then do:
     5409           message
     5410             "Ошибка cre-pr-list.2" skip
     5411             "Код:" buf-bar-code.b-code
     5412             view-as alert-box.
     5413           next.
     5414         end.
     5415       end.
     5416   end.
     5417   if par-pr-parex = "yes" and
     5418      par-pr-notls = "yes" then do:
     5419   define buffer bt_trn-doc  for ub.trn-doc  .
     5420   define buffer bf_parts    for ub.parts  .
     5421   define buffer free_parts  for ub.parts  .
     5422   define buffer buf_gds-obj for ub.gds-obj  .
     5423   find first buf_gds-obj no-lock where
     5424              buf_gds-obj.gds-code = buf-goods.gds-code and
     5425              buf_gds-obj.obj-type = v-cntxt-obj-type   and
     5426              buf_gds-obj.obj-code = v-cntxt-obj-code   and
     5427              buf_gds-obj.cash-parts = true
     5428              no-error .
     5429   if not available buf_gds-obj then return .
     5430    find first bt_trn-doc no-lock where
     5431               bt_trn-doc.doc-code = v-doc-code no-error .
     5432    if v-doc-code <> "" and available bt_trn-doc then do:
     5433    for each temp-exp-partbc :
     5434        delete temp-exp-partbc.
     5435    end.
     5436    for each bf_parts no-lock where
     5437             bf_parts.out-code   = bt_trn-doc.doc-code and
     5438             bf_parts.obj-type   = bt_trn-doc.obj-type and
     5439             bf_parts.obj-code   = bt_trn-doc.obj-code and
     5440             bf_parts.artic      = buf-goods.artic     and
     5441             bf_parts.prod-type  = buf-goods.prod-type and
     5442             bf_parts.prod-code  = buf-goods.prod-code  ,
     5443           first free_parts no-lock where
     5444                 free_parts.in-code   = bf_parts.in-code   and
     5445                 free_parts.part-code = bf_parts.part-code and
     5446                 free_parts.out-code  = 'free-zone':U       and
     5447                 free_parts.rsrv-free = true               and
     5448                 free_parts.status_   = false              and
     5449                 free_parts.obj-type  = bf_parts.obj-type  and
     5450                 free_parts.obj-code  = bf_parts.obj-code  and
     5451                 free_parts.artic     = bf_parts.artic     and
     5452                 free_parts.prod-type = bf_parts.prod-type and
     5453                 free_parts.prod-code = bf_parts.prod-code ,
     5454           first buf-bar-code no-lock where
     5455                 buf-bar-code.gds-code  = buf-goods.gds-code and
     5456                 buf-bar-code.unit-cli  = buf-goods.unit-base and
     5457                 buf-bar-code.in-code   = bf_parts.in-code and
     5458                 buf-bar-code.part-code = bf_parts.part-code
     5459                 :
     5460      run create-calc-bc in this-procedure
     5461          ( input  recid( new-price-doc-forming )
     5462           ,input  p-calc-method
     5463           ,input  p-increase-pc
     5464           ,input  p-round-method
     5465           ,input  p-round-base
     5466           ,input  buf-bar-code.b-code
     5467           ,input  buf-goods.gds-code
     5468           ,input  buf-goods.artic
     5469           ,input  buf-goods.prod-type
     5470           ,input  buf-goods.prod-code
     5471           ,input  new-price-doc-forming.base-rate
     5472           ,input  new-price-doc-forming.base-scale
     5473           ,input  new-price-doc-forming.exch-scale
     5474           ,input  new-price-doc-forming.exch-rate
     5475           ,input v-doc-code
