     8689           ub.obj-grp-obj-price.stts          = p-stts
     8690           ub.obj-grp-obj-price.sys-date      = today
     8691           ub.obj-grp-obj-price.sys-time      = time
     8692           ub.obj-grp-obj-price.sys-time-chr  = string ( ub.obj-grp-obj-price.sys-time,"hh:mm" )
     8693           ub.obj-grp-obj-price.who           = p-userid
     8694           p-recid = recid ( ub.obj-grp-obj-price )
     8695         .
     8696         ub.grp-obj-price.sys-time = time .
     8697         run ref/h-grpi.p (buffer ub.obj-grp-obj-price , input-output v-sec )  .
     8698     end.
     8699   end procedure.
     8700   PROCEDURE objo-del :
     8701   define input  parameter p-db-num       as integer   no-undo .
     8702   define input  parameter p-id           as integer   no-undo .
     8703   define input  parameter p-obj-type   as character no-undo .
     8704   define input  parameter p-obj-code   as integer   no-undo .
     8705   define input  parameter p-db-num-usr   as integer   no-undo .
     8706   define input  parameter p-userid       as character no-undo .
     8707     do
     8708     on error undo, return error return-value
     8709     :
     8710   find first ub.grp-obj-price exclusive-lock where
     8711           ub.grp-obj-price.gop-db-num   = p-db-num  and
     8712           ub.grp-obj-price.gop-id       = p-id
     8713           .
     8714   find first ub.obj-grp-obj-price exclusive-lock where
     8715           ub.obj-grp-obj-price.gop-db-num   = p-db-num  and
     8716           ub.obj-grp-obj-price.gop-id       = p-id      and
     8717           ub.obj-grp-obj-price.obj-type    = p-obj-type and
     8718           ub.obj-grp-obj-price.obj-code    = p-obj-code
     8719           no-error .
     8720    if not available ub.obj-grp-obj-price then  return error .
     8721         assign
     8722           ub.obj-grp-obj-price.db-num-chg    = p-db-num-usr
     8723           ub.obj-grp-obj-price.stts          = 1
     8724           ub.obj-grp-obj-price.sys-date      = today
     8725           ub.obj-grp-obj-price.sys-time      = time
     8726           ub.obj-grp-obj-price.sys-time-chr  = string(ub.obj-grp-obj-price.sys-time,"hh:mm")
     8727           ub.obj-grp-obj-price.who           = p-userid
     8728         .
     8729        ub.grp-obj-price.sys-time = time .
     8730        run ref/h-grpi.p (buffer ub.obj-grp-obj-price , input-output v-sec )  .
     8731     end.
     8732   end procedure.
     8733   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8734   define variable v-waitfram-action01         as character   no-undo .
     8735   define variable v-waitfram-action02         as character   no-undo .
     8736   define variable v-waitfram-action03         as character   no-undo .
     8737   define variable mWaitFramTextBeg            as character   no-undo.
     8738   define variable mWaitFramTextEnd            as character   no-undo.
     8739   define variable mWaitFramView               as logical     no-undo.
     8740   define variable mWaitProcEvent              as logical     no-undo init yes.
     8741   define variable mWaitFramInterval           as integer     no-undo init 1 .
     8742   define variable mWaitFramStop               as logical     no-undo.
     8743   define variable mWaitFramStopUser           as logical     no-undo.
     8744   define variable mWaitFramStopTimeOut        as logical     no-undo.
     8745   define variable mWaitFramStartProc          as datetime-tz no-undo.
     8746   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     8747   define button B-WaitFramStop auto-end-key
     8748        label "Стоп"
     8749        size 10 by 1 tooltip "Остоновить процесс".
     8750   define button B-viewProcInfo
     8751        label "Информация"
     8752        size 15 by 1 tooltip "Информация о процесс".
     8753   define frame waitfram
     8754     v-waitfram-action01 format "x(72)" no-label skip
     8755     v-waitfram-action02 format "x(72)" no-label skip
     8756     v-waitfram-action03 format "x(72)" no-label skip
     8757     B-viewProcInfo
     8758     B-WaitFramStop at row 4 col 30
     8759     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     8760     .
     8761   define new global shared variable mBatchMode as logical no-undo init ?.
     8762   define variable mFramBachModHandle as handle no-undo.
     8763   mFramBachModHandle = frame waitfram:handle.
     8764   define variable mFameOldVis as logical no-undo.
     8765   define variable mVisCUrentVin as logical no-undo.
     8766   if session:batch-mode
     8767   then
     8768      mBatchMode = yes.
     8769   if mBatchMode = ? then do:
     8770     mVisCUrentVin = current-window:visible.
     8771     mFameOldVis = mFramBachModHandle:visible.
     8772     mFramBachModHandle:visible  = yes.
     8773     mBatchMode = mFramBachModHandle:visible ne yes.
     8774     mFramBachModHandle:visible = mFameOldVis.
     8775     current-window:visible = mVisCUrentVin.
     8776   end.
     8777    if  log-manager:logfile-name ne ?
     8778     then DO:
     8779         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     8780         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     8781         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     8782     end.
     8783   on choose of B-WaitFramStop in frame waitfram
     8784   do:
     8785     mWaitFramStop = yes.
     8786     mWaitFramStopUser = yes.
     8787   end.
     8788   function waitfram-check-timeout returns logical():
     8789      define variable vtime as int64 no-undo.
     8790      if mWaitFramStopTimeOut
     8791      then
     8792         return yes.
     8793      vtime = ( now - mWaitFramStartProc ) / 1000 .
     8794      if     mWaitFramTimeOut ne ?
     8795         and mWaitFramTimeOut ne 0
     8796         and mWaitFramTimeOut lt vtime
     8797      then do:
     8798         mWaitFramStopTimeOut = yes.
     8799      end.
     8800      return mWaitFramStopTimeOut.
     8801   end.
     8802   procedure waitfram-hide :
     8803     if not session:batch-mode
     8804     then do
     8805     on error undo, return error return-value
     8806     :
     8807       pause 0 before-hide .
     8808       if not mBatchMode then
     8809         hide frame waitfram .
     8810     if     not mWaitFramView
     8811        and mWaitProcEvent
     8812     then
     8813       process events .
     8814     end.
     8815   end procedure.
     8816   procedure waitfram-show :
     8817     define input  parameter p-message as character no-undo .
     8818     define variable v-left-margin as integer   no-undo .
     8819     if not session:batch-mode
     8820     then do
     8821     on error undo, return error return-value
     8822     :
     8823       if length(p-message) <= 70 then do:
     8824         assign
     8825           v-left-margin = integer((70 - length(p-message)) / 2)
     8826         .
     8827         assign
     8828           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     8829         .
     8830         assign
     8831           v-waitfram-action01 = " "
     8832           v-waitfram-action02 = " "
     8833                                    + fill(" ", v-left-margin)
     8834                                    + p-message
     8835           v-waitfram-action03 = " "
     8836         .
     8837       end.
     8838       else do:
     8839         define variable vRindex1 as integer no-undo.
     8840         define variable vRindex2 as integer no-undo.
     8841         vRindex1 = r-index(p-message," ",70).
     8842         if vRindex1 = 0
     8843         then
     8844            vRindex1 = 70.
     8845         if length(p-message)  <= vRindex1 + 70 then do:
     8846           assign
     8847             v-waitfram-action01 = " "
     8848             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     8849             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     8850           .
     8851         end.
     8852         else do:
     8853           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     8854           if vRindex2 <= vRindex1
     8855           then
     8856              vRindex2 = vRindex1 + 70.
     8857           assign
     8858             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     8859             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     8860             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     8861           .
     8862         end.
     8863       end.
     8864       B-viewProcInfo:visible   in frame waitfram = no.
     8865       B-viewProcInfo:sensitive in frame waitfram = no.
     8866       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     8867       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     8868       if  (   mWaitFramView
     8869          or  mWaitProcEvent)
     8870          and not mBatchMode
     8871       then
     8872          display
     8873             v-waitfram-action01 skip
     8874             v-waitfram-action02 skip
     8875             v-waitfram-action03 skip
     8876          with frame waitfram .
     8877       if     mWaitFramView
     8878          then do:
     8879             if     mWaitFramInterval ne ?
     8880                and not mBatchMode
     8881             then
     8882                wait-for go of frame waitfram pause mWaitFramInterval.
     8883          end.
     8884          else
     8885             if     mWaitProcEvent
     8886                and not mBatchMode
     8887             then
     8888                process events .
     8889     end.
     8890   end procedure.
     8891      procedure waitfram-show-this:
     8892         define input  parameter iInterval as int64 no-undo.
     8893         define variable vtime as int64 no-undo.
     8894         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     8895         mWaitFramInterval = iInterval.
     8896         run waitfram-show (substitute("&1&2 &3&4" ,
     8897                                       mWaitFramTextBeg ,
     8898                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     8899                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     8900                                       mWaitFramTextEnd
     8901                                      )
     8902                           ).
     8903      end.
     8904      procedure WaitFramRunPause:
     8905         define input  parameter iInterval as dec no-undo.
     8906         define variable vStart  as datetime-tz no-undo.
     8907         define variable vend    as datetime-tz no-undo.
     8908         define variable vint as int64 no-undo.
     8909         define variable vOk as logical no-undo.
     8910         vStart = now.
     8911         vend   = vStart.
     8912         publish "WaitFramPause" (iInterval,output vOk).
     8913         vend   =  now.
     8914         vint = vend - vStart.
     8915         vint = iInterval - vint / 1000.
     8916         if     not mWaitFramStop
     8917            and (   vint > 0
     8918                 or (    not vOk
     8919                     and iInterval eq ?
     8920                     )
     8921                 )
     8922         then
     8923            run waitfram-show-this (iInterval).
     8924         vend   =  now.
     8925         vint = vend - vStart.
     8926         vint = iInterval - vint / 1000.
     8927         if     not mWaitFramStop
     8928            and vint > 0
     8929         then do:
     8930            run gbl/pause.p (vint * 1000).
     8931         end.
     8932         if iInterval ne ?
     8933         then
     8934            publish "WaitFramStop".
     8935         waitfram-check-timeout().
     8936      end.
     8937      procedure WaitFramWaitFor:
     8938         define input  parameter iInterval as dec no-undo.
     8939         assign
     8940            mWaitFramStartProc   = now
     8941            mWaitFramStopUser    = no
     8942            mWaitFramStopTimeOut = no
     8943         .
     8944         block-wait:
     8945         do while not mWaitFramStop:
     8946            run WaitFramRunPause (iInterval).
     8947            if  waitfram-check-timeout()
     8948            then do:
     8949               leave block-wait.
     8950            end.
     8951         end.
     8952         run waitfram-hide.
     8953      end.
     8954   procedure waitfram-join :
     8955     define input  parameter p-line-1  as character no-undo .
     8956     define input  parameter p-line-2  as character no-undo .
     8957     define input  parameter p-line-3  as character no-undo .
     8958     define output parameter p-message as character no-undo .
     8959     do
     8960     on error undo, return error return-value
     8961     :
     8962       assign
     8963         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     8964                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     8965                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     8966       .
     8967     end.
     8968   end procedure.
     8969   function waitfram-join-function returns character
     8970     (input p-line-1 as character
     8971     ,input p-line-2 as character
     8972     ,input p-line-3 as character
     8973     ).
     8974     define variable v-message as character no-undo .
     8975     run waitfram-join in this-procedure
     8976       (input  p-line-1
     8977       ,input  p-line-2
     8978       ,input  p-line-3
     8979       ,output v-message
     8980       ) .
     8981     return v-message .
     8982   end function .
     8983   define buffer buf_goods    for ub.goods .
     8984   define buffer buf_bar-code for ub.bar-code.
     8985   define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds.
     8986   define stream imp.
     8987   define stream err.
     8988   define variable text-string     as     character no-undo .
     8989   define variable i-doc-num       like   ub.price-doc-forming.pdf-id     no-undo .
     8990   define variable i-doc-db-num    as integer   no-undo .
     8991   define variable loc-ref-list    as     character no-undo .
     8992   define variable i-price         like ub.price-list.price-sale     no-undo.
     8993   define variable i-d-pcnt        like ub.price-list.d-pcnt      no-undo.
     8994   define variable impc as integer No-UNDO.
     8995   define variable imp-save as integer No-UNDO.
     8996   define variable v-b-code as integer no-undo .
     8997   define variable i-artic as char no-undo.
     8998   define variable i-scale as char no-undo.
     8999   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9000     run mainmenu_getcntxt in parparentproc
     9001       (output v-cntxt-db-num
     9002       ,output v-cntxt-userid
     9003       ,output v-cntxt-level
     9004       ,output v-cntxt-host-code-obj
     9005       ,output v-cntxt-obj-type
     9006       ,output v-cntxt-obj-code
     9007       ,output v-cntxt-db-num-obj
     9008       ,output v-cntxt-is-admin
     9009       ) .
     9010   for each x_obj-group : delete x_obj-group . end.
     9011   run str/docsprls.w ( parparentproc , "all" , ? , ? , "b-sel" , input-output loc-ref-list ) .
     9012   if loc-ref-list = '' then do:
     9013     message
     9014     "ДНЦ не выбран."
     9015     view-as alert-box error.
     9016     return error.
     9017   end.
     9018   find first  buf_price-doc-forming exclusive-lock where recid (buf_price-doc-forming) = integer(loc-ref-list).
     9019   if buf_price-doc-forming.stts <> int('0':U) then do:
     9020     message
     9021     "Статус ДНЦ должен быть 'новый'."
     9022     view-as alert-box error.
     9023     return error.
     9024   end.
     9025   define buffer buf_price-list-type for ub.price-list-type  .
     9026   find first  buf_price-list-type no-lock where
     9027               buf_price-list-type.plt-id     = buf_price-doc-forming.plt-id and
     9028               buf_price-list-type.plt-db-num = buf_price-doc-forming.plt-db-num no-error .
     9029               if error-status :error or buf_price-list-type.stts = int('1':U)  then do:
     9030                 message
     9031                 "Статус ТПЛ удален, или нет доступа."
     9032                 return-value error-status :get-message(1)
     9033                 view-as alert-box error.
     9034                 return error.
     9035               end.
     9036     run metod-gop-obj in this-procedure (
     9037         v-cntxt-db-num ,
     9038         buf_price-list-type.gop-id ,
     9039         buf_price-list-type.gop-db-num
     9040         )  .
     9041   i-doc-num = buf_price-doc-forming.pdf-id.
     9042   i-doc-db-num = buf_price-doc-forming.pdf-db .
     9043   define variable l-ok as logical   no-undo .
     9044   run chec-par in this-procedure (output l-ok , input v-cntxt-host-code-obj, input v-cntxt-obj-type,input v-cntxt-obj-code ) no-error .
     9045   input stream imp from value (file-name) .
     9046   repeat:
     9047     text-string = "".
     9048     IMPORT stream imp UNFORMATTED text-string NO-ERROR.
     9049     if trim(text-string) = "" then leave.
     9050     impc          = impc + 1.
     9051     if num-entries (text-string, ";") <> 11 then do:
     9052       OUTPUT stream Err TO value ("Imp_Price.err") append.
     9053       put stream Err unformatted
     9054       string(today, "99/99/9999") " "
     9055       string(time, "HH:MM")
     9056       " Неправильное число параметров в строке, должно быть 10, в конце строки должен стоять знак ;" skip.
     9057       export stream  Err text-string .
     9058       output stream Err close.
     9059       next.
     9060     end.
     9061     assign
     9062     i-artic = ENTRY( 1, text-string, ";")
     9063     i-price = dec(ENTRY( 7, text-string, ";"))
     9064     .
     9065     i-scale  = "/".
     9066     overlay ( i-artic, r-index(i-artic, "-"), 1) = i-scale no-error .
     9067     i-scale = substring( i-artic, r-index(i-artic, "-") + 1 ) no-error .
     9068     i-artic = substring( i-artic, 1, r-index(i-artic, "-") - 1 ) no-error .
     9069     display
     9070     impc  label "Прочитано"
     9071     imp-save label "Сохранено"
     9072     i-artic format "x(10)" label "Артикул"
     9073     text-string format "x(40)" label "Строка файла"
     9074     with frame ff view-as dialog-box
     9075     title substitute(": Импорт товаров из файла в ДНЦ &1-&2" , i-doc-num , i-doc-db-num ) .
     9076     pause 0.
     9077     find first buf_goods no-lock where
     9078                buf_goods.artic = i-artic no-error.
     9079     if not available buf_goods then do:
     9080       OUTPUT stream Err TO value ("Imp_Price.err") append.
     9081       put stream Err unformatted
     9082       string(today, "99/99/9999") " "
     9083       string(time, "HH:MM")
     9084       " Товар не найден в справочнике товаров" skip.
     9085       export stream  Err text-string .
     9086       output stream Err close.
     9087       next.
     9088     end.
     9089   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9090     (input  buf_goods.gds-code
     9091     ,input  ?
     9092     ,output v-b-code
     9093     ) no-error .
     9094     if error-status:error then do:
     9095       OUTPUT stream Err TO value ("Imp_Price.err") append.
     9096       put stream Err unformatted
     9097       string(today, "99/99/9999") " "
     9098       string(time, "HH:MM")
     9099       " У товара нет собственного Бар-Кода" skip.
     9100       export stream  Err text-string .
     9101       output stream Err close.
     9102       next.
     9103     end.
     9104     if i-price <= 0 or i-price = ? then do:
     9105       OUTPUT stream Err TO value ("Imp_Price.err") append.
     9106       put stream Err unformatted
     9107       string(today, "99/99/9999") " "
     9108       string(time, "HH:MM")
     9109       " У товара  цена не задана" skip.
     9110       export stream err text-string .
     9111       output stream err close.
     9112       next.
     9113     end.
     9114     find first buf_price-doc-forming-gds exclusive-lock where
     9115                 buf_price-doc-forming-gds.plt-id     = buf_price-doc-forming.plt-id
     9116            and  buf_price-doc-forming-gds.plt-db-num = buf_price-doc-forming.plt-db-num
     9117            and  buf_price-doc-forming-gds.pdf-id     = buf_price-doc-forming.pdf-id
     9118            and  buf_price-doc-forming-gds.pdf-db     = buf_price-doc-forming.pdf-db
     9119            and  buf_price-doc-forming-gds.b-code     = v-b-code no-error .
     9120     if available buf_price-doc-forming-gds then do:
     9121        delete buf_price-doc-forming-gds.
     9122     end.
     9123             imp-save = imp-save + 1 .
     9124             run prcreate-new-price-doc-forming-gds in this-procedure (
     9125                 input recid ( buf_price-doc-forming )
     9126               , input v-cntxt-obj-type
     9127               , input v-cntxt-obj-code
     9128               , input par-pr-notls
