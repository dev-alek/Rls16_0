     4055   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bc-mpl in g#library2
     4056     (input  buf_price-list-type.gop-id
     4057     ,input  buf_price-list-type.gop-db-num
     4058     ,input  p-b-code
     4059     ,input  0
