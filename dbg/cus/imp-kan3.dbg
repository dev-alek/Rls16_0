     1076   define variable par-pr-nogds as character no-undo.
     1077   define variable par-alcohol  as character no-undo.
     1078   define variable par-gen-mrgn-ie as character no-undo .
     1079   define variable par-gen-mrgn-iv as character no-undo .
     1080   define variable par-gen-mrgn-im as character no-undo .
     1081   define variable par-pr-nakl-ie  as logical   no-undo .
     1082   define variable par-pr-nakl-iv  as logical   no-undo .
     1083   define variable par-pr-nakl-im  as logical   no-undo .
     1084   define variable par-pr-nogds-long as longchar no-undo .
     1085   define temp-table tmp-proof-price no-undo
     1086     field node-code like ub.gds-grp.node-code
     1087     field proof as decimal
     1088     field price as decimal
     1089   index pi node-code proof descending .
     1090   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1091   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1092   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1093   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1094   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1095   ASSIGN
     1096      v-S_CONTRACT                = "Contract":U
     1097      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1098      v-DELIM_CHR_3               = ","
     1099      .
     1100   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1101   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1102   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1103   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1104      INPUT iHost-Code    AS INTEGER,
     1105      INPUT iContract-Num AS INTEGER,
     1106      INPUT iGds-Code     AS INTEGER ):
     1107      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1108      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1109      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1110      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1111      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1112      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1113          INPUT  iHost-Code,
     1114          INPUT  iContract-Num,
     1115          OUTPUT iTmp-Extent3
     1116          ).
     1117      IF iTmp-Extent3[1] = 2 THEN DO:
     1118         ASSIGN
     1119            iTmp-Host-Code      = iTmp-Extent3[2]
     1120            iTmp-Contract-Num   = iTmp-Extent3[3]
     1121            .
     1122      END. ELSE DO:
     1123         ASSIGN
     1124            iTmp-Host-Code      = iHost-Code
     1125            iTmp-Contract-Num   = iContract-Num
     1126            .
     1127      END.
     1128      IF iGds-Code = ? THEN DO:
     1129         ASSIGN
     1130            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1131                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1132                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1133                           ).
     1134      END. ELSE DO:
     1135            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1136                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1137                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1138                              AND buf_Spec.Gds-Code      = iGds-Code
     1139                            ).
     1140      END.
     1141      RETURN (lRet).
     1142   END FUNCTION.
     1143   PROCEDURE MS-Contract-EXTENT-3:
     1144      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1145      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1146      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1147      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1148      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1149      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1150      FIND FIRST buf_Cont-2 WHERE
     1151                 buf_Cont-2.Host-Code      = i-Host-Code
     1152             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1153           NO-LOCK NO-ERROR.
     1154      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1155         RETURN.
     1156      END.
     1157      FOR FIRST buf_Ext-Classif WHERE
     1158                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1159           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1160                                               STRING(i-Contract-code)
     1161           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1162          NO-LOCK,
     1163          EACH buf_Cont WHERE
     1164               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1165           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1166          NO-LOCK:
     1167          ASSIGN
     1168             i-Ret[1] = 1
     1169             i-Ret[2] = buf_Cont.Host-code
     1170             i-Ret[3] = buf_Cont.Contract-code
     1171             .
     1172          LEAVE.
     1173      END.
     1174      IF i-Ret[1] <> 1 THEN DO:
     1175         FOR FIRST buf_Ext-Classif WHERE
     1176                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1177              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1178                                                  STRING(i-Contract-code)
     1179              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1180             NO-LOCK,
     1181             EACH buf_Cont WHERE
     1182                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1183              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1184             NO-LOCK:
     1185             ASSIGN
     1186                i-Ret[1] = 2
     1187                i-Ret[2] = buf_Cont.Host-code
     1188                i-Ret[3] = buf_Cont.Contract-code
     1189                .
     1190             LEAVE.
     1191         END.
     1192      END.
     1193      RETURN.
     1194   END PROCEDURE.
     1195   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   define new global shared variable g#attr-lib  as handle no-undo .
     1197   define variable v-attr-lib-variable as handle no-undo .
     1198   procedure ggoattr-code :
     1199     define input  parameter p-code           as character no-undo .
     1200     define output parameter p-type           as character no-undo .
     1201     define output parameter p-format         as character no-undo .
     1202     define output parameter p-label          as character no-undo .
     1203     define output parameter p-user-can-edit  as logical   no-undo .
     1204     define output parameter p-output-display as logical   no-undo .
     1205     define output parameter p-other          as character no-undo .
     1206     do
     1207     on error undo, return error
     1208     :
     1209           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-code in g#attr-lib
     1210         (input  p-code
     1211         ,output p-type
     1212         ,output p-format
     1213         ,output p-label
     1214         ,output p-user-can-edit
     1215         ,output p-output-display
     1216         ,output p-other
     1217         ) no-error .
     1218       if error-status :error
     1219       then do:
     1220         undo, return error return-value .
     1221       end.
     1222     end.
     1223   end procedure.
     1224   procedure ggoattr-tooltip :
     1225     define input  parameter p-code    as character no-undo .
     1226     define output parameter p-tooltip as character no-undo .
     1227     define output parameter p-label   as character no-undo .
     1228     do
     1229     on error undo, return error
     1230     :
     1231           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-tooltip in g#attr-lib
     1232         (input  p-code
     1233         ,output p-tooltip
     1234         ,output p-label
