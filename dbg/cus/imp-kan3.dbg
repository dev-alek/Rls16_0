     8497   define variable v-sec as integer   no-undo .
     8498   PROCEDURE obji-add :
     8499   define input  parameter p-db-num       as integer   no-undo .
     8500   define input  parameter p-id           as integer   no-undo .
     8501   define input  parameter p-dgo-db-num   as integer   no-undo .
     8502   define input  parameter p-stts         as integer   no-undo .
     8503   define input  parameter p-db-num-usr   as integer   no-undo .
     8504   define input  parameter p-userid       as character no-undo .
     8505   define output parameter p-recid as recid no-undo .
     8506     do
     8507     on error undo, return error return-value
     8508     :
     8509   find first ub.grp-obj-price exclusive-lock where
     8510           ub.grp-obj-price.gop-db-num   = p-db-num  and
     8511           ub.grp-obj-price.gop-id       = p-id
     8512           no-error .
     8513     if error-status :error then do:
     8514         message
     8515           vss-workfile vss-revision vss-description skip
     8516           error-status :get-message(1) skip
     8517           return-value skip
     8518           ""
     8519           view-as alert-box error
     8520         .
     8521         return error .
     8522     end.
     8523   find first ub.db-grp-obj-price exclusive-lock where
     8524           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
     8525           ub.db-grp-obj-price.gop-id       = p-id      and
     8526           ub.db-grp-obj-price.dgo-db-num   = p-dgo-db-num
     8527           no-error .
     8528         if not available ub.db-grp-obj-price then do:
     8529             create ub.db-grp-obj-price.
     8530               assign
     8531                   ub.db-grp-obj-price.gop-db-num = p-db-num
     8532                   ub.db-grp-obj-price.gop-id     = p-id
     8533                   ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
     8534               .
     8535         end.
     8536         assign
     8537           ub.db-grp-obj-price.num-chg    = p-db-num-usr
     8538           ub.db-grp-obj-price.stts          = p-stts
     8539           ub.db-grp-obj-price.sys-date      = today
     8540           ub.db-grp-obj-price.sys-time      = time
     8541           ub.db-grp-obj-price.sys-time-chr  = string ( ub.db-grp-obj-price.sys-time,"hh:mm" )
     8542           ub.db-grp-obj-price.who           = p-userid
     8543           p-recid = recid ( ub.db-grp-obj-price )
     8544         .
     8545         ub.grp-obj-price.sys-time = time .
     8546         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
     8547     end.
     8548   end procedure.
     8549   PROCEDURE obji-del :
     8550   define input  parameter p-db-num       as integer   no-undo .
     8551   define input  parameter p-id           as integer   no-undo .
     8552   define input  parameter p-dgo-db-num   as integer   no-undo .
     8553   define input  parameter p-db-num-usr   as integer   no-undo .
     8554   define input  parameter p-userid       as character no-undo .
     8555     do
     8556     on error undo, return error return-value
     8557     :
     8558   find first ub.grp-obj-price exclusive-lock where
     8559           ub.grp-obj-price.gop-db-num   = p-db-num  and
     8560           ub.grp-obj-price.gop-id       = p-id
     8561           .
     8562   find first ub.db-grp-obj-price exclusive-lock where
     8563           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
     8564           ub.db-grp-obj-price.gop-id       = p-id      and
     8565           ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
     8566           no-error .
     8567    if not available ub.db-grp-obj-price then  return error .
     8568         assign
     8569           ub.db-grp-obj-price.num-chg    = p-db-num-usr
     8570           ub.db-grp-obj-price.stts          = 1
     8571           ub.db-grp-obj-price.sys-date      = today
     8572           ub.db-grp-obj-price.sys-time      = time
     8573           ub.db-grp-obj-price.sys-time-chr  = string(ub.db-grp-obj-price.sys-time,"hh:mm")
     8574           ub.db-grp-obj-price.who           = p-userid
     8575         .
     8576         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
     8577         ub.grp-obj-price.sys-time = time .
     8578     end.
     8579   end procedure.
     8580   PROCEDURE objf-add :
     8581   define input  parameter p-db-num       as integer   no-undo .
     8582   define input  parameter p-id           as integer   no-undo .
     8583   define input  parameter p-host-code    as integer   no-undo .
     8584   define input  parameter p-stts         as integer   no-undo .
     8585   define input  parameter p-db-num-usr   as integer   no-undo .
     8586   define input  parameter p-userid       as character no-undo .
     8587   define output parameter p-recid as recid no-undo .
     8588     do
     8589     on error undo, return error return-value
     8590     :
     8591   find first ub.sysconf no-lock where recid(ub.sysconf) = p-host-code .
     8592   if available ub.sysconf then do:
     8593      p-host-code = ub.sysconf.host-code .
     8594   end.
     8595   find first ub.grp-obj-price exclusive-lock where
     8596           ub.grp-obj-price.gop-db-num   = p-db-num  and
     8597           ub.grp-obj-price.gop-id       = p-id
     8598           .
     8599   find first ub.host-grp-obj-price exclusive-lock where
     8600           ub.host-grp-obj-price.gop-db-num   = p-db-num  and
     8601           ub.host-grp-obj-price.gop-id       = p-id      and
     8602           ub.host-grp-obj-price.host-code    = p-host-code
     8603           no-error .
     8604         if not available ub.host-grp-obj-price then do:
     8605             create ub.host-grp-obj-price.
     8606               assign
     8607                   ub.host-grp-obj-price.gop-db-num   = p-db-num
     8608                   ub.host-grp-obj-price.gop-id       = p-id
     8609                   ub.host-grp-obj-price.host-code    = p-host-code
     8610               .
     8611         end.
     8612         assign
     8613           ub.host-grp-obj-price.db-num-chg    = p-db-num-usr
     8614           ub.host-grp-obj-price.stts          = p-stts
     8615           ub.host-grp-obj-price.sys-date      = today
     8616           ub.host-grp-obj-price.sys-time      = time
     8617           ub.host-grp-obj-price.sys-time-chr  = string ( ub.host-grp-obj-price.sys-time,"hh:mm" )
     8618           ub.host-grp-obj-price.who           = p-userid
     8619           p-recid = recid ( ub.host-grp-obj-price )
     8620         .
     8621         ub.grp-obj-price.sys-time = time .
     8622         run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
     8623     end.
     8624   end procedure.
     8625   PROCEDURE objf-del :
     8626   define input  parameter p-db-num       as integer   no-undo .
     8627   define input  parameter p-id           as integer   no-undo .
     8628   define input  parameter p-host-code   as integer   no-undo .
     8629   define input  parameter p-db-num-usr   as integer   no-undo .
     8630   define input  parameter p-userid       as character no-undo .
     8631     do
     8632     on error undo, return error return-value
     8633     :
     8634   find first ub.grp-obj-price exclusive-lock where
     8635           ub.grp-obj-price.gop-db-num   = p-db-num  and
     8636           ub.grp-obj-price.gop-id       = p-id
     8637           .
     8638   find first ub.host-grp-obj-price exclusive-lock where
     8639           ub.host-grp-obj-price.gop-db-num   = p-db-num  and
     8640           ub.host-grp-obj-price.gop-id       = p-id      and
     8641           ub.host-grp-obj-price.host-code    = p-host-code
     8642           no-error .
     8643    if not available ub.host-grp-obj-price then  return error .
     8644         assign
     8645           ub.host-grp-obj-price.db-num-chg    = p-db-num-usr
     8646           ub.host-grp-obj-price.stts          = 1
     8647           ub.host-grp-obj-price.sys-date      = today
     8648           ub.host-grp-obj-price.sys-time      = time
     8649           ub.host-grp-obj-price.sys-time-chr  = string(ub.host-grp-obj-price.sys-time,"hh:mm")
     8650           ub.host-grp-obj-price.who           = p-userid
     8651         .
     8652          ub.grp-obj-price.sys-time = time .
     8653          run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
     8654     end.
     8655   end procedure.
     8656   PROCEDURE objo-add :
     8657   define input  parameter p-db-num       as integer   no-undo .
     8658   define input  parameter p-id           as integer   no-undo .
     8659   define input  parameter p-obj-type     as character no-undo .
     8660   define input  parameter p-obj-code     as integer   no-undo .
     8661   define input  parameter p-stts         as integer   no-undo .
