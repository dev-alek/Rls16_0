     3696   define input  parameter  v-copy-type        as character no-undo .
     3697   define input  parameter  v-copy-code        as integer   no-undo .
     3698   define output parameter  p-new-calc-method  as character no-undo .
     3699   define output parameter  p-price-calc-base  as decimal   no-undo .
     3700   define output parameter  p-price-calc-doc   as decimal   no-undo .
     3701   define output parameter  p-price-calc-rubl  as decimal   no-undo .
     3702   define output parameter  p-price-prev-base  as decimal   no-undo .
     3703   define output parameter  p-price-prev-doc   as decimal   no-undo .
     3704   define output parameter  p-price-prev-rubl  as decimal   no-undo .
     3705   define output parameter  p-price-sale-base  as decimal   no-undo .
     3706   define output parameter  p-price-sale-doc   as decimal   no-undo .
     3707   define output parameter  p-price-sale-rubl  as decimal   no-undo .
     3708   define output parameter  p-road-tax-base    as decimal   no-undo .
     3709   define output parameter  p-road-tax-doc     as decimal   no-undo .
     3710   define output parameter  p-road-tax-rubl    as decimal   no-undo .
     3711   define output parameter  p-excise-base      as decimal   no-undo .
     3712   define output parameter  p-excise-doc       as decimal   no-undo .
     3713   define output parameter  p-excise-rubl      as decimal   no-undo .
     3714   define output parameter  p-vat-pc           as decimal   no-undo .
     3715   define output parameter  p-slt-pc           as decimal   no-undo .
     3716   define output parameter  p-prev-doc-code    as character no-undo .
     3717   define output parameter  p-d-pcnt           as decimal   no-undo .
     3718   define variable cost-base    as decimal   no-undo .
     3719   define variable cost-rubl    as decimal   no-undo .
     3720   define variable cur-rt-base  as decimal   no-undo .
     3721   define variable cur-rt-rubl  as decimal   no-undo .
     3722   define variable local_vat-pc as decimal   no-undo .
     3723   define variable local_slt-pc as decimal   no-undo .
     3724   define variable new_vat-pc   as character no-undo  init "".
     3725   define variable new_slt-pc   as character no-undo  init "".
     3726   define variable new_round    as character no-undo  init "".
     3727   define variable loc_round    as character no-undo  init "".
     3728   define variable v-hostcode   as integer   no-undo .
     3729   define variable v-plt-id       as integer   no-undo .
     3730   define variable v-plt-db-num   as integer   no-undo .
     3731   define variable v-pdf-id       as integer   no-undo .
     3732   define variable v-pdf-db-num   as integer   no-undo .
     3733   define variable v-plt-id2      as integer   no-undo .
     3734   define variable v-plt-db-num2  as integer   no-undo .
     3735   define variable v1-recid       as recid no-undo .
     3736   define variable v1-cur-rt      as decimal   no-undo .
     3737   define variable v1-cur-ex      as decimal   no-undo .
     3738   define variable v1 as integer   no-undo .
     3739   define variable v2 as integer   no-undo .
     3740   define variable v3 as integer   no-undo .
     3741   define variable v4 as integer   no-undo .
     3742   define variable vd as decimal   no-undo .
     3743   define variable v-descript as character no-undo .
     3744   define buffer prev-list                     for ub.price-list  .
     3745   define buffer buf_price-list-type           for ub.price-list-type  .
     3746   define buffer buf_buf_price-doc-forming-gds for ub.price-doc-forming-gds  .
     3747   define buffer b_price-doc-forming-gds       for ub.price-doc-forming-gds  .
     3748   define buffer b_price-doc-forming           for ub.price-doc-forming  .
