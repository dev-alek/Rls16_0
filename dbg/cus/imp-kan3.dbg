     8669           ub.grp-obj-price.gop-db-num   = p-db-num  and
     8670           ub.grp-obj-price.gop-id       = p-id
     8671           .
     8672   find first ub.obj-grp-obj-price exclusive-lock where
     8673           ub.obj-grp-obj-price.gop-db-num   = p-db-num  and
     8674           ub.obj-grp-obj-price.gop-id       = p-id      and
     8675           ub.obj-grp-obj-price.obj-type    = p-obj-type and
