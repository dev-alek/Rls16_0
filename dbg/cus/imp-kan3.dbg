     4256              b_price-doc-forming-gds.plt-db-num = b_price-doc-forming.plt-db-num and
     4257              b_price-doc-forming-gds.plt-id     = b_price-doc-forming.plt-id and
     4258              b_price-doc-forming-gds.pdf-id     = b_price-doc-forming.pdf-id and
     4259              b_price-doc-forming-gds.pdf-db     = b_price-doc-forming.pdf-db
     4260              no-error.
     4261         if available b_price-doc-forming-gds then
     4262           assign
     4263             p-new-calc-method = 'ДокФормЦены':U + " " + v-doc-code
     4264             cur-rt-base = b_price-doc-forming-gds.road-tax-base
     4265             cur-rt-rubl = b_price-doc-forming-gds.road-tax-rubl
     4266             cost-rubl   = b_price-doc-forming-gds.price-sale-rubl
     4267             cost-base   = b_price-doc-forming-gds.price-sale-base
     4268             .
     4269         else
