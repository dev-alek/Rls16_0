     7903   define variable v-last-obj-type like ub.gds-obj.obj-type no-undo .
     7904   define variable v-last-obj-code like ub.gds-obj.obj-code no-undo .
     7905   def var v-rec as recid no-undo.
     7906   def var t-ret as logical no-undo .
     7907   def var v-total-avrg-base as decimal no-undo .
