     7988       end.
     7989     end.
     7990     assign
     7991      price-cli-with-tax-loc = buf_parts.price-cli
     7992      cli-base-rate          = buf_parts.cli-base-rate.
     7993     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     7994              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     7995     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     7996             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     7997             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     7998             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     7999             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     8000             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     8001             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8002       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8003     assign
     8004       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     8005     assign
     8006       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     8007       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     8008       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     8009       transport-cli-loc  = 0
     8010       other-cli-loc      = 0
     8011     .
     8012   ASSIGN
     8013             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     8014       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     8015   .
     8016           assign
     8017             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     8018             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     8019            .
     8020         end.
     8021             if v-total-avrg-qnty > 0 then  DO :
     8022                 assign
     8023                   p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     8024                   p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     8025                   .
     8026             end.
     8027               if v-total-avrg-qnty <= 0 then do :
     8028                   run last-incom-S in this-procedure
     8029                   ( input   p-artic ,
     8030                     input   p-prod-type,
     8031                     input   p-prod-code ,
     8032                     output  v-last-in-code,
     8033                     output  v-last-obj-type,
     8034                     output  v-last-obj-code ).
     8035                         find buf_trn-doc where buf_trn-doc.doc-code  = v-last-in-code no-lock no-error .
     8036                         find buf_doc-line where     buf_doc-line.doc-code  = v-last-in-code
     8037                                         and buf_doc-line.artic     = p-artic
     8038                                         and buf_doc-line.prod-type = p-prod-type
     8039                                         and buf_doc-line.prod-code = p-prod-code no-lock no-error.
     8040                         if avail buf_doc-line then do :
     8041   assign
     8042     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     8043     price-base-with-tax-loc = buf_doc-line.price-base
     8044   .
     8045   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8046   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8047     (output varinvprb
     8048     )  .
     8049      find first in-vatp_doc-attr no-lock
     8050       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     8051         and in-vatp_doc-attr.attr-code = 'envd':U
     8052       no-error .
     8053       if available in-vatp_doc-attr
     8054          then do:
     8055          assign
     8056            in-vatp-have-vat-slt = no.
     8057      end.
     8058      else do:
     8059        assign
     8060          in-vatp-have-vat-slt = yes.
     8061      end.
     8062      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     8063                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     8064                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     8065      if (not buf_trn-doc.internal and
     8066              buf_trn-doc.doc-type = 'при':U) or
     8067         in-vatp-goods.gds-type = 'у':U then do:
     8068         if varinvprb = "base":u then do:
     8069           assign
     8070             road-tax-base-loc = buf_doc-line.road-tax
     8071             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     8072         end.
     8073         else do:
     8074           ASSIGN
     8075             road-tax-rubl-loc = buf_doc-line.road-tax
     8076             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     8077         end.
     8078         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     8079         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     8080         assign
     8081           road-tax-cli-loc = ?.
     8082         ASSIGN
     8083           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     8084           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     8085           transport-cli-loc  = 0
     8086           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     8087           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     8088           other-cli-loc      = 0
     8089           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
