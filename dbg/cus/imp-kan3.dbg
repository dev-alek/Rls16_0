     1388   procedure grp-obj-notcorr-value :
     1389   do
     1390   on error undo, return error
     1391   :
     1392   define input parameter p-node-code             as integer      no-undo.
     1393   define input parameter p-obj-type              as character    no-undo.
     1394   define input parameter p-obj-code              as integer      no-undo.
     1395   define output parameter p-notcorr              as character    no-undo init ?.
     1396   define output parameter p-range-notcorr     as integer      no-undo.
     1397   define output parameter p-exists-notcorr    as logical      no-undo.
     1398   define variable v-host-code as integer      no-undo.
     1399   DEFINE VARIABLE v-found as logical no-undo .
     1400   DEFINE VARIABLE v-exists as logical no-undo .
     1401   DEFINE VARIABLE v-range as integer no-undo .
     1402   DEFINE VARIABLE jj as integer no-undo .
     1403   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1404   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1405   define buffer buf_gds-grp for ub.gds-grp.
     1406   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1407   find first buf_gds-grp no-lock where
     1408              buf_gds-grp.node-code = p-node-code no-error .
     1409   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1410     message
     1411       vss-workfile vss-revision vss-description
     1412       skip "Не удалось найти группу товаров с кодом" p-node-code
     1413       view-as alert-box error .
     1414     undo, return error .
     1415   end.
     1416   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1418     (input  p-obj-type
     1419     ,input  p-obj-code
     1420     ,output v-host-code
     1421     ) no-error .
     1422   if error-status :error
     1423   then do:
     1424       message
     1425         vss-workfile vss-revision vss-description
     1426         skip "Не удалось найти фирму объекта"
     1427         skip p-obj-type p-obj-code
     1428         skip return-value
     1429         skip trim(error-status :get-message(1))
     1430       view-as alert-box error.
     1431       undo, return error .
     1432   end.
     1433   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1434   do while v-found = no and jj < 2:
     1435     if v-range <> 3 then do:
     1436       find first buf_gds-grp-obj no-lock
     1437           where buf_gds-grp-obj.node-code = p-node-code
     1438             and buf_gds-grp-obj.host-code = v-host-code
     1439             and buf_gds-grp-obj.obj-type  = p-obj-type
     1440             and buf_gds-grp-obj.obj-code  = p-obj-code
     1441       no-error .
     1442     end.
     1443     if v-range = 3 or not available buf_gds-grp-obj
     1444     then do:
     1445        if v-range <> 2 then do:
     1446           find first buf_gds-grp-obj no-lock
     1447               where buf_gds-grp-obj.node-code = p-node-code
     1448                 and buf_gds-grp-obj.host-code = v-host-code
     1449                 and buf_gds-grp-obj.obj-type  = ""
     1450                 and buf_gds-grp-obj.obj-code  = 0
     1451           no-error .
     1452         end.
     1453         if v-range = 2 or not available buf_gds-grp-obj
     1454         then do:
     1455             if v-range <> 1 then do:
     1456               find first buf_gds-grp-obj no-lock
     1457                   where buf_gds-grp-obj.node-code = p-node-code
     1458                   and buf_gds-grp-obj.host-code = 0
     1459                   and buf_gds-grp-obj.obj-type  = ""
     1460                   and buf_gds-grp-obj.obj-code  = 0
     1461               no-error .
     1462             end.
     1463             if v-range = 1 or not available buf_gds-grp-obj
     1464             then do:
     1465                 assign
     1466                     v-exists = no
     1467                 .
     1468             end.
     1469             else do:
     1470                 assign
     1471                     v-exists = yes
     1472                     v-range = 1
     1473                 .
     1474             end.
     1475         end.
     1476         else do:
     1477             assign
     1478                 v-exists = yes
     1479                 v-range  = 2
     1480             .
     1481         end.
     1482     end.
     1483     else do:
     1484         assign
     1485             v-exists = yes
     1486             v-range  = 3
     1487         .
     1488     end.
     1489     if available buf_gds-grp-obj
     1490     then do:
     1491       find first buf_gds-grp-obj-attr no-lock
     1492         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1493           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1494           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1495           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1496           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1497         no-error .
     1498       if available buf_gds-grp-obj-attr then do:
     1499         assign
     1500           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1501         .
     1502       end.
     1503       else do:
     1504         assign
     1505           v-notcorr-value = ?
     1506         .
     1507       end.
     1508       assign
     1509       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1510                           then yes
     1511                           else p-exists-notcorr)
     1512       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1513                         then v-range
     1514                         else p-range-notcorr
     1515       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1516                         then v-notcorr-value
     1517                         else p-notcorr
     1518       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1519       jj = jj + 1
     1520       .
     1521     end.
     1522     else do:
     1523       assign
     1524       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1525       jj = jj + 1
     1526       .
     1527     end.
     1528   end.
     1529   end.
     1530   end procedure.
     1531   define variable vss-include-info23 as character format "X(65)" no-undo
     1532   initial "@(#)$Workfile$ $Revision$".
     1533   procedure grplib-get-full-name :
     1534      define input parameter p-node-code  as integer      no-undo.
     1535      define output parameter p-full-name as character    no-undo.
     1536      do
     1537   on error undo, return error
     1538   :
     1539       define variable v-upper-code    as integer           no-undo.
     1540       define buffer buf_gds-grp       for ub.gds-grp.
     1541       define buffer buf_upper_gds-grp for ub.gds-grp.
     1542       find first buf_gds-grp no-lock
     1543            where buf_gds-grp.node-code = p-node-code
     1544       no-error.
     1545       if not available buf_gds-grp
     1546       then do:
     1547           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1548       end.
     1549       assign
     1550           p-full-name  = ""
     1551           v-upper-code = 1
     1552       .
     1553       do while buf_gds-grp.upper-code <> 0
     1554       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1555       :
     1556           assign
     1557               p-full-name  = buf_gds-grp.node-name
     1558                            + (if p-full-name <> "" then chr(47) else "")
     1559                            + p-full-name
     1560               v-upper-code = buf_gds-grp.upper-code
     1561           .
     1562           find first buf_gds-grp no-lock
     1563                where buf_gds-grp.node-code = v-upper-code
     1564           no-error.
     1565           if not available buf_gds-grp
     1566           then do:
     1567               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1568                                   + string( v-upper-code )
     1569                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1570           end.
     1571       end.
     1572       assign
     1573       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1574       .
     1575   end.
     1576   end .
     1577   procedure grplib-get-node-from-full-name :
     1578   define input parameter p-full-name as character no-undo .
     1579   define output parameter p-node-code as integer no-undo .
     1580   define variable v-ii as integer no-undo .
     1581   define variable v-upper-code as integer no-undo .
     1582   define variable v-root-code as integer no-undo .
     1583   define variable v-entry as character no-undo .
     1584   define buffer buf_gds-grp       for ub.gds-grp.
     1585   do
     1586   on error undo, return error
     1587   :
     1588     find first buf_gds-grp no-lock
     1589         where buf_gds-grp.upper-code = 0
     1590     no-error .
     1591     if not available buf_gds-grp
     1592     then do:
     1593         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1594     end.
     1595     else do:
     1596       assign
     1597       v-root-code = buf_gds-grp.node-code
     1598       .
     1599     end.
     1600     v-upper-code = v-root-code.
     1601     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1602       assign
     1603       v-entry = entry(v-ii, p-full-name, chr(47)).
     1604       if v-entry = '' then leave.
     1605       find first buf_gds-grp no-lock where
     1606                 buf_gds-grp.node-name = v-entry
     1607             and buf_gds-grp.upper-code = v-upper-code
     1608             no-error.
     1609       if not available buf_gds-grp then do:
     1610         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1611       end.
     1612       else do:
     1613         p-node-code = buf_gds-grp.node-code.
     1614         v-upper-code = buf_gds-grp.node-code.
     1615       end.
     1616     end.
     1617   end.
     1618   end .
     1619   procedure  chec-par :
     1620   define output parameter l-par as logical no-undo .
     1621   define input parameter l-host like ub.clients.obj-code no-undo .
     1622   define input parameter l-type like ub.clients.obj-type no-undo .
     1623   define input parameter l-code like ub.clients.obj-code no-undo .
     1624   define variable par-type          as character no-undo.
     1625   define variable v-value-character as character no-undo .
     1626   define variable v-value-date      as date      no-undo .
     1627   define variable v-value-decimal   as decimal   no-undo .
     1628   define variable v-value-integer   as integer   no-undo .
     1629   define variable v-value-logical   as logical   no-undo .
     1630   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1631     (input  'alcohol'
     1632     ,input  l-host
     1633     ,input  l-type
     1634     ,input  l-code
     1635     ,input  ''
     1636     ,input  ''
     1637     ,input  ''
     1638     ,input  no
     1639     ,output par-alcohol
     1640     ,output par-type
     1641     ) no-error .
     1642    .
     1643   empty temp-table thbjattr_thbj-attr.
     1644   run adm/shattri.p (
     1645      input "get":U
     1646     ,input l-type
     1647     ,input l-code
     1648     ,input 'overval':U
     1649     ,input  ""
     1650     ,output v-value-character
     1651     ,output v-value-date
     1652     ,output v-value-decimal
     1653     ,output v-value-integer
     1654     ,output v-value-logical
     1655     ,output par-type
     1656     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1657     ) no-error .
     1658   for each thbjattr_thbj-attr :
     1659       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1660       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1661       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1662       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     1663       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     1664       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     1665       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     1666       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     1667       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     1668       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     1669       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     1670       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1671       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1672       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     1673       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1674       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     1675       if v-cntxt-db-num = 0 then do:
     1676         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1677         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1678       end.
     1679       else do:
     1680         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1681         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1682       end.
     1683   end.
     1684   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     1686     (input  ?
     1687     ,input  l-type
     1688     ,input  l-code
     1689     ,output par-gen-mrgn-ie
     1690     ,output par-gen-mrgn-iv
     1691     ,output par-gen-mrgn-im
     1692     ) no-error .
     1693      IF error-status :error THEN message
     1694        vss-workfile vss-revision vss-description skip
     1695        error-status :get-message(1) skip
     1696        return-value skip
     1697        "gbl/gtplmrgn.i"
     1698        view-as alert-box error
     1699      .
     1700   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1701   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     1702     (input  ?
     1703     ,input  l-type
     1704     ,input  l-code
     1705     ,output par-pr-nakl-ie
     1706     ,output par-pr-nakl-iv
     1707     ,output par-pr-nakl-im
     1708     ) no-error .
     1709      define variable ii as integer   no-undo .
     1710      define variable nn as integer   no-undo .
     1711      define variable v-fullname as character no-undo .
     1712      nn = num-entries ( par-pr-nogds ).
     1713      par-pr-nogds-long = "".
     1714      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     1715         repeat ii = 1 to nn :
     1716           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     1717           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     1718         end.
     1719         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     1720      end.
     1721   l-par = true .
     1722   end procedure.
     1723   PROCEDURE cre-pr-list:
     1724   define input  parameter bc      like ub.price-list.b-code no-undo.
     1725   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     1726   define output parameter new-rec as recid             no-undo.
     1727   define buffer buf-price-list for ub.price-list.
     1728   define buffer buf-price-doc  for ub.price-doc.
     1729   define buffer buf-bar-code   for ub.bar-code.
     1730   define buffer buf-goods      for ub.goods.
     1731   define buffer buf-gds-prt    for ub.gds-prt.
     1732   define buffer root-gds-prt   for ub.gds-prt.
     1733   define variable cur-pr like ub.price-list.price-sale no-undo.
     1734   define variable cur-rt like ub.price-list.road-tax   no-undo.
     1735   define variable cur-ex like ub.price-list.excise     no-undo.
     1736   define variable cur-dn like ub.price-list.doc-num    no-undo.
     1737   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1738   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1739   define variable cur-rt-base as decimal no-undo .
     1740   define variable cur-rt-rubl as decimal no-undo .
     1741   define variable p-hostcode as int no-undo .
     1742   define variable v-line-num as integer no-undo .
     1743   define variable v-skip-del-gds as logical no-undo initial no .
     1744   cre-pr:
     1745   do on error undo cre-pr, return error:
     1746     find  buf-bar-code no-lock where
     1747           buf-bar-code.b-code = bc.
     1748     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     1749     if error-status :error then do:
     1750       message
     1751         return-value skip
     1752         "Ошибка !"
     1753         view-as alert-box error
     1754       .
     1755       undo cre-pr, return.
     1756     end.
     1757     find  buf-goods no-lock where
     1758           buf-goods.gds-code = buf-bar-code.gds-code.
     1759     find first root-gds-prt no-lock where
     1760               root-gds-prt.upper-code = buf-goods.prt-root.
     1761     if root-gds-prt.node-name <> '_Пустая шкала':U and
     1762       buf-bar-code.in-code <> "" then do:
     1763       message
     1764         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1765         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1766         view-as alert-box error.
     1767       undo cre-pr, return.
     1768     end.
     1769     find  buf-gds-prt no-lock where
     1770           buf-gds-prt.node-code = buf-bar-code.node-code.
     1771     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     1772       message
     1773         "Не допускается создавать цены на удаленные товары!" skip (2)
     1774         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1775         view-as alert-box error.
     1776       undo cre-pr, return.
     1777     end.
     1778     find  buf-price-doc where
     1779           buf-price-doc.doc-num = new-num.
     1780   define variable v-ret as logical no-undo .
     1781      run ver-modificator-price-is-null (
     1782             input    buf-goods.artic        ,
     1783             input    buf-goods.prod-type    ,
     1784             input    buf-goods.prod-code    ,
     1785             input    buf-price-doc.obj-type   ,
     1786             input    buf-price-doc.obj-code   ,
     1787             output   v-ret ).
     1788         if v-ret = false then dO:
     1789             message
     1790               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     1791               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1792               view-as alert-box error.
     1793             undo cre-pr, return.
     1794           end.
     1795   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1796   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1797     (input  buf-price-doc.obj-type
     1798     ,input  buf-price-doc.obj-code
     1799     ,output p-hostcode
     1800     ) no-error .
     1801   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1802   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1803     (input  buf-goods.gds-code
     1804     ,input  '1':U
     1805     ,input  ?
     1806     ,input  p-hostcode
     1807     ,input  buf-price-doc.obj-type
     1808     ,input  buf-price-doc.obj-code
     1809     ,output local_vat-pc
     1810     ) no-error .
     1811   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1812   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1813     (input  buf-goods.gds-code
     1814     ,input  '2':U
     1815     ,input  ?
     1816     ,input  p-hostcode
     1817     ,input  buf-price-doc.obj-type
     1818     ,input  buf-price-doc.obj-code
     1819     ,output local_slt-pc
     1820     ) no-error .
     1821   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1822   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1823     (input  buf-price-doc.obj-type
     1824     ,input  buf-price-doc.obj-code
     1825     ,input  bc
     1826     ,input  0
     1827     ,input  0
     1828     ,output cur-dn
     1829     ,output cur-pr
     1830     ,output cur-rt
     1831     ,output cur-ex
     1832     ) no-error .
     1833     find first buf-price-list where
     1834               buf-price-list.b-code  = buf-bar-code.b-code and
     1835               buf-price-list.doc-num = new-num  and
     1836               buf-price-list.price-type = ""    no-error .
     1837     if not available buf-price-list then do:
     1838       run calc-price-line-num (input  new-num , output v-line-num) .
     1839       create buf-price-list.
     1840       assign
     1841         buf-price-list.line-num  = v-line-num
     1842         buf-price-list.b-code    = buf-bar-code.b-code
     1843         buf-price-list.doc-num   = buf-price-doc.doc-num
     1844         buf-price-list.prod-type = buf-goods.prod-type
     1845         buf-price-list.prod-code = buf-goods.prod-code
     1846         buf-price-list.artic     = buf-goods.artic
     1847         buf-price-list.obj-type  = buf-price-doc.obj-type
     1848         buf-price-list.obj-code  = buf-price-doc.obj-code
     1849         buf-price-list.vat-pc    = local_vat-pc
     1850         buf-price-list.slt-pc    = local_slt-pc
     1851         buf-price-list.price-prev = cur-pr
     1852         .
     1853       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     1854           buf-bar-code.in-code   = "" and
     1855           buf-bar-code.part-code = "" and
     1856           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     1857         buf-price-list.main-price = yes.
     1858         if cur-pr <> ? then do:
     1859           run exp-prt (input buf-goods.gds-code,
     1860                       input cur-dn,
     1861                       input new-num,
     1862                       output new-rec) no-error.
     1863           if error-status :error then do:
     1864             message
     1865               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     1866               view-as alert-box error.
     1867             undo cre-pr, return error.
     1868           end.
     1869         end.
     1870       end.
     1871       else do:
     1872         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1873           buf-price-list.d-pcnt = ?.
     1874         end.
     1875         buf-price-list.main-price = no.
     1876       end.
     1877     end.
     1878   end.
     1879   new-rec = recid (buf-price-list).
     1880   END PROCEDURE.
     1881   procedure calc-price-line-num :
     1882    do
     1883    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1884    :
     1885   define input parameter p-doc-num as character no-undo .
     1886   define output parameter p-num  as integer no-undo .
     1887   define variable v-fact as integer no-undo .
     1888   define buffer buf_1_price-list for ub.price-list .
     1889   p-num = 1 .
     1890   find last  buf_1_price-list no-lock where
     1891              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     1892              if available buf_1_price-list then
     1893                   assign
     1894                     v-fact = buf_1_price-list.line-num
     1895                   .
     1896   v-fact = v-fact + 1.
     1897   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     1898    end.
     1899   end procedure.
     1900   PROCEDURE del-pr-list:
     1901   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1902   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1903   define input parameter round-method as character         no-undo.
     1904   define input parameter round-base   as decimal      no-undo.
     1905   define buffer buf-price-list for ub.price-list.
     1906   define buffer buf-bar-code   for ub.bar-code.
     1907   define buffer buf-goods      for ub.goods.
     1908   define variable l-ov-on as logical no-undo .
     1909   del-pr:
     1910   do on error undo del-pr, return error:
     1911     find first  buf-price-list no-lock where
     1912                 buf-price-list.doc-num    = d-num and
     1913                 buf-price-list.b-code     = bc and
     1914                 buf-price-list.price-type = "" no-error.
     1915     if not available buf-price-list then
     1916       undo del-pr, return error.
     1917     find  buf-goods no-lock where
     1918           buf-goods.prod-type = buf-price-list.prod-type and
     1919           buf-goods.prod-code = buf-price-list.prod-code and
     1920           buf-goods.artic     = buf-price-list.artic.
     1921     if buf-price-list.main-price then do:
     1922       for each  buf-price-list exclusive-lock where
     1923                 buf-price-list.doc-num   = d-num and
     1924                 buf-price-list.artic     = buf-goods.artic and
     1925                 buf-price-list.prod-type = buf-goods.prod-type and
     1926                 buf-price-list.prod-code = buf-goods.prod-code,
     1927           first buf-bar-code no-lock where
     1928                 buf-bar-code.b-code = buf-price-list.b-code
     1929       on error undo del-pr, return error:
     1930   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1932     (input  ub.buf-price-list.obj-type
     1933     ,input  ub.buf-price-list.obj-code
     1934     ,input  ub.buf-price-list.artic
     1935     ,input  ub.buf-price-list.prod-type
     1936     ,input  ub.buf-price-list.prod-code
     1937     ,input  'ov-on=request:exclusive'
     1938     ,output l-ov-on
     1939     ) no-error .
     1940         if error-status:error then do:
     1941           message
     1942             vss-workfile vss-revision vss-description skip
     1943             "Ошибка получения признака товара на объекте" skip
     1944             error-status :get-message(1) skip
     1945             return-value skip
     1946             view-as alert-box error .
     1947         end.
     1948         if l-ov-on then do:
     1949   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1950   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1951     (input  ub.buf-price-list.obj-type
     1952     ,input  ub.buf-price-list.obj-code
     1953     ,input  ub.buf-price-list.artic
     1954     ,input  ub.buf-price-list.prod-type
     1955     ,input  ub.buf-price-list.prod-code
     1956     ,input  'ov-on=false'
     1957     ,output l-ov-on
     1958     ) no-error .
     1959           if error-status :error then do:
     1960           end.
     1961          end.
     1962         delete buf-price-list.
     1963       end.
     1964     end.
     1965     else do:
     1966       find  buf-bar-code no-lock where
     1967             buf-bar-code.b-code = buf-price-list.b-code.
     1968       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1969         message
     1970           "Нельзя удалить неосновную цену." skip
     1971           "Неосновная цена (скидка) не может быть неопределенной." skip
     1972           "Код:" bc skip
     1973           "Переоценка:" d-num
     1974           view-as alert-box error.
     1975         undo del-pr, return error.
     1976       end.
     1977       find current buf-price-list exclusive-lock no-error .
     1978       delete buf-price-list.
     1979       run calc-base-upd (input buf-bar-code.b-code,
     1980                         input d-num,
     1981                         input round-method,
     1982                         input round-base) no-error.
     1983       if error-status :error then
     1984         undo del-pr, return error.
     1985     end.
     1986   end.
     1987   END PROCEDURE.
     1988   PROCEDURE calc-base-upd:
     1989   define input parameter bc    like ub.bar-code.b-code   no-undo.
     1990   define input parameter d-num like ub.price-doc.doc-num no-undo.
     1991   define input parameter round-method as character         no-undo.
     1992   define input parameter round-base   as decimal      no-undo.
     1993   define buffer alt-bar-code   for ub.bar-code.
     1994   define buffer alt-price-list for ub.price-list.
     1995   define buffer buf-bar-code   for ub.bar-code.
     1996   define buffer buf-goods      for ub.goods.
     1997   calc-base:
     1998   do on error undo calc-base, return error:
     1999     find  buf-bar-code no-lock where
     2000           buf-bar-code.b-code = bc.
     2001     find  buf-goods no-lock where
     2002           buf-goods.gds-code = buf-bar-code.gds-code.
     2003     for each  alt-bar-code no-lock where
     2004               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     2005               alt-bar-code.node-code = buf-bar-code.node-code and
     2006               alt-bar-code.part-code = buf-bar-code.part-code and
     2007               alt-bar-code.in-code   = buf-bar-code.in-code and
     2008               alt-bar-code.unit-cli <> buf-goods.unit-base,
     2009         each  alt-price-list where
     2010               alt-price-list.doc-num    = d-num and
     2011               alt-price-list.b-code     = alt-bar-code.b-code and
     2012               alt-price-list.price-type = ""
     2013         on error undo calc-base, return error:
     2014       run calc-pr-alt (input d-num,
     2015                       input alt-bar-code.b-code,
     2016                       input round-method,
     2017                       input round-base) no-error.
     2018       if error-status:error then
     2019         undo calc-base, return error.
     2020     end.
     2021   end.
     2022   END PROCEDURE.
     2023   PROCEDURE calc-pr-alt:
     2024   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2025   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2026   define input parameter r-method as character             no-undo.
     2027   define input parameter r-base   as decimal              no-undo.
     2028   define buffer buf-price-doc  for ub.price-doc.
     2029   define buffer buf-price-list for ub.price-list.
     2030   define buffer buf-bar-code   for ub.bar-code.
     2031   define buffer buf-goods      for ub.goods.
     2032   define buffer old-price-list for ub.price-list.
     2033   define variable pr-rec   as   recid                  no-undo.
     2034   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2035   pr-alt:
     2036   do on error undo pr-alt, return error:
     2037     if r-method = ? or
     2038        r-base = ? then do:
     2039       message
     2040         "Нельзя удалить основную цену." skip
     2041         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2042         "Код:" bc skip
     2043         "Переоценка:" d-num
     2044         view-as alert-box error.
     2045       undo pr-alt, return error.
     2046     end.
     2047     find  buf-price-doc where
     2048           buf-price-doc.doc-num = d-num.
     2049     find  buf-bar-code no-lock where
     2050           buf-bar-code.b-code = bc.
     2051     find  buf-goods no-lock where
     2052           buf-goods.gds-code = buf-bar-code.gds-code.
     2053     find  buf-price-list where
     2054           buf-price-list.doc-num = buf-price-doc.doc-num and
     2055           buf-price-list.b-code  = bc.
     2056     if buf-price-list.d-pcnt = ? then do:
     2057   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2058   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2059     (input  buf-price-doc.obj-type
     2060     ,input  buf-price-doc.obj-code
     2061     ,input  bc
     2062     ,input  0
     2063     ,input  0
     2064     ,output pr-rec
     2065     ,output pr-c-b-r
     2066     )  .
     2067       find old-price-list no-lock where
     2068           recid (old-price-list) = pr-rec no-error.
     2069       if available old-price-list and
     2070         old-price-list.b-code = bc then
     2071         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2072       else
     2073         buf-price-list.d-pcnt = 0.
     2074     end.
     2075      if buf-price-list.d-pcnt = ? then do:
     2076         assign
     2077           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2078           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2079           .
     2080     end.
     2081     else do:
     2082         assign
     2083           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2084                                         buf-bar-code.cli-base-rate *
     2085                                         (1 - buf-price-list.d-pcnt / 100)
     2086           buf-price-list.calc-method =  'Основная':U
     2087           .
     2088   case r-method :
     2089     when '9-окончание':U then do:
     2090       if buf-price-list.price-sale < 29 then do:
     2091         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2092           assign
     2093             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2094           .
     2095         end.
     2096       end.
     2097       else do:
     2098         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2099           assign
     2100             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2101                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2102                   - 1 ) * 10
     2103                 + 9
     2104           .
     2105         end.
     2106         else do:
     2107           assign
     2108             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2109                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2110                   ) * 10
     2111                 + 9
     2112           .
     2113         end.
     2114         assign
     2115           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2116         .
     2117       end.
     2118     end.
     2119     when '9-99окончание':U then do:
     2120       if buf-price-list.price-sale < r-base then do:
     2121         assign
     2122           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2123         .
     2124       end.
     2125       else do:
     2126         assign
     2127           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2128         .
     2129       end.
     2130     end.
     2131     when 'Без-дробных':U then do:
     2132       assign
     2133         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2134       .
     2135     end.
     2136     when 'Произвольно':U then do:
     2137       if r-base <> 0 then do:
     2138         assign
     2139           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2140         .
     2141         if buf-price-list.price-sale = 0 then do:
     2142           assign
     2143             buf-price-list.price-sale = r-base
     2144           .
     2145         end.
     2146       end.
     2147     end.
     2148     when 'Вверх':U then do:
     2149       if r-base <> 0 then do:
     2150         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2151           assign
     2152             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2153           .
     2154         end.
     2155       end.
     2156       if buf-price-list.price-sale = 0 then do:
     2157         assign
     2158           buf-price-list.price-sale = r-base
     2159         .
     2160       end.
     2161     end.
     2162     when 'Коэффициент':U then do:
     2163       if r-base <> 0 then do:
     2164         assign
     2165           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2166         .
     2167       end.
     2168     end.
     2169     when 'Отключено':U then do:
     2170     end.
     2171     otherwise do:
     2172       message
     2173         vss-workfile vss-revision vss-description skip
     2174         "Неизвестный метод округления продажной цены" skip
     2175         "round-method" r-method skip
     2176         "round-base"   r-base   skip
     2177         "price"        buf-price-list.price-sale             skip
     2178         view-as alert-box error .
     2179     end.
     2180   end.
     2181     end.
     2182   end.
     2183   END PROCEDURE.
     2184   PROCEDURE calc-pr-discnt:
     2185   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2186   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2187   define buffer buf-price-doc  for ub.price-doc.
     2188   define buffer buf-price-list for ub.price-list.
     2189   define buffer buf-bar-code   for ub.bar-code.
     2190   define buffer buf-goods      for ub.goods.
     2191   define buffer old-price-list for ub.price-list.
     2192   define variable pr-rec   as   recid                  no-undo.
     2193   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2194   pr-discnt:
     2195   do on error undo pr-discnt, return error:
     2196     find  buf-price-doc where
     2197           buf-price-doc.doc-num = d-num.
     2198     find  buf-bar-code no-lock where
     2199           buf-bar-code.b-code = bc.
     2200     find  buf-goods no-lock where
     2201           buf-goods.gds-code = buf-bar-code.gds-code.
     2202     find  buf-price-list where
     2203           buf-price-list.doc-num = buf-price-doc.doc-num and
     2204           buf-price-list.b-code  = bc.
     2205     buf-price-list.d-pcnt = (1 -
     2206                              buf-price-list.price-sale /
     2207                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2208                              buf-bar-code.cli-base-rate) *
     2209                              100
     2210                              .
     2211   end.
     2212   END PROCEDURE.
     2213   PROCEDURE calc-pr-sub :
     2214   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2215   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2216   define  input  parameter calc-method  as character    no-undo.
     2217   define  input  parameter increase-pc  as decimal      no-undo.
     2218   define  input  parameter round-method as character    no-undo.
     2219   define  input  parameter round-base   as decimal      no-undo.
     2220   define  output parameter calc-rec     as recid        no-undo.
     2221   define  buffer buf-price-list for ub.price-list.
     2222   define  buffer buf-bar-code   for ub.bar-code.
     2223   define  buffer buf-goods      for ub.goods.
     2224   define  buffer buf-gds-prt    for ub.gds-prt.
     2225   define  buffer buf-gds-grp    for ub.gds-grp.
     2226   define  buffer buf-price-doc  for ub.price-doc.
     2227   calc-sub:
     2228   do on error undo calc-sub, return error:
     2229     find  buf-bar-code no-lock where
     2230           buf-bar-code.b-code = bc.
     2231     find  buf-goods no-lock where
     2232           buf-goods.gds-code = buf-bar-code.gds-code.
     2233     find  buf-gds-prt no-lock where
     2234           buf-gds-prt.node-code = buf-bar-code.node-code.
     2235     find  buf-price-list where
     2236           buf-price-list.doc-num    = d-num and
     2237           buf-price-list.b-code     = bc and
     2238           buf-price-list.price-type = "".
     2239     find  buf-price-doc where
     2240           buf-price-doc.doc-num = d-num.
     2241     calc-rec = recid (buf-price-list).
     2242     if buf-price-list.main-price then do:
     2243       for each  buf-price-list where
     2244                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2245                 buf-price-list.main-price = no and
     2246                 buf-price-list.artic      = buf-goods.artic and
     2247                 buf-price-list.prod-type  = buf-goods.prod-type and
     2248                 buf-price-list.prod-code  = buf-goods.prod-code,
     2249           first buf-bar-code no-lock where
     2250                 buf-bar-code.b-code   = buf-price-list.b-code and
     2251                 buf-bar-code.unit-cli = buf-goods.unit-base
     2252           on error undo calc-sub, return error:
     2253         run calc-pr-list (input  buf-bar-code.b-code,
     2254                           input  buf-price-list.doc-num,
     2255                           input  calc-method,
     2256                           input  increase-pc,
     2257                           input  round-method,
     2258                           input  round-base,
     2259                           input ? ,
     2260                           input ? ,
     2261                           input ? ,
     2262                           input ? ,
     2263                           output calc-rec) no-error.
     2264         if error-status :error then
     2265           undo calc-sub, return error.
     2266         calc-rec = recid (buf-price-list).
     2267       end.
     2268       for each  buf-price-list where
     2269                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2270                 buf-price-list.main-price = no and
     2271                 buf-price-list.artic      = buf-goods.artic and
     2272                 buf-price-list.prod-type  = buf-goods.prod-type and
     2273                 buf-price-list.prod-code  = buf-goods.prod-code,
     2274           first buf-bar-code no-lock where
     2275                 buf-bar-code.b-code    = buf-price-list.b-code and
     2276                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2277           on error undo calc-sub, return error:
     2278         run calc-pr-alt (input buf-price-doc.doc-num,
     2279                         input buf-bar-code.b-code,
     2280                         input round-method,
     2281                         input round-base) no-error.
     2282         if error-status :error then
     2283           undo calc-sub, return error.
     2284       end.
     2285     end.
     2286     else do:
     2287       run calc-base-upd (input buf-bar-code.b-code,
     2288                         input buf-price-doc.doc-num,
     2289                         input round-method,
     2290                         input round-base) no-error.
     2291       if error-status :error then
     2292         undo calc-sub, return error.
     2293     end.
     2294   end.
     2295   END PROCEDURE.
     2296   procedure ver-pr-nogds :
     2297   define input  parameter p-gds-code      as integer   no-undo .
     2298   define input  parameter p-par-pr-nogds  as character no-undo .
     2299   define output parameter p-not           as logical   no-undo .
     2300   define output parameter p-str           as character no-undo .
     2301   define buffer buf_goods for ub.goods  .
     2302   define variable nn as integer   no-undo .
     2303   define variable ii as integer   no-undo .
     2304   define variable v-namegrp as character no-undo .
     2305     do
     2306     on error undo, return error return-value
     2307     :
     2308     if p-par-pr-nogds = "1" then do:
     2309        assign
     2310         p-not = true
     2311         p-str = ""
     2312        .
     2313        return .
     2314     end.
     2315     assign
     2316       p-not = false
     2317       p-str = ""
     2318     .
     2319     find first buf_goods no-lock where
     2320                buf_goods.gds-code = p-gds-code no-error .
     2321     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2322     repeat ii = 1 to nn:
     2323        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2324        if buf_goods.grp-name  begins v-namegrp  then do:
     2325           assign
     2326             p-not = true
     2327             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     2328           .
     2329           leave .
     2330        end.
     2331     end.
     2332     end.
     2333   end procedure.
     2334   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2335   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2336   define temp-table tt-level-dis-attr no-undo
     2337         field attr-code   like global-state-attr.attr-code
     2338         field attr-value  like global-state-attr.attr-value
     2339         index pi   attr-value descending
     2340         index pi1 is unique attr-value
     2341               attr-code .
     2342   procedure lvldsc-byattr :
     2343   define input  parameter p-attr-code  as character no-undo .
     2344   define input  parameter p-attr-value as character no-undo .
     2345   define output parameter p-val1       as decimal   no-undo .
     2346   define output parameter p-val2       as decimal   no-undo .
     2347   define output parameter p-prc        as decimal   no-undo .
     2348     do
     2349     on error undo, return error return-value
     2350     :
     2351     define variable v-str1 as character no-undo .
     2352     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     2353     v-str1 = trim ( v-str1 , chr(4) ) .
     2354    run lvldsc-bytt (
     2355         input   v-str1
     2356       , input   p-attr-value
     2357       , output  p-val1
     2358       , output  p-val2
     2359       , output  p-prc )
     2360         no-error .
     2361     end.
     2362   end procedure.
     2363   procedure lvldsc-bytt :
     2364   define input  parameter p-attr-code as character no-undo .
     2365   define input  parameter p-attr-value as character no-undo .
     2366   define output parameter p-val1 as decimal   no-undo .
     2367   define output parameter p-val2 as decimal   no-undo .
     2368   define output parameter p-prc  as decimal   no-undo .
     2369   define variable v-str1 as character no-undo .
     2370     do
     2371     on error undo, return error return-value
     2372     :
     2373     assign
     2374        v-str1 = trim ( p-attr-code , "[]()" )
     2375        p-val1 = decimal(entry(1,v-str1, ";"))
     2376        p-val2 = decimal(entry(2,v-str1, ";"))
     2377        p-prc  = decimal(p-attr-value)
     2378        no-error
     2379     .
     2380     end.
     2381   end procedure.
     2382   procedure level-dis-value :
     2383   define input  parameter p-price-prod as decimal   no-undo .
     2384   define input  parameter p-b-code     as integer   no-undo .
     2385   define input  parameter p-obj-type   as character no-undo .
     2386   define input  parameter p-obj-code   as integer   no-undo .
     2387   define output parameter p-prc as decimal   no-undo .
     2388   define variable v-level-dis-attr as character no-undo .
     2389   define variable v-type as character no-undo .
     2390   define variable v-val1 as decimal   no-undo .
     2391   define variable v-val2 as decimal   no-undo .
     2392   define variable v-prc  as decimal   no-undo .
     2393   define variable ix     as integer   no-undo .
     2394   do
     2395    on error undo, return error return-value
     2396    :
     2397   define buffer buf_goods for ub.goods  .
     2398   define buffer buf_bar-code for ub.bar-code  .
     2399   find first buf_bar-code no-lock where
     2400              buf_bar-code.b-code = p-b-code
     2401              no-error .
     2402   find first buf_goods no-lock where
     2403              buf_goods.gds-code = buf_bar-code.gds-code
     2404              no-error .
     2405   run ggoattr-value (
     2406      input   buf_goods.grp-code
     2407     ,input   v-cntxt-host-code-obj
     2408     ,input   p-obj-type
     2409     ,input   p-obj-code
     2410     ,input   'level-dis':U
     2411     ,output  v-level-dis-attr
     2412     ,output  v-type ) no-error .
     2413   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     2414     create
     2415       tt-level-dis-attr
     2416     .
     2417     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2418     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2419   end.
     2420   p-prc = 0 .
     2421     if p-price-prod = 0 then do:
     2422         for each tt-level-dis-attr no-lock
     2423                 :
     2424               run lvldsc-bytt (
     2425                 input   tt-level-dis-attr.attr-code
     2426               , input   tt-level-dis-attr.attr-value
     2427               , output  v-val1
     2428               , output  v-val2
     2429               , output  v-prc  )
     2430               .
     2431               if v-val1  = 0  then do:
     2432                  p-prc = v-prc .
     2433                 leave.
     2434               end.
     2435         end.
     2436     end.
     2437     else do:
     2438         for each tt-level-dis-attr no-lock
     2439                 :
     2440               run lvldsc-bytt (
     2441                 input   tt-level-dis-attr.attr-code
     2442               , input   tt-level-dis-attr.attr-value
     2443               , output  v-val1
     2444               , output  v-val2
     2445               , output  v-prc  )
     2446               .
     2447               if p-price-prod   > v-val1 and
     2448                  p-price-prod  <= v-val2 then do:
     2449                  p-prc = v-prc .
     2450                 leave.
     2451               end.
     2452         end.
     2453     end.
     2454   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     2455    end.
     2456   end procedure.
     2457   procedure calc-price-levelprod :
     2458   define input  parameter p-mode     as integer   no-undo .
     2459   define input  parameter p-rb       as character no-undo .
     2460   define input  parameter p-b-code   as integer   no-undo .
     2461   define input  parameter p-obj-type as character no-undo .
     2462   define input  parameter p-obj-code as integer   no-undo .
     2463   define output parameter p-price-sale as decimal   no-undo .
     2464   define output parameter p-descript-calc as character no-undo .
     2465   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     2466   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     2467   define variable  v-prod-vat        as decimal   no-undo init 0.
     2468   define variable  v-discnt          as decimal   no-undo init 0.
     2469   define buffer buf_goods for ub.goods  .
     2470   define buffer buf_bar-code for ub.bar-code  .
     2471   define buffer buf_parts for ub.parts  .
     2472   define variable v-part-code as character no-undo .
     2473   define variable v-in-code   as character no-undo .
     2474     do
     2475     on error undo, return error return-value
     2476     :
     2477   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     2479   (  input  p-b-code
     2480    , input  p-obj-type
     2481    , input  p-obj-code
     2482    , output v-PriceWithoutVat
     2483    , output v-PriceWithVat
     2484    , output v-prod-vat
     2485    , output v-part-code
     2486    , output v-in-code
     2487           ) no-error .
     2488         if error-status :error then do:
     2489           return error "Нет цены производителя!".
     2490         end.
     2491   find first buf_bar-code no-lock where
     2492              buf_bar-code.b-code = p-b-code
     2493              no-error .
     2494   find first buf_goods no-lock where
     2495              buf_goods.gds-code = buf_bar-code.gds-code
     2496              no-error .
     2497   find first buf_parts no-lock where
     2498              buf_parts.artic      = buf_goods.artic        and
     2499              buf_parts.prod-type  = buf_goods.prod-type    and
     2500              buf_parts.prod-code  = buf_goods.prod-code    and
     2501              buf_parts.in-code    = buf_bar-code.in-code   and
     2502              buf_parts.out-code   = buf_bar-code.in-code   and
     2503              buf_parts.part-code  = buf_bar-code.part-code
     2504              no-error .
     2505               if error-status :error then do:
     2506                   find first buf_parts no-lock where
     2507                             buf_parts.artic      = buf_goods.artic        and
     2508                             buf_parts.prod-type  = buf_goods.prod-type    and
     2509                             buf_parts.prod-code  = buf_goods.prod-code    and
     2510                             buf_parts.in-code    = v-in-code              and
     2511                             buf_parts.out-code   = v-in-code              and
     2512                             buf_parts.part-code  = v-part-code
     2513                             no-error .
     2514                   if error-status :error then do:
     2515                      message
     2516                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     2517                                   v-in-code,
     2518                                   v-part-code ,
     2519                                   buf_goods.artic   ,
     2520                                   buf_goods.prod-type,
     2521                                   buf_goods.prod-code ) .
     2522                      return error "Нет цены производителя !!!".
     2523                   end.
     2524               end.
     2525   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     2526   define variable v-postWithoutVat-rubl as decimal   no-undo .
     2527   define variable v-postWithoutVat-base as decimal   no-undo .
     2528      case p-mode :
     2529       when 1 then do:
     2530          if p-rb = "rubl" then do:
     2531             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     2532          end.
     2533          else do:
     2534             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     2535          end.
     2536       end.
     2537       when 2 then do:
     2538         if p-rb = "rubl" then do:
     2539           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     2540           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     2541         end.
     2542         else do:
     2543           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     2544           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     2545         end.
     2546       end.
     2547      end case.
     2548   p-descript-calc =
     2549     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     2550     buf_goods.gds-name                  +  chr(10) +
     2551     buf_goods.artic +
     2552     buf_goods.prod-type +
     2553     string(buf_goods.prod-code)         + chr(10) +
     2554     "бар-код " +  string(p-b-code)      + chr(10)  +
     2555     'ПН    ' + v-in-code  +
     2556     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     2557     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     2558     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     2559     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     2560     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     2561     chr(10) +
     2562     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     2563     chr(10) +
     2564     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     2565     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     2566     chr(10) +
     2567     string(p-price-sale)                                                               +  chr(10) +
     2568     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     2569     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     2570   .
     2571     end.
     2572   end procedure.
     2573   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2574   PROCEDURE write-bonus :
     2575   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2576   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2577   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2578   define input  parameter v-bonus as decimal   no-undo .
     2579     do
     2580     on error undo, return error return-value
     2581     :
     2582       find first ub.contract-specif-attr exclusive-lock  where
     2583                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2584                  ub.contract-specif-attr.host-code    = p-host-code     and
     2585                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2586                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2587                 no-error .
     2588         if not available ub.contract-specif-attr then do:
     2589            create ub.contract-specif-attr .
     2590            assign
     2591                 ub.contract-specif-attr.contract-num = p-contract-num
     2592                 ub.contract-specif-attr.host-code    = p-host-code
     2593                 ub.contract-specif-attr.gds-code     = p-gds-code
     2594                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2595            .
     2596         end.
     2597         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2598   end.
     2599   END PROCEDURE.
