      876       if v-cur-dn <> "" then do:
      877           for each old_price-list no-lock where
      878                    old_price-list.doc-num = v-cur-dn and
      879                    old_price-list.artic      = buf_goods.artic and
      880                    old_price-list.prod-type  = buf_goods.prod-type and
      881                    old_price-list.prod-code  = buf_goods.prod-code and
      882                    old_price-list.main-price = no,
      883                   first buf_bar-code no-lock where
      884                         buf_bar-code.b-code   = old_price-list.b-code and
      885                         buf_bar-code.unit-cli <> buf_goods.unit-base
      886                         :
