      891                         ,input buf_price-doc-forming.plt-id
      892                         ,input buf_price-doc-forming.pdf-db
      893                         ,input buf_price-doc-forming.pdf-id
      894                         ,input p-line-num
      895                         ,input old_price-list.b-code
      896                         ,input buf_goods.artic
      897                         ,input buf_goods.prod-type
      898                         ,input buf_goods.prod-code
      899                         ,input ""
      900                         ,input 0
      901                         ,input old_price-list.price-sale
      902                         ,input ""
      903                         ,input 0
      904                        ,input-output v-sec ) no-error .
      905           end.
      906       end.
      907   end.
      908   if par-pr-sclex = "yes" and
      909      par-pr-notls = "yes" then do:
      910       if v-cur-dn <> "" then do:
      911           for each old_price-list no-lock where
      912                    old_price-list.doc-num    = v-cur-dn and
      913                    old_price-list.artic      = buf_goods.artic and
      914                    old_price-list.prod-type  = buf_goods.prod-type and
      915                    old_price-list.prod-code  = buf_goods.prod-code and
      916                    old_price-list.main-price = no,
      917                   first buf_bar-code no-lock where
      918                         buf_bar-code.b-code   = old_price-list.b-code and
      919                         buf_bar-code.in-code  = "" and
      920                         buf_bar-code.unit-cli = buf_goods.unit-base
      921                         :
      922                          run check-use-bar-code (buf_bar-code.b-code) no-error .
      923                          if error-status :error then next.
      924                    run create-line-pdf-mpl-lib (
      925                          input buf_price-doc-forming.plt-db-num
      926                         ,input buf_price-doc-forming.plt-id
      927                         ,input buf_price-doc-forming.pdf-db
      928                         ,input buf_price-doc-forming.pdf-id
      929                         ,input p-line-num
      930                         ,input old_price-list.b-code
      931                         ,input buf_goods.artic
