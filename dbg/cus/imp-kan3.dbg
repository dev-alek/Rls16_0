     9134               ) no-error.
     9135               if error-status :error then do:
     9136                   imp-save = imp-save - 1 .
     9137                   output stream err to value ("Imp_Price.err") append.
     9138                   put stream err unformatted
     9139                       string(today, "99/99/9999") " "
     9140                       string(time, "HH:MM")
     9141                       substitute("Товар &1 нельзя добавить в ДНЦ &2 &3" , buf_goods.artic, return-value, error-status :get-message(1)  )
     9142                       skip.
     9143                   export stream err text-string .
     9144                   output stream err close.
     9145               end.
     9146   end.
     9147   input stream imp close.
     9148   message
     9149   substitute("Импорт из файла &1 закончен, прочитано &2,  создано строк в ДНЦ &3&4" +
     9150            "Все строки из файла которые не удалось импортировать можно посмотреть в файле Imp_Price.err "
     9151            , file-name
     9152            , impc
     9153            , imp-save
     9154            , chr(10))
     9155   view-as alert-box  INFORMATION.
