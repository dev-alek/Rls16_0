      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     run mainmenu_getcntxt in my-handle
      626       (output v-cntxt-db-num
      627       ,output v-cntxt-userid
      628       ,output v-cntxt-level
      629       ,output v-cntxt-host-code-obj
      630       ,output v-cntxt-obj-type
      631       ,output v-cntxt-obj-code
      632       ,output v-cntxt-db-num-obj
      633       ,output v-cntxt-is-admin
      634       ) .
      635   define variable base-type as character no-undo .
      636   define variable base-code as integer   no-undo .
      637   define variable g#report-num as integer   no-undo .
      638   define variable g#gds-engl as logical   no-undo .
      639   define variable vv-exch-rate  as decimal   no-undo .
      640   define variable vv-exch-scale as decimal   no-undo .
      641   define variable v-cntxt-host-name-obj as character no-undo .
      642   if v-cntxt-level = 'object':U then do:
      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      645     (input  v-cntxt-obj-type
      646     ,input  v-cntxt-obj-code
      647     ,output v-cntxt-host-code-obj
      648     ,output v-cntxt-host-name-obj
      649     )  .
      650   end.
      651   if v-cntxt-level = 'firm':U then do:
      652     find first ub.clients no-lock where
      653                ub.clients.obj-type = 'орг':U and
      654                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      655   if error-status :error then v-cntxt-host-name-obj = ? .
      656      else v-cntxt-host-name-obj = ub.clients.obj-name.
      657   end.
      658   if v-cntxt-level = 'object':U
      659   or v-cntxt-level = 'firm':U
      660   then do:
      661   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      663     (input  v-cntxt-host-code-obj
      664     ,output base-code
      665     )  .
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   define variable State-source as  WIDGET-HANDLE.
      679   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      680        VIEW-AS FILL-IN NATIVE
      681        SIZE 5 BY .79 NO-UNDO.
      682   DEFINE VARIABLE Classify AS CHARACTER
      683        VIEW-AS RADIO-SET VERTICAL
      684        RADIO-BUTTONS
      685             "Без классификации", "no-classify":U,
      686   "Группы товаров", "grp-goods":U
      687        SIZE 20.25 BY 2.54 NO-UNDO.
      688   DEFINE VARIABLE SortType AS CHARACTER
      689        VIEW-AS RADIO-SET VERTICAL
      690        RADIO-BUTTONS
      691             "по коду", "sort-code":U,
      692   "по артикулу", "sort-article":U
      693        SIZE 14 BY 2.54 NO-UNDO.
      694   DEFINE RECTANGLE RECT-5
      695        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      696        SIZE 32.25 BY 7.75.
      697   DEFINE RECTANGLE RECT-6
      698        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      699        SIZE 16.13 BY 7.79.
      700   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL no
      701        LABEL "Показывать нулевые остатки":L
      702        VIEW-AS TOGGLE-BOX
      703        SIZE 31.13 BY 1.13 NO-UNDO.
      704   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      705        LABEL "Только итоги":L
      706        VIEW-AS TOGGLE-BOX
      707        SIZE 16 BY 1 NO-UNDO.
      708   DEFINE VARIABLE Tog-lavel AS LOGICAL INITIAL no
      709        LABEL "с уровня":L
      710        VIEW-AS TOGGLE-BOX
      711        SIZE 12.63 BY .79 NO-UNDO.
      712   DEFINE FRAME F-Main
      713        Classify AT ROW 2.71 COL 2.25 NO-LABEL
      714        SortType AT ROW 2.71 COL 35.38 NO-LABEL
      715        Tog-lavel AT ROW 5.5 COL 14.75
      716        var-lavel AT ROW 5.5 COL 25.63 COLON-ALIGNED NO-LABEL
      717        SumsOnly AT ROW 7.29 COL 2.25
      718        ShowZero AT ROW 9.17 COL 2.25
      719        "Сортировка :" VIEW-AS TEXT
      720             SIZE 11.5 BY .75 AT ROW 1.33 COL 36.88
      721             FGCOLOR 4
      722        "Классификация :" VIEW-AS TEXT
      723             SIZE 15 BY .75 AT ROW 1.33 COL 9.5
      724             FGCOLOR 4
      725        RECT-5 AT ROW 1.13 COL 1.63
      726        RECT-6 AT ROW 1.13 COL 34.25
      727       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      728            SIDE-LABELS NO-UNDERLINE THREE-D
      729            AT COL 1 ROW 1 SCROLLABLE .
      730   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      731   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      732   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      733   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      734   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      735   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      736   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      737   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      738         adm-object-hdl = FRAME F-Main:HANDLE.
      739   RUN ensure-broker.
      740   THIS-PROCEDURE:ADM-DATA =
      741        'ADM1.1~`':U +
      742        'SmartObject~`':U +
      743        '~`':U +
      744        'NO ~`':U +
      745        '~`':U +
      746        '~`':U +
      747        '~`':U +
      748        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      749           + "~`":U +
      750        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      751        'Record-Source,Record-Target,TableIO-Target~`':U +
      752        '~`':U +
      753        '~`~`~`~`~`~`~`~`~`~`~`':U +
      754        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      755            THEN "^^":U
      756        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      757             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      758   PROCEDURE adm-apply-entry :
      759     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      760   END PROCEDURE.
      761   PROCEDURE adm-destroy :
      762    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      763   END PROCEDURE.
      764   PROCEDURE adm-disable :
      765       DISABLE RECT-5 RECT-6 Classify SortType ShowZero WITH FRAME F-Main.
      766       RUN dispatch ('disable-fields':U).
      767       RUN set-attribute-list ('ENABLED=no':U).
      768       RETURN.
      769   END PROCEDURE.
      770   PROCEDURE adm-edit-attribute-list :
      771         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      772         RETURN.
      773   END PROCEDURE.
      774   PROCEDURE adm-enable :
      775       ENABLE UNLESS-HIDDEN RECT-5 RECT-6 Classify SortType ShowZero WITH FRAME F-Main.
      776       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      777       RUN set-attribute-list ('ENABLED=yes':U).
      778       RETURN.
      779   END PROCEDURE.
      780   PROCEDURE adm-exit :
      781        RUN notify ('exit':U).
      782     RETURN.
      783   END PROCEDURE.
      784   PROCEDURE adm-hide :
      785     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      786   END PROCEDURE.
      787   PROCEDURE adm-initialize :
      788     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      789   END PROCEDURE.
      790   PROCEDURE adm-show-errors :
      791       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      792       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      793           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      794       END.
      795       RETURN.
      796   END PROCEDURE.
      797   PROCEDURE adm-UIB-mode :
      798     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      799   END PROCEDURE.
      800   PROCEDURE adm-view :
      801     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      802   END PROCEDURE.
      803   PROCEDURE dispatch :
      804       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      805       RUN broker-dispatch IN adm-broker-hdl
      806           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      807       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      808   END PROCEDURE.
      809   PROCEDURE ensure-broker :
      810   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      811   IF RETURN-VALUE NE "ADM-Broker":U THEN
      812   DO:
      813       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      814       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      815   END.
      816   END PROCEDURE.
      817   PROCEDURE get-attribute :
      818     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      819     RUN broker-get-attribute IN adm-broker-hdl
      820         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      821     RETURN RETURN-VALUE.
      822   END PROCEDURE.
      823   PROCEDURE get-attribute-list :
      824     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      825     RUN broker-get-attribute-list IN adm-broker-hdl
      826         (INPUT THIS-PROCEDURE,
      827          INPUT ?,
      828          OUTPUT p-attr-list) NO-ERROR.
      829     RETURN.
      830   END PROCEDURE.
      831   PROCEDURE new-state :
      832     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      833     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      834     RETURN.
      835   END PROCEDURE.
      836   PROCEDURE notify :
      837     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      838     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      839     IF RETURN-VALUE = "ADM-ERROR":U THEN
      840         RETURN "ADM-ERROR":U.
      841     RETURN.
      842   END PROCEDURE.
      843   PROCEDURE set-attribute-list :
      844     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      845     RUN ensure-broker.
      846     RUN broker-set-attribute-list IN adm-broker-hdl
      847         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      848     RETURN.
      849   END PROCEDURE.
      850   PROCEDURE set-position :
      851       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      852       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      853       IF VALID-HANDLE(adm-object-hdl) THEN
      854       DO:
      855         ASSIGN adm-object-hdl:ROW    =   p-row
      856                adm-object-hdl:COLUMN =   p-col.
      857       END.
      858       RETURN.
      859   END PROCEDURE.
      860   PROCEDURE adm-display-fields :
      861       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      862       RETURN.
      863   END PROCEDURE.
      864   PROCEDURE adm-open-query :
      865     RETURN.
      866   END PROCEDURE.
      867   PROCEDURE adm-row-changed :
      868         IF VALID-HANDLE(adm-object-hdl) THEN
      869           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      870         RUN notify ('row-available':U).
      871         RETURN.
      872   END PROCEDURE.
      873   PROCEDURE reposition-query :
      874       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      875       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      876       RETURN.
      877   END PROCEDURE.
      878     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      879     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      880     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      881     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      882     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      883     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      884     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      885     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      886     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      887     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      888     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      889     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      890     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      891     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      892     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      893     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      894     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      895     IF "":U = "":U THEN
      896       RUN modify-list-attribute IN adm-broker-hdl
      897         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      898     RUN use-create-on-add(?).
      899   PROCEDURE adm-add-record :
      900       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      901          "must have at least one Enabled Table to perform Add.":U
      902          VIEW-AS ALERT-BOX ERROR.
      903       RETURN.
      904   END PROCEDURE.
      905   PROCEDURE adm-assign-record :
      906    MESSAGE
      907          "Object ":U THIS-PROCEDURE:FILE-NAME
      908            "must have at least one Enabled Table to perform Assign.":U
      909              VIEW-AS ALERT-BOX ERROR.
      910      RETURN.
      911     END PROCEDURE.
      912   PROCEDURE adm-assign-statement :
      913     RETURN.
      914   END PROCEDURE.
      915   PROCEDURE adm-cancel-record :
      916      RETURN.
      917     END PROCEDURE.
      918   PROCEDURE adm-copy-record :
      919       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      920        "must have at least one Enabled Table to perform Copy.":U
      921          VIEW-AS ALERT-BOX ERROR.
      922       RETURN.
      923   END PROCEDURE.
      924   PROCEDURE adm-create-record :
      925      RETURN.
      926   END PROCEDURE.
      927   PROCEDURE adm-current-changed :
      928     RETURN.
      929   END PROCEDURE.
      930   PROCEDURE adm-delete-record :
      931    MESSAGE
      932          "Object ":U THIS-PROCEDURE:FILE-NAME
      933            "must have at least one Enabled Table to perform Delete.":U
      934              VIEW-AS ALERT-BOX ERROR.
      935       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      936       RETURN.
      937   END PROCEDURE.
      938   PROCEDURE adm-disable-fields :
      939         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      940       RETURN.
      941   END PROCEDURE.
      942   PROCEDURE adm-enable-fields :
      943       RETURN.
      944   END PROCEDURE.
      945   PROCEDURE adm-end-update :
      946     RETURN.
      947   END PROCEDURE.
      948   PROCEDURE adm-reset-record :
      949       RETURN.
      950   END PROCEDURE.
      951   PROCEDURE adm-update-record :
      952       MESSAGE
      953         "Object ":U THIS-PROCEDURE:FILE-NAME
      954           "must have at least one Enabled Table to perform Update.":U
      955             VIEW-AS ALERT-BOX ERROR.
      956      RETURN.
      957   END PROCEDURE.
      958   PROCEDURE check-modified :
      959   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      960   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      961   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      962   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      963     IF check-state = "check":U THEN
      964     DO:
      965       RUN get-link-handle IN adm-broker-hdl
      966         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      967            OUTPUT group-target-list).
      968       IF group-target-list NE "":U THEN
      969       DO i = 1 TO NUM-ENTRIES(group-target-list):
      970         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      971         RUN check-modified IN curr-widget ('group-check':U).
      972         IF RETURN-VALUE NE "":U THEN
      973         DO:
      974           RUN check-modified-message(RETURN-VALUE).
      975           RETURN "":U.
      976         END.
      977       END.
      978     END.
      979     RETURN "":U.
      980   END PROCEDURE.
      981   PROCEDURE check-modified-message :
      982     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      983        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      984           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      985        IF RETURN-VALUE = "YES":U THEN
      986           RUN notify ('view,CONTAINER-SOURCE':U).
      987        MESSAGE IF p-changed-table NE ? THEN
      988           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      989           ELSE "Current values have been changed."
      990           SKIP "  Do you wish to save those changes?"
      991           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      992        IF ANS THEN
      993        DO:
      994           IF group-assign-target THEN
      995             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      996           ELSE RUN dispatch('update-record':U).
      997           IF RETURN-VALUE = "ADM-ERROR":U THEN
      998           DO:
      999               MESSAGE "Changes to the previous record were not saved."
     1000                 VIEW-AS ALERT-BOX ERROR.
     1001               IF group-assign-target THEN
     1002                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1003               ELSE RUN dispatch ('cancel-record':U).
     1004           END.
     1005        END.
     1006        ELSE DO:
     1007          IF group-assign-target THEN
     1008             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1009          ELSE RUN dispatch('cancel-record':U).
     1010        END.
     1011        RETURN.
     1012   END PROCEDURE.
     1013   PROCEDURE get-rowid :
     1014       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1015       ASSIGN
     1016       p-table   =   adm-first-table.
     1017       RETURN.
     1018   END PROCEDURE.
     1019   PROCEDURE init-group-assign :
     1020       RUN request-attribute IN adm-broker-hdl
     1021         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1022       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1023         group-assign-target = yes.
     1024       ELSE group-assign-target = no.
     1025       RETURN.
     1026   END PROCEDURE.
     1027   PROCEDURE set-editors :
     1028       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1029       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1030       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1031       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1032       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1033       DO WHILE VALID-HANDLE (curr-widget):
     1034           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1035              curr-widget:HIDDEN = no THEN DO:
     1036             CASE p-field-setting:
     1037               WHEN "INITIALIZE":U THEN
     1038               DO:
     1039                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1040                     read-only-list +
     1041                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1042                        STRING(curr-widget).
     1043               END.
     1044               WHEN "DISABLE":U OR
     1045               WHEN "ENABLE":U THEN
     1046               DO:
     1047                   curr-widget:SENSITIVE = yes.
     1048                   RUN get-attribute ('Read-Only-Editors':U).
     1049                   IF RETURN-VALUE = ? OR
     1050                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1051                       curr-widget:READ-ONLY =
     1052                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1053               END.
     1054               WHEN "CLEAR":U THEN
     1055                   curr-widget:SCREEN-VALUE = "":U.
     1056             END CASE.
     1057           END.
     1058           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1059       END.
     1060       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1061         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1062           + '"':U).
     1063       RETURN.
     1064   END PROCEDURE.
     1065   PROCEDURE use-check-modified-all :
     1066    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1067     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1068     RETURN.
     1069   END PROCEDURE.
     1070   PROCEDURE use-create-on-add :
     1071   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1072      RETURN.
     1073   END PROCEDURE.
     1074   PROCEDURE use-initial-lock :
     1075     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1076     ASSIGN adm-initial-lock = p-attr-value.
     1077     RETURN.
     1078   END PROCEDURE.
     1079     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1080   ASSIGN
     1081          FRAME F-Main:SCROLLABLE       = FALSE
     1082          FRAME F-Main:HIDDEN           = TRUE.
     1083   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1084   DO:
     1085       Assign Classify.
     1086       if Classify  Begins "prod":U OR
     1087          Classify  Begins "grp-goods":U then
     1088           enable SumsOnly with frame F-Main .
     1089       else
     1090           do:
     1091               SumsOnly = FALSE .
     1092               display SumsOnly with frame F-Main .
     1093               disable SumsOnly with frame F-Main .
     1094           end.
     1095    if Classify = "grp-goods":U
     1096            Then do:
     1097               display TOG-lavel   with frame F-Main .
     1098               enable  TOG-lavel   with frame F-Main .
     1099           end.
     1100            Else do:
     1101               display  TOG-lavel  var-Lavel with frame F-Main .
     1102               disable  TOG-lavel  var-Lavel with frame F-Main .
     1103           end.
     1104   END.
     1105   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1106   DO:
     1107      Assign tog-lavel.
     1108     if tog-lavel = TRUE
     1109           Then do:
     1110               display  var-Lavel  with frame F-Main .
     1111               enable   var-Lavel  with frame F-Main .
     1112           end.
     1113            Else do:
     1114               display    var-Lavel with frame F-Main .
     1115               disable    var-Lavel with frame F-Main .
     1116           end.
     1117   END.
     1118   if not this-procedure :persistent
     1119   then do:
     1120     message
     1121       vss-workfile vss-revision vss-description skip
     1122       "Ошибка при запуске процедуры" skip
     1123       "Данную процедуру следует запускать только с параметром persistent" skip
     1124       view-as alert-box error .
     1125     undo, return error .
     1126   end.
     1127   PROCEDURE disable_UI :
     1128     HIDE FRAME F-Main.
     1129     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1130   END PROCEDURE.
     1131   PROCEDURE my-report :
     1132   if Classify = "no-classify":U then do:
     1133   run cus/r-benet5.p   (
     1134    input  v-cntxt-obj-code,
     1135    input  v-cntxt-obj-type,
     1136    input  base-type ,
     1137    input  base-code ,
     1138    input  Classify  ,
     1139    input  SortType  ,
     1140    input  SumsOnly  ,
     1141    input  ShowZero  ,
     1142    false ,
     1143    input   tog-lavel,
     1144    input   var-lavel )
     1145   .
     1146   End.
     1147   Else do:
     1148     run cus/r-bene52.p   (
     1149     input  v-cntxt-obj-code,
     1150     input  v-cntxt-obj-type,
     1151     input  base-type ,
     1152     input  base-code ,
     1153     input  Classify  ,
     1154     input  SortType  ,
     1155     input  SumsOnly  ,
     1156     input  ShowZero  ,
     1157     false ,
     1158     input   tog-lavel,
     1159     input   var-lavel )
     1160     .
     1161   End.
     1162   END PROCEDURE.
     1163   PROCEDURE my-var :
     1164   assign frame F-Main SumsOnly ShowZero  Classify SortType
     1165   Tog-lavel var-lavel.
     1166   def var t-class as char no-undo.
     1167   def var t-sort as char no-undo.
     1168     case classify:
     1169       when "no-classify":u    then t-class =   "Без классификации" .
     1170       when "prod":u           then t-class =   "Производители"   .
     1171       when "post":u           then t-class =   "Поставщики"   .
     1172       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1173       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1174       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1175       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1176       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1177       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1178       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1179       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1180       when  "t-level":u       then t-class =   "Терминальные группы" .
     1181    end case.
     1182     case sorttype:
     1183       when "sort-pp":u               then t-sort =   "по порядку" .
     1184       when "sort-code":u             then t-sort =   "по коду" .
     1185       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1186       when "sort-qunty":u            then t-sort =   "по реализации".
     1187       when "sort-name":u             then t-sort =   "по наименованию".
     1188       when "sort-type":u             then t-sort =   "по типу ткани".
     1189       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1190       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1191    end case.
     1192   ReportNAme = "С О С Т О Я Н И Е    З А П А С А ".
     1193   ReportHeader = "Классификация : " + t-class + chr(10) +
     1194                  (if SumsOnly then "Только итоги "  else " " )  +  chr(10) +
     1195                 "Сортировка " + t-sort  + chr(10) +
     1196                  (if ShowZero then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) .
     1197     if X-SET_PAY_TYPE <> 2 then str3 =  "в ценах РЕАЛИЗАЦИИ".
     1198    str2 = "" .
     1199    sheetf.Excel-Column-Lable =
     1200             "Код"
     1201     + ","  + "Артикул"
     1202     + ","  + "Название товара"
     1203     + ","  + "Ед. изм" .
     1204     define variable t-str as character no-undo .
     1205     For each obj-list no-lock :
     1206       t-str = obj-list.obj-name .
     1207       repeat :
     1208           if index ( t-str , "," ) > 0 then do:
     1209              substring ( t-str ,  index ( t-str , "," ) ) = "." .
     1210           end.
     1211           else leave.
     1212       end.
     1213       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable   + ","  + "Количество "  + t-str + ","  + "Стоимость" .
     1214     End.
     1215     sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable   + ","  + "Количество ИТОГО,Стоимость ИТОГО" .
     1216    sheetf.Sizes =  "10,16,40,5".
     1217     For each obj-list no-lock :
     1218       sheetf.Sizes = sheetf.Sizes   + ","  + "15"  + ","  + "15" .
     1219     End.
     1220     sheetf.Sizes = sheetf.Sizes   + ","  + "15"  + ","  + "15" .
     1221     sheetf.colformat = "2=@;3=@":U .
     1222   END PROCEDURE.
