      612   define new global shared variable g#library  as handle no-undo .
      613   define new global shared variable g#library2 as handle no-undo .
      614   define variable var-report-r-b as character no-undo .
      615   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      617     (output var-report-r-b
      618     )  .
      619   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      620   define variable v-waitfram-action01         as character   no-undo .
      621   define variable v-waitfram-action02         as character   no-undo .
      622   define variable v-waitfram-action03         as character   no-undo .
      623   define variable mWaitFramTextBeg            as character   no-undo.
      624   define variable mWaitFramTextEnd            as character   no-undo.
      625   define variable mWaitFramView               as logical     no-undo.
      626   define variable mWaitProcEvent              as logical     no-undo init yes.
      627   define variable mWaitFramInterval           as integer     no-undo init 1 .
      628   define variable mWaitFramStop               as logical     no-undo.
      629   define variable mWaitFramStopUser           as logical     no-undo.
      630   define variable mWaitFramStopTimeOut        as logical     no-undo.
      631   define variable mWaitFramStartProc          as datetime-tz no-undo.
      632   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      633   define button B-WaitFramStop auto-end-key
      634        label "Стоп"
      635        size 10 by 1 tooltip "Остоновить процесс".
      636   define button B-viewProcInfo
      637        label "Информация"
      638        size 15 by 1 tooltip "Информация о процесс".
      639   define frame waitfram
      640     v-waitfram-action01 format "x(72)" no-label skip
      641     v-waitfram-action02 format "x(72)" no-label skip
      642     v-waitfram-action03 format "x(72)" no-label skip
      643     B-viewProcInfo
      644     B-WaitFramStop at row 4 col 30
      645     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      646     .
      647   define new global shared variable mBatchMode as logical no-undo init ?.
      648   define variable mFramBachModHandle as handle no-undo.
      649   mFramBachModHandle = frame waitfram:handle.
      650   define variable mFameOldVis as logical no-undo.
      651   define variable mVisCUrentVin as logical no-undo.
      652   if session:batch-mode
      653   then
      654      mBatchMode = yes.
      655   if mBatchMode = ? then do:
      656     mVisCUrentVin = current-window:visible.
      657     mFameOldVis = mFramBachModHandle:visible.
      658     mFramBachModHandle:visible  = yes.
      659     mBatchMode = mFramBachModHandle:visible ne yes.
      660     mFramBachModHandle:visible = mFameOldVis.
      661     current-window:visible = mVisCUrentVin.
      662   end.
      663    if  log-manager:logfile-name ne ?
      664     then DO:
      665         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      666         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      667         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      668     end.
      669   on choose of B-WaitFramStop in frame waitfram
      670   do:
      671     mWaitFramStop = yes.
      672     mWaitFramStopUser = yes.
      673   end.
      674   function waitfram-check-timeout returns logical():
      675      define variable vtime as int64 no-undo.
      676      if mWaitFramStopTimeOut
      677      then
      678         return yes.
      679      vtime = ( now - mWaitFramStartProc ) / 1000 .
      680      if     mWaitFramTimeOut ne ?
      681         and mWaitFramTimeOut ne 0
      682         and mWaitFramTimeOut lt vtime
      683      then do:
      684         mWaitFramStopTimeOut = yes.
      685      end.
      686      return mWaitFramStopTimeOut.
      687   end.
      688   procedure waitfram-hide :
      689     if not session:batch-mode
      690     then do
      691     on error undo, return error return-value
      692     :
      693       pause 0 before-hide .
      694       if not mBatchMode then
      695         hide frame waitfram .
      696     if     not mWaitFramView
      697        and mWaitProcEvent
      698     then
      699       process events .
      700     end.
      701   end procedure.
      702   procedure waitfram-show :
      703     define input  parameter p-message as character no-undo .
      704     define variable v-left-margin as integer   no-undo .
      705     if not session:batch-mode
      706     then do
      707     on error undo, return error return-value
      708     :
      709       if length(p-message) <= 70 then do:
      710         assign
      711           v-left-margin = integer((70 - length(p-message)) / 2)
      712         .
      713         assign
      714           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      715         .
      716         assign
      717           v-waitfram-action01 = " "
      718           v-waitfram-action02 = " "
      719                                    + fill(" ", v-left-margin)
      720                                    + p-message
      721           v-waitfram-action03 = " "
      722         .
      723       end.
      724       else do:
      725         define variable vRindex1 as integer no-undo.
      726         define variable vRindex2 as integer no-undo.
      727         vRindex1 = r-index(p-message," ",70).
      728         if vRindex1 = 0
      729         then
      730            vRindex1 = 70.
      731         if length(p-message)  <= vRindex1 + 70 then do:
      732           assign
      733             v-waitfram-action01 = " "
      734             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      735             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      736           .
      737         end.
      738         else do:
      739           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      740           if vRindex2 <= vRindex1
      741           then
      742              vRindex2 = vRindex1 + 70.
      743           assign
      744             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      745             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      746             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      747           .
      748         end.
      749       end.
      750       B-viewProcInfo:visible   in frame waitfram = no.
      751       B-viewProcInfo:sensitive in frame waitfram = no.
      752       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      753       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      754       if  (   mWaitFramView
      755          or  mWaitProcEvent)
      756          and not mBatchMode
      757       then
      758          display
      759             v-waitfram-action01 skip
      760             v-waitfram-action02 skip
      761             v-waitfram-action03 skip
      762          with frame waitfram .
      763       if     mWaitFramView
      764          then do:
      765             if     mWaitFramInterval ne ?
      766                and not mBatchMode
      767             then
      768                wait-for go of frame waitfram pause mWaitFramInterval.
      769          end.
      770          else
      771             if     mWaitProcEvent
      772                and not mBatchMode
      773             then
      774                process events .
      775     end.
      776   end procedure.
      777      procedure waitfram-show-this:
      778         define input  parameter iInterval as int64 no-undo.
      779         define variable vtime as int64 no-undo.
      780         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      781         mWaitFramInterval = iInterval.
      782         run waitfram-show (substitute("&1&2 &3&4" ,
      783                                       mWaitFramTextBeg ,
      784                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      785                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      786                                       mWaitFramTextEnd
      787                                      )
      788                           ).
      789      end.
      790      procedure WaitFramRunPause:
      791         define input  parameter iInterval as dec no-undo.
      792         define variable vStart  as datetime-tz no-undo.
      793         define variable vend    as datetime-tz no-undo.
      794         define variable vint as int64 no-undo.
      795         define variable vOk as logical no-undo.
      796         vStart = now.
      797         vend   = vStart.
      798         publish "WaitFramPause" (iInterval,output vOk).
      799         vend   =  now.
      800         vint = vend - vStart.
      801         vint = iInterval - vint / 1000.
      802         if     not mWaitFramStop
      803            and (   vint > 0
      804                 or (    not vOk
      805                     and iInterval eq ?
      806                     )
      807                 )
      808         then
      809            run waitfram-show-this (iInterval).
      810         vend   =  now.
      811         vint = vend - vStart.
      812         vint = iInterval - vint / 1000.
      813         if     not mWaitFramStop
      814            and vint > 0
      815         then do:
      816            run gbl/pause.p (vint * 1000).
      817         end.
      818         if iInterval ne ?
      819         then
      820            publish "WaitFramStop".
      821         waitfram-check-timeout().
      822      end.
      823      procedure WaitFramWaitFor:
      824         define input  parameter iInterval as dec no-undo.
      825         assign
      826            mWaitFramStartProc   = now
      827            mWaitFramStopUser    = no
      828            mWaitFramStopTimeOut = no
      829         .
      830         block-wait:
      831         do while not mWaitFramStop:
      832            run WaitFramRunPause (iInterval).
      833            if  waitfram-check-timeout()
      834            then do:
      835               leave block-wait.
      836            end.
      837         end.
      838         run waitfram-hide.
      839      end.
      840   procedure waitfram-join :
      841     define input  parameter p-line-1  as character no-undo .
      842     define input  parameter p-line-2  as character no-undo .
      843     define input  parameter p-line-3  as character no-undo .
      844     define output parameter p-message as character no-undo .
      845     do
      846     on error undo, return error return-value
      847     :
      848       assign
      849         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      850                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      851                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      852       .
      853     end.
      854   end procedure.
      855   function waitfram-join-function returns character
      856     (input p-line-1 as character
      857     ,input p-line-2 as character
      858     ,input p-line-3 as character
      859     ).
      860     define variable v-message as character no-undo .
      861     run waitfram-join in this-procedure
      862       (input  p-line-1
      863       ,input  p-line-2
      864       ,input  p-line-3
      865       ,output v-message
      866       ) .
      867     return v-message .
      868   end function .
      869   define variable     NotInc          as  log     no-undo.
      870   define var cas-num as integer no-undo.
      871   def SHARED var cas-shft as logical no-undo init no.
      872   def buffer for-gds for ub.chk-gds.
      873   def stream PrnLibStream .
      874   define variable found as logical init yes no-undo.
      875   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      876   PROCEDURE no-benq.
      877   DEFINE OUTPUT PARAMETER found as logical init no.
      878   define buffer buf_chk-doc for ub.chk-doc.
      879   FOR EACH obj-list WHERE
      880           obj-list.obj-type = 'маг':U NO-LOCK :
      881     CASE X-Radio-Task > 1 :
      882       WHEN YES THEN DO:
      883         FOR EACH buf_chk-doc NO-LOCK WHERE
      884                 buf_chk-doc.obj-type = obj-list.obj-type AND
      885                 buf_chk-doc.obj-code = obj-list.obj-code AND
      886                 (
      887                   buf_chk-doc.shift-date >= X-date-start AND
      888                   buf_chk-doc.shift-date <= X-date-end)
      889                   AND
      890                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      891           IF X-Radio-Task = 3 AND
      892           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
      893             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
      894           IF X-Radio-Task = 4 AND
      895           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
      896           found = yes.
      897           return.
      898         END.
      899       END.
      900       WHEN NO THEN DO:
      901         FOR EACH buf_chk-doc NO-LOCK WHERE
      902               buf_chk-doc.obj-type = obj-list.obj-type AND
      903               buf_chk-doc.obj-code = obj-list.obj-code AND
      904               buf_chk-doc.chk-date >= X-date-start AND
      905               buf_chk-doc.chk-date <= X-date-end   AND
      906               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      907           found = yes.
      908           return.
      909         END.
      910        END.
      911      END CASE.
      912    END.
      913   END PROCEDURE.
      914   PROCEDURE no-benqi.
      915   DEFINE OUTPUT PARAMETER found as logical init no.
      916   define buffer buf_chk-doc for ub.chk-doc.
      917   define buffer buf_inkas for ub.inkas.
      918   FOR EACH obj-list WHERE
      919         obj-list.obj-type = 'маг':U NO-LOCK :
      920     CASE X-Radio-Task > 1 :
      921       WHEN YES THEN DO:
      922         FOR EACH buf_chk-doc No-LOCK WHERE
      923                 buf_chk-doc.obj-type = obj-list.obj-type AND
      924                 buf_chk-doc.obj-code = obj-list.obj-code AND
      925                 (
      926                   buf_chk-doc.shift-date >= X-date-start AND
      927                   buf_chk-doc.shift-date <= X-date-end)
      928                   AND
      929                   buf_Chk-doc.out-code = ? AND
      930                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      931           IF X-Radio-Task = 3 AND
      932           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
      933             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
      934           IF X-Radio-Task = 4 AND
      935           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
      936           found = yes.
      937           return.
      938         END.
      939         FOR EACH buf_inkas No-LOCK WHERE
      940                   buf_inkas.obj-type = obj-list.obj-type AND
      941                   buf_inkas.obj-code = obj-list.obj-code AND
      942                   (
      943                   buf_inkas.shift-date >= X-date-start AND
      944                   buf_inkas.shift-date <= X-date-end):
      945           if buf_inkas.status_ = 'факт':U
      946           or buf_inkas.status_ = 'запрос':U then next.
      947           IF X-Radio-Task = 3 AND
      948           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
      949             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
      950           IF X-Radio-Task = 4 AND
      951           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
      952           found = yes.
      953           return.
      954         END.
      955       END.
      956       WHEN NO THEN DO:
      957         FOR EACH buf_chk-doc NO-LOCK WHERE
      958                 buf_chk-doc.obj-type = obj-list.obj-type AND
      959                 buf_chk-doc.obj-code = obj-list.obj-code AND
      960                 buf_chk-doc.chk-date >= X-date-start AND
      961                 buf_chk-doc.chk-date <= X-date-end   AND
      962                 buf_Chk-doc.out-code = ? AND
      963                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
      964           found = yes.
      965           return.
      966         END.
      967         FOR EACH buf_inkas NO-LOCK WHERE
      968                 buf_inkas.obj-type = obj-list.obj-type AND
      969                 buf_inkas.obj-code = obj-list.obj-code AND
      970                 buf_inkas.doc-date >= X-date-start AND
      971                 buf_inkas.doc-date <= X-date-end :
      972           if buf_inkas.status_ = 'факт':U
      973           or buf_inkas.status_ = 'запрос':U then next.
      974           found = yes.
      975           return.
      976         END.
      977       END.
      978     END CASE.
      979   END.
      980   END PROCEDURE.
      981   PROCEDURE no-benq-i.
      982   DEFINE OUTPUT PARAMETER found as logical init no.
      983   define buffer buf_inkas for ub.inkas.
      984   CASE X-Radio-Task > 1:
      985     WHEN YES then do:
      986       FOR EACH obj-list WHERE
      987               obj-list.obj-type = 'маг':U NO-LOCK :
      988         FOR EACH buf_inkas NO-LOCK WHERE
      989                 buf_inkas.obj-type = obj-list.obj-type AND
      990                 buf_inkas.obj-code = obj-list.obj-code AND
      991                 buf_inkas.status_ = 'факт':U AND
      992                 (
      993                 buf_inkas.shift-date >= X-date-start AND
      994                 buf_inkas.shift-date <= X-date-end):
      995           IF X-Radio-Task = 3 AND
      996           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
      997             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
      998           IF X-Radio-Task = 4 AND
      999           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1000           found = yes.
     1001           return.
     1002         END.
     1003     END.
     1004     END.
     1005     WHEN NO THEN DO:
     1006       FOR EACH obj-list WHERE
     1007               obj-list.obj-type = 'маг':U NO-LOCK :
     1008         FOR EACH buf_inkas NO-LOCK WHERE
     1009                 buf_inkas.obj-type = obj-list.obj-type AND
     1010                 buf_inkas.obj-code = obj-list.obj-code AND
     1011                 buf_inkas.status_ = 'факт':U AND
     1012                 buf_inkas.doc-date >= X-date-start AND
     1013                 buf_inkas.doc-date <= X-date-end :
     1014            found = yes.
     1015            return.
     1016         END.
     1017       END.
     1018     END.
     1019   END CASE.
     1020   END PROCEDURE.
     1021   PROCEDURE no-benq-i-office.
     1022   DEFINE OUTPUT PARAMETER found as logical init no.
     1023   define buffer buf_sale-doc for ub.sale-doc.
     1024   CASE X-Radio-Task > 1:
     1025     WHEN YES then do:
     1026       FOR EACH obj-list WHERE
     1027               obj-list.obj-type = 'маг':U NO-LOCK :
     1028         FOR EACH buf_sale-doc NO-LOCK WHERE
     1029                  buf_Sale-doc.obj-type = obj-list.obj-type
     1030              AND buf_sale-doc.obj-code = obj-list.obj-code
     1031              AND buf_sale-doc.status_ = 'факт':U
     1032              AND buf_sale-doc.chr-office = 'у':U
     1033              AND (
     1034                 buf_sale-doc.shift-date >= X-date-start
     1035                 AND
     1036                 buf_sale-doc.shift-date <= X-date-end):
     1037           IF X-Radio-Task = 3 AND
     1038           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1039             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1040           IF X-Radio-Task = 4 AND
     1041           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1042           found = yes.
     1043           return.
     1044         END.
     1045       END.
     1046     END.
     1047     WHEN NO THEN DO:
     1048       FOR EACH obj-list WHERE
     1049               obj-list.obj-type = 'маг':U NO-LOCK :
     1050         FOR EACH buf_sale-doc NO-LOCK WHERE
     1051                 buf_sale-doc.obj-type = obj-list.obj-type
     1052            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1053            AND  buf_sale-doc.status_ = 'факт':U
     1054            AND  buf_sale-doc.chr-office = 'у':U
     1055            AND  buf_sale-doc.doc-date >= X-date-start
     1056            AND  buf_sale-doc.doc-date <= X-date-end :
     1057           found = yes.
     1058           return.
     1059         END.
     1060       END.
     1061     END.
     1062   END CASE.
     1063   END PROCEDURE.
     1064   function diff-list returns character (
     1065     input parfirst-list  as character,
     1066     input parsecond-list as character,
     1067     input pardelim       as character).
     1068     if pardelim = ""
     1069     or pardelim = ?
     1070     then do:
     1071       assign
     1072         pardelim = ","
     1073       .
     1074     end.
     1075     def var ind as integer no-undo .
     1076     def var v-elem as character no-undo .
     1077     def var v-result-list as character no-undo init "".
     1078     def var v-num-parfirst-list as integer no-undo .
     1079     assign
     1080       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1081     .
     1082     do ind = 1 to v-num-parfirst-list
     1083     :
     1084       assign
     1085         v-elem = entry(ind, parfirst-list, pardelim)
     1086       .
     1087       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1088         assign
     1089           v-result-list = v-result-list
     1090                         + (if v-result-list > "" then pardelim else "")
     1091                         + v-elem
     1092         .
     1093       end.
     1094     end.
     1095     return v-result-list .
     1096   end function.
     1097   function add-list returns character (
     1098    input parfirst-list  as character,
     1099    input parsecond-list as character,
     1100    input pardelim       as character).
     1101     if pardelim = ""
     1102     or pardelim = ?
     1103     then do:
     1104       assign
     1105         pardelim = ","
     1106       .
     1107     end.
     1108     def var ind as integer no-undo .
     1109     def var v-elem as character no-undo .
     1110     def var v-result-list as character no-undo init "".
     1111     def var v-num-parfirst-list as integer no-undo .
     1112     assign
     1113       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1114     .
     1115     do ind = 1 to v-num-parfirst-list
     1116     :
     1117       assign
     1118         v-elem = entry(ind, parfirst-list, pardelim)
     1119       .
     1120       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1121         assign
     1122           v-result-list = v-result-list
     1123                         + (if v-result-list > "" then pardelim else "")
     1124                         + v-elem
     1125         .
     1126       end.
     1127     end.
     1128     def var v-num-parsecond-list as integer no-undo .
     1129     assign
     1130       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1131     .
     1132     do ind = 1 to v-num-parsecond-list
     1133     :
     1134       assign
     1135         v-elem = entry(ind, parsecond-list, pardelim)
     1136       .
     1137       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1138         assign
     1139           v-result-list = v-result-list
     1140                         + (if v-result-list > "" then pardelim else "")
     1141                         + v-elem
     1142         .
     1143       end.
     1144     end.
     1145     return v-result-list .
     1146   end function.
     1147   function cross-list returns character (
     1148    input parfirst-list  as character,
     1149    input parsecond-list as character,
     1150    input pardelim       as character).
     1151     if pardelim = ""
     1152     or pardelim = ?
     1153     then do:
     1154       assign
     1155         pardelim = ","
     1156       .
     1157     end.
     1158     def var ind as integer no-undo .
     1159     def var v-elem as character no-undo .
     1160     def var v-result-list as character no-undo init "".
     1161     def var v-num-parfirst-list as integer no-undo .
     1162     assign
     1163       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1164     .
     1165     do ind = 1 to v-num-parfirst-list
     1166     :
     1167       assign
     1168         v-elem = entry(ind, parfirst-list, pardelim)
     1169       .
     1170       if lookup(v-elem, v-result-list, pardelim) = 0
     1171       and lookup(v-elem, parsecond-list, pardelim) > 0
     1172       then do:
     1173         assign
     1174           v-result-list = v-result-list
     1175                         + (if v-result-list > "" then pardelim else "")
     1176                         + v-elem
     1177         .
     1178       end.
     1179     end.
     1180     return v-result-list .
     1181   end function.
     1182   function radio-label returns character (
     1183    input par-rs-value  as character,
     1184    input par-rs-radio-buttons as character)
     1185    .
     1186    DEFINE variable v-result-label as character no-undo.
     1187    assign
     1188    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1189                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1190                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1191                             ), par-rs-radio-buttons
     1192                           )
     1193    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1194    .
     1195   return v-result-label.
     1196   end function.
     1197   function m-radio-label returns character (
     1198    input par-rs-value  as character,
     1199    input par-rs-radio-buttons as character,
     1200    input par-delim as character
     1201    )
     1202    .
     1203    DEFINE variable v-result-label as character no-undo.
     1204    assign
     1205    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1206                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1207                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1208                             ), par-rs-radio-buttons, par-delim
     1209                           )
     1210    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1211    .
     1212   return v-result-label.
     1213   end function.
     1214   FUNCTION mixlist returns character
     1215   (
     1216    input parfirst-list  as character
     1217    ,input parsecond-list as character
     1218    ,input pardelim       as character
     1219    ,input pardelim-result as character ) :
     1220     if pardelim = ""
     1221     or pardelim = ?
     1222     then do:
     1223       assign
     1224         pardelim = ","
     1225       .
     1226     end.
     1227     def var ind as integer no-undo .
     1228     def var v-elem1 as character no-undo .
     1229     def var v-elem2 as character no-undo .
     1230     def var v-result-list as character no-undo init "".
     1231     do ind = 1 to num-entries(parfirst-list, pardelim)
     1232     :
     1233       assign
     1234         v-elem1 = entry(ind, parfirst-list, pardelim)
     1235         v-elem2 = entry(ind, parsecond-list, pardelim)
     1236       .
     1237         assign
     1238           v-result-list = v-result-list
     1239                         + (if v-result-list > "" then pardelim-result else "")
     1240                         + v-elem1 + pardelim-result + v-elem2
     1241         .
     1242     end.
     1243     return v-result-list .
     1244   END FUNCTION.
     1245   DEFINE VARIABLE RS-method AS INTEGER
     1246        VIEW-AS RADIO-SET VERTICAL
     1247        RADIO-BUTTONS
     1248             "Включенные в отчет о продаже", 1,
     1249   "Не включенные в отчет о продаже", 2,
     1250   "Все чеки", 3
     1251        SIZE 34.5 BY 2.79 NO-UNDO.
     1252   DEFINE FRAME F-Main
     1253        RS-method AT ROW 2.38 COL 4.88 NO-LABEL
     1254        "Чеки" VIEW-AS TEXT
     1255             SIZE 16.38 BY .88 AT ROW 1.38 COL 5.38
     1256             FGCOLOR 4
     1257       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1258            SIDE-LABELS NO-UNDERLINE THREE-D
     1259            AT COL 1 ROW 1
     1260            SIZE 43 BY 9.46.
     1261   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1262   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1263   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1264   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1265   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1266   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1267   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1268   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1269       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1270   RUN ensure-broker.
     1271   THIS-PROCEDURE:ADM-DATA =
     1272        'ADM1.1~`':U +
     1273        'SmartObject~`':U +
     1274        'FRAME~`':U +
     1275        'NO ~`':U +
     1276        '~`':U +
     1277        '~`':U +
     1278        '~`':U +
     1279        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1280           + "~`":U +
     1281        'Layout,Hide-on-Init~`':U +
     1282        '~`':U +
     1283        '~`':U +
     1284        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1285        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1286            THEN "^^":U
     1287        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1288             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1289   PROCEDURE adm-apply-entry :
     1290     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1291   END PROCEDURE.
     1292   PROCEDURE adm-destroy :
     1293    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1294   END PROCEDURE.
     1295   PROCEDURE adm-disable :
     1296       DISABLE RS-method WITH FRAME F-Main.
     1297       RUN dispatch ('disable-fields':U).
     1298       RUN set-attribute-list ('ENABLED=no':U).
     1299       RETURN.
     1300   END PROCEDURE.
     1301   PROCEDURE adm-edit-attribute-list :
     1302         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1303         RETURN.
     1304   END PROCEDURE.
     1305   PROCEDURE adm-enable :
     1306       ENABLE UNLESS-HIDDEN RS-method WITH FRAME F-Main.
     1307       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1308       RUN set-attribute-list ('ENABLED=yes':U).
     1309       RETURN.
     1310   END PROCEDURE.
     1311   PROCEDURE adm-exit :
     1312        RUN notify ('exit':U).
     1313     RETURN.
     1314   END PROCEDURE.
     1315   PROCEDURE adm-hide :
     1316     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1317   END PROCEDURE.
     1318   PROCEDURE adm-initialize :
     1319     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1320   END PROCEDURE.
     1321   PROCEDURE adm-show-errors :
     1322       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1323       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1324           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1325       END.
     1326       RETURN.
     1327   END PROCEDURE.
     1328   PROCEDURE adm-UIB-mode :
     1329     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1330   END PROCEDURE.
     1331   PROCEDURE adm-view :
     1332     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1333   END PROCEDURE.
     1334   PROCEDURE dispatch :
     1335       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1336       RUN broker-dispatch IN adm-broker-hdl
     1337           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1338       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1339   END PROCEDURE.
     1340   PROCEDURE ensure-broker :
     1341   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1342   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1343   DO:
     1344       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1345       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1346   END.
     1347   END PROCEDURE.
     1348   PROCEDURE get-attribute :
     1349     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1350     RUN broker-get-attribute IN adm-broker-hdl
     1351         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1352     RETURN RETURN-VALUE.
     1353   END PROCEDURE.
     1354   PROCEDURE get-attribute-list :
     1355     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1356     RUN broker-get-attribute-list IN adm-broker-hdl
     1357         (INPUT THIS-PROCEDURE,
     1358          INPUT ?,
     1359          OUTPUT p-attr-list) NO-ERROR.
     1360     RETURN.
     1361   END PROCEDURE.
     1362   PROCEDURE new-state :
     1363     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1364     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1365     RETURN.
     1366   END PROCEDURE.
     1367   PROCEDURE notify :
     1368     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1369     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1370     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1371         RETURN "ADM-ERROR":U.
     1372     RETURN.
     1373   END PROCEDURE.
     1374   PROCEDURE set-attribute-list :
     1375     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1376     RUN ensure-broker.
     1377     RUN broker-set-attribute-list IN adm-broker-hdl
     1378         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1379     RETURN.
     1380   END PROCEDURE.
     1381   PROCEDURE set-position :
     1382       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1383       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1384       IF VALID-HANDLE(adm-object-hdl) THEN
     1385       DO:
     1386           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1387           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1388           DO:
     1389             IF p-row = 0 THEN p-row =
     1390               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1391             IF p-col = 0 THEN p-col =
     1392               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1393           END.
     1394           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1395           DO:
     1396             parent-hdl = adm-object-hdl:PARENT.
     1397             IF p-row = 0 THEN p-row =
     1398               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1399                 parent-hdl:ROW.
     1400             IF p-col = 0 THEN p-col =
     1401               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1402                 parent-hdl:COL.
     1403           END.
     1404           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1405           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1406         ASSIGN adm-object-hdl:ROW    =   p-row
     1407                adm-object-hdl:COLUMN =   p-col.
     1408       END.
     1409       RETURN.
     1410   END PROCEDURE.
     1411   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1412       STRING(adm-object-hdl)).
     1413   PAUSE 0 BEFORE-HIDE.
     1414   PROCEDURE adm-change-page :
     1415     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1416     END PROCEDURE.
     1417   PROCEDURE delete-page :
     1418     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1419     RUN broker-delete-page IN adm-broker-hdl
     1420         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1421     END PROCEDURE.
     1422   PROCEDURE init-object :
     1423     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1424     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1425     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1426     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1427     RUN broker-init-object IN adm-broker-hdl
     1428         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1429          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1430     RETURN.
     1431   END PROCEDURE.
     1432   PROCEDURE init-pages :
     1433     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1434     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1435         INPUT p-page-list) NO-ERROR.
     1436     END PROCEDURE.
     1437   PROCEDURE select-page :
     1438     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1439     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1440         INPUT p-page#) NO-ERROR.
     1441     END PROCEDURE.
     1442   PROCEDURE view-page :
     1443     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1444     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1445         INPUT p-page#).
     1446     END PROCEDURE.
     1447   if not this-procedure :persistent
     1448   then do:
     1449     message
     1450       vss-workfile vss-revision vss-description skip
     1451       "Ошибка при запуске процедуры" skip
     1452       "Данную процедуру следует запускать только с параметром persistent" skip
     1453       view-as alert-box error .
     1454     undo, return error .
     1455   end.
     1456   PROCEDURE adm-create-objects :
     1457   END PROCEDURE.
     1458   PROCEDURE adm-row-available :
     1459     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1460     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1461     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1462     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1463     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1464     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1465     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1466     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1467     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1468     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1469     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1470     IF adm-updating-record THEN RETURN.
     1471     RUN get-attribute ('FIELDS-ENABLED':U).
     1472     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1473     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1474         OUTPUT link-handle) NO-ERROR.
     1475     IF link-handle = "":U THEN
     1476         RETURN.
     1477     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1478     IF NUM-ENTRIES(link-handle) > 1 THEN
     1479         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1480             "encountered more than one RECORD-SOURCE.":U SKIP
     1481             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1482                VIEW-AS ALERT-BOX ERROR.
     1483     RUN get-attribute ('Key-Name':U).
     1484     key-name = RETURN-VALUE.
     1485     IF key-name = "":U THEN key-name = ?.
     1486     IF key-name NE ? THEN DO:
     1487       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1488         NO-ERROR.
     1489       IF key-value NE ? THEN
     1490         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1491     END.
     1492   IF VALID-HANDLE (adm-object-hdl) THEN
     1493       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1494   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1495   END PROCEDURE.
     1496   PROCEDURE disable_UI :
     1497     HIDE FRAME F-Main.
     1498     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1499   END PROCEDURE.
     1500   PROCEDURE enable_UI :
     1501     DISPLAY RS-method
     1502         WITH FRAME F-Main.
     1503     ENABLE RS-method
     1504         WITH FRAME F-Main.
     1505   END PROCEDURE.
     1506   PROCEDURE My-report :
     1507   define buffer buf_chk-doc for ub.chk-doc.
     1508   define buffer buf_chk-gds for ub.chk-gds.
     1509   define buffer buf_goods for ub.goods.
     1510   define buffer buf_bar-code for ub.bar-code.
     1511   run my-var.
     1512   run waitfram-show in this-procedure ("Ждите...").
     1513   run no-benq(OUTPUT found).
     1514   if not found then do:
     1515       message "Не было никакой выручки  в течение заданного Вами периода времени." view-as alert-box.
     1516       run waitfram-hide in this-procedure .
     1517       return.
     1518   end.
     1519   define variable g#log  as logical no-undo .
     1520   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1521   define variable ReportFileName as character no-undo initial "report".
     1522   define variable was_OK_opened  as logical   no-undo.
     1523   system-dialog get-file          ReportFileName
     1524                 title             "Укажите путь"
     1525                 filters           "Текстовый файл (*.txt)" "*.txt"
     1526                 ask-overwrite
     1527                 create-test-file
     1528                 save-as
     1529                 use-filename
     1530                 default-extension "txt"
     1531                 update            was_OK_opened.
     1532   if was_OK_opened <> yes then do: return "Cancel". end.
     1533   assign ReportFileName = trim( string( ReportFileName ) ).
     1534   output stream PrnLibStream to value ( ReportFileName ) page-size 0  .
     1535   put stream PrnLibStream unformatted
     1536   ReportName skip
     1537   str1 skip
     1538   str4 skip
     1539   REPORTHeader skip
     1540   "N чека" CHR(9)
     1541   "Дата чека" CHR(9) 'Артикул':U format "X(16)" CHR(9)
     1542   "Произ-ль" CHR(9) 'название':U skip.
     1543   FOR EACH obj-list No-LOCK:
     1544   _chk-gds:
     1545     FOR EACH buf_chk-doc No-LOCK WHERE
     1546              buf_chk-doc.obj-type = obj-list.obj-type AND
     1547              buf_chk-doc.obj-code = obj-list.obj-code AND
     1548              buf_chk-doc.chk-date >= X-date-start AND
     1549              buf_chk-doc.chk-date <= X-date-end:
     1550       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1551       ACCUMULATE buf_chk-doc.doc-code (COUNT).
     1552       IF (ACCUM COUNT buf_chk-doc.doc-code) MODULO 50 = 0 then
     1553       run waitfram-show in this-procedure ("Ждите..." + "Обработано " +
     1554                      string(ACCUM COUNT buf_chk-doc.doc-code) + " чеков").
     1555       IF RS-method = 1 and buf_chk-doc.out-code = ? then NEXT _chk-gds.
     1556       IF RS-method = 2 and buf_chk-doc.out-code <> ? then NEXT _chk-gds.
     1557       find first buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code no-lock no-error.
     1558       if can-find (FIRST for-gds where
     1559                          for-gds.doc-code = buf_chk-doc.doc-code AND
     1560                          recid(for-gds) <> recid(buf_chk-gds) AND
     1561                          for-gds.b-code <> buf_chk-gds.b-code No-LOCK) then next.
     1562       find first buf_bar-code where
     1563                  buf_bar-code.b-code = buf_chk-gds.b-code no-lock no-error.
     1564       find first buf_goods where
     1565                  buf_goods.gds-code = buf_bar-code .gds-code NO-ERROR.
     1566       put stream PrnLibStream unformatted
     1567       buf_chk-doc.doc-code CHR(9)
     1568       buf_chk-doc.chk-date CHR(9)
     1569       buf_goods.artic format "x(16)" CHR(9)
     1570       buf_goods.prod-code CHR(9)
     1571       buf_goods.gds-name skip.
     1572     END.
     1573   END.
     1574   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   output stream PrnLibStream CLOSE.
     1576   message "Отчет выведен в файл:" SKIP
     1577                   ReportFileName
     1578                   view-as alert-box INFORMATION buttons OK TITLE " ".
     1579   run waitfram-hide in this-procedure .
     1580   END PROCEDURE.
     1581   PROCEDURE My-var :
     1582   ASSIGN  frame F-Main
     1583   RS-METHOD
     1584   .
     1585   assign
     1586   Reportname = "СПИСОК ЧЕКОВ С ОДНОЙ ТОВАРНОЙ СТРОКОЙ"
     1587   ReportHeader = radio-label(string(RS-method), RS-method:radio-buttons)
     1588                  .
     1589   END PROCEDURE.
     1590   PROCEDURE send-records :
     1591   END PROCEDURE.
     1592   PROCEDURE state-changed :
     1593     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1594     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1595   END PROCEDURE.
