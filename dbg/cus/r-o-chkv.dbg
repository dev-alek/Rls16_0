     1510     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1511     define variable v-cntxt-is-admin      as logical   no-undo .
     1512   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513     run mainmenu_getcntxt in my-handle
     1514       (output v-cntxt-db-num
     1515       ,output v-cntxt-userid
     1516       ,output v-cntxt-level
     1517       ,output v-cntxt-host-code-obj
     1518       ,output v-cntxt-obj-type
     1519       ,output v-cntxt-obj-code
     1520       ,output v-cntxt-db-num-obj
     1521       ,output v-cntxt-is-admin
     1522       ) .
     1523   define variable base-type as character no-undo .
     1524   define variable base-code as integer   no-undo .
     1525   define variable g#report-num as integer   no-undo .
     1526   define variable g#gds-engl as logical   no-undo .
     1527   define variable vv-exch-rate  as decimal   no-undo .
     1528   define variable vv-exch-scale as decimal   no-undo .
     1529   define variable v-cntxt-host-name-obj as character no-undo .
     1530   if v-cntxt-level = 'object':U then do:
     1531   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1533     (input  v-cntxt-obj-type
     1534     ,input  v-cntxt-obj-code
     1535     ,output v-cntxt-host-code-obj
     1536     ,output v-cntxt-host-name-obj
     1537     )  .
     1538   end.
     1539   if v-cntxt-level = 'firm':U then do:
     1540     find first ub.clients no-lock where
     1541                ub.clients.obj-type = 'орг':U and
     1542                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
     1543   if error-status :error then v-cntxt-host-name-obj = ? .
     1544      else v-cntxt-host-name-obj = ub.clients.obj-name.
     1545   end.
     1546   if v-cntxt-level = 'object':U
     1547   or v-cntxt-level = 'firm':U
     1548   then do:
     1549   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1550   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1551     (input  v-cntxt-host-code-obj
     1552     ,output base-code
     1553     )  .
     1554   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1555   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1556     (input  base-code
     1557     ,input  today
     1558     ,output vv-exch-rate
     1559     ,output vv-exch-scale
     1560     ,output base-type
     1561     )  .
     1562   end.
     1563   run get-report-num in my-handle ( output g#report-num ).
     1564   run get-gds-engl in my-handle ( output g#gds-engl ) .
     1565   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1566   procedure factord :
     1567     define input  parameter p-fact-date            as date    no-undo .
     1568     define input  parameter p-fact-time            as integer no-undo .
     1569     define input  parameter p-fact-num             as integer no-undo .
     1570     define input  parameter p-shift-date           as date    no-undo .
     1571     define input  parameter p-shift-num            as integer no-undo .
     1572     define input  parameter p-shift-on             as logical no-undo .
     1573     define output parameter p-fact-order           as decimal no-undo .
     1574     define output parameter p-shift-end-fact-order as decimal no-undo .
     1575     define output parameter p-day-end-fact-order   as decimal no-undo .
     1576     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1577     if p-fact-date = ?
     1578     then do:
     1579       return error "Не указана фактическая дата" .
     1580     end.
     1581     define variable v-fact-date-num as integer no-undo .
     1582     assign
     1583       v-fact-date-num = integer(p-fact-date)
     1584     .
     1585     if p-fact-num = ?
     1586     or p-fact-num = 0
     1587     then do:
     1588       return error "Не задан p-fact-num " + string(p-fact-num) .
     1589     end.
     1590     if p-fact-num < 0
     1591     then do:
     1592       return error "Отрицательный fact-num " + string(p-fact-num) .
     1593     end.
     1594     if p-fact-num >= 100000000
     1595     then do:
     1596       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1597     end.
     1598     if p-shift-on = true
     1599     then do:
     1600       if p-shift-date = ?
     1601       then do:
     1602         return error "Не задана дата смены" .
     1603       end.
     1604       if p-shift-num = ?
     1605       or p-shift-num = 0
     1606       then do:
     1607         return error "Не задан номер смены" .
     1608       end.
     1609     end.
     1610     else do:
     1611       assign
     1612         p-shift-date = p-fact-date
     1613         p-shift-num  = 24
     1614       .
     1615     end.
     1616     define variable v-shift-offset as integer no-undo .
     1617     if p-shift-date = p-fact-date
     1618     then do:
     1619       assign
     1620         v-shift-offset = 1
     1621       .
     1622     end.
     1623     if p-shift-date < p-fact-date
     1624     then do:
     1625       assign
     1626         v-shift-offset = 0
     1627       .
     1628     end.
     1629     if p-shift-date > p-fact-date
     1630     then do:
     1631       message
     1632         vss-workfile vss-revision vss-description skip
     1633         "Неправильная дата закрытия смены" skip
     1634         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1635         view-as alert-box error .
     1636       undo, return error
     1637         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1638           ,string(p-fact-date, '99/99/9999':U)
     1639           ,string(p-shift-date, '99/99/9999':U)
     1640           )
     1641       .
     1642     end.
     1643     if p-shift-num < 1
     1644     or p-shift-num > 24
     1645     then do:
     1646       message
     1647         vss-workfile vss-revision vss-description skip
     1648         "Неправильный номер смены" skip
     1649         "p-shift-num" p-shift-num skip
     1650         view-as alert-box error .
     1651       undo, return error return-value .
     1652     end.
     1653     assign
     1654       p-fact-order           = v-fact-date-num
     1655                              + v-shift-offset * 0.5
     1656                              + p-shift-num    * 0.02 - 0.01
     1657                              + p-fact-num     * 0.0000000001
     1658       p-shift-end-fact-order = v-fact-date-num
     1659                              + v-shift-offset * 0.5
     1660                              + p-shift-num    * 0.02
     1661       p-day-end-fact-order   = v-fact-date-num
     1662                              + 0.99
     1663     .
     1664     if p-fact-order           <= v-fact-date-num
     1665     or p-shift-end-fact-order <= v-fact-date-num
     1666     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1667     or p-shift-end-fact-order >= p-day-end-fact-order
     1668     then do:
     1669       message
     1670         vss-workfile vss-revision vss-description skip
     1671         "Внутренняя ошибка при генерации фактического номера" skip
     1672         "p-fact-date"            p-fact-date            skip
     1673         "p-fact-time"            p-fact-time            skip
     1674         "p-fact-num"             p-fact-num             skip
     1675         "p-shift-date"           p-shift-date           skip
     1676         "p-shift-num"            p-shift-num            skip
     1677         "p-shift-on"             p-shift-on             skip
     1678         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1679         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1680         "v-fact-date-num"        v-fact-date-num        skip
     1681         view-as alert-box error .
     1682       undo, return error return-value .
     1683     end.
     1684   end procedure.
     1685   procedure day-begin-fact-order :
     1686     define input  parameter p-fact-date            as date    no-undo .
     1687     define output parameter p-day-begin-fact-order as decimal no-undo .
     1688     do
     1689     on error undo, return error return-value
     1690     :
     1691       if p-fact-date = ?
     1692       then do:
     1693         assign
     1694           p-day-begin-fact-order = 0
     1695         .
     1696       end.
     1697       else do:
     1698         assign
     1699           p-day-begin-fact-order = integer(p-fact-date)
     1700         .
     1701       end.
     1702     end.
     1703   end procedure.
     1704   procedure factord-max-fact-order :
     1705     define output parameter p-max-fact-order as decimal   no-undo .
     1706     do
     1707     on error undo, return error return-value
     1708     :
     1709       run day-begin-fact-order in this-procedure
     1710         (input  date(1, 1, 5000)
     1711         ,output p-max-fact-order
     1712         ) .
     1713     end.
     1714   end procedure.
     1715   procedure factord-cut-archive :
     1716     define input  parameter p-obj-type             as character no-undo .
     1717     define input  parameter p-obj-code             as integer   no-undo .
     1718     define input  parameter p-fact-date            as date      no-undo .
     1719     define output parameter p-shift-on             as logical   no-undo .
     1720     define output parameter p-shift-date           as date      no-undo .
     1721     define output parameter p-shift-num            as integer   no-undo .
     1722     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1723     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1724     define variable v-fact-order as decimal   no-undo .
     1725     define buffer buf_shift-obj for ub.shift-obj .
     1726     do
     1727     on error undo, return error return-value
     1728     :
     1729   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1731     (input  p-obj-type
     1732     ,input  p-obj-code
     1733     ,input  'shift-on=request'
     1734     ,output p-shift-on
     1735     ) no-error .
     1736       if error-status :error
     1737       then do:
     1738         message
     1739           vss-workfile vss-revision vss-description skip
     1740           "Ошибка при определении атрибута объекта" skip
     1741           "Объект" p-obj-type p-obj-code skip
     1742           error-status :get-message(1) skip
     1743           return-value skip
     1744           view-as alert-box error .
     1745         undo, return error return-value .
     1746       end.
     1747       if p-shift-on = false
     1748       then do:
     1749         assign
     1750           p-shift-date               = ?
     1751           p-shift-num                = 0
     1752         .
     1753       end.
     1754       else do:
     1755         find first buf_shift-obj share-lock
     1756           where buf_shift-obj.obj-type   = p-obj-type
     1757             and buf_shift-obj.obj-code   = p-obj-code
     1758             and buf_shift-obj.shift-date > p-fact-date
     1759           use-index pi
     1760           no-error .
     1761         if not available buf_shift-obj
     1762         or buf_shift-obj.status_ <> 'зкр':U
     1763         then do:
     1764           message
     1765             vss-workfile vss-revision vss-description skip
     1766             "Невозможно вычислить последнюю смену" skip
     1767             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1768             "Объект" p-obj-type p-obj-code skip
     1769             "Дата" p-fact-date skip
     1770             view-as alert-box error .
     1771           undo, return error return-value .
     1772         end.
     1773         find last buf_shift-obj share-lock
     1774           where buf_shift-obj.obj-type = p-obj-type
     1775             and buf_shift-obj.obj-code = p-obj-code
     1776             and buf_shift-obj.shift-date <= p-fact-date
     1777           use-index pi
     1778           no-error .
     1779         if available buf_shift-obj
     1780         then do:
     1781           if  buf_shift-obj.status_ = 'зкр':U
     1782           then do:
     1783             assign
     1784               p-shift-date = buf_shift-obj.shift-date
     1785               p-shift-num  = buf_shift-obj.shift-num
     1786             .
     1787           end.
     1788           else do:
     1789             message
     1790               vss-workfile vss-revision vss-description skip
     1791               "Невозможно вычислить последнюю смену" skip
     1792               "Статус смены отличен от статуса" 'зкр':U skip
     1793               "Объект" p-obj-type p-obj-code skip
     1794               "Дата" p-fact-date skip
     1795               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1796               view-as alert-box error .
     1797             undo, return error return-value .
     1798           end.
     1799         end.
     1800         else do:
     1801           assign
     1802             p-shift-date = p-fact-date - 1
     1803             p-shift-num  = 1
     1804           .
     1805         end.
     1806       end.
     1807       run factord in this-procedure
     1808         (input  p-fact-date
     1809         ,input  1
     1810         ,input  1
     1811         ,input  p-shift-date
     1812         ,input  p-shift-num
     1813         ,input  p-shift-on
     1814         ,output v-fact-order
     1815         ,output p-shift-end-fact-order
     1816         ,output p-day-end-fact-order
     1817         ) no-error .
     1818       if error-status :error
     1819       then do:
     1820         message
     1821           vss-workfile vss-revision vss-description skip
     1822           "Ошибка при вызове процедуры factord"
     1823           error-status :get-message(1) skip
     1824           return-value skip
     1825           view-as alert-box error .
     1826         undo, return error return-value .
     1827       end.
     1828     end.
     1829   end procedure.
     1830   procedure factord-lock-shift :
     1831     define input  parameter p-obj-type  as character no-undo .
     1832     define input  parameter p-obj-code  as integer   no-undo .
     1833     define input  parameter p-fact-date as date      no-undo .
     1834     define parameter buffer buf_shift-obj for ub.shift-obj .
     1835     define variable v-shift-on      as logical   no-undo .
     1836     define variable v-extra-message as character no-undo .
     1837     define variable v-error as character no-undo .
     1838     do
     1839     on error undo, return error return-value
     1840     :
     1841   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1842   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1843     (input  p-obj-type
     1844     ,input  p-obj-code
     1845     ,input  'shift-on=request'
     1846     ,output v-shift-on
     1847     ) no-error .
     1848       if error-status :error
     1849       then do:
     1850         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1851         undo, return error v-error .
     1852       end.
     1853       if v-shift-on = true
     1854       then do:
     1855         find first buf_shift-obj share-lock
     1856           where buf_shift-obj.obj-type   = p-obj-type
     1857             and buf_shift-obj.obj-code   = p-obj-code
     1858             and buf_shift-obj.shift-date > p-fact-date
     1859           use-index pi
     1860           no-error .
     1861         if not available buf_shift-obj
     1862         or buf_shift-obj.status_ <> 'зкр':U
     1863         then do:
     1864           find last buf_shift-obj
     1865             where buf_shift-obj.obj-type = p-obj-type
     1866               and buf_shift-obj.obj-code = p-obj-code
     1867               and buf_shift-obj.status_  = 'зкр':U
     1868             use-index stts
     1869             no-error .
     1870           if available buf_shift-obj
     1871           then do:
     1872             assign
     1873               v-extra-message =
     1874                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1875                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1876                               )
     1877             .
     1878           end.
     1879           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1880           undo, return error v-error .
     1881         end.
     1882       end.
     1883     end.
     1884   end procedure.
     1885   procedure factord-end-day :
     1886     define input  parameter p-fact-date            as date    no-undo .
     1887     define output parameter p-day-end-fact-order   as decimal no-undo .
     1888     do
     1889     on error undo, return error return-value
     1890     :
     1891       if p-fact-date = ?
     1892       then do:
     1893         return error "Не указана фактическая дата" .
     1894       end.
     1895       assign
     1896         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1897       .
     1898     end.
     1899   end procedure.
     1900   procedure factord-to-date :
     1901     define input  parameter p-fact-order as decimal no-undo .
     1902     define output parameter p-fact-date  as date    no-undo .
     1903     define variable v-ref-date  as date      no-undo .
     1904     define variable v-ref-delta as integer   no-undo .
     1905     do
     1906     on error undo, return error return-value
     1907     :
     1908       if p-fact-order = ?
     1909       or p-fact-order = 0
     1910       then do:
     1911         return error "Не указан fact-order" .
     1912       end.
     1913       assign
     1914         v-ref-date  = date(1, 1, 2000)
     1915       .
     1916       assign
     1917         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1918       .
     1919       assign
     1920         p-fact-date = v-ref-date + v-ref-delta
     1921       .
     1922     end.
     1923   end procedure.
     1924   procedure factord-to-fact-num :
     1925     define input  parameter p-fact-order as decimal no-undo .
     1926     define output parameter p-fact-num   as integer no-undo .
     1927     define variable v-fact-order-trunc as decimal no-undo .
     1928     do
     1929     on error undo, return error return-value
     1930     :
     1931       if p-fact-order = ?
     1932       or p-fact-order = 0
     1933       then do:
     1934         return error "Не указан fact-order" .
     1935       end.
     1936       assign
     1937        v-fact-order-trunc = truncate(p-fact-order, 2)
     1938       .
     1939       assign
     1940         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1941       .
     1942     end.
     1943   end procedure.
     1944   procedure factord-to-shift-num :
     1945     define input  parameter p-fact-order as decimal no-undo .
     1946     define output parameter p-shift-num   as integer no-undo .
     1947     define variable  p-shift-numd  as decimal   no-undo .
     1948     define variable v-fact-order-trunc as decimal no-undo .
     1949     do
     1950     on error undo, return error return-value
     1951     :
     1952       if p-fact-order = ?
     1953       or p-fact-order = 0
     1954       then do:
     1955         return error "Не указан fact-order" .
     1956       end.
     1957       assign
     1958        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1959       .
     1960       if v-fact-order-trunc < 0.5 then do:
     1961         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1962       end.
     1963       assign
     1964         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1965         .
     1966        assign
     1967         p-shift-num = truncate (p-shift-numd , 0)
     1968       .
     1969     end.
     1970   end procedure.
     1971   define temp-table tt-temp no-undo
     1972   field pay-desk    as integer
     1973   field sum-rubl-ost    as decimal
     1974   field cashier as integer
     1975   field psn-code as integer
     1976   field psn-name    as char
     1977   field doc-code    as character
     1978   field doc-type    as character
     1979   field fact-date   as date
     1980   field fact-time   as char
     1981   field sum-rubl    as decimal
     1982   field obj-code    as int
     1983   field obj-type    as char
     1984   field bef-vid     as char
     1985   field aft-vid     as char
     1986   index pi
     1987     obj-code
     1988     obj-type
     1989     pay-desk
     1990     cashier
     1991   index pi-2
     1992     pay-desk
     1993   .
     1994   define buffer kass-f for tt-temp  .
     1995   define buffer inkass for tt-temp  .
     1996   define buffer perev  for tt-temp  .
     1997   define buffer kass-d for tt-temp  .
     1998   define buffer kass   for tt-temp  .
