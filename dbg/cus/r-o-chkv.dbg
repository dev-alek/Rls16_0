     2066   define variable v-shap as character no-undo .
     2067   FUNCTION get-cash-pay RETURNS CHARACTER
     2068     ( input parpay-code as integer, parcurr-code as integer ) :
     2069   DEFINE VARIABLE varwth-code like ub.wealth.wth-code no-undo.
     2070   DEFINE VARIABLE varwth-name like ub.wealth.wth-name no-undo.
     2071   FIND FIRST ub.cash-pay No-LOCK WHERE
     2072                       ub.cash-pay.cdpay-code = parpay-code AND
     2073                       ub.cash-pay.curr-code = parcurr-code No-ERROR.
     2074   if available cash-pay then do:
     2075     varwth-code = ub.cash-pay.wth-code.
     2076     if varwth-code > 0 then do:
     2077         FIND FIRST ub.wealth No-LOCK WHERE
     2078                         ub.wealth.wth-code = varwth-code No-error.
     2079         if available ub.wealth then do:
     2080           assign
     2081           varwth-code =ub.wealth.wth-code
     2082           varwth-name = ub.wealth.wth-name
     2083           .
     2084           return ub.cash-pay.obj-name.
     2085         end.
     2086         else do:
     2087           assign
     2088           varwth-code = 0
     2089           varwth-name = "Неопознанная МЦ"
     2090           .
     2091           RETURN ub.cash-pay.obj-name.
     2092         end.
     2093     end.
     2094     else do:
     2095       assign
     2096       varwth-code = 0
     2097       varwth-name = "Неопознанная МЦ"
     2098       .
     2099       RETURN ub.cash-pay.obj-name .
     2100     end.
     2101   end.
     2102   assign
     2103   varwth-code = 0
     2104   varwth-name = '':U
     2105   .
     2106   RETURN "Неопознанная оплата".
     2107   END FUNCTION.
     2108   DEFINE FRAME plan-menu
     2109       HEADER
     2110       string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 80 format "X(13)" SKIP
     2111       UndLine format "X(80)" AT 1
     2112       with width 235 down stream-io use-text NO-UNDERLINE  NO-BOX no-labels.
     2113     if session:set-wait-state("compiler") then.
     2114   output STREAM OutStream to value( string( session:temp-directory +
     2115                                        "rpt" + string( g#report-num ) ) )
     2116                                        page-size  value(43) .
     2117     define variable v-prn0 as character no-undo .
     2118     assign
     2119       Line    = fill("-", 230)
     2120       UndLine = fill("_", 230)
     2121       LineBuf = fill("_", 240)
     2122     .
     2123   define variable v-is-base as logical no-undo .
     2124   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2125   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     2126     (output v-is-base
     2127     )  .
     2128   if v-is-base = true then do:
     2129   end.
     2130   else do:
     2131   end.
     2132   v-ind = 0    .
     2133   FORM with frame plan-menu .
     2134       Output stream Macr_Excel  close .
     2135       num#str# = 0 .
     2136       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     2137       output stream macr_excel to value(v-file-name)   .
     2138       v-ind = v-ind + 1.
     2139     find clients      where clients.obj-type     = 'орг':U            and clients.obj-code      = v-cntxt-host-code-obj no-lock .
     2140     run PrintTitul in this-procedure .
     2141     run make-tt.
     2142     for each obj-list :
     2143         run print-obj.
     2144             run print-line .
     2145         run print-obj-itog.
     2146     end.
     2147     run print-all-itog in this-procedure .
     2148     run on-same-page in this-procedure (input 3) .
     2149     run PrintPodval in this-procedure .
     2150     run paramls-write in this-procedure
     2151       ( input "file"
     2152       , input string(v-ind)
     2153       , input v-file-name
     2154       ) .
     2155        page stream OutStream .
     2156   HIDE STREAM OutStream FRAME plan-menu.
     2157   HIDE stream OutStream FRAME BottomFrame .
     2158   HIDE stream OutStream FRAME BottomFrame2 .
     2159   output stream OutStream CLOSE .
     2160   Output stream Macr_Excel  close .
     2161   if mFrameView
     2162   then do:
     2163      HIDE FRAME InfoFrame.
     2164   end.
     2165       run paramls-write in this-procedure
     2166           (input "charcol"
     2167           ,input ""
     2168           ,input "1,3,4,6,7,8,9,10"
     2169           ) .
     2170     run end-proc .
     2171     define variable v-user-action as character no-undo .
     2172     define variable v-printed as logical   no-undo .
     2173     define variable DisabledOptions as integer   no-undo .
     2174     DisabledOptions = 8 .
     2175     run gbl/prnfilen.w
     2176       (  input  ""
     2177        , input  DisabledOptions
     2178        , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2179        , input  7
     2180        , output v-user-action
     2181        , output v-printed
     2182       )
     2183       .
     2184   procedure pl :
     2185     do
     2186     on error undo, return error return-value
     2187     :
     2188     assign
     2189        Lines_Counter = Lines_Counter + 1
     2190       .
     2191     if line-counter( OutStream ) + 2 > page-size( OutStream ) then do:
     2192        run p-line.
     2193        page stream OutStream.
     2194        PUT STREAM OutStream UNFORMATTED
     2195            string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 100 format "X(13)" SKIP .
     2196        run print-1.
     2197        end.
     2198     if line-counter( OutStream ) < Tmp_Counter then
     2199       assign
     2200       .
     2201     assign
     2202       Tmp_Counter  = line-counter( OutStream )
     2203       num-ln = num-ln + 1
     2204     .
     2205     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     2206     end.
     2207   end procedure.
     2208   procedure print-line :
     2209   do on error undo, return error return-value :
     2210   define variable v-1 as char  no-undo .
     2211   define variable v-2 as char  no-undo .
     2212   define variable v-3 as char  no-undo .
     2213   define variable max-i as integer   no-undo .
     2214   define variable ii as integer   no-undo .
     2215   for each kass where
     2216            kass.obj-type = obj-list.obj-type and
     2217            kass.obj-code = obj-list.obj-code
     2218            break by kass.pay-desk :
     2219       if first-of ( kass.pay-desk ) then do:
     2220           put stream outstream unformatted
     2221               sym1                       format "x(1)" space(0)
     2222               string(kass.pay-desk)      format "x(7)"
     2223               sym2                       format "x(1)" space(0)
     2224               string(kass.sum-rubl-ost)     format "x(14)"
     2225               .
     2226       num#col# = 1.
     2227       num#str# = num#str# + 1.
     2228       run macr_excel_char ( string(kass.pay-desk)    , num#str# , 1   ) . assign    num#col# = 2.
     2229       run macr_excel_dec  (        kass.sum-rubl-ost , num#str# , 2   ) . assign    num#col# = 3 .
     2230           for each prsn where prsn.pay-desk = kass.pay-desk and
     2231                               prsn.obj-type = obj-list.obj-type and
     2232                               prsn.obj-code = obj-list.obj-code
     2233                               break by prsn.cashier :
     2234               if first-of(prsn.cashier) then do:
     2235                 put stream outstream unformatted
     2236                     sym1                          format "x(1)" space(0)
     2237                     (if prsn.psn-name = "" then  string(prsn.psn-code) else string(prsn.psn-name))        format "X(16)" at 25
     2238                     .
     2239                   run macr_excel_char (( if prsn.psn-name = "" then  "-"  else string(prsn.psn-name))   , num#str# , 3   ) . assign    num#col# = 4 .
     2240                   v-1 = "".
     2241                   v-2 = "".
     2242                   v-3 = "".
     2243                   for each tt-temp where
     2244                           tt-temp.cashier  = prsn.cashier and
     2245                           tt-temp.pay-desk = kass.pay-desk and
     2246                           tt-temp.obj-type = obj-list.obj-type and
     2247                           tt-temp.obj-code = obj-list.obj-code
     2248                           break by tt-temp.fact-date by tt-temp.fact-time
     2249                           :
     2250                             case tt-temp.doc-type :
     2251                                 when string('3':U)  then do:
     2252                                   v-1 = v-1 + tt-temp.doc-code + "," .
     2253                                 end.
     2254                                 when string('2':U)  then do:
     2255                                   v-2 = v-2  + tt-temp.doc-code + "," .
     2256                                 end.
     2257                                 when string('4':U)  then do:
     2258                                   v-3 = v-3  + tt-temp.doc-code + "," .
     2259                                 end.
     2260                             end case.
     2261                   end.
     2262                   v-1 = trim(v-1,",") .
     2263                   v-2 = trim(v-2,",") .
     2264                   v-3 = trim(v-3,",") .
     2265   define variable v-doc1 as character no-undo .
     2266   define variable v-doc2 as character no-undo .
     2267   define variable v-doc3 as character no-undo .
     2268   define variable v-kass-f-1  as character no-undo .
     2269   define variable v-kass-f-2  as character no-undo .
     2270   define variable v-inkass-1  as character no-undo .
     2271   define variable v-inkass-2  as character no-undo .
     2272   define variable v-tr-s  as character no-undo .
     2273   define variable v-tr-p  as character no-undo .
     2274   define variable v-tr-1  as character no-undo .
     2275   define variable v-tr-2  as character no-undo .
     2276   assign
     2277     v-tr-1 = ""
     2278     v-tr-2 = ""
     2279     v-tr-s = ""
     2280     v-tr-p = ""
     2281     v-kass-f-1 = ""
     2282     v-kass-f-2 = ""
     2283     v-inkass-1 = ""
     2284     v-inkass-2 = ""
     2285   .
     2286             max-i = MAXIMUM ( num-entries(v-1,",") , num-entries(v-2,","),num-entries(v-3,",") ) .
     2287                     repeat ii = 1 to max-i :
     2288                     run pl .
     2289                     v-doc1 = "" .
     2290                     v-doc2 = "" .
     2291                     v-doc3 = "" .
     2292                     if ii <= num-entries(v-1,",") then v-doc1 = entry ( ii, v-1 ) no-error .
     2293                     if ii <= num-entries(v-2,",") then v-doc2 = entry ( ii, v-2 ) no-error .
     2294                     if ii <= num-entries(v-3,",") then v-doc3 = entry ( ii, v-3 ) no-error .
     2295                     find first kass-f where kass-f.doc-code  = v-doc1 no-error .
     2296                           if available kass-f then do:
     2297                             v-kass-f-1 = substring( string(kass-f.fact-date),1,5) + " " + kass-f.fact-time.
     2298                             v-kass-f-2 = string(kass-f.sum-rubl ).
     2299                             end.
     2300                             else
     2301                             assign
     2302                                 v-kass-f-1 = ""
     2303                                 v-kass-f-2 = ""
     2304                             .
     2305                     find first inkass where inkass.doc-code  = v-doc2 no-error .
     2306                           if available inkass then do:
     2307                             v-inkass-1 = substring( string(inkass.fact-date),1,5) + " " + inkass.fact-time.
     2308                             v-inkass-2 = string(inkass.sum-rubl ).
     2309                             if v-inkass-1 = ? then v-inkass-1 = "" .
     2310                             if v-inkass-2 = ? then v-inkass-2 = "" .
     2311                             end.
     2312                             else
     2313                             assign
     2314                                 v-inkass-1 = ""
     2315                                 v-inkass-2 = ""
     2316                             .
     2317                     find first perev where perev.doc-code  = v-doc3 no-error .
     2318                           if available perev then do:
     2319                             v-tr-1 = substring( string(perev.fact-date),1,5) + " " + perev.fact-time.
     2320                             v-tr-2 = string(perev.sum-rubl ).
     2321                             v-tr-s = string(perev.bef-vid).
     2322                             v-tr-p = string(perev.aft-vid).
     2323                             end.
     2324                             else
     2325                             assign
     2326                                 v-tr-1 = ""
     2327                                 v-tr-2 = ""
     2328                                 v-tr-s = ""
     2329                                 v-tr-p = ""
     2330                             .
     2331                         if ii = 1 then do :
     2332                             PUT STREAM OutStream UNFORMATTED
     2333                                 sym1       at 41
     2334                                 v-kass-f-1 format "X(11)"
     2335                                 sym2       format "X(1)" space(0)
     2336                                 v-kass-f-2  format "X(8)"
     2337                                 sym3       format "X(1)" space(0)
     2338                                 v-inkass-1 format "X(11)"
     2339                                 sym4       format "X(1)" space(0)
     2340                                 v-inkass-2  format "X(9)"
     2341                                 sym5                format "X(1)" space(0)
     2342                                 v-tr-s              format "X(19)"
     2343                                 sym9                format "X(1)"      space(0)
     2344                                 v-tr-p              format "X(16)"
     2345                                 sym10               format "X(1)"      space(0)
     2346                                 v-tr-1              format "X(11)"
     2347                                 sym11               format "X(1)"      space(0)
     2348                                 v-tr-2              format "X(9)"
     2349                                 sym12               format "X(1)"      space(0)
     2350                                 skip.
     2351                                 run macr_excel_char ( v-kass-f-1  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2352                                 run macr_excel_char ( v-kass-f-2  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2353                                 run macr_excel_char ( v-inkass-1  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2354                                 run macr_excel_char ( v-inkass-2  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2355                                 run macr_excel_char ( v-tr-s , num#str# , num#col#   )      . assign    num#col# = num#col# + 1 .
     2356                                 run macr_excel_char ( v-tr-p , num#str# , num#col#   )      . assign    num#col# = num#col# + 1 .
     2357                                 run macr_excel_char ( v-tr-1 , num#str# , num#col#   )      . assign    num#col# = num#col# + 1 .
     2358                                 run macr_excel_char ( v-tr-2 , num#str# , num#col#   )      . assign    num#col# = num#col# + 1 .
     2359                         end.
     2360                         else do:
     2361                             PUT STREAM OutStream UNFORMATTED
     2362                                 sym1                format "X(1)" at 1
     2363                                 ""                  format "X(7)"
     2364                                 sym2                format "X(1)" space(0)
     2365                                 ""                  format "X(14)"
     2366                                 sym3                format "X(1)" space(0)
     2367                                 ""
     2368                                 sym4                format "X(1)"  at 41 space(0)
     2369                                 v-kass-f-1          format "X(11)"
     2370                                 sym5                format "X(1)"      space(0)
     2371                                 v-kass-f-2          format "X(8)"
     2372                                 sym6                format "X(1)"      space(0)
     2373                                 v-inkass-1          format "X(11)"
     2374                                 sym7                format "X(1)"      space(0)
     2375                                 v-inkass-2          format "X(9)"
     2376                                 sym8                format "X(1)"      space(0)
     2377                                 v-tr-s              format "X(19)"
     2378                                 sym9                format "X(1)"      space(0)
     2379                                 v-tr-p              format "X(16)"
     2380                                 sym10               format "X(1)"      space(0)
     2381                                 v-tr-1              format "X(11)"
     2382                                 sym11               format "X(1)"      space(0)
     2383                                 v-tr-2              format "X(9)"
     2384                                 sym12               format "X(1)"      space(0)
     2385                                 skip.
     2386                                 num#col# = num#col# + 3 .
     2387                                 run macr_excel_char ( v-kass-f-1  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2388                                 run macr_excel_char ( v-kass-f-2  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2389                                 run macr_excel_char ( v-inkass-1  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2390                                 run macr_excel_char ( v-inkass-2  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2391                                 run macr_excel_char ( v-tr-s , num#str# , num#col#   )      . assign    num#col# = num#col# + 1 .
     2392                                 run macr_excel_char ( v-tr-p , num#str# , num#col#   )      . assign    num#col# = num#col# + 1 .
     2393                                 run macr_excel_char ( v-tr-1 , num#str# , num#col#   )      . assign    num#col# = num#col# + 1 .
     2394                                 run macr_excel_char ( v-tr-2 , num#str# , num#col#   )      . assign    num#col# = num#col# + 1 .
     2395                         end.
     2396                         num#str# = num#str# + 1 .
     2397                         num#col# = 1.
     2398                     end.
     2399               end.
     2400           end.
     2401       end.
     2402   end.
     2403   end.
     2404   end procedure.
     2405   procedure print-all-itog :
     2406   end procedure.
     2407   procedure PrintTitul :
     2408     do  on error undo, return error return-value  :
     2409     define variable cc as integer no-undo .
     2410     define variable tt as integer no-undo .
     2411     define variable pp as integer no-undo .
     2412   PUT STREAM OutStream UNFORMATTED
     2413   space(1)
     2414      ReportNAme skip
     2415      "по фирме "  ub.clients.obj-name skip
     2416      "за период "  x-date-start " по " x-date-end  skip
     2417      "Дата составления " + cur-time-date()  skip
     2418       .
     2419     define variable i as integer no-undo .
     2420     Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2421       PUT STREAM OutStream UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(90)" SKIP.
     2422     End.
     2423       num#str# = 1.
     2424       num#col# = 1.
     2425       run macr_excel_char ( Reportname , num#str# , num#col#   ) .
     2426       num#str# = num#str# + 1.
     2427       run macr_excel_char ( "по фирме " + CAPS( clients.obj-name)   , num#str# , num#col#   ) .
     2428       num#str# = num#str# + 1.
     2429       run macr_excel_char ( "За период " + string(x-date-start) + " по " +  string(x-date-end)  , num#str# , num#col# ) .
     2430       num#str# = num#str# + 1.
     2431       run macr_excel_char ( ReportHeader , num#str# , num#col#   ) .
     2432       num#str# = num#str# + 1.
     2433       run macr_excel_char ("Дата составления " + cur-time-date()   , num#str# , num#col#   ) .
     2434       num#str# = num#str# + 1.
     2435       num#col# = 4.
     2436       run macr_excel_char ("Кассовый фонд"  , num#str# , num#col#   ) . run macr_cell_size ( 16 , ? , num#str# , num#col# , ?, ? ) .
     2437       num#col# = 6.
     2438       run macr_excel_char ("Инкассация"  , num#str# , num#col#   ) . run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     2439       num#col# = 8.
     2440       run macr_excel_char ("Перевод оплаты"  , num#str# , num#col#   ) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     2441        put  stream macr_excel unformatted
     2442          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 4 , num#str# ,  5 ) + chr(10)  +
     2443          'BORDER(2,,,,,,0,0,0,0,0) '  + chr(10) +
     2444          'ALIGNMENT(7 , , 4 , 4 ,)'  + chr(10)
     2445          .
     2446        put  stream macr_excel unformatted
     2447          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 6 , num#str# ,  7 ) + chr(10)  +
     2448          'BORDER(2,,,,,,0,0,0,0,0) '  + chr(10) +
     2449          'ALIGNMENT(7 , , 4 , 4 ,)'  + chr(10)
     2450          .
     2451        put  stream macr_excel unformatted
     2452          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 8 , num#str# ,  11 ) + chr(10)  +
     2453          'BORDER(2,,,,,,0,0,0,0,0) '  + chr(10) +
     2454          'ALIGNMENT(7 , , 4 , 4 ,)'  + chr(10)
     2455          .
     2456       put  stream macr_excel unformatted
     2457          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  3 ) + chr(10)  +
     2458          'BORDER( 2, , , , , , , , , , ) '  + chr(10) .
     2459       num#str# = num#str# + 1.
     2460       num#col# = 1.
     2461       run macr_excel_char ("№ кассы"  , num#str# , num#col#   ) .    run macr_cell_size ( 5 , ? , num#str# , num#col# , ?, ? ) .
     2462       num#col# = 2.
     2463       run macr_excel_char ("Остаток денежных средств"  , num#str# , num#col#   ) . run macr_cell_size ( 30 , ? , num#str# , num#col# , ?, ? ) .
     2464       num#col# = 3.
     2465       run macr_excel_char ("ФИО кассира"  , num#str# , num#col#   ) .  run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     2466       num#col# = 4.
     2467       run macr_excel_char ("Дата и время"  , num#str# , num#col#   ) . run macr_cell_size ( 16 , ? , num#str# , num#col# , ?, ? ) .
     2468       num#col# = 5.
     2469       run macr_excel_char ("Сумма"  , num#str# , num#col#   ) . run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     2470       num#col# = 6.
     2471       run macr_excel_char ("Дата и время"  , num#str# , num#col#   ) . run macr_cell_size ( 16 , ? , num#str# , num#col# , ?, ? ) .
     2472       num#col# = 7.
     2473       run macr_excel_char ("Сумма"  , num#str# , num#col#   ) . run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     2474       num#col# = 8.
     2475       run macr_excel_char ("С чего"  , num#str# , num#col#   ) . run macr_cell_size ( 16 , ? , num#str# , num#col# , ?, ? ) .
     2476       num#col# = 9.
     2477       run macr_excel_char ("На чего"  , num#str# , num#col#   ) . run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     2478       num#col# = 10.
     2479       run macr_excel_char ("Дата и время"  , num#str# , num#col#   ) . run macr_cell_size ( 16 , ? , num#str# , num#col# , ?, ? ) .
     2480       num#col# = 11.
     2481       run macr_excel_char ("Сумма"  , num#str# , num#col#   ) . run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     2482     run print-1 .
     2483       run macr_cell_format
     2484       ( 10    ,
     2485         true  ,
     2486         false ,
     2487         ? ,
     2488         1 ,
     2489         1 ,
     2490         num#str# ,
     2491         num#col#
     2492         ) .
     2493        put  stream macr_excel unformatted
     2494          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     2495          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     2496          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2497          .
     2498       put  stream macr_excel unformatted
     2499          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  3 ) + chr(10)  +
     2500          'BORDER( 2, , , , , , , , , , ) '  + chr(10) .
     2501     end.
     2502   end procedure.
     2503   procedure PrintPodval :
     2504     do on error undo, return error return-value  :
     2505     define variable pp as integer no-undo .
     2506     define variable rr as integer no-undo .
     2507       run p-line .
     2508     end.
     2509   end procedure.
     2510   PROCEDURE on-same-page :
     2511     define input parameter p-line-number as integer  no-undo .
     2512     if p-line-number > page-size( OutStream ) then return .
     2513     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     2514       run p-line .
     2515       page stream OutStream .
     2516       end.
     2517   end procedure.
     2518   procedure print-1 :
     2519     do
     2520     on error undo, return error return-value
     2521     :
     2522   PUT STREAM OutStream UNFORMATTED "+---------------------------------------------------------------------------------------------------------------------------------------------+" skip .
     2523   PUT STREAM OutStream UNFORMATTED ":№ кассы: Остаток      :   ФИО кассира  :   Кассовый фонд    :     Инкассация      :                    Перевод оплаты                        :" skip .
     2524   PUT STREAM OutStream UNFORMATTED ":       : денежных     :                :-----------:--------+-----------:---------+-------------------:----------------:-----------:---------:" skip .
     2525   PUT STREAM OutStream UNFORMATTED ":       : средств      :                :   Дата и  :  Сумма :  Дата и   :  Сумма  :       С чего      :  На чего       :  Дата и   :Сумма    :" skip .
     2526   PUT STREAM OutStream UNFORMATTED ":       :              :                :   время   :        :  время    :         :                   :                :  время    :         :" skip .
     2527   PUT STREAM OutStream UNFORMATTED "+---------------------------------------------------------------------------------------------------------------------------------------------+" skip .
     2528     end.
     2529   end procedure.
     2530   procedure p-line :
     2531     do
     2532     on error undo, return error return-value
     2533     :
     2534     PUT STREAM OutStream UNFORMATTED  "+---------------------------------------------------------------------------------------------------------------------------------------------+".
     2535     PUT STREAM OutStream UNFORMATTED  skip .
     2536     end.
     2537   end procedure.
     2538   procedure print-obj :
     2539     do
     2540     on error undo, return error return-value
     2541     :
     2542     PUT STREAM OutStream UNFORMATTED  Obj-list.obj-name  at 1    format "X(26)" skip.
     2543       num#str# = num#str# + 1 .
     2544       num#col# = 1.
     2545       run macr_excel_char ( Obj-list.obj-name  , num#str# , num#col#   ) .
     2546       run macr_cell_size ( 26 , ? , num#str# , num#col# , ?, ? ) .
     2547     end.
     2548   end procedure.
     2549   procedure make-tt :
     2550     do
     2551     on error undo, return error return-value
     2552     :
     2553   define buffer buf_chk-doc for ub.chk-doc.
     2554   define buffer buf_chk-gds for ub.chk-gds  .
     2555   define buffer buf_psn-clients for ub.clients  .
     2556   define buffer buf_sale-clients for ub.clients  .
     2557   define buffer buf_chk-pay for ub.chk-pay  .
     2558   define variable v-sum as decimal   no-undo .
     2559   define variable jj as integer   no-undo init 0.
     2560   define variable v-vid as character no-undo .
     2561   define variable fio as character no-undo .
     2562   for each obj-list :
     2563     for each buf_chk-doc no-lock where
     2564         buf_chk-doc.obj-type = obj-list.obj-type and
     2565         buf_chk-doc.obj-code = obj-list.obj-code and
     2566         buf_chk-doc.chk-date <= x-date-end and
     2567         buf_chk-doc.chk-date >= x-date-start
     2568     :
     2569     if lookup(string(buf_chk-doc.chk-type), '2,3,4,5,7':U) = 0 then next.
     2570   find first buf_psn-clients no-lock  where
     2571              buf_psn-clients.obj-code = buf_chk-doc.cashier-psn-code  and
     2572              buf_psn-clients.obj-type = 'чел':U no-error .
     2573             if error-status :error then
     2574             fio =  "Кассир № " + string( buf_chk-doc.cashier ).
     2575             else fio  = buf_psn-clients.obj-name .
     2576               jj = jj + 1.
     2577   IF ( JJ modulo v-account = 0 )  then DO:
     2578    Assign
     2579       v-kol-spice = (50 - LENGTH(obj-list.obj-name)) / 2
     2580       RecordsString = fill(' ',v-kol-spice) + string(obj-list.obj-name)
     2581       .
     2582             if  log-manager:logfile-name ne ?
     2583             then DO:
     2584                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2585             end.
     2586              if mFrameView
     2587              then do:
     2588               DISPLAY
     2589                 JJ @ RecordsDone
     2590                 RecordsString   @ RecordsString
     2591                 WITH FRAME InfoFrame.
     2592              end.
     2593   End.
     2594      if v-button-stop then  DO:
     2595            if mFrameView
     2596            then
     2597               PROCESS EVENTS.
     2598            IF StopProcessing THEN DO:
     2599            RETURN error.
     2600            End.
     2601      end.
     2602             create tt-temp.
     2603             assign
     2604                 tt-temp.pay-desk  = buf_chk-doc.pay-desk
     2605                 tt-temp.sum-rubl-ost = 0
     2606                 tt-temp.cashier   = buf_chk-doc.cashier
     2607                 tt-temp.psn-code  = buf_chk-doc.cashier-psn-code
     2608                 tt-temp.psn-name  = fio
     2609                 tt-temp.fact-date = buf_chk-doc.chk-date
     2610                 tt-temp.fact-time = string ( buf_chk-doc.chk-time , "hh:mm" )
     2611                 tt-temp.obj-code  = buf_chk-doc.obj-code
     2612                 tt-temp.obj-type  = buf_chk-doc.obj-type
     2613                 tt-temp.doc-code  = buf_chk-doc.doc-code
     2614                 tt-temp.doc-type  = string(buf_chk-doc.chk-type )
     2615                 tt-temp.bef-vid   = ""
     2616                 tt-temp.aft-vid   = ""
     2617                 tt-temp.sum-rubl  = 0
     2618             .
     2619             run sum-doc (input tt-temp.doc-code , input string(buf_chk-doc.chk-type ) ,  output tt-temp.sum-rubl  , output tt-temp.bef-vid  , output tt-temp.aft-vid) .
     2620           end.
     2621        end.
     2622   end.
     2623   end procedure.
     2624   procedure print-obj-itog :
     2625     do
     2626     on error undo, return error return-value
     2627     :
     2628     end.
     2629   end procedure.
     2630   procedure sum-doc :
     2631     do
     2632     on error undo, return error return-value
     2633     :
     2634     define input  parameter p-doc-code as character no-undo .
     2635     define input  parameter p-doc-type as character no-undo .
     2636     define output parameter p-sum-rubl as decimal   no-undo .
     2637     define output parameter p-bef-vid  as character no-undo .
     2638     define output parameter p-aft-vid  as character no-undo .
     2639     define buffer buf2_chk-pay for ub.chk-pay  .
     2640     define buffer buf_chk-pay for ub.chk-pay  .
     2641      p-bef-vid = "" .
     2642      p-aft-vid = "" .
     2643      p-sum-rubl = 0 .
     2644      IF p-doc-type <> '4':U THEN DO:
     2645         p-sum-rubl = 0 .
     2646         for each buf2_chk-pay no-lock where buf2_chk-pay.doc-code = p-doc-code  :
     2647                  p-sum-rubl = p-sum-rubl + buf2_chk-pay.tot-sum * buf2_chk-pay.bank-rate / buf2_chk-pay.bank-scale .
     2648         end.
     2649      END.
     2650      ELSE DO:
     2651         find first  buf2_chk-pay no-lock where buf2_chk-pay.doc-code = p-doc-code   no-error .
     2652         if available buf2_chk-pay then do:
     2653             p-sum-rubl = ABS(buf2_chk-pay.tot-sum * buf2_chk-pay.bank-rate / buf2_chk-pay.bank-scale)   .
     2654         end.
     2655         for each buf2_chk-pay no-lock where buf2_chk-pay.doc-code = p-doc-code  :
     2656             IF  buf2_chk-pay.tot-sum  < 0 THEN  DO:
     2657                 p-bef-vid = get-cash-pay(buf2_chk-pay.pay-code, buf2_chk-pay.curr-code) .
     2658             END.
     2659             IF  buf2_chk-pay.tot-sum  > 0 THEN  DO:
     2660                 p-aft-vid = get-cash-pay(buf2_chk-pay.pay-code, buf2_chk-pay.curr-code) .
     2661             END.
     2662         end.
     2663      END.
     2664     end.
     2665   end procedure.
     2666   def var vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2667   procedure macr_excel_char :
     2668    do
     2669    on error undo, return error return-value
     2670    :
     2671    define input parameter  p-val as character no-undo .
     2672    define input parameter  p-row as integer no-undo .
     2673    define input parameter  p-col as integer no-undo .
     2674    if p-val = ? then p-val = "" .
     2675       put stream macr_excel unformatted
     2676             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2677    end.
     2678   end procedure.
     2679   procedure macr_excel_char_with_format :
     2680    do
     2681    on error undo, return error return-value
     2682    :
     2683    define input parameter  p-val as character no-undo .
     2684    define input parameter  p-row as integer no-undo .
     2685    define input parameter  p-col as integer no-undo .
     2686    if p-val = ? then p-val = "" .
     2687       put stream macr_excel unformatted
     2688             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2689       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2690       put stream macr_excel unformatted
     2691             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2692    end.
     2693   end procedure.
     2694   procedure macr_excel_cell_format :
     2695    do
     2696    on error undo, return error return-value
     2697    :
     2698    define input parameter  p-val    as character no-undo .
     2699    define input parameter  p-row    as integer   no-undo .
     2700    define input parameter  p-col    as integer   no-undo .
     2701    define input parameter  p-format as character no-undo .
     2702    if p-val = ? then p-val = "" .
     2703       put stream macr_excel unformatted
     2704             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2705       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2706       put stream macr_excel unformatted
     2707             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2708    end.
     2709   end procedure.
     2710   procedure macr_excel_sum :
     2711    do
     2712    on error undo, return error return-value
     2713    :
     2714    define input parameter  p-row as integer no-undo .
     2715    define input parameter  p-col as integer no-undo .
     2716    define input parameter  p-row1 as integer no-undo .
     2717    define input parameter  p-col1 as integer no-undo .
     2718    define input parameter  p-row2 as integer no-undo .
     2719    define input parameter  p-col2 as integer no-undo .
     2720       put stream macr_excel unformatted
     2721             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2722    end.
     2723   end procedure.
     2724   procedure macr_excel_dec :
     2725    do
     2726    on error undo, return error return-value
     2727    :
     2728    define input parameter  p-val as character no-undo .
     2729    define input parameter  p-row as integer   no-undo .
     2730    define input parameter  p-col as integer   no-undo .
     2731     if p-val = ? then p-val =  "" .
     2732      put  stream macr_excel unformatted
     2733           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2734    end.
     2735   end procedure.
     2736   procedure macr_cell_format :
     2737    do
     2738    on error undo, return error return-value
     2739    :
     2740    define input parameter  p-size   as integer   no-undo .
     2741    define input parameter  p-bold   as logical   no-undo .
     2742    define input parameter  p-italic as logical   no-undo .
     2743    define input parameter  p-color  as integer   no-undo .
     2744    define input parameter  p-row    as integer   no-undo .
     2745    define input parameter  p-col    as integer   no-undo .
     2746    define input parameter  p-row-2  as integer   no-undo .
     2747    define input parameter  p-col-2  as integer   no-undo .
     2748     if p-size = ? then p-size = 10 .
     2749     if p-bold = ? then p-bold = false .
     2750     if p-italic = ? then p-italic = false .
     2751     if p-row-2 = ? then p-row-2 = p-row .
     2752     if p-col-2 = ? then p-col-2 = p-col .
     2753     put  stream macr_excel unformatted
     2754      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2755     if p-color <> ? then do:
     2756        put  stream macr_excel unformatted
     2757          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2758     end.
     2759     put  stream macr_excel unformatted
     2760          substitute('format.font(,&1,&2,&3)' , p-size,
     2761                                           string ( p-bold  , "true/false" ) ,
     2762                                           string ( p-italic , "true/false" )
     2763                                           ) + chr(10) .
     2764    end.
     2765   end procedure.
     2766   procedure macr_cell_size :
     2767    do
     2768    on error undo, return error return-value
     2769    :
     2770    define input parameter  p-w   as integer   no-undo .
     2771    define input parameter  p-l   as integer   no-undo .
     2772    define input parameter  p-row    as integer   no-undo .
     2773    define input parameter  p-col    as integer   no-undo .
     2774    define input parameter  p-row-2  as integer   no-undo .
     2775    define input parameter  p-col-2  as integer   no-undo .
     2776     if p-row-2 = ? then p-row-2 = p-row .
     2777     if p-col-2 = ? then p-col-2 = p-col .
     2778     if p-w = ? then    p-w = 0 .
     2779     if p-l = ? then    p-l = 0 .
     2780    define variable s-w as character no-undo .
     2781    define variable s-l as character no-undo .
     2782    if p-w = 0 then s-w = "" .
     2783               else s-w = string(p-w)  .
     2784    if p-l = 0 then s-l = "" .
     2785               else s-l = string(p-l)  .
     2786   put  stream macr_excel unformatted
     2787        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2788   put  stream macr_excel unformatted
     2789        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2790   put  stream macr_excel unformatted
     2791        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2792    end.
     2793   end procedure.
     2794   procedure proc-print-header :
     2795    do
     2796    on error undo, return error return-value
     2797    :
     2798      find first sheetf .
     2799        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2800        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2801        var-1 =  num#str# .
     2802        repeat c-c = 1 to sheetf.excel-row-title :
     2803        num#str# = num#str# + 1 .
     2804        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2805        do c-i = 1 to p-var :
     2806           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2807           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2808           num#col# = c-i .
     2809           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2810           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2811        end.
     2812       c-i = 0.
     2813       end.
     2814       run macr_cell_format (
     2815           10       ,
     2816           true     ,
     2817           false    ,
     2818           35       ,
     2819           var-1 + 1,
     2820           1        ,
     2821           num#str# ,
     2822           num#col# )
     2823           .
     2824     put  stream macr_excel unformatted
     2825          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2826          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2827          .
     2828    end.
     2829   end procedure.
     2830   procedure end-proc :
     2831    do
     2832    on error undo, return error return-value
     2833    :
     2834     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2835     OUTPUT to VALUE (v-file-name) .
     2836     for each temp-param :
     2837       export  temp-param  .
     2838     end.
     2839    end.
     2840   end procedure.
