     1038   DEFINE RECTANGLE RECT-1
     1039        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1040        SIZE 55.13 BY 4.46.
     1041   DEFINE FRAME InfoFrame
     1042        StopBtn AT ROW 4.25 COL 21.75
     1043        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1044        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1045        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1046        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1047        RECT-1 AT ROW 1 COL 1
     1048       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1049            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1050            TITLE "Процесс"
     1051            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1052   define variable mFrameView      as logical   no-undo init yes.
     1053     define variable mFramHandle as handle no-undo.
     1054     mFramHandle = frame InfoFrame:handle.
     1055     if  log-manager:logfile-name ne ?
     1056     then DO:
     1057         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1058         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1059         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1060     end.
     1061     mFrameView = not session:batch-mode and mFramHandle:visible.
     1062     if mFrameView
     1063     then do:
     1064       ASSIGN
     1065          FRAME InfoFrame:HIDDEN                           = TRUE
     1066          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1067     end.
     1068   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1069   DO:
     1070     IF not StopProcessing THEN
     1071       Message "Вы действительно хотите прервать" SKIP
     1072               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1073                 UPDATE StopProcessing.
     1074     IF StopProcessing THEN do:
     1075        if mFrameView
     1076        then do:
     1077           HIDE FRAME InfoFrame.
     1078        end.
     1079     End.
     1080   END.
     1081   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1082     if  log-manager:logfile-name ne ?
     1083     then DO:
     1084         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1085     end.
     1086     if not session:batch-mode then
     1087     do:
     1088       VIEW FRAME InfoFrame.
     1089       mFrameView = true.
     1090     end.
     1091      v-button-stop = false .
     1092         if mFrameView
     1093         then do:
     1094         if v-button-stop then view STOPBTN in frame InfoFrame.
     1095                          else Hide STOPBTN in frame InfoFrame.
     1096         end.
     1097   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   procedure grp-obj-write :
     1099   do
     1100   on error undo, return error
     1101   :
     1102   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
     1103   define input parameter p-host-code  as integer                          no-undo.
     1104   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
     1105   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
     1106   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
     1107   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
     1108   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
     1109   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
     1110   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
     1111   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
     1112   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
     1113   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
     1114   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     1115       find first buf_gds-grp-obj exclusive-lock
     1116            where buf_gds-grp-obj.node-code  = p-node-code
     1117              and buf_gds-grp-obj.host-code  = p-host-code
     1118              and buf_gds-grp-obj.obj-type   = p-obj-type
     1119              and buf_gds-grp-obj.obj-code   = p-obj-code
     1120       no-error.
     1121       if not available buf_gds-grp-obj
     1122       then do:
     1123           create buf_gds-grp-obj.
     1124           assign
     1125                   buf_gds-grp-obj.node-code  = p-node-code
     1126                   buf_gds-grp-obj.host-code  = p-host-code
     1127                   buf_gds-grp-obj.obj-type   = p-obj-type
     1128                   buf_gds-grp-obj.obj-code   = p-obj-code
     1129           .
     1130       end.
     1131       assign
     1132       buf_gds-grp-obj.min-increase = p-min-increase
     1133       buf_gds-grp-obj.max-increase = p-max-increase
     1134       buf_gds-grp-obj.increase-pc = p-increase-pc
     1135       buf_gds-grp-obj.calc-method = p-calc-method
     1136       buf_gds-grp-obj.round-method = p-round-method
     1137       buf_gds-grp-obj.round-coef = p-round-coef
     1138       buf_gds-grp-obj.cli-type   = p-cli-type
     1139       buf_gds-grp-obj.cli-code   = p-cli-code
     1140       .
     1141   end.
     1142   end procedure.
     1143   procedure grp-obj-margin-value :
     1144   do
     1145   on error undo, return error
     1146   :
     1147   define input parameter p-node-code as integer      no-undo.
     1148   define input parameter p-obj-type  as character    no-undo.
     1149   define input parameter p-obj-code  as integer      no-undo.
     1150   define output parameter p-min-value as decimal      no-undo init ?.
     1151   define output parameter p-max-value as decimal      no-undo init ?.
     1152   define output parameter p-increase-pc as decimal      no-undo init ?.
     1153   define output parameter p-round-method as character no-undo init "":U.
     1154   define output parameter p-base as decimal no-undo init ?.
     1155   define output parameter p-range-margin     as integer      no-undo.
     1156   define output parameter p-exists-margin    as logical      no-undo.
     1157   define output parameter p-range-increase     as integer      no-undo.
     1158   define output parameter p-exists-increase    as logical      no-undo.
     1159   define output parameter p-range-rmethod     as integer no-undo .
     1160   define output parameter p-exists-rmethod    as logical no-undo .
     1161   define variable v-host-code as integer      no-undo.
     1162   DEFINE VARIABLE v-found as logical no-undo .
     1163   DEFINE VARIABLE v-exists as logical no-undo .
     1164   DEFINE VARIABLE v-range as integer no-undo .
     1165   DEFINE VARIABLE jj as integer no-undo .
     1166   DEFINE VARIABLE v-margin-found as logical no-undo .
     1167   DEFINE VARIABLE v-increase-found as logical no-undo .
     1168   DEFINE VARIABLE v-min-value as decimal      no-undo.
     1169   DEFINE VARIABLE v-max-value as decimal      no-undo.
     1170   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
     1171   define variable v-round-method as character no-undo .
     1172   define variable v-base as decimal no-undo .
     1173   define variable v-print-code as character no-undo .
     1174   define buffer buf_gds-grp for ub.gds-grp.
     1175   find first buf_gds-grp no-lock where
     1176              buf_gds-grp.node-code = p-node-code no-error .
     1177   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1178     message
     1179       vss-workfile vss-revision vss-description
     1180       skip "Не удалось найти группу товаров с кодом" p-node-code
     1181       view-as alert-box error .
     1182     undo, return error .
     1183   end.
     1184   if p-obj-type <> '' then do:
     1185   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1186   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1187     (input  p-obj-type
     1188     ,input  p-obj-code
     1189     ,output v-host-code
     1190     ) no-error .
     1191     if error-status :error
     1192     then do:
     1193         message
     1194           vss-workfile vss-revision vss-description
     1195           skip "Не удалось найти фирму объекта"
     1196           skip p-obj-type p-obj-code
     1197           skip return-value
     1198           skip trim(error-status :get-message(1))
     1199               trim(error-status :get-message(2))
     1200               trim(error-status :get-message(3))
     1201               trim(error-status :get-message(4))
     1202               trim(error-status :get-message(5))
     1203         view-as alert-box error.
     1204         undo, return error .
     1205     end.
     1206   end.
     1207   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1208   do while v-found = no and jj < 2:
     1209     if v-range <> 3 then do:
     1210       find first buf_gds-grp-obj no-lock
     1211           where buf_gds-grp-obj.node-code = p-node-code
     1212             and buf_gds-grp-obj.host-code = v-host-code
     1213             and buf_gds-grp-obj.obj-type  = p-obj-type
     1214             and buf_gds-grp-obj.obj-code  = p-obj-code
     1215       no-error .
     1216     end.
     1217     if v-range = 3 or not available buf_gds-grp-obj
     1218     then do:
     1219        if v-range <> 2 then do:
     1220           find first buf_gds-grp-obj no-lock
     1221               where buf_gds-grp-obj.node-code = p-node-code
     1222                 and buf_gds-grp-obj.host-code = v-host-code
     1223                 and buf_gds-grp-obj.obj-type  = ""
     1224                 and buf_gds-grp-obj.obj-code  = 0
     1225           no-error .
     1226         end.
     1227         if v-range = 2 or not available buf_gds-grp-obj
     1228         then do:
     1229             if v-range <> 1 then do:
     1230               find first buf_gds-grp-obj no-lock
     1231                   where buf_gds-grp-obj.node-code = p-node-code
     1232                   and buf_gds-grp-obj.host-code = 0
     1233                   and buf_gds-grp-obj.obj-type  = ""
     1234                   and buf_gds-grp-obj.obj-code  = 0
     1235               no-error .
     1236             end.
     1237             if v-range = 1 or not available buf_gds-grp-obj
     1238             then do:
     1239                 assign
     1240                     v-exists = no
     1241                 .
     1242             end.
     1243             else do:
     1244                 assign
     1245                     v-exists = yes
     1246                     v-range = 1
     1247                 .
     1248             end.
     1249         end.
     1250         else do:
     1251             assign
     1252                 v-exists = yes
     1253                 v-range  = 2
     1254             .
     1255         end.
     1256     end.
     1257     else do:
     1258         assign
     1259             v-exists = yes
     1260             v-range  = 3
     1261         .
     1262     end.
     1263     if available buf_gds-grp-obj
     1264     then do:
     1265       assign
     1266       v-min-value    = buf_gds-grp-obj.min-increase
     1267       v-max-value    = buf_gds-grp-obj.max-increase
     1268       v-increase-pc  = buf_gds-grp-obj.increase-pc
     1269       v-round-method = buf_gds-grp-obj.round-method
     1270       v-base         = buf_gds-grp-obj.round-coef
     1271       .
     1272       assign
     1273       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
     1274                           then yes
     1275                           else p-exists-margin)
     1276       p-range-margin = if p-exists-margin and p-min-value = ?
     1277                         then v-range
     1278                         else p-range-margin
     1279       p-min-value   =  if p-exists-margin and  p-min-value = ?
     1280                         then v-min-value
     1281                         else p-min-value
     1282       p-max-value   =  if p-exists-margin and  p-max-value = ?
     1283                         then v-max-value
     1284                         else p-max-value
     1285       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
     1286                           then yes
     1287                           else p-exists-increase)
     1288       p-range-increase = if p-exists-increase and p-increase-pc = ?
     1289                         then v-range
     1290                         else p-range-increase
     1291       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
     1292                         then v-increase-pc
     1293                         else p-increase-pc)
     1294       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
     1295                           then yes
     1296                           else p-exists-rmethod
     1297       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
     1298                           then v-range
     1299                           else p-range-rmethod)
     1300       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
     1301                           then v-round-method
     1302                           else p-round-method)
     1303       p-base          = (if p-exists-rmethod and p-base = ?
     1304                           then v-base
     1305                           else p-base)
     1306       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
     1307       jj = jj + 1
     1308       .
     1309     end.
     1310     else do:
     1311       assign
     1312       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
     1313       jj = jj + 1
     1314       .
     1315     end.
     1316   end.
     1317   end.
     1318   end procedure.
     1319   procedure grp-obj-income-cli-value :
     1320   do
     1321   on error undo, return error
     1322   :
     1323   define input parameter p-node-code as integer      no-undo.
