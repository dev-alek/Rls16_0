     1457   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1458   procedure proc-alt-shift-f2:
     1459     if not ibs.th.gbl.gbl-var:rcode
     1460   then
     1461     run gbl\inidebug.p .
     1462   end.
     1463   procedure proc-alt-shift-f3:
     1464     run gbl/prvssinf.p
     1465       ( input this-procedure
     1466       ) .
     1467   end.
     1468   define variable v-inform-launched as logical no-undo initial false .
     1469   procedure proc-alt-shift-f4:
     1470     define variable v-action as character no-undo .
     1471     if v-inform-launched = false then do:
     1472       assign
     1473         v-inform-launched = true
     1474       .
     1475       run gbl/d-inform.w
     1476         (  input self
     1477         ,  input this-procedure
     1478         , output v-action
     1479         ) no-error .
     1480       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1481       assign
     1482         v-inform-launched = false
     1483       .
     1484     end.
     1485   end.
     1486   procedure proc-alt-f1:
     1487     run gbl/corrhelp.p
     1488       (input this-procedure
     1489       ) .
     1490   end .
     1491   on alt-shift-f2 anywhere do:
     1492     run proc-alt-shift-f2.
     1493   end.
     1494   on alt-shift-f3 anywhere do:
     1495     run proc-alt-shift-f3 in this-procedure .
     1496   end.
     1497   on alt-shift-f4 anywhere do:
     1498     run proc-alt-shift-f4 in this-procedure.
     1499   end.
     1500   on alt-f1 anywhere do:
     1501     run proc-alt-f1 in this-procedure .
     1502   end.
