     2044   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2045   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2046   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2047   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2048   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2049   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2050   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
