     2058   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2059   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2060   define variable temp1 as integer   no-undo.
     2061   define variable t-1 as character no-undo .
     2062   define variable t-2 as character no-undo .
     2063   define variable t-3 as character no-undo .
