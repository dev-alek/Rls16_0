     1385                 and buf_gds-grp-obj.obj-type  = ""
     1386                 and buf_gds-grp-obj.obj-code  = 0
     1387           no-error .
     1388         end.
     1389         if v-range = 2 or not available buf_gds-grp-obj
     1390         then do:
     1391             if v-range <> 1 then do:
