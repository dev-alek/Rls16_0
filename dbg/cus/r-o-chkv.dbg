     1393                   where buf_gds-grp-obj.node-code = p-node-code
     1394                   and buf_gds-grp-obj.host-code = 0
     1395                   and buf_gds-grp-obj.obj-type  = ""
     1396                   and buf_gds-grp-obj.obj-code  = 0
     1397               no-error .
     1398             end.
     1399             if v-range = 1 or not available buf_gds-grp-obj
     1400             then do:
     1401                 assign
     1402                     v-exists = no
     1403                 .
     1404             end.
     1405             else do:
     1406                 assign
     1407                     v-exists = yes
     1408                     v-range = 1
     1409                 .
     1410             end.
     1411         end.
     1412         else do:
