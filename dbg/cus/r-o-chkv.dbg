     1369   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1370   do while v-found = no and jj < 2:
     1371     if v-range <> 3 then do:
     1372       find first buf_gds-grp-obj no-lock
     1373           where buf_gds-grp-obj.node-code = p-node-code
     1374             and buf_gds-grp-obj.host-code = v-host-code
     1375             and buf_gds-grp-obj.obj-type  = p-obj-type
     1376             and buf_gds-grp-obj.obj-code  = p-obj-code
     1377       no-error .
     1378     end.
     1379     if v-range = 3 or not available buf_gds-grp-obj
     1380     then do:
