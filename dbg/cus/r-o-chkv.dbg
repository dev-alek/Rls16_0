     2053   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2054   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2055   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2056   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
