      201       ,output p-prop-type-list
      202       ,output p-prop-label-list
      203       ,output p-global
      204       ,output p-host
      205       ,output p-shop
      206       ,output p-store
      207       ,output p-db
      208       ,output p-region
      209       ) no-error .
      210     if error-status :error
      211     then do:
