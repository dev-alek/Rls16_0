      442     run mainmenu_getcntxt in parparentproc
      443       (output v-cntxt-db-num
      444       ,output v-cntxt-userid
      445       ,output v-cntxt-level
      446       ,output v-cntxt-host-code-obj
      447       ,output v-cntxt-obj-type
      448       ,output v-cntxt-obj-code
      449       ,output v-cntxt-db-num-obj
      450       ,output v-cntxt-is-admin
      451       ) .
      452   assign
      453     store-type    = v-cntxt-obj-type
      454     store-code    = v-cntxt-obj-code
      455   .
      456   define variable v-fin-block as character no-undo .
      457   if p-place = 'firm-fin':U    or
      458      p-place = 'without-fo':U  or
      459      p-place = 'with-fo':U
      460       then v-fin-block = ",fin-block" .
      461       else v-fin-block = "" .
      462   define buffer buf_clients-name for ub.clients  .
      463   if store-type = ? or store-type = "" then do:
      464     g#host-code = v-cntxt-host-code-obj .
      465     find first buf_clients-name no-lock where
      466                buf_clients-name.obj-code =  g#host-code and
      467                buf_clients-name.obj-type = 'орг':U
      468                no-error .
      469      g#host-name = buf_clients-name.obj-name.
      470      v-obj-active = 'no' .
      471   end.
      472   else do:
      473   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      475     (input  store-type
      476     ,input  store-code
      477     ,output g#host-code
      478     )  .
      479     find first buf_clients-name no-lock where
      480                buf_clients-name.obj-code =  g#host-code and
      481                buf_clients-name.obj-type = 'орг':U
      482                no-error .
      483      g#host-name = buf_clients-name.obj-name.
      484   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      485   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      486     (input  store-type
      487     ,input  store-code
      488     ,input  'active=request':u
      489     ,output v-obj-active
      490     )  .
      491   end.
      492   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      493   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currdbat in g#library
      494     (input  'office=request':u
      495     ,output v-office
      496     )  .
      497   define variable v-value-character  as character no-undo .
      498   define variable v-value-date       as date      no-undo .
      499   define variable v-value-decimal    as decimal   no-undo .
      500   define variable v-value-integer    as integer   no-undo .
      501   run adm/shattri.p (
      502     input "get":U
      503     ,input ""
      504     ,input 0
      505     ,input 'ord-global':U
      506     ,input 'ord-ofof':U
      507     ,output v-value-character
      508     ,output v-value-date
      509     ,output v-value-decimal
      510     ,output v-value-integer
      511     ,output par-ord-ofof
      512     ,output type-par
      513     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      514     ) no-error .
      515   assign
      516       list-mode = p-place
      517       g#type = (If tt = "all":U     then ? else tt          )
      518       g#stat = (if p-status = "all":U then ? else p-status  )
      519       .
      520   case g#type :
      521   when 'ОО':U then do:
      522      if g#type =  ? then  par-mode = 'объ':U  .
      523                     else  par-mode =  "status":U .
      524       case g#stat :
      525           when 'новый':U then do:
      526             run cus/ord-ooz.w
      527             ( input   parParentProc,
      528               input  "b-add,b-chg,b-del,b-lkp,b-close" ,
      529               input  par-mode    ,
      530               input  pardoc-rec  ,
      531               input  g#host-code ,
      532               input  store-code  ,
      533               input  store-type  ,
      534               input  g#type      ,
      535               input  g#stat      ,
      536               input  p-char      ,
      537               output p-list
      538               ).
      539           end.
      540           when 'запрос':U then do:
      541             run cus/ord-ooz.w
      542             ( input   parParentProc,
      543               input  "b-chg,b-del,b-lkp,b-close" ,
      544               input  par-mode    ,
      545               input  pardoc-rec  ,
      546               input  g#host-code ,
      547               input  store-code  ,
      548               input  store-type  ,
      549               input  g#type      ,
      550               input  g#stat      ,
      551               input  p-char      ,
      552               output p-list
      553               ).
      554           end.
      555           when 'факт':U then do:
      556             run cus/ord-ooz.w
      557             ( input   parParentProc,
      558               input  "b-lkp" ,
      559               input  par-mode    ,
      560               input  pardoc-rec  ,
      561               input  g#host-code ,
      562               input  store-code  ,
      563               input  store-type  ,
      564               input  g#type      ,
      565               input  g#stat      ,
      566               input  p-char      ,
      567               output p-list
      568               ).
      569           end.
      570           when ? then do:
      571             par-mode = 'объ':U  .
      572             run cus/ord-ooz.w
      573             ( input   parParentProc,
      574               input  "b-add,b-chg,b-del,b-lkp,b-close" ,
      575               input  par-mode    ,
      576               input  pardoc-rec  ,
      577               input  g#host-code ,
      578               input  store-code  ,
      579               input  store-type  ,
      580               input  g#type      ,
      581               input  g#stat      ,
      582               input  p-char      ,
      583               output p-list
      584               ).
      585           end.
      586       end case.
      587   end.
      588   when 'ОР':U then do:
      589      if list-mode = "rc":U then do:
      590         if g#type =  ?
      591             then  par-mode = list-mode + 'объ':U  .
      592             else  par-mode = list-mode + "status":U .
      593      end.
      594      else do:
      595         if g#type =  ?
      596             then  par-mode = 'объ':U  .
      597             else  par-mode = "status":U .
      598      end.
      599       case g#stat :
      600           when 'новый':U then do:
      601             run cus/ord-orc.w
      602             ( input   parParentProc,
      603               input  "b-add,b-chg,b-del,b-lkp,b-close" ,
      604               input  par-mode    ,
      605               input  pardoc-rec  ,
      606               input  g#host-code ,
      607               input  store-code  ,
      608               input  store-type  ,
      609               input  g#type      ,
      610               input  g#stat      ,
      611               input  p-char      ,
      612               output p-list
      613               ).
      614           end.
      615           when 'запрос':U  or
      616           when 'разрешено':U  or
      617           when 'отказ':U  or
      618           when 'отгружено':U
      619             then do:
      620             run cus/ord-orc.w
      621               ( input   parParentProc,
      622                 input  "b-lkp,b-close" ,
      623                 input  par-mode    ,
      624                 input  pardoc-rec  ,
      625                 input  g#host-code ,
      626                 input  store-code  ,
      627                 input  store-type  ,
      628                 input  g#type      ,
      629                 input  g#stat      ,
      630                 input  p-char      ,
      631                 output p-list
      632                 ).
      633           end.
      634           when 'факт':U then do:
      635             run cus/ord-orc.w
      636             ( input   parParentProc,
      637               input  "b-lkp" ,
      638               input  par-mode    ,
      639               input  pardoc-rec  ,
      640               input  g#host-code ,
      641               input  store-code  ,
      642               input  store-type  ,
      643               input  g#type      ,
      644               input  g#stat      ,
      645               input  p-char      ,
      646               output p-list
      647               ).
      648           end.
      649           when ? then do:
      650               if list-mode = "rc":U then do:
      651                       par-mode = list-mode + 'объ':U  .
      652               end.
      653               else do:
      654                       par-mode = 'объ':U  .
      655               end.
      656             run cus/ord-orc.w
      657             ( input   parParentProc,
      658               input  "b-add,b-chg,b-del,b-lkp,b-close" ,
      659               input  par-mode    ,
      660               input  pardoc-rec  ,
      661               input  g#host-code ,
      662               input  store-code  ,
      663               input  store-type  ,
      664               input  g#type      ,
      665               input  g#stat      ,
      666               input  p-char      ,
      667               output p-list
      668               ).
      669           end.
      670       end case.
      671   end.
      672   otherwise do:
      673   If g#stat    = 'новый':U
      674      or g#stat = 'отказ':U
      675      or g#type = 'ОФ':U
      676      then  do:
      677          if (list-mode = "obj" or list-mode = "firm" ) and g#type = ? then
      678             run ref/all-zakz.w
      679            ( input   parParentProc
      680             ,input   g#type
      681             ,input   g#stat
      682             ,input   list-mode
      683             ,input   ""
      684             ,input   "b-chg,b-del,b-lkp,b-close,b-open" + v-fin-block
      685             ,input   ""
      686             ,output  p-list       ) .
      687             else do:
      688                 if  par-ord-ofof = false then dO :
      689                     If g#type = 'ОФ':U and g#db-num = 0 then do:
      690                         run ref/all-zakz.w
      691                         (   input   parParentProc
      692                            ,input   g#type
      693                            ,input   g#stat
      694                            ,input   list-mode
      695                            ,input   ""
      696                            ,input   "b-chg,b-del,b-lkp,b-close,b-open" + v-fin-block
      697                            ,input   ""
      698                            ,output  p-list       ) .
      699                         end.
      700                         else do:
      701                         run ref/all-zakz.w
      702                         (      input   parParentProc
      703                               ,input   g#type
      704                               ,input   g#stat
      705                               ,input   list-mode
      706                               ,input   ""
      707                               ,input   "b-add,b-chg,b-del,b-lkp,b-close,b-open" + v-fin-block
      708                               ,input   ""
      709                               ,output  p-list       ) .
      710                         end.
      711                 end.
      712                 else do:
      713                     If g#type = 'ОФ':U and g#db-num = 0 then
      714                         run ref/all-zakz.w
      715                         (    input   parParentProc
      716                             ,input   g#type
      717                             ,input   g#stat
      718                             ,input   list-mode
      719                             ,input   ""
      720                             ,input   "b-add,b-chg,b-del,b-lkp,b-close,b-open" + v-fin-block
      721                             ,input   ""
      722                             ,output  p-list       ) .
      723                         else do:
      724                             If g#type = 'ФП':U and g#db-num = 0 then
      725                                    run ref/all-zakz.w
      726                                    (   input   parParentProc
      727                                       ,input   g#type
      728                                       ,input   g#stat
      729                                       ,input   list-mode
      730                                       ,input   ""
      731                                       ,input   "b-add,b-chg,b-del,b-lkp,b-close,b-open" + v-fin-block
      732                                       ,input   ""
      733                                       ,output  p-list       ) .
      734                               else run ref/all-zakz.w
      735                                   (   input   parParentProc
      736                                      ,input   g#type
      737                                      ,input   g#stat
      738                                      ,input   list-mode
      739                                      ,input   ""
      740                                      ,input   "b-chg,b-del,b-lkp,b-close,b-open" + v-fin-block
      741                                      ,input   ""
      742                                      ,output  p-list       ) .
      743                         end.
      744                 end.
      745             end.
      746          end.
      747      else do:
      748         if v-fin-block = "" then
      749         run cus/zakz-rcv.w
      750         ( input   parParentProc
      751           ,input   g#type
      752           ,input   g#stat
      753           ,input   list-mode
      754           ,input   ""
      755           ,input   "b-add,b-chg,b-del,b-lkp,b-close,b-open"
      756           ,input   ""
      757           ,output  p-list       ) .
      758           else
      759              run ref/all-zakz.w
      760                 ( input   parParentProc
      761                   ,input   g#type
      762                   ,input   g#stat
      763                   ,input   list-mode
      764                   ,input   ""
      765                   ,input   "b-lkp" + v-fin-block
      766                   ,input   ""
      767                   ,output  p-list
      768                     ) .
      769       end.
      770   end.
      771   end case.
      772   return.
