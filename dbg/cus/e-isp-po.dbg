      856          "Object ":U THIS-PROCEDURE:FILE-NAME
      857            "must have at least one Enabled Table to perform Assign.":U
      858              VIEW-AS ALERT-BOX ERROR.
      859      RETURN.
      860     END PROCEDURE.
      861   PROCEDURE adm-assign-statement :
      862     RETURN.
      863   END PROCEDURE.
      864   PROCEDURE adm-cancel-record :
      865      RETURN.
      866     END PROCEDURE.
      867   PROCEDURE adm-copy-record :
      868       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      869        "must have at least one Enabled Table to perform Copy.":U
      870          VIEW-AS ALERT-BOX ERROR.
      871       RETURN.
      872   END PROCEDURE.
      873   PROCEDURE adm-create-record :
      874      RETURN.
      875   END PROCEDURE.
      876   PROCEDURE adm-current-changed :
      877     RETURN.
      878   END PROCEDURE.
      879   PROCEDURE adm-delete-record :
      880    MESSAGE
      881          "Object ":U THIS-PROCEDURE:FILE-NAME
      882            "must have at least one Enabled Table to perform Delete.":U
      883              VIEW-AS ALERT-BOX ERROR.
      884       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      885       RETURN.
      886   END PROCEDURE.
      887   PROCEDURE adm-disable-fields :
      888         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      889       RETURN.
      890   END PROCEDURE.
      891   PROCEDURE adm-enable-fields :
      892       RETURN.
      893   END PROCEDURE.
      894   PROCEDURE adm-end-update :
      895     RETURN.
      896   END PROCEDURE.
      897   PROCEDURE adm-reset-record :
      898       RETURN.
      899   END PROCEDURE.
      900   PROCEDURE adm-update-record :
      901       MESSAGE
      902         "Object ":U THIS-PROCEDURE:FILE-NAME
      903           "must have at least one Enabled Table to perform Update.":U
      904             VIEW-AS ALERT-BOX ERROR.
      905      RETURN.
      906   END PROCEDURE.
      907   PROCEDURE check-modified :
      908   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      909   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      910   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      911   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      912     IF check-state = "check":U THEN
      913     DO:
      914       RUN get-link-handle IN adm-broker-hdl
      915         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      916            OUTPUT group-target-list).
      917       IF group-target-list NE "":U THEN
      918       DO i = 1 TO NUM-ENTRIES(group-target-list):
      919         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      920         RUN check-modified IN curr-widget ('group-check':U).
      921         IF RETURN-VALUE NE "":U THEN
      922         DO:
      923           RUN check-modified-message(RETURN-VALUE).
      924           RETURN "":U.
      925         END.
      926       END.
      927     END.
      928     RETURN "":U.
      929   END PROCEDURE.
      930   PROCEDURE check-modified-message :
      931     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      932        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      933           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      934        IF RETURN-VALUE = "YES":U THEN
      935           RUN notify ('view,CONTAINER-SOURCE':U).
      936        MESSAGE IF p-changed-table NE ? THEN
      937           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      938           ELSE "Current values have been changed."
      939           SKIP "  Do you wish to save those changes?"
      940           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      941        IF ANS THEN
      942        DO:
      943           IF group-assign-target THEN
      944             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      945           ELSE RUN dispatch('update-record':U).
      946           IF RETURN-VALUE = "ADM-ERROR":U THEN
      947           DO:
      948               MESSAGE "Changes to the previous record were not saved."
      949                 VIEW-AS ALERT-BOX ERROR.
      950               IF group-assign-target THEN
      951                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      952               ELSE RUN dispatch ('cancel-record':U).
      953           END.
      954        END.
      955        ELSE DO:
      956          IF group-assign-target THEN
      957             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      958          ELSE RUN dispatch('cancel-record':U).
      959        END.
      960        RETURN.
      961   END PROCEDURE.
      962   PROCEDURE get-rowid :
      963       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      964       ASSIGN
      965       p-table   =   adm-first-table.
      966       RETURN.
      967   END PROCEDURE.
      968   PROCEDURE init-group-assign :
      969       RUN request-attribute IN adm-broker-hdl
      970         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      971       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      972         group-assign-target = yes.
      973       ELSE group-assign-target = no.
      974       RETURN.
      975   END PROCEDURE.
      976   PROCEDURE set-editors :
      977       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      978       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      979       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      980       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      981       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      982       DO WHILE VALID-HANDLE (curr-widget):
      983           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      984              curr-widget:HIDDEN = no THEN DO:
      985             CASE p-field-setting:
      986               WHEN "INITIALIZE":U THEN
      987               DO:
      988                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      989                     read-only-list +
      990                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      991                        STRING(curr-widget).
      992               END.
      993               WHEN "DISABLE":U OR
      994               WHEN "ENABLE":U THEN
      995               DO:
      996                   curr-widget:SENSITIVE = yes.
      997                   RUN get-attribute ('Read-Only-Editors':U).
      998                   IF RETURN-VALUE = ? OR
      999                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1000                       curr-widget:READ-ONLY =
     1001                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1002               END.
     1003               WHEN "CLEAR":U THEN
     1004                   curr-widget:SCREEN-VALUE = "":U.
     1005             END CASE.
     1006           END.
     1007           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1008       END.
     1009       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1010         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1011           + '"':U).
     1012       RETURN.
     1013   END PROCEDURE.
     1014   PROCEDURE use-check-modified-all :
     1015    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1016     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1017     RETURN.
     1018   END PROCEDURE.
     1019   PROCEDURE use-create-on-add :
     1020   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1021      RETURN.
     1022   END PROCEDURE.
     1023   PROCEDURE use-initial-lock :
     1024     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1025     ASSIGN adm-initial-lock = p-attr-value.
     1026     RETURN.
     1027   END PROCEDURE.
     1028     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1029   ASSIGN
     1030          FRAME F-Main:SCROLLABLE       = FALSE
     1031          FRAME F-Main:HIDDEN           = TRUE.
     1032   ON VALUE-CHANGED OF RAD-otkl IN FRAME F-Main
     1033   DO:
     1034    assign RAD-otkl.
     1035    assign Ed-otkl-prc.
     1036    assign Ed-otkl-tmh.
     1037    assign Ed-otkl-tmm.
     1038   END.
     1039   ON VALUE-CHANGED OF RAD-Post IN FRAME F-Main
     1040   DO:
     1041     Assign RAD-Post.
     1042     Case RAD-Post :
     1043       when 4 then do:
     1044           run ref/cli-all.w ( parParentProc
     1045                          , "b-sel,b-mark"
     1046                          , 'про':U
     1047                          , 'все':U
     1048                          , 'текущие':U
     1049                          , ?
     1050                          , ",,,,,,NO,,"
     1051                         , ?
     1052                         , output cli-lst ) .
     1053           if cli-lst = "" then do:
     1054             Assign  RAD-Post = 1.
     1055             Display RAD-Post with frame F-Main .
     1056           end.
     1057       end.
     1058     End case.
     1059   END.
     1060   if not this-procedure :persistent
     1061   then do:
     1062     message
     1063       vss-workfile vss-revision vss-description skip
     1064       "Ошибка при запуске процедуры" skip
     1065       "Данную процедуру следует запускать только с параметром persistent" skip
     1066       view-as alert-box error .
     1067     undo, return error .
     1068   end.
     1069   PROCEDURE disable_UI :
     1070     HIDE FRAME F-Main.
     1071     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1072   END PROCEDURE.
     1073   PROCEDURE local-initialize :
     1074     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1075   END PROCEDURE.
     1076   PROCEDURE my-report :
     1077    define variable Ed-otkl-tm as integer   no-undo initial 0 .
     1078    case RAD-otkl :
     1079      when 3 then do:
     1080        assign
     1081          Ed-otkl-tm = Ed-otkl-tmh * 60 + Ed-otkl-tmm
     1082        .
     1083      end.
     1084      when 4 then do:
     1085        assign
     1086          Ed-otkl-tm  = 0
     1087          Ed-otkl-prc = 0
     1088        .
     1089      end.
     1090    end.
     1091    run cus/r-isp-po.p ( RAD-Post, cli-lst, tg-zay, RAD-otkl, Ed-otkl-prc, Ed-otkl-tm) .
     1092   END PROCEDURE.
     1093   PROCEDURE my-var :
     1094     assign frame F-Main   RAD-Post .
     1095     assign frame F-Main   RAD-otkl .
     1096     assign frame F-Main   Ed-otkl-prc .
     1097     assign frame F-Main   Ed-otkl-tmm .
     1098     assign frame F-Main   Ed-otkl-tmh .
     1099     assign frame F-Main   tg-zay .
     1100     str1 = "Выбор поставок: " .
     1101     case RAD-otkl :
     1102       when 1 then do:
     1103         str1 = str1 + "все" .
     1104       end.
     1105       when 2 then do:
     1106         str1 = str1 + "внутренние поставки" .
     1107       end.
     1108       when 3 then do:
     1109         str1 = str1 + "все от поставщиков" .
     1110       end.
     1111       when 4 then do:
     1112         str1 = str1 + "от выбранных поставщиков" .
     1113       end.
     1114     end.
     1115     str2 = "Выбор товаров: " .
     1116     case RAD-otkl :
     1117       when 1 then do:
     1118         str2 = str2 + "все" .
     1119       end.
     1120       when 2 then do:
     1121         str2 = str2 + "отклонения по кол-ву больше " + String(Ed-otkl-prc) + "  %" .
     1122       end.
     1123       when 3 then do:
     1124         str2 = str2 + "отклонения по времени больше " + String(Ed-otkl-tmh) + " ч. " + String(Ed-otkl-tmm) + " м. " .
     1125       end.
     1126       when 4 then do:
     1127         str2 = str2 + "все отклонения" .
     1128       end.
     1129     end.
     1130    ReportNAme   = "Отчет по исполнению поставок" .
     1131   END PROCEDURE.
     1132   PROCEDURE state-changed :
     1133     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1134     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1135     CASE p-state:
     1136     END CASE.
     1137   END PROCEDURE.
