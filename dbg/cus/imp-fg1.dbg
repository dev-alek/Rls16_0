        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Импорт из текстового файла".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   define variable v_os-file as char no-undo.
      108   DEFINE BUTTON B-file
      109        IMAGE-UP FILE "btn-down-arrow":U
      110        IMAGE-DOWN FILE "btn-down-arrow":U
      111        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      112        LABEL ""
      113        SIZE 3 BY 1.
      114   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      115        LABEL "Выход"
      116        SIZE 15 BY 1.13
      117        BGCOLOR 8 .
      118   DEFINE BUTTON Btn_OK
      119        LABEL "Выполнить"
      120        SIZE 15 BY 1.13
      121        BGCOLOR 8 .
      122   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      123        LABEL "Файл для импорта"
      124        VIEW-AS FILL-IN
      125        SIZE 52.5 BY 1 NO-UNDO.
      126   DEFINE VARIABLE Tumbler AS INTEGER
      127        VIEW-AS RADIO-SET VERTICAL
      128        RADIO-BUTTONS
      129             "В справочник товаров", 1,
      130   "В документ переоценки", 2,
      131   "В файл для последующей загрузки в приходный документ", 3
      132        SIZE 56 BY 2 NO-UNDO.
      133   DEFINE FRAME Dialog-Frame
      134        file-name AT ROW 2.25 COL 1
      135        B-file AT ROW 2.25 COL 71.5
      136        Tumbler AT ROW 5 COL 15 NO-LABEL
      137        Btn_OK AT ROW 7.25 COL 16
      138        Btn_Cancel AT ROW 7.25 COL 41
      139        "              Куда будем импортировать данные из файла" VIEW-AS TEXT
      140             SIZE 73.5 BY 1 AT ROW 3.5 COL 1
      141             BGCOLOR 8
      142        "          Укажите файл из которого необходимо произвести импорт" VIEW-AS TEXT
      143             SIZE 73.5 BY .67 AT ROW 1.25 COL 1
      144             BGCOLOR 8
      145        SPACE(0.24) SKIP(6.74)
      146       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      147            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      148            TITLE "Импорт из текстового файла"
      149            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      150   ASSIGN
      151          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      152          FRAME Dialog-Frame:HIDDEN           = TRUE.
      153   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      154   DO:
      155     APPLY "END-ERROR":U TO SELF.
      156   END.
      157   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      158   DO:
      159       DEF VAR ll_commit AS LOG    NO-UNDO INIT NO.
      160       SYSTEM-DIALOG GET-FILE v_os-file
      161           TITLE "Выберите файл для импорта"
      162                 FILTERS "Текстовый файл (*.csv)" "*.csv",
      163                         "Все файлы (*.*)"        "*.*"
      164                 MUST-EXIST
      165                 USE-FILENAME
      166           update ll_commit
      167           default-extension "csv"
      168           .
      169       IF ll_commit <> YES THEN do:
      170          RETURN NO-APPLY.
      171       end.
      172       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      173           BELL.
      174           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      175           RETURN NO-APPLY.
      176       END.
      177       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      178       DISP file-name WITH FRAME Dialog-Frame.
      179   END.
      180   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      181   DO:
      182       assign
      183           Tumbler.
      184       if  trim(file-name) = "" then do:
      185               message "Не задан файл для импорта "
      186               view-as alert-box ERROR.
      187               return no-apply.
      188       end.
      189       if Tumbler = 1 then do:
      190             run cus/imp-fg2.w ( input parparentproc, INPUT v_os-file ) no-error.
      191       end.
      192       ELSE if Tumbler = 2  THEN do:
      193             run cus/imp-fg3.p ( input parparentproc, INPUT v_os-file ) no-error.
      194       end.
      195       ELSE if Tumbler = 3 THEN do:
      196             run cus/imp-fg4.p ( INPUT v_os-file ) no-error.
      197       end.
      198   END.
      199   ON LEAVE OF file-name IN FRAME Dialog-Frame
      200   DO:
      201       ASSIGN file-name.
      202       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      203           ASSIGN FILE-INFO:FILE-NAME = file-name.
      204           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      205           DISP file-name WITH FRAME Dialog-Frame.
      206       END.
      207       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
      208   END.
      209   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      210   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      211   MAIN-BLOCK:
      212   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      213      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      214     RUN enable_UI.
      215     WAIT-FOR GO OF FRAME Dialog-Frame.
      216   END.
      217   RUN disable_UI.
      218   PROCEDURE disable_UI :
      219     HIDE FRAME Dialog-Frame.
      220   END PROCEDURE.
      221   PROCEDURE enable_UI :
      222     DISPLAY file-name Tumbler
      223         WITH FRAME Dialog-Frame.
      224     ENABLE file-name B-file Tumbler Btn_OK Btn_Cancel
      225         WITH FRAME Dialog-Frame.
      226     VIEW FRAME Dialog-Frame.
      227   END PROCEDURE.
