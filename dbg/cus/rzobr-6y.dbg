     2593           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     2594           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     2595           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
     2596            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","b2":u ). end.
     2597            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","b2":u ).  end.
     2598            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","b2":u ).  end.
     2599    End.
     2600   end.
     2601   END PROCEDURE.
     2602   PROCEDURE Clear-B1  :
     2603    b1-gds-zap-other           = 0.
     2604    REPEAT kk = 1 to 9 :
     2605    Assign
     2606       b1-Prih                                            [kk]    = 0
     2607       b1-Rash                                            [kk]    = 0
     2608       b1-KAssa                                           [kk]    = 0
     2609       b1-Inv                                             [kk]    = 0
     2610       b1-Overturn                                        [kk]    = 0
     2611       b1-ostatok-end                                     [kk]    = 0
     2612       b1-ostatok-start                                   [kk]    = 0   .
     2613      End.
     2614    END PROCEDURE.
     2615   PROCEDURE Clear-B2  :
     2616    b2-gds-zap-other           = 0.
     2617    REPEAT kk = 1 to 9 :
     2618    Assign
     2619       b2-Prih                                            [kk]    = 0
     2620       b2-Rash                                            [kk]    = 0
     2621       b2-KAssa                                           [kk]    = 0
     2622       b2-Inv                                             [kk]    = 0
     2623       b2-Overturn                                        [kk]    = 0
     2624       b2-ostatok-end                                     [kk]    = 0
     2625       b2-ostatok-start                                   [kk]    = 0   .
     2626      End.
     2627   END PROCEDURE.
     2628   PROCEDURE Clear-Bi  :
     2629    bi-gds-zap-other           = 0.
     2630    REPEAT kk = 1 to 9 :
     2631    Assign
     2632       bi-Prih                                            [kk]    = 0
     2633       bi-Rash                                            [kk]    = 0
     2634       bi-KAssa                                           [kk]    = 0
     2635       bi-Inv                                             [kk]    = 0
     2636       bi-Overturn                                        [kk]    = 0
     2637       bi-ostatok-end                                     [kk]    = 0
     2638       bi-ostatok-start                                   [kk]    = 0   .
     2639      End.
     2640   END PROCEDURE.
     2641   PROCEDURE Display-title :
     2642   define variable v-nn as integer   no-undo .
     2643      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2644             REPORTNAME  AT 20 format "X(170)" SKIP
     2645             Trim(str1)  AT 35 format "X(75)" SKIP.
     2646        v-nn = NUM-ENTRIES(str2,chr(10)) .
     2647        Repeat i = 1 to v-nn:
     2648         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     2649        End.
     2650       i=0.
     2651          PUT stream  OutStream  UNFORMATTED  Trim(str3)  AT 35 format "X(75)" SKIP.
     2652        v-nn = NUM-ENTRIES(str4,chr(10)).
     2653        Repeat i = 1 to v-nn :
     2654         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2655        End.
     2656       i=0.
     2657        v-nn = NUM-ENTRIES(ReportHeader,chr(10)) .
     2658        Repeat i = 1 to v-nn :
     2659         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2660        End.
     2661       i=0.
     2662       run rep/extitle.p (1) .
     2663   END PROCEDURE.
     2664   PROCEDURE ob-line  :
     2665   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2666   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2667   define INPUT  parameter x-artic        like ub.ot-line.artic        no-undo.
     2668   define INPUT  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2669   define INPUT  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2670   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2671   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2672   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2673   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2674   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2675   define input  parameter xTog-obj           as log no-undo.
     2676   define variable  tt#          as   int                 no-undo.
     2677    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     2678    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     2679    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     2680        FOR each ub.ot-line where
     2681                           ub.ot-line.artic         = x-artic
     2682                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2683                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2684                     AND   ub.ot-line.obj-code     = x-store-code
     2685                     AND   ub.ot-line.obj-type     = x-store-type
     2686                     AND   ub.ot-line.prod-code    = x-prod-code
     2687                     AND   ub.ot-line.prod-type    = x-prod-type
     2688                     AND   ub.ot-line.sum-type     = x-sum-type
     2689                       no-lock :
     2690       CASE ub.ot-line.ext-doc-type:
     2691                 WHEN        'ie':U  OR
     2692                 WHEN        're':U  OR
     2693                 WHEN        'iv':U    OR
     2694                 WHEN        'rv':U OR
     2695                 WHEN        'im':U     THEN
     2696                 DO:
     2697                 ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  ub.ot-line.fact-qnty
     2698                        prih[2 + tt#]   = prih[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2699                        prih[3 + tt#]   = prih[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2700                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2701                 End.
     2702                 WHEN       'ee':U      OR
     2703                 WHEN       'ep':U    OR
     2704                 WHEN       'ev':U     OR
     2705                 WHEN       'em':U       OR
     2706                 WHEN       'wm':U       OR
     2707                 WHEN       'we':U     THEN
     2708                 DO:
     2709                 ASSIGN  rash[1 + tt#]   = rash[1 + tt#]   +  ub.ot-line.fact-qnty
     2710                         rash[2 + tt#]   = rash[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2711                         rash[3 + tt#]   = rash[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2712                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2713                 End.
     2714                 WHEN       'es':U  OR
     2715                 WHEN       'rs':U THEN
     2716                 DO:
     2717                 ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.ot-line.fact-qnty
     2718                        kassa[2 + tt#]   = kassa[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2719                        kassa[3 + tt#]   = kassa[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2720                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2721                 End.
     2722             WHEN  'vt':U or when 'vp':U     THEN
     2723                 DO:
     2724                 ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.ot-line.fact-qnty
     2725                       inv[2 + tt#]   = inv[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2726                       Inv[3 + tt#]   = Inv[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.vat-base  .
     2727                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2728                 End.
     2729             WHEN       'ot':U THEN
     2730                 DO:
     2731                 ASSIGN Overturn[1 + tt#]   = Overturn[1 + tt#]   +  ub.ot-line.fact-qnty
     2732                       Overturn[2 + tt#]   = Overturn[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2733                       Overturn[3 + tt#]   = Overturn[3 + tt#]   +  if tPrintRubl then ub.ot-line.vat-rubl Else  ub.ot-line.vat-base  .
     2734                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2735                 End.
     2736         End CASE.
     2737     END.
     2738     if tt# = 6 then DO:
     2739              ASSIGN Overturn[1 + tt#]   = (Ostatok-end[1 + tt#]  - Ostatok-start[1 + tt#] )  -  (INV[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2740                     Overturn[2 + tt#]   = (Ostatok-end[2 + tt#]  - Ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  )
     2741                     Overturn[3 + tt#]   = (Ostatok-end[3 + tt#]  - Ostatok-start[3 + tt#] )  -  (Inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2742     End.
     2743   END PROCEDURE.
     2744   procedure ost-line :
     2745     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2746     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2747     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2748     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2749     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2750     define input  parameter x-tog-shift  as logical no-undo .
     2751     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2752     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2753     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2754     define input  parameter xtog-obj     as logical no-undo .
     2755     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2756     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2757     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2758     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2759     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2760     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2761     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2762     define buffer buff-obj-list  for obj-list .
     2763     define buffer buff-stk-line  for ub.stk-line .
     2764     assign
     2765       Quantity = 0
     2766       Coast_R  = 0
     2767       Coast_V  = 0
     2768       VAT_R    = 0
     2769       VAT_V    = 0
     2770       SLT_R    = 0
     2771       SLT_V    = 0
     2772     .
     2773     if  x-tog-shift = false then do:
     2774       for each buff-obj-list no-lock
     2775         where xtog-obj = false
     2776            or (buff-obj-list.obj-type = x-store-type
     2777               and buff-obj-list.obj-code = x-store-code
     2778               )
     2779       on error undo, return error
     2780       :
     2781       find last buff-stk-line no-lock
     2782         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2783           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2784           and buff-stk-line.artic      = x-artic
     2785           and buff-stk-line.prod-type  = x-prod-type
     2786           and buff-stk-line.prod-code  = x-prod-code
     2787           and buff-stk-line.sum-type   = x-sum-type
     2788           and buff-stk-line.cat-id     = '##,##':U
     2789           and buff-stk-line.fact-order <= x-fact-order
     2790           and buff-stk-line.shift-num  = 0
     2791         use-index category
     2792         no-error .
     2793       if available buff-stk-line then do:
     2794         assign
     2795           Quantity = Quantity + buff-stk-line.fact-qnty
     2796           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2797           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2798           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2799           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2800           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2801           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2802         .
     2803       end.
     2804      end.
     2805     end.
     2806     else do:
     2807       for each buff-obj-list no-lock
     2808         where xtog-obj = false
     2809            or (buff-obj-list.obj-type = x-store-type
     2810               and buff-obj-list.obj-code = x-store-code
     2811               )
     2812       on error undo, return error
     2813       :
     2814         find last buff-stk-line no-lock
     2815           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2816             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2817             and buff-stk-line.artic      = x-artic
     2818             and buff-stk-line.prod-type  = x-prod-type
     2819             and buff-stk-line.prod-code  = x-prod-code
     2820             and buff-stk-line.sum-type   = x-sum-type
     2821             and buff-stk-line.cat-id     = '##,##':U
     2822             and buff-stk-line.fact-order <= x-fact-order
     2823             and buff-stk-line.shift-num  > 0
     2824           use-index category
     2825           no-error .
     2826         if available buff-stk-line then do:
     2827           assign
     2828             Quantity = Quantity +  buff-stk-line.fact-qnty
     2829             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2830             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2831             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2832             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2833             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2834             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2835           .
     2836         end.
     2837       end.
     2838     end.
     2839   end procedure.
     2840   procedure ost-lineother-tax :
     2841     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2842     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2843     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2844     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2845     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2846     define input  parameter x-tog-shift  as logical no-undo .
     2847     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2848     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2849     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2850     define input  parameter xTog-obj     as logical no-undo .
     2851     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2852     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2853     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2854     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2855     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2856     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2857     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2858     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2859     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2860     define buffer buff-obj-list  for obj-list .
     2861     define buffer buff-stk-line  for ub.stk-line .
     2862     assign
     2863       Quantity = 0
     2864       Coast_R  = 0
     2865       Coast_V  = 0
     2866       VAT_R    = 0
     2867       VAT_V    = 0
     2868       SLT_R    = 0
     2869       SLT_V    = 0
     2870       other_R  = 0
     2871       other_V  = 0
     2872     .
     2873     if  x-tog-shift = false then do:
     2874       for each buff-obj-list no-lock
     2875         where xtog-obj = false
     2876            or (buff-obj-list.obj-type = x-store-type
     2877               and buff-obj-list.obj-code = x-store-code
     2878               )
     2879       on error undo, return error
     2880       :
     2881       find last buff-stk-line no-lock
     2882         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2883           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2884           and buff-stk-line.artic      = x-artic
     2885           and buff-stk-line.prod-type  = x-prod-type
     2886           and buff-stk-line.prod-code  = x-prod-code
     2887           and buff-stk-line.sum-type   = x-sum-type
     2888           and buff-stk-line.cat-id     = '##,##':U
     2889           and buff-stk-line.fact-order <= x-fact-order
     2890           and buff-stk-line.shift-num  = 0
     2891         use-index category
     2892         no-error .
     2893       if available buff-stk-line then do:
     2894         assign
     2895           Quantity = Quantity + buff-stk-line.fact-qnty
     2896           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2897           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2898           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2899           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2900           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2901           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2902           other_R  = other_R  + buff-stk-line.other-rubl
     2903           other_V  = other_V  + buff-stk-line.other-base
     2904         .
     2905       end.
     2906    end.
     2907     end.
     2908     else do:
     2909       for each buff-obj-list no-lock
     2910         where xtog-obj = false
     2911            or (buff-obj-list.obj-type = x-store-type
     2912               and buff-obj-list.obj-code = x-store-code
     2913               )
     2914       on error undo, return error
     2915       :
     2916         find last buff-stk-line no-lock
     2917           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2918             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2919             and buff-stk-line.artic      = x-artic
     2920             and buff-stk-line.prod-type  = x-prod-type
     2921             and buff-stk-line.prod-code  = x-prod-code
     2922             and buff-stk-line.sum-type   = x-sum-type
     2923             and buff-stk-line.cat-id     = '##,##':U
     2924             and buff-stk-line.fact-order <= x-fact-order
     2925             and buff-stk-line.shift-num  > 0
     2926           use-index category
     2927           no-error .
     2928         if available buff-stk-line then do:
     2929           assign
     2930             Quantity = Quantity +  buff-stk-line.fact-qnty
     2931             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2932             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2933             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2934             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2935             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2936             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2937             other_R = other_R   +  buff-stk-line.other-rubl
     2938             other_V = other_V   +  buff-stk-line.other-base
     2939           .
     2940         end.
     2941       end.
     2942     end.
     2943   end procedure.
     2944   procedure ost-line-kg :
     2945     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2946     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2947     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2948     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2949     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2950     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2951     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2952     define buffer buff-obj-list  for obj-list .
     2953     define buffer buf_doc-line for ub.doc-line .
     2954     define buffer buf_inv-line for ub.inv-line .
     2955     do
     2956     on error undo, return error
     2957     :
     2958       for each buf_doc-line no-lock where
     2959                buf_doc-line.obj-type    = p-obj-type   and
     2960                buf_doc-line.obj-code    = p-obj-code   and
     2961                buf_doc-line.prod-type   = p-prod-type  and
     2962                buf_doc-line.prod-code   = p-prod-code  and
     2963                buf_doc-line.artic       = p-artic      and
     2964                buf_doc-line.status_     = 'факт':U      and
     2965                buf_doc-line.fact-order <= p-fact-order
     2966             by buf_doc-line.fact-order    descending
     2967       :
     2968         find first buf_inv-line no-lock where
     2969                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2970                    buf_inv-line.artic     = buf_doc-line.artic     and
     2971                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2972                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2973         if available buf_inv-line
     2974         then do:
     2975           if buf_inv-line.after-cli-qnty <> ?
     2976           then do:
     2977             assign
     2978               p-quantity-kg = buf_inv-line.after-cli-qnty
     2979             .
     2980             leave .
     2981           end.
     2982         end.
     2983       end.
     2984       if p-quantity-kg = ?
     2985       then do:
     2986         assign
     2987           p-quantity-kg = 0
     2988         .
     2989       end.
     2990     end.
     2991   end procedure.
     2992   PROCEDURE ostatok :
     2993   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2994   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2995   def input parameter x-tog-shift   as   logical             no-undo.
     2996   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2997   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2998   def input parameter x-shift-start as integer               no-undo.
     2999   def input parameter x-shift-end   as integer               no-undo.
     3000   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     3001   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     3002   def input parameter xTog-obj   as log no-undo.
     3003   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     3004   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     3005   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     3006   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     3007   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     3008   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     3009   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     3010   def var              Fact-orderS   as char  no-undo.
     3011   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     3012      Assign
     3013         Fact-order   = 0
     3014         Quantity     = 0
     3015         Coast_R      = 0
     3016         Coast_V      = 0
     3017         VAT_R        = 0
     3018         VAT_V        = 0 .
     3019    x-date-start-t  = x-date-start + 1 .
     3020   IF x-date-end = date('') then DO:
     3021      Fact-order = 0 .
     3022      for each obj-list
     3023          where  ( not xtog-obj or
     3024                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     3025                 no-lock :
     3026         if  x-tog-shift = false then do:
     3027                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3028                               ub.stk-tot.Fact-date <=  x-date-start
     3029                               and ub.stk-tot.shift-num = 0
     3030                               USE-INDEX fact-date no-lock no-error .
     3031              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3032         End.
     3033         Else  DO :
     3034             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3035              (ub.stk-tot.shift-date  = x-date-start-t and
     3036               ub.stk-tot.shift-num  < x-shift-start or
     3037               ub.stk-tot.shift-date  < x-date-start-t  )
     3038               and ub.stk-tot.shift-num  > 0
     3039               USE-INDEX Shift-num no-lock no-error .
     3040            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3041           END.
     3042       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3043     End.
     3044   End.
     3045   Else DO:
     3046     For each obj-list  WHERE
     3047        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     3048         no-lock :
     3049      IF  x-TOG-Shift = False Then DO:
     3050          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3051               ub.stk-tot.Fact-date <= x-date-end
     3052               and ub.stk-tot.shift-num = 0
     3053               USE-INDEX fact-date no-lock no-error.
     3054          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3055      END.
     3056      Else DO:
     3057           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3058               (ub.stk-tot.shift-date  = x-date-end and
     3059               ub.stk-tot.shift-num  <= x-shift-end or
     3060               ub.stk-tot.shift-date  < x-date-end       ) and
     3061               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3062               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3063       End.
     3064       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3065     End.
     3066   End.
     3067   END PROCEDURE.
     3068   PROCEDURE report-exec1  :
     3069      FIND FIRST clients where x-store-type = clients.obj-type AND
     3070                               x-store-code = clients.obj-code no-lock no-error.
     3071     run waitfram-show(clients.obj-name) .
     3072     run calcitog.
     3073     run print-header.
     3074      case retclassify :
     3075        when "vat-ps":u         then run run7.
     3076        otherwise do:
     3077          message "Ошибка вызова!"  view-as alert-box error .
     3078        end.
     3079      end case.
     3080     run print-footer.
     3081     END PROCEDURE.
     3082   PROCEDURE Calc-Sub-itog :
     3083   define input parameter tt as int no-undo.
     3084   define variable b as int no-undo.
     3085   if tt = 6  then Assign
     3086     B1-gds-zap-other = B1-gds-zap-other +  gds-zap-other
     3087     B2-gds-zap-other = B2-gds-zap-other +  gds-zap-other
     3088     Bi-gds-zap-other = Bi-gds-zap-other +  gds-zap-other
     3089     Bo-gds-zap-other = Bo-gds-zap-other +  gds-zap-other
     3090     .
     3091   repeat b = 1 to 3:
     3092     Assign
     3093     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     3094     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     3095     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     3096     Bo-Prih[b + TT]    = Bo-Prih[b + TT]    +  Prih[b + TT]
     3097     Bo-ostatok-start[b + TT]    = Bo-ostatok-start[b + TT]    +  ostatok-start[b + TT]
     3098     Bo-ostatok-end[b + TT]      = Bo-ostatok-end[b + TT]      +  ostatok-end[b + TT]
     3099     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     3100     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     3101     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     3102     Bo-RAsh[b + TT]    = Bo-RAsh[b + TT]    +  RAsh[b + TT]
     3103     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     3104     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     3105     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     3106     Bo-Kassa[b + TT]    = Bo-Kassa[b + TT]    +  Kassa[b + TT]
     3107     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     3108     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     3109     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     3110     Bo-Inv[b + TT]    = Bo-Inv[b + TT]    +  Inv[b + TT]
     3111     B1-Overturn[b + TT]    = B1-Overturn[b + TT]    +  Overturn[b + TT]
     3112     B2-Overturn[b + TT]    = B2-Overturn[b + TT]    +  Overturn[b + TT]
     3113     Bi-Overturn[b + TT]    = Bi-Overturn[b + TT]    +  Overturn[b + TT]
     3114     Bo-Overturn[b + TT]    = Bo-Overturn[b + TT]    +  Overturn[b + TT] .
     3115   End.
     3116   END PROCEDURE.
     3117   PROCEDURE Clear-item :
     3118   define variable kk as int no-undo.
     3119    gds-zap-other = 0 .
     3120    REPEAT kk = 1 to 9 :
     3121    Assign
     3122       prih            [kk]    = 0
     3123       rash            [kk]    = 0
     3124       kassa           [kk]    = 0
     3125       Inv             [kk]    = 0
     3126       Overturn        [kk]    = 0
     3127       ostatok-end     [kk]    = 0
     3128       ostatok-start   [kk]    = 0 .
     3129          End.
     3130    END PROCEDURE.
     3131   PROCEDURE Item-Goods :
     3132      define input parameter  par-3 as char no-undo.
     3133      define input parameter  par-4 as char no-undo.
     3134        if par-4 = "goods":U  Then DO:
     3135           assign
     3136               gds-zap-unit-base  = Goods.unit-base
     3137               gds-zap-prt-root   = Goods.prt-root
     3138               gds-zap-prod-type  = Goods.prod-type
     3139               gds-zap-prod-code  = Goods.prod-code
     3140               gds-zap-artic      = Goods.artic
     3141               gds-zap-grp-name   = Goods.grp-name
     3142               gds-zap-b-code     = Goods.gds-code
     3143               gds-zap-type       = Goods.gds-type.
     3144           if g#gds-engl then
     3145               assign gds-zap-gds-name = Goods.engl-name.
     3146           else
     3147               assign gds-zap-gds-name = Goods.gds-name.
     3148        End.
     3149        if par-4 = "gds-list":U  Then DO:
     3150           assign
     3151               gds-zap-unit-base  = gds-list.unit-base
     3152               gds-zap-prt-root   = gds-list.prt-root
     3153               gds-zap-prod-type  = gds-list.prod-type
     3154               gds-zap-prod-code  = gds-list.prod-code
     3155               gds-zap-artic      = gds-list.artic
     3156               gds-zap-grp-name   = gds-list.grp-name
     3157               gds-zap-b-code     = gds-list.gds-code
     3158               gds-zap-type       = gds-list.gds-type.
     3159           if g#gds-engl then
     3160               assign gds-zap-gds-name = gds-list.engl-name.
     3161           else
     3162               assign gds-zap-gds-name = gds-list.gds-name.
     3163        End.
     3164       run foreach.
     3165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3166     (input  gds-zap-b-code
     3167     ,input  ?
     3168     ,output v-bar-code
     3169     )  .
     3170   s-bar-code = string (v-bar-code,"999999999").
     3171       If  break_group = true  and par-3 <> "1"  then DO :
     3172            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3173            gds-zap-prod-name  = clients.obj-name.
     3174             If break_group1 = true  THEN  DO :
     3175               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3176                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3177                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3178               if par-3 = "6"  then  dO:
     3179                  if xTog-obj = true then do:
     3180                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3181                     .
     3182                   end.
     3183                  else do:
     3184                   var-vat-pc = temp-gds-list.vat-pc .
     3185                   end.
     3186                   assign
     3187                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3188                       b1-name = temp-str.
     3189                   end.
     3190               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3191                   fr0 = true .
     3192                   tmp#stroka0 = temp-str.
     3193               End.
     3194             End.
     3195               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3196                 if par-3 = "4"
     3197                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3198                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3199                 if NOT xSumsOnly THEN DO:
     3200                     fr = true .
     3201                 End.
     3202                 break_group1 = false.
     3203               END.
     3204          break_group = false.
     3205       End.
     3206       run display-line.
     3207    END PROCEDURE.
     3208   PROCEDURE Di :
     3209   define input parameter p1 as char no-undo.
     3210   define input parameter p2 as int no-undo.
     3211   define input parameter p3 as char no-undo.
     3212   define input parameter p4 as char no-undo.
     3213   define input parameter p5 as char no-undo.
     3214   define input parameter p6 as char no-undo.
     3215   define input parameter p7 as char no-undo.
     3216    CASE CAPS(p7) :
     3217      WHEN "B1":U  Then DO:
     3218       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3219         p3 @ s-bar-code
     3220         p4 @ gds-zap-artic
     3221         p5 @ gds-zap-gds-name
     3222         p6 @ gds-zap-unit-base
     3223         p1 @ gds-type
     3224         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3225         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3226         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3227         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3228         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3229         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3230         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3231         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3232         with FRAME ZAPAS .
     3233                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3234                   End.
     3235      WHEN "B2":U  Then  DO:
     3236       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3237         p3 @ s-bar-code
     3238         p4 @ gds-zap-artic
     3239         p5 @ gds-zap-gds-name
     3240         p6 @ gds-zap-unit-base
     3241         p1 @ gds-type
     3242         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3243         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3244         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3245         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3246         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3247         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3248         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3249         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3250         with FRAME ZAPAS .
     3251                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3252                 End.
     3253      WHEN "BI":U Then  DO:
     3254       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3255         p3 @ s-bar-code
     3256         p4 @ gds-zap-artic
     3257         p5 @ gds-zap-gds-name
     3258         p6 @ gds-zap-unit-base
     3259         p1 @ gds-type
     3260         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3261         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3262         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3263         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3264         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3265         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3266         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3267         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3268         with FRAME ZAPAS .
     3269                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3270                 End.
     3271      WHEN "BO":U Then  DO:
     3272       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3273         p3 @ s-bar-code
     3274         p4 @ gds-zap-artic
     3275         p5 @ gds-zap-gds-name
     3276         p6 @ gds-zap-unit-base
     3277         p1 @ gds-type
     3278         bo-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3279         bo-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3280         bo-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3281         bo-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3282         bo-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3283         bo-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3284         bo-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3285         bo-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3286         with FRAME ZAPAS .
     3287                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3288                 End.
     3289      WHEN ""  Then  DO:
     3290       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3291         p3 @ s-bar-code
     3292         p4 @ gds-zap-artic
     3293         p5 @ gds-zap-gds-name
     3294         p6 @ gds-zap-unit-base
     3295         p1 @ gds-type
     3296         ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
