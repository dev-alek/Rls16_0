     1894             INPUT   Fact-order-2,
     1895             input   'sasr':U    ,
     1896             input   '##,##':U,
     1897             input   ""    ,
     1898             input   xTog-obj) .
     1899        End.
     1900       when 'т':U THEN DO:
     1901         run ob-line (
     1902             input   x-store-code   ,
     1903             input   x-store-type   ,
     1904             INPUT   gds-zap-artic       ,
     1905             INPUT   gds-zap-prod-code   ,
