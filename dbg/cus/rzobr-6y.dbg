     1515       HEADER
     1516           string( "Дата печати : " + string(TODAY,"99.99.9999") +  " , " + string(TIME, "HH:MM") ) AT 5 format "X(35)"
     1517           "Цены указаны в" (if tPrintRubl then "РУБ" else x-base-type )
     1518           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>>9") ) AT 147 format "X(53)" SKIP
     1519           Line format "X(194)" AT 1
     1520      with width 232 down stream-io use-text NO-BOX.
