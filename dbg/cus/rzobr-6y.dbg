     1908             INPUT   Fact-order-2,
     1909             input   'sale':U    ,
     1910             input   '##,##':U,
     1911             input   ""    ,
     1912             input   xTog-obj) .
     1913         End.
     1914             End case.
     1915        run calc-sub-itog (6).
     1916        End.
     1917   END PROCEDURE.
     1918   PROCEDURE display-line :
     1919        i = i + 1.
     1920           if NOT( NOT Show-Negativ-2 and
     1921            ( prih         [1]   = 0 AND
     1922             rash          [1]   = 0 AND
     1923             kassa         [1]   = 0 AND
     1924             Inv           [1]   = 0 AND
     1925             Overturn      [1]   = 0 AND
     1926             Overturn      [5]   = 0 AND
     1927             Overturn      [8]   = 0 ) ) then DO:
     1928           IF  NOT (NOT Show-Negativ  AND (
     1929                 prih          [1]   = 0 AND
     1930                 rash          [1]   = 0 AND
     1931                 kassa         [1]   = 0 AND
     1932                 Inv           [1]   = 0 AND
     1933                 Overturn      [1]   = 0 AND
     1934                 Overturn      [5]   = 0 AND
     1935                 ostatok-start [1]   = 0 AND
     1936                 ostatok-End   [1]   = 0   )) then DO:
     1937           IF NOT Sums-Only then DO:
     1938               if fr0 = true then do:
     1939                 PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     1940                 if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     1941                 fr0 = false .
     1942               end.
     1943               if fr = true then dO:
     1944                 PUT stream OutStream space(10) temp-str format "X(100)" SKIP.
     1945                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) String(temp-str) skip.
     1946                 fr = false .
     1947               end.
     1948              run display-str1 in this-procedure.
     1949             End.
     1950           End.
     1951        END.
     1952     END PROCEDURE.
     1953   PROCEDURE print-header :
     1954   if NOT FirstLine Then DO:
     1955      run display-title.
     1956      FORM with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1957   End.
     1958    FirstLine = TRUE .
     1959       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     1960             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name)  AT 30 format "X(170)" SKIP.
     1961             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name) format "X(170)" SKIP.
     1962         End.
     1963         run clear-b1 .
     1964         run clear-b2.
     1965         run clear-bi .
     1966         break_group = true.
     1967         break_group1 = true.
     1968      END PROCEDURE.
     1969   PROCEDURE Print-Footer :
     1970         If RetClassify = "no-classify":U  then run u-line.
     1971          gds-zap-artic = "ИТОГО" .
     1972          run display-bi.
     1973          run u-line.
     1974          END PROCEDURE.
     1975   PROCEDURE U-LINE :
     1976   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1977           s-bar-code
     1978           gds-zap-artic
     1979           gds-zap-gds-name
     1980           gds-zap-unit-base
     1981           gds-type
     1982           F-ostatok-start
     1983           F-Prih
     1984           F-Rash
     1985           F-KAssa
     1986           F-Inv
     1987           F-Overturn
     1988           F-ostatok-end
     1989           gds-zap-other
     1990           with FRAME ZAPAS .
     1991           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1992           END PROCEDURE.
     1993   PROCEDURE P-LINE :
     1994   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1995           gds-zap-artic
     1996           gds-zap-gds-name
     1997           gds-zap-unit-base
     1998           gds-type
     1999           F-ostatok-start
     2000           F-Prih
     2001           F-Rash
     2002           F-KAssa
     2003           F-Inv
     2004           F-Overturn
     2005           F-ostatok-end
     2006           gds-zap-other
     2007           with FRAME ZAPAS .
     2008           DOWN stream   OutStream 1 with FRAME ZAPAS.
     2009           END PROCEDURE.
