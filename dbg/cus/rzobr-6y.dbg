     3625         Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     3626         Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     3627         Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     3628         gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     3629         with FRAME ZAPAS .
     3630   if Make-Excel then  put   stream ForExcel unformatted
     3631     p3 CHR(9)
     3632     p4 CHR(9)
     3633     gds-zap-gds-name CHR(9)
     3634     p6 CHR(9)
     3635     gds-zap-type     CHR(9)
     3636     excel-sum(gds-zap-other   )   CHR(9)
     3637     excel-qnty(ostatok-start[1])  CHR(9)
     3638     excel-sum(ostatok-start[2])  CHR(9)
     3639     excel-sum(ostatok-start[5])  CHR(9)
     3640     excel-sum(ostatok-start[8])  CHR(9)
     3641     excel-sum(ostatok-start[3])  CHR(9)
     3642     excel-sum(ostatok-start[6])  CHR(9)
     3643     excel-sum(ostatok-start[9])  CHR(9)
     3644     excel-qnty(Prih         [1])  CHR(9)
     3645     excel-sum(Prih         [2])  CHR(9)
     3646     excel-sum(Prih         [5])  CHR(9)
     3647     excel-sum(Prih         [8])  CHR(9)
     3648     excel-sum(Prih         [3])  CHR(9)
     3649     excel-sum(Prih         [6])  CHR(9)
     3650     excel-sum(Prih         [9])  CHR(9)
     3651     excel-qnty(RAsh         [1])  CHR(9)
     3652     excel-sum(RAsh         [2])  CHR(9)
     3653     excel-sum(RAsh         [5])  CHR(9)
     3654     excel-sum(RAsh         [8])  CHR(9)
     3655     excel-sum(RAsh         [3])  CHR(9)
     3656     excel-sum(RAsh         [6])  CHR(9)
     3657     excel-sum(RAsh         [9])  CHR(9)
     3658     excel-qnty(KAssa        [1])  CHR(9)
     3659     excel-sum(KAssa        [2])  CHR(9)
     3660     excel-sum(KAssa        [5])  CHR(9)
     3661     excel-sum(KAssa        [8])  CHR(9)
     3662     excel-sum(KAssa        [3])  CHR(9)
     3663     excel-sum(KAssa        [6])  CHR(9)
     3664     excel-sum(KAssa        [9])  CHR(9)
     3665     excel-qnty(Inv          [1])  CHR(9)
     3666     excel-sum(Inv          [2])  CHR(9)
     3667     excel-sum(Inv          [5])  CHR(9)
     3668     excel-sum(Inv          [8])  CHR(9)
     3669     excel-sum(Inv          [3])  CHR(9)
     3670     excel-sum(Inv          [6])  CHR(9)
     3671     excel-sum(Inv          [9])  CHR(9)
     3672     excel-qnty(Overturn     [1])  CHR(9)
     3673     excel-sum(Overturn     [2])  CHR(9)
     3674     excel-sum(Overturn     [5])  CHR(9)
     3675     excel-sum(Overturn     [8])  CHR(9)
     3676     excel-sum(Overturn     [3])  CHR(9)
     3677     excel-sum(Overturn     [6])  CHR(9)
     3678     excel-sum(Overturn     [9])  CHR(9)
     3679     excel-qnty(Ostatok-end  [1])  CHR(9)
     3680     excel-sum(Ostatok-end  [2])  CHR(9)
     3681     excel-sum(Ostatok-end  [5])  CHR(9)
     3682     excel-sum(Ostatok-end  [8])  CHR(9)
     3683     excel-sum(Ostatok-end  [3])  CHR(9)
     3684     excel-sum(Ostatok-end  [6])  CHR(9)
     3685     excel-sum(Ostatok-end  [9])  CHR(9)
     3686     skip.
     3687                 End.
     3688      End case.
     3689                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3690    END PROCEDURE.
