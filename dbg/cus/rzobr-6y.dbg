     2538   PROCEDURE display-B1  :
     2539         if NOT( NOT Show-Negativ-2 and
     2540            ( b1-prih         [1]   = 0 AND
     2541              b1-rash          [1]   = 0 AND
     2542              b1-kassa         [1]   = 0 AND
     2543              b1-Inv           [1]   = 0 AND
     2544              b1-Overturn      [1]   = 0 AND
     2545              b1-Overturn      [5]   = 0 AND
     2546              b1-Overturn      [8]   = 0 ) ) then DO:
     2547           IF  NOT (NOT Show-Negativ  AND (
     2548                 b1-prih          [1]   = 0 AND
     2549                 b1-rash          [1]   = 0 AND
     2550                 b1-kassa         [1]   = 0 AND
     2551                 b1-Inv           [1]   = 0 AND
     2552                 b1-Overturn      [1]   = 0 AND
     2553                 b1-Overturn      [5]   = 0 AND
     2554                 b1-ostatok-start [1]   = 0 AND
     2555                 b1-ostatok-End   [1]   = 0   )) then DO:
     2556                 if Sums-Only THEN do:
     2557                     if fr0 = true then do:
     2558                         PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2559                         if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     2560                         fr0 = false .
     2561                       end.
     2562                  end.
     2563           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2564           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2565           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2566           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2567           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2568           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2569           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2570          if not sums-only then run p-line.
     2571    End.
     2572    end.
     2573   END PROCEDURE.
