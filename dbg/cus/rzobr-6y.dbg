     2476   PROCEDURE CalcItog :
     2477       run ostatok (
     2478           input x-store-code  ,
     2479           input x-store-type  ,x-TOG-Shift,
     2480           input x-date-start - 1 ,
     2481           input date('')      , x-Shift-Start,x-Shift-End,
     2482           input 'crsa':U   ,
     2483           input '##,##':U,
     2484           input xTog-obj ,
     2485           output  Quantity1  ,
     2486           output  Coast_R1   ,
     2487           output  Coast_V1   ,
     2488           output  VAT_R1     ,
     2489           output  VAT_V1     ,
     2490           output  Fact-order-1 ).
     2491       run ostatok (
     2492           input x-store-code  ,
     2493           input x-store-type  , x-TOG-Shift,
     2494           input x-date-start  ,
     2495           input x-date-end    , x-Shift-Start,x-Shift-End,
     2496           input 'crsa':U   ,
     2497           input '##,##':U,
     2498           input xTog-obj ,
     2499           output  Quantity1  ,
     2500           output  Coast_R1   ,
     2501           output  Coast_V1   ,
     2502           output  VAT_R1     ,
     2503           output  VAT_V1     ,
     2504           output  Fact-order-2 ).
     2505             Quantity1  = 0.
     2506             Coast_R1   = 0.
     2507             Coast_V1   = 0.
     2508             VAT_R1     = 0.
     2509             VAT_V1     = 0.
     2510   END PROCEDURE.
     2511   PROCEDURE display-str1  :
     2512              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2513            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2514            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2515            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     2516            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2517            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     2518            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     2519   end procedure.
