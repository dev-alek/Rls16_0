        1   define input parameter t-action   as character no-undo.
        2   define input parameter x-cli-type like ub.ord-blank.cli-type no-undo.
        3   define input parameter x-cli-code like ub.ord-blank.cli-code no-undo.
        4   define input parameter rec-blank  as recid no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":u .
        6   define variable vss-author      as character no-undo init "$Author$":u .
        7   define variable vss-date        as character no-undo init "$Date$":u .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        9   define variable vss-archive     as character no-undo init "$Archive$":u .
       10   define variable vss-description as character no-undo init "Бланк заказа" .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON B-Excel AUTO-GO
      115        LABEL "Excel"
      116        SIZE 10 BY 1 TOOLTIP "Создание или корректировка шаблона бланка"
      117        BGCOLOR 8 .
      118   DEFINE BUTTON B-exit AUTO-END-KEY
      119        LABEL "&Отмена"
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON B-find
      123        IMAGE-UP FILE "btn-down-arrow":U
      124        IMAGE-DOWN FILE "btn-down-arrow":U
      125        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      126        LABEL "B-find"
      127        SIZE 3.13 BY 1.13 TOOLTIP "Поиск файла".
      128   DEFINE BUTTON B-Help
      129        LABEL "Помощь"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON B-OK AUTO-GO
      133        LABEL "&Ввод"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE RECTANGLE RECT-1
      137        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      138        SIZE 67.38 BY 2.96.
      139   DEFINE QUERY Dialog-Frame FOR
      140         ub.ord-blank SCROLLING.
      141   DEFINE FRAME Dialog-Frame
      142        B-OK AT ROW 1 COL 1
      143        B-exit AT ROW 1 COL 11
      144        B-Excel AT ROW 1 COL 21
      145        B-Help AT ROW 1 COL 59
      146        ub.ord-blank.blank-name AT ROW 2.63 COL 2.63 FORMAT "X(40)"
      147             VIEW-AS FILL-IN
      148             SIZE 52.25 BY 1
      149        B-find AT ROW 3.88 COL 65.25
      150        ub.ord-blank.File-name AT ROW 3.92 COL 1.63
      151             LABEL "Имя файла"
      152             VIEW-AS FILL-IN
      153             SIZE 52.25 BY 1 TOOLTIP "Полное Имя файла-шаблона Excel(*.xlt)"
      154        RECT-1 AT ROW 2.33 COL 1.38
      155        SPACE(0.23) SKIP(0.24)
      156       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      157            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      158            TITLE "Бланк заказа"
      159            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-exit.
      160   ASSIGN
      161          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      162          FRAME Dialog-Frame:HIDDEN           = TRUE.
      163   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      164   DO:
      165     APPLY "END-ERROR":U TO SELF.
      166   END.
      167   ON CHOOSE OF B-Excel IN FRAME Dialog-Frame
      168   DO:
      169   DEFINE VARIABLE chExcelApplication      AS COM-HANDLE no-undo .
      170   DEFINE VARIABLE chWorkbook              AS COM-HANDLE no-undo .
      171     CREATE "Excel.Application" chExcelApplication.
      172   assign
      173      chExcelApplication:Visible = TRUE
      174      chWorkbook = chExcelApplication:Workbooks:Open( ub.ord-blank.file-name:screen-value , TRUE , false , , ,TRUE,TRUE , TRUE, TRUE ,TRUE, TRUE, TRUE ,TRUE)
      175      no-error .
      176   RELEASE OBJECT chWorkbook NO-ERROR.
      177   chExcelApplication :QUIT().
      178   RELEASE OBJECT  chExcelApplication  NO-ERROR.
      179    return no-apply.
      180   END.
      181   ON CHOOSE OF B-find IN FRAME Dialog-Frame
      182   DO:
      183   DEFINE VARIABLE OKpressed AS LOGICAL INITIAL TRUE no-undo.
      184   DEFINE VARIABLE ff AS char no-undo.
      185   if avail ub.ord-blank  then ff = ub.ord-blank.File-name.
      186   SYSTEM-DIALOG GET-FILE ff
      187       TITLE      "Выберите шаблон ..."
      188       FILTERS    "Excel-шаблон (*.xlt)"   "*.xlt"
      189                    USE-FILENAME
      190                    UPDATE OKpressed.
      191                    IF OKpressed = TRUE THEN DO:
      192                    ub.ord-blank.File-name:screen-value in frame Dialog-Frame = ff .
      193                    END.
      194   END.
      195   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      196   DO:
      197    Case t-action.
      198         when "add":U then DO:
      199         Create ub.ord-blank.
      200         Assign ub.ord-blank.File-name ub.ord-blank.blank-name .
      201         Assign
      202           ub.ord-blank.cli-code   = x-cli-code
      203           ub.ord-blank.cli-type   = x-cli-type.
      204         End.
      205         when "chg":U then DO:
      206           Assign ub.ord-blank.File-name ub.ord-blank.blank-name .
      207         End.
      208   End case.
      209   END.
      210   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   on help of frame Dialog-Frame
      212   do:
      213     run gbl/app_help.p
      214       (input this-procedure :file-name
      215       ,input ''
      216       ,input ?
      217       ) no-error.
      218     if error-status :error then do:
      219       message
      220         "Ошибка при вызове помощи"
      221         error-status :get-message(1)
      222         view-as alert-box .
      223     end.
      224   end.
      225   run minbtn-set in this-procedure .
      226   on choose of b-help in frame Dialog-Frame
      227   do:
      228     apply "help":u to frame Dialog-Frame .
      229   end.
      230   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      231   procedure minbtn-set :
      232       do
      233           on error undo, return error return-value
      234           :
      235           define variable ii              as integer       no-undo .
      236           define variable fh              as widget-handle no-undo .
      237           define variable hh              as widget-handle no-undo .
      238           define variable v-h             as handle        extent 4 no-undo .
      239           define variable v-name-button   as character     no-undo .
      240           define variable v-help-old-x    as decimal       no-undo .
      241           define variable v-help-old-y    as decimal       no-undo .
      242           define variable v-help-old-size as decimal       no-undo .
      243           define variable v-frame-width   as decimal       no-undo .
      244           define variable jj              as integer       no-undo .
      245           do
      246               on error undo, return error
      247               :
      248               assign
      249                   v-frame-width = frame Dialog-Frame:width - 0.3
      250                   fh            = frame Dialog-Frame:first-child
      251                   hh            = fh:first-child
      252                   ii            = 1
      253                   .
      254               do while valid-handle(hh):
      255                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      256                   do:
      257                       case lc(hh:name) :
      258                           when "b-help" then
      259                               do:
      260                                   hh:load-image-up("cmp/b-help.bmp":u) .
      261                                   hh:load-image-down("cmp/b-help.bmp":u) .
      262                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      263                                   hh:TOOLTIP = "Помощь" .
      264                                   v-help-old-x = hh:column .
      265                                   v-help-old-y = hh:row    .
      266                                   v-help-old-size = hh:width .
      267                                   hh:width-chars = 2.5 .
      268                               end.
      269                           when "b-print" then
      270                               do:
      271                                   hh:load-image("cmp/b-print.bmp":u) .
      272                                   hh:TOOLTIP = "Печать" .
      273                                   v-h[ii] = hh:handle .
      274                                   ii = ii + 1 .
      275                                   hh:width-chars = 3 .
      276                               end.
      277                           when "b-history" or
      278                           when "b-hist" then
      279                               do:
      280                                   hh:load-image("cmp/b-hist.bmp":u) .
      281                                   hh:TOOLTIP = "История" .
      282                                   v-h[ii] = hh:handle .
      283                                   ii = ii + 1 .
      284                                   hh:width-chars = 3 .
      285                               end.
      286                           when "b-sch" then
      287                               do:
      288                                   hh:load-image("cmp/b-sch.bmp":u) .
      289                                   hh:TOOLTIP = "Установка Фильтра" .
      290                                   v-h[ii] = hh:handle .
      291                                   ii = ii + 1 .
      292                                   hh:width-chars = 3 .
      293                               end.
      294                           when "b-hist-user" then
      295                               do:
      296                                   hh:load-image("cmp/b-hist.bmp":u) .
      297                                   hh:TOOLTIP = "История пользователя" .
      298                                   ii = ii + 1 .
      299                               end.
      300                       end case.
      301                   end.
      302                   hh = hh:next-sibling.
      303               end.
      304               b-help:column = v-frame-width - b-help:width-chars.
      305               jj = 0.
      306               repeat ii = 4 to 1 by -1 :
      307                   if valid-handle (v-h[ii] ) then
      308                   do:
      309                       jj  = jj + 1 .
      310                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      311                       v-h[ii]:row    = v-help-old-y .
      312                   end.
      313               end.
      314           end.
      315       end.
      316   end procedure.
      317   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      318   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      319    If t-action = "add":U THEN  frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE + " - " + 'ДОБАВЛЕНИЕ':U.
      320    If t-action = "chg":U THEN  frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE + " - " + 'ИЗМЕНЕНИЕ':U.
      321   Case t-action.
      322   when "add":U then DO:
      323         End.
      324   when "chg":U then DO:
      325         find first ub.ord-blank  WHERE recid(ub.ord-blank) = rec-blank  no-error.
      326        End.
      327   End.
      328   MAIN-BLOCK:
      329   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      330      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      331     run enable_UI in this-procedure .
      332     WAIT-FOR GO OF FRAME Dialog-Frame.
      333   END.
      334   run disable_UI in this-procedure .
      335   PROCEDURE disable_UI :
      336     HIDE FRAME Dialog-Frame.
      337   END PROCEDURE.
      338   PROCEDURE enable_UI :
      339     IF AVAILABLE ub.ord-blank THEN
      340       DISPLAY ub.ord-blank.blank-name ub.ord-blank.File-name
      341         WITH FRAME Dialog-Frame.
      342     ENABLE B-OK RECT-1 B-exit B-Excel B-Help ub.ord-blank.blank-name B-find
      343            ub.ord-blank.File-name
      344         WITH FRAME Dialog-Frame.
      345     VIEW FRAME Dialog-Frame.
      346   END PROCEDURE.
