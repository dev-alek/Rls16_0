        1   define temp-table tt_ord-line-rcv no-undo like ub.ord-line-rcv.
        2   define input parameter parparentproc  as widget-handle no-undo.
        3   define input parameter p-mode         as character no-undo.
        4   define input parameter p-doc-code as character no-undo .
        5   define input parameter p-gds-code as int no-undo .
        6   define input  parameter table for tt_ord-line-rcv .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-Workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Список поставок одного товара по заказу" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define buffer buf_goods for ub.goods.
      128   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
      129   define buffer buf_clients for ub.clients  .
      130   DEFINE new shared BUFFER bufs_ord-doc-rcv FOR ub.ord-doc-rcv.
      131   define new shared variable next-prev     as logical   no-undo .
      132   define new shared variable br-rcv-handle as handle no-undo   .
      133   DEFINE BUTTON B-exit AUTO-GO
      134        LABEL "&Ввод"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON B-Help
      138        LABEL "&Help"
      139        SIZE 10 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON B-print
      142        LABEL "&Печать"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE BUTTON B-quit AUTO-END-KEY
      146        LABEL "&Отмена"
      147        SIZE 10 BY 1
      148        BGCOLOR 8 .
      149   DEFINE BUTTON B-rcv
      150        LABEL "&Поставка"
      151        SIZE 10 BY 1 TOOLTIP "Просмотр Поставки"
      152        BGCOLOR 8 .
      153   DEFINE VARIABLE v-goods AS CHARACTER FORMAT "X(256)":U
      154        LABEL "Товар"
      155         VIEW-AS TEXT
      156        SIZE 90.5 BY .67
      157        FGCOLOR 1  NO-UNDO.
      158   DEFINE QUERY BROWSE-3 FOR
      159         tt_ord-line-rcv,
      160         buf_ord-doc-rcv,
      161         buf_clients SCROLLING.
      162   DEFINE BROWSE BROWSE-3
      163     QUERY BROWSE-3 NO-LOCK DISPLAY
      164         tt_ord-line-rcv.rcv-code COLUMN-LABEL "N поставки" FORMAT "X(16)":U
      165         buf_ord-doc-rcv.status_ COLUMN-LABEL "Статус" FORMAT "X(6)":U
      166         tt_ord-line-rcv.qnty  COLUMN-LABEL "По поставкам" FORMAT ">>>,>>>,>>>,>>9.999":U
      167         buf_clients.obj-type + string (buf_clients.obj-code) COLUMN-LABEL "Код" FORMAT "X(10)":U
      168         buf_clients.obj-name  COLUMN-LABEL "Поставщик" FORMAT "X(10)":U
      169         buf_ord-doc-rcv.ship-date COLUMN-LABEL "Доставка" FORMAT "99/99/99":U
      170         string(buf_ord-doc-rcv.ship-time,"hh:mm") COLUMN-LABEL "Время" FORMAT "X(5)":U
      171         buf_ord-doc-rcv.fact-date COLUMN-LABEL "Факт" FORMAT "99/99/99":U
      172         string(buf_ord-doc-rcv.fact-ship-time,"hh:mm") COLUMN-LABEL "Время-факт" FORMAT "X(5)":U
      173       WITH NO-ROW-MARKERS SEPARATORS SIZE 99.25 BY 10.75 FIT-LAST-COLUMN.
      174   DEFINE FRAME Dialog-Frame
      175        B-exit AT ROW 1 COL 1
      176        B-quit AT ROW 1 COL 11
      177        B-rcv AT ROW 1 COL 21 WIDGET-ID 52
      178        B-print AT ROW 1 COL 80 WIDGET-ID 56
      179        B-Help AT ROW 1 COL 90
      180        BROWSE-3 AT ROW 3 COL 1 WIDGET-ID 200
      181        v-goods AT ROW 2.25 COL 7.5 COLON-ALIGNED WIDGET-ID 58
      182        SPACE(0.24) SKIP(12.03)
      183       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      184            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      185            TITLE "Список поставок товара по заказу"
      186            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      187   ASSIGN
      188          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      189          FRAME Dialog-Frame:HIDDEN           = TRUE.
      190   ON GO OF FRAME Dialog-Frame
      191   DO:
      192     run save-proc in this-procedure no-error.
      193     if error-status :error then return no-apply.
      194   END.
      195   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      196   DO:
      197     APPLY "END-ERROR":U TO SELF.
      198   END.
      199   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      200   DO:
      201     if not available tt_ord-line-rcv then return no-apply.
      202   END.
      203   ON CHOOSE OF B-rcv IN FRAME Dialog-Frame
      204   DO:
      205     define variable v-rec as recid no-undo .
      206     if not available tt_ord-line-rcv then return no-apply.
      207     find first buf_ord-doc-rcv no-lock where
      208                buf_ord-doc-rcv.doc-code  = tt_ord-line-rcv.doc-code and
      209                buf_ord-doc-rcv.rcv-code  = tt_ord-line-rcv.rcv-code no-error .
      210     if not available buf_ord-doc-rcv then return no-apply.
      211     v-rec = recid(buf_ord-doc-rcv) .
      212     run cus/lkp-rcv.w (input parParentProc, input-output v-rec) .
      213   END.
      214   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      215   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      216   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      217   on help of frame Dialog-Frame
      218   do:
      219     run gbl/app_help.p
      220       (input this-procedure :file-name
      221       ,input ''
      222       ,input ?
      223       ) no-error.
      224     if error-status :error then do:
      225       message
      226         "Ошибка при вызове помощи"
      227         error-status :get-message(1)
      228         view-as alert-box .
      229     end.
      230   end.
      231   run minbtn-set in this-procedure .
      232   on choose of b-help in frame Dialog-Frame
      233   do:
      234     apply "help":u to frame Dialog-Frame .
      235   end.
      236   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   procedure minbtn-set :
      238       do
      239           on error undo, return error return-value
      240           :
      241           define variable ii              as integer       no-undo .
      242           define variable fh              as widget-handle no-undo .
      243           define variable hh              as widget-handle no-undo .
      244           define variable v-h             as handle        extent 4 no-undo .
      245           define variable v-name-button   as character     no-undo .
      246           define variable v-help-old-x    as decimal       no-undo .
      247           define variable v-help-old-y    as decimal       no-undo .
      248           define variable v-help-old-size as decimal       no-undo .
      249           define variable v-frame-width   as decimal       no-undo .
      250           define variable jj              as integer       no-undo .
      251           do
      252               on error undo, return error
      253               :
      254               assign
      255                   v-frame-width = frame Dialog-Frame:width - 0.3
      256                   fh            = frame Dialog-Frame:first-child
      257                   hh            = fh:first-child
      258                   ii            = 1
      259                   .
      260               do while valid-handle(hh):
      261                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      262                   do:
      263                       case lc(hh:name) :
      264                           when "b-help" then
      265                               do:
      266                                   hh:load-image-up("cmp/b-help.bmp":u) .
      267                                   hh:load-image-down("cmp/b-help.bmp":u) .
      268                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      269                                   hh:TOOLTIP = "Помощь" .
      270                                   v-help-old-x = hh:column .
      271                                   v-help-old-y = hh:row    .
      272                                   v-help-old-size = hh:width .
      273                                   hh:width-chars = 2.5 .
      274                               end.
      275                           when "b-print" then
      276                               do:
      277                                   hh:load-image("cmp/b-print.bmp":u) .
      278                                   hh:TOOLTIP = "Печать" .
      279                                   v-h[ii] = hh:handle .
      280                                   ii = ii + 1 .
      281                                   hh:width-chars = 3 .
      282                               end.
      283                           when "b-history" or
      284                           when "b-hist" then
      285                               do:
      286                                   hh:load-image("cmp/b-hist.bmp":u) .
      287                                   hh:TOOLTIP = "История" .
      288                                   v-h[ii] = hh:handle .
      289                                   ii = ii + 1 .
      290                                   hh:width-chars = 3 .
      291                               end.
      292                           when "b-sch" then
      293                               do:
      294                                   hh:load-image("cmp/b-sch.bmp":u) .
      295                                   hh:TOOLTIP = "Установка Фильтра" .
      296                                   v-h[ii] = hh:handle .
      297                                   ii = ii + 1 .
      298                                   hh:width-chars = 3 .
      299                               end.
      300                           when "b-hist-user" then
      301                               do:
      302                                   hh:load-image("cmp/b-hist.bmp":u) .
      303                                   hh:TOOLTIP = "История пользователя" .
      304                                   ii = ii + 1 .
      305                               end.
      306                       end case.
      307                   end.
      308                   hh = hh:next-sibling.
      309               end.
      310               b-help:column = v-frame-width - b-help:width-chars.
      311               jj = 0.
      312               repeat ii = 4 to 1 by -1 :
      313                   if valid-handle (v-h[ii] ) then
      314                   do:
      315                       jj  = jj + 1 .
      316                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      317                       v-h[ii]:row    = v-help-old-y .
      318                   end.
      319               end.
      320           end.
      321       end.
      322   end procedure.
      323   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      324   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      325   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      326   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      327   define variable v-diasize-current-frame-width  as decimal   no-undo .
      328   define variable v-diasize-current-frame-height as decimal   no-undo .
      329   define variable v-diasize-change-size          as logical   no-undo .
      330   define variable v-diasize-resize-button        as handle    no-undo .
      331   define variable v-diasize-wndmax               as logical   no-undo .
      332   define variable v-diasize-wndstore             as logical   no-undo .
      333   define variable v-diasize-proc-name            as character no-undo .
      334   define variable v-diasize-browse-handle        as handle    no-undo .
      335   define variable v-diasize-browse-number        as integer   no-undo .
      336   define variable v-diasize-need-full-display    as logical   no-undo init false .
      337   define temp-table temp-diasize-handle no-undo
      338     field handle-value  as handle
      339     field save-position as decimal
      340     index xpk is primary unique handle-value
      341     .
      342   define temp-table temp-browse-handle no-undo
      343     field browse-type   as character
      344     field browse-number as integer
      345     field browse-handle as handle
      346     field original-size as decimal
      347     index xpk is primary unique browse-type browse-number
      348     index xie browse-type browse-handle
      349   .
      350   procedure diasize_change-height :
      351     define input  parameter p-change-value  as decimal   no-undo .
      352     define input  parameter p-move-resize   as logical   no-undo .
      353     define variable v-field-group-handle    as handle    no-undo .
      354     define variable v-object-handle         as handle    no-undo .
      355     define variable v-frame-height          as decimal   no-undo .
      356     define variable v-frame-virtual-height  as decimal   no-undo .
      357     define variable v-browse-height         as decimal   no-undo .
      358     define variable v-window-height         as decimal   no-undo .
      359     define variable v-window-virtual-height as decimal   no-undo .
      360     define variable v-change-sign           as integer   no-undo .
      361     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      362     define buffer buf_temp-browse-handle  for temp-browse-handle .
      363     if p-change-value > 0
      364     then do:
      365       if frame Dialog-Frame :height + p-change-value
      366           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      367       then do:
      368         assign
      369           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      370                           - (frame Dialog-Frame :height-chars)
      371         .
      372         if p-change-value <= 0
      373         then do:
      374           run diasize_position-resize-button in this-procedure .
      375           return .
      376         end.
      377       end.
      378     end.
      379     if p-change-value < 0
      380     then do:
      381       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      382       then do:
      383         assign
      384           p-change-value = v-diasize-orig-frame-height
      385                          - (frame Dialog-Frame :height-chars)
      386         .
      387         if p-change-value >= 0
      388         then do:
      389           run diasize_position-resize-button in this-procedure .
      390           return .
      391         end.
      392       end.
      393     end.
      394     if p-change-value >= 0
      395     then do:
      396       assign
      397         v-change-sign = 1
      398       .
      399     end.
      400     else do:
      401       assign
      402         v-change-sign = -1
      403       .
      404     end.
      405     assign
      406       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      407     .
      408     if p-change-value = 0
      409     then do:
      410       run diasize_position-resize-button in this-procedure .
      411       return .
      412     end.
      413     move_block:
      414     do
      415     on error undo move_block, retry move_block
      416     :
      417       if retry
      418       then do:
      419         do
      420         on error undo move_block, leave move_block
      421         :
      422           if p-change-value > 0
      423           then do:
      424             for each buf_temp-diasize-handle
      425             on error undo, next
      426             :
      427               assign
      428                 v-object-handle = buf_temp-diasize-handle.handle-value
      429               .
      430               if v-object-handle <> v-diasize-resize-button
      431               then do:
      432                 assign
      433                   v-object-handle :row = buf_temp-diasize-handle.save-position
      434                 .
      435               end.
      436             end.
      437             assign
      438               v-diasize-browse-handle :height = v-browse-height
      439             .
      440             for each buf_temp-browse-handle
      441               where buf_temp-browse-handle.browse-type = 'height':u
      442             on error undo, next
      443             :
      444               assign
      445                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      446               .
      447             end.
      448             assign
      449               frame Dialog-Frame :height = v-frame-height
      450             .
      451             if frame Dialog-Frame :scrollable = true
      452             then do:
      453               assign
      454                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      455               .
      456             end.
      457             run diasize_position-resize-button in this-procedure .
      458           end.
      459           else do:
      460             if frame Dialog-Frame :scrollable = true
      461             then do:
      462               assign
      463                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      464               .
      465             end.
      466             assign
      467               frame Dialog-Frame :height = v-frame-height
      468             .
      469             assign
      470               v-diasize-browse-handle :height = v-browse-height
      471             .
      472             for each buf_temp-browse-handle
      473               where buf_temp-browse-handle.browse-type = 'height':u
      474             on error undo, next
      475             :
      476               assign
      477                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      478               .
      479             end.
      480             for each buf_temp-diasize-handle
      481             on error undo, next
      482             :
      483               assign
      484                 v-object-handle = buf_temp-diasize-handle.handle-value
      485               .
      486               if v-object-handle <> v-diasize-resize-button
      487               then do:
      488                 assign
      489                   v-object-handle :row = buf_temp-diasize-handle.save-position
      490                 .
      491               end.
      492             end.
      493             run diasize_position-resize-button in this-procedure .
      494           end.
      495           assign
      496             v-diasize-change-size = false
      497           .
      498           leave move_block .
      499         end.
      500       end.
      501       assign
      502         v-diasize-need-full-display = true
      503       .
      504       if v-diasize-change-size = false
      505       then do:
      506         assign
      507           v-diasize-change-size = true
      508         .
      509       end.
      510       else do:
      511         return .
      512       end.
      513       assign
      514         v-frame-height = frame Dialog-Frame :height
      515         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      516         v-browse-height = v-diasize-browse-handle :height
      517       .
      518       for each buf_temp-browse-handle
      519         where buf_temp-browse-handle.browse-type = 'height':u
      520       :
      521         assign
      522           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      523         .
      524       end.
      525       for each buf_temp-diasize-handle
      526       :
      527         delete buf_temp-diasize-handle .
      528       end.
      529       assign
      530         v-field-group-handle = frame Dialog-Frame :first-child
      531       .
      532       do while valid-handle(v-field-group-handle)
      533       :
      534         assign
      535           v-object-handle = v-field-group-handle :first-child
      536         .
      537         do while valid-handle(v-object-handle)
      538         :
      539           if  v-object-handle <> v-diasize-browse-handle :handle
      540           and can-query(v-object-handle, "row")
      541           and can-query(v-object-handle, "height")
      542           and ( v-object-handle :row > v-diasize-browse-handle :row )
      543           then do:
      544             find first buf_temp-browse-handle
      545               where buf_temp-browse-handle.browse-type   = 'height':u
      546                 and buf_temp-browse-handle.browse-handle = v-object-handle
      547               no-error .
      548             if available buf_temp-browse-handle
      549             then do:
      550             end.
      551             else do:
      552               create buf_temp-diasize-handle .
      553               assign
      554                 buf_temp-diasize-handle.handle-value  = v-object-handle
      555                 buf_temp-diasize-handle.save-position = v-object-handle :row
      556               .
      557             end.
      558           end.
      559           assign
      560             v-object-handle = v-object-handle :next-sibling
      561           .
      562         end.
      563         assign
      564           v-field-group-handle = v-field-group-handle :next-sibling
      565         .
      566       end.
      567       do with frame Dialog-Frame
      568       :
      569         hide v-diasize-resize-button .
      570         assign
      571           v-diasize-resize-button :row    = 1
      572           v-diasize-resize-button :column = 1
      573         .
      574       end.
      575       if p-change-value > 0
      576       then do:
      577         if frame Dialog-Frame :scrollable = true
      578         then do:
      579           assign
      580             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      581             no-error .
      582           if error-status :error
      583           or error-status :get-message(1) <> ""
      584           then do:
      585             undo move_block, retry move_block .
      586           end.
      587         end.
      588         assign
      589           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      590           no-error .
      591         if error-status :error
      592         or error-status :get-message(1) <> ""
      593         then do:
      594           undo move_block, retry move_block .
      595         end.
      596         assign
      597           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      598           no-error .
      599         if error-status :error
      600         or error-status :get-message(1) <> ""
      601         then do:
      602           undo move_block, retry move_block .
      603         end.
      604         for each buf_temp-browse-handle
      605           where buf_temp-browse-handle.browse-type = 'height':u
      606         on error undo move_block, retry move_block
      607         :
      608           assign
      609             buf_temp-browse-handle.browse-handle :height
      610               = buf_temp-browse-handle.browse-handle :height + p-change-value
      611             no-error .
      612           if error-status :error
      613           or error-status :get-message(1) <> ""
      614           then do:
      615             undo move_block, retry move_block .
      616           end.
      617         end.
      618         for each buf_temp-diasize-handle
      619         on error undo move_block, retry move_block
      620         :
      621           assign
      622             v-object-handle = buf_temp-diasize-handle.handle-value
      623           .
      624           if v-object-handle <> v-diasize-resize-button
      625           then do:
      626             assign
      627               v-object-handle :row = v-object-handle :row + p-change-value
      628               no-error .
      629             if error-status :error
      630             or error-status :get-message(1) <> ""
      631             then do:
      632               undo move_block, retry move_block .
      633             end.
      634           end.
      635         end.
      636       end.
      637       else do:
      638         for each buf_temp-diasize-handle
      639         on error undo move_block, retry move_block
      640         :
      641           assign
      642             v-object-handle = buf_temp-diasize-handle.handle-value
      643           .
      644           if v-object-handle <> v-diasize-resize-button
      645           then do:
      646             assign
      647               v-object-handle :row = v-object-handle :row + p-change-value
      648               no-error .
      649             if error-status :error
      650             or error-status :get-message(1) <> ""
      651             then do:
      652               undo move_block, retry move_block .
      653             end.
      654           end.
      655         end.
      656         assign
      657           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      658           no-error .
      659         if error-status :error
      660         or error-status :get-message(1) <> ""
      661         then do:
      662           undo move_block, retry move_block .
      663         end.
      664         for each buf_temp-browse-handle
      665           where buf_temp-browse-handle.browse-type = 'height':u
      666         on error undo move_block, retry move_block
      667         :
      668           assign
      669             buf_temp-browse-handle.browse-handle :height
      670               = buf_temp-browse-handle.browse-handle :height + p-change-value
      671             no-error .
      672           if error-status :error
      673           or error-status :get-message(1) <> ""
      674           then do:
      675             undo move_block, retry move_block .
      676           end.
      677         end.
      678         assign
      679           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      680           no-error .
      681         if error-status :error
      682         or error-status :get-message(1) <> ""
      683         then do:
      684           undo move_block, retry move_block .
      685         end.
      686         if frame Dialog-Frame :scrollable = true
      687         then do:
      688           assign
      689             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      690             no-error .
      691           if error-status :error
      692           or error-status :get-message(1) <> ""
      693           then do:
      694             undo move_block, retry move_block .
      695           end.
      696         end.
      697       end.
      698       if p-move-resize = true
      699       then do:
      700         run diasize_position-resize-button in this-procedure .
      701       end.
      702       if v-diasize-wndstore = true
      703       then do:
      704         if connected("ub") = true
      705         then do:
      706           define variable v-cntxt-db-num        as integer   no-undo .
      707           define variable v-cntxt-userid        as character no-undo .
      708           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      709                                             , OUTPUT v-cntxt-userid
      710                                             ) .
      711           run gbl/wndsizew.p
      712             (input  v-cntxt-db-num
      713             ,input  v-cntxt-userid
      714             ,input  v-diasize-proc-name
      715             ,input  'height':u
      716             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      717             ) .
      718         end.
      719       end.
      720     end.
      721     assign
      722       v-diasize-change-size = false
      723     .
      724   end procedure.
      725   procedure diasize_set-height :
      726     define input  parameter p-new-height  as decimal   no-undo .
      727     define input  parameter p-move-resize as logical   no-undo .
      728     do
      729     on error undo, return error return-value
      730     :
      731       run diasize_change-height in this-procedure
      732         (input  (p-new-height - frame Dialog-Frame :height)
      733         ,input  p-move-resize
      734         ) .
      735     end.
      736   end procedure.
      737   procedure diasize_change-width :
      738     define input  parameter p-change-value as decimal   no-undo .
      739     define input  parameter p-move-resize  as logical   no-undo .
      740     define variable v-field-group-handle   as handle    no-undo .
      741     define variable v-object-handle        as handle    no-undo .
      742     define variable v-frame-width          as decimal   no-undo .
      743     define variable v-frame-virtual-width  as decimal   no-undo .
      744     define variable v-browse-width         as decimal   no-undo .
      745     define variable v-window-width         as decimal   no-undo .
      746     define variable v-window-virtual-width as decimal   no-undo .
      747     define variable v-change-sign          as integer   no-undo .
      748     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      749     define buffer buf_temp-browse-handle  for temp-browse-handle .
      750     if p-change-value > 0
      751     then do:
      752       if frame Dialog-Frame :width + p-change-value >
      753           session :width-chars
      754       then do:
      755         assign
      756           p-change-value = session :width-chars - frame Dialog-Frame :width
      757         .
      758         if p-change-value <= 0
      759         then do:
      760           run diasize_position-resize-button in this-procedure .
      761           return .
      762         end.
      763       end.
      764     end.
      765     if p-change-value < 0
      766     then do:
      767       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      768       then do:
      769         assign
      770           p-change-value = v-diasize-orig-frame-width
      771                          - frame Dialog-Frame :width
      772         .
      773         if p-change-value >= 0
      774         then do:
      775           run diasize_position-resize-button in this-procedure .
      776           return .
      777         end.
      778       end.
      779     end.
      780     if p-change-value >= 0
      781     then do:
      782       assign
      783         v-change-sign = 1
      784       .
      785     end.
      786     else do:
      787       assign
      788         v-change-sign = -1
      789       .
      790     end.
      791     assign
      792       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      793     .
      794     if p-change-value = 0
      795     then do:
      796       run diasize_position-resize-button in this-procedure .
      797       return .
      798     end.
      799     move_block:
      800     do
      801     on error undo move_block, leave move_block
      802     :
      803       if retry
      804       then do:
      805         do
      806         on error undo move_block, leave move_block
      807         :
      808           if p-change-value > 0
      809           then do:
      810             for each buf_temp-diasize-handle
      811             on error undo, next
      812             :
      813               assign
      814                 v-object-handle = buf_temp-diasize-handle.handle-value
      815               .
      816               if v-object-handle <> v-diasize-resize-button
      817               then do:
      818                 assign
      819                   v-object-handle :col = buf_temp-diasize-handle.save-position
      820                 .
      821               end.
      822             end.
      823             assign
      824               v-diasize-browse-handle :width = v-browse-width
      825             .
      826             for each buf_temp-browse-handle
      827               where buf_temp-browse-handle.browse-type = 'width':u
      828             on error undo, next
      829             :
      830               assign
      831                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      832               .
      833             end.
      834             assign
      835               frame Dialog-Frame :width = v-frame-width
      836             .
      837             if frame Dialog-Frame :scrollable = true
      838             then do:
      839               assign
      840                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      841               .
      842             end.
      843             run diasize_position-resize-button in this-procedure .
      844           end.
      845           else do:
      846             if frame Dialog-Frame :scrollable = true
      847             then do:
      848               assign
      849                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      850               .
      851             end.
      852             assign
      853               frame Dialog-Frame :width = v-frame-width
      854             .
      855             for each buf_temp-browse-handle
      856               where buf_temp-browse-handle.browse-type = 'width':u
      857             on error undo, next
      858             :
      859               assign
      860                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      861               .
      862             end.
      863             assign
      864               v-diasize-browse-handle :width = v-browse-width
      865             .
      866             for each buf_temp-diasize-handle
      867             on error undo, next
      868             :
      869               assign
      870                 v-object-handle = buf_temp-diasize-handle.handle-value
      871               .
      872               if v-object-handle <> v-diasize-resize-button
      873               then do:
      874                 assign
      875                   v-object-handle :col = buf_temp-diasize-handle.save-position
      876                 .
      877               end.
      878             end.
      879             run diasize_position-resize-button in this-procedure .
      880           end.
      881           assign
      882             v-diasize-change-size = false
      883           .
      884           leave move_block .
      885         end.
      886       end.
      887       assign
      888         v-diasize-need-full-display = true
      889       .
      890       if v-diasize-change-size = false
      891       then do:
      892         assign
      893           v-diasize-change-size = true
      894         .
      895       end.
      896       else do:
      897         return .
      898       end.
      899       assign
      900         v-frame-width = frame Dialog-Frame :width
      901         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      902         v-browse-width = v-diasize-browse-handle :width
      903       .
      904       for each buf_temp-browse-handle
      905         where buf_temp-browse-handle.browse-type = 'width':u
      906       :
      907         assign
      908           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      909         .
      910       end.
      911       for each buf_temp-diasize-handle
      912       :
      913         delete buf_temp-diasize-handle .
      914       end.
      915       assign
      916         v-field-group-handle = frame Dialog-Frame :first-child
      917       .
      918       do while valid-handle(v-field-group-handle)
      919       :
      920         assign
      921           v-object-handle = v-field-group-handle :first-child
      922         .
      923         do while valid-handle(v-object-handle)
      924         :
      925           if  v-object-handle <> v-diasize-browse-handle :handle
      926           and v-object-handle <> v-diasize-resize-button
      927           and can-query(v-object-handle, "row")
      928           and can-query(v-object-handle, "height")
      929           and ( v-object-handle :col + v-object-handle :width
      930                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      931               )
      932           then do:
      933             find first buf_temp-browse-handle
      934               where buf_temp-browse-handle.browse-type   = 'width':u
      935                 and buf_temp-browse-handle.browse-handle = v-object-handle
      936               no-error .
      937             if available buf_temp-browse-handle
      938             then do:
      939             end.
      940             else do:
      941               create buf_temp-diasize-handle .
      942               assign
      943                 buf_temp-diasize-handle.handle-value  = v-object-handle
      944                 buf_temp-diasize-handle.save-position = v-object-handle :col
      945               .
      946             end.
      947           end.
      948           assign
      949             v-object-handle = v-object-handle :next-sibling
      950           .
      951         end.
      952         assign
      953           v-field-group-handle = v-field-group-handle :next-sibling
      954         .
      955       end.
      956       do with frame Dialog-Frame
      957       :
      958         hide v-diasize-resize-button .
      959         v-diasize-resize-button :row = 1.
      960         v-diasize-resize-button :column = 1.
      961       end.
      962       if p-change-value > 0
      963       then do:
      964         if frame Dialog-Frame :scrollable = true
      965         then do:
      966           assign
      967             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      968             no-error .
      969           if error-status :error
      970           or error-status :get-message(1) <> ""
      971           then do:
      972             undo move_block, retry move_block.
      973           end.
      974         end.
      975         assign
      976           frame Dialog-Frame :width = v-frame-width + p-change-value
      977           no-error .
      978         if error-status :error
      979         or error-status :get-message(1) <> ""
      980         then do:
      981           undo move_block, retry move_block.
      982         end.
      983         assign
      984           v-diasize-browse-handle :width = v-browse-width + p-change-value
      985         no-error .
      986         if error-status :error
      987         or error-status :get-message(1) <> ""
      988         then do:
      989           undo move_block, retry move_block.
      990         end.
      991         for each buf_temp-browse-handle
      992           where buf_temp-browse-handle.browse-type = 'width':u
      993         on error undo move_block, retry move_block
      994         :
      995           assign
      996             buf_temp-browse-handle.browse-handle :width
      997               = buf_temp-browse-handle.browse-handle :width + p-change-value
      998             no-error .
      999           if error-status :error
     1000           or error-status :get-message(1) <> ""
     1001           then do:
     1002             undo move_block, retry move_block .
     1003           end.
     1004         end.
     1005         for each buf_temp-diasize-handle
     1006         on error undo move_block, retry move_block
     1007         :
     1008           assign
     1009             v-object-handle = buf_temp-diasize-handle.handle-value
     1010           .
     1011           if v-object-handle <> v-diasize-resize-button
     1012           then do:
     1013             assign
     1014               v-object-handle :col = v-object-handle :col + p-change-value
     1015               no-error .
     1016             if error-status :error
     1017             or error-status :get-message(1) <> ""
     1018             then do:
     1019               undo move_block, retry move_block .
     1020             end.
     1021           end.
     1022         end.
     1023       end.
     1024       else do:
     1025         for each buf_temp-diasize-handle
     1026         on error undo move_block, retry move_block
     1027         :
     1028           assign
     1029             v-object-handle = buf_temp-diasize-handle.handle-value
     1030           .
     1031           if v-object-handle <> v-diasize-resize-button
     1032           then do:
     1033             assign
     1034               v-object-handle :col = v-object-handle :col + p-change-value
     1035               no-error .
     1036             if error-status :error
     1037             or error-status :get-message(1) <> ""
     1038             then do:
     1039               undo move_block, retry move_block .
     1040             end.
     1041           end.
     1042         end.
     1043         for each buf_temp-browse-handle
     1044           where buf_temp-browse-handle.browse-type = 'width':u
     1045         on error undo move_block, retry move_block
     1046         :
     1047           assign
     1048             buf_temp-browse-handle.browse-handle :width
     1049               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1050             no-error .
     1051           if error-status :error
     1052           or error-status :get-message(1) <> ""
     1053           then do:
     1054             undo move_block, retry move_block .
     1055           end.
     1056         end.
     1057         assign
     1058           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1059           no-error .
     1060         if error-status :error
     1061         or error-status :get-message(1) <> ""
     1062         then do:
     1063           undo move_block, retry move_block.
     1064         end.
     1065         assign
     1066           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1067         no-error .
     1068         if error-status :error
     1069         or error-status :get-message(1) <> ""
     1070         then do:
     1071           undo move_block, retry move_block.
     1072         end.
     1073         if frame Dialog-Frame :scrollable = true
     1074         then do:
     1075           assign
     1076             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1077           no-error .
     1078           if error-status :error
     1079           or error-status :get-message(1) <> ""
     1080           then do:
     1081             undo move_block, retry move_block.
     1082           end.
     1083         end.
     1084       end.
     1085       if p-move-resize
     1086       then do:
     1087         run diasize_position-resize-button in this-procedure .
     1088       end.
     1089       if v-diasize-wndstore = true
     1090       then do:
     1091         if connected("ub") = true
     1092         then do:
     1093           define variable v-cntxt-db-num        as integer   no-undo .
     1094           define variable v-cntxt-userid        as character no-undo .
     1095           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1096                                             , OUTPUT v-cntxt-userid
     1097                                             ) .
     1098           run gbl/wndsizew.p
     1099             (input  v-cntxt-db-num
     1100             ,input  v-cntxt-userid
     1101             ,input  v-diasize-proc-name
     1102             ,input  'width':u
     1103             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1104             ) .
     1105         end.
     1106       end.
     1107     end.
     1108     assign
     1109       v-diasize-change-size = false
     1110     .
     1111   end procedure.
     1112   procedure diasize_set-width :
     1113     define input  parameter p-new-width  as decimal   no-undo .
     1114     define input  parameter p-move-resize as logical   no-undo .
     1115     do
     1116     on error undo, return error return-value
     1117     :
     1118       run diasize_change-width in this-procedure
     1119         (input  (p-new-width - frame Dialog-Frame :width)
     1120         ,input  p-move-resize
     1121         ) .
     1122     end.
     1123   end procedure.
     1124   procedure diasize_position-resize-button :
     1125     do with frame Dialog-Frame
     1126     :
     1127       hide v-diasize-resize-button .
     1128       assign
     1129         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1130                     - 1
     1131                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1132         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1133                     - 1
     1134                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1135       .
     1136       view v-diasize-resize-button .
     1137     end.
     1138   end procedure.
     1139   on alt-right anywhere
     1140   do:
     1141     run diasize_change-width in this-procedure
     1142       (input 1
     1143       ,input true
     1144       ) .
     1145     return no-apply .
     1146   end.
     1147   on alt-left anywhere
     1148   do:
     1149     run diasize_change-width in this-procedure
     1150       (input -1
     1151       ,input true
     1152       ) .
     1153     return no-apply .
     1154   end.
     1155   on alt-down anywhere
     1156   do:
     1157     run diasize_change-height in this-procedure
     1158       (input 1
     1159       ,input true
     1160       ) .
     1161     return no-apply .
     1162   end.
     1163   on alt-up anywhere
     1164   do:
     1165     run diasize_change-height in this-procedure
     1166       (input -1
     1167       ,input true
     1168       ) .
     1169     return no-apply .
     1170   end.
     1171   on alt-enter of frame Dialog-Frame
     1172   do:
     1173     run diasize_maximize in this-procedure
     1174       (input  ?
     1175       ).
     1176     return no-apply .
     1177   end.
     1178   procedure diasize_end-move :
     1179     do
     1180     on error undo, return error return-value
     1181     :
     1182       define variable v-row-delta as decimal   no-undo .
     1183       define variable v-col-delta as decimal   no-undo .
     1184       define variable v-new-row as decimal   no-undo .
     1185       define variable v-new-col as decimal   no-undo .
     1186       assign
     1187         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1188         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1189       .
     1190       assign
     1191         v-row-delta = v-new-row - frame Dialog-Frame :height
     1192         v-col-delta = v-new-col - frame Dialog-Frame :width
     1193       .
     1194       run diasize_change-height in this-procedure
     1195         (input v-row-delta
     1196         ,input true
     1197         ) .
     1198       run diasize_change-width in this-procedure
     1199         (input v-col-delta
     1200         ,input true
     1201         ) .
     1202     end.
     1203   end procedure.
     1204   procedure diasize_maximize :
     1205     define input  parameter p-action as logical   no-undo .
     1206     do
     1207     on error undo, return error return-value
     1208     :
     1209       if p-action = ?
     1210       then do:
     1211         if v-diasize-need-maximize = true
     1212         then do:
     1213           assign
     1214             p-action = true
     1215           .
     1216         end.
     1217         else do:
     1218           assign
     1219             p-action = false
     1220           .
     1221         end.
     1222       end.
     1223       if p-action = true
     1224       then do:
     1225         run diasize_change-height in this-procedure
     1226           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1227               - frame Dialog-Frame :height-chars
     1228           ,input true
     1229           ) .
     1230         run diasize_change-width in this-procedure
     1231           (input session :width-chars
     1232               - frame Dialog-Frame :width-chars
     1233           ,input true
     1234           ) .
     1235         assign
     1236           v-diasize-need-maximize = false
     1237         .
     1238       end.
     1239       else do:
     1240         run diasize_change-width in this-procedure
     1241           (input v-diasize-orig-frame-width
     1242               - frame Dialog-Frame :width-chars
     1243           ,input true
     1244           ) .
     1245         run diasize_change-height in this-procedure
     1246           (input v-diasize-orig-frame-height
     1247               - frame Dialog-Frame :height-chars
     1248           ,input true
     1249           ) .
     1250         assign
     1251           v-diasize-need-maximize = true
     1252         .
     1253       end.
     1254     end.
     1255   end procedure.
     1256   procedure diasize_restore-orig-size :
     1257     do
     1258     on error undo, return error return-value
     1259     :
     1260       assign
     1261         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1262         v-diasize-current-frame-height = frame Dialog-Frame :height
     1263       .
     1264       run diasize_set-height in this-procedure
     1265         (input  v-diasize-orig-frame-height
     1266         ,input  true
     1267         ) .
     1268       run diasize_set-width in this-procedure
     1269         (input  v-diasize-orig-frame-width
     1270         ,input  true
     1271         ) .
     1272     end.
     1273   end procedure.
     1274   procedure diasize_restore-current-size :
     1275     do
     1276     on error undo, return error return-value
     1277     :
     1278       run diasize_set-height in this-procedure
     1279         (input  v-diasize-current-frame-height
     1280         ,input  true
     1281         ) .
     1282       run diasize_set-width in this-procedure
     1283         (input  v-diasize-current-frame-width
     1284         ,input  true
     1285         ) .
     1286     end.
     1287   end procedure.
     1288   procedure diasize_set-browse-handle :
     1289     define input  parameter p-browse-handle as handle   no-undo .
     1290     define buffer buf_temp-browse-handle for temp-browse-handle .
     1291     do
     1292     on error undo, return error return-value
     1293     :
     1294       assign
     1295         v-diasize-browse-handle = p-browse-handle
     1296       .
     1297       for each buf_temp-browse-handle
     1298       on error undo, return error return-value
     1299       :
     1300         delete buf_temp-browse-handle .
     1301       end.
     1302     end.
     1303   end procedure.
     1304   procedure diasize_add_browse :
     1305     define input  parameter p-browse-type   as character no-undo .
     1306     define input  parameter p-browse-handle as handle    no-undo .
     1307     define buffer buf_temp-browse-handle for temp-browse-handle .
     1308     do
     1309     on error undo, return error return-value
     1310     :
     1311       assign
     1312         v-diasize-browse-number = v-diasize-browse-number + 1
     1313       .
     1314       create buf_temp-browse-handle .
     1315       assign
     1316         buf_temp-browse-handle.browse-type   = p-browse-type
     1317         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1318         buf_temp-browse-handle.browse-handle = p-browse-handle
     1319       .
     1320     end.
     1321   end procedure.
     1322   procedure diasize_init :
     1323     define variable v-default-value    as logical   no-undo .
     1324     define variable v-restore-saved    as logical   no-undo .
     1325     define variable v-resize-value-str as character no-undo .
     1326     do
     1327     on error undo, return error return-value
     1328     :
     1329       do with frame Dialog-Frame
     1330       :
     1331         assign
     1332           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1333           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1334           v-diasize-browse-handle     = browse BROWSE-3 :handle
     1335         .
     1336         create button v-diasize-resize-button
     1337         assign
     1338           parent        = frame Dialog-Frame :first-child
     1339           label         = "s"
     1340           height-pixels = 16
     1341           width-pixels  = 16
     1342           visible       = true
     1343           sensitive     = true
     1344           movable       = true
     1345           triggers:
     1346             on end-move persistent run diasize_end-move in this-procedure .
     1347           end triggers.
     1348         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1349         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1350         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1351         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1352         assign
     1353           v-diasize-wndmax = false
     1354         .
     1355         if connected("ub") = true
     1356         then do:
     1357           define variable v-cntxt-db-num        as integer   no-undo .
     1358           define variable v-cntxt-userid        as character no-undo .
     1359           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1360                                             , OUTPUT v-cntxt-userid
     1361                                             ) .
     1362           run gbl/wndpar_r.p
     1363             (input  v-cntxt-db-num
     1364             ,input  v-cntxt-userid
     1365             ,input  'wndmax':U
     1366             ,output v-diasize-wndmax
     1367             ,output v-default-value
     1368             ) .
     1369         end.
     1370         assign
     1371           v-diasize-wndstore = false
     1372         .
     1373         if connected("ub") = true
     1374         then do:
     1375           run gbl/wndpar_r.p
     1376             (input  v-cntxt-db-num
     1377             ,input  v-cntxt-userid
     1378             ,input  'wndstore':U
     1379             ,output v-diasize-wndstore
     1380             ,output v-default-value
     1381             ) .
     1382         end.
     1383         assign
     1384           v-diasize-proc-name = entry(1, program-name(2), '.')
     1385         .
     1386         if v-diasize-wndstore = true
     1387         then do:
     1388           assign
     1389             v-restore-saved = false
     1390           .
     1391           if connected("ub") = true
     1392           then do:
     1393             run gbl/wndsizer.p
     1394               (input  v-cntxt-db-num
     1395               ,input  v-cntxt-userid
     1396               ,input  v-diasize-proc-name
     1397               ,input  'height':u
     1398               ,output v-resize-value-str
     1399               ) .
     1400             if v-resize-value-str <> '':U
     1401             then do:
     1402               run diasize_change-height in this-procedure
     1403                 (input  integer(v-resize-value-str)
     1404                 ,input  true
     1405                 ) .
     1406               assign
     1407                 v-restore-saved = true
     1408               .
     1409             end.
     1410           end.
     1411           if connected("ub") = true
     1412           then do:
     1413             run gbl/wndsizer.p
     1414               (input  v-cntxt-db-num
     1415               ,input  v-cntxt-userid
     1416               ,input  v-diasize-proc-name
     1417               ,input  'width':u
     1418               ,output v-resize-value-str
     1419               ) .
     1420             if v-resize-value-str <> '':U
     1421             then do:
     1422               run diasize_change-width in this-procedure
     1423                 (input  integer(v-resize-value-str)
     1424                 ,input  true
     1425                 ) .
     1426               assign
     1427                 v-restore-saved = true
     1428               .
     1429             end.
     1430           end.
     1431           if v-restore-saved <> true
     1432           then do:
     1433             if v-diasize-wndmax = true
     1434             then do:
     1435               run diasize_maximize in this-procedure
     1436                 (input  true
     1437                 ) .
     1438             end.
     1439           end.
     1440         end.
     1441         else do:
     1442           if v-diasize-wndmax = true
     1443           then do:
     1444             run diasize_maximize in this-procedure
     1445               (input  true
     1446               ) .
     1447           end.
     1448         end.
     1449       end.
     1450     end.
     1451   end procedure.
     1452   procedure diasize_need-full-display :
     1453     define output parameter p-need-full-display as logical   no-undo .
     1454     do
     1455     on error undo, return error return-value
     1456     :
     1457       assign
     1458         p-need-full-display = v-diasize-need-full-display
     1459       .
     1460       assign
     1461         v-diasize-need-full-display = false
     1462       .
     1463     end.
     1464   end procedure.
     1465   procedure get-context :
     1466      define output parameter p-db-num as integer          no-undo.
     1467      define output parameter p-user-id as character        no-undo.
     1468      define variable v-login               as character    no-undo.
     1469      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1470      define buffer buf_user-login  for ub.user-login .
     1471      do
     1472      on error undo, return error
     1473      :
     1474            FIND FIRST buf_sys-ctrl no-lock.
     1475            ASSIGN
     1476               v-login = USERID("ub")
     1477               p-db-num = buf_sys-ctrl.db-num
     1478            .
     1479            FIND FIRST buf_user-login
     1480                 WHERE buf_user-login.db-num = p-db-num
     1481                   AND buf_user-login.user-login = v-login
     1482                 no-lock
     1483                 no-error
     1484                 .
     1485            IF AVAILABLE buf_user-login
     1486            THEN DO:
     1487               assign
     1488                  p-user-id = buf_user-login.user-id
     1489               .
     1490            END.
     1491      end.
     1492   end procedure.
     1493       run diasize_init in this-procedure .
     1494   MAIN-BLOCK:
     1495   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1496      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1497   define variable loc#log as logical   no-undo .
     1498       RUN init-tt.
     1499       RUN enable_UI.
     1500       RUN init-proc.
     1501     WAIT-FOR GO OF FRAME Dialog-Frame.
     1502   END.
     1503   RUN disable_UI.
     1504   PROCEDURE bg-col :
     1505   define input  parameter p-color as integer   no-undo .
     1506   END PROCEDURE.
     1507   PROCEDURE disable_UI :
     1508     HIDE FRAME Dialog-Frame.
     1509   END PROCEDURE.
     1510   PROCEDURE enable_UI :
     1511     DISPLAY v-goods
     1512         WITH FRAME Dialog-Frame.
     1513     ENABLE B-exit B-quit B-rcv B-print B-Help BROWSE-3 v-goods
     1514         WITH FRAME Dialog-Frame.
     1515     VIEW FRAME Dialog-Frame.
     1516     OPEN QUERY BROWSE-3 FOR EACH tt_ord-line-rcv NO-LOCK where tt_ord-line-rcv.gds-code = p-gds-code ,         first buf_ord-doc-rcv no-lock where       buf_ord-doc-rcv.doc-code = tt_ord-line-rcv.doc-code and       buf_ord-doc-rcv.rcv-code = tt_ord-line-rcv.rcv-code ,        first buf_clients no-lock where       buf_clients.obj-code = buf_ord-doc-rcv.cli-code and       buf_clients.obj-type = buf_ord-doc-rcv.cli-type  INDEXED-REPOSITION.
     1517   END PROCEDURE.
     1518   PROCEDURE fill-widgets :
     1519   END PROCEDURE.
     1520   PROCEDURE init-proc :
     1521   if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1522        B-exit:label in frame Dialog-Frame  = "Вы&ход"  .
     1523        hide B-quit in frame Dialog-Frame .
     1524     END.
     1525     hide b-print  in frame Dialog-Frame .
     1526   end procedure.
     1527   PROCEDURE init-tt :
     1528   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1529   v-goods =   buf_goods.artic + "  код:" + string ( buf_goods.gds-code ) + " "  +  buf_goods.gds-name .
     1530   END PROCEDURE.
     1531   PROCEDURE save-proc :
     1532   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     1533   END PROCEDURE.
