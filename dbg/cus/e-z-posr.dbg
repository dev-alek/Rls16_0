      609   define new global shared variable g#library  as handle no-undo .
      610   define new global shared variable g#library2 as handle no-undo .
      611   define variable var-report-r-b as character no-undo .
      612   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      613   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      614     (output var-report-r-b
      615     )  .
      616   define new global shared variable g#language as character no-undo .
      617   if g#language <> '' and g#language <> 'rus':U then do:
      618     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      619   end.
      620   DEFINE VARIABLE COMBO-Firm AS CHARACTER FORMAT "X(256)":U
      621        VIEW-AS COMBO-BOX INNER-LINES 15
      622        LIST-ITEMS "?"
      623        DROP-DOWN-LIST
      624        SIZE 69.5 BY 1 NO-UNDO.
      625   DEFINE VARIABLE SortType AS INTEGER
      626        VIEW-AS RADIO-SET VERTICAL
      627        RADIO-BUTTONS
      628             "по коду", 1,
      629   "по артикулу", 2,
      630   "по наименованию", 3
      631        SIZE 23.38 BY 3.75 NO-UNDO.
      632   DEFINE RECTANGLE RECT-7
      633        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      634        SIZE 73.25 BY 16.04.
      635   DEFINE RECTANGLE RECT-8
      636        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      637        SIZE 28.25 BY 7.67.
      638   DEFINE VARIABLE sort-grp AS LOGICAL INITIAL no
      639        LABEL "по группам"
      640        VIEW-AS TOGGLE-BOX
      641        SIZE 19.13 BY .83 NO-UNDO.
      642   DEFINE FRAME F-Main
      643        COMBO-Firm AT ROW 3.13 COL 2.13 COLON-ALIGNED NO-LABEL
      644        SortType AT ROW 7.88 COL 5.88 NO-LABEL
      645        sort-grp AT ROW 12.29 COL 6
      646        "Сортировка :" VIEW-AS TEXT
      647             SIZE 24.25 BY 1 AT ROW 6.58 COL 5.38
      648             FGCOLOR 4
      649        "Фирмы - посредники :" VIEW-AS TEXT
      650             SIZE 39.75 BY 1 AT ROW 1.83 COL 3.63
      651             FGCOLOR 4
      652        RECT-7 AT ROW 1.21 COL 2.38
      653        RECT-8 AT ROW 5.75 COL 3.63
      654       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      655            SIDE-LABELS NO-UNDERLINE THREE-D
      656            AT COL 1 ROW 1 SCROLLABLE .
      657   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      658   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      659   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      660   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      661   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      662   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      663   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      664   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      665         adm-object-hdl = FRAME F-Main:HANDLE.
      666   RUN ensure-broker.
      667   THIS-PROCEDURE:ADM-DATA =
      668        'ADM1.1~`':U +
      669        'SmartObject~`':U +
      670        '~`':U +
      671        'NO ~`':U +
      672        '~`':U +
      673        '~`':U +
      674        '~`':U +
      675        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      676           + "~`":U +
      677        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      678        'Record-Source,Record-Target,TableIO-Target~`':U +
      679        '~`':U +
      680        '~`~`~`~`~`~`~`~`~`~`~`':U +
      681        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      682            THEN "^^":U
      683        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      684             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      685   PROCEDURE adm-apply-entry :
      686     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      687   END PROCEDURE.
      688   PROCEDURE adm-destroy :
      689    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      690   END PROCEDURE.
      691   PROCEDURE adm-disable :
      692       DISABLE RECT-7 RECT-8 COMBO-Firm SortType sort-grp WITH FRAME F-Main.
      693       RUN dispatch ('disable-fields':U).
      694       RUN set-attribute-list ('ENABLED=no':U).
      695       RETURN.
      696   END PROCEDURE.
      697   PROCEDURE adm-edit-attribute-list :
      698         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      699         RETURN.
      700   END PROCEDURE.
      701   PROCEDURE adm-enable :
      702       ENABLE UNLESS-HIDDEN RECT-7 RECT-8 COMBO-Firm SortType sort-grp WITH FRAME F-Main.
      703       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      704       RUN set-attribute-list ('ENABLED=yes':U).
      705       RETURN.
      706   END PROCEDURE.
      707   PROCEDURE adm-exit :
      708        RUN notify ('exit':U).
      709     RETURN.
      710   END PROCEDURE.
      711   PROCEDURE adm-hide :
      712     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      713   END PROCEDURE.
      714   PROCEDURE adm-initialize :
      715     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      716   END PROCEDURE.
      717   PROCEDURE adm-show-errors :
      718       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      719       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      720           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      721       END.
      722       RETURN.
      723   END PROCEDURE.
      724   PROCEDURE adm-UIB-mode :
      725     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      726   END PROCEDURE.
      727   PROCEDURE adm-view :
      728     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      729   END PROCEDURE.
      730   PROCEDURE dispatch :
      731       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      732       RUN broker-dispatch IN adm-broker-hdl
      733           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      734       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      735   END PROCEDURE.
      736   PROCEDURE ensure-broker :
      737   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      738   IF RETURN-VALUE NE "ADM-Broker":U THEN
      739   DO:
      740       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      741       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      742   END.
      743   END PROCEDURE.
      744   PROCEDURE get-attribute :
      745     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      746     RUN broker-get-attribute IN adm-broker-hdl
      747         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      748     RETURN RETURN-VALUE.
      749   END PROCEDURE.
      750   PROCEDURE get-attribute-list :
      751     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      752     RUN broker-get-attribute-list IN adm-broker-hdl
      753         (INPUT THIS-PROCEDURE,
      754          INPUT ?,
      755          OUTPUT p-attr-list) NO-ERROR.
      756     RETURN.
      757   END PROCEDURE.
      758   PROCEDURE new-state :
      759     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      760     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      761     RETURN.
      762   END PROCEDURE.
      763   PROCEDURE notify :
      764     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      765     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      766     IF RETURN-VALUE = "ADM-ERROR":U THEN
      767         RETURN "ADM-ERROR":U.
      768     RETURN.
      769   END PROCEDURE.
      770   PROCEDURE set-attribute-list :
      771     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      772     RUN ensure-broker.
      773     RUN broker-set-attribute-list IN adm-broker-hdl
      774         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      775     RETURN.
      776   END PROCEDURE.
      777   PROCEDURE set-position :
      778       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      779       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      780       IF VALID-HANDLE(adm-object-hdl) THEN
      781       DO:
      782         ASSIGN adm-object-hdl:ROW    =   p-row
      783                adm-object-hdl:COLUMN =   p-col.
      784       END.
      785       RETURN.
      786   END PROCEDURE.
      787   PROCEDURE adm-display-fields :
      788       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      789       RETURN.
      790   END PROCEDURE.
      791   PROCEDURE adm-open-query :
      792     RETURN.
      793   END PROCEDURE.
      794   PROCEDURE adm-row-changed :
      795         IF VALID-HANDLE(adm-object-hdl) THEN
      796           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      797         RUN notify ('row-available':U).
      798         RETURN.
      799   END PROCEDURE.
      800   PROCEDURE reposition-query :
      801       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      802       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      803       RETURN.
      804   END PROCEDURE.
      805     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      806     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      807     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      808     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      809     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      810     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      811     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      812     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      813     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      814     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      815     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      816     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      817     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      818     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      819     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      820     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      821     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      822     IF "":U = "":U THEN
      823       RUN modify-list-attribute IN adm-broker-hdl
      824         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      825     RUN use-create-on-add(?).
      826   PROCEDURE adm-add-record :
      827       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      828          "must have at least one Enabled Table to perform Add.":U
      829          VIEW-AS ALERT-BOX ERROR.
      830       RETURN.
      831   END PROCEDURE.
      832   PROCEDURE adm-assign-record :
