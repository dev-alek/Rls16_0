      834          "Object ":U THIS-PROCEDURE:FILE-NAME
      835            "must have at least one Enabled Table to perform Assign.":U
      836              VIEW-AS ALERT-BOX ERROR.
      837      RETURN.
      838     END PROCEDURE.
      839   PROCEDURE adm-assign-statement :
      840     RETURN.
      841   END PROCEDURE.
      842   PROCEDURE adm-cancel-record :
      843      RETURN.
      844     END PROCEDURE.
      845   PROCEDURE adm-copy-record :
      846       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      847        "must have at least one Enabled Table to perform Copy.":U
      848          VIEW-AS ALERT-BOX ERROR.
      849       RETURN.
      850   END PROCEDURE.
      851   PROCEDURE adm-create-record :
      852      RETURN.
      853   END PROCEDURE.
      854   PROCEDURE adm-current-changed :
      855     RETURN.
      856   END PROCEDURE.
      857   PROCEDURE adm-delete-record :
      858    MESSAGE
      859          "Object ":U THIS-PROCEDURE:FILE-NAME
      860            "must have at least one Enabled Table to perform Delete.":U
      861              VIEW-AS ALERT-BOX ERROR.
      862       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      863       RETURN.
      864   END PROCEDURE.
      865   PROCEDURE adm-disable-fields :
      866         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      867       RETURN.
      868   END PROCEDURE.
      869   PROCEDURE adm-enable-fields :
      870       RETURN.
      871   END PROCEDURE.
      872   PROCEDURE adm-end-update :
      873     RETURN.
      874   END PROCEDURE.
      875   PROCEDURE adm-reset-record :
      876       RETURN.
      877   END PROCEDURE.
      878   PROCEDURE adm-update-record :
      879       MESSAGE
      880         "Object ":U THIS-PROCEDURE:FILE-NAME
      881           "must have at least one Enabled Table to perform Update.":U
      882             VIEW-AS ALERT-BOX ERROR.
      883      RETURN.
      884   END PROCEDURE.
      885   PROCEDURE check-modified :
      886   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      887   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      888   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      889   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      890     IF check-state = "check":U THEN
      891     DO:
      892       RUN get-link-handle IN adm-broker-hdl
      893         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      894            OUTPUT group-target-list).
      895       IF group-target-list NE "":U THEN
      896       DO i = 1 TO NUM-ENTRIES(group-target-list):
      897         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      898         RUN check-modified IN curr-widget ('group-check':U).
      899         IF RETURN-VALUE NE "":U THEN
      900         DO:
      901           RUN check-modified-message(RETURN-VALUE).
      902           RETURN "":U.
      903         END.
      904       END.
      905     END.
      906     RETURN "":U.
      907   END PROCEDURE.
      908   PROCEDURE check-modified-message :
      909     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      910        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      911           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      912        IF RETURN-VALUE = "YES":U THEN
      913           RUN notify ('view,CONTAINER-SOURCE':U).
      914        MESSAGE IF p-changed-table NE ? THEN
      915           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      916           ELSE "Current values have been changed."
      917           SKIP "  Do you wish to save those changes?"
      918           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      919        IF ANS THEN
      920        DO:
      921           IF group-assign-target THEN
      922             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      923           ELSE RUN dispatch('update-record':U).
      924           IF RETURN-VALUE = "ADM-ERROR":U THEN
      925           DO:
      926               MESSAGE "Changes to the previous record were not saved."
      927                 VIEW-AS ALERT-BOX ERROR.
      928               IF group-assign-target THEN
      929                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      930               ELSE RUN dispatch ('cancel-record':U).
      931           END.
      932        END.
      933        ELSE DO:
      934          IF group-assign-target THEN
      935             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      936          ELSE RUN dispatch('cancel-record':U).
      937        END.
      938        RETURN.
      939   END PROCEDURE.
      940   PROCEDURE get-rowid :
      941       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      942       ASSIGN
      943       p-table   =   adm-first-table.
      944       RETURN.
      945   END PROCEDURE.
      946   PROCEDURE init-group-assign :
      947       RUN request-attribute IN adm-broker-hdl
      948         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      949       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      950         group-assign-target = yes.
      951       ELSE group-assign-target = no.
      952       RETURN.
      953   END PROCEDURE.
      954   PROCEDURE set-editors :
      955       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      956       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      957       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      958       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      959       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      960       DO WHILE VALID-HANDLE (curr-widget):
      961           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      962              curr-widget:HIDDEN = no THEN DO:
      963             CASE p-field-setting:
      964               WHEN "INITIALIZE":U THEN
      965               DO:
      966                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      967                     read-only-list +
      968                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      969                        STRING(curr-widget).
      970               END.
      971               WHEN "DISABLE":U OR
      972               WHEN "ENABLE":U THEN
      973               DO:
      974                   curr-widget:SENSITIVE = yes.
      975                   RUN get-attribute ('Read-Only-Editors':U).
      976                   IF RETURN-VALUE = ? OR
      977                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      978                       curr-widget:READ-ONLY =
      979                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      980               END.
      981               WHEN "CLEAR":U THEN
      982                   curr-widget:SCREEN-VALUE = "":U.
      983             END CASE.
      984           END.
      985           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      986       END.
      987       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      988         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      989           + '"':U).
      990       RETURN.
      991   END PROCEDURE.
      992   PROCEDURE use-check-modified-all :
      993    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      994     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      995     RETURN.
      996   END PROCEDURE.
      997   PROCEDURE use-create-on-add :
      998   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      999      RETURN.
     1000   END PROCEDURE.
     1001   PROCEDURE use-initial-lock :
     1002     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1003     ASSIGN adm-initial-lock = p-attr-value.
     1004     RETURN.
     1005   END PROCEDURE.
     1006     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1007   ASSIGN
     1008          FRAME F-Main:SCROLLABLE       = FALSE
     1009          FRAME F-Main:HIDDEN           = TRUE.
     1010   if not this-procedure :persistent
     1011   then do:
     1012     message
     1013       vss-workfile vss-revision vss-description skip
     1014       "Ошибка при запуске процедуры" skip
     1015       "Данную процедуру следует запускать только с параметром persistent" skip
     1016       view-as alert-box error .
     1017     undo, return error .
     1018   end.
     1019   define variable temp-string as character no-undo .
     1020   define variable str as character no-undo .
     1021   temp-string = "".
     1022   for each ub.sysconf where ub.sysconf.avrg-price = yes no-lock :
     1023    find first ub.clients where ub.clients.obj-code = ub.sysconf.host-code and ub.clients.obj-type = 'орг':U no-error .
     1024    IF temp-string = "" THEN do:
     1025      assign
     1026        temp-string = string(ub.sysconf.host-code,">>>>9") + " " + ub.clients.obj-name
     1027        str = temp-string
     1028      .
     1029    end.
     1030    ELSE temp-string = temp-string + "," + string(ub.sysconf.host-code,">>>>9") + " " + ub.clients.obj-name.
     1031   END.
     1032   ASSIGN COMBO-Firm:LIST-ITEMS IN FRAME F-Main = temp-string.
     1033   ASSIGN COMBO-Firm:SCREEN-VALUE = str.
     1034   ENABLE COMBO-Firm WITH FRAME F-Main.
     1035   PROCEDURE disable_UI :
     1036     HIDE FRAME F-Main.
     1037     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1038   END PROCEDURE.
     1039   PROCEDURE local-apply-layout :
     1040     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1041   END PROCEDURE.
     1042   PROCEDURE my-report :
     1043   define variable h-code as integer   no-undo .
     1044     h-code = int(substr(str3,1,6)) .
     1045     run cus/r-z-posr.p ( h-code, SortType, sort-grp) .
     1046   END PROCEDURE.
     1047   PROCEDURE my-var :
     1048     Assign frame F-Main  COMBO-Firm SortType sort-grp.
     1049     Assign
     1050       STR-obj-type = ''
     1051       STR-obj-code = ''
     1052       STR-obj-name = ''
     1053       STR-obj      = ''
     1054     .
     1055     For each obj-list no-lock:
     1056       Assign
     1057         STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1058         STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1059         STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1060         STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1061       .
     1062     End.
     1063     assign
     1064       str2 = "Фирма-посредник: " + COMBO-Firm:screen-value
     1065       str3 = COMBO-Firm:screen-value
     1066     .
     1067   END PROCEDURE.
     1068   PROCEDURE state-changed :
     1069     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1070     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1071     CASE p-state:
     1072       when "link-changed":U then  DO:
     1073            Run my-var.
     1074            End.
     1075     END CASE.
     1076   END PROCEDURE.
