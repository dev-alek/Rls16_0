      591   procedure cur-time :
      592      define output parameter p-today as date      no-undo .
      593      define output parameter p-time  as integer   no-undo .
      594     do
      595     on error undo, return error
      596     :
      597       define variable v-date1 as date      no-undo .
      598       define variable v-date2 as date      no-undo .
      599       define variable v-time  as integer   no-undo .
      600       assign
      601         v-date1 = today
      602         v-time  = time
      603         v-date2 = today
      604       .
      605       if v-date1 <> v-date2
      606       then do:
      607         assign
      608           v-date1 = today
      609           v-time  = v-time
      610         .
      611       end.
      612       assign
      613         p-today = v-date1
      614         p-time  = v-time
      615       .
      616     end.
      617   end.
      618   function cur-time-date returns character
      619   :
      620     return string(today, '99/99/9999':U) .
      621   end.
      622   function cur-time-mjd returns decimal
      623   :
      624     define variable v-date as date      no-undo .
      625     define variable v-time as integer   no-undo .
      626     run cur-time in this-procedure
      627       (output v-date
      628       ,output v-time
      629       ) .
      630     return integer(v-date) - 2400002 + (v-time / 86400) .
      631   end.
      632   function cur-time-get-ending-index returns integer
      633   (input p-number as integer
      634   )
      635   :
      636     if p-number < 0
      637     or p-number = ?
      638     then do:
      639       return 1 .
      640     end.
      641     define variable v-rest as integer   no-undo .
      642     assign
      643       p-number = p-number modulo 100
      644     .
      645     if p-number < 20
      646     then do:
      647       assign
      648         v-rest = p-number
      649       .
      650     end.
      651     else do:
      652       assign
      653         v-rest = p-number modulo 10
      654       .
      655     end.
      656     case v-rest :
      657       when 1
      658       then do:
      659         return 2 .
      660       end.
      661       when 2 or
      662       when 3 or
      663       when 4
      664       then do:
      665         return 3 .
      666       end.
      667       otherwise do:
      668         return 1 .
      669       end.
      670     end case .
      671   end.
      672   procedure cur-time-mjd-to-date :
      673      define input  parameter i-mjd-diff as decimal no-undo.
      674      define output parameter o-Date     as date    no-undo.
      675      define output parameter o-Time     as integer no-undo.
      676      define variable v-day-number as integer   no-undo .
      677      if    i-mjd-diff < 0
      678         or i-mjd-diff = ?
      679      then do:
      680         return "?" .
      681      end.
      682      assign
      683         v-day-number = truncate(i-mjd-diff,0).
      684         o-Date = date(v-day-number + 2400002).
      685         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      686     .
      687   end.
      688   function cur-time-mjd-to-string returns character
      689   (input p-mjd-diff as decimal
      690   )
      691   :
      692     define variable v-day-number as integer   no-undo .
      693     define variable v-seconds    as integer   no-undo .
      694     define variable v-hour       as integer   no-undo .
      695     define variable v-min        as integer   no-undo .
      696     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      697     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      698     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      699     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      700     if p-mjd-diff < 0
      701     or p-mjd-diff = ?
      702     then do:
      703       return "?" .
      704     end.
      705     assign
      706       v-day-number = integer(truncate(p-mjd-diff,0))
      707       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      708     .
      709     if v-seconds > 86400
      710     then do:
      711       assign
      712         v-seconds = 86400 - 1
      713       .
      714     end.
      715     if v-seconds < 0
      716     then do:
      717       assign
      718         v-seconds = 0
      719       .
      720     end.
      721     assign
      722       v-hour = truncate(v-seconds / 3600, 0)
      723     .
      724     assign
      725       v-seconds = v-seconds modulo 3600
      726     .
      727     assign
      728       v-min = truncate(v-seconds / 60, 0)
      729     .
      730     assign
      731       v-seconds = v-seconds modulo 60
      732     .
      733     return
      734         (if v-day-number <> 0
      735           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      736           else ""
      737         )
      738       + (if v-day-number <> 0 or v-hour <> 0
      739           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      740           else ""
      741         )
      742       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      743           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      744           else ""
      745         )
      746       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      747       .
      748   end.
      749   function cur-time-string returns character
      750   :
      751     define variable v-date as date      no-undo .
      752     define variable v-time as integer   no-undo .
      753     run cur-time in this-procedure
      754       (output v-date
      755       ,output v-time
      756       ) .
      757     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      758   end.
      759   function cur-time-string-sec returns character
      760   :
      761     define variable v-date as date      no-undo .
      762     define variable v-time as integer   no-undo .
      763     run cur-time in this-procedure
      764       (output v-date
      765       ,output v-time
      766       ) .
      767     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      768   end.
      769   function cur-time-custom  returns character
      770   (input p-prefix as character
      771   ,input p-date-format as character
      772   ,input p-delimiter as character
      773   ,input p-time-format as character
      774   ,input p-suffix as character
      775   )
      776   :
      777     define variable v-date as date      no-undo .
      778     define variable v-time as integer   no-undo .
      779     run cur-time in this-procedure
      780       (output v-date
      781       ,output v-time
      782       ) .
      783     return
      784       p-prefix
      785       + string(v-date, p-date-format)
      786       + p-delimiter
      787       + string(v-time, p-time-format)
      788       + p-suffix
      789       .
      790   end.
      791   function cur-time-print  returns character
      792   :
      793     define variable v-date as date      no-undo .
      794     define variable v-time as integer   no-undo .
      795     run cur-time in this-procedure
      796       (output v-date
      797       ,output v-time
      798       ) .
      799     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      800   end.
      801   function cur-time-datetime returns datetime
      802   :
      803     define variable v-char as character no-undo .
      804     define variable v-datetime as datetime no-undo .
      805     v-char = cur-time-string().
      806     v-datetime = datetime(v-char).
      807     return  v-datetime.
      808   end.
      809   function cur-time-string-msec returns character
      810   :
      811     define variable v-date as datetime  no-undo .
      812     v-date = now.
      813     return string(v-date) .
      814   end.
      815   define variable v-account as integer init 0 no-undo .
      816   define variable v-account-lavel as character no-undo .
      817   define variable v-button-stop as logical no-undo .
      818   define variable v-kol-spice as integer no-undo .
      819   define variable v-kol-spice2 as integer no-undo .
      820   define variable v-kol-spice3 as integer no-undo .
      821   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      822   DEFINE BUTTON StopBtn AUTO-END-KEY
      823        LABEL "Стоп"
      824        SIZE 10 BY 1.
      825   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      826        LABEL "Обработано записей"
      827         VIEW-AS TEXT
      828        SIZE 14 BY .67 NO-UNDO.
      829   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      830         VIEW-AS TEXT
      831        SIZE 53.25 BY .67
      832        FGCOLOR 1  NO-UNDO.
      833   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      834         VIEW-AS TEXT
      835        SIZE 53.25 BY .67
      836        FGCOLOR 1  NO-UNDO.
      837   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      838         VIEW-AS TEXT
      839        SIZE 53.25 BY .67
      840        FGCOLOR 1  NO-UNDO.
      841   DEFINE RECTANGLE RECT-1
      842        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      843        SIZE 55.13 BY 4.46.
      844   DEFINE FRAME InfoFrame
      845        StopBtn AT ROW 4.25 COL 21.75
      846        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      847        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      848        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      849        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      850        RECT-1 AT ROW 1 COL 1
      851       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      852            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      853            TITLE "Процесс"
      854            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      855   define variable mFrameView      as logical   no-undo init yes.
      856     define variable mFramHandle as handle no-undo.
      857     mFramHandle = frame InfoFrame:handle.
      858     if  log-manager:logfile-name ne ?
      859     then DO:
      860         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      861         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      862         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      863     end.
      864     mFrameView = not session:batch-mode and mFramHandle:visible.
      865     if mFrameView
      866     then do:
      867       ASSIGN
      868          FRAME InfoFrame:HIDDEN                           = TRUE
      869          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      870     end.
      871   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      872   DO:
      873     IF not StopProcessing THEN
      874       Message "Вы действительно хотите прервать" SKIP
      875               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      876                 UPDATE StopProcessing.
      877     IF StopProcessing THEN do:
      878        if mFrameView
      879        then do:
      880           HIDE FRAME InfoFrame.
      881        end.
      882     End.
      883   END.
      884   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      885     if num-entries(string(p-dec), '.') = 2
      886       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      887       else return( string(p-dec)) .
      888   end function.
      889   function format-point-to-comma returns char (input orig as char ) .
      890   define variable rtext as character no-undo .
      891   define variable strt as integer no-undo .
      892   define variable leng as integer no-undo .
      893   assign rtext = orig .
      894   repeat:
      895     strt =  index(rtext,'.').
      896     if strt = 0 then leave.
      897     leng = 1.
      898     substring(rtext,strt,leng,"character") = v-delim .
      899   end.
      900   return rtext.
      901   end function.
      902   function format-excel-text returns char ( input start-text as char ) :
      903   def var  i    as int no-undo.
      904   def var  ch   as char no-undo.
      905   def var  n    as int no-undo.
      906   def var  ipos as int no-undo.
      907     n = num-entries(trim(start-text), chr(10)) - 1 .
      908     do i = 1 to n :
      909       ipos = index( start-text, chr(10)).
      910       if ipos > 0 then
      911         substr( start-text, ipos, 1 ) = ' '.
      912     end.
      913     n = num-entries(trim(start-text), chr(13)) - 1 .
      914     do i = 1 to n :
      915       ipos = index( start-text, chr(13)).
      916       if ipos > 0 then
      917         substr( start-text, ipos, 1 ) = ' '.
      918     end.
      919     if index( start-text, '"' ) = 0 then
      920       start-text =  '="'   + trim( start-text) + '"'   .
      921       else do:
      922         n = num-entries(trim(start-text), '"') - 1.
      923         do i = 1 to n :
      924           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      925         end.
      926         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      927         start-text = '="'  + ch  + '"' .
      928       end.
      929     return start-text.
      930   end.
      931   function excel-sum returns char (input p-dec as decimal ).
      932     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      933   end function.
      934   function excel-qnty returns char (input p-dec as decimal ).
      935     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      936   end function.
      937   function format-excel-text-macr returns char ( input start-text as char ) :
      938   def var  i    as int no-undo.
      939   def var  ch   as char no-undo.
      940   def var  n    as int no-undo.
      941   def var  ipos as int no-undo.
      942     n = num-entries(trim(start-text), chr(10)) - 1 .
      943     do i = 1 to n :
      944       ipos = index( start-text, chr(10)).
      945       if ipos > 0 then
      946         substring( start-text, ipos , 1 ) = ' '.
      947     end.
      948     n = num-entries(trim(start-text), chr(13)) - 1 .
      949     do i = 1 to n :
      950       ipos = index( start-text, chr(13)).
      951       if ipos > 0 then
      952         substring( start-text, ipos, 1 ) = ' '.
      953     end.
      954     if index( start-text, '"' ) = 0 then
      955       start-text =  '"'   + trim( start-text) + '"'   .
      956       else do:
      957         n = num-entries(trim(start-text), '"') - 1.
      958         do i = 1 to n :
      959           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      960         end.
      961         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      962         start-text = '"'  + ch  + '"' .
      963       end.
      964     n = num-entries(trim(start-text), chr(10)) - 1 .
      965     do i = 1 to n :
      966       ipos = index( start-text, chr(10)).
      967       if ipos > 0 then
      968         substring( start-text, ipos , 1 ) = ' '.
      969     end.
      970       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      971     return start-text.
      972   end.
      973   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      974   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      975   procedure paramls-clear :
      976     define buffer buf_temp-param for temp-param .
      977     do
      978     on error undo, return error return-value
      979     :
      980       for each buf_temp-param
      981       on error undo, return error
      982       :
      983         delete buf_temp-param .
      984       end.
      985     end.
      986   end procedure.
      987   procedure paramls-write :
      988     define input  parameter p-code     as character no-undo .
      989     define input  parameter p-sub-code as character no-undo .
      990     define input  parameter p-value    as character no-undo .
      991     define buffer buf_temp-param for temp-param .
      992     do
      993     on error undo, return error return-value
      994     :
      995       find first buf_temp-param
      996         where buf_temp-param.param-code     = p-code
      997           and buf_temp-param.param-sub-code = p-sub-code
      998         no-error .
      999       if not available buf_temp-param then do:
     1000         create buf_temp-param .
     1001         assign
     1002           buf_temp-param.param-code     = p-code
     1003           buf_temp-param.param-sub-code = p-sub-code
     1004         .
     1005       end.
     1006       assign
     1007         buf_temp-param.param-value = p-value
     1008       .
     1009     end.
     1010   end procedure.
     1011   procedure paramls-read :
     1012     define input  parameter p-code          as character no-undo .
     1013     define input  parameter p-sub-code      as character no-undo .
     1014     define input  parameter p-default-value as character no-undo .
     1015     define output parameter p-value         as character no-undo .
     1016     define buffer buf_temp-param for temp-param .
     1017     do
     1018     on error undo, return error return-value
     1019     :
     1020       find first buf_temp-param
     1021         where buf_temp-param.param-code     = p-code
     1022           and buf_temp-param.param-sub-code = p-sub-code
     1023         no-error .
     1024       if available buf_temp-param then do:
     1025         assign
     1026           p-value = buf_temp-param.param-value
     1027         .
     1028       end.
     1029       else do:
     1030         assign
     1031           p-value = p-default-value
     1032         .
     1033       end.
     1034     end.
     1035   end procedure.
     1036   procedure paramls-append :
     1037     define input  parameter p-code     as character no-undo .
     1038     define input  parameter p-sub-code as character no-undo .
     1039     define input  parameter p-value    as character no-undo .
     1040     define buffer buf_temp-param for temp-param .
     1041     do
     1042     on error undo, return error return-value
     1043     :
     1044       find first buf_temp-param
     1045            where buf_temp-param.param-code     = p-code
     1046              and buf_temp-param.param-sub-code = p-sub-code
     1047         no-error .
     1048       if not available buf_temp-param then do:
     1049         create buf_temp-param .
     1050         assign
     1051           buf_temp-param.param-code     = p-code
     1052           buf_temp-param.param-sub-code = p-sub-code
     1053           buf_temp-param.param-value    = p-value
     1054         .
     1055       end.
     1056       else do:
     1057           assign
     1058               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1059           .
     1060       end.
     1061     end.
     1062   end procedure.
