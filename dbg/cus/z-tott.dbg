     1793   FUNCTION excel-qnty-null RETURNS char (INPUT p-dec as decimal ).
     1794   if p-dec = 0 then Return ("").
     1795      else RETURN(format-excel-text(excel-format-dec-to-char(Round(p-dec,3)))) .
     1796   END FUNCTION.
     1797   main-block :
     1798   do on error undo main-block, return error
     1799   :
     1800   p-file-name =  string( session:temp-directory + "rpt" + string( g#report-num ) + ".txt" ) .
     1801   output stream outstream to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) )      .
     1802   output stream outstream2 to value(p-file-name).
     1803   find first buf_ord-doc no-lock where  buf_ord-doc.doc-code = p-ord-doc no-error .
     1804   if error-status :error then do:
     1805     assign
     1806       p-cli-type  = loc-cli-type
     1807       p-cli-code  = loc-cli-code
     1808       p-doc-type  = loc-doc-type
     1809       p-doc-date  = doc-date
     1810       p-ship-date = loc-date-ship
     1811       p-host-code = v-cntxt-host-code-obj
     1812       .
     1813   end.
     1814   else do:
     1815     assign
     1816       p-cli-type = buf_ord-doc.cli-type
     1817       p-cli-code = buf_ord-doc.cli-code
     1818       p-doc-type = buf_ord-doc.doc-type
     1819       p-doc-date = buf_ord-doc.doc-date
     1820       p-ship-date = loc-date-ship
     1821       p-ship-time = buf_ord-doc.ship-time
     1822       p-host-code = buf_ord-doc.host-code
     1823       .
     1824       if p-cli-type = ? or p-cli-code = ? then do:
     1825           assign
     1826           p-cli-type  =  loc-cli-type
     1827           p-cli-code  =  loc-cli-code
     1828           .
     1829       end.
     1830   end.
     1831       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1832       output stream macr_excel to value(v-file-name)   .
     1833       v-ind = 1    .
     1834       num#str# = 1 .
     1835       num#col# = 1 .
     1836   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1837     if  log-manager:logfile-name ne ?
     1838     then DO:
     1839         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1840     end.
     1841     if not session:batch-mode then
     1842     do:
     1843       VIEW FRAME InfoFrame.
     1844       mFrameView = true.
     1845     end.
     1846      v-button-stop = false .
     1847         if mFrameView
     1848         then do:
     1849         if v-button-stop then view STOPBTN in frame InfoFrame.
     1850                          else Hide STOPBTN in frame InfoFrame.
     1851         end.
     1852   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1853   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1854     (input  p-obj-type
     1855     ,input  p-obj-code
     1856     ,output to-day
     1857     )  .
     1858       define variable p-name as character no-undo .
     1859       define buffer post-clients for clients.
     1860       define buffer sh-clients   for clients.
     1861       define buffer buf_firm     for firm.
     1862       define buffer buf_shop     for shop.
     1863       define buffer buf_store    for store.
     1864       define variable p_v         as integer.
     1865       define variable p_body_name as character.
     1866       find first sh-clients no-lock where
     1867           sh-clients.obj-type =   p-obj-type and
     1868           sh-clients.obj-code =   p-obj-code no-error  .
     1869       if error-status :error then next.
     1870       find first post-clients no-lock where
     1871           post-clients.obj-type =   p-cli-type and
     1872           post-clients.obj-code =   p-cli-code no-error  .
     1873       if error-status :error then next.
     1874       find first buf_firm no-lock where
     1875           buf_firm.firm-code = p-cli-code no-error.
     1876       if error-status :error then next.
     1877       reportname =  ( if p-doc-type = 'ОФ':U then "Заявка " else  "Заказ " )
     1878           + p-ord-doc +
     1879           " от " +
     1880           string( p-doc-date,"99/99/9999")
     1881           .
     1882       if sh-clients.obj-type = 'скл':U then
     1883       do:
     1884           find first buf_store no-lock where
     1885               buf_store.obj-code = sh-clients.obj-code no-error.
     1886           p_body_name = (reportname + " " + buf_store.addres1).
     1887       end.
     1888       if sh-clients.obj-type = 'маг':U then
     1889       do:
     1890           find first buf_shop no-lock where
     1891               buf_shop.obj-code = sh-clients.obj-code no-error.
     1892           p_body_name = (reportname + " " + buf_shop.addres1).
     1893       end.
     1894       num#col# = 0 .
     1895       num#str# = 0 .
     1896       num#col# = 1 .
     1897       num#str# = num#str# + 1 .
     1898       run macr_excel_char_with_format in this-procedure ( reportname , num#str# , num#col#  ).
     1899       run macr_cell_format in this-procedure
     1900           ( 12    ,
     1901           true  ,
     1902           false ,
     1903           ?     ,
     1904           num#str# ,
     1905           num#col# ,
     1906           ? ,
     1907           ?         ) .
     1908       p-subject-text = (reportname + " " + v-cntxt-host-name-obj ).
     1909       run make-str-1 in this-procedure .
     1910       Output stream Macr_Excel  close .
     1911       run paramls-write in this-procedure
     1912           (input "file"
     1913           ,input "Результат"
     1914           ,input v-file-name
     1915           ) .
     1916       run mf in this-procedure .
     1917       run end-proc in this-procedure  .
     1918       run rep/mcr-exl.p  ( v-file-name, output p-file-excel).
     1919       if buf_firm.e-mail = '' then do: message substitute("В карточке клиента не указан адрес электронной почты, нельзя отправить сообщение!")
     1920       view-as alert-box error.
     1921       return error.
     1922       end.
     1923       else do:
     1924       run gbl/sendmail.p (  buf_firm.e-mail , p-subject-text , p_body_name , p-file-excel) no-error.
     1925        end.
     1926   end.
     1927   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1928   procedure macr_excel_char :
     1929    do
     1930    on error undo, return error return-value
     1931    :
     1932    define input parameter  p-val as character no-undo .
     1933    define input parameter  p-row as integer no-undo .
     1934    define input parameter  p-col as integer no-undo .
     1935    if p-val = ? then p-val = "" .
     1936       put stream macr_excel unformatted
     1937             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1938    end.
     1939   end procedure.
     1940   procedure macr_excel_char_with_format :
     1941    do
     1942    on error undo, return error return-value
     1943    :
     1944    define input parameter  p-val as character no-undo .
     1945    define input parameter  p-row as integer no-undo .
     1946    define input parameter  p-col as integer no-undo .
     1947    if p-val = ? then p-val = "" .
     1948       put stream macr_excel unformatted
     1949             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1950       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1951       put stream macr_excel unformatted
     1952             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1953    end.
     1954   end procedure.
     1955   procedure macr_excel_cell_format :
     1956    do
     1957    on error undo, return error return-value
     1958    :
     1959    define input parameter  p-val    as character no-undo .
     1960    define input parameter  p-row    as integer   no-undo .
     1961    define input parameter  p-col    as integer   no-undo .
     1962    define input parameter  p-format as character no-undo .
     1963    if p-val = ? then p-val = "" .
     1964       put stream macr_excel unformatted
     1965             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1966       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1967       put stream macr_excel unformatted
     1968             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1969    end.
     1970   end procedure.
     1971   procedure macr_excel_sum :
     1972    do
     1973    on error undo, return error return-value
     1974    :
     1975    define input parameter  p-row as integer no-undo .
     1976    define input parameter  p-col as integer no-undo .
     1977    define input parameter  p-row1 as integer no-undo .
     1978    define input parameter  p-col1 as integer no-undo .
     1979    define input parameter  p-row2 as integer no-undo .
     1980    define input parameter  p-col2 as integer no-undo .
     1981       put stream macr_excel unformatted
     1982             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1983    end.
     1984   end procedure.
     1985   procedure macr_excel_dec :
     1986    do
     1987    on error undo, return error return-value
     1988    :
     1989    define input parameter  p-val as character no-undo .
     1990    define input parameter  p-row as integer   no-undo .
     1991    define input parameter  p-col as integer   no-undo .
     1992     if p-val = ? then p-val =  "" .
     1993      put  stream macr_excel unformatted
     1994           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1995    end.
     1996   end procedure.
     1997   procedure macr_cell_format :
     1998    do
     1999    on error undo, return error return-value
     2000    :
     2001    define input parameter  p-size   as integer   no-undo .
     2002    define input parameter  p-bold   as logical   no-undo .
     2003    define input parameter  p-italic as logical   no-undo .
     2004    define input parameter  p-color  as integer   no-undo .
     2005    define input parameter  p-row    as integer   no-undo .
     2006    define input parameter  p-col    as integer   no-undo .
     2007    define input parameter  p-row-2  as integer   no-undo .
     2008    define input parameter  p-col-2  as integer   no-undo .
     2009     if p-size = ? then p-size = 10 .
     2010     if p-bold = ? then p-bold = false .
     2011     if p-italic = ? then p-italic = false .
     2012     if p-row-2 = ? then p-row-2 = p-row .
     2013     if p-col-2 = ? then p-col-2 = p-col .
     2014     put  stream macr_excel unformatted
     2015      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2016     if p-color <> ? then do:
     2017        put  stream macr_excel unformatted
     2018          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2019     end.
     2020     put  stream macr_excel unformatted
     2021          substitute('format.font(,&1,&2,&3)' , p-size,
     2022                                           string ( p-bold  , "true/false" ) ,
     2023                                           string ( p-italic , "true/false" )
     2024                                           ) + chr(10) .
     2025    end.
     2026   end procedure.
     2027   procedure macr_cell_size :
     2028    do
     2029    on error undo, return error return-value
     2030    :
     2031    define input parameter  p-w   as integer   no-undo .
     2032    define input parameter  p-l   as integer   no-undo .
     2033    define input parameter  p-row    as integer   no-undo .
     2034    define input parameter  p-col    as integer   no-undo .
     2035    define input parameter  p-row-2  as integer   no-undo .
     2036    define input parameter  p-col-2  as integer   no-undo .
     2037     if p-row-2 = ? then p-row-2 = p-row .
     2038     if p-col-2 = ? then p-col-2 = p-col .
     2039     if p-w = ? then    p-w = 0 .
     2040     if p-l = ? then    p-l = 0 .
     2041    define variable s-w as character no-undo .
     2042    define variable s-l as character no-undo .
     2043    if p-w = 0 then s-w = "" .
     2044               else s-w = string(p-w)  .
     2045    if p-l = 0 then s-l = "" .
     2046               else s-l = string(p-l)  .
     2047   put  stream macr_excel unformatted
     2048        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2049   put  stream macr_excel unformatted
     2050        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2051   put  stream macr_excel unformatted
     2052        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2053    end.
     2054   end procedure.
     2055   procedure proc-print-header :
     2056    do
     2057    on error undo, return error return-value
     2058    :
     2059      find first sheetf .
     2060        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2061        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2062        var-1 =  num#str# .
     2063        repeat c-c = 1 to sheetf.excel-row-title :
     2064        num#str# = num#str# + 1 .
     2065        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2066        do c-i = 1 to p-var :
     2067           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2068           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2069           num#col# = c-i .
     2070           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2071           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2072        end.
     2073       c-i = 0.
     2074       end.
     2075       run macr_cell_format (
     2076           10       ,
     2077           true     ,
     2078           false    ,
     2079           35       ,
     2080           var-1 + 1,
     2081           1        ,
     2082           num#str# ,
     2083           num#col# )
     2084           .
     2085     put  stream macr_excel unformatted
     2086          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2087          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2088          .
     2089    end.
     2090   end procedure.
     2091   procedure end-proc :
     2092    do
     2093    on error undo, return error return-value
     2094    :
     2095     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2096     OUTPUT to VALUE (v-file-name) .
     2097     for each temp-param :
     2098       export  temp-param  .
     2099     end.
     2100    end.
     2101   end procedure.
     2102   procedure make-str-1 :
     2103       do
     2104           on error undo, return error return-value
     2105           :
     2106   num#col# = 0 .
     2107    num#str# = 0 .
     2108    num#col# = 1 .
     2109    num#str# = num#str# + 1 .
     2110    run macr_excel_char_with_format in this-procedure ( reportname , num#str# , num#col#  ).
     2111    run macr_cell_format in this-procedure
     2112             ( 12    ,
     2113               true  ,
     2114               false ,
     2115               ?     ,
     2116               num#str# ,
     2117               num#col# ,
     2118               ? ,
     2119               ?         ) .
     2120   reportheader =   cur-time-print() .
     2121   num#col# = num#col# + 1 .
     2122   num#str# = num#str# + 1 .
     2123   num#col# = 1 .
     2124   p-name = "Покупатель: " .
     2125   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2126   num#col# =  2 .
     2127   run macr_excel_char_with_format in this-procedure ( sh-clients.obj-name , num#str# , num#col#  ).
     2128   num#str# = num#str# + 1 .
     2129   num#col# =  1 .
     2130   p-name = "Поставщик: " .
     2131   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2132   num#col# =  2 .
     2133   run macr_excel_char_with_format in this-procedure ( post-clients.obj-name , num#str# , num#col#  ).
     2134   num#str# = num#str# + 1 .
     2135   num#col# = 1 .
     2136   p-name = "Дата печати: " .
     2137   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2138   num#col# = 2 .
     2139   run macr_excel_char_with_format in this-procedure ( string( today ,"99/99/9999") , num#str# , num#col#  ).
     2140   num#str# = num#str# + 1 .
     2141   num#col# = 1 .
     2142   p-name = "Планируемая дата доставки: " .
     2143   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2144   num#col# = 2 .
     2145   run macr_excel_char_with_format in this-procedure ( string( p-ship-date,"99/99/9999") , num#str# , num#col#  ).
     2146   num#col# = 3 .
     2147   run macr_excel_char_with_format in this-procedure ( string( p-ship-time,"hh:mm") , num#str# , num#col#  ).
     2148    run macr_cell_format in this-procedure  (
     2149           10       ,
     2150           true     ,
     2151           false    ,
     2152           36      ,
     2153           6        ,
     2154           1        ,
     2155           6        ,
     2156          ( if p-doc-type <> 'ОФ':U then 24    else 17 )
     2157            )
     2158           .
     2159   num#col# =  0 .
     2160   num#str# = num#str# + 1 .
     2161   num#col# = num#col# + 1 .
     2162   p-name = "Артикул" .
     2163   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2164   put  stream macr_excel unformatted  'COLUMN.WIDTH(17,,,,)'  skip.
     2165   num#col# = num#col# + 1 .
     2166   p-name = "Тип производителя " .
     2167   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2168   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2169   num#col# = num#col# + 1 .
     2170   p-name = "Код производителя " .
     2171   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2172   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2173   num#col# = num#col# + 1 .
     2174   p-name = "Название товара" .
     2175   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2176   put  stream macr_excel unformatted  'COLUMN.WIDTH(50,,,,)'  skip.
     2177   num#col# = num#col# + 1 .
     2178   p-name = "Артикул поставщика" .
     2179   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2180   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2181   num#col# = num#col# + 1 .
     2182   p-name = "Цена в валюте поставщика на баз.ед.изм." .
     2183   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2184   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2185   num#col# = num#col# + 1 .
     2186   p-name = "Количество в баз.ед.изм" .
     2187   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2188   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2189   put  stream macr_excel unformatted  'COLUMN.WIDTH(15,,,,)'  skip.
     2190     put  stream macr_excel unformatted
     2191          substitute('select("r&1c&2:r&3c&4 ")' , 6  , 1 , num#str# ,  num#col# ) + chr(10)  +
     2192           'BORDER( 2 , 2 , 2 , 2 , 8 , ) '  + chr(10) +
     2193          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2194          .
     2195   num#col# =  0.
     2196   for each  buf_ord-line no-lock where  buf_ord-line.doc-code = p-ord-doc break by buf_ord-line.line-num  :
     2197       find first goods no-lock where
     2198             goods.artic     = buf_ord-line.artic     and
     2199             goods.prod-type = buf_ord-line.prod-type and
     2200             goods.prod-code = buf_ord-line.prod-code no-error .
     2201             if error-status :error then next.
     2202       find first clients no-lock where
     2203             goods.prod-type = clients.obj-type and
     2204             goods.prod-code = clients.obj-code no-error .
     2205             if error-status :error then next.
     2206       num#col# = 1 .
     2207       num#str# = num#str# + 1 .
     2208       run macr_excel_char_with_format in this-procedure ( buf_ord-line.artic , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2209       run macr_excel_char_with_format in this-procedure ( buf_ord-line.prod-type , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2210       run macr_excel_char_with_format in this-procedure ( buf_ord-line.prod-code , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2211       run macr_excel_char_with_format in this-procedure ( goods.gds-name , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2212       run macr_excel_char_with_format in this-procedure ( (if buf_ord-line.cli-art <> ? then buf_ord-line.cli-art  else "") , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2213       run macr_excel_dec in this-procedure ( determined ( buf_ord-line.price-cli / buf_ord-line.cli-base-rate) , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2214       run macr_excel_dec in this-procedure ( buf_ord-line.qnty       , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2215   end.
     2216    end.
     2217   end procedure.
     2218   procedure mf :
     2219    do
     2220    on error undo, return error return-value
     2221    :
     2222       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     2223       output stream  Macr_Excel to value(v-file-name) .
     2224       v-ind = v-ind + 1 .
     2225       num#str# = 0 .
     2226    end.
     2227   end procedure.
     2228   procedure ver-edi :
     2229   define parameter buffer buf_ord-doc for ub.ord-doc.
     2230   define output parameter p-res as logical no-undo .
     2231   p-res = (buf_ord-doc.whole-send-news <> integer('2':U)).
     2232   if not p-res then do:
     2233   message "Экспорт заказа запрещен!"
     2234     view-as alert-box warning .
     2235   end.
     2236   end procedure.
