        7   define variable vss-revision    as character no-undo init "$Revision: e47eaee10c88, 211, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: SShalanin $":U .
        9   define variable vss-date        as character no-undo init "$Date: Tue Jun 30 11:11:56 2015 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: z-tott.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: cus/z-tott.p $":U .
