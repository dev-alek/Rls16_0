     1955   index isdone
     1956   done
     1957   .
     1958   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1959   do
     1960   on error undo, return error return-value
     1961   :
     1962     define variable v-counter                   as integer      no-undo.
     1963     define variable v-param-list                as character    no-undo.
     1964     define variable v-param-type                as character    no-undo.
     1965     define variable v-range                     as integer      no-undo.
     1966     define variable v-host-code                 as integer      no-undo.
     1967     define variable v-parameter                 as character    no-undo .
     1968     define variable v-dir-name  as character no-undo .
     1969     define variable v-dir-type  as character no-undo .
     1970     define variable v-can-read  as logical   no-undo .
     1971     define variable v-file-name as character no-undo .
     1972     define variable v-dc-type   as character no-undo .
     1973     define variable v-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     1974     define variable path as character no-undo .
     1975     define variable file as character no-undo .
     1976     define variable atr as character no-undo .
     1977     define variable glog        as logical   no-undo .
     1978     define variable ii          as integer   no-undo .
     1979     define variable v-entry     as character no-undo .
     1980     define variable v-obj-type  like ub.clients.obj-type no-undo .
     1981     define variable v-obj-code  like ub.clients.obj-code no-undo .
     1982     define variable v-str as character no-undo .
     1983     DEFINE VARIABLE v-today as date no-undo .
     1984     DEFINE VARIABLE v-time as integer no-undo .
     1985     define variable v-other-params as character no-undo .
     1986     define variable v-rule-profile-id as integer   no-undo .
     1987     define variable v-codex-id as integer no-undo init 4.
     1988     define variable v-ruleset-id as integer no-undo init 1.
     1989     define variable v-rid-list as character no-undo .
     1990     define buffer buf_rule-call-param for ub.rule-call-param.
     1991     DEFINE NEW SHARED TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
     1992     define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1993     DEFINE BUFFER X_dis-card-type FOR ub.dis-card-type.
     1994     DEFINE BUFFER X_rp-by-call FOR ub.rp-by-call.
     1995     DEFINE BUFFER X_rule FOR ub.rule.
     1996     DEFINE BUFFER X_rule-by-profile FOR ub.rule-by-profile.
     1997     DEFINE BUFFER X_rule-profile FOR ub.rule-profile.
     1998     DEFINE BUFFER X_rule-by-call FOR ub.rule-by-call.
     1999     define stream DirStream.
     2000       assign
     2001       log-file-name = "shd-free.log".
     2002       run schedule-attr-value in this-procedure (
     2003             input p-cre-db-num
     2004           , input p-task-type
     2005           , input p-task-num
     2006           , input 'schedule-param-list':U
     2007           , output v-param-list
     2008           , output v-param-type
     2009       ).
     2010       if v-param-list = "":U then do:
     2011          run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Не заданы параметры импорта данных по ДК из системы ЛАНТАБ в задаче &1&2"                                      , p-task-num                                                                                                            , chr(10))).
     2012          return.
     2013       end.
     2014       assign
     2015       v-rule-profile-id = integer(entry(1, v-param-list, chr(4) ))
     2016       v-dir-name = entry(2, v-param-list, chr(4) )
     2017       v-file-name = entry(3, v-param-list, chr(4) )
     2018       v-emitent-host-code = integer(entry(4, v-param-list, chr(4) ))
     2019       v-dc-type = entry(5, v-param-list, chr(4) )
     2020       no-error .
     2021       if error-status :error then do:
     2022         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Ошибки при получении параметров импорта данных&1" +                              "&2&1&3&1"                                                                            , error-status:get-message(1)                                                         , return-value )).
     2023         return.
     2024       end.
     2025       v-other-params = v-param-list
     2026       .
     2027       ENTRY(1, v-other-params, chr(4)) = '':U.
     2028       ENTRY(2, v-other-params, chr(4)) = '':U.
     2029       ENTRY(3, v-other-params, chr(4)) = '':U.
     2030       ENTRY(4, v-other-params, chr(4)) = '':U.
     2031       ENTRY(5, v-other-params, chr(4)) = '':U.
     2032       v-other-params = substring(v-other-params, 6).
     2033       FIND FIRST X_rule-profile NO-LOCK WHERE
     2034                 X_rule-profile.profile_id = v-rule-profile-id NO-ERROR.
     2035       IF NOT AVAILABLE X_rule-profile THEN DO:
     2036         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input "Не найден профайл для работы импорта из системы ЛАНТАБ").
     2037         return.
     2038       END.
     2039       FIND FIRST X_rule-by-profile NO-LOCK WHERE
     2040               X_rule-by-profile.profile_id = v-rule-profile-id
     2041           AND X_rule-by-profile.codex_id = v-codex-id
     2042           AND X_rule-by-profile.ruleset_id = v-ruleset-id NO-ERROR.
     2043       IF NOT AVAILABLE X_rule-profile THEN DO:
     2044         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input "Не найдено или неопределено правило для импорта из системы ЛАНТАБ").
     2045         return.
     2046       END.
     2047       FIND FIRST X_rule NO-LOCK WHERE
     2048             X_rule.rule_id = X_rule-by-profile.rule_id.
     2049       IF NOT AVAILABLE X_rule THEN DO:
     2050         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Не найдено правило &1 для импорта из системы ЛАНТАБ", X_rule-by-profile.rule_id)).
     2051         return.
     2052       END.
     2053       FIND FIRST X_dis-card-type NO-LOCK WHERE
     2054                   X_dis-card-type.emitent-host-code = v-emitent-host-code
     2055             AND   X_dis-card-type.type = v-dc-type
     2056             AND X_dis-card-type.host-code = 0
     2057             AND X_dis-card-type.obj-type = '':U
     2058             AND X_dis-card-type.obj-code = 0 NO-ERROR.
     2059       IF NOT AVAILABLE X_dis-card-type  THEN DO:
     2060         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Неизвестный тип ДК &1 эмитент &2"                 , v-dc-type                                                    , v-emitent-host-code)).
     2061         return.
     2062       END.
     2063       FIND FIRST X_rp-by-call NO-LOCK WHERE
     2064                 X_rp-by-call.profile_id = v-rule-profile-id
     2065           AND   X_rp-by-call.call_id = X_dis-card-type.uniq-key-rec NO-ERROR.
     2066       IF NOT AVAILABLE X_rp-by-call THEN DO:
     2067         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Тип ДК &1 эмитент &2 не привязан к профайлу импорта-экспорта в систему ЛАНТАБ"                   , v-dc-type                                                                                                  , v-emitent-host-code)).
     2068         return.
     2069       END.
     2070       find X_rule-by-call where
     2071           X_rule-by-call.call#_id = X_rp-by-call.call#_id
     2072        and X_rule-by-call.rule_id = X_rule-by-profile.rule_id
     2073        and X_rule-by-call.profile_id = X_rule-by-profile.profile_id no-error .
     2074       if ambiguous X_rule-by-call then do:
     2075         if not g#auto then do:
     2076           message
     2077           "Выберите какой вызов правила Вас необходим"
     2078           view-as alert-box .
     2079           run rul/rule-by-call-s.w ( input parparentproc
     2080                                     ,input "b-sel"
     2081                                     ,input "call_id"
     2082                                     ,input X_rp-by-call.call_id
     2083                                     ,input X_rule-by-profile.codex_id
     2084                                     ,input X_rule-by-profile.ruleset_id
     2085                                     ,input X_rule-by-profile.rule_id
     2086                                     ,input-output v-rid-list) no-error .
     2087           if v-rid-list = '':u then do:
     2088             UNDO, RETURN ERROR.
     2089           end.
     2090         end.
     2091         else do:
     2092          run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("К Типу ДК &1 эмитент &2 привязано два профайла импорта-экспорта в систему ЛАНТАБ"                   , v-dc-type                                                                                                  , v-emitent-host-code)).
     2093           return.
     2094         end.
     2095         find first X_rule-by-call no-lock where
     2096                   recid(X_rule-by-call) = integer(v-rid-list) no-error .
     2097         if not available X_rule-by-call then do:
     2098           UNDO, RETURN ERROR.
     2099         end.
     2100       end.
     2101       FOR each buf_Rule-call-param no-lock where
     2102             buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     2103       and  buf_rule-call-param.codex_id = X_rule-by-profile.codex_id
     2104       and  buf_rule-call-param.ruleset_id = X_rule-by-profile.ruleset_id
     2105       and  buf_rule-call-param.order_id = X_rule-by-call.order_id:
     2106         create buf_tt0-rule-call-param.
     2107         buffer-copy buf_rule-call-param to buf_tt0-rule-call-param.
     2108         CASE buf_rule-call-param.param-data-type:
     2109           WHEN 'character':U THEN DO:
     2110             ASSIGN
     2111             buf_tt0-rule-call-param.param-value-character = ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4))
     2112             NO-ERROR.
     2113           END.
     2114           WHEN 'date':U THEN DO:
     2115             ASSIGN
     2116             buf_tt0-rule-call-param.param-value-date = IF entry(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)) = chr(63)
     2117                                                         THEN ?
     2118                                                         ELSE DATE(ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)))
     2119             NO-ERROR.
     2120           END.
     2121           WHEN 'decimal':U THEN DO:
     2122             ASSIGN
     2123             buf_tt0-rule-call-param.param-value-decimal = decimal(ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)))
     2124             NO-ERROR.
     2125           END.
     2126           WHEN 'integer':U THEN DO:
     2127             ASSIGN
     2128             buf_tt0-rule-call-param.param-value-integer = integer(ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)))
     2129             NO-ERROR.
     2130           END.
     2131           WHEN 'logical':U THEN DO:
     2132             ASSIGN
     2133             buf_tt0-rule-call-param.param-value-logical = logical(ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)))
     2134             NO-ERROR.
     2135           END.
     2136         END CASE.
     2137         IF ERROR-STATUS:ERROR THEN DO:
     2138         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Некорректное значение параметра &1=&2"                      ,buf_tt0-rule-call-param.param-label                                   ,BUFFER buf_tt0-rule-call-param:HANDLE:BUFFER-FIELD(substitute("param-value-&1", buf_tt0-rule-call-param.param-data-type)):buffer-value)).
     2139         return.
     2140         END.
     2141       end.
     2142       case v-dir-name:
     2143         when 'ini':U then do:
     2144           run verify-ini-entry in this-procedure (
     2145                                               INPUT  'dctxt-i_in'
     2146                                               ,INPUT 'schedule-free'
     2147                                               ,INPUT substitute("отсутствует параметр &1 секция &2 в ini-файле"
     2148                                                                 , 'dctxt-i_in'
     2149                                                                 , 'schedule-free')
     2150                                               ,INPUT no
     2151                                               ,output v-dir-name) no-error .
     2152           if error-status:error or v-dir-name = ? then do:
     2153             .
     2154             return .
     2155           end.
     2156           RUN verify-file in this-procedure
     2157                                             (input v-dir-name
     2158                                             ,input substitute("Не найден каталог &1 параметр &2, секция &3 ini-файла"
     2159                                                           , v-dir-name
     2160                                                           , 'schedule-free'
     2161                                                           , 'dctxt-i_in')
     2162                                             ,input no
     2163                                             ,output  glog) no-error.
     2164           if error-status:error or not glog then do:
     2165             .
     2166             return .
     2167           end.
     2168         end.
     2169         otherwise do:
     2170           v-dir-name = v-dir-name.
     2171         end.
     2172       END CASE.
     2173       assign
     2174       file-info:file-name = v-dir-name
     2175       v-dir-type = file-info:file-type
     2176       v-can-read = ( index( v-dir-type, "R" ) > 0 )
     2177       .
     2178       if index( v-dir-type, "D" ) = 0 then do:
     2179         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Выбранный для экспорта каталог &1 - недоступен", v-dir-name)).
     2180         return .
     2181       end.
     2182       if not v-can-read then do:
     2183         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Выбранный для экспорта каталог &1 - недоступен", v-dir-name)).
     2184         return .
     2185       end.
     2186       if index(v-file-name, chr(63)) = 0
     2187       and index(v-file-name, '*':U) = 0 then do:
     2188         path = (trim(trim(v-dir-name, chr(47)), chr(92)) + chr(92) + v-file-name).
     2189           run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute( "Обработка файла импорта &1", path)).
     2190         run str/saledc.p                                                                                                  (                                                                                                                 input parparentproc                                                                                           ,input this-procedure :handle                                                                                   ,input p-log-handle                                                                                             ,input 'text-import':U                                                                                ,input X_dis-card-type.emitent-host-code                                                                        ,input X_dis-card-type.TYPE                                                                                     ,INPUT X_rule-by-profile.profile_id                                                                             ,INPUT 0                                                                                          ,INPUT 0                                                                                        ,input g#db-num                                                                                                 ,input (string(next-value(s-v-doc, ub)) + chr(4) +                                                   path                                                                                                      )                                                                                                       ,input ?                                                                          ,input ?                                                                         ,input ?                                                                                             ,input 1                                                                                              ,input 1                                                                                       ,input yes                                                                                            ) no-error .                                                                                                    if error-status:error then do:                                                                                      run write-log-and-file in p-log-handle (                                                                          input 1                                                                                                        , input log-file-name                                                                                            , input 1                                                                                                        , input substitute ("!!!Ошибка при импорта данных по ДК из файла &1&2&3&2&4"                                                       , path                                                                                                           , chr(10)                                                                                                  , error-status:get-message(1)                                                                                    , return-value )).                                                                           end.                                                                                                             if search(trim(v-dir-name, chr(92)) + '\save\' + file) <> ? then do:                                  OS-DELETE VALUE(trim(v-dir-name, chr(92)) + '\save\' + file).                                     END.                                                                                                                 os-rename value( path )                                                                                      value(trim(v-dir-name, chr(92)) + '\save\' + file).                                                 os-delete value( path ).
     2191       end.
     2192       else do:
     2193         input stream DirStream from os-dir ( v-dir-name ) .
     2194         REPEAT :
     2195           import stream DirStream file path atr.
     2196           if can-do( "f", atr )
     2197           AND  REPLACE(file, '.', '>') matches replace( REPLACE(v-file-name, '.', '>') , '?', ".")
     2198           then do:
     2199               run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute( "Обработка файла импорта &1", path)).
     2200             run str/saledc.p                                                                                                  (                                                                                                                 input parparentproc                                                                                           ,input this-procedure :handle                                                                                   ,input p-log-handle                                                                                             ,input 'text-import':U                                                                                ,input X_dis-card-type.emitent-host-code                                                                        ,input X_dis-card-type.TYPE                                                                                     ,INPUT X_rule-by-profile.profile_id                                                                             ,INPUT 0                                                                                          ,INPUT 0                                                                                        ,input g#db-num                                                                                                 ,input (string(next-value(s-v-doc, ub)) + chr(4) +                                                   path                                                                                                      )                                                                                                       ,input ?                                                                          ,input ?                                                                         ,input ?                                                                                             ,input 1                                                                                              ,input 1                                                                                       ,input yes                                                                                            ) no-error .                                                                                                    if error-status:error then do:                                                                                      run write-log-and-file in p-log-handle (                                                                          input 1                                                                                                        , input log-file-name                                                                                            , input 1                                                                                                        , input substitute ("!!!Ошибка при импорта данных по ДК из файла &1&2&3&2&4"                                                       , path                                                                                                           , chr(10)                                                                                                  , error-status:get-message(1)                                                                                    , return-value )).                                                                           end.                                                                                                             if search(trim(v-dir-name, chr(92)) + '\save\' + file) <> ? then do:                                  OS-DELETE VALUE(trim(v-dir-name, chr(92)) + '\save\' + file).                                     END.                                                                                                                 os-rename value( path )                                                                                      value(trim(v-dir-name, chr(92)) + '\save\' + file).                                                 os-delete value( path ).
     2201           end.
     2202         end.
     2203         input stream Dirstream close.
     2204       end.
     2205      run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Обработка файлов импорта завершена")).
     2206      if can-find (first  ub.BatchProcess no-lock
     2207         where ub.BatchProcess.bp_type       = 'dcard':U
     2208           and ub.BatchProcess.bp_status     = 'N':U
     2209                  ) then do:
     2210       run set-title in p-log-handle (
     2211             input 'Отправка информации по клиентским картам на кассу'
     2212                                       ).
     2213       run trg/bt_dcard.p (
     2214                       input parparentproc
     2215                     , input p-log-handle
     2216                     , input no) no-error .
     2217       if error-status:error or
     2218       return-value = "yes":U then do:
     2219         run set-view-log in p-log-handle(yes).
     2220       end.
     2221     end.
     2222   end.
