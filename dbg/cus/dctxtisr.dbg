     1546       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     1547       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     1548       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     1549       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     1550       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1551       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     1552       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     1553       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1554       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     1555       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     1556       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     1557       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     1558       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     1559       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     1560       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     1561       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     1562       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1563       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1564       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1565       define variable varinvatp-envdo             as   character              no-undo.
     1566       define variable varinvatp-typeo             as   character              no-undo.
     1567       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     1568       define buffer buf_gds-dtl  for ub.gds-dtl .
     1569       define buffer buf_goods    for ub.goods .
     1570       define buffer buf_trn-doc  for ub.trn-doc .
     1571       define buffer buf_doc-line for ub.doc-line .
     1572       find first buf_doc-line no-lock
     1573         where buf_doc-line.doc-code  = p-doc-code
     1574           and buf_doc-line.artic     = p-artic
     1575           and buf_doc-line.prod-type = p-prod-type
     1576           and buf_doc-line.prod-code = p-prod-code
     1577         no-error .
     1578       if not available buf_doc-line then do:
     1579         message
     1580           vss-workfile vss-revision vss-description skip
     1581           vss-include-info10 skip
     1582           "Ошибка задания входных параметров" skip
     1583           "Не найдена строка документа" skip
     1584           "Документ" p-doc-code skip
     1585           "Артикул" p-artic p-prod-type p-prod-code skip
     1586           view-as alert-box error .
     1587         undo, return error .
     1588       end.
     1589       find first buf_trn-doc no-lock
     1590         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1591         no-error .
     1592       if not available buf_trn-doc then do:
     1593         message
     1594           vss-workfile vss-revision vss-description skip
     1595           vss-include-info10 skip
     1596           "Не найден документ" skip
     1597           "Документ" p-doc-code skip
     1598           "Артикул" p-artic p-prod-type p-prod-code skip
     1599           view-as alert-box error .
     1600         undo, return error .
     1601       end.
     1602       for each buf_gds-dtl no-lock
     1603         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     1604           and buf_gds-dtl.artic     = buf_doc-line.artic
     1605           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1606           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1607       on error undo, return error
     1608       :
     1609           if buf_trn-doc.doc-type <> 'инв':U
     1610           then do:
     1611               if buf_trn-doc.doc-type = 'при':U
     1612               or buf_trn-doc.doc-type = 'возврат':U
     1613               then do:
     1614                   assign
     1615                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1616                   .
     1617               end.
     1618               else do:
     1619                   assign
     1620                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1621                   .
     1622               end.
     1623           end.
     1624           else do:
     1625               assign
     1626                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1627               .
     1628           end.
     1629           if v-gds-dtl-fact-qnty <> 0
     1630           then do:
     1631   if buf_trn-doc.ext-doc-type = 'ot':U or
     1632      buf_trn-doc.ext-doc-type = ?                 then do:
     1633     assign
     1634      out-vatp-have-vat-slt = yes.
     1635   end.
     1636   else do:
     1637     find first out-vatp_doc-attr no-lock
     1638       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1639         and out-vatp_doc-attr.attr-code = 'envd':U
     1640         no-error .
     1641     if not available out-vatp_doc-attr then do:
     1642       assign
     1643         out-vatp-have-vat-slt = yes.
     1644     end.
     1645     else do:
     1646        out-vatp-have-vat-slt = no.
     1647     end.
     1648   end.
     1649   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     1650                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     1651                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     1652   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1653   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1654     (input  buf_doc-line.artic
     1655     ,input  buf_doc-line.prod-type
     1656     ,input  buf_doc-line.prod-code
     1657     ,output varroot-node
     1658     ) no-error .
     1659   if error-status :error then do:
     1660     message
     1661       vss-workfile vss-revision vss-description skip
     1662       "Ошибка при определении корневого признака товара" skip
     1663       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1664       error-status :get-message(1) skip
     1665       return-value skip
     1666       view-as alert-box error .
     1667     undo, return error .
     1668   end.
     1669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1670     (input  varroot-node
     1671     ,input  'empty-scale=request'
     1672     ,output varempty-scale
     1673     ) no-error .
     1674   if error-status :error then do:
     1675     message
     1676       vss-workfile vss-revision vss-description skip
     1677       "Ошибка при определении атрибута признака" skip
     1678       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1679       "Признак" varroot-node skip
     1680       "Запрашивался атрибут" "empty-scale=request" skip
     1681       error-status :get-message(1) skip
     1682       return-value skip
     1683       view-as alert-box error .
     1684     undo, return error .
     1685   end.
     1686   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1688     (output varoutvprb
     1689     )  .
     1690   if varoutvprb = "base":u then do:
     1691     assign
     1692           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1693       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     1694     .
     1695   end.
     1696   else do:
     1697     assign
     1698           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1699       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1700     .
     1701   end.
     1702   if varoutvprb = "rubl":u then do:
     1703     assign
     1704           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1705       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     1706   end.
     1707   else do:
     1708     assign
     1709           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     1710       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     1711   end.
     1712   assign
     1713     varis-cons-parts-have =  no.
     1714   assign
     1715     varfact-qnty       = 0
     1716     varcons-qnty       = 0
     1717     varprice-base-cons = 0
     1718     varprice-rubl-cons = 0.
     1719   find first out-vatp_doc-line where
     1720              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     1721          and out-vatp_doc-line.artic      = buf_doc-line.artic
     1722          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     1723          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     1724   if available out-vatp_doc-line           and
     1725     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1726     assign
     1727       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1728   end.
     1729   else do:
     1730     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     1731                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     1732                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     1733                                  and out-vatp_parts.artic      = buf_doc-line.artic
     1734                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     1735                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     1736       if out-vatp_parts.purch-code = 2 then do:
     1737   assign
     1738     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1739     price-base-with-tax-loco = out-vatp_parts.price-base
     1740   .
     1741   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1742   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1743     (output varinvprbo
     1744     )  .
     1745     if out-vatp_parts.out-code = 'free-zone':U     or
     1746        out-vatp_parts.out-code = 'out-zone':U   or
     1747        out-vatp_parts.doc-type = 'акт':U then do:
     1748       assign
     1749         in-vatp-have-vat-slto = yes.
     1750     end.
     1751     else do:
     1752       find first in-vatp_doc-attro no-lock
     1753         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1754           and in-vatp_doc-attro.attr-code = 'envd':U
     1755         no-error .
     1756       if not available in-vatp_doc-attro then do:
     1757         assign
     1758           in-vatp-have-vat-slto = yes.
     1759       end.
     1760       else do:
     1761            in-vatp-have-vat-slto = no.
     1762       end.
     1763     end.
     1764     assign
     1765      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1766      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1767     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1768              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1769     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     1770             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     1771             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     1772             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     1773             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     1774             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     1775             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1776       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1777     assign
     1778       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     1779     assign
     1780       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     1781       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     1782       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     1783       transport-cli-loco  = 0
     1784       other-cli-loco      = 0
     1785     .
     1786   ASSIGN
     1787             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     1788       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     1789   .
     1790         assign
     1791           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     1792           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     1793         assign
     1794           varis-cons-parts-have = yes
     1795           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     1796       end.
     1797       assign
     1798         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     1799     end.
     1800   end.
     1801   assign
     1802     varprice-base-cons = varprice-base-cons / varcons-qnty
     1803     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     1804   if varprice-base-cons = ? then do:
     1805     assign
     1806       varprice-base-cons = 0.
     1807   end.
     1808   if varprice-rubl-cons = ? then do:
     1809     assign
     1810       varprice-rubl-cons = 0.
     1811   end.
     1812   assign
     1813       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1814     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1815     discnt-base-sale            = buf_gds-dtl.discnt-base
     1816     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1817       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1818     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1819     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     1820     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1821     .
     1822   if buf_trn-doc.doc-type = 'инв':U then do:
     1823     assign
     1824       varfact-qnty = buf_gds-dtl.doc-qnty.
     1825   end.
     1826   else do:
     1827     assign
     1828       varfact-qnty = buf_gds-dtl.fact-qnty.
     1829   end.
     1830   if varis-cons-parts-have = no then do:
     1831     assign
     1832           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1833           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     1834   end.
     1835   else do:
     1836     if buf_trn-doc.doc-type = 'инв':U then do:
     1837       assign
     1838               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1839               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1840        .
     1841     end.
     1842     else do:
     1843       assign
     1844               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1845               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1846        .
     1847     end.
     1848   end.
     1849   assign
     1850   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1851   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1852               ASSIGN
     1853                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1854                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1855                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1856                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1857                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1858                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1859                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1860                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1861                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1862                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1863                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1864                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1865                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1866               .
     1867           end.
     1868       end.
     1869       assign
     1870           p-transport-base      = 0
     1871           p-transport-rubl      = 0
     1872           p-vat-pc              = buf_doc-line.vat-pc
     1873           p-slt-pc              = buf_doc-line.slt-pc
     1874       .
     1875     end.
     1876     if p-fact-qnty      = ?
     1877     or p-vat-pc         = ?
     1878     or p-slt-pc         = ?
     1879     or p-sum-base       = ?
     1880     or p-sum-rubl       = ?
     1881     or p-vat-base       = ?
     1882     or p-vat-rubl       = ?
     1883     or p-slt-base       = ?
     1884     or p-slt-rubl       = ?
     1885     or p-road-tax-base  = ?
     1886     or p-road-tax-rubl  = ?
     1887     or p-transport-base = ?
     1888     or p-transport-rubl = ?
     1889     or p-other-base     = ?
     1890     or p-other-rubl     = ?
     1891     or p-excise-base    = ?
     1892     or p-excise-rubl    = ?
     1893     then do:
     1894       message
     1895         vss-workfile vss-revision vss-description skip
     1896         vss-include-info10 skip
     1897         "Получены неопределенные значения" skip
     1898         "Документ" p-doc-code skip
     1899         "Артикул" p-artic p-prod-type p-prod-code skip
     1900         "fact-qnty     " p-fact-qnty      skip
     1901         "vat-pc        " p-vat-pc         skip
     1902         "slt-pc        " p-slt-pc         skip
     1903         "sum-base      " p-sum-base       skip
     1904         "sum-rubl      " p-sum-rubl       skip
     1905         "vat-base      " p-vat-base       skip
     1906         "vat-rubl      " p-vat-rubl       skip
     1907         "slt-base      " p-slt-base       skip
     1908         "slt-rubl      " p-slt-rubl       skip
     1909         "road-tax-base " p-road-tax-base  skip
     1910         "road-tax-rubl " p-road-tax-rubl  skip
     1911         "transport-base" p-transport-base skip
     1912         "transport-rubl" p-transport-rubl skip
     1913         "other-base    " p-other-base     skip
     1914         "other-rubl    " p-other-rubl     skip
     1915         "excise-base   " p-excise-base    skip
     1916         "excise-rubl   " p-excise-rubl    skip
     1917         view-as alert-box error .
     1918       undo, return error .
     1919     end.
     1920   end procedure.
     1921   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1922   define new shared temp-table dc-list no-undo like ub.dis-card
     1923     field to-del as logical
     1924     field order-num as integer
     1925     field fdec as decimal
     1926     field fint as integer
     1927     field flog as logical
     1928     field fchar as character
     1929     index pi  is primary unique d-card
     1930     index cn      card-num
     1931     index cli cli-type cli-code
     1932     index host-dscnt  emitent-host-code status_ d-pcnt
     1933     index host-type  emitent-host-code type d-pcnt
     1934     index oi order-num
     1935     .
     1936   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1937   define  new shared  temp-table dc-list-hist no-undo
     1938   field list-table as character
     1939   field id as integer
     1940   field line as integer
     1941   field hist-mode as character
     1942   field des as character
     1943   field num-recs as integer
     1944   field option_ as character
