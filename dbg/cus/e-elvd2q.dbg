        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER StartPoint as date no-undo.
        3   DEFINE INPUT PARAMETER EndPoint as date no-undo.
        4   define input parameter p-cli-type as character no-undo .
        5   define input parameter p-cli-code as integer no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: e-elvd2q.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: cus/e-elvd2q.p $":U .
       11   define variable vss-description as character no-undo init "Заполнение полей временной таблицы для отчета Ведомости по клиентам".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable v-waitfram-action01         as character   no-undo .
       74   define variable v-waitfram-action02         as character   no-undo .
       75   define variable v-waitfram-action03         as character   no-undo .
       76   define variable mWaitFramTextBeg            as character   no-undo.
       77   define variable mWaitFramTextEnd            as character   no-undo.
       78   define variable mWaitFramView               as logical     no-undo.
       79   define variable mWaitProcEvent              as logical     no-undo init yes.
       80   define variable mWaitFramInterval           as integer     no-undo init 1 .
       81   define variable mWaitFramStop               as logical     no-undo.
       82   define variable mWaitFramStopUser           as logical     no-undo.
       83   define variable mWaitFramStopTimeOut        as logical     no-undo.
       84   define variable mWaitFramStartProc          as datetime-tz no-undo.
       85   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       86   define button B-WaitFramStop auto-end-key
       87        label "Стоп"
       88        size 10 by 1 tooltip "Остоновить процесс".
       89   define button B-viewProcInfo
       90        label "Информация"
       91        size 15 by 1 tooltip "Информация о процесс".
       92   define frame waitfram
       93     v-waitfram-action01 format "x(72)" no-label skip
       94     v-waitfram-action02 format "x(72)" no-label skip
       95     v-waitfram-action03 format "x(72)" no-label skip
       96     B-viewProcInfo
       97     B-WaitFramStop at row 4 col 30
       98     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       99     .
      100   define new global shared variable mBatchMode as logical no-undo init ?.
      101   define variable mFramBachModHandle as handle no-undo.
      102   mFramBachModHandle = frame waitfram:handle.
      103   define variable mFameOldVis as logical no-undo.
      104   define variable mVisCUrentVin as logical no-undo.
      105   if session:batch-mode
      106   then
      107      mBatchMode = yes.
      108   if mBatchMode = ? then do:
      109     mVisCUrentVin = current-window:visible.
      110     mFameOldVis = mFramBachModHandle:visible.
      111     mFramBachModHandle:visible  = yes.
      112     mBatchMode = mFramBachModHandle:visible ne yes.
      113     mFramBachModHandle:visible = mFameOldVis.
      114     current-window:visible = mVisCUrentVin.
      115   end.
      116    if  log-manager:logfile-name ne ?
      117     then DO:
      118         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      119         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      120         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      121     end.
      122   on choose of B-WaitFramStop in frame waitfram
      123   do:
      124     mWaitFramStop = yes.
      125     mWaitFramStopUser = yes.
      126   end.
      127   function waitfram-check-timeout returns logical():
      128      define variable vtime as int64 no-undo.
      129      if mWaitFramStopTimeOut
      130      then
      131         return yes.
      132      vtime = ( now - mWaitFramStartProc ) / 1000 .
      133      if     mWaitFramTimeOut ne ?
      134         and mWaitFramTimeOut ne 0
      135         and mWaitFramTimeOut lt vtime
      136      then do:
      137         mWaitFramStopTimeOut = yes.
      138      end.
      139      return mWaitFramStopTimeOut.
      140   end.
      141   procedure waitfram-hide :
      142     if not session:batch-mode
      143     then do
      144     on error undo, return error return-value
      145     :
      146       pause 0 before-hide .
      147       if not mBatchMode then
      148         hide frame waitfram .
      149     if     not mWaitFramView
      150        and mWaitProcEvent
      151     then
      152       process events .
      153     end.
      154   end procedure.
      155   procedure waitfram-show :
      156     define input  parameter p-message as character no-undo .
      157     define variable v-left-margin as integer   no-undo .
      158     if not session:batch-mode
      159     then do
      160     on error undo, return error return-value
      161     :
      162       if length(p-message) <= 70 then do:
      163         assign
      164           v-left-margin = integer((70 - length(p-message)) / 2)
      165         .
      166         assign
      167           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      168         .
      169         assign
      170           v-waitfram-action01 = " "
      171           v-waitfram-action02 = " "
      172                                    + fill(" ", v-left-margin)
      173                                    + p-message
      174           v-waitfram-action03 = " "
      175         .
      176       end.
      177       else do:
      178         define variable vRindex1 as integer no-undo.
      179         define variable vRindex2 as integer no-undo.
      180         vRindex1 = r-index(p-message," ",70).
      181         if vRindex1 = 0
      182         then
      183            vRindex1 = 70.
      184         if length(p-message)  <= vRindex1 + 70 then do:
      185           assign
      186             v-waitfram-action01 = " "
      187             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      189           .
      190         end.
      191         else do:
      192           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      193           if vRindex2 <= vRindex1
      194           then
      195              vRindex2 = vRindex1 + 70.
      196           assign
      197             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      200           .
      201         end.
      202       end.
      203       B-viewProcInfo:visible   in frame waitfram = no.
      204       B-viewProcInfo:sensitive in frame waitfram = no.
      205       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       if  (   mWaitFramView
      208          or  mWaitProcEvent)
      209          and not mBatchMode
      210       then
      211          display
      212             v-waitfram-action01 skip
      213             v-waitfram-action02 skip
      214             v-waitfram-action03 skip
      215          with frame waitfram .
      216       if     mWaitFramView
      217          then do:
      218             if     mWaitFramInterval ne ?
      219                and not mBatchMode
      220             then
      221                wait-for go of frame waitfram pause mWaitFramInterval.
      222          end.
      223          else
      224             if     mWaitProcEvent
      225                and not mBatchMode
      226             then
      227                process events .
      228     end.
      229   end procedure.
      230      procedure waitfram-show-this:
      231         define input  parameter iInterval as int64 no-undo.
      232         define variable vtime as int64 no-undo.
      233         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      234         mWaitFramInterval = iInterval.
      235         run waitfram-show (substitute("&1&2 &3&4" ,
      236                                       mWaitFramTextBeg ,
      237                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      238                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      239                                       mWaitFramTextEnd
      240                                      )
      241                           ).
      242      end.
      243      procedure WaitFramRunPause:
      244         define input  parameter iInterval as dec no-undo.
      245         define variable vStart  as datetime-tz no-undo.
      246         define variable vend    as datetime-tz no-undo.
      247         define variable vint as int64 no-undo.
      248         define variable vOk as logical no-undo.
      249         vStart = now.
      250         vend   = vStart.
      251         publish "WaitFramPause" (iInterval,output vOk).
      252         vend   =  now.
      253         vint = vend - vStart.
      254         vint = iInterval - vint / 1000.
      255         if     not mWaitFramStop
      256            and (   vint > 0
      257                 or (    not vOk
      258                     and iInterval eq ?
      259                     )
      260                 )
      261         then
      262            run waitfram-show-this (iInterval).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and vint > 0
      268         then do:
      269            run gbl/pause.p (vint * 1000).
      270         end.
      271         if iInterval ne ?
      272         then
      273            publish "WaitFramStop".
      274         waitfram-check-timeout().
      275      end.
      276      procedure WaitFramWaitFor:
      277         define input  parameter iInterval as dec no-undo.
      278         assign
      279            mWaitFramStartProc   = now
      280            mWaitFramStopUser    = no
      281            mWaitFramStopTimeOut = no
      282         .
      283         block-wait:
      284         do while not mWaitFramStop:
      285            run WaitFramRunPause (iInterval).
      286            if  waitfram-check-timeout()
      287            then do:
      288               leave block-wait.
      289            end.
      290         end.
      291         run waitfram-hide.
      292      end.
      293   procedure waitfram-join :
      294     define input  parameter p-line-1  as character no-undo .
      295     define input  parameter p-line-2  as character no-undo .
      296     define input  parameter p-line-3  as character no-undo .
      297     define output parameter p-message as character no-undo .
      298     do
      299     on error undo, return error return-value
      300     :
      301       assign
      302         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      305       .
      306     end.
      307   end procedure.
      308   function waitfram-join-function returns character
      309     (input p-line-1 as character
      310     ,input p-line-2 as character
      311     ,input p-line-3 as character
      312     ).
      313     define variable v-message as character no-undo .
      314     run waitfram-join in this-procedure
      315       (input  p-line-1
      316       ,input  p-line-2
      317       ,input  p-line-3
      318       ,output v-message
      319       ) .
      320     return v-message .
      321   end function .
      322   define variable v-accum as integer no-undo .
      323   define variable v-cli-type as character no-undo .
      324   define variable v-cli-code as integer no-undo .
      325   define variable v-curr-r-b as character no-undo .
      326   define variable v-base-code as integer no-undo .
      327   define variable v-pump-code as integer no-undo .
      328   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   define SHARED temp-table dcards  no-undo
      330   field d-card        like ub.dis-card.d-card
      331   field chk-date      as date
      332   field chk-time      as integer
      333   field obj-type      like ub.chk-doc.obj-type
      334   field obj-code      like ub.chk-doc.obj-code
      335   field pump          as integer
      336   field b-code        as integer
      337   field gds-code      as integer
      338   field cli-type      like ub.chk-doc.cli-type
      339   field cli-code      like ub.chk-doc.cli-code
      340   field cli-name      like ub.clients.obj-name
      341   field price-real    like ub.chk-gds.price-base
      342   field doc-qnty      like ub.chk-gds.doc-qnty
      343   field sum-netto     as decimal
      344   index pi
      345   IS unique PRIMARY
      346   d-card
      347   chk-date
      348   chk-time
      349   gds-code
      350   pump
      351   obj-type
      352   obj-code
      353   price-real
      354   index icli
      355   cli-type
      356   cli-code
      357   index ipet
      358   gds-code
      359   price-real
      360   .
      361   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      363     (output v-curr-r-b
      364     )  .
      365   define buffer buf_shop for ub.shop.
      366   define buffer buf_dis-card for ub.dis-card.
      367   define buffer buf_chk-doc for ub.chk-doc.
      368   define buffer buf_clients for ub.clients.
      369   define buffer buf_bar-code for ub.bar-code.
      370   define buffer card_dcards for dcards.
      371   define buffer pet_dcards for dcards.
      372   define buffer buf_chk-gds for ub.chk-gds.
      373   for each buf_shop no-lock:
      374     if v-curr-r-b = 'base':U then do:
      375   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      377     (input  buf_shop.host-code
      378     ,output v-base-code
      379     )  .
      380     end.
      381     _chk-doc:
      382     FOR EACH buf_chk-doc NO-LOCK WHERE
      383             buf_chk-doc.obj-type = 'маг':U
      384         AND buf_chk-doc.obj-code = buf_shop.obj-code
      385         AND buf_chk-doc.chk-date >= StartPoint
      386         AND buf_chk-doc.chk-date <= EndPoint
      387         AND buf_chk-doc.out-code > '':U
      388         and buf_chk-doc.d-card > '':U:
      389       if LOOKUP(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _CHk-doc.
      390       PROCESS EVENTS .
      391       assign
      392       v-accum = v-accum + 1.
      393       if ( v-accum modulo 10 ) = 0  then do:
      394         run waitfram-show in this-procedure  (
      395                                           substitute("&1&2 обработано &3"  , 'маг':U, buf_shop.obj-code, v-accum)
      396                                           ).
      397       end.
      398       if buf_chk-doc.cli-type = ?
      399       or buf_chk-doc.cli-code = ?
      400       or buf_chk-doc.cli-type = '':U
      401       or buf_chk-doc.cli-code = 0 then do:
      402         find first buf_dis-card no-lock where
      403                   buf_dis-card.d-card = buf_chk-doc.d-card no-error .
      404         if available buf_dis-card then do:
      405           assign
      406           v-cli-type = buf_dis-card.cli-type
      407           v-cli-code = buf_dis-card.cli-code
      408           .
      409         end.
      410       end.
      411       else do:
      412         assign
      413         v-cli-type = buf_chk-doc.cli-type
      414         v-cli-code = buf_chk-doc.cli-code
      415         .
      416       end.
      417       if not (v-cli-type = p-cli-type
      418               and
      419               v-cli-code = p-cli-code) then next _chk-doc.
      420       find first card_dcards no-lock where
      421                 card_dcards.d-card = buf_chk-doc.d-card
      422             and card_dcards.chk-date = 01/01/1990
      423             and card_dcards.chk-time = 0
      424             and card_dcards.obj-type = '':U
      425             and card_dcards.obj-code = 0
      426             and card_dcards.gds-code = 0
      427             and card_dcards.pump = 0
      428             no-error.
      429       if not available card_dcards then do:
      430         create card_dcards.
      431         assign
      432         card_dcards.d-card = buf_chk-doc.d-card
      433         card_dcards.chk-date = 01/01/1990
      434         card_dcards.chk-time = 0
      435         card_dcards.obj-type = '':U
      436         card_dcards.obj-code = 0
      437         card_dcards.gds-code = 0
      438         card_dcards.pump = 0
      439         card_dcards.cli-type = v-cli-type
      440         card_dcards.cli-code = v-cli-code
      441         card_dcards.doc-qnty = 0
      442         .
      443       end.
      444       assign
      445       card_dcards.doc-qnty = card_dcards.doc-qnty +  buf_chk-doc.doc-qnty
      446       card_dcards.sum-netto = card_dcards.sum-netto +
      447                               (if v-curr-r-b = 'rubl':U
      448                                  then buf_chk-doc.netto
      449                                  else (if v-base-code = 0
      450                                        then buf_chk-doc.netto
      451                                        else (buf_chk-doc.netto * buf_chk-doc.cash-rate))
      452                                  )
      453       .
      454       for each buf_chk-gds no-lock where
      455               buf_chk-gds.doc-code = buf_chk-doc.doc-code,
      456              first buf_bar-code no-lock where
      457               buf_bar-code.b-code = buf_chk-gds.b-code:
      458         v-pump-code = buf_chk-gds.pump.
      459         find first dcards no-lock where
      460                   dcards.d-card = buf_chk-doc.d-card
      461               and dcards.chk-date = buf_chk-doc.chk-date
      462               and dcards.chk-time = buf_chk-doc.chk-time
      463               and dcards.obj-type = buf_chk-doc.obj-type
      464               and dcards.obj-code = buf_chk-doc.obj-code
      465               and dcards.gds-code = buf_bar-code.b-code
      466               and dcards.pump     = v-pump-code
      467               no-error.
      468         if not available dcards then do:
      469           create dcards.
      470           assign
      471           dcards.d-card = buf_chk-doc.d-card
      472           dcards.chk-date = buf_chk-doc.chk-date
      473           dcards.chk-time = buf_chk-doc.chk-time
      474           dcards.obj-type = buf_chk-doc.obj-type
      475           dcards.obj-code = buf_chk-doc.obj-code
      476           dcards.gds-code = buf_bar-code.gds-code
      477           dcards.pump     = v-pump-code
      478           dcards.cli-type = v-cli-type
      479           dcards.cli-code = v-cli-code
      480           dcards.doc-qnty = 0
      481           .
      482         end.
      483         find first pet_dcards no-lock where
      484                   pet_dcards.d-card = '':U
      485               and pet_dcards.cli-type = p-cli-type
      486               and pet_dcards.cli-code = p-cli-code
      487               and pet_dcards.gds-code = buf_bar-code.gds-code
      488               and pet_dcards.price-real = round(buf_chk-gds.price-base - buf_chk-gds.discnt, 2) no-error.
      489         if not available pet_dcards then do:
      490           create pet_dcards.
      491           assign
      492           pet_dcards.d-card = '':U
      493           pet_dcards.chk-date = 01/01/1990
      494           pet_dcards.chk-time = 0
      495           pet_Dcards.pump     = 0
      496           pet_dcards.cli-type = p-cli-type
      497           pet_dcards.cli-code = p-cli-code
      498           pet_dcards.gds-code = buf_bar-code.gds-code
      499           pet_dcards.price-real = round(buf_chk-gds.price-base - buf_chk-gds.discnt, 2)
      500           pet_dcards.doc-qnty = 0
      501           .
      502         end.
      503         assign
      504         dcards.price-real = round(buf_chk-gds.price-base - buf_chk-gds.discnt, 2)
      505         dcards.doc-qnty = dcards.doc-qnty + buf_chk-gds.doc-qnty
      506         dcards.sum-netto = dcards.sum-netto + buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt) *
      507                                               (if v-curr-r-b = 'rubl':U
      508                                                 then  1
      509                                                 else (if v-base-code = 0
      510                                                       then 1
      511                                                       else buf_chk-doc.cash-rate)
      512                                                 )
      513         pet_dcards.doc-qnty = pet_dcards.doc-qnty + buf_chk-gds.doc-qnty
      514         pet_dcards.sum-netto = pet_dcards.sum-netto + buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt) *
      515                                               (if v-curr-r-b = 'rubl':U
      516                                                 then  1
      517                                                 else (if v-base-code = 0
      518                                                       then 1
      519                                                       else buf_chk-doc.cash-rate)
      520                                                 )
      521        .
      522       end.
      523     END.
      524   END.
      525   run waitfram-hide in this-procedure .
