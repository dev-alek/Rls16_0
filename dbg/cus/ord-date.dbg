      154   DEFINE BUTTON b-help
      155        LABEL "&Помощь":L
      156        SIZE 12 BY 1.
      157   DEFINE BUTTON b-quit AUTO-GO
      158        LABEL "_ В&ыполнить":L
      159        SIZE 12 BY 1 TOOLTIP "Выполнить".
      160   DEFINE BUTTON i-exit
      161        IMAGE-UP FILE "cmp/i-run.bmp":U
      162        IMAGE-DOWN FILE "cmp/i-run.bmp":U
      163        IMAGE-INSENSITIVE FILE "cmp/i-rund.bmp":U
      164        LABEL ""
      165        SIZE 2.5 BY .75.
      166   DEFINE VARIABLE dateEnd AS DATE FORMAT "99/99/9999":U
      167        LABEL "по"
      168        VIEW-AS FILL-IN
      169        SIZE 11 BY 1 NO-UNDO.
      170   DEFINE VARIABLE dateFirst AS DATE FORMAT "99/99/9999":U
      171        LABEL "с"
      172        VIEW-AS FILL-IN
      173        SIZE 11 BY 1 NO-UNDO.
      174   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Задайте интервал времени для отбора заказов"
      175         VIEW-AS TEXT
      176        SIZE 44.13 BY .67
      177        FGCOLOR 1  NO-UNDO.
      178   DEFINE FRAME Dialog-Frame
      179        b-help AT ROW 1.08 COL 38.38
      180        b-quit AT ROW 1.13 COL 1.38
      181        i-exit AT ROW 1.21 COL 1.5 WIDGET-ID 4
      182        dateFirst AT ROW 4.25 COL 8.63 COLON-ALIGNED
      183        dateEnd AT ROW 4.25 COL 29.75 COLON-ALIGNED
      184        FILL-IN-2 AT ROW 2.88 COL 3.25 NO-LABEL
      185        SPACE(4.36) SKIP(3.98)
      186       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      187            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      188            TITLE "Введите дату".
      189   ASSIGN
      190          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      191          FRAME Dialog-Frame:HIDDEN           = TRUE.
      192   ASSIGN
      193          dateEnd:AUTO-RESIZE IN FRAME Dialog-Frame      = TRUE.
      194   ASSIGN
      195          dateFirst:AUTO-RESIZE IN FRAME Dialog-Frame      = TRUE
      196          dateFirst:PRIVATE-DATA IN FRAME Dialog-Frame     =
      197                   "to-day".
      198   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      199   DO:
      200     APPLY "END-ERROR":U TO SELF.
      201   END.
      202   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      203   DO:
      204   Assign
      205       datefirst
      206       dateEnd .
      207     run cus/ord-del.w
      208        ( parParentProc,
      209         datefirst ,
      210         dateend,
      211         p-type ).
      212   END.
      213   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      214   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      215   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      216   on help of frame Dialog-Frame
      217   do:
      218     run gbl/app_help.p
      219       (input this-procedure :file-name
      220       ,input ''
      221       ,input ?
      222       ) no-error.
      223     if error-status :error then do:
      224       message
      225         "Ошибка при вызове помощи"
      226         error-status :get-message(1)
      227         view-as alert-box .
      228     end.
      229   end.
      230   run minbtn-set in this-procedure .
      231   on choose of b-help in frame Dialog-Frame
      232   do:
      233     apply "help":u to frame Dialog-Frame .
      234   end.
      235   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      236   procedure minbtn-set :
      237       do
      238           on error undo, return error return-value
      239           :
      240           define variable ii              as integer       no-undo .
      241           define variable fh              as widget-handle no-undo .
      242           define variable hh              as widget-handle no-undo .
      243           define variable v-h             as handle        extent 4 no-undo .
      244           define variable v-name-button   as character     no-undo .
      245           define variable v-help-old-x    as decimal       no-undo .
      246           define variable v-help-old-y    as decimal       no-undo .
      247           define variable v-help-old-size as decimal       no-undo .
      248           define variable v-frame-width   as decimal       no-undo .
      249           define variable jj              as integer       no-undo .
      250           do
      251               on error undo, return error
      252               :
      253               assign
      254                   v-frame-width = frame Dialog-Frame:width - 0.3
      255                   fh            = frame Dialog-Frame:first-child
      256                   hh            = fh:first-child
      257                   ii            = 1
      258                   .
      259               do while valid-handle(hh):
      260                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      261                   do:
      262                       case lc(hh:name) :
      263                           when "b-help" then
      264                               do:
      265                                   hh:load-image-up("cmp/b-help.bmp":u) .
      266                                   hh:load-image-down("cmp/b-help.bmp":u) .
      267                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      268                                   hh:TOOLTIP = "Помощь" .
      269                                   v-help-old-x = hh:column .
      270                                   v-help-old-y = hh:row    .
      271                                   v-help-old-size = hh:width .
      272                                   hh:width-chars = 2.5 .
      273                               end.
      274                           when "b-print" then
      275                               do:
      276                                   hh:load-image("cmp/b-print.bmp":u) .
      277                                   hh:TOOLTIP = "Печать" .
      278                                   v-h[ii] = hh:handle .
      279                                   ii = ii + 1 .
      280                                   hh:width-chars = 3 .
      281                               end.
      282                           when "b-history" or
      283                           when "b-hist" then
      284                               do:
      285                                   hh:load-image("cmp/b-hist.bmp":u) .
      286                                   hh:TOOLTIP = "История" .
      287                                   v-h[ii] = hh:handle .
      288                                   ii = ii + 1 .
      289                                   hh:width-chars = 3 .
      290                               end.
      291                           when "b-sch" then
      292                               do:
      293                                   hh:load-image("cmp/b-sch.bmp":u) .
      294                                   hh:TOOLTIP = "Установка Фильтра" .
      295                                   v-h[ii] = hh:handle .
      296                                   ii = ii + 1 .
      297                                   hh:width-chars = 3 .
      298                               end.
      299                           when "b-hist-user" then
      300                               do:
      301                                   hh:load-image("cmp/b-hist.bmp":u) .
      302                                   hh:TOOLTIP = "История пользователя" .
      303                                   ii = ii + 1 .
      304                               end.
      305                       end case.
      306                   end.
      307                   hh = hh:next-sibling.
      308               end.
      309               b-help:column = v-frame-width - b-help:width-chars.
      310               jj = 0.
      311               repeat ii = 4 to 1 by -1 :
      312                   if valid-handle (v-h[ii] ) then
      313                   do:
      314                       jj  = jj + 1 .
      315                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      316                       v-h[ii]:row    = v-help-old-y .
      317                   end.
      318               end.
      319           end.
      320       end.
      321   end procedure.
      322   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   on ' ' of datefirst in frame Dialog-Frame
      324   do:
      325     if (can-query (self, "sensitive")
      326        and
      327        self :sensitive = true
      328        )
      329     or (can-query (self, "read-only")
      330        and
      331        self :read-only = false
      332        )
      333     then do:
      334       assign
      335         self :screen-value = ?
      336       .
      337     end.
      338     return no-apply.
      339   end.
      340   on delete-character of datefirst in frame Dialog-Frame
      341   do:
      342     if (can-query (self, "sensitive")
      343        and
      344        self :sensitive = true
      345        )
      346     or (can-query (self, "read-only")
      347        and
      348        self :read-only = false
      349        )
      350     then do:
      351       assign
      352         self :screen-value = ?
      353       .
      354     end.
      355     return no-apply.
      356   end.
      357   on ctrl-d of datefirst in frame Dialog-Frame
      358   do:
      359     define variable v-curr-sv-date as date no-undo .
      360     if (can-query (self, "sensitive")
      361        and
      362        self :sensitive = true
      363        )
      364     or (can-query (self, "read-only")
      365        and
      366        self :read-only = false
      367        )
      368     then do:
      369       if self :handle <> focus :handle
      370       then do:
      371         apply "entry":u to self .
      372       end.
      373       run gbl/getcurdt.p
      374         (output v-curr-sv-date
      375         ) .
      376       assign
      377         self :screen-value = string(v-curr-sv-date) .
      378       .
      379     end.
      380     return no-apply.
      381   end.
      382   on ctrl-b of datefirst in frame Dialog-Frame
      383   do:
      384     if (can-query (self, "sensitive")
      385        and
      386        self :sensitive = true
      387        )
      388     or (can-query (self, "read-only")
      389        and
      390        self :read-only = false
      391        )
      392     then do:
      393       if self :handle <> focus :handle
      394       then do:
      395         apply "entry":u to self .
      396       end.
      397       define variable v-curr-sv-date as date no-undo .
      398       define variable v-new-sv-date  as date no-undo .
      399       assign
      400         v-curr-sv-date = date(self :screen-value) no-error
      401       .
      402       if v-curr-sv-date = ?
      403       then do:
      404         run gbl/getcurdt.p
      405           (output v-curr-sv-date
      406           ) .
      407       end.
      408       if v-curr-sv-date <> ?
      409       then do:
      410         assign
      411           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      412         .
      413         assign
      414           self :screen-value = string(v-new-sv-date) .
      415         .
      416       end.
      417     end.
      418     return no-apply .
      419   end.
      420   on ctrl-e of datefirst in frame Dialog-Frame
      421   do:
      422     if (can-query (self, "sensitive")
      423        and
      424        self :sensitive = true
      425        )
      426     or (can-query (self, "read-only")
      427        and
      428        self :read-only = false
      429        )
      430     then do:
      431       if self :handle <> focus :handle
      432       then do:
      433         apply "entry":u to self .
      434       end.
      435       define variable v-curr-sv-date as date no-undo .
      436       define variable v-new-sv-date  as date no-undo .
      437       assign
      438         v-curr-sv-date = date(self :screen-value) no-error
      439       .
      440       if v-curr-sv-date = ?
      441       then do:
      442         run gbl/getcurdt.p
      443           (output v-curr-sv-date
      444           ) .
      445       end.
      446       if v-curr-sv-date <> ?
      447       then do:
      448         run gbl/lastdate.p
      449           (input  v-curr-sv-date
      450           ,output v-new-sv-date
      451           ).
      452         assign
      453           self :screen-value = string(v-new-sv-date) .
      454         .
      455       end.
      456     end.
      457     return no-apply .
      458   end.
      459   on ctrl-f of datefirst in frame Dialog-Frame
      460   do:
      461     if (can-query (self, "sensitive")
      462        and
      463        self :sensitive = true
      464        )
      465     or (can-query (self, "read-only")
      466        and
      467        self :read-only = false
      468        )
      469     then do:
      470       if self :handle <> focus :handle
      471       then do:
      472         apply "entry":u to self .
      473       end.
      474       define variable v-ok            as logical   no-undo .
      475       define variable v-curr-sv-date  as date      no-undo .
      476       define variable v-description   as character no-undo .
      477       assign
      478         v-curr-sv-date = date(self :screen-value) no-error
      479       .
      480       if v-curr-sv-date = ?
      481       then do:
      482         run gbl/getcurdt.p
      483           (output v-curr-sv-date
      484           ) .
      485       end.
      486       if v-curr-sv-date <> ?
      487       then do:
      488         run gbl/d-inpday.w
      489           (input ?
      490           ,input "Выбор даты"
      491           ,input v-description
      492           ,input ""
      493           ,input-output v-curr-sv-date
      494           ,output v-ok
      495           ).
      496         if v-ok = true
      497         then do:
      498           assign
      499             self :screen-value = string(v-curr-sv-date) .
      500           .
      501         end.
      502       end.
      503     end.
      504     return no-apply .
      505   end.
