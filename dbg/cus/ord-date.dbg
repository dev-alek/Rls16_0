      580   on ctrl-d of dateEnd in frame Dialog-Frame
      581   do:
      582     define variable v-curr-sv-date as date no-undo .
      583     if (can-query (self, "sensitive")
      584        and
      585        self :sensitive = true
      586        )
      587     or (can-query (self, "read-only")
      588        and
      589        self :read-only = false
      590        )
      591     then do:
      592       if self :handle <> focus :handle
      593       then do:
      594         apply "entry":u to self .
      595       end.
      596       run gbl/getcurdt.p
      597         (output v-curr-sv-date
      598         ) .
      599       assign
      600         self :screen-value = string(v-curr-sv-date) .
      601       .
      602     end.
      603     return no-apply.
      604   end.
      605   on ctrl-b of dateEnd in frame Dialog-Frame
      606   do:
      607     if (can-query (self, "sensitive")
      608        and
      609        self :sensitive = true
      610        )
      611     or (can-query (self, "read-only")
      612        and
      613        self :read-only = false
      614        )
      615     then do:
      616       if self :handle <> focus :handle
      617       then do:
      618         apply "entry":u to self .
      619       end.
      620       define variable v-curr-sv-date as date no-undo .
      621       define variable v-new-sv-date  as date no-undo .
      622       assign
      623         v-curr-sv-date = date(self :screen-value) no-error
      624       .
      625       if v-curr-sv-date = ?
      626       then do:
      627         run gbl/getcurdt.p
      628           (output v-curr-sv-date
      629           ) .
      630       end.
      631       if v-curr-sv-date <> ?
      632       then do:
      633         assign
      634           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      635         .
      636         assign
      637           self :screen-value = string(v-new-sv-date) .
      638         .
      639       end.
      640     end.
      641     return no-apply .
      642   end.
      643   on ctrl-e of dateEnd in frame Dialog-Frame
      644   do:
      645     if (can-query (self, "sensitive")
      646        and
      647        self :sensitive = true
      648        )
      649     or (can-query (self, "read-only")
      650        and
      651        self :read-only = false
      652        )
      653     then do:
      654       if self :handle <> focus :handle
      655       then do:
      656         apply "entry":u to self .
      657       end.
      658       define variable v-curr-sv-date as date no-undo .
      659       define variable v-new-sv-date  as date no-undo .
      660       assign
      661         v-curr-sv-date = date(self :screen-value) no-error
      662       .
      663       if v-curr-sv-date = ?
      664       then do:
      665         run gbl/getcurdt.p
      666           (output v-curr-sv-date
      667           ) .
      668       end.
      669       if v-curr-sv-date <> ?
      670       then do:
      671         run gbl/lastdate.p
      672           (input  v-curr-sv-date
      673           ,output v-new-sv-date
      674           ).
      675         assign
      676           self :screen-value = string(v-new-sv-date) .
      677         .
      678       end.
      679     end.
      680     return no-apply .
      681   end.
      682   on ctrl-f of dateEnd in frame Dialog-Frame
      683   do:
      684     if (can-query (self, "sensitive")
      685        and
      686        self :sensitive = true
      687        )
      688     or (can-query (self, "read-only")
      689        and
      690        self :read-only = false
      691        )
      692     then do:
      693       if self :handle <> focus :handle
      694       then do:
      695         apply "entry":u to self .
      696       end.
      697       define variable v-ok            as logical   no-undo .
      698       define variable v-curr-sv-date  as date      no-undo .
      699       define variable v-description   as character no-undo .
      700       assign
      701         v-curr-sv-date = date(self :screen-value) no-error
      702       .
      703       if v-curr-sv-date = ?
      704       then do:
      705         run gbl/getcurdt.p
      706           (output v-curr-sv-date
      707           ) .
      708       end.
      709       if v-curr-sv-date <> ?
      710       then do:
      711         run gbl/d-inpday.w
      712           (input ?
      713           ,input "Выбор даты"
      714           ,input v-description
      715           ,input ""
      716           ,input-output v-curr-sv-date
      717           ,output v-ok
      718           ).
      719         if v-ok = true
      720         then do:
      721           assign
      722             self :screen-value = string(v-curr-sv-date) .
      723           .
      724         end.
      725       end.
      726     end.
      727     return no-apply .
      728   end.
      729     define MENU m-ed-date9
      730       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      731       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      732       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      733       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      734       .
      735     if dateEnd :POPUP-MENU in frame Dialog-Frame = ?
      736     then do:
      737       ASSIGN
      738         dateEnd :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date9 :HANDLE
      739         dateEnd :MENU-MOUSE in frame Dialog-Frame = 3
      740       .
      741     end.
      742     define variable v-label-handle9 as handle no-undo .
      743     assign
      744       v-label-handle9 = dateEnd :side-label-handle in frame Dialog-Frame
      745     .
      746     if valid-handle (v-label-handle9)
      747     then do:
      748       if v-label-handle9 :tooltip = ""
      749       or v-label-handle9 :tooltip = ?
      750       then do:
      751         assign
      752           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      753         .
      754       end.
      755     end.
      756     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
      757       apply "ctrl-b":U to dateEnd in frame Dialog-Frame .
      758     END.
      759     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
      760       apply "ctrl-d":U to dateEnd in frame Dialog-Frame .
      761     END.
      762     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
      763       apply "ctrl-e":U to dateEnd in frame Dialog-Frame .
      764     END.
      765     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
      766       apply "ctrl-f":U to dateEnd in frame Dialog-Frame .
      767     END.
      768   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      770   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      771     (input  store-type
      772     ,input  store-code
      773     ,output to-day
      774     )  .
      775   Assign
      776   datefirst = date(month(to-day) - 2,day(to-day),year(to-day))
      777   dateEnd = date(month(to-day) - 1,day(to-day),year(to-day)) no-error .
      778   MAIN-BLOCK:
      779   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      780      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      781     run enable_ui.
      782     WAIT-FOR GO OF FRAME Dialog-Frame.
      783   END.
      784   run disable_ui.
      785   PROCEDURE disable_UI :
      786     HIDE FRAME Dialog-Frame.
      787   END PROCEDURE.
      788   PROCEDURE enable_UI :
      789     DISPLAY dateFirst dateEnd FILL-IN-2
      790         WITH FRAME Dialog-Frame.
      791     ENABLE b-help b-quit i-exit dateFirst dateEnd FILL-IN-2
      792         WITH FRAME Dialog-Frame.
      793     VIEW FRAME Dialog-Frame.
      794   END PROCEDURE.
