      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable g#host-name  as character no-undo .
      126   define variable g#host-code    as integer   no-undo .
      127   define variable store-type   as character no-undo .
      128   define variable store-code   as integer   no-undo .
      129   define variable g#log      as logical   no-undo .
