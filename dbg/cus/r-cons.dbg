     1017   define variable l-time-rcv  as integer no-undo .
     1018   define variable l-cli-code  as character no-undo .
     1019   define variable l-cli-name  as character no-undo .
     1020   define variable ii      as integer no-undo .
     1021   define variable l-nn    as integer no-undo .
     1022   define variable kk      as integer no-undo .
     1023   define variable max-str as integer no-undo .
     1024   define variable old-l-ord-code as character no-undo .
     1025   define variable  s-max-qnty   as decimal no-undo .
     1026   define variable  s-measure-qnty  as decimal no-undo .
     1027   define variable  s-free-qnty    as decimal no-undo .
     1028   define variable  s-qnty-of      as decimal no-undo .
     1029   define variable  s-qnty-fp      as decimal no-undo .
     1030   define variable  s-qnty-rcv     as decimal no-undo .
     1031   define temp-table temp-tt no-undo
     1032   field obj-type    like ub.clients.obj-type
     1033   field obj-name    like ub.clients.obj-name
     1034   field gds-code    like ub.goods.gds-code
     1035   field max-qnty    like ub.place.max-qnty
     1036   field measure-qnty like ub.rvs-line.state-measure-qnty
     1037   field free-qnty   like ub.rvs-line.state-measure-qnty
     1038   field temp-sale   as decimal
     1039   field qnty-of     like ub.ord-line.qnty
     1040   field time-of     as char
     1041   field ord-code    as character
     1042   field qnty-fp     like ub.ord-line.qnty
     1043   field cli-cod     as character
     1044   field cli-name    as character
     1045   field rcv-code    as character
     1046   field time-rcv    as char
     1047   field qnty-rcv    like ub.ord-line.qnty
     1048   field nnn as integer
     1049   INDEX pi IS UNIQUE PRIMARY
     1050     obj-type
     1051     nnn
     1052     gds-code
     1053     ord-code
     1054     rcv-code
     1055         .
     1056   FUNCTION excel-qnty-null RETURNS char (INPUT p-dec as decimal ).
     1057   if p-dec = 0 then Return ("").
     1058      else RETURN(format-excel-text(excel-format-dec-to-char(Round(p-dec,3)))) .
     1059   END FUNCTION.
     1060   main-block :
     1061   do on error undo main-block, return error
     1062   :
     1063   find first  bf_ord-cons where recid(bf_ord-cons) = c-rc no-lock no-error .
     1064   for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code :
     1065    ii = ii + 1.
     1066    if ii > 23 then leave.
     1067   end.
     1068   if ii > 23 then do:
     1069       message "Отчет не может быть выполнен на такое количество товаров !  "
     1070       skip
     1071       "Воспользуйтесь отчетом 'Совокупная заявка по товарам ' "
     1072       view-as alert-box error.
     1073       return error.
     1074   end.
     1075   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1076     if  log-manager:logfile-name ne ?
     1077     then DO:
     1078         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1079     end.
     1080     if not session:batch-mode then
     1081     do:
     1082       VIEW FRAME InfoFrame.
     1083       mFrameView = true.
     1084     end.
     1085      v-button-stop = false .
     1086         if mFrameView
     1087         then do:
     1088         if v-button-stop then view STOPBTN in frame InfoFrame.
     1089                          else Hide STOPBTN in frame InfoFrame.
     1090         end.
     1091   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1092   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1093     (input  v-cntxt-obj-type
     1094     ,input  v-cntxt-obj-code
     1095     ,output to-day
     1096     )  .
     1097     os-delete value( string( session:temp-directory ) +
     1098                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1099     os-delete value( string( session:temp-directory ) +
     1100                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1101     output stream forexcel to value( string( session:temp-directory ) +
     1102                                 "rpt" + string( g#report-num ) + ".txt":u ) .
     1103   Make-Excel = true .
     1104   reportname =  "Совокупная заявка по нефтепродуктам по фирме № " + bf_ord-cons.cons-code + " от " + string(bf_ord-cons.doc-date,"99/99/9999").
     1105   reportheader =   cur-time-print() .
     1106   Sheetf.Excel-Column-Lable = "Код объекта ,Наименование объекта  ,".
     1107   Sheetf.Sizes = "8,20,".
     1108   for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,    first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic                                               and bf_ord-cons-gds.prod-type = ub.goods.prod-type                                   and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1109        Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable + " Арт " + ub.goods.artic + "," + string(ub.goods.gds-name) + ",,,,,,,,,," .
     1110        Sheetf.Sizes = Sheetf.Sizes + Fill("12,", 5) .
     1111        Sheetf.Sizes = Sheetf.Sizes + ("12,") .
     1112        Sheetf.Sizes = Sheetf.Sizes + ("8,") .
     1113        Sheetf.Sizes = Sheetf.Sizes + ("20,") .
     1114        Sheetf.Sizes = Sheetf.Sizes + ("8,") .
     1115        Sheetf.Sizes = Sheetf.Sizes + ("12,") .
     1116        Sheetf.Sizes = Sheetf.Sizes + ("12,") .
     1117   End.
     1118        Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable  + chr(10) +  ",".
     1119   for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,    first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic                                               and bf_ord-cons-gds.prod-type = ub.goods.prod-type                                   and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1120        Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable +
     1121         ",Общий объем складских мест"
     1122       + ",Фактический остаток по складским местам"
     1123       + ",Свободный объем складских мест"
     1124       + ",Заявленное количество"
     1125       + ",Предполагаемое время завоза"
     1126       + ",Заказанное у поставщика кол-во от фирмы в целом"
     1127       + ",Код поставщика"
     1128       + ",Наименование поставщика "
     1129       + ",Согласованное время завоза (поставок)"
     1130       + ",Количество в поставке"
     1131       + ",№ поставки"
     1132         .
     1133   End.
     1134   sheetf.make-correct =  "".
     1135   run rep/extitle.p (1) .
     1136   run make-tt .
     1137   for each  bf_ord-doc no-lock  where bf_ord-doc.cons-code = bf_ord-cons.cons-code,
     1138        first ub.clients  where ub.clients.obj-code =  bf_ord-doc.obj-code
     1139                        and  ub.clients.obj-type =  bf_ord-doc.obj-type no-lock
     1140                        break by ub.clients.obj-type by ub.clients.obj-code:
     1141        if last-of(ub.clients.obj-code) then do:
     1142          old-l-ord-code = "".
     1143          run max-col (input ub.clients.obj-code, input  ub.clients.obj-type ,output  max-str) .
     1144          do kk = 1 to max-str :
     1145               if kk = 1 then do:
     1146               if Make-Excel then  put   stream ForExcel unformatted
     1147                 format-excel-text(ub.clients.obj-type + " " + string(ub.clients.obj-code))  CHR(9)
     1148                 format-excel-text(ub.clients.obj-name) CHR(9)
     1149               .
     1150               end.
     1151               else do:
     1152               if Make-Excel then  put   stream ForExcel unformatted
     1153                  CHR(9)
     1154                  CHR(9)
     1155               .
     1156               end.
     1157            for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,    first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic                                               and bf_ord-cons-gds.prod-type = ub.goods.prod-type                                   and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1158               find first   temp-tt where temp-tt.obj-type = ub.clients.obj-type + " " + string(ub.clients.obj-code) and
     1159                                       temp-tt.gds-code = ub.goods.gds-code and
     1160                                       temp-tt.nnn = kk no-error .
     1161                       if avail temp-tt then do:
     1162                       if Make-Excel then  put   stream ForExcel unformatted
     1163                         excel-qnty-null(temp-tt.max-qnty)    CHR(9)
     1164                         excel-qnty-null(temp-tt.measure-qnty) CHR(9)
     1165                         excel-qnty-null(temp-tt.free-qnty)   CHR(9)
     1166                         excel-qnty-null(temp-tt.qnty-of  )   CHR(9)
     1167                         format-excel-text(temp-tt.time-of)   CHR(9)
     1168                         excel-qnty-null (temp-tt.qnty-fp  )  CHR(9)
     1169                         format-excel-text(temp-tt.cli-cod)   CHR(9)
     1170                         format-excel-text(temp-tt.cli-name)  CHR(9)
     1171                         format-excel-text(temp-tt.time-rcv)  CHR(9)
     1172                         excel-qnty-null(temp-tt.qnty-rcv)    CHR(9)
     1173                         format-excel-text(temp-tt.rcv-code)    CHR(9)
     1174                       .
     1175                       end.
     1176                       else do:
     1177                         if Make-Excel then  put   stream ForExcel unformatted
     1178                           CHR(9)
     1179                           CHR(9)
     1180                           CHR(9)
     1181                           CHR(9)
     1182                           CHR(9)
     1183                           CHR(9)
     1184                           CHR(9)
     1185                           CHR(9)
     1186                           CHR(9)
     1187                           CHR(9)
     1188                           CHR(9)
     1189                         .
     1190                       end.
     1191            end.
     1192            if Make-Excel then  put   stream ForExcel unformatted chr(10) .
     1193          end.
     1194        end.
     1195   end.
     1196   if Make-Excel then  put   stream ForExcel unformatted  "Итого"    CHR(9)
     1197                           CHR(9)
     1198                           .
     1199            for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,    first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic                                               and bf_ord-cons-gds.prod-type = ub.goods.prod-type                                   and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1200             assign
     1201                 s-max-qnty    = 0
     1202                 s-measure-qnty = 0
     1203                 s-free-qnty   = 0
     1204                 s-qnty-of     = 0
     1205                 s-qnty-fp     = 0
     1206                 s-qnty-rcv    = 0
     1207                 .
     1208               for each   temp-tt where temp-tt.gds-code = ub.goods.gds-code :
     1209               assign
     1210                 s-max-qnty    = s-max-qnty    + temp-tt.max-qnty
     1211                 s-measure-qnty = s-measure-qnty + temp-tt.measure-qnty
     1212                 s-free-qnty   = s-free-qnty   + temp-tt.free-qnty
     1213                 s-qnty-of     = s-qnty-of     + temp-tt.qnty-of
     1214                 s-qnty-fp     = g-qnty-fp
     1215                 s-qnty-rcv    = s-qnty-rcv    + temp-tt.qnty-rcv
     1216                 .
     1217               end.
     1218               if Make-Excel then  put   stream ForExcel unformatted
     1219                   s-max-qnty    CHR(9)
     1220                   s-measure-qnty CHR(9)
     1221                   s-free-qnty   CHR(9)
     1222                   s-qnty-of     CHR(9)
     1223                                 CHR(9)
     1224                   s-qnty-fp     CHR(9)
     1225                                 CHR(9)
     1226                                 CHR(9)
     1227                                 CHR(9)
     1228                   s-qnty-rcv    CHR(9)
     1229                                 CHR(9)
     1230                 .
     1231            end.
     1232    if Make-Excel then  put   stream ForExcel unformatted chr(10) chr(10).
     1233   run cur-time in this-procedure ( output v-today, output v-time ).
     1234     if Make-Excel then  put   stream ForExcel unformatted " Печать закончена : " + string(v-time,"HH:MM:SS") SKIP.
     1235     if Make-Excel then output stream ForExcel close.
     1236   if mFrameView
     1237   then do:
     1238      HIDE FRAME InfoFrame.
     1239   end.
     1240     run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1241    end.
     1242   procedure make-tt :
     1243   define variable tt-line  as logical no-undo .
     1244   define variable ttt-line as logical no-undo .
     1245   for each  bf_ord-doc no-lock  where bf_ord-doc.cons-code = bf_ord-cons.cons-code
     1246                                   and bf_ord-doc.doc-type = 'ОФ':U  ,
     1247     first ub.clients  where ub.clients.obj-code =  bf_ord-doc.obj-code
     1248                     and  ub.clients.obj-type =  bf_ord-doc.obj-type no-lock
     1249                     break by ub.clients.obj-type by ub.clients.obj-code:
     1250     if first-of(ub.clients.obj-code) then do:
     1251        ii = 0 .
     1252       for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,
     1253         first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic
     1254               and bf_ord-cons-gds.prod-type = ub.goods.prod-type
     1255               and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1256               assign
     1257                 l-nn = 0
     1258                 l-qnty-of = 0
     1259                 l-time-of = 0
     1260               .
     1261           for each  z_ord-doc no-lock  where z_ord-doc.cons-code = bf_ord-cons.cons-code
     1262                                               and z_ord-doc.doc-type = 'ОФ':U
     1263                                               and ub.clients.obj-code =  z_ord-doc.obj-code
     1264                                               and ub.clients.obj-type =  z_ord-doc.obj-type
     1265                                              ,
     1266                   each z_ord-line no-lock where z_ord-doc.doc-code   = z_ord-line.doc-code and
     1267                                                   z_ord-line.artic     = bf_ord-cons-gds.artic      and
     1268                                                   z_ord-line.prod-type = bf_ord-cons-gds.prod-type  and
     1269                                                   z_ord-line.prod-code = bf_ord-cons-gds.prod-code :
     1270                     l-qnty-of = l-qnty-of + z_ord-line.qnty.
     1271                     l-time-of =  z_ord-doc.ship-time.
     1272           end.
     1273           assign
     1274           l-cli-code  = ""
     1275           l-cli-name  = ""
     1276           l-ord-code  = ""
     1277           ttt-line = false
     1278           l-qnty-fp = 0
     1279           g-qnty-fp = 0
     1280           .
     1281           for each loc_ord-doc no-lock  where loc_ord-doc.cons-code =  bf_ord-cons.cons-code
     1282                                           and loc_ord-doc.doc-type = 'ФП':U
     1283                                     ,
     1284           first b_clients  where b_clients.obj-code =  loc_ord-doc.cli-code
     1285                             and  b_clients.obj-type =  loc_ord-doc.cli-type no-lock ,
     1286           each loc_ord-line no-lock where loc_ord-doc.doc-code   = loc_ord-line.doc-code and
     1287                                           loc_ord-line.artic     = bf_ord-cons-gds.artic      and
     1288                                           loc_ord-line.prod-type = bf_ord-cons-gds.prod-type  and
     1289                                           loc_ord-line.prod-code = bf_ord-cons-gds.prod-code
     1290                         break by  loc_ord-doc.doc-code   :
     1291               l-qnty-fp = l-qnty-fp + loc_ord-line.qnty.
     1292               g-qnty-fp = g-qnty-fp + loc_ord-line.qnty.
     1293               if first-of ( loc_ord-doc.doc-code ) then do:
     1294               l-cli-code  =  b_clients.obj-type + " "  + string( b_clients.obj-code).
     1295               l-cli-name  =  b_clients.obj-name.
     1296               l-ord-code  = loc_ord-line.doc-code.
     1297                   tt-line = false  .
     1298                   for each loc_ord-doc-rcv no-lock  where loc_ord-doc-rcv.cons-code =  bf_ord-cons.cons-code
     1299                                                       and loc_ord-doc-rcv.doc-code   = loc_ord-line.doc-code
     1300                                                       and loc_ord-doc-rcv.obj-code   = ub.clients.obj-code
     1301                                                       and loc_ord-doc-rcv.obj-type   = ub.clients.obj-type   ,
     1302                         each loc_ord-line-rcv no-lock where loc_ord-doc-rcv.doc-code   = loc_ord-line.doc-code and
     1303                               loc_ord-doc-rcv.rcv-code   = loc_ord-line-rcv.rcv-code and
     1304                               loc_ord-line-rcv.artic     = bf_ord-cons-gds.artic      and
     1305                               loc_ord-line-rcv.prod-type = bf_ord-cons-gds.prod-type  and
     1306                               loc_ord-line-rcv.prod-code = bf_ord-cons-gds.prod-code  :
     1307                               l-rcv-code  = loc_ord-line-rcv.rcv-code.
     1308                               l-time-rcv  = loc_ord-doc-rcv.ship-time.
     1309                               l-qnty-rcv =  loc_ord-line-rcv.qnty.
     1310                           run create-tt-line.
     1311                           assign
     1312                             tt-line = true
     1313                             l-rcv-code = ""
     1314                             l-time-rcv = 0
     1315                             l-qnty-rcv = 0
     1316                           .
     1317                   end.
     1318                 if tt-line = false then run create-tt-line.
     1319               end.
     1320             ttt-line = true .
     1321             if last-of ( loc_ord-doc.doc-code ) then l-qnty-fp = 0.
     1322           end.
     1323             if ttt-line = false then  run create-tt-line.
     1324       end.
     1325     end.
     1326   end.
     1327   end procedure .
     1328   procedure create-tt-line :
     1329   ii = ii + 1.
     1330   IF ( ii modulo v-account = 0 )  then DO:
     1331    Assign
     1332       v-kol-spice = (50 - LENGTH(reportname)) / 2
     1333       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     1334       .
     1335    Assign
     1336       v-kol-spice = (50 - LENGTH(ub.clients.obj-name)) / 2
     1337       RecordsString2 = fill(' ',v-kol-spice) + string(ub.clients.obj-name)
     1338       .
     1339    Assign
     1340       v-kol-spice = (50 - LENGTH(ub.goods.gds-name)) / 2
     1341       RecordsString3 = fill(' ',v-kol-spice) + string(ub.goods.gds-name)
     1342       .
     1343             if  log-manager:logfile-name ne ?
     1344             then DO:
     1345                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1346             end.
     1347              if mFrameView
     1348              then do:
     1349               DISPLAY
     1350                 ii @ RecordsDone
     1351                 RecordsString   @ RecordsString
     1352                 RecordsString2  @ RecordsString2
     1353                 RecordsString3  @ RecordsString3
     1354                 WITH FRAME InfoFrame.
     1355              end.
     1356   End.
     1357      if v-button-stop then  DO:
     1358            if mFrameView
     1359            then
     1360               PROCESS EVENTS.
     1361            IF StopProcessing THEN DO:
     1362            RETURN error.
     1363            End.
     1364      end.
     1365    l-nn = l-nn + 1 .
     1366   create temp-tt .
     1367   assign
     1368    temp-tt.nnn         = l-nn
     1369    temp-tt.obj-type    = ub.clients.obj-type + " " + string(ub.clients.obj-code)
     1370    temp-tt.obj-name    = ub.clients.obj-name
     1371    temp-tt.gds-code    = ub.goods.gds-code
     1372    .
     1373    If l-nn = 1 then Do:
     1374       run calc-var in this-procedure (input ub.clients.obj-type,
     1375                    input ub.clients.obj-code,
     1376                    input ub.goods.gds-code,
     1377                    output l-max,
     1378                    output l-ost,
     1379                    output l-temp-sale).
     1380         assign
     1381             temp-tt.max-qnty    = l-max
     1382             temp-tt.measure-qnty = l-ost
     1383             temp-tt.free-qnty   = temp-tt.max-qnty  - temp-tt.measure-qnty
     1384             temp-tt.temp-sale   = l-temp-sale
     1385             temp-tt.qnty-of     = l-qnty-of
     1386             temp-tt.time-of     = (if l-time-of  = 0 then " " else string(l-time-of,"HH:MM"))
     1387             .
     1388          end.
     1389    else
     1390         assign
     1391             temp-tt.max-qnty    = 0
     1392             temp-tt.measure-qnty = 0
     1393             temp-tt.free-qnty   = 0
     1394             temp-tt.temp-sale   = 0
     1395             temp-tt.qnty-of     = 0
     1396             temp-tt.time-of     = " "
     1397             .
     1398    if old-l-ord-code <> l-ord-code then do:
     1399       assign
     1400           temp-tt.qnty-fp     = l-qnty-fp
     1401           temp-tt.cli-cod     = l-cli-code
     1402           temp-tt.cli-name    = l-cli-name
     1403           .
     1404    end.
     1405    else do:
     1406       assign
     1407           temp-tt.qnty-fp     = 0
     1408           temp-tt.cli-cod     = ""
     1409           temp-tt.cli-name    = ""
     1410           .
     1411    end.
     1412    assign
     1413       temp-tt.ord-code    = l-ord-code
     1414       old-l-ord-code      = l-ord-code
     1415       temp-tt.rcv-code    = l-rcv-code
     1416       temp-tt.time-rcv    = (if l-time-rcv  = 0 then  " " else string(l-time-rcv,"HH:MM"))
     1417       temp-tt.qnty-rcv    = l-qnty-rcv
     1418   .
     1419   end procedure .
     1420   procedure max-col :
     1421   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1422   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1423   define output parameter p-max as integer no-undo .
     1424        p-max = 0 .
     1425        for each temp-tt where temp-tt.obj-type = p-obj-type  + " " + string(p-obj-code)
     1426          break by temp-tt.nnn DESCENDING :
     1427          p-max = temp-tt.nnn.
     1428          leave.
     1429        end.
     1430   end procedure .
     1431   procedure calc-var :
     1432   define input  parameter  m-type   like ub.clients.obj-type   no-undo .
     1433   define input  parameter  m-code   like ub.clients.obj-code   no-undo .
     1434   define input  parameter  m-gds-code  like ub.goods.gds-code  no-undo .
     1435   define output parameter  m-max       like l-max           no-undo .
     1436   define output parameter  m-ost       like l-ost           no-undo .
     1437   define output parameter  m-temp-sale like l-temp-sale     no-undo .
     1438   for each ub.place no-lock where
     1439         ub.place.obj-code =  m-code and
     1440         ub.place.obj-type =  m-type ,
     1441         first ub.pl-gds no-lock where
     1442               ub.pl-gds.gds-code = m-gds-code and
     1443               ub.pl-gds.obj-code = ub.place.obj-code          and
     1444               ub.pl-gds.obj-type = ub.place.obj-type          and
     1445               ub.pl-gds.pl-code  = ub.place.pl-code          :
     1446         m-max = m-max + ub.place.max-qnty.
     1447         find last ub.rvs-line no-lock where
     1448         ub.rvs-line.gds-code = ub.pl-gds.gds-code  and
     1449         ub.rvs-line.obj-code = ub.pl-gds.obj-code  and
     1450         ub.rvs-line.obj-type = ub.pl-gds.obj-type  and
     1451         ub.rvs-line.pl-code  = ub.pl-gds.pl-code
     1452         use-index gds-pl-code no-error .
     1453         if avail ub.rvs-line then
     1454            m-ost = m-ost +  ub.rvs-line.state-measure-qnty.
     1455   end.
     1456   end procedure .
