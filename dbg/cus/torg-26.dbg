      728   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      729     (input  v-cntxt-host-code-obj
      730     ,output base-code
      731     )  .
      732   find first buf_rep_currency no-lock
      733     where buf_rep_currency.curr-code = base-code
      734     no-error .
      735     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
      736                  else base-type = "б.в." .
      737   run get-report-num in parParentProc ( output g#report-num ).
      738   run get-gds-engl in parParentProc ( output g#gds-engl ) .
      739   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
      740     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      741     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
      742     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
      743   END FUNCTION.
      744   PROCEDURE get-red-line :
      745     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
      746     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      747     DO ON ERROR UNDO, RETURN ERROR :
      748       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
      749     END.
      750   END PROCEDURE.
      751   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
      752     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
      753     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
      754     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
      755   END FUNCTION.
      756   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      757     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
      758     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
      759     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
      760   END FUNCTION.
      761   PROCEDURE get-number-grade :
      762     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
      763     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
      764     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      765     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      766     DO ON ERROR UNDO, RETURN ERROR :
      767       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
      768       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      769       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      770       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      771                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      772       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      773     END.
      774   END PROCEDURE.
      775   PROCEDURE conv-sum-to-word :
      776     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      777     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      778     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      779     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      780     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      781     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      782     DO ON ERROR UNDO, RETURN ERROR :
      783       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      784       IF ERROR-STATUS :ERROR THEN DO:
      785         ASSIGN p-res = ?.
      786         UNDO, RETURN ERROR.
      787       END.
      788       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      789         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      790         IF jj < 15 THEN DO:
      791           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      792           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      793              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      794           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      795              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      796              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      797             IF jj = 12 THEN DO:
      798               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      799             END.       ELSE DO:
      800               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      801             END.
      802           END.
      803           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      804                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      805                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      806                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      807              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      808           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      809         END.
      810         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      811           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      812           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      813           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      814           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      815           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      816         END.                                        ELSE DO:
      817           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      818         END.
      819         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      820         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      821         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      822       END.
      823       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      824       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      825       ASSIGN p-res = TRIM( OutSum ).
      826     END.
      827   END PROCEDURE.
      828   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
      829     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
      830     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
      831     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
      832   END FUNCTION.
      833   PROCEDURE get-total-word :
      834     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
      835     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
      836     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
      837     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
      838     DO ON ERROR UNDO, RETURN ERROR :
      839       ASSIGN p-word = Word-Sum( p-sum ).
      840                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
      841                         RedLine( p-word )
      842                  ) +
      843                         " ":U + p-curr + " ":U +
      844                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
      845                         " ":U + p-part + ".".
      846                           END.
      847   END PROCEDURE.
