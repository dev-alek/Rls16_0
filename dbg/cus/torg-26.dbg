      681     run proc-alt-shift-f2.
      682   end.
      683   on alt-shift-f3 anywhere do:
      684     run proc-alt-shift-f3 in this-procedure .
      685   end.
      686   on alt-shift-f4 anywhere do:
      687     run proc-alt-shift-f4 in this-procedure.
      688   end.
      689   on alt-f1 anywhere do:
      690     run proc-alt-f1 in this-procedure .
      691   end.
