      914   define variable b-stoim       as character no-undo .
      915   define variable b-price       as character no-undo .
      916   define variable B-service     as decimal no-undo.
      917   define variable B-ship        as decimal no-undo.
      918   define variable OKEI          as char    no-undo.
      919   define variable ProdName      as char    no-undo.
      920   define variable pp as character no-undo .
      921   DEFINE FRAME sl
      922           sym1 column-label ":!:!:!:!:"  format "X(1)" space(0)
      923           Lines_Counter COLUMN-LABEL "N!п/п! ! ! " format ">>>>9" space(0)
      924           sym2 column-label ":!:!:!:!:" format "X(1)" space(0)
      925           ub.goods.artic COLUMN-LABEL "Артикул! ! ! ! " format "X(16)" space(0)
      926           sym3 column-label ":!:!:!:!:" format "X(1)" space(0)
      927           ub.goods.gds-name COLUMN-LABEL "Наименование товара! ! ! ! " format "X(39)" space(0)
      928           Sym4 column-label ":!:!:!:!:" format "X(1)" space(0)
      929           tb-code COLUMN-LABEL "Код товара! ! ! ! " format "X(10)" space(0)
      930           sym5 column-label ":!:!:!:!:" format "X(1)" space(0)
      931           ub.goods.sort COLUMN-LABEL "Сорт! ! ! ! " format "X(4)" space(0)
      932           sym11 column-label ":!:!:!:!:" format "X(1)" space(0)
      933           ub.units.OKEI COLUMN-LABEL "Код!ед.!изм.!по!ОКЕИ" format ">>>>" space(0)
      934           sym6 column-label ":!:!:!:!:" format "X(1)" space(0)
      935           ub.units.unit-name COLUMN-LABEL "Наим!ед.!изм.! ! " format "X(4)" space(0)
      936           sym7 column-label ":!:!:!:!:" format "X(1)" space(0)
      937           B-qnty COLUMN-LABEL "Количество ! ! ! ! " format "->>>>>>>9.<<<" space(0)
      938           sym9 column-label ":!:!:!:!:" format "X(1)" space(0)
      939           B-PRICE COLUMN-LABEL "Цена           ! ! ! ! " format "x(14)" space(0)
      940           sym10 column-label ":!:!:!:!:" format "X(1)" space(0)
      941           B-stoim COLUMN-LABEL "Сумма ! ! ! ! " format "x(15)" space(0)
      942           sym12 column-label ":!:!:!:!:" format "X(1)" space(0)
      943          HEADER
      944           string( cur-time-print() ) AT 5 format "X(35)"
      945           string( "Заказ N " + tdoc-code + "  от  " + string ( tdoc-date , "99/99/9999" ) ) AT 47 format "X(63)"
      946           string( pp ) AT 90 format "X(19)"
      947           string( " Лист " + string( PAGE-NUMBER(OutStream) , ">>9") ) format "X(13)" SKIP
      948           UndLine format "X(136)" AT 1
      949           with width 136 down stream-io use-text NO-BOX.
      950   FIND ub.ord-doc WHERE recid(ub.ord-doc) = rec_id NO-LOCK .
      951   assign
      952       tdoc-date = (if ub.ord-doc.status_ <> 'факт':U then ub.ord-doc.doc-date else ub.ord-doc.fact-date)
      953       tdoc-code = ub.ord-doc.doc-code .
      954   if session:set-wait-state("compiler") then.
      955   output STREAM OutStream to value( string( session:temp-directory +
      956                                        "rpt" + string( g#report-num ) ) )
      957                                        page-size  value(62) .
      958   assign
      959     Line    = fill("-", 136)
      960     UndLine = fill("_", 136)
      961     LineBuf = fill("_", 136) .
      962     if  CostPrice then DO:
      963                      IF PrintRubl
      964                        THEN Assign PP = "Учетные цены ".
      965                        Else Assign PP = "Учетные цены (б.в.)" .
      966                      End.
      967      Else DO:
      968                   IF PrintRubl
      969                        THEN Assign PP = "Цены док-та".
      970                        Else Assign PP = "Цены док-та (б.в.)" .
      971           End.
      972   if ub.ord-doc.exch-code = 0 then
      973       assign
      974           PrintRubl = true
      975           pp = "руб"
      976       .
      977   else do:
      978      FIND ub.currency NO-LOCK WHERE ub.currency.curr-code = ub.ord-doc.exch-code.
      979      assign
      980           PrintRubl = false
      981           pp = ub.currency.curr-abbr
      982           .
      983           end.
      984   .
      985   run waitfram-show in this-procedure ( 'Подождите ...' ) .
      986   FIND This_Object  WHERE This_Object.obj-type = v-cntxt-obj-type
      987                       AND This_Object.obj-code = v-cntxt-obj-code NO-LOCK.
      988   FIND ub.clients  WHERE ub.clients.obj-type = 'орг':U
      989                   AND ub.clients.obj-code = ub.ord-doc.host-code NO-LOCK.
      990   Case ub.ord-doc.cli-type :
      991       when  'орг':U then do :
      992           FIND ub.firm  WHERE ub.firm.firm-code = ub.ord-doc.cli-code NO-LOCK.
      993           Assign
      994             B-adress = ub.firm.addres1
      995             b-phone  = ub.firm.phone .
      996           end.
      997       when  'чел':U then do :
      998           FIND ub.person  WHERE ub.person.psn-code = ub.ord-doc.cli-code NO-LOCK.
      999           Assign
     1000             B-adress = ub.person.address
     1001             b-phone  = ub.person.phone1 .
     1002           end.
     1003       when  'маг':U then do :
     1004           FIND ub.shop  WHERE ub.shop.obj-code = ub.ord-doc.cli-code NO-LOCK.
     1005           Assign
     1006             B-adress = ub.shop.addres1
     1007             b-phone  = ub.shop.phone .
     1008           end.
     1009       when  'скл':U then do :
     1010           FIND ub.store  WHERE ub.store.obj-code = ub.ord-doc.cli-code NO-LOCK.
     1011           Assign
     1012             B-adress = ub.store.addres1
     1013             b-phone  = ub.store.phone .
     1014           end.
     1015    End case.
     1016    IF ub.ord-doc.doc-type = 'при':U Then
     1017     Assign
     1018      NAme1   = "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     1019      Adres1 = t-addres + " " + t-phone
     1020      NAme2   = ub.ord-doc.cli-name
     1021      Adres2  = b-adress + '  ' + b-phone .
     1022      Else
     1023     Assign
     1024      NAme2   = "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     1025      Adres2 = t-addres + " " + t-phone
     1026      NAme1   = ub.ord-doc.cli-name
     1027      Adres1  = b-adress + '  ' + b-phone .
     1028       case clients.obj-type:
     1029          when 'орг':U
     1030          then do:
     1031               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1032               if available ub.firm
     1033               then do:
     1034                   assign
     1035                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1036                       t-addres = t-addres
     1037                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1038                               then ""
     1039                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1040                             )
     1041                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1042                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1043                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1044                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1045                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1046                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1047                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1048                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1049                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1050                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1051                       t-phone = ub.firm.phone
     1052                       t-inn   = ub.firm.inn
     1053                       t-okpo  = ub.firm.okpo
     1054                   .
     1055               end.
     1056          end.
     1057          when 'маг':U
     1058          then do:
     1059               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1060               if available ub.shop
     1061               then do:
     1062                   assign
     1063                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1064                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1065                       t-phone = shop.phone
     1066                       t-inn = ""
     1067                       t-okpo = ""
     1068                   .
     1069               end.
     1070          end.
     1071          when 'скл':U
     1072          then do:
     1073               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1074               if available ub.store
     1075               then do:
     1076                   assign
     1077                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1078                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1079                       t-phone = ub.store.phone
     1080                       t-inn = ""
     1081                       t-okpo = ""
     1082                   .
     1083               end.
     1084          end.
     1085          when 'чел':U
     1086          then do:
     1087               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1088               if available ub.person
     1089               then do:
     1090                   assign
     1091                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1092                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1093                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1094                       t-phone = ub.person.phone1
     1095                       t-inn = ub.person.inn
     1096                       t-okpo = ub.person.okpo
     1097                   .
     1098               end.
     1099          end.
     1100       end case.
     1101   PUT STREAM OutStream
     1102                                                                        space(5) Line format  "X(19)" AT 42 + 76 skip
     1103       space(0)                                                        "| " AT 42 + 76 'код':U  AT 50 + 76   "|" AT 60 + 76 skip
     1104       space(0) "Форма по ОКУД" format "X(14)"                  AT 66 + 38  "| " AT 42 + 76 "0330226"            "|" AT 60 + 76 skip
     1105       space(0) string( Name1 + ' ' + Adres1 ) format "X(100)"
     1106                                        "по ОКПО" format "X(7)" AT  72 + 38 "| " AT  42 + 76 t-okpo format "X(16)" "|" AT 60 + 76 skip
     1107       space(0) string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" ) format "X(100)"
     1108                                                                       "| " AT 42 + 76                        "|" AT 60 + 76 skip
     1109       space(0) "Вид деятельности по ОКДП" format "X(25)" AT 55 + 38       "| " AT 42 + 76                        "|" AT 60 + 76 skip
     1110       space(0) "" format "X(26)" AT 53 + 38                               "| " AT 42 + 76 ub.ord-doc.doc-date
     1111                                                                              format "99/99/9999"        "|" AT 60 + 76 skip
     1112       space(0) "" format "X(29)" AT 50 + 38                               "| " AT 42 + 76
     1113                               (if ub.ord-doc.status_ <> 'факт':U then tdoc-date else ?) format "99/99/9999" "|" AT 60 + 76 skip
     1114       space(0) "Вид операции" format "X(12)" AT 67 + 38                   "| " AT 42 + 76 "  " format "X(16)"    "|" AT 60 + 76 skip
     1115                                                                        space(5) Line format  "X(19)" AT 42 + 76 skip(2)
     1116                                          space(79) Line format "X(33)" skip
     1117       space(56) string( "З А К А З ") format "x(10)"
     1118                                         " | " at 79
     1119                                           ( string( tdoc-code , "X(16)" ) + " | "
     1120                                           + string( tdoc-date , "99/99/9999" )
     1121                                       + " | "  + (if ub.ord-doc.status_ <> 'факт':U then string( "(" + CAPS(ub.ord-doc.status_) + ")" ) else ""))
     1122                                       + " " + entry(1, ub.ord-doc.cli-out-doc, chr(4))
     1123                                              format "X(116)" skip
     1124                                            space(79) Line format "X(33)" skip
     1125       space(0) "Заказчик " name2  format "X(130)" skip(1)
     1126       space(0) "Адрес " adres2 format "X(40)"  skip(1)
     1127       space(0) "Заказ принял "
     1128                   UndLine format "X(25)" AT 25 UndLine format "X(50)" at 60 SKIP
     1129                     "должность" format "X(25)" AT 25 "фамилия,имя,отчество" format "X(50)" AT 60 SKIP(1)
     1130       "Заказ передал отборщику " UndLine format "X(25)" AT 25 UndLine format "X(50)" at 60 SKIP
     1131       "должность" format "X(25)" AT 25 "фамилия,имя,отчество" format "X(50)"  AT 60 SKIP(1)
     1132       space(0) "Подготовить и доставить на дом к "  String(ub.ord-doc.ship-time,"hh:mm")
     1133                                                                   String(ub.ord-doc.ship-date , "99/99/9999")
     1134                                                                   format "X(193)"  SKIP(2)
     1135       .
     1136    FORM with frame sl .
     1137   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1138   form header
     1139     line format "X(136)" at 1 skip
     1140     "Продолжение - на следующей странице" at 30 skip
     1141     with frame bottomframe width 232 page-bottom no-labels no-box .
     1142   view stream outstream frame bottomframe .
     1143      run waitfram-show in this-procedure( 'Подождите ...' ) .
     1144   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1145   for each ub.ord-line where ub.ord-line.doc-code = ub.ord-doc.doc-code no-lock ,
     1146           first ub.goods where ub.goods.prod-type = ub.ord-line.prod-type and
     1147                             ub.goods.prod-code = ub.ord-line.prod-code and
     1148                             ub.goods.artic = ub.ord-line.artic no-lock break by (if sort-gr then  ub.goods.grp-name else ub.goods.artic) by ub.goods.artic :
     1149       find first ub.units where ub.units.unit-name = ub.ord-line.unit-cli no-lock no-error .
     1150       assign
     1151           lines_counter = lines_counter + 1  .
     1152       accumulate  (ub.ord-line.cli-qnty * ub.ord-line.price-cli) ( total )
     1153                   ub.ord-line.cli-qnty ( total )
     1154                   ub.goods.artic ( count ).
     1155       if sort-gr = true  and first-of (if sort-gr then  ub.goods.grp-name else ub.goods.artic) then do:
     1156         down stream outstream 1 with frame sl .
     1157         put stream outstream unformatted
     1158              string("_______________Группа : " + trim(caps(ub.goods.grp-name)) + undline)  format "X(136)"
     1159              skip .
     1160              end.
     1161               b-price = if ub.ord-line.price-cli = ? then "" else string(ub.ord-line.price-cli) .
     1162               b-qnty  = ub.ord-line.cli-qnty .
     1163               b-stoim =  if b-price = "" then "" else string(decimal(b-price) * b-qnty) .
     1164               b-service = ub.ord-doc.sum-service.
     1165               b-ship    = ub.ord-doc.sum-ship   .
     1166       display stream outstream
     1167         sym1
     1168         lines_counter
     1169         sym2
     1170         ub.goods.artic
     1171         sym3
     1172         ub.goods.gds-name
     1173         sym4
     1174         trim( string( ub.goods.gds-code )) @ tb-code
     1175         sym5
     1176         ub.units.okei
     1177         sym6
     1178         ub.units.unit-name
     1179         sym7
     1180         ub.goods.sort
     1181         sym9
     1182         b-price
     1183         sym10
     1184         b-qnty
     1185         sym11
     1186         b-stoim
     1187         sym12   with frame sl.
     1188         down stream outstream 1 with frame sl .
     1189         if print-graft = false  then  put stream outstream linebuf format "X(136)" skip.
     1190       if ( ( ( accum count ub.goods.artic ) modulo 10 ) = 0 ) and
     1191            ( ( accum count ub.goods.artic ) >= 10 ) then
     1192           run waitfram-show in this-procedure ( "Обработано строк : " + string( accum count ub.goods.artic ) ) .
     1193   end.
     1194   assign
     1195   b-sum1 = accum total (ub.ord-line.cli-qnty * ub.ord-line.price-cli)
     1196   b-sum-qnty = accum total (ub.ord-line.cli-qnty)
     1197   b-sum = b-service + b-ship   + b-sum1.
     1198     if b-sum1 = ? then do:
     1199       display stream outstream
     1200         "Итого " @ ub.units.unit-name
     1201         b-sum-qnty  @ b-qnty
     1202         sym9  sym10  sym7 sym12
     1203         with frame sl.
     1204      end.
     1205     else do:
     1206       display stream outstream
     1207         "Итого " @ ub.units.unit-name
     1208         b-sum-qnty  @ b-qnty
     1209         b-sum1  @ b-stoim
     1210         sym9  sym10  sym7 sym12
     1211         with frame sl.
     1212     end.
     1213      down stream outstream 1 with frame sl .
     1214       if print-graft = false then put stream outstream linebuf format "X(136)" skip.
     1215       put stream outstream
     1216         "Стоимость обслуживания:" + string( b-service , "->>>,>>>,>>9.99" ) + sym12 at 98 format "x(38)"  skip
     1217         "    Стоимость доставки:" + string( b-ship    , "->>>,>>>,>>9.99" ) + sym12 at 98 format "x(38)"  skip
     1218         if b-sum = ? then "" else
     1219         "                 Всего:" + string( b-sum     , "->>>,>>>,>>9.99" ) + sym12 at 98 format "x(38)"  skip.
     1220         down stream outstream 1 with frame sl .
     1221       if print-graft = false then put stream outstream linebuf at 101 format "x(40)" skip.
     1222   run rep/wp-qnty.p ( Lines_counter, output PropisCount).
     1223   run rep/wp-qnty.p ( B-Sum-qnty, output PropisQnty).
     1224   if NOT PrintRubl then
     1225       ASSIGN
     1226       PropisSum = Total-Word( B-Sum, ub.currency.curr-abbr, ub.currency.part-abbr )
     1227       abbr = pp
     1228       .
     1229   else
     1230       run rep/wp-rub.p ( B-Sum , output PropisSum, output abbr).
     1231    run on-same-page in this-procedure (input 23) .
     1232    HIDE stream OutStream FRAME BottomFrame .
     1233    PUT  STREAM OutStream
     1234               "Итого по заказу :" Skip
     1235                 "а) количество порядковых номеров: " + string(Lines_Counter) + " (" + PropisCount + ")"  format "x(179)"                         at 18 SKIP
     1236                 "б) общее количество единиц : " + string(B-Sum-qnty ) + " (" + PropisQnty + ")"  format "x(179)"  at 18 SKIP
     1237                 if B-Sum = ? then "" else
     1238                 "в) на сумму : " + trim(string(B-Sum , "->,>>>,>>>,>>>,>>>,>>>,>>9.99")) + abbr +
     1239                               " (" + PropisSum + ")"  format "x(179)"  at 18 SKIP(1)
     1240               "Расчет проверил "
     1241               LineBuf format "X(25)"     AT 18 LineBuf format "X(25)"   AT 48 LineBuf format "X(50)"               AT 78 SKIP
     1242               "должность" format "X(25)" AT 18 "подпись" format "X(25)" AT 48 "расшифровка подписи" format "X(50)" AT 78 SKIP(1)
     1243               "Отобранный товар проверил контролер-упаковщик : "  LineBuf format "X(25)" AT 48 LineBuf format "X(50)"               AT 78 SKIP
     1244                                                                 "подпись" format "X(25)" AT 48 "расшифровка подписи" format "X(50)" AT 78 SKIP(1)
     1245               "Товар выдал"  Skip
     1246               LineBuf format "X(25)"                              AT 18 LineBuf format "X(25)"   AT 48 LineBuf format "X(50)"               AT 78 SKIP
     1247               "должность" format "X(25)" AT 18 "подпись" format "X(25)" AT 48 "расшифровка подписи" format "X(50)" AT 78 SKIP(2)
     1248               "Заказчик стоимость заказа оплатил" format "X(35)"  LineBuf   AT 48 format "X(25)" skip
     1249                                                                   "подпись заказчика" AT 48 format "X(25)" SKIP
     1250               "Деньги в сумме " +
     1251               ( if B-Sum = ? then " " else
     1252               trim(string(b-Sum, "->,>>>,>>>,>>>,>>>,>>>,>>9.99")) + abbr + " (" + PropisSum + ")"
     1253               )         format "x(179)"  SKIP(1)
     1254               "получил"
     1255               LineBuf format "X(25)"                              AT 18 LineBuf format "X(25)"   AT 48 LineBuf format "X(50)"               AT 78 SKIP
     1256               "должность" format "X(25)"                          AT 18 "подпись" format "X(25)" AT 48 "расшифровка подписи" format "X(50)" AT 78 SKIP
     1257               .
     1258   output stream OutStream CLOSE .
     1259   run waitfram-hide in this-procedure  .
     1260   define variable v-user-action as character no-undo .
     1261   define variable v-printed as logical   no-undo .
     1262   define variable DisabledOptions as integer   no-undo .
     1263   DisabledOptions = 0 .
     1264   run gbl/prnfilen.w
     1265     (input  ""
     1266     ,input  DisabledOptions
     1267     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1268     ,input  7
     1269     ,output v-user-action
     1270     ,output v-printed
     1271     ) .
     1272   procedure calc-sl :
     1273   define input parameter tt as character no-undo .
     1274   if tt = "artic":U THEN DO:
     1275   End.
     1276   if tt = "scala":U THEN DO:
     1277   End.
     1278   end procedure.
     1279   PROCEDURE on-same-page :
     1280     define input parameter p-line-number as integer  no-undo .
     1281     if p-line-number > page-size( OutStream ) then do:
     1282       return .
     1283     end.
     1284     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     1285       page stream OutStream .
     1286     end.
     1287   end procedure.
