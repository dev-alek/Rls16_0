      397   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   define variable v-waitfram-action01         as character   no-undo .
      399   define variable v-waitfram-action02         as character   no-undo .
      400   define variable v-waitfram-action03         as character   no-undo .
      401   define variable mWaitFramTextBeg            as character   no-undo.
      402   define variable mWaitFramTextEnd            as character   no-undo.
      403   define variable mWaitFramView               as logical     no-undo.
      404   define variable mWaitProcEvent              as logical     no-undo init yes.
      405   define variable mWaitFramInterval           as integer     no-undo init 1 .
      406   define variable mWaitFramStop               as logical     no-undo.
      407   define variable mWaitFramStopUser           as logical     no-undo.
      408   define variable mWaitFramStopTimeOut        as logical     no-undo.
      409   define variable mWaitFramStartProc          as datetime-tz no-undo.
      410   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      411   define button B-WaitFramStop auto-end-key
      412        label "Стоп"
      413        size 10 by 1 tooltip "Остоновить процесс".
      414   define button B-viewProcInfo
      415        label "Информация"
      416        size 15 by 1 tooltip "Информация о процесс".
      417   define frame waitfram
      418     v-waitfram-action01 format "x(72)" no-label skip
      419     v-waitfram-action02 format "x(72)" no-label skip
      420     v-waitfram-action03 format "x(72)" no-label skip
      421     B-viewProcInfo
      422     B-WaitFramStop at row 4 col 30
      423     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      424     .
      425   define new global shared variable mBatchMode as logical no-undo init ?.
      426   define variable mFramBachModHandle as handle no-undo.
      427   mFramBachModHandle = frame waitfram:handle.
      428   define variable mFameOldVis as logical no-undo.
      429   define variable mVisCUrentVin as logical no-undo.
      430   if session:batch-mode
      431   then
      432      mBatchMode = yes.
      433   if mBatchMode = ? then do:
      434     mVisCUrentVin = current-window:visible.
      435     mFameOldVis = mFramBachModHandle:visible.
      436     mFramBachModHandle:visible  = yes.
      437     mBatchMode = mFramBachModHandle:visible ne yes.
      438     mFramBachModHandle:visible = mFameOldVis.
      439     current-window:visible = mVisCUrentVin.
      440   end.
      441    if  log-manager:logfile-name ne ?
      442     then DO:
      443         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      444         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      445         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      446     end.
      447   on choose of B-WaitFramStop in frame waitfram
      448   do:
      449     mWaitFramStop = yes.
      450     mWaitFramStopUser = yes.
      451   end.
      452   function waitfram-check-timeout returns logical():
      453      define variable vtime as int64 no-undo.
      454      if mWaitFramStopTimeOut
      455      then
      456         return yes.
      457      vtime = ( now - mWaitFramStartProc ) / 1000 .
      458      if     mWaitFramTimeOut ne ?
      459         and mWaitFramTimeOut ne 0
      460         and mWaitFramTimeOut lt vtime
      461      then do:
      462         mWaitFramStopTimeOut = yes.
      463      end.
      464      return mWaitFramStopTimeOut.
      465   end.
      466   procedure waitfram-hide :
      467     if not session:batch-mode
      468     then do
      469     on error undo, return error return-value
      470     :
      471       pause 0 before-hide .
      472       if not mBatchMode then
      473         hide frame waitfram .
      474     if     not mWaitFramView
      475        and mWaitProcEvent
      476     then
      477       process events .
      478     end.
      479   end procedure.
      480   procedure waitfram-show :
      481     define input  parameter p-message as character no-undo .
      482     define variable v-left-margin as integer   no-undo .
      483     if not session:batch-mode
      484     then do
      485     on error undo, return error return-value
      486     :
      487       if length(p-message) <= 70 then do:
      488         assign
      489           v-left-margin = integer((70 - length(p-message)) / 2)
      490         .
      491         assign
      492           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      493         .
      494         assign
      495           v-waitfram-action01 = " "
      496           v-waitfram-action02 = " "
      497                                    + fill(" ", v-left-margin)
      498                                    + p-message
      499           v-waitfram-action03 = " "
      500         .
      501       end.
      502       else do:
      503         define variable vRindex1 as integer no-undo.
      504         define variable vRindex2 as integer no-undo.
      505         vRindex1 = r-index(p-message," ",70).
      506         if vRindex1 = 0
      507         then
      508            vRindex1 = 70.
      509         if length(p-message)  <= vRindex1 + 70 then do:
      510           assign
      511             v-waitfram-action01 = " "
      512             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      513             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      514           .
      515         end.
      516         else do:
      517           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      518           if vRindex2 <= vRindex1
      519           then
      520              vRindex2 = vRindex1 + 70.
      521           assign
      522             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      523             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      524             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      525           .
      526         end.
      527       end.
      528       B-viewProcInfo:visible   in frame waitfram = no.
      529       B-viewProcInfo:sensitive in frame waitfram = no.
      530       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      531       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      532       if  (   mWaitFramView
      533          or  mWaitProcEvent)
      534          and not mBatchMode
      535       then
      536          display
      537             v-waitfram-action01 skip
      538             v-waitfram-action02 skip
      539             v-waitfram-action03 skip
      540          with frame waitfram .
      541       if     mWaitFramView
      542          then do:
      543             if     mWaitFramInterval ne ?
      544                and not mBatchMode
      545             then
      546                wait-for go of frame waitfram pause mWaitFramInterval.
      547          end.
      548          else
      549             if     mWaitProcEvent
      550                and not mBatchMode
      551             then
      552                process events .
      553     end.
      554   end procedure.
      555      procedure waitfram-show-this:
      556         define input  parameter iInterval as int64 no-undo.
      557         define variable vtime as int64 no-undo.
      558         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      559         mWaitFramInterval = iInterval.
      560         run waitfram-show (substitute("&1&2 &3&4" ,
      561                                       mWaitFramTextBeg ,
      562                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      563                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      564                                       mWaitFramTextEnd
      565                                      )
      566                           ).
      567      end.
      568      procedure WaitFramRunPause:
      569         define input  parameter iInterval as dec no-undo.
      570         define variable vStart  as datetime-tz no-undo.
      571         define variable vend    as datetime-tz no-undo.
      572         define variable vint as int64 no-undo.
      573         define variable vOk as logical no-undo.
      574         vStart = now.
      575         vend   = vStart.
      576         publish "WaitFramPause" (iInterval,output vOk).
      577         vend   =  now.
      578         vint = vend - vStart.
      579         vint = iInterval - vint / 1000.
      580         if     not mWaitFramStop
      581            and (   vint > 0
      582                 or (    not vOk
      583                     and iInterval eq ?
      584                     )
      585                 )
      586         then
      587            run waitfram-show-this (iInterval).
      588         vend   =  now.
      589         vint = vend - vStart.
      590         vint = iInterval - vint / 1000.
      591         if     not mWaitFramStop
      592            and vint > 0
      593         then do:
      594            run gbl/pause.p (vint * 1000).
      595         end.
      596         if iInterval ne ?
      597         then
      598            publish "WaitFramStop".
      599         waitfram-check-timeout().
      600      end.
      601      procedure WaitFramWaitFor:
      602         define input  parameter iInterval as dec no-undo.
      603         assign
      604            mWaitFramStartProc   = now
      605            mWaitFramStopUser    = no
      606            mWaitFramStopTimeOut = no
      607         .
      608         block-wait:
      609         do while not mWaitFramStop:
      610            run WaitFramRunPause (iInterval).
      611            if  waitfram-check-timeout()
      612            then do:
      613               leave block-wait.
      614            end.
      615         end.
      616         run waitfram-hide.
      617      end.
      618   procedure waitfram-join :
      619     define input  parameter p-line-1  as character no-undo .
      620     define input  parameter p-line-2  as character no-undo .
      621     define input  parameter p-line-3  as character no-undo .
      622     define output parameter p-message as character no-undo .
      623     do
      624     on error undo, return error return-value
      625     :
      626       assign
      627         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      628                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      629                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      630       .
      631     end.
      632   end procedure.
      633   function waitfram-join-function returns character
      634     (input p-line-1 as character
      635     ,input p-line-2 as character
      636     ,input p-line-3 as character
      637     ).
      638     define variable v-message as character no-undo .
      639     run waitfram-join in this-procedure
      640       (input  p-line-1
      641       ,input  p-line-2
      642       ,input  p-line-3
      643       ,output v-message
      644       ) .
      645     return v-message .
      646   end function .
      647   procedure proc-alt-shift-f2:
      648     if not ibs.th.gbl.gbl-var:rcode
      649   then
      650     run gbl\inidebug.p .
      651   end.
      652   procedure proc-alt-shift-f3:
      653     run gbl/prvssinf.p
      654       ( input this-procedure
      655       ) .
      656   end.
      657   define variable v-inform-launched as logical no-undo initial false .
      658   procedure proc-alt-shift-f4:
      659     define variable v-action as character no-undo .
      660     if v-inform-launched = false then do:
      661       assign
      662         v-inform-launched = true
      663       .
      664       run gbl/d-inform.w
      665         (  input self
      666         ,  input this-procedure
      667         , output v-action
      668         ) no-error .
      669       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      670       assign
      671         v-inform-launched = false
      672       .
      673     end.
      674   end.
      675   procedure proc-alt-f1:
      676     run gbl/corrhelp.p
      677       (input this-procedure
      678       ) .
      679   end .
