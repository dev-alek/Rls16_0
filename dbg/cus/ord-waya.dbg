      172        FGCOLOR 4  NO-UNDO.
      173   DEFINE QUERY br-docs FOR
      174         dd_ord-line,
      175         ub.ord-line,
      176         ub.goods,
      177         ub.ord-doc SCROLLING.
      178   DEFINE BROWSE br-docs
      179     QUERY br-docs NO-LOCK DISPLAY
      180         dd_ord-line.doc-code
      181     dd_ord-line.artic
      182     dd_ord-line.prod-type  + " " + string( dd_ord-line.prod-code)  COLUMN-LABEL "Произв.-ль"   FORMAT "X(10)"
