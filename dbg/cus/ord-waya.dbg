      192     ub.ord-doc.date-sale-2 FORMAT "99/99/99"
      193       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.88 BY 14.04.
      194   DEFINE FRAME Dialog-Frame
      195        B-exit AT ROW 1 COL 1
      196        B-lkp AT ROW 1 COL 11
      197        B-Help AT ROW 1.04 COL 89.38
      198        br-docs AT ROW 2.29 COL 1
      199        v-user-name AT ROW 16.5 COL 5.5 COLON-ALIGNED WIDGET-ID 2
      200        SPACE(78.49) SKIP(0.29)
      201       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      202            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      203            TITLE "Товары в пути".
      204   ASSIGN
      205          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      206          FRAME Dialog-Frame:HIDDEN           = TRUE.
      207   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      208   DO:
      209     APPLY "END-ERROR":U TO SELF.
      210   END.
      211   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
      212   DO:
      213      define variable ri-list as char no-undo .
      214       define variable old-rep-rec as recid no-undo.
      215       define variable old-doc-rec as recid no-undo.
      216       define variable old-list-mode as character no-undo.
      217   next-prev = no.
      218   br-handle = br-docs:handle.
      219   do while next-prev <> ?:
      220     if not available ub.ord-doc then do:
      221       message "Неправильный выбор документа.".
      222       return no-apply.
      223     end.
      224       find first shar-buf_ord-doc no-lock
      225           where shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code
      226           no-error .
      227          bf-handle = buffer shar-buf_ord-doc:handle in frame Dialog-Frame .
      228      run cus/lkp-zakz.w
      229        ( input parparentproc ,
      230          input-output br-handle ,
      231          input-output bf-handle ,
      232          input-output next-prev ).
      233   end.
      234   if br-handle = ? then reposition br-docs to recid doc-rec no-error.
      235   END.
      236   ON VALUE-CHANGED OF br-docs IN FRAME Dialog-Frame
      237   DO:
      238   if available ub.ord-doc then do:
      239   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      241     (input  ub.ord-doc.creid
      242     ,output v-user-name
      243     )  .
      244   end.
      245   display v-user-name  with fram Dialog-Frame .
      246   END.
      247   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      248   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      249   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   on help of frame Dialog-Frame
      251   do:
      252     run gbl/app_help.p
      253       (input this-procedure :file-name
      254       ,input ''
      255       ,input ?
      256       ) no-error.
      257     if error-status :error then do:
