      189     ub.ord-doc.cli-type  + " " + string (ub.ord-doc.cli-code) COLUMN-LABEL "Поставщик"   FORMAT "X(10)"
      190     ub.ord-doc.ship-date COLUMN-LABEL "Поставка"
