      829     define variable v-cntxt-obj-type      as character no-undo .
      830     define variable v-cntxt-obj-code      as integer   no-undo .
      831     define variable v-cntxt-db-num-obj    as integer   no-undo .
      832     define variable v-cntxt-is-admin      as logical   no-undo .
      833   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      834   define  stream PrnLibStream.
      835   procedure prn-lib-prn-file :
      836     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      837     define input parameter p-DIsabledoptions as integer no-undo .
      838     define variable v-report-name as character no-undo .
      839     define variable v-user-action as character no-undo .
      840     define variable v-printed     as logical   no-undo .
      841     define variable v-exist       as logical   no-undo .
      842     do
      843       on error undo, return error
      844       :
      845       run prn-lib-get-report-name  in this-procedure (
      846         input parParentProc
      847         ,output v-report-name
      848         ).
      849   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      851     (input  v-report-name
      852     ,input  2
      853     ,output v-exist
      854     )  .
      855       if NOT v-exist then
      856       DO:
      857         Message
      858           "Нет заданий на печать ! "
      859           view-as alert-box .
      860         Return  .
      861       End.
      862       run gbl/prnfilen.w
      863         (input  ""
      864         ,input  p-DisabledOptions
      865         ,input  string(v-report-name )
      866         ,input  7
      867         ,output v-user-action
      868         ,output v-printed
      869         ) .
      870       if v-printed then
      871       do:
      872         return "YES" .
      873       end.
      874       else
      875       do:
      876         return "NO" .
      877       end.
      878     end.
      879   end procedure.
      880   procedure prn-lib-open-stream :
      881     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      882     define input parameter p-page-size    as integer no-undo .
      883     define input parameter p-is-stream    as logical no-undo .
      884     define input parameter p-append       as logical no-undo .
      885     define variable v-report-name as character no-undo .
      886     do
      887       on error undo, return error
      888       :
      889       run prn-lib-get-report-name  in this-procedure (
      890         input parParentProc
      891         ,output v-report-name
      892         ).
      893       if p-is-stream then
      894       do:
      895         if p-append then
      896         do:
      897           output stream PrnLibStream to value( v-report-name )
      898             page-size value(p-page-size) append .
      899         end.
      900         if not p-append then
      901         do:
      902           output stream PrnLibStream to value( v-report-name )
      903             page-size value(p-page-size) .
      904         end.
      905       end.
      906       if not p-is-stream then
      907       do:
      908         if p-append then
      909         do:
      910           output to value( v-report-name )
      911             page-size value(p-page-size) append .
      912         end.
      913         if not p-append then
      914         do:
      915           output to value( v-report-name )
      916             page-size value(p-page-size) .
      917         end.
      918       end.
      919     end.
      920   end procedure.
      921   procedure prn-lib-open-exp :
      922     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      923     define input parameter p-is-stream    as logical no-undo .
      924     define input parameter p-is-append    as logical no-undo .
      925     define output parameter p-ReportFileName as char init "report" no-undo.
      926     define output parameter p-process as logical no-undo .
      927     define variable glog as logical no-undo .
      928     do
      929       on error undo, return error
      930       :
      931       SYSTEM-DIALOG GET-FILE p-ReportFileName
      932         TITLE      "Укажите путь"
      933         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      934         ASK-OVERWRITE
      935         CREATE-TEST-FILE
      936         SAVE-AS
      937         USE-FILENAME
      938         DEFAULT-EXTENSION "txt"
      939         UPDATE glog
      940         .
      941       if not glog then  return.
      942       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      943       if p-is-stream then
      944       do:
      945         if p-is-append then
      946         do:
      947           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      948         end.
      949         else
      950         do:
      951           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      952         end.
      953       end.
      954       else
      955       do:
      956         if p-is-append then
      957         do:
      958           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      959         end.
      960         else
      961         do:
      962           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      963         end.
      964       end.
      965       p-process = yes.
      966     end.
      967   end procedure.
      968   procedure prn-lib-get-report-name :
      969     define input parameter parParentProc  as widget-handle no-undo.
      970     define output parameter p-report-name as character no-undo .
      971     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      972   end procedure.
      973   procedure prn-lib-reportviewer-report-name :
      974     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      975     define input parameter p-report-name-html as character no-undo .
      976     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      977   end procedure.
      978   procedure prn-lib-reportviewer :
      979     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      980     define input parameter p-report-name-html as character no-undo .
      981     define input parameter p-param        as character no-undo .
      982     define variable v-excel           as character no-undo init 'TRUE' .
      983     define variable v-value-character as character no-undo .
      984     define variable v-value-integer   as character no-undo .
      985     define variable v-value-date      as date      no-undo .
      986     define variable v-value-decimal   as decimal   no-undo .
      987     define variable rep-excel         as logical   no-undo .
      988     define variable excel-string      as character no-undo .
      989     define variable v-param-type      as character no-undo .
      990     define variable v-tth             as handle    no-undo .
      991     run adm/shattri.p (
      992       input "get":U
      993       ,input  ""
      994       ,input  0
      995       ,input  'report-glob':U
      996       ,input  'rep-excel':U
      997       ,output v-value-character
      998       ,output v-value-date
      999       ,output v-value-decimal
     1000       ,output v-value-integer
     1001       ,output rep-excel
     1002       ,output v-param-type
     1003       ,INPUT-OUTPUT table-handle v-tth
     1004       )  .
     1005     if rep-excel then v-excel = "TRUE" .
     1006     else v-excel = "FALSE" .
     1007     if p-param eq ""
     1008     then
     1009        p-param = "EXCEL:" + v-excel.
     1010     else
     1011        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1012     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1013   end procedure.
     1014   define variable     NotInc          as  log     no-undo.
     1015   define variable Line                as      char    no-undo.
     1016   define variable date_string     as      char    no-undo.
     1017   define var cas-num as integer no-undo.
     1018   define SHARED var method as character no-undo.
     1019   define variable v-dopd as decimal no-undo .
     1020   def SHARED var cas-shft as logical no-undo init no.
     1021   define variable found as logical init yes no-undo.
     1022   define variable multi-obj as logical no-undo.
     1023   define variable g#log as logical no-undo .
     1024   define variable type-par1 as character no-undo .
     1025   define variable tmp-var1  as character no-undo .
     1026   define variable p-XL-delim as character no-undo .
     1027   define buffer buf_chk-doc for ub.chk-doc.
     1028   define buffer buf_clients for ub.clients.
     1029   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030     run mainmenu_getcntxt in my-handle
     1031       (output v-cntxt-db-num
     1032       ,output v-cntxt-userid
     1033       ,output v-cntxt-level
     1034       ,output v-cntxt-host-code-obj
     1035       ,output v-cntxt-obj-type
     1036       ,output v-cntxt-obj-code
     1037       ,output v-cntxt-db-num-obj
     1038       ,output v-cntxt-is-admin
     1039       ) .
     1040   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1041   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1042   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1043   define variable par-type          as character no-undo.
     1044   define variable v-value-character as character no-undo .
     1045   define variable v-value-date      as date      no-undo .
     1046   define variable v-value-decimal   as decimal   no-undo .
     1047   define variable v-value-integer   as integer   no-undo .
     1048   define variable v-value-logical   as logical   no-undo .
     1049   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1050   empty temp-table thbjattr_thbj-attr.
     1051   run adm/shattri.p (
     1052      input "get":U
     1053     ,input v-cntxt-obj-type
     1054     ,input v-cntxt-obj-code
     1055     ,input 'report-firm':U
     1056     ,input  ""
     1057     ,output v-value-character
     1058     ,output v-value-date
     1059     ,output v-value-decimal
     1060     ,output v-value-integer
     1061     ,output v-value-logical
     1062     ,output par-type
     1063     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1064     ) no-error .
     1065   for each thbjattr_thbj-attr :
     1066       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1067   end.
     1068   IF tmp-var1 = "" then p-XL-delim = ";".
     1069   else p-XL-delim = tmp-var1.
     1070   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1071   PROCEDURE no-benq.
     1072   DEFINE OUTPUT PARAMETER found as logical init no.
     1073   define buffer buf_chk-doc for ub.chk-doc.
     1074   FOR EACH obj-list WHERE
     1075           obj-list.obj-type = 'маг':U NO-LOCK :
     1076     CASE X-Radio-Task > 1 :
     1077       WHEN YES THEN DO:
     1078         FOR EACH buf_chk-doc NO-LOCK WHERE
     1079                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1080                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1081                 (
     1082                   buf_chk-doc.shift-date >= X-date-start AND
     1083                   buf_chk-doc.shift-date <= X-date-end)
     1084                   AND
     1085                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1086           IF X-Radio-Task = 3 AND
     1087           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1088             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1089           IF X-Radio-Task = 4 AND
     1090           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1091           found = yes.
     1092           return.
     1093         END.
     1094       END.
     1095       WHEN NO THEN DO:
     1096         FOR EACH buf_chk-doc NO-LOCK WHERE
     1097               buf_chk-doc.obj-type = obj-list.obj-type AND
     1098               buf_chk-doc.obj-code = obj-list.obj-code AND
     1099               buf_chk-doc.chk-date >= X-date-start AND
     1100               buf_chk-doc.chk-date <= X-date-end   AND
     1101               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1102           found = yes.
     1103           return.
     1104         END.
     1105        END.
     1106      END CASE.
     1107    END.
     1108   END PROCEDURE.
     1109   PROCEDURE no-benqi.
     1110   DEFINE OUTPUT PARAMETER found as logical init no.
     1111   define buffer buf_chk-doc for ub.chk-doc.
     1112   define buffer buf_inkas for ub.inkas.
     1113   FOR EACH obj-list WHERE
     1114         obj-list.obj-type = 'маг':U NO-LOCK :
     1115     CASE X-Radio-Task > 1 :
     1116       WHEN YES THEN DO:
     1117         FOR EACH buf_chk-doc No-LOCK WHERE
     1118                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1119                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1120                 (
     1121                   buf_chk-doc.shift-date >= X-date-start AND
     1122                   buf_chk-doc.shift-date <= X-date-end)
     1123                   AND
     1124                   buf_Chk-doc.out-code = ? AND
     1125                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1126           IF X-Radio-Task = 3 AND
     1127           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1128             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1129           IF X-Radio-Task = 4 AND
     1130           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1131           found = yes.
     1132           return.
     1133         END.
     1134         FOR EACH buf_inkas No-LOCK WHERE
     1135                   buf_inkas.obj-type = obj-list.obj-type AND
     1136                   buf_inkas.obj-code = obj-list.obj-code AND
     1137                   (
     1138                   buf_inkas.shift-date >= X-date-start AND
     1139                   buf_inkas.shift-date <= X-date-end):
     1140           if buf_inkas.status_ = 'факт':U
     1141           or buf_inkas.status_ = 'запрос':U then next.
     1142           IF X-Radio-Task = 3 AND
     1143           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1144             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1145           IF X-Radio-Task = 4 AND
     1146           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1147           found = yes.
     1148           return.
     1149         END.
     1150       END.
     1151       WHEN NO THEN DO:
     1152         FOR EACH buf_chk-doc NO-LOCK WHERE
     1153                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1154                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1155                 buf_chk-doc.chk-date >= X-date-start AND
     1156                 buf_chk-doc.chk-date <= X-date-end   AND
     1157                 buf_Chk-doc.out-code = ? AND
     1158                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1159           found = yes.
     1160           return.
     1161         END.
     1162         FOR EACH buf_inkas NO-LOCK WHERE
     1163                 buf_inkas.obj-type = obj-list.obj-type AND
     1164                 buf_inkas.obj-code = obj-list.obj-code AND
     1165                 buf_inkas.doc-date >= X-date-start AND
     1166                 buf_inkas.doc-date <= X-date-end :
     1167           if buf_inkas.status_ = 'факт':U
     1168           or buf_inkas.status_ = 'запрос':U then next.
     1169           found = yes.
     1170           return.
     1171         END.
     1172       END.
     1173     END CASE.
     1174   END.
     1175   END PROCEDURE.
     1176   PROCEDURE no-benq-i.
     1177   DEFINE OUTPUT PARAMETER found as logical init no.
     1178   define buffer buf_inkas for ub.inkas.
     1179   CASE X-Radio-Task > 1:
     1180     WHEN YES then do:
     1181       FOR EACH obj-list WHERE
     1182               obj-list.obj-type = 'маг':U NO-LOCK :
     1183         FOR EACH buf_inkas NO-LOCK WHERE
     1184                 buf_inkas.obj-type = obj-list.obj-type AND
     1185                 buf_inkas.obj-code = obj-list.obj-code AND
     1186                 buf_inkas.status_ = 'факт':U AND
     1187                 (
     1188                 buf_inkas.shift-date >= X-date-start AND
     1189                 buf_inkas.shift-date <= X-date-end):
     1190           IF X-Radio-Task = 3 AND
     1191           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1192             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1193           IF X-Radio-Task = 4 AND
     1194           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1195           found = yes.
     1196           return.
     1197         END.
     1198     END.
     1199     END.
     1200     WHEN NO THEN DO:
     1201       FOR EACH obj-list WHERE
     1202               obj-list.obj-type = 'маг':U NO-LOCK :
     1203         FOR EACH buf_inkas NO-LOCK WHERE
     1204                 buf_inkas.obj-type = obj-list.obj-type AND
     1205                 buf_inkas.obj-code = obj-list.obj-code AND
     1206                 buf_inkas.status_ = 'факт':U AND
     1207                 buf_inkas.doc-date >= X-date-start AND
     1208                 buf_inkas.doc-date <= X-date-end :
     1209            found = yes.
     1210            return.
     1211         END.
     1212       END.
     1213     END.
     1214   END CASE.
     1215   END PROCEDURE.
     1216   PROCEDURE no-benq-i-office.
     1217   DEFINE OUTPUT PARAMETER found as logical init no.
     1218   define buffer buf_sale-doc for ub.sale-doc.
     1219   CASE X-Radio-Task > 1:
     1220     WHEN YES then do:
     1221       FOR EACH obj-list WHERE
     1222               obj-list.obj-type = 'маг':U NO-LOCK :
     1223         FOR EACH buf_sale-doc NO-LOCK WHERE
     1224                  buf_Sale-doc.obj-type = obj-list.obj-type
     1225              AND buf_sale-doc.obj-code = obj-list.obj-code
     1226              AND buf_sale-doc.status_ = 'факт':U
     1227              AND buf_sale-doc.chr-office = 'у':U
     1228              AND (
     1229                 buf_sale-doc.shift-date >= X-date-start
     1230                 AND
     1231                 buf_sale-doc.shift-date <= X-date-end):
     1232           IF X-Radio-Task = 3 AND
     1233           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1234             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1235           IF X-Radio-Task = 4 AND
     1236           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1237           found = yes.
     1238           return.
     1239         END.
     1240       END.
     1241     END.
     1242     WHEN NO THEN DO:
     1243       FOR EACH obj-list WHERE
     1244               obj-list.obj-type = 'маг':U NO-LOCK :
     1245         FOR EACH buf_sale-doc NO-LOCK WHERE
     1246                 buf_sale-doc.obj-type = obj-list.obj-type
     1247            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1248            AND  buf_sale-doc.status_ = 'факт':U
     1249            AND  buf_sale-doc.chr-office = 'у':U
     1250            AND  buf_sale-doc.doc-date >= X-date-start
     1251            AND  buf_sale-doc.doc-date <= X-date-end :
     1252           found = yes.
     1253           return.
     1254         END.
     1255       END.
     1256     END.
     1257   END CASE.
     1258   END PROCEDURE.
     1259   define temp-table benefits no-undo
     1260       field obj-code like ub.chk-doc.obj-code
     1261       field dcpc as decimal format "->9%"
     1262       field tot-doc like ub.inkas.tot-doc
     1263       field netto like ub.inkas.netto
     1264       field num-chk like ub.inkas.num-chk
     1265       field discnt    like ub.inkas.discnt
     1266       INDEX pi IS PRIMARY obj-code dcpc
     1267       .
     1268   FOR EACH benefits:
     1269       delete benefits.
     1270   END.
     1271   run waitfram-show in this-procedure ("Ждите...").
     1272   run no-benqi(OUTPUT Notinc).
     1273   FIND obj-list No-LOCK NO-ERROR.
     1274   IF NOT AVAIL obj-list then do:
     1275     multi-obj = yes.
     1276   end.
     1277   FOR EACH obj-list No-LOCK:
     1278   _chk-gds:
     1279     FOR EACH buf_chk-doc No-LOCK WHERE
     1280              buf_chk-doc.obj-type = obj-list.obj-type AND
     1281              buf_chk-doc.obj-code = obj-list.obj-code AND
     1282              buf_chk-doc.out-code <> ? AND
     1283              buf_chk-doc.chk-date >= X-date-start AND
     1284              buf_chk-doc.chk-date <= X-date-end:
     1285       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1286       ACCUMULATE buf_chk-doc.doc-code (COUNT).
     1287       IF (ACCUM COUNT buf_chk-doc.doc-code) MODULO 50 = 0 then
     1288       run waitfram-show in this-procedure ("Ждите..." + "Обработано " +
     1289                      string(ACCUM COUNT buf_chk-doc.doc-code) + " чеков").
     1290       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1291       v-dopd = (if buf_chk-doc.tot-doc = 0
     1292                 then 100
     1293                 else ROUND(buf_chk-doc.discnt / buf_chk-doc.tot-doc * 100, 0)).
     1294       FIND FIRST benefits WHERE
     1295                  benefits.dcpc = v-dopd  No-ERROR.
     1296       IF NOT avail benefits then do:
     1297         create benefits.
     1298         assign
     1299         benefits.dcpc =  v-dopd
     1300         benefits.tot-doc = buf_chk-doc.tot-doc
     1301         benefits.discnt = buf_chk-doc.discnt
     1302         benefits.netto = buf_chk-doc.netto
     1303         benefits.obj-code = buf_chk-doc.obj-code
     1304         .
     1305       end.
     1306       assign
     1307       benefits.num-chk = benefits.num-chk + 1
     1308       .
     1309     END.
     1310   END.
     1311   run waitfram-hide in this-procedure .
     1312   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   define variable ReportFileName as character no-undo initial "report".
     1314   define variable was_OK_opened  as logical   no-undo.
     1315   system-dialog get-file          ReportFileName
     1316                 title             "Укажите путь"
     1317                 filters           "Текстовый файл (*.txt)" "*.txt"
     1318                 ask-overwrite
     1319                 create-test-file
     1320                 save-as
     1321                 use-filename
     1322                 default-extension "txt"
     1323                 update            was_OK_opened.
     1324   if was_OK_opened <> yes then do: return "Cancel". end.
     1325   assign ReportFileName = trim( string( ReportFileName ) ).
     1326   output stream PrnLibStream to value ( ReportFileName ) page-size 0  .
     1327   PUT stream PrnLibStream UNFORMATTED
     1328   space(20)
     1329   "Отчет по процентам скидки чеков" skip
     1330    space(23) str1 skip(0)
     1331    space(20) ( if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " " ) format "x(40)" skip.
     1332   PUT Stream PrnLibStream UNFORMATTED
     1333   "Число чеков" p-XL-delim
     1334   "Сумма брутто" p-XL-delim
     1335   "Сумма нетто" p-XL-delim
     1336   "Сумма скидки"
     1337   SKIP.
     1338   FOR EACH benefits NO-LOCK
     1339       BREAK
     1340       BY BENEFITS.OBJ-CODE
     1341       BY BENEFITS.DCPC:
     1342       IF FIRST-OF(BENEFITS.OBj-CODE) THEN DO:
     1343         FIND FIRST buf_clients NO-LOCK WHERE
     1344                    buf_clients.obj-type = 'маг':U AND
     1345                    buf_clients.obj-code = benefits.obj-code No-ERROR.
     1346         PUT Stream PrnLibStream UNFORMATTED
     1347         (IF AVAIL buf_clients
     1348          then buf_clients.obj-name
     1349          else ("Магазин N " + string(benefits.obj-code))
     1350         )
     1351         SKIP.
     1352       END.
     1353       IF FIRST-OF(BENEFITS.dcpc) THEN DO:
     1354         PUT Stream PrnLibStream UNFORMATTED
     1355         ("Скидка " + string(BENEFITS.dcpc, "->9%"))
     1356         SKIP.
     1357       END.
     1358       PUT Stream PrnLibStream UNFORMATTED
     1359       BENEFITS.num-chk  p-XL-delim
     1360       BENEFITS.tot-doc p-XL-delim
     1361       BENEFITS.NETTO p-XL-delim
     1362       BENEFITS.DISCNT
     1363       SKIP.
     1364       ACCUMULATE
     1365       BENEFITS.num-chk (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc)
     1366       BENEFITS.tot-doc (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc)
     1367       BENEFITS.netto (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc)
     1368       BENEFITS.discnt (TOTAL BY BENEFITS.obj-code By BENEFITS.dcpc)
     1369       .
     1370       IF LAST-OF(BENEFITS.dcpc) THEN DO:
     1371         PUT Stream PrnLibStream UNFORMATTED
     1372         ("ИТОГО: (" + string(BENEFITS.dcpc, "->9%") + ")") p-XL-delim
     1373         ACCUM TOTAL BY BENEFITS.dcpc BENEFITS.num-chk p-XL-delim
     1374         ACCUM TOTAL BY BENEFITS.dcpc BENEFITS.tot-doc p-XL-delim
     1375         ACCUM TOTAL BY BENEFITS.dcpc BENEFITS.NETTo p-XL-delim
     1376         ACCUM TOTAL BY BENEFITS.dcpc BENEFITS.DISCNT
     1377         SKIP.
     1378       END.
     1379       IF Multi-obj AND LAST-OF(BENEFITS.OBJ-CODE) THEN DO:
     1380         PUT Stream PrnLibStream UNFORMATTED
     1381         ("ИТОГО ПО МАГАЗИНУ " + string(BENEFITS.OBJ-CODE)) p-XL-delim
     1382         ACCUM TOTAL BY BENEFITS.obj-code BENEFITS.num-chk p-XL-delim
     1383         ACCUM TOTAL BY BENEFITS.obj-code BENEFITS.tot-doc p-XL-delim
     1384         ACCUM TOTAL BY BENEFITS.obj-code BENEFITS.NETTo p-XL-delim
     1385         ACCUM TOTAL BY BENEFITS.obj-code BENEFITS.DISCNT
     1386         SKIP.
     1387       END.
     1388       IF LAST(BENEFITS.OBJ-CODE) THEN DO:
     1389         PUT Stream PrnLibStream UNFORMATTED
     1390         "ИТОГО ПО ВСЕМ " p-XL-delim
     1391         ACCUM TOTAL BENEFITS.num-chk p-XL-delim
     1392         ACCUM TOTAL BENEFITS.tot-doc p-XL-delim
     1393         ACCUM TOTAL BENEFITS.NETTo p-XL-delim
     1394         ACCUM TOTAL BENEFITS.DISCNT
     1395         SKIP.
     1396       END.
     1397   END.
     1398   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1399   output stream PrnLibStream CLOSE.
     1400   message "Отчет выведен в файл:" SKIP
     1401                   ReportFileName
     1402                   view-as alert-box INFORMATION buttons OK TITLE " ".
     1403   run waitfram-hide in this-procedure .
