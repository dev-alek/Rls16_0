     1924   def
     1925   new shared
     1926   temp-table  obj-list no-undo
     1927     field obj-type like ub.clients.obj-type
     1928     field obj-code like ub.clients.obj-code
     1929     field obj-name like ub.clients.obj-name
     1930     field obj-id   as integer
     1931     field db-num   as integer
     1932     index pi is primary unique obj-id
     1933     index ie1 obj-type obj-code
     1934     index ie2 obj-name
     1935   .
     1936   procedure create_obj-list :
     1937      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1938      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1939      do
     1940      on error undo, return error return-value
     1941      :
     1942         define buffer cli-obj for ub.clients .
     1943         define variable p-var as integer no-undo .
     1944         define buffer buf_obj-list for obj-list .
     1945         find last buf_obj-list  use-index pi no-error .
     1946         if available buf_obj-list
     1947         then
     1948            p-var = buf_obj-list.obj-id + 1.
     1949         else
     1950            p-var = 1.
     1951         find first cli-obj where
     1952                   cli-obj.obj-type = p-obj-type
     1953               and cli-obj.obj-code = p-obj-code
     1954         no-lock no-error.
     1955         if available cli-obj
     1956         then do:
     1957            create buf_obj-list.
     1958            assign
     1959               buf_obj-list.obj-id   = p-var
     1960               buf_obj-list.obj-code = cli-obj.obj-code
     1961               buf_obj-list.obj-type = cli-obj.obj-type
     1962               buf_obj-list.obj-name = cli-obj.obj-name
     1963               buf_obj-list.db-num   = cli-obj.db-num
     1964            .
     1965         end.
     1966      end.
     1967   end.
     1968     assign
     1969     is-edoc-nn-doc = status-is-edoc-nn ( input is-edoc-nn
     1970                                         , input loc-cli-type
     1971                                         , input loc-cli-code
     1972                                         , input loc-store-type
     1973                                         , input loc-store-code
     1974                                         ) .
     1975     assign
     1976     is-edi-doc = status-is-edi ( input is-edi
     1977                                 , input loc-cli-type
     1978                                 , input loc-cli-code
     1979                                 , input loc-store-type
     1980                                 , input loc-store-code
     1981                                 , output v-dm-edi
     1982                                 ) .
     1983   function rvs-qnty returns decimal
     1984   ( input p-gds-code as integer    ,
     1985     input p-pl-code as integer  ) .
     1986      for each ub.rvs-line no-lock  WHERE
     1987               ub.rvs-line.gds-code = p-gds-code and
     1988               ub.rvs-line.pl-code = ub.place.pl-code ,
     1989         first ub.rvs-doc no-lock where
     1990               ub.rvs-doc.rvs-code = ub.rvs-line.rvs-code and
     1991               ub.rvs-doc.status_ = 'факт':U
     1992               break
     1993               by ub.rvs-doc.fact-order desc :
     1994            return ub.rvs-line.state-measure-qnty .
     1995       end.
     1996       return 0 .
     1997   end function.
