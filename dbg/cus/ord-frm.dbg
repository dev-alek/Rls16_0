     2883         tmp#zakaz.cli-qnty when parcli-qnty-input = false
     2884         tmp#zakaz.price-base
     2885         tmp#zakaz.price-rubl when parbase-price-input = false
     2886         tmp#zakaz.price-cli  when parprice-cli-input  = false
     2887         tmp#zakaz.road-tax   when partax-3-input = false
     2888         tmp#zakaz.cli-base-rate  when parcli-base-rate-input = false
     2889         tmp#zakaz.unit-cli when parcli-base-rate-input = false
     2890         r-units when parcli-base-rate-input = false
     2891        with frame Dialog-Frame .
     2892    if loc-doc-type = 'ОФ':U  Then do:
     2893       display
     2894           tmp#zakaz.qnty
     2895           tmp#zakaz.cli-qnty
     2896           tmp#zakaz.unit-cli
     2897           tmp#zakaz.cli-base-rate
     2898           with frame Dialog-Frame .
     2899           hide     tmp#zakaz.price-rubl        tmp#zakaz.price-base in frame Dialog-Frame .
     2900         end.
     2901         else do:
     2902         display
     2903               tmp#zakaz.qnty
     2904               tmp#zakaz.cli-qnty
     2905               tmp#zakaz.price-rubl
     2906               tmp#zakaz.price-base
     2907               tmp#zakaz.price-cli
     2908               tmp#zakaz.sum-rubl
     2909               tmp#zakaz.sum-base
     2910               tmp#zakaz.sum-cli
     2911               tmp#zakaz.sum-excise
     2912               tmp#zakaz.sum-other-base
     2913               tmp#zakaz.sum-other-rubl
     2914               tmp#zakaz.sum-road-tax
     2915               tmp#zakaz.sum-transport-base
     2916               tmp#zakaz.sum-transport-rubl
     2917               tmp#zakaz.unit-cli
     2918               tmp#zakaz.cli-base-rate
     2919               tmp#zakaz.sum-vat
     2920               tmp#zakaz.sum-slt
     2921               tmp#zakaz.vat-pc
     2922               tmp#zakaz.slt-pc
     2923         with frame Dialog-Frame .
     2924         end.
     2925         Hide tot-cli  tot-rubl tot-base in FRAME Dialog-Frame.
     2926     run edoc-nn-proc in this-procedure .
     2927    end.
     2928   end procedure.
     2929   PROCEDURE apply-focus-next-entry :
     2930   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2931     define input parameter p-widget-handle as handle no-undo .
     2932     do with frame Dialog-Frame :
     2933         if tmp#zakaz.cli-qnty :handle = p-widget-handle then do:
     2934            if tmp#zakaz.cli-base-rate:sensitive then
     2935               apply "entry":u to tmp#zakaz.cli-base-rate   in frame Dialog-Frame .
     2936            if tmp#zakaz.price-cli:sensitive then
     2937               apply "entry":u to tmp#zakaz.price-cli   in frame Dialog-Frame .
     2938            if tmp#zakaz.price-rubl:sensitive then
     2939               apply "entry":u to tmp#zakaz.price-rubl  in frame Dialog-Frame .
     2940            if tmp#zakaz.price-base:sensitive then
     2941               apply "entry":u to tmp#zakaz.price-base  in frame Dialog-Frame .
     2942            end.
     2943         if tmp#zakaz.qnty :handle = p-widget-handle then  do:
     2944            if tmp#zakaz.cli-base-rate:sensitive then
     2945               apply "entry":u to tmp#zakaz.cli-base-rate   in frame Dialog-Frame .
     2946            if tmp#zakaz.price-rubl:sensitive then
     2947               apply "entry":u to tmp#zakaz.price-rubl  in frame Dialog-Frame .
     2948            if tmp#zakaz.price-base:sensitive then
     2949               apply "entry":u to tmp#zakaz.price-base  in frame Dialog-Frame .
     2950            if tmp#zakaz.price-cli:sensitive  then
     2951               apply "entry":u to tmp#zakaz.price-cli   in frame Dialog-Frame .
     2952            end.
     2953     end.
     2954   end.
     2955   END PROCEDURE.
     2956   ON  RETURN OF tmp#zakaz.cli-qnty IN FRAME  Dialog-Frame
     2957   DO:
     2958     run apply-focus-next-entry in this-procedure  (input  tmp#zakaz.cli-qnty :handle ) .
     2959     return no-apply .
     2960   END.
     2961   ON  RETURN OF tmp#zakaz.qnty IN FRAME  Dialog-Frame
     2962   DO:
     2963     run apply-focus-next-entry in this-procedure  (input  tmp#zakaz.qnty :handle ) .
     2964     return no-apply .
     2965   END.
     2966   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2967   on help of frame Dialog-Frame
     2968   do:
     2969     run gbl/app_help.p
     2970       (input this-procedure :file-name
     2971       ,input ''
     2972       ,input ?
     2973       ) no-error.
     2974     if error-status :error then do:
     2975       message
     2976         "Ошибка при вызове помощи"
     2977         error-status :get-message(1)
     2978         view-as alert-box .
     2979     end.
     2980   end.
     2981   run minbtn-set in this-procedure .
     2982   on choose of b-help in frame Dialog-Frame
     2983   do:
     2984     apply "help":u to frame Dialog-Frame .
     2985   end.
     2986   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2987   procedure minbtn-set :
     2988       do
     2989           on error undo, return error return-value
     2990           :
     2991           define variable ii              as integer       no-undo .
     2992           define variable fh              as widget-handle no-undo .
     2993           define variable hh              as widget-handle no-undo .
     2994           define variable v-h             as handle        extent 4 no-undo .
     2995           define variable v-name-button   as character     no-undo .
     2996           define variable v-help-old-x    as decimal       no-undo .
     2997           define variable v-help-old-y    as decimal       no-undo .
     2998           define variable v-help-old-size as decimal       no-undo .
     2999           define variable v-frame-width   as decimal       no-undo .
     3000           define variable jj              as integer       no-undo .
     3001           do
     3002               on error undo, return error
     3003               :
     3004               assign
     3005                   v-frame-width = frame Dialog-Frame:width - 0.3
     3006                   fh            = frame Dialog-Frame:first-child
     3007                   hh            = fh:first-child
     3008                   ii            = 1
     3009                   .
     3010               do while valid-handle(hh):
     3011                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3012                   do:
     3013                       case lc(hh:name) :
     3014                           when "b-help" then
     3015                               do:
     3016                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3017                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3018                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3019                                   hh:TOOLTIP = "Помощь" .
     3020                                   v-help-old-x = hh:column .
     3021                                   v-help-old-y = hh:row    .
     3022                                   v-help-old-size = hh:width .
     3023                                   hh:width-chars = 2.5 .
     3024                               end.
     3025                           when "b-print" then
     3026                               do:
     3027                                   hh:load-image("cmp/b-print.bmp":u) .
     3028                                   hh:TOOLTIP = "Печать" .
     3029                                   v-h[ii] = hh:handle .
     3030                                   ii = ii + 1 .
     3031                                   hh:width-chars = 3 .
     3032                               end.
     3033                           when "b-history" or
     3034                           when "b-hist" then
     3035                               do:
     3036                                   hh:load-image("cmp/b-hist.bmp":u) .
     3037                                   hh:TOOLTIP = "История" .
     3038                                   v-h[ii] = hh:handle .
     3039                                   ii = ii + 1 .
     3040                                   hh:width-chars = 3 .
     3041                               end.
     3042                           when "b-sch" then
     3043                               do:
     3044                                   hh:load-image("cmp/b-sch.bmp":u) .
     3045                                   hh:TOOLTIP = "Установка Фильтра" .
     3046                                   v-h[ii] = hh:handle .
     3047                                   ii = ii + 1 .
     3048                                   hh:width-chars = 3 .
     3049                               end.
     3050                           when "b-hist-user" then
     3051                               do:
     3052                                   hh:load-image("cmp/b-hist.bmp":u) .
     3053                                   hh:TOOLTIP = "История пользователя" .
     3054                                   ii = ii + 1 .
     3055                               end.
     3056                       end case.
     3057                   end.
     3058                   hh = hh:next-sibling.
     3059               end.
     3060               b-help:column = v-frame-width - b-help:width-chars.
     3061               jj = 0.
     3062               repeat ii = 4 to 1 by -1 :
     3063                   if valid-handle (v-h[ii] ) then
     3064                   do:
     3065                       jj  = jj + 1 .
     3066                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3067                       v-h[ii]:row    = v-help-old-y .
     3068                   end.
     3069               end.
     3070           end.
     3071       end.
     3072   end procedure.
     3073   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3074   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3075   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3076   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3077   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3078   define variable v-diasize-current-frame-height as decimal   no-undo .
     3079   define variable v-diasize-change-size          as logical   no-undo .
     3080   define variable v-diasize-resize-button        as handle    no-undo .
     3081   define variable v-diasize-wndmax               as logical   no-undo .
     3082   define variable v-diasize-wndstore             as logical   no-undo .
     3083   define variable v-diasize-proc-name            as character no-undo .
     3084   define variable v-diasize-browse-handle        as handle    no-undo .
     3085   define variable v-diasize-browse-number        as integer   no-undo .
     3086   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3087   define temp-table temp-diasize-handle no-undo
     3088     field handle-value  as handle
     3089     field save-position as decimal
     3090     index xpk is primary unique handle-value
     3091     .
     3092   define temp-table temp-browse-handle no-undo
     3093     field browse-type   as character
     3094     field browse-number as integer
     3095     field browse-handle as handle
     3096     field original-size as decimal
     3097     index xpk is primary unique browse-type browse-number
     3098     index xie browse-type browse-handle
     3099   .
     3100   procedure diasize_change-height :
     3101     define input  parameter p-change-value  as decimal   no-undo .
     3102     define input  parameter p-move-resize   as logical   no-undo .
     3103     define variable v-field-group-handle    as handle    no-undo .
     3104     define variable v-object-handle         as handle    no-undo .
     3105     define variable v-frame-height          as decimal   no-undo .
     3106     define variable v-frame-virtual-height  as decimal   no-undo .
     3107     define variable v-browse-height         as decimal   no-undo .
     3108     define variable v-window-height         as decimal   no-undo .
     3109     define variable v-window-virtual-height as decimal   no-undo .
     3110     define variable v-change-sign           as integer   no-undo .
     3111     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3112     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3113     if p-change-value > 0
     3114     then do:
     3115       if frame Dialog-Frame :height + p-change-value
     3116           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3117       then do:
     3118         assign
     3119           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3120                           - (frame Dialog-Frame :height-chars)
     3121         .
     3122         if p-change-value <= 0
     3123         then do:
     3124           run diasize_position-resize-button in this-procedure .
     3125           return .
     3126         end.
     3127       end.
     3128     end.
     3129     if p-change-value < 0
     3130     then do:
     3131       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3132       then do:
     3133         assign
     3134           p-change-value = v-diasize-orig-frame-height
     3135                          - (frame Dialog-Frame :height-chars)
     3136         .
     3137         if p-change-value >= 0
     3138         then do:
     3139           run diasize_position-resize-button in this-procedure .
     3140           return .
     3141         end.
     3142       end.
     3143     end.
     3144     if p-change-value >= 0
     3145     then do:
     3146       assign
     3147         v-change-sign = 1
     3148       .
     3149     end.
     3150     else do:
     3151       assign
     3152         v-change-sign = -1
     3153       .
     3154     end.
     3155     assign
     3156       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3157     .
     3158     if p-change-value = 0
     3159     then do:
     3160       run diasize_position-resize-button in this-procedure .
     3161       return .
     3162     end.
     3163     move_block:
     3164     do
     3165     on error undo move_block, retry move_block
     3166     :
     3167       if retry
     3168       then do:
     3169         do
     3170         on error undo move_block, leave move_block
     3171         :
     3172           if p-change-value > 0
     3173           then do:
     3174             for each buf_temp-diasize-handle
     3175             on error undo, next
     3176             :
     3177               assign
     3178                 v-object-handle = buf_temp-diasize-handle.handle-value
     3179               .
     3180               if v-object-handle <> v-diasize-resize-button
     3181               then do:
     3182                 assign
     3183                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3184                 .
     3185               end.
     3186             end.
     3187             assign
     3188               v-diasize-browse-handle :height = v-browse-height
     3189             .
     3190             for each buf_temp-browse-handle
     3191               where buf_temp-browse-handle.browse-type = 'height':u
     3192             on error undo, next
     3193             :
     3194               assign
     3195                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3196               .
     3197             end.
     3198             assign
     3199               frame Dialog-Frame :height = v-frame-height
     3200             .
     3201             if frame Dialog-Frame :scrollable = true
     3202             then do:
     3203               assign
     3204                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3205               .
     3206             end.
     3207             run diasize_position-resize-button in this-procedure .
     3208           end.
     3209           else do:
     3210             if frame Dialog-Frame :scrollable = true
     3211             then do:
     3212               assign
     3213                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3214               .
     3215             end.
     3216             assign
     3217               frame Dialog-Frame :height = v-frame-height
     3218             .
     3219             assign
     3220               v-diasize-browse-handle :height = v-browse-height
     3221             .
     3222             for each buf_temp-browse-handle
     3223               where buf_temp-browse-handle.browse-type = 'height':u
     3224             on error undo, next
     3225             :
     3226               assign
     3227                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3228               .
     3229             end.
     3230             for each buf_temp-diasize-handle
     3231             on error undo, next
     3232             :
     3233               assign
     3234                 v-object-handle = buf_temp-diasize-handle.handle-value
     3235               .
     3236               if v-object-handle <> v-diasize-resize-button
     3237               then do:
     3238                 assign
     3239                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3240                 .
     3241               end.
     3242             end.
     3243             run diasize_position-resize-button in this-procedure .
     3244           end.
     3245           assign
     3246             v-diasize-change-size = false
     3247           .
     3248           leave move_block .
     3249         end.
     3250       end.
     3251       assign
     3252         v-diasize-need-full-display = true
     3253       .
     3254       if v-diasize-change-size = false
     3255       then do:
     3256         assign
     3257           v-diasize-change-size = true
     3258         .
     3259       end.
     3260       else do:
     3261         return .
     3262       end.
     3263       assign
     3264         v-frame-height = frame Dialog-Frame :height
     3265         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3266         v-browse-height = v-diasize-browse-handle :height
     3267       .
     3268       for each buf_temp-browse-handle
     3269         where buf_temp-browse-handle.browse-type = 'height':u
     3270       :
     3271         assign
     3272           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3273         .
     3274       end.
     3275       for each buf_temp-diasize-handle
     3276       :
     3277         delete buf_temp-diasize-handle .
     3278       end.
     3279       assign
     3280         v-field-group-handle = frame Dialog-Frame :first-child
     3281       .
     3282       do while valid-handle(v-field-group-handle)
     3283       :
     3284         assign
     3285           v-object-handle = v-field-group-handle :first-child
     3286         .
     3287         do while valid-handle(v-object-handle)
     3288         :
     3289           if  v-object-handle <> v-diasize-browse-handle :handle
     3290           and can-query(v-object-handle, "row")
     3291           and can-query(v-object-handle, "height")
     3292           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3293           then do:
     3294             find first buf_temp-browse-handle
     3295               where buf_temp-browse-handle.browse-type   = 'height':u
     3296                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3297               no-error .
     3298             if available buf_temp-browse-handle
     3299             then do:
     3300             end.
     3301             else do:
     3302               create buf_temp-diasize-handle .
     3303               assign
     3304                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3305                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3306               .
     3307             end.
     3308           end.
     3309           assign
     3310             v-object-handle = v-object-handle :next-sibling
     3311           .
     3312         end.
     3313         assign
     3314           v-field-group-handle = v-field-group-handle :next-sibling
     3315         .
     3316       end.
     3317       do with frame Dialog-Frame
     3318       :
     3319         hide v-diasize-resize-button .
     3320         assign
     3321           v-diasize-resize-button :row    = 1
     3322           v-diasize-resize-button :column = 1
     3323         .
     3324       end.
     3325       if p-change-value > 0
     3326       then do:
     3327         if frame Dialog-Frame :scrollable = true
     3328         then do:
     3329           assign
     3330             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3331             no-error .
     3332           if error-status :error
     3333           or error-status :get-message(1) <> ""
     3334           then do:
     3335             undo move_block, retry move_block .
     3336           end.
     3337         end.
     3338         assign
     3339           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3340           no-error .
     3341         if error-status :error
     3342         or error-status :get-message(1) <> ""
     3343         then do:
     3344           undo move_block, retry move_block .
     3345         end.
     3346         assign
     3347           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3348           no-error .
     3349         if error-status :error
     3350         or error-status :get-message(1) <> ""
     3351         then do:
     3352           undo move_block, retry move_block .
     3353         end.
     3354         for each buf_temp-browse-handle
     3355           where buf_temp-browse-handle.browse-type = 'height':u
     3356         on error undo move_block, retry move_block
     3357         :
     3358           assign
     3359             buf_temp-browse-handle.browse-handle :height
     3360               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3361             no-error .
     3362           if error-status :error
     3363           or error-status :get-message(1) <> ""
     3364           then do:
     3365             undo move_block, retry move_block .
     3366           end.
     3367         end.
     3368         for each buf_temp-diasize-handle
     3369         on error undo move_block, retry move_block
     3370         :
     3371           assign
     3372             v-object-handle = buf_temp-diasize-handle.handle-value
     3373           .
     3374           if v-object-handle <> v-diasize-resize-button
     3375           then do:
     3376             assign
     3377               v-object-handle :row = v-object-handle :row + p-change-value
     3378               no-error .
     3379             if error-status :error
     3380             or error-status :get-message(1) <> ""
     3381             then do:
     3382               undo move_block, retry move_block .
     3383             end.
     3384           end.
     3385         end.
     3386       end.
     3387       else do:
     3388         for each buf_temp-diasize-handle
     3389         on error undo move_block, retry move_block
     3390         :
     3391           assign
     3392             v-object-handle = buf_temp-diasize-handle.handle-value
     3393           .
     3394           if v-object-handle <> v-diasize-resize-button
     3395           then do:
     3396             assign
     3397               v-object-handle :row = v-object-handle :row + p-change-value
     3398               no-error .
     3399             if error-status :error
     3400             or error-status :get-message(1) <> ""
     3401             then do:
     3402               undo move_block, retry move_block .
     3403             end.
     3404           end.
     3405         end.
     3406         assign
     3407           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3408           no-error .
     3409         if error-status :error
     3410         or error-status :get-message(1) <> ""
     3411         then do:
     3412           undo move_block, retry move_block .
     3413         end.
     3414         for each buf_temp-browse-handle
     3415           where buf_temp-browse-handle.browse-type = 'height':u
     3416         on error undo move_block, retry move_block
     3417         :
     3418           assign
     3419             buf_temp-browse-handle.browse-handle :height
     3420               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3421             no-error .
     3422           if error-status :error
     3423           or error-status :get-message(1) <> ""
     3424           then do:
     3425             undo move_block, retry move_block .
     3426           end.
     3427         end.
     3428         assign
     3429           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3430           no-error .
     3431         if error-status :error
     3432         or error-status :get-message(1) <> ""
     3433         then do:
     3434           undo move_block, retry move_block .
     3435         end.
     3436         if frame Dialog-Frame :scrollable = true
     3437         then do:
     3438           assign
     3439             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3440             no-error .
     3441           if error-status :error
     3442           or error-status :get-message(1) <> ""
     3443           then do:
     3444             undo move_block, retry move_block .
     3445           end.
     3446         end.
     3447       end.
     3448       if p-move-resize = true
     3449       then do:
     3450         run diasize_position-resize-button in this-procedure .
     3451       end.
     3452       if v-diasize-wndstore = true
     3453       then do:
     3454         if connected("ub") = true
     3455         then do:
     3456           define variable v-cntxt-db-num        as integer   no-undo .
     3457           define variable v-cntxt-userid        as character no-undo .
     3458           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3459                                             , OUTPUT v-cntxt-userid
     3460                                             ) .
     3461           run gbl/wndsizew.p
     3462             (input  v-cntxt-db-num
     3463             ,input  v-cntxt-userid
     3464             ,input  v-diasize-proc-name
     3465             ,input  'height':u
     3466             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3467             ) .
     3468         end.
     3469       end.
     3470     end.
     3471     assign
     3472       v-diasize-change-size = false
     3473     .
     3474   end procedure.
     3475   procedure diasize_set-height :
     3476     define input  parameter p-new-height  as decimal   no-undo .
     3477     define input  parameter p-move-resize as logical   no-undo .
     3478     do
     3479     on error undo, return error return-value
     3480     :
     3481       run diasize_change-height in this-procedure
     3482         (input  (p-new-height - frame Dialog-Frame :height)
     3483         ,input  p-move-resize
     3484         ) .
     3485     end.
     3486   end procedure.
     3487   procedure diasize_change-width :
     3488     define input  parameter p-change-value as decimal   no-undo .
     3489     define input  parameter p-move-resize  as logical   no-undo .
     3490     define variable v-field-group-handle   as handle    no-undo .
     3491     define variable v-object-handle        as handle    no-undo .
     3492     define variable v-frame-width          as decimal   no-undo .
     3493     define variable v-frame-virtual-width  as decimal   no-undo .
     3494     define variable v-browse-width         as decimal   no-undo .
     3495     define variable v-window-width         as decimal   no-undo .
     3496     define variable v-window-virtual-width as decimal   no-undo .
     3497     define variable v-change-sign          as integer   no-undo .
     3498     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3499     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3500     if p-change-value > 0
     3501     then do:
     3502       if frame Dialog-Frame :width + p-change-value >
     3503           session :width-chars
     3504       then do:
     3505         assign
     3506           p-change-value = session :width-chars - frame Dialog-Frame :width
     3507         .
     3508         if p-change-value <= 0
     3509         then do:
     3510           run diasize_position-resize-button in this-procedure .
     3511           return .
     3512         end.
     3513       end.
     3514     end.
     3515     if p-change-value < 0
     3516     then do:
     3517       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3518       then do:
     3519         assign
     3520           p-change-value = v-diasize-orig-frame-width
     3521                          - frame Dialog-Frame :width
     3522         .
     3523         if p-change-value >= 0
     3524         then do:
     3525           run diasize_position-resize-button in this-procedure .
     3526           return .
     3527         end.
     3528       end.
     3529     end.
     3530     if p-change-value >= 0
     3531     then do:
     3532       assign
     3533         v-change-sign = 1
     3534       .
     3535     end.
     3536     else do:
     3537       assign
     3538         v-change-sign = -1
     3539       .
     3540     end.
     3541     assign
     3542       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3543     .
     3544     if p-change-value = 0
     3545     then do:
     3546       run diasize_position-resize-button in this-procedure .
     3547       return .
     3548     end.
     3549     move_block:
     3550     do
     3551     on error undo move_block, leave move_block
     3552     :
     3553       if retry
     3554       then do:
     3555         do
     3556         on error undo move_block, leave move_block
     3557         :
     3558           if p-change-value > 0
     3559           then do:
     3560             for each buf_temp-diasize-handle
     3561             on error undo, next
     3562             :
     3563               assign
     3564                 v-object-handle = buf_temp-diasize-handle.handle-value
     3565               .
     3566               if v-object-handle <> v-diasize-resize-button
     3567               then do:
     3568                 assign
     3569                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3570                 .
     3571               end.
     3572             end.
     3573             assign
     3574               v-diasize-browse-handle :width = v-browse-width
     3575             .
     3576             for each buf_temp-browse-handle
     3577               where buf_temp-browse-handle.browse-type = 'width':u
     3578             on error undo, next
     3579             :
     3580               assign
     3581                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3582               .
     3583             end.
     3584             assign
     3585               frame Dialog-Frame :width = v-frame-width
     3586             .
     3587             if frame Dialog-Frame :scrollable = true
     3588             then do:
     3589               assign
     3590                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3591               .
     3592             end.
     3593             run diasize_position-resize-button in this-procedure .
     3594           end.
     3595           else do:
     3596             if frame Dialog-Frame :scrollable = true
     3597             then do:
     3598               assign
     3599                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3600               .
     3601             end.
     3602             assign
     3603               frame Dialog-Frame :width = v-frame-width
     3604             .
     3605             for each buf_temp-browse-handle
     3606               where buf_temp-browse-handle.browse-type = 'width':u
     3607             on error undo, next
     3608             :
     3609               assign
     3610                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3611               .
     3612             end.
     3613             assign
     3614               v-diasize-browse-handle :width = v-browse-width
     3615             .
     3616             for each buf_temp-diasize-handle
     3617             on error undo, next
     3618             :
     3619               assign
     3620                 v-object-handle = buf_temp-diasize-handle.handle-value
     3621               .
     3622               if v-object-handle <> v-diasize-resize-button
     3623               then do:
     3624                 assign
     3625                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3626                 .
     3627               end.
     3628             end.
     3629             run diasize_position-resize-button in this-procedure .
     3630           end.
     3631           assign
     3632             v-diasize-change-size = false
     3633           .
     3634           leave move_block .
     3635         end.
     3636       end.
     3637       assign
     3638         v-diasize-need-full-display = true
     3639       .
     3640       if v-diasize-change-size = false
     3641       then do:
     3642         assign
     3643           v-diasize-change-size = true
     3644         .
     3645       end.
     3646       else do:
     3647         return .
     3648       end.
     3649       assign
     3650         v-frame-width = frame Dialog-Frame :width
     3651         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3652         v-browse-width = v-diasize-browse-handle :width
     3653       .
     3654       for each buf_temp-browse-handle
     3655         where buf_temp-browse-handle.browse-type = 'width':u
     3656       :
     3657         assign
     3658           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3659         .
     3660       end.
     3661       for each buf_temp-diasize-handle
     3662       :
     3663         delete buf_temp-diasize-handle .
     3664       end.
     3665       assign
     3666         v-field-group-handle = frame Dialog-Frame :first-child
     3667       .
     3668       do while valid-handle(v-field-group-handle)
     3669       :
     3670         assign
     3671           v-object-handle = v-field-group-handle :first-child
     3672         .
     3673         do while valid-handle(v-object-handle)
     3674         :
     3675           if  v-object-handle <> v-diasize-browse-handle :handle
     3676           and v-object-handle <> v-diasize-resize-button
     3677           and can-query(v-object-handle, "row")
     3678           and can-query(v-object-handle, "height")
     3679           and ( v-object-handle :col + v-object-handle :width
     3680                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3681               )
     3682           then do:
     3683             find first buf_temp-browse-handle
     3684               where buf_temp-browse-handle.browse-type   = 'width':u
     3685                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3686               no-error .
     3687             if available buf_temp-browse-handle
     3688             then do:
     3689             end.
     3690             else do:
     3691               create buf_temp-diasize-handle .
     3692               assign
     3693                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3694                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3695               .
     3696             end.
     3697           end.
     3698           assign
     3699             v-object-handle = v-object-handle :next-sibling
     3700           .
     3701         end.
     3702         assign
     3703           v-field-group-handle = v-field-group-handle :next-sibling
     3704         .
     3705       end.
     3706       do with frame Dialog-Frame
     3707       :
     3708         hide v-diasize-resize-button .
     3709         v-diasize-resize-button :row = 1.
     3710         v-diasize-resize-button :column = 1.
     3711       end.
     3712       if p-change-value > 0
     3713       then do:
     3714         if frame Dialog-Frame :scrollable = true
     3715         then do:
     3716           assign
     3717             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3718             no-error .
     3719           if error-status :error
     3720           or error-status :get-message(1) <> ""
     3721           then do:
     3722             undo move_block, retry move_block.
     3723           end.
     3724         end.
     3725         assign
     3726           frame Dialog-Frame :width = v-frame-width + p-change-value
     3727           no-error .
     3728         if error-status :error
     3729         or error-status :get-message(1) <> ""
     3730         then do:
     3731           undo move_block, retry move_block.
     3732         end.
     3733         assign
     3734           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3735         no-error .
     3736         if error-status :error
     3737         or error-status :get-message(1) <> ""
     3738         then do:
     3739           undo move_block, retry move_block.
     3740         end.
     3741         for each buf_temp-browse-handle
     3742           where buf_temp-browse-handle.browse-type = 'width':u
     3743         on error undo move_block, retry move_block
     3744         :
     3745           assign
     3746             buf_temp-browse-handle.browse-handle :width
     3747               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3748             no-error .
     3749           if error-status :error
     3750           or error-status :get-message(1) <> ""
     3751           then do:
     3752             undo move_block, retry move_block .
     3753           end.
     3754         end.
     3755         for each buf_temp-diasize-handle
     3756         on error undo move_block, retry move_block
     3757         :
     3758           assign
     3759             v-object-handle = buf_temp-diasize-handle.handle-value
     3760           .
     3761           if v-object-handle <> v-diasize-resize-button
     3762           then do:
     3763             assign
     3764               v-object-handle :col = v-object-handle :col + p-change-value
     3765               no-error .
     3766             if error-status :error
     3767             or error-status :get-message(1) <> ""
     3768             then do:
     3769               undo move_block, retry move_block .
     3770             end.
     3771           end.
     3772         end.
     3773       end.
     3774       else do:
     3775         for each buf_temp-diasize-handle
     3776         on error undo move_block, retry move_block
     3777         :
     3778           assign
     3779             v-object-handle = buf_temp-diasize-handle.handle-value
     3780           .
     3781           if v-object-handle <> v-diasize-resize-button
     3782           then do:
     3783             assign
     3784               v-object-handle :col = v-object-handle :col + p-change-value
     3785               no-error .
     3786             if error-status :error
     3787             or error-status :get-message(1) <> ""
     3788             then do:
     3789               undo move_block, retry move_block .
     3790             end.
     3791           end.
     3792         end.
     3793         for each buf_temp-browse-handle
     3794           where buf_temp-browse-handle.browse-type = 'width':u
     3795         on error undo move_block, retry move_block
     3796         :
     3797           assign
     3798             buf_temp-browse-handle.browse-handle :width
     3799               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3800             no-error .
     3801           if error-status :error
     3802           or error-status :get-message(1) <> ""
     3803           then do:
     3804             undo move_block, retry move_block .
     3805           end.
     3806         end.
     3807         assign
     3808           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3809           no-error .
     3810         if error-status :error
     3811         or error-status :get-message(1) <> ""
     3812         then do:
     3813           undo move_block, retry move_block.
     3814         end.
     3815         assign
     3816           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3817         no-error .
     3818         if error-status :error
     3819         or error-status :get-message(1) <> ""
     3820         then do:
     3821           undo move_block, retry move_block.
     3822         end.
     3823         if frame Dialog-Frame :scrollable = true
     3824         then do:
     3825           assign
     3826             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3827           no-error .
     3828           if error-status :error
     3829           or error-status :get-message(1) <> ""
     3830           then do:
     3831             undo move_block, retry move_block.
     3832           end.
     3833         end.
     3834       end.
     3835       if p-move-resize
     3836       then do:
     3837         run diasize_position-resize-button in this-procedure .
     3838       end.
     3839       if v-diasize-wndstore = true
     3840       then do:
     3841         if connected("ub") = true
     3842         then do:
     3843           define variable v-cntxt-db-num        as integer   no-undo .
     3844           define variable v-cntxt-userid        as character no-undo .
     3845           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3846                                             , OUTPUT v-cntxt-userid
     3847                                             ) .
     3848           run gbl/wndsizew.p
     3849             (input  v-cntxt-db-num
     3850             ,input  v-cntxt-userid
     3851             ,input  v-diasize-proc-name
     3852             ,input  'width':u
     3853             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3854             ) .
     3855         end.
     3856       end.
     3857     end.
     3858     assign
     3859       v-diasize-change-size = false
     3860     .
     3861   end procedure.
     3862   procedure diasize_set-width :
     3863     define input  parameter p-new-width  as decimal   no-undo .
     3864     define input  parameter p-move-resize as logical   no-undo .
     3865     do
     3866     on error undo, return error return-value
     3867     :
     3868       run diasize_change-width in this-procedure
     3869         (input  (p-new-width - frame Dialog-Frame :width)
     3870         ,input  p-move-resize
     3871         ) .
     3872     end.
     3873   end procedure.
     3874   procedure diasize_position-resize-button :
     3875     do with frame Dialog-Frame
     3876     :
     3877       hide v-diasize-resize-button .
     3878       assign
     3879         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3880                     - 1
     3881                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3882         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3883                     - 1
     3884                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3885       .
     3886       view v-diasize-resize-button .
     3887     end.
     3888   end procedure.
     3889   on alt-right anywhere
     3890   do:
     3891     run diasize_change-width in this-procedure
     3892       (input 1
     3893       ,input true
     3894       ) .
     3895     return no-apply .
     3896   end.
     3897   on alt-left anywhere
     3898   do:
     3899     run diasize_change-width in this-procedure
     3900       (input -1
     3901       ,input true
     3902       ) .
     3903     return no-apply .
     3904   end.
     3905   on alt-down anywhere
     3906   do:
     3907     run diasize_change-height in this-procedure
     3908       (input 1
     3909       ,input true
     3910       ) .
     3911     return no-apply .
     3912   end.
     3913   on alt-up anywhere
     3914   do:
     3915     run diasize_change-height in this-procedure
     3916       (input -1
     3917       ,input true
     3918       ) .
     3919     return no-apply .
     3920   end.
     3921   on alt-enter of frame Dialog-Frame
     3922   do:
     3923     run diasize_maximize in this-procedure
     3924       (input  ?
     3925       ).
     3926     return no-apply .
     3927   end.
     3928   procedure diasize_end-move :
     3929     do
     3930     on error undo, return error return-value
     3931     :
     3932       define variable v-row-delta as decimal   no-undo .
     3933       define variable v-col-delta as decimal   no-undo .
     3934       define variable v-new-row as decimal   no-undo .
     3935       define variable v-new-col as decimal   no-undo .
     3936       assign
     3937         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3938         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3939       .
     3940       assign
     3941         v-row-delta = v-new-row - frame Dialog-Frame :height
     3942         v-col-delta = v-new-col - frame Dialog-Frame :width
     3943       .
     3944       run diasize_change-height in this-procedure
     3945         (input v-row-delta
     3946         ,input true
     3947         ) .
     3948       run diasize_change-width in this-procedure
     3949         (input v-col-delta
     3950         ,input true
     3951         ) .
     3952     end.
     3953   end procedure.
     3954   procedure diasize_maximize :
     3955     define input  parameter p-action as logical   no-undo .
     3956     do
     3957     on error undo, return error return-value
     3958     :
     3959       if p-action = ?
     3960       then do:
     3961         if v-diasize-need-maximize = true
     3962         then do:
     3963           assign
     3964             p-action = true
     3965           .
     3966         end.
     3967         else do:
     3968           assign
     3969             p-action = false
     3970           .
     3971         end.
     3972       end.
     3973       if p-action = true
     3974       then do:
     3975         run diasize_change-height in this-procedure
     3976           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3977               - frame Dialog-Frame :height-chars
     3978           ,input true
     3979           ) .
     3980         run diasize_change-width in this-procedure
     3981           (input session :width-chars
     3982               - frame Dialog-Frame :width-chars
     3983           ,input true
     3984           ) .
     3985         assign
     3986           v-diasize-need-maximize = false
     3987         .
     3988       end.
     3989       else do:
     3990         run diasize_change-width in this-procedure
     3991           (input v-diasize-orig-frame-width
     3992               - frame Dialog-Frame :width-chars
     3993           ,input true
     3994           ) .
     3995         run diasize_change-height in this-procedure
     3996           (input v-diasize-orig-frame-height
     3997               - frame Dialog-Frame :height-chars
     3998           ,input true
     3999           ) .
     4000         assign
     4001           v-diasize-need-maximize = true
     4002         .
     4003       end.
     4004     end.
     4005   end procedure.
     4006   procedure diasize_restore-orig-size :
     4007     do
     4008     on error undo, return error return-value
     4009     :
     4010       assign
     4011         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4012         v-diasize-current-frame-height = frame Dialog-Frame :height
     4013       .
     4014       run diasize_set-height in this-procedure
     4015         (input  v-diasize-orig-frame-height
     4016         ,input  true
     4017         ) .
     4018       run diasize_set-width in this-procedure
     4019         (input  v-diasize-orig-frame-width
     4020         ,input  true
     4021         ) .
     4022     end.
     4023   end procedure.
     4024   procedure diasize_restore-current-size :
     4025     do
     4026     on error undo, return error return-value
     4027     :
     4028       run diasize_set-height in this-procedure
     4029         (input  v-diasize-current-frame-height
     4030         ,input  true
     4031         ) .
     4032       run diasize_set-width in this-procedure
     4033         (input  v-diasize-current-frame-width
     4034         ,input  true
     4035         ) .
     4036     end.
     4037   end procedure.
     4038   procedure diasize_set-browse-handle :
     4039     define input  parameter p-browse-handle as handle   no-undo .
     4040     define buffer buf_temp-browse-handle for temp-browse-handle .
     4041     do
     4042     on error undo, return error return-value
     4043     :
     4044       assign
     4045         v-diasize-browse-handle = p-browse-handle
     4046       .
     4047       for each buf_temp-browse-handle
     4048       on error undo, return error return-value
     4049       :
     4050         delete buf_temp-browse-handle .
     4051       end.
     4052     end.
     4053   end procedure.
     4054   procedure diasize_add_browse :
     4055     define input  parameter p-browse-type   as character no-undo .
     4056     define input  parameter p-browse-handle as handle    no-undo .
     4057     define buffer buf_temp-browse-handle for temp-browse-handle .
     4058     do
     4059     on error undo, return error return-value
     4060     :
     4061       assign
     4062         v-diasize-browse-number = v-diasize-browse-number + 1
     4063       .
     4064       create buf_temp-browse-handle .
     4065       assign
     4066         buf_temp-browse-handle.browse-type   = p-browse-type
     4067         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4068         buf_temp-browse-handle.browse-handle = p-browse-handle
     4069       .
     4070     end.
     4071   end procedure.
     4072   procedure diasize_init :
     4073     define variable v-default-value    as logical   no-undo .
     4074     define variable v-restore-saved    as logical   no-undo .
     4075     define variable v-resize-value-str as character no-undo .
     4076     do
     4077     on error undo, return error return-value
     4078     :
     4079       do with frame Dialog-Frame
     4080       :
     4081         assign
     4082           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4083           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4084           v-diasize-browse-handle     = browse BR-PETROL :handle
     4085         .
     4086         create button v-diasize-resize-button
     4087         assign
     4088           parent        = frame Dialog-Frame :first-child
     4089           label         = "s"
     4090           height-pixels = 16
     4091           width-pixels  = 16
     4092           visible       = true
     4093           sensitive     = true
     4094           movable       = true
     4095           triggers:
     4096             on end-move persistent run diasize_end-move in this-procedure .
     4097           end triggers.
     4098         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4099         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4100         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4101         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4102         assign
     4103           v-diasize-wndmax = false
     4104         .
     4105         if connected("ub") = true
     4106         then do:
     4107           define variable v-cntxt-db-num        as integer   no-undo .
     4108           define variable v-cntxt-userid        as character no-undo .
     4109           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4110                                             , OUTPUT v-cntxt-userid
     4111                                             ) .
     4112           run gbl/wndpar_r.p
     4113             (input  v-cntxt-db-num
     4114             ,input  v-cntxt-userid
     4115             ,input  'wndmax':U
     4116             ,output v-diasize-wndmax
     4117             ,output v-default-value
     4118             ) .
     4119         end.
     4120         assign
     4121           v-diasize-wndstore = false
     4122         .
     4123         if connected("ub") = true
     4124         then do:
     4125           run gbl/wndpar_r.p
     4126             (input  v-cntxt-db-num
     4127             ,input  v-cntxt-userid
     4128             ,input  'wndstore':U
     4129             ,output v-diasize-wndstore
     4130             ,output v-default-value
     4131             ) .
     4132         end.
     4133         assign
     4134           v-diasize-proc-name = entry(1, program-name(2), '.')
     4135         .
     4136         if v-diasize-wndstore = true
     4137         then do:
     4138           assign
     4139             v-restore-saved = false
     4140           .
     4141           if connected("ub") = true
     4142           then do:
     4143             run gbl/wndsizer.p
     4144               (input  v-cntxt-db-num
     4145               ,input  v-cntxt-userid
     4146               ,input  v-diasize-proc-name
     4147               ,input  'height':u
     4148               ,output v-resize-value-str
     4149               ) .
     4150             if v-resize-value-str <> '':U
     4151             then do:
     4152               run diasize_change-height in this-procedure
     4153                 (input  integer(v-resize-value-str)
     4154                 ,input  true
     4155                 ) .
     4156               assign
     4157                 v-restore-saved = true
     4158               .
     4159             end.
     4160           end.
     4161           if connected("ub") = true
     4162           then do:
     4163             run gbl/wndsizer.p
     4164               (input  v-cntxt-db-num
     4165               ,input  v-cntxt-userid
     4166               ,input  v-diasize-proc-name
     4167               ,input  'width':u
     4168               ,output v-resize-value-str
     4169               ) .
     4170             if v-resize-value-str <> '':U
     4171             then do:
     4172               run diasize_change-width in this-procedure
     4173                 (input  integer(v-resize-value-str)
     4174                 ,input  true
     4175                 ) .
     4176               assign
     4177                 v-restore-saved = true
     4178               .
     4179             end.
     4180           end.
     4181           if v-restore-saved <> true
     4182           then do:
     4183             if v-diasize-wndmax = true
     4184             then do:
     4185               run diasize_maximize in this-procedure
     4186                 (input  true
     4187                 ) .
     4188             end.
     4189           end.
     4190         end.
     4191         else do:
     4192           if v-diasize-wndmax = true
     4193           then do:
     4194             run diasize_maximize in this-procedure
     4195               (input  true
     4196               ) .
     4197           end.
     4198         end.
     4199       end.
     4200     end.
     4201   end procedure.
     4202   procedure diasize_need-full-display :
     4203     define output parameter p-need-full-display as logical   no-undo .
     4204     do
     4205     on error undo, return error return-value
     4206     :
     4207       assign
     4208         p-need-full-display = v-diasize-need-full-display
     4209       .
     4210       assign
     4211         v-diasize-need-full-display = false
     4212       .
     4213     end.
     4214   end procedure.
     4215   procedure get-context :
     4216      define output parameter p-db-num as integer          no-undo.
     4217      define output parameter p-user-id as character        no-undo.
     4218      define variable v-login               as character    no-undo.
     4219      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4220      define buffer buf_user-login  for ub.user-login .
     4221      do
     4222      on error undo, return error
     4223      :
     4224            FIND FIRST buf_sys-ctrl no-lock.
     4225            ASSIGN
     4226               v-login = USERID("ub")
     4227               p-db-num = buf_sys-ctrl.db-num
     4228            .
     4229            FIND FIRST buf_user-login
     4230                 WHERE buf_user-login.db-num = p-db-num
     4231                   AND buf_user-login.user-login = v-login
     4232                 no-lock
     4233                 no-error
     4234                 .
     4235            IF AVAILABLE buf_user-login
     4236            THEN DO:
     4237               assign
     4238                  p-user-id = buf_user-login.user-id
     4239               .
     4240            END.
     4241      end.
     4242   end procedure.
     4243   MAIN-BLOCK:
     4244   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4245      ON stop    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4246      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4247     g#type = loc-doc-type .
     4248     find first i-ord-doc where i-ord-doc.doc-code = loc-ord-num no-lock no-error .
     4249     if available i-ord-doc then do:
     4250         loc-store-code  = i-ord-doc.obj-code .
     4251         loc-store-type  = i-ord-doc.obj-type .
     4252     end.
     4253     if loc-doc-type = 'ФП':U then do:
     4254           for each ub.shop no-lock where ub.shop.host-code   = g#host-code:
     4255   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4256   run create_obj-list in this-procedure
     4257    ( input 'маг':U ,
     4258      input ub.shop.obj-code )
     4259     no-error .
     4260           end.
     4261           for each ub.store no-lock  where ub.store.host-code  = g#host-code:
     4262   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4263   run create_obj-list in this-procedure
     4264    ( input 'скл':U ,
     4265      input ub.store.obj-code )
     4266     no-error .
     4267           end.
     4268       end.
     4269       else do:
     4270   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4271   run create_obj-list in this-procedure
     4272    ( input loc-store-type ,
     4273      input loc-store-code )
     4274      .
     4275       end.
     4276     find first tmp#zakaz  where  recid ( tmp#zakaz )  = r-tmp  no-error .
     4277     if error-status :error then message
     4278       vss-workfile vss-revision vss-description skip
     4279       error-status :get-message(1) skip
     4280       return-value skip
     4281       "tmp#zakaz"
     4282       view-as alert-box error
     4283     .
     4284     find first b-ord-line where  recid ( b-ord-line ) = r-tmp  no-error .
     4285     if error-status :error then message
     4286       vss-workfile vss-revision vss-description skip
     4287       error-status :get-message(1) skip
     4288       return-value skip
     4289       "b-ord-line"
     4290       view-as alert-box error
     4291     .
     4292     if line-mode = 'ИЗМЕНЕНИЕ':U or line-mode = 'ДОБАВЛЕНИЕ':U or line-mode = "ЦИКЛ":u  then do:
     4293     find first shar_ord-line  exclusive-lock  where
     4294         shar_ord-line.doc-code  = loc-ord-num          and
     4295         shar_ord-line.artic     = b-ord-line.artic     and
     4296         shar_ord-line.prod-type = b-ord-line.prod-type and
     4297         shar_ord-line.prod-code = b-ord-line.prod-code  no-error .
     4298         if error-status :error then do:
     4299            message vss-workfile vss-revision vss-description skip
     4300                    error-status :get-message(1)
     4301                    "Ошибка поиска строки заказа"
     4302                    "№ :" loc-ord-num    skip
     4303                    "артикул :"
     4304                     b-ord-line.artic
     4305                     b-ord-line.prod-type
     4306                     b-ord-line.prod-code
     4307                     view-as alert-box error .
     4308            return error.
     4309            end.
     4310     end.
     4311     else do:
     4312     find first shar_ord-line  no-lock   where
     4313         shar_ord-line.doc-code  = loc-ord-num          and
     4314         shar_ord-line.artic     = b-ord-line.artic     and
     4315         shar_ord-line.prod-type = b-ord-line.prod-type and
     4316         shar_ord-line.prod-code = b-ord-line.prod-code  no-error .
     4317      end.
     4318     create tt-ord-line.
     4319     BUFFER-COPY tmp#zakaz to tt-ord-line.
     4320     find first   ub.currency where ub.currency.curr-code = LOC-EXCH-CODE no-lock no-error.
     4321     if available ub.currency then   abbr-cli  = ub.currency.curr-abbr .
     4322     find first   ub.currency where ub.currency.curr-code = base-CODE no-lock no-error.
     4323     if available ub.currency then   abbr-base = ub.currency.curr-abbr .
     4324     abbr-rubl = "РУБ"  .
     4325   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4326   empty temp-table thbjattr_thbj-attr.
     4327   run adm/shattri.p (
     4328      input "get":U
     4329     ,input ''
     4330     ,input 0
     4331     ,input 'nakl-glob':U
     4332     ,input  ""
     4333     ,output v-value-character
     4334     ,output v-value-date
     4335     ,output v-value-decimal
     4336     ,output v-value-integer
     4337     ,output v-value-logical
     4338     ,output par-type
     4339     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4340     ) no-error .
     4341       for each thbjattr_thbj-attr :
     4342           if thbjattr_thbj-attr.prop-code = 'vat-ext'   then  dops        = thbjattr_thbj-attr.property-value-character .
     4343           if thbjattr_thbj-attr.prop-code = 'slt-ext'   then  dop-slt     = thbjattr_thbj-attr.property-value-character .
     4344           if thbjattr_thbj-attr.prop-code = 'vat-sum'   then  vat-sumvalue= string(thbjattr_thbj-attr.property-value-logical, "yes/no") .
     4345       end.
     4346       empty temp-table thbjattr_thbj-attr.
     4347      assign
     4348      rdtaxcdvalue  = '3':U
     4349      exctaxcdvalue = '4':U
     4350      vattaxcdvalue = '1':U
     4351      .
     4352    run enable_ui.
     4353    if  g#type <> 'ФП':U then do:
     4354         find first buf_gds-obj no-lock where
     4355           buf_gds-obj.artic     = ub.goods.artic        and
     4356           buf_gds-obj.prod-type = ub.goods.prod-type    and
     4357           buf_gds-obj.prod-code = ub.goods.prod-code    and
     4358           buf_gds-obj.obj-type = loc-store-type     and
     4359           buf_gds-obj.obj-code = loc-store-code     no-error .
     4360         if available buf_gds-obj then
     4361         display
     4362             buf_gds-obj.fact-qnty @ buf_gds-obj.fact-qnty
     4363             string (round (buf_gds-obj.fact-qnty / ub.goods.cli-base-rate , 3 )) + " " + ub.goods.unit-cli @ v-fact-cli-qnty
     4364             buf_gds-obj.free-qnty
     4365             buf_gds-obj.avrg-qnty
     4366             with frame Dialog-Frame .
     4367             if not available buf_gds-obj then
     4368         display
     4369             "-Новый товар-" @ buf_gds-obj.fact-qnty
     4370             with frame Dialog-Frame .
     4371    end.
     4372    else do:
     4373      hide
     4374       buf_gds-obj.fact-qnty
     4375       v-fact-cli-qnty
     4376       buf_gds-obj.free-qnty
     4377       buf_gds-obj.avrg-qnty
     4378       in frame Dialog-Frame .
     4379    end.
     4380    if b-ord-line.cli-base-rate = 0 or b-ord-line.cli-base-rate = ? then
     4381       kk = ub.goods.cli-base-rate.
     4382       else KK = b-ord-line.cli-base-rate.
     4383      b-ord-line.cli-base-rate  = kk.
     4384      run ui-on no-error .
     4385      if error-status :error then message
     4386        vss-workfile vss-revision vss-description skip
     4387        error-status :get-message(1) skip
     4388        return-value skip
     4389        ""
     4390        view-as alert-box error
     4391      .
     4392    if  g#type <> 'ФП':U then do:
     4393         find first buf_gds-obj no-lock where
     4394           buf_gds-obj.artic     = ub.goods.artic        and
     4395           buf_gds-obj.prod-type = ub.goods.prod-type    and
     4396           buf_gds-obj.prod-code = ub.goods.prod-code    and
     4397           buf_gds-obj.obj-type = loc-store-type     and
     4398           buf_gds-obj.obj-code = loc-store-code     no-error .
     4399         if available buf_gds-obj then
     4400         display
     4401             buf_gds-obj.fact-qnty @ buf_gds-obj.fact-qnty
     4402             buf_gds-obj.free-qnty
     4403             buf_gds-obj.avrg-qnty
     4404             with frame Dialog-Frame .
     4405             if not available buf_gds-obj then
     4406         display
     4407             "-Новый товар-" @ buf_gds-obj.fact-qnty
     4408             with frame Dialog-Frame .
     4409    end.
     4410     tmp#zakaz.sum-road-tax:label  =  "Сумма по " + substring( tmp#zakaz.road-tax:label ,1 , 5) +  "." .
     4411     if (i-ord-doc.whole-send-news = integer('1':U)
     4412         and
     4413         (i-ord-doc.ord-int1 = integer('3':U) or i-ord-doc.ord-int1 = integer('4':U))
     4414         )
     4415     or (i-ord-doc.whole-send-news = integer('2':U)
     4416         and
     4417         (i-ord-doc.ord-int1 = integer('6':U)
     4418          or
     4419          i-ord-doc.ord-int1 = integer('5':U)
     4420          or
     4421          i-ord-doc.ord-int1 = integer('4':U)
     4422         ))
     4423     then do:
     4424        disable all with frame Dialog-Frame .
     4425        enable B-OK with frame Dialog-Frame .
     4426     end.
     4427     if tmp#zakaz.cli-qnty:sensitive in frame Dialog-Frame then do:
     4428         WAIT-FOR GO OF FRAME Dialog-Frame focus  tmp#zakaz.cli-qnty .
     4429     end.
     4430     else do:
     4431         WAIT-FOR GO OF FRAME Dialog-Frame focus  tmp#zakaz.qnty .
     4432     end.
     4433   END.
     4434   run disable_ui.
     4435   PROCEDURE disable_UI :
     4436     HIDE FRAME Dialog-Frame.
     4437     HIDE FRAME FRAME-petrol.
     4438   END PROCEDURE.
     4439   PROCEDURE enable_UI :
     4440     OPEN QUERY Dialog-Frame FOR EACH tmp#zakaz       WHERE r-tmp = recid ( tmp#zakaz   ) NO-LOCK,       EACH ub.goods WHERE ub.goods.artic = tmp#zakaz.artic   AND ub.goods.prod-code = tmp#zakaz.prod-code   AND ub.goods.prod-type = tmp#zakaz.prod-type NO-LOCK,       EACH ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,       EACH ub.clients WHERE ub.clients.obj-code = tmp#zakaz.prod-code   AND ub.clients.obj-type = tmp#zakaz.prod-type NO-LOCK.
     4441     GET FIRST Dialog-Frame.
     4442     DISPLAY abbr-cli abbr-base abbr-rubl
     4443         WITH FRAME Dialog-Frame.
     4444     IF AVAILABLE ub.clients THEN
     4445       DISPLAY ub.clients.obj-name
     4446         WITH FRAME Dialog-Frame.
     4447     IF AVAILABLE ub.gds-prt THEN
     4448       DISPLAY ub.gds-prt.node-name
     4449         WITH FRAME Dialog-Frame.
     4450     IF AVAILABLE ub.goods THEN
     4451       DISPLAY ub.goods.gds-name ub.goods.qnty-cart ub.goods.wt-cart ub.goods.unit-base
     4452         WITH FRAME Dialog-Frame.
     4453     IF AVAILABLE tmp#zakaz THEN
     4454       DISPLAY tmp#zakaz.cli-art tmp#zakaz.VAT-pc tmp#zakaz.v-vat tmp#zakaz.sum-VAT
     4455             tmp#zakaz.cli-qnty tmp#zakaz.unit-cli tmp#zakaz.SLT-pc
     4456             tmp#zakaz.cli-base-rate tmp#zakaz.qnty tmp#zakaz.price-cli
     4457             tmp#zakaz.price-base tmp#zakaz.price-rubl tmp#zakaz.line-num
     4458             tmp#zakaz.cancel-date tmp#zakaz.road-tax tmp#zakaz.excise
     4459             tmp#zakaz.transport-base tmp#zakaz.other-base tmp#zakaz.transport-rubl
     4460             tmp#zakaz.other-rubl tmp#zakaz.artic tmp#zakaz.prod-type
     4461             tmp#zakaz.prod-code tmp#zakaz.sum-SLT tmp#zakaz.sum-cli tmp#zakaz.sum-base
     4462             tmp#zakaz.sum-rubl tmp#zakaz.sum-road-tax tmp#zakaz.sum-excise
     4463             tmp#zakaz.sum-transport-base tmp#zakaz.sum-other-base
     4464             tmp#zakaz.sum-transport-rubl tmp#zakaz.sum-other-rubl
     4465         WITH FRAME Dialog-Frame.
     4466     ENABLE B-OK B-Cancel b-exit-cycl B-qnty B-prt B-help
     4467            tmp#zakaz.VAT-pc tmp#zakaz.v-vat tmp#zakaz.sum-VAT r-units
     4468            tmp#zakaz.cli-qnty tmp#zakaz.unit-cli tmp#zakaz.SLT-pc
     4469            tmp#zakaz.cli-base-rate tmp#zakaz.qnty tmp#zakaz.price-cli
     4470            tmp#zakaz.price-base tmp#zakaz.price-rubl tmp#zakaz.line-num
     4471            tmp#zakaz.cancel-date tmp#zakaz.road-tax tmp#zakaz.excise
     4472            tmp#zakaz.transport-base tmp#zakaz.other-base tmp#zakaz.transport-rubl
     4473            tmp#zakaz.other-rubl tmp#zakaz.artic ub.goods.gds-name tmp#zakaz.prod-type
     4474            ub.clients.obj-name tmp#zakaz.prod-code ub.goods.qnty-cart ub.goods.wt-cart
     4475            tmp#zakaz.sum-SLT ub.goods.unit-base abbr-cli tmp#zakaz.sum-cli abbr-base
     4476            tmp#zakaz.sum-base abbr-rubl tmp#zakaz.sum-rubl ub.gds-prt.node-name
     4477            tmp#zakaz.sum-road-tax tmp#zakaz.sum-excise tmp#zakaz.sum-transport-base
     4478            tmp#zakaz.sum-other-base tmp#zakaz.sum-transport-rubl
     4479            tmp#zakaz.sum-other-rubl
     4480         WITH FRAME Dialog-Frame.
     4481     VIEW FRAME Dialog-Frame.
     4482   END PROCEDURE.
     4483   PROCEDURE UI-on :
     4484    do
     4485    on error undo, return error return-value
     4486    :
     4487   define variable gds-rec as recid no-undo .
     4488   define variable sss as character no-undo .
     4489   find current ub.goods no-lock no-error .
     4490   gds-rec = recid( ub.goods ) .
     4491   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     4492     (
     4493        input ub.goods.artic
     4494     ,  input ub.goods.prod-type
     4495     ,  input ub.goods.prod-code
     4496     , output is-petrolium
     4497     , output is-pieces
     4498     ) no-error.
     4499   if error-status :error then
     4500   message
     4501     vss-workfile vss-revision vss-description skip
     4502     error-status :get-message(1) skip
     4503     return-value skip
     4504     "is-petrl.i"
     4505     view-as alert-box error
     4506   .
     4507   is-petrolium = false .
     4508   if is-petrolium = true then  run run-petrol in this-procedure no-error .
     4509   if error-status :error then message
     4510     vss-workfile vss-revision vss-description skip
     4511     error-status :get-message(1) skip
     4512     return-value skip
     4513     "run-petrol"
     4514     view-as alert-box error
     4515   .
     4516   run ass-var in this-procedure no-error .
     4517   if error-status :error then
     4518    message
     4519     vss-workfile vss-revision vss-description skip
     4520     error-status :get-message(1) skip
     4521     return-value skip
     4522     "из программы ass-var"
     4523     view-as alert-box error
     4524   .
     4525     assign
     4526       tmp#zakaz.sum-rubl   =  tmp#zakaz.price-rubl * tmp#zakaz.qnty
     4527       tmp#zakaz.sum-base   =  tmp#zakaz.price-base * tmp#zakaz.qnty
     4528       tmp#zakaz.sum-cli    =  tmp#zakaz.price-cli  * tmp#zakaz.cli-qnty
     4529     .
     4530   if g#type <> 'ОФ':U  then do:
     4531       display
     4532       tmp#zakaz.sum-rubl
     4533       tmp#zakaz.sum-base
     4534       tmp#zakaz.sum-cli
     4535       with frame Dialog-Frame .
     4536   end.
     4537   sss = (if g#type = 'ОФ':U  then "Заявка № " else "Заказ № ") + loc-ord-num + line-mode.
     4538    assign frame Dialog-Frame:title  = sss  .
     4539      if slt_type = 'без':U and g#type <> 'ОФ':U then do:
     4540         disable tmp#zakaz.SLT-pc  tmp#zakaz.sum-SLT      with frame Dialog-Frame .
     4541         display tmp#zakaz.SLT-pc  tmp#zakaz.sum-SLT      with frame Dialog-Frame .
     4542      end.
     4543      if vat_type = 'без':U and g#type <> 'ОФ':U then do:
     4544         disable tmp#zakaz.vat-pc  tmp#zakaz.sum-vat      with frame Dialog-Frame .
     4545         display tmp#zakaz.vat-pc  tmp#zakaz.sum-vat      with frame Dialog-Frame .
     4546      end.
     4547      if  g#type = 'ОФ':U or line-mode = 'ПРОСМОТР':U then do:
     4548         disable tmp#zakaz.SLT-pc  tmp#zakaz.sum-SLT  tmp#zakaz.vat-pc  tmp#zakaz.sum-vat tmp#zakaz.v-vat with frame Dialog-Frame .
     4549         display tmp#zakaz.SLT-pc  tmp#zakaz.sum-SLT  tmp#zakaz.vat-pc  tmp#zakaz.sum-vat tmp#zakaz.v-vat with frame Dialog-Frame .
     4550      end.
     4551      disable tmp#zakaz.sum-vat tmp#zakaz.v-vat with frame Dialog-Frame .
     4552      if line-mode = 'ПРОСМОТР':U then do:
     4553        disable all with frame Dialog-Frame .
     4554        enable B-Cancel with frame Dialog-Frame .
     4555      end.
     4556     if  line-mode = "ЦИКЛ":U then do:
     4557        enable  b-exit-cycl with frame Dialog-Frame.
     4558        display b-exit-cycl  with frame Dialog-Frame.
     4559     end.
     4560     if  line-mode = 'ИЗМЕНЕНИЕ':U then do:
     4561        disable  b-exit-cycl  with frame Dialog-Frame.
     4562     end.
     4563     if  line-mode = 'ПРОСМОТР':U then do:
     4564        disable  b-exit-cycl   with frame Dialog-Frame.
     4565     end.
     4566     hide tmp#zakaz.excise             tmp#zakaz.sum-excise
     4567          tmp#zakaz.transport-base     tmp#zakaz.transport-rubl
     4568          tmp#zakaz.sum-transport-base tmp#zakaz.sum-transport-rubl
     4569          tmp#zakaz.other-base         tmp#zakaz.other-rubl
     4570          tmp#zakaz.sum-other-base     tmp#zakaz.sum-other-rubl
     4571          B-qnty B-prt        tmp#zakaz.line-num
     4572         in frame Dialog-Frame .
     4573     if  g#type = 'ОФ':U  then do:
     4574       hide
     4575        tmp#zakaz.VAT-pc
     4576        tmp#zakaz.v-vat
     4577        tmp#zakaz.sum-VAT
     4578        tmp#zakaz.SLT-pc
     4579        tot-cli
     4580        tmp#zakaz.price-cli
     4581        tot-rubl
     4582        tmp#zakaz.price-base
     4583        tot-base
     4584        tmp#zakaz.price-rubl
     4585        tmp#zakaz.line-num
     4586        tmp#zakaz.cancel-date
     4587        tmp#zakaz.road-tax
     4588        tmp#zakaz.excise
     4589        tmp#zakaz.transport-base
     4590        tmp#zakaz.other-base
     4591        tmp#zakaz.transport-rubl
     4592        tmp#zakaz.other-rubl
     4593        tmp#zakaz.sum-SLT
     4594        tmp#zakaz.sum-cli
     4595        abbr-base
     4596        tmp#zakaz.sum-base
     4597        abbr-rubl
     4598        tmp#zakaz.sum-rubl
     4599        tmp#zakaz.sum-road-tax
     4600        tmp#zakaz.sum-excise
     4601        tmp#zakaz.sum-transport-base
     4602        tmp#zakaz.sum-other-base
     4603        tmp#zakaz.sum-transport-rubl
     4604        tmp#zakaz.sum-other-rubl
     4605        in frame Dialog-Frame .
     4606     end.
     4607   end.
     4608   END PROCEDURE.
     4609   procedure run-petrol :
     4610     do
     4611     on error undo, return error
     4612     :
     4613    assign
     4614      N-1 = 0  N-2 = 0
     4615    .
     4616    for each obj-list ,
     4617       EACH ub.place no-lock
     4618         WHERE  ub.place.obj-code = obj-list.obj-code
     4619            AND ub.place.obj-type = obj-list.obj-type ,
     4620            first ub.pl-gds no-lock where
     4621                       ub.pl-gds.gds-code = ub.goods.gds-code  and
     4622                       ub.pl-gds.pl-code = ub.place.pl-code    and
     4623                       ub.pl-gds.obj-code = ub.place.obj-code  and
     4624                       ub.pl-gds.obj-type = ub.place.obj-type  :
     4625            N-1 = N-1 + ub.place.max-qnty.
     4626            find LAST ub.rvs-line no-lock  WHERE
     4627                       ub.rvs-line.gds-code = ub.goods.gds-code and
     4628                       ub.rvs-line.pl-code = ub.place.pl-code
     4629                       no-error .
     4630                       if avail  ub.rvs-line then do:
     4631                          find first ub.rvs-doc no-lock where ub.rvs-doc.rvs-code = ub.rvs-line.rvs-code and
     4632                                              ub.rvs-doc.status_ = 'факт':U no-error .
     4633                          if available ub.rvs-doc then do:
     4634                             N-2  =  N-2 + ub.rvs-line.state-measure-qnty .
     4635                          end.
     4636                       end.
     4637    end.
     4638    N-2 = N-1 - N-2.
     4639     DISPLAY N-1 N-2
     4640         WITH FRAME FRAME-petrol.
     4641     ENABLE BR-PETROL N-1 N-2
     4642         WITH FRAME FRAME-petrol.
     4643     VIEW FRAME FRAME-petrol.
     4644     OPEN QUERY BR-PETROL for each obj-list ,        EACH ub.place NO-LOCK        WHERE  ub.place.obj-code = obj-list.obj-code           AND ub.place.obj-type = obj-list.obj-type ,       FIRST ub.pl-gds no-lock         WHERE  ub.pl-gds.obj-code = ub.place.obj-code           AND ub.pl-gds.obj-type = ub.place.obj-type           AND ub.pl-gds.pl-code  = ub.place.pl-code           AND ub.pl-gds.gds-code = ub.goods.gds-code .
     4645   end.
     4646   end procedure.
     4647   procedure ver-value :
     4648    do
     4649    on error undo, return error return-value
     4650    :
     4651   define buffer bf-units-cli for ub.units.
     4652    if   tmp#zakaz.cli-art:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.cli-art  <> tmp#zakaz.cli-art  then apply "leave" to tmp#zakaz.cli-art  in frame Dialog-Frame.
     4653    if   tmp#zakaz.vat-pc:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.vat-pc  <> tmp#zakaz.vat-pc  then apply "leave" to tmp#zakaz.vat-pc  in frame Dialog-Frame.
     4654    if   tmp#zakaz.sum-vat:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-vat  <> tmp#zakaz.sum-vat  then apply "leave" to tmp#zakaz.sum-vat  in frame Dialog-Frame.
     4655    if   tmp#zakaz.cli-qnty:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.cli-qnty  <> tmp#zakaz.cli-qnty  then apply "leave" to tmp#zakaz.cli-qnty  in frame Dialog-Frame.
     4656    if   tmp#zakaz.slt-pc:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.slt-pc  <> tmp#zakaz.slt-pc  then apply "leave" to tmp#zakaz.slt-pc  in frame Dialog-Frame.
     4657    if   tmp#zakaz.sum-slt:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-slt  <> tmp#zakaz.sum-slt  then apply "leave" to tmp#zakaz.sum-slt  in frame Dialog-Frame.
     4658    if   tmp#zakaz.qnty:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.qnty  <> tmp#zakaz.qnty  then apply "leave" to tmp#zakaz.qnty  in frame Dialog-Frame.
     4659    if   tmp#zakaz.price-cli:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.price-cli  <> tmp#zakaz.price-cli  then apply "leave" to tmp#zakaz.price-cli  in frame Dialog-Frame.
     4660    if   tmp#zakaz.price-base:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.price-base  <> tmp#zakaz.price-base  then apply "leave" to tmp#zakaz.price-base  in frame Dialog-Frame.
     4661    if   tmp#zakaz.price-rubl:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.price-rubl  <> tmp#zakaz.price-rubl  then apply "leave" to tmp#zakaz.price-rubl  in frame Dialog-Frame.
     4662    if   tmp#zakaz.cli-base-rate:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.cli-base-rate  <> tmp#zakaz.cli-base-rate  then apply "leave" to tmp#zakaz.cli-base-rate  in frame Dialog-Frame.
     4663    if   tmp#zakaz.road-tax:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.road-tax  <> tmp#zakaz.road-tax  then apply "leave" to tmp#zakaz.road-tax  in frame Dialog-Frame.
     4664    if   tmp#zakaz.line-num:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.line-num  <> tmp#zakaz.line-num  then apply "leave" to tmp#zakaz.line-num  in frame Dialog-Frame.
     4665    if   tmp#zakaz.sum-road-tax:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-road-tax  <> tmp#zakaz.sum-road-tax  then apply "leave" to tmp#zakaz.sum-road-tax  in frame Dialog-Frame.
     4666    if   tmp#zakaz.cancel-date:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.cancel-date  <> tmp#zakaz.cancel-date  then apply "leave" to tmp#zakaz.cancel-date  in frame Dialog-Frame.
     4667    if   tmp#zakaz.excise:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.excise  <> tmp#zakaz.excise  then apply "leave" to tmp#zakaz.excise  in frame Dialog-Frame.
     4668    if   tmp#zakaz.sum-excise:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-excise  <> tmp#zakaz.sum-excise  then apply "leave" to tmp#zakaz.sum-excise  in frame Dialog-Frame.
     4669    if   tmp#zakaz.transport-base:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.transport-base  <> tmp#zakaz.transport-base  then apply "leave" to tmp#zakaz.transport-base  in frame Dialog-Frame.
     4670    if   tmp#zakaz.other-base:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.other-base  <> tmp#zakaz.other-base  then apply "leave" to tmp#zakaz.other-base  in frame Dialog-Frame.
     4671    if   tmp#zakaz.transport-rubl:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.transport-rubl  <> tmp#zakaz.transport-rubl  then apply "leave" to tmp#zakaz.transport-rubl  in frame Dialog-Frame.
     4672    if   tmp#zakaz.other-rubl:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.other-rubl  <> tmp#zakaz.other-rubl  then apply "leave" to tmp#zakaz.other-rubl  in frame Dialog-Frame.
     4673    if   tmp#zakaz.sum-transport-base:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-transport-base  <> tmp#zakaz.sum-transport-base  then apply "leave" to tmp#zakaz.sum-transport-base  in frame Dialog-Frame.
     4674    if   tmp#zakaz.sum-other-base:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-other-base  <> tmp#zakaz.sum-other-base  then apply "leave" to tmp#zakaz.sum-other-base  in frame Dialog-Frame.
     4675    if   tmp#zakaz.sum-transport-rubl:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-transport-rubl  <> tmp#zakaz.sum-transport-rubl  then apply "leave" to tmp#zakaz.sum-transport-rubl  in frame Dialog-Frame.
     4676    if   tmp#zakaz.sum-other-rubl:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-other-rubl  <> tmp#zakaz.sum-other-rubl  then apply "leave" to tmp#zakaz.sum-other-rubl  in frame Dialog-Frame.
     4677    if   tmp#zakaz.sum-cli:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-cli  <> tmp#zakaz.sum-cli  then apply "leave" to tmp#zakaz.sum-cli  in frame Dialog-Frame.
     4678    if   tmp#zakaz.sum-base:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-base  <> tmp#zakaz.sum-base  then apply "leave" to tmp#zakaz.sum-base  in frame Dialog-Frame.
     4679    if   tmp#zakaz.sum-rubl:sensitive in frame Dialog-Frame and input frame Dialog-Frame tmp#zakaz.sum-rubl  <> tmp#zakaz.sum-rubl  then apply "leave" to tmp#zakaz.sum-rubl  in frame Dialog-Frame.
     4680     assign frame Dialog-Frame tmp#zakaz.cli-art tmp#zakaz.VAT-pc tmp#zakaz.cli-qnty tmp#zakaz.SLT-pc tmp#zakaz.qnty tmp#zakaz.price-cli tmp#zakaz.line-num tmp#zakaz.cancel-date tmp#zakaz.road-tax tmp#zakaz.excise tmp#zakaz.transport-base tmp#zakaz.other-base tmp#zakaz.transport-rubl tmp#zakaz.other-rubl tmp#zakaz.artic tmp#zakaz.prod-type tmp#zakaz.prod-code tmp#zakaz.sum-SLT tmp#zakaz.sum-cli tmp#zakaz.sum-base tmp#zakaz.sum-rubl tmp#zakaz.sum-road-tax tmp#zakaz.sum-excise tmp#zakaz.sum-transport-base tmp#zakaz.sum-other-base tmp#zakaz.sum-transport-rubl tmp#zakaz.sum-other-rubl .
     4681     if tmp#zakaz.cli-qnty:sensitive in frame Dialog-Frame and  (tmp#zakaz.cli-qnty = 0 or tmp#zakaz.cli-qnty = ?)  then do:
     4682       message "Не указано количество в единицах поставщика." view-as alert-box error.
     4683       if tmp#zakaz.cli-qnty:sensitive in frame Dialog-Frame then apply "entry" to tmp#zakaz.cli-qnty in frame Dialog-Frame.
     4684                                                              else apply "entry" to b-cancel           in frame Dialog-Frame.
     4685       return error.
     4686     end.
     4687     if tmp#zakaz.qnty:sensitive in frame Dialog-Frame and  (tmp#zakaz.qnty = 0 or tmp#zakaz.qnty = ?)  then do:
     4688       message "Не указано количество  в учетных единицах." view-as alert-box error.
     4689       return error.
     4690     end.
     4691     if  tmp#zakaz.qnty:sensitive in frame Dialog-Frame and
     4692        lookup ( 'шту':U, tmp#zakaz.unit-type) > 0      and
     4693        trunc ( tmp#zakaz.qnty, 0) <> tmp#zakaz.qnty then do:
     4694         message "Базовая единица товара " tmp#zakaz.unit-base " - штучная." skip
     4695                 "Кол-во должно быть целым."
     4696         view-as alert-box error buttons ok.
     4697         return error.
     4698     end.
     4699     find bf-units-cli where bf-units-cli.unit-name = tmp#zakaz.unit-cli no-lock no-error.
     4700     if not available bf-units-cli then do:
     4701       message "Неправильная единица измерения." view-as alert-box error.
     4702       return error.
     4703     end.
     4704     if  tmp#zakaz.cli-qnty:sensitive in frame Dialog-Frame and
     4705         lookup('шту':U, bf-units-cli.type) > 0  and
     4706         trunc (tmp#zakaz.cli-qnty, 0) <> tmp#zakaz.cli-qnty then do:
     4707         message "Единица поставщика " tmp#zakaz.unit-cli " - штучная." skip
     4708                 "Должно быть указано целое количество в единицах поставщика."
     4709         view-as alert-box error buttons ok.
     4710         return error.
     4711     end.
     4712     release bf-units-cli.
     4713     if tmp#zakaz.cli-base-rate:sensitive in frame Dialog-Frame and (tmp#zakaz.cli-base-rate = 0 or tmp#zakaz.cli-base-rate = ?) then do:
     4714       message "Не указан коэффициент пересчета единиц измерения." view-as alert-box error.
     4715       return error.
     4716     end.
     4717     if tmp#zakaz.unit-cli = tmp#zakaz.unit-base and tmp#zakaz.cli-base-rate <> 1 then do:
     4718       message "Коэффициент пересчета единиц измерения должен быть 1, т.к. единицы совпадают." view-as alert-box error.
     4719       return error.
     4720     end.
     4721     if  loc-status <> ""  then do:
     4722       if tmp#zakaz.price-cli:sensitive in frame Dialog-Frame and ( tmp#zakaz.price-cli = 0 or tmp#zakaz.price-cli = ?) then do:
     4723         message "Не указана цена в валюте поставщика." view-as alert-box error.
     4724         return error.
     4725       end.
     4726       if tmp#zakaz.price-cli < 0  then do:
     4727         message "Нельзя указывать отрицательные цены в валюте поставщика." view-as alert-box error.
     4728         return error.
     4729       end.
     4730       if tmp#zakaz.price-base:sensitive in frame Dialog-Frame and (tmp#zakaz.price-base = 0 or tmp#zakaz.price-base = ?) then do:
     4731         message "Не указана цена в базовой валюте." view-as alert-box error.
     4732         return error.
     4733       end.
     4734       if tmp#zakaz.price-base < 0  then do:
     4735         message "Отрицательная цена в базовой валюте."  view-as alert-box error.
     4736         return error.
     4737       end.
     4738       if tmp#zakaz.price-base > 5000 and base-code = 1 then
     4739         message "Внимание !!!" skip (2)
     4740                 "ВАЛЮТНАЯ цена превышает 5,000 !" skip (2)
     4741                 "Вы не ошиблись ?"  view-as alert-box question.
     4742       if tmp#zakaz.price-rubl:sensitive in frame Dialog-Frame and (tmp#zakaz.price-rubl = 0 or tmp#zakaz.price-rubl = ?) then do:
     4743         message "Не указана цена в рублях." view-as alert-box error.
     4744         return error.
     4745       end.
     4746       if tmp#zakaz.price-rubl < 0 then do:
     4747         message "Отрицательная цена в рублях."  view-as alert-box error.
     4748         return error.
     4749       end.
     4750     end.
     4751     if is-petrolium = true then do:
     4752      if n-1 < tmp#zakaz.qnty then do:
     4753      message "Внимание !!! Заказано  больше, чем общий объем мест хранения! "  view-as alert-box error  .
     4754      end.
     4755     end.
     4756     assign
     4757       tmp#zakaz.price-base =  tmp#zakaz.price-rubl  / loc-base-rate * loc-base-scale
     4758       tmp#zakaz.qnty       =  tmp#zakaz.cli-qnty   * tmp#zakaz.cli-base-rate
     4759       tmp#zakaz.sum-rubl   =  tmp#zakaz.price-rubl * tmp#zakaz.qnty
     4760       tmp#zakaz.sum-base   =  tmp#zakaz.price-base * tmp#zakaz.qnty
     4761       tmp#zakaz.sum-cli    =  tmp#zakaz.price-cli  * tmp#zakaz.cli-qnty
     4762     .
     4763   if ( is-edoc-nn-doc = false and shar_ord-doc.ord-int1 = int('0':U) )
     4764     or ( is-edi-doc     = false and shar_ord-doc.ord-int1 = int('0':U)  )
     4765     then do:
     4766       define variable v-not-corr-op as character no-undo .
     4767       define variable p-type as character no-undo .
     4768       if (tmp#zakaz.qnty <> tmp#zakaz.initial-qnty and e-method <> "") then do:
     4769         v-not-corr-op  = 'no' .
     4770         run clntattr-value (
     4771               input   loc-store-type
     4772             , input   loc-store-code
     4773             , input   'not-corr-op':U
     4774             , output  v-not-corr-op
     4775             , output  p-type
     4776         ) no-error .
     4777         if error-status :error then v-not-corr-op  = 'no' .
     4778         if v-not-corr-op  = 'yes' then do:
     4779           v-not-corr-op  = 'no' .
     4780           run clntattr-value (
     4781                 input   loc-cli-type
     4782               , input   loc-cli-code
     4783               , input   'not-corr-op':U
     4784               , output  v-not-corr-op
     4785               , output  p-type
     4786           ) no-error .
     4787           if error-status :error then v-not-corr-op  = 'no' .
     4788           if v-not-corr-op  = 'yes' then do:
     4789             message substitute ( "Был произведен автоматический расчет заказа, количество должно быть &1&4Запрещено менять рассчитанные количества  по Поставщику &2&3 " ,
     4790                     tmp#zakaz.initial-qnty ,
     4791                     loc-cli-type ,
     4792                     loc-cli-code ,
     4793                     chr(10) )
     4794             view-as alert-box information .
     4795             return error.
     4796           end.
     4797           define buffer buf_goods for ub.goods  .
     4798           find first  buf_goods no-lock where
     4799                       buf_goods.artic = tmp#zakaz.artic and
     4800                       buf_goods.prod-type = tmp#zakaz.prod-type and
     4801                       buf_goods.prod-code = tmp#zakaz.prod-code no-error .
     4802           assign
     4803             tmp#zakaz.gds-code = buf_goods.gds-code
     4804             v-not-corr-op  = 'no'
     4805           .
     4806           run ggoattr-value (
     4807             input   buf_goods.grp-code
     4808             ,input   v-cntxt-host-code-obj
     4809             ,input   v-cntxt-obj-type
     4810             ,input   v-cntxt-obj-code
     4811             ,input   'NotCorrOP':U
     4812             ,output  v-not-corr-op
     4813             ,output  p-type ) no-error .
     4814           if error-status :error then v-not-corr-op  = 'no' .
     4815           if v-not-corr-op  = 'yes' then do:
     4816             message substitute("Был произведен автоматический расчет заказа, количество должно быть &1&4Запрещено менять расcчитанные количества  по Группе товаров (&2) &3 " ,
     4817                     tmp#zakaz.initial-qnty ,
     4818                     buf_goods.grp-code ,
     4819                     buf_goods.grp-name ,
     4820                     chr(10))
     4821             view-as alert-box information .
     4822             return error.
     4823           end.
     4824         end.
     4825       end.
     4826     end.
     4827   end.
     4828   end procedure.
     4829   PROCEDURE edoc-nn-proc :
     4830   if  (is-edoc-nn
     4831   and shar_ord-doc.whole-send-news = integer('1':U)
     4832   and
     4833       ( shar_ord-doc.ord-int1 = int ('4':U) or
     4834         shar_ord-doc.ord-int1 = int ('3':U)  or
     4835         ( shar_ord-doc.ord-int1 = int ('0':U)  and
     4836           shar_ord-doc.ord-int2 = int ('1':U))
     4837         ) and
     4838       ( shar_ord-doc.doc-type = 'ОП':U ) and
     4839         shar_ord-doc.status_ = 'новый':U
     4840         )
     4841   or  (is-edi
     4842   and shar_ord-doc.whole-send-news = integer('2':U)
     4843   and shar_ord-doc.ord-int1 = int ('3':U)
     4844   and shar_ord-doc.ord-int2 = int ('1':U)
     4845   and shar_ord-doc.doc-type = 'ОП':U
     4846   and shar_ord-doc.status_ = 'новый':U
     4847   )
     4848    then do:
     4849       display
     4850         tmp#zakaz.order-cli-qnty
     4851         tmp#zakaz.ord-dec1
     4852         tmp#zakaz.sub-par
     4853         with frame Dialog-Frame .
     4854         if tmp#zakaz.order-cli-qnty <> tmp#zakaz.cli-qnty then tmp#zakaz.order-cli-qnty:bgcolor = 12  .
     4855            else tmp#zakaz.order-cli-qnty:bgcolor = 15  .
     4856         if tmp#zakaz.ord-dec1 <> tmp#zakaz.price-cli then     tmp#zakaz.ord-dec1:bgcolor = 12 .
     4857         else tmp#zakaz.ord-dec1:bgcolor = 15.
     4858         .
     4859     if shar_ord-doc.whole-send-news = integer('2':U) then do:
     4860       disable
     4861       tmp#zakaz.cli-art
     4862       with frame Dialog-Frame .
     4863     end.
     4864   end.
     4865   else do:
     4866         hide
     4867           tmp#zakaz.order-cli-qnty
     4868           tmp#zakaz.ord-dec1
     4869           tmp#zakaz.sub-par
     4870           in frame Dialog-Frame .
     4871   end.
     4872   END PROCEDURE.
