     2740     ,output  varprice-without-abs-dt
     2741     ,output  varprice-slt-dt
     2742     ,output  varprice-no-slt-dt
     2743     ,output  varprice-vat-dt
     2744     ,output  varprice-no-vat-slt-dt
     2745     ,output  varprice-rubl-dt
     2746     ,output  varprice-road-tax-rubl-dt
     2747     ,output  varprice-other-exp-rubl-dt
     2748     ,output  varprice-transport-exp-rubl-dt
     2749     ,output  varprice-without-abs-rubl-dt
     2750     ,output  varprice-slt-rubl-dt
     2751     ,output  varprice-no-slt-rubl-dt
     2752     ,output  varprice-vat-rubl-dt
     2753     ,output  varprice-no-vat-slt-rubl-dt
     2754     ,output  varprice-base-dt
     2755     ,output  varprice-road-tax-base-dt
     2756     ,output  varprice-other-exp-base-dt
     2757     ,output  varprice-transport-exp-base-dt
     2758     ,output  varprice-without-abs-base-dt
     2759     ,output  varprice-slt-base-dt
     2760     ,output  varprice-no-slt-base-dt
     2761     ,output  varprice-vat-base-dt
     2762     ,output  varprice-no-vat-slt-base-dt
     2763     ) no-error.
     2764       if error-status:error then do:
     2765         return error substitute( "Ошибка при пересчете линии заказа . &1" , return-value ) .
     2766       end.
     2767      assign
