     2274        SPACE(23.73) SKIP(13.82)
     2275       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2276            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2277            TITLE "Изменение строки заказа"
     2278            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel.
     2279   DEFINE FRAME FRAME-petrol
     2280        BR-PETROL AT ROW 1 COL 1
     2281        N-1 AT ROW 7 COL 30 COLON-ALIGNED no-label
     2282        N-2 AT ROW 7 COL 47 COLON-ALIGNED NO-LABEL
     2283        "Итого:" VIEW-AS TEXT
     2284             SIZE 8 BY .67 AT ROW 7 COL 1
     2285             FGCOLOR 1
     2286       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
     2287            SIDE-LABELS NO-UNDERLINE THREE-D
     2288            AT COL 1 ROW 14.75
     2289            SIZE 92 BY 8.5
     2290            TITLE "Бензин".
     2291   ASSIGN FRAME FRAME-petrol:FRAME = FRAME Dialog-Frame:HANDLE.
     2292   ASSIGN
     2293          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2294          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2295   ASSIGN
     2296          tot-base:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2297   ASSIGN
     2298          tot-cli:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2299   ASSIGN
     2300          tot-rubl:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2301   ASSIGN
     2302          FRAME FRAME-petrol:HIDDEN           = TRUE.
     2303   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2304   DO:
     2305     APPLY "END-ERROR":U TO SELF.
     2306   END.
     2307   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
     2308   DO:
     2309     stp-cycle  =  false.
     2310     stp-exit  =  false.
     2311     run ver-value in this-procedure no-error.
     2312     if error-status:error then do:
     2313        return no-apply.
     2314     end.
     2315     if  tmp#zakaz.order-cli-qnty = tmp#zakaz.cli-qnty and tmp#zakaz.cli-qnty <> 0
     2316     then do:
     2317         message "Нельзя отправлять заказ на коррекцию с тем же количеством, которое было запрошено первоначально!" view-as alert-box .
     2318         return no-apply.
     2319     end.
     2320     buffer-copy b-ord-line to shar_ord-line
     2321        assign shar_ord-line.doc-code = loc-ord-num
     2322        no-error .
     2323     if error-status :error then message
     2324       vss-workfile vss-revision vss-description skip
     2325       error-status :get-message(1) skip
     2326       return-value skip
     2327       "BC"
     2328       view-as alert-box error
     2329     .
     2330   END.
     2331   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2332   DO:
     2333   if line-mode = 'ПРОСМОТР':U then do:
     2334       stp-cycle  =  false.
     2335       stp-exit  =  true .
     2336       return.
     2337   end.
     2338   define variable compare-log as logical no-undo .
     2339   if line-mode <> "ЦИКЛ":u   then do:
     2340       BUFFER-COMPARE  tt-ord-line to tmp#zakaz save result in compare-log no-error.
     2341       if compare-log = false then do:
     2342           message "Вы действительно хотите выйти без сохранения изменений ?" view-as alert-box question
     2343                   buttons yes-no   update jjj as logical .
     2344                   if jjj = true then do:
     2345                        BUFFER-COPY tt-ord-line to  tmp#zakaz .
     2346                   end.
     2347                   else do:
     2348                     return no-apply .
     2349                   end.
     2350       end.
     2351   end.
     2352     stp-cycle  =  false.
     2353     stp-exit  =  true .
     2354     return "error".
     2355   END.
     2356   ON CHOOSE OF b-exit-cycl IN FRAME Dialog-Frame
     2357   DO:
     2358     assign
     2359        stp-cycle  =  true
     2360        stp-exit   =  false.
     2361        .
     2362   END.
     2363   ON CHOOSE OF B-prt IN FRAME Dialog-Frame
     2364   DO:
     2365   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2366     find current TMP#zakaz no-lock no-error  .
     2367     if error-status :error or  not avail TMP#zakaz   then do:
     2368          message "Не выбрана строка заказа" .
     2369          return.
     2370          end.
     2371     find first ub.goods no-lock where ub.goods.prod-type = tmp#zakaz.prod-type and
     2372                                    ub.goods.prod-code = tmp#zakaz.prod-code and
     2373                                    ub.goods.artic     = tmp#zakaz.artic   no-error.
     2374         run cus/ord-p.p
     2375         ( parParentProc
     2376         , ?
     2377         , recid(TMP#zakaz)
     2378         , recid(goods)
     2379         , (If t-action = "lkp":U then  'ПРОСМОТР':U  else 'ШКАЛА':U )
     2380         , input TMP#zakaz.qnty
     2381         , input TMP#zakaz.cli-qnty
     2382         ) .
     2383   END.
     2384   ON CHOOSE OF B-qnty IN FRAME Dialog-Frame
     2385   DO:
     2386     MESSAGE "Режим отключен" VIEW-AS ALERT-BOX INFORMATION.
     2387   END.
     2388   ON CHOOSE OF r-units IN FRAME Dialog-Frame
     2389   DO:
     2390   define variable ref-rec as recid no-undo.
     2391     define buffer bf-r-units for ub.units.
     2392     run ref/units.w ( parparentproc, yes, output ref-rec).
     2393     if ref-rec = ? then return no-apply.
     2394     find bf-r-units where recid (bf-r-units) = ref-rec no-lock.
     2395     ASSIGN tmp#zakaz.unit-cli  = bf-r-units.unit-name.
     2396     release bf-r-units.
     2397     display tmp#zakaz.unit-cli with frame Dialog-Frame.
     2398     apply "entry" to tmp#zakaz.cli-base-rate.
     2399   END.
     2400   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2401   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2402   assign
     2403     tmp#zakaz.sum-transport-rubl :label = "Сумма тр.налога (руб)"
     2404     tmp#zakaz.sum-other-rubl     :label = "Сумма др.налогов (руб)"
     2405   .
     2406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2407     (input  'edoc-nn'
     2408     ,input  ''
     2409     ,input  ''
     2410     ,input  0
     2411     ,input  ''
     2412     ,input  ''
     2413     ,input  ''
     2414     ,input  no
     2415     ,output par-is-edoc-nn
     2416     ,output par-type
     2417     ) no-error .
     2418   if error-status :error then is-edoc-nn = false .
     2419   assign
     2420     is-edoc-nn = lookup(par-is-edoc-nn, "true,yes":U) > 0
     2421   .
     2422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2423     (input  'is-edi'
     2424     ,input  ''
     2425     ,input  ''
     2426     ,input  0
     2427     ,input  ''
     2428     ,input  ''
     2429     ,input  ''
     2430     ,input  no
     2431     ,output par-is-edi
     2432     ,output par-type
     2433     ) no-error .
     2434   if error-status :error then is-edi = false .
     2435   assign
     2436     is-edi = lookup(par-is-edi, "true,yes":U) > 0
     2437   .
     2438   run edoc-nn-proc in this-procedure .
     2439   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2440   ON LEAVE OF tmp#zakaz.cli-qnty IN FRAME Dialog-Frame
     2441   DO:
     2442   define variable varprt-obj_free-qnty like ub.prt-obj.free-qnty no-undo.
     2443   IF CAN-FIND(FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-cli
     2444                       and LOOKUP('шту':U, ub.units.type) > 0 )  AND
     2445      TRUNC(input frame Dialog-Frame tmp#zakaz.cli-qnty, 0)
     2446      <>    input frame Dialog-Frame tmp#zakaz.cli-qnty
     2447      THEN DO:
     2448         MESSAGE "Единица изм поставщика " ub.goods.unit-cli " - штучная." skip
     2449                 "Кол-во должно быть целым."
     2450         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     2451         RETURN NO-APPLY.
     2452     END.
     2453   if ub.goods.qnty-cart <> 0 then do:
     2454     if input frame Dialog-Frame tmp#zakaz.cli-qnty / ub.goods.qnty-cart -
     2455     truncate ( input frame Dialog-Frame tmp#zakaz.cli-qnty / ub.goods.qnty-cart , 0 ) <> 0 then do:
     2456         g#log = yes.
     2457         message "Товар рекомендуется выписывать упаковками." skip (2)
     2458                 "Округлить до целого числа упаковок ?"
     2459                  view-as alert-box question buttons yes-no update g#log .
     2460         if g#log then do:
     2461           if round (input frame Dialog-Frame tmp#zakaz.cli-qnty / ub.goods.qnty-cart, 0) = 0 then do:
     2462             display
     2463                 ub.goods.qnty-cart @ tmp#zakaz.cli-qnty
     2464                 with frame Dialog-Frame.
     2465           end.
     2466           else do:
     2467             display
     2468               round ( input frame Dialog-Frame tmp#zakaz.cli-qnty / ub.goods.qnty-cart, 0) * ub.goods.qnty-cart @ tmp#zakaz.cli-qnty
     2469               with frame Dialog-Frame.
     2470           end.
     2471         end.
     2472     end.
     2473   end.
     2474    if tmp#zakaz.cli-base-rate:sensitive in frame dialog-frame then do:
     2475       assign
     2476         KK = input frame Dialog-Frame tmp#zakaz.cli-base-rate
     2477         tmp#zakaz.cli-base-rate = input frame Dialog-Frame tmp#zakaz.cli-base-rate.
     2478       .
     2479       end.
     2480    else do:
     2481       if b-ord-line.cli-base-rate = 0 or b-ord-line.cli-base-rate = ? then
     2482       kk = ub.goods.cli-base-rate.
     2483       else KK = b-ord-line.cli-base-rate.
     2484     end.
     2485     if lookup('cli-base-rate',parcli-qnty-calc) = 0 then do:
     2486     assign
     2487       tot-cli = input frame Dialog-Frame tmp#zakaz.price-cli * input frame Dialog-Frame tmp#zakaz.cli-qnty
     2488       tmp#zakaz.qnty = ( input frame Dialog-Frame tmp#zakaz.cli-qnty ) * kk .
     2489       DISPLAY  tot-cli tmp#zakaz.qnty   WITH FRAME Dialog-Frame.
     2490          tmp#zakaz.cli-base-rate = kk .
     2491          DISPLAY   tmp#zakaz.cli-base-rate WITH FRAME Dialog-Frame.
     2492     apply "leave" to tmp#zakaz.qnty .
     2493     DISPLAY  tot-cli tmp#zakaz.qnty WITH FRAME Dialog-Frame.
     2494     run ass-var in this-procedure .
     2495     end.
     2496   END.
     2497   ON LEAVE OF tmp#zakaz.qnty IN FRAME Dialog-Frame
     2498   DO:
     2499     define variable t-sum like tmp#zakaz.qnty no-undo .
     2500     t-sum = 0.
     2501     for each tmp#zakaz-dtl where
     2502         tmp#zakaz-dtl.artic     = tmp#zakaz.artic and
     2503         tmp#zakaz-dtl.prod-type = tmp#zakaz.prod-type and
     2504         tmp#zakaz-dtl.prod-code = tmp#zakaz.prod-code  :
     2505         t-sum = t-sum + tmp#zakaz-dtl.qnty.
     2506      end.
     2507      if t-sum > tmp#zakaz.qnty then do:
     2508         MESSAGE "Количество по признакам больше чем по строке товара ! " skip t-sum
     2509         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     2510         return no-apply.
     2511      end.
     2512    IF CAN-FIND(FIRST ub.units WHERE ub.units.unit-name = ub.goods.unit-base
     2513                       and LOOKUP('шту':U, ub.units.type) > 0)  AND
     2514      TRUNC(input frame Dialog-Frame tmp#zakaz.qnty, 0)
     2515      <>    input frame Dialog-Frame tmp#zakaz.qnty
     2516      THEN DO:
     2517         MESSAGE "Базовая единица товара " ub.goods.unit-base " - штучная." skip
     2518                 "Кол-во по факту должно быть целым."
     2519         VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     2520         RETURN no-apply.
     2521     END.
     2522    if pardoc-qnty-input = true then do:
     2523       if lookup('cli-base-rate',parcli-qnty-calc) > 0 then do:
     2524        assign
     2525           kk = (input frame Dialog-Frame tmp#zakaz.qnty) / (input frame Dialog-Frame tmp#zakaz.cli-qnty )
     2526        .
     2527        if kk  = ? then kk = 1.
     2528        b-ord-line.cli-base-rate = kk  .
     2529       end.
     2530       else do:
     2531           if b-ord-line.cli-base-rate = 0 or b-ord-line.cli-base-rate = ? then
     2532             kk = ub.goods.cli-base-rate .
     2533             else KK = b-ord-line.cli-base-rate .
     2534           assign
     2535               tmp#zakaz.cli-qnty = input frame Dialog-Frame tmp#zakaz.qnty / kk
     2536               tot-cli = input frame Dialog-Frame tmp#zakaz.price-cli * input frame Dialog-Frame tmp#zakaz.cli-qnty
     2537               .
     2538               DISPLAY  tot-cli tmp#zakaz.cli-qnty   WITH FRAME Dialog-Frame.
     2539                   tmp#zakaz.cli-base-rate = kk .
     2540                   DISPLAY   tmp#zakaz.cli-base-rate WITH FRAME Dialog-Frame.
     2541          end.
     2542     run ass-var in this-procedure .
     2543     end.
     2544   END.
     2545   ON LEAVE OF tmp#zakaz.price-base IN FRAME Dialog-Frame
     2546   DO:
     2547   if input frame Dialog-Frame tmp#zakaz.price-base > 5000 and base-code = 1 then
     2548     message "Внимание !!!" skip (2)
     2549                     "ВАЛЮТНАЯ цена превышает 5,000 !" skip (2)
     2550                     "Вы не ошиблись ?".
     2551   if tmp#zakaz.price-base <> input frame Dialog-Frame tmp#zakaz.price-base then
     2552     assign
     2553       tmp#zakaz.price-rubl = input frame Dialog-Frame tmp#zakaz.price-base * loc-base-rate / loc-base-scale
     2554       tmp#zakaz.price-cli  = tmp#zakaz.price-rubl / loc-exch-rate * loc-exch-scale *
     2555       tmp#zakaz.cli-base-rate
     2556       .
     2557       DISPLAY
     2558       tmp#zakaz.price-RUBL
     2559       tmp#zakaz.price-cli
     2560       WITH FRAME Dialog-Frame .
     2561    run ass-var in this-procedure  .
     2562   END.
     2563   ON LEAVE OF tmp#zakaz.price-rubl IN FRAME Dialog-Frame
     2564   DO:
     2565   if tmp#zakaz.price-rubl <> input frame Dialog-Frame tmp#zakaz.price-rubl then
     2566     assign
     2567       tmp#zakaz.price-base = input frame Dialog-Frame tmp#zakaz.price-rubl / loc-base-rate * loc-base-scale
     2568       tmp#zakaz.price-cli  = input frame Dialog-Frame tmp#zakaz.price-rubl / loc-exch-rate * loc-exch-scale /
     2569       tmp#zakaz.cli-base-rate
     2570       .
     2571       DISPLAY
     2572       tmp#zakaz.price-base
     2573       tmp#zakaz.price-cli
     2574       WITH FRAME Dialog-Frame .
     2575       run ass-var in this-procedure .
     2576   END.
     2577   ON LEAVE OF tmp#zakaz.price-cli IN FRAME Dialog-Frame
     2578   DO:
     2579   if tmp#zakaz.price-cli <> input frame Dialog-Frame tmp#zakaz.price-cli then
     2580     assign
     2581       tot-cli = input frame Dialog-Frame tmp#zakaz.price-cli *  input frame Dialog-Frame tmp#zakaz.cli-qnty
     2582       .
     2583    run ass-var in this-procedure .
     2584   END.
     2585   ON LEAVE OF tmp#zakaz.cli-base-rate IN FRAME Dialog-Frame
     2586   DO:
     2587     run proc-c-b-r in this-procedure .
     2588   END.
     2589   procedure proc-c-b-r:
     2590    assign frame Dialog-Frame  tmp#zakaz.cli-base-rate.
     2591    if lookup ("doc-qnty", parcli-base-rate-calc) > 0 then do:
     2592       apply "leave" to tmp#zakaz.cli-qnty in frame Dialog-Frame .
     2593       end.
     2594    if lookup ("cli-qnty", parcli-base-rate-calc) > 0 then do:
     2595       apply "leave" to tmp#zakaz.qnty in frame Dialog-Frame .
     2596       end.
     2597    run ass-var in this-procedure .
     2598   END procedure.
     2599   ON LEAVE OF tmp#zakaz.excise ,
     2600               tmp#zakaz.other-base ,
     2601               tmp#zakaz.other-rubl,
     2602               tmp#zakaz.road-tax ,
     2603               tmp#zakaz.transport-base ,
     2604               tmp#zakaz.transport-rubl ,
     2605               tmp#zakaz.sum-vat
     2606               IN FRAME Dialog-Frame
     2607   do:
     2608     run ass-var in this-procedure .
     2609   end.
     2610   on leave of tmp#zakaz.sum-vat in frame Dialog-Frame do:
     2611      if input frame Dialog-Frame tmp#zakaz.sum-vat <> tmp#zakaz.sum-vat then do:
     2612        if input frame Dialog-Frame tmp#zakaz.price-cli <> 0 and
     2613           input frame Dialog-Frame tmp#zakaz.sum-vat >=
     2614           (input frame Dialog-Frame tmp#zakaz.cli-qnty * input frame Dialog-Frame tmp#zakaz.price-cli -
     2615            (if vat_type = 'в т. ч.':U then input frame Dialog-Frame tmp#zakaz.sum-vat else 0))
     2616           then do:
     2617           message "НДС не может быть больше 99.999...%" skip
     2618                   "НДС:"  input frame Dialog-Frame tmp#zakaz.sum-vat skip
     2619                   "Сумма:" input frame Dialog-Frame tmp#zakaz.cli-qnty * input frame Dialog-Frame tmp#zakaz.price-cli
     2620                   view-as alert-box error.
     2621           display tmp#zakaz.sum-vat with frame Dialog-Frame.
     2622           return no-apply.
     2623        end.
     2624        else do:
     2625          if input frame Dialog-Frame tmp#zakaz.sum-vat = 0.00 then do:
     2626             g#log = no.
     2627             message "Вы хотите установить НДС в 0?"
     2628             view-as alert-box question buttons yes-no update g#log.
     2629             if g#log = yes then do:
     2630                assign frame Dialog-Frame tmp#zakaz.sum-vat.
     2631                run calc-vat-pc in this-procedure .
     2632             end.
     2633             else do:
     2634                 display tmp#zakaz.sum-vat with frame Dialog-Frame.
     2635                 return no-apply.
     2636             end.
     2637          end.
     2638          else do:
     2639             assign frame Dialog-Frame tmp#zakaz.sum-vat.
     2640             run calc-vat-pc in this-procedure .
     2641          end.
     2642        end.
     2643      end.
     2644   end.
     2645   procedure calc-vat-pc:
     2646     tmp#zakaz.vat-pc = (input frame Dialog-Frame tmp#zakaz.sum-vat / (input frame Dialog-Frame tmp#zakaz.cli-qnty * input frame Dialog-Frame tmp#zakaz.price-cli
     2647              * ( 1 - (if slt_type = 'в т. ч.':U then (input frame Dialog-Frame tmp#zakaz.slt-pc / (100 + input frame Dialog-Frame tmp#zakaz.slt-pc)) else 0))
     2648             - (if vat_type =  'в т. ч.':U then input frame Dialog-Frame tmp#zakaz.sum-vat else 0))) * 100.
     2649     run ass-var in this-procedure .
     2650   end procedure.
     2651   ON LEAVE OF tmp#zakaz.vat-pc OR
     2652      LEAVE OF tmp#zakaz.SLT-pc IN FRAME Dialog-Frame DO:
     2653      if input frame Dialog-Frame tmp#zakaz.vat-pc <> tmp#zakaz.vat-pc or
     2654         input frame Dialog-Frame tmp#zakaz.slt-pc <> tmp#zakaz.slt-pc then do:
     2655         if vat-sumvalue <> "yes" then do:
     2656            IF INDEX(input frame Dialog-Frame tmp#zakaz.vat-pc, dops) = 0 then do:
     2657               message "Неверное значение НДС:" input frame Dialog-Frame tmp#zakaz.vat-pc  SKIP
     2658                       "Разрешенные значения: " dops "."
     2659                       view-as alert-box.
     2660               display tmp#zakaz.vat-pc with frame Dialog-Frame.
     2661               return no-apply.
     2662            end.
     2663            IF INDEX(input frame Dialog-Frame tmp#zakaz.slt-pc, dop-slt) = 0 then do:
     2664               message "Неверное значение НсП."   SKIP
     2665                       "Разрешенные значения: " dop-slt "."
     2666                       view-as alert-box.
     2667               display tmp#zakaz.slt-pc with frame Dialog-Frame.
     2668               return no-apply.
     2669            end.
     2670         end.
     2671         assign frame Dialog-Frame tmp#zakaz.vat-pc
     2672                frame Dialog-Frame tmp#zakaz.slt-pc.
     2673         run ass-var in this-procedure .
     2674      end.
     2675   END.
     2676   procedure disp-total:
     2677   define variable varprice-cli-dt                like ub.doc-line.price-rubl no-undo.
     2678   define variable varprice-cli-unit-base-dt      like ub.doc-line.price-rubl no-undo.
     2679   define variable varprice-road-tax-dt           like ub.doc-line.price-rubl no-undo.
     2680   define variable varprice-other-exp-dt          like ub.doc-line.price-rubl no-undo.
     2681   define variable varprice-transport-exp-dt      like ub.doc-line.price-rubl no-undo.
     2682   define variable varprice-without-abs-dt        like ub.doc-line.price-rubl no-undo.
     2683   define variable varprice-slt-dt                like ub.doc-line.price-rubl no-undo.
     2684   define variable varprice-no-slt-dt             like ub.doc-line.price-rubl no-undo.
     2685   define variable varprice-vat-dt                like ub.doc-line.price-rubl no-undo.
     2686   define variable varprice-no-vat-slt-dt         like ub.doc-line.price-rubl no-undo.
     2687   define variable varprice-rubl-dt               like ub.doc-line.price-rubl no-undo.
     2688   define variable varprice-road-tax-rubl-dt      like ub.doc-line.price-rubl no-undo.
     2689   define variable varprice-other-exp-rubl-dt     like ub.doc-line.price-rubl no-undo.
     2690   define variable varprice-transport-exp-rubl-dt like ub.doc-line.price-rubl no-undo.
     2691   define variable varprice-without-abs-rubl-dt   like ub.doc-line.price-rubl no-undo.
     2692   define variable varprice-slt-rubl-dt           like ub.doc-line.price-rubl no-undo.
     2693   define variable varprice-no-slt-rubl-dt        like ub.doc-line.price-rubl no-undo.
     2694   define variable varprice-vat-rubl-dt           like ub.doc-line.price-rubl no-undo.
     2695   define variable varprice-no-vat-slt-rubl-dt    like ub.doc-line.price-rubl no-undo.
     2696   define variable varprice-base-dt               like ub.doc-line.price-base no-undo.
     2697   define variable varprice-road-tax-base-dt      like ub.doc-line.price-base no-undo.
     2698   define variable varprice-other-exp-base-dt     like ub.doc-line.price-base no-undo.
     2699   define variable varprice-transport-exp-base-dt like ub.doc-line.price-base no-undo.
     2700   define variable varprice-without-abs-base-dt   like ub.doc-line.price-base no-undo.
     2701   define variable varprice-slt-base-dt           like ub.doc-line.price-base no-undo.
     2702   define variable varprice-no-slt-base-dt        like ub.doc-line.price-base no-undo.
     2703   define variable varprice-vat-base-dt           like ub.doc-line.price-base no-undo.
     2704   define variable varprice-no-vat-slt-base-dt    like ub.doc-line.price-base no-undo.
     2705   if  loc-base-rate =  0  and
     2706       loc-base-scale = 0  and
     2707       loc-exch-rate  = 0  and
     2708       loc-exch-scale = 0  then return.
     2709   if vat_type = "" or vat_type = ? then do:
     2710   assign
     2711        vat_type   = 'в т. ч.':U
     2712        slt_type   = 'без':U
     2713   .
     2714   end.
     2715   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
     2716     (
     2717      input   'zakaz':u
     2718     ,input   loc-base-rate
     2719     ,input   loc-base-scale
     2720     ,input   loc-exch-rate
     2721     ,input   loc-exch-scale
     2722     ,input   vat_type
     2723     ,input   slt_type
