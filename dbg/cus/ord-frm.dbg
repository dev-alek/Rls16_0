     2769       tmp#zakaz.sum-slt    = varprice-slt-dt
     2770       tmp#zakaz.road-tax   = if var-report-r-b = "rubl" then   varprice-road-tax-rubl-dt else varprice-road-tax-base-dt
     2771       tmp#zakaz.other-base = varprice-other-exp-base-dt
     2772       tmp#zakaz.other-rubl = varprice-other-exp-rubl-dt
     2773       tmp#zakaz.price-rubl = varprice-rubl-dt
     2774       tmp#zakaz.price-base = varprice-base-dt
     2775       tmp#zakaz.price-cli  = varprice-cli-dt
     2776        .
     2777   end procedure.
     2778   procedure ass-var :
     2779    do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2780    assign
     2781       pargds-code =  ub.goods.gds-code
     2782       parobj-type =  loc-store-type
     2783       parobj-code =  loc-store-code
     2784    .
     2785   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_kndinpin in g#lib-calc
     2786     (
     2787      input  pargds-code
     2788     ,input  loc-cli-type
     2789     ,input  loc-cli-code
     2790     ,input  parobj-type
     2791     ,input  parobj-code
     2792     ,output parext-gds-type
     2793     ,output parcli-qnty-input
     2794     ,output pardensity-input
     2795     ,output parcli-base-rate-input
     2796     ,output pardoc-qnty-input
     2797     ,output parfact-qnty-input
     2798     ,output parprice-cli-input
     2799     ,output parbase-price-input
     2800     ,output partax-3-input
     2801     ,output parcli-qnty-calc
     2802     ,output pardensity-calc
     2803     ,output parcli-base-rate-calc
     2804     ,output pardoc-qnty-calc
     2805     ,output parfact-qnty-calc
     2806     ,output parprice-cli-calc
     2807     ,output parbase-price-calc
     2808     ,output partax-3-calc
     2809     ,output parround
     2810     ) no-error.
     2811   if error-status :error then message
     2812     vss-workfile vss-revision vss-description skip
     2813     error-status :get-message(1) skip
     2814     return-value skip
     2815     "1"
     2816     view-as alert-box error
     2817   .
     2818   if  parext-gds-type =  'sg':U then
     2819     do:
     2820      assign
     2821       parcli-qnty-input   = true
     2822       parprice-cli-input  = true
     2823      .
     2824     end.
     2825   if g#type =  'ОФ':U then
     2826   assign
     2827   parbase-price-my = false
     2828   parbase-price-input = false
     2829   parprice-cli-input  = false
     2830   .
     2831   else
     2832   assign
     2833     parbase-price-my = true
     2834   .
     2835   run tax-name in this-procedure (input 'rdt':U, output varroad-tax-label) no-error.
     2836   assign
     2837     tmp#zakaz.road-tax:label in frame Dialog-Frame = varroad-tax-label
     2838      .
     2839   if parbase-price-calc = 'cli-price' then do:
     2840    assign  frame Dialog-Frame tmp#zakaz.cli-art tmp#zakaz.VAT-pc tmp#zakaz.cli-qnty tmp#zakaz.SLT-pc tmp#zakaz.qnty tmp#zakaz.price-cli tmp#zakaz.line-num tmp#zakaz.cancel-date tmp#zakaz.road-tax tmp#zakaz.excise tmp#zakaz.transport-base tmp#zakaz.other-base tmp#zakaz.transport-rubl tmp#zakaz.other-rubl tmp#zakaz.artic tmp#zakaz.prod-type tmp#zakaz.prod-code tmp#zakaz.sum-SLT tmp#zakaz.sum-cli tmp#zakaz.sum-base tmp#zakaz.sum-rubl tmp#zakaz.sum-road-tax tmp#zakaz.sum-excise tmp#zakaz.sum-transport-base tmp#zakaz.sum-other-base tmp#zakaz.sum-transport-rubl tmp#zakaz.sum-other-rubl tmp#zakaz.price-rubl tmp#zakaz.price-base .
     2841    assign
     2842       tmp#zakaz.sum-rubl = input frame Dialog-Frame tmp#zakaz.price-rubl  * input frame Dialog-Frame tmp#zakaz.qnty
     2843       tmp#zakaz.sum-base = tmp#zakaz.price-base  * input frame Dialog-Frame tmp#zakaz.qnty
     2844       tmp#zakaz.sum-cli  = tmp#zakaz.price-cli   * input frame Dialog-Frame tmp#zakaz.cli-qnty
     2845       tot-rubl     = input frame Dialog-Frame tmp#zakaz.price-rubl * input frame Dialog-Frame tmp#zakaz.qnty
     2846       tot-base     = tmp#zakaz.price-base * input frame Dialog-Frame tmp#zakaz.qnty
     2847       tot-cli      = tmp#zakaz.price-cli  * input frame Dialog-Frame tmp#zakaz.cli-qnty
     2848       .
     2849   end.
     2850   else do:
     2851      assign  frame Dialog-Frame tmp#zakaz.cli-art tmp#zakaz.VAT-pc tmp#zakaz.cli-qnty tmp#zakaz.SLT-pc tmp#zakaz.qnty tmp#zakaz.price-cli tmp#zakaz.line-num tmp#zakaz.cancel-date tmp#zakaz.road-tax tmp#zakaz.excise tmp#zakaz.transport-base tmp#zakaz.other-base tmp#zakaz.transport-rubl tmp#zakaz.other-rubl tmp#zakaz.artic tmp#zakaz.prod-type tmp#zakaz.prod-code tmp#zakaz.sum-SLT tmp#zakaz.sum-cli tmp#zakaz.sum-base tmp#zakaz.sum-rubl tmp#zakaz.sum-road-tax tmp#zakaz.sum-excise tmp#zakaz.sum-transport-base tmp#zakaz.sum-other-base tmp#zakaz.sum-transport-rubl tmp#zakaz.sum-other-rubl.
     2852    assign
     2853       tmp#zakaz.sum-rubl = tmp#zakaz.price-rubl  * input frame Dialog-Frame tmp#zakaz.qnty
     2854       tmp#zakaz.sum-base = tmp#zakaz.price-base  * input frame Dialog-Frame tmp#zakaz.qnty
     2855       tmp#zakaz.sum-cli  = input frame Dialog-Frame tmp#zakaz.price-cli   * input frame Dialog-Frame tmp#zakaz.cli-qnty
     2856       tot-rubl     = tmp#zakaz.price-rubl * input frame Dialog-Frame tmp#zakaz.qnty
     2857       tot-base     = tmp#zakaz.price-base * input frame Dialog-Frame tmp#zakaz.qnty
     2858       tot-cli      = input frame Dialog-Frame tmp#zakaz.price-cli  * input frame Dialog-Frame tmp#zakaz.cli-qnty
     2859       .
     2860   end.
     2861    assign
     2862       tmp#zakaz.sum-excise          = input frame Dialog-Frame tmp#zakaz.excise         * input frame Dialog-Frame tmp#zakaz.qnty
     2863       tmp#zakaz.sum-other-base      = input frame Dialog-Frame tmp#zakaz.other-base     * input frame Dialog-Frame tmp#zakaz.qnty
     2864       tmp#zakaz.sum-other-rubl      = input frame Dialog-Frame tmp#zakaz.other-rubl     * input frame Dialog-Frame tmp#zakaz.qnty
     2865       tmp#zakaz.sum-road-tax        = input frame Dialog-Frame tmp#zakaz.road-tax       * input frame Dialog-Frame tmp#zakaz.qnty
     2866       tmp#zakaz.sum-transport-base  = input frame Dialog-Frame tmp#zakaz.transport-base * input frame Dialog-Frame tmp#zakaz.qnty
     2867       tmp#zakaz.sum-transport-rubl  = input frame Dialog-Frame tmp#zakaz.transport-rubl * input frame Dialog-Frame tmp#zakaz.qnty
     2868       .
     2869   run disp-total in this-procedure .
     2870    enable
     2871         tmp#zakaz.qnty           when pardoc-qnty-input = true
     2872         tmp#zakaz.cli-qnty       when parcli-qnty-input = true
     2873         tmp#zakaz.price-base
     2874         tmp#zakaz.price-rubl     when parbase-price-input = true
