     1380   define variable v-file-name as character no-undo .
     1381   define variable p-file-name as character no-undo .
     1382   define variable v-ind       as integer   no-undo .
     1383   define variable num#col#    as integer no-undo .
     1384   define variable C-c         as integer no-undo .
     1385   define variable C-str       as character no-undo .
     1386   define variable str--1      as character Format "x(60)" no-undo.
     1387   define variable str--2      as integer no-undo .
     1388   define variable C-i         as integer no-undo .
