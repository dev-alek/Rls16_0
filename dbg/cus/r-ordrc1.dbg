     1391   define variable var-2       as integer no-undo .
     1392   v-ind = 0    .
     1393    run paramls-clear in this-procedure .
     1394    run paramls-write in this-procedure
     1395       (input 'rowsgroup-enable':u
     1396       ,input '':u
     1397       ,input 'yes':u
     1398       ) .
     1399   output stream Macr_Excel close .
     1400   num#str# = 0 .
