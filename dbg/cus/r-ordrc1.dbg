     2028       ,output temp-prod.acc-day-trn         ).
     2029   assign num#col# = 5 .
     2030   run macr_excel_dec in this-procedure ( temp-prod.initial-qnty        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2031   run macr_excel_dec in this-procedure ( temp-prod.order-qnty          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2032   run macr_excel_dec in this-procedure ( temp-prod.qnty                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2033   run macr_excel_dec in this-procedure ( temp-prod.prc_qnty_order-qnty , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2034   run macr_excel_dec in this-procedure ( temp-prod.fact-qnty           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2035   run macr_excel_dec in this-procedure ( temp-prod.prc_fact-qnty_qnty  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2036   run macr_excel_dec in this-procedure ( temp-prod.account-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2037   run macr_excel_dec in this-procedure ( temp-prod.mean-order          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2038   run macr_excel_char in this-procedure ( temp-prod.acc-day-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2039   run macr_excel_dec in this-procedure ( temp-prod.acc-day-trn         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2040     end.
     2041   end procedure.
     2042   procedure PrintDet :
     2043     do
     2044     on error undo, return error return-value
     2045     :
     2046     case p-classify :
     2047     when "no-classify" then do:
     2048           case p-sorttype :
     2049               when "sort-code" then do:
     2050                     for each temp-main no-lock where
     2051                         temp-main.obj-type = temp-obj.obj-type  and
     2052                         temp-main.obj-code = temp-obj.obj-code
     2053                         break by temp-main.gds-code
     2054                         :
     2055                         run print-line in this-procedure .
     2056                     end.
     2057               end.
     2058               when "sort-artic" then do:
     2059                     for each temp-main no-lock where
     2060                         temp-main.obj-type = temp-obj.obj-type  and
     2061                         temp-main.obj-code = temp-obj.obj-code
     2062                         break by temp-main.artic
     2063                         :
     2064                         run print-line in this-procedure .
     2065                     end.
     2066               end.
     2067               when "sort-name" then do:
     2068                     for each temp-main no-lock where
     2069                         temp-main.obj-type = temp-obj.obj-type  and
     2070                         temp-main.obj-code = temp-obj.obj-code
     2071                         break by temp-main.gds-name
     2072                         :
     2073                         run print-line in this-procedure .
     2074                     end.
     2075               end.
     2076           end case.
     2077     end.
     2078     when "prod" then do:
     2079         for each temp-prod where
     2080                  temp-prod.obj-type = temp-obj.obj-type  and
     2081                  temp-prod.obj-code = temp-obj.obj-code
     2082                  :
     2083            if not (can-find (first temp-main where
     2084                                   temp-main.prod-codetype = temp-prod.prod-codetype and
     2085                                   temp-main.obj-type = temp-obj.obj-type  and
     2086                                   temp-main.obj-code = temp-obj.obj-code  )) then next.
     2087             i-numb = i-numb + 1 .
     2088             number-group = string ( i-numb , "99999" ) .
     2089               run print-prod-name in this-procedure ( output v-row ) .
     2090               case p-sorttype :
     2091                   when "sort-code" then do:
     2092                         for each temp-main where
     2093                                  temp-main.prod-codetype = temp-prod.prod-codetype and
     2094                                  temp-main.obj-type = temp-obj.obj-type  and
     2095                                  temp-main.obj-code = temp-obj.obj-code
     2096                                  no-lock break by temp-main.gds-code
     2097                                  :
     2098                             run print-line in this-procedure .
     2099                         end.
     2100                   end.
     2101                   when "sort-artic" then do:
     2102                         for each temp-main where
     2103                             temp-main.prod-codetype = temp-prod.prod-codetype and
     2104                             temp-main.obj-type = temp-obj.obj-type  and
     2105                             temp-main.obj-code = temp-obj.obj-code
     2106                             no-lock break by temp-main.artic
     2107                             :
     2108                             run print-line in this-procedure .
     2109                         end.
     2110                   end.
     2111                   when "sort-name" then do:
     2112                         for each temp-main where
     2113                           temp-main.prod-codetype = temp-prod.prod-codetype and
     2114                           temp-main.obj-type = temp-obj.obj-type  and
     2115                           temp-main.obj-code = temp-obj.obj-code
     2116                           no-lock break by temp-main.gds-name
     2117                           :
     2118                             run print-line in this-procedure .
     2119                         end.
     2120                   end.
     2121               end case.
     2122               run print-prod-itogo in this-procedure ( input v-row ) .
     2123         end.
     2124     end.
     2125     when "grp-goods" then do:
     2126           for each temp-grp where
     2127                    temp-grp.obj-type = temp-obj.obj-type  and
     2128                    temp-grp.obj-code = temp-obj.obj-code :
     2129            if not (can-find ( first temp-main where
     2130                             temp-main.grp-code = temp-grp.grp-code and
     2131                             temp-main.obj-type = temp-obj.obj-type and
     2132                             temp-main.obj-code = temp-obj.obj-code)
     2133                             ) then next.
     2134               i-numb = i-numb + 1 .
     2135               number-group = string ( i-numb , "99999" ) .
     2136                 run print-grp-name in this-procedure ( output v-row ) .
     2137                 case p-sorttype :
     2138                     when "sort-code" then do:
     2139                           for each temp-main where
     2140                                    temp-main.grp-code = temp-grp.grp-code and
     2141                                    temp-main.obj-type = temp-obj.obj-type and
     2142                                    temp-main.obj-code = temp-obj.obj-code
     2143                                    no-lock break by temp-main.gds-code :
     2144                               run print-line in this-procedure .
     2145                           end.
     2146                     end.
     2147                     when "sort-artic" then do:
     2148                           for each temp-main where
     2149                                    temp-main.grp-code = temp-grp.grp-code and
     2150                                    temp-main.obj-type = temp-obj.obj-type and
     2151                                    temp-main.obj-code = temp-obj.obj-code
     2152                                    no-lock break by temp-main.artic :
     2153                               run print-line in this-procedure .
     2154                           end.
     2155                     end.
     2156                     when "sort-name" then do:
     2157                           for each temp-main where
     2158                                    temp-main.grp-code = temp-grp.grp-code  and
     2159                                    temp-main.obj-type = temp-obj.obj-type  and
     2160                                    temp-main.obj-code = temp-obj.obj-code
     2161                                    no-lock break by temp-main.gds-name :
     2162                               run print-line in this-procedure .
     2163                           end.
     2164                     end.
     2165                 end case.
     2166                 run print-grp-itogo in this-procedure ( input v-row ) .
     2167           end.
     2168     end.
     2169     end case.
     2170     end.
     2171   end procedure.
     2172   procedure PrintObj :
     2173   define output parameter p-row as integer   no-undo .
     2174   define buffer buf_clients for ub.clients  .
     2175     do
     2176     on error undo, return error return-value
     2177     :
     2178   if p-tog-obj = false then return .
     2179   i-numb = i-numb + 1 .
     2180   number-group = string ( i-numb , "99999" ) .
     2181   num#str# = num#str# + 1 .
     2182   num#col# = 1 .
     2183   find first buf_clients no-lock where
     2184              buf_clients.obj-code = temp-obj.obj-code and
     2185              buf_clients.obj-type = temp-obj.obj-type no-error .
     2186   run macr_excel_char in this-procedure ( buf_clients.obj-name , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2187       run macr_cell_format in this-procedure
     2188           ( 12       ,
     2189             true     ,
     2190             false    ,
     2191             36        ,
     2192             num#str# ,
     2193             1        ,
     2194             num#str# ,
     2195             14       ) .
     2196      p-row =  num#str# .
     2197     end.
     2198   end procedure.
     2199   procedure PrintObji :
     2200   define input  parameter p-row as integer   no-undo .
     2201   define buffer buf_clients for ub.clients  .
     2202     do
     2203     on error undo, return error return-value
     2204     :
     2205   if p-tog-obj = false then return .
     2206   if p-classify = "no-classify" then do:
     2207       run paramls-write in this-procedure
     2208         (input "rowsgroup"
     2209         ,input string(v-ind) + ',':u + number-group
     2210         ,input substitute('&1:&2' ,  p-row, num#str# )
     2211         ) .
     2212   end.
     2213   find first buf_clients no-lock where
     2214              buf_clients.obj-code = temp-obj.obj-code and
     2215              buf_clients.obj-type = temp-obj.obj-type no-error .
     2216   num#str# = num#str# + 1.
     2217   num#col# = 1.
     2218       run macr_cell_format in this-procedure
     2219           ( ?     ,
     2220             true   ,
     2221             false  ,
     2222             ?      ,
     2223             num#str# ,
     2224             1      ,
     2225             num#str# ,
     2226             14 ) .
     2227   run macr_excel_char in this-procedure ( "Итого по объекту " , num#str# , num#col#   ) .
     2228    assign    num#col# = num#col# + 1 .
     2229    assign    num#col# = num#col# + 1 .
     2230   run macr_excel_char in this-procedure ( buf_clients.obj-name , num#str# , num#col#   ) .
     2231   run re-calc in this-procedure (
     2232        input  temp-obj.order-qnty
     2233       ,input  temp-obj.qnty
     2234       ,input  temp-obj.fact-qnty
     2235       ,input  temp-obj.account-order
     2236       ,input  temp-obj.date1
     2237       ,input  temp-obj.date2
     2238       ,input  temp-obj.str
     2239       ,output temp-obj.prc_fact-qnty_qnty
     2240       ,output temp-obj.prc_qnty_order-qnty
     2241       ,output temp-obj.mean-order
     2242       ,output temp-obj.acc-day-order
     2243       ,output temp-obj.acc-day-trn         ).
     2244   assign num#col# = 5 .
     2245   run macr_excel_dec in this-procedure ( temp-obj.initial-qnty        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2246   run macr_excel_dec in this-procedure ( temp-obj.order-qnty          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2247   run macr_excel_dec in this-procedure ( temp-obj.qnty                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2248   run macr_excel_dec in this-procedure ( temp-obj.prc_qnty_order-qnty , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2249   run macr_excel_dec in this-procedure ( temp-obj.fact-qnty           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2250   run macr_excel_dec in this-procedure ( temp-obj.prc_fact-qnty_qnty  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2251   run macr_excel_dec in this-procedure ( temp-obj.account-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2252   run macr_excel_dec in this-procedure ( temp-obj.mean-order          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2253   run macr_excel_char in this-procedure ( temp-obj.acc-day-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2254   run macr_excel_dec in this-procedure ( temp-obj.acc-day-trn         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2255   end.
     2256   end procedure.
     2257   procedure re-calc :
     2258   define input  parameter p-order-qnty             as decimal   no-undo .
     2259   define input  parameter p-qnty                   as decimal   no-undo .
     2260   define input  parameter p-fact-qnty              as decimal   no-undo .
     2261   define input  parameter p-account-order          as decimal   no-undo .
     2262   define input  parameter p-date1                  as date      no-undo .
     2263   define input  parameter p-date2                  as date      no-undo .
     2264   define input  parameter p-str                    as character no-undo .
     2265   define output parameter p-prc_fact-qnty_qnty     as decimal   no-undo .
     2266   define output parameter p-prc_qnty_order-qnty    as decimal   no-undo .
     2267   define output parameter p-mean-order             as decimal   no-undo .
     2268   define output parameter p-acc-day-order          as character no-undo .
     2269   define output parameter p-acc-day-trn            as decimal   no-undo .
     2270     do
     2271     on error undo, return error return-value
     2272     :
     2273   assign
     2274     p-prc_fact-qnty_qnty  = (if p-qnty = 0 then 0 else  p-fact-qnty /  p-qnty) * 100
     2275     p-prc_qnty_order-qnty = (if p-order-qnty = 0 then 0 else p-qnty / p-order-qnty) * 100
     2276     p-mean-order          =  if p-account-order  = 0 then 0 else p-qnty / p-account-order
     2277   .
     2278     if p-account-order <= 1
     2279         then p-acc-day-order  = "---".
     2280         else p-acc-day-order  = string ( ( p-date2 - p-date1  ) / ( p-account-order - 1 )  , "->>>>>>>>9.<<<<" )  .
     2281         if p-acc-day-order = ? then p-acc-day-order  = "---".
     2282   define variable v-kol as integer   no-undo .
     2283   define variable v-sum as decimal   no-undo .
     2284   p-str = trim(p-str,",") .
     2285   v-sum = 0.
     2286   define variable v-nnn as integer   no-undo .
     2287   v-nnn = num-entries ( p-str ) .
     2288   repeat v-kol = 1 to v-nnn :
     2289      v-sum = v-sum + integer ( entry ( v-kol , p-str ))  .
     2290   end.
     2291     p-acc-day-trn    = round( v-sum / v-kol  , 4 ) .
     2292     end.
     2293   end procedure.
     2294   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2295   procedure macr_excel_char :
     2296    do
     2297    on error undo, return error return-value
     2298    :
     2299    define input parameter  p-val as character no-undo .
     2300    define input parameter  p-row as integer no-undo .
     2301    define input parameter  p-col as integer no-undo .
     2302    if p-val = ? then p-val = "" .
     2303       put stream macr_excel unformatted
     2304             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2305    end.
     2306   end procedure.
     2307   procedure macr_excel_char_with_format :
     2308    do
     2309    on error undo, return error return-value
     2310    :
     2311    define input parameter  p-val as character no-undo .
     2312    define input parameter  p-row as integer no-undo .
     2313    define input parameter  p-col as integer no-undo .
     2314    if p-val = ? then p-val = "" .
     2315       put stream macr_excel unformatted
     2316             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2317       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2318       put stream macr_excel unformatted
     2319             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2320    end.
     2321   end procedure.
     2322   procedure macr_excel_cell_format :
     2323    do
     2324    on error undo, return error return-value
     2325    :
     2326    define input parameter  p-val    as character no-undo .
     2327    define input parameter  p-row    as integer   no-undo .
     2328    define input parameter  p-col    as integer   no-undo .
     2329    define input parameter  p-format as character no-undo .
     2330    if p-val = ? then p-val = "" .
     2331       put stream macr_excel unformatted
     2332             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2333       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2334       put stream macr_excel unformatted
     2335             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2336    end.
     2337   end procedure.
     2338   procedure macr_excel_sum :
     2339    do
     2340    on error undo, return error return-value
     2341    :
     2342    define input parameter  p-row as integer no-undo .
     2343    define input parameter  p-col as integer no-undo .
     2344    define input parameter  p-row1 as integer no-undo .
     2345    define input parameter  p-col1 as integer no-undo .
     2346    define input parameter  p-row2 as integer no-undo .
     2347    define input parameter  p-col2 as integer no-undo .
     2348       put stream macr_excel unformatted
     2349             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2350    end.
     2351   end procedure.
     2352   procedure macr_excel_dec :
     2353    do
     2354    on error undo, return error return-value
     2355    :
     2356    define input parameter  p-val as character no-undo .
     2357    define input parameter  p-row as integer   no-undo .
     2358    define input parameter  p-col as integer   no-undo .
     2359     if p-val = ? then p-val =  "" .
     2360      put  stream macr_excel unformatted
     2361           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2362    end.
     2363   end procedure.
     2364   procedure macr_cell_format :
     2365    do
     2366    on error undo, return error return-value
     2367    :
     2368    define input parameter  p-size   as integer   no-undo .
     2369    define input parameter  p-bold   as logical   no-undo .
     2370    define input parameter  p-italic as logical   no-undo .
     2371    define input parameter  p-color  as integer   no-undo .
     2372    define input parameter  p-row    as integer   no-undo .
     2373    define input parameter  p-col    as integer   no-undo .
     2374    define input parameter  p-row-2  as integer   no-undo .
     2375    define input parameter  p-col-2  as integer   no-undo .
     2376     if p-size = ? then p-size = 10 .
     2377     if p-bold = ? then p-bold = false .
     2378     if p-italic = ? then p-italic = false .
     2379     if p-row-2 = ? then p-row-2 = p-row .
     2380     if p-col-2 = ? then p-col-2 = p-col .
     2381     put  stream macr_excel unformatted
     2382      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2383     if p-color <> ? then do:
     2384        put  stream macr_excel unformatted
     2385          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2386     end.
     2387     put  stream macr_excel unformatted
     2388          substitute('format.font(,&1,&2,&3)' , p-size,
     2389                                           string ( p-bold  , "true/false" ) ,
     2390                                           string ( p-italic , "true/false" )
     2391                                           ) + chr(10) .
     2392    end.
     2393   end procedure.
     2394   procedure macr_cell_size :
     2395    do
     2396    on error undo, return error return-value
     2397    :
     2398    define input parameter  p-w   as integer   no-undo .
     2399    define input parameter  p-l   as integer   no-undo .
     2400    define input parameter  p-row    as integer   no-undo .
     2401    define input parameter  p-col    as integer   no-undo .
     2402    define input parameter  p-row-2  as integer   no-undo .
     2403    define input parameter  p-col-2  as integer   no-undo .
     2404     if p-row-2 = ? then p-row-2 = p-row .
     2405     if p-col-2 = ? then p-col-2 = p-col .
     2406     if p-w = ? then    p-w = 0 .
     2407     if p-l = ? then    p-l = 0 .
     2408    define variable s-w as character no-undo .
     2409    define variable s-l as character no-undo .
     2410    if p-w = 0 then s-w = "" .
     2411               else s-w = string(p-w)  .
     2412    if p-l = 0 then s-l = "" .
     2413               else s-l = string(p-l)  .
     2414   put  stream macr_excel unformatted
     2415        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2416   put  stream macr_excel unformatted
     2417        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2418   put  stream macr_excel unformatted
     2419        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2420    end.
     2421   end procedure.
     2422   procedure proc-print-header :
     2423    do
     2424    on error undo, return error return-value
     2425    :
     2426      find first sheetf .
     2427        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2428        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2429        var-1 =  num#str# .
     2430        repeat c-c = 1 to sheetf.excel-row-title :
     2431        num#str# = num#str# + 1 .
     2432        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2433        do c-i = 1 to p-var :
     2434           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2435           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2436           num#col# = c-i .
     2437           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2438           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2439        end.
     2440       c-i = 0.
     2441       end.
     2442       run macr_cell_format (
     2443           10       ,
     2444           true     ,
     2445           false    ,
     2446           35       ,
     2447           var-1 + 1,
     2448           1        ,
     2449           num#str# ,
     2450           num#col# )
     2451           .
     2452     put  stream macr_excel unformatted
     2453          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2454          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2455          .
     2456    end.
     2457   end procedure.
     2458   procedure end-proc :
     2459    do
     2460    on error undo, return error return-value
     2461    :
     2462     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2463     OUTPUT to VALUE (v-file-name) .
     2464     for each temp-param :
     2465       export  temp-param  .
     2466     end.
     2467    end.
     2468   end procedure.
     2469   procedure make-tt-prc :
     2470   define buffer buf_ord-doc      for ub.ord-doc  .
     2471   define variable v-gds as logical no-undo .
     2472     do
     2473     on error undo, return error return-value
     2474     :
     2475   empty temp-table temp-g.
     2476   if p-tog-prc = false then return .
     2477   v-gds = false .
     2478   find first gds-list no-error .
     2479   if available gds-list then v-gds = true  .
     2480     for each obj-list :
     2481       if p-OrdDate = "doc-date" then do :
     2482         for each buf_ord-doc no-lock where
     2483                 buf_ord-doc.cons-code = ""  and
     2484                 buf_ord-doc.doc-type  = 'ОР':U and
     2485                 buf_ord-doc.cli-type  = v-cntxt-obj-type and
     2486                 buf_ord-doc.cli-code  = v-cntxt-obj-code and
     2487                 buf_ord-doc.obj-type  = obj-list.obj-type and
     2488                 buf_ord-doc.obj-code  = obj-list.obj-code and
     2489                 buf_ord-doc.doc-date >= x-date-start and
     2490                 buf_ord-doc.doc-date <= x-date-end
     2491                 :
     2492                 run make-tt-prc-1 in this-procedure
     2493                   ( input buf_ord-doc.doc-code,
     2494                     input buf_ord-doc.obj-type,
     2495                     input buf_ord-doc.obj-code,
     2496                     input v-gds ) .
     2497         end.
     2498       end.
     2499       if p-OrdDate = "ship-date" then do :
     2500     for each buf_ord-doc no-lock where
     2501              buf_ord-doc.cons-code = ""  and
     2502              buf_ord-doc.doc-type  = 'ОР':U and
     2503              buf_ord-doc.cli-type  = v-cntxt-obj-type and
     2504              buf_ord-doc.cli-code  = v-cntxt-obj-code and
     2505              buf_ord-doc.obj-type  = obj-list.obj-type and
     2506              buf_ord-doc.obj-code  = obj-list.obj-code and
     2507                 buf_ord-doc.ship-date >= x-date-start and
     2508                 buf_ord-doc.ship-date <= x-date-end
     2509                 :
     2510                 run make-tt-prc-1 in this-procedure
     2511                   ( input buf_ord-doc.doc-code,
     2512                     input buf_ord-doc.obj-type,
     2513                     input buf_ord-doc.obj-code,
     2514                     input v-gds ) .
     2515         end.
     2516       end.
     2517     end.
     2518     for each temp-g :
     2519         if p-prc <= ( if temp-g.qnty = 0 then 0 else  (( temp-g.fact-qnty) /  temp-g.qnty ) * 100 )  then delete temp-g.
     2520     end.
     2521     end.
     2522   end procedure.
     2523   procedure make-tt-prc-1 :
     2524   define input parameter v-ord-doc-code like ub.ord-doc.doc-code .
     2525   define input parameter v-ord-obj-type like ub.ord-doc.obj-type .
     2526   define input parameter v-ord-obj-code like ub.ord-doc.obj-code .
     2527   define input parameter v-gds        as logical no-undo .
     2528   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv  .
     2529   define buffer buf_ord-line     for ub.ord-line  .
     2530   define buffer buf_trn-doc      for ub.trn-doc  .
     2531   define buffer buf_doc-line     for ub.doc-line  .
     2532   define buffer buf_clients      for ub.clients  .
     2533   define buffer buf1_ord-doc-rcv for ub.ord-doc-rcv  .
     2534   define buffer buf_goods        for ub.goods  .
     2535   define variable v-recid as recid no-undo .
     2536   define variable v-code as integer   no-undo .
     2537   define variable v-type as character no-undo .
     2538   define variable V-TRN-CODE as character no-undo .
     2539   define variable V-TRN-TYPE as character no-undo .
     2540   do
     2541   on error undo, return error return-value
     2542   :
     2543   v-code = if p-tog-obj then v-ord-obj-code else 0    .
     2544   v-type = if p-tog-obj then v-ord-obj-type else ""  .
     2545         for each buf_ord-line no-lock where
     2546             buf_ord-line.doc-code = v-ord-doc-code
     2547                  :
     2548                   v-recid = 0.
     2549             for each buf1_ord-doc-rcv no-lock where buf1_ord-doc-rcv.doc-code = v-ord-doc-code ,
     2550                       each ub.ord-chain no-lock where
     2551                            ub.ord-chain.doc-code = buf1_ord-doc-rcv.rcv-code and
     2552                            ub.ord-chain.doc-type = 'rcv'                     and
     2553                            ub.ord-chain.rel-doc-type = 'trn' ,
     2554                    first buf_trn-doc no-lock
     2555                     where  buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code and
     2556                       ( buf_trn-doc.doc-type = 'рас':U or buf_trn-doc.doc-type = 'возврат':U )
     2557                      :
     2558                      v-recid = recid(buf1_ord-doc-rcv).
     2559                      V-TRN-CODE = buf_trn-doc.doc-code .
     2560                 V-TRN-TYPE = buf_trn-doc.doc-type .
     2561                   end.
     2562                   find first buf_ord-doc-rcv no-lock where recid(buf_ord-doc-rcv) = v-recid no-error .
     2563                   find first buf_goods no-lock where buf_goods.gds-code = buf_ord-line.gds-code no-error .
     2564                   if v-gds = true  then do:
     2565                       find first gds-list where gds-list.gds-code = buf_ord-line.gds-code no-error .
     2566                       if not available gds-list then next.
     2567                   end.
     2568                   find first buf_doc-line no-lock where
     2569                              buf_doc-line.doc-code = v-trn-code and
     2570                              buf_doc-line.artic    = buf_ord-line.artic       and
     2571                              buf_doc-line.prod-type = buf_ord-line.prod-type  and
     2572                              buf_doc-line.prod-code = buf_ord-line.prod-code
     2573                              no-error .
     2574                   find first temp-g where
     2575                              temp-g.gds-code = buf_ord-line.gds-code and
     2576                              temp-g.obj-code = v-code  and
     2577                              temp-g.obj-type = v-type
     2578                              no-error .
     2579                   if not available temp-g then do:
     2580                     create temp-g.
     2581                     assign
     2582                       temp-g.gds-code      = buf_ord-line.gds-code
     2583                       temp-g.obj-code      = v-code
     2584                       temp-g.obj-type      = v-type
     2585                     .
     2586                   end.
     2587                   assign
     2588                     temp-g.qnty          = temp-g.qnty          +  buf_ord-line.qnty
     2589                   .
     2590                 if V-TRN-TYPE = 'рас':U then do :
     2591                   temp-g.fact-qnty     = temp-g.fact-qnty     +  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     2592         end.
     2593                 if V-TRN-TYPE = 'возврат':U then do :
     2594                   temp-g.fact-qnty     = temp-g.fact-qnty     +  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     2595     end.
     2596     end.
     2597     end.
     2598   end procedure.
