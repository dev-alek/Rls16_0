     1098   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1099   DEFINE BUTTON StopBtn AUTO-END-KEY
     1100        LABEL "Стоп"
     1101        SIZE 10 BY 1.
     1102   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1103        LABEL "Обработано записей"
     1104         VIEW-AS TEXT
     1105        SIZE 14 BY .67 NO-UNDO.
     1106   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1107         VIEW-AS TEXT
     1108        SIZE 53.25 BY .67
     1109        FGCOLOR 1  NO-UNDO.
     1110   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1111         VIEW-AS TEXT
     1112        SIZE 53.25 BY .67
     1113        FGCOLOR 1  NO-UNDO.
     1114   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1115         VIEW-AS TEXT
     1116        SIZE 53.25 BY .67
     1117        FGCOLOR 1  NO-UNDO.
     1118   DEFINE RECTANGLE RECT-1
     1119        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1120        SIZE 55.13 BY 4.46.
     1121   DEFINE FRAME InfoFrame
     1122        StopBtn AT ROW 4.25 COL 21.75
     1123        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1124        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1125        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1126        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1127        RECT-1 AT ROW 1 COL 1
     1128       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1129            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1130            TITLE "Процесс"
     1131            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1132   define variable mFrameView      as logical   no-undo init yes.
     1133     define variable mFramHandle as handle no-undo.
     1134     mFramHandle = frame InfoFrame:handle.
     1135     if  log-manager:logfile-name ne ?
     1136     then DO:
     1137         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1138         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1139         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1140     end.
     1141     mFrameView = not session:batch-mode and mFramHandle:visible.
     1142     if mFrameView
     1143     then do:
     1144       ASSIGN
     1145          FRAME InfoFrame:HIDDEN                           = TRUE
     1146          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1147     end.
     1148   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1149   DO:
     1150     IF not StopProcessing THEN
     1151       Message "Вы действительно хотите прервать" SKIP
     1152               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1153                 UPDATE StopProcessing.
     1154     IF StopProcessing THEN do:
     1155        if mFrameView
     1156        then do:
     1157           HIDE FRAME InfoFrame.
     1158        end.
     1159     End.
     1160   END.
     1161   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1162     if  log-manager:logfile-name ne ?
     1163     then DO:
     1164         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1165     end.
     1166     if not session:batch-mode then
     1167     do:
     1168       VIEW FRAME InfoFrame.
     1169       mFrameView = true.
     1170     end.
     1171      v-button-stop = false .
     1172         if mFrameView
     1173         then do:
     1174         if v-button-stop then view STOPBTN in frame InfoFrame.
     1175                          else Hide STOPBTN in frame InfoFrame.
     1176         end.
     1177   define variable vss-include-info16 as character format "X(65)" no-undo
     1178   initial "@(#)$Workfile$ $Revision$".
     1179   procedure grplib-get-full-name :
     1180      define input parameter p-node-code  as integer      no-undo.
     1181      define output parameter p-full-name as character    no-undo.
     1182      do
     1183   on error undo, return error
     1184   :
     1185       define variable v-upper-code    as integer           no-undo.
     1186       define buffer buf_gds-grp       for ub.gds-grp.
     1187       define buffer buf_upper_gds-grp for ub.gds-grp.
     1188       find first buf_gds-grp no-lock
     1189            where buf_gds-grp.node-code = p-node-code
     1190       no-error.
     1191       if not available buf_gds-grp
     1192       then do:
     1193           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1194       end.
     1195       assign
     1196           p-full-name  = ""
     1197           v-upper-code = 1
     1198       .
     1199       do while buf_gds-grp.upper-code <> 0
     1200       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1201       :
     1202           assign
     1203               p-full-name  = buf_gds-grp.node-name
     1204                            + (if p-full-name <> "" then chr(47) else "")
     1205                            + p-full-name
     1206               v-upper-code = buf_gds-grp.upper-code
     1207           .
     1208           find first buf_gds-grp no-lock
     1209                where buf_gds-grp.node-code = v-upper-code
     1210           no-error.
     1211           if not available buf_gds-grp
     1212           then do:
     1213               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1214                                   + string( v-upper-code )
     1215                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1216           end.
     1217       end.
     1218       assign
     1219       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1220       .
     1221   end.
     1222   end .
     1223   procedure grplib-get-node-from-full-name :
     1224   define input parameter p-full-name as character no-undo .
     1225   define output parameter p-node-code as integer no-undo .
     1226   define variable v-ii as integer no-undo .
     1227   define variable v-upper-code as integer no-undo .
     1228   define variable v-root-code as integer no-undo .
     1229   define variable v-entry as character no-undo .
     1230   define buffer buf_gds-grp       for ub.gds-grp.
     1231   do
     1232   on error undo, return error
     1233   :
     1234     find first buf_gds-grp no-lock
     1235         where buf_gds-grp.upper-code = 0
     1236     no-error .
     1237     if not available buf_gds-grp
     1238     then do:
     1239         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1240     end.
     1241     else do:
     1242       assign
     1243       v-root-code = buf_gds-grp.node-code
     1244       .
     1245     end.
     1246     v-upper-code = v-root-code.
     1247     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1248       assign
     1249       v-entry = entry(v-ii, p-full-name, chr(47)).
     1250       if v-entry = '' then leave.
     1251       find first buf_gds-grp no-lock where
     1252                 buf_gds-grp.node-name = v-entry
     1253             and buf_gds-grp.upper-code = v-upper-code
     1254             no-error.
     1255       if not available buf_gds-grp then do:
     1256         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1257       end.
     1258       else do:
     1259         p-node-code = buf_gds-grp.node-code.
     1260         v-upper-code = buf_gds-grp.node-code.
     1261       end.
     1262     end.
     1263   end.
     1264   end .
