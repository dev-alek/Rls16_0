      576   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   procedure cur-time :
      578      define output parameter p-today as date      no-undo .
      579      define output parameter p-time  as integer   no-undo .
      580     do
      581     on error undo, return error
      582     :
      583       define variable v-date1 as date      no-undo .
      584       define variable v-date2 as date      no-undo .
      585       define variable v-time  as integer   no-undo .
      586       assign
      587         v-date1 = today
      588         v-time  = time
      589         v-date2 = today
      590       .
      591       if v-date1 <> v-date2
      592       then do:
      593         assign
      594           v-date1 = today
      595           v-time  = v-time
      596         .
      597       end.
      598       assign
      599         p-today = v-date1
      600         p-time  = v-time
      601       .
      602     end.
      603   end.
      604   function cur-time-date returns character
      605   :
      606     return string(today, '99/99/9999':U) .
      607   end.
      608   function cur-time-mjd returns decimal
      609   :
      610     define variable v-date as date      no-undo .
      611     define variable v-time as integer   no-undo .
      612     run cur-time in this-procedure
      613       (output v-date
      614       ,output v-time
      615       ) .
      616     return integer(v-date) - 2400002 + (v-time / 86400) .
      617   end.
      618   function cur-time-get-ending-index returns integer
      619   (input p-number as integer
      620   )
      621   :
      622     if p-number < 0
      623     or p-number = ?
      624     then do:
      625       return 1 .
      626     end.
      627     define variable v-rest as integer   no-undo .
      628     assign
      629       p-number = p-number modulo 100
      630     .
      631     if p-number < 20
      632     then do:
      633       assign
      634         v-rest = p-number
      635       .
      636     end.
      637     else do:
      638       assign
      639         v-rest = p-number modulo 10
      640       .
      641     end.
      642     case v-rest :
      643       when 1
      644       then do:
      645         return 2 .
      646       end.
      647       when 2 or
      648       when 3 or
      649       when 4
      650       then do:
      651         return 3 .
      652       end.
      653       otherwise do:
      654         return 1 .
      655       end.
      656     end case .
      657   end.
      658   procedure cur-time-mjd-to-date :
      659      define input  parameter i-mjd-diff as decimal no-undo.
      660      define output parameter o-Date     as date    no-undo.
      661      define output parameter o-Time     as integer no-undo.
      662      define variable v-day-number as integer   no-undo .
      663      if    i-mjd-diff < 0
      664         or i-mjd-diff = ?
      665      then do:
      666         return "?" .
      667      end.
      668      assign
      669         v-day-number = truncate(i-mjd-diff,0).
      670         o-Date = date(v-day-number + 2400002).
      671         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      672     .
      673   end.
      674   function cur-time-mjd-to-string returns character
      675   (input p-mjd-diff as decimal
      676   )
      677   :
      678     define variable v-day-number as integer   no-undo .
      679     define variable v-seconds    as integer   no-undo .
      680     define variable v-hour       as integer   no-undo .
      681     define variable v-min        as integer   no-undo .
      682     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      683     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      684     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      685     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      686     if p-mjd-diff < 0
      687     or p-mjd-diff = ?
      688     then do:
      689       return "?" .
      690     end.
      691     assign
      692       v-day-number = integer(truncate(p-mjd-diff,0))
      693       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      694     .
      695     if v-seconds > 86400
      696     then do:
      697       assign
      698         v-seconds = 86400 - 1
      699       .
      700     end.
      701     if v-seconds < 0
      702     then do:
      703       assign
      704         v-seconds = 0
      705       .
      706     end.
      707     assign
      708       v-hour = truncate(v-seconds / 3600, 0)
      709     .
      710     assign
      711       v-seconds = v-seconds modulo 3600
      712     .
      713     assign
      714       v-min = truncate(v-seconds / 60, 0)
      715     .
      716     assign
      717       v-seconds = v-seconds modulo 60
      718     .
      719     return
      720         (if v-day-number <> 0
      721           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      722           else ""
      723         )
      724       + (if v-day-number <> 0 or v-hour <> 0
      725           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      726           else ""
      727         )
      728       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      729           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      730           else ""
      731         )
      732       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      733       .
      734   end.
      735   function cur-time-string returns character
      736   :
      737     define variable v-date as date      no-undo .
      738     define variable v-time as integer   no-undo .
      739     run cur-time in this-procedure
      740       (output v-date
      741       ,output v-time
      742       ) .
      743     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      744   end.
      745   function cur-time-string-sec returns character
      746   :
      747     define variable v-date as date      no-undo .
      748     define variable v-time as integer   no-undo .
      749     run cur-time in this-procedure
      750       (output v-date
      751       ,output v-time
      752       ) .
      753     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      754   end.
      755   function cur-time-custom  returns character
      756   (input p-prefix as character
      757   ,input p-date-format as character
      758   ,input p-delimiter as character
      759   ,input p-time-format as character
      760   ,input p-suffix as character
      761   )
      762   :
      763     define variable v-date as date      no-undo .
      764     define variable v-time as integer   no-undo .
      765     run cur-time in this-procedure
      766       (output v-date
      767       ,output v-time
      768       ) .
      769     return
      770       p-prefix
      771       + string(v-date, p-date-format)
      772       + p-delimiter
      773       + string(v-time, p-time-format)
      774       + p-suffix
      775       .
      776   end.
      777   function cur-time-print  returns character
      778   :
      779     define variable v-date as date      no-undo .
      780     define variable v-time as integer   no-undo .
      781     run cur-time in this-procedure
      782       (output v-date
      783       ,output v-time
      784       ) .
      785     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      786   end.
      787   function cur-time-datetime returns datetime
      788   :
      789     define variable v-char as character no-undo .
      790     define variable v-datetime as datetime no-undo .
      791     v-char = cur-time-string().
      792     v-datetime = datetime(v-char).
      793     return  v-datetime.
      794   end.
      795   function cur-time-string-msec returns character
      796   :
      797     define variable v-date as datetime  no-undo .
      798     v-date = now.
      799     return string(v-date) .
      800   end.
