      913   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      914   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      915   procedure paramls-clear :
      916     define buffer buf_temp-param for temp-param .
      917     do
      918     on error undo, return error return-value
      919     :
      920       for each buf_temp-param
      921       on error undo, return error
      922       :
      923         delete buf_temp-param .
      924       end.
      925     end.
      926   end procedure.
      927   procedure paramls-write :
      928     define input  parameter p-code     as character no-undo .
      929     define input  parameter p-sub-code as character no-undo .
      930     define input  parameter p-value    as character no-undo .
      931     define buffer buf_temp-param for temp-param .
      932     do
      933     on error undo, return error return-value
      934     :
      935       find first buf_temp-param
      936         where buf_temp-param.param-code     = p-code
      937           and buf_temp-param.param-sub-code = p-sub-code
      938         no-error .
      939       if not available buf_temp-param then do:
      940         create buf_temp-param .
      941         assign
      942           buf_temp-param.param-code     = p-code
      943           buf_temp-param.param-sub-code = p-sub-code
      944         .
      945       end.
      946       assign
      947         buf_temp-param.param-value = p-value
      948       .
      949     end.
      950   end procedure.
      951   procedure paramls-read :
      952     define input  parameter p-code          as character no-undo .
      953     define input  parameter p-sub-code      as character no-undo .
      954     define input  parameter p-default-value as character no-undo .
      955     define output parameter p-value         as character no-undo .
      956     define buffer buf_temp-param for temp-param .
      957     do
      958     on error undo, return error return-value
      959     :
      960       find first buf_temp-param
      961         where buf_temp-param.param-code     = p-code
      962           and buf_temp-param.param-sub-code = p-sub-code
      963         no-error .
      964       if available buf_temp-param then do:
      965         assign
      966           p-value = buf_temp-param.param-value
      967         .
      968       end.
      969       else do:
      970         assign
      971           p-value = p-default-value
      972         .
      973       end.
      974     end.
      975   end procedure.
      976   procedure paramls-append :
      977     define input  parameter p-code     as character no-undo .
      978     define input  parameter p-sub-code as character no-undo .
      979     define input  parameter p-value    as character no-undo .
      980     define buffer buf_temp-param for temp-param .
      981     do
      982     on error undo, return error return-value
      983     :
      984       find first buf_temp-param
      985            where buf_temp-param.param-code     = p-code
      986              and buf_temp-param.param-sub-code = p-sub-code
      987         no-error .
      988       if not available buf_temp-param then do:
      989         create buf_temp-param .
      990         assign
      991           buf_temp-param.param-code     = p-code
      992           buf_temp-param.param-sub-code = p-sub-code
      993           buf_temp-param.param-value    = p-value
      994         .
      995       end.
      996       else do:
      997           assign
      998               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      999           .
     1000       end.
     1001     end.
     1002   end procedure.
     1003   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1004     if num-entries(string(p-dec), '.') = 2
     1005       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1006       else return( string(p-dec)) .
     1007   end function.
     1008   function format-point-to-comma returns char (input orig as char ) .
     1009   define variable rtext as character no-undo .
     1010   define variable strt as integer no-undo .
     1011   define variable leng as integer no-undo .
     1012   assign rtext = orig .
     1013   repeat:
     1014     strt =  index(rtext,'.').
     1015     if strt = 0 then leave.
     1016     leng = 1.
     1017     substring(rtext,strt,leng,"character") = v-delim .
     1018   end.
     1019   return rtext.
     1020   end function.
     1021   function format-excel-text returns char ( input start-text as char ) :
     1022   def var  i    as int no-undo.
     1023   def var  ch   as char no-undo.
     1024   def var  n    as int no-undo.
     1025   def var  ipos as int no-undo.
     1026     n = num-entries(trim(start-text), chr(10)) - 1 .
     1027     do i = 1 to n :
     1028       ipos = index( start-text, chr(10)).
     1029       if ipos > 0 then
     1030         substr( start-text, ipos, 1 ) = ' '.
     1031     end.
     1032     n = num-entries(trim(start-text), chr(13)) - 1 .
     1033     do i = 1 to n :
     1034       ipos = index( start-text, chr(13)).
     1035       if ipos > 0 then
     1036         substr( start-text, ipos, 1 ) = ' '.
     1037     end.
     1038     if index( start-text, '"' ) = 0 then
     1039       start-text =  '="'   + trim( start-text) + '"'   .
     1040       else do:
     1041         n = num-entries(trim(start-text), '"') - 1.
     1042         do i = 1 to n :
     1043           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1044         end.
     1045         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1046         start-text = '="'  + ch  + '"' .
     1047       end.
     1048     return start-text.
     1049   end.
     1050   function excel-sum returns char (input p-dec as decimal ).
     1051     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1052   end function.
     1053   function excel-qnty returns char (input p-dec as decimal ).
     1054     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1055   end function.
     1056   function format-excel-text-macr returns char ( input start-text as char ) :
     1057   def var  i    as int no-undo.
     1058   def var  ch   as char no-undo.
     1059   def var  n    as int no-undo.
     1060   def var  ipos as int no-undo.
     1061     n = num-entries(trim(start-text), chr(10)) - 1 .
     1062     do i = 1 to n :
     1063       ipos = index( start-text, chr(10)).
     1064       if ipos > 0 then
     1065         substring( start-text, ipos , 1 ) = ' '.
     1066     end.
     1067     n = num-entries(trim(start-text), chr(13)) - 1 .
     1068     do i = 1 to n :
     1069       ipos = index( start-text, chr(13)).
     1070       if ipos > 0 then
     1071         substring( start-text, ipos, 1 ) = ' '.
     1072     end.
     1073     if index( start-text, '"' ) = 0 then
     1074       start-text =  '"'   + trim( start-text) + '"'   .
     1075       else do:
     1076         n = num-entries(trim(start-text), '"') - 1.
     1077         do i = 1 to n :
     1078           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1079         end.
     1080         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1081         start-text = '"'  + ch  + '"' .
     1082       end.
     1083     n = num-entries(trim(start-text), chr(10)) - 1 .
     1084     do i = 1 to n :
     1085       ipos = index( start-text, chr(10)).
     1086       if ipos > 0 then
     1087         substring( start-text, ipos , 1 ) = ' '.
     1088     end.
     1089       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1090     return start-text.
     1091   end.
     1092   define variable v-account as integer init 0 no-undo .
     1093   define variable v-account-lavel as character no-undo .
     1094   define variable v-button-stop as logical no-undo .
     1095   define variable v-kol-spice as integer no-undo .
