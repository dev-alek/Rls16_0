     1977    assign    num#col# = num#col# + 1 .
     1978    assign    num#col# = num#col# + 1 .
     1979   run macr_excel_char in this-procedure ( ""     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1980       run macr_cell_format in this-procedure
     1981           ( 12       ,
