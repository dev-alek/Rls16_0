     1442   procedure print-line :
     1443   num#str# = num#str# + 1.
     1444   num#col# = 1.
     1445   run re-calc in this-procedure (
     1446       input  temp-main.order-qnty
     1447     , input  temp-main.qnty
     1448     , input  temp-main.fact-qnty
     1449     , input  temp-main.account-order
     1450     , input  temp-main.date1
     1451     , input  temp-main.date2
     1452     , input  temp-main.str
     1453     , output temp-main.prc_fact-qnty_qnty
     1454     , output temp-main.prc_qnty_order-qnty
     1455     , output temp-main.mean-order
     1456     , output temp-main.acc-day-order
     1457     , output temp-main.acc-day-trn
     1458     ).
     1459   run macr_excel_char in this-procedure ( temp-main.gds-code            , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1460   run macr_excel_char in this-procedure ( temp-main.artic               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1461   run macr_excel_char in this-procedure ( temp-main.gds-name            , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1462   run macr_excel_char in this-procedure ( temp-main.unit-base           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1463   run macr_excel_dec in this-procedure ( temp-main.initial-qnty        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1464   run macr_excel_dec in this-procedure ( temp-main.order-qnty          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1465   run macr_excel_dec in this-procedure ( temp-main.qnty                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1466   run macr_excel_dec in this-procedure ( temp-main.prc_qnty_order-qnty , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1467   run macr_excel_dec in this-procedure ( temp-main.fact-qnty           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1468   run macr_excel_dec in this-procedure ( temp-main.prc_fact-qnty_qnty  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1469   run macr_excel_dec in this-procedure ( temp-main.account-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1470   run macr_excel_dec in this-procedure ( temp-main.mean-order          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1471   run macr_excel_char in this-procedure ( temp-main.acc-day-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1472   run macr_excel_dec in this-procedure ( temp-main.acc-day-trn         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1473   end procedure.
     1474   procedure print-all-itog :
     1475   num#str# = num#str# + 1.
     1476   num#col# = 1.
     1477       run macr_cell_format in this-procedure
     1478           ( ?     ,
     1479             true   ,
     1480             false  ,
     1481             ?      ,
     1482             num#str# ,
     1483             1      ,
     1484             num#str# ,
     1485             14 ) .
     1486   run macr_excel_char in this-procedure ( "Итого  " , num#str# , num#col#   ) .
     1487   assign num#col# = 5 .
     1488   run re-calc in this-procedure (
     1489        input temp-i.order-qnty
     1490       ,input temp-i.qnty
     1491       ,input temp-i.fact-qnty
     1492       ,input temp-i.account-order
     1493       ,input temp-i.date1
     1494       ,input temp-i.date2
     1495       ,input temp-i.str
     1496       ,output temp-i.prc_fact-qnty_qnty
     1497       ,output temp-i.prc_qnty_order-qnty
     1498       ,output temp-i.mean-order
     1499       ,output temp-i.acc-day-order
     1500       ,output temp-i.acc-day-trn         ).
     1501   run macr_excel_dec in this-procedure ( temp-i.initial-qnty        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1502   run macr_excel_dec in this-procedure ( temp-i.order-qnty          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1503   run macr_excel_dec in this-procedure ( temp-i.qnty                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1504   run macr_excel_dec in this-procedure ( temp-i.prc_qnty_order-qnty , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1505   run macr_excel_dec in this-procedure ( temp-i.fact-qnty           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1506   run macr_excel_dec in this-procedure ( temp-i.prc_fact-qnty_qnty  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1507   run macr_excel_dec in this-procedure ( temp-i.account-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1508   run macr_excel_dec in this-procedure ( temp-i.mean-order          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1509   run macr_excel_char in this-procedure ( temp-i.acc-day-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1510   run macr_excel_dec in this-procedure ( temp-i.acc-day-trn         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1511   end procedure.
     1512   procedure PrintTitul :
     1513     do  on error undo, return error return-value  :
     1514     define variable cc as integer no-undo .
     1515     define variable tt as integer no-undo .
     1516       num#str# = num#str# + 1.
     1517       num#col# = 2.
     1518       cc = num#str# .
     1519       run macr_excel_char in this-procedure ( ReportName  , num#str# , num#col#   ) .
     1520       run macr_cell_format in this-procedure
     1521           ( 12     ,
     1522             true   ,
     1523             false  ,
     1524             ?      ,
     1525             cc     ,
     1526             2      ,
     1527             num#str# ,
     1528             2 ) .
     1529       num#col# = 1.
     1530       num#str# = num#str# + 1.
     1531   define variable l-ii  as integer no-undo .
     1532   define variable l-jj  as integer no-undo .
     1533   define variable l-len as integer no-undo .
     1534   define variable l-m   as integer no-undo .
     1535   define variable v-nn as integer   no-undo .
     1536   v-nn= num-entries( str1 , "chr(10)"  )    .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1537   v-nn= num-entries( str2 , "chr(10)"  )    .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1538   v-nn= num-entries( reportheader , "chr(10)"  )    .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1539       num#str# = num#str# + 1.
     1540       run macr_excel_char("Дата составления " + cur-time-date()   , num#str# , num#col#   ) .
     1541       num#str# = num#str# + 1.
     1542       run pshap in this-procedure .
     1543       num#str# = num#str# + 1.
     1544       num#col# = 1.
     1545       run macr_excel_char in this-procedure ( "Код товара"   , num#str# , num#col#   ) .
     1546       run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1547       num#col# = 2.
     1548       run macr_excel_char in this-procedure ( "Артикул"   , num#str# , num#col#   ) .
     1549       run macr_cell_size in this-procedure  ( 16 , ? , num#str# , num#col# , ?, ? ) .
     1550       num#col# = 3.
     1551       run macr_excel_char in this-procedure ( "Наименование"   , num#str# , num#col#   ) .
     1552       run macr_cell_size in this-procedure  ( 30 , ? , num#str# , num#col# , ?, ? ) .
     1553       num#col# = 4.
     1554       run macr_excel_char in this-procedure ( "Ед. изм."   , num#str# , num#col#   ) .
     1555       run macr_cell_size in this-procedure  ( 4 , ? , num#str# , num#col# , ?, ? ) .
     1556       num#col# = 5.
     1557       run macr_excel_char in this-procedure ( "Рассчитано по заказу"   , num#str# , num#col#   ) .
     1558       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1559       num#col# = 6.
     1560       run macr_excel_char in this-procedure ( "Заказано"   , num#str# , num#col#   ) .
     1561       run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1562       num#col# = 7.
     1563       run macr_excel_char in this-procedure ( "Разрешено к отпуску"   , num#str# , num#col#   ) .
     1564       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1565       num#col# = 8.
     1566       run macr_excel_char in this-procedure ( "Разрешено к отпуску / Заказано,%"   , num#str# , num#col#   ) .
     1567       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1568       num#col# = 9.
     1569       run macr_excel_char in this-procedure ( "Поставлено"   , num#str# , num#col#   ) .
     1570       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1571       num#col# = 10.
     1572       run macr_excel_char in this-procedure ( "Поставлено / Разрешено к отпуску,%"   , num#str# , num#col#   ) .
     1573       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1574       num#col# = 11.
     1575       run macr_excel_char in this-procedure ( "Кол-во заказа за период"   , num#str# , num#col#   ) .
     1576       run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1577       num#col# = 12.
     1578       run macr_excel_char in this-procedure ( "Средний заказ (разрешено к отпуску)"   , num#str# , num#col#   ) .
     1579       run macr_cell_size in this-procedure  ( 12 , ? , num#str# , num#col# , ?, ? ) .
     1580       num#col# = 13.
     1581       run macr_excel_char in this-procedure ( "Средний период между заказами в днях"   , num#str# , num#col#   ) .
     1582       run macr_cell_size in this-procedure  ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1583       num#col# = 14.
     1584       run macr_excel_char in this-procedure ( "Средний период между заказом и поставкой"   , num#str# , num#col#   ) .
     1585       run macr_cell_size in this-procedure  ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1586       run macr_cell_format in this-procedure
     1587       ( 10    ,
     1588         true  ,
     1589         false  ,
     1590         ?    ,
     1591         num#str# ,
     1592         1 ,
     1593         num#str# ,
     1594         14 ) .
     1595        put  stream macr_excel unformatted
     1596          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1597          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1598          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1599          .
     1600     end.
     1601   end procedure.
     1602   procedure make-tt :
     1603   define buffer buf_ord-doc      for ub.ord-doc  .
     1604   define variable first-line as logical   no-undo .
     1605   define variable v-gds as logical no-undo .
     1606     do
     1607     on error undo, return error return-value
     1608     :
     1609   create temp-i.
     1610   assign
     1611   temp-i.initial-qnty     = 0
     1612   temp-i.order-qnty       = 0
     1613   temp-i.qnty             = 0
     1614   temp-i.fact-qnty        = 0
     1615   temp-i.account-order    = 0
     1616   .
     1617   first-line  = true.
     1618   v-gds = false .
     1619   find first gds-list no-error .
     1620   if available gds-list then v-gds = true  .
     1621     for each obj-list :
     1622     if p-OrdDate = "doc-date" then do :
     1623     for each buf_ord-doc no-lock where
     1624              buf_ord-doc.cons-code = ""  and
     1625              buf_ord-doc.doc-type  = 'ОР':U and
     1626              buf_ord-doc.cli-type  = v-cntxt-obj-type and
     1627              buf_ord-doc.cli-code  = v-cntxt-obj-code and
     1628              buf_ord-doc.obj-type  = obj-list.obj-type and
     1629              buf_ord-doc.obj-code  = obj-list.obj-code and
     1630               buf_ord-doc.doc-date >= x-date-start and
     1631               buf_ord-doc.doc-date <= x-date-end break by buf_ord-doc.doc-date
     1632               :
     1633               run make-tt-1 in this-procedure
     1634               ( input buf_ord-doc.doc-code,
     1635                 input buf_ord-doc.obj-type,
     1636                 input buf_ord-doc.obj-code,
     1637                 input buf_ord-doc.doc-date,
     1638                 input first-line,
     1639                 input v-gds ) .
     1640       end.
     1641     end.
     1642     if p-OrdDate = "ship-date" then do :
     1643       for each buf_ord-doc no-lock where
     1644               buf_ord-doc.cons-code = ""  and
     1645               buf_ord-doc.doc-type  = 'ОР':U and
     1646               buf_ord-doc.cli-type  = v-cntxt-obj-type and
     1647               buf_ord-doc.cli-code  = v-cntxt-obj-code and
     1648               buf_ord-doc.obj-type  = obj-list.obj-type and
     1649               buf_ord-doc.obj-code  = obj-list.obj-code and
     1650               buf_ord-doc.ship-date >= x-date-start and
     1651               buf_ord-doc.ship-date <= x-date-end
     1652               :
     1653               run make-tt-1 in this-procedure
     1654               ( input buf_ord-doc.doc-code,
     1655                 input buf_ord-doc.obj-type,
     1656                 input buf_ord-doc.obj-code,
     1657                 input buf_ord-doc.ship-date,
     1658                 input first-line,
     1659                 input v-gds ) .
     1660       end.
     1661     end.
     1662     end.
     1663    end.
     1664   end procedure.
     1665   procedure make-tt-1 :
     1666   define input parameter v-ord-doc-code like ub.ord-doc.doc-code .
     1667   define input parameter v-ord-obj-type like ub.ord-doc.obj-type .
     1668   define input parameter v-ord-obj-code like ub.ord-doc.obj-code .
     1669   define input parameter v-ord-date     like ub.ord-doc.doc-date .
     1670   define input parameter first-line as logical no-undo .
     1671   define input parameter v-gds        as logical no-undo .
     1672   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv  .
     1673   define buffer buf_ord-line     for ub.ord-line  .
     1674   define buffer buf_trn-doc      for ub.trn-doc  .
     1675   define buffer buf_doc-line     for ub.doc-line  .
     1676   define buffer buf_clients      for ub.clients  .
     1677   define buffer buf1_ord-doc-rcv for ub.ord-doc-rcv  .
     1678   define buffer buf_goods        for ub.goods  .
     1679   define variable v-recid as recid no-undo .
     1680   define variable v-code as integer   no-undo .
     1681   define variable v-type as character no-undo .
     1682   define variable v-trn-code as character no-undo .
     1683   define variable v-trn-type as character no-undo .
     1684   do
     1685   on error undo, return error return-value
     1686   :
     1687   v-code = if p-tog-obj then v-ord-obj-code else 0    .
     1688   v-type = if p-tog-obj then v-ord-obj-type else ""  .
     1689         for each buf_ord-line no-lock where
     1690             buf_ord-line.doc-code = v-ord-doc-code
     1691                  :
     1692                   v-recid = 0.
     1693             for each buf1_ord-doc-rcv no-lock where buf1_ord-doc-rcv.doc-code = v-ord-doc-code ,
     1694                       each ub.ord-chain no-lock where
     1695                            ub.ord-chain.doc-code = buf1_ord-doc-rcv.rcv-code and
     1696                            ub.ord-chain.doc-type = 'rcv'                     and
     1697                            ub.ord-chain.rel-doc-type = 'trn' ,
     1698                       first buf_trn-doc no-lock
     1699                   where  buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code and
     1700                   ( buf_trn-doc.doc-type = 'рас':U or buf_trn-doc.doc-type = 'возврат':U )
     1701                     :
     1702                      v-trn-code = buf_trn-doc.doc-code.
     1703                 v-trn-type = buf_trn-doc.doc-type.
     1704                      v-recid = recid(buf1_ord-doc-rcv).
     1705                   end.
     1706                   find first buf_ord-doc-rcv no-lock where recid(buf_ord-doc-rcv) = v-recid no-error .
     1707                   find first buf_goods no-lock where buf_goods.gds-code = buf_ord-line.gds-code no-error .
     1708                   if v-gds = true  then do:
     1709                       find first gds-list where gds-list.gds-code = buf_ord-line.gds-code no-error .
     1710                       if not available gds-list then next.
     1711                   end.
     1712                   if p-tog-prc = true  then do:
     1713                       find first temp-g where temp-g.gds-code = buf_ord-line.gds-code no-error .
     1714                       if not available temp-g then next.
     1715                   end.
     1716                   find first buf_doc-line no-lock where
     1717                              buf_doc-line.doc-code  = v-trn-code             and
     1718                              buf_doc-line.artic     = buf_ord-line.artic     and
     1719                              buf_doc-line.prod-type = buf_ord-line.prod-type and
     1720                              buf_doc-line.prod-code = buf_ord-line.prod-code
     1721                              no-error .
     1722                   find first temp-main where
     1723                              temp-main.gds-code = buf_ord-line.gds-code and
     1724                              temp-main.obj-code = v-code  and
     1725                              temp-main.obj-type = v-type
     1726                              no-error .
     1727                   if not available temp-main then do:
     1728                     create temp-main.
     1729                     assign
     1730                       temp-main.gds-code      = buf_ord-line.gds-code
     1731                       temp-main.obj-code      = v-code
     1732                       temp-main.obj-type      = v-type
     1733                       temp-main.artic         = buf_goods.artic
     1734                       temp-main.gds-name      = buf_goods.gds-name
     1735                       temp-main.unit-base     = buf_goods.unit-base
     1736                       temp-main.grp-code      = buf_goods.grp-code
     1737                       temp-main.prod-codetype = buf_goods.prod-type + string (buf_goods.prod-code)
     1738                     .
     1739                 temp-main.date1 = v-ord-date .
     1740                 temp-main.date2 = v-ord-date .
     1741                   end.
     1742                   find first buf_trn-doc no-lock where
     1743                              buf_trn-doc.doc-code = buf_doc-line.doc-code
     1744                              no-error .
     1745                   define variable v-trn-date as date no-undo .
     1746                   v-trn-date = date("").
     1747                   if available buf_trn-doc then v-trn-date = buf_trn-doc.doc-date.
     1748                   assign
     1749                     temp-main.initial-qnty  = temp-main.initial-qnty  +  buf_ord-line.initial-qnty
     1750                     temp-main.order-qnty    = temp-main.order-qnty    +  buf_ord-line.order-qnty
     1751                     temp-main.qnty          = temp-main.qnty          +  buf_ord-line.qnty
     1752                     temp-main.account-order = temp-main.account-order + 1
     1753               temp-main.strday        = temp-main.strday + string(v-ord-date - v-trn-date) + ","
     1754                   .
     1755               if v-trn-type = 'рас':U then do :
     1756                 temp-main.fact-qnty     = temp-main.fact-qnty     +  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1757               end.
     1758               if v-trn-type = 'возврат':U then do :
     1759                 temp-main.fact-qnty     = temp-main.fact-qnty     -  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1760               end.
     1761               if temp-main.date1 > v-ord-date then temp-main.date1 = v-ord-date .
     1762               if temp-main.date2 < v-ord-date then temp-main.date2 = v-ord-date .
     1763                   find current temp-i.
     1764                   if first-line  = true then do:
     1765                 temp-i.date1 = v-ord-date .
     1766                 temp-i.date2 = v-ord-date .
     1767                      first-line  = false .
     1768                   end.
     1769                   assign
     1770                     temp-i.initial-qnty     = temp-i.initial-qnty  +  buf_ord-line.initial-qnty
     1771                     temp-i.order-qnty       = temp-i.order-qnty    +  buf_ord-line.order-qnty
     1772                     temp-i.qnty             = temp-i.qnty          +  buf_ord-line.qnty
     1773                     temp-i.account-order    = temp-i.account-order + 1
     1774               temp-i.strday           = temp-i.strday + string(v-ord-date - v-trn-date) + ","
     1775                   .
     1776               if v-trn-type = 'рас':U then do :
     1777                 temp-i.fact-qnty        = temp-i.fact-qnty     +  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1778               end.
     1779               if v-trn-type = 'возврат':U then do :
     1780                 temp-i.fact-qnty        = temp-i.fact-qnty     -  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1781               end.
     1782             if temp-i.date1 > v-ord-date then temp-i.date1 = v-ord-date .
     1783             if temp-i.date2 < v-ord-date then temp-i.date2 = v-ord-date .
     1784                   find first temp-obj where
     1785                              temp-obj.obj-code = v-code  and
     1786                              temp-obj.obj-type = v-type
     1787                              no-error .
     1788                   if not available temp-obj then do:
     1789                      create temp-obj.
     1790                      assign
     1791                       temp-obj.obj-code = v-code
     1792                       temp-obj.obj-type = v-type
     1793                      .
     1794                 temp-obj.date1 = v-ord-date .
     1795                 temp-obj.date2 = v-ord-date .
     1796                   end.
     1797                   assign
     1798                     temp-obj.initial-qnty     = temp-obj.initial-qnty  +  buf_ord-line.initial-qnty
     1799                     temp-obj.order-qnty       = temp-obj.order-qnty    +  buf_ord-line.order-qnty
     1800                     temp-obj.qnty             = temp-obj.qnty          +  buf_ord-line.qnty
     1801                     temp-obj.account-order    = temp-obj.account-order + 1
     1802               temp-obj.strday           = temp-obj.strday + string(v-ord-date - v-trn-date) + ","
     1803                   .
     1804               if v-trn-type = 'рас':U then do :
     1805                 temp-obj.fact-qnty        = temp-obj.fact-qnty     +  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1806               end.
     1807               if v-trn-type = 'возврат':U then do :
     1808                 temp-obj.fact-qnty        = temp-obj.fact-qnty     -  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1809               end.
     1810             if temp-obj.date1 > v-ord-date then temp-obj.date1 = v-ord-date .
     1811             if temp-obj.date2 < v-ord-date then temp-obj.date2 = v-ord-date .
     1812                  if p-classify = "grp-goods"  then do:
     1813                     find first temp-grp where
     1814                                temp-grp.grp-code  = buf_goods.grp-code and
     1815                                temp-grp.obj-code = v-code  and
     1816                                temp-grp.obj-type = v-type
     1817                                no-error .
     1818                     if not available temp-grp then do:
     1819                         create temp-grp.
     1820                         assign
     1821                           temp-grp.obj-code  = v-code
     1822                           temp-grp.obj-type  = v-type
     1823                           temp-grp.grp-code  = buf_goods.grp-code
     1824                           temp-grp.grp-name  = buf_goods.grp-name
     1825                         .
     1826                   temp-grp.date1 = v-ord-date .
     1827                   temp-grp.date2 = v-ord-date .
     1828                     end.
     1829                     assign
     1830                       temp-grp.initial-qnty     = temp-grp.initial-qnty  +  buf_ord-line.initial-qnty
     1831                       temp-grp.order-qnty       = temp-grp.order-qnty    +  buf_ord-line.order-qnty
     1832                       temp-grp.qnty             = temp-grp.qnty          +  buf_ord-line.qnty
     1833                       temp-grp.account-order    = temp-grp.account-order + 1
     1834                 temp-grp.strday           = temp-grp.strday + string(v-ord-date - v-trn-date) + ","
     1835                     .
     1836                 if v-trn-type = 'рас':U then do :
     1837                   temp-grp.fact-qnty        = temp-grp.fact-qnty     +  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1838                 end.
     1839                 if v-trn-type = 'возврат':U then do :
     1840                   temp-grp.fact-qnty        = temp-grp.fact-qnty     -  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1841                 end.
     1842               if temp-grp.date1 > v-ord-date then temp-grp.date1 = v-ord-date.
     1843               if temp-grp.date2 < v-ord-date then temp-grp.date2 = v-ord-date.
     1844                  end.
     1845                  if p-classify = "prod"  then do:
     1846                     find first temp-prod where
     1847                                temp-prod.prod-codetype  = buf_goods.prod-type + string (buf_goods.prod-code) and
     1848                                temp-prod.obj-code  = v-code  and
     1849                                temp-prod.obj-type  = v-type
     1850                                no-error .
     1851                     if not available temp-prod then do:
     1852                     find first buf_clients no-lock where
     1853                               buf_clients.obj-code = buf_goods.prod-code and
     1854                               buf_clients.obj-type = buf_goods.prod-type no-error .
     1855                         create temp-prod.
     1856                         assign
     1857                           temp-prod.prod-codetype  = buf_goods.prod-type + string (buf_goods.prod-code)
     1858                           temp-prod.grp-name  = buf_clients.obj-name
     1859                           temp-prod.obj-code  = v-code
     1860                           temp-prod.obj-type  = v-type
     1861                           .
     1862                     temp-prod.date1 = v-ord-date .
     1863                     temp-prod.date2 = v-ord-date .
     1864                     end.
     1865                     assign
     1866                       temp-prod.initial-qnty     = temp-prod.initial-qnty  +  buf_ord-line.initial-qnty
     1867                       temp-prod.order-qnty       = temp-prod.order-qnty    +  buf_ord-line.order-qnty
     1868                       temp-prod.qnty             = temp-prod.qnty          +  buf_ord-line.qnty
     1869                       temp-prod.account-order    = temp-prod.account-order + 1
     1870                      .
     1871                 if v-trn-type = 'рас':U then do :
     1872                   temp-prod.fact-qnty        = temp-prod.fact-qnty     +  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1873                  end.
     1874                 if v-trn-type = 'возврат':U then do :
     1875                   temp-prod.fact-qnty        = temp-prod.fact-qnty     -  if available buf_doc-line then  buf_doc-line.fact-qnty else 0 .
     1876         end.
     1877                 if temp-prod.date1 > v-ord-date then temp-prod.date1 = v-ord-date .
     1878                 if temp-prod.date2 < v-ord-date then temp-prod.date2 = v-ord-date .
     1879     end.
     1880     end.
     1881     end.
     1882   end procedure.
     1883   procedure print-grp-name :
     1884   define output parameter p-row as integer   no-undo .
     1885     do
     1886     on error undo, return error return-value
     1887     :
     1888   num#str# = num#str# + 1.
     1889   num#col# = 1.
     1890   define variable v-full-name as character no-undo .
     1891   run grplib-get-full-name in this-procedure  ( input temp-grp.grp-code , output v-full-name ) .
     1892   run macr_excel_char in this-procedure (  v-full-name    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1893       run macr_cell_format in this-procedure
     1894           ( 12       ,
     1895             true     ,
     1896             false    ,
     1897             48       ,
     1898             num#str# ,
     1899             1        ,
     1900             num#str# ,
     1901             14       ) .
     1902      p-row =  num#str# .
     1903     end.
     1904   end procedure.
     1905   procedure print-grp-itogo :
     1906   define input  parameter p-row as integer   no-undo .
     1907     do
     1908     on error undo, return error return-value
     1909     :
     1910     run paramls-write in this-procedure
     1911       (input "rowsgroup"
     1912       ,input string(v-ind) + ',':u + number-group
     1913       ,input substitute('&1:&2' ,  p-row, num#str# )
     1914       ) .
     1915   num#str# = num#str# + 1.
     1916   num#col# = 1.
     1917       run macr_cell_format in this-procedure
     1918           ( ?     ,
     1919             true   ,
     1920             false  ,
     1921             ?      ,
     1922             num#str# ,
     1923             1      ,
     1924             num#str# ,
     1925             14 ) .
     1926   define variable v-full-name as character no-undo .
     1927   run grplib-get-full-name in this-procedure  ( input temp-grp.grp-code , output v-full-name ) .
     1928   run macr_excel_char in this-procedure (  v-full-name    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1929    assign    num#col# = num#col# + 1 .
     1930   run macr_excel_char in this-procedure ( "Итого по ГРУППЕ"   , num#str# , num#col#   ) .
     1931   run re-calc in this-procedure (
     1932        input temp-grp.order-qnty
     1933       ,input temp-grp.qnty
     1934       ,input temp-grp.fact-qnty
     1935       ,input temp-grp.account-order
     1936       ,input temp-grp.date1
     1937       ,input temp-grp.date2
     1938       ,input temp-grp.str
     1939       ,output temp-grp.prc_fact-qnty_qnty
     1940       ,output temp-grp.prc_qnty_order-qnty
     1941       ,output temp-grp.mean-order
     1942       ,output temp-grp.acc-day-order
     1943       ,output temp-grp.acc-day-trn         ).
     1944   assign num#col# = 5 .
     1945   run macr_excel_dec in this-procedure ( temp-grp.initial-qnty        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1946   run macr_excel_dec in this-procedure ( temp-grp.order-qnty          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1947   run macr_excel_dec in this-procedure ( temp-grp.qnty                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1948   run macr_excel_dec in this-procedure ( temp-grp.prc_qnty_order-qnty , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1949   run macr_excel_dec in this-procedure ( temp-grp.fact-qnty           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1950   run macr_excel_dec in this-procedure ( temp-grp.prc_fact-qnty_qnty  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1951   run macr_excel_dec in this-procedure ( temp-grp.account-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1952   run macr_excel_dec in this-procedure ( temp-grp.mean-order          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1953   run macr_excel_char in this-procedure ( temp-grp.acc-day-order       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1954   run macr_excel_dec in this-procedure ( temp-grp.acc-day-trn         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1955     end.
     1956   end procedure.
     1957   procedure pshap :
