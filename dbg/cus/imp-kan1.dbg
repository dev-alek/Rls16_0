        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Закачка данных для КАНру ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   define variable v_os-file as char no-undo.
      108   DEFINE BUTTON b-exit
      109        LABEL "Выполнить"
      110        SIZE 15 BY 1.13
      111        BGCOLOR 8 .
      112   DEFINE BUTTON B-file
      113        IMAGE-UP FILE "btn-down-arrow":U
      114        IMAGE-DOWN FILE "btn-down-arrow":U
      115        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      116        LABEL ""
      117        SIZE 3 BY 1.
      118   DEFINE BUTTON b-quit AUTO-END-KEY
      119        LABEL "Выход"
      120        SIZE 15 BY 1.13
      121        BGCOLOR 8 .
      122   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      123        LABEL "Файл для импорта"
      124        VIEW-AS FILL-IN
      125        SIZE 52.5 BY 1 NO-UNDO.
      126   DEFINE VARIABLE Tumbler AS INTEGER
      127        VIEW-AS RADIO-SET VERTICAL
      128        RADIO-BUTTONS
      129             "В справочник товаров", 1,
      130             "В ДНЦ", 2
      131        SIZE 24.5 BY 2 NO-UNDO.
      132   DEFINE FRAME Dialog-Frame
      133        file-name AT ROW 2.27 COL 1
      134        B-file AT ROW 2.27 COL 71.5
      135        Tumbler AT ROW 5 COL 24 NO-LABEL
      136        b-exit AT ROW 7.5 COL 16
      137        b-quit AT ROW 7.5 COL 41
      138        "              Куда будем импортировать данные из файла" VIEW-AS TEXT
      139             SIZE 73.5 BY 1 AT ROW 3.5 COL 1
      140             BGCOLOR 8
      141        "          Укажите файл из которого необходимо произвести импорт" VIEW-AS TEXT
      142             SIZE 73.5 BY .67 AT ROW 1.27 COL 1
      143             BGCOLOR 8
      144        SPACE(0.24) SKIP(7.30)
      145       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      146            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      147            TITLE "Импорт из текстового файла (;)"
      148            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      149   ASSIGN
      150          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      151          FRAME Dialog-Frame:HIDDEN           = TRUE.
      152   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      153   DO:
      154     APPLY "END-ERROR":U TO SELF.
      155   END.
      156   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      157   DO:
      158       assign
      159           Tumbler.
      160       if  trim(file-name) = "" then do:
      161               message "Не задан файл для импорта "
      162               view-as alert-box ERROR.
      163               return no-apply.
      164       end.
      165       if Tumbler = 1 then do:
      166             run cus/imp-kan2.w (  input parparentproc
      167                                  ,INPUT v_os-file ) no-error.
      168       end.
      169       else do:
      170             run cus/imp-kan3.p ( input parparentproc
      171                                  ,INPUT v_os-file ) no-error.
      172       end.
      173   END.
      174   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      175   DO:
      176     define variable ll_commit AS LOG    NO-UNDO INIT NO.
      177     SYSTEM-DIALOG GET-FILE v_os-file
      178     TITLE "Выберите файл для импорта"
      179     FILTERS "Текстовый файл (*.txt)" "*.txt",
      180             "CSV(MS-DOS) (*.csv)" "*.csv",
      181             "Все файлы (*.*)"        "*.*"
      182     MUST-EXIST
      183     USE-FILENAME
      184     update ll_commit
      185     default-extension "txt"
      186     .
      187     IF ll_commit <> YES THEN do:
      188         RETURN NO-APPLY.
      189     end.
      190     IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      191         BELL.
      192         MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      193         RETURN NO-APPLY.
      194     END.
      195     ASSIGN
      196     file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      197     DISPlay
      198     file-name
      199     WITH FRAME Dialog-Frame.
      200   END.
      201   ON LEAVE OF file-name IN FRAME Dialog-Frame
      202   DO:
      203       ASSIGN file-name.
      204       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      205           ASSIGN FILE-INFO:FILE-NAME = file-name.
      206           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      207           DISP file-name WITH FRAME Dialog-Frame.
      208       END.
      209       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
      210   END.
      211   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      212   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      213   MAIN-BLOCK:
      214   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      215      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      216     RUN enable_UI.
      217     WAIT-FOR GO OF FRAME Dialog-Frame.
      218   END.
      219   RUN disable_UI.
      220   PROCEDURE disable_UI :
      221     HIDE FRAME Dialog-Frame.
      222   END PROCEDURE.
      223   PROCEDURE enable_UI :
      224     DISPLAY file-name Tumbler
      225         WITH FRAME Dialog-Frame.
      226     ENABLE B-file Tumbler b-exit b-quit
      227         WITH FRAME Dialog-Frame.
      228     VIEW FRAME Dialog-Frame.
      229   END PROCEDURE.
