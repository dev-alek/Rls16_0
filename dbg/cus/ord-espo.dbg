      443     index code is         unique gds-code
      444     index oi order-num
      445     index isel to-sel
      446     .
      447   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448   define  new shared  temp-table gds-list-hist no-undo
      449   field list-table as character
      450   field id as integer
      451   field line as integer
      452   field hist-mode as character
      453   field des as character
      454   field num-recs as integer
      455   field option_ as character
      456   field item_ as character
      457   field status_ as character
      458   field num-add as integer
      459   field num-ignored as integer
      460   field done as logical
      461   field err_ as logical
      462   field err-mes as character
      463   index pi is primary
      464   id
      465   line
      466   index isdone
      467   done
      468   .
      469   define buffer buf_ord-doc      for ub.ord-doc.
      470   define buffer buf_trn-doc      for ub.trn-doc.
      471   define buffer buf_ord-line     for ub.ord-line.
      472   define buffer buf_ord-dtl      for ub.ord-dtl.
      473   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv.
      474   define buffer buf_ord-line-rcv for ub.ord-line-rcv.
      475   define variable v-ord-num as character no-undo .
      476   define variable v-host-code as integer   no-undo .
      477   define variable p-rcv-code as character no-undo .
      478   find first  buf_ord-doc no-lock where recid ( buf_ord-doc ) = p-ord-recid no-error .
      479   if error-status :error then return .
      480   v-ord-num = buf_ord-doc.doc-code .
      481   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      483     (input  buf_ord-doc.obj-type
      484     ,input  buf_ord-doc.obj-code
      485     ,output v-host-code
      486     )  .
      487   run waitfram-show in this-procedure ( "Формирование РН...." ) .
      488   do transaction
      489   on error undo, return error return-value
      490   :
      491   run create-rcv in this-procedure
      492       (output p-rcv-code ) no-error .
      493       if error-status :error then do:
      494             message  return-value
      495             error-status :get-message(1)
      496             view-as alert-box error .
      497             undo, return error .
      498       end.
      499   find first buf_ord-doc-rcv exclusive-lock where
      500              buf_ord-doc-rcv.rcv-code =  p-rcv-code and
      501              buf_ord-doc-rcv.doc-code =  v-ord-num
      502              no-error .
      503       if error-status :error then do:
      504           message  return-value
      505           error-status :get-message(1)
      506           view-as alert-box error .
      507           undo, return error .
      508       end.
      509       buf_ord-doc-rcv.status_  = 'поставка':U .
      510   run cus/ord-trn.p
      511       ( input parparentproc ,
      512         input recid (buf_ord-doc-rcv) ,
      513         input no
      514         ) no-error .
      515       if error-status :error then do:
      516           message  return-value
      517           error-status :get-message(1)
      518           view-as alert-box error .
      519           undo, return error .
      520       end.
      521   find first  buf_ord-doc exclusive-lock where recid ( buf_ord-doc ) = p-ord-recid no-error .
      522   assign
      523      buf_ord-doc.status_  = 'поставка':U
      524      .
      525   for each ub.ord-chain no-lock where
      526            ub.ord-chain.doc-code =  p-rcv-code and
      527            ub.ord-chain.doc-type = 'rcv'                  and
      528            ub.ord-chain.rel-doc-type = 'trn'
      529            :
      530       for each buf_trn-doc exclusive-lock where
      531                buf_trn-doc.doc-code  = ub.ord-chain.rel-doc-code
      532                :
      533                buf_trn-doc.flag_  = true .
      534       end.
      535   end.
      536   if v-host-code = v-cntxt-host-code-obj then do:
      537   define variable v-make-z as logical   no-undo .
      538   define variable p-rez as logical   no-undo .
      539   define variable p-ord-doc as character no-undo .
      540   define buffer buf_gds-obj for ub.gds-obj  .
      541   v-make-z = false .
      542   for each buf_ord-line no-lock where
      543            buf_ord-line.doc-code = buf_ord-doc.doc-code
      544            :
      545            find first buf_gds-obj no-lock where
      546                       buf_gds-obj.obj-type = buf_ord-doc.obj-type and
      547                       buf_gds-obj.obj-code = buf_ord-doc.obj-code and
      548                       buf_gds-obj.gds-code = buf_ord-line.gds-code no-error .
      549            if not available buf_gds-obj then do:
      550               v-make-z = true  .
      551               leave.
      552            end.
      553             if buf_ord-line.qnty > buf_gds-obj.free-qnty  then do:
      554               v-make-z = true  .
      555               leave.
      556             end.
      557   end.
      558   if v-make-z = true  then do:
      559      run cus/ord-chtp.w
      560       ( input  parParentProc ,
      561         input  recid(buf_ord-doc) ,
      562         output p-rez ,
      563         output p-ord-doc )    .
      564         if p-rez = true and
      565            p-ord-doc <> "" then do:
      566              message "Создана заявка № " p-ord-doc .
      567            end.
      568   end.
      569       for each ub.ord-chain no-lock where
      570               ub.ord-chain.doc-code =  p-rcv-code and
      571               ub.ord-chain.doc-type = 'rcv'                  and
      572               ub.ord-chain.rel-doc-type = 'trn'
      573               :
      574         run close-zapr (input ub.ord-chain.rel-doc-code ) no-error .
      575       end.
      576   end.
      577   end.
      578   run waitfram-hide in this-procedure .
      579   procedure create-rcv :
      580   define output parameter v-rcv-num as character no-undo .
      581     do
      582     on error undo, return error return-value
      583     :
      584   define variable v-i-doc as character no-undo .
      585   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   run proc-ord-code in this-procedure
      587    (input   'main' ,
      588     input   v-cntxt-db-num ,
      589     input   v-cntxt-obj-type ,
      590     input   v-cntxt-obj-code ,
      591     input   v-i-doc ,
      592     output  v-rcv-num
      593    ) .
      594   create ub.ord-doc-rcv.
      595   buffer-copy buf_ord-doc to ub.ord-doc-rcv
      596      assign
      597         ub.ord-doc-rcv.rcv-code  = v-rcv-num
      598         ub.ord-doc-rcv.doc-type  = "out":U
      599         ub.ord-doc-rcv.doc-date  = today
      600         ub.ord-doc-rcv.status_   = 'новый':U
      601      .
      602   for each buf_ord-line no-lock where
      603            buf_ord-line.doc-code = buf_ord-doc.doc-code
      604            :
      605            create ub.ord-line-rcv.
      606            buffer-copy buf_ord-line to ub.ord-line-rcv
      607            assign
      608              ub.ord-line-rcv.rcv-code  = v-rcv-num
      609              .
      610   end.
      611   for each buf_ord-dtl no-lock where
      612            buf_ord-dtl.doc-code = buf_ord-doc.doc-code
      613            :
      614            create ub.ord-dtl-rcv.
      615            buffer-copy buf_ord-dtl to ub.ord-dtl-rcv
      616            assign
      617              ub.ord-dtl-rcv.rcv-code  = v-rcv-num
      618              .
      619   end.
      620     end.
      621   end procedure.
      622   PROCEDURE close-zapr :
      623    do
      624    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      625    :
      626   define input parameter p-trn-code as character no-undo .
      627   define variable g#log      as logical   no-undo .
      628   define variable g#report-num as integer   no-undo .
      629   define variable g#db-remote as logical   no-undo .
      630   define variable g#in-ov      as logical   no-undo .
      631   define variable g#rsrv-time  as decimal   no-undo .
      632   define variable g#load-time as decimal   no-undo .
      633   define variable g#holidays  as character no-undo .
      634   define buffer buf_sysconf for ub.sysconf  .
      635   find first buf_sysconf no-lock where buf_sysconf.host-code = v-cntxt-host-code-obj .
      636   g#in-ov       = buf_sysconf.in-ov        .
      637   g#rsrv-time   = buf_sysconf.rsrv-time    .
      638   g#load-time   = buf_sysconf.load-time    .
      639   g#holidays    = buf_sysconf.holidays    .
      640   define buffer buf_s-trn-doc for ub.trn-doc.
      641   define variable varmode            as   character           no-undo.
      642   define variable varstatus          like ub.trn-doc.status_  no-undo.
      643   define variable varflag            like ub.trn-doc.flag     no-undo.
      644   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
      645   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
      646   define variable varcheck-return as logical no-undo .
      647   define variable varchg-inv as logical no-undo .
      648   assign
      649     varmode        = '<закрытие документа>':U
      650     varstatus      = 'запрос':U
      651     varflag        = true
      652     varcopystatus  = 'накл':U
      653     varcopyflag    = false
      654     varcheck-return = true
      655     varchg-inv = true
      656     .
      657   run str/trn-graf.p
      658                  (input  p-trn-code,
      659                   input  v-cntxt-db-num,
      660                   input  varmode,
      661                   output varstatus,
      662                   output varflag,
      663                   output varcopystatus,
      664                   output varcopyflag
      665                   ) no-error.
      666   .
      667   if error-status:error then do:
      668      if error-status :get-message(1) <> "" or
      669         return-value = ""                  then do:
      670        message "Ошибка при вызове trn-graf.p." skip
      671        error-status :get-message(1) skip
      672        return-value skip
      673        view-as alert-box error.
      674      end.
      675      else do:
      676        message return-value
      677        view-as alert-box error.
      678      end.
      679      return error.
      680   end.
      681   run str/trn-stat.p
      682     ( input  parParentProc ,
      683       input this-procedure ,
      684       input  varmode,
      685       input  p-trn-code,
      686       input  varcheck-return,
      687       input  v-cntxt-db-num,
      688       input  g#in-ov,
      689       input  g#rsrv-time,
      690       input  g#load-time,
      691       input  g#holidays,
      692       input  yes,
      693       output varchg-inv,
      694       output table gds-list
      695       ) no-error.
      696   if error-status:error then do:
      697        message vss-workfile vss-revision vss-description skip
      698        "Ошибка при принудительном закрытии документа " p-trn-code skip
      699        return-value skip
      700        trim(error-status :get-message(1))
      701        trim(error-status :get-message(2))
      702        trim(error-status :get-message(3))
      703        trim(error-status :get-message(4))
      704        trim(error-status :get-message(5)) skip
      705        view-as alert-box error.
      706      return error.
      707   end.
      708     end.
      709   END PROCEDURE.
