      447        B-OK AT ROW 1 COL 1
      448        B-exit AT ROW 1 COL 13
      449        B-Help AT ROW 1 COL 90.88
      450        ub.ord-doc.cli-type AT ROW 4.75 COL 14.25 COLON-ALIGNED
      451             VIEW-AS FILL-IN
      452             SIZE 4.75 BY 1
      453        ub.ord-doc.cli-code AT ROW 4.79 COL 19.25 COLON-ALIGNED NO-LABEL
      454             VIEW-AS FILL-IN
      455             SIZE 10 BY 1
      456        r-obj AT ROW 4.83 COL 31.88
      457        ub.ord-doc.doc-date AT ROW 2.38 COL 87.13 COLON-ALIGNED
      458              VIEW-AS TEXT
      459             SIZE 11 BY .67
      460             FGCOLOR 1
      461        ub.ord-doc.doc-code AT ROW 2.58 COL 14.25 COLON-ALIGNED
      462              VIEW-AS TEXT
      463             SIZE 15 BY .67
      464             FGCOLOR 1
      465        ub.ord-doc.doc-type AT ROW 3.33 COL 87.25 COLON-ALIGNED
      466              VIEW-AS TEXT
      467             SIZE 9 BY .67
      468             FGCOLOR 1
      469        ub.ord-doc.obj-type AT ROW 3.67 COL 14.25 COLON-ALIGNED
      470             LABEL "Объект"
      471              VIEW-AS TEXT
      472             SIZE 4.75 BY .67
      473        ub.ord-doc.obj-code AT ROW 3.67 COL 19.38 COLON-ALIGNED NO-LABEL
      474              VIEW-AS TEXT
      475             SIZE 10 BY .67
      476        ub.clients.obj-name AT ROW 3.67 COL 33.5 COLON-ALIGNED NO-LABEL
      477              VIEW-AS TEXT
      478             SIZE 41 BY .67
      479        ub.ord-doc.cli-name AT ROW 4.79 COL 33.38 COLON-ALIGNED NO-LABEL
      480              VIEW-AS TEXT
      481             SIZE 41 BY 1
      482        RECT-3 AT ROW 2.04 COL 1
      483        RECT-2 AT ROW 1 COL 1
      484        SPACE(0.00) SKIP(9.08)
      485       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      486            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      487            TITLE "Заказ".
      488   ASSIGN
      489          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      490          FRAME Dialog-Frame:HIDDEN           = TRUE.
      491   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      492   DO:
      493     APPLY "END-ERROR":U TO SELF.
      494   END.
      495   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      496   DO:
      497   x-make-avto = 2 .
      498   doc-mode = "cancel":U.
      499   find current ub.ord-doc .
      500   if x-new = true then
      501      delete ub.ord-doc.
      502   END.
      503   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      504   DO:
      505    x-make-avto = 2 .
      506      if type-pr <> ? then do:
      507        x-make-avto = integer( logical(type-pr:screen-value) ) .
      508     end .
      509    assign
      510    ub.ord-doc.cli-code
      511    ub.ord-doc.cli-name
      512    ub.ord-doc.cli-type
      513    ub.ord-doc.doc-code
      514    ub.ord-doc.doc-date
      515    ub.ord-doc.doc-type
      516    ub.ord-doc.obj-code
      517    ub.ord-doc.obj-type
      518    .
      519   if not can-find ( first ub.clients where ub.clients.obj-code = ub.ord-doc.cli-code and  ub.clients.obj-type = ub.ord-doc.cli-type ) then do:
      520        message "Неправильно задан КОНТРАГЕНТ !" view-as alert-box.
      521        return no-apply.
      522   end.
      523   if ub.ord-doc.cli-type = 'маг':U or ub.ord-doc.cli-type = 'скл':U then do:
      524       message "Неправильно задан КОНТРАГЕНТ !" ub.ord-doc.cli-type view-as alert-box.
      525       return no-apply.
      526   end.
      527   doc-mode = 'ИЗМЕНЕНИЕ':U .
      528   END.
      529   ON CHOOSE OF r-obj IN FRAME Dialog-Frame
      530   DO:
      531   define variable bttns    as  char no-undo.
      532   define variable rid-list as  char no-undo .
      533     run ref/cli-all.w ( input parParentProc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  rid-list) no-error .
      534     find first post-clients where recid(post-clients) = integer(rid-list) no-lock no-error.
      535     if available post-clients then
      536     Assign
      537       ub.ord-doc.cli-code = Post-clients.obj-code
      538       ub.ord-doc.cli-type = Post-clients.obj-type
      539       ub.ord-doc.cli-name = post-clients.obj-name
      540     .
      541     Display ub.ord-doc.cli-code ub.ord-doc.cli-type ub.ord-doc.cli-name with frame Dialog-Frame.
      542     if ub.ord-doc.obj-code = ub.ord-doc.cli-code and
      543        ub.ord-doc.obj-type = ub.ord-doc.cli-type
      544        then do:
      545        message "Поставщик и Контрагент должны быть разные ! " view-as alert-box error .
      546        return no-apply.
      547        end.
      548   END.
      549   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      550   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      551   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   on help of frame Dialog-Frame
      553   do:
      554     run gbl/app_help.p
      555       (input this-procedure :file-name
      556       ,input ''
      557       ,input ?
      558       ) no-error.
      559     if error-status :error then do:
      560       message
      561         "Ошибка при вызове помощи"
      562         error-status :get-message(1)
      563         view-as alert-box .
      564     end.
      565   end.
      566   run minbtn-set in this-procedure .
      567   on choose of b-help in frame Dialog-Frame
      568   do:
      569     apply "help":u to frame Dialog-Frame .
      570   end.
      571   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      572   procedure minbtn-set :
      573       do
      574           on error undo, return error return-value
      575           :
      576           define variable ii              as integer       no-undo .
      577           define variable fh              as widget-handle no-undo .
      578           define variable hh              as widget-handle no-undo .
      579           define variable v-h             as handle        extent 4 no-undo .
      580           define variable v-name-button   as character     no-undo .
      581           define variable v-help-old-x    as decimal       no-undo .
      582           define variable v-help-old-y    as decimal       no-undo .
      583           define variable v-help-old-size as decimal       no-undo .
      584           define variable v-frame-width   as decimal       no-undo .
      585           define variable jj              as integer       no-undo .
      586           do
      587               on error undo, return error
      588               :
      589               assign
      590                   v-frame-width = frame Dialog-Frame:width - 0.3
      591                   fh            = frame Dialog-Frame:first-child
      592                   hh            = fh:first-child
      593                   ii            = 1
      594                   .
      595               do while valid-handle(hh):
      596                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      597                   do:
      598                       case lc(hh:name) :
      599                           when "b-help" then
      600                               do:
      601                                   hh:load-image-up("cmp/b-help.bmp":u) .
      602                                   hh:load-image-down("cmp/b-help.bmp":u) .
      603                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      604                                   hh:TOOLTIP = "Помощь" .
      605                                   v-help-old-x = hh:column .
      606                                   v-help-old-y = hh:row    .
      607                                   v-help-old-size = hh:width .
      608                                   hh:width-chars = 2.5 .
      609                               end.
      610                           when "b-print" then
      611                               do:
      612                                   hh:load-image("cmp/b-print.bmp":u) .
      613                                   hh:TOOLTIP = "Печать" .
      614                                   v-h[ii] = hh:handle .
      615                                   ii = ii + 1 .
      616                                   hh:width-chars = 3 .
      617                               end.
      618                           when "b-history" or
      619                           when "b-hist" then
      620                               do:
      621                                   hh:load-image("cmp/b-hist.bmp":u) .
      622                                   hh:TOOLTIP = "История" .
      623                                   v-h[ii] = hh:handle .
      624                                   ii = ii + 1 .
      625                                   hh:width-chars = 3 .
      626                               end.
      627                           when "b-sch" then
      628                               do:
      629                                   hh:load-image("cmp/b-sch.bmp":u) .
      630                                   hh:TOOLTIP = "Установка Фильтра" .
      631                                   v-h[ii] = hh:handle .
      632                                   ii = ii + 1 .
      633                                   hh:width-chars = 3 .
      634                               end.
      635                           when "b-hist-user" then
      636                               do:
      637                                   hh:load-image("cmp/b-hist.bmp":u) .
      638                                   hh:TOOLTIP = "История пользователя" .
      639                                   ii = ii + 1 .
      640                               end.
      641                       end case.
      642                   end.
      643                   hh = hh:next-sibling.
      644               end.
      645               b-help:column = v-frame-width - b-help:width-chars.
      646               jj = 0.
      647               repeat ii = 4 to 1 by -1 :
      648                   if valid-handle (v-h[ii] ) then
      649                   do:
      650                       jj  = jj + 1 .
      651                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      652                       v-h[ii]:row    = v-help-old-y .
      653                   end.
      654               end.
      655           end.
      656       end.
      657   end procedure.
      658   MAIN-BLOCK:
      659   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      660      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      661     run enable_ui in this-procedure .
      662     if ord-doc.doc-type  = 'ФП':U  then do:
      663        hide ord-doc.obj-code ord-doc.obj-type clients.obj-name in frame Dialog-Frame.
      664     end.
      665     run mm in this-procedure .
      666     frame Dialog-Frame:title = frame Dialog-Frame:title   .
      667     WAIT-FOR GO OF FRAME Dialog-Frame.
      668   END.
      669   run disable_ui in this-procedure .
      670   PROCEDURE disable_UI :
      671     HIDE FRAME Dialog-Frame.
      672   END PROCEDURE.
      673   PROCEDURE enable_UI :
      674     OPEN QUERY Dialog-Frame FOR EACH ub.ord-doc       WHERE ord-doc.doc-code = x-doc-code SHARE-LOCK,       EACH ub.clients WHERE ub.clients.obj-code = ord-doc.obj-code   AND ub.clients.obj-type = ord-doc.obj-type SHARE-LOCK.
      675     GET FIRST Dialog-Frame.
      676     IF AVAILABLE ub.clients THEN
      677       DISPLAY ub.clients.obj-name
      678         WITH FRAME Dialog-Frame.
      679     IF AVAILABLE ub.ord-doc THEN
      680       DISPLAY ub.ord-doc.cli-type ub.ord-doc.cli-code ub.ord-doc.doc-date
      681             ub.ord-doc.doc-code ub.ord-doc.doc-type ub.ord-doc.obj-type
      682             ub.ord-doc.obj-code ub.ord-doc.cli-name
      683         WITH FRAME Dialog-Frame.
      684     ENABLE B-OK RECT-3 RECT-2 B-exit B-Help ub.ord-doc.cli-type
      685            ub.ord-doc.cli-code r-obj ub.ord-doc.doc-date ub.ord-doc.doc-code
      686            ub.ord-doc.doc-type ub.ord-doc.obj-type ub.ord-doc.obj-code
      687            ub.clients.obj-name ub.ord-doc.cli-name
      688         WITH FRAME Dialog-Frame.
      689     VIEW FRAME Dialog-Frame.
      690   END PROCEDURE.
      691   PROCEDURE mm :
      692      create TOGGLE-BOX type-pr
      693      assign
      694       row    = 7
      695       column = 2
      696       screen-value = "no"
      697       label = "формировать строки автоматически без подтверждения"
      698       frame  = frame Dialog-Frame:handle
      699    .
      700   if valid-handle(type-pr) = false then do:
      701       message "не могу создать чек-бокс !!!" skip
      702       view-as alert-box information .
      703       return error.
      704    end.
      705     type-pr:sensitive = yes  .
      706     type-pr:visible   = yes  .
      707   END PROCEDURE.
