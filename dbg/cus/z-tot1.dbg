        6   define variable vss-revision    as character no-undo init "$Revision: e47eaee10c88, 211, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: SShalanin $":U .
        8   define variable vss-date        as character no-undo init "$Date: Tue Jun 30 11:11:56 2015 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: z-tot1.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: cus/z-tot1.p $":U .
