     2217    num#str# = num#str# + 1 .
     2218    run macr_excel_char_with_format in this-procedure ( reportname , num#str# , num#col#  ).
     2219    run macr_cell_format in this-procedure
     2220             ( 12    ,
     2221               true  ,
     2222               false ,
     2223               ?     ,
     2224               num#str# ,
     2225               num#col# ,
     2226               ? ,
     2227               ?         ) .
     2228   reportheader =   cur-time-print() .
     2229   num#str# = num#str# + 1 .
     2230   num#col# = 1 .
     2231   p-name = "Покупатель: " .
     2232   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2233   num#col# =  2 .
     2234   run macr_excel_char_with_format in this-procedure ( sh-clients.obj-name , num#str# , num#col#  ).
     2235   num#str# = num#str# + 1 .
     2236   num#col# =  1 .
     2237   p-name = "Поставщик: " .
     2238   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2239   num#col# =  2 .
     2240   run macr_excel_char_with_format in this-procedure ( post-clients.obj-name , num#str# , num#col#  ).
     2241   num#str# = num#str# + 1 .
