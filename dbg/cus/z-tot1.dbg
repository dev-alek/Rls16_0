     1791   FUNCTION excel-qnty-null RETURNS char (INPUT p-dec as decimal ).
     1792   if p-dec = 0 then Return ("").
     1793      else RETURN(format-excel-text(excel-format-dec-to-char(Round(p-dec,3)))) .
     1794   END FUNCTION.
     1795   main-block :
     1796   do on error undo main-block, return error
     1797   :
     1798   p-file-name =  string( session:temp-directory + "rpt" + string( g#report-num ) + ".txt" ) .
     1799   output stream outstream to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) )      .
     1800   output stream outstream2 to value(p-file-name).
     1801   find first buf_ord-doc no-lock where  buf_ord-doc.doc-code = p-ord-doc no-error .
     1802   if error-status :error then do:
     1803     assign
     1804       p-cli-type  = loc-cli-type
     1805       p-cli-code  = loc-cli-code
     1806       p-doc-type  = loc-doc-type
     1807       p-doc-date  = doc-date
     1808       p-ship-date = loc-date-ship
     1809       p-host-code = v-cntxt-host-code-obj
     1810       .
     1811   end.
     1812   else do:
     1813     assign
     1814       p-cli-type = buf_ord-doc.cli-type
     1815       p-cli-code = buf_ord-doc.cli-code
     1816       p-doc-type = buf_ord-doc.doc-type
     1817       p-doc-date = buf_ord-doc.doc-date
     1818       p-ship-date = loc-date-ship
     1819       p-ship-time = buf_ord-doc.ship-time
     1820       p-host-code = buf_ord-doc.host-code
     1821       .
     1822       if p-cli-type = ? or p-cli-code = ? then do:
     1823           assign
     1824           p-cli-type  =  loc-cli-type
     1825           p-cli-code  =  loc-cli-code
     1826           .
     1827       end.
     1828   end.
     1829   run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1830   output stream macr_excel to value(v-file-name)   .
     1831   v-ind = 1    .
     1832   num#str# = 1 .
     1833   num#col# = 1 .
     1834   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1835     if  log-manager:logfile-name ne ?
     1836     then DO:
     1837         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1838     end.
     1839     if not session:batch-mode then
     1840     do:
     1841       VIEW FRAME InfoFrame.
     1842       mFrameView = true.
     1843     end.
     1844      v-button-stop = false .
     1845         if mFrameView
     1846         then do:
     1847         if v-button-stop then view STOPBTN in frame InfoFrame.
     1848                          else Hide STOPBTN in frame InfoFrame.
     1849         end.
     1850   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1851   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1852     (input  p-obj-type
     1853     ,input  p-obj-code
     1854     ,output to-day
     1855     )  .
     1856   define variable p-name as character no-undo .
     1857   define buffer post-clients for ub.clients.
     1858   define buffer sh-clients for ub.clients.
     1859   find first sh-clients no-lock where
     1860              sh-clients.obj-type =   p-obj-type and
     1861              sh-clients.obj-code =   p-obj-code no-error  .
     1862              if error-status :error then next.
     1863   find first post-clients no-lock where
     1864              post-clients.obj-type =   p-cli-type and
     1865              post-clients.obj-code =   p-cli-code no-error  .
     1866              if error-status :error then next.
     1867   reportname =  ( if p-doc-type = 'ОФ':U then "Заявка " else  "Заказ " )
     1868                   + p-ord-doc +
     1869                  " от " +
     1870                  string( p-doc-date,"99/99/9999")
     1871                 .
     1872    num#col# = 0 .
     1873    num#str# = 0 .
     1874    num#col# = 1 .
     1875    num#str# = num#str# + 1 .
     1876    run macr_excel_char_with_format in this-procedure ( reportname , num#str# , num#col#  ).
     1877    run macr_cell_format in this-procedure
     1878             ( 12    ,
     1879               true  ,
     1880               false ,
     1881               ?     ,
     1882               num#str# ,
     1883               num#col# ,
     1884               ? ,
     1885               ?         ) .
     1886   run make-str-1 in this-procedure .
     1887       Output stream Macr_Excel  close .
     1888       run paramls-write in this-procedure
     1889         (input "file"
     1890         ,input "Результат"
     1891         ,input v-file-name
     1892         ) .
     1893    run mf in this-procedure .
     1894   run make-str-2 in this-procedure .
     1895       Output stream Macr_Excel  close .
     1896       run paramls-write in this-procedure
     1897         (input "file"
     1898         ,input "Статистика"
     1899         ,input v-file-name
     1900         ) .
     1901    Output stream OutStream   close .
     1902   if mFrameView
     1903   then do:
     1904      HIDE FRAME InfoFrame.
     1905   end.
     1906    run paramls-write in this-procedure
     1907     (input "command"
     1908     ,input ""
     1909     ,input 'workbook.select("Статистика","Статистика")'
     1910     ) .
     1911     run paramls-write in this-procedure
     1912           (input "charcol"
     1913           ,input ""
     1914           ,input "1,2,4,5,6,7"
     1915           ) .
     1916    run end-proc in this-procedure  .
     1917    run rep/runexcel.p ( string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1918    end.
     1919   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1920   procedure macr_excel_char :
     1921    do
     1922    on error undo, return error return-value
     1923    :
     1924    define input parameter  p-val as character no-undo .
     1925    define input parameter  p-row as integer no-undo .
     1926    define input parameter  p-col as integer no-undo .
     1927    if p-val = ? then p-val = "" .
     1928       put stream macr_excel unformatted
     1929             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1930    end.
     1931   end procedure.
     1932   procedure macr_excel_char_with_format :
     1933    do
     1934    on error undo, return error return-value
     1935    :
     1936    define input parameter  p-val as character no-undo .
     1937    define input parameter  p-row as integer no-undo .
     1938    define input parameter  p-col as integer no-undo .
     1939    if p-val = ? then p-val = "" .
     1940       put stream macr_excel unformatted
     1941             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1942       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1943       put stream macr_excel unformatted
     1944             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1945    end.
     1946   end procedure.
     1947   procedure macr_excel_cell_format :
     1948    do
     1949    on error undo, return error return-value
     1950    :
     1951    define input parameter  p-val    as character no-undo .
     1952    define input parameter  p-row    as integer   no-undo .
     1953    define input parameter  p-col    as integer   no-undo .
     1954    define input parameter  p-format as character no-undo .
     1955    if p-val = ? then p-val = "" .
     1956       put stream macr_excel unformatted
     1957             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1958       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1959       put stream macr_excel unformatted
     1960             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1961    end.
     1962   end procedure.
     1963   procedure macr_excel_sum :
     1964    do
     1965    on error undo, return error return-value
     1966    :
     1967    define input parameter  p-row as integer no-undo .
     1968    define input parameter  p-col as integer no-undo .
     1969    define input parameter  p-row1 as integer no-undo .
     1970    define input parameter  p-col1 as integer no-undo .
     1971    define input parameter  p-row2 as integer no-undo .
     1972    define input parameter  p-col2 as integer no-undo .
     1973       put stream macr_excel unformatted
     1974             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1975    end.
     1976   end procedure.
     1977   procedure macr_excel_dec :
     1978    do
     1979    on error undo, return error return-value
     1980    :
     1981    define input parameter  p-val as character no-undo .
     1982    define input parameter  p-row as integer   no-undo .
     1983    define input parameter  p-col as integer   no-undo .
     1984     if p-val = ? then p-val =  "" .
     1985      put  stream macr_excel unformatted
     1986           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1987    end.
     1988   end procedure.
     1989   procedure macr_cell_format :
     1990    do
     1991    on error undo, return error return-value
     1992    :
     1993    define input parameter  p-size   as integer   no-undo .
     1994    define input parameter  p-bold   as logical   no-undo .
     1995    define input parameter  p-italic as logical   no-undo .
     1996    define input parameter  p-color  as integer   no-undo .
     1997    define input parameter  p-row    as integer   no-undo .
     1998    define input parameter  p-col    as integer   no-undo .
     1999    define input parameter  p-row-2  as integer   no-undo .
     2000    define input parameter  p-col-2  as integer   no-undo .
     2001     if p-size = ? then p-size = 10 .
     2002     if p-bold = ? then p-bold = false .
     2003     if p-italic = ? then p-italic = false .
     2004     if p-row-2 = ? then p-row-2 = p-row .
     2005     if p-col-2 = ? then p-col-2 = p-col .
     2006     put  stream macr_excel unformatted
     2007      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2008     if p-color <> ? then do:
     2009        put  stream macr_excel unformatted
     2010          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2011     end.
     2012     put  stream macr_excel unformatted
     2013          substitute('format.font(,&1,&2,&3)' , p-size,
     2014                                           string ( p-bold  , "true/false" ) ,
     2015                                           string ( p-italic , "true/false" )
     2016                                           ) + chr(10) .
     2017    end.
     2018   end procedure.
     2019   procedure macr_cell_size :
     2020    do
     2021    on error undo, return error return-value
     2022    :
     2023    define input parameter  p-w   as integer   no-undo .
     2024    define input parameter  p-l   as integer   no-undo .
     2025    define input parameter  p-row    as integer   no-undo .
     2026    define input parameter  p-col    as integer   no-undo .
     2027    define input parameter  p-row-2  as integer   no-undo .
     2028    define input parameter  p-col-2  as integer   no-undo .
     2029     if p-row-2 = ? then p-row-2 = p-row .
     2030     if p-col-2 = ? then p-col-2 = p-col .
     2031     if p-w = ? then    p-w = 0 .
     2032     if p-l = ? then    p-l = 0 .
     2033    define variable s-w as character no-undo .
     2034    define variable s-l as character no-undo .
     2035    if p-w = 0 then s-w = "" .
     2036               else s-w = string(p-w)  .
     2037    if p-l = 0 then s-l = "" .
     2038               else s-l = string(p-l)  .
     2039   put  stream macr_excel unformatted
     2040        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2041   put  stream macr_excel unformatted
     2042        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2043   put  stream macr_excel unformatted
     2044        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2045    end.
     2046   end procedure.
     2047   procedure proc-print-header :
     2048    do
     2049    on error undo, return error return-value
     2050    :
     2051      find first sheetf .
     2052        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2053        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2054        var-1 =  num#str# .
     2055        repeat c-c = 1 to sheetf.excel-row-title :
     2056        num#str# = num#str# + 1 .
     2057        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2058        do c-i = 1 to p-var :
     2059           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2060           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2061           num#col# = c-i .
     2062           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2063           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2064        end.
     2065       c-i = 0.
     2066       end.
     2067       run macr_cell_format (
     2068           10       ,
     2069           true     ,
     2070           false    ,
     2071           35       ,
     2072           var-1 + 1,
     2073           1        ,
     2074           num#str# ,
     2075           num#col# )
     2076           .
     2077     put  stream macr_excel unformatted
     2078          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2079          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2080          .
     2081    end.
     2082   end procedure.
     2083   procedure end-proc :
     2084    do
     2085    on error undo, return error return-value
     2086    :
     2087     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2088     OUTPUT to VALUE (v-file-name) .
     2089     for each temp-param :
     2090       export  temp-param  .
     2091     end.
     2092    end.
     2093   end procedure.
     2094   procedure make-str-1 :
     2095    do
     2096    on error undo, return error return-value
     2097    :
     2098   num#col# = 0 .
     2099    num#str# = 0 .
     2100    num#col# = 1 .
     2101    num#str# = num#str# + 1 .
     2102    run macr_excel_char_with_format in this-procedure ( reportname , num#str# , num#col#  ).
     2103    run macr_cell_format in this-procedure
     2104             ( 12    ,
     2105               true  ,
     2106               false ,
     2107               ?     ,
     2108               num#str# ,
     2109               num#col# ,
     2110               ? ,
     2111               ?         ) .
     2112   reportheader =   cur-time-print() .
     2113   num#col# = num#col# + 1 .
     2114   num#str# = num#str# + 1 .
     2115   num#col# = 1 .
     2116   p-name = "Покупатель: " .
     2117   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2118   num#col# =  2 .
     2119   run macr_excel_char_with_format in this-procedure ( sh-clients.obj-name , num#str# , num#col#  ).
     2120   num#str# = num#str# + 1 .
     2121   num#col# =  1 .
     2122   p-name = "Поставщик: " .
     2123   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2124   num#col# =  2 .
     2125   run macr_excel_char_with_format in this-procedure ( post-clients.obj-name , num#str# , num#col#  ).
     2126   num#str# = num#str# + 1 .
     2127   num#col# = 1 .
     2128   p-name = "Дата печати: " .
     2129   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2130   num#col# = 2 .
     2131   run macr_excel_char_with_format in this-procedure ( string( today ,"99/99/9999") , num#str# , num#col#  ).
     2132   num#str# = num#str# + 1 .
     2133   num#col# = 1 .
     2134   p-name = "Планируемая дата доставки: " .
     2135   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2136   num#col# = 2 .
     2137   run macr_excel_char_with_format in this-procedure ( string( p-ship-date,"99/99/9999") , num#str# , num#col#  ).
     2138   num#col# = 3 .
     2139   run macr_excel_char_with_format in this-procedure ( string( p-ship-time,"hh:mm") , num#str# , num#col#  ).
     2140    run macr_cell_format in this-procedure  (
     2141           10       ,
     2142           true     ,
     2143           false    ,
     2144           36      ,
     2145           6        ,
     2146           1        ,
     2147           6        ,
     2148          ( if p-doc-type <> 'ОФ':U then 24    else 17 )
     2149            )
     2150           .
     2151   num#col# =  0.
     2152   num#str# = num#str# + 1 .
     2153   num#col# = num#col# + 1 .
     2154   p-name = "Артикул" .
     2155   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2156   put  stream macr_excel unformatted  'COLUMN.WIDTH(17,,,,)'  skip.
     2157   num#col# = num#col# + 1 .
     2158   p-name = "Тип производителя " .
     2159   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2160   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2161   num#col# = num#col# + 1 .
     2162   p-name = "Код производителя " .
     2163   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2164   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2165   num#col# = num#col# + 1 .
     2166   p-name = "Название товара" .
     2167   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2168   put  stream macr_excel unformatted  'COLUMN.WIDTH(50,,,,)'  skip.
     2169   num#col# = num#col# + 1 .
     2170   p-name = "Артикул поставщика" .
     2171   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2172   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2173   num#col# = num#col# + 1 .
     2174   p-name = "Цена в валюте поставщика на баз.ед.изм." .
     2175   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2176   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2177   num#col# = num#col# + 1 .
     2178   p-name = "Количество в баз.ед.изм" .
     2179   run macr_excel_char_with_format in this-procedure ( p-name , num#str# , num#col#  ).
     2180   put  stream macr_excel unformatted  'COLUMN.WIDTH(13,,,,)'  skip.
     2181   put  stream macr_excel unformatted  'COLUMN.WIDTH(15,,,,)'  skip.
     2182     put  stream macr_excel unformatted
     2183          substitute('select("r&1c&2:r&3c&4 ")' , 6  , 1 , num#str# ,  num#col# ) + chr(10)  +
     2184           'BORDER( 2 , 2 , 2 , 2 , 8 , ) '  + chr(10) +
     2185          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2186          .
     2187   num#col# =  0.
     2188   for each  buf_ord-line no-lock where  buf_ord-line.doc-code = p-ord-doc break by buf_ord-line.line-num  :
     2189       find first ub.goods no-lock where
     2190             ub.goods.artic     = buf_ord-line.artic     and
     2191             ub.goods.prod-type = buf_ord-line.prod-type and
     2192             ub.goods.prod-code = buf_ord-line.prod-code no-error .
     2193             if error-status :error then next.
     2194       find first ub.clients no-lock where
     2195             ub.goods.prod-type = ub.clients.obj-type and
     2196             ub.goods.prod-code = ub.clients.obj-code no-error .
     2197             if error-status :error then next.
     2198       num#col# = 1 .
     2199       num#str# = num#str# + 1 .
     2200       run macr_excel_char_with_format in this-procedure ( buf_ord-line.artic , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2201       run macr_excel_char_with_format in this-procedure ( buf_ord-line.prod-type , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2202       run macr_excel_char_with_format in this-procedure ( buf_ord-line.prod-code , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2203       run macr_excel_char_with_format in this-procedure ( ub.goods.gds-name , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2204       run macr_excel_char_with_format in this-procedure ( (if buf_ord-line.cli-art <> ? then buf_ord-line.cli-art  else "") , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2205       run macr_excel_dec in this-procedure ( determined ( buf_ord-line.price-cli / buf_ord-line.cli-base-rate) , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2206       run macr_excel_dec in this-procedure ( buf_ord-line.qnty       , num#str# , num#col#  ). num#col# = num#col# + 1 .
     2207   end.
     2208    end.
     2209   end procedure.
     2210   procedure make-str-2 :
     2211    do
     2212    on error undo, return error return-value
     2213    :
     2214    num#col# = 0 .
     2215    num#str# = 0 .
