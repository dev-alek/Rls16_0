     1364                   for each gds-dtl no-lock
     1365                          where gds-dtl.prod-type = buf_doc-line.prod-type
     1366                            and gds-dtl.prod-code = buf_doc-line.prod-code
     1367                            and gds-dtl.artic     = buf_doc-line.artic
     1368                            and gds-dtl.doc-code  = buf_doc-line.doc-code
     1369                            :
     1370                             kol-vo = gds-dtl.doc-qnty.
     1371                                  find first gds-prt no-lock
     1372                                  where gds-prt.node-code = gds-dtl.prt-code no-error
     1373                                  .
     1374                                  art = gds-dtl.artic.
     1375                                  if available (gds-prt) then do:
     1376                                   if gds-prt.node-name = '_Пустая шкала':U then next.
     1377                                         else
     1378                                         v-prt-name = gds-prt.f-name.
     1379                                 t1  = "-".
     1380                                 if r-index(v-prt-name, "/") > 0 then overlay ( v-prt-name, r-index(v-prt-name, "/"), 1) = t1.
     1381                                 end.
     1382                                 else next.
     1383                                 if v-prt-name = "-" or v-prt-name = "" then next.
     1384                              PUT STREAM v-s1 UNFORMATTED "N35;"
     1385                              st2 ";"
     1386                              v-pref buf_trn-doc.doc-code substring(string(year(buf_trn-doc.fact-date)),3,2)  ";"
     1387                              year(buf_trn-doc.fact-date) "-" string(month(buf_trn-doc.fact-date),'99') "-" string(day(buf_trn-doc.fact-date),'99') ";"
     1388                              art + '-' +  v-prt-name ";"
     1389                              kol-vo
     1390                              skip.
     1391                    end.
     1392                    end.
     1393                    end.
     1394                    end.
     1395               OUTPUT STREAM v-s1 CLOSE.
     1396       end.
     1397          assign e-mail2 = "".
     1398          DO i = 1 TO LENGTH(v-email):
     1399          assign  e-mail3 = entry ( i , v-email , ";" ) no-error.
     1400          if e-mail3 = e-mail2 then next.
     1401          else
     1402          assign e-mail2 = e-mail3.
     1403          if e-mail2 <> "":U then do:
     1404          run gbl/sendmail.p
     1405           ( input e-mail2
     1406           , input "Reports from Trade House"
     1407           , input "Reports from Trade House"
     1408           , input p-attach-files2
     1409           ) no-error .
     1410        end.
     1411        end.
