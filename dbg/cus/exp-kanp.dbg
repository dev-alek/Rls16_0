      201   procedure schedule-attr-name :
      202   do
      203     on error undo, return error
      204     :
      205     define input  parameter p-code           as character no-undo .
      206     define output parameter p-type           as character no-undo .
      207     define output parameter p-format         as character no-undo .
      208     define output parameter p-label          as character no-undo .
      209     define output parameter p-user-can-edit  as logical   no-undo .
      210     define output parameter p-output-display as logical   no-undo .
      211     define output parameter p-other          as character no-undo .
      212       if index(p-code, chr(4)) > 0 then do:
      213         p-code = entry(1, p-code, chr(4)).
      214       end.
      215       case p-code :
      216               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      217               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      218               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      219               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      220               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      221               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      222               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      223               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      224               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      225         otherwise do:
      226           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      227         end.
      228       end.
      229     end.
      230   end procedure.
      231   procedure schedule-attr-tooltip :
      232   do
      233     on error undo, return error
      234     :
      235       define input  parameter p-code    as character no-undo .
      236       define output parameter p-tooltip as character no-undo .
      237       define output parameter p-label   as character no-undo .
      238       if index(p-code, chr(4)) > 0 then do:
      239         p-code = entry(1, p-code, chr(4)).
      240       end.
      241       case p-code :
      242               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      243               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      244               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      245               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      246               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      247               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      248               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      249               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      250               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      251         otherwise do:
      252               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      253         end.
      254       end.
      255     end.
      256   end procedure.
      257   procedure schedule-attr-value :
      258   do
      259   on error undo, return error return-value
      260   :
      261   define input parameter  p-cre-db-num as integer    no-undo.
      262   define input parameter  p-task-type  as character  no-undo.
      263   define input parameter  p-task-num   as integer    no-undo.
      264   define input parameter  p-code       as character  no-undo.
      265   define output parameter p-value      as character  no-undo.
      266   define output parameter p-type       as character  no-undo.
      267       define variable v-format         as character no-undo .
      268       define variable v-label          as character no-undo .
      269       define variable v-user-can-edit  as logical   no-undo .
      270       define variable v-output-display as logical   no-undo .
      271       define variable v-other          as character no-undo .
      272       define buffer buf_schedule-attr for ub.schedule-attr.
      273       run schedule-attr-name in this-procedure (
      274             input  p-code
      275           , output p-type
      276           , output v-format
      277           , output v-label
      278           , output v-user-can-edit
      279           , output v-output-display
      280           , output v-other
      281       ) no-error .
      282       if error-status :error
      283       then do:
      284           undo, return error return-value .
      285       end.
      286       if p-code begins ('schd-free-id':U + chr(4))
      287       and entry(2, p-code, chr(4)) = '':U then do:
      288         find first buf_schedule-attr no-lock
      289             where buf_schedule-attr.cre-db-num = p-cre-db-num
      290               and buf_schedule-attr.task-type  = p-task-type
      291               and buf_schedule-attr.task-num   = p-task-num
      292               and buf_schedule-attr.attr-code  begins p-code
      293         no-error .
      294       end.
      295       else do:
      296         find first buf_schedule-attr no-lock
      297             where buf_schedule-attr.cre-db-num = p-cre-db-num
      298               and buf_schedule-attr.task-type  = p-task-type
      299               and buf_schedule-attr.task-num   = p-task-num
      300               and buf_schedule-attr.attr-code  = p-code
      301         no-error .
      302       end.
      303       if available buf_schedule-attr
      304       then do:
      305           assign
      306               p-value = buf_schedule-attr.attr-value
      307           .
      308       end.
      309       else do:
      310         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      311            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      312         end.
      313         else do:
      314           assign
      315               p-value = if p-type = 'L':U then "no":U else ""
      316           .
      317         end.
      318       end.
      319   end.
      320   end procedure.
      321   procedure schedule-attr-write :
      322   do
      323   on error undo, return error
      324   :
      325   define input parameter p-cre-db-num  as integer   no-undo.
      326   define input parameter p-task-type   as character no-undo.
      327   define input parameter p-task-num    as integer   no-undo.
      328   define input parameter p-code        as character no-undo.
      329   define input parameter p-value       as character no-undo.
      330       define variable v-type              as character                no-undo.
      331       define variable v-format            as character                no-undo.
      332       define variable v-label             as character                no-undo.
      333       define variable v-user-can-edit     as logical                  no-undo.
      334       define variable v-output-display    as logical                  no-undo.
      335       define variable v-other             as character                no-undo.
      336       define buffer buf_schedule-attr for ub.schedule-attr .
      337       run schedule-attr-name in this-procedure (
      338             input  p-code
      339           , output v-type
      340           , output v-format
      341           , output v-label
      342           , output v-user-can-edit
      343           , output v-output-display
      344           , output v-other
      345       ) no-error.
      346       if error-status :error
      347       then do:
      348           undo, return error return-value.
      349       end.
      350       find first buf_schedule-attr exclusive-lock
      351            where buf_schedule-attr.cre-db-num = p-cre-db-num
      352              and buf_schedule-attr.task-type  = p-task-type
      353              and buf_schedule-attr.task-num   = p-task-num
      354              and buf_schedule-attr.attr-code  = p-code
      355       no-error.
      356       if not available buf_schedule-attr
      357       then do:
      358           create buf_schedule-attr.
      359           assign
      360             buf_schedule-attr.cre-db-num = p-cre-db-num
      361             buf_schedule-attr.task-type  = p-task-type
      362             buf_schedule-attr.task-num   = p-task-num
      363             buf_schedule-attr.attr-code  = p-code
      364             buf_schedule-attr.attr-value = p-value
      365           .
      366       end.
      367       else do:
      368           assign
      369               buf_schedule-attr.attr-value = p-value
      370           .
      371       end.
      372   end.
      373   end procedure.
      374   procedure schedule-attr-delete :
      375   do
      376   on error undo, return error
      377   :
      378   define input  parameter p-cre-db-num  as integer   no-undo.
      379   define input  parameter p-task-type   as character no-undo.
      380   define input  parameter p-task-num    as integer   no-undo.
      381   define input  parameter p-code        as character no-undo.
      382   define output parameter p-deleted     as logical   no-undo.
      383       define buffer buf_schedule-attr for ub.schedule-attr .
      384       define variable v-type              as character                no-undo.
      385       define variable v-format            as character                no-undo.
      386       define variable v-label             as character                no-undo.
      387       define variable v-user-can-edit     as logical                  no-undo.
      388       define variable v-output-display    as logical                  no-undo.
      389       define variable v-other             as character                no-undo.
      390       run schedule-attr-name in this-procedure (
      391             input p-code
      392           , output v-type
      393           , output v-format
      394           , output v-label
      395           , output v-user-can-edit
      396           , output v-output-display
      397           , output v-other
      398       ) no-error .
      399       if error-status :error
      400       then do:
      401           undo, return error return-value .
      402       end.
      403       find first buf_schedule-attr exclusive-lock
      404            where buf_schedule-attr.cre-db-num = p-cre-db-num
      405              and buf_schedule-attr.task-type  = p-task-type
      406              and buf_schedule-attr.task-num   = p-task-num
      407              and buf_schedule-attr.attr-code  = p-code
      408       no-error.
      409       if not available buf_schedule-attr
      410       then do:
      411           assign
      412               p-deleted = no
      413           .
      414       end.
      415       else do:
      416           delete buf_schedule-attr.
      417           assign
      418               p-deleted = yes
      419           .
      420       end.
      421   end.
      422   end procedure.
      423   procedure schedule-attr-news :
      424   do
      425   on error undo, return error
      426   :
      427       define input  parameter p-code           as character no-undo .
      428       define output parameter p-news           as logical   no-undo .
      429       if index(p-code, chr(4)) > 0 then do:
      430         p-code = entry(1, p-code, chr(4)).
      431       end.
      432       case p-code :
      433               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      434               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      435               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      436               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      437               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      438               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      439               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      440               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      441               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      442         otherwise do:
      443           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      444         end.
      445       end.
      446   end.
      447   end procedure.
      448   procedure schedule-attr-extract-logical :
      449   do
      450   on error undo, return error
      451   :
      452   define input  parameter p-parameter-number   as integer      no-undo.
      453   define input  parameter p-parameter-list     as character    no-undo.
      454   define output parameter p-parameter-value   as logical      no-undo.
      455       if num-entries( p-parameter-list ) > p-parameter-number - 1
      456       then do:
      457           assign
      458               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      459           .
      460       end.
      461       else do:
      462           assign
      463               p-parameter-value   = no
      464           .
      465       end.
      466   end.
      467   end procedure.
      468   procedure schedule-attr-get-free-id :
      469   do
      470   on error undo, return error return-value
      471   :
      472     define input  parameter p-cre-db-num  as integer   no-undo.
      473     define input  parameter p-task-type   as character no-undo.
      474     define input  parameter p-task-num    as integer   no-undo.
      475     define output parameter p-free-id     as character no-undo.
      476     define buffer buf_schedule-attr for ub.schedule-attr.
      477     find first buf_schedule-attr no-lock
      478         where buf_schedule-attr.cre-db-num = p-cre-db-num
      479           and buf_schedule-attr.task-type  = p-task-type
      480           and buf_schedule-attr.task-num   = p-task-num
      481           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      482     no-error .
      483     if available buf_schedule-attr then
      484     assign
      485     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      486     no-error
      487     .
      488   end.
      489   end procedure.
      490   procedure schedule-attr-get-free-props :
      491     define input parameter p-free-id as character no-undo .
      492     define output parameter p-value as character no-undo .
      493     define buffer buf_temp-schedule-free for temp-schedule-free.
      494     do
      495     on error undo, return error return-value
      496     :
      497       find first buf_temp-schedule-free no-lock no-error .
      498       if not available buf_temp-schedule-free then do:
      499         run schedule-attr-fill-free-props in this-procedure .
      500       end.
      501       find first buf_temp-schedule-free where
      502               buf_temp-schedule-free.free-id = p-free-id no-error.
      503       if available buf_temp-schedule-free then do:
      504         assign
      505         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      506                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      507                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      508                   buf_temp-schedule-free.conf-param           + chr(4) +
      509                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      510                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      511                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      512                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      513                   buf_temp-schedule-free.other-info
      514         .
      515       end.
      516       else do:
      517        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      518                              "id произвольной задачи - &5"
      519                              ,vss-workfile
      520                              ,vss-revision
      521                              ,vss-description
      522                              ,chr(10)
      523                              ,p-free-id).
      524       end.
      525     end.
      526   end procedure.
      527   procedure schedule-attr-is-rum-free-id :
      528   define input parameter p-free-id as character no-undo .
      529   define output parameter p-is-rum as logical no-undo .
      530   define buffer buf_temp-schedule-free for temp-schedule-free.
      531   do
      532   on error undo, return error
      533   :
      534       find first buf_temp-schedule-free no-lock no-error .
      535       if not available buf_temp-schedule-free then do:
      536         run schedule-attr-fill-free-props in this-procedure .
      537       end.
      538       find first buf_temp-schedule-free where
      539               buf_temp-schedule-free.free-id = p-free-id no-error.
      540       if available buf_temp-schedule-free
      541       and buf_temp-schedule-free.is-rum
      542       then do:
      543         p-is-rum = yes.
      544       end.
      545   end.
      546   end procedure.
      547   procedure schedule-attr-fill-free-props :
      548   define variable v-path                    as character                no-undo .
      549   DEFINE VARIABLE v-full-path               as character                no-undo .
      550   DEFINE VARIABLE v-file-name               as character                no-undo .
      551   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      552   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      553   define buffer buf_temp-schedule-free for temp-schedule-free.
      554   define variable v-answer as logical no-undo .
      555     do
      556     on error undo, return error substitute("&1 &2 &3&4&5&4"
      557                                           ,vss-workfile
      558                                           ,vss-revision
      559                                           ,vss-description
      560                                           ,chr(10)
      561                                           ,error-status:get-message(1) )
      562     :
      563       run gbl/filename.p (
      564                       input 'cmp/shd-free.d'
      565                     ,output v-full-path
      566                     ,output v-path
      567                     ,output v-file-name
      568                     ,output v-file-name-no-ext
      569                     ,output v-file-name-ext
      570                     ) .
      571       input from value(v-full-path).
      572       repeat :
      573         create buf_temp-schedule-free.
      574         import buf_temp-schedule-free.
      575       END.
      576       input close.
      577       _ff:
      578       for each buf_temp-schedule-free :
      579         if buf_temp-schedule-free.free-id = '':U then do:
      580            delete buf_temp-schedule-free.
      581            next _ff.
      582          end.
      583          run schedule-attr-check-enc in this-procedure (
      584                                                       input  buf_temp-schedule-free.free-id
      585                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      586                                                               buf_temp-schedule-free.proc-param-edit-name +
      587                                                               buf_temp-schedule-free.conf-param +
      588                                                               string(buf_temp-schedule-free.is-gbd) +
      589                                                               string(buf_temp-schedule-free.is-ubd) +
      590                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      591                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      592                                                               string(buf_temp-schedule-free.other-info)
      593                                                               )
      594                                                       ,input  buf_temp-schedule-free.enc-key
      595                                                       ,output v-answer    ) no-error .
      596          if error-status:error
      597          or not v-answer then delete buf_temp-schedule-free.
      598        end.
      599     end.
      600   end procedure.
      601   Function schedule-attr-reverse returns character (str as character).
      602      define variable rev_incl_s as character init "" no-undo .
      603      define variable rev_incl_i as integer no-undo .
      604      define variable rev_incl_l as integer no-undo .
      605      rev_incl_l = length(str).
      606      do rev_incl_i = 1 to rev_incl_l:
      607         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      608      end.
      609      return rev_incl_s.
      610   end.
      611   procedure schedule-attr-check-enc.
      612     define input  parameter p-free-id   as character no-undo .
      613     define input  parameter p-value     as character no-undo .
      614     define input  parameter p-enc-value as character no-undo .
      615     define output parameter p-answer    as logical   no-undo .
      616     define variable tmp         as character no-undo .
      617     define variable v-enc-value as character no-undo .
      618     assign
      619     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      620     .
      621     run schedule-attr-pswd-enc in this-procedure
      622       ( input tmp
      623        ,output v-enc-value
      624       ) no-error .
      625     if error-status:error then do:
      626       message
      627         vss-workfile vss-revision vss-description skip
      628         "Ошибка при вызове процедуры pswd-enc" skip
      629         return-value skip
      630         error-status :get-message(1) skip
      631         view-as alert-box error .
      632       undo, return error .
      633     end.
      634     if v-enc-value = p-enc-value then do:
      635       assign
      636         p-answer = true
      637       .
      638     end.
      639     else do:
      640       assign
      641         p-answer = false
      642       .
      643     end.
      644   end.
      645   procedure schedule-attr-conf-enc.
      646     define input  parameter p-free-id   as character no-undo .
      647     define input  parameter p-value     as character no-undo .
      648     define output parameter p-enc-value as character no-undo .
      649     define variable tmp         as character no-undo .
      650     assign
      651       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      652     .
      653     run schedule-attr-pswd-enc in this-procedure
      654       ( input tmp
      655        ,output p-enc-value
      656       ) no-error .
      657     if error-status:error then do:
      658       message
      659         vss-workfile vss-revision vss-description skip
      660         "Ошибка при вызове процедуры pswd-enc" skip
      661         return-value skip
      662         error-status :get-message(1) skip
      663         view-as alert-box error .
      664       undo, return error .
      665     end.
      666   end procedure.
      667   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   procedure schedule-attr-pswd-enc :
      669     define input parameter  pswd     as character no-undo .
      670     define output parameter enc-pswd as character no-undo .
      671     do
      672     on error undo, return error return-value
      673     :
      674       assign
      675         enc-pswd = encode(pswd + string(index(pswd, "k")))
      676       .
      677     end.
      678   end procedure.
      679   define variable vss-include-info3 as character format "X(65)" no-undo
