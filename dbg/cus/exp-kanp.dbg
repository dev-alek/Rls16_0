       90   define new global shared variable g#vssrevis-logger as handle    no-undo .
       91   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       92   define variable v-vssrevis-logger                   as handle    no-undo .
       93   procedure vss-logevent :
       94     define input  parameter p-extra-paramters as character no-undo .
       95     define variable v-vssrevis-parameters as character no-undo .
       96     do
       97     on error undo, return error return-value
       98     :
       99       if  valid-handle(v-vssrevis-logger)
      100       and v-vssrevis-logger :get-signature("logevent") <> ""
      101       then do:
      102         run vss-get-parameters in this-procedure
      103           (output v-vssrevis-parameters
      104           ).
      105         run logevent in v-vssrevis-logger
      106           (input vss-workfile
      107           ,input vss-revision
      108           ,input v-vssrevis-parameters
      109           ,input p-extra-paramters
      110           ).
      111       end.
      112     end.
      113   end procedure.
      114   assign
      115     v-vssrevis-logger = g#vssrevis-logger
      116   .
      117   if  valid-handle(v-vssrevis-logger)
      118   and v-vssrevis-logger :get-signature("logevent") <> ""
      119   then do:
      120     assign
      121       v-vssrevis-logevent = true
      122     .
      123     run vss-logevent in this-procedure (input vss-description) .
      124   end.
