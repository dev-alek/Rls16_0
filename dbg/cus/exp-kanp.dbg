      702   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      703   define variable v-waitfram-action01         as character   no-undo .
      704   define variable v-waitfram-action02         as character   no-undo .
      705   define variable v-waitfram-action03         as character   no-undo .
      706   define variable mWaitFramTextBeg            as character   no-undo.
      707   define variable mWaitFramTextEnd            as character   no-undo.
      708   define variable mWaitFramView               as logical     no-undo.
      709   define variable mWaitProcEvent              as logical     no-undo init yes.
      710   define variable mWaitFramInterval           as integer     no-undo init 1 .
      711   define variable mWaitFramStop               as logical     no-undo.
      712   define variable mWaitFramStopUser           as logical     no-undo.
      713   define variable mWaitFramStopTimeOut        as logical     no-undo.
      714   define variable mWaitFramStartProc          as datetime-tz no-undo.
      715   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      716   define button B-WaitFramStop auto-end-key
      717        label "Стоп"
      718        size 10 by 1 tooltip "Остоновить процесс".
      719   define button B-viewProcInfo
      720        label "Информация"
      721        size 15 by 1 tooltip "Информация о процесс".
      722   define frame waitfram
      723     v-waitfram-action01 format "x(72)" no-label skip
      724     v-waitfram-action02 format "x(72)" no-label skip
      725     v-waitfram-action03 format "x(72)" no-label skip
      726     B-viewProcInfo
      727     B-WaitFramStop at row 4 col 30
      728     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      729     .
      730   define new global shared variable mBatchMode as logical no-undo init ?.
      731   define variable mFramBachModHandle as handle no-undo.
      732   mFramBachModHandle = frame waitfram:handle.
      733   define variable mFameOldVis as logical no-undo.
      734   define variable mVisCUrentVin as logical no-undo.
      735   if session:batch-mode
      736   then
      737      mBatchMode = yes.
      738   if mBatchMode = ? then do:
      739     mVisCUrentVin = current-window:visible.
      740     mFameOldVis = mFramBachModHandle:visible.
      741     mFramBachModHandle:visible  = yes.
      742     mBatchMode = mFramBachModHandle:visible ne yes.
      743     mFramBachModHandle:visible = mFameOldVis.
      744     current-window:visible = mVisCUrentVin.
      745   end.
      746    if  log-manager:logfile-name ne ?
      747     then DO:
      748         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      749         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      750         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      751     end.
      752   on choose of B-WaitFramStop in frame waitfram
      753   do:
      754     mWaitFramStop = yes.
      755     mWaitFramStopUser = yes.
      756   end.
      757   function waitfram-check-timeout returns logical():
      758      define variable vtime as int64 no-undo.
      759      if mWaitFramStopTimeOut
      760      then
      761         return yes.
      762      vtime = ( now - mWaitFramStartProc ) / 1000 .
      763      if     mWaitFramTimeOut ne ?
      764         and mWaitFramTimeOut ne 0
      765         and mWaitFramTimeOut lt vtime
      766      then do:
      767         mWaitFramStopTimeOut = yes.
      768      end.
      769      return mWaitFramStopTimeOut.
      770   end.
      771   procedure waitfram-hide :
      772     if not session:batch-mode
      773     then do
      774     on error undo, return error return-value
      775     :
      776       pause 0 before-hide .
      777       if not mBatchMode then
      778         hide frame waitfram .
      779     if     not mWaitFramView
      780        and mWaitProcEvent
      781     then
      782       process events .
      783     end.
      784   end procedure.
      785   procedure waitfram-show :
      786     define input  parameter p-message as character no-undo .
      787     define variable v-left-margin as integer   no-undo .
      788     if not session:batch-mode
      789     then do
      790     on error undo, return error return-value
      791     :
      792       if length(p-message) <= 70 then do:
      793         assign
      794           v-left-margin = integer((70 - length(p-message)) / 2)
      795         .
      796         assign
      797           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      798         .
      799         assign
      800           v-waitfram-action01 = " "
      801           v-waitfram-action02 = " "
      802                                    + fill(" ", v-left-margin)
      803                                    + p-message
      804           v-waitfram-action03 = " "
      805         .
      806       end.
      807       else do:
      808         define variable vRindex1 as integer no-undo.
      809         define variable vRindex2 as integer no-undo.
      810         vRindex1 = r-index(p-message," ",70).
      811         if vRindex1 = 0
      812         then
      813            vRindex1 = 70.
      814         if length(p-message)  <= vRindex1 + 70 then do:
      815           assign
      816             v-waitfram-action01 = " "
      817             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      818             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      819           .
      820         end.
      821         else do:
      822           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      823           if vRindex2 <= vRindex1
      824           then
      825              vRindex2 = vRindex1 + 70.
      826           assign
      827             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      828             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      829             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      830           .
      831         end.
      832       end.
      833       B-viewProcInfo:visible   in frame waitfram = no.
      834       B-viewProcInfo:sensitive in frame waitfram = no.
      835       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      836       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      837       if  (   mWaitFramView
      838          or  mWaitProcEvent)
      839          and not mBatchMode
      840       then
      841          display
      842             v-waitfram-action01 skip
      843             v-waitfram-action02 skip
      844             v-waitfram-action03 skip
      845          with frame waitfram .
      846       if     mWaitFramView
      847          then do:
      848             if     mWaitFramInterval ne ?
      849                and not mBatchMode
      850             then
      851                wait-for go of frame waitfram pause mWaitFramInterval.
      852          end.
      853          else
      854             if     mWaitProcEvent
      855                and not mBatchMode
      856             then
      857                process events .
      858     end.
      859   end procedure.
      860      procedure waitfram-show-this:
      861         define input  parameter iInterval as int64 no-undo.
      862         define variable vtime as int64 no-undo.
      863         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      864         mWaitFramInterval = iInterval.
      865         run waitfram-show (substitute("&1&2 &3&4" ,
      866                                       mWaitFramTextBeg ,
      867                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      868                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      869                                       mWaitFramTextEnd
      870                                      )
      871                           ).
      872      end.
      873      procedure WaitFramRunPause:
      874         define input  parameter iInterval as dec no-undo.
      875         define variable vStart  as datetime-tz no-undo.
      876         define variable vend    as datetime-tz no-undo.
      877         define variable vint as int64 no-undo.
      878         define variable vOk as logical no-undo.
      879         vStart = now.
      880         vend   = vStart.
      881         publish "WaitFramPause" (iInterval,output vOk).
      882         vend   =  now.
      883         vint = vend - vStart.
      884         vint = iInterval - vint / 1000.
      885         if     not mWaitFramStop
      886            and (   vint > 0
      887                 or (    not vOk
      888                     and iInterval eq ?
      889                     )
      890                 )
      891         then
      892            run waitfram-show-this (iInterval).
      893         vend   =  now.
      894         vint = vend - vStart.
      895         vint = iInterval - vint / 1000.
      896         if     not mWaitFramStop
      897            and vint > 0
      898         then do:
      899            run gbl/pause.p (vint * 1000).
      900         end.
      901         if iInterval ne ?
      902         then
      903            publish "WaitFramStop".
      904         waitfram-check-timeout().
      905      end.
      906      procedure WaitFramWaitFor:
      907         define input  parameter iInterval as dec no-undo.
      908         assign
      909            mWaitFramStartProc   = now
      910            mWaitFramStopUser    = no
      911            mWaitFramStopTimeOut = no
      912         .
      913         block-wait:
      914         do while not mWaitFramStop:
      915            run WaitFramRunPause (iInterval).
      916            if  waitfram-check-timeout()
      917            then do:
      918               leave block-wait.
      919            end.
      920         end.
      921         run waitfram-hide.
      922      end.
      923   procedure waitfram-join :
      924     define input  parameter p-line-1  as character no-undo .
      925     define input  parameter p-line-2  as character no-undo .
      926     define input  parameter p-line-3  as character no-undo .
      927     define output parameter p-message as character no-undo .
      928     do
      929     on error undo, return error return-value
      930     :
      931       assign
      932         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      933                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      934                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      935       .
      936     end.
      937   end procedure.
      938   function waitfram-join-function returns character
      939     (input p-line-1 as character
      940     ,input p-line-2 as character
      941     ,input p-line-3 as character
      942     ).
      943     define variable v-message as character no-undo .
      944     run waitfram-join in this-procedure
      945       (input  p-line-1
      946       ,input  p-line-2
      947       ,input  p-line-3
      948       ,output v-message
      949       ) .
      950     return v-message .
      951   end function .
      952   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      953   define new global shared variable g#trdcalib as handle no-undo.
      954   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      956   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      957   define variable par-type          as character no-undo.
      958   define variable v-value-character as character no-undo .
      959   define variable v-value-date      as date      no-undo .
      960   define variable v-value-decimal   as decimal   no-undo .
      961   define variable v-value-integer   as integer   no-undo .
      962   define variable v-value-logical   as logical   no-undo .
      963      if p-db-num = 0 and p-task-num = 0 and p-cre-db-num = 0 and entry(1, p-task-type , ";") = "noauto" then
      964      do:
      965         dateb = date(entry ( 2, p-task-type , ";")).
      966         dateend = date(entry (3 , p-task-type , ";")).
      967         v-impstr = entry ( 4 , p-task-type , ";" ).
      968         v-impstr-2 = entry ( 5 ,p-task-type , ";" ).
      969         v-impstr-3 = entry ( 6 , p-task-type , ";" ).
      970         v-impstr-4 = entry ( 7 , p-task-type , ";" ).
      971         v-impstr-5 = entry ( 10 , p-task-type , ";" ).
      972         v-impstr-6 = entry ( 8 , p-task-type , ";" ).
      973         v-impstr-9 = entry ( 9 , p-task-type , ";" ).
      974         v-email    = entry ( 2 , p-task-type , "!" ) no-error.
      975      end.
      976      else
      977      do:
      978         run schedule-attr-value in this-procedure (
      979             input p-cre-db-num
      980           , input p-task-type
      981           , input p-task-num
      982           , input 'schedule-param-list':U
      983           , output v-param-list
      984           , output v-param-type
      985       ).
      986           v-impstr = entry ( 1 , v-param-list , "!" ).
      987           v-impstr-2 = entry ( 2 , v-param-list , "!" ).
      988           v-impstr-3 = entry ( 3 , v-param-list , "!" ).
      989           v-impstr-4 = entry ( 4 , v-param-list , "!" ).
      990           v-impstr-5 = entry ( 8 , v-param-list , "!" ).
      991           v-impstr-6 = entry ( 5 , v-param-list , "!" ).
      992           v-impstr-9 = entry ( 6 , v-param-list , "!" ).
      993           v-email    = entry ( 7 , v-param-list , "!" ) no-error.
      994           v-dnow = string(today - 1).
      995           v-dnow =  REPLACE ( v-dnow , "/"  , "." ).
      996             if v-impstr <> "" then
      997           assign v-impstr = SUBSTRING(STRING(v-impstr), 1 ,length(v-impstr) - 4 ) + STRING(v-dnow) + ".txt".
      998             if v-impstr-2 <> "" then
      999           assign v-impstr-2 = SUBSTRING(STRING(v-impstr-2), 1 ,length(v-impstr-2) - 4 ) + STRING(v-dnow) + ".txt".
     1000             if v-impstr-3 <> "" then
     1001           assign v-impstr-3 = SUBSTRING(STRING(v-impstr-3), 1 ,length(v-impstr-3) - 4 ) + STRING(v-dnow) + ".txt".
     1002             if v-impstr-5 <> "" then
     1003           assign v-impstr-5 = SUBSTRING(STRING(v-impstr-5), 1 ,length(v-impstr-5) - 4 ) + STRING(v-dnow) + ".txt".
     1004             if v-impstr-6 <> "" then
     1005           assign v-impstr-6 = SUBSTRING(STRING(v-impstr-6), 1 ,length(v-impstr-6) - 4 ) + STRING(v-dnow) + ".txt".
     1006             if v-impstr-9 <> "" then
     1007           assign v-impstr-9 = SUBSTRING(STRING(v-impstr-9), 1 ,length(v-impstr-9) - 4 ) + STRING(v-dnow) + ".txt".
     1008                assign  dateb = today - 1
     1009                  dateend = today - 1.
     1010      end.
     1011         do:
     1012           def var v-file-line-str as character initial "" no-undo.
     1013           def var v-file-line-str-t   as character    initial "" no-undo.
     1014           def var v-file-line-num as integer initial 0 no-undo.
     1015           def var v-count-err as integer initial 0 no-undo.
     1016           def var v-complex-err as character initial "" no-undo.
     1017           def var v-err-msg-string as character initial "" no-undo.
     1018           def var v-sum-parameter as integer initial 0 no-undo.
     1019           def var v-flag-err as logical INITIAL false no-undo.
     1020           def var v-char-space        as integer      initial 0 no-undo.
     1021           INPUT FROM value(v-impstr-4).
     1022               repeat:
     1023                   import  unformatted v-file-line-str.
     1024                       v-file-line-num = v-file-line-num + 1.
     1025                       v-file-line-str-t = trim(v-file-line-str).
     1026                       v-sum-parameter = NUM-ENTRIES(v-file-line-str-t, ",").
     1027                       if length(v-file-line-str) <> ? and length(v-file-line-str) >= 0 and v-sum-parameter = 0 then
     1028                           do:
     1029                               v-char-space = v-char-space + 1.
     1030                           end.
     1031                       case v-sum-parameter:
     1032                           WHEN 0 THEN
     1033                               do:
     1034                                   next.
     1035                               end.
     1036                           WHEN 1 THEN
     1037                               do:
     1038                                   v-complex-err = v-complex-err + string(v-file-line-num)
     1039                                   + ", ".
     1040                                   v-flag-err = true.
     1041                                   v-count-err = v-count-err + 1.
     1042                               end.
     1043                           WHEN 2 THEN
     1044                               do:
     1045                                   v-complex-err = v-complex-err + string(v-file-line-num)
     1046                                   + ", ".
     1047                                   v-flag-err = true.
     1048                                   v-count-err = v-count-err + 1.
     1049                               end.
     1050                           WHEN 3 THEN
     1051                               do:
     1052                                   next.
     1053                               end.
     1054                       END CASE.
     1055               end.
     1056           if v-file-line-num = 0 or (v-char-space = v-file-line-num and v-flag-err = false) then
     1057               message
     1058                   "Уведомление:" skip
     1059                   "В выбранном файле соответствий не задано ни одного параметра." skip
     1060                   "В связи с этим, вся ыгрузка будет произведена с форматом по умолчанию."
     1061               view-as alert-box.
     1062           v-complex-err = substring(v-complex-err, 1, (length(v-complex-err) - 2)) + ".".
     1063           if v-flag-err = true and v-file-line-num > 0 then
     1064                   message
     1065                       "Ошибка в заполнении файла соответствий!" skip
     1066                       "Проверьте формат заполнения файла соответствий (обязательно для каждой строки:" skip
     1067                       "   - количество параметров в строке;" skip
     1068                   "   - наличие разделителей-запятых;" skip
     1069                   "   - в конце файла добавьте пустую строку (без текста))." skip
     1070                   "Найдены строки с ошибками (с учёт. пуст. строк): №№ " v-complex-err skip
     1071                       "Итого ошибок = " v-count-err "."
     1072                   view-as alert-box error.
     1073           INPUT CLOSE.
     1074         if v-flag-err = false then
     1075             do:
     1076         INPUT FROM value(v-impstr-4).
     1077         repeat:
     1078            create imptable.
     1079            IMPORT DELIMITER "," imptable.obj-type imptable.obj-code imptable.st.
     1080                 END.
     1081                 INPUT CLOSE.
     1082         END.
     1083         else
     1084         return.
     1085     end.
     1086   if v-impstr <> "" then
     1087       do:
     1088       assign p-attach-files2 = p-attach-files2 + v-impstr.
     1089       OUTPUT STREAM v-s1 TO value(v-impstr).
     1090       FOR EACH buf_trn-doc
     1091       WHERE  buf_trn-doc.ext-doc-type = 'ev':U AND  buf_trn-doc.sys-date >= dateb and buf_trn-doc.sys-date <= dateend NO-LOCK
     1092       BY buf_trn-doc.status_ BY buf_trn-doc.doc-code :
     1093            find first imptable no-lock where imptable.obj-type = buf_trn-doc.obj-type and imptable.obj-code = buf_trn-doc.obj-code no-error.
     1094            IF  AVAILABLE imptable THEN
     1095            st = imptable.st.
     1096            else
     1097            do:
     1098            st = "R" + string(buf_trn-doc.obj-code).
     1099            end.
     1100                  find first imptable no-lock where imptable.obj-type = buf_trn-doc.cli-type and imptable.obj-code = buf_trn-doc.cli-code no-error.
     1101                  IF AVAILABLE imptable then
     1102                  st2 = imptable.st.
     1103                  else
     1104                  do:
     1105                  st2 = "R" + string(buf_trn-doc.cli-code).
     1106                  end.
     1107                  if st = st2 then  next.
     1108                  if buf_trn-doc.status_ = 'факт':U and buf_trn-doc.fact-date <> buf_trn-doc.doc-date then
     1109                   do:
     1110                    v-char-status = 'o,c'.
     1111                    v-dd = buf_trn-doc.doc-date.
     1112                    end.
     1113                  else
     1114                  if buf_trn-doc.status_ = 'факт':U and buf_trn-doc.fact-date = buf_trn-doc.doc-date then
     1115                    do:
     1116                    v-char-status = 'o,c'.
     1117                    v-dd = buf_trn-doc.doc-date.
     1118                    end.
     1119                  else
     1120                      do:
     1121                  v-char-status = 'o'.
     1122                  v-dd = buf_trn-doc.doc-date.
     1123                      end.
     1124                    do i = 1 to num-entries(v-char-status):
     1125                      if i = 2 then v-dd = buf_trn-doc.fact-date.
     1126                     for each buf_doc-line no-lock where
     1127                     buf_trn-doc.doc-code = buf_doc-line.doc-code :
     1128                          for each gds-dtl no-lock
     1129                          where gds-dtl.prod-type = buf_doc-line.prod-type
     1130                            and gds-dtl.prod-code = buf_doc-line.prod-code
     1131                            and gds-dtl.artic     = buf_doc-line.artic
     1132                            and gds-dtl.doc-code  = buf_doc-line.doc-code
     1133                            :
