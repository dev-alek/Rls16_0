     1135                                  find first gds-prt no-lock
     1136                                  where gds-prt.node-code = gds-dtl.prt-code no-error
     1137                                  .
     1138                                  art = gds-dtl.artic.
     1139                                  if available (gds-prt) then do:
     1140                                   if gds-prt.node-name = '_Пустая шкала':U then next.
     1141                                         else
     1142                                         v-prt-name = gds-prt.f-name.
     1143                                  t1  = "-".
     1144                                 if r-index(v-prt-name, "/") > 0 then overlay ( v-prt-name, r-index(v-prt-name, "/"), 1) = t1.
     1145                                 end.
     1146                                 else next.
     1147                      if v-prt-name = "-" or v-prt-name = "" then next.
     1148                     PUT STREAM v-s1 UNFORMATTED "N10;"
     1149                    st2   ";"
     1150                    st    ";"
     1151                    buf_trn-doc.doc-CODE substring(string(year(v-dd)),3,2) st ";"
     1152                    year(v-dd) "-" string(month(v-dd),'99') "-" string(day(v-dd),'99') ";"
     1153                    buf_trn-doc.doc-CODE substring(string(year(v-dd)),3,2) st  ";"
     1154                    art + '-' +  v-prt-name ";"
     1155                    string(kol-vo)   ";"
     1156                    entry(i,v-char-status)
     1157                    SKIP.
     1158             end.
     1159           end.
     1160           end.
     1161           end.
     1162   OUTPUT STREAM v-s1 CLOSE.
     1163   end.
     1164   if v-impstr-2 <> "" then
     1165   do:
     1166       if p-attach-files2 = "" then assign p-attach-files2 = p-attach-files2  + v-impstr-2.
     1167       else
