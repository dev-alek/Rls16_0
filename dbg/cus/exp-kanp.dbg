     1220                                         find first gds-prt no-lock
     1221                                         where gds-prt.node-code = gds-dtl.prt-code  no-error
     1222                                         .
     1223                                         art = gds-dtl.artic.
     1224                                          if available (gds-prt) then do:
     1225                                         if gds-prt.node-name = '_Пустая шкала':U then next.
     1226                                         else
