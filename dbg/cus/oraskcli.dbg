        1   define input  parameter parParentProc   AS WIDGET-HANDLE NO-UNDO.
        2   define input  parameter v-recid         as character no-undo .
        3   define output parameter v-ord-doc-code  as character no-undo .
        4   define new global shared variable g#language as character no-undo .
        5   if g#language <> '' and g#language <> 'rus':U then do:
        6     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        7   end.
        8   define new global shared variable g#library  as handle no-undo .
        9   define new global shared variable g#library2 as handle no-undo .
       10   define   shared variable g#auto as logical no-undo.
       11   define   shared variable g#news as logical no-undo.
       12   define   shared variable g#oxml as logical no-undo.
       13   define   shared variable g#esys as logical no-undo.
       14   define   shared variable g#news-source-db as integer no-undo.
       15   define   shared variable g#esys-source-esys as integer no-undo.
       16   define   shared variable g#db-num as integer   no-undo .
       17   define   shared variable g#userid as character no-undo .
       18   define   shared variable g#passwd as character no-undo .
       19   procedure proc-alt-shift-f2:
       20     if not ibs.th.gbl.gbl-var:rcode
       21   then
       22     run gbl\inidebug.p .
       23   end.
       24   procedure proc-alt-shift-f3:
       25     run gbl/prvssinf.p
       26       ( input this-procedure
       27       ) .
       28   end.
       29   define variable v-inform-launched as logical no-undo initial false .
       30   procedure proc-alt-shift-f4:
       31     define variable v-action as character no-undo .
       32     if v-inform-launched = false then do:
       33       assign
       34         v-inform-launched = true
       35       .
       36       run gbl/d-inform.w
       37         (  input self
       38         ,  input this-procedure
       39         , output v-action
       40         ) no-error .
       41       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       42       assign
       43         v-inform-launched = false
       44       .
       45     end.
       46   end.
       47   procedure proc-alt-f1:
       48     run gbl/corrhelp.p
       49       (input this-procedure
       50       ) .
       51   end .
       52   on alt-shift-f2 anywhere do:
       53     run proc-alt-shift-f2.
       54   end.
       55   on alt-shift-f3 anywhere do:
       56     run proc-alt-shift-f3 in this-procedure .
       57   end.
       58   on alt-shift-f4 anywhere do:
       59     run proc-alt-shift-f4 in this-procedure.
       60   end.
       61   on alt-f1 anywhere do:
       62     run proc-alt-f1 in this-procedure .
       63   end.
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65     define variable v-cntxt-db-num        as integer   no-undo .
       66     define variable v-cntxt-userid        as character no-undo .
       67     define variable v-cntxt-level         as character no-undo .
       68     define variable v-cntxt-host-code-obj as integer   no-undo .
       69     define variable v-cntxt-obj-type      as character no-undo .
       70     define variable v-cntxt-obj-code      as integer   no-undo .
       71     define variable v-cntxt-db-num-obj    as integer   no-undo .
       72     define variable v-cntxt-is-admin      as logical   no-undo .
       73   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74     run mainmenu_getcntxt in parparentproc
       75       (output v-cntxt-db-num
       76       ,output v-cntxt-userid
       77       ,output v-cntxt-level
       78       ,output v-cntxt-host-code-obj
       79       ,output v-cntxt-obj-type
       80       ,output v-cntxt-obj-code
       81       ,output v-cntxt-db-num-obj
       82       ,output v-cntxt-is-admin
       83       ) .
       84   define buffer buf_clients for ub.clients  .
       85   DEFINE BUTTON b-exit AUTO-GO
       86        LABEL "&Ввод"
       87        SIZE 10 BY 1.
       88   DEFINE BUTTON B-help DEFAULT
       89        LABEL "Помо&щь"
       90        SIZE 10 BY 1
       91        BGCOLOR 8 .
       92   DEFINE BUTTON b-quit AUTO-END-KEY
       93        LABEL "&Отмена"
       94        SIZE 10 BY 1.
       95   DEFINE BUTTON r-cli
       96        IMAGE-UP FILE "btn-down-arrow":U
       97        IMAGE-DOWN FILE "btn-down-arrow":U
       98        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       99        LABEL "r-cli"
      100        SIZE 3 BY .88 TOOLTIP "Выбор из списка".
      101   DEFINE VARIABLE v-obj AS CHARACTER FORMAT "X(256)":U
      102        LABEL "Объект"
      103        VIEW-AS COMBO-BOX INNER-LINES 5
      104        LIST-ITEM-PAIRS "Item 1","Item 1",
      105                        "Item 2","Item 2"
      106        DROP-DOWN-LIST
      107        SIZE 28.5 BY 1 NO-UNDO.
      108   DEFINE VARIABLE loc_cli-code AS INTEGER FORMAT ">>>>>>>>9" INITIAL ?
      109        VIEW-AS FILL-IN
      110        SIZE 9.5 BY 1.
      111   DEFINE VARIABLE loc_cli-name AS CHARACTER FORMAT "X(40)"
      112         VIEW-AS TEXT
      113        SIZE 40 BY 1
      114        FGCOLOR 4 .
      115   DEFINE VARIABLE loc_cli-type AS CHARACTER FORMAT "X(3)" INITIAL "орг"
      116         VIEW-AS TEXT
      117        SIZE 2.88 BY 1.
      118   DEFINE VARIABLE v-date-1 AS DATE FORMAT "99/99/99":U
      119        VIEW-AS FILL-IN
      120        SIZE 9 BY 1 NO-UNDO.
      121   DEFINE VARIABLE v-date-2 AS DATE FORMAT "99/99/99":U
      122        VIEW-AS FILL-IN
      123        SIZE 9 BY 1 NO-UNDO.
      124   DEFINE VARIABLE v-date-post AS DATE FORMAT "99/99/99":U
      125        VIEW-AS FILL-IN
      126        SIZE 9 BY 1 NO-UNDO.
      127   DEFINE VARIABLE RADIO-ord-type AS CHARACTER
      128        VIEW-AS RADIO-SET VERTICAL
      129        RADIO-BUTTONS
      130             "ФП", "1",
      131   "ОП", "2"
      132        SIZE 20.5 BY 2.25 NO-UNDO.
      133   DEFINE FRAME Dialog-Frame
      134        b-exit AT ROW 1 COL 1.13
      135        b-quit AT ROW 1 COL 11.13
      136        B-help AT ROW 1 COL 50.5
      137        RADIO-ord-type AT ROW 3 COL 1.5 NO-LABEL
      138        v-obj AT ROW 4.25 COL 29.5 COLON-ALIGNED WIDGET-ID 2
      139        loc_cli-code AT ROW 7 COL 1.5 NO-LABEL
      140        r-cli AT ROW 7 COL 14.63
      141        v-date-post AT ROW 8.67 COL 20.5 NO-LABEL
      142        v-date-1 AT ROW 9.75 COL 20.5 NO-LABEL
      143        v-date-2 AT ROW 9.75 COL 32.5 NO-LABEL
      144        loc_cli-type AT ROW 7 COL 9.5 COLON-ALIGNED NO-LABEL
      145        loc_cli-name AT ROW 7 COL 16 COLON-ALIGNED NO-LABEL
      146        "Поставщик" VIEW-AS TEXT
      147             SIZE 24 BY .67 AT ROW 6.25 COL 1.5
      148             FGCOLOR 4
      149        "Тип заказа" VIEW-AS TEXT
      150             SIZE 19 BY .67 AT ROW 2.25 COL 1.5
      151             FGCOLOR 4
      152        "На период продаж" VIEW-AS TEXT
      153             SIZE 17 BY 1 AT ROW 9.75 COL 1.5
      154             FGCOLOR 4
      155        "Дата доставки" VIEW-AS TEXT
      156             SIZE 14 BY 1 AT ROW 8.67 COL 1.5
      157             FGCOLOR 4
      158        SPACE(45.12) SKIP(2.61)
      159       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      160            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      161            TITLE "Введите параметры заказа".
      162   ASSIGN
      163          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      164          FRAME Dialog-Frame:HIDDEN           = TRUE.
      165   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      166   DO:
      167     APPLY "END-ERROR":U TO SELF.
      168   END.
      169   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      170   DO:
      171     ASSIGN loc_cli-code loc_cli-type RADIO-ord-type v-date-1 v-date-2 v-date-post .
      172     if  loc_cli-code  = ? or
      173         loc_cli-type  = ? or
      174         RADIO-ord-type = ? or
      175         v-date-1       = ? or
      176         v-date-2       = ? or
      177         v-date-post    = ? then do:
      178         message "Не заданы параметры для создания заказа!  "
      179         view-as alert-box information .
      180         return no-apply.
      181     end.
      182     if v-date-post <= today then do:
      183        message "Не верно задана дата доставки! Дата должна быть больше  " + string( today ,"99/99/9999")
      184        view-as alert-box information .
      185        return no-apply.
      186     end.
      187     if v-date-1 > v-date-2 then do:
      188        message "Не верно задан интервал! "
      189        view-as alert-box information .
      190        return no-apply.
      191     end.
      192     if v-date-1 <= today then do:
      193        message "Не верно задано начало интервала! "
      194        view-as alert-box information .
      195        return no-apply.
      196     end.
      197     run cus/cr-ordop.p
      198         (   input parParentProc,
      199             input RADIO-ord-type,
      200             input loc_cli-code,
      201             input loc_cli-type,
      202             input v-date-post,
      203             input v-date-1 ,
      204             input v-date-2 ,
      205             input v-recid,
      206             OUTPUT v-ord-doc-code
      207             ).
      208     RETURN.
      209   END.
      210   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      211   DO:
      212     v-ord-doc-code = "".
      213   END.
      214   ON LEAVE OF loc_cli-code IN FRAME Dialog-Frame
      215   DO:
      216   assign loc_cli-code loc_cli-type.
      217   def buffer b#clients for ub.clients.
      218    find first b#clients WHERE
      219       b#clients.obj-code = loc_cli-code   and
      220       b#clients.obj-type = loc_cli-type
      221        no-lock no-error.
      222    if avail b#clients then do:
      223       Assign
      224           loc_cli-code = b#clients.obj-code
      225           loc_cli-type = b#clients.obj-type
      226           loc_cli-name = b#clients.obj-name
      227           .
      228       Display
      229         loc_cli-code loc_cli-name loc_cli-type
      230       with frame Dialog-Frame .
      231       Enable
      232          loc_cli-code
      233       with frame Dialog-Frame .
      234   end.
      235   else   do:
      236     apply "CHOOSE" to r-cli IN FRAME Dialog-Frame        .
      237   end.
      238   END.
      239   ON return OF loc_cli-code IN FRAME Dialog-Frame
      240   DO:
      241   END.
      242   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
      243   DO:
      244   define variable rid-list    as  char no-undo .
      245   define variable rep-rec2    as recid no-undo .
      246   define buffer   b#clients for ub.clients.
      247     run ref/cli-all.w ( parparentproc, input "b-sel", 'орг':U, ?, ?, ?, ?, ?, output  rid-list).
      248     assign rep-rec2 = integer(rid-list) no-error.
      249             find first b#clients where recid(b#clients) = rep-rec2 no-lock no-error.
      250             if avail b#clients then do:
      251                 Assign
      252                     loc_cli-code = b#clients.obj-code
      253                     loc_cli-type = b#clients.obj-type
      254                     loc_cli-name = b#clients.obj-name .
      255             end.
      256       display  loc_cli-code loc_cli-name loc_cli-type
      257       with frame Dialog-Frame .
      258       enable  loc_cli-code
      259       with frame Dialog-Frame .
      260   END.
      261   ON VALUE-CHANGED OF RADIO-ord-type IN FRAME Dialog-Frame
      262   DO:
      263     assign radio-ord-type.
      264       if radio-ord-type = 'ОП':U then do:
      265          enable v-obj with frame Dialog-Frame .
      266       end.
      267       else do:
      268           v-obj = v-cntxt-obj-type + string(v-cntxt-obj-code) .
      269           disable v-obj with frame Dialog-Frame .
      270       end.
      271   END.
      272   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      273   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      274   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      275   on help of frame Dialog-Frame
      276   do:
      277     run gbl/app_help.p
      278       (input this-procedure :file-name
      279       ,input ''
      280       ,input ?
      281       ) no-error.
      282     if error-status :error then do:
      283       message
      284         "Ошибка при вызове помощи"
      285         error-status :get-message(1)
      286         view-as alert-box .
      287     end.
      288   end.
      289   run minbtn-set in this-procedure .
      290   on choose of b-help in frame Dialog-Frame
      291   do:
      292     apply "help":u to frame Dialog-Frame .
      293   end.
      294   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   procedure minbtn-set :
      296       do
      297           on error undo, return error return-value
      298           :
      299           define variable ii              as integer       no-undo .
      300           define variable fh              as widget-handle no-undo .
      301           define variable hh              as widget-handle no-undo .
      302           define variable v-h             as handle        extent 4 no-undo .
      303           define variable v-name-button   as character     no-undo .
      304           define variable v-help-old-x    as decimal       no-undo .
      305           define variable v-help-old-y    as decimal       no-undo .
      306           define variable v-help-old-size as decimal       no-undo .
      307           define variable v-frame-width   as decimal       no-undo .
      308           define variable jj              as integer       no-undo .
      309           do
      310               on error undo, return error
      311               :
      312               assign
      313                   v-frame-width = frame Dialog-Frame:width - 0.3
      314                   fh            = frame Dialog-Frame:first-child
      315                   hh            = fh:first-child
      316                   ii            = 1
      317                   .
      318               do while valid-handle(hh):
      319                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      320                   do:
      321                       case lc(hh:name) :
      322                           when "b-help" then
      323                               do:
      324                                   hh:load-image-up("cmp/b-help.bmp":u) .
      325                                   hh:load-image-down("cmp/b-help.bmp":u) .
      326                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      327                                   hh:TOOLTIP = "Помощь" .
      328                                   v-help-old-x = hh:column .
      329                                   v-help-old-y = hh:row    .
      330                                   v-help-old-size = hh:width .
      331                                   hh:width-chars = 2.5 .
      332                               end.
      333                           when "b-print" then
      334                               do:
      335                                   hh:load-image("cmp/b-print.bmp":u) .
      336                                   hh:TOOLTIP = "Печать" .
      337                                   v-h[ii] = hh:handle .
      338                                   ii = ii + 1 .
      339                                   hh:width-chars = 3 .
      340                               end.
      341                           when "b-history" or
      342                           when "b-hist" then
      343                               do:
      344                                   hh:load-image("cmp/b-hist.bmp":u) .
      345                                   hh:TOOLTIP = "История" .
      346                                   v-h[ii] = hh:handle .
      347                                   ii = ii + 1 .
      348                                   hh:width-chars = 3 .
      349                               end.
      350                           when "b-sch" then
      351                               do:
      352                                   hh:load-image("cmp/b-sch.bmp":u) .
      353                                   hh:TOOLTIP = "Установка Фильтра" .
      354                                   v-h[ii] = hh:handle .
      355                                   ii = ii + 1 .
      356                                   hh:width-chars = 3 .
      357                               end.
      358                           when "b-hist-user" then
      359                               do:
      360                                   hh:load-image("cmp/b-hist.bmp":u) .
      361                                   hh:TOOLTIP = "История пользователя" .
      362                                   ii = ii + 1 .
      363                               end.
      364                       end case.
      365                   end.
      366                   hh = hh:next-sibling.
      367               end.
      368               b-help:column = v-frame-width - b-help:width-chars.
      369               jj = 0.
      370               repeat ii = 4 to 1 by -1 :
      371                   if valid-handle (v-h[ii] ) then
      372                   do:
      373                       jj  = jj + 1 .
      374                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      375                       v-h[ii]:row    = v-help-old-y .
      376                   end.
      377               end.
      378           end.
      379       end.
      380   end procedure.
      381   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   on ' ' of v-date-post in frame Dialog-Frame
      383   do:
      384     if (can-query (self, "sensitive")
      385        and
      386        self :sensitive = true
      387        )
      388     or (can-query (self, "read-only")
      389        and
      390        self :read-only = false
      391        )
      392     then do:
      393       assign
      394         self :screen-value = ?
      395       .
      396     end.
      397     return no-apply.
      398   end.
      399   on delete-character of v-date-post in frame Dialog-Frame
      400   do:
      401     if (can-query (self, "sensitive")
      402        and
      403        self :sensitive = true
      404        )
      405     or (can-query (self, "read-only")
      406        and
      407        self :read-only = false
      408        )
      409     then do:
      410       assign
      411         self :screen-value = ?
      412       .
      413     end.
      414     return no-apply.
      415   end.
      416   on ctrl-d of v-date-post in frame Dialog-Frame
      417   do:
      418     define variable v-curr-sv-date as date no-undo .
      419     if (can-query (self, "sensitive")
      420        and
      421        self :sensitive = true
      422        )
      423     or (can-query (self, "read-only")
      424        and
      425        self :read-only = false
      426        )
      427     then do:
      428       if self :handle <> focus :handle
      429       then do:
      430         apply "entry":u to self .
      431       end.
      432       run gbl/getcurdt.p
      433         (output v-curr-sv-date
      434         ) .
      435       assign
      436         self :screen-value = string(v-curr-sv-date) .
      437       .
      438     end.
      439     return no-apply.
      440   end.
      441   on ctrl-b of v-date-post in frame Dialog-Frame
      442   do:
      443     if (can-query (self, "sensitive")
      444        and
      445        self :sensitive = true
      446        )
      447     or (can-query (self, "read-only")
      448        and
      449        self :read-only = false
      450        )
      451     then do:
      452       if self :handle <> focus :handle
      453       then do:
      454         apply "entry":u to self .
      455       end.
      456       define variable v-curr-sv-date as date no-undo .
      457       define variable v-new-sv-date  as date no-undo .
      458       assign
      459         v-curr-sv-date = date(self :screen-value) no-error
      460       .
      461       if v-curr-sv-date = ?
      462       then do:
      463         run gbl/getcurdt.p
      464           (output v-curr-sv-date
      465           ) .
      466       end.
      467       if v-curr-sv-date <> ?
      468       then do:
      469         assign
      470           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      471         .
      472         assign
      473           self :screen-value = string(v-new-sv-date) .
      474         .
      475       end.
      476     end.
      477     return no-apply .
      478   end.
      479   on ctrl-e of v-date-post in frame Dialog-Frame
      480   do:
      481     if (can-query (self, "sensitive")
      482        and
      483        self :sensitive = true
      484        )
      485     or (can-query (self, "read-only")
      486        and
      487        self :read-only = false
      488        )
      489     then do:
      490       if self :handle <> focus :handle
      491       then do:
      492         apply "entry":u to self .
      493       end.
      494       define variable v-curr-sv-date as date no-undo .
      495       define variable v-new-sv-date  as date no-undo .
      496       assign
      497         v-curr-sv-date = date(self :screen-value) no-error
      498       .
      499       if v-curr-sv-date = ?
      500       then do:
      501         run gbl/getcurdt.p
      502           (output v-curr-sv-date
      503           ) .
      504       end.
      505       if v-curr-sv-date <> ?
      506       then do:
      507         run gbl/lastdate.p
      508           (input  v-curr-sv-date
      509           ,output v-new-sv-date
      510           ).
      511         assign
      512           self :screen-value = string(v-new-sv-date) .
      513         .
      514       end.
      515     end.
      516     return no-apply .
      517   end.
      518   on ctrl-f of v-date-post in frame Dialog-Frame
      519   do:
      520     if (can-query (self, "sensitive")
      521        and
      522        self :sensitive = true
      523        )
      524     or (can-query (self, "read-only")
      525        and
      526        self :read-only = false
      527        )
      528     then do:
      529       if self :handle <> focus :handle
      530       then do:
      531         apply "entry":u to self .
      532       end.
      533       define variable v-ok            as logical   no-undo .
      534       define variable v-curr-sv-date  as date      no-undo .
      535       define variable v-description   as character no-undo .
      536       assign
      537         v-curr-sv-date = date(self :screen-value) no-error
      538       .
      539       if v-curr-sv-date = ?
      540       then do:
      541         run gbl/getcurdt.p
      542           (output v-curr-sv-date
      543           ) .
      544       end.
      545       if v-curr-sv-date <> ?
      546       then do:
      547         run gbl/d-inpday.w
      548           (input ?
      549           ,input "Выбор даты"
      550           ,input v-description
      551           ,input ""
      552           ,input-output v-curr-sv-date
      553           ,output v-ok
      554           ).
      555         if v-ok = true
      556         then do:
      557           assign
      558             self :screen-value = string(v-curr-sv-date) .
      559           .
      560         end.
      561       end.
      562     end.
      563     return no-apply .
      564   end.
      565     define MENU m-ed-date5
      566       MENU-ITEM m-ed-date5-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      567       MENU-ITEM m-ed-date5-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      568       MENU-ITEM m-ed-date5-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      569       MENU-ITEM m-ed-date5-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      570       .
      571     if v-date-post :POPUP-MENU in frame Dialog-Frame = ?
      572     then do:
      573       ASSIGN
      574         v-date-post :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date5 :HANDLE
      575         v-date-post :MENU-MOUSE in frame Dialog-Frame = 3
      576       .
      577     end.
      578     define variable v-label-handle5 as handle no-undo .
