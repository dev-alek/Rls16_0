     1050   MAIN-BLOCK:
     1051   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1052      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1053     RUN enable_UI.
     1054     RADIO-ord-type:radio-buttons = "Объект-Поставщик,ОП" .
     1055     find first buf_clients no-lock where
     1056                buf_clients.obj-code = v-cntxt-obj-code and
     1057                buf_clients.obj-type = v-cntxt-obj-type
     1058                no-error .
     1059     if available buf_clients then do:
     1060       v-obj:list-item-pairs  = buf_clients.obj-name  + "," + v-cntxt-obj-type + string(v-cntxt-obj-code) .
     1061     end.
     1062     define buffer buf_abc-analysis-goods for ub.abc-analysis-goods  .
     1063     define buffer buf_abc-analysis-obj   for ub.abc-analysis-obj  .
     1064     find first buf_abc-analysis-goods no-lock where recid (buf_abc-analysis-goods) = integer(entry(1, v-recid )) no-error .
     1065      if error-status :error then do:
     1066         message
     1067           error-status :get-message(1) skip
     1068           return-value skip
     1069           "Не выбран ни один товар"
     1070           view-as alert-box error
     1071         .
     1072      end.
     1073     v-obj = v-cntxt-obj-type + string(v-cntxt-obj-code) .
     1074     for each buf_abc-analysis-obj no-lock where
     1075              buf_abc-analysis-obj.abc-id = buf_abc-analysis-goods.abc-id and
     1076              buf_abc-analysis-obj.db-num = buf_abc-analysis-goods.db-num
     1077              :
     1078             if buf_abc-analysis-obj.obj-code = v-cntxt-obj-code and
     1079                buf_abc-analysis-obj.obj-type = v-cntxt-obj-type then next.
     1080               find first buf_clients no-lock where
     1081                         buf_clients.obj-code = buf_abc-analysis-obj.obj-code and
     1082                         buf_clients.obj-type = buf_abc-analysis-obj.obj-type
     1083                         no-error .
     1084               v-obj:list-item-pairs  = v-obj:list-item-pairs  + "," + buf_clients.obj-name  + "," +  buf_abc-analysis-obj.obj-type + string(buf_abc-analysis-obj.obj-code) .
     1085     end.
     1086     hide v-obj in frame Dialog-Frame .
     1087     WAIT-FOR GO OF FRAME Dialog-Frame.
     1088   END.
     1089   RUN disable_UI.
     1090   PROCEDURE disable_UI :
     1091     HIDE FRAME Dialog-Frame.
     1092   END PROCEDURE.
     1093   PROCEDURE enable_UI :
     1094     DISPLAY RADIO-ord-type v-obj loc_cli-code v-date-post v-date-1 v-date-2
     1095             loc_cli-type loc_cli-name
     1096         WITH FRAME Dialog-Frame.
     1097     ENABLE b-exit b-quit B-help RADIO-ord-type v-obj loc_cli-code r-cli
     1098            v-date-post v-date-1 v-date-2 loc_cli-type loc_cli-name
     1099         WITH FRAME Dialog-Frame.
     1100     VIEW FRAME Dialog-Frame.
     1101   END PROCEDURE.
