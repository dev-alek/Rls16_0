     1660         .
     1661       end.
     1662     end.
     1663     return no-apply .
     1664   end.
     1665   on ctrl-f of scr-ship-date in frame Dialog-Frame
     1666   do:
     1667     if (can-query (self, "sensitive")
     1668        and
     1669        self :sensitive = true
     1670        )
     1671     or (can-query (self, "read-only")
     1672        and
     1673        self :read-only = false
     1674        )
     1675     then do:
     1676       if self :handle <> focus :handle
     1677       then do:
     1678         apply "entry":u to self .
     1679       end.
     1680       define variable v-ok            as logical   no-undo .
     1681       define variable v-curr-sv-date  as date      no-undo .
     1682       define variable v-description   as character no-undo .
     1683       assign
     1684         v-curr-sv-date = date(self :screen-value) no-error
     1685       .
     1686       if v-curr-sv-date = ?
     1687       then do:
     1688         run gbl/getcurdt.p
     1689           (output v-curr-sv-date
     1690           ) .
     1691       end.
     1692       if v-curr-sv-date <> ?
     1693       then do:
     1694         run gbl/d-inpday.w
     1695           (input ?
     1696           ,input "Выбор даты"
     1697           ,input v-description
     1698           ,input ""
     1699           ,input-output v-curr-sv-date
     1700           ,output v-ok
     1701           ).
     1702         if v-ok = true
     1703         then do:
     1704           assign
     1705             self :screen-value = string(v-curr-sv-date) .
     1706           .
     1707         end.
     1708       end.
     1709     end.
     1710     return no-apply .
     1711   end.
