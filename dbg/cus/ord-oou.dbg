      416   def
      417   new shared
      418   temp-table  obj-list no-undo
      419     field obj-type like ub.clients.obj-type
      420     field obj-code like ub.clients.obj-code
      421     field obj-name like ub.clients.obj-name
      422     field obj-id   as integer
      423     field db-num   as integer
      424     index pi is primary unique obj-id
      425     index ie1 obj-type obj-code
      426     index ie2 obj-name
      427   .
      428   procedure create_obj-list :
      429      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      430      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      431      do
      432      on error undo, return error return-value
      433      :
      434         define buffer cli-obj for ub.clients .
      435         define variable p-var as integer no-undo .
      436         define buffer buf_obj-list for obj-list .
      437         find last buf_obj-list  use-index pi no-error .
      438         if available buf_obj-list
      439         then
      440            p-var = buf_obj-list.obj-id + 1.
      441         else
      442            p-var = 1.
      443         find first cli-obj where
      444                   cli-obj.obj-type = p-obj-type
      445               and cli-obj.obj-code = p-obj-code
      446         no-lock no-error.
      447         if available cli-obj
      448         then do:
      449            create buf_obj-list.
      450            assign
      451               buf_obj-list.obj-id   = p-var
      452               buf_obj-list.obj-code = cli-obj.obj-code
      453               buf_obj-list.obj-type = cli-obj.obj-type
      454               buf_obj-list.obj-name = cli-obj.obj-name
      455               buf_obj-list.db-num   = cli-obj.db-num
      456            .
      457         end.
      458      end.
      459   end.
      460   define new shared temp-table X-init_obj-list no-undo
      461   field obj-type like ub.clients.obj-type
      462   field obj-code like ub.clients.obj-code
      463   index pi is unique primary obj-type obj-code.
      464   define variable p1 like ub.gds-obj.prod-type no-undo.
      465   define variable p2 like ub.gds-obj.prod-code no-undo.
      466   define variable p3 like ub.gds-obj.artic     no-undo.
