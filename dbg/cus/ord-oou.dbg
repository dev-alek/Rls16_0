     3905   MAIN-BLOCK:
     3906   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3907      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3908     if p-mode <> 'ПРОСМОТР':U then do:
     3909       if p-mode  = 'ДОБАВЛЕНИЕ':U then do:
     3910         define variable v-i-doc as character no-undo .
     3911   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3912   run proc-ord-code in this-procedure
     3913    (input   'main' ,
     3914     input   v-cntxt-db-num ,
     3915     input   v-cntxt-obj-type ,
     3916     input   v-cntxt-obj-code ,
     3917     input   v-i-doc ,
     3918     output  loc-ord-num
     3919    ) .
     3920   define variable loc-order-type as integer no-undo .
     3921   if v-cntxt-db-num  = 0 then loc-order-type = 2 .
     3922                          else loc-order-type = 3 .
     3923         run create-ord-doc(
     3924             input loc-ord-num  ,
     3925             input ?            ,
     3926             input ""           ,
     3927             input ""           ,
     3928             input ""           ,
     3929             input v-cntxt-host-code-obj  ,
     3930             input v-cntxt-obj-code   ,
     3931             input v-cntxt-obj-type   ,
     3932             input 'ОО':U       ,
     3933             input 'новый':U   ,
     3934             input today        ,
     3935             input today        ,
     3936             input loc-order-type ,
     3937             output p-ord-doc-recid )
     3938             .
     3939       end.
     3940     do transaction on error undo, return error return-value :
     3941       find first buf_ord-doc  exclusive-lock  where
     3942            recid(buf_ord-doc) = p-ord-doc-recid no-error .
     3943            if error-status :error then do:
     3944            message vss-workfile vss-revision vss-description skip
     3945                   "Ошибка  " skip
     3946                    skip
     3947                    error-status :get-message(1) skip
     3948                    return-value skip
     3949                    view-as alert-box error
     3950            .
     3951            return error.
     3952            end.
     3953     end.
     3954    loc-ord-num = buf_ord-doc.doc-code .
     3955   X_ord-line.qnty:read-only in browse BROWSE-2 = true .
     3956   scr-e-method:read-only in frame Dialog-Frame  = true .
     3957       run recalc-head in this-procedure .
     3958       run my-enable_ui in this-procedure .
     3959        if p-mode  = 'ДОБАВЛЕНИЕ':U then WAIT-FOR GO  OF FRAME Dialog-Frame focus  scr-ship-date.
     3960        else WAIT-FOR GO  OF FRAME Dialog-Frame focus BROWSE-2.
     3961     end.
     3962     else do:
     3963         find first buf_ord-doc  no-lock where
     3964              recid(buf_ord-doc) = p-ord-doc-recid no-error .
     3965            if error-status :error then do:
     3966            message vss-workfile vss-revision vss-description skip
     3967                   "Ошибка просмотра " skip
     3968                    skip
     3969                    error-status :get-message(1) skip
     3970                    return-value skip
     3971                    view-as alert-box error
     3972            .
     3973            return error.
     3974            end.
     3975         loc-ord-num = buf_ord-doc.doc-code .
     3976         run recalc-head in this-procedure .
     3977         run my-enable-lkp in this-procedure .
     3978         WAIT-FOR GO  OF FRAME Dialog-Frame focus b-exit.
     3979     end.
     3980   END.
     3981   RUN disable_UI.
     3982   PROCEDURE create-ord-doc :
     3983    do
     3984    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3985    :
     3986   define input parameter p-doc-code   like  ub.ord-doc.doc-code  no-undo .
     3987   define input parameter p-cli-code   like  ub.ord-doc.cli-code  no-undo .
     3988   define input parameter p-cli-type   like  ub.ord-doc.cli-type  no-undo .
     3989   define input parameter p-cli-name   like  ub.ord-doc.cli-name  no-undo .
     3990   define input parameter p-cons-code  like  ub.ord-doc.cons-code no-undo .
     3991   define input parameter p-host-code  like  ub.ord-doc.host-code no-undo .
     3992   define input parameter p-obj-code   like  ub.ord-doc.obj-code  no-undo .
     3993   define input parameter p-obj-type   like  ub.ord-doc.obj-type  no-undo .
     3994   define input parameter p-doc-type   like  ub.ord-doc.doc-type  no-undo .
     3995   define input parameter p-status_    like  ub.ord-doc.status_   no-undo .
     3996   define input parameter p-doc-date   like  ub.ord-doc.doc-date  no-undo .
     3997   define input parameter p-ship-date  like  ub.ord-doc.ship-date no-undo .
     3998   define input parameter p-order-type like  ub.ord-doc.order-type    no-undo .
     3999   define output parameter p-recid as recid no-undo .
     4000   define variable v-i-doc as character no-undo .
     4001   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4002   run proc-ord-code in this-procedure
     4003    (input   'main' ,
     4004     input   v-cntxt-db-num ,
     4005     input   p-obj-type ,
     4006     input   p-obj-code ,
     4007     input   v-i-doc ,
     4008     output  loc-ord-num
     4009    ) .
     4010      create ub.ord-doc.
     4011      assign
     4012         ub.ord-doc.doc-code   = p-doc-code
     4013         ub.ord-doc.cli-code   = p-cli-code
     4014         ub.ord-doc.cli-type   = p-cli-type
     4015         ub.ord-doc.cli-name   = p-cli-name
     4016         ub.ord-doc.cons-code  = p-cons-code
     4017         ub.ord-doc.host-code  = p-host-code
     4018         ub.ord-doc.obj-code   = p-obj-code
     4019         ub.ord-doc.obj-type   = p-obj-type
     4020         ub.ord-doc.doc-type   = p-doc-type
     4021         ub.ord-doc.status_    = p-status_
     4022         ub.ord-doc.doc-date   = p-doc-date
     4023         ub.ord-doc.ship-date  = p-ship-date
     4024         ub.ord-doc.order-type = p-order-type
     4025         p-recid = recid (ord-doc)
     4026         .
     4027     end.
     4028   END PROCEDURE.
     4029   PROCEDURE create-tmp :
     4030    do
     4031    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4032    :
     4033   def input parameter tt as char no-undo.
     4034   def input parameter t as char no-undo.
     4035   define output parameter p-tmp as recid no-undo .
     4036   define output parameter p-ord as recid no-undo .
     4037   define variable prod-type#   like ub.ord-line.prod-type         no-undo .
     4038   define variable prod-code#   like ub.ord-line.prod-code         no-undo .
     4039   define variable artic#       like ub.ord-line.artic             no-undo .
     4040   define buffer ll-buf_ord-line for ub.ord-line .
     4041   define variable p-recid as recid no-undo .
     4042         find first ub.goods where
     4043               ub.goods.artic     = tt-gds-list.artic     and
     4044               ub.goods.prod-type = tt-gds-list.prod-type and
     4045               ub.goods.prod-code = tt-gds-list.prod-code no-lock no-error.
     4046               if error-status :error  then do:
     4047                   message vss-workfile vss-revision vss-description skip
     4048                   error-status :get-message(1)
     4049                   "Плохо ! tt-gds-list не = ub.goods !"
     4050                   1
     4051                   view-as alert-box error .
     4052               end.
     4053         find  first ub.gds-obj  where
     4054               ub.gds-obj.obj-type  = v-cntxt-obj-type and
     4055               ub.gds-obj.obj-code  = v-cntxt-obj-code and
     4056               ub.gds-obj.artic     = tt-gds-list.artic      and
     4057               ub.gds-obj.prod-type = tt-gds-list.prod-type  and
     4058               ub.gds-obj.prod-code = tt-gds-list.prod-code  no-lock no-error.
     4059   define buffer bufff-units for ub.units.
     4060   define variable t-type as character no-undo .
     4061   find first tmp#zakaz   where
     4062       tmp#zakaz.prod-type       = ub.goods.prod-type and
     4063       tmp#zakaz.prod-code       = ub.goods.prod-code and
     4064       tmp#zakaz.artic           = ub.goods.artic     no-error.
     4065    if not available tmp#zakaz  then  create tmp#zakaz .
     4066     assign
     4067       tmp#zakaz.doc-code        = loc-ord-num
     4068       tmp#zakaz.gds-code        = ub.goods.gds-code
     4069       tmp#zakaz.prod-type       = ub.goods.prod-type
     4070       tmp#zakaz.prod-code       = ub.goods.prod-code
     4071       tmp#zakaz.artic           = ub.goods.artic
     4072       tmp#zakaz.gds-name        = ub.goods.gds-name
     4073       tmp#zakaz.deadline        = ub.goods.deadline
     4074       tmp#zakaz.unit-cli        = ub.goods.unit-cli
     4075       tmp#zakaz.unit-base       = ub.goods.unit-base
     4076       tmp#zakaz.negative-rest   = ub.goods.negative-rest
     4077       tmp#zakaz.cli-base-rate   = 1
     4078       tmp#zakaz.ms-cart         = ub.goods.qnty-cart
     4079       .
     4080       define variable max-num as integer no-undo .
     4081       max-num = 0.
     4082       for each  ll-buf_ord-line no-lock  where ll-buf_ord-line.doc-code = loc-ord-num :
     4083           if max-num < ll-buf_ord-line.line-num then
     4084              max-num = ll-buf_ord-line.line-num .
     4085       end.
     4086       tmp#zakaz.line-num = max-num + 1.
     4087   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4088   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4089     (input  ub.goods.gds-code
     4090     ,input  '1':U
     4091     ,input  ?
     4092     ,input  v-cntxt-host-code-obj
     4093     ,input  v-cntxt-obj-type
     4094     ,input  v-cntxt-obj-code
     4095     ,output tmp#zakaz.vat-pc
     4096     ) no-error .
     4097     .
     4098     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-base no-lock no-error.
     4099     if available bufff-units then
     4100     assign
     4101       tmp#zakaz.unit-type       = bufff-units.type .
     4102     find bufff-units where bufff-units.unit-name = tmp#zakaz.unit-cli no-lock no-error.
     4103     if available bufff-units then
     4104     assign
     4105       tmp#zakaz.unit-cli-type       = bufff-units.type .
     4106   find first ub.gds-obj no-lock    where
     4107       ub.gds-obj.obj-type        = v-cntxt-obj-type and
     4108       ub.gds-obj.obj-code        = v-cntxt-obj-code and
     4109       ub.gds-obj.prod-type       = ub.goods.prod-type and
     4110       ub.gds-obj.prod-code       = ub.goods.prod-code and
     4111       ub.gds-obj.artic           = ub.goods.artic     no-error.
     4112       if available ub.gds-obj then do:
     4113           define variable v-baz-val as integer no-undo .
     4114           define variable v-base-rate  as decimal no-undo .
     4115           define variable v-base-scale  as decimal no-undo .
     4116           define variable p-r-b-abbr as character no-undo .
     4117   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4118   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4119     (input  v-cntxt-host-code-obj
     4120     ,output v-baz-val
     4121     )  .
     4122   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4123   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4124     (output p-r-b-abbr
     4125     )  .
     4126           if p-r-b-abbr = 'rubl':U then do:
     4127                 if v-baz-val = 0 then
     4128                     assign
     4129                       tmp#zakaz.price-base = ub.gds-obj.price-sale
     4130                       tmp#zakaz.price-rubl = ub.gds-obj.price-sale
     4131                       tmp#zakaz.price-cli  = ub.gds-obj.price-sale
     4132                     .
     4133                   else do:
     4134   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     4136     (input  v-cntxt-host-code-obj
     4137     ,input  today
     4138     ,output v-base-rate
     4139     ,output v-base-scale
     4140     )  .
     4141                     assign
     4142                       tmp#zakaz.price-rubl = ub.gds-obj.price-sale
     4143                       tmp#zakaz.price-base = tmp#zakaz.price-rubl /( v-base-rate * v-base-scale )
     4144                       tmp#zakaz.price-cli  = tmp#zakaz.price-rubl
     4145                     .
     4146                   end.
     4147             end.
     4148             else do:
     4149   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4150   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     4151     (input  v-cntxt-host-code-obj
     4152     ,input  today
     4153     ,output v-base-rate
     4154     ,output v-base-scale
     4155     )  .
     4156                     assign
     4157                       tmp#zakaz.price-base = ub.gds-obj.price-sale
     4158                       tmp#zakaz.price-rubl = tmp#zakaz.price-base * ( v-base-rate / v-base-scale )
     4159                       tmp#zakaz.price-cli  = tmp#zakaz.price-base
     4160                     .
     4161             end.
     4162      end.
     4163      else do:
     4164      assign
     4165        tmp#zakaz.price-base = 0
     4166        tmp#zakaz.price-rubl = 0
     4167        tmp#zakaz.price-cli  = 0
     4168      .
     4169      end.
     4170   find first shar_ord-line   exclusive-lock   where
     4171       shar_ord-line.doc-code        = loc-ord-num    and
     4172       shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     4173       shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     4174       shar_ord-line.artic           = tmp#zakaz.artic     no-error.
     4175    if not available shar_ord-line  then
     4176          create shar_ord-line  .
     4177    buffer-copy tmp#zakaz to shar_ord-line
     4178       assign shar_ord-line.doc-code    = loc-ord-num
     4179     .
     4180     p-tmp = recid ( tmp#zakaz   ) .
     4181     p-ord = recid ( shar_ord-line  ) .
     4182     end.
     4183   END PROCEDURE.
     4184   PROCEDURE disable_UI :
     4185     HIDE FRAME Dialog-Frame.
     4186   END PROCEDURE.
     4187   PROCEDURE enable_UI :
     4188     DISPLAY scr-ship-date scr-date-sale-1 scr-date-sale-2 scr-wrkr scr-order-type
     4189             scr-agnt scr-boss scr-e-method t-auto scr-obj-name scr-wrkr-name
     4190             scr-agnt-name scr-boss-name scr-sum-qnty scr-sum-rubl scr-sum-base
     4191         WITH FRAME Dialog-Frame.
     4192     ENABLE b-exit b-quit B-delivery B-notes B-help scr-ship-date scr-date-sale-1
     4193            scr-date-sale-2 scr-wrkr r-wrkr scr-order-type scr-agnt r-agnt
     4194            scr-boss r-boss scr-e-method B-ins B-chg B-del B-calc b-renum t-auto
     4195            BROWSE-2 scr-obj-name scr-wrkr-name scr-agnt-name scr-boss-name
     4196            scr-sum-qnty scr-sum-rubl scr-sum-base
     4197         WITH FRAME Dialog-Frame.
     4198     VIEW FRAME Dialog-Frame.
     4199     OPEN QUERY BROWSE-2 FOR EACH X_ord-line       WHERE X_ord-line.doc-code = loc-ord-num NO-LOCK,              EACH X_goods WHERE X_goods.artic = X_ord-line.artic   AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type NO-LOCK.
     4200   END PROCEDURE.
     4201   PROCEDURE init-gds-rec :
     4202    do
     4203    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4204    :
     4205     find current x_goods no-lock no-error .
     4206     gds-rec = recid(x_goods) .
     4207     end.
     4208   END PROCEDURE.
     4209   PROCEDURE init-proc :
     4210    do
     4211    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4212    :
     4213    find first buf_clients no-lock where
     4214               buf_clients.obj-code = buf_ord-doc.obj-code and
     4215               buf_clients.obj-type = buf_ord-doc.obj-type
     4216               no-error .
     4217               if error-status :error then do:
     4218               message vss-workfile vss-revision vss-description skip
     4219                      "Ошибка  " skip
     4220                       skip
     4221                       error-status :get-message(1) skip
     4222                       return-value skip
     4223                       view-as alert-box error
     4224               .
     4225               return error .
     4226               end.
     4227    assign
     4228     scr-ship-date    = buf_ord-doc.ship-date
     4229     loc-date-ship    = scr-ship-date
     4230     scr-date-sale-1  = buf_ord-doc.date-sale-1
     4231     scr-date-sale-2  = buf_ord-doc.date-sale-2
     4232     scr-e-method     = buf_ord-doc.e-method
     4233     e-method         = buf_ord-doc.e-method
     4234     loc-obj-code     = buf_ord-doc.obj-code
     4235     loc-obj-type     = buf_ord-doc.obj-type
     4236     loc-doc-type     = buf_ord-doc.doc-type
     4237     scr-obj-name     = buf_clients.obj-name
     4238     loc-ord-num      = buf_ord-doc.doc-code
     4239     scr-wrkr         = buf_ord-doc.wrkr
     4240     scr-boss         = buf_ord-doc.boss
     4241     scr-agnt         = buf_ord-doc.agnt
     4242     scr-order-type   =  buf_ord-doc.order-type
     4243     v-deliv-type-code     =  buf_ord-doc.deliv-type-code
     4244     v-point-obj-code      =  buf_ord-doc.obj-point-code
     4245     v-point-cli-code      =  buf_ord-doc.cli-point-code
     4246     v-point-obj-db-num    =  buf_ord-doc.obj-point-db-num
     4247     v-point-cli-db-num    =  buf_ord-doc.cli-point-db-num
     4248     v-transport-host-code      =  buf_ord-doc.transport-host-code
     4249     v-transport-cli-type      =  buf_ord-doc.transport-cli-type
     4250     v-transport-cli-code      =  buf_ord-doc.transport-cli-code
     4251     v-transport-contract  =  buf_ord-doc.transport-contract
     4252     v-transport-condition =  buf_ord-doc.transport-condition
     4253     v-transport-value     =  buf_ord-doc.transport-value
     4254     v-transport-sum       =  buf_ord-doc.sum-ship
     4255     v-transport-vat       =  buf_ord-doc.transport-vat
     4256    .
     4257    run leave-proc-wrkr .
     4258    run leave-proc-boss .
     4259    run leave-proc-agnt .
     4260        ASSIGN frame Dialog-Frame:TITLE = "Заказ  № " + loc-ord-num
     4261      + " Тип: " +     buf_ord-doc.doc-type
     4262      + " Статус: "  +  buf_ord-doc.status_
     4263      + " - " + caps(p-mode).
     4264   assign
     4265   scr-agnt:label in frame Dialog-Frame     =  "И&сп"
     4266   scr-agnt:tooltip in frame Dialog-Frame   =  "Код исполнителя"
     4267   scr-wrkr:label in frame Dialog-Frame    = "К&л-к"
     4268   scr-wrkr:tooltip in frame Dialog-Frame  = "Код кладовщика"
     4269   scr-boss:label in frame Dialog-Frame    = "&М-р"
     4270   scr-boss:tooltip in frame Dialog-Frame  = "Код менеджера"
     4271   .
     4272     end.
     4273   END PROCEDURE.
     4274   PROCEDURE my-enable-lkp :
     4275    do
     4276    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4277    :
     4278     run init-proc.
     4279     X_ord-line.qnty:read-only in browse BROWSE-2  = true .
     4280     DISPLAY scr-ship-date scr-obj-name
     4281                     scr-e-method scr-date-sale-1 scr-date-sale-2 scr-sum-base scr-sum-qnty scr-sum-rubl
     4282                       scr-order-type
     4283         WITH FRAME Dialog-Frame.
     4284     ENABLE b-exit b-next b-prev B-help BROWSE-2 scr-e-method  b-notes
     4285          WITH FRAME Dialog-Frame.
     4286       VIEW FRAME Dialog-Frame.
     4287         hide b-delivery b-quit in FRAME Dialog-Frame.
     4288         b-exit:label = "&Выход" .
     4289     Run OpenBr.
     4290     end.
     4291   END PROCEDURE.
     4292   PROCEDURE my-enable_UI :
     4293    do
     4294    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4295    :
     4296     run init-proc.
     4297     DISPLAY scr-ship-date scr-obj-name
     4298             scr-e-method scr-date-sale-1 scr-date-sale-2 scr-sum-base
     4299             scr-sum-qnty scr-sum-rubl
     4300             scr-wrkr-name
     4301             scr-agnt-name
     4302             scr-boss-name
     4303             scr-order-type
     4304             t-auto
     4305                 WITH FRAME Dialog-Frame.
     4306     ENABLE b-exit b-quit B-help scr-ship-date B-ins B-chg B-del b-notes
     4307            B-calc BROWSE-2 b-renum t-auto
     4308            scr-e-method scr-date-sale-1 scr-date-sale-2
     4309            scr-wrkr r-wrkr
     4310            scr-agnt r-agnt
     4311            scr-boss r-boss
     4312            scr-order-type
     4313            WITH FRAME Dialog-Frame.
     4314     VIEW FRAME Dialog-Frame.
     4315     hide b-delivery in FRAME Dialog-Frame.
     4316     Run OpenBr.
     4317     end.
     4318   END PROCEDURE.
     4319   PROCEDURE next-focus :
     4320   do
     4321   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4322   :
     4323   define input parameter p-widget-handle as handle no-undo .
     4324   define variable l-apply-entry as logical no-undo .
     4325   assign
     4326     l-apply-entry =   true
     4327   .
     4328   do with frame Dialog-Frame :
     4329     if  scr-ship-date   :handle = p-widget-handle then do:  if  scr-date-sale-1 :sensitive then do: apply "entry":u to scr-date-sale-1. return . end. end.
     4330     if  scr-date-sale-1 :handle = p-widget-handle then do:  if  scr-date-sale-2 :sensitive then do: apply "entry":u to scr-date-sale-2. return . end. end.
     4331     if  scr-date-sale-2 :handle = p-widget-handle then do:  if  scr-wrkr        :sensitive then do: apply "entry":u to scr-wrkr       . return . end. end.
     4332     if  scr-wrkr        :handle = p-widget-handle then do:  if  scr-agnt        :sensitive then do: apply "entry":u to scr-agnt       . return . end. end.
     4333     if  scr-agnt        :handle = p-widget-handle then do:  if  scr-boss        :sensitive then do: apply "entry":u to scr-boss       . return . end. end.
     4334     if  scr-boss        :handle = p-widget-handle then do:  if  b-ins           :sensitive then do: apply "entry":u to b-ins          . return . end. end.
     4335     if  b-ins           :handle = p-widget-handle then do:  if  B-exit          :sensitive then do: apply "entry":u to B-exit    .      return . end. end.
     4336     end.
     4337     end.
     4338   END PROCEDURE.
     4339   PROCEDURE openbr :
     4340    do
     4341    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4342    :
     4343   case sort-column-name :
     4344     when "X_ord-line.line-num" then do:
     4345           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.line-num .
     4346     end.
     4347     when "X_goods.gds-code" then do:
     4348           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_goods.gds-code .
     4349     end.
     4350     when "X_ord-line.artic" then do:
     4351           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.artic .
     4352     end.
     4353     when "X_goods.gds-name" then do:
     4354           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_goods.gds-name .
     4355     end.
     4356     when "X_ord-line.qnty" then do:
     4357           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.qnty .
     4358     end.
     4359     when "X_ord-line.price-rubl" then do:
     4360           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.price-rubl .
     4361     end.
     4362     when "X_ord-line.price-base" then do:
     4363           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.price-base .
     4364     end.
     4365     when "X_ord-line.sum-base" then do:
     4366           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.sum-base .
     4367     end.
     4368     when "X_ord-line.sum-rubl" then do:
     4369           OPEN QUERY browse-2 FOR EACH X_ord-line no-lock  WHERE X_ord-line.doc-code = loc-ord-num , EACH X_goods no-lock WHERE X_goods.artic = X_ord-line.artic  AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type by X_ord-line.sum-rubl .
     4370     end.
     4371   otherwise do:
     4372     OPEN QUERY BROWSE-2 FOR EACH X_ord-line       WHERE X_ord-line.doc-code = loc-ord-num NO-LOCK,              EACH X_goods WHERE X_goods.artic = X_ord-line.artic   AND X_goods.prod-code = X_ord-line.prod-code   AND X_goods.prod-type = X_ord-line.prod-type NO-LOCK.
     4373   end.
     4374   end case.
     4375     end.
     4376   END PROCEDURE.
     4377   PROCEDURE p-delete :
     4378    do
     4379    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4380    :
     4381   define input parameter tmp-recid as recid no-undo .
     4382   define input-output parameter ii as integer no-undo . .
     4383       find first tmp#zakaz where recid(tmp#zakaz) = tmp-recid no-error .
     4384       if not avail tmp#zakaz then return error.
     4385       find first shar_ord-line  exclusive-lock    where
     4386           shar_ord-line.doc-code        = loc-ord-num    and
     4387           shar_ord-line.prod-type       = tmp#zakaz.prod-type and
     4388           shar_ord-line.prod-code       = tmp#zakaz.prod-code and
     4389           shar_ord-line.artic           = tmp#zakaz.artic     no-error.
     4390       if not available shar_ord-line  then  return error .
     4391       delete shar_ord-line .
     4392       delete tmp#zakaz .
     4393       ii = ii - 1 .
     4394     end.
     4395   END PROCEDURE.
     4396   PROCEDURE proc-add :
     4397    do
     4398    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4399    :
     4400   define variable ii as int init 0 no-undo.
     4401   define variable r-tmp as recid no-undo .
     4402   define variable r-ord as recid no-undo .
     4403   define variable r-stop as logical no-undo .
     4404   define variable r-exit as logical no-undo .
     4405   define variable l-g#type as character no-undo .
     4406   define variable l-g#status as character no-undo .
     4407   define variable t-ret as logical no-undo .
     4408   define variable varschartic like ub.price-list.artic initial " " no-undo.
     4409   define variable v-ref-list  as character  no-undo.
     4410        run str/chsgdsls.w (
     4411           parParentProc ,
     4412           input "order" + 'ОО':U  ,
     4413           input "Строка документа № " + loc-ord-num , ? , ? ,
     4414           input v-cntxt-host-code-obj,
     4415           input-output varschartic,
     4416           output v-ref-list,
     4417           output table tt-gds-list,
     4418           false
     4419           ) no-error.
     4420       if error-status :error then do:
     4421       message vss-workfile vss-revision vss-description skip
     4422              "Ошибка procedure chsgdsls.w " skip
     4423               skip
     4424               error-status :get-message(1) skip
     4425               return-value skip
     4426               view-as alert-box error
     4427       .
     4428       return error  .
     4429       end.
     4430      t-ret =  session:set-wait-state("general") .
     4431      line-mode = 'ДОБАВЛЕНИЕ':U .
     4432      for each tt-gds-list no-lock :
     4433        ii = ii + 1 .
     4434        if ii > 1 then assign line-mode = "ЦИКЛ":u.
     4435        run create-tmp in this-procedure  (input "tt-gds-list":u, "" , output r-tmp , output r-ord).
     4436        if not t-auto then do:
     4437                   run cus/ord-frmo.w ( parParentProc ,input r-tmp  , input r-ord  , input line-mode,  output r-stop , output r-exit ) .
     4438                      if r-stop then do:
     4439                         run p-delete ( r-tmp , input-output ii).
     4440                         leave.
     4441                         end.
     4442                      if r-exit then do:
     4443                          run p-delete( r-tmp , input-output ii ) .
     4444                          end.
     4445        end.
     4446      end.
     4447       Run OpenBr.
     4448       t-ret =  session:set-wait-state("") .
     4449       message "Добавлено " + string(ii) + " товаров".
     4450     end.
     4451   END PROCEDURE.
     4452   PROCEDURE proc-renum :
     4453    do
     4454    on error undo, return error return-value
     4455    :
     4456   define variable g-ok as logical no-undo .
     4457   define variable g as integer no-undo .
     4458   define buffer buf_ord-line for ub.ord-line.
     4459    message " Перенумеровать список товаров ? "
     4460       view-as alert-box question
     4461       buttons yes-no
     4462       UPDATE g-ok
     4463       .
     4464       if g-ok = false then return.
     4465       g = 0 .
     4466       for each buf_ord-line  exclusive-lock  where buf_ord-line.doc-code = loc-ord-num  by buf_ord-line.line-num :
     4467           g = g + 1.
     4468           buf_ord-line.line-num = g.
     4469       end.
     4470       run openbr.
     4471    end.
     4472   END PROCEDURE.
     4473   PROCEDURE recalc-head :
     4474    do
     4475    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4476    :
     4477   define buffer buf_ord-line for ub.ord-line.
     4478   define variable s-1 as decimal init 0 no-undo .
     4479   define variable s-2 as decimal init 0 no-undo .
     4480   define variable s-0 as decimal init 0 no-undo .
     4481        assign frame Dialog-Frame
     4482        scr-ship-date
     4483        scr-e-method
     4484        scr-date-sale-1
     4485        scr-date-sale-2
     4486   .
     4487   for each  buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num  :
     4488       s-1  = s-1  + buf_ord-line.sum-rubl .
     4489       s-2  = s-2  + buf_ord-line.sum-base .
     4490       s-0  = s-0  + buf_ord-line.qnty     .
     4491   end.
     4492   assign
     4493     scr-sum-qnty = s-0
     4494     scr-sum-rubl = s-1
     4495     scr-sum-base = s-2
     4496   .
     4497   display
     4498    scr-sum-qnty
     4499    scr-sum-rubl
     4500    scr-sum-base
     4501    with frame Dialog-Frame .
     4502     end.
     4503   END PROCEDURE.
     4504   PROCEDURE step-next :
     4505    do
     4506    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4507    :
     4508     if valid-handle (br-handle) then do:
     4509     v-log = br-handle:select-next-row () no-error .
     4510     if error-status :error then do:
     4511        message "Это режим просмотра одного документа." .
     4512        v-log = false .
     4513        end.
     4514     if not v-log then message "Это последний документ списка.".
     4515   end.
     4516       p-ord-doc-recid = recid ( buf-oo_ord-doc ).
     4517       next-prev = yes.
     4518     end.
     4519   END PROCEDURE.
     4520   PROCEDURE step-prev :
     4521    do
     4522    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4523    :
     4524     if valid-handle (br-handle) then do:
     4525     v-log = br-handle:select-prev-row() no-error .
     4526     if error-status :error then do:
     4527        message "Это режим просмотра одного документа." .
     4528        v-log = false .
     4529     end.
     4530     if not v-log then do: message "Это первый документ списка.".   end.
     4531   end.
     4532   p-ord-doc-recid = recid (buf-oo_ord-doc).
     4533   next-prev = yes .
     4534     end.
     4535   END PROCEDURE.
     4536   PROCEDURE x-delete :
     4537   define input parameter p-recid as recid no-undo .
     4538   define input-output parameter ii as integer no-undo . .
     4539    do
     4540    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4541    :
     4542       find first shar_ord-line  exclusive-lock  where recid(shar_ord-line) = p-recid  .
     4543       if not available shar_ord-line  then  return error .
     4544       find first tmp#zakaz   where
     4545                   tmp#zakaz.prod-type = shar_ord-line.prod-type         and
     4546                   tmp#zakaz.prod-code = shar_ord-line.prod-code         and
     4547                   tmp#zakaz.artic     = shar_ord-line.artic             no-error.
     4548       if  avail tmp#zakaz then delete tmp#zakaz .
     4549       delete shar_ord-line .
     4550       ii = ii - 1 .
     4551     end.
     4552   END PROCEDURE.
     4553   FUNCTION f-zapr-qnty RETURNS decimal
     4554     ( buffer buf_ord-line for ub.ord-line , par-type as char ) :
     4555   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv .
     4556   define buffer buf_ord-line-rcv for ub.ord-line-rcv .
     4557   define buffer buf_doc-line          for ub.doc-line .
     4558   define buffer buf_trn-doc           for ub.trn-doc  .
     4559   define variable  res as decimal no-undo init 0 .
     4560   for each buf_ord-line-rcv no-lock
     4561       where buf_ord-line-rcv.doc-code  = buf_ord-line.doc-code  and
     4562             buf_ord-line-rcv.artic     = buf_ord-line.artic     and
     4563             buf_ord-line-rcv.prod-type = buf_ord-line.prod-type and
     4564             buf_ord-line-rcv.prod-code = buf_ord-line.prod-code
     4565             on error undo, return error :
     4566             find first buf_ord-doc-rcv no-lock where
     4567                       buf_ord-doc-rcv.rcv-code  = buf_ord-line-rcv.rcv-code  and
     4568                       buf_ord-doc-rcv.doc-code  = buf_ord-line-rcv.doc-code  no-error .
     4569                       if error-status :error then next .
     4570      for each ub.ord-chain no-lock where
     4571               ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     4572               ub.ord-chain.doc-type = 'rcv'                  and
     4573               ub.ord-chain.rel-doc-type = 'trn'
     4574               :
     4575             find first buf_trn-doc no-lock  where
     4576                        buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code  and
     4577                        buf_trn-doc.doc-type = par-type
     4578                                 no-error .
     4579             if not available buf_trn-doc then next .
     4580             if buf_trn-doc.doc-type = 'при':U then
     4581                if buf_trn-doc.status_ <>  'запрос':U then next.
     4582             find first buf_doc-line no-lock where
     4583                        buf_doc-line.doc-code  = buf_trn-doc.doc-code  and
     4584                        buf_doc-line.artic     = buf_ord-line.artic     and
     4585                        buf_doc-line.prod-type = buf_ord-line.prod-type and
     4586                        buf_doc-line.prod-code = buf_ord-line.prod-code  no-error .
     4587                        if error-status :error then next .
     4588             res  = res  + buf_doc-line.fact-qnty .
     4589   end.
     4590   end.
     4591   RETURN res .
     4592   END FUNCTION.
     4593   procedure proc-d-notes :
     4594    do
     4595    on error undo, return error return-value
     4596    :
     4597   define variable  doc-rec     as  recid no-undo .
     4598   define buffer    buf_ord-doc for ub.ord-doc    .
     4599   define variable  notes       as  character no-undo .
     4600   find first buf_ord-doc where
     4601              buf_ord-doc.doc-code  = loc-ord-num
     4602             no-lock no-error .
     4603   doc-rec = recid (buf_ord-doc)  .
     4604   notes = buf_ord-doc.ps .
     4605    run gbl/d-prompt.w (
     4606           'title=примечание\'
     4607         + 'type=editor\'
     4608         + 'fillin_width=96\'
     4609         + 'fillin_height=15\'
     4610         +  ( if p-mode = 'ПРОСМОТР':U then 'readonly=yes\':u else '' )
     4611         , input-output notes ).
     4612         if return-value = 'false':U
     4613         then do:
     4614           return .
     4615         end.
     4616       if p-mode <> 'ПРОСМОТР':U  then do:
     4617           if buf_ord-doc.ps <> notes then do:
     4618             do on stop undo, return error:
     4619               find buf_ord-doc where recid ( buf_ord-doc ) = doc-rec exclusive no-error .
     4620               if available buf_ord-doc then do:
     4621                 buf_ord-doc.ps = notes.
     4622               end.
     4623             end.
     4624           end.
     4625       find first buf_ord-doc where recid ( buf_ord-doc ) = doc-rec no-lock no-error.
     4626       end.
     4627    end.
     4628   end procedure.
