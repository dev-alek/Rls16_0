      865   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      866     (output var-report-r-b
      867     )  .
      868   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      869     define variable v-cntxt-db-num        as integer   no-undo .
      870     define variable v-cntxt-userid        as character no-undo .
      871     define variable v-cntxt-level         as character no-undo .
      872     define variable v-cntxt-host-code-obj as integer   no-undo .
      873     define variable v-cntxt-obj-type      as character no-undo .
      874     define variable v-cntxt-obj-code      as integer   no-undo .
      875     define variable v-cntxt-db-num-obj    as integer   no-undo .
      876     define variable v-cntxt-is-admin      as logical   no-undo .
      877   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      878   procedure proc-ord-code :
      879   define input  parameter  p-type as character no-undo .
      880   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      881   define input  parameter  v-cntxt-obj-type as character no-undo .
      882   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      883   define input  parameter  p-i-doc    as character no-undo .
      884   define output parameter  p-ord-doc  as character no-undo .
      885   define variable          v-idop     as character no-undo .
      886     do
      887     on error undo, return error return-value
      888     :
      889   case p-type :
      890       when "main-no-ver" then do:
      891         if  (v-cntxt-db-num <> 0) then
      892           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      893         else
      894           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      895       end.
      896       when "main" then do:
      897             do while true:
      898             if  (v-cntxt-db-num <> 0) then
      899               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      900             else
      901               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      902             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      903             End.
      904       end.
      905       when "chip" then do:
      906         assign
      907           v-idop = p-i-doc .
      908         do while true :
      909           if index (v-idop , ".") = 0 then
      910             v-idop  = replace (v-idop , "-", "-1.").
      911           else
      912             v-idop  =
      913             substring (v-idop , 1, index (v-idop, "-")) +
      914             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      915             substring (v-idop, index (v-idop, ".")).
      916           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      917         end.
      918         assign
      919           p-ord-doc = v-idop.
      920       end.
      921   end case.
      922     end.
      923   end procedure.
      924   define variable v-cntxt-host-name-obj  as character no-undo .
      925   define variable g#db-remote  as logical   no-undo .
      926   define variable line-mode as character no-undo .
      927   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928     run mainmenu_getcntxt in parparentproc
      929       (output v-cntxt-db-num
      930       ,output v-cntxt-userid
      931       ,output v-cntxt-level
      932       ,output v-cntxt-host-code-obj
      933       ,output v-cntxt-obj-type
      934       ,output v-cntxt-obj-code
      935       ,output v-cntxt-db-num-obj
      936       ,output v-cntxt-is-admin
      937       ) .
      938   assign
      939     g#db-remote   = (v-cntxt-db-num <> 0)
      940   .
      941   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      943     (input  v-cntxt-obj-type
      944     ,input  v-cntxt-obj-code
      945     ,output v-cntxt-host-code-obj
      946     ,output v-cntxt-host-name-obj
      947     )  .
      948   define buffer   buf_ord-doc for ub.ord-doc .
      949   define buffer   buf_clients for ub.clients .
      950   define variable loc-obj-code as integer no-undo .
      951   define variable loc-obj-type as character no-undo .
      952   define variable sort-column-name as character no-undo .
      953   define variable v-log      as logical   no-undo .
      954   define variable gds-rec as recid no-undo .
      955   define temp-table tt-gds-list no-undo like ub.goods
      956   field nn as integer
      957   index by-nn nn
      958   index by_gds-code gds-code
      959   .
      960   define variable v-fact-qnty          as decimal   no-undo.
      961   define variable v-deliv-type-code    as integer   no-undo .
      962   define variable v-point-obj-code     as integer   no-undo .
      963   define variable v-point-cli-code     as integer   no-undo .
      964   define variable v-point-obj-db-num   as integer   no-undo .
      965   define variable v-point-cli-db-num   as integer   no-undo .
      966   define variable v-transport-host-code       as integer   no-undo .
      967   define variable v-transport-cli-type       as character no-undo .
      968   define variable v-transport-cli-code   as integer   no-undo .
      969   define variable v-transport-contract   as integer   no-undo .
      970   define variable v-transport-condition  as integer   no-undo .
      971   define variable v-transport-value      as decimal   no-undo .
      972   define variable v-transport-sum        as decimal   no-undo .
      973   define variable v-transport-vat        as decimal   no-undo .
      974   FUNCTION f-zapr-qnty RETURNS decimal
      975     ( buffer buf_ord-line for ub.ord-line , par-type as char )  FORWARD.
      976   DEFINE BUTTON B-calc
      977        LABEL "&Рассчитать"
      978        SIZE 12 BY 1.
      979   DEFINE BUTTON B-chg
      980        LABEL "&Изменить"
      981        SIZE 10 BY 1.
      982   DEFINE BUTTON B-del
      983        LABEL "&Удалить"
      984        SIZE 10 BY 1.
      985   DEFINE BUTTON B-delivery
      986        LABEL "Доставка"
      987        SIZE 10 BY 1 TOOLTIP "Условия доставки".
      988   DEFINE BUTTON b-exit AUTO-GO
      989        LABEL "&Ввод"
      990        SIZE 10 BY 1.
      991   DEFINE BUTTON B-help DEFAULT
      992        LABEL "Помо&щь"
      993        SIZE 10 BY 1
      994        BGCOLOR 8 .
      995   DEFINE BUTTON B-ins
      996        LABEL "&Добавить"
      997        SIZE 10 BY 1.
      998   DEFINE BUTTON b-next AUTO-GO
      999        LABEL "&>>"
     1000        SIZE 5 BY 1.
     1001   DEFINE BUTTON B-notes
     1002        LABEL "Примечание"
     1003        SIZE 11.5 BY 1 TOOLTIP "Примечание по заказу".
     1004   DEFINE BUTTON b-prev AUTO-GO
     1005        LABEL "&<<"
     1006        SIZE 5 BY 1.
     1007   DEFINE BUTTON b-quit AUTO-END-KEY
     1008        LABEL "&Отмена"
     1009        SIZE 10 BY 1.
     1010   DEFINE BUTTON b-renum
     1011        LABEL "№ п/п"
     1012        SIZE 10 BY 1 TOOLTIP "Перенумеровать список товаров".
     1013   DEFINE BUTTON r-agnt
     1014        IMAGE-UP FILE "btn-down-arrow":U
     1015        IMAGE-DOWN FILE "btn-down-arrow":U
     1016        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1017        LABEL "r boss 2"
     1018        SIZE 3 BY .88.
     1019   DEFINE BUTTON r-boss
     1020        IMAGE-UP FILE "btn-down-arrow":U
     1021        IMAGE-DOWN FILE "btn-down-arrow":U
     1022        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1023        LABEL "Button 1"
     1024        SIZE 3 BY .88.
     1025   DEFINE BUTTON r-wrkr
     1026        IMAGE-UP FILE "btn-down-arrow":U
     1027        IMAGE-DOWN FILE "btn-down-arrow":U
     1028        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1029        LABEL "r boss 2"
     1030        SIZE 3 BY .88.
     1031   DEFINE VARIABLE scr-e-method AS CHARACTER
     1032        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1033        SIZE 61.38 BY 6.04
     1034        BGCOLOR 8 FONT 4 NO-UNDO.
     1035   DEFINE VARIABLE scr-agnt AS INTEGER FORMAT "999999999":U INITIAL 0
     1036        LABEL ""
     1037        VIEW-AS FILL-IN
     1038        SIZE 10.13 BY 1 NO-UNDO.
     1039   DEFINE VARIABLE scr-agnt-name AS CHARACTER FORMAT "X(20)":U
     1040         VIEW-AS TEXT
     1041        SIZE 25 BY .67
     1042        FGCOLOR 4  NO-UNDO.
     1043   DEFINE VARIABLE scr-boss AS INTEGER FORMAT "999999999":U INITIAL 0
     1044        LABEL ""
     1045        VIEW-AS FILL-IN
     1046        SIZE 10.13 BY 1 NO-UNDO.
     1047   DEFINE VARIABLE scr-boss-name AS CHARACTER FORMAT "X(20)":U
     1048         VIEW-AS TEXT
     1049        SIZE 25 BY .67
     1050        FGCOLOR 4  NO-UNDO.
     1051   DEFINE VARIABLE scr-date-sale-1 AS DATE FORMAT "99/99/9999":U
     1052        LABEL "Период продаж с"
     1053        VIEW-AS FILL-IN
     1054        SIZE 11.25 BY 1 NO-UNDO.
     1055   DEFINE VARIABLE scr-date-sale-2 AS DATE FORMAT "99/99/9999":U
     1056        LABEL "по"
     1057        VIEW-AS FILL-IN
     1058        SIZE 11.25 BY 1 NO-UNDO.
     1059   DEFINE VARIABLE scr-obj-name AS CHARACTER FORMAT "X(256)":U
     1060        LABEL "на Объект"
     1061         VIEW-AS TEXT
     1062        SIZE 37.5 BY .67
     1063        FGCOLOR 4  NO-UNDO.
     1064   DEFINE VARIABLE scr-ship-date AS DATE FORMAT "99/99/9999":U
     1065        LABEL "Заказ на"
     1066        VIEW-AS FILL-IN
     1067        SIZE 11.13 BY 1 TOOLTIP "Заказ на дату" NO-UNDO.
     1068   DEFINE VARIABLE scr-sum-base AS DECIMAL FORMAT ">>>>>>>>>9.99":U INITIAL 0
     1069        LABEL "Итого сумма (вал)"
     1070         VIEW-AS TEXT
     1071        SIZE 14 BY .67
     1072        FGCOLOR 4  NO-UNDO.
     1073   DEFINE VARIABLE scr-sum-qnty AS DECIMAL FORMAT ">>>>>>>>>9.<<<":U INITIAL 0
     1074        LABEL "Итого кол-во"
     1075         VIEW-AS TEXT
     1076        SIZE 14 BY .67
     1077        FGCOLOR 4  NO-UNDO.
     1078   DEFINE VARIABLE scr-sum-rubl AS DECIMAL FORMAT ">>>>>>>>>9.99":U INITIAL 0
     1079        LABEL "Итого сумма (abbr_rub)"
     1080         VIEW-AS TEXT
     1081        SIZE 14 BY .67
     1082        FGCOLOR 4  NO-UNDO.
     1083   DEFINE VARIABLE scr-wrkr AS INTEGER FORMAT "999999999":U INITIAL 0
     1084        LABEL ""
     1085        VIEW-AS FILL-IN
     1086        SIZE 10.13 BY 1 NO-UNDO.
     1087   DEFINE VARIABLE scr-wrkr-name AS CHARACTER FORMAT "X(20)":U
     1088         VIEW-AS TEXT
     1089        SIZE 25 BY .67
     1090        FGCOLOR 4  NO-UNDO.
     1091   DEFINE VARIABLE scr-order-type AS INTEGER
     1092        VIEW-AS RADIO-SET VERTICAL
     1093        RADIO-BUTTONS
     1094             "Распределять в ГБД", 2,
     1095   "Распределять в УБД", 3
     1096        SIZE 21.63 BY 1.71 TOOLTIP "Где создавать запросы в УБД или ГБД"
     1097        FGCOLOR 1  NO-UNDO.
     1098   DEFINE VARIABLE t-auto AS LOGICAL INITIAL yes
     1099        LABEL "авто"
     1100        VIEW-AS TOGGLE-BOX
     1101        SIZE 7 BY .83 NO-UNDO.
     1102   DEFINE QUERY BROWSE-2 FOR
     1103         X_ord-line,
     1104         X_goods SCROLLING.
     1105   DEFINE BROWSE BROWSE-2
     1106     QUERY BROWSE-2 NO-LOCK DISPLAY
     1107         X_ord-line.line-num    COLUMN-LABEL  'N/п'  FORMAT ">>>>9"
     1108         X_goods.gds-code       COLUMN-LABEL  'Код товара'  FORMAT ">>>>>>>>9"
     1109         X_ord-line.artic       COLUMN-LABEL  'Артикул'
     1110         X_goods.gds-name       COLUMN-LABEL  'Название'  FORMAT "X(40)"
     1111         X_ord-line.qnty        COLUMN-LABEL  'Количество'  FORMAT ">>,>>>,>>9.<<<"
     1112         f-zapr-qnty ( Buffer X_ord-line , 'при':U )     COLUMN-LABEL  "Запр.прих."  FORMAT "->>>>>>>>.<<<"
     1113         f-zapr-qnty ( Buffer X_ord-line , 'рас':U )     COLUMN-LABEL  "Запр.расх."  FORMAT "->>>>>>>>.<<<"
     1114         X_ord-line.price-rubl  COLUMN-LABEL  'Цена(руб)'  FORMAT ">,>>>,>>9.99"
     1115         X_ord-line.price-base  COLUMN-LABEL  'Цена(вал)'  FORMAT ">,>>>,>>9.99"
     1116         X_ord-line.sum-base    COLUMN-LABEL  'Сумма в вал.'  FORMAT ">>>,>>>,>>9.99"
     1117         X_ord-line.sum-rubl    COLUMN-LABEL  'Сумма в руб.'  FORMAT ">>>,>>>,>>9.99"
     1118         v-fact-qnty            COLUMN-LABEL  'Текущий остаток' FORMAT "->>,>>>,>>9.<<<"
     1119     ENABLE
     1120         X_ord-line.qnty
     1121       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.5 BY 9.67.
     1122   DEFINE FRAME Dialog-Frame
     1123        b-exit AT ROW 1 COL 1
     1124        b-quit AT ROW 1 COL 11
     1125        B-delivery AT ROW 1 COL 21
     1126        B-notes AT ROW 1 COL 31 WIDGET-ID 2
     1127        B-help AT ROW 1 COL 86.13
     1128        b-prev AT ROW 2 COL 1
     1129        b-next AT ROW 2 COL 6
     1130        scr-ship-date AT ROW 2.08 COL 24.13 COLON-ALIGNED
     1131        scr-date-sale-1 AT ROW 2.08 COL 54.25 COLON-ALIGNED
     1132        scr-date-sale-2 AT ROW 2.08 COL 70 COLON-ALIGNED
     1133        scr-wrkr AT ROW 3.17 COL 5.88 COLON-ALIGNED
     1134        r-wrkr AT ROW 3.21 COL 17.88
     1135        scr-order-type AT ROW 4.04 COL 74.63 NO-LABEL
     1136        scr-agnt AT ROW 4.21 COL 5.75 COLON-ALIGNED
     1137        r-agnt AT ROW 4.29 COL 17.88
     1138        scr-boss AT ROW 5.33 COL 5.75 COLON-ALIGNED
     1139        r-boss AT ROW 5.42 COL 17.88
     1140        scr-e-method AT ROW 6.54 COL 1 NO-LABEL
     1141        B-ins AT ROW 12.83 COL 1
     1142        B-chg AT ROW 12.83 COL 11
     1143        B-del AT ROW 12.83 COL 21
     1144        B-calc AT ROW 12.83 COL 31
     1145        b-renum AT ROW 12.83 COL 43
     1146        t-auto AT ROW 13.04 COL 88.25
     1147        BROWSE-2 AT ROW 14 COL 1
     1148        scr-obj-name AT ROW 3.25 COL 56.75 COLON-ALIGNED
     1149        scr-wrkr-name AT ROW 3.33 COL 19.25 COLON-ALIGNED NO-LABEL
     1150        scr-agnt-name AT ROW 4.46 COL 19.25 COLON-ALIGNED NO-LABEL
     1151        scr-boss-name AT ROW 5.63 COL 19.25 COLON-ALIGNED NO-LABEL
     1152        scr-sum-qnty AT ROW 6.29 COL 80.38 COLON-ALIGNED
     1153        scr-sum-rubl AT ROW 7 COL 80.38 COLON-ALIGNED
     1154        scr-sum-base AT ROW 7.83 COL 80.38 COLON-ALIGNED
     1155        SPACE(0.12) SKIP(15.17)
     1156       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1157            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1158            TITLE "Заказ ОО".
     1159   ASSIGN
     1160          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1161          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1162   ASSIGN
     1163          b-next:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1164   ASSIGN
     1165          b-prev:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1166   ON GO OF FRAME Dialog-Frame
     1167   DO:
     1168    define buffer buf_ord-line for ub.ord-line.
     1169    define variable v-kol as integer init 0 no-undo .
     1170     if p-mode =  'ПРОСМОТР':U then return.
     1171     if p-mode <> 'ПРОСМОТР':U then do:
     1172        assign frame Dialog-Frame
     1173        scr-ship-date
     1174        scr-e-method
     1175        scr-date-sale-1
     1176        scr-date-sale-2
     1177        scr-wrkr
     1178        scr-agnt
     1179        scr-boss
     1180        scr-order-type
     1181        .
     1182        loc-date-ship = scr-ship-date .
     1183        if scr-date-sale-2 <  scr-date-sale-1 then do:
     1184           message "Не верно введен интервал дат !"  .
     1185           return no-apply .
     1186        end.
     1187        if scr-date-sale-1 <  loc-date-ship then do:
     1188           message "Дата интервала меньше даты заказа !" .
     1189           return no-apply .
     1190        end.
     1191     if can-find
     1192       ( first buf_ord-line  no-lock    where
     1193               buf_ord-line.doc-code = loc-ord-num  and
     1194               buf_ord-line.qnty  =  0 ) then do:
     1195         message "В заказе есть нерассчитанные строки . Удаляем их ? " view-as alert-box question  buttons yes-no update v-log.
     1196          if v-log then do:
     1197               for each buf_ord-line  exclusive-lock
     1198                       where buf_ord-line.qnty = 0      and
     1199                       buf_ord-line.doc-code = loc-ord-num
     1200                       :
     1201                        delete buf_ord-line .
     1202               end.
     1203          end.
     1204      end.
     1205        define variable s-1 as decimal init 0 no-undo .
     1206        define variable s-2 as decimal init 0 no-undo .
     1207        define variable s-3 as decimal init 0 no-undo .
     1208        for each  buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num  :
     1209            s-1  = s-1  + buf_ord-line.sum-rubl .
     1210            s-2  = s-2  + buf_ord-line.sum-base .
     1211            s-3  = s-3  + buf_ord-line.qnty .
     1212            v-kol = v-kol + 1 .
     1213        end.
     1214        if v-kol = 0 then do:
     1215           message "В заказе нет строк . Удаляем документ ? " view-as alert-box question
     1216           buttons yes-no title "" update t-log-3 as logical.
     1217           if t-log-3 = true then do:
     1218                 find first buf-oo_ord-doc exclusive-lock where recid(buf-oo_ord-doc) = p-ord-doc-recid  no-error.
     1219                 if available buf-oo_ord-doc then
     1220                 delete buf-oo_ord-doc.
     1221                 p-ord-doc-recid = ? .
     1222                 return.
     1223               end.
     1224        end.
     1225     end.
     1226     find current buf_ord-doc exclusive-lock no-error .
     1227     assign
     1228       buf_ord-doc.sum-rubl = s-1
     1229       buf_ord-doc.sum-base = s-2
     1230       buf_ord-doc.qnty     = s-3
     1231       buf_ord-doc.e-method = scr-e-method
     1232       buf_ord-doc.date-sale-1 = scr-date-sale-1
     1233       buf_ord-doc.date-sale-2 = scr-date-sale-2
     1234       buf_ord-doc.ship-date = scr-ship-date
     1235       buf_ord-doc.wrkr   = scr-wrkr
     1236       buf_ord-doc.boss   = scr-boss
     1237       buf_ord-doc.agnt   = scr-agnt
     1238       buf_ord-doc.status_     = 'новый':U
     1239       buf_ord-doc.order-type  = scr-order-type
     1240       buf_ord-doc.deliv-type-code    = v-deliv-type-code
     1241       buf_ord-doc.obj-point-code     = v-point-obj-code
     1242       buf_ord-doc.cli-point-code     = v-point-cli-code
     1243       buf_ord-doc.obj-point-db-num   = v-point-obj-db-num
     1244       buf_ord-doc.cli-point-db-num   = v-point-cli-db-num
     1245       buf_ord-doc.transport-host-code     = v-transport-host-code
     1246       buf_ord-doc.transport-cli-type     = v-transport-cli-type
     1247       buf_ord-doc.transport-cli-code     = v-transport-cli-code
     1248       buf_ord-doc.transport-contract = v-transport-contract
     1249       buf_ord-doc.transport-condition= v-transport-condition
     1250       buf_ord-doc.transport-value    = v-transport-value
     1251       buf_ord-doc.sum-ship           = v-transport-sum
     1252       buf_ord-doc.transport-vat      = v-transport-vat
     1253     .
     1254     if buf_ord-doc.status_ = 'новый':U and buf_ord-doc.flag_ = false then do:
     1255         message "Закрываем заказ до статуса НОВЫЙ+ ? " view-as alert-box question
     1256               buttons yes-no title "" update t-log-4 as logical.
     1257               if t-log-4 = true then do:
     1258                 run cus/ordoocls.p
     1259                   ( input parParentProc ,
     1260                     input recid(buf_ord-doc) ,
     1261                     input true
     1262                     ) no-error .
     1263                 if error-status :error then return  .
     1264               end.
     1265     end.
     1266   END.
     1267   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1268   DO:
     1269     APPLY "END-ERROR":U TO SELF.
     1270   END.
     1271   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
     1272   DO:
     1273   define buffer buf_ord-line for ub.ord-line.
     1274   define buffer buf_goods for ub.goods.
     1275   assign frame Dialog-Frame scr-ship-date scr-date-sale-1 scr-date-sale-2.
     1276   loc-date-ship = scr-ship-date .
     1277   date-sale-1 = scr-date-sale-1 .
     1278   date-sale-2 = scr-date-sale-2 .
     1279   if loc-date-ship < today then do:
     1280      message "Для расчета заказа ДАТА ЗАКАЗА должна быть не меньше текущей " view-as alert-box information .
     1281      return no-apply.
     1282   end.
     1283   if date-sale-1 < loc-date-ship then do:
     1284      message "Для расчета заказа ДАТА ПЕРИОДА должна быть больше даты заказа " view-as alert-box information .
     1285      return no-apply.
     1286   end.
     1287   if date-sale-2 <  date-sale-1 then do:
     1288     message "Не верно введен интервал дат !" .
     1289     return no-apply .
     1290   end.
     1291   for each tmp#zakaz :
     1292       delete tmp#zakaz  .
     1293   end.
     1294   for each  buf_ord-line no-lock where buf_ord-line.doc-code = loc-ord-num  :
     1295       find first buf_goods no-lock where
     1296               buf_goods.artic     = buf_ord-line.artic     and
     1297               buf_goods.prod-type = buf_ord-line.prod-type and
     1298               buf_goods.prod-code = buf_ord-line.prod-code .
     1299       create tmp#zakaz .
     1300       BUFFER-COPY buf_ord-line to tmp#zakaz
     1301     assign
     1302       tmp#zakaz.gds-code        = buf_goods.gds-code
     1303       tmp#zakaz.prod-type       = buf_goods.prod-type
     1304       tmp#zakaz.prod-code       = buf_goods.prod-code
     1305       tmp#zakaz.artic           = buf_goods.artic
     1306       tmp#zakaz.gds-name        = buf_goods.gds-name
     1307       tmp#zakaz.deadline        = buf_goods.deadline
     1308       tmp#zakaz.unit-cli        = buf_goods.unit-cli
     1309       tmp#zakaz.unit-base       = buf_goods.unit-base
     1310       tmp#zakaz.negative-rest   = buf_goods.negative-rest
     1311       tmp#zakaz.cli-base-rate   = 1
     1312       tmp#zakaz.ms-cart         = buf_goods.qnty-cart
     1313       .
     1314   end.
     1315   if not can-find (first tmp#zakaz )  then return.
     1316   if scr-date-sale-2 = ? or scr-date-sale-1 = ? then
     1317       message  "ПРЕДУПРЕЖДЕНИЕ :  Не задан период продаж !"
     1318       view-as alert-box information
     1319       title "Внимание!!!".
     1320   pay-day =  scr-date-sale-2 - scr-date-sale-1 + 1.
     1321   if pay-day = 0 or pay-day = ? then pay-day = 1 .
     1322   loc-store-code = v-cntxt-obj-code .
     1323   loc-store-type = v-cntxt-obj-type .
     1324   loc-doc-type   = 'ОО':U     .
     1325   if not available buf-oo_ord-doc then do:
     1326      find first buf-oo_ord-doc exclusive-lock where buf-oo_ord-doc.doc-code = loc-ord-num  no-error.
     1327      if error-status :error then
     1328      message
     1329        vss-workfile vss-revision vss-description skip
     1330        error-status :get-message(1) skip
     1331        return-value skip
     1332        "orderOO"
     1333        view-as alert-box error
     1334      .
     1335   end.
     1336   run cus/ord-m.w  ( input parParentProc ,  input ? , buf-oo_ord-doc.doc-type ) .
     1337   scr-e-method = e-method .
     1338   display scr-e-method with frame Dialog-Frame .
     1339   run openbr in this-procedure .
     1340   run recalc-head.
     1341   END.
     1342   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1343   DO:
     1344    define variable r-stop as logical no-undo .
     1345    define variable r-exit as logical no-undo .
     1346    define variable r-recid as recid no-undo.
     1347    find current x_ord-line  exclusive-lock  no-error .
     1348    if available x_ord-line then do:
     1349        r-recid =  recid ( x_ord-line)  .
     1350        run cus/ord-frmo.w (parParentProc , input ?  , input r-recid  , input 'ИЗМЕНЕНИЕ':U,  output r-stop , output r-exit ) .
     1351        v-log =  BROWSE-2:refresh() .
     1352    end.
     1353       run recalc-head.
     1354   END.
     1355   ON return OF B-chg IN FRAME Dialog-Frame
     1356   DO:
     1357     run next-focus in this-procedure  (input  B-chg:handle ) .
     1358     return no-apply .
     1359   END.
     1360   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1361   DO:
     1362   define variable v-ii as integer no-undo .
     1363   message "Удалить запись ?"
     1364         view-as alert-box question
     1365         buttons yes-no
     1366         update g-log as logical .
     1367         if g-log = false then return no-apply.
     1368    find current x_ord-line  exclusive-lock  no-error .
     1369    if available x_ord-line then do:
     1370       run x-delete ( recid(x_ord-line) , input-output v-ii ) no-error .
     1371       if error-status :error then
     1372       message vss-workfile vss-revision vss-description skip
     1373              "Ошибка удаление 1 " skip
     1374               skip
     1375               error-status :get-message(1) skip
     1376               return-value skip
     1377               view-as alert-box error
     1378       .
     1379       Run OpenBr.
     1380    end.
     1381       run recalc-head.
     1382   END.
     1383   ON CHOOSE OF B-delivery IN FRAME Dialog-Frame
     1384   DO:
     1385     run cus/pardeliv.w
     1386        (input parParentproc
     1387         ,input        p-mode
     1388         ,input        "ord" + 'ОО':U
     1389         ,input        loc-obj-type
     1390         ,input        loc-obj-code
     1391         ,input        loc-cli-type
     1392         ,input        loc-cli-code
     1393         ,input-output v-deliv-type-code
     1394         ,input-output v-point-obj-code
     1395         ,input-output v-point-obj-db-num
     1396         ,input-output v-point-cli-code
     1397         ,input-output v-point-cli-db-num
     1398         ,input-output v-transport-host-code
     1399         ,input-output v-transport-cli-type
     1400         ,input-output v-transport-cli-code
     1401         ,input-output v-transport-contract
     1402         ,input-output v-transport-condition
     1403         ,input-output v-transport-value
     1404         ,input-output v-transport-sum
     1405         ,input-output v-transport-vat
     1406            ) no-error  .
     1407            if error-status :error then message
     1408              vss-workfile vss-revision vss-description skip
     1409              error-status :get-message(1) skip
     1410              return-value skip
     1411              "Ошибка"
     1412              view-as alert-box error
     1413            .
     1414   END.
     1415   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1416   DO:
     1417       next-prev = ?.
     1418   END.
     1419   ON CHOOSE OF B-ins IN FRAME Dialog-Frame
     1420   DO:
     1421     run proc-add.
     1422     run recalc-head.
     1423   END.
     1424   ON CHOOSE OF b-next IN FRAME Dialog-Frame
     1425   DO:
     1426   run step-next.
     1427   END.
     1428   ON CHOOSE OF B-notes IN FRAME Dialog-Frame
     1429   DO:
     1430     run proc-d-notes in this-procedure .
     1431   END.
     1432   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
     1433   DO:
     1434      run step-prev.
     1435   END.
     1436   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1437   DO:
     1438       next-prev = ?.
     1439       message "Выходим без сохранения изменений ?" view-as alert-box question
     1440               buttons yes-no
     1441               update ll as log
     1442               .
     1443       if ll = no then return no-apply.
     1444       else do:
     1445         if p-mode  = 'ДОБАВЛЕНИЕ':U then do:
     1446           find first buf-oo_ord-doc exclusive-lock where recid(buf-oo_ord-doc) = p-ord-doc-recid  no-error.
     1447           if available buf-oo_ord-doc then
     1448           delete buf-oo_ord-doc.
     1449         end.
     1450        end.
     1451   END.
     1452   ON CHOOSE OF b-renum IN FRAME Dialog-Frame
     1453   DO:
     1454   run proc-renum.
     1455   END.
     1456   ON ROW-DISPLAY OF BROWSE-2 IN FRAME Dialog-Frame
     1457   DO:
     1458     define buffer buf_gds-obj for ub.gds-obj  .
     1459       find first buf_gds-obj no-lock where
     1460                buf_gds-obj.artic     = x_ord-line.artic     and
     1461                buf_gds-obj.prod-type = x_ord-line.prod-type and
     1462                buf_gds-obj.prod-code = x_ord-line.prod-code and
     1463                buf_gds-obj.obj-type  = buf_ord-doc.obj-type   and
     1464                buf_gds-obj.obj-code  = buf_ord-doc.obj-code   no-error .
     1465      if available buf_gds-obj then
     1466              v-fact-qnty = buf_gds-obj.fact-qnty.
     1467         else v-fact-qnty = 0 .
     1468   END.
