     3683   Procedure proc-r-boss :
     3684    do
     3685    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3686    :
     3687    define variable rid-list    as  char no-undo .
     3688    define variable v-recid as recid no-undo .
     3689    define variable old-types as character no-undo .
     3690    define buffer boss#clients for ub.clients.
     3691       run ref/cli-all.w
     3692       ( input parParentProc, input "b-sel", 'чел':U, ?, ?, ?, ?, ?, output  rid-list).
     3693       Assign
     3694         v-recid = integer(rid-list)
     3695         .
     3696       find first boss#clients no-lock WHERE recid(boss#clients) = v-recid  No-ERROR.
     3697       if avail boss#clients then
     3698           Assign
     3699               scr-boss = boss#clients.obj-code
     3700               scr-boss-name = boss#clients.obj-name
     3701               .
     3702       else
     3703          Assign
     3704             scr-boss-name = ""
     3705             scr-boss = ?
     3706             .
     3707       Display scr-boss scr-boss-name with frame Dialog-Frame .
     3708   end.
     3709   end procedure.
     3710   procedure leave-proc-boss :
     3711    do
     3712    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3713    :
     3714     def buffer buf_clients for ub.clients.
     3715     Assign frame Dialog-Frame scr-boss .
     3716     if scr-boss <> ? and scr-boss <> 0 then do:
     3717         find first buf_clients no-lock where
     3718                   buf_clients.obj-type = 'чел':U  and
     3719                   buf_clients.obj-code  = scr-boss no-error.
     3720             if error-status :error or not available buf_clients then do:
     3721                 Message "Неправильно задан "  scr-boss:label in frame Dialog-Frame.
     3722                   Assign
     3723                   scr-boss-name = ""
     3724                   scr-boss = ?
     3725                   .
     3726                 Display  scr-boss scr-boss-name with frame Dialog-Frame.
     3727                 apply "CHOOSE" to r-boss in frame Dialog-Frame .
     3728             end.
     3729             if available buf_clients Then DO:
     3730                   scr-boss      = buf_clients.obj-code .
     3731                   scr-boss-name = buf_clients.obj-name .
     3732             End.
     3733    End.
     3734    else do:
     3735         Assign
     3736           scr-boss-name = ""
     3737           scr-boss = ?
     3738           .
     3739     end.
     3740    Display  scr-boss scr-boss-name with frame Dialog-Frame.
     3741    end.
     3742   end procedure.
