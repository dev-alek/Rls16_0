     2217   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2218   procedure minbtn-set :
     2219       do
     2220           on error undo, return error return-value
     2221           :
     2222           define variable ii              as integer       no-undo .
     2223           define variable fh              as widget-handle no-undo .
     2224           define variable hh              as widget-handle no-undo .
     2225           define variable v-h             as handle        extent 4 no-undo .
     2226           define variable v-name-button   as character     no-undo .
     2227           define variable v-help-old-x    as decimal       no-undo .
     2228           define variable v-help-old-y    as decimal       no-undo .
     2229           define variable v-help-old-size as decimal       no-undo .
     2230           define variable v-frame-width   as decimal       no-undo .
     2231           define variable jj              as integer       no-undo .
     2232           do
     2233               on error undo, return error
     2234               :
     2235               assign
     2236                   v-frame-width = frame Dialog-Frame:width - 0.3
     2237                   fh            = frame Dialog-Frame:first-child
     2238                   hh            = fh:first-child
     2239                   ii            = 1
     2240                   .
     2241               do while valid-handle(hh):
     2242                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2243                   do:
     2244                       case lc(hh:name) :
     2245                           when "b-help" then
     2246                               do:
     2247                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2248                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2249                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2250                                   hh:TOOLTIP = "Помощь" .
     2251                                   v-help-old-x = hh:column .
     2252                                   v-help-old-y = hh:row    .
     2253                                   v-help-old-size = hh:width .
     2254                                   hh:width-chars = 2.5 .
     2255                               end.
     2256                           when "b-print" then
     2257                               do:
     2258                                   hh:load-image("cmp/b-print.bmp":u) .
     2259                                   hh:TOOLTIP = "Печать" .
     2260                                   v-h[ii] = hh:handle .
     2261                                   ii = ii + 1 .
     2262                                   hh:width-chars = 3 .
     2263                               end.
     2264                           when "b-history" or
     2265                           when "b-hist" then
     2266                               do:
     2267                                   hh:load-image("cmp/b-hist.bmp":u) .
     2268                                   hh:TOOLTIP = "История" .
     2269                                   v-h[ii] = hh:handle .
     2270                                   ii = ii + 1 .
     2271                                   hh:width-chars = 3 .
     2272                               end.
     2273                           when "b-sch" then
     2274                               do:
     2275                                   hh:load-image("cmp/b-sch.bmp":u) .
     2276                                   hh:TOOLTIP = "Установка Фильтра" .
     2277                                   v-h[ii] = hh:handle .
     2278                                   ii = ii + 1 .
     2279                                   hh:width-chars = 3 .
     2280                               end.
     2281                           when "b-hist-user" then
     2282                               do:
     2283                                   hh:load-image("cmp/b-hist.bmp":u) .
     2284                                   hh:TOOLTIP = "История пользователя" .
     2285                                   ii = ii + 1 .
     2286                               end.
     2287                       end case.
     2288                   end.
     2289                   hh = hh:next-sibling.
     2290               end.
     2291               b-help:column = v-frame-width - b-help:width-chars.
     2292               jj = 0.
     2293               repeat ii = 4 to 1 by -1 :
     2294                   if valid-handle (v-h[ii] ) then
     2295                   do:
     2296                       jj  = jj + 1 .
     2297                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2298                       v-h[ii]:row    = v-help-old-y .
     2299                   end.
     2300               end.
     2301           end.
     2302       end.
     2303   end procedure.
     2304   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2305   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2306   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2307   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2308   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2309   define variable v-diasize-current-frame-height as decimal   no-undo .
     2310   define variable v-diasize-change-size          as logical   no-undo .
     2311   define variable v-diasize-resize-button        as handle    no-undo .
     2312   define variable v-diasize-wndmax               as logical   no-undo .
     2313   define variable v-diasize-wndstore             as logical   no-undo .
     2314   define variable v-diasize-proc-name            as character no-undo .
     2315   define variable v-diasize-browse-handle        as handle    no-undo .
     2316   define variable v-diasize-browse-number        as integer   no-undo .
     2317   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2318   define temp-table temp-diasize-handle no-undo
     2319     field handle-value  as handle
     2320     field save-position as decimal
     2321     index xpk is primary unique handle-value
     2322     .
     2323   define temp-table temp-browse-handle no-undo
     2324     field browse-type   as character
     2325     field browse-number as integer
     2326     field browse-handle as handle
     2327     field original-size as decimal
     2328     index xpk is primary unique browse-type browse-number
     2329     index xie browse-type browse-handle
     2330   .
     2331   procedure diasize_change-height :
     2332     define input  parameter p-change-value  as decimal   no-undo .
     2333     define input  parameter p-move-resize   as logical   no-undo .
     2334     define variable v-field-group-handle    as handle    no-undo .
     2335     define variable v-object-handle         as handle    no-undo .
     2336     define variable v-frame-height          as decimal   no-undo .
     2337     define variable v-frame-virtual-height  as decimal   no-undo .
     2338     define variable v-browse-height         as decimal   no-undo .
     2339     define variable v-window-height         as decimal   no-undo .
     2340     define variable v-window-virtual-height as decimal   no-undo .
     2341     define variable v-change-sign           as integer   no-undo .
     2342     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2343     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2344     if p-change-value > 0
     2345     then do:
     2346       if frame Dialog-Frame :height + p-change-value
     2347           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2348       then do:
     2349         assign
     2350           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2351                           - (frame Dialog-Frame :height-chars)
     2352         .
     2353         if p-change-value <= 0
     2354         then do:
     2355           run diasize_position-resize-button in this-procedure .
     2356           return .
     2357         end.
     2358       end.
     2359     end.
     2360     if p-change-value < 0
     2361     then do:
     2362       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2363       then do:
     2364         assign
     2365           p-change-value = v-diasize-orig-frame-height
     2366                          - (frame Dialog-Frame :height-chars)
     2367         .
     2368         if p-change-value >= 0
     2369         then do:
     2370           run diasize_position-resize-button in this-procedure .
     2371           return .
     2372         end.
     2373       end.
     2374     end.
     2375     if p-change-value >= 0
     2376     then do:
     2377       assign
     2378         v-change-sign = 1
     2379       .
     2380     end.
     2381     else do:
     2382       assign
     2383         v-change-sign = -1
     2384       .
     2385     end.
     2386     assign
     2387       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2388     .
     2389     if p-change-value = 0
     2390     then do:
     2391       run diasize_position-resize-button in this-procedure .
     2392       return .
     2393     end.
     2394     move_block:
     2395     do
     2396     on error undo move_block, retry move_block
     2397     :
     2398       if retry
     2399       then do:
     2400         do
     2401         on error undo move_block, leave move_block
     2402         :
     2403           if p-change-value > 0
     2404           then do:
     2405             for each buf_temp-diasize-handle
     2406             on error undo, next
     2407             :
     2408               assign
     2409                 v-object-handle = buf_temp-diasize-handle.handle-value
     2410               .
     2411               if v-object-handle <> v-diasize-resize-button
     2412               then do:
     2413                 assign
     2414                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2415                 .
     2416               end.
     2417             end.
     2418             assign
     2419               v-diasize-browse-handle :height = v-browse-height
     2420             .
     2421             for each buf_temp-browse-handle
     2422               where buf_temp-browse-handle.browse-type = 'height':u
     2423             on error undo, next
     2424             :
     2425               assign
     2426                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2427               .
     2428             end.
     2429             assign
     2430               frame Dialog-Frame :height = v-frame-height
     2431             .
     2432             if frame Dialog-Frame :scrollable = true
     2433             then do:
     2434               assign
     2435                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2436               .
     2437             end.
     2438             run diasize_position-resize-button in this-procedure .
     2439           end.
     2440           else do:
     2441             if frame Dialog-Frame :scrollable = true
     2442             then do:
     2443               assign
     2444                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2445               .
     2446             end.
     2447             assign
     2448               frame Dialog-Frame :height = v-frame-height
     2449             .
     2450             assign
     2451               v-diasize-browse-handle :height = v-browse-height
     2452             .
     2453             for each buf_temp-browse-handle
     2454               where buf_temp-browse-handle.browse-type = 'height':u
     2455             on error undo, next
     2456             :
     2457               assign
     2458                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2459               .
     2460             end.
     2461             for each buf_temp-diasize-handle
     2462             on error undo, next
     2463             :
     2464               assign
     2465                 v-object-handle = buf_temp-diasize-handle.handle-value
     2466               .
     2467               if v-object-handle <> v-diasize-resize-button
     2468               then do:
     2469                 assign
     2470                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2471                 .
     2472               end.
     2473             end.
     2474             run diasize_position-resize-button in this-procedure .
     2475           end.
     2476           assign
     2477             v-diasize-change-size = false
     2478           .
     2479           leave move_block .
     2480         end.
     2481       end.
     2482       assign
     2483         v-diasize-need-full-display = true
     2484       .
     2485       if v-diasize-change-size = false
     2486       then do:
     2487         assign
     2488           v-diasize-change-size = true
     2489         .
     2490       end.
     2491       else do:
     2492         return .
     2493       end.
     2494       assign
     2495         v-frame-height = frame Dialog-Frame :height
     2496         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2497         v-browse-height = v-diasize-browse-handle :height
     2498       .
     2499       for each buf_temp-browse-handle
     2500         where buf_temp-browse-handle.browse-type = 'height':u
     2501       :
     2502         assign
     2503           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2504         .
     2505       end.
     2506       for each buf_temp-diasize-handle
     2507       :
     2508         delete buf_temp-diasize-handle .
     2509       end.
     2510       assign
     2511         v-field-group-handle = frame Dialog-Frame :first-child
     2512       .
     2513       do while valid-handle(v-field-group-handle)
     2514       :
     2515         assign
     2516           v-object-handle = v-field-group-handle :first-child
     2517         .
     2518         do while valid-handle(v-object-handle)
     2519         :
     2520           if  v-object-handle <> v-diasize-browse-handle :handle
     2521           and can-query(v-object-handle, "row")
     2522           and can-query(v-object-handle, "height")
     2523           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2524           then do:
     2525             find first buf_temp-browse-handle
     2526               where buf_temp-browse-handle.browse-type   = 'height':u
     2527                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2528               no-error .
     2529             if available buf_temp-browse-handle
     2530             then do:
     2531             end.
     2532             else do:
     2533               create buf_temp-diasize-handle .
     2534               assign
     2535                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2536                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2537               .
     2538             end.
     2539           end.
     2540           assign
     2541             v-object-handle = v-object-handle :next-sibling
     2542           .
     2543         end.
     2544         assign
     2545           v-field-group-handle = v-field-group-handle :next-sibling
     2546         .
     2547       end.
     2548       do with frame Dialog-Frame
     2549       :
     2550         hide v-diasize-resize-button .
     2551         assign
     2552           v-diasize-resize-button :row    = 1
     2553           v-diasize-resize-button :column = 1
     2554         .
     2555       end.
     2556       if p-change-value > 0
     2557       then do:
     2558         if frame Dialog-Frame :scrollable = true
     2559         then do:
     2560           assign
     2561             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2562             no-error .
     2563           if error-status :error
     2564           or error-status :get-message(1) <> ""
     2565           then do:
     2566             undo move_block, retry move_block .
     2567           end.
     2568         end.
     2569         assign
     2570           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2571           no-error .
     2572         if error-status :error
     2573         or error-status :get-message(1) <> ""
     2574         then do:
     2575           undo move_block, retry move_block .
     2576         end.
     2577         assign
     2578           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2579           no-error .
     2580         if error-status :error
     2581         or error-status :get-message(1) <> ""
     2582         then do:
     2583           undo move_block, retry move_block .
     2584         end.
     2585         for each buf_temp-browse-handle
     2586           where buf_temp-browse-handle.browse-type = 'height':u
     2587         on error undo move_block, retry move_block
     2588         :
     2589           assign
     2590             buf_temp-browse-handle.browse-handle :height
     2591               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2592             no-error .
     2593           if error-status :error
     2594           or error-status :get-message(1) <> ""
     2595           then do:
     2596             undo move_block, retry move_block .
     2597           end.
     2598         end.
     2599         for each buf_temp-diasize-handle
     2600         on error undo move_block, retry move_block
     2601         :
     2602           assign
     2603             v-object-handle = buf_temp-diasize-handle.handle-value
     2604           .
     2605           if v-object-handle <> v-diasize-resize-button
     2606           then do:
     2607             assign
     2608               v-object-handle :row = v-object-handle :row + p-change-value
     2609               no-error .
     2610             if error-status :error
     2611             or error-status :get-message(1) <> ""
     2612             then do:
     2613               undo move_block, retry move_block .
     2614             end.
     2615           end.
     2616         end.
     2617       end.
     2618       else do:
     2619         for each buf_temp-diasize-handle
     2620         on error undo move_block, retry move_block
     2621         :
     2622           assign
     2623             v-object-handle = buf_temp-diasize-handle.handle-value
     2624           .
     2625           if v-object-handle <> v-diasize-resize-button
     2626           then do:
     2627             assign
     2628               v-object-handle :row = v-object-handle :row + p-change-value
     2629               no-error .
     2630             if error-status :error
     2631             or error-status :get-message(1) <> ""
     2632             then do:
     2633               undo move_block, retry move_block .
     2634             end.
     2635           end.
     2636         end.
     2637         assign
     2638           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2639           no-error .
     2640         if error-status :error
     2641         or error-status :get-message(1) <> ""
     2642         then do:
     2643           undo move_block, retry move_block .
     2644         end.
     2645         for each buf_temp-browse-handle
     2646           where buf_temp-browse-handle.browse-type = 'height':u
     2647         on error undo move_block, retry move_block
     2648         :
     2649           assign
     2650             buf_temp-browse-handle.browse-handle :height
     2651               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2652             no-error .
     2653           if error-status :error
     2654           or error-status :get-message(1) <> ""
     2655           then do:
     2656             undo move_block, retry move_block .
     2657           end.
     2658         end.
     2659         assign
     2660           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2661           no-error .
     2662         if error-status :error
     2663         or error-status :get-message(1) <> ""
     2664         then do:
     2665           undo move_block, retry move_block .
     2666         end.
     2667         if frame Dialog-Frame :scrollable = true
     2668         then do:
     2669           assign
     2670             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2671             no-error .
     2672           if error-status :error
     2673           or error-status :get-message(1) <> ""
     2674           then do:
     2675             undo move_block, retry move_block .
     2676           end.
     2677         end.
     2678       end.
     2679       if p-move-resize = true
     2680       then do:
     2681         run diasize_position-resize-button in this-procedure .
     2682       end.
     2683       if v-diasize-wndstore = true
     2684       then do:
     2685         if connected("ub") = true
     2686         then do:
     2687           define variable v-cntxt-db-num        as integer   no-undo .
     2688           define variable v-cntxt-userid        as character no-undo .
     2689           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2690                                             , OUTPUT v-cntxt-userid
     2691                                             ) .
     2692           run gbl/wndsizew.p
     2693             (input  v-cntxt-db-num
     2694             ,input  v-cntxt-userid
     2695             ,input  v-diasize-proc-name
     2696             ,input  'height':u
     2697             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2698             ) .
     2699         end.
     2700       end.
     2701     end.
     2702     assign
     2703       v-diasize-change-size = false
     2704     .
     2705   end procedure.
     2706   procedure diasize_set-height :
     2707     define input  parameter p-new-height  as decimal   no-undo .
     2708     define input  parameter p-move-resize as logical   no-undo .
     2709     do
     2710     on error undo, return error return-value
     2711     :
     2712       run diasize_change-height in this-procedure
     2713         (input  (p-new-height - frame Dialog-Frame :height)
     2714         ,input  p-move-resize
     2715         ) .
     2716     end.
     2717   end procedure.
     2718   procedure diasize_change-width :
     2719     define input  parameter p-change-value as decimal   no-undo .
     2720     define input  parameter p-move-resize  as logical   no-undo .
     2721     define variable v-field-group-handle   as handle    no-undo .
     2722     define variable v-object-handle        as handle    no-undo .
     2723     define variable v-frame-width          as decimal   no-undo .
     2724     define variable v-frame-virtual-width  as decimal   no-undo .
     2725     define variable v-browse-width         as decimal   no-undo .
     2726     define variable v-window-width         as decimal   no-undo .
     2727     define variable v-window-virtual-width as decimal   no-undo .
     2728     define variable v-change-sign          as integer   no-undo .
     2729     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2730     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2731     if p-change-value > 0
     2732     then do:
     2733       if frame Dialog-Frame :width + p-change-value >
     2734           session :width-chars
     2735       then do:
     2736         assign
     2737           p-change-value = session :width-chars - frame Dialog-Frame :width
     2738         .
     2739         if p-change-value <= 0
     2740         then do:
     2741           run diasize_position-resize-button in this-procedure .
     2742           return .
     2743         end.
     2744       end.
     2745     end.
     2746     if p-change-value < 0
     2747     then do:
     2748       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2749       then do:
     2750         assign
     2751           p-change-value = v-diasize-orig-frame-width
     2752                          - frame Dialog-Frame :width
     2753         .
     2754         if p-change-value >= 0
     2755         then do:
     2756           run diasize_position-resize-button in this-procedure .
     2757           return .
     2758         end.
     2759       end.
     2760     end.
     2761     if p-change-value >= 0
     2762     then do:
     2763       assign
     2764         v-change-sign = 1
     2765       .
     2766     end.
     2767     else do:
     2768       assign
     2769         v-change-sign = -1
     2770       .
     2771     end.
     2772     assign
     2773       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2774     .
     2775     if p-change-value = 0
     2776     then do:
     2777       run diasize_position-resize-button in this-procedure .
     2778       return .
     2779     end.
     2780     move_block:
     2781     do
     2782     on error undo move_block, leave move_block
     2783     :
     2784       if retry
     2785       then do:
     2786         do
     2787         on error undo move_block, leave move_block
     2788         :
     2789           if p-change-value > 0
     2790           then do:
     2791             for each buf_temp-diasize-handle
     2792             on error undo, next
     2793             :
     2794               assign
     2795                 v-object-handle = buf_temp-diasize-handle.handle-value
     2796               .
     2797               if v-object-handle <> v-diasize-resize-button
     2798               then do:
     2799                 assign
     2800                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2801                 .
     2802               end.
     2803             end.
     2804             assign
     2805               v-diasize-browse-handle :width = v-browse-width
     2806             .
     2807             for each buf_temp-browse-handle
     2808               where buf_temp-browse-handle.browse-type = 'width':u
     2809             on error undo, next
     2810             :
     2811               assign
     2812                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2813               .
     2814             end.
     2815             assign
     2816               frame Dialog-Frame :width = v-frame-width
     2817             .
     2818             if frame Dialog-Frame :scrollable = true
     2819             then do:
     2820               assign
     2821                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2822               .
     2823             end.
     2824             run diasize_position-resize-button in this-procedure .
     2825           end.
     2826           else do:
     2827             if frame Dialog-Frame :scrollable = true
     2828             then do:
     2829               assign
     2830                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2831               .
     2832             end.
     2833             assign
     2834               frame Dialog-Frame :width = v-frame-width
     2835             .
     2836             for each buf_temp-browse-handle
     2837               where buf_temp-browse-handle.browse-type = 'width':u
     2838             on error undo, next
     2839             :
     2840               assign
     2841                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2842               .
     2843             end.
     2844             assign
     2845               v-diasize-browse-handle :width = v-browse-width
     2846             .
     2847             for each buf_temp-diasize-handle
     2848             on error undo, next
     2849             :
     2850               assign
     2851                 v-object-handle = buf_temp-diasize-handle.handle-value
     2852               .
     2853               if v-object-handle <> v-diasize-resize-button
     2854               then do:
     2855                 assign
     2856                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2857                 .
     2858               end.
     2859             end.
     2860             run diasize_position-resize-button in this-procedure .
     2861           end.
     2862           assign
     2863             v-diasize-change-size = false
     2864           .
     2865           leave move_block .
     2866         end.
     2867       end.
     2868       assign
     2869         v-diasize-need-full-display = true
     2870       .
     2871       if v-diasize-change-size = false
     2872       then do:
     2873         assign
     2874           v-diasize-change-size = true
     2875         .
     2876       end.
     2877       else do:
     2878         return .
     2879       end.
     2880       assign
     2881         v-frame-width = frame Dialog-Frame :width
     2882         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2883         v-browse-width = v-diasize-browse-handle :width
     2884       .
     2885       for each buf_temp-browse-handle
     2886         where buf_temp-browse-handle.browse-type = 'width':u
     2887       :
     2888         assign
     2889           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2890         .
     2891       end.
     2892       for each buf_temp-diasize-handle
     2893       :
     2894         delete buf_temp-diasize-handle .
     2895       end.
     2896       assign
     2897         v-field-group-handle = frame Dialog-Frame :first-child
     2898       .
     2899       do while valid-handle(v-field-group-handle)
     2900       :
     2901         assign
     2902           v-object-handle = v-field-group-handle :first-child
     2903         .
     2904         do while valid-handle(v-object-handle)
     2905         :
     2906           if  v-object-handle <> v-diasize-browse-handle :handle
     2907           and v-object-handle <> v-diasize-resize-button
     2908           and can-query(v-object-handle, "row")
     2909           and can-query(v-object-handle, "height")
     2910           and ( v-object-handle :col + v-object-handle :width
     2911                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2912               )
     2913           then do:
     2914             find first buf_temp-browse-handle
     2915               where buf_temp-browse-handle.browse-type   = 'width':u
     2916                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2917               no-error .
     2918             if available buf_temp-browse-handle
     2919             then do:
     2920             end.
     2921             else do:
     2922               create buf_temp-diasize-handle .
     2923               assign
     2924                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2925                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2926               .
     2927             end.
     2928           end.
     2929           assign
     2930             v-object-handle = v-object-handle :next-sibling
     2931           .
     2932         end.
     2933         assign
     2934           v-field-group-handle = v-field-group-handle :next-sibling
     2935         .
     2936       end.
     2937       do with frame Dialog-Frame
     2938       :
     2939         hide v-diasize-resize-button .
     2940         v-diasize-resize-button :row = 1.
     2941         v-diasize-resize-button :column = 1.
     2942       end.
     2943       if p-change-value > 0
     2944       then do:
     2945         if frame Dialog-Frame :scrollable = true
     2946         then do:
     2947           assign
     2948             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2949             no-error .
     2950           if error-status :error
     2951           or error-status :get-message(1) <> ""
     2952           then do:
     2953             undo move_block, retry move_block.
     2954           end.
     2955         end.
     2956         assign
     2957           frame Dialog-Frame :width = v-frame-width + p-change-value
     2958           no-error .
     2959         if error-status :error
     2960         or error-status :get-message(1) <> ""
     2961         then do:
     2962           undo move_block, retry move_block.
     2963         end.
     2964         assign
     2965           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2966         no-error .
     2967         if error-status :error
     2968         or error-status :get-message(1) <> ""
     2969         then do:
     2970           undo move_block, retry move_block.
     2971         end.
     2972         for each buf_temp-browse-handle
     2973           where buf_temp-browse-handle.browse-type = 'width':u
     2974         on error undo move_block, retry move_block
     2975         :
     2976           assign
     2977             buf_temp-browse-handle.browse-handle :width
     2978               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2979             no-error .
     2980           if error-status :error
     2981           or error-status :get-message(1) <> ""
     2982           then do:
     2983             undo move_block, retry move_block .
     2984           end.
     2985         end.
     2986         for each buf_temp-diasize-handle
     2987         on error undo move_block, retry move_block
     2988         :
     2989           assign
     2990             v-object-handle = buf_temp-diasize-handle.handle-value
     2991           .
     2992           if v-object-handle <> v-diasize-resize-button
     2993           then do:
     2994             assign
     2995               v-object-handle :col = v-object-handle :col + p-change-value
     2996               no-error .
     2997             if error-status :error
     2998             or error-status :get-message(1) <> ""
     2999             then do:
     3000               undo move_block, retry move_block .
     3001             end.
     3002           end.
     3003         end.
     3004       end.
     3005       else do:
     3006         for each buf_temp-diasize-handle
     3007         on error undo move_block, retry move_block
     3008         :
     3009           assign
     3010             v-object-handle = buf_temp-diasize-handle.handle-value
     3011           .
     3012           if v-object-handle <> v-diasize-resize-button
     3013           then do:
     3014             assign
     3015               v-object-handle :col = v-object-handle :col + p-change-value
     3016               no-error .
     3017             if error-status :error
     3018             or error-status :get-message(1) <> ""
     3019             then do:
     3020               undo move_block, retry move_block .
     3021             end.
     3022           end.
     3023         end.
     3024         for each buf_temp-browse-handle
     3025           where buf_temp-browse-handle.browse-type = 'width':u
     3026         on error undo move_block, retry move_block
     3027         :
     3028           assign
     3029             buf_temp-browse-handle.browse-handle :width
     3030               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3031             no-error .
     3032           if error-status :error
     3033           or error-status :get-message(1) <> ""
     3034           then do:
     3035             undo move_block, retry move_block .
     3036           end.
     3037         end.
     3038         assign
     3039           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3040           no-error .
     3041         if error-status :error
     3042         or error-status :get-message(1) <> ""
     3043         then do:
     3044           undo move_block, retry move_block.
     3045         end.
     3046         assign
     3047           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3048         no-error .
     3049         if error-status :error
     3050         or error-status :get-message(1) <> ""
     3051         then do:
     3052           undo move_block, retry move_block.
     3053         end.
     3054         if frame Dialog-Frame :scrollable = true
     3055         then do:
     3056           assign
     3057             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3058           no-error .
     3059           if error-status :error
     3060           or error-status :get-message(1) <> ""
     3061           then do:
     3062             undo move_block, retry move_block.
     3063           end.
     3064         end.
     3065       end.
     3066       if p-move-resize
     3067       then do:
     3068         run diasize_position-resize-button in this-procedure .
     3069       end.
     3070       if v-diasize-wndstore = true
     3071       then do:
     3072         if connected("ub") = true
     3073         then do:
     3074           define variable v-cntxt-db-num        as integer   no-undo .
     3075           define variable v-cntxt-userid        as character no-undo .
     3076           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3077                                             , OUTPUT v-cntxt-userid
     3078                                             ) .
     3079           run gbl/wndsizew.p
     3080             (input  v-cntxt-db-num
     3081             ,input  v-cntxt-userid
     3082             ,input  v-diasize-proc-name
     3083             ,input  'width':u
     3084             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3085             ) .
     3086         end.
     3087       end.
     3088     end.
     3089     assign
     3090       v-diasize-change-size = false
     3091     .
     3092   end procedure.
     3093   procedure diasize_set-width :
     3094     define input  parameter p-new-width  as decimal   no-undo .
     3095     define input  parameter p-move-resize as logical   no-undo .
     3096     do
     3097     on error undo, return error return-value
     3098     :
     3099       run diasize_change-width in this-procedure
     3100         (input  (p-new-width - frame Dialog-Frame :width)
     3101         ,input  p-move-resize
     3102         ) .
     3103     end.
     3104   end procedure.
     3105   procedure diasize_position-resize-button :
     3106     do with frame Dialog-Frame
     3107     :
     3108       hide v-diasize-resize-button .
     3109       assign
     3110         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3111                     - 1
     3112                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3113         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3114                     - 1
     3115                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3116       .
     3117       view v-diasize-resize-button .
     3118     end.
     3119   end procedure.
     3120   on alt-right anywhere
     3121   do:
     3122     run diasize_change-width in this-procedure
     3123       (input 1
     3124       ,input true
     3125       ) .
     3126     return no-apply .
     3127   end.
     3128   on alt-left anywhere
     3129   do:
     3130     run diasize_change-width in this-procedure
     3131       (input -1
     3132       ,input true
     3133       ) .
     3134     return no-apply .
     3135   end.
     3136   on alt-down anywhere
     3137   do:
     3138     run diasize_change-height in this-procedure
     3139       (input 1
     3140       ,input true
     3141       ) .
     3142     return no-apply .
     3143   end.
     3144   on alt-up anywhere
     3145   do:
     3146     run diasize_change-height in this-procedure
     3147       (input -1
     3148       ,input true
     3149       ) .
     3150     return no-apply .
     3151   end.
     3152   on alt-enter of frame Dialog-Frame
     3153   do:
     3154     run diasize_maximize in this-procedure
     3155       (input  ?
     3156       ).
     3157     return no-apply .
     3158   end.
     3159   procedure diasize_end-move :
     3160     do
     3161     on error undo, return error return-value
     3162     :
     3163       define variable v-row-delta as decimal   no-undo .
     3164       define variable v-col-delta as decimal   no-undo .
     3165       define variable v-new-row as decimal   no-undo .
     3166       define variable v-new-col as decimal   no-undo .
     3167       assign
     3168         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3169         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3170       .
     3171       assign
     3172         v-row-delta = v-new-row - frame Dialog-Frame :height
     3173         v-col-delta = v-new-col - frame Dialog-Frame :width
     3174       .
     3175       run diasize_change-height in this-procedure
     3176         (input v-row-delta
     3177         ,input true
     3178         ) .
     3179       run diasize_change-width in this-procedure
     3180         (input v-col-delta
     3181         ,input true
     3182         ) .
     3183     end.
     3184   end procedure.
     3185   procedure diasize_maximize :
     3186     define input  parameter p-action as logical   no-undo .
     3187     do
     3188     on error undo, return error return-value
     3189     :
     3190       if p-action = ?
     3191       then do:
     3192         if v-diasize-need-maximize = true
     3193         then do:
     3194           assign
     3195             p-action = true
     3196           .
     3197         end.
     3198         else do:
     3199           assign
     3200             p-action = false
     3201           .
     3202         end.
     3203       end.
     3204       if p-action = true
     3205       then do:
     3206         run diasize_change-height in this-procedure
     3207           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3208               - frame Dialog-Frame :height-chars
     3209           ,input true
     3210           ) .
     3211         run diasize_change-width in this-procedure
     3212           (input session :width-chars
     3213               - frame Dialog-Frame :width-chars
     3214           ,input true
     3215           ) .
     3216         assign
     3217           v-diasize-need-maximize = false
     3218         .
     3219       end.
     3220       else do:
     3221         run diasize_change-width in this-procedure
     3222           (input v-diasize-orig-frame-width
     3223               - frame Dialog-Frame :width-chars
     3224           ,input true
     3225           ) .
     3226         run diasize_change-height in this-procedure
     3227           (input v-diasize-orig-frame-height
     3228               - frame Dialog-Frame :height-chars
     3229           ,input true
     3230           ) .
     3231         assign
     3232           v-diasize-need-maximize = true
     3233         .
     3234       end.
     3235     end.
     3236   end procedure.
     3237   procedure diasize_restore-orig-size :
     3238     do
     3239     on error undo, return error return-value
     3240     :
     3241       assign
     3242         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3243         v-diasize-current-frame-height = frame Dialog-Frame :height
     3244       .
     3245       run diasize_set-height in this-procedure
     3246         (input  v-diasize-orig-frame-height
     3247         ,input  true
     3248         ) .
     3249       run diasize_set-width in this-procedure
     3250         (input  v-diasize-orig-frame-width
     3251         ,input  true
     3252         ) .
     3253     end.
     3254   end procedure.
     3255   procedure diasize_restore-current-size :
     3256     do
     3257     on error undo, return error return-value
     3258     :
     3259       run diasize_set-height in this-procedure
     3260         (input  v-diasize-current-frame-height
     3261         ,input  true
     3262         ) .
     3263       run diasize_set-width in this-procedure
     3264         (input  v-diasize-current-frame-width
     3265         ,input  true
     3266         ) .
     3267     end.
     3268   end procedure.
     3269   procedure diasize_set-browse-handle :
     3270     define input  parameter p-browse-handle as handle   no-undo .
     3271     define buffer buf_temp-browse-handle for temp-browse-handle .
     3272     do
     3273     on error undo, return error return-value
     3274     :
     3275       assign
     3276         v-diasize-browse-handle = p-browse-handle
     3277       .
     3278       for each buf_temp-browse-handle
     3279       on error undo, return error return-value
     3280       :
     3281         delete buf_temp-browse-handle .
     3282       end.
     3283     end.
     3284   end procedure.
     3285   procedure diasize_add_browse :
     3286     define input  parameter p-browse-type   as character no-undo .
     3287     define input  parameter p-browse-handle as handle    no-undo .
     3288     define buffer buf_temp-browse-handle for temp-browse-handle .
     3289     do
     3290     on error undo, return error return-value
     3291     :
     3292       assign
     3293         v-diasize-browse-number = v-diasize-browse-number + 1
     3294       .
     3295       create buf_temp-browse-handle .
     3296       assign
     3297         buf_temp-browse-handle.browse-type   = p-browse-type
     3298         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3299         buf_temp-browse-handle.browse-handle = p-browse-handle
     3300       .
     3301     end.
     3302   end procedure.
     3303   procedure diasize_init :
     3304     define variable v-default-value    as logical   no-undo .
     3305     define variable v-restore-saved    as logical   no-undo .
     3306     define variable v-resize-value-str as character no-undo .
     3307     do
     3308     on error undo, return error return-value
     3309     :
     3310       do with frame Dialog-Frame
     3311       :
     3312         assign
     3313           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3314           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3315           v-diasize-browse-handle     = browse BROWSE-2 :handle
     3316         .
     3317         create button v-diasize-resize-button
     3318         assign
     3319           parent        = frame Dialog-Frame :first-child
     3320           label         = "s"
     3321           height-pixels = 16
     3322           width-pixels  = 16
     3323           visible       = true
     3324           sensitive     = true
     3325           movable       = true
     3326           triggers:
     3327             on end-move persistent run diasize_end-move in this-procedure .
     3328           end triggers.
     3329         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3330         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3331         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3332         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3333         assign
     3334           v-diasize-wndmax = false
     3335         .
     3336         if connected("ub") = true
     3337         then do:
     3338           define variable v-cntxt-db-num        as integer   no-undo .
     3339           define variable v-cntxt-userid        as character no-undo .
     3340           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3341                                             , OUTPUT v-cntxt-userid
     3342                                             ) .
     3343           run gbl/wndpar_r.p
     3344             (input  v-cntxt-db-num
     3345             ,input  v-cntxt-userid
     3346             ,input  'wndmax':U
     3347             ,output v-diasize-wndmax
     3348             ,output v-default-value
     3349             ) .
     3350         end.
     3351         assign
     3352           v-diasize-wndstore = false
     3353         .
     3354         if connected("ub") = true
     3355         then do:
     3356           run gbl/wndpar_r.p
     3357             (input  v-cntxt-db-num
     3358             ,input  v-cntxt-userid
     3359             ,input  'wndstore':U
     3360             ,output v-diasize-wndstore
     3361             ,output v-default-value
     3362             ) .
     3363         end.
     3364         assign
     3365           v-diasize-proc-name = entry(1, program-name(2), '.')
     3366         .
     3367         if v-diasize-wndstore = true
     3368         then do:
     3369           assign
     3370             v-restore-saved = false
     3371           .
     3372           if connected("ub") = true
     3373           then do:
     3374             run gbl/wndsizer.p
     3375               (input  v-cntxt-db-num
     3376               ,input  v-cntxt-userid
     3377               ,input  v-diasize-proc-name
     3378               ,input  'height':u
     3379               ,output v-resize-value-str
     3380               ) .
     3381             if v-resize-value-str <> '':U
     3382             then do:
     3383               run diasize_change-height in this-procedure
     3384                 (input  integer(v-resize-value-str)
     3385                 ,input  true
     3386                 ) .
     3387               assign
     3388                 v-restore-saved = true
     3389               .
     3390             end.
     3391           end.
     3392           if connected("ub") = true
     3393           then do:
     3394             run gbl/wndsizer.p
     3395               (input  v-cntxt-db-num
     3396               ,input  v-cntxt-userid
     3397               ,input  v-diasize-proc-name
     3398               ,input  'width':u
     3399               ,output v-resize-value-str
     3400               ) .
     3401             if v-resize-value-str <> '':U
     3402             then do:
     3403               run diasize_change-width in this-procedure
     3404                 (input  integer(v-resize-value-str)
     3405                 ,input  true
     3406                 ) .
     3407               assign
     3408                 v-restore-saved = true
     3409               .
     3410             end.
     3411           end.
     3412           if v-restore-saved <> true
     3413           then do:
     3414             if v-diasize-wndmax = true
     3415             then do:
     3416               run diasize_maximize in this-procedure
     3417                 (input  true
     3418                 ) .
     3419             end.
     3420           end.
     3421         end.
     3422         else do:
     3423           if v-diasize-wndmax = true
     3424           then do:
     3425             run diasize_maximize in this-procedure
     3426               (input  true
     3427               ) .
     3428           end.
     3429         end.
     3430       end.
     3431     end.
     3432   end procedure.
     3433   procedure diasize_need-full-display :
     3434     define output parameter p-need-full-display as logical   no-undo .
     3435     do
     3436     on error undo, return error return-value
     3437     :
     3438       assign
     3439         p-need-full-display = v-diasize-need-full-display
     3440       .
     3441       assign
     3442         v-diasize-need-full-display = false
     3443       .
     3444     end.
     3445   end procedure.
     3446   procedure get-context :
     3447      define output parameter p-db-num as integer          no-undo.
     3448      define output parameter p-user-id as character        no-undo.
     3449      define variable v-login               as character    no-undo.
     3450      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3451      define buffer buf_user-login  for ub.user-login .
     3452      do
     3453      on error undo, return error
     3454      :
     3455            FIND FIRST buf_sys-ctrl no-lock.
     3456            ASSIGN
     3457               v-login = USERID("ub")
     3458               p-db-num = buf_sys-ctrl.db-num
     3459            .
     3460            FIND FIRST buf_user-login
     3461                 WHERE buf_user-login.db-num = p-db-num
     3462                   AND buf_user-login.user-login = v-login
     3463                 no-lock
     3464                 no-error
     3465                 .
     3466            IF AVAILABLE buf_user-login
     3467            THEN DO:
     3468               assign
     3469                  p-user-id = buf_user-login.user-id
     3470               .
     3471            END.
     3472      end.
     3473   end procedure.
     3474       run diasize_init in this-procedure .
     3475   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3476   DEF VAR cur-clmn-numBROWSE-2 as INT EXTENT 10 no-undo.
     3477   DEF VAR varmviBROWSE-2       as INT no-undo.
     3478   DEF VAR varmvjBROWSE-2       as INT no-undo.
     3479   DEF VAR varmvkBROWSE-2       as INT no-undo.
     3480   DEF VAR varmvlBROWSE-2       as INT no-undo.
     3481   DEF VAR move-elementBROWSE-2 as INT no-undo.
     3482   def var jjBROWSE-2           as int no-undo.
     3483   do varmviBROWSE-2 = 1 to EXTENT(cur-clmn-numBROWSE-2):
     3484     ASSIGN cur-clmn-numBROWSE-2[varmviBROWSE-2] = varmviBROWSE-2.
     3485   END.
     3486   RUN start-mv-clmnBROWSE-2.
     3487   PROCEDURE start-mv-clmnBROWSE-2:
     3488   def var old-session as logical no-undo.
     3489      old-session = SESSION:IMMEDIATE-DISPLAY.
     3490      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3491      SESSION:IMMEDIATE-DISPLAY = old-session.
     3492   END.
     3493   ON ctrl-cursor-right OF BROWSE BROWSE-2 do:
     3494     RUN re-move-clmnBROWSE-2 ( 1, 10).
     3495   END.
     3496   ON ctrl-cursor-left OF BROWSE BROWSE-2 do:
     3497     RUN re-move-clmnBROWSE-2 (10, 1).
     3498   END.
     3499   PROCEDURE re-move-clmnBROWSE-2:
     3500     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3501     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3502     DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     3503       if cur-clmn-numBROWSE-2[varmviBROWSE-2] = source-column THEN cur-clmn-numBROWSE-2[varmviBROWSE-2] = -1.
     3504     END.
     3505     if BROWSE-2:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3506     if source-column > target-column THEN
     3507     DO varmvjBROWSE-2 = source-column - 1 to target-column BY -1:
     3508       DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     3509           if cur-clmn-numBROWSE-2[varmviBROWSE-2] = varmvjBROWSE-2 THEN DO:
     3510             cur-clmn-numBROWSE-2[varmviBROWSE-2] = cur-clmn-numBROWSE-2[varmviBROWSE-2] + 1.
     3511           END.
     3512       END.
     3513     END.
     3514     ELSE
     3515     DO varmvjBROWSE-2 = source-column + 1 to target-column:
     3516       DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     3517         if cur-clmn-numBROWSE-2[varmviBROWSE-2] = varmvjBROWSE-2 THEN DO:
     3518           cur-clmn-numBROWSE-2[varmviBROWSE-2] = cur-clmn-numBROWSE-2[varmviBROWSE-2] - 1.
     3519         END.
     3520       END.
     3521     END.
     3522     DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     3523       if cur-clmn-numBROWSE-2[varmviBROWSE-2] = -1 THEN cur-clmn-numBROWSE-2[varmviBROWSE-2] = target-column.
     3524     END.
     3525   END PROCEDURE.
     3526   PROCEDURE ch-clmnBROWSE-2:
     3527     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3528     if cur-clmn-loc <= 1 then do:
     3529       return .
     3530     end.
     3531     DO varmviBROWSE-2 = 1 TO EXTENT(cur-clmn-numBROWSE-2):
     3532       if cur-clmn-numBROWSE-2[varmviBROWSE-2] = cur-clmn-loc THEN move-elementBROWSE-2 = varmviBROWSE-2.
     3533     END.
     3534     RUN re-move-clmnBROWSE-2 (cur-clmn-loc, 1).
     3535   END PROCEDURE.
     3536   PROCEDURE mv-brw-defaultBROWSE-2:
     3537   def var old-session as logical no-undo.
     3538     old-session = SESSION:IMMEDIATE-DISPLAY.
     3539     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3540     do varmvlBROWSE-2 = 1 to EXTENT(cur-clmn-numBROWSE-2):
     3541       RUN re-move-clmnBROWSE-2 (cur-clmn-numBROWSE-2[varmvlBROWSE-2], varmvlBROWSE-2).
     3542     END.
     3543     RUN start-mv-clmnBROWSE-2.
     3544     SESSION:IMMEDIATE-DISPLAY = old-session.
     3545   END PROCEDURE.
     3546   .
     3547   def var sort-labelBROWSE-2   as character no-undo .
     3548   def var sort-clmnBROWSE-2    as handle    no-undo .
     3549   def var cur-clmnBROWSE-2     as handle    no-undo .
     3550   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     3551   def var re-queryBROWSE-2     as logical   initial no no-undo .
     3552   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     3553      run sort-brBROWSE-2
     3554        (input (if available X_ord-line
     3555                then recid(X_ord-line)
     3556                else ?
     3557               )
     3558        ).
     3559   end.
     3560   PROCEDURE sort-brBROWSE-2 :
     3561     define input parameter p-recid as recid no-undo .
     3562     if re-queryBROWSE-2 = no then do:
     3563       assign
     3564          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     3565       .
     3566       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     3567       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     3568         assign
     3569            sort-labelBROWSE-2 = ""
     3570            sort-clmnBROWSE-2 = ?
     3571         .
     3572        end.
     3573        else do:
     3574          assign
     3575            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     3576            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     3577            sort-clmnBROWSE-2:column-fgcolor = 4
     3578          .
     3579        end.
     3580      end.
     3581     assign
     3582       cur-clmn-locBROWSE-2 = 1
     3583     .
     3584     def var column-handle as handle no-undo .
     3585     column-handle = BROWSE-2:first-column.
     3586     do while valid-handle(column-handle) :
     3587       if column-handle = cur-clmnBROWSE-2 then do:
     3588         leave .
     3589       end.
     3590       column-handle = column-handle:NEXT-COLUMN.
     3591       assign
     3592         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     3593       .
     3594     end.
     3595     case sort-labelBROWSE-2:
     3596           when 'N/п'  then DO:   assign     sort-column-name = "X_ord-line.line-num"   .   Run OpenBr.   . END.
     3597           when 'Код товара'  then DO:   assign     sort-column-name = "X_goods.gds-code"   .   Run OpenBr.   . END.
     3598           when 'Артикул'  then DO:   assign     sort-column-name = "X_ord-line.artic"   .   Run OpenBr.   . END.
     3599           when 'Название'  then DO:   assign     sort-column-name = "X_goods.gds-name"   .   Run OpenBr.   . END.
     3600           when 'Количество'  then DO:   assign     sort-column-name = "X_ord-line.qnty"   .   Run OpenBr.   . END.
     3601           when 'Цена(руб)'  then DO:   assign     sort-column-name = "X_ord-line.price-rubl"   .   Run OpenBr.   . END.
     3602           when 'Цена(вал)'  then DO:   assign     sort-column-name = "X_ord-line.price-base"   .   Run OpenBr.   . END.
     3603           when 'Сумма в вал.'  then DO:   assign     sort-column-name = "X_ord-line.sum-base"   .   Run OpenBr.   . END.
     3604           when 'Сумма в руб.'  then DO:   assign     sort-column-name = "X_ord-line.sum-rubl"   .   Run OpenBr.   . END.
     3605           when 'Текущий остаток'  then DO:   assign     sort-column-name = "v-fact-qnty"   .   Run OpenBr.   . END.
     3606       otherwise do:
     3607         assign
     3608           sort-column-name = ""
     3609         .
     3610         Run OpenBr.
     3611           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBROWSE-2') then do:
     3612             run mv-brw-defaultBROWSE-2.
     3613           end.
     3614         if sort-labelBROWSE-2 <> "" then do:
     3615           assign
     3616             cur-clmnBROWSE-2:column-fgcolor = 0
     3617           .
     3618         end.
     3619         assign
     3620           cur-clmn-locBROWSE-2 = ?
     3621         .
     3622       end.
     3623     end case.
     3624       if cur-clmn-locBROWSE-2 <> ? then do:
     3625         if can-do( this-procedure:internal-entries, 'ch-clmnBROWSE-2') then do:
     3626           run ch-clmnBROWSE-2 in this-procedure (cur-clmn-locBROWSE-2).
     3627         end.
     3628       end.
     3629     if p-recid <> ? then do:
     3630       reposition BROWSE-2 to recid p-recid no-error.
     3631       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     3632     end.
     3633     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     3634   END PROCEDURE.
     3635   procedure re-open-query-srt-clmnBROWSE-2:
     3636   if cur-clmnBROWSE-2 = ? then do:
     3637      Run OpenBr.
     3638   end.
     3639   else do:
     3640      assign re-queryBROWSE-2 = yes.
     3641      run sort-brBROWSE-2
     3642        (input (if available X_ord-line
     3643                then recid(X_ord-line)
     3644                else ?
     3645               )
     3646        ).
     3647      assign re-queryBROWSE-2 = no.
     3648   end.
     3649   end.
     3650   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3651   on F9 of frame Dialog-Frame anywhere do:
     3652     run init-gds-rec.
     3653     if gds-rec = ? then
     3654       return no-apply.
     3655     run ref/gds-form.w ( input parParentProc
     3656                         ,input 'ПРОСМОТР':U
     3657                         ,input ?
     3658                         ,input ?
     3659                         ,input ?
     3660                         ,input-output gds-rec).
     3661     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     3662     return no-apply.
     3663   end.
     3664   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3665   ON CHOOSE OF r-boss IN FRAME Dialog-Frame
     3666   DO:
