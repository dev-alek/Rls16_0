     1528   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1529   on ' ' of scr-ship-date in frame Dialog-Frame
     1530   do:
     1531     if (can-query (self, "sensitive")
     1532        and
     1533        self :sensitive = true
     1534        )
     1535     or (can-query (self, "read-only")
     1536        and
     1537        self :read-only = false
     1538        )
     1539     then do:
     1540       assign
     1541         self :screen-value = ?
     1542       .
     1543     end.
     1544     return no-apply.
     1545   end.
     1546   on delete-character of scr-ship-date in frame Dialog-Frame
     1547   do:
     1548     if (can-query (self, "sensitive")
     1549        and
     1550        self :sensitive = true
     1551        )
     1552     or (can-query (self, "read-only")
     1553        and
     1554        self :read-only = false
     1555        )
     1556     then do:
     1557       assign
     1558         self :screen-value = ?
     1559       .
     1560     end.
     1561     return no-apply.
     1562   end.
     1563   on ctrl-d of scr-ship-date in frame Dialog-Frame
     1564   do:
     1565     define variable v-curr-sv-date as date no-undo .
     1566     if (can-query (self, "sensitive")
     1567        and
     1568        self :sensitive = true
     1569        )
     1570     or (can-query (self, "read-only")
     1571        and
     1572        self :read-only = false
     1573        )
     1574     then do:
     1575       if self :handle <> focus :handle
     1576       then do:
     1577         apply "entry":u to self .
     1578       end.
     1579       run gbl/getcurdt.p
     1580         (output v-curr-sv-date
     1581         ) .
     1582       assign
     1583         self :screen-value = string(v-curr-sv-date) .
     1584       .
     1585     end.
     1586     return no-apply.
     1587   end.
     1588   on ctrl-b of scr-ship-date in frame Dialog-Frame
     1589   do:
     1590     if (can-query (self, "sensitive")
     1591        and
     1592        self :sensitive = true
     1593        )
     1594     or (can-query (self, "read-only")
     1595        and
     1596        self :read-only = false
     1597        )
     1598     then do:
     1599       if self :handle <> focus :handle
     1600       then do:
     1601         apply "entry":u to self .
     1602       end.
     1603       define variable v-curr-sv-date as date no-undo .
     1604       define variable v-new-sv-date  as date no-undo .
     1605       assign
     1606         v-curr-sv-date = date(self :screen-value) no-error
     1607       .
     1608       if v-curr-sv-date = ?
     1609       then do:
     1610         run gbl/getcurdt.p
     1611           (output v-curr-sv-date
     1612           ) .
     1613       end.
     1614       if v-curr-sv-date <> ?
     1615       then do:
     1616         assign
     1617           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1618         .
     1619         assign
     1620           self :screen-value = string(v-new-sv-date) .
     1621         .
     1622       end.
     1623     end.
     1624     return no-apply .
     1625   end.
     1626   on ctrl-e of scr-ship-date in frame Dialog-Frame
     1627   do:
     1628     if (can-query (self, "sensitive")
     1629        and
     1630        self :sensitive = true
     1631        )
     1632     or (can-query (self, "read-only")
     1633        and
     1634        self :read-only = false
     1635        )
     1636     then do:
     1637       if self :handle <> focus :handle
     1638       then do:
     1639         apply "entry":u to self .
     1640       end.
     1641       define variable v-curr-sv-date as date no-undo .
