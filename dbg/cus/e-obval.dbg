     1312     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1313     RUN broker-get-attribute IN adm-broker-hdl
     1314         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1315     RETURN RETURN-VALUE.
