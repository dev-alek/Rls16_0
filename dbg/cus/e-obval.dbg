     1442   PROCEDURE adm-reset-record :
     1443       RETURN.
     1444   END PROCEDURE.
     1445   PROCEDURE adm-update-record :
     1446       MESSAGE
     1447         "Object ":U THIS-PROCEDURE:FILE-NAME
     1448           "must have at least one Enabled Table to perform Update.":U
     1449             VIEW-AS ALERT-BOX ERROR.
     1450      RETURN.
     1451   END PROCEDURE.
     1452   PROCEDURE check-modified :
     1453   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1454   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1455   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1456   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1457     IF check-state = "check":U THEN
     1458     DO:
     1459       RUN get-link-handle IN adm-broker-hdl
     1460         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1461            OUTPUT group-target-list).
     1462       IF group-target-list NE "":U THEN
     1463       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1464         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1465         RUN check-modified IN curr-widget ('group-check':U).
     1466         IF RETURN-VALUE NE "":U THEN
     1467         DO:
     1468           RUN check-modified-message(RETURN-VALUE).
     1469           RETURN "":U.
     1470         END.
     1471       END.
     1472     END.
     1473     RETURN "":U.
     1474   END PROCEDURE.
     1475   PROCEDURE check-modified-message :
     1476     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1477        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1478           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1479        IF RETURN-VALUE = "YES":U THEN
     1480           RUN notify ('view,CONTAINER-SOURCE':U).
     1481        MESSAGE IF p-changed-table NE ? THEN
     1482           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1483           ELSE "Current values have been changed."
     1484           SKIP "  Do you wish to save those changes?"
     1485           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1486        IF ANS THEN
     1487        DO:
     1488           IF group-assign-target THEN
     1489             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1490           ELSE RUN dispatch('update-record':U).
     1491           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1492           DO:
     1493               MESSAGE "Changes to the previous record were not saved."
     1494                 VIEW-AS ALERT-BOX ERROR.
     1495               IF group-assign-target THEN
     1496                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1497               ELSE RUN dispatch ('cancel-record':U).
     1498           END.
     1499        END.
     1500        ELSE DO:
     1501          IF group-assign-target THEN
     1502             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1503          ELSE RUN dispatch('cancel-record':U).
     1504        END.
     1505        RETURN.
     1506   END PROCEDURE.
     1507   PROCEDURE get-rowid :
     1508       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1509       ASSIGN
     1510       p-table   =   adm-first-table.
     1511       RETURN.
     1512   END PROCEDURE.
     1513   PROCEDURE init-group-assign :
     1514       RUN request-attribute IN adm-broker-hdl
     1515         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1516       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1517         group-assign-target = yes.
     1518       ELSE group-assign-target = no.
     1519       RETURN.
     1520   END PROCEDURE.
     1521   PROCEDURE set-editors :
     1522       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1523       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1524       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1525       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1526       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1527       DO WHILE VALID-HANDLE (curr-widget):
     1528           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1529              curr-widget:HIDDEN = no THEN DO:
     1530             CASE p-field-setting:
     1531               WHEN "INITIALIZE":U THEN
     1532               DO:
     1533                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1534                     read-only-list +
     1535                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1536                        STRING(curr-widget).
     1537               END.
     1538               WHEN "DISABLE":U OR
     1539               WHEN "ENABLE":U THEN
     1540               DO:
     1541                   curr-widget:SENSITIVE = yes.
     1542                   RUN get-attribute ('Read-Only-Editors':U).
     1543                   IF RETURN-VALUE = ? OR
     1544                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1545                       curr-widget:READ-ONLY =
     1546                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1547               END.
     1548               WHEN "CLEAR":U THEN
     1549                   curr-widget:SCREEN-VALUE = "":U.
     1550             END CASE.
     1551           END.
     1552           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1553       END.
     1554       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1555         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1556           + '"':U).
     1557       RETURN.
     1558   END PROCEDURE.
     1559   PROCEDURE use-check-modified-all :
     1560    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1561     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1562     RETURN.
     1563   END PROCEDURE.
     1564   PROCEDURE use-create-on-add :
     1565   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1566      RETURN.
     1567   END PROCEDURE.
     1568   PROCEDURE use-initial-lock :
     1569     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1570     ASSIGN adm-initial-lock = p-attr-value.
     1571     RETURN.
     1572   END PROCEDURE.
     1573     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1574   ASSIGN
     1575          FRAME F-Main:SCROLLABLE       = FALSE
     1576          FRAME F-Main:HIDDEN           = TRUE.
     1577   ASSIGN
     1578          b-valp:HIDDEN IN FRAME F-Main           = TRUE.
     1579   ASSIGN
     1580          E-post:READ-ONLY IN FRAME F-Main        = TRUE.
     1581   ASSIGN
     1582          F-val:HIDDEN IN FRAME F-Main           = TRUE.
     1583   ASSIGN
     1584          F-val-name:HIDDEN IN FRAME F-Main           = TRUE.
     1585   ON CHOOSE OF b-valp IN FRAME F-Main
     1586   DO:
     1587   define variable v-ref-rec as recid no-undo .
     1588   find first buf_currency no-lock where
     1589             buf_currency.curr-code = f-val no-error.
     1590   if available buf_currency then do:
     1591     assign
     1592     v-ref-rec = recid(buf_currency)
     1593     .
     1594   end.
     1595   else do:
     1596     assign
     1597     v-ref-rec = ?.
     1598   end.
     1599   run ref/currency.w (input my-handle, INPUT "b-sel", INPUT-OUTPUT v-ref-rec ).
     1600   apply "ENTRY" to self .
     1601   if v-ref-rec = ? then do:
     1602       assign
     1603       F-val  = ?
     1604       F-val-name = "?"
     1605       .
     1606       display
     1607       F-val
     1608       F-val-name
     1609       with frame F-Main.
     1610       return no-apply.
     1611   end.
     1612   else do:
     1613       FIND FIRST Buf_currency No-LOCK WHERE
     1614                   recid( buf_currency ) = v-ref-rec NO-ERROR .
     1615       assign
     1616       F-val  = buf_currency.curr-code
     1617       F-val-name = buf_currency.curr-abbr
     1618       .
     1619       display
     1620       F-val
     1621       F-val-name
     1622       with frame F-Main.
     1623   end.
     1624   END.
     1625   ON CHOOSE OF button-prod IN FRAME F-Main
     1626   DO:
     1627       run str/cli-list.w (my-handle, v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code).
     1628       E-post:screen-value = "".
     1629       for each cli-list:
     1630           assign
     1631           E-post:screen-value = E-post:screen-value + cli-list.obj-name + chr(10) .
     1632       end.
     1633   END.
     1634   ON LEAVE OF F-val IN FRAME F-Main
     1635   DO:
     1636   define buffer buf_currency for ub.currency.
     1637     assign
     1638     F-val.
     1639     FIND FIRST buf_currency No-LOCK WHERE
     1640                buf_currency.curr-code = F-val No-ERROR.
     1641     IF AVAIL buf_currency then do:
     1642       assign
     1643       F-val-name = buf_currency.curr-abbr.
     1644       DISPLAY
     1645       F-val
     1646       F-val-name
     1647       with frame F-Main
     1648       .
     1649     end.
     1650     else do:
     1651       APPLY "CHOOSE" to b-valp.
     1652     end.
     1653   END.
     1654   ON VALUE-CHANGED OF R-curr IN FRAME F-Main
     1655   DO:
     1656     assign r-curr.
     1657     CASE r-curr:
     1658       when 0 then do:
     1659           DISABLE
     1660           b-valp F-val F-val-name
     1661           with frame F-Main.
     1662           HIDE
     1663           b-valp F-val F-val-name
     1664           IN frame F-Main.
     1665       end.
     1666       when 1 then do:
     1667           ENABLE
     1668           b-valp F-val F-val-name
     1669           with frame F-Main.
     1670       end.
     1671     END CASE.
     1672   END.
     1673   if not this-procedure :persistent
     1674   then do:
     1675     message
     1676       vss-workfile vss-revision vss-description skip
     1677       "Ошибка при запуске процедуры" skip
     1678       "Данную процедуру следует запускать только с параметром persistent" skip
     1679       view-as alert-box error .
     1680     undo, return error .
     1681   end.
     1682   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683     run mainmenu_getcntxt in my-handle
     1684       (output v-cntxt-db-num
     1685       ,output v-cntxt-userid
     1686       ,output v-cntxt-level
     1687       ,output v-cntxt-host-code-obj
     1688       ,output v-cntxt-obj-type
     1689       ,output v-cntxt-obj-code
     1690       ,output v-cntxt-db-num-obj
     1691       ,output v-cntxt-is-admin
     1692       ) .
     1693   PROCEDURE adm-row-available :
     1694     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1695     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1696     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1697     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1698     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1699     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1700     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1701     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1702     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1703     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1704     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1705     IF adm-updating-record THEN RETURN.
     1706     RUN get-attribute ('FIELDS-ENABLED':U).
     1707     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1708     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1709         OUTPUT link-handle) NO-ERROR.
     1710     IF link-handle = "":U THEN
     1711         RETURN.
     1712     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1713     IF NUM-ENTRIES(link-handle) > 1 THEN
     1714         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1715             "encountered more than one RECORD-SOURCE.":U SKIP
     1716             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1717                VIEW-AS ALERT-BOX ERROR.
     1718     RUN get-attribute ('Key-Name':U).
     1719     key-name = RETURN-VALUE.
     1720     IF key-name = "":U THEN key-name = ?.
     1721     IF key-name NE ? THEN DO:
     1722       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1723         NO-ERROR.
     1724       IF key-value NE ? THEN
     1725         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1726     END.
     1727   IF VALID-HANDLE (adm-object-hdl) THEN
     1728       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1729   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1730   END PROCEDURE.
     1731   PROCEDURE disable_UI :
     1732     HIDE FRAME F-Main.
     1733     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1734   END PROCEDURE.
     1735   PROCEDURE local-initialize :
     1736     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1737     APPLY "VALUE-CHANGED" TO r-curr in frame F-Main.
     1738   END PROCEDURE.
     1739   PROCEDURE My-report :
     1740   define variable vnum-obj as integer no-undo.
     1741   define variable v-frame-width as integer no-undo.
     1742   run My-var in this-procedure .
     1743   if r-curr = 1 then do:
     1744       if not avail buf_currency or f-val = ? or f-val-name = "?" then do:
     1745           Message "Не выбрана валюта  поставки!"
     1746           view-as alert-box ERROR.
     1747           return.
     1748       end.
     1749   end.
     1750   find first cli-list No-ERROR.
     1751   if not avail cli-list then do:
     1752       message "Не выбрано ни одного поставщика!"
     1753       view-as alert-box ERROR.
     1754       return.
     1755   end.
     1756   FOR EACH obj-list No-LOCK:
     1757     assign
     1758     vnum-obj = vnum-obj + 1
     1759     .
     1760     if vnum-obj > 1 then LEAVE.
     1761   END.
     1762   run cus/r-obval.p (
     1763                  input my-handle
     1764                 ,input      (if r-curr = 1 then f-val else ?),
     1765                        vnum-obj) no-error  .
     1766   run cus/p-obval.p (input my-handle,
     1767                 input (if r-curr = 1 then f-val else ?),
     1768                 input vnum-obj,
     1769                 input (X-selectobject = 'все':U),
     1770                 input ReportHeader,
     1771                 output v-frame-width) no-error.
     1772   if v-frame-width <= 198 then do:
     1773     if v-frame-width <= 136
     1774     then
     1775     run prn-lib-prn-file in this-procedure (
     1776                                               input my-handle
     1777                                               ,input 0
     1778                                               ).
     1779     else
     1780     run prn-lib-prn-file in this-procedure (
     1781                                               input my-handle
     1782                                               ,input 8
     1783                                               ).
     1784   end.
     1785   else do:
     1786       if v-frame-width <= 232 then
     1787       run prn-lib-prn-file in this-procedure (
     1788                                                 input my-handle
     1789                                                 ,input 1
     1790                                                 ).
     1791       else
     1792       run prn-lib-prn-file in this-procedure (
     1793                                                 input my-handle
     1794                                                 ,input 20
     1795                                                 ).
     1796   end.
     1797   END PROCEDURE.
     1798   PROCEDURE My-var :
     1799   Assign
     1800   r-curr frame F-Main
     1801   T-part-code T-price-brutto T-price-netto T-qnty-all T-slt T-terms T-VAT
     1802   f-val
     1803   E-post
     1804   use-column[5] = T-terms
     1805   use-column[6] = T-part-code
     1806   use-column[10] = T-price-brutto
     1807   use-column[11] = T-vat
     1808   use-column[12] = T-slt
     1809   use-column[13] = T-price-netto
     1810   use-column[14] = T-qnty-all
     1811    STR-obj-type = ''
     1812    STR-obj-code = ''
     1813    STR-obj-name = ''
     1814    STR-obj      = ''.
     1815   ReportNAme = "Оборот в валюте поставщика".
     1816   ReportHeader =  (if (frame F-Main r-curr = 1 )
     1817                   then
     1818                   ("Валюта  поставки:  " + F-val-name + chr(10))
     1819                   else ""
     1820                  ) +
     1821                  "Поставщики: " + chr(10) + E-post
     1822                  .
     1823   END PROCEDURE.
     1824   PROCEDURE send-records :
     1825   END PROCEDURE.
     1826   PROCEDURE state-changed :
     1827     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1828     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1829     CASE p-state:
     1830       WHEN 'update-begin':U THEN DO:
     1831           RUN dispatch('enable-fields':U).
     1832           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1833           DO:
     1834             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1835             RUN new-state('update-complete':U).
     1836           END.
     1837           ELSE RUN new-state ('update':U).
     1838       END.
     1839       WHEN 'update-complete':U THEN DO:
     1840           RUN new-state ('update-complete':U).
     1841       END.
     1842     END CASE.
     1843   END PROCEDURE.
