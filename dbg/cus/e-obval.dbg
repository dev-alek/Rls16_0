      615   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616   define  stream PrnLibStream.
      617   procedure prn-lib-prn-file :
      618     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      619     define input parameter p-DIsabledoptions as integer no-undo .
      620     define variable v-report-name as character no-undo .
      621     define variable v-user-action as character no-undo .
      622     define variable v-printed     as logical   no-undo .
      623     define variable v-exist       as logical   no-undo .
      624     do
      625       on error undo, return error
      626       :
      627       run prn-lib-get-report-name  in this-procedure (
      628         input parParentProc
      629         ,output v-report-name
      630         ).
      631   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      633     (input  v-report-name
      634     ,input  2
      635     ,output v-exist
      636     )  .
      637       if NOT v-exist then
      638       DO:
      639         Message
      640           "Нет заданий на печать ! "
      641           view-as alert-box .
      642         Return  .
      643       End.
      644       run gbl/prnfilen.w
      645         (input  ""
      646         ,input  p-DisabledOptions
      647         ,input  string(v-report-name )
      648         ,input  7
      649         ,output v-user-action
      650         ,output v-printed
      651         ) .
      652       if v-printed then
      653       do:
      654         return "YES" .
      655       end.
      656       else
      657       do:
      658         return "NO" .
      659       end.
      660     end.
      661   end procedure.
      662   procedure prn-lib-open-stream :
      663     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      664     define input parameter p-page-size    as integer no-undo .
      665     define input parameter p-is-stream    as logical no-undo .
      666     define input parameter p-append       as logical no-undo .
      667     define variable v-report-name as character no-undo .
      668     do
      669       on error undo, return error
      670       :
      671       run prn-lib-get-report-name  in this-procedure (
      672         input parParentProc
      673         ,output v-report-name
      674         ).
      675       if p-is-stream then
      676       do:
      677         if p-append then
      678         do:
      679           output stream PrnLibStream to value( v-report-name )
      680             page-size value(p-page-size) append .
      681         end.
      682         if not p-append then
      683         do:
      684           output stream PrnLibStream to value( v-report-name )
      685             page-size value(p-page-size) .
      686         end.
      687       end.
      688       if not p-is-stream then
      689       do:
      690         if p-append then
      691         do:
      692           output to value( v-report-name )
      693             page-size value(p-page-size) append .
      694         end.
      695         if not p-append then
      696         do:
      697           output to value( v-report-name )
      698             page-size value(p-page-size) .
      699         end.
      700       end.
      701     end.
      702   end procedure.
      703   procedure prn-lib-open-exp :
      704     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      705     define input parameter p-is-stream    as logical no-undo .
      706     define input parameter p-is-append    as logical no-undo .
      707     define output parameter p-ReportFileName as char init "report" no-undo.
      708     define output parameter p-process as logical no-undo .
      709     define variable glog as logical no-undo .
      710     do
      711       on error undo, return error
      712       :
      713       SYSTEM-DIALOG GET-FILE p-ReportFileName
      714         TITLE      "Укажите путь"
      715         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      716         ASK-OVERWRITE
      717         CREATE-TEST-FILE
      718         SAVE-AS
      719         USE-FILENAME
      720         DEFAULT-EXTENSION "txt"
      721         UPDATE glog
      722         .
      723       if not glog then  return.
      724       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      725       if p-is-stream then
      726       do:
      727         if p-is-append then
      728         do:
      729           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      730         end.
      731         else
      732         do:
      733           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      734         end.
      735       end.
      736       else
      737       do:
      738         if p-is-append then
      739         do:
      740           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      741         end.
      742         else
      743         do:
      744           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      745         end.
      746       end.
      747       p-process = yes.
      748     end.
      749   end procedure.
      750   procedure prn-lib-get-report-name :
      751     define input parameter parParentProc  as widget-handle no-undo.
      752     define output parameter p-report-name as character no-undo .
      753     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      754   end procedure.
      755   procedure prn-lib-reportviewer-report-name :
      756     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      757     define input parameter p-report-name-html as character no-undo .
      758     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      759   end procedure.
      760   procedure prn-lib-reportviewer :
      761     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      762     define input parameter p-report-name-html as character no-undo .
      763     define input parameter p-param        as character no-undo .
      764     define variable v-excel           as character no-undo init 'TRUE' .
      765     define variable v-value-character as character no-undo .
      766     define variable v-value-integer   as character no-undo .
      767     define variable v-value-date      as date      no-undo .
      768     define variable v-value-decimal   as decimal   no-undo .
      769     define variable rep-excel         as logical   no-undo .
      770     define variable excel-string      as character no-undo .
      771     define variable v-param-type      as character no-undo .
      772     define variable v-tth             as handle    no-undo .
      773     run adm/shattri.p (
      774       input "get":U
      775       ,input  ""
      776       ,input  0
      777       ,input  'report-glob':U
      778       ,input  'rep-excel':U
      779       ,output v-value-character
      780       ,output v-value-date
      781       ,output v-value-decimal
      782       ,output v-value-integer
      783       ,output rep-excel
      784       ,output v-param-type
      785       ,INPUT-OUTPUT table-handle v-tth
      786       )  .
      787     if rep-excel then v-excel = "TRUE" .
      788     else v-excel = "FALSE" .
      789     if p-param eq ""
      790     then
      791        p-param = "EXCEL:" + v-excel.
      792     else
      793        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      794     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      795   end procedure.
