     1372     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1373     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1374     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1375     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1376     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1377     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1378     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1379     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1380     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1381     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1382     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1383     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1384     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1385     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1386     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1387     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1388     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1389     IF "":U = "":U THEN
     1390       RUN modify-list-attribute IN adm-broker-hdl
     1391         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1392     RUN use-create-on-add(?).
     1393   PROCEDURE adm-add-record :
     1394       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1395          "must have at least one Enabled Table to perform Add.":U
     1396          VIEW-AS ALERT-BOX ERROR.
     1397       RETURN.
     1398   END PROCEDURE.
     1399   PROCEDURE adm-assign-record :
     1400    MESSAGE
     1401          "Object ":U THIS-PROCEDURE:FILE-NAME
     1402            "must have at least one Enabled Table to perform Assign.":U
     1403              VIEW-AS ALERT-BOX ERROR.
     1404      RETURN.
     1405     END PROCEDURE.
     1406   PROCEDURE adm-assign-statement :
     1407     RETURN.
     1408   END PROCEDURE.
     1409   PROCEDURE adm-cancel-record :
     1410      RETURN.
     1411     END PROCEDURE.
     1412   PROCEDURE adm-copy-record :
     1413       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1414        "must have at least one Enabled Table to perform Copy.":U
     1415          VIEW-AS ALERT-BOX ERROR.
     1416       RETURN.
     1417   END PROCEDURE.
     1418   PROCEDURE adm-create-record :
     1419      RETURN.
     1420   END PROCEDURE.
     1421   PROCEDURE adm-current-changed :
     1422     RETURN.
     1423   END PROCEDURE.
     1424   PROCEDURE adm-delete-record :
     1425    MESSAGE
     1426          "Object ":U THIS-PROCEDURE:FILE-NAME
     1427            "must have at least one Enabled Table to perform Delete.":U
     1428              VIEW-AS ALERT-BOX ERROR.
     1429       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1430       RETURN.
     1431   END PROCEDURE.
     1432   PROCEDURE adm-disable-fields :
     1433         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
