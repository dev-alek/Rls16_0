     1325   PROCEDURE new-state :
     1326     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1327     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1328     RETURN.
     1329   END PROCEDURE.
     1330   PROCEDURE notify :
     1331     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1332     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1333     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1334         RETURN "ADM-ERROR":U.
     1335     RETURN.
     1336   END PROCEDURE.
     1337   PROCEDURE set-attribute-list :
     1338     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1339     RUN ensure-broker.
     1340     RUN broker-set-attribute-list IN adm-broker-hdl
     1341         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1342     RETURN.
