     1224   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1225   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1226   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1227   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
