     1303   PROCEDURE ensure-broker :
     1304   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1305   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1306   DO:
     1307       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1308       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1309   END.
     1310   END PROCEDURE.
