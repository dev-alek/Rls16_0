     1231   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1232         adm-object-hdl = FRAME F-Main:HANDLE.
     1233   RUN ensure-broker.
     1234   THIS-PROCEDURE:ADM-DATA =
     1235        'ADM1.1~`':U +
     1236        'SmartObject~`':U +
     1237        '~`':U +
     1238        'NO ~`':U +
     1239        '~`':U +
     1240        '~`':U +
     1241        '~`':U +
     1242        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1243           + "~`":U +
     1244        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1245        'Record-Source,Record-Target,TableIO-Target~`':U +
     1246        '~`':U +
     1247        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1248        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1249            THEN "^^":U
     1250        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1251             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1252   PROCEDURE adm-apply-entry :
     1253     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
