     1326     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1327     define variable v-cntxt-is-admin      as logical   no-undo .
     1328   procedure proc-alt-shift-f2:
     1329     if not ibs.th.gbl.gbl-var:rcode
     1330   then
     1331     run gbl\inidebug.p .
     1332   end.
     1333   procedure proc-alt-shift-f3:
     1334     run gbl/prvssinf.p
     1335       ( input this-procedure
     1336       ) .
     1337   end.
     1338   define variable v-inform-launched as logical no-undo initial false .
     1339   procedure proc-alt-shift-f4:
     1340     define variable v-action as character no-undo .
     1341     if v-inform-launched = false then do:
     1342       assign
     1343         v-inform-launched = true
     1344       .
     1345       run gbl/d-inform.w
     1346         (  input self
     1347         ,  input this-procedure
     1348         , output v-action
     1349         ) no-error .
     1350       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1351       assign
     1352         v-inform-launched = false
     1353       .
     1354     end.
     1355   end.
     1356   procedure proc-alt-f1:
     1357     run gbl/corrhelp.p
     1358       (input this-procedure
     1359       ) .
     1360   end .
     1361   on alt-shift-f2 anywhere do:
     1362     run proc-alt-shift-f2.
     1363   end.
     1364   on alt-shift-f3 anywhere do:
     1365     run proc-alt-shift-f3 in this-procedure .
     1366   end.
     1367   on alt-shift-f4 anywhere do:
     1368     run proc-alt-shift-f4 in this-procedure.
     1369   end.
     1370   on alt-f1 anywhere do:
     1371     run proc-alt-f1 in this-procedure .
     1372   end.
     1373   define variable Line                as      char    no-undo.
     1374   define variable date_string     as      char    no-undo.
     1375   define variable     choice               as      logical     no-undo.
     1376   define variable     DatePrinted      as      logical     no-undo.
     1377   define variable     FrameType      as      char        no-undo.
     1378   DEFINE VARIABLE RS-By AS INTEGER
     1379        VIEW-AS RADIO-SET VERTICAL
     1380        RADIO-BUTTONS
     1381             "Расход и возврат", 1,
     1382   "Расход", 2,
     1383   "Возврат от покупателя", 3,
     1384   "Списание", 4,
