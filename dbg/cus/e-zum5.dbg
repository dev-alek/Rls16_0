      803   define variable var-report-r-b as character no-undo .
      804   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      806     (output var-report-r-b
      807     )  .
      808   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   define variable v-waitfram-action01         as character   no-undo .
      810   define variable v-waitfram-action02         as character   no-undo .
      811   define variable v-waitfram-action03         as character   no-undo .
      812   define variable mWaitFramTextBeg            as character   no-undo.
      813   define variable mWaitFramTextEnd            as character   no-undo.
      814   define variable mWaitFramView               as logical     no-undo.
      815   define variable mWaitProcEvent              as logical     no-undo init yes.
      816   define variable mWaitFramInterval           as integer     no-undo init 1 .
      817   define variable mWaitFramStop               as logical     no-undo.
      818   define variable mWaitFramStopUser           as logical     no-undo.
      819   define variable mWaitFramStopTimeOut        as logical     no-undo.
      820   define variable mWaitFramStartProc          as datetime-tz no-undo.
      821   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      822   define button B-WaitFramStop auto-end-key
      823        label "Стоп"
      824        size 10 by 1 tooltip "Остоновить процесс".
      825   define button B-viewProcInfo
      826        label "Информация"
      827        size 15 by 1 tooltip "Информация о процесс".
      828   define frame waitfram
      829     v-waitfram-action01 format "x(72)" no-label skip
      830     v-waitfram-action02 format "x(72)" no-label skip
      831     v-waitfram-action03 format "x(72)" no-label skip
      832     B-viewProcInfo
      833     B-WaitFramStop at row 4 col 30
      834     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      835     .
      836   define new global shared variable mBatchMode as logical no-undo init ?.
      837   define variable mFramBachModHandle as handle no-undo.
      838   mFramBachModHandle = frame waitfram:handle.
      839   define variable mFameOldVis as logical no-undo.
      840   define variable mVisCUrentVin as logical no-undo.
      841   if session:batch-mode
      842   then
      843      mBatchMode = yes.
      844   if mBatchMode = ? then do:
      845     mVisCUrentVin = current-window:visible.
      846     mFameOldVis = mFramBachModHandle:visible.
      847     mFramBachModHandle:visible  = yes.
      848     mBatchMode = mFramBachModHandle:visible ne yes.
      849     mFramBachModHandle:visible = mFameOldVis.
      850     current-window:visible = mVisCUrentVin.
      851   end.
      852    if  log-manager:logfile-name ne ?
      853     then DO:
      854         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      855         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      856         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      857     end.
      858   on choose of B-WaitFramStop in frame waitfram
      859   do:
      860     mWaitFramStop = yes.
      861     mWaitFramStopUser = yes.
      862   end.
      863   function waitfram-check-timeout returns logical():
      864      define variable vtime as int64 no-undo.
      865      if mWaitFramStopTimeOut
      866      then
      867         return yes.
      868      vtime = ( now - mWaitFramStartProc ) / 1000 .
      869      if     mWaitFramTimeOut ne ?
      870         and mWaitFramTimeOut ne 0
      871         and mWaitFramTimeOut lt vtime
      872      then do:
      873         mWaitFramStopTimeOut = yes.
      874      end.
      875      return mWaitFramStopTimeOut.
      876   end.
      877   procedure waitfram-hide :
      878     if not session:batch-mode
      879     then do
      880     on error undo, return error return-value
      881     :
      882       pause 0 before-hide .
      883       if not mBatchMode then
      884         hide frame waitfram .
      885     if     not mWaitFramView
      886        and mWaitProcEvent
      887     then
      888       process events .
      889     end.
      890   end procedure.
      891   procedure waitfram-show :
      892     define input  parameter p-message as character no-undo .
      893     define variable v-left-margin as integer   no-undo .
      894     if not session:batch-mode
      895     then do
      896     on error undo, return error return-value
      897     :
      898       if length(p-message) <= 70 then do:
      899         assign
      900           v-left-margin = integer((70 - length(p-message)) / 2)
      901         .
      902         assign
      903           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      904         .
      905         assign
      906           v-waitfram-action01 = " "
      907           v-waitfram-action02 = " "
      908                                    + fill(" ", v-left-margin)
      909                                    + p-message
      910           v-waitfram-action03 = " "
      911         .
      912       end.
      913       else do:
      914         define variable vRindex1 as integer no-undo.
      915         define variable vRindex2 as integer no-undo.
      916         vRindex1 = r-index(p-message," ",70).
      917         if vRindex1 = 0
      918         then
      919            vRindex1 = 70.
      920         if length(p-message)  <= vRindex1 + 70 then do:
      921           assign
      922             v-waitfram-action01 = " "
      923             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      924             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      925           .
      926         end.
      927         else do:
      928           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      929           if vRindex2 <= vRindex1
      930           then
      931              vRindex2 = vRindex1 + 70.
      932           assign
      933             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      934             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      935             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      936           .
      937         end.
      938       end.
      939       B-viewProcInfo:visible   in frame waitfram = no.
      940       B-viewProcInfo:sensitive in frame waitfram = no.
      941       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      942       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      943       if  (   mWaitFramView
      944          or  mWaitProcEvent)
      945          and not mBatchMode
      946       then
      947          display
      948             v-waitfram-action01 skip
      949             v-waitfram-action02 skip
      950             v-waitfram-action03 skip
      951          with frame waitfram .
      952       if     mWaitFramView
      953          then do:
      954             if     mWaitFramInterval ne ?
      955                and not mBatchMode
      956             then
      957                wait-for go of frame waitfram pause mWaitFramInterval.
      958          end.
      959          else
      960             if     mWaitProcEvent
      961                and not mBatchMode
      962             then
      963                process events .
      964     end.
      965   end procedure.
      966      procedure waitfram-show-this:
      967         define input  parameter iInterval as int64 no-undo.
      968         define variable vtime as int64 no-undo.
      969         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      970         mWaitFramInterval = iInterval.
      971         run waitfram-show (substitute("&1&2 &3&4" ,
      972                                       mWaitFramTextBeg ,
      973                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      974                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      975                                       mWaitFramTextEnd
      976                                      )
      977                           ).
      978      end.
      979      procedure WaitFramRunPause:
      980         define input  parameter iInterval as dec no-undo.
      981         define variable vStart  as datetime-tz no-undo.
      982         define variable vend    as datetime-tz no-undo.
      983         define variable vint as int64 no-undo.
      984         define variable vOk as logical no-undo.
      985         vStart = now.
      986         vend   = vStart.
      987         publish "WaitFramPause" (iInterval,output vOk).
      988         vend   =  now.
      989         vint = vend - vStart.
      990         vint = iInterval - vint / 1000.
      991         if     not mWaitFramStop
      992            and (   vint > 0
      993                 or (    not vOk
      994                     and iInterval eq ?
      995                     )
      996                 )
      997         then
      998            run waitfram-show-this (iInterval).
      999         vend   =  now.
     1000         vint = vend - vStart.
     1001         vint = iInterval - vint / 1000.
     1002         if     not mWaitFramStop
     1003            and vint > 0
     1004         then do:
     1005            run gbl/pause.p (vint * 1000).
     1006         end.
     1007         if iInterval ne ?
     1008         then
     1009            publish "WaitFramStop".
     1010         waitfram-check-timeout().
     1011      end.
     1012      procedure WaitFramWaitFor:
     1013         define input  parameter iInterval as dec no-undo.
     1014         assign
     1015            mWaitFramStartProc   = now
     1016            mWaitFramStopUser    = no
     1017            mWaitFramStopTimeOut = no
     1018         .
     1019         block-wait:
     1020         do while not mWaitFramStop:
     1021            run WaitFramRunPause (iInterval).
     1022            if  waitfram-check-timeout()
     1023            then do:
     1024               leave block-wait.
     1025            end.
     1026         end.
     1027         run waitfram-hide.
     1028      end.
     1029   procedure waitfram-join :
     1030     define input  parameter p-line-1  as character no-undo .
     1031     define input  parameter p-line-2  as character no-undo .
     1032     define input  parameter p-line-3  as character no-undo .
     1033     define output parameter p-message as character no-undo .
     1034     do
     1035     on error undo, return error return-value
     1036     :
     1037       assign
     1038         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1039                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1040                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1041       .
     1042     end.
     1043   end procedure.
     1044   function waitfram-join-function returns character
     1045     (input p-line-1 as character
     1046     ,input p-line-2 as character
     1047     ,input p-line-3 as character
     1048     ).
     1049     define variable v-message as character no-undo .
     1050     run waitfram-join in this-procedure
     1051       (input  p-line-1
     1052       ,input  p-line-2
     1053       ,input  p-line-3
     1054       ,output v-message
     1055       ) .
     1056     return v-message .
     1057   end function .
