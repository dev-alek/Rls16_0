     1109   function diff-list returns character (
     1110     input parfirst-list  as character,
     1111     input parsecond-list as character,
     1112     input pardelim       as character).
     1113     if pardelim = ""
     1114     or pardelim = ?
     1115     then do:
     1116       assign
     1117         pardelim = ","
     1118       .
     1119     end.
     1120     def var ind as integer no-undo .
     1121     def var v-elem as character no-undo .
     1122     def var v-result-list as character no-undo init "".
     1123     def var v-num-parfirst-list as integer no-undo .
     1124     assign
     1125       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1126     .
     1127     do ind = 1 to v-num-parfirst-list
     1128     :
     1129       assign
     1130         v-elem = entry(ind, parfirst-list, pardelim)
     1131       .
     1132       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1133         assign
     1134           v-result-list = v-result-list
     1135                         + (if v-result-list > "" then pardelim else "")
     1136                         + v-elem
     1137         .
     1138       end.
     1139     end.
     1140     return v-result-list .
     1141   end function.
     1142   function add-list returns character (
     1143    input parfirst-list  as character,
     1144    input parsecond-list as character,
     1145    input pardelim       as character).
     1146     if pardelim = ""
     1147     or pardelim = ?
     1148     then do:
     1149       assign
     1150         pardelim = ","
     1151       .
     1152     end.
     1153     def var ind as integer no-undo .
     1154     def var v-elem as character no-undo .
     1155     def var v-result-list as character no-undo init "".
     1156     def var v-num-parfirst-list as integer no-undo .
     1157     assign
     1158       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1159     .
     1160     do ind = 1 to v-num-parfirst-list
     1161     :
     1162       assign
     1163         v-elem = entry(ind, parfirst-list, pardelim)
     1164       .
     1165       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1166         assign
     1167           v-result-list = v-result-list
     1168                         + (if v-result-list > "" then pardelim else "")
     1169                         + v-elem
     1170         .
     1171       end.
     1172     end.
     1173     def var v-num-parsecond-list as integer no-undo .
     1174     assign
     1175       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1176     .
     1177     do ind = 1 to v-num-parsecond-list
     1178     :
     1179       assign
     1180         v-elem = entry(ind, parsecond-list, pardelim)
     1181       .
     1182       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1183         assign
     1184           v-result-list = v-result-list
     1185                         + (if v-result-list > "" then pardelim else "")
     1186                         + v-elem
     1187         .
     1188       end.
     1189     end.
     1190     return v-result-list .
     1191   end function.
     1192   function cross-list returns character (
     1193    input parfirst-list  as character,
     1194    input parsecond-list as character,
     1195    input pardelim       as character).
     1196     if pardelim = ""
     1197     or pardelim = ?
     1198     then do:
     1199       assign
     1200         pardelim = ","
     1201       .
     1202     end.
     1203     def var ind as integer no-undo .
     1204     def var v-elem as character no-undo .
     1205     def var v-result-list as character no-undo init "".
     1206     def var v-num-parfirst-list as integer no-undo .
     1207     assign
     1208       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1209     .
     1210     do ind = 1 to v-num-parfirst-list
     1211     :
     1212       assign
     1213         v-elem = entry(ind, parfirst-list, pardelim)
     1214       .
     1215       if lookup(v-elem, v-result-list, pardelim) = 0
     1216       and lookup(v-elem, parsecond-list, pardelim) > 0
     1217       then do:
     1218         assign
     1219           v-result-list = v-result-list
     1220                         + (if v-result-list > "" then pardelim else "")
     1221                         + v-elem
     1222         .
     1223       end.
     1224     end.
     1225     return v-result-list .
     1226   end function.
     1227   function radio-label returns character (
     1228    input par-rs-value  as character,
     1229    input par-rs-radio-buttons as character)
     1230    .
     1231    DEFINE variable v-result-label as character no-undo.
     1232    assign
     1233    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1234                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1235                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1236                             ), par-rs-radio-buttons
     1237                           )
     1238    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1239    .
     1240   return v-result-label.
     1241   end function.
     1242   function m-radio-label returns character (
     1243    input par-rs-value  as character,
     1244    input par-rs-radio-buttons as character,
     1245    input par-delim as character
     1246    )
     1247    .
     1248    DEFINE variable v-result-label as character no-undo.
     1249    assign
     1250    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1251                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1252                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1253                             ), par-rs-radio-buttons, par-delim
     1254                           )
     1255    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1256    .
     1257   return v-result-label.
     1258   end function.
     1259   FUNCTION mixlist returns character
     1260   (
     1261    input parfirst-list  as character
     1262    ,input parsecond-list as character
     1263    ,input pardelim       as character
     1264    ,input pardelim-result as character ) :
     1265     if pardelim = ""
     1266     or pardelim = ?
     1267     then do:
     1268       assign
     1269         pardelim = ","
     1270       .
     1271     end.
     1272     def var ind as integer no-undo .
     1273     def var v-elem1 as character no-undo .
     1274     def var v-elem2 as character no-undo .
     1275     def var v-result-list as character no-undo init "".
     1276     do ind = 1 to num-entries(parfirst-list, pardelim)
     1277     :
     1278       assign
     1279         v-elem1 = entry(ind, parfirst-list, pardelim)
     1280         v-elem2 = entry(ind, parsecond-list, pardelim)
     1281       .
     1282         assign
     1283           v-result-list = v-result-list
     1284                         + (if v-result-list > "" then pardelim-result else "")
     1285                         + v-elem1 + pardelim-result + v-elem2
     1286         .
     1287     end.
     1288     return v-result-list .
     1289   END FUNCTION.
     1290   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1291   function breakstr returns character ( input        for-name    as character,
     1292                                         input        line-length as integer,
     1293                                         input-output line1       as character,
     1294                                         input-output line2       as character ) :
     1295     define variable ii as integer no-undo.
     1296     if length( for-name ) > line-length then do:
     1297       assign ii    = 1
     1298              line1 = "":u
     1299              line2 = "":u.
     1300       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
     1301         assign line1 =       substring( for-name, 1, line-length     )
     1302                line2 = trim( substring( for-name,    line-length + 1 ) ).
     1303       end.                                                     else do:
     1304         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
     1305           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
     1306                  ii    = ii    + 1.
     1307           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
     1308             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
     1309           end.
     1310         end.
     1311         assign line2 = trim( substring( for-name, length( line1 ) ) ).
     1312       end.
     1313     end.                                else do:
     1314       assign line1 = for-name
     1315              line2 = "":u.
     1316     end.
     1317     return ( line1 ).
     1318   end function.
     1319   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1320     define variable v-cntxt-db-num        as integer   no-undo .
     1321     define variable v-cntxt-userid        as character no-undo .
     1322     define variable v-cntxt-level         as character no-undo .
