     1394   DEFINE RECTANGLE RECT-8
     1395        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1396        SIZE 27.25 BY 14.75.
     1397   DEFINE FRAME F-Main
     1398        RS-by2 AT ROW 2 COL 30.75 NO-LABEL
     1399        RS-By AT ROW 2.5 COL 3.5 NO-LABEL
     1400        "Источник формирования" VIEW-AS TEXT
     1401             SIZE 23.63 BY .83 AT ROW 1.5 COL 3.5
     1402             FGCOLOR 4
     1403        RECT-8 AT ROW 1 COL 2.25
     1404       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1405            SIDE-LABELS NO-UNDERLINE THREE-D
     1406            AT COL 1 ROW 1
     1407            SIZE 47.63 BY 15.
     1408   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1409   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1410   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1411   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1412   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1413   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1414   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1415   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1416       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1417   RUN ensure-broker.
     1418   THIS-PROCEDURE:ADM-DATA =
     1419        'ADM1.1~`':U +
     1420        'SmartObject~`':U +
     1421        'FRAME~`':U +
     1422        'NO ~`':U +
     1423        '~`':U +
     1424        '~`':U +
     1425        '~`':U +
     1426        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1427           + "~`":U +
     1428        'Layout,Hide-on-Init~`':U +
     1429        '~`':U +
     1430        '~`':U +
     1431        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1432        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1433            THEN "^^":U
     1434        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1435             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1436   PROCEDURE adm-apply-entry :
     1437     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1438   END PROCEDURE.
     1439   PROCEDURE adm-destroy :
     1440    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1441   END PROCEDURE.
     1442   PROCEDURE adm-disable :
     1443       DISABLE RECT-8 RS-by2 RS-By WITH FRAME F-Main.
     1444       RUN dispatch ('disable-fields':U).
     1445       RUN set-attribute-list ('ENABLED=no':U).
     1446       RETURN.
     1447   END PROCEDURE.
     1448   PROCEDURE adm-edit-attribute-list :
     1449         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1450         RETURN.
     1451   END PROCEDURE.
     1452   PROCEDURE adm-enable :
     1453       ENABLE UNLESS-HIDDEN RECT-8 RS-by2 RS-By WITH FRAME F-Main.
     1454       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1455       RUN set-attribute-list ('ENABLED=yes':U).
     1456       RETURN.
     1457   END PROCEDURE.
     1458   PROCEDURE adm-exit :
     1459        RUN notify ('exit':U).
     1460     RETURN.
     1461   END PROCEDURE.
     1462   PROCEDURE adm-hide :
     1463     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1464   END PROCEDURE.
     1465   PROCEDURE adm-initialize :
     1466     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1467   END PROCEDURE.
     1468   PROCEDURE adm-show-errors :
     1469       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1470       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1471           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1472       END.
     1473       RETURN.
     1474   END PROCEDURE.
     1475   PROCEDURE adm-UIB-mode :
     1476     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1477   END PROCEDURE.
     1478   PROCEDURE adm-view :
     1479     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1480   END PROCEDURE.
     1481   PROCEDURE dispatch :
     1482       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1483       RUN broker-dispatch IN adm-broker-hdl
     1484           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1485       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1486   END PROCEDURE.
     1487   PROCEDURE ensure-broker :
     1488   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1489   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1490   DO:
     1491       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1492       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1493   END.
     1494   END PROCEDURE.
     1495   PROCEDURE get-attribute :
     1496     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1497     RUN broker-get-attribute IN adm-broker-hdl
     1498         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1499     RETURN RETURN-VALUE.
     1500   END PROCEDURE.
     1501   PROCEDURE get-attribute-list :
     1502     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1503     RUN broker-get-attribute-list IN adm-broker-hdl
     1504         (INPUT THIS-PROCEDURE,
     1505          INPUT ?,
     1506          OUTPUT p-attr-list) NO-ERROR.
     1507     RETURN.
     1508   END PROCEDURE.
     1509   PROCEDURE new-state :
     1510     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1511     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1512     RETURN.
     1513   END PROCEDURE.
     1514   PROCEDURE notify :
     1515     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1516     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1517     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1518         RETURN "ADM-ERROR":U.
     1519     RETURN.
     1520   END PROCEDURE.
     1521   PROCEDURE set-attribute-list :
     1522     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1523     RUN ensure-broker.
     1524     RUN broker-set-attribute-list IN adm-broker-hdl
     1525         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1526     RETURN.
     1527   END PROCEDURE.
     1528   PROCEDURE set-position :
     1529       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1530       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1531       IF VALID-HANDLE(adm-object-hdl) THEN
     1532       DO:
     1533           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1534           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1535           DO:
     1536             IF p-row = 0 THEN p-row =
     1537               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1538             IF p-col = 0 THEN p-col =
     1539               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1540           END.
     1541           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1542           DO:
     1543             parent-hdl = adm-object-hdl:PARENT.
     1544             IF p-row = 0 THEN p-row =
     1545               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1546                 parent-hdl:ROW.
     1547             IF p-col = 0 THEN p-col =
     1548               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1549                 parent-hdl:COL.
     1550           END.
     1551           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1552           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1553         ASSIGN adm-object-hdl:ROW    =   p-row
     1554                adm-object-hdl:COLUMN =   p-col.
     1555       END.
     1556       RETURN.
     1557   END PROCEDURE.
     1558   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1559       STRING(adm-object-hdl)).
     1560   PAUSE 0 BEFORE-HIDE.
     1561   PROCEDURE adm-change-page :
     1562     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1563     END PROCEDURE.
     1564   PROCEDURE delete-page :
     1565     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1566     RUN broker-delete-page IN adm-broker-hdl
     1567         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1568     END PROCEDURE.
     1569   PROCEDURE init-object :
     1570     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1571     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1572     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1573     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1574     RUN broker-init-object IN adm-broker-hdl
     1575         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1576          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1577     RETURN.
     1578   END PROCEDURE.
     1579   PROCEDURE init-pages :
     1580     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1581     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1582         INPUT p-page-list) NO-ERROR.
     1583     END PROCEDURE.
     1584   PROCEDURE select-page :
     1585     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1586     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1587         INPUT p-page#) NO-ERROR.
     1588     END PROCEDURE.
     1589   PROCEDURE view-page :
     1590     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1591     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1592         INPUT p-page#).
     1593     END PROCEDURE.
     1594   ON VALUE-CHANGED OF RS-By IN FRAME F-Main
     1595   DO:
     1596     ASSIGN
     1597     RS-BY.
     1598     CASE RS-BY:
     1599       when 1 or
     1600       when 2 or
     1601       when 3 then do:
     1602           enable
     1603           rs-by2
     1604           with frame F-Main.
     1605       end.
     1606       when 5 then do:
     1607           disable
     1608           rs-by2
     1609           with frame F-Main.
     1610           run str/doc-list.w (input my-handle , v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code) no-error.
     1611           find first doc-list no-lock no-error.
     1612           if not available doc-list then do:
     1613             assign
     1614             rs-by = 1.
     1615             display rs-by with frame F-Main .
     1616           end.
     1617       end.
     1618       when 4
     1619       then do:
     1620           disable
     1621           rs-by2
     1622           with frame F-Main.
     1623       end.
     1624     END CASE.
     1625   END.
     1626   if not this-procedure :persistent
     1627   then do:
     1628     message
     1629       vss-workfile vss-revision vss-description skip
     1630       "Ошибка при запуске процедуры" skip
     1631       "Данную процедуру следует запускать только с параметром persistent" skip
     1632       view-as alert-box error .
     1633     undo, return error .
     1634   end.
     1635   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1636     run mainmenu_getcntxt in my-handle
     1637       (output v-cntxt-db-num
     1638       ,output v-cntxt-userid
     1639       ,output v-cntxt-level
     1640       ,output v-cntxt-host-code-obj
     1641       ,output v-cntxt-obj-type
     1642       ,output v-cntxt-obj-code
     1643       ,output v-cntxt-db-num-obj
     1644       ,output v-cntxt-is-admin
     1645       ) .
     1646   PROCEDURE adm-create-objects :
     1647   END PROCEDURE.
     1648   PROCEDURE adm-row-available :
     1649     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1650     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1651     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1652     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1653     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1654     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1655     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1656     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1657     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1658     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1659     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1660     IF adm-updating-record THEN RETURN.
     1661     RUN get-attribute ('FIELDS-ENABLED':U).
     1662     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1663     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1664         OUTPUT link-handle) NO-ERROR.
     1665     IF link-handle = "":U THEN
     1666         RETURN.
     1667     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1668     IF NUM-ENTRIES(link-handle) > 1 THEN
     1669         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1670             "encountered more than one RECORD-SOURCE.":U SKIP
     1671             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1672                VIEW-AS ALERT-BOX ERROR.
     1673     RUN get-attribute ('Key-Name':U).
     1674     key-name = RETURN-VALUE.
     1675     IF key-name = "":U THEN key-name = ?.
     1676     IF key-name NE ? THEN DO:
     1677       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1678         NO-ERROR.
     1679       IF key-value NE ? THEN
     1680         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1681     END.
     1682   IF VALID-HANDLE (adm-object-hdl) THEN
     1683       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1684   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1685   END PROCEDURE.
     1686   PROCEDURE disable_UI :
     1687     HIDE FRAME F-Main.
     1688     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1689   END PROCEDURE.
     1690   PROCEDURE enable_UI :
     1691     DISPLAY RS-by2 RS-By
     1692         WITH FRAME F-Main.
     1693     ENABLE RECT-8 RS-by2 RS-By
     1694         WITH FRAME F-Main.
     1695   END PROCEDURE.
     1696   PROCEDURE My-report :
     1697   define variable glog as logical no-undo .
     1698   run My-var.
     1699   assign
     1700   date_string = cur-time-print()
     1701   Line = fill( "-", 187 )
     1702   .
     1703   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1704   run cus/r-zum5.p (input my-handle
     1705               ,input rs-by
     1706               ,input rs-by2
     1707               ,input X-date-start
     1708               ,input x-date-end
     1709               ,input reportheader) no-error.
     1710   run waitfram-hide in this-procedure .
     1711   END PROCEDURE.
