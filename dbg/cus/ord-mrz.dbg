      510   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      512     (input  store-type
      513     ,input  store-code
      514     ,output g#host-code
      515     ,output g#host-name
      516     )  .
      517   run get-report-num  in parParentProc ( output g#report-num ).
      518   find first buf_sysconf no-lock where buf_sysconf.host-code = g#host-code .
      519   g#in-ov       = buf_sysconf.in-ov        .
      520   g#rsrv-time   = buf_sysconf.rsrv-time    .
      521   g#load-time   = buf_sysconf.load-time    .
      522   g#holidays    = buf_sysconf.holidays    .
      523   define buffer buf-oo_trn-doc     for ub.trn-doc.
      524   define buffer buf-oo_ord-doc-rcv for ub.ord-doc-rcv.
      525   define variable r-rec as recid no-undo.
      526   define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv.
      527   define buffer buf_ord-line-rcv for ub.ord-line-rcv.
      528   define buffer buf_doc-line     for ub.doc-line.
      529   define buffer buf_gds-dtl      for ub.gds-dtl.
      530   define buffer buf_ord-dtl-rcv  for ub.ord-dtl-rcv.
      531   define buffer bb_trn-doc       for ub.trn-doc.
      532   define variable v-flag-rcv as logical no-undo init false .
      533   define variable loc-rcv-num as  character no-undo .
      534   define variable g-log as logical no-undo .
      535   find buf-oo_trn-doc no-lock where recid(buf-oo_trn-doc) = par-recid no-error .
      536     if not available buf-oo_trn-doc   then return.
      537        vt-obj-type = buf-oo_trn-doc.cli-type .
      538        vt-obj-code = buf-oo_trn-doc.cli-code .
      539     if not (buf-oo_trn-doc.status_  = 'запрос':U   and
      540             buf-oo_trn-doc.flag_    = true         and
      541             buf-oo_trn-doc.doc-type = 'при':U  ) then do:
      542       message "Создать расходный внутренний запрос можно только на ЗАПР+ !"
      543               view-as alert-box information .
      544       return .
      545     end.
      546     v-flag-rcv = true .
      547   define variable v-rcv-code as character no-undo .
      548     for each ub.ord-chain no-lock where
      549              ub.ord-chain.rel-doc-code = buf-oo_trn-doc.doc-code and
      550              ub.ord-chain.doc-type = 'rcv'                  and
      551              ub.ord-chain.rel-doc-type = 'trn'
      552              :
      553         v-flag-rcv = false  .
      554         v-rcv-code = ub.ord-chain.doc-code.
      555     end.
      556     define buffer buf_ord-doc for ub.ord-doc  .
      557     find first buf-oo_ord-doc-rcv no-lock where buf-oo_ord-doc-rcv.rcv-code = v-rcv-code no-error .
      558     find first buf_ord-doc exclusive-lock where
      559                buf_ord-doc.doc-code = buf-oo_ord-doc-rcv.doc-code no-error .
      560     if available buf_ord-doc then do:
      561        assign
      562           buf_ord-doc.flag_ = true .
      563        .
      564     end.
      565   define variable v-obj-is-active as logical no-undo .
      566   define buffer buf_clients for ub.clients.
      567   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      569     (input  buf-oo_trn-doc.cli-type
      570     ,input  buf-oo_trn-doc.cli-code
      571     ,input  'active=request'
      572     ,output v-obj-is-active
      573     ) no-error .
      574       if v-obj-is-active = false then do:
      575       find first buf_clients no-lock where
      576                buf_clients.obj-type = buf-oo_trn-doc.cli-type and
      577                buf_clients.obj-code = buf-oo_trn-doc.cli-code    .
      578       if not g#news then
      579          message "Создать расходный внутренний запрос можно только на активной стороне " skip
      580                 buf-oo_trn-doc.cli-type
      581                 buf-oo_trn-doc.cli-code skip
      582                 "На базе данных № " buf_clients.db-num skip
      583                 view-as alert-box information .
      584       return .
      585     end.
      586   define variable m-ord as character no-undo .
      587   define variable v-ord as character no-undo .
      588   define variable v-flag as logical no-undo init false .
      589   define variable v-num as character no-undo .
      590      run main-ord in this-procedure ( input buf-oo_trn-doc.doc-code  ,  output  m-ord ) .
      591      for each   bb_trn-doc no-lock where
      592                 bb_trn-doc.doc-type = 'рас':U and
      593                 bb_trn-doc.doc-code begins  entry( 1 , buf-oo_trn-doc.doc-code , "-" )
      594                :
      595                 run main-ord in this-procedure ( input bb_trn-doc.doc-code ,  output  v-ord ) .
      596                 if m-ord = v-ord then do:
      597                    v-flag = true .
      598                    v-num = bb_trn-doc.doc-code .
      599                    leave.
      600                 end.
      601      end.
      602   if v-flag = true  then do:
      603       if not g#news then
      604       message "Уже есть расходный внутренний запрос :" v-num skip
      605               "на этот  приходный внутренний запрос :" buf-oo_trn-doc.doc-code
      606               view-as alert-box information .
      607       return .
      608   end.
      609   g-log = true .
      610     if not g#news then do:
      611     message "Создать расходный внутренний запрос ?"
      612       view-as alert-box question
      613       buttons yes-no
      614       update g-log .
      615     end.
      616     if g-log = false then return .
      617    run waitfram-show in this-procedure ( "Ждите , создание внутреннего расходного запроса - " ) .
      618    if v-flag-rcv = true then do:
      619       run str/prirasiq.p (parParentProc, buf-oo_trn-doc.doc-code) .
      620       run waitfram-hide in this-procedure .
      621       return  .
      622    end.
      623   define variable v-i-doc as character no-undo .
      624   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625   run proc-ord-code in this-procedure
      626    (input   'main' ,
      627     input   v-cntxt-db-num ,
      628     input   v-cntxt-obj-type ,
      629     input   v-cntxt-obj-code ,
      630     input   v-i-doc ,
      631     output  loc-rcv-num
      632    ) .
      633       create buf_ord-doc-rcv.
      634       BUFFER-COPY buf-oo_ord-doc-rcv to buf_ord-doc-rcv
      635       assign
      636         buf_ord-doc-rcv.rcv-code  = loc-rcv-num
      637       .
      638       for each buf_doc-line no-lock where
      639                buf_doc-line.doc-code =  buf-oo_trn-doc.doc-code :
      640                create buf_ord-line-rcv.
      641                BUFFER-COPY buf_doc-line to buf_ord-line-rcv
      642                assign
      643                  buf_ord-line-rcv.rcv-code  = loc-rcv-num
      644                  buf_ord-line-rcv.doc-code  = buf-oo_ord-doc-rcv.doc-code
      645                  buf_ord-line-rcv.qnty      = buf_doc-line.doc-qnty
      646                .
      647       end.
      648       for each buf_gds-dtl no-lock where
      649                buf_gds-dtl.doc-code =  buf-oo_trn-doc.doc-code :
      650                create buf_ord-dtl-rcv.
      651                BUFFER-COPY buf_gds-dtl to buf_ord-dtl-rcv
      652                assign
      653                  buf_ord-dtl-rcv.rcv-code  = loc-rcv-num
      654                  buf_ord-dtl-rcv.doc-code  = buf-oo_ord-doc-rcv.doc-code
      655                  buf_ord-dtl-rcv.node-code = buf_gds-dtl.prt-code
      656                  buf_ord-dtl-rcv.qnty      = buf_gds-dtl.doc-qnty
      657                .
      658       end.
      659       r-rec = recid(buf_ord-doc-rcv).
      660       run cus/ord-trnz.p
      661                      ( parParentProc ,
      662                       input  r-rec ,
      663                       input  'рас':U,
      664                       input  buf-oo_trn-doc.doc-code ) no-error .
      665       if error-status :error then do:
      666         if not g#news then do:
      667         message vss-workfile vss-revision vss-description skip
      668                "Ошибка ord-trnz.p " skip
      669                 skip
      670                 error-status :get-message(1) skip
      671                 return-value skip
      672                 view-as alert-box error
      673         .
      674         end.
      675         delete buf_ord-doc-rcv .
      676         return .
      677       end.
      678       run waitfram-show in this-procedure ( "Ждите , закрытие на запр+ " ) .
      679       for each ub.ord-chain no-lock where
      680                 ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
      681                 ub.ord-chain.doc-type = 'rcv'                  and
      682                 ub.ord-chain.rel-doc-type = 'trn'
      683           :
      684           run close-zapr in this-procedure (ub.ord-chain.rel-doc-code) .
      685       end.
      686       find current buf_ord-doc-rcv  exclusive-lock  .
      687                    buf_ord-doc-rcv.status_ = 'поставка':U .
      688       run waitfram-hide in this-procedure .
      689   PROCEDURE close-zapr :
      690    do
      691    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      692    :
      693   define input parameter p-trn-code as character no-undo .
      694   define buffer buf_s-trn-doc for ub.trn-doc.
      695   define variable varmode            as   character           no-undo.
      696   define variable varstatus          like ub.trn-doc.status_  no-undo.
      697   define variable varflag            like ub.trn-doc.flag     no-undo.
      698   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
      699   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
      700   define variable varcheck-return as logical no-undo .
      701   define variable varchg-inv as logical no-undo .
      702   assign
      703     varmode        =  '<закрытие документа>':U
      704     varstatus      = 'запрос':U
      705     varflag        = false
      706     varcopystatus  = 'запрос':U
      707     varcopyflag    = true
      708     varcheck-return = true
      709     varchg-inv = true
      710     .
      711   run str/trn-graf.p
      712                  (input  p-trn-code,
      713                   input  v-cntxt-db-num,
      714                   input  varmode,
      715                   output varstatus,
      716                   output varflag,
      717                   output varcopystatus,
      718                   output varcopyflag
      719                   ) no-error.
      720   .
      721   if error-status:error then do:
      722      if error-status :get-message(1) <> "" or
      723         return-value = ""                  then do:
      724        message "Ошибка при вызове trn-graf.p." skip
      725        error-status :get-message(1) skip
      726        return-value skip
      727        view-as alert-box error.
      728      end.
      729      else do:
      730        message return-value
      731        view-as alert-box error.
      732      end.
      733      return error.
      734   end.
      735   run str/trn-stat.p
      736     ( input  parParentProc ,
      737       input this-procedure ,
      738       input  varmode,
      739       input  p-trn-code,
      740       input  varcheck-return,
      741       input  v-cntxt-db-num,
      742       input  g#in-ov,
      743       input  g#rsrv-time,
      744       input  g#load-time,
      745       input  g#holidays,
      746       input  yes,
      747       output varchg-inv,
      748       output table gds-list
      749       ) no-error.
      750   if error-status:error then do:
      751        message vss-workfile vss-revision vss-description skip
      752        "Ошибка при принудительном закрытии документа " p-trn-code skip
      753        return-value skip
      754        trim(error-status :get-message(1))
      755        trim(error-status :get-message(2))
      756        trim(error-status :get-message(3))
      757        trim(error-status :get-message(4))
      758        trim(error-status :get-message(5)) skip
      759        view-as alert-box error.
      760      return error.
      761   end.
      762     end.
      763   END PROCEDURE.
      764   PROCEDURE main-ord :
      765    do
      766    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      767    :
      768   define input parameter   p-in-ord-num as character no-undo .
      769   define output parameter  p-out-ord-num as character no-undo .
      770   if num-entries(p-in-ord-num , "." ) = 1 then
      771      p-out-ord-num = p-in-ord-num .
      772      else do:
      773        p-out-ord-num = entry(1, entry( 1 , p-in-ord-num , "." ) , "-" )  + "-" + entry( 2 , p-in-ord-num , "."  ) .
      774      end.
      775     end.
      776   END PROCEDURE.
      777   procedure mainmenu_getcntxt :
      778   define output parameter p-cntxt-db-num                as integer   no-undo .
      779   define output parameter p-cntxt-userid                as character no-undo .
      780   define output parameter p-cntxt-level                 as character no-undo .
      781   define output parameter p-cntxt-host-code-obj         as integer   no-undo .
      782   define output parameter p-cntxt-obj-type              as character no-undo .
      783   define output parameter p-cntxt-obj-code              as integer   no-undo .
      784   define output parameter p-cntxt-db-num-obj            as integer   no-undo .
      785   define output parameter p-cntxt-is-admin              as logical   no-undo .
      786     do
      787     on error undo, return error return-value
      788     :
      789   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      791     (input  vt-obj-type
      792     ,input  vt-obj-code
      793     ,output p-cntxt-db-num-obj
      794     )  .
      795     assign
      796       p-cntxt-db-num          =  v-cntxt-db-num
      797       p-cntxt-userid          =  v-cntxt-userid
      798       p-cntxt-level           =  v-cntxt-level
      799       p-cntxt-host-code-obj   =  vt-host-code
      800       p-cntxt-obj-type        =  vt-obj-type
      801       p-cntxt-obj-code        =  vt-obj-code
      802       p-cntxt-is-admin        =  v-cntxt-is-admin
      803     .
      804     end.
      805    end procedure.
      806   procedure get-report-num :
      807     define output parameter p-report-num as integer no-undo .
      808      do
      809      on error undo, return error return-value
      810      :
      811       assign
      812         p-report-num = 1
      813       .
      814      end.
      815    end procedure.
