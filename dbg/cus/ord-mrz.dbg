      410   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      411     define variable v-cntxt-db-num        as integer   no-undo .
      412     define variable v-cntxt-userid        as character no-undo .
      413     define variable v-cntxt-level         as character no-undo .
      414     define variable v-cntxt-host-code-obj as integer   no-undo .
      415     define variable v-cntxt-obj-type      as character no-undo .
      416     define variable v-cntxt-obj-code      as integer   no-undo .
      417     define variable v-cntxt-db-num-obj    as integer   no-undo .
      418     define variable v-cntxt-is-admin      as logical   no-undo .
      419   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      420   procedure proc-ord-code :
      421   define input  parameter  p-type as character no-undo .
      422   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      423   define input  parameter  v-cntxt-obj-type as character no-undo .
      424   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      425   define input  parameter  p-i-doc    as character no-undo .
      426   define output parameter  p-ord-doc  as character no-undo .
      427   define variable          v-idop     as character no-undo .
      428     do
      429     on error undo, return error return-value
      430     :
      431   case p-type :
      432       when "main-no-ver" then do:
      433         if  (v-cntxt-db-num <> 0) then
      434           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      435         else
      436           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      437       end.
      438       when "main" then do:
      439             do while true:
      440             if  (v-cntxt-db-num <> 0) then
      441               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      442             else
      443               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      444             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      445             End.
      446       end.
      447       when "chip" then do:
      448         assign
      449           v-idop = p-i-doc .
      450         do while true :
      451           if index (v-idop , ".") = 0 then
      452             v-idop  = replace (v-idop , "-", "-1.").
      453           else
      454             v-idop  =
      455             substring (v-idop , 1, index (v-idop, "-")) +
      456             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      457             substring (v-idop, index (v-idop, ".")).
      458           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      459         end.
      460         assign
      461           p-ord-doc = v-idop.
      462       end.
      463   end case.
      464     end.
      465   end procedure.
      466   define variable g#host-name  as character no-undo .
      467   define variable g#host-code    as integer   no-undo .
      468   define variable store-type   as character no-undo .
      469   define variable store-code   as integer   no-undo .
      470   define variable g#log      as logical   no-undo .
      471   define variable g#report-num as integer   no-undo .
      472   define variable g#db-remote as logical   no-undo .
      473   define variable g#in-ov      as logical   no-undo .
      474   define variable g#rsrv-time  as decimal   no-undo .
      475   define variable g#load-time as decimal   no-undo .
      476   define variable g#holidays  as character no-undo .
      477   define variable vt-obj-type as character no-undo .
      478   define variable vt-obj-code as integer   no-undo .
      479   define variable vt-host-code as integer   no-undo .
      480   define buffer buf_sysconf for ub.sysconf  .
      481   if parParentProc = ? then
      482      parParentProc = this-procedure .
      483   define buffer bf_trn-doc for ub.trn-doc  .
      484   define buffer bf_clients for ub.clients  .
      485   find bf_trn-doc no-lock where recid(bf_trn-doc) = par-recid no-error .
      486     if not available bf_trn-doc   then return.
      487        vt-obj-type = bf_trn-doc.cli-type .
      488        vt-obj-code = bf_trn-doc.cli-code .
      489   find first bf_clients no-lock where
      490        bf_clients.obj-type = vt-obj-type and
      491        bf_clients.obj-code = vt-obj-code no-error .
      492     if error-status :error then return .
      493        vt-host-code = bf_clients.host-code .
      494   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
