      615   function diff-list returns character (
      616     input parfirst-list  as character,
      617     input parsecond-list as character,
      618     input pardelim       as character).
      619     if pardelim = ""
      620     or pardelim = ?
      621     then do:
      622       assign
      623         pardelim = ","
      624       .
      625     end.
      626     def var ind as integer no-undo .
      627     def var v-elem as character no-undo .
      628     def var v-result-list as character no-undo init "".
      629     def var v-num-parfirst-list as integer no-undo .
      630     assign
      631       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      632     .
      633     do ind = 1 to v-num-parfirst-list
      634     :
      635       assign
      636         v-elem = entry(ind, parfirst-list, pardelim)
      637       .
      638       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      639         assign
      640           v-result-list = v-result-list
      641                         + (if v-result-list > "" then pardelim else "")
      642                         + v-elem
      643         .
      644       end.
      645     end.
      646     return v-result-list .
      647   end function.
      648   function add-list returns character (
      649    input parfirst-list  as character,
      650    input parsecond-list as character,
      651    input pardelim       as character).
      652     if pardelim = ""
      653     or pardelim = ?
      654     then do:
      655       assign
      656         pardelim = ","
      657       .
      658     end.
      659     def var ind as integer no-undo .
      660     def var v-elem as character no-undo .
      661     def var v-result-list as character no-undo init "".
      662     def var v-num-parfirst-list as integer no-undo .
      663     assign
      664       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      665     .
      666     do ind = 1 to v-num-parfirst-list
      667     :
      668       assign
      669         v-elem = entry(ind, parfirst-list, pardelim)
      670       .
      671       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      672         assign
      673           v-result-list = v-result-list
      674                         + (if v-result-list > "" then pardelim else "")
      675                         + v-elem
      676         .
      677       end.
      678     end.
      679     def var v-num-parsecond-list as integer no-undo .
      680     assign
      681       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      682     .
      683     do ind = 1 to v-num-parsecond-list
      684     :
      685       assign
      686         v-elem = entry(ind, parsecond-list, pardelim)
      687       .
      688       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      689         assign
      690           v-result-list = v-result-list
      691                         + (if v-result-list > "" then pardelim else "")
      692                         + v-elem
      693         .
      694       end.
      695     end.
      696     return v-result-list .
      697   end function.
      698   function cross-list returns character (
      699    input parfirst-list  as character,
      700    input parsecond-list as character,
      701    input pardelim       as character).
      702     if pardelim = ""
      703     or pardelim = ?
      704     then do:
      705       assign
      706         pardelim = ","
      707       .
      708     end.
      709     def var ind as integer no-undo .
      710     def var v-elem as character no-undo .
      711     def var v-result-list as character no-undo init "".
      712     def var v-num-parfirst-list as integer no-undo .
      713     assign
      714       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      715     .
      716     do ind = 1 to v-num-parfirst-list
      717     :
      718       assign
      719         v-elem = entry(ind, parfirst-list, pardelim)
      720       .
      721       if lookup(v-elem, v-result-list, pardelim) = 0
      722       and lookup(v-elem, parsecond-list, pardelim) > 0
      723       then do:
      724         assign
      725           v-result-list = v-result-list
      726                         + (if v-result-list > "" then pardelim else "")
      727                         + v-elem
      728         .
      729       end.
      730     end.
      731     return v-result-list .
      732   end function.
      733   function radio-label returns character (
      734    input par-rs-value  as character,
      735    input par-rs-radio-buttons as character)
      736    .
      737    DEFINE variable v-result-label as character no-undo.
      738    assign
      739    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      740                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      741                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      742                             ), par-rs-radio-buttons
      743                           )
      744    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      745    .
      746   return v-result-label.
      747   end function.
      748   function m-radio-label returns character (
      749    input par-rs-value  as character,
      750    input par-rs-radio-buttons as character,
      751    input par-delim as character
      752    )
      753    .
      754    DEFINE variable v-result-label as character no-undo.
      755    assign
      756    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      757                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      758                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      759                             ), par-rs-radio-buttons, par-delim
      760                           )
      761    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      762    .
      763   return v-result-label.
      764   end function.
      765   FUNCTION mixlist returns character
      766   (
      767    input parfirst-list  as character
      768    ,input parsecond-list as character
      769    ,input pardelim       as character
      770    ,input pardelim-result as character ) :
      771     if pardelim = ""
      772     or pardelim = ?
      773     then do:
      774       assign
      775         pardelim = ","
      776       .
      777     end.
      778     def var ind as integer no-undo .
      779     def var v-elem1 as character no-undo .
      780     def var v-elem2 as character no-undo .
      781     def var v-result-list as character no-undo init "".
      782     do ind = 1 to num-entries(parfirst-list, pardelim)
      783     :
      784       assign
      785         v-elem1 = entry(ind, parfirst-list, pardelim)
      786         v-elem2 = entry(ind, parsecond-list, pardelim)
      787       .
      788         assign
      789           v-result-list = v-result-list
      790                         + (if v-result-list > "" then pardelim-result else "")
      791                         + v-elem1 + pardelim-result + v-elem2
      792         .
      793     end.
      794     return v-result-list .
      795   END FUNCTION.
      796   define variable parparentproc as widget-handle no-undo .
      797   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      798     define variable v-cntxt-db-num        as integer   no-undo .
      799     define variable v-cntxt-userid        as character no-undo .
      800     define variable v-cntxt-level         as character no-undo .
      801     define variable v-cntxt-host-code-obj as integer   no-undo .
      802     define variable v-cntxt-obj-type      as character no-undo .
      803     define variable v-cntxt-obj-code      as integer   no-undo .
      804     define variable v-cntxt-db-num-obj    as integer   no-undo .
      805     define variable v-cntxt-is-admin      as logical   no-undo .
      806   DEFINE VARIABLE RS-sort AS CHARACTER
      807        VIEW-AS RADIO-SET VERTICAL
      808        RADIO-BUTTONS
      809             "Код", "Code":U,
      810   "Артикул", "Artic":U,
      811   "Наименование", "Name":U
      812        SIZE 30.38 BY 4.54 NO-UNDO.
      813   DEFINE RECTANGLE RECT-method
      814        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      815        SIZE 50.38 BY 6.33.
      816   DEFINE RECTANGLE RECT-supp
      817        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      818        SIZE 50.38 BY 8.58.
      819   DEFINE VARIABLE T-zero AS LOGICAL INITIAL no
      820        LABEL "Выводить товары с нулевым значением"
      821        VIEW-AS TOGGLE-BOX
      822        SIZE 38 BY 1
      823        FGCOLOR 4  NO-UNDO.
      824   DEFINE FRAME F-Main
      825        T-zero AT ROW 1.71 COL 3.88
      826        RS-sort AT ROW 10.21 COL 20.25 NO-LABEL
      827        "<дней в продаже>" VIEW-AS TEXT
      828             SIZE 35.63 BY 1 AT ROW 2.75 COL 6.5
      829             FGCOLOR 4
      830        "Сортировка" VIEW-AS TEXT
      831             SIZE 10.25 BY .83 AT ROW 10.29 COL 3.25
      832             FGCOLOR 4
      833        RECT-supp AT ROW 1.17 COL 2.5
      834        RECT-method AT ROW 9.96 COL 2.25
      835       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      836            SIDE-LABELS NO-UNDERLINE THREE-D
      837            AT COL 1 ROW 1
      838            SIZE 53.38 BY 15.54.
      839   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      840   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      841   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      842   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      843   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      844   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      845   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      846   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      847       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
      848   RUN ensure-broker.
      849   THIS-PROCEDURE:ADM-DATA =
      850        'ADM1.1~`':U +
      851        'SmartObject~`':U +
      852        'FRAME~`':U +
      853        'NO ~`':U +
      854        '~`':U +
      855        '~`':U +
      856        '~`':U +
      857        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      858           + "~`":U +
      859        'Layout,Hide-on-Init~`':U +
      860        '~`':U +
      861        '~`':U +
      862        '~`~`~`~`~`~`~`~`~`~`~`':U +
      863        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      864            THEN "^^":U
      865        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      866             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      867   PROCEDURE adm-apply-entry :
      868     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      869   END PROCEDURE.
      870   PROCEDURE adm-destroy :
      871    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      872   END PROCEDURE.
      873   PROCEDURE adm-disable :
      874       DISABLE RECT-supp RECT-method T-zero RS-sort WITH FRAME F-Main.
      875       RUN dispatch ('disable-fields':U).
      876       RUN set-attribute-list ('ENABLED=no':U).
      877       RETURN.
      878   END PROCEDURE.
      879   PROCEDURE adm-edit-attribute-list :
      880         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      881         RETURN.
      882   END PROCEDURE.
      883   PROCEDURE adm-enable :
      884       ENABLE UNLESS-HIDDEN RECT-supp RECT-method T-zero RS-sort WITH FRAME F-Main.
      885       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      886       RUN set-attribute-list ('ENABLED=yes':U).
      887       RETURN.
      888   END PROCEDURE.
      889   PROCEDURE adm-exit :
      890        RUN notify ('exit':U).
      891     RETURN.
      892   END PROCEDURE.
      893   PROCEDURE adm-hide :
      894     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      895   END PROCEDURE.
      896   PROCEDURE adm-initialize :
      897     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      898   END PROCEDURE.
      899   PROCEDURE adm-show-errors :
      900       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      901       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      902           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      903       END.
      904       RETURN.
      905   END PROCEDURE.
      906   PROCEDURE adm-UIB-mode :
      907     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      908   END PROCEDURE.
      909   PROCEDURE adm-view :
      910     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      911   END PROCEDURE.
      912   PROCEDURE dispatch :
      913       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      914       RUN broker-dispatch IN adm-broker-hdl
      915           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      916       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      917   END PROCEDURE.
      918   PROCEDURE ensure-broker :
      919   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      920   IF RETURN-VALUE NE "ADM-Broker":U THEN
      921   DO:
      922       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      923       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      924   END.
      925   END PROCEDURE.
      926   PROCEDURE get-attribute :
      927     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      928     RUN broker-get-attribute IN adm-broker-hdl
      929         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      930     RETURN RETURN-VALUE.
      931   END PROCEDURE.
      932   PROCEDURE get-attribute-list :
      933     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      934     RUN broker-get-attribute-list IN adm-broker-hdl
      935         (INPUT THIS-PROCEDURE,
      936          INPUT ?,
      937          OUTPUT p-attr-list) NO-ERROR.
      938     RETURN.
      939   END PROCEDURE.
      940   PROCEDURE new-state :
      941     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      942     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      943     RETURN.
      944   END PROCEDURE.
      945   PROCEDURE notify :
      946     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      947     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      948     IF RETURN-VALUE = "ADM-ERROR":U THEN
      949         RETURN "ADM-ERROR":U.
      950     RETURN.
      951   END PROCEDURE.
      952   PROCEDURE set-attribute-list :
      953     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      954     RUN ensure-broker.
      955     RUN broker-set-attribute-list IN adm-broker-hdl
      956         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      957     RETURN.
      958   END PROCEDURE.
      959   PROCEDURE set-position :
      960       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      961       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      962       IF VALID-HANDLE(adm-object-hdl) THEN
      963       DO:
      964           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      965           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      966           DO:
      967             IF p-row = 0 THEN p-row =
      968               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      969             IF p-col = 0 THEN p-col =
      970               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      971           END.
      972           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      973           DO:
      974             parent-hdl = adm-object-hdl:PARENT.
      975             IF p-row = 0 THEN p-row =
      976               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      977                 parent-hdl:ROW.
      978             IF p-col = 0 THEN p-col =
      979               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      980                 parent-hdl:COL.
      981           END.
      982           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      983           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      984         ASSIGN adm-object-hdl:ROW    =   p-row
      985                adm-object-hdl:COLUMN =   p-col.
      986       END.
      987       RETURN.
      988   END PROCEDURE.
      989   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      990       STRING(adm-object-hdl)).
      991   PAUSE 0 BEFORE-HIDE.
      992   PROCEDURE adm-change-page :
      993     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      994     END PROCEDURE.
      995   PROCEDURE delete-page :
      996     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      997     RUN broker-delete-page IN adm-broker-hdl
      998         (INPUT THIS-PROCEDURE, INPUT p-page#).
      999     END PROCEDURE.
     1000   PROCEDURE init-object :
     1001     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1002     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1003     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1004     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1005     RUN broker-init-object IN adm-broker-hdl
     1006         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1007          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1008     RETURN.
     1009   END PROCEDURE.
     1010   PROCEDURE init-pages :
     1011     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1012     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1013         INPUT p-page-list) NO-ERROR.
     1014     END PROCEDURE.
     1015   PROCEDURE select-page :
     1016     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1017     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1018         INPUT p-page#) NO-ERROR.
     1019     END PROCEDURE.
     1020   PROCEDURE view-page :
     1021     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1022     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1023         INPUT p-page#).
     1024     END PROCEDURE.
     1025   ON VALUE-CHANGED OF RS-sort IN FRAME F-Main
     1026   DO:
     1027     assign RS-sort.
     1028   END.
     1029   ON VALUE-CHANGED OF T-zero IN FRAME F-Main
     1030   DO:
     1031     assign T-zero.
     1032   END.
     1033   if not this-procedure :persistent
     1034   then do:
     1035     message
     1036       vss-workfile vss-revision vss-description skip
     1037       "Ошибка при запуске процедуры" skip
     1038       "Данную процедуру следует запускать только с параметром persistent" skip
     1039       view-as alert-box error .
     1040     undo, return error .
     1041   end.
     1042   parparentproc = my-handle.
     1043   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044     run mainmenu_getcntxt in parparentproc
     1045       (output v-cntxt-db-num
     1046       ,output v-cntxt-userid
     1047       ,output v-cntxt-level
     1048       ,output v-cntxt-host-code-obj
     1049       ,output v-cntxt-obj-type
     1050       ,output v-cntxt-obj-code
     1051       ,output v-cntxt-db-num-obj
     1052       ,output v-cntxt-is-admin
     1053       ) .
     1054   PROCEDURE adm-create-objects :
     1055   END PROCEDURE.
     1056   PROCEDURE adm-row-available :
     1057     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1058     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1059     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1060     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1061     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1062     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1063     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1064     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1065     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1066     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1067     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1068     IF adm-updating-record THEN RETURN.
     1069     RUN get-attribute ('FIELDS-ENABLED':U).
     1070     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1071     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1072         OUTPUT link-handle) NO-ERROR.
     1073     IF link-handle = "":U THEN
     1074         RETURN.
     1075     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1076     IF NUM-ENTRIES(link-handle) > 1 THEN
     1077         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1078             "encountered more than one RECORD-SOURCE.":U SKIP
     1079             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1080                VIEW-AS ALERT-BOX ERROR.
     1081     RUN get-attribute ('Key-Name':U).
     1082     key-name = RETURN-VALUE.
     1083     IF key-name = "":U THEN key-name = ?.
     1084     IF key-name NE ? THEN DO:
     1085       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1086         NO-ERROR.
     1087       IF key-value NE ? THEN
     1088         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1089     END.
     1090   IF VALID-HANDLE (adm-object-hdl) THEN
     1091       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1092   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1093   END PROCEDURE.
     1094   PROCEDURE disable_UI :
     1095     HIDE FRAME F-Main.
     1096     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1097   END PROCEDURE.
     1098   PROCEDURE enable_UI :
     1099     DISPLAY T-zero RS-sort
     1100         WITH FRAME F-Main.
     1101     ENABLE RECT-supp RECT-method T-zero RS-sort
     1102         WITH FRAME F-Main.
     1103   END PROCEDURE.
     1104   PROCEDURE My-report :
     1105   DEFINE VARIABLE         v-supplier      like ub.clients.obj-name            no-undo .
     1106   DEFINE VARIABLE         v-producer      like ub.clients.obj-name            no-undo .
     1107   run My-var.
     1108   run cus/r-mar1.p (
     1109                  parparentproc
     1110                 ,input X-date-start
     1111                 ,input X-date-end
     1112                 ,input X-SelectGood
     1113                 ,input T-zero
     1114                 ,input RS-sort
     1115                 ,input reportHeader
     1116                 ) no-error .
     1117   END PROCEDURE.
     1118   PROCEDURE My-var :
     1119   assign
     1120   frame F-Main RS-SOrt
     1121   frame F-Main T-zero
     1122   .
     1123   assign
     1124   sheetf.Excel-Column-Lable =
     1125   "Код" + chr(44) +
     1126   "Артикул" + chr(44) +
     1127   "Название товара" + chr(44) +
     1128   "Шкальный признак" + chr(44) +
     1129   "Производитель" + chr(44) +
     1130   "Группа" + chr(44) +
     1131   "Дней в продаже"
     1132   sheetf.Sizes =
     1133   "9" + chr(44) +
     1134   "16" +  chr(44) +
     1135   "40" +  chr(44) +
     1136   "20" + chr(44) +
     1137   "30" + chr(44) +
     1138   "50" + chr(44) +
     1139   "7"
     1140   sheetf.colformat = "2=0":U + chr(4) + "2=@"
     1141   str2 = " "
     1142   .
     1143   Assign
     1144    STR-obj-type = ''
     1145    STR-obj-code = ''
     1146    STR-obj-name = ''
     1147    STR-obj      = ''.
     1148   For each obj-list no-lock:
     1149    Assign
     1150    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1151    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1152    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1153    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1154   End.
     1155   assign
     1156   ReportNAme = "Дни продажи товара "
     1157   ReportHeader =  "Сортировка: " + radio-label(string(RS-sort), Rs-sort:radio-buttons) + chr(10) +
     1158                   (if not T-zero
     1159                    then  "Не показывать товар с нулевым значением <дни в продаже>"
     1160                    else  ("Показывать товар с нулевым значением <дни в продаже>" + chr(10) +
     1161                           "(Будут показаны только товары (признаки), по которым было движение на выбранном множестве объектов)"
     1162                          ))
     1163                   .
     1164   END PROCEDURE.
     1165   PROCEDURE send-records :
     1166   END PROCEDURE.
     1167   PROCEDURE state-changed :
     1168     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1169     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1170   END PROCEDURE.
