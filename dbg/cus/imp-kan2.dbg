     1009        city2 AT ROW 5.5 COL 14.5 COLON-ALIGNED NO-LABEL
     1010        "       Не обязательные параметры подставляемые по умолчанию" VIEW-AS TEXT
     1011             SIZE 64 BY 1 AT ROW 4 COL 1
     1012             BGCOLOR 8 FGCOLOR 0
     1013        "                         Необходимо указать" VIEW-AS TEXT
     1014             SIZE 64 BY .93 AT ROW 1 COL 1
     1015             BGCOLOR 8 FGCOLOR 0
     1016        SPACE(0.00) SKIP(6.64)
     1017       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1018            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1019            TITLE "Импорт товаров из текстового файла"
     1020            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
     1021   ASSIGN
     1022          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1023          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1024   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1025   DO:
     1026     APPLY "END-ERROR":U TO SELF.
     1027   END.
     1028   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1029   DO:
     1030   define variable v-rate-value as decimal no-undo .
     1031   define variable v-is-new as logical no-undo .
     1032   define variable v-b-str as character no-undo .
     1033   define variable v-rid as recid no-undo .
     1034   define buffer buf_goods for ub.goods.
     1035   define buffer buf_gds-grp for ub.gds-grp.
     1036   define buffer buf_gds-prt for ub.gds-prt.
     1037   define buffer buf_tax-rate for ub.tax-rate.
     1038   define buffer buf_lvl-name for ub.lvl-name.
     1039   define buffer buf_prod-bc for ub.prod-bc.
     1040   define buffer buf_bar-code for ub.bar-code.
     1041   if cli-code = 0 then do:
     1042     message "Не задан производитель "
     1043     view-as alert-box ERROR.
     1044     return no-apply.
     1045   end.
     1046   if trim(file-name) = "" then do:
     1047     message "Не задан файл для импорта "
     1048     view-as alert-box ERROR.
     1049     return no-apply.
     1050   end.
     1051   for each buf_gds-grp  no-lock:
     1052   find first buf_grp where
     1053             buf_grp.upper-code = buf_gds-grp.node-code no-lock no-error.
     1054   if avail buf_grp then next.
     1055    run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code
     1056                                                ,output grp-full).
     1057    if index(buf_gds-grp.node-name, "-") = 0 then do:
     1058      message
     1059     "Существуют группы товаров которые начинаются не с номера в начале названия," skip
     1060     "в начале названия должен стоять номер и символ -" skip
     1061      buf_gds-grp.node-name  skip
     1062      view-as alert-box ERROR   .
     1063      return no-apply.
     1064    end.
     1065    N-grp = integer(substring(buf_gds-grp.node-name, 1, index(buf_gds-grp.node-name, "-") - 1)).
     1066    find first tbl-grp where tbl-grp.num-grp = n-grp no-lock no-error.
     1067    if not avail tbl-grp then do:
     1068       create tbl-grp.
     1069       assign
     1070       tbl-grp.num-grp = n-grp
     1071       tbl-grp.name-grp = grp-full
     1072       tbl-grp.Short-Name-grp = buf_gds-grp.node-name
     1073       tbl-grp.code = buf_gds-grp.node-code.
     1074     end.
     1075     else do:
     1076       message
     1077       "Существуют группы товаров с одинаковым номером " N-grp " в начале названия" skip
     1078       buf_gds-grp.node-name  skip
     1079       tbl-grp.Short-Name-grp  skip
     1080       "В одном из них измените начальный номер на другой. "
     1081        view-as alert-box ERROR   .
     1082        return no-apply.
     1083     end.
     1084   end.
     1085   add-scale = false.
     1086   input stream imp from value (file-name) .
     1087   repeat:
     1088     IMPORT stream imp UNFORMATTED text-string  .
     1089     if trim(text-string) = "" then   leave.
     1090     impc = impc + 1.
     1091     if num-entries (text-string, ";") <> 11 then do:
     1092       OUTPUT stream Err TO value ("Imp_goods.err") append.
     1093       put stream Err unformatted
     1094       string(today, "99/99/9999") " "
     1095       string(time, "HH:MM")
     1096       " Неправильное число параметров в строке, должно быть 10, в конце строки должен стоять знак ;" skip.
     1097       export stream  Err text-string .
     1098       output stream Err close.
     1099      next.
     1100     end.
     1101     assign
     1102     i-artic          = ENTRY( 1, text-string, ";")
     1103     i-name        = ENTRY( 2, text-string, ";")
     1104     i-unit-name = ENTRY( 3, text-string, ";")
     1105     i-grp            = integer(ENTRY( 4, text-string, ";"))
     1106     i-vat-code    = integer(ENTRY(5, text-string, ";"))
     1107     i-NP-code      = integer(ENTRY(6, text-string, ";"))
     1108     i-prod-bc       = ENTRY(8, text-string, ";")
     1109     log-save      = false
     1110     .
     1111       i-scale  = "/".
     1112       overlay ( i-artic, r-index(i-artic, "-"), 1) = i-scale.
     1113       i-scale = substring( i-artic, r-index(i-artic, "-") + 1 ).
     1114       i-artic = substring( i-artic, 1, r-index(i-artic, "-") - 1 ).
     1115       display
     1116       impc  label "Прочитано"
     1117       imp-save label "Сохранено"
     1118       i-artic format "x(10)" label "Артикул"
     1119       text-string format "x(40)" label "Строка файла"
     1120       with frame ff view-as dialog-box
     1121       title ": Импорт справочника товаров из файла".
     1122       pause 0.
     1123       if i-unit-name = "th" then do:
     1124         i-unit-name = "шт".
     1125       end.
     1126       else  do:
     1127         OUTPUT stream Err TO value ("Imp_goods.err") append.
     1128         put stream Err unformatted
     1129         string(today, "99/99/9999") " "
     1130         string(time, "HH:MM")
     1131         " Неизвестная единица измерения товара" skip.
     1132         export stream  Err text-string .
     1133         output stream Err close.
     1134         next.
     1135       end.
     1136       find first tbl-grp where
     1137                tbl-grp.num-grp = i-grp no-lock no-error.
     1138       if not avail tbl-grp then do:
     1139         OUTPUT stream Err TO value ("Imp_goods.err") append.
     1140         put stream err unformatted
     1141         string(today, "99/99/9999") " "
     1142         string(time, "HH:MM")
     1143         " Группа к которой хотят привезать товар отсутствует в БД" skip.
     1144         export stream  err text-string .
     1145         output stream err close.
     1146         next.
     1147       end.
     1148       _tax-rate:
     1149       for each buf_tax-rate no-lock where
     1150               buf_tax-rate.tax-code = integer('1':U):
     1151   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1152   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     1153     (input  ?
     1154     ,input  buf_tax-rate.tax-code
     1155     ,input  buf_tax-rate.rate-code
     1156     ,input  ?
     1157     ,input  v-cntxt-host-code-obj
     1158     ,input  v-cntxt-obj-type
     1159     ,input  v-cntxt-obj-code
     1160     ,output v-rate-value
     1161     ) no-error .
     1162         if not error-status:error then do:
     1163           if v-rate-value = i-vat-code then do:
     1164             leave.
     1165           end.
     1166         end.
     1167       end.
     1168       if not avail buf_tax-rate then do:
     1169         OUTPUT stream Err TO value ("Imp_goods.err") append.
     1170         put stream err unformatted
     1171         string(today, "99/99/9999") " "
     1172         string(time, "HH:MM")
     1173         substitute(" Ставка НДС с таким процентом (&1) отсутствует в БД", i-vat-code) skip.
     1174         export stream  err text-string .
     1175         output stream err close.
     1176         next.
     1177       end.
     1178       else  do:
     1179         NDS-code = buf_tax-rate.rate-code.
     1180       end.
     1181       _tax-rate:
     1182       for each buf_tax-rate no-lock where
     1183               buf_tax-rate.tax-code = integer('2':U):
     1184   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1185   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     1186     (input  ?
     1187     ,input  buf_tax-rate.tax-code
     1188     ,input  buf_tax-rate.rate-code
     1189     ,input  ?
     1190     ,input  v-cntxt-host-code-obj
     1191     ,input  v-cntxt-obj-type
     1192     ,input  v-cntxt-obj-code
     1193     ,output v-rate-value
     1194     ) no-error .
     1195         if not error-status:error then do:
     1196           if v-rate-value = i-np-code then do:
     1197             leave.
     1198           end.
     1199         end.
     1200       end.
     1201       if not avail buf_tax-rate then do:
     1202         OUTPUT stream Err TO value ("Imp_goods.err") append.
     1203         put stream err unformatted
     1204         string(today, "99/99/9999") " "
     1205         string(time, "HH:MM")
     1206         substitute(" Ставка НП с таким процентом (&1) отсутствует в БД", i-np-code) skip.
     1207         export stream  err text-string .
     1208         output stream err close.
     1209         next.
     1210       end.
     1211       else  do:
     1212         NP-code = buf_tax-rate.rate-code.
     1213       end.
     1214       find first buf_prt where
     1215             buf_prt.root    = no and
     1216             buf_prt.f-name = i-scale  no-lock no-error.
     1217       if not avail buf_prt then do:
     1218         i-color = substring( i-scale, 1, r-index(i-scale, "/") - 1 ).
     1219         i-size = substring( i-scale, r-index(i-scale, "/") + 1 ).
     1220         find first buf_prt where
     1221                 buf_prt.root    = no and
     1222                 buf_prt.node-name = i-color  no-lock no-error.
     1223         if not avail buf_prt then do:
     1224            run add-color in this-procedure  ( input i-color
     1225                                             , output reply ).
     1226            if reply = false then do:
     1227               OUTPUT stream Err TO value ("Imp_goods.err") append.
     1228               put stream err unformatted
     1229               string(today, "99/99/9999") " "
     1230               string(time, "HH:MM")
     1231               " Такая шкала отсутствует в БД" skip.
     1232               export stream  err text-string .
     1233               output stream err close.
     1234               next.
     1235            end.
     1236          add-scale = true.
     1237          end.
     1238          find first buf_prt where
     1239                   buf_prt.root    = no
     1240               and buf_prt.node-name = i-size  no-lock no-error.
     1241          if not avail buf_prt then do:
     1242            run add-size in this-procedure  ( input i-size
     1243                                             , output reply ).
     1244            if reply = false then do:
     1245               OUTPUT stream Err TO value ("Imp_goods.err") append.
     1246               put stream err unformatted
     1247               string(today, "99/99/9999") " "
     1248               string(time, "HH:MM")
     1249               " Такая шкала отсутствует в БД" skip.
     1250               export stream  err text-string .
     1251               output stream err close.
     1252               next.
     1253             end.
     1254             add-scale = true.
     1255           end.
     1256       end.
     1257       if  trim(city1) <> "" then  i-city = city1 .
     1258       find first buf_lvl-name no-lock no-error.
     1259       find first buf_gds-prt where
     1260             buf_gds-prt.prt-root  = buf_lvl-name.upper-code
     1261         and buf_gds-prt.is-term   = no
     1262         and buf_gds-prt.upper-code = buf_lvl-name.upper-code
     1263       no-lock no-error.
     1264       if not avail buf_gds-prt then do:
     1265         OUTPUT stream Err TO value ("Imp_goods.err") append.
     1266         put stream err unformatted
     1267         string(today, "99/99/9999") " "
     1268         string(time, "HH:MM")
     1269         " Корневая шкала не найдена" skip.
     1270         export stream  err text-string .
     1271         output stream err close.
     1272         next.
     1273       end.
     1274       find first buf_goods where
     1275                  buf_goods.artic = i-artic
     1276             and  buf_goods.prod-type = cli-type
     1277             and  buf_goods.prod-code = cli-code
     1278       no-lock no-error.
     1279       if not avail buf_goods then do:
     1280         do transaction:
     1281           run ref/dtaxgdss.p (
     1282                 input no
     1283               , input   i-unit-name
     1284               , input   buf_gds-prt.node-code
     1285               , input ?
     1286               , input ?
     1287               , input    v-cntxt-host-code-obj
     1288               , input    v-cntxt-obj-type
     1289               , input   v-cntxt-obj-code
     1290           ).
     1291           define variable v-recid         as recid             no-undo.
     1292           run ref/goods01.p (
     1293                 input parparentproc
     1294               , input 'ДОБАВЛЕНИЕ':U
     1295               , input no
     1296               , input 0
     1297               , input no
     1298               , input yes
     1299               , input no
     1300               , input no
     1301               , input yes
     1302               , input v-cntxt-host-code-obj
     1303               , input v-cntxt-obj-type
     1304               , input v-cntxt-obj-code
     1305               , input yes
     1306               , input ?
     1307               , input 0
     1308               , input i-artic
     1309               , input cli-type
     1310               , input cli-code
     1311               , input buf_gds-prt.node-code
     1312               , input tbl-grp.code
     1313               , input i-name
     1314               , input ""
     1315               , input i-name
     1316               , input i-name
     1317               , input replace( replace( i-name, chr( 39 ), "" ), chr( 34 ), "" )
     1318               , input i-city
     1319               , input i-unit-name
     1320               , input i-unit-name
     1321               , input 0.0
     1322               , input 0.0
     1323               , input 1
     1324               , input 1
     1325               , input 0
     1326               , input 0
     1327               , input 0
     1328               , input 0
     1329               , input 'Группа':U
     1330               , input 0
     1331               , input yes
     1332               , input 0
     1333               , input 0
     1334               , input ""
     1335               , input ""
     1336               , input ""
     1337               , input ""
     1338               , input ""
     1339               , input ""
     1340               , input 0
     1341               , input 0
     1342               , input ""
     1343               , input 0
     1344               , input 0
     1345               , input 0
     1346               , input ""
     1347               , input ""
     1348               , input ""
     1349               , input 0
     1350               , input ?
     1351               , input ""
     1352               , input no
     1353               , input no
     1354               , input no
     1355               , input no
     1356               , input "no"
     1357               , input yes
     1358               , input no
     1359               , input no
     1360               , input 0
     1361               , input-output v-recid
     1362               , output j-gds-code
     1363           ) no-error .
     1364         if error-status :error
     1365         then do:
     1366           message
     1367           vss-workfile vss-revision vss-description
     1368           skip "Ошибка создания или изменения карточки товара."
     1369           skip return-value
     1370           skip i-artic
     1371           skip trim(error-status :get-message(1))
     1372           trim(error-status :get-message(2))
     1373           trim(error-status :get-message(3))
     1374           view-as alert-box error.
     1375         end.
     1376         log-save = true.
     1377       end.
     1378     end.
     1379     find first buf_goods where
     1380               buf_goods.artic = i-artic
     1381         and  buf_goods.prod-type = cli-type
     1382         and  buf_goods.prod-code = cli-code
     1383     no-lock no-error.
     1384     if not avail buf_goods then do:
     1385       OUTPUT stream Err TO value ("Imp_goods.err") append.
     1386         put stream Err unformatted
     1387           string(today, "99/99/9999") " "
     1388           string(time, "HH:MM")
     1389           " Нет такого товара" skip.
     1390         export stream  Err text-string .
     1391       output stream Err close.
     1392     end.
     1393     find first buf_prod-bc where
     1394               buf_prod-bc.b-str  = i-prod-bc no-lock no-error.
     1395     if  not avail buf_prod-bc then do:
     1396       find first buf_gds-prt where
     1397           buf_gds-prt.prt-root = buf_lvl-name.upper-code and
     1398           buf_gds-prt.f-name = i-scale  no-lock no-error.
     1399       if  avail buf_gds-prt then do:
     1400         do transaction  :
     1401   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1403     (input  buf_goods.gds-code
     1404     ,input  buf_gds-prt.node-code
     1405     ,input  ''
     1406     ,input  ''
     1407     ,input  buf_goods.unit-base
     1408     ,input  1
     1409     ,output v-is-new
     1410     ,buffer buf_bar-code
     1411     ) no-error .
     1412           v-b-str = i-prod-bc.
     1413           run trg/prod-bc1.p (
     1414                              input parparentproc
     1415                             ,input yes
     1416                             ,input yes
     1417                             ,input yes
     1418                             ,input no
     1419                             ,input ''
     1420                             ,input ''
     1421                             ,buffer buf_goods
     1422                             ,input buf_bar-code.b-code
     1423                             ,input-output v-b-str
     1424                             ,output v-rid
     1425                              ) no-error .
     1426            if not error-status:error then do:
     1427              log-save = true.
     1428            end.
     1429            else do:
     1430               OUTPUT stream Err TO value ("Imp_goods.err") append.
     1431               put stream err unformatted
     1432               string(today, "99/99/9999") " "
     1433               string(time, "HH:MM")
     1434               substitute("Ошибка при сохранении ДопБК:&1&2&1&3", chr(10), error-status:get-message(1) , return-value ) skip.
     1435               export stream  err text-string .
     1436               output stream err close.
     1437            end.
     1438           end.
     1439         end.
     1440         else do:
     1441           OUTPUT stream Err TO value ("Imp_goods.err") append.
     1442           put stream err unformatted
     1443           string(today, "99/99/9999") " "
     1444           string(time, "HH:MM")
     1445           " Такая шкала отсутствует в БД" skip.
     1446           export stream  err text-string .
     1447           output stream err close.
     1448       end.
     1449     end.
     1450     else do:
     1451       OUTPUT stream Err TO value ("Imp_goods.err") append.
     1452       put stream err unformatted
     1453       string(today, "99/99/9999") " "
     1454       string(time, "HH:MM")
     1455       " Такой Доп-БК уже существует в БД" skip.
     1456       export stream  err text-string .
     1457       output stream err close.
     1458     end.
     1459     if   log-save = true then imp-save = imp-save + 1.
     1460   end.
     1461   input stream imp close.
     1462   message
     1463   substitute("Импорт из файла &1 закончен, прочитано &2, сохранено &3&4" +
     1464              "Все строки из файла которые не удалось импортировать можно посмотреть в файле Imp_goods.err "
     1465              , file-name
     1466              , impc
     1467              , imp-save
     1468              , chr(10)
     1469   )
     1470   view-as alert-box  INFORMATION.
     1471   END.
     1472   ON CHOOSE OF Imly-City IN FRAME Dialog-Frame
     1473   DO:
     1474   define variable v-rid-list as character no-undo .
     1475   define buffer buf_country for ub.country.
     1476   run ref/countris.w ( input parparentproc
     1477                       ,input "b-sel"
     1478                       ,input-output v-rid-list ).
     1479   if v-rid-list <> '' then     do:
     1480    FIND first buf_country no-lock WHERE
     1481            recid (buf_country) = integer(v-rid-list) no-error.
     1482    if avail buf_country then
     1483     assign
     1484     city1 = buf_country.alpha1
     1485     city2  =  buf_country.long-name
     1486     .
     1487     display
     1488     city1
     1489     city2
     1490     with frame Dialog-Frame.
     1491   end.
     1492   END.
     1493   ON CHOOSE OF Imply-Cli IN FRAME Dialog-Frame
     1494   DO:
     1495   define variable ref-list as character no-undo .
     1496   define variable ref-rec as recid no-undo .
     1497     run ref/cli-all.w ( input parparentproc
     1498                        ,input "b-sel"
     1499                        ,input 'орг':U
     1500                        ,input ?
     1501                        ,input ?
     1502                        ,input ?
     1503                        ,input ?
     1504                        ,input ?
     1505                        ,output  ref-list).
     1506    ref-rec = integer (ref-list).
     1507   if  ref-rec <> ? then do:
     1508     FIND first buf_clients no-lock WHERE recid (buf_clients) = ref-rec NO-error.
     1509     if avail buf_clients then do:
     1510       assign
     1511       Cli-type = buf_clients.obj-type
     1512       Cli-code = buf_clients.obj-code
     1513       Cli-name = buf_clients.obj-name .
     1514     end.
     1515     display
     1516     Cli-type
     1517     Cli-code
     1518     Cli-name
     1519     with frame Dialog-Frame.
     1520   end.
     1521   END.
     1522   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1523   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1524   MAIN-BLOCK:
     1525   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1526      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1527   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1528     run mainmenu_getcntxt in parparentproc
     1529       (output v-cntxt-db-num
     1530       ,output v-cntxt-userid
     1531       ,output v-cntxt-level
     1532       ,output v-cntxt-host-code-obj
     1533       ,output v-cntxt-obj-type
     1534       ,output v-cntxt-obj-code
     1535       ,output v-cntxt-db-num-obj
     1536       ,output v-cntxt-is-admin
     1537       ) .
     1538     FIND first buf_clients no-lock WHERE
     1539               buf_clients.obj-type = 'орг':U
     1540           and buf_clients.obj-code = 8 no-error.
     1541     if avail buf_clients then do:
     1542       assign
     1543       Cli-type = buf_clients.obj-type
     1544       Cli-code = buf_clients.obj-code
     1545       Cli-name = buf_clients.obj-name .
     1546       display
     1547       Cli-type
     1548       Cli-code
     1549       Cli-name
     1550       with frame Dialog-Frame.
     1551     end.
     1552     else do:
     1553       enable
     1554       Imply-Cli
     1555       with frame Dialog-Frame.
     1556     end.
     1557     RUN enable_UI.
     1558     WAIT-FOR GO OF FRAME Dialog-Frame.
     1559   END.
     1560   RUN disable_UI.
     1561   PROCEDURE add-color :
     1562   define input  parameter new-scale like ub.gds-prt.f-name no-undo .
     1563   define output parameter reply  as log no-undo .
     1564   define buffer buf-gds-prt-1  for ub.gds-prt.
     1565   define buffer buf-gds-prt-2  for ub.gds-prt.
     1566   define buffer buf_gds-prt for ub.gds-prt.
     1567   define buffer buf_lvl-name for ub.lvl-name.
     1568   define variable u-c like ub.gds-prt.upper-code no-undo.
     1569   define variable p-n like ub.gds-prt.prt-num no-undo.
     1570   define variable n-c like ub.gds-prt.node-code no-undo.
     1571   define variable p-r like ub.gds-prt.prt-root no-undo.
     1572   for each ld :
     1573     delete ld.
     1574   end.
     1575   reply = false.
     1576   for each buf_gds-prt where
     1577         buf_gds-prt.upper-code = 4 and
     1578         buf_gds-prt.node-name <> buf_gds-prt.f-name and
     1579         buf_gds-prt.is-term = yes
     1580   no-lock:
     1581       find first ld where
     1582                ld.name = buf_gds-prt.node-name no-lock no-error.
     1583       if not avail ld then do:
     1584           create ld.
     1585           assign
     1586           ld.name = buf_gds-prt.node-name
     1587           ld.num  = buf_gds-prt.prt-num
     1588           .
     1589       end.
     1590   end.
     1591   find first buf_lvl-name no-lock no-error.
     1592   if not avail buf_lvl-name then do:
     1593     reply = false.
     1594     return.
     1595   end.
     1596   find buf_gds-prt where
     1597         buf_gds-prt.upper-code = buf_lvl-name.upper-code and
     1598         buf_gds-prt.prt-num    = 0
     1599   no-lock no-error.
     1600   if not avail buf_gds-prt then do:
     1601     reply = false.
     1602     return.
     1603   end.
     1604   u-c = buf_gds-prt.node-code .
     1605   find last buf_gds-prt  no-lock use-index pi no-error.
     1606   if not avail buf_gds-prt then do:
     1607     reply = false.
     1608     return.
     1609   end.
     1610   n-c = buf_gds-prt.node-code.
     1611   find last buf_gds-prt no-lock  where
     1612            buf_gds-prt.upper-code =  u-c
     1613   use-index level no-error.
     1614   if not avail buf_gds-prt then do:
     1615     reply = false.
     1616     return.
     1617   end.
     1618   p-n = buf_gds-prt.prt-num.
     1619   do transaction:
     1620     create buf-gds-prt-1.
     1621     assign
     1622     buf-gds-prt-1.node-code   =  n-c + 1
     1623     buf-gds-prt-1.upper-code  = u-c
     1624     buf-gds-prt-1.node-name    = new-scale
     1625     buf-gds-prt-1.prt-num     = p-n + 1
     1626     buf-gds-prt-1.root        = no
     1627     buf-gds-prt-1.lvl-num     = ub.lvl-name.level
     1628     buf-gds-prt-1.f-name      = new-scale
     1629     buf-gds-prt-1.is-term     = no
     1630     buf-gds-prt-1.prt-root    = lvl-name.upper-code
     1631     .
     1632     n-c = n-c + 1.
     1633     for each ld no-lock :
     1634       create buf-gds-prt-2.
     1635       assign
     1636       buf-gds-prt-2.node-code   = n-c  + 1
     1637       buf-gds-prt-2.upper-code  = buf-gds-prt-1.node-code
     1638       buf-gds-prt-2.node-name    = ld.name
     1639       buf-gds-prt-2.prt-num     = ld.num
     1640       buf-gds-prt-2.root        = no
     1641       buf-gds-prt-2.lvl-num     = 1
     1642       buf-gds-prt-2.f-name      = trim(buf-gds-prt-1.f-name) + "/" + trim(ld.name)
     1643       buf-gds-prt-2.is-term     = yes
     1644       buf-gds-prt-2.prt-root    = lvl-name.upper-code
     1645       .
     1646       n-c = n-c + 1.
     1647     end.
     1648     reply = true.
     1649   end.
     1650   END PROCEDURE.
     1651   PROCEDURE add-size :
     1652   define input  parameter new-scale like ub.gds-prt.f-name no-undo .
     1653   define output parameter reply  as log no-undo .
     1654   define buffer buf_gds-prt for ub.gds-prt.
     1655   define buffer buf-gds-prt-1  for ub.gds-prt.
     1656   define buffer buf-gds-prt-2  for ub.gds-prt.
     1657   define buffer buf_lvl-name for ub.lvl-name.
     1658   define variable u-c like ub.gds-prt.upper-code no-undo.
     1659   define variable p-n like ub.gds-prt.prt-num no-undo.
     1660   define variable n-c like ub.gds-prt.node-code no-undo.
     1661   define variable p-r like ub.gds-prt.prt-root no-undo.
     1662   for each ld :
     1663     delete ld.
     1664   end.
     1665   reply = false.
     1666   p-n = 0.
     1667   find last buf_gds-prt no-lock where
     1668       buf_gds-prt.upper-code = 4 use-index level no-error.
     1669   if not avail buf_gds-prt then do:
     1670     reply = false.
     1671     return.
     1672   end.
     1673   p-n = buf_gds-prt.prt-num.
     1674   for each buf_gds-prt where
     1675       buf_gds-prt.upper-code = 3
     1676   and buf_gds-prt.node-name = buf_gds-prt.f-name
     1677   and buf_gds-prt.is-term = no
     1678   no-lock:
     1679     find first ld where
     1680        ld.name = buf_gds-prt.node-name no-lock no-error.
     1681     if not avail ld then do:
     1682       create ld.
     1683       assign
     1684       ld.name = buf_gds-prt.node-name
     1685       ld.num    = buf_gds-prt.prt-num
     1686       ld.ord     = buf_gds-prt.node-code
     1687       .
     1688     end.
     1689   end.
     1690   find first buf_lvl-name no-lock no-error.
     1691   if not avail buf_lvl-name then do:
     1692     reply = false.
     1693     return.
     1694   end.
     1695   find last buf_gds-prt  no-lock use-index pi no-error.
     1696   if not avail buf_gds-prt then do:
     1697     reply = false.
     1698     return.
     1699   end.
     1700   n-c = buf_gds-prt.node-code.
     1701   do transaction:
     1702     for each ld no-lock:
     1703       create buf-gds-prt-1.
     1704       assign
     1705       buf-gds-prt-1.node-code    =  n-c + 1
     1706       buf-gds-prt-1.upper-code   = ld.ord
     1707       buf-gds-prt-1.node-name    = new-scale
     1708       buf-gds-prt-1.prt-num      = p-n + 1
     1709       buf-gds-prt-1.root         = no
     1710       buf-gds-prt-1.lvl-num      = 1
     1711       buf-gds-prt-1.f-name       = ld.name + "/" + new-scale
     1712       buf-gds-prt-1.is-term      = yes
     1713       buf-gds-prt-1.prt-root     = buf_lvl-name.upper-code
     1714         .
     1715       n-c = n-c + 1.
     1716       reply = true.
     1717     end.
     1718   end.
     1719   END PROCEDURE.
     1720   PROCEDURE disable_UI :
     1721     HIDE FRAME Dialog-Frame.
     1722   END PROCEDURE.
     1723   PROCEDURE enable_UI :
     1724     DISPLAY Cli-code Cli-type Cli-Name city1 city2
     1725         WITH FRAME Dialog-Frame.
     1726     ENABLE Imly-City b-exit b-quit Cli-code Cli-type Cli-Name city1 city2
     1727         WITH FRAME Dialog-Frame.
     1728     VIEW FRAME Dialog-Frame.
     1729   END PROCEDURE.
