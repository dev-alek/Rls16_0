        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cre-db-num     as integer      no-undo .
        6   define input parameter p-task-type      as character    no-undo.
        7   define input parameter p-task-num       as integer      no-undo.
        8   define input parameter p-db-num         as integer      no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: dctxtesr.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: cus/dctxtesr.p $":U .
       14   define variable vss-description as character no-undo init "Экспорт данных по продажам по ДК в текстовый файл - исполняемый модуль - вызов по расписанию".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define  shared variable g#auto-pid           as integer   no-undo .
       86   define  shared variable conn-par             as character no-undo .
       87   define  shared variable g#auto-user-id       as character no-undo .
       88   define  shared variable g#auto-user-login    as character no-undo .
       89   define  shared variable g#auto-user-password as character no-undo .
       90   define  shared variable v-socket             as logical   no-undo .
       91   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define  shared variable auto-window-h     as handle    no-undo .
       93   define  shared variable auto-log-msg-h    as handle    no-undo .
       94   define  shared variable hand-log-msg-h    as handle    no-undo .
       95   define  shared variable log-file-name     as character no-undo initial ? .
       96   define  shared variable add-log-file-name as character no-undo initial ? .
       97   define  shared variable writelogvalue     as character no-undo initial ? .
       98   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   procedure cur-time :
      100      define output parameter p-today as date      no-undo .
      101      define output parameter p-time  as integer   no-undo .
      102     do
      103     on error undo, return error
      104     :
      105       define variable v-date1 as date      no-undo .
      106       define variable v-date2 as date      no-undo .
      107       define variable v-time  as integer   no-undo .
      108       assign
      109         v-date1 = today
      110         v-time  = time
      111         v-date2 = today
      112       .
      113       if v-date1 <> v-date2
      114       then do:
      115         assign
      116           v-date1 = today
      117           v-time  = v-time
      118         .
      119       end.
      120       assign
      121         p-today = v-date1
      122         p-time  = v-time
      123       .
      124     end.
      125   end.
      126   function cur-time-date returns character
      127   :
      128     return string(today, '99/99/9999':U) .
      129   end.
      130   function cur-time-mjd returns decimal
      131   :
      132     define variable v-date as date      no-undo .
      133     define variable v-time as integer   no-undo .
      134     run cur-time in this-procedure
      135       (output v-date
      136       ,output v-time
      137       ) .
      138     return integer(v-date) - 2400002 + (v-time / 86400) .
      139   end.
      140   function cur-time-get-ending-index returns integer
      141   (input p-number as integer
      142   )
      143   :
      144     if p-number < 0
      145     or p-number = ?
      146     then do:
      147       return 1 .
      148     end.
      149     define variable v-rest as integer   no-undo .
      150     assign
      151       p-number = p-number modulo 100
      152     .
      153     if p-number < 20
      154     then do:
      155       assign
      156         v-rest = p-number
      157       .
      158     end.
      159     else do:
      160       assign
      161         v-rest = p-number modulo 10
      162       .
      163     end.
      164     case v-rest :
      165       when 1
      166       then do:
      167         return 2 .
      168       end.
      169       when 2 or
      170       when 3 or
      171       when 4
      172       then do:
      173         return 3 .
      174       end.
      175       otherwise do:
      176         return 1 .
      177       end.
      178     end case .
      179   end.
      180   procedure cur-time-mjd-to-date :
      181      define input  parameter i-mjd-diff as decimal no-undo.
      182      define output parameter o-Date     as date    no-undo.
      183      define output parameter o-Time     as integer no-undo.
      184      define variable v-day-number as integer   no-undo .
      185      if    i-mjd-diff < 0
      186         or i-mjd-diff = ?
      187      then do:
      188         return "?" .
      189      end.
      190      assign
      191         v-day-number = truncate(i-mjd-diff,0).
      192         o-Date = date(v-day-number + 2400002).
      193         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      194     .
      195   end.
      196   function cur-time-mjd-to-string returns character
      197   (input p-mjd-diff as decimal
      198   )
      199   :
      200     define variable v-day-number as integer   no-undo .
      201     define variable v-seconds    as integer   no-undo .
      202     define variable v-hour       as integer   no-undo .
      203     define variable v-min        as integer   no-undo .
      204     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      205     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      206     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      207     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      208     if p-mjd-diff < 0
      209     or p-mjd-diff = ?
      210     then do:
      211       return "?" .
      212     end.
      213     assign
      214       v-day-number = integer(truncate(p-mjd-diff,0))
      215       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      216     .
      217     if v-seconds > 86400
      218     then do:
      219       assign
      220         v-seconds = 86400 - 1
      221       .
      222     end.
      223     if v-seconds < 0
      224     then do:
      225       assign
      226         v-seconds = 0
      227       .
      228     end.
      229     assign
      230       v-hour = truncate(v-seconds / 3600, 0)
      231     .
      232     assign
      233       v-seconds = v-seconds modulo 3600
      234     .
      235     assign
      236       v-min = truncate(v-seconds / 60, 0)
      237     .
      238     assign
      239       v-seconds = v-seconds modulo 60
      240     .
      241     return
      242         (if v-day-number <> 0
      243           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      244           else ""
      245         )
      246       + (if v-day-number <> 0 or v-hour <> 0
      247           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      248           else ""
      249         )
      250       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      251           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      252           else ""
      253         )
      254       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      255       .
      256   end.
      257   function cur-time-string returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      266   end.
      267   function cur-time-string-sec returns character
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      276   end.
      277   function cur-time-custom  returns character
      278   (input p-prefix as character
      279   ,input p-date-format as character
      280   ,input p-delimiter as character
      281   ,input p-time-format as character
      282   ,input p-suffix as character
      283   )
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return
      292       p-prefix
      293       + string(v-date, p-date-format)
      294       + p-delimiter
      295       + string(v-time, p-time-format)
      296       + p-suffix
      297       .
      298   end.
      299   function cur-time-print  returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      308   end.
      309   function cur-time-datetime returns datetime
      310   :
      311     define variable v-char as character no-undo .
      312     define variable v-datetime as datetime no-undo .
      313     v-char = cur-time-string().
      314     v-datetime = datetime(v-char).
      315     return  v-datetime.
      316   end.
      317   function cur-time-string-msec returns character
      318   :
      319     define variable v-date as datetime  no-undo .
      320     v-date = now.
      321     return string(v-date) .
      322   end.
      323   define stream LogStream .
      324   define variable mNoTime as logical no-undo.
      325   procedure write-to-log-notime :
      326     define input param i-str as character no-undo .
      327     mNoTime = yes.
      328     run write-to-log (i-str).
      329     mNoTime = no.
      330   end.
      331   procedure write-to-log :
      332     define input param p-str as character no-undo .
      333     do
      334     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      335     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      336     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      337     :
      338       define variable log-res        as logical   no-undo .
      339       define variable v-jj           as integer   no-undo .
      340       if    mNoTime
      341          or writelogvalue eq "AsyncProc"
      342       then
      343          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      344       else
      345          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      346       if auto-log-msg-h <> ? then do:
      347         log-res = auto-log-msg-h:move-to-eof( ) .
      348         log-res = auto-log-msg-h:insert-string( p-str ).
      349       end.
      350       if hand-log-msg-h <> ? then do:
      351         log-res = hand-log-msg-h:move-to-eof( ) .
      352         log-res = hand-log-msg-h:insert-string( p-str ).
      353       end.
      354       assign
      355         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      356         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      357         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      358       .
      359       if add-log-file-name <> ? then do:
      360         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      361           run gbl/fileapnd.p
      362             ( input entry(v-jj, add-log-file-name, chr(1) )
      363             ,input p-str
      364             ,input 20
      365             ) no-error .
      366           if error-status:error then do:
      367             return error return-value .
      368           end.
      369         end.
      370       end.
      371       if writelogvalue eq "AsyncProc"
      372       then do:
      373          p-str = trim(p-str, (chr(13) + chr(10)) )
      374       .
      375          Publish "WriteLogAsunc" (p-str,yes).
      376       end.
      377       else if writelogvalue <> "yes" then do:
      378         run gbl/fileapnd.p
      379           ( input log-file-name
      380           ,input p-str
      381           ,input 20
      382           ) no-error .
      383         if error-status:error then do:
      384           return error return-value .
      385         end.
      386       end.
      387     end.
      388   end procedure.
      389   procedure write-to-screen :
      390     define input param p-str as character no-undo .
      391     do
      392     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      393     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      394     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      395     :
      396       define variable log-res as logical no-undo.
      397       assign
      398         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      399       .
      400       if auto-log-msg-h <> ?
      401       then do:
      402         log-res = auto-log-msg-h:move-to-eof( ) .
      403         log-res = auto-log-msg-h:insert-string( p-str ).
      404       end.
      405       if hand-log-msg-h <> ?
      406       then do:
      407         log-res = hand-log-msg-h:move-to-eof( ) .
      408         log-res = hand-log-msg-h:insert-string( p-str ).
      409       end.
      410     end.
      411   end procedure.
      412   procedure send-msg-to-email :
      413     define input  parameter p-subject      as character no-undo .
      414     define input  parameter p-text-err     as character no-undo .
      415     define input  parameter p-attach-files as character no-undo .
      416     do
      417     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      418     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      419     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      420     :
      421       define variable v-tth             as handle    no-undo .
      422       define variable v-value-character as character no-undo .
      423       define variable v-value-date      as date      no-undo .
      424       define variable v-value-decimal   as decimal   no-undo .
      425       define variable v-value-integer   as integer   no-undo .
      426       define variable v-value-logical   as logical   no-undo .
      427       define variable v-param-type      as character no-undo .
      428       define variable v-email       as character no-undo .
      429       define variable v-tmp-str     as character no-undo .
      430       define variable v-tmp1-str    as character no-undo .
      431       define variable v-ind         as integer   no-undo .
      432       define variable v-num-entries as integer   no-undo .
      433       delete object v-tth no-error.
      434       run adm/shattri.p
      435         ( input "get":U
      436          ,input  "":U
      437          ,input  0
      438          ,input  'auto-task':U
      439          ,input  'send-msg-to-email':U
      440          ,output v-value-character
      441          ,output v-value-date
      442          ,output v-value-decimal
      443          ,output v-value-integer
      444          ,output v-value-logical
      445          ,output v-param-type
      446          ,input-output table-handle v-tth
      447         ) no-error .
      448       if not error-status :error  then do:
      449         assign
      450           v-tmp-str = v-value-character
      451         .
      452       end.
      453       delete object v-tth no-error.
      454       assign
      455         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      456         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      457         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      458         v-num-entries = num-entries( v-tmp-str, chr(44) )
      459         v-email       = "":U
      460       .
      461       do v-ind = 1 to v-num-entries
      462       :
      463         assign
      464           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      465         .
      466         if trim( v-tmp1-str ) <> "":U then do:
      467           if v-email = "":U then do:
      468             assign
      469               v-email = v-tmp1-str
      470             .
      471           end.
      472           else do:
      473             assign
      474               v-email = v-email + chr(44) + v-tmp1-str
      475             .
      476           end.
      477         end.
      478       end.
      479       if v-email <> "":U then do:
      480         run gbl/sendmail.p
      481           ( input v-email
      482           , input p-subject
      483           , input p-text-err
      484           , input p-attach-files
      485           ) no-error .
      486         if error-status :error
      487           or return-value <> "":U
      488         then do:
      489           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      490         end.
      491       end.
      492     end.
      493   end procedure.
      494   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      495   define temp-table temp-schedule-free no-undo
      496   field free-id as character
      497   field free-task-name as character
      498   field proc-run-name as character
      499   field proc-param-edit-name as character
      500   field conf-param as character
      501   field is-gbd as logical
      502   field is-ubd as logical
      503   field enable-concurrent-0 as logical
      504   field enable-concurrent-db as logical
      505   field other-info as character
      506   field enc-key as character
      507   field is-rum as logical
      508   index pi is unique primary
      509   free-id.
      510   procedure schedule-attr-name :
      511   do
      512     on error undo, return error
      513     :
      514     define input  parameter p-code           as character no-undo .
      515     define output parameter p-type           as character no-undo .
      516     define output parameter p-format         as character no-undo .
      517     define output parameter p-label          as character no-undo .
      518     define output parameter p-user-can-edit  as logical   no-undo .
      519     define output parameter p-output-display as logical   no-undo .
      520     define output parameter p-other          as character no-undo .
      521       if index(p-code, chr(4)) > 0 then do:
      522         p-code = entry(1, p-code, chr(4)).
      523       end.
      524       case p-code :
      525               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      526               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      527               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      528               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      529               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      530               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      531               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      532               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      533               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      534         otherwise do:
      535           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      536         end.
      537       end.
      538     end.
      539   end procedure.
      540   procedure schedule-attr-tooltip :
      541   do
      542     on error undo, return error
      543     :
      544       define input  parameter p-code    as character no-undo .
      545       define output parameter p-tooltip as character no-undo .
      546       define output parameter p-label   as character no-undo .
      547       if index(p-code, chr(4)) > 0 then do:
      548         p-code = entry(1, p-code, chr(4)).
      549       end.
      550       case p-code :
      551               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      552               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      553               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      554               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      555               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      556               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      557               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      558               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      559               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      560         otherwise do:
      561               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      562         end.
      563       end.
      564     end.
      565   end procedure.
      566   procedure schedule-attr-value :
      567   do
      568   on error undo, return error return-value
      569   :
      570   define input parameter  p-cre-db-num as integer    no-undo.
      571   define input parameter  p-task-type  as character  no-undo.
      572   define input parameter  p-task-num   as integer    no-undo.
      573   define input parameter  p-code       as character  no-undo.
      574   define output parameter p-value      as character  no-undo.
      575   define output parameter p-type       as character  no-undo.
      576       define variable v-format         as character no-undo .
      577       define variable v-label          as character no-undo .
      578       define variable v-user-can-edit  as logical   no-undo .
      579       define variable v-output-display as logical   no-undo .
      580       define variable v-other          as character no-undo .
      581       define buffer buf_schedule-attr for ub.schedule-attr.
      582       run schedule-attr-name in this-procedure (
      583             input  p-code
      584           , output p-type
      585           , output v-format
      586           , output v-label
      587           , output v-user-can-edit
      588           , output v-output-display
      589           , output v-other
      590       ) no-error .
      591       if error-status :error
      592       then do:
      593           undo, return error return-value .
      594       end.
      595       if p-code begins ('schd-free-id':U + chr(4))
      596       and entry(2, p-code, chr(4)) = '':U then do:
      597         find first buf_schedule-attr no-lock
      598             where buf_schedule-attr.cre-db-num = p-cre-db-num
      599               and buf_schedule-attr.task-type  = p-task-type
      600               and buf_schedule-attr.task-num   = p-task-num
      601               and buf_schedule-attr.attr-code  begins p-code
      602         no-error .
      603       end.
      604       else do:
      605         find first buf_schedule-attr no-lock
      606             where buf_schedule-attr.cre-db-num = p-cre-db-num
      607               and buf_schedule-attr.task-type  = p-task-type
      608               and buf_schedule-attr.task-num   = p-task-num
      609               and buf_schedule-attr.attr-code  = p-code
      610         no-error .
      611       end.
      612       if available buf_schedule-attr
      613       then do:
      614           assign
      615               p-value = buf_schedule-attr.attr-value
      616           .
      617       end.
      618       else do:
      619         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      620            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      621         end.
      622         else do:
      623           assign
      624               p-value = if p-type = 'L':U then "no":U else ""
      625           .
      626         end.
      627       end.
      628   end.
      629   end procedure.
      630   procedure schedule-attr-write :
      631   do
      632   on error undo, return error
      633   :
      634   define input parameter p-cre-db-num  as integer   no-undo.
      635   define input parameter p-task-type   as character no-undo.
      636   define input parameter p-task-num    as integer   no-undo.
      637   define input parameter p-code        as character no-undo.
      638   define input parameter p-value       as character no-undo.
      639       define variable v-type              as character                no-undo.
      640       define variable v-format            as character                no-undo.
      641       define variable v-label             as character                no-undo.
      642       define variable v-user-can-edit     as logical                  no-undo.
      643       define variable v-output-display    as logical                  no-undo.
      644       define variable v-other             as character                no-undo.
      645       define buffer buf_schedule-attr for ub.schedule-attr .
      646       run schedule-attr-name in this-procedure (
      647             input  p-code
      648           , output v-type
      649           , output v-format
      650           , output v-label
      651           , output v-user-can-edit
      652           , output v-output-display
      653           , output v-other
      654       ) no-error.
      655       if error-status :error
      656       then do:
      657           undo, return error return-value.
      658       end.
      659       find first buf_schedule-attr exclusive-lock
      660            where buf_schedule-attr.cre-db-num = p-cre-db-num
      661              and buf_schedule-attr.task-type  = p-task-type
      662              and buf_schedule-attr.task-num   = p-task-num
      663              and buf_schedule-attr.attr-code  = p-code
      664       no-error.
      665       if not available buf_schedule-attr
      666       then do:
      667           create buf_schedule-attr.
      668           assign
      669             buf_schedule-attr.cre-db-num = p-cre-db-num
      670             buf_schedule-attr.task-type  = p-task-type
      671             buf_schedule-attr.task-num   = p-task-num
      672             buf_schedule-attr.attr-code  = p-code
      673             buf_schedule-attr.attr-value = p-value
      674           .
      675       end.
      676       else do:
      677           assign
      678               buf_schedule-attr.attr-value = p-value
      679           .
      680       end.
      681   end.
      682   end procedure.
      683   procedure schedule-attr-delete :
      684   do
      685   on error undo, return error
      686   :
      687   define input  parameter p-cre-db-num  as integer   no-undo.
      688   define input  parameter p-task-type   as character no-undo.
      689   define input  parameter p-task-num    as integer   no-undo.
      690   define input  parameter p-code        as character no-undo.
      691   define output parameter p-deleted     as logical   no-undo.
      692       define buffer buf_schedule-attr for ub.schedule-attr .
      693       define variable v-type              as character                no-undo.
      694       define variable v-format            as character                no-undo.
      695       define variable v-label             as character                no-undo.
      696       define variable v-user-can-edit     as logical                  no-undo.
      697       define variable v-output-display    as logical                  no-undo.
      698       define variable v-other             as character                no-undo.
      699       run schedule-attr-name in this-procedure (
      700             input p-code
      701           , output v-type
      702           , output v-format
      703           , output v-label
      704           , output v-user-can-edit
      705           , output v-output-display
      706           , output v-other
      707       ) no-error .
      708       if error-status :error
      709       then do:
      710           undo, return error return-value .
      711       end.
      712       find first buf_schedule-attr exclusive-lock
      713            where buf_schedule-attr.cre-db-num = p-cre-db-num
      714              and buf_schedule-attr.task-type  = p-task-type
      715              and buf_schedule-attr.task-num   = p-task-num
      716              and buf_schedule-attr.attr-code  = p-code
      717       no-error.
      718       if not available buf_schedule-attr
      719       then do:
      720           assign
      721               p-deleted = no
      722           .
      723       end.
      724       else do:
      725           delete buf_schedule-attr.
      726           assign
      727               p-deleted = yes
      728           .
      729       end.
      730   end.
      731   end procedure.
      732   procedure schedule-attr-news :
      733   do
      734   on error undo, return error
      735   :
      736       define input  parameter p-code           as character no-undo .
      737       define output parameter p-news           as logical   no-undo .
      738       if index(p-code, chr(4)) > 0 then do:
      739         p-code = entry(1, p-code, chr(4)).
      740       end.
      741       case p-code :
      742               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      743               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      744               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      745               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      746               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      747               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      748               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      749               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      750               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      751         otherwise do:
      752           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      753         end.
      754       end.
      755   end.
      756   end procedure.
      757   procedure schedule-attr-extract-logical :
      758   do
      759   on error undo, return error
      760   :
      761   define input  parameter p-parameter-number   as integer      no-undo.
      762   define input  parameter p-parameter-list     as character    no-undo.
      763   define output parameter p-parameter-value   as logical      no-undo.
      764       if num-entries( p-parameter-list ) > p-parameter-number - 1
      765       then do:
      766           assign
      767               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      768           .
      769       end.
      770       else do:
      771           assign
      772               p-parameter-value   = no
      773           .
      774       end.
      775   end.
      776   end procedure.
      777   procedure schedule-attr-get-free-id :
      778   do
      779   on error undo, return error return-value
      780   :
      781     define input  parameter p-cre-db-num  as integer   no-undo.
      782     define input  parameter p-task-type   as character no-undo.
      783     define input  parameter p-task-num    as integer   no-undo.
      784     define output parameter p-free-id     as character no-undo.
      785     define buffer buf_schedule-attr for ub.schedule-attr.
      786     find first buf_schedule-attr no-lock
      787         where buf_schedule-attr.cre-db-num = p-cre-db-num
      788           and buf_schedule-attr.task-type  = p-task-type
      789           and buf_schedule-attr.task-num   = p-task-num
      790           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      791     no-error .
      792     if available buf_schedule-attr then
      793     assign
      794     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      795     no-error
      796     .
      797   end.
      798   end procedure.
      799   procedure schedule-attr-get-free-props :
      800     define input parameter p-free-id as character no-undo .
      801     define output parameter p-value as character no-undo .
      802     define buffer buf_temp-schedule-free for temp-schedule-free.
      803     do
      804     on error undo, return error return-value
      805     :
      806       find first buf_temp-schedule-free no-lock no-error .
      807       if not available buf_temp-schedule-free then do:
      808         run schedule-attr-fill-free-props in this-procedure .
      809       end.
      810       find first buf_temp-schedule-free where
      811               buf_temp-schedule-free.free-id = p-free-id no-error.
      812       if available buf_temp-schedule-free then do:
      813         assign
      814         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      815                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      816                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      817                   buf_temp-schedule-free.conf-param           + chr(4) +
      818                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      819                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      820                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      821                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      822                   buf_temp-schedule-free.other-info
      823         .
      824       end.
      825       else do:
      826        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      827                              "id произвольной задачи - &5"
      828                              ,vss-workfile
      829                              ,vss-revision
      830                              ,vss-description
      831                              ,chr(10)
      832                              ,p-free-id).
      833       end.
      834     end.
      835   end procedure.
      836   procedure schedule-attr-is-rum-free-id :
      837   define input parameter p-free-id as character no-undo .
      838   define output parameter p-is-rum as logical no-undo .
      839   define buffer buf_temp-schedule-free for temp-schedule-free.
      840   do
      841   on error undo, return error
      842   :
      843       find first buf_temp-schedule-free no-lock no-error .
      844       if not available buf_temp-schedule-free then do:
      845         run schedule-attr-fill-free-props in this-procedure .
      846       end.
      847       find first buf_temp-schedule-free where
      848               buf_temp-schedule-free.free-id = p-free-id no-error.
      849       if available buf_temp-schedule-free
      850       and buf_temp-schedule-free.is-rum
      851       then do:
      852         p-is-rum = yes.
      853       end.
      854   end.
      855   end procedure.
      856   procedure schedule-attr-fill-free-props :
      857   define variable v-path                    as character                no-undo .
      858   DEFINE VARIABLE v-full-path               as character                no-undo .
      859   DEFINE VARIABLE v-file-name               as character                no-undo .
      860   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      861   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      862   define buffer buf_temp-schedule-free for temp-schedule-free.
      863   define variable v-answer as logical no-undo .
      864     do
      865     on error undo, return error substitute("&1 &2 &3&4&5&4"
      866                                           ,vss-workfile
      867                                           ,vss-revision
      868                                           ,vss-description
      869                                           ,chr(10)
      870                                           ,error-status:get-message(1) )
      871     :
      872       run gbl/filename.p (
      873                       input 'cmp/shd-free.d'
      874                     ,output v-full-path
      875                     ,output v-path
      876                     ,output v-file-name
      877                     ,output v-file-name-no-ext
      878                     ,output v-file-name-ext
      879                     ) .
      880       input from value(v-full-path).
      881       repeat :
      882         create buf_temp-schedule-free.
      883         import buf_temp-schedule-free.
      884       END.
      885       input close.
      886       _ff:
      887       for each buf_temp-schedule-free :
      888         if buf_temp-schedule-free.free-id = '':U then do:
      889            delete buf_temp-schedule-free.
      890            next _ff.
      891          end.
      892          run schedule-attr-check-enc in this-procedure (
      893                                                       input  buf_temp-schedule-free.free-id
      894                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      895                                                               buf_temp-schedule-free.proc-param-edit-name +
      896                                                               buf_temp-schedule-free.conf-param +
      897                                                               string(buf_temp-schedule-free.is-gbd) +
      898                                                               string(buf_temp-schedule-free.is-ubd) +
      899                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      900                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      901                                                               string(buf_temp-schedule-free.other-info)
      902                                                               )
      903                                                       ,input  buf_temp-schedule-free.enc-key
      904                                                       ,output v-answer    ) no-error .
      905          if error-status:error
      906          or not v-answer then delete buf_temp-schedule-free.
      907        end.
      908     end.
      909   end procedure.
      910   Function schedule-attr-reverse returns character (str as character).
      911      define variable rev_incl_s as character init "" no-undo .
      912      define variable rev_incl_i as integer no-undo .
      913      define variable rev_incl_l as integer no-undo .
      914      rev_incl_l = length(str).
      915      do rev_incl_i = 1 to rev_incl_l:
      916         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      917      end.
      918      return rev_incl_s.
      919   end.
      920   procedure schedule-attr-check-enc.
      921     define input  parameter p-free-id   as character no-undo .
      922     define input  parameter p-value     as character no-undo .
      923     define input  parameter p-enc-value as character no-undo .
      924     define output parameter p-answer    as logical   no-undo .
      925     define variable tmp         as character no-undo .
      926     define variable v-enc-value as character no-undo .
      927     assign
      928     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      929     .
      930     run schedule-attr-pswd-enc in this-procedure
      931       ( input tmp
      932        ,output v-enc-value
      933       ) no-error .
      934     if error-status:error then do:
      935       message
      936         vss-workfile vss-revision vss-description skip
      937         "Ошибка при вызове процедуры pswd-enc" skip
      938         return-value skip
      939         error-status :get-message(1) skip
      940         view-as alert-box error .
      941       undo, return error .
      942     end.
      943     if v-enc-value = p-enc-value then do:
      944       assign
      945         p-answer = true
      946       .
      947     end.
      948     else do:
      949       assign
      950         p-answer = false
      951       .
      952     end.
      953   end.
      954   procedure schedule-attr-conf-enc.
      955     define input  parameter p-free-id   as character no-undo .
      956     define input  parameter p-value     as character no-undo .
      957     define output parameter p-enc-value as character no-undo .
      958     define variable tmp         as character no-undo .
      959     assign
      960       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      961     .
      962     run schedule-attr-pswd-enc in this-procedure
      963       ( input tmp
      964        ,output p-enc-value
      965       ) no-error .
      966     if error-status:error then do:
      967       message
      968         vss-workfile vss-revision vss-description skip
      969         "Ошибка при вызове процедуры pswd-enc" skip
      970         return-value skip
      971         error-status :get-message(1) skip
      972         view-as alert-box error .
      973       undo, return error .
      974     end.
      975   end procedure.
      976   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   procedure schedule-attr-pswd-enc :
      978     define input parameter  pswd     as character no-undo .
      979     define output parameter enc-pswd as character no-undo .
      980     do
      981     on error undo, return error return-value
      982     :
      983       assign
      984         enc-pswd = encode(pswd + string(index(pswd, "k")))
      985       .
      986     end.
      987   end procedure.
      988   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   PROCEDURE verify-ini-entry:
      990   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      991   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      992   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      993   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      994   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      995   define variable v-mess as character no-undo .
      996   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      997   if ini-entry-value = ? and ini-key-name begins "spl"
      998   then
      999   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1000   if ini-entry-value = ? and ini-key-name begins "sav"
     1001   then
     1002   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1003   if ini-entry-value = ? then do:
     1004     assign
     1005     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1006                       , chr(10)
     1007                       , ini-section-name
     1008                       , ini-key-name
     1009                       , error-msg-text).
     1010       if not silence then do:
     1011         message
     1012         v-mess
     1013         view-as alert-box ERROR  .
     1014         return error.
     1015       end.
     1016       else do:
     1017         return error v-mess.
     1018       end.
     1019   end.
     1020   END PROCEDURE.
     1021   PROCEDURE verify-file:
     1022   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1023   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1024   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1025   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1026   file-info:file-name = filename.
     1027   found = NOT (file-info:full-pathname = ?).
     1028   if NOT found  then do:
     1029     if not silence then do:
     1030       message error-msg-text
     1031       view-as alert-box ERROR.
     1032       return error.
     1033     end.
     1034     else return error error-msg-text.
     1035   end.
     1036   END PROCEDURE.
     1037   do
     1038   on error undo, return error return-value
     1039   :
     1040     define variable v-counter                   as integer      no-undo.
     1041     define variable v-param-list                as character    no-undo.
     1042     define variable v-param-type                as character    no-undo.
     1043     define variable v-range                     as integer      no-undo.
     1044     define variable v-host-code                 as integer      no-undo.
     1045     define variable v-parameter                 as character    no-undo .
     1046     define variable v-dir-name  as character no-undo .
     1047     define variable v-dir-type  as character no-undo .
     1048     define variable v-can-write as logical   no-undo .
     1049     define variable v-file-rule as character no-undo .
     1050     define variable v-file-name as character no-undo .
     1051     define variable v-dc-type-list as character no-undo .
     1052     define variable glog        as logical   no-undo .
     1053     define variable v-ii          as integer   no-undo .
     1054     DEFINE VARIABLE v-today as date no-undo .
     1055     DEFINE VARIABLE v-time as integer no-undo .
     1056     define variable v-other-params as character no-undo .
     1057     define variable v-rule-profile-id as integer   no-undo .
     1058     define variable v-codex-id as integer no-undo init 5.
     1059     define variable v-ruleset-id as integer no-undo init 1.
     1060     define variable v-rid-list as character no-undo .
     1061     define buffer buf_rule-call-param for ub.rule-call-param.
     1062     DEFINE NEW SHARED TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
     1063     define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1064     DEFINE BUFFER X_dis-card-type FOR ub.dis-card-type.
     1065     DEFINE BUFFER X_rp-by-call FOR ub.rp-by-call.
     1066     DEFINE BUFFER X_rule FOR ub.rule.
     1067     DEFINE BUFFER X_rule-by-profile FOR ub.rule-by-profile.
     1068     DEFINE BUFFER X_rule-profile FOR ub.rule-profile.
     1069     DEFINE BUFFER X_rule-by-call FOR ub.rule-by-call.
     1070     define stream OutStream.
     1071       assign
     1072       log-file-name = "shd-free.log".
     1073       run schedule-attr-value in this-procedure (
     1074             input p-cre-db-num
     1075           , input p-task-type
     1076           , input p-task-num
     1077           , input 'schedule-param-list':U
     1078           , output v-param-list
     1079           , output v-param-type
     1080       ).
     1081       if v-param-list = "":U then do:
     1082          run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Не заданы параметры экспорта данных по продажам по ДК в текстовый файл в задаче &1&2"                                      , p-task-num                                                                                                            , chr(10))).
     1083          return.
     1084       end.
     1085       assign
     1086       v-rule-profile-id = integer(entry(1, v-param-list, chr(4) ))
     1087       v-dir-name = entry(2, v-param-list, chr(4) )
     1088       v-file-rule = entry(3, v-param-list, chr(4) )
     1089       v-file-name = entry(4, v-param-list, chr(4) )
     1090       v-dc-type-list = entry(5, v-param-list, chr(4) )
     1091       no-error
     1092       .
     1093       if error-status :error then do:
     1094         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Ошибки при получении параметров экспорта данных&1" +                              "&2&1&3&1"                                                                            , error-status:get-message(1)                                                         , return-value )).
     1095         return.
     1096       end.
     1097       v-other-params = v-param-list.
     1098       ENTRY(1, v-other-params, chr(4)) = '':U.
     1099       ENTRY(2, v-other-params, chr(4)) = '':U.
     1100       ENTRY(3, v-other-params, chr(4)) = '':U.
     1101       ENTRY(4, v-other-params, chr(4)) = '':U.
     1102       ENTRY(5, v-other-params, chr(4)) = '':U.
     1103       v-other-params = substring(v-other-params, 6).
     1104       FIND FIRST X_rule-profile NO-LOCK WHERE
     1105                 X_rule-profile.profile_id = v-rule-profile-id NO-ERROR.
     1106       IF NOT AVAILABLE X_rule-profile THEN DO:
     1107         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input "Не найден профайл для экспорта в текстовый файл").
     1108         return.
     1109       END.
     1110       FIND FIRST X_rule-by-profile NO-LOCK WHERE
     1111               X_rule-by-profile.profile_id = v-rule-profile-id
     1112           AND X_rule-by-profile.codex_id = v-codex-id
     1113           AND X_rule-by-profile.ruleset_id = v-ruleset-id NO-ERROR.
     1114       IF NOT AVAILABLE X_rule-profile THEN DO:
     1115         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input "Не найдено или неопределено правило для экспорта в текстовый файл").
     1116         return.
     1117       END.
     1118       FIND FIRST X_rule NO-LOCK WHERE
     1119             X_rule.rule_id = X_rule-by-profile.rule_id.
     1120       IF NOT AVAILABLE X_rule THEN DO:
     1121         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Не найдено правило &1 для экспорта в текстовый файл", X_rule-by-profile.rule_id)).
     1122         return.
     1123       END.
     1124       do v-ii = 1 to num-entries(v-dc-type-list, chr(10)):
     1125         FIND FIRST X_dis-card-type NO-LOCK WHERE
     1126                     X_dis-card-type.emitent-host-code = 0
     1127               AND   X_dis-card-type.type = entry(v-ii, v-dc-type-list, chr(10))
     1128               AND X_dis-card-type.host-code = 0
     1129               AND X_dis-card-type.obj-type = '':U
     1130               AND X_dis-card-type.obj-code = 0 NO-ERROR.
     1131         IF NOT AVAILABLE X_dis-card-type  THEN DO:
     1132             run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Неизвестный тип ДК &1 эмитент &2"                   , entry(v-ii, v-dc-type-list, chr(10))                         , 0)).
     1133           return.
     1134         END.
     1135         FIND FIRST X_rp-by-call NO-LOCK WHERE
     1136                   X_rp-by-call.profile_id = v-rule-profile-id
     1137             AND   X_rp-by-call.call_id = X_dis-card-type.uniq-key-rec NO-ERROR.
     1138         IF NOT AVAILABLE X_rp-by-call THEN DO:
     1139             run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Тип ДК &1 эмитент &2 не привязан к профайлу импорта-экспорта в текстовый файл"                     , X_dis-card-type.type                                                                    , 0)).
     1140           return.
     1141         END.
     1142         find X_rule-by-call where
     1143             X_rule-by-call.call#_id = X_rp-by-call.call#_id
     1144         and X_rule-by-call.rule_id = X_rule-by-profile.rule_id
     1145         and X_rule-by-call.profile_id = X_rule-by-profile.profile_id no-error .
     1146         if ambiguous X_rule-by-call then do:
     1147           if not g#auto then do:
     1148             message
     1149             "Выберите какой вызов правила Вас необходим"
     1150             view-as alert-box .
     1151             run rul/rule-by-call-s.w ( input parparentproc
     1152                                       ,input "b-sel"
     1153                                       ,input "call_id"
     1154                                       ,input X_rp-by-call.call_id
     1155                                       ,input X_rule-by-profile.codex_id
     1156                                       ,input X_rule-by-profile.ruleset_id
     1157                                       ,input X_rule-by-profile.rule_id
     1158                                       ,input-output v-rid-list) no-error .
     1159             if v-rid-list = '':u then do:
     1160               UNDO, RETURN ERROR.
     1161             end.
     1162           end.
     1163           else do:
     1164                  run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("К Типу ДК &1 эмитент &2 привязано два профайла импорта-экспорта в текстовый файл"                   , X_dis-card-type.type                                                                                                  , 0)).
     1165           return.
     1166           end.
     1167           find first X_rule-by-call no-lock where
     1168                     recid(X_rule-by-call) = integer(v-rid-list) no-error .
     1169           if not available X_rule-by-call then do:
     1170             UNDO, RETURN ERROR.
     1171           end.
     1172         end.
     1173         for each buf_tt0-rule-call-param:
     1174           delete buf_tt0-rule-call-param.
     1175         end.
     1176         FOR each buf_Rule-call-param no-lock where
     1177               buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     1178         and  buf_rule-call-param.codex_id = X_rule-by-profile.codex_id
     1179         and  buf_rule-call-param.ruleset_id = X_rule-by-profile.ruleset_id
     1180         and  buf_rule-call-param.order_id = X_rule-by-call.order_id:
     1181           create buf_tt0-rule-call-param.
     1182           buffer-copy buf_rule-call-param to buf_tt0-rule-call-param.
     1183           CASE buf_rule-call-param.param-data-type:
     1184             WHEN 'character':U THEN DO:
     1185               ASSIGN
     1186               buf_tt0-rule-call-param.param-value-character = ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4))
     1187               NO-ERROR.
     1188             END.
     1189             WHEN 'date':U THEN DO:
     1190               ASSIGN
     1191               buf_tt0-rule-call-param.param-value-date = IF entry(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)) = chr(63)
     1192                                                           THEN ?
     1193                                                           ELSE DATE(ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)))
     1194               NO-ERROR.
     1195             END.
     1196             WHEN 'decimal':U THEN DO:
     1197               ASSIGN
     1198               buf_tt0-rule-call-param.param-value-decimal = decimal(ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)))
     1199               NO-ERROR.
     1200             END.
     1201             WHEN 'integer':U THEN DO:
     1202               ASSIGN
     1203               buf_tt0-rule-call-param.param-value-integer = integer(ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)))
     1204               NO-ERROR.
     1205             END.
     1206             WHEN 'logical':U THEN DO:
     1207               ASSIGN
     1208               buf_tt0-rule-call-param.param-value-logical = logical(ENTRY(buf_tt0-rule-call-param.param-num, v-other-params, chr(4)))
     1209               NO-ERROR.
     1210             END.
     1211           END CASE.
     1212           IF ERROR-STATUS:ERROR THEN DO:
     1213           run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Некорректное значение параметра &1=&2"                        ,buf_tt0-rule-call-param.param-label                                     ,BUFFER buf_tt0-rule-call-param:HANDLE:BUFFER-FIELD(substitute("param-value-&1", buf_tt0-rule-call-param.param-data-type)):buffer-value)).
     1214           return.
     1215           END.
     1216         end.
     1217         case v-dir-name:
     1218           when 'ini':U then do:
     1219             run verify-ini-entry in this-procedure (
     1220                                                 INPUT  'dctxt-e_out'
     1221                                                 ,INPUT  'schedule-free'
     1222                                                 ,INPUT substitute("отсутствует параметр &1 секция &2 в ini-файле"
     1223                                                                   , 'dctxt-e_out'
     1224                                                                   , 'schedule-free')
     1225                                                 ,INPUT no
     1226                                                 ,output v-dir-name) no-error .
     1227             if error-status:error or v-dir-name = ? then do:
     1228                 run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input return-value).
     1229               return .
     1230             end.
     1231             RUN verify-file in this-procedure
     1232                                               (input v-dir-name
     1233                                               ,input substitute("Не найден каталог &1 параметр &2, секция &3 ini-файла"
     1234                                                             , v-dir-name
     1235                                                             , 'schedule-free'
     1236                                                           , 'dctxt-e_out')
     1237                                               ,input no
     1238                                               ,output  glog) no-error.
     1239             if error-status:error or not glog then do:
     1240                 run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input return-value).
     1241               return .
     1242             end.
     1243           end.
     1244           otherwise do:
     1245             v-dir-name = v-dir-name.
     1246           end.
     1247         END CASE.
     1248         assign
     1249         file-info:file-name = v-dir-name
     1250         v-dir-type = file-info:file-type
     1251         v-can-write = ( index( v-dir-type, "W" ) > 0 )
     1252         .
     1253         if index( v-dir-type, "D" ) = 0 then do:
     1254             run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Выбранный для экспорта каталог &1 - недоступен", v-dir-name)).
     1255           return .
     1256         end.
     1257         if not v-can-write then do:
     1258             run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("Выбранный для экспорта каталог &1 - недоступен", v-dir-name)).
     1259           return .
     1260         end.
     1261         CASE v-file-rule:
     1262           when "seq":U then do:
     1263             v-file-name = replace(v-file-name, chr(63), string(next-value( s-spool, ub ))).
     1264           end.
     1265           when "const":U then do:
     1266             v-file-name = v-file-name.
     1267           end.
     1268         END CASE.
     1269         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute(("&1Экспорт в текстовый файл&1директория экспорта &2&1" +                                                        "имя файла для экспорта &3&1" +                                                                                   "данные по ДК типa &4")                                                                                       ,(chr(10)  + fill("-", 15))                                                                                 ,v-dir-name                                                                                                       ,v-file-name                                                                                                      ,entry(v-ii,v-dc-type-list, chr(10)))).
     1270         define variable v-doc-code as character no-undo .
     1271         v-doc-code =  string(next-value(s-v-doc, ub)) + chr(4) +
     1272                       trim(trim(v-dir-name, chr(92)), chr(47)) + chr(92) + v-file-name
     1273                       .
     1274         run str/saledc.p
     1275         (
     1276           input parparentproc
     1277         ,input this-procedure :handle
     1278         ,input p-log-handle
     1279         ,input 'text-export':U
     1280         ,input X_dis-card-type.emitent-host-code
     1281         ,input X_dis-card-type.type
     1282         ,input X_rule-by-profile.profile_id
     1283         ,input 0
     1284         ,input 0
     1285         ,input g#db-num
     1286         ,input v-doc-code
     1287         ,input ?
     1288         ,input ?
     1289         ,input ?
     1290         ,input 1
     1291         ,input 1
     1292         ,input no
     1293         ) no-error .
     1294         if error-status:error then do:
     1295           run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("&1Ошибка при экспорте&1" +                                            "&2&1&3"                                                                ,(chr(10)  + fill("-", 15))                                       , error-status:get-message(1)                                           , return-value )).
     1296         end.
     1297       end.
     1298   end.
