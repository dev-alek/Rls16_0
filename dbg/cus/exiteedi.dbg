     1579   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1580         VIEW-AS TEXT
     1581        SIZE 6 BY 1
     1582        FGCOLOR 4  NO-UNDO.
     1583   DEFINE QUERY br-exiteedi FOR X_ext-classif, X_clients, X_ext-system SCROLLING.
     1584   DEFINE BROWSE br-exiteedi
     1585     QUERY br-exiteedi NO-LOCK DISPLAY
     1586         mark-string(recid(X_ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     1587   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(40)"
     1588   X_ext-classif.KEY#_one  COLUMN-LABEL "Код!внешней!системы" FORMAT ">>>>>>>>9"
     1589   X_ext-system.esys-name COLUMN-LABEL "Внешняя система" FORMAT "X(30)"
     1590   X_ext-system.esys-db-num-exp COLUMN-LABEL "Для!БД" FORMAT ">>>>9"
     1591   get-gln( INPUT X_ext-classif.uniq-key-rec) COLUMN-LABEL "GLN" FORMAT "X(13)"
     1592   get-schema(X_ext-classif.charkey_one) COLUMN-LABEL "Схема!работы" FORMAT "X(14)"
     1593   X_clients.obj-type COLUMN-LABEL "Тип!кл." FORMAT "X(3)"
     1594   X_clients.obj-code COLUMN-LABEL "Код!кл." FORMAT ">>>>>>>>9"
     1595       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.3 BY 20.37 FIT-LAST-COLUMN.
     1596   DEFINE FRAME Dialog-Frame
     1597        b-quit AT ROW 1 COL 1
     1598        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1599        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     1600        b-add AT ROW 1 COL 31 WIDGET-ID 14
     1601        b-chg AT ROW 1 COL 41 WIDGET-ID 20
     1602        b-del AT ROW 1 COL 51 WIDGET-ID 16
     1603        b-cli AT ROW 1 COL 61 WIDGET-ID 2
     1604        b-esys AT ROW 1 COL 71 WIDGET-ID 18
     1605        b-sch AT ROW 1 COL 86 WIDGET-ID 12
     1606        b-print AT ROW 1 COL 89 WIDGET-ID 10
     1607        B-Help AT ROW 1 COL 95
     1608        br-exiteedi AT ROW 2.87 COL 1.5 WIDGET-ID 100
     1609        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1610        SPACE(79.30) SKIP(21.26)
     1611       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1612            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1613            TITLE ""
     1614            CANCEL-BUTTON b-quit.
     1615   ASSIGN
     1616          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1617          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1618   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1619   DO:
     1620     APPLY "END-ERROR":U TO SELF.
     1621   END.
     1622   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1623   DO:
     1624     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1625     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1626   END.
     1627   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1628   DO:
     1629     define variable v-key#-one as integer   no-undo .
     1630     define variable v-uniq-key-rec as character no-undo .
     1631     define buffer buf_ext-classif for ub.ext-classif.
     1632     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1633     assign
     1634     v-key#-one = X_ext-classif.key#_one
     1635     v-uniq-key-rec = X_ext-classif.uniq-key-rec.
     1636     RUN proc-b-chg IN THIS-PROCEDURE NO-ERROR.
     1637     IF ERROR-STATUS:ERROR THEN do:
     1638       run waitfram-hide in this-procedure .
     1639       RETURN NO-APPLY.
     1640    end.
     1641    RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     1642    find first buf_ext-classif no-lock where
     1643             buf_ext-classif.classif-subject = 'clients':U
     1644         and buf_ext-classif.classif-name = 'exite-edi':U
     1645         and buf_ext-classif.uniq-key-rec = v-uniq-key-rec
     1646         and buf_ext-classif.key#_one = v-key#-one no-error.
     1647    if available buf_ext-classif then do:
     1648      reposition br-exiteedi to recid recid(buf_ext-classif) no-error.
     1649      apply "entry" to br-exiteedi.
     1650    end.
     1651   END.
     1652   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1653   DO:
     1654     IF NOT AVAILABLE X_clients THEN RETURN NO-APPLY.
     1655     run ref/showcli.p ( INPUT parparentproc
     1656                        ,INPUT X_clients.obj-type
     1657                        ,INPUT X_clients.obj-code) NO-ERROR.
     1658     APPLY "entry" TO br-exiteedi.
     1659   END.
     1660   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1661   DO:
     1662     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1663     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1664     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1665   END.
     1666   ON CHOOSE OF b-esys IN FRAME Dialog-Frame
     1667   DO:
     1668   define variable v-have-rights    as logical        no-undo.
     1669   define variable v-success    as logical        no-undo.
     1670   define variable v-esys-id   as integer        no-undo.
     1671     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1672    ASSIGN
     1673    v-esys-id = X_ext-classif.key#_one.
     1674   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1675   do:
     1676     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1677       (input  v-cntxt-db-num
     1678       ,input  v-cntxt-userid
     1679       ,input  0
     1680       ,input  'actn_openxml-subsystem_lookup':U
     1681       ,input  'global':U
     1682       ,input  0
     1683       ,input  '':U
     1684       ,input  0
     1685       ,input  0
     1686       ,input  0
     1687       ,input  0
     1688       ,input  yes
     1689       ,output v-have-rights
     1690       )  .
     1691   end.
     1692       if v-have-rights = yes
     1693       then do:
     1694                     run bge/oxmlspci.w (
     1695                   input parparentproc
     1696                 , input 'ПРОСМОТР':U
     1697                 , input-output v-esys-id
     1698                 , input 0
     1699                 , output v-success
     1700             ) no-error.
     1701    end.
     1702     APPLY "entry" TO br-exiteedi.
     1703   END.
     1704   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1705   DO:
     1706     define variable loc#log as logical no-undo .
     1707     if available X_ext-classif then do:
     1708   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1709   define variable v-str-recid15 as character no-undo .
     1710   define variable v-num-entry15 as integer   no-undo .
     1711   assign
     1712     v-str-recid15 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
     1713     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1714   .
     1715   if v-num-entry15 > 0 then do:
     1716     assign
     1717       entry( v-num-entry15, v-rid-list ) = "":U
     1718       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1719     .
     1720   end.
     1721   else do:
     1722     assign
     1723       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1724     .
     1725   end.
     1726       loc#log = br-exiteedi:refresh() .
     1727       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1728           loc#log = br-exiteedi:select-next-row ().
     1729           apply "VALUE-CHANGED" to br-exiteedi in frame Dialog-Frame.
     1730       end.
     1731       if num-entries( v-rid-list ) = 0
     1732       then
     1733           hide mark-num in frame Dialog-Frame.
     1734       else
     1735           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1736     end.
     1737     apply "entry" to br-exiteedi in frame Dialog-Frame.
     1738   END.
     1739   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1740   DO:
     1741     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1742     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1743   END.
     1744   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1745   DO:
     1746     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1747     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1748   END.
     1749   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1750   DO:
     1751       if ( available X_ext-classif ) then do:
     1752       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1753       then
     1754       v-rid-list = string( recid( X_ext-classif ) ) .
     1755     end.
     1756   END.
     1757   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1758   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1759   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1760   on help of frame Dialog-Frame
     1761   do:
     1762     run gbl/app_help.p
     1763       (input this-procedure :file-name
     1764       ,input ''
     1765       ,input ?
     1766       ) no-error.
     1767     if error-status :error then do:
     1768       message
     1769         "Ошибка при вызове помощи"
     1770         error-status :get-message(1)
     1771         view-as alert-box .
     1772     end.
     1773   end.
     1774   run minbtn-set in this-procedure .
     1775   on choose of b-help in frame Dialog-Frame
     1776   do:
     1777     apply "help":u to frame Dialog-Frame .
     1778   end.
     1779   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1780   procedure minbtn-set :
     1781       do
     1782           on error undo, return error return-value
     1783           :
     1784           define variable ii              as integer       no-undo .
     1785           define variable fh              as widget-handle no-undo .
     1786           define variable hh              as widget-handle no-undo .
     1787           define variable v-h             as handle        extent 4 no-undo .
     1788           define variable v-name-button   as character     no-undo .
     1789           define variable v-help-old-x    as decimal       no-undo .
     1790           define variable v-help-old-y    as decimal       no-undo .
     1791           define variable v-help-old-size as decimal       no-undo .
     1792           define variable v-frame-width   as decimal       no-undo .
     1793           define variable jj              as integer       no-undo .
     1794           do
     1795               on error undo, return error
     1796               :
     1797               assign
     1798                   v-frame-width = frame Dialog-Frame:width - 0.3
     1799                   fh            = frame Dialog-Frame:first-child
     1800                   hh            = fh:first-child
     1801                   ii            = 1
     1802                   .
     1803               do while valid-handle(hh):
     1804                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1805                   do:
     1806                       case lc(hh:name) :
     1807                           when "b-help" then
     1808                               do:
     1809                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1810                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1811                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1812                                   hh:TOOLTIP = "Помощь" .
     1813                                   v-help-old-x = hh:column .
     1814                                   v-help-old-y = hh:row    .
     1815                                   v-help-old-size = hh:width .
     1816                                   hh:width-chars = 2.5 .
     1817                               end.
     1818                           when "b-print" then
     1819                               do:
     1820                                   hh:load-image("cmp/b-print.bmp":u) .
     1821                                   hh:TOOLTIP = "Печать" .
     1822                                   v-h[ii] = hh:handle .
     1823                                   ii = ii + 1 .
     1824                                   hh:width-chars = 3 .
     1825                               end.
     1826                           when "b-history" or
     1827                           when "b-hist" then
     1828                               do:
     1829                                   hh:load-image("cmp/b-hist.bmp":u) .
     1830                                   hh:TOOLTIP = "История" .
     1831                                   v-h[ii] = hh:handle .
     1832                                   ii = ii + 1 .
     1833                                   hh:width-chars = 3 .
     1834                               end.
     1835                           when "b-sch" then
     1836                               do:
     1837                                   hh:load-image("cmp/b-sch.bmp":u) .
     1838                                   hh:TOOLTIP = "Установка Фильтра" .
     1839                                   v-h[ii] = hh:handle .
     1840                                   ii = ii + 1 .
     1841                                   hh:width-chars = 3 .
     1842                               end.
     1843                           when "b-hist-user" then
     1844                               do:
     1845                                   hh:load-image("cmp/b-hist.bmp":u) .
     1846                                   hh:TOOLTIP = "История пользователя" .
     1847                                   ii = ii + 1 .
     1848                               end.
     1849                       end case.
     1850                   end.
     1851                   hh = hh:next-sibling.
     1852               end.
     1853               b-help:column = v-frame-width - b-help:width-chars.
     1854               jj = 0.
     1855               repeat ii = 4 to 1 by -1 :
     1856                   if valid-handle (v-h[ii] ) then
     1857                   do:
     1858                       jj  = jj + 1 .
     1859                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1860                       v-h[ii]:row    = v-help-old-y .
     1861                   end.
     1862               end.
     1863           end.
     1864       end.
     1865   end procedure.
     1866   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1867   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1868   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1869   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1870   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1871   define variable v-diasize-current-frame-height as decimal   no-undo .
     1872   define variable v-diasize-change-size          as logical   no-undo .
     1873   define variable v-diasize-resize-button        as handle    no-undo .
     1874   define variable v-diasize-wndmax               as logical   no-undo .
     1875   define variable v-diasize-wndstore             as logical   no-undo .
     1876   define variable v-diasize-proc-name            as character no-undo .
     1877   define variable v-diasize-browse-handle        as handle    no-undo .
     1878   define variable v-diasize-browse-number        as integer   no-undo .
     1879   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1880   define temp-table temp-diasize-handle no-undo
     1881     field handle-value  as handle
     1882     field save-position as decimal
     1883     index xpk is primary unique handle-value
     1884     .
     1885   define temp-table temp-browse-handle no-undo
     1886     field browse-type   as character
     1887     field browse-number as integer
     1888     field browse-handle as handle
     1889     field original-size as decimal
     1890     index xpk is primary unique browse-type browse-number
     1891     index xie browse-type browse-handle
     1892   .
     1893   procedure diasize_change-height :
     1894     define input  parameter p-change-value  as decimal   no-undo .
     1895     define input  parameter p-move-resize   as logical   no-undo .
     1896     define variable v-field-group-handle    as handle    no-undo .
     1897     define variable v-object-handle         as handle    no-undo .
     1898     define variable v-frame-height          as decimal   no-undo .
     1899     define variable v-frame-virtual-height  as decimal   no-undo .
     1900     define variable v-browse-height         as decimal   no-undo .
     1901     define variable v-window-height         as decimal   no-undo .
     1902     define variable v-window-virtual-height as decimal   no-undo .
     1903     define variable v-change-sign           as integer   no-undo .
     1904     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1905     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1906     if p-change-value > 0
     1907     then do:
     1908       if frame Dialog-Frame :height + p-change-value
     1909           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1910       then do:
     1911         assign
     1912           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1913                           - (frame Dialog-Frame :height-chars)
     1914         .
     1915         if p-change-value <= 0
     1916         then do:
     1917           run diasize_position-resize-button in this-procedure .
     1918           return .
     1919         end.
     1920       end.
     1921     end.
     1922     if p-change-value < 0
     1923     then do:
     1924       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1925       then do:
     1926         assign
     1927           p-change-value = v-diasize-orig-frame-height
     1928                          - (frame Dialog-Frame :height-chars)
     1929         .
     1930         if p-change-value >= 0
     1931         then do:
     1932           run diasize_position-resize-button in this-procedure .
     1933           return .
     1934         end.
     1935       end.
     1936     end.
     1937     if p-change-value >= 0
     1938     then do:
     1939       assign
     1940         v-change-sign = 1
     1941       .
     1942     end.
     1943     else do:
     1944       assign
     1945         v-change-sign = -1
     1946       .
     1947     end.
     1948     assign
     1949       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1950     .
     1951     if p-change-value = 0
     1952     then do:
     1953       run diasize_position-resize-button in this-procedure .
     1954       return .
     1955     end.
     1956     move_block:
     1957     do
     1958     on error undo move_block, retry move_block
     1959     :
     1960       if retry
     1961       then do:
     1962         do
     1963         on error undo move_block, leave move_block
     1964         :
     1965           if p-change-value > 0
     1966           then do:
     1967             for each buf_temp-diasize-handle
     1968             on error undo, next
     1969             :
     1970               assign
     1971                 v-object-handle = buf_temp-diasize-handle.handle-value
     1972               .
     1973               if v-object-handle <> v-diasize-resize-button
     1974               then do:
     1975                 assign
     1976                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1977                 .
     1978               end.
     1979             end.
     1980             assign
     1981               v-diasize-browse-handle :height = v-browse-height
     1982             .
     1983             for each buf_temp-browse-handle
     1984               where buf_temp-browse-handle.browse-type = 'height':u
     1985             on error undo, next
     1986             :
     1987               assign
     1988                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1989               .
     1990             end.
     1991             assign
     1992               frame Dialog-Frame :height = v-frame-height
     1993             .
     1994             if frame Dialog-Frame :scrollable = true
     1995             then do:
     1996               assign
     1997                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1998               .
     1999             end.
     2000             run diasize_position-resize-button in this-procedure .
     2001           end.
     2002           else do:
     2003             if frame Dialog-Frame :scrollable = true
     2004             then do:
     2005               assign
     2006                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2007               .
     2008             end.
     2009             assign
     2010               frame Dialog-Frame :height = v-frame-height
     2011             .
     2012             assign
     2013               v-diasize-browse-handle :height = v-browse-height
     2014             .
     2015             for each buf_temp-browse-handle
     2016               where buf_temp-browse-handle.browse-type = 'height':u
     2017             on error undo, next
     2018             :
     2019               assign
     2020                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2021               .
