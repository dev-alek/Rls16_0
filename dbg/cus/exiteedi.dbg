     3052           b-sch :tooltip = ""
     3053         .
     3054       end.
     3055     end.
     3056   end procedure.
     3057   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3058   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
