     1544   DEFINE BUTTON b-add
     1545        LABEL "&Добавить"
     1546        SIZE 10 BY 1.
     1547   DEFINE BUTTON b-chg
     1548        LABEL "&Изменить"
     1549        SIZE 10 BY 1.
     1550   DEFINE BUTTON b-cli
     1551        LABEL "Клиент"
     1552        SIZE 10 BY 1.
     1553   DEFINE BUTTON b-del
     1554        LABEL "&Удалить"
     1555        SIZE 10 BY 1.
     1556   DEFINE BUTTON b-esys
     1557        LABEL "ВС"
     1558        SIZE 10 BY 1.
     1559   DEFINE BUTTON B-Help
     1560        LABEL "Помо&щь"
     1561        SIZE 3 BY 1
     1562        BGCOLOR 8 .
     1563   DEFINE BUTTON B-mark
     1564        LABEL "&*"
     1565        SIZE 3 BY 1.
     1566   DEFINE BUTTON b-print
     1567        LABEL "&Печать"
     1568        SIZE 3 BY 1.
     1569   DEFINE BUTTON b-quit AUTO-END-KEY
     1570        LABEL "&Выход"
     1571        SIZE 10 BY 1
     1572        BGCOLOR 8 .
     1573   DEFINE BUTTON b-sch
     1574        LABEL "Фильтр"
     1575        SIZE 3 BY 1.
     1576   DEFINE BUTTON B-sel AUTO-GO
     1577        LABEL "Вы&бор"
