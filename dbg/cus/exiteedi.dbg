     3062   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3063   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3064     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3065     return no-apply.
     3066   end.
     3067   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3068   on F8 of frame Dialog-Frame anywhere do:
     3069     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3070     return no-apply.
     3071   end.
     3072   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3073   on INS of frame Dialog-Frame anywhere do:
     3074     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3075     return no-apply.
     3076   end.
     3077   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3078   on F2 of frame Dialog-Frame anywhere do:
     3079     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3080     return no-apply.
     3081   end.
     3082   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3083   on F2 of frame Dialog-Frame anywhere do:
     3084     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3085     return no-apply.
     3086   end.
     3087   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3088   on f5 of frame Dialog-Frame anywhere
     3089   do:
     3090      if available X_ext-classif then v-rep-rec = recid(X_ext-classif). RUn OpenBR in this-procedure ( input yes, input no, input '':U).  reposition br-exiteedi to recid v-rep-rec no-error.
     3091       apply "VALUE-CHANGED" to br-exiteedi.
     3092   end.
     3093   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3094   do:
     3095     br-exiteedi :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3096   end.
     3097   MAIN-BLOCK:
     3098   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3099      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3100   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3101     run mainmenu_getcntxt in parparentproc
     3102       (output v-cntxt-db-num
     3103       ,output v-cntxt-userid
     3104       ,output v-cntxt-level
     3105       ,output v-cntxt-host-code-obj
     3106       ,output v-cntxt-obj-type
     3107       ,output v-cntxt-obj-code
     3108       ,output v-cntxt-db-num-obj
     3109       ,output v-cntxt-is-admin
     3110       ) .
     3111     case p-list-mode:
     3112       when 'все':U then do:
     3113       end.
     3114       when "esys-id" then do:
     3115         v-esys-id = integer(p-dop-par).
     3116       end.
     3117       when "client" then do:
     3118         run gen-row-keyr in this-procedure (
     3119                                               input   p-dop-par
     3120                                               ,input   ?
     3121                                               ,input   "ub"
     3122                                               ,input   ?
     3123                                               ,input   NO-LOCK
     3124                                               ,output  v-tbl-row
     3125                                               ,output  v-tbl-name   ).
     3126         find first loc_clients no-lock where
     3127                   rowid(loc_clients) = v-tbl-row.
     3128       end.
     3129       otherwise do:
     3130          message
     3131          substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3132          view-as alert-box error.
     3133          undo, return error .
     3134       end.
     3135     end.
     3136     v-rid-list = p-rid-list.
     3137     RUN Myenable.
     3138     WAIT-FOR GO OF FRAME Dialog-Frame.
     3139   END.
     3140   RUN disable_UI.
     3141   PROCEDURE disable_UI :
     3142     HIDE FRAME Dialog-Frame.
     3143   END PROCEDURE.
     3144   PROCEDURE enable_UI :
     3145     DISPLAY mark-num
     3146         WITH FRAME Dialog-Frame.
     3147     ENABLE b-quit B-mark B-sel b-add b-chg b-del b-cli b-esys b-sch b-print
     3148            B-Help br-exiteedi mark-num
     3149         WITH FRAME Dialog-Frame.
     3150     VIEW FRAME Dialog-Frame.
     3151     OPEN QUERY br-exiteedi FOR EACH X_ext-classif NO-LOCK,            FIRST X_clients NO-LOCK,            FIRST X_ext-system NO-LOCK     INDEXED-REPOSITION.
     3152   END PROCEDURE.
     3153   PROCEDURE MyEnable :
     3154   ENABLE
     3155   b-quit
     3156   b-cli
     3157   b-print
     3158   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3159   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3160   b-chg when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3161   b-sch
     3162   B-Help
     3163   b-esys
     3164   br-exiteedi
     3165   WITH FRAME Dialog-Frame.
     3166   VIEW FRAME Dialog-Frame.
     3167   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3168   END PROCEDURE.
     3169   PROCEDURE OpenBr :
     3170   define input  parameter p-open-query     as logical   no-undo .
     3171   define input  parameter p-find-next      as logical   no-undo .
     3172   define input  parameter p-find-condition as character no-undo .
     3173   define variable sort-column-phrase as character no-undo .
     3174   define variable l-query-was-opened as logical no-undo .
     3175   define variable title0 as character no-undo .
     3176   define buffer buf_clients for clients.
     3177   case sort-column-name :
     3178     when "" then do:
     3179       assign
     3180         sort-column-phrase = ""
     3181       .
     3182     end.
     3183     otherwise do:
     3184       assign
     3185         sort-column-phrase = "by " + sort-column-name
     3186       .
     3187     end.
     3188   end case.
     3189   filter-point = filter-point0 + p-list-mode .
     3190   case p-list-mode:
     3191    when 'все':U then do:
     3192     title0 = "Внешние системы для обмена данными по edi".
     3193     ASSIGN
     3194     frame Dialog-Frame:title = substitute("&1", title0)
     3195     filter-label = SUBSTITUTE("&1"
     3196                               , frame Dialog-Frame:title
     3197                               )
     3198     .
     3199   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3200   define variable  l-disable-where-30  as logical   no-undo .
