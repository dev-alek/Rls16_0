     3530   PROCEDURE proc-b-add :
     3531   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3532   define variable v-rid as recid no-undo .
     3533   DEFINE VARIABLE v-ok AS logical NO-UNDO.
     3534   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     3535   define variable v-uniq-key-rec as character no-undo .
     3536   define variable v-tbl-row as rowid no-undo .
     3537   define variable v-tbl-name as character no-undo .
     3538   define variable v-ordrsp-option as character no-undo .
     3539   define buffer buf_clients for clients.
     3540   define buffer buf_ext-system for ub.ext-system.
     3541   define buffer buf2_ext-classif for ub.ext-classif.
     3542   define variable glog as logical no-undo .
     3543   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3544   do:
     3545     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3546       (input  v-cntxt-db-num
     3547       ,input  v-cntxt-userid
     3548       ,input  0
     3549       ,input  'actn_rh-attr-edi_update':U
     3550       ,input  'global':U
     3551       ,input  0
     3552       ,input  '':U
     3553       ,input  0
     3554       ,input  0
     3555       ,input  0
     3556       ,input  0
     3557       ,input  true
     3558       ,output glog
     3559       )  .
     3560   end.
     3561   if not glog then undo, return error.
     3562   message
     3563   "Выберите клиента/объект, документооборот которого Вы хотите вести через систему edi"
     3564   view-as alert-box .
     3565   run ref/cli-all.w (   input parparentproc
     3566                     ,input "b-sel"
     3567                     ,input 'орг':U
     3568                     ,input 'все':U
     3569                     ,input 'текущие':U
     3570                     ,input ?
     3571                     ,input ",,,,,,NO,,"
     3572                     ,input "":U
     3573                     ,output v-rid-list) no-error.
     3574   if v-rid-list = '':U then return no-apply.
     3575   find first buf_clients where recid (buf_clients) = integer (v-rid-list) no-lock no-error.
     3576   run gen-key-rec IN THIS-PROCEDURE
     3577   ( input 'clients':U
     3578     ,input (buffer buf_clients:handle)
     3579     ,output v-uniq-key-rec).
     3580   if p-list-mode = "esys-id" then do:
     3581    find first buf_ext-system no-lock where
     3582             buf_ext-system.db-num = 0
     3583         and buf_ext-system.esys-id = integer(p-dop-par).
     3584   end.
     3585   else do:
     3586     run bge/oxmlexts.p (
     3587               input parparentproc
     3588             , input 2
     3589             , input substitute("esys-type = &1", '9':U)
     3590             , input v-uniq-key-rec
     3591             , output v-rid-list
     3592             , output v-ok
     3593         ).
     3594     if not v-ok then return error.
     3595     run gen-row-keyr in this-procedure
     3596       ( input v-rid-list
     3597         ,input ?
     3598         ,input "ub"
     3599         ,input ?
     3600         ,input no-lock
     3601         ,output v-tbl-row
     3602         ,output v-tbl-name
     3603       ).
     3604     find first buf_ext-system no-lock where
     3605               rowid(buf_ext-system) = v-tbl-row.
     3606   end.
     3607   if buf_ext-system.esys-type <> integer('9':U) then do:
     3608     message
     3609     "Нужно выбрать ВНЕШНЮЮ СИСТЕМУ типа EDI"
     3610     view-as alert-box error .
     3611     undo, return error.
     3612   end.
     3613   assign
     3614   v-value-integer = buf_Ext-system.esys-id
     3615   .
     3616   if (buf_clients.obj-type = 'орг':U and not can-find(first ub.sysconf no-lock where ub.sysconf.host-code = buf_clients.obj-code))
     3617   or buf_clients.obj-type = 'чел':U then do:
     3618     find first buf2_ext-classif no-lock where
     3619               buf2_ext-classif.classif-subject = 'clients':U
     3620           and buf2_ext-classif.classif-name = 'exite-edi':U
     3621           and buf2_ext-classif.uniq-key-rec = v-uniq-key-rec no-error.
     3622     if available buf2_ext-classif then do:
     3623       v-ordrsp-option = buf2_ext-classif.charkey_one.
     3624     end.
     3625     else do:
     3626       define variable v-type as character no-undo .
     3627       if not buf_ext-system.whole-send-news = integer ('9':U) then do:
     3628         run gbl/d-list.w (
     3629                     INPUT "b-sel":U
     3630                     ,INPUT "Выберите схему работы"
     3631                     ,INPUT 'without-ordrsp':U + chr(44) + 'with-ordrsp':U
     3632                     ,INPUT 'Без ORDRSP':U + chr(44) + 'С ORDRSP':U
     3633                     ,INPUT chr(44)
     3634                     ,INPUT "":U
     3635                     ,output v-ordrsp-option).
     3636       end.
     3637       else v-ordrsp-option = 'with-ordrsp':U.
     3638       IF v-ordrsp-option = "":u THEN do:
     3639         RETURN error.
     3640       end.
     3641     end.
     3642   end.
     3643   run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     3644                       ,INPUT NO
     3645                       ,INPUT-OUTPUT v-rid
     3646                       ,INPUT 'clients':U
     3647                       ,INPUT 'exite-edi':U
     3648                       ,input (-1)
     3649                       ,input v-value-integer
     3650                       ,input 0
     3651                       ,input 0
     3652                       ,input v-ordrsp-option
     3653                       ,input '':U
     3654                       ,input '':U
     3655                       ,input (if buf_clients.obj-type = 'орг':U then 1000000000 else 0) + buf_clients.obj-code
     3656                       ,input v-uniq-key-rec ) no-error.
     3657   if error-status:error then do:
     3658     undo, return error .
     3659   end.
     3660   if v-rid <> ? then do:
     3661     run openbr in this-procedure ( input yes, input no, input '':U).
     3662     reposition br-exiteedi to recid v-rid no-error .
     3663     apply "entry" to br-exiteedi in frame Dialog-Frame .
     3664   end.
     3665   END PROCEDURE.
     3666   PROCEDURE proc-b-chg :
     3667   DEFINE VARIABLE glog AS LOGICAL no-undo.
     3668   DEFINE VARIABLE v-ordrsp-option AS CHARACTER NO-UNDO.
     3669   DEFINE VARIABLE v-uniq-key-rec AS CHARACTER NO-UNDO.
     3670   DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
     3671   DEFINE BUFFER buf2_ext-classif FOR ub.ext-classif.
     3672   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3673   do:
     3674     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3675       (input  v-cntxt-db-num
     3676       ,input  v-cntxt-userid
     3677       ,input  0
     3678       ,input  'actn_rh-attr-edi_update':U
     3679       ,input  'global':U
     3680       ,input  0
     3681       ,input  '':U
     3682       ,input  0
     3683       ,input  0
     3684       ,input  0
     3685       ,input  0
     3686       ,input  true
     3687       ,output glog
     3688       )  .
     3689   end.
     3690   if not glog then undo, return error.
     3691   if X_clients.obj-type = 'маг':U
     3692   or X_clients.obj-type = 'скл':U then do:
     3693     message "Привязки по клиентам с таким типом нельзя изменять (можно только удалять)"
     3694     view-as alert-box .
     3695     return error.
     3696   end.
     3697   MESSAGE
     3698   "Изменить можно только схему работы для клиента СРАЗУ ПО ВСЕМ ВС" SKIP
     3699   "Продолжить?"
     3700   VIEW-AS alert-box QUESTION BUTTONS YES-NO UPDATE glog.
     3701   IF NOT glog  THEN DO:
     3702     RETURN ERROR.
     3703   END.
     3704   define variable v-type as character no-undo .
     3705   if not X_ext-system.whole-send-news = integer ('9':U) then do:
     3706     run gbl/d-list.w (
     3707                 INPUT "b-sel":U
     3708                 ,INPUT "Выберите схему работы"
     3709                 ,INPUT 'without-ordrsp':U + chr(44) + 'with-ordrsp':U
     3710                 ,INPUT 'Без ORDRSP':U + chr(44) + 'С ORDRSP':U
     3711                 ,INPUT chr(44)
     3712                 ,INPUT X_ext-classif.charkey_one
     3713                 ,output v-ordrsp-option).
     3714   end.
     3715   else v-ordrsp-option = 'with-ordrsp':U.
     3716   IF v-ordrsp-option = "":u THEN do:
     3717     RETURN error.
     3718   END.
     3719   v-uniq-key-rec = X_ext-classif.uniq-key-rec.
     3720   run waitfram-show in this-procedure ( input "...Ждите").
     3721   _each:
     3722   fOr EACH buf_ext-classif SHARE-LOCK WHERE
     3723           buf_ext-classif.classif-subject = 'clients':U
     3724       AND buf_ext-classif.classif-name = 'exite-edi':U
     3725       AND buf_ext-classif.uniq-key-rec = v-uniq-key-rec
     3726   ON error UNDO _each, RETURN ERROR
     3727   ON stop UNDO _each, RETURN ERROR
     3728   ON END-KEY UNDO _each, RETURN ERROR:
     3729      IF buf_ext-classif.charkey_one <> v-ordrsp-option THEN DO:
     3730          CREATE buf2_ext-classif.
     3731          BUFFER-COPY buf_ext-classif
     3732          EXCEPT charkey_one
     3733          TO buf2_ext-classif
     3734          ASSIGN
     3735          buf2_ext-classif.charkey_one = v-ordrsp-option.
     3736          DELETE buf_ext-classif.
     3737      END.
     3738   END.
     3739   run waitfram-hide in this-procedure .
     3740   END PROCEDURE.
     3741   PROCEDURE proc-b-del :
     3742   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3743   DEFINE VARIABLE glog AS logical NO-UNDO.
     3744   IF NOT AVAILABLE X_ext-classif THEN UNDO, RETURN ERROR.
     3745   v-rec = recid(X_ext-classif).
     3746   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3747   do:
     3748     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3749       (input  v-cntxt-db-num
     3750       ,input  v-cntxt-userid
     3751       ,input  0
     3752       ,input  'actn_rh-attr-edi_update':U
     3753       ,input  'global':U
     3754       ,input  0
     3755       ,input  '':U
     3756       ,input  0
     3757       ,input  0
     3758       ,input  0
     3759       ,input  0
     3760       ,input  true
     3761       ,output glog
     3762       )  .
     3763   end.
     3764   if not glog then undo, return error.
     3765   MESSAGE
     3766   "Вы действительно хотитет удалить эту запись?"
     3767   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3768   IF NOT glog THEN RETURN ERROR.
     3769   run ref/extclas3.p ( INPUT NO
     3770                       ,INPUT v-rec) NO-ERROR.
     3771   if not error-status:error then do:
     3772     run openbr in this-procedure ( input yes, input no, input '':U).
     3773     reposition br-exiteedi to row 1 no-error .
     3774     apply "entry" to br-exiteedi in frame Dialog-Frame .
     3775   end.
     3776   END PROCEDURE.
     3777   PROCEDURE proc-b-print :
     3778   DEFINE VARIABLE date_string              as   character no-undo .
     3779   DEFINE VARIABLE Line                     as   character no-undo .
     3780   DEFINE VARIABLE for-time                 as   character no-undo .
     3781   DEFINE VARIABLE accum-count              as   integer   no-undo .
     3782   define variable v-rid                    as   recid no-undo .
     3783   DEFINE VARIABLE v-esys-name AS CHARACTER NO-UNDO.
     3784   DEFINE VARIABLE v-gln                    AS CHARACTER NO-UNDO.
     3785   DEFINE FRAME list1
     3786   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(40)"
     3787   X_ext-classif.KEY#_one  COLUMN-LABEL "Код ВС" FORMAT ">>>>>>>>9"
     3788   X_ext-system.esys-name COLUMN-LABEL "Внешняя система" FORMAT "X(30)"
     3789   X_ext-system.esys-db-num-exp COLUMN-LABEL "Для!БД" FORMAT ">>>>9"
     3790   v-gln COLUMN-LABEL "GLN" FORMAT "X(13)"
     3791   X_ext-classif.charkey_one COLUMN-LABEL "Схема!работы" FORMAT "X(14)"
     3792   X_clients.obj-type COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     3793   X_clients.obj-code COLUMN-LABEL "Код!клиента" FORMAT ">>>>>>>>9"
     3794   HEADER  date_string AT 5 format "X(35)"
     3795   string( "Страница " ) format "X(9)" AT 75 PAGE-NUMBER(PrnLibStream) AT 85 FORMAT ">>9" SKIP
     3796   Line format "X(192)" AT 1
     3797   with width 232 down stream-io use-text    .
     3798   Line = fill("-", 121).
     3799   date_string = cur-time-print() .
     3800   run prn-lib-open-stream  in this-procedure (
     3801                                                input parParentProc
     3802                                               ,input  62
     3803                                               ,input yes
     3804                                               ,input no
     3805                                               ).
     3806   PUT  STREAM PrnLibStream
     3807   SPACE(25) ( frame Dialog-Frame:title )
     3808   format "x(90)" SKIP(1) .
     3809   FORM HEADER
     3810   Line format "X(177)" AT 1 SKIP
     3811   "Продолжение - на следующей странице" AT 30 SKIP
     3812   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3813   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3814   v-rid = recid(X_ext-classif).
     3815   FORM with FRAME List1.
     3816   run waitfram-show in this-procedure ( input "Ждите...").
     3817   DO WHILE available X_ext-classif :
     3818      GET prev br-exiteedi.
     3819   END.
     3820   GET next br-exiteedi.
     3821   DO WHILE available X_ext-classif :
     3822     Display STREAM PrnLibStream
     3823     X_ext-classif.KEY#_one
     3824     X_ext-system.esys-name
     3825     X_ext-system.esys-db-num-exp
     3826     get-gln(X_ext-classif.uniq-key-rec) @ v-gln
     3827     get-schema(X_ext-classif.charkey_one) @ X_ext-classif.charkey_one
     3828     X_clients.obj-type
     3829     X_clients.obj-code
     3830     X_clients.obj-name
     3831     with FRAME List1.
     3832     DOWN STREAM PrnLibStream
     3833     1
     3834     with FRAME List1.
     3835     assign
     3836     accum-count = accum-count + 1
     3837     .
     3838     GET next br-exiteedi.
     3839   END.
     3840   UNDERLINE  STREAM PrnLibStream
     3841   X_ext-classif.KEY#_one
     3842   X_ext-system.esys-name
     3843   X_ext-system.esys-db-num-exp
     3844   v-gln
     3845   X_ext-classif.charkey_one
     3846   X_clients.obj-type
     3847   X_clients.obj-code
     3848   X_clients.obj-name
     3849   with FRAME List1.
     3850   DISPLAY STREAM PrnLibStream
     3851   accum-count @ X_ext-classif.key#_one
     3852   with frame List1.
     3853   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3854   HIDE  STREAM PrnLibStream FRAME List1.
     3855   output  STREAM PrnLibStream CLOSE.
     3856   reposition br-exiteedi to recid v-rid no-error .
     3857   apply "ENTRY" to br-exiteedi in frame Dialog-Frame .
     3858   run waitfram-hide in this-procedure .
     3859   run prn-lib-prn-file in this-procedure (
     3860                                             input parParentProc
     3861                                             ,input 0
     3862                                             ).
     3863   END PROCEDURE.
     3864   PROCEDURE proc-b-sch :
     3865   define variable v-ri as recid no-undo .
     3866   assign
     3867   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     3868   .
     3869   assign
     3870   tbl = 'ext-classif':U
     3871   join-tbl = 'X_ext-classif'
     3872   fld = ""
     3873   lab = ""
     3874   spr = ""
     3875   dim = '0'
     3876   .
     3877   run fltfield-add in this-procedure('key#_one', 'Код ВС', '',
     3878   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3879   run fltfield-add in this-procedure('charkey_one', 'Схема работы', '',
     3880   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3881   DO on stop undo, leave:
     3882       run gbl/filter.w ( INPUT parparentproc
     3883                    ,INPUT filter-point + chr(4) + filter-label
     3884                    ,INPUT tbl
     3885                    ,INPUT join-tbl
     3886                    ,INPUT fld
     3887                    ,INput lab
     3888                    ,INPUT spr
     3889                    ,INPUT  dim).
     3890       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3891       if v-ri <> ? then do:
     3892         reposition br-exiteedi to recid v-ri no-error.
     3893       end.
     3894       APPLY "ENTRY" to br-exiteedi in frame Dialog-Frame .
     3895       APPLY "VALUE-CHANGED" to br-exiteedi.
     3896   END .
     3897   END PROCEDURE.
     3898   FUNCTION get-cli-name RETURNS CHARACTER
     3899     ( INPUT p-uniq-key-rec AS CHARACTER ) :
     3900   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3901   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3902   DEFINE BUFFER buf_clients FOR ub.clients.
     3903   RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3904                                       ,input ?
     3905                                       ,INPUT "ub"
     3906                                       ,INPUT ?
     3907                                       ,INPUT NO-LOCK
     3908                                       ,OUTPUT v-rowid
     3909                                       ,OUTPUT v-tbl-name) no-error.
     3910   if error-status :error then do:
     3911     message
     3912       vss-workfile vss-revision vss-description skip
     3913       error-status :get-message(1)
     3914       error-status :get-message(2)
     3915     view-as alert-box error.
     3916     undo, return error.
     3917   end.
     3918   IF v-rowid = ? THEN RETURN 'НЕИЗВЕСТНЫЙ КЛИЕНТ'.
     3919   FIND FIRST buf_clients NO-LOCK WHERE ROWID(buf_clients) = v-rowid.
     3920   RETURN buf_clients.obj-name.
     3921   END FUNCTION.
     3922   FUNCTION get-cli-type-code RETURNS CHARACTER
     3923     ( INPUT p-uniq-key-rec AS character ) :
     3924   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3925   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3926   DEFINE BUFFER buf_clients FOR ub.clients.
     3927       RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3928                                           ,INPUT ?
     3929                                           ,INPUT "ub"
     3930                                           ,INPUT ?
     3931                                           ,INPUT NO-LOCK
     3932                                           ,OUTPUT v-rowid
     3933                                           ,OUTPUT v-tbl-name) NO-ERROR.
     3934       if error-status :error then do:
     3935         message
     3936           vss-workfile vss-revision vss-description skip
     3937           error-status :get-message(1)
     3938           error-status :get-message(2)
     3939         view-as alert-box error.
     3940         undo, return error.
     3941       end.
     3942       IF v-rowid = ? THEN RETURN ''.
     3943       FIND FIRST buf_clients NO-LOCK WHERE ROWID(buf_clients) = v-rowid.
     3944       RETURN substitute("&1&2"
     3945                         ,buf_clients.obj-type
     3946                         ,buf_Clients.obj-code).
     3947   END FUNCTION.
     3948   FUNCTION get-gln RETURNS CHARACTER
     3949     ( INPUT p-cli-uniq-key-rec AS CHARACTER ) :
     3950   DEFINE BUFFER buf_ext-classif FOR ub.ext-classif.
     3951   FIND FIRST buf_ext-classif NO-LOCK WHERE
     3952             buf_ext-classif.classif-subject = 'clients':U
     3953        AND  buf_ext-classif.classif-name = 'GLN':U
     3954       AND buf_ext-classif.uniq-key-rec  = p-cli-uniq-key-rec NO-ERROR.
     3955    IF AVAILABLE buf_ext-classif THEN RETURN buf_ext-classif.charkey_one.
     3956    RETURN "".
     3957   END FUNCTION.
     3958   FUNCTION get-schema RETURNS CHARACTER
     3959     ( p-schema AS CHARACTER ) :
     3960   CASE p-schema:
     3961     WHEN 'without-ordrsp':U THEN DO:
     3962       RETURN 'Без ORDRSP':U.
     3963     END.
     3964     WHEN 'with-ordrsp':U THEN DO:
     3965       RETURN 'С ORDRSP':U.
     3966     END.
     3967     OTHERWISE DO:
     3968       RETURN "".
     3969     END.
     3970   END CASE.
     3971   END FUNCTION.
