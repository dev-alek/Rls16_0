     3211         RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3212         KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3213         Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3214         Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3215         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3216         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3217         with FRAME ZAPAS .
