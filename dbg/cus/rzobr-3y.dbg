     2451   PROCEDURE display-B1  :
     2452         if NOT( NOT Show-Negativ-2 and
     2453            ( b1-prih         [1]   = 0 AND
     2454              b1-rash          [1]   = 0 AND
     2455              b1-kassa         [1]   = 0 AND
     2456              b1-Inv           [1]   = 0 AND
     2457              b1-Overturn      [1]   = 0 AND
     2458              b1-Overturn      [5]   = 0 AND
     2459              b1-Overturn      [8]   = 0 ) ) then DO:
     2460           IF  NOT (NOT Show-Negativ  AND (
     2461                 b1-prih          [1]   = 0 AND
     2462                 b1-rash          [1]   = 0 AND
     2463                 b1-kassa         [1]   = 0 AND
     2464                 b1-Inv           [1]   = 0 AND
     2465                 b1-Overturn      [1]   = 0 AND
     2466                 b1-Overturn      [5]   = 0 AND
     2467                 b1-ostatok-start [1]   = 0 AND
     2468                 b1-ostatok-End   [1]   = 0   )) then DO:
     2469                 if Sums-Only THEN do:
     2470                     if fr0 = true then do:
     2471                         PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2472                         if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     2473                         fr0 = false .
     2474                       end.
     2475                  end.
     2476           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2477           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2478           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2479           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2480           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2481           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2482           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2483          if not sums-only then run p-line.
     2484    End.
     2485    end.
     2486   END PROCEDURE.
     2487   PROCEDURE display-B2  :
     2488        if NOT( NOT Show-Negativ-2 and
     2489            ( b2-prih         [1]   = 0 AND
     2490              b2-rash          [1]   = 0 AND
     2491              b2-kassa         [1]   = 0 AND
     2492              b2-Inv           [1]   = 0 AND
