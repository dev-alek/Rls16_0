     3255     excel-sum(b1-ostatok-start[2])  CHR(9)
     3256     excel-sum(b1-ostatok-start[5])  CHR(9)
     3257     excel-sum(b1-ostatok-start[8])  CHR(9)
     3258     excel-sum(b1-ostatok-start[3])  CHR(9)
     3259     excel-sum(b1-ostatok-start[6])  CHR(9)
     3260     excel-sum(b1-ostatok-start[9])  CHR(9)
     3261     excel-qnty(b1-Prih         [1])  CHR(9)
     3262     excel-sum(b1-Prih         [2])  CHR(9)
     3263     excel-sum(b1-Prih         [5])  CHR(9)
     3264     excel-sum(b1-Prih         [8])  CHR(9)
     3265     excel-sum(b1-Prih         [3])  CHR(9)
     3266     excel-sum(b1-Prih         [6])  CHR(9)
     3267     excel-sum(b1-Prih         [9])  CHR(9)
     3268     excel-qnty(b1-RAsh         [1])  CHR(9)
     3269     excel-sum(b1-RAsh         [2])  CHR(9)
     3270     excel-sum(b1-RAsh         [5])  CHR(9)
     3271     excel-sum(b1-RAsh         [8])  CHR(9)
     3272     excel-sum(b1-RAsh         [3])  CHR(9)
     3273     excel-sum(b1-RAsh         [6])  CHR(9)
     3274     excel-sum(b1-RAsh         [9])  CHR(9)
     3275     excel-qnty(b1-KAssa        [1])  CHR(9)
     3276     excel-sum(b1-KAssa        [2])  CHR(9)
     3277     excel-sum(b1-KAssa        [5])  CHR(9)
     3278     excel-sum(b1-KAssa        [8])  CHR(9)
     3279     excel-sum(b1-KAssa        [3])  CHR(9)
     3280     excel-sum(b1-KAssa        [6])  CHR(9)
     3281     excel-sum(b1-KAssa        [9])  CHR(9)
