     3228   define input parameter p6 as char no-undo.
     3229   define input parameter p7 as char no-undo.
     3230    CASE CAPS(p7) :
     3231      WHEN "B1":U  Then DO :
     3232       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3233         p3 @ s-bar-code
     3234         p4 @ gds-zap-artic
     3235         p5 @ gds-zap-gds-name
     3236         p6 @ gds-zap-unit-base
     3237         p1 @ gds-type
