      912   define variable mWaitFramTextEnd            as character   no-undo.
      913   define variable mWaitFramView               as logical     no-undo.
      914   define variable mWaitProcEvent              as logical     no-undo init yes.
      915   define variable mWaitFramInterval           as integer     no-undo init 1 .
      916   define variable mWaitFramStop               as logical     no-undo.
      917   define variable mWaitFramStopUser           as logical     no-undo.
      918   define variable mWaitFramStopTimeOut        as logical     no-undo.
      919   define variable mWaitFramStartProc          as datetime-tz no-undo.
      920   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      921   define button B-WaitFramStop auto-end-key
      922        label "Стоп"
      923        size 10 by 1 tooltip "Остоновить процесс".
      924   define button B-viewProcInfo
      925        label "Информация"
      926        size 15 by 1 tooltip "Информация о процесс".
      927   define frame waitfram
      928     v-waitfram-action01 format "x(72)" no-label skip
      929     v-waitfram-action02 format "x(72)" no-label skip
      930     v-waitfram-action03 format "x(72)" no-label skip
      931     B-viewProcInfo
      932     B-WaitFramStop at row 4 col 30
      933     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      934     .
      935   define new global shared variable mBatchMode as logical no-undo init ?.
      936   define variable mFramBachModHandle as handle no-undo.
      937   mFramBachModHandle = frame waitfram:handle.
      938   define variable mFameOldVis as logical no-undo.
      939   define variable mVisCUrentVin as logical no-undo.
      940   if session:batch-mode
      941   then
      942      mBatchMode = yes.
      943   if mBatchMode = ? then do:
      944     mVisCUrentVin = current-window:visible.
      945     mFameOldVis = mFramBachModHandle:visible.
      946     mFramBachModHandle:visible  = yes.
      947     mBatchMode = mFramBachModHandle:visible ne yes.
      948     mFramBachModHandle:visible = mFameOldVis.
      949     current-window:visible = mVisCUrentVin.
      950   end.
      951    if  log-manager:logfile-name ne ?
      952     then DO:
      953         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      954         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      955         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      956     end.
      957   on choose of B-WaitFramStop in frame waitfram
      958   do:
      959     mWaitFramStop = yes.
      960     mWaitFramStopUser = yes.
      961   end.
      962   function waitfram-check-timeout returns logical():
      963      define variable vtime as int64 no-undo.
      964      if mWaitFramStopTimeOut
      965      then
      966         return yes.
      967      vtime = ( now - mWaitFramStartProc ) / 1000 .
      968      if     mWaitFramTimeOut ne ?
      969         and mWaitFramTimeOut ne 0
      970         and mWaitFramTimeOut lt vtime
      971      then do:
      972         mWaitFramStopTimeOut = yes.
      973      end.
      974      return mWaitFramStopTimeOut.
      975   end.
      976   procedure waitfram-hide :
      977     if not session:batch-mode
      978     then do
      979     on error undo, return error return-value
      980     :
      981       pause 0 before-hide .
      982       if not mBatchMode then
      983         hide frame waitfram .
      984     if     not mWaitFramView
      985        and mWaitProcEvent
      986     then
      987       process events .
      988     end.
      989   end procedure.
      990   procedure waitfram-show :
      991     define input  parameter p-message as character no-undo .
      992     define variable v-left-margin as integer   no-undo .
      993     if not session:batch-mode
      994     then do
      995     on error undo, return error return-value
      996     :
      997       if length(p-message) <= 70 then do:
      998         assign
      999           v-left-margin = integer((70 - length(p-message)) / 2)
     1000         .
     1001         assign
     1002           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1003         .
     1004         assign
     1005           v-waitfram-action01 = " "
     1006           v-waitfram-action02 = " "
     1007                                    + fill(" ", v-left-margin)
     1008                                    + p-message
     1009           v-waitfram-action03 = " "
     1010         .
     1011       end.
     1012       else do:
     1013         define variable vRindex1 as integer no-undo.
     1014         define variable vRindex2 as integer no-undo.
     1015         vRindex1 = r-index(p-message," ",70).
     1016         if vRindex1 = 0
     1017         then
     1018            vRindex1 = 70.
     1019         if length(p-message)  <= vRindex1 + 70 then do:
     1020           assign
     1021             v-waitfram-action01 = " "
     1022             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1023             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1024           .
     1025         end.
     1026         else do:
     1027           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1028           if vRindex2 <= vRindex1
     1029           then
     1030              vRindex2 = vRindex1 + 70.
     1031           assign
     1032             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1033             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1034             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1035           .
     1036         end.
     1037       end.
     1038       B-viewProcInfo:visible   in frame waitfram = no.
     1039       B-viewProcInfo:sensitive in frame waitfram = no.
     1040       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1041       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1042       if  (   mWaitFramView
     1043          or  mWaitProcEvent)
     1044          and not mBatchMode
     1045       then
     1046          display
     1047             v-waitfram-action01 skip
     1048             v-waitfram-action02 skip
     1049             v-waitfram-action03 skip
     1050          with frame waitfram .
     1051       if     mWaitFramView
     1052          then do:
     1053             if     mWaitFramInterval ne ?
     1054                and not mBatchMode
     1055             then
     1056                wait-for go of frame waitfram pause mWaitFramInterval.
     1057          end.
     1058          else
     1059             if     mWaitProcEvent
     1060                and not mBatchMode
     1061             then
     1062                process events .
     1063     end.
     1064   end procedure.
     1065      procedure waitfram-show-this:
     1066         define input  parameter iInterval as int64 no-undo.
     1067         define variable vtime as int64 no-undo.
     1068         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1069         mWaitFramInterval = iInterval.
     1070         run waitfram-show (substitute("&1&2 &3&4" ,
     1071                                       mWaitFramTextBeg ,
     1072                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1073                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1074                                       mWaitFramTextEnd
     1075                                      )
     1076                           ).
     1077      end.
     1078      procedure WaitFramRunPause:
     1079         define input  parameter iInterval as dec no-undo.
     1080         define variable vStart  as datetime-tz no-undo.
     1081         define variable vend    as datetime-tz no-undo.
     1082         define variable vint as int64 no-undo.
     1083         define variable vOk as logical no-undo.
     1084         vStart = now.
     1085         vend   = vStart.
     1086         publish "WaitFramPause" (iInterval,output vOk).
     1087         vend   =  now.
     1088         vint = vend - vStart.
     1089         vint = iInterval - vint / 1000.
     1090         if     not mWaitFramStop
     1091            and (   vint > 0
     1092                 or (    not vOk
     1093                     and iInterval eq ?
     1094                     )
     1095                 )
     1096         then
     1097            run waitfram-show-this (iInterval).
     1098         vend   =  now.
     1099         vint = vend - vStart.
     1100         vint = iInterval - vint / 1000.
     1101         if     not mWaitFramStop
     1102            and vint > 0
     1103         then do:
     1104            run gbl/pause.p (vint * 1000).
     1105         end.
     1106         if iInterval ne ?
     1107         then
     1108            publish "WaitFramStop".
     1109         waitfram-check-timeout().
     1110      end.
     1111      procedure WaitFramWaitFor:
     1112         define input  parameter iInterval as dec no-undo.
     1113         assign
     1114            mWaitFramStartProc   = now
     1115            mWaitFramStopUser    = no
     1116            mWaitFramStopTimeOut = no
     1117         .
     1118         block-wait:
     1119         do while not mWaitFramStop:
     1120            run WaitFramRunPause (iInterval).
     1121            if  waitfram-check-timeout()
     1122            then do:
     1123               leave block-wait.
     1124            end.
     1125         end.
     1126         run waitfram-hide.
     1127      end.
     1128   procedure waitfram-join :
     1129     define input  parameter p-line-1  as character no-undo .
     1130     define input  parameter p-line-2  as character no-undo .
     1131     define input  parameter p-line-3  as character no-undo .
     1132     define output parameter p-message as character no-undo .
     1133     do
     1134     on error undo, return error return-value
     1135     :
     1136       assign
     1137         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1138                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1139                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1140       .
     1141     end.
     1142   end procedure.
     1143   function waitfram-join-function returns character
     1144     (input p-line-1 as character
     1145     ,input p-line-2 as character
     1146     ,input p-line-3 as character
     1147     ).
     1148     define variable v-message as character no-undo .
     1149     run waitfram-join in this-procedure
     1150       (input  p-line-1
     1151       ,input  p-line-2
     1152       ,input  p-line-3
     1153       ,output v-message
     1154       ) .
     1155     return v-message .
     1156   end function .
     1157   define temp-table temp-font no-undo
     1158     field fontnum  as integer
     1159     field fontname as character
     1160     field fontsize as character
     1161     field fonttype as character
     1162     field font-h   as integer
     1163     field font-w   as integer
     1164     field v-row    as integer
     1165     field v-col    as integer
     1166     field v-row-lans as integer
     1167     field v-col-lans as integer
     1168   index pi fontnum
     1169   .
     1170   procedure get-font-ini :
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174   define variable ii as integer   no-undo .
     1175   define variable v-font7 as character no-undo .
     1176   define variable v-font as character no-undo .
     1177   define variable loc-name as character no-undo .
     1178   define variable loc-size as character no-undo .
     1179   define variable loc-type as character no-undo .
     1180   define variable old_H as integer   no-undo .
     1181   define variable old_w as integer   no-undo .
     1182   define variable old-row  as integer   no-undo .
     1183   define variable old-col  as integer   no-undo .
     1184   define variable old-row-lans  as integer   no-undo .
     1185   define variable old-col-lans  as integer   no-undo .
     1186   define variable vv as integer   no-undo .
     1187   empty temp-table temp-font.
     1188     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1189       case num-entries (v-font7) :
     1190         when 4 then do:
     1191             assign
     1192               loc-name = entry ( 1 , v-font7 )
     1193               loc-size = entry ( 2 , v-font7 )
     1194               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1195             .
     1196         end.
     1197         when 3 then do:
     1198             assign
     1199               loc-name = entry ( 1 , v-font7 )
     1200               loc-size = entry ( 2 , v-font7 )
     1201               loc-type = entry ( 3 , v-font7 )
     1202             .
     1203         end.
     1204         when 2 then  do:
     1205             assign
     1206               loc-name = entry ( 1 , v-font7 )
     1207               loc-size = entry ( 2 , v-font7 )
     1208               loc-type = ""
     1209             .
     1210         end.
     1211         when 1 then do:
     1212             assign
     1213               loc-name = trim(entry ( 1 , v-font7 ))
     1214               loc-size = ""
     1215               loc-type = ""
     1216             .
     1217         end.
     1218       end case.
     1219     create temp-font.
     1220     assign
     1221       temp-font.fontnum  = 7
     1222       temp-font.fontname = trim(loc-name)
     1223       temp-font.fontsize = trim(loc-size)
     1224       temp-font.fonttype = trim(loc-type)
     1225       temp-font.v-row    = 62
     1226       temp-font.v-col    = 136
     1227       temp-font.v-row-lans = 43
     1228       temp-font.v-col-lans = 198
     1229     .
     1230     repeat ii = 16 to 100 :
     1231       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1232       if v-font = "" or v-font = ? then leave.
     1233       case num-entries (v-font) :
     1234         when 4 then do:
     1235             assign
     1236               loc-name = entry ( 1 , v-font )
     1237               loc-size = entry ( 2 , v-font )
     1238               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1239             .
     1240         end.
     1241         when 3 then do:
     1242             assign
     1243               loc-name = entry ( 1 , v-font )
     1244               loc-size = entry ( 2 , v-font )
     1245               loc-type = entry ( 3 , v-font )
     1246             .
     1247         end.
     1248         when 2 then do:
     1249             assign
     1250               loc-name = entry ( 1 , v-font )
     1251               loc-size = entry ( 2 , v-font )
     1252               loc-type = ""
     1253             .
     1254         end.
     1255         when 1 then do:
     1256             assign
     1257               loc-name = trim(entry ( 1 , v-font ))
     1258               loc-size = ""
     1259               loc-type = ""
     1260             .
     1261         end.
     1262       end case.
     1263     create temp-font.
     1264     assign
     1265       temp-font.fontnum  = ii
     1266       temp-font.fontname = trim(loc-name)
     1267       temp-font.fontsize = trim(loc-size)
     1268       temp-font.fonttype = trim(loc-type)
     1269     .
     1270     end.
     1271       for each temp-font :
     1272          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1273          if  vv = ? then vv =  0 .
     1274           run rep/exfont.p (
     1275             input   temp-font.fontname ,
     1276             input   vv ,
     1277             input   temp-font.fonttype ,
     1278             output  temp-font.font-h   ,
     1279             output  temp-font.font-w   )
     1280           .
     1281       end.
     1282   find first temp-font where  temp-font.fontnum  = 7  .
     1283   old_H = temp-font.font-H .
     1284   old_w = temp-font.font-W .
     1285   old-row = temp-font.v-row .
     1286   old-col = temp-font.v-col .
     1287   old-row-lans = temp-font.v-row-lans .
     1288   old-col-lans = temp-font.v-col-lans .
     1289       for each temp-font where
     1290                temp-font.fontnum  <> 7 :
     1291           assign
     1292               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1293               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1294               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1295               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1296           .
     1297       end.
     1298     end.
     1299   end procedure.
     1300   PROCEDURE How-name :
     1301   define input  parameter h as integer no-undo .
     1302   define input  parameter w as integer no-undo .
     1303   define output parameter n as character  no-undo .
     1304   define variable A4port-H as integer   no-undo init 63.
     1305   define variable A4port-W as integer   no-undo init 136.
     1306   define variable A4lans-H as integer   no-undo init 43.
     1307   define variable A4lans-W as integer   no-undo init 198.
     1308   define variable Strim-W  as integer   no-undo init 278.
     1309   run define-a4-size (
     1310        input ReportFontNum
     1311       ,output A4port-H
     1312       ,output A4port-W
     1313       ,output A4lans-H
     1314       ,output A4lans-W ).
     1315   If w >= 1 and w <= A4port-W Then DO:
     1316     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1317     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1318     If h > A4port-H              Then n = "to-file":U.
     1319   End.
     1320   If w > A4port-W and w <= A4lans-W Then DO:
     1321     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1322     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1323     If h > A4port-H              Then n = "to-file":U.
     1324   End.
     1325   If w > A4lans-W and w <= Strim-W Then DO:
     1326     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1327     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1328     If h > A4port-H              Then n = "to-file":U.
     1329   End.
     1330   If w > Strim-W Then DO:
     1331      n = "to-file":U.
     1332   End.
     1333   END PROCEDURE.
     1334   PROCEDURE define-a4-size :
     1335   define input  parameter p-ReportFontNum as integer   no-undo .
     1336   define output parameter A4port-H as integer   no-undo .
     1337   define output parameter A4port-W as integer   no-undo .
     1338   define output parameter A4lans-H as integer   no-undo .
     1339   define output parameter A4lans-W as integer   no-undo .
     1340   if not can-find (first temp-font ) then do:
     1341      run get-font-ini .
     1342   end.
     1343   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1344   if available temp-font then do:
     1345   assign
     1346     A4port-H = temp-font.v-row
     1347     A4port-W = temp-font.v-col
     1348     A4lans-H = temp-font.v-row-lans
     1349     A4lans-W = temp-font.v-col-lans
     1350   .
     1351   end.
     1352   else do:
     1353   assign
     1354     A4port-H = 63
     1355     A4port-W = 136
     1356     A4lans-H = 43
     1357     A4lans-W = 198
     1358   .
     1359   end.
     1360   END PROCEDURE.
