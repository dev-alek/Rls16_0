     3283     excel-sum(b1-Inv          [2])  CHR(9)
     3284     excel-sum(b1-Inv          [5])  CHR(9)
     3285     excel-sum(b1-Inv          [8])  CHR(9)
     3286     excel-sum(b1-Inv          [3])  CHR(9)
