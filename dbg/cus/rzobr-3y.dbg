     1723                   output  coast_v     ,
     1724                   output  vat_r       ,
     1725                   output  vat_v       ,
     1726                   output  slt_r       ,
     1727                   output  slt_v       ).
     1728   assign
     1729     ostatok-end [1 + 0]   = quantity
     1730    ostatok-end [2 + 0]   = if tprintrubl then coast_r else coast_v
     1731    ostatok-end [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1732    b1-ostatok-end [1 + 0] =  b1-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1733    b1-ostatok-end [2 + 0] =  b1-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1734    b1-ostatok-end [3 + 0] =  b1-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1735    b2-ostatok-end [1 + 0] =  b2-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1736    b2-ostatok-end [2 + 0] =  b2-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1737    b2-ostatok-end [3 + 0] =  b2-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1738    .
     1739    assign
     1740     bi-ostatok-end [1 + 0] =  bi-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1741     bi-ostatok-end [2 + 0] =  bi-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1742     bi-ostatok-end [3 + 0] =  bi-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1743    .
     1744   If  xshowcrsa or vat-crsa Then DO:
     1745   run ost-line in this-procedure
     1746                  (input   x-store-code  ,
     1747                   input   x-store-type  ,
     1748                   input   gds-zap-artic     ,
     1749                   input   gds-zap-prod-code ,
     1750                   input   gds-zap-prod-type ,
     1751                   input   x-tog-shift       ,
     1752                   input   Fact-order-2               ,
     1753                   input   'crsa':U            ,
     1754                   input   '##,##':U    ,
     1755                   input   xtog-obj    ,
     1756                   output  quantity    ,
     1757                   output  coast_r     ,
     1758                   output  coast_v     ,
     1759                   output  vat_r       ,
     1760                   output  vat_v       ,
     1761                   output  slt_r       ,
     1762                   output  slt_v       ).
     1763   assign
     1764     ostatok-end [4]        = round(ostatok-end [1] *  p-price-med , 2)
     1765    ostatok-end [2 + 3]   = if tprintrubl then coast_r else coast_v
     1766    ostatok-end [3 + 3]   = if tprintrubl then vat_r   else vat_v
     1767    b1-ostatok-end [1 + 3] =  b1-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1768    b1-ostatok-end [2 + 3] =  b1-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1769    b1-ostatok-end [3 + 3] =  b1-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1770    b2-ostatok-end [1 + 3] =  b2-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1771    b2-ostatok-end [2 + 3] =  b2-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1772    b2-ostatok-end [3 + 3] =  b2-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1773    .
     1774    assign
     1775     bi-ostatok-end [1 + 3] =  bi-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1776     bi-ostatok-end [2 + 3] =  bi-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1777     bi-ostatok-end [3 + 3] =  bi-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1778    .
     1779      End.
     1780   If xshowsale or vat-sale Then DO:
     1781   run ost-line in this-procedure
     1782                  (input   x-store-code  ,
     1783                   input   x-store-type  ,
     1784                   input   gds-zap-artic     ,
     1785                   input   gds-zap-prod-code ,
     1786                   input   gds-zap-prod-type ,
     1787                   input   x-tog-shift       ,
     1788                   input   Fact-order-2               ,
     1789                   input   'crsa':U            ,
     1790                   input   '##,##':U    ,
     1791                   input   xtog-obj    ,
     1792                   output  quantity    ,
     1793                   output  coast_r     ,
     1794                   output  coast_v     ,
     1795                   output  vat_r       ,
     1796                   output  vat_v       ,
     1797                   output  slt_r       ,
     1798                   output  slt_v       ).
     1799   assign
     1800     ostatok-end [1 + 6]   = quantity
     1801    ostatok-end [2 + 6]   = if tprintrubl then coast_r else coast_v
     1802    ostatok-end [3 + 6]   = if tprintrubl then vat_r   else vat_v
     1803    ostatok-end [10]        = if tprintrubl then slt_r   else slt_v
     1804    b1-ostatok-end [1 + 6] =  b1-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1805    b1-ostatok-end [2 + 6] =  b1-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1806    b1-ostatok-end [3 + 6] =  b1-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1807    b2-ostatok-end [1 + 6] =  b2-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1808    b2-ostatok-end [2 + 6] =  b2-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1809    b2-ostatok-end [3 + 6] =  b2-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1810    b1-ostatok-end [10] =  b1-ostatok-end [10] + ostatok-end [10]
     1811    b2-ostatok-end [10] =  b2-ostatok-end [10] + ostatok-end [10]
     1812    .
     1813    assign
     1814     bi-ostatok-end [1 + 6] =  bi-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1815     bi-ostatok-end [2 + 6] =  bi-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1816     bi-ostatok-end [3 + 6] =  bi-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1817     bi-ostatok-end [10] =  bi-ostatok-end [10] + ostatok-end [10]
     1818    .
     1819      End.
     1820       case  gds-zap-type :
     1821       when 'у':U THEN DO:
     1822         run ob-line (
     1823             input   x-store-code   ,
     1824             input   x-store-type   ,
     1825             INPUT   gds-zap-artic       ,
     1826             INPUT   gds-zap-prod-code   ,
     1827             INPUT   gds-zap-prod-type   ,
     1828             INPUT   Fact-order-1,
     1829             INPUT   Fact-order-2,
     1830             input   'cssr':U    ,
     1831             input   '##,##':U,
     1832             input   ""    ,
     1833             input   xTog-obj) .
     1834        End.
     1835       when 'т':U THEN DO:
     1836         run ob-line (
     1837             input   x-store-code   ,
     1838             input   x-store-type   ,
     1839             INPUT   gds-zap-artic       ,
     1840             INPUT   gds-zap-prod-code   ,
     1841             INPUT   gds-zap-prod-type   ,
     1842             INPUT   Fact-order-1,
     1843             INPUT   Fact-order-2,
     1844             input   'cost':U    ,
     1845             input   '##,##':U,
     1846             input   ""    ,
     1847             input   xTog-obj) .
     1848         End.
     1849         End case.
     1850      run calc-sub-itog (0).
     1851     If xshowcrsa OR  xshowsale or vat-crsa or vat-sale Then DO:
     1852       case  gds-zap-type :
     1853       when 'у':U THEN DO:
     1854         run ob-line (
     1855             input   x-store-code   ,
     1856             input   x-store-type   ,
     1857             INPUT   gds-zap-artic       ,
     1858             INPUT   gds-zap-prod-code   ,
     1859             INPUT   gds-zap-prod-type   ,
     1860             INPUT   Fact-order-1,
     1861             INPUT   Fact-order-2,
     1862             input   'cgsr':U    ,
     1863             input   '##,##':U,
     1864             input   ""    ,
     1865             input   xTog-obj) .
     1866        End.
     1867       when 'т':U THEN DO:
     1868         run ob-line (
     1869             input   x-store-code   ,
     1870             input   x-store-type   ,
     1871             INPUT   gds-zap-artic       ,
     1872             INPUT   gds-zap-prod-code   ,
     1873             INPUT   gds-zap-prod-type   ,
     1874             INPUT   Fact-order-1,
     1875             INPUT   Fact-order-2,
     1876             input   'crsa':U    ,
     1877             input   '##,##':U,
     1878             input   ""    ,
     1879             input   xTog-obj) .
     1880         End.
     1881             End case.
     1882        run calc-sub-itog (3).
     1883        End.
     1884     If xshowsale  Then DO:
     1885       case  gds-zap-type :
     1886       when 'у':U THEN DO:
     1887         run ob-line (
     1888             input   x-store-code   ,
     1889             input   x-store-type   ,
     1890             INPUT   gds-zap-artic       ,
     1891             INPUT   gds-zap-prod-code   ,
     1892             INPUT   gds-zap-prod-type   ,
     1893             INPUT   Fact-order-1,
     1894             INPUT   Fact-order-2,
     1895             input   'sasr':U    ,
     1896             input   '##,##':U,
     1897             input   ""    ,
     1898             input   xTog-obj) .
     1899        End.
     1900       when 'т':U THEN DO:
     1901         run ob-line (
     1902             input   x-store-code   ,
     1903             input   x-store-type   ,
     1904             INPUT   gds-zap-artic       ,
     1905             INPUT   gds-zap-prod-code   ,
     1906             INPUT   gds-zap-prod-type   ,
     1907             INPUT   Fact-order-1,
     1908             INPUT   Fact-order-2,
     1909             input   'sale':U    ,
     1910             input   '##,##':U,
     1911             input   ""    ,
     1912             input   xTog-obj) .
     1913         End.
     1914             End case.
     1915        run calc-sub-itog (6).
     1916        End.
     1917   END PROCEDURE.
     1918   PROCEDURE display-line :
     1919        i = i + 1.
     1920           if NOT( NOT Show-Negativ-2 and
     1921            ( prih         [1]   = 0 AND
     1922             rash          [1]   = 0 AND
     1923             kassa         [1]   = 0 AND
     1924             Inv           [1]   = 0 AND
     1925             Overturn      [1]   = 0 AND
     1926             Overturn      [5]   = 0 AND
     1927             Overturn      [8]   = 0 ) ) then DO:
     1928           IF  NOT (NOT Show-Negativ  AND (
     1929                 prih          [1]   = 0 AND
     1930                 rash          [1]   = 0 AND
     1931                 kassa         [1]   = 0 AND
     1932                 Inv           [1]   = 0 AND
     1933                 Overturn      [1]   = 0 AND
     1934                 Overturn      [5]   = 0 AND
     1935                 ostatok-start [1]   = 0 AND
     1936                 ostatok-End   [1]   = 0   )) then DO:
     1937           IF NOT Sums-Only then DO:
     1938               if fr0 = true then do:
     1939                 PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     1940                 if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     1941                 fr0 = false .
     1942               end.
     1943               if fr = true then dO:
     1944                 PUT stream OutStream space(10) temp-str format "X(100)" SKIP.
     1945                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) String(temp-str) skip.
     1946                 fr = false .
     1947               end.
     1948              run display-str1 in this-procedure.
     1949             End.
     1950           End.
     1951        END.
     1952     END PROCEDURE.
     1953   PROCEDURE print-header :
     1954   if NOT FirstLine Then DO:
     1955      run display-title.
     1956      FORM with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1957   End.
     1958    FirstLine = TRUE .
     1959       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     1960             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name)  AT 30 format "X(170)" SKIP.
     1961             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name) format "X(170)" SKIP.
     1962         End.
     1963         run clear-b1 .
     1964         run clear-b2.
     1965         run clear-bi .
     1966         break_group = true.
     1967         break_group1 = true.
     1968      END PROCEDURE.
     1969   PROCEDURE Print-Footer :
     1970         If RetClassify = "no-classify":U  then run u-line.
     1971          gds-zap-artic = "ИТОГО" .
     1972          run display-bi.
     1973          run u-line.
     1974          END PROCEDURE.
     1975   PROCEDURE U-LINE :
     1976   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1977           s-bar-code
     1978           gds-zap-artic
     1979           gds-zap-gds-name
     1980           gds-zap-unit-base
     1981           gds-type
     1982           F-ostatok-start
     1983           F-Prih
     1984           F-Rash
     1985           F-KAssa
     1986           F-Inv
     1987           F-Overturn
     1988           F-ostatok-end
     1989           gds-zap-other
     1990           with FRAME ZAPAS .
     1991           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1992           END PROCEDURE.
     1993   PROCEDURE P-LINE :
     1994   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1995           gds-zap-artic
     1996           gds-zap-gds-name
     1997           gds-zap-unit-base
     1998           gds-type
     1999           F-ostatok-start
     2000           F-Prih
     2001           F-Rash
     2002           F-KAssa
     2003           F-Inv
     2004           F-Overturn
     2005           F-ostatok-end
     2006           gds-zap-other
     2007           with FRAME ZAPAS .
     2008           DOWN stream   OutStream 1 with FRAME ZAPAS.
     2009           END PROCEDURE.
     2010   procedure run3 :
     2011     run run3sort2.
     2012   end procedure.
     2013   procedure run3sort2 :
     2014     case select-good :
     2015       when 1  then do:
     2016   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2017   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2018       for each gds-obj  where
     2019             gds-obj.obj-type = x-store-type  and
     2020             gds-obj.obj-code = x-store-code
     2021             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2022         no-lock,
     2023   First clients  where  clients.obj-code = gds-obj.prod-code and
     2024                         clients.obj-type = gds-obj.prod-type
     2025                   no-lock,
     2026             First goods  where  gds-obj.gds-code   = goods.gds-code
     2027   no-lock
     2028   BREAK
     2029         BY ((substring(clients.obj-name,1,10) + string(gds-obj.prod-code)))
     2030       BY (goods.artic) :
     2031         run item-goods ( "2" , "goods" ) .
     2032         if return-value <> "" then NEXT.
     2033           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2034           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2035             Then  Assign
     2036                     S-bar-code   = " Итого по "
     2037                     Gds-zap-artic = Substring(
     2038                                         B1-name
     2039                                         ,1,16)
     2040                     Gds-zap-gds-name = Substring(
     2041                                         B1-name
     2042                                         ,17,40)
     2043                                   .
     2044             Else  Assign
     2045                     S-bar-code   = ""
     2046                     Gds-zap-artic = "        Итого по "
     2047                     Gds-zap-gds-name =  B1-name
     2048                                   .
     2049               Run Display-b1 In This-procedure .
     2050               Run Clear-b1 In This-procedure .
     2051               Assign Break_Group = True.
     2052           End.
     2053       End.
     2054     END.
     2055     Else DO:
     2056      For each obj-list no-lock :
     2057                     FOR EACH gds-obj where
     2058                   gds-obj.obj-type = obj-list.obj-type    and
     2059                   gds-obj.obj-code = obj-list.obj-code
     2060                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2061                   no-lock :
     2062                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2063                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2064                       Create temp-gds-list.
     2065                       Assign
     2066                         temp-gds-list.prod-code = gds-obj.prod-code
     2067                         temp-gds-list.grp-name  = gds-obj.grp-name
     2068                         temp-gds-list.gds-name  = goods.gds-name
     2069                         temp-gds-list.gds-code  = gds-obj.gds-code
     2070                         temp-gds-list.artic     = gds-obj.artic
     2071                       .
     2072                   End.
     2073               End.
     2074     End.
     2075     for each temp-gds-list no-lock
     2076       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2077                                        , First clients   where  clients.obj-code = goods.prod-code and
     2078                                                                 clients.obj-type = goods.prod-type
     2079         BREAK
     2080   BY ((substring(clients.obj-name,1,10) + string(gds-obj.prod-code)))
     2081       BY goods.artic :
     2082       run item-goods ( "2" , "goods" ) .
     2083         if return-value <> "" then NEXT.
     2084           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2085           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2086             Then  Assign
     2087                     S-bar-code   = " Итого по "
     2088                     Gds-zap-artic = Substring(
     2089                                         B1-name
     2090                                         ,1,16)
     2091                     Gds-zap-gds-name = Substring(
     2092                                         B1-name
     2093                                         ,17,40)
     2094                                   .
     2095             Else  Assign
     2096                     S-bar-code   = ""
     2097                     Gds-zap-artic = "        Итого по "
     2098                     Gds-zap-gds-name =  B1-name
     2099                                   .
     2100               Run Display-b1 In This-procedure .
     2101               Run Clear-b1 In This-procedure .
     2102               Assign Break_Group = True.
     2103           End.
     2104     End.
     2105   End.
     2106     end.
     2107       when 2  then do:
     2108   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2109     if x-selectobject = "currency":u  or  xtog-obj then do:
     2110         for  each gds-obj
     2111                     where gds-obj.obj-code   = x-store-code
     2112                      and  gds-obj.obj-type   = x-store-type
     2113                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2114                           no-lock ,
     2115                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2116                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     2117                     break
     2118                     by (substring(clients.obj-name,1,10) + string(gds-obj.prod-code))
     2119                     by goods.artic :
     2120                     run item-goods ( input "2" , input "goods" ) .
     2121                     if return-value <> "" then next.
     2122           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2123           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2124             Then  Assign
     2125                     S-bar-code   = " Итого по "
     2126                     Gds-zap-artic = Substring(
     2127                                         B1-name
     2128                                         ,1,16)
     2129                     Gds-zap-gds-name = Substring(
     2130                                         B1-name
     2131                                         ,17,40)
     2132                                   .
     2133             Else  Assign
     2134                     S-bar-code   = ""
     2135                     Gds-zap-artic = "        Итого по "
     2136                     Gds-zap-gds-name =  B1-name
     2137                                   .
     2138               Run Display-b1 In This-procedure .
     2139               Run Clear-b1 In This-procedure .
     2140               Assign Break_Group = True.
     2141           End.
     2142         end.
     2143     end.
     2144     else do:
     2145         for each obj-list no-lock :
     2146               for  each gds-obj
     2147                 where  gds-obj.obj-code   = obj-list.obj-code
     2148                   and  gds-obj.obj-type   = obj-list.obj-type
     2149                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2150                 no-lock ,
     2151                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2152                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     2153                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2154                           create temp-gds-list.
     2155                           assign
     2156                             temp-gds-list.prod-code = gds-obj.prod-code
     2157                             temp-gds-list.grp-name  = gds-obj.grp-name
     2158                             temp-gds-list.gds-name  = goods.grp-name
     2159                             temp-gds-list.gds-code  = gds-obj.gds-code
     2160                             temp-gds-list.artic     = gds-obj.artic
     2161                           .
     2162                       end.
     2163               end.
     2164       end.
     2165     for each temp-gds-list no-lock
     2166       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2167         break
     2168           by (substring(clients.obj-name,1,10) + string(gds-obj.prod-code))
     2169       by goods.artic :
     2170       run item-goods ( "2" , "goods" ) .
     2171         if return-value <> "" then next.
     2172           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2173           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2174             Then  Assign
     2175                     S-bar-code   = " Итого по "
     2176                     Gds-zap-artic = Substring(
     2177                                         B1-name
     2178                                         ,1,16)
     2179                     Gds-zap-gds-name = Substring(
     2180                                         B1-name
     2181                                         ,17,40)
     2182                                   .
     2183             Else  Assign
     2184                     S-bar-code   = ""
     2185                     Gds-zap-artic = "        Итого по "
     2186                     Gds-zap-gds-name =  B1-name
     2187                                   .
     2188               Run Display-b1 In This-procedure .
     2189               Run Clear-b1 In This-procedure .
     2190               Assign Break_Group = True.
     2191           End.
     2192     end.
     2193   end.
     2194     end.
     2195       when 3 then do:
     2196   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2197   if x-selectobject = "currency":u  or  xtog-obj then do:
     2198     for  each gds-obj
     2199         where  gds-obj.obj-code   = x-store-code
     2200           and  gds-obj.obj-type   = x-store-type
     2201                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2202                 no-lock ,
     2203     first g#cli
     2204           where gds-obj.prod-code  = g#cli.obj-code
     2205           and  gds-obj.prod-type   = g#cli.obj-type
     2206           no-lock,
     2207     first goods
     2208           where gds-obj.gds-code = goods.gds-code no-lock
     2209           break
     2210           by ((substring(clients.obj-name,1,10) + string(gds-obj.prod-code)))
     2211           by goods.artic :
     2212           run item-goods ( "2" , "goods" ) .
     2213           if return-value <> "" then next.
     2214           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2215           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2216             Then  Assign
     2217                     S-bar-code   = " Итого по "
     2218                     Gds-zap-artic = Substring(
     2219                                         B1-name
     2220                                         ,1,16)
     2221                     Gds-zap-gds-name = Substring(
     2222                                         B1-name
     2223                                         ,17,40)
     2224                                   .
     2225             Else  Assign
     2226                     S-bar-code   = ""
     2227                     Gds-zap-artic = "        Итого по "
     2228                     Gds-zap-gds-name =  B1-name
     2229                                   .
     2230               Run Display-b1 In This-procedure .
     2231               Run Clear-b1 In This-procedure .
     2232               Assign Break_Group = True.
     2233           End.
     2234         end.
     2235     end.
     2236     else do:
     2237       for each obj-list no-lock :
     2238             for  each gds-obj
     2239               where  gds-obj.obj-code   = obj-list.obj-code
     2240                 and  gds-obj.obj-type   = obj-list.obj-type
     2241                       and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2242                       no-lock ,
     2243             first g#cli
     2244                 where gds-obj.prod-code  = g#cli.obj-code
     2245                 and  gds-obj.prod-type   = g#cli.obj-type
     2246                 no-lock,
     2247             first goods
     2248                 where gds-obj.gds-code = goods.gds-code no-lock :
     2249                   if not can-find (first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2250                       create temp-gds-list.
     2251                       assign
     2252                         temp-gds-list.prod-code = gds-obj.prod-code
     2253                         temp-gds-list.grp-name  = gds-obj.grp-name
     2254                         temp-gds-list.gds-name  = goods.gds-name
     2255                         temp-gds-list.gds-code  = gds-obj.gds-code
     2256                         temp-gds-list.artic     = gds-obj.artic
     2257                       .
     2258                   end.
     2259             end.
     2260       end.
     2261         for each temp-gds-list no-lock
     2262           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2263             break
     2264               by ((substring(clients.obj-name,1,10) + string(gds-obj.prod-code)))
     2265               by goods.artic :
     2266           run item-goods ( "2" , "goods" ) .
     2267             if return-value <> "" then next.
     2268           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     2269           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     2270             Then  Assign
     2271                     S-bar-code   = " Итого по "
     2272                     Gds-zap-artic = Substring(
     2273                                         B1-name
     2274                                         ,1,16)
     2275                     Gds-zap-gds-name = Substring(
     2276                                         B1-name
     2277                                         ,17,40)
     2278                                   .
     2279             Else  Assign
     2280                     S-bar-code   = ""
     2281                     Gds-zap-artic = "        Итого по "
     2282                     Gds-zap-gds-name =  B1-name
     2283                                   .
     2284               Run Display-b1 In This-procedure .
     2285               Run Clear-b1 In This-procedure .
     2286               Assign Break_Group = True.
     2287           End.
     2288         end.
     2289   end.
     2290     end.
     2291       otherwise do:
     2292   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2293   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2294       for each gds-obj  where
     2295             gds-obj.obj-type = x-store-type  and
     2296             gds-obj.obj-code = x-store-code
     2297             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2298         no-lock,
     2299   First clients  where  clients.obj-code = gds-obj.prod-code and
     2300                         clients.obj-type = gds-obj.prod-type
     2301                   no-lock,
     2302             First goods  where  gds-obj.gds-code   = goods.gds-code
     2303         no-lock,
     2304   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2305   no-lock
     2306   BREAK
     2307         BY ((substring(clients.obj-name,1,10) + string(gds-list.prod-code)))
     2308       BY (gds-list.artic) :
     2309         run item-goods ( "2" , "gds-list" ) .
     2310         if return-value <> "" then NEXT.
     2311           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     2312           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     2313             Then  Assign
     2314                     S-bar-code   = " Итого по "
     2315                     Gds-zap-artic = Substring(
     2316                                         B1-name
     2317                                         ,1,16)
     2318                     Gds-zap-gds-name = Substring(
     2319                                         B1-name
     2320                                         ,17,40)
     2321                                   .
     2322             Else  Assign
     2323                     S-bar-code   = ""
     2324                     Gds-zap-artic = "        Итого по "
     2325                     Gds-zap-gds-name =  B1-name
     2326                                   .
     2327               Run Display-b1 In This-procedure .
     2328               Run Clear-b1 In This-procedure .
     2329               Assign Break_Group = True.
     2330           End.
     2331       End.
     2332     END.
     2333     Else DO:
     2334      For each obj-list no-lock :
     2335                     FOR EACH gds-obj where
     2336                   gds-obj.obj-type = obj-list.obj-type    and
     2337                   gds-obj.obj-code = obj-list.obj-code
     2338                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2339                   no-lock,
     2340             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2341                   no-lock :
     2342                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2343                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2344                       Create temp-gds-list.
     2345                       Assign
     2346                         temp-gds-list.prod-code = gds-obj.prod-code
     2347                         temp-gds-list.grp-name  = gds-obj.grp-name
     2348                         temp-gds-list.gds-name  = goods.gds-name
     2349                         temp-gds-list.gds-code  = gds-obj.gds-code
     2350                         temp-gds-list.artic     = gds-obj.artic
     2351                       .
     2352                   End.
     2353               End.
     2354     End.
     2355     for each temp-gds-list no-lock
     2356       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2357                                        , First clients   where  clients.obj-code = gds-list.prod-code and
     2358                                                                 clients.obj-type = gds-list.prod-type
     2359         BREAK
     2360   BY ((substring(clients.obj-name,1,10) + string(gds-list.prod-code)))
     2361       BY gds-list.artic :
     2362       run item-goods ( "2" , "gds-list" ) .
     2363         if return-value <> "" then NEXT.
     2364           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     2365           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     2366             Then  Assign
     2367                     S-bar-code   = " Итого по "
     2368                     Gds-zap-artic = Substring(
     2369                                         B1-name
     2370                                         ,1,16)
     2371                     Gds-zap-gds-name = Substring(
     2372                                         B1-name
     2373                                         ,17,40)
     2374                                   .
     2375             Else  Assign
     2376                     S-bar-code   = ""
     2377                     Gds-zap-artic = "        Итого по "
     2378                     Gds-zap-gds-name =  B1-name
     2379                                   .
     2380               Run Display-b1 In This-procedure .
     2381               Run Clear-b1 In This-procedure .
     2382               Assign Break_Group = True.
     2383           End.
     2384     End.
     2385   End.
     2386       end.
     2387     end case.
     2388   end procedure.
     2389   PROCEDURE CalcItog :
     2390       run ostatok (
     2391           input x-store-code  ,
     2392           input x-store-type  ,x-TOG-Shift,
     2393           input x-date-start - 1 ,
     2394           input date('')      , x-Shift-Start,x-Shift-End,
     2395           input 'crsa':U   ,
     2396           input '##,##':U,
     2397           input xTog-obj ,
     2398           output  Quantity1  ,
     2399           output  Coast_R1   ,
     2400           output  Coast_V1   ,
     2401           output  VAT_R1     ,
     2402           output  VAT_V1     ,
     2403           output  Fact-order-1 ).
     2404       run ostatok (
     2405           input x-store-code  ,
     2406           input x-store-type  , x-TOG-Shift,
     2407           input x-date-start  ,
     2408           input x-date-end    , x-Shift-Start,x-Shift-End,
     2409           input 'crsa':U   ,
     2410           input '##,##':U,
     2411           input xTog-obj ,
     2412           output  Quantity1  ,
     2413           output  Coast_R1   ,
     2414           output  Coast_V1   ,
     2415           output  VAT_R1     ,
     2416           output  VAT_V1     ,
     2417           output  Fact-order-2 ).
     2418             Quantity1  = 0.
     2419             Coast_R1   = 0.
     2420             Coast_V1   = 0.
     2421             VAT_R1     = 0.
     2422             VAT_V1     = 0.
     2423   END PROCEDURE.
     2424   PROCEDURE display-str1  :
     2425              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2426            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2427            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2428            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     2429            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2430            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     2431            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     2432   end procedure.
