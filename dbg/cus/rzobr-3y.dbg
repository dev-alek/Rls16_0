     3239         b1-Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     3240         b1-RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     3241         b1-KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     3242         b1-Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
