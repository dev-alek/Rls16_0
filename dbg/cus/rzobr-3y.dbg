     2444            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bo":u).  end.
     2445            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bo":u).  end.
     2446            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bo":u).  end.
     2447            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bo":u ). end.
     2448            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bo":u ).  end.
