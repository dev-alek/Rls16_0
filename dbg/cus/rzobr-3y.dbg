     1635   run ost-line in this-procedure
     1636                  (input   x-store-code  ,
     1637                   input   x-store-type  ,
     1638                   input   gds-zap-artic     ,
     1639                   input   gds-zap-prod-code ,
     1640                   input   gds-zap-prod-type ,
     1641                   input   x-tog-shift       ,
     1642                   input   Fact-order-1               ,
     1643                   input   'crsa':U            ,
     1644                   input   '##,##':U    ,
     1645                   input   xtog-obj    ,
     1646                   output  quantity    ,
     1647                   output  coast_r     ,
     1648                   output  coast_v     ,
     1649                   output  vat_r       ,
     1650                   output  vat_v       ,
     1651                   output  slt_r       ,
     1652                   output  slt_v       ).
     1653   assign
     1654     ostatok-start [4]        = round(ostatok-start [1] *  p-price-med , 2)
     1655    ostatok-start [2 + 3]   = if tprintrubl then coast_r else coast_v
     1656    ostatok-start [3 + 3]   = if tprintrubl then vat_r   else vat_v
     1657    b1-ostatok-start [1 + 3] =  b1-ostatok-start [1 + 3] + ostatok-start [1 + 3]
     1658    b1-ostatok-start [2 + 3] =  b1-ostatok-start [2 + 3] + ostatok-start [2 + 3]
     1659    b1-ostatok-start [3 + 3] =  b1-ostatok-start [3 + 3] + ostatok-start [3 + 3]
     1660    b2-ostatok-start [1 + 3] =  b2-ostatok-start [1 + 3] + ostatok-start [1 + 3]
     1661    b2-ostatok-start [2 + 3] =  b2-ostatok-start [2 + 3] + ostatok-start [2 + 3]
     1662    b2-ostatok-start [3 + 3] =  b2-ostatok-start [3 + 3] + ostatok-start [3 + 3]
     1663    .
     1664    assign
     1665     bi-ostatok-start [1 + 3] =  bi-ostatok-start [1 + 3] + ostatok-start [1 + 3]
     1666     bi-ostatok-start [2 + 3] =  bi-ostatok-start [2 + 3] + ostatok-start [2 + 3]
     1667     bi-ostatok-start [3 + 3] =  bi-ostatok-start [3 + 3] + ostatok-start [3 + 3]
     1668    .
     1669      End.
     1670   If xshowsale or vat-sale Then DO:
     1671   run ost-line in this-procedure
     1672                  (input   x-store-code  ,
     1673                   input   x-store-type  ,
     1674                   input   gds-zap-artic     ,
     1675                   input   gds-zap-prod-code ,
     1676                   input   gds-zap-prod-type ,
     1677                   input   x-tog-shift       ,
     1678                   input   Fact-order-1               ,
     1679                   input   'crsa':U            ,
     1680                   input   '##,##':U    ,
     1681                   input   xtog-obj    ,
     1682                   output  quantity    ,
     1683                   output  coast_r     ,
     1684                   output  coast_v     ,
     1685                   output  vat_r       ,
     1686                   output  vat_v       ,
     1687                   output  slt_r       ,
     1688                   output  slt_v       ).
     1689   assign
     1690     ostatok-start [1 + 6]   = quantity
     1691    ostatok-start [2 + 6]   = if tprintrubl then coast_r else coast_v
     1692    ostatok-start [3 + 6]   = if tprintrubl then vat_r   else vat_v
     1693    ostatok-start [10]        = if tprintrubl then slt_r   else slt_v
     1694    b1-ostatok-start [1 + 6] =  b1-ostatok-start [1 + 6] + ostatok-start [1 + 6]
     1695    b1-ostatok-start [2 + 6] =  b1-ostatok-start [2 + 6] + ostatok-start [2 + 6]
     1696    b1-ostatok-start [3 + 6] =  b1-ostatok-start [3 + 6] + ostatok-start [3 + 6]
     1697    b2-ostatok-start [1 + 6] =  b2-ostatok-start [1 + 6] + ostatok-start [1 + 6]
     1698    b2-ostatok-start [2 + 6] =  b2-ostatok-start [2 + 6] + ostatok-start [2 + 6]
     1699    b2-ostatok-start [3 + 6] =  b2-ostatok-start [3 + 6] + ostatok-start [3 + 6]
     1700    b1-ostatok-start [10] =  b1-ostatok-start [10] + ostatok-start [10]
     1701    b2-ostatok-start [10] =  b2-ostatok-start [10] + ostatok-start [10]
     1702    .
