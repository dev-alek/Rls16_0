     3128   define input parameter p7 as char no-undo.
     3129    CASE CAPS(p7) :
     3130      WHEN "B1":U  Then DO:
     3131       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3132         p3 @ s-bar-code
