     2494              b2-Overturn      [5]   = 0 AND
     2495              b2-Overturn      [8]   = 0 ) ) then DO:
     2496           IF  NOT (NOT Show-Negativ  AND (
     2497                 b2-prih          [1]   = 0 AND
     2498                 b2-rash          [1]   = 0 AND
     2499                 b2-kassa         [1]   = 0 AND
     2500                 b2-Inv           [1]   = 0 AND
     2501                 b2-Overturn      [1]   = 0 AND
     2502                 b2-Overturn      [5]   = 0 AND
     2503                 b2-ostatok-start [1]   = 0 AND
