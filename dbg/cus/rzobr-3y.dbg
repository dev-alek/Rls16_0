     3161         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3162         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3163         with FRAME ZAPAS .
     3164                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3165                 End.
     3166      WHEN "BI":U Then  DO:
     3167       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3168         p3 @ s-bar-code
     3169         p4 @ gds-zap-artic
     3170         p5 @ gds-zap-gds-name
     3171         p6 @ gds-zap-unit-base
     3172         p1 @ gds-type
     3173         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3174         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3175         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3176         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3177         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3178         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3179         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3180         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3181         with FRAME ZAPAS .
     3182                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3183                 End.
     3184      WHEN "BO":U Then  DO:
     3185       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3186         p3 @ s-bar-code
     3187         p4 @ gds-zap-artic
     3188         p5 @ gds-zap-gds-name
     3189         p6 @ gds-zap-unit-base
     3190         p1 @ gds-type
