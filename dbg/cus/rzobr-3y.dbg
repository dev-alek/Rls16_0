     2554   PROCEDURE Display-title :
     2555   define variable v-nn as integer   no-undo .
     2556      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2557             REPORTNAME  AT 20 format "X(170)" SKIP
     2558             Trim(str1)  AT 35 format "X(75)" SKIP.
     2559        v-nn = NUM-ENTRIES(str2,chr(10)) .
     2560        Repeat i = 1 to v-nn:
     2561         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     2562        End.
     2563       i=0.
     2564          PUT stream  OutStream  UNFORMATTED  Trim(str3)  AT 35 format "X(75)" SKIP.
     2565        v-nn = NUM-ENTRIES(str4,chr(10)).
     2566        Repeat i = 1 to v-nn :
     2567         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2568        End.
     2569       i=0.
     2570        v-nn = NUM-ENTRIES(ReportHeader,chr(10)) .
     2571        Repeat i = 1 to v-nn :
     2572         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2573        End.
     2574       i=0.
     2575       run rep/extitle.p (1) .
     2576   END PROCEDURE.
     2577   PROCEDURE ob-line  :
     2578   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2579   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2580   define INPUT  parameter x-artic        like ub.ot-line.artic        no-undo.
     2581   define INPUT  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2582   define INPUT  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2583   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2584   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2585   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2586   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2587   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2588   define input  parameter xTog-obj           as log no-undo.
     2589   define variable  tt#          as   int                 no-undo.
     2590    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     2591    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     2592    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     2593        FOR each ub.ot-line where
     2594                           ub.ot-line.artic         = x-artic
     2595                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2596                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2597                     AND   ub.ot-line.obj-code     = x-store-code
     2598                     AND   ub.ot-line.obj-type     = x-store-type
     2599                     AND   ub.ot-line.prod-code    = x-prod-code
     2600                     AND   ub.ot-line.prod-type    = x-prod-type
     2601                     AND   ub.ot-line.sum-type     = x-sum-type
     2602                       no-lock :
     2603       CASE ub.ot-line.ext-doc-type:
     2604                 WHEN        'ie':U  OR
     2605                 WHEN        're':U  OR
     2606                 WHEN        'iv':U    OR
     2607                 WHEN        'rv':U OR
     2608                 WHEN        'im':U     THEN
     2609                 DO:
     2610                 ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  ub.ot-line.fact-qnty
     2611                        prih[2 + tt#]   = prih[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2612                        prih[3 + tt#]   = prih[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2613                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2614                 End.
     2615                 WHEN       'ee':U      OR
     2616                 WHEN       'ep':U    OR
     2617                 WHEN       'ev':U     OR
     2618                 WHEN       'em':U       OR
     2619                 WHEN       'wm':U       OR
     2620                 WHEN       'we':U     THEN
     2621                 DO:
     2622                 ASSIGN  rash[1 + tt#]   = rash[1 + tt#]   +  ub.ot-line.fact-qnty
     2623                         rash[2 + tt#]   = rash[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2624                         rash[3 + tt#]   = rash[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2625                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2626                 End.
     2627                 WHEN       'es':U  OR
     2628                 WHEN       'rs':U THEN
     2629                 DO:
     2630                 ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.ot-line.fact-qnty
     2631                        kassa[2 + tt#]   = kassa[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2632                        kassa[3 + tt#]   = kassa[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2633                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2634                 End.
     2635             WHEN  'vt':U or when 'vp':U     THEN
     2636                 DO:
     2637                 ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.ot-line.fact-qnty
     2638                       inv[2 + tt#]   = inv[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2639                       Inv[3 + tt#]   = Inv[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.vat-base  .
     2640                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2641                 End.
     2642             WHEN       'ot':U THEN
     2643                 DO:
     2644                 ASSIGN Overturn[1 + tt#]   = Overturn[1 + tt#]   +  ub.ot-line.fact-qnty
     2645                       Overturn[2 + tt#]   = Overturn[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2646                       Overturn[3 + tt#]   = Overturn[3 + tt#]   +  if tPrintRubl then ub.ot-line.vat-rubl Else  ub.ot-line.vat-base  .
     2647                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2648                 End.
     2649         End CASE.
     2650     END.
     2651     if tt# = 6 then DO:
     2652              ASSIGN Overturn[1 + tt#]   = (Ostatok-end[1 + tt#]  - Ostatok-start[1 + tt#] )  -  (INV[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2653                     Overturn[2 + tt#]   = (Ostatok-end[2 + tt#]  - Ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  )
     2654                     Overturn[3 + tt#]   = (Ostatok-end[3 + tt#]  - Ostatok-start[3 + tt#] )  -  (Inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2655     End.
     2656   END PROCEDURE.
     2657   procedure ost-line :
     2658     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2659     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2660     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2661     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2662     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2663     define input  parameter x-tog-shift  as logical no-undo .
     2664     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2665     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2666     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2667     define input  parameter xtog-obj     as logical no-undo .
     2668     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2669     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2670     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2671     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2672     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2673     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2674     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2675     define buffer buff-obj-list  for obj-list .
     2676     define buffer buff-stk-line  for ub.stk-line .
     2677     assign
     2678       Quantity = 0
     2679       Coast_R  = 0
     2680       Coast_V  = 0
     2681       VAT_R    = 0
     2682       VAT_V    = 0
     2683       SLT_R    = 0
     2684       SLT_V    = 0
     2685     .
     2686     if  x-tog-shift = false then do:
     2687       for each buff-obj-list no-lock
     2688         where xtog-obj = false
     2689            or (buff-obj-list.obj-type = x-store-type
     2690               and buff-obj-list.obj-code = x-store-code
     2691               )
     2692       on error undo, return error
     2693       :
     2694       find last buff-stk-line no-lock
     2695         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2696           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2697           and buff-stk-line.artic      = x-artic
     2698           and buff-stk-line.prod-type  = x-prod-type
     2699           and buff-stk-line.prod-code  = x-prod-code
     2700           and buff-stk-line.sum-type   = x-sum-type
     2701           and buff-stk-line.cat-id     = '##,##':U
     2702           and buff-stk-line.fact-order <= x-fact-order
     2703           and buff-stk-line.shift-num  = 0
     2704         use-index category
     2705         no-error .
     2706       if available buff-stk-line then do:
     2707         assign
     2708           Quantity = Quantity + buff-stk-line.fact-qnty
     2709           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2710           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2711           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2712           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2713           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2714           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2715         .
     2716       end.
     2717      end.
     2718     end.
     2719     else do:
     2720       for each buff-obj-list no-lock
     2721         where xtog-obj = false
     2722            or (buff-obj-list.obj-type = x-store-type
     2723               and buff-obj-list.obj-code = x-store-code
     2724               )
     2725       on error undo, return error
     2726       :
     2727         find last buff-stk-line no-lock
     2728           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2729             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2730             and buff-stk-line.artic      = x-artic
     2731             and buff-stk-line.prod-type  = x-prod-type
     2732             and buff-stk-line.prod-code  = x-prod-code
     2733             and buff-stk-line.sum-type   = x-sum-type
     2734             and buff-stk-line.cat-id     = '##,##':U
     2735             and buff-stk-line.fact-order <= x-fact-order
     2736             and buff-stk-line.shift-num  > 0
     2737           use-index category
     2738           no-error .
     2739         if available buff-stk-line then do:
     2740           assign
     2741             Quantity = Quantity +  buff-stk-line.fact-qnty
     2742             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2743             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2744             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2745             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2746             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2747             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2748           .
     2749         end.
     2750       end.
     2751     end.
     2752   end procedure.
     2753   procedure ost-lineother-tax :
     2754     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2755     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2756     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2757     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2758     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2759     define input  parameter x-tog-shift  as logical no-undo .
     2760     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2761     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2762     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2763     define input  parameter xTog-obj     as logical no-undo .
     2764     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2765     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2766     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2767     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2768     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2769     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2770     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2771     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2772     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2773     define buffer buff-obj-list  for obj-list .
     2774     define buffer buff-stk-line  for ub.stk-line .
     2775     assign
     2776       Quantity = 0
     2777       Coast_R  = 0
     2778       Coast_V  = 0
     2779       VAT_R    = 0
     2780       VAT_V    = 0
     2781       SLT_R    = 0
     2782       SLT_V    = 0
     2783       other_R  = 0
     2784       other_V  = 0
     2785     .
     2786     if  x-tog-shift = false then do:
     2787       for each buff-obj-list no-lock
     2788         where xtog-obj = false
     2789            or (buff-obj-list.obj-type = x-store-type
     2790               and buff-obj-list.obj-code = x-store-code
     2791               )
     2792       on error undo, return error
     2793       :
     2794       find last buff-stk-line no-lock
     2795         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2796           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2797           and buff-stk-line.artic      = x-artic
     2798           and buff-stk-line.prod-type  = x-prod-type
     2799           and buff-stk-line.prod-code  = x-prod-code
     2800           and buff-stk-line.sum-type   = x-sum-type
     2801           and buff-stk-line.cat-id     = '##,##':U
     2802           and buff-stk-line.fact-order <= x-fact-order
     2803           and buff-stk-line.shift-num  = 0
     2804         use-index category
     2805         no-error .
     2806       if available buff-stk-line then do:
     2807         assign
     2808           Quantity = Quantity + buff-stk-line.fact-qnty
     2809           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2810           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2811           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2812           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2813           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2814           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2815           other_R  = other_R  + buff-stk-line.other-rubl
     2816           other_V  = other_V  + buff-stk-line.other-base
     2817         .
     2818       end.
     2819    end.
     2820     end.
     2821     else do:
     2822       for each buff-obj-list no-lock
     2823         where xtog-obj = false
     2824            or (buff-obj-list.obj-type = x-store-type
     2825               and buff-obj-list.obj-code = x-store-code
     2826               )
     2827       on error undo, return error
     2828       :
     2829         find last buff-stk-line no-lock
     2830           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2831             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2832             and buff-stk-line.artic      = x-artic
     2833             and buff-stk-line.prod-type  = x-prod-type
     2834             and buff-stk-line.prod-code  = x-prod-code
     2835             and buff-stk-line.sum-type   = x-sum-type
     2836             and buff-stk-line.cat-id     = '##,##':U
     2837             and buff-stk-line.fact-order <= x-fact-order
     2838             and buff-stk-line.shift-num  > 0
     2839           use-index category
     2840           no-error .
     2841         if available buff-stk-line then do:
     2842           assign
     2843             Quantity = Quantity +  buff-stk-line.fact-qnty
     2844             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2845             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2846             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2847             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2848             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2849             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2850             other_R = other_R   +  buff-stk-line.other-rubl
     2851             other_V = other_V   +  buff-stk-line.other-base
     2852           .
     2853         end.
     2854       end.
     2855     end.
     2856   end procedure.
     2857   procedure ost-line-kg :
     2858     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2859     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2860     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2861     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2862     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2863     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2864     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2865     define buffer buff-obj-list  for obj-list .
     2866     define buffer buf_doc-line for ub.doc-line .
     2867     define buffer buf_inv-line for ub.inv-line .
     2868     do
     2869     on error undo, return error
     2870     :
     2871       for each buf_doc-line no-lock where
     2872                buf_doc-line.obj-type    = p-obj-type   and
     2873                buf_doc-line.obj-code    = p-obj-code   and
     2874                buf_doc-line.prod-type   = p-prod-type  and
     2875                buf_doc-line.prod-code   = p-prod-code  and
     2876                buf_doc-line.artic       = p-artic      and
     2877                buf_doc-line.status_     = 'факт':U      and
     2878                buf_doc-line.fact-order <= p-fact-order
     2879             by buf_doc-line.fact-order    descending
     2880       :
     2881         find first buf_inv-line no-lock where
     2882                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2883                    buf_inv-line.artic     = buf_doc-line.artic     and
     2884                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2885                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2886         if available buf_inv-line
     2887         then do:
     2888           if buf_inv-line.after-cli-qnty <> ?
     2889           then do:
     2890             assign
     2891               p-quantity-kg = buf_inv-line.after-cli-qnty
     2892             .
     2893             leave .
     2894           end.
     2895         end.
     2896       end.
     2897       if p-quantity-kg = ?
     2898       then do:
     2899         assign
     2900           p-quantity-kg = 0
     2901         .
     2902       end.
     2903     end.
     2904   end procedure.
     2905   PROCEDURE ostatok :
     2906   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2907   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2908   def input parameter x-tog-shift   as   logical             no-undo.
     2909   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2910   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2911   def input parameter x-shift-start as integer               no-undo.
     2912   def input parameter x-shift-end   as integer               no-undo.
     2913   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2914   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2915   def input parameter xTog-obj   as log no-undo.
     2916   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2917   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2918   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2919   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2920   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2921   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2922   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2923   def var              Fact-orderS   as char  no-undo.
     2924   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2925      Assign
     2926         Fact-order   = 0
     2927         Quantity     = 0
     2928         Coast_R      = 0
     2929         Coast_V      = 0
     2930         VAT_R        = 0
     2931         VAT_V        = 0 .
     2932    x-date-start-t  = x-date-start + 1 .
     2933   IF x-date-end = date('') then DO:
     2934      Fact-order = 0 .
     2935      for each obj-list
     2936          where  ( not xtog-obj or
     2937                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2938                 no-lock :
     2939         if  x-tog-shift = false then do:
     2940                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2941                               ub.stk-tot.Fact-date <=  x-date-start
     2942                               and ub.stk-tot.shift-num = 0
     2943                               USE-INDEX fact-date no-lock no-error .
     2944              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2945         End.
     2946         Else  DO :
     2947             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2948              (ub.stk-tot.shift-date  = x-date-start-t and
     2949               ub.stk-tot.shift-num  < x-shift-start or
     2950               ub.stk-tot.shift-date  < x-date-start-t  )
     2951               and ub.stk-tot.shift-num  > 0
     2952               USE-INDEX Shift-num no-lock no-error .
     2953            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2954           END.
     2955       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2956     End.
     2957   End.
     2958   Else DO:
     2959     For each obj-list  WHERE
     2960        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2961         no-lock :
     2962      IF  x-TOG-Shift = False Then DO:
     2963          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2964               ub.stk-tot.Fact-date <= x-date-end
     2965               and ub.stk-tot.shift-num = 0
     2966               USE-INDEX fact-date no-lock no-error.
     2967          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2968      END.
     2969      Else DO:
     2970           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2971               (ub.stk-tot.shift-date  = x-date-end and
     2972               ub.stk-tot.shift-num  <= x-shift-end or
     2973               ub.stk-tot.shift-date  < x-date-end       ) and
     2974               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2975               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2976       End.
     2977       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2978     End.
     2979   End.
     2980   END PROCEDURE.
     2981   PROCEDURE report-exec1  :
     2982      FIND FIRST clients where x-store-type = clients.obj-type AND
     2983                               x-store-code = clients.obj-code no-lock no-error.
     2984     run waitfram-show(clients.obj-name) .
     2985     run calcitog.
     2986     run print-header.
     2987      case retclassify :
     2988        when "prod":u           then run run3.
     2989        otherwise do:
     2990          message "Ошибка вызова!"  view-as alert-box error .
     2991        end.
     2992      end case.
     2993     run print-footer.
     2994     END PROCEDURE.
     2995   PROCEDURE Calc-Sub-itog :
     2996   define input parameter tt as int no-undo.
     2997   define variable b as int no-undo.
     2998   if tt = 6  then Assign
     2999     B1-gds-zap-other = B1-gds-zap-other +  gds-zap-other
     3000     B2-gds-zap-other = B2-gds-zap-other +  gds-zap-other
     3001     Bi-gds-zap-other = Bi-gds-zap-other +  gds-zap-other
     3002     Bo-gds-zap-other = Bo-gds-zap-other +  gds-zap-other
     3003     .
     3004   repeat b = 1 to 3:
     3005     Assign
     3006     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     3007     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     3008     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     3009     Bo-Prih[b + TT]    = Bo-Prih[b + TT]    +  Prih[b + TT]
     3010     Bo-ostatok-start[b + TT]    = Bo-ostatok-start[b + TT]    +  ostatok-start[b + TT]
     3011     Bo-ostatok-end[b + TT]      = Bo-ostatok-end[b + TT]      +  ostatok-end[b + TT]
     3012     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     3013     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     3014     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     3015     Bo-RAsh[b + TT]    = Bo-RAsh[b + TT]    +  RAsh[b + TT]
     3016     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     3017     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     3018     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     3019     Bo-Kassa[b + TT]    = Bo-Kassa[b + TT]    +  Kassa[b + TT]
     3020     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     3021     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     3022     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     3023     Bo-Inv[b + TT]    = Bo-Inv[b + TT]    +  Inv[b + TT]
     3024     B1-Overturn[b + TT]    = B1-Overturn[b + TT]    +  Overturn[b + TT]
     3025     B2-Overturn[b + TT]    = B2-Overturn[b + TT]    +  Overturn[b + TT]
     3026     Bi-Overturn[b + TT]    = Bi-Overturn[b + TT]    +  Overturn[b + TT]
     3027     Bo-Overturn[b + TT]    = Bo-Overturn[b + TT]    +  Overturn[b + TT] .
     3028   End.
     3029   END PROCEDURE.
     3030   PROCEDURE Clear-item :
     3031   define variable kk as int no-undo.
     3032    gds-zap-other = 0 .
     3033    REPEAT kk = 1 to 9 :
     3034    Assign
     3035       prih            [kk]    = 0
     3036       rash            [kk]    = 0
     3037       kassa           [kk]    = 0
     3038       Inv             [kk]    = 0
     3039       Overturn        [kk]    = 0
     3040       ostatok-end     [kk]    = 0
     3041       ostatok-start   [kk]    = 0 .
     3042          End.
     3043    END PROCEDURE.
     3044   PROCEDURE Item-Goods :
     3045      define input parameter  par-3 as char no-undo.
     3046      define input parameter  par-4 as char no-undo.
     3047        if par-4 = "goods":U  Then DO:
     3048           assign
     3049               gds-zap-unit-base  = Goods.unit-base
     3050               gds-zap-prt-root   = Goods.prt-root
     3051               gds-zap-prod-type  = Goods.prod-type
     3052               gds-zap-prod-code  = Goods.prod-code
     3053               gds-zap-artic      = Goods.artic
     3054               gds-zap-grp-name   = Goods.grp-name
     3055               gds-zap-b-code     = Goods.gds-code
     3056               gds-zap-type       = Goods.gds-type.
     3057           if g#gds-engl then
     3058               assign gds-zap-gds-name = Goods.engl-name.
     3059           else
     3060               assign gds-zap-gds-name = Goods.gds-name.
     3061        End.
     3062        if par-4 = "gds-list":U  Then DO:
     3063           assign
     3064               gds-zap-unit-base  = gds-list.unit-base
     3065               gds-zap-prt-root   = gds-list.prt-root
     3066               gds-zap-prod-type  = gds-list.prod-type
     3067               gds-zap-prod-code  = gds-list.prod-code
     3068               gds-zap-artic      = gds-list.artic
     3069               gds-zap-grp-name   = gds-list.grp-name
     3070               gds-zap-b-code     = gds-list.gds-code
     3071               gds-zap-type       = gds-list.gds-type.
     3072           if g#gds-engl then
     3073               assign gds-zap-gds-name = gds-list.engl-name.
     3074           else
     3075               assign gds-zap-gds-name = gds-list.gds-name.
     3076        End.
     3077       run foreach.
     3078   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3079     (input  gds-zap-b-code
     3080     ,input  ?
     3081     ,output v-bar-code
     3082     )  .
     3083   s-bar-code = string (v-bar-code,"999999999").
     3084       If  break_group = true  and par-3 <> "1"  then DO :
     3085            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3086            gds-zap-prod-name  = clients.obj-name.
     3087             If break_group1 = true  THEN  DO :
     3088               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3089                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3090                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3091               if par-3 = "6"  then  dO:
     3092                  if xTog-obj = true then do:
     3093                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3094                     .
     3095                   end.
     3096                  else do:
     3097                   var-vat-pc = temp-gds-list.vat-pc .
     3098                   end.
     3099                   assign
     3100                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3101                       b1-name = temp-str.
     3102                   end.
     3103               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3104                   fr0 = true .
     3105                   tmp#stroka0 = temp-str.
     3106               End.
     3107             End.
     3108               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3109                 if par-3 = "4"
     3110                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3111                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3112                 if NOT xSumsOnly THEN DO:
     3113                     fr = true .
     3114                 End.
     3115                 break_group1 = false.
     3116               END.
     3117          break_group = false.
     3118       End.
     3119       run display-line.
     3120    END PROCEDURE.
     3121   PROCEDURE Di :
