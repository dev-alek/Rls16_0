      182   procedure create_obj-list :
      183      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      184      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      185      do
      186      on error undo, return error return-value
      187      :
      188         define buffer cli-obj for ub.clients .
      189         define variable p-var as integer no-undo .
      190         define buffer buf_obj-list for obj-list .
      191         find last buf_obj-list  use-index pi no-error .
      192         if available buf_obj-list
      193         then
      194            p-var = buf_obj-list.obj-id + 1.
      195         else
      196            p-var = 1.
      197         find first cli-obj where
      198                   cli-obj.obj-type = p-obj-type
      199               and cli-obj.obj-code = p-obj-code
      200         no-lock no-error.
      201         if available cli-obj
      202         then do:
      203            create buf_obj-list.
      204            assign
      205               buf_obj-list.obj-id   = p-var
      206               buf_obj-list.obj-code = cli-obj.obj-code
      207               buf_obj-list.obj-type = cli-obj.obj-type
      208               buf_obj-list.obj-name = cli-obj.obj-name
      209               buf_obj-list.db-num   = cli-obj.db-num
      210            .
      211         end.
      212      end.
      213   end.
