      885   PROCEDURE adm-disable-fields :
      886         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      887       RETURN.
      888   END PROCEDURE.
      889   PROCEDURE adm-enable-fields :
      890       RETURN.
      891   END PROCEDURE.
      892   PROCEDURE adm-end-update :
      893     RETURN.
      894   END PROCEDURE.
      895   PROCEDURE adm-reset-record :
      896       RETURN.
