      606   define new global shared variable g#library  as handle no-undo .
      607   define new global shared variable g#library2 as handle no-undo .
      608   define variable var-report-r-b as character no-undo .
      609   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      610   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      611     (output var-report-r-b
      612     )  .
      613   define new global shared variable g#language as character no-undo .
      614   if g#language <> '' and g#language <> 'rus':U then do:
      615     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      616   end.
      617   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      618   ASSIGN parParentProc =  my-handle .
      619   DEFINE VARIABLE Ed-otkl-prc AS INTEGER FORMAT ">>>9":U INITIAL 0
      620        VIEW-AS FILL-IN
      621        SIZE 8.63 BY .96 NO-UNDO.
      622   DEFINE VARIABLE Ed-otkl-tmh AS INTEGER FORMAT "9999":U INITIAL 0
      623        VIEW-AS FILL-IN
      624        SIZE 5 BY 1 NO-UNDO.
      625   DEFINE VARIABLE Ed-otkl-tmm AS INTEGER FORMAT "99":U INITIAL 0
      626        VIEW-AS FILL-IN
      627        SIZE 3.63 BY 1 NO-UNDO.
      628   DEFINE VARIABLE RAD-otkl AS INTEGER
      629        VIEW-AS RADIO-SET VERTICAL
      630        RADIO-BUTTONS
      631             "Все товары", 1,
      632   "Отклонения по кол-ву (%)", 2,
      633   "Отклонения по времени ", 3,
      634   "Все отклонения", 4
      635        SIZE 31.63 BY 6.21
      636        FGCOLOR 0  NO-UNDO.
      637   DEFINE VARIABLE RAD-Post-2 AS INTEGER
      638        VIEW-AS RADIO-SET VERTICAL
      639        RADIO-BUTTONS
      640             "По поставкам", 1,
      641   "По накладным", 2
      642        SIZE 27.63 BY 2.75 NO-UNDO.
      643   DEFINE RECTANGLE RECT-5
      644        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      645        SIZE 43.5 BY 7.67.
      646   DEFINE RECTANGLE RECT-8
      647        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      648        SIZE 28.63 BY 2.08.
      649   DEFINE RECTANGLE RECT-9
      650        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      651        SIZE 43.5 BY 4.38.
      652   DEFINE VARIABLE tg-zay AS LOGICAL INITIAL no
      653        LABEL "Итоги по заявкам"
      654        VIEW-AS TOGGLE-BOX
      655        SIZE 25.25 BY .83 TOOLTIP "Раздельно по заявкам" NO-UNDO.
      656   DEFINE FRAME F-Main
      657        RAD-otkl AT ROW 2.13 COL 2.38 NO-LABEL
      658        Ed-otkl-prc AT ROW 3.83 COL 32.38 COLON-ALIGNED NO-LABEL
      659        Ed-otkl-tmh AT ROW 5.46 COL 31.5 COLON-ALIGNED NO-LABEL
      660        Ed-otkl-tmm AT ROW 5.46 COL 37.38 COLON-ALIGNED NO-LABEL
      661        RAD-Post-2 AT ROW 10.04 COL 2.25 NO-LABEL
      662        tg-zay AT ROW 14.21 COL 2.88
      663        "Сравнение:" VIEW-AS TEXT
      664             SIZE 19.38 BY .67 AT ROW 9.13 COL 7.38
      665             FGCOLOR 4
      666        "Выбор товаров:" VIEW-AS TEXT
      667             SIZE 19.38 BY .67 AT ROW 1.29 COL 11.63
      668             FGCOLOR 4
      669        ":" VIEW-AS TEXT
      670             SIZE .75 BY .96 TOOLTIP ":" AT ROW 5.54 COL 38.63
      671        RECT-5 AT ROW 1 COL 1.63
      672        RECT-8 AT ROW 13.58 COL 1.88
      673        RECT-9 AT ROW 8.83 COL 1.75
      674       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      675            SIDE-LABELS NO-UNDERLINE THREE-D
      676            AT COL 1 ROW 1 SCROLLABLE .
      677   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      678   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      679   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      680   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      681   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      682   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      683   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      684   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      685         adm-object-hdl = FRAME F-Main:HANDLE.
      686   RUN ensure-broker.
      687   THIS-PROCEDURE:ADM-DATA =
      688        'ADM1.1~`':U +
      689        'SmartObject~`':U +
      690        '~`':U +
      691        'NO ~`':U +
      692        '~`':U +
      693        '~`':U +
      694        '~`':U +
      695        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      696           + "~`":U +
      697        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      698        'Record-Source,Record-Target,TableIO-Target~`':U +
      699        '~`':U +
      700        '~`~`~`~`~`~`~`~`~`~`~`':U +
      701        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      702            THEN "^^":U
      703        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      704             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      705   PROCEDURE adm-apply-entry :
      706     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      707   END PROCEDURE.
      708   PROCEDURE adm-destroy :
      709    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      710   END PROCEDURE.
      711   PROCEDURE adm-disable :
      712       DISABLE RECT-5 RECT-8 RECT-9 RAD-otkl Ed-otkl-prc Ed-otkl-tmh Ed-otkl-tmm RAD-Post-2 tg-zay WITH FRAME F-Main.
      713       RUN dispatch ('disable-fields':U).
      714       RUN set-attribute-list ('ENABLED=no':U).
      715       RETURN.
      716   END PROCEDURE.
      717   PROCEDURE adm-edit-attribute-list :
      718         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      719         RETURN.
      720   END PROCEDURE.
      721   PROCEDURE adm-enable :
      722       ENABLE UNLESS-HIDDEN RECT-5 RECT-8 RECT-9 RAD-otkl Ed-otkl-prc Ed-otkl-tmh Ed-otkl-tmm RAD-Post-2 tg-zay WITH FRAME F-Main.
      723       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      724       RUN set-attribute-list ('ENABLED=yes':U).
      725       RETURN.
      726   END PROCEDURE.
      727   PROCEDURE adm-exit :
      728        RUN notify ('exit':U).
      729     RETURN.
      730   END PROCEDURE.
      731   PROCEDURE adm-hide :
      732     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      733   END PROCEDURE.
      734   PROCEDURE adm-initialize :
      735     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      736   END PROCEDURE.
      737   PROCEDURE adm-show-errors :
      738       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      739       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      740           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      741       END.
      742       RETURN.
      743   END PROCEDURE.
      744   PROCEDURE adm-UIB-mode :
      745     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      746   END PROCEDURE.
      747   PROCEDURE adm-view :
      748     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      749   END PROCEDURE.
      750   PROCEDURE dispatch :
      751       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      752       RUN broker-dispatch IN adm-broker-hdl
      753           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      754       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      755   END PROCEDURE.
      756   PROCEDURE ensure-broker :
      757   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      758   IF RETURN-VALUE NE "ADM-Broker":U THEN
      759   DO:
      760       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      761       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      762   END.
      763   END PROCEDURE.
      764   PROCEDURE get-attribute :
      765     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      766     RUN broker-get-attribute IN adm-broker-hdl
      767         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      768     RETURN RETURN-VALUE.
      769   END PROCEDURE.
      770   PROCEDURE get-attribute-list :
      771     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      772     RUN broker-get-attribute-list IN adm-broker-hdl
      773         (INPUT THIS-PROCEDURE,
      774          INPUT ?,
      775          OUTPUT p-attr-list) NO-ERROR.
      776     RETURN.
      777   END PROCEDURE.
      778   PROCEDURE new-state :
      779     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      780     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      781     RETURN.
      782   END PROCEDURE.
      783   PROCEDURE notify :
      784     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      785     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      786     IF RETURN-VALUE = "ADM-ERROR":U THEN
      787         RETURN "ADM-ERROR":U.
      788     RETURN.
      789   END PROCEDURE.
      790   PROCEDURE set-attribute-list :
      791     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      792     RUN ensure-broker.
      793     RUN broker-set-attribute-list IN adm-broker-hdl
      794         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      795     RETURN.
      796   END PROCEDURE.
      797   PROCEDURE set-position :
      798       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      799       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      800       IF VALID-HANDLE(adm-object-hdl) THEN
      801       DO:
      802         ASSIGN adm-object-hdl:ROW    =   p-row
      803                adm-object-hdl:COLUMN =   p-col.
      804       END.
      805       RETURN.
      806   END PROCEDURE.
      807   PROCEDURE adm-display-fields :
      808       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      809       RETURN.
      810   END PROCEDURE.
      811   PROCEDURE adm-open-query :
      812     RETURN.
      813   END PROCEDURE.
      814   PROCEDURE adm-row-changed :
      815         IF VALID-HANDLE(adm-object-hdl) THEN
      816           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      817         RUN notify ('row-available':U).
      818         RETURN.
      819   END PROCEDURE.
      820   PROCEDURE reposition-query :
      821       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      822       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      823       RETURN.
      824   END PROCEDURE.
      825     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      826     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      827     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      828     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      829     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      830     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      831     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      832     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      833     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      834     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      835     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      836     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      837     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      838     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      839     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      840     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      841     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      842     IF "":U = "":U THEN
      843       RUN modify-list-attribute IN adm-broker-hdl
      844         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      845     RUN use-create-on-add(?).
      846   PROCEDURE adm-add-record :
      847       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      848          "must have at least one Enabled Table to perform Add.":U
      849          VIEW-AS ALERT-BOX ERROR.
