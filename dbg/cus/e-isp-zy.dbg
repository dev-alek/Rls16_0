      857      RETURN.
      858     END PROCEDURE.
      859   PROCEDURE adm-assign-statement :
      860     RETURN.
      861   END PROCEDURE.
      862   PROCEDURE adm-cancel-record :
      863      RETURN.
      864     END PROCEDURE.
      865   PROCEDURE adm-copy-record :
      866       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      867        "must have at least one Enabled Table to perform Copy.":U
      868          VIEW-AS ALERT-BOX ERROR.
      869       RETURN.
      870   END PROCEDURE.
      871   PROCEDURE adm-create-record :
      872      RETURN.
      873   END PROCEDURE.
      874   PROCEDURE adm-current-changed :
      875     RETURN.
      876   END PROCEDURE.
      877   PROCEDURE adm-delete-record :
      878    MESSAGE
      879          "Object ":U THIS-PROCEDURE:FILE-NAME
      880            "must have at least one Enabled Table to perform Delete.":U
      881              VIEW-AS ALERT-BOX ERROR.
      882       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      883       RETURN.
