     1076   DEFINE TEMP-TABLE tt-dis-some-rule LIKE ub.dis-some-rule .
     1077   DEFINE BUFFER buf_dis-some-rule FOR ub.dis-some-rule .
     1078   define buffer buf_clients       for ub.clients .
     1079   function get-wdays returns character (input p-wdays as character) :
     1080       define variable v-i     as integer   no-undo .
     1081       define variable v-rez   as character no-undo init "".
     1082       define variable v-wdays as character no-undo extent 7 init ["Пн","Вт","Ср","Чт","Пт","Сб","Вс"].
     1083       do v-i = 1 to num-entries(p-wdays):
     1084           if entry(v-i, p-wdays) = "no" then next .
     1085           if v-rez = "" then v-rez = v-wdays [v-i] .
     1086           else v-rez = v-rez + "," + v-wdays [v-i] .
     1087       end.
     1088       return v-rez .
     1089   end function.
     1090   function get-node returns character (input p-node as integer) :
     1091       define buffer buf_gds-grp for ub.gds-grp .
     1092       find first buf_gds-grp no-lock
     1093       where buf_gds-grp.node-code = p-node no-error .
     1094       if avail buf_gds-grp then return buf_gds-grp.node-name .
     1095       else return "Группа не найдена" .
     1096   end function.
     1097   function get-gds-grp-lst returns character (input p-recid as character) :
     1098       define buffer buf_gds-grp for ub.gds-grp .
     1099       define buffer src_gds-grp for ub.gds-grp .
     1100       define variable v-rez as character no-undo init "" .
     1101       find first buf_gds-grp where string(recid(buf_gds-grp)) = p-recid no-lock no-error.
     1102       if avail buf_gds-grp then do:
     1103           if buf_gds-grp.is-term = yes then do:
     1104               v-rez = string(buf_gds-grp.node-code) .
     1105           end.
     1106           else do:
     1107               for each src_gds-grp no-lock
     1108               where src_gds-grp.upper-code = buf_gds-grp.node-code
     1109               :
     1110                   v-rez = ( if v-rez = "" then get-gds-grp-lst( string(recid(src_gds-grp)) ) else v-rez + "," + get-gds-grp-lst( string(recid(src_gds-grp)) ) ).
     1111               end.
     1112           end.
     1113       end.
     1114       return v-rez .
     1115   end function.
