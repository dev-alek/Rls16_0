        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Список автозаказов ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     define variable v-cntxt-db-num        as integer   no-undo .
      115     define variable v-cntxt-userid        as character no-undo .
      116     define variable v-cntxt-level         as character no-undo .
      117     define variable v-cntxt-host-code-obj as integer   no-undo .
      118     define variable v-cntxt-obj-type      as character no-undo .
      119     define variable v-cntxt-obj-code      as integer   no-undo .
      120     define variable v-cntxt-db-num-obj    as integer   no-undo .
      121     define variable v-cntxt-is-admin      as logical   no-undo .
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define temp-table userobjs_temp-user-obj no-undo
      124     field obj-type as character
      125     field obj-code as integer
      126     index xpk is primary unique obj-type obj-code
      127     .
      128   procedure userobjs_clear :
      129     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      130     do
      131     on error undo, return error return-value
      132     :
      133       for each buf_userobjs_temp-user-obj
      134       on error undo, return error return-value
      135       :
      136         delete buf_userobjs_temp-user-obj .
      137       end.
      138     end.
      139   end .
      140   procedure userobjs_object-count :
      141     define output parameter p-total-count as integer   no-undo .
      142     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      143     do
      144     on error undo, return error return-value
      145     :
      146       assign
      147         p-total-count = 0
      148       .
      149       for each buf_userobjs_temp-user-obj
      150       on error undo, return error return-value
      151       :
      152         assign
      153           p-total-count = p-total-count + 1
      154         .
      155       end.
      156     end.
      157   end.
      158   procedure userobjs_append :
      159      define input  parameter p-obj-type as character no-undo .
      160      define input  parameter p-obj-code as integer   no-undo .
      161     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      162     do
      163     on error undo, return error return-value
      164     :
      165       find first buf_userobjs_temp-user-obj
      166         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      167           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      168         no-error .
      169       if not available buf_userobjs_temp-user-obj
      170       then do:
      171         create buf_userobjs_temp-user-obj .
      172         assign
      173           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      174           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      175         .
      176       end.
      177     end.
      178   end.
      179   procedure userobjs_object-exist :
      180     define output parameter p-object-exist as logical   no-undo .
      181     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      182     do
      183     on error undo, return error return-value
      184     :
      185       find first buf_userobjs_temp-user-obj
      186         no-error .
      187       if not available buf_userobjs_temp-user-obj
      188       then do:
      189         assign
      190           p-object-exist = false
      191         .
      192       end.
      193       else do:
      194         assign
      195           p-object-exist = true
      196         .
      197       end.
      198     end.
      199   end.
      200   procedure userobjs_transfer :
      201     define input  parameter p-callback-handle as handle no-undo .
      202     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      203     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      204     do
      205     on error undo, return error return-value
      206     :
      207       if valid-handle(p-callback-handle) <> true
      208       then do:
      209         message
      210           vss-workfile vss-revision vss-description skip
      211           "Ошибка задания входных параметров" skip
      212           "Неизвестный указатель на процедуру" skip
      213           view-as alert-box error .
      214         undo, return error return-value .
      215       end.
      216       if p-callback-handle :get-signature("userobjs_append") = ""
      217       then do:
      218         message
      219           vss-workfile vss-revision vss-description skip
      220           "Ошибка задания входных параметров" skip
      221           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      222                     ,p-callback-handle :file-name
      223                     ) skip
      224           view-as alert-box error .
      225         undo, return error return-value .
      226       end.
      227       for each buf_userobjs_temp-user-obj
      228       on error undo, return error return-value
      229       :
      230         run userobjs_append in p-callback-handle
      231           (input  buf_userobjs_temp-user-obj.obj-type
      232           ,input  buf_userobjs_temp-user-obj.obj-code
      233           ) .
      234       end.
      235     end.
      236   end procedure.
      237   procedure userobjs_select-one :
      238      define input  parameter parparentproc     as widget-handle no-undo .
      239      define input  parameter p-db-num          as integer   no-undo .
      240      define input  parameter p-user-id         as character no-undo .
      241      define input  parameter p-host-code-obj   as integer   no-undo .
      242      define input  parameter p-obj-type        as character no-undo .
      243      define input  parameter p-obj-code        as integer   no-undo .
      244      define output parameter p-user-select     as logical   no-undo .
      245      define output parameter p-select-obj-type as character no-undo .
      246      define output parameter p-select-obj-code as character no-undo .
      247     do
      248     on error undo, return error return-value
      249     :
      250       run gbl/userobjs.w
      251         (input  parparentproc
      252         ,input  this-procedure :handle
      253         ,input  p-db-num
      254         ,input  p-user-id
      255         ,input  p-host-code-obj
      256         ,input  p-obj-type
      257         ,input  p-obj-code
      258         ,INPUT  "b-sel"
      259         ,output p-user-select
      260         ,output p-select-obj-type
      261         ,output p-select-obj-code
      262         ) .
      263     end.
      264   end.
      265   procedure userobjs_select-many :
      266     define input  parameter parparentproc   as widget-handle no-undo .
      267     define input  parameter p-db-num        as integer   no-undo .
      268     define input  parameter p-user-id       as character no-undo .
      269     define input  parameter p-host-code-obj as integer   no-undo .
      270     define input  parameter p-obj-type      as character no-undo .
      271     define input  parameter p-obj-code      as integer   no-undo .
      272     define output parameter p-user-select   as logical   no-undo .
      273     define variable v-select-obj-type as character no-undo .
      274     define variable v-select-obj-code as integer   no-undo .
      275     do
      276     on error undo, return error return-value
      277     :
      278       run gbl/userobjs.w
      279         (input  parparentproc
      280         ,input  this-procedure :handle
      281         ,input  p-db-num
      282         ,input  p-user-id
      283         ,input  p-host-code-obj
      284         ,input  p-obj-type
      285         ,input  p-obj-code
      286         ,INPUT  "b-sel,b-mark"
      287         ,output p-user-select
      288         ,output v-select-obj-type
      289         ,output v-select-obj-code
      290         ) .
      291     end.
      292   end.
