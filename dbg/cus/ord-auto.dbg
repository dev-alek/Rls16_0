      607   def
      608   new shared
      609   temp-table  obj-list no-undo
      610     field obj-type like ub.clients.obj-type
      611     field obj-code like ub.clients.obj-code
      612     field obj-name like ub.clients.obj-name
      613     field obj-id   as integer
      614     field db-num   as integer
      615     index pi is primary unique obj-id
      616     index ie1 obj-type obj-code
      617     index ie2 obj-name
      618   .
      619   procedure create_obj-list :
      620      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      621      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      622      do
      623      on error undo, return error return-value
      624      :
      625         define buffer cli-obj for ub.clients .
      626         define variable p-var as integer no-undo .
      627         define buffer buf_obj-list for obj-list .
      628         find last buf_obj-list  use-index pi no-error .
      629         if available buf_obj-list
      630         then
      631            p-var = buf_obj-list.obj-id + 1.
      632         else
      633            p-var = 1.
      634         find first cli-obj where
      635                   cli-obj.obj-type = p-obj-type
      636               and cli-obj.obj-code = p-obj-code
      637         no-lock no-error.
      638         if available cli-obj
      639         then do:
      640            create buf_obj-list.
      641            assign
      642               buf_obj-list.obj-id   = p-var
      643               buf_obj-list.obj-code = cli-obj.obj-code
      644               buf_obj-list.obj-type = cli-obj.obj-type
      645               buf_obj-list.obj-name = cli-obj.obj-name
      646               buf_obj-list.db-num   = cli-obj.db-num
      647            .
      648         end.
      649      end.
      650   end.
