     1377     if error-status:error then return no-apply.
     1378   END.
     1379   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1380   DO:
     1381     if not avail tt-dis-some-rule then return no-apply.
     1382     run proc-add-chg in this-procedure ( input "chg" ) no-error .
     1383     if error-status:error then return no-apply.
     1384   END.
     1385   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1386   DO:
     1387     define variable loc#log as logical no-undo.
     1388     if not avail tt-dis-some-rule then return no-apply.
     1389     message
     1390     "Вы уверены, что хотите удалить?"
     1391             view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     1392     if NOT loc#log then return no-apply.
     1393     find current tt-dis-some-rule exclusive-lock no-error.
     1394     if avail tt-dis-some-rule then do:
     1395         DO TRANSACTION
     1396         on error undo, return no-apply
     1397         :
     1398             find first buf_dis-some-rule exclusive-lock
     1399             where buf_dis-some-rule.templ-rl-root = tt-dis-some-rule.templ-rl-root no-error .
     1400             if avail buf_dis-some-rule then delete buf_dis-some-rule .
     1401         END.
     1402         delete tt-dis-some-rule .
     1403         br-dis-some:refresh() in frame Dialog-Frame no-error .
     1404     end.
     1405     OPEN QUERY br-dis-some FOR EACH tt-dis-some-rule NO-LOCK.
     1406   END.
     1407   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1408   DO:
     1409     if not avail tt-dis-some-rule then return no-apply.
     1410     run proc-add-chg in this-procedure ( input "view" ) no-error .
     1411     if error-status:error then return no-apply.
     1412   END.
     1413   ON VALUE-CHANGED OF c-flt-reg IN FRAME Dialog-Frame
     1414   DO:
     1415     assign
     1416       c-flt-reg
     1417     .
     1418     run open-br in this-procedure ( c-flt-reg ) .
     1419     br-dis-some:refresh() in frame Dialog-Frame no-error .
     1420     OPEN QUERY br-dis-some FOR EACH tt-dis-some-rule NO-LOCK.
     1421   END.
     1422   ON VALUE-CHANGED OF v-contract IN FRAME Dialog-Frame
     1423   DO:
     1424     enable b-contract.
     1425   END.
     1426   ON VALUE-CHANGED OF cb-zakaz IN FRAME Dialog-Frame
     1427   DO:
     1428       if cb-zakaz:screen-value = "2" then do:
     1429           find first buf_clients no-lock
     1430           where buf_clients.obj-type = 'орг':U and
     1431                 buf_clients.obj-code = v-cntxt-host-code-obj
     1432           no-error.
     1433           if avail buf_clients then do:
     1434               assign
     1435                 v-select-host-code = buf_clients.host-code
     1436                 v-select-obj-type  = buf_clients.obj-type
     1437                 v-select-obj-code  = buf_clients.obj-code
     1438                 v-select-obj-name  = buf_clients.obj-name
     1439                 v-contr :SCREEN-VALUE IN FRAME Dialog-Frame = v-select-obj-name
     1440               .
     1441               disable b-contr with frame Dialog-Frame .
     1442           end.
     1443       end.
     1444       else do:
     1445         enable b-contr with frame Dialog-Frame .
     1446       end.
     1447       if cb-zakaz:screen-value <> "1" or v-select-obj-code = 0  then do:
     1448         assign
     1449           v-contract :SCREEN-VALUE IN FRAME Dialog-Frame = ""
     1450           v-select-contract = 0
     1451         .
     1452         disable b-contract with frame Dialog-Frame .
     1453       end.
     1454       else do:
     1455         enable b-contract with frame Dialog-Frame .
     1456       end.
     1457   END.
     1458   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1459   DO:
     1460     define variable loc#log as logical no-undo.
     1461     define variable v-recid as recid   no-undo.
     1462     message "Сохранить изменения?" view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     1463     if not loc#log then return no-apply.
     1464     assign
     1465       r-region cb-zakaz v-from v-to v-repeat v-flag v-l-addextart v-l-delnull
     1466       v-wday-1 v-wday-2 v-wday-3 v-wday-4 v-wday-5 v-wday-6 v-wday-7
     1467       v-days-do v-days-fale
     1468     .
     1469     assign
     1470       v-region = r-region
     1471     .
     1472     run proc-save in this-procedure no-error.
     1473     if not error-status:error then do:
     1474         v-recid = recid(tt-dis-some-rule) .
     1475         run show_main_page in this-procedure .
     1476         br-dis-some:refresh() in frame Dialog-Frame no-error .
     1477        OPEN QUERY br-dis-some FOR EACH tt-dis-some-rule NO-LOCK.
     1478        reposition br-dis-some to recid v-recid no-error.
     1479     end.
     1480   END.
     1481   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     1482   DO:
     1483       run show_main_page in this-procedure .
     1484   END.
     1485   ON CHOOSE OF b-method IN FRAME Dialog-Frame
     1486   DO:
     1487     case cb-zakaz:screen-value:
     1488       when "2" then v-ord-type = 'ОФ':U .
     1489       when "3" then v-ord-type = 'ОР':U .
     1490       when "4" then v-ord-type = 'ФП':U .
     1491       otherwise v-ord-type = 'ОП':U .
     1492     end.
     1493     run cus/ord-m-a.w ( input parparentproc , input "auto-ord":u , input v-ord-type, input-output p-method ) no-error.
     1494     if error-status:error then return no-apply.
     1495     if not p-method = '' then v-method:SCREEN-VALUE = "Установлен" .
     1496     else v-method:SCREEN-VALUE = "" .
     1497   END.
     1498   ON CHOOSE OF b-grp IN FRAME Dialog-Frame
     1499   DO:
     1500     run proc-sel-grp IN THIS-PROCEDURE NO-ERROR .
     1501     if error-status:error then return no-apply.
     1502     if not v-grp = '' then v-grp:SCREEN-VALUE = v-grp .
     1503     else v-grp:SCREEN-VALUE = '' .
     1504   END.
     1505   ON CHOOSE OF b-contr IN FRAME Dialog-Frame
     1506   DO:
     1507     run proc-sel-obj IN THIS-PROCEDURE ("contr") NO-ERROR .
     1508     if error-status:error then return no-apply.
     1509     v-contr:SCREEN-VALUE = v-select-obj-name .
     1510     if v-select-obj-name <> "" and cb-zakaz:screen-value = "1" then do:
     1511       enable b-contract with frame Dialog-Frame .
     1512     end.
     1513   END.
     1514   ON CHOOSE OF b-contract IN FRAME Dialog-Frame
     1515   DO:
     1516     define variable v-rid-list as character no-undo.
     1517     find first buf_contract where buf_contract.contract-code = v-select-contract and buf_contract.host-code = v-cntxt-host-code-obj no-error.
     1518     if available buf_contract
     1519       then assign v-rid-list = string (recid (buf_contract)).
     1520     run str/cont-all.w (
     1521       input   parparentproc  ,
     1522       input   v-cntxt-host-code-obj,
     1523       input   "b-sel"         ,
     1524       input   "firm-curr"     ,
     1525       input   v-select-obj-type,
     1526       input   v-select-obj-code,
     1527       input   ?               ,
     1528       input   ?               ,
     1529       input   "current"       ,
     1530       input   'при':U       ,
     1531       input-output v-rid-list )
     1532     .
     1533     find first buf_contract where recid(buf_contract) = integer(v-rid-list) no-error.
     1534     if not available buf_contract then do:
     1535       assign
     1536         v-select-contract = 0
     1537         v-contract:SCREEN-VALUE = ""
     1538       .
     1539     end.
     1540     else do:
     1541       assign
     1542         v-select-contract = buf_contract.contract-code
     1543         v-contract:SCREEN-VALUE =  buf_contract.contract-prn-code
     1544       .
     1545     end.
     1546   END.
     1547   ON CHOOSE OF b-flt-contr IN FRAME Dialog-Frame
     1548   DO:
     1549     run proc-sel-obj IN THIS-PROCEDURE ("flt") NO-ERROR .
     1550     if error-status:error then return no-apply.
     1551     v-flt-contr:SCREEN-VALUE = v-flt-obj-name .
     1552     run open-br in this-procedure ( c-flt-reg ) .
     1553     br-dis-some:refresh() in frame Dialog-Frame no-error .
     1554     OPEN QUERY br-dis-some FOR EACH tt-dis-some-rule NO-LOCK.
     1555   END.
     1556   ON CHOOSE OF b-flt-clear IN FRAME Dialog-Frame
     1557   DO:
     1558     assign
     1559       v-flt-contr:SCREEN-VALUE = ""
     1560       v-flt-obj-type           = ""
     1561       v-flt-obj-code           = 0
     1562       v-flt-obj-name           = ""
     1563     .
     1564     run open-br in this-procedure ( c-flt-reg ) .
     1565     br-dis-some:refresh() in frame Dialog-Frame no-error .
     1566     OPEN QUERY br-dis-some FOR EACH tt-dis-some-rule NO-LOCK.
     1567   END.
     1568   ON MOUSE-SELECT-DBLCLICK OF br-dis-some IN FRAME Dialog-Frame
     1569   DO:
     1570     if not avail tt-dis-some-rule then return no-apply.
     1571     run proc-add-chg in this-procedure ( input "view" ) no-error .
     1572     if error-status:error then return no-apply.
     1573   END.
     1574   ON RETURN OF br-dis-some IN FRAME Dialog-Frame
     1575   DO:
     1576     if not avail tt-dis-some-rule then return no-apply.
     1577     run proc-add-chg in this-procedure ( input "view" ) no-error .
     1578     if error-status:error then return no-apply.
     1579   END.
     1580   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1581   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1582   MAIN-BLOCK:
     1583   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1584      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1585   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1586     run mainmenu_getcntxt in parparentproc
     1587       (output v-cntxt-db-num
     1588       ,output v-cntxt-userid
     1589       ,output v-cntxt-level
     1590       ,output v-cntxt-host-code-obj
     1591       ,output v-cntxt-obj-type
     1592       ,output v-cntxt-obj-code
     1593       ,output v-cntxt-db-num-obj
     1594       ,output v-cntxt-is-admin
     1595       ) .
     1596     RUN enable_UI in this-procedure .
     1597     WAIT-FOR GO OF FRAME Dialog-Frame.
     1598   END.
     1599   RUN disable_UI in this-procedure .
     1600   PROCEDURE disable_UI :
     1601     HIDE FRAME Dialog-Frame.
     1602   END PROCEDURE.
     1603   PROCEDURE enable_UI :
     1604     assign
     1605       c-flt-reg:SCREEN-VALUE IN FRAME Dialog-Frame = "0"
     1606     .
     1607     assign
     1608       c-flt-reg
     1609     .
     1610     ENABLE b-quit b-add B-lookup b-chg b-del c-flt-reg
     1611         WITH FRAME Dialog-Frame.
     1612     VIEW FRAME Dialog-Frame.
     1613     run open-br in this-procedure ( c-flt-reg ) .
     1614     OPEN QUERY br-dis-some FOR EACH tt-dis-some-rule NO-LOCK.
     1615   END PROCEDURE.
     1616   PROCEDURE proc-add-chg :
     1617       define input parameter p-add as character no-undo.
     1618       if p-add = "add" then do:
     1619           assign v-save-mode = yes .
     1620           run show_add_page in this-procedure ( v-save-mode ) .
     1621       end.
     1622       else do:
     1623           assign v-save-mode = no .
     1624           run show_add_page in this-procedure ( v-save-mode ) .
     1625       end.
     1626       if p-add = "view" or
     1627          ( v-cntxt-db-num > 0 and r-region < 3 )
     1628       then do:
     1629           DISABLE b-save
     1630           WITH FRAME Dialog-Frame.
     1631       end.
     1632   END PROCEDURE.
     1633   PROCEDURE proc-save :
     1634     define variable v-i       as integer   no-undo .
     1635     define variable v-mth     as character no-undo init "".
     1636     define variable v-cmp     as logical   no-undo .
     1637     define variable v-lastrec as integer   no-undo .
     1638     if v-select-obj-type = '' and v-select-obj-code = 0 then do:
     1639          message color input "Не указан поставщик!" view-as alert-box error .
     1640          return error .
     1641     end.
     1642     if v-select-node-code = "" then do:
     1643          message color input "Не указана группа товара!" view-as alert-box error .
     1644          return error .
     1645     end.
     1646     if p-method = '' then do:
     1647          message color input "Не указан метод расчета!" view-as alert-box error .
     1648          return error .
     1649     end.
     1650     DO TRANSACTION
     1651     on error undo, return error
     1652     :
     1653         if v-save-mode then do:
     1654             find last buf_dis-some-rule use-index itempl no-lock no-error .
     1655             if avail buf_dis-some-rule then assign v-lastrec = buf_dis-some-rule.templ-rl-root .
     1656             else assign v-lastrec = 0 .
     1657             create tt-dis-some-rule .
     1658             assign
     1659               tt-dis-some-rule.templ-rl-root = v-lastrec + 1
     1660               tt-dis-some-rule.resource#_id = tt-dis-some-rule.templ-rl-root
     1661             .
     1662         end .
     1663         else do:
     1664             find current tt-dis-some-rule exclusive-lock .
     1665         end.
     1666         case v-region :
     1667           when 1 then do:
     1668              assign
     1669              tt-dis-some-rule.host-code = 0
     1670              tt-dis-some-rule.obj-code  = 0
     1671              tt-dis-some-rule.obj-type  = ""
     1672              .
     1673           end.
     1674           when 2 then do:
     1675              assign
     1676              tt-dis-some-rule.host-code = v-cntxt-host-code-obj
     1677              tt-dis-some-rule.obj-code  = 0
     1678              tt-dis-some-rule.obj-type  = ""
     1679              .
     1680           end.
     1681           when 3 then do:
     1682              assign
     1683              tt-dis-some-rule.host-code = v-cntxt-host-code-obj
     1684              tt-dis-some-rule.obj-code  = v-cntxt-obj-code
     1685              tt-dis-some-rule.obj-type  = v-cntxt-obj-type
     1686              .
     1687           end.
     1688         end.
     1689         assign
     1690           tt-dis-some-rule.charkey_one = p-method
     1691           tt-dis-some-rule.charkey_two = string(v-flag) + chr(3) +
     1692                                          v-select-node-code + chr(3) +
     1693                                          v-select-obj-type + string(v-select-obj-code) + chr(3) +
     1694                                          string(v-wday-1) + "," + string(v-wday-2) + "," + string(v-wday-3) + "," +
     1695                                          string(v-wday-4) + "," + string(v-wday-5) + "," + string(v-wday-6) + "," + string(v-wday-7) +
     1696                                          chr(3) + string(v-select-contract) + chr(3) + string (v-l-addextart) + chr(3) + string (v-l-delnull)
     1697           tt-dis-some-rule.charkey_three = v-from + "-" + v-to
     1698           tt-dis-some-rule.key#_one = v-days-do
     1699           tt-dis-some-rule.key#_two = v-days-fale
     1700           tt-dis-some-rule.classif-type = "auto-ord-" + string(cb-zakaz)
     1701           tt-dis-some-rule.rl-root = v-repeat
     1702           tt-dis-some-rule.resource_id = v-select-obj-name
     1703           tt-dis-some-rule.resource#_id = tt-dis-some-rule.templ-rl-root
     1704         .
     1705         find first buf_dis-some-rule exclusive-lock
     1706         where buf_dis-some-rule.templ-rl-root = tt-dis-some-rule.templ-rl-root no-error .
     1707         if not avail buf_dis-some-rule then create buf_dis-some-rule .
     1708         buffer-compare tt-dis-some-rule to buf_dis-some-rule save result in v-cmp .
     1709         if not v-cmp then buffer-copy tt-dis-some-rule to buf_dis-some-rule .
     1710     END.
     1711   END PROCEDURE.
     1712   PROCEDURE proc-sel-obj :
     1713     define input parameter p-sel as character no-undo.
     1714     define variable v-rid-list as character no-undo .
     1715     do
     1716     on error undo, return error return-value
     1717     :
     1718      run ref/cli-all.w ( parparentproc
     1719                         ,"b-sel"
     1720                         ,'все':U
     1721                         , ?
     1722                         , ?
     1723                         , ?
     1724                         , ?
     1725                         , ?
     1726                         ,output v-rid-list ) no-error .
     1727       if v-rid-list = "" then return error.
     1728       find first buf_clients where string(recid(buf_clients)) = v-rid-list no-lock no-error.
     1729       if avail buf_clients then do:
     1730           if p-sel = "contr" then do:
     1731             if cb-zakaz:screen-value in frame Dialog-frame = "3" and
     1732                not ( buf_clients.obj-type = 'маг':U or buf_clients.obj-type = 'скл':U )
     1733             then do:
     1734                message "Тип заказа не соответствует типу поставщика." view-as alert-box error .
     1735                return error .
     1736             end.
     1737             assign
     1738               v-select-host-code = buf_clients.host-code
     1739               v-select-obj-type  = buf_clients.obj-type
     1740               v-select-obj-code  = buf_clients.obj-code
     1741               v-select-obj-name  = buf_clients.obj-name
     1742             .
     1743           end.
     1744           else do:
     1745             assign
     1746               v-flt-obj-type  = buf_clients.obj-type
     1747               v-flt-obj-code  = buf_clients.obj-code
     1748               v-flt-obj-name  = buf_clients.obj-name
     1749             .
     1750           end.
     1751       end.
     1752       else return error.
     1753     end.
     1754   END PROCEDURE.
     1755   PROCEDURE proc-sel-grp :
     1756     define variable v-rid-list as character no-undo .
     1757     define variable v-i        as integer   no-undo .
     1758     define buffer buf_gds-grp for ub.gds-grp .
     1759     do
     1760     on error undo, return error return-value
     1761     :
     1762     if not v-select-node-code = "" then do:
     1763        do v-i = 1 to num-entries(v-select-node-code):
     1764           find first buf_gds-grp where buf_gds-grp.node-code = int(entry(v-i, v-select-node-code)) no-lock no-error.
     1765           if avail buf_gds-grp then do:
     1766               assign
     1767                 v-rid-list = ( if v-rid-list = "" then string(recid(buf_gds-grp)) else v-rid-list + "," + string(recid(buf_gds-grp)) )
     1768               .
     1769           end.
     1770       end.
     1771     end.
     1772     else assign v-rid-list = "" .
     1773     run ref/gds-grp.w (input parparentproc
     1774                       ,input "b-sel,b-mark"
     1775                       ,input v-cntxt-obj-type
     1776                       ,input v-cntxt-obj-code
     1777                       ,input-output v-rid-list) no-error .
     1778       if v-rid-list = "" then return error.
     1779       assign v-select-node-code = "" .
     1780       do v-i = 1 to num-entries(v-rid-list):
     1781           v-select-node-code = ( if v-select-node-code = "" then get-gds-grp-lst(entry(v-i, v-rid-list)) else v-select-node-code + "," + get-gds-grp-lst(entry(v-i, v-rid-list)) ) .
     1782       end.
     1783       if not v-select-node-code = "" then assign v-grp = "Установлена" .
     1784     end.
     1785   END PROCEDURE.
     1786   PROCEDURE show_main_page :
     1787       ASSIGN
     1788          b-save  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1789          b-cancel:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1790          r-region:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1791          RECT-1  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1792          RECT-3  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1793          RECT-4  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1794          RECT-5  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1795          RECT-6  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1796          v-from  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1797          v-to    :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1798          v-wday-1:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1799          v-repeat:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1800          v-wday-2:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1801          v-wday-3:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1802          v-wday-4:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1803          v-wday-5:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1804          v-wday-6:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1805          v-wday-7:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1806          v-txt1  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1807          v-txt2  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1808          v-txt3  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1809          v-txt4  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1810          v-txt5  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1811          v-txt8  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1812          v-txt9  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1813          v-txt6  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1814          cb-zakaz:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1815          b-contr :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1816          b-contract :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1817          b-grp   :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1818          b-method:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1819          v-contr :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1820          v-contract :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1821          v-grp   :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1822          v-method:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1823          v-flag  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1824          v-l-addextart :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1825          v-l-delnull :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1826          v-days-do  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1827          v-days-fale:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1828          b-quit  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1829          b-add   :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1830          b-lookup:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1831          b-chg   :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1832          b-del   :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1833          br-dis-some :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1834          c-flt-reg:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1835          v-txt7  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1836          b-flt-contr :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1837          v-flt-contr :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1838          b-flt-clear :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1839       .
     1840       DISABLE b-save b-cancel r-region RECT-1 RECT-3 RECT-4 RECT-5 RECT-6
     1841       WITH FRAME Dialog-Frame.
     1842       ENABLE b-quit b-add B-lookup b-chg b-del br-dis-some c-flt-reg v-txt7 b-flt-contr v-flt-contr b-flt-clear
     1843       WITH FRAME Dialog-Frame.
     1844   END PROCEDURE.
     1845   PROCEDURE show_add_page :
     1846   define input parameter p-add as logical no-undo.
     1847   define variable v-time as integer no-undo .
     1848   define variable v-curdt as date no-undo .
     1849   assign
     1850      b-save  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1851      b-cancel:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1852      r-region:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1853      RECT-1  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1854      RECT-3  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1855      RECT-4  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1856      RECT-5  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1857      RECT-6  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1858      v-from  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1859      v-to    :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1860      v-wday-1:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1861      v-repeat:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1862      v-wday-2:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1863      v-wday-3:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1864      v-wday-4:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1865      v-wday-5:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1866      v-wday-6:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1867      v-wday-7:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1868      v-txt1  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1869      v-txt2  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1870      v-txt3  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1871      v-txt4  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1872      v-txt5  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1873      v-txt8  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1874      v-txt8  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1875      v-txt8  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1876      v-txt9  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1877      v-txt6  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1878      cb-zakaz:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1879      b-contract :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1880      b-grp   :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1881      b-method:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1882      v-contr :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1883      v-contract :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1884      v-grp   :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1885      v-method:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1886      v-flag  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1887      v-l-addextart :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1888      v-l-delnull :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1889      v-days-do  :HIDDEN IN FRAME Dialog-Frame  = FALSE
     1890      v-days-fale:HIDDEN IN FRAME Dialog-Frame  = FALSE
     1891      b-quit  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1892      b-add   :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1893      b-lookup:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1894      b-chg   :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1895      b-del   :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1896      br-dis-some :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1897      c-flt-reg:HIDDEN IN FRAME Dialog-Frame  = TRUE
     1898      v-txt7  :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1899      b-flt-contr :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1900      v-flt-contr :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1901      b-flt-clear :HIDDEN IN FRAME Dialog-Frame  = TRUE
     1902   .
     1903   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1904   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1905     (input  v-cntxt-obj-type
     1906     ,input  v-cntxt-obj-code
     1907     ,output v-curdt
     1908     ) no-error .
     1909   if p-add then do:
     1910     ASSIGN
     1911      r-region:SCREEN-VALUE IN FRAME Dialog-Frame = "3"
     1912      v-repeat:SCREEN-VALUE IN FRAME Dialog-Frame = "1"
     1913      cb-zakaz:SCREEN-VALUE IN FRAME Dialog-Frame = "1"
     1914      v-contr :SCREEN-VALUE IN FRAME Dialog-Frame = ""
     1915      v-contract :SCREEN-VALUE IN FRAME Dialog-Frame = ""
     1916      v-grp   :SCREEN-VALUE IN FRAME Dialog-Frame = ""
     1917      v-method:SCREEN-VALUE IN FRAME Dialog-Frame = ""
     1918      v-from  :SCREEN-VALUE IN FRAME Dialog-Frame = string(v-curdt, "99999999")
     1919      v-to    :SCREEN-VALUE IN FRAME Dialog-Frame = string(v-curdt, "99999999")
     1920      v-select-node-code = ""
     1921      v-select-obj-type = ""
     1922      v-select-obj-name = ""
     1923      v-select-obj-code = 0
     1924      p-method = ""
     1925     .
     1926   end.
     1927   else do:
     1928     find first buf_contract where buf_contract.contract-code = integer(entry(5, tt-dis-some-rule.charkey_two, chr(3) )) and buf_contract.host-code = v-cntxt-host-code-obj no-error.
     1929     assign
     1930       p-method = tt-dis-some-rule.charkey_one
     1931       v-method:SCREEN-VALUE IN FRAME Dialog-Frame = "Установлен"
     1932       v-flag  :SCREEN-VALUE IN FRAME Dialog-Frame = entry(1, tt-dis-some-rule.charkey_two, chr(3) )
     1933       v-l-addextart :SCREEN-VALUE IN FRAME Dialog-Frame = if num-entries (tt-dis-some-rule.charkey_two, chr(3)) < 6 then "no" else entry(6, tt-dis-some-rule.charkey_two, chr(3) )
     1934       v-l-delnull :SCREEN-VALUE IN FRAME Dialog-Frame = if num-entries (tt-dis-some-rule.charkey_two, chr(3)) < 7 then "no" else entry(7, tt-dis-some-rule.charkey_two, chr(3) )
     1935       v-from  :SCREEN-VALUE IN FRAME Dialog-Frame = entry(1, tt-dis-some-rule.charkey_three, "-" )
     1936       v-to    :SCREEN-VALUE IN FRAME Dialog-Frame = entry(2, tt-dis-some-rule.charkey_three, "-" )
     1937       v-days-do  :SCREEN-VALUE IN FRAME Dialog-Frame = string(tt-dis-some-rule.key#_one)
     1938       v-days-fale:SCREEN-VALUE IN FRAME Dialog-Frame = string(tt-dis-some-rule.key#_two)
     1939       v-select-node-code = entry(2, tt-dis-some-rule.charkey_two, chr(3) )
     1940       v-select-contract = if num-entries (tt-dis-some-rule.charkey_two, chr(3)) < 5 then 0 else integer(entry(5, tt-dis-some-rule.charkey_two, chr(3) ))
     1941       v-grp :SCREEN-VALUE IN FRAME Dialog-Frame = ( if v-select-node-code = "" then "" else "Установлена"  )
     1942       cb-zakaz:SCREEN-VALUE IN FRAME Dialog-Frame = entry(3, tt-dis-some-rule.classif-type, "-" )
     1943       v-select-obj-type = substring( entry(3, tt-dis-some-rule.charkey_two, chr(3) ), 1, 3 )
     1944       v-select-obj-code = int(substring( entry(3, tt-dis-some-rule.charkey_two, chr(3) ), 4 ))
     1945       v-select-obj-name = tt-dis-some-rule.resource_id
     1946       v-contr :SCREEN-VALUE IN FRAME Dialog-Frame = v-select-obj-name
     1947       v-contract :SCREEN-VALUE IN FRAME Dialog-Frame = if available buf_contract then buf_contract.contract-prn-code else ""
     1948       v-repeat:SCREEN-VALUE IN FRAME Dialog-Frame = string(tt-dis-some-rule.rl-root)
     1949       v-wday-1:SCREEN-VALUE IN FRAME Dialog-Frame = entry(1, entry(4, tt-dis-some-rule.charkey_two, chr(3)) )
     1950       v-wday-2:SCREEN-VALUE IN FRAME Dialog-Frame = entry(2, entry(4, tt-dis-some-rule.charkey_two, chr(3)) )
     1951       v-wday-3:SCREEN-VALUE IN FRAME Dialog-Frame = entry(3, entry(4, tt-dis-some-rule.charkey_two, chr(3)) )
     1952       v-wday-4:SCREEN-VALUE IN FRAME Dialog-Frame = entry(4, entry(4, tt-dis-some-rule.charkey_two, chr(3)) )
     1953       v-wday-5:SCREEN-VALUE IN FRAME Dialog-Frame = entry(5, entry(4, tt-dis-some-rule.charkey_two, chr(3)) )
     1954       v-wday-6:SCREEN-VALUE IN FRAME Dialog-Frame = entry(6, entry(4, tt-dis-some-rule.charkey_two, chr(3)) )
     1955       v-wday-7:SCREEN-VALUE IN FRAME Dialog-Frame = entry(7, entry(4, tt-dis-some-rule.charkey_two, chr(3)) )
     1956     .
     1957     if tt-dis-some-rule.host-code = 0 then     assign r-region = 1 r-region:SCREEN-VALUE IN FRAME Dialog-Frame = "1" .
     1958     else if tt-dis-some-rule.obj-code = 0 then assign r-region = 2 r-region:SCREEN-VALUE IN FRAME Dialog-Frame = "2" .
     1959          else                                  assign r-region = 3 r-region:SCREEN-VALUE IN FRAME Dialog-Frame = "3" .
     1960   end.
     1961   if cb-zakaz:screen-value IN FRAME Dialog-Frame = "1" then enable b-contract with frame Dialog-Frame . else disable b-contract with frame Dialog-Frame.
     1962   DISABLE b-quit b-add B-lookup b-chg b-del c-flt-reg v-txt7 b-flt-contr v-flt-contr b-flt-clear
     1963   WITH FRAME Dialog-Frame.
     1964   ENABLE b-save b-cancel r-region RECT-1 RECT-3 RECT-4 RECT-5 RECT-6 v-from v-to v-wday-1 v-repeat v-wday-2 v-wday-3 v-wday-4
     1965          v-wday-5 v-wday-6 v-wday-7 v-txt1 v-txt2 v-txt3 v-txt4 v-txt5 v-txt8 v-txt6 v-txt9 cb-zakaz b-contr b-grp b-method v-flag v-l-addextart v-l-delnull
     1966          v-days-do v-days-fale v-contr v-contract v-grp v-method
     1967   WITH FRAME Dialog-Frame.
     1968   if cb-zakaz:SCREEN-VALUE IN FRAME Dialog-Frame = "2" then disable b-contr with frame Dialog-Frame .
     1969   if not p-add then disable r-region with frame Dialog-Frame .
     1970   else disable b-contract with frame Dialog-Frame .
     1971   END PROCEDURE.
     1972   PROCEDURE open-br :
     1973     define input parameter p-flt-reg as character no-undo.
     1974     define variable v-reg  as character no-undo.
     1975     for each tt-dis-some-rule exclusive-lock:
     1976         delete tt-dis-some-rule.
     1977     end.
     1978     _buf_dis-some-rule:
     1979     for each buf_dis-some-rule no-lock:
     1980         if buf_dis-some-rule.host-code = 0 then assign v-reg = "1" .
     1981         else if buf_dis-some-rule.obj-code = 0 then assign v-reg = "2" .
     1982              else assign v-reg = "3" .
     1983         if v-reg = "2" and not buf_dis-some-rule.host-code = v-cntxt-host-code-obj then next _buf_dis-some-rule .
     1984         if v-reg = "3" and not (buf_dis-some-rule.obj-code = v-cntxt-obj-code and buf_dis-some-rule.obj-code = v-cntxt-obj-code) then next _buf_dis-some-rule .
     1985         if int(p-flt-reg) > 0 and not v-reg = p-flt-reg then next _buf_dis-some-rule .
     1986         if not v-flt-obj-type = "" and not entry(3, buf_dis-some-rule.charkey_two, chr(3) ) = v-flt-obj-type + string(v-flt-obj-code) then next _buf_dis-some-rule .
     1987         create tt-dis-some-rule .
     1988         buffer-copy buf_dis-some-rule to tt-dis-some-rule .
     1989     end.
     1990   END PROCEDURE.
