     1723                   output  coast_v     ,
     1724                   output  vat_r       ,
     1725                   output  vat_v       ,
     1726                   output  slt_r       ,
     1727                   output  slt_v       ).
     1728   assign
     1729     ostatok-end [1 + 0]   = quantity
     1730    ostatok-end [2 + 0]   = if tprintrubl then coast_r else coast_v
     1731    ostatok-end [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1732    b1-ostatok-end [1 + 0] =  b1-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1733    b1-ostatok-end [2 + 0] =  b1-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1734    b1-ostatok-end [3 + 0] =  b1-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1735    b2-ostatok-end [1 + 0] =  b2-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1736    b2-ostatok-end [2 + 0] =  b2-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1737    b2-ostatok-end [3 + 0] =  b2-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1738    .
     1739    assign
     1740     bi-ostatok-end [1 + 0] =  bi-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1741     bi-ostatok-end [2 + 0] =  bi-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1742     bi-ostatok-end [3 + 0] =  bi-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1743    .
     1744   If  xshowcrsa or vat-crsa Then DO:
     1745   run ost-line in this-procedure
     1746                  (input   x-store-code  ,
     1747                   input   x-store-type  ,
     1748                   input   gds-zap-artic     ,
     1749                   input   gds-zap-prod-code ,
     1750                   input   gds-zap-prod-type ,
     1751                   input   x-tog-shift       ,
     1752                   input   Fact-order-2               ,
     1753                   input   'crsa':U            ,
     1754                   input   '##,##':U    ,
     1755                   input   xtog-obj    ,
     1756                   output  quantity    ,
     1757                   output  coast_r     ,
     1758                   output  coast_v     ,
     1759                   output  vat_r       ,
     1760                   output  vat_v       ,
     1761                   output  slt_r       ,
     1762                   output  slt_v       ).
     1763   assign
     1764     ostatok-end [4]        = round(ostatok-end [1] *  p-price-med , 2)
     1765    ostatok-end [2 + 3]   = if tprintrubl then coast_r else coast_v
     1766    ostatok-end [3 + 3]   = if tprintrubl then vat_r   else vat_v
     1767    b1-ostatok-end [1 + 3] =  b1-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1768    b1-ostatok-end [2 + 3] =  b1-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1769    b1-ostatok-end [3 + 3] =  b1-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1770    b2-ostatok-end [1 + 3] =  b2-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1771    b2-ostatok-end [2 + 3] =  b2-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1772    b2-ostatok-end [3 + 3] =  b2-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1773    .
     1774    assign
     1775     bi-ostatok-end [1 + 3] =  bi-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1776     bi-ostatok-end [2 + 3] =  bi-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1777     bi-ostatok-end [3 + 3] =  bi-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1778    .
     1779      End.
     1780   If xshowsale or vat-sale Then DO:
     1781   run ost-line in this-procedure
     1782                  (input   x-store-code  ,
     1783                   input   x-store-type  ,
     1784                   input   gds-zap-artic     ,
     1785                   input   gds-zap-prod-code ,
     1786                   input   gds-zap-prod-type ,
     1787                   input   x-tog-shift       ,
     1788                   input   Fact-order-2               ,
     1789                   input   'crsa':U            ,
     1790                   input   '##,##':U    ,
     1791                   input   xtog-obj    ,
     1792                   output  quantity    ,
     1793                   output  coast_r     ,
     1794                   output  coast_v     ,
     1795                   output  vat_r       ,
     1796                   output  vat_v       ,
     1797                   output  slt_r       ,
     1798                   output  slt_v       ).
     1799   assign
     1800     ostatok-end [1 + 6]   = quantity
     1801    ostatok-end [2 + 6]   = if tprintrubl then coast_r else coast_v
     1802    ostatok-end [3 + 6]   = if tprintrubl then vat_r   else vat_v
     1803    ostatok-end [10]        = if tprintrubl then slt_r   else slt_v
     1804    b1-ostatok-end [1 + 6] =  b1-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1805    b1-ostatok-end [2 + 6] =  b1-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1806    b1-ostatok-end [3 + 6] =  b1-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1807    b2-ostatok-end [1 + 6] =  b2-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1808    b2-ostatok-end [2 + 6] =  b2-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1809    b2-ostatok-end [3 + 6] =  b2-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1810    b1-ostatok-end [10] =  b1-ostatok-end [10] + ostatok-end [10]
     1811    b2-ostatok-end [10] =  b2-ostatok-end [10] + ostatok-end [10]
     1812    .
     1813    assign
     1814     bi-ostatok-end [1 + 6] =  bi-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1815     bi-ostatok-end [2 + 6] =  bi-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1816     bi-ostatok-end [3 + 6] =  bi-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1817     bi-ostatok-end [10] =  bi-ostatok-end [10] + ostatok-end [10]
     1818    .
     1819      End.
     1820       case  gds-zap-type :
     1821       when 'у':U THEN DO:
     1822         run ob-line (
     1823             input   x-store-code   ,
     1824             input   x-store-type   ,
     1825             INPUT   gds-zap-artic       ,
     1826             INPUT   gds-zap-prod-code   ,
     1827             INPUT   gds-zap-prod-type   ,
     1828             INPUT   Fact-order-1,
     1829             INPUT   Fact-order-2,
     1830             input   'cssr':U    ,
     1831             input   '##,##':U,
     1832             input   ""    ,
     1833             input   xTog-obj) .
