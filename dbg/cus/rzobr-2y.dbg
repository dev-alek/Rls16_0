      774   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
      775   define variable  str  as char format "X(60)"  no-undo.
      776   define variable  str2 as char no-undo.
      777   define variable v-r as character no-undo init "" .
      778   define variable  i#i as int no-undo.
      779   STR = "".
      780   repeat i#i =1 to lavel#:
      781       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
      782       else do:
      783           str2 = entry(i#i,grp-name, chr(47)) no-error.
      784           if not error-status:error  and str2 <> "":u then
      785                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
      786           end.
      787   end.
      788   if str <> ? then do:
      789   v-r = str + chr(47) .
      790   end.
      791   RETURN v-r .
      792   END FUNCTION.
      793   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      794     if num-entries(string(p-dec), '.') = 2
      795       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      796       else return( string(p-dec)) .
      797   end function.
      798   function format-point-to-comma returns char (input orig as char ) .
      799   define variable rtext as character no-undo .
      800   define variable strt as integer no-undo .
      801   define variable leng as integer no-undo .
      802   assign rtext = orig .
      803   repeat:
      804     strt =  index(rtext,'.').
      805     if strt = 0 then leave.
      806     leng = 1.
      807     substring(rtext,strt,leng,"character") = v-delim .
      808   end.
      809   return rtext.
      810   end function.
      811   function format-excel-text returns char ( input start-text as char ) :
      812   def var  i    as int no-undo.
      813   def var  ch   as char no-undo.
      814   def var  n    as int no-undo.
      815   def var  ipos as int no-undo.
      816     n = num-entries(trim(start-text), chr(10)) - 1 .
      817     do i = 1 to n :
      818       ipos = index( start-text, chr(10)).
      819       if ipos > 0 then
      820         substr( start-text, ipos, 1 ) = ' '.
      821     end.
      822     n = num-entries(trim(start-text), chr(13)) - 1 .
      823     do i = 1 to n :
      824       ipos = index( start-text, chr(13)).
      825       if ipos > 0 then
      826         substr( start-text, ipos, 1 ) = ' '.
      827     end.
      828     if index( start-text, '"' ) = 0 then
      829       start-text =  '="'   + trim( start-text) + '"'   .
      830       else do:
      831         n = num-entries(trim(start-text), '"') - 1.
      832         do i = 1 to n :
      833           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      834         end.
      835         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      836         start-text = '="'  + ch  + '"' .
      837       end.
      838     return start-text.
      839   end.
      840   function excel-sum returns char (input p-dec as decimal ).
      841     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      842   end function.
      843   function excel-qnty returns char (input p-dec as decimal ).
      844     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      845   end function.
      846   function format-excel-text-macr returns char ( input start-text as char ) :
      847   def var  i    as int no-undo.
      848   def var  ch   as char no-undo.
      849   def var  n    as int no-undo.
      850   def var  ipos as int no-undo.
      851     n = num-entries(trim(start-text), chr(10)) - 1 .
      852     do i = 1 to n :
      853       ipos = index( start-text, chr(10)).
      854       if ipos > 0 then
      855         substring( start-text, ipos , 1 ) = ' '.
      856     end.
      857     n = num-entries(trim(start-text), chr(13)) - 1 .
      858     do i = 1 to n :
      859       ipos = index( start-text, chr(13)).
      860       if ipos > 0 then
      861         substring( start-text, ipos, 1 ) = ' '.
      862     end.
      863     if index( start-text, '"' ) = 0 then
      864       start-text =  '"'   + trim( start-text) + '"'   .
      865       else do:
      866         n = num-entries(trim(start-text), '"') - 1.
      867         do i = 1 to n :
      868           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      869         end.
      870         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      871         start-text = '"'  + ch  + '"' .
      872       end.
      873     n = num-entries(trim(start-text), chr(10)) - 1 .
      874     do i = 1 to n :
      875       ipos = index( start-text, chr(10)).
      876       if ipos > 0 then
      877         substring( start-text, ipos , 1 ) = ' '.
      878     end.
      879       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      880     return start-text.
      881   end.
