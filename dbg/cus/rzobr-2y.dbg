     1704     bi-ostatok-start [1 + 6] =  bi-ostatok-start [1 + 6] + ostatok-start [1 + 6]
     1705     bi-ostatok-start [2 + 6] =  bi-ostatok-start [2 + 6] + ostatok-start [2 + 6]
     1706     bi-ostatok-start [3 + 6] =  bi-ostatok-start [3 + 6] + ostatok-start [3 + 6]
     1707     bi-ostatok-start [10] =  bi-ostatok-start [10] + ostatok-start [10]
     1708    .
     1709      End.
     1710   run ost-line in this-procedure
     1711                  (input   x-store-code  ,
     1712                   input   x-store-type  ,
     1713                   input   gds-zap-artic     ,
     1714                   input   gds-zap-prod-code ,
