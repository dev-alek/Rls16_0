     2048               Run Clear-b1 In This-procedure .
     2049               Assign Break_Group = True.
     2050           End.
     2051       End.
     2052     END.
     2053     Else DO:
     2054      For each obj-list no-lock :
     2055                     FOR EACH gds-obj where
     2056                   gds-obj.obj-type = obj-list.obj-type    and
     2057                   gds-obj.obj-code = obj-list.obj-code
     2058                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2059                   no-lock :
     2060                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2061                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2062                       Create temp-gds-list.
     2063                       Assign
     2064                         temp-gds-list.prod-code = gds-obj.prod-code
     2065                         temp-gds-list.grp-name  = gds-obj.grp-name
     2066                         temp-gds-list.gds-name  = goods.gds-name
     2067                         temp-gds-list.gds-code  = gds-obj.gds-code
     2068                         temp-gds-list.artic     = gds-obj.artic
     2069                       .
     2070                   End.
     2071               End.
     2072     End.
     2073     for each temp-gds-list no-lock
     2074       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2075         BREAK
     2076   BY (gds-obj.grp-name)
