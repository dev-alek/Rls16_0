     2167         if return-value <> "" then next.
     2168           If Last-of(gds-obj.grp-name) Then Do:
     2169           If String(Entry(2,"gds-obj.grp-name",".")) = "Grp-name"
     2170             Then  Assign
     2171                     S-bar-code   = " Итого по "
     2172                     Gds-zap-artic = Substring(
     2173                                         B1-name
     2174                                         ,1,16)
     2175                     Gds-zap-gds-name = Substring(
