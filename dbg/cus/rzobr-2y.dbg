     2637           str = n-lavel(input gds-list.grp-name, input xlavel ) no-error .
     2638   find clients where clients.obj-type = gds-list.prod-type and
     2639                      clients.obj-code = gds-list.prod-code no-lock .
     2640     assign
     2641         gds-zap-unit-base  = gds-list.unit-base
     2642         gds-zap-prt-root   = gds-list.prt-root
     2643         gds-zap-prod-type  = gds-list.prod-type
     2644         gds-zap-prod-code  = gds-list.prod-code
     2645         gds-zap-artic      = gds-list.artic
     2646         gds-zap-type       = gds-list.gds-type
     2647         gds-zap-grp-name   = gds-list.grp-name
     2648         gds-zap-b-code     = gds-list.gds-code
     2649         gds-zap-prod-name  = clients.obj-name .
     2650     if g#gds-engl then
     2651         assign gds-zap-gds-name = gds-list.engl-name.
     2652     else
     2653         assign gds-zap-gds-name = gds-list.gds-name.
     2654   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2655     (input  gds-zap-b-code
     2656     ,input  ?
     2657     ,output v-bar-code
     2658     )  .
     2659     s-bar-code = string (v-bar-code,"999999999").
     2660     run foreach in this-procedure .
     2661       if  first-of ( temp-gds-list.grp-name )  then do:
     2662           fr = true .
     2663           l-stroka = "ГРУППА : " + str .
     2664           temp-str = l-stroka.
     2665       end.
     2666      run display-line in this-procedure .
     2667      if last-of( temp-gds-list.grp-name ) then do:
     2668         s-bar-code = "Итого по " .
     2669         gds-zap-artic = substring(str,1,16) .
     2670         gds-zap-gds-name = substring(str,17,250) .
     2671         run display-b1 in this-procedure .
     2672         run clear-b1 in this-procedure .
     2673         run clear-b2 in this-procedure .
     2674      end.
     2675     end.
     2676                     end.
     2677                 end case.
     2678   end procedure.
     2679   PROCEDURE CalcItog :
     2680       run ostatok (
     2681           input x-store-code  ,
     2682           input x-store-type  ,x-TOG-Shift,
     2683           input x-date-start - 1 ,
     2684           input date('')      , x-Shift-Start,x-Shift-End,
     2685           input 'crsa':U   ,
     2686           input '##,##':U,
     2687           input xTog-obj ,
     2688           output  Quantity1  ,
     2689           output  Coast_R1   ,
     2690           output  Coast_V1   ,
     2691           output  VAT_R1     ,
     2692           output  VAT_V1     ,
     2693           output  Fact-order-1 ).
     2694       run ostatok (
     2695           input x-store-code  ,
     2696           input x-store-type  , x-TOG-Shift,
     2697           input x-date-start  ,
     2698           input x-date-end    , x-Shift-Start,x-Shift-End,
     2699           input 'crsa':U   ,
     2700           input '##,##':U,
     2701           input xTog-obj ,
     2702           output  Quantity1  ,
     2703           output  Coast_R1   ,
     2704           output  Coast_V1   ,
     2705           output  VAT_R1     ,
     2706           output  VAT_V1     ,
     2707           output  Fact-order-2 ).
     2708             Quantity1  = 0.
     2709             Coast_R1   = 0.
     2710             Coast_V1   = 0.
     2711             VAT_R1     = 0.
     2712             VAT_V1     = 0.
     2713   END PROCEDURE.
     2714   PROCEDURE display-str1  :
     2715              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2716            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2717            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2718            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     2719            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2720            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     2721            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     2722   end procedure.
     2723   procedure display-bi  :
     2724              run di-qnty("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     2725            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     2726            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     2727            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bi":u).  end.
     2728            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bi":u ). end.
     2729            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bi":u ).  end.
     2730            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bi":u ).  end.
     2731   END PROCEDURE.
     2732   PROCEDURE display-Bo  :
     2733              run di-qnty("кол-во",1,  "", "ИТОГО ПО" ,"ОБЪЕКТАМ" ,"", "bo":u).
     2734            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bo":u).  end.
     2735            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bo":u).  end.
     2736            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bo":u).  end.
     2737            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bo":u ). end.
     2738            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bo":u ).  end.
     2739            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bo":u ).  end.
     2740   end procedure.
     2741   PROCEDURE display-B1  :
     2742         if NOT( NOT Show-Negativ-2 and
     2743            ( b1-prih         [1]   = 0 AND
     2744              b1-rash          [1]   = 0 AND
     2745              b1-kassa         [1]   = 0 AND
     2746              b1-Inv           [1]   = 0 AND
     2747              b1-Overturn      [1]   = 0 AND
     2748              b1-Overturn      [5]   = 0 AND
     2749              b1-Overturn      [8]   = 0 ) ) then DO:
     2750           IF  NOT (NOT Show-Negativ  AND (
     2751                 b1-prih          [1]   = 0 AND
     2752                 b1-rash          [1]   = 0 AND
     2753                 b1-kassa         [1]   = 0 AND
     2754                 b1-Inv           [1]   = 0 AND
     2755                 b1-Overturn      [1]   = 0 AND
     2756                 b1-Overturn      [5]   = 0 AND
     2757                 b1-ostatok-start [1]   = 0 AND
     2758                 b1-ostatok-End   [1]   = 0   )) then DO:
     2759                 if Sums-Only THEN do:
     2760                     if fr0 = true then do:
     2761                         PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2762                         if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     2763                         fr0 = false .
     2764                       end.
     2765                  end.
     2766           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2767           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2768           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2769           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2770           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2771           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2772           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2773          if not sums-only then run p-line.
     2774    End.
     2775    end.
     2776   END PROCEDURE.
     2777   PROCEDURE display-B2  :
     2778        if NOT( NOT Show-Negativ-2 and
     2779            ( b2-prih         [1]   = 0 AND
     2780              b2-rash          [1]   = 0 AND
     2781              b2-kassa         [1]   = 0 AND
     2782              b2-Inv           [1]   = 0 AND
     2783              b2-Overturn      [1]   = 0 AND
     2784              b2-Overturn      [5]   = 0 AND
     2785              b2-Overturn      [8]   = 0 ) ) then DO:
     2786           IF  NOT (NOT Show-Negativ  AND (
     2787                 b2-prih          [1]   = 0 AND
     2788                 b2-rash          [1]   = 0 AND
     2789                 b2-kassa         [1]   = 0 AND
     2790                 b2-Inv           [1]   = 0 AND
     2791                 b2-Overturn      [1]   = 0 AND
     2792                 b2-Overturn      [5]   = 0 AND
     2793                 b2-ostatok-start [1]   = 0 AND
     2794                 b2-ostatok-End   [1]   = 0   )) then DO:
     2795           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     2796           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     2797           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     2798           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
     2799            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","b2":u ). end.
     2800            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","b2":u ).  end.
     2801            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","b2":u ).  end.
     2802    End.
     2803   end.
     2804   END PROCEDURE.
     2805   PROCEDURE Clear-B1  :
     2806    b1-gds-zap-other           = 0.
     2807    REPEAT kk = 1 to 9 :
     2808    Assign
     2809       b1-Prih                                            [kk]    = 0
     2810       b1-Rash                                            [kk]    = 0
     2811       b1-KAssa                                           [kk]    = 0
     2812       b1-Inv                                             [kk]    = 0
     2813       b1-Overturn                                        [kk]    = 0
     2814       b1-ostatok-end                                     [kk]    = 0
     2815       b1-ostatok-start                                   [kk]    = 0   .
     2816      End.
     2817    END PROCEDURE.
     2818   PROCEDURE Clear-B2  :
     2819    b2-gds-zap-other           = 0.
     2820    REPEAT kk = 1 to 9 :
     2821    Assign
     2822       b2-Prih                                            [kk]    = 0
     2823       b2-Rash                                            [kk]    = 0
     2824       b2-KAssa                                           [kk]    = 0
     2825       b2-Inv                                             [kk]    = 0
     2826       b2-Overturn                                        [kk]    = 0
     2827       b2-ostatok-end                                     [kk]    = 0
     2828       b2-ostatok-start                                   [kk]    = 0   .
     2829      End.
     2830   END PROCEDURE.
     2831   PROCEDURE Clear-Bi  :
     2832    bi-gds-zap-other           = 0.
     2833    REPEAT kk = 1 to 9 :
     2834    Assign
     2835       bi-Prih                                            [kk]    = 0
     2836       bi-Rash                                            [kk]    = 0
     2837       bi-KAssa                                           [kk]    = 0
     2838       bi-Inv                                             [kk]    = 0
     2839       bi-Overturn                                        [kk]    = 0
     2840       bi-ostatok-end                                     [kk]    = 0
     2841       bi-ostatok-start                                   [kk]    = 0   .
     2842      End.
     2843   END PROCEDURE.
     2844   PROCEDURE Display-title :
     2845   define variable v-nn as integer   no-undo .
     2846      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2847             REPORTNAME  AT 20 format "X(170)" SKIP
     2848             Trim(str1)  AT 35 format "X(75)" SKIP.
     2849        v-nn = NUM-ENTRIES(str2,chr(10)) .
     2850        Repeat i = 1 to v-nn:
     2851         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     2852        End.
     2853       i=0.
     2854          PUT stream  OutStream  UNFORMATTED  Trim(str3)  AT 35 format "X(75)" SKIP.
     2855        v-nn = NUM-ENTRIES(str4,chr(10)).
     2856        Repeat i = 1 to v-nn :
     2857         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2858        End.
     2859       i=0.
     2860        v-nn = NUM-ENTRIES(ReportHeader,chr(10)) .
     2861        Repeat i = 1 to v-nn :
     2862         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2863        End.
     2864       i=0.
     2865       run rep/extitle.p (1) .
     2866   END PROCEDURE.
     2867   PROCEDURE ob-line  :
     2868   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2869   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2870   define INPUT  parameter x-artic        like ub.ot-line.artic        no-undo.
     2871   define INPUT  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2872   define INPUT  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2873   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2874   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2875   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2876   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2877   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2878   define input  parameter xTog-obj           as log no-undo.
     2879   define variable  tt#          as   int                 no-undo.
     2880    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     2881    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     2882    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     2883        FOR each ub.ot-line where
     2884                           ub.ot-line.artic         = x-artic
     2885                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2886                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2887                     AND   ub.ot-line.obj-code     = x-store-code
     2888                     AND   ub.ot-line.obj-type     = x-store-type
     2889                     AND   ub.ot-line.prod-code    = x-prod-code
     2890                     AND   ub.ot-line.prod-type    = x-prod-type
     2891                     AND   ub.ot-line.sum-type     = x-sum-type
     2892                       no-lock :
     2893       CASE ub.ot-line.ext-doc-type:
     2894                 WHEN        'ie':U  OR
     2895                 WHEN        're':U  OR
     2896                 WHEN        'iv':U    OR
     2897                 WHEN        'rv':U OR
     2898                 WHEN        'im':U     THEN
     2899                 DO:
     2900                 ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  ub.ot-line.fact-qnty
     2901                        prih[2 + tt#]   = prih[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2902                        prih[3 + tt#]   = prih[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2903                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2904                 End.
     2905                 WHEN       'ee':U      OR
     2906                 WHEN       'ep':U    OR
     2907                 WHEN       'ev':U     OR
     2908                 WHEN       'em':U       OR
     2909                 WHEN       'wm':U       OR
     2910                 WHEN       'we':U     THEN
     2911                 DO:
     2912                 ASSIGN  rash[1 + tt#]   = rash[1 + tt#]   +  ub.ot-line.fact-qnty
     2913                         rash[2 + tt#]   = rash[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2914                         rash[3 + tt#]   = rash[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2915                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2916                 End.
     2917                 WHEN       'es':U  OR
     2918                 WHEN       'rs':U THEN
     2919                 DO:
     2920                 ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.ot-line.fact-qnty
     2921                        kassa[2 + tt#]   = kassa[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2922                        kassa[3 + tt#]   = kassa[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2923                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2924                 End.
     2925             WHEN  'vt':U or when 'vp':U     THEN
     2926                 DO:
     2927                 ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.ot-line.fact-qnty
     2928                       inv[2 + tt#]   = inv[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2929                       Inv[3 + tt#]   = Inv[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.vat-base  .
     2930                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2931                 End.
     2932             WHEN       'ot':U THEN
     2933                 DO:
     2934                 ASSIGN Overturn[1 + tt#]   = Overturn[1 + tt#]   +  ub.ot-line.fact-qnty
     2935                       Overturn[2 + tt#]   = Overturn[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2936                       Overturn[3 + tt#]   = Overturn[3 + tt#]   +  if tPrintRubl then ub.ot-line.vat-rubl Else  ub.ot-line.vat-base  .
     2937                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2938                 End.
     2939         End CASE.
     2940     END.
     2941     if tt# = 6 then DO:
     2942              ASSIGN Overturn[1 + tt#]   = (Ostatok-end[1 + tt#]  - Ostatok-start[1 + tt#] )  -  (INV[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2943                     Overturn[2 + tt#]   = (Ostatok-end[2 + tt#]  - Ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  )
     2944                     Overturn[3 + tt#]   = (Ostatok-end[3 + tt#]  - Ostatok-start[3 + tt#] )  -  (Inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2945     End.
     2946   END PROCEDURE.
     2947   procedure ost-line :
     2948     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2949     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2950     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2951     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2952     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2953     define input  parameter x-tog-shift  as logical no-undo .
     2954     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2955     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2956     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2957     define input  parameter xtog-obj     as logical no-undo .
     2958     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2959     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2960     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2961     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2962     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2963     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2964     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2965     define buffer buff-obj-list  for obj-list .
     2966     define buffer buff-stk-line  for ub.stk-line .
     2967     assign
     2968       Quantity = 0
     2969       Coast_R  = 0
     2970       Coast_V  = 0
     2971       VAT_R    = 0
     2972       VAT_V    = 0
     2973       SLT_R    = 0
     2974       SLT_V    = 0
     2975     .
     2976     if  x-tog-shift = false then do:
     2977       for each buff-obj-list no-lock
     2978         where xtog-obj = false
     2979            or (buff-obj-list.obj-type = x-store-type
     2980               and buff-obj-list.obj-code = x-store-code
     2981               )
     2982       on error undo, return error
     2983       :
     2984       find last buff-stk-line no-lock
     2985         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2986           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2987           and buff-stk-line.artic      = x-artic
     2988           and buff-stk-line.prod-type  = x-prod-type
     2989           and buff-stk-line.prod-code  = x-prod-code
     2990           and buff-stk-line.sum-type   = x-sum-type
     2991           and buff-stk-line.cat-id     = '##,##':U
     2992           and buff-stk-line.fact-order <= x-fact-order
     2993           and buff-stk-line.shift-num  = 0
     2994         use-index category
     2995         no-error .
     2996       if available buff-stk-line then do:
     2997         assign
     2998           Quantity = Quantity + buff-stk-line.fact-qnty
     2999           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     3000           Coast_V  = Coast_V  + buff-stk-line.sum-base
     3001           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     3002           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     3003           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     3004           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     3005         .
     3006       end.
     3007      end.
     3008     end.
     3009     else do:
     3010       for each buff-obj-list no-lock
     3011         where xtog-obj = false
     3012            or (buff-obj-list.obj-type = x-store-type
     3013               and buff-obj-list.obj-code = x-store-code
     3014               )
     3015       on error undo, return error
     3016       :
     3017         find last buff-stk-line no-lock
     3018           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3019             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3020             and buff-stk-line.artic      = x-artic
     3021             and buff-stk-line.prod-type  = x-prod-type
     3022             and buff-stk-line.prod-code  = x-prod-code
     3023             and buff-stk-line.sum-type   = x-sum-type
     3024             and buff-stk-line.cat-id     = '##,##':U
     3025             and buff-stk-line.fact-order <= x-fact-order
     3026             and buff-stk-line.shift-num  > 0
     3027           use-index category
     3028           no-error .
     3029         if available buff-stk-line then do:
     3030           assign
     3031             Quantity = Quantity +  buff-stk-line.fact-qnty
     3032             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3033             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3034             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3035             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3036             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3037             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3038           .
     3039         end.
     3040       end.
     3041     end.
     3042   end procedure.
     3043   procedure ost-lineother-tax :
     3044     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     3045     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     3046     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     3047     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     3048     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     3049     define input  parameter x-tog-shift  as logical no-undo .
     3050     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     3051     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     3052     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     3053     define input  parameter xTog-obj     as logical no-undo .
     3054     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     3055     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     3056     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     3057     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     3058     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     3059     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     3060     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     3061     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     3062     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     3063     define buffer buff-obj-list  for obj-list .
     3064     define buffer buff-stk-line  for ub.stk-line .
     3065     assign
     3066       Quantity = 0
     3067       Coast_R  = 0
     3068       Coast_V  = 0
     3069       VAT_R    = 0
     3070       VAT_V    = 0
     3071       SLT_R    = 0
     3072       SLT_V    = 0
     3073       other_R  = 0
     3074       other_V  = 0
     3075     .
     3076     if  x-tog-shift = false then do:
     3077       for each buff-obj-list no-lock
     3078         where xtog-obj = false
     3079            or (buff-obj-list.obj-type = x-store-type
     3080               and buff-obj-list.obj-code = x-store-code
     3081               )
     3082       on error undo, return error
     3083       :
     3084       find last buff-stk-line no-lock
     3085         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3086           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3087           and buff-stk-line.artic      = x-artic
     3088           and buff-stk-line.prod-type  = x-prod-type
     3089           and buff-stk-line.prod-code  = x-prod-code
     3090           and buff-stk-line.sum-type   = x-sum-type
     3091           and buff-stk-line.cat-id     = '##,##':U
     3092           and buff-stk-line.fact-order <= x-fact-order
     3093           and buff-stk-line.shift-num  = 0
     3094         use-index category
     3095         no-error .
     3096       if available buff-stk-line then do:
     3097         assign
     3098           Quantity = Quantity + buff-stk-line.fact-qnty
     3099           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     3100           Coast_V  = Coast_V  + buff-stk-line.sum-base
     3101           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     3102           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     3103           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     3104           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     3105           other_R  = other_R  + buff-stk-line.other-rubl
     3106           other_V  = other_V  + buff-stk-line.other-base
     3107         .
     3108       end.
     3109    end.
     3110     end.
     3111     else do:
     3112       for each buff-obj-list no-lock
     3113         where xtog-obj = false
     3114            or (buff-obj-list.obj-type = x-store-type
     3115               and buff-obj-list.obj-code = x-store-code
     3116               )
     3117       on error undo, return error
     3118       :
     3119         find last buff-stk-line no-lock
     3120           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3121             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3122             and buff-stk-line.artic      = x-artic
     3123             and buff-stk-line.prod-type  = x-prod-type
     3124             and buff-stk-line.prod-code  = x-prod-code
     3125             and buff-stk-line.sum-type   = x-sum-type
     3126             and buff-stk-line.cat-id     = '##,##':U
     3127             and buff-stk-line.fact-order <= x-fact-order
     3128             and buff-stk-line.shift-num  > 0
     3129           use-index category
     3130           no-error .
     3131         if available buff-stk-line then do:
     3132           assign
     3133             Quantity = Quantity +  buff-stk-line.fact-qnty
     3134             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3135             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3136             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3137             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3138             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3139             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3140             other_R = other_R   +  buff-stk-line.other-rubl
     3141             other_V = other_V   +  buff-stk-line.other-base
     3142           .
     3143         end.
     3144       end.
     3145     end.
     3146   end procedure.
     3147   procedure ost-line-kg :
     3148     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     3149     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     3150     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     3151     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     3152     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     3153     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     3154     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     3155     define buffer buff-obj-list  for obj-list .
     3156     define buffer buf_doc-line for ub.doc-line .
     3157     define buffer buf_inv-line for ub.inv-line .
     3158     do
     3159     on error undo, return error
     3160     :
     3161       for each buf_doc-line no-lock where
     3162                buf_doc-line.obj-type    = p-obj-type   and
     3163                buf_doc-line.obj-code    = p-obj-code   and
     3164                buf_doc-line.prod-type   = p-prod-type  and
     3165                buf_doc-line.prod-code   = p-prod-code  and
     3166                buf_doc-line.artic       = p-artic      and
     3167                buf_doc-line.status_     = 'факт':U      and
     3168                buf_doc-line.fact-order <= p-fact-order
     3169             by buf_doc-line.fact-order    descending
     3170       :
     3171         find first buf_inv-line no-lock where
     3172                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     3173                    buf_inv-line.artic     = buf_doc-line.artic     and
     3174                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     3175                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     3176         if available buf_inv-line
     3177         then do:
     3178           if buf_inv-line.after-cli-qnty <> ?
     3179           then do:
     3180             assign
     3181               p-quantity-kg = buf_inv-line.after-cli-qnty
     3182             .
     3183             leave .
     3184           end.
     3185         end.
     3186       end.
     3187       if p-quantity-kg = ?
     3188       then do:
     3189         assign
     3190           p-quantity-kg = 0
     3191         .
     3192       end.
     3193     end.
     3194   end procedure.
     3195   PROCEDURE ostatok :
     3196   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     3197   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     3198   def input parameter x-tog-shift   as   logical             no-undo.
     3199   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     3200   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     3201   def input parameter x-shift-start as integer               no-undo.
     3202   def input parameter x-shift-end   as integer               no-undo.
     3203   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     3204   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     3205   def input parameter xTog-obj   as log no-undo.
     3206   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     3207   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     3208   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     3209   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     3210   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     3211   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     3212   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     3213   def var              Fact-orderS   as char  no-undo.
     3214   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     3215      Assign
     3216         Fact-order   = 0
     3217         Quantity     = 0
     3218         Coast_R      = 0
     3219         Coast_V      = 0
     3220         VAT_R        = 0
     3221         VAT_V        = 0 .
     3222    x-date-start-t  = x-date-start + 1 .
     3223   IF x-date-end = date('') then DO:
     3224      Fact-order = 0 .
     3225      for each obj-list
     3226          where  ( not xtog-obj or
     3227                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     3228                 no-lock :
     3229         if  x-tog-shift = false then do:
     3230                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3231                               ub.stk-tot.Fact-date <=  x-date-start
     3232                               and ub.stk-tot.shift-num = 0
     3233                               USE-INDEX fact-date no-lock no-error .
     3234              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3235         End.
     3236         Else  DO :
     3237             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3238              (ub.stk-tot.shift-date  = x-date-start-t and
     3239               ub.stk-tot.shift-num  < x-shift-start or
     3240               ub.stk-tot.shift-date  < x-date-start-t  )
     3241               and ub.stk-tot.shift-num  > 0
     3242               USE-INDEX Shift-num no-lock no-error .
     3243            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3244           END.
     3245       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3246     End.
     3247   End.
     3248   Else DO:
     3249     For each obj-list  WHERE
     3250        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     3251         no-lock :
     3252      IF  x-TOG-Shift = False Then DO:
     3253          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3254               ub.stk-tot.Fact-date <= x-date-end
     3255               and ub.stk-tot.shift-num = 0
     3256               USE-INDEX fact-date no-lock no-error.
     3257          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3258      END.
     3259      Else DO:
     3260           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3261               (ub.stk-tot.shift-date  = x-date-end and
     3262               ub.stk-tot.shift-num  <= x-shift-end or
     3263               ub.stk-tot.shift-date  < x-date-end       ) and
     3264               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3265               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3266       End.
     3267       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3268     End.
     3269   End.
     3270   END PROCEDURE.
     3271   PROCEDURE report-exec1  :
     3272      FIND FIRST clients where x-store-type = clients.obj-type AND
     3273                               x-store-code = clients.obj-code no-lock no-error.
     3274     run waitfram-show(clients.obj-name) .
     3275     run calcitog.
     3276     run print-header.
     3277      case retclassify :
     3278        when "grp-goods":u      then run run2.
     3279        otherwise do:
     3280          message "Ошибка вызова!"  view-as alert-box error .
     3281        end.
     3282      end case.
     3283     run print-footer.
     3284     END PROCEDURE.
     3285   PROCEDURE Calc-Sub-itog :
     3286   define input parameter tt as int no-undo.
     3287   define variable b as int no-undo.
     3288   if tt = 6  then Assign
     3289     B1-gds-zap-other = B1-gds-zap-other +  gds-zap-other
     3290     B2-gds-zap-other = B2-gds-zap-other +  gds-zap-other
     3291     Bi-gds-zap-other = Bi-gds-zap-other +  gds-zap-other
     3292     Bo-gds-zap-other = Bo-gds-zap-other +  gds-zap-other
     3293     .
     3294   repeat b = 1 to 3:
     3295     Assign
     3296     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     3297     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     3298     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     3299     Bo-Prih[b + TT]    = Bo-Prih[b + TT]    +  Prih[b + TT]
     3300     Bo-ostatok-start[b + TT]    = Bo-ostatok-start[b + TT]    +  ostatok-start[b + TT]
     3301     Bo-ostatok-end[b + TT]      = Bo-ostatok-end[b + TT]      +  ostatok-end[b + TT]
     3302     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     3303     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     3304     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     3305     Bo-RAsh[b + TT]    = Bo-RAsh[b + TT]    +  RAsh[b + TT]
     3306     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     3307     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     3308     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     3309     Bo-Kassa[b + TT]    = Bo-Kassa[b + TT]    +  Kassa[b + TT]
     3310     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     3311     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     3312     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     3313     Bo-Inv[b + TT]    = Bo-Inv[b + TT]    +  Inv[b + TT]
     3314     B1-Overturn[b + TT]    = B1-Overturn[b + TT]    +  Overturn[b + TT]
     3315     B2-Overturn[b + TT]    = B2-Overturn[b + TT]    +  Overturn[b + TT]
     3316     Bi-Overturn[b + TT]    = Bi-Overturn[b + TT]    +  Overturn[b + TT]
     3317     Bo-Overturn[b + TT]    = Bo-Overturn[b + TT]    +  Overturn[b + TT] .
     3318   End.
     3319   END PROCEDURE.
     3320   PROCEDURE Clear-item :
     3321   define variable kk as int no-undo.
     3322    gds-zap-other = 0 .
     3323    REPEAT kk = 1 to 9 :
     3324    Assign
     3325       prih            [kk]    = 0
     3326       rash            [kk]    = 0
     3327       kassa           [kk]    = 0
     3328       Inv             [kk]    = 0
     3329       Overturn        [kk]    = 0
     3330       ostatok-end     [kk]    = 0
     3331       ostatok-start   [kk]    = 0 .
     3332          End.
     3333    END PROCEDURE.
     3334   PROCEDURE Item-Goods :
     3335      define input parameter  par-3 as char no-undo.
     3336      define input parameter  par-4 as char no-undo.
     3337        if par-4 = "goods":U  Then DO:
     3338           assign
     3339               gds-zap-unit-base  = Goods.unit-base
     3340               gds-zap-prt-root   = Goods.prt-root
     3341               gds-zap-prod-type  = Goods.prod-type
     3342               gds-zap-prod-code  = Goods.prod-code
     3343               gds-zap-artic      = Goods.artic
     3344               gds-zap-grp-name   = Goods.grp-name
     3345               gds-zap-b-code     = Goods.gds-code
     3346               gds-zap-type       = Goods.gds-type.
     3347           if g#gds-engl then
     3348               assign gds-zap-gds-name = Goods.engl-name.
     3349           else
     3350               assign gds-zap-gds-name = Goods.gds-name.
     3351        End.
     3352        if par-4 = "gds-list":U  Then DO:
     3353           assign
     3354               gds-zap-unit-base  = gds-list.unit-base
     3355               gds-zap-prt-root   = gds-list.prt-root
     3356               gds-zap-prod-type  = gds-list.prod-type
     3357               gds-zap-prod-code  = gds-list.prod-code
     3358               gds-zap-artic      = gds-list.artic
     3359               gds-zap-grp-name   = gds-list.grp-name
     3360               gds-zap-b-code     = gds-list.gds-code
     3361               gds-zap-type       = gds-list.gds-type.
     3362           if g#gds-engl then
     3363               assign gds-zap-gds-name = gds-list.engl-name.
     3364           else
     3365               assign gds-zap-gds-name = gds-list.gds-name.
     3366        End.
     3367       run foreach.
     3368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3369     (input  gds-zap-b-code
     3370     ,input  ?
     3371     ,output v-bar-code
     3372     )  .
     3373   s-bar-code = string (v-bar-code,"999999999").
     3374       If  break_group = true  and par-3 <> "1"  then DO :
     3375            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3376            gds-zap-prod-name  = clients.obj-name.
     3377             If break_group1 = true  THEN  DO :
     3378               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3379                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3380                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3381               if par-3 = "6"  then  dO:
     3382                  if xTog-obj = true then do:
     3383                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3384                     .
     3385                   end.
     3386                  else do:
     3387                   var-vat-pc = temp-gds-list.vat-pc .
     3388                   end.
     3389                   assign
     3390                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3391                       b1-name = temp-str.
     3392                   end.
     3393               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3394                   fr0 = true .
     3395                   tmp#stroka0 = temp-str.
     3396               End.
     3397             End.
     3398               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3399                 if par-3 = "4"
     3400                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3401                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3402                 if NOT xSumsOnly THEN DO:
     3403                     fr = true .
     3404                 End.
     3405                 break_group1 = false.
     3406               END.
     3407          break_group = false.
     3408       End.
     3409       run display-line.
     3410    END PROCEDURE.
     3411   PROCEDURE Di :
     3412   define input parameter p1 as char no-undo.
