     2014   procedure run2sort1 :
     2015       case select-good :
     2016           when 1  then do:
     2017   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2018   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2019       for each gds-obj  where
     2020             gds-obj.obj-type = x-store-type  and
     2021             gds-obj.obj-code = x-store-code
     2022             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2023                   no-lock,
     2024             First goods  where  gds-obj.gds-code   = goods.gds-code
     2025   no-lock
     2026   BREAK
     2027         BY (gds-obj.grp-name)
     2028       BY (goods.artic) :
     2029         run item-goods ( "3" , "goods" ) .
     2030         if return-value <> "" then NEXT.
     2031           If Last-of(gds-obj.grp-name) Then Do:
     2032           If String(Entry(2,"gds-obj.grp-name",".")) = "Grp-name"
     2033             Then  Assign
     2034                     S-bar-code   = " Итого по "
     2035                     Gds-zap-artic = Substring(
     2036                                         B1-name
     2037                                         ,1,16)
     2038                     Gds-zap-gds-name = Substring(
     2039                                         B1-name
     2040                                         ,17,40)
     2041                                   .
     2042             Else  Assign
