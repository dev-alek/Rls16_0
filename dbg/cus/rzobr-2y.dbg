     1528           Sums-Only     = xSumsOnly
     1529           Show-Negativ  = xShowZero
     1530           Show-Negativ-2  = xShowZero-2
     1531           xShowCost     = Show-Cost
     1532           xShowSale     = Show-Sale
     1533           xShowcrsa     = Show-crsa
     1534           FirstLine     = FALSE
     1535           Line          = fill("-", 232)
     1536           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     1537        run report-execute.
     1538   PROCEDURE report-execute :
     1539   define variable gj as integer no-undo init 0.
     1540     If (ValType=0 and x-base-code=0)  Or ValType=1
     1541                                   then   assign tPrintRubl = yes .
     1542                                   else   assign tPrintRubl = no .
     1543     run waitfram-show( 'Подождите ...' ) .
     1544     if ReportPageHeight = 0 then ReportPageHeight  = 43.
     1545   output stream OutStream to value( string( session:temp-directory +
     1546                                        "rpt" + string( g#report-num ) ) )
     1547                                        page-size  value(ReportPageHeight) .
     1548     FIND FIRST clients where x-store-type = clients.obj-type AND
     1549                              x-store-code = clients.obj-code no-lock no-error.
     1550     If available clients then  ObjName = clients.obj-name.
     1551                                   else  ObjName="объект не определен".
     1552   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1553   form header
     1554     line format "X(194)" at 1 skip
     1555     "Продолжение - на следующей странице" at 30 skip
     1556     with frame bottomframe width 232 page-bottom no-labels no-box .
     1557   view stream outstream frame bottomframe .
     1558          FOR each obj-list no-lock:
     1559             x-store-type = obj-list.obj-type.
     1560             x-store-code = obj-list.obj-code.
     1561             gj = gj + 1.
     1562             run report-exec1.
     1563         End.
     1564         if gj > 1 then do:
     1565           HIDE stream OutStream FRAME BottomFrame .
     1566           run display-bo.
     1567           run u-line.
     1568         End.
     1569     HIDE stream OutStream FRAME BottomFrame .
     1570     HIDE   STREAM OutStream FRAME ZAPAS .
     1571     Output stream OutStream close.
     1572     run waitfram-hide .
     1573     if Make-Excel then output stream ForExcel close.
     1574     define variable v-user-action as character no-undo .
     1575     define variable v-printed as logical   no-undo .
     1576     define variable DisabledOptions as integer   no-undo .
     1577     define variable v-orient-page as character no-undo .
     1578     run How-name in this-procedure (
     1579         input ReportPageHeight,
     1580         input ReportPageWidth,
     1581         output v-orient-page )
     1582         .
     1583     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1584                                    else DisabledOptions = 0 .
     1585     run gbl/prnfilen.w
     1586       (input  ""
     1587       ,input  DisabledOptions
     1588       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1589       ,input  ReportFontNum
     1590       ,output v-user-action
     1591       ,output v-printed
     1592       ) .
     1593   END PROCEDURE.
     1594   PROCEDURE foreach :
     1595   If Integer(50) = 0 Then Temp1  = 100  .
     1596                         Else Temp1 = Integer(50) .
     1597        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     1598            RUN waitfram-show( "Обработано строк : " + string( i )) .
     1599     run clear-item.
     1600   run ost-line in this-procedure
     1601                  (input   x-store-code  ,
     1602                   input   x-store-type  ,
     1603                   input   gds-zap-artic     ,
     1604                   input   gds-zap-prod-code ,
     1605                   input   gds-zap-prod-type ,
     1606                   input   x-tog-shift       ,
     1607                   input   Fact-order-1               ,
     1608                   input   'cost':U            ,
     1609                   input   '##,##':U    ,
     1610                   input   xtog-obj    ,
     1611                   output  quantity    ,
     1612                   output  coast_r     ,
     1613                   output  coast_v     ,
     1614                   output  vat_r       ,
     1615                   output  vat_v       ,
     1616                   output  slt_r       ,
     1617                   output  slt_v       ).
     1618   assign
     1619     ostatok-start [1 + 0]   = quantity
     1620    ostatok-start [2 + 0]   = if tprintrubl then coast_r else coast_v
     1621    ostatok-start [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1622    b1-ostatok-start [1 + 0] =  b1-ostatok-start [1 + 0] + ostatok-start [1 + 0]
     1623    b1-ostatok-start [2 + 0] =  b1-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     1624    b1-ostatok-start [3 + 0] =  b1-ostatok-start [3 + 0] + ostatok-start [3 + 0]
     1625    b2-ostatok-start [1 + 0] =  b2-ostatok-start [1 + 0] + ostatok-start [1 + 0]
     1626    b2-ostatok-start [2 + 0] =  b2-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     1627    b2-ostatok-start [3 + 0] =  b2-ostatok-start [3 + 0] + ostatok-start [3 + 0]
     1628    .
     1629    assign
     1630     bi-ostatok-start [1 + 0] =  bi-ostatok-start [1 + 0] + ostatok-start [1 + 0]
     1631     bi-ostatok-start [2 + 0] =  bi-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     1632     bi-ostatok-start [3 + 0] =  bi-ostatok-start [3 + 0] + ostatok-start [3 + 0]
     1633    .
