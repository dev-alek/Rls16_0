      943         adm-object-hdl = FRAME F-Main:HANDLE.
      944   RUN ensure-broker.
      945   THIS-PROCEDURE:ADM-DATA =
      946        'ADM1.1~`':U +
      947        'SmartObject~`':U +
      948        '~`':U +
      949        'NO ~`':U +
      950        '~`':U +
      951        '~`':U +
      952        '~`':U +
      953        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      954           + "~`":U +
      955        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      956        'Record-Source,Record-Target,TableIO-Target~`':U +
      957        '~`':U +
      958        '~`~`~`~`~`~`~`~`~`~`~`':U +
      959        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      960            THEN "^^":U
      961        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      962             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      963   PROCEDURE adm-apply-entry :
      964     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      965   END PROCEDURE.
      966   PROCEDURE adm-destroy :
      967    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      968   END PROCEDURE.
      969   PROCEDURE adm-disable :
      970       DISABLE RECT-8 RECT-6 RECT-5 SortType Classify ShowZero Tog-Qnty ShowOrders BUTTON-grp month-1 month-2 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 tog-voz L-Grp-name WITH FRAME F-Main.
      971       RUN dispatch ('disable-fields':U).
      972       RUN set-attribute-list ('ENABLED=no':U).
      973       RETURN.
      974   END PROCEDURE.
      975   PROCEDURE adm-edit-attribute-list :
      976         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      977         RETURN.
      978   END PROCEDURE.
      979   PROCEDURE adm-enable :
      980       ENABLE UNLESS-HIDDEN RECT-8 RECT-6 RECT-5 SortType Classify ShowZero Tog-Qnty ShowOrders BUTTON-grp month-1 month-2 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 tog-voz L-Grp-name WITH FRAME F-Main.
      981       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      982       RUN set-attribute-list ('ENABLED=yes':U).
      983       RETURN.
      984   END PROCEDURE.
      985   PROCEDURE adm-exit :
      986        RUN notify ('exit':U).
      987     RETURN.
      988   END PROCEDURE.
      989   PROCEDURE adm-hide :
      990     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      991   END PROCEDURE.
      992   PROCEDURE adm-initialize :
      993     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      994   END PROCEDURE.
      995   PROCEDURE adm-show-errors :
      996       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      997       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      998           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      999       END.
     1000       RETURN.
     1001   END PROCEDURE.
     1002   PROCEDURE adm-UIB-mode :
     1003     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1004   END PROCEDURE.
     1005   PROCEDURE adm-view :
     1006     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1007   END PROCEDURE.
     1008   PROCEDURE dispatch :
     1009       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1010       RUN broker-dispatch IN adm-broker-hdl
     1011           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1012       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1013   END PROCEDURE.
     1014   PROCEDURE ensure-broker :
     1015   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1016   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1017   DO:
     1018       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1019       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1020   END.
     1021   END PROCEDURE.
     1022   PROCEDURE get-attribute :
     1023     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1024     RUN broker-get-attribute IN adm-broker-hdl
     1025         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1026     RETURN RETURN-VALUE.
     1027   END PROCEDURE.
     1028   PROCEDURE get-attribute-list :
     1029     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1030     RUN broker-get-attribute-list IN adm-broker-hdl
     1031         (INPUT THIS-PROCEDURE,
     1032          INPUT ?,
     1033          OUTPUT p-attr-list) NO-ERROR.
     1034     RETURN.
     1035   END PROCEDURE.
     1036   PROCEDURE new-state :
     1037     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1038     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1039     RETURN.
     1040   END PROCEDURE.
     1041   PROCEDURE notify :
     1042     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1043     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1044     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1045         RETURN "ADM-ERROR":U.
     1046     RETURN.
     1047   END PROCEDURE.
     1048   PROCEDURE set-attribute-list :
     1049     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1050     RUN ensure-broker.
     1051     RUN broker-set-attribute-list IN adm-broker-hdl
     1052         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1053     RETURN.
     1054   END PROCEDURE.
     1055   PROCEDURE set-position :
     1056       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1057       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1058       IF VALID-HANDLE(adm-object-hdl) THEN
     1059       DO:
     1060         ASSIGN adm-object-hdl:ROW    =   p-row
     1061                adm-object-hdl:COLUMN =   p-col.
     1062       END.
     1063       RETURN.
     1064   END PROCEDURE.
     1065   PROCEDURE adm-display-fields :
     1066       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1067       RETURN.
     1068   END PROCEDURE.
     1069   PROCEDURE adm-open-query :
     1070     RETURN.
     1071   END PROCEDURE.
     1072   PROCEDURE adm-row-changed :
     1073         IF VALID-HANDLE(adm-object-hdl) THEN
     1074           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1075         RUN notify ('row-available':U).
     1076         RETURN.
     1077   END PROCEDURE.
     1078   PROCEDURE reposition-query :
     1079       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1080       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1081       RETURN.
     1082   END PROCEDURE.
     1083     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1084     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1085     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1086     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1087     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1088     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1089     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1090     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1091     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1092     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1093     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1094     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1095     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1096     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1097     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1098     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1099     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1100     IF "":U = "":U THEN
     1101       RUN modify-list-attribute IN adm-broker-hdl
     1102         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1103     RUN use-create-on-add(?).
     1104   PROCEDURE adm-add-record :
     1105       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1106          "must have at least one Enabled Table to perform Add.":U
     1107          VIEW-AS ALERT-BOX ERROR.
     1108       RETURN.
     1109   END PROCEDURE.
     1110   PROCEDURE adm-assign-record :
     1111    MESSAGE
     1112          "Object ":U THIS-PROCEDURE:FILE-NAME
     1113            "must have at least one Enabled Table to perform Assign.":U
     1114              VIEW-AS ALERT-BOX ERROR.
     1115      RETURN.
     1116     END PROCEDURE.
     1117   PROCEDURE adm-assign-statement :
     1118     RETURN.
     1119   END PROCEDURE.
     1120   PROCEDURE adm-cancel-record :
     1121      RETURN.
     1122     END PROCEDURE.
     1123   PROCEDURE adm-copy-record :
     1124       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1125        "must have at least one Enabled Table to perform Copy.":U
     1126          VIEW-AS ALERT-BOX ERROR.
     1127       RETURN.
     1128   END PROCEDURE.
     1129   PROCEDURE adm-create-record :
     1130      RETURN.
     1131   END PROCEDURE.
     1132   PROCEDURE adm-current-changed :
     1133     RETURN.
     1134   END PROCEDURE.
     1135   PROCEDURE adm-delete-record :
     1136    MESSAGE
     1137          "Object ":U THIS-PROCEDURE:FILE-NAME
     1138            "must have at least one Enabled Table to perform Delete.":U
     1139              VIEW-AS ALERT-BOX ERROR.
     1140       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1141       RETURN.
     1142   END PROCEDURE.
     1143   PROCEDURE adm-disable-fields :
     1144         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1145       RETURN.
     1146   END PROCEDURE.
     1147   PROCEDURE adm-enable-fields :
     1148       RETURN.
     1149   END PROCEDURE.
     1150   PROCEDURE adm-end-update :
     1151     RETURN.
     1152   END PROCEDURE.
     1153   PROCEDURE adm-reset-record :
     1154       RETURN.
     1155   END PROCEDURE.
     1156   PROCEDURE adm-update-record :
     1157       MESSAGE
     1158         "Object ":U THIS-PROCEDURE:FILE-NAME
     1159           "must have at least one Enabled Table to perform Update.":U
     1160             VIEW-AS ALERT-BOX ERROR.
     1161      RETURN.
     1162   END PROCEDURE.
     1163   PROCEDURE check-modified :
     1164   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1165   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1166   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1167   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1168     IF check-state = "check":U THEN
     1169     DO:
     1170       RUN get-link-handle IN adm-broker-hdl
     1171         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1172            OUTPUT group-target-list).
     1173       IF group-target-list NE "":U THEN
     1174       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1175         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1176         RUN check-modified IN curr-widget ('group-check':U).
     1177         IF RETURN-VALUE NE "":U THEN
     1178         DO:
     1179           RUN check-modified-message(RETURN-VALUE).
     1180           RETURN "":U.
     1181         END.
     1182       END.
     1183     END.
     1184     RETURN "":U.
     1185   END PROCEDURE.
     1186   PROCEDURE check-modified-message :
     1187     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1188        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1189           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1190        IF RETURN-VALUE = "YES":U THEN
     1191           RUN notify ('view,CONTAINER-SOURCE':U).
     1192        MESSAGE IF p-changed-table NE ? THEN
     1193           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1194           ELSE "Current values have been changed."
     1195           SKIP "  Do you wish to save those changes?"
     1196           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1197        IF ANS THEN
     1198        DO:
     1199           IF group-assign-target THEN
     1200             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1201           ELSE RUN dispatch('update-record':U).
     1202           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1203           DO:
     1204               MESSAGE "Changes to the previous record were not saved."
     1205                 VIEW-AS ALERT-BOX ERROR.
     1206               IF group-assign-target THEN
     1207                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1208               ELSE RUN dispatch ('cancel-record':U).
     1209           END.
     1210        END.
     1211        ELSE DO:
     1212          IF group-assign-target THEN
     1213             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1214          ELSE RUN dispatch('cancel-record':U).
     1215        END.
     1216        RETURN.
     1217   END PROCEDURE.
     1218   PROCEDURE get-rowid :
     1219       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1220       ASSIGN
     1221       p-table   =   adm-first-table.
     1222       RETURN.
     1223   END PROCEDURE.
     1224   PROCEDURE init-group-assign :
     1225       RUN request-attribute IN adm-broker-hdl
     1226         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1227       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1228         group-assign-target = yes.
     1229       ELSE group-assign-target = no.
     1230       RETURN.
     1231   END PROCEDURE.
     1232   PROCEDURE set-editors :
     1233       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1234       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1235       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1236       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1237       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1238       DO WHILE VALID-HANDLE (curr-widget):
     1239           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1240              curr-widget:HIDDEN = no THEN DO:
     1241             CASE p-field-setting:
     1242               WHEN "INITIALIZE":U THEN
     1243               DO:
     1244                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1245                     read-only-list +
     1246                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1247                        STRING(curr-widget).
     1248               END.
     1249               WHEN "DISABLE":U OR
     1250               WHEN "ENABLE":U THEN
     1251               DO:
     1252                   curr-widget:SENSITIVE = yes.
     1253                   RUN get-attribute ('Read-Only-Editors':U).
     1254                   IF RETURN-VALUE = ? OR
     1255                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1256                       curr-widget:READ-ONLY =
     1257                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1258               END.
     1259               WHEN "CLEAR":U THEN
     1260                   curr-widget:SCREEN-VALUE = "":U.
     1261             END CASE.
     1262           END.
     1263           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1264       END.
     1265       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1266         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1267           + '"':U).
     1268       RETURN.
     1269   END PROCEDURE.
     1270   PROCEDURE use-check-modified-all :
     1271    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1272     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1273     RETURN.
     1274   END PROCEDURE.
     1275   PROCEDURE use-create-on-add :
     1276   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1277      RETURN.
     1278   END PROCEDURE.
     1279   PROCEDURE use-initial-lock :
     1280     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1281     ASSIGN adm-initial-lock = p-attr-value.
     1282     RETURN.
     1283   END PROCEDURE.
     1284     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1285   ASSIGN
     1286          FRAME F-Main:SCROLLABLE       = FALSE
     1287          FRAME F-Main:HIDDEN           = TRUE.
     1288   ON CHOOSE OF BUTTON-grp IN FRAME F-Main
     1289   DO:
     1290     run ref/cli-grps.w
     1291       ( input my-handle, "b-sel", input-output cli-recids ).
     1292     Find first ub.cli-grp where recid(ub.cli-grp) = integer(cli-recids) no-lock no-error.
     1293      if ub.cli-grp.upper-code=0 then DO:
     1294         Message "Нельзя выбирать корневую группу !!!" view-as alert-box error.
     1295         Return no-apply.
     1296      End.
     1297     l-grp-name = "".
     1298     run cli-grplib-get-full-name in this-procedure (input ub.cli-grp.node-code, output l-grp-name).
     1299     Display l-grp-name with frame F-Main .
     1300   END.
     1301   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1302   DO:
     1303       Assign Classify.
     1304      if Classify = "grp-goods":U
     1305            Then do:
     1306               display TOG-lavel   with frame F-Main .
     1307               enable  TOG-lavel   with frame F-Main .
     1308           end.
     1309            Else do:
     1310               display  TOG-lavel  var-Lavel with frame F-Main .
     1311               disable  TOG-lavel  var-Lavel with frame F-Main .
     1312           end.
     1313   END.
     1314   ON VALUE-CHANGED OF ShowOrders IN FRAME F-Main
     1315   DO:
     1316     assign showorders.
     1317     if showorders = true then DO:
     1318     disable week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52
     1319        with frame F-Main.
     1320     End.
     1321     Else DO:
     1322       enable week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52
     1323        with frame F-Main.
     1324   end.
     1325   display  week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52
     1326        with frame F-Main.
     1327   END.
     1328   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1329   DO:
     1330      Assign tog-lavel.
     1331     if tog-lavel =TRUE
     1332           Then do:
     1333               display  var-Lavel  with frame F-Main .
     1334               enable   var-Lavel  with frame F-Main .
     1335           end.
     1336            Else do:
     1337               TOG-lavel = false.
     1338               display    var-Lavel with frame F-Main .
     1339               disable    var-Lavel with frame F-Main .
     1340           end.
     1341   END.
     1342   ON VALUE-CHANGED OF Tog-Qnty IN FRAME F-Main
     1343   DO:
     1344    define variable ret# as log no-undo.
     1345     Assign tog-QNTY.
     1346     if tog-QNTY =TRUE
     1347           Then do:
     1348               display  bsAmount  with frame F-Main .
     1349               enable   bsAmount  with frame F-Main .
     1350               Ret# = Sorttype:Disable(Entry(1,Sorttype:radio-buttons)).
     1351               Ret# = Sorttype:Disable(Entry(3,Sorttype:radio-buttons)).
     1352           end.
     1353            Else do:
     1354               display    bsAmount with frame F-Main .
     1355               disable    bsAmount with frame F-Main .
     1356               Ret# = Sorttype:enable(Entry(1,Sorttype:radio-buttons)).
     1357               Ret# = Sorttype:enable(Entry(3,Sorttype:radio-buttons)).
     1358           end.
     1359   END.
     1360   if not this-procedure :persistent
     1361   then do:
     1362     message
     1363       vss-workfile vss-revision vss-description skip
     1364       "Ошибка при запуске процедуры" skip
     1365       "Данную процедуру следует запускать только с параметром persistent" skip
     1366       view-as alert-box error .
     1367     undo, return error .
     1368   end.
     1369   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1370   on ' ' of month-1, month-2, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1371   do:
     1372     if (can-query (self, "sensitive")
     1373        and
     1374        self :sensitive = true
     1375        )
     1376     or (can-query (self, "read-only")
     1377        and
     1378        self :read-only = false
     1379        )
     1380     then do:
     1381       assign
     1382         self :screen-value = ?
     1383       .
     1384     end.
     1385     return no-apply.
     1386   end.
     1387   on delete-character of month-1, month-2, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1388   do:
     1389     if (can-query (self, "sensitive")
     1390        and
     1391        self :sensitive = true
     1392        )
     1393     or (can-query (self, "read-only")
     1394        and
     1395        self :read-only = false
     1396        )
     1397     then do:
     1398       assign
     1399         self :screen-value = ?
     1400       .
     1401     end.
     1402     return no-apply.
     1403   end.
     1404   on ctrl-d of month-1, month-2, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1405   do:
     1406     define variable v-curr-sv-date as date no-undo .
     1407     if (can-query (self, "sensitive")
     1408        and
     1409        self :sensitive = true
     1410        )
     1411     or (can-query (self, "read-only")
     1412        and
     1413        self :read-only = false
     1414        )
     1415     then do:
     1416       if self :handle <> focus :handle
     1417       then do:
     1418         apply "entry":u to self .
     1419       end.
     1420       run gbl/getcurdt.p
     1421         (output v-curr-sv-date
     1422         ) .
     1423       assign
     1424         self :screen-value = string(v-curr-sv-date) .
     1425       .
     1426     end.
     1427     return no-apply.
     1428   end.
     1429   on ctrl-b of month-1, month-2, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1430   do:
     1431     if (can-query (self, "sensitive")
     1432        and
     1433        self :sensitive = true
     1434        )
     1435     or (can-query (self, "read-only")
     1436        and
     1437        self :read-only = false
     1438        )
     1439     then do:
     1440       if self :handle <> focus :handle
     1441       then do:
     1442         apply "entry":u to self .
     1443       end.
     1444       define variable v-curr-sv-date as date no-undo .
     1445       define variable v-new-sv-date  as date no-undo .
     1446       assign
     1447         v-curr-sv-date = date(self :screen-value) no-error
     1448       .
     1449       if v-curr-sv-date = ?
     1450       then do:
     1451         run gbl/getcurdt.p
     1452           (output v-curr-sv-date
     1453           ) .
     1454       end.
     1455       if v-curr-sv-date <> ?
     1456       then do:
     1457         assign
     1458           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1459         .
     1460         assign
     1461           self :screen-value = string(v-new-sv-date) .
     1462         .
     1463       end.
     1464     end.
     1465     return no-apply .
     1466   end.
     1467   on ctrl-e of month-1, month-2, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1468   do:
     1469     if (can-query (self, "sensitive")
     1470        and
     1471        self :sensitive = true
     1472        )
     1473     or (can-query (self, "read-only")
     1474        and
     1475        self :read-only = false
     1476        )
     1477     then do:
     1478       if self :handle <> focus :handle
     1479       then do:
     1480         apply "entry":u to self .
     1481       end.
     1482       define variable v-curr-sv-date as date no-undo .
     1483       define variable v-new-sv-date  as date no-undo .
     1484       assign
     1485         v-curr-sv-date = date(self :screen-value) no-error
     1486       .
     1487       if v-curr-sv-date = ?
     1488       then do:
     1489         run gbl/getcurdt.p
     1490           (output v-curr-sv-date
     1491           ) .
     1492       end.
     1493       if v-curr-sv-date <> ?
     1494       then do:
     1495         run gbl/lastdate.p
     1496           (input  v-curr-sv-date
     1497           ,output v-new-sv-date
     1498           ).
     1499         assign
     1500           self :screen-value = string(v-new-sv-date) .
     1501         .
     1502       end.
     1503     end.
     1504     return no-apply .
     1505   end.
     1506   on ctrl-f of month-1, month-2, week-1, week-12, week-2, week-22, week-3, week-32, week-4, week-42, week-5, week-52 in frame F-Main
     1507   do:
     1508     if (can-query (self, "sensitive")
     1509        and
     1510        self :sensitive = true
     1511        )
     1512     or (can-query (self, "read-only")
     1513        and
     1514        self :read-only = false
     1515        )
     1516     then do:
     1517       if self :handle <> focus :handle
     1518       then do:
     1519         apply "entry":u to self .
     1520       end.
     1521       define variable v-ok            as logical   no-undo .
     1522       define variable v-curr-sv-date  as date      no-undo .
     1523       define variable v-description   as character no-undo .
     1524       assign
     1525         v-curr-sv-date = date(self :screen-value) no-error
     1526       .
     1527       if v-curr-sv-date = ?
     1528       then do:
     1529         run gbl/getcurdt.p
     1530           (output v-curr-sv-date
     1531           ) .
     1532       end.
     1533       if v-curr-sv-date <> ?
     1534       then do:
     1535         run gbl/d-inpday.w
     1536           (input ?
     1537           ,input "Выбор даты"
     1538           ,input v-description
     1539           ,input ""
     1540           ,input-output v-curr-sv-date
     1541           ,output v-ok
     1542           ).
     1543         if v-ok = true
     1544         then do:
     1545           assign
     1546             self :screen-value = string(v-curr-sv-date) .
     1547           .
     1548         end.
     1549       end.
     1550     end.
     1551     return no-apply .
     1552   end.
     1553   PROCEDURE disable_UI :
     1554     HIDE FRAME F-Main.
     1555     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1556   END PROCEDURE.
     1557   PROCEDURE find-fo :
     1558   def input  parameter date1 as date no-undo.
     1559   def input  parameter date2 as date no-undo.
     1560   def output parameter f-1   like ub.ot-line.fact-order no-undo.
     1561   def output parameter f-2   like ub.ot-line.fact-order no-undo.
     1562      Assign f-1 = Integer(date1 - 1 ) + 0.99  f-2 = Integer(date2) + 0.99 .
     1563   END PROCEDURE.
     1564   PROCEDURE local-initialize :
     1565     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1566     hide TOG-lavel   in frame F-Main .
     1567     hide var-Lavel in frame F-Main .
     1568   END PROCEDURE.
     1569   PROCEDURE my-report :
     1570   if classify = "no-classify":U then do:
     1571      run cus/r-benet2.p
     1572         (input v-cntxt-obj-code, input v-cntxt-obj-type, input base-type , input base-code , input Classify  , input SortType  , input false     , input ShowZero  , input False     , input false     , input false     , input tog-lavel , input var-lavel , input fo0  , input fo02 , input fo1  , input fo12 , input fo2  , input fo22 , input fo3  , input fo32 , input fo4  , input fo42 , input fo5  , input fo52 , input Tog-Qnty, input bsamount, input v-cntxt-host-code-obj, input tog-voz, input ShowOrders, input Number-Orders) .
     1573   End.
     1574   Else do:
     1575      run cus/r-bene22.p
     1576      (input v-cntxt-obj-code, input v-cntxt-obj-type, input base-type , input base-code , input Classify  , input SortType  , input false     , input ShowZero  , input False     , input false     , input false     , input tog-lavel , input var-lavel , input fo0  , input fo02 , input fo1  , input fo12 , input fo2  , input fo22 , input fo3  , input fo32 , input fo4  , input fo42 , input fo5  , input fo52 , input Tog-Qnty, input bsamount, input v-cntxt-host-code-obj, input tog-voz, input ShowOrders, input Number-Orders) .
     1577   End.
     1578   END PROCEDURE.
     1579   PROCEDURE my-var :
     1580   define variable v-check-date as date      no-undo .
     1581     define variable v-archive-ok as logical   no-undo .
     1582     define variable v-comment    as character no-undo .
     1583     define variable v-can-print  as logical   no-undo .
     1584     define variable M as int no-undo.
     1585     define variable Str-ret as char no-undo.
     1586     define variable Str-ECL as char no-undo.
     1587     define variable Str-ECL-empty as char no-undo.
     1588     define variable Str-size as char no-undo.
     1589   define variable Number-Orders-empty as character no-undo .
     1590   define variable Sizes_ as character no-undo .
     1591   sheetf.Sizes = "" .
     1592   assign frame F-Main  ShowZero tog-qnty bsamount ShowOrders
     1593   tog-lavel var-lavel Classify SortType tog-voz l-grp-name
     1594   month-1
     1595   month-2
     1596   week-1
     1597   week-12
     1598   week-2
     1599   week-22
     1600   week-3
     1601   week-32
     1602   week-4
     1603   week-42
     1604   week-5
     1605   week-52
     1606   .
     1607   if
     1608   month-1 = ? OR
     1609   month-2 = ? OR
     1610   week-1  = ? OR
     1611   week-12 = ? OR
     1612   week-2  = ? OR
     1613   week-22 = ? OR
     1614   week-3  = ? OR
     1615   week-32 = ? OR
     1616   week-4  = ? OR
     1617   week-42 = ? OR
     1618   week-5  = ? OR
     1619   week-52 = ?  THEN DO:
     1620        MEssage 'Не заданы интервалы просмотра реализации ! ' view-as alert-box error.
     1621        RETURN 'Second-page':U  . End.
     1622   Assign
     1623    STR-obj-type = ''
     1624    STR-obj-code = ''
     1625    STR-obj-name = ''
     1626    STR-obj      = ''.
     1627    for each TEmp#obj-list share-lock:
     1628        Delete TEmp#obj-list.
     1629    End.
     1630   For each obj-list no-lock:
     1631   find first ub.clients where
     1632         ub.clients.obj-type = obj-list.obj-type AND
     1633         ub.clients.obj-code = obj-list.obj-code no-lock no-error.
     1634    if  ub.clients.grp-name begins l-grp-name Then
     1635        DO:
     1636        Create TEmp#obj-list.
     1637        Assign TEmp#obj-list.obj-type = obj-list.obj-type
     1638               TEmp#obj-list.obj-code = obj-list.obj-code
     1639               TEmp#obj-list.obj-name = ub.clients.obj-name
     1640               TEmp#obj-list.grp-name = ub.clients.grp-name
     1641               STR-obj = STR-obj +  TEmp#obj-list.obj-type + '#' + string(TEmp#obj-list.obj-code)  + ',' .
     1642        End.
     1643   End.
     1644       M = 0. For each TEmp#obj-list no-lock : M = M + 1. End.
     1645       if M < 1 THEN DO:
     1646         Message "В группе " +  CAPS(l-grp-name) + " нет доступных объектов !" view-as alert-box error.
     1647         RETURN 'Second-page':U.
     1648         End.
     1649   ReportNAme = "Д В И Ж Е Н И Е   Т О В А Р А - С В О Д Н Ы Й   О Т Ч Е Т".
     1650   def var t-class as char no-undo.
     1651   def var t-sort as char no-undo.
     1652     case classify:
     1653       when "no-classify":u    then t-class =   "Без классификации" .
     1654       when "prod":u           then t-class =   "Производители"   .
     1655       when "post":u           then t-class =   "Поставщики"   .
     1656       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1657       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1658       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1659       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1660       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1661       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1662       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1663       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1664       when  "t-level":u       then t-class =   "Терминальные группы" .
     1665    end case.
     1666     case sorttype:
     1667       when "sort-pp":u               then t-sort =   "по порядку" .
     1668       when "sort-code":u             then t-sort =   "по коду" .
     1669       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1670       when "sort-qunty":u            then t-sort =   "по реализации".
     1671       when "sort-name":u             then t-sort =   "по наименованию".
     1672       when "sort-type":u             then t-sort =   "по типу ткани".
     1673       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1674       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1675    end case.
     1676   ReportHeader = "Классификация : " + t-Class.
     1677   ReportHeader = ReportHeader +
     1678                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     1679   ReportHeader = ReportHeader +
     1680                  (if tog-voz  then  chr(10) +  "Включая  " + 'возврат внешний':U  else " "    ).
     1681   ReportHeader = ReportHeader  + chr(10).
     1682   ReportHeader = ReportHeader  + "Интервалы реализации :" + chr(10).
     1683   ReportHeader = ReportHeader  + if month-1 <> DATE('') THEN  " Месяц с " + String(month-1,"99/99/9999")            ELSE "" .
     1684   ReportHeader = ReportHeader  + if month-2 <> DATE('')   THEN  " по " + String(month-2,"99/99/9999")      + chr(10) ELSE "" .
     1685   If Showorders = false then DO:
     1686       ReportHeader = ReportHeader  + if week-1  <> DATE('')   THEN  " 1я неделя " + String(week-1,"99/99/9999")          ELSE ""  .
     1687       ReportHeader = ReportHeader  + if week-12 <> DATE('')   THEN  " по " + String(week-12,"99/99/9999")      + chr(10) ELSE ""  .
     1688       ReportHeader = ReportHeader  + if week-2  <> DATE('')   THEN  " 2я неделя " + String(week-2,"99/99/9999")          ELSE ""  .
     1689       ReportHeader = ReportHeader  + if week-22 <> DATE('')   THEN  " по " + String(week-22,"99/99/9999")      + chr(10) ELSE ""  .
     1690       ReportHeader = ReportHeader  + if week-3  <> DATE('')   THEN  " 3я неделя " + String(week-3,"99/99/9999")          ELSE ""  .
     1691       ReportHeader = ReportHeader  + if week-32 <> DATE('')   THEN  " по " + String(week-32,"99/99/9999")      + chr(10) ELSE ""  .
     1692       ReportHeader = ReportHeader  + if week-4  <> DATE('')   THEN  " 4я неделя " + String(week-4,"99/99/9999")          ELSE ""  .
     1693       ReportHeader = ReportHeader  + if week-42 <> DATE('')   THEN  " по " + String(week-42,"99/99/9999")      + chr(10) ELSE ""  .
     1694       ReportHeader = ReportHeader  + if week-5  <> DATE('')   THEN  " 5я неделя " + String(week-5,"99/99/9999")          ELSE ""  .
     1695       ReportHeader = ReportHeader  + if week-52 <> DATE('')   THEN  " по " + String(week-52,"99/99/9999")      + chr(10) ELSE "" .
     1696    end.
     1697   ReportHeader = ReportHeader +
     1698                  "Сортировка " + t-Sort + chr(10) +
     1699                  "Показать : " +
     1700                  (if ShowZero     then "Показывать нулевые заказы "  else "Не показывать нулевые заказы" ) .
     1701   ReportHeader = ReportHeader +
     1702                  (if Showorders   then "   Показать подробно заказы   "     else "" ) .
     1703   ReportHeader = ReportHeader +
     1704                  (if Tog-Qnty    then "   Показать первые   "   + StrinG(BsAmount) +  " товаров с максимальной среднесуточной реализацией "  else "" ) .
     1705    assign
     1706      v-check-date = MAXIMUM( month-1 ,
     1707                         month-2 ,
     1708                         week-1  ,
     1709                         week-12 ,
     1710                         week-2  ,
     1711                         week-22 ,
     1712                         week-3  ,
     1713                         week-32 ,
     1714                         week-4  ,
     1715                         week-42 ,
     1716                         week-5  ,
     1717                         week-52 ).
     1718     run rep/chk-ahz.p
     1719       (input        v-cntxt-obj-type
     1720       ,input        v-cntxt-obj-code
     1721       ,input        false
     1722       ,input        true
     1723       ,input        false
     1724       ,input        false
     1725       ,input        true
     1726       ,input        v-cntxt-db-num
     1727       ,input        v-cntxt-userid
     1728       ,input-output v-check-date
     1729       ,input-output v-check-date
     1730       ,output       v-archive-ok
     1731       ,output       v-comment
     1732       ,output       v-can-print
     1733       ).
     1734    run find-fo (input month-1,input month-2  ,output fo0, output fo02).
     1735    run find-fo (input week-1, input week-12  ,output fo1, output fo12).
     1736    run find-fo (input week-2, input week-22  ,output fo2, output fo22).
     1737    run find-fo (input week-3, input week-32  ,output fo3, output fo32).
     1738    run find-fo (input week-4, input week-42  ,output fo4, output fo42).
     1739    run find-fo (input week-5, input week-52  ,output fo5, output fo52).
     1740    Str-ECL = 'Все,'.
     1741    Str-ECL-empty = ''.
     1742       For each Temp#obj-list break by Temp#obj-list.grp-name:
     1743           if last-of (Temp#obj-list.grp-name) THEN DO:
     1744           Str-ret = Str-ret + SUBSTRING(Entry(Num-entries(right-trim(Temp#obj-list.grp-name, chr(47)), chr(47)),Temp#obj-list.grp-name, chr(47)),1,3) + '. - ':U + Temp#obj-list.grp-name + chr(10).
     1745           Str-ECL = Str-ECL + SUBSTRING(Entry(Num-entries(right-trim(Temp#obj-list.grp-name, chr(47)), chr(47)),Temp#obj-list.grp-name, chr(47)),1,3) + '.,':U.
     1746           Str-ECL-empty = Str-ECL-empty  + ',':U.
     1747           Str-size = Str-size + '12,':U.
     1748           END.
     1749       End.
     1750    Str-ECL = TRIM(Str-ECL,",").
     1751   ReportHeader = ReportHeader + chr(10) +  "Группы объектов : " + chr(10) +  Str-ret.
     1752   If Showorders = false then DO:
     1753         sheetf.Excel-Column-Lable = " №, Артикул, Заказ, Центр. склад, Приход,"  + Str-ECL-empty .
     1754         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Остаток," + Str-ECL-empty .
     1755         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Реализ. Среднесуточная, Касса за месяц, " + Str-ECL-empty .
     1756         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Касса за 1ю неделю , " + Str-ECL-empty .
     1757         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Касса за 2ю неделю , " + Str-ECL-empty .
     1758         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Касса за 3ю неделю , " + Str-ECL-empty .
     1759         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Касса за 4ю неделю , " + Str-ECL-empty .
     1760         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Касса за 5ю неделю , " + Str-ECL-empty .
     1761         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + chr(10) + ",,,," + Str-ECL .
     1762         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "," + Str-ECL .
     1763         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",," + Str-ECL .
     1764         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "," + Str-ECL .
     1765         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "," + Str-ECL .
     1766         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "," + Str-ECL .
     1767         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "," + Str-ECL .
     1768         sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "," + Str-ECL + ",." .
     1769         sheetf.Sizes = '5,20,10,10,10,' + Str-size.
     1770         sheetf.Sizes = Sizes +  '10,' + Str-size.
     1771         sheetf.Sizes = Sizes +  '16,10,' + Str-size.
     1772         sheetf.Sizes = Sizes +  '10,' + Str-size.
     1773         sheetf.Sizes = Sizes +  '10,' + Str-size.
     1774         sheetf.Sizes = Sizes +  '10,' + Str-size.
     1775         sheetf.Sizes = Sizes +  '10,' + Str-size.
     1776         sheetf.Sizes = Sizes +  '10,' + Str-size + '12,,'.
     1777    End.
     1778    Else DO:
     1779         Number-Orders = "" .
     1780         Number-Orders-empty = "".
     1781              For each ub.trn-doc where
     1782                     ub.trn-doc.doc-date <= x-date-end
     1783               AND   ub.trn-doc.doc-date >= x-date-start
     1784               AND   ub.trn-doc.status_   = 'запрос':U
     1785               AND   ub.trn-doc.internal  = false
     1786               and can-find( first obj-list where ub.trn-doc.obj-code = obj-list.obj-code and
     1787                             ub.trn-doc.obj-type = obj-list.obj-type no-lock  )
     1788               no-lock :
     1789                     Number-Orders = Number-orders +  ub.trn-doc.doc-code  + ",".
     1790                     Number-Orders-empty = Number-Orders-empty + ",".
     1791                     Sizes_ = sizes_ + "15," .
     1792             End.
     1793       sheetf.Excel-Column-Lable = " №, Артикул, Cуммарный Заказ, Центральный склад, Приход,"  + Str-ECL-empty .
     1794       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Остаток," + Str-ECL-empty .
     1795       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Реализ. Среднесуточная, Касса за месяц, " + Str-ECL-empty .
     1796       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + " Заказы детально " + Number-Orders-empty .
     1797       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + chr(10) + ",,,," + Str-ECL .
     1798       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "," + Str-ECL .
     1799       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",," + Str-ECL  .
     1800       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "," + Number-Orders + ".".
     1801       sheetf.Sizes = '5,20,10,10,10,' + Str-size.
     1802       sheetf.Sizes = Sizes + '10,'    + Str-size.
     1803       sheetf.Sizes = Sizes + '16,10,' + Str-size.
     1804       sheetf.Sizes = Sizes + '10,'    + sizes_     .
     1805    End.
     1806   END PROCEDURE.
     1807   PROCEDURE state-changed :
     1808     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1809     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1810     define variable nn as int no-undo.
     1811     define variable ret# as log no-undo.
     1812     CASE p-state:
     1813     END CASE.
     1814   if month-1 = ? THEN   month-1 = DAte(month(x-Date-Start ),1,year(x-Date-Start )).
     1815   if month-2 = ? THEN   DO:
     1816       month-2 = x-Date-Start  .
     1817       run gbl/lastdate.p
     1818         (input  month-2
     1819         ,output month-2  ).
     1820       End.
     1821   NN = Weekday(DAte(month(month-1 ),1,year(month-1)))  .
     1822   if week-1  = ? THEN   week-1  = month-1 + (2 - NN)                             .
     1823   if week-12 = ? THEN   week-12 = week-1 +  6                                  .
     1824   if week-2  = ? THEN   week-2  = week-12 + 1                                  .
     1825   if week-22 = ? THEN   week-22 = week-2  + 6                                  .
     1826   if week-3  = ? THEN   week-3  = week-22 + 1                                  .
     1827   if week-32 = ? THEN   week-32 = week-3  + 6                                  .
     1828   if week-4  = ? THEN   week-4  = week-32 + 1                                  .
     1829   if week-42 = ? THEN   week-42 = week-4  + 6                                  .
     1830   if week-5  = ? THEN   week-5  = week-42 + 1                                  .
     1831   if week-52 = ? THEN   week-52 = week-5 + 6                                   .
     1832   if date(month-1:screen-value in frame F-Main) <> ? then
     1833    assign frame F-Main
     1834   month-1
     1835   month-2
     1836   week-1
     1837   week-12
     1838   week-2
     1839   week-22
     1840   week-3
     1841   week-32
     1842   week-4
     1843   week-42
     1844   week-5
     1845   week-52
     1846   .
     1847   display month-1 month-2 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     1848     if tog-QNTY =TRUE
     1849           Then do:
     1850               Ret# = Sorttype:Disable(Entry(1,Sorttype:radio-buttons)).
     1851               Ret# = Sorttype:Disable(Entry(3,Sorttype:radio-buttons)).
     1852           end.
     1853            Else do:
     1854               Ret# = Sorttype:enable(Entry(1,Sorttype:radio-buttons)).
     1855               Ret# = Sorttype:enable(Entry(3,Sorttype:radio-buttons)).
     1856           end.
     1857   END PROCEDURE.
