      678   procedure cli-grplib-get-full-name :
      679      define input parameter  p-node-code  as integer      no-undo.
      680      define output parameter p-full-name as character    no-undo.
      681   do
      682   on error undo, return error
      683   :
      684       define variable v-upper-code    as integer           no-undo.
      685       define buffer buf_cli-grp       for ub.cli-grp.
      686       define buffer buf_upper_cli-grp for ub.cli-grp.
      687       find first buf_cli-grp no-lock
      688            where buf_cli-grp.node-code = p-node-code
      689       no-error.
      690       if not available buf_cli-grp
      691       then do:
      692           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      693       end.
      694       assign
      695           p-full-name  = ""
      696           v-upper-code = 1
      697       .
      698       do while buf_cli-grp.upper-code <> 0
      699       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      700       :
      701           assign
      702               p-full-name  = buf_cli-grp.node-name
      703                            + (if p-full-name <> "" then chr(47) else "")
      704                            + p-full-name
      705               v-upper-code = buf_cli-grp.upper-code
      706           .
      707           find first buf_cli-grp no-lock
      708                where buf_cli-grp.node-code = v-upper-code
      709           no-error.
      710           if not available buf_cli-grp
      711           then do:
      712               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      713                                   + string( v-upper-code )
      714                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      715           end.
      716       end.
      717       assign
      718       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      719       .
      720   end.
      721   end .
      722   procedure cgrplib-get-node-from-full-name :
      723   define input parameter p-full-name as character no-undo .
      724   define output parameter p-node-code as integer no-undo .
      725   define variable v-ii as integer no-undo .
      726   define variable v-upper-code as integer no-undo .
      727   define variable v-root-code as integer no-undo .
      728   define variable v-entry as character no-undo .
      729   define buffer buf_cli-grp       for ub.cli-grp.
      730   do
      731   on error undo, return error
      732   :
      733     find first buf_cli-grp no-lock
      734         where buf_cli-grp.upper-code = 0
      735     no-error .
      736     if not available buf_cli-grp
      737     then do:
      738         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      739     end.
      740     else do:
      741       assign
      742       v-root-code = buf_cli-grp.node-code
      743       .
      744     end.
      745     v-upper-code = v-root-code.
      746     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      747       assign
      748       v-entry = entry(v-ii, p-full-name, chr(47)).
      749       if v-entry = '' then leave.
      750       find first buf_cli-grp no-lock where
      751                 buf_cli-grp.node-name = v-entry
      752             and buf_cli-grp.upper-code = v-upper-code
      753             no-error.
      754       if not available buf_cli-grp then do:
      755         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      756       end.
      757       else do:
      758         p-node-code = buf_cli-grp.node-code.
      759         v-upper-code = buf_cli-grp.node-code.
      760       end.
      761     end.
      762   end.
      763   end .
