      926   function cross-list returns logical (
      927     input parfirst-stream  as character,
      928     input parsecond-stream as character,
      929     input pardelim         as character).
      930     if pardelim = ""
      931     or pardelim = ?
      932     then do:
      933       assign
      934         pardelim = ","
      935       .
      936     end.
      937     define variable vari            as integer no-undo .
      938     define variable varresult-cross as logical no-undo .
      939     assign
      940       varresult-cross = no
      941     .
      942     def var v-num-parfirst-stream as integer no-undo .
      943     assign
      944       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      945     .
      946     do vari = 1 to v-num-parfirst-stream
      947     :
      948       if lookup(entry(vari, parfirst-stream, pardelim)
      949                ,parsecond-stream
      950                ,pardelim
      951                ) > 0 then do:
      952         assign
      953           varresult-cross = yes
      954         .
      955         leave.
      956       end.
      957     end.
      958     return varresult-cross .
      959   end function.
      960   define new global shared variable g#lib-trn  as handle no-undo .
