     2008   procedure last-price :
     2009   do on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)):
     2010   define input parameter  p-host-code     as integer no-undo .
     2011   define input parameter  p-artic         like ub.doc-line.artic  no-undo .
     2012   define input parameter  p-prod-type     like ub.doc-line.prod-type  no-undo .
     2013   define input parameter  p-prod-code     like ub.doc-line.prod-code  no-undo .
     2014   define input parameter  p-cli-code      like ub.ord-doc.cli-code  no-undo .
     2015   define input parameter  p-cli-type      like ub.ord-doc.cli-type  no-undo .
     2016   define input parameter  p-cli-base-rate like ub.ord-line.cli-base-rate no-undo .
     2017   define input parameter  p-curr-code  as integer   no-undo .
     2018   define output parameter p-price-base like ub.doc-line.price-base no-undo .
     2019   define output parameter p-price-rubl like ub.doc-line.price-rubl no-undo .
     2020   define output parameter p-price-cli  like ub.doc-line.price-cli  no-undo .
     2021   define buffer buf-lib-doc-line for ub.doc-line.
     2022   define buffer buf_cli-gds for ub.cli-gds .
     2023   define buffer buf_trn-doc for ub.trn-doc  .
     2024   define variable vp-curr-code  like ub.trn-doc.exch-code.
     2025   define variable vp-exch-rate  like ub.trn-doc.exch-rate.
     2026   define variable vp-exch-scale like ub.trn-doc.exch-scale.
     2027   define variable v-last-in-code   like ub.doc-line.doc-code  no-undo .
     2028   define variable v-last-obj-type  like ub.clients.obj-type no-undo .
     2029   define variable v-last-obj-code  like ub.clients.obj-code no-undo .
     2030   define variable v-cli-base-rate as decimal   no-undo .
     2031    find first buf_cli-gds no-lock where
     2032               buf_cli-gds.cli-type   = p-cli-type    and
     2033               buf_cli-gds.cli-code   = p-cli-code    and
     2034               buf_cli-gds.host-code  = p-host-code   and
     2035               buf_cli-gds.artic      = p-artic       and
     2036               buf_cli-gds.prod-type  = p-prod-type   and
     2037               buf_cli-gds.prod-code  = p-prod-code
     2038               no-error .
     2039   if available buf_cli-gds then do:
     2040       find first buf_trn-doc no-lock
     2041            where buf_trn-doc.doc-code  = buf_cli-gds.in-code no-error .
     2042        if available buf_trn-doc then do:
     2043           vp-curr-code  = buf_trn-doc.exch-code.
     2044           vp-exch-rate  = buf_trn-doc.exch-rate.
     2045           vp-exch-scale = buf_trn-doc.exch-scale.
     2046        end.
     2047       find first buf-lib-doc-line no-lock
     2048         where buf-lib-doc-line.doc-code  = buf_cli-gds.in-code
     2049           and buf-lib-doc-line.artic     = p-artic
     2050           and buf-lib-doc-line.prod-type = p-prod-type
     2051           and buf-lib-doc-line.prod-code = p-prod-code
     2052         no-error .
     2053   end.
     2054   else do:
     2055   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2056   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lastindc in g#library
     2057     (input  p-host-code
     2058     ,input  p-artic
     2059     ,input  p-prod-type
     2060     ,input  p-prod-code
     2061     ,output v-last-in-code
     2062     ,output v-last-obj-type
     2063     ,output v-last-obj-code
     2064     )  .
     2065       find first buf_trn-doc no-lock
     2066            where buf_trn-doc.doc-code  = v-last-in-code no-error .
     2067        if available buf_trn-doc then do:
     2068           vp-curr-code  = buf_trn-doc.exch-code.
     2069           vp-exch-rate  = buf_trn-doc.exch-rate.
     2070           vp-exch-scale = buf_trn-doc.exch-scale.
     2071        end.
     2072       find first buf-lib-doc-line no-lock
     2073         where buf-lib-doc-line.doc-code  = v-last-in-code
     2074           and buf-lib-doc-line.artic     = p-artic
     2075           and buf-lib-doc-line.prod-type = p-prod-type
     2076           and buf-lib-doc-line.prod-code = p-prod-code
     2077         no-error .
     2078   end.
     2079       if available buf-lib-doc-line then do:
     2080         assign
     2081           v-cli-base-rate = buf-lib-doc-line.cli-base-rate
     2082           p-price-base = buf-lib-doc-line.price-base
     2083           p-price-rubl = buf-lib-doc-line.price-rubl
     2084           p-price-cli  = (if vp-curr-code = 0 then buf-lib-doc-line.price-rubl else buf-lib-doc-line.price-base) * p-cli-base-rate
     2085         .
     2086         if v-cli-base-rate <> p-cli-base-rate
     2087         then do:
     2088             p-price-cli  = p-price-cli / v-cli-base-rate  .
     2089         end.
     2090          if p-curr-code <> vp-curr-code then do:
     2091             p-price-cli  = p-price-rubl  .
     2092         end.
     2093       end.
     2094       Else do:
     2095         assign
     2096           p-price-base = 0
     2097           p-price-rubl = 0
     2098           p-price-cli  = 0
     2099         .
     2100       end.
     2101     end.
     2102   end procedure.
     2103   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2104   on F9 of frame dialog-frame anywhere do:
     2105     run init-gds-rec.
     2106     if gds-rec = ? then
     2107       return no-apply.
     2108     run ref/gds-form.w ( input PARPARENTPROC
     2109                         ,input 'ПРОСМОТР':U
     2110                         ,input ?
     2111                         ,input ?
     2112                         ,input ?
     2113                         ,input-output gds-rec).
     2114     apply "entry" to br-docs in frame dialog-frame.
     2115     return no-apply.
     2116   end.
     2117   on window-close of frame dialog-frame
     2118   do:
     2119     apply "CHOOSE":u to b-exit.
     2120   end.
     2121   ON ROW-DISPLAY OF BR-DOCS IN FRAME dialog-frame
     2122   DO:
     2123     define buffer buf_gds-obj for ub.gds-obj  .
     2124     loc-sum-rcv = 0 .
     2125     loc-err-rcv = "" .
     2126     for each ub.ord-line-rcv where
     2127              ub.ord-line-rcv.doc-code  = shar_ord-line.doc-code  and
     2128              ub.ord-line-rcv.artic     = shar_ord-line.artic     and
     2129              ub.ord-line-rcv.prod-type = shar_ord-line.prod-type and
     2130              ub.ord-line-rcv.prod-code = shar_ord-line.prod-code no-lock  :
     2131          loc-sum-rcv = loc-sum-rcv  + ub.ord-line-rcv.qnty .
     2132     end.
     2133       if loc-sum-rcv   >  shar_ord-line.qnty then do:
     2134          loc-sum-rcv:fgcolor in browse  br-docs  =  12 .
     2135          loc-err-rcv:fgcolor in browse  br-docs  =  12 .
     2136          loc-err-rcv = ">" .
     2137          end.
     2138       if loc-sum-rcv   <  shar_ord-line.qnty then do:
     2139          loc-sum-rcv:fgcolor in browse  br-docs  =  4 .
     2140          loc-err-rcv:fgcolor in browse  br-docs  =  4 .
     2141          loc-err-rcv = "<" .
     2142          end.
     2143     find first buf_gds-obj no-lock where
     2144                buf_gds-obj.artic     = shar_ord-line.artic     and
     2145                buf_gds-obj.prod-type = shar_ord-line.prod-type and
     2146                buf_gds-obj.prod-code = shar_ord-line.prod-code and
     2147                buf_gds-obj.obj-type  = shar_ord-doc.obj-type   and
     2148                buf_gds-obj.obj-code  = shar_ord-doc.obj-code   no-error .
     2149      if available buf_gds-obj then
     2150              v-fact-qnty = buf_gds-obj.fact-qnty.
     2151         else v-fact-qnty = 0 .
     2152     find first buf_ord-line-attr where buf_ord-line-attr.doc-code = shar_ord-line.doc-code
     2153       and buf_ord-line-attr.gds-code = shar_ord-line.gds-code
     2154       and buf_ord-line-attr.attr-code = 'min-stock':U no-error.
     2155     if available buf_ord-line-attr then v-min-stock = decimal(buf_ord-line-attr.attr-value).
     2156     find first buf_ord-line-attr where buf_ord-line-attr.doc-code = shar_ord-line.doc-code
     2157       and buf_ord-line-attr.gds-code = shar_ord-line.gds-code
     2158       and buf_ord-line-attr.attr-code = 'gds-way':U no-error.
     2159     if available buf_ord-line-attr then v-gds-way = decimal(buf_ord-line-attr.attr-value).
     2160   end.
     2161   ON ROW-DISPLAY OF BR-DOCS-2 IN FRAME FRAME-A
     2162   DO:
     2163        if ub.ord-dtl.artic = ? then do:
     2164           f-artic = shar_ord-line.artic  .
     2165       end.
     2166       else do:
     2167         f-artic = ub.ord-dtl.artic  .
     2168         shar_ord-line.qnty:bgcolor in browse  br-docs-2  = 7.
     2169       end.
     2170        assign
     2171           f-prt-name  =  if ub.gds-prt.f-name = ?    then ""                  else ub.gds-prt.f-name
     2172           f-gds-name  =  if b-goods.gds-name = ?  then buf-goods.gds-name  else b-goods.gds-name
     2173           f-unit-base =  if b-goods.unit-base = ? then buf-goods.unit-base else b-goods.unit-base
     2174           f-qnty        =  if ub.ord-dtl.qnty        = ? then shar_ord-line.qnty        else ub.ord-dtl.qnty
     2175           f-price-rubl  =  if ub.ord-dtl.price-rubl  = ? then shar_ord-line.price-rubl  else ub.ord-dtl.price-rubl
     2176           f-sum-rubl    =  if ub.ord-dtl.sum-rubl    = ? then shar_ord-line.sum-rubl    else ub.ord-dtl.sum-rubl
     2177           f-cli-qnty    =  if ub.ord-dtl.cli-qnty    = ? then shar_ord-line.cli-qnty    else ub.ord-dtl.cli-qnty
     2178           f-price-cli   =  if ub.ord-dtl.price-cli   = ? then shar_ord-line.price-cli   else ub.ord-dtl.price-cli
     2179           f-sum-cli     =  if ub.ord-dtl.sum-cli     = ? then shar_ord-line.sum-cli     else ub.ord-dtl.sum-cli
     2180     .
     2181     f-loc-sum-rcv = 0 .
     2182     f-loc-err-rcv = "" .
     2183     for each ub.ord-dtl-rcv where
     2184              ub.ord-dtl-rcv.doc-code  = ub.ord-dtl.doc-code  and
     2185              ub.ord-dtl-rcv.node-code = ub.ord-dtl.node-code and
     2186              ub.ord-dtl-rcv.artic     = ub.ord-dtl.artic     and
     2187              ub.ord-dtl-rcv.prod-type = ub.ord-dtl.prod-type and
     2188              ub.ord-dtl-rcv.prod-code = ub.ord-dtl.prod-code no-lock  :
     2189          f-loc-sum-rcv = f-loc-sum-rcv  + ub.ord-dtl.qnty .
     2190     end.
     2191       if f-loc-sum-rcv   >  ub.ord-dtl.qnty then do:
     2192          f-loc-sum-rcv:fgcolor in browse  br-docs-2  =  12 .
     2193          f-loc-err-rcv:fgcolor in browse  br-docs-2  =  12 .
     2194          f-loc-err-rcv = ">" .
     2195       end.
     2196       if f-loc-sum-rcv   <  ub.ord-dtl.qnty then do:
     2197          f-loc-sum-rcv:fgcolor in browse  br-docs-2  =  4 .
     2198          f-loc-err-rcv:fgcolor in browse  br-docs-2  =  4 .
     2199          f-loc-err-rcv = "<" .
     2200       end.
     2201   end.
     2202   on value-changed of br-docs in frame dialog-frame
     2203   do:
     2204      run select-good-scala no-error .
     2205   end.
     2206   on value-changed of br-docs-2 in frame frame-a
     2207   do:
     2208      run select-good-scala-2 no-error .
     2209   end.
     2210   on value-changed of tog-prt in frame dialog-frame
     2211   do:
