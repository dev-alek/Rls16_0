     1669   define new global shared variable g#attr-lib  as handle no-undo .
     1670   define variable v-attr-lib-variable as handle no-undo .
     1671   procedure gdsoattr-name :
     1672     define input  parameter p-code           as character no-undo .
     1673     define output parameter p-type           as character no-undo .
     1674     define output parameter p-format         as character no-undo .
     1675     define output parameter p-label          as character no-undo .
     1676     define output parameter p-user-can-edit  as logical   no-undo .
     1677     define output parameter p-output-display as logical   no-undo .
     1678     define output parameter p-other          as character no-undo .
     1679     do
     1680     on error undo, return error
     1681     :
     1682           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
     1683         (input  p-code
     1684         ,output p-type
     1685         ,output p-format
     1686         ,output p-label
     1687         ,output p-user-can-edit
     1688         ,output p-output-display
     1689         ,output p-other
     1690         ) no-error .
     1691       if error-status :error
     1692       then do:
     1693         undo, return error return-value .
     1694       end.
     1695     end.
     1696   end.
