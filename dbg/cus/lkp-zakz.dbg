     2213      if error-status :error then return no-apply.
     2214   end.
     2215   ON CHOOSE OF B-delivery IN FRAME Dialog-Frame
     2216   DO:
     2217     run cus/pardeliv.w
     2218        ( input        parParentproc
     2219         ,input        if t-action = "lkp" then 'ПРОСМОТР':U else t-action
     2220         ,input        "ord" + g#type
     2221         ,input        loc-store-type
     2222         ,input        loc-store-code
     2223         ,input        loc-cli-type
     2224         ,input        loc-cli-code
     2225         ,input-output v-deliv-type-code
     2226         ,input-output v-point-obj-code
     2227         ,input-output v-point-obj-db-num
     2228         ,input-output v-point-cli-code
     2229         ,input-output v-point-cli-db-num
     2230         ,input-output v-transport-host-code
     2231         ,input-output v-transport-cli-type
     2232         ,input-output v-transport-cli-code
     2233         ,input-output v-transport-contract
     2234         ,input-output v-transport-condition
     2235         ,input-output v-transport-value
     2236         ,input-output v-transport-sum
     2237         ,input-output v-transport-vat
     2238         ) no-error.
     2239       if error-status :error then message
     2240         vss-workfile vss-revision vss-description skip
     2241         error-status :get-message(1) skip
     2242         return-value skip
     2243         "Ошибка"
     2244         view-as alert-box error
     2245       .
     2246   END.
     2247   ON CHOOSE OF b-next IN FRAME dialog-frame
     2248   DO:
     2249    RUN step-next in this-procedure .
     2250   END.
     2251   ON CHOOSE OF b-prev IN FRAME dialog-frame
     2252   DO:
     2253    run step-prev in this-procedure .
     2254   END.
     2255   ON CHOOSE OF b-protocol IN FRAME Dialog-Frame
     2256   DO:
     2257   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2258   if lookup(self :type
     2259            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2260            ) = 0
     2261   then do:
     2262     message
     2263       "$Workfile$"
     2264       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2265       "Интерфейсный элемент" self :name  skip
     2266       "Тип" self :type  skip
     2267       "Процедура" this-procedure :file-name skip
     2268       view-as alert-box .
     2269   end.
     2270   else do:
     2271     apply "entry":u to self  .
     2272     if focus :handle <> self :handle  then do:
     2273       return no-apply .
     2274     end.
     2275   end.
     2276     run show-protocol in this-procedure .
     2277   END.
     2278   ON CHOOSE OF b-contract IN FRAME Dialog-Frame
     2279   DO:
     2280   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2281   if lookup(self :type
     2282            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2283            ) = 0
     2284   then do:
     2285     message
     2286       "$Workfile$"
     2287       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2288       "Интерфейсный элемент" self :name  skip
     2289       "Тип" self :type  skip
     2290       "Процедура" this-procedure :file-name skip
     2291       view-as alert-box .
     2292   end.
     2293   else do:
     2294     apply "entry":u to self  .
     2295     if focus :handle <> self :handle  then do:
     2296       return no-apply .
     2297     end.
     2298   end.
     2299     run show-contract-code in this-procedure .
     2300   END.
     2301   ON CHOOSE OF b-inf IN FRAME Dialog-Frame
     2302   DO:
     2303     run cus/edi-inf.w ( p-doc-code ) .
     2304   END.
     2305   ON CHOOSE OF b-producer IN FRAME Dialog-Frame
     2306   DO:
     2307     find current shar_ord-line no-lock  .
     2308     if not available shar_ord-line  then  return.
     2309     run ref/showcli.p
     2310     (input parParentProc
     2311     ,input shar_ord-line.prod-type
     2312     ,input shar_ord-line.prod-code
     2313     ).
     2314     return no-apply.
     2315   END.
     2316   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     2317   DO:
     2318     next-prev = ?.
     2319     apply "end-error":u to self.
     2320     return .
     2321   END.
     2322   on choose of b-notes in frame dialog-frame
     2323   do:
     2324    run proc-d-notes in this-procedure .
     2325   end.
     2326   ON CHOOSE OF MENU-ITEM m_Export_TEXT
     2327   DO:
     2328     run cus/z-tot2.p ( parparentproc , "order" , shar_ord-doc.doc-type ,  p-doc-code) .
     2329   END.
     2330   ON CHOOSE OF B-Alt-post IN FRAME Dialog-Frame
     2331   DO:
     2332     find current shar_ord-line no-lock no-error  .
     2333     if  not avail shar_ord-line  then do:
     2334           return.
     2335     end.
     2336    run cus/cli-othr.w
     2337      (input shar_ord-line.artic,
     2338       input shar_ord-line.prod-type,
     2339       input shar_ord-line.prod-code,
     2340       input buf-cli.obj-type ,
     2341       input buf-cli.obj-code
     2342       ).
     2343   END.
     2344   ON CHOOSE OF MENU-ITEM m_way1
     2345   DO:
     2346     run CHOOSE-MENU-way1 in this-procedure.
     2347   END.
     2348   ON CHOOSE OF MENU-ITEM m_way2
     2349   DO:
     2350     run CHOOSE-MENU-way2 in this-procedure.
     2351   END.
     2352   on choose of menu-item m_export_excel
     2353   do:
     2354     run b-export-ch  in this-procedure .
     2355   end.
     2356   if valid-handle(active-window) and frame dialog-frame:parent eq ?
     2357   then frame dialog-frame:parent = active-window.
     2358   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2359   on help of frame dialog-frame
     2360   do:
     2361     run gbl/app_help.p
     2362       (input this-procedure :file-name
     2363       ,input ''
     2364       ,input ?
     2365       ) no-error.
     2366     if error-status :error then do:
     2367       message
     2368         "Ошибка при вызове помощи"
     2369         error-status :get-message(1)
     2370         view-as alert-box .
     2371     end.
     2372   end.
     2373   run minbtn-set in this-procedure .
     2374   on choose of b-help in frame dialog-frame
     2375   do:
     2376     apply "help":u to frame dialog-frame .
     2377   end.
     2378   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2379   procedure minbtn-set :
     2380       do
     2381           on error undo, return error return-value
     2382           :
     2383           define variable ii              as integer       no-undo .
     2384           define variable fh              as widget-handle no-undo .
     2385           define variable hh              as widget-handle no-undo .
     2386           define variable v-h             as handle        extent 4 no-undo .
     2387           define variable v-name-button   as character     no-undo .
     2388           define variable v-help-old-x    as decimal       no-undo .
     2389           define variable v-help-old-y    as decimal       no-undo .
     2390           define variable v-help-old-size as decimal       no-undo .
     2391           define variable v-frame-width   as decimal       no-undo .
     2392           define variable jj              as integer       no-undo .
     2393           do
     2394               on error undo, return error
     2395               :
     2396               assign
     2397                   v-frame-width = frame dialog-frame:width - 0.3
     2398                   fh            = frame dialog-frame:first-child
     2399                   hh            = fh:first-child
     2400                   ii            = 1
     2401                   .
     2402               do while valid-handle(hh):
     2403                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2404                   do:
     2405                       case lc(hh:name) :
     2406                           when "b-help" then
     2407                               do:
     2408                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2409                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2410                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2411                                   hh:TOOLTIP = "Помощь" .
     2412                                   v-help-old-x = hh:column .
     2413                                   v-help-old-y = hh:row    .
     2414                                   v-help-old-size = hh:width .
     2415                                   hh:width-chars = 2.5 .
     2416                               end.
     2417                           when "b-print" then
     2418                               do:
     2419                                   hh:load-image("cmp/b-print.bmp":u) .
     2420                                   hh:TOOLTIP = "Печать" .
     2421                                   v-h[ii] = hh:handle .
     2422                                   ii = ii + 1 .
     2423                                   hh:width-chars = 3 .
     2424                               end.
     2425                           when "b-history" or
     2426                           when "b-hist" then
     2427                               do:
     2428                                   hh:load-image("cmp/b-hist.bmp":u) .
     2429                                   hh:TOOLTIP = "История" .
     2430                                   v-h[ii] = hh:handle .
     2431                                   ii = ii + 1 .
     2432                                   hh:width-chars = 3 .
     2433                               end.
     2434                           when "b-sch" then
     2435                               do:
     2436                                   hh:load-image("cmp/b-sch.bmp":u) .
     2437                                   hh:TOOLTIP = "Установка Фильтра" .
     2438                                   v-h[ii] = hh:handle .
     2439                                   ii = ii + 1 .
     2440                                   hh:width-chars = 3 .
     2441                               end.
     2442                           when "b-hist-user" then
     2443                               do:
     2444                                   hh:load-image("cmp/b-hist.bmp":u) .
     2445                                   hh:TOOLTIP = "История пользователя" .
     2446                                   ii = ii + 1 .
     2447                               end.
     2448                       end case.
     2449                   end.
     2450                   hh = hh:next-sibling.
     2451               end.
     2452               b-help:column = v-frame-width - b-help:width-chars.
     2453               jj = 0.
     2454               repeat ii = 4 to 1 by -1 :
     2455                   if valid-handle (v-h[ii] ) then
     2456                   do:
     2457                       jj  = jj + 1 .
     2458                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2459                       v-h[ii]:row    = v-help-old-y .
     2460                   end.
     2461               end.
     2462           end.
     2463       end.
     2464   end procedure.
     2465   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2466   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2467   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2468   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2469   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2470   define variable v-diasize-current-frame-height as decimal   no-undo .
     2471   define variable v-diasize-change-size          as logical   no-undo .
     2472   define variable v-diasize-resize-button        as handle    no-undo .
     2473   define variable v-diasize-wndmax               as logical   no-undo .
     2474   define variable v-diasize-wndstore             as logical   no-undo .
     2475   define variable v-diasize-proc-name            as character no-undo .
     2476   define variable v-diasize-browse-handle        as handle    no-undo .
     2477   define variable v-diasize-browse-number        as integer   no-undo .
     2478   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2479   define temp-table temp-diasize-handle no-undo
     2480     field handle-value  as handle
     2481     field save-position as decimal
     2482     index xpk is primary unique handle-value
     2483     .
     2484   define temp-table temp-browse-handle no-undo
     2485     field browse-type   as character
     2486     field browse-number as integer
     2487     field browse-handle as handle
     2488     field original-size as decimal
     2489     index xpk is primary unique browse-type browse-number
     2490     index xie browse-type browse-handle
     2491   .
     2492   procedure diasize_change-height :
     2493     define input  parameter p-change-value  as decimal   no-undo .
     2494     define input  parameter p-move-resize   as logical   no-undo .
     2495     define variable v-field-group-handle    as handle    no-undo .
     2496     define variable v-object-handle         as handle    no-undo .
     2497     define variable v-frame-height          as decimal   no-undo .
     2498     define variable v-frame-virtual-height  as decimal   no-undo .
     2499     define variable v-browse-height         as decimal   no-undo .
     2500     define variable v-window-height         as decimal   no-undo .
     2501     define variable v-window-virtual-height as decimal   no-undo .
     2502     define variable v-change-sign           as integer   no-undo .
     2503     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2504     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2505     if p-change-value > 0
     2506     then do:
     2507       if frame dialog-frame :height + p-change-value
     2508           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2509       then do:
     2510         assign
     2511           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2512                           - (frame dialog-frame :height-chars)
     2513         .
     2514         if p-change-value <= 0
     2515         then do:
     2516           run diasize_position-resize-button in this-procedure .
     2517           return .
     2518         end.
     2519       end.
     2520     end.
     2521     if p-change-value < 0
     2522     then do:
     2523       if frame dialog-frame :height + p-change-value < v-diasize-orig-frame-height
     2524       then do:
     2525         assign
     2526           p-change-value = v-diasize-orig-frame-height
     2527                          - (frame dialog-frame :height-chars)
     2528         .
     2529         if p-change-value >= 0
     2530         then do:
     2531           run diasize_position-resize-button in this-procedure .
     2532           return .
     2533         end.
     2534       end.
     2535     end.
     2536     if p-change-value >= 0
     2537     then do:
     2538       assign
     2539         v-change-sign = 1
     2540       .
     2541     end.
     2542     else do:
     2543       assign
     2544         v-change-sign = -1
     2545       .
     2546     end.
     2547     assign
     2548       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2549     .
     2550     if p-change-value = 0
     2551     then do:
     2552       run diasize_position-resize-button in this-procedure .
     2553       return .
     2554     end.
     2555     move_block:
     2556     do
     2557     on error undo move_block, retry move_block
     2558     :
     2559       if retry
     2560       then do:
     2561         do
     2562         on error undo move_block, leave move_block
     2563         :
     2564           if p-change-value > 0
     2565           then do:
     2566             for each buf_temp-diasize-handle
     2567             on error undo, next
     2568             :
     2569               assign
     2570                 v-object-handle = buf_temp-diasize-handle.handle-value
     2571               .
     2572               if v-object-handle <> v-diasize-resize-button
     2573               then do:
     2574                 assign
     2575                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2576                 .
     2577               end.
     2578             end.
     2579             assign
     2580               v-diasize-browse-handle :height = v-browse-height
     2581             .
     2582             for each buf_temp-browse-handle
     2583               where buf_temp-browse-handle.browse-type = 'height':u
     2584             on error undo, next
     2585             :
     2586               assign
     2587                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2588               .
     2589             end.
     2590             assign
     2591               frame dialog-frame :height = v-frame-height
     2592             .
     2593             if frame dialog-frame :scrollable = true
     2594             then do:
     2595               assign
     2596                 frame dialog-frame :virtual-height = v-frame-virtual-height
     2597               .
     2598             end.
     2599             run diasize_position-resize-button in this-procedure .
     2600           end.
     2601           else do:
     2602             if frame dialog-frame :scrollable = true
     2603             then do:
     2604               assign
     2605                 frame dialog-frame :virtual-height = v-frame-virtual-height
     2606               .
     2607             end.
     2608             assign
     2609               frame dialog-frame :height = v-frame-height
     2610             .
     2611             assign
     2612               v-diasize-browse-handle :height = v-browse-height
     2613             .
     2614             for each buf_temp-browse-handle
     2615               where buf_temp-browse-handle.browse-type = 'height':u
     2616             on error undo, next
     2617             :
     2618               assign
     2619                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2620               .
     2621             end.
     2622             for each buf_temp-diasize-handle
     2623             on error undo, next
     2624             :
     2625               assign
     2626                 v-object-handle = buf_temp-diasize-handle.handle-value
     2627               .
     2628               if v-object-handle <> v-diasize-resize-button
     2629               then do:
     2630                 assign
     2631                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2632                 .
     2633               end.
     2634             end.
     2635             run diasize_position-resize-button in this-procedure .
     2636           end.
     2637           assign
     2638             v-diasize-change-size = false
     2639           .
     2640           leave move_block .
     2641         end.
     2642       end.
     2643       assign
     2644         v-diasize-need-full-display = true
     2645       .
     2646       if v-diasize-change-size = false
     2647       then do:
     2648         assign
     2649           v-diasize-change-size = true
     2650         .
     2651       end.
     2652       else do:
     2653         return .
     2654       end.
     2655       assign
     2656         v-frame-height = frame dialog-frame :height
     2657         v-frame-virtual-height = frame dialog-frame :virtual-height
     2658         v-browse-height = v-diasize-browse-handle :height
     2659       .
     2660       for each buf_temp-browse-handle
     2661         where buf_temp-browse-handle.browse-type = 'height':u
     2662       :
     2663         assign
     2664           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2665         .
     2666       end.
     2667       for each buf_temp-diasize-handle
     2668       :
     2669         delete buf_temp-diasize-handle .
     2670       end.
     2671       assign
     2672         v-field-group-handle = frame dialog-frame :first-child
     2673       .
     2674       do while valid-handle(v-field-group-handle)
     2675       :
     2676         assign
     2677           v-object-handle = v-field-group-handle :first-child
     2678         .
     2679         do while valid-handle(v-object-handle)
     2680         :
     2681           if  v-object-handle <> v-diasize-browse-handle :handle
     2682           and can-query(v-object-handle, "row")
     2683           and can-query(v-object-handle, "height")
     2684           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2685           then do:
     2686             find first buf_temp-browse-handle
     2687               where buf_temp-browse-handle.browse-type   = 'height':u
     2688                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2689               no-error .
     2690             if available buf_temp-browse-handle
     2691             then do:
     2692             end.
     2693             else do:
     2694               create buf_temp-diasize-handle .
     2695               assign
     2696                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2697                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2698               .
     2699             end.
     2700           end.
     2701           assign
     2702             v-object-handle = v-object-handle :next-sibling
     2703           .
     2704         end.
     2705         assign
     2706           v-field-group-handle = v-field-group-handle :next-sibling
     2707         .
     2708       end.
     2709       do with frame dialog-frame
     2710       :
     2711         hide v-diasize-resize-button .
     2712         assign
     2713           v-diasize-resize-button :row    = 1
     2714           v-diasize-resize-button :column = 1
     2715         .
     2716       end.
     2717       if p-change-value > 0
     2718       then do:
     2719         if frame dialog-frame :scrollable = true
     2720         then do:
     2721           assign
     2722             frame dialog-frame :virtual-height = frame dialog-frame :virtual-height + p-change-value
     2723             no-error .
     2724           if error-status :error
     2725           or error-status :get-message(1) <> ""
     2726           then do:
     2727             undo move_block, retry move_block .
     2728           end.
     2729         end.
     2730         assign
     2731           frame dialog-frame :height = frame dialog-frame :height + p-change-value
     2732           no-error .
     2733         if error-status :error
     2734         or error-status :get-message(1) <> ""
     2735         then do:
     2736           undo move_block, retry move_block .
     2737         end.
     2738         assign
     2739           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2740           no-error .
     2741         if error-status :error
     2742         or error-status :get-message(1) <> ""
     2743         then do:
     2744           undo move_block, retry move_block .
     2745         end.
     2746         for each buf_temp-browse-handle
     2747           where buf_temp-browse-handle.browse-type = 'height':u
     2748         on error undo move_block, retry move_block
     2749         :
     2750           assign
     2751             buf_temp-browse-handle.browse-handle :height
     2752               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2753             no-error .
     2754           if error-status :error
     2755           or error-status :get-message(1) <> ""
     2756           then do:
     2757             undo move_block, retry move_block .
     2758           end.
     2759         end.
     2760         for each buf_temp-diasize-handle
     2761         on error undo move_block, retry move_block
     2762         :
     2763           assign
     2764             v-object-handle = buf_temp-diasize-handle.handle-value
     2765           .
     2766           if v-object-handle <> v-diasize-resize-button
     2767           then do:
     2768             assign
     2769               v-object-handle :row = v-object-handle :row + p-change-value
     2770               no-error .
     2771             if error-status :error
     2772             or error-status :get-message(1) <> ""
     2773             then do:
     2774               undo move_block, retry move_block .
     2775             end.
     2776           end.
     2777         end.
     2778       end.
     2779       else do:
     2780         for each buf_temp-diasize-handle
     2781         on error undo move_block, retry move_block
     2782         :
     2783           assign
     2784             v-object-handle = buf_temp-diasize-handle.handle-value
     2785           .
     2786           if v-object-handle <> v-diasize-resize-button
     2787           then do:
     2788             assign
     2789               v-object-handle :row = v-object-handle :row + p-change-value
     2790               no-error .
     2791             if error-status :error
     2792             or error-status :get-message(1) <> ""
     2793             then do:
     2794               undo move_block, retry move_block .
     2795             end.
     2796           end.
     2797         end.
     2798         assign
     2799           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2800           no-error .
     2801         if error-status :error
     2802         or error-status :get-message(1) <> ""
     2803         then do:
     2804           undo move_block, retry move_block .
     2805         end.
     2806         for each buf_temp-browse-handle
     2807           where buf_temp-browse-handle.browse-type = 'height':u
     2808         on error undo move_block, retry move_block
     2809         :
     2810           assign
     2811             buf_temp-browse-handle.browse-handle :height
     2812               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2813             no-error .
     2814           if error-status :error
     2815           or error-status :get-message(1) <> ""
     2816           then do:
     2817             undo move_block, retry move_block .
     2818           end.
     2819         end.
     2820         assign
     2821           frame dialog-frame :height = frame dialog-frame :height + p-change-value
     2822           no-error .
     2823         if error-status :error
     2824         or error-status :get-message(1) <> ""
     2825         then do:
     2826           undo move_block, retry move_block .
     2827         end.
     2828         if frame dialog-frame :scrollable = true
     2829         then do:
     2830           assign
     2831             frame dialog-frame :virtual-height = frame dialog-frame :virtual-height + p-change-value
     2832             no-error .
     2833           if error-status :error
     2834           or error-status :get-message(1) <> ""
     2835           then do:
     2836             undo move_block, retry move_block .
     2837           end.
     2838         end.
     2839       end.
     2840       if p-move-resize = true
     2841       then do:
     2842         run diasize_position-resize-button in this-procedure .
     2843       end.
     2844       if v-diasize-wndstore = true
     2845       then do:
     2846         if connected("ub") = true
     2847         then do:
     2848           define variable v-cntxt-db-num        as integer   no-undo .
     2849           define variable v-cntxt-userid        as character no-undo .
     2850           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2851                                             , OUTPUT v-cntxt-userid
     2852                                             ) .
     2853           run gbl/wndsizew.p
     2854             (input  v-cntxt-db-num
     2855             ,input  v-cntxt-userid
     2856             ,input  v-diasize-proc-name
     2857             ,input  'height':u
     2858             ,input  string(frame dialog-frame :height - v-diasize-orig-frame-height)
     2859             ) .
     2860         end.
     2861       end.
     2862     end.
     2863     assign
     2864       v-diasize-change-size = false
     2865     .
     2866   end procedure.
     2867   procedure diasize_set-height :
     2868     define input  parameter p-new-height  as decimal   no-undo .
     2869     define input  parameter p-move-resize as logical   no-undo .
     2870     do
     2871     on error undo, return error return-value
     2872     :
     2873       run diasize_change-height in this-procedure
     2874         (input  (p-new-height - frame dialog-frame :height)
     2875         ,input  p-move-resize
     2876         ) .
     2877     end.
     2878   end procedure.
     2879   procedure diasize_change-width :
     2880     define input  parameter p-change-value as decimal   no-undo .
     2881     define input  parameter p-move-resize  as logical   no-undo .
     2882     define variable v-field-group-handle   as handle    no-undo .
     2883     define variable v-object-handle        as handle    no-undo .
     2884     define variable v-frame-width          as decimal   no-undo .
     2885     define variable v-frame-virtual-width  as decimal   no-undo .
     2886     define variable v-browse-width         as decimal   no-undo .
     2887     define variable v-window-width         as decimal   no-undo .
     2888     define variable v-window-virtual-width as decimal   no-undo .
     2889     define variable v-change-sign          as integer   no-undo .
     2890     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2891     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2892     if p-change-value > 0
     2893     then do:
     2894       if frame dialog-frame :width + p-change-value >
     2895           session :width-chars
     2896       then do:
     2897         assign
     2898           p-change-value = session :width-chars - frame dialog-frame :width
     2899         .
     2900         if p-change-value <= 0
     2901         then do:
     2902           run diasize_position-resize-button in this-procedure .
     2903           return .
     2904         end.
     2905       end.
     2906     end.
     2907     if p-change-value < 0
     2908     then do:
     2909       if frame dialog-frame :width + p-change-value < v-diasize-orig-frame-width
     2910       then do:
     2911         assign
     2912           p-change-value = v-diasize-orig-frame-width
     2913                          - frame dialog-frame :width
     2914         .
     2915         if p-change-value >= 0
     2916         then do:
     2917           run diasize_position-resize-button in this-procedure .
     2918           return .
     2919         end.
     2920       end.
     2921     end.
     2922     if p-change-value >= 0
     2923     then do:
     2924       assign
     2925         v-change-sign = 1
     2926       .
     2927     end.
     2928     else do:
     2929       assign
     2930         v-change-sign = -1
     2931       .
     2932     end.
     2933     assign
     2934       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2935     .
     2936     if p-change-value = 0
     2937     then do:
     2938       run diasize_position-resize-button in this-procedure .
     2939       return .
     2940     end.
     2941     move_block:
     2942     do
     2943     on error undo move_block, leave move_block
     2944     :
     2945       if retry
     2946       then do:
     2947         do
     2948         on error undo move_block, leave move_block
     2949         :
     2950           if p-change-value > 0
     2951           then do:
     2952             for each buf_temp-diasize-handle
     2953             on error undo, next
     2954             :
     2955               assign
     2956                 v-object-handle = buf_temp-diasize-handle.handle-value
     2957               .
     2958               if v-object-handle <> v-diasize-resize-button
     2959               then do:
     2960                 assign
     2961                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2962                 .
     2963               end.
     2964             end.
     2965             assign
     2966               v-diasize-browse-handle :width = v-browse-width
     2967             .
     2968             for each buf_temp-browse-handle
     2969               where buf_temp-browse-handle.browse-type = 'width':u
     2970             on error undo, next
     2971             :
     2972               assign
     2973                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2974               .
     2975             end.
     2976             assign
     2977               frame dialog-frame :width = v-frame-width
     2978             .
     2979             if frame dialog-frame :scrollable = true
     2980             then do:
     2981               assign
     2982                 frame dialog-frame :virtual-width = v-frame-virtual-width
     2983               .
     2984             end.
     2985             run diasize_position-resize-button in this-procedure .
     2986           end.
     2987           else do:
     2988             if frame dialog-frame :scrollable = true
     2989             then do:
     2990               assign
     2991                 frame dialog-frame :virtual-width = v-frame-virtual-width
     2992               .
     2993             end.
     2994             assign
     2995               frame dialog-frame :width = v-frame-width
     2996             .
     2997             for each buf_temp-browse-handle
     2998               where buf_temp-browse-handle.browse-type = 'width':u
     2999             on error undo, next
     3000             :
     3001               assign
     3002                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3003               .
     3004             end.
     3005             assign
     3006               v-diasize-browse-handle :width = v-browse-width
     3007             .
     3008             for each buf_temp-diasize-handle
     3009             on error undo, next
     3010             :
     3011               assign
     3012                 v-object-handle = buf_temp-diasize-handle.handle-value
     3013               .
     3014               if v-object-handle <> v-diasize-resize-button
     3015               then do:
     3016                 assign
     3017                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3018                 .
     3019               end.
     3020             end.
     3021             run diasize_position-resize-button in this-procedure .
     3022           end.
     3023           assign
     3024             v-diasize-change-size = false
     3025           .
     3026           leave move_block .
     3027         end.
     3028       end.
     3029       assign
     3030         v-diasize-need-full-display = true
     3031       .
     3032       if v-diasize-change-size = false
     3033       then do:
     3034         assign
     3035           v-diasize-change-size = true
     3036         .
     3037       end.
     3038       else do:
     3039         return .
     3040       end.
     3041       assign
     3042         v-frame-width = frame dialog-frame :width
     3043         v-frame-virtual-width = frame dialog-frame :virtual-width
     3044         v-browse-width = v-diasize-browse-handle :width
     3045       .
     3046       for each buf_temp-browse-handle
     3047         where buf_temp-browse-handle.browse-type = 'width':u
     3048       :
     3049         assign
     3050           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3051         .
     3052       end.
     3053       for each buf_temp-diasize-handle
     3054       :
     3055         delete buf_temp-diasize-handle .
     3056       end.
     3057       assign
     3058         v-field-group-handle = frame dialog-frame :first-child
     3059       .
     3060       do while valid-handle(v-field-group-handle)
     3061       :
     3062         assign
     3063           v-object-handle = v-field-group-handle :first-child
     3064         .
     3065         do while valid-handle(v-object-handle)
     3066         :
     3067           if  v-object-handle <> v-diasize-browse-handle :handle
     3068           and v-object-handle <> v-diasize-resize-button
     3069           and can-query(v-object-handle, "row")
     3070           and can-query(v-object-handle, "height")
     3071           and ( v-object-handle :col + v-object-handle :width
     3072                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3073               )
     3074           then do:
     3075             find first buf_temp-browse-handle
     3076               where buf_temp-browse-handle.browse-type   = 'width':u
     3077                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3078               no-error .
     3079             if available buf_temp-browse-handle
     3080             then do:
     3081             end.
     3082             else do:
     3083               create buf_temp-diasize-handle .
     3084               assign
     3085                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3086                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3087               .
     3088             end.
     3089           end.
     3090           assign
     3091             v-object-handle = v-object-handle :next-sibling
     3092           .
     3093         end.
     3094         assign
     3095           v-field-group-handle = v-field-group-handle :next-sibling
     3096         .
     3097       end.
     3098       do with frame dialog-frame
     3099       :
     3100         hide v-diasize-resize-button .
     3101         v-diasize-resize-button :row = 1.
     3102         v-diasize-resize-button :column = 1.
     3103       end.
     3104       if p-change-value > 0
     3105       then do:
     3106         if frame dialog-frame :scrollable = true
     3107         then do:
     3108           assign
     3109             frame dialog-frame :virtual-width = frame dialog-frame :virtual-width + p-change-value
     3110             no-error .
     3111           if error-status :error
     3112           or error-status :get-message(1) <> ""
     3113           then do:
     3114             undo move_block, retry move_block.
     3115           end.
     3116         end.
     3117         assign
     3118           frame dialog-frame :width = v-frame-width + p-change-value
     3119           no-error .
     3120         if error-status :error
     3121         or error-status :get-message(1) <> ""
     3122         then do:
     3123           undo move_block, retry move_block.
     3124         end.
     3125         assign
     3126           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3127         no-error .
     3128         if error-status :error
     3129         or error-status :get-message(1) <> ""
     3130         then do:
     3131           undo move_block, retry move_block.
     3132         end.
     3133         for each buf_temp-browse-handle
     3134           where buf_temp-browse-handle.browse-type = 'width':u
     3135         on error undo move_block, retry move_block
     3136         :
     3137           assign
     3138             buf_temp-browse-handle.browse-handle :width
     3139               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3140             no-error .
     3141           if error-status :error
     3142           or error-status :get-message(1) <> ""
     3143           then do:
     3144             undo move_block, retry move_block .
     3145           end.
     3146         end.
     3147         for each buf_temp-diasize-handle
     3148         on error undo move_block, retry move_block
     3149         :
     3150           assign
     3151             v-object-handle = buf_temp-diasize-handle.handle-value
     3152           .
     3153           if v-object-handle <> v-diasize-resize-button
     3154           then do:
     3155             assign
     3156               v-object-handle :col = v-object-handle :col + p-change-value
     3157               no-error .
     3158             if error-status :error
     3159             or error-status :get-message(1) <> ""
     3160             then do:
     3161               undo move_block, retry move_block .
     3162             end.
     3163           end.
     3164         end.
     3165       end.
     3166       else do:
     3167         for each buf_temp-diasize-handle
     3168         on error undo move_block, retry move_block
     3169         :
     3170           assign
     3171             v-object-handle = buf_temp-diasize-handle.handle-value
     3172           .
     3173           if v-object-handle <> v-diasize-resize-button
     3174           then do:
     3175             assign
     3176               v-object-handle :col = v-object-handle :col + p-change-value
     3177               no-error .
     3178             if error-status :error
     3179             or error-status :get-message(1) <> ""
     3180             then do:
     3181               undo move_block, retry move_block .
     3182             end.
     3183           end.
     3184         end.
     3185         for each buf_temp-browse-handle
     3186           where buf_temp-browse-handle.browse-type = 'width':u
     3187         on error undo move_block, retry move_block
     3188         :
     3189           assign
     3190             buf_temp-browse-handle.browse-handle :width
     3191               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3192             no-error .
     3193           if error-status :error
     3194           or error-status :get-message(1) <> ""
     3195           then do:
     3196             undo move_block, retry move_block .
     3197           end.
     3198         end.
     3199         assign
     3200           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3201           no-error .
     3202         if error-status :error
     3203         or error-status :get-message(1) <> ""
     3204         then do:
     3205           undo move_block, retry move_block.
     3206         end.
     3207         assign
     3208           frame dialog-frame :width = frame dialog-frame :width + p-change-value
     3209         no-error .
     3210         if error-status :error
     3211         or error-status :get-message(1) <> ""
     3212         then do:
     3213           undo move_block, retry move_block.
     3214         end.
     3215         if frame dialog-frame :scrollable = true
     3216         then do:
     3217           assign
     3218             frame dialog-frame :virtual-width = frame dialog-frame :virtual-width + p-change-value
     3219           no-error .
     3220           if error-status :error
     3221           or error-status :get-message(1) <> ""
     3222           then do:
     3223             undo move_block, retry move_block.
     3224           end.
     3225         end.
     3226       end.
     3227       if p-move-resize
     3228       then do:
     3229         run diasize_position-resize-button in this-procedure .
     3230       end.
     3231       if v-diasize-wndstore = true
     3232       then do:
     3233         if connected("ub") = true
     3234         then do:
     3235           define variable v-cntxt-db-num        as integer   no-undo .
     3236           define variable v-cntxt-userid        as character no-undo .
     3237           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3238                                             , OUTPUT v-cntxt-userid
     3239                                             ) .
     3240           run gbl/wndsizew.p
     3241             (input  v-cntxt-db-num
     3242             ,input  v-cntxt-userid
     3243             ,input  v-diasize-proc-name
     3244             ,input  'width':u
     3245             ,input  string(frame dialog-frame :width - v-diasize-orig-frame-width)
     3246             ) .
     3247         end.
     3248       end.
     3249     end.
     3250     assign
     3251       v-diasize-change-size = false
     3252     .
     3253   end procedure.
     3254   procedure diasize_set-width :
     3255     define input  parameter p-new-width  as decimal   no-undo .
     3256     define input  parameter p-move-resize as logical   no-undo .
     3257     do
     3258     on error undo, return error return-value
     3259     :
     3260       run diasize_change-width in this-procedure
     3261         (input  (p-new-width - frame dialog-frame :width)
     3262         ,input  p-move-resize
     3263         ) .
     3264     end.
     3265   end procedure.
     3266   procedure diasize_position-resize-button :
     3267     do with frame dialog-frame
     3268     :
     3269       hide v-diasize-resize-button .
     3270       assign
     3271         v-diasize-resize-button :row = frame dialog-frame :height - v-diasize-resize-button :height
     3272                     - 1
     3273                     - (frame dialog-frame :border-bottom-pixels / session :pixels-per-row)
     3274         v-diasize-resize-button :col = frame dialog-frame :width - v-diasize-resize-button :width
     3275                     - 1
     3276                     - (frame dialog-frame :border-right-pixels / session :pixels-per-column)
     3277       .
     3278       view v-diasize-resize-button .
     3279     end.
     3280   end procedure.
     3281   on alt-right anywhere
     3282   do:
     3283     run diasize_change-width in this-procedure
     3284       (input 1
     3285       ,input true
     3286       ) .
     3287     return no-apply .
     3288   end.
     3289   on alt-left anywhere
     3290   do:
     3291     run diasize_change-width in this-procedure
     3292       (input -1
     3293       ,input true
     3294       ) .
     3295     return no-apply .
     3296   end.
     3297   on alt-down anywhere
     3298   do:
     3299     run diasize_change-height in this-procedure
     3300       (input 1
     3301       ,input true
     3302       ) .
     3303     return no-apply .
     3304   end.
     3305   on alt-up anywhere
     3306   do:
     3307     run diasize_change-height in this-procedure
     3308       (input -1
     3309       ,input true
     3310       ) .
     3311     return no-apply .
     3312   end.
     3313   on alt-enter of frame dialog-frame
     3314   do:
     3315     run diasize_maximize in this-procedure
     3316       (input  ?
     3317       ).
     3318     return no-apply .
     3319   end.
     3320   procedure diasize_end-move :
     3321     do
     3322     on error undo, return error return-value
     3323     :
     3324       define variable v-row-delta as decimal   no-undo .
     3325       define variable v-col-delta as decimal   no-undo .
     3326       define variable v-new-row as decimal   no-undo .
     3327       define variable v-new-col as decimal   no-undo .
     3328       assign
     3329         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3330         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3331       .
     3332       assign
     3333         v-row-delta = v-new-row - frame dialog-frame :height
     3334         v-col-delta = v-new-col - frame dialog-frame :width
     3335       .
     3336       run diasize_change-height in this-procedure
     3337         (input v-row-delta
     3338         ,input true
     3339         ) .
     3340       run diasize_change-width in this-procedure
     3341         (input v-col-delta
     3342         ,input true
     3343         ) .
     3344     end.
     3345   end procedure.
     3346   procedure diasize_maximize :
     3347     define input  parameter p-action as logical   no-undo .
     3348     do
     3349     on error undo, return error return-value
     3350     :
     3351       if p-action = ?
     3352       then do:
     3353         if v-diasize-need-maximize = true
     3354         then do:
     3355           assign
     3356             p-action = true
     3357           .
     3358         end.
     3359         else do:
     3360           assign
     3361             p-action = false
     3362           .
     3363         end.
     3364       end.
     3365       if p-action = true
     3366       then do:
     3367         run diasize_change-height in this-procedure
     3368           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3369               - frame dialog-frame :height-chars
     3370           ,input true
     3371           ) .
     3372         run diasize_change-width in this-procedure
     3373           (input session :width-chars
     3374               - frame dialog-frame :width-chars
     3375           ,input true
     3376           ) .
     3377         assign
     3378           v-diasize-need-maximize = false
     3379         .
     3380       end.
     3381       else do:
     3382         run diasize_change-width in this-procedure
     3383           (input v-diasize-orig-frame-width
     3384               - frame dialog-frame :width-chars
     3385           ,input true
     3386           ) .
     3387         run diasize_change-height in this-procedure
     3388           (input v-diasize-orig-frame-height
     3389               - frame dialog-frame :height-chars
     3390           ,input true
     3391           ) .
     3392         assign
     3393           v-diasize-need-maximize = true
     3394         .
     3395       end.
     3396     end.
     3397   end procedure.
     3398   procedure diasize_restore-orig-size :
     3399     do
     3400     on error undo, return error return-value
     3401     :
     3402       assign
     3403         v-diasize-current-frame-width  = frame dialog-frame :width
     3404         v-diasize-current-frame-height = frame dialog-frame :height
     3405       .
     3406       run diasize_set-height in this-procedure
     3407         (input  v-diasize-orig-frame-height
     3408         ,input  true
     3409         ) .
     3410       run diasize_set-width in this-procedure
     3411         (input  v-diasize-orig-frame-width
     3412         ,input  true
     3413         ) .
     3414     end.
     3415   end procedure.
     3416   procedure diasize_restore-current-size :
     3417     do
     3418     on error undo, return error return-value
     3419     :
     3420       run diasize_set-height in this-procedure
     3421         (input  v-diasize-current-frame-height
     3422         ,input  true
     3423         ) .
     3424       run diasize_set-width in this-procedure
     3425         (input  v-diasize-current-frame-width
     3426         ,input  true
     3427         ) .
     3428     end.
     3429   end procedure.
     3430   procedure diasize_set-browse-handle :
     3431     define input  parameter p-browse-handle as handle   no-undo .
     3432     define buffer buf_temp-browse-handle for temp-browse-handle .
     3433     do
     3434     on error undo, return error return-value
     3435     :
     3436       assign
     3437         v-diasize-browse-handle = p-browse-handle
     3438       .
     3439       for each buf_temp-browse-handle
     3440       on error undo, return error return-value
     3441       :
     3442         delete buf_temp-browse-handle .
     3443       end.
     3444     end.
     3445   end procedure.
     3446   procedure diasize_add_browse :
     3447     define input  parameter p-browse-type   as character no-undo .
     3448     define input  parameter p-browse-handle as handle    no-undo .
     3449     define buffer buf_temp-browse-handle for temp-browse-handle .
     3450     do
     3451     on error undo, return error return-value
     3452     :
     3453       assign
     3454         v-diasize-browse-number = v-diasize-browse-number + 1
     3455       .
     3456       create buf_temp-browse-handle .
     3457       assign
     3458         buf_temp-browse-handle.browse-type   = p-browse-type
     3459         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3460         buf_temp-browse-handle.browse-handle = p-browse-handle
     3461       .
     3462     end.
     3463   end procedure.
     3464   procedure diasize_init :
     3465     define variable v-default-value    as logical   no-undo .
     3466     define variable v-restore-saved    as logical   no-undo .
     3467     define variable v-resize-value-str as character no-undo .
     3468     do
     3469     on error undo, return error return-value
     3470     :
     3471       do with frame dialog-frame
     3472       :
     3473         assign
     3474           v-diasize-orig-frame-height = frame dialog-frame :height
     3475           v-diasize-orig-frame-width  = frame dialog-frame :width
     3476           v-diasize-browse-handle     = browse br-docs :handle
     3477         .
     3478         create button v-diasize-resize-button
     3479         assign
     3480           parent        = frame dialog-frame :first-child
     3481           label         = "s"
     3482           height-pixels = 16
     3483           width-pixels  = 16
     3484           visible       = true
     3485           sensitive     = true
     3486           movable       = true
     3487           triggers:
     3488             on end-move persistent run diasize_end-move in this-procedure .
     3489           end triggers.
     3490         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3491         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3492         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3493         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3494         assign
     3495           v-diasize-wndmax = false
     3496         .
     3497         if connected("ub") = true
     3498         then do:
     3499           define variable v-cntxt-db-num        as integer   no-undo .
     3500           define variable v-cntxt-userid        as character no-undo .
     3501           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3502                                             , OUTPUT v-cntxt-userid
     3503                                             ) .
     3504           run gbl/wndpar_r.p
     3505             (input  v-cntxt-db-num
     3506             ,input  v-cntxt-userid
     3507             ,input  'wndmax':U
     3508             ,output v-diasize-wndmax
     3509             ,output v-default-value
     3510             ) .
     3511         end.
     3512         assign
     3513           v-diasize-wndstore = false
     3514         .
     3515         if connected("ub") = true
     3516         then do:
     3517           run gbl/wndpar_r.p
     3518             (input  v-cntxt-db-num
     3519             ,input  v-cntxt-userid
     3520             ,input  'wndstore':U
     3521             ,output v-diasize-wndstore
     3522             ,output v-default-value
     3523             ) .
     3524         end.
     3525         assign
     3526           v-diasize-proc-name = entry(1, program-name(2), '.')
     3527         .
     3528         if v-diasize-wndstore = true
     3529         then do:
     3530           assign
     3531             v-restore-saved = false
     3532           .
     3533           if connected("ub") = true
     3534           then do:
     3535             run gbl/wndsizer.p
     3536               (input  v-cntxt-db-num
     3537               ,input  v-cntxt-userid
     3538               ,input  v-diasize-proc-name
     3539               ,input  'height':u
     3540               ,output v-resize-value-str
     3541               ) .
     3542             if v-resize-value-str <> '':U
     3543             then do:
     3544               run diasize_change-height in this-procedure
     3545                 (input  integer(v-resize-value-str)
     3546                 ,input  true
     3547                 ) .
     3548               assign
     3549                 v-restore-saved = true
     3550               .
     3551             end.
     3552           end.
     3553           if connected("ub") = true
     3554           then do:
     3555             run gbl/wndsizer.p
     3556               (input  v-cntxt-db-num
     3557               ,input  v-cntxt-userid
     3558               ,input  v-diasize-proc-name
     3559               ,input  'width':u
     3560               ,output v-resize-value-str
     3561               ) .
     3562             if v-resize-value-str <> '':U
     3563             then do:
     3564               run diasize_change-width in this-procedure
     3565                 (input  integer(v-resize-value-str)
     3566                 ,input  true
     3567                 ) .
     3568               assign
     3569                 v-restore-saved = true
     3570               .
     3571             end.
     3572           end.
     3573           if v-restore-saved <> true
     3574           then do:
     3575             if v-diasize-wndmax = true
     3576             then do:
     3577               run diasize_maximize in this-procedure
     3578                 (input  true
     3579                 ) .
     3580             end.
     3581           end.
     3582         end.
     3583         else do:
     3584           if v-diasize-wndmax = true
     3585           then do:
     3586             run diasize_maximize in this-procedure
     3587               (input  true
     3588               ) .
     3589           end.
     3590         end.
     3591       end.
     3592     end.
     3593   end procedure.
     3594   procedure diasize_need-full-display :
     3595     define output parameter p-need-full-display as logical   no-undo .
     3596     do
     3597     on error undo, return error return-value
     3598     :
     3599       assign
     3600         p-need-full-display = v-diasize-need-full-display
     3601       .
     3602       assign
     3603         v-diasize-need-full-display = false
     3604       .
     3605     end.
     3606   end procedure.
     3607   procedure get-context :
     3608      define output parameter p-db-num as integer          no-undo.
     3609      define output parameter p-user-id as character        no-undo.
     3610      define variable v-login               as character    no-undo.
     3611      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3612      define buffer buf_user-login  for ub.user-login .
     3613      do
     3614      on error undo, return error
     3615      :
     3616            FIND FIRST buf_sys-ctrl no-lock.
     3617            ASSIGN
     3618               v-login = USERID("ub")
     3619               p-db-num = buf_sys-ctrl.db-num
     3620            .
     3621            FIND FIRST buf_user-login
     3622                 WHERE buf_user-login.db-num = p-db-num
     3623                   AND buf_user-login.user-login = v-login
     3624                 no-lock
     3625                 no-error
     3626                 .
     3627            IF AVAILABLE buf_user-login
     3628            THEN DO:
     3629               assign
     3630                  p-user-id = buf_user-login.user-id
     3631               .
     3632            END.
     3633      end.
     3634   end procedure.
     3635       run diasize_init in this-procedure .
     3636   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3637   on ' ' of loc-date-ship in frame dialog-frame
     3638   do:
     3639     if (can-query (self, "sensitive")
     3640        and
     3641        self :sensitive = true
     3642        )
     3643     or (can-query (self, "read-only")
     3644        and
     3645        self :read-only = false
     3646        )
     3647     then do:
     3648       assign
     3649         self :screen-value = ?
     3650       .
     3651     end.
     3652     return no-apply.
     3653   end.
     3654   on delete-character of loc-date-ship in frame dialog-frame
     3655   do:
