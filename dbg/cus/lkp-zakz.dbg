     1492   define query br-docs-2 for
     1493         shar_ord-line, b-goods, ub.ord-dtl, buf-goods , ub.gds-prt scrolling.
     1494   function roundordline return decimal (buffer local-ord-line for shar_ord-line):
     1495     find first ub.goods where ub.goods.artic     = local-ord-line.artic     and
     1496                            ub.goods.prod-type = local-ord-line.prod-type and
     1497                            ub.goods.prod-code = local-ord-line.prod-code no-lock.
     1498     find first ub.units where ub.units.unit-name = ub.goods.unit-cli.
     1499     if (lookup('шту':U, ub.units.type) > 0
     1500     or lookup('сер':U, ub.units.type) > 0 ) and
     1501       local-ord-line.cli-qnty <> truncate(local-ord-line.cli-qnty, 0) then do:
     1502         return truncate(local-ord-line.cli-qnty, 0) + 1 .
     1503     end.
     1504     else do:
     1505       return local-ord-line.cli-qnty.
     1506     end.
     1507   end function.
     1508   define variable varroundordline as decimal no-undo.
     1509   define browse br-docs
     1510     query br-docs no-lock display
     1511         loc-err-rcv                   column-label "~!!":c1  format "x(1)"
     1512         shar_ord-line.line-num        column-label '№!п/п'   format ">>>>"
     1513         shar_ord-line.prt-ok          column-label 'ш! '    format "+/-"
