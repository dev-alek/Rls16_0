     1078   procedure uf-get :
     1079     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1080     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1081     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1082     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1083     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1084     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1085     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1086     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1087     do
     1088     on error undo, return error
     1089     :
     1090       define buffer buf_usr-flt for ubflt.usr-flt .
     1091       define variable v-use-List_     as logical   no-undo .
     1092       define variable v-type-List_     as character no-undo .
     1093       define variable v-format-List_   as character no-undo .
     1094       define variable v-use-Naim      as logical   no-undo .
     1095       define variable v-type-Naim      as character no-undo .
     1096       define variable v-format-Naim    as character no-undo .
     1097       define variable v-use-print-graft as logical   no-undo .
     1098       define variable v-use-sort-gr     as logical   no-undo .
     1099       define variable v-use-type-price  as logical   no-undo .
     1100       define variable v-use-type-val    as logical   no-undo .
     1101       define variable v-label          as character no-undo .
     1102       define variable v-tooltip        as character no-undo .
     1103       define variable v-user-can-edit  as logical   no-undo .
     1104       define variable v-output-display as logical   no-undo .
     1105       define variable v-other          as character no-undo .
     1106       run uf-name in this-procedure
     1107          (input  entry(1, p-code, chr(4))
     1108         ,output v-use-List_
     1109         ,output v-type-List_
     1110         ,output v-format-List_
     1111         ,output v-use-Naim
     1112         ,output v-type-Naim
     1113         ,output v-format-Naim
     1114         ,output v-use-print-graft
     1115         ,output v-use-sort-gr
     1116         ,output v-use-type-price
     1117         ,output v-use-type-val
     1118         ,output v-label
     1119         ,output v-tooltip
     1120         ,output v-user-can-edit
     1121         ,output v-output-display
     1122         ,output v-other
     1123         ) no-error .
     1124       if error-status :error then do:
     1125         undo, return error return-value .
     1126       end.
     1127       find first buf_usr-flt no-lock where
     1128                  buf_usr-flt.Call-point     = p-code AND
     1129                  buf_usr-flt.user-name       = p-user-name
     1130         no-error .
     1131       if avail buf_usr-flt then do:
     1132         assign
     1133         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1134         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1135         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1136         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1137         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1138         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1139         .
     1140       end.
     1141       else do:
     1142         assign
     1143         p-List_        = (if v-use-List_       then "":U                    else ?)
     1144         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1145         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1146         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1147         p-type-price   = (if v-use-type-price  then no                      else ?)
     1148         p-type-val     = (if v-use-List_       then no                      else ?)
     1149         .
     1150       end.
     1151     end.
     1152   end procedure.
     1153   procedure uf-set :
     1154     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1155     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1156     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1157     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1158     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1159     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1160     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1161     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1162     do
     1163     on error undo, return error
     1164     :
     1165       define buffer buf_usr-flt for ubflt.usr-flt .
     1166       define variable v-use-List_     as logical   no-undo .
     1167       define variable v-type-List_     as character no-undo .
     1168       define variable v-format-List_   as character no-undo .
     1169       define variable v-use-Naim      as logical   no-undo .
     1170       define variable v-type-Naim      as character no-undo .
     1171       define variable v-format-Naim    as character no-undo .
     1172       define variable v-use-print-graft as logical   no-undo .
     1173       define variable v-use-sort-gr   as logical   no-undo .
     1174       define variable v-use-type-price as logical   no-undo .
     1175       define variable v-use-type-val  as logical   no-undo .
     1176       define variable v-tooltip        as character no-undo .
     1177       define variable v-label          as character no-undo .
     1178       define variable v-user-can-edit  as logical   no-undo .
     1179       define variable v-output-display as logical   no-undo .
     1180       define variable v-other          as character no-undo .
     1181       run uf-name in this-procedure
     1182         (input  entry(1, p-code, chr(4))
     1183         ,output v-use-List_
     1184         ,output v-type-List_
     1185         ,output v-format-List_
     1186         ,output v-use-Naim
     1187         ,output v-type-Naim
     1188         ,output v-format-Naim
     1189         ,output v-use-print-graft
     1190         ,output v-use-sort-gr
     1191         ,output v-use-type-price
     1192         ,output v-use-type-val
     1193         ,output v-label
     1194         ,output v-tooltip
     1195         ,output v-user-can-edit
     1196         ,output v-output-display
     1197         ,output v-other
     1198         ) no-error .
     1199       if error-status :error then do:
     1200         undo, return error return-value .
     1201       end.
     1202       find first buf_usr-flt where
     1203                  buf_usr-flt.Call-point     = p-code AND
     1204                  buf_usr-flt.user-name       = p-user-name
     1205         no-error .
     1206       if not avail buf_usr-flt then do:
     1207           create buf_usr-flt .
     1208           assign
     1209           buf_usr-flt.call-point = p-code
     1210           buf_usr-flt.user-name  = p-user-name
     1211           .
     1212       end.
     1213       if avail buf_usr-flt then do:
     1214        assign
     1215        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1216        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1217        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1218        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1219        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1220        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1221       .
     1222       release buf_usr-flt.
     1223       end.
     1224       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1225     end.
     1226   end procedure.
