      221   def
      222   new shared
      223   temp-table  obj-list no-undo
      224     field obj-type like ub.clients.obj-type
      225     field obj-code like ub.clients.obj-code
      226     field obj-name like ub.clients.obj-name
      227     field obj-id   as integer
