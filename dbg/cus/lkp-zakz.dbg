     4305   def var sort-labelbr-docs   as character no-undo .
     4306   def var sort-clmnbr-docs    as handle    no-undo .
     4307   def var cur-clmnbr-docs     as handle    no-undo .
     4308   def var cur-clmn-locbr-docs as integer   no-undo .
     4309   def var re-querybr-docs     as logical   initial no no-undo .
     4310   on start-search, ctrl-o of br-docs in frame dialog-frame do:
     4311      run sort-brbr-docs
     4312        (input (if available shar_ord-line
     4313                then recid(shar_ord-line)
     4314                else ?
     4315               )
     4316        ).
     4317   end.
     4318   PROCEDURE sort-brbr-docs :
     4319     define input parameter p-recid as recid no-undo .
     4320     if re-querybr-docs = no then do:
     4321       assign
     4322          cur-clmnbr-docs = br-docs:current-column in frame dialog-frame
     4323       .
     4324       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     4325       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     4326         assign
     4327            sort-labelbr-docs = ""
     4328            sort-clmnbr-docs = ?
     4329         .
     4330        end.
     4331        else do:
     4332          assign
     4333            sort-labelbr-docs = cur-clmnbr-docs:label
     4334            sort-clmnbr-docs  = cur-clmnbr-docs
     4335            sort-clmnbr-docs:column-fgcolor = 4
     4336          .
     4337        end.
     4338      end.
     4339     assign
     4340       cur-clmn-locbr-docs = 1
     4341     .
     4342     def var column-handle as handle no-undo .
     4343     column-handle = br-docs:first-column.
     4344     do while valid-handle(column-handle) :
     4345       if column-handle = cur-clmnbr-docs then do:
     4346         leave .
     4347       end.
     4348       column-handle = column-handle:NEXT-COLUMN.
     4349       assign
     4350         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     4351       .
     4352     end.
     4353     case sort-labelbr-docs:
     4354           when loc-err-rcv:label in browse br-docs then DO:   assign     sort-column-name = "loc-err-rcv"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY loc-err-rcv .   . END.
     4355           when shar_ord-line.line-num:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.line-num"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.line-num .   . END.
     4356           when shar_ord-line.prt-ok:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.prt-ok"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.prt-ok .   . END.
     4357           when shar_ord-line.artic:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.artic"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.artic .   . END.
     4358           when buf-goods.gds-name:label in browse br-docs then DO:   assign     sort-column-name = "buf-goods.gds-name"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY buf-goods.gds-name .   . END.
     4359           when shar_ord-line.unit-cli:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.unit-cli"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.unit-cli .   . END.
     4360           when shar_ord-line.cli-qnty:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.cli-qnty"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.cli-qnty .   . END.
     4361           when shar_ord-line.order-cli-qnty:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.order-cli-qnty"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.order-cli-qnty .   . END.
     4362           when shar_ord-line.price-cli:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.price-cli"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.price-cli .   . END.
     4363           when shar_ord-line.ord-dec1:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.ord-dec1"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.ord-dec1 .   . END.
     4364           when shar_ord-line.sum-cli:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.sum-cli"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.sum-cli .   . END.
     4365           when shar_ord-line.cli-art:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.cli-art"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.cli-art .   . END.
     4366           when buf-goods.unit-base:label in browse br-docs then DO:   assign     sort-column-name = "buf-goods.unit-base"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY buf-goods.unit-base .   . END.
     4367           when shar_ord-line.qnty:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.qnty"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.qnty .   . END.
     4368           when shar_ord-line.price-rubl:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.price-rubl"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.price-rubl .   . END.
     4369           when shar_ord-line.sum-rubl:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.sum-rubl"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.sum-rubl .   . END.
     4370           when loc-sum-rcv:label in browse br-docs then DO:   assign     sort-column-name = "loc-sum-rcv"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY loc-sum-rcv .   . END.
     4371           when shar_ord-line.qnty-stk:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.qnty-stk"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.qnty-stk .   . END.
     4372           when v-fact-qnty:label in browse br-docs then DO:   assign     sort-column-name = "v-fact-qnty"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY v-fact-qnty .   . END.
     4373           when shar_ord-line.gds-code:label in browse br-docs then DO:   assign     sort-column-name = "shar_ord-line.gds-code"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY shar_ord-line.gds-code .   . END.
     4374           when v-min-stock:label in browse br-docs then DO:   assign     sort-column-name = "v-min-stock"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY v-min-stock .   . END.
     4375           when v-gds-way:label in browse br-docs then DO:   assign     sort-column-name = "v-gds-way"   .   open query br-docs for each shar_ord-line no-lock where shar_ord-line.doc-code = p-doc-code ,each buf-goods no-lock where  buf-goods.artic = shar_ord-line.artic and  buf-goods.prod-type = shar_ord-line.prod-type and  buf-goods.prod-code = shar_ord-line.prod-code BY v-gds-way .   . END.
     4376       otherwise do:
     4377         assign
     4378           sort-column-name = ""
     4379         .
     4380         run openbr.
     4381         if sort-labelbr-docs <> "" then do:
     4382           assign
     4383             cur-clmnbr-docs:column-fgcolor = 0
     4384           .
     4385         end.
     4386         assign
     4387           cur-clmn-locbr-docs = ?
     4388         .
     4389       end.
     4390     end case.
     4391     if p-recid <> ? then do:
     4392       reposition br-docs to recid p-recid no-error.
     4393       apply "value-changed" to br-docs in frame dialog-frame.
     4394     end.
     4395     apply "entry" to br-docs in frame dialog-frame.
     4396   END PROCEDURE.
     4397   procedure re-open-query-srt-clmnbr-docs:
     4398   if cur-clmnbr-docs = ? then do:
     4399      run openbr.
     4400   end.
     4401   else do:
     4402      assign re-querybr-docs = yes.
     4403      run sort-brbr-docs
     4404        (input (if available shar_ord-line
     4405                then recid(shar_ord-line)
     4406                else ?
     4407               )
     4408        ).
     4409      assign re-querybr-docs = no.
     4410   end.
     4411   end.
     4412   def var sort-labelbr-docs-2   as character no-undo .
     4413   def var sort-clmnbr-docs-2    as handle    no-undo .
     4414   def var cur-clmnbr-docs-2     as handle    no-undo .
     4415   def var cur-clmn-locbr-docs-2 as integer   no-undo .
     4416   def var re-querybr-docs-2     as logical   initial no no-undo .
     4417   on start-search, ctrl-o of br-docs-2 in frame frame-a do:
     4418      run sort-brbr-docs-2
     4419        (input (if available shar_ord-line
     4420                then recid(shar_ord-line)
     4421                else ?
     4422               )
     4423        ).
     4424   end.
     4425   PROCEDURE sort-brbr-docs-2 :
     4426     define input parameter p-recid as recid no-undo .
     4427     if re-querybr-docs-2 = no then do:
     4428       assign
     4429          cur-clmnbr-docs-2 = br-docs-2:current-column in frame frame-a
     4430       .
