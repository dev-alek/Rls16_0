     1562   procedure uf-get :
     1563     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1564     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1565     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1566     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1567     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1568     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1569     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1570     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1571     do
     1572     on error undo, return error
     1573     :
     1574       define buffer buf_usr-flt for ubflt.usr-flt .
     1575       define variable v-use-List_     as logical   no-undo .
     1576       define variable v-type-List_     as character no-undo .
     1577       define variable v-format-List_   as character no-undo .
     1578       define variable v-use-Naim      as logical   no-undo .
     1579       define variable v-type-Naim      as character no-undo .
     1580       define variable v-format-Naim    as character no-undo .
     1581       define variable v-use-print-graft as logical   no-undo .
     1582       define variable v-use-sort-gr     as logical   no-undo .
     1583       define variable v-use-type-price  as logical   no-undo .
     1584       define variable v-use-type-val    as logical   no-undo .
     1585       define variable v-label          as character no-undo .
     1586       define variable v-tooltip        as character no-undo .
     1587       define variable v-user-can-edit  as logical   no-undo .
     1588       define variable v-output-display as logical   no-undo .
     1589       define variable v-other          as character no-undo .
     1590       run uf-name in this-procedure
     1591          (input  entry(1, p-code, chr(4))
     1592         ,output v-use-List_
     1593         ,output v-type-List_
     1594         ,output v-format-List_
     1595         ,output v-use-Naim
     1596         ,output v-type-Naim
     1597         ,output v-format-Naim
     1598         ,output v-use-print-graft
     1599         ,output v-use-sort-gr
     1600         ,output v-use-type-price
     1601         ,output v-use-type-val
     1602         ,output v-label
     1603         ,output v-tooltip
     1604         ,output v-user-can-edit
     1605         ,output v-output-display
     1606         ,output v-other
     1607         ) no-error .
     1608       if error-status :error then do:
     1609         undo, return error return-value .
     1610       end.
     1611       find first buf_usr-flt no-lock where
     1612                  buf_usr-flt.Call-point     = p-code AND
     1613                  buf_usr-flt.user-name       = p-user-name
     1614         no-error .
     1615       if avail buf_usr-flt then do:
     1616         assign
     1617         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1618         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1619         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1620         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1621         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1622         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1623         .
     1624       end.
     1625       else do:
     1626         assign
     1627         p-List_        = (if v-use-List_       then "":U                    else ?)
     1628         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1629         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1630         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1631         p-type-price   = (if v-use-type-price  then no                      else ?)
     1632         p-type-val     = (if v-use-List_       then no                      else ?)
     1633         .
     1634       end.
     1635     end.
     1636   end procedure.
     1637   procedure uf-set :
     1638     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1639     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1640     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1641     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1642     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1643     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1644     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1645     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1646     do
     1647     on error undo, return error
     1648     :
     1649       define buffer buf_usr-flt for ubflt.usr-flt .
     1650       define variable v-use-List_     as logical   no-undo .
     1651       define variable v-type-List_     as character no-undo .
     1652       define variable v-format-List_   as character no-undo .
     1653       define variable v-use-Naim      as logical   no-undo .
     1654       define variable v-type-Naim      as character no-undo .
     1655       define variable v-format-Naim    as character no-undo .
     1656       define variable v-use-print-graft as logical   no-undo .
     1657       define variable v-use-sort-gr   as logical   no-undo .
     1658       define variable v-use-type-price as logical   no-undo .
     1659       define variable v-use-type-val  as logical   no-undo .
     1660       define variable v-tooltip        as character no-undo .
     1661       define variable v-label          as character no-undo .
     1662       define variable v-user-can-edit  as logical   no-undo .
     1663       define variable v-output-display as logical   no-undo .
     1664       define variable v-other          as character no-undo .
     1665       run uf-name in this-procedure
     1666         (input  entry(1, p-code, chr(4))
     1667         ,output v-use-List_
     1668         ,output v-type-List_
     1669         ,output v-format-List_
     1670         ,output v-use-Naim
     1671         ,output v-type-Naim
     1672         ,output v-format-Naim
     1673         ,output v-use-print-graft
     1674         ,output v-use-sort-gr
     1675         ,output v-use-type-price
     1676         ,output v-use-type-val
     1677         ,output v-label
     1678         ,output v-tooltip
     1679         ,output v-user-can-edit
     1680         ,output v-output-display
     1681         ,output v-other
     1682         ) no-error .
     1683       if error-status :error then do:
     1684         undo, return error return-value .
     1685       end.
     1686       find first buf_usr-flt where
     1687                  buf_usr-flt.Call-point     = p-code AND
     1688                  buf_usr-flt.user-name       = p-user-name
     1689         no-error .
     1690       if not avail buf_usr-flt then do:
     1691           create buf_usr-flt .
     1692           assign
     1693           buf_usr-flt.call-point = p-code
     1694           buf_usr-flt.user-name  = p-user-name
     1695           .
     1696       end.
     1697       if avail buf_usr-flt then do:
     1698        assign
     1699        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1700        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1701        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1702        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1703        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1704        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1705       .
     1706       release buf_usr-flt.
     1707       end.
     1708       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1709     end.
     1710   end procedure.
     1711   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1712     define variable v-cntxt-db-num        as integer   no-undo .
     1713     define variable v-cntxt-userid        as character no-undo .
     1714     define variable v-cntxt-level         as character no-undo .
     1715     define variable v-cntxt-host-code-obj as integer   no-undo .
     1716     define variable v-cntxt-obj-type      as character no-undo .
     1717     define variable v-cntxt-obj-code      as integer   no-undo .
     1718     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1719     define variable v-cntxt-is-admin      as logical   no-undo .
     1720   define variable State-source as Widget-Handle.
     1721   DEFINE VARIABLE f-cdpay-code AS INTEGER NO-UNDO.
     1722   DEFINE VARIABLE f-curr-code AS INTEGER NO-UNDO.
     1723   define buffer buf_dis-card-type for ub.dis-card-type.
     1724   DEFINE BUTTON b-cashpay
     1725        IMAGE-UP FILE "btn-down-arrow":U
     1726        IMAGE-DOWN FILE "btn-down-arrow":U
     1727        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1728        LABEL "":L
     1729        SIZE 3 BY 1
     1730        BGCOLOR 8 FGCOLOR 0 .
     1731   DEFINE VARIABLE f-obj-name AS CHARACTER FORMAT "X(256)":U
     1732        LABEL "Платеж-списание бонусов"
     1733         VIEW-AS TEXT
     1734        SIZE 28.5 BY .67
     1735        FGCOLOR 4  NO-UNDO.
     1736   DEFINE VARIABLE f-schema-code AS INTEGER FORMAT "999999999":U INITIAL 0
     1737        LABEL "№ бонусной схемы"
     1738        VIEW-AS FILL-IN
     1739        SIZE 10 BY 1 NO-UNDO.
     1740   DEFINE RECTANGLE RECT-checks
     1741        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1742        SIZE 62.38 BY 10.25.
     1743   DEFINE VARIABLE TOG-1 AS LOGICAL INITIAL no
     1744        LABEL "Часть 1 - Оборот по товару"
     1745        VIEW-AS TOGGLE-BOX
     1746        SIZE 60 BY .83 TOOLTIP "Лист отчета ~"Движение Нефтепродуктов по количеству~"" NO-UNDO.
     1747   DEFINE VARIABLE TOG-2 AS LOGICAL INITIAL no
     1748        LABEL "Часть 2 - Оборот по обслуживанию"
     1749        VIEW-AS TOGGLE-BOX
     1750        SIZE 60 BY .83 TOOLTIP "Лист отчета ~"Движение Нефтепродуктов по количеству и суммам~"" NO-UNDO.
     1751   DEFINE VARIABLE TOG-3 AS LOGICAL INITIAL no
     1752        LABEL "Часть 3 - Оборот по датам"
     1753        VIEW-AS TOGGLE-BOX
     1754        SIZE 60 BY .83 TOOLTIP "Лист отчета ~"Движение ТНП по количеству и суммам~"" NO-UNDO.
     1755   DEFINE FRAME F-Main
     1756        f-schema-code AT ROW 2.08 COL 19 COLON-ALIGNED
     1757        b-cashpay AT ROW 3.92 COL 58
     1758        TOG-1 AT ROW 6.5 COL 2.5
     1759        TOG-2 AT ROW 7.5 COL 2.5
     1760        TOG-3 AT ROW 8.5 COL 2.5
     1761        f-obj-name AT ROW 4.21 COL 4
     1762        "Показать :" VIEW-AS TEXT
     1763             SIZE 11.5 BY .75 AT ROW 5.79 COL 11.88
     1764             FGCOLOR 4
     1765        RECT-checks AT ROW 1.25 COL 1.5
     1766       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1767            SIDE-LABELS NO-UNDERLINE THREE-D
     1768            AT COL 1 ROW 1
     1769            SIZE 63.88 BY 10.92.
     1770   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1771   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1772   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1773   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1774   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1775   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1776   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1777   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1778       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1779   RUN ensure-broker.
     1780   THIS-PROCEDURE:ADM-DATA =
     1781        'ADM1.1~`':U +
     1782        'SmartObject~`':U +
     1783        'FRAME~`':U +
     1784        'NO ~`':U +
     1785        '~`':U +
     1786        '~`':U +
     1787        '~`':U +
     1788        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1789           + "~`":U +
     1790        'Layout,Hide-on-Init~`':U +
     1791        '~`':U +
     1792        '~`':U +
     1793        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1794        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1795            THEN "^^":U
     1796        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1797             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1798   PROCEDURE adm-apply-entry :
     1799     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1800   END PROCEDURE.
     1801   PROCEDURE adm-destroy :
     1802    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1803   END PROCEDURE.
     1804   PROCEDURE adm-disable :
     1805       DISABLE RECT-checks f-schema-code b-cashpay TOG-1 TOG-2 TOG-3 f-obj-name WITH FRAME F-Main.
     1806       RUN dispatch ('disable-fields':U).
     1807       RUN set-attribute-list ('ENABLED=no':U).
     1808       RETURN.
     1809   END PROCEDURE.
     1810   PROCEDURE adm-edit-attribute-list :
     1811         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1812         RETURN.
     1813   END PROCEDURE.
     1814   PROCEDURE adm-enable :
     1815       ENABLE UNLESS-HIDDEN RECT-checks f-schema-code b-cashpay TOG-1 TOG-2 TOG-3 f-obj-name WITH FRAME F-Main.
     1816       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1817       RUN set-attribute-list ('ENABLED=yes':U).
     1818       RETURN.
     1819   END PROCEDURE.
     1820   PROCEDURE adm-exit :
     1821        RUN notify ('exit':U).
     1822     RETURN.
     1823   END PROCEDURE.
     1824   PROCEDURE adm-hide :
     1825     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1826   END PROCEDURE.
     1827   PROCEDURE adm-initialize :
     1828     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1829   END PROCEDURE.
     1830   PROCEDURE adm-show-errors :
     1831       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1832       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1833           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1834       END.
     1835       RETURN.
     1836   END PROCEDURE.
     1837   PROCEDURE adm-UIB-mode :
     1838     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1839   END PROCEDURE.
     1840   PROCEDURE adm-view :
     1841     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1842   END PROCEDURE.
     1843   PROCEDURE dispatch :
     1844       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1845       RUN broker-dispatch IN adm-broker-hdl
     1846           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1847       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1848   END PROCEDURE.
     1849   PROCEDURE ensure-broker :
     1850   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1851   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1852   DO:
     1853       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1854       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1855   END.
     1856   END PROCEDURE.
     1857   PROCEDURE get-attribute :
     1858     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1859     RUN broker-get-attribute IN adm-broker-hdl
     1860         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1861     RETURN RETURN-VALUE.
     1862   END PROCEDURE.
     1863   PROCEDURE get-attribute-list :
     1864     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1865     RUN broker-get-attribute-list IN adm-broker-hdl
     1866         (INPUT THIS-PROCEDURE,
     1867          INPUT ?,
     1868          OUTPUT p-attr-list) NO-ERROR.
     1869     RETURN.
     1870   END PROCEDURE.
     1871   PROCEDURE new-state :
     1872     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1873     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1874     RETURN.
     1875   END PROCEDURE.
     1876   PROCEDURE notify :
     1877     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1878     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1879     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1880         RETURN "ADM-ERROR":U.
     1881     RETURN.
     1882   END PROCEDURE.
     1883   PROCEDURE set-attribute-list :
     1884     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1885     RUN ensure-broker.
     1886     RUN broker-set-attribute-list IN adm-broker-hdl
     1887         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1888     RETURN.
     1889   END PROCEDURE.
     1890   PROCEDURE set-position :
     1891       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1892       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1893       IF VALID-HANDLE(adm-object-hdl) THEN
     1894       DO:
     1895           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1896           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1897           DO:
     1898             IF p-row = 0 THEN p-row =
     1899               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1900             IF p-col = 0 THEN p-col =
     1901               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1902           END.
     1903           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1904           DO:
     1905             parent-hdl = adm-object-hdl:PARENT.
     1906             IF p-row = 0 THEN p-row =
     1907               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1908                 parent-hdl:ROW.
     1909             IF p-col = 0 THEN p-col =
     1910               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1911                 parent-hdl:COL.
     1912           END.
     1913           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1914           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1915         ASSIGN adm-object-hdl:ROW    =   p-row
     1916                adm-object-hdl:COLUMN =   p-col.
     1917       END.
     1918       RETURN.
     1919   END PROCEDURE.
     1920   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1921       STRING(adm-object-hdl)).
     1922   PAUSE 0 BEFORE-HIDE.
     1923   PROCEDURE adm-change-page :
     1924     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1925     END PROCEDURE.
     1926   PROCEDURE delete-page :
     1927     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1928     RUN broker-delete-page IN adm-broker-hdl
     1929         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1930     END PROCEDURE.
     1931   PROCEDURE init-object :
     1932     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1933     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1934     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1935     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1936     RUN broker-init-object IN adm-broker-hdl
     1937         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1938          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1939     RETURN.
     1940   END PROCEDURE.
     1941   PROCEDURE init-pages :
     1942     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1943     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1944         INPUT p-page-list) NO-ERROR.
     1945     END PROCEDURE.
     1946   PROCEDURE select-page :
     1947     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1948     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1949         INPUT p-page#) NO-ERROR.
     1950     END PROCEDURE.
     1951   PROCEDURE view-page :
     1952     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1953     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1954         INPUT p-page#).
     1955     END PROCEDURE.
     1956   ON CHOOSE OF b-cashpay IN FRAME F-Main
     1957   DO:
     1958       define variable v-rid-list as character no-undo.
     1959       DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     1960       run ref/cashpays.w (
     1961                      input parparentproc
     1962                     ,input "b-sel"
     1963                     ,input 'все':U
     1964                     ,input v-cntxt-host-code-obj
     1965                     ,input v-cntxt-obj-type
     1966                     ,input v-cntxt-obj-code
     1967                     ,output v-rid-list ).
     1968       if v-rid-list <> "":U then do:
     1969         FIND FIRST buf_cash-pay WHERE
     1970                 recid( buf_cash-pay ) = integer(entry(1, v-rid-list)) NO-LOCK .
     1971        DISPLAY
     1972        buf_cash-pay.obj-name @ f-obj-name
     1973        with frame F-Main .
     1974        assign
     1975        f-cdpay-code = buf_cash-pay.cdpay-code
     1976        f-curr-code = buf_cash-pay.curr-code
     1977        .
     1978      end.
     1979   END.
     1980   ON VALUE-CHANGED OF TOG-3 IN FRAME F-Main
     1981   DO:
     1982     ASSIGN tog-3.
     1983     IF NOT tog-3 THEN
     1984       DO:
     1985         DISABLE  WITH FRAME F-Main .
     1986       END.
     1987       ELSE DO:
     1988         ENABLE   WITH FRAME F-Main .
     1989       END.
     1990     DISPLAY  WITH FRAME F-Main .
     1991   END.
     1992   if not this-procedure :persistent
     1993   then do:
     1994     message
     1995       vss-workfile vss-revision vss-description skip
     1996       "Ошибка при запуске процедуры" skip
     1997       "Данную процедуру следует запускать только с параметром persistent" skip
     1998       view-as alert-box error .
     1999     undo, return error .
     2000   end.
     2001   parparentproc = my-handle.
     2002   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2003     run mainmenu_getcntxt in parparentproc
     2004       (output v-cntxt-db-num
     2005       ,output v-cntxt-userid
     2006       ,output v-cntxt-level
     2007       ,output v-cntxt-host-code-obj
     2008       ,output v-cntxt-obj-type
     2009       ,output v-cntxt-obj-code
     2010       ,output v-cntxt-db-num-obj
     2011       ,output v-cntxt-is-admin
     2012       ) .
     2013   PROCEDURE adm-create-objects :
     2014   END PROCEDURE.
     2015   PROCEDURE adm-row-available :
     2016     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2017     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2018     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2019     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2020     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2021     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2022     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2023     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2024     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2025     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2026     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2027     IF adm-updating-record THEN RETURN.
     2028     RUN get-attribute ('FIELDS-ENABLED':U).
     2029     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2030     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2031         OUTPUT link-handle) NO-ERROR.
     2032     IF link-handle = "":U THEN
     2033         RETURN.
     2034     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2035     IF NUM-ENTRIES(link-handle) > 1 THEN
     2036         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2037             "encountered more than one RECORD-SOURCE.":U SKIP
     2038             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2039                VIEW-AS ALERT-BOX ERROR.
     2040     RUN get-attribute ('Key-Name':U).
     2041     key-name = RETURN-VALUE.
     2042     IF key-name = "":U THEN key-name = ?.
     2043     IF key-name NE ? THEN DO:
     2044       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2045         NO-ERROR.
     2046       IF key-value NE ? THEN
     2047         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2048     END.
     2049   IF VALID-HANDLE (adm-object-hdl) THEN
     2050       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2051   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2052   END PROCEDURE.
     2053   PROCEDURE disable_UI :
     2054     HIDE FRAME F-Main.
     2055     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2056   END PROCEDURE.
     2057   PROCEDURE enable_UI :
     2058     DISPLAY f-schema-code TOG-1 TOG-2 TOG-3 f-obj-name
     2059         WITH FRAME F-Main.
     2060     ENABLE RECT-checks f-schema-code b-cashpay TOG-1 TOG-2 TOG-3 f-obj-name
     2061         WITH FRAME F-Main.
     2062   END PROCEDURE.
     2063   PROCEDURE local-initialize :
     2064   define buffer buf_cash-pay for ub.cash-pay.
     2065   run uf-get in this-procedure (
     2066        input  'bon1-rep':U
     2067       ,input  v-cntxt-userid
     2068       ,output v-uf-List_
     2069       ,output v-uf-Naim
     2070       ,output v-uf-print-graft
     2071       ,output v-uf-sort-gr
     2072       ,output v-uf-type-price
     2073       ,output v-uf-type-val
     2074   )  no-error.
     2075   if not error-status:error
     2076   and num-entries(v-uf-List_, chr(4)) = 3 then do:
     2077     assign
     2078     f-schema-code = integer(entry(1, v-uf-List_, chr(4)))
     2079     f-cdpay-code = integer(entry(2, v-uf-List_, chr(4)))
     2080     f-curr-code = integer(entry(3, v-uf-List_, chr(4)))
     2081     NO-ERROR
     2082     .
     2083     FIND FIRST buf_cash-pay NO-LOCK WHERE
     2084               buf_cash-pay.cdpay-code = f-cdpay-code
     2085           AND buf_cash-pay.curr-code = f-curr-code NO-ERROR.
     2086     IF AVAILABLE buf_cash-pay THEN DO:
     2087       ASSIGN
     2088       f-obj-name = buf_cash-pay.obj-name.
     2089     END.
     2090     ELSE DO:
     2091         ASSIGN
     2092         buf_cash-pay.cdpay-code = 0
     2093         buf_cash-pay.curr-code = 0
     2094         f-obj-name = chr(63).
     2095     END.
     2096   end.
     2097   run enable_UI IN THIS-PROCEDURE.
     2098   END PROCEDURE.
     2099   PROCEDURE My-Report :
     2100   run cus/r-bonus1.p (
     2101                   INPUT my-handle
     2102                 , INPUT tog-1
     2103                 , INPUT tog-2
     2104                 , INPUT tog-3
     2105                 , INPUT f-schema-code
     2106                 , input f-cdpay-code
     2107                 , input f-curr-code
     2108                 ) .
     2109   END PROCEDURE.
     2110   PROCEDURE My-var :
     2111    assign
     2112    FRAME F-Main
     2113    f-schema-code
     2114    tog-1
     2115    tog-2
     2116    tog-3
     2117    .
     2118    if f-schema-code = 0
     2119    or (TOG-1 = NO AND TOG-2 = NO AND TOG-3 = no)
     2120    OR f-cdpay-code = 0  THEN DO:
     2121     message
     2122     "Вы не ввели параметры для формирования отчета" skip(1)
     2123     (if f-schema-code  = 0
     2124      then ("Введите код бонусной схемы"  + chr(10))
     2125      else "":U)
     2126     (IF (TOG-1 = NO AND TOG-2 = NO AND TOG-3 = no)
     2127      then ("Выберите части отчета, которые Вы хотите вывести"  + chr(10))
     2128      else "":U)
     2129     (IF f-cdpay-code = 0
     2130      THEN "Выберите тип кассового платежа, соответствующий списанию бонусов"
     2131      ELSE "":U)
     2132      view-as alert-box error .
     2133      return error .
     2134    end.
     2135    assign
     2136    v-uf-list_ = string(f-schema-code, "99999999":U) + chr(4) +
     2137                 STRING(f-cdpay-code, "999999999":U) + chr(4) +
     2138                 STRING(f-curr-code, "999999999":U)
     2139   .
     2140     run uf-set in this-procedure (
     2141        input  'bon1-rep':U
     2142       ,input  v-cntxt-userid
     2143       ,input v-uf-List_
     2144       ,input v-uf-Naim
     2145       ,input v-uf-print-graft
     2146       ,input v-uf-sort-gr
     2147       ,input v-uf-type-price
     2148       ,input v-uf-type-val
     2149   )  no-error .
     2150   Assign
     2151    STR-obj-type = ''
     2152    STR-obj-code = ''
     2153    STR-obj-name = ''
     2154    STR-obj      = ''.
     2155   For each obj-list no-lock:
     2156    Assign
     2157    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2158    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2159    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2160    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2161   End.
     2162   ReportHeader =
     2163                  substitute("Код бонусной схемы: &1&2"
     2164                 , f-schema-code
     2165                 , chr(10))
     2166                   .
     2167   END PROCEDURE.
     2168   PROCEDURE send-records :
     2169   END PROCEDURE.
     2170   PROCEDURE state-changed :
     2171     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2172     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2173   END PROCEDURE.
