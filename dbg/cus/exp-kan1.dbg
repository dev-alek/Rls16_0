        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Экспорт результатов продаж".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     define variable v-cntxt-db-num        as integer   no-undo .
      115     define variable v-cntxt-userid        as character no-undo .
      116     define variable v-cntxt-level         as character no-undo .
      117     define variable v-cntxt-host-code-obj as integer   no-undo .
      118     define variable v-cntxt-obj-type      as character no-undo .
      119     define variable v-cntxt-obj-code      as integer   no-undo .
      120     define variable v-cntxt-db-num-obj    as integer   no-undo .
      121     define variable v-cntxt-is-admin      as logical   no-undo .
      122   define temp-table mapobj no-undo
      123   field obj-type as character
      124   field obj-code as integer
      125   field kan-code as character
      126   index pi is unique primary obj-type obj-code.
      127   define variable map-str as character no-undo.
      128   define variable c_obj-type as character no-undo.
      129   define variable i_obj-code as integer no-undo.
      130   define variable c_kan-code as character no-undo.
      131   input from value(search('mapobj.txt')).
      132   repeat:
      133     import unformatted map-str.
      134     assign
      135     c_obj-type = entry(1, entry(1, map-str, ';'), ',')
      136     i_obj-code = integer(entry(2, entry(1, map-str, ';'), ','))
      137     c_kan-code = entry(2, map-str, ';') no-error.
      138     if error-status:error then do:
      139         message "Ошибка при чтении файла mapobj.txt" view-as alert-box error.
      140         return.
      141     end.
      142     create mapobj.
      143     assign
      144     mapobj.obj-type = c_obj-type
      145     mapobj.obj-code = i_obj-code
      146     mapobj.kan-code = c_kan-code.
      147   end.
      148   input close.
      149   define stream txt.
      150   define variable v_os-file as char no-undo.
      151   define variable prt-name as char no-undo.
      152   define variable t1 as char no-undo.
      153   define variable nal as logical no-undo.
      154   define variable beznal as logical no-undo.
      155   define variable ToP as char no-undo.
      156   define variable dcrd as char no-undo.
      157   define variable v-obj as character no-undo.
      158   define variable VAT-p like ub.tax-rate-value.rate-value no-undo .
      159   define variable SLT-p like ub.tax-rate-value.rate-value no-undo .
      160   DEFINE BUTTON B-file
      161        IMAGE-UP FILE "btn-down-arrow":U
      162        IMAGE-DOWN FILE "btn-down-arrow":U
      163        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      164        LABEL ""
      165        SIZE 3 BY 1.
      166   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      167        LABEL "Cancel"
      168        SIZE 15 BY 1.13
      169        BGCOLOR 8 .
      170   DEFINE BUTTON Btn_OK AUTO-GO
      171        LABEL "OK"
      172        SIZE 15 BY 1.13
      173        BGCOLOR 8 .
      174   DEFINE VARIABLE date-beg AS DATE FORMAT "99/99/9999":U
      175        LABEL "Даты С"
      176        VIEW-AS FILL-IN
      177        SIZE 12 BY 1 NO-UNDO.
      178   DEFINE VARIABLE date-End AS DATE FORMAT "99/99/9999":U
      179        LABEL "По"
      180        VIEW-AS FILL-IN
      181        SIZE 11.5 BY 1 NO-UNDO.
      182   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      183        LABEL "Файл"
      184        VIEW-AS FILL-IN
      185        SIZE 39 BY 1 NO-UNDO.
      186   DEFINE FRAME Dialog-Frame
      187        date-beg AT ROW 1.5 COL 9 COLON-ALIGNED
      188        date-End AT ROW 1.5 COL 28.5 COLON-ALIGNED
      189        file-name AT ROW 3 COL 1.5
      190        B-file AT ROW 3 COL 47
      191        Btn_OK AT ROW 4.5 COL 9.5
      192        Btn_Cancel AT ROW 4.5 COL 29
      193        SPACE(6.12) SKIP(0.28)
      194       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      195            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      196            TITLE "Экспорт чеков в файл"
      197            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      198   ASSIGN
      199          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      200          FRAME Dialog-Frame:HIDDEN           = TRUE.
      201   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      202   DO:
      203     APPLY "END-ERROR":U TO SELF.
      204   END.
      205   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      206   DO:
      207       DEF VAR ll_commit AS LOG    NO-UNDO INIT NO.
      208       SYSTEM-DIALOG GET-FILE v_os-file
      209           TITLE "Выберите файл для экспорта"
      210           FILTERS
      211             " Текстовые файлы (*.txt) " "*.txt",
      212             " Все файлы (*.*) "                      "*.*"
      213           ask-overwrite
      214           save-as
      215           use-filename
      216           update ll_commit
      217           default-extension "txt"
      218           .
      219       IF ll_commit <> YES THEN do:
      220          RETURN NO-APPLY.
      221       end.
      222       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      223           BELL.
      224           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      225           RETURN NO-APPLY.
      226       END.
      227       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      228       DISP file-name WITH FRAME Dialog-Frame.
      229   END.
      230   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      231   DO:
      232     assign
      233           date-beg
      234           date-end
      235           .
      236     if date-beg > date-end then do:
      237            message "Дата начала периода должна быть меньше даты конца". pause.
      238     end.
      239     else if date-beg = ? then do:
      240            message "Не задана дата C". pause  .
      241     end.
      242     else if date-end = ? then do:
      243            message "Не задана дата По". pause.
      244     end.
      245     else do:
      246           if trim(v_os-file) = "" then do:
      247                message "Не задан файл для экспорта". pause.
      248           end.
      249           else do:
      250                 output stream txt to value (v_os-file) no-echo.
      251                 put stream txt  unformatted
      252                    "SHOP ID; CASH REGISTER ID; ID NUMBER OF DOCUMENT; DATE; TIME; INDEX-COLOR-SIZE; QUANTITY; PRICE WITHOUT DISCOUNT OF ONE ITEM; VAT IN %; SALES IN %; AMOUNT OF DISCOUNT OF ONE ITEM; TYPE OF PAYMENT; FIDELITY CARD NUMBER"
      253                 skip.
      254                 _chk-doc:
      255                 FOR EACH chk-doc NO-LOCK where
      256                        chk-doc.obj-type = v-cntxt-obj-type  and
      257                        chk-doc.obj-code = v-cntxt-obj-code  and
      258                        chk-doc.chk-date >= date-beg   and
      259                        chk-doc.chk-date <= date-end
      260                      by chk-doc.chk-date
      261                      by chk-doc.chk-time
      262                      by chk-doc.pay-desk
      263                      :
      264                      if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
      265                      display
      266                               chk-doc.doc-code
      267                               chk-doc.chk-date
      268                            with frame ff view-as dialog-box
      269                            title ": Экспорт чеков в файл".
      270                      pause 0.
      271                      find first mapobj no-lock where mapobj.obj-type = chk-doc.obj-type
      272                                                  and mapobj.obj-code = chk-doc.obj-code no-error.
      273                      if available mapobj then v-obj = mapobj.kan-code.
      274                      else v-obj = 'R' + string(chk-doc.obj-code, "99").
      275                      assign
      276                      nal = false
      277                         beznal = FALSE
      278                         .
      279                      for each chk-pay no-lock where
      280                                     chk-pay.doc-code = chk-doc.doc-code:
      281                             if chk-pay.pay-code = 1 then    nal = TRUE.
      282                             else  beznal = TRUE.
      283                      end.
      284                      if nal and beznal then ToP = "MX".
      285                      else if nal then ToP = "GO".
      286                      else if beznal then ToP = "KK".
      287                      for each chk-gds no-lock where
      288                                   chk-gds.doc-code = chk-doc.doc-code and
      289                                   chk-gds.doc-qnty <> 0 ,
      290                           FIRST bar-code No-LOCK WHERE
      291                                     bar-code.b-code = chk-gds.b-code :
      292                           FIND FIRSt goods WHERE
      293                                           goods.gds-code = bar-code.gds-code NO-LOCK.
      294                           FIND FIRST gds-prt WHERE
      295                                             gds-prt.node-code = bar-code.node-code NO-LOCK.
      296                           assign
      297                               vat-p = ?
      298                               SLT-p = ?
      299                               .
      300   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      302     (input  goods.gds-code
      303     ,input  '1':U
      304     ,input  ?
      305     ,input  v-cntxt-host-code-obj
      306     ,input  v-cntxt-obj-type
      307     ,input  v-cntxt-obj-code
      308     ,output vat-p
      309     ) no-error .
      310   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      312     (input  goods.gds-code
      313     ,input  '2':U
      314     ,input  ?
      315     ,input  v-cntxt-host-code-obj
      316     ,input  v-cntxt-obj-type
      317     ,input  v-cntxt-obj-code
      318     ,output slt-p
      319     ) no-error .
      320                           prt-name =( if gds-prt.node-name = '_Пустая шкала':U then "-"
      321                                              else ( if gds-prt.upper-code = goods.prt-root
      322                                                          then "-------------------" else gds-prt.f-name ) ) .
      323                           t1  = "-".
      324                           if r-index(prt-name, "/") > 0 then overlay ( prt-name, r-index(prt-name, "/"), 1) = t1.
      325    if chk-doc.d-card = ? or chk-doc.d-card = "" then dcrd = "0".
      326                           else dcrd = chk-doc.d-card.
      327                           put stream txt  unformatted
      328                                  trim(string(v-obj)) + ";" +
      329                                  trim(string(chk-doc.pay-desk,">999"))  + ";" +
      330                                  trim(string(chk-doc.cashier,">999"))  + ";" +
      331                                  trim(string(chk-doc.chk-num)) + ";" +
      332                                  trim(string(year(chk-doc.chk-date), "9999")) + "-" +
      333                                  trim(string(month(chk-doc.chk-date), "99")) + "-" +
      334                                  trim(string(DAY(chk-doc.chk-date), "99")) + ";" +
      335                                  trim(string(chk-doc.chk-time, "HH:MM:SS")) + ";" +
      336                                  trim(string(goods.artic)) + "-" +
      337                                  trim(string(prt-name)) + ";" +
      338                                  trim(string(chk-gds.doc-qnty)) + ";" +
      339                                  trim(string(chk-gds.price-base)) + ";" +
      340                                  trim(string(vat-p)) + ";" +
      341                                  trim(string(slt-p)) + ";" +
      342                                  trim(string(chk-gds.discnt)) + ";" +
      343                                  trim(string(ToP)) + ";" +
      344                                  trim(string(dcrd))
      345                           skip.
      346                      end.
      347                 end.
      348                 output close.
      349                 message "Экспорт в файл закончен.".
      350           end.
      351     end.
      352   END.
      353   ON LEAVE OF file-name IN FRAME Dialog-Frame
      354   DO:
      355       ASSIGN file-name.
      356       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      357           ASSIGN FILE-INFO:FILE-NAME = file-name.
      358           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      359           DISP file-name WITH FRAME Dialog-Frame.
      360       END.
      361       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
      362   END.
      363   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      364   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      365   MAIN-BLOCK:
      366   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      367      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      368   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369     run mainmenu_getcntxt in parparentproc
      370       (output v-cntxt-db-num
      371       ,output v-cntxt-userid
      372       ,output v-cntxt-level
      373       ,output v-cntxt-host-code-obj
      374       ,output v-cntxt-obj-type
      375       ,output v-cntxt-obj-code
      376       ,output v-cntxt-db-num-obj
      377       ,output v-cntxt-is-admin
      378       ) .
      379     if v-cntxt-obj-type <> 'маг':U then do:
      380       message "Текущий объект не МАГАЗИН!"
      381       view-as alert-box ERROR.
      382       BELL.
      383       return error.
      384     end.
      385     date-beg = today.
      386     date-end = today.
      387     assign
      388     date-beg
      389     date-end.
      390     RUN enable_UI.
      391     WAIT-FOR GO OF FRAME Dialog-Frame.
      392   END.
      393   RUN disable_UI.
      394   PROCEDURE disable_UI :
      395     HIDE FRAME Dialog-Frame.
      396   END PROCEDURE.
      397   PROCEDURE enable_UI :
      398     DISPLAY date-beg date-End file-name
      399         WITH FRAME Dialog-Frame.
      400     ENABLE date-beg date-End file-name B-file Btn_OK Btn_Cancel
      401         WITH FRAME Dialog-Frame.
      402     VIEW FRAME Dialog-Frame.
      403   END PROCEDURE.
