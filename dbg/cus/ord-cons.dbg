     1007     APPLY "END-ERROR":U TO SELF.
     1008   END.
     1009   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1010   DO:
     1011     run cus/g-crord.p (input parParentProc).
     1012     OPEN QUERY br-docs FOR EACH shar-buf_ord-cons       WHERE shar-buf_ord-cons.host-code = v-cntxt-host-code-obj and (p-status = "all":U  or (shar-buf_ord-cons.status_ = p-status) ) NO-LOCK     BY shar-buf_ord-cons.doc-date DESCENDING        BY shar-buf_ord-cons.cons-code DESCENDING.
     1013   END.
     1014   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1015   DO:
     1016   find current shar-buf_ord-cons no-lock no-error .       if not avail shar-buf_ord-cons then do:                        message                                          "Документ не выбран ! " view-as  alert-box .        return no-apply.                                     end.
     1017     if available shar-buf_ord-cons and (shar-buf_ord-cons.status_ <> 'новый':U
     1018                        and shar-buf_ord-cons.status_ <> 'распределение':U
     1019                        and shar-buf_ord-cons.status_ <> 'закрыто':U) then do:
     1020        message "Изменять документ в статусе  '" shar-buf_ord-cons.status_ "' нельзя! " view-as alert-box .
     1021        return no-apply.
     1022     end.
     1023     if available shar-buf_ord-cons and (shar-buf_ord-cons.status_ = 'новый':U
     1024                          OR shar-buf_ord-cons.status_ = 'распределение':U
     1025                          OR shar-buf_ord-cons.status_ = 'закрыто':U
     1026                          ) then do:
     1027         run cus/or-plan.w ( parParentProc , input shar-buf_ord-cons.cons-code , 'ИЗМЕНЕНИЕ':U, list-mode) no-error .
     1028         if error-status :error then do:
     1029           find current shar-buf_ord-cons  no-lock  no-error .
     1030           return no-apply.
     1031         end.
     1032         find current shar-buf_ord-cons  no-lock  no-error .
     1033         if error-status :error then do:
     1034            OPEN QUERY br-docs FOR EACH shar-buf_ord-cons       WHERE shar-buf_ord-cons.host-code = v-cntxt-host-code-obj and (p-status = "all":U  or (shar-buf_ord-cons.status_ = p-status) ) NO-LOCK     BY shar-buf_ord-cons.doc-date DESCENDING        BY shar-buf_ord-cons.cons-code DESCENDING.
     1035         end.
     1036         else do:
     1037         g#log =  br-docs:refresh() .
     1038         end.
     1039     end.
     1040   END.
     1041   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     1042   DO:
     1043   find current shar-buf_ord-cons no-lock no-error .       if not avail shar-buf_ord-cons then do:                        message                                          "Документ не выбран ! " view-as  alert-box .        return no-apply.                                     end.
     1044   if available shar-buf_ord-cons then do:
     1045     doc-rec = recid(shar-buf_ord-cons).
     1046     run cus/consstat.p ( parParentProc , recid(shar-buf_ord-cons)).
     1047     g#log =  br-docs:refresh() .
     1048   end.
     1049   END.
     1050   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1051   DO:
     1052   define buffer loc_ord-doc for ub.ord-doc .
     1053   find current shar-buf_ord-cons no-lock no-error .       if not avail shar-buf_ord-cons then do:                        message                                          "Документ не выбран ! " view-as  alert-box .        return no-apply.                                     end.
     1054     if available shar-buf_ord-cons and shar-buf_ord-cons.status_ <> 'новый':U then do:
     1055        message "Удалять документ в статусе  '" shar-buf_ord-cons.status_ "' нельзя! " view-as alert-box .
     1056        return no-apply.
     1057     end.
     1058       if available shar-buf_ord-cons and shar-buf_ord-cons.status_ = 'новый':U then do:
     1059          find current shar-buf_ord-cons exclusive-lock no-error.
     1060               if avail shar-buf_ord-cons then do:
     1061                  message "Удалить совокупную заявку №"  shar-buf_ord-cons.cons-code view-as alert-box
     1062                           question buttons yes-no title "Вопрос" update g#log.
     1063                       if g#log then do:
     1064                           for each loc_ord-doc where loc_ord-doc.cons-code = shar-buf_ord-cons.cons-code  OR
     1065                                    loc_ord-doc.cons-code = shar-buf_ord-cons.cons-code + 'отказ':U
     1066                                    exclusive-lock  :
     1067                              assign
     1068                                  old-state = loc_ord-doc.status_
     1069                                  loc_ord-doc.cons-code = ""
     1070                                  loc_ord-doc.status_ = 'согласование':U
     1071                              .
     1072                              run str/callnews.p     ( input "ord-doc"      , input (buffer loc_ord-doc:handle)     ) no-error .   if error-status:error then do:     assign loc_ord-doc.flag_ = false  loc_ord-doc.status_ = old-state .     message                                                      vss-workfile vss-revision vss-description skip             "Ошибка при передаче "                                     (if loc_ord-doc.doc-type  =  'ОФ':U then " заявки " else "заказа" )            " в новости" skip                                          "Документ" loc_ord-doc.doc-code skip                             view-as alert-box .                                        return no-apply.                                       end.
     1073                           end.
     1074                           delete  shar-buf_ord-cons .
     1075                           OPEN QUERY br-docs FOR EACH shar-buf_ord-cons       WHERE shar-buf_ord-cons.host-code = v-cntxt-host-code-obj and (p-status = "all":U  or (shar-buf_ord-cons.status_ = p-status) ) NO-LOCK     BY shar-buf_ord-cons.doc-date DESCENDING        BY shar-buf_ord-cons.cons-code DESCENDING.
     1076                       end.
     1077                  end.
     1078     end.
     1079   END.
     1080   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1081   DO:
     1082    find current shar-buf_ord-cons no-lock no-error .       if not avail shar-buf_ord-cons then do:                        message                                          "Документ не выбран ! " view-as  alert-box .        return no-apply.                                     end.
     1083       if available shar-buf_ord-cons then do:
     1084         run cus/or-plan.w ( parParentProc , input shar-buf_ord-cons.cons-code  ,input 'ПРОСМОТР':U , list-mode) .
     1085     end.
