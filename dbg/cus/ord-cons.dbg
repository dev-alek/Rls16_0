     1088   DO:
     1089   find current shar-buf_ord-cons no-lock no-error .       if not avail shar-buf_ord-cons then do:                        message                                          "Документ не выбран ! " view-as  alert-box .        return no-apply.                                     end.
     1090   if available shar-buf_ord-cons then do:
     1091     doc-rec = recid(shar-buf_ord-cons).
     1092     loc-doc-rec = recid(shar-buf_ord-cons).
     1093     g#log =  br-docs:refresh() .
