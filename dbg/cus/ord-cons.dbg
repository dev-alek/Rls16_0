      650     define variable v-cntxt-userid        as character no-undo .
      651     define variable v-cntxt-level         as character no-undo .
      652     define variable v-cntxt-host-code-obj as integer   no-undo .
      653     define variable v-cntxt-obj-type      as character no-undo .
      654     define variable v-cntxt-obj-code      as integer   no-undo .
      655     define variable v-cntxt-db-num-obj    as integer   no-undo .
      656     define variable v-cntxt-is-admin      as logical   no-undo .
      657   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      658   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      659   procedure fltopend_fltopend :
      660   define input parameter p-parent-handle as handle no-undo .
      661   define input parameter p-qh as handle no-undo .
      662   define input parameter p-flt-open-open-query  as character no-undo .
      663   define input parameter p-where-cond as character no-undo .
      664   define input parameter p-use-indFIRST-query-tail as character no-undo .
      665   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      666   define input parameter p-indexed-reposition as character no-undo .
      667     do
      668     on error undo, return error
      669     :
      670   define variable v-prepare-string as character no-undo .
      671   define variable glog as logical no-undo .
      672   assign
      673   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      674                      p-where-cond + chr(32)  +
      675                      p-use-indFIRST-query-tail + chr(32) +
      676                      p-use-ind-sort-clmn-by + chr(32) +
      677                      p-indexed-reposition
      678   .
      679   assign
      680   glog = p-qh:query-prepare(v-prepare-string) no-error .
      681   if not glog
      682   or error-status:error then do:
      683     message error-status:get-message(1) view-as alert-box .
      684     undo, return error .
      685   end.
      686   assign
      687   glog = p-qh:query-open no-error .
      688   if not glog
      689   or error-status:error then do:
      690     message error-status:get-message(1) view-as alert-box .
      691     undo, return error .
      692   end.
      693     end.
      694   end procedure.
      695   procedure fltopend_fltfindd :
      696   define input parameter p-parent-handle as handle no-undo .
      697   define input parameter p-qh as handle no-undo .
      698   define input parameter p-rowid as rowid no-undo .
      699   define input parameter p-next as logical no-undo .
      700   define input parameter p-lock as integer no-undo .
      701   define input parameter p-bh as handle no-undo .
      702   define input parameter p-where-cond as character no-undo .
      703   define input parameter p-use-index-phrase as character no-undo .
      704   define variable glog as logical no-undo .
      705   define variable v-qh as handle no-undo .
      706   define variable v-bh as handle no-undo .
      707   define variable v-recid as recid no-undo .
      708   define variable v-prepare-string as character no-undo .
      709   do
      710   on error undo, return error
      711   on stop undo, return error
      712   :
      713     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      714     create buffer v-bh for table p-bh buffer-name p-bh:name.
      715     create query v-qh.
      716     v-qh:set-buffers(v-bh).
      717     v-prepare-string = substitute("for each &1 &2 &3"
      718                                     ,v-bh:name
      719                                     ,p-where-cond
      720                                     ,p-use-index-phrase).
      721     glog = v-qh:query-prepare(v-prepare-string) no-error.
      722     if not glog then do:
      723       delete object v-qh.
      724       delete object v-bh.
      725       undo, return error .
      726     end.
      727     glog = v-qh:query-open no-error .
      728     if not glog then do:
      729       delete object v-qh.
      730       delete object v-bh.
      731       undo, return error .
      732     end.
      733     if p-next then do:
      734       v-qh:reposition-to-rowid(p-rowid) no-error .
      735       glog = v-qh:get-next( p-lock) no-error .
      736       glog = v-qh:get-next( p-lock) no-error .
      737       if not glog or v-qh:query-off-end = yes then do:
      738         glog = v-qh:get-first( p-lock) no-error .
      739       end.
      740     end.
      741     else do:
      742       glog = v-qh:get-first( p-lock) no-error .
      743     end.
      744     v-recid = v-bh:recid no-error .
      745     delete object v-qh.
      746     delete object v-bh.
      747     return string(v-recid) .
      748   end.
      749   end procedure.
      750   procedure fltopend_fltfindq :
      751   define input parameter p-parent-handle as handle no-undo .
      752   define input parameter p-qh as handle no-undo .
      753   define input parameter p-next as logical no-undo .
      754   define input parameter p-lock as integer no-undo .
      755   define input parameter p-flt-open-open-query  as character no-undo .
      756   define input parameter p-where-cond as character no-undo .
      757   define input parameter p-use-indFIRST-query-tail as character no-undo .
      758   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      759   define input parameter p-indexed-reposition as character no-undo .
      760   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      761   define variable glog as logical no-undo .
      762   define variable v-qh as handle no-undo .
      763   define variable v-bh as handle no-undo extent 18.
      764   define variable v-rowid as rowid no-undo extent 18.
      765   define variable v-ii as integer no-undo .
      766   define variable v-prepare-string as character no-undo .
      767   do
      768   on error undo, return error
      769   on stop undo, return error
      770   :
      771     create query v-qh.
      772     do v-ii = 1 to p-qh:num-buffers:
      773       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      774       assign
      775       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      776       no-error.
      777       v-qh:add-buffer(v-bh[v-ii]).
      778     end.
      779     assign
      780     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      781                       p-where-cond + chr(32)  +
      782                       p-use-indFIRST-query-tail + chr(32) +
      783                       p-use-ind-sort-clmn-by + chr(32) +
      784                       p-indexed-reposition
      785     .
      786     glog = v-qh:query-prepare( v-prepare-string) no-error .
      787     if not glog then do:
      788       delete object v-qh.
      789       do v-ii = 1 to p-qh:num-buffers:
      790         delete object v-bh[v-ii].
      791       end.
      792       undo, return error .
      793     end.
      794     glog = v-qh:query-open no-error .
      795     if not glog then do:
      796       delete object v-qh.
      797       do v-ii = 1 to p-qh:num-buffers:
      798         delete object v-bh[v-ii].
      799       end.
      800       undo, return error .
      801     end.
      802     if p-next then do:
      803       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      804       glog = v-qh:get-next( p-lock) no-error .
      805       glog = v-qh:get-next( p-lock) no-error .
      806       if not glog or v-qh:query-off-end = yes then do:
      807         glog = v-qh:get-first( p-lock) no-error .
      808       end.
      809     end.
      810     else do:
      811       glog = v-qh:get-first( p-lock) no-error .
      812     end.
      813     do v-ii = 1 to p-qh:num-buffers:
      814       assign
      815       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      816       no-error.
      817     end.
      818     delete object v-qh.
      819     do v-ii = 1 to p-qh:num-buffers:
      820       delete object v-bh[v-ii].
      821     end.
      822   end.
      823   end procedure.
