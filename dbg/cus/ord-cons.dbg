        1   DEFINE NEW SHARED BUFFER shar-buf_ord-cons FOR ub.ord-cons.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init " Список совокупных заказов   ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define variable c-point  as character no-undo .
      124   define variable tbl      as character no-undo .
      125   define variable join-tbl as character no-undo .
      126   define variable fld      as character no-undo .
      127   define variable lab      as character no-undo .
      128   define variable spr      as character no-undo .
      129   define variable dim      as character no-undo .
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   procedure cur-time :
      132      define output parameter p-today as date      no-undo .
      133      define output parameter p-time  as integer   no-undo .
      134     do
      135     on error undo, return error
      136     :
      137       define variable v-date1 as date      no-undo .
      138       define variable v-date2 as date      no-undo .
      139       define variable v-time  as integer   no-undo .
      140       assign
      141         v-date1 = today
      142         v-time  = time
      143         v-date2 = today
      144       .
      145       if v-date1 <> v-date2
      146       then do:
      147         assign
      148           v-date1 = today
      149           v-time  = v-time
      150         .
      151       end.
      152       assign
      153         p-today = v-date1
      154         p-time  = v-time
      155       .
      156     end.
      157   end.
      158   function cur-time-date returns character
      159   :
      160     return string(today, '99/99/9999':U) .
      161   end.
      162   function cur-time-mjd returns decimal
      163   :
      164     define variable v-date as date      no-undo .
      165     define variable v-time as integer   no-undo .
      166     run cur-time in this-procedure
      167       (output v-date
      168       ,output v-time
      169       ) .
      170     return integer(v-date) - 2400002 + (v-time / 86400) .
      171   end.
      172   function cur-time-get-ending-index returns integer
      173   (input p-number as integer
      174   )
      175   :
      176     if p-number < 0
      177     or p-number = ?
      178     then do:
      179       return 1 .
      180     end.
      181     define variable v-rest as integer   no-undo .
      182     assign
      183       p-number = p-number modulo 100
      184     .
      185     if p-number < 20
      186     then do:
      187       assign
      188         v-rest = p-number
      189       .
      190     end.
      191     else do:
      192       assign
      193         v-rest = p-number modulo 10
      194       .
      195     end.
      196     case v-rest :
      197       when 1
      198       then do:
      199         return 2 .
      200       end.
      201       when 2 or
      202       when 3 or
      203       when 4
      204       then do:
      205         return 3 .
      206       end.
      207       otherwise do:
      208         return 1 .
      209       end.
      210     end case .
      211   end.
      212   procedure cur-time-mjd-to-date :
      213      define input  parameter i-mjd-diff as decimal no-undo.
      214      define output parameter o-Date     as date    no-undo.
      215      define output parameter o-Time     as integer no-undo.
      216      define variable v-day-number as integer   no-undo .
      217      if    i-mjd-diff < 0
      218         or i-mjd-diff = ?
      219      then do:
      220         return "?" .
      221      end.
      222      assign
      223         v-day-number = truncate(i-mjd-diff,0).
      224         o-Date = date(v-day-number + 2400002).
      225         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      226     .
      227   end.
      228   function cur-time-mjd-to-string returns character
      229   (input p-mjd-diff as decimal
      230   )
      231   :
      232     define variable v-day-number as integer   no-undo .
      233     define variable v-seconds    as integer   no-undo .
      234     define variable v-hour       as integer   no-undo .
      235     define variable v-min        as integer   no-undo .
      236     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      237     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      238     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      239     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      240     if p-mjd-diff < 0
      241     or p-mjd-diff = ?
      242     then do:
      243       return "?" .
      244     end.
      245     assign
      246       v-day-number = integer(truncate(p-mjd-diff,0))
      247       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      248     .
      249     if v-seconds > 86400
      250     then do:
      251       assign
      252         v-seconds = 86400 - 1
      253       .
      254     end.
      255     if v-seconds < 0
      256     then do:
      257       assign
      258         v-seconds = 0
      259       .
      260     end.
      261     assign
      262       v-hour = truncate(v-seconds / 3600, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 3600
      266     .
      267     assign
      268       v-min = truncate(v-seconds / 60, 0)
      269     .
      270     assign
      271       v-seconds = v-seconds modulo 60
      272     .
      273     return
      274         (if v-day-number <> 0
      275           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      276           else ""
      277         )
      278       + (if v-day-number <> 0 or v-hour <> 0
      279           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      283           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      284           else ""
      285         )
      286       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      287       .
      288   end.
      289   function cur-time-string returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-string-sec returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      308   end.
      309   function cur-time-custom  returns character
      310   (input p-prefix as character
      311   ,input p-date-format as character
      312   ,input p-delimiter as character
      313   ,input p-time-format as character
      314   ,input p-suffix as character
      315   )
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return
      324       p-prefix
      325       + string(v-date, p-date-format)
      326       + p-delimiter
      327       + string(v-time, p-time-format)
      328       + p-suffix
      329       .
      330   end.
      331   function cur-time-print  returns character
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      340   end.
      341   function cur-time-datetime returns datetime
      342   :
      343     define variable v-char as character no-undo .
      344     define variable v-datetime as datetime no-undo .
      345     v-char = cur-time-string().
      346     v-datetime = datetime(v-char).
      347     return  v-datetime.
      348   end.
      349   function cur-time-string-msec returns character
      350   :
      351     define variable v-date as datetime  no-undo .
      352     v-date = now.
      353     return string(v-date) .
      354   end.
      355   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   procedure fltfield-clear :
      357     define output parameter loc-fld as character no-undo.
      358     define output parameter loc-lab as character no-undo .
      359     define output parameter loc-spr as character no-undo .
      360     define output parameter loc-dim as character no-undo .
      361     assign
      362       loc-fld = ""
      363       loc-lab = ""
      364       loc-spr = ""
      365       loc-dim = "0"
      366     .
      367   end procedure .
      368   procedure fltfield-add :
      369     define input        parameter par-fld as character no-undo.
      370     define input        parameter par-lab as character no-undo .
      371     define input        parameter par-spr as character no-undo .
      372     define input-output parameter loc-fld as character no-undo.
      373     define input-output parameter loc-lab as character no-undo .
      374     define input-output parameter loc-spr as character no-undo .
      375     define input-output parameter loc-dim as character no-undo .
      376     do
      377     on error undo, return error
      378     :
      379       assign
      380       loc-fld = if loc-dim = '0'
      381                 then par-fld
      382                 else (loc-fld + chr(44) + par-fld)
      383       loc-lab = if loc-dim = '0'
      384                 then par-lab
      385                 else (loc-lab + chr(44) + par-lab)
      386       loc-spr = if loc-dim = '0'
      387                 then par-spr
      388                 else (loc-spr + chr(44) + par-spr)
      389       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      390                 string(integer(if num-entries(loc-dim) > 1
      391                               then entry(2, loc-dim)
      392                               else entry(1, loc-dim)
      393                               ) + 1)
      394       no-error
      395       .
      396     end.
      397   end procedure.
      398   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   define variable v-waitfram-action01         as character   no-undo .
      400   define variable v-waitfram-action02         as character   no-undo .
      401   define variable v-waitfram-action03         as character   no-undo .
      402   define variable mWaitFramTextBeg            as character   no-undo.
      403   define variable mWaitFramTextEnd            as character   no-undo.
      404   define variable mWaitFramView               as logical     no-undo.
      405   define variable mWaitProcEvent              as logical     no-undo init yes.
      406   define variable mWaitFramInterval           as integer     no-undo init 1 .
      407   define variable mWaitFramStop               as logical     no-undo.
      408   define variable mWaitFramStopUser           as logical     no-undo.
      409   define variable mWaitFramStopTimeOut        as logical     no-undo.
      410   define variable mWaitFramStartProc          as datetime-tz no-undo.
      411   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      412   define button B-WaitFramStop auto-end-key
      413        label "Стоп"
      414        size 10 by 1 tooltip "Остоновить процесс".
      415   define button B-viewProcInfo
      416        label "Информация"
      417        size 15 by 1 tooltip "Информация о процесс".
      418   define frame waitfram
      419     v-waitfram-action01 format "x(72)" no-label skip
      420     v-waitfram-action02 format "x(72)" no-label skip
      421     v-waitfram-action03 format "x(72)" no-label skip
      422     B-viewProcInfo
      423     B-WaitFramStop at row 4 col 30
      424     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      425     .
      426   define new global shared variable mBatchMode as logical no-undo init ?.
      427   define variable mFramBachModHandle as handle no-undo.
      428   mFramBachModHandle = frame waitfram:handle.
      429   define variable mFameOldVis as logical no-undo.
      430   define variable mVisCUrentVin as logical no-undo.
      431   if session:batch-mode
      432   then
      433      mBatchMode = yes.
      434   if mBatchMode = ? then do:
      435     mVisCUrentVin = current-window:visible.
      436     mFameOldVis = mFramBachModHandle:visible.
      437     mFramBachModHandle:visible  = yes.
      438     mBatchMode = mFramBachModHandle:visible ne yes.
      439     mFramBachModHandle:visible = mFameOldVis.
      440     current-window:visible = mVisCUrentVin.
      441   end.
      442    if  log-manager:logfile-name ne ?
      443     then DO:
      444         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      445         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      446         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      447     end.
      448   on choose of B-WaitFramStop in frame waitfram
      449   do:
      450     mWaitFramStop = yes.
      451     mWaitFramStopUser = yes.
      452   end.
      453   function waitfram-check-timeout returns logical():
      454      define variable vtime as int64 no-undo.
      455      if mWaitFramStopTimeOut
      456      then
      457         return yes.
      458      vtime = ( now - mWaitFramStartProc ) / 1000 .
      459      if     mWaitFramTimeOut ne ?
      460         and mWaitFramTimeOut ne 0
      461         and mWaitFramTimeOut lt vtime
      462      then do:
      463         mWaitFramStopTimeOut = yes.
      464      end.
      465      return mWaitFramStopTimeOut.
      466   end.
      467   procedure waitfram-hide :
      468     if not session:batch-mode
      469     then do
      470     on error undo, return error return-value
      471     :
      472       pause 0 before-hide .
      473       if not mBatchMode then
      474         hide frame waitfram .
      475     if     not mWaitFramView
      476        and mWaitProcEvent
      477     then
      478       process events .
      479     end.
      480   end procedure.
      481   procedure waitfram-show :
      482     define input  parameter p-message as character no-undo .
      483     define variable v-left-margin as integer   no-undo .
      484     if not session:batch-mode
      485     then do
      486     on error undo, return error return-value
      487     :
      488       if length(p-message) <= 70 then do:
      489         assign
      490           v-left-margin = integer((70 - length(p-message)) / 2)
      491         .
      492         assign
      493           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      494         .
      495         assign
      496           v-waitfram-action01 = " "
      497           v-waitfram-action02 = " "
      498                                    + fill(" ", v-left-margin)
      499                                    + p-message
      500           v-waitfram-action03 = " "
      501         .
      502       end.
      503       else do:
      504         define variable vRindex1 as integer no-undo.
      505         define variable vRindex2 as integer no-undo.
      506         vRindex1 = r-index(p-message," ",70).
      507         if vRindex1 = 0
      508         then
      509            vRindex1 = 70.
      510         if length(p-message)  <= vRindex1 + 70 then do:
      511           assign
      512             v-waitfram-action01 = " "
      513             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      514             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      515           .
      516         end.
      517         else do:
      518           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      519           if vRindex2 <= vRindex1
      520           then
      521              vRindex2 = vRindex1 + 70.
      522           assign
      523             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      524             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      525             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      526           .
      527         end.
      528       end.
      529       B-viewProcInfo:visible   in frame waitfram = no.
      530       B-viewProcInfo:sensitive in frame waitfram = no.
      531       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      532       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      533       if  (   mWaitFramView
      534          or  mWaitProcEvent)
      535          and not mBatchMode
      536       then
      537          display
      538             v-waitfram-action01 skip
      539             v-waitfram-action02 skip
      540             v-waitfram-action03 skip
      541          with frame waitfram .
      542       if     mWaitFramView
      543          then do:
      544             if     mWaitFramInterval ne ?
      545                and not mBatchMode
      546             then
      547                wait-for go of frame waitfram pause mWaitFramInterval.
      548          end.
      549          else
      550             if     mWaitProcEvent
      551                and not mBatchMode
      552             then
      553                process events .
      554     end.
      555   end procedure.
      556      procedure waitfram-show-this:
      557         define input  parameter iInterval as int64 no-undo.
      558         define variable vtime as int64 no-undo.
      559         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      560         mWaitFramInterval = iInterval.
      561         run waitfram-show (substitute("&1&2 &3&4" ,
      562                                       mWaitFramTextBeg ,
      563                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      564                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      565                                       mWaitFramTextEnd
      566                                      )
      567                           ).
      568      end.
      569      procedure WaitFramRunPause:
      570         define input  parameter iInterval as dec no-undo.
      571         define variable vStart  as datetime-tz no-undo.
      572         define variable vend    as datetime-tz no-undo.
      573         define variable vint as int64 no-undo.
      574         define variable vOk as logical no-undo.
      575         vStart = now.
      576         vend   = vStart.
      577         publish "WaitFramPause" (iInterval,output vOk).
      578         vend   =  now.
      579         vint = vend - vStart.
      580         vint = iInterval - vint / 1000.
      581         if     not mWaitFramStop
      582            and (   vint > 0
      583                 or (    not vOk
      584                     and iInterval eq ?
      585                     )
      586                 )
      587         then
      588            run waitfram-show-this (iInterval).
      589         vend   =  now.
      590         vint = vend - vStart.
      591         vint = iInterval - vint / 1000.
      592         if     not mWaitFramStop
      593            and vint > 0
      594         then do:
      595            run gbl/pause.p (vint * 1000).
      596         end.
      597         if iInterval ne ?
      598         then
      599            publish "WaitFramStop".
      600         waitfram-check-timeout().
      601      end.
      602      procedure WaitFramWaitFor:
      603         define input  parameter iInterval as dec no-undo.
      604         assign
      605            mWaitFramStartProc   = now
      606            mWaitFramStopUser    = no
      607            mWaitFramStopTimeOut = no
      608         .
      609         block-wait:
      610         do while not mWaitFramStop:
      611            run WaitFramRunPause (iInterval).
      612            if  waitfram-check-timeout()
      613            then do:
      614               leave block-wait.
      615            end.
      616         end.
      617         run waitfram-hide.
      618      end.
      619   procedure waitfram-join :
      620     define input  parameter p-line-1  as character no-undo .
      621     define input  parameter p-line-2  as character no-undo .
      622     define input  parameter p-line-3  as character no-undo .
      623     define output parameter p-message as character no-undo .
      624     do
      625     on error undo, return error return-value
      626     :
      627       assign
      628         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      629                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      630                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      631       .
      632     end.
      633   end procedure.
      634   function waitfram-join-function returns character
      635     (input p-line-1 as character
      636     ,input p-line-2 as character
      637     ,input p-line-3 as character
      638     ).
      639     define variable v-message as character no-undo .
      640     run waitfram-join in this-procedure
      641       (input  p-line-1
      642       ,input  p-line-2
      643       ,input  p-line-3
      644       ,output v-message
      645       ) .
      646     return v-message .
      647   end function .
