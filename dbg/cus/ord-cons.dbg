      982        b-add AT ROW 2 COL 4.75
      983        b-lkp AT ROW 2 COL 13.75
      984        b-chg AT ROW 2 COL 25.75
      985        b-del AT ROW 2 COL 37.75
      986        b-close AT ROW 2 COL 49.75
      987        b-open AT ROW 2 COL 61.75
      988        b-print AT ROW 2 COL 85.88
