     1185   ON MOUSE-SELECT-DBLCLICK OF sch-code IN FRAME Dialog-Frame
     1186   OR  RETURN OF sch-code IN FRAME Dialog-Frame
     1187   DO:
     1188     if sch-code <> input frame Dialog-Frame sch-code or sch-field <> "doc-code" then do:
     1189     sch-num = 0.
     1190     hide sch-num in frame Dialog-Frame.
     1191   end.
     1192    sch-field = "cons-code".
     1193    assign sch-code = input frame Dialog-Frame sch-code.
     1194    find first ub.ord-cons where ub.ord-cons.cons-code  begins sch-code no-error .
     1195           if available ub.ord-cons then doc-rec = recid(ub.ord-cons) .
     1196               else doc-rec = ? .
     1197     if doc-rec = ? then message "Документ не найден !"  .
     1198     else
     1199         reposition br-docs to recid doc-rec no-error.
     1200   return no-apply.
     1201   END.
     1202   ON MOUSE-SELECT-DBLCLICK OF sch-date IN FRAME Dialog-Frame
     1203   OR  RETURN OF sch-date IN FRAME Dialog-Frame
     1204   DO:
     1205     if sch-date <> input frame Dialog-Frame sch-date or sch-field <> "doc-date" then do:
     1206     sch-num = 0.
     1207     hide sch-num in frame Dialog-Frame.
     1208   end.
     1209    sch-field = "cons-date".
     1210    assign sch-date = input frame Dialog-Frame sch-date.
     1211    find first ub.ord-cons where ub.ord-cons.doc-date  = sch-date no-error .
     1212           if available ub.ord-cons then doc-rec = recid(ub.ord-cons) .
     1213               else doc-rec = ? .
     1214     if doc-rec = ? then message "Документ не найден !"  .
     1215     else
     1216         reposition br-docs to recid doc-rec no-error.
     1217   return no-apply.
     1218   END.
     1219   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1220   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1221   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1222   on help of frame Dialog-Frame
     1223   do:
     1224     run gbl/app_help.p
     1225       (input this-procedure :file-name
     1226       ,input ''
     1227       ,input ?
     1228       ) no-error.
     1229     if error-status :error then do:
     1230       message
     1231         "Ошибка при вызове помощи"
     1232         error-status :get-message(1)
     1233         view-as alert-box .
     1234     end.
     1235   end.
     1236   run minbtn-set in this-procedure .
     1237   on choose of b-help in frame Dialog-Frame
     1238   do:
     1239     apply "help":u to frame Dialog-Frame .
     1240   end.
     1241   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   procedure minbtn-set :
     1243       do
     1244           on error undo, return error return-value
     1245           :
     1246           define variable ii              as integer       no-undo .
     1247           define variable fh              as widget-handle no-undo .
     1248           define variable hh              as widget-handle no-undo .
     1249           define variable v-h             as handle        extent 4 no-undo .
     1250           define variable v-name-button   as character     no-undo .
     1251           define variable v-help-old-x    as decimal       no-undo .
     1252           define variable v-help-old-y    as decimal       no-undo .
     1253           define variable v-help-old-size as decimal       no-undo .
     1254           define variable v-frame-width   as decimal       no-undo .
     1255           define variable jj              as integer       no-undo .
     1256           do
     1257               on error undo, return error
     1258               :
     1259               assign
     1260                   v-frame-width = frame Dialog-Frame:width - 0.3
     1261                   fh            = frame Dialog-Frame:first-child
     1262                   hh            = fh:first-child
     1263                   ii            = 1
     1264                   .
     1265               do while valid-handle(hh):
     1266                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1267                   do:
     1268                       case lc(hh:name) :
     1269                           when "b-help" then
     1270                               do:
     1271                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1272                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1273                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1274                                   hh:TOOLTIP = "Помощь" .
     1275                                   v-help-old-x = hh:column .
     1276                                   v-help-old-y = hh:row    .
     1277                                   v-help-old-size = hh:width .
     1278                                   hh:width-chars = 2.5 .
     1279                               end.
     1280                           when "b-print" then
     1281                               do:
     1282                                   hh:load-image("cmp/b-print.bmp":u) .
     1283                                   hh:TOOLTIP = "Печать" .
     1284                                   v-h[ii] = hh:handle .
     1285                                   ii = ii + 1 .
     1286                                   hh:width-chars = 3 .
     1287                               end.
     1288                           when "b-history" or
     1289                           when "b-hist" then
     1290                               do:
     1291                                   hh:load-image("cmp/b-hist.bmp":u) .
     1292                                   hh:TOOLTIP = "История" .
     1293                                   v-h[ii] = hh:handle .
     1294                                   ii = ii + 1 .
     1295                                   hh:width-chars = 3 .
     1296                               end.
     1297                           when "b-sch" then
     1298                               do:
     1299                                   hh:load-image("cmp/b-sch.bmp":u) .
     1300                                   hh:TOOLTIP = "Установка Фильтра" .
     1301                                   v-h[ii] = hh:handle .
     1302                                   ii = ii + 1 .
     1303                                   hh:width-chars = 3 .
     1304                               end.
     1305                           when "b-hist-user" then
     1306                               do:
     1307                                   hh:load-image("cmp/b-hist.bmp":u) .
     1308                                   hh:TOOLTIP = "История пользователя" .
     1309                                   ii = ii + 1 .
     1310                               end.
     1311                       end case.
     1312                   end.
     1313                   hh = hh:next-sibling.
     1314               end.
     1315               b-help:column = v-frame-width - b-help:width-chars.
     1316               jj = 0.
     1317               repeat ii = 4 to 1 by -1 :
     1318                   if valid-handle (v-h[ii] ) then
     1319                   do:
     1320                       jj  = jj + 1 .
     1321                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1322                       v-h[ii]:row    = v-help-old-y .
     1323                   end.
     1324               end.
     1325           end.
     1326       end.
     1327   end procedure.
     1328   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1329   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1330   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1331   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1332   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1333   define variable v-diasize-current-frame-height as decimal   no-undo .
     1334   define variable v-diasize-change-size          as logical   no-undo .
     1335   define variable v-diasize-resize-button        as handle    no-undo .
     1336   define variable v-diasize-wndmax               as logical   no-undo .
     1337   define variable v-diasize-wndstore             as logical   no-undo .
     1338   define variable v-diasize-proc-name            as character no-undo .
     1339   define variable v-diasize-browse-handle        as handle    no-undo .
     1340   define variable v-diasize-browse-number        as integer   no-undo .
     1341   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1342   define temp-table temp-diasize-handle no-undo
     1343     field handle-value  as handle
     1344     field save-position as decimal
     1345     index xpk is primary unique handle-value
     1346     .
     1347   define temp-table temp-browse-handle no-undo
     1348     field browse-type   as character
     1349     field browse-number as integer
     1350     field browse-handle as handle
     1351     field original-size as decimal
     1352     index xpk is primary unique browse-type browse-number
     1353     index xie browse-type browse-handle
     1354   .
     1355   procedure diasize_change-height :
     1356     define input  parameter p-change-value  as decimal   no-undo .
     1357     define input  parameter p-move-resize   as logical   no-undo .
     1358     define variable v-field-group-handle    as handle    no-undo .
     1359     define variable v-object-handle         as handle    no-undo .
     1360     define variable v-frame-height          as decimal   no-undo .
     1361     define variable v-frame-virtual-height  as decimal   no-undo .
     1362     define variable v-browse-height         as decimal   no-undo .
     1363     define variable v-window-height         as decimal   no-undo .
     1364     define variable v-window-virtual-height as decimal   no-undo .
     1365     define variable v-change-sign           as integer   no-undo .
     1366     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1367     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1368     if p-change-value > 0
     1369     then do:
     1370       if frame Dialog-Frame :height + p-change-value
     1371           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1372       then do:
     1373         assign
     1374           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1375                           - (frame Dialog-Frame :height-chars)
     1376         .
     1377         if p-change-value <= 0
     1378         then do:
     1379           run diasize_position-resize-button in this-procedure .
     1380           return .
     1381         end.
     1382       end.
     1383     end.
     1384     if p-change-value < 0
     1385     then do:
     1386       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1387       then do:
     1388         assign
     1389           p-change-value = v-diasize-orig-frame-height
     1390                          - (frame Dialog-Frame :height-chars)
     1391         .
     1392         if p-change-value >= 0
     1393         then do:
     1394           run diasize_position-resize-button in this-procedure .
     1395           return .
     1396         end.
     1397       end.
     1398     end.
     1399     if p-change-value >= 0
     1400     then do:
     1401       assign
     1402         v-change-sign = 1
     1403       .
     1404     end.
     1405     else do:
     1406       assign
     1407         v-change-sign = -1
     1408       .
     1409     end.
     1410     assign
     1411       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1412     .
     1413     if p-change-value = 0
     1414     then do:
     1415       run diasize_position-resize-button in this-procedure .
     1416       return .
     1417     end.
     1418     move_block:
     1419     do
     1420     on error undo move_block, retry move_block
     1421     :
     1422       if retry
     1423       then do:
     1424         do
     1425         on error undo move_block, leave move_block
     1426         :
     1427           if p-change-value > 0
     1428           then do:
     1429             for each buf_temp-diasize-handle
     1430             on error undo, next
     1431             :
     1432               assign
     1433                 v-object-handle = buf_temp-diasize-handle.handle-value
     1434               .
     1435               if v-object-handle <> v-diasize-resize-button
     1436               then do:
     1437                 assign
     1438                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1439                 .
     1440               end.
     1441             end.
     1442             assign
     1443               v-diasize-browse-handle :height = v-browse-height
     1444             .
     1445             for each buf_temp-browse-handle
     1446               where buf_temp-browse-handle.browse-type = 'height':u
     1447             on error undo, next
     1448             :
     1449               assign
     1450                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1451               .
     1452             end.
     1453             assign
     1454               frame Dialog-Frame :height = v-frame-height
     1455             .
     1456             if frame Dialog-Frame :scrollable = true
     1457             then do:
     1458               assign
     1459                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1460               .
     1461             end.
     1462             run diasize_position-resize-button in this-procedure .
     1463           end.
     1464           else do:
     1465             if frame Dialog-Frame :scrollable = true
     1466             then do:
     1467               assign
     1468                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1469               .
     1470             end.
     1471             assign
     1472               frame Dialog-Frame :height = v-frame-height
     1473             .
     1474             assign
     1475               v-diasize-browse-handle :height = v-browse-height
     1476             .
     1477             for each buf_temp-browse-handle
     1478               where buf_temp-browse-handle.browse-type = 'height':u
     1479             on error undo, next
     1480             :
     1481               assign
     1482                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1483               .
     1484             end.
     1485             for each buf_temp-diasize-handle
     1486             on error undo, next
     1487             :
     1488               assign
     1489                 v-object-handle = buf_temp-diasize-handle.handle-value
     1490               .
     1491               if v-object-handle <> v-diasize-resize-button
     1492               then do:
     1493                 assign
     1494                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1495                 .
     1496               end.
     1497             end.
     1498             run diasize_position-resize-button in this-procedure .
     1499           end.
     1500           assign
     1501             v-diasize-change-size = false
     1502           .
     1503           leave move_block .
     1504         end.
     1505       end.
     1506       assign
     1507         v-diasize-need-full-display = true
     1508       .
     1509       if v-diasize-change-size = false
     1510       then do:
     1511         assign
     1512           v-diasize-change-size = true
     1513         .
     1514       end.
     1515       else do:
     1516         return .
     1517       end.
     1518       assign
     1519         v-frame-height = frame Dialog-Frame :height
     1520         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1521         v-browse-height = v-diasize-browse-handle :height
     1522       .
     1523       for each buf_temp-browse-handle
     1524         where buf_temp-browse-handle.browse-type = 'height':u
     1525       :
     1526         assign
     1527           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1528         .
     1529       end.
     1530       for each buf_temp-diasize-handle
     1531       :
     1532         delete buf_temp-diasize-handle .
     1533       end.
     1534       assign
     1535         v-field-group-handle = frame Dialog-Frame :first-child
     1536       .
     1537       do while valid-handle(v-field-group-handle)
     1538       :
     1539         assign
     1540           v-object-handle = v-field-group-handle :first-child
     1541         .
     1542         do while valid-handle(v-object-handle)
     1543         :
     1544           if  v-object-handle <> v-diasize-browse-handle :handle
     1545           and can-query(v-object-handle, "row")
     1546           and can-query(v-object-handle, "height")
     1547           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1548           then do:
     1549             find first buf_temp-browse-handle
     1550               where buf_temp-browse-handle.browse-type   = 'height':u
     1551                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1552               no-error .
     1553             if available buf_temp-browse-handle
     1554             then do:
     1555             end.
     1556             else do:
     1557               create buf_temp-diasize-handle .
     1558               assign
     1559                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1560                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1561               .
     1562             end.
     1563           end.
     1564           assign
     1565             v-object-handle = v-object-handle :next-sibling
     1566           .
     1567         end.
     1568         assign
     1569           v-field-group-handle = v-field-group-handle :next-sibling
     1570         .
     1571       end.
     1572       do with frame Dialog-Frame
     1573       :
     1574         hide v-diasize-resize-button .
     1575         assign
     1576           v-diasize-resize-button :row    = 1
     1577           v-diasize-resize-button :column = 1
     1578         .
     1579       end.
     1580       if p-change-value > 0
     1581       then do:
     1582         if frame Dialog-Frame :scrollable = true
     1583         then do:
     1584           assign
     1585             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1586             no-error .
     1587           if error-status :error
     1588           or error-status :get-message(1) <> ""
     1589           then do:
     1590             undo move_block, retry move_block .
     1591           end.
     1592         end.
     1593         assign
     1594           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1595           no-error .
     1596         if error-status :error
     1597         or error-status :get-message(1) <> ""
     1598         then do:
     1599           undo move_block, retry move_block .
     1600         end.
     1601         assign
     1602           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1603           no-error .
     1604         if error-status :error
     1605         or error-status :get-message(1) <> ""
     1606         then do:
     1607           undo move_block, retry move_block .
     1608         end.
     1609         for each buf_temp-browse-handle
     1610           where buf_temp-browse-handle.browse-type = 'height':u
     1611         on error undo move_block, retry move_block
     1612         :
     1613           assign
     1614             buf_temp-browse-handle.browse-handle :height
     1615               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1616             no-error .
     1617           if error-status :error
     1618           or error-status :get-message(1) <> ""
     1619           then do:
     1620             undo move_block, retry move_block .
     1621           end.
     1622         end.
     1623         for each buf_temp-diasize-handle
     1624         on error undo move_block, retry move_block
     1625         :
     1626           assign
     1627             v-object-handle = buf_temp-diasize-handle.handle-value
     1628           .
     1629           if v-object-handle <> v-diasize-resize-button
     1630           then do:
     1631             assign
     1632               v-object-handle :row = v-object-handle :row + p-change-value
     1633               no-error .
     1634             if error-status :error
     1635             or error-status :get-message(1) <> ""
     1636             then do:
     1637               undo move_block, retry move_block .
     1638             end.
     1639           end.
     1640         end.
     1641       end.
     1642       else do:
     1643         for each buf_temp-diasize-handle
     1644         on error undo move_block, retry move_block
     1645         :
     1646           assign
     1647             v-object-handle = buf_temp-diasize-handle.handle-value
     1648           .
     1649           if v-object-handle <> v-diasize-resize-button
     1650           then do:
     1651             assign
     1652               v-object-handle :row = v-object-handle :row + p-change-value
     1653               no-error .
     1654             if error-status :error
     1655             or error-status :get-message(1) <> ""
     1656             then do:
     1657               undo move_block, retry move_block .
     1658             end.
     1659           end.
     1660         end.
     1661         assign
     1662           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1663           no-error .
     1664         if error-status :error
     1665         or error-status :get-message(1) <> ""
     1666         then do:
     1667           undo move_block, retry move_block .
     1668         end.
     1669         for each buf_temp-browse-handle
     1670           where buf_temp-browse-handle.browse-type = 'height':u
     1671         on error undo move_block, retry move_block
     1672         :
     1673           assign
     1674             buf_temp-browse-handle.browse-handle :height
     1675               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1676             no-error .
     1677           if error-status :error
     1678           or error-status :get-message(1) <> ""
     1679           then do:
     1680             undo move_block, retry move_block .
     1681           end.
     1682         end.
     1683         assign
     1684           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1685           no-error .
     1686         if error-status :error
     1687         or error-status :get-message(1) <> ""
     1688         then do:
     1689           undo move_block, retry move_block .
     1690         end.
     1691         if frame Dialog-Frame :scrollable = true
     1692         then do:
     1693           assign
     1694             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1695             no-error .
     1696           if error-status :error
     1697           or error-status :get-message(1) <> ""
     1698           then do:
     1699             undo move_block, retry move_block .
     1700           end.
     1701         end.
     1702       end.
     1703       if p-move-resize = true
     1704       then do:
     1705         run diasize_position-resize-button in this-procedure .
     1706       end.
     1707       if v-diasize-wndstore = true
     1708       then do:
     1709         if connected("ub") = true
     1710         then do:
     1711           define variable v-cntxt-db-num        as integer   no-undo .
     1712           define variable v-cntxt-userid        as character no-undo .
     1713           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1714                                             , OUTPUT v-cntxt-userid
     1715                                             ) .
     1716           run gbl/wndsizew.p
     1717             (input  v-cntxt-db-num
     1718             ,input  v-cntxt-userid
     1719             ,input  v-diasize-proc-name
     1720             ,input  'height':u
     1721             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1722             ) .
     1723         end.
     1724       end.
     1725     end.
     1726     assign
     1727       v-diasize-change-size = false
     1728     .
     1729   end procedure.
     1730   procedure diasize_set-height :
     1731     define input  parameter p-new-height  as decimal   no-undo .
     1732     define input  parameter p-move-resize as logical   no-undo .
     1733     do
     1734     on error undo, return error return-value
     1735     :
     1736       run diasize_change-height in this-procedure
     1737         (input  (p-new-height - frame Dialog-Frame :height)
     1738         ,input  p-move-resize
     1739         ) .
     1740     end.
     1741   end procedure.
     1742   procedure diasize_change-width :
     1743     define input  parameter p-change-value as decimal   no-undo .
     1744     define input  parameter p-move-resize  as logical   no-undo .
     1745     define variable v-field-group-handle   as handle    no-undo .
     1746     define variable v-object-handle        as handle    no-undo .
     1747     define variable v-frame-width          as decimal   no-undo .
     1748     define variable v-frame-virtual-width  as decimal   no-undo .
     1749     define variable v-browse-width         as decimal   no-undo .
     1750     define variable v-window-width         as decimal   no-undo .
     1751     define variable v-window-virtual-width as decimal   no-undo .
     1752     define variable v-change-sign          as integer   no-undo .
     1753     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1754     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1755     if p-change-value > 0
     1756     then do:
     1757       if frame Dialog-Frame :width + p-change-value >
     1758           session :width-chars
     1759       then do:
     1760         assign
     1761           p-change-value = session :width-chars - frame Dialog-Frame :width
     1762         .
     1763         if p-change-value <= 0
     1764         then do:
     1765           run diasize_position-resize-button in this-procedure .
     1766           return .
     1767         end.
     1768       end.
     1769     end.
     1770     if p-change-value < 0
     1771     then do:
     1772       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1773       then do:
     1774         assign
     1775           p-change-value = v-diasize-orig-frame-width
     1776                          - frame Dialog-Frame :width
     1777         .
     1778         if p-change-value >= 0
     1779         then do:
     1780           run diasize_position-resize-button in this-procedure .
     1781           return .
     1782         end.
     1783       end.
     1784     end.
     1785     if p-change-value >= 0
     1786     then do:
     1787       assign
     1788         v-change-sign = 1
     1789       .
     1790     end.
     1791     else do:
     1792       assign
     1793         v-change-sign = -1
     1794       .
     1795     end.
     1796     assign
     1797       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1798     .
     1799     if p-change-value = 0
     1800     then do:
     1801       run diasize_position-resize-button in this-procedure .
     1802       return .
     1803     end.
     1804     move_block:
     1805     do
     1806     on error undo move_block, leave move_block
     1807     :
     1808       if retry
     1809       then do:
     1810         do
     1811         on error undo move_block, leave move_block
     1812         :
     1813           if p-change-value > 0
     1814           then do:
     1815             for each buf_temp-diasize-handle
     1816             on error undo, next
     1817             :
     1818               assign
     1819                 v-object-handle = buf_temp-diasize-handle.handle-value
     1820               .
     1821               if v-object-handle <> v-diasize-resize-button
     1822               then do:
     1823                 assign
     1824                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1825                 .
     1826               end.
     1827             end.
     1828             assign
     1829               v-diasize-browse-handle :width = v-browse-width
     1830             .
     1831             for each buf_temp-browse-handle
     1832               where buf_temp-browse-handle.browse-type = 'width':u
     1833             on error undo, next
     1834             :
     1835               assign
     1836                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1837               .
     1838             end.
     1839             assign
     1840               frame Dialog-Frame :width = v-frame-width
     1841             .
     1842             if frame Dialog-Frame :scrollable = true
     1843             then do:
     1844               assign
     1845                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1846               .
     1847             end.
     1848             run diasize_position-resize-button in this-procedure .
     1849           end.
     1850           else do:
     1851             if frame Dialog-Frame :scrollable = true
     1852             then do:
     1853               assign
     1854                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1855               .
     1856             end.
     1857             assign
     1858               frame Dialog-Frame :width = v-frame-width
     1859             .
     1860             for each buf_temp-browse-handle
     1861               where buf_temp-browse-handle.browse-type = 'width':u
     1862             on error undo, next
     1863             :
     1864               assign
     1865                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1866               .
     1867             end.
     1868             assign
     1869               v-diasize-browse-handle :width = v-browse-width
     1870             .
     1871             for each buf_temp-diasize-handle
     1872             on error undo, next
     1873             :
     1874               assign
     1875                 v-object-handle = buf_temp-diasize-handle.handle-value
     1876               .
     1877               if v-object-handle <> v-diasize-resize-button
     1878               then do:
     1879                 assign
     1880                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1881                 .
     1882               end.
     1883             end.
     1884             run diasize_position-resize-button in this-procedure .
     1885           end.
     1886           assign
     1887             v-diasize-change-size = false
     1888           .
     1889           leave move_block .
     1890         end.
     1891       end.
     1892       assign
     1893         v-diasize-need-full-display = true
     1894       .
     1895       if v-diasize-change-size = false
     1896       then do:
     1897         assign
     1898           v-diasize-change-size = true
     1899         .
     1900       end.
     1901       else do:
     1902         return .
     1903       end.
     1904       assign
     1905         v-frame-width = frame Dialog-Frame :width
     1906         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1907         v-browse-width = v-diasize-browse-handle :width
     1908       .
     1909       for each buf_temp-browse-handle
     1910         where buf_temp-browse-handle.browse-type = 'width':u
     1911       :
     1912         assign
     1913           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1914         .
     1915       end.
     1916       for each buf_temp-diasize-handle
     1917       :
     1918         delete buf_temp-diasize-handle .
     1919       end.
     1920       assign
     1921         v-field-group-handle = frame Dialog-Frame :first-child
     1922       .
     1923       do while valid-handle(v-field-group-handle)
     1924       :
     1925         assign
     1926           v-object-handle = v-field-group-handle :first-child
     1927         .
     1928         do while valid-handle(v-object-handle)
     1929         :
     1930           if  v-object-handle <> v-diasize-browse-handle :handle
     1931           and v-object-handle <> v-diasize-resize-button
     1932           and can-query(v-object-handle, "row")
     1933           and can-query(v-object-handle, "height")
     1934           and ( v-object-handle :col + v-object-handle :width
     1935                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1936               )
     1937           then do:
     1938             find first buf_temp-browse-handle
     1939               where buf_temp-browse-handle.browse-type   = 'width':u
     1940                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1941               no-error .
     1942             if available buf_temp-browse-handle
     1943             then do:
     1944             end.
     1945             else do:
     1946               create buf_temp-diasize-handle .
     1947               assign
     1948                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1949                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1950               .
     1951             end.
     1952           end.
     1953           assign
     1954             v-object-handle = v-object-handle :next-sibling
     1955           .
     1956         end.
     1957         assign
     1958           v-field-group-handle = v-field-group-handle :next-sibling
     1959         .
     1960       end.
     1961       do with frame Dialog-Frame
     1962       :
     1963         hide v-diasize-resize-button .
     1964         v-diasize-resize-button :row = 1.
     1965         v-diasize-resize-button :column = 1.
     1966       end.
     1967       if p-change-value > 0
     1968       then do:
     1969         if frame Dialog-Frame :scrollable = true
     1970         then do:
     1971           assign
     1972             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1973             no-error .
     1974           if error-status :error
     1975           or error-status :get-message(1) <> ""
     1976           then do:
     1977             undo move_block, retry move_block.
     1978           end.
     1979         end.
     1980         assign
     1981           frame Dialog-Frame :width = v-frame-width + p-change-value
     1982           no-error .
     1983         if error-status :error
     1984         or error-status :get-message(1) <> ""
     1985         then do:
     1986           undo move_block, retry move_block.
     1987         end.
     1988         assign
     1989           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1990         no-error .
     1991         if error-status :error
     1992         or error-status :get-message(1) <> ""
     1993         then do:
     1994           undo move_block, retry move_block.
     1995         end.
     1996         for each buf_temp-browse-handle
     1997           where buf_temp-browse-handle.browse-type = 'width':u
     1998         on error undo move_block, retry move_block
     1999         :
     2000           assign
     2001             buf_temp-browse-handle.browse-handle :width
     2002               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2003             no-error .
     2004           if error-status :error
     2005           or error-status :get-message(1) <> ""
     2006           then do:
     2007             undo move_block, retry move_block .
     2008           end.
     2009         end.
     2010         for each buf_temp-diasize-handle
     2011         on error undo move_block, retry move_block
     2012         :
     2013           assign
     2014             v-object-handle = buf_temp-diasize-handle.handle-value
     2015           .
     2016           if v-object-handle <> v-diasize-resize-button
     2017           then do:
     2018             assign
     2019               v-object-handle :col = v-object-handle :col + p-change-value
     2020               no-error .
     2021             if error-status :error
     2022             or error-status :get-message(1) <> ""
     2023             then do:
     2024               undo move_block, retry move_block .
     2025             end.
     2026           end.
     2027         end.
     2028       end.
     2029       else do:
     2030         for each buf_temp-diasize-handle
     2031         on error undo move_block, retry move_block
     2032         :
     2033           assign
     2034             v-object-handle = buf_temp-diasize-handle.handle-value
     2035           .
     2036           if v-object-handle <> v-diasize-resize-button
     2037           then do:
     2038             assign
     2039               v-object-handle :col = v-object-handle :col + p-change-value
     2040               no-error .
     2041             if error-status :error
     2042             or error-status :get-message(1) <> ""
     2043             then do:
     2044               undo move_block, retry move_block .
     2045             end.
     2046           end.
     2047         end.
     2048         for each buf_temp-browse-handle
     2049           where buf_temp-browse-handle.browse-type = 'width':u
     2050         on error undo move_block, retry move_block
     2051         :
     2052           assign
     2053             buf_temp-browse-handle.browse-handle :width
     2054               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2055             no-error .
     2056           if error-status :error
     2057           or error-status :get-message(1) <> ""
     2058           then do:
     2059             undo move_block, retry move_block .
     2060           end.
     2061         end.
     2062         assign
     2063           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2064           no-error .
     2065         if error-status :error
     2066         or error-status :get-message(1) <> ""
     2067         then do:
     2068           undo move_block, retry move_block.
     2069         end.
     2070         assign
     2071           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2072         no-error .
     2073         if error-status :error
     2074         or error-status :get-message(1) <> ""
     2075         then do:
     2076           undo move_block, retry move_block.
     2077         end.
     2078         if frame Dialog-Frame :scrollable = true
     2079         then do:
     2080           assign
     2081             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2082           no-error .
     2083           if error-status :error
     2084           or error-status :get-message(1) <> ""
     2085           then do:
     2086             undo move_block, retry move_block.
     2087           end.
     2088         end.
     2089       end.
     2090       if p-move-resize
     2091       then do:
     2092         run diasize_position-resize-button in this-procedure .
     2093       end.
     2094       if v-diasize-wndstore = true
     2095       then do:
     2096         if connected("ub") = true
     2097         then do:
     2098           define variable v-cntxt-db-num        as integer   no-undo .
     2099           define variable v-cntxt-userid        as character no-undo .
     2100           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2101                                             , OUTPUT v-cntxt-userid
     2102                                             ) .
     2103           run gbl/wndsizew.p
     2104             (input  v-cntxt-db-num
     2105             ,input  v-cntxt-userid
     2106             ,input  v-diasize-proc-name
     2107             ,input  'width':u
     2108             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2109             ) .
     2110         end.
     2111       end.
     2112     end.
     2113     assign
     2114       v-diasize-change-size = false
     2115     .
     2116   end procedure.
     2117   procedure diasize_set-width :
     2118     define input  parameter p-new-width  as decimal   no-undo .
     2119     define input  parameter p-move-resize as logical   no-undo .
     2120     do
     2121     on error undo, return error return-value
     2122     :
     2123       run diasize_change-width in this-procedure
     2124         (input  (p-new-width - frame Dialog-Frame :width)
     2125         ,input  p-move-resize
     2126         ) .
     2127     end.
     2128   end procedure.
     2129   procedure diasize_position-resize-button :
     2130     do with frame Dialog-Frame
     2131     :
     2132       hide v-diasize-resize-button .
     2133       assign
     2134         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2135                     - 1
     2136                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2137         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2138                     - 1
     2139                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2140       .
     2141       view v-diasize-resize-button .
     2142     end.
     2143   end procedure.
     2144   on alt-right anywhere
     2145   do:
     2146     run diasize_change-width in this-procedure
     2147       (input 1
     2148       ,input true
     2149       ) .
     2150     return no-apply .
     2151   end.
     2152   on alt-left anywhere
     2153   do:
     2154     run diasize_change-width in this-procedure
     2155       (input -1
     2156       ,input true
     2157       ) .
     2158     return no-apply .
     2159   end.
     2160   on alt-down anywhere
     2161   do:
     2162     run diasize_change-height in this-procedure
     2163       (input 1
     2164       ,input true
     2165       ) .
     2166     return no-apply .
     2167   end.
     2168   on alt-up anywhere
     2169   do:
     2170     run diasize_change-height in this-procedure
     2171       (input -1
     2172       ,input true
     2173       ) .
     2174     return no-apply .
     2175   end.
     2176   on alt-enter of frame Dialog-Frame
     2177   do:
     2178     run diasize_maximize in this-procedure
     2179       (input  ?
     2180       ).
     2181     return no-apply .
     2182   end.
     2183   procedure diasize_end-move :
     2184     do
     2185     on error undo, return error return-value
     2186     :
     2187       define variable v-row-delta as decimal   no-undo .
     2188       define variable v-col-delta as decimal   no-undo .
     2189       define variable v-new-row as decimal   no-undo .
     2190       define variable v-new-col as decimal   no-undo .
     2191       assign
     2192         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2193         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2194       .
     2195       assign
     2196         v-row-delta = v-new-row - frame Dialog-Frame :height
     2197         v-col-delta = v-new-col - frame Dialog-Frame :width
     2198       .
     2199       run diasize_change-height in this-procedure
     2200         (input v-row-delta
     2201         ,input true
     2202         ) .
     2203       run diasize_change-width in this-procedure
     2204         (input v-col-delta
     2205         ,input true
     2206         ) .
     2207     end.
     2208   end procedure.
     2209   procedure diasize_maximize :
     2210     define input  parameter p-action as logical   no-undo .
     2211     do
     2212     on error undo, return error return-value
     2213     :
     2214       if p-action = ?
     2215       then do:
     2216         if v-diasize-need-maximize = true
     2217         then do:
     2218           assign
     2219             p-action = true
     2220           .
     2221         end.
     2222         else do:
     2223           assign
     2224             p-action = false
     2225           .
     2226         end.
     2227       end.
     2228       if p-action = true
     2229       then do:
     2230         run diasize_change-height in this-procedure
     2231           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2232               - frame Dialog-Frame :height-chars
     2233           ,input true
     2234           ) .
     2235         run diasize_change-width in this-procedure
     2236           (input session :width-chars
     2237               - frame Dialog-Frame :width-chars
     2238           ,input true
     2239           ) .
     2240         assign
     2241           v-diasize-need-maximize = false
     2242         .
     2243       end.
     2244       else do:
     2245         run diasize_change-width in this-procedure
     2246           (input v-diasize-orig-frame-width
     2247               - frame Dialog-Frame :width-chars
     2248           ,input true
     2249           ) .
     2250         run diasize_change-height in this-procedure
     2251           (input v-diasize-orig-frame-height
     2252               - frame Dialog-Frame :height-chars
     2253           ,input true
     2254           ) .
     2255         assign
     2256           v-diasize-need-maximize = true
     2257         .
     2258       end.
     2259     end.
     2260   end procedure.
     2261   procedure diasize_restore-orig-size :
     2262     do
     2263     on error undo, return error return-value
     2264     :
     2265       assign
     2266         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2267         v-diasize-current-frame-height = frame Dialog-Frame :height
     2268       .
     2269       run diasize_set-height in this-procedure
     2270         (input  v-diasize-orig-frame-height
     2271         ,input  true
     2272         ) .
     2273       run diasize_set-width in this-procedure
     2274         (input  v-diasize-orig-frame-width
     2275         ,input  true
     2276         ) .
     2277     end.
     2278   end procedure.
     2279   procedure diasize_restore-current-size :
     2280     do
     2281     on error undo, return error return-value
     2282     :
     2283       run diasize_set-height in this-procedure
     2284         (input  v-diasize-current-frame-height
     2285         ,input  true
     2286         ) .
     2287       run diasize_set-width in this-procedure
     2288         (input  v-diasize-current-frame-width
     2289         ,input  true
     2290         ) .
     2291     end.
     2292   end procedure.
     2293   procedure diasize_set-browse-handle :
     2294     define input  parameter p-browse-handle as handle   no-undo .
     2295     define buffer buf_temp-browse-handle for temp-browse-handle .
     2296     do
     2297     on error undo, return error return-value
     2298     :
     2299       assign
     2300         v-diasize-browse-handle = p-browse-handle
     2301       .
     2302       for each buf_temp-browse-handle
     2303       on error undo, return error return-value
     2304       :
     2305         delete buf_temp-browse-handle .
     2306       end.
     2307     end.
     2308   end procedure.
     2309   procedure diasize_add_browse :
     2310     define input  parameter p-browse-type   as character no-undo .
     2311     define input  parameter p-browse-handle as handle    no-undo .
     2312     define buffer buf_temp-browse-handle for temp-browse-handle .
     2313     do
     2314     on error undo, return error return-value
     2315     :
     2316       assign
     2317         v-diasize-browse-number = v-diasize-browse-number + 1
     2318       .
     2319       create buf_temp-browse-handle .
     2320       assign
     2321         buf_temp-browse-handle.browse-type   = p-browse-type
     2322         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2323         buf_temp-browse-handle.browse-handle = p-browse-handle
     2324       .
     2325     end.
     2326   end procedure.
     2327   procedure diasize_init :
     2328     define variable v-default-value    as logical   no-undo .
     2329     define variable v-restore-saved    as logical   no-undo .
     2330     define variable v-resize-value-str as character no-undo .
     2331     do
     2332     on error undo, return error return-value
     2333     :
     2334       do with frame Dialog-Frame
     2335       :
     2336         assign
     2337           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2338           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2339           v-diasize-browse-handle     = browse br-docs :handle
     2340         .
     2341         create button v-diasize-resize-button
     2342         assign
     2343           parent        = frame Dialog-Frame :first-child
     2344           label         = "s"
     2345           height-pixels = 16
     2346           width-pixels  = 16
     2347           visible       = true
     2348           sensitive     = true
     2349           movable       = true
     2350           triggers:
     2351             on end-move persistent run diasize_end-move in this-procedure .
     2352           end triggers.
     2353         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2354         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2355         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2356         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2357         assign
     2358           v-diasize-wndmax = false
     2359         .
     2360         if connected("ub") = true
     2361         then do:
     2362           define variable v-cntxt-db-num        as integer   no-undo .
     2363           define variable v-cntxt-userid        as character no-undo .
     2364           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2365                                             , OUTPUT v-cntxt-userid
     2366                                             ) .
     2367           run gbl/wndpar_r.p
     2368             (input  v-cntxt-db-num
     2369             ,input  v-cntxt-userid
     2370             ,input  'wndmax':U
     2371             ,output v-diasize-wndmax
     2372             ,output v-default-value
     2373             ) .
     2374         end.
     2375         assign
     2376           v-diasize-wndstore = false
     2377         .
     2378         if connected("ub") = true
     2379         then do:
     2380           run gbl/wndpar_r.p
     2381             (input  v-cntxt-db-num
     2382             ,input  v-cntxt-userid
     2383             ,input  'wndstore':U
     2384             ,output v-diasize-wndstore
     2385             ,output v-default-value
     2386             ) .
     2387         end.
     2388         assign
     2389           v-diasize-proc-name = entry(1, program-name(2), '.')
     2390         .
     2391         if v-diasize-wndstore = true
     2392         then do:
     2393           assign
     2394             v-restore-saved = false
     2395           .
     2396           if connected("ub") = true
     2397           then do:
     2398             run gbl/wndsizer.p
     2399               (input  v-cntxt-db-num
     2400               ,input  v-cntxt-userid
     2401               ,input  v-diasize-proc-name
     2402               ,input  'height':u
     2403               ,output v-resize-value-str
     2404               ) .
     2405             if v-resize-value-str <> '':U
     2406             then do:
     2407               run diasize_change-height in this-procedure
     2408                 (input  integer(v-resize-value-str)
     2409                 ,input  true
     2410                 ) .
     2411               assign
     2412                 v-restore-saved = true
     2413               .
     2414             end.
     2415           end.
     2416           if connected("ub") = true
     2417           then do:
     2418             run gbl/wndsizer.p
     2419               (input  v-cntxt-db-num
     2420               ,input  v-cntxt-userid
     2421               ,input  v-diasize-proc-name
     2422               ,input  'width':u
     2423               ,output v-resize-value-str
     2424               ) .
     2425             if v-resize-value-str <> '':U
     2426             then do:
     2427               run diasize_change-width in this-procedure
     2428                 (input  integer(v-resize-value-str)
     2429                 ,input  true
     2430                 ) .
     2431               assign
     2432                 v-restore-saved = true
     2433               .
     2434             end.
     2435           end.
     2436           if v-restore-saved <> true
     2437           then do:
     2438             if v-diasize-wndmax = true
     2439             then do:
     2440               run diasize_maximize in this-procedure
     2441                 (input  true
     2442                 ) .
     2443             end.
     2444           end.
     2445         end.
     2446         else do:
     2447           if v-diasize-wndmax = true
     2448           then do:
     2449             run diasize_maximize in this-procedure
     2450               (input  true
     2451               ) .
     2452           end.
     2453         end.
     2454       end.
     2455     end.
     2456   end procedure.
     2457   procedure diasize_need-full-display :
     2458     define output parameter p-need-full-display as logical   no-undo .
     2459     do
     2460     on error undo, return error return-value
     2461     :
     2462       assign
     2463         p-need-full-display = v-diasize-need-full-display
     2464       .
     2465       assign
     2466         v-diasize-need-full-display = false
     2467       .
     2468     end.
     2469   end procedure.
     2470   procedure get-context :
     2471      define output parameter p-db-num as integer          no-undo.
     2472      define output parameter p-user-id as character        no-undo.
     2473      define variable v-login               as character    no-undo.
     2474      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2475      define buffer buf_user-login  for ub.user-login .
     2476      do
     2477      on error undo, return error
     2478      :
     2479            FIND FIRST buf_sys-ctrl no-lock.
     2480            ASSIGN
     2481               v-login = USERID("ub")
     2482               p-db-num = buf_sys-ctrl.db-num
     2483            .
     2484            FIND FIRST buf_user-login
     2485                 WHERE buf_user-login.db-num = p-db-num
     2486                   AND buf_user-login.user-login = v-login
     2487                 no-lock
     2488                 no-error
     2489                 .
     2490            IF AVAILABLE buf_user-login
     2491            THEN DO:
     2492               assign
     2493                  p-user-id = buf_user-login.user-id
     2494               .
     2495            END.
     2496      end.
     2497   end procedure.
     2498       run diasize_init in this-procedure .
     2499   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2500   on ' ' of sch-date in frame Dialog-Frame
     2501   do:
     2502     if (can-query (self, "sensitive")
     2503        and
     2504        self :sensitive = true
     2505        )
     2506     or (can-query (self, "read-only")
     2507        and
     2508        self :read-only = false
     2509        )
     2510     then do:
     2511       assign
     2512         self :screen-value = ?
     2513       .
     2514     end.
     2515     return no-apply.
     2516   end.
     2517   on delete-character of sch-date in frame Dialog-Frame
     2518   do:
     2519     if (can-query (self, "sensitive")
     2520        and
     2521        self :sensitive = true
     2522        )
     2523     or (can-query (self, "read-only")
     2524        and
     2525        self :read-only = false
     2526        )
     2527     then do:
     2528       assign
     2529         self :screen-value = ?
     2530       .
     2531     end.
     2532     return no-apply.
     2533   end.
     2534   on ctrl-d of sch-date in frame Dialog-Frame
     2535   do:
     2536     define variable v-curr-sv-date as date no-undo .
     2537     if (can-query (self, "sensitive")
     2538        and
     2539        self :sensitive = true
     2540        )
     2541     or (can-query (self, "read-only")
     2542        and
     2543        self :read-only = false
     2544        )
     2545     then do:
     2546       if self :handle <> focus :handle
     2547       then do:
     2548         apply "entry":u to self .
     2549       end.
     2550       run gbl/getcurdt.p
     2551         (output v-curr-sv-date
     2552         ) .
     2553       assign
     2554         self :screen-value = string(v-curr-sv-date) .
     2555       .
     2556     end.
     2557     return no-apply.
     2558   end.
     2559   on ctrl-b of sch-date in frame Dialog-Frame
     2560   do:
     2561     if (can-query (self, "sensitive")
     2562        and
     2563        self :sensitive = true
     2564        )
     2565     or (can-query (self, "read-only")
     2566        and
     2567        self :read-only = false
     2568        )
     2569     then do:
     2570       if self :handle <> focus :handle
     2571       then do:
     2572         apply "entry":u to self .
     2573       end.
     2574       define variable v-curr-sv-date as date no-undo .
     2575       define variable v-new-sv-date  as date no-undo .
     2576       assign
     2577         v-curr-sv-date = date(self :screen-value) no-error
     2578       .
     2579       if v-curr-sv-date = ?
     2580       then do:
     2581         run gbl/getcurdt.p
     2582           (output v-curr-sv-date
     2583           ) .
     2584       end.
     2585       if v-curr-sv-date <> ?
     2586       then do:
     2587         assign
     2588           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2589         .
     2590         assign
     2591           self :screen-value = string(v-new-sv-date) .
     2592         .
     2593       end.
     2594     end.
     2595     return no-apply .
     2596   end.
     2597   on ctrl-e of sch-date in frame Dialog-Frame
     2598   do:
     2599     if (can-query (self, "sensitive")
     2600        and
     2601        self :sensitive = true
     2602        )
     2603     or (can-query (self, "read-only")
     2604        and
     2605        self :read-only = false
     2606        )
     2607     then do:
     2608       if self :handle <> focus :handle
     2609       then do:
     2610         apply "entry":u to self .
     2611       end.
     2612       define variable v-curr-sv-date as date no-undo .
     2613       define variable v-new-sv-date  as date no-undo .
     2614       assign
     2615         v-curr-sv-date = date(self :screen-value) no-error
     2616       .
     2617       if v-curr-sv-date = ?
     2618       then do:
     2619         run gbl/getcurdt.p
     2620           (output v-curr-sv-date
     2621           ) .
     2622       end.
     2623       if v-curr-sv-date <> ?
     2624       then do:
     2625         run gbl/lastdate.p
     2626           (input  v-curr-sv-date
     2627           ,output v-new-sv-date
     2628           ).
     2629         assign
     2630           self :screen-value = string(v-new-sv-date) .
     2631         .
     2632       end.
     2633     end.
     2634     return no-apply .
     2635   end.
     2636   on ctrl-f of sch-date in frame Dialog-Frame
     2637   do:
     2638     if (can-query (self, "sensitive")
     2639        and
     2640        self :sensitive = true
     2641        )
     2642     or (can-query (self, "read-only")
     2643        and
     2644        self :read-only = false
     2645        )
     2646     then do:
     2647       if self :handle <> focus :handle
     2648       then do:
     2649         apply "entry":u to self .
     2650       end.
     2651       define variable v-ok            as logical   no-undo .
     2652       define variable v-curr-sv-date  as date      no-undo .
     2653       define variable v-description   as character no-undo .
     2654       assign
     2655         v-curr-sv-date = date(self :screen-value) no-error
     2656       .
     2657       if v-curr-sv-date = ?
     2658       then do:
     2659         run gbl/getcurdt.p
     2660           (output v-curr-sv-date
     2661           ) .
     2662       end.
     2663       if v-curr-sv-date <> ?
     2664       then do:
     2665         run gbl/d-inpday.w
     2666           (input ?
     2667           ,input "Выбор даты"
     2668           ,input v-description
     2669           ,input ""
     2670           ,input-output v-curr-sv-date
     2671           ,output v-ok
     2672           ).
     2673         if v-ok = true
     2674         then do:
     2675           assign
     2676             self :screen-value = string(v-curr-sv-date) .
     2677           .
     2678         end.
     2679       end.
     2680     end.
     2681     return no-apply .
     2682   end.
     2683     define MENU m-ed-date15
     2684       MENU-ITEM m-ed-date15-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2685       MENU-ITEM m-ed-date15-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2686       MENU-ITEM m-ed-date15-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2687       MENU-ITEM m-ed-date15-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     2688       .
     2689     if sch-date :POPUP-MENU in frame Dialog-Frame = ?
     2690     then do:
     2691       ASSIGN
     2692         sch-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date15 :HANDLE
     2693         sch-date :MENU-MOUSE in frame Dialog-Frame = 3
     2694       .
     2695     end.
     2696     define variable v-label-handle15 as handle no-undo .
     2697     assign
     2698       v-label-handle15 = sch-date :side-label-handle in frame Dialog-Frame
     2699     .
     2700     if valid-handle (v-label-handle15)
     2701     then do:
     2702       if v-label-handle15 :tooltip = ""
     2703       or v-label-handle15 :tooltip = ?
     2704       then do:
     2705         assign
     2706           v-label-handle15 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     2707         .
     2708       end.
     2709     end.
     2710     ON CHOOSE OF MENU-ITEM m-ed-date15-1 in menu m-ed-date15 DO:
     2711       apply "ctrl-b":U to sch-date in frame Dialog-Frame .
     2712     END.
     2713     ON CHOOSE OF MENU-ITEM m-ed-date15-2 in menu m-ed-date15 DO:
     2714       apply "ctrl-d":U to sch-date in frame Dialog-Frame .
     2715     END.
     2716     ON CHOOSE OF MENU-ITEM m-ed-date15-3 in menu m-ed-date15 DO:
     2717       apply "ctrl-e":U to sch-date in frame Dialog-Frame .
     2718     END.
     2719     ON CHOOSE OF MENU-ITEM m-ed-date15-4 in menu m-ed-date15 DO:
     2720       apply "ctrl-f":U to sch-date in frame Dialog-Frame .
     2721     END.
     2722   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2723   on f5 of frame Dialog-Frame anywhere
     2724   do:
     2725     run enable_UI in this-procedure .  run init-p in this-procedure .
     2726       apply "VALUE-CHANGED" to br-docs.
     2727   end.
     2728   MAIN-BLOCK:
     2729   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2730      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2731     run enable_UI in this-procedure .
     2732     run init-p in this-procedure .
     2733     WAIT-FOR GO OF FRAME Dialog-Frame.
     2734   END.
     2735   run disable_UI in this-procedure .
     2736   PROCEDURE disable_UI :
     2737     HIDE FRAME Dialog-Frame.
     2738   END PROCEDURE.
     2739   PROCEDURE enable_UI :
     2740     OPEN QUERY Dialog-Frame FOR EACH ub.ord-cons SHARE-LOCK.
     2741     GET FIRST Dialog-Frame.
     2742     DISPLAY EDITOR_PS sch-code sch-date sch-num
     2743         WITH FRAME Dialog-Frame.
     2744     ENABLE b-quit b-mark b-sel b-rep b-sch b-za b-zak b-post b-help b-add b-lkp
     2745            b-chg b-del b-close b-open b-print br-docs EDITOR_PS sch-code sch-date
     2746            sch-num
     2747         WITH FRAME Dialog-Frame.
     2748     VIEW FRAME Dialog-Frame.
     2749     OPEN QUERY br-docs FOR EACH shar-buf_ord-cons       WHERE shar-buf_ord-cons.host-code = v-cntxt-host-code-obj and (p-status = "all":U  or (shar-buf_ord-cons.status_ = p-status) ) NO-LOCK     BY shar-buf_ord-cons.doc-date DESCENDING        BY shar-buf_ord-cons.cons-code DESCENDING.
     2750   END PROCEDURE.
     2751   PROCEDURE init-p :
     2752   frame Dialog-Frame:title =  "Совокупные заявки , Фирма: " + p-g#host-name  +
     2753   if p-status = "all" then "" else ", Статус: " + p-status.
     2754   If list-mode <> "obj":U  then do:
     2755      if not( p-status = 'новый':U  OR  p-status = "all" )  then disable  b-add b-del b-chg with frame Dialog-Frame .
     2756      if ( p-status = 'распределение':U
     2757           or  p-status = 'закрыто':U
     2758            )  then do:
     2759           enable   b-chg with frame Dialog-Frame .
     2760           disable  b-add b-del with frame Dialog-Frame .
     2761         end.
     2762      end.
     2763      else do:
     2764         disable b-close b-add b-del b-sel b-mark with frame Dialog-Frame .
     2765      end.
     2766   ASSIGN B-print:POPUP-MENU IN FRAME Dialog-Frame = MENU POPUP-MENU-B-print:HANDLE.
     2767   ASSIGN B-print:MENU-MOUSE = 1.
     2768   disable b-open with frame Dialog-Frame .
     2769   END PROCEDURE.
     2770   PROCEDURE OpenBr :
     2771   define variable l-query-was-opened as logical no-undo .
     2772   define variable title0 as character no-undo.
     2773   title0 = "Совокупные заказы".
     2774   run waitfram-show in this-procedure ("Ждите...").
     2775   define variable sort-column-phrase as character no-undo .
     2776   case sort-column-name :
     2777     when "" then do:
     2778       assign
     2779         sort-column-phrase = ""
     2780       .
     2781     end.
     2782     otherwise do:
     2783       assign
     2784         sort-column-phrase = "by " + sort-column-name
     2785       .
     2786     end.
     2787   end case.
     2788   do:
     2789   if p-status = 'all' then  do:
     2790   frame Dialog-Frame:TITLE = title0  .
     2791   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2792   define variable  l-disable-where-18  as logical   no-undo .
     2793   define variable  l-filter-open-18    as logical   .
     2794   define variable  flt-rec-18       as recid     no-undo .
     2795   define variable  filter-name-18      as character no-undo .
     2796   define variable  where-phrase-18     as character no-undo .
     2797   define variable  sort-phrase-18      as character no-undo .
     2798   define variable  where-phrase-rus-18 as character no-undo .
     2799   define variable  sort-phrase-rus-18  as character no-undo .
     2800   run gbl/flt-get.p
     2801     (input filter-point
     2802     ,output flt-rec-18
     2803     ,output filter-name-18
     2804     ,output where-phrase-18
     2805     ,output sort-phrase-18
     2806     ,output where-phrase-rus-18
     2807     ,output sort-phrase-rus-18
     2808     ).
     2809       run set-filter-name in this-procedure
     2810         (INPUT filter-name-18
     2811         ) no-error .
     2812     assign
     2813       l-filter-open-18 = false
     2814     .
     2815     if flt-rec-18 <> ?
     2816       or sort-column-phrase > ""
     2817     then do:
     2818       define variable  parameter-2-18 as character no-undo .
     2819       define variable  parameter-3-18 as character no-undo .
     2820       define variable  parameter-4-18 as character no-undo .
     2821       define variable  parameter-5-18 as character no-undo .
     2822       define variable  parameter-6-18 as character no-undo .
     2823       define variable  parameter-7-18 as character no-undo .
     2824         assign
     2825         parameter-3-18 =
     2826                                 "FOR EACH shar-buf_ord-cons"
     2827         parameter-4-18 =
     2828           (
     2829             if (" TRUE " + " " + where-phrase-18) <> ""
     2830             then  'TRUE'  + " " + where-phrase-18
     2831             else "true"
     2832           )
     2833         parameter-5-18 = (" " + "" + " " + "")
     2834         parameter-6-18 = if sort-phrase-18 = ''
     2835                              then
     2836           (
     2837           " " + " USE-INDEX pi " +
     2838             " " + sort-column-phrase +
     2839           " " + "  "
     2840           )
     2841                              else
     2842           (
     2843           " " + " USE-INDEX pi " +
     2844             " " + sort-column-phrase +
     2845           " " + sort-phrase-18
     2846           )
     2847         parameter-7-18 =
     2848           " indexed-reposition  "
     2849       .
     2850       do
     2851       on stop undo, leave
     2852       on error undo, leave
     2853       :
     2854         assign
     2855           l-disable-where-18 =
     2856             (" TRUE " + " " + where-phrase-18 = "")
     2857         .
     2858         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2859                             ,input query br-docs:handle
     2860                             ,input parameter-3-18
     2861                             ,input parameter-4-18
     2862                             ,input parameter-5-18
     2863                             ,input parameter-6-18
     2864                             ,input parameter-7-18
     2865                             )
     2866         .
     2867         assign
     2868           l-filter-open-18 = true
     2869         .
     2870       end.
     2871       if l-filter-open-18 = false then do:
     2872         message
     2873           "Ошибка при фильтрации / сортировке" skip
     2874           "Будут показаны записи без учета фильтра" skip
     2875           view-as alert-box .
     2876       end.
     2877       else do:
     2878           assign
     2879             l-query-was-opened = true
     2880           .
     2881       end.
     2882     end.
     2883     if l-filter-open-18 = false then do:
     2884       OPEN QUERY br-docs FOR EACH shar-buf_ord-cons
     2885         where  TRUE
     2886          USE-INDEX pi
     2887         indexed-reposition
     2888     .
     2889         assign
     2890           l-query-was-opened = true
     2891         .
     2892     end.
     2893   end.
     2894   else do:
     2895   frame Dialog-Frame:TITLE = title0  .
     2896   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2897   define variable  l-disable-where-20  as logical   no-undo .
     2898   define variable  l-filter-open-20    as logical   .
     2899   define variable  flt-rec-20       as recid     no-undo .
     2900   define variable  filter-name-20      as character no-undo .
     2901   define variable  where-phrase-20     as character no-undo .
     2902   define variable  sort-phrase-20      as character no-undo .
     2903   define variable  where-phrase-rus-20 as character no-undo .
     2904   define variable  sort-phrase-rus-20  as character no-undo .
     2905   run gbl/flt-get.p
     2906     (input filter-point
     2907     ,output flt-rec-20
     2908     ,output filter-name-20
     2909     ,output where-phrase-20
     2910     ,output sort-phrase-20
     2911     ,output where-phrase-rus-20
     2912     ,output sort-phrase-rus-20
     2913     ).
     2914       run set-filter-name in this-procedure
     2915         (INPUT filter-name-20
     2916         ) no-error .
     2917     assign
     2918       l-filter-open-20 = false
     2919     .
     2920     if flt-rec-20 <> ?
     2921       or sort-column-phrase > ""
     2922     then do:
     2923       define variable  parameter-2-20 as character no-undo .
     2924       define variable  parameter-3-20 as character no-undo .
     2925       define variable  parameter-4-20 as character no-undo .
     2926       define variable  parameter-5-20 as character no-undo .
     2927       define variable  parameter-6-20 as character no-undo .
     2928       define variable  parameter-7-20 as character no-undo .
     2929         assign
     2930         parameter-3-20 =
     2931                                 "FOR EACH shar-buf_ord-cons"
     2932         parameter-4-20 =
     2933           (
     2934             if (" shar-buf_ord-cons.status_ = p-status " + " " + where-phrase-20) <> ""
     2935             then  substitute(' shar-buf_ord-cons.status_ =  &1&2&1 ' , chr(34) , p-status )  + " " + where-phrase-20
     2936             else "true"
     2937           )
     2938         parameter-5-20 = (" " + "" + " " + "")
     2939         parameter-6-20 = if sort-phrase-20 = ''
     2940                              then
     2941           (
     2942           " " + " USE-INDEX pi " +
     2943             " " + sort-column-phrase +
     2944           " " + "  "
     2945           )
     2946                              else
     2947           (
     2948           " " + " USE-INDEX pi " +
     2949             " " + sort-column-phrase +
     2950           " " + sort-phrase-20
     2951           )
     2952         parameter-7-20 =
     2953           " indexed-reposition  "
     2954       .
     2955       do
     2956       on stop undo, leave
     2957       on error undo, leave
     2958       :
     2959         assign
     2960           l-disable-where-20 =
     2961             (" shar-buf_ord-cons.status_ = p-status " + " " + where-phrase-20 = "")
     2962         .
     2963         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2964                             ,input query br-docs:handle
     2965                             ,input parameter-3-20
     2966                             ,input parameter-4-20
     2967                             ,input parameter-5-20
     2968                             ,input parameter-6-20
     2969                             ,input parameter-7-20
     2970                             )
     2971         .
     2972         assign
     2973           l-filter-open-20 = true
     2974         .
     2975       end.
     2976       if l-filter-open-20 = false then do:
     2977         message
     2978           "Ошибка при фильтрации / сортировке" skip
     2979           "Будут показаны записи без учета фильтра" skip
     2980           view-as alert-box .
     2981       end.
     2982       else do:
     2983           assign
     2984             l-query-was-opened = true
     2985           .
     2986       end.
     2987     end.
     2988     if l-filter-open-20 = false then do:
     2989       OPEN QUERY br-docs FOR EACH shar-buf_ord-cons
     2990         where  shar-buf_ord-cons.status_ = p-status
     2991          USE-INDEX pi
     2992         indexed-reposition
     2993     .
     2994         assign
     2995           l-query-was-opened = true
     2996         .
     2997     end.
     2998   end.
     2999   end.
     3000   run waitfram-hide in this-procedure .
     3001   END PROCEDURE.
     3002   PROCEDURE proc-b-sch :
     3003   assign
     3004     tbl = 'ord-cons'
     3005     join-tbl = 'shar-buf_ord-cons'
     3006     fld = ""
     3007     lab = ""
     3008     spr = ""
     3009     dim = '0'
     3010     .
     3011   run fltfield-add in this-procedure ('cons-code', 'Номер', '',
     3012   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3013   run fltfield-add in this-procedure ('doc-date', 'Дата', '',
     3014   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3015   run fltfield-add in this-procedure ('fact-date', 'Факт', '',
     3016   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3017   run fltfield-add in this-procedure ('status_', 'Статус', 'order-status-all',
     3018   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3019   run fltfield-add in this-procedure ('PS', 'Комментарий', '',
     3020   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3021   run fltfield-add in this-procedure ('creid', 'Опер-р', 'usr',
     3022   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3023     Filter-Block:
     3024     DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3025        ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3026        ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3027       run gbl/filter.w ( INPUT parParentProc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     3028       run OpenBr in this-procedure .
     3029     END.
     3030   END PROCEDURE.
     3031   PROCEDURE set-filter-name :
     3032   define input parameter p-filter-name as character no-undo .
     3033     do with frame Dialog-Frame:
     3034       if p-filter-name > "" then do:
     3035         assign
     3036           frame Dialog-Frame:title
     3037             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3038         .
     3039         assign
     3040           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     3041         .
     3042       end.
     3043       else do:
     3044         assign
     3045           b-sch :TOOLTIP = ""
     3046         .
     3047       end.
     3048     end.
     3049   END PROCEDURE.
