        1   define input parameter parParentProc  as widget-handle no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Движение по товарам".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      113   define new shared variable RepPathName        as character no-undo .
      114   define new shared variable PrintRubl          as logical   no-undo .
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118     define variable v-cntxt-db-num        as integer   no-undo .
      119     define variable v-cntxt-userid        as character no-undo .
      120     define variable v-cntxt-level         as character no-undo .
      121     define variable v-cntxt-host-code-obj as integer   no-undo .
      122     define variable v-cntxt-obj-type      as character no-undo .
      123     define variable v-cntxt-obj-code      as integer   no-undo .
      124     define variable v-cntxt-db-num-obj    as integer   no-undo .
      125     define variable v-cntxt-is-admin      as logical   no-undo .
      126   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127     run mainmenu_getcntxt in parparentproc
      128       (output v-cntxt-db-num
      129       ,output v-cntxt-userid
      130       ,output v-cntxt-level
      131       ,output v-cntxt-host-code-obj
      132       ,output v-cntxt-obj-type
      133       ,output v-cntxt-obj-code
      134       ,output v-cntxt-db-num-obj
      135       ,output v-cntxt-is-admin
      136       ) .
      137   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      140   define variable par-type          as character no-undo.
      141   define variable v-value-character as character no-undo .
      142   define variable v-value-date      as date      no-undo .
      143   define variable v-value-decimal   as decimal   no-undo .
      144   define variable v-value-integer   as integer   no-undo .
      145   define variable v-value-logical   as logical   no-undo .
      146   define variable g#report-num as integer   no-undo .
      147   run get-report-num  in parParentProc ( output g#report-num ).
      148   define variable g#log as logical   no-undo .
      149   define variable type-par1 as character no-undo .
      150   define variable tmp-var1  as character no-undo .
      151   define variable p-XL-delim as character no-undo .
      152   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   empty temp-table thbjattr_thbj-attr.
      154   run adm/shattri.p (
      155      input "get":U
      156     ,input v-cntxt-obj-type
      157     ,input v-cntxt-obj-code
      158     ,input 'report-firm':U
      159     ,input  ""
      160     ,output v-value-character
      161     ,output v-value-date
      162     ,output v-value-decimal
      163     ,output v-value-integer
      164     ,output v-value-logical
      165     ,output par-type
      166     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      167     ) no-error .
      168   for each thbjattr_thbj-attr :
      169       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
      170   end.
      171   IF tmp-var1 = "" then p-XL-delim = ";".
      172   else p-XL-delim = tmp-var1.
      173   define temp-table temp_result no-undo
      174          field cli-type       like ub.trn-doc.cli-type
      175          field cli-code       like ub.trn-doc.cli-code
      176          field cli-name       like ub.trn-doc.cli-name
      177          field rem-beg        as decimal
      178          field rem-beg-sum    as decimal
      179          field rem-end        as decimal
      180          field rem-end-sum    as decimal
      181          field inp            as decimal
      182          field sum-in         as decimal
      183          field outp           as decimal
      184          field sum-out        as decimal
      185          field rac            as decimal
      186          field sum-rac        as decimal
      187          index code is unique primary
      188              cli-type
      189              cli-code
      190          index name
      191              cli-name
      192          .
      193   define temp-table gds-tbl no-undo
      194          field artic          like ub.doc-line.artic
      195          field prod-type  like ub.goods.prod-type
      196          field prod-code like ub.goods.prod-code
      197          field price as dec
      198      index art is unique primary
      199          artic
      200          prod-type
      201          prod-code
      202          .
      203   define variable beg-date    as date     no-undo.
      204   define variable end-date    as date     no-undo.
      205   define variable var-date    as date     no-undo.
      206   define variable v-counter   as integer  no-undo.
      207   define stream out-stream.
      208   DEFINE BUTTON b-entry DEFAULT
      209        LABEL "&Сбор данных"
      210        SIZE 12.5 BY 1
      211        BGCOLOR 8 .
      212   DEFINE BUTTON b-help DEFAULT
      213        LABEL "Помо&щь"
      214        SIZE 10 BY 1
      215        BGCOLOR 8 .
      216   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      217        LABEL "&Выход"
      218        SIZE 10 BY 1
      219        BGCOLOR 8 .
      220   DEFINE VARIABLE enddate AS DATE FORMAT "99/99/9999":U
      221        LABEL "По"
      222        VIEW-AS FILL-IN
      223        SIZE 11 BY 1 NO-UNDO.
      224   DEFINE VARIABLE fi-counter AS INTEGER FORMAT "->>>>>>>>9":U INITIAL 0
      225        LABEL "Обработано товаров"
      226        VIEW-AS FILL-IN
      227        SIZE 14 BY 1
      228        FGCOLOR 1  NO-UNDO.
      229   DEFINE VARIABLE startdate AS DATE FORMAT "99/99/9999":U
      230        LABEL "С"
      231        VIEW-AS FILL-IN
      232        SIZE 11 BY 1 NO-UNDO.
      233   DEFINE FRAME xl-ob
      234        b-quit AT ROW 1 COL 1
      235        b-entry AT ROW 1 COL 11
      236        b-help AT ROW 1 COL 27.5
      237        startdate AT ROW 2.75 COL 4 COLON-ALIGNED
      238        enddate AT ROW 2.75 COL 22.25 COLON-ALIGNED
      239        fi-counter AT ROW 4.29 COL 20.88 COLON-ALIGNED
      240        SPACE(0.74) SKIP(2.20)
      241       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      242            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      243            TITLE "Движение по товарам"
      244            CANCEL-BUTTON b-quit.
      245   ASSIGN
      246          FRAME xl-ob:SCROLLABLE       = FALSE.
      247   ASSIGN
      248          fi-counter:HIDDEN IN FRAME xl-ob           = TRUE.
      249   ON CHOOSE OF b-entry IN FRAME xl-ob
      250   DO:
      251       assign
      252           startdate
      253           enddate
      254       .
      255       if (startdate <> ? and enddate <> ?)
      256       and startdate <= enddate
      257       then do:
      258           assign
      259               beg-date = startdate
      260               end-date = enddate
      261           .
      262           run calc-oborot in this-procedure no-error.
      263           if error-status :error
      264           then do:
      265               message
      266                 vss-workfile vss-revision vss-description
      267                 skip "Ошибка при расчете оборотов."
      268                 skip return-value
      269                 skip trim(error-status :get-message(1))
      270                      trim(error-status :get-message(2))
      271                      trim(error-status :get-message(3))
      272                      trim(error-status :get-message(4))
      273                      trim(error-status :get-message(5))
      274               view-as alert-box error.
      275               undo, return no-apply .
      276           end.
      277           run print-result in this-procedure no-error.
      278           if error-status :error
      279           then do:
      280               message
      281                 vss-workfile vss-revision vss-description
      282                 skip "Ошибка при выводе в файл."
      283                 skip return-value
      284                 skip trim(error-status :get-message(1))
      285                      trim(error-status :get-message(2))
      286                      trim(error-status :get-message(3))
      287                      trim(error-status :get-message(4))
      288                      trim(error-status :get-message(5))
      289               view-as alert-box error.
      290               undo, return no-apply .
      291           end.
      292           message " Отчет завершен " view-as alert-box information buttons ok.
      293           hide fi-counter in frame xl-ob.
      294        end.
      295        else if startdate = ? then do:
      296            message "Не задана дата C". pause.
      297        end.
      298        else if enddate = ? then do:
      299            message "Не задана дата По". pause.
      300        end.
      301        else if startdate > enddate then do:
      302            message "Дата начала периода должна быть меньше даты конца". pause.
      303        end.
      304   END.
      305   ON RETURN OF enddate IN FRAME xl-ob
      306   DO:
      307       APPLY "ENTRY" TO b-entry IN FRAME xl-ob.
      308       RETURN NO-APPLY.
      309   END.
      310   ON RETURN OF startdate IN FRAME xl-ob
      311   DO:
      312       APPLY "ENTRY" TO enddate IN FRAME xl-ob.
      313       RETURN NO-APPLY.
      314   END.
      315   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME xl-ob:PARENT eq ?
      316   THEN FRAME xl-ob:PARENT = ACTIVE-WINDOW.
      317   ON WINDOW-CLOSE OF FRAME xl-ob APPLY "END-ERROR":U TO SELF.
      318   assign
      319       startdate = date( month( today ), 1, year( today ) )
      320       enddate = today .
      321   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      322   on help of frame xl-ob
      323   do:
      324     run gbl/app_help.p
      325       (input this-procedure :file-name
      326       ,input ''
      327       ,input ?
      328       ) no-error.
      329     if error-status :error then do:
      330       message
      331         "Ошибка при вызове помощи"
      332         error-status :get-message(1)
      333         view-as alert-box .
      334     end.
      335   end.
      336   run minbtn-set in this-procedure .
      337   on choose of b-help in frame xl-ob
      338   do:
      339     apply "help":u to frame xl-ob .
      340   end.
      341   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      342   procedure minbtn-set :
      343       do
      344           on error undo, return error return-value
      345           :
      346           define variable ii              as integer       no-undo .
      347           define variable fh              as widget-handle no-undo .
      348           define variable hh              as widget-handle no-undo .
      349           define variable v-h             as handle        extent 4 no-undo .
      350           define variable v-name-button   as character     no-undo .
      351           define variable v-help-old-x    as decimal       no-undo .
      352           define variable v-help-old-y    as decimal       no-undo .
      353           define variable v-help-old-size as decimal       no-undo .
      354           define variable v-frame-width   as decimal       no-undo .
      355           define variable jj              as integer       no-undo .
      356           do
      357               on error undo, return error
      358               :
      359               assign
      360                   v-frame-width = frame xl-ob:width - 0.3
      361                   fh            = frame xl-ob:first-child
      362                   hh            = fh:first-child
      363                   ii            = 1
      364                   .
      365               do while valid-handle(hh):
      366                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      367                   do:
      368                       case lc(hh:name) :
      369                           when "b-help" then
      370                               do:
      371                                   hh:load-image-up("cmp/b-help.bmp":u) .
      372                                   hh:load-image-down("cmp/b-help.bmp":u) .
      373                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      374                                   hh:TOOLTIP = "Помощь" .
      375                                   v-help-old-x = hh:column .
      376                                   v-help-old-y = hh:row    .
      377                                   v-help-old-size = hh:width .
      378                                   hh:width-chars = 2.5 .
      379                               end.
      380                           when "b-print" then
      381                               do:
      382                                   hh:load-image("cmp/b-print.bmp":u) .
      383                                   hh:TOOLTIP = "Печать" .
      384                                   v-h[ii] = hh:handle .
      385                                   ii = ii + 1 .
      386                                   hh:width-chars = 3 .
      387                               end.
      388                           when "b-history" or
      389                           when "b-hist" then
      390                               do:
      391                                   hh:load-image("cmp/b-hist.bmp":u) .
      392                                   hh:TOOLTIP = "История" .
      393                                   v-h[ii] = hh:handle .
      394                                   ii = ii + 1 .
      395                                   hh:width-chars = 3 .
      396                               end.
      397                           when "b-sch" then
      398                               do:
      399                                   hh:load-image("cmp/b-sch.bmp":u) .
      400                                   hh:TOOLTIP = "Установка Фильтра" .
      401                                   v-h[ii] = hh:handle .
      402                                   ii = ii + 1 .
      403                                   hh:width-chars = 3 .
      404                               end.
      405                           when "b-hist-user" then
      406                               do:
      407                                   hh:load-image("cmp/b-hist.bmp":u) .
      408                                   hh:TOOLTIP = "История пользователя" .
      409                                   ii = ii + 1 .
      410                               end.
      411                       end case.
      412                   end.
      413                   hh = hh:next-sibling.
      414               end.
      415               b-help:column = v-frame-width - b-help:width-chars.
      416               jj = 0.
      417               repeat ii = 4 to 1 by -1 :
      418                   if valid-handle (v-h[ii] ) then
      419                   do:
      420                       jj  = jj + 1 .
      421                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      422                       v-h[ii]:row    = v-help-old-y .
      423                   end.
      424               end.
      425           end.
      426       end.
      427   end procedure.
      428   MAIN-BLOCK:
      429   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      430      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      431     if session:set-wait-state("COMPILER") then.
      432     run enable_ui.
      433     if session:set-wait-state("") then.
      434     APPLY "ENTRY" TO startdate IN FRAME xl-ob.
      435     WAIT-FOR GO OF FRAME xl-ob.
      436   END.
      437   run disable_ui.
      438   PROCEDURE calc-oborot :
      439   do
      440   on error undo, return error
      441   :
      442   define variable v-ext-doc-type-list  as char format "X(25)" extent 36 init
      443     [
      444          "приход внешний",                                   'ie':U,
      445          "расход внешний",                                   'ee':U,
      446          "расход внешний возврат поставщику",                'ep':U,
      447          "расход внешний продажа через кассу",               'es':U,
      448          "возврат внешний",                                  're':U,
      449          "возврат внешний через кассу",                      'rs':U,
      450          "списание внешнее",                                 'we':U,
      451          "инвентаризация",                                   'vt':U,
      452          "коррекция учетных цен",                            'ap':U,
      453          "смена типа приобретения",                          'pc':U,
      454          "корретировка отрицательных партий",                'mp':U,
      455          "приход перемещение",                               'iv':U,
      456          "расход перемещение",                               'ev':U,
      457          "возврат перемещение",                              'rv':U,
      458          "списание производство",                            'wm':U,
      459          "приход производство",                              'im':U,
      460          "документ переоценки",                              'ot':U,
      461          "пересортица",                                      'vp':U
      462     ]
      463   no-undo.
      464   define variable v-fact-order-from like ub.ot-line.fact-order      no-undo.
      465   define variable v-fact-order-to   like ub.ot-line.fact-order      no-undo.
      466   define variable v-oper-num        as integer                      no-undo.
      467   define variable v-docs-exists     as logical           no-undo.
      468   define variable v-ext-doc-type    as character         no-undo.
      469   define variable v-counter         as integer           no-undo.
      470   define variable v-stk-start      as decimal      no-undo.
      471   define variable v-sum-start      as decimal      no-undo.
      472   define variable v-stk-end        as decimal      no-undo.
      473   define variable v-sum-end        as decimal      no-undo.
      474   define variable v-income         as decimal      no-undo.
      475   define variable v-sum-income     as decimal      no-undo.
      476   define variable v-expense        as decimal      no-undo.
      477   define variable v-sum-expence    as decimal      no-undo.
      478   define variable v-kass           as decimal      no-undo.
      479   define variable v-sum-kass       as decimal      no-undo.
      480   define buffer buf_stk-line       for ub.stk-line.
      481   run rep/get-fo.p (
      482                  input v-cntxt-obj-type
      483                , input v-cntxt-obj-code
      484                , input beg-date
      485                , input end-date
      486                , output v-fact-order-from
      487                , output v-fact-order-to
      488                , output v-docs-exists
      489                ).
      490   for each ub.gds-obj no-lock
      491      where ub.gds-obj.obj-type      = v-cntxt-obj-type
      492        and ub.gds-obj.obj-code      = v-cntxt-obj-code
      493   break   by ub.gds-obj.artic
      494           by ub.gds-obj.prod-type
      495           by ub.gds-obj.prod-code
      496   :
      497   if first-of( ub.gds-obj.prod-code )
      498   then do:
      499       assign
      500           v-counter = v-counter + 1
      501       .
      502       if ( v-counter modulo 25 ) = 0
      503       then do:
      504           view fi-counter in frame xl-ob.
      505           assign
      506               fi-counter :screen-value in frame xl-ob = string( v-counter )
      507           .
      508       end.
      509       find last buf_stk-line no-lock
      510           where buf_stk-line.obj-type      = ub.gds-obj.obj-type
      511             and buf_stk-line.obj-code      = ub.gds-obj.obj-code
      512             and buf_stk-line.artic         = ub.gds-obj.artic
      513             and buf_stk-line.prod-type     = ub.gds-obj.prod-type
      514             and buf_stk-line.prod-code     = ub.gds-obj.prod-code
      515             and buf_stk-line.sum-type      = 'crsa':U
      516             and buf_stk-line.cat-id        = '##,##':U
      517             and buf_stk-line.fact-order    <=  v-fact-order-from
      518       no-error.
      519       if not available buf_stk-line
      520       then do:
      521           assign
      522               v-stk-start = 0
      523               v-sum-start = 0
      524           .
      525       end.
      526       else do:
      527           assign
      528               v-stk-start = buf_stk-line.fact-qnty
      529               v-sum-start = buf_stk-line.sum-base
      530           .
      531       end.
      532       find last buf_stk-line no-lock
      533           where buf_stk-line.obj-type      = ub.gds-obj.obj-type
      534             and buf_stk-line.obj-code      = ub.gds-obj.obj-code
      535             and buf_stk-line.artic         = ub.gds-obj.artic
      536             and buf_stk-line.prod-type     = ub.gds-obj.prod-type
      537             and buf_stk-line.prod-code     = ub.gds-obj.prod-code
      538             and buf_stk-line.sum-type      = 'crsa':U
      539             and buf_stk-line.cat-id        = '##,##':U
      540             and buf_stk-line.fact-order    <=  v-fact-order-to
      541       no-error.
      542       if not available buf_stk-line
      543       then do:
      544           assign
      545               v-stk-end = v-stk-start
      546               v-sum-end = v-sum-start
      547           .
      548       end.
      549       else do:
      550           assign
      551               v-stk-end = buf_stk-line.fact-qnty
      552               v-sum-end = buf_stk-line.sum-base
      553           .
      554       end.
      555       run update-temp-result in this-procedure (
      556                 input ub.gds-obj.obj-type
      557               , input ub.gds-obj.obj-code
      558               , input v-stk-start
      559               , input v-sum-start
      560               , input v-stk-end
      561               , input v-sum-end
      562               , input 0
      563               , input 0
      564               , input 0
      565               , input 0
      566               , input 0
      567               , input 0
      568       ).
      569       do v-oper-num = 1 to 14
      570       :
      571           assign
      572               v-ext-doc-type = v-ext-doc-type-list [v-oper-num * 2]
      573           .
      574           for each buf_stk-line no-lock
      575              where buf_stk-line.obj-type      = ub.gds-obj.obj-type
      576                and buf_stk-line.obj-code      = ub.gds-obj.obj-code
      577                and buf_stk-line.artic         = ub.gds-obj.artic
      578                and buf_stk-line.prod-type     = ub.gds-obj.prod-type
      579                and buf_stk-line.prod-code     = ub.gds-obj.prod-code
      580                and ( buf_stk-line.sum-type      = 'cgdt':U         + v-ext-doc-type
      581                   or buf_stk-line.sum-type      = 'gdsr':U + v-ext-doc-type
      582                    )
      583                and buf_stk-line.cat-id        = '##,##':U
      584                and buf_stk-line.fact-order    >  v-fact-order-from
      585                and buf_stk-line.fact-order    <= v-fact-order-to
      586           :
      587               case v-ext-doc-type
      588               :
      589               when 'ie':U or when 'iv':U or when 'im':U
      590               then do:
      591                   assign
      592                       v-income      = buf_stk-line.fact-qnty
      593                       v-sum-income  = buf_stk-line.sum-base
      594                       v-expense     = 0
      595                       v-sum-expence = 0
      596                       v-kass        = 0
      597                       v-sum-kass    = 0
      598                   .
      599               end.
      600               when 'ee':U or when 'ep':U or when 're':U
      601               or when 'we':U or when 'ev':U or when 'rv':U
      602               or when 'wm':U
      603               then do:
      604                   assign
      605                       v-income      = 0
      606                       v-sum-income  = 0
      607                       v-expense     = buf_stk-line.fact-qnty
      608                       v-sum-expence = buf_stk-line.sum-base
      609                       v-kass        = 0
      610                       v-sum-kass    = 0
      611                   .
      612               end.
      613               when 'es':U or when 'rs':U
      614               then do:
      615                   assign
      616                       v-income      = 0
      617                       v-sum-income  = 0
      618                       v-expense     = 0
      619                       v-sum-expence = 0
      620                       v-kass        = buf_stk-line.fact-qnty
      621                       v-sum-kass    = buf_stk-line.sum-base
      622                   .
      623               end.
      624               when 'vt':U or when 'ot':U or when 'vp':U
      625               then do:
      626                   if buf_stk-line.sum-base > 0
      627                   then do:
      628                       assign
      629                           v-income      = buf_stk-line.fact-qnty
      630                           v-sum-income  = buf_stk-line.sum-base
      631                           v-expense     = 0
      632                           v-sum-expence = 0
      633                       .
      634                   end.
      635                   else do:
      636                       assign
      637                           v-income      = 0
      638                           v-sum-income  = 0
      639                           v-expense     = buf_stk-line.fact-qnty
      640                           v-sum-expence = buf_stk-line.sum-base
      641                       .
      642                   end.
      643                   assign
      644                       v-kass        = 0
      645                       v-sum-kass    = 0
      646                   .
      647               end.
      648               end case.
      649               run update-temp-result in this-procedure (
      650                       input buf_stk-line.prod-type
      651                     , input buf_stk-line.prod-code
      652                     , input 0
      653                     , input 0
      654                     , input 0
      655                     , input 0
      656                     , input v-income
      657                     , input v-sum-income
      658                     , input v-expense
      659                     , input v-sum-expence
      660                     , input v-kass
      661                     , input v-sum-kass
      662               ).
      663           end.
      664       end.
      665   end.
      666   end.
      667   end.
      668   END PROCEDURE.
      669   PROCEDURE disable_UI :
      670     HIDE FRAME xl-ob.
      671   END PROCEDURE.
      672   PROCEDURE enable_UI :
      673     DISPLAY startdate enddate
      674         WITH FRAME xl-ob.
      675     ENABLE b-quit b-entry b-help startdate enddate
      676         WITH FRAME xl-ob.
      677   END PROCEDURE.
      678   PROCEDURE print-result :
      679   do
      680   on error undo, return error
      681   :
      682   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   define variable ReportFileName as character no-undo initial "report".
      684   define variable was_OK_opened  as logical   no-undo.
      685   system-dialog get-file          ReportFileName
      686                 title             "Укажите путь"
      687                 filters           "Текстовый файл (*.txt)" "*.txt"
      688                 ask-overwrite
      689                 create-test-file
      690                 save-as
      691                 use-filename
      692                 default-extension "txt"
      693                 update            was_OK_opened.
      694   if was_OK_opened <> yes then do: return "Cancel". end.
      695   assign ReportFileName = trim( string( ReportFileName ) ).
      696   output stream out-stream to value ( ReportFileName ) page-size 0  .
      697   if session :set-wait-state( "compiler" ) then.
      698       export stream out-stream
      699           p-xl-delim "" "Отчет по движению товаров"
      700       .
      701       put stream out-stream unformatted " " skip.
      702       find first ub.clients no-lock
      703               where ub.clients.obj-type  = v-cntxt-obj-type
      704               and ub.clients.obj-code  = v-cntxt-obj-code
      705       no-error.
      706       if not available ub.clients
      707       then do:
      708           message
      709               vss-workfile vss-revision vss-description
      710               skip "Ошибка поиска объекта."
      711               skip return-value
      712               skip trim(error-status :get-message(1))
      713                   trim(error-status :get-message(2))
      714                   trim(error-status :get-message(3))
      715                   trim(error-status :get-message(4))
      716                   trim(error-status :get-message(5))
      717           view-as alert-box error.
      718           undo, return error .
      719       end.
      720       export stream out-stream p-xl-delim
      721           "Магазин/Склад   "
      722           string(v-cntxt-obj-code, ">>>>>>>>9")
      723           ub.clients.obj-name
      724       .
      725       export stream out-stream p-xl-delim
      726           "Отчетный период"
      727           "С:" string(startdate, "99/99/9999")
      728           "По:" string(enddate, "99/99/9999")
      729       .
      730       put stream out-stream unformatted " " skip.
      731       export stream out-stream p-xl-delim
      732           "Фирма"
      733           "Остаток на " string(startdate - 1, "99/99/9999")
      734           "Приход"                                         " "
      735           "Расход"                                          " "
      736           "Реализация"                                   " "
      737           "Остаток на " string(enddate, "99/99/9999")
      738       .
      739       export stream out-stream p-xl-delim
      740           " "
      741           "шт"  "Сумма, руб"
      742           "шт"  "Сумма, руб"
      743           "шт"  "Сумма, руб"
      744           "шт"  "Сумма, руб"
      745           "шт"  "Сумма, руб"
      746       .
      747       assign
      748           v-counter = 0
      749       .
      750       for each temp_result
      751       use-index  name
      752       :
      753           assign
      754               v-counter = v-counter + 1
      755           .
      756           EXPORT stream out-stream p-xl-delim
      757               temp_result.cli-name
      758               temp_result.rem-beg
      759               temp_result.rem-beg-sum
      760               temp_result.inp
      761               temp_result.sum-in
      762               temp_result.outp
      763               temp_result.sum-out
      764               temp_result.rac
      765               temp_result.sum-rac
      766               temp_result.rem-end
      767               temp_result.rem-end-sum
      768           .
      769           ACCUMULATE temp_result.rem-beg     ( TOTAL ).
      770           ACCUMULATE temp_result.rem-beg-sum ( TOTAL ).
      771           ACCUMULATE temp_result.inp         ( TOTAL ).
      772           ACCUMULATE temp_result.sum-in      ( TOTAL ).
      773           ACCUMULATE temp_result.outp        ( TOTAL ).
      774           ACCUMULATE temp_result.sum-out     ( TOTAL ).
      775           ACCUMULATE temp_result.rac         ( TOTAL ).
      776           ACCUMULATE temp_result.sum-rac     ( TOTAL ).
      777           ACCUMULATE temp_result.rem-end     ( TOTAL ).
      778           ACCUMULATE temp_result.rem-end-sum ( TOTAL ).
      779       end.
      780       export stream out-stream p-xl-delim
      781           "ИТОГО  "
      782           ACCUM TOTAL temp_result.rem-beg
      783           ACCUM TOTAL temp_result.rem-beg-sum
      784           ACCUM TOTAL temp_result.inp
      785           ACCUM TOTAL temp_result.sum-in
      786           ACCUM TOTAL temp_result.outp
      787           ACCUM TOTAL temp_result.sum-out
      788           ACCUM TOTAL temp_result.rac
      789           ACCUM TOTAL temp_result.sum-rac
      790           ACCUM TOTAL temp_result.rem-end
      791           ACCUM TOTAL temp_result.rem-end-sum
      792       .
      793       put stream out-stream unformatted " " skip.
      794       export stream out-stream p-xl-delim
      795           "Директор Магазина/Склада "    " "  " "  " "  " "
      796           "Дата составления отчета "
      797               string( today , "99/99/9999")
      798       .
      799       export stream out-stream p-xl-delim
      800           "Управляющий салоном/Старший товаровед"
      801       .
      802   if session :set-wait-state( "" ) then.
      803   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   output stream out-stream CLOSE.
      805   message "Отчет выведен в файл:" SKIP
      806                   ReportFileName
      807                   view-as alert-box INFORMATION buttons OK TITLE " ".
      808   end.
      809   END PROCEDURE.
      810   PROCEDURE update-temp-result :
      811   do
      812   on error undo, return error
      813   :
      814   define input parameter p-prod-type      as character    no-undo.
      815   define input parameter p-prod-code      as integer      no-undo.
      816   define input parameter p-stk-start      as decimal      no-undo.
      817   define input parameter p-sum-start      as decimal      no-undo.
      818   define input parameter p-stk-end        as decimal      no-undo.
      819   define input parameter p-sum-end        as decimal      no-undo.
      820   define input parameter p-income         as decimal      no-undo.
      821   define input parameter p-sum-income     as decimal      no-undo.
      822   define input parameter p-expense        as decimal      no-undo.
      823   define input parameter p-sum-expence    as decimal      no-undo.
      824   define input parameter p-kass           as decimal      no-undo.
      825   define input parameter p-sum-kass       as decimal      no-undo.
      826   define variable v-cli-name as character    no-undo.
      827   define buffer buf_clients        for ub.clients.
      828       find first temp_result
      829               where temp_result.cli-type = p-prod-type
      830                 and temp_result.cli-code = p-prod-code
      831       no-error.
      832       if not available temp_result
      833       then do:
      834           create temp_result.
      835           find first buf_clients no-lock
      836                where buf_clients.obj-type = p-prod-type
      837                  and buf_clients.obj-code = p-prod-code
      838           no-error.
      839           if not available buf_clients
      840           then do:
      841                   message
      842                   vss-workfile vss-revision vss-description
      843                   skip "Не найден производитель."
      844                   skip "Тип производителя:" p-prod-type
      845                   skip "Код производителя:" p-prod-code
      846                   skip(1) "Имя производителя будет образовано"
      847                   skip "из типа и кода:" p-prod-type + string( p-prod-code )
      848                   skip(1) return-value
      849                   skip trim(error-status :get-message(1))
      850                       trim(error-status :get-message(2))
      851                       trim(error-status :get-message(3))
      852                       trim(error-status :get-message(4))
      853                       trim(error-status :get-message(5))
      854                   view-as alert-box warning.
      855                   assign
      856                       v-cli-name = p-prod-type + string( p-prod-code )
      857                   .
      858           end.
      859           else do:
      860               assign
      861                   v-cli-name = buf_clients.obj-name
      862               .
      863           end.
      864           assign
      865               temp_result.cli-type    = p-prod-type
      866               temp_result.cli-code    = p-prod-code
      867               temp_result.cli-name    = v-cli-name
      868               temp_result.rem-beg     = 0
      869               temp_result.rem-beg-sum = 0
      870               temp_result.rem-end     = 0
      871               temp_result.rem-end-sum = 0
      872               temp_result.inp         = 0
      873               temp_result.sum-in      = 0
      874               temp_result.outp        = 0
      875               temp_result.sum-out     = 0
      876               temp_result.rac         = 0
      877               temp_result.sum-rac     = 0
      878           .
      879       end.
      880       assign
      881           temp_result.rem-beg     = temp_result.rem-beg       + p-stk-start
      882           temp_result.rem-beg-sum = temp_result.rem-beg-sum   + p-sum-start
      883           temp_result.rem-end     = temp_result.rem-end       + p-stk-end
      884           temp_result.rem-end-sum = temp_result.rem-end-sum   + p-sum-end
      885           temp_result.inp         = temp_result.inp           + p-income
      886           temp_result.sum-in      = temp_result.sum-in        + p-sum-income
      887           temp_result.outp        = temp_result.outp          + p-expense
      888           temp_result.sum-out     = temp_result.sum-out       + p-sum-expence
      889           temp_result.rac         = temp_result.rac           + p-kass
      890           temp_result.sum-rac     = temp_result.sum-rac       + p-sum-kass
      891       .
      892   end.
      893   END PROCEDURE.
