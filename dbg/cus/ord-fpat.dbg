        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   define input  parameter p-doc-code as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: ord-fpat.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: cus/ord-fpat.p $":U .
        9   define variable vss-description as character no-undo init "Размазывание по объектам используя атрибуты заказа".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   def
       81    shared
       82   temp-table  obj-list no-undo
       83     field obj-type like ub.clients.obj-type
       84     field obj-code like ub.clients.obj-code
       85     field obj-name like ub.clients.obj-name
       86     field obj-id   as integer
       87     field db-num   as integer
       88     index pi is primary unique obj-id
       89     index ie1 obj-type obj-code
       90     index ie2 obj-name
       91   .
       92   procedure create_obj-list :
       93      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       94      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       95      do
       96      on error undo, return error return-value
       97      :
       98         define buffer cli-obj for ub.clients .
       99         define variable p-var as integer no-undo .
      100         define buffer buf_obj-list for obj-list .
      101         find last buf_obj-list  use-index pi no-error .
      102         if available buf_obj-list
      103         then
      104            p-var = buf_obj-list.obj-id + 1.
      105         else
      106            p-var = 1.
      107         find first cli-obj where
      108                   cli-obj.obj-type = p-obj-type
      109               and cli-obj.obj-code = p-obj-code
      110         no-lock no-error.
      111         if available cli-obj
      112         then do:
      113            create buf_obj-list.
      114            assign
      115               buf_obj-list.obj-id   = p-var
      116               buf_obj-list.obj-code = cli-obj.obj-code
      117               buf_obj-list.obj-type = cli-obj.obj-type
      118               buf_obj-list.obj-name = cli-obj.obj-name
      119               buf_obj-list.db-num   = cli-obj.db-num
      120            .
      121         end.
      122      end.
      123   end.
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   procedure proc-ord-code :
      126   define input  parameter  p-type as character no-undo .
      127   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      128   define input  parameter  v-cntxt-obj-type as character no-undo .
      129   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      130   define input  parameter  p-i-doc    as character no-undo .
      131   define output parameter  p-ord-doc  as character no-undo .
      132   define variable          v-idop     as character no-undo .
      133     do
      134     on error undo, return error return-value
      135     :
      136   case p-type :
      137       when "main-no-ver" then do:
      138         if  (v-cntxt-db-num <> 0) then
      139           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      140         else
      141           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      142       end.
      143       when "main" then do:
      144             do while true:
      145             if  (v-cntxt-db-num <> 0) then
      146               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      147             else
      148               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      149             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      150             End.
      151       end.
      152       when "chip" then do:
      153         assign
      154           v-idop = p-i-doc .
      155         do while true :
      156           if index (v-idop , ".") = 0 then
      157             v-idop  = replace (v-idop , "-", "-1.").
      158           else
      159             v-idop  =
      160             substring (v-idop , 1, index (v-idop, "-")) +
      161             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      162             substring (v-idop, index (v-idop, ".")).
      163           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      164         end.
      165         assign
      166           p-ord-doc = v-idop.
      167       end.
      168   end case.
      169     end.
      170   end procedure.
      171   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172     define variable v-cntxt-db-num        as integer   no-undo .
      173     define variable v-cntxt-userid        as character no-undo .
      174     define variable v-cntxt-level         as character no-undo .
      175     define variable v-cntxt-host-code-obj as integer   no-undo .
      176     define variable v-cntxt-obj-type      as character no-undo .
      177     define variable v-cntxt-obj-code      as integer   no-undo .
      178     define variable v-cntxt-db-num-obj    as integer   no-undo .
      179     define variable v-cntxt-is-admin      as logical   no-undo .
      180   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181     run mainmenu_getcntxt in parparentproc
      182       (output v-cntxt-db-num
      183       ,output v-cntxt-userid
      184       ,output v-cntxt-level
      185       ,output v-cntxt-host-code-obj
      186       ,output v-cntxt-obj-type
      187       ,output v-cntxt-obj-code
      188       ,output v-cntxt-db-num-obj
      189       ,output v-cntxt-is-admin
      190       ) .
      191   define variable str-pos as integer no-undo .
      192   define variable str-pos2 as integer no-undo .
      193   define variable str-1 as character no-undo .
      194   define variable i  as integer no-undo .
      195   define variable e1 as character no-undo .
      196   define variable e2 as integer no-undo .
      197   define buffer buf_ord-doc       for ub.ord-doc  .
      198   define buffer buf_ord-line      for ub.ord-line  .
      199   define buffer buf_ord-line-attr for ub.ord-line-attr  .
      200   find first buf_ord-doc no-lock where
      201              buf_ord-doc.doc-code =  p-doc-code no-error .
      202   if error-status :error then return error return-value .
      203   define variable p-e-m as character no-undo .
      204   p-e-m = buf_ord-doc.e-method.
      205   for each  obj-list : delete obj-list . end.
      206       str-pos = index (  p-e-m , "&" ) .
      207       str-pos2 = length ( p-e-m ) - str-pos .
      208       str-1 = substring (p-e-m , str-pos + 1 , str-pos2 ).
      209       do i = 1 to num-entries (str-1) :
      210           assign
      211             e1 = entry(1, (entry( i , str-1, "," )) , " ")
      212             e2 = integer(entry(2, (entry( i , str-1, "," )), " " ))
      213             no-error .
      214             if error-status :error then next.
      215   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      216   run create_obj-list in this-procedure
      217    ( input e1 ,
      218      input e2 )
      219      .
      220       end.
      221   define variable p-rcv-code as character no-undo .
      222   define variable v-empty-rcv as logical no-undo .
      223   do transaction :
      224     for each obj-list:
      225       run create-ord-doc-rcv in this-procedure
      226       (input obj-list.obj-type,
      227           input obj-list.obj-code ,
      228           output p-rcv-code ) .
      229           assign v-empty-rcv = yes.
      230           for each buf_ord-line no-lock where
      231                   buf_ord-line.doc-code = buf_ord-doc.doc-code :
      232               find first buf_ord-line-attr no-lock where
      233                         buf_ord-line-attr.doc-code = buf_ord-doc.doc-code and
      234                         buf_ord-line-attr.gds-code = buf_ord-line.gds-code and
      235                         buf_ord-line-attr.attr-code = "objqnty"  + chr(4) +
      236                                                       obj-list.obj-type + chr(4) +
      237                                                       string(obj-list.obj-code)    no-error .
      238                   if available buf_ord-line-attr and decimal (buf_ord-line-attr.attr-value) > 0 then do:
      239                     assign v-empty-rcv = no.
      240                     run create-ord-line-rcv in this-procedure
      241                         (input p-rcv-code ,
      242                          input decimal( buf_ord-line-attr.attr-value )).
      243                   end.
      244           end.
      245           if v-empty-rcv = yes then do:
      246             find first ub.ord-doc-rcv where ub.ord-doc-rcv.rcv-code = p-rcv-code no-error.
      247             if available ub.ord-doc-rcv then do:
      248                 delete ub.ord-doc-rcv.
      249             end.
      250           end.
      251     end.
      252   end.
      253   procedure create-ord-doc-rcv :
      254    do
      255    on error undo, return error return-value
      256    :
      257   define input parameter  p-obj-type like ub.clients.obj-type no-undo .
      258   define input parameter  p-obj-code like ub.clients.obj-code no-undo .
      259   define output parameter loc-ord-num as character no-undo .
      260   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   define variable to-day       as date no-undo .
      262   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      263   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      264     (input  p-obj-type
      265     ,input  p-obj-code
      266     ,output to-day
      267     )  .
      268   loc-ord-num = "" .
      269   find first  ub.ord-doc-rcv where
      270         ub.ord-doc-rcv.doc-code  = buf_ord-doc.doc-code and
      271         ub.ord-doc-rcv.obj-code  = p-obj-code and
      272         ub.ord-doc-rcv.obj-type  = p-obj-type no-lock no-error  .
      273   if available ub.ord-doc-rcv  then do:
      274     loc-ord-num = ub.ord-doc-rcv.rcv-code .
      275     return.
      276   end.
      277   define variable store-type as character no-undo .
      278   define variable store-code as integer   no-undo .
      279   define variable v-i-doc as character no-undo .
      280   store-type = p-obj-type.
      281   store-code = p-obj-code.
      282   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      283   run proc-ord-code in this-procedure
      284    (input   'main' ,
      285     input   v-cntxt-db-num ,
      286     input   p-obj-type ,
      287     input   p-obj-code ,
      288     input   v-i-doc ,
      289     output  loc-ord-num
      290    ) .
      291      create ub.ord-doc-rcv.
      292      buffer-copy buf_ord-doc to ub.ord-doc-rcv.
      293      assign
      294         ub.ord-doc-rcv.rcv-code  = loc-ord-num
      295         ub.ord-doc-rcv.doc-type  = 'out':U
      296         ub.ord-doc-rcv.doc-date  = to-day
      297         ub.ord-doc-rcv.creid     = v-cntxt-userid
      298         ub.ord-doc-rcv.status_   = 'новый':U
      299         ub.ord-doc-rcv.obj-code  = p-obj-code
      300         ub.ord-doc-rcv.obj-type  = p-obj-type
      301         ub.ord-doc-rcv.sub-par   = trim(entry(1, buf_ord-doc.cli-out-doc, chr(4))) + chr(4) + trim(buf_ord-doc.vat-type) + chr(4)
      302      .
      303     end.
      304   end procedure.
      305   procedure create-ord-line-rcv :
      306    do
      307    on error undo, return error return-value
      308    :
      309    define input parameter p-rcv-code as character no-undo .
      310    define input parameter p-qnty     as decimal   no-undo .
      311    define buffer b-ord-doc-rcv  for ub.ord-doc-rcv.
      312    create ub.ord-line-rcv .
      313    BUFFER-COPY buf_ord-line to ub.ord-line-rcv
      314    assign
      315      ub.ord-line-rcv.rcv-code  = p-rcv-code
      316      ub.ord-line-rcv.qnty      = p-qnty
      317    .
      318       find first ub.goods no-lock where
      319                  ub.goods.gds-code = buf_ord-line.gds-code .
      320       if can-find ( first ub.units where ub.units.unit-name = ub.goods.unit-base
      321           and lookup('шту':U, ub.units.type) > 0)
      322           and trunc( ub.ord-line-rcv.qnty, 0 ) <> ub.ord-line-rcv.qnty then do:
      323               ub.ord-line-rcv.qnty = trunc( ub.ord-line-rcv.qnty, 0 ) + 1 .
      324       end.
      325       ub.ord-line-rcv.cli-qnty  = ub.ord-line-rcv.qnty / ub.ord-line-rcv.cli-base-rate .
      326       if can-find(first ub.units where ub.units.unit-name = ub.goods.unit-cli
      327           and lookup('шту':U, ub.units.type) > 0)
      328           and trunc( ub.ord-line-rcv.cli-qnty, 0 ) <> ub.ord-line-rcv.cli-qnty then do:
      329               ub.ord-line-rcv.cli-qnty = trunc( ub.ord-line-rcv.cli-qnty, 0 ) + 1 .
      330               ub.ord-line-rcv.qnty  = ub.ord-line-rcv.cli-qnty * ub.ord-line-rcv.cli-base-rate .
      331       end.
      332    end.
      333   end procedure.
