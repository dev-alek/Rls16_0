     2883         bf_tt-allsum-line.excise-base-acc      =  0
     2884         bf_tt-allsum-line.excise-rubl-acc      =  0
     2885         bf_tt-allsum-line.excise-cli-acc       =  0
     2886         bf_tt-allsum-line.transport-base-acc   =  0
     2887         bf_tt-allsum-line.transport-rubl-acc   =  0
