     1120   function diff-list returns character (
     1121     input parfirst-list  as character,
     1122     input parsecond-list as character,
     1123     input pardelim       as character).
     1124     if pardelim = ""
     1125     or pardelim = ?
     1126     then do:
     1127       assign
     1128         pardelim = ","
     1129       .
     1130     end.
     1131     def var ind as integer no-undo .
     1132     def var v-elem as character no-undo .
     1133     def var v-result-list as character no-undo init "".
     1134     def var v-num-parfirst-list as integer no-undo .
     1135     assign
     1136       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1137     .
     1138     do ind = 1 to v-num-parfirst-list
     1139     :
     1140       assign
     1141         v-elem = entry(ind, parfirst-list, pardelim)
     1142       .
     1143       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1144         assign
     1145           v-result-list = v-result-list
     1146                         + (if v-result-list > "" then pardelim else "")
     1147                         + v-elem
     1148         .
     1149       end.
     1150     end.
     1151     return v-result-list .
     1152   end function.
     1153   function add-list returns character (
     1154    input parfirst-list  as character,
     1155    input parsecond-list as character,
     1156    input pardelim       as character).
     1157     if pardelim = ""
     1158     or pardelim = ?
     1159     then do:
     1160       assign
     1161         pardelim = ","
     1162       .
     1163     end.
     1164     def var ind as integer no-undo .
     1165     def var v-elem as character no-undo .
     1166     def var v-result-list as character no-undo init "".
     1167     def var v-num-parfirst-list as integer no-undo .
     1168     assign
     1169       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1170     .
     1171     do ind = 1 to v-num-parfirst-list
     1172     :
     1173       assign
     1174         v-elem = entry(ind, parfirst-list, pardelim)
     1175       .
     1176       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1177         assign
     1178           v-result-list = v-result-list
     1179                         + (if v-result-list > "" then pardelim else "")
     1180                         + v-elem
     1181         .
     1182       end.
     1183     end.
     1184     def var v-num-parsecond-list as integer no-undo .
     1185     assign
     1186       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1187     .
     1188     do ind = 1 to v-num-parsecond-list
     1189     :
     1190       assign
     1191         v-elem = entry(ind, parsecond-list, pardelim)
     1192       .
     1193       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1194         assign
     1195           v-result-list = v-result-list
     1196                         + (if v-result-list > "" then pardelim else "")
     1197                         + v-elem
     1198         .
     1199       end.
     1200     end.
     1201     return v-result-list .
     1202   end function.
     1203   function cross-list returns character (
     1204    input parfirst-list  as character,
     1205    input parsecond-list as character,
     1206    input pardelim       as character).
     1207     if pardelim = ""
     1208     or pardelim = ?
     1209     then do:
     1210       assign
     1211         pardelim = ","
     1212       .
     1213     end.
     1214     def var ind as integer no-undo .
     1215     def var v-elem as character no-undo .
     1216     def var v-result-list as character no-undo init "".
     1217     def var v-num-parfirst-list as integer no-undo .
     1218     assign
     1219       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1220     .
     1221     do ind = 1 to v-num-parfirst-list
     1222     :
     1223       assign
     1224         v-elem = entry(ind, parfirst-list, pardelim)
     1225       .
     1226       if lookup(v-elem, v-result-list, pardelim) = 0
     1227       and lookup(v-elem, parsecond-list, pardelim) > 0
     1228       then do:
     1229         assign
     1230           v-result-list = v-result-list
     1231                         + (if v-result-list > "" then pardelim else "")
     1232                         + v-elem
     1233         .
     1234       end.
     1235     end.
     1236     return v-result-list .
     1237   end function.
     1238   function radio-label returns character (
     1239    input par-rs-value  as character,
     1240    input par-rs-radio-buttons as character)
     1241    .
     1242    DEFINE variable v-result-label as character no-undo.
     1243    assign
     1244    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1245                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1246                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1247                             ), par-rs-radio-buttons
     1248                           )
     1249    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1250    .
     1251   return v-result-label.
     1252   end function.
     1253   function m-radio-label returns character (
     1254    input par-rs-value  as character,
     1255    input par-rs-radio-buttons as character,
     1256    input par-delim as character
     1257    )
     1258    .
     1259    DEFINE variable v-result-label as character no-undo.
     1260    assign
     1261    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1262                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1263                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1264                             ), par-rs-radio-buttons, par-delim
     1265                           )
     1266    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1267    .
     1268   return v-result-label.
     1269   end function.
     1270   FUNCTION mixlist returns character
     1271   (
     1272    input parfirst-list  as character
     1273    ,input parsecond-list as character
     1274    ,input pardelim       as character
     1275    ,input pardelim-result as character ) :
     1276     if pardelim = ""
     1277     or pardelim = ?
     1278     then do:
     1279       assign
     1280         pardelim = ","
     1281       .
     1282     end.
     1283     def var ind as integer no-undo .
     1284     def var v-elem1 as character no-undo .
     1285     def var v-elem2 as character no-undo .
     1286     def var v-result-list as character no-undo init "".
     1287     do ind = 1 to num-entries(parfirst-list, pardelim)
     1288     :
     1289       assign
     1290         v-elem1 = entry(ind, parfirst-list, pardelim)
     1291         v-elem2 = entry(ind, parsecond-list, pardelim)
     1292       .
     1293         assign
     1294           v-result-list = v-result-list
     1295                         + (if v-result-list > "" then pardelim-result else "")
     1296                         + v-elem1 + pardelim-result + v-elem2
     1297         .
     1298     end.
     1299     return v-result-list .
     1300   END FUNCTION.
