     2033     else do:
     2034       for each out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
     2035                                          out-vatp_gds-dtlcl.artic     = parartic     and
     2036                                          out-vatp_gds-dtlcl.prod-type = parprod-type and
     2037                                          out-vatp_gds-dtlcl.prod-code = parprod-code no-lock :
     2038         if varoutvprbcl = "base":u then do:
     2039           assign
     2040             varcurclprice-base = out-vatp_gds-dtlcl.cur-base
     2041             varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base * ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)).
     2042         end.
     2043         else do:
     2044           assign
     2045             varcurclprice-base = out-vatp_gds-dtlcl.cur-base / ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base))
     2046             varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base.
     2047         end.
     2048         assign
     2049                varsum-base-factovpcl = varsum-base-factovpcl + (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)                 * out-vatp_gds-dtlcl.fact-qnty
     2050          varslt-base-factovpcl = varslt-base-factovpcl + (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc)                   * out-vatp_gds-dtlcl.fact-qnty
     2051          varvat-base-factovpcl = varvat-base-factovpcl + (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-base-salecl) * parvat-pc / (100 + parvat-pc)                   * out-vatp_gds-dtlcl.fact-qnty
     2052          varvatcons-base-factovpcl = varvatcons-base-factovpcl + (((out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base) - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-base-salecl - varprice-base-conscl) * parcons-vat-pc / (100 + parcons-vat-pc) * out-vatp_gds-dtlcl.fact-qnty * varcons-qntycl / varfact-qntycl + ((out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base) - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-base-salecl) * parvat-pc / (100 + parvat-pc) * out-vatp_gds-dtlcl.fact-qnty * (varfact-qntycl - varcons-qntycl) / varfact-qntycl)
     2053          vardsc-base-factovpcl = vardsc-base-factovpcl + out-vatp_gds-dtlcl.discnt-base * out-vatp_gds-dtlcl.fact-qnty
     2054          varsum-base-docovpcl  = varsum-base-docovpcl  + (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)                 * out-vatp_gds-dtlcl.doc-qnty
     2055          varslt-base-docovpcl  = varslt-base-docovpcl  + (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc)                   * out-vatp_gds-dtlcl.doc-qnty
     2056          varvat-base-docovpcl  = varvat-base-docovpcl  + (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-base-salecl) * parvat-pc / (100 + parvat-pc)                   * out-vatp_gds-dtlcl.doc-qnty
     2057          varvatcons-base-docovpcl  = varvatcons-base-docovpcl  + (((out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base) - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-base-salecl - varprice-base-conscl) * parcons-vat-pc / (100 + parcons-vat-pc) * out-vatp_gds-dtlcl.doc-qnty * varcons-qntycl / varfact-qntycl + ((out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base) - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base                - road-tax-base-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-base-salecl) * parvat-pc / (100 + parvat-pc) * out-vatp_gds-dtlcl.doc-qnty * (varfact-qntycl - varcons-qntycl) / varfact-qntycl)
     2058          vardsc-base-docovpcl  = vardsc-base-docovpcl  + out-vatp_gds-dtlcl.discnt-base * out-vatp_gds-dtlcl.doc-qnty
     2059         .
     2060         assign
     2061                varsum-rubl-factovpcl = varsum-rubl-factovpcl + (out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl)                 * out-vatp_gds-dtlcl.fact-qnty
     2062          varslt-rubl-factovpcl = varslt-rubl-factovpcl + (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc)                   * out-vatp_gds-dtlcl.fact-qnty
     2063          varvat-rubl-factovpcl = varvat-rubl-factovpcl + (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-rubl-salecl) * parvat-pc / (100 + parvat-pc)                   * out-vatp_gds-dtlcl.fact-qnty
     2064          varvatcons-rubl-factovpcl = varvatcons-rubl-factovpcl + (((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-rubl-salecl - varprice-rubl-conscl) * parcons-vat-pc / (100 + parcons-vat-pc) * out-vatp_gds-dtlcl.fact-qnty * varcons-qntycl / varfact-qntycl + ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-rubl-salecl) * parvat-pc / (100 + parvat-pc) * out-vatp_gds-dtlcl.fact-qnty * (varfact-qntycl - varcons-qntycl) / varfact-qntycl)
     2065          vardsc-rubl-factovpcl = vardsc-rubl-factovpcl + out-vatp_gds-dtlcl.discnt-rubl * out-vatp_gds-dtlcl.fact-qnty
     2066          varsum-rubl-docovpcl  = varsum-rubl-docovpcl  + (out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl)                 * out-vatp_gds-dtlcl.doc-qnty
     2067          varslt-rubl-docovpcl  = varslt-rubl-docovpcl  + (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc)                   * out-vatp_gds-dtlcl.doc-qnty
     2068          varvat-rubl-docovpcl  = varvat-rubl-docovpcl  + (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-rubl-salecl) * parvat-pc / (100 + parvat-pc)                   * out-vatp_gds-dtlcl.doc-qnty
     2069          varvatcons-rubl-docovpcl  = varvatcons-rubl-docovpcl  + (((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-rubl-salecl - varprice-rubl-conscl) * parcons-vat-pc / (100 + parcons-vat-pc) * out-vatp_gds-dtlcl.doc-qnty * varcons-qntycl / varfact-qntycl + ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) - (if out-vatp-have-vat-sltcl = no then 0 else out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl                - road-tax-rubl-salecl) * parSLT-pc / (100 + parSLT-pc) - road-tax-rubl-salecl) * parvat-pc / (100 + parvat-pc) * out-vatp_gds-dtlcl.doc-qnty * (varfact-qntycl - varcons-qntycl) / varfact-qntycl)
     2070          vardsc-rubl-docovpcl  = vardsc-rubl-docovpcl  + out-vatp_gds-dtlcl.discnt-rubl * out-vatp_gds-dtlcl.doc-qnty   .
     2071       end.
     2072       if pardoc-type = 'инв':U then do:
     2073         ASSIGN
     2074                   price-base-with-tax-salecl    = varsum-base-docovpcl / varfact-qntycl
     2075           slt-base-salecl               = varslt-base-docovpcl / varfact-qntycl
     2076           vat-base-buyercl              = varvat-base-docovpcl / varfact-qntycl
     2077           discnt-base-salecl            = vardsc-base-docovpcl / varfact-qntycl
     2078           vat-base-salecl               = varvatcons-base-docovpcl / varfact-qntycl
     2079                   price-rubl-with-tax-salecl    = varsum-rubl-docovpcl / varfact-qntycl
     2080           slt-rubl-salecl               = varslt-rubl-docovpcl / varfact-qntycl
     2081           vat-rubl-buyercl              = varvat-rubl-docovpcl / varfact-qntycl
     2082           discnt-rubl-salecl            = vardsc-rubl-docovpcl / varfact-qntycl
     2083           vat-rubl-salecl               = varvatcons-rubl-docovpcl / varfact-qntycl.
     2084       end.
     2085       else do:
     2086         ASSIGN
     2087                   price-base-with-tax-salecl    = varsum-base-factovpcl / varfact-qntycl
     2088           slt-base-salecl               = varslt-base-factovpcl / varfact-qntycl
     2089           vat-base-buyercl              = varvat-base-factovpcl / varfact-qntycl
     2090           discnt-base-salecl            = vardsc-base-factovpcl / varfact-qntycl
     2091           vat-base-salecl               = varvatcons-base-factovpcl / varfact-qntycl
     2092                   price-rubl-with-tax-salecl    = varsum-rubl-factovpcl / varfact-qntycl
     2093           slt-rubl-salecl               = varslt-rubl-factovpcl / varfact-qntycl
     2094           vat-rubl-buyercl              = varvat-rubl-factovpcl / varfact-qntycl
     2095           discnt-rubl-salecl            = vardsc-rubl-factovpcl / varfact-qntycl
     2096           vat-rubl-salecl               = varvatcons-rubl-factovpcl / varfact-qntycl.
     2097       end.
     2098     end.
     2099   end.
     2100   assign
     2101     price-base-without-tax-salecl = price-base-with-tax-salecl - vat-base-salecl - slt-base-salecl - road-tax-base-salecl
     2102     price-rubl-without-tax-salecl = price-rubl-with-tax-salecl - vat-rubl-salecl - slt-rubl-salecl - road-tax-rubl-salecl.
     2103   end.
     2104   if paris-cur then do:
     2105     assign
     2106       parcurartic      = cl_tt-clcparts.artic
     2107       parcurprod-type  = cl_tt-clcparts.prod-type
     2108       parcurprod-code  = cl_tt-clcparts.prod-code
     2109       parcurdoc-type   = cl_tt-clcparts.doc-type
     2110       parcurdoc-code   = cl_tt-clcparts.out-code
     2111       parcurobj-type   = cl_tt-clcparts.obj-type
     2112       parcurobj-code   = cl_tt-clcparts.obj-code.
     2113     if parr-b = "base" then do:
     2114       assign
     2115         parcurprice-base = parcur-base
     2116         parcurprice-rubl = parcur-base * parbase-rate / parbase-scale.
     2117     end.
     2118     else do:
     2119       assign
     2120         parcurprice-base = parcur-base / parbase-rate * parbase-scale
     2121         parcurprice-rubl = parcur-base.
     2122     end.
     2123     assign
     2124       parcurbase-rate   = parbase-rate
     2125       parcurbase-scale  = parbase-scale
     2126       parcurdiscnt-base = 0
     2127       parcurdiscnt-rubl = 0
     2128       parcurfact-qnty   = cl_tt-clcparts.fact-qnty
     2129       parcurcli-qnty    = cl_tt-clcparts.cli-qnty
     2130       parcurdoc-qnty    = cl_tt-clcparts.qnty.
     2131   if parcurext-doc-type = 'ot':U or
     2132      parcurext-doc-type = ?                 then do:
     2133     assign
     2134      out-vatp-have-vat-sltcur = yes.
     2135   end.
     2136   else do:
     2137     find first out-vatp_doc-attrcur no-lock
     2138       where out-vatp_doc-attrcur.doc-code  = parcurdoc-code
     2139         and out-vatp_doc-attrcur.attr-code = 'envd':U
     2140         no-error .
     2141     if not available out-vatp_doc-attrcur then do:
     2142       assign
     2143         out-vatp-have-vat-sltcur = yes.
     2144     end.
     2145     else do:
     2146        out-vatp-have-vat-sltcur = no.
     2147     end.
