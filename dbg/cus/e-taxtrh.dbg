      343   define  stream PrnLibStream.
      344   procedure prn-lib-prn-file :
      345     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      346     define input parameter p-DIsabledoptions as integer no-undo .
      347     define variable v-report-name as character no-undo .
      348     define variable v-user-action as character no-undo .
      349     define variable v-printed     as logical   no-undo .
      350     define variable v-exist       as logical   no-undo .
      351     do
      352       on error undo, return error
      353       :
      354       run prn-lib-get-report-name  in this-procedure (
      355         input parParentProc
      356         ,output v-report-name
