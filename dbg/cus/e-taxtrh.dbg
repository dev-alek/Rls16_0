     2754   procedure clcprtsl_calc-line :
     2755   define input  parameter parrec-line as recid no-undo.
     2756   define variable v-tax-date         as   date                     no-undo.
     2757   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2758   define variable varr-b             as   character                no-undo.
     2759   define variable varr-btype         as   character                no-undo.
     2760   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2761   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2762   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2763   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2764   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2765   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2766   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2767   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2768   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2769   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2770   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2771   define variable varexcise          like ub.price-list.excise     no-undo.
     2772   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2773   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2774   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2775   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2776   define variable v-varsum           as decimal                  no-undo.
     2777   define variable varprice-salef as decimal   no-undo .
     2778   define buffer bf_trn-doc             for ub.trn-doc.
     2779   define buffer bf_doc-line            for ub.doc-line.
     2780   define buffer bf_gds-dtl             for ub.gds-dtl.
     2781   define buffer bf_goods               for ub.goods.
     2782   define buffer bf_parts               for ub.parts.
     2783   define buffer bf_sysconf             for ub.sysconf.
     2784   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2785   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2786   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2787   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2788   define buffer buf_parts        for ub.parts.
     2789   v-calcbypart = no.
     2790   do on error undo, return error return-value :
     2791   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2792   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2793     (output varr-b
     2794     )  .
     2795     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2796     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2797     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2798                               bf_goods.prod-type = bf_doc-line.prod-type and
     2799                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2800     if bf_trn-doc.fact-date <> ?        then do:
     2801       assign v-tax-date = bf_trn-doc.fact-date.
     2802     end.
     2803     else do:
     2804       assign v-tax-date = ?.
     2805     end.
     2806   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2807   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2808     (input  bf_goods.gds-code
     2809     ,input  '1':U
     2810     ,input  v-tax-date
     2811     ,input  bf_trn-doc.host-code
     2812     ,input  bf_trn-doc.obj-type
     2813     ,input  bf_trn-doc.obj-code
     2814     ,output v-vat-pc
     2815     ) no-error .
     2816     if error-status :error
     2817     or v-vat-pc = ? then do:
     2818        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2819     end.
     2820     if bf_goods.gds-type = 'у':U or
     2821        bf_trn-doc.status_ = 'запрос':U then do:
     2822       for each bf_tt-allsum-line
     2823       on error undo, return error return-value
     2824        :
     2825         delete bf_tt-allsum-line.
     2826       end.
     2827       create bf_tt-allsum-line.
     2828       assign
     2829        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2830       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2831                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2832                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2833                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2834         assign
     2835           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2836           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2837           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2838           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2839           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2840           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2841           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2842           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2843           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2844           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2845           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2846           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2847           bf_tt-allsum-line.vat-cli-acc          =  ?
     2848           .
     2849       end.
     2850       assign
     2851         bf_tt-allsum-line.cli-qnty             =  ?
     2852         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2853         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2854         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2855         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2856         bf_tt-allsum-line.road-tax-base-doc    =  0
     2857         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2858         bf_tt-allsum-line.excise-base-doc      =  0
     2859         bf_tt-allsum-line.excise-rubl-doc      =  0
     2860         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2861         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2862         bf_tt-allsum-line.dsc-base-cur         =  0
     2863         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2864         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2865         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2866         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2867         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2868         bf_tt-allsum-line.road-tax-base-cur    =  0
     2869         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2870         bf_tt-allsum-line.excise-base-cur      =  0
     2871         bf_tt-allsum-line.excise-rubl-cur      =  0
     2872         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2873         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2874         bf_tt-allsum-line.dsc-base-acc         =  0
     2875         bf_tt-allsum-line.dsc-rubl-acc         =  0
