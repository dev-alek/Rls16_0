     3624   define variable     choice               as      logical     no-undo.
     3625   define variable     DatePrinted      as      logical     no-undo.
     3626   define variable     FrameType      as      char        no-undo.
     3627   define variable     method            as    char no-undo.
     3628   define variable     good-choice as logical init no.
     3629   define variable negparts as logical NO-UNDO.
     3630   define buffer buf-bar for ub.bar-code.
     3631   define buffer t-doc for ub.trn-doc.
     3632   define variable jj as integer no-undo.
     3633   define variable jj-tot as integer no-undo init 0.
     3634   DEFINE VARIABLE RS-By AS INTEGER
     3635        VIEW-AS RADIO-SET VERTICAL
     3636        RADIO-BUTTONS
     3637             "Отчеты о продаже (касса)", 1,
     3638   "Расх. и возвр. накладные по реализации", 2,
     3639   "Отчеты о продаже и накладные", 3
     3640        SIZE 42.25 BY 2.67 NO-UNDO.
     3641   DEFINE RECTANGLE RECT-6
     3642        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3643        SIZE 45 BY 4.83.
     3644   DEFINE RECTANGLE RECT-7
     3645        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3646        SIZE 45 BY 3.92.
     3647   DEFINE RECTANGLE RECT-8
     3648        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3649        SIZE 45 BY 4.5.
     3650   DEFINE FRAME F-Main
     3651        RS-By AT ROW 7.75 COL 3.5 NO-LABEL
     3652        "Источник формирования" VIEW-AS TEXT
     3653             SIZE 34.63 BY .83 AT ROW 6.71 COL 3.5
     3654             FGCOLOR 4
     3655        RECT-6 AT ROW 1.25 COL 2.25
     3656        RECT-8 AT ROW 6.46 COL 2.25
     3657        RECT-7 AT ROW 11.33 COL 2.25
     3658       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     3659            SIDE-LABELS NO-UNDERLINE THREE-D
     3660            AT COL 1 ROW 1
     3661            SIZE 47.63 BY 15.
     3662   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     3663   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     3664   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     3665   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     3666   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     3667   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     3668   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     3669   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     3670       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     3671   RUN ensure-broker.
     3672   THIS-PROCEDURE:ADM-DATA =
     3673        'ADM1.1~`':U +
     3674        'SmartObject~`':U +
     3675        'FRAME~`':U +
     3676        'NO ~`':U +
     3677        '~`':U +
     3678        '~`':U +
     3679        '~`':U +
     3680        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     3681           + "~`":U +
     3682        'Layout,Hide-on-Init~`':U +
     3683        '~`':U +
     3684        '~`':U +
     3685        '~`~`~`~`~`~`~`~`~`~`~`':U +
     3686        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     3687            THEN "^^":U
     3688        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     3689             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     3690   PROCEDURE adm-apply-entry :
     3691     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3692   END PROCEDURE.
     3693   PROCEDURE adm-destroy :
     3694    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3695   END PROCEDURE.
     3696   PROCEDURE adm-disable :
     3697       DISABLE RECT-6 RECT-8 RECT-7 RS-By WITH FRAME F-Main.
     3698       RUN dispatch ('disable-fields':U).
     3699       RUN set-attribute-list ('ENABLED=no':U).
     3700       RETURN.
     3701   END PROCEDURE.
     3702   PROCEDURE adm-edit-attribute-list :
     3703         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     3704         RETURN.
     3705   END PROCEDURE.
     3706   PROCEDURE adm-enable :
     3707       ENABLE UNLESS-HIDDEN RECT-6 RECT-8 RECT-7 RS-By WITH FRAME F-Main.
     3708       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     3709       RUN set-attribute-list ('ENABLED=yes':U).
     3710       RETURN.
     3711   END PROCEDURE.
     3712   PROCEDURE adm-exit :
     3713        RUN notify ('exit':U).
     3714     RETURN.
     3715   END PROCEDURE.
     3716   PROCEDURE adm-hide :
     3717     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3718   END PROCEDURE.
     3719   PROCEDURE adm-initialize :
     3720     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3721   END PROCEDURE.
     3722   PROCEDURE adm-show-errors :
     3723       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     3724       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3725           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     3726       END.
     3727       RETURN.
     3728   END PROCEDURE.
     3729   PROCEDURE adm-UIB-mode :
     3730     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3731   END PROCEDURE.
     3732   PROCEDURE adm-view :
     3733     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3734   END PROCEDURE.
     3735   PROCEDURE dispatch :
     3736       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     3737       RUN broker-dispatch IN adm-broker-hdl
     3738           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     3739       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     3740   END PROCEDURE.
     3741   PROCEDURE ensure-broker :
     3742   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     3743   IF RETURN-VALUE NE "ADM-Broker":U THEN
     3744   DO:
     3745       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     3746       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     3747   END.
     3748   END PROCEDURE.
     3749   PROCEDURE get-attribute :
     3750     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     3751     RUN broker-get-attribute IN adm-broker-hdl
     3752         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     3753     RETURN RETURN-VALUE.
     3754   END PROCEDURE.
     3755   PROCEDURE get-attribute-list :
     3756     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     3757     RUN broker-get-attribute-list IN adm-broker-hdl
     3758         (INPUT THIS-PROCEDURE,
     3759          INPUT ?,
     3760          OUTPUT p-attr-list) NO-ERROR.
     3761     RETURN.
     3762   END PROCEDURE.
     3763   PROCEDURE new-state :
     3764     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3765     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     3766     RETURN.
     3767   END PROCEDURE.
     3768   PROCEDURE notify :
     3769     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     3770     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     3771     IF RETURN-VALUE = "ADM-ERROR":U THEN
     3772         RETURN "ADM-ERROR":U.
     3773     RETURN.
     3774   END PROCEDURE.
     3775   PROCEDURE set-attribute-list :
     3776     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     3777     RUN ensure-broker.
     3778     RUN broker-set-attribute-list IN adm-broker-hdl
     3779         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     3780     RETURN.
     3781   END PROCEDURE.
     3782   PROCEDURE set-position :
     3783       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     3784       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     3785       IF VALID-HANDLE(adm-object-hdl) THEN
     3786       DO:
     3787           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     3788           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     3789           DO:
     3790             IF p-row = 0 THEN p-row =
     3791               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     3792             IF p-col = 0 THEN p-col =
     3793               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     3794           END.
     3795           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     3796           DO:
     3797             parent-hdl = adm-object-hdl:PARENT.
     3798             IF p-row = 0 THEN p-row =
     3799               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     3800                 parent-hdl:ROW.
     3801             IF p-col = 0 THEN p-col =
     3802               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     3803                 parent-hdl:COL.
     3804           END.
     3805           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     3806           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     3807         ASSIGN adm-object-hdl:ROW    =   p-row
     3808                adm-object-hdl:COLUMN =   p-col.
     3809       END.
     3810       RETURN.
     3811   END PROCEDURE.
     3812   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     3813       STRING(adm-object-hdl)).
     3814   PAUSE 0 BEFORE-HIDE.
     3815   PROCEDURE adm-change-page :
     3816     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     3817     END PROCEDURE.
     3818   PROCEDURE delete-page :
     3819     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     3820     RUN broker-delete-page IN adm-broker-hdl
     3821         (INPUT THIS-PROCEDURE, INPUT p-page#).
     3822     END PROCEDURE.
     3823   PROCEDURE init-object :
     3824     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     3825     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     3826     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     3827     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     3828     RUN broker-init-object IN adm-broker-hdl
     3829         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     3830          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     3831     RETURN.
     3832   END PROCEDURE.
     3833   PROCEDURE init-pages :
     3834     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     3835     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3836         INPUT p-page-list) NO-ERROR.
     3837     END PROCEDURE.
     3838   PROCEDURE select-page :
     3839     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     3840     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3841         INPUT p-page#) NO-ERROR.
     3842     END PROCEDURE.
     3843   PROCEDURE view-page :
     3844     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     3845     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     3846         INPUT p-page#).
     3847     END PROCEDURE.
     3848   if not this-procedure :persistent
     3849   then do:
     3850     message
     3851       vss-workfile vss-revision vss-description skip
     3852       "Ошибка при запуске процедуры" skip
     3853       "Данную процедуру следует запускать только с параметром persistent" skip
     3854       view-as alert-box error .
     3855     undo, return error .
     3856   end.
     3857   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3858   PROCEDURE no-benq.
     3859   DEFINE OUTPUT PARAMETER found as logical init no.
     3860   define buffer buf_chk-doc for ub.chk-doc.
     3861   FOR EACH obj-list WHERE
     3862           obj-list.obj-type = 'маг':U NO-LOCK :
     3863     CASE X-Radio-Task > 1 :
     3864       WHEN YES THEN DO:
     3865         FOR EACH buf_chk-doc NO-LOCK WHERE
     3866                 buf_chk-doc.obj-type = obj-list.obj-type AND
     3867                 buf_chk-doc.obj-code = obj-list.obj-code AND
     3868                 (
     3869                   buf_chk-doc.shift-date >= X-date-start AND
     3870                   buf_chk-doc.shift-date <= X-date-end)
     3871                   AND
     3872                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     3873           IF X-Radio-Task = 3 AND
     3874           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     3875             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     3876           IF X-Radio-Task = 4 AND
     3877           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     3878           found = yes.
     3879           return.
     3880         END.
     3881       END.
     3882       WHEN NO THEN DO:
     3883         FOR EACH buf_chk-doc NO-LOCK WHERE
     3884               buf_chk-doc.obj-type = obj-list.obj-type AND
     3885               buf_chk-doc.obj-code = obj-list.obj-code AND
     3886               buf_chk-doc.chk-date >= X-date-start AND
     3887               buf_chk-doc.chk-date <= X-date-end   AND
     3888               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     3889           found = yes.
     3890           return.
     3891         END.
     3892        END.
     3893      END CASE.
     3894    END.
     3895   END PROCEDURE.
     3896   PROCEDURE no-benqi.
     3897   DEFINE OUTPUT PARAMETER found as logical init no.
     3898   define buffer buf_chk-doc for ub.chk-doc.
     3899   define buffer buf_inkas for ub.inkas.
     3900   FOR EACH obj-list WHERE
     3901         obj-list.obj-type = 'маг':U NO-LOCK :
     3902     CASE X-Radio-Task > 1 :
     3903       WHEN YES THEN DO:
     3904         FOR EACH buf_chk-doc No-LOCK WHERE
     3905                 buf_chk-doc.obj-type = obj-list.obj-type AND
     3906                 buf_chk-doc.obj-code = obj-list.obj-code AND
     3907                 (
     3908                   buf_chk-doc.shift-date >= X-date-start AND
     3909                   buf_chk-doc.shift-date <= X-date-end)
     3910                   AND
     3911                   buf_Chk-doc.out-code = ? AND
     3912                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     3913           IF X-Radio-Task = 3 AND
     3914           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     3915             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     3916           IF X-Radio-Task = 4 AND
     3917           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     3918           found = yes.
     3919           return.
     3920         END.
     3921         FOR EACH buf_inkas No-LOCK WHERE
     3922                   buf_inkas.obj-type = obj-list.obj-type AND
     3923                   buf_inkas.obj-code = obj-list.obj-code AND
     3924                   (
     3925                   buf_inkas.shift-date >= X-date-start AND
     3926                   buf_inkas.shift-date <= X-date-end):
     3927           if buf_inkas.status_ = 'факт':U
     3928           or buf_inkas.status_ = 'запрос':U then next.
     3929           IF X-Radio-Task = 3 AND
     3930           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     3931             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     3932           IF X-Radio-Task = 4 AND
     3933           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     3934           found = yes.
     3935           return.
     3936         END.
     3937       END.
     3938       WHEN NO THEN DO:
     3939         FOR EACH buf_chk-doc NO-LOCK WHERE
     3940                 buf_chk-doc.obj-type = obj-list.obj-type AND
     3941                 buf_chk-doc.obj-code = obj-list.obj-code AND
     3942                 buf_chk-doc.chk-date >= X-date-start AND
     3943                 buf_chk-doc.chk-date <= X-date-end   AND
     3944                 buf_Chk-doc.out-code = ? AND
     3945                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     3946           found = yes.
     3947           return.
     3948         END.
     3949         FOR EACH buf_inkas NO-LOCK WHERE
     3950                 buf_inkas.obj-type = obj-list.obj-type AND
     3951                 buf_inkas.obj-code = obj-list.obj-code AND
     3952                 buf_inkas.doc-date >= X-date-start AND
     3953                 buf_inkas.doc-date <= X-date-end :
     3954           if buf_inkas.status_ = 'факт':U
     3955           or buf_inkas.status_ = 'запрос':U then next.
     3956           found = yes.
     3957           return.
     3958         END.
     3959       END.
     3960     END CASE.
     3961   END.
     3962   END PROCEDURE.
     3963   PROCEDURE no-benq-i.
     3964   DEFINE OUTPUT PARAMETER found as logical init no.
     3965   define buffer buf_inkas for ub.inkas.
     3966   CASE X-Radio-Task > 1:
     3967     WHEN YES then do:
     3968       FOR EACH obj-list WHERE
     3969               obj-list.obj-type = 'маг':U NO-LOCK :
     3970         FOR EACH buf_inkas NO-LOCK WHERE
     3971                 buf_inkas.obj-type = obj-list.obj-type AND
     3972                 buf_inkas.obj-code = obj-list.obj-code AND
     3973                 buf_inkas.status_ = 'факт':U AND
     3974                 (
     3975                 buf_inkas.shift-date >= X-date-start AND
     3976                 buf_inkas.shift-date <= X-date-end):
     3977           IF X-Radio-Task = 3 AND
     3978           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     3979             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     3980           IF X-Radio-Task = 4 AND
     3981           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     3982           found = yes.
     3983           return.
     3984         END.
     3985     END.
     3986     END.
     3987     WHEN NO THEN DO:
     3988       FOR EACH obj-list WHERE
     3989               obj-list.obj-type = 'маг':U NO-LOCK :
     3990         FOR EACH buf_inkas NO-LOCK WHERE
     3991                 buf_inkas.obj-type = obj-list.obj-type AND
     3992                 buf_inkas.obj-code = obj-list.obj-code AND
     3993                 buf_inkas.status_ = 'факт':U AND
     3994                 buf_inkas.doc-date >= X-date-start AND
     3995                 buf_inkas.doc-date <= X-date-end :
     3996            found = yes.
     3997            return.
     3998         END.
     3999       END.
     4000     END.
     4001   END CASE.
     4002   END PROCEDURE.
     4003   PROCEDURE no-benq-i-office.
     4004   DEFINE OUTPUT PARAMETER found as logical init no.
     4005   define buffer buf_sale-doc for ub.sale-doc.
     4006   CASE X-Radio-Task > 1:
     4007     WHEN YES then do:
     4008       FOR EACH obj-list WHERE
     4009               obj-list.obj-type = 'маг':U NO-LOCK :
     4010         FOR EACH buf_sale-doc NO-LOCK WHERE
     4011                  buf_Sale-doc.obj-type = obj-list.obj-type
     4012              AND buf_sale-doc.obj-code = obj-list.obj-code
     4013              AND buf_sale-doc.status_ = 'факт':U
     4014              AND buf_sale-doc.chr-office = 'у':U
     4015              AND (
     4016                 buf_sale-doc.shift-date >= X-date-start
     4017                 AND
     4018                 buf_sale-doc.shift-date <= X-date-end):
     4019           IF X-Radio-Task = 3 AND
     4020           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     4021             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     4022           IF X-Radio-Task = 4 AND
     4023           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     4024           found = yes.
     4025           return.
     4026         END.
     4027       END.
     4028     END.
     4029     WHEN NO THEN DO:
     4030       FOR EACH obj-list WHERE
     4031               obj-list.obj-type = 'маг':U NO-LOCK :
     4032         FOR EACH buf_sale-doc NO-LOCK WHERE
     4033                 buf_sale-doc.obj-type = obj-list.obj-type
     4034            AND  buf_sale-doc.obj-code = obj-list.obj-code
     4035            AND  buf_sale-doc.status_ = 'факт':U
     4036            AND  buf_sale-doc.chr-office = 'у':U
     4037            AND  buf_sale-doc.doc-date >= X-date-start
     4038            AND  buf_sale-doc.doc-date <= X-date-end :
     4039           found = yes.
     4040           return.
     4041         END.
     4042       END.
     4043     END.
     4044   END CASE.
     4045   END PROCEDURE.
     4046   PROCEDURE adm-create-objects :
     4047   END PROCEDURE.
     4048   PROCEDURE adm-row-available :
     4049     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     4050     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     4051     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     4052     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     4053     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     4054     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     4055     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     4056     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     4057     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     4058     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     4059     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     4060     IF adm-updating-record THEN RETURN.
     4061     RUN get-attribute ('FIELDS-ENABLED':U).
     4062     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     4063     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     4064         OUTPUT link-handle) NO-ERROR.
     4065     IF link-handle = "":U THEN
     4066         RETURN.
     4067     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     4068     IF NUM-ENTRIES(link-handle) > 1 THEN
     4069         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     4070             "encountered more than one RECORD-SOURCE.":U SKIP
     4071             "The first - ":U record-source-hdl:file-name " - will be used.":U
     4072                VIEW-AS ALERT-BOX ERROR.
     4073     RUN get-attribute ('Key-Name':U).
     4074     key-name = RETURN-VALUE.
     4075     IF key-name = "":U THEN key-name = ?.
     4076     IF key-name NE ? THEN DO:
     4077       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     4078         NO-ERROR.
     4079       IF key-value NE ? THEN
     4080         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     4081     END.
     4082   IF VALID-HANDLE (adm-object-hdl) THEN
     4083       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     4084   RUN notify IN THIS-PROCEDURE ('row-available':U).
     4085   END PROCEDURE.
     4086   PROCEDURE cre-sj :
     4087   define input parameter v-curr-r-b as character no-undo .
     4088   define input parameter  doc-num like ub.trn-doc.doc-code no-undo.
     4089   define input parameter is-out as integer init 1.
     4090   define input parameter offc as logical no-undo.
     4091   define variable s-price as decimal no-undo .
     4092   define variable cur-discnt as decimal no-undo .
     4093   DEFINE VARIABLE varsum-dsc-r-b-acc as decimal no-undo .
     4094   DEFINE VARIABLE varvat-r-b-acc     as decimal no-undo .
     4095   DEFINE VARIABLE var-qnty              as decimal no-undo .
     4096   DEFINE VARIABLE varvat-r-b-doc     as decimal no-undo .
     4097   DEFINE VARIABLE varslt-r-b-doc     as decimal no-undo .
     4098   define variable slt-calc as decimal no-undo .
     4099   define variable vat-cost as decimal no-undo .
     4100   define variable cur-quant like ub.gds-dtl.doc-qnty no-undo.
     4101   define variable r-bar-code like ub.bar-code.b-code no-undo.
     4102   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4103   define variable p-grp-code as integer.
     4104   define variable p-grp-name as char.
     4105   define variable v-curr-grp-name as character.
     4106   _docline:
     4107   FOR EACH doc-line WHERE doc-line.doc-code = doc-num NO-LOCK:
     4108     PROCESS EVENTS.
     4109     jj = jj + 1 .
     4110     if ( jj  modulo 10 ) = 0  then
     4111     run waitfram-show in this-procedure (input ("Обработано строк накладных : " +   string(  jj ) ) ).
     4112   find first goods where goods.prod-type = doc-line.prod-type and
     4113              goods.prod-code = doc-line.prod-code and
     4114               goods.artic = doc-line.artic .
     4115               p-grp-code = goods.grp-code.
     4116               p-grp-name = goods.grp-name.
     4117       case x-SelectGood:
     4118           when 5
     4119           then
     4120               do:
     4121                   find  first gds-list no-lock
     4122                       where gds-list.artic     = goods.artic
     4123                       and gds-list.prod-type = goods.prod-type
     4124                       and gds-list.prod-code = goods.prod-code
     4125                       no-error .
     4126                   if not available gds-list then next.
     4127               end.
     4128           when 1  then
     4129               do:
     4130               end.
     4131           when 2 then
     4132               do:
     4133              find first tmp#grp where
     4134                            ub.goods.grp-name begins tmp#grp.grp-name no-error.
     4135                   if not avail tmp#grp then NEXT.
     4136               end.
     4137           otherwise
     4138           do:
     4139               find  first gds-list no-lock
     4140                   where goods.artic     = gds-list.artic
     4141                   and goods.prod-type = gds-list.prod-type
     4142                   and goods.prod-code = gds-list.prod-code no-error .
     4143               if not available  gds-list then next.
     4144           end.
     4145       end case.
     4146     run clcprtsl_calc-line in this-procedure (input recid (doc-line)).
     4147     assign
     4148     s-price = 0
     4149     cur-quant = 0
     4150     varsum-dsc-r-b-acc   = 0
     4151     varvat-r-b-acc       = 0
     4152     var-qnty                = 0
     4153     varvat-r-b-doc       = 0
     4154     varslt-r-b-doc       = 0
     4155     .
     4156     find first tt-allsum-line where
     4157                tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     4158     if not available tt-allsum-line then do:
     4159     end.
     4160     else do:
     4161      assign
     4162      varsum-dsc-r-b-acc   = (if v-curr-r-b = 'rubl':U then tt-allsum-line.sum-dsc-rubl-acc else tt-allsum-line.sum-dsc-base-acc)
     4163      varvat-r-b-acc       = (if v-curr-r-b = 'rubl':U then tt-allsum-line.vat-rubl-acc else tt-allsum-line.vat-base-acc)
     4164      var-qnty                = doc-line.fact-qnty
     4165      varvat-r-b-doc       = (if v-curr-r-b = 'rubl':U then tt-allsum-line.vat-rubl-doc else tt-allsum-line.vat-base-doc)
     4166      varslt-r-b-doc       = (if v-curr-r-b = 'rubl':U then tt-allsum-line.slt-rubl-doc else tt-allsum-line.slt-rubl-doc)
     4167      cur-quant = is-out * doc-line.fact-qnty
     4168      s-price = ( varsum-dsc-r-b-acc - varvat-r-b-acc ) / var-qnty
     4169      .
     4170     end.
     4171     if NOT offc AND cur-quant = 0 and negparts then next _docline.
     4172     FOR EACH gds-dtl WHERE
     4173             gds-dtl.doc-code = doc-num AND
     4174             gds-dtl.artic = doc-line.artic AND
     4175             gds-dtl.prod-type = doc-line.prod-type AND
     4176             gds-dtl.prod-code = doc-line.prod-code
     4177             NO-LOCK:
     4178       if method = "b-code":U then do:
     4179         FIND FIRST goods No-LOCK WHERE
     4180                   goods.artic = gds-dtl.artic AND
     4181                   goods.prod-type = gds-dtl.prod-type AND
     4182                   goods.prod-code = gds-dtl.prod-code No-ERROR.
     4183         FIND FIRST bar-code WHERE
     4184                   bar-code.gds-code = goods.gds-code AND
     4185                   bar-code.in-code = "" AND
     4186                   bar-code.unit-cli = goods.unit-base AND
     4187                   bar-code.part-code = "" AND
     4188                   bar-code.node-code = gds-dtl.prt-code
     4189                   NO-LOCK   NO-ERROR.
     4190       end.
     4191       assign
     4192       cur-discnt = (if v-curr-r-b = 'rubl':U then gds-dtl.discnt-rubl else gds-dtl.discnt-base)
     4193       .
     4194       CASE method :
     4195         when "b-code":U THEN dO:
     4196           FIND FIRST sj-goods WHERE
     4197                     sj-goods.b-code = bar-code.b-code AND
     4198                     sj-goods.VAT-pc = doc-line.VAT-pc AND
     4199                     sj-goods.SLT-pc = doc-line.SLT-pc AND
     4200                     sj-goods.is-out = (is-out > 0) NO-ERROR .
     4201         END.
     4202         when "artic":U THEN DO:
     4203           FIND FIRST sj-goods WHERE
     4204                     sj-goods.artic = doc-line.artic AND
     4205                     sj-goods.prod-type = doc-line.prod-type AND
     4206                     sj-goods.prod-code = doc-line.prod-code AND
     4207                     sj-goods.VAT-pc = doc-line.VAT-pc AND
     4208                     sj-goods.SLT-pc = doc-line.SLT-pc AND
     4209                     sj-goods.is-out = (is-out > 0) USE-INDEX p3 NO-ERROR .
     4210         END.
     4211         otherwise do:
     4212           FIND FIRST sj-goods WHERE
     4213                     sj-goods.VAT-pc = doc-line.VAT-pc AND
     4214                     sj-goods.SLT-pc = doc-line.SLT-pc AND
     4215                     sj-goods.is-out = (is-out > 0) NO-ERROR .
     4216         end.
     4217       END CASE.
     4218       if NOT available sj-goods then do:
     4219         FIND goods WHERE
     4220             goods.prod-type = doc-line.prod-type AND
     4221             goods.prod-code = doc-line.prod-code AND
     4222             goods.artic = doc-line.artic NO-LOCK .
     4223         if method = "artic":U then do:
     4224   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4225     (input  goods.gds-code
     4226     ,input  ?
     4227     ,output r-bar-code
     4228     ) no-error .
     4229           if error-status:error then NEXT _docline.
     4230         end.
     4231         CREATE sj-goods.
     4232         CASE method:
     4233           WHEN  "b-code":U then DO:
     4234             assign
     4235             sj-goods.b-code = bar-code.b-code
     4236             sj-goods.name = goods.gds-name
     4237             sj-goods.artic = goods.artic
     4238             sj-goods.VAT-pc = doc-line.VAT-pc
     4239             sj-goods.SLT-pc = doc-line.SLT-pc
     4240             sj-goods.unit  = goods.unit-base
     4241             sj-goods.is-out = (is-out > 0)
     4242               .
     4243           END.
     4244           WHEN "artic":U then do:
     4245             assign
     4246             sj-goods.b-code = r-bar-code
     4247             sj-goods.name = goods.gds-name
     4248             sj-goods.artic = goods.artic
     4249             sj-goods.prod-type = goods.prod-type
     4250             sj-goods.prod-code = goods.prod-code
     4251             sj-goods.VAT-pc = doc-line.VAT-pc
     4252             sj-goods.SLT-pc = doc-line.SLT-pc
     4253             sj-goods.unit  = goods.unit-base
     4254             sj-goods.is-out = (is-out > 0)
     4255               .
     4256           END.
     4257           WHEN "TOTALS":U then do:
     4258             assign
     4259             sj-goods.VAT-pc = doc-line.VAT-pc
     4260             sj-goods.SLT-pc = doc-line.SLT-pc
     4261             sj-goods.is-out = (is-out > 0)
     4262             .
     4263           END.
     4264         END CASE.
     4265       end.
     4266   if t-doc.ext-doc-type = 'ot':U or
     4267      t-doc.ext-doc-type = ?                 then do:
     4268     assign
     4269      out-vatp-have-vat-slt = yes.
     4270   end.
     4271   else do:
     4272     find first out-vatp_doc-attr no-lock
     4273       where out-vatp_doc-attr.doc-code  = t-doc.doc-code
     4274         and out-vatp_doc-attr.attr-code = 'envd':U
     4275         no-error .
     4276     if not available out-vatp_doc-attr then do:
     4277       assign
     4278         out-vatp-have-vat-slt = yes.
     4279     end.
     4280     else do:
     4281        out-vatp-have-vat-slt = no.
     4282     end.
     4283   end.
     4284   find first out-vatp_goods where out-vatp_goods.artic     = doc-line.artic     and
     4285                                      out-vatp_goods.prod-type = doc-line.prod-type and
     4286                                      out-vatp_goods.prod-code = doc-line.prod-code no-lock.
     4287   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4288   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     4289     (input  doc-line.artic
     4290     ,input  doc-line.prod-type
     4291     ,input  doc-line.prod-code
     4292     ,output varroot-node
     4293     ) no-error .
     4294   if error-status :error then do:
     4295     message
     4296       vss-workfile vss-revision vss-description skip
     4297       "Ошибка при определении корневого признака товара" skip
     4298       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     4299       error-status :get-message(1) skip
     4300       return-value skip
     4301       view-as alert-box error .
     4302     undo, return error .
     4303   end.
     4304   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     4305     (input  varroot-node
     4306     ,input  'empty-scale=request'
     4307     ,output varempty-scale
     4308     ) no-error .
     4309   if error-status :error then do:
     4310     message
     4311       vss-workfile vss-revision vss-description skip
     4312       "Ошибка при определении атрибута признака" skip
     4313       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     4314       "Признак" varroot-node skip
     4315       "Запрашивался атрибут" "empty-scale=request" skip
     4316       error-status :get-message(1) skip
     4317       return-value skip
     4318       view-as alert-box error .
     4319     undo, return error .
     4320   end.
     4321   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4322   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4323     (output varoutvprb
