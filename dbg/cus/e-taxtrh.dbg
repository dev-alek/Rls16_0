     2957           .
     2958       end.
     2959       create bfo_tt-allsum-line.
     2960       assign
     2961         bfo_tt-allsum-line.sum-type = 'сумма_по_услуге':U.
     2962       buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfo_tt-allsum-line.
     2963       create bfos_tt-allsum-line.
