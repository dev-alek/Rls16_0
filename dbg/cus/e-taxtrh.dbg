     4350     varfact-qnty       = 0
     4351     varcons-qnty       = 0
     4352     varprice-base-cons = 0
     4353     varprice-rubl-cons = 0.
     4354   find first out-vatp_doc-line where
     4355              out-vatp_doc-line.doc-code   = t-doc.doc-code
     4356          and out-vatp_doc-line.artic      = doc-line.artic
     4357          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     4358          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     4359   if available out-vatp_doc-line           and
     4360     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     4361     assign
     4362       varfact-qnty = out-vatp_doc-line.fact-qnty.
     4363   end.
     4364   else do:
     4365     for each out-vatp_parts where out-vatp_parts.out-code   = t-doc.doc-code
     4366                                  and out-vatp_parts.obj-type   = t-doc.obj-type
     4367                                  and out-vatp_parts.obj-code   = t-doc.obj-code
     4368                                  and out-vatp_parts.artic      = doc-line.artic
     4369                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     4370                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
     4371       if out-vatp_parts.purch-code = 2 then do:
     4372   assign
     4373     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     4374     price-base-with-tax-loco = out-vatp_parts.price-base
     4375   .
     4376   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4378     (output varinvprbo
     4379     )  .
     4380     if out-vatp_parts.out-code = 'free-zone':U     or
     4381        out-vatp_parts.out-code = 'out-zone':U   or
     4382        out-vatp_parts.doc-type = 'акт':U then do:
     4383       assign
     4384         in-vatp-have-vat-slto = yes.
