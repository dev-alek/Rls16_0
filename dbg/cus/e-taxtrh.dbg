     2889         bf_tt-allsum-line.other-base-acc       =  0
     2890         bf_tt-allsum-line.other-rubl-acc       =  0
     2891         bf_tt-allsum-line.other-cli-acc        =  0
     2892         .
     2893       create bfs_tt-allsum-line.
     2894       assign
     2895       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2896       if bf_trn-doc.doc-type = 'инв':U or
