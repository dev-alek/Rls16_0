     2966       buffer-copy bfs_tt-allsum-line except bfs_tt-allsum-line.sum-type to bfos_tt-allsum-line.
     2967     end.
     2968     else do:
     2969       assign
     2970         varlastcur-base      = 0
     2971         varlastcur-road-tax  = 0
     2972         varlastcur-excise    = 0
     2973         varcur-base          = 0
     2974         varcur-road-tax      = 0
     2975         varcur-excise        = 0
     2976         varcur-vat-pc        = 0
     2977         varcur-slt-pc        = 0
     2978         varcur-fact-qnty     = 0
     2979       .
     2980   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2981     (input  bf_goods.gds-code
     2982     ,input  ?
     2983     ,output varb-code
     2984     )  .
     2985   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2986   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     2987     (input  bf_trn-doc.obj-type
     2988     ,input  bf_trn-doc.obj-code
     2989     ,input  varb-code
     2990     ,input  0
     2991     ,input  bf_trn-doc.fact-order
     2992     ,output vardoc-num
     2993     ,output varprice-sale
     2994     ,output varroad-tax
     2995     ,output varexcise
     2996     ,output varcur-vat-pc
     2997     ,output varcur-slt-pc
     2998     )  .
     2999       if varprice-sale = ?
     3000       then do:
     3001         assign
     3002           varcur-vat-pc = 0
     3003           varcur-slt-pc = 0
     3004         .
     3005       end.
     3006   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3007   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3008     (input  bf_goods.gds-code
     3009     ,input  '1':U
     3010     ,input  bf_trn-doc.fact-date
     3011     ,input  bf_trn-doc.host-code
     3012     ,input  bf_trn-doc.obj-type
     3013     ,input  bf_trn-doc.obj-code
     3014     ,output varcur-vat-pc
     3015     ) no-error .
     3016       if varcur-vat-pc = ?
     3017       then do:
     3018         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3019       end.
     3020       if varcur-slt-pc = ?
     3021       then do:
     3022         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3023       end.
     3024       v-calcbypart = no.
     3025       if bf_doc-line.whole-send-news = integer('1':U)   then
     3026       v-calcbypart = yes.
     3027       else do:
     3028       for each bf_gds-dtl no-lock
     3029         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     3030           and bf_gds-dtl.artic     = bf_doc-line.artic
     3031           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     3032           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
