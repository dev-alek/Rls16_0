     3036     (input  bf_goods.gds-code
     3037     ,input  bf_gds-dtl.prt-code
     3038     ,output varb-code
     3039     ) no-error .
     3040   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3041   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3042     (input  bf_trn-doc.obj-type
     3043     ,input  bf_trn-doc.obj-code
     3044     ,input  varb-code
     3045     ,input  0
     3046     ,input  bf_trn-doc.fact-order
     3047     ,output vardoc-num
     3048     ,output varprice-sale
     3049     ,output varroad-tax
     3050     ,output varexcise
     3051     )  .
     3052             if varprice-sale = ?
     3053             then do:
     3054               assign
     3055                 varprice-sale = 0
     3056                 varroad-tax   = 0
     3057                 varexcise     = 0
     3058               .
     3059             end.
     3060             assign
     3061               varlastcur-base     = varprice-sale
     3062               varlastcur-road-tax = varroad-tax
     3063               varlastcur-excise   = varexcise
     3064               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3065               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3066               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3067               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3068             .
     3069         end.
     3070       end.
     3071       if varcur-fact-qnty = 0 then do:
     3072         assign
     3073           varcur-base      = varlastcur-base
     3074           varcur-road-tax  = varlastcur-road-tax
     3075           varcur-excise    = varlastcur-excise
     3076         .
     3077       end.
     3078       else do:
     3079         assign
     3080           varcur-base      = varcur-base      / varcur-fact-qnty
     3081           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3082           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3083         .
     3084       end.
     3085       if varcur-vat-pc = ?
     3086       then do:
     3087         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3088       end.
     3089       if varcur-slt-pc = ?
     3090       then do:
     3091         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3092       end.
     3093       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3094       assign
     3095         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3096       if varcur-cons-vat-pc = ? then do:
     3097         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3098       end.
     3099       define buffer buf_tt-clcparts for tt-clcparts .
     3100       for each buf_tt-clcparts
     3101       on error undo, return error return-value
     3102       :
     3103         delete buf_tt-clcparts.
     3104       end.
     3105       for each bf_parts no-lock
     3106         where bf_parts.out-code  = bf_doc-line.doc-code
     3107           and bf_parts.obj-type  = bf_doc-line.obj-type
     3108           and bf_parts.obj-code  = bf_doc-line.obj-code
     3109           and bf_parts.artic     = bf_doc-line.artic
     3110           and bf_parts.prod-type = bf_doc-line.prod-type
     3111           and bf_parts.prod-code = bf_doc-line.prod-code
     3112       on error undo, return error return-value
     3113       :
     3114         create buf_tt-clcparts .
     3115         buffer-copy bf_parts to buf_tt-clcparts .
     3116         if v-calcbypart = yes   then do:
     3117   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3118     (buffer bf_parts
     3119     ,output v-b-pcode
     3120     ) no-error .
     3121   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3122   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3123     (input  bf_parts.obj-type
     3124     ,input  bf_parts.obj-code
     3125     ,input  v-b-pcode
     3126     ,input  0
     3127     ,input  bf_trn-doc.fact-order
     3128     ,output vardoc-num
     3129     ,output varprice-salef
     3130     ,output varroad-tax
     3131     ,output varexcise
     3132     ) no-error .
     3133             if varprice-sale = ?
     3134             then do:
     3135               assign
     3136                 varprice-salef = 0
     3137                 varroad-tax   = 0
     3138                 varexcise     = 0
     3139               .
     3140             end.
     3141             assign
     3142             part-cur-base  = varprice-salef
     3143             part-cur-road-tax  = varroad-tax
     3144             part-cur-excise = varexcise.
     3145         end.
     3146       end.
     3147       run clcprtsl_calc-ttable in this-procedure
     3148         (input yes,
     3149          input yes,
     3150          input bf_doc-line.road-tax,
     3151          input bf_doc-line.excise,
     3152          input bf_doc-line.vat-pc,
     3153          input bf_doc-line.cons-vat-pc,
     3154          input bf_doc-line.slt-pc,
     3155          input bf_trn-doc.base-rate,
     3156          input bf_trn-doc.base-scale,
     3157          input varr-b,
     3158          input varcur-base,
     3159          input varcur-road-tax,
     3160          input varcur-excise,
     3161          input varcur-vat-pc,
     3162          input varcur-cons-vat-pc,
     3163          input varcur-slt-pc
     3164          ) no-error.
     3165       if error-status:error then do:
     3166         message
     3167           vss-workfile vss-revision vss-description skip
     3168           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3169           return-value skip
     3170           trim(error-status :get-message(1))
     3171           trim(error-status :get-message(2))
     3172           trim(error-status :get-message(3))
     3173           trim(error-status :get-message(4))
     3174           trim(error-status :get-message(5)) skip
     3175           view-as alert-box error.
     3176         undo, return error .
     3177       end.
     3178     end.
     3179   end.
     3180   end.
     3181   procedure clcprtsl_calc-ttable :
     3182   define input parameter paris-doc           as   logical                 no-undo.
     3183   define input parameter paris-cur           as   logical                 no-undo.
     3184   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3185   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3186   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3187   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3188   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3189   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3190   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3191   define input parameter parr-b              as   character               no-undo.
     3192   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3193   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3194   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3195   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3196   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3197   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3198   define buffer bf_tt-allsum      for tt-allsum.
     3199   define buffer bf_tt-clcparts    for tt-clcparts.
     3200   define buffer bf_tt-allsum-line for tt-allsum-line.
     3201   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3202   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3203   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3204   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3205   define variable varexcise          like ub.price-list.excise     no-undo.
     3206   do on error undo, return error return-value :
     3207   for each bf_tt-allsum-line
     3208   on error undo, return error return-value
     3209    :
     3210     delete bf_tt-allsum-line.
     3211   end.
     3212   for each bf_tt-allsum
     3213   on error undo, return error return-value
     3214   :
     3215     delete bf_tt-allsum.
     3216   end.
     3217   for each bf_tt-clcparts
     3218   on error undo, return error return-value
     3219   :
     3220   if v-calcbypart then do:
     3221             assign
     3222             parcur-base =   bf_tt-clcparts.part-cur-base
     3223             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3224             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3225             .
     3226   end.
     3227      run clcprtsl_calc-parts in this-procedure (
     3228        input recid(bf_tt-clcparts),
     3229        input paris-doc,
     3230        input paris-cur,
     3231        input parroad-tax,
     3232        input parexcise,
     3233        input parvat-pc,
     3234        input parcons-vat-pc,
     3235        input parslt-pc,
     3236        input parbase-rate,
     3237        input parbase-scale,
     3238        input parr-b,
     3239        input parcur-base,
     3240        input parcur-road-tax,
     3241        input parcur-excise,
     3242        input parcur-vat-pc,
     3243        input parcurcons-vat-pc,
     3244        input parcurslt-pc
     3245        ) no-error.
     3246     if error-status:error then do:
     3247       message
     3248         vss-workfile vss-revision vss-description skip
     3249         vss-include-info12 skip
     3250         "Ошибка при обсчете партии" skip
     3251         "Документ партии " bf_tt-clcparts.out-code skip
     3252         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3253         return-value skip
     3254         error-status:get-message(1) skip
     3255         error-status:get-message(2) skip
     3256         error-status:get-message(3) skip
     3257         view-as alert-box error .
     3258       undo, return error .
     3259     end.
     3260     for each bf_tt-allsum on error undo, return error return-value :
     3261       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3262       if not available bf_tt-allsum-line then do:
     3263         create bf_tt-allsum-line.
     3264         assign
     3265           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3266       end.
     3267       assign
     3268         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3269         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3270         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3271         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3272         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3273         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3274         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3275         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3276         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3277         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3278         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3279         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3280         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3281         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3282         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3283         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3284         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3285         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3286         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3287         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3288         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3289         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3290         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3291         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3292         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3293         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3294         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3295         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3296         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3297         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3298         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3299         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3300         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3301         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3302         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3303         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3304         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3305         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3306         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3307         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3308         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3309         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3310         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3311         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3312         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3313         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3314         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3315         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3316         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3317         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3318         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3319         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3320         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3321         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3322         .
     3323     end.
     3324   end.
     3325   end.
     3326   end procedure.
     3327   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3328   define variable v-waitfram-action01         as character   no-undo .
     3329   define variable v-waitfram-action02         as character   no-undo .
     3330   define variable v-waitfram-action03         as character   no-undo .
     3331   define variable mWaitFramTextBeg            as character   no-undo.
     3332   define variable mWaitFramTextEnd            as character   no-undo.
     3333   define variable mWaitFramView               as logical     no-undo.
     3334   define variable mWaitProcEvent              as logical     no-undo init yes.
     3335   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3336   define variable mWaitFramStop               as logical     no-undo.
     3337   define variable mWaitFramStopUser           as logical     no-undo.
     3338   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3339   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3340   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3341   define button B-WaitFramStop auto-end-key
     3342        label "Стоп"
     3343        size 10 by 1 tooltip "Остоновить процесс".
     3344   define button B-viewProcInfo
     3345        label "Информация"
     3346        size 15 by 1 tooltip "Информация о процесс".
     3347   define frame waitfram
     3348     v-waitfram-action01 format "x(72)" no-label skip
     3349     v-waitfram-action02 format "x(72)" no-label skip
     3350     v-waitfram-action03 format "x(72)" no-label skip
     3351     B-viewProcInfo
     3352     B-WaitFramStop at row 4 col 30
     3353     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3354     .
     3355   define new global shared variable mBatchMode as logical no-undo init ?.
     3356   define variable mFramBachModHandle as handle no-undo.
     3357   mFramBachModHandle = frame waitfram:handle.
     3358   define variable mFameOldVis as logical no-undo.
     3359   define variable mVisCUrentVin as logical no-undo.
     3360   if session:batch-mode
     3361   then
     3362      mBatchMode = yes.
     3363   if mBatchMode = ? then do:
     3364     mVisCUrentVin = current-window:visible.
     3365     mFameOldVis = mFramBachModHandle:visible.
     3366     mFramBachModHandle:visible  = yes.
     3367     mBatchMode = mFramBachModHandle:visible ne yes.
     3368     mFramBachModHandle:visible = mFameOldVis.
     3369     current-window:visible = mVisCUrentVin.
     3370   end.
     3371    if  log-manager:logfile-name ne ?
     3372     then DO:
     3373         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3374         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3375         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3376     end.
     3377   on choose of B-WaitFramStop in frame waitfram
     3378   do:
     3379     mWaitFramStop = yes.
     3380     mWaitFramStopUser = yes.
     3381   end.
     3382   function waitfram-check-timeout returns logical():
     3383      define variable vtime as int64 no-undo.
     3384      if mWaitFramStopTimeOut
     3385      then
     3386         return yes.
     3387      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3388      if     mWaitFramTimeOut ne ?
     3389         and mWaitFramTimeOut ne 0
     3390         and mWaitFramTimeOut lt vtime
     3391      then do:
     3392         mWaitFramStopTimeOut = yes.
     3393      end.
     3394      return mWaitFramStopTimeOut.
     3395   end.
     3396   procedure waitfram-hide :
     3397     if not session:batch-mode
     3398     then do
     3399     on error undo, return error return-value
     3400     :
     3401       pause 0 before-hide .
     3402       if not mBatchMode then
     3403         hide frame waitfram .
     3404     if     not mWaitFramView
     3405        and mWaitProcEvent
     3406     then
     3407       process events .
     3408     end.
     3409   end procedure.
     3410   procedure waitfram-show :
     3411     define input  parameter p-message as character no-undo .
     3412     define variable v-left-margin as integer   no-undo .
     3413     if not session:batch-mode
     3414     then do
     3415     on error undo, return error return-value
     3416     :
     3417       if length(p-message) <= 70 then do:
     3418         assign
     3419           v-left-margin = integer((70 - length(p-message)) / 2)
     3420         .
     3421         assign
     3422           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3423         .
     3424         assign
     3425           v-waitfram-action01 = " "
     3426           v-waitfram-action02 = " "
     3427                                    + fill(" ", v-left-margin)
     3428                                    + p-message
     3429           v-waitfram-action03 = " "
     3430         .
     3431       end.
     3432       else do:
     3433         define variable vRindex1 as integer no-undo.
     3434         define variable vRindex2 as integer no-undo.
     3435         vRindex1 = r-index(p-message," ",70).
     3436         if vRindex1 = 0
     3437         then
     3438            vRindex1 = 70.
     3439         if length(p-message)  <= vRindex1 + 70 then do:
     3440           assign
     3441             v-waitfram-action01 = " "
     3442             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3443             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3444           .
     3445         end.
     3446         else do:
     3447           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3448           if vRindex2 <= vRindex1
     3449           then
     3450              vRindex2 = vRindex1 + 70.
     3451           assign
     3452             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3453             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3454             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3455           .
     3456         end.
     3457       end.
     3458       B-viewProcInfo:visible   in frame waitfram = no.
     3459       B-viewProcInfo:sensitive in frame waitfram = no.
     3460       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3461       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3462       if  (   mWaitFramView
     3463          or  mWaitProcEvent)
     3464          and not mBatchMode
     3465       then
     3466          display
     3467             v-waitfram-action01 skip
     3468             v-waitfram-action02 skip
     3469             v-waitfram-action03 skip
     3470          with frame waitfram .
     3471       if     mWaitFramView
     3472          then do:
     3473             if     mWaitFramInterval ne ?
     3474                and not mBatchMode
     3475             then
     3476                wait-for go of frame waitfram pause mWaitFramInterval.
     3477          end.
     3478          else
     3479             if     mWaitProcEvent
     3480                and not mBatchMode
     3481             then
     3482                process events .
     3483     end.
     3484   end procedure.
     3485      procedure waitfram-show-this:
     3486         define input  parameter iInterval as int64 no-undo.
     3487         define variable vtime as int64 no-undo.
     3488         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3489         mWaitFramInterval = iInterval.
     3490         run waitfram-show (substitute("&1&2 &3&4" ,
     3491                                       mWaitFramTextBeg ,
     3492                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3493                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3494                                       mWaitFramTextEnd
     3495                                      )
     3496                           ).
     3497      end.
     3498      procedure WaitFramRunPause:
     3499         define input  parameter iInterval as dec no-undo.
     3500         define variable vStart  as datetime-tz no-undo.
     3501         define variable vend    as datetime-tz no-undo.
     3502         define variable vint as int64 no-undo.
     3503         define variable vOk as logical no-undo.
     3504         vStart = now.
     3505         vend   = vStart.
     3506         publish "WaitFramPause" (iInterval,output vOk).
     3507         vend   =  now.
     3508         vint = vend - vStart.
     3509         vint = iInterval - vint / 1000.
     3510         if     not mWaitFramStop
     3511            and (   vint > 0
     3512                 or (    not vOk
     3513                     and iInterval eq ?
     3514                     )
     3515                 )
     3516         then
     3517            run waitfram-show-this (iInterval).
     3518         vend   =  now.
     3519         vint = vend - vStart.
     3520         vint = iInterval - vint / 1000.
     3521         if     not mWaitFramStop
     3522            and vint > 0
     3523         then do:
     3524            run gbl/pause.p (vint * 1000).
     3525         end.
     3526         if iInterval ne ?
     3527         then
     3528            publish "WaitFramStop".
     3529         waitfram-check-timeout().
     3530      end.
     3531      procedure WaitFramWaitFor:
     3532         define input  parameter iInterval as dec no-undo.
     3533         assign
     3534            mWaitFramStartProc   = now
     3535            mWaitFramStopUser    = no
     3536            mWaitFramStopTimeOut = no
     3537         .
     3538         block-wait:
     3539         do while not mWaitFramStop:
     3540            run WaitFramRunPause (iInterval).
     3541            if  waitfram-check-timeout()
     3542            then do:
     3543               leave block-wait.
     3544            end.
     3545         end.
     3546         run waitfram-hide.
     3547      end.
     3548   procedure waitfram-join :
     3549     define input  parameter p-line-1  as character no-undo .
     3550     define input  parameter p-line-2  as character no-undo .
     3551     define input  parameter p-line-3  as character no-undo .
     3552     define output parameter p-message as character no-undo .
     3553     do
     3554     on error undo, return error return-value
     3555     :
     3556       assign
     3557         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3558                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3559                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3560       .
     3561     end.
     3562   end procedure.
     3563   function waitfram-join-function returns character
     3564     (input p-line-1 as character
     3565     ,input p-line-2 as character
     3566     ,input p-line-3 as character
     3567     ).
     3568     define variable v-message as character no-undo .
     3569     run waitfram-join in this-procedure
     3570       (input  p-line-1
     3571       ,input  p-line-2
     3572       ,input  p-line-3
     3573       ,output v-message
     3574       ) .
     3575     return v-message .
     3576   end function .
     3577   define temp-table sj-goods no-undo
     3578   field b-code like ub.bar-code.b-code format "9999999999999"
     3579   field artic     like ub.goods.artic
     3580   field prod-type like ub.goods.prod-type
     3581   field prod-code like ub.goods.prod-code
     3582   field name   like ub.goods.gds-name format "x(30)"
     3583   field grp-code like ub.goods.grp-code
     3584   field unit like ub.goods.unit-base
     3585   field qnty              as   decimal
     3586   field obj-price    like ub.price-list.price-sale
     3587   field discnt          as   decimal
     3588   field brutto-sum   as   decimal
     3589   field discnt-sum  as   decimal
     3590   field netto-sum    as   decimal
     3591   field uchet-sum   as decimal
     3592   field uchet-with-vat-sum   as decimal
     3593   field n-u-sum             as   decimal
     3594   field u-pcnt          as decimal
     3595   field is-out        as  logical
     3596   field VAT-pc       like ub.doc-line.VAT-pc
     3597   field SLT-pc       like ub.doc-line.SLT-pc
     3598   field VAT-r-b    as decimal
     3599   field SLT-r-b   as decimal
     3600   INDEX p1 IS PRIMARY   b-code SLT-pc VAT-pc
     3601   INDEX p2                        is-out DESCENDING
     3602                                           b-code ASCENDING
     3603   INDEX p3 artic prod-type prod-code SLT-pc VAT-pc
     3604   INDEX p4 grp-code
     3605   .
     3606   DEFINE TEMP-TABLE d-slt-vat no-undo
     3607   FIELD SLT-pc like ub.doc-line.SLT-pc
     3608   FIELD SLT-r-b like ub.inkas.netto
     3609   FIELD SLT-r-b-brutto like ub.inkas.netto
     3610   FIELD VAT-pc like ub.doc-line.VAT-pc
     3611   FIELD VAT-r-b like ub.inkas.netto
     3612   FIELD uchet-sum as decimal
     3613   FIELD uchet-with-vat-sum as decimal
     3614   FIELD n-u-sum             as   decimal
     3615   INDEX p1 IS PRIMARY SLT-pc VAT-pc ASCENDING .
     3616   define temp-table t-grp no-undo
     3617   FIELD grp-code like ub.goods.grp-code
     3618   FIELD grp-name as character
     3619   index p1 IS UNIQUE PRIMARY grp-name ASCENDING.
