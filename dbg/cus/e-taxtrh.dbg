      583   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      584   def
      585    shared
      586   temp-table  obj-list no-undo
      587     field obj-type like ub.clients.obj-type
      588     field obj-code like ub.clients.obj-code
      589     field obj-name like ub.clients.obj-name
      590     field obj-id   as integer
      591     field db-num   as integer
      592     index pi is primary unique obj-id
      593     index ie1 obj-type obj-code
      594     index ie2 obj-name
      595   .
      596   procedure create_obj-list :
      597      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      598      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      599      do
      600      on error undo, return error return-value
      601      :
      602         define buffer cli-obj for ub.clients .
      603         define variable p-var as integer no-undo .
      604         define buffer buf_obj-list for obj-list .
      605         find last buf_obj-list  use-index pi no-error .
      606         if available buf_obj-list
      607         then
      608            p-var = buf_obj-list.obj-id + 1.
      609         else
      610            p-var = 1.
      611         find first cli-obj where
      612                   cli-obj.obj-type = p-obj-type
      613               and cli-obj.obj-code = p-obj-code
      614         no-lock no-error.
      615         if available cli-obj
      616         then do:
      617            create buf_obj-list.
      618            assign
      619               buf_obj-list.obj-id   = p-var
      620               buf_obj-list.obj-code = cli-obj.obj-code
      621               buf_obj-list.obj-type = cli-obj.obj-type
      622               buf_obj-list.obj-name = cli-obj.obj-name
      623               buf_obj-list.db-num   = cli-obj.db-num
      624            .
      625         end.
      626      end.
      627   end.
      628   define  shared temp-table X-init_obj-list no-undo
      629   field obj-type like ub.clients.obj-type
      630   field obj-code like ub.clients.obj-code
      631   index pi is unique primary obj-type obj-code.
