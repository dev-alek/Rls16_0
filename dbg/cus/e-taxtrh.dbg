     4464   end.
     4465   if varis-cons-parts-have = no then do:
     4466     assign
     4467           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     4468           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     4469   end.
     4470   else do:
     4471     if t-doc.doc-type = 'инв':U then do:
     4472       assign
     4473               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4474               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4475        .
     4476     end.
     4477     else do:
     4478       assign
     4479               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4480               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4481        .
     4482     end.
     4483   end.
     4484   assign
     4485   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     4486   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     4487       assign
     4488       cur-quant = is-out * gds-dtl.fact-qnty
     4489       slt-calc = (if v-curr-r-b = 'rubl':U then slt-rubl-sale else slt-base-sale) * cur-quant
     4490       vat-cost = (if v-curr-r-b = 'rubl':U then vat-rubl-sale else vat-base-sale) * cur-quant
     4491       slt-calc = if gds-dtl.fact-qnty = 0 then 0 else slt-calc
     4492       vat-cost = if gds-dtl.fact-qnty = 0 then 0 else vat-cost
     4493       sj-goods.qnty = sj-goods.qnty + cur-quant
     4494       sj-goods.brutto-sum = sj-goods.brutto-sum + ( cur-quant * (if v-curr-r-b = 'rubl':U then gds-dtl.price-rubl else gds-dtl.price-base))
     4495       sj-goods.discnt-sum = sj-goods.discnt-sum + ( cur-discnt * cur-quant )
     4496       sj-goods.uchet-with-vat-sum = sj-goods.uchet-with-vat-sum + (if var-qnty = 0
     4497                                                                    then 0
     4498                                                                    else (varsum-dsc-r-b-acc / var-qnty) * cur-quant)
     4499       sj-goods.uchet-sum = sj-goods.uchet-sum + s-price * cur-quant
     4500       sj-goods.SLT-r-b = sj-goods.SLT-r-b + slt-calc
     4501       sj-goods.VAT-r-b = sj-goods.VAT-r-b + vat-cost
     4502       .
     4503     END.
     4504   END.
     4505   END PROCEDURE.
     4506   PROCEDURE disable_UI :
     4507     HIDE FRAME F-Main.
     4508     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     4509   END PROCEDURE.
     4510   PROCEDURE enable_UI :
     4511     DISPLAY RS-By
     4512         WITH FRAME F-Main.
     4513     ENABLE RECT-6 RECT-8 RECT-7 RS-By
     4514         WITH FRAME F-Main.
     4515   END PROCEDURE.
     4516   PROCEDURE Main_cycle :
     4517   define variable i as integer no-undo .
     4518   define variable tdoc-code     as      char    no-undo.
     4519   define variable real-code like ub.clients.obj-code no-undo.
     4520   define variable real-type like ub.clients.obj-type no-undo.
     4521   define variable doc-num like ub.trn-doc.doc-code no-undo.
     4522   define variable is-out as integer init 1.
     4523   define variable offc as logical no-undo.
     4524   define variable v-host-code like ub.sysconf.host-code no-undo.
     4525   def buffer b-tr-doc  for ub.trn-doc .
     4526   define buffer buf_SYSCONF for UB.SYSCONF.
     4527   define variable v-curr-r-b as character no-undo .
     4528   define buffer buf_inkas for ub.inkas.
     4529   define buffer buf_sale-doc for ub.sale-doc.
     4530   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4531   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4532     (output v-curr-r-b
     4533     )  .
     4534   FOR EACH sj-goods :
     4535       delete sj-goods .
     4536   END .
     4537   FOR EACH d-slt-vat :
     4538       delete d-slt-vat .
     4539   END .
     4540   FOR EACH t-grp:
     4541     delete t-grp.
     4542   end.
     4543   _obj-list:
     4544   FOR EACH obj-list NO-LOCK:
     4545   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4546   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4547     (input  obj-list.obj-type
     4548     ,input  obj-list.obj-code
     4549     ,output v-host-code
     4550     )  .
     4551       FIND FIRST buf_sysconf NO-LOCK WHERE buf_sysconf.host-code = v-host-code.
     4552       IF AVAIL buf_sysconf
     4553       then
     4554       assign
     4555       real-code = buf_sysconf.sale-code
     4556       real-type = buf_sysconf.sale-type
     4557       .
     4558       else NEXT _obj-list.
     4559       IF RS-by = 1 then do:
     4560       _inkas:
     4561         FOR EACH buf_inkas WHERE
     4562                  buf_inkas.doc-date >= X-date-start and
     4563                  buf_inkas.doc-date <= X-date-end AND
     4564                  buf_inkas.obj-code = obj-list.obj-code and
     4565                  buf_inkas.obj-type = obj-list.obj-type AND
     4566                  buf_inkas.status_ = 'факт':U NO-LOCK,
     4567            each buf_sale-doc no-lock where
     4568                 buf_sale-doc.inkas-code = buf_inkas.inkas-code
     4569             and buf_sale-doc.order > 0:
     4570         if buf_sale-doc.in-inkas then do:
     4571           FIND FIRST t-doc No-LOCK WHERE
     4572                   t-doc.doc-code = buf_sale-doc.doc-code no-error.
     4573           if not available t-doc then do:
     4574             next _inkas.
     4575           end.
     4576           assign
     4577           doc-num = t-doc.doc-code
     4578           is-out = buf_sale-doc.dir
     4579           offc = t-doc.office
     4580           .
     4581           if offc and negparts then NEXT _inkas.
     4582           run cre-sj in this-procedure (
     4583                                           input v-curr-r-b
     4584                                         ,input doc-num
     4585                                         ,input is-out
     4586                                         ,input offc
     4587                                         ).
     4588           end.
     4589         END.
     4590       END.
     4591       IF RS-BY = 3 then do:
     4592       _trn-doc:
     4593         FOR EACH t-doc NO-LOCK WHERE
     4594                  t-doc.obj-type = obj-list.obj-type AND
     4595                  t-doc.obj-code = obj-list.obj-code AND
     4596                  t-doc.ext-doc-type = 'es':U AND
     4597                  t-doc.status_ = 'факт':U AND
     4598                  t-doc.doc-date >= X-date-start AND
     4599                  t-doc.doc-date <= X-date-end:
     4600           assign
     4601           doc-num = t-doc.doc-code
     4602           offc = t-doc.office
     4603           is-out = 1.
     4604           if offc and negparts then NEXT _trn-doc.
     4605           run cre-sj in this-procedure (
     4606                                          input v-curr-r-b
     4607                                         ,input doc-num
     4608                                         ,input is-out
     4609                                         ,input offc
     4610                                         ).
     4611         END.
     4612         _ret-doc:
     4613         FOR EACH t-doc NO-LOCK WHERE
     4614                  t-doc.obj-type = obj-list.obj-type AND
     4615                  t-doc.obj-code = obj-list.obj-code AND
     4616                  t-doc.ext-doc-type = 'rs':U AND
     4617                  t-doc.status_ = 'факт':U AND
     4618                  t-doc.doc-date >= X-date-start AND
     4619                  t-doc.doc-date <= X-date-end:
     4620           assign
     4621           doc-num = t-doc.doc-code
     4622           offc = t-doc.office
     4623           is-out = -1.
     4624           if offc and negparts then NEXT _ret-doc.
     4625           run cre-sj in this-procedure (
     4626                                          input v-curr-r-b
     4627                                         ,input doc-num
     4628                                         ,input is-out
     4629                                         ,input offc
     4630                                         ).
     4631       END.
     4632     END.
     4633     IF RS-by = 2 OR RS-BY = 3 then do:
     4634     _trn-doc2:
     4635       FOR EACH t-doc NO-LOCK WHERE
     4636                 t-doc.obj-type = obj-list.obj-type AND
     4637                 t-doc.obj-code = obj-list.obj-code AND
     4638                 t-doc.ext-doc-type = 'ee':U AND
     4639                 t-doc.status_ = 'факт':U AND
     4640                 t-doc.doc-date >= X-date-start AND
     4641                 t-doc.doc-date <= X-date-end AND
     4642                 t-doc.cli-type = real-type AND
     4643                 t-doc.cli-code = real-code
     4644                 :
     4645         assign
     4646         doc-num = t-doc.doc-code
     4647         offc = t-doc.office
     4648         is-out = 1.
     4649         if offc and negparts then NEXT _trn-doc2.
     4650         run cre-sj in this-procedure (
     4651                                        input v-curr-r-b
     4652                                       ,input doc-num
     4653                                       ,input is-out
     4654                                       ,input offc
     4655                                       ).
     4656       END.
     4657       _ret-doc2:
     4658       FOR EACH t-doc NO-LOCK WHERE
     4659                 t-doc.obj-type = obj-list.obj-type AND
     4660                 t-doc.obj-code = obj-list.obj-code AND
     4661                 t-doc.ext-doc-type = 're':U AND
     4662                 t-doc.status_ = 'факт':U AND
     4663                 t-doc.doc-date >= X-date-start AND
     4664                 t-doc.doc-date <= X-date-end AND
     4665                 t-doc.cli-type = real-type AND
     4666                 t-doc.cli-code = real-code:
     4667         assign
     4668         doc-num = t-doc.doc-code
     4669         offc = t-doc.office
     4670         is-out = -1.
     4671         if offc and negparts then NEXT _ret-doc2.
     4672         run cre-sj in this-procedure (
     4673                                        input v-curr-r-b
     4674                                       ,input doc-num
     4675                                       ,input is-out
     4676                                       ,input offc
     4677                                       ).
     4678       END.
     4679     end.
     4680   END.
     4681   END PROCEDURE.
     4682   PROCEDURE My-report :
     4683   DEFINE VARIABLE v-append as logical no-undo .
     4684   define variable glog as logical no-undo .
     4685   run My-var.
     4686   run no-benq-i(output glog).
     4687   if NOT glog then do:
     4688       message "Не было никаких закрытых продаж на выбранных объектах в течение заданного Вами периода времени." view-as alert-box.
     4689       return.
     4690   end.
     4691   assign
     4692   date_string = cur-time-print()
     4693   Line = fill( "-", 180 )
     4694   jj = 0
     4695   jj-tot = 0
     4696   .
     4697   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     4698   run Main_Cycle.
     4699   run waitfram-hide in this-procedure .
     4700   assign
     4701   v-append = can-find(first sj-goods no-lock where
     4702                             sj-goods.is-out = yes )
     4703   .
     4704   if v-append then
     4705   RUN PrintProc( input yes, input no  ).
     4706   if can-find(first sj-goods No-lock where
     4707                     sj-goods.is-out = no ) then
     4708   RUN PrintProc( input no, input v-append).
     4709   run prn-lib-prn-file in this-procedure (
     4710                                             input my-handle
     4711                                             ,input 8
     4712                                             ).
     4713   END PROCEDURE.
     4714   PROCEDURE My-var :
     4715   Assign
     4716   frame F-Main RS-by
     4717   good-choice = (IF X-selectGood = 1 then no else yes)
     4718   method = "artic"
     4719   negparts = no
     4720   .
     4721   Assign
     4722    STR-obj-type = ''
     4723    STR-obj-code = ''
     4724    STR-obj-name = ''
     4725    STR-obj      = ''.
     4726   For each obj-list no-lock:
     4727    Assign
     4728    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     4729    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     4730    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     4731    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     4732   End.
     4733   Reportname = "РЕАЛИЗАЦИЯ В МАГАЗИНЕ".
     4734   ReportHeader =  "Источник формирования: " +
     4735                   radio-label(string(RS-BY), RS-BY:radio-buttons) + chr(10).
     4736   END PROCEDURE.
     4737   PROCEDURE PrintProc :
     4738   define input parameter p-is-out as logical no-undo .
     4739   define input parameter p-append as logical no-undo .
     4740   define variable i as integer no-undo .
     4741   define variable Line                as      char    no-undo.
     4742   define variable cash_string     as      char    no-undo.
     4743   define variable sale_string     as      char    no-undo.
     4744   define variable date_string     as      char    no-undo.
     4745   DEFINE VARIABLE v-opt-price as decimal no-undo .
     4746   DEFINE VARIABLE v-sale-without-tax-price as decimal no-undo .
     4747   DEFINE VARIABLE v-sale-without-tax-sum as decimal no-undo .
     4748   DEFINE VARIABLE v-direction as character no-undo .
     4749   define variable for-netto-without-slt as decimal no-undo.
     4750   define buffer buf_shop for ub.shop .
     4751   define buffer buf_sysconf for ub.sysconf .
     4752   define buffer host-cli for ub.clients.
     4753   define buffer buf_firm for ub.firm .
     4754   define buffer real-firm for ub.firm .
     4755   define buffer real-cli for ub.clients .
     4756   DEFINE FRAME SJ-Base
     4757   jj-tot column-label "  N  " format ">>>>>9"
     4758   sj-goods.artic column-label "    Артикул" format "x(16)"
     4759   sj-goods.name column-label "Наименование!Товара" format "x(25)"
     4760   sj-goods.unit column-label "Наим!ед изм" format "X(3)"
     4761   sj-goods.qnty column-label "Количество ! " format "->>>>>9.<<<"
     4762   v-opt-price column-label "Цена!оптовая" format ">>>>9.99"
     4763   sj-goods.uchet-sum COLUMN-LABEL "Сумма!оптовая" format "->>>>>>>>9.99"
     4764   v-sale-without-tax-price COLUMn-LABEL "Цена без!НДС и НП" format ">>>>9.99"
     4765   v-sale-without-tax-sum COLUMn-LABEL "Сумма без!НДС и НП" format "->>>>>>>>9.99"
     4766   sj-goods.VAT-pc column-label "Ставка!НДС, %"  format ">9"
     4767   sj-goods.VAT-r-b column-label "Сумма!НДС" format "->>>>>>>>9.99"
     4768   for-netto-without-slt column-label "Сумма с!учетом!НДС (без НП)"  format "->>>>>>>>9.99"
     4769   sj-goods.SLT-r-b column-label "Сумма НП"  format "->>>>>>>>9.99"
     4770   sj-goods.netto-sum column-label "Сумма c!учетом!НДС и НП" format "->>>>>>>>9.99"
     4771   HEADER  date_string AT 5 format "X(35)"
     4772               string( "Страница " ) format "X(9)" AT 115 page-number(PrnLibStream)
     4773                AT 125 FORMAT ">>9" SKIP
     4774               Line format "X(180)" AT 1
     4775   with width 232  down stream-io use-text.
     4776       Line = fill("-", 250).
     4777   run waitfram-show in this-procedure ( "Подождите ..." ).
     4778   if p-append then do:
     4779     run prn-lib-open-stream  in this-procedure (
     4780                                                 input my-handle
     4781                                                 ,input 43
     4782                                                 ,input yes
     4783                                                 ,input yes
     4784                                                 ).
     4785     Page Stream PrnLibStream.
     4786     output STREAM PrnLibStream CLOSE.
     4787     run prn-lib-open-stream  in this-procedure (
     4788                                                 input my-handle
     4789                                                 ,input 43
     4790                                                 ,input yes
     4791                                                 ,input yes
     4792                                                 ).
     4793   end.
     4794   else do:
     4795     run prn-lib-open-stream  in this-procedure (
     4796                                                 input my-handle
     4797                                                 ,input 43
     4798                                                 ,input yes
     4799                                                 ,input no
     4800                                                 ).
     4801   end.
     4802   find first obj-list .
     4803   FIND ub.clients WHERE ub.clients.obj-type = obj-list.obj-type AND
     4804                      ub.clients.obj-code = obj-list.obj-code NO-LOCK .
     4805   FIND FIRST buf_shop no-lock where
     4806              buf_shop.obj-code = obj-list.obj-code.
     4807   find first buf_sysconf No-lock where
     4808              buf_sysconf.host-code = buf_shop.host-code .
     4809   find first host-cli  No-LOCK WHERE
     4810              host-cli.obj-type = 'орг':U
     4811         AND host-cli.obj-code = buf_sysconf.host-code .
     4812   find first buf_firm No-LOCK where
     4813              buf_firm.firm-code = buf_sysconf.host-code .
     4814   find first real-cli No-LOCK WHERE
     4815              real-cli.obj-type = buf_sysconf.sale-type
     4816         AND  real-cli.obj-code  = buf_sysconf.sale-code .
     4817   find first real-firm No-LOCK where
     4818              real-firm.firm-code = real-cli.obj-code .
     4819   assign
     4820   v-direction = if p-is-out
     4821                 then "Продажи"
     4822                 else "Возвраты"
     4823   .
     4824   PUT STREAM PrnLibStream unformatted
     4825   'ИНН' chr(32) buf_firm.inn chr(32) host-cli.obj-name SKIP
     4826   clients.obj-name SKIP(2)
     4827   "Грузополучатель: ИНН" chr(32) real-firm.inn chr(32) real-cli.obj-name SKIP
     4828   "Поставщик: " host-cli.obj-name SKIP
     4829   "Плательщик: " real-cli.obj-name SKIP
     4830   "Основание:" skip
     4831   "Примечание:" chr(32) v-direction skip
     4832   "Вид оплаты: Наличные" skip(2)
     4833   space(15) "Товарная накладная №" space(15) "от " string(X-date-end, "99/99/9999") skip
     4834   space(100) "Группа реализации"
     4835   skip.
     4836   FORM HEADER
     4837   Line format "X(180)" AT 1 SKIP
     4838   "Продолжение - на следующей странице" AT 30 SKIP
     4839   with FRAME BottomFrame width 232  PAGE-BOTTOM NO-LABELS NO-BOX .
     4840   VIEW STREAM PrnLibStream FRAME BottomFrame .
     4841   FORM with FRAME SJ-Base .
     4842   FOR EACH sj-goods where sj-goods.is-out = p-is-out
     4843   BREAK
     4844   BY sj-goods.is-out DESCENDING
     4845   BY sj-goods.artic
     4846   BY sj-goods.prod-type
     4847   By sj-goods.prod-code
     4848   :
     4849       assign
     4850       sj-goods.netto-sum = sj-goods.brutto-sum - sj-goods.discnt-sum
     4851       v-opt-price = abs(sj-goods.uchet-sum / sj-goods.qnty)
     4852       v-sale-without-tax-sum = sj-goods.netto-sum - sj-goods.VAT-r-b - sj-goods.SLT-r-b
     4853       v-sale-without-tax-price = v-sale-without-tax-sum / sj-goods.qnty
     4854       for-netto-without-slt = sj-goods.netto-sum - sj-goods.slt-r-b
     4855       .
     4856       ACCUMULATE sj-goods.artic (SUB-COUNT BY sj-goods.is-out).
     4857       DISPLAY STREAM PrnLibStream
     4858       ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.artic @ jj-tot
     4859       sj-goods.artic
     4860       sj-goods.name
     4861       sj-goods.unit
     4862       sj-goods.qnty
     4863       v-opt-price
     4864       sj-goods.uchet-sum
     4865       v-sale-without-tax-price
     4866       v-sale-without-tax-sum
     4867       sj-goods.VAT-pc
     4868       sj-goods.VAT-r-b
     4869       for-netto-without-slt
     4870       sj-goods.SLT-r-b
     4871       sj-goods.netto-sum
     4872       with FRAME SJ-Base .
     4873       DOWN stream PrnLibStream
     4874       with frame SJ-BASE.
     4875       ACCUMULATE
     4876       sj-goods.qnty (TOTAL)
     4877       sj-goods.qnty ( SUB-TOTAL BY sj-goods.is-out )
     4878       sj-goods.uchet-sum (TOTAL)
     4879       sj-goods.uchet-sum (SUB-TOTAL BY sj-goods.is-out)
     4880       sj-goods.SLT-r-b (TOTAL)
     4881       sj-goods.SLT-r-b (SUB-TOTAL BY sj-goods.is-out)
     4882       sj-goods.VAT-r-b (TOTAL)
     4883       sj-goods.VAT-r-b (SUB-TOTAL BY sj-goods.is-out)
     4884       sj-goods.netto-sum (TOTAL)
     4885       sj-goods.netto-sum ( SUB-TOTAL BY sj-goods.is-out )
     4886       v-sale-without-tax-sum (TOTAL)
     4887       v-sale-without-tax-sum ( SUB-TOTAL BY sj-goods.is-out )
     4888       for-netto-without-slt (TOTAL)
     4889       for-netto-without-slt (SUB-TOTAL BY sj-goods.is-out )
     4890       .
     4891     if last( sj-goods.is-out ) then do:
     4892       if ( line-counter (PrnLibStream) + 12 + 3)  > page-size(PrnLibStream) then
     4893         page STREAM PrnLibStream .
     4894         UNDERLINE STREAM PrnLibStream
     4895         jj-tot
     4896         sj-goods.artic
     4897         sj-goods.name
     4898         sj-goods.unit
     4899         sj-goods.qnty
     4900         v-opt-price
     4901         sj-goods.uchet-sum
     4902         v-sale-without-tax-price
     4903         v-sale-without-tax-sum
     4904         sj-goods.VAT-pc
     4905         sj-goods.VAT-r-b
     4906         for-netto-without-slt
     4907         sj-goods.SLT-r-b
     4908         sj-goods.netto-sum
     4909         with FRAME SJ-Base .
     4910         DISPLAY STREAM PrnLibStream
     4911         string(ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.artic , ">>>>9") @ jj-tot
     4912         " наименований"  @ sj-goods.artic
     4913         string( "Итого ") @ sj-goods.name
     4914         ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.qnty @ sj-goods.qnty
     4915             ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.uchet-sum @ sj-goods.uchet-sum
     4916         ACCUM SUB-TOTAL BY sj-goods.is-out v-sale-without-tax-sum @ v-sale-without-tax-sum
     4917         ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.VAT-r-b @ sj-goods.VAT-r-b
     4918         ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.SLT-r-b @ sj-goods.SLT-r-b
     4919         ACCUM SUB-TOTAL BY sj-goods.is-out for-netto-without-slt @ for-netto-without-slt
     4920         ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.netto-sum @ sj-goods.netto-sum
     4921         with FRAME SJ-Base .
     4922         jj-tot = jj-tot  + ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.artic.
     4923         UNDERLINE STREAM PrnLibStream
     4924         jj-tot
     4925         sj-goods.artic
     4926         sj-goods.name
     4927         sj-goods.unit
     4928         sj-goods.qnty
     4929         v-opt-price
     4930         sj-goods.uchet-sum
     4931         v-sale-without-tax-price
     4932         v-sale-without-tax-sum
     4933         sj-goods.VAT-pc
     4934         sj-goods.VAT-r-b
     4935         for-netto-without-slt
     4936         sj-goods.SLT-r-b
     4937         sj-goods.netto-sum
     4938         with FRAME SJ-Base .
     4939         DOWN STREAM PrnLibStream 1 with FRAME SJ-Base .
     4940         PUT STREAM PrnLibStream unformatted
     4941         skip(3)
     4942         "Отпустил _______________  ________________  ____________________ товар и тару по количеству и надлежащему качеству" skip
     4943         space(10) "должность" space(9) "подпись" space(9) "расшифровка подписи" skip(2)
     4944         "Всего отпущено на сумму:" skip(2)
     4945         "Получил  _______________  ________________  ____________________" skip
     4946         space(10) "должность" space(9) "подпись" space(9) "расшифровка подписи" skip.
     4947     end.
     4948   END .
     4949   HIDE STREAM PrnLibStream FRAME BottomFrame .
     4950   output STREAM PrnLibStream CLOSE.
     4951   run waitfram-hide in this-procedure .
     4952   END PROCEDURE.
     4953   PROCEDURE send-records :
     4954   END PROCEDURE.
     4955   PROCEDURE state-changed :
     4956     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     4957     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     4958   END PROCEDURE.
