      358   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      360     (input  v-report-name
      361     ,input  2
      362     ,output v-exist
      363     )  .
      364       if NOT v-exist then
      365       DO:
      366         Message
      367           "Нет заданий на печать ! "
      368           view-as alert-box .
      369         Return  .
      370       End.
      371       run gbl/prnfilen.w
      372         (input  ""
      373         ,input  p-DisabledOptions
      374         ,input  string(v-report-name )
      375         ,input  7
      376         ,output v-user-action
      377         ,output v-printed
      378         ) .
      379       if v-printed then
      380       do:
      381         return "YES" .
      382       end.
      383       else
      384       do:
      385         return "NO" .
      386       end.
      387     end.
      388   end procedure.
      389   procedure prn-lib-open-stream :
      390     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      391     define input parameter p-page-size    as integer no-undo .
      392     define input parameter p-is-stream    as logical no-undo .
      393     define input parameter p-append       as logical no-undo .
      394     define variable v-report-name as character no-undo .
      395     do
      396       on error undo, return error
      397       :
      398       run prn-lib-get-report-name  in this-procedure (
      399         input parParentProc
      400         ,output v-report-name
      401         ).
      402       if p-is-stream then
      403       do:
      404         if p-append then
      405         do:
      406           output stream PrnLibStream to value( v-report-name )
      407             page-size value(p-page-size) append .
      408         end.
      409         if not p-append then
      410         do:
      411           output stream PrnLibStream to value( v-report-name )
      412             page-size value(p-page-size) .
      413         end.
      414       end.
      415       if not p-is-stream then
      416       do:
      417         if p-append then
      418         do:
      419           output to value( v-report-name )
      420             page-size value(p-page-size) append .
      421         end.
      422         if not p-append then
      423         do:
      424           output to value( v-report-name )
      425             page-size value(p-page-size) .
      426         end.
      427       end.
      428     end.
      429   end procedure.
      430   procedure prn-lib-open-exp :
      431     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      432     define input parameter p-is-stream    as logical no-undo .
      433     define input parameter p-is-append    as logical no-undo .
      434     define output parameter p-ReportFileName as char init "report" no-undo.
      435     define output parameter p-process as logical no-undo .
      436     define variable glog as logical no-undo .
      437     do
      438       on error undo, return error
      439       :
      440       SYSTEM-DIALOG GET-FILE p-ReportFileName
      441         TITLE      "Укажите путь"
      442         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      443         ASK-OVERWRITE
      444         CREATE-TEST-FILE
      445         SAVE-AS
      446         USE-FILENAME
      447         DEFAULT-EXTENSION "txt"
      448         UPDATE glog
      449         .
      450       if not glog then  return.
      451       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      452       if p-is-stream then
      453       do:
      454         if p-is-append then
      455         do:
      456           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      457         end.
      458         else
      459         do:
      460           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      461         end.
      462       end.
      463       else
      464       do:
      465         if p-is-append then
      466         do:
      467           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      468         end.
      469         else
      470         do:
      471           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      472         end.
      473       end.
      474       p-process = yes.
      475     end.
      476   end procedure.
      477   procedure prn-lib-get-report-name :
      478     define input parameter parParentProc  as widget-handle no-undo.
      479     define output parameter p-report-name as character no-undo .
      480     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      481   end procedure.
      482   procedure prn-lib-reportviewer-report-name :
      483     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      484     define input parameter p-report-name-html as character no-undo .
      485     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      486   end procedure.
      487   procedure prn-lib-reportviewer :
      488     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      489     define input parameter p-report-name-html as character no-undo .
      490     define input parameter p-param        as character no-undo .
      491     define variable v-excel           as character no-undo init 'TRUE' .
      492     define variable v-value-character as character no-undo .
      493     define variable v-value-integer   as character no-undo .
      494     define variable v-value-date      as date      no-undo .
      495     define variable v-value-decimal   as decimal   no-undo .
      496     define variable rep-excel         as logical   no-undo .
      497     define variable excel-string      as character no-undo .
      498     define variable v-param-type      as character no-undo .
      499     define variable v-tth             as handle    no-undo .
      500     run adm/shattri.p (
      501       input "get":U
      502       ,input  ""
      503       ,input  0
      504       ,input  'report-glob':U
      505       ,input  'rep-excel':U
      506       ,output v-value-character
      507       ,output v-value-date
      508       ,output v-value-decimal
      509       ,output v-value-integer
      510       ,output rep-excel
      511       ,output v-param-type
      512       ,INPUT-OUTPUT table-handle v-tth
      513       )  .
      514     if rep-excel then v-excel = "TRUE" .
      515     else v-excel = "FALSE" .
      516     if p-param eq ""
      517     then
      518        p-param = "EXCEL:" + v-excel.
      519     else
      520        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      521     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      522   end procedure.
