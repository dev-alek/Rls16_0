      619   define variable var-report-r-b as character no-undo .
      620   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      621   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      622     (output var-report-r-b
      623     )  .
      624   define variable parparentproc as widget-handle no-undo .
      625   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626     define variable v-cntxt-db-num        as integer   no-undo .
      627     define variable v-cntxt-userid        as character no-undo .
      628     define variable v-cntxt-level         as character no-undo .
      629     define variable v-cntxt-host-code-obj as integer   no-undo .
      630     define variable v-cntxt-obj-type      as character no-undo .
      631     define variable v-cntxt-obj-code      as integer   no-undo .
      632     define variable v-cntxt-db-num-obj    as integer   no-undo .
      633     define variable v-cntxt-is-admin      as logical   no-undo .
      634   define variable v-host-code like ub.sysconf.host-code no-undo .
      635   define variable v-host-name like ub.clients.obj-name no-undo .
      636   DEFINE VARIABLE f-slt-pc AS DECIMAL FORMAT ">9.99":U INITIAL 5
      637        VIEW-AS FILL-IN
      638        SIZE 17.88 BY 1 NO-UNDO.
      639   DEFINE RECTANGLE RECT-SLT
      640        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      641        SIZE 25.63 BY 4.46.
      642   DEFINE VARIABLE T-SLT-sum AS LOGICAL INITIAL no
      643        LABEL "в том числе НсП"
      644        VIEW-AS TOGGLE-BOX
      645        SIZE 18.13 BY .83 NO-UNDO.
      646   DEFINE FRAME F-Main
      647        T-SLT-sum AT ROW 3.29 COL 4.38
      648        f-slt-pc AT ROW 4.75 COL 4 NO-LABEL
      649        RECT-SLT AT ROW 2.33 COL 2
      650       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      651            SIDE-LABELS NO-UNDERLINE THREE-D
      652            AT COL 1 ROW 1
      653            SIZE 77.88 BY 17.13.
      654   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      655   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      656   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      657   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      658   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      659   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      660   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      661   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      662       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
      663   RUN ensure-broker.
      664   THIS-PROCEDURE:ADM-DATA =
      665        'ADM1.1~`':U +
      666        'SmartObject~`':U +
      667        'FRAME~`':U +
      668        'NO ~`':U +
      669        '~`':U +
      670        '~`':U +
      671        '~`':U +
      672        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      673           + "~`":U +
      674        'Layout,Hide-on-Init~`':U +
      675        '~`':U +
      676        '~`':U +
      677        '~`~`~`~`~`~`~`~`~`~`~`':U +
      678        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      679            THEN "^^":U
      680        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      681             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      682   PROCEDURE adm-apply-entry :
      683     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      684   END PROCEDURE.
      685   PROCEDURE adm-destroy :
      686    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      687   END PROCEDURE.
      688   PROCEDURE adm-disable :
      689       DISABLE RECT-SLT T-SLT-sum WITH FRAME F-Main.
      690       RUN dispatch ('disable-fields':U).
      691       RUN set-attribute-list ('ENABLED=no':U).
      692       RETURN.
      693   END PROCEDURE.
      694   PROCEDURE adm-edit-attribute-list :
      695         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      696         RETURN.
      697   END PROCEDURE.
      698   PROCEDURE adm-enable :
      699       ENABLE UNLESS-HIDDEN RECT-SLT T-SLT-sum WITH FRAME F-Main.
      700       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      701       RUN set-attribute-list ('ENABLED=yes':U).
      702       RETURN.
      703   END PROCEDURE.
      704   PROCEDURE adm-exit :
      705        RUN notify ('exit':U).
      706     RETURN.
      707   END PROCEDURE.
      708   PROCEDURE adm-hide :
      709     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      710   END PROCEDURE.
      711   PROCEDURE adm-initialize :
      712     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      713   END PROCEDURE.
      714   PROCEDURE adm-show-errors :
      715       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      716       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      717           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      718       END.
      719       RETURN.
      720   END PROCEDURE.
      721   PROCEDURE adm-UIB-mode :
      722     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      723   END PROCEDURE.
      724   PROCEDURE adm-view :
      725     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      726   END PROCEDURE.
      727   PROCEDURE dispatch :
      728       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      729       RUN broker-dispatch IN adm-broker-hdl
      730           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      731       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      732   END PROCEDURE.
      733   PROCEDURE ensure-broker :
      734   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      735   IF RETURN-VALUE NE "ADM-Broker":U THEN
      736   DO:
      737       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      738       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      739   END.
      740   END PROCEDURE.
      741   PROCEDURE get-attribute :
      742     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      743     RUN broker-get-attribute IN adm-broker-hdl
      744         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      745     RETURN RETURN-VALUE.
      746   END PROCEDURE.
      747   PROCEDURE get-attribute-list :
      748     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      749     RUN broker-get-attribute-list IN adm-broker-hdl
      750         (INPUT THIS-PROCEDURE,
      751          INPUT ?,
      752          OUTPUT p-attr-list) NO-ERROR.
      753     RETURN.
      754   END PROCEDURE.
      755   PROCEDURE new-state :
      756     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      757     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      758     RETURN.
      759   END PROCEDURE.
      760   PROCEDURE notify :
      761     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      762     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      763     IF RETURN-VALUE = "ADM-ERROR":U THEN
      764         RETURN "ADM-ERROR":U.
      765     RETURN.
      766   END PROCEDURE.
      767   PROCEDURE set-attribute-list :
      768     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      769     RUN ensure-broker.
      770     RUN broker-set-attribute-list IN adm-broker-hdl
      771         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      772     RETURN.
      773   END PROCEDURE.
      774   PROCEDURE set-position :
      775       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      776       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      777       IF VALID-HANDLE(adm-object-hdl) THEN
      778       DO:
      779           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      780           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      781           DO:
      782             IF p-row = 0 THEN p-row =
      783               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      784             IF p-col = 0 THEN p-col =
      785               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      786           END.
      787           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      788           DO:
      789             parent-hdl = adm-object-hdl:PARENT.
      790             IF p-row = 0 THEN p-row =
      791               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      792                 parent-hdl:ROW.
      793             IF p-col = 0 THEN p-col =
      794               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      795                 parent-hdl:COL.
      796           END.
      797           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      798           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      799         ASSIGN adm-object-hdl:ROW    =   p-row
      800                adm-object-hdl:COLUMN =   p-col.
      801       END.
      802       RETURN.
      803   END PROCEDURE.
      804   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      805       STRING(adm-object-hdl)).
      806   PAUSE 0 BEFORE-HIDE.
      807   PROCEDURE adm-change-page :
      808     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      809     END PROCEDURE.
      810   PROCEDURE delete-page :
      811     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      812     RUN broker-delete-page IN adm-broker-hdl
      813         (INPUT THIS-PROCEDURE, INPUT p-page#).
      814     END PROCEDURE.
      815   PROCEDURE init-object :
      816     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      817     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      818     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      819     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      820     RUN broker-init-object IN adm-broker-hdl
      821         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      822          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      823     RETURN.
      824   END PROCEDURE.
      825   PROCEDURE init-pages :
      826     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      827     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      828         INPUT p-page-list) NO-ERROR.
      829     END PROCEDURE.
      830   PROCEDURE select-page :
      831     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      832     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      833         INPUT p-page#) NO-ERROR.
      834     END PROCEDURE.
      835   PROCEDURE view-page :
      836     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      837     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      838         INPUT p-page#).
      839     END PROCEDURE.
      840   ASSIGN
      841          f-slt-pc:HIDDEN IN FRAME F-Main           = TRUE.
      842   ON VALUE-CHANGED OF T-SLT-sum IN FRAME F-Main
      843   DO:
      844     assign
      845     T-SLT-sum.
      846     CASE T-SLT-sum:
      847       when no then do:
      848         disable
      849         f-slt-pc
      850         with frame F-Main .
      851         hide
      852           f-slt-pc
      853           in frame F-Main.
      854       end.
      855       when yes then do:
      856         view
      857         f-slt-pc in frame F-Main.
      858         display
      859               5 @ f-slt-pc
      860               with frame F-Main .
      861         enable
      862         f-slt-pc
      863         with frame F-Main .
      864       end.
      865     END CASE.
      866   END.
      867   if not this-procedure :persistent
      868   then do:
      869     message
      870       vss-workfile vss-revision vss-description skip
      871       "Ошибка при запуске процедуры" skip
      872       "Данную процедуру следует запускать только с параметром persistent" skip
      873       view-as alert-box error .
      874     undo, return error .
      875   end.
      876   parparentproc = my-handle.
      877   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      878     run mainmenu_getcntxt in parparentproc
      879       (output v-cntxt-db-num
      880       ,output v-cntxt-userid
      881       ,output v-cntxt-level
      882       ,output v-cntxt-host-code-obj
      883       ,output v-cntxt-obj-type
      884       ,output v-cntxt-obj-code
      885       ,output v-cntxt-db-num-obj
      886       ,output v-cntxt-is-admin
      887       ) .
      888   PROCEDURE adm-create-objects :
      889   END PROCEDURE.
      890   PROCEDURE adm-row-available :
      891     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      892     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      893     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      894     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      895     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      896     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      897     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      898     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      899     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      900     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      901     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      902     IF adm-updating-record THEN RETURN.
      903     RUN get-attribute ('FIELDS-ENABLED':U).
      904     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      905     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      906         OUTPUT link-handle) NO-ERROR.
      907     IF link-handle = "":U THEN
      908         RETURN.
      909     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      910     IF NUM-ENTRIES(link-handle) > 1 THEN
      911         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      912             "encountered more than one RECORD-SOURCE.":U SKIP
      913             "The first - ":U record-source-hdl:file-name " - will be used.":U
      914                VIEW-AS ALERT-BOX ERROR.
      915     RUN get-attribute ('Key-Name':U).
      916     key-name = RETURN-VALUE.
      917     IF key-name = "":U THEN key-name = ?.
      918     IF key-name NE ? THEN DO:
      919       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      920         NO-ERROR.
      921       IF key-value NE ? THEN
      922         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      923     END.
      924   IF VALID-HANDLE (adm-object-hdl) THEN
      925       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      926   RUN notify IN THIS-PROCEDURE ('row-available':U).
      927   END PROCEDURE.
      928   PROCEDURE disable_UI :
      929     HIDE FRAME F-Main.
      930     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      931   END PROCEDURE.
      932   PROCEDURE enable_UI :
      933     DISPLAY T-SLT-sum
      934         WITH FRAME F-Main.
      935     ENABLE RECT-SLT T-SLT-sum
      936         WITH FRAME F-Main.
      937   END PROCEDURE.
      938   PROCEDURE My-report :
      939   DEFINE VARIABLE v-report-header as character no-undo .
      940   DEFINE VARIABLE v-frame-width as integer no-undo .
      941   DEFINE VARIABLE v-to-del as logical no-undo .
      942   define buffer buf_gds-prt for ub.gds-prt.
      943   define buffer buf_units for ub.units .
      944   find first gds-list no-error .
      945   if NOT avail gds-list then do:
      946       message "Не выбран принципиал"
      947       view-as alert-box ERROR.
      948       return.
      949   end.
      950   CASE x-SelectGood:
      951     when 5 then do:
      952       assign
      953       v-to-del = no
      954       .
      955       FIND FIRST buf_gds-prt No-LOCK WHERE               buf_gds-prt.upper-code = gds-list.prt-root.      if not buf_gds-prt.node-name = '_Пустая шкала':U then do:        message       "Принципал не может быть отождествлен со шкальным товаром"       "Товар-" gds-list.artic gds-list.prod-type gds-list.prod-code skip       gds-list.gds-name       view-as alert-box ERROR.       v-to-del = yes.     end.     if not v-to-del then do:       find first buf_units No-LOCK WHERE                 buf_units.unit-name = gds-list.unit-base .       if lookup('сер':U, buf_units.type ) > 0 then do:         message         "Принципал не может быть отождествлен с серийным товаром"         "Товар-" gds-list.artic gds-list.prod-type gds-list.prod-code skip         gds-list.gds-name         view-as alert-box ERROR.         v-to-del = yes.       end.     end.
      956       if v-to-del then do:
      957         return.
      958       end.
      959       assign
      960       ReportHeader = "":U
      961       ReportName = v-host-name
      962       str1 =  "Акт выполненных работ по агентскому договору" + chr(32) +
      963               (if available gds-list
      964                 then ("(принципиал" + chr(32) + gds-list.gds-name + ")":U)
      965                 else "( принципиал не определен) ")
      966       str2 =    "За период с" + chr(32) + string(X-date-start, "99/99/9999") + chr(32)  +
      967                 "по" + chr(32) + string(X-date-end, "99/99/9999")
      968       str3 = "":U
      969       v-report-header = ReportName + chr(10) +
      970                         str1 + chr(10) +
      971                         str2 + chr(10) +
      972                         str4
      973                         .
      974       run cus/r-princp.p (
      975                      input my-handle
      976                     ,input v-cntxt-host-code-obj
      977                     ,input gds-list.gds-code
      978                     ,input T-SLT-sum
      979                     ,input f-slt-pc
      980                     ,input v-report-header
      981                     ,output v-frame-width
      982                     ).
      983     end.
      984     when 4 then do:
      985       for each gds-list:
      986         assign
      987         v-to-del = no
      988         .
      989         FIND FIRST buf_gds-prt No-LOCK WHERE               buf_gds-prt.upper-code = gds-list.prt-root.      if not buf_gds-prt.node-name = '_Пустая шкала':U then do:        message       "Принципал не может быть отождествлен со шкальным товаром"       "Товар-" gds-list.artic gds-list.prod-type gds-list.prod-code skip       gds-list.gds-name       view-as alert-box ERROR.       v-to-del = yes.     end.     if not v-to-del then do:       find first buf_units No-LOCK WHERE                 buf_units.unit-name = gds-list.unit-base .       if lookup('сер':U, buf_units.type ) > 0 then do:         message         "Принципал не может быть отождествлен с серийным товаром"         "Товар-" gds-list.artic gds-list.prod-type gds-list.prod-code skip         gds-list.gds-name         view-as alert-box ERROR.         v-to-del = yes.       end.     end.
      990         if v-to-del then do:
      991           message
      992           "Пропускаю товар"
      993           view-as alert-box .
      994           delete gds-list.
      995         end.
      996       end.
      997       if not can-find(first gds-list) then do:
      998         message "Не выбран принципиал"
      999         view-as alert-box ERROR.
     1000         return.
     1001       end.
     1002   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1003   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1004     (input  v-cntxt-obj-type
     1005     ,input  v-cntxt-obj-code
     1006     ,output v-host-code
     1007     ,output v-host-name
     1008     )  .
     1009       assign
     1010       ReportHeader = "":U
     1011       ReportName = v-host-name
     1012       str1 =  "Акт выполненных работ по агентскому договору"
     1013       str2 =    "За период с" + chr(32) + string(X-date-start, "99/99/9999") + chr(32)  +
     1014                 "по" + chr(32) + string(X-date-end, "99/99/9999")
     1015       str3 = "":U
     1016       v-report-header = ReportName + chr(10) +
     1017                         str1 + chr(10) +
     1018                         str2 + chr(10) +
     1019                         str4
     1020                         .
     1021       run cus/r-princl.p (
     1022                      input my-handle
     1023                     ,input v-cntxt-host-code-obj
     1024                     ,input T-SLT-sum
     1025                     ,input f-slt-pc
     1026                     ,input v-report-header
     1027                     ,output v-frame-width
     1028                     ).
     1029     end.
     1030   END CASE.
     1031   END PROCEDURE.
     1032   PROCEDURE My-var :
     1033   Assign
     1034   frame F-Main T-SLT-sum
     1035   frame F-Main f-slt-pc
     1036   .
     1037   Assign
     1038    STR-obj-type = ''
     1039    STR-obj-code = ''
     1040    STR-obj-name = ''
     1041    STR-obj      = ''.
     1042   For each obj-list no-lock:
     1043    Assign
     1044    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1045    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1046    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1047    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1048   End.
     1049   Reportname = "Отчет по сумме кассовых услуг, оказанных агентом" + chr(32) + "принципиалу".
     1050   ReportHeader =
     1051                   (if available gds-list
     1052                     then gds-list.gds-name
     1053                     else "( принципиал не определен) ") +
     1054                   chr(10) +
     1055                   (if T-SLT-sum
     1056                                   then ("(в том числе с НсП" + chr(32) +  string(f-slt-pc, ">9.99%") + ")")
     1057                                   else "":U)
     1058                   .
     1059   END PROCEDURE.
     1060   PROCEDURE send-records :
     1061   END PROCEDURE.
     1062   PROCEDURE state-changed :
     1063     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1064     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1065   END PROCEDURE.
