      128   .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   def
      131   new shared
      132   temp-table  obj-list no-undo
      133     field obj-type like ub.clients.obj-type
      134     field obj-code like ub.clients.obj-code
      135     field obj-name like ub.clients.obj-name
      136     field obj-id   as integer
      137     field db-num   as integer
      138     index pi is primary unique obj-id
      139     index ie1 obj-type obj-code
      140     index ie2 obj-name
      141   .
      142   procedure create_obj-list :
      143      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      144      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      145      do
      146      on error undo, return error return-value
      147      :
      148         define buffer cli-obj for ub.clients .
      149         define variable p-var as integer no-undo .
      150         define buffer buf_obj-list for obj-list .
      151         find last buf_obj-list  use-index pi no-error .
      152         if available buf_obj-list
      153         then
      154            p-var = buf_obj-list.obj-id + 1.
      155         else
      156            p-var = 1.
      157         find first cli-obj where
      158                   cli-obj.obj-type = p-obj-type
      159               and cli-obj.obj-code = p-obj-code
      160         no-lock no-error.
      161         if available cli-obj
      162         then do:
      163            create buf_obj-list.
      164            assign
      165               buf_obj-list.obj-id   = p-var
      166               buf_obj-list.obj-code = cli-obj.obj-code
      167               buf_obj-list.obj-type = cli-obj.obj-type
      168               buf_obj-list.obj-name = cli-obj.obj-name
      169               buf_obj-list.db-num   = cli-obj.db-num
      170            .
      171         end.
      172      end.
      173   end.
      174   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   procedure factord :
      176     define input  parameter p-fact-date            as date    no-undo .
      177     define input  parameter p-fact-time            as integer no-undo .
      178     define input  parameter p-fact-num             as integer no-undo .
      179     define input  parameter p-shift-date           as date    no-undo .
      180     define input  parameter p-shift-num            as integer no-undo .
      181     define input  parameter p-shift-on             as logical no-undo .
      182     define output parameter p-fact-order           as decimal no-undo .
      183     define output parameter p-shift-end-fact-order as decimal no-undo .
      184     define output parameter p-day-end-fact-order   as decimal no-undo .
      185     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      186     if p-fact-date = ?
      187     then do:
      188       return error "Не указана фактическая дата" .
      189     end.
      190     define variable v-fact-date-num as integer no-undo .
      191     assign
      192       v-fact-date-num = integer(p-fact-date)
      193     .
      194     if p-fact-num = ?
      195     or p-fact-num = 0
      196     then do:
      197       return error "Не задан p-fact-num " + string(p-fact-num) .
      198     end.
      199     if p-fact-num < 0
      200     then do:
      201       return error "Отрицательный fact-num " + string(p-fact-num) .
      202     end.
      203     if p-fact-num >= 100000000
      204     then do:
      205       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      206     end.
      207     if p-shift-on = true
      208     then do:
      209       if p-shift-date = ?
      210       then do:
      211         return error "Не задана дата смены" .
      212       end.
      213       if p-shift-num = ?
      214       or p-shift-num = 0
      215       then do:
      216         return error "Не задан номер смены" .
      217       end.
      218     end.
      219     else do:
      220       assign
      221         p-shift-date = p-fact-date
      222         p-shift-num  = 24
      223       .
      224     end.
      225     define variable v-shift-offset as integer no-undo .
      226     if p-shift-date = p-fact-date
      227     then do:
      228       assign
      229         v-shift-offset = 1
      230       .
      231     end.
      232     if p-shift-date < p-fact-date
      233     then do:
      234       assign
      235         v-shift-offset = 0
      236       .
      237     end.
      238     if p-shift-date > p-fact-date
      239     then do:
      240       message
      241         vss-workfile vss-revision vss-description skip
      242         "Неправильная дата закрытия смены" skip
      243         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      244         view-as alert-box error .
      245       undo, return error
      246         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      247           ,string(p-fact-date, '99/99/9999':U)
      248           ,string(p-shift-date, '99/99/9999':U)
      249           )
      250       .
      251     end.
      252     if p-shift-num < 1
      253     or p-shift-num > 24
      254     then do:
      255       message
      256         vss-workfile vss-revision vss-description skip
      257         "Неправильный номер смены" skip
      258         "p-shift-num" p-shift-num skip
      259         view-as alert-box error .
      260       undo, return error return-value .
      261     end.
      262     assign
      263       p-fact-order           = v-fact-date-num
      264                              + v-shift-offset * 0.5
      265                              + p-shift-num    * 0.02 - 0.01
      266                              + p-fact-num     * 0.0000000001
      267       p-shift-end-fact-order = v-fact-date-num
      268                              + v-shift-offset * 0.5
      269                              + p-shift-num    * 0.02
      270       p-day-end-fact-order   = v-fact-date-num
      271                              + 0.99
      272     .
      273     if p-fact-order           <= v-fact-date-num
      274     or p-shift-end-fact-order <= v-fact-date-num
      275     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      276     or p-shift-end-fact-order >= p-day-end-fact-order
      277     then do:
      278       message
      279         vss-workfile vss-revision vss-description skip
      280         "Внутренняя ошибка при генерации фактического номера" skip
      281         "p-fact-date"            p-fact-date            skip
      282         "p-fact-time"            p-fact-time            skip
      283         "p-fact-num"             p-fact-num             skip
      284         "p-shift-date"           p-shift-date           skip
      285         "p-shift-num"            p-shift-num            skip
      286         "p-shift-on"             p-shift-on             skip
      287         "p-shift-end-fact-order" p-shift-end-fact-order skip
      288         "p-day-end-fact-order"   p-day-end-fact-order   skip
      289         "v-fact-date-num"        v-fact-date-num        skip
      290         view-as alert-box error .
      291       undo, return error return-value .
      292     end.
      293   end procedure.
      294   procedure day-begin-fact-order :
      295     define input  parameter p-fact-date            as date    no-undo .
      296     define output parameter p-day-begin-fact-order as decimal no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       if p-fact-date = ?
      301       then do:
      302         assign
      303           p-day-begin-fact-order = 0
      304         .
      305       end.
      306       else do:
      307         assign
      308           p-day-begin-fact-order = integer(p-fact-date)
      309         .
      310       end.
      311     end.
      312   end procedure.
      313   procedure factord-max-fact-order :
      314     define output parameter p-max-fact-order as decimal   no-undo .
      315     do
      316     on error undo, return error return-value
      317     :
      318       run day-begin-fact-order in this-procedure
      319         (input  date(1, 1, 5000)
      320         ,output p-max-fact-order
      321         ) .
      322     end.
      323   end procedure.
      324   procedure factord-cut-archive :
      325     define input  parameter p-obj-type             as character no-undo .
      326     define input  parameter p-obj-code             as integer   no-undo .
      327     define input  parameter p-fact-date            as date      no-undo .
      328     define output parameter p-shift-on             as logical   no-undo .
      329     define output parameter p-shift-date           as date      no-undo .
      330     define output parameter p-shift-num            as integer   no-undo .
      331     define output parameter p-day-end-fact-order   as decimal   no-undo .
      332     define output parameter p-shift-end-fact-order as decimal   no-undo .
      333     define variable v-fact-order as decimal   no-undo .
      334     define buffer buf_shift-obj for ub.shift-obj .
      335     do
      336     on error undo, return error return-value
      337     :
      338   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      340     (input  p-obj-type
      341     ,input  p-obj-code
      342     ,input  'shift-on=request'
      343     ,output p-shift-on
      344     ) no-error .
      345       if error-status :error
      346       then do:
      347         message
      348           vss-workfile vss-revision vss-description skip
      349           "Ошибка при определении атрибута объекта" skip
      350           "Объект" p-obj-type p-obj-code skip
      351           error-status :get-message(1) skip
      352           return-value skip
      353           view-as alert-box error .
      354         undo, return error return-value .
      355       end.
      356       if p-shift-on = false
      357       then do:
      358         assign
      359           p-shift-date               = ?
      360           p-shift-num                = 0
      361         .
      362       end.
      363       else do:
      364         find first buf_shift-obj share-lock
      365           where buf_shift-obj.obj-type   = p-obj-type
      366             and buf_shift-obj.obj-code   = p-obj-code
      367             and buf_shift-obj.shift-date > p-fact-date
      368           use-index pi
      369           no-error .
      370         if not available buf_shift-obj
      371         or buf_shift-obj.status_ <> 'зкр':U
      372         then do:
      373           message
      374             vss-workfile vss-revision vss-description skip
      375             "Невозможно вычислить последнюю смену" skip
      376             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      377             "Объект" p-obj-type p-obj-code skip
      378             "Дата" p-fact-date skip
      379             view-as alert-box error .
      380           undo, return error return-value .
      381         end.
      382         find last buf_shift-obj share-lock
      383           where buf_shift-obj.obj-type = p-obj-type
      384             and buf_shift-obj.obj-code = p-obj-code
      385             and buf_shift-obj.shift-date <= p-fact-date
      386           use-index pi
      387           no-error .
      388         if available buf_shift-obj
      389         then do:
      390           if  buf_shift-obj.status_ = 'зкр':U
      391           then do:
      392             assign
      393               p-shift-date = buf_shift-obj.shift-date
      394               p-shift-num  = buf_shift-obj.shift-num
      395             .
      396           end.
      397           else do:
      398             message
      399               vss-workfile vss-revision vss-description skip
      400               "Невозможно вычислить последнюю смену" skip
      401               "Статус смены отличен от статуса" 'зкр':U skip
      402               "Объект" p-obj-type p-obj-code skip
      403               "Дата" p-fact-date skip
      404               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      405               view-as alert-box error .
      406             undo, return error return-value .
      407           end.
      408         end.
      409         else do:
      410           assign
      411             p-shift-date = p-fact-date - 1
      412             p-shift-num  = 1
      413           .
      414         end.
      415       end.
      416       run factord in this-procedure
      417         (input  p-fact-date
      418         ,input  1
      419         ,input  1
      420         ,input  p-shift-date
      421         ,input  p-shift-num
      422         ,input  p-shift-on
      423         ,output v-fact-order
      424         ,output p-shift-end-fact-order
      425         ,output p-day-end-fact-order
      426         ) no-error .
      427       if error-status :error
      428       then do:
      429         message
      430           vss-workfile vss-revision vss-description skip
      431           "Ошибка при вызове процедуры factord"
      432           error-status :get-message(1) skip
      433           return-value skip
      434           view-as alert-box error .
      435         undo, return error return-value .
      436       end.
      437     end.
      438   end procedure.
      439   procedure factord-lock-shift :
      440     define input  parameter p-obj-type  as character no-undo .
      441     define input  parameter p-obj-code  as integer   no-undo .
      442     define input  parameter p-fact-date as date      no-undo .
      443     define parameter buffer buf_shift-obj for ub.shift-obj .
      444     define variable v-shift-on      as logical   no-undo .
      445     define variable v-extra-message as character no-undo .
      446     define variable v-error as character no-undo .
      447     do
      448     on error undo, return error return-value
      449     :
      450   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      451   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      452     (input  p-obj-type
      453     ,input  p-obj-code
      454     ,input  'shift-on=request'
      455     ,output v-shift-on
      456     ) no-error .
      457       if error-status :error
      458       then do:
      459         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      460         undo, return error v-error .
      461       end.
      462       if v-shift-on = true
      463       then do:
      464         find first buf_shift-obj share-lock
      465           where buf_shift-obj.obj-type   = p-obj-type
      466             and buf_shift-obj.obj-code   = p-obj-code
      467             and buf_shift-obj.shift-date > p-fact-date
      468           use-index pi
      469           no-error .
      470         if not available buf_shift-obj
      471         or buf_shift-obj.status_ <> 'зкр':U
      472         then do:
      473           find last buf_shift-obj
      474             where buf_shift-obj.obj-type = p-obj-type
      475               and buf_shift-obj.obj-code = p-obj-code
      476               and buf_shift-obj.status_  = 'зкр':U
      477             use-index stts
      478             no-error .
      479           if available buf_shift-obj
      480           then do:
      481             assign
      482               v-extra-message =
      483                     substitute("Дата начала последеней закрытой смены на объекте &1"
      484                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      485                               )
      486             .
      487           end.
      488           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      489           undo, return error v-error .
      490         end.
      491       end.
      492     end.
      493   end procedure.
      494   procedure factord-end-day :
      495     define input  parameter p-fact-date            as date    no-undo .
      496     define output parameter p-day-end-fact-order   as decimal no-undo .
      497     do
      498     on error undo, return error return-value
      499     :
      500       if p-fact-date = ?
      501       then do:
      502         return error "Не указана фактическая дата" .
      503       end.
      504       assign
      505         p-day-end-fact-order = integer(p-fact-date) + 0.99
      506       .
      507     end.
      508   end procedure.
      509   procedure factord-to-date :
      510     define input  parameter p-fact-order as decimal no-undo .
      511     define output parameter p-fact-date  as date    no-undo .
      512     define variable v-ref-date  as date      no-undo .
      513     define variable v-ref-delta as integer   no-undo .
      514     do
      515     on error undo, return error return-value
      516     :
      517       if p-fact-order = ?
      518       or p-fact-order = 0
      519       then do:
      520         return error "Не указан fact-order" .
      521       end.
      522       assign
      523         v-ref-date  = date(1, 1, 2000)
      524       .
      525       assign
      526         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      527       .
      528       assign
      529         p-fact-date = v-ref-date + v-ref-delta
      530       .
      531     end.
      532   end procedure.
      533   procedure factord-to-fact-num :
      534     define input  parameter p-fact-order as decimal no-undo .
      535     define output parameter p-fact-num   as integer no-undo .
      536     define variable v-fact-order-trunc as decimal no-undo .
      537     do
      538     on error undo, return error return-value
      539     :
      540       if p-fact-order = ?
      541       or p-fact-order = 0
      542       then do:
      543         return error "Не указан fact-order" .
      544       end.
      545       assign
      546        v-fact-order-trunc = truncate(p-fact-order, 2)
      547       .
      548       assign
      549         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      550       .
      551     end.
      552   end procedure.
      553   procedure factord-to-shift-num :
      554     define input  parameter p-fact-order as decimal no-undo .
      555     define output parameter p-shift-num   as integer no-undo .
      556     define variable  p-shift-numd  as decimal   no-undo .
      557     define variable v-fact-order-trunc as decimal no-undo .
      558     do
      559     on error undo, return error return-value
      560     :
      561       if p-fact-order = ?
      562       or p-fact-order = 0
      563       then do:
      564         return error "Не указан fact-order" .
      565       end.
      566       assign
      567        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      568       .
      569       if v-fact-order-trunc < 0.5 then do:
      570         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      571       end.
      572       assign
      573         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      574         .
      575        assign
      576         p-shift-num = truncate (p-shift-numd , 0)
      577       .
      578     end.
      579   end procedure.
      580   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      582   procedure partslib-clear-temp-parts :
      583     define buffer buf_temp-parts for temp-parts .
      584     do
      585     on error undo, return error
      586     :
      587       for each buf_temp-parts
      588       on error undo, return error
      589       :
      590         delete buf_temp-parts .
      591       end.
      592     end.
      593   end procedure.
      594   procedure partslib-create-temp-parts :
      595     define parameter buffer buf_parts       for ub.parts .
      596     define parameter buffer buf_temp-parts  for temp-parts .
      597     define input  parameter p-goods-twounit as logical   no-undo .
      598     define variable v-base-part-code as character no-undo .
      599     do
      600     on error undo, return error
      601     :
      602       if p-goods-twounit = true
      603       then do:
      604         assign
      605           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      606         .
      607       end.
      608       else do:
      609         assign
      610           v-base-part-code = buf_parts.part-code
      611         .
      612       end.
      613       find first buf_temp-parts exclusive-lock
      614         where buf_temp-parts.obj-type  = buf_parts.obj-type
      615           and buf_temp-parts.obj-code  = buf_parts.obj-code
      616           and buf_temp-parts.artic     = buf_parts.artic
      617           and buf_temp-parts.prod-type = buf_parts.prod-type
      618           and buf_temp-parts.prod-code = buf_parts.prod-code
      619           and buf_temp-parts.in-code   = buf_parts.in-code
      620           and buf_temp-parts.out-code  = 'free-zone':U
      621           and buf_temp-parts.part-code = v-base-part-code
      622         no-error.
      623       if not available buf_temp-parts
      624       then do:
      625         create buf_temp-parts .
      626         buffer-copy buf_parts to buf_temp-parts
      627         assign
      628           buf_temp-parts.out-code  = 'free-zone':U
      629           buf_temp-parts.part-code = v-base-part-code
      630           buf_temp-parts.rsrv-free = yes
      631           buf_temp-parts.status_   = no
      632           buf_temp-parts.qnty      = 0
      633           buf_temp-parts.fact-qnty = 0
      634           buf_temp-parts.real-qnty = 0
      635           buf_temp-parts.cli-qnty  = 0
      636         .
      637       end.
      638     end.
      639   end procedure.
      640   procedure partslib-init-temp-parts :
      641     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      642     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      643     define input parameter p-artic           like ub.parts.artic     no-undo .
      644     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      645     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      646     define buffer buf_parts      for ub.parts .
      647     define buffer buf_temp-parts for temp-parts .
      648     define variable v-goods-twounit    as logical   no-undo .
      649     do
      650     on error undo, return error
      651     :
      652   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      653   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      654     (input  p-artic
      655     ,input  p-prod-type
      656     ,input  p-prod-code
      657     ,input  'twounit=request':u
      658     ,output v-goods-twounit
      659     ) no-error .
      660       if error-status :error
      661       then do:
      662         message
      663           vss-workfile vss-revision vss-description skip
      664           vss-include-info5 skip
      665           "Ошибка при определении атрибута товара" skip
      666           "Артикул" p-artic p-prod-type p-prod-code skip
      667           "twounit=request" skip
      668           error-status :get-message(1) skip
      669           return-value skip
      670           view-as alert-box error .
      671         undo, return error return-value .
      672       end.
      673       run partslib-clear-temp-parts in this-procedure .
      674       for each buf_parts
      675         where buf_parts.obj-type  = p-obj-type
      676           and buf_parts.obj-code  = p-obj-code
      677           and buf_parts.artic     = p-artic
      678           and buf_parts.prod-type = p-prod-type
      679           and buf_parts.prod-code = p-prod-code
      680           and buf_parts.rsrv-free = yes
      681           and buf_parts.status_   = no
      682           and buf_parts.in-code   <> buf_parts.out-code
      683       on error undo, return error
      684       :
      685         run partslib-create-temp-parts in this-procedure
      686           (buffer buf_parts
      687           ,buffer buf_temp-parts
      688           ,input  v-goods-twounit
      689           ) .
      690         define variable v-parts-qnty          as decimal   no-undo .
      691         define variable v-parts-cli-qnty      as decimal   no-undo .
      692         define variable v-parts-free-qnty     as decimal   no-undo .
      693         define variable v-parts-free-cli-qnty as decimal   no-undo .
      694         if buf_parts.out-code = 'free-zone':U
      695         then do:
      696           assign
      697             v-parts-qnty          = buf_parts.qnty
      698             v-parts-cli-qnty      = buf_parts.cli-qnty
      699             v-parts-free-qnty     = buf_parts.qnty
      700             v-parts-free-cli-qnty = buf_parts.cli-qnty
      701           .
      702         end.
      703         else do:
      704           assign
      705             v-parts-qnty          = abs(buf_parts.qnty)
      706             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      707             v-parts-free-qnty     = 0
      708             v-parts-free-cli-qnty = 0
      709           .
      710         end.
      711         assign
      712           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      713           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      714           buf_temp-parts.real-qnty     = 0
      715           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      716           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      717           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      718         .
      719       end.
      720     end.
      721   end procedure.
      722   procedure partslib-init-temp-parts-by-factord :
      723     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      724     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      725     define input parameter p-artic              like ub.parts.artic     no-undo .
      726     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      727     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      728     define input parameter p-fact-order         as decimal   no-undo .
      729     define input parameter p-include-fact-order as logical   no-undo .
      730     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      731     define buffer buf_gds-obj  for ub.gds-obj .
      732     do
      733     on error undo, return error
      734     :
      735       do transaction
      736       on error undo, return error
      737       :
      738   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      739   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      740     (input  p-obj-type
      741     ,input  p-obj-code
      742     ,input  p-artic
      743     ,input  p-prod-type
      744     ,input  p-prod-code
      745     ,buffer buf_gds-obj
      746     ) no-error .
      747         if error-status :error
      748         then do:
      749           message
      750             vss-workfile vss-revision vss-description skip
      751             vss-include-info5 skip
      752             "Невозможно найти товар на объекте" skip
      753             "Объект" p-obj-type p-obj-code skip
      754             "Артикул" p-artic p-prod-type p-prod-code skip
      755             error-status :get-message(1) skip
      756             return-value skip
      757             view-as alert-box error .
      758           undo, return error .
      759         end.
      760         find current buf_gds-obj exclusive-lock .
      761       end.
      762       run partslib-init-temp-parts in this-procedure
      763         (input p-obj-type
      764         ,input p-obj-code
      765         ,input p-artic
      766         ,input p-prod-type
      767         ,input p-prod-code
      768         ) no-error .
      769       if error-status :error
      770       then do:
      771         message
      772           vss-workfile vss-revision vss-description skip
      773           vss-include-info5 skip
      774           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      775           "Объект" p-obj-type p-obj-code skip
      776           "Артикул" p-artic p-prod-type p-prod-code skip
      777           "p-fact-order" p-fact-order skip
      778           view-as alert-box error .
      779         undo, return error .
      780       end.
      781       if p-include-fact-order = true
      782       then do:
      783         assign
      784           p-fact-order = p-fact-order - 0.0000000001
      785         .
      786       end.
      787       define variable v-max-fact-order as character no-undo .
      788       run factord-max-fact-order in this-procedure
      789         (output v-max-fact-order
      790         ) no-error .
      791       if error-status :error
      792       then do:
      793         message
      794           vss-workfile vss-revision vss-description skip
      795           vss-include-info5 skip
      796           "Ошибка при вызове процедуры factord-max-fact-order" skip
      797           "Объект" p-obj-type p-obj-code skip
      798           "Артикул" p-artic p-prod-type p-prod-code skip
      799           "p-fact-order" p-fact-order skip
      800           view-as alert-box error .
      801         undo, return error .
      802       end.
      803       run partslib-update-by-factord in this-procedure
      804         (input p-obj-type
      805         ,input p-obj-code
      806         ,input p-artic
      807         ,input p-prod-type
      808         ,input p-prod-code
      809         ,input p-fact-order
      810         ,input v-max-fact-order
      811         ,input false
      812         ) no-error .
      813       if error-status :error
      814       then do:
      815         message
      816           vss-workfile vss-revision vss-description skip
      817           vss-include-info5 skip
      818           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      819           "Объект" p-obj-type p-obj-code skip
      820           "Артикул" p-artic p-prod-type p-prod-code skip
      821           "p-fact-order" p-fact-order skip
      822           "v-max-fact-order" v-max-fact-order skip
      823           view-as alert-box error .
      824         undo, return error .
      825       end.
      826     end.
      827   end procedure.
      828   procedure partslib-update-by-factord :
      829     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      830     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      831     define input parameter p-artic              like ub.parts.artic     no-undo .
      832     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      833     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      834     define input parameter p-start-fact-order   as decimal   no-undo .
      835     define input parameter p-end-fact-order     as decimal   no-undo .
      836     define input parameter p-lock-gds-obj       as logical   no-undo .
      837     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      838     define buffer buf_gds-obj  for ub.gds-obj .
      839     define buffer buf_doc-line for ub.doc-line .
      840     define variable v-total-parts-qnty as decimal   no-undo .
      841     define variable v-goods-gds-goods  as logical   no-undo .
      842     define variable v-goods-twounit    as logical   no-undo .
      843     do
      844     on error undo, return error
      845     :
      846       if p-start-fact-order > p-end-fact-order
      847       then do:
      848         message
      849           vss-workfile vss-revision vss-description skip
      850           vss-include-info5 skip
      851           "Ошибка задания входных параметров" skip
      852           "Начало интервала превышает конец интервала" skip
      853           "Объект" p-obj-type p-obj-code skip
      854           "Артикул" p-artic p-prod-type p-prod-code skip
      855           "p-start-fact-order" p-start-fact-order skip
      856           "p-end-fact-order"   p-end-fact-order skip
      857           view-as alert-box error .
      858         undo, return error .
      859       end.
      860       if p-lock-gds-obj = true
      861       then do:
      862         do transaction
      863         on error undo, return error
      864         :
      865   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      867     (input  p-obj-type
      868     ,input  p-obj-code
      869     ,input  p-artic
      870     ,input  p-prod-type
      871     ,input  p-prod-code
      872     ,buffer buf_gds-obj
      873     ) no-error .
      874           if error-status :error
      875           then do:
      876             message
      877               vss-workfile vss-revision vss-description skip
      878               vss-include-info5 skip
      879               "Невозможно найти gds-obj" skip
      880               error-status :get-message(1) skip
      881               return-value skip
      882               view-as alert-box error .
      883             undo, return error .
      884           end.
      885           find current buf_gds-obj exclusive-lock .
      886         end.
      887       end.
      888   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      890     (input  p-artic
      891     ,input  p-prod-type
      892     ,input  p-prod-code
      893     ,input  'gds-goods=request':u
      894     ,output v-goods-gds-goods
      895     ) no-error .
      896       if error-status :error
      897       then do:
      898         message
      899           vss-workfile vss-revision vss-description skip
      900           vss-include-info5 skip
      901           "Ошибка при определении атрибута товара" skip
      902           "Артикул" p-artic p-prod-type p-prod-code skip
      903           "gds-goods=request" skip
      904           error-status :get-message(1) skip
      905           return-value skip
      906           view-as alert-box error .
      907         undo, return error return-value .
      908       end.
      909   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      911     (input  p-artic
      912     ,input  p-prod-type
      913     ,input  p-prod-code
      914     ,input  'twounit=request':u
      915     ,output v-goods-twounit
      916     ) no-error .
      917       if error-status :error
      918       then do:
      919         message
      920           vss-workfile vss-revision vss-description skip
      921           vss-include-info5 skip
      922           "Ошибка при определении атрибута товара" skip
      923           "Артикул" p-artic p-prod-type p-prod-code skip
      924           "twounit=request" skip
      925           error-status :get-message(1) skip
      926           return-value skip
      927           view-as alert-box error .
      928         undo, return error return-value .
      929       end.
      930       for each buf_doc-line no-lock
      931         where buf_doc-line.obj-type   = p-obj-type
      932           and buf_doc-line.obj-code   = p-obj-code
      933           and buf_doc-line.artic      = p-artic
      934           and buf_doc-line.prod-type  = p-prod-type
      935           and buf_doc-line.prod-code  = p-prod-code
      936           and buf_doc-line.status_    = 'факт':U
      937           and buf_doc-line.fact-order > p-start-fact-order
      938           and buf_doc-line.fact-order <= p-end-fact-order
      939       on error undo, return error
      940       :
      941         run partslib-process-document in this-procedure
      942           (input  buf_doc-line.doc-code
      943           ,input  p-obj-type
      944           ,input  p-obj-code
      945           ,input  p-artic
      946           ,input  p-prod-type
      947           ,input  p-prod-code
      948           ,input  v-goods-gds-goods
      949           ,input  v-goods-twounit
      950           ,output v-total-parts-qnty
      951           ) no-error .
      952         if error-status :error
      953         then do:
      954           message
      955             vss-workfile vss-revision vss-description skip
      956             vss-include-info5 skip
      957             "Ошибка при вызове процедуры partslib-process-document" skip
      958             "Документ" buf_doc-line.doc-code skip
      959             "Объект" p-obj-type p-obj-code skip
      960             "Артикул" p-artic p-prod-type p-prod-code skip
      961             "p-start-fact-order" p-start-fact-order skip
      962             "p-end-fact-order" p-end-fact-order skip
      963             error-status :get-message(1) skip
      964             return-value skip
      965             view-as alert-box error .
      966           undo, return error return-value .
      967         end.
      968       end.
      969     end.
      970   end procedure.
      971   procedure partslib-process-document :
      972     define input  parameter p-doc-code         as character no-undo .
      973     define input  parameter p-obj-type         as character no-undo .
      974     define input  parameter p-obj-code         as integer   no-undo .
      975     define input  parameter p-artic            as character no-undo .
      976     define input  parameter p-prod-type        as character no-undo .
      977     define input  parameter p-prod-code        as integer   no-undo .
      978     define input  parameter p-goods-gds-goods  as logical   no-undo .
      979     define input  parameter p-goods-twounit    as logical   no-undo .
      980     define output parameter p-total-parts-qnty as decimal   no-undo .
      981     define variable v-parts-sign as integer   no-undo .
      982     define buffer buf_trn-doc    for ub.trn-doc .
      983     define buffer buf_doc-line   for ub.doc-line .
      984     define buffer buf_parts      for ub.parts .
      985     define buffer buf_temp-parts for temp-parts .
      986     do
      987     on error undo, return error return-value
      988     :
      989       find first buf_trn-doc no-lock
      990         where buf_trn-doc.doc-code = p-doc-code
      991         no-error .
      992       if not available buf_trn-doc
      993       then do:
      994         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      995                                      ,p-doc-code
      996                                      ) .
      997       end.
      998       case buf_trn-doc.doc-type
      999       :
     1000         when 'при':U or
     1001         when 'возврат':U or
     1002         when 'инв':U
     1003         then do:
     1004           assign
     1005             v-parts-sign = -1
     1006           .
     1007         end.
     1008         when 'рас':U or
     1009         when 'спи':U
     1010         then do:
     1011           assign
     1012             v-parts-sign = 1
     1013           .
     1014         end.
     1015         otherwise do:
     1016           undo, return error substitute("Неизвестный тип документа &1"
     1017                                       ,buf_trn-doc.doc-type
     1018                                       ) .
     1019         end.
     1020       end.
     1021       find first buf_doc-line no-lock
     1022         where buf_doc-line.doc-code  = p-doc-code
     1023           and buf_doc-line.artic     = p-artic
     1024           and buf_doc-line.prod-type = p-prod-type
     1025           and buf_doc-line.prod-code = p-prod-code
     1026         no-error .
     1027       if not available buf_doc-line
     1028       then do:
     1029         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1030                                      ,p-doc-code
     1031                                      ,artic
     1032                                      ,prod-type
     1033                                      ,prod-code
     1034                                      ) .
     1035       end.
     1036       assign
     1037         p-total-parts-qnty = 0
     1038       .
     1039       if p-goods-gds-goods = true
     1040       then do:
     1041         for each buf_parts no-lock
     1042           where buf_parts.out-code  = p-doc-code
     1043             and buf_parts.obj-type  = p-obj-type
     1044             and buf_parts.obj-code  = p-obj-code
     1045             and buf_parts.artic     = p-artic
     1046             and buf_parts.prod-type = p-prod-type
     1047             and buf_parts.prod-code = p-prod-code
     1048         on error undo, return error
     1049         :
     1050           run partslib-create-temp-parts in this-procedure
     1051             (buffer buf_parts
     1052             ,buffer buf_temp-parts
     1053             ,input  p-goods-twounit
     1054             ) .
     1055           assign
     1056             p-total-parts-qnty        = p-total-parts-qnty
     1057                                       + v-parts-sign * buf_parts.fact-qnty
     1058             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1059                                       + v-parts-sign * buf_parts.fact-qnty
     1060             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1061                                       + v-parts-sign * buf_parts.fact-qnty
     1062             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1063                                       + v-parts-sign * buf_parts.cli-qnty
     1064           .
     1065           if buf_temp-parts.qnty = 0
     1066           then do:
     1067             delete buf_temp-parts .
     1068           end.
     1069         end.
     1070       end.
     1071       else do:
     1072         assign
     1073           p-total-parts-qnty = p-total-parts-qnty
     1074                              + v-parts-sign * buf_doc-line.fact-qnty
     1075         .
     1076       end.
     1077     end.
     1078   end procedure.
     1079   procedure partslib-init-temp-parts-by-date :
     1080     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1081     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1082     define input parameter p-artic           like ub.parts.artic     no-undo .
     1083     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1084     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1085     define input parameter p-fact-date       as date      no-undo .
     1086     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1087     do
     1088     on error undo, return error
     1089     :
     1090       define variable v-fact-order                as decimal   no-undo .
     1091       define variable v-shift-end-fact-order      as decimal   no-undo .
     1092       define variable v-day-end-fact-order        as decimal   no-undo .
     1093       run factord in this-procedure
     1094         (input  p-fact-date
     1095         ,input  1
     1096         ,input  1
     1097         ,input  ?
     1098         ,input  0
     1099         ,input  false
     1100         ,output v-fact-order
     1101         ,output v-shift-end-fact-order
     1102         ,output v-day-end-fact-order
     1103         ) no-error .
     1104       if error-status :error
     1105       then do:
     1106         message
     1107           vss-workfile vss-revision vss-description skip
     1108           vss-include-info5 skip
     1109           "Ошибка при определении момента времени, на который требуется остаток" skip
     1110           "Объект" p-obj-type p-obj-code skip
     1111           "Артикул" p-artic p-prod-type p-prod-code skip
     1112           "Дата" p-fact-date skip
     1113           view-as alert-box error .
     1114         undo, return error .
     1115       end.
     1116       run partslib-init-temp-parts-by-factord in this-procedure
     1117         (input p-obj-type
     1118         ,input p-obj-code
     1119         ,input p-artic
     1120         ,input p-prod-type
     1121         ,input p-prod-code
     1122         ,input v-day-end-fact-order
     1123         ,input false
     1124         ) no-error .
     1125       if error-status :error
     1126       then do:
     1127         message
     1128           vss-workfile vss-revision vss-description skip
     1129           vss-include-info5 skip
     1130           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1131           "Объект" p-obj-type p-obj-code skip
     1132           "Артикул" p-artic p-prod-type p-prod-code skip
     1133           "Дата" p-fact-date skip
     1134           view-as alert-box error .
     1135         undo, return error .
     1136       end.
     1137     end.
     1138   end procedure.
     1139   procedure partslib-calc-cost :
     1140     define output parameter p-fact-qnty      as decimal   no-undo .
     1141     define output parameter p-vat-pc         as decimal   no-undo .
     1142     define output parameter p-slt-pc         as decimal   no-undo .
     1143     define output parameter p-sum-base       as decimal   no-undo .
     1144     define output parameter p-sum-rubl       as decimal   no-undo .
     1145     define output parameter p-vat-base       as decimal   no-undo .
     1146     define output parameter p-vat-rubl       as decimal   no-undo .
     1147     define output parameter p-slt-base       as decimal   no-undo .
     1148     define output parameter p-slt-rubl       as decimal   no-undo .
     1149     define output parameter p-road-tax-base  as decimal   no-undo .
     1150     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1151     define output parameter p-transport-base as decimal   no-undo .
     1152     define output parameter p-transport-rubl as decimal   no-undo .
     1153     define output parameter p-other-base     as decimal   no-undo .
     1154     define output parameter p-other-rubl     as decimal   no-undo .
     1155     define output parameter p-excise-base    as decimal   no-undo .
     1156     define output parameter p-excise-rubl    as decimal   no-undo .
     1157     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1158     do
     1159     on error undo, return error return-value
     1160     :
     1161       define buffer buf_temp-parts for temp-parts .
     1162       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1163       define buffer   in-vatp-parts    for ub.parts   .
     1164       define buffer   in-vatp-doc      for ub.trn-doc .
     1165       define buffer   in-vatp-goods    for ub.goods   .
     1166       define buffer   in-vatp-sysconf  for ub.sysconf .
     1167       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1168       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1169       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1170       define variable varinvprb                  as   character              no-undo.
     1171       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1172       define variable cli-base-rate              as   decimal                no-undo.
     1173       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1174       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1175       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1176       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1177       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1178       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1179       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1180       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1181       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1182       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1183       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1184       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1185       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1186       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1187       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1188       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1189       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1190       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1191       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1192       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1193       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1194       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1195       define variable varinvatp-envd             as   character              no-undo.
     1196       define variable varinvatp-type             as   character              no-undo.
     1197       for each buf_temp-parts
     1198       on error undo, return error
     1199       :
     1200   assign
     1201     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1202     price-base-with-tax-loc = buf_temp-parts.price-base
     1203   .
     1204   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1205   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1206     (output varinvprb
     1207     )  .
     1208     if buf_temp-parts.out-code = 'free-zone':U     or
     1209        buf_temp-parts.out-code = 'out-zone':U   or
     1210        buf_temp-parts.doc-type = 'акт':U then do:
     1211       assign
     1212         in-vatp-have-vat-slt = yes.
     1213     end.
     1214     else do:
     1215       find first in-vatp_doc-attr no-lock
     1216         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1217           and in-vatp_doc-attr.attr-code = 'envd':U
     1218         no-error .
     1219       if not available in-vatp_doc-attr then do:
     1220         assign
     1221           in-vatp-have-vat-slt = yes.
     1222       end.
     1223       else do:
     1224            in-vatp-have-vat-slt = no.
     1225       end.
     1226     end.
     1227     assign
     1228      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1229      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1230     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1231              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1232     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1233             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1234             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1235             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1236             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1237             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1238             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1239       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1240     assign
     1241       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1242     assign
     1243       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1244       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1245       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1246       transport-cli-loc  = 0
     1247       other-cli-loc      = 0
     1248     .
     1249   ASSIGN
     1250             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1251       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1252   .
     1253         assign
     1254           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1255           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1256           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1257           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1258           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1259           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1260           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1261           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1262           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1263           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1264           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1265           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1266           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1267           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1268           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1269           p-excise-base    = p-excise-base    + 0
     1270           p-excise-rubl    = p-excise-rubl    + 0
     1271         .
     1272       end.
     1273       if p-fact-qnty      = ?
     1274       or p-sum-base       = ?
     1275       or p-sum-rubl       = ?
     1276       or p-vat-base       = ?
     1277       or p-vat-rubl       = ?
     1278       or p-slt-base       = ?
     1279       or p-slt-rubl       = ?
     1280       or p-road-tax-base  = ?
     1281       or p-road-tax-rubl  = ?
     1282       or p-transport-base = ?
     1283       or p-transport-rubl = ?
     1284       or p-other-base     = ?
     1285       or p-other-rubl     = ?
     1286       or p-excise-base    = ?
     1287       or p-excise-rubl    = ?
     1288       then do:
     1289         message
     1290           vss-workfile vss-revision vss-description skip
     1291           vss-include-info5 skip
     1292           "Программа in-vatp.i вернула неопределенные значения" skip
     1293           "p-fact-qnty"      p-fact-qnty      skip
     1294           "p-sum-base"       p-sum-base       skip
     1295           "p-sum-rubl"       p-sum-rubl       skip
     1296           "p-vat-base"       p-vat-base       skip
     1297           "p-vat-rubl"       p-vat-rubl       skip
     1298           "p-slt-base"       p-slt-base       skip
     1299           "p-slt-rubl"       p-slt-rubl       skip
     1300           "p-road-tax-base"  p-road-tax-base  skip
     1301           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1302           "p-transport-base" p-transport-base skip
     1303           "p-transport-rubl" p-transport-rubl skip
     1304           "p-other-base"     p-other-base     skip
     1305           "p-other-rubl"     p-other-rubl     skip
     1306           "p-excise-base"    p-excise-base    skip
     1307           "p-excise-rubl"    p-excise-rubl    skip
     1308           view-as alert-box error .
     1309         undo, return error .
     1310       end.
     1311     end.
     1312   end procedure.
     1313   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1314   define variable v-waitfram-action01         as character   no-undo .
     1315   define variable v-waitfram-action02         as character   no-undo .
     1316   define variable v-waitfram-action03         as character   no-undo .
     1317   define variable mWaitFramTextBeg            as character   no-undo.
     1318   define variable mWaitFramTextEnd            as character   no-undo.
     1319   define variable mWaitFramView               as logical     no-undo.
     1320   define variable mWaitProcEvent              as logical     no-undo init yes.
     1321   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1322   define variable mWaitFramStop               as logical     no-undo.
     1323   define variable mWaitFramStopUser           as logical     no-undo.
     1324   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1325   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1326   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1327   define button B-WaitFramStop auto-end-key
     1328        label "Стоп"
     1329        size 10 by 1 tooltip "Остоновить процесс".
     1330   define button B-viewProcInfo
     1331        label "Информация"
     1332        size 15 by 1 tooltip "Информация о процесс".
     1333   define frame waitfram
     1334     v-waitfram-action01 format "x(72)" no-label skip
     1335     v-waitfram-action02 format "x(72)" no-label skip
     1336     v-waitfram-action03 format "x(72)" no-label skip
     1337     B-viewProcInfo
     1338     B-WaitFramStop at row 4 col 30
     1339     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1340     .
     1341   define new global shared variable mBatchMode as logical no-undo init ?.
     1342   define variable mFramBachModHandle as handle no-undo.
     1343   mFramBachModHandle = frame waitfram:handle.
     1344   define variable mFameOldVis as logical no-undo.
     1345   define variable mVisCUrentVin as logical no-undo.
     1346   if session:batch-mode
     1347   then
     1348      mBatchMode = yes.
     1349   if mBatchMode = ? then do:
     1350     mVisCUrentVin = current-window:visible.
     1351     mFameOldVis = mFramBachModHandle:visible.
     1352     mFramBachModHandle:visible  = yes.
     1353     mBatchMode = mFramBachModHandle:visible ne yes.
     1354     mFramBachModHandle:visible = mFameOldVis.
     1355     current-window:visible = mVisCUrentVin.
     1356   end.
     1357    if  log-manager:logfile-name ne ?
     1358     then DO:
     1359         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1360         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1361         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1362     end.
     1363   on choose of B-WaitFramStop in frame waitfram
     1364   do:
     1365     mWaitFramStop = yes.
     1366     mWaitFramStopUser = yes.
     1367   end.
     1368   function waitfram-check-timeout returns logical():
     1369      define variable vtime as int64 no-undo.
     1370      if mWaitFramStopTimeOut
     1371      then
     1372         return yes.
     1373      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1374      if     mWaitFramTimeOut ne ?
     1375         and mWaitFramTimeOut ne 0
     1376         and mWaitFramTimeOut lt vtime
     1377      then do:
     1378         mWaitFramStopTimeOut = yes.
     1379      end.
     1380      return mWaitFramStopTimeOut.
     1381   end.
     1382   procedure waitfram-hide :
     1383     if not session:batch-mode
     1384     then do
     1385     on error undo, return error return-value
     1386     :
     1387       pause 0 before-hide .
     1388       if not mBatchMode then
     1389         hide frame waitfram .
     1390     if     not mWaitFramView
     1391        and mWaitProcEvent
     1392     then
     1393       process events .
     1394     end.
     1395   end procedure.
     1396   procedure waitfram-show :
     1397     define input  parameter p-message as character no-undo .
     1398     define variable v-left-margin as integer   no-undo .
     1399     if not session:batch-mode
     1400     then do
     1401     on error undo, return error return-value
     1402     :
     1403       if length(p-message) <= 70 then do:
     1404         assign
     1405           v-left-margin = integer((70 - length(p-message)) / 2)
     1406         .
     1407         assign
     1408           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1409         .
     1410         assign
     1411           v-waitfram-action01 = " "
     1412           v-waitfram-action02 = " "
     1413                                    + fill(" ", v-left-margin)
     1414                                    + p-message
     1415           v-waitfram-action03 = " "
     1416         .
     1417       end.
     1418       else do:
     1419         define variable vRindex1 as integer no-undo.
     1420         define variable vRindex2 as integer no-undo.
     1421         vRindex1 = r-index(p-message," ",70).
     1422         if vRindex1 = 0
     1423         then
     1424            vRindex1 = 70.
     1425         if length(p-message)  <= vRindex1 + 70 then do:
     1426           assign
     1427             v-waitfram-action01 = " "
     1428             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1429             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1430           .
     1431         end.
     1432         else do:
     1433           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1434           if vRindex2 <= vRindex1
     1435           then
     1436              vRindex2 = vRindex1 + 70.
     1437           assign
     1438             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1439             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1440             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1441           .
     1442         end.
     1443       end.
     1444       B-viewProcInfo:visible   in frame waitfram = no.
     1445       B-viewProcInfo:sensitive in frame waitfram = no.
     1446       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1447       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1448       if  (   mWaitFramView
     1449          or  mWaitProcEvent)
     1450          and not mBatchMode
     1451       then
     1452          display
     1453             v-waitfram-action01 skip
     1454             v-waitfram-action02 skip
     1455             v-waitfram-action03 skip
     1456          with frame waitfram .
     1457       if     mWaitFramView
     1458          then do:
     1459             if     mWaitFramInterval ne ?
     1460                and not mBatchMode
     1461             then
     1462                wait-for go of frame waitfram pause mWaitFramInterval.
     1463          end.
     1464          else
     1465             if     mWaitProcEvent
     1466                and not mBatchMode
     1467             then
     1468                process events .
     1469     end.
     1470   end procedure.
     1471      procedure waitfram-show-this:
     1472         define input  parameter iInterval as int64 no-undo.
     1473         define variable vtime as int64 no-undo.
     1474         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1475         mWaitFramInterval = iInterval.
     1476         run waitfram-show (substitute("&1&2 &3&4" ,
     1477                                       mWaitFramTextBeg ,
     1478                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1479                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1480                                       mWaitFramTextEnd
     1481                                      )
     1482                           ).
     1483      end.
     1484      procedure WaitFramRunPause:
     1485         define input  parameter iInterval as dec no-undo.
     1486         define variable vStart  as datetime-tz no-undo.
     1487         define variable vend    as datetime-tz no-undo.
     1488         define variable vint as int64 no-undo.
     1489         define variable vOk as logical no-undo.
     1490         vStart = now.
     1491         vend   = vStart.
     1492         publish "WaitFramPause" (iInterval,output vOk).
     1493         vend   =  now.
     1494         vint = vend - vStart.
     1495         vint = iInterval - vint / 1000.
     1496         if     not mWaitFramStop
     1497            and (   vint > 0
     1498                 or (    not vOk
     1499                     and iInterval eq ?
     1500                     )
     1501                 )
     1502         then
     1503            run waitfram-show-this (iInterval).
     1504         vend   =  now.
     1505         vint = vend - vStart.
     1506         vint = iInterval - vint / 1000.
     1507         if     not mWaitFramStop
     1508            and vint > 0
     1509         then do:
     1510            run gbl/pause.p (vint * 1000).
     1511         end.
     1512         if iInterval ne ?
     1513         then
     1514            publish "WaitFramStop".
     1515         waitfram-check-timeout().
     1516      end.
     1517      procedure WaitFramWaitFor:
     1518         define input  parameter iInterval as dec no-undo.
     1519         assign
     1520            mWaitFramStartProc   = now
     1521            mWaitFramStopUser    = no
     1522            mWaitFramStopTimeOut = no
     1523         .
     1524         block-wait:
     1525         do while not mWaitFramStop:
     1526            run WaitFramRunPause (iInterval).
     1527            if  waitfram-check-timeout()
     1528            then do:
     1529               leave block-wait.
     1530            end.
     1531         end.
     1532         run waitfram-hide.
     1533      end.
     1534   procedure waitfram-join :
     1535     define input  parameter p-line-1  as character no-undo .
     1536     define input  parameter p-line-2  as character no-undo .
     1537     define input  parameter p-line-3  as character no-undo .
     1538     define output parameter p-message as character no-undo .
     1539     do
     1540     on error undo, return error return-value
     1541     :
     1542       assign
     1543         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1544                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1545                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1546       .
     1547     end.
     1548   end procedure.
     1549   function waitfram-join-function returns character
     1550     (input p-line-1 as character
     1551     ,input p-line-2 as character
     1552     ,input p-line-3 as character
     1553     ).
     1554     define variable v-message as character no-undo .
     1555     run waitfram-join in this-procedure
     1556       (input  p-line-1
     1557       ,input  p-line-2
     1558       ,input  p-line-3
     1559       ,output v-message
     1560       ) .
     1561     return v-message .
     1562   end function .
     1563   DEFINE VARIABLE v_os-file   AS CHAR NO-UNDO INIT "".
     1564   DEFINE VARIABLE ll_commit AS LOG    NO-UNDO INIT NO.
     1565   DEFINE VARIABLE file-name as character no-undo .
     1566   define variable varexport-line as integer no-undo.
     1567   DEFINE VARIABLE doc-num like ub.trn-doc.doc-code no-undo.
     1568   DEFINE VARIABLE is-out as decimal no-undo.
     1569   DEFINE VARIABLE is-sale as logical no-undo.
     1570   DEFINE VARIABLE is-ext_expense as logical no-undo.
     1571   DEFINE VARIABLE is-other_expense as logical no-undo.
     1572   DEFINE VARIABLE prt-qnty as decimal no-undo.
     1573   DEFINE VARIABLE my-accum as integer no-undo .
     1574   DEFINE VARIABLE for-part-code like ub.parts.part-code no-undo.
     1575   DEFINE VARIABLE is-twounit as logical no-undo .
     1576   DEFINE VARIABLE first-find as logical no-undo.
     1577   DEFINE VARIABLE v-end-fact-order as decimal no-undo .
     1578   DEFINE VARIABLE v-shift-end-fact-order as decimal no-undo .
     1579   DEFINE VARIABLE v-day-end-fact-order as decimal no-undo .
     1580   DEFINE VARIABLE v-start-fact-order as decimal no-undo .
     1581   DEFINE VARIABLE is-zero as logical no-undo.
     1582   define stream str-file.
     1583   define buffer for-doc for ub.trn-doc.
     1584   define buffer for-line for ub.doc-line.
     1585   define buffer in-parts for ub.parts.
     1586   define buffer b-tt-cst for tt-cst.
     1587   define buffer tt-cst-zero-year for tt-cst-year.
     1588   define temp-table tt-file-ignore no-undo
     1589   field doc-code  like ub.trn-doc.doc-code
     1590   field artic     like ub.goods.artic
     1591   field prod-type like ub.goods.prod-type
     1592   field prod-code like ub.goods.prod-code
     1593   index pi is primary unique
     1594   doc-code
     1595   artic
     1596   prod-type
     1597   prod-code
     1598   .
     1599   file-name = search("ignore.txt").
     1600   if file-name = ? then do:
     1601      message "Не найден файл ignore.txt" skip
     1602              "Попробуйте вручную задать путь к нему"
     1603      view-as alert-box ERROR.
     1604       SYSTEM-DIALOG GET-FILE v_os-file
     1605           TITLE "Выберите файл для импорта ошибочных товаров"
     1606           FILTERS
     1607           " Все текстовые файлы (*.txt) " "*.txt",
     1608           " Все файлы (*.*) "                      "*.*"
     1609           INITIAL-FILTER 1
     1610           DEFAULT-EXTENSION ".txt"
     1611           USE-FILENAME
     1612           MUST-EXIST
     1613           UPDATE ll_commit
     1614           .
     1615       IF ll_commit <> YES THEN do:
     1616          RETURN NO-APPLY.
     1617       end.
     1618       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
     1619           BELL.
     1620           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1621           RETURN NO-APPLY.
     1622       END.
     1623       ASSIGN
     1624       file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) )
     1625       .
     1626   end.
     1627   run waitfram-show in this-procedure ("Чтение файла ignore.txt...") .
     1628   input stream str-file from value(file-name).
     1629   repeat :
     1630     assign varexport-line = varexport-line + 1.
     1631     CREATE tt-file-ignore.
     1632     import stream str-file tt-file-ignore.
     1633     if TRIM(tt-file-ignore.doc-code) = ""
     1634     then delete tt-file-ignore.
     1635     find first ub.trn-doc where
     1636                ub.trn-doc.doc-code = tt-file-ignore.doc-code no-lock no-error.
     1637     if not available ub.trn-doc then do:
     1638        message "В строке № " varexport-line " файла ignore.txt указан номер документа " tt-file-ignore.doc-code " ." skip
     1639                "Данного документа нет в базе данных." skip
     1640                "Исправьте файл ignore.txt."
     1641        view-as alert-box.
     1642        return error.
     1643     end.
     1644     find first ub.goods where
     1645               ub.goods.artic     = tt-file-ignore.artic     and
     1646               ub.goods.prod-type = tt-file-ignore.prod-type and
     1647               ub.goods.prod-code = tt-file-ignore.prod-code no-lock no-error.
     1648     if not available ub.goods then do:
     1649        message "В строке № " varexport-line " файла ignore.txt указан товар: " skip
     1650                "Артикул "           tt-file-ignore.artic     skip
     1651                "Тип производителя " tt-file-ignore.prod-type skip
     1652                "Код производителя " tt-file-ignore.prod-code skip
     1653                "Данного товара нет в базе данных."
     1654                "Исправьте файл ignore.txt."
     1655        view-as alert-box.
     1656        return error.
     1657     end.
     1658   end.
     1659   for each obj-list:
     1660     delete obj-list.
     1661   end.
     1662   FOR EACH tt-cst:
     1663     delete tt-cst.
     1664   END.
     1665   FOR EACH tt-cst-ext:
     1666     delete tt-cst-ext.
     1667   END.
     1668   FOR EACH tt-cst-year:
     1669     delete tt-cst-year.
     1670   END.
     1671   for each ub.shop no-lock where
     1672            ub.shop.host-code = p-host-code:
     1673   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1674   run create_obj-list in this-procedure
     1675    ( input 'маг':U ,
     1676      input ub.shop.obj-code )
     1677      .
     1678   end.
     1679   for each ub.store no-lock where
     1680            ub.store.host-code = p-host-code:
     1681   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   run create_obj-list in this-procedure
     1683    ( input 'скл':U ,
     1684      input ub.store.obj-code )
     1685      .
     1686   end.
     1687   run factord in this-procedure
     1688     (input  X-date-end
     1689     ,input  1
     1690     ,input  1
     1691     ,input  ?
     1692     ,input  0
     1693     ,input  false
     1694     ,output v-end-fact-order
     1695     ,output v-shift-end-fact-order
     1696     ,output v-day-end-fact-order
     1697     ) no-error .
     1698   if error-status:error then return error.
     1699   run factord in this-procedure
     1700     (input  (X-date-start - 1)
     1701     ,input  1
     1702     ,input  1
     1703     ,input  ?
     1704     ,input  0
     1705     ,input  false
     1706     ,output v-end-fact-order
     1707     ,output v-shift-end-fact-order
     1708     ,output v-start-fact-order
     1709     ) no-error .
     1710   if error-status:error then return error.
     1711   run waitfram-show in this-procedure ("Остатки по товарам на объектах фирмы...").
     1712   my-accum = 0.
     1713   _gds-obj:
     1714   FOR EACH obj-list NO-LOCK,
     1715       EACH ub.gds-obj No-LOCK WHERE
     1716            ub.gds-obj.obj-type = obj-list.obj-type AND
     1717            ub.gds-obj.obj-code = obj-list.obj-code:
     1718     find first ub.STK-LINE NO-LOCK where
     1719                ub.STK-LINE.OBJ-TYPE = obj-list.OBJ-TYPE and
     1720                ub.STK-LINE.OBJ-CODE = obj-list.OBJ-CODE and
     1721                ub.stk-line.artic = ub.gds-obj.artic AND
     1722                ub.stk-line.prod-type = ub.gds-obj.prod-type AND
     1723                ub.stk-line.prod-code = ub.gds-obj.prod-code AND
     1724                ub.stk-line.fact-order <= v-day-end-fact-order AND
     1725                ub.stk-line.sum-type = 'crsa':U AND
     1726                ub.stk-line.cat-id = '##,##':U No-ERROR.
     1727     if not avail ub.stk-line then next _gds-obj.
     1728     run partslib-init-temp-parts-by-factord in this-procedure(
     1729                                                           input obj-list.obj-type,
     1730                                                           input obj-list.obj-code,
     1731                                                           input ub.gds-obj.artic,
     1732                                                           input ub.gds-obj.prod-type,
     1733                                                           input ub.gds-obj.prod-code,
     1734                                                           input v-day-end-fact-order,
     1735                                                           input false
     1736                                                           ) .
     1737   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1738   _temp-parts:
     1739   for each temp-parts :
     1740     if temp-parts.is-supp = no or temp-parts.cst-code = "" then next _temp-parts.
     1741     if can-find(first tt-file-ignore where
     1742                       tt-file-ignore.doc-code = temp-parts.in-code AND
     1743                       tt-file-ignore.artic = temp-parts.artic AND
     1744                       tt-file-ignore.prod-type = temp-parts.prod-type AND
     1745                       tt-file-ignore.prod-code = temp-parts.prod-code) then NEXT _temp-parts.
     1746     my-accum = my-accum + 1.
     1747     IF my-accum MODULO 50  = 0 then do:
     1748       run waitfram-show in this-procedure ("Остатки по товарам на объектах фирмы..." + " Обработано " + string(my-accum) + " партий остатков ").
     1749     end.
     1750     find first tt-cst where
     1751                 tt-cst.cst-code = temp-parts.cst-code AND
     1752                 tt-cst.artic = temp-parts.artic AND
     1753                 tt-cst.prod-type = temp-parts.prod-type AND
     1754                 tt-cst.prod-code = temp-parts.prod-code NO-ERROR.
     1755     if not avail tt-cst then do:
     1756       FIND FIRST ub.goods NO-LOCK where
     1757                   ub.goods.artic = temp-parts.artic AND
     1758                   ub.goods.prod-type = temp-parts.prod-type AND
     1759                   ub.goods.prod-code = temp-parts.prod-code No-ERROR.
     1760       if not avail ub.goods then do:
     1761       end.
     1762       FIND FIRST ub.doc-line NO-LOCK WHERE
     1763                   ub.doc-line.doc-code = temp-parts.in-code AND
     1764                   ub.doc-line.artic = temp-parts.artic AND
     1765                   ub.doc-line.prod-type = temp-parts.prod-type AND
     1766                   ub.doc-line.prod-code = temp-parts.prod-code NO-ERROR.
     1767       if not avail ub.doc-line then do:
     1768       end.
     1769       create tt-cst.
     1770       assign
     1771       tt-cst.cst-code = temp-parts.cst-code
     1772       tt-cst.artic = temp-parts.artic
     1773       tt-cst.prod-type = temp-parts.prod-type
     1774       tt-cst.prod-code = temp-parts.prod-code
     1775       tt-cst.nationality = ub.goods.nationality
     1776       tt-cst.name_artic_unit = string(ub.goods.gds-name,
     1777                                       ("X(" + string(41 - 5 - length(ub.goods.artic)) + ")") )
     1778                                             +  chr(32) +
     1779                                 ub.goods.artic + chr(32) +
     1780                                 string(ub.goods.unit-base, "X(3)")
     1781       tt-cst.tnved = ub.goods.tnved
     1782       .
     1783     end.
     1784     assign
     1785     tt-cst.qnty-rest = tt-cst.qnty-rest + temp-parts.fact-qnty
     1786     .
     1787     end.
     1788     run partslib-update-by-factord in this-procedure(
     1789                                                           input obj-list.obj-type,
     1790                                                           input obj-list.obj-code,
     1791                                                           input ub.gds-obj.artic,
     1792                                                           input ub.gds-obj.prod-type,
     1793                                                           input ub.gds-obj.prod-code,
     1794                                                           input v-start-fact-order,
     1795                                                           input v-day-end-fact-order,
     1796                                                           input true
     1797                                                           ) .
     1798   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1799   _temp-parts:
     1800   for each temp-parts :
     1801     if temp-parts.is-supp = no or temp-parts.cst-code = "" then next _temp-parts.
     1802     if can-find(first tt-file-ignore where
     1803                       tt-file-ignore.doc-code = temp-parts.in-code AND
     1804                       tt-file-ignore.artic = temp-parts.artic AND
     1805                       tt-file-ignore.prod-type = temp-parts.prod-type AND
     1806                       tt-file-ignore.prod-code = temp-parts.prod-code) then NEXT _temp-parts.
     1807     my-accum = my-accum + 1.
     1808     IF my-accum MODULO 50  = 0 then do:
     1809       run waitfram-show in this-procedure ("Остатки по товарам на объектах фирмы..." + " Обработано " + string(my-accum) + " партий остатков ").
     1810     end.
     1811     find first tt-cst where
     1812                 tt-cst.cst-code = temp-parts.cst-code AND
     1813                 tt-cst.artic = temp-parts.artic AND
     1814                 tt-cst.prod-type = temp-parts.prod-type AND
     1815                 tt-cst.prod-code = temp-parts.prod-code NO-ERROR.
     1816     if not avail tt-cst then do:
     1817       FIND FIRST ub.goods NO-LOCK where
     1818                   ub.goods.artic = temp-parts.artic AND
     1819                   ub.goods.prod-type = temp-parts.prod-type AND
     1820                   ub.goods.prod-code = temp-parts.prod-code No-ERROR.
     1821       if not avail ub.goods then do:
     1822       end.
     1823       FIND FIRST ub.doc-line NO-LOCK WHERE
     1824                   ub.doc-line.doc-code = temp-parts.in-code AND
     1825                   ub.doc-line.artic = temp-parts.artic AND
     1826                   ub.doc-line.prod-type = temp-parts.prod-type AND
     1827                   ub.doc-line.prod-code = temp-parts.prod-code NO-ERROR.
     1828       if not avail ub.doc-line then do:
     1829       end.
     1830       create tt-cst.
     1831       assign
     1832       tt-cst.cst-code = temp-parts.cst-code
     1833       tt-cst.artic = temp-parts.artic
     1834       tt-cst.prod-type = temp-parts.prod-type
     1835       tt-cst.prod-code = temp-parts.prod-code
     1836       tt-cst.nationality = ub.goods.nationality
     1837       tt-cst.name_artic_unit = string(ub.goods.gds-name,
     1838                                       ("X(" + string(41 - 5 - length(ub.goods.artic)) + ")") )
     1839                                             +  chr(32) +
     1840                                 ub.goods.artic + chr(32) +
     1841                                 string(ub.goods.unit-base, "X(3)")
     1842       tt-cst.tnved = ub.goods.tnved
     1843       .
     1844     end.
     1845     assign
     1846     tt-cst.qnty-start = tt-cst.qnty-start + temp-parts.fact-qnty
     1847     .
     1848     delete temp-parts.
     1849   end.
     1850   end.
     1851   run waitfram-show in this-procedure ("Получение информации по расходам...").
     1852   my-accum = 0.
     1853   FOR EACH obj-list NO-LOCK:
     1854     FOR EACH for-doc No-LOCK WHERE
     1855             for-doc.obj-type = obj-list.obj-type AND
     1856             for-doc.obj-code = obj-list.obj-code AND
     1857             for-doc.fact-date >= X-date-start AND
     1858             for-doc.fact-date <= X-date-end AND
     1859             for-doc.status_ = 'факт':U:
     1860       if for-doc.office then NEXT.
     1861       if LOOKUP(for-doc.ext-doc-type, 'iv,rv,ev':U) > 0 then NEXT.
     1862       assign
     1863       doc-num = for-doc.doc-code
     1864       is-out = if LOOKUP(for-doc.ext-doc-type, 'ie,re,rs,vt,im':U) > 0  then 1 else -1
     1865       is-sale = if lookup(for-doc.ext-doc-type, 'es,rs':U) > 0
     1866                 then yes else no
     1867       is-ext_expense = if lookup(for-doc.ext-doc-type, 'ee':U) > 0
     1868                        then yes else no
     1869       is-other_expense = if lookup(for-doc.ext-doc-type, 'ee':U + chr(44) + 'ie,es,rs':U) = 0
     1870                        then yes else no
     1871       .
     1872   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1873   _for-line:
     1874   FOR  each for-line NO-LOCk WHERE for-line.doc-code = doc-num:
     1875     my-accum = my-accum + 1.
     1876     IF my-accum MODULO 50  = 0 then do:
     1877       run waitfram-show in this-procedure ("Получение информации по расходам..." + " Обработано " + string(my-accum) + " строк документов ").
     1878     end.
     1879     _parts:
     1880     FOR EACH ub.parts NO-LOCK WHERE
     1881             ub.parts.artic = for-line.artic AND
     1882             ub.parts.prod-type = for-line.prod-type AND
     1883             ub.parts.prod-code = for-line.prod-code AND
     1884             ub.parts.out-code = doc-num AND
     1885             ub.parts.obj-type = for-line.obj-type AND
     1886             ub.parts.obj-code = for-line.obj-code:
     1887       if ub.parts.cst-code = "" then NEXT _parts.
     1888       IF ub.parts.is-supp = no  then NEXT _parts.
     1889       if can-find(first tt-file-ignore where
     1890                         tt-file-ignore.doc-code = ub.parts.in-code AND
     1891                         tt-file-ignore.artic = for-line.artic AND
     1892                         tt-file-ignore.prod-type = for-line.prod-type AND
     1893                         tt-file-ignore.prod-code = for-line.prod-code) then NEXT _for-line.
     1894       FIND FIRST tt-cst WHERE
     1895                  tt-cst.cst-code = ub.parts.cst-code AND
     1896                  tt-cst.artic = for-line.artic AND
     1897                  tt-cst.prod-type = for-line.prod-type AND
     1898                  tt-cst.prod-code = for-line.prod-code No-ERROR.
     1899       if not avail tt-cst then do:
     1900         FIND FIRST ub.goods NO-LOCK where
     1901                    ub.goods.artic = for-line.artic AND
     1902                    ub.goods.prod-type = for-line.prod-type AND
     1903                    ub.goods.prod-code = for-line.prod-code No-ERROR.
     1904         if not avail ub.goods then do:
     1905         end.
     1906         create tt-cst.
     1907         assign
     1908         tt-cst.cst-code = parts.cst-code
     1909         tt-cst.artic = for-line.artic
     1910         tt-cst.prod-type = for-line.prod-type
     1911         tt-cst.prod-code = for-line.prod-code
     1912         tt-cst.nationality = ub.goods.nationality
     1913         tt-cst.name_artic_unit = string(ub.goods.gds-name,
     1914                                         ("X(" + string(41 - 5 - length(goods.artic)) + ")") )
     1915                                              +  chr(32) +
     1916                                  ub.goods.artic + chr(32) +
     1917                                  string(ub.goods.unit-base, "X(3)")
     1918         tt-cst.tnved = ub.goods.tnved
     1919         .
     1920       end.
     1921       assign
     1922       prt-qnty =  is-out * ub.parts.fact-qnty
     1923       .
     1924       assign
     1925       tt-cst.qnty-sale = tt-cst.qnty-sale +  (if is-sale then prt-qnty else 0)
     1926       tt-cst.qnty-ext_expence = tt-cst.qnty-ext_expence +  (if is-ext_expense then prt-qnty else 0)
     1927       tt-cst.qnty-other_expence = tt-cst.qnty-other_expence + (if is-other_expense then prt-qnty else 0)
     1928       .
     1929       if is-ext_expense then do:
     1930         create tt-cst-ext.
     1931         assign
     1932         tt-cst-ext.artic = for-line.artic
     1933         tt-cst-ext.prod-type = for-line.prod-type
     1934         tt-cst-ext.prod-code = for-line.prod-code
     1935         tt-cst-ext.cst-code = ub.parts.cst-code
     1936         tt-cst-ext.des = substr(for-doc.PS, 1 , r-index(for-doc.ps, "@":U) - 1)
     1937         tt-cst-ext.qnty = ( - prt-qnty)
     1938         .
     1939       end.
     1940     END.
     1941   END.
     1942     END.
     1943   END.
     1944   run waitfram-show in this-procedure ("Список ГТД, исключенных из отчета...").
     1945   my-accum = 0.
     1946   for each obj-list No-LOCK:
     1947   _zero:
     1948     for each for-doc No-LOCK WHERE
     1949              for-doc.obj-type = obj-list.obj-type AND
     1950              for-doc.obj-code = obj-list.obj-code AND
     1951              for-doc.ext-doc-type = 'ie':U AND
     1952              for-doc.status_ = 'факт':U,
     1953         each for-line No-LOCK WHERE
     1954              for-line.doc-code = for-doc.doc-code,
     1955         each ub.parts No-LOCK WHERE
     1956              ub.parts.artic = for-line.artic AND
     1957              ub.parts.prod-type = for-line.prod-type AND
     1958              ub.parts.prod-code = for-line.prod-code AND
     1959              ub.parts.out-code = for-doc.doc-code AND
     1960              ub.parts.obj-type = for-line.obj-type AND
     1961              ub.parts.obj-code = for-line.obj-code:
     1962       if ub.parts.is-supp = no then next _zero.
     1963       if ub.parts.cst-code = "" then next _zero.
     1964       my-accum = my-accum + 1.
     1965       IF my-accum MODULO 50  = 0 then do:
     1966         run waitfram-show in this-procedure ("Список ГТД, исключенных из отчета..." + " Обработано " + string(my-accum) + " приходных партий ").
     1967       end.
     1968       find first tt-cst where
     1969                  tt-cst.cst-code = ub.parts.cst-code AND
     1970                  tt-cst.artic = ub.parts.artic AND
     1971                  tt-cst.prod-type = ub.parts.prod-type AND
     1972                  tt-cst.prod-code = ub.parts.prod-code NO-ERROR.
     1973       if not avail tt-cst then do:
     1974         if can-FIND(FIRST tt-file-ignore No-LOCK WHERE
     1975                           tt-file-ignore.doc-code = for-doc.doc-code AND
     1976                           tt-file-ignore.artic = for-line.artic AND
     1977                           tt-file-ignore.prod-type = for-line.prod-type AND
     1978                           tt-file-ignore.prod-code = for-line.prod-code) then next _zero.
     1979         assign
     1980         is-zero = yes.
     1981       end.
     1982       else do:
     1983         assign
     1984         tt-cst.qnty-income = tt-cst.qnty-income + ub.parts.fact-qnty
     1985         tt-cst.num-place = tt-cst.num-place + for-line.num-place * ub.parts.fact-qnty / for-line.fact-qnty
     1986         tt-cst.brutto = tt-cst.brutto + for-line.wt-brutto * ub.parts.fact-qnty / for-line.fact-qnty
     1987         is-zero = no
     1988         .
     1989       end.
     1990       find first tt-cst-year WHERE
     1991                  tt-cst-year.cst-code = ub.parts.cst-code No-ERROR.
     1992       if not avail tt-cst-year then do:
     1993         create tt-cst-year.
     1994         assign
     1995         tt-cst-year.cst-code = ub.parts.cst-code
     1996         tt-cst-year.in-year = year(for-doc.fact-date)
     1997         tt-cst-year.zero = is-zero
     1998         .
     1999       end.
     2000       else do:
     2001         tt-cst-year.zero = is-zero.
     2002         if tt-cst-year.in-year > year(for-doc.fact-date) then
     2003         tt-cst-year.in-year = year(for-doc.fact-date)
     2004         .
     2005       end.
     2006     end.
     2007   end.
     2008   run waitfram-hide in this-procedure .
