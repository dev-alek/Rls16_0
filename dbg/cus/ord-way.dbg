      156   define variable doc-rec as recid no-undo .
      157   DEFINE BUTTON B-exit AUTO-END-KEY
      158        LABEL "Вы&ход"
      159        SIZE 10 BY 1
      160        BGCOLOR 8 .
      161   DEFINE BUTTON B-Help
      162        LABEL "Помо&щь"
      163        SIZE 10 BY 1
      164        BGCOLOR 8 .
      165   DEFINE BUTTON B-lkp AUTO-END-KEY
      166        LABEL "Просмотр"
      167        SIZE 10 BY 1 TOOLTIP "Просмотр документа"
      168        BGCOLOR 8 .
      169   DEFINE VARIABLE v-artic AS CHARACTER FORMAT "X(256)":U
      170        LABEL "Товар"
      171         VIEW-AS TEXT
      172        SIZE 15.25 BY .67 NO-UNDO.
      173   DEFINE VARIABLE v-prod-code AS INTEGER FORMAT "->>>>>>>>9":U INITIAL 0
      174         VIEW-AS TEXT
      175        SIZE 9.88 BY .67 NO-UNDO.
      176   DEFINE VARIABLE v-prod-type AS CHARACTER FORMAT "XXX":U
      177        LABEL "Пр-ль"
      178         VIEW-AS TEXT
      179        SIZE 4.25 BY .67 NO-UNDO.
      180   DEFINE VARIABLE v-user-name AS CHARACTER FORMAT "X(256)":U
      181        LABEL "Опер"
      182         VIEW-AS TEXT
      183        SIZE 15 BY .67
      184        FGCOLOR 4  NO-UNDO.
      185   DEFINE QUERY br-docs FOR
      186         ub.ord-line,
      187         ub.ord-doc SCROLLING.
      188   DEFINE QUERY Dialog-Frame FOR
      189         ub.goods SCROLLING.
      190   DEFINE BROWSE br-docs
      191     QUERY br-docs NO-LOCK DISPLAY
      192         ub.ord-line.doc-code
      193     ub.ord-doc.doc-type FORMAT "X(2)"
      194     ub.ord-doc.status_
      195     ub.ord-doc.doc-date FORMAT "99/99/99"
      196     ub.ord-line.qnty COLUMN-LABEL "Заказано" FORMAT "->>>>>>>9.<<<"
      197     ub.ord-doc.obj-type  + " " + string (ub.ord-doc.obj-code) COLUMN-LABEL "Объект"      FORMAT "X(10)"
      198     ub.ord-doc.cli-type  + " " + string (ub.ord-doc.cli-code) COLUMN-LABEL "Поставщик"   FORMAT "X(10)"
      199     ub.ord-doc.ship-date COLUMN-LABEL "Поставка"
      200     ub.ord-doc.date-sale-1 COLUMN-LABEL "Продажа с" FORMAT "99/99/99"
      201     ub.ord-doc.date-sale-2 FORMAT "99/99/99"
      202       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.88 BY 11.88.
      203   DEFINE FRAME Dialog-Frame
      204        B-exit AT ROW 1 COL 1
      205        B-lkp AT ROW 1 COL 11
      206        B-Help AT ROW 1.04 COL 89.38
      207        br-docs AT ROW 4.46 COL 1
      208        v-artic AT ROW 2.21 COL 9.25 COLON-ALIGNED
      209        ub.goods.gds-name AT ROW 2.21 COL 25.75 COLON-ALIGNED NO-LABEL
      210              VIEW-AS TEXT
      211             SIZE 67.88 BY .67
      212             FGCOLOR 4
      213        v-prod-type AT ROW 3.13 COL 9.38 COLON-ALIGNED
      214        v-prod-code AT ROW 3.17 COL 14.25 COLON-ALIGNED NO-LABEL
      215        v-user-name AT ROW 16.54 COL 5.5 COLON-ALIGNED WIDGET-ID 2
      216        SPACE(77.49) SKIP(0.25)
      217       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      218            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      219            TITLE "Товары в пути".
      220   ASSIGN
      221          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      222          FRAME Dialog-Frame:HIDDEN           = TRUE.
      223   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      224   DO:
      225     APPLY "END-ERROR":U TO SELF.
      226   END.
      227   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
      228   DO:
      229      define variable ri-list as char no-undo .
      230       define variable old-rep-rec as recid no-undo.
      231       define variable old-doc-rec as recid no-undo.
      232       define variable old-list-mode as character no-undo.
      233   next-prev = no.
      234   br-handle = br-docs:handle.
      235   do while next-prev <> ?:
      236     if not available ub.ord-doc then do:
      237       message "Неправильный выбор документа.".
      238       return no-apply.
      239     end.
      240       find first shar-buf_ord-doc no-lock
      241           where shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code
      242           no-error .
      243          bf-handle = buffer shar-buf_ord-doc:handle in frame Dialog-Frame .
      244      run cus/lkp-zakz.w
      245        ( input parparentproc ,
      246          input-output br-handle ,
      247          input-output bf-handle ,
      248          input-output next-prev
      249        )
      250         no-error.
      251   end.
      252   if br-handle = ? then reposition br-docs to recid doc-rec no-error.
      253   END.
      254   ON VALUE-CHANGED OF br-docs IN FRAME Dialog-Frame
      255   DO:
      256     if available ub.ord-doc then do:
      257   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      259     (input  ub.ord-doc.creid
      260     ,output v-user-name
      261     )  .
      262     end.
      263     display v-user-name  with fram Dialog-Frame .
      264   END.
      265   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      266   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      267   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      268   on help of frame Dialog-Frame
      269   do:
      270     run gbl/app_help.p
      271       (input this-procedure :file-name
      272       ,input ''
      273       ,input ?
      274       ) no-error.
      275     if error-status :error then do:
      276       message
      277         "Ошибка при вызове помощи"
      278         error-status :get-message(1)
      279         view-as alert-box .
      280     end.
      281   end.
      282   run minbtn-set in this-procedure .
      283   on choose of b-help in frame Dialog-Frame
      284   do:
      285     apply "help":u to frame Dialog-Frame .
      286   end.
      287   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      288   procedure minbtn-set :
      289       do
      290           on error undo, return error return-value
      291           :
      292           define variable ii              as integer       no-undo .
      293           define variable fh              as widget-handle no-undo .
      294           define variable hh              as widget-handle no-undo .
      295           define variable v-h             as handle        extent 4 no-undo .
      296           define variable v-name-button   as character     no-undo .
      297           define variable v-help-old-x    as decimal       no-undo .
      298           define variable v-help-old-y    as decimal       no-undo .
      299           define variable v-help-old-size as decimal       no-undo .
      300           define variable v-frame-width   as decimal       no-undo .
      301           define variable jj              as integer       no-undo .
      302           do
      303               on error undo, return error
      304               :
      305               assign
      306                   v-frame-width = frame Dialog-Frame:width - 0.3
      307                   fh            = frame Dialog-Frame:first-child
      308                   hh            = fh:first-child
      309                   ii            = 1
      310                   .
      311               do while valid-handle(hh):
      312                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      313                   do:
      314                       case lc(hh:name) :
      315                           when "b-help" then
      316                               do:
      317                                   hh:load-image-up("cmp/b-help.bmp":u) .
      318                                   hh:load-image-down("cmp/b-help.bmp":u) .
      319                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      320                                   hh:TOOLTIP = "Помощь" .
      321                                   v-help-old-x = hh:column .
      322                                   v-help-old-y = hh:row    .
      323                                   v-help-old-size = hh:width .
      324                                   hh:width-chars = 2.5 .
      325                               end.
      326                           when "b-print" then
      327                               do:
      328                                   hh:load-image("cmp/b-print.bmp":u) .
      329                                   hh:TOOLTIP = "Печать" .
      330                                   v-h[ii] = hh:handle .
      331                                   ii = ii + 1 .
      332                                   hh:width-chars = 3 .
      333                               end.
      334                           when "b-history" or
      335                           when "b-hist" then
      336                               do:
      337                                   hh:load-image("cmp/b-hist.bmp":u) .
      338                                   hh:TOOLTIP = "История" .
      339                                   v-h[ii] = hh:handle .
      340                                   ii = ii + 1 .
      341                                   hh:width-chars = 3 .
      342                               end.
      343                           when "b-sch" then
      344                               do:
      345                                   hh:load-image("cmp/b-sch.bmp":u) .
      346                                   hh:TOOLTIP = "Установка Фильтра" .
      347                                   v-h[ii] = hh:handle .
      348                                   ii = ii + 1 .
      349                                   hh:width-chars = 3 .
      350                               end.
      351                           when "b-hist-user" then
      352                               do:
      353                                   hh:load-image("cmp/b-hist.bmp":u) .
      354                                   hh:TOOLTIP = "История пользователя" .
      355                                   ii = ii + 1 .
      356                               end.
      357                       end case.
      358                   end.
      359                   hh = hh:next-sibling.
      360               end.
      361               b-help:column = v-frame-width - b-help:width-chars.
      362               jj = 0.
      363               repeat ii = 4 to 1 by -1 :
      364                   if valid-handle (v-h[ii] ) then
      365                   do:
      366                       jj  = jj + 1 .
      367                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      368                       v-h[ii]:row    = v-help-old-y .
      369                   end.
      370               end.
      371           end.
      372       end.
      373   end procedure.
      374   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      375   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      376   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      377   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      378   define variable v-diasize-current-frame-width  as decimal   no-undo .
      379   define variable v-diasize-current-frame-height as decimal   no-undo .
      380   define variable v-diasize-change-size          as logical   no-undo .
      381   define variable v-diasize-resize-button        as handle    no-undo .
      382   define variable v-diasize-wndmax               as logical   no-undo .
      383   define variable v-diasize-wndstore             as logical   no-undo .
      384   define variable v-diasize-proc-name            as character no-undo .
      385   define variable v-diasize-browse-handle        as handle    no-undo .
      386   define variable v-diasize-browse-number        as integer   no-undo .
      387   define variable v-diasize-need-full-display    as logical   no-undo init false .
      388   define temp-table temp-diasize-handle no-undo
      389     field handle-value  as handle
      390     field save-position as decimal
      391     index xpk is primary unique handle-value
      392     .
      393   define temp-table temp-browse-handle no-undo
      394     field browse-type   as character
      395     field browse-number as integer
      396     field browse-handle as handle
      397     field original-size as decimal
      398     index xpk is primary unique browse-type browse-number
      399     index xie browse-type browse-handle
      400   .
      401   procedure diasize_change-height :
      402     define input  parameter p-change-value  as decimal   no-undo .
      403     define input  parameter p-move-resize   as logical   no-undo .
      404     define variable v-field-group-handle    as handle    no-undo .
      405     define variable v-object-handle         as handle    no-undo .
      406     define variable v-frame-height          as decimal   no-undo .
      407     define variable v-frame-virtual-height  as decimal   no-undo .
      408     define variable v-browse-height         as decimal   no-undo .
      409     define variable v-window-height         as decimal   no-undo .
      410     define variable v-window-virtual-height as decimal   no-undo .
      411     define variable v-change-sign           as integer   no-undo .
      412     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      413     define buffer buf_temp-browse-handle  for temp-browse-handle .
      414     if p-change-value > 0
      415     then do:
      416       if frame Dialog-Frame :height + p-change-value
      417           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      418       then do:
      419         assign
      420           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      421                           - (frame Dialog-Frame :height-chars)
      422         .
      423         if p-change-value <= 0
      424         then do:
      425           run diasize_position-resize-button in this-procedure .
      426           return .
      427         end.
      428       end.
      429     end.
      430     if p-change-value < 0
      431     then do:
      432       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      433       then do:
      434         assign
      435           p-change-value = v-diasize-orig-frame-height
      436                          - (frame Dialog-Frame :height-chars)
      437         .
      438         if p-change-value >= 0
      439         then do:
      440           run diasize_position-resize-button in this-procedure .
      441           return .
      442         end.
      443       end.
      444     end.
      445     if p-change-value >= 0
      446     then do:
      447       assign
      448         v-change-sign = 1
      449       .
      450     end.
      451     else do:
      452       assign
      453         v-change-sign = -1
      454       .
      455     end.
      456     assign
      457       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      458     .
      459     if p-change-value = 0
      460     then do:
      461       run diasize_position-resize-button in this-procedure .
      462       return .
      463     end.
      464     move_block:
      465     do
      466     on error undo move_block, retry move_block
      467     :
      468       if retry
      469       then do:
      470         do
      471         on error undo move_block, leave move_block
      472         :
      473           if p-change-value > 0
      474           then do:
      475             for each buf_temp-diasize-handle
      476             on error undo, next
      477             :
      478               assign
      479                 v-object-handle = buf_temp-diasize-handle.handle-value
      480               .
      481               if v-object-handle <> v-diasize-resize-button
      482               then do:
      483                 assign
      484                   v-object-handle :row = buf_temp-diasize-handle.save-position
      485                 .
      486               end.
      487             end.
      488             assign
      489               v-diasize-browse-handle :height = v-browse-height
      490             .
      491             for each buf_temp-browse-handle
      492               where buf_temp-browse-handle.browse-type = 'height':u
      493             on error undo, next
      494             :
      495               assign
      496                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      497               .
      498             end.
      499             assign
      500               frame Dialog-Frame :height = v-frame-height
      501             .
      502             if frame Dialog-Frame :scrollable = true
      503             then do:
      504               assign
      505                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      506               .
      507             end.
      508             run diasize_position-resize-button in this-procedure .
      509           end.
      510           else do:
      511             if frame Dialog-Frame :scrollable = true
      512             then do:
      513               assign
      514                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      515               .
      516             end.
      517             assign
      518               frame Dialog-Frame :height = v-frame-height
      519             .
      520             assign
