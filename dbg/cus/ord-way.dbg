      605                 buf_temp-diasize-handle.handle-value  = v-object-handle
      606                 buf_temp-diasize-handle.save-position = v-object-handle :row
      607               .
      608             end.
      609           end.
      610           assign
      611             v-object-handle = v-object-handle :next-sibling
      612           .
      613         end.
      614         assign
      615           v-field-group-handle = v-field-group-handle :next-sibling
      616         .
      617       end.
      618       do with frame Dialog-Frame
      619       :
      620         hide v-diasize-resize-button .
      621         assign
      622           v-diasize-resize-button :row    = 1
      623           v-diasize-resize-button :column = 1
      624         .
      625       end.
      626       if p-change-value > 0
      627       then do:
      628         if frame Dialog-Frame :scrollable = true
      629         then do:
      630           assign
      631             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      632             no-error .
      633           if error-status :error
      634           or error-status :get-message(1) <> ""
      635           then do:
      636             undo move_block, retry move_block .
      637           end.
      638         end.
      639         assign
      640           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
