      800     define buffer buf_temp-browse-handle  for temp-browse-handle .
      801     if p-change-value > 0
      802     then do:
      803       if frame Dialog-Frame :width + p-change-value >
      804           session :width-chars
      805       then do:
      806         assign
      807           p-change-value = session :width-chars - frame Dialog-Frame :width
      808         .
      809         if p-change-value <= 0
      810         then do:
      811           run diasize_position-resize-button in this-procedure .
      812           return .
      813         end.
      814       end.
      815     end.
      816     if p-change-value < 0
      817     then do:
      818       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      819       then do:
      820         assign
      821           p-change-value = v-diasize-orig-frame-width
      822                          - frame Dialog-Frame :width
      823         .
      824         if p-change-value >= 0
      825         then do:
      826           run diasize_position-resize-button in this-procedure .
      827           return .
      828         end.
      829       end.
      830     end.
      831     if p-change-value >= 0
      832     then do:
      833       assign
      834         v-change-sign = 1
      835       .
      836     end.
      837     else do:
      838       assign
      839         v-change-sign = -1
      840       .
      841     end.
      842     assign
      843       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      844     .
      845     if p-change-value = 0
      846     then do:
      847       run diasize_position-resize-button in this-procedure .
      848       return .
      849     end.
