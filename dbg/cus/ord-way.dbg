     1151             ,input  v-cntxt-userid
     1152             ,input  v-diasize-proc-name
     1153             ,input  'width':u
     1154             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1155             ) .
     1156         end.
     1157       end.
     1158     end.
     1159     assign
     1160       v-diasize-change-size = false
     1161     .
     1162   end procedure.
     1163   procedure diasize_set-width :
     1164     define input  parameter p-new-width  as decimal   no-undo .
     1165     define input  parameter p-move-resize as logical   no-undo .
     1166     do
     1167     on error undo, return error return-value
     1168     :
     1169       run diasize_change-width in this-procedure
     1170         (input  (p-new-width - frame Dialog-Frame :width)
     1171         ,input  p-move-resize
     1172         ) .
     1173     end.
     1174   end procedure.
     1175   procedure diasize_position-resize-button :
     1176     do with frame Dialog-Frame
     1177     :
     1178       hide v-diasize-resize-button .
     1179       assign
     1180         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1181                     - 1
     1182                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1183         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1184                     - 1
     1185                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1186       .
     1187       view v-diasize-resize-button .
     1188     end.
     1189   end procedure.
     1190   on alt-right anywhere
     1191   do:
     1192     run diasize_change-width in this-procedure
     1193       (input 1
     1194       ,input true
     1195       ) .
     1196     return no-apply .
     1197   end.
     1198   on alt-left anywhere
     1199   do:
     1200     run diasize_change-width in this-procedure
     1201       (input -1
     1202       ,input true
     1203       ) .
     1204     return no-apply .
     1205   end.
     1206   on alt-down anywhere
     1207   do:
     1208     run diasize_change-height in this-procedure
     1209       (input 1
     1210       ,input true
     1211       ) .
     1212     return no-apply .
     1213   end.
     1214   on alt-up anywhere
     1215   do:
     1216     run diasize_change-height in this-procedure
     1217       (input -1
     1218       ,input true
     1219       ) .
     1220     return no-apply .
     1221   end.
     1222   on alt-enter of frame Dialog-Frame
     1223   do:
     1224     run diasize_maximize in this-procedure
     1225       (input  ?
     1226       ).
     1227     return no-apply .
     1228   end.
     1229   procedure diasize_end-move :
     1230     do
     1231     on error undo, return error return-value
     1232     :
     1233       define variable v-row-delta as decimal   no-undo .
     1234       define variable v-col-delta as decimal   no-undo .
     1235       define variable v-new-row as decimal   no-undo .
     1236       define variable v-new-col as decimal   no-undo .
     1237       assign
     1238         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1239         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1240       .
     1241       assign
     1242         v-row-delta = v-new-row - frame Dialog-Frame :height
     1243         v-col-delta = v-new-col - frame Dialog-Frame :width
     1244       .
     1245       run diasize_change-height in this-procedure
     1246         (input v-row-delta
     1247         ,input true
     1248         ) .
     1249       run diasize_change-width in this-procedure
     1250         (input v-col-delta
     1251         ,input true
     1252         ) .
     1253     end.
     1254   end procedure.
     1255   procedure diasize_maximize :
     1256     define input  parameter p-action as logical   no-undo .
     1257     do
     1258     on error undo, return error return-value
     1259     :
     1260       if p-action = ?
     1261       then do:
     1262         if v-diasize-need-maximize = true
     1263         then do:
     1264           assign
     1265             p-action = true
     1266           .
     1267         end.
     1268         else do:
     1269           assign
     1270             p-action = false
     1271           .
     1272         end.
     1273       end.
     1274       if p-action = true
     1275       then do:
     1276         run diasize_change-height in this-procedure
     1277           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1278               - frame Dialog-Frame :height-chars
     1279           ,input true
     1280           ) .
     1281         run diasize_change-width in this-procedure
     1282           (input session :width-chars
     1283               - frame Dialog-Frame :width-chars
     1284           ,input true
     1285           ) .
     1286         assign
     1287           v-diasize-need-maximize = false
     1288         .
     1289       end.
     1290       else do:
     1291         run diasize_change-width in this-procedure
     1292           (input v-diasize-orig-frame-width
     1293               - frame Dialog-Frame :width-chars
     1294           ,input true
     1295           ) .
     1296         run diasize_change-height in this-procedure
     1297           (input v-diasize-orig-frame-height
     1298               - frame Dialog-Frame :height-chars
     1299           ,input true
     1300           ) .
     1301         assign
     1302           v-diasize-need-maximize = true
     1303         .
     1304       end.
     1305     end.
     1306   end procedure.
     1307   procedure diasize_restore-orig-size :
     1308     do
     1309     on error undo, return error return-value
     1310     :
     1311       assign
     1312         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1313         v-diasize-current-frame-height = frame Dialog-Frame :height
     1314       .
     1315       run diasize_set-height in this-procedure
     1316         (input  v-diasize-orig-frame-height
     1317         ,input  true
     1318         ) .
     1319       run diasize_set-width in this-procedure
     1320         (input  v-diasize-orig-frame-width
     1321         ,input  true
     1322         ) .
     1323     end.
     1324   end procedure.
     1325   procedure diasize_restore-current-size :
     1326     do
     1327     on error undo, return error return-value
     1328     :
     1329       run diasize_set-height in this-procedure
     1330         (input  v-diasize-current-frame-height
     1331         ,input  true
     1332         ) .
     1333       run diasize_set-width in this-procedure
     1334         (input  v-diasize-current-frame-width
     1335         ,input  true
     1336         ) .
     1337     end.
     1338   end procedure.
     1339   procedure diasize_set-browse-handle :
     1340     define input  parameter p-browse-handle as handle   no-undo .
     1341     define buffer buf_temp-browse-handle for temp-browse-handle .
     1342     do
     1343     on error undo, return error return-value
     1344     :
     1345       assign
     1346         v-diasize-browse-handle = p-browse-handle
     1347       .
     1348       for each buf_temp-browse-handle
     1349       on error undo, return error return-value
     1350       :
     1351         delete buf_temp-browse-handle .
     1352       end.
     1353     end.
     1354   end procedure.
     1355   procedure diasize_add_browse :
     1356     define input  parameter p-browse-type   as character no-undo .
     1357     define input  parameter p-browse-handle as handle    no-undo .
     1358     define buffer buf_temp-browse-handle for temp-browse-handle .
     1359     do
     1360     on error undo, return error return-value
     1361     :
     1362       assign
     1363         v-diasize-browse-number = v-diasize-browse-number + 1
     1364       .
     1365       create buf_temp-browse-handle .
     1366       assign
     1367         buf_temp-browse-handle.browse-type   = p-browse-type
     1368         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1369         buf_temp-browse-handle.browse-handle = p-browse-handle
     1370       .
     1371     end.
     1372   end procedure.
     1373   procedure diasize_init :
     1374     define variable v-default-value    as logical   no-undo .
     1375     define variable v-restore-saved    as logical   no-undo .
     1376     define variable v-resize-value-str as character no-undo .
     1377     do
     1378     on error undo, return error return-value
     1379     :
     1380       do with frame Dialog-Frame
     1381       :
     1382         assign
     1383           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1384           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1385           v-diasize-browse-handle     = browse br-docs :handle
     1386         .
     1387         create button v-diasize-resize-button
     1388         assign
     1389           parent        = frame Dialog-Frame :first-child
     1390           label         = "s"
     1391           height-pixels = 16
     1392           width-pixels  = 16
     1393           visible       = true
     1394           sensitive     = true
     1395           movable       = true
     1396           triggers:
     1397             on end-move persistent run diasize_end-move in this-procedure .
     1398           end triggers.
     1399         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1400         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1401         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1402         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1403         assign
     1404           v-diasize-wndmax = false
     1405         .
     1406         if connected("ub") = true
     1407         then do:
     1408           define variable v-cntxt-db-num        as integer   no-undo .
     1409           define variable v-cntxt-userid        as character no-undo .
     1410           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1411                                             , OUTPUT v-cntxt-userid
     1412                                             ) .
     1413           run gbl/wndpar_r.p
     1414             (input  v-cntxt-db-num
     1415             ,input  v-cntxt-userid
     1416             ,input  'wndmax':U
     1417             ,output v-diasize-wndmax
     1418             ,output v-default-value
     1419             ) .
     1420         end.
     1421         assign
     1422           v-diasize-wndstore = false
     1423         .
     1424         if connected("ub") = true
     1425         then do:
     1426           run gbl/wndpar_r.p
     1427             (input  v-cntxt-db-num
     1428             ,input  v-cntxt-userid
     1429             ,input  'wndstore':U
     1430             ,output v-diasize-wndstore
     1431             ,output v-default-value
     1432             ) .
     1433         end.
     1434         assign
     1435           v-diasize-proc-name = entry(1, program-name(2), '.')
     1436         .
     1437         if v-diasize-wndstore = true
     1438         then do:
     1439           assign
     1440             v-restore-saved = false
     1441           .
     1442           if connected("ub") = true
     1443           then do:
     1444             run gbl/wndsizer.p
     1445               (input  v-cntxt-db-num
     1446               ,input  v-cntxt-userid
     1447               ,input  v-diasize-proc-name
     1448               ,input  'height':u
     1449               ,output v-resize-value-str
     1450               ) .
     1451             if v-resize-value-str <> '':U
     1452             then do:
     1453               run diasize_change-height in this-procedure
     1454                 (input  integer(v-resize-value-str)
     1455                 ,input  true
     1456                 ) .
     1457               assign
     1458                 v-restore-saved = true
     1459               .
     1460             end.
     1461           end.
     1462           if connected("ub") = true
     1463           then do:
     1464             run gbl/wndsizer.p
     1465               (input  v-cntxt-db-num
     1466               ,input  v-cntxt-userid
     1467               ,input  v-diasize-proc-name
     1468               ,input  'width':u
     1469               ,output v-resize-value-str
     1470               ) .
     1471             if v-resize-value-str <> '':U
     1472             then do:
     1473               run diasize_change-width in this-procedure
     1474                 (input  integer(v-resize-value-str)
     1475                 ,input  true
     1476                 ) .
     1477               assign
     1478                 v-restore-saved = true
     1479               .
     1480             end.
     1481           end.
     1482           if v-restore-saved <> true
     1483           then do:
     1484             if v-diasize-wndmax = true
     1485             then do:
     1486               run diasize_maximize in this-procedure
     1487                 (input  true
     1488                 ) .
     1489             end.
     1490           end.
     1491         end.
     1492         else do:
     1493           if v-diasize-wndmax = true
     1494           then do:
     1495             run diasize_maximize in this-procedure
     1496               (input  true
     1497               ) .
     1498           end.
     1499         end.
     1500       end.
     1501     end.
     1502   end procedure.
     1503   procedure diasize_need-full-display :
     1504     define output parameter p-need-full-display as logical   no-undo .
     1505     do
     1506     on error undo, return error return-value
     1507     :
     1508       assign
     1509         p-need-full-display = v-diasize-need-full-display
     1510       .
     1511       assign
     1512         v-diasize-need-full-display = false
     1513       .
     1514     end.
     1515   end procedure.
     1516   procedure get-context :
     1517      define output parameter p-db-num as integer          no-undo.
     1518      define output parameter p-user-id as character        no-undo.
     1519      define variable v-login               as character    no-undo.
     1520      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1521      define buffer buf_user-login  for ub.user-login .
     1522      do
     1523      on error undo, return error
     1524      :
     1525            FIND FIRST buf_sys-ctrl no-lock.
     1526            ASSIGN
     1527               v-login = USERID("ub")
     1528               p-db-num = buf_sys-ctrl.db-num
     1529            .
     1530            FIND FIRST buf_user-login
     1531                 WHERE buf_user-login.db-num = p-db-num
     1532                   AND buf_user-login.user-login = v-login
     1533                 no-lock
     1534                 no-error
     1535                 .
     1536            IF AVAILABLE buf_user-login
     1537            THEN DO:
     1538               assign
     1539                  p-user-id = buf_user-login.user-id
     1540               .
     1541            END.
     1542      end.
     1543   end procedure.
     1544       run diasize_init in this-procedure .
     1545   MAIN-BLOCK:
     1546   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1547      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1548      assign
     1549      v-artic     = p-artic
     1550      v-prod-type = p-prod-type
     1551      v-prod-code = p-prod-code
     1552      .
     1553      if p-type = 1 then do:
     1554         frame Dialog-Frame:title = "Заказаные товары в пути до даты поставки " + string (p-LOC-DATE-SHIP , "99/99/9999" ) +
     1555         if p-doc-type = 'ФП':U then
     1556         ( " По фирме " + v-cntxt-host-name-obj )
     1557         else
     1558         ( " По объекту " + p-obj-type + " ("+ string(p-obj-code) +   ")")
     1559         .
     1560      end.
     1561      if p-type = 2 then do:
     1562         frame Dialog-Frame:title = "Заказаные товары в пути на период продаж с " + string (p-DATE-sale-1 , "99/99/9999" )  +
     1563                                     " по "  + string (p-DATE-sale-2 , "99/99/9999" )   .
     1564      end.
     1565     run enable_ui in this-procedure .
     1566     WAIT-FOR GO OF FRAME Dialog-Frame.
     1567   END.
     1568   run disable_UI in this-procedure .
     1569   PROCEDURE disable_UI :
     1570     HIDE FRAME Dialog-Frame.
     1571   END PROCEDURE.
     1572   PROCEDURE enable_UI :
     1573     OPEN QUERY Dialog-Frame FOR EACH ub.goods       WHERE ub.goods.artic = v-artic  AND ub.goods.prod-code = v-prod-code  AND ub.goods.prod-type = v-prod-type NO-LOCK.
     1574     GET FIRST Dialog-Frame.
     1575     DISPLAY v-artic v-prod-type v-prod-code v-user-name
     1576         WITH FRAME Dialog-Frame.
     1577     IF AVAILABLE ub.goods THEN
     1578       DISPLAY ub.goods.gds-name
     1579         WITH FRAME Dialog-Frame.
     1580     ENABLE B-exit B-lkp B-Help br-docs v-artic ub.goods.gds-name v-prod-type
     1581            v-prod-code v-user-name
     1582         WITH FRAME Dialog-Frame.
     1583     VIEW FRAME Dialog-Frame.
     1584     v-log =  session:SET-WAIT-STATE("GENERAL") . OPEN QUERY br-docs FOR EACH ub.ord-line NO-LOCK where ub.ord-line.artic     = p-artic and ub.ord-line.prod-type = p-prod-type and ub.ord-line.prod-code = p-prod-code   ,              EACH ub.ord-doc OF ub.ord-line NO-LOCK       WHERE ub.ord-doc.doc-type <> 'ПО':U AND           ( ub.ord-doc.status_ = 'закрыто':U              OR              ub.ord-doc.status_ = 'поставка':U )              and              (            if p-type = 1 then                ( ub.ord-doc.ship-date <=  p-LOC-DATE-SHIP )                else                ( ub.ord-doc.DATE-sale-1 <= p-date-sale-2 and                  ub.ord-doc.DATE-sale-2 >= p-date-sale-1)                  )                  and      ( if p-doc-type = 'ФП':U then        (ub.ord-doc.host-code = v-cntxt-host-code-obj)        else        (ub.ord-doc.obj-code = p-obj-code  and         ub.ord-doc.obj-type = p-obj-type        )        ). v-log =  session:SET-WAIT-STATE("") .
     1585   END PROCEDURE.
