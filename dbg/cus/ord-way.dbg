      776   procedure diasize_set-height :
      777     define input  parameter p-new-height  as decimal   no-undo .
      778     define input  parameter p-move-resize as logical   no-undo .
      779     do
      780     on error undo, return error return-value
      781     :
      782       run diasize_change-height in this-procedure
      783         (input  (p-new-height - frame Dialog-Frame :height)
      784         ,input  p-move-resize
      785         ) .
      786     end.
      787   end procedure.
      788   procedure diasize_change-width :
      789     define input  parameter p-change-value as decimal   no-undo .
      790     define input  parameter p-move-resize  as logical   no-undo .
