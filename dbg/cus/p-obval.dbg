     1410   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1412   procedure lhistprex-print-cli-list-hist-excel :
     1413   define input parameter p-text  as logical no-undo .
     1414   define input parameter p-excel as logical no-undo .
     1415   define input parameter p-sheet-num as integer no-undo .
     1416   define buffer buf_lh-sheetf for sheetf.
     1417   define buffer buf_cli-list-hist for cli-list-hist.
     1418     do
     1419     on error undo, return error
     1420     :
     1421       find first buf_cli-list-hist no-lock where buf_cli-list-hist.id = 0 no-error .
     1422       if p-excel then do:
     1423         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1424         FInd first buf_lh-Sheetf where
     1425                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1426         if not avail buf_lh-sheetf then
     1427         create buf_lh-sheetf.
     1428         assign
     1429         buf_lh-Sheetf.Sheet-num = 2
     1430         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1431         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1432         .
     1433         run rep/extitlee.p (input p-sheet-num
     1434                       , input  substitute("История создания списка &1 &2"
     1435                                   ,
     1436   ''
     1437                                   ,(if available buf_cli-list-hist
     1438                                   then buf_cli-list-hist.des
     1439                                   else "БЕЗЫМЯННЫЙ"))
     1440                       ) .
     1441       end.
     1442       if p-text then do:
     1443         Page stream PrnLibStream.
     1444         PUT  STREAM PrnLibStream unformatted
     1445         SPACE(25) substitute("История создания списка &1 &2"
     1446                             , ''
     1447                             ,(if available buf_cli-list-hist
     1448                             then buf_cli-list-hist.des
     1449                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1450         space(25) cur-time-print() skip(1)
     1451         .
     1452         put stream PrnLibStream unformatted
     1453         string("№", "X(9)") chr(32)
     1454         string("Действие", "X(9)") chr(32)
     1455         string("записей", "X(9)") chr(32)
     1456         string(" = итого", "X(12)") chr(32)
     1457         (if page-size(PrnLibStream) > 43
     1458         then string("Множество", "X(" + string(136 - 43) + ")")
     1459         else string("Множество", "X(" + string(198 - 43) + ")")
     1460         )
     1461         skip(0)
     1462         fill('-':U, 9) chr(32)
     1463         fill('-':U, 9) chr(32)
     1464         fill('-':U, 9) chr(32)
     1465         fill('-':U, 12) chr(32)
     1466         (if page-size(PrnLibStream) > 43
     1467         then fill('-':U, 136 - 43)
     1468         else fill('-':U, 198 - 43))
     1469         skip(0)
     1470         .
     1471       end.
     1472       for each buf_cli-list-hist where buf_cli-list-hist.id > 0
     1473       by buf_cli-list-hist.id
     1474       :
     1475         if p-text then do:
     1476           put stream PrnLibStream unformatted
     1477           (if buf_cli-list-hist.line = 0
     1478           then string(buf_cli-list-hist.id, ">>>>>>>>9")
     1479           else fill(chr(32) , 9)
     1480           )  chr(32)
     1481           (if buf_cli-list-hist.item_ <> '':U
     1482           then string(buf_cli-list-hist.hist-mode, "X(8)")
     1483           else fill( chr(32), 8)) chr(32)
     1484           string(buf_cli-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1485           string(buf_cli-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1486           (if page-size(PrnLibStream) > 43
     1487           then string(buf_cli-list-hist.des, "X(" + string(136 - 43) + ")")
     1488           else string(buf_cli-list-hist.des, "X(" + string(198 - 43) + ")"))
     1489           skip.
     1490         end.
     1491         if p-excel then do:
     1492           if Make-Excel then  put   stream ForExcel unformatted
     1493           (if buf_cli-list-hist.line = 0
     1494           then string(buf_cli-list-hist.id, ">>>>>>>>9")
     1495           else '':U)
     1496           CHR(9)
     1497           (if buf_cli-list-hist.item_ <> '':U
     1498           then buf_cli-list-hist.hist-mode
     1499           else '':U)  CHR(9)
     1500           (if buf_cli-list-hist.item_ <> '':U
     1501           then string(buf_cli-list-hist.num-add, "->>>>>>>>9")
     1502           else '':U)  CHR(9)
     1503           (if buf_cli-list-hist.item_ <> '':U
     1504           then string(buf_cli-list-hist.num-recs, ">>>>>>>>9")
     1505           else '':U)  CHR(9)
     1506           buf_cli-list-hist.des
     1507           skip.
     1508         end.
     1509       end.
     1510     end.
     1511   end procedure.
