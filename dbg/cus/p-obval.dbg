      590   define  stream PrnLibStream.
      591   procedure prn-lib-prn-file :
      592     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      593     define input parameter p-DIsabledoptions as integer no-undo .
      594     define variable v-report-name as character no-undo .
      595     define variable v-user-action as character no-undo .
      596     define variable v-printed     as logical   no-undo .
      597     define variable v-exist       as logical   no-undo .
      598     do
      599       on error undo, return error
      600       :
      601       run prn-lib-get-report-name  in this-procedure (
      602         input parParentProc
      603         ,output v-report-name
      604         ).
      605   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      607     (input  v-report-name
      608     ,input  2
      609     ,output v-exist
      610     )  .
      611       if NOT v-exist then
      612       DO:
      613         Message
      614           "Нет заданий на печать ! "
      615           view-as alert-box .
      616         Return  .
      617       End.
      618       run gbl/prnfilen.w
      619         (input  ""
      620         ,input  p-DisabledOptions
      621         ,input  string(v-report-name )
      622         ,input  7
      623         ,output v-user-action
      624         ,output v-printed
      625         ) .
      626       if v-printed then
      627       do:
      628         return "YES" .
      629       end.
      630       else
      631       do:
      632         return "NO" .
      633       end.
      634     end.
      635   end procedure.
      636   procedure prn-lib-open-stream :
      637     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      638     define input parameter p-page-size    as integer no-undo .
      639     define input parameter p-is-stream    as logical no-undo .
      640     define input parameter p-append       as logical no-undo .
      641     define variable v-report-name as character no-undo .
      642     do
      643       on error undo, return error
      644       :
      645       run prn-lib-get-report-name  in this-procedure (
      646         input parParentProc
      647         ,output v-report-name
      648         ).
      649       if p-is-stream then
      650       do:
      651         if p-append then
      652         do:
      653           output stream PrnLibStream to value( v-report-name )
      654             page-size value(p-page-size) append .
      655         end.
      656         if not p-append then
      657         do:
      658           output stream PrnLibStream to value( v-report-name )
      659             page-size value(p-page-size) .
      660         end.
      661       end.
      662       if not p-is-stream then
      663       do:
      664         if p-append then
      665         do:
      666           output to value( v-report-name )
      667             page-size value(p-page-size) append .
      668         end.
      669         if not p-append then
      670         do:
      671           output to value( v-report-name )
      672             page-size value(p-page-size) .
      673         end.
      674       end.
      675     end.
      676   end procedure.
      677   procedure prn-lib-open-exp :
      678     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      679     define input parameter p-is-stream    as logical no-undo .
      680     define input parameter p-is-append    as logical no-undo .
      681     define output parameter p-ReportFileName as char init "report" no-undo.
      682     define output parameter p-process as logical no-undo .
      683     define variable glog as logical no-undo .
      684     do
      685       on error undo, return error
      686       :
      687       SYSTEM-DIALOG GET-FILE p-ReportFileName
      688         TITLE      "Укажите путь"
      689         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      690         ASK-OVERWRITE
      691         CREATE-TEST-FILE
      692         SAVE-AS
      693         USE-FILENAME
      694         DEFAULT-EXTENSION "txt"
      695         UPDATE glog
      696         .
      697       if not glog then  return.
      698       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      699       if p-is-stream then
      700       do:
      701         if p-is-append then
      702         do:
      703           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      704         end.
      705         else
      706         do:
      707           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      708         end.
      709       end.
      710       else
      711       do:
      712         if p-is-append then
      713         do:
      714           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      715         end.
      716         else
      717         do:
      718           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      719         end.
      720       end.
      721       p-process = yes.
      722     end.
      723   end procedure.
      724   procedure prn-lib-get-report-name :
      725     define input parameter parParentProc  as widget-handle no-undo.
      726     define output parameter p-report-name as character no-undo .
      727     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      728   end procedure.
      729   procedure prn-lib-reportviewer-report-name :
      730     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      731     define input parameter p-report-name-html as character no-undo .
      732     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      733   end procedure.
      734   procedure prn-lib-reportviewer :
      735     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      736     define input parameter p-report-name-html as character no-undo .
      737     define input parameter p-param        as character no-undo .
      738     define variable v-excel           as character no-undo init 'TRUE' .
      739     define variable v-value-character as character no-undo .
      740     define variable v-value-integer   as character no-undo .
      741     define variable v-value-date      as date      no-undo .
      742     define variable v-value-decimal   as decimal   no-undo .
      743     define variable rep-excel         as logical   no-undo .
      744     define variable excel-string      as character no-undo .
      745     define variable v-param-type      as character no-undo .
      746     define variable v-tth             as handle    no-undo .
      747     run adm/shattri.p (
      748       input "get":U
      749       ,input  ""
      750       ,input  0
      751       ,input  'report-glob':U
      752       ,input  'rep-excel':U
      753       ,output v-value-character
      754       ,output v-value-date
      755       ,output v-value-decimal
      756       ,output v-value-integer
      757       ,output rep-excel
      758       ,output v-param-type
      759       ,INPUT-OUTPUT table-handle v-tth
      760       )  .
      761     if rep-excel then v-excel = "TRUE" .
      762     else v-excel = "FALSE" .
      763     if p-param eq ""
      764     then
      765        p-param = "EXCEL:" + v-excel.
      766     else
      767        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      768     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      769   end procedure.
