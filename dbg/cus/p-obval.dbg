      811     .
      812   define variable l-col-type         as character no-undo .
      813   define variable l-col-pos          as integer no-undo .
      814   define variable l-col-len          as integer no-undo .
      815   define variable l-col-format       as character no-undo .
      816   define variable l-col-lable        as character no-undo .
      817   define variable v-dec-sep          as character no-undo init ? .
      818   define variable v-th-sep           as character no-undo init ? .
      819   define variable v-r-col-num        as integer no-undo .
      820   define variable v-reg-replace      as logical no-undo .
      821   define variable v-date-col-format  as character no-undo .
      822   DEFINE VARIABLE last-col-num as integer no-undo.
      823   run gbl/getlocal.p (
      824                     output v-dec-sep
      825                    ,output v-th-sep
      826                    ,output v-sdate
      827                    ,output v-shortdate
      828                    ) no-error .
      829   assign
      830   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
      831                   AND (v-dec-sep <> ? and v-th-sep <> ?)
      832   .
      833     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
      834                                               INPUT p-dec-sep AS CHARACTER  ) :
      835       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
      836       IF TRIM( p-string ) = "0"                    OR
      837          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
      838          TRIM( p-string ) =       p-dec-sep + "00" OR
      839          TRIM( p-string ) =       p-dec-sep + "0"  OR
      840          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
      841                                                    ELSE DO: ASSIGN v-string = p-string. END.
      842       RETURN ( TRIM( v-string ) ).
      843     END FUNCTION.
      844   FUNCTION reg-output returns character( input p-string as character
      845                                         ,input p-private-data as character
      846                                         ,input p-replace as logical
      847                                         ,input p-supress as logical
      848                                         ,input p-dec-sep as character
      849                                         ,input p-th-sep as character
      850                                         ):
      851   DEFINE VARIABLE v-reg-output as character no-undo .
      852   DEFINE VARIABLE v-data-type as character no-undo .
      853   DEFINE VARIABLE v-progress-format as character no-undo .
      854   assign
      855   v-progress-format = entry(1, p-private-data, chr(4))
      856   v-data-type = entry(2, p-private-data, chr(4))
      857   .
      858   if p-string = ? then return chr(63).
      859   if (v-data-type = "INTEGER"
      860       OR v-data-type = "DECIMAL" ) THEN DO:
      861     IF p-replace THEN DO:
      862       assign
      863         v-reg-output = replace( p-string
      864                                         ,chr(44)
      865                                         ,"":U
      866                                       )
      867         v-reg-output = trim(v-reg-output)
      868       .
      869     END.
      870     else do:
      871       v-reg-output = p-string.
      872     end.
      873     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
      874     return v-reg-output.
      875   end.
      876     return p-string.
      877   END FUNCTION.
      878   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      879   function breakstr returns character ( input        for-name    as character,
      880                                         input        line-length as integer,
      881                                         input-output line1       as character,
      882                                         input-output line2       as character ) :
      883     define variable ii as integer no-undo.
      884     if length( for-name ) > line-length then do:
      885       assign ii    = 1
      886              line1 = "":u
      887              line2 = "":u.
      888       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      889         assign line1 =       substring( for-name, 1, line-length     )
      890                line2 = trim( substring( for-name,    line-length + 1 ) ).
      891       end.                                                     else do:
      892         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      893           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      894                  ii    = ii    + 1.
      895           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      896             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      897           end.
      898         end.
      899         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      900       end.
      901     end.                                else do:
      902       assign line1 = for-name
      903              line2 = "":u.
      904     end.
      905     return ( line1 ).
      906   end function.
      907   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   procedure cur-time :
      909      define output parameter p-today as date      no-undo .
      910      define output parameter p-time  as integer   no-undo .
      911     do
      912     on error undo, return error
      913     :
      914       define variable v-date1 as date      no-undo .
      915       define variable v-date2 as date      no-undo .
      916       define variable v-time  as integer   no-undo .
      917       assign
      918         v-date1 = today
      919         v-time  = time
      920         v-date2 = today
      921       .
      922       if v-date1 <> v-date2
      923       then do:
      924         assign
      925           v-date1 = today
      926           v-time  = v-time
      927         .
      928       end.
      929       assign
      930         p-today = v-date1
      931         p-time  = v-time
      932       .
      933     end.
      934   end.
      935   function cur-time-date returns character
      936   :
      937     return string(today, '99/99/9999':U) .
      938   end.
      939   function cur-time-mjd returns decimal
      940   :
      941     define variable v-date as date      no-undo .
      942     define variable v-time as integer   no-undo .
      943     run cur-time in this-procedure
      944       (output v-date
      945       ,output v-time
      946       ) .
      947     return integer(v-date) - 2400002 + (v-time / 86400) .
      948   end.
      949   function cur-time-get-ending-index returns integer
      950   (input p-number as integer
      951   )
      952   :
      953     if p-number < 0
      954     or p-number = ?
      955     then do:
      956       return 1 .
      957     end.
      958     define variable v-rest as integer   no-undo .
      959     assign
      960       p-number = p-number modulo 100
      961     .
      962     if p-number < 20
      963     then do:
      964       assign
      965         v-rest = p-number
      966       .
      967     end.
      968     else do:
      969       assign
      970         v-rest = p-number modulo 10
      971       .
      972     end.
      973     case v-rest :
      974       when 1
      975       then do:
      976         return 2 .
      977       end.
      978       when 2 or
      979       when 3 or
      980       when 4
      981       then do:
      982         return 3 .
      983       end.
      984       otherwise do:
      985         return 1 .
      986       end.
      987     end case .
      988   end.
      989   procedure cur-time-mjd-to-date :
      990      define input  parameter i-mjd-diff as decimal no-undo.
      991      define output parameter o-Date     as date    no-undo.
      992      define output parameter o-Time     as integer no-undo.
      993      define variable v-day-number as integer   no-undo .
      994      if    i-mjd-diff < 0
      995         or i-mjd-diff = ?
      996      then do:
      997         return "?" .
      998      end.
      999      assign
     1000         v-day-number = truncate(i-mjd-diff,0).
     1001         o-Date = date(v-day-number + 2400002).
     1002         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1003     .
     1004   end.
     1005   function cur-time-mjd-to-string returns character
     1006   (input p-mjd-diff as decimal
     1007   )
     1008   :
     1009     define variable v-day-number as integer   no-undo .
     1010     define variable v-seconds    as integer   no-undo .
     1011     define variable v-hour       as integer   no-undo .
     1012     define variable v-min        as integer   no-undo .
     1013     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1014     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1015     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1016     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1017     if p-mjd-diff < 0
     1018     or p-mjd-diff = ?
     1019     then do:
     1020       return "?" .
     1021     end.
     1022     assign
     1023       v-day-number = integer(truncate(p-mjd-diff,0))
     1024       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1025     .
     1026     if v-seconds > 86400
     1027     then do:
     1028       assign
     1029         v-seconds = 86400 - 1
     1030       .
     1031     end.
     1032     if v-seconds < 0
     1033     then do:
     1034       assign
     1035         v-seconds = 0
     1036       .
     1037     end.
     1038     assign
     1039       v-hour = truncate(v-seconds / 3600, 0)
     1040     .
     1041     assign
     1042       v-seconds = v-seconds modulo 3600
     1043     .
     1044     assign
     1045       v-min = truncate(v-seconds / 60, 0)
     1046     .
     1047     assign
     1048       v-seconds = v-seconds modulo 60
     1049     .
     1050     return
     1051         (if v-day-number <> 0
     1052           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1053           else ""
     1054         )
     1055       + (if v-day-number <> 0 or v-hour <> 0
     1056           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1057           else ""
     1058         )
     1059       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1060           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1061           else ""
     1062         )
     1063       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1064       .
     1065   end.
     1066   function cur-time-string returns character
     1067   :
     1068     define variable v-date as date      no-undo .
     1069     define variable v-time as integer   no-undo .
     1070     run cur-time in this-procedure
     1071       (output v-date
     1072       ,output v-time
     1073       ) .
     1074     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1075   end.
     1076   function cur-time-string-sec returns character
     1077   :
     1078     define variable v-date as date      no-undo .
     1079     define variable v-time as integer   no-undo .
     1080     run cur-time in this-procedure
     1081       (output v-date
     1082       ,output v-time
     1083       ) .
     1084     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1085   end.
     1086   function cur-time-custom  returns character
     1087   (input p-prefix as character
     1088   ,input p-date-format as character
     1089   ,input p-delimiter as character
     1090   ,input p-time-format as character
     1091   ,input p-suffix as character
     1092   )
     1093   :
     1094     define variable v-date as date      no-undo .
     1095     define variable v-time as integer   no-undo .
     1096     run cur-time in this-procedure
     1097       (output v-date
     1098       ,output v-time
     1099       ) .
     1100     return
     1101       p-prefix
     1102       + string(v-date, p-date-format)
     1103       + p-delimiter
     1104       + string(v-time, p-time-format)
     1105       + p-suffix
     1106       .
     1107   end.
     1108   function cur-time-print  returns character
     1109   :
     1110     define variable v-date as date      no-undo .
     1111     define variable v-time as integer   no-undo .
     1112     run cur-time in this-procedure
     1113       (output v-date
     1114       ,output v-time
     1115       ) .
     1116     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1117   end.
     1118   function cur-time-datetime returns datetime
     1119   :
     1120     define variable v-char as character no-undo .
     1121     define variable v-datetime as datetime no-undo .
     1122     v-char = cur-time-string().
     1123     v-datetime = datetime(v-char).
     1124     return  v-datetime.
     1125   end.
     1126   function cur-time-string-msec returns character
     1127   :
     1128     define variable v-date as datetime  no-undo .
     1129     v-date = now.
     1130     return string(v-date) .
     1131   end.
     1132   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1133   define variable v-waitfram-action01         as character   no-undo .
     1134   define variable v-waitfram-action02         as character   no-undo .
     1135   define variable v-waitfram-action03         as character   no-undo .
     1136   define variable mWaitFramTextBeg            as character   no-undo.
     1137   define variable mWaitFramTextEnd            as character   no-undo.
     1138   define variable mWaitFramView               as logical     no-undo.
     1139   define variable mWaitProcEvent              as logical     no-undo init yes.
     1140   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1141   define variable mWaitFramStop               as logical     no-undo.
     1142   define variable mWaitFramStopUser           as logical     no-undo.
     1143   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1144   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1145   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1146   define button B-WaitFramStop auto-end-key
     1147        label "Стоп"
     1148        size 10 by 1 tooltip "Остоновить процесс".
     1149   define button B-viewProcInfo
     1150        label "Информация"
     1151        size 15 by 1 tooltip "Информация о процесс".
     1152   define frame waitfram
     1153     v-waitfram-action01 format "x(72)" no-label skip
     1154     v-waitfram-action02 format "x(72)" no-label skip
     1155     v-waitfram-action03 format "x(72)" no-label skip
     1156     B-viewProcInfo
     1157     B-WaitFramStop at row 4 col 30
     1158     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1159     .
     1160   define new global shared variable mBatchMode as logical no-undo init ?.
     1161   define variable mFramBachModHandle as handle no-undo.
     1162   mFramBachModHandle = frame waitfram:handle.
     1163   define variable mFameOldVis as logical no-undo.
     1164   define variable mVisCUrentVin as logical no-undo.
     1165   if session:batch-mode
     1166   then
     1167      mBatchMode = yes.
     1168   if mBatchMode = ? then do:
     1169     mVisCUrentVin = current-window:visible.
     1170     mFameOldVis = mFramBachModHandle:visible.
     1171     mFramBachModHandle:visible  = yes.
     1172     mBatchMode = mFramBachModHandle:visible ne yes.
     1173     mFramBachModHandle:visible = mFameOldVis.
     1174     current-window:visible = mVisCUrentVin.
     1175   end.
     1176    if  log-manager:logfile-name ne ?
     1177     then DO:
     1178         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1179         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1180         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1181     end.
     1182   on choose of B-WaitFramStop in frame waitfram
     1183   do:
     1184     mWaitFramStop = yes.
     1185     mWaitFramStopUser = yes.
     1186   end.
     1187   function waitfram-check-timeout returns logical():
     1188      define variable vtime as int64 no-undo.
     1189      if mWaitFramStopTimeOut
     1190      then
     1191         return yes.
     1192      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1193      if     mWaitFramTimeOut ne ?
     1194         and mWaitFramTimeOut ne 0
     1195         and mWaitFramTimeOut lt vtime
     1196      then do:
     1197         mWaitFramStopTimeOut = yes.
     1198      end.
     1199      return mWaitFramStopTimeOut.
     1200   end.
     1201   procedure waitfram-hide :
     1202     if not session:batch-mode
     1203     then do
     1204     on error undo, return error return-value
     1205     :
     1206       pause 0 before-hide .
     1207       if not mBatchMode then
     1208         hide frame waitfram .
     1209     if     not mWaitFramView
     1210        and mWaitProcEvent
     1211     then
     1212       process events .
     1213     end.
     1214   end procedure.
     1215   procedure waitfram-show :
     1216     define input  parameter p-message as character no-undo .
     1217     define variable v-left-margin as integer   no-undo .
     1218     if not session:batch-mode
     1219     then do
     1220     on error undo, return error return-value
     1221     :
     1222       if length(p-message) <= 70 then do:
     1223         assign
     1224           v-left-margin = integer((70 - length(p-message)) / 2)
     1225         .
     1226         assign
     1227           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1228         .
     1229         assign
     1230           v-waitfram-action01 = " "
     1231           v-waitfram-action02 = " "
     1232                                    + fill(" ", v-left-margin)
     1233                                    + p-message
     1234           v-waitfram-action03 = " "
     1235         .
     1236       end.
     1237       else do:
     1238         define variable vRindex1 as integer no-undo.
     1239         define variable vRindex2 as integer no-undo.
     1240         vRindex1 = r-index(p-message," ",70).
     1241         if vRindex1 = 0
     1242         then
     1243            vRindex1 = 70.
     1244         if length(p-message)  <= vRindex1 + 70 then do:
     1245           assign
     1246             v-waitfram-action01 = " "
     1247             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1248             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1249           .
     1250         end.
     1251         else do:
     1252           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1253           if vRindex2 <= vRindex1
     1254           then
     1255              vRindex2 = vRindex1 + 70.
     1256           assign
     1257             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1258             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1259             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1260           .
     1261         end.
     1262       end.
     1263       B-viewProcInfo:visible   in frame waitfram = no.
     1264       B-viewProcInfo:sensitive in frame waitfram = no.
     1265       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1266       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1267       if  (   mWaitFramView
     1268          or  mWaitProcEvent)
     1269          and not mBatchMode
     1270       then
     1271          display
     1272             v-waitfram-action01 skip
     1273             v-waitfram-action02 skip
     1274             v-waitfram-action03 skip
     1275          with frame waitfram .
     1276       if     mWaitFramView
     1277          then do:
     1278             if     mWaitFramInterval ne ?
     1279                and not mBatchMode
     1280             then
     1281                wait-for go of frame waitfram pause mWaitFramInterval.
     1282          end.
     1283          else
     1284             if     mWaitProcEvent
     1285                and not mBatchMode
     1286             then
     1287                process events .
     1288     end.
     1289   end procedure.
     1290      procedure waitfram-show-this:
     1291         define input  parameter iInterval as int64 no-undo.
     1292         define variable vtime as int64 no-undo.
     1293         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1294         mWaitFramInterval = iInterval.
     1295         run waitfram-show (substitute("&1&2 &3&4" ,
     1296                                       mWaitFramTextBeg ,
     1297                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1298                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1299                                       mWaitFramTextEnd
     1300                                      )
     1301                           ).
     1302      end.
     1303      procedure WaitFramRunPause:
     1304         define input  parameter iInterval as dec no-undo.
     1305         define variable vStart  as datetime-tz no-undo.
     1306         define variable vend    as datetime-tz no-undo.
     1307         define variable vint as int64 no-undo.
     1308         define variable vOk as logical no-undo.
     1309         vStart = now.
     1310         vend   = vStart.
     1311         publish "WaitFramPause" (iInterval,output vOk).
     1312         vend   =  now.
     1313         vint = vend - vStart.
     1314         vint = iInterval - vint / 1000.
     1315         if     not mWaitFramStop
     1316            and (   vint > 0
     1317                 or (    not vOk
     1318                     and iInterval eq ?
     1319                     )
     1320                 )
     1321         then
     1322            run waitfram-show-this (iInterval).
     1323         vend   =  now.
     1324         vint = vend - vStart.
     1325         vint = iInterval - vint / 1000.
     1326         if     not mWaitFramStop
     1327            and vint > 0
     1328         then do:
     1329            run gbl/pause.p (vint * 1000).
     1330         end.
     1331         if iInterval ne ?
     1332         then
     1333            publish "WaitFramStop".
     1334         waitfram-check-timeout().
     1335      end.
     1336      procedure WaitFramWaitFor:
     1337         define input  parameter iInterval as dec no-undo.
     1338         assign
     1339            mWaitFramStartProc   = now
     1340            mWaitFramStopUser    = no
     1341            mWaitFramStopTimeOut = no
     1342         .
     1343         block-wait:
     1344         do while not mWaitFramStop:
     1345            run WaitFramRunPause (iInterval).
     1346            if  waitfram-check-timeout()
     1347            then do:
     1348               leave block-wait.
     1349            end.
     1350         end.
     1351         run waitfram-hide.
     1352      end.
     1353   procedure waitfram-join :
     1354     define input  parameter p-line-1  as character no-undo .
     1355     define input  parameter p-line-2  as character no-undo .
     1356     define input  parameter p-line-3  as character no-undo .
     1357     define output parameter p-message as character no-undo .
     1358     do
     1359     on error undo, return error return-value
     1360     :
     1361       assign
     1362         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1363                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1364                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1365       .
     1366     end.
     1367   end procedure.
     1368   function waitfram-join-function returns character
     1369     (input p-line-1 as character
     1370     ,input p-line-2 as character
     1371     ,input p-line-3 as character
     1372     ).
     1373     define variable v-message as character no-undo .
     1374     run waitfram-join in this-procedure
     1375       (input  p-line-1
     1376       ,input  p-line-2
     1377       ,input  p-line-3
     1378       ,output v-message
     1379       ) .
     1380     return v-message .
     1381   end function .
