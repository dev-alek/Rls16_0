     1230                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1231               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1232         otherwise do:
     1233           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1234         end.
     1235       end CASE.
     1236     end.
     1237   end procedure.
     1238   procedure uf-get :
     1239     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1240     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1241     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1242     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1243     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1244     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1245     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1246     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1247     do
     1248     on error undo, return error
     1249     :
     1250       define buffer buf_usr-flt for ubflt.usr-flt .
     1251       define variable v-use-List_     as logical   no-undo .
     1252       define variable v-type-List_     as character no-undo .
     1253       define variable v-format-List_   as character no-undo .
     1254       define variable v-use-Naim      as logical   no-undo .
     1255       define variable v-type-Naim      as character no-undo .
     1256       define variable v-format-Naim    as character no-undo .
     1257       define variable v-use-print-graft as logical   no-undo .
     1258       define variable v-use-sort-gr     as logical   no-undo .
     1259       define variable v-use-type-price  as logical   no-undo .
     1260       define variable v-use-type-val    as logical   no-undo .
     1261       define variable v-label          as character no-undo .
     1262       define variable v-tooltip        as character no-undo .
     1263       define variable v-user-can-edit  as logical   no-undo .
     1264       define variable v-output-display as logical   no-undo .
     1265       define variable v-other          as character no-undo .
     1266       run uf-name in this-procedure
     1267          (input  entry(1, p-code, chr(4))
     1268         ,output v-use-List_
     1269         ,output v-type-List_
     1270         ,output v-format-List_
     1271         ,output v-use-Naim
     1272         ,output v-type-Naim
     1273         ,output v-format-Naim
     1274         ,output v-use-print-graft
     1275         ,output v-use-sort-gr
     1276         ,output v-use-type-price
     1277         ,output v-use-type-val
     1278         ,output v-label
     1279         ,output v-tooltip
     1280         ,output v-user-can-edit
     1281         ,output v-output-display
     1282         ,output v-other
     1283         ) no-error .
     1284       if error-status :error then do:
     1285         undo, return error return-value .
     1286       end.
     1287       find first buf_usr-flt no-lock where
     1288                  buf_usr-flt.Call-point     = p-code AND
     1289                  buf_usr-flt.user-name       = p-user-name
     1290         no-error .
     1291       if avail buf_usr-flt then do:
     1292         assign
     1293         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1294         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1295         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1296         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1297         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1298         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1299         .
     1300       end.
     1301       else do:
     1302         assign
     1303         p-List_        = (if v-use-List_       then "":U                    else ?)
     1304         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1305         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1306         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1307         p-type-price   = (if v-use-type-price  then no                      else ?)
     1308         p-type-val     = (if v-use-List_       then no                      else ?)
     1309         .
     1310       end.
     1311     end.
     1312   end procedure.
     1313   procedure uf-set :
     1314     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1315     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1316     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1317     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1318     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1319     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1320     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1321     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1322     do
     1323     on error undo, return error
     1324     :
     1325       define buffer buf_usr-flt for ubflt.usr-flt .
     1326       define variable v-use-List_     as logical   no-undo .
     1327       define variable v-type-List_     as character no-undo .
     1328       define variable v-format-List_   as character no-undo .
     1329       define variable v-use-Naim      as logical   no-undo .
     1330       define variable v-type-Naim      as character no-undo .
     1331       define variable v-format-Naim    as character no-undo .
     1332       define variable v-use-print-graft as logical   no-undo .
     1333       define variable v-use-sort-gr   as logical   no-undo .
     1334       define variable v-use-type-price as logical   no-undo .
     1335       define variable v-use-type-val  as logical   no-undo .
     1336       define variable v-tooltip        as character no-undo .
     1337       define variable v-label          as character no-undo .
     1338       define variable v-user-can-edit  as logical   no-undo .
     1339       define variable v-output-display as logical   no-undo .
     1340       define variable v-other          as character no-undo .
     1341       run uf-name in this-procedure
     1342         (input  entry(1, p-code, chr(4))
     1343         ,output v-use-List_
     1344         ,output v-type-List_
     1345         ,output v-format-List_
     1346         ,output v-use-Naim
     1347         ,output v-type-Naim
     1348         ,output v-format-Naim
     1349         ,output v-use-print-graft
     1350         ,output v-use-sort-gr
     1351         ,output v-use-type-price
     1352         ,output v-use-type-val
     1353         ,output v-label
     1354         ,output v-tooltip
     1355         ,output v-user-can-edit
     1356         ,output v-output-display
     1357         ,output v-other
     1358         ) no-error .
     1359       if error-status :error then do:
     1360         undo, return error return-value .
     1361       end.
     1362       find first buf_usr-flt where
     1363                  buf_usr-flt.Call-point     = p-code AND
     1364                  buf_usr-flt.user-name       = p-user-name
     1365         no-error .
     1366       if not avail buf_usr-flt then do:
     1367           create buf_usr-flt .
     1368           assign
     1369           buf_usr-flt.call-point = p-code
     1370           buf_usr-flt.user-name  = p-user-name
     1371           .
     1372       end.
     1373       if avail buf_usr-flt then do:
     1374        assign
     1375        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1376        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1377        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1378        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1379        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1380        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1381       .
     1382       release buf_usr-flt.
     1383       end.
     1384       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1385     end.
     1386   end procedure.
     1387   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1388     define variable v-cntxt-db-num        as integer   no-undo .
     1389     define variable v-cntxt-userid        as character no-undo .
     1390     define variable v-cntxt-level         as character no-undo .
     1391     define variable v-cntxt-host-code-obj as integer   no-undo .
     1392     define variable v-cntxt-obj-type      as character no-undo .
     1393     define variable v-cntxt-obj-code      as integer   no-undo .
     1394     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1395     define variable v-cntxt-is-admin      as logical   no-undo .
     1396   define variable Line            as character no-undo.
     1397   define variable date_string     as character no-undo.
     1398   define variable parparentproc   as widget-handle no-undo .
     1399   DEFINE BUTTON B-add
     1400        LABEL "&Добавить"
     1401        SIZE 10 BY 1.
     1402   DEFINE BUTTON B-del
     1403        LABEL "&Удалить"
     1404        SIZE 10 BY 1.
     1405   DEFINE VARIABLE T-cdpay-group AS LOGICAL INITIAL no
     1406        LABEL "С группировкой типов кассовых платежей"
     1407        VIEW-AS TOGGLE-BOX
     1408        SIZE 46.13 BY 1 NO-UNDO.
     1409   DEFINE VARIABLE T-rv AS LOGICAL INITIAL no
     1410        LABEL "Отдельно по чекам расхода и возврата"
     1411        VIEW-AS TOGGLE-BOX
     1412        SIZE 46.13 BY 1 NO-UNDO.
     1413   DEFINE QUERY BR-cash-pay FOR
     1414         tt-cash-pay SCROLLING.
     1415   DEFINE QUERY BR-cpay-group FOR
     1416         tt-cash-group SCROLLING.
     1417   DEFINE BROWSE BR-cash-pay
     1418     QUERY BR-cash-pay DISPLAY
     1419         tt-cash-pay.cdpay-code COLUMN-LABEL "Код!пл-жа" FORMAT "99999"
     1420         tt-cash-pay.curr-code COLUMN-LABEL "Код!валюты"
     1421         trim(tt-cash-pay.grp-code, chr(4)) COLUMN-LABEL "№!группы" FORMAT "X(2)"
     1422         tt-cash-pay.obj-name
     1423       WITH NO-ROW-MARKERS SEPARATORS SIZE 63.75 BY 8.67
     1424            TITLE "Типы кассовых платежей".
     1425   DEFINE BROWSE BR-cpay-group
     1426     QUERY BR-cpay-group DISPLAY
     1427         trim(tt-cash-group.grp-code, chr(4)) column-label "№"
     1428   tt-cash-group.obj-name column-label "Название группы" FORMAT "X(23)"
     1429   ENABLE
     1430   tt-cash-group.obj-name
     1431       WITH NO-ROW-MARKERS SEPARATORS SIZE 52.5 BY 5.04
     1432            TITLE "Группы типов кассовых платежей".
     1433   DEFINE FRAME F-Main
     1434        T-cdpay-group AT ROW 1.17 COL 3.38
     1435        BR-cpay-group AT ROW 2.08 COL 2.88
     1436        B-add AT ROW 2.46 COL 56.38
     1437        B-del AT ROW 3.83 COL 56.63
     1438        BR-cash-pay AT ROW 7.29 COL 3.13
     1439        T-rv AT ROW 16 COL 3
     1440       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1441            SIDE-LABELS NO-UNDERLINE THREE-D
     1442            AT COL 1 ROW 1
     1443            SIZE 67.88 BY 16.21.
     1444   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1445   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1446   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1447   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1448   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1449   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1450   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1451   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1452       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1453   RUN ensure-broker.
     1454   THIS-PROCEDURE:ADM-DATA =
     1455        'ADM1.1~`':U +
     1456        'SmartObject~`':U +
     1457        'FRAME~`':U +
     1458        'NO ~`':U +
     1459        '~`':U +
     1460        'tt-cash-pay tt-cash-group~`':U +
     1461        '~`':U +
     1462        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1463           + "~`":U +
     1464        'Layout,Hide-on-Init~`':U +
     1465        '~`':U +
     1466        '~`':U +
     1467        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1468        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1469            THEN "^^":U
     1470        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1471             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1472   PROCEDURE adm-apply-entry :
     1473     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1474   END PROCEDURE.
     1475   PROCEDURE adm-destroy :
     1476    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1477   END PROCEDURE.
     1478   PROCEDURE adm-disable :
     1479       DISABLE T-cdpay-group BR-cpay-group B-add B-del BR-cash-pay T-rv WITH FRAME F-Main.
     1480       RUN dispatch ('disable-fields':U).
     1481       RUN set-attribute-list ('ENABLED=no':U).
     1482       RETURN.
     1483   END PROCEDURE.
     1484   PROCEDURE adm-edit-attribute-list :
     1485         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1486         RETURN.
     1487   END PROCEDURE.
     1488   PROCEDURE adm-enable :
     1489       ENABLE UNLESS-HIDDEN T-cdpay-group BR-cpay-group B-add B-del BR-cash-pay T-rv WITH FRAME F-Main.
     1490       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1491       RUN set-attribute-list ('ENABLED=yes':U).
     1492       RETURN.
     1493   END PROCEDURE.
     1494   PROCEDURE adm-exit :
     1495        RUN notify ('exit':U).
     1496     RETURN.
     1497   END PROCEDURE.
     1498   PROCEDURE adm-hide :
     1499     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1500   END PROCEDURE.
     1501   PROCEDURE adm-initialize :
     1502     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1503   END PROCEDURE.
     1504   PROCEDURE adm-show-errors :
     1505       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1506       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1507           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1508       END.
     1509       RETURN.
     1510   END PROCEDURE.
     1511   PROCEDURE adm-UIB-mode :
     1512     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1513   END PROCEDURE.
     1514   PROCEDURE adm-view :
     1515     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1516   END PROCEDURE.
     1517   PROCEDURE dispatch :
     1518       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1519       RUN broker-dispatch IN adm-broker-hdl
     1520           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1521       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1522   END PROCEDURE.
     1523   PROCEDURE ensure-broker :
     1524   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1525   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1526   DO:
     1527       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1528       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1529   END.
     1530   END PROCEDURE.
     1531   PROCEDURE get-attribute :
     1532     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1533     RUN broker-get-attribute IN adm-broker-hdl
     1534         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1535     RETURN RETURN-VALUE.
     1536   END PROCEDURE.
     1537   PROCEDURE get-attribute-list :
     1538     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1539     RUN broker-get-attribute-list IN adm-broker-hdl
     1540         (INPUT THIS-PROCEDURE,
     1541          INPUT ?,
     1542          OUTPUT p-attr-list) NO-ERROR.
     1543     RETURN.
     1544   END PROCEDURE.
     1545   PROCEDURE new-state :
     1546     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1547     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1548     RETURN.
     1549   END PROCEDURE.
     1550   PROCEDURE notify :
     1551     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1552     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1553     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1554         RETURN "ADM-ERROR":U.
     1555     RETURN.
     1556   END PROCEDURE.
     1557   PROCEDURE set-attribute-list :
     1558     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1559     RUN ensure-broker.
     1560     RUN broker-set-attribute-list IN adm-broker-hdl
     1561         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1562     RETURN.
     1563   END PROCEDURE.
     1564   PROCEDURE set-position :
     1565       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1566       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1567       IF VALID-HANDLE(adm-object-hdl) THEN
     1568       DO:
     1569           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1570           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1571           DO:
     1572             IF p-row = 0 THEN p-row =
     1573               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1574             IF p-col = 0 THEN p-col =
     1575               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1576           END.
     1577           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1578           DO:
     1579             parent-hdl = adm-object-hdl:PARENT.
     1580             IF p-row = 0 THEN p-row =
     1581               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1582                 parent-hdl:ROW.
     1583             IF p-col = 0 THEN p-col =
     1584               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1585                 parent-hdl:COL.
     1586           END.
     1587           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1588           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1589         ASSIGN adm-object-hdl:ROW    =   p-row
     1590                adm-object-hdl:COLUMN =   p-col.
     1591       END.
     1592       RETURN.
     1593   END PROCEDURE.
     1594   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1595       STRING(adm-object-hdl)).
     1596   PAUSE 0 BEFORE-HIDE.
     1597   PROCEDURE adm-change-page :
     1598     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1599     END PROCEDURE.
     1600   PROCEDURE delete-page :
     1601     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1602     RUN broker-delete-page IN adm-broker-hdl
     1603         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1604     END PROCEDURE.
     1605   PROCEDURE init-object :
     1606     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1607     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1608     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1609     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1610     RUN broker-init-object IN adm-broker-hdl
     1611         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1612          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1613     RETURN.
     1614   END PROCEDURE.
     1615   PROCEDURE init-pages :
     1616     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1617     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1618         INPUT p-page-list) NO-ERROR.
     1619     END PROCEDURE.
     1620   PROCEDURE select-page :
     1621     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1622     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1623         INPUT p-page#) NO-ERROR.
     1624     END PROCEDURE.
     1625   PROCEDURE view-page :
     1626     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1627     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1628         INPUT p-page#).
     1629     END PROCEDURE.
     1630   ASSIGN
     1631          B-add:HIDDEN IN FRAME F-Main           = TRUE.
     1632   ASSIGN
     1633          B-del:HIDDEN IN FRAME F-Main           = TRUE.
     1634   ASSIGN
     1635          BR-cash-pay:HIDDEN  IN FRAME F-Main                = TRUE.
     1636   ASSIGN
     1637          BR-cpay-group:HIDDEN  IN FRAME F-Main                = TRUE.
     1638   ON CHOOSE OF B-add IN FRAME F-Main
     1639   DO:
     1640   define buffer buf_tt-cash-group for tt-cash-group.
     1641   define buffer buf_tt-cash-pay for tt-cash-pay.
     1642   define buffer buf_cash-pay for ub.cash-pay.
     1643   define variable varrid-list as character no-undo.
     1644   define variable ii as integer no-undo.
     1645   define variable jj as integer no-undo.
     1646   define variable v-cash-pay-list as character no-undo.
     1647    varrid-list = "" .
     1648   run ref/cashpays.w (
     1649                  input my-handle
     1650                 ,input "b-sel,b-mark"
     1651                 ,input 'все':U
     1652                 ,input 0
     1653                 ,input '':U
     1654                 ,input 0
     1655                 ,output varrid-list ) .
     1656   if varrid-list = "":U then return no-apply.
     1657   find last buf_tt-cash-group no-lock use-index pi no-error.
     1658   if available buf_tt-cash-group then do:
     1659       assign
     1660       jj = integer(trim(buf_tt-cash-group.grp-code, chr(4)))
     1661       .
     1662   end.
     1663   do ii = 1 to num-entries(varrid-list):
     1664       find first buf_cash-pay no-lock where
     1665                   recid(buf_cash-pay) = integer(entry(ii, varrid-list)) no-error.
     1666       if available buf_cash-pay then do:
     1667           assign
     1668           v-cash-pay-list = v-cash-pay-list + (if v-cash-pay-list = "":U then "":U else ";":U) +
     1669                                     string(buf_cash-pay.cdpay-code) + "-":U + string(buf_cash-pay.curr-code)
     1670          .
     1671       end.
     1672   end.
     1673   run proc-add-cash-group in this-procedure (chr(4) + string(jj + 1), "Группа" + chr(32) + string(jj + 1),  v-cash-pay-list) no-error.
     1674   if error-status:error then do:
     1675       undo, return no-apply.
     1676   end.
     1677   run set-cash-group in this-procedure(no, yes) no-error.
     1678   END.
     1679   ON CHOOSE OF B-del IN FRAME F-Main
     1680   DO:
     1681   define variable ii as integer no-undo.
     1682   define buffer buf_tt-cash-group for tt-cash-group.
     1683   define buffer buf2_tt-cash-group for tt-cash-group.
     1684   define buffer buf_tt-cash-pay for tt-cash-pay.
     1685     if not available tt-cash-group then return no-apply.
     1686     find first buf_tt-cash-group exclusive-lock where buf_tt-cash-group.grp-code = tt-cash-group.grp-code.
     1687     ii = integer(trim(buf_tt-cash-group.grp-code, chr(4))).
     1688     for each buf_tt-cash-pay where
     1689               buf_tt-cash-pay.grp-code = buf_tt-cash-group.grp-code :
     1690            buf_tt-cash-pay.grp-code = chr(4) + "0":U.
     1691     end.
     1692     delete buf_tt-cash-group.
     1693     for each buf_tt-cash-pay where
     1694               integer(trim(buf_tt-cash-pay.grp-code, chr(4))) > ii:
     1695         assign
     1696         buf_tt-cash-pay.grp-code = chr(4) + string(integer(trim(buf_tt-cash-pay.grp-code, chr(4))) - 1      )
     1697         .
     1698     end.
     1699       for each buf2_tt-cash-group where
     1700               integer(trim(buf2_tt-cash-group.grp-code, chr(4))) > ii:
     1701         assign
     1702         buf2_tt-cash-group.grp-code = chr(4) + string(integer(trim(buf2_tt-cash-group.grp-code, chr(4))) - 1      )
     1703         .
     1704     end.
     1705   run set-cash-group in this-procedure(no, yes) no-error.
     1706   OPEN QUERY BR-cash-pay FOR EACH tt-cash-pay NO-LOCK.
     1707   OPEN QUERY BR-cpay-group FOR EACH tt-cash-group.
     1708   END.
     1709   ON LEAVE OF BR-cpay-group IN FRAME F-Main
     1710   DO:
     1711     ASSIGN
     1712     TT-CASH-GROUP.OBJ-NAME = TT-CASH-GROUP.OBJ-NAME:SCREEN-VALUE IN browse br-cpay-group.
     1713   END.
     1714   ON VALUE-CHANGED OF T-cdpay-group IN FRAME F-Main
     1715   DO:
     1716     assign
     1717     t-cdpay-group.
     1718     CASE t-cdpay-group:
     1719       when yes then do:
     1720           run get-cash-group in this-procedure no-error.
     1721           display
     1722           B-add B-del BR-cash-pay BR-cpay-group
     1723           with frame F-Main.
     1724       end.
     1725       when no then do:
     1726           run set-cash-group in this-procedure(yes, no) no-error.
     1727           hide
     1728           B-add B-del BR-cash-pay BR-cpay-group
     1729           in frame F-Main.
     1730       end.
     1731     END CASE.
     1732   END.
     1733   if not this-procedure :persistent
     1734   then do:
     1735     message
     1736       vss-workfile vss-revision vss-description skip
     1737       "Ошибка при запуске процедуры" skip
     1738       "Данную процедуру следует запускать только с параметром persistent" skip
     1739       view-as alert-box error .
     1740     undo, return error .
     1741   end.
     1742   PROCEDURE adm-create-objects :
     1743   END PROCEDURE.
     1744   PROCEDURE adm-row-available :
     1745     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1746     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1747     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1748     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1749     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1750     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1751     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1752     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1753     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1754     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1755     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1756     IF adm-updating-record THEN RETURN.
     1757     RUN get-attribute ('FIELDS-ENABLED':U).
     1758     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1759     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1760         OUTPUT link-handle) NO-ERROR.
     1761     IF link-handle = "":U THEN
     1762         RETURN.
     1763     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1764     IF NUM-ENTRIES(link-handle) > 1 THEN
     1765         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1766             "encountered more than one RECORD-SOURCE.":U SKIP
     1767             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1768                VIEW-AS ALERT-BOX ERROR.
     1769     RUN get-attribute ('Key-Name':U).
     1770     key-name = RETURN-VALUE.
     1771     IF key-name = "":U THEN key-name = ?.
     1772     IF key-name NE ? THEN DO:
     1773       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1774         NO-ERROR.
     1775       IF key-value NE ? THEN
     1776         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1777     END.
     1778   IF VALID-HANDLE (adm-object-hdl) THEN
     1779       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1780   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1781   END PROCEDURE.
     1782   PROCEDURE disable_UI :
     1783     HIDE FRAME F-Main.
     1784     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1785   END PROCEDURE.
     1786   PROCEDURE enable_UI :
     1787     DISPLAY T-cdpay-group T-rv
     1788         WITH FRAME F-Main.
     1789     ENABLE T-cdpay-group BR-cpay-group B-add B-del BR-cash-pay T-rv
     1790         WITH FRAME F-Main.
     1791   END PROCEDURE.
     1792   PROCEDURE get-cash-group :
     1793   define variable v-grp-int-code as integer no-undo.
     1794   define variable v-grp-name as character no-undo.
     1795   define variable v-cash-pay-list as character no-undo.
     1796   define variable ii as integer no-undo.
     1797   run uf-get in this-procedure(
     1798        input  'pychk-rep':U
     1799       ,input  g#userid
     1800       ,output v-uf-List_
     1801       ,output v-uf-Naim
     1802       ,output v-uf-print-graft
     1803       ,output v-uf-sort-gr
     1804       ,output v-uf-type-price
     1805       ,output v-uf-type-val
     1806   )  no-error.
     1807   if not error-status:error then do:
     1808       do ii = 1 to num-entries (v-uf-list_, chr(4)):
     1809           assign
     1810           v-grp-int-code = integer(entry(1, entry(ii, v-uf-list_, chr(4)), "=":U))
     1811           v-grp-name = entry(2, entry(ii, v-uf-list_, chr(4)), "=":U)
     1812           v-cash-pay-list = entry(ii, v-uf-Naim, chr(4))
     1813           .
     1814           run proc-add-cash-group in this-procedure (chr(4) + string(v-grp-int-code), v-grp-name, v-cash-pay-list) no-error.
     1815           if error-status:error then undo, return error.
     1816       end.
     1817   end.
     1818   END PROCEDURE.
     1819   PROCEDURE local-apply-layout :
     1820     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1821   define buffer buf_cash-pay for ub.cash-pay.
     1822   define buffer buf_tt-cash-pay for tt-cash-pay.
     1823   for each tt-cash-pay:
     1824       delete tt-cash-pay.
     1825   end.
     1826   for each buf_cash-pay no-lock:
     1827       create buf_tt-cash-pay.
     1828       buffer-copy buf_cash-pay to buf_tt-cash-pay
     1829       assign
     1830       buf_tt-cash-pay.grp-code = chr(4) + "0":U
     1831       .
     1832   end.
     1833   OPEN QUERY BR-cash-pay FOR EACH tt-cash-pay NO-LOCK.
     1834   OPEN QUERY BR-cpay-group FOR EACH tt-cash-group.
     1835   apply "VALUE-CHANGED" to T-cdpay-group in frame F-Main.
     1836   END PROCEDURE.
     1837   PROCEDURE local-initialize :
     1838     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1839     parparentproc = my-handle.
     1840   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1841     run mainmenu_getcntxt in parparentproc
     1842       (output v-cntxt-db-num
     1843       ,output v-cntxt-userid
     1844       ,output v-cntxt-level
     1845       ,output v-cntxt-host-code-obj
     1846       ,output v-cntxt-obj-type
     1847       ,output v-cntxt-obj-code
     1848       ,output v-cntxt-db-num-obj
     1849       ,output v-cntxt-is-admin
     1850       ) .
     1851   END PROCEDURE.
     1852   PROCEDURE My-report :
     1853   run My-var.
     1854   if return-value = "error":U then return.
     1855   run set-cash-group in this-procedure (no, T-cdpay-group) no-error.
     1856   run cus/r-pychk2.p ( input my-handle
     1857                       ,input T-cdpay-group
     1858                       ,input T-rv) no-error.
     1859   END PROCEDURE.
     1860   PROCEDURE My-var :
     1861   define buffer buf_tt-cash-group for tt-cash-group.
     1862   Assign
     1863   frame F-Main t-cdpay-group
     1864   t-rv
     1865   .
     1866   Assign
     1867    STR-obj-type = ''
     1868    STR-obj-code = ''
     1869    STR-obj-name = ''
     1870    STR-obj      = ''.
     1871   For each obj-list no-lock:
     1872    Assign
     1873    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1874    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1875    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1876    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1877   End.
     1878   Reportname = "Разбивка товаров в чеке по типам кассовых платежей и НДС "
     1879   .
     1880   ReportHeader =  (if t-cdpay-group
     1881                     then "С группировкой типов кассовых платежей"
     1882                    else "":U) + chr(10) +
     1883                   (if t-rv
     1884                    then "Раздельно по чекам расхода и возврата"
     1885                    else '':U)
     1886   .
     1887   For each obj-list no-lock:
     1888    Assign
     1889    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1890    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1891    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1892    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1893   End.
     1894   for each buf_tt-cash-group:
     1895       if buf_tt-cash-group.obj-name = "":U        then do:
     1896           message "Введите название для всех групп"
     1897           view-as alert-box error.
     1898           return "error":U.
     1899       end.
     1900   end.
     1901   END PROCEDURE.
     1902   PROCEDURE proc-add-cash-group :
     1903   define input parameter p-grp-code as character no-undo.
     1904   define input parameter p-grp-name as character no-undo.
     1905   define input parameter p-cash-pay-list as character no-undo.
     1906   define variable ii as integer no-undo.
     1907   define buffer buf_tt-cash-group for tt-cash-group.
     1908   define buffer buf_tt-cash-pay for tt-cash-pay.
     1909   define buffer buf_cash-pay for ub.cash-pay.
     1910   create buf_tt-cash-group.
     1911   assign
     1912   buf_tt-cash-group.grp-code = p-grp-code
     1913   buf_tt-cash-group.obj-name = p-grp-name
     1914   .
     1915   do ii = 1 to num-entries(p-cash-pay-list, ";":U):
     1916       find first buf_cash-pay no-lock where
     1917                   buf_cash-pay.cdpay-code = integer(entry(1, entry(ii, p-cash-pay-list, ";":U), "-":U))
     1918                AND  buf_cash-pay.curr-code = integer(entry(2, entry(ii, p-cash-pay-list, ";":U), "-":U))          no-error.
     1919       if available buf_cash-pay then do:
     1920           find first buf_tt-cash-pay where
     1921                       buf_tt-cash-pay.cdpay-code =  buf_cash-pay.cdpay-code
     1922                   AND buf_tt-cash-pay.curr-code =  buf_cash-pay.curr-code no-error.
     1923                   if available buf_tt-cash-pay then do:
     1924                       assign
     1925                       buf_tt-cash-pay.grp-code = buf_tt-cash-group.grp-code
     1926                       .
     1927                  end.
     1928       end.
     1929   end.
     1930   OPEN QUERY BR-cash-pay FOR EACH tt-cash-pay NO-LOCK.
     1931   OPEN QUERY BR-cpay-group FOR EACH tt-cash-group.
     1932   END PROCEDURE.
     1933   PROCEDURE send-records :
     1934     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1935     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1936     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1937     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1938     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1939     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1940         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1941         CASE ENTRY(i, p-tbl-list):
     1942       WHEN "tt-cash-group":U THEN p-rowid-list = p-rowid-list +
     1943           IF AVAILABLE tt-cash-group THEN STRING(ROWID(tt-cash-group))
     1944           ELSE "?":U.
     1945       WHEN "tt-cash-pay":U THEN p-rowid-list = p-rowid-list +
     1946           IF AVAILABLE tt-cash-pay THEN STRING(ROWID(tt-cash-pay))
     1947           ELSE "?":U.
     1948           OTHERWISE
     1949           DO:
     1950               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1951                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1952               IF link-handle NE "":U THEN
     1953               DO:
     1954                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1955                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1956                               "encountered more than one RECORD-SOURCE.":U SKIP
     1957                               "The first will be used.":U
     1958                               VIEW-AS ALERT-BOX ERROR.
     1959                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1960                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1961                   p-rowid-list = p-rowid-list + rowid-string.
     1962               END.
     1963               ELSE
     1964               DO:
     1965                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1966                           "does not match tables in send-records":U
     1967                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1968                           "Check that objects are linked properly and that":U
     1969                           "database qualification is consistent.":U
     1970                       VIEW-AS ALERT-BOX ERROR.
     1971                   RETURN ERROR.
     1972               END.
     1973           END.
     1974           END CASE.
     1975       END.
     1976   END PROCEDURE.
     1977   PROCEDURE set-cash-group :
     1978   define input parameter p-clear as logical no-undo.
     1979   define input parameter p-set as logical no-undo.
     1980   define variable ii as integer no-undo.
     1981   define buffer buf_tt-cash-group for tt-cash-group.
     1982   define buffer buf_tt-cash-pay for tt-cash-pay.
     1983   assign
     1984   v-uf-list_ = "":U
     1985   v-uf-naim = "":U
     1986   .
     1987   for each buf_tt-cash-group:
     1988       assign
     1989       ii = 0
     1990       v-uf-list_ = v-uf-list_ + (if v-uf-list_ = "":U then "":U else chr(4)) +
     1991                        trim(buf_tt-cash-group.grp-code, chr(4)) + "=":U +
     1992                        buf_tt-cash-group.obj-name
     1993       v-uf-naim = v-uf-Naim + (if v-uf-Naim = "":U then "":U else chr(4))
     1994       .
     1995       for each buf_tt-cash-pay where
     1996                   buf_tt-cash-pay.grp-code = buf_tt-cash-group.grp-code:
     1997              ii = ii + 1.
     1998             assign
     1999             v-uf-NAim = v-uf-Naim + (if ii = 1 then "":U else ";") +
     2000                   string(buf_tt-cash-pay.cdpay-code) + "-":U + string(buf_tt-cash-pay.curr-code)
     2001             .
     2002             if p-clear then
     2003             assign
     2004             buf_tt-cash-pay.grp-code = chr(4) + "0":U
     2005             .
     2006         end.
     2007         if p-clear then
     2008         delete buf_tt-cash-group.
     2009       .
     2010   end.
     2011   if p-set then do:
     2012     run uf-set in this-procedure(
     2013       input  'pychk-rep':U
     2014       ,input  g#userid
     2015       ,input v-uf-List_
     2016       ,input v-uf-Naim
     2017       ,input v-uf-print-graft
     2018       ,input v-uf-sort-gr
     2019       ,input v-uf-type-price
     2020       ,input v-uf-type-val
     2021   )  no-error .
     2022   if error-status:error then undo, return error.
     2023   end.
     2024   END PROCEDURE.
     2025   PROCEDURE state-changed :
     2026     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2027     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2028   END PROCEDURE.
