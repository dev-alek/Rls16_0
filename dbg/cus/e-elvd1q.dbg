        1   block-level on error undo, throw.
        2   define input parameter p-cli-mode as character no-undo .
        3   DEFINE INPUT PARAMETER StartPoint as date no-undo.
        4   DEFINE INPUT PARAMETER EndPoint as date no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: e-elvd1q.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: cus/e-elvd1q.p $":U .
       10   define variable vss-description as character no-undo init "Заполнение полей временной таблицы для отчета Ведомости по клиентам".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable v-waitfram-action01         as character   no-undo .
       73   define variable v-waitfram-action02         as character   no-undo .
       74   define variable v-waitfram-action03         as character   no-undo .
       75   define variable mWaitFramTextBeg            as character   no-undo.
       76   define variable mWaitFramTextEnd            as character   no-undo.
       77   define variable mWaitFramView               as logical     no-undo.
       78   define variable mWaitProcEvent              as logical     no-undo init yes.
       79   define variable mWaitFramInterval           as integer     no-undo init 1 .
       80   define variable mWaitFramStop               as logical     no-undo.
       81   define variable mWaitFramStopUser           as logical     no-undo.
       82   define variable mWaitFramStopTimeOut        as logical     no-undo.
       83   define variable mWaitFramStartProc          as datetime-tz no-undo.
       84   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       85   define button B-WaitFramStop auto-end-key
       86        label "Стоп"
       87        size 10 by 1 tooltip "Остоновить процесс".
       88   define button B-viewProcInfo
       89        label "Информация"
       90        size 15 by 1 tooltip "Информация о процесс".
       91   define frame waitfram
       92     v-waitfram-action01 format "x(72)" no-label skip
       93     v-waitfram-action02 format "x(72)" no-label skip
       94     v-waitfram-action03 format "x(72)" no-label skip
       95     B-viewProcInfo
       96     B-WaitFramStop at row 4 col 30
       97     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       98     .
       99   define new global shared variable mBatchMode as logical no-undo init ?.
      100   define variable mFramBachModHandle as handle no-undo.
      101   mFramBachModHandle = frame waitfram:handle.
      102   define variable mFameOldVis as logical no-undo.
      103   define variable mVisCUrentVin as logical no-undo.
      104   if session:batch-mode
      105   then
      106      mBatchMode = yes.
      107   if mBatchMode = ? then do:
      108     mVisCUrentVin = current-window:visible.
      109     mFameOldVis = mFramBachModHandle:visible.
      110     mFramBachModHandle:visible  = yes.
      111     mBatchMode = mFramBachModHandle:visible ne yes.
      112     mFramBachModHandle:visible = mFameOldVis.
      113     current-window:visible = mVisCUrentVin.
      114   end.
      115    if  log-manager:logfile-name ne ?
      116     then DO:
      117         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      118         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      119         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      120     end.
      121   on choose of B-WaitFramStop in frame waitfram
      122   do:
      123     mWaitFramStop = yes.
      124     mWaitFramStopUser = yes.
      125   end.
      126   function waitfram-check-timeout returns logical():
      127      define variable vtime as int64 no-undo.
      128      if mWaitFramStopTimeOut
      129      then
      130         return yes.
      131      vtime = ( now - mWaitFramStartProc ) / 1000 .
      132      if     mWaitFramTimeOut ne ?
      133         and mWaitFramTimeOut ne 0
      134         and mWaitFramTimeOut lt vtime
      135      then do:
      136         mWaitFramStopTimeOut = yes.
      137      end.
      138      return mWaitFramStopTimeOut.
      139   end.
      140   procedure waitfram-hide :
      141     if not session:batch-mode
      142     then do
      143     on error undo, return error return-value
      144     :
      145       pause 0 before-hide .
      146       if not mBatchMode then
      147         hide frame waitfram .
      148     if     not mWaitFramView
      149        and mWaitProcEvent
      150     then
      151       process events .
      152     end.
      153   end procedure.
      154   procedure waitfram-show :
      155     define input  parameter p-message as character no-undo .
      156     define variable v-left-margin as integer   no-undo .
      157     if not session:batch-mode
      158     then do
      159     on error undo, return error return-value
      160     :
      161       if length(p-message) <= 70 then do:
      162         assign
      163           v-left-margin = integer((70 - length(p-message)) / 2)
      164         .
      165         assign
      166           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      167         .
      168         assign
      169           v-waitfram-action01 = " "
      170           v-waitfram-action02 = " "
      171                                    + fill(" ", v-left-margin)
      172                                    + p-message
      173           v-waitfram-action03 = " "
      174         .
      175       end.
      176       else do:
      177         define variable vRindex1 as integer no-undo.
      178         define variable vRindex2 as integer no-undo.
      179         vRindex1 = r-index(p-message," ",70).
      180         if vRindex1 = 0
      181         then
      182            vRindex1 = 70.
      183         if length(p-message)  <= vRindex1 + 70 then do:
      184           assign
      185             v-waitfram-action01 = " "
      186             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      187             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      188           .
      189         end.
      190         else do:
      191           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      192           if vRindex2 <= vRindex1
      193           then
      194              vRindex2 = vRindex1 + 70.
      195           assign
      196             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      199           .
      200         end.
      201       end.
      202       B-viewProcInfo:visible   in frame waitfram = no.
      203       B-viewProcInfo:sensitive in frame waitfram = no.
      204       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       if  (   mWaitFramView
      207          or  mWaitProcEvent)
      208          and not mBatchMode
      209       then
      210          display
      211             v-waitfram-action01 skip
      212             v-waitfram-action02 skip
      213             v-waitfram-action03 skip
      214          with frame waitfram .
      215       if     mWaitFramView
      216          then do:
      217             if     mWaitFramInterval ne ?
      218                and not mBatchMode
      219             then
      220                wait-for go of frame waitfram pause mWaitFramInterval.
      221          end.
      222          else
      223             if     mWaitProcEvent
      224                and not mBatchMode
      225             then
      226                process events .
      227     end.
      228   end procedure.
      229      procedure waitfram-show-this:
      230         define input  parameter iInterval as int64 no-undo.
      231         define variable vtime as int64 no-undo.
      232         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      233         mWaitFramInterval = iInterval.
      234         run waitfram-show (substitute("&1&2 &3&4" ,
      235                                       mWaitFramTextBeg ,
      236                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      237                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      238                                       mWaitFramTextEnd
      239                                      )
      240                           ).
      241      end.
      242      procedure WaitFramRunPause:
      243         define input  parameter iInterval as dec no-undo.
      244         define variable vStart  as datetime-tz no-undo.
      245         define variable vend    as datetime-tz no-undo.
      246         define variable vint as int64 no-undo.
      247         define variable vOk as logical no-undo.
      248         vStart = now.
      249         vend   = vStart.
      250         publish "WaitFramPause" (iInterval,output vOk).
      251         vend   =  now.
      252         vint = vend - vStart.
      253         vint = iInterval - vint / 1000.
      254         if     not mWaitFramStop
      255            and (   vint > 0
      256                 or (    not vOk
      257                     and iInterval eq ?
      258                     )
      259                 )
      260         then
      261            run waitfram-show-this (iInterval).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and vint > 0
      267         then do:
      268            run gbl/pause.p (vint * 1000).
      269         end.
      270         if iInterval ne ?
      271         then
      272            publish "WaitFramStop".
      273         waitfram-check-timeout().
      274      end.
      275      procedure WaitFramWaitFor:
      276         define input  parameter iInterval as dec no-undo.
      277         assign
      278            mWaitFramStartProc   = now
      279            mWaitFramStopUser    = no
      280            mWaitFramStopTimeOut = no
      281         .
      282         block-wait:
      283         do while not mWaitFramStop:
      284            run WaitFramRunPause (iInterval).
      285            if  waitfram-check-timeout()
      286            then do:
      287               leave block-wait.
      288            end.
      289         end.
      290         run waitfram-hide.
      291      end.
      292   procedure waitfram-join :
      293     define input  parameter p-line-1  as character no-undo .
      294     define input  parameter p-line-2  as character no-undo .
      295     define input  parameter p-line-3  as character no-undo .
      296     define output parameter p-message as character no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       assign
      301         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      304       .
      305     end.
      306   end procedure.
      307   function waitfram-join-function returns character
      308     (input p-line-1 as character
      309     ,input p-line-2 as character
      310     ,input p-line-3 as character
      311     ).
      312     define variable v-message as character no-undo .
      313     run waitfram-join in this-procedure
      314       (input  p-line-1
      315       ,input  p-line-2
      316       ,input  p-line-3
      317       ,output v-message
      318       ) .
      319     return v-message .
      320   end function .
      321   define variable v-accum as integer no-undo .
      322   define variable v-cli-type as character no-undo .
      323   define variable v-cli-code as integer no-undo .
      324   define variable v-curr-r-b as character no-undo .
      325   define variable v-base-code as integer no-undo .
      326   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      327   def shared temp-table cli-list no-undo like ub.clients
      328     field to-del as logical
      329     index obj  is primary unique obj-type obj-code
      330     index cli-name      obj-name
      331     .
      332   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      333   define  shared  temp-table cli-list-hist no-undo
      334   field list-table as character
      335   field id as integer
      336   field line as integer
      337   field hist-mode as character
      338   field des as character
      339   field num-recs as integer
      340   field option_ as character
      341   field item_ as character
      342   field status_ as character
      343   field num-add as integer
      344   field num-ignored as integer
      345   field done as logical
      346   field err_ as logical
      347   field err-mes as character
      348   index pi is primary
      349   id
      350   line
      351   index isdone
      352   done
      353   .
      354   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      355   define SHARED temp-table dcards  no-undo
      356   field cli-type      like ub.chk-doc.cli-type
      357   field cli-code      like ub.chk-doc.cli-code
      358   field cli-name      like ub.clients.obj-name
      359   field sum           as decimal
      360   index pi
      361   IS unique PRIMARY
      362   cli-type cli-code
      363   index pname cli-name
      364   .
      365   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      366   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      367     (output v-curr-r-b
      368     )  .
      369   define buffer buf_shop for ub.shop.
      370   define buffer buf_dis-card for ub.dis-card.
      371   define buffer buf_chk-doc for ub.chk-doc.
      372   define buffer buf_clients for ub.clients.
      373   for each buf_shop no-lock:
      374     if v-curr-r-b = 'base':U then do:
      375   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      377     (input  buf_shop.host-code
      378     ,output v-base-code
      379     )  .
      380     end.
      381     _chk-doc:
      382     FOR EACH buf_chk-doc NO-LOCK WHERE
      383             buf_chk-doc.obj-type = 'маг':U
      384         AND buf_chk-doc.obj-code = buf_shop.obj-code
      385         AND buf_chk-doc.chk-date >= StartPoint
      386         AND buf_chk-doc.chk-date <= EndPoint
      387         AND buf_chk-doc.out-code > '':U
      388         and buf_chk-doc.d-card > '':U:
      389       if LOOKUP(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _CHk-doc.
      390       PROCESS EVENTS .
      391       assign
      392       v-accum = v-accum + 1.
      393       if ( v-accum modulo 10 ) = 0  then do:
      394         run waitfram-show in this-procedure  (
      395                                           substitute("&1&2 обработано &3"  , 'маг':U, buf_shop.obj-code, v-accum)
      396                                           ).
      397       end.
      398       if buf_chk-doc.cli-type = ?
      399       or buf_chk-doc.cli-code = ?
      400       or buf_chk-doc.cli-type = '':U
      401       or buf_chk-doc.cli-code = 0 then do:
      402         find first buf_dis-card no-lock where
      403                   buf_dis-card.d-card = buf_chk-doc.d-card no-error .
      404         if available buf_dis-card then do:
      405           assign
      406           v-cli-type = buf_dis-card.cli-type
      407           v-cli-code = buf_dis-card.cli-code
      408           .
      409         end.
      410       end.
      411       else do:
      412         assign
      413         v-cli-type = buf_chk-doc.cli-type
      414         v-cli-code = buf_chk-doc.cli-code
      415         .
      416       end.
      417       if p-cli-mode <> "ALL" then do:
      418         find first cli-list no-lock where
      419                   cli-list.obj-type = v-cli-type
      420               and cli-list.obj-code = v-cli-code no-error.
      421         if not available cli-list then next _chk-doc.
      422       end.
      423       find first dcards where
      424                 dcards.cli-type = v-cli-type
      425            and  dcards.cli-code = v-cli-code no-error.
      426       if not available dcards then do:
      427         create dcards.
      428         assign
      429         dcards.cli-type = v-cli-type
      430         dcards.cli-code = v-cli-code
      431         .
      432         if p-cli-mode = "all" then do:
      433           find first buf_clients no-lock where
      434                     buf_clients.obj-type = dcards.cli-type
      435                 and buf_clients.obj-code = dcards.cli-code.
      436           assign
      437           dcards.cli-name = buf_clients.obj-name.
      438         end.
      439         else do:
      440           assign
      441           dcards.cli-name = cli-list.obj-name.
      442         end.
      443       end.
      444       assign
      445       dcards.sum = dcards.sum + (if v-curr-r-b = 'rubl':U
      446                                  then buf_chk-doc.netto
      447                                  else (if v-base-code = 0
      448                                        then buf_chk-doc.netto
      449                                        else (buf_chk-doc.netto * buf_chk-doc.cash-rate))
      450                                  )
      451       .
      452     END.
      453   END.
      454   run waitfram-hide in this-procedure .
