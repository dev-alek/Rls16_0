        1   DEFINE BUFFER X_clients FOR ub.clients.
        2   DEFINE BUFFER X_ext-classif FOR ub.ext-classif.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   DEFINE INPUT PARAMETER  bttns       AS character NO-UNDO.
        5   DEFINE INPUT PARAMETER  p-list-mode AS character NO-UNDO.
        6   DEFINE INPUT PARAMETER  p-dop-par    AS character NO-UNDO.
        7   DEFINE input-output PARAMETER p-rid-list  AS character NO-UNDO.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Внешние системы для обмена данными по EDOC-NN".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   define new global shared variable g#language as character no-undo .
      319   if g#language <> '' and g#language <> 'rus':U then do:
      320     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      321   end.
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   define new global shared variable g#library  as handle no-undo .
      368   define new global shared variable g#library2 as handle no-undo .
      369   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370     define variable v-cntxt-db-num        as integer   no-undo .
      371     define variable v-cntxt-userid        as character no-undo .
      372     define variable v-cntxt-level         as character no-undo .
      373     define variable v-cntxt-host-code-obj as integer   no-undo .
      374     define variable v-cntxt-obj-type      as character no-undo .
      375     define variable v-cntxt-obj-code      as integer   no-undo .
      376     define variable v-cntxt-db-num-obj    as integer   no-undo .
      377     define variable v-cntxt-is-admin      as logical   no-undo .
      378   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   procedure gen-key-rec :
      380     define input  parameter p-tbl-name    as character no-undo.
      381     define input  parameter p-bh_tbl-name as handle    no-undo.
      382     define output parameter p-key-rec     as character no-undo.
      383     do
      384     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      385     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      386     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      387     :
      388       define variable fh               as handle    no-undo .
      389       define variable v-ok             as logical   no-undo .
      390       define variable v-inform         as character no-undo .
      391       define variable v-ind            as integer   no-undo .
      392       define variable v-idx-field-qnty as integer   no-undo .
      393       if p-tbl-name = ?
      394         or p-tbl-name = "":U
      395       then do:
      396         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      397       end.
      398       if not p-bh_tbl-name:available then do:
      399         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      400       end.
      401       assign
      402         p-key-rec = p-tbl-name
      403         v-inform  = p-bh_tbl-name:index-information(1)
      404         v-ind     = 2
      405       .
      406       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      407       on error undo, return error
      408       :
      409         assign
      410           v-inform = p-bh_tbl-name:index-information( v-ind )
      411           v-ind    = v-ind + 1
      412         .
      413       end.
      414       if v-inform = ?
      415         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      416         or entry( 3, v-inform, ",":U ) <> "1":U
      417       then do:
      418         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      419       end.
      420       else do:
      421         assign
      422           v-idx-field-qnty = num-entries( v-inform ) - 4
      423         .
      424         if v-idx-field-qnty < 2 then do:
      425           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      426         end.
      427         do v-ind = 1 to v-idx-field-qnty by 2
      428         on error undo, return error
      429         :
      430           assign
      431             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      432             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      433           .
      434         end.
      435       end.
      436       if p-key-rec = ? then do:
      437         assign
      438           p-key-rec = "":U
      439         .
      440         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      441       end.
      442     end.
      443     return.
      444   end procedure.
      445   procedure gen-where-keyr-tab :
      446     define input  parameter i-tableSerach as character no-undo.
      447     define input  parameter i-tablekey   as character  no-undo.
      448     define input  parameter p-key-rec    as character  no-undo.
      449     define input  parameter p-key-handle as handle     no-undo .
      450     define input  parameter p-db-name    as character  no-undo .
      451     define input  parameter p-tt-handle  as handle     no-undo .
      452     define output parameter o-Where      as character  no-undo.
      453     do
      454     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      455     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      456     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      457     :
      458       define variable v-full-tbl-name  as character no-undo .
      459       define variable bh_tbl-name      as handle    no-undo .
      460       define variable fh_key           as handle    no-undo .
      461       define variable fh_search        as handle    no-undo .
      462       define variable v-field-num      as integer   no-undo .
      463       define variable v-count-fld      as integer   no-undo .
      464       define variable v-inform         as character no-undo .
      465       define variable v-ind            as integer   no-undo .
      466       define variable v-idx-field-qnty as integer   no-undo .
      467       define variable v-field-name     as character no-undo .
      468       define variable v-field-val      as character no-undo .
      469       define variable v-word-link      as character no-undo .
      470       define variable vTable           as character no-undo.
      471       define variable bh_tbl-key       as handle    no-undo .
      472       assign
      473         p-key-rec = trim( p-key-rec )
      474       .
      475       if p-key-handle <> ? then do:
      476         if not valid-handle(p-key-handle)
      477            or p-key-handle:type <> "buffer"
      478         then do:
      479           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      480         end.
      481         if num-entries( p-key-rec, chr(3) ) > 1
      482           or p-key-rec = ?
      483           or p-key-rec = "":U
      484         then do:
      485           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      486         end.
      487       end.
      488       else do:
      489         if p-key-rec = ?
      490           or p-key-rec = "":U
      491         then do:
      492           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      493         end.
      494       end.
      495       assign
      496         vTable = entry( 1 , p-key-rec, chr(3) )
      497       .
      498       if p-tt-handle <> ?
      499         and ( not valid-handle(p-tt-handle)
      500               or p-tt-handle:type <> "buffer"
      501             )
      502       then do:
      503         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      504       end.
      505       if p-tt-handle = ? then do:
      506         assign
      507           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      508         .
      509         create buffer bh_tbl-name for table v-full-tbl-name .
      510       end.
      511       else do:
      512         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      513       end.
      514       assign
      515         v-inform = bh_tbl-name:index-information(1)
      516         v-ind    = 2
      517       .
      518       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      519       on error undo, return error
      520       :
      521         assign
      522           v-inform = bh_tbl-name:index-information( v-ind )
      523           v-ind    = v-ind + 1
      524         .
      525       end.
      526       if v-inform = ?
      527         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      528         or entry( 3, v-inform, ",":U ) <> "1":U
      529       then do:
      530         delete object bh_tbl-name no-error.
      531         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      532       end.
      533       assign
      534         v-idx-field-qnty = num-entries( v-inform ) - 4
      535       .
      536       if v-idx-field-qnty < 2 then do:
      537         delete object bh_tbl-name no-error.
      538         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      539       end.
      540       assign
      541         o-where     = "where":U
      542         v-word-link = "":U
      543         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      544         v-count-fld = 0
      545       .
      546       if i-tablekey ne "" and i-tablekey ne ?
      547       then do:
      548         assign
      549           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      550         .
      551         create buffer bh_tbl-key for table v-full-tbl-name .
      552       end.
      553       if i-tableSerach ne "" and i-tableSerach ne ?
      554       then do:
      555         delete object bh_tbl-name no-error.
      556         assign
      557           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      558         .
      559         create buffer bh_tbl-name for table v-full-tbl-name .
      560       end.
      561       block_where:
      562       do v-ind = 1 to v-idx-field-qnty by 2
      563       on error undo, return error
      564       :
      565         assign
      566           v-count-fld = v-count-fld + 1
      567         .
      568         if p-key-handle = ?
      569           and v-count-fld > v-field-num
      570         then do:
      571           leave block_where.
      572         end.
      573         define variable VfieldKeyTable as handle no-undo.
      574         assign
      575           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      576           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      577         .
      578         if     bh_tbl-key ne ?
      579         then do:
      580            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      581            if VfieldKeyTable eq ?
      582            then next block_where.
      583         end.
      584         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      585         then
      586            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      587         else
      588            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      589         if p-key-handle = ? then do:
      590           assign
      591             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      592           .
      593         end.
      594         else do:
      595           assign
      596             fh_key = p-key-handle:buffer-field( v-field-name )
      597           .
      598           if fh_key = ?
      599             or not valid-handle( fh_key )
      600           then do:
      601             delete object bh_tbl-name.
      602             if     bh_tbl-key ne ?
      603             then
      604                delete object bh_tbl-key.
      605             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      606           end.
      607           assign
      608             v-field-val = fh_key:buffer-value
      609           .
      610         end.
      611         if fh_search:data-type ="character":U then do:
      612           assign
      613             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      614             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      615             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      616             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      617             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      618             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      619             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      620             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      621             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      622             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      623             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      624             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      625             v-field-val = substitute( '"&1"', v-field-val )
      626           .
      627         end.
      628         assign
      629           o-where = substitute( "&1 &2", o-where, v-field-val )
      630         .
      631         if v-word-link = "":U then do:
      632           assign
      633             v-word-link = "and":U
      634           .
      635         end.
      636       end.
      637       delete object bh_tbl-name.
      638       if     bh_tbl-key ne ?
      639       then
      640          delete object bh_tbl-key.
      641       if p-key-handle = ?
      642         and v-count-fld <> v-field-num
      643       then do:
      644         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      645       end.
      646     end.
      647   end procedure.
      648   procedure gen-hn-keyr-tab :
      649     define input  parameter i-tableSerach as character no-undo.
      650     define input  parameter i-tablekey   as character no-undo.
      651     define input  parameter p-key-rec    as character no-undo.
      652     define input  parameter p-key-handle as handle    no-undo .
      653     define input  parameter p-db-name    as character no-undo .
      654     define input  parameter p-tt-handle  as handle    no-undo .
      655     define input  parameter p-stts-lock  as integer   no-undo .
      656     define output parameter o-hn         as handle    no-undo.
      657     define variable v-full-tbl-name as character no-undo.
      658     define variable v-where         as character no-undo.
      659     define variable bh_tbl-name     as handle    no-undo.
      660     define variable vTable          as character no-undo.
      661     do
      662     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      663     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      664     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      665         run gen-where-keyr-tab(i-tableSerach,
      666                                i-tablekey,
      667                                p-key-rec,
      668                                p-key-handle,
      669                                p-db-name,
      670                                p-tt-handle,
      671                                output v-where).
      672         if i-tableSerach ne "" and i-tableSerach ne ?
      673         then do:
      674            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      675            create buffer bh_tbl-name for table v-full-tbl-name .
      676         end.
      677         else do:
      678            if p-tt-handle = ? then do:
      679               assign
      680                  vTable = entry( 1 , p-key-rec, chr(3) )
      681               .
      682               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      683               create buffer bh_tbl-name for table v-full-tbl-name .
      684            end.
      685            else do:
      686               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      687            end.
      688         end.
      689         if p-tt-handle = ? then do:
      690            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      691         end.
      692         else do:
      693            bh_tbl-name:find-first( v-where ) no-error .
      694         end.
      695         o-hn = bh_tbl-name.
      696      end.
      697   end procedure.
      698   procedure gen-hn-keyr :
      699     define input  parameter p-key-rec    as character no-undo.
      700     define input  parameter p-key-handle as handle    no-undo .
      701     define input  parameter p-db-name    as character no-undo .
      702     define input  parameter p-tt-handle  as handle    no-undo .
      703     define input  parameter p-stts-lock  as integer   no-undo .
      704     define output parameter o-hn         as handle    no-undo.
      705     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      706   end.
      707   procedure gen-row-keyr :
      708     define input  parameter p-key-rec    as character no-undo.
      709     define input  parameter p-key-handle as handle    no-undo .
      710     define input  parameter p-db-name    as character no-undo .
      711     define input  parameter p-tt-handle  as handle    no-undo .
      712     define input  parameter p-stts-lock  as integer   no-undo .
      713     define output parameter p-tbl-row    as rowid     no-undo.
      714     define output parameter p-tbl-name   as character no-undo.
      715     define variable vHn as handle no-undo.
      716       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      717       p-tbl-row = if vHn:available then vHn:rowid else ?.
      718       p-tbl-name =  vHn:table.
      719       delete object vHn no-error.
      720     if p-tbl-row = ? then do:
      721       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      722     end.
      723     else do:
      724       return.
      725     end.
      726   end procedure.
      727   procedure gen-key-fv :
      728     define input  parameter p-key-rec    as character no-undo .
      729     define output parameter p-field-list as character no-undo .
      730     define output parameter p-value-list as character no-undo.
      731     do
      732     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      733     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      734     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      735     :
      736       define variable v-full-tbl-name  as character no-undo .
      737       define variable bh_tbl-name      as handle    no-undo .
      738       define variable v-tbl-name       as character no-undo .
      739       define variable v-field-num      as integer   no-undo .
      740       define variable v-count-fld      as integer   no-undo .
      741       define variable v-inform         as character no-undo .
      742       define variable v-ind            as integer   no-undo .
      743       define variable v-idx-field-qnty as integer   no-undo .
      744       define variable v-delim-key      as character no-undo .
      745       if p-key-rec = ?
      746         or p-key-rec = "":U
      747       then do:
      748         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      749       end.
      750       assign
      751         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      752         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      753       .
      754       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      755       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      756       assign
      757         v-inform = bh_tbl-name:index-information(1)
      758         v-ind    = 2
      759       .
      760       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      761       on error undo, return error
      762       :
      763         assign
      764           v-inform = bh_tbl-name:index-information( v-ind )
      765           v-ind    = v-ind + 1
      766         .
      767       end.
      768       if v-inform = ?
      769         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      770         or entry( 3, v-inform, ",":U ) <> "1":U
      771       then do:
      772         delete object bh_tbl-name no-error.
      773         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      774       end.
      775       assign
      776         v-idx-field-qnty = num-entries( v-inform ) - 4
      777       .
      778       if v-idx-field-qnty < 2 then do:
      779         delete object bh_tbl-name no-error.
      780         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      781       end.
      782       assign
      783         p-field-list = "":U
      784         p-value-list = "":U
      785         v-delim-key  = "":U
      786         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      787         v-count-fld  = 0
      788       .
      789       block_where:
      790       do v-ind = 1 to v-idx-field-qnty by 2
      791       on error undo, return error
      792       :
      793         assign
      794           v-count-fld = v-count-fld + 1
      795         .
      796         if v-count-fld > v-field-num then do:
      797           leave block_where.
      798         end.
      799         assign
      800           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      801           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      802         .
      803         if v-ind = 1 then do:
      804           assign
      805             v-delim-key = chr(3)
      806           .
      807         end.
      808       end.
      809       delete object bh_tbl-name.
      810       if v-count-fld <> v-field-num then do:
      811         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      812       end.
      813     end.
      814   end procedure.
      815   procedure gen-key-field :
      816     define input  parameter p-table      as character no-undo .
      817     define output parameter p-field-list as character no-undo .
      818     do
      819     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      820     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      821     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      822     :
      823       define variable v-full-tbl-name  as character no-undo .
      824       define variable bh_tbl-name      as handle    no-undo .
      825       define variable v-tbl-name       as character no-undo .
      826       define variable v-field-num      as integer   no-undo .
      827       define variable v-count-fld      as integer   no-undo .
      828       define variable v-inform         as character no-undo .
      829       define variable v-ind            as integer   no-undo .
      830       define variable v-idx-field-qnty as integer   no-undo .
      831       define variable v-delim-key      as character no-undo .
      832       if p-table = ?
      833         or p-table = "":U
      834       then do:
      835         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      836       end.
      837       assign
      838         v-tbl-name      = p-table
      839         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      840       .
      841       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      842       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      843       assign
      844         v-inform = bh_tbl-name:index-information(1)
      845         v-ind    = 2
      846       .
      847       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      848       on error undo, return error
      849       :
      850         assign
      851           v-inform = bh_tbl-name:index-information( v-ind )
      852           v-ind    = v-ind + 1
      853         .
      854       end.
      855       if v-inform = ?
      856         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      857         or entry( 3, v-inform, ",":U ) <> "1":U
      858       then do:
      859         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      860       end.
      861       assign
      862         v-idx-field-qnty = num-entries( v-inform ) - 4
      863       .
      864       if v-idx-field-qnty < 2 then do:
      865         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      866       end.
      867       assign
      868         p-field-list = "":U
      869         v-delim-key  = "":U
      870         v-count-fld  = 0
      871       .
      872       block_where:
      873       do v-ind = 1 to v-idx-field-qnty by 2
      874       on error undo, return error
      875       :
      876         assign
      877           v-count-fld = v-count-fld + 1
      878         .
      879         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      880         if v-ind = 1 then do:
      881           assign
      882             v-delim-key = chr(3)
      883           .
      884         end.
      885       end.
      886       delete object bh_tbl-name.
      887     end.
      888   end procedure.
      889   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   define variable c-point  as character no-undo .
      891   define variable tbl      as character no-undo .
      892   define variable join-tbl as character no-undo .
      893   define variable fld      as character no-undo .
      894   define variable lab      as character no-undo .
      895   define variable spr      as character no-undo .
      896   define variable dim      as character no-undo .
      897   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   procedure fltfield-clear :
      899     define output parameter loc-fld as character no-undo.
      900     define output parameter loc-lab as character no-undo .
      901     define output parameter loc-spr as character no-undo .
      902     define output parameter loc-dim as character no-undo .
      903     assign
      904       loc-fld = ""
      905       loc-lab = ""
      906       loc-spr = ""
      907       loc-dim = "0"
      908     .
      909   end procedure .
      910   procedure fltfield-add :
      911     define input        parameter par-fld as character no-undo.
      912     define input        parameter par-lab as character no-undo .
      913     define input        parameter par-spr as character no-undo .
      914     define input-output parameter loc-fld as character no-undo.
      915     define input-output parameter loc-lab as character no-undo .
      916     define input-output parameter loc-spr as character no-undo .
      917     define input-output parameter loc-dim as character no-undo .
      918     do
      919     on error undo, return error
      920     :
      921       assign
      922       loc-fld = if loc-dim = '0'
      923                 then par-fld
      924                 else (loc-fld + chr(44) + par-fld)
      925       loc-lab = if loc-dim = '0'
      926                 then par-lab
      927                 else (loc-lab + chr(44) + par-lab)
      928       loc-spr = if loc-dim = '0'
      929                 then par-spr
      930                 else (loc-spr + chr(44) + par-spr)
      931       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      932                 string(integer(if num-entries(loc-dim) > 1
      933                               then entry(2, loc-dim)
      934                               else entry(1, loc-dim)
      935                               ) + 1)
      936       no-error
      937       .
      938     end.
      939   end procedure.
      940   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   FUNCTION mark-string RETURNS CHARACTER
      942     ( input p-recid as recid, input mark-list as character  ) :
      943     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      944   END FUNCTION.
      945   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      947   procedure cur-time :
      948      define output parameter p-today as date      no-undo .
      949      define output parameter p-time  as integer   no-undo .
      950     do
      951     on error undo, return error
      952     :
      953       define variable v-date1 as date      no-undo .
      954       define variable v-date2 as date      no-undo .
      955       define variable v-time  as integer   no-undo .
      956       assign
      957         v-date1 = today
      958         v-time  = time
      959         v-date2 = today
      960       .
      961       if v-date1 <> v-date2
      962       then do:
      963         assign
      964           v-date1 = today
      965           v-time  = v-time
      966         .
      967       end.
      968       assign
      969         p-today = v-date1
      970         p-time  = v-time
      971       .
      972     end.
      973   end.
      974   function cur-time-date returns character
      975   :
      976     return string(today, '99/99/9999':U) .
      977   end.
      978   function cur-time-mjd returns decimal
      979   :
      980     define variable v-date as date      no-undo .
      981     define variable v-time as integer   no-undo .
      982     run cur-time in this-procedure
      983       (output v-date
      984       ,output v-time
      985       ) .
      986     return integer(v-date) - 2400002 + (v-time / 86400) .
      987   end.
      988   function cur-time-get-ending-index returns integer
      989   (input p-number as integer
      990   )
      991   :
      992     if p-number < 0
      993     or p-number = ?
      994     then do:
      995       return 1 .
      996     end.
      997     define variable v-rest as integer   no-undo .
      998     assign
      999       p-number = p-number modulo 100
     1000     .
     1001     if p-number < 20
     1002     then do:
     1003       assign
     1004         v-rest = p-number
     1005       .
     1006     end.
     1007     else do:
     1008       assign
     1009         v-rest = p-number modulo 10
     1010       .
     1011     end.
     1012     case v-rest :
     1013       when 1
     1014       then do:
     1015         return 2 .
     1016       end.
     1017       when 2 or
     1018       when 3 or
     1019       when 4
     1020       then do:
     1021         return 3 .
     1022       end.
     1023       otherwise do:
     1024         return 1 .
     1025       end.
     1026     end case .
     1027   end.
     1028   procedure cur-time-mjd-to-date :
     1029      define input  parameter i-mjd-diff as decimal no-undo.
     1030      define output parameter o-Date     as date    no-undo.
     1031      define output parameter o-Time     as integer no-undo.
     1032      define variable v-day-number as integer   no-undo .
     1033      if    i-mjd-diff < 0
     1034         or i-mjd-diff = ?
     1035      then do:
     1036         return "?" .
     1037      end.
     1038      assign
     1039         v-day-number = truncate(i-mjd-diff,0).
     1040         o-Date = date(v-day-number + 2400002).
     1041         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1042     .
     1043   end.
     1044   function cur-time-mjd-to-string returns character
     1045   (input p-mjd-diff as decimal
     1046   )
     1047   :
     1048     define variable v-day-number as integer   no-undo .
     1049     define variable v-seconds    as integer   no-undo .
     1050     define variable v-hour       as integer   no-undo .
     1051     define variable v-min        as integer   no-undo .
     1052     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1053     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1054     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1055     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1056     if p-mjd-diff < 0
     1057     or p-mjd-diff = ?
     1058     then do:
     1059       return "?" .
     1060     end.
     1061     assign
     1062       v-day-number = integer(truncate(p-mjd-diff,0))
     1063       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1064     .
     1065     if v-seconds > 86400
     1066     then do:
     1067       assign
     1068         v-seconds = 86400 - 1
     1069       .
     1070     end.
     1071     if v-seconds < 0
     1072     then do:
     1073       assign
     1074         v-seconds = 0
     1075       .
     1076     end.
     1077     assign
     1078       v-hour = truncate(v-seconds / 3600, 0)
     1079     .
     1080     assign
     1081       v-seconds = v-seconds modulo 3600
     1082     .
     1083     assign
     1084       v-min = truncate(v-seconds / 60, 0)
     1085     .
     1086     assign
     1087       v-seconds = v-seconds modulo 60
     1088     .
     1089     return
     1090         (if v-day-number <> 0
     1091           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1092           else ""
     1093         )
     1094       + (if v-day-number <> 0 or v-hour <> 0
     1095           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1096           else ""
     1097         )
     1098       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1099           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1100           else ""
     1101         )
     1102       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1103       .
     1104   end.
     1105   function cur-time-string returns character
     1106   :
     1107     define variable v-date as date      no-undo .
     1108     define variable v-time as integer   no-undo .
     1109     run cur-time in this-procedure
     1110       (output v-date
     1111       ,output v-time
     1112       ) .
     1113     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1114   end.
     1115   function cur-time-string-sec returns character
     1116   :
     1117     define variable v-date as date      no-undo .
     1118     define variable v-time as integer   no-undo .
     1119     run cur-time in this-procedure
     1120       (output v-date
     1121       ,output v-time
     1122       ) .
     1123     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1124   end.
     1125   function cur-time-custom  returns character
     1126   (input p-prefix as character
     1127   ,input p-date-format as character
     1128   ,input p-delimiter as character
     1129   ,input p-time-format as character
     1130   ,input p-suffix as character
     1131   )
     1132   :
     1133     define variable v-date as date      no-undo .
     1134     define variable v-time as integer   no-undo .
     1135     run cur-time in this-procedure
     1136       (output v-date
     1137       ,output v-time
     1138       ) .
     1139     return
     1140       p-prefix
     1141       + string(v-date, p-date-format)
     1142       + p-delimiter
     1143       + string(v-time, p-time-format)
     1144       + p-suffix
     1145       .
     1146   end.
     1147   function cur-time-print  returns character
     1148   :
     1149     define variable v-date as date      no-undo .
     1150     define variable v-time as integer   no-undo .
     1151     run cur-time in this-procedure
     1152       (output v-date
     1153       ,output v-time
     1154       ) .
     1155     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1156   end.
     1157   function cur-time-datetime returns datetime
     1158   :
     1159     define variable v-char as character no-undo .
     1160     define variable v-datetime as datetime no-undo .
     1161     v-char = cur-time-string().
     1162     v-datetime = datetime(v-char).
     1163     return  v-datetime.
     1164   end.
     1165   function cur-time-string-msec returns character
     1166   :
     1167     define variable v-date as datetime  no-undo .
     1168     v-date = now.
     1169     return string(v-date) .
     1170   end.
     1171   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1172   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1173   define  shared variable RepPathName        as character no-undo .
