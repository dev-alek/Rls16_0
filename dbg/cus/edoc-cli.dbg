     1564        SIZE 3 BY 1.
     1565   DEFINE BUTTON B-sel AUTO-GO
     1566        LABEL "Вы&бор"
     1567        SIZE 10 BY 1.
     1568   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1569         VIEW-AS TEXT
     1570        SIZE 6 BY 1
     1571        FGCOLOR 4  NO-UNDO.
     1572   DEFINE QUERY br-edoc-cli FOR X_ext-classif, X_clients SCROLLING.
     1573   DEFINE BROWSE br-edoc-cli
     1574     QUERY br-edoc-cli NO-LOCK DISPLAY
     1575         mark-string(recid(X_ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     1576   X_ext-classif.KEY#_one  COLUMN-LABEL "Код внешней!системы" FORMAT ">>>>>>>>9"
     1577   get-esys-name(X_ext-classif.KEY#_one) COLUMN-LABEL "Внешняя система" FORMAT "X(30)"
     1578   X_clients.obj-type COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     1579   X_clients.obj-code COLUMN-LABEL "Код!клиента" FORMAT ">>>>>>>>9"
     1580   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(60)"
     1581       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.3 BY 20.37 FIT-LAST-COLUMN.
     1582   DEFINE FRAME Dialog-Frame
     1583        b-quit AT ROW 1 COL 1
     1584        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1585        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     1586        b-add AT ROW 1 COL 31 WIDGET-ID 14
     1587        b-del AT ROW 1 COL 41 WIDGET-ID 16
     1588        b-cli AT ROW 1 COL 51 WIDGET-ID 2
     1589        b-esys AT ROW 1 COL 61 WIDGET-ID 18
     1590        b-sch AT ROW 1 COL 86 WIDGET-ID 12
     1591        b-print AT ROW 1 COL 89 WIDGET-ID 10
     1592        B-Help AT ROW 1 COL 95
     1593        br-edoc-cli AT ROW 2.87 COL 1.5 WIDGET-ID 100
     1594        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1595        SPACE(79.30) SKIP(21.26)
     1596       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1597            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1598            TITLE ""
     1599            CANCEL-BUTTON b-quit.
     1600   ASSIGN
     1601          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1602          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1603   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1604   DO:
     1605     APPLY "END-ERROR":U TO SELF.
     1606   END.
     1607   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1608   DO:
     1609     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1610     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1611   END.
     1612   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1613   DO:
     1614     IF NOT AVAILABLE X_clients THEN RETURN NO-APPLY.
     1615     run ref/showcli.p ( INPUT parparentproc
     1616                        ,INPUT X_clients.obj-type
     1617                        ,INPUT X_clients.obj-code) NO-ERROR.
     1618     APPLY "entry" TO br-edoc-cli.
     1619   END.
     1620   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1621   DO:
     1622     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1623     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1624     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1625   END.
     1626   ON CHOOSE OF b-esys IN FRAME Dialog-Frame
     1627   DO:
     1628   define variable v-have-rights    as logical        no-undo.
     1629   define variable v-success    as logical        no-undo.
     1630   define variable v-esys-id   as integer        no-undo.
     1631     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1632    ASSIGN
     1633    v-esys-id = X_ext-classif.key#_one.
     1634   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1635   do:
     1636     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1637       (input  v-cntxt-db-num
     1638       ,input  v-cntxt-userid
     1639       ,input  0
     1640       ,input  'actn_openxml-subsystem_lookup':U
     1641       ,input  'global':U
     1642       ,input  0
     1643       ,input  '':U
     1644       ,input  0
     1645       ,input  0
     1646       ,input  0
     1647       ,input  0
     1648       ,input  yes
     1649       ,output v-have-rights
     1650       )  .
     1651   end.
     1652       if v-have-rights = yes
     1653       then do:
     1654                     run bge/oxmlspci.w (
     1655                   input parparentproc
     1656                 , input 'ПРОСМОТР':U
     1657                 , input-output v-esys-id
     1658                 , input 0
     1659                 , output v-success
     1660             ) no-error.
     1661    end.
     1662     APPLY "entry" TO br-edoc-cli.
     1663   END.
     1664   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1665   DO:
     1666     define variable loc#log as logical no-undo .
     1667     if available X_ext-classif then do:
     1668   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   define variable v-str-recid15 as character no-undo .
     1670   define variable v-num-entry15 as integer   no-undo .
     1671   assign
     1672     v-str-recid15 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
     1673     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1674   .
     1675   if v-num-entry15 > 0 then do:
     1676     assign
     1677       entry( v-num-entry15, v-rid-list ) = "":U
     1678       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1679     .
     1680   end.
     1681   else do:
     1682     assign
     1683       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1684     .
     1685   end.
     1686       loc#log = br-edoc-cli:refresh() .
     1687       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1688           loc#log = br-edoc-cli:select-next-row ().
     1689           apply "VALUE-CHANGED" to br-edoc-cli in frame Dialog-Frame.
     1690       end.
     1691       if num-entries( v-rid-list ) = 0
     1692       then
     1693           hide mark-num in frame Dialog-Frame.
     1694       else
     1695           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1696     end.
     1697     apply "entry" to br-edoc-cli in frame Dialog-Frame.
     1698   END.
     1699   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1700   DO:
     1701     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1702     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1703   END.
     1704   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1705   DO:
     1706     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1707     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1708   END.
     1709   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1710   DO:
     1711       if ( available X_ext-classif ) then do:
     1712       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1713       then
     1714       v-rid-list = string( recid( X_ext-classif ) ) .
     1715     end.
     1716   END.
     1717   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1718   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1719   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1720   on help of frame Dialog-Frame
     1721   do:
     1722     run gbl/app_help.p
     1723       (input this-procedure :file-name
     1724       ,input ''
     1725       ,input ?
     1726       ) no-error.
     1727     if error-status :error then do:
     1728       message
     1729         "Ошибка при вызове помощи"
     1730         error-status :get-message(1)
     1731         view-as alert-box .
     1732     end.
     1733   end.
     1734   run minbtn-set in this-procedure .
     1735   on choose of b-help in frame Dialog-Frame
     1736   do:
     1737     apply "help":u to frame Dialog-Frame .
     1738   end.
     1739   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1740   procedure minbtn-set :
     1741       do
     1742           on error undo, return error return-value
     1743           :
     1744           define variable ii              as integer       no-undo .
     1745           define variable fh              as widget-handle no-undo .
     1746           define variable hh              as widget-handle no-undo .
     1747           define variable v-h             as handle        extent 4 no-undo .
     1748           define variable v-name-button   as character     no-undo .
     1749           define variable v-help-old-x    as decimal       no-undo .
     1750           define variable v-help-old-y    as decimal       no-undo .
     1751           define variable v-help-old-size as decimal       no-undo .
     1752           define variable v-frame-width   as decimal       no-undo .
     1753           define variable jj              as integer       no-undo .
     1754           do
     1755               on error undo, return error
     1756               :
     1757               assign
     1758                   v-frame-width = frame Dialog-Frame:width - 0.3
     1759                   fh            = frame Dialog-Frame:first-child
     1760                   hh            = fh:first-child
     1761                   ii            = 1
     1762                   .
     1763               do while valid-handle(hh):
     1764                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1765                   do:
     1766                       case lc(hh:name) :
     1767                           when "b-help" then
     1768                               do:
     1769                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1770                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1771                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1772                                   hh:TOOLTIP = "Помощь" .
     1773                                   v-help-old-x = hh:column .
     1774                                   v-help-old-y = hh:row    .
     1775                                   v-help-old-size = hh:width .
     1776                                   hh:width-chars = 2.5 .
     1777                               end.
     1778                           when "b-print" then
     1779                               do:
     1780                                   hh:load-image("cmp/b-print.bmp":u) .
     1781                                   hh:TOOLTIP = "Печать" .
     1782                                   v-h[ii] = hh:handle .
     1783                                   ii = ii + 1 .
     1784                                   hh:width-chars = 3 .
     1785                               end.
     1786                           when "b-history" or
     1787                           when "b-hist" then
     1788                               do:
     1789                                   hh:load-image("cmp/b-hist.bmp":u) .
     1790                                   hh:TOOLTIP = "История" .
     1791                                   v-h[ii] = hh:handle .
     1792                                   ii = ii + 1 .
     1793                                   hh:width-chars = 3 .
     1794                               end.
     1795                           when "b-sch" then
     1796                               do:
     1797                                   hh:load-image("cmp/b-sch.bmp":u) .
     1798                                   hh:TOOLTIP = "Установка Фильтра" .
     1799                                   v-h[ii] = hh:handle .
     1800                                   ii = ii + 1 .
     1801                                   hh:width-chars = 3 .
     1802                               end.
     1803                           when "b-hist-user" then
     1804                               do:
     1805                                   hh:load-image("cmp/b-hist.bmp":u) .
     1806                                   hh:TOOLTIP = "История пользователя" .
     1807                                   ii = ii + 1 .
     1808                               end.
     1809                       end case.
     1810                   end.
     1811                   hh = hh:next-sibling.
     1812               end.
     1813               b-help:column = v-frame-width - b-help:width-chars.
     1814               jj = 0.
     1815               repeat ii = 4 to 1 by -1 :
     1816                   if valid-handle (v-h[ii] ) then
     1817                   do:
     1818                       jj  = jj + 1 .
     1819                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1820                       v-h[ii]:row    = v-help-old-y .
     1821                   end.
     1822               end.
     1823           end.
     1824       end.
     1825   end procedure.
     1826   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1827   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1828   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1829   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1830   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1831   define variable v-diasize-current-frame-height as decimal   no-undo .
     1832   define variable v-diasize-change-size          as logical   no-undo .
     1833   define variable v-diasize-resize-button        as handle    no-undo .
     1834   define variable v-diasize-wndmax               as logical   no-undo .
     1835   define variable v-diasize-wndstore             as logical   no-undo .
     1836   define variable v-diasize-proc-name            as character no-undo .
     1837   define variable v-diasize-browse-handle        as handle    no-undo .
     1838   define variable v-diasize-browse-number        as integer   no-undo .
     1839   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1840   define temp-table temp-diasize-handle no-undo
     1841     field handle-value  as handle
     1842     field save-position as decimal
     1843     index xpk is primary unique handle-value
     1844     .
     1845   define temp-table temp-browse-handle no-undo
     1846     field browse-type   as character
     1847     field browse-number as integer
     1848     field browse-handle as handle
     1849     field original-size as decimal
     1850     index xpk is primary unique browse-type browse-number
     1851     index xie browse-type browse-handle
     1852   .
     1853   procedure diasize_change-height :
     1854     define input  parameter p-change-value  as decimal   no-undo .
     1855     define input  parameter p-move-resize   as logical   no-undo .
     1856     define variable v-field-group-handle    as handle    no-undo .
     1857     define variable v-object-handle         as handle    no-undo .
     1858     define variable v-frame-height          as decimal   no-undo .
     1859     define variable v-frame-virtual-height  as decimal   no-undo .
     1860     define variable v-browse-height         as decimal   no-undo .
     1861     define variable v-window-height         as decimal   no-undo .
     1862     define variable v-window-virtual-height as decimal   no-undo .
     1863     define variable v-change-sign           as integer   no-undo .
     1864     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1865     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1866     if p-change-value > 0
     1867     then do:
     1868       if frame Dialog-Frame :height + p-change-value
     1869           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1870       then do:
     1871         assign
     1872           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1873                           - (frame Dialog-Frame :height-chars)
     1874         .
     1875         if p-change-value <= 0
     1876         then do:
     1877           run diasize_position-resize-button in this-procedure .
     1878           return .
     1879         end.
     1880       end.
     1881     end.
     1882     if p-change-value < 0
     1883     then do:
     1884       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1885       then do:
     1886         assign
     1887           p-change-value = v-diasize-orig-frame-height
     1888                          - (frame Dialog-Frame :height-chars)
     1889         .
     1890         if p-change-value >= 0
     1891         then do:
     1892           run diasize_position-resize-button in this-procedure .
     1893           return .
     1894         end.
     1895       end.
     1896     end.
     1897     if p-change-value >= 0
     1898     then do:
     1899       assign
     1900         v-change-sign = 1
     1901       .
     1902     end.
     1903     else do:
     1904       assign
     1905         v-change-sign = -1
     1906       .
     1907     end.
     1908     assign
     1909       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1910     .
     1911     if p-change-value = 0
     1912     then do:
     1913       run diasize_position-resize-button in this-procedure .
     1914       return .
     1915     end.
     1916     move_block:
     1917     do
     1918     on error undo move_block, retry move_block
     1919     :
     1920       if retry
     1921       then do:
     1922         do
     1923         on error undo move_block, leave move_block
     1924         :
     1925           if p-change-value > 0
     1926           then do:
     1927             for each buf_temp-diasize-handle
     1928             on error undo, next
     1929             :
     1930               assign
     1931                 v-object-handle = buf_temp-diasize-handle.handle-value
     1932               .
     1933               if v-object-handle <> v-diasize-resize-button
     1934               then do:
     1935                 assign
     1936                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1937                 .
     1938               end.
     1939             end.
     1940             assign
     1941               v-diasize-browse-handle :height = v-browse-height
     1942             .
     1943             for each buf_temp-browse-handle
     1944               where buf_temp-browse-handle.browse-type = 'height':u
     1945             on error undo, next
     1946             :
     1947               assign
     1948                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1949               .
     1950             end.
     1951             assign
     1952               frame Dialog-Frame :height = v-frame-height
     1953             .
     1954             if frame Dialog-Frame :scrollable = true
     1955             then do:
     1956               assign
     1957                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1958               .
     1959             end.
     1960             run diasize_position-resize-button in this-procedure .
     1961           end.
     1962           else do:
     1963             if frame Dialog-Frame :scrollable = true
     1964             then do:
     1965               assign
     1966                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1967               .
     1968             end.
     1969             assign
     1970               frame Dialog-Frame :height = v-frame-height
     1971             .
     1972             assign
     1973               v-diasize-browse-handle :height = v-browse-height
     1974             .
     1975             for each buf_temp-browse-handle
     1976               where buf_temp-browse-handle.browse-type = 'height':u
     1977             on error undo, next
     1978             :
     1979               assign
     1980                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1981               .
     1982             end.
     1983             for each buf_temp-diasize-handle
     1984             on error undo, next
     1985             :
     1986               assign
     1987                 v-object-handle = buf_temp-diasize-handle.handle-value
     1988               .
     1989               if v-object-handle <> v-diasize-resize-button
     1990               then do:
     1991                 assign
     1992                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1993                 .
     1994               end.
     1995             end.
     1996             run diasize_position-resize-button in this-procedure .
     1997           end.
     1998           assign
     1999             v-diasize-change-size = false
     2000           .
     2001           leave move_block .
     2002         end.
     2003       end.
     2004       assign
     2005         v-diasize-need-full-display = true
     2006       .
     2007       if v-diasize-change-size = false
     2008       then do:
     2009         assign
     2010           v-diasize-change-size = true
     2011         .
     2012       end.
     2013       else do:
     2014         return .
     2015       end.
     2016       assign
     2017         v-frame-height = frame Dialog-Frame :height
     2018         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2019         v-browse-height = v-diasize-browse-handle :height
     2020       .
     2021       for each buf_temp-browse-handle
     2022         where buf_temp-browse-handle.browse-type = 'height':u
     2023       :
     2024         assign
     2025           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2026         .
     2027       end.
     2028       for each buf_temp-diasize-handle
     2029       :
     2030         delete buf_temp-diasize-handle .
     2031       end.
     2032       assign
     2033         v-field-group-handle = frame Dialog-Frame :first-child
     2034       .
     2035       do while valid-handle(v-field-group-handle)
     2036       :
     2037         assign
     2038           v-object-handle = v-field-group-handle :first-child
     2039         .
     2040         do while valid-handle(v-object-handle)
     2041         :
     2042           if  v-object-handle <> v-diasize-browse-handle :handle
     2043           and can-query(v-object-handle, "row")
     2044           and can-query(v-object-handle, "height")
     2045           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2046           then do:
     2047             find first buf_temp-browse-handle
     2048               where buf_temp-browse-handle.browse-type   = 'height':u
     2049                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2050               no-error .
     2051             if available buf_temp-browse-handle
     2052             then do:
     2053             end.
     2054             else do:
     2055               create buf_temp-diasize-handle .
     2056               assign
     2057                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2058                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2059               .
     2060             end.
     2061           end.
     2062           assign
     2063             v-object-handle = v-object-handle :next-sibling
     2064           .
     2065         end.
     2066         assign
