     2228   procedure diasize_set-height :
     2229     define input  parameter p-new-height  as decimal   no-undo .
     2230     define input  parameter p-move-resize as logical   no-undo .
     2231     do
     2232     on error undo, return error return-value
     2233     :
     2234       run diasize_change-height in this-procedure
     2235         (input  (p-new-height - frame Dialog-Frame :height)
     2236         ,input  p-move-resize
     2237         ) .
     2238     end.
     2239   end procedure.
     2240   procedure diasize_change-width :
     2241     define input  parameter p-change-value as decimal   no-undo .
     2242     define input  parameter p-move-resize  as logical   no-undo .
     2243     define variable v-field-group-handle   as handle    no-undo .
     2244     define variable v-object-handle        as handle    no-undo .
     2245     define variable v-frame-width          as decimal   no-undo .
     2246     define variable v-frame-virtual-width  as decimal   no-undo .
     2247     define variable v-browse-width         as decimal   no-undo .
     2248     define variable v-window-width         as decimal   no-undo .
     2249     define variable v-window-virtual-width as decimal   no-undo .
     2250     define variable v-change-sign          as integer   no-undo .
     2251     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2252     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2253     if p-change-value > 0
     2254     then do:
     2255       if frame Dialog-Frame :width + p-change-value >
     2256           session :width-chars
     2257       then do:
     2258         assign
     2259           p-change-value = session :width-chars - frame Dialog-Frame :width
     2260         .
     2261         if p-change-value <= 0
     2262         then do:
     2263           run diasize_position-resize-button in this-procedure .
     2264           return .
     2265         end.
     2266       end.
     2267     end.
     2268     if p-change-value < 0
     2269     then do:
     2270       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2271       then do:
     2272         assign
     2273           p-change-value = v-diasize-orig-frame-width
     2274                          - frame Dialog-Frame :width
     2275         .
     2276         if p-change-value >= 0
     2277         then do:
     2278           run diasize_position-resize-button in this-procedure .
     2279           return .
     2280         end.
     2281       end.
     2282     end.
     2283     if p-change-value >= 0
     2284     then do:
     2285       assign
     2286         v-change-sign = 1
     2287       .
     2288     end.
     2289     else do:
     2290       assign
     2291         v-change-sign = -1
     2292       .
     2293     end.
     2294     assign
     2295       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2296     .
     2297     if p-change-value = 0
     2298     then do:
     2299       run diasize_position-resize-button in this-procedure .
     2300       return .
     2301     end.
     2302     move_block:
     2303     do
     2304     on error undo move_block, leave move_block
     2305     :
     2306       if retry
     2307       then do:
     2308         do
     2309         on error undo move_block, leave move_block
     2310         :
     2311           if p-change-value > 0
     2312           then do:
     2313             for each buf_temp-diasize-handle
     2314             on error undo, next
     2315             :
     2316               assign
     2317                 v-object-handle = buf_temp-diasize-handle.handle-value
     2318               .
     2319               if v-object-handle <> v-diasize-resize-button
     2320               then do:
     2321                 assign
     2322                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2323                 .
     2324               end.
     2325             end.
     2326             assign
     2327               v-diasize-browse-handle :width = v-browse-width
     2328             .
     2329             for each buf_temp-browse-handle
     2330               where buf_temp-browse-handle.browse-type = 'width':u
     2331             on error undo, next
     2332             :
     2333               assign
     2334                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2335               .
     2336             end.
     2337             assign
     2338               frame Dialog-Frame :width = v-frame-width
     2339             .
     2340             if frame Dialog-Frame :scrollable = true
     2341             then do:
