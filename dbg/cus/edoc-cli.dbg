     1176   define  stream PrnLibStream.
     1177   procedure prn-lib-prn-file :
     1178     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1179     define input parameter p-DIsabledoptions as integer no-undo .
     1180     define variable v-report-name as character no-undo .
     1181     define variable v-user-action as character no-undo .
     1182     define variable v-printed     as logical   no-undo .
     1183     define variable v-exist       as logical   no-undo .
     1184     do
     1185       on error undo, return error
     1186       :
     1187       run prn-lib-get-report-name  in this-procedure (
     1188         input parParentProc
     1189         ,output v-report-name
     1190         ).
     1191   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1192   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1193     (input  v-report-name
     1194     ,input  2
     1195     ,output v-exist
     1196     )  .
     1197       if NOT v-exist then
     1198       DO:
     1199         Message
     1200           "Нет заданий на печать ! "
     1201           view-as alert-box .
     1202         Return  .
     1203       End.
     1204       run gbl/prnfilen.w
     1205         (input  ""
     1206         ,input  p-DisabledOptions
     1207         ,input  string(v-report-name )
     1208         ,input  7
     1209         ,output v-user-action
     1210         ,output v-printed
     1211         ) .
     1212       if v-printed then
     1213       do:
     1214         return "YES" .
     1215       end.
     1216       else
     1217       do:
     1218         return "NO" .
     1219       end.
     1220     end.
     1221   end procedure.
     1222   procedure prn-lib-open-stream :
     1223     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1224     define input parameter p-page-size    as integer no-undo .
     1225     define input parameter p-is-stream    as logical no-undo .
     1226     define input parameter p-append       as logical no-undo .
     1227     define variable v-report-name as character no-undo .
     1228     do
     1229       on error undo, return error
     1230       :
     1231       run prn-lib-get-report-name  in this-procedure (
     1232         input parParentProc
     1233         ,output v-report-name
     1234         ).
     1235       if p-is-stream then
     1236       do:
     1237         if p-append then
     1238         do:
     1239           output stream PrnLibStream to value( v-report-name )
     1240             page-size value(p-page-size) append .
     1241         end.
     1242         if not p-append then
     1243         do:
     1244           output stream PrnLibStream to value( v-report-name )
     1245             page-size value(p-page-size) .
     1246         end.
     1247       end.
     1248       if not p-is-stream then
     1249       do:
     1250         if p-append then
     1251         do:
     1252           output to value( v-report-name )
     1253             page-size value(p-page-size) append .
     1254         end.
     1255         if not p-append then
     1256         do:
     1257           output to value( v-report-name )
     1258             page-size value(p-page-size) .
     1259         end.
     1260       end.
     1261     end.
     1262   end procedure.
     1263   procedure prn-lib-open-exp :
     1264     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1265     define input parameter p-is-stream    as logical no-undo .
     1266     define input parameter p-is-append    as logical no-undo .
     1267     define output parameter p-ReportFileName as char init "report" no-undo.
     1268     define output parameter p-process as logical no-undo .
     1269     define variable glog as logical no-undo .
     1270     do
     1271       on error undo, return error
     1272       :
     1273       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1274         TITLE      "Укажите путь"
     1275         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1276         ASK-OVERWRITE
     1277         CREATE-TEST-FILE
     1278         SAVE-AS
     1279         USE-FILENAME
     1280         DEFAULT-EXTENSION "txt"
     1281         UPDATE glog
     1282         .
     1283       if not glog then  return.
     1284       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1285       if p-is-stream then
     1286       do:
     1287         if p-is-append then
     1288         do:
     1289           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1290         end.
     1291         else
     1292         do:
     1293           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1294         end.
     1295       end.
     1296       else
     1297       do:
     1298         if p-is-append then
     1299         do:
     1300           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1301         end.
     1302         else
     1303         do:
     1304           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1305         end.
     1306       end.
     1307       p-process = yes.
     1308     end.
     1309   end procedure.
     1310   procedure prn-lib-get-report-name :
     1311     define input parameter parParentProc  as widget-handle no-undo.
     1312     define output parameter p-report-name as character no-undo .
     1313     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1314   end procedure.
     1315   procedure prn-lib-reportviewer-report-name :
     1316     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1317     define input parameter p-report-name-html as character no-undo .
     1318     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1319   end procedure.
     1320   procedure prn-lib-reportviewer :
     1321     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1322     define input parameter p-report-name-html as character no-undo .
     1323     define input parameter p-param        as character no-undo .
     1324     define variable v-excel           as character no-undo init 'TRUE' .
     1325     define variable v-value-character as character no-undo .
     1326     define variable v-value-integer   as character no-undo .
     1327     define variable v-value-date      as date      no-undo .
     1328     define variable v-value-decimal   as decimal   no-undo .
     1329     define variable rep-excel         as logical   no-undo .
     1330     define variable excel-string      as character no-undo .
     1331     define variable v-param-type      as character no-undo .
     1332     define variable v-tth             as handle    no-undo .
     1333     run adm/shattri.p (
     1334       input "get":U
     1335       ,input  ""
     1336       ,input  0
     1337       ,input  'report-glob':U
     1338       ,input  'rep-excel':U
     1339       ,output v-value-character
     1340       ,output v-value-date
     1341       ,output v-value-decimal
     1342       ,output v-value-integer
     1343       ,output rep-excel
     1344       ,output v-param-type
     1345       ,INPUT-OUTPUT table-handle v-tth
     1346       )  .
     1347     if rep-excel then v-excel = "TRUE" .
     1348     else v-excel = "FALSE" .
     1349     if p-param eq ""
     1350     then
     1351        p-param = "EXCEL:" + v-excel.
     1352     else
     1353        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1354     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1355   end procedure.
     1356   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1357   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1358   procedure fltopend_fltopend :
     1359   define input parameter p-parent-handle as handle no-undo .
     1360   define input parameter p-qh as handle no-undo .
     1361   define input parameter p-flt-open-open-query  as character no-undo .
     1362   define input parameter p-where-cond as character no-undo .
     1363   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1364   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1365   define input parameter p-indexed-reposition as character no-undo .
     1366     do
     1367     on error undo, return error
     1368     :
     1369   define variable v-prepare-string as character no-undo .
     1370   define variable glog as logical no-undo .
     1371   assign
     1372   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1373                      p-where-cond + chr(32)  +
     1374                      p-use-indFIRST-query-tail + chr(32) +
     1375                      p-use-ind-sort-clmn-by + chr(32) +
     1376                      p-indexed-reposition
     1377   .
     1378   assign
     1379   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1380   if not glog
     1381   or error-status:error then do:
     1382     message error-status:get-message(1) view-as alert-box .
     1383     undo, return error .
     1384   end.
     1385   assign
     1386   glog = p-qh:query-open no-error .
     1387   if not glog
     1388   or error-status:error then do:
     1389     message error-status:get-message(1) view-as alert-box .
     1390     undo, return error .
     1391   end.
     1392     end.
     1393   end procedure.
     1394   procedure fltopend_fltfindd :
     1395   define input parameter p-parent-handle as handle no-undo .
     1396   define input parameter p-qh as handle no-undo .
     1397   define input parameter p-rowid as rowid no-undo .
     1398   define input parameter p-next as logical no-undo .
     1399   define input parameter p-lock as integer no-undo .
     1400   define input parameter p-bh as handle no-undo .
     1401   define input parameter p-where-cond as character no-undo .
     1402   define input parameter p-use-index-phrase as character no-undo .
     1403   define variable glog as logical no-undo .
     1404   define variable v-qh as handle no-undo .
     1405   define variable v-bh as handle no-undo .
     1406   define variable v-recid as recid no-undo .
     1407   define variable v-prepare-string as character no-undo .
     1408   do
     1409   on error undo, return error
     1410   on stop undo, return error
     1411   :
     1412     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1413     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1414     create query v-qh.
     1415     v-qh:set-buffers(v-bh).
     1416     v-prepare-string = substitute("for each &1 &2 &3"
     1417                                     ,v-bh:name
     1418                                     ,p-where-cond
     1419                                     ,p-use-index-phrase).
     1420     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1421     if not glog then do:
     1422       delete object v-qh.
     1423       delete object v-bh.
     1424       undo, return error .
     1425     end.
     1426     glog = v-qh:query-open no-error .
     1427     if not glog then do:
     1428       delete object v-qh.
     1429       delete object v-bh.
     1430       undo, return error .
     1431     end.
     1432     if p-next then do:
     1433       v-qh:reposition-to-rowid(p-rowid) no-error .
     1434       glog = v-qh:get-next( p-lock) no-error .
     1435       glog = v-qh:get-next( p-lock) no-error .
     1436       if not glog or v-qh:query-off-end = yes then do:
     1437         glog = v-qh:get-first( p-lock) no-error .
     1438       end.
     1439     end.
     1440     else do:
     1441       glog = v-qh:get-first( p-lock) no-error .
     1442     end.
     1443     v-recid = v-bh:recid no-error .
     1444     delete object v-qh.
     1445     delete object v-bh.
     1446     return string(v-recid) .
     1447   end.
     1448   end procedure.
     1449   procedure fltopend_fltfindq :
     1450   define input parameter p-parent-handle as handle no-undo .
     1451   define input parameter p-qh as handle no-undo .
     1452   define input parameter p-next as logical no-undo .
     1453   define input parameter p-lock as integer no-undo .
     1454   define input parameter p-flt-open-open-query  as character no-undo .
     1455   define input parameter p-where-cond as character no-undo .
     1456   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1457   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1458   define input parameter p-indexed-reposition as character no-undo .
     1459   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1460   define variable glog as logical no-undo .
     1461   define variable v-qh as handle no-undo .
     1462   define variable v-bh as handle no-undo extent 18.
     1463   define variable v-rowid as rowid no-undo extent 18.
     1464   define variable v-ii as integer no-undo .
     1465   define variable v-prepare-string as character no-undo .
     1466   do
     1467   on error undo, return error
     1468   on stop undo, return error
     1469   :
     1470     create query v-qh.
     1471     do v-ii = 1 to p-qh:num-buffers:
     1472       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1473       assign
     1474       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1475       no-error.
     1476       v-qh:add-buffer(v-bh[v-ii]).
     1477     end.
     1478     assign
     1479     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1480                       p-where-cond + chr(32)  +
     1481                       p-use-indFIRST-query-tail + chr(32) +
     1482                       p-use-ind-sort-clmn-by + chr(32) +
     1483                       p-indexed-reposition
     1484     .
     1485     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1486     if not glog then do:
     1487       delete object v-qh.
     1488       do v-ii = 1 to p-qh:num-buffers:
     1489         delete object v-bh[v-ii].
     1490       end.
     1491       undo, return error .
     1492     end.
     1493     glog = v-qh:query-open no-error .
     1494     if not glog then do:
     1495       delete object v-qh.
     1496       do v-ii = 1 to p-qh:num-buffers:
     1497         delete object v-bh[v-ii].
     1498       end.
     1499       undo, return error .
     1500     end.
     1501     if p-next then do:
     1502       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1503       glog = v-qh:get-next( p-lock) no-error .
     1504       glog = v-qh:get-next( p-lock) no-error .
     1505       if not glog or v-qh:query-off-end = yes then do:
     1506         glog = v-qh:get-first( p-lock) no-error .
     1507       end.
     1508     end.
     1509     else do:
     1510       glog = v-qh:get-first( p-lock) no-error .
     1511     end.
     1512     do v-ii = 1 to p-qh:num-buffers:
     1513       assign
     1514       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1515       no-error.
     1516     end.
     1517     delete object v-qh.
     1518     do v-ii = 1 to p-qh:num-buffers:
     1519       delete object v-bh[v-ii].
     1520     end.
     1521   end.
     1522   end procedure.
     1523   define variable sort-column-name as character no-undo.
     1524   define variable filter-point     as character NO-UNDO INIT "edoc-nn".
     1525   define variable filter-label     as character NO-UNDO INIT "Внешние системы для обмена данными по EDOC-NN".
     1526   define variable filter-point0    as character NO-UNDO INIT "edoc-nn".
     1527   define variable filter-label0    as character NO-UNDO INIT "Внешние системы для обмена данными по EDOC-NN".
     1528   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1529   define variable v-esys-id as integer no-undo .
     1530   FUNCTION get-cli-name RETURNS CHARACTER
     1531     ( INPUT p-uniq-key-rec AS CHARACTER )  FORWARD.
     1532   FUNCTION get-cli-type-code RETURNS CHARACTER
     1533     ( INPUT p-uniq-key-rec AS character )  FORWARD.
     1534   FUNCTION get-esys-name RETURNS CHARACTER
     1535     ( INPUT p-esys-id AS integer )  FORWARD.
     1536   DEFINE BUTTON b-add
     1537        LABEL "&Добавить"
     1538        SIZE 10 BY 1.
     1539   DEFINE BUTTON b-cli
     1540        LABEL "Клиент"
     1541        SIZE 10 BY 1.
     1542   DEFINE BUTTON b-del
     1543        LABEL "&Удалить"
     1544        SIZE 10 BY 1.
     1545   DEFINE BUTTON b-esys
     1546        LABEL "ВС"
     1547        SIZE 10 BY 1.
     1548   DEFINE BUTTON B-Help
     1549        LABEL "Помо&щь"
     1550        SIZE 3 BY 1
     1551        BGCOLOR 8 .
     1552   DEFINE BUTTON B-mark
     1553        LABEL "&*"
     1554        SIZE 3 BY 1.
     1555   DEFINE BUTTON b-print
     1556        LABEL "&Печать"
     1557        SIZE 3 BY 1.
     1558   DEFINE BUTTON b-quit AUTO-END-KEY
     1559        LABEL "&Выход"
     1560        SIZE 10 BY 1
     1561        BGCOLOR 8 .
     1562   DEFINE BUTTON b-sch
