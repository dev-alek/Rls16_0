     2609       end.
     2610     end.
     2611     assign
     2612       v-diasize-change-size = false
     2613     .
     2614   end procedure.
     2615   procedure diasize_set-width :
     2616     define input  parameter p-new-width  as decimal   no-undo .
     2617     define input  parameter p-move-resize as logical   no-undo .
     2618     do
     2619     on error undo, return error return-value
     2620     :
     2621       run diasize_change-width in this-procedure
     2622         (input  (p-new-width - frame Dialog-Frame :width)
     2623         ,input  p-move-resize
     2624         ) .
     2625     end.
     2626   end procedure.
     2627   procedure diasize_position-resize-button :
     2628     do with frame Dialog-Frame
     2629     :
     2630       hide v-diasize-resize-button .
     2631       assign
     2632         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2633                     - 1
     2634                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2635         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2636                     - 1
     2637                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2638       .
     2639       view v-diasize-resize-button .
     2640     end.
     2641   end procedure.
     2642   on alt-right anywhere
     2643   do:
     2644     run diasize_change-width in this-procedure
     2645       (input 1
     2646       ,input true
     2647       ) .
     2648     return no-apply .
     2649   end.
     2650   on alt-left anywhere
     2651   do:
     2652     run diasize_change-width in this-procedure
     2653       (input -1
     2654       ,input true
     2655       ) .
     2656     return no-apply .
     2657   end.
     2658   on alt-down anywhere
     2659   do:
     2660     run diasize_change-height in this-procedure
     2661       (input 1
     2662       ,input true
     2663       ) .
     2664     return no-apply .
     2665   end.
     2666   on alt-up anywhere
     2667   do:
     2668     run diasize_change-height in this-procedure
     2669       (input -1
     2670       ,input true
     2671       ) .
     2672     return no-apply .
     2673   end.
     2674   on alt-enter of frame Dialog-Frame
     2675   do:
     2676     run diasize_maximize in this-procedure
     2677       (input  ?
     2678       ).
     2679     return no-apply .
     2680   end.
     2681   procedure diasize_end-move :
     2682     do
     2683     on error undo, return error return-value
     2684     :
     2685       define variable v-row-delta as decimal   no-undo .
     2686       define variable v-col-delta as decimal   no-undo .
     2687       define variable v-new-row as decimal   no-undo .
     2688       define variable v-new-col as decimal   no-undo .
     2689       assign
     2690         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2691         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2692       .
     2693       assign
     2694         v-row-delta = v-new-row - frame Dialog-Frame :height
     2695         v-col-delta = v-new-col - frame Dialog-Frame :width
     2696       .
     2697       run diasize_change-height in this-procedure
     2698         (input v-row-delta
     2699         ,input true
     2700         ) .
     2701       run diasize_change-width in this-procedure
     2702         (input v-col-delta
     2703         ,input true
     2704         ) .
     2705     end.
     2706   end procedure.
     2707   procedure diasize_maximize :
     2708     define input  parameter p-action as logical   no-undo .
     2709     do
     2710     on error undo, return error return-value
     2711     :
     2712       if p-action = ?
     2713       then do:
     2714         if v-diasize-need-maximize = true
     2715         then do:
     2716           assign
     2717             p-action = true
     2718           .
     2719         end.
     2720         else do:
     2721           assign
     2722             p-action = false
     2723           .
     2724         end.
     2725       end.
     2726       if p-action = true
     2727       then do:
     2728         run diasize_change-height in this-procedure
     2729           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2730               - frame Dialog-Frame :height-chars
     2731           ,input true
     2732           ) .
     2733         run diasize_change-width in this-procedure
     2734           (input session :width-chars
     2735               - frame Dialog-Frame :width-chars
     2736           ,input true
     2737           ) .
     2738         assign
     2739           v-diasize-need-maximize = false
     2740         .
     2741       end.
     2742       else do:
     2743         run diasize_change-width in this-procedure
     2744           (input v-diasize-orig-frame-width
     2745               - frame Dialog-Frame :width-chars
     2746           ,input true
     2747           ) .
     2748         run diasize_change-height in this-procedure
     2749           (input v-diasize-orig-frame-height
     2750               - frame Dialog-Frame :height-chars
     2751           ,input true
     2752           ) .
     2753         assign
     2754           v-diasize-need-maximize = true
     2755         .
     2756       end.
     2757     end.
     2758   end procedure.
     2759   procedure diasize_restore-orig-size :
     2760     do
     2761     on error undo, return error return-value
     2762     :
     2763       assign
     2764         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2765         v-diasize-current-frame-height = frame Dialog-Frame :height
     2766       .
     2767       run diasize_set-height in this-procedure
     2768         (input  v-diasize-orig-frame-height
     2769         ,input  true
     2770         ) .
     2771       run diasize_set-width in this-procedure
     2772         (input  v-diasize-orig-frame-width
     2773         ,input  true
     2774         ) .
     2775     end.
     2776   end procedure.
     2777   procedure diasize_restore-current-size :
     2778     do
     2779     on error undo, return error return-value
     2780     :
     2781       run diasize_set-height in this-procedure
     2782         (input  v-diasize-current-frame-height
     2783         ,input  true
     2784         ) .
     2785       run diasize_set-width in this-procedure
     2786         (input  v-diasize-current-frame-width
     2787         ,input  true
     2788         ) .
     2789     end.
     2790   end procedure.
     2791   procedure diasize_set-browse-handle :
     2792     define input  parameter p-browse-handle as handle   no-undo .
     2793     define buffer buf_temp-browse-handle for temp-browse-handle .
     2794     do
     2795     on error undo, return error return-value
     2796     :
     2797       assign
     2798         v-diasize-browse-handle = p-browse-handle
     2799       .
     2800       for each buf_temp-browse-handle
     2801       on error undo, return error return-value
     2802       :
     2803         delete buf_temp-browse-handle .
     2804       end.
     2805     end.
     2806   end procedure.
     2807   procedure diasize_add_browse :
     2808     define input  parameter p-browse-type   as character no-undo .
     2809     define input  parameter p-browse-handle as handle    no-undo .
     2810     define buffer buf_temp-browse-handle for temp-browse-handle .
     2811     do
     2812     on error undo, return error return-value
     2813     :
     2814       assign
     2815         v-diasize-browse-number = v-diasize-browse-number + 1
     2816       .
     2817       create buf_temp-browse-handle .
     2818       assign
     2819         buf_temp-browse-handle.browse-type   = p-browse-type
     2820         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2821         buf_temp-browse-handle.browse-handle = p-browse-handle
     2822       .
     2823     end.
     2824   end procedure.
     2825   procedure diasize_init :
     2826     define variable v-default-value    as logical   no-undo .
     2827     define variable v-restore-saved    as logical   no-undo .
     2828     define variable v-resize-value-str as character no-undo .
     2829     do
     2830     on error undo, return error return-value
     2831     :
     2832       do with frame Dialog-Frame
     2833       :
     2834         assign
     2835           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2836           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2837           v-diasize-browse-handle     = browse br-edoc-cli :handle
     2838         .
     2839         create button v-diasize-resize-button
     2840         assign
     2841           parent        = frame Dialog-Frame :first-child
     2842           label         = "s"
     2843           height-pixels = 16
     2844           width-pixels  = 16
     2845           visible       = true
     2846           sensitive     = true
     2847           movable       = true
     2848           triggers:
     2849             on end-move persistent run diasize_end-move in this-procedure .
     2850           end triggers.
     2851         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2852         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2853         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2854         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2855         assign
     2856           v-diasize-wndmax = false
     2857         .
     2858         if connected("ub") = true
     2859         then do:
     2860           define variable v-cntxt-db-num        as integer   no-undo .
     2861           define variable v-cntxt-userid        as character no-undo .
     2862           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2863                                             , OUTPUT v-cntxt-userid
     2864                                             ) .
     2865           run gbl/wndpar_r.p
     2866             (input  v-cntxt-db-num
     2867             ,input  v-cntxt-userid
     2868             ,input  'wndmax':U
     2869             ,output v-diasize-wndmax
     2870             ,output v-default-value
     2871             ) .
     2872         end.
     2873         assign
     2874           v-diasize-wndstore = false
     2875         .
     2876         if connected("ub") = true
     2877         then do:
     2878           run gbl/wndpar_r.p
     2879             (input  v-cntxt-db-num
     2880             ,input  v-cntxt-userid
     2881             ,input  'wndstore':U
     2882             ,output v-diasize-wndstore
     2883             ,output v-default-value
     2884             ) .
     2885         end.
     2886         assign
     2887           v-diasize-proc-name = entry(1, program-name(2), '.')
     2888         .
     2889         if v-diasize-wndstore = true
     2890         then do:
     2891           assign
     2892             v-restore-saved = false
     2893           .
     2894           if connected("ub") = true
     2895           then do:
     2896             run gbl/wndsizer.p
     2897               (input  v-cntxt-db-num
     2898               ,input  v-cntxt-userid
     2899               ,input  v-diasize-proc-name
     2900               ,input  'height':u
     2901               ,output v-resize-value-str
     2902               ) .
     2903             if v-resize-value-str <> '':U
     2904             then do:
     2905               run diasize_change-height in this-procedure
     2906                 (input  integer(v-resize-value-str)
     2907                 ,input  true
     2908                 ) .
     2909               assign
     2910                 v-restore-saved = true
     2911               .
     2912             end.
     2913           end.
     2914           if connected("ub") = true
     2915           then do:
     2916             run gbl/wndsizer.p
     2917               (input  v-cntxt-db-num
     2918               ,input  v-cntxt-userid
     2919               ,input  v-diasize-proc-name
     2920               ,input  'width':u
     2921               ,output v-resize-value-str
     2922               ) .
     2923             if v-resize-value-str <> '':U
     2924             then do:
     2925               run diasize_change-width in this-procedure
     2926                 (input  integer(v-resize-value-str)
     2927                 ,input  true
     2928                 ) .
     2929               assign
     2930                 v-restore-saved = true
     2931               .
     2932             end.
     2933           end.
     2934           if v-restore-saved <> true
     2935           then do:
     2936             if v-diasize-wndmax = true
     2937             then do:
     2938               run diasize_maximize in this-procedure
     2939                 (input  true
     2940                 ) .
     2941             end.
     2942           end.
     2943         end.
     2944         else do:
     2945           if v-diasize-wndmax = true
     2946           then do:
     2947             run diasize_maximize in this-procedure
     2948               (input  true
     2949               ) .
     2950           end.
     2951         end.
     2952       end.
     2953     end.
     2954   end procedure.
     2955   procedure diasize_need-full-display :
     2956     define output parameter p-need-full-display as logical   no-undo .
     2957     do
     2958     on error undo, return error return-value
     2959     :
     2960       assign
     2961         p-need-full-display = v-diasize-need-full-display
     2962       .
     2963       assign
     2964         v-diasize-need-full-display = false
     2965       .
     2966     end.
     2967   end procedure.
     2968   procedure get-context :
     2969      define output parameter p-db-num as integer          no-undo.
     2970      define output parameter p-user-id as character        no-undo.
     2971      define variable v-login               as character    no-undo.
     2972      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2973      define buffer buf_user-login  for ub.user-login .
     2974      do
     2975      on error undo, return error
     2976      :
     2977            FIND FIRST buf_sys-ctrl no-lock.
     2978            ASSIGN
     2979               v-login = USERID("ub")
     2980               p-db-num = buf_sys-ctrl.db-num
     2981            .
     2982            FIND FIRST buf_user-login
     2983                 WHERE buf_user-login.db-num = p-db-num
     2984                   AND buf_user-login.user-login = v-login
     2985                 no-lock
     2986                 no-error
     2987                 .
     2988            IF AVAILABLE buf_user-login
     2989            THEN DO:
     2990               assign
     2991                  p-user-id = buf_user-login.user-id
     2992               .
     2993            END.
     2994      end.
     2995   end procedure.
     2996       run diasize_init in this-procedure .
     2997   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2998   procedure set-filter-name :
     2999   define input parameter p-filter-name as character no-undo .
     3000     do with frame Dialog-Frame:
     3001       if p-filter-name > "" then do:
     3002         assign
     3003           frame Dialog-Frame:title
     3004             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3005         .
     3006         assign
     3007           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3008         .
     3009       end.
     3010       else do:
     3011         assign
     3012           b-sch :tooltip = ""
     3013         .
     3014       end.
     3015     end.
     3016   end procedure.
     3017   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3018   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3019     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3020     return no-apply.
     3021   end.
     3022   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3023   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3024     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3025     return no-apply.
     3026   end.
     3027   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3028   on F8 of frame Dialog-Frame anywhere do:
     3029     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3030     return no-apply.
     3031   end.
     3032   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3033   on INS of frame Dialog-Frame anywhere do:
     3034     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3035     return no-apply.
     3036   end.
     3037   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3038   on F2 of frame Dialog-Frame anywhere do:
     3039     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3040     return no-apply.
     3041   end.
     3042   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3043   on F2 of frame Dialog-Frame anywhere do:
     3044     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3045     return no-apply.
     3046   end.
     3047   MAIN-BLOCK:
     3048   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3049      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3050   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3051     run mainmenu_getcntxt in parparentproc
     3052       (output v-cntxt-db-num
     3053       ,output v-cntxt-userid
     3054       ,output v-cntxt-level
     3055       ,output v-cntxt-host-code-obj
     3056       ,output v-cntxt-obj-type
     3057       ,output v-cntxt-obj-code
     3058       ,output v-cntxt-db-num-obj
     3059       ,output v-cntxt-is-admin
     3060       ) .
     3061     case p-list-mode:
     3062       when 'все':U then do:
     3063       end.
     3064       when "esys-id" then do:
     3065         v-esys-id = integer(p-dop-par).
     3066       end.
     3067       otherwise do:
     3068          message
     3069          substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3070          view-as alert-box error.
     3071          undo, return error .
     3072       end.
     3073     end.
     3074     v-rid-list = p-rid-list.
     3075     RUN Myenable.
     3076     WAIT-FOR GO OF FRAME Dialog-Frame.
     3077   END.
     3078   RUN disable_UI.
     3079   PROCEDURE disable_UI :
     3080     HIDE FRAME Dialog-Frame.
     3081   END PROCEDURE.
     3082   PROCEDURE enable_UI :
     3083     DISPLAY mark-num
     3084         WITH FRAME Dialog-Frame.
     3085     ENABLE b-quit B-mark B-sel b-add b-del b-cli b-esys b-sch b-print B-Help
     3086            br-edoc-cli mark-num
     3087         WITH FRAME Dialog-Frame.
     3088     VIEW FRAME Dialog-Frame.
     3089     OPEN QUERY br-edoc-cli FOR EACH X_ext-classif NO-LOCK,        FIRST X_clients NO-LOCK INDEXED-REPOSITION.
     3090   END PROCEDURE.
     3091   PROCEDURE MyEnable :
     3092   ENABLE
     3093   b-quit
     3094   b-cli
     3095   b-print
     3096   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3097   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3098   b-sch
     3099   B-Help
     3100   b-esys
     3101   br-edoc-cli
     3102   WITH FRAME Dialog-Frame.
     3103   VIEW FRAME Dialog-Frame.
     3104   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3105   END PROCEDURE.
     3106   PROCEDURE OpenBr :
     3107   define input  parameter p-open-query     as logical   no-undo .
     3108   define input  parameter p-find-next      as logical   no-undo .
     3109   define input  parameter p-find-condition as character no-undo .
     3110   define variable sort-column-phrase as character no-undo .
     3111   define variable l-query-was-opened as logical no-undo .
     3112   define variable title0 as character no-undo .
     3113   define buffer buf_clients for clients.
     3114   case sort-column-name :
     3115     when "" then do:
     3116       assign
     3117         sort-column-phrase = ""
     3118       .
     3119     end.
     3120     otherwise do:
     3121       assign
     3122         sort-column-phrase = "by " + sort-column-name
     3123       .
     3124     end.
     3125   end case.
     3126   filter-point = filter-point0 + p-list-mode .
     3127   case p-list-mode:
     3128    when 'все':U then do:
     3129     title0 = "Внешние системы для обмена данными по EDOC-NN".
     3130     ASSIGN
     3131     frame Dialog-Frame:title = substitute("&1", title0)
     3132     filter-label = SUBSTITUTE("&1"
     3133                               , frame Dialog-Frame:title
     3134                               )
     3135     .
     3136   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3137   define variable  l-disable-where-28  as logical   no-undo .
     3138   define variable  l-filter-open-28    as logical   .
     3139   define variable  flt-rec-28       as recid     no-undo .
     3140   define variable  filter-name-28      as character no-undo .
     3141   define variable  where-phrase-28     as character no-undo .
     3142   define variable  sort-phrase-28      as character no-undo .
     3143   define variable  where-phrase-rus-28 as character no-undo .
     3144   define variable  sort-phrase-rus-28  as character no-undo .
     3145   run gbl/flt-get.p
     3146     (input filter-point
     3147     ,output flt-rec-28
     3148     ,output filter-name-28
     3149     ,output where-phrase-28
     3150     ,output sort-phrase-28
     3151     ,output where-phrase-rus-28
     3152     ,output sort-phrase-rus-28
     3153     ).
     3154       run set-filter-name in this-procedure
     3155         (INPUT filter-name-28
     3156         ) no-error .
     3157     assign
     3158       l-filter-open-28 = false
     3159     .
     3160     if flt-rec-28 <> ?
     3161       or sort-column-phrase > ""
     3162     then do:
     3163       define variable  parameter-2-28 as character no-undo .
     3164       define variable  parameter-3-28 as character no-undo .
     3165       define variable  parameter-4-28 as character no-undo .
     3166       define variable  parameter-5-28 as character no-undo .
     3167       define variable  parameter-6-28 as character no-undo .
     3168       define variable  parameter-7-28 as character no-undo .
     3169         assign
     3170         parameter-3-28 =
     3171                                 "FOR EACH X_ext-classif"
     3172         parameter-4-28 =
     3173           (
     3174             if (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'clients-edoc-nn':U                           AND X_ext-classif.db-num = - 1" + " " + where-phrase-28) <> ""
     3175             then  substitute('X_ext-classif.classif-subject = &1&2&1                           and X_ext-classif.classif-name = &1&3&1                           AND X_ext-classif.db-num = - 1', chr(34), 'clients':U, 'clients-edoc-nn':U) + " " + where-phrase-28
     3176             else "true"
     3177           )
     3178         parameter-5-28 = (" " + "" + " " + substitute(', FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))'))
     3179         parameter-6-28 = if sort-phrase-28 = ''
     3180                              then
     3181           (
     3182           " " + "  " +
     3183             " " + sort-column-phrase +
     3184           " " + "  "
     3185           )
     3186                              else
     3187           (
     3188           " " + "  " +
     3189             " " + sort-column-phrase +
     3190           " " + sort-phrase-28
     3191           )
     3192         parameter-7-28 =
     3193           " INDEXED-REPOSITION  "
     3194       .
     3195       do
     3196       on stop undo, leave
     3197       on error undo, leave
     3198       :
     3199         assign
     3200           l-disable-where-28 =
     3201             (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'clients-edoc-nn':U                           AND X_ext-classif.db-num = - 1" + " " + where-phrase-28 = "")
     3202         .
     3203         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3204                             ,input QUERY br-edoc-cli:handle
     3205                             ,input parameter-3-28
     3206                             ,input parameter-4-28
     3207                             ,input parameter-5-28
     3208                             ,input parameter-6-28
     3209                             ,input parameter-7-28
     3210                             )
     3211         .
     3212         assign
     3213           l-filter-open-28 = true
     3214         .
     3215       end.
     3216       if l-filter-open-28 = false then do:
     3217         message
     3218           "Ошибка при фильтрации / сортировке" skip
     3219           "Будут показаны записи без учета фильтра" skip
     3220           view-as alert-box .
     3221       end.
     3222       else do:
     3223           assign
     3224             l-query-was-opened = true
     3225           .
     3226       end.
     3227     end.
     3228     if l-filter-open-28 = false then do:
     3229       OPEN QUERY br-edoc-cli FOR EACH X_ext-classif
     3230         where  X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'clients-edoc-nn':U                           AND X_ext-classif.db-num = - 1
     3231       , FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))
     3232         INDEXED-REPOSITION
     3233     .
     3234         assign
     3235           l-query-was-opened = true
     3236         .
     3237     end.
     3238    end.
     3239    when "esys-id" then do:
     3240     title0 = substitute("Контрагенты, участвущие в обмене данными по EDOC-NN для внешней системы &1", v-esys-id).
     3241     ASSIGN
     3242     frame Dialog-Frame:title = substitute("&1", title0)
     3243     filter-label = SUBSTITUTE("&1"
     3244                               , frame Dialog-Frame:title
     3245                               )
     3246     .
     3247   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3248   define variable  l-disable-where-30  as logical   no-undo .
     3249   define variable  l-filter-open-30    as logical   .
     3250   define variable  flt-rec-30       as recid     no-undo .
     3251   define variable  filter-name-30      as character no-undo .
     3252   define variable  where-phrase-30     as character no-undo .
     3253   define variable  sort-phrase-30      as character no-undo .
     3254   define variable  where-phrase-rus-30 as character no-undo .
     3255   define variable  sort-phrase-rus-30  as character no-undo .
     3256   run gbl/flt-get.p
     3257     (input filter-point
     3258     ,output flt-rec-30
     3259     ,output filter-name-30
     3260     ,output where-phrase-30
     3261     ,output sort-phrase-30
     3262     ,output where-phrase-rus-30
     3263     ,output sort-phrase-rus-30
     3264     ).
     3265       run set-filter-name in this-procedure
     3266         (INPUT filter-name-30
     3267         ) no-error .
     3268     assign
     3269       l-filter-open-30 = false
     3270     .
     3271     if flt-rec-30 <> ?
     3272       or sort-column-phrase > ""
     3273     then do:
     3274       define variable  parameter-2-30 as character no-undo .
     3275       define variable  parameter-3-30 as character no-undo .
     3276       define variable  parameter-4-30 as character no-undo .
     3277       define variable  parameter-5-30 as character no-undo .
     3278       define variable  parameter-6-30 as character no-undo .
     3279       define variable  parameter-7-30 as character no-undo .
     3280         assign
     3281         parameter-3-30 =
     3282                                 "FOR EACH X_ext-classif"
     3283         parameter-4-30 =
     3284           (
     3285             if (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'clients-edoc-nn':U                           AND X_ext-classif.db-num = - 1 AND X_ext-classif.key#_one = v-esys-id" + " " + where-phrase-30) <> ""
     3286             then  substitute('X_ext-classif.classif-subject = &1&2&1                           and X_ext-classif.classif-name = &1&3&1                           AND X_ext-classif.db-num = - 1 AND X_ext-classif.key#_one = &4 ', chr(34), 'clients':U, 'clients-edoc-nn':U, v-esys-id) + " " + where-phrase-30
     3287             else "true"
     3288           )
     3289         parameter-5-30 = (" " + "" + " " + substitute(', FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))'))
     3290         parameter-6-30 = if sort-phrase-30 = ''
     3291                              then
     3292           (
     3293           " " + "  " +
     3294             " " + sort-column-phrase +
     3295           " " + "  "
     3296           )
     3297                              else
     3298           (
     3299           " " + "  " +
     3300             " " + sort-column-phrase +
     3301           " " + sort-phrase-30
     3302           )
     3303         parameter-7-30 =
     3304           " INDEXED-REPOSITION  "
     3305       .
     3306       do
     3307       on stop undo, leave
     3308       on error undo, leave
     3309       :
     3310         assign
     3311           l-disable-where-30 =
     3312             (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'clients-edoc-nn':U                           AND X_ext-classif.db-num = - 1 AND X_ext-classif.key#_one = v-esys-id" + " " + where-phrase-30 = "")
     3313         .
     3314         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3315                             ,input QUERY br-edoc-cli:handle
     3316                             ,input parameter-3-30
     3317                             ,input parameter-4-30
     3318                             ,input parameter-5-30
     3319                             ,input parameter-6-30
     3320                             ,input parameter-7-30
     3321                             )
     3322         .
     3323         assign
     3324           l-filter-open-30 = true
     3325         .
     3326       end.
     3327       if l-filter-open-30 = false then do:
     3328         message
     3329           "Ошибка при фильтрации / сортировке" skip
     3330           "Будут показаны записи без учета фильтра" skip
     3331           view-as alert-box .
     3332       end.
     3333       else do:
     3334           assign
     3335             l-query-was-opened = true
     3336           .
     3337       end.
     3338     end.
     3339     if l-filter-open-30 = false then do:
     3340       OPEN QUERY br-edoc-cli FOR EACH X_ext-classif
     3341         where  X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'clients-edoc-nn':U                           AND X_ext-classif.db-num = - 1 AND X_ext-classif.key#_one = v-esys-id
     3342       , FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))
     3343         INDEXED-REPOSITION
     3344     .
     3345         assign
     3346           l-query-was-opened = true
     3347         .
     3348     end.
     3349    end.
     3350   end case.
     3351   APPLY "entry" TO br-edoc-cli.
     3352   if available X_ext-classif then do:
     3353       APPLY "VALUE-CHANGED":U to br-edoc-cli.
     3354   END.
     3355   END PROCEDURE.
     3356   PROCEDURE proc-b-add :
     3357   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3358   define variable v-rid as recid no-undo .
     3359   DEFINE VARIABLE v-ok AS logical NO-UNDO.
     3360   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     3361   define variable v-uniq-key-rec as character no-undo .
     3362   define variable v-tbl-row as rowid no-undo .
     3363   define variable v-tbl-name as character no-undo .
     3364   define buffer buf_clients for clients.
     3365   define buffer buf_ext-system for ub.ext-system.
     3366   message
     3367   "Выберите клиента, документооборот с которым Вы хотите вести через систему EDOC-NN"
     3368   view-as alert-box .
     3369   run ref/cli-all.w (   input parparentproc
     3370                     ,input "b-sel"
     3371                     ,input 'орг':U
     3372                     ,input 'все':U
     3373                     ,input 'текущие':U
     3374                     ,input ?
     3375                     ,input ",,,,,,NO,,"
     3376                     ,input "":U
     3377                     ,output v-rid-list) no-error.
     3378   if v-rid-list = '':U then return no-apply.
     3379   find first buf_clients where recid (buf_clients) = integer (v-rid-list) no-lock no-error.
     3380   if not (buf_clients.obj-type = 'орг':U
     3381          or
     3382          buf_clients.obj-type = 'чел':U) then do:
     3383     message
     3384     "Можно выбрать только ОРГАНИЗАЦИЮ или ФИЗ.ЛИЦО"
     3385     view-as alert-box error .
     3386     undo, return error .
     3387   end.
     3388   run gen-key-rec IN THIS-PROCEDURE
     3389   ( input 'clients':U
     3390     ,input (buffer buf_clients:handle)
     3391     ,output v-uniq-key-rec).
     3392   if p-list-mode = "esys-id" then do:
     3393    find first buf_ext-system no-lock where
     3394             buf_ext-system.db-num = 0
     3395         and buf_ext-system.esys-id = integer(p-dop-par).
     3396   end.
     3397   else do:
     3398     run bge/oxmlexts.p (
     3399               input parparentproc
     3400             , input 2
     3401             , input substitute("esys-type > &1", '0':U)
     3402             , input v-uniq-key-rec
     3403             , output v-rid-list
     3404             , output v-ok
     3405         ).
     3406     if not v-ok then return error.
     3407     run gen-row-keyr in this-procedure
     3408       ( input v-rid-list
     3409         ,input ?
     3410         ,input "ub"
     3411         ,input ?
     3412         ,input no-lock
     3413         ,output v-tbl-row
     3414         ,output v-tbl-name
     3415       ).
     3416     find first buf_ext-system no-lock where
     3417               rowid(buf_ext-system) = v-tbl-row.
     3418   end.
     3419   if buf_ext-system.esys-type < integer('1':U)
     3420   then do:
     3421     message
     3422     "Неверный тип ВНЕШНЕЙ СИСТЕМЫ"
     3423     view-as alert-box error .
     3424     undo, return error.
     3425   end.
     3426   assign
     3427   v-value-integer = buf_Ext-system.esys-id
     3428   .
     3429   run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     3430                       ,INPUT NO
     3431                       ,INPUT-OUTPUT v-rid
     3432                       ,INPUT 'clients':U
     3433                       ,INPUT 'clients-edoc-nn':U
     3434                       ,input (-1)
     3435                       ,input v-value-integer
     3436                       ,input 0
     3437                       ,input 0
     3438                       ,input '':U
     3439                       ,input '':U
     3440                       ,input '':U
     3441                       ,input (if buf_clients.obj-type = 'орг':U then 1000000000 else 0) + buf_clients.obj-code
     3442                       ,input v-uniq-key-rec ) no-error.
     3443   if error-status:error then do:
     3444     undo, return error .
     3445   end.
     3446   if v-rid <> ? then do:
     3447     run openbr in this-procedure ( input yes, input no, input '':U).
     3448     reposition br-edoc-cli to recid v-rid no-error .
     3449     apply "entry" to br-edoc-cli in frame Dialog-Frame .
     3450   end.
     3451   END PROCEDURE.
     3452   PROCEDURE proc-b-del :
     3453   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3454   DEFINE VARIABLE glog AS logical NO-UNDO.
     3455   IF NOT AVAILABLE X_ext-classif THEN UNDO, RETURN ERROR.
     3456   v-rec = recid(X_ext-classif).
     3457   MESSAGE
     3458   "Вы действительно хотитет удалить эту запись?"
     3459   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3460   IF NOT glog THEN RETURN ERROR.
     3461   run ref/extclas3.p ( INPUT NO
     3462                       ,INPUT v-rec) NO-ERROR.
     3463   if not error-status:error then do:
     3464     run openbr in this-procedure ( input yes, input no, input '':U).
     3465     reposition br-edoc-cli to row 1 no-error .
     3466     apply "entry" to br-edoc-cli in frame Dialog-Frame .
     3467   end.
     3468   END PROCEDURE.
     3469   PROCEDURE proc-b-print :
     3470   DEFINE VARIABLE date_string              as   character no-undo .
     3471   DEFINE VARIABLE Line                     as   character no-undo .
     3472   DEFINE VARIABLE for-time                 as   character no-undo .
     3473   DEFINE VARIABLE accum-count              as   integer   no-undo .
     3474   define variable v-rid                    as   recid no-undo .
     3475   DEFINE VARIABLE v-esys-name AS CHARACTER NO-UNDO.
     3476   DEFINE FRAME list1
     3477   X_ext-classif.KEY#_one  COLUMN-LABEL "Код ВС" FORMAT ">>>>>>>>9"
     3478   v-esys-name COLUMN-LABEL "Внешняя система" FORMAT "X(30)"
     3479   X_clients.obj-type COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     3480   X_clients.obj-code COLUMN-LABEL "Код!клиента" FORMAT ">>>>>>>>9"
     3481   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(60)"
     3482   HEADER  date_string AT 5 format "X(35)"
     3483   string( "Страница " ) format "X(9)" AT 75 PAGE-NUMBER(PrnLibStream) AT 85 FORMAT ">>9" SKIP
     3484   Line format "X(192)" AT 1
     3485   with width 232 down stream-io use-text    .
     3486   Line = fill("-", 121).
     3487   date_string = cur-time-print() .
     3488   run prn-lib-open-stream  in this-procedure (
     3489                                                input parParentProc
     3490                                               ,input  62
     3491                                               ,input yes
     3492                                               ,input no
     3493                                               ).
     3494   PUT  STREAM PrnLibStream
     3495   SPACE(25) ( frame Dialog-Frame:title )
     3496   format "x(90)" SKIP(1) .
     3497   FORM HEADER
     3498   Line format "X(177)" AT 1 SKIP
     3499   "Продолжение - на следующей странице" AT 30 SKIP
     3500   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3501   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3502   v-rid = recid(X_ext-classif).
     3503   FORM with FRAME List1.
     3504   run waitfram-show in this-procedure ( input "Ждите...").
     3505   DO WHILE available X_ext-classif :
     3506      GET prev br-edoc-cli.
     3507   END.
     3508   GET next br-edoc-cli.
     3509   DO WHILE available X_ext-classif :
     3510     v-esys-name = get-esys-name(X_ext-classif.key#_one).
     3511     Display STREAM PrnLibStream
     3512     v-esys-name
     3513     X_ext-classif.KEY#_one
     3514     X_clients.obj-type
     3515     X_clients.obj-code
     3516     X_clients.obj-name
     3517     with FRAME List1.
     3518     DOWN STREAM PrnLibStream
     3519     1
     3520     with FRAME List1.
     3521     assign
     3522     accum-count = accum-count + 1
     3523     .
     3524     GET next br-edoc-cli.
     3525   END.
     3526   UNDERLINE  STREAM PrnLibStream
     3527   X_ext-classif.KEY#_one
     3528   v-esys-name
     3529   X_clients.obj-type
     3530   X_clients.obj-code
     3531   X_clients.obj-name
     3532   with FRAME List1.
     3533   DISPLAY STREAM PrnLibStream
     3534   accum-count @ X_ext-classif.key#_one
     3535   with frame List1.
     3536   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3537   HIDE  STREAM PrnLibStream FRAME List1.
     3538   output  STREAM PrnLibStream CLOSE.
     3539   reposition br-edoc-cli to recid v-rid no-error .
     3540   apply "ENTRY" to br-edoc-cli in frame Dialog-Frame .
     3541   run waitfram-hide in this-procedure .
     3542   run prn-lib-prn-file in this-procedure (
     3543                                             input parParentProc
     3544                                             ,input 0
     3545                                             ).
     3546   END PROCEDURE.
     3547   PROCEDURE proc-b-sch :
     3548   define variable v-ri as recid no-undo .
     3549   assign
     3550   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     3551   .
     3552   assign
     3553   tbl = 'ext-classif':U
     3554   join-tbl = 'X_ext-classif'
     3555   fld = ""
     3556   lab = ""
     3557   spr = ""
     3558   dim = '0'
     3559   .
     3560   run fltfield-add in this-procedure('key#_one', 'Код ВС', '',
     3561   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3562   DO on stop undo, leave:
     3563       run gbl/filter.w ( INPUT parparentproc
     3564                    ,INPUT filter-point + chr(4) + filter-label
     3565                    ,INPUT tbl
     3566                    ,INPUT join-tbl
     3567                    ,INPUT fld
     3568                    ,INput lab
     3569                    ,INPUT spr
     3570                    ,INPUT  dim).
     3571       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3572       if v-ri <> ? then do:
     3573         reposition br-edoc-cli to recid v-ri no-error.
     3574       end.
     3575       APPLY "ENTRY" to br-edoc-cli in frame Dialog-Frame .
     3576       APPLY "VALUE-CHANGED" to br-edoc-cli.
     3577   END .
     3578   END PROCEDURE.
     3579   FUNCTION get-cli-name RETURNS CHARACTER
     3580     ( INPUT p-uniq-key-rec AS CHARACTER ) :
     3581   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3582   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3583   DEFINE BUFFER buf_clients FOR ub.clients.
     3584   RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3585                                       ,input ?
     3586                                       ,INPUT "ub"
     3587                                       ,INPUT ?
     3588                                       ,INPUT NO-LOCK
     3589                                       ,OUTPUT v-rowid
     3590                                       ,OUTPUT v-tbl-name) no-error.
     3591   if error-status :error then do:
     3592     message
     3593       vss-workfile vss-revision vss-description skip
     3594       error-status :get-message(1)
     3595       error-status :get-message(2)
     3596     view-as alert-box error.
     3597     undo, return error.
     3598   end.
     3599   IF v-rowid = ? THEN RETURN 'НЕИЗВЕСТНЫЙ КЛИЕНТ'.
     3600   FIND FIRST buf_clients NO-LOCK WHERE ROWID(buf_clients) = v-rowid.
     3601   RETURN buf_clients.obj-name.
     3602   END FUNCTION.
     3603   FUNCTION get-cli-type-code RETURNS CHARACTER
     3604     ( INPUT p-uniq-key-rec AS character ) :
     3605   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3606   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3607   DEFINE BUFFER buf_clients FOR ub.clients.
     3608       RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3609                                           ,INPUT ?
     3610                                           ,INPUT "ub"
     3611                                           ,INPUT ?
     3612                                           ,INPUT NO-LOCK
     3613                                           ,OUTPUT v-rowid
     3614                                           ,OUTPUT v-tbl-name) NO-ERROR.
     3615       if error-status :error then do:
     3616         message
     3617           vss-workfile vss-revision vss-description skip
     3618           error-status :get-message(1)
     3619           error-status :get-message(2)
     3620         view-as alert-box error.
     3621         undo, return error.
     3622       end.
     3623       IF v-rowid = ? THEN RETURN ''.
     3624       FIND FIRST buf_clients NO-LOCK WHERE ROWID(buf_clients) = v-rowid.
     3625       RETURN substitute("&1&2"
     3626                         ,buf_clients.obj-type
     3627                         ,buf_Clients.obj-code).
     3628   END FUNCTION.
     3629   FUNCTION get-esys-name RETURNS CHARACTER
     3630     ( INPUT p-esys-id AS integer ) :
     3631     DEFINE BUFFER buf_ext-system FOR ub.ext-system.
     3632   FIND FIRST buf_ext-system NO-LOCK WHERE
     3633             buf_Ext-system.db-num = 0
     3634         AND buf_Ext-system.esys-id = p-esys-id NO-ERROR.
     3635   IF AVAILABLE buf_ext-system THEN DO:
     3636      RETURN buf_ext-system.esys-name.
     3637   END.
     3638   RETURN "!!Неизвестная внешняя система".
     3639   END FUNCTION.
