     2397         .
     2398       end.
     2399       else do:
     2400         return .
     2401       end.
     2402       assign
     2403         v-frame-width = frame Dialog-Frame :width
     2404         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2405         v-browse-width = v-diasize-browse-handle :width
     2406       .
     2407       for each buf_temp-browse-handle
     2408         where buf_temp-browse-handle.browse-type = 'width':u
     2409       :
     2410         assign
     2411           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2412         .
     2413       end.
     2414       for each buf_temp-diasize-handle
     2415       :
