     2591       end.
     2592       if v-diasize-wndstore = true
     2593       then do:
     2594         if connected("ub") = true
     2595         then do:
     2596           define variable v-cntxt-db-num        as integer   no-undo .
     2597           define variable v-cntxt-userid        as character no-undo .
     2598           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2599                                             , OUTPUT v-cntxt-userid
     2600                                             ) .
     2601           run gbl/wndsizew.p
     2602             (input  v-cntxt-db-num
     2603             ,input  v-cntxt-userid
     2604             ,input  v-diasize-proc-name
     2605             ,input  'width':u
     2606             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2607             ) .
