     2429           and v-object-handle <> v-diasize-resize-button
     2430           and can-query(v-object-handle, "row")
     2431           and can-query(v-object-handle, "height")
     2432           and ( v-object-handle :col + v-object-handle :width
     2433                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2434               )
     2435           then do:
     2436             find first buf_temp-browse-handle
     2437               where buf_temp-browse-handle.browse-type   = 'width':u
     2438                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2439               no-error .
     2440             if available buf_temp-browse-handle
     2441             then do:
     2442             end.
     2443             else do:
     2444               create buf_temp-diasize-handle .
     2445               assign
     2446                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2447                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2448               .
     2449             end.
     2450           end.
     2451           assign
     2452             v-object-handle = v-object-handle :next-sibling
     2453           .
     2454         end.
     2455         assign
     2456           v-field-group-handle = v-field-group-handle :next-sibling
     2457         .
     2458       end.
     2459       do with frame Dialog-Frame
     2460       :
     2461         hide v-diasize-resize-button .
     2462         v-diasize-resize-button :row = 1.
     2463         v-diasize-resize-button :column = 1.
     2464       end.
     2465       if p-change-value > 0
     2466       then do:
     2467         if frame Dialog-Frame :scrollable = true
     2468         then do:
     2469           assign
     2470             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2471             no-error .
     2472           if error-status :error
     2473           or error-status :get-message(1) <> ""
     2474           then do:
     2475             undo move_block, retry move_block.
     2476           end.
     2477         end.
     2478         assign
     2479           frame Dialog-Frame :width = v-frame-width + p-change-value
     2480           no-error .
     2481         if error-status :error
     2482         or error-status :get-message(1) <> ""
     2483         then do:
     2484           undo move_block, retry move_block.
     2485         end.
     2486         assign
     2487           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2488         no-error .
     2489         if error-status :error
     2490         or error-status :get-message(1) <> ""
     2491         then do:
     2492           undo move_block, retry move_block.
     2493         end.
     2494         for each buf_temp-browse-handle
     2495           where buf_temp-browse-handle.browse-type = 'width':u
     2496         on error undo move_block, retry move_block
     2497         :
     2498           assign
     2499             buf_temp-browse-handle.browse-handle :width
     2500               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2501             no-error .
     2502           if error-status :error
     2503           or error-status :get-message(1) <> ""
     2504           then do:
     2505             undo move_block, retry move_block .
     2506           end.
     2507         end.
     2508         for each buf_temp-diasize-handle
     2509         on error undo move_block, retry move_block
     2510         :
     2511           assign
     2512             v-object-handle = buf_temp-diasize-handle.handle-value
     2513           .
     2514           if v-object-handle <> v-diasize-resize-button
     2515           then do:
     2516             assign
     2517               v-object-handle :col = v-object-handle :col + p-change-value
     2518               no-error .
     2519             if error-status :error
     2520             or error-status :get-message(1) <> ""
     2521             then do:
     2522               undo move_block, retry move_block .
     2523             end.
     2524           end.
     2525         end.
     2526       end.
     2527       else do:
     2528         for each buf_temp-diasize-handle
     2529         on error undo move_block, retry move_block
     2530         :
     2531           assign
     2532             v-object-handle = buf_temp-diasize-handle.handle-value
     2533           .
     2534           if v-object-handle <> v-diasize-resize-button
     2535           then do:
     2536             assign
     2537               v-object-handle :col = v-object-handle :col + p-change-value
     2538               no-error .
     2539             if error-status :error
     2540             or error-status :get-message(1) <> ""
     2541             then do:
     2542               undo move_block, retry move_block .
     2543             end.
     2544           end.
     2545         end.
     2546         for each buf_temp-browse-handle
     2547           where buf_temp-browse-handle.browse-type = 'width':u
     2548         on error undo move_block, retry move_block
     2549         :
     2550           assign
     2551             buf_temp-browse-handle.browse-handle :width
     2552               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2553             no-error .
     2554           if error-status :error
     2555           or error-status :get-message(1) <> ""
     2556           then do:
     2557             undo move_block, retry move_block .
     2558           end.
     2559         end.
     2560         assign
     2561           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2562           no-error .
