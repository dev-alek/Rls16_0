     2344               .
     2345             end.
     2346             run diasize_position-resize-button in this-procedure .
     2347           end.
     2348           else do:
     2349             if frame Dialog-Frame :scrollable = true
     2350             then do:
     2351               assign
     2352                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2353               .
     2354             end.
     2355             assign
     2356               frame Dialog-Frame :width = v-frame-width
     2357             .
     2358             for each buf_temp-browse-handle
     2359               where buf_temp-browse-handle.browse-type = 'width':u
     2360             on error undo, next
     2361             :
     2362               assign
     2363                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2364               .
     2365             end.
     2366             assign
