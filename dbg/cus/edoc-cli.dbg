     2074           v-diasize-resize-button :row    = 1
     2075           v-diasize-resize-button :column = 1
     2076         .
     2077       end.
     2078       if p-change-value > 0
     2079       then do:
     2080         if frame Dialog-Frame :scrollable = true
     2081         then do:
     2082           assign
     2083             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2084             no-error .
     2085           if error-status :error
     2086           or error-status :get-message(1) <> ""
     2087           then do:
     2088             undo move_block, retry move_block .
     2089           end.
     2090         end.
     2091         assign
     2092           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2093           no-error .
     2094         if error-status :error
     2095         or error-status :get-message(1) <> ""
     2096         then do:
     2097           undo move_block, retry move_block .
     2098         end.
     2099         assign
     2100           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2101           no-error .
     2102         if error-status :error
     2103         or error-status :get-message(1) <> ""
     2104         then do:
     2105           undo move_block, retry move_block .
     2106         end.
     2107         for each buf_temp-browse-handle
     2108           where buf_temp-browse-handle.browse-type = 'height':u
     2109         on error undo move_block, retry move_block
     2110         :
     2111           assign
     2112             buf_temp-browse-handle.browse-handle :height
     2113               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2114             no-error .
     2115           if error-status :error
     2116           or error-status :get-message(1) <> ""
     2117           then do:
     2118             undo move_block, retry move_block .
     2119           end.
     2120         end.
     2121         for each buf_temp-diasize-handle
     2122         on error undo move_block, retry move_block
     2123         :
     2124           assign
     2125             v-object-handle = buf_temp-diasize-handle.handle-value
     2126           .
     2127           if v-object-handle <> v-diasize-resize-button
     2128           then do:
     2129             assign
     2130               v-object-handle :row = v-object-handle :row + p-change-value
     2131               no-error .
     2132             if error-status :error
     2133             or error-status :get-message(1) <> ""
     2134             then do:
     2135               undo move_block, retry move_block .
     2136             end.
     2137           end.
     2138         end.
     2139       end.
     2140       else do:
     2141         for each buf_temp-diasize-handle
     2142         on error undo move_block, retry move_block
     2143         :
     2144           assign
     2145             v-object-handle = buf_temp-diasize-handle.handle-value
     2146           .
     2147           if v-object-handle <> v-diasize-resize-button
     2148           then do:
     2149             assign
     2150               v-object-handle :row = v-object-handle :row + p-change-value
     2151               no-error .
     2152             if error-status :error
     2153             or error-status :get-message(1) <> ""
     2154             then do:
     2155               undo move_block, retry move_block .
     2156             end.
     2157           end.
     2158         end.
     2159         assign
     2160           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2161           no-error .
     2162         if error-status :error
     2163         or error-status :get-message(1) <> ""
     2164         then do:
     2165           undo move_block, retry move_block .
     2166         end.
     2167         for each buf_temp-browse-handle
     2168           where buf_temp-browse-handle.browse-type = 'height':u
     2169         on error undo move_block, retry move_block
     2170         :
     2171           assign
     2172             buf_temp-browse-handle.browse-handle :height
     2173               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2174             no-error .
     2175           if error-status :error
     2176           or error-status :get-message(1) <> ""
     2177           then do:
     2178             undo move_block, retry move_block .
     2179           end.
     2180         end.
     2181         assign
     2182           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2183           no-error .
     2184         if error-status :error
     2185         or error-status :get-message(1) <> ""
     2186         then do:
     2187           undo move_block, retry move_block .
     2188         end.
     2189         if frame Dialog-Frame :scrollable = true
     2190         then do:
     2191           assign
     2192             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2193             no-error .
     2194           if error-status :error
     2195           or error-status :get-message(1) <> ""
     2196           then do:
     2197             undo move_block, retry move_block .
     2198           end.
     2199         end.
     2200       end.
     2201       if p-move-resize = true
     2202       then do:
     2203         run diasize_position-resize-button in this-procedure .
     2204       end.
     2205       if v-diasize-wndstore = true
     2206       then do:
     2207         if connected("ub") = true
     2208         then do:
     2209           define variable v-cntxt-db-num        as integer   no-undo .
     2210           define variable v-cntxt-userid        as character no-undo .
     2211           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2212                                             , OUTPUT v-cntxt-userid
     2213                                             ) .
