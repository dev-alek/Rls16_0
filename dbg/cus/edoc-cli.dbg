     2564         or error-status :get-message(1) <> ""
     2565         then do:
     2566           undo move_block, retry move_block.
     2567         end.
     2568         assign
     2569           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2570         no-error .
     2571         if error-status :error
