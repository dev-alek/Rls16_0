     1293                         num#col# = num#col# + 1.  if temp-tt.qnty-of  > 0 then do:                  run macr_excel_char (temp-tt.time-of, num#str# , num#col#  )     .  end. else do: run macr_excel_char ( " ", num#str# , num#col#  )     .  end.
     1294                         num#col# = num#col# + 1.  if temp-tt.qnty-rcv > 0 then do: is-l = is-l + 1. run macr_excel_dec  (temp-tt.qnty-fp, num#str# , num#col#    )   .  end. else do: run macr_excel_char ( " ", num#str# , num#col#  )     .  end.
     1295                                                   if temp-tt.ord-code = "in":U then  do: is-l = is-l + 1. run macr_excel_char  ("внутр.перем.", num#str# , num#col#    )   .  end.
     1296                         num#col# = num#col# + 1.  if temp-tt.qnty-rcv > 0 then do: is-l = is-l + 1. run macr_excel_char (temp-tt.cli-cod, num#str# , num#col#  )      . end. else do: run macr_excel_char ( " ", num#str# , num#col#  )     .  end.
     1297                         num#col# = num#col# + 1.  if temp-tt.qnty-rcv > 0 then do: is-l = is-l + 1. run macr_excel_char_with_format (temp-tt.cli-name, num#str# , num#col#  )  . end. else do: run macr_excel_char ( " ", num#str# , num#col#  )     .  end.
     1298                         num#col# = num#col# + 1.  if temp-tt.qnty-rcv > 0 then do: is-l = is-l + 1. run macr_excel_char (temp-tt.time-rcv, num#str# , num#col#  )     . end. else do: run macr_excel_char ( " ", num#str# , num#col#  )     .  end.
     1299                         num#col# = num#col# + 1.  if temp-tt.qnty-rcv > 0 then do: is-l = is-l + 1. run macr_excel_dec  (temp-tt.qnty-rcv, num#str# , num#col#  )    . end.  else do: run macr_excel_char ( " ", num#str# , num#col#  )     .  end.
     1300                         num#col# = num#col# + 1.  if temp-tt.qnty-rcv > 0 then do: is-l = is-l + 1.
