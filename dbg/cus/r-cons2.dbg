     1380                        num#col# = num#col# + 1.  run macr_excel_char (temp-tt-host.cli-cod, num#str# , num#col#  )      .
     1381                        num#col# = num#col# + 1.  run macr_excel_char_with_format (temp-tt-host.cli-name, num#str# , num#col#  )     .
     1382                        num#col# = num#col# + 1.  run macr_excel_char (temp-tt-host.time-rcv, num#str# , num#col#  )     .
     1383                        num#col# = num#col# + 1.  run macr_excel_dec  (temp-tt-host.qnty-rcv, num#str# , num#col#  )    .
     1384                        num#col# = num#col# + 1.  run macr_excel_char (temp-tt-host.rcv-code, num#str# , num#col#  )    .
     1385                       end.
     1386                       else do:
     1387                         num#col# = num#col# + 8.
     1388                       end.
     1389            end.
     1390               num#str# = num#str# + 1.
     1391          end.
     1392        end.
     1393   end.
     1394   num#col# =  1.
     1395   run macr_excel_char ( "Итого по заказам ФП по фирме" , num#str# , num#col# ) .
     1396   num#col# = 2.
     1397    for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,    first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic                                               and bf_ord-cons-gds.prod-type = ub.goods.prod-type                                   and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1398       assign
     1399           s-qnty-of     = 0
     1400           s-qnty-fp     = 0
     1401           s-qnty-rcv    = 0
     1402           .
     1403         for each   temp-tt-host where temp-tt-host.gds-code = ub.goods.gds-code :
     1404         assign
     1405           s-qnty-of     = temp-tt-host.qnty-of
     1406           s-qnty-fp     = s-qnty-fp     + temp-tt-host.qnty-fp
     1407           s-qnty-rcv    = s-qnty-rcv    + temp-tt-host.qnty-rcv
     1408           .
     1409         end.
     1410             num#col# = num#col# + 1.  run macr_excel_dec  ( s-qnty-of , num#str# , num#col#  )    .
     1411             num#col# = num#col# + 1.
     1412             num#col# = num#col# + 1.  run macr_excel_dec  ( s-qnty-fp , num#str# , num#col#  )    .
     1413             num#col# = num#col# + 1.
     1414             num#col# = num#col# + 1.
     1415             num#col# = num#col# + 1.
     1416             num#col# = num#col# + 1.  run macr_excel_dec  ( s-qnty-rcv, num#str# , num#col#  )    .
     1417             num#col# = num#col# + 1.
     1418     .
     1419    end.
     1420     run macr_cell_format
     1421          ( 10    ,
     1422           true  ,
     1423           false ,
     1424           ?     ,
     1425           num#str# ,
     1426           1        ,
     1427           num#str# ,
     1428           num#col#
     1429           ) .
     1430   run cur-time in this-procedure  ( output v-today, output v-time ).
     1431       num#str# = num#str# + 1.
     1432       num#col# =  1.
     1433   run macr_excel_char (  " Печать закончена : " + string (v-time,"HH:MM:SS"), num#str# , num#col#     )   .
     1434     Output stream OutStream   close .
     1435     Output stream Macr_Excel  close .
     1436   if mFrameView
     1437   then do:
     1438      HIDE FRAME InfoFrame.
     1439   end.
     1440       run paramls-write in this-procedure
     1441          (input "file"
     1442         ,input string (v-ind)
     1443         ,input v-file-name
     1444         ) .
     1445       run paramls-write in this-procedure
     1446            (input "charcol"
     1447           ,input ""
     1448           ,input "1,2"
     1449           ) .
     1450     run end-proc .
     1451     run rep/runexcel.p  (string ( session:temp-directory) + "rpt" + string ( g#report-num ) + ".txt").
     1452    end.
     1453   procedure make-tt :
     1454   define variable tt-line  as logical no-undo .
     1455   define variable ttt-line as logical no-undo .
     1456   for each  bf_ord-doc no-lock  where bf_ord-doc.cons-code = bf_ord-cons.cons-code
     1457                                   and bf_ord-doc.doc-type = 'ОФ':U  ,
     1458     first ub.clients  where ub.clients.obj-code =  bf_ord-doc.obj-code
     1459                     and  ub.clients.obj-type =  bf_ord-doc.obj-type no-lock
     1460                     break by ub.clients.obj-type by ub.clients.obj-code:
     1461     if first-of (ub.clients.obj-code) then do:
     1462        ii = 0 .
     1463       for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,
     1464         first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic
     1465               and bf_ord-cons-gds.prod-type = ub.goods.prod-type
     1466               and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1467               assign
     1468                 l-nn = 0
     1469                 l-qnty-of = 0
     1470                 l-time-of = 0
     1471               .
     1472           for each  z_ord-doc no-lock  where z_ord-doc.cons-code = bf_ord-cons.cons-code
     1473                                               and z_ord-doc.doc-type = 'ОФ':U
     1474                                               and ub.clients.obj-code =  z_ord-doc.obj-code
     1475                                               and ub.clients.obj-type =  z_ord-doc.obj-type
     1476                                              ,
     1477                   each z_ord-line no-lock where z_ord-doc.doc-code   = z_ord-line.doc-code and
     1478                                                   z_ord-line.artic     = bf_ord-cons-gds.artic      and
     1479                                                   z_ord-line.prod-type = bf_ord-cons-gds.prod-type  and
     1480                                                   z_ord-line.prod-code = bf_ord-cons-gds.prod-code :
     1481                     l-qnty-of = l-qnty-of + z_ord-line.qnty.
     1482                     l-time-of =  z_ord-doc.ship-time.
     1483           end.
     1484           assign
     1485           l-cli-code  = ""
     1486           l-cli-name  = ""
     1487           l-ord-code  = ""
     1488           ttt-line = false
     1489           l-qnty-fp = 0
     1490           g-qnty-fp = 0
     1491           .
     1492           for each loc_ord-doc no-lock  where loc_ord-doc.cons-code =  bf_ord-cons.cons-code
     1493                                           and loc_ord-doc.doc-type = 'ФП':U
     1494                                     ,
     1495           first b_clients  where b_clients.obj-code =  loc_ord-doc.cli-code
     1496                             and  b_clients.obj-type =  loc_ord-doc.cli-type no-lock ,
     1497           each loc_ord-line no-lock where loc_ord-doc.doc-code   = loc_ord-line.doc-code and
     1498                                           loc_ord-line.artic     = bf_ord-cons-gds.artic      and
     1499                                           loc_ord-line.prod-type = bf_ord-cons-gds.prod-type  and
     1500                                           loc_ord-line.prod-code = bf_ord-cons-gds.prod-code
     1501                         break by  loc_ord-doc.doc-code   :
     1502               l-qnty-fp = l-qnty-fp + loc_ord-line.qnty.
     1503               g-qnty-fp = g-qnty-fp + loc_ord-line.qnty.
     1504               if first-of  ( loc_ord-doc.doc-code ) then do:
     1505               l-cli-code  =  b_clients.obj-type + " "  + string ( b_clients.obj-code).
     1506               l-cli-name  =  b_clients.obj-name.
     1507               l-ord-code  = loc_ord-line.doc-code.
     1508                   tt-line = false  .
     1509                   for each loc_ord-doc-rcv no-lock  where loc_ord-doc-rcv.cons-code =  bf_ord-cons.cons-code
     1510                                                       and loc_ord-doc-rcv.doc-code   = loc_ord-line.doc-code
     1511                                                       and loc_ord-doc-rcv.obj-code   = ub.clients.obj-code
     1512                                                       and loc_ord-doc-rcv.obj-type   = ub.clients.obj-type   ,
     1513                         each loc_ord-line-rcv no-lock where loc_ord-doc-rcv.doc-code   = loc_ord-line.doc-code and
     1514                               loc_ord-doc-rcv.rcv-code   = loc_ord-line-rcv.rcv-code and
     1515                               loc_ord-line-rcv.artic     = bf_ord-cons-gds.artic      and
     1516                               loc_ord-line-rcv.prod-type = bf_ord-cons-gds.prod-type  and
     1517                               loc_ord-line-rcv.prod-code = bf_ord-cons-gds.prod-code  :
     1518                               l-rcv-code  = loc_ord-line-rcv.rcv-code.
     1519                               l-time-rcv  = loc_ord-doc-rcv.ship-time.
     1520                               l-qnty-rcv =  loc_ord-line-rcv.qnty.
     1521                           run create-tt-line .
     1522                           assign
     1523                             tt-line = true
     1524                             l-rcv-code = ""
     1525                             l-time-rcv = 0
     1526                             l-qnty-rcv = 0
     1527                           .
     1528                   end.
     1529                 if tt-line = false then run create-tt-line .
     1530               end.
     1531             ttt-line = true .
     1532             if last-of  ( loc_ord-doc.doc-code ) then l-qnty-fp = 0.
     1533           end.
     1534             if ttt-line = false then  run create-tt-line .
     1535       end.
     1536     end.
     1537   end.
     1538   end procedure .
     1539   procedure make-tt-in :
     1540   define variable tt-line  as logical no-undo .
     1541   define variable ttt-line as logical no-undo .
     1542   define buffer l_clients for ub.clients .
     1543   for each  bf_ord-doc no-lock  where bf_ord-doc.cons-code = bf_ord-cons.cons-code
     1544                                   and bf_ord-doc.doc-type = 'ОФ':U  ,
     1545     first ub.clients  where ub.clients.obj-code =  bf_ord-doc.obj-code
     1546                     and  ub.clients.obj-type =  bf_ord-doc.obj-type no-lock
     1547                     break by ub.clients.obj-type by ub.clients.obj-code:
     1548     if first-of (ub.clients.obj-code) then do:
     1549        ii = 0 .
     1550       for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,
     1551         first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic
     1552               and bf_ord-cons-gds.prod-type = ub.goods.prod-type
     1553               and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1554               assign
     1555                 l-nn = 0
     1556                 l-qnty-of = 0
     1557                 l-time-of = 0
     1558               .
     1559           assign
     1560           l-cli-code  = ""
     1561           l-cli-name  = ""
     1562           l-ord-code  = ""
     1563           ttt-line = false
     1564           l-qnty-fp = 0
     1565           g-qnty-fp = 0
     1566           .
     1567                   tt-line = false  .
     1568                   for each loc_ord-doc-rcv no-lock  where loc_ord-doc-rcv.cons-code =  bf_ord-cons.cons-code
     1569                                                       and loc_ord-doc-rcv.doc-type   = "in":U
     1570                                                       and loc_ord-doc-rcv.obj-code   = ub.clients.obj-code
     1571                                                       and loc_ord-doc-rcv.obj-type   = ub.clients.obj-type   ,
     1572                         each loc_ord-line-rcv no-lock where
     1573                               loc_ord-doc-rcv.doc-code   = loc_ord-line-rcv.doc-code and
     1574                               loc_ord-doc-rcv.rcv-code   = loc_ord-line-rcv.rcv-code and
     1575                               loc_ord-line-rcv.artic     = bf_ord-cons-gds.artic      and
     1576                               loc_ord-line-rcv.prod-type = bf_ord-cons-gds.prod-type  and
     1577                               loc_ord-line-rcv.prod-code = bf_ord-cons-gds.prod-code  :
     1578                               find first l_clients  where l_clients.obj-code =  loc_ord-doc-rcv.cli-code
     1579                                                      and  l_clients.obj-type =  loc_ord-doc-rcv.cli-type no-lock no-error .
     1580                               l-ord-code = "in":U .
     1581                               l-rcv-code = loc_ord-line-rcv.rcv-code .
     1582                               l-time-rcv = loc_ord-doc-rcv.ship-time.
     1583                               l-qnty-rcv = loc_ord-line-rcv.qnty.
     1584                               l-cli-code = l_clients.obj-type + " " + string (l_clients.obj-code).
     1585                               l-cli-name = l_clients.obj-name.
     1586                               l-nn = l-nn + 1.
     1587                               run create-tt-line .
     1588                           assign
     1589                             tt-line = true
     1590                             l-rcv-code = ""
     1591                             l-time-rcv = 0
     1592                             l-qnty-rcv = 0
     1593                           .
     1594                   end.
     1595                   tt-line = false  .
     1596                   for each loc_ord-doc-rcv no-lock  where loc_ord-doc-rcv.cons-code  =  bf_ord-cons.cons-code
     1597                                                       and loc_ord-doc-rcv.doc-type   = "in":U
     1598                                                       and loc_ord-doc-rcv.cli-code   = ub.clients.obj-code
     1599                                                       and loc_ord-doc-rcv.cli-type   = ub.clients.obj-type ,
     1600                         each loc_ord-line-rcv no-lock where
     1601                               loc_ord-doc-rcv.doc-code   = loc_ord-line-rcv.doc-code and
     1602                               loc_ord-doc-rcv.rcv-code   = loc_ord-line-rcv.rcv-code and
     1603                               loc_ord-line-rcv.artic     = bf_ord-cons-gds.artic      and
     1604                               loc_ord-line-rcv.prod-type = bf_ord-cons-gds.prod-type  and
     1605                               loc_ord-line-rcv.prod-code = bf_ord-cons-gds.prod-code  :
     1606                               find first l_clients  where l_clients.obj-code =  loc_ord-doc-rcv.obj-code
     1607                                                      and  l_clients.obj-type =  loc_ord-doc-rcv.obj-type no-lock no-error .
     1608                               l-ord-code = "in":U .
     1609                               l-rcv-code = loc_ord-line-rcv.rcv-code .
     1610                               l-time-rcv = loc_ord-doc-rcv.ship-time.
     1611                               l-qnty-rcv =  ( - 1 ) * loc_ord-line-rcv.qnty.
     1612                               l-cli-code = l_clients.obj-type + " " + string (l_clients.obj-code).
     1613                               l-cli-name = l_clients.obj-name.
     1614                               l-nn = l-nn + 1.
     1615                           run create-tt-line .
     1616                           assign
     1617                             tt-line = true
     1618                             l-rcv-code = ""
     1619                             l-time-rcv = 0
     1620                             l-qnty-rcv = 0
     1621                           .
     1622                   end.
     1623       end.
     1624     end.
     1625   end.
     1626   end procedure .
     1627   procedure create-tt-line :
     1628   ii = ii + 1.
     1629   IF ( ii modulo v-account = 0 )  then DO:
     1630    Assign
     1631       v-kol-spice = (50 - LENGTH(reportname)) / 2
     1632       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     1633       .
     1634    Assign
     1635       v-kol-spice = (50 - LENGTH(ub.clients.obj-name)) / 2
     1636       RecordsString2 = fill(' ',v-kol-spice) + string(ub.clients.obj-name)
     1637       .
     1638    Assign
     1639       v-kol-spice = (50 - LENGTH(ub.goods.gds-name)) / 2
     1640       RecordsString3 = fill(' ',v-kol-spice) + string(ub.goods.gds-name)
     1641       .
     1642             if  log-manager:logfile-name ne ?
     1643             then DO:
     1644                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1645             end.
     1646              if mFrameView
     1647              then do:
     1648               DISPLAY
     1649                 ii @ RecordsDone
     1650                 RecordsString   @ RecordsString
     1651                 RecordsString2  @ RecordsString2
     1652                 RecordsString3  @ RecordsString3
     1653                 WITH FRAME InfoFrame.
     1654              end.
     1655   End.
     1656      if v-button-stop then  DO:
     1657            if mFrameView
     1658            then
     1659               PROCESS EVENTS.
     1660            IF StopProcessing THEN DO:
     1661            RETURN error.
     1662            End.
     1663      end.
     1664    l-nn = l-nn + 1 .
     1665   create temp-tt .
     1666   assign
     1667    temp-tt.nnn         = l-nn
     1668    temp-tt.obj-type    = ub.clients.obj-type + " " + string (ub.clients.obj-code)
     1669    temp-tt.obj-name    = ub.clients.obj-name
     1670    temp-tt.gds-code    = ub.goods.gds-code
     1671    .
     1672    If l-nn = 1 then Do:
     1673         assign
     1674             temp-tt.qnty-of     = l-qnty-of
     1675             temp-tt.time-of     =  (if l-time-of  = 0 then " " else string (l-time-of,"HH:MM"))
     1676             .
     1677          end.
     1678    else
     1679         assign
     1680             temp-tt.qnty-of     = 0
     1681             temp-tt.time-of     = " "
     1682             .
     1683       assign
     1684           temp-tt.qnty-fp     = l-qnty-fp
     1685           temp-tt.cli-cod     = l-cli-code
     1686           temp-tt.cli-name    = l-cli-name
     1687           .
     1688    assign
     1689       temp-tt.ord-code    = l-ord-code
     1690       old-l-ord-code      = l-ord-code
     1691       temp-tt.rcv-code    = l-rcv-code
     1692       temp-tt.time-rcv    =  (if l-time-rcv  = 0 then  " " else string (l-time-rcv,"HH:MM"))
     1693       temp-tt.qnty-rcv    = l-qnty-rcv
     1694   .
     1695   end procedure .
     1696   procedure max-col :
     1697   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1698   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1699   define output parameter p-max as integer no-undo .
     1700        p-max = 0 .
     1701        for each temp-tt where temp-tt.obj-type = p-obj-type  + " " + string (p-obj-code)
     1702          break by temp-tt.nnn DESCENDING :
     1703          p-max = temp-tt.nnn.
     1704          leave.
     1705        end.
     1706   end procedure .
     1707   procedure max-col-host :
     1708   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1709   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1710   define output parameter p-max as integer no-undo .
     1711        p-max = 0 .
     1712        for each temp-tt-host where temp-tt-host.obj-type = p-obj-type  + " " + string (p-obj-code)
     1713          break by temp-tt-host.nnn DESCENDING :
     1714          p-max = temp-tt-host.nnn.
     1715          leave.
     1716        end.
     1717   end procedure .
     1718   procedure new-tmp-page :
     1719    do
     1720    on error undo, return error return-value
     1721    :
     1722       if   num#str#  >= 63000 then do:
     1723           Output stream Macr_Excel  close .
     1724           run paramls-write in this-procedure
     1725              (input "file"
     1726             ,input string (v-ind)
     1727             ,input v-file-name
     1728             ) .
     1729           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1730           output stream  Macr_Excel to value (v-file-name) .
     1731           v-ind = v-ind + 1 .
     1732           num#str# = 0 .
     1733           run proc-print-header-my in this-procedure .
     1734       end.
     1735    end.
     1736   end procedure.
     1737   procedure proc-print-header-my :
     1738    do
     1739    on error undo, return error return-value
     1740    :
     1741      find first sheetf .
     1742        sheetf.excel-row-heder =  num-entries ( c-str ,chr(10)) + 1.
     1743        sheetf.excel-row-title =  num-entries ( sheetf.excel-column-lable , chr(10) ).
     1744        var-1 =  num#str# .
     1745        repeat c-c = 1 to sheetf.excel-row-title :
     1746        num#str# = num#str# + 1 .
     1747        p-var = num-entries ( entry  (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1748        do c-i = 1 to p-var :
     1749           str--1 = entry ( c-i, entry  (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1750           str--2 = integer (entry ( c-i, sheetf.sizes )) .
     1751           num#col# = c-i .
     1752           run macr_excel_char ( str--1  , num#str# , num#col#  ) .
     1753           run macr_cell_size  ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1754        end.
     1755       c-i = 0.
     1756       end.
     1757       run macr_cell_format  (
     1758           10       ,
     1759           true     ,
     1760           false    ,
     1761           35       ,
     1762           var-1 + 1,
     1763           1        ,
     1764           num#str# ,
     1765           num#col# )
     1766           .
     1767        define variable t-var as integer no-undo .
     1768        t-var = 2 .
     1769        do c-i = 1 to p-var :
     1770           str--1 = entry ( c-i, entry  (1 , sheetf.excel-column-lable, chr(10)) , chr(44)) no-error   .
     1771           if  str--1   begins " Арт "  then do:
     1772               t-var = t-var + 1.
     1773               if    ( t-var modulo 2 )  <> 0 then do:
     1774                   put  stream macr_excel unformatted
     1775                         substitute ('select ("r&1c&2:r&3c&4 ")' ,   num#str# - 1 , c-i , num#str# - 1, c-i + 7 ) + chr(10)  +
     1776                         substitute ('patterns (1,,&1,true)', 50 ) + chr(10)  .
     1777               end.
     1778           end.
     1779        end.
     1780     put  stream macr_excel unformatted
     1781          substitute ('select ("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1782           'BORDER ( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1783           'ALIGNMENT (3 , , 4 , 4 ,)'                  + chr(10)
     1784          .
     1785     var-3 = 4 .
     1786     do while var-3 < p-var  :
     1787           put  stream macr_excel unformatted
     1788                substitute ('select ("r&1c&2:r&3c&4 ")' ,   var-1 + 1,  var-3 , var-1 + 1 , var-3 + 5 ) + chr(10)  +
     1789                'ALIGNMENT (7 , , 4 , 4 ,)'              + chr(10)
     1790           .
     1791           var-3 = var-3 + 5 .
     1792      end.
     1793    end.
     1794   end procedure.
     1795   procedure make-tt-host :
     1796   ii = 0 .
     1797   l-nn = 0 .
     1798     for   each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code,
     1799         first ub.goods where bf_ord-cons-gds.artic = ub.goods.artic
     1800               and bf_ord-cons-gds.prod-type = ub.goods.prod-type
     1801               and bf_ord-cons-gds.prod-code = ub.goods.prod-code no-lock :
     1802               assign
     1803                 l-nn = 0
     1804                 l-qnty-of = 0
     1805                 l-time-of = 0
     1806               .
     1807           for each  z_ord-doc no-lock  where z_ord-doc.cons-code = bf_ord-cons.cons-code
     1808                                               and z_ord-doc.doc-type = 'ОФ':U
     1809                                              ,
     1810                   each z_ord-line no-lock where z_ord-doc.doc-code   = z_ord-line.doc-code and
     1811                                                   z_ord-line.artic     = bf_ord-cons-gds.artic      and
     1812                                                   z_ord-line.prod-type = bf_ord-cons-gds.prod-type  and
     1813                                                   z_ord-line.prod-code = bf_ord-cons-gds.prod-code :
     1814                     l-qnty-of = l-qnty-of + z_ord-line.qnty.
     1815           end.
     1816           assign
     1817           l-cli-code  = ""
     1818           l-cli-name  = ""
     1819           l-ord-code  = ""
     1820           l-qnty-fp = 0
     1821           g-qnty-fp = 0
     1822           .
     1823           for each loc_ord-doc no-lock  where loc_ord-doc.cons-code =  bf_ord-cons.cons-code
     1824                                           and loc_ord-doc.doc-type = 'ФП':U
     1825                                     ,
     1826                       first b_clients  where b_clients.obj-code =  loc_ord-doc.cli-code
     1827                                         and  b_clients.obj-type =  loc_ord-doc.cli-type no-lock ,
     1828                       each loc_ord-line no-lock where loc_ord-doc.doc-code   = loc_ord-line.doc-code and
     1829                                           loc_ord-line.artic     = bf_ord-cons-gds.artic      and
     1830                                           loc_ord-line.prod-type = bf_ord-cons-gds.prod-type  and
     1831                                           loc_ord-line.prod-code = bf_ord-cons-gds.prod-code
     1832                         break by  b_clients.obj-type by  b_clients.obj-code  :
     1833               l-qnty-fp = l-qnty-fp + loc_ord-line.qnty.
     1834               if first-of  ( b_clients.obj-code ) then do:
     1835               l-cli-code  =  b_clients.obj-type + " "  + string ( b_clients.obj-code).
     1836               l-cli-name  =  b_clients.obj-name.
     1837               l-qnty-rcv = 0 .
     1838                   for each loc_ord-doc-rcv no-lock  where loc_ord-doc-rcv.cons-code =  bf_ord-cons.cons-code
     1839                                                       and loc_ord-doc-rcv.doc-code   = loc_ord-line.doc-code
     1840                                                       and loc_ord-doc-rcv.cli-code   = b_clients.obj-code
     1841                                                       and loc_ord-doc-rcv.cli-type   = b_clients.obj-type   ,
     1842                         each loc_ord-line-rcv no-lock where loc_ord-doc-rcv.doc-code   = loc_ord-line.doc-code and
     1843                               loc_ord-doc-rcv.rcv-code   = loc_ord-line-rcv.rcv-code and
     1844                               loc_ord-line-rcv.artic     = bf_ord-cons-gds.artic      and
     1845                               loc_ord-line-rcv.prod-type = bf_ord-cons-gds.prod-type  and
     1846                               loc_ord-line-rcv.prod-code = bf_ord-cons-gds.prod-code  :
     1847                               l-qnty-rcv = l-qnty-rcv  +  loc_ord-line-rcv.qnty.
     1848                   end.
     1849               run create-tt-line-host .
     1850               assign
     1851                 l-rcv-code = ""
     1852                 l-time-rcv = 0
     1853                 l-qnty-rcv = 0
     1854                 l-qnty-fp = 0
     1855               .
     1856               end.
     1857           end.
     1858       end.
     1859   end procedure .
     1860   procedure create-tt-line-host :
     1861   ii = ii + 1.
     1862   IF ( ii modulo v-account = 0 )  then DO:
     1863    Assign
     1864       v-kol-spice = (50 - LENGTH(reportname)) / 2
     1865       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     1866       .
     1867    Assign
     1868       v-kol-spice = (50 - LENGTH(ub.clients.obj-name)) / 2
     1869       RecordsString2 = fill(' ',v-kol-spice) + string(ub.clients.obj-name)
     1870       .
     1871    Assign
     1872       v-kol-spice = (50 - LENGTH(ub.goods.gds-name)) / 2
     1873       RecordsString3 = fill(' ',v-kol-spice) + string(ub.goods.gds-name)
     1874       .
     1875             if  log-manager:logfile-name ne ?
     1876             then DO:
     1877                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1878             end.
     1879              if mFrameView
     1880              then do:
     1881               DISPLAY
     1882                 ii @ RecordsDone
     1883                 RecordsString   @ RecordsString
     1884                 RecordsString2  @ RecordsString2
     1885                 RecordsString3  @ RecordsString3
     1886                 WITH FRAME InfoFrame.
     1887              end.
     1888   End.
     1889      if v-button-stop then  DO:
     1890            if mFrameView
     1891            then
     1892               PROCESS EVENTS.
     1893            IF StopProcessing THEN DO:
     1894            RETURN error.
     1895            End.
     1896      end.
     1897    l-nn = l-nn + 1 .
     1898   create temp-tt-host .
     1899   assign
     1900       temp-tt-host.nnn         = l-nn
     1901       temp-tt-host.obj-type    = 'орг':U + " " + string ( v-cntxt-host-code-obj )
     1902       temp-tt-host.obj-name    = v-cntxt-host-name-obj
     1903       temp-tt-host.gds-code    = ub.goods.gds-code
     1904       temp-tt-host.qnty-of     = l-qnty-of
     1905       temp-tt-host.qnty-fp     = l-qnty-fp
     1906       temp-tt-host.cli-cod     = l-cli-code
     1907       temp-tt-host.cli-name    = l-cli-name
     1908       temp-tt-host.ord-code    = l-ord-code
     1909       temp-tt-host.rcv-code    = l-rcv-code
     1910       temp-tt-host.qnty-rcv    = l-qnty-rcv
     1911       .
     1912   end procedure .
     1913   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1914   procedure macr_excel_char :
     1915    do
     1916    on error undo, return error return-value
     1917    :
     1918    define input parameter  p-val as character no-undo .
     1919    define input parameter  p-row as integer no-undo .
     1920    define input parameter  p-col as integer no-undo .
     1921    if p-val = ? then p-val = "" .
     1922       put stream macr_excel unformatted
     1923             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1924    end.
     1925   end procedure.
     1926   procedure macr_excel_char_with_format :
     1927    do
     1928    on error undo, return error return-value
     1929    :
     1930    define input parameter  p-val as character no-undo .
     1931    define input parameter  p-row as integer no-undo .
     1932    define input parameter  p-col as integer no-undo .
     1933    if p-val = ? then p-val = "" .
     1934       put stream macr_excel unformatted
     1935             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1936       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1937       put stream macr_excel unformatted
     1938             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1939    end.
     1940   end procedure.
     1941   procedure macr_excel_cell_format :
     1942    do
     1943    on error undo, return error return-value
     1944    :
     1945    define input parameter  p-val    as character no-undo .
     1946    define input parameter  p-row    as integer   no-undo .
     1947    define input parameter  p-col    as integer   no-undo .
     1948    define input parameter  p-format as character no-undo .
     1949    if p-val = ? then p-val = "" .
     1950       put stream macr_excel unformatted
     1951             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1952       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1953       put stream macr_excel unformatted
     1954             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1955    end.
     1956   end procedure.
     1957   procedure macr_excel_sum :
     1958    do
     1959    on error undo, return error return-value
     1960    :
     1961    define input parameter  p-row as integer no-undo .
     1962    define input parameter  p-col as integer no-undo .
     1963    define input parameter  p-row1 as integer no-undo .
     1964    define input parameter  p-col1 as integer no-undo .
     1965    define input parameter  p-row2 as integer no-undo .
     1966    define input parameter  p-col2 as integer no-undo .
     1967       put stream macr_excel unformatted
     1968             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1969    end.
     1970   end procedure.
     1971   procedure macr_excel_dec :
     1972    do
     1973    on error undo, return error return-value
     1974    :
     1975    define input parameter  p-val as character no-undo .
     1976    define input parameter  p-row as integer   no-undo .
     1977    define input parameter  p-col as integer   no-undo .
     1978     if p-val = ? then p-val =  "" .
     1979      put  stream macr_excel unformatted
     1980           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1981    end.
     1982   end procedure.
     1983   procedure macr_cell_format :
     1984    do
     1985    on error undo, return error return-value
     1986    :
     1987    define input parameter  p-size   as integer   no-undo .
     1988    define input parameter  p-bold   as logical   no-undo .
     1989    define input parameter  p-italic as logical   no-undo .
     1990    define input parameter  p-color  as integer   no-undo .
     1991    define input parameter  p-row    as integer   no-undo .
     1992    define input parameter  p-col    as integer   no-undo .
     1993    define input parameter  p-row-2  as integer   no-undo .
     1994    define input parameter  p-col-2  as integer   no-undo .
     1995     if p-size = ? then p-size = 10 .
     1996     if p-bold = ? then p-bold = false .
     1997     if p-italic = ? then p-italic = false .
     1998     if p-row-2 = ? then p-row-2 = p-row .
     1999     if p-col-2 = ? then p-col-2 = p-col .
     2000     put  stream macr_excel unformatted
     2001      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2002     if p-color <> ? then do:
     2003        put  stream macr_excel unformatted
     2004          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2005     end.
     2006     put  stream macr_excel unformatted
     2007          substitute('format.font(,&1,&2,&3)' , p-size,
     2008                                           string ( p-bold  , "true/false" ) ,
     2009                                           string ( p-italic , "true/false" )
     2010                                           ) + chr(10) .
     2011    end.
     2012   end procedure.
     2013   procedure macr_cell_size :
     2014    do
     2015    on error undo, return error return-value
     2016    :
     2017    define input parameter  p-w   as integer   no-undo .
     2018    define input parameter  p-l   as integer   no-undo .
     2019    define input parameter  p-row    as integer   no-undo .
     2020    define input parameter  p-col    as integer   no-undo .
     2021    define input parameter  p-row-2  as integer   no-undo .
     2022    define input parameter  p-col-2  as integer   no-undo .
     2023     if p-row-2 = ? then p-row-2 = p-row .
     2024     if p-col-2 = ? then p-col-2 = p-col .
     2025     if p-w = ? then    p-w = 0 .
     2026     if p-l = ? then    p-l = 0 .
     2027    define variable s-w as character no-undo .
     2028    define variable s-l as character no-undo .
     2029    if p-w = 0 then s-w = "" .
     2030               else s-w = string(p-w)  .
     2031    if p-l = 0 then s-l = "" .
     2032               else s-l = string(p-l)  .
     2033   put  stream macr_excel unformatted
     2034        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2035   put  stream macr_excel unformatted
     2036        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2037   put  stream macr_excel unformatted
     2038        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2039    end.
     2040   end procedure.
     2041   procedure proc-print-header :
     2042    do
     2043    on error undo, return error return-value
     2044    :
     2045      find first sheetf .
     2046        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2047        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2048        var-1 =  num#str# .
     2049        repeat c-c = 1 to sheetf.excel-row-title :
     2050        num#str# = num#str# + 1 .
     2051        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2052        do c-i = 1 to p-var :
     2053           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2054           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2055           num#col# = c-i .
     2056           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2057           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2058        end.
     2059       c-i = 0.
     2060       end.
     2061       run macr_cell_format (
     2062           10       ,
     2063           true     ,
     2064           false    ,
     2065           35       ,
     2066           var-1 + 1,
     2067           1        ,
     2068           num#str# ,
     2069           num#col# )
     2070           .
     2071     put  stream macr_excel unformatted
     2072          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2073          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2074          .
     2075    end.
     2076   end procedure.
     2077   procedure end-proc :
     2078    do
     2079    on error undo, return error return-value
     2080    :
     2081     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2082     OUTPUT to VALUE (v-file-name) .
     2083     for each temp-param :
     2084       export  temp-param  .
     2085     end.
     2086    end.
     2087   end procedure.
