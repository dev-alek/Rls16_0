     1168   main-block :
     1169   do on error undo main-block, return error
     1170   :
     1171   find first  bf_ord-cons where recid (bf_ord-cons) = c-rc no-lock no-error .
     1172   for each  bf_ord-cons-gds no-lock  where bf_ord-cons-gds.cons-code = bf_ord-cons.cons-code :
     1173    ii = ii + 1.
     1174    if ii > 31 then leave.
     1175   end.
     1176   if ii > 31 then do:
     1177       message "Отчет не может быть выполнен на такое количество товаров !  "
     1178       skip
     1179       "Воспользуйтесь отчетом 'Совокупная заявка по товарам ' "
     1180       view-as alert-box error.
     1181       return error.
     1182   end.
     1183       p-file-name =  string ( session:temp-directory +
     1184                                     "rpt" + string ( g#report-num ) + ".txt" ) .
     1185       output stream outstream to value ( string ( session:temp-directory +
     1186                                     "rpt" + string ( g#report-num ) ) )      .
     1187       output stream outstream2 to value (p-file-name).
