     1237   v-nn = num-entries ( reportheader , "chr(10)"  )  .   do l-ii = 1 to v-nn  :        l-len = length  (entry ( l-ii , reportheader  , "chr(10)")) .                       l-m = integer ( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format  (                                                                        substring (entry ( l-ii , reportheader  , "chr(10)") ,  ( ( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1238   Sheetf.Excel-Column-Lable = "Код объекта ,Наименование объекта  ,".
