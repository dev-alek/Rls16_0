      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   define variable v-waitfram-action01         as character   no-undo .
      305   define variable v-waitfram-action02         as character   no-undo .
      306   define variable v-waitfram-action03         as character   no-undo .
      307   define variable mWaitFramTextBeg            as character   no-undo.
      308   define variable mWaitFramTextEnd            as character   no-undo.
      309   define variable mWaitFramView               as logical     no-undo.
      310   define variable mWaitProcEvent              as logical     no-undo init yes.
      311   define variable mWaitFramInterval           as integer     no-undo init 1 .
      312   define variable mWaitFramStop               as logical     no-undo.
      313   define variable mWaitFramStopUser           as logical     no-undo.
      314   define variable mWaitFramStopTimeOut        as logical     no-undo.
      315   define variable mWaitFramStartProc          as datetime-tz no-undo.
      316   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      317   define button B-WaitFramStop auto-end-key
      318        label "Стоп"
      319        size 10 by 1 tooltip "Остоновить процесс".
      320   define button B-viewProcInfo
      321        label "Информация"
      322        size 15 by 1 tooltip "Информация о процесс".
      323   define frame waitfram
      324     v-waitfram-action01 format "x(72)" no-label skip
      325     v-waitfram-action02 format "x(72)" no-label skip
      326     v-waitfram-action03 format "x(72)" no-label skip
      327     B-viewProcInfo
      328     B-WaitFramStop at row 4 col 30
      329     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      330     .
      331   define new global shared variable mBatchMode as logical no-undo init ?.
      332   define variable mFramBachModHandle as handle no-undo.
      333   mFramBachModHandle = frame waitfram:handle.
      334   define variable mFameOldVis as logical no-undo.
      335   define variable mVisCUrentVin as logical no-undo.
      336   if session:batch-mode
      337   then
      338      mBatchMode = yes.
      339   if mBatchMode = ? then do:
      340     mVisCUrentVin = current-window:visible.
      341     mFameOldVis = mFramBachModHandle:visible.
      342     mFramBachModHandle:visible  = yes.
      343     mBatchMode = mFramBachModHandle:visible ne yes.
      344     mFramBachModHandle:visible = mFameOldVis.
      345     current-window:visible = mVisCUrentVin.
      346   end.
      347    if  log-manager:logfile-name ne ?
      348     then DO:
      349         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      350         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      351         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      352     end.
      353   on choose of B-WaitFramStop in frame waitfram
      354   do:
      355     mWaitFramStop = yes.
      356     mWaitFramStopUser = yes.
      357   end.
      358   function waitfram-check-timeout returns logical():
      359      define variable vtime as int64 no-undo.
      360      if mWaitFramStopTimeOut
      361      then
      362         return yes.
      363      vtime = ( now - mWaitFramStartProc ) / 1000 .
      364      if     mWaitFramTimeOut ne ?
      365         and mWaitFramTimeOut ne 0
      366         and mWaitFramTimeOut lt vtime
      367      then do:
      368         mWaitFramStopTimeOut = yes.
      369      end.
      370      return mWaitFramStopTimeOut.
      371   end.
      372   procedure waitfram-hide :
      373     if not session:batch-mode
      374     then do
      375     on error undo, return error return-value
      376     :
      377       pause 0 before-hide .
      378       if not mBatchMode then
      379         hide frame waitfram .
      380     if     not mWaitFramView
      381        and mWaitProcEvent
      382     then
      383       process events .
      384     end.
      385   end procedure.
      386   procedure waitfram-show :
      387     define input  parameter p-message as character no-undo .
      388     define variable v-left-margin as integer   no-undo .
      389     if not session:batch-mode
      390     then do
      391     on error undo, return error return-value
      392     :
      393       if length(p-message) <= 70 then do:
      394         assign
      395           v-left-margin = integer((70 - length(p-message)) / 2)
      396         .
      397         assign
      398           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      399         .
      400         assign
      401           v-waitfram-action01 = " "
      402           v-waitfram-action02 = " "
      403                                    + fill(" ", v-left-margin)
      404                                    + p-message
      405           v-waitfram-action03 = " "
      406         .
      407       end.
      408       else do:
      409         define variable vRindex1 as integer no-undo.
      410         define variable vRindex2 as integer no-undo.
      411         vRindex1 = r-index(p-message," ",70).
      412         if vRindex1 = 0
      413         then
      414            vRindex1 = 70.
      415         if length(p-message)  <= vRindex1 + 70 then do:
      416           assign
      417             v-waitfram-action01 = " "
      418             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      419             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      420           .
      421         end.
      422         else do:
      423           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      424           if vRindex2 <= vRindex1
      425           then
      426              vRindex2 = vRindex1 + 70.
      427           assign
      428             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      429             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      430             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      431           .
      432         end.
      433       end.
      434       B-viewProcInfo:visible   in frame waitfram = no.
      435       B-viewProcInfo:sensitive in frame waitfram = no.
      436       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      437       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      438       if  (   mWaitFramView
      439          or  mWaitProcEvent)
      440          and not mBatchMode
      441       then
      442          display
      443             v-waitfram-action01 skip
      444             v-waitfram-action02 skip
      445             v-waitfram-action03 skip
      446          with frame waitfram .
      447       if     mWaitFramView
      448          then do:
      449             if     mWaitFramInterval ne ?
      450                and not mBatchMode
      451             then
      452                wait-for go of frame waitfram pause mWaitFramInterval.
      453          end.
      454          else
      455             if     mWaitProcEvent
      456                and not mBatchMode
      457             then
      458                process events .
      459     end.
      460   end procedure.
      461      procedure waitfram-show-this:
      462         define input  parameter iInterval as int64 no-undo.
      463         define variable vtime as int64 no-undo.
      464         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      465         mWaitFramInterval = iInterval.
      466         run waitfram-show (substitute("&1&2 &3&4" ,
      467                                       mWaitFramTextBeg ,
      468                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      469                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      470                                       mWaitFramTextEnd
      471                                      )
      472                           ).
      473      end.
      474      procedure WaitFramRunPause:
      475         define input  parameter iInterval as dec no-undo.
      476         define variable vStart  as datetime-tz no-undo.
      477         define variable vend    as datetime-tz no-undo.
      478         define variable vint as int64 no-undo.
      479         define variable vOk as logical no-undo.
      480         vStart = now.
      481         vend   = vStart.
      482         publish "WaitFramPause" (iInterval,output vOk).
      483         vend   =  now.
      484         vint = vend - vStart.
      485         vint = iInterval - vint / 1000.
      486         if     not mWaitFramStop
      487            and (   vint > 0
      488                 or (    not vOk
      489                     and iInterval eq ?
      490                     )
      491                 )
      492         then
      493            run waitfram-show-this (iInterval).
      494         vend   =  now.
      495         vint = vend - vStart.
      496         vint = iInterval - vint / 1000.
      497         if     not mWaitFramStop
      498            and vint > 0
      499         then do:
      500            run gbl/pause.p (vint * 1000).
      501         end.
      502         if iInterval ne ?
      503         then
      504            publish "WaitFramStop".
      505         waitfram-check-timeout().
      506      end.
      507      procedure WaitFramWaitFor:
      508         define input  parameter iInterval as dec no-undo.
      509         assign
      510            mWaitFramStartProc   = now
      511            mWaitFramStopUser    = no
      512            mWaitFramStopTimeOut = no
      513         .
      514         block-wait:
      515         do while not mWaitFramStop:
      516            run WaitFramRunPause (iInterval).
      517            if  waitfram-check-timeout()
      518            then do:
      519               leave block-wait.
      520            end.
      521         end.
      522         run waitfram-hide.
      523      end.
      524   procedure waitfram-join :
      525     define input  parameter p-line-1  as character no-undo .
      526     define input  parameter p-line-2  as character no-undo .
      527     define input  parameter p-line-3  as character no-undo .
      528     define output parameter p-message as character no-undo .
      529     do
      530     on error undo, return error return-value
      531     :
      532       assign
      533         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      534                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      535                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      536       .
      537     end.
      538   end procedure.
      539   function waitfram-join-function returns character
      540     (input p-line-1 as character
      541     ,input p-line-2 as character
      542     ,input p-line-3 as character
      543     ).
      544     define variable v-message as character no-undo .
      545     run waitfram-join in this-procedure
      546       (input  p-line-1
      547       ,input  p-line-2
      548       ,input  p-line-3
      549       ,output v-message
      550       ) .
      551     return v-message .
      552   end function .
      553   define new global shared variable g#library  as handle no-undo .
      554   define new global shared variable g#library2 as handle no-undo .
      555   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556     define variable v-cntxt-db-num        as integer   no-undo .
      557     define variable v-cntxt-userid        as character no-undo .
      558     define variable v-cntxt-level         as character no-undo .
      559     define variable v-cntxt-host-code-obj as integer   no-undo .
      560     define variable v-cntxt-obj-type      as character no-undo .
      561     define variable v-cntxt-obj-code      as integer   no-undo .
      562     define variable v-cntxt-db-num-obj    as integer   no-undo .
      563     define variable v-cntxt-is-admin      as logical   no-undo .
      564   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565     run mainmenu_getcntxt in parparentproc
      566       (output v-cntxt-db-num
      567       ,output v-cntxt-userid
      568       ,output v-cntxt-level
      569       ,output v-cntxt-host-code-obj
      570       ,output v-cntxt-obj-type
      571       ,output v-cntxt-obj-code
      572       ,output v-cntxt-db-num-obj
      573       ,output v-cntxt-is-admin
      574       ) .
      575   define buffer   buf_old_tmp-sale for ub.tmp-sale      .
      576   define buffer   buf_tmp-sale     for ub.tmp-sale      .
      577   define buffer   buf_tmp-sale-gds for ub.tmp-sale-gds  .
      578   define buffer   buf_tmp-sale-dtl for ub.tmp-sale-dtl  .
      579   define buffer   buf_goods        for ub.goods         .
      580   define buffer   b2_abc-analysis       for ub.abc-analysis .
      581   define buffer   b2_abc-analysis-goods for ub.abc-analysis-goods .
      582   define variable v-new            as integer no-undo   .
      583   define variable v-max            as integer no-undo   .
      584   define variable v-list-recid as character no-undo .
      585   define variable v-ii as integer   no-undo .
      586   run ref/abcanal.w
      587   ( input   parparentproc  ,
      588     input  "b-mark,b-sel" ,
      589     output  v-list-recid  )
      590     .
      591    p-recid = v-list-recid  .
      592   if num-entries( v-list-recid ) < 1 then do:
      593      message
      594      "Не выбран ни один анализ !"
      595      view-as alert-box information .
      596      p-recid = ? .
      597      return.
      598   end.
      599   if num-entries( v-list-recid ) > 2 then do:
      600      message
      601      "Выбрать надо было 2 анализа !"
      602      view-as alert-box information .
      603      p-recid = ? .
      604      return.
      605   end.
      606   define variable loc-tmp-code as character no-undo .
      607       run waitfram-show in this-procedure  ("Ждите...") .
      608       for each tmp#zakaz :
      609       assign
      610          tmp#zakaz.add-cli-qnty    = 0
      611          tmp#zakaz.add-qnty        = 0
      612          tmp#zakaz.temp-rash       = 0
      613          tmp#zakaz.cancel-cli-qnty = 0
      614          tmp#zakaz.cancel-qnty     = 0
      615       .
      616       end.
      617         find first  b2_abc-analysis no-lock where recid( b2_abc-analysis ) = int(entry(2,v-list-recid)) no-error .
      618         find first  ub.abc-analysis no-lock where recid( ub.abc-analysis ) = int(entry(1,v-list-recid)) no-error .
      619         if available ub.abc-analysis then do:
      620              for each tmp#zakaz :
      621                 find first ub.abc-analysis-goods no-lock where
      622                            ub.abc-analysis-goods.abc-id = ub.abc-analysis.abc-id and
      623                            ub.abc-analysis-goods.db-num = ub.abc-analysis.db-num and
      624                            ub.abc-analysis-goods.gds-code = tmp#zakaz.gds-code no-error .
      625                 if available ub.abc-analysis-goods then do:
      626                     assign
      627                       tmp#zakaz.add-cli-qnty    =   ASC(ub.abc-analysis-goods.abcg-abc)
      628                       tmp#zakaz.add-qnty        =   ub.abc-analysis-goods.rating
      629                       tmp#zakaz.temp-rash       =   ub.abc-analysis-goods.abcg-temp-sale-goods
      630                     .
      631                 end.
      632                 find first b2_abc-analysis-goods no-lock where
      633                            b2_abc-analysis-goods.abc-id = b2_abc-analysis.abc-id and
      634                            b2_abc-analysis-goods.db-num = b2_abc-analysis.db-num and
      635                            b2_abc-analysis-goods.gds-code = tmp#zakaz.gds-code no-error .
      636                 if available b2_abc-analysis-goods then do:
      637                     assign
      638                         tmp#zakaz.cancel-cli-qnty =   ASC(b2_abc-analysis-goods.abcg-abc)
      639                         tmp#zakaz.cancel-qnty     =   b2_abc-analysis-goods.rating
      640                     .
      641                 end.
      642             end.
      643       end.
      644   run waitfram-hide in this-procedure .
