        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Список других поставщиков по товару".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define Input Parameter xartic     like ub.cli-gds.artic no-undo.
      111   define Input Parameter xprod-type like ub.cli-gds.prod-type no-undo.
      112   define Input Parameter xprod-code like ub.cli-gds.prod-code no-undo.
      113   define Input Parameter xcli-type like ub.cli-gds.cli-type no-undo.
      114   define Input Parameter xcli-code like ub.cli-gds.cli-code no-undo.
      115   DEFINE BUTTON B-exit AUTO-GO
      116        LABEL "Выход"
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON B-Help
      120        LABEL "Помо&щь"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON B-select
      124        LABEL "Выбрать"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE QUERY BROWSE-2 FOR
      128         ub.cli-gds,
      129         ub.clients SCROLLING.
      130   DEFINE BROWSE BROWSE-2
      131     QUERY BROWSE-2 NO-LOCK DISPLAY
      132         (ub.clients.obj-type + " " + String(ub.clients.obj-code)) @ ub.clients.obj-type COLUMN-LABEL "Код" FORMAT "X(8)":U
      133         ub.clients.obj-name COLUMN-LABEL "Поставщик" FORMAT "X(40)":U
      134         ub.cli-gds.price-cli FORMAT "->>,>>>,>>>,>>9.999":U
      135         ub.cli-gds.unit-cli COLUMN-LABEL "Ед.изм." FORMAT "X(3)":U
      136         ub.cli-gds.cli-art FORMAT "X(14)":U
      137       WITH NO-ROW-MARKERS SEPARATORS SIZE 94 BY 9.5.
      138   DEFINE FRAME Dialog-Frame
      139        B-exit AT ROW 1 COL 1
      140        B-select AT ROW 1 COL 11
      141        B-Help AT ROW 1 COL 85
      142        BROWSE-2 AT ROW 2.75 COL 1.5
      143        SPACE(0.00) SKIP(0.03)
      144       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      145            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      146            TITLE "У других поставщиков..."
      147            DEFAULT-BUTTON B-select CANCEL-BUTTON B-exit.
      148   ASSIGN
      149          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      150          FRAME Dialog-Frame:HIDDEN           = TRUE.
      151   ASSIGN
      152          B-select:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      153   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      154   DO:
      155     APPLY "END-ERROR":U TO SELF.
      156   END.
      157   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      158   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      159   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160   on help of frame Dialog-Frame
      161   do:
      162     run gbl/app_help.p
      163       (input this-procedure :file-name
      164       ,input ''
      165       ,input ?
      166       ) no-error.
      167     if error-status :error then do:
      168       message
      169         "Ошибка при вызове помощи"
      170         error-status :get-message(1)
      171         view-as alert-box .
      172     end.
      173   end.
      174   run minbtn-set in this-procedure .
      175   on choose of b-help in frame Dialog-Frame
      176   do:
      177     apply "help":u to frame Dialog-Frame .
      178   end.
      179   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   procedure minbtn-set :
      181       do
      182           on error undo, return error return-value
      183           :
      184           define variable ii              as integer       no-undo .
      185           define variable fh              as widget-handle no-undo .
      186           define variable hh              as widget-handle no-undo .
      187           define variable v-h             as handle        extent 4 no-undo .
      188           define variable v-name-button   as character     no-undo .
      189           define variable v-help-old-x    as decimal       no-undo .
      190           define variable v-help-old-y    as decimal       no-undo .
      191           define variable v-help-old-size as decimal       no-undo .
      192           define variable v-frame-width   as decimal       no-undo .
      193           define variable jj              as integer       no-undo .
      194           do
      195               on error undo, return error
      196               :
      197               assign
      198                   v-frame-width = frame Dialog-Frame:width - 0.3
      199                   fh            = frame Dialog-Frame:first-child
      200                   hh            = fh:first-child
      201                   ii            = 1
      202                   .
      203               do while valid-handle(hh):
      204                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      205                   do:
      206                       case lc(hh:name) :
      207                           when "b-help" then
      208                               do:
      209                                   hh:load-image-up("cmp/b-help.bmp":u) .
      210                                   hh:load-image-down("cmp/b-help.bmp":u) .
      211                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      212                                   hh:TOOLTIP = "Помощь" .
      213                                   v-help-old-x = hh:column .
      214                                   v-help-old-y = hh:row    .
      215                                   v-help-old-size = hh:width .
      216                                   hh:width-chars = 2.5 .
      217                               end.
      218                           when "b-print" then
      219                               do:
      220                                   hh:load-image("cmp/b-print.bmp":u) .
      221                                   hh:TOOLTIP = "Печать" .
      222                                   v-h[ii] = hh:handle .
      223                                   ii = ii + 1 .
      224                                   hh:width-chars = 3 .
      225                               end.
      226                           when "b-history" or
      227                           when "b-hist" then
      228                               do:
      229                                   hh:load-image("cmp/b-hist.bmp":u) .
      230                                   hh:TOOLTIP = "История" .
      231                                   v-h[ii] = hh:handle .
      232                                   ii = ii + 1 .
      233                                   hh:width-chars = 3 .
      234                               end.
      235                           when "b-sch" then
      236                               do:
      237                                   hh:load-image("cmp/b-sch.bmp":u) .
      238                                   hh:TOOLTIP = "Установка Фильтра" .
      239                                   v-h[ii] = hh:handle .
      240                                   ii = ii + 1 .
      241                                   hh:width-chars = 3 .
      242                               end.
      243                           when "b-hist-user" then
      244                               do:
      245                                   hh:load-image("cmp/b-hist.bmp":u) .
      246                                   hh:TOOLTIP = "История пользователя" .
      247                                   ii = ii + 1 .
      248                               end.
      249                       end case.
      250                   end.
      251                   hh = hh:next-sibling.
      252               end.
      253               b-help:column = v-frame-width - b-help:width-chars.
      254               jj = 0.
      255               repeat ii = 4 to 1 by -1 :
      256                   if valid-handle (v-h[ii] ) then
      257                   do:
      258                       jj  = jj + 1 .
      259                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      260                       v-h[ii]:row    = v-help-old-y .
      261                   end.
      262               end.
      263           end.
      264       end.
      265   end procedure.
      266   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      267   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      268   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      269   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      270   define variable v-diasize-current-frame-width  as decimal   no-undo .
      271   define variable v-diasize-current-frame-height as decimal   no-undo .
      272   define variable v-diasize-change-size          as logical   no-undo .
      273   define variable v-diasize-resize-button        as handle    no-undo .
      274   define variable v-diasize-wndmax               as logical   no-undo .
      275   define variable v-diasize-wndstore             as logical   no-undo .
      276   define variable v-diasize-proc-name            as character no-undo .
      277   define variable v-diasize-browse-handle        as handle    no-undo .
      278   define variable v-diasize-browse-number        as integer   no-undo .
      279   define variable v-diasize-need-full-display    as logical   no-undo init false .
      280   define temp-table temp-diasize-handle no-undo
      281     field handle-value  as handle
      282     field save-position as decimal
      283     index xpk is primary unique handle-value
      284     .
      285   define temp-table temp-browse-handle no-undo
      286     field browse-type   as character
      287     field browse-number as integer
      288     field browse-handle as handle
      289     field original-size as decimal
      290     index xpk is primary unique browse-type browse-number
      291     index xie browse-type browse-handle
      292   .
      293   procedure diasize_change-height :
      294     define input  parameter p-change-value  as decimal   no-undo .
      295     define input  parameter p-move-resize   as logical   no-undo .
      296     define variable v-field-group-handle    as handle    no-undo .
      297     define variable v-object-handle         as handle    no-undo .
      298     define variable v-frame-height          as decimal   no-undo .
      299     define variable v-frame-virtual-height  as decimal   no-undo .
      300     define variable v-browse-height         as decimal   no-undo .
      301     define variable v-window-height         as decimal   no-undo .
      302     define variable v-window-virtual-height as decimal   no-undo .
      303     define variable v-change-sign           as integer   no-undo .
      304     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      305     define buffer buf_temp-browse-handle  for temp-browse-handle .
      306     if p-change-value > 0
      307     then do:
      308       if frame Dialog-Frame :height + p-change-value
      309           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      310       then do:
      311         assign
      312           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      313                           - (frame Dialog-Frame :height-chars)
      314         .
      315         if p-change-value <= 0
      316         then do:
      317           run diasize_position-resize-button in this-procedure .
      318           return .
      319         end.
      320       end.
      321     end.
      322     if p-change-value < 0
      323     then do:
      324       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      325       then do:
      326         assign
      327           p-change-value = v-diasize-orig-frame-height
      328                          - (frame Dialog-Frame :height-chars)
      329         .
      330         if p-change-value >= 0
      331         then do:
      332           run diasize_position-resize-button in this-procedure .
      333           return .
      334         end.
      335       end.
      336     end.
      337     if p-change-value >= 0
      338     then do:
      339       assign
      340         v-change-sign = 1
      341       .
      342     end.
      343     else do:
      344       assign
      345         v-change-sign = -1
      346       .
      347     end.
      348     assign
      349       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      350     .
      351     if p-change-value = 0
      352     then do:
      353       run diasize_position-resize-button in this-procedure .
      354       return .
      355     end.
      356     move_block:
      357     do
      358     on error undo move_block, retry move_block
      359     :
      360       if retry
      361       then do:
      362         do
      363         on error undo move_block, leave move_block
      364         :
      365           if p-change-value > 0
      366           then do:
      367             for each buf_temp-diasize-handle
      368             on error undo, next
      369             :
      370               assign
      371                 v-object-handle = buf_temp-diasize-handle.handle-value
      372               .
      373               if v-object-handle <> v-diasize-resize-button
      374               then do:
      375                 assign
      376                   v-object-handle :row = buf_temp-diasize-handle.save-position
      377                 .
      378               end.
      379             end.
      380             assign
      381               v-diasize-browse-handle :height = v-browse-height
      382             .
      383             for each buf_temp-browse-handle
      384               where buf_temp-browse-handle.browse-type = 'height':u
      385             on error undo, next
      386             :
      387               assign
      388                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      389               .
      390             end.
      391             assign
      392               frame Dialog-Frame :height = v-frame-height
      393             .
      394             if frame Dialog-Frame :scrollable = true
      395             then do:
      396               assign
      397                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      398               .
      399             end.
      400             run diasize_position-resize-button in this-procedure .
      401           end.
      402           else do:
      403             if frame Dialog-Frame :scrollable = true
      404             then do:
      405               assign
      406                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      407               .
      408             end.
      409             assign
      410               frame Dialog-Frame :height = v-frame-height
      411             .
      412             assign
      413               v-diasize-browse-handle :height = v-browse-height
      414             .
      415             for each buf_temp-browse-handle
      416               where buf_temp-browse-handle.browse-type = 'height':u
      417             on error undo, next
      418             :
      419               assign
      420                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      421               .
      422             end.
      423             for each buf_temp-diasize-handle
      424             on error undo, next
      425             :
      426               assign
      427                 v-object-handle = buf_temp-diasize-handle.handle-value
      428               .
      429               if v-object-handle <> v-diasize-resize-button
      430               then do:
      431                 assign
      432                   v-object-handle :row = buf_temp-diasize-handle.save-position
      433                 .
      434               end.
      435             end.
      436             run diasize_position-resize-button in this-procedure .
      437           end.
      438           assign
      439             v-diasize-change-size = false
      440           .
      441           leave move_block .
      442         end.
      443       end.
      444       assign
      445         v-diasize-need-full-display = true
      446       .
      447       if v-diasize-change-size = false
      448       then do:
      449         assign
      450           v-diasize-change-size = true
      451         .
      452       end.
      453       else do:
      454         return .
      455       end.
      456       assign
      457         v-frame-height = frame Dialog-Frame :height
      458         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      459         v-browse-height = v-diasize-browse-handle :height
      460       .
      461       for each buf_temp-browse-handle
      462         where buf_temp-browse-handle.browse-type = 'height':u
      463       :
      464         assign
      465           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      466         .
      467       end.
      468       for each buf_temp-diasize-handle
      469       :
      470         delete buf_temp-diasize-handle .
      471       end.
      472       assign
      473         v-field-group-handle = frame Dialog-Frame :first-child
      474       .
      475       do while valid-handle(v-field-group-handle)
      476       :
      477         assign
      478           v-object-handle = v-field-group-handle :first-child
      479         .
      480         do while valid-handle(v-object-handle)
      481         :
      482           if  v-object-handle <> v-diasize-browse-handle :handle
      483           and can-query(v-object-handle, "row")
      484           and can-query(v-object-handle, "height")
      485           and ( v-object-handle :row > v-diasize-browse-handle :row )
      486           then do:
      487             find first buf_temp-browse-handle
      488               where buf_temp-browse-handle.browse-type   = 'height':u
      489                 and buf_temp-browse-handle.browse-handle = v-object-handle
      490               no-error .
      491             if available buf_temp-browse-handle
      492             then do:
      493             end.
      494             else do:
      495               create buf_temp-diasize-handle .
      496               assign
      497                 buf_temp-diasize-handle.handle-value  = v-object-handle
      498                 buf_temp-diasize-handle.save-position = v-object-handle :row
      499               .
      500             end.
      501           end.
      502           assign
      503             v-object-handle = v-object-handle :next-sibling
      504           .
      505         end.
      506         assign
      507           v-field-group-handle = v-field-group-handle :next-sibling
      508         .
      509       end.
      510       do with frame Dialog-Frame
      511       :
      512         hide v-diasize-resize-button .
      513         assign
      514           v-diasize-resize-button :row    = 1
      515           v-diasize-resize-button :column = 1
      516         .
      517       end.
      518       if p-change-value > 0
      519       then do:
      520         if frame Dialog-Frame :scrollable = true
      521         then do:
      522           assign
      523             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      524             no-error .
      525           if error-status :error
      526           or error-status :get-message(1) <> ""
      527           then do:
      528             undo move_block, retry move_block .
      529           end.
      530         end.
      531         assign
      532           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      533           no-error .
      534         if error-status :error
      535         or error-status :get-message(1) <> ""
      536         then do:
      537           undo move_block, retry move_block .
      538         end.
      539         assign
      540           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      541           no-error .
      542         if error-status :error
      543         or error-status :get-message(1) <> ""
      544         then do:
      545           undo move_block, retry move_block .
      546         end.
      547         for each buf_temp-browse-handle
      548           where buf_temp-browse-handle.browse-type = 'height':u
      549         on error undo move_block, retry move_block
      550         :
      551           assign
      552             buf_temp-browse-handle.browse-handle :height
      553               = buf_temp-browse-handle.browse-handle :height + p-change-value
      554             no-error .
      555           if error-status :error
      556           or error-status :get-message(1) <> ""
      557           then do:
      558             undo move_block, retry move_block .
      559           end.
      560         end.
      561         for each buf_temp-diasize-handle
      562         on error undo move_block, retry move_block
      563         :
      564           assign
      565             v-object-handle = buf_temp-diasize-handle.handle-value
      566           .
      567           if v-object-handle <> v-diasize-resize-button
      568           then do:
      569             assign
      570               v-object-handle :row = v-object-handle :row + p-change-value
      571               no-error .
      572             if error-status :error
      573             or error-status :get-message(1) <> ""
      574             then do:
      575               undo move_block, retry move_block .
      576             end.
      577           end.
      578         end.
      579       end.
      580       else do:
      581         for each buf_temp-diasize-handle
      582         on error undo move_block, retry move_block
      583         :
      584           assign
      585             v-object-handle = buf_temp-diasize-handle.handle-value
      586           .
      587           if v-object-handle <> v-diasize-resize-button
      588           then do:
      589             assign
      590               v-object-handle :row = v-object-handle :row + p-change-value
      591               no-error .
      592             if error-status :error
      593             or error-status :get-message(1) <> ""
      594             then do:
      595               undo move_block, retry move_block .
      596             end.
      597           end.
      598         end.
      599         assign
      600           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      601           no-error .
      602         if error-status :error
      603         or error-status :get-message(1) <> ""
      604         then do:
      605           undo move_block, retry move_block .
      606         end.
      607         for each buf_temp-browse-handle
      608           where buf_temp-browse-handle.browse-type = 'height':u
      609         on error undo move_block, retry move_block
      610         :
      611           assign
      612             buf_temp-browse-handle.browse-handle :height
      613               = buf_temp-browse-handle.browse-handle :height + p-change-value
      614             no-error .
      615           if error-status :error
      616           or error-status :get-message(1) <> ""
      617           then do:
      618             undo move_block, retry move_block .
      619           end.
      620         end.
      621         assign
      622           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      623           no-error .
      624         if error-status :error
      625         or error-status :get-message(1) <> ""
      626         then do:
      627           undo move_block, retry move_block .
      628         end.
      629         if frame Dialog-Frame :scrollable = true
      630         then do:
      631           assign
      632             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      633             no-error .
      634           if error-status :error
      635           or error-status :get-message(1) <> ""
      636           then do:
      637             undo move_block, retry move_block .
      638           end.
      639         end.
      640       end.
      641       if p-move-resize = true
      642       then do:
      643         run diasize_position-resize-button in this-procedure .
      644       end.
      645       if v-diasize-wndstore = true
      646       then do:
      647         if connected("ub") = true
      648         then do:
      649           define variable v-cntxt-db-num        as integer   no-undo .
      650           define variable v-cntxt-userid        as character no-undo .
      651           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      652                                             , OUTPUT v-cntxt-userid
      653                                             ) .
      654           run gbl/wndsizew.p
      655             (input  v-cntxt-db-num
      656             ,input  v-cntxt-userid
      657             ,input  v-diasize-proc-name
      658             ,input  'height':u
      659             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      660             ) .
      661         end.
      662       end.
      663     end.
      664     assign
      665       v-diasize-change-size = false
      666     .
      667   end procedure.
      668   procedure diasize_set-height :
      669     define input  parameter p-new-height  as decimal   no-undo .
      670     define input  parameter p-move-resize as logical   no-undo .
      671     do
      672     on error undo, return error return-value
      673     :
      674       run diasize_change-height in this-procedure
      675         (input  (p-new-height - frame Dialog-Frame :height)
      676         ,input  p-move-resize
      677         ) .
      678     end.
      679   end procedure.
      680   procedure diasize_change-width :
      681     define input  parameter p-change-value as decimal   no-undo .
      682     define input  parameter p-move-resize  as logical   no-undo .
      683     define variable v-field-group-handle   as handle    no-undo .
      684     define variable v-object-handle        as handle    no-undo .
      685     define variable v-frame-width          as decimal   no-undo .
      686     define variable v-frame-virtual-width  as decimal   no-undo .
      687     define variable v-browse-width         as decimal   no-undo .
      688     define variable v-window-width         as decimal   no-undo .
      689     define variable v-window-virtual-width as decimal   no-undo .
      690     define variable v-change-sign          as integer   no-undo .
      691     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      692     define buffer buf_temp-browse-handle  for temp-browse-handle .
      693     if p-change-value > 0
      694     then do:
      695       if frame Dialog-Frame :width + p-change-value >
      696           session :width-chars
      697       then do:
      698         assign
      699           p-change-value = session :width-chars - frame Dialog-Frame :width
      700         .
      701         if p-change-value <= 0
      702         then do:
      703           run diasize_position-resize-button in this-procedure .
      704           return .
      705         end.
      706       end.
      707     end.
      708     if p-change-value < 0
      709     then do:
      710       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      711       then do:
      712         assign
      713           p-change-value = v-diasize-orig-frame-width
      714                          - frame Dialog-Frame :width
      715         .
      716         if p-change-value >= 0
      717         then do:
      718           run diasize_position-resize-button in this-procedure .
      719           return .
      720         end.
      721       end.
      722     end.
      723     if p-change-value >= 0
      724     then do:
      725       assign
      726         v-change-sign = 1
      727       .
      728     end.
      729     else do:
      730       assign
      731         v-change-sign = -1
      732       .
      733     end.
      734     assign
      735       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      736     .
      737     if p-change-value = 0
      738     then do:
      739       run diasize_position-resize-button in this-procedure .
      740       return .
      741     end.
      742     move_block:
      743     do
      744     on error undo move_block, leave move_block
      745     :
      746       if retry
      747       then do:
      748         do
      749         on error undo move_block, leave move_block
      750         :
      751           if p-change-value > 0
      752           then do:
      753             for each buf_temp-diasize-handle
      754             on error undo, next
      755             :
      756               assign
      757                 v-object-handle = buf_temp-diasize-handle.handle-value
      758               .
      759               if v-object-handle <> v-diasize-resize-button
      760               then do:
      761                 assign
      762                   v-object-handle :col = buf_temp-diasize-handle.save-position
      763                 .
      764               end.
      765             end.
      766             assign
      767               v-diasize-browse-handle :width = v-browse-width
      768             .
      769             for each buf_temp-browse-handle
      770               where buf_temp-browse-handle.browse-type = 'width':u
      771             on error undo, next
      772             :
      773               assign
      774                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      775               .
      776             end.
      777             assign
      778               frame Dialog-Frame :width = v-frame-width
      779             .
      780             if frame Dialog-Frame :scrollable = true
      781             then do:
      782               assign
      783                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      784               .
      785             end.
      786             run diasize_position-resize-button in this-procedure .
      787           end.
      788           else do:
      789             if frame Dialog-Frame :scrollable = true
      790             then do:
      791               assign
      792                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      793               .
      794             end.
      795             assign
      796               frame Dialog-Frame :width = v-frame-width
      797             .
      798             for each buf_temp-browse-handle
      799               where buf_temp-browse-handle.browse-type = 'width':u
      800             on error undo, next
      801             :
      802               assign
      803                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      804               .
      805             end.
      806             assign
      807               v-diasize-browse-handle :width = v-browse-width
      808             .
      809             for each buf_temp-diasize-handle
      810             on error undo, next
      811             :
      812               assign
      813                 v-object-handle = buf_temp-diasize-handle.handle-value
      814               .
      815               if v-object-handle <> v-diasize-resize-button
      816               then do:
      817                 assign
      818                   v-object-handle :col = buf_temp-diasize-handle.save-position
      819                 .
      820               end.
      821             end.
      822             run diasize_position-resize-button in this-procedure .
      823           end.
      824           assign
      825             v-diasize-change-size = false
      826           .
      827           leave move_block .
      828         end.
      829       end.
      830       assign
      831         v-diasize-need-full-display = true
      832       .
      833       if v-diasize-change-size = false
      834       then do:
      835         assign
      836           v-diasize-change-size = true
      837         .
      838       end.
      839       else do:
      840         return .
      841       end.
      842       assign
      843         v-frame-width = frame Dialog-Frame :width
      844         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      845         v-browse-width = v-diasize-browse-handle :width
      846       .
      847       for each buf_temp-browse-handle
      848         where buf_temp-browse-handle.browse-type = 'width':u
      849       :
      850         assign
      851           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      852         .
      853       end.
      854       for each buf_temp-diasize-handle
      855       :
      856         delete buf_temp-diasize-handle .
      857       end.
      858       assign
      859         v-field-group-handle = frame Dialog-Frame :first-child
      860       .
      861       do while valid-handle(v-field-group-handle)
      862       :
      863         assign
      864           v-object-handle = v-field-group-handle :first-child
      865         .
      866         do while valid-handle(v-object-handle)
      867         :
      868           if  v-object-handle <> v-diasize-browse-handle :handle
      869           and v-object-handle <> v-diasize-resize-button
      870           and can-query(v-object-handle, "row")
      871           and can-query(v-object-handle, "height")
      872           and ( v-object-handle :col + v-object-handle :width
      873                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      874               )
      875           then do:
      876             find first buf_temp-browse-handle
      877               where buf_temp-browse-handle.browse-type   = 'width':u
      878                 and buf_temp-browse-handle.browse-handle = v-object-handle
      879               no-error .
      880             if available buf_temp-browse-handle
      881             then do:
      882             end.
      883             else do:
      884               create buf_temp-diasize-handle .
      885               assign
      886                 buf_temp-diasize-handle.handle-value  = v-object-handle
      887                 buf_temp-diasize-handle.save-position = v-object-handle :col
      888               .
      889             end.
      890           end.
      891           assign
      892             v-object-handle = v-object-handle :next-sibling
      893           .
      894         end.
      895         assign
      896           v-field-group-handle = v-field-group-handle :next-sibling
      897         .
      898       end.
      899       do with frame Dialog-Frame
      900       :
      901         hide v-diasize-resize-button .
      902         v-diasize-resize-button :row = 1.
      903         v-diasize-resize-button :column = 1.
      904       end.
      905       if p-change-value > 0
      906       then do:
      907         if frame Dialog-Frame :scrollable = true
      908         then do:
      909           assign
      910             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      911             no-error .
      912           if error-status :error
      913           or error-status :get-message(1) <> ""
      914           then do:
      915             undo move_block, retry move_block.
      916           end.
      917         end.
      918         assign
      919           frame Dialog-Frame :width = v-frame-width + p-change-value
      920           no-error .
      921         if error-status :error
      922         or error-status :get-message(1) <> ""
      923         then do:
      924           undo move_block, retry move_block.
      925         end.
      926         assign
      927           v-diasize-browse-handle :width = v-browse-width + p-change-value
      928         no-error .
      929         if error-status :error
      930         or error-status :get-message(1) <> ""
      931         then do:
      932           undo move_block, retry move_block.
      933         end.
      934         for each buf_temp-browse-handle
      935           where buf_temp-browse-handle.browse-type = 'width':u
      936         on error undo move_block, retry move_block
      937         :
      938           assign
      939             buf_temp-browse-handle.browse-handle :width
      940               = buf_temp-browse-handle.browse-handle :width + p-change-value
      941             no-error .
      942           if error-status :error
      943           or error-status :get-message(1) <> ""
      944           then do:
      945             undo move_block, retry move_block .
      946           end.
      947         end.
      948         for each buf_temp-diasize-handle
      949         on error undo move_block, retry move_block
      950         :
      951           assign
      952             v-object-handle = buf_temp-diasize-handle.handle-value
      953           .
      954           if v-object-handle <> v-diasize-resize-button
      955           then do:
      956             assign
      957               v-object-handle :col = v-object-handle :col + p-change-value
      958               no-error .
      959             if error-status :error
      960             or error-status :get-message(1) <> ""
      961             then do:
      962               undo move_block, retry move_block .
      963             end.
      964           end.
      965         end.
      966       end.
      967       else do:
      968         for each buf_temp-diasize-handle
      969         on error undo move_block, retry move_block
      970         :
      971           assign
      972             v-object-handle = buf_temp-diasize-handle.handle-value
      973           .
      974           if v-object-handle <> v-diasize-resize-button
      975           then do:
      976             assign
      977               v-object-handle :col = v-object-handle :col + p-change-value
      978               no-error .
      979             if error-status :error
      980             or error-status :get-message(1) <> ""
      981             then do:
      982               undo move_block, retry move_block .
      983             end.
      984           end.
      985         end.
      986         for each buf_temp-browse-handle
      987           where buf_temp-browse-handle.browse-type = 'width':u
      988         on error undo move_block, retry move_block
      989         :
      990           assign
      991             buf_temp-browse-handle.browse-handle :width
      992               = buf_temp-browse-handle.browse-handle :width + p-change-value
      993             no-error .
      994           if error-status :error
      995           or error-status :get-message(1) <> ""
      996           then do:
      997             undo move_block, retry move_block .
      998           end.
      999         end.
     1000         assign
     1001           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1002           no-error .
     1003         if error-status :error
     1004         or error-status :get-message(1) <> ""
     1005         then do:
     1006           undo move_block, retry move_block.
     1007         end.
     1008         assign
     1009           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1010         no-error .
     1011         if error-status :error
     1012         or error-status :get-message(1) <> ""
     1013         then do:
     1014           undo move_block, retry move_block.
     1015         end.
     1016         if frame Dialog-Frame :scrollable = true
     1017         then do:
     1018           assign
     1019             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1020           no-error .
     1021           if error-status :error
     1022           or error-status :get-message(1) <> ""
     1023           then do:
     1024             undo move_block, retry move_block.
     1025           end.
     1026         end.
     1027       end.
     1028       if p-move-resize
     1029       then do:
     1030         run diasize_position-resize-button in this-procedure .
     1031       end.
     1032       if v-diasize-wndstore = true
     1033       then do:
     1034         if connected("ub") = true
     1035         then do:
     1036           define variable v-cntxt-db-num        as integer   no-undo .
     1037           define variable v-cntxt-userid        as character no-undo .
     1038           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1039                                             , OUTPUT v-cntxt-userid
     1040                                             ) .
     1041           run gbl/wndsizew.p
     1042             (input  v-cntxt-db-num
     1043             ,input  v-cntxt-userid
     1044             ,input  v-diasize-proc-name
     1045             ,input  'width':u
     1046             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1047             ) .
     1048         end.
     1049       end.
     1050     end.
     1051     assign
     1052       v-diasize-change-size = false
     1053     .
     1054   end procedure.
     1055   procedure diasize_set-width :
     1056     define input  parameter p-new-width  as decimal   no-undo .
     1057     define input  parameter p-move-resize as logical   no-undo .
     1058     do
     1059     on error undo, return error return-value
     1060     :
     1061       run diasize_change-width in this-procedure
     1062         (input  (p-new-width - frame Dialog-Frame :width)
     1063         ,input  p-move-resize
     1064         ) .
     1065     end.
     1066   end procedure.
     1067   procedure diasize_position-resize-button :
     1068     do with frame Dialog-Frame
     1069     :
     1070       hide v-diasize-resize-button .
     1071       assign
     1072         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1073                     - 1
     1074                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1075         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1076                     - 1
     1077                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1078       .
     1079       view v-diasize-resize-button .
     1080     end.
     1081   end procedure.
     1082   on alt-right anywhere
     1083   do:
     1084     run diasize_change-width in this-procedure
     1085       (input 1
     1086       ,input true
     1087       ) .
     1088     return no-apply .
     1089   end.
     1090   on alt-left anywhere
     1091   do:
     1092     run diasize_change-width in this-procedure
     1093       (input -1
     1094       ,input true
     1095       ) .
     1096     return no-apply .
     1097   end.
     1098   on alt-down anywhere
     1099   do:
     1100     run diasize_change-height in this-procedure
     1101       (input 1
     1102       ,input true
     1103       ) .
     1104     return no-apply .
     1105   end.
     1106   on alt-up anywhere
     1107   do:
     1108     run diasize_change-height in this-procedure
     1109       (input -1
     1110       ,input true
     1111       ) .
     1112     return no-apply .
     1113   end.
     1114   on alt-enter of frame Dialog-Frame
     1115   do:
     1116     run diasize_maximize in this-procedure
     1117       (input  ?
     1118       ).
     1119     return no-apply .
     1120   end.
     1121   procedure diasize_end-move :
     1122     do
     1123     on error undo, return error return-value
     1124     :
     1125       define variable v-row-delta as decimal   no-undo .
     1126       define variable v-col-delta as decimal   no-undo .
     1127       define variable v-new-row as decimal   no-undo .
     1128       define variable v-new-col as decimal   no-undo .
     1129       assign
     1130         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1131         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1132       .
     1133       assign
     1134         v-row-delta = v-new-row - frame Dialog-Frame :height
     1135         v-col-delta = v-new-col - frame Dialog-Frame :width
     1136       .
     1137       run diasize_change-height in this-procedure
     1138         (input v-row-delta
     1139         ,input true
     1140         ) .
     1141       run diasize_change-width in this-procedure
     1142         (input v-col-delta
     1143         ,input true
     1144         ) .
     1145     end.
     1146   end procedure.
     1147   procedure diasize_maximize :
     1148     define input  parameter p-action as logical   no-undo .
     1149     do
     1150     on error undo, return error return-value
     1151     :
     1152       if p-action = ?
     1153       then do:
     1154         if v-diasize-need-maximize = true
     1155         then do:
     1156           assign
     1157             p-action = true
     1158           .
     1159         end.
     1160         else do:
     1161           assign
     1162             p-action = false
     1163           .
     1164         end.
     1165       end.
     1166       if p-action = true
     1167       then do:
     1168         run diasize_change-height in this-procedure
     1169           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1170               - frame Dialog-Frame :height-chars
     1171           ,input true
     1172           ) .
     1173         run diasize_change-width in this-procedure
     1174           (input session :width-chars
     1175               - frame Dialog-Frame :width-chars
     1176           ,input true
     1177           ) .
     1178         assign
     1179           v-diasize-need-maximize = false
     1180         .
     1181       end.
     1182       else do:
     1183         run diasize_change-width in this-procedure
     1184           (input v-diasize-orig-frame-width
     1185               - frame Dialog-Frame :width-chars
     1186           ,input true
     1187           ) .
     1188         run diasize_change-height in this-procedure
     1189           (input v-diasize-orig-frame-height
     1190               - frame Dialog-Frame :height-chars
     1191           ,input true
     1192           ) .
     1193         assign
     1194           v-diasize-need-maximize = true
     1195         .
     1196       end.
     1197     end.
     1198   end procedure.
     1199   procedure diasize_restore-orig-size :
     1200     do
     1201     on error undo, return error return-value
     1202     :
     1203       assign
     1204         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1205         v-diasize-current-frame-height = frame Dialog-Frame :height
     1206       .
     1207       run diasize_set-height in this-procedure
     1208         (input  v-diasize-orig-frame-height
     1209         ,input  true
     1210         ) .
     1211       run diasize_set-width in this-procedure
     1212         (input  v-diasize-orig-frame-width
     1213         ,input  true
     1214         ) .
     1215     end.
     1216   end procedure.
     1217   procedure diasize_restore-current-size :
     1218     do
     1219     on error undo, return error return-value
     1220     :
     1221       run diasize_set-height in this-procedure
     1222         (input  v-diasize-current-frame-height
     1223         ,input  true
     1224         ) .
     1225       run diasize_set-width in this-procedure
     1226         (input  v-diasize-current-frame-width
     1227         ,input  true
     1228         ) .
     1229     end.
     1230   end procedure.
     1231   procedure diasize_set-browse-handle :
     1232     define input  parameter p-browse-handle as handle   no-undo .
     1233     define buffer buf_temp-browse-handle for temp-browse-handle .
     1234     do
     1235     on error undo, return error return-value
     1236     :
     1237       assign
     1238         v-diasize-browse-handle = p-browse-handle
     1239       .
     1240       for each buf_temp-browse-handle
     1241       on error undo, return error return-value
     1242       :
     1243         delete buf_temp-browse-handle .
     1244       end.
     1245     end.
     1246   end procedure.
     1247   procedure diasize_add_browse :
     1248     define input  parameter p-browse-type   as character no-undo .
     1249     define input  parameter p-browse-handle as handle    no-undo .
     1250     define buffer buf_temp-browse-handle for temp-browse-handle .
     1251     do
     1252     on error undo, return error return-value
     1253     :
     1254       assign
     1255         v-diasize-browse-number = v-diasize-browse-number + 1
     1256       .
     1257       create buf_temp-browse-handle .
     1258       assign
     1259         buf_temp-browse-handle.browse-type   = p-browse-type
     1260         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1261         buf_temp-browse-handle.browse-handle = p-browse-handle
     1262       .
     1263     end.
     1264   end procedure.
     1265   procedure diasize_init :
     1266     define variable v-default-value    as logical   no-undo .
     1267     define variable v-restore-saved    as logical   no-undo .
     1268     define variable v-resize-value-str as character no-undo .
     1269     do
     1270     on error undo, return error return-value
     1271     :
     1272       do with frame Dialog-Frame
     1273       :
     1274         assign
     1275           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1276           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1277           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1278         .
     1279         create button v-diasize-resize-button
     1280         assign
     1281           parent        = frame Dialog-Frame :first-child
     1282           label         = "s"
     1283           height-pixels = 16
     1284           width-pixels  = 16
     1285           visible       = true
     1286           sensitive     = true
     1287           movable       = true
     1288           triggers:
     1289             on end-move persistent run diasize_end-move in this-procedure .
     1290           end triggers.
     1291         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1292         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1293         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1294         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1295         assign
     1296           v-diasize-wndmax = false
     1297         .
     1298         if connected("ub") = true
     1299         then do:
     1300           define variable v-cntxt-db-num        as integer   no-undo .
     1301           define variable v-cntxt-userid        as character no-undo .
     1302           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1303                                             , OUTPUT v-cntxt-userid
     1304                                             ) .
     1305           run gbl/wndpar_r.p
     1306             (input  v-cntxt-db-num
     1307             ,input  v-cntxt-userid
     1308             ,input  'wndmax':U
     1309             ,output v-diasize-wndmax
     1310             ,output v-default-value
     1311             ) .
     1312         end.
     1313         assign
     1314           v-diasize-wndstore = false
     1315         .
     1316         if connected("ub") = true
     1317         then do:
     1318           run gbl/wndpar_r.p
     1319             (input  v-cntxt-db-num
     1320             ,input  v-cntxt-userid
     1321             ,input  'wndstore':U
     1322             ,output v-diasize-wndstore
     1323             ,output v-default-value
     1324             ) .
     1325         end.
     1326         assign
     1327           v-diasize-proc-name = entry(1, program-name(2), '.')
     1328         .
     1329         if v-diasize-wndstore = true
     1330         then do:
     1331           assign
     1332             v-restore-saved = false
     1333           .
     1334           if connected("ub") = true
     1335           then do:
     1336             run gbl/wndsizer.p
     1337               (input  v-cntxt-db-num
     1338               ,input  v-cntxt-userid
     1339               ,input  v-diasize-proc-name
     1340               ,input  'height':u
     1341               ,output v-resize-value-str
     1342               ) .
     1343             if v-resize-value-str <> '':U
     1344             then do:
     1345               run diasize_change-height in this-procedure
     1346                 (input  integer(v-resize-value-str)
     1347                 ,input  true
     1348                 ) .
     1349               assign
     1350                 v-restore-saved = true
     1351               .
     1352             end.
     1353           end.
     1354           if connected("ub") = true
     1355           then do:
     1356             run gbl/wndsizer.p
     1357               (input  v-cntxt-db-num
     1358               ,input  v-cntxt-userid
     1359               ,input  v-diasize-proc-name
     1360               ,input  'width':u
     1361               ,output v-resize-value-str
     1362               ) .
     1363             if v-resize-value-str <> '':U
     1364             then do:
     1365               run diasize_change-width in this-procedure
     1366                 (input  integer(v-resize-value-str)
     1367                 ,input  true
     1368                 ) .
     1369               assign
     1370                 v-restore-saved = true
     1371               .
     1372             end.
     1373           end.
     1374           if v-restore-saved <> true
     1375           then do:
     1376             if v-diasize-wndmax = true
     1377             then do:
     1378               run diasize_maximize in this-procedure
     1379                 (input  true
     1380                 ) .
     1381             end.
     1382           end.
     1383         end.
     1384         else do:
     1385           if v-diasize-wndmax = true
     1386           then do:
     1387             run diasize_maximize in this-procedure
     1388               (input  true
     1389               ) .
     1390           end.
     1391         end.
     1392       end.
     1393     end.
     1394   end procedure.
     1395   procedure diasize_need-full-display :
     1396     define output parameter p-need-full-display as logical   no-undo .
     1397     do
     1398     on error undo, return error return-value
     1399     :
     1400       assign
     1401         p-need-full-display = v-diasize-need-full-display
     1402       .
     1403       assign
     1404         v-diasize-need-full-display = false
     1405       .
     1406     end.
     1407   end procedure.
     1408   procedure get-context :
     1409      define output parameter p-db-num as integer          no-undo.
     1410      define output parameter p-user-id as character        no-undo.
     1411      define variable v-login               as character    no-undo.
     1412      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1413      define buffer buf_user-login  for ub.user-login .
     1414      do
     1415      on error undo, return error
     1416      :
     1417            FIND FIRST buf_sys-ctrl no-lock.
     1418            ASSIGN
     1419               v-login = USERID("ub")
     1420               p-db-num = buf_sys-ctrl.db-num
     1421            .
     1422            FIND FIRST buf_user-login
     1423                 WHERE buf_user-login.db-num = p-db-num
     1424                   AND buf_user-login.user-login = v-login
     1425                 no-lock
     1426                 no-error
     1427                 .
     1428            IF AVAILABLE buf_user-login
     1429            THEN DO:
     1430               assign
     1431                  p-user-id = buf_user-login.user-id
     1432               .
     1433            END.
     1434      end.
     1435   end procedure.
     1436       run diasize_init in this-procedure .
     1437   MAIN-BLOCK:
     1438   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1439      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1440     RUN enable_UI.
     1441     WAIT-FOR GO OF FRAME Dialog-Frame.
     1442   END.
     1443   RUN disable_UI.
     1444   PROCEDURE disable_UI :
     1445     HIDE FRAME Dialog-Frame.
     1446   END PROCEDURE.
     1447   PROCEDURE enable_UI :
     1448     ENABLE B-exit B-Help BROWSE-2
     1449         WITH FRAME Dialog-Frame.
     1450     VIEW FRAME Dialog-Frame.
     1451     OPEN QUERY BROWSE-2 FOR EACH ub.cli-gds       WHERE cli-gds.artic = xartic  AND cli-gds.prod-code = xprod-code  AND cli-gds.prod-type = xprod-type  and cli-gds.price-cli > 0  AND NOT (cli-gds.cli-code =  xcli-code And cli-gds.cli-type =  xcli-type)   NO-LOCK,       EACH ub.clients WHERE clients.obj-code = cli-gds.cli-code   AND clients.obj-type = cli-gds.cli-type       AND (clients.sup-cons = TRUE  OR clients.sup-gds = TRUE  OR clients.sup-serv = TRUE) NO-LOCK     BY ub.cli-gds.price-cli.
     1452   END PROCEDURE.
