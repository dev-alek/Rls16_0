     1025       (output v-cntxt-db-num
     1026       ,output v-cntxt-userid
     1027       ,output v-cntxt-level
     1028       ,output v-cntxt-host-code-obj
     1029       ,output v-cntxt-obj-type
     1030       ,output v-cntxt-obj-code
     1031       ,output v-cntxt-db-num-obj
     1032       ,output v-cntxt-is-admin
     1033       ) .
     1034   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1035   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1036   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1037   define variable par-type          as character no-undo.
     1038   define variable v-value-character as character no-undo .
     1039   define variable v-value-date      as date      no-undo .
     1040   define variable v-value-decimal   as decimal   no-undo .
     1041   define variable v-value-integer   as integer   no-undo .
     1042   define variable v-value-logical   as logical   no-undo .
     1043   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   empty temp-table thbjattr_thbj-attr.
     1045   run adm/shattri.p (
     1046      input "get":U
     1047     ,input v-cntxt-obj-type
     1048     ,input v-cntxt-obj-code
     1049     ,input 'report-firm':U
     1050     ,input  ""
     1051     ,output v-value-character
     1052     ,output v-value-date
     1053     ,output v-value-decimal
     1054     ,output v-value-integer
     1055     ,output v-value-logical
     1056     ,output par-type
     1057     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1058     ) no-error .
     1059   for each thbjattr_thbj-attr :
     1060       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1061   end.
     1062   IF tmp-var1 = "" then p-XL-delim = ";".
     1063   else p-XL-delim = tmp-var1.
     1064   define variable found as logical init yes no-undo.
     1065   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1066   PROCEDURE no-benq.
     1067   DEFINE OUTPUT PARAMETER found as logical init no.
     1068   define buffer buf_chk-doc for ub.chk-doc.
     1069   FOR EACH obj-list WHERE
     1070           obj-list.obj-type = 'маг':U NO-LOCK :
     1071     CASE X-Radio-Task > 1 :
     1072       WHEN YES THEN DO:
     1073         FOR EACH buf_chk-doc NO-LOCK WHERE
     1074                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1075                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1076                 (
     1077                   buf_chk-doc.shift-date >= X-date-start AND
     1078                   buf_chk-doc.shift-date <= X-date-end)
     1079                   AND
     1080                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1081           IF X-Radio-Task = 3 AND
     1082           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1083             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1084           IF X-Radio-Task = 4 AND
     1085           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1086           found = yes.
     1087           return.
     1088         END.
     1089       END.
     1090       WHEN NO THEN DO:
     1091         FOR EACH buf_chk-doc NO-LOCK WHERE
     1092               buf_chk-doc.obj-type = obj-list.obj-type AND
     1093               buf_chk-doc.obj-code = obj-list.obj-code AND
     1094               buf_chk-doc.chk-date >= X-date-start AND
     1095               buf_chk-doc.chk-date <= X-date-end   AND
     1096               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1097           found = yes.
     1098           return.
     1099         END.
     1100        END.
     1101      END CASE.
     1102    END.
     1103   END PROCEDURE.
     1104   PROCEDURE no-benqi.
     1105   DEFINE OUTPUT PARAMETER found as logical init no.
     1106   define buffer buf_chk-doc for ub.chk-doc.
     1107   define buffer buf_inkas for ub.inkas.
     1108   FOR EACH obj-list WHERE
     1109         obj-list.obj-type = 'маг':U NO-LOCK :
     1110     CASE X-Radio-Task > 1 :
     1111       WHEN YES THEN DO:
     1112         FOR EACH buf_chk-doc No-LOCK WHERE
     1113                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1114                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1115                 (
     1116                   buf_chk-doc.shift-date >= X-date-start AND
     1117                   buf_chk-doc.shift-date <= X-date-end)
     1118                   AND
     1119                   buf_Chk-doc.out-code = ? AND
     1120                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1121           IF X-Radio-Task = 3 AND
     1122           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1123             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1124           IF X-Radio-Task = 4 AND
     1125           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1126           found = yes.
     1127           return.
     1128         END.
     1129         FOR EACH buf_inkas No-LOCK WHERE
     1130                   buf_inkas.obj-type = obj-list.obj-type AND
     1131                   buf_inkas.obj-code = obj-list.obj-code AND
     1132                   (
     1133                   buf_inkas.shift-date >= X-date-start AND
     1134                   buf_inkas.shift-date <= X-date-end):
     1135           if buf_inkas.status_ = 'факт':U
     1136           or buf_inkas.status_ = 'запрос':U then next.
     1137           IF X-Radio-Task = 3 AND
     1138           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1139             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1140           IF X-Radio-Task = 4 AND
     1141           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1142           found = yes.
     1143           return.
     1144         END.
     1145       END.
     1146       WHEN NO THEN DO:
     1147         FOR EACH buf_chk-doc NO-LOCK WHERE
     1148                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1149                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1150                 buf_chk-doc.chk-date >= X-date-start AND
     1151                 buf_chk-doc.chk-date <= X-date-end   AND
     1152                 buf_Chk-doc.out-code = ? AND
     1153                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1154           found = yes.
     1155           return.
     1156         END.
     1157         FOR EACH buf_inkas NO-LOCK WHERE
     1158                 buf_inkas.obj-type = obj-list.obj-type AND
     1159                 buf_inkas.obj-code = obj-list.obj-code AND
     1160                 buf_inkas.doc-date >= X-date-start AND
     1161                 buf_inkas.doc-date <= X-date-end :
     1162           if buf_inkas.status_ = 'факт':U
     1163           or buf_inkas.status_ = 'запрос':U then next.
     1164           found = yes.
     1165           return.
     1166         END.
     1167       END.
     1168     END CASE.
     1169   END.
     1170   END PROCEDURE.
     1171   PROCEDURE no-benq-i.
     1172   DEFINE OUTPUT PARAMETER found as logical init no.
     1173   define buffer buf_inkas for ub.inkas.
     1174   CASE X-Radio-Task > 1:
     1175     WHEN YES then do:
     1176       FOR EACH obj-list WHERE
     1177               obj-list.obj-type = 'маг':U NO-LOCK :
     1178         FOR EACH buf_inkas NO-LOCK WHERE
     1179                 buf_inkas.obj-type = obj-list.obj-type AND
     1180                 buf_inkas.obj-code = obj-list.obj-code AND
     1181                 buf_inkas.status_ = 'факт':U AND
     1182                 (
     1183                 buf_inkas.shift-date >= X-date-start AND
     1184                 buf_inkas.shift-date <= X-date-end):
     1185           IF X-Radio-Task = 3 AND
     1186           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1187             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1188           IF X-Radio-Task = 4 AND
     1189           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1190           found = yes.
     1191           return.
     1192         END.
     1193     END.
     1194     END.
     1195     WHEN NO THEN DO:
     1196       FOR EACH obj-list WHERE
     1197               obj-list.obj-type = 'маг':U NO-LOCK :
     1198         FOR EACH buf_inkas NO-LOCK WHERE
     1199                 buf_inkas.obj-type = obj-list.obj-type AND
     1200                 buf_inkas.obj-code = obj-list.obj-code AND
     1201                 buf_inkas.status_ = 'факт':U AND
     1202                 buf_inkas.doc-date >= X-date-start AND
     1203                 buf_inkas.doc-date <= X-date-end :
