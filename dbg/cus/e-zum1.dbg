     1251     END.
     1252   END CASE.
     1253   END PROCEDURE.
     1254   run no-benq(output found).
     1255   if NOT found then do:
     1256     run waitfram-hide in this-procedure .
     1257     message "Не было никакой выручки  в течение заданного Вами периода времени." view-as alert-box.
     1258     return.
     1259   end.
     1260   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1261   define variable ReportFileName as character no-undo initial "report".
     1262   define variable was_OK_opened  as logical   no-undo.
     1263   system-dialog get-file          ReportFileName
     1264                 title             "Укажите путь"
     1265                 filters           "Текстовый файл (*.txt)" "*.txt"
     1266                 ask-overwrite
     1267                 create-test-file
     1268                 save-as
     1269                 use-filename
     1270                 default-extension "txt"
     1271                 update            was_OK_opened.
     1272   if was_OK_opened <> yes then do: return "Cancel". end.
     1273   assign ReportFileName = trim( string( ReportFileName ) ).
     1274   output stream PrnLibStream to value ( ReportFileName ) page-size 0  .
     1275   run waitfram-show in this-procedure ("Ждите...").
     1276   PUT stream PrnLibStream UNFORMATTED
     1277   space(20)
     1278   "ЭКСПОРТ чеков" skip
     1279   space(23) str1 skip(0)
     1280   str4 skip(2).
     1281   PUT Stream PrnLibStream UNFORMATTED
     1282   "ТИП_ЧЕКА"  p-XL-delim
     1283   "НОМЕР_ЧЕКА" p-XL-delim
     1284   "СЕКЦИЯ" p-XL-delim
     1285   "КАССА" p-XL-delim
     1286   "N_Z-ОТЧЕТА" p-XL-delim
     1287   "N_ЧЕКА_НА_КАССЕ" p-XL-delim
     1288   "ДАТА" p-XL-delim
     1289   "ВРЕМЯ" p-XL-delim
     1290   "СУММА_ОПЛАТ" p-XL-delim
     1291   "ТОВАРНАЯ_СУММА" p-XL-delim
     1292   "ОБЩАЯ_СКИДКА" p-XL-delim
     1293   "СИКДКА_НА_ИТОГ" p-XL-delim
     1294   "КАССИР" p-XL-delim
     1295   "ПРОДАВЕЦ" p-XL-delim
     1296   "ДИСКОНТНАЯ_КАРТА" p-XL-delim
     1297   "ОТЧЕТ_О_ПРОДАЖЕ" p-XL-delim
     1298   SKIP.
     1299   FOR EACH obj-list No-LOCK:
     1300   _chk-gds:
     1301     FOR EACH buf_chk-doc No-LOCK WHERE
     1302               buf_chk-doc.obj-type = obj-list.obj-type AND
     1303               buf_chk-doc.obj-code = obj-list.obj-code AND
     1304               buf_chk-doc.out-code <> ? AND
     1305               buf_chk-doc.chk-date >= X-date-start AND
     1306               buf_chk-doc.chk-date <= X-date-end:
     1307       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1308       ACCUMULATE buf_chk-doc.doc-code (COUNT).
     1309       PUT Stream PrnLibStream UNFORMATTED
     1310       buf_chk-doc.office   p-XL-delim
     1311       buf_chk-doc.doc-code p-XL-delim
     1312       buf_chk-doc.obj-code p-XL-delim
     1313       buf_chk-doc.pay-desk p-XL-delim
     1314       (if num-entries(buf_chk-doc.doc-code, chr(47)) = 5
     1315       then entry(2, buf_chk-doc.doc-code, chr(47))
     1316       else "?") p-XL-delim
     1317       buf_chk-doc.chk-num p-XL-delim
     1318       buf_chk-doc.chk-date format "99/99/9999" p-XL-delim
     1319       string(buf_chk-doc.chk-time, "HH:MM") p-XL-delim
     1320       buf_chk-doc.netto p-XL-delim
     1321       buf_chk-doc.tot-doc p-XL-delim
     1322       buf_chk-doc.discnt  p-XL-delim
     1323       buf_chk-doc.sub-discnt p-XL-delim
     1324       buf_chk-doc.cashier p-XL-delim
     1325       buf_chk-doc.sales-man p-XL-delim
     1326       buf_chk-doc.d-card p-XL-delim
     1327       buf_chk-doc.out-code p-XL-delim
     1328       SKIP.
     1329       IF (ACCUM COUNT buf_chk-doc.doc-code) MODULO 50 = 0 then
     1330       run waitfram-show in this-procedure ("Ждите..." + "Объект " + string(obj-list.obj-code) + " Обработано " +
     1331                     string(ACCUM COUNT buf_chk-doc.doc-code) + " чеков").
     1332     END.
     1333   END.
