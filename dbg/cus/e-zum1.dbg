     1210   END PROCEDURE.
     1211   PROCEDURE no-benq-i-office.
     1212   DEFINE OUTPUT PARAMETER found as logical init no.
     1213   define buffer buf_sale-doc for ub.sale-doc.
     1214   CASE X-Radio-Task > 1:
     1215     WHEN YES then do:
     1216       FOR EACH obj-list WHERE
     1217               obj-list.obj-type = 'маг':U NO-LOCK :
     1218         FOR EACH buf_sale-doc NO-LOCK WHERE
     1219                  buf_Sale-doc.obj-type = obj-list.obj-type
     1220              AND buf_sale-doc.obj-code = obj-list.obj-code
     1221              AND buf_sale-doc.status_ = 'факт':U
     1222              AND buf_sale-doc.chr-office = 'у':U
     1223              AND (
     1224                 buf_sale-doc.shift-date >= X-date-start
     1225                 AND
     1226                 buf_sale-doc.shift-date <= X-date-end):
     1227           IF X-Radio-Task = 3 AND
     1228           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1229             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1230           IF X-Radio-Task = 4 AND
     1231           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1232           found = yes.
     1233           return.
     1234         END.
     1235       END.
     1236     END.
     1237     WHEN NO THEN DO:
     1238       FOR EACH obj-list WHERE
     1239               obj-list.obj-type = 'маг':U NO-LOCK :
     1240         FOR EACH buf_sale-doc NO-LOCK WHERE
     1241                 buf_sale-doc.obj-type = obj-list.obj-type
     1242            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1243            AND  buf_sale-doc.status_ = 'факт':U
     1244            AND  buf_sale-doc.chr-office = 'у':U
     1245            AND  buf_sale-doc.doc-date >= X-date-start
     1246            AND  buf_sale-doc.doc-date <= X-date-end :
     1247           found = yes.
     1248           return.
     1249         END.
