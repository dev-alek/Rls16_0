       49   define input  parameter list-mode as character no-undo .
       50   define variable vss-revision    as character no-undo init "$Revision$":U .
       51   define variable vss-author      as character no-undo init "$Author$":U .
       52   define variable vss-date        as character no-undo init "$Date$":U .
       53   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       54   define variable vss-archive     as character no-undo init "$Archive$":U .
       55   define variable vss-description as character no-undo init "Планирование СЗФП".
       56   procedure vss-get-info :
       57     define output parameter p-vss-revision    like vss-revision    no-undo .
       58     define output parameter p-vss-author      like vss-author      no-undo .
       59     define output parameter p-vss-date        like vss-date        no-undo .
       60     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       61     define output parameter p-vss-archive     like vss-archive     no-undo .
       62     define output parameter p-vss-description like vss-description no-undo .
       63     assign
       64       p-vss-revision    = vss-revision
       65       p-vss-author      = vss-author
       66       p-vss-date        = vss-date
       67       p-vss-workfile    = vss-workfile
       68       p-vss-archive     = vss-archive
       69       p-vss-description = vss-description
       70     .
       71   end procedure.
       72   procedure vss-get-parameters :
       73     define output parameter p-vss-parameters as character no-undo .
       74   end procedure.
       75   define new global shared variable g#vssrevis-logger as handle    no-undo .
       76   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       77   define variable v-vssrevis-logger                   as handle    no-undo .
       78   procedure vss-logevent :
       79     define input  parameter p-extra-paramters as character no-undo .
       80     define variable v-vssrevis-parameters as character no-undo .
       81     do
       82     on error undo, return error return-value
       83     :
       84       if  valid-handle(v-vssrevis-logger)
       85       and v-vssrevis-logger :get-signature("logevent") <> ""
       86       then do:
       87         run vss-get-parameters in this-procedure
       88           (output v-vssrevis-parameters
       89           ).
       90         run logevent in v-vssrevis-logger
       91           (input vss-workfile
       92           ,input vss-revision
       93           ,input v-vssrevis-parameters
       94           ,input p-extra-paramters
       95           ).
       96       end.
       97     end.
       98   end procedure.
       99   assign
      100     v-vssrevis-logger = g#vssrevis-logger
      101   .
      102   if  valid-handle(v-vssrevis-logger)
      103   and v-vssrevis-logger :get-signature("logevent") <> ""
      104   then do:
      105     assign
      106       v-vssrevis-logevent = true
      107     .
      108     run vss-logevent in this-procedure (input vss-description) .
      109   end.
      110   define new global shared variable g#language as character no-undo .
      111   if g#language <> '' and g#language <> 'rus':U then do:
      112     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      113   end.
      114   define new global shared variable g#library  as handle no-undo .
      115   define new global shared variable g#library2 as handle no-undo .
      116   define   shared variable g#auto as logical no-undo.
