     2310   ON VALUE-CHANGED OF T-obj IN FRAME FRAME-B
     2311   DO:
     2312     assign frame frame-B t-obj .
     2313   if t-obj then do:
     2314     OPEN QUERY BROWSE-14 FOR EACH my-obj  ,     EACH buf_gds-obj         WHERE x-artic = buf_gds-obj.artic     and          x-prod-type  = buf_gds-obj.prod-type and          x-prod-code  = buf_gds-obj.prod-code and          buf_gds-obj.obj-code = my-obj.obj-code and          buf_gds-obj.obj-type = my-obj.obj-type  OUTER-JOIN NO-LOCK.
     2315       BROWSE-14:title = "Все объекты" .
     2316     end.
     2317     else do:
     2318     BROWSE-14:title = "Остатки товара по объектам" .
     2319     OPEN QUERY BROWSE-14 FOR EACH my-obj NO-LOCK,              EACH buf_gds-obj where              my-obj.obj-code = buf_gds-obj.obj-code and                       my-obj.obj-type = buf_gds-obj.obj-type and                   x-artic      = buf_gds-obj.artic     and             x-prod-type  = buf_gds-obj.prod-type and             x-prod-code  = buf_gds-obj.prod-code       NO-LOCK.
     2320     end.
     2321   END.
     2322   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2323   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2324     CURRENT-WINDOW :KEEP-FRAME-Z-ORDER  = true  .
     2325   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2326   on help of frame Dialog-Frame
     2327   do:
     2328     run gbl/app_help.p
     2329       (input this-procedure :file-name
     2330       ,input ''
     2331       ,input ?
     2332       ) no-error.
     2333     if error-status :error then do:
     2334       message
     2335         "Ошибка при вызове помощи"
     2336         error-status :get-message(1)
     2337         view-as alert-box .
     2338     end.
     2339   end.
     2340   run minbtn-set in this-procedure .
     2341   on choose of b-help in frame Dialog-Frame
     2342   do:
     2343     apply "help":u to frame Dialog-Frame .
     2344   end.
     2345   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2346   procedure minbtn-set :
     2347       do
     2348           on error undo, return error return-value
     2349           :
     2350           define variable ii              as integer       no-undo .
     2351           define variable fh              as widget-handle no-undo .
     2352           define variable hh              as widget-handle no-undo .
     2353           define variable v-h             as handle        extent 4 no-undo .
     2354           define variable v-name-button   as character     no-undo .
     2355           define variable v-help-old-x    as decimal       no-undo .
     2356           define variable v-help-old-y    as decimal       no-undo .
     2357           define variable v-help-old-size as decimal       no-undo .
     2358           define variable v-frame-width   as decimal       no-undo .
     2359           define variable jj              as integer       no-undo .
     2360           do
     2361               on error undo, return error
     2362               :
     2363               assign
     2364                   v-frame-width = frame Dialog-Frame:width - 0.3
     2365                   fh            = frame Dialog-Frame:first-child
     2366                   hh            = fh:first-child
     2367                   ii            = 1
     2368                   .
     2369               do while valid-handle(hh):
     2370                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2371                   do:
     2372                       case lc(hh:name) :
     2373                           when "b-help" then
     2374                               do:
     2375                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2376                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2377                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2378                                   hh:TOOLTIP = "Помощь" .
     2379                                   v-help-old-x = hh:column .
     2380                                   v-help-old-y = hh:row    .
     2381                                   v-help-old-size = hh:width .
     2382                                   hh:width-chars = 2.5 .
     2383                               end.
     2384                           when "b-print" then
     2385                               do:
     2386                                   hh:load-image("cmp/b-print.bmp":u) .
     2387                                   hh:TOOLTIP = "Печать" .
     2388                                   v-h[ii] = hh:handle .
     2389                                   ii = ii + 1 .
     2390                                   hh:width-chars = 3 .
     2391                               end.
     2392                           when "b-history" or
     2393                           when "b-hist" then
     2394                               do:
     2395                                   hh:load-image("cmp/b-hist.bmp":u) .
     2396                                   hh:TOOLTIP = "История" .
     2397                                   v-h[ii] = hh:handle .
     2398                                   ii = ii + 1 .
     2399                                   hh:width-chars = 3 .
     2400                               end.
     2401                           when "b-sch" then
     2402                               do:
     2403                                   hh:load-image("cmp/b-sch.bmp":u) .
     2404                                   hh:TOOLTIP = "Установка Фильтра" .
     2405                                   v-h[ii] = hh:handle .
     2406                                   ii = ii + 1 .
     2407                                   hh:width-chars = 3 .
     2408                               end.
     2409                           when "b-hist-user" then
     2410                               do:
     2411                                   hh:load-image("cmp/b-hist.bmp":u) .
     2412                                   hh:TOOLTIP = "История пользователя" .
     2413                                   ii = ii + 1 .
     2414                               end.
     2415                       end case.
     2416                   end.
     2417                   hh = hh:next-sibling.
     2418               end.
     2419               b-help:column = v-frame-width - b-help:width-chars.
     2420               jj = 0.
     2421               repeat ii = 4 to 1 by -1 :
     2422                   if valid-handle (v-h[ii] ) then
     2423                   do:
     2424                       jj  = jj + 1 .
     2425                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2426                       v-h[ii]:row    = v-help-old-y .
     2427                   end.
     2428               end.
     2429           end.
     2430       end.
     2431   end procedure.
     2432   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2433   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2434   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2435   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2436   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2437   define variable v-diasize-current-frame-height as decimal   no-undo .
     2438   define variable v-diasize-change-size          as logical   no-undo .
     2439   define variable v-diasize-resize-button        as handle    no-undo .
     2440   define variable v-diasize-wndmax               as logical   no-undo .
     2441   define variable v-diasize-wndstore             as logical   no-undo .
     2442   define variable v-diasize-proc-name            as character no-undo .
     2443   define variable v-diasize-browse-handle        as handle    no-undo .
     2444   define variable v-diasize-browse-number        as integer   no-undo .
     2445   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2446   define temp-table temp-diasize-handle no-undo
     2447     field handle-value  as handle
     2448     field save-position as decimal
     2449     index xpk is primary unique handle-value
     2450     .
     2451   define temp-table temp-browse-handle no-undo
     2452     field browse-type   as character
     2453     field browse-number as integer
     2454     field browse-handle as handle
     2455     field original-size as decimal
     2456     index xpk is primary unique browse-type browse-number
     2457     index xie browse-type browse-handle
     2458   .
     2459   procedure diasize_change-height :
     2460     define input  parameter p-change-value  as decimal   no-undo .
     2461     define input  parameter p-move-resize   as logical   no-undo .
     2462     define variable v-field-group-handle    as handle    no-undo .
     2463     define variable v-object-handle         as handle    no-undo .
     2464     define variable v-frame-height          as decimal   no-undo .
     2465     define variable v-frame-virtual-height  as decimal   no-undo .
     2466     define variable v-browse-height         as decimal   no-undo .
     2467     define variable v-window-height         as decimal   no-undo .
     2468     define variable v-window-virtual-height as decimal   no-undo .
     2469     define variable v-change-sign           as integer   no-undo .
     2470     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2471     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2472     if p-change-value > 0
     2473     then do:
     2474       if frame Dialog-Frame :height + p-change-value
     2475           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2476       then do:
     2477         assign
     2478           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2479                           - (frame Dialog-Frame :height-chars)
     2480         .
     2481         if p-change-value <= 0
     2482         then do:
     2483           run diasize_position-resize-button in this-procedure .
     2484           return .
     2485         end.
     2486       end.
     2487     end.
     2488     if p-change-value < 0
     2489     then do:
     2490       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2491       then do:
     2492         assign
     2493           p-change-value = v-diasize-orig-frame-height
     2494                          - (frame Dialog-Frame :height-chars)
     2495         .
     2496         if p-change-value >= 0
     2497         then do:
     2498           run diasize_position-resize-button in this-procedure .
     2499           return .
     2500         end.
     2501       end.
     2502     end.
     2503     if p-change-value >= 0
     2504     then do:
     2505       assign
     2506         v-change-sign = 1
     2507       .
     2508     end.
     2509     else do:
     2510       assign
     2511         v-change-sign = -1
     2512       .
     2513     end.
     2514     assign
     2515       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2516     .
     2517     if p-change-value = 0
     2518     then do:
     2519       run diasize_position-resize-button in this-procedure .
     2520       return .
     2521     end.
     2522     move_block:
     2523     do
     2524     on error undo move_block, retry move_block
     2525     :
     2526       if retry
     2527       then do:
     2528         do
     2529         on error undo move_block, leave move_block
     2530         :
     2531           if p-change-value > 0
     2532           then do:
     2533             for each buf_temp-diasize-handle
     2534             on error undo, next
     2535             :
     2536               assign
     2537                 v-object-handle = buf_temp-diasize-handle.handle-value
     2538               .
     2539               if v-object-handle <> v-diasize-resize-button
     2540               then do:
     2541                 assign
     2542                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2543                 .
     2544               end.
     2545             end.
     2546             assign
     2547               v-diasize-browse-handle :height = v-browse-height
     2548             .
     2549             for each buf_temp-browse-handle
     2550               where buf_temp-browse-handle.browse-type = 'height':u
     2551             on error undo, next
     2552             :
     2553               assign
     2554                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2555               .
     2556             end.
     2557             assign
     2558               frame Dialog-Frame :height = v-frame-height
     2559             .
     2560             if frame Dialog-Frame :scrollable = true
     2561             then do:
     2562               assign
     2563                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2564               .
     2565             end.
     2566             run diasize_position-resize-button in this-procedure .
     2567           end.
     2568           else do:
     2569             if frame Dialog-Frame :scrollable = true
     2570             then do:
     2571               assign
     2572                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2573               .
     2574             end.
     2575             assign
     2576               frame Dialog-Frame :height = v-frame-height
     2577             .
     2578             assign
     2579               v-diasize-browse-handle :height = v-browse-height
     2580             .
     2581             for each buf_temp-browse-handle
     2582               where buf_temp-browse-handle.browse-type = 'height':u
     2583             on error undo, next
     2584             :
     2585               assign
     2586                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2587               .
     2588             end.
     2589             for each buf_temp-diasize-handle
     2590             on error undo, next
     2591             :
     2592               assign
     2593                 v-object-handle = buf_temp-diasize-handle.handle-value
     2594               .
     2595               if v-object-handle <> v-diasize-resize-button
     2596               then do:
     2597                 assign
     2598                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2599                 .
     2600               end.
     2601             end.
     2602             run diasize_position-resize-button in this-procedure .
     2603           end.
     2604           assign
     2605             v-diasize-change-size = false
     2606           .
     2607           leave move_block .
     2608         end.
     2609       end.
     2610       assign
     2611         v-diasize-need-full-display = true
     2612       .
     2613       if v-diasize-change-size = false
     2614       then do:
     2615         assign
     2616           v-diasize-change-size = true
     2617         .
     2618       end.
     2619       else do:
     2620         return .
     2621       end.
     2622       assign
     2623         v-frame-height = frame Dialog-Frame :height
     2624         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2625         v-browse-height = v-diasize-browse-handle :height
     2626       .
     2627       for each buf_temp-browse-handle
     2628         where buf_temp-browse-handle.browse-type = 'height':u
     2629       :
     2630         assign
     2631           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2632         .
     2633       end.
     2634       for each buf_temp-diasize-handle
     2635       :
     2636         delete buf_temp-diasize-handle .
     2637       end.
     2638       assign
     2639         v-field-group-handle = frame Dialog-Frame :first-child
     2640       .
     2641       do while valid-handle(v-field-group-handle)
     2642       :
     2643         assign
     2644           v-object-handle = v-field-group-handle :first-child
     2645         .
     2646         do while valid-handle(v-object-handle)
     2647         :
     2648           if  v-object-handle <> v-diasize-browse-handle :handle
     2649           and can-query(v-object-handle, "row")
     2650           and can-query(v-object-handle, "height")
     2651           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2652           then do:
     2653             find first buf_temp-browse-handle
     2654               where buf_temp-browse-handle.browse-type   = 'height':u
     2655                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2656               no-error .
     2657             if available buf_temp-browse-handle
     2658             then do:
     2659             end.
     2660             else do:
     2661               create buf_temp-diasize-handle .
     2662               assign
     2663                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2664                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2665               .
     2666             end.
     2667           end.
     2668           assign
     2669             v-object-handle = v-object-handle :next-sibling
     2670           .
     2671         end.
     2672         assign
     2673           v-field-group-handle = v-field-group-handle :next-sibling
     2674         .
     2675       end.
     2676       do with frame Dialog-Frame
     2677       :
     2678         hide v-diasize-resize-button .
     2679         assign
     2680           v-diasize-resize-button :row    = 1
     2681           v-diasize-resize-button :column = 1
     2682         .
     2683       end.
     2684       if p-change-value > 0
     2685       then do:
     2686         if frame Dialog-Frame :scrollable = true
     2687         then do:
     2688           assign
     2689             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2690             no-error .
     2691           if error-status :error
     2692           or error-status :get-message(1) <> ""
     2693           then do:
     2694             undo move_block, retry move_block .
     2695           end.
     2696         end.
     2697         assign
     2698           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2699           no-error .
     2700         if error-status :error
     2701         or error-status :get-message(1) <> ""
     2702         then do:
     2703           undo move_block, retry move_block .
     2704         end.
     2705         assign
     2706           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2707           no-error .
     2708         if error-status :error
     2709         or error-status :get-message(1) <> ""
     2710         then do:
     2711           undo move_block, retry move_block .
     2712         end.
     2713         for each buf_temp-browse-handle
     2714           where buf_temp-browse-handle.browse-type = 'height':u
     2715         on error undo move_block, retry move_block
     2716         :
     2717           assign
     2718             buf_temp-browse-handle.browse-handle :height
     2719               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2720             no-error .
     2721           if error-status :error
     2722           or error-status :get-message(1) <> ""
     2723           then do:
     2724             undo move_block, retry move_block .
     2725           end.
     2726         end.
     2727         for each buf_temp-diasize-handle
     2728         on error undo move_block, retry move_block
     2729         :
     2730           assign
     2731             v-object-handle = buf_temp-diasize-handle.handle-value
     2732           .
     2733           if v-object-handle <> v-diasize-resize-button
     2734           then do:
     2735             assign
     2736               v-object-handle :row = v-object-handle :row + p-change-value
     2737               no-error .
     2738             if error-status :error
     2739             or error-status :get-message(1) <> ""
     2740             then do:
     2741               undo move_block, retry move_block .
     2742             end.
     2743           end.
     2744         end.
     2745       end.
     2746       else do:
     2747         for each buf_temp-diasize-handle
     2748         on error undo move_block, retry move_block
     2749         :
     2750           assign
     2751             v-object-handle = buf_temp-diasize-handle.handle-value
     2752           .
     2753           if v-object-handle <> v-diasize-resize-button
     2754           then do:
     2755             assign
     2756               v-object-handle :row = v-object-handle :row + p-change-value
     2757               no-error .
     2758             if error-status :error
     2759             or error-status :get-message(1) <> ""
     2760             then do:
     2761               undo move_block, retry move_block .
     2762             end.
     2763           end.
     2764         end.
     2765         assign
     2766           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2767           no-error .
     2768         if error-status :error
     2769         or error-status :get-message(1) <> ""
     2770         then do:
     2771           undo move_block, retry move_block .
     2772         end.
     2773         for each buf_temp-browse-handle
     2774           where buf_temp-browse-handle.browse-type = 'height':u
     2775         on error undo move_block, retry move_block
     2776         :
     2777           assign
     2778             buf_temp-browse-handle.browse-handle :height
     2779               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2780             no-error .
     2781           if error-status :error
     2782           or error-status :get-message(1) <> ""
     2783           then do:
     2784             undo move_block, retry move_block .
     2785           end.
     2786         end.
     2787         assign
     2788           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2789           no-error .
     2790         if error-status :error
     2791         or error-status :get-message(1) <> ""
     2792         then do:
     2793           undo move_block, retry move_block .
     2794         end.
     2795         if frame Dialog-Frame :scrollable = true
     2796         then do:
     2797           assign
     2798             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2799             no-error .
     2800           if error-status :error
     2801           or error-status :get-message(1) <> ""
     2802           then do:
     2803             undo move_block, retry move_block .
     2804           end.
     2805         end.
     2806       end.
     2807       if p-move-resize = true
     2808       then do:
     2809         run diasize_position-resize-button in this-procedure .
     2810       end.
     2811       if v-diasize-wndstore = true
     2812       then do:
     2813         if connected("ub") = true
     2814         then do:
     2815           define variable v-cntxt-db-num        as integer   no-undo .
     2816           define variable v-cntxt-userid        as character no-undo .
     2817           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2818                                             , OUTPUT v-cntxt-userid
     2819                                             ) .
     2820           run gbl/wndsizew.p
     2821             (input  v-cntxt-db-num
     2822             ,input  v-cntxt-userid
     2823             ,input  v-diasize-proc-name
     2824             ,input  'height':u
     2825             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2826             ) .
     2827         end.
     2828       end.
     2829     end.
     2830     assign
     2831       v-diasize-change-size = false
     2832     .
     2833   end procedure.
     2834   procedure diasize_set-height :
     2835     define input  parameter p-new-height  as decimal   no-undo .
     2836     define input  parameter p-move-resize as logical   no-undo .
     2837     do
     2838     on error undo, return error return-value
     2839     :
     2840       run diasize_change-height in this-procedure
     2841         (input  (p-new-height - frame Dialog-Frame :height)
     2842         ,input  p-move-resize
     2843         ) .
     2844     end.
     2845   end procedure.
     2846   procedure diasize_change-width :
     2847     define input  parameter p-change-value as decimal   no-undo .
     2848     define input  parameter p-move-resize  as logical   no-undo .
     2849     define variable v-field-group-handle   as handle    no-undo .
     2850     define variable v-object-handle        as handle    no-undo .
     2851     define variable v-frame-width          as decimal   no-undo .
     2852     define variable v-frame-virtual-width  as decimal   no-undo .
     2853     define variable v-browse-width         as decimal   no-undo .
     2854     define variable v-window-width         as decimal   no-undo .
     2855     define variable v-window-virtual-width as decimal   no-undo .
     2856     define variable v-change-sign          as integer   no-undo .
     2857     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2858     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2859     if p-change-value > 0
     2860     then do:
     2861       if frame Dialog-Frame :width + p-change-value >
     2862           session :width-chars
     2863       then do:
     2864         assign
     2865           p-change-value = session :width-chars - frame Dialog-Frame :width
     2866         .
     2867         if p-change-value <= 0
     2868         then do:
     2869           run diasize_position-resize-button in this-procedure .
     2870           return .
     2871         end.
     2872       end.
     2873     end.
     2874     if p-change-value < 0
     2875     then do:
     2876       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2877       then do:
     2878         assign
     2879           p-change-value = v-diasize-orig-frame-width
     2880                          - frame Dialog-Frame :width
     2881         .
     2882         if p-change-value >= 0
     2883         then do:
     2884           run diasize_position-resize-button in this-procedure .
     2885           return .
     2886         end.
     2887       end.
     2888     end.
     2889     if p-change-value >= 0
     2890     then do:
     2891       assign
     2892         v-change-sign = 1
     2893       .
     2894     end.
     2895     else do:
     2896       assign
     2897         v-change-sign = -1
     2898       .
     2899     end.
     2900     assign
     2901       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2902     .
     2903     if p-change-value = 0
     2904     then do:
     2905       run diasize_position-resize-button in this-procedure .
     2906       return .
     2907     end.
     2908     move_block:
     2909     do
     2910     on error undo move_block, leave move_block
     2911     :
     2912       if retry
     2913       then do:
     2914         do
     2915         on error undo move_block, leave move_block
     2916         :
     2917           if p-change-value > 0
     2918           then do:
     2919             for each buf_temp-diasize-handle
     2920             on error undo, next
     2921             :
     2922               assign
     2923                 v-object-handle = buf_temp-diasize-handle.handle-value
     2924               .
     2925               if v-object-handle <> v-diasize-resize-button
     2926               then do:
     2927                 assign
     2928                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2929                 .
     2930               end.
     2931             end.
     2932             assign
     2933               v-diasize-browse-handle :width = v-browse-width
     2934             .
     2935             for each buf_temp-browse-handle
     2936               where buf_temp-browse-handle.browse-type = 'width':u
     2937             on error undo, next
     2938             :
     2939               assign
     2940                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2941               .
     2942             end.
     2943             assign
     2944               frame Dialog-Frame :width = v-frame-width
     2945             .
     2946             if frame Dialog-Frame :scrollable = true
     2947             then do:
     2948               assign
     2949                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2950               .
     2951             end.
     2952             run diasize_position-resize-button in this-procedure .
     2953           end.
     2954           else do:
     2955             if frame Dialog-Frame :scrollable = true
     2956             then do:
     2957               assign
     2958                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2959               .
     2960             end.
     2961             assign
     2962               frame Dialog-Frame :width = v-frame-width
     2963             .
     2964             for each buf_temp-browse-handle
     2965               where buf_temp-browse-handle.browse-type = 'width':u
     2966             on error undo, next
     2967             :
     2968               assign
     2969                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2970               .
     2971             end.
     2972             assign
     2973               v-diasize-browse-handle :width = v-browse-width
     2974             .
     2975             for each buf_temp-diasize-handle
     2976             on error undo, next
     2977             :
     2978               assign
     2979                 v-object-handle = buf_temp-diasize-handle.handle-value
     2980               .
     2981               if v-object-handle <> v-diasize-resize-button
     2982               then do:
     2983                 assign
     2984                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2985                 .
     2986               end.
     2987             end.
     2988             run diasize_position-resize-button in this-procedure .
     2989           end.
     2990           assign
     2991             v-diasize-change-size = false
     2992           .
     2993           leave move_block .
     2994         end.
     2995       end.
     2996       assign
     2997         v-diasize-need-full-display = true
     2998       .
     2999       if v-diasize-change-size = false
     3000       then do:
     3001         assign
     3002           v-diasize-change-size = true
     3003         .
     3004       end.
     3005       else do:
     3006         return .
     3007       end.
     3008       assign
     3009         v-frame-width = frame Dialog-Frame :width
     3010         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3011         v-browse-width = v-diasize-browse-handle :width
     3012       .
     3013       for each buf_temp-browse-handle
     3014         where buf_temp-browse-handle.browse-type = 'width':u
     3015       :
     3016         assign
     3017           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3018         .
     3019       end.
     3020       for each buf_temp-diasize-handle
     3021       :
     3022         delete buf_temp-diasize-handle .
     3023       end.
     3024       assign
     3025         v-field-group-handle = frame Dialog-Frame :first-child
     3026       .
     3027       do while valid-handle(v-field-group-handle)
     3028       :
     3029         assign
     3030           v-object-handle = v-field-group-handle :first-child
     3031         .
     3032         do while valid-handle(v-object-handle)
     3033         :
     3034           if  v-object-handle <> v-diasize-browse-handle :handle
     3035           and v-object-handle <> v-diasize-resize-button
     3036           and can-query(v-object-handle, "row")
     3037           and can-query(v-object-handle, "height")
     3038           and ( v-object-handle :col + v-object-handle :width
     3039                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3040               )
     3041           then do:
     3042             find first buf_temp-browse-handle
     3043               where buf_temp-browse-handle.browse-type   = 'width':u
     3044                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3045               no-error .
     3046             if available buf_temp-browse-handle
     3047             then do:
     3048             end.
     3049             else do:
     3050               create buf_temp-diasize-handle .
     3051               assign
     3052                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3053                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3054               .
     3055             end.
     3056           end.
     3057           assign
     3058             v-object-handle = v-object-handle :next-sibling
     3059           .
     3060         end.
     3061         assign
     3062           v-field-group-handle = v-field-group-handle :next-sibling
     3063         .
     3064       end.
     3065       do with frame Dialog-Frame
     3066       :
     3067         hide v-diasize-resize-button .
     3068         v-diasize-resize-button :row = 1.
     3069         v-diasize-resize-button :column = 1.
     3070       end.
     3071       if p-change-value > 0
     3072       then do:
     3073         if frame Dialog-Frame :scrollable = true
     3074         then do:
     3075           assign
     3076             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3077             no-error .
     3078           if error-status :error
     3079           or error-status :get-message(1) <> ""
     3080           then do:
     3081             undo move_block, retry move_block.
     3082           end.
     3083         end.
     3084         assign
     3085           frame Dialog-Frame :width = v-frame-width + p-change-value
     3086           no-error .
     3087         if error-status :error
     3088         or error-status :get-message(1) <> ""
     3089         then do:
     3090           undo move_block, retry move_block.
     3091         end.
     3092         assign
     3093           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3094         no-error .
     3095         if error-status :error
     3096         or error-status :get-message(1) <> ""
     3097         then do:
     3098           undo move_block, retry move_block.
     3099         end.
     3100         for each buf_temp-browse-handle
     3101           where buf_temp-browse-handle.browse-type = 'width':u
     3102         on error undo move_block, retry move_block
     3103         :
     3104           assign
     3105             buf_temp-browse-handle.browse-handle :width
     3106               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3107             no-error .
     3108           if error-status :error
     3109           or error-status :get-message(1) <> ""
     3110           then do:
     3111             undo move_block, retry move_block .
     3112           end.
     3113         end.
     3114         for each buf_temp-diasize-handle
     3115         on error undo move_block, retry move_block
     3116         :
     3117           assign
     3118             v-object-handle = buf_temp-diasize-handle.handle-value
     3119           .
     3120           if v-object-handle <> v-diasize-resize-button
     3121           then do:
     3122             assign
     3123               v-object-handle :col = v-object-handle :col + p-change-value
     3124               no-error .
     3125             if error-status :error
     3126             or error-status :get-message(1) <> ""
     3127             then do:
     3128               undo move_block, retry move_block .
     3129             end.
     3130           end.
     3131         end.
     3132       end.
     3133       else do:
     3134         for each buf_temp-diasize-handle
     3135         on error undo move_block, retry move_block
     3136         :
     3137           assign
     3138             v-object-handle = buf_temp-diasize-handle.handle-value
     3139           .
     3140           if v-object-handle <> v-diasize-resize-button
     3141           then do:
     3142             assign
     3143               v-object-handle :col = v-object-handle :col + p-change-value
     3144               no-error .
     3145             if error-status :error
     3146             or error-status :get-message(1) <> ""
     3147             then do:
     3148               undo move_block, retry move_block .
     3149             end.
     3150           end.
     3151         end.
     3152         for each buf_temp-browse-handle
     3153           where buf_temp-browse-handle.browse-type = 'width':u
     3154         on error undo move_block, retry move_block
     3155         :
     3156           assign
     3157             buf_temp-browse-handle.browse-handle :width
     3158               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3159             no-error .
     3160           if error-status :error
     3161           or error-status :get-message(1) <> ""
     3162           then do:
     3163             undo move_block, retry move_block .
     3164           end.
     3165         end.
     3166         assign
     3167           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3168           no-error .
     3169         if error-status :error
     3170         or error-status :get-message(1) <> ""
     3171         then do:
     3172           undo move_block, retry move_block.
     3173         end.
     3174         assign
     3175           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3176         no-error .
     3177         if error-status :error
     3178         or error-status :get-message(1) <> ""
     3179         then do:
     3180           undo move_block, retry move_block.
     3181         end.
     3182         if frame Dialog-Frame :scrollable = true
     3183         then do:
     3184           assign
     3185             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3186           no-error .
     3187           if error-status :error
     3188           or error-status :get-message(1) <> ""
     3189           then do:
     3190             undo move_block, retry move_block.
     3191           end.
     3192         end.
     3193       end.
     3194       if p-move-resize
     3195       then do:
     3196         run diasize_position-resize-button in this-procedure .
     3197       end.
     3198       if v-diasize-wndstore = true
     3199       then do:
     3200         if connected("ub") = true
     3201         then do:
     3202           define variable v-cntxt-db-num        as integer   no-undo .
     3203           define variable v-cntxt-userid        as character no-undo .
     3204           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3205                                             , OUTPUT v-cntxt-userid
     3206                                             ) .
     3207           run gbl/wndsizew.p
     3208             (input  v-cntxt-db-num
     3209             ,input  v-cntxt-userid
     3210             ,input  v-diasize-proc-name
     3211             ,input  'width':u
     3212             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3213             ) .
     3214         end.
     3215       end.
     3216     end.
     3217     assign
     3218       v-diasize-change-size = false
     3219     .
     3220   end procedure.
     3221   procedure diasize_set-width :
     3222     define input  parameter p-new-width  as decimal   no-undo .
     3223     define input  parameter p-move-resize as logical   no-undo .
     3224     do
     3225     on error undo, return error return-value
     3226     :
     3227       run diasize_change-width in this-procedure
     3228         (input  (p-new-width - frame Dialog-Frame :width)
     3229         ,input  p-move-resize
     3230         ) .
     3231     end.
     3232   end procedure.
     3233   procedure diasize_position-resize-button :
     3234     do with frame Dialog-Frame
     3235     :
     3236       hide v-diasize-resize-button .
     3237       assign
     3238         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3239                     - 1
     3240                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3241         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3242                     - 1
     3243                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3244       .
     3245       view v-diasize-resize-button .
     3246     end.
     3247   end procedure.
     3248   on alt-right anywhere
     3249   do:
     3250     run diasize_change-width in this-procedure
     3251       (input 1
     3252       ,input true
     3253       ) .
     3254     return no-apply .
     3255   end.
     3256   on alt-left anywhere
     3257   do:
     3258     run diasize_change-width in this-procedure
     3259       (input -1
     3260       ,input true
     3261       ) .
     3262     return no-apply .
     3263   end.
     3264   on alt-down anywhere
     3265   do:
     3266     run diasize_change-height in this-procedure
     3267       (input 1
     3268       ,input true
     3269       ) .
     3270     return no-apply .
     3271   end.
     3272   on alt-up anywhere
     3273   do:
     3274     run diasize_change-height in this-procedure
     3275       (input -1
     3276       ,input true
     3277       ) .
     3278     return no-apply .
     3279   end.
     3280   on alt-enter of frame Dialog-Frame
     3281   do:
     3282     run diasize_maximize in this-procedure
     3283       (input  ?
     3284       ).
     3285     return no-apply .
     3286   end.
     3287   procedure diasize_end-move :
     3288     do
     3289     on error undo, return error return-value
     3290     :
     3291       define variable v-row-delta as decimal   no-undo .
     3292       define variable v-col-delta as decimal   no-undo .
     3293       define variable v-new-row as decimal   no-undo .
     3294       define variable v-new-col as decimal   no-undo .
     3295       assign
     3296         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3297         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3298       .
     3299       assign
     3300         v-row-delta = v-new-row - frame Dialog-Frame :height
     3301         v-col-delta = v-new-col - frame Dialog-Frame :width
     3302       .
     3303       run diasize_change-height in this-procedure
     3304         (input v-row-delta
     3305         ,input true
     3306         ) .
     3307       run diasize_change-width in this-procedure
     3308         (input v-col-delta
     3309         ,input true
     3310         ) .
     3311     end.
     3312   end procedure.
     3313   procedure diasize_maximize :
     3314     define input  parameter p-action as logical   no-undo .
     3315     do
     3316     on error undo, return error return-value
     3317     :
     3318       if p-action = ?
     3319       then do:
     3320         if v-diasize-need-maximize = true
     3321         then do:
     3322           assign
     3323             p-action = true
     3324           .
     3325         end.
     3326         else do:
     3327           assign
     3328             p-action = false
     3329           .
     3330         end.
     3331       end.
     3332       if p-action = true
     3333       then do:
     3334         run diasize_change-height in this-procedure
     3335           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3336               - frame Dialog-Frame :height-chars
     3337           ,input true
     3338           ) .
     3339         run diasize_change-width in this-procedure
     3340           (input session :width-chars
     3341               - frame Dialog-Frame :width-chars
     3342           ,input true
     3343           ) .
     3344         assign
     3345           v-diasize-need-maximize = false
     3346         .
     3347       end.
     3348       else do:
     3349         run diasize_change-width in this-procedure
     3350           (input v-diasize-orig-frame-width
     3351               - frame Dialog-Frame :width-chars
     3352           ,input true
     3353           ) .
     3354         run diasize_change-height in this-procedure
     3355           (input v-diasize-orig-frame-height
     3356               - frame Dialog-Frame :height-chars
     3357           ,input true
     3358           ) .
     3359         assign
     3360           v-diasize-need-maximize = true
     3361         .
     3362       end.
     3363     end.
     3364   end procedure.
     3365   procedure diasize_restore-orig-size :
     3366     do
     3367     on error undo, return error return-value
     3368     :
     3369       assign
     3370         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3371         v-diasize-current-frame-height = frame Dialog-Frame :height
     3372       .
     3373       run diasize_set-height in this-procedure
     3374         (input  v-diasize-orig-frame-height
     3375         ,input  true
     3376         ) .
     3377       run diasize_set-width in this-procedure
     3378         (input  v-diasize-orig-frame-width
     3379         ,input  true
     3380         ) .
     3381     end.
     3382   end procedure.
     3383   procedure diasize_restore-current-size :
     3384     do
     3385     on error undo, return error return-value
     3386     :
     3387       run diasize_set-height in this-procedure
     3388         (input  v-diasize-current-frame-height
     3389         ,input  true
     3390         ) .
     3391       run diasize_set-width in this-procedure
     3392         (input  v-diasize-current-frame-width
     3393         ,input  true
     3394         ) .
     3395     end.
     3396   end procedure.
     3397   procedure diasize_set-browse-handle :
     3398     define input  parameter p-browse-handle as handle   no-undo .
     3399     define buffer buf_temp-browse-handle for temp-browse-handle .
     3400     do
     3401     on error undo, return error return-value
     3402     :
     3403       assign
     3404         v-diasize-browse-handle = p-browse-handle
     3405       .
     3406       for each buf_temp-browse-handle
     3407       on error undo, return error return-value
     3408       :
     3409         delete buf_temp-browse-handle .
     3410       end.
     3411     end.
     3412   end procedure.
     3413   procedure diasize_add_browse :
     3414     define input  parameter p-browse-type   as character no-undo .
     3415     define input  parameter p-browse-handle as handle    no-undo .
     3416     define buffer buf_temp-browse-handle for temp-browse-handle .
     3417     do
     3418     on error undo, return error return-value
     3419     :
     3420       assign
     3421         v-diasize-browse-number = v-diasize-browse-number + 1
     3422       .
     3423       create buf_temp-browse-handle .
     3424       assign
     3425         buf_temp-browse-handle.browse-type   = p-browse-type
     3426         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3427         buf_temp-browse-handle.browse-handle = p-browse-handle
     3428       .
     3429     end.
     3430   end procedure.
     3431   procedure diasize_init :
     3432     define variable v-default-value    as logical   no-undo .
     3433     define variable v-restore-saved    as logical   no-undo .
     3434     define variable v-resize-value-str as character no-undo .
     3435     do
     3436     on error undo, return error return-value
     3437     :
     3438       do with frame Dialog-Frame
     3439       :
     3440         assign
     3441           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3442           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3443           v-diasize-browse-handle     = browse BROWSE-12 :handle
     3444         .
     3445         create button v-diasize-resize-button
     3446         assign
     3447           parent        = frame Dialog-Frame :first-child
     3448           label         = "s"
     3449           height-pixels = 16
     3450           width-pixels  = 16
     3451           visible       = true
     3452           sensitive     = true
     3453           movable       = true
     3454           triggers:
     3455             on end-move persistent run diasize_end-move in this-procedure .
     3456           end triggers.
     3457         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3458         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3459         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3460         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3461         assign
     3462           v-diasize-wndmax = false
     3463         .
     3464         if connected("ub") = true
     3465         then do:
     3466           define variable v-cntxt-db-num        as integer   no-undo .
     3467           define variable v-cntxt-userid        as character no-undo .
     3468           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3469                                             , OUTPUT v-cntxt-userid
     3470                                             ) .
     3471           run gbl/wndpar_r.p
     3472             (input  v-cntxt-db-num
     3473             ,input  v-cntxt-userid
     3474             ,input  'wndmax':U
     3475             ,output v-diasize-wndmax
     3476             ,output v-default-value
     3477             ) .
     3478         end.
     3479         assign
     3480           v-diasize-wndstore = false
     3481         .
     3482         if connected("ub") = true
     3483         then do:
     3484           run gbl/wndpar_r.p
     3485             (input  v-cntxt-db-num
     3486             ,input  v-cntxt-userid
     3487             ,input  'wndstore':U
     3488             ,output v-diasize-wndstore
     3489             ,output v-default-value
     3490             ) .
     3491         end.
     3492         assign
     3493           v-diasize-proc-name = entry(1, program-name(2), '.')
     3494         .
     3495         if v-diasize-wndstore = true
     3496         then do:
     3497           assign
     3498             v-restore-saved = false
     3499           .
     3500           if connected("ub") = true
     3501           then do:
     3502             run gbl/wndsizer.p
     3503               (input  v-cntxt-db-num
     3504               ,input  v-cntxt-userid
     3505               ,input  v-diasize-proc-name
     3506               ,input  'height':u
     3507               ,output v-resize-value-str
     3508               ) .
     3509             if v-resize-value-str <> '':U
     3510             then do:
     3511               run diasize_change-height in this-procedure
     3512                 (input  integer(v-resize-value-str)
     3513                 ,input  true
     3514                 ) .
     3515               assign
     3516                 v-restore-saved = true
     3517               .
     3518             end.
     3519           end.
     3520           if connected("ub") = true
     3521           then do:
     3522             run gbl/wndsizer.p
     3523               (input  v-cntxt-db-num
     3524               ,input  v-cntxt-userid
     3525               ,input  v-diasize-proc-name
     3526               ,input  'width':u
     3527               ,output v-resize-value-str
     3528               ) .
     3529             if v-resize-value-str <> '':U
     3530             then do:
     3531               run diasize_change-width in this-procedure
     3532                 (input  integer(v-resize-value-str)
     3533                 ,input  true
     3534                 ) .
     3535               assign
     3536                 v-restore-saved = true
     3537               .
     3538             end.
     3539           end.
     3540           if v-restore-saved <> true
     3541           then do:
     3542             if v-diasize-wndmax = true
     3543             then do:
     3544               run diasize_maximize in this-procedure
     3545                 (input  true
     3546                 ) .
     3547             end.
     3548           end.
     3549         end.
     3550         else do:
     3551           if v-diasize-wndmax = true
     3552           then do:
     3553             run diasize_maximize in this-procedure
     3554               (input  true
     3555               ) .
     3556           end.
     3557         end.
     3558       end.
     3559     end.
     3560   end procedure.
     3561   procedure diasize_need-full-display :
     3562     define output parameter p-need-full-display as logical   no-undo .
     3563     do
     3564     on error undo, return error return-value
     3565     :
     3566       assign
     3567         p-need-full-display = v-diasize-need-full-display
     3568       .
     3569       assign
     3570         v-diasize-need-full-display = false
     3571       .
     3572     end.
     3573   end procedure.
     3574   procedure get-context :
     3575      define output parameter p-db-num as integer          no-undo.
     3576      define output parameter p-user-id as character        no-undo.
     3577      define variable v-login               as character    no-undo.
     3578      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3579      define buffer buf_user-login  for ub.user-login .
     3580      do
     3581      on error undo, return error
     3582      :
     3583            FIND FIRST buf_sys-ctrl no-lock.
     3584            ASSIGN
     3585               v-login = USERID("ub")
     3586               p-db-num = buf_sys-ctrl.db-num
     3587            .
     3588            FIND FIRST buf_user-login
     3589                 WHERE buf_user-login.db-num = p-db-num
     3590                   AND buf_user-login.user-login = v-login
     3591                 no-lock
     3592                 no-error
     3593                 .
     3594            IF AVAILABLE buf_user-login
     3595            THEN DO:
     3596               assign
     3597                  p-user-id = buf_user-login.user-id
     3598               .
     3599            END.
     3600      end.
     3601   end procedure.
     3602       run diasize_init in this-procedure .
     3603   def var sort-labelbrowse-18   as character no-undo .
     3604   def var sort-clmnbrowse-18    as handle    no-undo .
     3605   def var cur-clmnbrowse-18     as handle    no-undo .
     3606   def var cur-clmn-locbrowse-18 as integer   no-undo .
     3607   def var re-querybrowse-18     as logical   initial no no-undo .
     3608   on start-search, ctrl-o of browse-18 in frame frame-J do:
     3609      run sort-brbrowse-18
     3610        (input (if available ub.ord-doc
     3611                then recid(ub.ord-doc)
     3612                else ?
     3613               )
     3614        ).
     3615   end.
     3616   PROCEDURE sort-brbrowse-18 :
     3617     define input parameter p-recid as recid no-undo .
     3618     if re-querybrowse-18 = no then do:
     3619       assign
     3620          cur-clmnbrowse-18 = browse-18:current-column in frame frame-J
     3621       .
     3622       if sort-clmnbrowse-18 <> ? then sort-clmnbrowse-18:column-fgcolor = 0.
     3623       if cur-clmnbrowse-18 = sort-clmnbrowse-18 then do:
     3624         assign
     3625            sort-labelbrowse-18 = ""
     3626            sort-clmnbrowse-18 = ?
     3627         .
     3628        end.
     3629        else do:
     3630          assign
     3631            sort-labelbrowse-18 = cur-clmnbrowse-18:label
     3632            sort-clmnbrowse-18  = cur-clmnbrowse-18
     3633            sort-clmnbrowse-18:column-fgcolor = 4
     3634          .
     3635        end.
     3636      end.
     3637     assign
     3638       cur-clmn-locbrowse-18 = 1
     3639     .
     3640     def var column-handle as handle no-undo .
     3641     column-handle = browse-18:first-column.
     3642     do while valid-handle(column-handle) :
     3643       if column-handle = cur-clmnbrowse-18 then do:
     3644         leave .
     3645       end.
     3646       column-handle = column-handle:NEXT-COLUMN.
     3647       assign
     3648         cur-clmn-locbrowse-18 = cur-clmn-locbrowse-18 + 1
     3649       .
     3650     end.
     3651     case sort-labelbrowse-18:
     3652           when '+'  then DO:   assign     sort-column-name = "mark"   .   OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .   . END.
     3653           when '№ заказа'  then DO:   assign     sort-column-name = "tt-new-ord-line.doc-code"   .   OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .   . END.
     3654           when 'Заказать'  then DO:   assign     sort-column-name = "tt-new-ord-line.qnty"   .   OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .   . END.
     3655           when 'Кому'  then DO:   assign     sort-column-name = "string(ub.ord-doc.cli-type + ' ' + string(ub.ord-doc.cli-code))"   .   OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .   . END.
     3656           when 'Поставщик'  then DO:   assign     sort-column-name = "ub.ord-doc.cli-name"   .   OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .   . END.
     3657           when 'Статус'  then DO:   assign     sort-column-name = "(IF (ub.ord-doc.status_ = 'факт':U or ub.ord-doc.status_ = 'закрыто':U) THEN (ub.ord-doc.status_ + string(ub.ord-doc.flag_,'+/-')) ELSE (ub.ord-doc.status_) )"   .   OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .   . END.
     3658           when 'Название'  then DO:   assign     sort-column-name = "ub.goods.gds-name"   .   OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .   . END.
     3659           when 'Артикул'  then DO:   assign     sort-column-name = "tt-new-ord-line.artic"   .   OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .   . END.
     3660       otherwise do:
     3661         assign
     3662           sort-column-name = ""
     3663         .
     3664         OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .
     3665         if sort-labelbrowse-18 <> "" then do:
     3666           assign
     3667             cur-clmnbrowse-18:column-fgcolor = 0
     3668           .
     3669         end.
     3670         assign
     3671           cur-clmn-locbrowse-18 = ?
     3672         .
     3673       end.
     3674     end case.
     3675       if cur-clmn-locbrowse-18 <> ? then do:
     3676         if can-do( this-procedure:internal-entries, 'ch-clmnbrowse-18') then do:
     3677           run ch-clmnbrowse-18 in this-procedure (cur-clmn-locbrowse-18).
     3678         end.
     3679       end.
     3680     if p-recid <> ? then do:
     3681       reposition browse-18 to recid p-recid no-error.
     3682       apply "value-changed" to browse-18 in frame frame-J.
     3683     end.
     3684     apply "entry" to browse-18 in frame frame-J.
     3685   END PROCEDURE.
     3686   procedure re-open-query-srt-clmnbrowse-18:
     3687   if cur-clmnbrowse-18 = ? then do:
     3688      OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .
     3689   end.
     3690   else do:
     3691      assign re-querybrowse-18 = yes.
     3692      run sort-brbrowse-18
     3693        (input (if available ub.ord-doc
     3694                then recid(ub.ord-doc)
     3695                else ?
     3696               )
     3697        ).
     3698      assign re-querybrowse-18 = no.
     3699   end.
     3700   end.
     3701   def var sort-labelbrowse-28   as character no-undo .
     3702   def var sort-clmnbrowse-28    as handle    no-undo .
     3703   def var cur-clmnbrowse-28     as handle    no-undo .
     3704   def var cur-clmn-locbrowse-28 as integer   no-undo .
     3705   def var re-querybrowse-28     as logical   initial no no-undo .
     3706   on start-search, ctrl-o of browse-28 in frame frame-J do:
     3707      run sort-brbrowse-28
     3708        (input (if available ub.ord-doc-rcv
     3709                then recid(ub.ord-doc-rcv)
     3710                else ?
     3711               )
     3712        ).
     3713   end.
     3714   PROCEDURE sort-brbrowse-28 :
     3715     define input parameter p-recid as recid no-undo .
     3716     if re-querybrowse-28 = no then do:
     3717       assign
     3718          cur-clmnbrowse-28 = browse-28:current-column in frame frame-J
     3719       .
     3720       if sort-clmnbrowse-28 <> ? then sort-clmnbrowse-28:column-fgcolor = 0.
     3721       if cur-clmnbrowse-28 = sort-clmnbrowse-28 then do:
     3722         assign
     3723            sort-labelbrowse-28 = ""
     3724            sort-clmnbrowse-28 = ?
     3725         .
     3726        end.
     3727        else do:
     3728          assign
     3729            sort-labelbrowse-28 = cur-clmnbrowse-28:label
     3730            sort-clmnbrowse-28  = cur-clmnbrowse-28
     3731            sort-clmnbrowse-28:column-fgcolor = 4
     3732          .
     3733        end.
     3734      end.
     3735     assign
     3736       cur-clmn-locbrowse-28 = 1
     3737     .
     3738     def var column-handle as handle no-undo .
     3739     column-handle = browse-28:first-column.
     3740     do while valid-handle(column-handle) :
     3741       if column-handle = cur-clmnbrowse-28 then do:
     3742         leave .
     3743       end.
     3744       column-handle = column-handle:NEXT-COLUMN.
     3745       assign
     3746         cur-clmn-locbrowse-28 = cur-clmn-locbrowse-28 + 1
     3747       .
     3748     end.
     3749     case sort-labelbrowse-28:
     3750           when 'Поставка'  then DO:   assign     sort-column-name = "ub.ord-doc-rcv.rcv-code"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3751           when 'Кол-во'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.qnty"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3752           when 'Куда'  then DO:   assign     sort-column-name = "(ub.ord-doc-rcv.obj-type + ' ' + string(ub.ord-doc-rcv.obj-code))"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3753           when 'Цена(руб.)'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.price-rubl"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3754           when 'Кол-во(е.и.п)'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.cli-qnty"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3755           when 'Цена (пост.)'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.price-cli"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3756           when 'Доставка'  then DO:   assign     sort-column-name = "ub.ord-doc-rcv.ship-date"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3757           when 'Артикул'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.artic"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3758           when 'Заказ'  then DO:   assign     sort-column-name = "ub.ord-doc-rcv.doc-code"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3759           when 'Статус'  then DO:   assign     sort-column-name = "(IF (ub.ord-doc-rcv.status_ = 'факт':U or ub.ord-doc-rcv.status_ = 'закрыто':U) THEN (ub.ord-doc-rcv.status_ + string(ub.ord-doc-rcv.flag_,'+/-')) ELSE (ub.ord-doc-rcv.status_) )"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3760           when 'Название товара'  then DO:   assign     sort-column-name = "ub.goods.gds-name"   .   OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.   . END.
     3761       otherwise do:
     3762         assign
     3763           sort-column-name = ""
     3764         .
     3765         OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     3766         if sort-labelbrowse-28 <> "" then do:
     3767           assign
     3768             cur-clmnbrowse-28:column-fgcolor = 0
     3769           .
     3770         end.
     3771         assign
     3772           cur-clmn-locbrowse-28 = ?
     3773         .
     3774       end.
     3775     end case.
     3776       if cur-clmn-locbrowse-28 <> ? then do:
     3777         if can-do( this-procedure:internal-entries, 'ch-clmnbrowse-28') then do:
     3778           run ch-clmnbrowse-28 in this-procedure (cur-clmn-locbrowse-28).
     3779         end.
     3780       end.
     3781     if p-recid <> ? then do:
     3782       reposition browse-28 to recid p-recid no-error.
     3783       apply "value-changed" to browse-28 in frame frame-J.
     3784     end.
     3785     apply "entry" to browse-28 in frame frame-J.
     3786   END PROCEDURE.
     3787   procedure re-open-query-srt-clmnbrowse-28:
     3788   if cur-clmnbrowse-28 = ? then do:
     3789      OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     3790   end.
     3791   else do:
     3792      assign re-querybrowse-28 = yes.
     3793      run sort-brbrowse-28
     3794        (input (if available ub.ord-doc-rcv
     3795                then recid(ub.ord-doc-rcv)
     3796                else ?
     3797               )
     3798        ).
     3799      assign re-querybrowse-28 = no.
     3800   end.
     3801   end.
     3802   def var sort-labelbrowse-29   as character no-undo .
     3803   def var sort-clmnbrowse-29    as handle    no-undo .
     3804   def var cur-clmnbrowse-29     as handle    no-undo .
     3805   def var cur-clmn-locbrowse-29 as integer   no-undo .
     3806   def var re-querybrowse-29     as logical   initial no no-undo .
     3807   on start-search, ctrl-o of browse-29 in frame FRAME-Postavki do:
     3808      run sort-brbrowse-29
     3809        (input (if available new-rcv
     3810                then recid(new-rcv)
     3811                else ?
     3812               )
     3813        ).
     3814   end.
     3815   PROCEDURE sort-brbrowse-29 :
     3816     define input parameter p-recid as recid no-undo .
     3817     if re-querybrowse-29 = no then do:
     3818       assign
     3819          cur-clmnbrowse-29 = browse-29:current-column in frame FRAME-Postavki
     3820       .
     3821       if sort-clmnbrowse-29 <> ? then sort-clmnbrowse-29:column-fgcolor = 0.
     3822       if cur-clmnbrowse-29 = sort-clmnbrowse-29 then do:
     3823         assign
     3824            sort-labelbrowse-29 = ""
     3825            sort-clmnbrowse-29 = ?
     3826         .
     3827        end.
     3828        else do:
     3829          assign
     3830            sort-labelbrowse-29 = cur-clmnbrowse-29:label
     3831            sort-clmnbrowse-29  = cur-clmnbrowse-29
     3832            sort-clmnbrowse-29:column-fgcolor = 4
     3833          .
     3834        end.
     3835      end.
     3836     assign
     3837       cur-clmn-locbrowse-29 = 1
     3838     .
     3839     def var column-handle as handle no-undo .
     3840     column-handle = browse-29:first-column.
     3841     do while valid-handle(column-handle) :
     3842       if column-handle = cur-clmnbrowse-29 then do:
     3843         leave .
     3844       end.
     3845       column-handle = column-handle:NEXT-COLUMN.
     3846       assign
     3847         cur-clmn-locbrowse-29 = cur-clmn-locbrowse-29 + 1
     3848       .
     3849     end.
     3850     case sort-labelbrowse-29:
     3851           when 'Куда'  then DO:   assign     sort-column-name = "(new-rcv.obj-type + ' ' + string(new-rcv.obj-code) )"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3852           when 'Кол-во'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.qnty"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3853           when 'Артикул'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.artic"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3854           when 'Доставка'  then DO:   assign     sort-column-name = "new-rcv.ship-date"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3855           when 'Факт'  then DO:   assign     sort-column-name = "new-rcv.fact-date"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3856           when 'Время'  then DO:   assign     sort-column-name = "string(new-rcv.ship-time,'HH:MM')"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3857           when '№ пост-ки'  then DO:   assign     sort-column-name = "new-rcv.rcv-code"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3858           when 'Статус'  then DO:   assign     sort-column-name = "( IF (new-rcv.status_ = 'факт':U or new-rcv.status_ = 'закрыто':U)  THEN (new-rcv.status_ + string(new-rcv.flag_,+/-))  ELSE (new-rcv.status_) )"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3859           when '№ заказа'  then DO:   assign     sort-column-name = "new-rcv.doc-code"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3860           when 'Тип'  then DO:   assign     sort-column-name = "( IF (new-rcv.doc-type = 'in':U) THEN ('внут') ELSE ('внеш') )"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3861           when 'Cсылка'  then DO:   assign     sort-column-name = "bb_ord-doc.cons-code"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3862           when 'Цена (руб.)'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.price-rubl"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3863           when 'Кол-во(пост)'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.cli-qnty"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3864           when 'Цена (пост)'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.price-cli"   .   OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.   . END.
     3865       otherwise do:
     3866         assign
     3867           sort-column-name = ""
     3868         .
     3869         OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.
     3870         if sort-labelbrowse-29 <> "" then do:
     3871           assign
     3872             cur-clmnbrowse-29:column-fgcolor = 0
     3873           .
     3874         end.
     3875         assign
     3876           cur-clmn-locbrowse-29 = ?
     3877         .
     3878       end.
     3879     end case.
     3880       if cur-clmn-locbrowse-29 <> ? then do:
     3881         if can-do( this-procedure:internal-entries, 'ch-clmnbrowse-29') then do:
     3882           run ch-clmnbrowse-29 in this-procedure (cur-clmn-locbrowse-29).
     3883         end.
     3884       end.
     3885     if p-recid <> ? then do:
     3886       reposition browse-29 to recid p-recid no-error.
     3887       apply "value-changed" to browse-29 in frame FRAME-Postavki.
     3888     end.
     3889     apply "entry" to browse-29 in frame FRAME-Postavki.
     3890   END PROCEDURE.
     3891   procedure re-open-query-srt-clmnbrowse-29:
     3892   if cur-clmnbrowse-29 = ? then do:
     3893      OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.
     3894   end.
     3895   else do:
     3896      assign re-querybrowse-29 = yes.
     3897      run sort-brbrowse-29
     3898        (input (if available new-rcv
     3899                then recid(new-rcv)
     3900                else ?
     3901               )
     3902        ).
     3903      assign re-querybrowse-29 = no.
     3904   end.
     3905   end.
     3906   def var sort-labelbrowse-20   as character no-undo .
     3907   def var sort-clmnbrowse-20    as handle    no-undo .
     3908   def var cur-clmnbrowse-20     as handle    no-undo .
     3909   def var cur-clmn-locbrowse-20 as integer   no-undo .
     3910   def var re-querybrowse-20     as logical   initial no no-undo .
     3911   on start-search, ctrl-o of browse-20 in frame frame-h do:
     3912      run sort-brbrowse-20
     3913        (input (if available b-all_ord-doc-rcv
     3914                then recid(b-all_ord-doc-rcv)
     3915                else ?
     3916               )
     3917        ).
     3918   end.
     3919   PROCEDURE sort-brbrowse-20 :
     3920     define input parameter p-recid as recid no-undo .
     3921     if re-querybrowse-20 = no then do:
     3922       assign
     3923          cur-clmnbrowse-20 = browse-20:current-column in frame frame-h
     3924       .
     3925       if sort-clmnbrowse-20 <> ? then sort-clmnbrowse-20:column-fgcolor = 0.
     3926       if cur-clmnbrowse-20 = sort-clmnbrowse-20 then do:
     3927         assign
     3928            sort-labelbrowse-20 = ""
     3929            sort-clmnbrowse-20 = ?
     3930         .
     3931        end.
     3932        else do:
     3933          assign
     3934            sort-labelbrowse-20 = cur-clmnbrowse-20:label
     3935            sort-clmnbrowse-20  = cur-clmnbrowse-20
     3936            sort-clmnbrowse-20:column-fgcolor = 4
     3937          .
     3938        end.
     3939      end.
     3940     assign
     3941       cur-clmn-locbrowse-20 = 1
     3942     .
     3943     def var column-handle as handle no-undo .
     3944     column-handle = browse-20:first-column.
     3945     do while valid-handle(column-handle) :
     3946       if column-handle = cur-clmnbrowse-20 then do:
     3947         leave .
     3948       end.
     3949       column-handle = column-handle:NEXT-COLUMN.
     3950       assign
     3951         cur-clmn-locbrowse-20 = cur-clmn-locbrowse-20 + 1
     3952       .
     3953     end.
     3954     case sort-labelbrowse-20:
     3955           when '№ пост-ки'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.rcv-code"   .   OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.   . END.
     3956           when 'Куда'  then DO:   assign     sort-column-name = "( b-all_ord-doc-rcv.obj-type + ' ' + string(b-all_ord-doc-rcv.obj-code) )"   .   OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.   . END.
     3957           when 'Кол-во'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.qnty"   .   OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.   . END.
     3958           when 'Кол-во(пост.)'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.cli-qnty"   .   OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.   . END.
     3959           when 'С объекта'  then DO:   assign     sort-column-name = "( b-all_ord-doc-rcv.cli-type + ' ' + string(b-all_ord-doc-rcv.cli-code))"   .   OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.   . END.
     3960           when 'Цена (пост.)'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.price-cli"   .   OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.   . END.
     3961           when 'Цена (руб)'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.price-rubl"   .   OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.   . END.
     3962           when 'Артикул'  then DO:   assign     sort-column-name = "ub.ord-line-rcv.artic"   .   OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.   . END.
     3963           when 'Статус'  then DO:   assign     sort-column-name = "(IF (b-all_ord-doc-rcv.status_ = 'факт':U or b-all_ord-doc-rcv.status_ = 'закрыто':U)  THEN (b-all_ord-doc-rcv.status_ + string(b-all_ord-doc-rcv.flag_,+/-))  ELSE (b-all_ord-doc-rcv.status_) )"   .   OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.   . END.
     3964       otherwise do:
     3965         assign
     3966           sort-column-name = ""
     3967         .
     3968         OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     3969         if sort-labelbrowse-20 <> "" then do:
     3970           assign
     3971             cur-clmnbrowse-20:column-fgcolor = 0
     3972           .
     3973         end.
     3974         assign
     3975           cur-clmn-locbrowse-20 = ?
     3976         .
     3977       end.
     3978     end case.
     3979       if cur-clmn-locbrowse-20 <> ? then do:
     3980         if can-do( this-procedure:internal-entries, 'ch-clmnbrowse-20') then do:
     3981           run ch-clmnbrowse-20 in this-procedure (cur-clmn-locbrowse-20).
     3982         end.
     3983       end.
     3984     if p-recid <> ? then do:
     3985       reposition browse-20 to recid p-recid no-error.
     3986       apply "value-changed" to browse-20 in frame frame-h.
     3987     end.
     3988     apply "entry" to browse-20 in frame frame-h.
     3989   END PROCEDURE.
     3990   procedure re-open-query-srt-clmnbrowse-20:
     3991   if cur-clmnbrowse-20 = ? then do:
     3992      OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     3993   end.
     3994   else do:
     3995      assign re-querybrowse-20 = yes.
     3996      run sort-brbrowse-20
     3997        (input (if available b-all_ord-doc-rcv
     3998                then recid(b-all_ord-doc-rcv)
     3999                else ?
     4000               )
     4001        ).
     4002      assign re-querybrowse-20 = no.
     4003   end.
     4004   end.
     4005   def var sort-labelbrowse-12   as character no-undo .
     4006   def var sort-clmnbrowse-12    as handle    no-undo .
     4007   def var cur-clmnbrowse-12     as handle    no-undo .
     4008   def var cur-clmn-locbrowse-12 as integer   no-undo .
     4009   def var re-querybrowse-12     as logical   initial no no-undo .
     4010   on start-search, ctrl-o of browse-12 in frame frame-a do:
     4011      run sort-brbrowse-12
     4012        (input (if available tt-goods
     4013                then recid(tt-goods)
     4014                else ?
     4015               )
     4016        ).
     4017   end.
     4018   PROCEDURE sort-brbrowse-12 :
     4019     define input parameter p-recid as recid no-undo .
     4020     if re-querybrowse-12 = no then do:
     4021       assign
     4022          cur-clmnbrowse-12 = browse-12:current-column in frame frame-a
     4023       .
     4024       if sort-clmnbrowse-12 <> ? then sort-clmnbrowse-12:column-fgcolor = 0.
     4025       if cur-clmnbrowse-12 = sort-clmnbrowse-12 then do:
     4026         assign
     4027            sort-labelbrowse-12 = ""
     4028            sort-clmnbrowse-12 = ?
     4029         .
     4030        end.
     4031        else do:
     4032          assign
     4033            sort-labelbrowse-12 = cur-clmnbrowse-12:label
     4034            sort-clmnbrowse-12  = cur-clmnbrowse-12
     4035            sort-clmnbrowse-12:column-fgcolor = 4
     4036          .
     4037        end.
     4038      end.
     4039     assign
     4040       cur-clmn-locbrowse-12 = 1
     4041     .
     4042     def var column-handle as handle no-undo .
     4043     column-handle = browse-12:first-column.
     4044     do while valid-handle(column-handle) :
     4045       if column-handle = cur-clmnbrowse-12 then do:
     4046         leave .
     4047       end.
     4048       column-handle = column-handle:NEXT-COLUMN.
     4049       assign
     4050         cur-clmn-locbrowse-12 = cur-clmn-locbrowse-12 + 1
     4051       .
     4052     end.
     4053     case sort-labelbrowse-12:
     4054           when tt-goods.use:label in browse browse-12 then DO:   assign     sort-column-name = "tt-goods.use"   .   OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.   . END.
     4055           when tt-goods.artic:label in browse browse-12 then DO:   assign     sort-column-name = "tt-goods.artic"   .   OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.   . END.
     4056           when tt-goods.gds-name:label in browse browse-12 then DO:   assign     sort-column-name = "tt-goods.gds-name"   .   OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.   . END.
     4057           when tt-goods.sum-qnty:label in browse browse-12 then DO:   assign     sort-column-name = "tt-goods.sum-qnty"   .   OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.   . END.
