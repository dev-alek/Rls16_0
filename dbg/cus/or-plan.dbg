     4090   procedure re-open-query-srt-clmnbrowse-12:
     4091   if cur-clmnbrowse-12 = ? then do:
     4092      OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.
     4093   end.
     4094   else do:
     4095      assign re-querybrowse-12 = yes.
     4096      run sort-brbrowse-12
     4097        (input (if available tt-goods
     4098                then recid(tt-goods)
     4099                else ?
     4100               )
     4101        ).
     4102      assign re-querybrowse-12 = no.
     4103   end.
