     4122   def var jjbrowse-18           as int no-undo.
     4123   do varmvibrowse-18 = 1 to EXTENT(cur-clmn-numbrowse-18):
     4124     ASSIGN cur-clmn-numbrowse-18[varmvibrowse-18] = varmvibrowse-18.
     4125   END.
