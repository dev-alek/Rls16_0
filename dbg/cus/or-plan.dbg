     8495                   hide FRAME FRAME-k.
     8496                  OPEN QUERY BROWSE-26 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ФП':U and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code and ub.ord-doc.cli-type = buf_clients.obj-type))  NO-LOCK,       FIRST ub.shar-buf_ord-doc WHERE shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code NO-LOCK.    OPEN QUERY BROWSE-27 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-code = loc-num-ord-FP and ub.ord-doc-rcv.doc-type = 'out':U       and ub.ord-doc-rcv.cons-code = loc-ord-cons-code  NO-LOCK.
     8497                  apply "VALUE-CHANGED":U to BROWSE-12 in frame frame-a.
     8498                   end.
     8499           if frame FRAME-b:visible then do:
     8500                   view FRAME FRAME-h.
     8501                  OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.    OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     8502                   hide FRAME FRAME-i.
     8503                  OPEN QUERY BROWSE-23 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-type = 'in'  AND ub.ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK.    OPEN QUERY BROWSE-24 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.doc-type = 'in' and             b-all_ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                  and            ub.ord-chain.rel-doc-type = 'trn' NO-LOCK,              EACH ub.trn-doc WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     8504           end.
     8505           if frame FRAME-postavki:visible then do:
     8506                    BROWSE-21:title = "Все Поставки по СЗФП" .
     8507                     OPEN QUERY BROWSE-21 FOR EACH new-rcv       WHERE new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH bb_ord-doc WHERE new-rcv.doc-code = bb_ord-doc.doc-code  OUTER-JOIN NO-LOCK.
     8508                     OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.
     8509                 apply "VALUE-CHANGED":U to BROWSE-12 in frame frame-a.
     8510                 apply "VALUE-CHANGED":U to BROWSE-13 in frame frame-d.
     8511           end.
     8512   end.
     8513   end.
     8514   END PROCEDURE.
     8515   PROCEDURE read-handle :
     8516    do
     8517    on error undo, return error return-value
     8518    :
     8519   define input parameter  h-browse as handle no-undo .
     8520   define output parameter str-summh as character no-undo .
     8521   define variable   h-temp as handle no-undo .
     8522   define variable h-l as handle no-undo .
     8523   define variable kk as integer no-undo .
     8524    h-temp  =  h-browse:first-column no-error .
     8525     if  h-browse <> ?   and valid-handle(h-browse) and
     8526         h-temp   <> ?   and valid-handle(h-temp)
     8527        then do:
     8528       str-summh =  string( h-temp  )  + "," .
     8529       do kk = 2 to ( h-browse:NUM-COLUMNS  )   :
     8530           str-summh = str-summh + string( h-temp:next-column  )  + ","  no-error .
     8531           if error-status :error then message "Ошибка 1 " error-status :get-message(1) .
     8532           if h-temp:next-column <> ? then do:
     8533               h-temp = h-temp:next-column no-error .
     8534               if error-status :error then message  "Ошибка 2 " error-status :get-message(1) .
     8535           end.
     8536       end.
     8537    end.
     8538   end.
     8539   END PROCEDURE.
     8540   PROCEDURE show-gds :
     8541   do
     8542    on error undo, return error return-value
     8543    :
     8544     define buffer buf_goods for ub.goods.
     8545     if not available tt-goods then  return no-apply.
     8546     find first buf_goods where buf_goods.gds-code = tt-goods.gds-code no-lock no-error .
     8547     if not available buf_goods then  return no-apply.
     8548     run str/showgds.p ( input parparentproc
     8549                        ,input ?
     8550                        ,input  buf_goods.gds-code
     8551                        ,input  'ПРОСМОТР':U ).
     8552     apply "entry" to browse-12 in frame frame-a.
     8553   end.
     8554   END PROCEDURE.
     8555   PROCEDURE status-isk :
     8556   do
     8557    on error undo, return error return-value
     8558    :
     8559   define variable t-rec as recid no-undo.
     8560   define buffer b_ord-line for ub.ord-line.
     8561   define buffer b_tt-goods for tt-goods.
     8562   define buffer b_ord-gds-cons for ub.ord-gds-cons.
     8563   define variable tt-qnty like tt-goods.sum-qnty  no-undo.
     8564   define variable t-ret as logical no-undo .
     8565   find current  ub.ord-doc no-lock no-error .
     8566     if NOT available  ub.ord-doc Then do:
     8567         message "Не выбрана заявка !!!" .
     8568         return.
     8569         end.
     8570     g#log = no.
     8571     message "Исключить заявку №" ub.ord-doc.doc-code "?   Вы уверены ?"
     8572         view-as alert-box question buttons OK-Cancel update g#log.
     8573     if g#log = false then return.
     8574     t-ret =  session:SET-WAIT-STATE("GENERAL") .
     8575     find current ub.ord-doc exclusive-lock.
     8576         assign
     8577         ub.ord-doc.cons-code = ""
     8578         ub.ord-doc.status_= 'согласование':U
     8579         ub.ord-doc.fact-date = ?
     8580       .
     8581     find current ub.ord-doc no-lock .
     8582         for each b_ord-line no-lock  where
     8583                  b_ord-line.doc-code = ub.ord-doc.doc-code
     8584                  :
     8585             for each b_tt-goods  exclusive-lock  where
     8586                     b_tt-goods.artic     = b_ord-line.artic     and
     8587                     b_tt-goods.prod-code = b_ord-line.prod-code and
     8588                     b_tt-goods.prod-type = b_ord-line.prod-type
     8589                     :
     8590                 find first b_ord-gds-cons  exclusive-lock  where
     8591                           b_ord-gds-cons.cons-code = loc-ord-cons-code    and
     8592                           b_ord-gds-cons.artic     = b_ord-line.artic     and
     8593                           b_ord-gds-cons.prod-code = b_ord-line.prod-code and
     8594                           b_ord-gds-cons.prod-type = b_ord-line.prod-type
     8595                           no-error .
     8596                 tt-qnty = b_tt-goods.sum-qnty - b_ord-line.qnty.
     8597                 if tt-qnty <= 0 then do:
     8598                                      delete b_tt-goods.
     8599                                      delete b_ord-gds-cons.
     8600                                      end.
     8601                                 else do:
     8602                                  assign
     8603                                     b_ord-gds-cons.sum-qnty = tt-qnty
     8604                                     b_tt-goods.sum-qnty = tt-qnty
     8605                                     t-rec = recid(b_tt-goods)
     8606                                   .
     8607                                   end.
     8608             end.
     8609         end.
     8610       OPEN QUERY BROWSE-16 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK     BY ub.ord-doc.obj-type        BY ub.ord-doc.obj-code         BY ub.ord-doc.ship-date          BY ub.ord-doc.ship-time           BY ub.ord-doc.doc-code DESCENDING.
     8611       OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.
     8612       reposition BROWSE-12 to recid t-rec no-error.
     8613       t-ret =  session:SET-WAIT-STATE("") .
     8614   end.
     8615   END PROCEDURE.
     8616   PROCEDURE status-rej :
     8617   do
     8618    on error undo, return error return-value
     8619    :
     8620   define variable t-rec as recid no-undo.
     8621   define buffer b_ord-line for ub.ord-line.
     8622   define buffer b_tt-goods for tt-goods.
     8623   define buffer b_ord-gds-cons for ub.ord-gds-cons.
     8624   define variable tt-qnty like tt-goods.sum-qnty  no-undo.
     8625   define variable t-ret as logical no-undo .
     8626   find current  ub.ord-doc no-lock no-error .
     8627     if NOT available  ub.ord-doc Then do:
     8628         message "Не выбрана заявка !!!" .
     8629         return.
     8630         end.
     8631     g#log = no.
     8632     message "Отказать заявке №" ub.ord-doc.doc-code "?   Вы уверены ?"
     8633         view-as alert-box question buttons OK-Cancel update g#log.
     8634     if g#log = false then return.
     8635     t-ret =  session:SET-WAIT-STATE("GENERAL") .
     8636     find current ub.ord-doc exclusive-lock.
     8637         assign
     8638         ub.ord-doc.cons-code = ub.ord-doc.cons-code + 'отказ':U
     8639         ub.ord-doc.status_= 'отказ':U
     8640         ub.ord-doc.fact-date = to-day
     8641       .
     8642     find current ub.ord-doc no-lock .
     8643         for each b_ord-line no-lock  where
     8644                  b_ord-line.doc-code = ub.ord-doc.doc-code
     8645                  :
     8646             for each b_tt-goods  exclusive-lock  where
     8647                     b_tt-goods.artic     = b_ord-line.artic     and
     8648                     b_tt-goods.prod-code = b_ord-line.prod-code and
     8649                     b_tt-goods.prod-type = b_ord-line.prod-type
     8650                     :
     8651                 find first b_ord-gds-cons  exclusive-lock  where
     8652                           b_ord-gds-cons.cons-code = loc-ord-cons-code    and
     8653                           b_ord-gds-cons.artic     = b_ord-line.artic     and
     8654                           b_ord-gds-cons.prod-code = b_ord-line.prod-code and
     8655                           b_ord-gds-cons.prod-type = b_ord-line.prod-type
     8656                           no-error .
     8657                 tt-qnty = b_tt-goods.sum-qnty - b_ord-line.qnty.
     8658                 if tt-qnty <= 0 then do:
     8659                                      delete b_tt-goods.
     8660                                      delete b_ord-gds-cons.
     8661                                      end.
     8662                                 else do:
     8663                                  assign
     8664                                     b_ord-gds-cons.sum-qnty = tt-qnty
     8665                                     b_tt-goods.sum-qnty = tt-qnty
     8666                                     t-rec = recid(b_tt-goods)
     8667                                   .
     8668                                   end.
     8669             end.
     8670         end.
     8671       OPEN QUERY BROWSE-16 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK     BY ub.ord-doc.obj-type        BY ub.ord-doc.obj-code         BY ub.ord-doc.ship-date          BY ub.ord-doc.ship-time           BY ub.ord-doc.doc-code DESCENDING.
     8672       OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.
     8673       reposition BROWSE-12 to recid t-rec no-error.
     8674       t-ret =  session:SET-WAIT-STATE("") .
     8675   end.
     8676   END PROCEDURE.
     8677   PROCEDURE zakaz-1 :
     8678   do
     8679    on error undo, return error return-value
     8680    :
     8681     define variable  o-rec as recid no-undo.
     8682      run make-fp in this-procedure ( input "1" , output o-rec ) no-error .
     8683        if BROWSE-18:visible   in frame frame-j then do: OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             . end.
     8684        if BROWSE-26:visible   in frame frame-k then do: OPEN QUERY BROWSE-26 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ФП':U and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code and ub.ord-doc.cli-type = buf_clients.obj-type))  NO-LOCK,       FIRST ub.shar-buf_ord-doc WHERE shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code NO-LOCK. end.
     8685        If o-rec <> ? then dO:
     8686          if BROWSE-26:visible   in frame frame-k then do: reposition BROWSE-26 to recid o-rec no-error . end.
     8687          if BROWSE-18:visible   in frame frame-j then do: reposition BROWSE-18 to recid o-rec no-error . end.
     8688      end.
     8689    end.
     8690   END PROCEDURE.
     8691   PROCEDURE zakaz-1-of :
     8692    do
     8693    on error undo, return error return-value
     8694    :
     8695   define buffer bbb_ord-line for ub.ord-line .
     8696   define buffer bbb_ord-doc  for ub.ord-doc .
     8697     define variable  o-rec as recid no-undo.
     8698     run make-fp in this-procedure ( input "3" , output o-rec).
     8699     OPEN QUERY BROWSE-26 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ФП':U and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code and ub.ord-doc.cli-type = buf_clients.obj-type))  NO-LOCK,       FIRST ub.shar-buf_ord-doc WHERE shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code NO-LOCK.
     8700     reposition BROWSE-26 to recid o-rec no-error .
     8701   end.
     8702   END PROCEDURE.
     8703   PROCEDURE zakaz-2 :
     8704   do
     8705    on error undo, return error return-value
     8706    :
     8707   define variable  o-rec as recid no-undo.
     8708     run make-fp in this-procedure ( input "2", output o-rec ).
     8709     OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .
     8710     reposition BROWSE-18 to recid o-rec no-error .
     8711     end.
     8712   END PROCEDURE.
     8713   PROCEDURE zayvka :
     8714   define input parameter  t-type as character no-undo .
     8715   do
     8716    on error undo, return error return-value
     8717    :
     8718   define variable v-par-prt as logical no-undo .
     8719   define variable P-ACTION as character no-undo .
     8720   find current ub.ord-doc exclusive-lock no-error .
     8721   if available  ub.ord-doc and ub.ord-doc.doc-type = g#type Then do:
     8722       find first shar-buf_ord-doc no-lock   where shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code no-error  .
     8723         bf-handle = buffer shar-buf_ord-doc:handle .
     8724         if t-type <> "lkp" then do:
     8725            if t-type = "add" then P-ACTION = 'ДОБАВЛЕНИЕ':U .
     8726                              else P-ACTION = 'ИЗМЕНЕНИЕ':U .
     8727             run cus/ord-zakz.p
     8728             (     input   parparentproc ,
     8729                   input   p-action      ,
     8730                   input   g#type ,
     8731                   output  doc-rec      ,
     8732                   input-output  br-handle ,
     8733                   input-output  bf-handle ,
     8734                   input-output  next-prev
     8735                       ) .
     8736             run calc-cons-ord in this-procedure .
     8737         end.
     8738         else do:
     8739             next-prev = no.
     8740             do while next-prev <> ?:
     8741               if not available ub.ord-doc then do:
     8742                 message "Неправильный выбор документа.".
     8743                 return no-apply.
     8744               end.
     8745               run cus/ord-zakz.p
     8746               (   input   parparentproc ,
     8747                   input   'ПРОСМОТР':U     ,
     8748                   input   g#type        ,
     8749                   output  doc-rec       ,
     8750                   input-output  br-handle ,
     8751                   input-output  bf-handle ,
     8752                   input-output  next-prev
     8753                   ) .
     8754             end.
     8755         end.
     8756   end.
     8757   end.
     8758   END PROCEDURE.
     8759   FUNCTION mark-string RETURNS CHARACTER
     8760     ( buffer loc-t-doc_ord-line for tt-new-ord-line ) :
     8761     if can-do (del-list, string (recid (loc-t-doc_ord-line))) then RETURN "+".
     8762     RETURN "".
     8763   END FUNCTION.
