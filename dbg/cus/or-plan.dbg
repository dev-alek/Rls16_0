      125   procedure proc-alt-shift-f2:
      126     if not ibs.th.gbl.gbl-var:rcode
      127   then
      128     run gbl\inidebug.p .
      129   end.
      130   procedure proc-alt-shift-f3:
      131     run gbl/prvssinf.p
      132       ( input this-procedure
      133       ) .
      134   end.
      135   define variable v-inform-launched as logical no-undo initial false .
      136   procedure proc-alt-shift-f4:
      137     define variable v-action as character no-undo .
      138     if v-inform-launched = false then do:
      139       assign
      140         v-inform-launched = true
      141       .
      142       run gbl/d-inform.w
      143         (  input self
      144         ,  input this-procedure
      145         , output v-action
      146         ) no-error .
      147       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      148       assign
      149         v-inform-launched = false
      150       .
      151     end.
      152   end.
      153   procedure proc-alt-f1:
      154     run gbl/corrhelp.p
      155       (input this-procedure
      156       ) .
      157   end .
      158   on alt-shift-f2 anywhere do:
      159     run proc-alt-shift-f2.
      160   end.
      161   on alt-shift-f3 anywhere do:
      162     run proc-alt-shift-f3 in this-procedure .
      163   end.
      164   on alt-shift-f4 anywhere do:
      165     run proc-alt-shift-f4 in this-procedure.
      166   end.
      167   on alt-f1 anywhere do:
      168     run proc-alt-f1 in this-procedure .
      169   end.
