      625   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626   procedure proc-ord-code :
      627   define input  parameter  p-type as character no-undo .
      628   define input  parameter  v-cntxt-db-num   as integer   no-undo .
      629   define input  parameter  v-cntxt-obj-type as character no-undo .
      630   define input  parameter  v-cntxt-obj-code as integer   no-undo .
      631   define input  parameter  p-i-doc    as character no-undo .
      632   define output parameter  p-ord-doc  as character no-undo .
      633   define variable          v-idop     as character no-undo .
      634     do
      635     on error undo, return error return-value
      636     :
      637   case p-type :
      638       when "main-no-ver" then do:
      639         if  (v-cntxt-db-num <> 0) then
      640           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      641         else
      642           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      643       end.
      644       when "main" then do:
      645             do while true:
      646             if  (v-cntxt-db-num <> 0) then
      647               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
      648             else
      649               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
      650             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
      651             End.
      652       end.
      653       when "chip" then do:
      654         assign
      655           v-idop = p-i-doc .
      656         do while true :
      657           if index (v-idop , ".") = 0 then
      658             v-idop  = replace (v-idop , "-", "-1.").
      659           else
      660             v-idop  =
      661             substring (v-idop , 1, index (v-idop, "-")) +
      662             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
      663             substring (v-idop, index (v-idop, ".")).
      664           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
      665         end.
      666         assign
      667           p-ord-doc = v-idop.
      668       end.
      669   end case.
      670     end.
      671   end procedure.
