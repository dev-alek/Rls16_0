     1678   ON VALUE-CHANGED OF BROWSE-13 IN FRAME FRAME-D
     1679   DO:
     1680        if frame FRAME-postavki:visible and avail ub.ord-doc and not T-of  then do:
     1681         BROWSE-29:title = "Арт."  + x-artic  + " заявка "
     1682        + ub.ord-doc.doc-code + " " + ub.ord-doc.obj-type + string(ub.ord-doc.obj-code).
     1683         OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.
     1684    end.
