     1774   ON CHOOSE OF BUTTON-21 IN FRAME FRAME-I
     1775   DO:
     1776   if available ub.trn-doc
     1777   then do:
     1778     case ub.trn-doc.doc-type
     1779     :
     1780       when 'при':U
     1781       then do:
     1782   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1783   do:
     1784     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1785       (input  v-cntxt-db-num
     1786       ,input  v-cntxt-userid
     1787       ,input  0
     1788       ,input  'actn_income_lookup':U
     1789       ,input  'object':U
     1790       ,input  ub.trn-doc.host-code
     1791       ,input  ub.trn-doc.obj-type
     1792       ,input  ub.trn-doc.obj-code
     1793       ,input  0
     1794       ,input  0
     1795       ,input  0
     1796       ,input  true
     1797       ,output g#log
     1798       )  .
     1799   end.
     1800       end.
     1801       when 'рас':U
     1802       then do:
     1803   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1804   do:
     1805     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1806       (input  v-cntxt-db-num
     1807       ,input  v-cntxt-userid
     1808       ,input  0
     1809       ,input  'actn_expense_lookup':U
     1810       ,input  'object':U
     1811       ,input  ub.trn-doc.host-code
     1812       ,input  ub.trn-doc.obj-type
     1813       ,input  ub.trn-doc.obj-code
     1814       ,input  0
     1815       ,input  0
     1816       ,input  0
     1817       ,input  true
     1818       ,output g#log
     1819       )  .
     1820   end.
     1821       end.
     1822       when 'спи':U
     1823       then do:
     1824   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1825   do:
     1826     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1827       (input  v-cntxt-db-num
     1828       ,input  v-cntxt-userid
     1829       ,input  0
     1830       ,input  'actn_write-off_lookup':U
     1831       ,input  'object':U
     1832       ,input  ub.trn-doc.host-code
     1833       ,input  ub.trn-doc.obj-type
     1834       ,input  ub.trn-doc.obj-code
     1835       ,input  0
     1836       ,input  0
     1837       ,input  0
     1838       ,input  true
     1839       ,output g#log
     1840       )  .
