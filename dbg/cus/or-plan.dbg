     1963   define variable v-doc-mode as character no-undo .
     1964     if avail  ub.ord-line-rcv then do:
     1965        find first ub.ord-doc-rcv no-lock where ub.ord-doc-rcv.rcv-code = ub.ord-line-rcv.rcv-code and
     1966                                             ub.ord-doc-rcv.doc-code = ub.ord-line-rcv.doc-code no-error .
     1967        if available  ub.ord-doc-rcv and ub.ord-doc-rcv.status_ = 'новый':U then do:
     1968           v-doc-mode  = 'ИЗМЕНЕНИЕ':U .
     1969           run cus/or-obj.w
     1970                ( input  parParentProc
     1971                , input  ub.ord-doc-rcv.host-code
     1972                , input  recid(ord-line-rcv)
     1973                , input  2
     1974                , input  'ИЗМЕНЕНИЕ':U
     1975                , input  'ИЗМЕНЕНИЕ':U
     1976                , input-output  v-doc-mode  ) .
     1977           g#log = BROWSE-28:refresh() no-error .
     1978           run calc-cons-ord in this-procedure .
     1979        end.
     1980        else do:
     1981           if ub.ord-doc-rcv.status_ = 'согласование':U
     1982               then
     1983                   message "Статус поставки " ub.ord-doc-rcv.status_ ". Корректировать нельзя ."
