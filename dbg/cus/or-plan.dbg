     2202       OPEN QUERY BROWSE-22 for each ub.ord-chain no-lock where         ub.ord-chain.doc-code = new-rcv.rcv-code and         ub.ord-chain.doc-type = 'rcv'            and         ub.ord-chain.rel-doc-type = 'trn',        EACH ub.trn-doc       WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK .
