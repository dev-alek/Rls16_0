     1842       end.
     1843       when 'инв':U
     1844       then do:
     1845   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1846   do:
     1847     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1848       (input  v-cntxt-db-num
     1849       ,input  v-cntxt-userid
     1850       ,input  0
     1851       ,input  'actn_inventory_lookup':U
     1852       ,input  'object':U
     1853       ,input  ub.trn-doc.host-code
     1854       ,input  ub.trn-doc.obj-type
     1855       ,input  ub.trn-doc.obj-code
     1856       ,input  0
     1857       ,input  0
     1858       ,input  0
     1859       ,input  true
     1860       ,output g#log
     1861       )  .
     1862   end.
     1863       end.
     1864       when 'возврат':U
     1865       then do:
     1866   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1867   do:
     1868     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1869       (input  v-cntxt-db-num
     1870       ,input  v-cntxt-userid
     1871       ,input  0
     1872       ,input  'actn_return_lookup':U
     1873       ,input  'object':U
