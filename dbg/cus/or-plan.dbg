     4357     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4358     DO varmvibrowse-20 = 1 TO EXTENT(cur-clmn-numbrowse-20):
     4359       if cur-clmn-numbrowse-20[varmvibrowse-20] = source-column THEN cur-clmn-numbrowse-20[varmvibrowse-20] = -1.
     4360     END.
     4361     if browse-20:MOVE-COLUMN(source-column, target-column) IN FRAME frame-h then.
     4362     if source-column > target-column THEN
     4363     DO varmvjbrowse-20 = source-column - 1 to target-column BY -1:
     4364       DO varmvibrowse-20 = 1 TO EXTENT(cur-clmn-numbrowse-20):
     4365           if cur-clmn-numbrowse-20[varmvibrowse-20] = varmvjbrowse-20 THEN DO:
     4366             cur-clmn-numbrowse-20[varmvibrowse-20] = cur-clmn-numbrowse-20[varmvibrowse-20] + 1.
     4367           END.
     4368       END.
     4369     END.
     4370     ELSE
     4371     DO varmvjbrowse-20 = source-column + 1 to target-column:
     4372       DO varmvibrowse-20 = 1 TO EXTENT(cur-clmn-numbrowse-20):
     4373         if cur-clmn-numbrowse-20[varmvibrowse-20] = varmvjbrowse-20 THEN DO:
     4374           cur-clmn-numbrowse-20[varmvibrowse-20] = cur-clmn-numbrowse-20[varmvibrowse-20] - 1.
     4375         END.
     4376       END.
     4377     END.
     4378     DO varmvibrowse-20 = 1 TO EXTENT(cur-clmn-numbrowse-20):
     4379       if cur-clmn-numbrowse-20[varmvibrowse-20] = -1 THEN cur-clmn-numbrowse-20[varmvibrowse-20] = target-column.
     4380     END.
     4381   END PROCEDURE.
     4382   PROCEDURE ch-clmnbrowse-20:
     4383     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4384     if cur-clmn-loc <= 1 then do:
     4385       return .
     4386     end.
     4387     DO varmvibrowse-20 = 1 TO EXTENT(cur-clmn-numbrowse-20):
     4388       if cur-clmn-numbrowse-20[varmvibrowse-20] = cur-clmn-loc THEN move-elementbrowse-20 = varmvibrowse-20.
     4389     END.
     4390     RUN re-move-clmnbrowse-20 (cur-clmn-loc, 1).
     4391   END PROCEDURE.
     4392   PROCEDURE mv-brw-defaultbrowse-20:
     4393   def var old-session as logical no-undo.
     4394     old-session = SESSION:IMMEDIATE-DISPLAY.
     4395     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4396     do varmvlbrowse-20 = 1 to EXTENT(cur-clmn-numbrowse-20):
     4397       RUN re-move-clmnbrowse-20 (cur-clmn-numbrowse-20[varmvlbrowse-20], varmvlbrowse-20).
     4398     END.
     4399     RUN start-mv-clmnbrowse-20.
     4400     SESSION:IMMEDIATE-DISPLAY = old-session.
     4401   END PROCEDURE.
     4402   .
     4403   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4404   DEF VAR cur-clmn-numbrowse-29 as INT EXTENT 15 no-undo.
     4405   DEF VAR varmvibrowse-29       as INT no-undo.
     4406   DEF VAR varmvjbrowse-29       as INT no-undo.
     4407   DEF VAR varmvkbrowse-29       as INT no-undo.
     4408   DEF VAR varmvlbrowse-29       as INT no-undo.
     4409   DEF VAR move-elementbrowse-29 as INT no-undo.
     4410   def var jjbrowse-29           as int no-undo.
     4411   do varmvibrowse-29 = 1 to EXTENT(cur-clmn-numbrowse-29):
     4412     ASSIGN cur-clmn-numbrowse-29[varmvibrowse-29] = varmvibrowse-29.
     4413   END.
     4414   RUN start-mv-clmnbrowse-29.
     4415   PROCEDURE start-mv-clmnbrowse-29:
     4416   def var old-session as logical no-undo.
     4417      old-session = SESSION:IMMEDIATE-DISPLAY.
     4418      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4419      SESSION:IMMEDIATE-DISPLAY = old-session.
     4420   END.
     4421   ON ctrl-cursor-right OF BROWSE browse-29 do:
     4422     RUN re-move-clmnbrowse-29 ( 1, 15).
     4423   END.
     4424   ON ctrl-cursor-left OF BROWSE browse-29 do:
     4425     RUN re-move-clmnbrowse-29 (15, 1).
     4426   END.
     4427   PROCEDURE re-move-clmnbrowse-29:
     4428     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4429     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4430     DO varmvibrowse-29 = 1 TO EXTENT(cur-clmn-numbrowse-29):
     4431       if cur-clmn-numbrowse-29[varmvibrowse-29] = source-column THEN cur-clmn-numbrowse-29[varmvibrowse-29] = -1.
     4432     END.
     4433     if browse-29:MOVE-COLUMN(source-column, target-column) IN FRAME frame-postavki then.
     4434     if source-column > target-column THEN
     4435     DO varmvjbrowse-29 = source-column - 1 to target-column BY -1:
     4436       DO varmvibrowse-29 = 1 TO EXTENT(cur-clmn-numbrowse-29):
     4437           if cur-clmn-numbrowse-29[varmvibrowse-29] = varmvjbrowse-29 THEN DO:
     4438             cur-clmn-numbrowse-29[varmvibrowse-29] = cur-clmn-numbrowse-29[varmvibrowse-29] + 1.
     4439           END.
     4440       END.
     4441     END.
     4442     ELSE
     4443     DO varmvjbrowse-29 = source-column + 1 to target-column:
     4444       DO varmvibrowse-29 = 1 TO EXTENT(cur-clmn-numbrowse-29):
     4445         if cur-clmn-numbrowse-29[varmvibrowse-29] = varmvjbrowse-29 THEN DO:
     4446           cur-clmn-numbrowse-29[varmvibrowse-29] = cur-clmn-numbrowse-29[varmvibrowse-29] - 1.
     4447         END.
     4448       END.
     4449     END.
     4450     DO varmvibrowse-29 = 1 TO EXTENT(cur-clmn-numbrowse-29):
     4451       if cur-clmn-numbrowse-29[varmvibrowse-29] = -1 THEN cur-clmn-numbrowse-29[varmvibrowse-29] = target-column.
     4452     END.
     4453   END PROCEDURE.
     4454   PROCEDURE ch-clmnbrowse-29:
     4455     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4456     if cur-clmn-loc <= 1 then do:
     4457       return .
     4458     end.
     4459     DO varmvibrowse-29 = 1 TO EXTENT(cur-clmn-numbrowse-29):
     4460       if cur-clmn-numbrowse-29[varmvibrowse-29] = cur-clmn-loc THEN move-elementbrowse-29 = varmvibrowse-29.
     4461     END.
     4462     RUN re-move-clmnbrowse-29 (cur-clmn-loc, 1).
     4463   END PROCEDURE.
     4464   PROCEDURE mv-brw-defaultbrowse-29:
     4465   def var old-session as logical no-undo.
     4466     old-session = SESSION:IMMEDIATE-DISPLAY.
     4467     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4468     do varmvlbrowse-29 = 1 to EXTENT(cur-clmn-numbrowse-29):
     4469       RUN re-move-clmnbrowse-29 (cur-clmn-numbrowse-29[varmvlbrowse-29], varmvlbrowse-29).
     4470     END.
     4471     RUN start-mv-clmnbrowse-29.
     4472     SESSION:IMMEDIATE-DISPLAY = old-session.
     4473   END PROCEDURE.
     4474   .
     4475       WAIT-FOR GO OF FRAME Dialog-Frame.
     4476   END.
     4477   run disable_UI in this-procedure .
     4478   PROCEDURE att-rcv :
     4479   do
     4480    on error undo, return error return-value
     4481    :
     4482   define input parameter b-recid as recid no-undo .
     4483   define variable loc-ref-list as character no-undo .
     4484   define variable p-trn-code as character no-undo .
     4485   define buffer bub_ord-doc-rcv for ub.ord-doc-rcv .
     4486   define buffer loc_buf_ord-line-rcv for ub.ord-line-rcv .
     4487   define buffer loc_buf_doc-line for ub.doc-line .
     4488   find first bub_ord-doc-rcv  no-lock where recid( bub_ord-doc-rcv)  = b-recid no-error .
     4489   if not avail bub_ord-doc-rcv then do:
     4490     message  "Не выбрана поставка !!! " view-as alert-box .
     4491     return .
     4492   end.
     4493   if bub_ord-doc-rcv.status_ <> 'поставка':U then do:
     4494     message "Нельзя сделать накладную на поставку в статусе " caps(bub_ord-doc-rcv.status_) view-as alert-box .
     4495     return.
     4496   end.
     4497   define variable v-input-output as character no-undo .
     4498   run str/all-docs.w
     4499    ( input  parparentproc
     4500    ,input   bub_ord-doc-rcv.host-code
     4501    ,input   bub_ord-doc-rcv.obj-type
     4502    ,input   bub_ord-doc-rcv.obj-code
     4503    ,input  'фирма':U
     4504    ,input  ?
     4505    ,input  ?
     4506    ,input  ?
     4507    ,input  ?
     4508    ,input  "b-sel":U
     4509    ,input  ?
     4510    ,input  false
     4511    ,input  ?
     4512    ,output loc-ref-list
     4513    ).
     4514   if loc-ref-list = ? or loc-ref-list = ""  then return.
     4515     find first ub.trn-doc no-lock where recid(trn-doc) = int(loc-ref-list) no-error .
     4516     if available ub.trn-doc then  assign
     4517                                 p-trn-code = ub.trn-doc.doc-code
     4518                                 doc-rec = recid(trn-doc)
     4519                                 .
     4520                          else  assign
     4521                                p-trn-code = ?
     4522                          .
     4523   define variable  j-trn as integer no-undo .
     4524   define variable  j-rcv as integer no-undo .
     4525    j-trn = 0.
     4526    j-rcv = 0.
     4527    for each loc_buf_ord-line-rcv no-lock where loc_buf_ord-line-rcv.doc-code =  bub_ord-doc-rcv.doc-code and
     4528                                                loc_buf_ord-line-rcv.rcv-code =  bub_ord-doc-rcv.rcv-code :
     4529       j-rcv = j-rcv + 1.
     4530       if can-find (first loc_buf_doc-line where loc_buf_doc-line.doc-code = ub.trn-doc.doc-code and
     4531                          loc_buf_ord-line-rcv.artic =  loc_buf_doc-line.artic and
     4532                          loc_buf_ord-line-rcv.prod-type =  loc_buf_doc-line.prod-type and
     4533                          loc_buf_ord-line-rcv.prod-code =  loc_buf_doc-line.prod-code no-lock  ) Then j-trn = j-trn + 1.
     4534    end.
     4535    if j-rcv > j-trn then do:
     4536     message  "Совпадение списка товаров  в выбранной накладной " (J-trn / j-rcv ) * 100  " %  ! "
     4537       skip "Делаем привязку ?"
     4538       view-as alert-box  Question
     4539       buttons yes-no update g#log .
     4540     if not g#log  then return .
     4541     end.
     4542     run create-chain (
     4543     bub_ord-doc-rcv.rcv-code
     4544     ,'rcv'
     4545     ,p-trn-code
     4546     ,'trn'
     4547     ,''
     4548     ,''
     4549     ).
     4550     run calc-cons-ord In This-procedure .
     4551   end.
     4552   END PROCEDURE.
     4553   PROCEDURE br-12 :
     4554   do
     4555    on error undo, return error return-value
     4556    :
     4557   define variable p-recid as recid no-undo .
     4558   if avail tt-goods then do:
     4559       assign
     4560       x-artic       = tt-goods.artic
     4561       x-prod-type   = tt-goods.prod-type
     4562       x-prod-code   = tt-goods.prod-code
     4563       x-node-code    = string(tt-goods.node-code)
     4564       str-good = x-artic + " " + tt-goods.gds-name  + " (" + tt-goods.prt-name + ")"  .
     4565       if tt-goods.gds-t = 'товар':U then assign
     4566        x-node-code = "*"
     4567        str-good = x-artic + " " + tt-goods.gds-name      .
     4568        p-recid = recid(tt-goods).
     4569    end.
     4570   else do:
     4571     message "Совокупная Заявка пуста ! " view-as alert-box .
     4572     return error.
     4573   end.
     4574    display str-good with frame Dialog-Frame.
     4575    IF frame FRAME-d:visible  Then do:
     4576        OPEN QUERY BROWSE-13 FOR EACH ub.m_ord-line       WHERE x-artic      = m_ord-line.artic and x-prod-type  = m_ord-line.prod-type and x-prod-code  = m_ord-line.prod-code  NO-LOCK,       EACH ub.ord-doc WHERE ub.ord-doc.doc-code = m_ord-line.doc-code       AND ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK.
     4577        apply "VALUE-CHANGED":U to BROWSE-13 in frame frame-D .
     4578         OPEN QUERY BROWSE-14 FOR EACH my-obj NO-LOCK,              EACH buf_gds-obj where              my-obj.obj-code = buf_gds-obj.obj-code and                       my-obj.obj-type = buf_gds-obj.obj-type and                   x-artic      = buf_gds-obj.artic     and             x-prod-type  = buf_gds-obj.prod-type and             x-prod-code  = buf_gds-obj.prod-code       NO-LOCK.
     4579         OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.    OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     4580   end.
     4581    IF frame FRAME-d-prt:visible  Then do:
     4582        OPEN QUERY BROWSE-31 FOR EACH ub.of_ord-dtl       WHERE x-artic      = of_ord-dtl.artic and x-prod-type  = of_ord-dtl.prod-type and x-prod-code  = of_ord-dtl.prod-code and string(of_ord-dtl.node-code) MATCHES x-node-code NO-LOCK,       EACH ub.of_ord-doc OF ub.of_ord-dtl       WHERE of_ord-doc.cons-code = loc-ord-cons-code and of_ord-doc.doc-type = 'ОФ':U NO-LOCK,       EACH ub.gds-prt WHERE ub.gds-prt.node-code = of_ord-dtl.node-code NO-LOCK.
     4583        apply "VALUE-CHANGED":U to BROWSE-31 in frame frame-D-prt .
     4584   end.
     4585   IF frame FRAME-E:visible  Then do:
     4586     if t-prt = false then do:
     4587         if not  t-cli then do:
     4588           OPEN QUERY BROWSE-17 FOR EACH ub.buf_clients       WHERE ( buf_clients.sup-cons = true  OR buf_clients.sup-gds = true ) NO-LOCK,       FIRST ub.cli-gds WHERE ub.cli-gds.cli-code = buf_clients.obj-code   AND ub.cli-gds.cli-type = buf_clients.obj-type       AND ub.cli-gds.artic = x-artic and cli-gds.prod-type = x-prod-type and ub.cli-gds.host-code = g#host-code and cli-gds.prod-code = x-prod-code  NO-LOCK.
     4589           OPEN QUERY BROWSE-17 FOR EACH ub.buf_clients       WHERE ( buf_clients.sup-cons = true  OR buf_clients.sup-gds = true ) NO-LOCK,       FIRST ub.cli-gds WHERE ub.cli-gds.cli-code = buf_clients.obj-code   AND ub.cli-gds.cli-type = buf_clients.obj-type       AND ub.cli-gds.artic = x-artic and cli-gds.prod-type = x-prod-type and ub.cli-gds.host-code = g#host-code and cli-gds.prod-code = x-prod-code  NO-LOCK.
     4590           apply "VALUE-CHANGED":U to BROWSE-17 in frame frame-E .
     4591         end.
     4592     end.
     4593     if t-prt = true  then do:
     4594       OPEN QUERY BROWSE-32 FOR EACH e_fp_ord-dtl       WHERE x-artic      = e_fp_ord-dtl.artic and x-prod-type  = e_fp_ord-dtl.prod-type and x-prod-code  = e_fp_ord-dtl.prod-code and string(e_fp_ord-dtl.node-code) MATCHES x-node-code NO-LOCK,              EACH e_fp_ord-doc OF e_fp_ord-dtl where                        e_fp_ord-doc.cons-code = loc-ord-cons-code and                        e_fp_ord-doc.doc-type = 'ФП':U                       NO-LOCK,              first ub.gds-prt WHERE ub.gds-prt.node-code = e_fp_ord-dtl.node-code NO-LOCK.    OPEN QUERY BROWSE-33 FOR EACH e_fp_ord-dtl-rcv               WHERE x-artic      = e_fp_ord-dtl-rcv.artic and                     x-prod-type  = e_fp_ord-dtl-rcv.prod-type and                     x-prod-code  = e_fp_ord-dtl-rcv.prod-code and                     string(e_fp_ord-dtl-rcv.node-code) MATCHES x-node-code NO-LOCK,              EACH e_fp_ord-doc-rcv                              where e_fp_ord-doc-rcv.rcv-code            = e_fp_ord-dtl-rcv.rcv-code and                                               e_fp_ord-doc-rcv.doc-code     = e_fp_ord-dtl-rcv.doc-code and                        e_fp_ord-doc-rcv.cons-code  = loc-ord-cons-code and                        e_fp_ord-doc-rcv.doc-type    = "out":U                       NO-LOCK,              first ub.gds-prt WHERE ub.gds-prt.node-code = e_fp_ord-dtl-rcv.node-code NO-LOCK.
     4595       reposition browse-30 to recid p-recid no-error .
     4596     end.
     4597   end.
     4598   IF frame FRAME-J:visible  Then do:
     4599        BROWSE-18:title = "Заказы ФП по товару " + x-artic .
     4600        OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .
     4601        apply "VALUE-CHANGED":U to BROWSE-18 in frame frame-J .
     4602        BROWSE-28:title = "Поставки по товару " + x-artic .
     4603        OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     4604   end.
     4605   IF frame FRAME-B:visible  Then do:
     4606     if t-prt = false then do:
     4607         if not  t-obj then do:
     4608           OPEN QUERY BROWSE-14 FOR EACH my-obj NO-LOCK,              EACH buf_gds-obj where              my-obj.obj-code = buf_gds-obj.obj-code and                       my-obj.obj-type = buf_gds-obj.obj-type and                   x-artic      = buf_gds-obj.artic     and             x-prod-type  = buf_gds-obj.prod-type and             x-prod-code  = buf_gds-obj.prod-code       NO-LOCK.
     4609           OPEN QUERY BROWSE-14 FOR EACH my-obj NO-LOCK,              EACH buf_gds-obj where              my-obj.obj-code = buf_gds-obj.obj-code and                       my-obj.obj-type = buf_gds-obj.obj-type and                   x-artic      = buf_gds-obj.artic     and             x-prod-type  = buf_gds-obj.prod-type and             x-prod-code  = buf_gds-obj.prod-code       NO-LOCK.
     4610           apply "VALUE-CHANGED":U to BROWSE-14 in frame frame-B .
     4611         end.
     4612         if  t-obj then do:
     4613           OPEN QUERY BROWSE-14 FOR EACH my-obj  ,     EACH buf_gds-obj         WHERE x-artic = buf_gds-obj.artic     and          x-prod-type  = buf_gds-obj.prod-type and          x-prod-code  = buf_gds-obj.prod-code and          buf_gds-obj.obj-code = my-obj.obj-code and          buf_gds-obj.obj-type = my-obj.obj-type  OUTER-JOIN NO-LOCK.
     4614           apply "VALUE-CHANGED":U to BROWSE-14 in frame frame-B .
     4615         end.
     4616     end.
     4617     if t-prt = true then do:
     4618         OPEN QUERY BROWSE-36 FOR EACH obj_ord-dtl-rcv     WHERE x-artic      = obj_ord-dtl-rcv.artic and           x-prod-type  = obj_ord-dtl-rcv.prod-type and           x-prod-code  = obj_ord-dtl-rcv.prod-code and           string(obj_ord-dtl-rcv.node-code) MATCHES x-node-code NO-LOCK,            EACH obj_ord-doc-rcv           where obj_ord-doc-rcv.rcv-code     = obj_ord-dtl-rcv.rcv-code and                   obj_ord-doc-rcv.doc-code   = obj_ord-dtl-rcv.doc-code and                   obj_ord-doc-rcv.doc-type   = 'in' and                   obj_ord-doc-rcv.cons-code  = loc-ord-cons-code                  NO-LOCK,          first ub.gds-prt WHERE ub.gds-prt.node-code = obj_ord-dtl-rcv.node-code NO-LOCK.    OPEN QUERY BROWSE-37 FOR EACH obj_prt-obj               WHERE obj_prt-obj.is-term = true and                           x-artic      = obj_prt-obj.artic and                     x-prod-type  = obj_prt-obj.prod-type and                     x-prod-code  = obj_prt-obj.prod-code and                     string(obj_prt-obj.prt-code) MATCHES x-node-code NO-LOCK,              each ub.gds-prt WHERE ub.gds-prt.node-code = obj_prt-obj.prt-code NO-LOCK.
     4619         reposition browse-30 to recid p-recid no-error .
     4620     end.
     4621   end.
     4622   IF frame FRAME-H:visible  Then do:
     4623        BROWSE-15:title = "Внутренние ПН по товару " + x-artic .
     4624        OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.
     4625        apply "VALUE-CHANGED":U to BROWSE-15 in frame frame-H .
     4626        BROWSE-20:title = "Поставки по товару " + x-artic .
     4627        OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     4628   end.
     4629   IF frame FRAME-postavki:visible  Then do:
     4630     if t-prt = true then do:
     4631         OPEN QUERY BROWSE-34 FOR EACH l_rcv_ord-dtl-rcv               WHERE x-artic      = l_rcv_ord-dtl-rcv.artic and                     x-prod-type  = l_rcv_ord-dtl-rcv.prod-type and                     x-prod-code  = l_rcv_ord-dtl-rcv.prod-code and                     string(l_rcv_ord-dtl-rcv.node-code) MATCHES x-node-code NO-LOCK,              EACH l_rcv_ord-doc-rcv             where l_rcv_ord-doc-rcv.rcv-code     = l_rcv_ord-dtl-rcv.rcv-code and                    l_rcv_ord-doc-rcv.doc-code   = l_rcv_ord-dtl-rcv.doc-code and                    l_rcv_ord-doc-rcv.cons-code  = loc-ord-cons-code                    NO-LOCK,              first ub.gds-prt WHERE ub.gds-prt.node-code = l_rcv_ord-dtl-rcv.node-code NO-LOCK.
     4632         OPEN QUERY BROWSE-35 FOR EACH l_rcv_gds-dtl     WHERE x-artic      = l_rcv_gds-dtl.artic and           x-prod-type  = l_rcv_gds-dtl.prod-type and           x-prod-code  = l_rcv_gds-dtl.prod-code and           string(l_rcv_gds-dtl.prt-code) MATCHES x-node-code NO-LOCK,              EACH l_rcv_trn-doc where             l_rcv_trn-doc.doc-code   = l_rcv_gds-dtl.doc-code NO-LOCK,              each ub.gds-prt WHERE            ub.gds-prt.node-code = l_rcv_gds-dtl.prt-code NO-LOCK.
     4633         reposition browse-30 to recid p-recid no-error .
     4634     end.
     4635   end.
     4636   end.
     4637   END PROCEDURE.
     4638   PROCEDURE calc-cons-ord :
     4639   do
     4640    on error undo, return error return-value
     4641    :
     4642   define buffer locb-ord-doc  for ub.ord-doc .
     4643   define buffer locb-ord-line for ub.ord-line .
     4644   define buffer locb-ord-dtl  for ub.ord-dtl .
     4645   define buffer locb-rcv-doc  for ub.ord-doc-rcv .
     4646   define buffer locb-rcv-line for ub.ord-line-rcv .
     4647   define buffer locb-rcv-dtl  for ub.ord-dtl-rcv .
     4648   define buffer locb-z-doc    for ub.ord-doc .
     4649   define buffer locb-z-line   for ub.ord-line .
     4650   define buffer locb-z-dtl    for ub.ord-dtl .
     4651   define buffer locb-t-doc    for ub.trn-doc .
     4652   define buffer locb-t-line   for ub.doc-line .
     4653   define buffer locb-t-dtl    for ub.gds-dtl  .
     4654   find current tt-goods no-error .
     4655   if avail tt-goods then gg-recid =  recid(tt-goods) .
     4656         for each tt-goods where tt-goods.gds-t = 'товар':U :
     4657             tt-goods.sum-ord  = 0.
     4658             for each  locb-ord-doc where locb-ord-doc.cons-code = loc-ord-cons-code   and
     4659                                         locb-ord-doc.doc-type  = 'ФП':U
     4660                                         no-lock  ,
     4661                 each locb-ord-line where locb-ord-doc.doc-code = locb-ord-line.doc-code  and
     4662                                             tt-goods.artic     = locb-ord-line.artic     and
     4663                                             tt-goods.prod-code = locb-ord-line.prod-code and
     4664                                             tt-goods.prod-type = locb-ord-line.prod-type
     4665                                             no-lock  :
     4666               assign
     4667                 tt-goods.sum-ord  = tt-goods.sum-ord + locb-ord-line.qnty
     4668               .
     4669             end.
     4670             tt-goods.sum-rcv  = 0 .
     4671             for each  locb-rcv-doc where locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4672                                         locb-rcv-doc.doc-type  = 'out':U
     4673                                         no-lock  ,
     4674                 each locb-rcv-line where locb-rcv-doc.doc-code = locb-rcv-line.doc-code  and
     4675                                           locb-rcv-doc.rcv-code = locb-rcv-line.rcv-code  and
     4676                                           tt-goods.artic        = locb-rcv-line.artic     and
     4677                                           tt-goods.prod-code    = locb-rcv-line.prod-code and
     4678                                           tt-goods.prod-type    = locb-rcv-line.prod-type
     4679                                           no-lock  :
     4680               assign
     4681                 tt-goods.sum-rcv  = tt-goods.sum-rcv + locb-rcv-line.qnty
     4682               .
     4683             end.
     4684             tt-goods.sum-rcv-in  = 0 .
     4685             for each  locb-z-doc no-lock where
     4686                                         locb-z-doc.cons-code = loc-ord-cons-code   and
     4687                                         locb-z-doc.doc-type  = 'ОФ':U
     4688                                         ,
     4689                 each locb-z-line no-lock where
     4690                                           locb-z-doc.doc-code = locb-z-line.doc-code    and
     4691                                           tt-goods.artic        = locb-z-line.artic     and
     4692                                           tt-goods.prod-code    = locb-z-line.prod-code and
     4693                                           tt-goods.prod-type    = locb-z-line.prod-type
     4694                                           ,
     4695                 each  locb-rcv-doc no-lock where
     4696                                         locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4697                                         locb-rcv-doc.doc-type  = "in":U              and
     4698                                         locb-rcv-doc.obj-code  = locb-z-doc.obj-code and
     4699                                         locb-rcv-doc.obj-type  = locb-z-doc.obj-type
     4700                                         ,
     4701                 each locb-rcv-line no-lock  where
     4702                                           locb-rcv-doc.doc-code = locb-rcv-line.doc-code  and
     4703                                           locb-rcv-doc.rcv-code = locb-rcv-line.rcv-code  and
     4704                                           tt-goods.artic        = locb-rcv-line.artic     and
     4705                                           tt-goods.prod-code    = locb-rcv-line.prod-code and
     4706                                           tt-goods.prod-type    = locb-rcv-line.prod-type
     4707                                           :
     4708               assign
     4709                 tt-goods.sum-rcv-in  = tt-goods.sum-rcv-in + locb-rcv-line.qnty
     4710               .
     4711             end.
     4712             for each  locb-z-doc no-lock where
     4713                                         locb-z-doc.cons-code = loc-ord-cons-code   and
     4714                                         locb-z-doc.doc-type  = 'ОФ':U
     4715                                         ,
     4716                 each locb-z-line no-lock where
     4717                                           locb-z-doc.doc-code = locb-z-line.doc-code    and
     4718                                           tt-goods.artic        = locb-z-line.artic     and
     4719                                           tt-goods.prod-code    = locb-z-line.prod-code and
     4720                                           tt-goods.prod-type    = locb-z-line.prod-type
     4721                                           ,
     4722                 each  locb-rcv-doc no-lock where
     4723                                         locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4724                                         locb-rcv-doc.doc-type  = "in":U              and
     4725                                         locb-rcv-doc.cli-code  = locb-z-doc.obj-code and
     4726                                         locb-rcv-doc.cli-type  = locb-z-doc.obj-type
     4727                                         ,
     4728                 each locb-rcv-line no-lock  where
     4729                                           locb-rcv-doc.doc-code = locb-rcv-line.doc-code  and
     4730                                           locb-rcv-doc.rcv-code = locb-rcv-line.rcv-code  and
     4731                                           tt-goods.artic        = locb-rcv-line.artic     and
     4732                                           tt-goods.prod-code    = locb-rcv-line.prod-code and
     4733                                           tt-goods.prod-type    = locb-rcv-line.prod-type
     4734                                           :
     4735               assign
     4736                 tt-goods.sum-rcv-in  = tt-goods.sum-rcv-in - locb-rcv-line.qnty
     4737               .
     4738             end.
     4739             tt-goods.sum-fact    = 0 .
     4740             for each  locb-rcv-doc no-lock where
     4741                       locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4742                       locb-rcv-doc.doc-type  = 'out':U
     4743                       ,
     4744                 each ub.ord-chain no-lock where
     4745                      ub.ord-chain.doc-code = locb-rcv-doc.rcv-code and
     4746                      ub.ord-chain.doc-type = 'rcv'                  and
     4747                      ub.ord-chain.rel-doc-type = 'trn'
     4748                      ,
     4749                 each locb-t-doc no-lock  where
     4750                      locb-t-doc.doc-code = ub.ord-chain.rel-doc-code
     4751                      ,
     4752                 each locb-t-line no-lock where
     4753                       locb-t-line.doc-code     = locb-t-doc.doc-code and
     4754                       locb-t-line.artic        = tt-goods.artic     and
     4755                       locb-t-line.prod-code    = tt-goods.prod-code and
     4756                       locb-t-line.prod-type    = tt-goods.prod-type :
     4757               assign
     4758                 tt-goods.sum-fact  = tt-goods.sum-fact + locb-t-line.fact-qnty
     4759               .
     4760             end.
     4761             for each  locb-rcv-doc no-lock where
     4762                       locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4763                       locb-rcv-doc.doc-type  = "in":U   ,
     4764                 each ub.ord-chain no-lock where
     4765                      ub.ord-chain.doc-code = locb-rcv-doc.rcv-code and
     4766                      ub.ord-chain.doc-type = 'rcv'                  and
     4767                      ub.ord-chain.rel-doc-type = 'trn'
     4768                      ,
     4769                 each locb-t-doc no-lock  where
     4770                       locb-t-doc.doc-code = ub.ord-chain.rel-doc-code  and
     4771                       locb-t-doc.doc-type = 'при':U  ,
     4772                 each locb-t-line no-lock where
     4773                       locb-t-doc.doc-code = locb-t-line.doc-code    and
     4774                       locb-t-line.artic        = tt-goods.artic     and
     4775                       locb-t-line.prod-code    = tt-goods.prod-code and
     4776                       locb-t-line.prod-type    = tt-goods.prod-type :
     4777               assign
     4778                 tt-goods.sum-fact  = tt-goods.sum-fact + locb-t-line.fact-qnty
     4779               .
     4780             end.
     4781          end.
     4782             for each tt-goods where tt-goods.gds-t <> 'товар':U :
     4783                 tt-goods.sum-ord  = 0.
     4784                 for each  locb-ord-doc where locb-ord-doc.cons-code = loc-ord-cons-code   and
     4785                                             locb-ord-doc.doc-type  = 'ФП':U
     4786                                             no-lock  ,
     4787                     each locb-ord-dtl where locb-ord-doc.doc-code = locb-ord-dtl.doc-code   and
     4788                                                 tt-goods.node-code = locb-ord-dtl.node-code and
     4789                                                 tt-goods.artic     = locb-ord-dtl.artic     and
     4790                                                 tt-goods.prod-code = locb-ord-dtl.prod-code and
     4791                                                 tt-goods.prod-type = locb-ord-dtl.prod-type
     4792                                                 no-lock  :
     4793                   assign
     4794                     tt-goods.sum-ord  = tt-goods.sum-ord + locb-ord-dtl.qnty
     4795                   .
     4796                 end.
     4797                 tt-goods.sum-rcv  = 0 .
     4798                 for each  locb-rcv-doc where locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4799                                             locb-rcv-doc.doc-type  = 'out':U
     4800                                             no-lock  ,
     4801                     each locb-rcv-dtl where locb-rcv-doc.doc-code   = locb-rcv-dtl.doc-code  and
     4802                                               locb-rcv-doc.rcv-code = locb-rcv-dtl.rcv-code  and
     4803                                               tt-goods.node-code    = locb-rcv-dtl.node-code and
     4804                                               tt-goods.artic        = locb-rcv-dtl.artic     and
     4805                                               tt-goods.prod-code    = locb-rcv-dtl.prod-code and
     4806                                               tt-goods.prod-type    = locb-rcv-dtl.prod-type
     4807                                               no-lock  :
     4808                   assign
     4809                     tt-goods.sum-rcv  = tt-goods.sum-rcv + locb-rcv-dtl.qnty
     4810                   .
     4811                 end.
     4812                 tt-goods.sum-rcv-in  = 0 .
     4813                 for each  locb-z-doc no-lock where
     4814                                             locb-z-doc.cons-code = loc-ord-cons-code   and
     4815                                             locb-z-doc.doc-type  = 'ОФ':U
     4816                                             ,
     4817                     each locb-z-dtl no-lock where
     4818                                               locb-z-doc.doc-code   = locb-z-dtl.doc-code  and
     4819                                               tt-goods.node-code    = locb-z-dtl.node-code and
     4820                                               tt-goods.artic        = locb-z-dtl.artic     and
     4821                                               tt-goods.prod-code    = locb-z-dtl.prod-code and
     4822                                               tt-goods.prod-type    = locb-z-dtl.prod-type
     4823                                               ,
     4824                     each  locb-rcv-doc no-lock where
     4825                                             locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4826                                             locb-rcv-doc.doc-type  = "in":U              and
     4827                                             locb-rcv-doc.obj-code  = locb-z-doc.obj-code and
     4828                                             locb-rcv-doc.obj-type  = locb-z-doc.obj-type
     4829                                             ,
     4830                     each locb-rcv-dtl no-lock  where
     4831                                               locb-rcv-dtl.doc-code  = locb-rcv-doc.doc-code and
     4832                                               locb-rcv-dtl.rcv-code  = locb-rcv-doc.rcv-code and
     4833                                               locb-rcv-dtl.node-code = tt-goods.node-code    and
     4834                                               locb-rcv-dtl.artic     = tt-goods.artic        and
     4835                                               locb-rcv-dtl.prod-code = tt-goods.prod-code    and
     4836                                               locb-rcv-dtl.prod-type = tt-goods.prod-type
     4837                                               :
     4838                   assign
     4839                     tt-goods.sum-rcv-in  = tt-goods.sum-rcv-in + locb-rcv-dtl.qnty
     4840                   .
     4841                 end.
     4842                 for each  locb-z-doc no-lock where
     4843                                             locb-z-doc.cons-code = loc-ord-cons-code   and
     4844                                             locb-z-doc.doc-type  = 'ОФ':U
     4845                                             ,
     4846                     each locb-z-dtl no-lock where
     4847                                               locb-z-doc.doc-code   = locb-z-dtl.doc-code  and
     4848                                               tt-goods.node-code    = locb-z-dtl.node-code and
     4849                                               tt-goods.artic        = locb-z-dtl.artic     and
     4850                                               tt-goods.prod-code    = locb-z-dtl.prod-code and
     4851                                               tt-goods.prod-type    = locb-z-dtl.prod-type
     4852                                               ,
     4853                     each  locb-rcv-doc no-lock where
     4854                                             locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4855                                             locb-rcv-doc.doc-type  = "in":U              and
     4856                                             locb-rcv-doc.cli-code  = locb-z-doc.obj-code and
     4857                                             locb-rcv-doc.cli-type  = locb-z-doc.obj-type
     4858                                             ,
     4859                     each locb-rcv-dtl no-lock  where
     4860                                               locb-rcv-dtl.doc-code  = locb-rcv-doc.doc-code and
     4861                                               locb-rcv-dtl.rcv-code  = locb-rcv-doc.rcv-code and
     4862                                               locb-rcv-dtl.node-code = tt-goods.node-code    and
     4863                                               locb-rcv-dtl.artic     = tt-goods.artic        and
     4864                                               locb-rcv-dtl.prod-code = tt-goods.prod-code    and
     4865                                               locb-rcv-dtl.prod-type = tt-goods.prod-type
     4866                                               :
     4867                   assign
     4868                     tt-goods.sum-rcv-in  = tt-goods.sum-rcv-in - locb-rcv-dtl.qnty
     4869                   .
     4870                 end.
     4871                 tt-goods.sum-fact    = 0 .
     4872                 for each  locb-rcv-doc no-lock where
     4873                           locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4874                           locb-rcv-doc.doc-type  = 'out':U,
     4875                     each ub.ord-chain no-lock where
     4876                           ub.ord-chain.doc-code = locb-rcv-doc.rcv-code and
     4877                           ub.ord-chain.doc-type = 'rcv'                 and
     4878                           ub.ord-chain.rel-doc-type = 'trn' ,
     4879                     each locb-t-doc no-lock  where
     4880                          locb-t-doc.doc-code = ub.ord-chain.rel-doc-code  ,
     4881                     each locb-t-dtl no-lock where
     4882                           locb-t-dtl.doc-code     = locb-t-doc.doc-code and
     4883                           locb-t-dtl.prt-code     = tt-goods.node-code  and
     4884                           locb-t-dtl.artic        = tt-goods.artic      and
     4885                           locb-t-dtl.prod-code    = tt-goods.prod-code  and
     4886                           locb-t-dtl.prod-type    = tt-goods.prod-type  :
     4887                   assign
     4888                     tt-goods.sum-fact  = tt-goods.sum-fact + locb-t-dtl.fact-qnty
     4889                   .
     4890                 end.
     4891                 for each  locb-rcv-doc no-lock where
     4892                           locb-rcv-doc.cons-code = loc-ord-cons-code   and
     4893                           locb-rcv-doc.doc-type  = "in":U   ,
     4894                     each ub.ord-chain no-lock where
     4895                           ub.ord-chain.doc-code = locb-rcv-doc.rcv-code and
     4896                           ub.ord-chain.doc-type = 'rcv'                 and
     4897                           ub.ord-chain.rel-doc-type = 'trn' ,
     4898                     each locb-t-doc no-lock  where
     4899                          locb-t-doc.doc-code = ub.ord-chain.rel-doc-code  and
     4900                          locb-t-doc.doc-type = 'при':U ,
     4901                     each locb-t-dtl no-lock where
     4902                           locb-t-dtl.doc-code     = locb-t-doc.doc-code and
     4903                           locb-t-dtl.prt-code     = tt-goods.node-code  and
     4904                           locb-t-dtl.artic        = tt-goods.artic      and
     4905                           locb-t-dtl.prod-code    = tt-goods.prod-code  and
     4906                           locb-t-dtl.prod-type    = tt-goods.prod-type  :
     4907                   assign
     4908                     tt-goods.sum-fact  = tt-goods.sum-fact + locb-t-dtl.fact-qnty
     4909                   .
     4910                 end.
     4911             end.
     4912      if not t-prt then
     4913        g#log = BROWSE-12:refresh() in frame frame-a no-error .
     4914      else
     4915        g#log = BROWSE-30:refresh() in frame frame-c no-error .
     4916   end.
     4917   END PROCEDURE.
     4918   PROCEDURE chg-ord-fp :
     4919   do
     4920    on error undo, return error return-value
     4921    :
     4922   find current ub.ord-doc no-lock no-error .
     4923   if avail ub.ord-doc and ub.ord-doc.status_ <> 'новый':U then do:
     4924       message  "Нельзя корректировать в статусе" caps(ub.ord-doc.status_) view-as alert-box information .
     4925       return.
     4926       end.
     4927   if avail ub.ord-doc and ub.ord-doc.status_ = 'новый':U then do:
     4928       g#type = 'ФП':U .
     4929       run zayvka in this-procedure  ("chg":U).
     4930       end.
     4931   if not  avail ub.ord-doc then do :
     4932       message "Заказ не выбран !!! " .
     4933       return.
     4934       End.
     4935   end.
     4936   END PROCEDURE.
     4937   PROCEDURE chg-ord-line :
     4938    do
     4939    on error undo, return error return-value
     4940    :
     4941    define variable  r-tmp as recid   no-undo .
     4942    define variable r-stop as logical no-undo .
     4943    define variable r-exit as logical no-undo .
     4944    find current tt-new-ord-line no-lock no-error .
     4945    find first ub.ord-doc no-lock where ub.ord-doc.doc-code = tt-new-ord-line.doc-code no-error .
     4946    if avail ub.ord-doc  and ub.ord-doc.status_ <> 'новый':U and line-mode <> 'ПРОСМОТР':U then do:
     4947         message "Заказ " ub.ord-doc.doc-code " уже закрыт до статуса " ub.ord-doc.status_ " Изменения невозможны ! " view-as alert-box .
     4948         return.
     4949    end.
     4950    for each TMP#zakaz :
     4951       delete TMP#zakaz .
     4952    end.
     4953      if avail tt-new-ord-line then do:
     4954        find first  tmp#zakaz where
     4955               TMP#zakaz.artic                 = tt-new-ord-line.artic and
     4956               TMP#zakaz.prod-code             = tt-new-ord-line.prod-code and
     4957               TMP#zakaz.prod-type             = tt-new-ord-line.prod-type no-error .
     4958         if not available Tmp#zakaz then do:
     4959             create TMP#zakaz.
     4960             end.
     4961         assign
     4962               TMP#zakaz.SLT-pc                = tt-new-ord-line.SLT-pc
     4963               TMP#zakaz.VAT-pc                = tt-new-ord-line.VAT-pc
     4964               TMP#zakaz.add-cli-qnty          = tt-new-ord-line.add-cli-qnty
     4965               TMP#zakaz.add-qnty              = tt-new-ord-line.add-qnty
     4966               TMP#zakaz.artic                 = tt-new-ord-line.artic
     4967               TMP#zakaz.prod-code             = tt-new-ord-line.prod-code
     4968               TMP#zakaz.prod-type             = tt-new-ord-line.prod-type
     4969               TMP#zakaz.cancel-cli-qnty       = tt-new-ord-line.cancel-cli-qnty
     4970               TMP#zakaz.cancel-date           = tt-new-ord-line.cancel-date
     4971               TMP#zakaz.cancel-qnty           = tt-new-ord-line.cancel-qnty
     4972               TMP#zakaz.cli-art               = tt-new-ord-line.cli-art
     4973               TMP#zakaz.cli-base-rate         = tt-new-ord-line.cli-base-rate
     4974               TMP#zakaz.cli-qnty              = tt-new-ord-line.cli-qnty
     4975               TMP#zakaz.doc-code              = tt-new-ord-line.doc-code
     4976               TMP#zakaz.excise                = tt-new-ord-line.excise
     4977               TMP#zakaz.fact-date             = tt-new-ord-line.fact-date
     4978               TMP#zakaz.initial-cli-qnty      = tt-new-ord-line.initial-cli-qnty
     4979               TMP#zakaz.initial-qnty          = tt-new-ord-line.initial-qnty
     4980               TMP#zakaz.line-num              = tt-new-ord-line.line-num
     4981               TMP#zakaz.order-cli-qnty        = tt-new-ord-line.order-cli-qnty
     4982               TMP#zakaz.order-qnty            = tt-new-ord-line.order-qnty
     4983               TMP#zakaz.other-base            = tt-new-ord-line.other-base
     4984               TMP#zakaz.other-rubl            = tt-new-ord-line.other-rubl
     4985               TMP#zakaz.price-base            = tt-new-ord-line.price-base
     4986               TMP#zakaz.price-cli             = tt-new-ord-line.price-cli
     4987               TMP#zakaz.price-rubl            = tt-new-ord-line.price-rubl
     4988               TMP#zakaz.qnty                  = tt-new-ord-line.qnty
     4989               TMP#zakaz.receive-cli-qnty      = tt-new-ord-line.receive-cli-qnty
     4990               TMP#zakaz.receive-qnty          = tt-new-ord-line.receive-qnty
     4991               TMP#zakaz.road-tax              = tt-new-ord-line.road-tax
     4992               TMP#zakaz.sum-SLT               = tt-new-ord-line.sum-SLT
     4993               TMP#zakaz.sum-VAT               = tt-new-ord-line.sum-VAT
     4994               TMP#zakaz.sum-base              = tt-new-ord-line.sum-base
     4995               TMP#zakaz.sum-cli               = tt-new-ord-line.sum-cli
     4996               TMP#zakaz.sum-excise            = tt-new-ord-line.sum-excise
     4997               TMP#zakaz.sum-other-base        = tt-new-ord-line.sum-other-base
     4998               TMP#zakaz.sum-other-rubl        = tt-new-ord-line.sum-other-rubl
     4999               TMP#zakaz.sum-road-tax          = tt-new-ord-line.sum-road-tax
     5000               TMP#zakaz.sum-rubl              = tt-new-ord-line.sum-rubl
     5001               TMP#zakaz.sum-transport-base    = tt-new-ord-line.sum-transport-base
     5002               TMP#zakaz.sum-transport-rubl    = tt-new-ord-line.sum-transport-rubl
     5003               TMP#zakaz.transport-base        = tt-new-ord-line.transport-base
     5004               TMP#zakaz.transport-rubl        = tt-new-ord-line.transport-rubl
     5005               TMP#zakaz.unit-cli              = tt-new-ord-line.unit-cli
     5006               TMP#zakaz.v-vat                 = tt-new-ord-line.v-vat
     5007           .
     5008       find first TMP#zakaz no-error .
     5009       IF not avail TMP#zakaz then return no-apply.
     5010       assign
     5011         r-tmp = recid ( TMP#zakaz   )
     5012         loc-status     = ub.ord-doc.status_
     5013         doc-date       = ub.ord-doc.doc-date
     5014         loc-date-ship  = ub.ord-doc.ship-date
     5015         date-sale-1    = ub.ord-doc.date-sale-1
     5016         date-sale-2    = ub.ord-doc.date-sale-2
     5017         loc-exch-code  = ub.ord-doc.exch-code
     5018         loc-exch-rate  = ub.ord-doc.exch-rate
     5019         loc-exch-scale = ub.ord-doc.exch-scale
     5020         loc-base-rate  = ub.ord-doc.base-rate
     5021         loc-base-scale = ub.ord-doc.base-scale
     5022         vat_type       = ub.ord-doc.vat-type
     5023         slt_type       = ub.ord-doc.slt-type
     5024         loc-cli-code =   ub.ord-doc.cli-code
     5025         loc-cli-type =   ub.ord-doc.cli-type
     5026         loc-ord-num  =   ub.ord-doc.doc-code
     5027         no-error.
     5028         if error-status :error
     5029         then do:
     5030              message  error-status :get-message(1) skip
     5031              "при присвоении" skip
     5032              .
     5033              end.
     5034       find first shar_ord-doc no-lock  where shar_ord-doc.doc-code = ord-doc.doc-code no-error .
     5035       if loc-make-avto = false then do:
     5036          run cus/ord-frm.w (input Parparentproc,  input r-tmp ,input line-mode , output r-stop, output r-exit ) .
     5037       end.
     5038       if line-mode <> 'ПРОСМОТР':U  then do:
     5039          if  r-stop = false and r-exit = false  then do:
     5040          run dop-pr in this-procedure .
     5041           run calc-cons-ord in this-procedure .
     5042          end.
     5043       end.
     5044       find current TMP#zakaz no-error  .
     5045       if avail TMP#zakaz then delete TMP#zakaz.
     5046   end.
     5047   else do:
     5048     message  "Не выбрана строка заказа !" view-as alert-box .
     5049   end.
     5050   end.
     5051   END PROCEDURE.
     5052   PROCEDURE chg-trn :
     5053   do
     5054    on error undo, return error return-value
     5055    :
     5056   if available ub.trn-doc then do:
     5057      run str/showdoc.p
     5058         (input parparentproc
     5059         ,input ub.trn-doc.doc-code
     5060         ,input ""
     5061         ,input ""
     5062         ,input 0
     5063         ,input true
     5064         ) .
     5065   end.
     5066   end.
     5067   END PROCEDURE.
     5068   PROCEDURE color-cell :
     5069    do
     5070    on error undo, return error return-value
     5071    :
     5072     define input parameter h-cell   as handle    no-undo .
     5073     define input parameter p-color  as integer   no-undo .
     5074     define input parameter h-status as character no-undo .
     5075     define input parameter p-status as character no-undo .
     5076     if  h-cell <> ?   and valid-handle(h-cell)
     5077          then do:
     5078         if h-status = p-status then do:
     5079            h-cell:fgcolor = p-color .
     5080         end.
     5081     end.
     5082     end.
     5083   END PROCEDURE.
     5084   PROCEDURE create-dtl-fp :
     5085   do
     5086    on error undo, return error return-value
     5087    :
     5088   define input parameter p_new-doc-code like ub.ord-doc.doc-code no-undo .
     5089   define input parameter p_file         as character no-undo .
     5090   define input parameter p_old-doc-code like ub.ord-doc.doc-code no-undo .
     5091   define input parameter p_artic     like   ub.ord-line.artic       no-undo .
     5092   define input parameter p_prod-type like   ub.ord-line.prod-type  no-undo .
     5093   define input parameter p_prod-code like   ub.ord-line.prod-code  no-undo .
     5094   define input parameter p-cli-base-rate like   ub.ord-line.cli-base-rate  no-undo .
     5095   define buffer new_ord-dtl    for ub.ord-dtl .
     5096   define buffer j_ord-dtl      for ub.ord-dtl .
     5097   define buffer j_ord-dtl-cons for ub.ord-dtl-cons .
     5098   define buffer loc-tt-goods   for tt-goods .
     5099   define variable loc-fact-qnty like ub.ord-line.qnty no-undo .
     5100   case  p_file  :
     5101   when "ord-of"  then do:
     5102       for each  j_ord-dtl no-lock where
     5103                 j_ord-dtl.doc-code   = p_old-doc-code and
     5104                 j_ord-dtl.artic      = p_artic        and
     5105                 j_ord-dtl.prod-type  = p_prod-type    and
     5106                 j_ord-dtl.prod-code  = p_prod-code
     5107                 :
     5108          find first loc-tt-goods no-lock   where
     5109                     loc-tt-goods.gds-t <> 'товар':U and
     5110                     loc-tt-goods.artic      = j_ord-dtl.artic      and
     5111                     loc-tt-goods.node-code  = j_ord-dtl.node-code  and
     5112                     loc-tt-goods.prod-code  = j_ord-dtl.prod-code  and
     5113                     loc-tt-goods.prod-type  = j_ord-dtl.prod-type  no-error .
     5114          if not available loc-tt-goods then  do:  next. end.
     5115             loc-fact-qnty = loc-tt-goods.sum-qnty - (loc-tt-goods.sum-ord + loc-tt-goods.sum-rcv-in) .
     5116          find first new_ord-dtl where
     5117            new_ord-dtl.doc-code             = p_new-doc-code       and
     5118            new_ord-dtl.artic                = j_ord-dtl.artic      and
     5119            new_ord-dtl.node-code            = j_ord-dtl.node-code  and
     5120            new_ord-dtl.prod-code            = j_ord-dtl.prod-code  and
     5121            new_ord-dtl.prod-type            = j_ord-dtl.prod-type   exclusive-lock  no-error .
     5122          if not available new_ord-dtl then  do:  create new_ord-dtl. end.
     5123          assign
     5124            new_ord-dtl.doc-code             = p_new-doc-code
     5125            new_ord-dtl.add-cli-qnty         = j_ord-dtl.add-cli-qnty
     5126            new_ord-dtl.add-qnty             = j_ord-dtl.add-qnty
     5127            new_ord-dtl.artic                = j_ord-dtl.artic
     5128            new_ord-dtl.prod-code            = j_ord-dtl.prod-code
     5129            new_ord-dtl.prod-type            = j_ord-dtl.prod-type
     5130            new_ord-dtl.node-code            = j_ord-dtl.node-code
     5131            new_ord-dtl.cancel-cli-qnty      = j_ord-dtl.cancel-cli-qnty
     5132            new_ord-dtl.cancel-qnty          = j_ord-dtl.cancel-qnty
     5133            new_ord-dtl.initial-cli-qnty     = j_ord-dtl.initial-cli-qnty
     5134            new_ord-dtl.initial-qnty         = j_ord-dtl.initial-qnty
     5135            new_ord-dtl.order-cli-qnty       = j_ord-dtl.order-cli-qnty
     5136            new_ord-dtl.order-qnty           = j_ord-dtl.order-qnty
     5137            new_ord-dtl.price-base           = j_ord-dtl.price-base
     5138            new_ord-dtl.price-cli            = j_ord-dtl.price-cli
     5139            new_ord-dtl.price-rubl           = j_ord-dtl.price-rubl
     5140            new_ord-dtl.receive-cli-qnty     = j_ord-dtl.receive-cli-qnty
     5141            new_ord-dtl.receive-qnty         = j_ord-dtl.receive-qnty
     5142            new_ord-dtl.qnty                 = minimum( j_ord-dtl.qnty , loc-fact-qnty )
     5143            new_ord-dtl.cli-qnty             = new_ord-dtl.qnty / p-cli-base-rate
     5144            new_ord-dtl.sum-base             = new_ord-dtl.qnty * new_ord-dtl.price-base
     5145            new_ord-dtl.sum-cli              = new_ord-dtl.cli-qnty * new_ord-dtl.price-cli
     5146            new_ord-dtl.sum-rubl             = new_ord-dtl.qnty * new_ord-dtl.price-rubl
     5147          .
     5148       end.
     5149   end.
     5150   when "ord-cons"  then do:
     5151       for each  j_ord-dtl-cons no-lock  where
     5152                 j_ord-dtl-cons.cons-code   = p_old-doc-code and
     5153                 j_ord-dtl-cons.artic      = p_artic        and
     5154                 j_ord-dtl-cons.prod-type  = p_prod-type    and
     5155                 j_ord-dtl-cons.prod-code  = p_prod-code
     5156                 :
     5157          find first loc-tt-goods no-lock   where
     5158                     loc-tt-goods.gds-t <> 'товар':U and
     5159                     loc-tt-goods.artic      = j_ord-dtl.artic      and
     5160                     loc-tt-goods.node-code  = j_ord-dtl.node-code  and
     5161                     loc-tt-goods.prod-code  = j_ord-dtl.prod-code  and
     5162                     loc-tt-goods.prod-type  = j_ord-dtl.prod-type  no-error .
     5163          if not available loc-tt-goods then  do:  next. end.
     5164             loc-fact-qnty = loc-tt-goods.sum-qnty - (loc-tt-goods.sum-ord + loc-tt-goods.sum-rcv-in) .
     5165            find first  new_ord-dtl  exclusive-lock  where
     5166            new_ord-dtl.doc-code             = p_new-doc-code            and
     5167            new_ord-dtl.artic                = j_ord-dtl-cons.artic      and
     5168            new_ord-dtl.node-code            = j_ord-dtl-cons.node-code  and
     5169            new_ord-dtl.prod-code            = j_ord-dtl-cons.prod-code  and
     5170            new_ord-dtl.prod-type            = j_ord-dtl-cons.prod-type no-error .
     5171            if not available new_ord-dtl then do:  create new_ord-dtl. end.
     5172          assign
     5173            new_ord-dtl.doc-code             = p_new-doc-code
     5174            new_ord-dtl.artic                = j_ord-dtl-cons.artic
     5175            new_ord-dtl.node-code            = j_ord-dtl-cons.node-code
     5176            new_ord-dtl.prod-code            = j_ord-dtl-cons.prod-code
     5177            new_ord-dtl.prod-type            = j_ord-dtl-cons.prod-type
     5178            new_ord-dtl.qnty                 = loc-fact-qnty
     5179            new_ord-dtl.cli-qnty             = new_ord-dtl.qnty / p-cli-base-rate
     5180          .
     5181       end.
     5182   end.
     5183   end case.
     5184   end.
     5185   END PROCEDURE.
     5186   PROCEDURE create-dtl-rcv :
     5187    do
     5188    on error undo, return error return-value
     5189    :
     5190   define input parameter p_new-rcv-code like ub.ord-doc-rcv.rcv-code no-undo .
     5191   define input parameter p_new-doc-code like ub.ord-doc-rcv.doc-code no-undo .
     5192   define input parameter p_file         as character no-undo .
     5193   define input parameter p_old-doc-code like  ub.ord-doc-rcv.doc-code    no-undo .
     5194   define input parameter p_old-rcv-code like  ub.ord-doc-rcv.rcv-code    no-undo .
     5195   define input parameter p_artic        like  ub.ord-line-rcv.artic      no-undo .
     5196   define input parameter p_prod-type    like  ub.ord-line-rcv.prod-type  no-undo .
     5197   define input parameter p_prod-code    like  ub.ord-line-rcv.prod-code  no-undo .
     5198   define buffer new_ord-dtl-rcv   for ub.ord-dtl-rcv  .
     5199   define buffer old_ord-dtl-cons  for ub.ord-dtl-cons .
     5200   define buffer old_ord-gds-cons  for ub.ord-gds-cons .
     5201   define buffer j_ord-dtl         for ub.ord-dtl      .
     5202   define buffer j_ord-line        for ub.ord-line     .
     5203   define buffer of_ord-dtl        for ub.ord-dtl      .
     5204   define buffer of_ord-line       for ub.ord-line     .
     5205   define buffer loc-tt-goods   for tt-goods .
     5206   define variable loc-fact-qnty    like ub.ord-line.qnty no-undo .
     5207   define variable loc-fact-qnty-in like ub.ord-line.qnty no-undo .
     5208   case  p_file  :
     5209   when "ord-fp"  then do:
     5210       for each  j_ord-dtl no-lock  where
     5211                 j_ord-dtl.doc-code   = p_new-doc-code and
     5212                 j_ord-dtl.artic      = p_artic        and
     5213                 j_ord-dtl.prod-type  = p_prod-type    and
     5214                 j_ord-dtl.prod-code  = p_prod-code
     5215                 ,
     5216               first j_ord-line no-lock  where
     5217                   j_ord-line.doc-code   = p_new-doc-code and
     5218                   j_ord-line.artic      = p_artic        and
     5219                   j_ord-line.prod-type  = p_prod-type    and
     5220                   j_ord-line.prod-code  = p_prod-code
     5221                   :
     5222          find first loc-tt-goods no-lock   where
     5223                     loc-tt-goods.gds-t <> 'товар':U and
     5224                     loc-tt-goods.artic      = j_ord-dtl.artic      and
     5225                     loc-tt-goods.node-code  = j_ord-dtl.node-code  and
     5226                     loc-tt-goods.prod-code  = j_ord-dtl.prod-code  and
     5227                     loc-tt-goods.prod-type  = j_ord-dtl.prod-type  no-error .
     5228          if not available loc-tt-goods then  do:  next. end.
     5229             loc-fact-qnty = loc-tt-goods.sum-rcv .
     5230          find first  of_ord-dtl  no-lock    where
     5231                 of_ord-dtl.doc-code   = p_old-doc-code and
     5232                 of_ord-dtl.artic      = p_artic        and
     5233                 of_ord-dtl.prod-type  = p_prod-type    and
     5234                 of_ord-dtl.prod-code  = p_prod-code   no-error .
     5235                 if error-status :error then next.
     5236          find first new_ord-dtl-rcv  exclusive-lock  where
     5237            new_ord-dtl-rcv.rcv-code   = p_new-rcv-code       and
     5238            new_ord-dtl-rcv.doc-code   = j_ord-dtl.doc-code   and
     5239            new_ord-dtl-rcv.artic      = j_ord-dtl.artic      and
     5240            new_ord-dtl-rcv.prod-code  = j_ord-dtl.prod-code  and
     5241            new_ord-dtl-rcv.prod-type  = j_ord-dtl.prod-type  and
     5242            new_ord-dtl-rcv.node-code  = j_ord-dtl.node-code  no-error .
     5243          if not  available new_ord-dtl-rcv then do:
     5244             create new_ord-dtl-rcv.
     5245             end.
     5246          assign
     5247            new_ord-dtl-rcv.rcv-code   = p_new-rcv-code
     5248            new_ord-dtl-rcv.doc-code   = j_ord-dtl.doc-code
     5249            new_ord-dtl-rcv.artic      = j_ord-dtl.artic
     5250            new_ord-dtl-rcv.prod-code  = j_ord-dtl.prod-code
     5251            new_ord-dtl-rcv.prod-type  = j_ord-dtl.prod-type
     5252            new_ord-dtl-rcv.node-code  = j_ord-dtl.node-code
     5253            new_ord-dtl-rcv.price-base = j_ord-dtl.price-base
     5254            new_ord-dtl-rcv.price-cli  = j_ord-dtl.price-cli
     5255            new_ord-dtl-rcv.price-rubl = j_ord-dtl.price-rubl
     5256            new_ord-dtl-rcv.qnty       = MINIMUM(j_ord-dtl.qnty , of_ord-dtl.qnty) - loc-fact-qnty
     5257            new_ord-dtl-rcv.cli-qnty   = new_ord-dtl-rcv.qnty  / j_ord-line.cli-base-rate
     5258            new_ord-dtl-rcv.sum-base   = new_ord-dtl-rcv.price-base * new_ord-dtl-rcv.qnty
     5259            new_ord-dtl-rcv.sum-rubl   = new_ord-dtl-rcv.price-rubl * new_ord-dtl-rcv.qnty
     5260            new_ord-dtl-rcv.sum-cli    = new_ord-dtl-rcv.price-cli  * new_ord-dtl-rcv.cli-qnty
     5261          .
     5262       end.
     5263   end.
     5264   when "rcv-in"  then do:
     5265       loc-fact-qnty-in = 0 .
     5266       for each  old_ord-dtl-cons  no-lock where
     5267                 old_ord-dtl-cons.cons-code   = loc-ord-cons-code and
     5268                 old_ord-dtl-cons.artic       = p_artic        and
     5269                 old_ord-dtl-cons.prod-type   = p_prod-type    and
     5270                 old_ord-dtl-cons.prod-code   = p_prod-code
     5271                 ,
     5272           first old_ord-gds-cons no-lock where
     5273                 old_ord-gds-cons.cons-code   = loc-ord-cons-code and
     5274                 old_ord-gds-cons.artic       = p_artic        and
     5275                 old_ord-gds-cons.prod-type   = p_prod-type    and
     5276                 old_ord-gds-cons.prod-code   = p_prod-code
     5277                 :
     5278          find first  of_ord-dtl no-lock     where
     5279                 of_ord-dtl.doc-code   = p_old-doc-code and
     5280                 of_ord-dtl.node-code  = old_ord-dtl-cons.node-code    and
     5281                 of_ord-dtl.artic      = p_artic        and
     5282                 of_ord-dtl.prod-type  = p_prod-type    and
     5283                 of_ord-dtl.prod-code  = p_prod-code   no-error .
     5284                 if not available of_ord-dtl then do: next. end.
     5285          find first  of_ord-line  no-lock    where
     5286                 of_ord-line.doc-code   = p_old-doc-code and
     5287                 of_ord-line.artic      = p_artic        and
     5288                 of_ord-line.prod-type  = p_prod-type    and
     5289                 of_ord-line.prod-code  = p_prod-code   no-error .
     5290                 if not available of_ord-line then do: next. end.
     5291                 loc-fact-qnty = of_ord-line.qnty.
     5292          find first new_ord-dtl-rcv  exclusive-lock  where
     5293            new_ord-dtl-rcv.rcv-code             = p_new-rcv-code           and
     5294            new_ord-dtl-rcv.doc-code             = ""                       and
     5295            new_ord-dtl-rcv.node-code            = of_ord-dtl.node-code     and
     5296            new_ord-dtl-rcv.artic                = of_ord-dtl.artic         and
     5297            new_ord-dtl-rcv.prod-code            = of_ord-dtl.prod-code     and
     5298            new_ord-dtl-rcv.prod-type            = of_ord-dtl.prod-type     no-error .
     5299          if not available new_ord-dtl-rcv then do:
     5300             create new_ord-dtl-rcv.
     5301          end.
     5302          assign
     5303            new_ord-dtl-rcv.rcv-code             = p_new-rcv-code
     5304            new_ord-dtl-rcv.doc-code             = ""
     5305            new_ord-dtl-rcv.node-code            = of_ord-dtl.node-code
     5306            new_ord-dtl-rcv.artic                = of_ord-dtl.artic
     5307            new_ord-dtl-rcv.prod-code            = of_ord-dtl.prod-code
     5308            new_ord-dtl-rcv.prod-type            = of_ord-dtl.prod-type
     5309            new_ord-dtl-rcv.qnty                 = MINIMUM(old_ord-gds-cons.sum-qnty , of_ord-dtl.qnty)
     5310            new_ord-dtl-rcv.cli-qnty             = new_ord-dtl-rcv.qnty  / of_ord-line.cli-base-rate
     5311          .
     5312          loc-fact-qnty-in  = loc-fact-qnty-in + new_ord-dtl-rcv.qnty .
     5313          if loc-fact-qnty < loc-fact-qnty-in then do:
     5314               assign
     5315                 new_ord-dtl-rcv.qnty                 = 0
     5316                 new_ord-dtl-rcv.cli-qnty             = 0
     5317               .
     5318          end.
     5319       end.
     5320   end.
     5321   end case.
     5322   end.
     5323   END PROCEDURE.
     5324   PROCEDURE create-line-fp :
     5325   do
     5326    on error undo, return error return-value
     5327    :
     5328   define input parameter n-code as character no-undo .
     5329   define output parameter r-tmp as recid no-undo .
     5330   define buffer b-ord-cons-gds for tt-goods.
     5331   define buffer bq_ord-doc  for ub.ord-doc  .
     5332   define buffer bq_ord-line for ub.ord-line .
     5333   if not avail tt-goods then do:
     5334      message
     5335      "Не найден товар " skip
     5336      "Ошибка "  error-status :get-message(1) .
     5337      return error.
     5338      end.
     5339   find first  b-ord-cons-gds no-lock  where b-ord-cons-gds.artic      = tt-goods.artic and
     5340                                    b-ord-cons-gds.prod-code  = tt-goods.prod-code and
     5341                                    b-ord-cons-gds.prod-type  = tt-goods.prod-type
     5342                                   no-error .
     5343   if not can-find  (first ub.ord-line where ub.ord-line.doc-code   = n-code and
     5344                                        ub.ord-line.artic      = tt-goods.artic and
     5345                                        ub.ord-line.prod-code  = tt-goods.prod-code and
     5346                                        ub.ord-line.prod-type  = tt-goods.prod-type no-lock ) then do:
     5347   define variable local-fact-ord like ub.ord-line.qnty no-undo .
     5348   define variable local-rcv-in   like ub.ord-line.qnty no-undo .
     5349   define variable sum-fact-ord like ub.ord-line.qnty no-undo .
     5350       sum-fact-ord = 0.
     5351       assign
     5352             local-fact-ord = tt-goods.sum-ord
     5353             local-rcv-in  = tt-goods.sum-rcv-in
     5354       .
     5355       sum-fact-ord = b-ord-cons-gds.sum-qnty - ( local-fact-ord + local-rcv-in ).
     5356       if sum-fact-ord <= 0 then dO:
     5357          message "По товару    :" tt-goods.gds-name skip
     5358                  "артикул      :" tt-goods.artic    skip
     5359                  "Уже заказано :" local-fact-ord    skip
     5360                  "Уже перемещено :" local-rcv-in    skip
     5361                  "Запрошено    :" b-ord-cons-gds.sum-qnty    skip
     5362                  "Заказывать еще ?"
     5363                  view-as alert-box question buttons OK-Cancel update g#log.
     5364                  if g#log = false then return.
     5365       end.
     5366       create  ub.ord-line.
     5367         assign
     5368           ub.ord-line.gds-code       = tt-goods.gds-code
     5369           ub.ord-line.artic          = b-ord-cons-gds.artic
     5370           ub.ord-line.cli-base-rate  = b-ord-cons-gds.cli-base-rate
     5371           ub.ord-line.prod-code      = b-ord-cons-gds.prod-code
     5372           ub.ord-line.prod-type      = b-ord-cons-gds.prod-type
     5373           ub.ord-line.doc-code  = n-code
     5374           ub.ord-line.line-num  = 1
     5375           ub.ord-line.qnty      = (if sum-fact-ord < 0 then 0 else sum-fact-ord )
     5376           ub.ord-line.unit-cli      = tt-goods.unit-cli
     5377           ub.ord-line.cli-base-rate = tt-goods.cli-base-rate
     5378           ub.ord-line.cli-qnty      = ub.ord-line.qnty / ub.ord-line.cli-base-rate
     5379       .
     5380    run last-price  in this-procedure
     5381    (    input  g#host-code        ,
     5382         input  ub.ord-line.artic     ,
     5383         input  ub.ord-line.prod-type ,
     5384         input  ub.ord-line.prod-code ,
     5385         input  ub.ord-doc.cli-code   ,
     5386         input  ub.ord-doc.cli-type   ,
     5387         input  ub.ord-line.cli-base-rate  ,
     5388         input  ub.ord-doc.exch-code  ,
     5389         output ub.ord-line.price-base,
     5390         output ub.ord-line.price-rubl,
     5391         output ub.ord-line.price-cli )
     5392         no-error  .
     5393         if error-status :error then message
     5394           vss-workfile vss-revision vss-description skip
     5395           error-status :get-message(1) skip
     5396           return-value skip
     5397           ""
     5398           view-as alert-box error
     5399         .
     5400       assign
     5401         ub.ord-line.sum-base = ub.ord-line.price-base * ub.ord-line.qnty
     5402         ub.ord-line.sum-rubl = ub.ord-line.price-rubl * ub.ord-line.qnty
     5403         ub.ord-line.sum-cli  = ub.ord-line.price-cli  * ub.ord-line.cli-qnty
     5404       .
     5405   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5407     (input  tt-goods.gds-code
     5408     ,input  '1':U
     5409     ,input  ?
     5410     ,input  g#host-code
     5411     ,input  store-type
     5412     ,input  store-code
     5413     ,output ub.ord-line.vat-pc
     5414     ) no-error .
     5415   if error-status :error then message
     5416     vss-workfile vss-revision vss-description skip
     5417     error-status :get-message(1) skip
     5418     return-value skip
     5419     ""
     5420     view-as alert-box error
     5421   .
     5422   end.
     5423   line-rec = recid(ord-line) .
     5424   find first  tmp#zakaz where
     5425               TMP#zakaz.artic                 = ub.ord-line.artic and
     5426               TMP#zakaz.prod-code             = ub.ord-line.prod-code and
     5427               TMP#zakaz.prod-type             = ub.ord-line.prod-type no-error .
     5428         if not available Tmp#zakaz then do:
     5429             create TMP#zakaz.
     5430             end.
     5431         assign
     5432               TMP#zakaz.SLT-pc                = ub.ord-line.SLT-pc
     5433               TMP#zakaz.VAT-pc                = ub.ord-line.VAT-pc
     5434               TMP#zakaz.add-cli-qnty          = ub.ord-line.add-cli-qnty
     5435               TMP#zakaz.add-qnty              = ub.ord-line.add-qnty
     5436               TMP#zakaz.artic                 = ub.ord-line.artic
     5437               TMP#zakaz.prod-code             = ub.ord-line.prod-code
     5438               TMP#zakaz.prod-type             = ub.ord-line.prod-type
     5439               TMP#zakaz.cancel-cli-qnty       = ub.ord-line.cancel-cli-qnty
     5440               TMP#zakaz.cancel-date           = ub.ord-line.cancel-date
     5441               TMP#zakaz.cancel-qnty           = ub.ord-line.cancel-qnty
     5442               TMP#zakaz.cli-art               = ub.ord-line.cli-art
     5443               TMP#zakaz.cli-base-rate         = ub.ord-line.cli-base-rate
     5444               TMP#zakaz.cli-qnty              = ub.ord-line.cli-qnty
     5445               TMP#zakaz.doc-code              = ub.ord-line.doc-code
     5446               TMP#zakaz.excise                = ub.ord-line.excise
     5447               TMP#zakaz.fact-date             = ub.ord-line.fact-date
     5448               TMP#zakaz.initial-cli-qnty      = ub.ord-line.initial-cli-qnty
     5449               TMP#zakaz.initial-qnty          = ub.ord-line.initial-qnty
     5450               TMP#zakaz.line-num              = ub.ord-line.line-num
     5451               TMP#zakaz.order-cli-qnty        = ub.ord-line.order-cli-qnty
     5452               TMP#zakaz.order-qnty            = ub.ord-line.order-qnty
     5453               TMP#zakaz.other-base            = ub.ord-line.other-base
     5454               TMP#zakaz.other-rubl            = ub.ord-line.other-rubl
     5455               TMP#zakaz.price-base            = ub.ord-line.price-base
     5456               TMP#zakaz.price-cli             = ub.ord-line.price-cli
     5457               TMP#zakaz.price-rubl            = ub.ord-line.price-rubl
     5458               TMP#zakaz.qnty                  = ub.ord-line.qnty
     5459               TMP#zakaz.receive-cli-qnty      = ub.ord-line.receive-cli-qnty
     5460               TMP#zakaz.receive-qnty          = ub.ord-line.receive-qnty
     5461               TMP#zakaz.road-tax              = ub.ord-line.road-tax
     5462               TMP#zakaz.sum-SLT               = ub.ord-line.sum-SLT
     5463               TMP#zakaz.sum-VAT               = ub.ord-line.sum-VAT
     5464               TMP#zakaz.sum-base              = ub.ord-line.sum-base
     5465               TMP#zakaz.sum-cli               = ub.ord-line.sum-cli
     5466               TMP#zakaz.sum-excise            = ub.ord-line.sum-excise
     5467               TMP#zakaz.sum-other-base        = ub.ord-line.sum-other-base
     5468               TMP#zakaz.sum-other-rubl        = ub.ord-line.sum-other-rubl
     5469               TMP#zakaz.sum-road-tax          = ub.ord-line.sum-road-tax
     5470               TMP#zakaz.sum-rubl              = ub.ord-line.sum-rubl
     5471               TMP#zakaz.sum-transport-base    = ub.ord-line.sum-transport-base
     5472               TMP#zakaz.sum-transport-rubl    = ub.ord-line.sum-transport-rubl
     5473               TMP#zakaz.transport-base        = ub.ord-line.transport-base
     5474               TMP#zakaz.transport-rubl        = ub.ord-line.transport-rubl
     5475               TMP#zakaz.unit-cli              = ub.ord-line.unit-cli
     5476               TMP#zakaz.v-vat                 = ub.ord-line.v-vat
     5477           .
     5478       find first TMP#zakaz no-error .
     5479       IF not avail TMP#zakaz then return no-apply.
     5480       assign
     5481         r-tmp = recid ( TMP#zakaz   )  .
     5482   run ord-detale in this-procedure no-error .
     5483      if error-status :error then return error .
     5484   end.
     5485   END PROCEDURE.
     5486   PROCEDURE create-line-rcv :
     5487   do
     5488    on error undo, return error return-value
     5489    :
     5490   define input parameter n-code as character no-undo .
     5491   define input parameter z-recid as recid no-undo .
     5492   define input parameter fp-recid as recid no-undo .
     5493   define input parameter p-ks as int  no-undo .
     5494   define output parameter l-rec as recid no-undo .
     5495   define buffer buf-fp_ord-line for ub.ord-line .
     5496   define buffer b-of_ord-line   for ub.ord-line .
     5497   define buffer b-of_ord-doc    for ub.ord-doc  .
     5498   define buffer b-rcv_ord-doc-rcv   for ub.ord-doc-rcv  .
     5499   define buffer buf-tt-goods     for tt-goods.
     5500   define buffer p_ord-line-rcv-i for ub.ord-line-rcv .
     5501   define buffer p_ord-doc-rcv-i  for ub.ord-doc-rcv  .
     5502   define variable  loc-var-qnty  like ub.ord-line-rcv.qnty no-undo.
     5503   define variable  loc-all-rcv   as decimal no-undo .
     5504   define variable  loc-new as recid no-undo .
     5505   define variable v-doc-mode as character no-undo .
     5506   find first  buf-fp_ord-line    no-lock where recid(buf-fp_ord-line) = z-recid    no-error .
     5507   find first  b-rcv_ord-doc-rcv  no-lock where b-rcv_ord-doc-rcv.rcv-code = n-code no-error .
     5508   if avail buf-fp_ord-line then do:
     5509     if not can-find  (first ub.ord-line-rcv where
     5510                   ub.ord-line-rcv.doc-code  = buf-fp_ord-line.doc-code and
     5511                   ub.ord-line-rcv.rcv-code  = n-code and
     5512                   ub.ord-line-rcv.artic     = buf-fp_ord-line.artic and
     5513                   ub.ord-line-rcv.prod-code = buf-fp_ord-line.prod-code and
     5514                   ub.ord-line-rcv.prod-type = buf-fp_ord-line.prod-type no-lock ) then do:
     5515       run proc-create-rcv-line in this-procedure
     5516       (  input buf-fp_ord-line.SLT-pc
     5517         ,input buf-fp_ord-line.VAT-pc
     5518         ,input buf-fp_ord-line.artic
     5519         ,input buf-fp_ord-line.cli-base-rate
     5520         ,input buf-fp_ord-line.cli-qnty
     5521         ,input buf-fp_ord-line.doc-code
     5522         ,input buf-fp_ord-line.excise
     5523         ,input buf-fp_ord-line.gds-code
     5524         ,input p-ks
     5525         ,input buf-fp_ord-line.other-base
     5526         ,input buf-fp_ord-line.other-rubl
     5527         ,input buf-fp_ord-line.price-base
     5528         ,input buf-fp_ord-line.price-cli
     5529         ,input buf-fp_ord-line.price-rubl
     5530         ,input buf-fp_ord-line.prod-code
     5531         ,input buf-fp_ord-line.prod-type
     5532         ,input buf-fp_ord-line.qnty
     5533         ,input n-code
     5534         ,input buf-fp_ord-line.road-tax
     5535         ,input buf-fp_ord-line.sum-SLT
     5536         ,input buf-fp_ord-line.sum-VAT
     5537         ,input buf-fp_ord-line.sum-base
     5538         ,input buf-fp_ord-line.sum-cli
     5539         ,input buf-fp_ord-line.sum-excise
     5540         ,input buf-fp_ord-line.sum-other-base
     5541         ,input buf-fp_ord-line.sum-other-rubl
     5542         ,input buf-fp_ord-line.sum-road-tax
     5543         ,input buf-fp_ord-line.sum-rubl
     5544         ,input buf-fp_ord-line.sum-transport-base
     5545         ,input buf-fp_ord-line.sum-transport-rubl
     5546         ,input buf-fp_ord-line.transport-base
     5547         ,input buf-fp_ord-line.transport-rubl
     5548         ,input buf-fp_ord-line.unit-cli
     5549         ,input buf-fp_ord-line.v-vat
     5550         ).
     5551       if fp-recid <> ? then do:
     5552             for each  b-of_ord-doc no-lock  where  recid(b-of_ord-doc) = fp-recid  ,
     5553                 first  b-of_ord-line no-lock where
     5554                       b-of_ord-line.doc-code  = b-of_ord-doc.doc-code and
     5555                       b-of_ord-line.artic     = buf-fp_ord-line.artic and
     5556                       b-of_ord-line.prod-code = buf-fp_ord-line.prod-code and
     5557                       b-of_ord-line.prod-type = buf-fp_ord-line.prod-type
     5558                       :
     5559                 assign
     5560                   loc-var-qnty           = b-of_ord-line.qnty
     5561                 .
     5562                 leave.
     5563             end.
     5564          find first buf-tt-goods  where
     5565                  buf-tt-goods.gds-t     = 'товар':U           and
     5566                  buf-tt-goods.artic     = buf-fp_ord-line.artic and
     5567                  buf-tt-goods.prod-code = buf-fp_ord-line.prod-code and
     5568                  buf-tt-goods.prod-type = buf-fp_ord-line.prod-type no-lock no-error .
     5569          define variable l-all-rcv-fp as decimal no-undo .
     5570          l-all-rcv-fp = 0 .
     5571          for each p_ord-line-rcv-i no-lock where
     5572                   p_ord-line-rcv-i.doc-code  = buf-fp_ord-line.doc-code and
     5573                   p_ord-line-rcv-i.artic     = buf-fp_ord-line.artic and
     5574                   p_ord-line-rcv-i.prod-code = buf-fp_ord-line.prod-code and
     5575                   p_ord-line-rcv-i.prod-type = buf-fp_ord-line.prod-type ,
     5576                first p_ord-doc-rcv-i no-lock where
     5577                     p_ord-doc-rcv-i.doc-code  = p_ord-line-rcv-i.doc-code and
     5578                     p_ord-doc-rcv-i.rcv-code  = p_ord-line-rcv-i.rcv-code and
     5579                     p_ord-doc-rcv-i.obj-type  = b-of_ord-doc.obj-type  and
     5580                     p_ord-doc-rcv-i.obj-code  = b-of_ord-doc.obj-code  and
     5581                     p_ord-line-rcv-i.rcv-code  <> ub.ord-line-rcv.rcv-code  and
     5582                     p_ord-doc-rcv-i.cons-code = loc-ord-cons-code
     5583           :
     5584           l-all-rcv-fp = l-all-rcv-fp + p_ord-line-rcv-i.qnty .
     5585          end.
     5586           loc-all-rcv =  buf-fp_ord-line.qnty -  l-all-rcv-fp .
     5587           loc-all-rcv = if  loc-all-rcv < 0 then 0 else loc-all-rcv.
     5588          define variable loc-var-qnty-rcv as decimal no-undo .
     5589          define buffer loc_zz_ord-line for ub.ord-line .
     5590          define buffer loc_zz_ord-doc for  ub.ord-doc .
     5591          loc-var-qnty-rcv = 0 .
     5592          for each loc_zz_ord-line no-lock where
     5593                   loc_zz_ord-line.artic     = buf-fp_ord-line.artic and
     5594                   loc_zz_ord-line.prod-code = buf-fp_ord-line.prod-code and
     5595                   loc_zz_ord-line.prod-type = buf-fp_ord-line.prod-type ,
     5596                first loc_zz_ord-doc no-lock where
     5597                     loc_zz_ord-doc.doc-code  = loc_zz_ord-line.doc-code and
     5598                     loc_zz_ord-doc.obj-type  = b-of_ord-doc.obj-type  and
     5599                     loc_zz_ord-doc.obj-code  = b-of_ord-doc.obj-code  and
     5600                     loc_zz_ord-doc.cons-code = loc-ord-cons-code
     5601           :
     5602          loc-var-qnty-rcv = loc-var-qnty-rcv + loc_zz_ord-line.qnty .
     5603          end.
     5604          define variable p_fp0 as decimal no-undo .
     5605          p_fp0 = 0 .
     5606          for each p_ord-line-rcv-i no-lock where
     5607                   p_ord-line-rcv-i.artic     = buf-fp_ord-line.artic and
     5608                   p_ord-line-rcv-i.prod-code = buf-fp_ord-line.prod-code and
     5609                   p_ord-line-rcv-i.prod-type = buf-fp_ord-line.prod-type ,
     5610                first p_ord-doc-rcv-i no-lock where
     5611                     p_ord-doc-rcv-i.doc-code  = p_ord-line-rcv-i.doc-code and
     5612                     p_ord-doc-rcv-i.rcv-code  = p_ord-line-rcv-i.rcv-code and
     5613                     p_ord-doc-rcv-i.obj-type  = b-of_ord-doc.obj-type  and
     5614                     p_ord-doc-rcv-i.obj-code  = b-of_ord-doc.obj-code  and
     5615                     p_ord-line-rcv-i.rcv-code  <> ub.ord-line-rcv.rcv-code  and
     5616                     p_ord-doc-rcv-i.cons-code = loc-ord-cons-code
     5617           :
     5618          p_fp0 = p_fp0 + p_ord-line-rcv-i.qnty .
     5619          end.
     5620         loc-var-qnty-rcv = loc-var-qnty-rcv - p_fp0 .
     5621         loc-var-qnty-rcv = if  loc-var-qnty-rcv < 0 then 0 else loc-var-qnty-rcv.
     5622           assign
     5623             ub.ord-line-rcv.qnty      = min (loc-var-qnty , loc-all-rcv , loc-var-qnty-rcv)
     5624             ub.ord-line-rcv.qnty      = if ub.ord-line-rcv.qnty < 0 then 0 else ub.ord-line-rcv.qnty
     5625             ub.ord-line-rcv.cli-qnty  = ub.ord-line-rcv.qnty / ub.ord-line-rcv.cli-base-rate
     5626             .
     5627       end.
     5628       else do:
     5629          find first buf-tt-goods  where
     5630                  buf-tt-goods.gds-t     = 'товар':U           and
     5631                  buf-tt-goods.artic     = buf-fp_ord-line.artic and
     5632                  buf-tt-goods.prod-code = buf-fp_ord-line.prod-code and
     5633                  buf-tt-goods.prod-type = buf-fp_ord-line.prod-type no-lock no-error .
     5634                  loc-all-rcv = if  buf-tt-goods.sum-ord - buf-tt-goods.sum-rcv < 0 then 0 else (buf-tt-goods.sum-ord - buf-tt-goods.sum-rcv ) .
     5635          define buffer p_ord-line-rcv for ub.ord-line-rcv .
     5636          define buffer p_ord-doc-rcv  for ub.ord-doc-rcv  .
     5637          define variable p_fp as decimal no-undo .
     5638          p_fp = 0.
     5639          for each p_ord-line-rcv no-lock where
     5640                   p_ord-line-rcv.doc-code  = buf-fp_ord-line.doc-code and
     5641                   p_ord-line-rcv.artic     = buf-fp_ord-line.artic and
     5642                   p_ord-line-rcv.prod-code = buf-fp_ord-line.prod-code and
     5643                   p_ord-line-rcv.prod-type = buf-fp_ord-line.prod-type,
     5644                first p_ord-doc-rcv no-lock where
     5645                                            p_ord-line-rcv.doc-code  = p_ord-doc-rcv.doc-code  and
     5646                                            p_ord-line-rcv.rcv-code  = p_ord-doc-rcv.rcv-code  and
     5647                                            p_ord-line-rcv.rcv-code  <> ub.ord-line-rcv.rcv-code  and
     5648                                            p_ord-doc-rcv.cons-code = loc-ord-cons-code
     5649          :
     5650          p_fp = p_fp + p_ord-line-rcv.qnty .
     5651          end.
     5652           assign
     5653             ub.ord-line-rcv.qnty      = minimum ( (buf-fp_ord-line.qnty  - p_fp) , loc-all-rcv)
     5654             ub.ord-line-rcv.qnty      = if ub.ord-line-rcv.qnty < 0 then 0 else ub.ord-line-rcv.qnty
     5655             ub.ord-line-rcv.cli-qnty  = ub.ord-line-rcv.qnty / ub.ord-line-rcv.cli-base-rate
     5656             .
     5657       end.
     5658       loc-new = recid(ord-line-rcv) .
     5659       if avail b-of_ord-doc then do:
     5660       run create-dtl-rcv  in this-procedure
     5661       (     input  ub.ord-line-rcv.rcv-code ,
     5662             input  ub.ord-line-rcv.doc-code ,
     5663             input  "ord-fp"              ,
     5664             input  b-of_ord-doc.doc-code ,
     5665             input  ?                     ,
     5666             input  ub.ord-line-rcv.artic    ,
     5667             input  ub.ord-line-rcv.prod-type,
     5668             input  ub.ord-line-rcv.prod-code
     5669             ).
     5670       end.
     5671   if loc-make-avto = false then do:
     5672           run cus/or-obj.w
     5673           (      input  parParentProc
     5674                , input  g#host-code
     5675                , input  recid(ord-line-rcv)
     5676                , input  2
     5677                , input  'ИЗМЕНЕНИЕ':U
     5678                , input  "ЦИКЛ":U
     5679                , input-output  v-doc-mode  ) .
     5680       if v-doc-mode = "stopcycle":U  then do:
     5681           find first ub.ord-line-rcv  exclusive-lock  where
     5682                     ub.ord-line-rcv.doc-code  = buf-fp_ord-line.doc-code and
     5683                     ub.ord-line-rcv.rcv-code  = n-code and
     5684                     ub.ord-line-rcv.artic     = buf-fp_ord-line.artic and
     5685                     ub.ord-line-rcv.prod-code = buf-fp_ord-line.prod-code and
     5686                     ub.ord-line-rcv.prod-type = buf-fp_ord-line.prod-type no-error .
     5687          delete ub.ord-line-rcv.
     5688          return error  .
     5689       end.
     5690       if v-doc-mode = "cancel":U  then do:
     5691           find first ub.ord-line-rcv  exclusive-lock  where
     5692                       ub.ord-line-rcv.doc-code  = buf-fp_ord-line.doc-code and
     5693                       ub.ord-line-rcv.rcv-code  = n-code and
     5694                       ub.ord-line-rcv.artic     = buf-fp_ord-line.artic and
     5695                       ub.ord-line-rcv.prod-code = buf-fp_ord-line.prod-code and
     5696                       ub.ord-line-rcv.prod-type = buf-fp_ord-line.prod-type no-error .
     5697          delete ub.ord-line-rcv.
     5698       end.
     5699       l-rec = recid(ord-line-rcv).
     5700       end.
     5701    end.
     5702   end.
     5703   run calc-cons-ord in this-procedure .
     5704   end.
     5705   END PROCEDURE.
     5706   PROCEDURE create-line-rcv-in :
     5707    do
     5708    on error undo, return error return-value
     5709    :
     5710   define input parameter n-code  as   character no-undo .
     5711   define input parameter z-recid as   recid no-undo .
     5712   define input parameter p-ks    as   int  no-undo .
     5713   define input parameter p-qnty  like ub.ord-line-rcv.qnty   no-undo .
     5714   define output parameter l-rec  as   recid no-undo .
     5715   define buffer b-gds_ord-line for ub.ord-line .
     5716   define buffer b-of_ord-line  for ub.ord-line .
     5717   define buffer b-of_ord-doc   for ub.ord-doc  .
     5718   define buffer b-rcv_ord-doc-rcv   for ub.ord-doc-rcv  .
     5719   define buffer b-tt-goods          for tt-goods .
     5720   define variable loc-fact-qnty as decimal no-undo .
     5721   define variable v-doc-mode as character no-undo .
     5722   find first  b-gds_ord-line    no-lock  where recid(b-gds_ord-line) = z-recid       no-error .
     5723   find first  b-rcv_ord-doc-rcv no-lock  where b-rcv_ord-doc-rcv.rcv-code = n-code   no-error .
     5724   if avail b-gds_ord-line then do:
     5725     if not can-find  (first ub.ord-line-rcv where
     5726                   ub.ord-line-rcv.rcv-code  = n-code and
     5727                   ub.ord-line-rcv.artic     = b-gds_ord-line.artic and
     5728                   ub.ord-line-rcv.prod-code = b-gds_ord-line.prod-code and
     5729                   ub.ord-line-rcv.prod-type = b-gds_ord-line.prod-type no-lock ) then do:
     5730       find first b-tt-goods where
     5731                  b-tt-goods.gds-t     = 'товар':U and
     5732                  b-tt-goods.artic     = b-gds_ord-line.artic and
     5733                  b-tt-goods.prod-code = b-gds_ord-line.prod-code and
     5734                  b-tt-goods.prod-type = b-gds_ord-line.prod-type no-lock  .
     5735        loc-fact-qnty = b-tt-goods.sum-qnty - ( b-tt-goods.sum-ord + b-tt-goods.sum-rcv-in) .
     5736       define variable pp-qnty as decimal no-undo .
     5737       define variable pp-cli-qnty as decimal no-undo .
     5738       assign
     5739         pp-qnty      = if p-qnty > 0 then   minimum ( p-qnty , b-gds_ord-line.qnty , loc-fact-qnty ) else minimum ( b-gds_ord-line.qnty , loc-fact-qnty )
     5740         pp-qnty      = if pp-qnty < 0 then   0 else pp-qnty
     5741         pp-cli-qnty  = pp-qnty / b-gds_ord-line.cli-base-rate
     5742       .
     5743       run proc-create-rcv-line  in this-procedure
     5744       (  input b-gds_ord-line.SLT-pc
     5745         ,input b-gds_ord-line.VAT-pc
     5746         ,input b-gds_ord-line.artic
     5747         ,input b-gds_ord-line.cli-base-rate
     5748         ,input pp-cli-qnty
     5749         ,input ""
     5750         ,input b-gds_ord-line.excise
     5751         ,input b-gds_ord-line.gds-code
     5752         ,input p-ks
     5753         ,input b-gds_ord-line.other-base
     5754         ,input b-gds_ord-line.other-rubl
     5755         ,input b-gds_ord-line.price-base
     5756         ,input b-gds_ord-line.price-cli
     5757         ,input b-gds_ord-line.price-rubl
     5758         ,input b-gds_ord-line.prod-code
     5759         ,input b-gds_ord-line.prod-type
     5760         ,input pp-qnty
     5761         ,input n-code
     5762         ,input b-gds_ord-line.road-tax
     5763         ,input b-gds_ord-line.sum-SLT
     5764         ,input b-gds_ord-line.sum-VAT
     5765         ,input b-gds_ord-line.sum-base
     5766         ,input b-gds_ord-line.sum-cli
     5767         ,input b-gds_ord-line.sum-excise
     5768         ,input b-gds_ord-line.sum-other-base
     5769         ,input b-gds_ord-line.sum-other-rubl
     5770         ,input b-gds_ord-line.sum-road-tax
     5771         ,input b-gds_ord-line.sum-rubl
     5772         ,input b-gds_ord-line.sum-transport-base
     5773         ,input b-gds_ord-line.sum-transport-rubl
     5774         ,input b-gds_ord-line.transport-base
     5775         ,input b-gds_ord-line.transport-rubl
     5776         ,input b-gds_ord-line.unit-cli
     5777         ,input b-gds_ord-line.v-vat
     5778         ) no-error .
     5779       if not error-status :error then do:
     5780       run create-dtl-rcv in this-procedure
     5781       (     input  ub.ord-line-rcv.rcv-code ,
     5782             input  ub.ord-line-rcv.doc-code ,
     5783             input  "rcv-in"              ,
     5784             input  b-gds_ord-line.doc-code ,
     5785             input  ?                     ,
     5786             input  ub.ord-line-rcv.artic    ,
     5787             input  ub.ord-line-rcv.prod-type,
     5788             input  ub.ord-line-rcv.prod-code ).
     5789        end.
     5790   if loc-make-avto = false then do:
     5791           run cus/or-obj.w
     5792           (      input  parParentProc
     5793                , input  g#host-code
     5794                , input  recid(ord-line-rcv)
     5795                , input  2
     5796                , input  'ИЗМЕНЕНИЕ':U
     5797                , input  "ЦИКЛ":U
     5798                , input-output  v-doc-mode  ) .
     5799       if v-doc-mode = "stopcycle":U  then do:
     5800           find first ub.ord-line-rcv  exclusive-lock  where
     5801                       ub.ord-line-rcv.rcv-code  = n-code and
     5802                       ub.ord-line-rcv.artic     = b-gds_ord-line.artic and
     5803                       ub.ord-line-rcv.prod-code = b-gds_ord-line.prod-code and
     5804                       ub.ord-line-rcv.prod-type = b-gds_ord-line.prod-type no-error .
     5805         delete ub.ord-line-rcv.
     5806         return error.
     5807         end.
     5808       if v-doc-mode = "cancel":U  then do:
     5809           find first ub.ord-line-rcv  exclusive-lock  where
     5810                       ub.ord-line-rcv.rcv-code  = n-code and
     5811                       ub.ord-line-rcv.artic     = b-gds_ord-line.artic and
     5812                       ub.ord-line-rcv.prod-code = b-gds_ord-line.prod-code and
     5813                       ub.ord-line-rcv.prod-type = b-gds_ord-line.prod-type no-error .
     5814         delete ub.ord-line-rcv.
     5815         end.
     5816       l-rec = recid(ord-line-rcv).
     5817       end.
     5818    end.
     5819   end.
     5820   run calc-cons-ord in this-procedure .
     5821   end.
     5822   END PROCEDURE.
     5823   procedure del-zakaz-doc:
     5824    do
     5825    on error undo, return error return-value
     5826    :
     5827   def input param d-recid as recid no-undo.
     5828   find first  ub.ord-doc no-lock  where recid(ub.ord-doc) = d-recid no-error .
     5829   if ub.ord-doc.status_ <> 'новый':U then do:
     5830     message "Нельзя удалить документ в статусе " ub.ord-doc.status_ "! Можно только в статусе НОВЫЙ " view-as alert-box error .
     5831     return.
     5832   end.
     5833   for each ub.ord-doc  exclusive-lock  where recid(ub.ord-doc) = d-recid  :
     5834       delete ub.ord-doc.
     5835   end.
     5836   run calc-cons-ord in this-procedure  .
     5837   end.
     5838   END PROCEDURE.
     5839   procedure del-zakaz:
     5840    do
     5841    on error undo, return error return-value
     5842    :
     5843   def input param d-recid as recid no-undo.
     5844   find first  ub.ord-line no-lock  where recid(ord-line) = d-recid no-error .
     5845   find first  ub.ord-doc   exclusive-lock   where ub.ord-doc.doc-code = ub.ord-line.doc-code no-error .
     5846   if ub.ord-doc.status_ <> 'новый':U then do:
     5847     message "Нельзя удалить документ в статусе " ub.ord-doc.status_ "! Можно только в статусе НОВЫЙ " view-as alert-box error .
     5848     return.
     5849   end.
     5850   for each ub.ord-line  exclusive-lock  where recid(ord-line) = d-recid  :
     5851      delete ub.ord-line.
     5852   end.
     5853   find first  ub.ord-line no-lock  where ub.ord-doc.doc-code = ub.ord-line.doc-code  no-error .
     5854   if not available  ub.ord-line then do:
     5855       message "Теперь в заказе " ub.ord-doc.doc-code "нет ни одной строки ! Удаляем его ."
     5856               view-as alert-box information .
     5857       delete  ub.ord-doc no-error .
     5858   end.
     5859   run calc-cons-ord in this-procedure  .
     5860   end .
     5861   END PROCEDURE.
     5862   procedure del-post:
     5863    do
     5864    on error undo, return error return-value
     5865    :
     5866   def input param d-recid as recid no-undo.
     5867   find first  ub.ord-line-rcv no-lock  where recid(ord-line-rcv) = d-recid no-error .
     5868   find first  ub.ord-doc-rcv   exclusive-lock    where ub.ord-doc-rcv.doc-code = ub.ord-line-rcv.doc-code
     5869                                       and ub.ord-doc-rcv.rcv-code = ub.ord-line-rcv.rcv-code   no-error .
     5870       if available ub.ord-doc-rcv then do:
     5871         if ub.ord-doc-rcv.status_ <> 'новый':U then do:
     5872           message "Нельзя удалить поставку в статусе " ub.ord-doc-rcv.status_ "! Можно только в статусе НОВЫЙ " view-as alert-box error .
     5873           return.
     5874         end.
     5875         for each ub.ord-line-rcv exclusive-lock where recid(ord-line-rcv) = d-recid  :
     5876           delete ub.ord-line-rcv.
     5877         end.
     5878         find first  ub.ord-line-rcv no-lock  where ub.ord-doc-rcv.doc-code = ub.ord-line-rcv.doc-code
     5879                                           and ub.ord-doc-rcv.rcv-code = ub.ord-line-rcv.rcv-code   no-error .
     5880         if not available  ub.ord-line-rcv then do:
     5881            message "Теперь в поставке " ub.ord-doc-rcv.rcv-code "нет ни одной строки ! Удаляем ее ." view-as alert-box information .
     5882            delete  ub.ord-doc-rcv   no-error .
     5883         end.
     5884         run calc-cons-ord in this-procedure  .
     5885       end.
     5886   end.
     5887   END PROCEDURE.
     5888   procedure del-post-doc:
     5889    do
     5890    on error undo, return error return-value
     5891    :
     5892   def input param d-recid as recid no-undo.
     5893   find first  ub.ord-doc-rcv no-lock where recid(ub.ord-doc-rcv) = d-recid no-error .
     5894   if ub.ord-doc-rcv.status_ <> 'новый':U then do:
     5895     message "Нельзя удалить поставку в статусе " ub.ord-doc-rcv.status_ "! Можно только в статусе НОВЫЙ " view-as alert-box error .
     5896     return.
     5897   end.
     5898   for each ub.ord-doc-rcv  exclusive-lock   where recid(ub.ord-doc-rcv) = d-recid  :
     5899      delete ub.ord-doc-rcv.
     5900   end.
     5901   run calc-cons-ord in this-procedure  .
     5902   end.
     5903   END PROCEDURE.
     5904   procedure del-nacl:
     5905    do
     5906    on error undo, return error return-value
     5907    :
     5908   define variable dd as character no-undo .
     5909   def input param d-recid as recid no-undo.
     5910   for each ub.doc-line  exclusive-lock  where recid(doc-line) = d-recid :
     5911       dd = ub.doc-line.doc-code.
     5912      if ub.doc-line.status_ <> 'накл':U then leave.
     5913      delete ub.doc-line.
     5914   end.
     5915   find first  ub.doc-line no-lock  where ub.doc-line.doc-code = dd  no-error .
     5916   if not available  ub.doc-line then do:
     5917       message "Теперь в накладной " dd " нет ни одной строки ! Удаляем ее ."
     5918               view-as alert-box information .
     5919       find first ub.trn-doc  exclusive-lock  where ub.trn-doc.doc-code = dd no-error .
     5920         if available ub.trn-doc then   delete  ub.trn-doc no-error .
     5921   end.
     5922   run calc-cons-ord in this-procedure  .
     5923   end.
     5924   END PROCEDURE.
     5925   procedure del-nacl-doc:
     5926    do
     5927    on error undo, return error return-value
     5928    :
     5929   def input param d-recid as recid no-undo.
     5930   for each ub.trn-doc  exclusive-lock   where recid(trn-doc) = d-recid :
     5931      if ub.trn-doc.status_ <> 'накл':U then leave.
     5932      delete ub.trn-doc.
     5933   end.
     5934   run calc-cons-ord in this-procedure  .
     5935   end.
     5936   END PROCEDURE.
     5937   PROCEDURE del-mark :
     5938   do
     5939    on error undo, return error return-value
     5940    :
     5941   define variable  pp-rec as recid no-undo .
     5942   pp-rec = recid (tt-goods) .
     5943   for each tt-goods  exclusive-lock  :
     5944      tt-goods.use = false.
     5945   end.
     5946   OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.
     5947   reposition BROWSE-12 to recid pp-rec no-error .
     5948   end.
     5949   END PROCEDURE.
     5950   PROCEDURE disable_UI :
     5951     HIDE FRAME Dialog-Frame.
     5952     HIDE FRAME FRAME-A.
     5953     HIDE FRAME FRAME-B.
     5954     HIDE FRAME FRAME-B-prt.
     5955     HIDE FRAME FRAME-C.
     5956     HIDE FRAME FRAME-D.
     5957     HIDE FRAME FRAME-d-prt.
     5958     HIDE FRAME FRAME-E.
     5959     HIDE FRAME FRAME-E-prt.
     5960     HIDE FRAME FRAME-F.
     5961     HIDE FRAME FRAME-H.
     5962     HIDE FRAME FRAME-I.
     5963     HIDE FRAME FRAME-J.
     5964     HIDE FRAME FRAME-K.
     5965     HIDE FRAME FRAME-Post-prt.
     5966     HIDE FRAME FRAME-Postavki.
     5967   END PROCEDURE.
     5968   PROCEDURE dop-pr :
     5969   do
     5970    on error undo, return error return-value
     5971    :
     5972   define buffer tt-new-ord-line-2  for  ub.ord-line.
     5973       find first tt-new-ord-line-2  exclusive-lock   where recid(tt-new-ord-line-2) = recid(tt-new-ord-line) no-error .
     5974   assign
     5975   tt-new-ord-line-2.SLT-pc               = TMP#zakaz.SLT-pc
     5976   tt-new-ord-line-2.VAT-pc               = TMP#zakaz.VAT-pc
     5977   tt-new-ord-line-2.add-cli-qnty         = TMP#zakaz.add-cli-qnty
     5978   tt-new-ord-line-2.add-qnty             = TMP#zakaz.add-qnty
     5979   tt-new-ord-line-2.artic                = TMP#zakaz.artic
     5980   tt-new-ord-line-2.cancel-cli-qnty      = TMP#zakaz.cancel-cli-qnty
     5981   tt-new-ord-line-2.cancel-date          = TMP#zakaz.cancel-date
     5982   tt-new-ord-line-2.cancel-qnty          = TMP#zakaz.cancel-qnty
     5983   tt-new-ord-line-2.cli-art              = TMP#zakaz.cli-art
     5984   tt-new-ord-line-2.cli-base-rate        = TMP#zakaz.cli-base-rate
     5985   tt-new-ord-line-2.cli-qnty             = TMP#zakaz.cli-qnty
     5986   tt-new-ord-line-2.doc-code             = TMP#zakaz.doc-code
     5987   tt-new-ord-line-2.excise               = TMP#zakaz.excise
     5988   tt-new-ord-line-2.fact-date            = TMP#zakaz.fact-date
     5989   tt-new-ord-line-2.initial-cli-qnty     = TMP#zakaz.initial-cli-qnty
     5990   tt-new-ord-line-2.initial-qnty         = TMP#zakaz.initial-qnty
     5991   tt-new-ord-line-2.line-num             = TMP#zakaz.line-num
     5992   tt-new-ord-line-2.order-cli-qnty       = TMP#zakaz.order-cli-qnty
     5993   tt-new-ord-line-2.order-qnty           = TMP#zakaz.order-qnty
     5994   tt-new-ord-line-2.other-base           = TMP#zakaz.other-base
     5995   tt-new-ord-line-2.other-rubl           = TMP#zakaz.other-rubl
     5996   tt-new-ord-line-2.price-base           = TMP#zakaz.price-base
     5997   tt-new-ord-line-2.price-cli            = TMP#zakaz.price-cli
     5998   tt-new-ord-line-2.price-rubl           = TMP#zakaz.price-rubl
     5999   tt-new-ord-line-2.prod-code            = TMP#zakaz.prod-code
     6000   tt-new-ord-line-2.prod-type            = TMP#zakaz.prod-type
     6001   tt-new-ord-line-2.qnty                 = TMP#zakaz.qnty
     6002   tt-new-ord-line-2.receive-cli-qnty     = TMP#zakaz.receive-cli-qnty
     6003   tt-new-ord-line-2.receive-qnty         = TMP#zakaz.receive-qnty
     6004   tt-new-ord-line-2.road-tax             = TMP#zakaz.road-tax
     6005   tt-new-ord-line-2.sum-SLT              = TMP#zakaz.sum-SLT
     6006   tt-new-ord-line-2.sum-VAT              = TMP#zakaz.sum-VAT
     6007   tt-new-ord-line-2.sum-base             = TMP#zakaz.sum-base
     6008   tt-new-ord-line-2.sum-cli              = TMP#zakaz.sum-cli
     6009   tt-new-ord-line-2.sum-excise           = TMP#zakaz.sum-excise
     6010   tt-new-ord-line-2.sum-other-base       = TMP#zakaz.sum-other-base
     6011   tt-new-ord-line-2.sum-other-rubl       = TMP#zakaz.sum-other-rubl
     6012   tt-new-ord-line-2.sum-road-tax         = TMP#zakaz.sum-road-tax
     6013   tt-new-ord-line-2.sum-rubl             = TMP#zakaz.sum-rubl
     6014   tt-new-ord-line-2.sum-transport-base   = TMP#zakaz.sum-transport-base
     6015   tt-new-ord-line-2.sum-transport-rubl   = TMP#zakaz.sum-transport-rubl
     6016   tt-new-ord-line-2.transport-base       = TMP#zakaz.transport-base
     6017   tt-new-ord-line-2.transport-rubl       = TMP#zakaz.transport-rubl
     6018   tt-new-ord-line-2.unit-cli             = TMP#zakaz.unit-cli
     6019   tt-new-ord-line-2.v-vat                = TMP#zakaz.v-vat
     6020   .
     6021   end.
     6022   END PROCEDURE.
     6023   PROCEDURE enable_UI :
     6024     DISPLAY R-main str-good F-post-2 F-post F-obj
     6025         WITH FRAME Dialog-Frame.
     6026     ENABLE B-OK B-Help BUTTON-2 R-main BUTTON-3 BUTTON-47 str-good F-post-2
     6027            F-post F-obj RECT-3
     6028         WITH FRAME Dialog-Frame.
     6029     ENABLE BROWSE-37 BROWSE-36
     6030         WITH FRAME FRAME-B-prt.
     6031     OPEN QUERY BROWSE-36 FOR EACH obj_ord-dtl-rcv     WHERE x-artic      = obj_ord-dtl-rcv.artic and           x-prod-type  = obj_ord-dtl-rcv.prod-type and           x-prod-code  = obj_ord-dtl-rcv.prod-code and           string(obj_ord-dtl-rcv.node-code) MATCHES x-node-code NO-LOCK,            EACH obj_ord-doc-rcv           where obj_ord-doc-rcv.rcv-code     = obj_ord-dtl-rcv.rcv-code and                   obj_ord-doc-rcv.doc-code   = obj_ord-dtl-rcv.doc-code and                   obj_ord-doc-rcv.doc-type   = 'in' and                   obj_ord-doc-rcv.cons-code  = loc-ord-cons-code                  NO-LOCK,          first ub.gds-prt WHERE ub.gds-prt.node-code = obj_ord-dtl-rcv.node-code NO-LOCK.    OPEN QUERY BROWSE-37 FOR EACH obj_prt-obj               WHERE obj_prt-obj.is-term = true and                           x-artic      = obj_prt-obj.artic and                     x-prod-type  = obj_prt-obj.prod-type and                     x-prod-code  = obj_prt-obj.prod-code and                     string(obj_prt-obj.prt-code) MATCHES x-node-code NO-LOCK,              each ub.gds-prt WHERE ub.gds-prt.node-code = obj_prt-obj.prt-code NO-LOCK.
     6032     ENABLE BROWSE-32 BROWSE-33
     6033         WITH FRAME FRAME-E-prt.
     6034     OPEN QUERY BROWSE-32 FOR EACH e_fp_ord-dtl       WHERE x-artic      = e_fp_ord-dtl.artic and x-prod-type  = e_fp_ord-dtl.prod-type and x-prod-code  = e_fp_ord-dtl.prod-code and string(e_fp_ord-dtl.node-code) MATCHES x-node-code NO-LOCK,              EACH e_fp_ord-doc OF e_fp_ord-dtl where                        e_fp_ord-doc.cons-code = loc-ord-cons-code and                        e_fp_ord-doc.doc-type = 'ФП':U                       NO-LOCK,              first ub.gds-prt WHERE ub.gds-prt.node-code = e_fp_ord-dtl.node-code NO-LOCK.    OPEN QUERY BROWSE-33 FOR EACH e_fp_ord-dtl-rcv               WHERE x-artic      = e_fp_ord-dtl-rcv.artic and                     x-prod-type  = e_fp_ord-dtl-rcv.prod-type and                     x-prod-code  = e_fp_ord-dtl-rcv.prod-code and                     string(e_fp_ord-dtl-rcv.node-code) MATCHES x-node-code NO-LOCK,              EACH e_fp_ord-doc-rcv                              where e_fp_ord-doc-rcv.rcv-code            = e_fp_ord-dtl-rcv.rcv-code and                                               e_fp_ord-doc-rcv.doc-code     = e_fp_ord-dtl-rcv.doc-code and                        e_fp_ord-doc-rcv.cons-code  = loc-ord-cons-code and                        e_fp_ord-doc-rcv.doc-type    = "out":U                       NO-LOCK,              first ub.gds-prt WHERE ub.gds-prt.node-code = e_fp_ord-dtl-rcv.node-code NO-LOCK.
     6035     ENABLE BROWSE-26 BROWSE-27 B-make-post-ex-3 BUTTON-27 BUTTON-53 BUTTON-28
     6036            BUTTON-30 BUTTON-54 BUTTON-31
     6037         WITH FRAME FRAME-K.
     6038     OPEN QUERY BROWSE-26 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ФП':U and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code and ub.ord-doc.cli-type = buf_clients.obj-type))  NO-LOCK,       FIRST ub.shar-buf_ord-doc WHERE shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code NO-LOCK.    OPEN QUERY BROWSE-27 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-code = loc-num-ord-FP and ub.ord-doc-rcv.doc-type = 'out':U       and ub.ord-doc-rcv.cons-code = loc-ord-cons-code  NO-LOCK.
     6039     ENABLE BROWSE-18 BROWSE-28 B-make-post-ex-2 BUTTON-9 BUTTON-55 BUTTON-10
     6040            BUTTON-33 BUTTON-56 BUTTON-34
     6041         WITH FRAME FRAME-J.
     6042     OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .    OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     6043     ENABLE BROWSE-23 BROWSE-24 BUTTON-48 BUTTON-17 BUTTON-57 BUTTON-18 BUTTON-21
     6044            BUTTON-20
     6045         WITH FRAME FRAME-I.
     6046     OPEN QUERY BROWSE-23 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-type = 'in'  AND ub.ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK.    OPEN QUERY BROWSE-24 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.doc-type = 'in' and             b-all_ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                  and            ub.ord-chain.rel-doc-type = 'trn' NO-LOCK,              EACH ub.trn-doc WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     6047     ENABLE B-make-trn-2 BUTTON-58 BROWSE-15 BROWSE-20 BUTTON-7 BUTTON-8 BUTTON-14
     6048         WITH FRAME FRAME-H.
     6049     OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.    OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     6050     ENABLE BROWSE-30
     6051         WITH FRAME FRAME-C.
     6052     OPEN QUERY BROWSE-30 FOR EACH tt-goods  NO-LOCK,              EACH ub.ord-gds-cons where             ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code   OUTER-JOIN   NO-LOCK     by tt-goods.nn .
     6053     ENABLE BROWSE-12 B-mark B-mark-3 B-mark-4
     6054         WITH FRAME FRAME-A.
     6055     OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.
     6056     ENABLE BROWSE-16 B-ins-za B-za-3 B-reject B-isk
     6057         WITH FRAME FRAME-F.
     6058     OPEN QUERY BROWSE-16 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK     BY ub.ord-doc.obj-type        BY ub.ord-doc.obj-code         BY ub.ord-doc.ship-date          BY ub.ord-doc.ship-time           BY ub.ord-doc.doc-code DESCENDING.
     6059     ENABLE BROWSE-31
     6060         WITH FRAME FRAME-d-prt.
     6061     OPEN QUERY BROWSE-31 FOR EACH ub.of_ord-dtl       WHERE x-artic      = of_ord-dtl.artic and x-prod-type  = of_ord-dtl.prod-type and x-prod-code  = of_ord-dtl.prod-code and string(of_ord-dtl.node-code) MATCHES x-node-code NO-LOCK,       EACH ub.of_ord-doc OF ub.of_ord-dtl       WHERE of_ord-doc.cons-code = loc-ord-cons-code and of_ord-doc.doc-type = 'ОФ':U NO-LOCK,       EACH ub.gds-prt WHERE ub.gds-prt.node-code = of_ord-dtl.node-code NO-LOCK.
     6062     ENABLE BROWSE-13
     6063         WITH FRAME FRAME-D.
     6064     VIEW FRAME FRAME-D.
     6065     OPEN QUERY BROWSE-13 FOR EACH ub.m_ord-line       WHERE x-artic      = m_ord-line.artic and x-prod-type  = m_ord-line.prod-type and x-prod-code  = m_ord-line.prod-code  NO-LOCK,       EACH ub.ord-doc WHERE ub.ord-doc.doc-code = m_ord-line.doc-code       AND ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK.
     6066     DISPLAY T-cli T-cli-fp
     6067         WITH FRAME FRAME-E.
     6068     ENABLE BROWSE-17 T-cli T-cli-fp
     6069         WITH FRAME FRAME-E.
     6070     OPEN QUERY BROWSE-17 FOR EACH ub.buf_clients       WHERE ( buf_clients.sup-cons = true  OR buf_clients.sup-gds = true ) NO-LOCK,       FIRST ub.cli-gds WHERE ub.cli-gds.cli-code = buf_clients.obj-code   AND ub.cli-gds.cli-type = buf_clients.obj-type       AND ub.cli-gds.artic = x-artic and cli-gds.prod-type = x-prod-type and ub.cli-gds.host-code = g#host-code and cli-gds.prod-code = x-prod-code  NO-LOCK.
     6071     ENABLE BROWSE-21 BROWSE-29 BROWSE-22 B-make-trn BUTTON-50 BUTTON-52 BUTTON-49
     6072            BUTTON-51
     6073         WITH FRAME FRAME-Postavki.
     6074     OPEN QUERY BROWSE-21 FOR EACH new-rcv       WHERE new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH bb_ord-doc WHERE new-rcv.doc-code = bb_ord-doc.doc-code  OUTER-JOIN NO-LOCK.    OPEN QUERY BROWSE-22 for each ub.ord-chain no-lock where         ub.ord-chain.doc-code = new-rcv.rcv-code and         ub.ord-chain.doc-type = 'rcv'            and         ub.ord-chain.rel-doc-type = 'trn',        EACH ub.trn-doc       WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK .    OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.
     6075     DISPLAY T-obj
     6076         WITH FRAME FRAME-B.
     6077     ENABLE BROWSE-14 T-obj
     6078         WITH FRAME FRAME-B.
     6079     OPEN QUERY BROWSE-14 FOR EACH my-obj NO-LOCK,              EACH buf_gds-obj where              my-obj.obj-code = buf_gds-obj.obj-code and                       my-obj.obj-type = buf_gds-obj.obj-type and                   x-artic      = buf_gds-obj.artic     and             x-prod-type  = buf_gds-obj.prod-type and             x-prod-code  = buf_gds-obj.prod-code       NO-LOCK.
     6080   END PROCEDURE.
     6081   PROCEDURE hide-all-button :
     6082   do
     6083    on error undo, return error return-value
     6084    :
     6085   Hide b-mark  in frame frame-A
     6086        b-mark-3 in frame frame-A
     6087        b-mark-4 in frame frame-A .
     6088     hide  b-ins-za  in frame frame-F
     6089           b-reject in frame frame-F
     6090           b-isk    in frame frame-F
     6091           .
     6092     hide
     6093       button-7 in frame frame-H
     6094       button-8 in frame frame-H
     6095       button-15 in frame frame-H
     6096       button-14 in frame frame-H
     6097       b-make-trn-2 in frame frame-h .
     6098        .
     6099      hide
     6100       button-17 in frame frame-I
     6101       button-18 in frame frame-I
     6102       button-20 in frame frame-I
     6103       button-48 in frame frame-I
     6104       .
     6105     hide
     6106       button-51 in frame frame-postavki
     6107       button-50 in frame frame-postavki
     6108       b-make-trn in frame frame-postavki .
     6109     hide
     6110       button-27  in frame frame-k
     6111       button-28 in frame frame-k
     6112       button-30 in frame frame-k
     6113       button-31 in frame frame-k
     6114       b-make-post-ex-3 in frame frame-k .
     6115     hide
     6116       button-9  in frame frame-J
     6117       button-10 in frame frame-J
     6118       button-33 in frame frame-J
     6119       button-34 in frame frame-J
     6120       B-mark-2  in frame frame-J
     6121       b-make-post-ex-2 in frame frame-J.
     6122   end.
     6123   END PROCEDURE.
     6124   PROCEDURE hide-create-button :
     6125   do
     6126    on error undo, return error return-value
     6127    :
     6128   hide
     6129     b-make-trn-2 in frame frame-h .
     6130       .
     6131     hide
     6132     button-48 in frame frame-I
     6133     .
     6134   hide
     6135     b-make-trn in frame frame-postavki .
     6136   hide
     6137     b-make-post-ex-3 in frame frame-k .
     6138   hide
     6139     b-make-post-ex-2 in frame frame-J.
     6140   end.
     6141   END PROCEDURE.
     6142   PROCEDURE init-2 :
     6143   do
     6144    on error undo, return error return-value
     6145    :
     6146   define buffer bf_ord-cons for ub.ord-cons .
     6147      apply "CHOOSE":U to BUTTON-2 in frame Dialog-Frame.
     6148    if list-mode = "obj":U then do:
     6149      apply "CHOOSE":U to BUTTON-47 in frame Dialog-Frame.
     6150      end.
     6151   VIEW FRAME FRAME-A.
     6152   apply "VALUE-CHANGED":U to BROWSE-12 IN FRAME FRAME-A.
     6153   VIEW FRAME FRAME-D.
     6154     OPEN QUERY BROWSE-13 FOR EACH ub.m_ord-line       WHERE x-artic      = m_ord-line.artic and x-prod-type  = m_ord-line.prod-type and x-prod-code  = m_ord-line.prod-code  NO-LOCK,       EACH ub.ord-doc WHERE ub.ord-doc.doc-code = m_ord-line.doc-code       AND ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK.
     6155   if doc-mode = 'ПРОСМОТР':U then do:
     6156      run hide-all-button in this-procedure .
     6157   end.
     6158   find first bf_ord-cons no-lock  where bf_ord-cons.cons-code = loc-ord-cons-code no-error .
     6159   if not avail bf_ord-cons then return error.
     6160   if doc-mode = 'ИЗМЕНЕНИЕ':U and bf_ord-cons.status_ <>  'новый':U  and list-mode <> "obj":U  then do:
     6161      disable b-ins-za B-reject b-isk with frame FRAME-F.
     6162   end.
     6163   if doc-mode = 'ИЗМЕНЕНИЕ':U and bf_ord-cons.status_ =  'закрыто':U  and list-mode <> "obj":U  then do:
     6164      run hide-all-button in this-procedure .
     6165   end.
     6166   if doc-mode = 'ИЗМЕНЕНИЕ':U and bf_ord-cons.status_ =  'новый':U  and list-mode <> "obj":U then do:
     6167      run hide-create-button in this-procedure .
     6168   end.
     6169   if doc-mode = 'ИЗМЕНЕНИЕ':U and ( bf_ord-cons.status_ =  'новый':U  )
     6170                           and list-mode = "obj":U  then do:
     6171      run hide-all-button in this-procedure .
     6172   end.
     6173   if doc-mode = 'ИЗМЕНЕНИЕ':U and ( bf_ord-cons.status_ =  'закрыто':U  OR bf_ord-cons.status_ =  'распределение':U  )
     6174                           and list-mode = "obj":U  then do:
     6175      run hide-all-button in this-procedure .
     6176      view b-make-trn in frame frame-postavki .
     6177   end.
     6178   end.
     6179   END PROCEDURE.
     6180   PROCEDURE init-ord-gds :
     6181   do
     6182    on error undo, return error return-value
     6183    :
     6184   define variable t-ret as logical no-undo .
     6185    t-ret =  session:SET-WAIT-STATE("GENERAL") .
     6186     for each tt-ord-gds  exclusive-lock  :
     6187       delete tt-ord-gds.
     6188     end.
     6189   t-ret =  session:SET-WAIT-STATE("") .
     6190   end.
     6191   END PROCEDURE.
     6192   PROCEDURE init-proc :
     6193   do
     6194    on error undo, return error return-value
     6195    :
     6196   define variable t-ret as logical no-undo .
     6197   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6198   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6200     (input  store-type
     6201     ,input  store-code
     6202     ,output to-day
     6203     )  .
     6204    t-ret =  session:SET-WAIT-STATE("GENERAL") .
     6205   assign
     6206     loc-ord-cons-code = p-cons-code
     6207     x-mode = "constype":U
     6208     .
     6209     tt-goods.artic :read-only in browse browse-12 = true .
     6210     ub.trn-doc.doc-code :read-only in browse browse-15 = true .
     6211     tt-new-ord-line.qnty :read-only in browse browse-18 = true .
     6212     ub.ord-line-rcv.rcv-code :read-only in browse browse-20 = true .
     6213     ub.ord-doc.doc-code :read-only in browse browse-26 = true .
     6214     ub.ord-doc-rcv.rcv-code :read-only in browse browse-27 = true .
     6215     tt-goods.artic :read-only in browse browse-30 = true .
     6216     ub.ord-line-rcv.qnty :read-only in browse browse-29 = true .
     6217     for each  ub.ord-gds-cons no-lock  where
     6218               ub.ord-gds-cons.cons-code = loc-ord-cons-code
     6219               ,
     6220       first ub.goods no-lock where
     6221             ub.goods.artic     = ub.ord-gds-cons.artic and
     6222             ub.goods.prod-code = ub.ord-gds-cons.prod-code and
     6223             ub.goods.prod-type = ub.ord-gds-cons.prod-type
     6224             :
     6225         dk = dk + 1.
     6226         create tt-goods.
     6227         buffer-copy ub.goods to tt-goods
     6228         assign
     6229           tt-goods.nn        = dk
     6230           tt-goods.gds-t     = 'товар':U
     6231           tt-goods.sum-qnty  = ub.ord-gds-cons.sum-qnty
     6232           tt-goods.prt-name  = ""
     6233           tt-goods.all-name  = tt-goods.gds-name
     6234           tt-goods.node-code = 0
     6235         .
     6236         for each ub.ord-dtl-cons no-lock where
     6237                  ub.ord-dtl-cons.cons-code = loc-ord-cons-code and
     6238                  ub.ord-dtl-cons.artic     = ub.ord-gds-cons.artic and
     6239                  ub.ord-dtl-cons.prod-code = ub.ord-gds-cons.prod-code and
     6240                  ub.ord-dtl-cons.prod-type = ub.ord-gds-cons.prod-type  :
     6241                  find first ub.gds-prt no-lock  where ub.gds-prt.node-code =  ub.ord-dtl-cons.node-code no-error .
     6242                  if error-status :error then next.
     6243                  dk = dk + 1.
     6244                 create tt-goods.
     6245                 buffer-copy ub.goods to tt-goods
     6246                 assign
     6247                   tt-goods.nn = dk
     6248                   tt-goods.gds-t = 'признак':U
     6249                   tt-goods.sum-qnty = ub.ord-dtl-cons.sum-qnty
     6250                   tt-goods.prt-name = ub.gds-prt.f-name
     6251                   tt-goods.all-name = "- "  +  ub.gds-prt.f-name
     6252                   tt-goods.node-code =  ub.ord-dtl-cons.node-code
     6253                 .
     6254         end.
     6255     end.
     6256   for each ub.shop  no-lock where ub.shop.host-code = g#host-code  :
     6257       find first ub.clients no-lock where
     6258                  ub.clients.obj-code = ub.shop.obj-code and
     6259                  ub.clients.obj-type = 'маг':U
     6260                  no-error .
     6261       if available  ub.shop and available ub.clients then do :
     6262           create my-obj .
     6263           assign
     6264             my-obj.obj-code = ub.shop.obj-code
     6265             my-obj.obj-type = 'маг':U
     6266             my-obj.obj-name = ub.clients.obj-name
     6267             .
     6268        end.
     6269   end.
     6270   for each ub.store no-lock where ub.store.host-code = g#host-code :
     6271       find first ub.clients no-lock  where
     6272                  ub.clients.obj-code = ub.store.obj-code and
     6273                  ub.clients.obj-type = 'скл':U
     6274                  no-error .
     6275       if available  ub.store and available ub.clients then do:
     6276           create  my-obj .
     6277           assign  my-obj.obj-code = ub.store.obj-code
     6278                   my-obj.obj-type = 'скл':U
     6279                   my-obj.obj-name = ub.clients.obj-name
     6280           .
     6281        end.
     6282   end.
     6283   ttt = "Планирование СОВОКУПНОЙ ЗАЯВКИ "  + p-cons-code  + " - " + doc-mode.
     6284   frame Dialog-Frame:title = ttt.
     6285   ASSIGN B-make-post-ex-3:POPUP-MENU IN FRAME frame-k = MENU POPUP-MENU-B-make-post-ex-3:HANDLE.
     6286   ASSIGN B-make-post-ex-3:MENU-MOUSE = 1.
     6287   ASSIGN B-make-post-ex-2:POPUP-MENU IN FRAME frame-j = MENU POPUP-MENU-B-make-post-ex-2:HANDLE.
     6288   ASSIGN B-make-post-ex-2:MENU-MOUSE = 1.
     6289   ASSIGN B-make-trn-2:POPUP-MENU IN FRAME frame-H = MENU POPUP-MENU-B-make-trn-2:HANDLE.
     6290   ASSIGN B-make-trn-2:MENU-MOUSE = 1.
     6291   ASSIGN B-make-trn:POPUP-MENU IN FRAME frame-Postavki = MENU POPUP-MENU-B-make-trn:HANDLE.
     6292   ASSIGN B-make-trn:MENU-MOUSE = 1.
     6293   ASSIGN BUTTON-48:POPUP-MENU IN FRAME frame-I = MENU POPUP-MENU-BUTTON-48:HANDLE.
     6294   ASSIGN BUTTON-48:MENU-MOUSE = 1.
     6295   define variable t-h as character no-undo .
     6296    run read-handle in this-procedure (input browse-18:handle ,                        output t-h ) .                        handle-br-all[18] = t-h .
     6297   run read-handle in this-procedure (input browse-28:handle ,                        output t-h ) .                        handle-br-all[28] = t-h .
     6298   run read-handle in this-procedure (input browse-26:handle ,                        output t-h ) .                        handle-br-all[26] = t-h .
     6299   run read-handle in this-procedure (input browse-27:handle ,                        output t-h ) .                        handle-br-all[27] = t-h .
     6300   run read-handle in this-procedure (input browse-20:handle ,                        output t-h ) .                        handle-br-all[20] = t-h .
     6301   run read-handle in this-procedure (input browse-15:handle ,                        output t-h ) .                        handle-br-all[15] = t-h .
     6302   run read-handle in this-procedure (input browse-23:handle ,                        output t-h ) .                        handle-br-all[23] = t-h .
     6303   run read-handle in this-procedure (input browse-24:handle ,                        output t-h ) .                        handle-br-all[24] = t-h .
     6304   run calc-cons-ord in this-procedure .
     6305   t-ret =  session:SET-WAIT-STATE("") .
     6306   end.
     6307   END PROCEDURE.
     6308   PROCEDURE local-mark :
     6309   do
     6310    on error undo, return error return-value
     6311    :
     6312   if not available tt-new-ord-line then do:
     6313       message "Неправильный выбор строки.".
     6314       return no-apply.
     6315     end.
     6316   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6317   define variable v-str-recid33 as character no-undo .
     6318   define variable v-num-entry33 as integer   no-undo .
     6319   assign
     6320     v-str-recid33 = trim( string( recid( tt-new-ord-line ) , "->>>>>>>>>>>9":U ) )
     6321     v-num-entry33 = lookup( v-str-recid33 , del-list )
     6322   .
     6323   if v-num-entry33 > 0 then do:
     6324     assign
     6325       entry( v-num-entry33, del-list ) = "":U
     6326       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     6327     .
     6328   end.
     6329   else do:
     6330     assign
     6331       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid33
     6332     .
     6333   end.
     6334     if lookup(string( recid(tt-new-ord-line) ), del-list ) > 0
     6335         then disp "" @ mark with browse browse-18.
     6336         else disp "+" @ mark with browse browse-18.
     6337     apply "VALUE-CHANGED" to browse-18 in frame frame-J.
     6338     g#log = browse-18:select-next-row ().
     6339   end.
     6340   END PROCEDURE.
     6341   PROCEDURE make-fp :
     6342   do
     6343    on error undo, return error return-value
     6344    :
     6345   define input  parameter l-mod as character no-undo .
     6346   define output parameter o-rec as recid no-undo.
     6347   define variable ks as integer no-undo .
     6348   define variable v-num-OF as character no-undo .
     6349   define variable g-recid as recid no-undo .
     6350   define buffer nbn_ord-line for ub.ord-line .
     6351   ks = 0.
     6352   find current buf_clients no-lock no-error .
     6353   if not available  buf_clients then do:
     6354      message "Не выбран Поставщик !!! " .
     6355      return.
     6356   end.
     6357   if l-mod = "1" then do:
     6358       find current tt-goods no-lock no-error .
     6359       if not available  tt-goods then do:
     6360         message "Не выбран Товар !!! " .
     6361         return.
     6362       end.
     6363   end.
     6364   if l-mod = "2" then do:
     6365       find current tt-goods no-lock no-error .
     6366       if not available  tt-goods then do:
     6367         message "Не выбран Товар !!! " .
     6368         return.
     6369       end.
     6370       g-recid = recid(tt-goods) .
     6371   end.
     6372   if l-mod = "3" then do:
     6373   define variable doc-code-z as character no-undo .
     6374     doc-code-z  = ub.ord-doc.doc-code:screen-value in browse browse-16  .
     6375     if doc-code-z = ? then return.
     6376   end.
     6377     v-num-OF = doc-code-z  .
     6378   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6379   run proc-ord-code in this-procedure
     6380    (input   'main' ,
     6381     input   v-cntxt-db-num ,
     6382     input   v-cntxt-obj-type ,
     6383     input   v-cntxt-obj-code ,
     6384     input   v-i-doc ,
     6385     output  loc-ord-num
     6386    ) .
     6387   define variable vvv as logical no-undo .
     6388   define buffer b-ord-doc for ub.ord-doc .
     6389     vvv = false  .
     6390   find first  ub.ord-doc  exclusive-lock   where
     6391        ub.ord-doc.cli-code  = buf_clients.obj-code and
     6392        ub.ord-doc.cli-type  = buf_clients.obj-type and
     6393        ub.ord-doc.cons-code = p-cons-code and
     6394        ub.ord-doc.host-code = g#host-code and
     6395        ub.ord-doc.doc-type  = 'ФП':U
     6396        no-error .
     6397   if not available ub.ord-doc then do:
     6398      vvv = true .
     6399      create ub.ord-doc.
     6400      assign
     6401         ub.ord-doc.doc-code  = loc-ord-num
     6402         ub.ord-doc.cli-code  = buf_clients.obj-code
     6403         ub.ord-doc.cli-type  = buf_clients.obj-type
     6404         ub.ord-doc.cli-name  = buf_clients.obj-name
     6405         ub.ord-doc.cons-code = p-cons-code
     6406         ub.ord-doc.host-code = g#host-code
     6407         ub.ord-doc.obj-code  = store-code
     6408         ub.ord-doc.obj-type  = store-type
     6409         ub.ord-doc.doc-type  = 'ФП':U
     6410         ub.ord-doc.status_   = 'новый':U
     6411         ub.ord-doc.start-date = to-day - 7
     6412         ub.ord-doc.end-date   = to-day
     6413         ub.ord-doc.doc-date  = to-day
     6414         ub.ord-doc.ship-date = to-day + 1
     6415         ub.ord-doc.date-sale-1 = to-day + 1
     6416         ub.ord-doc.date-sale-2 = to-day + 2
     6417         ub.ord-doc.ship-time = 0
     6418          .
     6419         ub.ord-doc.exch-code = 0 .
     6420         find ub.currency no-lock  where ub.currency.curr-code = ub.ord-doc.exch-code no-error.
     6421           if available ub.currency then do:
     6422               find last ub.curr-accnt no-lock   where ub.curr-accnt.curr-code = ub.currency.curr-code  use-index pi no-error.
     6423                 if available ub.curr-accnt then assign
     6424                   ub.ord-doc.exch-rate = ub.curr-accnt.exch-rate
     6425                   ub.ord-doc.exch-scale = ub.curr-accnt.exch-scale.
     6426               find last ub.curr-accnt no-lock  where ub.curr-accnt.curr-code = base-code  use-index pi no-error .
     6427               assign
     6428                 ub.ord-doc.base-rate  = ub.curr-accnt.exch-rate
     6429                 ub.ord-doc.base-scale = ub.curr-accnt.exch-scale
     6430                 .
     6431          end.
     6432          ub.ord-doc.vat-type = 'в т. ч.':U .
     6433          ub.ord-doc.slt-type = 'без':U .
     6434    x-make-avto = 2 .
     6435    run cus/or-head.w ( parParentProc, input loc-ord-num , input vvv , output doc-mode ) .
     6436    if available ord-doc then do:
     6437       loc-ord-num = ord-doc.doc-code.
     6438    end.
     6439     case x-make-avto :
     6440       when 1 then loc-make-avto = true  .
     6441       when 4 then loc-make-avto = true  .
     6442       when 2 then loc-make-avto = false  .
     6443       when 3 then loc-make-avto = ? .
     6444     end case.
     6445   end.
     6446   else do:
     6447      message "Уже существует заказ ФП " ub.ord-doc.doc-code  skip
     6448               "Контрагент -код: " ub.ord-doc.cli-code        skip
     6449               "Контрагент -тип: " ub.ord-doc.cli-type        skip
     6450               "Контрагент -имя: " ub.ord-doc.cli-name        skip
     6451               "Будем делать новый заказ ?"  view-as alert-box question buttons yes-no update g#lok as logical.
     6452      if g#lok = false  then do:
     6453           assign loc-ord-num = ub.ord-doc.doc-code .
     6454         end.
     6455         else do:
     6456           BUFFER-COPY ub.ord-doc to b-ord-doc
     6457           assign b-ord-doc.doc-code = loc-ord-num
     6458                  b-ord-doc.status_   = 'новый':U
     6459           .
     6460           x-make-avto = 2 .
     6461           run cus/or-head.w (parParentProc,input loc-ord-num , true , output doc-mode ) .
     6462     case x-make-avto :
     6463       when 1 then loc-make-avto = true  .
     6464       when 4 then loc-make-avto = true  .
     6465       when 2 then loc-make-avto = false  .
     6466       when 3 then loc-make-avto = ? .
     6467     end case .
     6468         end.
     6469   end.
     6470    define variable ll-d as character no-undo .
     6471    ll-d = loc-ord-num .
     6472    if doc-mode = "cancel":U then return.
     6473    ks = 0 .
     6474   line-mode = 'ИЗМЕНЕНИЕ':U .
     6475   doc-rec = recid(ub.ord-doc) .
     6476   case l-mod :
     6477   when "1" then do:
     6478   define variable r-tmp as recid no-undo.
     6479   define variable r-stop as log no-undo.
     6480   define variable r-exit  as log no-undo.
     6481   define variable ii as integer no-undo .
     6482     for each tt-goods no-lock  where
     6483              tt-goods.use = true :
     6484         run create-line-fp  in this-procedure ( input loc-ord-num , output r-tmp) no-error .
     6485             if error-status :error then leave.
     6486             r-tmp = line-rec.
     6487         run create-dtl-fp in this-procedure
     6488                           ( input loc-ord-num,
     6489                             input "ord-cons",
     6490                             input loc-ord-cons-code,
     6491                             input tt-goods.artic,
     6492                             input tt-goods.prod-type,
     6493                             input tt-goods.prod-code ,
     6494                             input tt-goods.cli-base-rate ).
     6495          ks = ks + 1 .
     6496          end.
     6497     end.
     6498   when "2" then do:
     6499     for each tt-goods no-lock  where recid(tt-goods)  = g-recid :
     6500         run create-line-fp in this-procedure ( input loc-ord-num , output r-tmp ) no-error .
     6501         if error-status :error then leave.
     6502         run create-dtl-fp in this-procedure
     6503                           ( input loc-ord-num,
     6504                             input "ord-cons",
     6505                             input loc-ord-cons-code,
     6506                             input tt-goods.artic,
     6507                             input tt-goods.prod-type,
     6508                             input tt-goods.prod-code ,
     6509                             input tt-goods.cli-base-rate ).
     6510          ks = ks + 1 .
     6511     end.
     6512   end.
     6513   when "3" then do:
     6514       for each m_ord-line no-lock  where
     6515                m_ord-line.doc-code = v-num-OF :
     6516           ks = ks + 1 .
     6517           find first nbn_ord-line no-lock where
     6518                 nbn_ord-line.doc-code   = loc-ord-num and
     6519                 nbn_ord-line.artic      = m_ord-line.artic and
     6520                 nbn_ord-line.prod-code  = m_ord-line.prod-code and
     6521                 nbn_ord-line.prod-type  = m_ord-line.prod-type
     6522                 no-error .
     6523           if not available nbn_ord-line then do:
     6524               create  nbn_ord-line.
     6525               BUFFER-COPY m_ord-line to nbn_ord-line
     6526               assign
     6527                 nbn_ord-line.doc-code           = loc-ord-num
     6528                 nbn_ord-line.line-num           = ks
     6529               .
     6530             run last-price  in this-procedure
     6531             (     input  g#host-code        ,
     6532                   input  nbn_ord-line.artic     ,
     6533                   input  nbn_ord-line.prod-type ,
     6534                   input  nbn_ord-line.prod-code ,
     6535                   input  ub.ord-doc.cli-code   ,
     6536                   input  ub.ord-doc.cli-type   ,
     6537                   input  nbn_ord-line.cli-base-rate  ,
     6538                   input  ub.ord-doc.exch-code  ,
     6539                   output nbn_ord-line.price-base,
     6540                   output nbn_ord-line.price-rubl,
     6541                   output nbn_ord-line.price-cli  )
     6542                   no-error  .
     6543                   if error-status :error then message
     6544                     vss-workfile vss-revision vss-description skip
     6545                     error-status :get-message(1) skip
     6546                     return-value skip
     6547                     "Ошибка last-price"
     6548                     view-as alert-box error
     6549                   .
     6550                   assign
     6551                     nbn_ord-line.sum-base = nbn_ord-line.price-base * nbn_ord-line.qnty
     6552                     nbn_ord-line.sum-rubl = nbn_ord-line.price-rubl * nbn_ord-line.qnty
     6553                     nbn_ord-line.sum-cli  = nbn_ord-line.price-cli  * nbn_ord-line.cli-qnty
     6554                   .
     6555   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6556   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6557     (input  nbn_ord-line.gds-code
     6558     ,input  '1':U
     6559     ,input  ?
     6560     ,input  g#host-code
     6561     ,input  store-type
     6562     ,input  store-code
     6563     ,output nbn_ord-line.vat-pc
     6564     ) no-error .
     6565                   if error-status :error then message
     6566                     vss-workfile vss-revision vss-description skip
     6567                     error-status :get-message(1) skip
     6568                     return-value skip
     6569                     "Ошибка определения НДС"
     6570                     view-as alert-box error
     6571                   .
     6572             find first  tmp#zakaz where
     6573                         TMP#zakaz.artic     = nbn_ord-line.artic and
     6574                         TMP#zakaz.prod-code = nbn_ord-line.prod-code and
     6575                         TMP#zakaz.prod-type = nbn_ord-line.prod-type  no-error .
     6576             if not available Tmp#zakaz then do:
     6577                 create TMP#zakaz.
     6578             end.
     6579                 assign
     6580                       TMP#zakaz.SLT-pc                = nbn_ord-line.SLT-pc
     6581                       TMP#zakaz.VAT-pc                = nbn_ord-line.VAT-pc
     6582                       TMP#zakaz.add-cli-qnty          = nbn_ord-line.add-cli-qnty
     6583                       TMP#zakaz.add-qnty              = nbn_ord-line.add-qnty
     6584                       TMP#zakaz.artic                 = nbn_ord-line.artic
     6585                       TMP#zakaz.prod-code             = nbn_ord-line.prod-code
     6586                       TMP#zakaz.prod-type             = nbn_ord-line.prod-type
     6587                       TMP#zakaz.gds-code              = nbn_ord-line.gds-code
     6588                       TMP#zakaz.cancel-cli-qnty       = nbn_ord-line.cancel-cli-qnty
     6589                       TMP#zakaz.cancel-date           = nbn_ord-line.cancel-date
     6590                       TMP#zakaz.cancel-qnty           = nbn_ord-line.cancel-qnty
     6591                       TMP#zakaz.cli-art               = nbn_ord-line.cli-art
     6592                       TMP#zakaz.cli-base-rate         = nbn_ord-line.cli-base-rate
     6593                       TMP#zakaz.cli-qnty              = nbn_ord-line.cli-qnty
     6594                       TMP#zakaz.doc-code              = nbn_ord-line.doc-code
     6595                       TMP#zakaz.excise                = nbn_ord-line.excise
     6596                       TMP#zakaz.fact-date             = nbn_ord-line.fact-date
     6597                       TMP#zakaz.initial-cli-qnty      = nbn_ord-line.initial-cli-qnty
     6598                       TMP#zakaz.initial-qnty          = nbn_ord-line.initial-qnty
     6599                       TMP#zakaz.line-num              = nbn_ord-line.line-num
     6600                       TMP#zakaz.order-cli-qnty        = nbn_ord-line.order-cli-qnty
     6601                       TMP#zakaz.order-qnty            = nbn_ord-line.order-qnty
     6602                       TMP#zakaz.other-base            = nbn_ord-line.other-base
     6603                       TMP#zakaz.other-rubl            = nbn_ord-line.other-rubl
     6604                       TMP#zakaz.price-base            = nbn_ord-line.price-base
     6605                       TMP#zakaz.price-cli             = nbn_ord-line.price-cli
     6606                       TMP#zakaz.price-rubl            = nbn_ord-line.price-rubl
     6607                       TMP#zakaz.qnty                  = nbn_ord-line.qnty
     6608                       TMP#zakaz.receive-cli-qnty      = nbn_ord-line.receive-cli-qnty
     6609                       TMP#zakaz.receive-qnty          = nbn_ord-line.receive-qnty
     6610                       TMP#zakaz.road-tax              = nbn_ord-line.road-tax
     6611                       TMP#zakaz.sum-SLT               = nbn_ord-line.sum-SLT
     6612                       TMP#zakaz.sum-VAT               = nbn_ord-line.sum-VAT
     6613                       TMP#zakaz.sum-base              = nbn_ord-line.sum-base
     6614                       TMP#zakaz.sum-cli               = nbn_ord-line.sum-cli
     6615                       TMP#zakaz.sum-excise            = nbn_ord-line.sum-excise
     6616                       TMP#zakaz.sum-other-base        = nbn_ord-line.sum-other-base
     6617                       TMP#zakaz.sum-other-rubl        = nbn_ord-line.sum-other-rubl
     6618                       TMP#zakaz.sum-road-tax          = nbn_ord-line.sum-road-tax
     6619                       TMP#zakaz.sum-rubl              = nbn_ord-line.sum-rubl
     6620                       TMP#zakaz.sum-transport-base    = nbn_ord-line.sum-transport-base
     6621                       TMP#zakaz.sum-transport-rubl    = nbn_ord-line.sum-transport-rubl
     6622                       TMP#zakaz.transport-base        = nbn_ord-line.transport-base
     6623                       TMP#zakaz.transport-rubl        = nbn_ord-line.transport-rubl
     6624                       TMP#zakaz.unit-cli              = nbn_ord-line.unit-cli
     6625                       TMP#zakaz.v-vat                 = nbn_ord-line.v-vat
     6626                   .
     6627               run create-dtl-fp in this-procedure
     6628                                 ( input loc-ord-num,
     6629                                   input "ord-of",
     6630                                   input m_ord-line.doc-code,
     6631                                   input m_ord-line.artic,
     6632                                   input m_ord-line.prod-type,
     6633                                   input m_ord-line.prod-code ,
     6634                                   input m_ord-line.cli-base-rate ) no-error .
     6635               if error-status :error then do:
     6636                  message
     6637                    vss-workfile vss-revision vss-description skip
     6638                    error-status :get-message(1) skip
     6639                    return-value skip
     6640                    "Ошибка create-dtl-fp"
     6641                    view-as alert-box error
     6642                  .
     6643               end.
     6644               run ord-detale in this-procedure  no-error .
     6645               if error-status :error then do:
     6646                  message
     6647                    vss-workfile vss-revision vss-description skip
     6648                    error-status :get-message(1) skip
     6649                    return-value skip
     6650                    "Ошибка ord-detale"
     6651                    view-as alert-box error
     6652                  .
     6653                   leave.
     6654               end.
     6655               line-mode = 'ИЗМЕНЕНИЕ':U .
     6656          if loc-make-avto = false then do:
     6657               assign
     6658                 doc-rec = recid (ub.ord-doc)
     6659                 r-tmp = recid ( TMP#zakaz   )
     6660                 loc-status     = ub.ord-doc.status_
     6661                 doc-date       = ub.ord-doc.doc-date
     6662                 loc-date-ship  = ub.ord-doc.ship-date
     6663                 date-sale-1    = ub.ord-doc.date-sale-1
     6664                 date-sale-2    = ub.ord-doc.date-sale-2
     6665                 loc-exch-code  = ub.ord-doc.exch-code
     6666                 loc-exch-rate  = ub.ord-doc.exch-rate
     6667                 loc-exch-scale = ub.ord-doc.exch-scale
     6668                 loc-base-rate  = ub.ord-doc.base-rate
     6669                 loc-base-scale = ub.ord-doc.base-scale
     6670                 vat_type       = ub.ord-doc.vat-type
     6671                 slt_type       = ub.ord-doc.slt-type
     6672                 loc-cli-code =   ub.ord-doc.cli-code
     6673                 loc-cli-type =   ub.ord-doc.cli-type
     6674                 loc-ord-num  = ll-d
     6675                 .
     6676             find first shar_ord-doc no-lock  where shar_ord-doc.doc-code = ord-doc.doc-code no-error .
     6677             run cus/ord-frm.w
     6678                 (input Parparentproc,
     6679                  input recid (TMP#zakaz) ,
     6680                  input line-mode    ,
     6681                  output r-stop      ,
     6682                  output r-exit      )
     6683                  no-error .
     6684                 if error-status :error then do:
     6685                   message
     6686                     vss-workfile vss-revision vss-description skip
     6687                     error-status :get-message(1) skip
     6688                     return-value skip
     6689                     "cus/ord-frm.w"
     6690                     view-as alert-box error
     6691                   .
     6692                     return.
     6693                 end.
     6694             end.
     6695           end.
     6696       end.
     6697   end.
     6698   end case.
     6699   if ks > 0 then do :
     6700       find first ub.ord-doc  exclusive-lock   where ub.ord-doc.doc-code  = loc-ord-num  .
     6701       ub.ord-doc.sys-time-int = time.
     6702       o-rec = recid(ub.ord-doc) .
     6703       message "Сделан заказ № " loc-ord-num .
     6704       run calc-cons-ord in this-procedure  .
     6705   end.
     6706   else do:
     6707      find first ub.ord-doc  exclusive-lock   where ub.ord-doc.doc-code  = loc-ord-num  .
     6708      delete ub.ord-doc .
     6709      o-rec = ?.
     6710   end.
     6711   end.
     6712   END PROCEDURE.
     6713   PROCEDURE make-fp-rcv :
     6714   do
     6715    on error undo, return error return-value
     6716    :
     6717   def input  param l-mod as character no-undo .
     6718   def output param o-rec as recid no-undo .
     6719   def output param l-rec as recid no-undo .
     6720   define variable ks as integer no-undo .
     6721   define variable loc-ord-num as character no-undo .
     6722   define variable ii as integer no-undo .
     6723   define buffer b-goods for ub.goods .
     6724   define buffer bfp-ord-doc for ub.ord-doc .
     6725   define buffer z-ord-doc   for ub.ord-doc .
     6726   define buffer z-ord-line  for ub.ord-line .
     6727   define variable doc-code-fp as character no-undo .
     6728   define variable doc-code-z as character no-undo .
     6729   define variable v-doc-mode as character no-undo .
     6730   ks = 0.
     6731   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6732   run proc-ord-code in this-procedure
     6733    (input   'main' ,
     6734     input   v-cntxt-db-num ,
     6735     input   v-cntxt-obj-type ,
     6736     input   v-cntxt-obj-code ,
     6737     input   v-i-doc ,
     6738     output  loc-ord-num
     6739    ) .
     6740   if caps(l-mod) = "1"  or caps(l-mod) = "4"  then do:
     6741     doc-code-z  = ub.ord-doc.doc-code:screen-value in browse browse-16  .
     6742     doc-code-fp = ub.ord-doc.doc-code:screen-value in browse browse-26  .
     6743     find first ub.ord-doc  where ub.ord-doc.doc-code = doc-code-fp no-lock  no-error .
     6744     if avail ub.ord-doc and  ub.ord-doc.doc-type <> 'ФП':U  then do:
     6745        message "Подтвердите по какому заказу ФП будет сформирована поставка " view-as alert-box .
     6746        return.
     6747     end.
     6748     find first bfp-ord-doc no-lock  where bfp-ord-doc.doc-code = ub.ord-doc.doc-code no-error.
     6749     if error-status :error  then return.
     6750     find first z-ord-doc no-lock  where z-ord-doc.doc-code = doc-code-z no-error.
     6751     if error-status :error  then do:
     6752        message "Не выбрана заявка! " view-as alert-box .
     6753        return.
     6754        end.
     6755   end.
     6756   if caps(l-mod) = "2"  then do:
     6757         if num-entries(del-list) < 1  then do:
     6758           message "Товар в заказе не отмечен '+' !!! " .
     6759           return.
     6760         end.
     6761         find first tt-new-ord-line no-lock  where recid(tt-new-ord-line) = integer(entry(1,del-list))  no-error .
     6762             if error-status :error  then return.
     6763         find first bfp-ord-doc no-lock where bfp-ord-doc.doc-code = tt-new-ord-line.doc-code no-error.
     6764   end.
     6765   if caps(l-mod) = "3"  then do:
     6766     doc-code-z  = m_ord-line.doc-code:screen-value in browse browse-13  .
     6767     find first z-ord-doc no-lock  where z-ord-doc.doc-code = doc-code-z no-error.
     6768     if error-status :error  then do:
     6769        message "Не выбрана заявка! " view-as alert-box .
     6770        return.
     6771        end.
     6772       find current  tt-new-ord-line  no-lock no-error .
     6773             if not avail tt-new-ord-line or  error-status :error  then do:
     6774             message "Нет заказа по текущему товару !!! "  view-as alert-box information .
     6775             return.
     6776             end.
     6777         find first bfp-ord-doc no-lock  where bfp-ord-doc.doc-code = tt-new-ord-line.doc-code no-error.
     6778   end.
     6779   if bfp-ord-doc.status_ <> 'поставка':U  then do:
     6780        message "Нельзя создать поставку на заказ в статусе " bfp-ord-doc.status_ view-as alert-box .
     6781        return.
     6782      end.
     6783   run proc-create-rcv-doc in this-procedure
     6784   ( input bfp-ord-doc.PS
     6785    ,input bfp-ord-doc.base-rate
     6786    ,input bfp-ord-doc.base-scale
     6787    ,input bfp-ord-doc.cli-code
     6788    ,input bfp-ord-doc.cli-type
     6789    ,input bfp-ord-doc.cons-code
     6790    ,input v-cntxt-userid
     6791    ,input bfp-ord-doc.cycle-day
     6792    ,input bfp-ord-doc.date-pay
     6793    ,input bfp-ord-doc.doc-code
     6794    ,input to-day
     6795    ,input 'out':U
     6796    ,input bfp-ord-doc.exch-code
     6797    ,input bfp-ord-doc.exch-date
     6798    ,input bfp-ord-doc.exch-rate
     6799    ,input bfp-ord-doc.exch-scale
     6800    ,input bfp-ord-doc.fact-date
     6801    ,input bfp-ord-doc.fact-num
     6802    ,input bfp-ord-doc.fact-order
     6803    ,input 0
     6804    ,input bfp-ord-doc.fact-time
     6805    ,input bfp-ord-doc.flag_
     6806    ,input bfp-ord-doc.host-code
     6807    ,input ( if avail z-ord-doc then z-ord-doc.obj-code else 0   )
     6808    ,input ( if avail z-ord-doc then  z-ord-doc.obj-type else "" )
     6809    ,input bfp-ord-doc.order-type
     6810    ,input loc-ord-num
     6811    ,input bfp-ord-doc.shift-date
     6812    ,input bfp-ord-doc.shift-num
     6813    ,input bfp-ord-doc.shift-name
     6814    ,input bfp-ord-doc.ship-date
     6815    ,input bfp-ord-doc.ship-time
     6816    ,input 'новый':U
     6817    ,input bfp-ord-doc.sum-service
     6818    ,input bfp-ord-doc.sum-ship
     6819    ,input bfp-ord-doc.sys-date
     6820    ,input bfp-ord-doc.sys-time-int
     6821    ,input bfp-ord-doc.sys-time
     6822    ,input bfp-ord-doc.tot-lines
     6823    ,input ""
     6824    ,input bfp-ord-doc.user-db-num
     6825    ,input bfp-ord-doc.user-name
     6826    ).
     6827   v-doc-mode = 'ДОБАВЛЕНИЕ':U.
     6828   x-make-avto = 2 .
     6829     run cus/or-obj.w
     6830     (       input  parParentProc
     6831           , input  ub.ord-doc-rcv.host-code
     6832           , input  recid(ub.ord-doc-rcv)
     6833           , input  1
     6834           , input  'ИЗМЕНЕНИЕ':U
     6835           , input  'ИЗМЕНЕНИЕ':U
     6836           , input-output  v-doc-mode  ) .
     6837     case x-make-avto :
     6838       when 1 then loc-make-avto = true  .
     6839       when 4 then loc-make-avto = true  .
     6840       when 2 then loc-make-avto = false  .
     6841       when 3 then loc-make-avto = ? .
     6842     end case .
     6843   if v-doc-mode = "cancel":U then do:
     6844       find first ub.ord-doc-rcv  exclusive-lock   where ub.ord-doc-rcv.rcv-code  = loc-ord-num  no-error .
     6845       delete ub.ord-doc-rcv.
     6846      return.
     6847    end.
     6848   if caps(l-mod) = "1"  then do:
     6849      for each tt-new-ord-line no-lock where tt-new-ord-line.doc-code = bfp-ord-doc.doc-code :
     6850           find first b-goods no-lock   where
     6851                     tt-new-ord-line.artic    = b-goods.artic     and
     6852                     tt-new-ord-line.prod-type = b-goods.prod-type and
     6853                     tt-new-ord-line.prod-code = b-goods.prod-code no-error .
     6854           if available b-goods  and
     6855             not can-find ( first  tt-ord-gds where tt-ord-gds.gds-code = b-goods.gds-code no-lock )
     6856             then do:
     6857               create tt-ord-gds .
     6858               buffer-copy b-goods to tt-ord-gds .
     6859               end.
     6860           ks = ks + 1 .
     6861           run create-line-rcv in this-procedure
     6862              ( input loc-ord-num ,
     6863                input recid (tt-new-ord-line),
     6864                input ? ,
     6865                input  ks ,
     6866                output l-rec) no-error .
     6867           if error-status :error then leave.
     6868       end.
     6869   end.
     6870   if caps(l-mod) = "2"  then do:
     6871   define variable v-nn as integer   no-undo .
     6872   v-nn = num-entries(del-list) .
     6873       do ii = 1 to v-nn :
     6874           find first tt-new-ord-line no-lock  where recid(tt-new-ord-line) = integer(entry(ii,del-list)) no-error .
     6875           if available tt-new-ord-line then
     6876           find first b-goods no-lock where tt-new-ord-line.artic     = b-goods.artic and
     6877                                   tt-new-ord-line.prod-type = b-goods.prod-type and
     6878                                   tt-new-ord-line.prod-code = b-goods.prod-code no-error .
     6879           if available b-goods  and
     6880             not can-find ( first  tt-ord-gds where tt-ord-gds.gds-code = b-goods.gds-code no-lock )
     6881             then do:
     6882               create tt-ord-gds .
     6883               buffer-copy b-goods to tt-ord-gds .
     6884               end.
     6885           ks = ks + 1 .
     6886           run create-line-rcv in this-procedure ( input loc-ord-num , recid(tt-new-ord-line),  ? ,input  ks , output l-rec) no-error .
     6887           if error-status :error then leave.
     6888       end.
     6889   end.
     6890   if caps(l-mod) = "3"  then do:
     6891           if available tt-new-ord-line then
     6892           find first b-goods no-lock  where tt-new-ord-line.artic     = b-goods.artic and
     6893                                   tt-new-ord-line.prod-type = b-goods.prod-type and
     6894                                   tt-new-ord-line.prod-code = b-goods.prod-code no-error .
     6895           if available b-goods  and
     6896             not can-find ( first  tt-ord-gds where tt-ord-gds.gds-code = b-goods.gds-code no-lock )
     6897             then do:
     6898               create tt-ord-gds .
     6899               buffer-copy b-goods to tt-ord-gds .
     6900               end.
     6901           ks = ks + 1 .
     6902           run create-line-rcv in this-procedure ( input loc-ord-num , recid(tt-new-ord-line),  ? ,input  ks , output l-rec) no-error .
     6903   end.
     6904   if caps(l-mod) = "4"  then do:
     6905      for each tt-new-ord-line no-lock where tt-new-ord-line.doc-code = bfp-ord-doc.doc-code :
     6906           find first z-ord-line no-lock where
     6907                                 z-ord-line.doc-code  = doc-code-z  and
     6908                                 z-ord-line.artic     = tt-new-ord-line.artic  and
     6909                                 z-ord-line.prod-type = tt-new-ord-line.prod-type  and
     6910                                 z-ord-line.prod-code = tt-new-ord-line.prod-code
     6911                                 no-error .
     6912             if available z-ord-line then do :
     6913                 if not  can-find ( first  tt-ord-gds where
     6914                                           tt-ord-gds.artic     = z-ord-line.artic      and
     6915                                           tt-ord-gds.prod-type = z-ord-line.prod-type  and
     6916                                           tt-ord-gds.prod-code = z-ord-line.prod-code  no-lock )
     6917                 then do:
     6918                     find first b-goods no-lock where z-ord-line.artic     = b-goods.artic and
     6919                                             z-ord-line.prod-type = b-goods.prod-type and
     6920                                             z-ord-line.prod-code = b-goods.prod-code no-error .
     6921                     create tt-ord-gds .
     6922                     buffer-copy b-goods to tt-ord-gds .
     6923                     end.
     6924                 ks = ks + 1 .
     6925                 run create-line-rcv in this-procedure ( input loc-ord-num , recid(tt-new-ord-line), recid(z-ord-doc) , input  ks , output l-rec) no-error .
     6926                 if error-status :error then leave .
     6927             end.
     6928      end.
     6929   end.
     6930   ks = 0  .
     6931   for each ub.ord-line-rcv where  ub.ord-line-rcv.rcv-code =   loc-ord-num no-lock :
     6932     ks = ks + 1.
     6933     leave.
     6934   end.
     6935   if ks > 0 then do:
     6936       o-rec = recid(ub.ord-doc-rcv).
     6937       message "Сделана поставка № " loc-ord-num.
     6938       run calc-cons-ord in this-procedure .
     6939      end.
     6940    else do:
     6941      find first ub.ord-doc-rcv  exclusive-lock   where ub.ord-doc-rcv.rcv-code  = loc-ord-num .
     6942      delete ub.ord-doc-rcv .
     6943      o-rec = ?.
     6944      l-rec = ?.
     6945   end.
     6946   for each tt-ord-gds :
     6947    delete tt-ord-gds.
     6948   end.
     6949   del-list = '' .
     6950   end.
     6951   END PROCEDURE.
     6952   PROCEDURE make-post-in :
     6953   def output param o-rec  as recid no-undo.
     6954   def output param l-rec  as recid no-undo.
     6955   do
     6956    on error undo, return error return-value
     6957    :
     6958   define variable ks as integer no-undo .
     6959   define variable loc-ord-num as character no-undo .
     6960   define variable ii as integer no-undo .
     6961   define buffer b-goods for ub.goods .
     6962   define buffer bfp-ord-doc for ub.ord-doc .
     6963   find current ub.ord-doc no-lock no-error .
     6964   if not available  ub.ord-doc then do:
     6965      message "Не выбрана заявка !!! " .
     6966      return.
     6967   end.
     6968   if  ub.ord-doc.doc-type <> 'ОФ':U then do:
     6969      message "Не выбрана ЗАЯВКА !!! " .
     6970      return.
     6971   end.
     6972   find current my-obj no-lock no-error .
     6973   if not available my-obj then do:
     6974      message "Не выбран объект !!! " .
     6975      return.
     6976   end.
     6977   find first bfp-ord-doc no-lock  where bfp-ord-doc.doc-code = ub.ord-doc.doc-code no-error.
     6978        if error-status :error  then return.
     6979   ks = 0.
     6980   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6981   run proc-ord-code in this-procedure
     6982    (input   'main' ,
     6983     input   v-cntxt-db-num ,
     6984     input   v-cntxt-obj-type ,
     6985     input   v-cntxt-obj-code ,
     6986     input   v-i-doc ,
     6987     output  loc-ord-num
     6988    ) .
     6989      create ub.ord-doc-rcv.
     6990      BUFFER-COPY bfp-ord-doc to ub.ord-doc-rcv
     6991      assign
     6992         ub.ord-doc-rcv.rcv-code  = loc-ord-num
     6993         ub.ord-doc-rcv.doc-code  = ""
     6994         ub.ord-doc-rcv.cli-code  = my-obj.obj-code
     6995         ub.ord-doc-rcv.cli-type  = my-obj.obj-type
     6996         ub.ord-doc-rcv.obj-code  = bfp-ord-doc.obj-code
     6997         ub.ord-doc-rcv.obj-type  = bfp-ord-doc.obj-type
     6998         ub.ord-doc-rcv.host-code = bfp-ord-doc.host-code
     6999         ub.ord-doc-rcv.cons-code = loc-ord-cons-code
     7000         ub.ord-doc-rcv.doc-type  = "in":U
     7001         ub.ord-doc-rcv.doc-date  = to-day
     7002         ub.ord-doc-rcv.status_   = 'новый':U
     7003      .
     7004   define variable v-doc-mode as character no-undo .
     7005   v-doc-mode = 'ДОБАВЛЕНИЕ':U.
     7006      o-rec = recid(ord-doc-rcv).
     7007      x-make-avto = 2 .
     7008     run cus/or-obj.w
     7009         (   input  parParentProc
     7010           , input  ub.ord-doc-rcv.host-code
     7011           , input  recid(ub.ord-doc-rcv)
     7012           , input  1
     7013           , input  'ИЗМЕНЕНИЕ':U
     7014           , input  'ИЗМЕНЕНИЕ':U
     7015           , input-output  v-doc-mode  ) .
     7016     case x-make-avto :
     7017       when 1 then loc-make-avto = true  .
     7018       when 4 then loc-make-avto = true  .
     7019       when 2 then loc-make-avto = false  .
     7020       when 3 then loc-make-avto = ? .
     7021     end case .
     7022   if v-doc-mode = "cancel":U then do:
     7023       find first ub.ord-doc-rcv  exclusive-lock   where ub.ord-doc-rcv.rcv-code  = loc-ord-num  no-error .
     7024       delete ub.ord-doc-rcv.
     7025      return.
     7026    end.
     7027    for each m_ord-line no-lock  where
     7028             m_ord-line.doc-code   = bfp-ord-doc.doc-code
     7029             :
     7030       find first b-goods no-lock  where
     7031                   m_ord-line.artic     = b-goods.artic     and
     7032                   m_ord-line.prod-type = b-goods.prod-type and
     7033                   m_ord-line.prod-code = b-goods.prod-code
     7034                   no-error .
     7035        find first ub.gds-obj no-lock  where
     7036                   ub.gds-obj.obj-code    = my-obj.obj-code and
     7037                   ub.gds-obj.obj-type    = my-obj.obj-type and
     7038                   ub.gds-obj.artic       = b-goods.artic   and
     7039                   ub.gds-obj.prod-code   = b-goods.prod-code and
     7040                   ub.gds-obj.prod-code   = b-goods.prod-code
     7041                   no-error .
     7042          if avail ub.gds-obj then do:
     7043             ks = ks + 1 .
     7044             run create-line-rcv-in in this-procedure
     7045             ( input loc-ord-num ,
     7046               recid(m_ord-line),
     7047               input  ks ,
     7048               input ub.gds-obj.fact-qnty ,
     7049               output l-rec
     7050               ) no-error .
     7051             if error-status :error then leave.
     7052          end.
     7053          if not avail ub.gds-obj then do:
     7054             message "Товара "skip
     7055             b-goods.artic      skip
     7056             b-goods.prod-type  skip
     7057             b-goods.prod-code  skip
     7058             "нет на объекте " skip
     7059             my-obj.obj-code    skip
     7060             my-obj.obj-type skip
     7061             skip
     7062             "Делать поставку ? " update g#log view-as alert-box question buttons yes-no.
     7063             if g#log = true then do:
     7064                 ks = ks + 1 .
     7065                 run create-line-rcv-in  in this-procedure ( input loc-ord-num , recid(m_ord-line), input  ks , input 0 , output l-rec ) no-error .
     7066                 if error-status :error then leave.
     7067             end.
     7068          end.
     7069    end.
     7070   ks = 0 .
     7071   for each ub.ord-line-rcv where  ub.ord-line-rcv.rcv-code =   loc-ord-num no-lock :
     7072     ks = ks + 1.
     7073     leave.
     7074   end.
     7075   if ks > 0 then do:
     7076       l-rec = recid(m_ord-line).
     7077       message "Поставка № " loc-ord-num " сделана"  .
     7078       run calc-cons-ord in this-procedure .
     7079      end.
     7080    else do:
     7081      find first ub.ord-doc-rcv  exclusive-lock   where ub.ord-doc-rcv.rcv-code  = loc-ord-num .
     7082      delete ub.ord-doc-rcv .
     7083      o-rec = ?.
     7084      l-rec = ?.
     7085   end.
     7086   end.
     7087   END PROCEDURE.
     7088   PROCEDURE make-post-gds-in :
     7089    do
     7090    on error undo, return error return-value
     7091    :
     7092   define input parameter l-mod as integer no-undo .
     7093   def output param o-rec  as recid no-undo.
     7094   def output param l-rec  as recid no-undo.
     7095   define variable ks as integer no-undo .
     7096   define variable loc-ord-num as character no-undo .
     7097   define variable m-obj-code like ub.clients.obj-code no-undo .
     7098   define variable m-obj-type like ub.clients.obj-type no-undo .
     7099   define buffer mm_ord-doc  for ub.ord-doc  .
     7100   define buffer mm_ord-line for ub.ord-line  .
     7101   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7102   run proc-ord-code in this-procedure
     7103    (input   'main' ,
     7104     input   v-cntxt-db-num ,
     7105     input   v-cntxt-obj-type ,
     7106     input   v-cntxt-obj-code ,
     7107     input   v-i-doc ,
     7108     output  loc-ord-num
     7109    ) .
     7110   for each temp-ttt :
     7111      delete temp-ttt.
     7112   end.
     7113   ks = 0.
     7114   if l-mod = 1 then do:
     7115       find current tt-goods  no-error.
     7116         if  avail tt-goods then  do:
     7117             ks = ks + 1.
     7118             create temp-ttt.
     7119             assign temp-ttt.p-recid = recid(tt-goods) .
     7120           end.
     7121           else do:
     7122                 message "Товар не выбран !!! "  view-as alert-box  .
     7123                 return.
     7124                 end.
     7125    end.
     7126   if l-mod = 2 then do:
     7127       for each tt-goods no-lock  where tt-goods.use = true :
     7128           ks = ks + 1.
     7129             create temp-ttt.
     7130             assign temp-ttt.p-recid = recid(tt-goods) .
     7131       end.
     7132   end.
     7133   if ks <= 0 then do:
     7134     message "Товар не выбран !!! "  view-as alert-box  .
     7135     return.
     7136   end.
     7137   if frame FRAME-D:visible then do:
     7138      apply "VALUE-CHANGED":U to browse-13 in frame frame-d.
     7139   end.
     7140       find current m_ord-line no-lock no-error .
     7141       if not available  m_ord-line  then do:
     7142         message "Не выбрана заявка !!! " .
     7143         return.
     7144       end.
     7145    find first mm_ord-doc where mm_ord-doc.doc-code = m_ord-line.doc-code no-lock no-error .
     7146       assign
     7147           m-obj-code = mm_ord-doc.obj-code
     7148           m-obj-type = mm_ord-doc.obj-type
     7149           .
     7150   find current my-obj no-lock no-error .
     7151   if not available  my-obj then do:
     7152      message "Не выбран объект !!! " .
     7153      return.
     7154   end.
     7155      create ub.ord-doc-rcv.
     7156      BUFFER-COPY mm_ord-doc to ub.ord-doc-rcv
     7157      assign
     7158         ub.ord-doc-rcv.rcv-code  = loc-ord-num
     7159         ub.ord-doc-rcv.doc-code  = ""
     7160         ub.ord-doc-rcv.cli-code  = my-obj.obj-code
     7161         ub.ord-doc-rcv.cli-type  = my-obj.obj-type
     7162         ub.ord-doc-rcv.obj-code  = m-obj-code
     7163         ub.ord-doc-rcv.obj-type  = m-obj-type
     7164         ub.ord-doc-rcv.host-code = g#host-code
     7165         ub.ord-doc-rcv.cons-code = loc-ord-cons-code
     7166         ub.ord-doc-rcv.doc-type  = "in":U
     7167         ub.ord-doc-rcv.doc-date  = to-day
     7168         ub.ord-doc-rcv.status_   = 'новый':U
     7169      .
     7170   define variable v-doc-mode as character no-undo .
     7171   v-doc-mode = 'ДОБАВЛЕНИЕ':U.
     7172   x-make-avto = 2 .
     7173     run cus/or-obj.w
     7174           ( input  parParentProc
     7175           , input  ub.ord-doc-rcv.host-code
     7176           , input  recid(ub.ord-doc-rcv)
     7177           , input  1
     7178           , input  'ИЗМЕНЕНИЕ':U
     7179           , input  'ИЗМЕНЕНИЕ':U
     7180           , input-output  v-doc-mode  ) .
     7181     case x-make-avto :
     7182       when 1 then loc-make-avto = true  .
     7183       when 4 then loc-make-avto = true  .
     7184       when 2 then loc-make-avto = false  .
     7185       when 3 then loc-make-avto = ? .
     7186     end case .
     7187   ks = 0.
     7188   if v-doc-mode = "cancel":U then do:
     7189       find first ub.ord-doc-rcv  exclusive-lock    where ub.ord-doc-rcv.rcv-code  = loc-ord-num no-error .
     7190       delete ub.ord-doc-rcv.
     7191      return.
     7192   end.
     7193    for each temp-ttt   :
     7194       find first  tt-goods no-lock  where recid(tt-goods) = temp-ttt.p-recid no-error .
     7195       find first  ub.gds-obj  no-lock  where
     7196                   ub.gds-obj.obj-code  = my-obj.obj-code and
     7197                   ub.gds-obj.obj-type  = my-obj.obj-type and
     7198                   ub.gds-obj.artic     = tt-goods.artic   and
     7199                   ub.gds-obj.prod-code = tt-goods.prod-code and
     7200                   ub.gds-obj.prod-code = tt-goods.prod-code
     7201                   no-error .
     7202      find first mm_ord-line no-lock where
     7203                     mm_ord-line.doc-code  = mm_ord-doc.doc-code and
     7204                     mm_ord-line.artic     = tt-goods.artic      and
     7205                     mm_ord-line.prod-code = tt-goods.prod-code  and
     7206                     mm_ord-line.prod-code = tt-goods.prod-code
     7207                     no-error .
     7208          if not avail  mm_ord-line then do :
     7209             message "Товара "skip
     7210                 tt-goods.artic      skip
     7211                 tt-goods.prod-type  skip
     7212                 tt-goods.prod-code  skip
     7213                 "не требуется по заявке "  mm_ord-doc.doc-code skip
     7214                 "Пропускаем его " view-as alert-box .
     7215                 next.
     7216          end.
     7217          if available ub.gds-obj then do:
     7218             ks = ks + 1 .
     7219             run create-line-rcv-in in this-procedure ( input loc-ord-num , recid(mm_ord-line), input  ks , input ub.gds-obj.fact-qnty , output l-rec ).
     7220          end.
     7221          if not avail ub.gds-obj then do:
     7222             message "Товара "skip
     7223             tt-goods.artic      skip
     7224             tt-goods.prod-type  skip
     7225             tt-goods.prod-code  skip
     7226             "нет на объекте " skip
     7227             my-obj.obj-code    skip
     7228             my-obj.obj-type skip
     7229             skip
     7230             "Делать поставку ? " update g#log view-as alert-box question buttons yes-no.
     7231             if g#log = true then do:
     7232                 ks = ks + 1 .
     7233                 run create-line-rcv-in in this-procedure (input loc-ord-num , recid(mm_ord-line), input  ks , input 0 , output l-rec ).
     7234             end.
     7235          end.
     7236    end.
     7237   if ks > 0 then do:
     7238       l-rec = recid(m_ord-line).
     7239       message "Поставка № " loc-ord-num " сделана"  .
     7240       run calc-cons-ord in this-procedure .
     7241      end.
     7242    else do:
     7243      find first ub.ord-doc-rcv  exclusive-lock   where ub.ord-doc-rcv.rcv-code  = loc-ord-num  .
     7244      delete ub.ord-doc-rcv .
     7245      o-rec = ?.
     7246      l-rec = ?.
     7247   end.
     7248   end.
     7249   END PROCEDURE.
     7250   PROCEDURE make-trn :
     7251   do
     7252    on error undo, return error return-value
     7253    :
     7254   define input parameter tp-rec as recid no-undo .
     7255       run cus/ord-trn.p
     7256       ( parParentProc ,
     7257         input tp-rec ,
     7258         input no
     7259         ).
     7260   end.
     7261   END PROCEDURE.
     7262   PROCEDURE new-zayvka :
     7263   do
     7264    on error undo, return error return-value
     7265    :
     7266   define buffer bb_ord-doc for ub.ord-doc.
     7267   define buffer bb_ord-line for ub.ord-line.
     7268   define buffer bb_ord-gds-cons for ub.ord-gds-cons.
     7269   define variable ii as integer no-undo .
     7270   define variable s-del-list as char no-undo.
     7271   define variable t-ret as logical no-undo .
     7272   define variable t-rec as recid no-undo .
     7273   define variable loc-gds-code like ub.goods.gds-code no-undo .
     7274   run ref/all-zakz.w
     7275      ( input   parParentProc
     7276       ,input   'ОФ':U
     7277       ,input   ?
     7278       ,input   "firm"
     7279       ,input   p-cons-code
     7280       ,input   "b-sel,b-mark,b-lkp,nob-exec,nob-copy"
     7281       ,input   ""
     7282       ,output  s-del-list ) .
     7283   t-ret =  session:SET-WAIT-STATE("GENERAL") .
     7284   ii = 0 .
     7285   define variable v-nn as integer   no-undo .
     7286   v-nn = num-entries(s-del-list).
     7287    DO ii = 1  to v-nn :
     7288       find first bb_ord-doc  exclusive-lock   where recid(bb_ord-doc) = integer(entry(ii,s-del-list))  no-error .
     7289       if available bb_ord-doc then do:
     7290       if bb_ord-doc.status_ <> 'согласование':U then do:          message "Документ " bb_ord-doc.doc-code "имеет статус" caps(bb_ord-doc.status_) "пропускаем." view-as alert-box .         next.    end. assign bb_ord-doc.cons-code = loc-ord-cons-code .   for each bb_ord-line where bb_ord-line.doc-code = bb_ord-doc.doc-code no-lock :    if can-find (first bb_ord-gds-cons where bb_ord-gds-cons.cons-code = loc-ord-cons-code       and                                   bb_ord-gds-cons.artic     = bb_ord-line.artic     and                                   bb_ord-gds-cons.prod-code = bb_ord-line.prod-code and                                   bb_ord-gds-cons.prod-type = bb_ord-line.prod-type  no-lock ) then do:             for each bb_ord-gds-cons where bb_ord-gds-cons.cons-code = loc-ord-cons-code       and                                   bb_ord-gds-cons.artic     = bb_ord-line.artic     and                                   bb_ord-gds-cons.prod-code = bb_ord-line.prod-code and                                   bb_ord-gds-cons.prod-type = bb_ord-line.prod-type  exclusive-lock :                 bb_ord-gds-cons.sum-qnty = bb_ord-gds-cons.sum-qnty + bb_ord-line.qnty .           end.     end.     else do:         create bb_ord-gds-cons.         Assign bb_ord-gds-cons.cons-code = loc-ord-cons-code                      bb_ord-gds-cons.artic     = bb_ord-line.artic                      bb_ord-gds-cons.prod-code = bb_ord-line.prod-code                  bb_ord-gds-cons.prod-type = bb_ord-line.prod-type                  bb_ord-gds-cons.sum-qnty  = bb_ord-line.qnty .     end.     t-rec = recid(bb_ord-gds-cons). end.
     7291       end.
     7292    end.
     7293    if ii = 0 or v-nn = 0  then do:
     7294        DO ii = 1  to 1 :
     7295        ii = 1 .
     7296        find first bb_ord-doc  exclusive-lock   where recid(bb_ord-doc) = doc-rec no-error .
     7297        if available bb_ord-doc then do:
     7298       if bb_ord-doc.status_ <> 'согласование':U then do:          message "Документ " bb_ord-doc.doc-code "имеет статус" caps(bb_ord-doc.status_) "пропускаем." view-as alert-box .         next.    end. assign bb_ord-doc.cons-code = loc-ord-cons-code .   for each bb_ord-line where bb_ord-line.doc-code = bb_ord-doc.doc-code no-lock :    if can-find (first bb_ord-gds-cons where bb_ord-gds-cons.cons-code = loc-ord-cons-code       and                                   bb_ord-gds-cons.artic     = bb_ord-line.artic     and                                   bb_ord-gds-cons.prod-code = bb_ord-line.prod-code and                                   bb_ord-gds-cons.prod-type = bb_ord-line.prod-type  no-lock ) then do:             for each bb_ord-gds-cons where bb_ord-gds-cons.cons-code = loc-ord-cons-code       and                                   bb_ord-gds-cons.artic     = bb_ord-line.artic     and                                   bb_ord-gds-cons.prod-code = bb_ord-line.prod-code and                                   bb_ord-gds-cons.prod-type = bb_ord-line.prod-type  exclusive-lock :                 bb_ord-gds-cons.sum-qnty = bb_ord-gds-cons.sum-qnty + bb_ord-line.qnty .           end.     end.     else do:         create bb_ord-gds-cons.         Assign bb_ord-gds-cons.cons-code = loc-ord-cons-code                      bb_ord-gds-cons.artic     = bb_ord-line.artic                      bb_ord-gds-cons.prod-code = bb_ord-line.prod-code                  bb_ord-gds-cons.prod-type = bb_ord-line.prod-type                  bb_ord-gds-cons.sum-qnty  = bb_ord-line.qnty .     end.     t-rec = recid(bb_ord-gds-cons). end.
     7299        end.
     7300       end.
     7301    end.
     7302    run init-proc in this-procedure .
     7303   OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.
     7304   OPEN QUERY BROWSE-16 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK     BY ub.ord-doc.obj-type        BY ub.ord-doc.obj-code         BY ub.ord-doc.ship-date          BY ub.ord-doc.ship-time           BY ub.ord-doc.doc-code DESCENDING.
     7305    run calc-cons-ord in this-procedure .
     7306    t-ret =  session:SET-WAIT-STATE("") .
     7307   end.
     7308   END PROCEDURE.
     7309   PROCEDURE ord-detale :
     7310   do
     7311    on error undo, return error return-value
     7312    :
     7313    define variable  r-tmp as recid   no-undo .
     7314    define variable r-stop as logical no-undo .
     7315    define variable r-exit as logical no-undo .
     7316    define variable ii as integer no-undo .
     7317    find current ub.ord-line no-lock no-error .
     7318     if avail ub.ord-line then do:
     7319        find first  tmp#zakaz where
     7320               TMP#zakaz.artic                 = ub.ord-line.artic and
     7321               TMP#zakaz.prod-code             = ub.ord-line.prod-code and
     7322               TMP#zakaz.prod-type             = ub.ord-line.prod-type no-error .
     7323         if not available Tmp#zakaz then do:
     7324             create TMP#zakaz.
     7325             end.
     7326         assign
     7327           TMP#zakaz.SLT-pc                = ub.ord-line.SLT-pc
     7328           TMP#zakaz.VAT-pc                = ub.ord-line.VAT-pc
     7329           TMP#zakaz.add-cli-qnty          = ub.ord-line.add-cli-qnty
     7330           TMP#zakaz.add-qnty              = ub.ord-line.add-qnty
     7331           TMP#zakaz.artic                 = ub.ord-line.artic
     7332           TMP#zakaz.cancel-cli-qnty       = ub.ord-line.cancel-cli-qnty
     7333           TMP#zakaz.cancel-date           = ub.ord-line.cancel-date
     7334           TMP#zakaz.cancel-qnty           = ub.ord-line.cancel-qnty
     7335           TMP#zakaz.cli-art               = ub.ord-line.cli-art
     7336           TMP#zakaz.cli-base-rate         = ub.ord-line.cli-base-rate
     7337           TMP#zakaz.cli-qnty              = ub.ord-line.cli-qnty
     7338           TMP#zakaz.doc-code              = ub.ord-line.doc-code
     7339           TMP#zakaz.excise                = ub.ord-line.excise
     7340           TMP#zakaz.fact-date             = ub.ord-line.fact-date
     7341           TMP#zakaz.initial-cli-qnty      = ub.ord-line.initial-cli-qnty
     7342           TMP#zakaz.initial-qnty          = ub.ord-line.initial-qnty
     7343           TMP#zakaz.line-num              = ub.ord-line.line-num
     7344           TMP#zakaz.order-cli-qnty        = ub.ord-line.order-cli-qnty
     7345           TMP#zakaz.order-qnty            = ub.ord-line.order-qnty
     7346           TMP#zakaz.other-base            = ub.ord-line.other-base
     7347           TMP#zakaz.other-rubl            = ub.ord-line.other-rubl
     7348           TMP#zakaz.price-base            = ub.ord-line.price-base
     7349           TMP#zakaz.price-cli             = ub.ord-line.price-cli
     7350           TMP#zakaz.price-rubl            = ub.ord-line.price-rubl
     7351           TMP#zakaz.prod-code             = ub.ord-line.prod-code
     7352           TMP#zakaz.prod-type             = ub.ord-line.prod-type
     7353           TMP#zakaz.qnty                  = ub.ord-line.qnty
     7354           TMP#zakaz.receive-cli-qnty      = ub.ord-line.receive-cli-qnty
     7355           TMP#zakaz.receive-qnty          = ub.ord-line.receive-qnty
     7356           TMP#zakaz.road-tax              = ub.ord-line.road-tax
     7357           TMP#zakaz.sum-SLT               = ub.ord-line.sum-SLT
     7358           TMP#zakaz.sum-VAT               = ub.ord-line.sum-VAT
     7359           TMP#zakaz.sum-base              = ub.ord-line.sum-base
     7360           TMP#zakaz.sum-cli               = ub.ord-line.sum-cli
     7361           TMP#zakaz.sum-excise            = ub.ord-line.sum-excise
     7362           TMP#zakaz.sum-other-base        = ub.ord-line.sum-other-base
     7363           TMP#zakaz.sum-other-rubl        = ub.ord-line.sum-other-rubl
     7364           TMP#zakaz.sum-road-tax          = ub.ord-line.sum-road-tax
     7365           TMP#zakaz.sum-rubl              = ub.ord-line.sum-rubl
     7366           TMP#zakaz.sum-transport-base    = ub.ord-line.sum-transport-base
     7367           TMP#zakaz.sum-transport-rubl    = ub.ord-line.sum-transport-rubl
     7368           TMP#zakaz.transport-base        = ub.ord-line.transport-base
     7369           TMP#zakaz.transport-rubl        = ub.ord-line.transport-rubl
     7370           TMP#zakaz.unit-cli              = ub.ord-line.unit-cli
     7371           TMP#zakaz.v-vat                 = ub.ord-line.v-vat
     7372       .
     7373       find current TMP#zakaz no-error .
     7374       find first ub.ord-doc no-lock  where ub.ord-doc.doc-code = ub.ord-line.doc-code no-error .
     7375       find first shar_ord-doc no-lock  where shar_ord-doc.doc-code = ord-line.doc-code no-error .
     7376       assign
     7377         line-mode = "ЦИКЛ":U
     7378         r-tmp = recid ( TMP#zakaz   )
     7379         loc-status     = ub.ord-doc.status_
     7380         doc-date       = ub.ord-doc.doc-date
     7381         loc-date-ship  = ub.ord-doc.ship-date
     7382         date-sale-1    = ub.ord-doc.date-sale-1
     7383         date-sale-2    = ub.ord-doc.date-sale-2
     7384         loc-exch-code  = ub.ord-doc.exch-code
     7385         loc-exch-rate  = ub.ord-doc.exch-rate
     7386         loc-exch-scale = ub.ord-doc.exch-scale
     7387         loc-base-rate  = ub.ord-doc.base-rate
     7388         loc-base-scale = ub.ord-doc.base-scale
     7389         vat_type       = ub.ord-doc.vat-type
     7390         slt_type       = ub.ord-doc.slt-type
     7391         loc-cli-code   = ub.ord-doc.cli-code
     7392         loc-cli-type   = ub.ord-doc.cli-type
     7393         loc-ord-num    = ub.ord-doc.doc-code
     7394         .
     7395       find first shar_ord-doc no-lock  where shar_ord-doc.doc-code = ord-doc.doc-code no-error .
     7396       if loc-make-avto = false then do:
     7397          run cus/ord-frm.w (input Parparentproc  , input r-tmp , input line-mode , output r-stop, output r-exit ) .
     7398       end.
     7399       if r-stop = true  then do:
     7400           run p-delete in this-procedure ( r-tmp ,input-output ii ) .
     7401           return error.
     7402       end.
     7403       if r-exit = true  then do:
     7404           run p-delete in this-procedure ( r-tmp ,input-output ii ) .
     7405       end.
     7406       if r-stop = false and r-exit = false  then do:
     7407           find current ub.ord-line  exclusive-lock  no-error .
     7408           BUFFER-COPY   TMP#zakaz to ub.ord-line.
     7409       end.
     7410   end.
     7411   else do:
     7412   end.
     7413   end.
     7414   END PROCEDURE.
     7415   PROCEDURE ord-header :
     7416   do
     7417    on error undo, return error return-value
     7418    :
     7419   find first shar-buf_ord-doc no-lock   where shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code no-error  .
     7420       run cus/ord-zakz.p
     7421       (     INPUT   PARPARENTPROC ,
     7422             INPUT   'ИЗМЕНЕНИЕ':U      ,
     7423             input   shar-buf_ord-doc.doc-type,
     7424             OUTPUT  DOC-REC ,
     7425             input-output  br-handle ,
     7426             input-output  bf-handle ,
     7427             input-output  next-prev
     7428             ) .
     7429   end.
     7430   END PROCEDURE.
     7431   PROCEDURE p-delete :
     7432    do
     7433    on error undo, return error return-value
     7434    :
     7435       define input parameter tmp-recid as recid no-undo .
     7436       define input-output parameter ii as integer no-undo . .
     7437       define buffer buf_doc-line for ub.ord-line .
     7438       find first tmp#zakaz where recid(tmp#zakaz) = tmp-recid no-error .
     7439       if not avail tmp#zakaz then return error.
     7440       find first buf_doc-line  exclusive-lock    where
     7441           buf_doc-line.doc-code        = loc-ord-num    and
     7442           buf_doc-line.prod-type       = tmp#zakaz.prod-type and
     7443           buf_doc-line.prod-code       = tmp#zakaz.prod-code and
     7444           buf_doc-line.artic           = tmp#zakaz.artic     no-error.
     7445       if not available buf_doc-line  then  return error .
     7446       delete buf_doc-line .
     7447       delete tmp#zakaz .
     7448       ii = ii - 1 .
     7449    end.
     7450   END PROCEDURE.
     7451   PROCEDURE p-mark :
     7452   do
     7453    on error undo, return error return-value
     7454    :
     7455   find current tt-goods no-error .
     7456   find current ub.ord-gds-cons no-error .
     7457   if not available tt-goods then do:
     7458        message "Неправильный выбор строки.".
     7459        return no-apply.
     7460        end.
     7461       IF    tt-goods.use = true THEN DO:
     7462             tt-goods.use = false.
     7463             disp "" @ tt-goods.use with browse browse-12.
     7464         End.
     7465         Else DO:
     7466              tt-goods.use = true.
     7467              disp "+" @ tt-goods.use with browse browse-12.
     7468         End.
     7469        apply "VALUE-CHANGED" to browse-12 in frame frame-A.
     7470        gg-recid = recid(tt-goods) .
     7471        g#log = browse-12:select-next-row ().
     7472   end.
     7473   END PROCEDURE.
     7474   PROCEDURE plus-mark :
     7475   do
     7476    on error undo, return error return-value
     7477    :
     7478   define variable  pp-rec as recid no-undo .
     7479   pp-rec = recid (tt-goods) .
     7480   for each tt-goods  exclusive-lock  :
     7481      tt-goods.use = true.
     7482   end.
     7483   OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.
     7484   reposition BROWSE-12 to recid pp-rec no-error .
     7485   end.
     7486   END PROCEDURE.
     7487   PROCEDURE post-1 :
     7488   do
     7489    on error undo, return error return-value
     7490    :
     7491     define variable  o-rec as recid no-undo.
     7492     define variable  l-rec as recid no-undo.
     7493     run make-fp-rcv in this-procedure ( input "1" ,output o-rec, output l-rec) .
     7494     OPEN QUERY BROWSE-27 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-code = loc-num-ord-FP and ub.ord-doc-rcv.doc-type = 'out':U       and ub.ord-doc-rcv.cons-code = loc-ord-cons-code  NO-LOCK.
     7495     reposition BROWSE-27 to recid o-rec  no-error .
     7496   end.
     7497   END PROCEDURE.
     7498   PROCEDURE post-2 :
     7499   do
     7500    on error undo, return error return-value
     7501    :
     7502     if not t-gds then do:
     7503         message "Создание по (+) возможно только в режиме 'развернуть'. "
     7504                 "Воидете в режим ПО ДОКУМЕНТАМ и включите переключатель РАЗВЕРНУТЬ ." view-as alert-box .
     7505         return .
     7506     end.
     7507     define variable  o-rec as recid no-undo.
     7508     define variable  l-rec as recid no-undo.
     7509     run make-fp-rcv in this-procedure ( input "2", output o-rec, output l-rec) .
     7510     OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .
     7511     reposition BROWSE-18 to recid l-rec no-error.
     7512     OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     7513   end.
     7514   END PROCEDURE.
     7515   PROCEDURE post-3 :
     7516    do
     7517    on error undo, return error return-value
     7518    :
     7519    if t-gds then do:
     7520       message "Нельзя внутри развернутого заказа делать поставку по текущему товару ."
     7521               "Перейдите в режим ПО ТОВАРАМ ."
     7522               view-as alert-box information .
     7523       return.
     7524    end.
     7525     define variable  o-rec as recid no-undo.
     7526     define variable  l-rec as recid no-undo.
     7527     run make-fp-rcv in this-procedure ( input "3", output o-rec, output l-rec) .
     7528     OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .
     7529     reposition BROWSE-18 to recid l-rec no-error.
     7530     OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     7531   end.
     7532   END PROCEDURE.
     7533   PROCEDURE post-4 :
     7534   do
     7535    on error undo, return error return-value
     7536    :
     7537   define variable  o-rec as recid no-undo.
     7538   define variable  l-rec as recid no-undo.
     7539   run make-post-in in this-procedure ( output o-rec , output l-rec) .
     7540       OPEN QUERY BROWSE-23 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-type = 'in'  AND ub.ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK.
     7541       .
     7542       reposition BROWSE-23 to recid o-rec no-error.
     7543   end.
     7544   END PROCEDURE.
     7545   PROCEDURE post-4-gds :
     7546    do
     7547    on error undo, return error return-value
     7548    :
     7549   define input parameter l-mod as character no-undo .
     7550   define variable  o-rec as recid no-undo.
     7551   define variable  l-rec as recid no-undo.
     7552   if caps(l-mod) = "M_H_0" then
     7553      run make-post-gds-in in this-procedure ( 1, output o-rec , output l-rec ) .
     7554    else
     7555      run make-post-gds-in in this-procedure ( 2, output o-rec , output l-rec ) .
     7556      OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     7557      reposition BROWSE-20 to recid l-rec no-error.
     7558   end.
     7559   END PROCEDURE.
     7560   PROCEDURE post-5 :
     7561   do
     7562    on error undo, return error return-value
     7563    :
     7564     define variable  o-rec as recid no-undo.
     7565     define variable  l-rec as recid no-undo.
     7566     run make-fp-rcv in this-procedure ( input "4" ,output o-rec, output l-rec).
     7567     OPEN QUERY BROWSE-27 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-code = loc-num-ord-FP and ub.ord-doc-rcv.doc-type = 'out':U       and ub.ord-doc-rcv.cons-code = loc-ord-cons-code  NO-LOCK.
     7568     reposition BROWSE-27 to recid o-rec no-error.
     7569   end.
     7570   END PROCEDURE.
     7571   PROCEDURE pr-main :
     7572   do
     7573    on error undo, return error return-value
     7574    :
     7575   define variable p-recid as recid no-undo .
     7576   define buffer l_tt-goods for tt-goods .
     7577   p-recid =  ? .
     7578   assign frame dialog-frame  r-main .
     7579   find first l_tt-goods where
     7580     l_tt-goods.artic = x-artic and
     7581     l_tt-goods.prod-type = x-prod-type and
     7582     l_tt-goods.prod-code = x-prod-code and
     7583     l_tt-goods.gds-t     = 'товар':U no-error .
     7584     if avail   l_tt-goods then   p-recid = recid(l_tt-goods).
     7585   case r-main :
     7586   when 1 then
     7587    do:
     7588      t-prt = false.
     7589      T-of = true.
     7590      run proc-prt in this-procedure .
     7591      run proc-t-of in this-procedure .
     7592      reposition browse-12 to recid p-recid no-error .
     7593      run br-12 in this-procedure .
     7594    end.
     7595   when 2 then
     7596      do:
     7597        T-of = false.
     7598        t-prt = false.
     7599        run proc-prt in this-procedure .
     7600        run proc-t-of in this-procedure .
     7601        reposition browse-12 to recid p-recid no-error  .
     7602        run br-12 in this-procedure .
     7603      end.
     7604   when 3 then
     7605      do:
     7606         t-prt = true.
     7607         T-of  = false.
     7608         run proc-t-of in this-procedure .
     7609         run proc-prt in this-procedure .
     7610         reposition browse-30 to recid p-recid no-error  .
     7611         run br-12 in this-procedure .
     7612      end.
     7613   end case.
     7614   frame frame-d:MOVE-TO-BOTTOM ( )  .
     7615   frame frame-f:MOVE-TO-BOTTOM ( )  .
     7616   frame frame-a:MOVE-TO-TOP ( )  .
     7617   frame frame-a:TOP-ONLY  .
     7618   end.
     7619   END PROCEDURE.
     7620   PROCEDURE proc-50 :
     7621   do
     7622    on error undo, return error return-value
     7623    :
     7624   define variable ll-rec as recid no-undo .
     7625   define variable v-doc-mode as character no-undo .
     7626     find current ub.ord-line-rcv no-lock  no-error .
     7627     find current new-rcv no-lock  no-error .
     7628     if avail  new-rcv then do:
     7629        ll-rec = recid ( new-rcv ) .
     7630        if  new-rcv.status_ = 'новый':U then do:
     7631             run cus/or-obj.w
     7632                   ( input  parParentProc
     7633                   , input  g#host-code
     7634                   , input  recid(new-rcv)
     7635                   , input  3
     7636                   , input  'ИЗМЕНЕНИЕ':U
     7637                   , input  'ИЗМЕНЕНИЕ':U
     7638                   , input-output  v-doc-mode  ) .
     7639             g#log = BROWSE-21:refresh() in frame frame-postavki  no-error .
     7640             run calc-cons-ord in this-procedure .
     7641        end.
     7642        else do:
     7643           if new-rcv.status_ = 'согласование':U
     7644               then
     7645                   message "Статус поставки " new-rcv.status_ ". Корректировать нельзя ."
     7646                   "Для проставления времени фактической доставки используйте другие режимы ! "
     7647                   view-as alert-box .
     7648               else  message "Статус поставки " new-rcv.status_ ". Корректировать нельзя !  "
     7649                     view-as alert-box .
     7650        end.
     7651     end.
     7652   end.
     7653   END PROCEDURE.
     7654   PROCEDURE proc-52 :
     7655   do
     7656    on error undo, return error return-value
     7657    :
     7658    define variable v-recid as recid no-undo .
     7659     find current ub.ord-line-rcv no-lock  no-error .
     7660     if avail ub.ord-doc-rcv  then do:
     7661        v-recid = recid(ub.ord-doc-rcv) .
     7662        run cus/lkp-rcv.w ( parParentProc, input-output v-recid) .
     7663     end.
     7664     end.
     7665   END PROCEDURE.
     7666   PROCEDURE proc-522 :
     7667   do
     7668    on error undo, return error return-value
     7669    :
     7670     define variable v-recid as recid no-undo .
     7671     find current new-rcv no-lock  no-error .
     7672     if avail new-rcv then do :
     7673        v-recid = recid(new-rcv) .
     7674        run cus/lkp-rcv.w ( parParentProc, input-output v-recid ) .
     7675     end.
     7676   end.
     7677   END PROCEDURE.
     7678   PROCEDURE proc-b-14 :
     7679   do
     7680    on error undo, return error return-value
     7681    :
     7682   define variable d-rec as recid no-undo.
     7683   if avail  ub.doc-line then do:
     7684     g#log = no.
     7685     message "Удалить строку в накладной №" ub.doc-line.doc-code "?   Вы уверены ?"
     7686             view-as alert-box question buttons OK-Cancel update g#log.
     7687       if g#log = false then return.
     7688       d-rec = recid (doc-line).
     7689       run del-nacl in this-procedure (d-rec).
     7690       OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.
     7691   end.
     7692   end.
     7693   END PROCEDURE.
     7694   PROCEDURE proc-b-20 :
     7695   do
     7696    on error undo, return error return-value
     7697    :
     7698   define variable d-rec as recid no-undo.
     7699   if avail  ub.trn-doc then do:
     7700     g#log = no.
     7701     message "Удалить накладную №" ub.trn-doc.doc-code "?   Вы уверены ?"
     7702     view-as alert-box question buttons OK-Cancel update g#log.
     7703     if g#log = false then return.
     7704     if avail  ub.trn-doc then do:
     7705     d-rec = recid (trn-doc).
     7706     run del-nacl-doc in this-procedure (d-rec).
     7707     OPEN QUERY BROWSE-24 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.doc-type = 'in' and             b-all_ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                  and            ub.ord-chain.rel-doc-type = 'trn' NO-LOCK,              EACH ub.trn-doc WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     7708   end.
     7709   end.
     7710   end.
     7711   END PROCEDURE.
     7712   PROCEDURE proc-b-31 :
     7713   do
     7714    on error undo, return error return-value
     7715    :
     7716   define variable d-rec as recid no-undo.
     7717   g#log = no.
     7718   find current ub.ord-doc-rcv no-lock no-error .
     7719   if avail  ub.ord-doc-rcv then do:
     7720     message "Удалить поставку №" ub.ord-doc-rcv.rcv-code "?   Вы уверены ?"
     7721     view-as alert-box question buttons OK-Cancel update g#log.
     7722     if g#log = false then return.
     7723     d-rec = recid (ub.ord-doc-rcv).
     7724     run del-post-doc in this-procedure (d-rec).
     7725     OPEN QUERY BROWSE-27 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-code = loc-num-ord-FP and ub.ord-doc-rcv.doc-type = 'out':U       and ub.ord-doc-rcv.cons-code = loc-ord-cons-code  NO-LOCK.
     7726     end.
     7727     end.
     7728   END PROCEDURE.
     7729   PROCEDURE proc-b-51 :
     7730   do
     7731    on error undo, return error return-value
     7732    :
     7733   if not available ub.trn-doc then return .
     7734     g#log = no.
     7735     message "Удалить накладную №" ub.trn-doc.doc-code "?   Вы уверены ?"
     7736           view-as alert-box question buttons OK-Cancel update g#log.
     7737           if g#log = false then return.
     7738     find first  ub.ord-chain exclusive-lock where
     7739           ub.ord-chain.rel-doc-code = ub.trn-doc.doc-code and
     7740           ub.ord-chain.doc-type = 'rcv'                and
     7741           ub.ord-chain.rel-doc-type = 'trn'
     7742     no-error .
     7743     if available ub.ord-chain then delete ub.ord-chain .
     7744     run del-nacl-doc in this-procedure ( recid (trn-doc) ).
     7745     OPEN QUERY BROWSE-22 for each ub.ord-chain no-lock where         ub.ord-chain.doc-code = new-rcv.rcv-code and         ub.ord-chain.doc-type = 'rcv'            and         ub.ord-chain.rel-doc-type = 'trn',        EACH ub.trn-doc       WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK .
     7746     OPEN QUERY BROWSE-21 FOR EACH new-rcv       WHERE new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH bb_ord-doc WHERE new-rcv.doc-code = bb_ord-doc.doc-code  OUTER-JOIN NO-LOCK.
     7747   end.
     7748   END PROCEDURE.
     7749   PROCEDURE proc-b-54 :
     7750   do
     7751    on error undo, return error return-value
     7752    :
     7753    define variable v-recid as recid no-undo .
     7754    if avail  ub.ord-doc-rcv then do:
     7755        v-recid =  recid(ub.ord-doc-rcv) .
     7756        run cus/lkp-rcv.w ( parParentProc, input-output v-recid ) .
     7757     end.
     7758   end.
     7759   END PROCEDURE.
     7760   PROCEDURE proc-b-56 :
     7761   do
     7762    on error undo, return error return-value
     7763    :
     7764    define variable v-doc-mode as character no-undo .
     7765     if avail  ub.ord-line-rcv then do:
     7766           run cus/or-obj.w
     7767           (      input  parParentProc
     7768                , input  g#host-code
     7769                , input  recid(ord-line-rcv)
     7770                , input  2
     7771                , input  'ИЗМЕНЕНИЕ':U
     7772                , input  'ПРОСМОТР':U
     7773                , input-output  v-doc-mode  ) .
     7774     end.
     7775   end.
     7776   END PROCEDURE.
     7777   PROCEDURE proc-b-58 :
     7778   do
     7779    on error undo, return error return-value
     7780    :
     7781   define variable v-doc-mode as character no-undo .
     7782   define variable ll-rec as recid no-undo .
     7783   find current ub.ord-line-rcv no-lock  no-error .
     7784       if available ub.ord-line-rcv  then do:
     7785        ll-rec = recid(ord-line-rcv) .
     7786           run cus/or-obj.w
     7787           (      input  parParentProc
     7788                , input  g#host-code
     7789                , input  recid(ord-line-rcv)
     7790                , input  2
     7791                , input  'ИЗМЕНЕНИЕ':U
     7792                , input  'ПРОСМОТР':U
     7793                , input-output  v-doc-mode  ) .
     7794        end.
     7795   end.
     7796   END PROCEDURE.
     7797   PROCEDURE proc-b-7 :
     7798   do
     7799    on error undo, return error return-value
     7800    :
     7801   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv .
     7802   define variable ll-rec as recid no-undo .
     7803   define variable v-doc-mode as character no-undo .
     7804     find current ub.ord-line-rcv no-lock  no-error .
     7805       if avail  ub.ord-line-rcv then do:
     7806        find first buf_ord-doc-rcv no-lock where
     7807                   buf_ord-doc-rcv.doc-code = ub.ord-line-rcv.doc-code and
     7808                   buf_ord-doc-rcv.rcv-code = ub.ord-line-rcv.rcv-code no-error .
     7809        if buf_ord-doc-rcv.status_ <> 'новый':U   then do:
     7810           message "Нельзя корректировать поставку в статусе " caps(buf_ord-doc-rcv.status_) view-as alert-box information .
     7811           return.
     7812        end.
     7813        ll-rec = recid(b-all_ord-doc-rcv) .
     7814           run cus/or-obj.w
     7815           (      input  parParentProc
     7816                , input  g#host-code
     7817                , input  recid(ord-line-rcv)
     7818                , input  2
     7819                , input  'ИЗМЕНЕНИЕ':U
     7820                , input  'ИЗМЕНЕНИЕ':U
     7821                , input-output  v-doc-mode  ) .
     7822        g#log = BROWSE-20:refresh() in frame frame-h  no-error .
     7823        run calc-cons-ord in this-procedure .
     7824     end.
     7825   end.
     7826   END PROCEDURE.
     7827   PROCEDURE proc-b-ins-za :
     7828    do
     7829    on error undo, return error return-value
     7830    :
     7831   for each tt-goods :
     7832     delete tt-goods.
     7833   end.
     7834   for each my-obj :
     7835     delete my-obj.
     7836   end.
     7837   run new-zayvka in this-procedure .
     7838     end.
     7839   END PROCEDURE.
     7840   PROCEDURE proc-b-ok :
     7841   do
     7842    on error undo, return error return-value
     7843    :
     7844       if not can-find( first tt-goods no-lock  ) then do:
     7845         message "В совокупной заявке нет ни одного товара ! Удаляем заявку ?"
     7846           view-as alert-box question
     7847           buttons yes-no
     7848           update g#log
     7849         .
     7850         if g#log then  do:
     7851             find first ub.ord-cons  exclusive-lock  where ub.ord-cons.cons-code = loc-ord-cons-code no-error .
     7852             if error-status :error then do:
     7853                 message vss-workfile vss-revision vss-description skip
     7854                 error-status :get-message(1)  .
     7855                 return.
     7856                 end.
     7857             delete ub.ord-cons.
     7858             end.
     7859       end.
     7860   end.
     7861   END PROCEDURE.
     7862   PROCEDURE proc-br-16 :
     7863   do
     7864    on error undo, return error return-value
     7865    :
     7866   if frame FRAME-postavki:visible and avail ub.ord-doc and T-of then do:
     7867     OPEN QUERY BROWSE-21 FOR EACH new-rcv       WHERE new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH bb_ord-doc WHERE new-rcv.doc-code = bb_ord-doc.doc-code  OUTER-JOIN NO-LOCK.
     7868     BROWSE-29:title = "По заявке № "  + ub.ord-doc.doc-code. .
     7869     OPEN QUERY BROWSE-29 FOR EACH ub.new-rcv       WHERE new-rcv.cons-code = loc-ord-cons-code NO-LOCK,      EACH ub.ord-line-rcv WHERE                       ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND                           ub.ord-line-rcv.doc-code = new-rcv.doc-code NO-LOCK,      FIRST ub.bb_ord-doc WHERE bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK .
     7870   end.
     7871   end.
     7872   END PROCEDURE.
     7873   PROCEDURE proc-br-18 :
     7874   do
     7875    on error undo, return error return-value
     7876    :
     7877   find current tt-new-ord-line no-lock no-error.
     7878   if avail tt-new-ord-line then do:
     7879         loc-num-ord-FP = tt-new-ord-line.doc-code .
     7880         if not t-gds then do:
     7881             OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     7882             end.
     7883         else do:
     7884             OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE           ub.ord-doc-rcv.cons-code = loc-ord-cons-code and           ub.ord-doc-rcv.doc-code = loc-num-ord-FP and           ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,        EACH ub.ord-line-rcv WHERE                   ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and            ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and                  ( T-gds = true or (                         ub.ord-line-rcv.artic = tt-goods.artic                         and ub.ord-line-rcv.prod-code = tt-goods.prod-code                         and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,   EACH ub.goods where             ub.goods.artic = ub.ord-line-rcv.artic and             ub.goods.prod-code = ub.ord-line-rcv.prod-code and             ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     7885             browse-28:Title in frame frame-j = "Поставки по Заказу "  + loc-num-ord-FP.
     7886         end.
     7887   end.
     7888   end.
     7889   END PROCEDURE.
     7890   PROCEDURE proc-browse-14 :
     7891   do
     7892    on error undo, return error return-value
     7893    :
     7894     if frame FRAME-H:visible then do:
     7895     OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.
     7896     OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     7897     end.
     7898   end.
     7899   END PROCEDURE.
     7900   PROCEDURE proc-browse-26 :
     7901   do
     7902    on error undo, return error return-value
     7903    :
     7904   find current ub.ord-doc no-lock no-error.
     7905   if avail ub.ord-doc then do:
     7906     loc-num-ord-FP = ub.ord-doc.doc-code .
     7907     BROWSE-27:title in frame frame-k = "Поставки по заказу ФП № " + ub.ord-doc.doc-code .
     7908     OPEN QUERY BROWSE-27 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-code = loc-num-ord-FP and ub.ord-doc-rcv.doc-type = 'out':U       and ub.ord-doc-rcv.cons-code = loc-ord-cons-code  NO-LOCK.
     7909     end.
     7910   end.
     7911   END PROCEDURE.
     7912   PROCEDURE proc-bt-8 :
     7913    do
     7914    on error undo, return error return-value
     7915    :
     7916   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     7917   define variable d-rec as recid no-undo.
     7918     find current ub.ord-line-rcv no-lock no-error .
     7919     if avail  ub.ord-line-rcv then do:
     7920       g#log = no.
     7921       message "Удалить строку в поставке №" ub.ord-line-rcv.rcv-code "?   Вы уверены ?"
     7922               view-as alert-box question buttons OK-Cancel update g#log.
     7923         if g#log = false then return.
     7924        find first buf_ord-doc-rcv no-lock where
     7925                   buf_ord-doc-rcv.doc-code = ub.ord-line-rcv.doc-code and
     7926                   buf_ord-doc-rcv.rcv-code = ub.ord-line-rcv.rcv-code no-error .
     7927        if avail  buf_ord-doc-rcv then do:
     7928           if buf_ord-doc-rcv.status_ <> 'новый':U   then do:
     7929               message "Нельзя Удалять поставку в статусе " caps(buf_ord-doc-rcv.status_) view-as alert-box information .
     7930               return.
     7931               end.
     7932        end.
     7933     d-rec = recid (ord-line-rcv).
     7934     run del-post in this-procedure ( d-rec ).
     7935     OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     7936   end.
     7937     end.
     7938   END PROCEDURE.
     7939   PROCEDURE proc-but-10 :
     7940   do
     7941    on error undo, return error return-value
     7942    :
     7943    define variable d-rec as recid no-undo.
     7944     if avail  tt-new-ord-line then do:
     7945       g#log = no.
     7946       message "Удалить строку в  заказе №" tt-new-ord-line.doc-code "?   Вы уверены ?"
     7947               view-as alert-box question buttons OK-Cancel update g#log.
     7948         if g#log = false then return.
     7949     d-rec = recid (tt-new-ord-line).
     7950     run del-zakaz in this-procedure (d-rec).
     7951       OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .
     7952     end.
     7953   end.
     7954   END PROCEDURE.
     7955   PROCEDURE proc-but-17 :
     7956   do
     7957    on error undo, return error return-value
     7958    :
     7959   define variable v-doc-mode as character no-undo .
     7960   v-doc-mode  = 'ИЗМЕНЕНИЕ':U .
     7961    if avail  ub.ord-doc-rcv  and ub.ord-doc-rcv.doc-type = "in":u  then do:
     7962           run cus/or-obj.w
     7963           (      input  parParentProc
     7964                , input  g#host-code
     7965                , input  recid(ub.ord-doc-rcv)
     7966                , input  3
     7967                , input  'ИЗМЕНЕНИЕ':U
     7968                , input  'ИЗМЕНЕНИЕ':U
     7969                , input-output  v-doc-mode  ) .
     7970        g#log = BROWSE-23:refresh() in frame frame-i no-error .
     7971        run calc-cons-ord in this-procedure .
     7972     end.
     7973   end.
     7974   END PROCEDURE.
     7975   PROCEDURE proc-but-18 :
     7976   do
     7977    on error undo, return error return-value
     7978    :
     7979   define variable d-rec as recid no-undo.
     7980   g#log = no.
     7981   find current ub.ord-doc-rcv no-lock no-error .
     7982   if avail  ub.ord-doc-rcv then do:
     7983   message "Удалить поставку №" ub.ord-doc-rcv.doc-code "?   Вы уверены ?"
     7984                    view-as alert-box question buttons OK-Cancel update g#log.
     7985   if g#log = false then return.
     7986     d-rec = recid (ub.ord-doc-rcv).
     7987     run del-post-doc in this-procedure (d-rec).
     7988     OPEN QUERY BROWSE-23 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-type = 'in'  AND ub.ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK.
     7989   end.
     7990   end.
     7991   END PROCEDURE.
     7992   PROCEDURE proc-color-status :
     7993   do
     7994    on error undo, return error return-value
     7995    :
     7996   define input parameter num-m    as integer no-undo .
     7997   define input parameter p-status as character no-undo .
     7998   define variable h-cell    as handle no-undo .
     7999   define variable kk as integer no-undo .
     8000   define variable v-nn as integer   no-undo .
     8001   v-nn = num-entries( handle-br-all [num-m] ).
     8002    do kk =  1 to v-nn :
     8003        h-cell =  WIDGET-HANDLE(entry(kk, handle-br-all [num-m] )) .
     8004        run color-cell in this-procedure ( h-cell, user-color-status , p-status , 'новый':U) .
     8005    end.
     8006   end.
     8007   END PROCEDURE.
     8008   PROCEDURE proc-color-str :
     8009   do
     8010    on error undo, return error return-value
     8011    :
     8012     if tt-goods.gds-t = 'признак':U then
     8013        assign
     8014          tt-goods.artic      :fgcolor in browse browse-30 = blue_color
     8015          tt-goods.all-name   :fgcolor in browse browse-30 = blue_color
     8016          tt-goods.sum-qnty   :fgcolor in browse browse-30 = blue_color
     8017          tt-goods.sum-ord    :fgcolor in browse browse-30 = blue_color
     8018          tt-goods.sum-rcv    :fgcolor in browse browse-30 = blue_color
     8019          tt-goods.sum-rcv-in :fgcolor in browse browse-30 = blue_color
     8020          tt-goods.unit-base  :fgcolor in browse browse-30 = blue_color
     8021          tt-goods.unit-cli   :fgcolor in browse browse-30 = blue_color
     8022          tt-goods.sum-fact   :fgcolor in browse browse-30 = blue_color
     8023          tt-goods.gds-t      :fgcolor in browse browse-30 = blue_color
     8024           .
     8025        else
     8026         assign
     8027          tt-goods.artic      :fgcolor in browse browse-30 = ?
     8028          tt-goods.all-name   :fgcolor in browse browse-30 = ?
     8029          tt-goods.sum-qnty   :fgcolor in browse browse-30 = ?
     8030          tt-goods.sum-ord    :fgcolor in browse browse-30 = ?
     8031          tt-goods.sum-rcv    :fgcolor in browse browse-30 = ?
     8032          tt-goods.sum-rcv-in :fgcolor in browse browse-30 = ?
     8033          tt-goods.unit-base  :fgcolor in browse browse-30 = ?
     8034          tt-goods.unit-cli   :fgcolor in browse browse-30 = ?
     8035          tt-goods.sum-fact   :fgcolor in browse browse-30 = ?
     8036          tt-goods.gds-t      :fgcolor in browse browse-30 = ?
     8037        .
     8038     if tt-goods.sum-qnty - (tt-goods.sum-ord + tt-goods.sum-rcv-in) < 0 then do:
     8039        tt-goods.sum-ord       :fgcolor in browse browse-30 = 12 .
     8040        tt-goods.sum-rcv-in    :fgcolor in browse browse-30 = 12 .
     8041     end.
     8042     if tt-goods.sum-ord < tt-goods.sum-rcv then do:
     8043        tt-goods.sum-rcv       :fgcolor in browse browse-30 = 12 .
     8044     end.
     8045   end.
     8046   END PROCEDURE.
     8047   PROCEDURE proc-create-rcv-doc :
     8048    do
     8049    on error undo, return error return-value
     8050    :
     8051   define input parameter p-PS               like ub.ord-doc-rcv.PS            no-undo .
     8052   define input parameter p-base-rate        like ub.ord-doc-rcv.base-rate     no-undo .
     8053   define input parameter p-base-scale       like ub.ord-doc-rcv.base-scale    no-undo .
     8054   define input parameter p-cli-code         like ub.ord-doc-rcv.cli-code      no-undo .
     8055   define input parameter p-cli-type         like ub.ord-doc-rcv.cli-type      no-undo .
     8056   define input parameter p-cons-code        like ub.ord-doc-rcv.cons-code     no-undo .
     8057   define input parameter p-creid            like ub.ord-doc-rcv.creid         no-undo .
     8058   define input parameter p-cycle-day        like ub.ord-doc-rcv.cycle-day     no-undo .
     8059   define input parameter p-date-pay         like ub.ord-doc-rcv.date-pay      no-undo .
     8060   define input parameter p-doc-code         like ub.ord-doc-rcv.doc-code      no-undo .
     8061   define input parameter p-doc-date         like ub.ord-doc-rcv.doc-date      no-undo .
     8062   define input parameter p-doc-type         like ub.ord-doc-rcv.doc-type      no-undo .
     8063   define input parameter p-exch-code        like ub.ord-doc-rcv.exch-code     no-undo .
     8064   define input parameter p-exch-date        like ub.ord-doc-rcv.exch-date     no-undo .
     8065   define input parameter p-exch-rate        like ub.ord-doc-rcv.exch-rate     no-undo .
     8066   define input parameter p-exch-scale       like ub.ord-doc-rcv.exch-scale    no-undo .
     8067   define input parameter p-fact-date        like ub.ord-doc-rcv.fact-date     no-undo .
     8068   define input parameter p-fact-num         like ub.ord-doc-rcv.fact-num      no-undo .
     8069   define input parameter p-fact-order       like ub.ord-doc-rcv.fact-order    no-undo .
     8070   define input parameter p-fact-ship-time   like ub.ord-doc-rcv.fact-ship-time  no-undo .
     8071   define input parameter p-fact-time        like ub.ord-doc-rcv.fact-time       no-undo .
     8072   define input parameter p-flag_            like ub.ord-doc-rcv.flag_           no-undo .
     8073   define input parameter p-host-code        like ub.ord-doc-rcv.host-code       no-undo .
     8074   define input parameter p-obj-code         like ub.ord-doc-rcv.obj-code        no-undo .
     8075   define input parameter p-obj-type         like ub.ord-doc-rcv.obj-type        no-undo .
     8076   define input parameter p-order-type       like ub.ord-doc-rcv.order-type      no-undo .
     8077   define input parameter p-rcv-code         like ub.ord-doc-rcv.rcv-code        no-undo .
     8078   define input parameter p-shift-date       like ub.ord-doc-rcv.shift-date      no-undo .
     8079   define input parameter p-shift-num        like ub.ord-doc-rcv.shift-num       no-undo .
     8080   define input parameter p-shift-name       like ub.ord-doc-rcv.shift-name      no-undo .
     8081   define input parameter p-ship-date        like ub.ord-doc-rcv.ship-date       no-undo .
     8082   define input parameter p-ship-time        like ub.ord-doc-rcv.ship-time       no-undo .
     8083   define input parameter p-status_          like ub.ord-doc-rcv.status_         no-undo .
     8084   define input parameter p-sum-service      like ub.ord-doc-rcv.sum-service     no-undo .
     8085   define input parameter p-sum-ship         like ub.ord-doc-rcv.sum-ship        no-undo .
     8086   define input parameter p-sys-date         like ub.ord-doc-rcv.sys-date        no-undo .
     8087   define input parameter p-sys-time-int     like ub.ord-doc-rcv.sys-time-int    no-undo .
     8088   define input parameter p-sys-time         like ub.ord-doc-rcv.sys-time        no-undo .
     8089   define input parameter p-tot-lines        like ub.ord-doc-rcv.tot-lines       no-undo .
     8090   define input parameter p-trn-code         like ub.ord-doc-rcv.trn-code        no-undo .
     8091   define input parameter p-user-db-num      like ub.ord-doc-rcv.user-db-num     no-undo .
     8092   define input parameter p-user-name        like ub.ord-doc-rcv.user-name       no-undo .
     8093   create ub.ord-doc-rcv.
     8094   assign
     8095    ub.ord-doc-rcv.PS                =  p-PS
     8096    ub.ord-doc-rcv.base-rate         =  p-base-rate
     8097    ub.ord-doc-rcv.base-scale        =  p-base-scale
     8098    ub.ord-doc-rcv.cli-code          =  p-cli-code
     8099    ub.ord-doc-rcv.cli-type          =  p-cli-type
     8100    ub.ord-doc-rcv.cons-code         =  p-cons-code
     8101    ub.ord-doc-rcv.creid             =  p-creid
     8102    ub.ord-doc-rcv.cycle-day         =  p-cycle-day
     8103    ub.ord-doc-rcv.date-pay          =  p-date-pay
     8104    ub.ord-doc-rcv.doc-code          =  p-doc-code
     8105    ub.ord-doc-rcv.doc-date          =  p-doc-date
     8106    ub.ord-doc-rcv.doc-type          =  p-doc-type
     8107    ub.ord-doc-rcv.exch-code         =  p-exch-code
     8108    ub.ord-doc-rcv.exch-date         =  p-exch-date
     8109    ub.ord-doc-rcv.exch-rate         =  p-exch-rate
     8110    ub.ord-doc-rcv.exch-scale        =  p-exch-scale
     8111    ub.ord-doc-rcv.fact-date         =  p-fact-date
     8112    ub.ord-doc-rcv.fact-num          =  p-fact-num
     8113    ub.ord-doc-rcv.fact-order        =  p-fact-order
     8114    ub.ord-doc-rcv.fact-ship-time    =  p-fact-ship-time
     8115    ub.ord-doc-rcv.fact-time         =  p-fact-time
     8116    ub.ord-doc-rcv.flag_             =  p-flag_
     8117    ub.ord-doc-rcv.host-code         =  p-host-code
     8118    ub.ord-doc-rcv.obj-code          =  p-obj-code
     8119    ub.ord-doc-rcv.obj-type          =  p-obj-type
     8120    ub.ord-doc-rcv.order-type        =  p-order-type
     8121    ub.ord-doc-rcv.rcv-code          =  p-rcv-code
     8122    ub.ord-doc-rcv.shift-date        =  p-shift-date
     8123    ub.ord-doc-rcv.shift-num         =  p-shift-num
     8124    ub.ord-doc-rcv.shift-name        =  p-shift-name
     8125    ub.ord-doc-rcv.ship-date         =  p-ship-date
     8126    ub.ord-doc-rcv.ship-time         =  p-ship-time
     8127    ub.ord-doc-rcv.status_           =  p-status_
     8128    ub.ord-doc-rcv.sum-service       =  p-sum-service
     8129    ub.ord-doc-rcv.sum-ship          =  p-sum-ship
     8130    ub.ord-doc-rcv.sys-date          =  p-sys-date
     8131    ub.ord-doc-rcv.sys-time-int      =  p-sys-time-int
     8132    ub.ord-doc-rcv.sys-time          =  p-sys-time
     8133    ub.ord-doc-rcv.tot-lines         =  p-tot-lines
     8134    ub.ord-doc-rcv.user-db-num       =  p-user-db-num
     8135    ub.ord-doc-rcv.user-name         =  p-user-name
     8136   .
     8137     end.
     8138   END PROCEDURE.
     8139   PROCEDURE proc-create-rcv-line :
     8140    do
     8141    on error undo, return error return-value
     8142    :
     8143   define input parameter p-SLT-pc            like ub.ord-line-rcv.SLT-pc                 no-undo .
     8144   define input parameter p-VAT-pc            like ub.ord-line-rcv.VAT-pc                 no-undo .
     8145   define input parameter p-artic             like ub.ord-line-rcv.artic                  no-undo .
     8146   define input parameter p-cli-base-rate     like ub.ord-line-rcv.cli-base-rate          no-undo .
     8147   define input parameter p-cli-qnty          like ub.ord-line-rcv.cli-qnty               no-undo .
     8148   define input parameter p-doc-code          like ub.ord-line-rcv.doc-code               no-undo .
     8149   define input parameter p-excise            like ub.ord-line-rcv.excise                 no-undo .
     8150   define input parameter p-gds-code          like ub.ord-line-rcv.gds-code               no-undo .
     8151   define input parameter p-line-num          like ub.ord-line-rcv.line-num               no-undo .
     8152   define input parameter p-other-base        like ub.ord-line-rcv.other-base             no-undo .
     8153   define input parameter p-other-rubl        like ub.ord-line-rcv.other-rubl             no-undo .
     8154   define input parameter p-price-base        like ub.ord-line-rcv.price-base             no-undo .
     8155   define input parameter p-price-cli         like ub.ord-line-rcv.price-cli              no-undo .
     8156   define input parameter p-price-rubl        like ub.ord-line-rcv.price-rubl             no-undo .
     8157   define input parameter p-prod-code         like ub.ord-line-rcv.prod-code              no-undo .
     8158   define input parameter p-prod-type         like ub.ord-line-rcv.prod-type              no-undo .
     8159   define input parameter p-qnty              like ub.ord-line-rcv.qnty                   no-undo .
     8160   define input parameter p-rcv-code          like ub.ord-line-rcv.rcv-code               no-undo .
     8161   define input parameter p-road-tax          like ub.ord-line-rcv.road-tax               no-undo .
     8162   define input parameter p-sum-SLT           like ub.ord-line-rcv.sum-SLT                no-undo .
     8163   define input parameter p-sum-VAT           like ub.ord-line-rcv.sum-VAT                no-undo .
     8164   define input parameter p-sum-base          like ub.ord-line-rcv.sum-base               no-undo .
     8165   define input parameter p-sum-cli           like ub.ord-line-rcv.sum-cli                no-undo .
     8166   define input parameter p-sum-excise        like ub.ord-line-rcv.sum-excise             no-undo .
     8167   define input parameter p-sum-other-base    like ub.ord-line-rcv.sum-other-base         no-undo .
     8168   define input parameter p-sum-other-rubl    like ub.ord-line-rcv.sum-other-rubl         no-undo .
     8169   define input parameter p-sum-road-tax      like ub.ord-line-rcv.sum-road-tax           no-undo .
     8170   define input parameter p-sum-rubl          like ub.ord-line-rcv.sum-rubl               no-undo .
     8171   define input parameter p-sum-transport-base like ub.ord-line-rcv.sum-transport-base    no-undo .
     8172   define input parameter p-sum-transport-rubl like ub.ord-line-rcv.sum-transport-rubl    no-undo .
     8173   define input parameter p-transport-base    like ub.ord-line-rcv.transport-base         no-undo .
     8174   define input parameter p-transport-rubl    like ub.ord-line-rcv.transport-rubl         no-undo .
     8175   define input parameter p-unit-cli          like ub.ord-line-rcv.unit-cli               no-undo .
     8176   define input parameter p-v-vat             like ub.ord-line-rcv.v-vat                  no-undo .
     8177       create  ub.ord-line-rcv.
     8178       assign
     8179         ub.ord-line-rcv.doc-code            = p-doc-code
     8180         ub.ord-line-rcv.rcv-code            = p-rcv-code
     8181         ub.ord-line-rcv.SLT-pc              = p-SLT-pc
     8182         ub.ord-line-rcv.VAT-pc              = p-VAT-pc
     8183         ub.ord-line-rcv.artic               = p-artic
     8184         ub.ord-line-rcv.cli-base-rate       = p-cli-base-rate
     8185         ub.ord-line-rcv.cli-qnty            = p-cli-qnty
     8186         ub.ord-line-rcv.excise              = p-excise
     8187         ub.ord-line-rcv.gds-code            = p-gds-code
     8188         ub.ord-line-rcv.line-num            = p-line-num
     8189         ub.ord-line-rcv.other-base          = p-other-base
     8190         ub.ord-line-rcv.other-rubl          = p-other-rubl
     8191         ub.ord-line-rcv.price-base          = p-price-base
     8192         ub.ord-line-rcv.price-cli           = p-price-cli
     8193         ub.ord-line-rcv.price-rubl          = p-price-rubl
     8194         ub.ord-line-rcv.prod-code           = p-prod-code
     8195         ub.ord-line-rcv.prod-type           = p-prod-type
     8196         ub.ord-line-rcv.qnty                = p-qnty
     8197         ub.ord-line-rcv.road-tax            = p-road-tax
     8198         ub.ord-line-rcv.sum-SLT             = p-sum-SLT
     8199         ub.ord-line-rcv.sum-VAT             = p-sum-VAT
     8200         ub.ord-line-rcv.sum-base            = p-sum-base
     8201         ub.ord-line-rcv.sum-cli             = p-sum-cli
     8202         ub.ord-line-rcv.sum-excise          = p-sum-excise
     8203         ub.ord-line-rcv.sum-other-base      = p-sum-other-base
     8204         ub.ord-line-rcv.sum-other-rubl      = p-sum-other-rubl
     8205         ub.ord-line-rcv.sum-road-tax        = p-sum-road-tax
     8206         ub.ord-line-rcv.sum-rubl            = p-sum-rubl
     8207         ub.ord-line-rcv.sum-transport-base  = p-sum-transport-base
     8208         ub.ord-line-rcv.sum-transport-rubl  = p-sum-transport-rubl
     8209         ub.ord-line-rcv.transport-base      = p-transport-base
     8210         ub.ord-line-rcv.transport-rubl      = p-transport-rubl
     8211         ub.ord-line-rcv.unit-cli            = p-unit-cli
     8212         ub.ord-line-rcv.v-vat               = p-v-vat
     8213      .
     8214     end.
     8215   END PROCEDURE.
     8216   PROCEDURE proc-init-button-2 :
     8217   do
     8218    on error undo, return error return-value
     8219    :
     8220    button-2:LOAD-IMAGE-UP("adeicon\ts-up":U)           in frame Dialog-Frame .
     8221    F-obj:fgcolor = 1   .
     8222    button-3:LOAD-IMAGE-Up("adeicon\ts-down":U)      in frame Dialog-Frame .
     8223    button-47:LOAD-IMAGE-Up("adeicon\ts-down":U)      in frame Dialog-Frame.
     8224    f-post:fgcolor = ? .
     8225    f-post-2:fgcolor = ?.
     8226     if t-prt then do:
     8227               VIEW FRAME FRAME-b.
     8228               OPEN QUERY BROWSE-36 FOR EACH obj_ord-dtl-rcv     WHERE x-artic      = obj_ord-dtl-rcv.artic and           x-prod-type  = obj_ord-dtl-rcv.prod-type and           x-prod-code  = obj_ord-dtl-rcv.prod-code and           string(obj_ord-dtl-rcv.node-code) MATCHES x-node-code NO-LOCK,            EACH obj_ord-doc-rcv           where obj_ord-doc-rcv.rcv-code     = obj_ord-dtl-rcv.rcv-code and                   obj_ord-doc-rcv.doc-code   = obj_ord-dtl-rcv.doc-code and                   obj_ord-doc-rcv.doc-type   = 'in' and                   obj_ord-doc-rcv.cons-code  = loc-ord-cons-code                  NO-LOCK,          first ub.gds-prt WHERE ub.gds-prt.node-code = obj_ord-dtl-rcv.node-code NO-LOCK.    OPEN QUERY BROWSE-37 FOR EACH obj_prt-obj               WHERE obj_prt-obj.is-term = true and                           x-artic      = obj_prt-obj.artic and                     x-prod-type  = obj_prt-obj.prod-type and                     x-prod-code  = obj_prt-obj.prod-code and                     string(obj_prt-obj.prt-code) MATCHES x-node-code NO-LOCK,              each ub.gds-prt WHERE ub.gds-prt.node-code = obj_prt-obj.prt-code NO-LOCK.
     8229               hide FRAME FRAME-e-prt.
     8230               hide FRAME FRAME-postavki-prt.
     8231               hide FRAME FRAME-e.
     8232               hide FRAME FRAME-postavki.
     8233               run proc-prt in this-procedure   .
     8234        end.
     8235        else  do:
     8236               hide FRAME FRAME-b-prt.
     8237               VIEW FRAME FRAME-b.
     8238               VIEW FRAME FRAME-H.
     8239               OPEN QUERY BROWSE-14 FOR EACH my-obj NO-LOCK,              EACH buf_gds-obj where              my-obj.obj-code = buf_gds-obj.obj-code and                       my-obj.obj-type = buf_gds-obj.obj-type and                   x-artic      = buf_gds-obj.artic     and             x-prod-type  = buf_gds-obj.prod-type and             x-prod-code  = buf_gds-obj.prod-code       NO-LOCK.
     8240               OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.    OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     8241               OPEN QUERY BROWSE-14 FOR EACH my-obj NO-LOCK,              EACH buf_gds-obj where              my-obj.obj-code = buf_gds-obj.obj-code and                       my-obj.obj-type = buf_gds-obj.obj-type and                   x-artic      = buf_gds-obj.artic     and             x-prod-type  = buf_gds-obj.prod-type and             x-prod-code  = buf_gds-obj.prod-code       NO-LOCK.
     8242               hide FRAME FRAME-e.
     8243               hide FRAME FRAME-e-prt.
     8244               hide FRAME FRAME-pos-prt.
     8245              run proc-t-of in this-procedure  .
     8246        end.
     8247   end.
     8248   END PROCEDURE.
     8249   PROCEDURE proc-init-button-3 :
     8250   do
     8251    on error undo, return error return-value
     8252    :
     8253    button-3:LOAD-IMAGE-UP("adeicon\ts-up":U)      in frame Dialog-Frame .
     8254    F-post-2:fgcolor = 1 .
     8255    button-2:LOAD-IMAGE-Up ("adeicon\ts-down":U)   in frame Dialog-Frame .
     8256    button-47:LOAD-IMAGE-Up("adeicon\ts-down":U)   in frame Dialog-Frame .
     8257    f-obj:fgcolor  = ? .
     8258    f-post:fgcolor = ? .
     8259     if t-prt then do:
     8260               VIEW FRAME FRAME-e.
     8261               OPEN QUERY BROWSE-32 FOR EACH e_fp_ord-dtl       WHERE x-artic      = e_fp_ord-dtl.artic and x-prod-type  = e_fp_ord-dtl.prod-type and x-prod-code  = e_fp_ord-dtl.prod-code and string(e_fp_ord-dtl.node-code) MATCHES x-node-code NO-LOCK,              EACH e_fp_ord-doc OF e_fp_ord-dtl where                        e_fp_ord-doc.cons-code = loc-ord-cons-code and                        e_fp_ord-doc.doc-type = 'ФП':U                       NO-LOCK,              first ub.gds-prt WHERE ub.gds-prt.node-code = e_fp_ord-dtl.node-code NO-LOCK.    OPEN QUERY BROWSE-33 FOR EACH e_fp_ord-dtl-rcv               WHERE x-artic      = e_fp_ord-dtl-rcv.artic and                     x-prod-type  = e_fp_ord-dtl-rcv.prod-type and                     x-prod-code  = e_fp_ord-dtl-rcv.prod-code and                     string(e_fp_ord-dtl-rcv.node-code) MATCHES x-node-code NO-LOCK,              EACH e_fp_ord-doc-rcv                              where e_fp_ord-doc-rcv.rcv-code            = e_fp_ord-dtl-rcv.rcv-code and                                               e_fp_ord-doc-rcv.doc-code     = e_fp_ord-dtl-rcv.doc-code and                        e_fp_ord-doc-rcv.cons-code  = loc-ord-cons-code and                        e_fp_ord-doc-rcv.doc-type    = "out":U                       NO-LOCK,              first ub.gds-prt WHERE ub.gds-prt.node-code = e_fp_ord-dtl-rcv.node-code NO-LOCK.
     8262               run br-12 in this-procedure .
     8263               hide FRAME FRAME-b.
     8264               hide FRAME FRAME-b-prt.
     8265               hide FRAME FRAME-postavki.
     8266               hide FRAME FRAME-pos-prt.
     8267               run proc-prt in this-procedure   .
     8268              end.
     8269        else  do:
     8270               VIEW FRAME FRAME-e.
     8271               OPEN QUERY BROWSE-17 FOR EACH ub.buf_clients       WHERE ( buf_clients.sup-cons = true  OR buf_clients.sup-gds = true ) NO-LOCK,       FIRST ub.cli-gds WHERE ub.cli-gds.cli-code = buf_clients.obj-code   AND ub.cli-gds.cli-type = buf_clients.obj-type       AND ub.cli-gds.artic = x-artic and cli-gds.prod-type = x-prod-type and ub.cli-gds.host-code = g#host-code and cli-gds.prod-code = x-prod-code  NO-LOCK.
     8272               apply "VALUE-CHANGED":U to BROWSE-12 in frame frame-a.
     8273               hide FRAME FRAME-e-prt.
     8274               hide FRAME FRAME-b.
     8275               OPEN QUERY BROWSE-14 FOR EACH my-obj NO-LOCK,              EACH buf_gds-obj where              my-obj.obj-code = buf_gds-obj.obj-code and                       my-obj.obj-type = buf_gds-obj.obj-type and                   x-artic      = buf_gds-obj.artic     and             x-prod-type  = buf_gds-obj.prod-type and             x-prod-code  = buf_gds-obj.prod-code       NO-LOCK.
     8276               hide FRAME FRAME-postavki.
     8277               OPEN QUERY BROWSE-21 FOR EACH new-rcv       WHERE new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH bb_ord-doc WHERE new-rcv.doc-code = bb_ord-doc.doc-code  OUTER-JOIN NO-LOCK.    OPEN QUERY BROWSE-22 for each ub.ord-chain no-lock where         ub.ord-chain.doc-code = new-rcv.rcv-code and         ub.ord-chain.doc-type = 'rcv'            and         ub.ord-chain.rel-doc-type = 'trn',        EACH ub.trn-doc       WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK .    OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.
     8278              run proc-t-of in this-procedure  .
     8279       end.
     8280   end.
     8281   END PROCEDURE.
     8282   PROCEDURE proc-init-button-47 :
     8283   do
     8284    on error undo, return error return-value
     8285    :
     8286    button-47:LOAD-IMAGE-UP("adeicon\ts-up":U)           in frame Dialog-Frame .
     8287    F-post:fgcolor = 1   .
     8288    button-2:LOAD-IMAGE-Up("adeicon\ts-down":U)      in frame Dialog-Frame .
     8289    button-3:LOAD-IMAGE-Up("adeicon\ts-down":U)      in frame Dialog-Frame.
     8290    f-obj:fgcolor    = ? .
     8291    f-post-2:fgcolor = ?.
     8292     if t-prt then do:
     8293             VIEW FRAME FRAME-postavki.
     8294             OPEN QUERY BROWSE-21 FOR EACH new-rcv       WHERE new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH bb_ord-doc WHERE new-rcv.doc-code = bb_ord-doc.doc-code  OUTER-JOIN NO-LOCK.    OPEN QUERY BROWSE-22 for each ub.ord-chain no-lock where         ub.ord-chain.doc-code = new-rcv.rcv-code and         ub.ord-chain.doc-type = 'rcv'            and         ub.ord-chain.rel-doc-type = 'trn',        EACH ub.trn-doc       WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK .    OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.
     8295             hide FRAME FRAME-b .
     8296             hide FRAME FRAME-e .
     8297             hide FRAME FRAME-b-prt .
     8298             hide FRAME FRAME-e-prt .
     8299             run proc-prt in this-procedure   .
     8300        end.
     8301        else  do:
     8302             VIEW FRAME FRAME-postavki.
     8303             OPEN QUERY BROWSE-21 FOR EACH new-rcv       WHERE new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH bb_ord-doc WHERE new-rcv.doc-code = bb_ord-doc.doc-code  OUTER-JOIN NO-LOCK.    OPEN QUERY BROWSE-22 for each ub.ord-chain no-lock where         ub.ord-chain.doc-code = new-rcv.rcv-code and         ub.ord-chain.doc-type = 'rcv'            and         ub.ord-chain.rel-doc-type = 'trn',        EACH ub.trn-doc       WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK .    OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.
     8304             hide FRAME FRAME-b.
     8305             hide FRAME FRAME-post-prt.
     8306             OPEN QUERY BROWSE-14 FOR EACH my-obj NO-LOCK,              EACH buf_gds-obj where              my-obj.obj-code = buf_gds-obj.obj-code and                       my-obj.obj-type = buf_gds-obj.obj-type and                   x-artic      = buf_gds-obj.artic     and             x-prod-type  = buf_gds-obj.prod-type and             x-prod-code  = buf_gds-obj.prod-code       NO-LOCK.
     8307             hide FRAME FRAME-e.
     8308             OPEN QUERY BROWSE-17 FOR EACH ub.buf_clients       WHERE ( buf_clients.sup-cons = true  OR buf_clients.sup-gds = true ) NO-LOCK,       FIRST ub.cli-gds WHERE ub.cli-gds.cli-code = buf_clients.obj-code   AND ub.cli-gds.cli-type = buf_clients.obj-type       AND ub.cli-gds.artic = x-artic and cli-gds.prod-type = x-prod-type and ub.cli-gds.host-code = g#host-code and cli-gds.prod-code = x-prod-code  NO-LOCK.
     8309             run proc-t-of in this-procedure  .
     8310        end.
     8311   end.
     8312   END PROCEDURE.
     8313   PROCEDURE proc-m_d_post :
     8314   do
     8315    on error undo, return error return-value
     8316    :
     8317   message 'TODO' .
     8318   find current new-rcv no-lock   no-error .
     8319   if avail new-rcv and new-rcv.trn-code <> "" then do:
     8320     message  "Отменить ссылку на накладную " new-rcv.trn-code " у  поставки № " new-rcv.rcv-code  " ? "
     8321       view-as alert-box  Question
     8322       buttons yes-no update g#log .
     8323     if not g#log  then return .
     8324   find current new-rcv  exclusive-lock  no-error .
     8325     new-rcv.trn-code = "" .
     8326     g#log = BROWSE-21:refresh() in frame frame-postavki no-error .
     8327     OPEN QUERY BROWSE-22 for each ub.ord-chain no-lock where         ub.ord-chain.doc-code = new-rcv.rcv-code and         ub.ord-chain.doc-type = 'rcv'            and         ub.ord-chain.rel-doc-type = 'trn',        EACH ub.trn-doc       WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK .
     8328   end.
     8329   end.
     8330   END PROCEDURE.
     8331   PROCEDURE proc-prt :
     8332   do
     8333    on error undo, return error return-value
     8334    :
     8335   define variable p-recid as recid no-undo .
     8336      if t-prt then do:
     8337      frame Dialog-Frame:title = ttt + "(по признакам)" .
     8338         view FRAME FRAME-C.
     8339         view FRAME FRAME-D-prt.
     8340         hide FRAME FRAME-A.
     8341         hide FRAME FRAME-D.
     8342         if avail tt-goods then p-recid = recid(tt-goods) .
     8343         OPEN QUERY BROWSE-30 FOR EACH tt-goods  NO-LOCK,              EACH ub.ord-gds-cons where             ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code   OUTER-JOIN   NO-LOCK     by tt-goods.nn .
     8344         reposition browse-30 to recid p-recid no-error .
     8345         run br-12 in this-procedure .
     8346         if frame  frame-b:visible  then do:
     8347           view FRAME FRAME-b-prt.
     8348         end.
     8349         if frame  frame-e:visible  then do:
     8350           view FRAME FRAME-e-prt.
     8351         end.
     8352         if frame frame-postavki:visible  then do:
     8353           view FRAME FRAME-post-prt.
     8354         end.
     8355      end.
     8356      if not t-prt then do:
     8357         view FRAME FRAME-A.
     8358         view FRAME FRAME-D.
     8359         hide FRAME FRAME-C.
     8360         hide FRAME FRAME-D-prt.
     8361         hide FRAME FRAME-post-prt.
     8362         hide FRAME FRAME-e-prt.
     8363         hide FRAME FRAME-b-prt.
     8364         OPEN QUERY BROWSE-12 FOR EACH tt-goods where tt-goods.gds-t = 'товар':U NO-LOCK,              EACH ub.ord-gds-cons where            ub.ord-gds-cons.artic = tt-goods.artic   AND ub.ord-gds-cons.prod-code = tt-goods.prod-code   AND ub.ord-gds-cons.prod-type = tt-goods.prod-type   AND ub.ord-gds-cons.cons-code = loc-ord-cons-code  NO-LOCK   by tt-goods.nn.
     8365      end.
     8366   end.
     8367   END PROCEDURE.
     8368   PROCEDURE proc-row-br-12 :
     8369    do
     8370    on error undo, return error return-value
     8371    :
     8372     if tt-goods.sum-qnty - (tt-goods.sum-ord + tt-goods.sum-rcv-in) < 0 then do:
     8373        tt-goods.sum-ord       :fgcolor in browse browse-12 = 12 .
     8374        tt-goods.sum-rcv-in    :fgcolor in browse browse-12 = 12 .
     8375     end.
     8376     if tt-goods.sum-ord < tt-goods.sum-rcv then do:
     8377        tt-goods.sum-rcv    :fgcolor in browse browse-12 = 12 .
     8378     end.
     8379     end.
     8380   END PROCEDURE.
     8381   PROCEDURE proc-t-gds :
     8382   do
     8383    on error undo, return error return-value
     8384    :
     8385   assign frame  Dialog-Frame t-gds.
     8386   if t-gds then do :
     8387    message "Развернуть Заказ ФП № " + loc-num-ord-FP "?"
     8388     view-as alert-box question BUTTONS yes-no
     8389     update g#log
     8390     .
     8391     if g#log <> true then do:
     8392     t-gds = false.
     8393     return no-apply.
     8394     end.
     8395         if frame FRAME-E:visible then do:
     8396               view FRAME FRAME-j.
     8397               enable   B-mark-2 with frame frame-J .
     8398               OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .
     8399               OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE           ub.ord-doc-rcv.cons-code = loc-ord-cons-code and           ub.ord-doc-rcv.doc-code = loc-num-ord-FP and           ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,        EACH ub.ord-line-rcv WHERE                   ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and            ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and                  ( T-gds = true or (                         ub.ord-line-rcv.artic = tt-goods.artic                         and ub.ord-line-rcv.prod-code = tt-goods.prod-code                         and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,   EACH ub.goods where             ub.goods.artic = ub.ord-line-rcv.artic and             ub.goods.prod-code = ub.ord-line-rcv.prod-code and             ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     8400               browse-18:Title = "Заказ ФП № "  + loc-num-ord-FP.
     8401               apply "VALUE-CHANGED":U to BROWSE-18 in frame frame-J .
     8402               browse-28:Title = "Поставки по Заказу "  + loc-num-ord-FP.
     8403               hide FRAME FRAME-k.
     8404               OPEN QUERY BROWSE-26 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ФП':U and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code and ub.ord-doc.cli-type = buf_clients.obj-type))  NO-LOCK,       FIRST ub.shar-buf_ord-doc WHERE shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code NO-LOCK.    OPEN QUERY BROWSE-27 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-code = loc-num-ord-FP and ub.ord-doc-rcv.doc-type = 'out':U       and ub.ord-doc-rcv.cons-code = loc-ord-cons-code  NO-LOCK.
     8405           end.
     8406     end.
     8407   else do:
     8408     if frame FRAME-B:visible then do:
     8409              disable  B-mark-2 with frame frame-J .
     8410              hide FRAME FRAME-H.
     8411              OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.    OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     8412              view FRAME FRAME-i.
     8413              OPEN QUERY BROWSE-23 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-type = 'in'  AND ub.ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK.    OPEN QUERY BROWSE-24 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.doc-type = 'in' and             b-all_ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                  and            ub.ord-chain.rel-doc-type = 'trn' NO-LOCK,              EACH ub.trn-doc WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     8414    end.
     8415     if frame FRAME-E:visible then do:
     8416              hide FRAME FRAME-j.
     8417              OPEN QUERY BROWSE-18 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code         and ub.ord-doc.doc-type = 'ФП':U         and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code                      and ub.ord-doc.cli-type = buf_clients.obj-type))         and ( T-gds = false or (ub.ord-doc.doc-code = loc-num-ord-FP))         NO-LOCK,          EACH tt-new-ord-line       WHERE tt-new-ord-line.doc-code = ub.ord-doc.doc-code         and ( T-gds = true or (                 tt-new-ord-line.artic = tt-goods.artic         and tt-new-ord-line.prod-code = tt-goods.prod-code         and tt-new-ord-line.prod-type = tt-goods.prod-type))         NO-LOCK,          EACH ub.goods where              ub.goods.artic = tt-new-ord-line.artic and              ub.goods.prod-code = tt-new-ord-line.prod-code and              ub.goods.prod-type = tt-new-ord-line.prod-type              NO-LOCK             .    OPEN QUERY BROWSE-28 FOR EACH ub.ord-doc-rcv WHERE   ub.ord-doc-rcv.cons-code = loc-ord-cons-code and   ub.ord-doc-rcv.doc-type = 'out':U NO-LOCK,            EACH ub.ord-line-rcv WHERE     ub.ord-doc-rcv.doc-code  = ub.ord-line-rcv.doc-code and     ub.ord-doc-rcv.rcv-code  = ub.ord-line-rcv.rcv-code and       ( T-gds = true or (     ub.ord-line-rcv.artic = tt-goods.artic     and ub.ord-line-rcv.prod-code = tt-goods.prod-code     and ub.ord-line-rcv.prod-type = tt-goods.prod-type )) NO-LOCK,             EACH ub.goods where     ub.goods.artic = ub.ord-line-rcv.artic and     goods.prod-code = ub.ord-line-rcv.prod-code and     ub.goods.prod-type = ub.ord-line-rcv.prod-type NO-LOCK.
     8418              view FRAME FRAME-k.
     8419              OPEN QUERY BROWSE-26 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ФП':U and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code and ub.ord-doc.cli-type = buf_clients.obj-type))  NO-LOCK,       FIRST ub.shar-buf_ord-doc WHERE shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code NO-LOCK.    OPEN QUERY BROWSE-27 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-code = loc-num-ord-FP and ub.ord-doc-rcv.doc-type = 'out':U       and ub.ord-doc-rcv.cons-code = loc-ord-cons-code  NO-LOCK.
     8420     end.
     8421   end.
     8422   end.
     8423   END PROCEDURE.
     8424   PROCEDURE proc-t-of :
     8425   do
     8426    on error undo, return error return-value
     8427    :
     8428   if t-of then do :
     8429       hide t-gds in frame Dialog-Frame.
     8430       disable t-gds with frame Dialog-Frame.
     8431       t-gds = false.
     8432   frame Dialog-Frame:title = ttt + "(по документам)" .
     8433    str-good = "" .
     8434    str-good:Bgcolor = ?.
     8435    str-good:fgcolor = ?.
     8436    display str-good with frame Dialog-Frame.
     8437              view FRAME FRAME-F.
     8438              OPEN QUERY BROWSE-16 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK     BY ub.ord-doc.obj-type        BY ub.ord-doc.obj-code         BY ub.ord-doc.ship-date          BY ub.ord-doc.ship-time           BY ub.ord-doc.doc-code DESCENDING.
     8439              hide FRAME FRAME-D.
     8440              OPEN QUERY BROWSE-13 FOR EACH ub.m_ord-line       WHERE x-artic      = m_ord-line.artic and x-prod-type  = m_ord-line.prod-type and x-prod-code  = m_ord-line.prod-code  NO-LOCK,       EACH ub.ord-doc WHERE ub.ord-doc.doc-code = m_ord-line.doc-code       AND ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK.
     8441     if frame FRAME-B:visible then do:
     8442              hide FRAME FRAME-H.
     8443              OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.    OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     8444              view FRAME FRAME-i.
     8445              OPEN QUERY BROWSE-23 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-type = 'in'  AND ub.ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK.    OPEN QUERY BROWSE-24 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.doc-type = 'in' and             b-all_ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                  and            ub.ord-chain.rel-doc-type = 'trn' NO-LOCK,              EACH ub.trn-doc WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     8446    end.
     8447     if frame FRAME-E:visible then do:
     8448        view t-gds in frame Dialog-Frame.
     8449        enable t-gds with frame Dialog-Frame.
     8450        display t-gds with frame Dialog-Frame.
     8451              hide FRAME FRAME-j.
     8452              view FRAME FRAME-k.
     8453              OPEN QUERY BROWSE-26 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ФП':U and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code and ub.ord-doc.cli-type = buf_clients.obj-type))  NO-LOCK,       FIRST ub.shar-buf_ord-doc WHERE shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code NO-LOCK.    OPEN QUERY BROWSE-27 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-code = loc-num-ord-FP and ub.ord-doc-rcv.doc-type = 'out':U       and ub.ord-doc-rcv.cons-code = loc-ord-cons-code  NO-LOCK.
     8454              apply "VALUE-CHANGED":U to BROWSE-26 in frame frame-K .
     8455     end.
     8456     if frame FRAME-b:visible then do:
     8457              hide FRAME FRAME-h.
     8458              OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.    OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     8459              view FRAME FRAME-i.
     8460              OPEN QUERY BROWSE-23 FOR EACH ub.ord-doc-rcv       WHERE ub.ord-doc-rcv.doc-type = 'in'  AND ub.ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK.    OPEN QUERY BROWSE-24 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.doc-type = 'in' and             b-all_ord-doc-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                  and            ub.ord-chain.rel-doc-type = 'trn' NO-LOCK,              EACH ub.trn-doc WHERE ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK.
     8461     end.
     8462     if frame FRAME-postavki:visible and avail ub.ord-doc then do:
     8463        OPEN QUERY BROWSE-21 FOR EACH new-rcv       WHERE new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH bb_ord-doc WHERE new-rcv.doc-code = bb_ord-doc.doc-code  OUTER-JOIN NO-LOCK.
     8464        OPEN QUERY BROWSE-29 FOR       EACH new-rcv WHERE            new-rcv.cons-code = loc-ord-cons-code NO-LOCK,              EACH ub.ord-line-rcv WHERE             ub.ord-line-rcv.rcv-code = new-rcv.rcv-code AND             ub.ord-line-rcv.doc-code = new-rcv.doc-code AND             ub.ord-line-rcv.artic = tt-goods.artic and             ub.ord-line-rcv.prod-code = tt-goods.prod-code and             ub.ord-line-rcv.prod-type = tt-goods.prod-type NO-LOCK,              FIRST bb_ord-doc WHERE             bb_ord-doc.doc-code = new-rcv.doc-code OUTER-JOIN NO-LOCK.
     8465        apply "VALUE-CHANGED":U to BROWSE-12 in frame frame-a.
     8466        apply "VALUE-CHANGED":U to BROWSE-16 in frame frame-f.
     8467     end.
     8468   end.
     8469   else do:
     8470    find current tt-goods no-lock no-error .
     8471    if avail tt-goods then
     8472       str-good = x-artic + " " + tt-goods.gds-name .
     8473   else DO:
     8474   find first tt-goods no-lock no-error .
     8475   if not avail tt-goods then return error.
     8476       str-good = x-artic + " " + tt-goods.gds-name .
     8477   end.
     8478    str-good:fgcolor = 15.
     8479    str-good:bgcolor = 3.
     8480    display str-good with frame Dialog-Frame.
     8481   frame Dialog-Frame:title = ttt + " (по товарам)" .
     8482       hide t-gds in frame Dialog-Frame.
     8483       disable t-gds with frame Dialog-Frame.
     8484       t-gds = false.
     8485           view FRAME FRAME-D.
     8486            OPEN QUERY BROWSE-13 FOR EACH ub.m_ord-line       WHERE x-artic      = m_ord-line.artic and x-prod-type  = m_ord-line.prod-type and x-prod-code  = m_ord-line.prod-code  NO-LOCK,       EACH ub.ord-doc WHERE ub.ord-doc.doc-code = m_ord-line.doc-code       AND ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ОФ':U NO-LOCK.
     8487           if frame FRAME-B:visible then do:
     8488                   view FRAME FRAME-H.
     8489                  OPEN QUERY BROWSE-15 FOR EACH b-all_ord-doc-rcv       WHERE b-all_ord-doc-rcv.cons-code = loc-ord-cons-code AND             b-all_ord-doc-rcv.doc-type = 'in' NO-LOCK,              EACH ub.ord-chain WHERE            ub.ord-chain.doc-code = b-all_ord-doc-rcv.rcv-code and            ub.ord-chain.doc-type = 'rcv'                    and            ub.ord-chain.rel-doc-type = 'trn'    NO-LOCK            ,              EACH ub.trn-doc WHERE            ub.trn-doc.doc-code = ub.ord-chain.rel-doc-code NO-LOCK,              EACH ub.doc-line WHERE         ub.doc-line.doc-code   = ub.trn-doc.doc-code AND         ub.doc-line.artic      = x-artic and         ub.doc-line.prod-type  = x-prod-type and         ub.doc-line.prod-code  = x-prod-code         NO-LOCK.    OPEN QUERY BROWSE-20 FOR EACH b-all_ord-doc-rcv  WHERE b-all_ord-doc-rcv.doc-type     = 'in':U and b-all_ord-doc-rcv.cons-code  = loc-ord-cons-code NO-LOCK,        EACH ub.ord-line-rcv WHERE                 b-all_ord-doc-rcv.rcv-code =    ub.ord-line-rcv.rcv-code  and         x-artic          = ub.ord-line-rcv.artic and         x-prod-type  = ub.ord-line-rcv.prod-type and         x-prod-code  = ub.ord-line-rcv.prod-code   NO-LOCK.
     8490           end.
