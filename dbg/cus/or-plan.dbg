     4127   PROCEDURE start-mv-clmnbrowse-18:
     4128   def var old-session as logical no-undo.
     4129      old-session = SESSION:IMMEDIATE-DISPLAY.
     4130      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4131      SESSION:IMMEDIATE-DISPLAY = old-session.
     4132   END.
     4133   ON ctrl-cursor-right OF BROWSE browse-18 do:
     4134     RUN re-move-clmnbrowse-18 ( 1, 8).
     4135   END.
     4136   ON ctrl-cursor-left OF BROWSE browse-18 do:
     4137     RUN re-move-clmnbrowse-18 (8, 1).
     4138   END.
     4139   PROCEDURE re-move-clmnbrowse-18:
     4140     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4141     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4142     DO varmvibrowse-18 = 1 TO EXTENT(cur-clmn-numbrowse-18):
     4143       if cur-clmn-numbrowse-18[varmvibrowse-18] = source-column THEN cur-clmn-numbrowse-18[varmvibrowse-18] = -1.
     4144     END.
     4145     if browse-18:MOVE-COLUMN(source-column, target-column) IN FRAME frame-j then.
     4146     if source-column > target-column THEN
     4147     DO varmvjbrowse-18 = source-column - 1 to target-column BY -1:
     4148       DO varmvibrowse-18 = 1 TO EXTENT(cur-clmn-numbrowse-18):
     4149           if cur-clmn-numbrowse-18[varmvibrowse-18] = varmvjbrowse-18 THEN DO:
     4150             cur-clmn-numbrowse-18[varmvibrowse-18] = cur-clmn-numbrowse-18[varmvibrowse-18] + 1.
     4151           END.
     4152       END.
     4153     END.
     4154     ELSE
     4155     DO varmvjbrowse-18 = source-column + 1 to target-column:
     4156       DO varmvibrowse-18 = 1 TO EXTENT(cur-clmn-numbrowse-18):
     4157         if cur-clmn-numbrowse-18[varmvibrowse-18] = varmvjbrowse-18 THEN DO:
     4158           cur-clmn-numbrowse-18[varmvibrowse-18] = cur-clmn-numbrowse-18[varmvibrowse-18] - 1.
     4159         END.
     4160       END.
     4161     END.
     4162     DO varmvibrowse-18 = 1 TO EXTENT(cur-clmn-numbrowse-18):
     4163       if cur-clmn-numbrowse-18[varmvibrowse-18] = -1 THEN cur-clmn-numbrowse-18[varmvibrowse-18] = target-column.
     4164     END.
     4165   END PROCEDURE.
     4166   PROCEDURE ch-clmnbrowse-18:
     4167     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4168     if cur-clmn-loc <= 1 then do:
     4169       return .
     4170     end.
     4171     DO varmvibrowse-18 = 1 TO EXTENT(cur-clmn-numbrowse-18):
     4172       if cur-clmn-numbrowse-18[varmvibrowse-18] = cur-clmn-loc THEN move-elementbrowse-18 = varmvibrowse-18.
     4173     END.
     4174     RUN re-move-clmnbrowse-18 (cur-clmn-loc, 1).
     4175   END PROCEDURE.
     4176   PROCEDURE mv-brw-defaultbrowse-18:
     4177   def var old-session as logical no-undo.
     4178     old-session = SESSION:IMMEDIATE-DISPLAY.
     4179     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4180     do varmvlbrowse-18 = 1 to EXTENT(cur-clmn-numbrowse-18):
     4181       RUN re-move-clmnbrowse-18 (cur-clmn-numbrowse-18[varmvlbrowse-18], varmvlbrowse-18).
     4182     END.
     4183     RUN start-mv-clmnbrowse-18.
     4184     SESSION:IMMEDIATE-DISPLAY = old-session.
     4185   END PROCEDURE.
