     4115   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4116   DEF VAR cur-clmn-numbrowse-18 as INT EXTENT 8 no-undo.
     4117   DEF VAR varmvibrowse-18       as INT no-undo.
     4118   DEF VAR varmvjbrowse-18       as INT no-undo.
