     1889           "Тип документа" ub.trn-doc.doc-type skip
     1890           "Код документа" ub.trn-doc.doc-code skip
     1891           view-as alert-box error .
     1892         undo, return no-apply .
     1893       end.
     1894     end case .
     1895     if not g#log then   return no-apply.
     1896     run chg-trn in this-procedure .
     1897   end.
     1898   END.
     1899   ON CHOOSE OF BUTTON-27 IN FRAME FRAME-K
     1900   DO:
     1901     g#type = 'ФП':U.
     1902     run chg-ord-fp in this-procedure .
     1903     g#log =  BROWSE-26:REFRESH() no-error .
     1904   END.
     1905   ON CHOOSE OF BUTTON-28 IN FRAME FRAME-K
     1906   DO:
     1907     define variable d-rec as recid no-undo.
     1908       g#log = no.
     1909       find current ub.ord-doc no-lock no-error .
     1910       if avail  ub.ord-doc then do:
     1911             message "Удалить заказ №" ub.ord-doc.doc-code "?   Вы уверены ?"
     1912                     view-as alert-box question buttons OK-Cancel update g#log.
     1913               if g#log = false then return.
     1914           if ub.ord-doc.status_ <> 'новый':U then do:
     1915             message "Удалить можно только в статусе НОВЫЙ! "  view-as alert-box .
     1916             return no-apply.
     1917           end.
     1918               if avail ub.ord-doc then do:
     1919                 d-rec = recid (ub.ord-doc).
     1920                 run del-zakaz-doc in this-procedure (d-rec) .
     1921                     OPEN QUERY BROWSE-26 FOR EACH ub.ord-doc       WHERE ub.ord-doc.cons-code = loc-ord-cons-code and ub.ord-doc.doc-type = 'ФП':U and ( T-CLI-FP = false or (ub.ord-doc.cli-code = buf_clients.obj-code and ub.ord-doc.cli-type = buf_clients.obj-type))  NO-LOCK,       FIRST ub.shar-buf_ord-doc WHERE shar-buf_ord-doc.doc-code = ub.ord-doc.doc-code NO-LOCK.
     1922               end.
     1923       end.
     1924   END.
     1925   ON CHOOSE OF BUTTON-3 IN FRAME Dialog-Frame
     1926   DO:
     1927   run proc-init-button-3 in this-procedure .
     1928   END.
     1929   ON CHOOSE OF BUTTON-30 IN FRAME FRAME-K
     1930   DO:
     1931   define variable v-doc-mode as character no-undo .
     1932       if avail  ub.ord-doc-rcv then do:
     1933        if ub.ord-doc-rcv.status_ = 'новый':U then do:
     1934           run cus/or-obj.w
     1935                ( input  parParentProc
     1936                , input  ub.ord-doc-rcv.host-code
     1937                , input  recid(ub.ord-doc-rcv)
     1938                , input  3
     1939                , input  'ИЗМЕНЕНИЕ':U
     1940                , input  'ИЗМЕНЕНИЕ':U
     1941                , input-output  v-doc-mode
     1942                ) .
     1943           g#log = BROWSE-27:refresh() no-error .
     1944           run calc-cons-ord in this-procedure .
     1945        end.
     1946        else do:
     1947           if ub.ord-doc-rcv.status_ = 'согласование':U
     1948               then
     1949                   message "Статус поставки " ub.ord-doc-rcv.status_ ". Корректировать нельзя ."
     1950                   "Для проставления времени фактической доставки используйте другие режимы ! "
     1951                   view-as alert-box .
     1952               else  message "Статус поставки " ub.ord-doc-rcv.status_ ". Корректировать нельзя !  "
     1953                     view-as alert-box .
     1954        end.
     1955       end.
     1956   END.
