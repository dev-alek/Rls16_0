      438   define input parameter  p-artic         like ub.doc-line.artic  no-undo .
      439   define input parameter  p-prod-type     like ub.doc-line.prod-type  no-undo .
      440   define input parameter  p-prod-code     like ub.doc-line.prod-code  no-undo .
      441   define input parameter  p-cli-code      like ub.ord-doc.cli-code  no-undo .
      442   define input parameter  p-cli-type      like ub.ord-doc.cli-type  no-undo .
      443   define input parameter  p-cli-base-rate like ub.ord-line.cli-base-rate no-undo .
      444   define input parameter  p-curr-code  as integer   no-undo .
      445   define output parameter p-price-base like ub.doc-line.price-base no-undo .
      446   define output parameter p-price-rubl like ub.doc-line.price-rubl no-undo .
      447   define output parameter p-price-cli  like ub.doc-line.price-cli  no-undo .
      448   define buffer buf-lib-doc-line for ub.doc-line.
      449   define buffer buf_cli-gds for ub.cli-gds .
      450   define buffer buf_trn-doc for ub.trn-doc  .
      451   define variable vp-curr-code  like ub.trn-doc.exch-code.
      452   define variable vp-exch-rate  like ub.trn-doc.exch-rate.
      453   define variable vp-exch-scale like ub.trn-doc.exch-scale.
      454   define variable v-last-in-code   like ub.doc-line.doc-code  no-undo .
      455   define variable v-last-obj-type  like ub.clients.obj-type no-undo .
      456   define variable v-last-obj-code  like ub.clients.obj-code no-undo .
      457   define variable v-cli-base-rate as decimal   no-undo .
      458    find first buf_cli-gds no-lock where
      459               buf_cli-gds.cli-type   = p-cli-type    and
      460               buf_cli-gds.cli-code   = p-cli-code    and
      461               buf_cli-gds.host-code  = p-host-code   and
      462               buf_cli-gds.artic      = p-artic       and
      463               buf_cli-gds.prod-type  = p-prod-type   and
      464               buf_cli-gds.prod-code  = p-prod-code
      465               no-error .
      466   if available buf_cli-gds then do:
      467       find first buf_trn-doc no-lock
      468            where buf_trn-doc.doc-code  = buf_cli-gds.in-code no-error .
      469        if available buf_trn-doc then do:
      470           vp-curr-code  = buf_trn-doc.exch-code.
      471           vp-exch-rate  = buf_trn-doc.exch-rate.
      472           vp-exch-scale = buf_trn-doc.exch-scale.
      473        end.
      474       find first buf-lib-doc-line no-lock
      475         where buf-lib-doc-line.doc-code  = buf_cli-gds.in-code
      476           and buf-lib-doc-line.artic     = p-artic
      477           and buf-lib-doc-line.prod-type = p-prod-type
      478           and buf-lib-doc-line.prod-code = p-prod-code
      479         no-error .
      480   end.
      481   else do:
      482   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      483   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lastindc in g#library
      484     (input  p-host-code
      485     ,input  p-artic
      486     ,input  p-prod-type
      487     ,input  p-prod-code
      488     ,output v-last-in-code
      489     ,output v-last-obj-type
      490     ,output v-last-obj-code
      491     )  .
      492       find first buf_trn-doc no-lock
      493            where buf_trn-doc.doc-code  = v-last-in-code no-error .
      494        if available buf_trn-doc then do:
      495           vp-curr-code  = buf_trn-doc.exch-code.
      496           vp-exch-rate  = buf_trn-doc.exch-rate.
      497           vp-exch-scale = buf_trn-doc.exch-scale.
      498        end.
      499       find first buf-lib-doc-line no-lock
      500         where buf-lib-doc-line.doc-code  = v-last-in-code
      501           and buf-lib-doc-line.artic     = p-artic
      502           and buf-lib-doc-line.prod-type = p-prod-type
      503           and buf-lib-doc-line.prod-code = p-prod-code
      504         no-error .
      505   end.
      506       if available buf-lib-doc-line then do:
      507         assign
      508           v-cli-base-rate = buf-lib-doc-line.cli-base-rate
      509           p-price-base = buf-lib-doc-line.price-base
      510           p-price-rubl = buf-lib-doc-line.price-rubl
      511           p-price-cli  = (if vp-curr-code = 0 then buf-lib-doc-line.price-rubl else buf-lib-doc-line.price-base) * p-cli-base-rate
      512         .
      513         if v-cli-base-rate <> p-cli-base-rate
      514         then do:
      515             p-price-cli  = p-price-cli / v-cli-base-rate  .
      516         end.
      517          if p-curr-code <> vp-curr-code then do:
      518             p-price-cli  = p-price-rubl  .
      519         end.
      520       end.
      521       Else do:
      522         assign
      523           p-price-base = 0
      524           p-price-rubl = 0
      525           p-price-cli  = 0
      526         .
      527       end.
      528     end.
      529   end procedure.
      530   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   procedure create-chain :
      532   define input  parameter p-doc-code as character no-undo .
      533   define input  parameter p-doc-type as character no-undo .
      534   define input  parameter p-rel-doc-code as character no-undo .
      535   define input  parameter p-rel-doc-type as character no-undo .
      536   define input  parameter p-type as character no-undo .
      537   define input  parameter p-ps as character no-undo .
      538   define variable v-db-num as integer   no-undo .
      539     do
      540     on error undo, return error return-value
      541     :
      542     find first ub.sys-ctrl no-lock .
      543     v-db-num = ub.sys-ctrl.db-num .
      544     find first ub.ord-chain no-lock where
      545       ub.ord-chain.doc-code     = p-doc-code     and
      546       ub.ord-chain.doc-type     = p-doc-type     and
      547       ub.ord-chain.rel-type     = p-type         and
      548       ub.ord-chain.rel-doc-code = p-rel-doc-code and
      549       ub.ord-chain.rel-doc-type = p-rel-doc-type   no-error .
      550     if available ub.ord-chain then return .
      551     create ub.ord-chain.
      552     assign
      553       ub.ord-chain.doc-code     = p-doc-code
      554       ub.ord-chain.doc-type     = p-doc-type
      555       ub.ord-chain.ps           = p-ps
      556       ub.ord-chain.rel-doc-code = p-rel-doc-code
      557       ub.ord-chain.rel-doc-type = p-rel-doc-type
      558       ub.ord-chain.rel-id       = next-value( s-ord-ch, ub )
      559       ub.ord-chain.db-num       = v-db-num
      560       ub.ord-chain.rel-type     = p-type
      561       .
      562     end.
      563   end procedure.
