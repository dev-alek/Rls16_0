     1248   DEFINE VARIABLE v-road-tax like ub.price-list.road-tax no-undo .
     1249   DEFINE VARIABLE v-excise like ub.price-list.excise no-undo .
     1250   DEFINE VARIABLE v-doc-num like ub.price-list.doc-num no-undo .
     1251   DEFINE VARIABLE v-prod-name like ub.clients.obj-name no-undo .
     1252   DEFINE VARIABLE v-chk-sum as decimal no-undo .
     1253   DEFINE VARIABLE v-price-list-sum as decimal no-undo .
     1254   DEFINE VARIABLE v-add as logical no-undo.
     1255   DEFINE VARIABLE found as logical init yes no-undo .
     1256   DEFINE VARIABLE v-found as logical no-undo .
     1257   DEFINE VARIABLE NotInc as logical no-undo .
     1258   define variable g#report-num as integer no-undo .
     1259   define buffer buf_chk-doc for ub.chk-doc.
     1260   define buffer buf_chk-gds for ub.chk-gds.
     1261   define buffer buf_goods for ub.goods.
     1262   define buffer buf_bar-code for ub.bar-code.
