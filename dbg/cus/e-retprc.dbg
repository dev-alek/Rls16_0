     1417               obj-list.obj-type = 'маг':U NO-LOCK :
     1418         FOR EACH buf_sale-doc NO-LOCK WHERE
     1419                  buf_Sale-doc.obj-type = obj-list.obj-type
     1420              AND buf_sale-doc.obj-code = obj-list.obj-code
     1421              AND buf_sale-doc.status_ = 'факт':U
     1422              AND buf_sale-doc.chr-office = 'у':U
     1423              AND (
     1424                 buf_sale-doc.shift-date >= X-date-start
     1425                 AND
     1426                 buf_sale-doc.shift-date <= X-date-end):
     1427           IF X-Radio-Task = 3 AND
