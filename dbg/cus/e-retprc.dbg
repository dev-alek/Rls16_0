     1265   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   PROCEDURE no-benq.
     1267   DEFINE OUTPUT PARAMETER found as logical init no.
     1268   define buffer buf_chk-doc for ub.chk-doc.
     1269   FOR EACH obj-list WHERE
     1270           obj-list.obj-type = 'маг':U NO-LOCK :
     1271     CASE X-Radio-Task > 1 :
     1272       WHEN YES THEN DO:
     1273         FOR EACH buf_chk-doc NO-LOCK WHERE
     1274                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1275                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1276                 (
     1277                   buf_chk-doc.shift-date >= X-date-start AND
     1278                   buf_chk-doc.shift-date <= X-date-end)
     1279                   AND
     1280                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1281           IF X-Radio-Task = 3 AND
     1282           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1283             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1284           IF X-Radio-Task = 4 AND
     1285           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1286           found = yes.
     1287           return.
     1288         END.
     1289       END.
     1290       WHEN NO THEN DO:
     1291         FOR EACH buf_chk-doc NO-LOCK WHERE
     1292               buf_chk-doc.obj-type = obj-list.obj-type AND
     1293               buf_chk-doc.obj-code = obj-list.obj-code AND
     1294               buf_chk-doc.chk-date >= X-date-start AND
     1295               buf_chk-doc.chk-date <= X-date-end   AND
     1296               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1297           found = yes.
     1298           return.
     1299         END.
     1300        END.
     1301      END CASE.
     1302    END.
     1303   END PROCEDURE.
     1304   PROCEDURE no-benqi.
     1305   DEFINE OUTPUT PARAMETER found as logical init no.
     1306   define buffer buf_chk-doc for ub.chk-doc.
     1307   define buffer buf_inkas for ub.inkas.
     1308   FOR EACH obj-list WHERE
     1309         obj-list.obj-type = 'маг':U NO-LOCK :
     1310     CASE X-Radio-Task > 1 :
     1311       WHEN YES THEN DO:
     1312         FOR EACH buf_chk-doc No-LOCK WHERE
     1313                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1314                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1315                 (
     1316                   buf_chk-doc.shift-date >= X-date-start AND
     1317                   buf_chk-doc.shift-date <= X-date-end)
     1318                   AND
     1319                   buf_Chk-doc.out-code = ? AND
     1320                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1321           IF X-Radio-Task = 3 AND
     1322           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1323             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1324           IF X-Radio-Task = 4 AND
     1325           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1326           found = yes.
     1327           return.
     1328         END.
     1329         FOR EACH buf_inkas No-LOCK WHERE
     1330                   buf_inkas.obj-type = obj-list.obj-type AND
     1331                   buf_inkas.obj-code = obj-list.obj-code AND
     1332                   (
     1333                   buf_inkas.shift-date >= X-date-start AND
     1334                   buf_inkas.shift-date <= X-date-end):
     1335           if buf_inkas.status_ = 'факт':U
     1336           or buf_inkas.status_ = 'запрос':U then next.
     1337           IF X-Radio-Task = 3 AND
     1338           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1339             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1340           IF X-Radio-Task = 4 AND
     1341           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1342           found = yes.
     1343           return.
     1344         END.
     1345       END.
     1346       WHEN NO THEN DO:
     1347         FOR EACH buf_chk-doc NO-LOCK WHERE
     1348                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1349                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1350                 buf_chk-doc.chk-date >= X-date-start AND
     1351                 buf_chk-doc.chk-date <= X-date-end   AND
     1352                 buf_Chk-doc.out-code = ? AND
     1353                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1354           found = yes.
     1355           return.
     1356         END.
     1357         FOR EACH buf_inkas NO-LOCK WHERE
     1358                 buf_inkas.obj-type = obj-list.obj-type AND
     1359                 buf_inkas.obj-code = obj-list.obj-code AND
     1360                 buf_inkas.doc-date >= X-date-start AND
     1361                 buf_inkas.doc-date <= X-date-end :
     1362           if buf_inkas.status_ = 'факт':U
     1363           or buf_inkas.status_ = 'запрос':U then next.
     1364           found = yes.
     1365           return.
     1366         END.
     1367       END.
     1368     END CASE.
     1369   END.
     1370   END PROCEDURE.
     1371   PROCEDURE no-benq-i.
