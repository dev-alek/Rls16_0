     1481     "ЦЕНА В ЧЕКЕ"  + chr(44) +
     1482     "ЦЕНА ПО ПРАЙС-ЛИСТУ"  + chr(44) +
     1483     "СУММА ПО ЧЕКУ" + chr(44) +
     1484     "СУММА С ЦЕНОЙ ПРАЙС-ЛИСТА" + chr(44) +
     1485     "РАЗНИЦА (СУММА ПО ЧЕКУ - СУММА С ЦЕНОЙ ПРАЙС-ЛИСТА))" + chr(44) +
     1486     "КОД КАССИРА"  + chr(44) +
     1487     "НОМЕР ЧЕКА"  + chr(44) +
     1488     "ДАТА ЧЕКА"
     1489     sheetf.sizes =
     1490     "256"  + chr(44) +
     1491     "16"  + chr(44) +
     1492     "15"  + chr(44) +
     1493     "256"  + chr(44) +
     1494     "16"  + chr(44) +
     1495     "12"  + chr(44) +
     1496     "40"  + chr(44) +
     1497     "16"  + chr(44) +
     1498     "16"  + chr(44) +
     1499     "16"  + chr(44) +
     1500     "16"  + chr(44) +
     1501     "16"  + chr(44) +
     1502     "16"  + chr(44) +
     1503     "16"  + chr(44) +
     1504     "25"  + chr(44) +
     1505     "10"
     1506     str1 = string(( if NotInc
     1507                     then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )"
     1508                     else " " ), "X(40)")
     1509     str3 = " "
     1510     .
     1511     run rep/extitle.p (1) .
     1512     FOR EACH obj-list No-LOCK:
     1513       FIND FIRST buf_clients NO-LOCK WHERE
     1514                   buf_clients.obj-type = obj-list.obj-type AND
     1515                   buf_clients.obj-code = obj-list.obj-code No-ERROR.
     1516       if Make-Excel then  put   stream ForExcel unformatted
     1517       (IF AVAIL buf_clients
     1518         then buf_clients.obj-name
     1519         else ("Магазин N " + string(obj-list.obj-code))
     1520       )
     1521       SKIP.
     1522     _chk-gds:
     1523       FOR EACH buf_chk-doc No-LOCK WHERE
     1524                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1525                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1526                 buf_chk-doc.out-code <> ? AND
     1527                 buf_chk-doc.chk-date >= X-date-start AND
     1528                 buf_chk-doc.chk-date <= X-date-end:
     1529         if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1530         if buf_chk-doc.netto >= 0 then NEXT.
     1531         run day-begin-fact-order in this-procedure(
     1532                                                     input  buf_chk-doc.chk-date
     1533                                                     ,output v-start-fact-order
     1534                                                   ) .
     1535         run day-begin-fact-order in this-procedure(
     1536                                                     input  (buf_chk-doc.chk-date + 1)
     1537                                                     ,output v-end-fact-order
     1538                                                   ) .
     1539         FOR EACH buf_chk-gds No-LOCK WHERE
     1540                 buf_chk-gds.doc-code = buf_chk-doc.doc-code,
     1541             FIRST buf_bar-code No-LOCK WHERE
     1542                   buf_bar-code.b-code = buf_chk-gds.b-code:
     1543           ACCUMULATE buf_chk-gds.doc-code (COUNT).
     1544           assign
     1545           v-b-code = ?
     1546           .
     1547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1548     (input  buf_bar-code.gds-code
     1549     ,input  ?
     1550     ,output v-b-code
     1551     ) no-error .
     1552           assign
     1553           v-doc-time = 0
     1554           v-fact-order = v-start-fact-order
     1555           v-add = yes
     1556           v-found = no
     1557           .
     1558           FOR EACH ub.price-list No-LOCK WHERE
     1559                     ub.price-list.obj-type = obj-list.obj-type AND
     1560                     ub.price-list.obj-code = obj-list.obj-code AND
     1561                     ub.price-list.b-code = v-b-code AND
     1562                     ub.price-list.price-type = "":U AND
     1563                     ub.price-list.fact-order >= v-start-fact-order AND
     1564                     ub.price-list.fact-order < v-end-fact-order use-index fact-close,
     1565               first ub.price-doc No-LOCK where
     1566                     ub.price-doc.doc-num = ub.price-list.doc-num :
     1567             if v-doc-time < buf_chk-doc.chk-time and
     1568                ub.price-doc.fact-time > buf_chk-doc.chk-time and
     1569                v-doc-time <> 0 then do:
     1570               assign
     1571               v-fact-order = ub.price-list.fact-order
     1572               v-add = no
     1573               .
     1574               LEAVE.
     1575             end.
     1576             assign
     1577             v-doc-time = ub.price-doc.fact-time
     1578             v-fact-order = ub.price-list.fact-order
     1579             v-found = yes
     1580             .
     1581           END.
     1582           if NOT (FOUND and v-doc-time < buf_chk-doc.chk-time) and
     1583               not available ub.price-list then do:
     1584             FIND LAST ub.price-list No-LOCK WHERE
     1585                       ub.price-list.obj-type = obj-list.obj-type AND
     1586                       ub.price-list.obj-code = obj-list.obj-code AND
     1587                       ub.price-list.b-code = v-b-code AND
     1588                       ub.price-list.fact-order < v-start-fact-order AND
     1589                       ub.price-list.price-type = "":U use-index fact-close no-error .
     1590             if available ub.price-list then do:
     1591               assign
     1592               v-fact-order = ub.price-list.fact-order
     1593               .
     1594             end.
     1595             else do:
     1596               assign
     1597               v-fact-order = v-ini-fact-order
     1598               .
     1599             end.
     1600           end.
     1601           assign
     1602           v-price-sale = ?
     1603           v-fact-order = v-fact-order + (if v-add = no then 0 else 0.0000000001)
     1604           .
     1605   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1607     (input  obj-list.obj-type
     1608     ,input  obj-list.obj-code
     1609     ,input  buf_chk-gds.b-code
     1610     ,input  v-b-code
     1611     ,input  v-fact-order
     1612     ,output v-doc-num
     1613     ,output v-price-sale
     1614     ,output v-road-tax
     1615     ,output v-excise
     1616     ) no-error .
     1617           if v-price-sale = ? or
     1618             v-price-sale <> buf_chk-gds.price-base then do:
     1619             find first ub.gds-prt No-LOCK WHERE
     1620                       ub.gds-prt.node-code = buf_bar-code.node-code no-error .
     1621             if avail ub.gds-prt then do:
     1622               assign
     1623               v-node-name =  ub.gds-prt.f-name
     1624               .
     1625             end.
     1626             else do:
     1627               assign
     1628               v-node-name ="?":U
     1629               .
     1630             end.
     1631             FIND FIRST buf_goods no-lock where
     1632                       buf_goods.gds-code = buf_bar-code.gds-code No-error.
     1633             if avail buf_goods then do:
     1634               assign
     1635               v-grp-name = buf_goods.grp-name
     1636               v-artic = buf_goods.artic
     1637               v-prod-type = buf_goods.prod-type
     1638               v-prod-code = string(buf_goods.prod-code)
     1639               .
     1640               find first root_gds-prt no-lock where
     1641                         root_gds-prt.upper-code = buf_goods.prt-root no-error .
     1642               if available root_gds-prt then do:
     1643                 assign
     1644                 v-root-name = root_gds-prt.node-name
     1645                 .
     1646               end.
     1647               else do:
     1648                 assign
     1649                 v-root-name = "?":U
     1650                 .
     1651               end.
     1652               find first ub.clients no-lock where
     1653                          ub.clients.obj-type = buf_goods.prod-type AND
     1654                          ub.clients.obj-code = buf_goods.prod-code no-error .
     1655               if avail ub.clients then do:
     1656                 assign
     1657                 v-prod-name = string(ub.clients.obj-name, "X(40)")
     1658                 .
     1659               end.
     1660               else do:
     1661                 assign
     1662                 v-prod-name = "?":U
     1663                 .
     1664               end.
     1665             end.
     1666             else do:
     1667               assign
     1668               v-grp-name = "?":U
     1669               v-root-name = "?":U
     1670               .
     1671             end.
     1672             if Make-Excel then  put   stream ForExcel unformatted
     1673             v-grp-name  CHR(9)
     1674             v-b-code CHR(9)
     1675             buf_chk-gds.b-code CHR(9)
     1676             (v-root-name + (if v-node-name = "":U then "":U else chr(47)) + v-node-name) CHR(9)
     1677             v-artic CHR(9)
     1678             v-prod-type + string(v-prod-code) CHR(9)
     1679             v-prod-name CHR(9)
     1680             buf_chk-gds.doc-qnty CHR(9)
     1681             buf_chk-gds.price-base CHR(9)
     1682             v-price-sale CHR(9)
     1683             buf_chk-gds.price-base * ( - buf_chk-gds.doc-qnty ) CHR(9)
     1684             v-price-sale * ( - buf_chk-gds.doc-qnty ) CHR(9)
     1685             (buf_chk-gds.price-base * ( - buf_chk-gds.doc-qnty ) - v-price-sale * ( - buf_chk-gds.doc-qnty )) CHR(9)
     1686             buf_chk-doc.cashier CHR(9)
     1687             buf_chk-doc.doc-code  CHR(9)
     1688             string(buf_chk-doc.chk-date, "99/99/9999")
     1689             SKIP
     1690             .
     1691             assign
     1692             v-chk-sum = v-chk-sum + buf_chk-gds.price-base * ( - buf_chk-gds.doc-qnty )
     1693             v-price-list-sum = v-price-list-sum +
     1694                                (if v-price-sale <> ?
     1695                                 then v-price-sale * ( - buf_chk-gds.doc-qnty )
     1696                                 else 0)
     1697             .
     1698           end.
     1699           IF (ACCUM COUNT buf_chk-gds.doc-code) MODULO 50 = 0 then
     1700           run waitfram-show in this-procedure ("Ждите..." + "Объект " + string(obj-list.obj-code) + " Обработано " +
     1701                         string(ACCUM COUNT buf_chk-gds.doc-code) + " строк чеков").
     1702         END.
     1703       END.
     1704       if Make-Excel then  put   stream ForExcel unformatted
     1705       CHR(9)
     1706       CHR(9)
     1707       CHR(9)
     1708       CHR(9)
     1709       CHR(9)
     1710       CHR(9)
     1711       CHR(9)
     1712       CHR(9)
     1713       CHR(9)
     1714       CHR(9)
     1715       v-chk-sum CHR(9)
     1716       v-price-list-sum CHR(9)
     1717       v-chk-sum - v-price-list-sum CHR(9)
     1718       CHR(9)
     1719       CHR(9)
     1720       SKIP
     1721       .
     1722     END.
     1723     if Make-Excel then output stream ForExcel close.
     1724   end.
     1725   run get-report-num  in parparentproc (output g#report-num).
     1726   run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1727   run waitfram-hide in this-procedure .
