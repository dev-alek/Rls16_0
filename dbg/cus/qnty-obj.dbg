     2851               price-base-with-tax-sale-prl    = 0
     2852               price-rubl-without-tax-sale-prl = 0
     2853               price-base-without-tax-sale-prl = 0
     2854               vat-base-sale-prl               = 0
     2855               vat-rubl-sale-prl               = 0
     2856               vat-base-buyer-prl              = 0
     2857               vat-rubl-buyer-prl              = 0
     2858               slt-base-sale-prl               = 0
     2859               slt-rubl-sale-prl               = 0
     2860               road-tax-base-sale-prl          = 0
     2861               road-tax-rubl-sale-prl          = 0
     2862               excise-base-sale-prl            = 0
     2863               excise-rubl-sale-prl            = 0
     2864               discnt-base-sale-prl            = 0
     2865               discnt-rubl-sale-prl            = 0
