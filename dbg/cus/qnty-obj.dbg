     5174      end.
     5175      else do:
     5176       assign
     5177           export-ras.qnty-kassa  = kassa
     5178           export-ras.qnty-prih   = prih
     5179           export-ras.qnty-rash   = rash
     5180           export-ras.qnty-stk    = ostatok-goods
     5181           export-ras.qnty-sale   = (rash + kassa)
     5182         .
     5183      end.
     5184       IF p-r-algoritm <> 2 Then do :
     5185           if p-mode-calc = ""  then do:
     5186                 assign
     5187                     tmp#zakaz.temp-rash       = (rash + kassa) / ( all-day - l-null-day)
     5188                     tmp#zakaz.all-day       =  ( all-day - l-null-day)
     5189                     tmp#zakaz.zero-day       =   l-null-day
     5190                     .
     5191                     if tmp#zakaz.temp-rash = ? then tmp#zakaz.temp-rash = 0 .
     5192           end.
     5193           else do:
     5194           assign
     5195               export-ras.temp-rash  = (rash + kassa) / ( all-day - l-null-day)
     5196               export-ras.all-day  =  ( all-day - l-null-day)
     5197               export-ras.zero-day  =  l-null-day
     5198               .
     5199               if export-ras.temp-rash = ? then export-ras.temp-rash = 0 .
     5200           end.
     5201       end.
     5202       else do:
     5203               if can-find (first temp-abc-day) then do:
     5204                 if p-mode-calc <> ""  then assign  export-ras.temp-rash = tmp#zakaz.temp-rash.
     5205           end.
     5206           else do:
     5207               find first ub.tmp-sale-gds where
     5208                         ub.tmp-sale-gds.artic     = tmp#zakaz.artic     and
     5209                         ub.tmp-sale-gds.prod-code = tmp#zakaz.prod-code and
     5210                         ub.tmp-sale-gds.prod-type = tmp#zakaz.prod-type and
     5211                         ub.tmp-sale-gds.tmp-code  = p-code no-lock no-error .
     5212               if available ub.tmp-sale-gds then do:
     5213                   if p-mode-calc = ""  then assign  tmp#zakaz.temp-rash  = ub.tmp-sale-gds.tmp-value .
     5214                                        else assign  export-ras.temp-rash = ub.tmp-sale-gds.tmp-value .
     5215               end.
     5216         end.
     5217       end.
     5218       assign v-corr-coeff = tmp#zakaz.season-coef.
     5219       if v-corr-coeff = 0 then v-corr-coeff = 1.
     5220   find first temp-abc-day where
     5221              temp-abc-day.abc-type  = chr(int(tmp#zakaz.add-cli-qnty)) no-error .
     5222   if available  temp-abc-day then do:
     5223      pay-day = temp-abc-day.gar-day .
     5224   end.
     5225   else  pay-day = old-pay-day .
     5226   define variable p-l-max0   as decimal no-undo .
     5227   define variable p-l-max    as decimal no-undo .
     5228   define variable t-cli-qnty as decimal   no-undo .
     5229   define variable t-sum-cli  as decimal   no-undo .
     5230   define variable t-sum-rubl as decimal   no-undo .
     5231   define variable t-sum-base as decimal   no-undo .
     5232             if l-action = true  then do :
     5233                if p-mode-calc = ""  then do:
     5234                   if tmp#zakaz.temp-rash = ? then tmp#zakaz.temp-rash = 0 .
     5235                   end.
     5236                else do:
     5237                   if export-ras.temp-rash = ? then export-ras.temp-rash = 0 .
     5238                   end.
     5239                case  p-r-algoritm :
     5240                  when 1  or when 2 then do :
     5241                      run z-qnty in this-procedure .
     5242                      run z-qnty-e in this-procedure .
     5243                  end.
     5244                  when 3 then do :
     5245                      run v-qnty in this-procedure .
     5246                      run v-qnty-e in this-procedure .
     5247                  end.
     5248                  when 4 then do :
     5249                      run m-qnty   in this-procedure  (output p-l-max0).
     5250                      run m-qnty-e in this-procedure  (output p-l-max).
     5251                  end.
     5252                  when 5 then do :
     5253                      run u-qnty in this-procedure .
     5254                      run u-qnty-e in this-procedure .
     5255                  end.
     5256                end case.
     5257               if p-mode-calc = ""  then do:
     5258                    assign
     5259                       t-cli-qnty  =  l-new-zakaz / tmp#zakaz.cli-base-rate
     5260                       t-sum-cli   =  tmp#zakaz.price-cli  * t-cli-qnty
     5261                       t-sum-rubl  =  tmp#zakaz.price-rubl * l-new-zakaz
     5262                       t-sum-base  =  tmp#zakaz.price-base * l-new-zakaz
     5263                     .
     5264                         run recalc-cli-qnty (
     5265                              input        tmp#zakaz.gds-code
     5266                             ,input        p-round-m
     5267                             ,input        p-round-base
     5268                             ,input        tmp#zakaz.unit-cli
     5269                             ,input        tmp#zakaz.cli-base-rate
     5270                             ,input        tmp#zakaz.price-cli
     5271                             ,input        tmp#zakaz.price-rubl
     5272                             ,input        tmp#zakaz.price-base
     5273                             ,input-output t-cli-qnty
     5274                             ,input-output l-new-zakaz
     5275                             ,input-output t-sum-cli
     5276                             ,input-output t-sum-rubl
     5277                             ,input-output t-sum-base ) .
     5278               assign
     5279                   tmp#zakaz.qnty     = tmp#zakaz.qnty +  l-new-zakaz
     5280                   tmp#zakaz.cli-qnty = tmp#zakaz.qnty / tmp#zakaz.cli-base-rate
     5281                   tmp#zakaz.sum-cli  = tmp#zakaz.price-cli * tmp#zakaz.cli-qnty
     5282                   tmp#zakaz.sum-rubl = tmp#zakaz.price-rubl * tmp#zakaz.qnty
     5283                   tmp#zakaz.sum-base = tmp#zakaz.price-base * tmp#zakaz.qnty
     5284               .
     5285               run create-obj-temp in this-procedure (
     5286                       input p-ord-doc ,
     5287                       input tmp#zakaz.gds-code ,
     5288                       input obj-list.obj-type ,
     5289                       input obj-list.obj-code ,
     5290                       input l-new-zakaz
     5291                       ) .
     5292               end .
     5293               else do:
     5294                    assign
     5295                       t-cli-qnty  =  l-new-zakaz / tmp#zakaz.cli-base-rate
     5296                       t-sum-cli   =  export-ras.price-cli  * t-cli-qnty
     5297                       t-sum-rubl  =  export-ras.price-rubl * l-new-zakaz
     5298                       t-sum-base  =  export-ras.price-base * l-new-zakaz
     5299                     .
     5300                         run recalc-cli-qnty (
     5301                              input        export-ras.gds-code
     5302                             ,input        p-round-m
     5303                             ,input        p-round-base
     5304                             ,input        export-ras.unit-cli
     5305                             ,input        export-ras.cli-base-rate
     5306                             ,input        export-ras.price-cli
     5307                             ,input        export-ras.price-rubl
     5308                             ,input        export-ras.price-base
     5309                             ,input-output t-cli-qnty
     5310                             ,input-output l-new-zakaz
     5311                             ,input-output t-sum-cli
     5312                             ,input-output t-sum-rubl
     5313                             ,input-output t-sum-base
     5314                             ).
     5315               assign
     5316                   export-ras.qnty     = if l-new-zakaz <> ? then l-new-zakaz else 0
     5317                   export-ras.cli-qnty = export-ras.qnty / export-ras.cli-base-rate
     5318                   export-ras.sum-cli  = export-ras.price-cli  * export-ras.cli-qnty
     5319                   export-ras.sum-rubl = export-ras.price-rubl * export-ras.qnty
     5320                   export-ras.sum-base = export-ras.price-base * export-ras.qnty
     5321                   export-ras.ostatok-today = export-ras.qnty-stk
     5322                   export-ras.gds-way-all   = v-gds-way
     5323                   export-ras.Temp-rash = ( if export-ras.Temp-rash <> ?  then export-ras.Temp-rash
     5324                                                                                    else 0 )
     5325               .
     5326               end.
     5327               run create-protocol in this-procedure
     5328               (  input p-ord-doc
     5329                 ,input tmp#zakaz.gds-code
     5330                 ,input v-protocol-date
     5331                 ,input v-protocol-time
     5332                 ,input obj-list.obj-type
     5333                 ,input obj-list.obj-code
     5334                 ,input v-stroka-protocol
     5335                 ).
     5336               if p-mode-calc = ""  then do:
     5337                 tmp#zakaz.order-qnty = tmp#zakaz.qnty.
     5338                 tmp#zakaz.initial-qnty = tmp#zakaz.qnty.
     5339                 end.
     5340                 else do:
     5341                 export-ras.initial-qnty = tmp#zakaz.qnty.
     5342                 export-ras.Temp-rash = ( if export-ras.Temp-rash <> ?  then export-ras.Temp-rash  else 0 )  .
     5343                 if p-r-algoritm = 4 then  export-ras.temp-rash = p-l-max .
     5344                 end.
     5345                 for each temp-rash :  delete temp-rash. end.
     5346             end.
     5347       end.
     5348       if p-tog-det-prizn then do :
     5349         for each export-ras :
     5350           v-sum-qnty-prt = 0.
     5351           for each tmp#zakaz-prn where tmp#zakaz-prn.artic     = export-ras.artic     and
     5352                                        tmp#zakaz-prn.prod-type = export-ras.prod-type and
     5353                                        tmp#zakaz-prn.prod-code = export-ras.prod-code and
     5354                                        tmp#zakaz-prn.obj-type  = export-ras.obj-type  and
     5355                                        tmp#zakaz-prn.obj-code  = export-ras.obj-code  no-lock
     5356           :
     5357             assign
     5358               tmp#zakaz-prn.qnty-ord = round((export-ras.qnty * (tmp#zakaz-prn.qnty-sale / export-ras.qnty-sale)), 0)
     5359               v-sum-qnty-prt = v-sum-qnty-prt + tmp#zakaz-prn.qnty-ord
     5360             .
     5361             if tmp#zakaz-prn.qnty-ord = ? then tmp#zakaz-prn.qnty-ord = 0 .
     5362           end.
     5363           for each tmp#zakaz-prn where tmp#zakaz-prn.artic     = export-ras.artic     and
     5364                                        tmp#zakaz-prn.prod-type = export-ras.prod-type and
     5365                                        tmp#zakaz-prn.prod-code = export-ras.prod-code and
     5366                                        tmp#zakaz-prn.obj-type  = export-ras.obj-type  and
     5367                                        tmp#zakaz-prn.obj-code  = export-ras.obj-code  no-lock break by tmp#zakaz-prn.prt-code descending
     5368           :
     5369               if v-sum-qnty-prt > export-ras.qnty then
     5370                 assign
     5371                   tmp#zakaz-prn.qnty-ord = tmp#zakaz-prn.qnty-ord - 1
     5372                   v-sum-qnty-prt         = v-sum-qnty-prt         - 1
     5373                 .
     5374               if v-sum-qnty-prt < export-ras.qnty then
     5375                 assign
     5376                   tmp#zakaz-prn.qnty-ord = tmp#zakaz-prn.qnty-ord + 1
     5377                   v-sum-qnty-prt         = v-sum-qnty-prt         + 1
     5378                 .
     5379           end.
     5380         end.
     5381       end.
     5382    end.
     5383     if p-mode-calc <> "" and p-mode-calc <> "all-ord":U  and  p-mode-calc <> "rcv-ord":U then do:
     5384         run cus/z-tot5.p ( parParentProc ,  input table export-ras , input p-ord-doc , input p-e-method , input v-show-all-goods) .
     5385     end.
     5386     if  p-mode-calc = "all-ord":U  then do:
     5387        run cus/z-tot6.p ( parParentProc , input table export-ras , input table tmp#zakaz-prn , g#type ) .
     5388     end.
     5389     if  p-mode-calc = "rcv-ord":U  then do:
     5390         run cus/maketrcv.p ( input table export-ras ) .
     5391     end.
     5392   end.
     5393   procedure calcitog :
     5394      assign
     5395        fact-order-1 = integer(xdate-1 - 1 ) + 0.99
     5396        fact-order-2 = integer(xdate-2) + 0.99
     5397        fact-order-today = integer(date-today) + 0.99
     5398      .
     5399   end procedure.
     5400   procedure goods-way :
     5401    define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5402    define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5403    define output parameter p-qnty as decimal no-undo .
     5404    define buffer later_ord-doc for ub.ord-doc.
     5405    define buffer later_ord-line for ub.ord-line.
     5406    do
     5407    on error undo, return error return-value
     5408    :
     5409    p-qnty = 0 .
     5410    if p-t-way = true then do:
     5411      for each later_ord-line no-lock where
     5412               later_ord-line.artic     = tmp#zakaz.artic       and
     5413               later_ord-line.prod-code = tmp#zakaz.prod-code   and
     5414               later_ord-line.prod-type = tmp#zakaz.prod-type  ,
     5415          each later_ord-doc  no-lock where
     5416               later_ord-doc.doc-code  = later_ord-line.doc-code and
     5417               later_ord-doc.ship-date <= loc-date-ship          and
     5418               later_ord-doc.obj-type = p-obj-type    and
     5419               later_ord-doc.obj-code = p-obj-code    and
     5420               later_ord-doc.status_   <>  'новый':U and
     5421               later_ord-doc.status_   <>  'факт':U
     5422               :
     5423                   if ( p-t-rcv  and  later_ord-doc.status_   =  'поставка':U)
     5424                     OR
     5425                     ( p-t-clos  and  later_ord-doc.status_ = 'закрыто':U ) then do:
     5426                         p-qnty = p-qnty +  ( if  later_ord-line.qnty <> ? then later_ord-line.qnty
     5427                                                                               else 0  ) .
     5428                         end.
     5429        end.
     5430    end.
     5431    end.
     5432   end procedure.
     5433   procedure z-qnty :
     5434    do
     5435    on error undo, return error return-value
     5436    :
     5437    if p-mode-calc = ""  then do:
     5438   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5439   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5440   Assign
     5441     l-Ostatok-today =  tmp#zakaz.qnty-stk
     5442     l-negative-rest =  tmp#zakaz.negative-rest
     5443     l-qnty-day      =  l-qnty-qnty
     5444     l-pay-day       =  pay-day
     5445     l-Temp-rash     = if tmp#zakaz.temp-rash < 0  then 0 else tmp#zakaz.temp-rash
     5446     l-min-zap       =  tmp#zakaz.min-stock
     5447     l-negative-sale =  p-neg-sale
     5448     l-goods-way     =  v-gds-way
     5449     l-tog-min-order =  p-t-min-zapas
     5450     l-min-order     =  tmp#zakaz.min-order
     5451     loc-unit-base   =  tmp#zakaz.unit-base
     5452     l-min-ost       =  p-t-min-ost
     5453     l-TOG-deadline  =  p-t-deadline
     5454     l-deadline      =  tmp#zakaz.deadline
     5455     l-type-MR       =  p-e-method
     5456     l-corr-coeff    =  v-corr-coeff
     5457     .
     5458   if l-Temp-rash = ? then l-Temp-rash = 0.
     5459     if par-ord-min-ost = yes then do:
     5460       assign l-min-zap = l-Temp-rash * l-corr-coeff * tmp#zakaz.min-stock .
     5461     end.
     5462     assign L-a = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * l-qnty-day) .
     5463     if L-a  <= 0 then do:
     5464       if l-negative-rest = true then do:
     5465         if l-negative-sale then do:
     5466           Assign
     5467             l-a = 0
     5468             l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     5469           .
     5470         end.
     5471         else do:
     5472           assign l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff).
     5473         end.
     5474       end.
     5475       else do:
     5476         Assign
     5477           l-a = 0
     5478           l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     5479         .
     5480       end.
     5481     end.
     5482     Else do :
     5483       assign l-b = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * (l-qnty-day + l-pay-day ) ) .
     5484             if l-b >= l-min-zap then l-order = 0.
     5485                                 else DO:
     5486                                 If l-b < 0 Then l-order = absolute(l-b) + l-min-zap.
     5487                                            Else l-order = l-min-zap - absolute(l-b).
     5488                                 End.
     5489      End.
     5490    assign
     5491     v-protocol-date = today
     5492     v-protocol-time = time
     5493    .
     5494   if is-log = true then  put stream stream_order unformatted
     5495   ">> Базовый способ расчета заказа "  v-protocol-date " " string(v-protocol-time,"hh:mm:ss") skip
     5496      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5497      "Остаток на сегодня:" l-Ostatok-today skip
     5498      "Отриц.остатки     :" l-negative-rest skip
     5499      "дней до доставки  :" l-qnty-day      skip
     5500      "дней в продаже    :" l-pay-day       skip
     5501      "Темп продаж       :" l-Temp-rash     skip
     5502      "Коррект.коэфф.    :" l-corr-coeff    skip
     5503      "Дней без продажи  :" l-null-day      skip
     5504      "MIN остаток       :" l-min-zap       skip
     5505      "отриц.продажа     :" l-negative-sale skip
     5506      "рассчитано заказа :" l-order         skip
     5507      "_________________  "                 skip
     5508      "min заказ         :" l-min-order     skip
     5509      "товар в пути      :" l-goods-way     skip
     5510      "срок хранения     :" l-deadline      skip
     5511      .
     5512   l-type-MR = entry(2, entry(1,l-type-MR,";"),":") no-error .
     5513   if l-type-MR = ? then l-type-MR = "Базовый способ расчета заказа" .
     5514   v-stroka-protocol = "" .
     5515   v-stroka-protocol =
     5516      "00.Метод расчета заказа:" + l-type-MR  + chr(4) +
     5517      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5518      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5519      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5520      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5521      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     5522      "05.1>>Коррект.коэфф. :" + string(l-corr-coeff   ) + chr(4) +
     5523      "06.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     5524      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5525      "08.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5526      "09.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5527      "10.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5528      "11.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5529      "12.срок хранения     :" + string(l-deadline     ) + chr(4) .
     5530     v-media-qnty = l-order .
     5531     if (l-order - l-goods-way) < 0 then
     5532        l-new-zakaz = 0 .
     5533     else
     5534        l-new-zakaz = l-order - l-goods-way .
     5535    assign v-stroka-protocol = v-stroka-protocol + "13.1>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     5536     if l-min-ost = true then do:
     5537         if l-Ostatok-today > l-min-zap then
     5538             l-new-zakaz = 0 .
     5539         assign v-stroka-protocol = v-stroka-protocol + "13.2>>После проверки на MIN остаток:" + string(l-new-zakaz) + chr(4)  .
     5540     end.
     5541   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     5542       and lookup('шту':U, ub.units.type) > 0)
     5543       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     5544           l-new-zakaz = trunc( l-new-zakaz, 0 ) + 1 .
     5545           assign v-stroka-protocol = v-stroka-protocol + "13.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     5546       end.
     5547     if  l-deadline > 0 and l-tog-deadline = true   then do:
     5548        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     5549        v-stroka-protocol = v-stroka-protocol + "13.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     5550    end .
     5551    if l-tog-min-order then do:
     5552     if ( l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     5553        l-new-zakaz = 0 .
     5554        assign v-stroka-protocol = v-stroka-protocol + "13.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     5555    end .
     5556   if l-new-zakaz = ? then l-new-zakaz = 0 .
     5557   if is-log = true then  put STREAM  stream_order unformatted "Итого (БЕЗ ОКР)"  l-new-zakaz skip
     5558    .
     5559   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     5560    assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     5561   end.
     5562    end.
     5563   end procedure.
     5564   procedure z-qnty-e :
     5565    do
     5566    on error undo, return error return-value
     5567    :
     5568    if p-mode-calc <> ""  then do:
     5569   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5570   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5571   Assign
     5572     l-Ostatok-today =  export-ras.qnty-stk
     5573     l-negative-rest =  export-ras.negative-rest
     5574     l-qnty-day      =  l-qnty-qnty
     5575     l-pay-day       =  pay-day
     5576     l-Temp-rash     = if export-ras.temp-rash < 0  then 0 else export-ras.temp-rash
     5577     l-min-zap       =  export-ras.min-stock
     5578     l-negative-sale =  p-neg-sale
     5579     l-goods-way     =  v-gds-way
     5580     l-tog-min-order =  p-t-min-zapas
     5581     l-min-order     =  export-ras.min-order
     5582     loc-unit-base   =  export-ras.unit-base
     5583     l-min-ost       =  p-t-min-ost
     5584     l-TOG-deadline  =  p-t-deadline
     5585     l-deadline      =  export-ras.deadline
     5586     l-type-MR       =  p-e-method
     5587     l-corr-coeff    =  v-corr-coeff
     5588     .
     5589   if l-Temp-rash = ? then l-Temp-rash = 0.
     5590     if par-ord-min-ost = yes then do:
     5591       assign l-min-zap = l-Temp-rash * l-corr-coeff * export-ras.min-stock .
     5592     end.
     5593     assign L-a = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * l-qnty-day) .
     5594     if L-a  <= 0 then do:
     5595       if l-negative-rest = true then do:
     5596         if l-negative-sale then do:
     5597           Assign
     5598             l-a = 0
     5599             l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     5600           .
     5601         end.
     5602         else do:
     5603           assign l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff).
     5604         end.
     5605       end.
     5606       else do:
     5607         Assign
     5608           l-a = 0
     5609           l-order = ABSOLUTE(l-a) + l-min-zap + (l-pay-day * l-Temp-rash * l-corr-coeff)
     5610         .
     5611       end.
     5612     end.
     5613     Else do :
     5614       assign l-b = l-Ostatok-today - (l-Temp-rash * l-corr-coeff * (l-qnty-day + l-pay-day ) ) .
     5615             if l-b >= l-min-zap then l-order = 0.
     5616                                 else DO:
     5617                                 If l-b < 0 Then l-order = absolute(l-b) + l-min-zap.
     5618                                            Else l-order = l-min-zap - absolute(l-b).
     5619                                 End.
     5620      End.
     5621    assign
     5622     v-protocol-date = today
     5623     v-protocol-time = time
     5624    .
     5625   if is-log = true then  put stream stream_order unformatted
     5626   ">> Базовый способ расчета заказа "  v-protocol-date " " string(v-protocol-time,"hh:mm:ss") skip
     5627      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5628      "Остаток на сегодня:" l-Ostatok-today skip
     5629      "Отриц.остатки     :" l-negative-rest skip
     5630      "дней до доставки  :" l-qnty-day      skip
     5631      "дней в продаже    :" l-pay-day       skip
     5632      "Темп продаж       :" l-Temp-rash     skip
     5633      "Коррект.коэфф.    :" l-corr-coeff    skip
     5634      "Дней без продажи  :" l-null-day      skip
     5635      "MIN остаток       :" l-min-zap       skip
     5636      "отриц.продажа     :" l-negative-sale skip
     5637      "рассчитано заказа :" l-order         skip
     5638      "_________________  "                 skip
     5639      "min заказ         :" l-min-order     skip
     5640      "товар в пути      :" l-goods-way     skip
     5641      "срок хранения     :" l-deadline      skip
     5642      .
     5643   l-type-MR = entry(2, entry(1,l-type-MR,";"),":") no-error .
     5644   if l-type-MR = ? then l-type-MR = "Базовый способ расчета заказа" .
     5645   v-stroka-protocol = "" .
     5646   v-stroka-protocol =
     5647      "00.Метод расчета заказа:" + l-type-MR  + chr(4) +
     5648      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5649      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5650      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5651      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5652      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     5653      "05.1>>Коррект.коэфф. :" + string(l-corr-coeff   ) + chr(4) +
     5654      "06.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     5655      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5656      "08.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5657      "09.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5658      "10.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5659      "11.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5660      "12.срок хранения     :" + string(l-deadline     ) + chr(4) .
     5661     export-ras.order-qnty = l-order .
     5662     if (l-order - l-goods-way) < 0 then
     5663        l-new-zakaz = 0 .
     5664     else
     5665        l-new-zakaz = l-order - l-goods-way .
     5666    assign v-stroka-protocol = v-stroka-protocol + "13.1>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     5667     if l-min-ost = true then do:
     5668         if l-Ostatok-today > l-min-zap then
     5669             l-new-zakaz = 0 .
     5670         assign v-stroka-protocol = v-stroka-protocol + "13.2>>После проверки на MIN остаток:" + string(l-new-zakaz) + chr(4)  .
     5671     end.
     5672   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     5673       and lookup('шту':U, ub.units.type) > 0)
     5674       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     5675           l-new-zakaz = trunc( l-new-zakaz, 0 ) + 1 .
     5676           assign v-stroka-protocol = v-stroka-protocol + "13.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     5677       end.
     5678     if  l-deadline > 0 and l-tog-deadline = true   then do:
     5679        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     5680        v-stroka-protocol = v-stroka-protocol + "13.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     5681    end .
     5682    if l-tog-min-order then do:
     5683     if ( l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     5684        l-new-zakaz = 0 .
     5685        assign v-stroka-protocol = v-stroka-protocol + "13.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     5686    end .
     5687   if l-new-zakaz = ? then l-new-zakaz = 0 .
     5688   if is-log = true then  put STREAM  stream_order unformatted "Итого (БЕЗ ОКР)"  l-new-zakaz skip
     5689    .
     5690   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     5691    assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     5692   end.
     5693    end.
     5694   end procedure.
     5695   procedure v-qnty :
     5696    do
     5697    on error undo, return error return-value
     5698    :
     5699    if p-mode-calc = ""  then do:
     5700   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5701   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5702   define variable loc-unit-base    as character no-undo .
     5703   define variable l-gar-zapas      as logical no-undo .
     5704   define variable l-tog-min-order  as logical no-undo .
     5705   define variable l-min-order      as decimal no-undo .
     5706   define variable l-min-ost         as logical   no-undo .
     5707   define variable  v-sigma          as decimal no-undo .
     5708   define variable  loc-rkv as decimal no-undo .
     5709   define variable  loc-q as integer no-undo .
     5710   define variable  p-serv     as decimal   no-undo .
     5711   define variable  p-x     as decimal   no-undo .
     5712   define variable v-norm-obr as decimal   no-undo .
     5713   Assign
     5714     l-Ostatok-today =  tmp#zakaz.qnty-stk
     5715     l-negative-rest =  tmp#zakaz.negative-rest
     5716     l-qnty-day      =  l-qnty-qnty
     5717     l-pay-day       =  pay-day
     5718     l-Temp-rash     = if tmp#zakaz.temp-rash < 0  then 0 else tmp#zakaz.temp-rash
     5719     l-min-zap       =  tmp#zakaz.min-stock
     5720     l-negative-sale =  p-neg-sale
     5721     l-goods-way     =  v-gds-way
     5722     p-serv          =  tmp#zakaz.service-order
     5723     l-gar-zapas     =  p-t-gar
     5724     l-tog-min-order =  p-t-min-zapas
     5725     l-min-order     =  tmp#zakaz.min-order
     5726     loc-unit-base   =  tmp#zakaz.unit-base
     5727     l-min-ost       =  p-t-min-ost
     5728     l-TOG-deadline  =  p-t-deadline
     5729     l-deadline      =  tmp#zakaz.deadline
     5730     l-corr-coeff    =  v-corr-coeff
     5731     .
     5732   if l-Temp-rash = ? then l-Temp-rash = 0.
     5733    if par-ord-min-ost = yes then do:
     5734       assign l-min-zap =  l-Temp-rash * l-corr-coeff * tmp#zakaz.min-stock .
     5735    end.
     5736      loc-rkv  = 0 .
     5737      loc-q  = 0 .
     5738      for each temp-gds-qnty :
     5739          loc-rkv = loc-rkv + exp((temp-gds-qnty.rash  - l-Temp-rash * l-corr-coeff) , 2 ) .
     5740          loc-q = loc-q  + temp-gds-qnty.qnty-day.
     5741      end.
     5742      define variable ll-i as integer no-undo .
     5743      if  all-day - loc-q > 0 then do:
     5744         do ll-i = 1 to  (all-day - loc-q) :
     5745            loc-rkv = loc-rkv + exp(( 0  - l-Temp-rash * l-corr-coeff) , 2 ) .
     5746         end.
     5747      end.
     5748      assign v-sigma =   sqrt( loc-rkv / ( all-day  - 1)) .
     5749      if v-sigma = ? then v-sigma = 0 .
     5750      if p-serv = ? or p-serv = 0 or p-serv = 1
     5751      then p-serv = .5 .
     5752      if l-Temp-rash = ? then l-Temp-rash = 0.
     5753      run normobr in this-procedure
     5754      ( input   p-serv    ,
     5755        input   l-Temp-rash * l-corr-coeff  ,
     5756        input   v-sigma ,
     5757        output  p-x     )
     5758        .
     5759        assign v-norm-obr = p-x .
     5760     if  p-x  - l-Temp-rash * l-corr-coeff < 0
     5761         then p-x =  0 .
     5762         else p-x = (p-x  - l-Temp-rash * l-corr-coeff ) * ( l-pay-day + l-qnty-day ) .
     5763     assign L-a = l-Ostatok-today - ( l-Temp-rash * l-corr-coeff * l-qnty-day ) .
     5764     if L-a  <= 0 then do:
     5765             if l-negative-sale = true or l-negative-rest = false  then do:
     5766                 assign
     5767                l-order = p-x + ( l-temp-rash * l-corr-coeff * l-pay-day )  +  l-min-zap .
     5768                end.
     5769                else do:
     5770                  assign
     5771               l-order = p-x + ( l-temp-rash * l-corr-coeff  * l-pay-day )  + absolute(l-a)  +  l-min-zap .
     5772                 end.
     5773               end.
     5774      Else do :
     5775         assign l-order = p-x + ( l-Temp-rash * l-corr-coeff * l-pay-day )  - l-a   +  l-min-zap .
     5776      End.
     5777      if  l-order < 0 then l-order = 0 .
     5778    assign
     5779     v-protocol-date = today
     5780     v-protocol-time = time
     5781    .
     5782   if is-log = true then  put stream stream_order unformatted
     5783   ">> Вероятностный способ расчета заказа "  today " " string(time,"hh:mm:ss") skip
     5784      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5785      "Остаток на сегодня:" l-Ostatok-today skip
     5786      "Отриц.остатки     :" l-negative-rest skip
     5787      "дней до доставки  :" l-qnty-day      skip
     5788      "дней в продаже    :" l-pay-day       skip
     5789      "Темп продаж       :" l-Temp-rash     skip
     5790      "Корр.коеффициент  :" l-corr-coeff    skip
     5791      "Уровень пост прис :" p-serv          skip
     5792      "Среднеквадр откл  :" v-sigma         skip
     5793      "F_нормобр         :" v-norm-obr      skip
     5794      "гар.запас         :" p-x             skip
     5795      "Дней без продажи  :" l-null-day      skip
     5796      "MIN остаток       :" l-min-zap       skip
     5797      "отриц.продажа     :" l-negative-sale skip
     5798      "рассчитано заказа :" l-order         skip
     5799      "_________________ "                  skip
     5800      "min заказ         :" l-min-order     skip
     5801      "товар в пути      :" l-goods-way     skip
     5802      "срок хранения     :" l-deadline      skip
     5803      .
     5804   v-stroka-protocol = "" .
     5805   v-stroka-protocol =
     5806      "00.Метод расчета заказа:" + "Вероятностный способ расчета заказа" + chr(4) +
     5807      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5808      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5809      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5810      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5811      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     5812      "05.1>>Корр.коэфф.    :" + string(l-corr-coeff   ) + chr(4) +
     5813      "06.Уровень постоянного присутствия :" + string(p-serv) + chr(4) +
     5814      "07.Среднеквадр откл  :" + string(v-sigma        ) + chr(4) +
     5815      "08.F_нормобр         :" + string(v-norm-obr     ) + chr(4) +
     5816      "09.Гарантийный запас :" + string(p-x            ) + chr(4) +
     5817      "10.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     5818      "11.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5819      "12.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5820      "13.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5821      "14.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5822      "15.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5823      "16. срок хранения    :" + string(l-deadline     ) + chr(4) .
     5824      v-media-qnty = l-order .
     5825      if l-gar-zapas = true then do:
     5826          if l-Ostatok-today >  p-x then
     5827              assign
     5828              l-order = 0
     5829              l-new-zakaz = 0
     5830              .
     5831         assign v-stroka-protocol = v-stroka-protocol + "16.1>>После проверки на гарантийный запас:" + string(l-order) + chr(4)  .
     5832      end.
     5833      if l-min-ost = true then do:
     5834          if l-Ostatok-today > l-min-zap then
     5835              assign
     5836              l-order = 0
     5837              l-new-zakaz = 0
     5838              .
     5839         assign v-stroka-protocol = v-stroka-protocol + "16.2>>После проверки на MIN остаток:" + string(l-order) + chr(4)  .
     5840      end.
     5841     if (l-order - l-goods-way) < 0 then
     5842        l-new-zakaz = 0 .
     5843     else
     5844        l-new-zakaz = l-order - l-goods-way .
     5845   assign v-stroka-protocol = v-stroka-protocol + "16.3>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     5846   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     5847       and lookup('шту':U, ub.units.type) > 0)
     5848       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     5849           l-new-zakaz = trunc( l-new-zakaz, 0 )  + 1 .
     5850           assign v-stroka-protocol = v-stroka-protocol + "16.4>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     5851    end.
     5852    if  l-deadline > 0 and l-tog-deadline = true  then do:
     5853        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     5854        v-stroka-protocol = v-stroka-protocol + "16.5>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     5855    end .
     5856    if l-tog-min-order then do:
     5857     if ( l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     5858        l-new-zakaz = 0 .
     5859        assign v-stroka-protocol = v-stroka-protocol + "16.6>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     5860    end .
     5861    if l-new-zakaz = ? then l-new-zakaz = 0 .
     5862   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     5863    "__________________________________________________"     skip
     5864    .
     5865   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     5866   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     5867   end.
     5868    end.
     5869   end procedure.
     5870   procedure v-qnty-e :
     5871    do
     5872    on error undo, return error return-value
     5873    :
     5874    if p-mode-calc <> ""  then do:
     5875   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5876   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     5877   define variable loc-unit-base    as character no-undo .
     5878   define variable l-gar-zapas      as logical no-undo .
     5879   define variable l-tog-min-order  as logical no-undo .
     5880   define variable l-min-order      as decimal no-undo .
     5881   define variable l-min-ost         as logical   no-undo .
     5882   define variable  v-sigma          as decimal no-undo .
     5883   define variable  loc-rkv as decimal no-undo .
     5884   define variable  loc-q as integer no-undo .
     5885   define variable  p-serv     as decimal   no-undo .
     5886   define variable  p-x     as decimal   no-undo .
     5887   define variable v-norm-obr as decimal   no-undo .
     5888   Assign
     5889     l-Ostatok-today =  export-ras.qnty-stk
     5890     l-negative-rest =  export-ras.negative-rest
     5891     l-qnty-day      =  l-qnty-qnty
     5892     l-pay-day       =  pay-day
     5893     l-Temp-rash     = if export-ras.temp-rash < 0  then 0 else export-ras.temp-rash
     5894     l-min-zap       =  export-ras.min-stock
     5895     l-negative-sale =  p-neg-sale
     5896     l-goods-way     =  v-gds-way
     5897     p-serv          =  export-ras.service-order
     5898     l-gar-zapas     =  p-t-gar
     5899     l-tog-min-order =  p-t-min-zapas
     5900     l-min-order     =  export-ras.min-order
     5901     loc-unit-base   =  export-ras.unit-base
     5902     l-min-ost       =  p-t-min-ost
     5903     l-TOG-deadline  =  p-t-deadline
     5904     l-deadline      =  export-ras.deadline
     5905     l-corr-coeff    =  v-corr-coeff
     5906     .
     5907   if l-Temp-rash = ? then l-Temp-rash = 0.
     5908    if par-ord-min-ost = yes then do:
     5909       assign l-min-zap =  l-Temp-rash * l-corr-coeff * export-ras.min-stock .
     5910    end.
     5911      loc-rkv  = 0 .
     5912      loc-q  = 0 .
     5913      for each temp-gds-qnty :
     5914          loc-rkv = loc-rkv + exp((temp-gds-qnty.rash  - l-Temp-rash * l-corr-coeff) , 2 ) .
     5915          loc-q = loc-q  + temp-gds-qnty.qnty-day.
     5916      end.
     5917      define variable ll-i as integer no-undo .
     5918      if  all-day - loc-q > 0 then do:
     5919         do ll-i = 1 to  (all-day - loc-q) :
     5920            loc-rkv = loc-rkv + exp(( 0  - l-Temp-rash * l-corr-coeff) , 2 ) .
     5921         end.
     5922      end.
     5923      assign v-sigma =   sqrt( loc-rkv / ( all-day  - 1)) .
     5924      if v-sigma = ? then v-sigma = 0 .
     5925      if p-serv = ? or p-serv = 0 or p-serv = 1
     5926      then p-serv = .5 .
     5927      if l-Temp-rash = ? then l-Temp-rash = 0.
     5928      run normobr in this-procedure
     5929      ( input   p-serv    ,
     5930        input   l-Temp-rash * l-corr-coeff  ,
     5931        input   v-sigma ,
     5932        output  p-x     )
     5933        .
     5934        assign v-norm-obr = p-x .
     5935     if  p-x  - l-Temp-rash * l-corr-coeff < 0
     5936         then p-x =  0 .
     5937         else p-x = (p-x  - l-Temp-rash * l-corr-coeff ) * ( l-pay-day + l-qnty-day ) .
     5938     assign L-a = l-Ostatok-today - ( l-Temp-rash * l-corr-coeff * l-qnty-day ) .
     5939     if L-a  <= 0 then do:
     5940             if l-negative-sale = true or l-negative-rest = false  then do:
     5941                 assign
     5942                l-order = p-x + ( l-temp-rash * l-corr-coeff * l-pay-day )  +  l-min-zap .
     5943                end.
     5944                else do:
     5945                  assign
     5946               l-order = p-x + ( l-temp-rash * l-corr-coeff  * l-pay-day )  + absolute(l-a)  +  l-min-zap .
     5947                 end.
     5948               end.
     5949      Else do :
     5950         assign l-order = p-x + ( l-Temp-rash * l-corr-coeff * l-pay-day )  - l-a   +  l-min-zap .
     5951      End.
     5952      if  l-order < 0 then l-order = 0 .
     5953    assign
     5954     v-protocol-date = today
     5955     v-protocol-time = time
     5956    .
     5957   if is-log = true then  put stream stream_order unformatted
     5958   ">> Вероятностный способ расчета заказа "  today " " string(time,"hh:mm:ss") skip
     5959      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     5960      "Остаток на сегодня:" l-Ostatok-today skip
     5961      "Отриц.остатки     :" l-negative-rest skip
     5962      "дней до доставки  :" l-qnty-day      skip
     5963      "дней в продаже    :" l-pay-day       skip
     5964      "Темп продаж       :" l-Temp-rash     skip
     5965      "Корр.коеффициент  :" l-corr-coeff    skip
     5966      "Уровень пост прис :" p-serv          skip
     5967      "Среднеквадр откл  :" v-sigma         skip
     5968      "F_нормобр         :" v-norm-obr      skip
     5969      "гар.запас         :" p-x             skip
     5970      "Дней без продажи  :" l-null-day      skip
     5971      "MIN остаток       :" l-min-zap       skip
     5972      "отриц.продажа     :" l-negative-sale skip
     5973      "рассчитано заказа :" l-order         skip
     5974      "_________________ "                  skip
     5975      "min заказ         :" l-min-order     skip
     5976      "товар в пути      :" l-goods-way     skip
     5977      "срок хранения     :" l-deadline      skip
     5978      .
     5979   v-stroka-protocol = "" .
     5980   v-stroka-protocol =
     5981      "00.Метод расчета заказа:" + "Вероятностный способ расчета заказа" + chr(4) +
     5982      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     5983      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     5984      "03.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     5985      "04.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     5986      "05.Темп продаж       :" + string(l-Temp-rash    ) + chr(4) +
     5987      "05.1>>Корр.коэфф.    :" + string(l-corr-coeff   ) + chr(4) +
     5988      "06.Уровень постоянного присутствия :" + string(p-serv) + chr(4) +
     5989      "07.Среднеквадр откл  :" + string(v-sigma        ) + chr(4) +
     5990      "08.F_нормобр         :" + string(v-norm-obr     ) + chr(4) +
     5991      "09.Гарантийный запас :" + string(p-x            ) + chr(4) +
     5992      "10.Дней без продажи  :" + string(l-null-day     ) + chr(4) +
     5993      "11.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     5994      "12.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     5995      "13.рассчитано заказа :" + string(l-order        ) + chr(4) +
     5996      "14.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     5997      "15.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     5998      "16. срок хранения    :" + string(l-deadline     ) + chr(4) .
     5999      export-ras.order-qnty = l-order .
     6000      if l-gar-zapas = true then do:
     6001          if l-Ostatok-today >  p-x then
     6002              assign
     6003              l-order = 0
     6004              l-new-zakaz = 0
     6005              .
     6006         assign v-stroka-protocol = v-stroka-protocol + "16.1>>После проверки на гарантийный запас:" + string(l-order) + chr(4)  .
     6007      end.
     6008      if l-min-ost = true then do:
     6009          if l-Ostatok-today > l-min-zap then
     6010              assign
     6011              l-order = 0
     6012              l-new-zakaz = 0
     6013              .
     6014         assign v-stroka-protocol = v-stroka-protocol + "16.2>>После проверки на MIN остаток:" + string(l-order) + chr(4)  .
     6015      end.
     6016     if (l-order - l-goods-way) < 0 then
     6017        l-new-zakaz = 0 .
     6018     else
     6019        l-new-zakaz = l-order - l-goods-way .
     6020   assign v-stroka-protocol = v-stroka-protocol + "16.3>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     6021   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     6022       and lookup('шту':U, ub.units.type) > 0)
     6023       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     6024           l-new-zakaz = trunc( l-new-zakaz, 0 )  + 1 .
     6025           assign v-stroka-protocol = v-stroka-protocol + "16.4>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     6026    end.
     6027    if  l-deadline > 0 and l-tog-deadline = true  then do:
     6028        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     6029        v-stroka-protocol = v-stroka-protocol + "16.5>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     6030    end .
     6031    if l-tog-min-order then do:
     6032     if ( l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     6033        l-new-zakaz = 0 .
     6034        assign v-stroka-protocol = v-stroka-protocol + "16.6>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     6035    end .
     6036    if l-new-zakaz = ? then l-new-zakaz = 0 .
     6037   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     6038    "__________________________________________________"     skip
     6039    .
     6040   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     6041   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     6042   end.
     6043    end.
     6044   end procedure.
     6045   procedure m-qnty :
     6046    do
     6047    on error undo, return error return-value
     6048    :
     6049    if p-mode-calc = ""  then do:
     6050   define variable  vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6051   define variable l-gar-zapas      as logical no-undo .
     6052   define variable l-tog-min-order  as logical no-undo .
     6053   define variable l-min-order      as decimal no-undo .
     6054   define variable loc-unit-base  as character no-undo .
     6055   define variable v-sigma    as decimal no-undo .
     6056   define variable loc-max    as decimal no-undo .
     6057   define variable loc-max-old as decimal no-undo .
     6058   define variable loc-q      as integer no-undo .
     6059   define variable p-serv     as decimal   no-undo .
     6060   define variable p-x        as decimal   no-undo .
     6061   define variable l-min-ost         as logical   no-undo .
     6062   define output parameter par-loc-max as decimal no-undo .
     6063   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     6064   Assign
     6065     l-Ostatok-today =  tmp#zakaz.qnty-stk
     6066     l-negative-rest =  tmp#zakaz.negative-rest
     6067     l-qnty-day      =  l-qnty-qnty
     6068     l-pay-day       =  pay-day
     6069     l-Temp-rash     =  if tmp#zakaz.temp-rash < 0  then 0 else tmp#zakaz.temp-rash
     6070     l-min-zap       =  tmp#zakaz.min-stock
     6071     l-negative-sale =  p-neg-sale
     6072     l-goods-way     =  v-gds-way
     6073     p-serv          =  tmp#zakaz.service-order
     6074     l-gar-zapas     =  p-t-gar
     6075     l-tog-min-order =  p-t-min-zapas
     6076     l-min-order     =  tmp#zakaz.min-order
     6077     loc-unit-base   =  tmp#zakaz.unit-base
     6078     l-min-ost = p-t-min-ost
     6079     l-TOG-deadline  =  p-t-deadline
     6080     l-deadline      =  tmp#zakaz.deadline
     6081     .
     6082   if l-Temp-rash = ? then l-Temp-rash = 0.
     6083      assign
     6084       loc-q  = 0
     6085       loc-max-old = 0
     6086       loc-max = 0
     6087      .
     6088     for each temp-gds-qnty where temp-gds-qnty.rash >= 0 :
     6089         if temp-gds-qnty.rash > loc-max   then   loc-max = temp-gds-qnty.rash  .
     6090         assign loc-max-old = temp-gds-qnty.rash  .
     6091      end.
     6092     for each temp-gds-qnty where temp-gds-qnty.rash >= 0 :
     6093         delete temp-gds-qnty.
     6094      end.
     6095      if loc-max < 0     then loc-max = 0 .
     6096      if loc-max-old < 0 then loc-max-old = 0 .
     6097    if par-ord-min-ost = yes then do:
     6098       assign l-min-zap =  loc-max * tmp#zakaz.min-stock .
     6099    end.
     6100     par-loc-max = loc-max .
     6101     L-a = l-Ostatok-today - ( loc-max  * l-qnty-day ) .
     6102     if L-a  <= 0 then do:
     6103             if l-negative-sale = true or l-negative-rest = false   then do:
     6104                 assign
     6105                     l-order = ( loc-max  * l-pay-day )  +  l-min-zap .
     6106                end.
     6107                else do:
     6108                  assign
     6109                     l-order =  ( loc-max  * l-pay-day )  + absolute(l-a)  +  l-min-zap .
     6110                 end.
     6111               end.
     6112      Else do :
     6113           assign l-order = ( loc-max  * l-pay-day )  - l-a   +  l-min-zap .
     6114      End.
     6115      if  l-order < 0 then l-order = 0 .
     6116    assign
     6117     v-protocol-date = today
     6118     v-protocol-time = time
     6119    .
     6120    if is-log = true then  put stream stream_order unformatted
     6121   ">> Расчет заказа по максимальной продаже "  today " " string(time,"hh:mm:ss") skip
     6122      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     6123      "Остаток на сегодня:" l-Ostatok-today skip
     6124      "Отриц.остатки     :" l-negative-rest skip
     6125      "отриц.продажа     :" l-negative-sale skip
     6126      "дней до доставки  :" l-qnty-day      skip
     6127      "дней в продаже    :" l-pay-day       skip
     6128      "MAX продажа       :" loc-max         skip
     6129      "MIN остаток       :" l-min-zap       skip
     6130      "рассчитано заказа :" l-order         skip
     6131      "_________________ "                  skip
     6132      "min заказ         :" l-min-order     skip
     6133      "товар в пути      :" l-goods-way     skip
     6134      "срок хранения     :" l-deadline skip
     6135      .
     6136   v-stroka-protocol = "" .
     6137   v-stroka-protocol =
     6138      "00.Метод расчета заказа:" + "Расчет до максимальной продажи" + chr(4) +
     6139      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     6140      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     6141      "03.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     6142      "04.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     6143      "05.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     6144      "06.MAX продажа       :" + string(loc-max        ) + chr(4) +
     6145      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     6146      "08.рассчитано заказа :" + string(l-order        ) + chr(4) +
     6147      "09.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     6148      "10.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     6149      "11.срок хранения     :" + string(l-deadline     ) + chr(4) .
     6150   v-media-qnty = l-order .
     6151     if l-min-ost = true then do:
     6152        if l-Ostatok-today > l-min-zap then
     6153          assign
     6154           l-order = 0
     6155           l-new-zakaz = 0
     6156           .
     6157        assign v-stroka-protocol = v-stroka-protocol + "12.1>>После проверки на MIN остаток:" + string(l-order) + chr(4).
     6158     end.
     6159     if (l-order - l-goods-way) < 0 then
     6160        l-new-zakaz = 0 .
     6161     else
     6162        l-new-zakaz = l-order - l-goods-way .
     6163     assign v-stroka-protocol = v-stroka-protocol + "12.2>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     6164   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     6165     and lookup('шту':U, ub.units.type) > 0)
     6166     and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     6167         l-new-zakaz = trunc( l-new-zakaz, 0 )  + 1 .
     6168         v-stroka-protocol = v-stroka-protocol + "12.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     6169     end.
     6170    if  l-deadline > 0 and l-tog-deadline = true  then do:
     6171        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     6172        assign v-stroka-protocol = v-stroka-protocol + "12.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     6173    end .
     6174    if l-tog-min-order then do:
     6175       if (l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     6176           l-new-zakaz = 0 .
     6177       assign v-stroka-protocol = v-stroka-protocol + "12.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     6178    end .
     6179   if l-new-zakaz = ? then l-new-zakaz = 0 .
     6180   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     6181    "__________________________________________________"     skip
     6182    .
     6183   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     6184   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     6185   end.
     6186    end.
     6187   end procedure.
     6188   procedure m-qnty-e :
     6189    do
     6190    on error undo, return error return-value
     6191    :
     6192    if p-mode-calc <> ""  then do:
     6193   define variable  vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6194   define variable l-gar-zapas      as logical no-undo .
     6195   define variable l-tog-min-order  as logical no-undo .
     6196   define variable l-min-order      as decimal no-undo .
     6197   define variable loc-unit-base  as character no-undo .
     6198   define variable v-sigma    as decimal no-undo .
     6199   define variable loc-max    as decimal no-undo .
     6200   define variable loc-max-old as decimal no-undo .
     6201   define variable loc-q      as integer no-undo .
     6202   define variable p-serv     as decimal   no-undo .
     6203   define variable p-x        as decimal   no-undo .
     6204   define variable l-min-ost         as logical   no-undo .
     6205   define output parameter par-loc-max as decimal no-undo .
     6206   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     6207   Assign
     6208     l-Ostatok-today =  export-ras.qnty-stk
     6209     l-negative-rest =  export-ras.negative-rest
     6210     l-qnty-day      =  l-qnty-qnty
     6211     l-pay-day       =  pay-day
     6212     l-Temp-rash     =  if export-ras.temp-rash < 0  then 0 else export-ras.temp-rash
     6213     l-min-zap       =  export-ras.min-stock
     6214     l-negative-sale =  p-neg-sale
     6215     l-goods-way     =  v-gds-way
     6216     p-serv          =  export-ras.service-order
     6217     l-gar-zapas     =  p-t-gar
     6218     l-tog-min-order =  p-t-min-zapas
     6219     l-min-order     =  export-ras.min-order
     6220     loc-unit-base   =  export-ras.unit-base
     6221     l-min-ost = p-t-min-ost
     6222     l-TOG-deadline  =  p-t-deadline
     6223     l-deadline      =  export-ras.deadline
     6224     .
     6225   if l-Temp-rash = ? then l-Temp-rash = 0.
     6226      assign
     6227       loc-q  = 0
     6228       loc-max-old = 0
     6229       loc-max = 0
     6230      .
     6231     for each temp-gds-qnty where temp-gds-qnty.rash >= 0 :
     6232         if temp-gds-qnty.rash > loc-max   then   loc-max = temp-gds-qnty.rash  .
     6233         assign loc-max-old = temp-gds-qnty.rash  .
     6234      end.
     6235     for each temp-gds-qnty where temp-gds-qnty.rash >= 0 :
     6236         delete temp-gds-qnty.
     6237      end.
     6238      if loc-max < 0     then loc-max = 0 .
     6239      if loc-max-old < 0 then loc-max-old = 0 .
     6240    if par-ord-min-ost = yes then do:
     6241       assign l-min-zap =  loc-max * export-ras.min-stock .
     6242    end.
     6243     par-loc-max = loc-max .
     6244     L-a = l-Ostatok-today - ( loc-max  * l-qnty-day ) .
     6245     if L-a  <= 0 then do:
     6246             if l-negative-sale = true or l-negative-rest = false   then do:
     6247                 assign
     6248                     l-order = ( loc-max  * l-pay-day )  +  l-min-zap .
     6249                end.
     6250                else do:
     6251                  assign
     6252                     l-order =  ( loc-max  * l-pay-day )  + absolute(l-a)  +  l-min-zap .
     6253                 end.
     6254               end.
     6255      Else do :
     6256           assign l-order = ( loc-max  * l-pay-day )  - l-a   +  l-min-zap .
     6257      End.
     6258      if  l-order < 0 then l-order = 0 .
     6259    assign
     6260     v-protocol-date = today
     6261     v-protocol-time = time
     6262    .
     6263    if is-log = true then  put stream stream_order unformatted
     6264   ">> Расчет заказа по максимальной продаже "  today " " string(time,"hh:mm:ss") skip
     6265      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     6266      "Остаток на сегодня:" l-Ostatok-today skip
     6267      "Отриц.остатки     :" l-negative-rest skip
     6268      "отриц.продажа     :" l-negative-sale skip
     6269      "дней до доставки  :" l-qnty-day      skip
     6270      "дней в продаже    :" l-pay-day       skip
     6271      "MAX продажа       :" loc-max         skip
     6272      "MIN остаток       :" l-min-zap       skip
     6273      "рассчитано заказа :" l-order         skip
     6274      "_________________ "                  skip
     6275      "min заказ         :" l-min-order     skip
     6276      "товар в пути      :" l-goods-way     skip
     6277      "срок хранения     :" l-deadline skip
     6278      .
     6279   v-stroka-protocol = "" .
     6280   v-stroka-protocol =
     6281      "00.Метод расчета заказа:" + "Расчет до максимальной продажи" + chr(4) +
     6282      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     6283      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     6284      "03.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     6285      "04.дней до доставки  :" + string(l-qnty-day     ) + chr(4) +
     6286      "05.дней в продаже    :" + string(l-pay-day      ) + chr(4) +
     6287      "06.MAX продажа       :" + string(loc-max        ) + chr(4) +
     6288      "07.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     6289      "08.рассчитано заказа :" + string(l-order        ) + chr(4) +
     6290      "09.MIN заказ         :" + string(l-min-order    ) + chr(4) +
     6291      "10.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     6292      "11.срок хранения     :" + string(l-deadline     ) + chr(4) .
     6293   export-ras.order-qnty = l-order .
     6294     if l-min-ost = true then do:
     6295        if l-Ostatok-today > l-min-zap then
     6296          assign
     6297           l-order = 0
     6298           l-new-zakaz = 0
     6299           .
     6300        assign v-stroka-protocol = v-stroka-protocol + "12.1>>После проверки на MIN остаток:" + string(l-order) + chr(4).
     6301     end.
     6302     if (l-order - l-goods-way) < 0 then
     6303        l-new-zakaz = 0 .
     6304     else
     6305        l-new-zakaz = l-order - l-goods-way .
     6306     assign v-stroka-protocol = v-stroka-protocol + "12.2>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     6307   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     6308     and lookup('шту':U, ub.units.type) > 0)
     6309     and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     6310         l-new-zakaz = trunc( l-new-zakaz, 0 )  + 1 .
     6311         v-stroka-protocol = v-stroka-protocol + "12.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     6312     end.
     6313    if  l-deadline > 0 and l-tog-deadline = true  then do:
     6314        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     6315        assign v-stroka-protocol = v-stroka-protocol + "12.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     6316    end .
     6317    if l-tog-min-order then do:
     6318       if (l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     6319           l-new-zakaz = 0 .
     6320       assign v-stroka-protocol = v-stroka-protocol + "12.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     6321    end .
     6322   if l-new-zakaz = ? then l-new-zakaz = 0 .
     6323   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     6324    "__________________________________________________"     skip
     6325    .
     6326   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     6327   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     6328   end.
     6329    end.
     6330   end procedure.
     6331   procedure calc-null-day :
     6332    do
     6333    on error undo, return error return-value
     6334    :
     6335    l-null-day = 0 .
     6336    IF p-type-qnty-day = 2   then do :
     6337       for each temp-gds-qnty  :
     6338          if  temp-gds-qnty.rash = 0  and  temp-gds-qnty.ost = 0 then do:
     6339             l-null-day = l-null-day + temp-gds-qnty.qnty-day  .
     6340             end.
     6341        end.
     6342     end.
     6343     end.
     6344   end procedure.
     6345   procedure calc-sale :
     6346    do
     6347    on error undo, return error return-value
     6348    :
     6349             run ob-line in this-procedure  (
     6350                 input   obj-list.obj-code   ,
     6351                 input   obj-list.obj-type   ,
     6352                 input   tmp#zakaz.artic       ,
     6353                 input   tmp#zakaz.prod-code   ,
     6354                 input   tmp#zakaz.prod-type   ,
     6355                 input   fact-order-1   ,
     6356                 input   fact-order-2   ,
     6357                 input   'cost':U    ,
     6358                 input   '##,##':U ,
     6359                 input   ""    ,
     6360                 input   false ,
     6361                 input   false ,
     6362                 output v-prih ,
     6363                 output v-rash ,
     6364                 output v-kassa
     6365                 )  no-error .
     6366               assign
     6367                 rash  = rash  + v-rash
     6368                 kassa = kassa + v-kassa
     6369                 prih = prih + v-prih
     6370               .
     6371    end.
     6372   end procedure.
     6373   procedure create-temp-rash :
     6374    do
     6375    on error undo, return error return-value
     6376    :
     6377     define input parameter p-date as date   no-undo .
     6378     define input parameter p-val as decimal no-undo .
     6379     find first temp-gds-qnty where
     6380           temp-gds-qnty.day = p-date no-error
     6381           .
     6382     if not available temp-gds-qnty then do:
     6383        create temp-gds-qnty.
     6384        assign
     6385           temp-gds-qnty.day = p-date
     6386           temp-gds-qnty.rash = p-val
     6387           temp-gds-qnty.qnty-day = 1
     6388           .
     6389     end.
     6390     else do:
     6391        assign
     6392           temp-gds-qnty.rash = temp-gds-qnty.rash  + p-val
     6393           temp-gds-qnty.qnty-day = 1
     6394           .
     6395     end.
     6396    end.
     6397   end procedure.
     6398   procedure u-qnty :
     6399    do
     6400    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6401    :
     6402    if p-mode-calc = ""  then do:
     6403   def var vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6404   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     6405   define var l-max-zap        as decimal no-undo .
     6406   define variable l-min-ost         as logical   no-undo .
     6407   Assign
     6408     l-max-zap       =  tmp#zakaz.max-stock
     6409     l-Ostatok-today =  tmp#zakaz.qnty-stk
     6410     l-negative-rest =  tmp#zakaz.negative-rest
     6411     l-min-zap       =  tmp#zakaz.min-stock
     6412     l-negative-sale =  p-neg-sale
     6413     l-goods-way     =  v-gds-way
     6414     l-tog-min-order =  p-t-min-zapas
     6415     l-min-order     =  tmp#zakaz.min-order
     6416     loc-unit-base   =  tmp#zakaz.unit-base
     6417     l-min-ost       =  p-t-min-ost
     6418     l-TOG-deadline  =  p-t-deadline
     6419     l-deadline      =  tmp#zakaz.deadline
     6420     l-Temp-rash     =  tmp#zakaz.temp-rash
     6421     l-corr-coeff    =  v-corr-coeff
     6422     .
     6423   if l-Temp-rash = ? then l-Temp-rash = 0.
     6424    if par-ord-min-ost = yes then do:
     6425       assign l-min-zap =  l-Temp-rash * l-corr-coeff * tmp#zakaz.min-stock .
     6426    end.
     6427     L-a = l-Ostatok-today  .
     6428     if L-a  <= 0 then do:
     6429         if l-negative-rest = true then do:
     6430             if l-negative-sale then do:
     6431               assign
     6432               l-order =  l-max-zap
     6433               .
     6434             end.
     6435             else do:
     6436               assign
     6437                 l-order = absolute(l-a) + l-max-zap
     6438               .
     6439             end.
     6440         end.
     6441         else do:
     6442             assign
     6443               l-order = l-max-zap
     6444               .
     6445         end.
     6446      End.
     6447      Else do :
     6448         if ( l-max-zap - l-Ostatok-today ) >= 0 then  l-order = l-max-zap - l-Ostatok-today .
     6449                                                 else  l-order = 0 .
     6450      End.
     6451    assign
     6452     v-protocol-date = today
     6453     v-protocol-time = time
     6454    .
     6455    if is-log = true then  put stream stream_order unformatted
     6456   ">> Довести заказ до максимального остатка "  today " " string(time,"hh:mm:ss") skip
     6457      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     6458      "Остаток на сегодня:" l-Ostatok-today skip
     6459      "Отриц.остатки     :" l-negative-rest skip
     6460      "MIN остаток       :" l-min-zap       skip
     6461      "MAX остаток       :" l-max-zap       skip
     6462      "отриц.продажа     :" l-negative-sale skip
     6463      "рассчитано заказа :" l-order         skip
     6464      "_________________ "                  skip
     6465      "min заказ         :" l-min-order     skip
     6466      "товар в пути      :" l-goods-way     skip
     6467      "срок хранения     :" l-deadline      skip
     6468      .
     6469   v-stroka-protocol = "" .
     6470   v-stroka-protocol =
     6471      "00.Метод расчета заказа:" + "Довести заказ до максимального остатка" + chr(4) +
     6472      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     6473      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     6474      "03.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     6475      "04.MAX остаток       :" + string(l-max-zap      ) + chr(4) +
     6476      "05.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     6477      "06.рассчитано заказа :" + string(l-order        ) + chr(4) +
     6478      "07.min заказ         :" + string(l-min-order    ) + chr(4) +
     6479      "08.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     6480      "09.срок хранения     :" + string(l-deadline     ) + chr(4) .
     6481   v-media-qnty = l-order .
     6482      if l-min-ost = true then do:
     6483          if l-Ostatok-today > l-min-zap then
     6484              assign
     6485               l-order = 0
     6486               l-new-zakaz = 0
     6487              .
     6488         assign v-stroka-protocol = v-stroka-protocol + "10.1>>После проверки на MIN остаток:" + string(l-order) + chr(4)  .
     6489      end.
     6490     if (l-order - l-goods-way) < 0 then
     6491        l-new-zakaz = 0 .
     6492     else
     6493        l-new-zakaz = l-order - l-goods-way .
     6494     assign v-stroka-protocol = v-stroka-protocol + "10.2>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     6495   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     6496       and lookup('шту':U, ub.units.type) > 0)
     6497       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     6498           l-new-zakaz = trunc( l-new-zakaz, 0 ) + 1 .
     6499           assign v-stroka-protocol = v-stroka-protocol + "10.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     6500       end.
     6501     if  l-deadline > 0 and l-tog-deadline = true  then do:
     6502        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     6503        v-stroka-protocol = v-stroka-protocol + "10.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     6504    end .
     6505    if l-tog-min-order then do:
     6506     if (l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     6507        l-new-zakaz = 0 .
     6508        assign v-stroka-protocol = v-stroka-protocol + "10.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     6509    end .
     6510   if l-new-zakaz = ? then l-new-zakaz = 0 .
     6511   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     6512    "__________________________________________________"     skip
     6513    .
     6514   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     6515   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     6516   end.
     6517    end.
     6518   end procedure.
     6519   procedure u-qnty-e :
     6520    do
     6521    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     6522    :
     6523   if p-mode-calc <> ""  then do:
     6524   def var vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6525   if is-log = true then Output stream stream_order to value ("order_raschet.txt") APPEND .
     6526   define var l-max-zap        as decimal no-undo .
     6527   define variable l-min-ost         as logical   no-undo .
     6528   Assign
     6529     l-max-zap       =  export-ras.max-stock
     6530     l-Ostatok-today =  export-ras.qnty-stk
     6531     l-negative-rest =  export-ras.negative-rest
     6532     l-min-zap       =  export-ras.min-stock
     6533     l-negative-sale =  p-neg-sale
     6534     l-goods-way     =  v-gds-way
     6535     l-tog-min-order =  p-t-min-zapas
     6536     l-min-order     =  export-ras.min-order
     6537     loc-unit-base   =  export-ras.unit-base
     6538     l-min-ost       =  p-t-min-ost
     6539     l-TOG-deadline  =  p-t-deadline
     6540     l-deadline      =  export-ras.deadline
     6541     l-Temp-rash     =  export-ras.temp-rash
     6542     l-corr-coeff    =  v-corr-coeff
     6543     .
     6544   if l-Temp-rash = ? then l-Temp-rash = 0.
     6545    if par-ord-min-ost = yes then do:
     6546       assign l-min-zap =  l-Temp-rash * l-corr-coeff * export-ras.min-stock .
     6547    end.
     6548     L-a = l-Ostatok-today  .
     6549     if L-a  <= 0 then do:
     6550         if l-negative-rest = true then do:
     6551             if l-negative-sale then do:
     6552               assign
     6553               l-order =  l-max-zap
     6554               .
     6555             end.
     6556             else do:
     6557               assign
     6558                 l-order = absolute(l-a) + l-max-zap
     6559               .
     6560             end.
     6561         end.
     6562         else do:
     6563             assign
     6564               l-order = l-max-zap
     6565               .
     6566         end.
     6567      End.
     6568      Else do :
     6569         if ( l-max-zap - l-Ostatok-today ) >= 0 then  l-order = l-max-zap - l-Ostatok-today .
     6570                                                 else  l-order = 0 .
     6571      End.
     6572    assign
     6573     v-protocol-date = today
     6574     v-protocol-time = time
     6575    .
     6576    if is-log = true then  put stream stream_order unformatted
     6577   ">> Довести заказ до максимального остатка "  today " " string(time,"hh:mm:ss") skip
     6578      tmp#zakaz.gds-code " " tmp#zakaz.gds-name skip
     6579      "Остаток на сегодня:" l-Ostatok-today skip
     6580      "Отриц.остатки     :" l-negative-rest skip
     6581      "MIN остаток       :" l-min-zap       skip
     6582      "MAX остаток       :" l-max-zap       skip
     6583      "отриц.продажа     :" l-negative-sale skip
     6584      "рассчитано заказа :" l-order         skip
     6585      "_________________ "                  skip
     6586      "min заказ         :" l-min-order     skip
     6587      "товар в пути      :" l-goods-way     skip
     6588      "срок хранения     :" l-deadline      skip
     6589      .
     6590   v-stroka-protocol = "" .
     6591   v-stroka-protocol =
     6592      "00.Метод расчета заказа:" + "Довести заказ до максимального остатка" + chr(4) +
     6593      "01.Остаток на сегодня:" + string(l-Ostatok-today) + chr(4) +
     6594      "02.Отриц.остатки     :" + string(l-negative-rest) + chr(4) +
     6595      "03.MIN остаток       :" + string(l-min-zap      ) + chr(4) +
     6596      "04.MAX остаток       :" + string(l-max-zap      ) + chr(4) +
     6597      "05.отриц.продажа     :" + string(l-negative-sale) + chr(4) +
     6598      "06.рассчитано заказа :" + string(l-order        ) + chr(4) +
     6599      "07.min заказ         :" + string(l-min-order    ) + chr(4) +
     6600      "08.товар в пути      :" + string(l-goods-way    ) + chr(4) +
     6601      "09.срок хранения     :" + string(l-deadline     ) + chr(4) .
     6602   export-ras.order-qnty = l-order .
     6603      if l-min-ost = true then do:
     6604          if l-Ostatok-today > l-min-zap then
     6605              assign
     6606               l-order = 0
     6607               l-new-zakaz = 0
     6608              .
     6609         assign v-stroka-protocol = v-stroka-protocol + "10.1>>После проверки на MIN остаток:" + string(l-order) + chr(4)  .
     6610      end.
     6611     if (l-order - l-goods-way) < 0 then
     6612        l-new-zakaz = 0 .
     6613     else
     6614        l-new-zakaz = l-order - l-goods-way .
     6615     assign v-stroka-protocol = v-stroka-protocol + "10.2>>После учета товара в пути:" + string(l-new-zakaz) + chr(4)  .
     6616   if can-find(first ub.units where ub.units.unit-name = loc-unit-base
     6617       and lookup('шту':U, ub.units.type) > 0)
     6618       and trunc( l-new-zakaz, 0 ) <> l-new-zakaz then do:
     6619           l-new-zakaz = trunc( l-new-zakaz, 0 ) + 1 .
     6620           assign v-stroka-protocol = v-stroka-protocol + "10.3>>После округления до штук + 1:" + string(l-new-zakaz) + chr(4)  .
     6621       end.
     6622     if  l-deadline > 0 and l-tog-deadline = true  then do:
     6623        l-new-zakaz = min(l-new-zakaz, l-Temp-rash * l-deadline ) .
     6624        v-stroka-protocol = v-stroka-protocol + "10.4>>После проверки на срок хронения:" + string(l-new-zakaz) + chr(4)  .
     6625    end .
     6626    if l-tog-min-order then do:
     6627     if (l-new-zakaz - l-min-order) < 0 and l-min-order > 0 then
     6628        l-new-zakaz = 0 .
     6629        assign v-stroka-protocol = v-stroka-protocol + "10.5>>После проверки на MIN заказ:" + string(l-new-zakaz) + chr(4)  .
     6630    end .
     6631   if l-new-zakaz = ? then l-new-zakaz = 0 .
     6632   if is-log = true then  put STREAM  stream_order unformatted "Итого(БЕЗ ОКР) "  l-new-zakaz skip
     6633    "__________________________________________________"     skip
     6634    .
     6635   if is-log = true then  OUTPUT  STREAM  stream_order CLOSE.
     6636   assign v-stroka-protocol = v-stroka-protocol + "17.Итого рассчитано(БЕЗ ОКР):" + string(l-new-zakaz) .
     6637   end.
     6638    end.
     6639   end procedure.
