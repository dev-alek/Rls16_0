     4729                       when  'wm':U       then if  p-t-sppv    then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   +  p-gds-dtl.fact-qnty.
     4730                       when  'em':U       then if  p-t-sppv-2  then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   +  p-gds-dtl.fact-qnty.
     4731                       when  'ev':U      then if  p-t-sppv-3  then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   +  p-gds-dtl.fact-qnty.
     4732                       when  'rv':U  then if  p-t-sppv-4  then assign tmp#zakaz-prn.qnty-sale = tmp#zakaz-prn.qnty-sale   -  p-gds-dtl.fact-qnty.
