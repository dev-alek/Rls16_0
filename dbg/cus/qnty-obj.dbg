     1153   define variable l-Ostatok-today  as decimal   no-undo .
     1154   define variable l-negative-rest  as logical   no-undo .
     1155   define variable l-qnty-day       as integer   no-undo .
     1156   define variable l-pay-day        as integer   no-undo .
     1157   define variable l-Temp-rash      as decimal   no-undo .
     1158   define variable l-null-day       as integer   no-undo init 0 .
     1159   define variable l-min-zap        as decimal   no-undo .
     1160   define variable l-order          as decimal   no-undo .
     1161   define variable l-a              as decimal   no-undo .
     1162   define variable l-b              as decimal   no-undo .
     1163   define variable l-negative-sale  as logical   no-undo .
     1164   define variable l-goods-way      as decimal   no-undo .
     1165   define variable l-min-order      as decimal   no-undo .
     1166   define variable l-tog-min-order  as logical   no-undo .
     1167   define variable loc-unit-base    as character no-undo .
     1168   define variable l-min-ost        as logical   no-undo .
     1169   define variable l-tog-deadline   as logical   no-undo .
     1170   define variable l-deadline       as integer   no-undo .
     1171   define variable l-type-MR        as character no-undo .
     1172   define variable par-ord-min-ost  as logical   no-undo .
     1173   define variable v-media-qnty     as decimal   no-undo .
     1174   define variable l-corr-coeff     as decimal   no-undo .
     1175   define stream stream_order .
     1176   define variable is-log             as logical   no-undo .
     1177   define variable p-val              as character no-undo .
     1178   define variable p-type             as character no-undo .
     1179   define variable v-value-character  as character no-undo .
     1180   define variable v-value-date       as date      no-undo .
     1181   define variable v-value-decimal    as decimal   no-undo .
     1182   define variable v-value-integer    as integer   no-undo .
     1183   define variable v-stroka-protocol  as character no-undo .
     1184   define variable v-protocol-date    as date      no-undo .
     1185   define variable v-protocol-time    as integer   no-undo .
     1186   run adm/shattri.p (
     1187     input "get":U
     1188     ,input ""
     1189     ,input 0
     1190     ,input 'ord-global':U
     1191     ,input 'ord-log':U
