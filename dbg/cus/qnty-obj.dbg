     2818               ,output price-base-with-tax-sale-prl
     2819               ,output price-rubl-without-tax-sale-prl
     2820               ,output price-base-without-tax-sale-prl
     2821               ,output vat-base-sale-prl
     2822               ,output vat-rubl-sale-prl
     2823               ,output vat-base-buyer-prl
     2824               ,output vat-rubl-buyer-prl
     2825               ,output slt-base-sale-prl
     2826               ,output slt-rubl-sale-prl
     2827               ,output road-tax-base-sale-prl
     2828               ,output road-tax-rubl-sale-prl
     2829               ,output excise-base-sale-prl
     2830               ,output excise-rubl-sale-prl
     2831               ,output discnt-base-sale-prl
     2832               ,output discnt-rubl-sale-prl
     2833               ) no-error .
     2834             if error-status :error
     2835             then do:
