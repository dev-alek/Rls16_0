     2903   end procedure.
     2904   procedure prdoclib-calc-prc :
     2905     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2906     define input  parameter p-cons-pay        as   integer                no-undo.
     2907     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2908     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2909     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2910     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2911     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2912     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2913     do
     2914     on error undo, return error return-value
     2915     :
     2916       define buffer buf_price-doc       for ub.price-doc .
     2917       define buffer buf_price-list      for ub.price-list .
     2918       define buffer buf_parts           for ub.parts .
     2919       define variable v-ov-qnty     as decimal   no-undo .
     2920       define variable v-ov-base     as decimal   no-undo .
     2921       define variable v-ov-VAT-base as decimal   no-undo .
     2922       define variable v-ov-SLT-base as decimal   no-undo .
     2923       define variable v-cons-qnty   as decimal   no-undo .
     2924       define variable v-prch-qnty   as decimal   no-undo .
     2925       define variable v-cons-mult   as decimal   no-undo .
     2926       define variable v-prch-mult   as decimal   no-undo .
     2927       find first buf_price-doc no-lock
     2928         where recid(buf_price-doc) = p-price-doc-recid
     2929         no-error .
     2930       if not available buf_price-doc
     2931       then do:
     2932         message
     2933           vss-workfile vss-revision vss-description skip
     2934           vss-include-info13 skip
     2935           "Ошибка задания входных параметров" skip
     2936           "Не найден документ переоценки" skip
     2937           "Код записи (recid)" p-price-doc-recid skip
     2938           view-as alert-box error .
     2939         undo, return error .
     2940       end.
     2941       for each buf_price-list no-lock
     2942         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2943           and buf_price-list.main-price = true
     2944       on error undo, return error return-value
     2945       :
     2946         run prdoclib-calc-ov
     2947           (input recid(buf_price-list)
     2948           ,output v-ov-qnty
     2949           ,output v-ov-base
     2950           ,output v-ov-VAT-base
     2951           ,output v-ov-SLT-base
     2952           ) no-error .
     2953         if error-status :error
     2954         then do:
     2955           if error-status :get-message(1) <> ""
     2956           then do:
     2957             message
     2958               vss-workfile vss-revision vss-description skip
     2959               vss-include-info13 skip
     2960               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2961               error-status :get-message(1) skip
     2962               return-value skip
     2963               view-as alert-box error .
     2964           end.
     2965           undo, return error return-value .
     2966         end.
     2967         assign
     2968           v-cons-qnty = 0
     2969           v-prch-qnty = 0
     2970         .
     2971         for each buf_parts no-lock
     2972           where buf_parts.out-code  = buf_price-list.doc-num
     2973             and buf_parts.obj-type  = buf_price-list.obj-type
     2974             and buf_parts.obj-code  = buf_price-list.obj-code
     2975             and buf_parts.artic     = buf_price-list.artic
     2976             and buf_parts.prod-type = buf_price-list.prod-type
     2977             and buf_parts.prod-code = buf_price-list.prod-code
     2978         on error undo, return error return-value
     2979         :
     2980           if buf_parts.pay-code = p-cons-pay
     2981           then do:
     2982             assign
     2983               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2984             .
     2985           end.
     2986           else do:
     2987             assign
     2988               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2989             .
     2990           end.
     2991         end.
     2992         if (v-cons-qnty + v-prch-qnty) = 0
     2993         then do:
     2994           assign
     2995             v-cons-mult = 0
     2996             v-prch-mult = 1
     2997           .
     2998         end.
     2999         else do:
     3000           assign
     3001             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     3002             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     3003           .
     3004         end.
     3005         assign
     3006           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     3007           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     3008           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     3009           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     3010           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     3011           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     3012         .
     3013       end.
     3014     end.
     3015   end procedure.
     3016   procedure prdoclib-calc-ov :
     3017     define input  parameter p-price-list-recid as recid     no-undo .
     3018     define output parameter p-fact-qnty        as decimal   no-undo .
     3019     define output parameter p-ov-base          as decimal   no-undo .
     3020     define output parameter p-ov-VAT-base      as decimal   no-undo .
     3021     define output parameter p-ov-SLT-base      as decimal   no-undo .
     3022     do
     3023     on error undo, return error return-value
     3024     :
     3025       define buffer buf_main_price-list    for ub.price-list .
     3026       define buffer buf_prev_price-list    for ub.price-list .
     3027       define buffer buf_special_price-list for ub.price-list .
     3028       define buffer buf_goods              for ub.goods .
     3029       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     3030       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     3031       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     3032       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     3033       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     3034       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     3035       define variable v-prev-price-list-recid as   recid                  no-undo.
     3036       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     3037       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     3038       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     3039       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     3040       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     3041       find first buf_main_price-list no-lock
     3042         where recid(buf_main_price-list) = p-price-list-recid
     3043         no-error .
     3044       if not available buf_main_price-list
     3045       then do:
     3046         message
     3047           vss-workfile vss-revision vss-description skip
     3048           vss-include-info13 skip
     3049           "Ошибка задания входных параметров" skip
     3050           "Не найдена строка переоценки" skip
     3051           "Код записи (recid)" p-price-list-recid skip
     3052           view-as alert-box error .
     3053         undo, return error .
     3054       end.
     3055       if buf_main_price-list.main-price <> true
     3056       then do:
     3057         message
     3058           vss-workfile vss-revision vss-description skip
     3059           vss-include-info13 skip
     3060           "Ошибка задания входных параметров" skip
     3061           "Строка переоценки не является основной" skip
     3062           "Код записи (recid)" p-price-list-recid skip
     3063           "Переоценка" buf_main_price-list.doc-num skip
     3064           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3065           "Бар-код" buf_main_price-list.b-code skip
     3066           view-as alert-box error .
     3067         undo, return error .
     3068       end.
     3069       run prdoclib-calc-fact-sale in this-procedure
     3070         (input  recid(buf_main_price-list)
     3071         ,output v-fact-qnty
     3072         ,output v-cur-base
     3073         ,output v-cur-VAT-base
     3074         ,output v-cur-SLT-base
     3075         ,output v-cur-road-tax-base
     3076         ,output v-cur-excise-base
     3077         ) no-error.
     3078       if error-status :error
     3079       then do:
     3080         message
     3081           vss-workfile vss-revision vss-description skip
     3082           vss-include-info13 skip
     3083           "Ошибка при расчете сумм переоценки." skip
     3084           "Документ переоценки" buf_main_price-list.doc-num skip
     3085           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3086           error-status :get-message(1) skip
     3087           return-value skip
     3088           view-as alert-box error .
     3089         undo, return error .
     3090       end.
     3091   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3092   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3093     (input  buf_main_price-list.obj-type
     3094     ,input  buf_main_price-list.obj-code
     3095     ,input  buf_main_price-list.b-code
     3096     ,input  buf_main_price-list.b-code
     3097     ,input  buf_main_price-list.fact-order
     3098     ,output v-prev-price-list-recid
     3099     ,output v-prev-cli-base-rate
     3100     ) no-error .
     3101       if error-status :error
     3102       then do:
     3103         message
     3104           vss-workfile vss-revision vss-description skip
     3105           vss-include-info13 skip
     3106           "Ошибка при поиске предыдущей переоценки." skip
     3107           "Документ переоценки " buf_main_price-list.doc-num skip
     3108           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3109           error-status :get-message(1) skip
     3110           return-value skip
     3111           view-as alert-box error .
     3112         undo, return error .
     3113       end.
     3114       if v-prev-price-list-recid <> ?
     3115       then do:
     3116         find first buf_prev_price-list no-lock
     3117           where recid(buf_prev_price-list) = v-prev-price-list-recid
     3118           .
     3119         find first buf_special_price-list no-lock
     3120           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     3121             and buf_special_price-list.main-price = false
     3122             and buf_special_price-list.artic      = buf_prev_price-list.artic
     3123             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     3124             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     3125             and buf_special_price-list.doc-qnty   <> ?
     3126           no-error .
     3127         if available buf_special_price-list
     3128         then do:
     3129           message
     3130             "Товар имеет специальные цены на признаки" skip
     3131             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3132             "Переоценка" buf_prev_price-list.doc-num skip
     3133             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3134             view-as alert-box error .
     3135           undo, return error .
     3136         end.
     3137         find first buf_goods no-lock
     3138           where buf_goods.artic     = buf_main_price-list.artic
     3139             and buf_goods.prod-type = buf_main_price-list.prod-type
     3140             and buf_goods.prod-code = buf_main_price-list.prod-code
     3141           no-error .
     3142         if not available buf_goods
     3143         then do:
     3144           message
     3145             vss-workfile vss-revision vss-description skip
     3146             vss-include-info13 skip
     3147             "Не найден товар" skip
     3148             "Переоценка" buf_main_price-list.doc-num skip
     3149             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3150             view-as alert-box error .
     3151           undo, return error .
     3152         end.
     3153         if buf_prev_price-list.vat-pc = ?
     3154         or buf_prev_price-list.slt-pc = ?
     3155         then do:
     3156           message
     3157             "В переоценке не заданы налоги товара" skip
     3158             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3159             "Переоценка" buf_prev_price-list.doc-num skip
     3160             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3161             "НДС" buf_prev_price-list.vat-pc skip
     3162             "НП" buf_prev_price-list.slt-pc skip
     3163             view-as alert-box error .
     3164           undo, return error return-value .
     3165         end.
     3166         define variable v-prev-cur-SLT-pc as decimal no-undo .
     3167         assign
     3168           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     3169         .
     3170         assign
     3171           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     3172           v-prev-cur-VAT-base = v-fact-qnty
     3173                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     3174                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     3175           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     3176         .
     3177         assign
     3178           p-fact-qnty   = v-fact-qnty
     3179           p-ov-base     = v-cur-base     - v-prev-cur-base
     3180           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3181           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3182         .
     3183       end.
     3184       else do:
     3185         assign
     3186           v-prev-cur-base     = 0
     3187           v-prev-cur-VAT-base = 0
     3188           v-prev-cur-SLT-base = 0
     3189           .
     3190         assign
     3191           p-fact-qnty   = v-fact-qnty
     3192           p-ov-base     = v-cur-base     - v-prev-cur-base
     3193           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3194           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3195         .
     3196       end.
     3197     end.
     3198   end procedure.
     3199   procedure prdoclib-init-prt-obj-by-factord :
     3200     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3201     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3202     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3203     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3204     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3205     define input parameter p-fact-order         as decimal   no-undo .
     3206     define input parameter p-include-fact-order as logical   no-undo .
     3207     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     3208     define buffer buf_gds-obj      for ub.gds-obj .
     3209     define buffer buf_doc-line     for ub.doc-line .
     3210     define buffer buf_temp-prt-obj for temp-prt-obj .
     3211     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3212     do
     3213     on error undo, return error return-value
     3214     :
     3215       do transaction
     3216       on error undo, return error return-value
     3217       :
     3218   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3219   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3220     (input  p-obj-type
     3221     ,input  p-obj-code
     3222     ,input  p-artic
     3223     ,input  p-prod-type
     3224     ,input  p-prod-code
     3225     ,buffer buf_gds-obj
     3226     ) no-error .
     3227         if error-status :error
     3228         then do:
     3229           message
     3230             vss-workfile vss-revision vss-description skip
     3231             vss-include-info13 skip
     3232             "Невозможно найти gds-obj" skip
     3233             error-status :get-message(1) skip
     3234             return-value skip
     3235             view-as alert-box error .
     3236           undo, return error .
     3237         end.
     3238         find current buf_gds-obj exclusive-lock .
     3239       end.
     3240       run prdoclib-init-temp-prt-obj in this-procedure
     3241         (input p-obj-type
     3242         ,input p-obj-code
     3243         ,input p-artic
     3244         ,input p-prod-type
     3245         ,input p-prod-code
     3246         ,input 0
     3247         ) .
     3248       for each buf_temp-prt-obj
     3249         where buf_temp-prt-obj.is-term <> true
     3250       on error undo, return error return-value
     3251       :
     3252         delete buf_temp-prt-obj .
     3253       end.
     3254       if p-include-fact-order = true
     3255       then do:
     3256         assign
     3257          p-fact-order = p-fact-order - 0.0000000001
     3258         .
     3259       end.
     3260       for each buf_doc-line no-lock
     3261         where buf_doc-line.obj-type   = p-obj-type
     3262           and buf_doc-line.obj-code   = p-obj-code
     3263           and buf_doc-line.artic      = p-artic
     3264           and buf_doc-line.prod-type  = p-prod-type
     3265           and buf_doc-line.prod-code  = p-prod-code
     3266           and buf_doc-line.status_    = 'факт':U
     3267           and buf_doc-line.fact-order >= p-fact-order
     3268       on error undo, return error return-value
     3269       :
     3270         run prdoclib-process-document in this-procedure
     3271           (input  buf_doc-line.doc-code
     3272           ,input  p-obj-type
     3273           ,input  p-obj-code
     3274           ,input  p-artic
     3275           ,input  p-prod-type
     3276           ,input  p-prod-code
     3277           ,output v-total-gds-dtl-qnty
     3278           ) .
     3279       end.
     3280     end.
     3281   end procedure.
     3282   procedure prdoclib-process-document :
     3283     define input  parameter p-doc-code           as character no-undo .
     3284     define input  parameter p-obj-type           as character no-undo .
     3285     define input  parameter p-obj-code           as integer   no-undo .
     3286     define input  parameter p-artic              as character no-undo .
     3287     define input  parameter p-prod-type          as character no-undo .
     3288     define input  parameter p-prod-code          as integer   no-undo .
     3289     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3290     define buffer buf_trn-doc      for ub.trn-doc .
     3291     define buffer buf_gds-dtl      for ub.gds-dtl .
     3292     define buffer buf_temp-prt-obj for temp-prt-obj .
     3293     do
     3294     on error undo, return error return-value
     3295     :
     3296       find first buf_trn-doc no-lock
     3297         where buf_trn-doc.doc-code = p-doc-code
     3298         no-error .
     3299       if not available buf_trn-doc then do:
     3300         message
     3301           vss-workfile vss-revision vss-description skip
     3302           vss-include-info13 skip
     3303           "Ошибка при поиске документа" skip
     3304           "Документ" p-doc-code skip
     3305           "Объект" p-obj-type p-obj-code skip
     3306           "Артикул" p-artic p-prod-type p-prod-code skip
     3307           view-as alert-box error .
     3308         undo, return error .
     3309       end.
     3310       assign
     3311         p-total-gds-dtl-qnty = 0
     3312       .
     3313       for each buf_gds-dtl no-lock
     3314         where buf_gds-dtl.doc-code  = p-doc-code
     3315           and buf_gds-dtl.artic     = p-artic
     3316           and buf_gds-dtl.prod-type = p-prod-type
     3317           and buf_gds-dtl.prod-code = p-prod-code
     3318       on error undo, return error
     3319       :
     3320         define variable v-term-node as integer   no-undo .
     3321   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3322     (input  buf_gds-dtl.prt-code
     3323     ,output v-term-node
     3324     )  .
     3325         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3326           (input  v-term-node
     3327           ,buffer buf_temp-prt-obj
     3328           ) .
     3329         if buf_temp-prt-obj.is-term <> true then do:
     3330           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3331                                        ,buf_gds-dtl.prt-code
     3332                                        ) .
     3333         end.
     3334         case buf_trn-doc.doc-type :
     3335           when 'при':U or
     3336           when 'возврат':U
     3337           then do:
     3338             assign
     3339               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3340                                           - buf_gds-dtl.fact-qnty
     3341               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3342                                           - buf_gds-dtl.fact-qnty
     3343             .
     3344           end.
     3345           when 'рас':U or
     3346           when 'спи':U
     3347           then do:
     3348             assign
     3349               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3350                                           + buf_gds-dtl.fact-qnty
     3351               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3352                                           + buf_gds-dtl.fact-qnty
     3353             .
     3354           end.
     3355           when 'инв':U
     3356           then do:
     3357             assign
     3358               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3359                                           - buf_gds-dtl.doc-qnty
     3360               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3361                                           - buf_gds-dtl.doc-qnty
     3362             .
     3363           end.
     3364           otherwise do:
     3365             undo, return error substitute("Неизвестный тип документа &1"
     3366                                          ,buf_trn-doc.doc-type
     3367                                          ) .
     3368           end.
     3369         end.
     3370       end.
     3371     end.
     3372   end procedure.
     3373   procedure prdoclib-prc-pl-document :
     3374     define input  parameter p-doc-code              as character no-undo .
     3375     define input  parameter p-obj-type              as character no-undo .
     3376     define input  parameter p-obj-code              as integer   no-undo .
     3377     define input  parameter p-gds-code              as integer   no-undo .
     3378     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3379     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3380     do
     3381     on error undo, return error return-value
     3382     :
     3383       define buffer buf_trn-doc      for ub.trn-doc .
     3384       define buffer buf_doc-pl       for ub.doc-pl .
     3385       define buffer buf_temp-pl-gds for temp-pl-gds .
     3386       define variable v-sign as decimal   no-undo .
     3387       find first buf_trn-doc no-lock
     3388         where buf_trn-doc.doc-code = p-doc-code
     3389         no-error .
     3390       if not available buf_trn-doc then do:
     3391         message
     3392           vss-workfile vss-revision vss-description skip
     3393           vss-include-info13 skip
     3394           "Ошибка при поиске документа" skip
     3395           "Документ" p-doc-code skip
     3396           "Объект" p-obj-type p-obj-code skip
     3397           "Товар" p-gds-code skip
     3398           view-as alert-box error .
     3399         undo, return error .
     3400       end.
     3401       assign
     3402         p-total-pl-gds-qnty     = 0
     3403         p-total-pl-gds-cli-qnty = 0
     3404       .
     3405       for each buf_doc-pl no-lock
     3406         where buf_doc-pl.out-code  = p-doc-code
     3407           and buf_doc-pl.gds-code  = p-gds-code
     3408       on error undo, return error return-value
     3409       :
     3410         find first buf_temp-pl-gds
     3411           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3412             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3413             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3414           .
     3415         case buf_trn-doc.doc-type :
     3416           when 'при':U
     3417           or when 'возврат':U
     3418           or when 'инв':U
     3419           then do:
     3420             assign
     3421               v-sign = -1.0
     3422             .
     3423           end.
     3424           when 'рас':U or
     3425           when 'спи':U
     3426           then do:
     3427             assign
     3428               v-sign = 1.0
     3429             .
     3430           end.
     3431           otherwise do:
     3432             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3433           end.
     3434         end case.
     3435         assign
     3436           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3437           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3438           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3439           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3440         .
     3441       end.
     3442     end.
     3443   end procedure.
     3444   procedure prdoclib-init-prt-obj-by-date :
     3445     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3446     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3447     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3448     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3449     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3450     define input parameter p-fact-date  as date      no-undo .
     3451     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3452     do
     3453     on error undo, return error return-value
     3454     :
     3455       define variable v-fact-order                as decimal   no-undo .
     3456       define variable v-shift-end-fact-order      as decimal   no-undo .
     3457       define variable v-day-end-fact-order        as decimal   no-undo .
     3458       run factord in this-procedure
     3459         (input  p-fact-date
     3460         ,input  1
     3461         ,input  1
     3462         ,input  ?
     3463         ,input  0
     3464         ,input  false
     3465         ,output v-fact-order
     3466         ,output v-shift-end-fact-order
     3467         ,output v-day-end-fact-order
     3468         ) no-error .
     3469       if error-status :error
     3470       then do:
     3471         message
     3472           vss-workfile vss-revision vss-description skip
     3473           vss-include-info13 skip
     3474           "Ошибка при определении момента времени, на который требуется остаток" skip
     3475           "Объект" p-obj-type p-obj-code skip
     3476           "Артикул" p-artic p-prod-type p-prod-code skip
     3477           "Дата" p-fact-date skip
     3478           view-as alert-box error .
     3479         undo, return error .
     3480       end.
     3481       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3482         (input p-obj-type
     3483         ,input p-obj-code
     3484         ,input p-artic
     3485         ,input p-prod-type
     3486         ,input p-prod-code
     3487         ,input v-day-end-fact-order
     3488         ,input false
     3489         ) no-error .
     3490       if error-status :error
     3491       then do:
     3492         message
     3493           vss-workfile vss-revision vss-description skip
     3494           vss-include-info13 skip
     3495           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3496           "Объект" p-obj-type p-obj-code skip
     3497           "Артикул" p-artic p-prod-type p-prod-code skip
     3498           "Дата" p-fact-date skip
     3499           view-as alert-box error .
     3500         undo, return error .
     3501       end.
     3502     end.
     3503   end procedure.
     3504   procedure prdoclib-calc-temp-fact-sale :
     3505     define input  parameter p-obj-type           as character no-undo .
     3506     define input  parameter p-obj-code           as integer   no-undo .
     3507     define input  parameter p-gds-code           as integer   no-undo .
     3508     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3509     define input  parameter p-curr-r-b           as character no-undo .
     3510     define output parameter p-fact-qnty          as decimal   no-undo .
     3511     define output parameter p-cur-base           as decimal   no-undo .
     3512     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3513     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3514     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3515     define output parameter p-cur-excise-base    as decimal   no-undo .
     3516     define buffer buf_temp-prt-obj for temp-prt-obj .
     3517     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3518     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3519     define variable parrecid-prl        as recid     no-undo .
     3520     define variable v-fact-qnty         as decimal   no-undo .
     3521     define variable v-cur-base          as decimal   no-undo .
     3522     define variable v-cur-VAT-base      as decimal   no-undo .
     3523     define variable v-cur-SLT-base      as decimal   no-undo .
     3524     define variable v-cur-road-tax-base as decimal   no-undo .
     3525     define variable v-cur-excise-base   as decimal   no-undo .
     3526     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3527     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3528     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3529     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3530     define variable vat-base-sale-prl               as decimal   no-undo .
     3531     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3532     define variable vat-base-buyer-prl              as decimal   no-undo .
     3533     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3534     define variable slt-base-sale-prl               as decimal   no-undo .
     3535     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3536     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3537     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3538     define variable excise-base-sale-prl            as decimal   no-undo .
     3539     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3540     define variable discnt-base-sale-prl            as decimal   no-undo .
     3541     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3542     do
     3543     on error undo, return error return-value
     3544     :
     3545       for each buf_temp-prt-obj no-lock
     3546       on error undo, return error return-value
     3547       :
     3548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3549     (input  p-gds-code
     3550     ,input  buf_temp-prt-obj.prt-code
     3551     ,output v-prt-b-code
     3552     ) no-error .
     3553         if error-status :error
     3554         then do:
     3555           message
     3556             vss-workfile vss-revision vss-description skip
     3557             "Ошибка при определении бар-кода признака" skip
     3558             "Код товара"   p-gds-code skip
     3559             "Код признака" buf_temp-prt-obj.prt-code skip
     3560             error-status :get-message(1) skip
     3561             return-value skip
     3562             view-as alert-box error .
     3563           undo, return error .
     3564         end.
     3565   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3567     (input  p-obj-type
     3568     ,input  p-obj-code
     3569     ,input  v-prt-b-code
     3570     ,input  0
     3571     ,input  p-day-end-fact-order
     3572     ,output parrecid-prl
     3573     ,output v-cli-base-rate
     3574     ) no-error .
     3575         if error-status :error
     3576         then do:
     3577           message
     3578             vss-workfile vss-revision vss-description skip
     3579             "Ошибка при определении цены бар-кода" skip
     3580             "Объект" p-obj-type p-obj-code skip
     3581             "Бар-код" v-prt-b-code skip
     3582             "fact-order" p-day-end-fact-order skip
     3583             error-status :get-message(1) skip
     3584             return-value skip
     3585             view-as alert-box error .
     3586           undo, return error .
     3587         end.
     3588         if parrecid-prl <> ?
     3589         then do:
     3590           run prl-vat in this-procedure
     3591             (input  parrecid-prl
     3592             ,output price-rubl-with-tax-sale-prl
     3593             ,output price-base-with-tax-sale-prl
     3594             ,output price-rubl-without-tax-sale-prl
     3595             ,output price-base-without-tax-sale-prl
     3596             ,output vat-base-sale-prl
     3597             ,output vat-rubl-sale-prl
     3598             ,output vat-base-buyer-prl
     3599             ,output vat-rubl-buyer-prl
     3600             ,output slt-base-sale-prl
     3601             ,output slt-rubl-sale-prl
     3602             ,output road-tax-base-sale-prl
     3603             ,output road-tax-rubl-sale-prl
     3604             ,output excise-base-sale-prl
     3605             ,output excise-rubl-sale-prl
     3606             ,output discnt-base-sale-prl
     3607             ,output discnt-rubl-sale-prl
     3608             ) no-error .
     3609           if error-status :error
     3610           then do:
     3611             message
     3612               vss-workfile vss-revision vss-description skip
     3613               "Ошибка при вызове процеды prl-vat" skip
     3614               "Объект" p-obj-type p-obj-code skip
     3615               "Код товара" p-gds-code skip
     3616               "Указатель на запись переоценки" parrecid-prl skip
     3617               error-status :get-message(1) skip
     3618               return-value skip
     3619               view-as alert-box error .
     3620             undo, return error .
     3621           end.
     3622         end.
     3623         else do:
     3624           assign
     3625             price-rubl-with-tax-sale-prl    = 0
     3626             price-base-with-tax-sale-prl    = 0
     3627             price-rubl-without-tax-sale-prl = 0
     3628             price-base-without-tax-sale-prl = 0
     3629             vat-base-sale-prl               = 0
     3630             vat-rubl-sale-prl               = 0
     3631             slt-base-sale-prl               = 0
     3632             slt-rubl-sale-prl               = 0
     3633             road-tax-base-sale-prl          = 0
     3634             road-tax-rubl-sale-prl          = 0
     3635             excise-base-sale-prl            = 0
     3636             excise-rubl-sale-prl            = 0
     3637             discnt-base-sale-prl            = 0
     3638             discnt-rubl-sale-prl            = 0
     3639           .
     3640         end.
     3641         assign
     3642           v-fact-qnty         = v-fact-qnty
     3643                               + buf_temp-prt-obj.fact-qnty
     3644           v-cur-base          = v-cur-base
     3645                               + (if p-curr-r-b = 'base':U
     3646                                   then price-base-with-tax-sale-prl
     3647                                   else price-rubl-with-tax-sale-prl
     3648                                 )
     3649                               * buf_temp-prt-obj.fact-qnty
     3650           v-cur-VAT-base      = v-cur-VAT-base
     3651                               + (if p-curr-r-b = 'base':U
     3652                                   then vat-base-sale-prl
     3653                                   else vat-rubl-sale-prl
     3654                                 )
     3655                               * buf_temp-prt-obj.fact-qnty
     3656           v-cur-SLT-base      = v-cur-SLT-base
     3657                               + (if p-curr-r-b = 'base':U
     3658                                   then slt-base-sale-prl
     3659                                   else slt-rubl-sale-prl
     3660                                 )
     3661                               * buf_temp-prt-obj.fact-qnty
     3662           v-cur-road-tax-base = v-cur-road-tax-base
     3663                               + (if p-curr-r-b = 'base':U
     3664                                   then road-tax-base-sale-prl
     3665                                   else road-tax-rubl-sale-prl
     3666                                 )
     3667                               * buf_temp-prt-obj.fact-qnty
     3668           v-cur-excise-base   = v-cur-excise-base
     3669                               + (if p-curr-r-b = 'base':U
     3670                                   then excise-base-sale-prl
     3671                                   else excise-rubl-sale-prl
     3672                                 )
     3673                               * buf_temp-prt-obj.fact-qnty
     3674         .
     3675       end.
     3676       assign
     3677         p-fact-qnty         = v-fact-qnty
     3678         p-cur-base          = v-cur-base
     3679         p-cur-VAT-base      = v-cur-VAT-base
     3680         p-cur-SLT-base      = v-cur-SLT-base
     3681         p-cur-road-tax-base = v-cur-road-tax-base
     3682         p-cur-excise-base   = v-cur-excise-base
     3683       .
     3684     end.
     3685   end procedure.
     3686   procedure prdoclib-clear-temp-pl-gds :
     3687     define buffer buf_temp-pl-gds for temp-pl-gds .
     3688     do
     3689     on error undo, return error return-value
     3690     :
     3691       for each buf_temp-pl-gds
     3692       on error undo, return error return-value
     3693       :
     3694         delete buf_temp-pl-gds .
     3695       end.
     3696     end.
     3697   end procedure.
     3698   procedure prdoclib-init-temp-pl-gds :
     3699     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3700     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3701     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3702     define buffer buf_pl-gds      for ub.pl-gds .
     3703     define buffer buf_temp-pl-gds for temp-pl-gds .
     3704     do
     3705     on error undo, return error return-value
     3706     :
     3707       run prdoclib-clear-temp-pl-gds in this-procedure .
     3708       for each buf_pl-gds
     3709         where buf_pl-gds.obj-type = p-obj-type
     3710           and buf_pl-gds.obj-code = p-obj-code
     3711           and buf_pl-gds.gds-code = p-gds-code
     3712       on error undo, return error return-value
     3713       :
     3714         create buf_temp-pl-gds .
     3715         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3716       end.
     3717     end.
     3718   end procedure.
     3719   procedure prdoclib-init-pl-gds-by-factord :
     3720     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3721     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3722     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3723     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3724     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3725     define input parameter p-fact-order         as decimal   no-undo .
     3726     define input parameter p-include-fact-order as logical   no-undo .
     3727     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3728     define buffer buf_goods       for ub.goods .
     3729     define buffer buf_gds-obj     for ub.gds-obj .
     3730     define buffer buf_doc-line    for ub.doc-line .
     3731     define buffer buf_temp-pl-gds for temp-pl-gds .
     3732     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3733     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3734     do
     3735     on error undo, return error return-value
     3736     :
     3737       do transaction
     3738       on error undo, return error return-value
     3739       :
     3740   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3741   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3742     (input  p-obj-type
     3743     ,input  p-obj-code
     3744     ,input  p-artic
     3745     ,input  p-prod-type
     3746     ,input  p-prod-code
     3747     ,buffer buf_gds-obj
     3748     ) no-error .
     3749         if error-status :error
     3750         then do:
     3751           message
     3752             vss-workfile vss-revision vss-description skip
     3753             vss-include-info13 skip
     3754             "Невозможно найти gds-obj" skip
     3755             error-status :get-message(1) skip
     3756             return-value skip
     3757             view-as alert-box error .
     3758           undo, return error return-value .
     3759         end.
     3760         find current buf_gds-obj exclusive-lock .
     3761       end.
     3762       find first buf_goods no-lock
     3763         where buf_goods.artic     = p-artic
     3764           and buf_goods.prod-type = p-prod-type
     3765           and buf_goods.prod-code = p-prod-code
     3766         .
     3767       run prdoclib-init-temp-pl-gds in this-procedure
     3768         (input p-obj-type
     3769         ,input p-obj-code
     3770         ,input buf_goods.gds-code
     3771         ) .
     3772       if p-include-fact-order = true
     3773       then do:
     3774         assign
     3775          p-fact-order = p-fact-order - 0.0000000001
     3776         .
     3777       end.
     3778       for each buf_doc-line no-lock
     3779         where buf_doc-line.obj-type   = p-obj-type
     3780           and buf_doc-line.obj-code   = p-obj-code
     3781           and buf_doc-line.artic      = p-artic
     3782           and buf_doc-line.prod-type  = p-prod-type
     3783           and buf_doc-line.prod-code  = p-prod-code
     3784           and buf_doc-line.status_    = 'факт':U
     3785           and buf_doc-line.fact-order >= p-fact-order
     3786       on error undo, return error return-value
     3787       :
     3788         run prdoclib-prc-pl-document in this-procedure
     3789           ( input  buf_doc-line.doc-code
     3790            ,input  p-obj-type
     3791            ,input  p-obj-code
     3792            ,input  buf_goods.gds-code
     3793            ,output v-total-pl-gds-qnty
     3794            ,output v-total-pl-gds-cli-qnty
     3795           ) .
     3796       end.
     3797     end.
     3798   end procedure.
     3799   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3800   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     3801      IF parundefine-var = ? THEN RETURN 0.00.
     3802                             ELSE RETURN parundefine-var.
     3803   END FUNCTION.
     3804   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     3805      IF p-undef-char = ? THEN do:
     3806        RETURN "?".
     3807      end.
     3808      ELSE do:
     3809        RETURN p-undef-char .
     3810      end.
     3811   END FUNCTION.
     3812   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3813   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3814   procedure factord :
     3815     define input  parameter p-fact-date            as date    no-undo .
     3816     define input  parameter p-fact-time            as integer no-undo .
     3817     define input  parameter p-fact-num             as integer no-undo .
     3818     define input  parameter p-shift-date           as date    no-undo .
     3819     define input  parameter p-shift-num            as integer no-undo .
     3820     define input  parameter p-shift-on             as logical no-undo .
     3821     define output parameter p-fact-order           as decimal no-undo .
     3822     define output parameter p-shift-end-fact-order as decimal no-undo .
     3823     define output parameter p-day-end-fact-order   as decimal no-undo .
     3824     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     3825     if p-fact-date = ?
     3826     then do:
     3827       return error "Не указана фактическая дата" .
     3828     end.
     3829     define variable v-fact-date-num as integer no-undo .
     3830     assign
     3831       v-fact-date-num = integer(p-fact-date)
     3832     .
     3833     if p-fact-num = ?
     3834     or p-fact-num = 0
     3835     then do:
     3836       return error "Не задан p-fact-num " + string(p-fact-num) .
     3837     end.
     3838     if p-fact-num < 0
     3839     then do:
     3840       return error "Отрицательный fact-num " + string(p-fact-num) .
     3841     end.
     3842     if p-fact-num >= 100000000
     3843     then do:
     3844       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     3845     end.
     3846     if p-shift-on = true
     3847     then do:
     3848       if p-shift-date = ?
     3849       then do:
     3850         return error "Не задана дата смены" .
     3851       end.
     3852       if p-shift-num = ?
     3853       or p-shift-num = 0
     3854       then do:
     3855         return error "Не задан номер смены" .
     3856       end.
     3857     end.
     3858     else do:
     3859       assign
     3860         p-shift-date = p-fact-date
     3861         p-shift-num  = 24
     3862       .
     3863     end.
     3864     define variable v-shift-offset as integer no-undo .
     3865     if p-shift-date = p-fact-date
     3866     then do:
     3867       assign
     3868         v-shift-offset = 1
     3869       .
     3870     end.
     3871     if p-shift-date < p-fact-date
     3872     then do:
     3873       assign
     3874         v-shift-offset = 0
     3875       .
     3876     end.
     3877     if p-shift-date > p-fact-date
     3878     then do:
     3879       message
     3880         vss-workfile vss-revision vss-description skip
     3881         "Неправильная дата закрытия смены" skip
     3882         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     3883         view-as alert-box error .
     3884       undo, return error
     3885         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     3886           ,string(p-fact-date, '99/99/9999':U)
     3887           ,string(p-shift-date, '99/99/9999':U)
     3888           )
     3889       .
     3890     end.
     3891     if p-shift-num < 1
     3892     or p-shift-num > 24
     3893     then do:
     3894       message
     3895         vss-workfile vss-revision vss-description skip
     3896         "Неправильный номер смены" skip
     3897         "p-shift-num" p-shift-num skip
     3898         view-as alert-box error .
     3899       undo, return error return-value .
     3900     end.
     3901     assign
     3902       p-fact-order           = v-fact-date-num
     3903                              + v-shift-offset * 0.5
     3904                              + p-shift-num    * 0.02 - 0.01
     3905                              + p-fact-num     * 0.0000000001
     3906       p-shift-end-fact-order = v-fact-date-num
     3907                              + v-shift-offset * 0.5
     3908                              + p-shift-num    * 0.02
     3909       p-day-end-fact-order   = v-fact-date-num
     3910                              + 0.99
     3911     .
     3912     if p-fact-order           <= v-fact-date-num
     3913     or p-shift-end-fact-order <= v-fact-date-num
     3914     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     3915     or p-shift-end-fact-order >= p-day-end-fact-order
     3916     then do:
     3917       message
     3918         vss-workfile vss-revision vss-description skip
     3919         "Внутренняя ошибка при генерации фактического номера" skip
     3920         "p-fact-date"            p-fact-date            skip
     3921         "p-fact-time"            p-fact-time            skip
     3922         "p-fact-num"             p-fact-num             skip
     3923         "p-shift-date"           p-shift-date           skip
     3924         "p-shift-num"            p-shift-num            skip
     3925         "p-shift-on"             p-shift-on             skip
     3926         "p-shift-end-fact-order" p-shift-end-fact-order skip
     3927         "p-day-end-fact-order"   p-day-end-fact-order   skip
     3928         "v-fact-date-num"        v-fact-date-num        skip
     3929         view-as alert-box error .
     3930       undo, return error return-value .
     3931     end.
     3932   end procedure.
     3933   procedure day-begin-fact-order :
     3934     define input  parameter p-fact-date            as date    no-undo .
     3935     define output parameter p-day-begin-fact-order as decimal no-undo .
     3936     do
     3937     on error undo, return error return-value
     3938     :
     3939       if p-fact-date = ?
     3940       then do:
     3941         assign
     3942           p-day-begin-fact-order = 0
     3943         .
     3944       end.
     3945       else do:
     3946         assign
     3947           p-day-begin-fact-order = integer(p-fact-date)
     3948         .
     3949       end.
     3950     end.
     3951   end procedure.
     3952   procedure factord-max-fact-order :
     3953     define output parameter p-max-fact-order as decimal   no-undo .
     3954     do
     3955     on error undo, return error return-value
     3956     :
     3957       run day-begin-fact-order in this-procedure
     3958         (input  date(1, 1, 5000)
     3959         ,output p-max-fact-order
     3960         ) .
     3961     end.
     3962   end procedure.
     3963   procedure factord-cut-archive :
     3964     define input  parameter p-obj-type             as character no-undo .
     3965     define input  parameter p-obj-code             as integer   no-undo .
     3966     define input  parameter p-fact-date            as date      no-undo .
     3967     define output parameter p-shift-on             as logical   no-undo .
     3968     define output parameter p-shift-date           as date      no-undo .
     3969     define output parameter p-shift-num            as integer   no-undo .
     3970     define output parameter p-day-end-fact-order   as decimal   no-undo .
     3971     define output parameter p-shift-end-fact-order as decimal   no-undo .
     3972     define variable v-fact-order as decimal   no-undo .
     3973     define buffer buf_shift-obj for ub.shift-obj .
     3974     do
     3975     on error undo, return error return-value
     3976     :
     3977   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3978   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3979     (input  p-obj-type
     3980     ,input  p-obj-code
     3981     ,input  'shift-on=request'
     3982     ,output p-shift-on
     3983     ) no-error .
     3984       if error-status :error
     3985       then do:
     3986         message
     3987           vss-workfile vss-revision vss-description skip
     3988           "Ошибка при определении атрибута объекта" skip
     3989           "Объект" p-obj-type p-obj-code skip
     3990           error-status :get-message(1) skip
     3991           return-value skip
     3992           view-as alert-box error .
     3993         undo, return error return-value .
     3994       end.
     3995       if p-shift-on = false
     3996       then do:
     3997         assign
     3998           p-shift-date               = ?
     3999           p-shift-num                = 0
     4000         .
     4001       end.
     4002       else do:
     4003         find first buf_shift-obj share-lock
     4004           where buf_shift-obj.obj-type   = p-obj-type
     4005             and buf_shift-obj.obj-code   = p-obj-code
     4006             and buf_shift-obj.shift-date > p-fact-date
     4007           use-index pi
     4008           no-error .
     4009         if not available buf_shift-obj
     4010         or buf_shift-obj.status_ <> 'зкр':U
     4011         then do:
     4012           message
     4013             vss-workfile vss-revision vss-description skip
     4014             "Невозможно вычислить последнюю смену" skip
     4015             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     4016             "Объект" p-obj-type p-obj-code skip
     4017             "Дата" p-fact-date skip
     4018             view-as alert-box error .
     4019           undo, return error return-value .
     4020         end.
     4021         find last buf_shift-obj share-lock
     4022           where buf_shift-obj.obj-type = p-obj-type
     4023             and buf_shift-obj.obj-code = p-obj-code
     4024             and buf_shift-obj.shift-date <= p-fact-date
     4025           use-index pi
     4026           no-error .
     4027         if available buf_shift-obj
     4028         then do:
     4029           if  buf_shift-obj.status_ = 'зкр':U
     4030           then do:
     4031             assign
     4032               p-shift-date = buf_shift-obj.shift-date
     4033               p-shift-num  = buf_shift-obj.shift-num
     4034             .
     4035           end.
     4036           else do:
     4037             message
     4038               vss-workfile vss-revision vss-description skip
     4039               "Невозможно вычислить последнюю смену" skip
     4040               "Статус смены отличен от статуса" 'зкр':U skip
     4041               "Объект" p-obj-type p-obj-code skip
     4042               "Дата" p-fact-date skip
     4043               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     4044               view-as alert-box error .
     4045             undo, return error return-value .
     4046           end.
     4047         end.
     4048         else do:
     4049           assign
     4050             p-shift-date = p-fact-date - 1
     4051             p-shift-num  = 1
     4052           .
     4053         end.
     4054       end.
     4055       run factord in this-procedure
     4056         (input  p-fact-date
     4057         ,input  1
     4058         ,input  1
     4059         ,input  p-shift-date
     4060         ,input  p-shift-num
     4061         ,input  p-shift-on
     4062         ,output v-fact-order
     4063         ,output p-shift-end-fact-order
     4064         ,output p-day-end-fact-order
     4065         ) no-error .
     4066       if error-status :error
     4067       then do:
     4068         message
     4069           vss-workfile vss-revision vss-description skip
     4070           "Ошибка при вызове процедуры factord"
     4071           error-status :get-message(1) skip
     4072           return-value skip
     4073           view-as alert-box error .
     4074         undo, return error return-value .
     4075       end.
     4076     end.
     4077   end procedure.
     4078   procedure factord-lock-shift :
     4079     define input  parameter p-obj-type  as character no-undo .
     4080     define input  parameter p-obj-code  as integer   no-undo .
     4081     define input  parameter p-fact-date as date      no-undo .
     4082     define parameter buffer buf_shift-obj for ub.shift-obj .
     4083     define variable v-shift-on      as logical   no-undo .
     4084     define variable v-extra-message as character no-undo .
     4085     define variable v-error as character no-undo .
     4086     do
     4087     on error undo, return error return-value
     4088     :
     4089   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4090   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4091     (input  p-obj-type
     4092     ,input  p-obj-code
     4093     ,input  'shift-on=request'
     4094     ,output v-shift-on
     4095     ) no-error .
     4096       if error-status :error
     4097       then do:
     4098         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     4099         undo, return error v-error .
     4100       end.
     4101       if v-shift-on = true
     4102       then do:
     4103         find first buf_shift-obj share-lock
     4104           where buf_shift-obj.obj-type   = p-obj-type
     4105             and buf_shift-obj.obj-code   = p-obj-code
     4106             and buf_shift-obj.shift-date > p-fact-date
     4107           use-index pi
     4108           no-error .
     4109         if not available buf_shift-obj
     4110         or buf_shift-obj.status_ <> 'зкр':U
     4111         then do:
     4112           find last buf_shift-obj
     4113             where buf_shift-obj.obj-type = p-obj-type
     4114               and buf_shift-obj.obj-code = p-obj-code
     4115               and buf_shift-obj.status_  = 'зкр':U
     4116             use-index stts
     4117             no-error .
     4118           if available buf_shift-obj
     4119           then do:
     4120             assign
     4121               v-extra-message =
     4122                     substitute("Дата начала последеней закрытой смены на объекте &1"
     4123                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     4124                               )
     4125             .
     4126           end.
     4127           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     4128           undo, return error v-error .
     4129         end.
     4130       end.
     4131     end.
     4132   end procedure.
     4133   procedure factord-end-day :
     4134     define input  parameter p-fact-date            as date    no-undo .
     4135     define output parameter p-day-end-fact-order   as decimal no-undo .
     4136     do
     4137     on error undo, return error return-value
     4138     :
     4139       if p-fact-date = ?
     4140       then do:
     4141         return error "Не указана фактическая дата" .
     4142       end.
     4143       assign
     4144         p-day-end-fact-order = integer(p-fact-date) + 0.99
     4145       .
     4146     end.
     4147   end procedure.
     4148   procedure factord-to-date :
     4149     define input  parameter p-fact-order as decimal no-undo .
     4150     define output parameter p-fact-date  as date    no-undo .
     4151     define variable v-ref-date  as date      no-undo .
     4152     define variable v-ref-delta as integer   no-undo .
     4153     do
     4154     on error undo, return error return-value
     4155     :
     4156       if p-fact-order = ?
     4157       or p-fact-order = 0
     4158       then do:
     4159         return error "Не указан fact-order" .
     4160       end.
     4161       assign
     4162         v-ref-date  = date(1, 1, 2000)
     4163       .
     4164       assign
     4165         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     4166       .
     4167       assign
     4168         p-fact-date = v-ref-date + v-ref-delta
     4169       .
     4170     end.
     4171   end procedure.
     4172   procedure factord-to-fact-num :
     4173     define input  parameter p-fact-order as decimal no-undo .
     4174     define output parameter p-fact-num   as integer no-undo .
     4175     define variable v-fact-order-trunc as decimal no-undo .
     4176     do
     4177     on error undo, return error return-value
     4178     :
     4179       if p-fact-order = ?
     4180       or p-fact-order = 0
     4181       then do:
     4182         return error "Не указан fact-order" .
     4183       end.
     4184       assign
     4185        v-fact-order-trunc = truncate(p-fact-order, 2)
     4186       .
     4187       assign
     4188         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     4189       .
     4190     end.
     4191   end procedure.
     4192   procedure factord-to-shift-num :
     4193     define input  parameter p-fact-order as decimal no-undo .
     4194     define output parameter p-shift-num   as integer no-undo .
     4195     define variable  p-shift-numd  as decimal   no-undo .
     4196     define variable v-fact-order-trunc as decimal no-undo .
     4197     do
     4198     on error undo, return error return-value
     4199     :
     4200       if p-fact-order = ?
     4201       or p-fact-order = 0
     4202       then do:
     4203         return error "Не указан fact-order" .
     4204       end.
     4205       assign
     4206        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     4207       .
     4208       if v-fact-order-trunc < 0.5 then do:
     4209         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     4210       end.
     4211       assign
     4212         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     4213         .
     4214        assign
     4215         p-shift-num = truncate (p-shift-numd , 0)
     4216       .
     4217     end.
     4218   end procedure.
     4219   define temp-table temp-gds-qnty no-undo
     4220   field day as date
     4221   field prih as decimal
     4222   field rash as decimal
     4223   field ost  as decimal
     4224   field qnty-day as integer
     4225   index pi is unique primary day
     4226   index by-ost ost .
     4227   define variable qnty-lib-v-fact-order-2 as decimal no-undo .
     4228   procedure qnty-lib-clear-tt :
     4229    do
     4230    on error undo, return error return-value
     4231    :
     4232    for each temp-gds-qnty :
     4233        delete temp-gds-qnty .
     4234    end.
     4235    end.
     4236   end procedure.
     4237   procedure qnty-lib-create-tt :
     4238    do
     4239    on error undo, return error return-value
     4240    :
     4241   define input parameter p-fact-order-1 as decimal no-undo .
     4242   define input parameter p-fact-order-2 as decimal no-undo .
     4243   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     4244   define input parameter p-obj-type as character no-undo .
     4245   define input parameter p-obj-code as integer no-undo .
     4246   define variable p-include-fact-order as logical no-undo .
     4247   define buffer buf_goods for ub.goods .
     4248   define variable quantity      as decimal no-undo .
     4249   define variable p-fact-date   as date no-undo .
     4250   define variable p-fact-date-0 as date no-undo .
     4251   define variable p-fact-date-2 as date no-undo .
     4252   define buffer p-doc-line for ub.doc-line .
     4253   define variable p-prih as decimal no-undo .
     4254   define variable p-rash as decimal no-undo .
     4255   qnty-lib-v-fact-order-2 = p-fact-order-2.
     4256   p-include-fact-order = true .
     4257   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     4258        if error-status :error then return error .
     4259          run prdoclib-init-prt-obj-by-factord in this-procedure
     4260               (input  p-obj-type
     4261               ,input  p-obj-code
     4262               ,input  buf_goods.artic
     4263               ,input  buf_goods.prod-type
     4264               ,input  buf_goods.prod-code
     4265               ,input  p-fact-order-1  + 0.99
     4266               ,input  p-include-fact-order
     4267               ) .
     4268         for each temp-prt-obj :
     4269             quantity   = quantity + temp-prt-obj.fact-qnty.
     4270         end.
     4271         run prdoclib-clear-temp-prt-obj in this-procedure .
     4272       run factord-to-date in this-procedure
     4273                           (  input  p-fact-order-1  ,
     4274                              output p-fact-date-0     ).
     4275       find first temp-gds-qnty where temp-gds-qnty.day      = p-fact-date-0 no-error .
     4276        if not available temp-gds-qnty then do:
     4277             create temp-gds-qnty.
     4278             assign
     4279               temp-gds-qnty.day      = p-fact-date-0
     4280               temp-gds-qnty.prih     = 0
     4281               temp-gds-qnty.rash     = 0
     4282               temp-gds-qnty.ost      = quantity
     4283               temp-gds-qnty.qnty-day = 0
     4284             .
     4285        end.
     4286        else do:
     4287             assign
     4288               temp-gds-qnty.day      = p-fact-date-0
     4289               temp-gds-qnty.prih     = 0
     4290               temp-gds-qnty.rash     = 0
     4291               temp-gds-qnty.ost      =  temp-gds-qnty.ost + quantity
     4292               temp-gds-qnty.qnty-day = 0
     4293             .
     4294       end.
     4295     run factord-to-date in this-procedure
     4296                         (  input  p-fact-order-2  ,
     4297                            output p-fact-date     ).
     4298      find first temp-gds-qnty where temp-gds-qnty.day      = p-fact-date no-error .
     4299        if not available temp-gds-qnty then do:
     4300             create temp-gds-qnty.
     4301             assign
     4302               temp-gds-qnty.day      = p-fact-date
     4303               temp-gds-qnty.prih     = 0
     4304               temp-gds-qnty.rash     = 0
     4305               temp-gds-qnty.ost      = 0
     4306               temp-gds-qnty.qnty-day = 0
     4307             .
     4308        end.
     4309   assign
     4310     p-prih  = 0
     4311     p-rash  = 0
     4312   .
     4313   define variable i as integer no-undo .
     4314          for each p-doc-line no-lock where
     4315                   p-doc-line.obj-type    = p-obj-type
     4316               and p-doc-line.obj-code    = p-obj-code
     4317               and p-doc-line.artic       = buf_goods.artic
     4318               and p-doc-line.prod-type   = buf_goods.prod-type
     4319               and p-doc-line.prod-code   = buf_goods.prod-code
     4320               and p-doc-line.status_     = 'факт':U
     4321               and p-doc-line.fact-order >= p-fact-order-1
     4322               and p-doc-line.fact-order <= p-fact-order-2 break by integer(p-doc-line.fact-order) :
     4323           case p-doc-line.ext-doc-type:
     4324                when   'ie':U  or
     4325                when   'im':U     then
     4326                  do:
     4327                     assign p-prih   = p-prih  +  p-doc-line.fact-qnty.
     4328                  end.
     4329                 when  'we':U      then if  p-t-sp      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4330                 when  'wm':U       then if  p-t-sppv    then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4331                 when  'em':U       then if  p-t-sppv-2  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4332                 when  'ev':U      then if  p-t-sppv-3  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4333                 when  'rv':U  then if  p-t-sppv-4  then assign p-rash = p-rash   -  p-doc-line.fact-qnty.
     4334                 when  'ee':U      then if  p-t-rv      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4335                 when  're':U  then if  p-t-rvz     then assign p-rash   = p-rash  -  p-doc-line.fact-qnty.
     4336                 when  'es':U     then if p-t-rvc  then assign p-rash  = p-rash  +  p-doc-line.fact-qnty.
     4337                 when  'rs':U then if p-t-rvzc then assign p-rash  = p-rash  -  p-doc-line.fact-qnty.
     4338             end case.
     4339             assign
     4340               p-rash  = p-rash
     4341             .
     4342             if last-of(integer(p-doc-line.fact-order)) then do:
     4343               run factord-to-date in this-procedure (  input  p-doc-line.fact-order  ,
     4344                                      output p-fact-date-2   ).
     4345                   find first temp-gds-qnty where temp-gds-qnty.day      = p-fact-date-2 no-error .
     4346                   if not available temp-gds-qnty then do:
     4347                       create temp-gds-qnty.
     4348                       assign
     4349                         temp-gds-qnty.day      = p-fact-date-2
     4350                         temp-gds-qnty.prih     = p-prih
     4351                         temp-gds-qnty.rash     = p-rash
     4352                         temp-gds-qnty.ost      = 0
     4353                         temp-gds-qnty.qnty-day = 0
     4354                       .
     4355                   end.
     4356                   else do:
     4357                       assign
     4358                         temp-gds-qnty.prih     = temp-gds-qnty.prih + p-prih
     4359                         temp-gds-qnty.rash     = temp-gds-qnty.rash + p-rash
     4360                         temp-gds-qnty.ost      = temp-gds-qnty.ost
     4361                         temp-gds-qnty.qnty-day = 0
     4362                       .
     4363                   end.
     4364                   if temp-gds-qnty.rash <> 0  and
     4365                      p-fact-date-2 + 1  <  p-fact-date then  do:
     4366                      find first temp-gds-qnty where
     4367                                 temp-gds-qnty.day      = p-fact-date-2 + 1 no-error .
     4368                       if not available temp-gds-qnty then do:
     4369                           create temp-gds-qnty.
     4370                           assign
     4371                             temp-gds-qnty.day      = p-fact-date-2 + 1
     4372                             temp-gds-qnty.prih     = 0
     4373                             temp-gds-qnty.rash     = 0
     4374                             temp-gds-qnty.ost      = 0
     4375                             temp-gds-qnty.qnty-day = 0
     4376                           .
     4377                       end.
     4378                    end.
     4379                   assign
     4380                     p-prih  = 0
     4381                     p-rash  = 0
     4382                   .
     4383             end.
     4384       end.
     4385    define variable old-ost as decimal no-undo .
     4386    old-ost = 0 .
     4387    for each temp-gds-qnty break by temp-gds-qnty.day :
     4388       if  temp-gds-qnty.day      <> p-fact-date-0 then do:
     4389                 assign
     4390                    temp-gds-qnty.ost    = old-ost +    temp-gds-qnty.prih  - temp-gds-qnty.rash
     4391                 .
     4392                 end.
     4393       assign
     4394         old-ost = temp-gds-qnty.ost
     4395       .
     4396    end.
     4397    end.
     4398   end procedure.
     4399   procedure qnty-lib-2 :
     4400    do
     4401    on error undo, return error return-value
     4402    :
     4403   define variable p-fact-date-3 as date no-undo .
     4404   define variable old-day as date no-undo .
     4405   run factord-to-date in this-procedure (  input  qnty-lib-v-fact-order-2  ,
     4406                          output p-fact-date-3   ).
     4407    old-day = p-fact-date-3 + 1.
     4408    for each temp-gds-qnty break by temp-gds-qnty.day DESCENDING :
     4409       assign
     4410         temp-gds-qnty.qnty-day  =  old-day - temp-gds-qnty.day
     4411         old-day = temp-gds-qnty.day
     4412       .
     4413    end .
     4414    end.
     4415   end procedure.
