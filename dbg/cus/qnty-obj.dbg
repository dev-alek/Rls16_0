     4636   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4637   procedure ob-line  :
     4638   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     4639   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     4640   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     4641   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     4642   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     4643   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     4644   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     4645   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     4646   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     4647   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     4648   define input  parameter xtog-obj         as   logical no-undo.
     4649   define input  parameter xtog-prn         as   logical no-undo.
     4650   define output parameter p-prih  as decimal no-undo .
     4651   define output parameter p-rash  as decimal no-undo .
     4652   define output parameter p-kassa as decimal no-undo .
     4653   define buffer p-doc-line for ub.doc-line.
     4654   define buffer p-gds-dtl  for ub.gds-dtl.
     4655   define variable p-doc-type as character no-undo .
     4656   define variable str-doc-type as character no-undo .
     4657   str-doc-type =
     4658   'ie':U      + "," +
     4659   'im':U     + "," +
     4660   'we':U      + "," +
     4661   'wm':U       + "," +
     4662   'em':U       + "," +
     4663   'ev':U      + "," +
     4664   'rv':U  + "," +
     4665   'ee':U      + "," +
     4666   're':U  + "," +
     4667   'es':U + "," +
     4668   'rs':U .
     4669   assign
     4670     p-prih  = 0
     4671     p-rash  = 0
     4672     p-kassa = 0
     4673   .
     4674   define variable i as integer no-undo .
     4675   define variable v-nn as integer   no-undo .
     4676   v-nn = num-entries( str-doc-type ) .
     4677     repeat i = 1 to v-nn :
     4678       p-doc-type = entry( i, str-doc-type) .
     4679          for each p-doc-line where
     4680                   p-doc-line.obj-type    = x-store-type
     4681               and p-doc-line.obj-code    = x-store-code
     4682               and p-doc-line.artic       = x-artic
     4683               and p-doc-line.prod-type   = x-prod-type
     4684               and p-doc-line.prod-code   = x-prod-code
     4685               and p-doc-line.ext-doc-type = p-doc-type
     4686               and p-doc-line.status_     = 'факт':U
     4687               and p-doc-line.fact-order >= x-fact-order-1
     4688               and p-doc-line.fact-order <= x-fact-order-2 no-lock :
     4689           case p-doc-line.ext-doc-type:
     4690                when   'ie':U  or
     4691                when   'im':U     then
     4692                  do:
     4693                  assign p-prih   = p-prih  +  p-doc-line.fact-qnty.
     4694                  end.
     4695                 when  'we':U      then if  p-t-sp      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4696                 when  'wm':U       then if  p-t-sppv    then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4697                 when  'em':U       then if  p-t-sppv-2  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4698                 when  'ev':U      then if  p-t-sppv-3  then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4699                 when  'rv':U  then if  p-t-sppv-4  then assign p-rash = p-rash   -  p-doc-line.fact-qnty.
     4700                 when  'ee':U      then if  p-t-rv      then assign p-rash = p-rash   +  p-doc-line.fact-qnty.
     4701                 when  're':U  then if  p-t-rvz     then assign p-rash = p-rash   -  p-doc-line.fact-qnty.
     4702                 when  'es':U     then if p-t-rvc  then assign p-kassa  = p-kassa  +  p-doc-line.fact-qnty.
     4703                 when  'rs':U then if p-t-rvzc then assign p-kassa  = p-kassa  -  p-doc-line.fact-qnty.
     4704             end case.
     4705             if xtog-prn then
     4706             for each p-gds-dtl where p-gds-dtl.doc-code  = p-doc-line.doc-code  and
     4707                                      p-gds-dtl.artic     = p-doc-line.artic     and
     4708                                      p-gds-dtl.prod-type = p-doc-line.prod-type and
     4709                                      p-gds-dtl.prod-code = p-doc-line.prod-code no-lock  :
     4710                 find first tmp#zakaz-prn where tmp#zakaz-prn.artic     = p-gds-dtl.artic     and
     4711                                                tmp#zakaz-prn.prod-type = p-gds-dtl.prod-type and
     4712                                                tmp#zakaz-prn.prod-code = p-gds-dtl.prod-code and
     4713                                                tmp#zakaz-prn.obj-type  = p-gds-dtl.obj-type  and
     4714                                                tmp#zakaz-prn.obj-code  = p-gds-dtl.obj-code  and
     4715                                                tmp#zakaz-prn.prt-code  = p-gds-dtl.prt-code  no-lock no-error .
     4716                 if not available tmp#zakaz-prn then do :
     4717                   create tmp#zakaz-prn.
     4718                   assign
     4719                      tmp#zakaz-prn.artic     = p-gds-dtl.artic
     4720                      tmp#zakaz-prn.prod-type = p-gds-dtl.prod-type
     4721                      tmp#zakaz-prn.prod-code = p-gds-dtl.prod-code
     4722                      tmp#zakaz-prn.obj-type  = p-gds-dtl.obj-type
     4723                      tmp#zakaz-prn.obj-code  = p-gds-dtl.obj-code
     4724                      tmp#zakaz-prn.prt-code  = p-gds-dtl.prt-code
     4725                   .
     4726       end.
     4727                 case p-doc-line.ext-doc-type:
