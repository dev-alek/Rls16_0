      866   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      867   procedure thbjattr_code :
      868      define input  parameter p-upper-code     as character no-undo .
      869      define input  parameter p-code           as character no-undo .
      870      define output parameter p-label          as character no-undo .
      871      define output parameter p-user-can-edit  as logical   no-undo .
      872      define output parameter p-output-display as logical   no-undo .
      873      define output parameter p-other          as character no-undo .
      874      define output parameter p-prop-list      as character no-undo .
      875      define output parameter p-prop-type-list as character no-undo .
      876      define output parameter p-prop-label-list as character no-undo .
      877      define output parameter p-global          as logical no-undo .
      878      define output parameter p-host           as logical no-undo .
      879      define output parameter p-shop           as logical no-undo .
      880      define output parameter p-store          as logical no-undo .
      881      define output parameter p-db             as logical no-undo .
      882      define variable p-region as logical no-undo.
      883      run thbjattr_code_reg in this-procedure (
      884                                               p-upper-code,
      885                                               p-code,
      886                                               output p-label,
      887                                               output p-user-can-edit,
      888                                               output p-output-display,
      889                                               output p-other,
      890                                               output p-prop-list,
      891                                               output p-prop-type-list,
      892                                               output p-prop-label-list,
      893                                               output p-global,
      894                                               output p-host,
      895                                               output p-shop,
      896                                               output p-store,
      897                                               output p-db,
      898                                               output p-region
      899                                               ).
      900   end procedure.
      901   procedure thbjattr_code_reg :
      902   define input  parameter p-upper-code     as character no-undo .
      903   define input  parameter p-code           as character no-undo .
      904   define output parameter p-label          as character no-undo .
      905   define output parameter p-user-can-edit  as logical   no-undo .
      906   define output parameter p-output-display as logical   no-undo .
      907   define output parameter p-other          as character no-undo .
      908   define output parameter p-prop-list      as character no-undo .
      909   define output parameter p-prop-type-list as character no-undo .
      910   define output parameter p-prop-label-list as character no-undo .
      911   define output parameter p-global          as logical no-undo .
      912   define output parameter p-host           as logical no-undo .
      913   define output parameter p-shop           as logical no-undo .
      914   define output parameter p-store          as logical no-undo .
      915   define output parameter p-db             as logical no-undo .
      916   define output parameter p-region         as logical no-undo .
      917   do
      918   on error undo, return error return-value
      919   :
      920       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      921       (input  p-upper-code
      922       ,input  p-code
      923       ,output p-label
      924       ,output p-user-can-edit
      925       ,output p-output-display
      926       ,output p-other
      927       ,output p-prop-list
      928       ,output p-prop-type-list
      929       ,output p-prop-label-list
