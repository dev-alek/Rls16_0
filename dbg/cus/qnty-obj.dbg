     2435   procedure prdoclib-clear-temp-prt-obj :
     2436     define buffer buf_temp-prt-obj for temp-prt-obj .
     2437     do
     2438     on error undo, return error return-value
     2439     :
     2440       for each buf_temp-prt-obj
     2441       on error undo, return error return-value
     2442       :
     2443         delete buf_temp-prt-obj .
     2444       end.
     2445     end.
     2446   end procedure.
     2447   procedure prdoclib-create-temp-prt-obj :
     2448     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2449     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2450     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2451     define buffer buf_gds-prt for ub.gds-prt .
     2452     do
     2453     on error undo, return error return-value
     2454     :
     2455       find first buf_temp-prt-obj
     2456         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2457         no-error .
     2458       if not available buf_temp-prt-obj
     2459       then do:
     2460         create buf_temp-prt-obj .
     2461         assign
     2462           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2463           buf_temp-prt-obj.price-sale       = ?
     2464           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2465           buf_temp-prt-obj.price-list-qnty  = ?
     2466           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2467           buf_temp-prt-obj.price-list-recid = ?
     2468         .
     2469         find first buf_gds-prt no-lock
     2470           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2471           .
     2472         assign
     2473           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2474         .
     2475         if buf_temp-prt-obj.is-term
     2476         then do:
     2477           assign
     2478             buf_temp-prt-obj.price-sale = p-root-price-sale
     2479           .
     2480         end.
     2481       end.
     2482     end.
     2483   end procedure.
     2484   procedure prdoclib-temp-prt-obj-by-prt-root :
     2485     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     2486     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2487     define buffer buf_gds-prt for ub.gds-prt .
     2488     do
     2489     on error undo, return error return-value
     2490     :
     2491       find first buf_temp-prt-obj
     2492         where buf_temp-prt-obj.prt-code = p-prt-code
     2493         no-error .
     2494       if not available buf_temp-prt-obj
     2495       then do:
     2496         create buf_temp-prt-obj .
     2497         assign
     2498           buf_temp-prt-obj.prt-code         = p-prt-code
     2499           buf_temp-prt-obj.price-sale       = ?
     2500           buf_temp-prt-obj.fact-qnty        = 0
     2501           buf_temp-prt-obj.price-list-qnty  = ?
     2502           buf_temp-prt-obj.prt-obj-recid    = ?
     2503           buf_temp-prt-obj.price-list-recid = ?
     2504         .
     2505         find first buf_gds-prt no-lock
     2506           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2507           .
     2508         assign
     2509           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2510         .
     2511         if buf_temp-prt-obj.is-term
     2512         then do:
     2513           assign
     2514             buf_temp-prt-obj.price-sale = 0
     2515           .
     2516         end.
     2517       end.
     2518     end.
     2519   end procedure.
     2520   procedure prdoclib-init-temp-prt-obj :
     2521     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2522     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2523     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2524     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2525     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2526     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2527     define buffer buf_prt-obj      for ub.prt-obj .
     2528     define buffer buf_temp-prt-obj for temp-prt-obj .
     2529     do
     2530     on error undo, return error return-value
     2531     :
     2532       run prdoclib-clear-temp-prt-obj in this-procedure .
     2533       for each buf_prt-obj
     2534         where buf_prt-obj.obj-type  = p-obj-type
     2535           and buf_prt-obj.obj-code  = p-obj-code
     2536           and buf_prt-obj.artic     = p-artic
     2537           and buf_prt-obj.prod-type = p-prod-type
     2538           and buf_prt-obj.prod-code = p-prod-code
     2539       on error undo, return error return-value
     2540       :
     2541         run prdoclib-create-temp-prt-obj in this-procedure
     2542           (input  p-root-price-sale
     2543           ,buffer buf_prt-obj
     2544           ,buffer buf_temp-prt-obj
     2545           ).
     2546       end.
     2547     end.
     2548   end procedure.
     2549   procedure prdoclib-calc-fact-sale :
     2550     define input  parameter p-price-list-recid   as recid     no-undo .
     2551     define output parameter p-fact-qnty          as decimal   no-undo .
     2552     define output parameter p-cur-base           as decimal   no-undo .
     2553     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2554     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2555     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2556     define output parameter p-cur-excise-base    as decimal   no-undo .
     2557     define buffer buf_main_price-list for ub.price-list .
     2558     define buffer buf_price-list      for ub.price-list .
     2559     define buffer buf_goods           for ub.goods .
     2560     define buffer buf_gds-obj         for ub.gds-obj .
     2561     define buffer buf_bar-code        for ub.bar-code .
     2562     define variable l-empty-scale   as logical   no-undo .
     2563     do
     2564     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     2565     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2566     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2567     :
     2568       find first buf_main_price-list no-lock
     2569         where recid(buf_main_price-list) = p-price-list-recid
     2570         no-error .
     2571       if not available buf_main_price-list
     2572       then do:
     2573         message
     2574           vss-workfile vss-revision vss-description skip
     2575           vss-include-info13 skip
     2576           "Ошибка задания входных параметров" skip
     2577           "Не найдена строка переоценки" skip
     2578           "Код записи (recid)" p-price-list-recid skip
     2579           view-as alert-box error .
     2580         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2581       end.
     2582       if buf_main_price-list.main-price <> true
     2583       then do:
     2584         message
     2585           vss-workfile vss-revision vss-description skip
     2586           vss-include-info13 skip
     2587           "Ошибка задания входных параметров" skip
     2588           "Строка переоценки не является основной" skip
     2589           "Код записи (recid)" p-price-list-recid skip
     2590           "Переоценка" buf_main_price-list.doc-num skip
     2591           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2592           "Бар-код" buf_main_price-list.b-code skip
     2593           view-as alert-box error .
     2594         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2595       end.
