     1804   procedure normobr_invers-erf :
     1805     define input  parameter p-x     as decimal   no-undo .
     1806     define output parameter p-value as decimal   no-undo .
     1807     define variable vss-description as character no-undo init "normobr_invers-erf-01: Обратная функция Erf".
     1808     do
     1809     on error undo, return error return-value
     1810     :
     1811       if p-x = ?
     1812       or p-x > 1
     1813       or p-x < -1
     1814       then do:
     1815         message
     1816           vss-workfile vss-revision vss-description skip
     1817           vss-include-info12 skip
     1818           "Ошибка задания входных параметров" skip
     1819           "p-x" p-x skip
     1820           view-as alert-box error .
     1821         undo, return error .
     1822       end.
     1823       define variable p-x-power2  as decimal   no-undo .
     1824       define variable p-x-power4  as decimal   no-undo .
     1825       define variable p-x-power8  as decimal   no-undo .
     1826       define variable p-x-power16 as decimal   no-undo .
     1827       assign
     1828         p-x-power2  = p-x * p-x
     1829         p-x-power4  = p-x-power2 * p-x-power2
     1830         p-x-power8  = p-x-power4 * p-x-power4
     1831         p-x-power16 = p-x-power8 * p-x-power8
     1832       .
     1833       assign
     1834         p-value = 08862269254.5275790 * p-x
     1835                 + 02320136665.3465444 * p-x * p-x-power2
     1836                 + 01275561753.0559793 * p-x * p-x-power4
     1837                 + 00865521292.4154752 * p-x * p-x-power2 * p-x-power4
     1838                 + 00649596177.4538540 * p-x * p-x-power8
     1839                 + 00517312819.8461636 * p-x * p-x-power2 * p-x-power8
     1840                 + 00428367206.5179733 * p-x * p-x-power4 * p-x-power8
     1841                 + 00364659293.0853162 * p-x * p-x-power2 * p-x-power4 * p-x-power8
     1842                 + 00316890050.2160544 * p-x * p-x-power16
     1843                 + 00279806329.6499521 * p-x * p-x-power2 * p-x-power16
     1844                 + 00250222758.4119834 * p-x * p-x-power4 * p-x-power16
     1845                 + 00226098633.1889757 * p-x * p-x-power2 * p-x-power4 * p-x-power16
     1846                 + 00206067803.7905899 * p-x * p-x-power8 * p-x-power16
     1847       .
     1848       assign
     1849         p-value = p-value / 10000000000
     1850       .
     1851     end.
     1852   end procedure.
     1853   procedure normobr :
     1854     define input  parameter p-p     as decimal   no-undo .
     1855     define input  parameter p-m     as decimal   no-undo .
     1856     define input  parameter p-sigma as decimal   no-undo .
     1857     define output parameter p-x     as decimal   no-undo .
     1858     define variable vss-description as character no-undo init "normobr-01: Обратная функция нормального распределения".
     1859     do
     1860     on error undo, return error return-value
     1861     :
     1862       if p-p > 1
     1863       or p-p < 0
     1864       or p-p = ?
     1865       then do:
     1866         message
     1867           vss-workfile vss-revision vss-description skip
     1868           vss-include-info12 skip
     1869           "Ошибка задания входных параметров" skip
     1870           "Неверные значения парметра p-p  " skip
     1871           "Он не может быть больше нуля и меньше единицы" skip
     1872           "p-p (- уровень постоянного присутствия)              " p-p skip
     1873           "p-m (Темп продаж )                                   " p-m skip
     1874           "p-sigma (среднеквадратичное отклонение Темпа продаж) " p-sigma skip
     1875           view-as alert-box error .
     1876         undo, return error .
     1877       end.
     1878       if p-m = ?
     1879       then do:
     1880         message
     1881           vss-workfile vss-revision vss-description skip
     1882           vss-include-info12 skip
     1883           "Ошибка задания входных параметров" skip
     1884           "Не задано значение парметра p-m" skip
     1885           "p-p (- уровень постоянного присутствия)              " p-p skip
     1886           "p-m (Темп продаж )                                   " p-m skip
     1887           "p-sigma (среднеквадратичное отклонение Темпа продаж) " p-sigma skip
     1888           view-as alert-box error .
     1889         undo, return error .
     1890       end.
     1891       if p-sigma = ?
     1892       then do:
     1893         message
     1894           vss-workfile vss-revision vss-description skip
     1895           vss-include-info12 skip
     1896           "Ошибка задания входных параметров" skip
     1897           "Не задано значение парметра p-sigma" skip
     1898           "p-p (- уровень постоянного присутствия)              " p-p skip
     1899           "p-m (Темп продаж )                                   " p-m skip
     1900           "p-sigma (среднеквадратичное отклонение Темпа продаж) " p-sigma skip
     1901           view-as alert-box error .
     1902         undo, return error .
     1903       end.
     1904       define variable v-inverse-erf as decimal   no-undo .
     1905       run normobr_invers-erf in this-procedure
     1906         (input  1 - 2 * p-p
     1907         ,output v-inverse-erf
     1908         ) no-error .
     1909       if error-status :error then do:
     1910         message
     1911           vss-workfile vss-revision vss-description skip
     1912           "Ошибка при вызове функции normobr_invers-erf" skip
     1913           "p-p (- уровень постоянного присутствия)              " p-p skip
     1914           "p-m (Темп продаж )                                   " p-m skip
     1915           "p-sigma (среднеквадратичное отклонение Темпа продаж) " p-sigma skip
     1916           error-status :get-message(1) skip
     1917           return-value skip
     1918           view-as alert-box error .
     1919         undo, return error .
     1920       end.
     1921       assign
     1922         p-x = p-m - 1.4142135623730950488 * p-Sigma * v-inverse-erf
     1923       .
     1924     end.
     1925   end procedure.
     1926   procedure normobr_test :
     1927     do
     1928     on error undo, return error return-value
