     2807               "Переоценка" buf_price-list.doc-num skip
     2808               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2809               "Бар-код" buf_price-list.b-code skip
     2810               view-as alert-box error .
