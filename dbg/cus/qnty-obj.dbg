       74   define new global shared variable g#vssrevis-logger as handle    no-undo .
       75   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       76   define variable v-vssrevis-logger                   as handle    no-undo .
       77   procedure vss-logevent :
       78     define input  parameter p-extra-paramters as character no-undo .
       79     define variable v-vssrevis-parameters as character no-undo .
       80     do
       81     on error undo, return error return-value
       82     :
       83       if  valid-handle(v-vssrevis-logger)
       84       and v-vssrevis-logger :get-signature("logevent") <> ""
       85       then do:
       86         run vss-get-parameters in this-procedure
       87           (output v-vssrevis-parameters
       88           ).
       89         run logevent in v-vssrevis-logger
       90           (input vss-workfile
       91           ,input vss-revision
       92           ,input v-vssrevis-parameters
       93           ,input p-extra-paramters
       94           ).
       95       end.
       96     end.
       97   end procedure.
       98   assign
       99     v-vssrevis-logger = g#vssrevis-logger
