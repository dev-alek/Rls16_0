     1790       end.
     1791      run display-line in this-procedure .
     1792      if last-of( temp-gds-list.grp-name ) then do:
     1793         s-bar-code = "Итого по " .
     1794         gds-zap-artic = substring(str,1,16) .
     1795         gds-zap-gds-name = substring(str,17,250) .
     1796         run display-b1 in this-procedure .
     1797         run clear-b1 in this-procedure .
     1798         run clear-b2 in this-procedure .
     1799      end.
     1800     end.
     1801      end.
     1802                     when 3 then do:
     1803       define buffer buf_obj-list22 for obj-list.
     1804     for each buf_obj-list22 no-lock :
     1805         if xtog-obj and  not (buf_obj-list22.obj-type = x-store-type  and
     1806                               buf_obj-list22.obj-code = x-store-code )
     1807         then next.
     1808           for  each gds-obj   where
     1809                     gds-obj.obj-type = buf_obj-list22.obj-type    and
     1810                     gds-obj.obj-code = buf_obj-list22.obj-code
     1811                     and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1812                       no-lock ,
     1813           first g#cli
     1814                 where    g#cli.obj-code = gds-obj.prod-code
     1815                 and      g#cli.obj-type = gds-obj.prod-type
     1816                          no-lock ,
     1817           first goods where goods.gds-code = gds-obj.gds-code
     1818                               no-lock :
     1819               if not can-find ( first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1820                   create temp-gds-list.
     1821                   assign
     1822                     temp-gds-list.prod-code = gds-obj.prod-code
     1823                     temp-gds-list.grp-name  = ""
     1824                     temp-gds-list.gds-code  = gds-obj.gds-code
     1825                     temp-gds-list.artic     = gds-obj.artic
     1826                     temp-gds-list.gds-name  = goods.gds-name
     1827                     .
     1828                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     1829                     .
     1830               end.
     1831           end.
     1832    end.
     1833     for each temp-gds-list no-lock
     1834       , first goods     where goods.gds-code     = temp-gds-list.gds-code no-lock
     1835         break
     1836           by  temp-gds-list.grp-name
     1837           by temp-gds-list.artic :
     1838           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     1839   find clients where clients.obj-type = goods.prod-type and
     1840                      clients.obj-code = goods.prod-code no-lock .
     1841     assign
     1842         gds-zap-unit-base  = goods.unit-base
     1843         gds-zap-prt-root   = goods.prt-root
     1844         gds-zap-prod-type  = goods.prod-type
     1845         gds-zap-prod-code  = goods.prod-code
     1846         gds-zap-artic      = goods.artic
     1847         gds-zap-type       = goods.gds-type
     1848         gds-zap-grp-name   = goods.grp-name
     1849         gds-zap-b-code     = goods.gds-code
     1850         gds-zap-prod-name  = clients.obj-name .
     1851     if g#gds-engl then
     1852         assign gds-zap-gds-name = goods.engl-name.
     1853     else
     1854         assign gds-zap-gds-name = goods.gds-name.
     1855   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1856     (input  gds-zap-b-code
     1857     ,input  ?
     1858     ,output v-bar-code
     1859     )  .
     1860     s-bar-code = string (v-bar-code,"999999999").
     1861     run foreach in this-procedure .
     1862       if  first-of ( temp-gds-list.grp-name )  then do:
     1863           fr = true .
     1864           l-stroka = "ГРУППА : " + str .
     1865           temp-str = l-stroka.
     1866       end.
     1867      run display-line in this-procedure .
     1868      if last-of( temp-gds-list.grp-name ) then do:
     1869         s-bar-code = "Итого по " .
     1870         gds-zap-artic = substring(str,1,16) .
     1871         gds-zap-gds-name = substring(str,17,250) .
     1872         run display-b1 in this-procedure .
     1873         run clear-b1 in this-procedure .
     1874         run clear-b2 in this-procedure .
     1875      end.
     1876     end.
     1877      end.
     1878                     otherwise do:
     1879       define buffer buf_obj-list23 for obj-list.
     1880     for each buf_obj-list23 no-lock :
     1881         if xtog-obj and  not (buf_obj-list23.obj-type = x-store-type  and
     1882                               buf_obj-list23.obj-code = x-store-code )
     1883         then next.
     1884           for  each gds-obj   where
     1885                               gds-obj.obj-type = buf_obj-list23.obj-type    and
     1886                               gds-obj.obj-code = buf_obj-list23.obj-code
     1887                               and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1888                               no-lock ,
     1889           first gds-list where gds-obj.gds-code  = gds-list.gds-code
     1890                               no-lock :
     1891               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1892                   create temp-gds-list.
     1893                   assign
     1894                     temp-gds-list.prod-code = gds-obj.prod-code
     1895                     temp-gds-list.grp-name  = ""
     1896                     temp-gds-list.gds-code  = gds-obj.gds-code
     1897                     temp-gds-list.artic     = gds-obj.artic
     1898                     temp-gds-list.gds-name  = gds-list.gds-name
     1899                     .
     1900                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     1901                     .
     1902               end.
     1903           end.
     1904    end.
     1905     for each temp-gds-list no-lock
     1906       , first gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     1907         break
     1908           by  temp-gds-list.grp-name
     1909           by gds-list.artic :
     1910           str = n-lavel(input gds-list.grp-name, input xlavel ) no-error .
     1911   find clients where clients.obj-type = gds-list.prod-type and
     1912                      clients.obj-code = gds-list.prod-code no-lock .
     1913     assign
     1914         gds-zap-unit-base  = gds-list.unit-base
     1915         gds-zap-prt-root   = gds-list.prt-root
     1916         gds-zap-prod-type  = gds-list.prod-type
     1917         gds-zap-prod-code  = gds-list.prod-code
     1918         gds-zap-artic      = gds-list.artic
     1919         gds-zap-type       = gds-list.gds-type
     1920         gds-zap-grp-name   = gds-list.grp-name
     1921         gds-zap-b-code     = gds-list.gds-code
     1922         gds-zap-prod-name  = clients.obj-name .
     1923     if g#gds-engl then
     1924         assign gds-zap-gds-name = gds-list.engl-name.
     1925     else
     1926         assign gds-zap-gds-name = gds-list.gds-name.
     1927   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1928     (input  gds-zap-b-code
     1929     ,input  ?
     1930     ,output v-bar-code
     1931     )  .
     1932     s-bar-code = string (v-bar-code,"999999999").
     1933     run foreach in this-procedure .
     1934       if  first-of ( temp-gds-list.grp-name )  then do:
     1935           fr = true .
     1936           l-stroka = "ГРУППА : " + str .
     1937           temp-str = l-stroka.
     1938       end.
     1939      run display-line in this-procedure .
     1940      if last-of( temp-gds-list.grp-name ) then do:
     1941         s-bar-code = "Итого по " .
     1942         gds-zap-artic = substring(str,1,16) .
     1943         gds-zap-gds-name = substring(str,17,250) .
     1944         run display-b1 in this-procedure .
     1945         run clear-b1 in this-procedure .
     1946         run clear-b2 in this-procedure .
     1947      end.
     1948     end.
     1949                     end.
     1950                 end case.
     1951      end procedure.
     1952   procedure ost-line :
     1953     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1954     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1955     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1956     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1957     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1958     define input  parameter x-tog-shift  as logical no-undo .
     1959     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1960     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1961     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1962     define input  parameter xtog-obj     as logical no-undo .
     1963     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1964     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1965     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1966     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1967     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1968     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1969     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1970     define buffer buff-obj-list  for obj-list .
     1971     define buffer buff-stk-line  for ub.stk-line .
     1972     assign
     1973       Quantity = 0
     1974       Coast_R  = 0
     1975       Coast_V  = 0
     1976       VAT_R    = 0
     1977       VAT_V    = 0
     1978       SLT_R    = 0
     1979       SLT_V    = 0
     1980     .
     1981     if  x-tog-shift = false then do:
     1982       for each buff-obj-list no-lock
     1983         where xtog-obj = false
     1984            or (buff-obj-list.obj-type = x-store-type
     1985               and buff-obj-list.obj-code = x-store-code
     1986               )
     1987       on error undo, return error
     1988       :
     1989       find last buff-stk-line no-lock
     1990         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1991           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1992           and buff-stk-line.artic      = x-artic
     1993           and buff-stk-line.prod-type  = x-prod-type
     1994           and buff-stk-line.prod-code  = x-prod-code
     1995           and buff-stk-line.sum-type   = x-sum-type
     1996           and buff-stk-line.cat-id     = '##,##':U
     1997           and buff-stk-line.fact-order <= x-fact-order
     1998           and buff-stk-line.shift-num  = 0
     1999         use-index category
     2000         no-error .
     2001       if available buff-stk-line then do:
     2002         assign
     2003           Quantity = Quantity + buff-stk-line.fact-qnty
     2004           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2005           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2006           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2007           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2008           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2009           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2010         .
     2011       end.
     2012      end.
     2013     end.
     2014     else do:
     2015       for each buff-obj-list no-lock
     2016         where xtog-obj = false
     2017            or (buff-obj-list.obj-type = x-store-type
     2018               and buff-obj-list.obj-code = x-store-code
     2019               )
     2020       on error undo, return error
     2021       :
     2022         find last buff-stk-line no-lock
     2023           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2024             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2025             and buff-stk-line.artic      = x-artic
     2026             and buff-stk-line.prod-type  = x-prod-type
     2027             and buff-stk-line.prod-code  = x-prod-code
     2028             and buff-stk-line.sum-type   = x-sum-type
     2029             and buff-stk-line.cat-id     = '##,##':U
     2030             and buff-stk-line.fact-order <= x-fact-order
     2031             and buff-stk-line.shift-num  > 0
     2032           use-index category
     2033           no-error .
     2034         if available buff-stk-line then do:
     2035           assign
     2036             Quantity = Quantity +  buff-stk-line.fact-qnty
     2037             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2038             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2039             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2040             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2041             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2042             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2043           .
     2044         end.
     2045       end.
     2046     end.
     2047   end procedure.
     2048   procedure ost-lineother-tax :
     2049     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2050     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2051     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2052     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2053     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2054     define input  parameter x-tog-shift  as logical no-undo .
     2055     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2056     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2057     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2058     define input  parameter xTog-obj     as logical no-undo .
     2059     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2060     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2061     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2062     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2063     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2064     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2065     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2066     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2067     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2068     define buffer buff-obj-list  for obj-list .
     2069     define buffer buff-stk-line  for ub.stk-line .
     2070     assign
     2071       Quantity = 0
     2072       Coast_R  = 0
     2073       Coast_V  = 0
     2074       VAT_R    = 0
     2075       VAT_V    = 0
     2076       SLT_R    = 0
     2077       SLT_V    = 0
     2078       other_R  = 0
     2079       other_V  = 0
     2080     .
     2081     if  x-tog-shift = false then do:
     2082       for each buff-obj-list no-lock
     2083         where xtog-obj = false
     2084            or (buff-obj-list.obj-type = x-store-type
     2085               and buff-obj-list.obj-code = x-store-code
     2086               )
     2087       on error undo, return error
     2088       :
     2089       find last buff-stk-line no-lock
     2090         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2091           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2092           and buff-stk-line.artic      = x-artic
     2093           and buff-stk-line.prod-type  = x-prod-type
     2094           and buff-stk-line.prod-code  = x-prod-code
     2095           and buff-stk-line.sum-type   = x-sum-type
     2096           and buff-stk-line.cat-id     = '##,##':U
     2097           and buff-stk-line.fact-order <= x-fact-order
     2098           and buff-stk-line.shift-num  = 0
     2099         use-index category
     2100         no-error .
     2101       if available buff-stk-line then do:
     2102         assign
     2103           Quantity = Quantity + buff-stk-line.fact-qnty
     2104           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2105           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2106           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2107           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2108           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2109           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2110           other_R  = other_R  + buff-stk-line.other-rubl
     2111           other_V  = other_V  + buff-stk-line.other-base
     2112         .
     2113       end.
     2114    end.
     2115     end.
     2116     else do:
     2117       for each buff-obj-list no-lock
     2118         where xtog-obj = false
     2119            or (buff-obj-list.obj-type = x-store-type
     2120               and buff-obj-list.obj-code = x-store-code
     2121               )
     2122       on error undo, return error
     2123       :
     2124         find last buff-stk-line no-lock
     2125           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2126             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2127             and buff-stk-line.artic      = x-artic
     2128             and buff-stk-line.prod-type  = x-prod-type
     2129             and buff-stk-line.prod-code  = x-prod-code
     2130             and buff-stk-line.sum-type   = x-sum-type
     2131             and buff-stk-line.cat-id     = '##,##':U
     2132             and buff-stk-line.fact-order <= x-fact-order
     2133             and buff-stk-line.shift-num  > 0
     2134           use-index category
     2135           no-error .
     2136         if available buff-stk-line then do:
     2137           assign
     2138             Quantity = Quantity +  buff-stk-line.fact-qnty
     2139             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2140             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2141             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2142             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2143             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2144             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2145             other_R = other_R   +  buff-stk-line.other-rubl
     2146             other_V = other_V   +  buff-stk-line.other-base
     2147           .
     2148         end.
     2149       end.
     2150     end.
     2151   end procedure.
     2152   procedure ost-line-kg :
     2153     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2154     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2155     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2156     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2157     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2158     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2159     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2160     define buffer buff-obj-list  for obj-list .
     2161     define buffer buf_doc-line for ub.doc-line .
     2162     define buffer buf_inv-line for ub.inv-line .
     2163     do
     2164     on error undo, return error
     2165     :
     2166       for each buf_doc-line no-lock where
     2167                buf_doc-line.obj-type    = p-obj-type   and
     2168                buf_doc-line.obj-code    = p-obj-code   and
     2169                buf_doc-line.prod-type   = p-prod-type  and
     2170                buf_doc-line.prod-code   = p-prod-code  and
     2171                buf_doc-line.artic       = p-artic      and
     2172                buf_doc-line.status_     = 'факт':U      and
     2173                buf_doc-line.fact-order <= p-fact-order
     2174             by buf_doc-line.fact-order    descending
     2175       :
     2176         find first buf_inv-line no-lock where
     2177                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2178                    buf_inv-line.artic     = buf_doc-line.artic     and
     2179                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2180                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2181         if available buf_inv-line
     2182         then do:
     2183           if buf_inv-line.after-cli-qnty <> ?
     2184           then do:
     2185             assign
     2186               p-quantity-kg = buf_inv-line.after-cli-qnty
     2187             .
     2188             leave .
     2189           end.
     2190         end.
     2191       end.
     2192       if p-quantity-kg = ?
     2193       then do:
     2194         assign
     2195           p-quantity-kg = 0
     2196         .
     2197       end.
     2198     end.
     2199   end procedure.
     2200   PROCEDURE ostatok :
     2201   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2202   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2203   def input parameter x-tog-shift   as   logical             no-undo.
     2204   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2205   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2206   def input parameter x-shift-start as integer               no-undo.
     2207   def input parameter x-shift-end   as integer               no-undo.
     2208   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2209   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2210   def input parameter xTog-obj   as log no-undo.
     2211   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2212   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2213   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2214   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2215   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2216   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2217   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2218   def var              Fact-orderS   as char  no-undo.
     2219   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2220      Assign
     2221         Fact-order   = 0
     2222         Quantity     = 0
     2223         Coast_R      = 0
     2224         Coast_V      = 0
     2225         VAT_R        = 0
     2226         VAT_V        = 0 .
     2227    x-date-start-t  = x-date-start + 1 .
     2228   IF x-date-end = date('') then DO:
     2229      Fact-order = 0 .
     2230      for each obj-list
     2231          where  ( not xtog-obj or
     2232                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2233                 no-lock :
     2234         if  x-tog-shift = false then do:
     2235                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2236                               ub.stk-tot.Fact-date <=  x-date-start
     2237                               and ub.stk-tot.shift-num = 0
     2238                               USE-INDEX fact-date no-lock no-error .
     2239              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2240         End.
     2241         Else  DO :
     2242             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2243              (ub.stk-tot.shift-date  = x-date-start-t and
     2244               ub.stk-tot.shift-num  < x-shift-start or
     2245               ub.stk-tot.shift-date  < x-date-start-t  )
     2246               and ub.stk-tot.shift-num  > 0
     2247               USE-INDEX Shift-num no-lock no-error .
     2248            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2249           END.
     2250       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2251     End.
     2252   End.
     2253   Else DO:
     2254     For each obj-list  WHERE
     2255        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2256         no-lock :
     2257      IF  x-TOG-Shift = False Then DO:
     2258          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2259               ub.stk-tot.Fact-date <= x-date-end
     2260               and ub.stk-tot.shift-num = 0
     2261               USE-INDEX fact-date no-lock no-error.
     2262          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2263      END.
     2264      Else DO:
     2265           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2266               (ub.stk-tot.shift-date  = x-date-end and
     2267               ub.stk-tot.shift-num  <= x-shift-end or
     2268               ub.stk-tot.shift-date  < x-date-end       ) and
     2269               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2270               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2271       End.
     2272       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2273     End.
     2274   End.
     2275   END PROCEDURE.
     2276   PROCEDURE report-execute :
     2277     If (ValType = 0 and var-report-r-b = 'rubl' )  Or ValType = 1
     2278                                   then   assign tPrintRubl = yes .
     2279                                   else   assign tPrintRubl = no .
     2280     run waitfram-show ( 'Подождите ...' ) .
     2281     output stream OutStream to value( string( session:temp-directory +
     2282                               "rpt" + string( g#report-num ) ) )      .
     2283      run report-exec1.
     2284      Output stream OutStream close.
     2285      run waitfram-hide.
     2286     if Make-Excel then output stream ForExcel close.
     2287     run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     2288   END PROCEDURE.
     2289   PROCEDURE foreach :
     2290   define variable tt# as integer no-undo .
     2291   define buffer buf-obj-list  for obj-list .
     2292    R = R + 1.
     2293   If Integer(25) = 0 Then Temp1  = 100  .
     2294                         Else Temp1 = Integer(25) .
     2295        IF ( R modulo Temp1 = 0 ) AND ( R >= Temp1 ) then
     2296            RUN waitfram-show( "Обработано строк : " + string( R )) .
     2297     run clear-item.
     2298    tt# = 0 .
     2299   define variable gds-zap-b-code-ed as integer no-undo .
     2300      if flag-dop-bc = true then do:
     2301   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2302     (input  gds-zap-b-code
     2303     ,input  ?
     2304     ,output gds-zap-b-code-ed
     2305     )  .
     2306         v-dop-bc = ""   .
     2307           for each ub.prod-bc no-lock where
     2308               ub.prod-bc.b-code = gds-zap-b-code-ed
     2309               on error undo, return error :
     2310               v-dop-bc = v-dop-bc + ub.prod-bc.b-str + chr(44) .
     2311           end.
     2312           v-dop-bc = substring(v-dop-bc, 1 , length(v-dop-bc) - 1 ) .
     2313      end.
     2314   For each  buf-obj-list no-lock :
     2315     run ost-line (  input   buf-obj-list.obj-code ,
     2316                     input   buf-obj-list.obj-type ,
     2317                     INPUT   gds-zap-artic     ,
     2318                     INPUT   gds-zap-prod-code ,
     2319                     INPUT   gds-zap-prod-type ,
     2320                     input   x-tog-shift       ,
     2321                     INPUT   fact-order-2      ,
     2322                     input   type-a       ,
     2323                     input   '##,##':U    ,
     2324                     input   true        ,
     2325                     output  Quantity    ,
     2326                     output  Coast_R     ,
     2327                     output  Coast_V     ,
     2328                     output  VAT_R       ,
     2329                     output  VAT_V       ,
     2330                     output  SLT_R       ,
     2331                     output  SLT_V       ) .
     2332      If not can-find  (tmp#obj-list where
     2333         buf-obj-list.obj-code = tmp#obj-list.obj-code and
     2334         buf-obj-list.obj-type = tmp#obj-list.obj-type  ) then do:
     2335               create tmp#obj-list.
     2336               Assign
     2337                 tmp#obj-list.obj-code = buf-obj-list.obj-code
     2338                 tmp#obj-list.obj-type = buf-obj-list.obj-type .
     2339           End.
     2340     Find first tmp#obj-list where
     2341         buf-obj-list.obj-code = tmp#obj-list.obj-code and
     2342         buf-obj-list.obj-type = tmp#obj-list.obj-type
     2343     share-lock no-error .
     2344     Assign
     2345     tmp#obj-list.ostatok-end [1 + tt#]  = Quantity
     2346     tmp#obj-list.ostatok-end [2 + tt#]  = if tprintrubl then Coast_R else Coast_V
     2347     tmp#obj-list.b1-ostatok-end [1 + tt# ] =  tmp#obj-list.b1-ostatok-end [1 + tt#] + tmp#obj-list.ostatok-end [1 + tt#]
     2348     tmp#obj-list.b1-ostatok-end [2 + tt# ] =  tmp#obj-list.b1-ostatok-end [2 + tt#] + tmp#obj-list.ostatok-end [2 + tt#]
     2349     tmp#obj-list.bi-ostatok-end [1 + tt# ] =  tmp#obj-list.bi-ostatok-end [1 + tt#] + tmp#obj-list.ostatok-end [1 + tt#]
     2350     tmp#obj-list.bi-ostatok-end [2 + tt# ] =  tmp#obj-list.bi-ostatok-end [2 + tt#] + tmp#obj-list.ostatok-end [2 + tt#]
     2351     .
     2352   End.
     2353   END PROCEDURE.
     2354   PROCEDURE display-line :
     2355           IF NOT Sums-Only then DO:
     2356              ii = ii + 1.
     2357              run display-str1.
     2358             End.
     2359     END PROCEDURE.
     2360   PROCEDURE print-header :
     2361   if NOT FirstLine Then  run display-title.
     2362       FirstLine = TRUE .
     2363         run clear-b1 .
     2364         run clear-bi .
     2365         run clear-item.
     2366         break_group = true.
     2367         break_group1 = true.
     2368      END PROCEDURE.
     2369   PROCEDURE Print-Footer :
     2370          gds-zap-artic = "ИТОГО" .
     2371          run display-bi.
     2372          END PROCEDURE.
     2373   PROCEDURE U-LINE :
     2374           END PROCEDURE.
     2375   PROCEDURE P-LINE :
     2376           END PROCEDURE.
     2377   PROCEDURE CalcItog :
     2378       run ostatok (
     2379           input x-store-code  ,
     2380           input x-store-type  , x-TOG-Shift,
     2381           input x-date-start - 1 ,
     2382           input date('')      , x-Shift-Start,x-Shift-End,
     2383           input type-a   ,
     2384           input '##,##':U,
     2385           input xTog-obj ,
     2386           output  Quantity1  ,
     2387           output  Coast_R1   ,
     2388           output  Coast_V1   ,
     2389           output  VAT_R1     ,
     2390           output  VAT_V1     ,
     2391           output  Fact-order-1 ).
     2392       run ostatok (
     2393           input x-store-code  ,
     2394           input x-store-type  ,x-TOG-Shift,
     2395           input x-date-start  ,
     2396           input x-date-end    , x-Shift-Start,x-Shift-End,
     2397           input type-a   ,
     2398           input '##,##':U,
     2399           input xTog-obj ,
     2400           output  Quantity1  ,
     2401           output  Coast_R1   ,
     2402           output  Coast_V1   ,
     2403           output  VAT_R1     ,
     2404           output  VAT_V1     ,
     2405           output  Fact-order-2 ).
     2406             Quantity1  = 0.
     2407             Coast_R1   = 0.
     2408             Coast_V1   = 0.
     2409             VAT_R1     = 0.
     2410             VAT_V1     = 0.
     2411   END PROCEDURE.
     2412   PROCEDURE display-str1  :
     2413              run di ("кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2414   END PROCEDURE.
     2415   PROCEDURE display-Bi  :
     2416      v-dop-bc = ""     .
     2417      run di ("кол-во",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     2418   END PROCEDURE.
     2419   PROCEDURE display-B1  :
     2420      v-dop-bc = ""     .
     2421      run di ("кол-во"  ,1, (s-bar-code + " " + caps( gds-zap-artic + gds-zap-gds-name)), "" ,"","","b1":u).
     2422   END PROCEDURE.
     2423   PROCEDURE Clear-B1  :
     2424    For each tmp#obj-list  :
     2425       REPEAT kk = 1 to 6 :
     2426        tmp#obj-list.b1-ostatok-end    [kk]    = 0
     2427        .
     2428       End.
     2429     End.
     2430    END PROCEDURE.
     2431   PROCEDURE Clear-B2  :
     2432    For each tmp#obj-list :
     2433       REPEAT kk = 1 to 6 :
     2434        tmp#obj-list.b1-ostatok-end    [kk]    = 0
     2435        .
     2436       End.
     2437     End.
     2438   END PROCEDURE.
     2439   PROCEDURE Clear-Bi  :
     2440    For each tmp#obj-list :
     2441       REPEAT kk = 1 to 6 :
     2442        tmp#obj-list.bi-ostatok-end    [kk]    = 0
     2443        .
     2444       End.
     2445     End .
     2446   END PROCEDURE.
     2447   PROCEDURE Display-title :
     2448       i = 0.
     2449       run rep/extitle.p (1) .
     2450   END PROCEDURE.
     2451   PROCEDURE report-exec1  :
     2452      FIND FIRST clients where x-store-type = clients.obj-type AND
     2453                               x-store-code = clients.obj-code no-lock no-error.
     2454              If available clients then  ObjName = clients.obj-name.
     2455                                            else  ObjName="объект не определен".
     2456     run calcitog.
     2457     run print-header.
     2458      CASE RetClassify :
     2459       when "grp-goods":u    then            run run2.
     2460       otherwise do:
     2461         message "Ошибка вызова!" view-as alert-box error .
     2462       end.
     2463      end case.
     2464      run print-footer.
     2465     END PROCEDURE.
     2466   PROCEDURE Clear-item :
     2467    For each tmp#obj-list :
     2468       REPEAT kk = 1 to 6 :
     2469        ostatok-end                                     [kk]    = 0
     2470        .
     2471       End.
     2472     End.
     2473    END PROCEDURE.
     2474   PROCEDURE Item-Goods :
     2475    define input parameter  par-3 as character  no-undo.
     2476    define input parameter  par-4 as character  no-undo.
     2477         if par-4 = "goods":U  Then DO:
     2478             FIND FIRST clients WHERE clients.obj-type = Goods.prod-type AND
     2479                                 clients.obj-code = Goods.prod-code use-index pi NO-LOCK .
     2480                                   assign
     2481                                       gds-zap-unit-base  = Goods.unit-base
     2482                                       gds-zap-prt-root   = Goods.prt-root
     2483                                       gds-zap-prod-type  = Goods.prod-type
     2484                                       gds-zap-prod-code  = Goods.prod-code
     2485                                       gds-zap-artic      = Goods.artic
     2486                                       gds-zap-grp-name   = Goods.grp-name
     2487                                       gds-zap-b-code     = Goods.gds-code
     2488                                       gds-zap-prod-name  = clients.obj-name .
     2489                                   if g#gds-engl then
     2490                                       assign gds-zap-gds-name = Goods.engl-name.
     2491                                   else
     2492                                       assign gds-zap-gds-name = Goods.gds-name.
     2493                               End.
     2494        if par-4 = "gds-list":U  Then DO:
     2495             FIND FIRST clients WHERE clients.obj-type = gds-list.prod-type AND
     2496                                 clients.obj-code = gds-list.prod-code use-index pi NO-LOCK .
     2497                                   assign
     2498                                       gds-zap-unit-base  = gds-list.unit-base
     2499                                       gds-zap-prt-root   = gds-list.prt-root
     2500                                       gds-zap-prod-type  = gds-list.prod-type
     2501                                       gds-zap-prod-code  = gds-list.prod-code
     2502                                       gds-zap-artic      = gds-list.artic
     2503                                       gds-zap-grp-name   = gds-list.grp-name
     2504                                       gds-zap-b-code     = gds-list.gds-code
     2505                                       gds-zap-prod-name  = clients.obj-name .
     2506                                   if g#gds-engl then
     2507                                       assign gds-zap-gds-name = gds-list.engl-name.
     2508                                   else
     2509                                       assign gds-zap-gds-name = gds-list.gds-name.
     2510                               End.
     2511      run foreach.
     2512       If  break_group = true  and par-3 <> "1"  then DO :
     2513            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     2514            gds-zap-prod-name  = clients.obj-name.
     2515             If break_group1 = true  THEN  DO :
     2516               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     2517                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     2518                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     2519               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     2520                           fr0 = true .
     2521                   tmp#stroka0 = temp-str.
     2522                   if Make-Excel then  put   stream ForExcel unformatted tmp#stroka0  skip.
     2523               End.
     2524             End.
     2525             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     2526               if par-3 = "4"
     2527                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     2528                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     2529               if NOT xSumsOnly THEN DO:
     2530                   fr = true .
     2531                   if Make-Excel then  put   stream ForExcel unformatted CHR(9) temp-str  skip.
     2532               End.
     2533               break_group1 = false.
     2534             END.
     2535          break_group = false.
     2536       End.
     2537       run display-line.
     2538    END PROCEDURE.
     2539   PROCEDURE Di :
     2540   define input parameter p1 as character  no-undo.
     2541   define input parameter p2 as integer   no-undo.
     2542   define input parameter p3 as character  no-undo.
     2543   define input parameter p4 as character  no-undo.
     2544   define input parameter p5 as character  no-undo.
     2545   define input parameter p6 as character  no-undo.
     2546   define input parameter p7 as character  no-undo.
     2547   define variable tot-qnty as decimal no-undo .
     2548   define variable tot-sum as decimal no-undo .
     2549   assign
     2550     tot-qnty = 0
     2551     tot-sum  = 0
     2552   .
     2553    CASE CAPS(p7) :
     2554      WHEN "B1":U  Then DO:
     2555         if Make-Excel then  put   stream ForExcel unformatted
     2556             p3   CHR(9)
     2557             ( if flag-dop-bc = true   then  CHR(9) else "" )
     2558             p4   CHR(9)
     2559             p5   CHR(9)
     2560             p6   CHR(9)
     2561             .
     2562             For each tmp#obj-list :
     2563             if Make-Excel then  put   stream ForExcel unformatted
     2564             excel-qnty (tmp#obj-list.b1-ostatok-end[1] ) CHR(9)
     2565             excel-sum  (tmp#obj-list.b1-ostatok-end[2] ) CHR(9).
     2566             assign
     2567               tot-qnty = tot-qnty + decimal(tmp#obj-list.b1-ostatok-end[1])
     2568               tot-sum  = tot-sum  + decimal(tmp#obj-list.b1-ostatok-end[2])
     2569             .
     2570             End.
     2571             if Make-Excel then  put   stream ForExcel unformatted
     2572             excel-qnty (tot-qnty ) CHR(9)
     2573             excel-sum  (tot-sum  ) CHR(9)
     2574             Skip.
     2575             run clear-b1 .
     2576         End.
     2577      WHEN "BI":U Then DO:
     2578         if Make-Excel then  put   stream ForExcel unformatted
     2579             p3   CHR(9)
     2580             ( if flag-dop-bc = true   then  CHR(9) else "" )
     2581             p4   CHR(9)
     2582             p5   CHR(9)
     2583             p6   CHR(9)
     2584             .
     2585             For each tmp#obj-list :
     2586             if Make-Excel then  put   stream ForExcel unformatted
     2587             excel-qnty  (tmp#obj-list.bi-ostatok-end[1] ) CHR(9)
     2588             excel-sum   (tmp#obj-list.bi-ostatok-end[2] ) CHR(9).
     2589             assign
     2590               tot-qnty = tot-qnty + decimal(tmp#obj-list.bi-ostatok-end[1])
     2591               tot-sum  = tot-sum  + decimal(tmp#obj-list.bi-ostatok-end[2])
     2592             .
     2593             End.
     2594             if Make-Excel then  put   stream ForExcel unformatted
     2595             excel-qnty (tot-qnty ) CHR(9)
     2596             excel-sum  (tot-sum  ) CHR(9)
     2597             Skip.
     2598         End.
     2599      WHEN ""  Then DO:
     2600        if Show-Negativ = true OR  (Show-Negativ = false and NOT can-find ( first tmp#obj-list where tmp#obj-list.ostatok-end[1] = 0 and
     2601                                                          tmp#obj-list.ostatok-end[2] = 0 ))
     2602                THEN  DO:
     2603                  if Make-Excel then  put   stream ForExcel unformatted
     2604                  ( p3)   CHR(9)
     2605                  ( if flag-dop-bc = true   then ( v-dop-bc + CHR(9)) else "" )
     2606                  ( p4)   CHR(9)
     2607                  ( p5)   CHR(9)
     2608                  ( p6)   CHR(9)
     2609                   .
     2610                   assign
     2611                     tot-qnty = 0
     2612                     tot-sum  = 0
     2613                   .
     2614                  For each tmp#obj-list :
     2615                  if Make-Excel then  put   stream ForExcel unformatted
     2616                   excel-qnty ( tmp#obj-list.ostatok-end[1] ) CHR(9)
     2617                   excel-sum  ( tmp#obj-list.ostatok-end[2] ) CHR(9).
     2618                   assign
     2619                     tot-qnty = tot-qnty + decimal(tmp#obj-list.ostatok-end[1])
     2620                     tot-sum  = tot-sum  + decimal(tmp#obj-list.ostatok-end[2])
     2621                   .
     2622                  End.
     2623                  if Make-Excel then  put   stream ForExcel unformatted
     2624                   excel-qnty (tot-qnty ) CHR(9)
     2625                   excel-sum  (tot-sum  ) CHR(9)
     2626                  Skip.
     2627               End.
     2628      End.
     2629     End case.
     2630    END PROCEDURE.
