     1653   procedure lavel1 :
     1654                 case select-good :
     1655                     when 1  then do:
     1656       define buffer buf_obj-list20 for obj-list.
     1657     for each buf_obj-list20 no-lock :
     1658         if xtog-obj and  not (buf_obj-list20.obj-type = x-store-type  and
     1659                               buf_obj-list20.obj-code = x-store-code )
     1660         then next.
     1661           for  each gds-obj   where
     1662                               gds-obj.obj-type = buf_obj-list20.obj-type    and
     1663                               gds-obj.obj-code = buf_obj-list20.obj-code
     1664                               and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1665                               no-lock ,
     1666           first goods where gds-obj.gds-code  = goods.gds-code
     1667                               no-lock :
     1668               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1669                   create temp-gds-list.
     1670                   assign
     1671                     temp-gds-list.prod-code = gds-obj.prod-code
     1672                     temp-gds-list.grp-name  = ""
     1673                     temp-gds-list.gds-code  = gds-obj.gds-code
     1674                     temp-gds-list.artic     = gds-obj.artic
     1675                     temp-gds-list.gds-name  = goods.gds-name
     1676                     .
     1677                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     1678                     .
     1679               end.
     1680           end.
     1681    end.
     1682     for each temp-gds-list no-lock
     1683       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     1684         break
     1685           by  temp-gds-list.grp-name
     1686           by temp-gds-list.artic :
     1687           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     1688   find clients where clients.obj-type = goods.prod-type and
     1689                      clients.obj-code = goods.prod-code no-lock .
     1690     assign
     1691         gds-zap-unit-base  = goods.unit-base
     1692         gds-zap-prt-root   = goods.prt-root
     1693         gds-zap-prod-type  = goods.prod-type
     1694         gds-zap-prod-code  = goods.prod-code
     1695         gds-zap-artic      = goods.artic
     1696         gds-zap-type       = goods.gds-type
     1697         gds-zap-grp-name   = goods.grp-name
     1698         gds-zap-b-code     = goods.gds-code
     1699         gds-zap-prod-name  = clients.obj-name .
     1700     if g#gds-engl then
     1701         assign gds-zap-gds-name = goods.engl-name.
     1702     else
     1703         assign gds-zap-gds-name = goods.gds-name.
     1704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1705     (input  gds-zap-b-code
     1706     ,input  ?
     1707     ,output v-bar-code
     1708     )  .
     1709     s-bar-code = string (v-bar-code,"999999999").
     1710     run foreach in this-procedure .
     1711       if  first-of ( temp-gds-list.grp-name )  then do:
     1712           fr = true .
     1713           l-stroka = "ГРУППА : " + str .
     1714           temp-str = l-stroka.
     1715       end.
     1716      run display-line in this-procedure .
     1717      if last-of( temp-gds-list.grp-name ) then do:
     1718         s-bar-code = "Итого по " .
     1719         gds-zap-artic = substring(str,1,16) .
     1720         gds-zap-gds-name = substring(str,17,250) .
     1721         run display-b1 in this-procedure .
     1722         run clear-b1 in this-procedure .
     1723         run clear-b2 in this-procedure .
     1724      end.
     1725     end.
     1726      end.
