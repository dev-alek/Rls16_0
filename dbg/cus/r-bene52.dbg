      923   define variable v-inform-launched as logical no-undo initial false .
      924   procedure proc-alt-shift-f4:
      925     define variable v-action as character no-undo .
      926     if v-inform-launched = false then do:
      927       assign
      928         v-inform-launched = true
      929       .
      930       run gbl/d-inform.w
      931         (  input self
      932         ,  input this-procedure
      933         , output v-action
      934         ) no-error .
      935       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      936       assign
      937         v-inform-launched = false
      938       .
      939     end.
      940   end.
      941   procedure proc-alt-f1:
