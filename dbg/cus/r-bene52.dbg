     1283   procedure run2 :
     1284        if not xtog-lavel then do:   run run2sort1.    end.
     1285          else do:   run lavel1.      end.
     1286      end procedure.
     1287   procedure run2sort1 :
     1288                 case select-good :
     1289                     when 1  then do:
     1290   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1291   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1292       for each gds-obj  where
     1293             gds-obj.obj-type = x-store-type  and
     1294             gds-obj.obj-code = x-store-code
     1295             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1296                   no-lock,
     1297             First goods  where  gds-obj.gds-code   = goods.gds-code
     1298   no-lock
     1299   BREAK
     1300         BY (temp-gds-list.grp-name)
     1301       BY (temp-gds-list.artic) :
     1302         run item-goods ( "3" , "goods" ) .
     1303         if return-value <> "" then NEXT.
     1304           If Last-of(temp-gds-list.grp-name) Then Do:
     1305           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
     1306             Then  Assign
     1307                     S-bar-code   = " Итого по "
     1308                     Gds-zap-artic = Substring(
     1309                                         B1-name
     1310                                         ,1,16)
     1311                     Gds-zap-gds-name = Substring(
     1312                                         B1-name
     1313                                         ,17,40)
     1314                                   .
     1315             Else  Assign
     1316                     S-bar-code   = ""
     1317                     Gds-zap-artic = "        Итого по "
     1318                     Gds-zap-gds-name =  B1-name
     1319                                   .
     1320               Run Display-b1 In This-procedure .
     1321               Run Clear-b1 In This-procedure .
     1322               Assign Break_Group = True.
     1323           End.
     1324       End.
     1325     END.
     1326     Else DO:
     1327      For each obj-list no-lock :
     1328                     FOR EACH gds-obj where
     1329                   gds-obj.obj-type = obj-list.obj-type    and
     1330                   gds-obj.obj-code = obj-list.obj-code
     1331                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1332                   no-lock :
     1333                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1334                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1335                       Create temp-gds-list.
     1336                       Assign
     1337                         temp-gds-list.prod-code = gds-obj.prod-code
     1338                         temp-gds-list.grp-name  = gds-obj.grp-name
     1339                         temp-gds-list.gds-name  = goods.gds-name
     1340                         temp-gds-list.gds-code  = gds-obj.gds-code
     1341                         temp-gds-list.artic     = gds-obj.artic
     1342                       .
     1343                   End.
     1344               End.
     1345     End.
     1346     for each temp-gds-list no-lock
     1347       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     1348         BREAK
     1349   BY (temp-gds-list.grp-name)
     1350       BY temp-gds-list.artic :
     1351       run item-goods ( "3" , "goods" ) .
     1352         if return-value <> "" then NEXT.
     1353           If Last-of(temp-gds-list.grp-name) Then Do:
     1354           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
     1355             Then  Assign
     1356                     S-bar-code   = " Итого по "
     1357                     Gds-zap-artic = Substring(
     1358                                         B1-name
     1359                                         ,1,16)
     1360                     Gds-zap-gds-name = Substring(
     1361                                         B1-name
     1362                                         ,17,40)
     1363                                   .
     1364             Else  Assign
