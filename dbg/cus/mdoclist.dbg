      149   define buffer inkas_trn-doc for ub.trn-doc .
      150   define buffer c-inkas_trn-doc for ub.c-trn-doc .
      151   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   define  shared  temp-table doc-list-hist no-undo
      153   field list-table as character
      154   field id as integer
      155   field line as integer
      156   field hist-mode as character
      157   field des as character
      158   field num-recs as integer
      159   field option_ as character
      160   field item_ as character
      161   field status_ as character
      162   field num-add as integer
      163   field num-ignored as integer
