        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: mdoclist.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cus/mdoclist.p $":U .
        7   define variable vss-description as character no-undo init "формирование списка заказов по выбранным товарам".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   def
       79    shared
       80   temp-table  obj-list no-undo
       81     field obj-type like ub.clients.obj-type
       82     field obj-code like ub.clients.obj-code
       83     field obj-name like ub.clients.obj-name
       84     field obj-id   as integer
       85     field db-num   as integer
       86     index pi is primary unique obj-id
       87     index ie1 obj-type obj-code
       88     index ie2 obj-name
       89   .
       90   procedure create_obj-list :
       91      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       92      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       93      do
       94      on error undo, return error return-value
       95      :
       96         define buffer cli-obj for ub.clients .
       97         define variable p-var as integer no-undo .
       98         define buffer buf_obj-list for obj-list .
       99         find last buf_obj-list  use-index pi no-error .
      100         if available buf_obj-list
      101         then
      102            p-var = buf_obj-list.obj-id + 1.
      103         else
      104            p-var = 1.
      105         find first cli-obj where
      106                   cli-obj.obj-type = p-obj-type
      107               and cli-obj.obj-code = p-obj-code
      108         no-lock no-error.
      109         if available cli-obj
      110         then do:
      111            create buf_obj-list.
      112            assign
      113               buf_obj-list.obj-id   = p-var
      114               buf_obj-list.obj-code = cli-obj.obj-code
      115               buf_obj-list.obj-type = cli-obj.obj-type
      116               buf_obj-list.obj-name = cli-obj.obj-name
      117               buf_obj-list.db-num   = cli-obj.db-num
      118            .
      119         end.
      120      end.
      121   end.
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define shared temp-table doc-list no-undo
      124   field doc-date   like ub.trn-doc.doc-date
      125   field doc-code   like ub.trn-doc.doc-code
      126   field obj-type   like ub.trn-doc.obj-type
      127   field obj-code   like ub.trn-doc.obj-code
      128   field fact-num   like ub.trn-doc.fact-num
      129   field fact-date  like ub.trn-doc.fact-date
      130   field shift-date like ub.trn-doc.shift-date
      131   field shift-num  like ub.trn-doc.shift-num
      132   field shift-name like ub.trn-doc.shift-name
      133   field fact-order as decimal
      134   field is-trn-doc as logical
      135   field is-del as logical
      136   field doc-type   like ub.trn-doc.doc-type
      137   field ext-doc-type   like ub.trn-doc.ext-doc-type
      138   field sel-order  as integer
      139   field znak       as integer
      140   field to-del     as logical
      141   field is-archive-exist as logical
      142   index xpk is primary unique doc-code doc-type
      143   index xfact fact-num
      144   index xfact-date fact-date
      145   index sel-order sel-order
      146   index znak-order znak sel-order
