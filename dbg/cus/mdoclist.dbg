      172   .
      173   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   define variable v-waitfram-action01         as character   no-undo .
      175   define variable v-waitfram-action02         as character   no-undo .
      176   define variable v-waitfram-action03         as character   no-undo .
      177   define variable mWaitFramTextBeg            as character   no-undo.
      178   define variable mWaitFramTextEnd            as character   no-undo.
      179   define variable mWaitFramView               as logical     no-undo.
      180   define variable mWaitProcEvent              as logical     no-undo init yes.
      181   define variable mWaitFramInterval           as integer     no-undo init 1 .
      182   define variable mWaitFramStop               as logical     no-undo.
      183   define variable mWaitFramStopUser           as logical     no-undo.
      184   define variable mWaitFramStopTimeOut        as logical     no-undo.
      185   define variable mWaitFramStartProc          as datetime-tz no-undo.
      186   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      187   define button B-WaitFramStop auto-end-key
      188        label "Стоп"
      189        size 10 by 1 tooltip "Остоновить процесс".
      190   define button B-viewProcInfo
      191        label "Информация"
      192        size 15 by 1 tooltip "Информация о процесс".
      193   define frame waitfram
      194     v-waitfram-action01 format "x(72)" no-label skip
      195     v-waitfram-action02 format "x(72)" no-label skip
      196     v-waitfram-action03 format "x(72)" no-label skip
      197     B-viewProcInfo
      198     B-WaitFramStop at row 4 col 30
      199     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      200     .
      201   define new global shared variable mBatchMode as logical no-undo init ?.
      202   define variable mFramBachModHandle as handle no-undo.
      203   mFramBachModHandle = frame waitfram:handle.
      204   define variable mFameOldVis as logical no-undo.
      205   define variable mVisCUrentVin as logical no-undo.
      206   if session:batch-mode
      207   then
      208      mBatchMode = yes.
      209   if mBatchMode = ? then do:
      210     mVisCUrentVin = current-window:visible.
      211     mFameOldVis = mFramBachModHandle:visible.
      212     mFramBachModHandle:visible  = yes.
      213     mBatchMode = mFramBachModHandle:visible ne yes.
      214     mFramBachModHandle:visible = mFameOldVis.
      215     current-window:visible = mVisCUrentVin.
      216   end.
      217    if  log-manager:logfile-name ne ?
      218     then DO:
      219         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      220         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      221         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      222     end.
      223   on choose of B-WaitFramStop in frame waitfram
      224   do:
      225     mWaitFramStop = yes.
      226     mWaitFramStopUser = yes.
      227   end.
      228   function waitfram-check-timeout returns logical():
      229      define variable vtime as int64 no-undo.
      230      if mWaitFramStopTimeOut
      231      then
      232         return yes.
      233      vtime = ( now - mWaitFramStartProc ) / 1000 .
      234      if     mWaitFramTimeOut ne ?
      235         and mWaitFramTimeOut ne 0
      236         and mWaitFramTimeOut lt vtime
      237      then do:
      238         mWaitFramStopTimeOut = yes.
      239      end.
      240      return mWaitFramStopTimeOut.
      241   end.
      242   procedure waitfram-hide :
      243     if not session:batch-mode
      244     then do
      245     on error undo, return error return-value
      246     :
      247       pause 0 before-hide .
      248       if not mBatchMode then
      249         hide frame waitfram .
      250     if     not mWaitFramView
      251        and mWaitProcEvent
      252     then
      253       process events .
      254     end.
      255   end procedure.
      256   procedure waitfram-show :
      257     define input  parameter p-message as character no-undo .
      258     define variable v-left-margin as integer   no-undo .
      259     if not session:batch-mode
      260     then do
      261     on error undo, return error return-value
      262     :
      263       if length(p-message) <= 70 then do:
      264         assign
      265           v-left-margin = integer((70 - length(p-message)) / 2)
      266         .
      267         assign
      268           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      269         .
      270         assign
      271           v-waitfram-action01 = " "
      272           v-waitfram-action02 = " "
      273                                    + fill(" ", v-left-margin)
      274                                    + p-message
      275           v-waitfram-action03 = " "
      276         .
      277       end.
      278       else do:
      279         define variable vRindex1 as integer no-undo.
      280         define variable vRindex2 as integer no-undo.
      281         vRindex1 = r-index(p-message," ",70).
      282         if vRindex1 = 0
      283         then
      284            vRindex1 = 70.
      285         if length(p-message)  <= vRindex1 + 70 then do:
      286           assign
      287             v-waitfram-action01 = " "
      288             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      289             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      290           .
      291         end.
      292         else do:
      293           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      294           if vRindex2 <= vRindex1
      295           then
      296              vRindex2 = vRindex1 + 70.
      297           assign
      298             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      299             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      300             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      301           .
      302         end.
      303       end.
      304       B-viewProcInfo:visible   in frame waitfram = no.
      305       B-viewProcInfo:sensitive in frame waitfram = no.
      306       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      307       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      308       if  (   mWaitFramView
      309          or  mWaitProcEvent)
      310          and not mBatchMode
      311       then
      312          display
      313             v-waitfram-action01 skip
      314             v-waitfram-action02 skip
      315             v-waitfram-action03 skip
      316          with frame waitfram .
      317       if     mWaitFramView
      318          then do:
      319             if     mWaitFramInterval ne ?
      320                and not mBatchMode
      321             then
      322                wait-for go of frame waitfram pause mWaitFramInterval.
      323          end.
      324          else
      325             if     mWaitProcEvent
      326                and not mBatchMode
      327             then
      328                process events .
      329     end.
      330   end procedure.
      331      procedure waitfram-show-this:
      332         define input  parameter iInterval as int64 no-undo.
      333         define variable vtime as int64 no-undo.
      334         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      335         mWaitFramInterval = iInterval.
      336         run waitfram-show (substitute("&1&2 &3&4" ,
      337                                       mWaitFramTextBeg ,
      338                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      339                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      340                                       mWaitFramTextEnd
      341                                      )
      342                           ).
      343      end.
      344      procedure WaitFramRunPause:
      345         define input  parameter iInterval as dec no-undo.
      346         define variable vStart  as datetime-tz no-undo.
      347         define variable vend    as datetime-tz no-undo.
      348         define variable vint as int64 no-undo.
      349         define variable vOk as logical no-undo.
      350         vStart = now.
      351         vend   = vStart.
      352         publish "WaitFramPause" (iInterval,output vOk).
      353         vend   =  now.
      354         vint = vend - vStart.
      355         vint = iInterval - vint / 1000.
      356         if     not mWaitFramStop
      357            and (   vint > 0
      358                 or (    not vOk
      359                     and iInterval eq ?
      360                     )
      361                 )
      362         then
      363            run waitfram-show-this (iInterval).
      364         vend   =  now.
      365         vint = vend - vStart.
      366         vint = iInterval - vint / 1000.
      367         if     not mWaitFramStop
      368            and vint > 0
      369         then do:
      370            run gbl/pause.p (vint * 1000).
      371         end.
      372         if iInterval ne ?
      373         then
      374            publish "WaitFramStop".
      375         waitfram-check-timeout().
      376      end.
      377      procedure WaitFramWaitFor:
      378         define input  parameter iInterval as dec no-undo.
      379         assign
      380            mWaitFramStartProc   = now
      381            mWaitFramStopUser    = no
      382            mWaitFramStopTimeOut = no
      383         .
      384         block-wait:
      385         do while not mWaitFramStop:
      386            run WaitFramRunPause (iInterval).
      387            if  waitfram-check-timeout()
      388            then do:
      389               leave block-wait.
      390            end.
      391         end.
      392         run waitfram-hide.
      393      end.
      394   procedure waitfram-join :
      395     define input  parameter p-line-1  as character no-undo .
      396     define input  parameter p-line-2  as character no-undo .
      397     define input  parameter p-line-3  as character no-undo .
      398     define output parameter p-message as character no-undo .
      399     do
      400     on error undo, return error return-value
      401     :
      402       assign
      403         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      404                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      405                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      406       .
      407     end.
      408   end procedure.
      409   function waitfram-join-function returns character
      410     (input p-line-1 as character
      411     ,input p-line-2 as character
      412     ,input p-line-3 as character
      413     ).
      414     define variable v-message as character no-undo .
      415     run waitfram-join in this-procedure
      416       (input  p-line-1
      417       ,input  p-line-2
      418       ,input  p-line-3
      419       ,output v-message
      420       ) .
      421     return v-message .
      422   end function .
      423   define input  parameter p-recid-list as character no-undo .
      424   define buffer buf_abc-analysis-goods for ub.abc-analysis-goods.
      425   define buffer buf_goods              for ub.goods.
      426   define buffer buf_ord-doc            for ub.ord-doc.
      427   define buffer buf_ord-line           for ub.ord-line.
      428   define variable v-host-code as integer   no-undo .
      429   run waitfram-show ("Ждите...Анализ заказов...").
      430   define variable v-i as integer   no-undo .
      431   define variable v-all as integer   no-undo .
      432   v-all = num-entries(p-recid-list) .
      433   repeat v-i = 1 to v-all :
      434      find first buf_abc-analysis-goods no-lock where
      435           recid( buf_abc-analysis-goods ) = int(entry( v-i , p-recid-list ) ) no-error .
      436           if available  buf_abc-analysis-goods then do:
      437              find first buf_goods no-lock where
      438                         buf_goods.gds-code = buf_abc-analysis-goods.gds-code no-error .
      439                if available buf_goods then do:
      440                   for each obj-list :
      441   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      442   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      443     (input  obj-list.obj-type
      444     ,input  obj-list.obj-code
      445     ,output v-host-code
      446     )  .
      447                       for each buf_ord-line no-lock where
      448                               buf_ord-line.artic     = buf_goods.artic       and
      449                               buf_ord-line.prod-code = buf_goods.prod-code   and
      450                               buf_ord-line.prod-type = buf_goods.prod-type   and
      451                               buf_ord-line.obj-code  = obj-list.obj-code     and
      452                               buf_ord-line.obj-type  = obj-list.obj-type     and
      453                               buf_ord-line.status_   <> 'факт':U
      454                               :
      455                               find first doc-list where doc-list.doc-code = buf_ord-line.doc-code no-error .
      456                               if not available doc-list then do:
      457                                  find first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-line.doc-code no-error .
      458                                  if available buf_ord-doc then do:
      459                                     create doc-list.
      460                                     BUFFER-COPY buf_ord-doc TO doc-list .
      461                                  end.
      462                               end.
      463                       end.
      464                       for each buf_ord-line no-lock where
      465                               buf_ord-line.artic     = buf_goods.artic       and
      466                               buf_ord-line.prod-code = buf_goods.prod-code   and
      467                               buf_ord-line.prod-type = buf_goods.prod-type   and
      468                               buf_ord-line.status_   <> 'факт':U
      469                               :
      470                               find first doc-list where doc-list.doc-code = buf_ord-line.doc-code no-error .
      471                               if not available doc-list then do:
      472                                  find first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-line.doc-code  and
      473                                                                       buf_ord-doc.host-code = v-host-code           and
      474                                                                       buf_ord-doc.doc-type = 'ФП':U  no-error .
      475                                  if available buf_ord-doc then do:
      476                                     create doc-list.
      477                                     BUFFER-COPY buf_ord-doc TO doc-list .
      478                                  end.
      479                               end.
      480                       end.
      481                   end.
      482                end.
      483           end.
      484   end.
      485   run waitfram-hide in this-procedure .
