      183   .
      184   procedure create_obj-list :
      185      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      186      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      187      do
      188      on error undo, return error return-value
      189      :
      190         define buffer cli-obj for ub.clients .
      191         define variable p-var as integer no-undo .
      192         define buffer buf_obj-list for obj-list .
      193         find last buf_obj-list  use-index pi no-error .
      194         if available buf_obj-list
      195         then
      196            p-var = buf_obj-list.obj-id + 1.
      197         else
      198            p-var = 1.
      199         find first cli-obj where
      200                   cli-obj.obj-type = p-obj-type
      201               and cli-obj.obj-code = p-obj-code
      202         no-lock no-error.
      203         if available cli-obj
      204         then do:
      205            create buf_obj-list.
      206            assign
      207               buf_obj-list.obj-id   = p-var
      208               buf_obj-list.obj-code = cli-obj.obj-code
      209               buf_obj-list.obj-type = cli-obj.obj-type
      210               buf_obj-list.obj-name = cli-obj.obj-name
      211               buf_obj-list.db-num   = cli-obj.db-num
      212            .
      213         end.
      214      end.
      215   end.
