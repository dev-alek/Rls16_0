      619   function diff-list returns character (
      620     input parfirst-list  as character,
      621     input parsecond-list as character,
      622     input pardelim       as character).
      623     if pardelim = ""
      624     or pardelim = ?
      625     then do:
      626       assign
      627         pardelim = ","
      628       .
      629     end.
      630     def var ind as integer no-undo .
      631     def var v-elem as character no-undo .
      632     def var v-result-list as character no-undo init "".
      633     def var v-num-parfirst-list as integer no-undo .
      634     assign
      635       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      636     .
      637     do ind = 1 to v-num-parfirst-list
      638     :
      639       assign
      640         v-elem = entry(ind, parfirst-list, pardelim)
      641       .
      642       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      643         assign
      644           v-result-list = v-result-list
      645                         + (if v-result-list > "" then pardelim else "")
      646                         + v-elem
      647         .
      648       end.
      649     end.
      650     return v-result-list .
      651   end function.
      652   function add-list returns character (
      653    input parfirst-list  as character,
      654    input parsecond-list as character,
      655    input pardelim       as character).
      656     if pardelim = ""
      657     or pardelim = ?
      658     then do:
      659       assign
      660         pardelim = ","
      661       .
      662     end.
      663     def var ind as integer no-undo .
      664     def var v-elem as character no-undo .
      665     def var v-result-list as character no-undo init "".
      666     def var v-num-parfirst-list as integer no-undo .
      667     assign
      668       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      669     .
      670     do ind = 1 to v-num-parfirst-list
      671     :
      672       assign
      673         v-elem = entry(ind, parfirst-list, pardelim)
      674       .
      675       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      676         assign
      677           v-result-list = v-result-list
      678                         + (if v-result-list > "" then pardelim else "")
      679                         + v-elem
      680         .
      681       end.
      682     end.
      683     def var v-num-parsecond-list as integer no-undo .
      684     assign
      685       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      686     .
      687     do ind = 1 to v-num-parsecond-list
      688     :
      689       assign
      690         v-elem = entry(ind, parsecond-list, pardelim)
      691       .
      692       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      693         assign
      694           v-result-list = v-result-list
      695                         + (if v-result-list > "" then pardelim else "")
      696                         + v-elem
      697         .
      698       end.
      699     end.
      700     return v-result-list .
      701   end function.
      702   function cross-list returns character (
      703    input parfirst-list  as character,
      704    input parsecond-list as character,
      705    input pardelim       as character).
      706     if pardelim = ""
      707     or pardelim = ?
      708     then do:
      709       assign
      710         pardelim = ","
      711       .
      712     end.
      713     def var ind as integer no-undo .
      714     def var v-elem as character no-undo .
      715     def var v-result-list as character no-undo init "".
      716     def var v-num-parfirst-list as integer no-undo .
      717     assign
      718       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      719     .
      720     do ind = 1 to v-num-parfirst-list
      721     :
      722       assign
      723         v-elem = entry(ind, parfirst-list, pardelim)
      724       .
      725       if lookup(v-elem, v-result-list, pardelim) = 0
      726       and lookup(v-elem, parsecond-list, pardelim) > 0
      727       then do:
      728         assign
      729           v-result-list = v-result-list
      730                         + (if v-result-list > "" then pardelim else "")
      731                         + v-elem
      732         .
      733       end.
      734     end.
      735     return v-result-list .
      736   end function.
      737   function radio-label returns character (
      738    input par-rs-value  as character,
      739    input par-rs-radio-buttons as character)
      740    .
      741    DEFINE variable v-result-label as character no-undo.
      742    assign
      743    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      744                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      745                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      746                             ), par-rs-radio-buttons
      747                           )
      748    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      749    .
      750   return v-result-label.
      751   end function.
      752   function m-radio-label returns character (
      753    input par-rs-value  as character,
      754    input par-rs-radio-buttons as character,
      755    input par-delim as character
      756    )
      757    .
      758    DEFINE variable v-result-label as character no-undo.
      759    assign
      760    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      761                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      762                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      763                             ), par-rs-radio-buttons, par-delim
      764                           )
      765    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      766    .
      767   return v-result-label.
      768   end function.
      769   FUNCTION mixlist returns character
      770   (
      771    input parfirst-list  as character
      772    ,input parsecond-list as character
      773    ,input pardelim       as character
      774    ,input pardelim-result as character ) :
      775     if pardelim = ""
      776     or pardelim = ?
      777     then do:
      778       assign
      779         pardelim = ","
      780       .
      781     end.
      782     def var ind as integer no-undo .
      783     def var v-elem1 as character no-undo .
      784     def var v-elem2 as character no-undo .
      785     def var v-result-list as character no-undo init "".
      786     do ind = 1 to num-entries(parfirst-list, pardelim)
      787     :
      788       assign
      789         v-elem1 = entry(ind, parfirst-list, pardelim)
      790         v-elem2 = entry(ind, parsecond-list, pardelim)
      791       .
      792         assign
      793           v-result-list = v-result-list
      794                         + (if v-result-list > "" then pardelim-result else "")
      795                         + v-elem1 + pardelim-result + v-elem2
      796         .
      797     end.
      798     return v-result-list .
      799   END FUNCTION.
      800   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   define variable v-waitfram-action01         as character   no-undo .
      802   define variable v-waitfram-action02         as character   no-undo .
      803   define variable v-waitfram-action03         as character   no-undo .
      804   define variable mWaitFramTextBeg            as character   no-undo.
      805   define variable mWaitFramTextEnd            as character   no-undo.
      806   define variable mWaitFramView               as logical     no-undo.
      807   define variable mWaitProcEvent              as logical     no-undo init yes.
      808   define variable mWaitFramInterval           as integer     no-undo init 1 .
      809   define variable mWaitFramStop               as logical     no-undo.
      810   define variable mWaitFramStopUser           as logical     no-undo.
      811   define variable mWaitFramStopTimeOut        as logical     no-undo.
      812   define variable mWaitFramStartProc          as datetime-tz no-undo.
      813   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      814   define button B-WaitFramStop auto-end-key
      815        label "Стоп"
      816        size 10 by 1 tooltip "Остоновить процесс".
      817   define button B-viewProcInfo
      818        label "Информация"
      819        size 15 by 1 tooltip "Информация о процесс".
      820   define frame waitfram
      821     v-waitfram-action01 format "x(72)" no-label skip
      822     v-waitfram-action02 format "x(72)" no-label skip
      823     v-waitfram-action03 format "x(72)" no-label skip
      824     B-viewProcInfo
      825     B-WaitFramStop at row 4 col 30
      826     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      827     .
      828   define new global shared variable mBatchMode as logical no-undo init ?.
      829   define variable mFramBachModHandle as handle no-undo.
      830   mFramBachModHandle = frame waitfram:handle.
      831   define variable mFameOldVis as logical no-undo.
      832   define variable mVisCUrentVin as logical no-undo.
      833   if session:batch-mode
      834   then
      835      mBatchMode = yes.
      836   if mBatchMode = ? then do:
      837     mVisCUrentVin = current-window:visible.
      838     mFameOldVis = mFramBachModHandle:visible.
      839     mFramBachModHandle:visible  = yes.
      840     mBatchMode = mFramBachModHandle:visible ne yes.
      841     mFramBachModHandle:visible = mFameOldVis.
      842     current-window:visible = mVisCUrentVin.
      843   end.
      844    if  log-manager:logfile-name ne ?
      845     then DO:
      846         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      847         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      848         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      849     end.
      850   on choose of B-WaitFramStop in frame waitfram
      851   do:
      852     mWaitFramStop = yes.
      853     mWaitFramStopUser = yes.
      854   end.
      855   function waitfram-check-timeout returns logical():
      856      define variable vtime as int64 no-undo.
      857      if mWaitFramStopTimeOut
      858      then
      859         return yes.
      860      vtime = ( now - mWaitFramStartProc ) / 1000 .
      861      if     mWaitFramTimeOut ne ?
      862         and mWaitFramTimeOut ne 0
      863         and mWaitFramTimeOut lt vtime
      864      then do:
      865         mWaitFramStopTimeOut = yes.
      866      end.
      867      return mWaitFramStopTimeOut.
      868   end.
      869   procedure waitfram-hide :
      870     if not session:batch-mode
      871     then do
      872     on error undo, return error return-value
      873     :
      874       pause 0 before-hide .
      875       if not mBatchMode then
      876         hide frame waitfram .
      877     if     not mWaitFramView
      878        and mWaitProcEvent
      879     then
      880       process events .
      881     end.
      882   end procedure.
      883   procedure waitfram-show :
      884     define input  parameter p-message as character no-undo .
      885     define variable v-left-margin as integer   no-undo .
      886     if not session:batch-mode
      887     then do
      888     on error undo, return error return-value
      889     :
      890       if length(p-message) <= 70 then do:
      891         assign
      892           v-left-margin = integer((70 - length(p-message)) / 2)
      893         .
      894         assign
      895           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      896         .
      897         assign
      898           v-waitfram-action01 = " "
      899           v-waitfram-action02 = " "
      900                                    + fill(" ", v-left-margin)
      901                                    + p-message
      902           v-waitfram-action03 = " "
      903         .
      904       end.
      905       else do:
      906         define variable vRindex1 as integer no-undo.
      907         define variable vRindex2 as integer no-undo.
      908         vRindex1 = r-index(p-message," ",70).
      909         if vRindex1 = 0
      910         then
      911            vRindex1 = 70.
      912         if length(p-message)  <= vRindex1 + 70 then do:
      913           assign
      914             v-waitfram-action01 = " "
      915             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      916             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      917           .
      918         end.
      919         else do:
      920           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      921           if vRindex2 <= vRindex1
      922           then
      923              vRindex2 = vRindex1 + 70.
      924           assign
      925             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      926             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      927             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      928           .
      929         end.
      930       end.
      931       B-viewProcInfo:visible   in frame waitfram = no.
      932       B-viewProcInfo:sensitive in frame waitfram = no.
      933       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      934       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      935       if  (   mWaitFramView
      936          or  mWaitProcEvent)
      937          and not mBatchMode
      938       then
      939          display
      940             v-waitfram-action01 skip
      941             v-waitfram-action02 skip
      942             v-waitfram-action03 skip
      943          with frame waitfram .
      944       if     mWaitFramView
      945          then do:
      946             if     mWaitFramInterval ne ?
      947                and not mBatchMode
      948             then
      949                wait-for go of frame waitfram pause mWaitFramInterval.
      950          end.
      951          else
      952             if     mWaitProcEvent
      953                and not mBatchMode
      954             then
      955                process events .
      956     end.
      957   end procedure.
      958      procedure waitfram-show-this:
      959         define input  parameter iInterval as int64 no-undo.
      960         define variable vtime as int64 no-undo.
      961         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      962         mWaitFramInterval = iInterval.
      963         run waitfram-show (substitute("&1&2 &3&4" ,
      964                                       mWaitFramTextBeg ,
      965                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      966                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      967                                       mWaitFramTextEnd
      968                                      )
      969                           ).
      970      end.
      971      procedure WaitFramRunPause:
      972         define input  parameter iInterval as dec no-undo.
      973         define variable vStart  as datetime-tz no-undo.
      974         define variable vend    as datetime-tz no-undo.
      975         define variable vint as int64 no-undo.
      976         define variable vOk as logical no-undo.
      977         vStart = now.
      978         vend   = vStart.
      979         publish "WaitFramPause" (iInterval,output vOk).
      980         vend   =  now.
      981         vint = vend - vStart.
      982         vint = iInterval - vint / 1000.
      983         if     not mWaitFramStop
      984            and (   vint > 0
      985                 or (    not vOk
      986                     and iInterval eq ?
      987                     )
      988                 )
      989         then
      990            run waitfram-show-this (iInterval).
      991         vend   =  now.
      992         vint = vend - vStart.
      993         vint = iInterval - vint / 1000.
      994         if     not mWaitFramStop
      995            and vint > 0
      996         then do:
      997            run gbl/pause.p (vint * 1000).
      998         end.
      999         if iInterval ne ?
     1000         then
     1001            publish "WaitFramStop".
     1002         waitfram-check-timeout().
     1003      end.
     1004      procedure WaitFramWaitFor:
     1005         define input  parameter iInterval as dec no-undo.
     1006         assign
     1007            mWaitFramStartProc   = now
     1008            mWaitFramStopUser    = no
     1009            mWaitFramStopTimeOut = no
     1010         .
     1011         block-wait:
     1012         do while not mWaitFramStop:
     1013            run WaitFramRunPause (iInterval).
     1014            if  waitfram-check-timeout()
     1015            then do:
     1016               leave block-wait.
     1017            end.
     1018         end.
     1019         run waitfram-hide.
     1020      end.
     1021   procedure waitfram-join :
     1022     define input  parameter p-line-1  as character no-undo .
     1023     define input  parameter p-line-2  as character no-undo .
     1024     define input  parameter p-line-3  as character no-undo .
     1025     define output parameter p-message as character no-undo .
     1026     do
     1027     on error undo, return error return-value
     1028     :
     1029       assign
     1030         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1031                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1032                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1033       .
     1034     end.
     1035   end procedure.
     1036   function waitfram-join-function returns character
     1037     (input p-line-1 as character
     1038     ,input p-line-2 as character
     1039     ,input p-line-3 as character
     1040     ).
     1041     define variable v-message as character no-undo .
     1042     run waitfram-join in this-procedure
     1043       (input  p-line-1
     1044       ,input  p-line-2
     1045       ,input  p-line-3
     1046       ,output v-message
     1047       ) .
     1048     return v-message .
     1049   end function .
     1050   DEFINE STREAm PrnLibStream.
     1051   DEFINE VARIABLE my-qnty AS DECIMAL FORMAT "->>,>>9.999":U INITIAL 0
     1052        LABEL "Кол-во товара в строке чека >="
     1053        VIEW-AS FILL-IN
     1054        SIZE 11.75 BY 1 NO-UNDO.
     1055   DEFINE VARIABLE text-5 AS CHARACTER FORMAT "X(256)":U INITIAL "Потоварный вывод"
     1056         VIEW-AS TEXT
     1057        SIZE 18.38 BY 1 NO-UNDO.
     1058   DEFINE VARIABLE RS-method AS INTEGER
     1059        VIEW-AS RADIO-SET VERTICAL
     1060        RADIO-BUTTONS
     1061             "Включенные в отчет о продаже", 1,
     1062   "Не включенные в отчет о продаже", 2,
     1063   "Все чеки", 3
     1064        SIZE 34.5 BY 2.79 NO-UNDO.
     1065   DEFINE RECTANGLE RECT-1
     1066        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1067        SIZE 38.25 BY 5.04.
     1068   DEFINE VARIABLE choice AS LOGICAL INITIAL no
     1069        LABEL ""
     1070        VIEW-AS TOGGLE-BOX
     1071        SIZE 3 BY 1 NO-UNDO.
     1072   DEFINE FRAME F-Main
     1073        my-qnty AT ROW 1.79 COL 32.5 COLON-ALIGNED
     1074        choice AT ROW 3.42 COL 34
     1075        RS-method AT ROW 7.58 COL 3.38 NO-LABEL
     1076        text-5 AT ROW 3.54 COL 12.38 COLON-ALIGNED NO-LABEL
     1077        "Чеки" VIEW-AS TEXT
     1078             SIZE 16.38 BY .88 AT ROW 6.58 COL 3.88
     1079             FGCOLOR 4
     1080        "а не только  чеки" VIEW-AS TEXT
     1081             SIZE 18.38 BY 1 AT ROW 4.5 COL 14.38
     1082        RECT-1 AT ROW 5.96 COL 2.25
     1083       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1084            SIDE-LABELS NO-UNDERLINE THREE-D
     1085            AT COL 1 ROW 1
     1086            SIZE 54.5 BY 11.83.
     1087   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1088   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1089   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1090   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1091   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1092   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1093   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1094   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1095       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1096   RUN ensure-broker.
     1097   THIS-PROCEDURE:ADM-DATA =
     1098        'ADM1.1~`':U +
     1099        'SmartObject~`':U +
     1100        'FRAME~`':U +
     1101        'NO ~`':U +
     1102        '~`':U +
     1103        '~`':U +
     1104        '~`':U +
     1105        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1106           + "~`":U +
     1107        'Layout,Hide-on-Init~`':U +
     1108        '~`':U +
     1109        '~`':U +
     1110        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1111        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1112            THEN "^^":U
     1113        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1114             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1115   PROCEDURE adm-apply-entry :
     1116     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1117   END PROCEDURE.
     1118   PROCEDURE adm-destroy :
     1119    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1120   END PROCEDURE.
     1121   PROCEDURE adm-disable :
     1122       DISABLE RECT-1 my-qnty choice RS-method text-5 WITH FRAME F-Main.
     1123       RUN dispatch ('disable-fields':U).
     1124       RUN set-attribute-list ('ENABLED=no':U).
     1125       RETURN.
     1126   END PROCEDURE.
     1127   PROCEDURE adm-edit-attribute-list :
     1128         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1129         RETURN.
     1130   END PROCEDURE.
     1131   PROCEDURE adm-enable :
     1132       ENABLE UNLESS-HIDDEN RECT-1 my-qnty choice RS-method text-5 WITH FRAME F-Main.
     1133       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1134       RUN set-attribute-list ('ENABLED=yes':U).
     1135       RETURN.
     1136   END PROCEDURE.
     1137   PROCEDURE adm-exit :
     1138        RUN notify ('exit':U).
     1139     RETURN.
     1140   END PROCEDURE.
     1141   PROCEDURE adm-hide :
     1142     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1143   END PROCEDURE.
     1144   PROCEDURE adm-initialize :
     1145     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1146   END PROCEDURE.
     1147   PROCEDURE adm-show-errors :
     1148       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1149       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1150           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1151       END.
     1152       RETURN.
     1153   END PROCEDURE.
     1154   PROCEDURE adm-UIB-mode :
     1155     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1156   END PROCEDURE.
     1157   PROCEDURE adm-view :
     1158     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1159   END PROCEDURE.
     1160   PROCEDURE dispatch :
     1161       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1162       RUN broker-dispatch IN adm-broker-hdl
     1163           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1164       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1165   END PROCEDURE.
     1166   PROCEDURE ensure-broker :
     1167   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1168   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1169   DO:
     1170       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1171       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1172   END.
     1173   END PROCEDURE.
     1174   PROCEDURE get-attribute :
     1175     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1176     RUN broker-get-attribute IN adm-broker-hdl
     1177         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1178     RETURN RETURN-VALUE.
     1179   END PROCEDURE.
     1180   PROCEDURE get-attribute-list :
     1181     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1182     RUN broker-get-attribute-list IN adm-broker-hdl
     1183         (INPUT THIS-PROCEDURE,
     1184          INPUT ?,
     1185          OUTPUT p-attr-list) NO-ERROR.
     1186     RETURN.
     1187   END PROCEDURE.
     1188   PROCEDURE new-state :
     1189     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1190     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1191     RETURN.
     1192   END PROCEDURE.
     1193   PROCEDURE notify :
     1194     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1195     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1196     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1197         RETURN "ADM-ERROR":U.
     1198     RETURN.
     1199   END PROCEDURE.
     1200   PROCEDURE set-attribute-list :
     1201     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1202     RUN ensure-broker.
     1203     RUN broker-set-attribute-list IN adm-broker-hdl
     1204         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1205     RETURN.
     1206   END PROCEDURE.
     1207   PROCEDURE set-position :
     1208       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1209       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1210       IF VALID-HANDLE(adm-object-hdl) THEN
     1211       DO:
     1212           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1213           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1214           DO:
     1215             IF p-row = 0 THEN p-row =
     1216               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1217             IF p-col = 0 THEN p-col =
     1218               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1219           END.
     1220           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1221           DO:
     1222             parent-hdl = adm-object-hdl:PARENT.
     1223             IF p-row = 0 THEN p-row =
     1224               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1225                 parent-hdl:ROW.
     1226             IF p-col = 0 THEN p-col =
     1227               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1228                 parent-hdl:COL.
     1229           END.
     1230           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1231           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1232         ASSIGN adm-object-hdl:ROW    =   p-row
     1233                adm-object-hdl:COLUMN =   p-col.
     1234       END.
     1235       RETURN.
     1236   END PROCEDURE.
     1237   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1238       STRING(adm-object-hdl)).
     1239   PAUSE 0 BEFORE-HIDE.
     1240   PROCEDURE adm-change-page :
     1241     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1242     END PROCEDURE.
     1243   PROCEDURE delete-page :
     1244     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1245     RUN broker-delete-page IN adm-broker-hdl
     1246         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1247     END PROCEDURE.
     1248   PROCEDURE init-object :
     1249     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1250     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1251     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1252     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1253     RUN broker-init-object IN adm-broker-hdl
     1254         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1255          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1256     RETURN.
     1257   END PROCEDURE.
     1258   PROCEDURE init-pages :
     1259     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1260     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1261         INPUT p-page-list) NO-ERROR.
     1262     END PROCEDURE.
     1263   PROCEDURE select-page :
     1264     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1265     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1266         INPUT p-page#) NO-ERROR.
     1267     END PROCEDURE.
     1268   PROCEDURE view-page :
     1269     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1270     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1271         INPUT p-page#).
     1272     END PROCEDURE.
     1273   if not this-procedure :persistent
     1274   then do:
     1275     message
     1276       vss-workfile vss-revision vss-description skip
     1277       "Ошибка при запуске процедуры" skip
     1278       "Данную процедуру следует запускать только с параметром persistent" skip
     1279       view-as alert-box error .
     1280     undo, return error .
     1281   end.
     1282   PROCEDURE adm-create-objects :
     1283   END PROCEDURE.
     1284   PROCEDURE adm-row-available :
     1285     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1286     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1287     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1288     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1289     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1290     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1291     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1292     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1293     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1294     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1295     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1296     IF adm-updating-record THEN RETURN.
     1297     RUN get-attribute ('FIELDS-ENABLED':U).
     1298     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1299     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1300         OUTPUT link-handle) NO-ERROR.
     1301     IF link-handle = "":U THEN
     1302         RETURN.
     1303     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1304     IF NUM-ENTRIES(link-handle) > 1 THEN
     1305         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1306             "encountered more than one RECORD-SOURCE.":U SKIP
     1307             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1308                VIEW-AS ALERT-BOX ERROR.
     1309     RUN get-attribute ('Key-Name':U).
     1310     key-name = RETURN-VALUE.
     1311     IF key-name = "":U THEN key-name = ?.
     1312     IF key-name NE ? THEN DO:
     1313       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1314         NO-ERROR.
     1315       IF key-value NE ? THEN
     1316         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1317     END.
     1318   IF VALID-HANDLE (adm-object-hdl) THEN
     1319       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1320   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1321   END PROCEDURE.
     1322   PROCEDURE disable_UI :
     1323     HIDE FRAME F-Main.
     1324     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1325   END PROCEDURE.
     1326   PROCEDURE enable_UI :
     1327     DISPLAY my-qnty choice RS-method text-5
     1328         WITH FRAME F-Main.
     1329     ENABLE RECT-1 my-qnty choice RS-method text-5
     1330         WITH FRAME F-Main.
     1331   END PROCEDURE.
     1332   PROCEDURE My-report :
     1333   define variable g#log as logical no-undo .
     1334   define buffer buf_chk-doc for ub.chk-doc.
     1335   define buffer buf_chk-gds for ub.chk-gds.
     1336   define buffer buf_goods for ub.goods.
     1337   define buffer buf_bar-code for ub.bar-code.
     1338   run My-var.
     1339   if X-selectGood = 4 and not can-find(first gds-list no-lock) then do:
     1340       g#log = no.
     1341       message "Не выбрано ни одного товара" view-as alert-box ERROR.
     1342       return no-apply.
     1343   end.
     1344   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1345   define variable ReportFileName as character no-undo initial "report".
     1346   define variable was_OK_opened  as logical   no-undo.
     1347   system-dialog get-file          ReportFileName
     1348                 title             "Укажите путь"
     1349                 filters           "Текстовый файл (*.txt)" "*.txt"
     1350                 ask-overwrite
     1351                 create-test-file
     1352                 save-as
     1353                 use-filename
     1354                 default-extension "txt"
     1355                 update            was_OK_opened.
     1356   if was_OK_opened <> yes then do: return "Cancel". end.
     1357   assign ReportFileName = trim( string( ReportFileName ) ).
     1358   output stream PrnLibStream to value ( ReportFileName ) page-size 0  .
     1359   put stream PrnLibStream unformatted
     1360   ReportName skip
     1361   str1 skip
     1362   str4 skip
     1363   ReportHeader skip
     1364   str2
     1365   skip.
     1366   if choice then
     1367   put stream PrnLibStream unformatted
     1368       "N чека" CHR(9)
     1369       "Дата чека" CHR(9)
     1370       "N кассы" CHR(9)
     1371       "Кассир" CHR(9)
     1372       "Бар-код" CHR(9) CHR(9)
     1373       "Кол-во" CHR(9)
     1374       'Артикул':U format "X(16)" CHR(9)
     1375       "Цена(брутто)" CHR(9)
     1376       "Скидка" CHR(9)
     1377       "Сумма_нетто" CHR(9)
     1378       "Произ-ль" CHR(9)
     1379       'название':U
     1380       skip.
     1381   else
     1382   put stream PrnLibStream unformatted
     1383       "N чека" CHR(9)
     1384       "Дата чека" CHR(9)
     1385       "N кассы" CHR(9)
     1386       "Кассир" CHR(9)
     1387       skip.
     1388   run waitfram-show in this-procedure ("Обработано чеков 0").
     1389   FOR EACH obj-list No-LOCK:
     1390   _chk-gds:
     1391   for each buf_chk-doc where buf_chk-doc.chk-date >= X-date-start and
     1392             buf_chk-doc.chk-date <= X-date-end and
     1393             buf_chk-doc.obj-code = obj-list.obj-code AND
     1394             buf_chk-doc.obj-type = obj-list.obj-type no-lock:
     1395       if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1396       accumulate buf_chk-doc.doc-code (COUNT).
     1397       if  (accum COUNT buf_chk-doc.doc-code ) modulo 10  = 0 then do:
     1398         run waitfram-show in this-procedure ("Обработано чеков " + string(accum count buf_chk-doc.doc-code)).
     1399       end.
     1400       IF RS-method = 1 and buf_chk-doc.out-code = ? then NEXT _chk-gds.
     1401       IF RS-method = 2 and buf_chk-doc.out-code <> ? then NEXT _chk-gds.
     1402       FOR EACH buf_chk-gds No-LOCK WHERE
     1403                buf_chk-gds.doc-code = buf_chk-doc.doc-code AND
     1404                buf_chk-gds.doc-qnty >= my-qnty,
     1405           FIRST buf_bar-code No-LOCK WHERE
     1406                 buf_bar-code.b-code = buf_chk-gds.b-code,
     1407           FIRST buf_goods NO-LOCK WHERE buf_goods.gds-code = buf_bar-code.gds-code:
     1408           if X-SelectGood = 4 AND
     1409           NOT can-FIND (FIRST gds-list where
     1410                               gds-list.artic = buf_goods.artic AND
     1411                               gds-list.Prod-type = buf_goods.prod-type AND
     1412                               gds-list.Prod-code = buf_goods.prod-code) then NEXT.
     1413           if choice = yes then do:
     1414               put stream PrnLibStream unformatted
     1415               buf_chk-doc.doc-code CHR(9)
     1416               buf_chk-doc.chk-date FORMAT "99/99/9999" CHR(9)
     1417               buf_chk-doc.pay-desk CHR(9)
     1418               buf_chk-doc.cashier CHR(9)
     1419               string(buf_chk-gds.b-code) FORMAT "X(10)" CHR(9)
     1420               buf_chk-gds.doc-qnty CHR(9)
     1421               (if X-selectgood = 1 then buf_goods.artic else gds-list.artic ) format "x(16)" CHR(9)
     1422               buf_chk-gds.price-base CHR(9)
     1423               buf_chk-gds.discnt CHR(9)
     1424               (buf_chk-gds.price-base - buf_chk-gds.discnt) * buf_chk-gds.doc-qnty CHR(9)
     1425               (if X-selectgood = 1
     1426                then string(buf_goods.prod-type + " " + string(buf_goods.prod-code, "999999999"))
     1427                else string(gds-list.prod-type + " " + string(gds-list.prod-code, "999999999"))
     1428               ) CHR(9)
     1429              (if X-selectgood = 1
     1430               then buf_goods.gds-name
     1431               else gds-list.gds-name)
     1432               skip.
     1433           end.
     1434           else do:
     1435               put stream PrnLibStream unformatted
     1436               buf_chk-doc.doc-code CHR(9)
     1437               buf_chk-doc.chk-date FORMAT "99/99/9999" CHR(9)
     1438               buf_chk-doc.pay-desk CHR(9)
     1439               buf_chk-doc.cashier
     1440               skip.
     1441               LEAVE.
     1442           end.
     1443       END.
     1444   end.
     1445   END.
     1446   run waitfram-hide in this-procedure .
     1447   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1448   output stream PrnLibStream CLOSE.
     1449   message "Отчет выведен в файл:" SKIP
     1450                   ReportFileName
     1451                   view-as alert-box INFORMATION buttons OK TITLE " ".
     1452   END PROCEDURE.
     1453   PROCEDURE My-var :
     1454   ASSIGN
     1455   frame F-Main choice
     1456   frame F-Main my-qnty
     1457   frame F-Main RS-method
     1458   .
     1459   ASSIGN
     1460   ReportName = "Чеки с товаром, количество которого превышает заданное"
     1461   ReportHeader = my-qnty:label +  string(my-qnty) + chr(10) +
     1462                  radio-label(string(RS-method), RS-method:radio-buttons) + chr(10) +
     1463                  if choice then Text-5 else "".
     1464   END PROCEDURE.
     1465   PROCEDURE send-records :
     1466   END PROCEDURE.
     1467   PROCEDURE state-changed :
     1468     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1469     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1470   END PROCEDURE.
