      580   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   define  stream PrnLibStream.
      582   procedure prn-lib-prn-file :
      583     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      584     define input parameter p-DIsabledoptions as integer no-undo .
      585     define variable v-report-name as character no-undo .
      586     define variable v-user-action as character no-undo .
      587     define variable v-printed     as logical   no-undo .
      588     define variable v-exist       as logical   no-undo .
      589     do
      590       on error undo, return error
      591       :
      592       run prn-lib-get-report-name  in this-procedure (
      593         input parParentProc
      594         ,output v-report-name
      595         ).
      596   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      598     (input  v-report-name
      599     ,input  2
      600     ,output v-exist
      601     )  .
      602       if NOT v-exist then
      603       DO:
      604         Message
      605           "Нет заданий на печать ! "
      606           view-as alert-box .
      607         Return  .
      608       End.
      609       run gbl/prnfilen.w
      610         (input  ""
      611         ,input  p-DisabledOptions
      612         ,input  string(v-report-name )
      613         ,input  7
      614         ,output v-user-action
      615         ,output v-printed
      616         ) .
      617       if v-printed then
      618       do:
      619         return "YES" .
      620       end.
      621       else
      622       do:
      623         return "NO" .
      624       end.
      625     end.
      626   end procedure.
      627   procedure prn-lib-open-stream :
      628     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      629     define input parameter p-page-size    as integer no-undo .
      630     define input parameter p-is-stream    as logical no-undo .
      631     define input parameter p-append       as logical no-undo .
      632     define variable v-report-name as character no-undo .
      633     do
      634       on error undo, return error
      635       :
      636       run prn-lib-get-report-name  in this-procedure (
      637         input parParentProc
      638         ,output v-report-name
      639         ).
      640       if p-is-stream then
      641       do:
      642         if p-append then
      643         do:
      644           output stream PrnLibStream to value( v-report-name )
      645             page-size value(p-page-size) append .
      646         end.
      647         if not p-append then
      648         do:
      649           output stream PrnLibStream to value( v-report-name )
      650             page-size value(p-page-size) .
      651         end.
      652       end.
      653       if not p-is-stream then
      654       do:
      655         if p-append then
      656         do:
      657           output to value( v-report-name )
      658             page-size value(p-page-size) append .
      659         end.
      660         if not p-append then
      661         do:
      662           output to value( v-report-name )
      663             page-size value(p-page-size) .
      664         end.
      665       end.
      666     end.
      667   end procedure.
      668   procedure prn-lib-open-exp :
      669     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      670     define input parameter p-is-stream    as logical no-undo .
      671     define input parameter p-is-append    as logical no-undo .
      672     define output parameter p-ReportFileName as char init "report" no-undo.
      673     define output parameter p-process as logical no-undo .
      674     define variable glog as logical no-undo .
      675     do
      676       on error undo, return error
      677       :
      678       SYSTEM-DIALOG GET-FILE p-ReportFileName
      679         TITLE      "Укажите путь"
      680         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      681         ASK-OVERWRITE
      682         CREATE-TEST-FILE
      683         SAVE-AS
      684         USE-FILENAME
      685         DEFAULT-EXTENSION "txt"
      686         UPDATE glog
      687         .
      688       if not glog then  return.
      689       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      690       if p-is-stream then
      691       do:
      692         if p-is-append then
      693         do:
      694           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      695         end.
      696         else
      697         do:
      698           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      699         end.
      700       end.
      701       else
      702       do:
      703         if p-is-append then
      704         do:
      705           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      706         end.
      707         else
      708         do:
      709           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      710         end.
      711       end.
      712       p-process = yes.
      713     end.
      714   end procedure.
      715   procedure prn-lib-get-report-name :
      716     define input parameter parParentProc  as widget-handle no-undo.
      717     define output parameter p-report-name as character no-undo .
      718     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      719   end procedure.
      720   procedure prn-lib-reportviewer-report-name :
      721     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      722     define input parameter p-report-name-html as character no-undo .
      723     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      724   end procedure.
      725   procedure prn-lib-reportviewer :
      726     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      727     define input parameter p-report-name-html as character no-undo .
      728     define input parameter p-param        as character no-undo .
      729     define variable v-excel           as character no-undo init 'TRUE' .
      730     define variable v-value-character as character no-undo .
      731     define variable v-value-integer   as character no-undo .
      732     define variable v-value-date      as date      no-undo .
      733     define variable v-value-decimal   as decimal   no-undo .
      734     define variable rep-excel         as logical   no-undo .
      735     define variable excel-string      as character no-undo .
      736     define variable v-param-type      as character no-undo .
      737     define variable v-tth             as handle    no-undo .
      738     run adm/shattri.p (
      739       input "get":U
      740       ,input  ""
      741       ,input  0
      742       ,input  'report-glob':U
      743       ,input  'rep-excel':U
      744       ,output v-value-character
      745       ,output v-value-date
      746       ,output v-value-decimal
      747       ,output v-value-integer
      748       ,output rep-excel
      749       ,output v-param-type
      750       ,INPUT-OUTPUT table-handle v-tth
      751       )  .
      752     if rep-excel then v-excel = "TRUE" .
      753     else v-excel = "FALSE" .
      754     if p-param eq ""
      755     then
      756        p-param = "EXCEL:" + v-excel.
      757     else
      758        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      759     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      760   end procedure.
      761   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   define variable v-waitfram-action01         as character   no-undo .
      763   define variable v-waitfram-action02         as character   no-undo .
      764   define variable v-waitfram-action03         as character   no-undo .
      765   define variable mWaitFramTextBeg            as character   no-undo.
      766   define variable mWaitFramTextEnd            as character   no-undo.
      767   define variable mWaitFramView               as logical     no-undo.
      768   define variable mWaitProcEvent              as logical     no-undo init yes.
      769   define variable mWaitFramInterval           as integer     no-undo init 1 .
      770   define variable mWaitFramStop               as logical     no-undo.
      771   define variable mWaitFramStopUser           as logical     no-undo.
      772   define variable mWaitFramStopTimeOut        as logical     no-undo.
      773   define variable mWaitFramStartProc          as datetime-tz no-undo.
      774   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      775   define button B-WaitFramStop auto-end-key
      776        label "Стоп"
      777        size 10 by 1 tooltip "Остоновить процесс".
      778   define button B-viewProcInfo
      779        label "Информация"
      780        size 15 by 1 tooltip "Информация о процесс".
      781   define frame waitfram
      782     v-waitfram-action01 format "x(72)" no-label skip
      783     v-waitfram-action02 format "x(72)" no-label skip
      784     v-waitfram-action03 format "x(72)" no-label skip
      785     B-viewProcInfo
      786     B-WaitFramStop at row 4 col 30
      787     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      788     .
      789   define new global shared variable mBatchMode as logical no-undo init ?.
      790   define variable mFramBachModHandle as handle no-undo.
      791   mFramBachModHandle = frame waitfram:handle.
      792   define variable mFameOldVis as logical no-undo.
      793   define variable mVisCUrentVin as logical no-undo.
      794   if session:batch-mode
      795   then
      796      mBatchMode = yes.
      797   if mBatchMode = ? then do:
      798     mVisCUrentVin = current-window:visible.
      799     mFameOldVis = mFramBachModHandle:visible.
      800     mFramBachModHandle:visible  = yes.
      801     mBatchMode = mFramBachModHandle:visible ne yes.
      802     mFramBachModHandle:visible = mFameOldVis.
      803     current-window:visible = mVisCUrentVin.
      804   end.
      805    if  log-manager:logfile-name ne ?
      806     then DO:
      807         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      808         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      809         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      810     end.
      811   on choose of B-WaitFramStop in frame waitfram
      812   do:
      813     mWaitFramStop = yes.
      814     mWaitFramStopUser = yes.
      815   end.
      816   function waitfram-check-timeout returns logical():
      817      define variable vtime as int64 no-undo.
      818      if mWaitFramStopTimeOut
      819      then
      820         return yes.
      821      vtime = ( now - mWaitFramStartProc ) / 1000 .
      822      if     mWaitFramTimeOut ne ?
      823         and mWaitFramTimeOut ne 0
      824         and mWaitFramTimeOut lt vtime
      825      then do:
      826         mWaitFramStopTimeOut = yes.
      827      end.
      828      return mWaitFramStopTimeOut.
      829   end.
      830   procedure waitfram-hide :
      831     if not session:batch-mode
      832     then do
      833     on error undo, return error return-value
      834     :
      835       pause 0 before-hide .
      836       if not mBatchMode then
      837         hide frame waitfram .
      838     if     not mWaitFramView
      839        and mWaitProcEvent
      840     then
      841       process events .
      842     end.
      843   end procedure.
      844   procedure waitfram-show :
      845     define input  parameter p-message as character no-undo .
      846     define variable v-left-margin as integer   no-undo .
      847     if not session:batch-mode
      848     then do
      849     on error undo, return error return-value
      850     :
      851       if length(p-message) <= 70 then do:
      852         assign
      853           v-left-margin = integer((70 - length(p-message)) / 2)
      854         .
      855         assign
      856           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      857         .
      858         assign
      859           v-waitfram-action01 = " "
      860           v-waitfram-action02 = " "
      861                                    + fill(" ", v-left-margin)
      862                                    + p-message
      863           v-waitfram-action03 = " "
      864         .
      865       end.
      866       else do:
      867         define variable vRindex1 as integer no-undo.
      868         define variable vRindex2 as integer no-undo.
      869         vRindex1 = r-index(p-message," ",70).
      870         if vRindex1 = 0
      871         then
      872            vRindex1 = 70.
      873         if length(p-message)  <= vRindex1 + 70 then do:
      874           assign
      875             v-waitfram-action01 = " "
      876             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      877             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      878           .
      879         end.
      880         else do:
      881           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      882           if vRindex2 <= vRindex1
      883           then
      884              vRindex2 = vRindex1 + 70.
      885           assign
      886             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      887             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      888             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      889           .
      890         end.
      891       end.
      892       B-viewProcInfo:visible   in frame waitfram = no.
      893       B-viewProcInfo:sensitive in frame waitfram = no.
      894       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      895       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      896       if  (   mWaitFramView
      897          or  mWaitProcEvent)
      898          and not mBatchMode
      899       then
      900          display
      901             v-waitfram-action01 skip
      902             v-waitfram-action02 skip
      903             v-waitfram-action03 skip
      904          with frame waitfram .
      905       if     mWaitFramView
      906          then do:
      907             if     mWaitFramInterval ne ?
      908                and not mBatchMode
      909             then
      910                wait-for go of frame waitfram pause mWaitFramInterval.
      911          end.
      912          else
      913             if     mWaitProcEvent
      914                and not mBatchMode
      915             then
      916                process events .
      917     end.
      918   end procedure.
      919      procedure waitfram-show-this:
      920         define input  parameter iInterval as int64 no-undo.
      921         define variable vtime as int64 no-undo.
      922         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      923         mWaitFramInterval = iInterval.
      924         run waitfram-show (substitute("&1&2 &3&4" ,
      925                                       mWaitFramTextBeg ,
      926                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      927                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      928                                       mWaitFramTextEnd
      929                                      )
      930                           ).
      931      end.
      932      procedure WaitFramRunPause:
      933         define input  parameter iInterval as dec no-undo.
      934         define variable vStart  as datetime-tz no-undo.
      935         define variable vend    as datetime-tz no-undo.
      936         define variable vint as int64 no-undo.
      937         define variable vOk as logical no-undo.
      938         vStart = now.
      939         vend   = vStart.
      940         publish "WaitFramPause" (iInterval,output vOk).
      941         vend   =  now.
      942         vint = vend - vStart.
      943         vint = iInterval - vint / 1000.
      944         if     not mWaitFramStop
      945            and (   vint > 0
      946                 or (    not vOk
      947                     and iInterval eq ?
      948                     )
      949                 )
      950         then
      951            run waitfram-show-this (iInterval).
      952         vend   =  now.
      953         vint = vend - vStart.
      954         vint = iInterval - vint / 1000.
      955         if     not mWaitFramStop
      956            and vint > 0
      957         then do:
      958            run gbl/pause.p (vint * 1000).
      959         end.
      960         if iInterval ne ?
      961         then
      962            publish "WaitFramStop".
      963         waitfram-check-timeout().
      964      end.
      965      procedure WaitFramWaitFor:
      966         define input  parameter iInterval as dec no-undo.
      967         assign
      968            mWaitFramStartProc   = now
      969            mWaitFramStopUser    = no
      970            mWaitFramStopTimeOut = no
      971         .
      972         block-wait:
      973         do while not mWaitFramStop:
      974            run WaitFramRunPause (iInterval).
      975            if  waitfram-check-timeout()
      976            then do:
      977               leave block-wait.
      978            end.
      979         end.
      980         run waitfram-hide.
      981      end.
      982   procedure waitfram-join :
      983     define input  parameter p-line-1  as character no-undo .
      984     define input  parameter p-line-2  as character no-undo .
      985     define input  parameter p-line-3  as character no-undo .
      986     define output parameter p-message as character no-undo .
      987     do
      988     on error undo, return error return-value
      989     :
      990       assign
      991         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      992                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      993                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      994       .
      995     end.
      996   end procedure.
      997   function waitfram-join-function returns character
      998     (input p-line-1 as character
      999     ,input p-line-2 as character
     1000     ,input p-line-3 as character
     1001     ).
     1002     define variable v-message as character no-undo .
     1003     run waitfram-join in this-procedure
     1004       (input  p-line-1
     1005       ,input  p-line-2
     1006       ,input  p-line-3
     1007       ,output v-message
     1008       ) .
     1009     return v-message .
     1010   end function .
     1011   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   procedure cur-time :
     1013      define output parameter p-today as date      no-undo .
     1014      define output parameter p-time  as integer   no-undo .
     1015     do
     1016     on error undo, return error
     1017     :
     1018       define variable v-date1 as date      no-undo .
     1019       define variable v-date2 as date      no-undo .
     1020       define variable v-time  as integer   no-undo .
     1021       assign
     1022         v-date1 = today
     1023         v-time  = time
     1024         v-date2 = today
     1025       .
     1026       if v-date1 <> v-date2
     1027       then do:
     1028         assign
     1029           v-date1 = today
     1030           v-time  = v-time
     1031         .
     1032       end.
     1033       assign
     1034         p-today = v-date1
     1035         p-time  = v-time
     1036       .
     1037     end.
     1038   end.
     1039   function cur-time-date returns character
     1040   :
     1041     return string(today, '99/99/9999':U) .
     1042   end.
     1043   function cur-time-mjd returns decimal
     1044   :
     1045     define variable v-date as date      no-undo .
     1046     define variable v-time as integer   no-undo .
     1047     run cur-time in this-procedure
     1048       (output v-date
     1049       ,output v-time
     1050       ) .
     1051     return integer(v-date) - 2400002 + (v-time / 86400) .
     1052   end.
     1053   function cur-time-get-ending-index returns integer
     1054   (input p-number as integer
     1055   )
     1056   :
     1057     if p-number < 0
     1058     or p-number = ?
     1059     then do:
     1060       return 1 .
     1061     end.
     1062     define variable v-rest as integer   no-undo .
     1063     assign
     1064       p-number = p-number modulo 100
     1065     .
     1066     if p-number < 20
     1067     then do:
     1068       assign
     1069         v-rest = p-number
     1070       .
     1071     end.
     1072     else do:
     1073       assign
     1074         v-rest = p-number modulo 10
     1075       .
     1076     end.
     1077     case v-rest :
     1078       when 1
     1079       then do:
     1080         return 2 .
     1081       end.
     1082       when 2 or
     1083       when 3 or
     1084       when 4
     1085       then do:
     1086         return 3 .
     1087       end.
     1088       otherwise do:
     1089         return 1 .
     1090       end.
     1091     end case .
     1092   end.
     1093   procedure cur-time-mjd-to-date :
     1094      define input  parameter i-mjd-diff as decimal no-undo.
     1095      define output parameter o-Date     as date    no-undo.
     1096      define output parameter o-Time     as integer no-undo.
     1097      define variable v-day-number as integer   no-undo .
     1098      if    i-mjd-diff < 0
     1099         or i-mjd-diff = ?
     1100      then do:
     1101         return "?" .
     1102      end.
     1103      assign
     1104         v-day-number = truncate(i-mjd-diff,0).
     1105         o-Date = date(v-day-number + 2400002).
     1106         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1107     .
     1108   end.
     1109   function cur-time-mjd-to-string returns character
     1110   (input p-mjd-diff as decimal
     1111   )
     1112   :
     1113     define variable v-day-number as integer   no-undo .
     1114     define variable v-seconds    as integer   no-undo .
     1115     define variable v-hour       as integer   no-undo .
     1116     define variable v-min        as integer   no-undo .
     1117     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1118     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1119     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1120     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1121     if p-mjd-diff < 0
     1122     or p-mjd-diff = ?
     1123     then do:
     1124       return "?" .
     1125     end.
     1126     assign
     1127       v-day-number = integer(truncate(p-mjd-diff,0))
     1128       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1129     .
     1130     if v-seconds > 86400
     1131     then do:
     1132       assign
     1133         v-seconds = 86400 - 1
     1134       .
     1135     end.
     1136     if v-seconds < 0
     1137     then do:
     1138       assign
     1139         v-seconds = 0
     1140       .
     1141     end.
     1142     assign
     1143       v-hour = truncate(v-seconds / 3600, 0)
     1144     .
     1145     assign
     1146       v-seconds = v-seconds modulo 3600
     1147     .
     1148     assign
     1149       v-min = truncate(v-seconds / 60, 0)
     1150     .
     1151     assign
     1152       v-seconds = v-seconds modulo 60
     1153     .
     1154     return
     1155         (if v-day-number <> 0
     1156           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1157           else ""
     1158         )
     1159       + (if v-day-number <> 0 or v-hour <> 0
     1160           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1161           else ""
     1162         )
     1163       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1164           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1165           else ""
     1166         )
     1167       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1168       .
     1169   end.
     1170   function cur-time-string returns character
     1171   :
     1172     define variable v-date as date      no-undo .
     1173     define variable v-time as integer   no-undo .
     1174     run cur-time in this-procedure
     1175       (output v-date
     1176       ,output v-time
     1177       ) .
     1178     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1179   end.
     1180   function cur-time-string-sec returns character
     1181   :
     1182     define variable v-date as date      no-undo .
     1183     define variable v-time as integer   no-undo .
     1184     run cur-time in this-procedure
     1185       (output v-date
     1186       ,output v-time
     1187       ) .
     1188     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1189   end.
     1190   function cur-time-custom  returns character
     1191   (input p-prefix as character
     1192   ,input p-date-format as character
     1193   ,input p-delimiter as character
     1194   ,input p-time-format as character
     1195   ,input p-suffix as character
     1196   )
     1197   :
     1198     define variable v-date as date      no-undo .
     1199     define variable v-time as integer   no-undo .
     1200     run cur-time in this-procedure
     1201       (output v-date
     1202       ,output v-time
     1203       ) .
     1204     return
     1205       p-prefix
     1206       + string(v-date, p-date-format)
     1207       + p-delimiter
     1208       + string(v-time, p-time-format)
     1209       + p-suffix
     1210       .
     1211   end.
     1212   function cur-time-print  returns character
     1213   :
     1214     define variable v-date as date      no-undo .
     1215     define variable v-time as integer   no-undo .
     1216     run cur-time in this-procedure
     1217       (output v-date
     1218       ,output v-time
     1219       ) .
     1220     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1221   end.
     1222   function cur-time-datetime returns datetime
     1223   :
     1224     define variable v-char as character no-undo .
     1225     define variable v-datetime as datetime no-undo .
     1226     v-char = cur-time-string().
     1227     v-datetime = datetime(v-char).
     1228     return  v-datetime.
     1229   end.
     1230   function cur-time-string-msec returns character
     1231   :
     1232     define variable v-date as datetime  no-undo .
     1233     v-date = now.
     1234     return string(v-date) .
     1235   end.
     1236   define temp-table temp-goods no-undo
     1237   field gds-code like ub.goods.gds-code
     1238   field gds-name like ub.goods.gds-name
     1239   field netto like ub.inkas.netto
     1240   .
     1241   DEFINE VARIABLE v-main-code like ub.bar-code.b-code no-undo .
     1242   DEFINE VARIABLE v-nn as integer no-undo .
     1243   DEFINE VARIABLE line as character no-undo .
     1244   DEFINE VARIABLE date_string as character no-undo .
     1245   DEFINE VARIABLE for-time as character no-undo .
     1246   DEFINE VARIABLE accum-count as integer no-undo .
     1247   DEFINE VARIABLE accum-netto as decimal no-undo .
     1248   DEFINE VARIABLE accum-slt-sum as decimal no-undo .
     1249   DEFINE VARIABLE accum-agent-profit as decimal no-undo .
     1250   DEFINE VARIABLE accum-principial-profit as decimal no-undo .
     1251   DEFINE VARIABLE v-slt-sum like ub.inkas.netto no-undo .
     1252   DEFINE VARIABLE v-without-slt-sum like ub.inkas.netto no-undo .
     1253   DEFINE VARIABLE v-agent-profit as decimal no-undo .
     1254   DEFINE VARIABLE v-principial-profit as decimal no-undo .
     1255   define variable v-header-base-curr as character no-undo .
     1256   define variable v-base-code like ub.sysconf.base-code no-undo .
     1257   define buffer buf_chk-gds  for ub.chk-gds.
     1258   define buffer buf_chk-doc  for ub.chk-doc.
     1259   define buffer buf_sysconf  for ub.sysconf.
     1260   define buffer buf_currency for ub.currency.
     1261   define buffer buf_clients for ub.clients.
     1262   define variable v-curr-r-b as character no-undo .
     1263   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1264   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1265     (output v-curr-r-b
     1266     )  .
     1267   if v-curr-r-b = 'base':U then do:
     1268   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1269   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1270     (input  p-curr-host-code
     1271     ,output v-base-code
     1272     )  .
     1273     find first buf_currency no-lock where
     1274             buf_currency.curr-code = v-base-code.
     1275     assign
     1276     v-header-base-curr = string( "( Б.Вал. - " + caps( buf_currency.curr-abbr) + " )" )
     1277     .
     1278   end.
     1279   find first buf_clients where
     1280               buf_clients.obj-type = 'орг':U
     1281           AND buf_clients.obj-code = p-curr-host-code.
     1282   DEFINE FRAME Chk-List
     1283   v-nn                      column-label "№"           format ">>9"
     1284   temp-goods.gds-name       column-label "Наименование фирмы (принципиала)" format "X(35)"
     1285   temp-goods.netto          column-label "Сумма продаж"
     1286   v-slt-sum                 column-label "В том числе сумма НсП"
     1287   v-without-slt-sum         column-label "Сумма продаж без НсП"
     1288   v-agent-profit            column-label "Сумма агентского!вознаграждения"
     1289   v-principial-profit       column-label "Сумма подлежащая!перечисл. принцип-лу" format "->>>,>>>,>>9.99"
     1290   HEADER  date_string AT 1 format "X(35)"
     1291   v-header-base-curr       format "X(20)"
     1292   string( "Страница " ) format "X(9)" AT 59 PAGE-NUMBER(PrnLibStream) AT 69 FORMAT ">>9" SKIP
     1293   Line format "X(136)" AT 1
     1294   with width 232 down stream-io use-text    .
     1295   run fill-table in this-procedure .
     1296   if not can-find(first temp-goods ) then do:
     1297     return "no-data":U.
     1298   end.
     1299   Line = fill("-", 136).
     1300   date_string = cur-time-print() .
     1301   find first buf_sysconf no-lock where
     1302              buf_sysconf.host-code = p-curr-host-code.
     1303   assign
     1304   Sheetf.Excel-Column-Lable =
     1305   "№" + chr(44) +
     1306   "Наименование фирмы (принципиала)" + chr(44) +
     1307   "Сумма продаж" + chr(44) +
     1308   "В том числе сумма НсП" + chr(44) +
     1309   "Сумма продаж без НсП" + chr(44) +
     1310   "Сумма агентского вознаграждения" + chr(44) +
     1311   "Сумма подлежащая перечислению принципиалу"
     1312   sheetf.sizes =
     1313   "3" + chr(44) +
     1314   "35" + chr(44) +
     1315   "18" + chr(44) +
     1316   "18" + chr(44) +
     1317   "18" + chr(44) +
     1318   "18" + chr(44) +
     1319   "18"
     1320   .
     1321   run prn-lib-open-stream  in this-procedure (
     1322                                                input parParentProc
     1323                                               ,input 62
     1324                                               ,input yes
     1325                                               ,input no
     1326                                               ).
     1327   run rep/extitle.p (1).
     1328   FORM with FRAME CHk-list .
     1329   PUT stream PrnLibStream UNFORMATTED
     1330   SPACE(10)
     1331   p-Report-header
     1332   SKIP(1).
     1333   FORM HEADER
     1334   Line format "X(136)" AT 1 SKIP
     1335   "Продолжение - на следующей странице" AT 30 SKIP
     1336   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     1337   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     1338   FORM with FRAME Chk-List  .
     1339   run waitfram-show in this-procedure ("Ждите...").
     1340   for each temp-goods no-lock :
     1341     assign
     1342     v-nn = v-nn + 1
     1343     v-slt-sum = (if T-slt-sum
     1344                 then temp-goods.netto / (100 + f-slt-pc ) * f-slt-pc
     1345                 else 0)
     1346     v-without-slt-sum = temp-goods.netto - v-slt-sum
     1347     v-agent-profit = temp-goods.netto * 0.01
     1348     v-principial-profit = temp-goods.netto - v-slt-sum - v-agent-profit
     1349     accum-netto = accum-netto + temp-goods.netto
     1350     accum-count      = accum-count + 1
     1351     accum-slt-sum = accum-slt-sum + v-slt-sum
     1352     accum-agent-profit = accum-agent-profit + v-agent-profit
     1353     accum-principial-profit = accum-principial-profit + v-principial-profit
     1354     .
     1355     display stream PrnLibStream
     1356     v-nn
     1357     temp-goods.gds-name
     1358     temp-goods.netto
     1359     v-slt-sum
     1360     v-without-slt-sum
     1361     v-agent-profit
     1362     v-principial-profit
     1363     with frame chk-list.
     1364     DOWN STREAM PrnLibStream 1
     1365     with FRAME CHk-List  .
     1366     if Make-Excel then  put   stream ForExcel unformatted
     1367     v-nn                     CHR(9)
     1368     temp-goods.gds-name      CHR(9)
     1369     temp-goods.netto         CHR(9)
     1370     v-slt-sum                CHR(9)
     1371     v-without-slt-sum        CHR(9)
     1372     v-agent-profit           CHR(9)
     1373     v-principial-profit
     1374     skip.
     1375   end.
     1376   underline stream PrnLibStream
     1377   v-nn
     1378   temp-goods.gds-name
     1379   temp-goods.netto
     1380   v-slt-sum
     1381   v-without-slt-sum
     1382   v-agent-profit
     1383   v-principial-profit
     1384   with frame chk-list.
     1385   DOWN STREAM PrnLibStream 1
     1386   with FRAME CHk-List  .
     1387   assign
     1388   v-slt-sum = accum-slt-sum
     1389   v-agent-profit = accum-agent-profit
     1390   v-principial-profit = accum-principial-profit
     1391   v-without-slt-sum = accum-netto - v-slt-sum
     1392   .
     1393   display stream PrnLibStream
     1394   "Итого" + chr(32) + string(accum-count) + chr(32) + "фирм" @ temp-goods.gds-name
     1395   accum-netto @ temp-goods.netto
     1396   v-slt-sum
     1397   v-without-slt-sum
     1398   v-agent-profit
     1399   v-principial-profit
     1400   with frame chk-list.
     1401   DOWN STREAM PrnLibStream 1
     1402   with FRAME CHk-List  .
     1403   if Make-Excel then  put   stream ForExcel unformatted
     1404   CHR(9)
     1405   ("Итого" + chr(32) + string(accum-count) + chr(32) + "фирм")  CHR(9)
     1406   accum-netto                                                               CHR(9)
     1407   v-slt-sum                                                                 CHR(9)
     1408   v-without-slt-sum                                                         CHR(9)
     1409   v-agent-profit                                                            CHR(9)
     1410   v-principial-profit
     1411   skip.
     1412   put stream PrnLibStream unformatted
     1413   skip(2)
     1414   "Главный бухгалтер фирмы" chr(32)
     1415   buf_clients.obj-name fill(chr(32), 5)
     1416   buf_sysconf.snr-accnt chr(32) fill("_", 15)
     1417   skip(0)
     1418   fill(chr(32), 30 + length(buf_clients.obj-name) + length(buf_sysconf.snr-accnt))
     1419   "(подпись)"
     1420   skip(0)
     1421   fill(chr(32), 30 + length(buf_clients.obj-name) + length(buf_sysconf.snr-accnt)) "М.П."
     1422   skip.
     1423   if Make-Excel then  put   stream ForExcel unformatted
     1424   skip(2)
     1425                                                       CHR(9)
     1426   ("Главный бухгалтер фирмы" + chr(32) +
     1427    buf_clients.obj-name + chr(32))                       CHR(9)
     1428                                                       CHR(9)
     1429                                                       CHR(9)
     1430   buf_sysconf.snr-accnt                               CHR(9)
     1431                                                       CHR(9)
     1432   SKIP(0)
     1433                                                      CHR(9)
     1434                                                      CHR(9)
     1435                                                      CHR(9)
     1436                                                      CHR(9)
     1437                                                      CHR(9)
     1438   "(подпись)"                                        CHR(9)
     1439   skip(0)
     1440                                                      CHR(9)
     1441                                                      CHR(9)
     1442                                                      CHR(9)
     1443                                                      CHR(9)
     1444                                                      CHR(9)
     1445    "М.П."                                            CHR(9)
     1446   skip.
     1447   HIDE STREAM PrnLibStream FRAME Chk-list .
     1448   HIDE STREAM PrnLibStream FRAME top-Frame .
     1449   HIDE stream PrnLibStream FRAME BottomFrame .
     1450   output stream PrnLibStream CLOSE .
     1451   if Make-Excel then output stream ForExcel close.
     1452   run waitfram-hide in this-procedure .
     1453   run prn-lib-prn-file in this-procedure (
     1454                                             input parParentProc
     1455                                             ,input 0
     1456                                             ).
     1457   procedure fill-table :
     1458     do
     1459     on error undo, return error
     1460     :
     1461       for each temp-goods :
     1462         delete temp-goods.
     1463       end.
     1464       for each gds-list  no-lock :
     1465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1466     (input  gds-list.gds-code
     1467     ,input  ?
     1468     ,output v-main-code
     1469     ) no-error .
     1470         if error-status:error then do:
     1471           undo, return error.
     1472         end.
     1473         for each obj-list no-lock:
     1474           _chk-gds:
     1475           for each buf_chk-gds no-lock where
     1476                   buf_chk-gds.b-code = v-main-code,
     1477             FIRST buf_chk-doc No-LOCK WHERE
     1478                   buf_chk-doc.doc-code = buf_chk-gds.doc-code
     1479               AND buf_chk-doc.obj-type = obj-list.obj-type
     1480               AND buf_chk-doc.obj-code = obj-list.obj-code
     1481               AND buf_chk-doc.chk-date >= X-date-start
     1482               AND buf_chk-doc.chk-date <= X-date-end:
     1483             if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-gds.
     1484             find first temp-goods no-lock where
     1485                       temp-goods.gds-code = gds-list.gds-code no-error .
     1486             if not avail temp-goods then do:
     1487               create temp-goods.
     1488               assign
     1489               temp-goods.gds-code = gds-list.gds-code
     1490               temp-goods.gds-name = gds-list.gds-name
     1491               .
     1492             end.
     1493             assign
     1494             temp-goods.netto = temp-goods.netto + buf_chk-gds.doc-qnty * (buf_chk-gds.price-base - buf_chk-gds.discnt)
     1495             .
     1496           end.
     1497         end.
     1498       end.
     1499     end.
     1500   end procedure.
