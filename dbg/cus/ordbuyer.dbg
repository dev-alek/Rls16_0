      893   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      894   procedure fltopend_fltopend :
      895   define input parameter p-parent-handle as handle no-undo .
      896   define input parameter p-qh as handle no-undo .
      897   define input parameter p-flt-open-open-query  as character no-undo .
      898   define input parameter p-where-cond as character no-undo .
      899   define input parameter p-use-indFIRST-query-tail as character no-undo .
      900   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      901   define input parameter p-indexed-reposition as character no-undo .
      902     do
      903     on error undo, return error
      904     :
      905   define variable v-prepare-string as character no-undo .
      906   define variable glog as logical no-undo .
      907   assign
      908   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      909                      p-where-cond + chr(32)  +
      910                      p-use-indFIRST-query-tail + chr(32) +
      911                      p-use-ind-sort-clmn-by + chr(32) +
      912                      p-indexed-reposition
      913   .
      914   assign
      915   glog = p-qh:query-prepare(v-prepare-string) no-error .
      916   if not glog
      917   or error-status:error then do:
      918     message error-status:get-message(1) view-as alert-box .
      919     undo, return error .
      920   end.
      921   assign
      922   glog = p-qh:query-open no-error .
      923   if not glog
      924   or error-status:error then do:
      925     message error-status:get-message(1) view-as alert-box .
      926     undo, return error .
      927   end.
      928     end.
      929   end procedure.
      930   procedure fltopend_fltfindd :
      931   define input parameter p-parent-handle as handle no-undo .
      932   define input parameter p-qh as handle no-undo .
      933   define input parameter p-rowid as rowid no-undo .
      934   define input parameter p-next as logical no-undo .
      935   define input parameter p-lock as integer no-undo .
      936   define input parameter p-bh as handle no-undo .
      937   define input parameter p-where-cond as character no-undo .
      938   define input parameter p-use-index-phrase as character no-undo .
      939   define variable glog as logical no-undo .
      940   define variable v-qh as handle no-undo .
      941   define variable v-bh as handle no-undo .
      942   define variable v-recid as recid no-undo .
      943   define variable v-prepare-string as character no-undo .
      944   do
      945   on error undo, return error
      946   on stop undo, return error
      947   :
      948     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      949     create buffer v-bh for table p-bh buffer-name p-bh:name.
      950     create query v-qh.
      951     v-qh:set-buffers(v-bh).
      952     v-prepare-string = substitute("for each &1 &2 &3"
      953                                     ,v-bh:name
      954                                     ,p-where-cond
      955                                     ,p-use-index-phrase).
      956     glog = v-qh:query-prepare(v-prepare-string) no-error.
      957     if not glog then do:
      958       delete object v-qh.
      959       delete object v-bh.
      960       undo, return error .
      961     end.
      962     glog = v-qh:query-open no-error .
      963     if not glog then do:
      964       delete object v-qh.
      965       delete object v-bh.
      966       undo, return error .
      967     end.
      968     if p-next then do:
      969       v-qh:reposition-to-rowid(p-rowid) no-error .
      970       glog = v-qh:get-next( p-lock) no-error .
      971       glog = v-qh:get-next( p-lock) no-error .
      972       if not glog or v-qh:query-off-end = yes then do:
      973         glog = v-qh:get-first( p-lock) no-error .
      974       end.
      975     end.
      976     else do:
      977       glog = v-qh:get-first( p-lock) no-error .
      978     end.
      979     v-recid = v-bh:recid no-error .
      980     delete object v-qh.
      981     delete object v-bh.
      982     return string(v-recid) .
      983   end.
      984   end procedure.
      985   procedure fltopend_fltfindq :
      986   define input parameter p-parent-handle as handle no-undo .
      987   define input parameter p-qh as handle no-undo .
      988   define input parameter p-next as logical no-undo .
      989   define input parameter p-lock as integer no-undo .
      990   define input parameter p-flt-open-open-query  as character no-undo .
      991   define input parameter p-where-cond as character no-undo .
      992   define input parameter p-use-indFIRST-query-tail as character no-undo .
      993   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      994   define input parameter p-indexed-reposition as character no-undo .
      995   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      996   define variable glog as logical no-undo .
      997   define variable v-qh as handle no-undo .
      998   define variable v-bh as handle no-undo extent 18.
      999   define variable v-rowid as rowid no-undo extent 18.
     1000   define variable v-ii as integer no-undo .
     1001   define variable v-prepare-string as character no-undo .
     1002   do
     1003   on error undo, return error
     1004   on stop undo, return error
     1005   :
     1006     create query v-qh.
     1007     do v-ii = 1 to p-qh:num-buffers:
     1008       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1009       assign
     1010       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1011       no-error.
     1012       v-qh:add-buffer(v-bh[v-ii]).
     1013     end.
     1014     assign
     1015     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1016                       p-where-cond + chr(32)  +
     1017                       p-use-indFIRST-query-tail + chr(32) +
     1018                       p-use-ind-sort-clmn-by + chr(32) +
     1019                       p-indexed-reposition
     1020     .
     1021     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1022     if not glog then do:
     1023       delete object v-qh.
     1024       do v-ii = 1 to p-qh:num-buffers:
     1025         delete object v-bh[v-ii].
     1026       end.
     1027       undo, return error .
     1028     end.
     1029     glog = v-qh:query-open no-error .
     1030     if not glog then do:
     1031       delete object v-qh.
     1032       do v-ii = 1 to p-qh:num-buffers:
     1033         delete object v-bh[v-ii].
     1034       end.
     1035       undo, return error .
     1036     end.
     1037     if p-next then do:
     1038       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1039       glog = v-qh:get-next( p-lock) no-error .
     1040       glog = v-qh:get-next( p-lock) no-error .
     1041       if not glog or v-qh:query-off-end = yes then do:
     1042         glog = v-qh:get-first( p-lock) no-error .
     1043       end.
     1044     end.
     1045     else do:
     1046       glog = v-qh:get-first( p-lock) no-error .
     1047     end.
     1048     do v-ii = 1 to p-qh:num-buffers:
     1049       assign
     1050       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1051       no-error.
     1052     end.
     1053     delete object v-qh.
     1054     do v-ii = 1 to p-qh:num-buffers:
     1055       delete object v-bh[v-ii].
     1056     end.
     1057   end.
     1058   end procedure.
