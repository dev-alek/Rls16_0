     4215   run fltfield-add in this-procedure('boss'                          , 'Менеджер'   , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4216   run fltfield-add in this-procedure('wrkr'                          , 'Кладовщик'  , 'cli',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4217   run fltfield-add in this-procedure('creid'                         , 'Создал'     , 'usr',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4218   run fltfield-add in this-procedure('host-code'                     , 'Фирма'      , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4219   run fltfield-add in this-procedure('pay-code'                      , 'Код оплаты' , 'pay',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4220   run fltfield-add in this-procedure('ship-date'                     , 'Дата отгрузки' , '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4221   run fltfield-add in this-procedure('ship-time'                     , 'Время отгрузки', 'time',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4222   run fltfield-add in this-procedure('PS'                            , 'Примечание', '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4223   run fltfield-add in this-procedure('buyer-out-code'                 , '', '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4224   run fltfield-add in this-procedure('contract-code'                  , 'Вн.№ договора', '',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4225   run fltfield-add in this-procedure('exch-code'                      , 'Валюта','curr',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4226   run fltfield-add in this-procedure('user-name'                      , 'Правил', 'usr',input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4227   Filter-Block:
     4228   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4229       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4230       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4231     run gbl/filter.w ( input parParentProc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     4232     run openbr in this-procedure (yes, no, '':U).
     4233   END.
     4234     end.
     4235   END PROCEDURE.
     4236   PROCEDURE proc-sch-code :
     4237    do
     4238    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4239    :
     4240   define input parameter par-next as logical no-undo.
     4241   define input parameter pardoc-code as character  no-undo.
     4242   display "" @ sch-date with frame Dialog-Frame.
     4243   display "" @ sch-fact with frame Dialog-Frame.
     4244   assign
     4245     pardoc-code = chr(34) + pardoc-code + chr(34) .
     4246   run OpenBr in this-procedure
     4247       (input false
     4248       ,input par-next
     4249       ,input substitute("and buf-po_ord-doc.doc-code begins &1 "
     4250         , pardoc-code)
     4251       ).
     4252    apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     4253     end.
     4254   END PROCEDURE.
     4255   PROCEDURE proc-sch-date :
     4256    do
     4257    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4258    :
     4259   define input parameter par-next as logical no-undo.
     4260   define input parameter pardoc-code as date no-undo.
     4261   define variable ppp as character no-undo .
     4262   display "" @ sch-fact with frame Dialog-Frame.
     4263   display "" @ sch-code with frame Dialog-Frame.
     4264   ppp =  string( day(pardoc-code)) + "/" +  string( month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
     4265   run OpenBr in this-procedure
     4266       (input false
     4267       ,input par-next
     4268       ,input substitute("and buf-po_ord-doc.doc-date = &1 "
     4269         , ppp )
     4270       ) no-error .
     4271       if error-status :error or return-value = ? then
     4272          message "За эту дату не найдено ни одной записи !" view-as alert-box .
     4273   apply "VALUE-CHANGED" to br-docs  in frame Dialog-Frame.
     4274     end.
     4275   END PROCEDURE.
     4276   PROCEDURE proc-sch-fact :
     4277    do
     4278    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4279    :
     4280   define input parameter par-next as logical no-undo.
     4281   define input parameter pardoc-code as date no-undo.
     4282   define variable ppp as character no-undo .
     4283   display "" @ sch-date with frame Dialog-Frame.
     4284   display "" @ sch-code with frame Dialog-Frame.
     4285   ppp =  string( day(pardoc-code)) + "/" +  string( month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
     4286   run OpenBr in this-procedure
     4287       (input false
     4288       ,input par-next
     4289       ,input substitute("and buf-po_ord-doc.fact-date = &1 "
     4290         , ppp )
     4291       ) no-error .
     4292       if error-status :error then
     4293          message "За эту дату не найдено ни одной записи !" view-as alert-box .
     4294   apply "VALUE-CHANGED" to br-docs  in frame Dialog-Frame.
     4295     end.
     4296   END PROCEDURE.
     4297   PROCEDURE UI-on :
     4298    do
     4299    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4300    :
     4301    run openbr in this-procedure ( yes, no, '':u).
     4302     end.
     4303   END PROCEDURE.
     4304   FUNCTION f-direct RETURNS CHARACTER
     4305   (input  p-rec as recid ) :
     4306   define variable v-res as character no-undo .
     4307   define variable v-res-0 as character no-undo .
     4308   define buffer fl for ub.ord-doc .
     4309   find first fl no-lock where recid(fl) = p-rec no-error .
     4310   if error-status :error then return chr(42) .
     4311   v-res = chr(42) .
     4312   v-res-0 = chr(32) .
     4313   if v-cntxt-db-num = 0 then
     4314       if fl.order-type = 3  then return v-res.
     4315         else return v-res-0 .
     4316   else
     4317      if fl.order-type = 2  then return v-res.
     4318         else return v-res-0 .
     4319   END FUNCTION.
     4320   FUNCTION mark-string RETURNS CHARACTER
     4321   ( input p-rec as recid , input m as char):
     4322   define buffer fl for ub.ord-doc .
     4323   find first fl no-lock where recid(fl) = p-rec no-error .
     4324   if error-status :error then return  chr(32) .
     4325   if lookup(string(recid(fl)),m) > 0 then return chr(42).
     4326   else return chr(32).
     4327   END FUNCTION.
