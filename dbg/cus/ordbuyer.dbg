     2158   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2159   define temp-table temp-diasize-handle no-undo
     2160     field handle-value  as handle
     2161     field save-position as decimal
     2162     index xpk is primary unique handle-value
     2163     .
     2164   define temp-table temp-browse-handle no-undo
     2165     field browse-type   as character
     2166     field browse-number as integer
     2167     field browse-handle as handle
     2168     field original-size as decimal
     2169     index xpk is primary unique browse-type browse-number
     2170     index xie browse-type browse-handle
     2171   .
     2172   procedure diasize_change-height :
     2173     define input  parameter p-change-value  as decimal   no-undo .
     2174     define input  parameter p-move-resize   as logical   no-undo .
     2175     define variable v-field-group-handle    as handle    no-undo .
     2176     define variable v-object-handle         as handle    no-undo .
     2177     define variable v-frame-height          as decimal   no-undo .
     2178     define variable v-frame-virtual-height  as decimal   no-undo .
     2179     define variable v-browse-height         as decimal   no-undo .
     2180     define variable v-window-height         as decimal   no-undo .
     2181     define variable v-window-virtual-height as decimal   no-undo .
     2182     define variable v-change-sign           as integer   no-undo .
     2183     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2184     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2185     if p-change-value > 0
     2186     then do:
     2187       if frame Dialog-Frame :height + p-change-value
     2188           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2189       then do:
     2190         assign
     2191           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2192                           - (frame Dialog-Frame :height-chars)
     2193         .
     2194         if p-change-value <= 0
     2195         then do:
     2196           run diasize_position-resize-button in this-procedure .
     2197           return .
     2198         end.
     2199       end.
     2200     end.
     2201     if p-change-value < 0
     2202     then do:
     2203       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2204       then do:
     2205         assign
     2206           p-change-value = v-diasize-orig-frame-height
     2207                          - (frame Dialog-Frame :height-chars)
     2208         .
     2209         if p-change-value >= 0
     2210         then do:
     2211           run diasize_position-resize-button in this-procedure .
     2212           return .
     2213         end.
     2214       end.
     2215     end.
     2216     if p-change-value >= 0
     2217     then do:
     2218       assign
     2219         v-change-sign = 1
     2220       .
     2221     end.
     2222     else do:
     2223       assign
     2224         v-change-sign = -1
     2225       .
     2226     end.
     2227     assign
     2228       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2229     .
     2230     if p-change-value = 0
     2231     then do:
     2232       run diasize_position-resize-button in this-procedure .
     2233       return .
     2234     end.
     2235     move_block:
     2236     do
     2237     on error undo move_block, retry move_block
     2238     :
     2239       if retry
     2240       then do:
     2241         do
     2242         on error undo move_block, leave move_block
     2243         :
     2244           if p-change-value > 0
     2245           then do:
     2246             for each buf_temp-diasize-handle
     2247             on error undo, next
     2248             :
     2249               assign
     2250                 v-object-handle = buf_temp-diasize-handle.handle-value
     2251               .
     2252               if v-object-handle <> v-diasize-resize-button
     2253               then do:
     2254                 assign
     2255                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2256                 .
     2257               end.
     2258             end.
     2259             assign
     2260               v-diasize-browse-handle :height = v-browse-height
     2261             .
     2262             for each buf_temp-browse-handle
     2263               where buf_temp-browse-handle.browse-type = 'height':u
     2264             on error undo, next
     2265             :
     2266               assign
     2267                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2268               .
     2269             end.
     2270             assign
     2271               frame Dialog-Frame :height = v-frame-height
     2272             .
     2273             if frame Dialog-Frame :scrollable = true
     2274             then do:
     2275               assign
     2276                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2277               .
     2278             end.
     2279             run diasize_position-resize-button in this-procedure .
     2280           end.
     2281           else do:
     2282             if frame Dialog-Frame :scrollable = true
     2283             then do:
     2284               assign
     2285                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2286               .
     2287             end.
     2288             assign
     2289               frame Dialog-Frame :height = v-frame-height
     2290             .
     2291             assign
     2292               v-diasize-browse-handle :height = v-browse-height
     2293             .
     2294             for each buf_temp-browse-handle
     2295               where buf_temp-browse-handle.browse-type = 'height':u
     2296             on error undo, next
     2297             :
     2298               assign
     2299                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2300               .
     2301             end.
     2302             for each buf_temp-diasize-handle
     2303             on error undo, next
     2304             :
     2305               assign
     2306                 v-object-handle = buf_temp-diasize-handle.handle-value
     2307               .
     2308               if v-object-handle <> v-diasize-resize-button
     2309               then do:
     2310                 assign
     2311                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2312                 .
     2313               end.
     2314             end.
     2315             run diasize_position-resize-button in this-procedure .
     2316           end.
     2317           assign
     2318             v-diasize-change-size = false
     2319           .
     2320           leave move_block .
     2321         end.
     2322       end.
     2323       assign
     2324         v-diasize-need-full-display = true
     2325       .
     2326       if v-diasize-change-size = false
     2327       then do:
     2328         assign
     2329           v-diasize-change-size = true
     2330         .
     2331       end.
     2332       else do:
     2333         return .
     2334       end.
     2335       assign
     2336         v-frame-height = frame Dialog-Frame :height
     2337         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2338         v-browse-height = v-diasize-browse-handle :height
     2339       .
     2340       for each buf_temp-browse-handle
     2341         where buf_temp-browse-handle.browse-type = 'height':u
     2342       :
     2343         assign
     2344           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2345         .
     2346       end.
     2347       for each buf_temp-diasize-handle
     2348       :
     2349         delete buf_temp-diasize-handle .
     2350       end.
     2351       assign
     2352         v-field-group-handle = frame Dialog-Frame :first-child
     2353       .
     2354       do while valid-handle(v-field-group-handle)
     2355       :
     2356         assign
     2357           v-object-handle = v-field-group-handle :first-child
     2358         .
     2359         do while valid-handle(v-object-handle)
     2360         :
     2361           if  v-object-handle <> v-diasize-browse-handle :handle
     2362           and can-query(v-object-handle, "row")
     2363           and can-query(v-object-handle, "height")
     2364           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2365           then do:
     2366             find first buf_temp-browse-handle
     2367               where buf_temp-browse-handle.browse-type   = 'height':u
     2368                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2369               no-error .
     2370             if available buf_temp-browse-handle
     2371             then do:
     2372             end.
     2373             else do:
     2374               create buf_temp-diasize-handle .
     2375               assign
     2376                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2377                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2378               .
     2379             end.
     2380           end.
     2381           assign
     2382             v-object-handle = v-object-handle :next-sibling
     2383           .
     2384         end.
     2385         assign
     2386           v-field-group-handle = v-field-group-handle :next-sibling
     2387         .
     2388       end.
     2389       do with frame Dialog-Frame
     2390       :
     2391         hide v-diasize-resize-button .
     2392         assign
     2393           v-diasize-resize-button :row    = 1
     2394           v-diasize-resize-button :column = 1
     2395         .
     2396       end.
     2397       if p-change-value > 0
     2398       then do:
     2399         if frame Dialog-Frame :scrollable = true
     2400         then do:
     2401           assign
     2402             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2403             no-error .
     2404           if error-status :error
     2405           or error-status :get-message(1) <> ""
     2406           then do:
     2407             undo move_block, retry move_block .
     2408           end.
     2409         end.
     2410         assign
     2411           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2412           no-error .
     2413         if error-status :error
     2414         or error-status :get-message(1) <> ""
     2415         then do:
     2416           undo move_block, retry move_block .
     2417         end.
     2418         assign
     2419           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2420           no-error .
     2421         if error-status :error
     2422         or error-status :get-message(1) <> ""
     2423         then do:
     2424           undo move_block, retry move_block .
     2425         end.
     2426         for each buf_temp-browse-handle
     2427           where buf_temp-browse-handle.browse-type = 'height':u
     2428         on error undo move_block, retry move_block
     2429         :
     2430           assign
     2431             buf_temp-browse-handle.browse-handle :height
     2432               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2433             no-error .
     2434           if error-status :error
     2435           or error-status :get-message(1) <> ""
     2436           then do:
     2437             undo move_block, retry move_block .
     2438           end.
     2439         end.
     2440         for each buf_temp-diasize-handle
     2441         on error undo move_block, retry move_block
     2442         :
     2443           assign
     2444             v-object-handle = buf_temp-diasize-handle.handle-value
     2445           .
     2446           if v-object-handle <> v-diasize-resize-button
     2447           then do:
     2448             assign
     2449               v-object-handle :row = v-object-handle :row + p-change-value
     2450               no-error .
     2451             if error-status :error
     2452             or error-status :get-message(1) <> ""
     2453             then do:
     2454               undo move_block, retry move_block .
     2455             end.
     2456           end.
     2457         end.
     2458       end.
     2459       else do:
     2460         for each buf_temp-diasize-handle
     2461         on error undo move_block, retry move_block
     2462         :
     2463           assign
     2464             v-object-handle = buf_temp-diasize-handle.handle-value
     2465           .
     2466           if v-object-handle <> v-diasize-resize-button
     2467           then do:
     2468             assign
     2469               v-object-handle :row = v-object-handle :row + p-change-value
     2470               no-error .
     2471             if error-status :error
     2472             or error-status :get-message(1) <> ""
     2473             then do:
     2474               undo move_block, retry move_block .
     2475             end.
     2476           end.
     2477         end.
     2478         assign
     2479           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2480           no-error .
     2481         if error-status :error
     2482         or error-status :get-message(1) <> ""
     2483         then do:
     2484           undo move_block, retry move_block .
     2485         end.
     2486         for each buf_temp-browse-handle
     2487           where buf_temp-browse-handle.browse-type = 'height':u
     2488         on error undo move_block, retry move_block
     2489         :
     2490           assign
     2491             buf_temp-browse-handle.browse-handle :height
     2492               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2493             no-error .
     2494           if error-status :error
     2495           or error-status :get-message(1) <> ""
     2496           then do:
     2497             undo move_block, retry move_block .
     2498           end.
     2499         end.
     2500         assign
     2501           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2502           no-error .
     2503         if error-status :error
     2504         or error-status :get-message(1) <> ""
     2505         then do:
     2506           undo move_block, retry move_block .
     2507         end.
     2508         if frame Dialog-Frame :scrollable = true
     2509         then do:
     2510           assign
     2511             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2512             no-error .
     2513           if error-status :error
     2514           or error-status :get-message(1) <> ""
     2515           then do:
     2516             undo move_block, retry move_block .
     2517           end.
     2518         end.
     2519       end.
     2520       if p-move-resize = true
     2521       then do:
     2522         run diasize_position-resize-button in this-procedure .
     2523       end.
     2524       if v-diasize-wndstore = true
     2525       then do:
     2526         if connected("ub") = true
     2527         then do:
     2528           define variable v-cntxt-db-num        as integer   no-undo .
     2529           define variable v-cntxt-userid        as character no-undo .
     2530           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2531                                             , OUTPUT v-cntxt-userid
     2532                                             ) .
     2533           run gbl/wndsizew.p
     2534             (input  v-cntxt-db-num
     2535             ,input  v-cntxt-userid
     2536             ,input  v-diasize-proc-name
     2537             ,input  'height':u
     2538             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2539             ) .
     2540         end.
     2541       end.
     2542     end.
     2543     assign
     2544       v-diasize-change-size = false
     2545     .
     2546   end procedure.
     2547   procedure diasize_set-height :
     2548     define input  parameter p-new-height  as decimal   no-undo .
     2549     define input  parameter p-move-resize as logical   no-undo .
     2550     do
     2551     on error undo, return error return-value
     2552     :
     2553       run diasize_change-height in this-procedure
     2554         (input  (p-new-height - frame Dialog-Frame :height)
     2555         ,input  p-move-resize
     2556         ) .
     2557     end.
     2558   end procedure.
     2559   procedure diasize_change-width :
     2560     define input  parameter p-change-value as decimal   no-undo .
     2561     define input  parameter p-move-resize  as logical   no-undo .
     2562     define variable v-field-group-handle   as handle    no-undo .
     2563     define variable v-object-handle        as handle    no-undo .
     2564     define variable v-frame-width          as decimal   no-undo .
     2565     define variable v-frame-virtual-width  as decimal   no-undo .
     2566     define variable v-browse-width         as decimal   no-undo .
     2567     define variable v-window-width         as decimal   no-undo .
     2568     define variable v-window-virtual-width as decimal   no-undo .
     2569     define variable v-change-sign          as integer   no-undo .
     2570     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2571     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2572     if p-change-value > 0
     2573     then do:
     2574       if frame Dialog-Frame :width + p-change-value >
     2575           session :width-chars
     2576       then do:
     2577         assign
     2578           p-change-value = session :width-chars - frame Dialog-Frame :width
     2579         .
     2580         if p-change-value <= 0
     2581         then do:
     2582           run diasize_position-resize-button in this-procedure .
     2583           return .
     2584         end.
     2585       end.
     2586     end.
     2587     if p-change-value < 0
     2588     then do:
     2589       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2590       then do:
     2591         assign
     2592           p-change-value = v-diasize-orig-frame-width
     2593                          - frame Dialog-Frame :width
     2594         .
     2595         if p-change-value >= 0
     2596         then do:
     2597           run diasize_position-resize-button in this-procedure .
     2598           return .
     2599         end.
     2600       end.
     2601     end.
     2602     if p-change-value >= 0
     2603     then do:
     2604       assign
     2605         v-change-sign = 1
     2606       .
     2607     end.
     2608     else do:
     2609       assign
     2610         v-change-sign = -1
     2611       .
     2612     end.
     2613     assign
     2614       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2615     .
     2616     if p-change-value = 0
     2617     then do:
     2618       run diasize_position-resize-button in this-procedure .
     2619       return .
     2620     end.
     2621     move_block:
     2622     do
     2623     on error undo move_block, leave move_block
     2624     :
     2625       if retry
     2626       then do:
     2627         do
     2628         on error undo move_block, leave move_block
     2629         :
     2630           if p-change-value > 0
     2631           then do:
     2632             for each buf_temp-diasize-handle
     2633             on error undo, next
     2634             :
     2635               assign
     2636                 v-object-handle = buf_temp-diasize-handle.handle-value
     2637               .
     2638               if v-object-handle <> v-diasize-resize-button
     2639               then do:
     2640                 assign
     2641                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2642                 .
     2643               end.
     2644             end.
     2645             assign
     2646               v-diasize-browse-handle :width = v-browse-width
     2647             .
     2648             for each buf_temp-browse-handle
     2649               where buf_temp-browse-handle.browse-type = 'width':u
     2650             on error undo, next
     2651             :
     2652               assign
     2653                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2654               .
     2655             end.
     2656             assign
     2657               frame Dialog-Frame :width = v-frame-width
     2658             .
     2659             if frame Dialog-Frame :scrollable = true
     2660             then do:
     2661               assign
     2662                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2663               .
     2664             end.
     2665             run diasize_position-resize-button in this-procedure .
     2666           end.
     2667           else do:
     2668             if frame Dialog-Frame :scrollable = true
     2669             then do:
     2670               assign
     2671                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2672               .
     2673             end.
     2674             assign
     2675               frame Dialog-Frame :width = v-frame-width
     2676             .
     2677             for each buf_temp-browse-handle
     2678               where buf_temp-browse-handle.browse-type = 'width':u
     2679             on error undo, next
     2680             :
     2681               assign
     2682                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2683               .
     2684             end.
     2685             assign
     2686               v-diasize-browse-handle :width = v-browse-width
     2687             .
     2688             for each buf_temp-diasize-handle
     2689             on error undo, next
     2690             :
     2691               assign
     2692                 v-object-handle = buf_temp-diasize-handle.handle-value
     2693               .
     2694               if v-object-handle <> v-diasize-resize-button
     2695               then do:
     2696                 assign
     2697                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2698                 .
     2699               end.
     2700             end.
     2701             run diasize_position-resize-button in this-procedure .
     2702           end.
     2703           assign
     2704             v-diasize-change-size = false
     2705           .
     2706           leave move_block .
     2707         end.
     2708       end.
     2709       assign
     2710         v-diasize-need-full-display = true
     2711       .
     2712       if v-diasize-change-size = false
     2713       then do:
     2714         assign
     2715           v-diasize-change-size = true
     2716         .
     2717       end.
     2718       else do:
     2719         return .
     2720       end.
     2721       assign
     2722         v-frame-width = frame Dialog-Frame :width
     2723         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2724         v-browse-width = v-diasize-browse-handle :width
     2725       .
     2726       for each buf_temp-browse-handle
     2727         where buf_temp-browse-handle.browse-type = 'width':u
     2728       :
     2729         assign
     2730           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2731         .
     2732       end.
     2733       for each buf_temp-diasize-handle
     2734       :
     2735         delete buf_temp-diasize-handle .
     2736       end.
     2737       assign
     2738         v-field-group-handle = frame Dialog-Frame :first-child
     2739       .
     2740       do while valid-handle(v-field-group-handle)
     2741       :
     2742         assign
     2743           v-object-handle = v-field-group-handle :first-child
     2744         .
     2745         do while valid-handle(v-object-handle)
     2746         :
     2747           if  v-object-handle <> v-diasize-browse-handle :handle
     2748           and v-object-handle <> v-diasize-resize-button
     2749           and can-query(v-object-handle, "row")
     2750           and can-query(v-object-handle, "height")
     2751           and ( v-object-handle :col + v-object-handle :width
     2752                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2753               )
     2754           then do:
     2755             find first buf_temp-browse-handle
     2756               where buf_temp-browse-handle.browse-type   = 'width':u
     2757                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2758               no-error .
     2759             if available buf_temp-browse-handle
     2760             then do:
     2761             end.
     2762             else do:
     2763               create buf_temp-diasize-handle .
     2764               assign
     2765                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2766                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2767               .
     2768             end.
     2769           end.
     2770           assign
     2771             v-object-handle = v-object-handle :next-sibling
     2772           .
     2773         end.
     2774         assign
     2775           v-field-group-handle = v-field-group-handle :next-sibling
     2776         .
     2777       end.
     2778       do with frame Dialog-Frame
     2779       :
     2780         hide v-diasize-resize-button .
     2781         v-diasize-resize-button :row = 1.
     2782         v-diasize-resize-button :column = 1.
     2783       end.
     2784       if p-change-value > 0
     2785       then do:
     2786         if frame Dialog-Frame :scrollable = true
     2787         then do:
     2788           assign
     2789             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2790             no-error .
     2791           if error-status :error
     2792           or error-status :get-message(1) <> ""
     2793           then do:
     2794             undo move_block, retry move_block.
     2795           end.
     2796         end.
     2797         assign
     2798           frame Dialog-Frame :width = v-frame-width + p-change-value
     2799           no-error .
     2800         if error-status :error
     2801         or error-status :get-message(1) <> ""
     2802         then do:
     2803           undo move_block, retry move_block.
     2804         end.
     2805         assign
     2806           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2807         no-error .
     2808         if error-status :error
     2809         or error-status :get-message(1) <> ""
     2810         then do:
     2811           undo move_block, retry move_block.
     2812         end.
     2813         for each buf_temp-browse-handle
     2814           where buf_temp-browse-handle.browse-type = 'width':u
     2815         on error undo move_block, retry move_block
     2816         :
     2817           assign
     2818             buf_temp-browse-handle.browse-handle :width
     2819               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2820             no-error .
     2821           if error-status :error
     2822           or error-status :get-message(1) <> ""
     2823           then do:
     2824             undo move_block, retry move_block .
     2825           end.
     2826         end.
     2827         for each buf_temp-diasize-handle
     2828         on error undo move_block, retry move_block
     2829         :
     2830           assign
     2831             v-object-handle = buf_temp-diasize-handle.handle-value
     2832           .
     2833           if v-object-handle <> v-diasize-resize-button
     2834           then do:
     2835             assign
     2836               v-object-handle :col = v-object-handle :col + p-change-value
     2837               no-error .
     2838             if error-status :error
     2839             or error-status :get-message(1) <> ""
     2840             then do:
     2841               undo move_block, retry move_block .
     2842             end.
     2843           end.
     2844         end.
     2845       end.
     2846       else do:
     2847         for each buf_temp-diasize-handle
     2848         on error undo move_block, retry move_block
     2849         :
     2850           assign
     2851             v-object-handle = buf_temp-diasize-handle.handle-value
     2852           .
     2853           if v-object-handle <> v-diasize-resize-button
     2854           then do:
     2855             assign
     2856               v-object-handle :col = v-object-handle :col + p-change-value
     2857               no-error .
     2858             if error-status :error
     2859             or error-status :get-message(1) <> ""
     2860             then do:
     2861               undo move_block, retry move_block .
     2862             end.
     2863           end.
     2864         end.
     2865         for each buf_temp-browse-handle
     2866           where buf_temp-browse-handle.browse-type = 'width':u
     2867         on error undo move_block, retry move_block
     2868         :
     2869           assign
     2870             buf_temp-browse-handle.browse-handle :width
     2871               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2872             no-error .
     2873           if error-status :error
     2874           or error-status :get-message(1) <> ""
     2875           then do:
     2876             undo move_block, retry move_block .
     2877           end.
     2878         end.
     2879         assign
     2880           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2881           no-error .
     2882         if error-status :error
     2883         or error-status :get-message(1) <> ""
     2884         then do:
     2885           undo move_block, retry move_block.
     2886         end.
     2887         assign
     2888           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2889         no-error .
     2890         if error-status :error
     2891         or error-status :get-message(1) <> ""
     2892         then do:
     2893           undo move_block, retry move_block.
     2894         end.
     2895         if frame Dialog-Frame :scrollable = true
     2896         then do:
     2897           assign
     2898             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2899           no-error .
     2900           if error-status :error
     2901           or error-status :get-message(1) <> ""
     2902           then do:
     2903             undo move_block, retry move_block.
     2904           end.
     2905         end.
     2906       end.
     2907       if p-move-resize
     2908       then do:
     2909         run diasize_position-resize-button in this-procedure .
     2910       end.
     2911       if v-diasize-wndstore = true
     2912       then do:
     2913         if connected("ub") = true
     2914         then do:
     2915           define variable v-cntxt-db-num        as integer   no-undo .
     2916           define variable v-cntxt-userid        as character no-undo .
     2917           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2918                                             , OUTPUT v-cntxt-userid
     2919                                             ) .
     2920           run gbl/wndsizew.p
     2921             (input  v-cntxt-db-num
     2922             ,input  v-cntxt-userid
     2923             ,input  v-diasize-proc-name
     2924             ,input  'width':u
     2925             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2926             ) .
     2927         end.
     2928       end.
     2929     end.
     2930     assign
     2931       v-diasize-change-size = false
     2932     .
     2933   end procedure.
     2934   procedure diasize_set-width :
     2935     define input  parameter p-new-width  as decimal   no-undo .
     2936     define input  parameter p-move-resize as logical   no-undo .
     2937     do
     2938     on error undo, return error return-value
     2939     :
     2940       run diasize_change-width in this-procedure
     2941         (input  (p-new-width - frame Dialog-Frame :width)
     2942         ,input  p-move-resize
     2943         ) .
     2944     end.
     2945   end procedure.
     2946   procedure diasize_position-resize-button :
     2947     do with frame Dialog-Frame
     2948     :
     2949       hide v-diasize-resize-button .
     2950       assign
     2951         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2952                     - 1
     2953                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2954         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2955                     - 1
     2956                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2957       .
     2958       view v-diasize-resize-button .
     2959     end.
     2960   end procedure.
     2961   on alt-right anywhere
     2962   do:
     2963     run diasize_change-width in this-procedure
     2964       (input 1
     2965       ,input true
     2966       ) .
     2967     return no-apply .
     2968   end.
     2969   on alt-left anywhere
     2970   do:
     2971     run diasize_change-width in this-procedure
     2972       (input -1
     2973       ,input true
     2974       ) .
     2975     return no-apply .
     2976   end.
     2977   on alt-down anywhere
     2978   do:
     2979     run diasize_change-height in this-procedure
     2980       (input 1
     2981       ,input true
     2982       ) .
     2983     return no-apply .
     2984   end.
     2985   on alt-up anywhere
     2986   do:
     2987     run diasize_change-height in this-procedure
     2988       (input -1
     2989       ,input true
     2990       ) .
     2991     return no-apply .
     2992   end.
     2993   on alt-enter of frame Dialog-Frame
     2994   do:
     2995     run diasize_maximize in this-procedure
     2996       (input  ?
     2997       ).
     2998     return no-apply .
     2999   end.
     3000   procedure diasize_end-move :
     3001     do
     3002     on error undo, return error return-value
     3003     :
     3004       define variable v-row-delta as decimal   no-undo .
     3005       define variable v-col-delta as decimal   no-undo .
     3006       define variable v-new-row as decimal   no-undo .
     3007       define variable v-new-col as decimal   no-undo .
     3008       assign
     3009         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3010         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3011       .
     3012       assign
     3013         v-row-delta = v-new-row - frame Dialog-Frame :height
     3014         v-col-delta = v-new-col - frame Dialog-Frame :width
     3015       .
     3016       run diasize_change-height in this-procedure
     3017         (input v-row-delta
     3018         ,input true
     3019         ) .
     3020       run diasize_change-width in this-procedure
     3021         (input v-col-delta
     3022         ,input true
     3023         ) .
     3024     end.
     3025   end procedure.
     3026   procedure diasize_maximize :
     3027     define input  parameter p-action as logical   no-undo .
     3028     do
     3029     on error undo, return error return-value
     3030     :
     3031       if p-action = ?
     3032       then do:
     3033         if v-diasize-need-maximize = true
     3034         then do:
     3035           assign
     3036             p-action = true
     3037           .
     3038         end.
     3039         else do:
     3040           assign
     3041             p-action = false
     3042           .
     3043         end.
     3044       end.
     3045       if p-action = true
     3046       then do:
     3047         run diasize_change-height in this-procedure
     3048           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3049               - frame Dialog-Frame :height-chars
     3050           ,input true
     3051           ) .
     3052         run diasize_change-width in this-procedure
     3053           (input session :width-chars
     3054               - frame Dialog-Frame :width-chars
     3055           ,input true
     3056           ) .
     3057         assign
     3058           v-diasize-need-maximize = false
     3059         .
     3060       end.
     3061       else do:
     3062         run diasize_change-width in this-procedure
     3063           (input v-diasize-orig-frame-width
     3064               - frame Dialog-Frame :width-chars
     3065           ,input true
     3066           ) .
     3067         run diasize_change-height in this-procedure
     3068           (input v-diasize-orig-frame-height
     3069               - frame Dialog-Frame :height-chars
     3070           ,input true
     3071           ) .
     3072         assign
     3073           v-diasize-need-maximize = true
     3074         .
     3075       end.
     3076     end.
     3077   end procedure.
     3078   procedure diasize_restore-orig-size :
     3079     do
     3080     on error undo, return error return-value
     3081     :
     3082       assign
     3083         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3084         v-diasize-current-frame-height = frame Dialog-Frame :height
     3085       .
     3086       run diasize_set-height in this-procedure
     3087         (input  v-diasize-orig-frame-height
     3088         ,input  true
     3089         ) .
     3090       run diasize_set-width in this-procedure
     3091         (input  v-diasize-orig-frame-width
     3092         ,input  true
     3093         ) .
     3094     end.
     3095   end procedure.
     3096   procedure diasize_restore-current-size :
     3097     do
     3098     on error undo, return error return-value
     3099     :
     3100       run diasize_set-height in this-procedure
     3101         (input  v-diasize-current-frame-height
     3102         ,input  true
     3103         ) .
     3104       run diasize_set-width in this-procedure
     3105         (input  v-diasize-current-frame-width
     3106         ,input  true
     3107         ) .
     3108     end.
     3109   end procedure.
     3110   procedure diasize_set-browse-handle :
     3111     define input  parameter p-browse-handle as handle   no-undo .
     3112     define buffer buf_temp-browse-handle for temp-browse-handle .
     3113     do
     3114     on error undo, return error return-value
     3115     :
     3116       assign
     3117         v-diasize-browse-handle = p-browse-handle
     3118       .
     3119       for each buf_temp-browse-handle
     3120       on error undo, return error return-value
     3121       :
     3122         delete buf_temp-browse-handle .
     3123       end.
     3124     end.
     3125   end procedure.
     3126   procedure diasize_add_browse :
     3127     define input  parameter p-browse-type   as character no-undo .
     3128     define input  parameter p-browse-handle as handle    no-undo .
     3129     define buffer buf_temp-browse-handle for temp-browse-handle .
     3130     do
     3131     on error undo, return error return-value
     3132     :
     3133       assign
     3134         v-diasize-browse-number = v-diasize-browse-number + 1
     3135       .
     3136       create buf_temp-browse-handle .
     3137       assign
     3138         buf_temp-browse-handle.browse-type   = p-browse-type
     3139         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3140         buf_temp-browse-handle.browse-handle = p-browse-handle
     3141       .
     3142     end.
     3143   end procedure.
     3144   procedure diasize_init :
     3145     define variable v-default-value    as logical   no-undo .
     3146     define variable v-restore-saved    as logical   no-undo .
     3147     define variable v-resize-value-str as character no-undo .
     3148     do
     3149     on error undo, return error return-value
     3150     :
     3151       do with frame Dialog-Frame
     3152       :
     3153         assign
     3154           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3155           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3156           v-diasize-browse-handle     = browse BR-docs :handle
     3157         .
     3158         create button v-diasize-resize-button
     3159         assign
     3160           parent        = frame Dialog-Frame :first-child
     3161           label         = "s"
     3162           height-pixels = 16
     3163           width-pixels  = 16
     3164           visible       = true
     3165           sensitive     = true
     3166           movable       = true
     3167           triggers:
     3168             on end-move persistent run diasize_end-move in this-procedure .
     3169           end triggers.
     3170         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3171         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3172         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3173         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3174         assign
     3175           v-diasize-wndmax = false
     3176         .
     3177         if connected("ub") = true
     3178         then do:
     3179           define variable v-cntxt-db-num        as integer   no-undo .
     3180           define variable v-cntxt-userid        as character no-undo .
     3181           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3182                                             , OUTPUT v-cntxt-userid
     3183                                             ) .
     3184           run gbl/wndpar_r.p
     3185             (input  v-cntxt-db-num
     3186             ,input  v-cntxt-userid
     3187             ,input  'wndmax':U
     3188             ,output v-diasize-wndmax
     3189             ,output v-default-value
     3190             ) .
     3191         end.
     3192         assign
     3193           v-diasize-wndstore = false
     3194         .
     3195         if connected("ub") = true
     3196         then do:
     3197           run gbl/wndpar_r.p
     3198             (input  v-cntxt-db-num
     3199             ,input  v-cntxt-userid
     3200             ,input  'wndstore':U
     3201             ,output v-diasize-wndstore
     3202             ,output v-default-value
     3203             ) .
     3204         end.
     3205         assign
     3206           v-diasize-proc-name = entry(1, program-name(2), '.')
     3207         .
     3208         if v-diasize-wndstore = true
     3209         then do:
     3210           assign
     3211             v-restore-saved = false
     3212           .
     3213           if connected("ub") = true
     3214           then do:
     3215             run gbl/wndsizer.p
     3216               (input  v-cntxt-db-num
     3217               ,input  v-cntxt-userid
     3218               ,input  v-diasize-proc-name
     3219               ,input  'height':u
     3220               ,output v-resize-value-str
     3221               ) .
     3222             if v-resize-value-str <> '':U
     3223             then do:
     3224               run diasize_change-height in this-procedure
     3225                 (input  integer(v-resize-value-str)
     3226                 ,input  true
     3227                 ) .
     3228               assign
     3229                 v-restore-saved = true
     3230               .
     3231             end.
     3232           end.
     3233           if connected("ub") = true
     3234           then do:
     3235             run gbl/wndsizer.p
     3236               (input  v-cntxt-db-num
     3237               ,input  v-cntxt-userid
     3238               ,input  v-diasize-proc-name
     3239               ,input  'width':u
     3240               ,output v-resize-value-str
     3241               ) .
     3242             if v-resize-value-str <> '':U
     3243             then do:
     3244               run diasize_change-width in this-procedure
     3245                 (input  integer(v-resize-value-str)
     3246                 ,input  true
     3247                 ) .
     3248               assign
     3249                 v-restore-saved = true
     3250               .
     3251             end.
     3252           end.
     3253           if v-restore-saved <> true
     3254           then do:
     3255             if v-diasize-wndmax = true
     3256             then do:
     3257               run diasize_maximize in this-procedure
     3258                 (input  true
     3259                 ) .
     3260             end.
     3261           end.
     3262         end.
     3263         else do:
     3264           if v-diasize-wndmax = true
     3265           then do:
     3266             run diasize_maximize in this-procedure
     3267               (input  true
     3268               ) .
     3269           end.
     3270         end.
     3271       end.
     3272     end.
     3273   end procedure.
     3274   procedure diasize_need-full-display :
     3275     define output parameter p-need-full-display as logical   no-undo .
     3276     do
     3277     on error undo, return error return-value
     3278     :
     3279       assign
     3280         p-need-full-display = v-diasize-need-full-display
     3281       .
     3282       assign
     3283         v-diasize-need-full-display = false
     3284       .
     3285     end.
     3286   end procedure.
     3287   procedure get-context :
     3288      define output parameter p-db-num as integer          no-undo.
     3289      define output parameter p-user-id as character        no-undo.
     3290      define variable v-login               as character    no-undo.
     3291      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3292      define buffer buf_user-login  for ub.user-login .
     3293      do
     3294      on error undo, return error
     3295      :
     3296            FIND FIRST buf_sys-ctrl no-lock.
     3297            ASSIGN
     3298               v-login = USERID("ub")
     3299               p-db-num = buf_sys-ctrl.db-num
     3300            .
     3301            FIND FIRST buf_user-login
     3302                 WHERE buf_user-login.db-num = p-db-num
     3303                   AND buf_user-login.user-login = v-login
     3304                 no-lock
     3305                 no-error
     3306                 .
     3307            IF AVAILABLE buf_user-login
     3308            THEN DO:
     3309               assign
     3310                  p-user-id = buf_user-login.user-id
     3311               .
     3312            END.
     3313      end.
     3314   end procedure.
     3315   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3316   on f5 of frame Dialog-Frame anywhere
     3317   do:
     3318     run OpenBr(yes, no, '':U).
     3319       apply "VALUE-CHANGED" to br-docs.
     3320   end.
     3321   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3322   DEF VAR cur-clmn-numbr-docs as INT EXTENT 11 no-undo.
     3323   DEF VAR varmvibr-docs       as INT no-undo.
     3324   DEF VAR varmvjbr-docs       as INT no-undo.
     3325   DEF VAR varmvkbr-docs       as INT no-undo.
     3326   DEF VAR varmvlbr-docs       as INT no-undo.
     3327   DEF VAR move-elementbr-docs as INT no-undo.
     3328   def var jjbr-docs           as int no-undo.
     3329   do varmvibr-docs = 1 to EXTENT(cur-clmn-numbr-docs):
     3330     ASSIGN cur-clmn-numbr-docs[varmvibr-docs] = varmvibr-docs.
     3331   END.
     3332   RUN start-mv-clmnbr-docs.
     3333   PROCEDURE start-mv-clmnbr-docs:
     3334   def var old-session as logical no-undo.
     3335      old-session = SESSION:IMMEDIATE-DISPLAY.
     3336      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3337      SESSION:IMMEDIATE-DISPLAY = old-session.
     3338   END.
     3339   ON ctrl-cursor-right OF BROWSE br-docs do:
     3340     RUN re-move-clmnbr-docs ( 5, 11).
     3341   END.
     3342   ON ctrl-cursor-left OF BROWSE br-docs do:
     3343     RUN re-move-clmnbr-docs (11, 5).
     3344   END.
     3345   PROCEDURE re-move-clmnbr-docs:
     3346     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3347     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3348     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3349       if cur-clmn-numbr-docs[varmvibr-docs] = source-column THEN cur-clmn-numbr-docs[varmvibr-docs] = -1.
     3350     END.
     3351     if br-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3352     if source-column > target-column THEN
     3353     DO varmvjbr-docs = source-column - 1 to target-column BY -1:
     3354       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3355           if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3356             cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] + 1.
     3357           END.
     3358       END.
     3359     END.
     3360     ELSE
     3361     DO varmvjbr-docs = source-column + 1 to target-column:
     3362       DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3363         if cur-clmn-numbr-docs[varmvibr-docs] = varmvjbr-docs THEN DO:
     3364           cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-numbr-docs[varmvibr-docs] - 1.
     3365         END.
     3366       END.
     3367     END.
     3368     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3369       if cur-clmn-numbr-docs[varmvibr-docs] = -1 THEN cur-clmn-numbr-docs[varmvibr-docs] = target-column.
     3370     END.
     3371   END PROCEDURE.
     3372   PROCEDURE ch-clmnbr-docs:
     3373     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3374     if cur-clmn-loc <= 5 then do:
     3375       return .
     3376     end.
     3377     DO varmvibr-docs = 1 TO EXTENT(cur-clmn-numbr-docs):
     3378       if cur-clmn-numbr-docs[varmvibr-docs] = cur-clmn-loc THEN move-elementbr-docs = varmvibr-docs.
     3379     END.
     3380     RUN re-move-clmnbr-docs (cur-clmn-loc, 5).
     3381   END PROCEDURE.
     3382   PROCEDURE mv-brw-defaultbr-docs:
     3383   def var old-session as logical no-undo.
     3384     old-session = SESSION:IMMEDIATE-DISPLAY.
     3385     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3386     do varmvlbr-docs = 5 to EXTENT(cur-clmn-numbr-docs):
     3387       RUN re-move-clmnbr-docs (cur-clmn-numbr-docs[varmvlbr-docs], varmvlbr-docs).
     3388     END.
     3389     RUN start-mv-clmnbr-docs.
     3390     SESSION:IMMEDIATE-DISPLAY = old-session.
     3391   END PROCEDURE.
     3392   .
     3393   def var sort-labelbr-docs   as character no-undo .
     3394   def var sort-clmnbr-docs    as handle    no-undo .
     3395   def var cur-clmnbr-docs     as handle    no-undo .
     3396   def var cur-clmn-locbr-docs as integer   no-undo .
     3397   def var re-querybr-docs     as logical   initial no no-undo .
     3398   on start-search, ctrl-o of br-docs in frame Dialog-Frame do:
     3399      run sort-brbr-docs
     3400        (input (if available buf-po_ord-doc
     3401                then recid(buf-po_ord-doc)
     3402                else ?
     3403               )
     3404        ).
     3405   end.
     3406   PROCEDURE sort-brbr-docs :
     3407     define input parameter p-recid as recid no-undo .
     3408     if re-querybr-docs = no then do:
     3409       assign
     3410          cur-clmnbr-docs = br-docs:current-column in frame Dialog-Frame
     3411       .
     3412       if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
     3413       if cur-clmnbr-docs = sort-clmnbr-docs then do:
     3414         assign
     3415            sort-labelbr-docs = ""
     3416            sort-clmnbr-docs = ?
     3417         .
     3418        end.
     3419        else do:
     3420          assign
     3421            sort-labelbr-docs = cur-clmnbr-docs:label
     3422            sort-clmnbr-docs  = cur-clmnbr-docs
     3423            sort-clmnbr-docs:column-fgcolor = 4
     3424          .
     3425        end.
     3426      end.
     3427     assign
     3428       cur-clmn-locbr-docs = 1
     3429     .
     3430     def var column-handle as handle no-undo .
     3431     column-handle = br-docs:first-column.
     3432     do while valid-handle(column-handle) :
     3433       if column-handle = cur-clmnbr-docs then do:
     3434         leave .
     3435       end.
     3436       column-handle = column-handle:NEXT-COLUMN.
     3437       assign
     3438         cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
     3439       .
     3440     end.
     3441     case sort-labelbr-docs:
     3442           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf-po_ord-doc), &1&2&1)', chr(34), rid-list)     .     run OpenBr(yes, no, '':U).   . END.
     3443           when 'Статус'  then DO:    assign       sort-column-name = "buf-po_ord-doc.status_"     .     run OpenBr(yes, no, '':U).   . END.
     3444           when 'OK'  then DO:    assign       sort-column-name = "buf-po_ord-doc.flag_"     .     run OpenBr(yes, no, '':U).   . END.
     3445           when '№ док-та'  then DO:    assign       sort-column-name = "buf-po_ord-doc.doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     3446           when 'Создан'  then DO:    assign       sort-column-name = "buf-po_ord-doc.doc-date"     .     run OpenBr(yes, no, '':U).   . END.
     3447           when 'Факт'  then DO:    assign       sort-column-name = "buf-po_ord-doc.fact-date"     .     run OpenBr(yes, no, '':U).   . END.
     3448           when 'Код'  then DO:    assign       sort-column-name = "( buf-po_ord-doc.cli-type +  string(buf-po_ord-doc.cli-code))"     .     run OpenBr(yes, no, '':U).   . END.
     3449           when 'Покупатель'  then DO:    assign       sort-column-name = "buf-po_ord-doc.cli-name"     .     run OpenBr(yes, no, '':U).   . END.
     3450           when 'Количество'  then DO:    assign       sort-column-name = "buf-po_ord-doc.qnty"     .     run OpenBr(yes, no, '':U).   . END.
     3451           when 'Сумма в руб.'  then DO:    assign       sort-column-name = "buf-po_ord-doc.sum-rubl"     .     run OpenBr(yes, no, '':U).   . END.
     3452           when '>'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-direct&1, recid(buf-po_ord-doc))', chr(34))     .     run OpenBr(yes, no, '':U).   . END.
     3453       otherwise do:
     3454         assign
     3455           sort-column-name = ""
     3456         .
     3457         run OpenBr(yes, no, '':U).
     3458           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-docs') then do:
     3459             run mv-brw-defaultbr-docs.
     3460           end.
     3461         if sort-labelbr-docs <> "" then do:
     3462           assign
     3463             cur-clmnbr-docs:column-fgcolor = 0
     3464           .
     3465         end.
     3466         assign
     3467           cur-clmn-locbr-docs = ?
     3468         .
     3469       end.
     3470     end case.
     3471       if cur-clmn-locbr-docs <> ? then do:
     3472         if can-do( this-procedure:internal-entries, 'ch-clmnbr-docs') then do:
     3473           run ch-clmnbr-docs in this-procedure (cur-clmn-locbr-docs).
     3474         end.
     3475       end.
     3476     if p-recid <> ? then do:
     3477       reposition br-docs to recid p-recid no-error.
     3478       apply "value-changed" to br-docs in frame Dialog-Frame.
     3479     end.
     3480     apply "entry" to br-docs in frame Dialog-Frame.
     3481   END PROCEDURE.
     3482   procedure re-open-query-srt-clmnbr-docs:
     3483   if cur-clmnbr-docs = ? then do:
     3484      run OpenBr(yes, no, '':U).
     3485   end.
     3486   else do:
     3487      assign re-querybr-docs = yes.
     3488      run sort-brbr-docs
     3489        (input (if available buf-po_ord-doc
     3490                then recid(buf-po_ord-doc)
     3491                else ?
     3492               )
     3493        ).
     3494      assign re-querybr-docs = no.
     3495   end.
     3496   end.
     3497   MAIN-BLOCK:
     3498   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3499      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3500      buf-po_ord-doc.status_:read-only in browse br-docs = true .
     3501      define buffer find_code for ub.ord-doc.
     3502         if pardoc-rec <> ? then do:
     3503         FIND FIRST find_code No-LOCK where
     3504                    recid(find_code) = pardoc-rec No-ERROR.
     3505         if not avail find_code then do:
     3506           message
     3507           vss-workfile vss-revision vss-description skip
     3508           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3509           view-as alert-box error .
     3510           return error.
     3511         end.
     3512         doc-rec = pardoc-rec.
     3513       end.
     3514     run my-enable_ui in this-procedure .
     3515     run openbr in this-procedure (yes, no, '':u).
     3516     if pardoc-rec <> ? then
     3517     reposition br-docs to recid doc-rec no-error.
     3518     run diasize_add_browse in this-procedure
     3519         (input  'width':u
     3520         ,input  browse br-zapr :handle
     3521         ) .
     3522     run diasize_init in this-procedure .
     3523     hide b-move b-move-to in frame Dialog-Frame .
     3524     wait-for go of frame Dialog-Frame focus br-docs.
     3525   END.
     3526   run disable_ui in this-procedure .
     3527   PROCEDURE close-zapr :
     3528    do
     3529    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3530    :
     3531   define input parameter p-trn-code as character no-undo .
     3532   define buffer buf_s-trn-doc for ub.trn-doc.
     3533   define variable varmode            as   character           no-undo.
     3534   define variable varstatus          like ub.trn-doc.status_  no-undo.
     3535   define variable varflag            like ub.trn-doc.flag     no-undo.
     3536   define variable varcopystatus      like ub.trn-doc.status_  no-undo.
     3537   define variable varcopyflag        like ub.trn-doc.flag     no-undo.
     3538   define variable varcheck-return as logical no-undo .
     3539   define variable varchg-inv as logical no-undo .
     3540   assign
     3541     varmode        = '<закрытие документа>':U
     3542     varstatus      = 'запрос':U
     3543     varflag        = false
     3544     varcopystatus  = 'запрос':U
     3545     varcopyflag    = true
     3546     varcheck-return = true
     3547     varchg-inv      = true
     3548     .
     3549   run str/trn-graf.p
     3550       (input  p-trn-code,
     3551        input  v-cntxt-db-num,
     3552        input  varmode,
     3553        output varstatus,
     3554        output varflag,
     3555        output varcopystatus,
     3556        output varcopyflag
     3557       ) no-error.
     3558   .
     3559   if error-status:error then do:
     3560      if error-status :get-message(1) <> "" or
     3561         return-value = ""                  then do:
     3562        message "Ошибка при вызове trn-graf.p." skip
     3563        error-status :get-message(1) skip
     3564        return-value skip
     3565        view-as alert-box error.
     3566      end.
     3567      else do:
     3568        message return-value
     3569        view-as alert-box error.
     3570      end.
     3571      return error.
     3572   end.
     3573   define variable g#in-ov       like  ub.sysconf.in-ov     no-undo .
     3574   define variable g#rsrv-time   like  ub.sysconf.rsrv-time no-undo .
     3575   define variable g#load-time   like  ub.sysconf.load-time no-undo .
     3576   define variable g#holidays    like  ub.sysconf.holidays  no-undo .
     3577   define buffer buf_sysconf for ub.sysconf  .
     3578   find first buf_sysconf no-lock where   buf_sysconf.host-code = par-host-code no-error .
     3579   if error-status :error then message
     3580     vss-workfile vss-revision vss-description skip
     3581     error-status :get-message(1) skip
     3582     return-value skip
     3583     "Не верный код фирмы" par-host-code
     3584     view-as alert-box error
     3585   .
     3586   assign
     3587       g#in-ov      = buf_sysconf.in-ov
     3588       g#rsrv-time  = buf_sysconf.rsrv-time
     3589       g#load-time  = buf_sysconf.load-time
     3590       g#holidays   = buf_sysconf.holidays
     3591   .
     3592   run str/trn-stat.p (
     3593       input  parParentProc ,
     3594       input this-procedure ,
     3595       input  varmode,
     3596       input  p-trn-code,
     3597       input  varcheck-return,
     3598       input  v-cntxt-db-num,
     3599       input  g#in-ov,
     3600       input  g#rsrv-time,
     3601       input  g#load-time,
     3602       input  g#holidays,
     3603       input  yes,
     3604       output varchg-inv,
     3605       output table gds-list) no-error.
     3606   if error-status:error then do:
     3607      message
     3608        vss-workfile vss-revision vss-description skip
     3609        "Ошибка при принудительном закрытии документа " p-trn-code skip
     3610        return-value skip
     3611        trim(error-status :get-message(1))
     3612        trim(error-status :get-message(2))
     3613        trim(error-status :get-message(3))
     3614        trim(error-status :get-message(4))
     3615        trim(error-status :get-message(5)) skip
     3616        view-as alert-box error.
     3617      return error.
     3618   end.
     3619     end.
     3620   END PROCEDURE.
     3621   PROCEDURE disable_UI :
     3622     HIDE FRAME Dialog-Frame.
     3623   END PROCEDURE.
     3624   PROCEDURE enable_UI :
     3625     DISPLAY sch-code sch-date sch-fact sch-num loc-boss loc-agnt loc-wrkr
     3626             loc-creid
     3627         WITH FRAME Dialog-Frame.
     3628     ENABLE b-quit b-sel b-history b-sch b-move-to b-help b-mark b-add b-lkp b-chg
     3629            b-del b-open b-close b-move b-print sch-code sch-date sch-fact br-docs
     3630            B-lkp-2 br-zapr sch-num loc-boss loc-agnt loc-wrkr loc-creid
     3631         WITH FRAME Dialog-Frame.
     3632     VIEW FRAME Dialog-Frame.
     3633     OPEN QUERY br-docs FOR EACH buf-po_ord-doc NO-LOCK.    OPEN QUERY br-zapr FOR EACH buf-po_ord-doc-rcv WHERE                   buf-po_ord-doc-rcv.doc-code = buf-po_ord-doc.doc-code NO-LOCK,          each ub.ord-chain no-lock where             ub.ord-chain.doc-code = buf-po_ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and             ub.ord-chain.rel-doc-type = 'trn'             ,               EACH buf-po_trn-doc  where            buf-po_trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK.
     3634   END PROCEDURE.
     3635   PROCEDURE main-ord :
     3636    do
     3637    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3638    :
     3639   define input parameter   p-in-ord-num as character no-undo .
     3640   define output parameter  p-out-ord-num as character no-undo .
     3641   if num-entries(p-in-ord-num , "." ) = 1 then
     3642      p-out-ord-num = p-in-ord-num .
     3643      else do:
     3644        p-out-ord-num = entry(1, entry( 1 , p-in-ord-num , "." ) , "-" )  + "-" + entry( 2 , p-in-ord-num , "."  ) .
     3645      end.
     3646     end.
     3647   END PROCEDURE.
     3648   PROCEDURE my-enable_UI :
     3649    do
     3650    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3651    :
     3652     if v-cntxt-db-num = 0 then
     3653     assign
     3654       b-move-to:label in frame Dialog-Frame  = "---> УБД"
     3655     .
     3656     else
     3657     assign
     3658       b-move-to:label in frame Dialog-Frame  = "---> ГБД"
     3659     .
     3660     DISPLAY
     3661        sch-code sch-date sch-fact
     3662         WITH FRAME Dialog-Frame.
     3663     ENABLE b-quit
     3664            b-mark       when LOOKUP("b-mark":U,  bttns) > 0
     3665            b-sel        when LOOKUP("b-sel":U,   bttns) > 0
     3666            b-history
     3667            b-sch
     3668            b-help
     3669            b-add        when LOOKUP("b-add":U,  bttns) > 0
     3670            b-lkp
     3671            b-lkp-2
     3672            b-chg        when LOOKUP("b-chg":U,  bttns) > 0
     3673            b-del        when LOOKUP("b-del":U,  bttns) > 0
     3674            b-close
     3675            b-open
     3676            b-print
     3677            b-move
     3678            b-move-to
     3679            sch-code sch-date sch-fact
     3680            br-docs br-zapr
     3681         WITH FRAME Dialog-Frame.
     3682     VIEW FRAME Dialog-Frame.
     3683     end.
     3684   END PROCEDURE.
     3685   PROCEDURE OpenBr :
     3686    do
     3687    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3688    :
     3689   define input  parameter p-open-query     as logical   no-undo .
     3690   define input  parameter p-find-next      as logical   no-undo .
     3691   define input  parameter p-find-condition as character no-undo .
     3692   define variable l-query-was-opened as logical no-undo .
     3693   define variable title0 as character no-undo.
     3694   define variable p-file-label as character no-undo .
     3695   p-file-label = "Заказы Покупатель-Объект".
     3696   title0 = caps(p-file-label) + chr(32).
     3697   define variable sort-column-phrase as character no-undo .
     3698   case sort-column-name :
     3699     when "" then do:
     3700       assign
     3701         sort-column-phrase = ""
     3702       .
     3703     end.
     3704     otherwise do:
     3705       assign
     3706         sort-column-phrase = "by " + sort-column-name
     3707       .
     3708     end.
     3709   end case.
     3710   define variable l-open-query as logical   no-undo .
     3711   find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3712   if not available buf_clients then return .
     3713   filter-point = filter-point0 + par-mode.
     3714     CASE par-mode :
     3715       WHEN 'объ':U THEN DO:
     3716          ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name
     3717                                             + " Объект: " +  p-obj-type
     3718                                             + "  " +   string (p-obj-code)
     3719                                             .
     3720   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3721   define variable  l-disable-where-29  as logical   no-undo .
     3722   define variable  l-filter-open-29    as logical   .
     3723   define variable  flt-rec-29       as recid     no-undo .
     3724   define variable  filter-name-29      as character no-undo .
     3725   define variable  where-phrase-29     as character no-undo .
     3726   define variable  sort-phrase-29      as character no-undo .
     3727   define variable  where-phrase-rus-29 as character no-undo .
     3728   define variable  sort-phrase-rus-29  as character no-undo .
     3729   run gbl/flt-get.p
     3730     (input filter-point
     3731     ,output flt-rec-29
     3732     ,output filter-name-29
     3733     ,output where-phrase-29
     3734     ,output sort-phrase-29
     3735     ,output where-phrase-rus-29
     3736     ,output sort-phrase-rus-29
     3737     ).
     3738   if p-open-query then do:
     3739       run set-filter-name in this-procedure
     3740         (INPUT filter-name-29
     3741         ) no-error .
     3742     assign
     3743       l-filter-open-29 = false
     3744     .
     3745     if flt-rec-29 <> ?
     3746       or sort-column-phrase > ""
     3747     then do:
     3748       define variable  parameter-2-29 as character no-undo .
     3749       define variable  parameter-3-29 as character no-undo .
     3750       define variable  parameter-4-29 as character no-undo .
     3751       define variable  parameter-5-29 as character no-undo .
     3752       define variable  parameter-6-29 as character no-undo .
     3753       define variable  parameter-7-29 as character no-undo .
     3754         assign
     3755         parameter-3-29 =
     3756                                 "FOR EACH buf-po_ord-doc"
     3757         parameter-4-29 =
     3758           (
     3759             if (" buf-po_ord-doc.host-code = par-host-code and buf-po_ord-doc.obj-code = p-obj-code and buf-po_ord-doc.obj-type = p-obj-type and buf-po_ord-doc.doc-type = p-doc-type" + " " + where-phrase-29) <> ""
