     2058   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2059   procedure minbtn-set :
     2060       do
     2061           on error undo, return error return-value
     2062           :
     2063           define variable ii              as integer       no-undo .
     2064           define variable fh              as widget-handle no-undo .
     2065           define variable hh              as widget-handle no-undo .
     2066           define variable v-h             as handle        extent 4 no-undo .
     2067           define variable v-name-button   as character     no-undo .
     2068           define variable v-help-old-x    as decimal       no-undo .
     2069           define variable v-help-old-y    as decimal       no-undo .
     2070           define variable v-help-old-size as decimal       no-undo .
     2071           define variable v-frame-width   as decimal       no-undo .
     2072           define variable jj              as integer       no-undo .
     2073           do
     2074               on error undo, return error
     2075               :
     2076               assign
     2077                   v-frame-width = frame Dialog-Frame:width - 0.3
     2078                   fh            = frame Dialog-Frame:first-child
     2079                   hh            = fh:first-child
     2080                   ii            = 1
     2081                   .
     2082               do while valid-handle(hh):
     2083                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2084                   do:
     2085                       case lc(hh:name) :
     2086                           when "b-help" then
     2087                               do:
     2088                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2089                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2090                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2091                                   hh:TOOLTIP = "Помощь" .
     2092                                   v-help-old-x = hh:column .
     2093                                   v-help-old-y = hh:row    .
     2094                                   v-help-old-size = hh:width .
     2095                                   hh:width-chars = 2.5 .
     2096                               end.
     2097                           when "b-print" then
     2098                               do:
     2099                                   hh:load-image("cmp/b-print.bmp":u) .
     2100                                   hh:TOOLTIP = "Печать" .
     2101                                   v-h[ii] = hh:handle .
     2102                                   ii = ii + 1 .
     2103                                   hh:width-chars = 3 .
     2104                               end.
     2105                           when "b-history" or
     2106                           when "b-hist" then
     2107                               do:
     2108                                   hh:load-image("cmp/b-hist.bmp":u) .
     2109                                   hh:TOOLTIP = "История" .
     2110                                   v-h[ii] = hh:handle .
     2111                                   ii = ii + 1 .
     2112                                   hh:width-chars = 3 .
     2113                               end.
     2114                           when "b-sch" then
     2115                               do:
     2116                                   hh:load-image("cmp/b-sch.bmp":u) .
     2117                                   hh:TOOLTIP = "Установка Фильтра" .
     2118                                   v-h[ii] = hh:handle .
     2119                                   ii = ii + 1 .
     2120                                   hh:width-chars = 3 .
     2121                               end.
     2122                           when "b-hist-user" then
     2123                               do:
     2124                                   hh:load-image("cmp/b-hist.bmp":u) .
     2125                                   hh:TOOLTIP = "История пользователя" .
     2126                                   ii = ii + 1 .
     2127                               end.
     2128                       end case.
     2129                   end.
     2130                   hh = hh:next-sibling.
     2131               end.
     2132               b-help:column = v-frame-width - b-help:width-chars.
     2133               jj = 0.
     2134               repeat ii = 4 to 1 by -1 :
     2135                   if valid-handle (v-h[ii] ) then
     2136                   do:
     2137                       jj  = jj + 1 .
     2138                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2139                       v-h[ii]:row    = v-help-old-y .
     2140                   end.
     2141               end.
     2142           end.
     2143       end.
     2144   end procedure.
     2145   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2146   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2147   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2148   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2149   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2150   define variable v-diasize-current-frame-height as decimal   no-undo .
     2151   define variable v-diasize-change-size          as logical   no-undo .
     2152   define variable v-diasize-resize-button        as handle    no-undo .
     2153   define variable v-diasize-wndmax               as logical   no-undo .
     2154   define variable v-diasize-wndstore             as logical   no-undo .
