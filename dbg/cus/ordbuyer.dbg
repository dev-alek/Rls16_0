     1100        LABEL "Закр&ыть"
     1101        SIZE 10 BY 1 TOOLTIP "Закрыть накладную".
     1102   DEFINE BUTTON b-del
     1103        LABEL "&Удалить":L
     1104        SIZE 12 BY 1 TOOLTIP "Удалитиь заказ".
     1105   DEFINE BUTTON b-help
     1106        LABEL "Помо&щь":L
     1107        SIZE 12 BY 1.
     1108   DEFINE BUTTON b-history
     1109        LABEL "&История":L
     1110        SIZE 12 BY 1 TOOLTIP "История заказа".
     1111   DEFINE BUTTON b-lkp
     1112        LABEL "&Просмотр":L
     1113        SIZE 12 BY 1 TOOLTIP "Просмотр заказа без корректировки".
     1114   DEFINE BUTTON B-lkp-2
     1115        LABEL "Просмо&тр"
     1116        SIZE 10 BY 1 TOOLTIP "Просмотр запроса".
     1117   DEFINE BUTTON b-mark
     1118        LABEL "&*":L
     1119        SIZE 3 BY 1.
     1120   DEFINE BUTTON b-move
     1121        LABEL "Р&аспределить":L
     1122        SIZE 16.88 BY 1 TOOLTIP "Сформировать заявки по заказам".
     1123   DEFINE BUTTON b-move-to
     1124        LABEL "Отправить":L
     1125        SIZE 16.88 BY 1 TOOLTIP "Перенаправить заказ новый+ на распределение".
     1126   DEFINE BUTTON b-open
     1127        LABEL "&Открыть":L
     1128        SIZE 12 BY 1 TOOLTIP "Открыть запр+ до запр-".
     1129   DEFINE BUTTON b-print
     1130        LABEL "Пе&чать":L
     1131        SIZE 12 BY 1 TOOLTIP "Печать заказа".
     1132   DEFINE BUTTON b-quit AUTO-GO
     1133        LABEL "&Выход ":L
     1134        SIZE 12 BY 1 TOOLTIP "Выход из режима".
     1135   DEFINE BUTTON B-rez
     1136        LABEL "Резе&рв"
     1137        SIZE 10 BY 1 TOOLTIP "Создать расходный запрос у контрагента".
     1138   DEFINE BUTTON b-sch
     1139        LABEL "&Фильтр":L
     1140        SIZE 12 BY 1 TOOLTIP "Фильтр по списку заказов".
     1141   DEFINE BUTTON b-sel
     1142        LABEL "Вы&бор ":L
     1143        SIZE 12 BY 1 TOOLTIP "Выход из режима и выбор текущего номера  заказа".
     1144   DEFINE VARIABLE loc-agnt AS CHARACTER FORMAT "X(256)":U
     1145        LABEL "Исп"
     1146         VIEW-AS TEXT
     1147        SIZE 17.25 BY .67
     1148        FGCOLOR 4  NO-UNDO.
     1149   DEFINE VARIABLE loc-boss AS CHARACTER FORMAT "X(256)":U
     1150        LABEL "М-р"
     1151         VIEW-AS TEXT
     1152        SIZE 17.25 BY .67
     1153        FGCOLOR 4  NO-UNDO.
     1154   DEFINE VARIABLE loc-creid AS CHARACTER FORMAT "X(256)":U
     1155        LABEL "Создал"
     1156         VIEW-AS TEXT
     1157        SIZE 14 BY .67
     1158        FGCOLOR 4  NO-UNDO.
     1159   DEFINE VARIABLE loc-wrkr AS CHARACTER FORMAT "X(256)":U
     1160        LABEL "Кл-к"
     1161         VIEW-AS TEXT
     1162        SIZE 17.25 BY .67
     1163        FGCOLOR 4  NO-UNDO.
     1164   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "x(12)"
     1165        LABEL "&Начало номера"
     1166        VIEW-AS FILL-IN
     1167        SIZE 12 BY 1 NO-UNDO.
     1168   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/9999"
     1169        LABEL "Д&ата"
     1170        VIEW-AS FILL-IN
     1171        SIZE 12 BY 1 NO-UNDO.
     1172   DEFINE VARIABLE sch-fact AS DATE FORMAT "99/99/9999"
     1173        LABEL "Фа&кт"
     1174        VIEW-AS FILL-IN
     1175        SIZE 12 BY 1 NO-UNDO.
     1176   DEFINE VARIABLE sch-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1177         VIEW-AS TEXT
     1178        SIZE 14 BY .67 NO-UNDO.
     1179   DEFINE NEW SHARED QUERY br-docs FOR
     1180         buf-po_ord-doc SCROLLING.
     1181   DEFINE QUERY br-zapr FOR
     1182         buf-po_ord-doc-rcv,
     1183         ub.ord-chain,
     1184         buf-po_trn-doc SCROLLING.
     1185   DEFINE BROWSE br-docs
     1186     QUERY br-docs NO-LOCK DISPLAY
     1187         mark-string(recid( buf-po_ord-doc), rid-list) COLUMN-LABEL '*' FORMAT "X(1)"
     1188         buf-po_ord-doc.status_ COLUMN-LABEL 'Статус' Format "X(6)"
     1189         buf-po_ord-doc.flag_ COLUMN-LABEL 'OK' format "+/-"
     1190         buf-po_ord-doc.doc-code COLUMN-LABEL '№ док-та'
     1191         buf-po_ord-doc.doc-date COLUMN-LABEL 'Создан' FORMAT "99/99/99"
     1192         buf-po_ord-doc.fact-date COLUMN-LABEL 'Факт' FORMAT "99/99/99"
     1193         ( buf-po_ord-doc.cli-type +  string(buf-po_ord-doc.cli-code)) COLUMN-LABEL 'Код' format "x(12)"
     1194         buf-po_ord-doc.cli-name COLUMN-LABEL 'Покупатель' format "x(20)"
     1195         buf-po_ord-doc.qnty COLUMN-LABEL 'Количество'
     1196         buf-po_ord-doc.sum-rubl COLUMN-LABEL 'Сумма в руб.'
     1197         f-direct ( recid( buf-po_ord-doc )) COLUMN-LABEL '>' format "x(1)"
     1198     ENABLE
     1199          buf-po_ord-doc.status_
     1200       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.38 BY 9.83
     1201            BGCOLOR 15 .
     1202   DEFINE BROWSE br-zapr
     1203     QUERY br-zapr NO-LOCK DISPLAY
     1204         buf-po_trn-doc.doc-code
     1205         buf-po_trn-doc.doc-type FORMAT "X(3)"
     1206         buf-po_trn-doc.status_ COLUMN-LABEL "Стат" FORMAT "X(4)"
     1207         buf-po_trn-doc.flag_ COLUMN-LABEL "Ок" FORMAT "+/-"
     1208         buf-po_trn-doc.cli-type + string(buf-po_trn-doc.cli-code)  COLUMN-LABEL "Контрагент" FORMAT "X(12)"
     1209         buf-po_trn-doc.obj-type + string(buf-po_trn-doc.obj-code)  COLUMN-LABEL "Объект"
     1210         buf-po_trn-doc.doc-date
     1211         buf-po_trn-doc.fact-date
     1212         buf-po_trn-doc.tot-lines
     1213         buf-po_trn-doc.fact-qnty COLUMN-LABEL "Количество" FORMAT ">>>>>>>>9.<<<"
     1214         buf-po_trn-doc.tot-rubl  COLUMN-LABEL "Сумма руб." FORMAT ">>>>>>>>>9.99"
     1215       WITH NO-ROW-MARKERS SEPARATORS SIZE 94.75 BY 7.46.
     1216   DEFINE FRAME Dialog-Frame
     1217        b-quit AT ROW 1 COL 2
     1218        b-sel AT ROW 1 COL 14
     1219        b-history AT ROW 1 COL 26
     1220        b-sch AT ROW 1 COL 38
     1221        b-move-to AT ROW 1 COL 62
     1222        b-help AT ROW 1 COL 84.38
     1223        b-mark AT ROW 2 COL 2
     1224        b-add AT ROW 2 COL 5
     1225        b-lkp AT ROW 2 COL 14
     1226        b-chg AT ROW 2 COL 26
     1227        b-del AT ROW 2 COL 38
     1228        b-open AT ROW 2 COL 50
     1229        b-close AT ROW 2 COL 62
     1230        b-move AT ROW 2 COL 62
     1231        b-print AT ROW 2 COL 84.38
     1232        sch-code AT ROW 3.08 COL 26 COLON-ALIGNED
     1233        sch-date AT ROW 3.08 COL 47 COLON-ALIGNED
     1234        sch-fact AT ROW 3.08 COL 65.75 COLON-ALIGNED
     1235        br-docs AT ROW 4.21 COL 1
     1236        B-lkp-2 AT ROW 15.25 COL 1
     1237        B-close-trn AT ROW 15.25 COL 11
     1238        B-rez AT ROW 15.25 COL 21
     1239        br-zapr AT ROW 16.25 COL 1.5
     1240        sch-num AT ROW 3.25 COL 80.38 COLON-ALIGNED NO-LABEL
     1241        loc-boss AT ROW 14.38 COL 4.63 COLON-ALIGNED
     1242        loc-agnt AT ROW 14.38 COL 27.88 COLON-ALIGNED
     1243        loc-wrkr AT ROW 14.38 COL 53 COLON-ALIGNED
     1244        loc-creid AT ROW 14.38 COL 80.38 COLON-ALIGNED
     1245        " Поиск по:" VIEW-AS TEXT
     1246             SIZE 10.13 BY .67 AT ROW 3.25 COL 1.63
     1247             BGCOLOR 3 FGCOLOR 15
     1248        SPACE(84.62) SKIP(19.79)
     1249       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1250            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1251            TITLE "Список заказов ПО".
     1252   ASSIGN
     1253          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1254          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1255   ASSIGN
     1256          B-close-trn:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1257   ASSIGN
     1258          B-rez:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1259   ASSIGN
     1260          br-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
     1261   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1262   DO:
     1263     APPLY "END-ERROR":U TO SELF.
     1264   END.
     1265   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1266   DO:
     1267     run proc-add in this-procedure .
     1268   END.
     1269   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1270   DO:
     1271   find current buf-po_ord-doc no-lock no-error .
     1272   if not available buf-po_ord-doc then return no-apply .
     1273   do on stop undo, return no-apply :
     1274     find current buf-po_ord-doc exclusive-lock .
     1275   end.
     1276    define variable rr as recid no-undo .
     1277    if not available buf-po_ord-doc then return.
     1278      if not( buf-po_ord-doc.status_ = 'новый':U and buf-po_ord-doc.flag_ = false ) then do:
     1279         message "Нельзя корректировать заказ! " view-as alert-box  .
     1280         return.
     1281     end.
     1282    rr = recid(buf-po_ord-doc) .
     1283       run cus/ord-pou.w
     1284         ( input parParentProc ,
     1285           input-output rr  ,
     1286           input 'ИЗМЕНЕНИЕ':U ).
     1287     v-doc-rec = rr .
     1288     g#log =  br-docs:refresh() .
     1289     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1290     apply "entry" TO BR-docs IN FRAME Dialog-Frame.
     1291   END.
     1292   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     1293   DO:
     1294     define variable rr as recid no-undo .
     1295     if not available buf-po_ord-doc then return.
     1296     rr = recid(buf-po_ord-doc) .
     1297     run ord-close in this-procedure (recid(buf-po_ord-doc)) .
     1298     run openbr in this-procedure ( yes, no, '':u).
     1299     reposition br-docs to recid rr no-error.
     1300     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1301     apply "entry" TO BR-docs IN FRAME Dialog-Frame.
     1302   END.
     1303   ON CHOOSE OF B-close-trn IN FRAME Dialog-Frame
     1304   DO:
     1305    if not available buf-po_trn-doc   then return.
     1306    message "Закрыть внутренний запрос ?"
     1307     view-as alert-box question
     1308     buttons yes-no
     1309     update g-log.
     1310     if g-log = false then return no-apply.
     1311     if not (buf-po_trn-doc.status_  = 'запрос':U   ) then do:
     1312       message "Закрыть можно только ЗАПР !"
     1313               view-as alert-box information .
     1314       return no-apply.
     1315     end.
     1316     run close-zapr in this-procedure (buf-po_trn-doc.doc-code) .
     1317     OPEN QUERY br-zapr FOR EACH buf-po_ord-doc-rcv WHERE                   buf-po_ord-doc-rcv.doc-code = buf-po_ord-doc.doc-code NO-LOCK,          each ub.ord-chain no-lock where             ub.ord-chain.doc-code = buf-po_ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and             ub.ord-chain.rel-doc-type = 'trn'             ,               EACH buf-po_trn-doc  where            buf-po_trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK.
     1318   END.
     1319   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1320   DO:
     1321     if not available buf-po_ord-doc then return.
     1322     do on stop undo, return no-apply :
     1323       find current buf-po_ord-doc exclusive-lock .
     1324     end.
     1325     if not( buf-po_ord-doc.status_ = 'новый':U and buf-po_ord-doc.flag_ = false ) then do:
     1326       message "Нельзя удалять заказ ! " view-as alert-box  .
     1327       return .
     1328     end.
     1329     run ord-del in this-procedure ( recid(buf-po_ord-doc)) .
     1330   END.
     1331   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1332   DO:
     1333   if not available buf-po_ord-doc then return no-apply .
     1334       run cus/ordcdoc.w
     1335       (
     1336       parParentProc,
     1337       buf-po_ord-doc.host-code,
     1338       buf-po_ord-doc.doc-code,
     1339       "" ) .
     1340   END.
     1341   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1342   DO:
     1343   if not available buf-po_ord-doc then return no-apply .
     1344    define variable rr as recid no-undo .
     1345    rr = recid(buf-po_ord-doc) .
     1346         br-handle = br-docs:handle in frame Dialog-Frame .
     1347         next-prev = no.
     1348         do while next-prev <> ?:
     1349           if not available buf-po_ord-doc then do:
     1350             message "Неправильный выбор документа.".
     1351             return no-apply.
     1352           end.
     1353             run cus/ord-pou.w
     1354               ( input parParentProc ,
     1355                 input-output rr    ,
     1356                 input 'ПРОСМОТР':U ) .
     1357             v-doc-rec = rr .
     1358           if br-handle = ? then reposition br-docs to recid rr no-error.
     1359         end.
     1360   apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1361   END.
     1362   ON CHOOSE OF B-lkp-2 IN FRAME Dialog-Frame
     1363   DO:
     1364      if available buf-po_trn-doc then do:
     1365         run str/showdoc.p
     1366             (input parparentproc
     1367             ,input buf-po_trn-doc.doc-code
     1368             ,input ""
     1369             ,input ""
     1370             ,input 0
     1371             ,input true
     1372             ) no-error .
     1373             if error-status :error then message
     1374               vss-workfile vss-revision vss-description skip
     1375               error-status :get-message(1) skip
     1376               return-value skip
     1377               "Ошибка из showdoc.p"
     1378               view-as alert-box error
     1379             .
     1380     END.
     1381   END.
     1382   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1383   DO:
     1384   if available buf-po_ord-doc then do:
     1385   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1386   define variable v-str-recid15 as character no-undo .
     1387   define variable v-num-entry15 as integer   no-undo .
     1388   assign
     1389     v-str-recid15 = trim( string( recid( buf-po_ord-doc ) , "->>>>>>>>>>>9":U ) )
     1390     v-num-entry15 = lookup( v-str-recid15 , rid-list )
     1391   .
     1392   if v-num-entry15 > 0 then do:
     1393     assign
     1394       entry( v-num-entry15, rid-list ) = "":U
     1395       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1396     .
     1397   end.
     1398   else do:
     1399     assign
     1400       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1401     .
     1402   end.
     1403       g-log = br-docs:refresh() .
     1404       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1405           g-log = br-docs:select-next-row ().
     1406           apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1407       end.
     1408   end.
     1409   apply "entry" to br-docs in frame Dialog-Frame.
     1410   END.
     1411   ON CHOOSE OF b-move IN FRAME Dialog-Frame
     1412   DO:
     1413   END.
     1414   ON CHOOSE OF b-move-to IN FRAME Dialog-Frame
     1415   DO:
     1416   if not available buf-po_ord-doc then return.
     1417   if not( buf-po_ord-doc.status_ = 'новый':U  and
     1418          buf-po_ord-doc.flag_ = yes )  then do :
     1419           Message
     1420             "Нельзя перенаправить распределять  заказ в статусе "
     1421             caps(buf-po_ord-doc.status_) + string(buf-po_ord-doc.flag_,"+/-") skip
     1422             "Документ" buf-po_ord-doc.doc-code view-as alert-box information
     1423             .
     1424           return.
     1425         end.
     1426    if v-cntxt-db-num = 0 and buf-po_ord-doc.order-type = 3 then do:
     1427           Message
     1428             "Распределение заказа уже указано в Удаленной БД!" skip
     1429             "Изменить нельзя." skip
     1430             "Документ" buf-po_ord-doc.doc-code view-as alert-box information
     1431             .
     1432           return.
     1433     end.
     1434    if v-cntxt-db-num <> 0 and buf-po_ord-doc.order-type = 2 then do:
     1435           Message
     1436             "Распределение заказа уже указано в Главной БД!"   skip
     1437             "Изменить нельзя." skip
     1438             "Документ" buf-po_ord-doc.doc-code view-as alert-box information
     1439             .
     1440           return.
     1441     end.
     1442     define buffer buf_clients for ub.clients .
     1443     find first buf_clients no-lock where
     1444                 buf_clients.obj-code = buf-po_ord-doc.obj-code and
     1445                 buf_clients.obj-type = buf-po_ord-doc.obj-type no-error .
     1446     if v-cntxt-db-num = 0 and  buf_clients.db-num = 0
     1447     then do:
     1448           Message
     1449             "Нельзя перенаправить распределение в УБД для объекта главной БД "
     1450              skip
     1451             "Документ" buf-po_ord-doc.doc-code view-as alert-box information
     1452             .
     1453           return.
     1454     end.
     1455    define variable rr as recid no-undo .
     1456       rr = recid(buf-po_ord-doc) .
     1457       message "Перенаправить распределение заказа в другую БД по СПН ?"
     1458           view-as alert-box question
     1459           buttons yes-no
     1460           update g-log.
     1461           if g-log = true then do:
     1462               find current buf-po_ord-doc  exclusive-lock  no-error .
     1463               if v-cntxt-db-num = 0 then do:
     1464                  buf-po_ord-doc.order-type = 3 .
     1465               end.
     1466               else do:
     1467                  buf-po_ord-doc.order-type = 2 .
     1468               end.
     1469           end.
     1470     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1471     apply "entry" TO BR-docs IN FRAME Dialog-Frame.
     1472   END.
     1473   ON CHOOSE OF b-open IN FRAME Dialog-Frame
     1474   DO:
     1475     define variable rr as recid no-undo .
     1476     if not available buf-po_ord-doc then return.
     1477     rr = recid(buf-po_ord-doc) .
     1478     run ord-open in this-procedure ( recid(buf-po_ord-doc) ) .
     1479     run openbr in this-procedure (yes, no, '':u).
     1480     reposition br-docs to recid rr no-error.
     1481     apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     1482     apply "entry" TO BR-docs IN FRAME Dialog-Frame.
     1483   END.
     1484   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1485   DO:
     1486     find current buf-po_ord-doc no-lock no-error .
     1487     if available buf-po_ord-doc then
     1488         run cus/torg-26.p
     1489          ( input parParentProc ,
     1490            input recid (buf-po_ord-doc) ) .
     1491   END.
     1492   ON CHOOSE OF B-rez IN FRAME Dialog-Frame
     1493   DO:
     1494   END.
     1495   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1496   DO:
     1497       run proc-b-sch in this-procedure no-error.
     1498     if error-status:error then return no-apply.
     1499   END.
     1500   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1501   DO:
     1502     if ( available buf-po_ord-doc ) AND ( rid-list = "" ) then
     1503       rid-list = string( recid( buf-po_ord-doc ) ) .
     1504   END.
     1505   ON VALUE-CHANGED OF br-docs IN FRAME Dialog-Frame
     1506   DO:
     1507    if not available buf-po_ord-doc then return .
     1508    def buffer buf_clients for ub.clients.
     1509   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1511     (input  buf-po_ord-doc.creid
     1512     ,output loc-creid
     1513     )  .
     1514    find first buf_clients no-lock where
     1515            buf_clients.obj-type = 'чел':U  and
     1516            buf_clients.obj-code  = buf-po_ord-doc.boss no-error.
     1517       if available buf_clients then loc-boss = buf_clients.obj-name.
     1518       else loc-boss = "".
     1519    find first buf_clients no-lock where
     1520            buf_clients.obj-type = 'чел':U  and
     1521            buf_clients.obj-code  = buf-po_ord-doc.agnt no-error.
     1522       if available buf_clients then loc-agnt = buf_clients.obj-name.
     1523       else loc-agnt = "".
     1524    find first buf_clients no-lock where
     1525            buf_clients.obj-type = 'чел':U  and
     1526            buf_clients.obj-code  = buf-po_ord-doc.wrkr no-error.
     1527       if available buf_clients then loc-wrkr = buf_clients.obj-name.
     1528       else loc-wrkr = "".
     1529     display loc-creid
     1530       loc-boss
     1531       loc-agnt
     1532       loc-wrkr
     1533     with frame Dialog-Frame.
     1534     OPEN QUERY br-zapr FOR EACH buf-po_ord-doc-rcv WHERE                   buf-po_ord-doc-rcv.doc-code = buf-po_ord-doc.doc-code NO-LOCK,          each ub.ord-chain no-lock where             ub.ord-chain.doc-code = buf-po_ord-doc-rcv.rcv-code and             ub.ord-chain.doc-type = 'rcv'                  and             ub.ord-chain.rel-doc-type = 'trn'             ,               EACH buf-po_trn-doc  where            buf-po_trn-doc.doc-code = ub.ord-chain.rel-doc-code  NO-LOCK.
     1535   END.
