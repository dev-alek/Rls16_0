     1078   DEFINE new SHARED VARIABLE Sort-gr AS LOGICAL
     1079        LABEL "Сортировать по группам товаров"
     1080        VIEW-AS TOGGLE-BOX
     1081        size 42.25 by 0.75 NO-UNDO init false .
     1082   DEFINE new Shared VARIABLE print-graft AS LOGICAL
