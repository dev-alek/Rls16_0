     4097   PROCEDURE ord-close :
     4098    do
     4099    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4100    :
     4101   define input parameter p-loc-recid as recid no-undo .
     4102   message "Закрыть заказ ?"
     4103   view-as alert-box question
     4104   buttons yes-no
     4105   update g-log.
     4106   if g-log = false then return no-apply.
     4107     run cus/ordpocls.p
     4108       ( input parParentProc ,
     4109         input p-loc-recid ,
     4110         input yes )
     4111         no-error .
     4112     if error-status :error then do:
     4113     return error return-value .
     4114     end.
     4115     else do:
     4116       run OpenBr in this-procedure (yes, no, '':U).
     4117     end.
     4118     end.
     4119   END PROCEDURE.
     4120   PROCEDURE ord-del :
     4121    do
     4122    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4123    :
     4124   define input parameter p-loc-recid as recid no-undo .
     4125   find current buf-po_ord-doc  exclusive-lock    no-error .
     4126   if not available buf-po_ord-doc  then return .
     4127   define variable g-log as log no-undo.
     4128   if  buf-po_ord-doc.status_ = 'факт':U  then do:
     4129       message "Заказ в статусе ФАКТ не может быть удален !!!"
     4130       view-as alert-box information .
     4131       return error .
     4132   end.
     4133   message "Удалить запись ?"
     4134           view-as alert-box question
     4135           buttons yes-no
     4136           update g-log.
     4137   if g-log = false then return no-apply.
     4138   delete buf-po_ord-doc .
     4139   run openbr in this-procedure (yes, no, '':u).
     4140     end.
     4141   END PROCEDURE.
     4142   PROCEDURE ord-open :
     4143    do
     4144    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4145    :
     4146   define input parameter p-loc-recid as recid no-undo .
     4147   message "Открыть заказ ?"
     4148   view-as alert-box question
     4149   buttons yes-no
     4150   update g-log.
     4151   if g-log = false then return no-apply.
     4152     run cus/ordooopn.p
     4153     ( input parParentProc ,
     4154       input p-loc-recid )
     4155       no-error .
     4156     if error-status :error then do:
     4157     message vss-workfile vss-revision vss-description skip
     4158            "Ошибка ordpoopn.p " skip
     4159             skip
     4160             error-status :get-message(1) skip
     4161             return-value skip
     4162             view-as alert-box error
     4163     .
     4164     return error .
     4165     end.
     4166     else do:
     4167       run openbr in this-procedure (yes, no, '':u).
     4168     end.
     4169     end.
     4170   END PROCEDURE.
     4171   PROCEDURE proc-add :
     4172    do
     4173    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4174    :
     4175    define variable rr as recid no-undo .
     4176         rr = ? .
     4177         run cus/ord-pou.w
     4178           (input  parParentProc ,
     4179            input-output rr ,
     4180            input 'ДОБАВЛЕНИЕ':U ) no-error .
     4181            if error-status :error then
     4182            message
     4183              vss-workfile vss-revision vss-description skip
     4184              error-status :get-message(1) skip
     4185              return-value skip
     4186              "cus/ord-pou.w"
     4187              view-as alert-box error
     4188            .
     4189         v-doc-rec = rr .
     4190         run openbr in this-procedure (yes, no, '':u).
     4191         reposition br-docs to recid v-doc-rec no-error .
     4192         apply "VALUE-CHANGED" TO BR-docs IN FRAME Dialog-Frame.
     4193     end.
     4194   END PROCEDURE.
     4195   PROCEDURE proc-b-sch :
