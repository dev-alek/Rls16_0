     2039   on help of frame Dialog-Frame
     2040   do:
     2041     run gbl/app_help.p
     2042       (input this-procedure :file-name
     2043       ,input ''
     2044       ,input ?
     2045       ) no-error.
     2046     if error-status :error then do:
     2047       message
     2048         "Ошибка при вызове помощи"
     2049         error-status :get-message(1)
     2050         view-as alert-box .
     2051     end.
