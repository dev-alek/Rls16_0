      372   procedure fltfield-clear :
      373     define output parameter loc-fld as character no-undo.
      374     define output parameter loc-lab as character no-undo .
      375     define output parameter loc-spr as character no-undo .
      376     define output parameter loc-dim as character no-undo .
      377     assign
      378       loc-fld = ""
      379       loc-lab = ""
      380       loc-spr = ""
      381       loc-dim = "0"
      382     .
      383   end procedure .
      384   procedure fltfield-add :
      385     define input        parameter par-fld as character no-undo.
      386     define input        parameter par-lab as character no-undo .
      387     define input        parameter par-spr as character no-undo .
      388     define input-output parameter loc-fld as character no-undo.
      389     define input-output parameter loc-lab as character no-undo .
      390     define input-output parameter loc-spr as character no-undo .
      391     define input-output parameter loc-dim as character no-undo .
      392     do
      393     on error undo, return error
      394     :
      395       assign
      396       loc-fld = if loc-dim = '0'
      397                 then par-fld
      398                 else (loc-fld + chr(44) + par-fld)
      399       loc-lab = if loc-dim = '0'
      400                 then par-lab
      401                 else (loc-lab + chr(44) + par-lab)
      402       loc-spr = if loc-dim = '0'
      403                 then par-spr
      404                 else (loc-spr + chr(44) + par-spr)
      405       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      406                 string(integer(if num-entries(loc-dim) > 1
      407                               then entry(2, loc-dim)
      408                               else entry(1, loc-dim)
      409                               ) + 1)
      410       no-error
      411       .
      412     end.
      413   end procedure.
      414   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   define  stream PrnLibStream.
      416   procedure prn-lib-prn-file :
      417     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      418     define input parameter p-DIsabledoptions as integer no-undo .
      419     define variable v-report-name as character no-undo .
      420     define variable v-user-action as character no-undo .
      421     define variable v-printed     as logical   no-undo .
      422     define variable v-exist       as logical   no-undo .
