        1   define variable vss-revision    as character no-undo init "$Revision$":u .
        2   define variable vss-author      as character no-undo init "$Author$":u .
        3   define variable vss-date        as character no-undo init "$Date$":u .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        5   define variable vss-archive     as character no-undo init "$Archive$":u .
        6   define variable vss-description as character no-undo init "Список бланков" .
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable g#log as logical no-undo .
      111   define input parameter  x-cli-type   like ub.ord-blank.cli-type no-undo.
      112   define input parameter  x-cli-code   like ub.ord-blank.cli-code no-undo.
      113   define output parameter x-blank-name like ub.ord-blank.blank-name no-undo.
      114   define variable rec-blank as recid no-undo.
      115   DEFINE BUTTON B-chg AUTO-GO
      116        LABEL "&Изменить"
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON B-del AUTO-GO
      120        LABEL "&Удалить"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON B-exit AUTO-END-KEY
      124        LABEL "&Выход"
      125        SIZE 10 BY 1 TOOLTIP "Выход из режима"
      126        BGCOLOR 8 .
      127   DEFINE BUTTON B-Help
      128        LABEL "&Помощь"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON B-ins AUTO-GO
      132        LABEL "&Добавить"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE BUTTON B-sel AUTO-GO
      136        LABEL "Вы&бор"
      137        SIZE 10 BY 1 TOOLTIP "Выбрать шаблон для печати"
      138        BGCOLOR 8 .
      139   DEFINE QUERY BROWSE-1 FOR
      140         ub.ord-blank SCROLLING.
      141   DEFINE BROWSE BROWSE-1
      142     QUERY BROWSE-1 NO-LOCK DISPLAY
      143         ub.ord-blank.last-use COLUMN-LABEL "З" FORMAT "+/-":U
      144         ub.ord-blank.last-use-rcv COLUMN-LABEL "П" FORMAT "+/-":U
      145         ub.ord-blank.blank-name FORMAT "X(30)":U
      146         ub.ord-blank.File-name COLUMN-LABEL "Путь" FORMAT "X(80)":U
      147       WITH NO-ROW-MARKERS SEPARATORS SIZE 62.88 BY 8.46
      148            BGCOLOR 15 .
      149   DEFINE FRAME Dialog-Frame
      150        B-exit AT ROW 1 COL 1.5
      151        B-sel AT ROW 1 COL 11.5
      152        B-ins AT ROW 1 COL 21.5
      153        B-chg AT ROW 1 COL 31.5
      154        B-del AT ROW 1 COL 41.5
      155        B-Help AT ROW 1 COL 51.5
      156        BROWSE-1 AT ROW 2.17 COL 1.63
      157        SPACE(0.61) SKIP(0.24)
      158       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      159            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      160            TITLE "Список бланков"
      161            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-exit.
      162   ASSIGN
      163          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      164          FRAME Dialog-Frame:HIDDEN           = TRUE.
      165   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      166   DO:
      167     APPLY "END-ERROR":U TO SELF.
      168   END.
      169   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      170   DO:
      171       Find current ub.ord-blank exclusive-lock no-error.
      172       if avail ub.ord-blank then DO:
      173           rec-blank = recid (ub.ord-blank).
      174           run cus/u-blank.w (input "chg":U , input x-cli-type, input x-cli-code , input rec-blank).
      175           OPEN QUERY BROWSE-1 FOR EACH ub.ord-blank       WHERE ub.ord-blank.cli-code = x-cli-code AND ub.ord-blank.cli-type = x-cli-type NO-LOCK INDEXED-REPOSITION.
      176           End.
      177   Return no-apply.
      178   END.
      179   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      180   DO:
      181     g#log = false.
      182     Message "Удалять запись ? ." skip "  Вы уверены ?"
      183              view-as alert-box question buttons OK-Cancel update g#log.
      184              if not g#log then return no-apply.
      185     Find current ub.ord-blank exclusive-lock no-error.
      186     if NOT  error-status:error THEN DO:
      187       DELETE ub.ord-blank no-error.
      188       OPEN QUERY BROWSE-1 FOR EACH ub.ord-blank       WHERE ub.ord-blank.cli-code = x-cli-code AND ub.ord-blank.cli-type = x-cli-type NO-LOCK INDEXED-REPOSITION.
      189       End.
      190     Return no-apply.
      191   END.
      192   ON CHOOSE OF B-ins IN FRAME Dialog-Frame
      193   DO:
      194     run cus/u-blank.w (input "add" , input x-cli-type, input x-cli-code , input rec-blank ).
      195     OPEN QUERY BROWSE-1 FOR EACH ub.ord-blank       WHERE ub.ord-blank.cli-code = x-cli-code AND ub.ord-blank.cli-type = x-cli-type NO-LOCK INDEXED-REPOSITION.
      196      Return no-apply.
      197   END.
      198   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      199   DO:
      200     if available ub.ord-blank then do:
      201     assign
      202       rec-blank = recid (ub.ord-blank)
      203       x-blank-name = ub.ord-blank.blank-name
      204     .
      205     Return.
      206     end.
      207   END.
      208   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      209   on help of frame Dialog-Frame
      210   do:
      211     run gbl/app_help.p
      212       (input this-procedure :file-name
      213       ,input ''
      214       ,input ?
      215       ) no-error.
      216     if error-status :error then do:
      217       message
      218         "Ошибка при вызове помощи"
      219         error-status :get-message(1)
      220         view-as alert-box .
      221     end.
      222   end.
      223   run minbtn-set in this-procedure .
      224   on choose of b-help in frame Dialog-Frame
      225   do:
      226     apply "help":u to frame Dialog-Frame .
      227   end.
      228   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      229   procedure minbtn-set :
      230       do
      231           on error undo, return error return-value
      232           :
      233           define variable ii              as integer       no-undo .
      234           define variable fh              as widget-handle no-undo .
      235           define variable hh              as widget-handle no-undo .
      236           define variable v-h             as handle        extent 4 no-undo .
      237           define variable v-name-button   as character     no-undo .
      238           define variable v-help-old-x    as decimal       no-undo .
      239           define variable v-help-old-y    as decimal       no-undo .
      240           define variable v-help-old-size as decimal       no-undo .
      241           define variable v-frame-width   as decimal       no-undo .
      242           define variable jj              as integer       no-undo .
      243           do
      244               on error undo, return error
      245               :
      246               assign
      247                   v-frame-width = frame Dialog-Frame:width - 0.3
      248                   fh            = frame Dialog-Frame:first-child
      249                   hh            = fh:first-child
      250                   ii            = 1
      251                   .
      252               do while valid-handle(hh):
      253                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      254                   do:
      255                       case lc(hh:name) :
      256                           when "b-help" then
      257                               do:
      258                                   hh:load-image-up("cmp/b-help.bmp":u) .
      259                                   hh:load-image-down("cmp/b-help.bmp":u) .
      260                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      261                                   hh:TOOLTIP = "Помощь" .
      262                                   v-help-old-x = hh:column .
      263                                   v-help-old-y = hh:row    .
      264                                   v-help-old-size = hh:width .
      265                                   hh:width-chars = 2.5 .
      266                               end.
      267                           when "b-print" then
      268                               do:
      269                                   hh:load-image("cmp/b-print.bmp":u) .
      270                                   hh:TOOLTIP = "Печать" .
      271                                   v-h[ii] = hh:handle .
      272                                   ii = ii + 1 .
      273                                   hh:width-chars = 3 .
      274                               end.
      275                           when "b-history" or
      276                           when "b-hist" then
      277                               do:
      278                                   hh:load-image("cmp/b-hist.bmp":u) .
      279                                   hh:TOOLTIP = "История" .
      280                                   v-h[ii] = hh:handle .
      281                                   ii = ii + 1 .
      282                                   hh:width-chars = 3 .
      283                               end.
      284                           when "b-sch" then
      285                               do:
      286                                   hh:load-image("cmp/b-sch.bmp":u) .
      287                                   hh:TOOLTIP = "Установка Фильтра" .
      288                                   v-h[ii] = hh:handle .
      289                                   ii = ii + 1 .
      290                                   hh:width-chars = 3 .
      291                               end.
      292                           when "b-hist-user" then
      293                               do:
      294                                   hh:load-image("cmp/b-hist.bmp":u) .
      295                                   hh:TOOLTIP = "История пользователя" .
      296                                   ii = ii + 1 .
      297                               end.
      298                       end case.
      299                   end.
      300                   hh = hh:next-sibling.
      301               end.
      302               b-help:column = v-frame-width - b-help:width-chars.
      303               jj = 0.
      304               repeat ii = 4 to 1 by -1 :
      305                   if valid-handle (v-h[ii] ) then
      306                   do:
      307                       jj  = jj + 1 .
      308                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      309                       v-h[ii]:row    = v-help-old-y .
      310                   end.
      311               end.
      312           end.
      313       end.
      314   end procedure.
      315   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      316   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      317   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      318   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      319   define variable v-diasize-current-frame-width  as decimal   no-undo .
      320   define variable v-diasize-current-frame-height as decimal   no-undo .
      321   define variable v-diasize-change-size          as logical   no-undo .
      322   define variable v-diasize-resize-button        as handle    no-undo .
      323   define variable v-diasize-wndmax               as logical   no-undo .
      324   define variable v-diasize-wndstore             as logical   no-undo .
      325   define variable v-diasize-proc-name            as character no-undo .
      326   define variable v-diasize-browse-handle        as handle    no-undo .
      327   define variable v-diasize-browse-number        as integer   no-undo .
      328   define variable v-diasize-need-full-display    as logical   no-undo init false .
      329   define temp-table temp-diasize-handle no-undo
      330     field handle-value  as handle
      331     field save-position as decimal
      332     index xpk is primary unique handle-value
      333     .
      334   define temp-table temp-browse-handle no-undo
      335     field browse-type   as character
      336     field browse-number as integer
      337     field browse-handle as handle
      338     field original-size as decimal
      339     index xpk is primary unique browse-type browse-number
      340     index xie browse-type browse-handle
      341   .
      342   procedure diasize_change-height :
      343     define input  parameter p-change-value  as decimal   no-undo .
      344     define input  parameter p-move-resize   as logical   no-undo .
      345     define variable v-field-group-handle    as handle    no-undo .
      346     define variable v-object-handle         as handle    no-undo .
      347     define variable v-frame-height          as decimal   no-undo .
      348     define variable v-frame-virtual-height  as decimal   no-undo .
      349     define variable v-browse-height         as decimal   no-undo .
      350     define variable v-window-height         as decimal   no-undo .
      351     define variable v-window-virtual-height as decimal   no-undo .
      352     define variable v-change-sign           as integer   no-undo .
      353     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      354     define buffer buf_temp-browse-handle  for temp-browse-handle .
      355     if p-change-value > 0
      356     then do:
      357       if frame Dialog-Frame :height + p-change-value
      358           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      359       then do:
      360         assign
      361           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      362                           - (frame Dialog-Frame :height-chars)
      363         .
      364         if p-change-value <= 0
      365         then do:
      366           run diasize_position-resize-button in this-procedure .
      367           return .
      368         end.
      369       end.
      370     end.
      371     if p-change-value < 0
      372     then do:
      373       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      374       then do:
      375         assign
      376           p-change-value = v-diasize-orig-frame-height
      377                          - (frame Dialog-Frame :height-chars)
      378         .
      379         if p-change-value >= 0
      380         then do:
      381           run diasize_position-resize-button in this-procedure .
      382           return .
      383         end.
      384       end.
      385     end.
      386     if p-change-value >= 0
      387     then do:
      388       assign
      389         v-change-sign = 1
      390       .
      391     end.
      392     else do:
      393       assign
      394         v-change-sign = -1
      395       .
      396     end.
      397     assign
      398       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      399     .
      400     if p-change-value = 0
      401     then do:
      402       run diasize_position-resize-button in this-procedure .
      403       return .
      404     end.
      405     move_block:
      406     do
      407     on error undo move_block, retry move_block
      408     :
      409       if retry
      410       then do:
      411         do
      412         on error undo move_block, leave move_block
      413         :
      414           if p-change-value > 0
      415           then do:
      416             for each buf_temp-diasize-handle
      417             on error undo, next
      418             :
      419               assign
      420                 v-object-handle = buf_temp-diasize-handle.handle-value
      421               .
      422               if v-object-handle <> v-diasize-resize-button
      423               then do:
      424                 assign
      425                   v-object-handle :row = buf_temp-diasize-handle.save-position
      426                 .
      427               end.
      428             end.
      429             assign
      430               v-diasize-browse-handle :height = v-browse-height
      431             .
      432             for each buf_temp-browse-handle
      433               where buf_temp-browse-handle.browse-type = 'height':u
      434             on error undo, next
      435             :
      436               assign
      437                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      438               .
      439             end.
      440             assign
      441               frame Dialog-Frame :height = v-frame-height
      442             .
      443             if frame Dialog-Frame :scrollable = true
      444             then do:
      445               assign
      446                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      447               .
      448             end.
      449             run diasize_position-resize-button in this-procedure .
      450           end.
      451           else do:
      452             if frame Dialog-Frame :scrollable = true
      453             then do:
      454               assign
      455                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      456               .
      457             end.
      458             assign
      459               frame Dialog-Frame :height = v-frame-height
      460             .
      461             assign
      462               v-diasize-browse-handle :height = v-browse-height
      463             .
      464             for each buf_temp-browse-handle
      465               where buf_temp-browse-handle.browse-type = 'height':u
      466             on error undo, next
      467             :
      468               assign
      469                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      470               .
      471             end.
      472             for each buf_temp-diasize-handle
      473             on error undo, next
      474             :
      475               assign
      476                 v-object-handle = buf_temp-diasize-handle.handle-value
      477               .
      478               if v-object-handle <> v-diasize-resize-button
      479               then do:
      480                 assign
      481                   v-object-handle :row = buf_temp-diasize-handle.save-position
      482                 .
      483               end.
      484             end.
      485             run diasize_position-resize-button in this-procedure .
      486           end.
      487           assign
      488             v-diasize-change-size = false
      489           .
      490           leave move_block .
      491         end.
      492       end.
      493       assign
      494         v-diasize-need-full-display = true
      495       .
      496       if v-diasize-change-size = false
      497       then do:
      498         assign
      499           v-diasize-change-size = true
      500         .
      501       end.
      502       else do:
      503         return .
      504       end.
      505       assign
      506         v-frame-height = frame Dialog-Frame :height
      507         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      508         v-browse-height = v-diasize-browse-handle :height
      509       .
      510       for each buf_temp-browse-handle
      511         where buf_temp-browse-handle.browse-type = 'height':u
      512       :
      513         assign
      514           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      515         .
      516       end.
      517       for each buf_temp-diasize-handle
      518       :
      519         delete buf_temp-diasize-handle .
      520       end.
      521       assign
      522         v-field-group-handle = frame Dialog-Frame :first-child
      523       .
      524       do while valid-handle(v-field-group-handle)
      525       :
      526         assign
      527           v-object-handle = v-field-group-handle :first-child
      528         .
      529         do while valid-handle(v-object-handle)
      530         :
      531           if  v-object-handle <> v-diasize-browse-handle :handle
      532           and can-query(v-object-handle, "row")
      533           and can-query(v-object-handle, "height")
      534           and ( v-object-handle :row > v-diasize-browse-handle :row )
      535           then do:
      536             find first buf_temp-browse-handle
      537               where buf_temp-browse-handle.browse-type   = 'height':u
      538                 and buf_temp-browse-handle.browse-handle = v-object-handle
      539               no-error .
      540             if available buf_temp-browse-handle
      541             then do:
      542             end.
      543             else do:
      544               create buf_temp-diasize-handle .
      545               assign
      546                 buf_temp-diasize-handle.handle-value  = v-object-handle
      547                 buf_temp-diasize-handle.save-position = v-object-handle :row
      548               .
      549             end.
      550           end.
      551           assign
      552             v-object-handle = v-object-handle :next-sibling
      553           .
      554         end.
      555         assign
      556           v-field-group-handle = v-field-group-handle :next-sibling
      557         .
      558       end.
      559       do with frame Dialog-Frame
      560       :
      561         hide v-diasize-resize-button .
      562         assign
      563           v-diasize-resize-button :row    = 1
      564           v-diasize-resize-button :column = 1
      565         .
      566       end.
      567       if p-change-value > 0
      568       then do:
      569         if frame Dialog-Frame :scrollable = true
      570         then do:
      571           assign
      572             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      573             no-error .
      574           if error-status :error
      575           or error-status :get-message(1) <> ""
      576           then do:
      577             undo move_block, retry move_block .
      578           end.
      579         end.
      580         assign
      581           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      582           no-error .
      583         if error-status :error
      584         or error-status :get-message(1) <> ""
      585         then do:
      586           undo move_block, retry move_block .
      587         end.
      588         assign
      589           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      590           no-error .
      591         if error-status :error
      592         or error-status :get-message(1) <> ""
      593         then do:
      594           undo move_block, retry move_block .
      595         end.
      596         for each buf_temp-browse-handle
      597           where buf_temp-browse-handle.browse-type = 'height':u
      598         on error undo move_block, retry move_block
      599         :
      600           assign
      601             buf_temp-browse-handle.browse-handle :height
      602               = buf_temp-browse-handle.browse-handle :height + p-change-value
      603             no-error .
      604           if error-status :error
      605           or error-status :get-message(1) <> ""
      606           then do:
      607             undo move_block, retry move_block .
      608           end.
      609         end.
      610         for each buf_temp-diasize-handle
      611         on error undo move_block, retry move_block
      612         :
      613           assign
      614             v-object-handle = buf_temp-diasize-handle.handle-value
      615           .
      616           if v-object-handle <> v-diasize-resize-button
      617           then do:
      618             assign
      619               v-object-handle :row = v-object-handle :row + p-change-value
      620               no-error .
      621             if error-status :error
      622             or error-status :get-message(1) <> ""
      623             then do:
      624               undo move_block, retry move_block .
      625             end.
      626           end.
      627         end.
      628       end.
      629       else do:
      630         for each buf_temp-diasize-handle
      631         on error undo move_block, retry move_block
      632         :
      633           assign
      634             v-object-handle = buf_temp-diasize-handle.handle-value
      635           .
      636           if v-object-handle <> v-diasize-resize-button
      637           then do:
      638             assign
      639               v-object-handle :row = v-object-handle :row + p-change-value
      640               no-error .
      641             if error-status :error
      642             or error-status :get-message(1) <> ""
      643             then do:
      644               undo move_block, retry move_block .
      645             end.
      646           end.
      647         end.
      648         assign
      649           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      650           no-error .
      651         if error-status :error
      652         or error-status :get-message(1) <> ""
      653         then do:
      654           undo move_block, retry move_block .
      655         end.
      656         for each buf_temp-browse-handle
      657           where buf_temp-browse-handle.browse-type = 'height':u
      658         on error undo move_block, retry move_block
      659         :
      660           assign
      661             buf_temp-browse-handle.browse-handle :height
      662               = buf_temp-browse-handle.browse-handle :height + p-change-value
      663             no-error .
      664           if error-status :error
      665           or error-status :get-message(1) <> ""
      666           then do:
      667             undo move_block, retry move_block .
      668           end.
      669         end.
      670         assign
      671           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      672           no-error .
      673         if error-status :error
      674         or error-status :get-message(1) <> ""
      675         then do:
      676           undo move_block, retry move_block .
      677         end.
      678         if frame Dialog-Frame :scrollable = true
      679         then do:
      680           assign
      681             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      682             no-error .
      683           if error-status :error
      684           or error-status :get-message(1) <> ""
      685           then do:
      686             undo move_block, retry move_block .
      687           end.
      688         end.
      689       end.
      690       if p-move-resize = true
      691       then do:
      692         run diasize_position-resize-button in this-procedure .
      693       end.
      694       if v-diasize-wndstore = true
      695       then do:
      696         if connected("ub") = true
      697         then do:
      698           define variable v-cntxt-db-num        as integer   no-undo .
      699           define variable v-cntxt-userid        as character no-undo .
      700           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      701                                             , OUTPUT v-cntxt-userid
      702                                             ) .
      703           run gbl/wndsizew.p
      704             (input  v-cntxt-db-num
      705             ,input  v-cntxt-userid
      706             ,input  v-diasize-proc-name
      707             ,input  'height':u
      708             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      709             ) .
      710         end.
      711       end.
      712     end.
      713     assign
      714       v-diasize-change-size = false
      715     .
      716   end procedure.
      717   procedure diasize_set-height :
      718     define input  parameter p-new-height  as decimal   no-undo .
      719     define input  parameter p-move-resize as logical   no-undo .
      720     do
      721     on error undo, return error return-value
      722     :
      723       run diasize_change-height in this-procedure
      724         (input  (p-new-height - frame Dialog-Frame :height)
      725         ,input  p-move-resize
      726         ) .
      727     end.
      728   end procedure.
      729   procedure diasize_change-width :
      730     define input  parameter p-change-value as decimal   no-undo .
      731     define input  parameter p-move-resize  as logical   no-undo .
      732     define variable v-field-group-handle   as handle    no-undo .
      733     define variable v-object-handle        as handle    no-undo .
      734     define variable v-frame-width          as decimal   no-undo .
      735     define variable v-frame-virtual-width  as decimal   no-undo .
      736     define variable v-browse-width         as decimal   no-undo .
      737     define variable v-window-width         as decimal   no-undo .
      738     define variable v-window-virtual-width as decimal   no-undo .
      739     define variable v-change-sign          as integer   no-undo .
      740     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      741     define buffer buf_temp-browse-handle  for temp-browse-handle .
      742     if p-change-value > 0
      743     then do:
      744       if frame Dialog-Frame :width + p-change-value >
      745           session :width-chars
      746       then do:
      747         assign
      748           p-change-value = session :width-chars - frame Dialog-Frame :width
      749         .
      750         if p-change-value <= 0
      751         then do:
      752           run diasize_position-resize-button in this-procedure .
      753           return .
      754         end.
      755       end.
      756     end.
      757     if p-change-value < 0
      758     then do:
      759       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      760       then do:
      761         assign
      762           p-change-value = v-diasize-orig-frame-width
      763                          - frame Dialog-Frame :width
      764         .
      765         if p-change-value >= 0
      766         then do:
      767           run diasize_position-resize-button in this-procedure .
      768           return .
      769         end.
      770       end.
      771     end.
      772     if p-change-value >= 0
      773     then do:
      774       assign
      775         v-change-sign = 1
      776       .
      777     end.
      778     else do:
      779       assign
      780         v-change-sign = -1
      781       .
      782     end.
      783     assign
      784       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      785     .
      786     if p-change-value = 0
      787     then do:
      788       run diasize_position-resize-button in this-procedure .
      789       return .
      790     end.
      791     move_block:
      792     do
      793     on error undo move_block, leave move_block
      794     :
      795       if retry
      796       then do:
      797         do
      798         on error undo move_block, leave move_block
      799         :
      800           if p-change-value > 0
      801           then do:
      802             for each buf_temp-diasize-handle
      803             on error undo, next
      804             :
      805               assign
      806                 v-object-handle = buf_temp-diasize-handle.handle-value
      807               .
      808               if v-object-handle <> v-diasize-resize-button
      809               then do:
      810                 assign
      811                   v-object-handle :col = buf_temp-diasize-handle.save-position
      812                 .
      813               end.
      814             end.
      815             assign
      816               v-diasize-browse-handle :width = v-browse-width
      817             .
      818             for each buf_temp-browse-handle
      819               where buf_temp-browse-handle.browse-type = 'width':u
      820             on error undo, next
      821             :
      822               assign
      823                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      824               .
      825             end.
      826             assign
      827               frame Dialog-Frame :width = v-frame-width
      828             .
      829             if frame Dialog-Frame :scrollable = true
      830             then do:
      831               assign
      832                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      833               .
      834             end.
      835             run diasize_position-resize-button in this-procedure .
      836           end.
      837           else do:
      838             if frame Dialog-Frame :scrollable = true
      839             then do:
      840               assign
      841                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      842               .
      843             end.
      844             assign
      845               frame Dialog-Frame :width = v-frame-width
      846             .
      847             for each buf_temp-browse-handle
      848               where buf_temp-browse-handle.browse-type = 'width':u
      849             on error undo, next
      850             :
      851               assign
      852                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      853               .
      854             end.
      855             assign
      856               v-diasize-browse-handle :width = v-browse-width
      857             .
      858             for each buf_temp-diasize-handle
      859             on error undo, next
      860             :
      861               assign
      862                 v-object-handle = buf_temp-diasize-handle.handle-value
      863               .
      864               if v-object-handle <> v-diasize-resize-button
      865               then do:
      866                 assign
      867                   v-object-handle :col = buf_temp-diasize-handle.save-position
      868                 .
      869               end.
      870             end.
      871             run diasize_position-resize-button in this-procedure .
      872           end.
      873           assign
      874             v-diasize-change-size = false
      875           .
      876           leave move_block .
      877         end.
      878       end.
      879       assign
      880         v-diasize-need-full-display = true
      881       .
      882       if v-diasize-change-size = false
      883       then do:
      884         assign
      885           v-diasize-change-size = true
      886         .
      887       end.
      888       else do:
      889         return .
      890       end.
      891       assign
      892         v-frame-width = frame Dialog-Frame :width
      893         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      894         v-browse-width = v-diasize-browse-handle :width
      895       .
      896       for each buf_temp-browse-handle
      897         where buf_temp-browse-handle.browse-type = 'width':u
      898       :
      899         assign
      900           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      901         .
      902       end.
      903       for each buf_temp-diasize-handle
      904       :
      905         delete buf_temp-diasize-handle .
      906       end.
      907       assign
      908         v-field-group-handle = frame Dialog-Frame :first-child
      909       .
      910       do while valid-handle(v-field-group-handle)
      911       :
      912         assign
      913           v-object-handle = v-field-group-handle :first-child
      914         .
      915         do while valid-handle(v-object-handle)
      916         :
      917           if  v-object-handle <> v-diasize-browse-handle :handle
      918           and v-object-handle <> v-diasize-resize-button
      919           and can-query(v-object-handle, "row")
      920           and can-query(v-object-handle, "height")
      921           and ( v-object-handle :col + v-object-handle :width
      922                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      923               )
      924           then do:
      925             find first buf_temp-browse-handle
      926               where buf_temp-browse-handle.browse-type   = 'width':u
      927                 and buf_temp-browse-handle.browse-handle = v-object-handle
      928               no-error .
      929             if available buf_temp-browse-handle
      930             then do:
      931             end.
      932             else do:
      933               create buf_temp-diasize-handle .
      934               assign
      935                 buf_temp-diasize-handle.handle-value  = v-object-handle
      936                 buf_temp-diasize-handle.save-position = v-object-handle :col
      937               .
      938             end.
      939           end.
      940           assign
      941             v-object-handle = v-object-handle :next-sibling
      942           .
      943         end.
      944         assign
      945           v-field-group-handle = v-field-group-handle :next-sibling
      946         .
      947       end.
      948       do with frame Dialog-Frame
      949       :
      950         hide v-diasize-resize-button .
      951         v-diasize-resize-button :row = 1.
      952         v-diasize-resize-button :column = 1.
      953       end.
      954       if p-change-value > 0
      955       then do:
      956         if frame Dialog-Frame :scrollable = true
      957         then do:
      958           assign
      959             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      960             no-error .
      961           if error-status :error
      962           or error-status :get-message(1) <> ""
      963           then do:
      964             undo move_block, retry move_block.
      965           end.
      966         end.
      967         assign
      968           frame Dialog-Frame :width = v-frame-width + p-change-value
      969           no-error .
      970         if error-status :error
      971         or error-status :get-message(1) <> ""
      972         then do:
      973           undo move_block, retry move_block.
      974         end.
      975         assign
      976           v-diasize-browse-handle :width = v-browse-width + p-change-value
      977         no-error .
      978         if error-status :error
      979         or error-status :get-message(1) <> ""
      980         then do:
      981           undo move_block, retry move_block.
      982         end.
      983         for each buf_temp-browse-handle
      984           where buf_temp-browse-handle.browse-type = 'width':u
      985         on error undo move_block, retry move_block
      986         :
      987           assign
      988             buf_temp-browse-handle.browse-handle :width
      989               = buf_temp-browse-handle.browse-handle :width + p-change-value
      990             no-error .
      991           if error-status :error
      992           or error-status :get-message(1) <> ""
      993           then do:
      994             undo move_block, retry move_block .
      995           end.
      996         end.
      997         for each buf_temp-diasize-handle
      998         on error undo move_block, retry move_block
      999         :
     1000           assign
     1001             v-object-handle = buf_temp-diasize-handle.handle-value
     1002           .
     1003           if v-object-handle <> v-diasize-resize-button
     1004           then do:
     1005             assign
     1006               v-object-handle :col = v-object-handle :col + p-change-value
     1007               no-error .
     1008             if error-status :error
     1009             or error-status :get-message(1) <> ""
     1010             then do:
     1011               undo move_block, retry move_block .
     1012             end.
     1013           end.
     1014         end.
     1015       end.
     1016       else do:
     1017         for each buf_temp-diasize-handle
     1018         on error undo move_block, retry move_block
     1019         :
     1020           assign
     1021             v-object-handle = buf_temp-diasize-handle.handle-value
     1022           .
     1023           if v-object-handle <> v-diasize-resize-button
     1024           then do:
     1025             assign
     1026               v-object-handle :col = v-object-handle :col + p-change-value
     1027               no-error .
     1028             if error-status :error
     1029             or error-status :get-message(1) <> ""
     1030             then do:
     1031               undo move_block, retry move_block .
     1032             end.
     1033           end.
     1034         end.
     1035         for each buf_temp-browse-handle
     1036           where buf_temp-browse-handle.browse-type = 'width':u
     1037         on error undo move_block, retry move_block
     1038         :
     1039           assign
     1040             buf_temp-browse-handle.browse-handle :width
     1041               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1042             no-error .
     1043           if error-status :error
     1044           or error-status :get-message(1) <> ""
     1045           then do:
     1046             undo move_block, retry move_block .
     1047           end.
     1048         end.
     1049         assign
     1050           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1051           no-error .
     1052         if error-status :error
     1053         or error-status :get-message(1) <> ""
     1054         then do:
     1055           undo move_block, retry move_block.
     1056         end.
     1057         assign
     1058           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1059         no-error .
     1060         if error-status :error
     1061         or error-status :get-message(1) <> ""
     1062         then do:
     1063           undo move_block, retry move_block.
     1064         end.
     1065         if frame Dialog-Frame :scrollable = true
     1066         then do:
     1067           assign
     1068             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1069           no-error .
     1070           if error-status :error
     1071           or error-status :get-message(1) <> ""
     1072           then do:
     1073             undo move_block, retry move_block.
     1074           end.
     1075         end.
     1076       end.
     1077       if p-move-resize
     1078       then do:
     1079         run diasize_position-resize-button in this-procedure .
     1080       end.
     1081       if v-diasize-wndstore = true
     1082       then do:
     1083         if connected("ub") = true
     1084         then do:
     1085           define variable v-cntxt-db-num        as integer   no-undo .
     1086           define variable v-cntxt-userid        as character no-undo .
     1087           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1088                                             , OUTPUT v-cntxt-userid
     1089                                             ) .
     1090           run gbl/wndsizew.p
     1091             (input  v-cntxt-db-num
     1092             ,input  v-cntxt-userid
     1093             ,input  v-diasize-proc-name
     1094             ,input  'width':u
     1095             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1096             ) .
     1097         end.
     1098       end.
     1099     end.
     1100     assign
     1101       v-diasize-change-size = false
     1102     .
     1103   end procedure.
     1104   procedure diasize_set-width :
     1105     define input  parameter p-new-width  as decimal   no-undo .
     1106     define input  parameter p-move-resize as logical   no-undo .
     1107     do
     1108     on error undo, return error return-value
     1109     :
     1110       run diasize_change-width in this-procedure
     1111         (input  (p-new-width - frame Dialog-Frame :width)
     1112         ,input  p-move-resize
     1113         ) .
     1114     end.
     1115   end procedure.
     1116   procedure diasize_position-resize-button :
     1117     do with frame Dialog-Frame
     1118     :
     1119       hide v-diasize-resize-button .
     1120       assign
     1121         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1122                     - 1
     1123                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1124         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1125                     - 1
     1126                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1127       .
     1128       view v-diasize-resize-button .
     1129     end.
     1130   end procedure.
     1131   on alt-right anywhere
     1132   do:
     1133     run diasize_change-width in this-procedure
     1134       (input 1
     1135       ,input true
     1136       ) .
     1137     return no-apply .
     1138   end.
     1139   on alt-left anywhere
     1140   do:
     1141     run diasize_change-width in this-procedure
     1142       (input -1
     1143       ,input true
     1144       ) .
     1145     return no-apply .
     1146   end.
     1147   on alt-down anywhere
     1148   do:
     1149     run diasize_change-height in this-procedure
     1150       (input 1
     1151       ,input true
     1152       ) .
     1153     return no-apply .
     1154   end.
     1155   on alt-up anywhere
     1156   do:
     1157     run diasize_change-height in this-procedure
     1158       (input -1
     1159       ,input true
     1160       ) .
     1161     return no-apply .
     1162   end.
     1163   on alt-enter of frame Dialog-Frame
     1164   do:
     1165     run diasize_maximize in this-procedure
     1166       (input  ?
     1167       ).
     1168     return no-apply .
     1169   end.
     1170   procedure diasize_end-move :
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174       define variable v-row-delta as decimal   no-undo .
     1175       define variable v-col-delta as decimal   no-undo .
     1176       define variable v-new-row as decimal   no-undo .
     1177       define variable v-new-col as decimal   no-undo .
     1178       assign
     1179         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1180         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1181       .
     1182       assign
     1183         v-row-delta = v-new-row - frame Dialog-Frame :height
     1184         v-col-delta = v-new-col - frame Dialog-Frame :width
     1185       .
     1186       run diasize_change-height in this-procedure
     1187         (input v-row-delta
     1188         ,input true
     1189         ) .
     1190       run diasize_change-width in this-procedure
     1191         (input v-col-delta
     1192         ,input true
     1193         ) .
     1194     end.
     1195   end procedure.
     1196   procedure diasize_maximize :
     1197     define input  parameter p-action as logical   no-undo .
     1198     do
     1199     on error undo, return error return-value
     1200     :
     1201       if p-action = ?
     1202       then do:
     1203         if v-diasize-need-maximize = true
     1204         then do:
     1205           assign
     1206             p-action = true
     1207           .
     1208         end.
     1209         else do:
     1210           assign
     1211             p-action = false
     1212           .
     1213         end.
     1214       end.
     1215       if p-action = true
     1216       then do:
     1217         run diasize_change-height in this-procedure
     1218           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1219               - frame Dialog-Frame :height-chars
     1220           ,input true
     1221           ) .
     1222         run diasize_change-width in this-procedure
     1223           (input session :width-chars
     1224               - frame Dialog-Frame :width-chars
     1225           ,input true
     1226           ) .
     1227         assign
     1228           v-diasize-need-maximize = false
     1229         .
     1230       end.
     1231       else do:
     1232         run diasize_change-width in this-procedure
     1233           (input v-diasize-orig-frame-width
     1234               - frame Dialog-Frame :width-chars
     1235           ,input true
     1236           ) .
     1237         run diasize_change-height in this-procedure
     1238           (input v-diasize-orig-frame-height
     1239               - frame Dialog-Frame :height-chars
     1240           ,input true
     1241           ) .
     1242         assign
     1243           v-diasize-need-maximize = true
     1244         .
     1245       end.
     1246     end.
     1247   end procedure.
     1248   procedure diasize_restore-orig-size :
     1249     do
     1250     on error undo, return error return-value
     1251     :
     1252       assign
     1253         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1254         v-diasize-current-frame-height = frame Dialog-Frame :height
     1255       .
     1256       run diasize_set-height in this-procedure
     1257         (input  v-diasize-orig-frame-height
     1258         ,input  true
     1259         ) .
     1260       run diasize_set-width in this-procedure
     1261         (input  v-diasize-orig-frame-width
     1262         ,input  true
     1263         ) .
     1264     end.
     1265   end procedure.
     1266   procedure diasize_restore-current-size :
     1267     do
     1268     on error undo, return error return-value
     1269     :
     1270       run diasize_set-height in this-procedure
     1271         (input  v-diasize-current-frame-height
     1272         ,input  true
     1273         ) .
     1274       run diasize_set-width in this-procedure
     1275         (input  v-diasize-current-frame-width
     1276         ,input  true
     1277         ) .
     1278     end.
     1279   end procedure.
     1280   procedure diasize_set-browse-handle :
     1281     define input  parameter p-browse-handle as handle   no-undo .
     1282     define buffer buf_temp-browse-handle for temp-browse-handle .
     1283     do
     1284     on error undo, return error return-value
     1285     :
     1286       assign
     1287         v-diasize-browse-handle = p-browse-handle
     1288       .
     1289       for each buf_temp-browse-handle
     1290       on error undo, return error return-value
     1291       :
     1292         delete buf_temp-browse-handle .
     1293       end.
     1294     end.
     1295   end procedure.
     1296   procedure diasize_add_browse :
     1297     define input  parameter p-browse-type   as character no-undo .
     1298     define input  parameter p-browse-handle as handle    no-undo .
     1299     define buffer buf_temp-browse-handle for temp-browse-handle .
     1300     do
     1301     on error undo, return error return-value
     1302     :
     1303       assign
     1304         v-diasize-browse-number = v-diasize-browse-number + 1
     1305       .
     1306       create buf_temp-browse-handle .
     1307       assign
     1308         buf_temp-browse-handle.browse-type   = p-browse-type
     1309         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1310         buf_temp-browse-handle.browse-handle = p-browse-handle
     1311       .
     1312     end.
     1313   end procedure.
     1314   procedure diasize_init :
     1315     define variable v-default-value    as logical   no-undo .
     1316     define variable v-restore-saved    as logical   no-undo .
     1317     define variable v-resize-value-str as character no-undo .
     1318     do
     1319     on error undo, return error return-value
     1320     :
     1321       do with frame Dialog-Frame
     1322       :
     1323         assign
     1324           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1325           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1326           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1327         .
     1328         create button v-diasize-resize-button
     1329         assign
     1330           parent        = frame Dialog-Frame :first-child
     1331           label         = "s"
     1332           height-pixels = 16
     1333           width-pixels  = 16
     1334           visible       = true
     1335           sensitive     = true
     1336           movable       = true
     1337           triggers:
     1338             on end-move persistent run diasize_end-move in this-procedure .
     1339           end triggers.
     1340         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1341         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1342         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1343         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1344         assign
     1345           v-diasize-wndmax = false
     1346         .
     1347         if connected("ub") = true
     1348         then do:
     1349           define variable v-cntxt-db-num        as integer   no-undo .
     1350           define variable v-cntxt-userid        as character no-undo .
     1351           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1352                                             , OUTPUT v-cntxt-userid
     1353                                             ) .
     1354           run gbl/wndpar_r.p
     1355             (input  v-cntxt-db-num
     1356             ,input  v-cntxt-userid
     1357             ,input  'wndmax':U
     1358             ,output v-diasize-wndmax
     1359             ,output v-default-value
     1360             ) .
     1361         end.
     1362         assign
     1363           v-diasize-wndstore = false
     1364         .
     1365         if connected("ub") = true
     1366         then do:
     1367           run gbl/wndpar_r.p
     1368             (input  v-cntxt-db-num
     1369             ,input  v-cntxt-userid
     1370             ,input  'wndstore':U
     1371             ,output v-diasize-wndstore
     1372             ,output v-default-value
     1373             ) .
     1374         end.
     1375         assign
     1376           v-diasize-proc-name = entry(1, program-name(2), '.')
     1377         .
     1378         if v-diasize-wndstore = true
     1379         then do:
     1380           assign
     1381             v-restore-saved = false
     1382           .
     1383           if connected("ub") = true
     1384           then do:
     1385             run gbl/wndsizer.p
     1386               (input  v-cntxt-db-num
     1387               ,input  v-cntxt-userid
     1388               ,input  v-diasize-proc-name
     1389               ,input  'height':u
     1390               ,output v-resize-value-str
     1391               ) .
     1392             if v-resize-value-str <> '':U
     1393             then do:
     1394               run diasize_change-height in this-procedure
     1395                 (input  integer(v-resize-value-str)
     1396                 ,input  true
     1397                 ) .
     1398               assign
     1399                 v-restore-saved = true
     1400               .
     1401             end.
     1402           end.
     1403           if connected("ub") = true
     1404           then do:
     1405             run gbl/wndsizer.p
     1406               (input  v-cntxt-db-num
     1407               ,input  v-cntxt-userid
     1408               ,input  v-diasize-proc-name
     1409               ,input  'width':u
     1410               ,output v-resize-value-str
     1411               ) .
     1412             if v-resize-value-str <> '':U
     1413             then do:
     1414               run diasize_change-width in this-procedure
     1415                 (input  integer(v-resize-value-str)
     1416                 ,input  true
     1417                 ) .
     1418               assign
     1419                 v-restore-saved = true
     1420               .
     1421             end.
     1422           end.
     1423           if v-restore-saved <> true
     1424           then do:
     1425             if v-diasize-wndmax = true
     1426             then do:
     1427               run diasize_maximize in this-procedure
     1428                 (input  true
     1429                 ) .
     1430             end.
     1431           end.
     1432         end.
     1433         else do:
     1434           if v-diasize-wndmax = true
     1435           then do:
     1436             run diasize_maximize in this-procedure
     1437               (input  true
     1438               ) .
     1439           end.
     1440         end.
     1441       end.
     1442     end.
     1443   end procedure.
     1444   procedure diasize_need-full-display :
     1445     define output parameter p-need-full-display as logical   no-undo .
     1446     do
     1447     on error undo, return error return-value
     1448     :
     1449       assign
     1450         p-need-full-display = v-diasize-need-full-display
     1451       .
     1452       assign
     1453         v-diasize-need-full-display = false
     1454       .
     1455     end.
     1456   end procedure.
     1457   procedure get-context :
     1458      define output parameter p-db-num as integer          no-undo.
     1459      define output parameter p-user-id as character        no-undo.
     1460      define variable v-login               as character    no-undo.
     1461      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1462      define buffer buf_user-login  for ub.user-login .
     1463      do
     1464      on error undo, return error
     1465      :
     1466            FIND FIRST buf_sys-ctrl no-lock.
     1467            ASSIGN
     1468               v-login = USERID("ub")
     1469               p-db-num = buf_sys-ctrl.db-num
     1470            .
     1471            FIND FIRST buf_user-login
     1472                 WHERE buf_user-login.db-num = p-db-num
     1473                   AND buf_user-login.user-login = v-login
     1474                 no-lock
     1475                 no-error
     1476                 .
     1477            IF AVAILABLE buf_user-login
     1478            THEN DO:
     1479               assign
     1480                  p-user-id = buf_user-login.user-id
     1481               .
     1482            END.
     1483      end.
     1484   end procedure.
     1485       run diasize_init in this-procedure .
     1486   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1487   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1488   MAIN-BLOCK:
     1489   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1490      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1491     x-blank-name = ?.
     1492     run enable_ui in this-procedure .
     1493     WAIT-FOR GO OF FRAME Dialog-Frame.
     1494   END.
     1495   run disable_ui in this-procedure .
     1496   PROCEDURE disable_UI :
     1497     HIDE FRAME Dialog-Frame.
     1498   END PROCEDURE.
     1499   PROCEDURE enable_UI :
     1500     ENABLE B-exit B-sel B-ins B-chg B-del B-Help BROWSE-1
     1501         WITH FRAME Dialog-Frame.
     1502     VIEW FRAME Dialog-Frame.
     1503     OPEN QUERY BROWSE-1 FOR EACH ub.ord-blank       WHERE ub.ord-blank.cli-code = x-cli-code AND ub.ord-blank.cli-type = x-cli-type NO-LOCK INDEXED-REPOSITION.
     1504   END PROCEDURE.
