        1   block-level on error undo, throw.
        2   define input parameter  parParentProc  as widget-handle no-undo.
        3   define input parameter  p-rec          as recid no-undo .
        4   define input parameter  store-type     as character no-undo .
        5   define input parameter  store-code     as integer   no-undo .
        6   define input parameter  p-db-num       as integer   no-undo .
        7   define input parameter  p-ask          as logical   no-undo .
        8   define input parameter  p-param-list   as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: e470dcf1e011, 295, rls $":u .
       10   define variable vss-author      as character no-undo init "$Author: SSlivenko $":u .
       11   define variable vss-date        as character no-undo init "$Date: Tue Dec 01 19:11:38 2015 +0300 $":u .
       12   define variable vss-workfile    as character no-undo init "$Workfile: ord-clos.p $":u .
       13   define variable vss-archive     as character no-undo init "$Archive: cus/ord-clos.p $":u .
       14   define variable vss-description as character no-undo init  "Переход по графу статусов" .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define new global shared variable g#lib-trn  as handle no-undo .
       85   define new global shared variable g#lib-trn2 as handle no-undo .
       86   define new global shared variable g#lib-trn3 as handle no-undo .
       87   define new global shared variable g#lib-trn4 as handle no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define variable to-day       as date no-undo .
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       92   define  shared variable RepPathName        as character no-undo .
       93   define  shared variable PrintRubl          as logical   no-undo .
       94   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   procedure cur-time :
       96      define output parameter p-today as date      no-undo .
       97      define output parameter p-time  as integer   no-undo .
       98     do
       99     on error undo, return error
      100     :
      101       define variable v-date1 as date      no-undo .
      102       define variable v-date2 as date      no-undo .
      103       define variable v-time  as integer   no-undo .
      104       assign
      105         v-date1 = today
      106         v-time  = time
      107         v-date2 = today
      108       .
      109       if v-date1 <> v-date2
      110       then do:
      111         assign
      112           v-date1 = today
      113           v-time  = v-time
      114         .
      115       end.
      116       assign
      117         p-today = v-date1
      118         p-time  = v-time
      119       .
      120     end.
      121   end.
      122   function cur-time-date returns character
      123   :
      124     return string(today, '99/99/9999':U) .
      125   end.
      126   function cur-time-mjd returns decimal
      127   :
      128     define variable v-date as date      no-undo .
      129     define variable v-time as integer   no-undo .
      130     run cur-time in this-procedure
      131       (output v-date
      132       ,output v-time
      133       ) .
      134     return integer(v-date) - 2400002 + (v-time / 86400) .
      135   end.
      136   function cur-time-get-ending-index returns integer
      137   (input p-number as integer
      138   )
      139   :
      140     if p-number < 0
      141     or p-number = ?
      142     then do:
      143       return 1 .
      144     end.
      145     define variable v-rest as integer   no-undo .
      146     assign
      147       p-number = p-number modulo 100
      148     .
      149     if p-number < 20
      150     then do:
      151       assign
      152         v-rest = p-number
      153       .
      154     end.
      155     else do:
      156       assign
      157         v-rest = p-number modulo 10
      158       .
      159     end.
      160     case v-rest :
      161       when 1
      162       then do:
      163         return 2 .
      164       end.
      165       when 2 or
      166       when 3 or
      167       when 4
      168       then do:
      169         return 3 .
      170       end.
      171       otherwise do:
      172         return 1 .
      173       end.
      174     end case .
      175   end.
      176   procedure cur-time-mjd-to-date :
      177      define input  parameter i-mjd-diff as decimal no-undo.
      178      define output parameter o-Date     as date    no-undo.
      179      define output parameter o-Time     as integer no-undo.
      180      define variable v-day-number as integer   no-undo .
      181      if    i-mjd-diff < 0
      182         or i-mjd-diff = ?
      183      then do:
      184         return "?" .
      185      end.
      186      assign
      187         v-day-number = truncate(i-mjd-diff,0).
      188         o-Date = date(v-day-number + 2400002).
      189         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      190     .
      191   end.
      192   function cur-time-mjd-to-string returns character
      193   (input p-mjd-diff as decimal
      194   )
      195   :
      196     define variable v-day-number as integer   no-undo .
      197     define variable v-seconds    as integer   no-undo .
      198     define variable v-hour       as integer   no-undo .
      199     define variable v-min        as integer   no-undo .
      200     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      201     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      202     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      203     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      204     if p-mjd-diff < 0
      205     or p-mjd-diff = ?
      206     then do:
      207       return "?" .
      208     end.
      209     assign
      210       v-day-number = integer(truncate(p-mjd-diff,0))
      211       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      212     .
      213     if v-seconds > 86400
      214     then do:
      215       assign
      216         v-seconds = 86400 - 1
      217       .
      218     end.
      219     if v-seconds < 0
      220     then do:
      221       assign
      222         v-seconds = 0
      223       .
      224     end.
      225     assign
      226       v-hour = truncate(v-seconds / 3600, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 3600
      230     .
      231     assign
      232       v-min = truncate(v-seconds / 60, 0)
      233     .
      234     assign
      235       v-seconds = v-seconds modulo 60
      236     .
      237     return
      238         (if v-day-number <> 0
      239           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0
      243           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      244           else ""
      245         )
      246       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      247           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      248           else ""
      249         )
      250       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      251       .
      252   end.
      253   function cur-time-string returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      262   end.
      263   function cur-time-string-sec returns character
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      272   end.
      273   function cur-time-custom  returns character
      274   (input p-prefix as character
      275   ,input p-date-format as character
      276   ,input p-delimiter as character
      277   ,input p-time-format as character
      278   ,input p-suffix as character
      279   )
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return
      288       p-prefix
      289       + string(v-date, p-date-format)
      290       + p-delimiter
      291       + string(v-time, p-time-format)
      292       + p-suffix
      293       .
      294   end.
      295   function cur-time-print  returns character
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      304   end.
      305   function cur-time-datetime returns datetime
      306   :
      307     define variable v-char as character no-undo .
      308     define variable v-datetime as datetime no-undo .
      309     v-char = cur-time-string().
      310     v-datetime = datetime(v-char).
      311     return  v-datetime.
      312   end.
      313   function cur-time-string-msec returns character
      314   :
      315     define variable v-date as datetime  no-undo .
      316     v-date = now.
      317     return string(v-date) .
      318   end.
      319   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   define variable v-waitfram-action01         as character   no-undo .
      321   define variable v-waitfram-action02         as character   no-undo .
      322   define variable v-waitfram-action03         as character   no-undo .
      323   define variable mWaitFramTextBeg            as character   no-undo.
      324   define variable mWaitFramTextEnd            as character   no-undo.
      325   define variable mWaitFramView               as logical     no-undo.
      326   define variable mWaitProcEvent              as logical     no-undo init yes.
      327   define variable mWaitFramInterval           as integer     no-undo init 1 .
      328   define variable mWaitFramStop               as logical     no-undo.
      329   define variable mWaitFramStopUser           as logical     no-undo.
      330   define variable mWaitFramStopTimeOut        as logical     no-undo.
      331   define variable mWaitFramStartProc          as datetime-tz no-undo.
      332   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      333   define button B-WaitFramStop auto-end-key
      334        label "Стоп"
      335        size 10 by 1 tooltip "Остоновить процесс".
      336   define button B-viewProcInfo
      337        label "Информация"
      338        size 15 by 1 tooltip "Информация о процесс".
      339   define frame waitfram
      340     v-waitfram-action01 format "x(72)" no-label skip
      341     v-waitfram-action02 format "x(72)" no-label skip
      342     v-waitfram-action03 format "x(72)" no-label skip
      343     B-viewProcInfo
      344     B-WaitFramStop at row 4 col 30
      345     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      346     .
      347   define new global shared variable mBatchMode as logical no-undo init ?.
      348   define variable mFramBachModHandle as handle no-undo.
      349   mFramBachModHandle = frame waitfram:handle.
      350   define variable mFameOldVis as logical no-undo.
      351   define variable mVisCUrentVin as logical no-undo.
      352   if session:batch-mode
      353   then
      354      mBatchMode = yes.
      355   if mBatchMode = ? then do:
      356     mVisCUrentVin = current-window:visible.
      357     mFameOldVis = mFramBachModHandle:visible.
      358     mFramBachModHandle:visible  = yes.
      359     mBatchMode = mFramBachModHandle:visible ne yes.
      360     mFramBachModHandle:visible = mFameOldVis.
      361     current-window:visible = mVisCUrentVin.
      362   end.
      363    if  log-manager:logfile-name ne ?
      364     then DO:
      365         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      366         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      367         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      368     end.
      369   on choose of B-WaitFramStop in frame waitfram
      370   do:
      371     mWaitFramStop = yes.
      372     mWaitFramStopUser = yes.
      373   end.
      374   function waitfram-check-timeout returns logical():
      375      define variable vtime as int64 no-undo.
      376      if mWaitFramStopTimeOut
      377      then
      378         return yes.
      379      vtime = ( now - mWaitFramStartProc ) / 1000 .
      380      if     mWaitFramTimeOut ne ?
      381         and mWaitFramTimeOut ne 0
      382         and mWaitFramTimeOut lt vtime
      383      then do:
      384         mWaitFramStopTimeOut = yes.
      385      end.
      386      return mWaitFramStopTimeOut.
      387   end.
      388   procedure waitfram-hide :
      389     if not session:batch-mode
      390     then do
      391     on error undo, return error return-value
      392     :
      393       pause 0 before-hide .
      394       if not mBatchMode then
      395         hide frame waitfram .
      396     if     not mWaitFramView
      397        and mWaitProcEvent
      398     then
      399       process events .
      400     end.
      401   end procedure.
      402   procedure waitfram-show :
      403     define input  parameter p-message as character no-undo .
      404     define variable v-left-margin as integer   no-undo .
      405     if not session:batch-mode
      406     then do
      407     on error undo, return error return-value
      408     :
      409       if length(p-message) <= 70 then do:
      410         assign
      411           v-left-margin = integer((70 - length(p-message)) / 2)
      412         .
      413         assign
      414           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      415         .
      416         assign
      417           v-waitfram-action01 = " "
      418           v-waitfram-action02 = " "
      419                                    + fill(" ", v-left-margin)
      420                                    + p-message
      421           v-waitfram-action03 = " "
      422         .
      423       end.
      424       else do:
      425         define variable vRindex1 as integer no-undo.
      426         define variable vRindex2 as integer no-undo.
      427         vRindex1 = r-index(p-message," ",70).
      428         if vRindex1 = 0
      429         then
      430            vRindex1 = 70.
      431         if length(p-message)  <= vRindex1 + 70 then do:
      432           assign
      433             v-waitfram-action01 = " "
      434             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      435             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      436           .
      437         end.
      438         else do:
      439           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      440           if vRindex2 <= vRindex1
      441           then
      442              vRindex2 = vRindex1 + 70.
      443           assign
      444             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      445             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      446             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      447           .
      448         end.
      449       end.
      450       B-viewProcInfo:visible   in frame waitfram = no.
      451       B-viewProcInfo:sensitive in frame waitfram = no.
      452       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      453       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      454       if  (   mWaitFramView
      455          or  mWaitProcEvent)
      456          and not mBatchMode
      457       then
      458          display
      459             v-waitfram-action01 skip
      460             v-waitfram-action02 skip
      461             v-waitfram-action03 skip
      462          with frame waitfram .
      463       if     mWaitFramView
      464          then do:
      465             if     mWaitFramInterval ne ?
      466                and not mBatchMode
      467             then
      468                wait-for go of frame waitfram pause mWaitFramInterval.
      469          end.
      470          else
      471             if     mWaitProcEvent
      472                and not mBatchMode
      473             then
      474                process events .
      475     end.
      476   end procedure.
      477      procedure waitfram-show-this:
      478         define input  parameter iInterval as int64 no-undo.
      479         define variable vtime as int64 no-undo.
      480         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      481         mWaitFramInterval = iInterval.
      482         run waitfram-show (substitute("&1&2 &3&4" ,
      483                                       mWaitFramTextBeg ,
      484                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      485                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      486                                       mWaitFramTextEnd
      487                                      )
      488                           ).
      489      end.
      490      procedure WaitFramRunPause:
      491         define input  parameter iInterval as dec no-undo.
      492         define variable vStart  as datetime-tz no-undo.
      493         define variable vend    as datetime-tz no-undo.
      494         define variable vint as int64 no-undo.
      495         define variable vOk as logical no-undo.
      496         vStart = now.
      497         vend   = vStart.
      498         publish "WaitFramPause" (iInterval,output vOk).
      499         vend   =  now.
      500         vint = vend - vStart.
      501         vint = iInterval - vint / 1000.
      502         if     not mWaitFramStop
      503            and (   vint > 0
      504                 or (    not vOk
      505                     and iInterval eq ?
      506                     )
      507                 )
      508         then
      509            run waitfram-show-this (iInterval).
      510         vend   =  now.
      511         vint = vend - vStart.
      512         vint = iInterval - vint / 1000.
      513         if     not mWaitFramStop
      514            and vint > 0
      515         then do:
      516            run gbl/pause.p (vint * 1000).
      517         end.
      518         if iInterval ne ?
      519         then
      520            publish "WaitFramStop".
      521         waitfram-check-timeout().
      522      end.
      523      procedure WaitFramWaitFor:
      524         define input  parameter iInterval as dec no-undo.
      525         assign
      526            mWaitFramStartProc   = now
      527            mWaitFramStopUser    = no
      528            mWaitFramStopTimeOut = no
      529         .
      530         block-wait:
      531         do while not mWaitFramStop:
      532            run WaitFramRunPause (iInterval).
      533            if  waitfram-check-timeout()
      534            then do:
      535               leave block-wait.
      536            end.
      537         end.
      538         run waitfram-hide.
      539      end.
      540   procedure waitfram-join :
      541     define input  parameter p-line-1  as character no-undo .
      542     define input  parameter p-line-2  as character no-undo .
      543     define input  parameter p-line-3  as character no-undo .
      544     define output parameter p-message as character no-undo .
      545     do
      546     on error undo, return error return-value
      547     :
      548       assign
      549         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      550                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      551                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      552       .
      553     end.
      554   end procedure.
      555   function waitfram-join-function returns character
      556     (input p-line-1 as character
      557     ,input p-line-2 as character
      558     ,input p-line-3 as character
      559     ).
      560     define variable v-message as character no-undo .
      561     run waitfram-join in this-procedure
      562       (input  p-line-1
      563       ,input  p-line-2
      564       ,input  p-line-3
      565       ,output v-message
      566       ) .
      567     return v-message .
      568   end function .
      569   procedure proc-alt-shift-f2:
      570     if not ibs.th.gbl.gbl-var:rcode
      571   then
      572     run gbl\inidebug.p .
      573   end.
      574   procedure proc-alt-shift-f3:
      575     run gbl/prvssinf.p
      576       ( input this-procedure
      577       ) .
      578   end.
      579   define variable v-inform-launched as logical no-undo initial false .
      580   procedure proc-alt-shift-f4:
      581     define variable v-action as character no-undo .
      582     if v-inform-launched = false then do:
      583       assign
      584         v-inform-launched = true
      585       .
      586       run gbl/d-inform.w
      587         (  input self
      588         ,  input this-procedure
      589         , output v-action
      590         ) no-error .
      591       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      592       assign
      593         v-inform-launched = false
      594       .
      595     end.
      596   end.
      597   procedure proc-alt-f1:
