      662   procedure thbjattr_code_reg :
      663   define input  parameter p-upper-code     as character no-undo .
      664   define input  parameter p-code           as character no-undo .
      665   define output parameter p-label          as character no-undo .
      666   define output parameter p-user-can-edit  as logical   no-undo .
      667   define output parameter p-output-display as logical   no-undo .
      668   define output parameter p-other          as character no-undo .
      669   define output parameter p-prop-list      as character no-undo .
      670   define output parameter p-prop-type-list as character no-undo .
      671   define output parameter p-prop-label-list as character no-undo .
      672   define output parameter p-global          as logical no-undo .
      673   define output parameter p-host           as logical no-undo .
      674   define output parameter p-shop           as logical no-undo .
      675   define output parameter p-store          as logical no-undo .
      676   define output parameter p-db             as logical no-undo .
      677   define output parameter p-region         as logical no-undo .
      678   do
      679   on error undo, return error return-value
      680   :
      681       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      682       (input  p-upper-code
      683       ,input  p-code
      684       ,output p-label
      685       ,output p-user-can-edit
      686       ,output p-output-display
      687       ,output p-other
      688       ,output p-prop-list
      689       ,output p-prop-type-list
      690       ,output p-prop-label-list
      691       ,output p-global
      692       ,output p-host
      693       ,output p-shop
      694       ,output p-store
      695       ,output p-db
      696       ,output p-region
      697       ) no-error .
      698     if error-status :error
      699     then do:
      700       undo, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1)).
      701     end.
      702   end.
      703   end procedure.
