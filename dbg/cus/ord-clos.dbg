     2988                 sum-rcv = sum-rcv + t-doc-line-rcv.qnty.
     2989               end.
     2990               sum-ord = sum-ord + t-doc-line.qnty.
     2991               if t-doc-line.qnty > sum-trn1 then v-tt-qnty = true .
     2992               sum-trn1 = 0 .
     2993           end.
     2994               if  sum-trn = 0  then do:
     2995                   if p-ask then  do:
     2996                   message  (if shar-buf_ord-doc.doc-type  =  'ОФ':U then " Заявка " else " Заказ" ) shar-buf_ord-doc.doc-code " не имеет ПН (или полностью ей не соответствует) ! Закрыть в статус (ФАКТ-) ? "
     2997                     view-as alert-box question
     2998                     buttons yes-no
     2999                     title "Закрыть "  + (if shar-buf_ord-doc.doc-type  =  'ОФ':U then " заявку " else "заказ" )
     3000                     update g#log
     3001                   .
     3002                   end.
     3003                   else g#log = false .
     3004                   if not g#log then return error substitute( " Документ &1 , не имеет ПН (или полностью ей не соответствует)!  ", shar-buf_ord-doc.doc-code  ) .
     3005                   shar-buf_ord-doc.flag_ = false .
     3006               end.
     3007               if  sum-ord > sum-trn then do:
     3008                   if p-ask then  do:
     3009                       message  (if shar-buf_ord-doc.doc-type  =  'ОФ':U then " Заявка " else " Заказ" ) shar-buf_ord-doc.doc-code
     3010                        " не покрыт ПН полностью ! Закрыть в статус (ФАКТ-) ? " skip
     3011                         "по заказу =" sum-ord skip
     3012                         "по накладным ="sum-trn
     3013                         view-as alert-box question
     3014                         buttons yes-no
     3015                         title "Закрыть "  + (if shar-buf_ord-doc.doc-type  =  'ОФ':U then " заявку " else "заказ" )
     3016                         update g#log
     3017                       .
     3018                   end.
     3019                   else do:
     3020                         run ver-qnty-rcv-from-ord (input shar-buf_ord-doc.doc-code , output v-is-limit ) .
     3021                         if v-is-limit then do:
     3022                           g#log = true .
     3023                         end.
     3024                         else do:
     3025                           g#log = false .
     3026                         end.
     3027                   end.
     3028                   if not g#log then  return error substitute( " Документ &1 , не покрыт ПН полностью !  ", shar-buf_ord-doc.doc-code  ) .
     3029                   shar-buf_ord-doc.flag_ = false .
     3030               end.
     3031               if  sum-ord =  sum-trn then do:
     3032                   shar-buf_ord-doc.flag_ = true  .
     3033                   if v-tt-qnty = true then shar-buf_ord-doc.flag_ = false .
     3034               end.
     3035               if  sum-ord <  sum-trn then do:
     3036                   if p-ask then  do:
     3037                     message "На "  (if shar-buf_ord-doc.doc-type  =  'ОФ':U then " Заявка " else " Заказ" ) shar-buf_ord-doc.doc-code
     3038                     ( if v-tt-qnty = true
     3039                       then "Несоответствие количеств по ПН ! Закрыть в статус (ФАКТ-) ? "
     3040                       else "Превышено количество по ПН ! Закрыть в статус (ФАКТ+) ? "
     3041                      )
     3042                      skip
     3043                      "по заказу =" sum-ord skip
     3044                      "по накладным =" sum-trn
     3045                       view-as alert-box question
     3046                       buttons yes-no
     3047                       title "Закрыть "  + (if shar-buf_ord-doc.doc-type  =  'ОФ':U then " заявку " else "заказ" )
     3048                       update g#log
     3049                     .
     3050                   end.
     3051                   else do:
     3052                         run ver-qnty-rcv-from-ord (input shar-buf_ord-doc.doc-code , output v-is-limit ) .
     3053                         if v-is-limit then do:
     3054                           g#log = true .
     3055                         end.
     3056                         else do:
     3057                           g#log = false .
     3058                         end.
     3059                   end.
     3060                   if not g#log then return error substitute( " Документ &1 , превышено количество по ПН !  ", shar-buf_ord-doc.doc-code  ) .
     3061                   shar-buf_ord-doc.flag_ = true  .
     3062                   if v-tt-qnty = true then shar-buf_ord-doc.flag_ = false .
     3063               end.
     3064               if shar-buf_ord-doc.contract-code <> 0 then do:
     3065                   find first buf_contract no-lock where
     3066                              buf_contract.host-code = shar-buf_ord-doc.host-code and
     3067                              buf_contract.contract-code = shar-buf_ord-doc.contract-code no-error .
     3068                    if available buf_contract and
     3069                        ( buf_contract.usl-opl = 'По заказу':U
     3070                        or buf_contract.usl-opl = 'Отсрочка платежа по заказу':U) then do:
     3071                       shar-buf_ord-doc.need-fo = 1 .
     3072                       shar-buf_ord-doc.cr-fo = no .
     3073                    end.
     3074               end.
     3075               for each t-ord-doc-rcv exclusive-lock where
     3076                        t-ord-doc-rcv.doc-code = shar-buf_ord-doc.doc-code and
     3077                        t-ord-doc-rcv.status_  <> 'факт':U
     3078                        :
     3079                 assign
     3080                     t-ord-doc-rcv.status_ = 'факт':U
     3081                     t-ord-doc-rcv.flag_   = false
     3082                     .
     3083               end.
     3084               assign
     3085                 shar-buf_ord-doc.status_   = 'факт':U
     3086                 shar-buf_ord-doc.fact-date = to-day
     3087                .
     3088                run str/callnews.p     (input 'ord-doc':U      ,input (buffer shar-buf_ord-doc:handle)     ) no-error .        if error-status:error then do:     assign shar-buf_ord-doc.flag_ = old-flag  shar-buf_ord-doc.status_ = old-state .     return error substitute( " Документ &1 , Ошибка (факт) при передаче в новости &2 &3 &4 &5 &6", shar-buf_ord-doc.doc-code ,vss-workfile, vss-revision, vss-description, return-value , error-status:get-message(1)  ) .   end.
     3089         end.
     3090    end case.
     3091   procedure verif_1 :
     3092   do
     3093   on error undo, return error return-value
     3094   :
     3095   define output parameter v-ret as logical no-undo .
     3096    v-ret = true .
     3097   define buffer later-ord-doc  for  ub.ord-doc  .
     3098   define buffer later-ord-line for  ub.ord-line .
     3099   define buffer today-ord-line for  ub.ord-line .
     3100   define variable v-qnty as decimal no-undo .
     3101   define variable v-exis as logical no-undo .
     3102   define variable v-txt as character no-undo .
     3103    output stream errStream to value( v-file-name )  .
     3104   v-exis = false .
     3105   for each  temp-obj-list :
     3106     delete temp-obj-list .
     3107   end.
     3108   define variable str-pos as integer no-undo .
     3109   define variable str-pos2 as integer no-undo .
     3110   define variable str-1 as character no-undo .
     3111   define variable i  as integer no-undo .
     3112   define variable e1 as character no-undo .
     3113   define variable e2 as integer no-undo .
     3114   define variable k1 as integer no-undo .
     3115   define variable v-nn as integer   no-undo .
     3116   if shar-buf_ord-doc.doc-type = 'ФП':U then do:
     3117       k1 = 0 .
     3118       str-pos = index (  shar-buf_ord-doc.e-method , "&" ) .
     3119       str-pos2 = length ( shar-buf_ord-doc.e-method ) - str-pos .
     3120       str-1 = substring (shar-buf_ord-doc.e-method , str-pos + 1 , str-pos2 ).
     3121       v-nn = num-entries (str-1) .
     3122       do i = 1 to v-nn :
     3123           assign
     3124             e1 = entry(1, (entry( i , str-1, "," )) , " ")
     3125             e2 = integer(entry(2, (entry( i , str-1, "," )), " " ))
     3126             no-error .
     3127             if error-status :error then next.
     3128             k1 = k1 + 1.
     3129             create temp-obj-list.
     3130             assign
     3131               temp-obj-list.obj-type = e1
     3132               temp-obj-list.obj-code = e2
     3133             .
     3134       end .
     3135       if k1 < 1 then do :
     3136          run sss in this-procedure .
     3137       end.
     3138   end.
     3139   else do:
     3140      create temp-obj-list.
     3141      assign
     3142        temp-obj-list.obj-type = shar-buf_ord-doc.obj-type
     3143        temp-obj-list.obj-code = shar-buf_ord-doc.obj-code
     3144      .
     3145   end.
     3146   for each today-ord-line where today-ord-line.doc-code = shar-buf_ord-doc.doc-code and today-ord-line.qnty > 0 no-lock :
     3147         v-qnty = 0.
     3148         v-txt  = "" .
     3149           for each later-ord-line where
     3150                                   later-ord-line.artic     = today-ord-line.artic     and
     3151                                   later-ord-line.prod-type = today-ord-line.prod-type and
     3152                                   later-ord-line.prod-code = today-ord-line.prod-code no-lock ,
     3153               each  later-ord-doc where  later-ord-line.doc-code = later-ord-doc.doc-code and
     3154                                 ( later-ord-doc.status_ = 'согласование':U or
     3155                                   later-ord-doc.status_ = 'поставка':U or
     3156                                   later-ord-doc.status_ = 'закрыто':U
     3157                                   ) and
     3158                                   later-ord-doc.doc-code <> today-ord-line.doc-code and
     3159                                   ( if shar-buf_ord-doc.cons-code <> "" then
     3160                                      later-ord-doc.cons-code <> shar-buf_ord-doc.cons-code
     3161                                      else
     3162                                      true = true )
     3163                                    and
     3164                                   later-ord-doc.date-sale-1 <= shar-buf_ord-doc.date-sale-2  and
     3165                                   later-ord-doc.date-sale-2 >= shar-buf_ord-doc.date-sale-1   and
     3166                                   later-ord-doc.host-code = shar-buf_ord-doc.host-code   no-lock ,
     3167                each temp-obj-list where temp-obj-list.obj-code = later-ord-doc.obj-code and
     3168                                         temp-obj-list.obj-type = later-ord-doc.obj-type no-lock :
     3169             v-qnty = v-qnty +  later-ord-line.qnty .
     3170             v-txt  = v-txt  +  trim(later-ord-line.doc-code) + ";" .
     3171           end.
     3172           if v-qnty > 0 then do:
     3173             find first ub.goods where
     3174                   today-ord-line.artic     = ub.goods.artic      and
     3175                   today-ord-line.prod-type = ub.goods.prod-type  and
     3176                   today-ord-line.prod-code = ub.goods.prod-code  no-lock no-error.
     3177             Put  stream  errStream unformatted
     3178             "По объекту :"  shar-buf_ord-doc.obj-type shar-buf_ord-doc.obj-code  skip
     3179             "По товару :"  today-ord-line.artic       today-ord-line.prod-type       today-ord-line.prod-code skip
     3180             ub.goods.gds-name skip
     3181             "По документам :"    v-txt skip
     3182             "Уже заказано (в пути) :" v-qnty    " "    ub.goods.unit-base   skip
     3183             skip
     3184             "По текущему документу № " shar-buf_ord-doc.doc-code  " кол-во заказа : " today-ord-line.qnty " " ub.goods.unit-base skip
     3185             "Анализируемый период продаж с " shar-buf_ord-doc.date-sale-1 " по " shar-buf_ord-doc.date-sale-2 skip
     3186             "Итого :"  ( v-qnty  + today-ord-line.qnty )   skip
     3187             "--------------------------------------------------------------------"
     3188             skip.
     3189             v-exis = true.
     3190           end.
     3191   end.
     3192   if v-exis = true then do:
     3193       define variable v-user-action   as character no-undo .
     3194       define variable v-printed       as logical no-undo .
     3195       if p-ask then  do:
     3196         message
     3197          "При проверке товаров по периоду продаж были обнаружены повторы ! " skip
     3198          "Вы можете просмотреть и распечатать их список . "
     3199          skip "Документ" shar-buf_ord-doc.doc-code
     3200          view-as alert-box error .
     3201       end.
     3202      Output stream errStream   close .
     3203     if p-ask then do:
     3204       run gbl/prnfilen.w
     3205         (input  "Повторы, обнаруженные при проверке товаров по периоду продаж"
     3206         ,input  0
     3207         ,input  v-file-name
     3208         ,input  7
     3209         ,output v-user-action
     3210         ,output v-printed
     3211         ) .
     3212          if not ( lookup( ' экран':L, v-user-action ,";")  > 0 or
     3213                   lookup( ' принтер':L, v-user-action ,";")  > 0  ) then do:
     3214           message "Внимание! Вы не просмотрели список повторных заказов ! "  .
     3215          end.
     3216     end.
     3217         v-ret = false .
     3218         return.
     3219   end.
     3220   v-ret = true .
     3221   return.
     3222   end.
     3223   end procedure.
     3224   procedure sss :
     3225     define variable v-object-available as logical   no-undo .
     3226     define buffer buf_clients for ub.clients .
     3227     do
     3228     on error undo, return error return-value
     3229     :
     3230       for each buf_clients no-lock
     3231         where buf_clients.host-code = g#host-code
     3232           and ( ( buf_clients.db-num = p-db-num ) or p-db-num = 0 )
     3233       on error undo, return error return-value
     3234       :
     3235   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3236   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     3237     (input  v-cntxt-db-num
     3238     ,input  0
     3239     ,input  v-cntxt-userid
     3240     ,input  buf_clients.obj-type
     3241     ,input  buf_clients.obj-code
     3242     ,output v-object-available
     3243     ) no-error .
     3244         if error-status :error
     3245         then do:
     3246           message
     3247             vss-workfile vss-revision vss-description skip
     3248             "Ошибка при вызове процедуры gbl/usobjava.i" skip
     3249             error-status :get-message(1) skip
     3250             return-value skip
     3251             view-as alert-box error .
     3252           undo, return no-apply .
     3253         end.
     3254         if v-object-available = true
     3255         then do:
     3256           create temp-obj-list.
     3257           assign
     3258             temp-obj-list.obj-type = buf_clients.obj-type
     3259             temp-obj-list.obj-code = buf_clients.obj-code
     3260           .
     3261         end.
     3262       end.
     3263     end.
     3264   end procedure.
