      914   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      915   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   define variable par-type          as character no-undo.
      918   define variable v-value-character as character no-undo .
      919   define variable v-value-date      as date      no-undo .
      920   define variable v-value-decimal   as decimal   no-undo .
      921   define variable v-value-integer   as integer   no-undo .
      922   define variable v-value-logical   as logical   no-undo .
      923   procedure ver-qnty-rcv-from-ord :
      924   define input  parameter p-ord-doc as character no-undo .
      925   define output parameter p-is-lim as logical    no-undo .
      926   define buffer buf_ord-doc     for ub.ord-doc      .
      927   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
      928   define variable v-kol as integer   no-undo .
      929   define variable v-ver as logical   no-undo .
      930     do
      931     on error undo, return error return-value
      932     :
      933      p-is-lim = false .
      934     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = p-ord-doc no-error .
      935     if buf_ord-doc.doc-type <> 'ОП':U then return .
      936   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   empty temp-table thbjattr_thbj-attr.
      938   run adm/shattri.p (
      939      input "get":U
      940     ,input buf_ord-doc.obj-type
      941     ,input buf_ord-doc.obj-code
      942     ,input 'ord-obj':U
      943     ,input  ""
      944     ,output v-value-character
      945     ,output v-value-date
      946     ,output v-value-decimal
      947     ,output v-value-integer
      948     ,output v-value-logical
      949     ,output par-type
      950     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      951     ) no-error .
      952     for each thbjattr_thbj-attr :
      953         if thbjattr_thbj-attr.prop-code = 'ord-11':U then v-ver = thbjattr_thbj-attr.property-value-logical .
      954     end.
      955   v-kol = 0.
      956     if v-ver then do:
      957        for each buf_ord-doc-rcv no-lock where
      958                 buf_ord-doc-rcv.doc-code = p-ord-doc :
      959          v-kol = v-kol + 1.
      960          leave.
      961        end.
      962      if v-kol > 0 then p-is-lim = true .
      963     end.
      964   end.
      965   end procedure.
      966   procedure ver-qnty-trn-from-rcv :
      967   define input  parameter p-rcv-code as character no-undo .
      968   define output parameter p-is-lim as logical   no-undo .
      969   define buffer buf_ord-doc for ub.ord-doc  .
      970   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
      971   define buffer buf_ord-chain for ub.ord-chain .
      972   define buffer buf_trn-doc for ub.trn-doc  .
      973   define variable v-kol as integer   no-undo .
      974   define variable v-ver as logical   no-undo .
      975     do
      976     on error undo, return error return-value
      977     :
      978      p-is-lim = false .
      979     find first buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.rcv-code = p-rcv-code no-error .
      980     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code no-error .
      981     if buf_ord-doc.doc-type <> 'ОП':U then return .
      982   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      983   empty temp-table thbjattr_thbj-attr.
      984   run adm/shattri.p (
      985      input "get":U
      986     ,input buf_ord-doc.obj-type
      987     ,input buf_ord-doc.obj-code
      988     ,input 'ord-obj':U
      989     ,input  ""
      990     ,output v-value-character
      991     ,output v-value-date
      992     ,output v-value-decimal
      993     ,output v-value-integer
      994     ,output v-value-logical
      995     ,output par-type
      996     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      997     ) no-error .
      998     for each thbjattr_thbj-attr :
      999         if thbjattr_thbj-attr.prop-code = 'ord-11':U then v-ver = thbjattr_thbj-attr.property-value-logical .
     1000     end.
     1001       if v-ver then do:
     1002       v-kol = 0.
     1003           for each buf_ord-chain no-lock where
     1004                   buf_ord-chain.doc-code = p-rcv-code and
     1005                   buf_ord-chain.doc-type = 'rcv' and
     1006                   buf_ord-chain.rel-doc-type = 'trn' ,
     1007               first buf_trn-doc NO-LOCK where
     1008                     buf_trn-doc.doc-code = buf_ord-chain.rel-doc-code
     1009                     :
     1010               v-kol = v-kol + 1.
     1011               leave.
     1012           end.
     1013           if v-kol > 0 then p-is-lim = true .
     1014       end.
     1015     end.
     1016   end procedure.
