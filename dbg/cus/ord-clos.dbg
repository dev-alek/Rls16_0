     1298   procedure ver-clients-calc :
     1299   define input  parameter p-cli-type as character no-undo .
     1300   define input  parameter p-cli-code as integer   no-undo .
     1301   define input  parameter p-obj-type as character no-undo .
     1302   define input  parameter p-obj-code as integer   no-undo .
     1303   define input  parameter p-method   as character no-undo .
     1304   define output parameter p-error    as logical   no-undo .
     1305   define variable v-not-corr-op as character no-undo .
     1306   define variable v-type as character no-undo .
     1307     do
     1308     on error undo, return error return-value
     1309     :
     1310    p-error = false .
     1311    v-not-corr-op  = 'no' .
     1312    run clntattr-value (
     1313       input   p-obj-type
     1314     , input   p-obj-code
     1315     , input   'not-corr-op':U
     1316     , output  v-not-corr-op
     1317     , output  v-type
     1318     ) no-error .
     1319     if error-status :error then v-not-corr-op  = 'no' .
     1320     if v-not-corr-op = 'yes' and  p-method = ""  then do:
     1321       assign v-not-corr-op = 'no' .
     1322       run clntattr-value (
     1323       input   p-cli-type
     1324     , input   p-cli-code
     1325     , input   'not-corr-op':U
     1326     , output  v-not-corr-op
     1327     , output  v-type
     1328     ) no-error .
     1329     if error-status :error then v-not-corr-op  = 'no' .
     1330     if v-not-corr-op = 'yes'  and  p-method = ""  then p-error = true .
     1331     end.
     1332     end.
     1333   end procedure.
     1334   procedure ver-ord-line :
     1335   define input parameter  p-doc-code like ub.ord-doc.doc-code no-undo .
     1336   define output parameter p-error    as logical               no-undo .
     1337   define variable v-longchar          as longchar  no-undo .
     1338   define variable v-err-ext           as logical   no-undo .
     1339   define variable var-ok-assort-pol   as logical   no-undo .
     1340   define variable var-mess-assort-pol as character no-undo .
     1341   define variable v-event-code        as character no-undo .
     1342   define variable v-ok                as logical   no-undo .
     1343   define variable v-nabor             as logical   no-undo .
     1344   define buffer buf_ord-line for ub.ord-line.
     1345   define buffer buf_ord-doc  for ub.ord-doc.
     1346   v-err-ext  = false .
     1347   find first buf_ord-doc no-lock
     1348     where buf_ord-doc.doc-code = p-doc-code no-error.
     1349     if not available buf_ord-doc then do:
     1350     end.
     1351     else do:
     1352   for each buf_ord-line of buf_ord-doc
     1353     break by buf_ord-line.cli-art :
     1354       if buf_ord-doc.doc-type <> 'ПО':U  and
     1355          buf_ord-doc.doc-type <> 'ФП':U  then do:
     1356          var-ok-assort-pol = true .
     1357          v-event-code = buf_ord-doc.doc-type + "-" .
     1358   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1359   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     1360     (input  v-event-code
     1361     ,input  buf_ord-line.gds-code
     1362     ,input  buf_ord-doc.obj-type
     1363     ,input  buf_ord-doc.obj-code
     1364     ,input  false
     1365     ,output var-ok-assort-pol
     1366     ,output var-mess-assort-pol
     1367     ) .
     1368              if var-ok-assort-pol = false then do:
     1369                 v-err-ext  = true  .
     1370                 v-longchar = v-longchar + var-mess-assort-pol + chr(10) .
     1371              end.
     1372       end.
     1373       if  buf_ord-doc.cli-type = 'маг':U or
     1374              buf_ord-doc.cli-type = 'скл':U then do:
     1375               var-ok-assort-pol = true .
     1376               v-event-code = "cli_" + buf_ord-doc.doc-type + "-" .
     1377   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1378   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     1379     (input  v-event-code
     1380     ,input  buf_ord-line.gds-code
     1381     ,input  buf_ord-doc.cli-type
     1382     ,input  buf_ord-doc.cli-code
     1383     ,input  false
