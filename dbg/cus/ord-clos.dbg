      632      define output parameter p-user-can-edit  as logical   no-undo .
      633      define output parameter p-output-display as logical   no-undo .
      634      define output parameter p-other          as character no-undo .
      635      define output parameter p-prop-list      as character no-undo .
      636      define output parameter p-prop-type-list as character no-undo .
      637      define output parameter p-prop-label-list as character no-undo .
      638      define output parameter p-global          as logical no-undo .
      639      define output parameter p-host           as logical no-undo .
      640      define output parameter p-shop           as logical no-undo .
      641      define output parameter p-store          as logical no-undo .
