     1079   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   PROCEDURE create-g-treal-3.
     1081   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
     1082   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
     1083   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
     1084   define input parameter p-rv as integer no-undo .
     1085   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     1086   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
     1087   DEFINE INPUT PARAMETER pout-name as character no-undo.
     1088   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
     1089   DEFINE INPUT PARAMETER pii as integer no-undo.
     1090   _main:
     1091   DO ON ERROR UNDO _main, return error:
     1092       create treal-3.
     1093       assign
     1094       treal-3.gds-code = pgds-code
     1095       treal-3.rv = p-rv
     1096       treal-3.cpay-code = pcpay-code
     1097       treal-3.curr-code = pcurr-code
     1098       treal-3.qnty1  =  pqnty1
     1099       treal-3.netto = pnetto
     1100       treal-3.out-name = pout-name
     1101       treal-3.is-pay = pis-pay
     1102       treal-3.ii = pii
     1103       no-error
     1104       .
     1105       if error-status:error then undo _main, return error.
     1106   END.
     1107   END PROCEDURE.
     1108   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1109   procedure cur-time :
     1110      define output parameter p-today as date      no-undo .
     1111      define output parameter p-time  as integer   no-undo .
     1112     do
     1113     on error undo, return error
     1114     :
     1115       define variable v-date1 as date      no-undo .
     1116       define variable v-date2 as date      no-undo .
     1117       define variable v-time  as integer   no-undo .
     1118       assign
     1119         v-date1 = today
     1120         v-time  = time
     1121         v-date2 = today
     1122       .
     1123       if v-date1 <> v-date2
     1124       then do:
     1125         assign
     1126           v-date1 = today
     1127           v-time  = v-time
     1128         .
     1129       end.
     1130       assign
     1131         p-today = v-date1
     1132         p-time  = v-time
     1133       .
     1134     end.
     1135   end.
     1136   function cur-time-date returns character
     1137   :
     1138     return string(today, '99/99/9999':U) .
     1139   end.
     1140   function cur-time-mjd returns decimal
     1141   :
     1142     define variable v-date as date      no-undo .
     1143     define variable v-time as integer   no-undo .
     1144     run cur-time in this-procedure
     1145       (output v-date
     1146       ,output v-time
     1147       ) .
     1148     return integer(v-date) - 2400002 + (v-time / 86400) .
     1149   end.
     1150   function cur-time-get-ending-index returns integer
     1151   (input p-number as integer
     1152   )
     1153   :
     1154     if p-number < 0
     1155     or p-number = ?
     1156     then do:
     1157       return 1 .
     1158     end.
     1159     define variable v-rest as integer   no-undo .
     1160     assign
     1161       p-number = p-number modulo 100
     1162     .
     1163     if p-number < 20
     1164     then do:
     1165       assign
     1166         v-rest = p-number
     1167       .
     1168     end.
     1169     else do:
     1170       assign
     1171         v-rest = p-number modulo 10
     1172       .
     1173     end.
     1174     case v-rest :
     1175       when 1
     1176       then do:
     1177         return 2 .
     1178       end.
     1179       when 2 or
     1180       when 3 or
     1181       when 4
     1182       then do:
     1183         return 3 .
     1184       end.
     1185       otherwise do:
     1186         return 1 .
     1187       end.
     1188     end case .
     1189   end.
     1190   procedure cur-time-mjd-to-date :
     1191      define input  parameter i-mjd-diff as decimal no-undo.
     1192      define output parameter o-Date     as date    no-undo.
     1193      define output parameter o-Time     as integer no-undo.
     1194      define variable v-day-number as integer   no-undo .
     1195      if    i-mjd-diff < 0
     1196         or i-mjd-diff = ?
     1197      then do:
     1198         return "?" .
     1199      end.
     1200      assign
     1201         v-day-number = truncate(i-mjd-diff,0).
     1202         o-Date = date(v-day-number + 2400002).
     1203         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1204     .
     1205   end.
     1206   function cur-time-mjd-to-string returns character
     1207   (input p-mjd-diff as decimal
     1208   )
     1209   :
     1210     define variable v-day-number as integer   no-undo .
     1211     define variable v-seconds    as integer   no-undo .
     1212     define variable v-hour       as integer   no-undo .
     1213     define variable v-min        as integer   no-undo .
     1214     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1215     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1216     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1217     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1218     if p-mjd-diff < 0
     1219     or p-mjd-diff = ?
     1220     then do:
     1221       return "?" .
     1222     end.
     1223     assign
     1224       v-day-number = integer(truncate(p-mjd-diff,0))
     1225       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1226     .
     1227     if v-seconds > 86400
     1228     then do:
     1229       assign
     1230         v-seconds = 86400 - 1
     1231       .
     1232     end.
     1233     if v-seconds < 0
     1234     then do:
     1235       assign
     1236         v-seconds = 0
     1237       .
     1238     end.
     1239     assign
     1240       v-hour = truncate(v-seconds / 3600, 0)
     1241     .
     1242     assign
     1243       v-seconds = v-seconds modulo 3600
     1244     .
     1245     assign
     1246       v-min = truncate(v-seconds / 60, 0)
     1247     .
     1248     assign
     1249       v-seconds = v-seconds modulo 60
     1250     .
     1251     return
     1252         (if v-day-number <> 0
     1253           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1254           else ""
     1255         )
     1256       + (if v-day-number <> 0 or v-hour <> 0
     1257           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1258           else ""
     1259         )
     1260       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1261           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1262           else ""
     1263         )
     1264       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1265       .
     1266   end.
     1267   function cur-time-string returns character
     1268   :
     1269     define variable v-date as date      no-undo .
     1270     define variable v-time as integer   no-undo .
     1271     run cur-time in this-procedure
     1272       (output v-date
     1273       ,output v-time
     1274       ) .
     1275     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1276   end.
     1277   function cur-time-string-sec returns character
     1278   :
     1279     define variable v-date as date      no-undo .
     1280     define variable v-time as integer   no-undo .
     1281     run cur-time in this-procedure
     1282       (output v-date
     1283       ,output v-time
     1284       ) .
     1285     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1286   end.
     1287   function cur-time-custom  returns character
     1288   (input p-prefix as character
     1289   ,input p-date-format as character
     1290   ,input p-delimiter as character
     1291   ,input p-time-format as character
     1292   ,input p-suffix as character
     1293   )
     1294   :
     1295     define variable v-date as date      no-undo .
     1296     define variable v-time as integer   no-undo .
     1297     run cur-time in this-procedure
     1298       (output v-date
     1299       ,output v-time
     1300       ) .
     1301     return
     1302       p-prefix
     1303       + string(v-date, p-date-format)
     1304       + p-delimiter
     1305       + string(v-time, p-time-format)
     1306       + p-suffix
     1307       .
     1308   end.
     1309   function cur-time-print  returns character
     1310   :
     1311     define variable v-date as date      no-undo .
     1312     define variable v-time as integer   no-undo .
     1313     run cur-time in this-procedure
     1314       (output v-date
     1315       ,output v-time
     1316       ) .
     1317     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1318   end.
     1319   function cur-time-datetime returns datetime
     1320   :
     1321     define variable v-char as character no-undo .
     1322     define variable v-datetime as datetime no-undo .
     1323     v-char = cur-time-string().
     1324     v-datetime = datetime(v-char).
     1325     return  v-datetime.
     1326   end.
     1327   function cur-time-string-msec returns character
     1328   :
     1329     define variable v-date as datetime  no-undo .
     1330     v-date = now.
     1331     return string(v-date) .
     1332   end.
