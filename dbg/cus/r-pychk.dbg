     1421   procedure process-inkas :
     1422   define parameter buffer buf_inkas for ub.inkas.
     1423   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1424   define variable pychk_kk as integer no-undo .
     1425   define variable pychk_jj as integer no-undo .
     1426   define variable pychk_jjp as integer no-undo .
     1427   define variable pychk_jjo as integer no-undo .
     1428   define variable pychk_pay-sum as decimal no-undo .
     1429   DEFINE VARIABLE pychk_No-EXCH as logical no-undo.
     1430   DEFINE VARIABLE pychk_No-EXCH-rubl as logical no-undo.
     1431   DEFINE VARIABLE pychk_dop-sump as decimal No-UNDO.
     1432   DEFINE VARIABLE pychk_dop-sumg as decimal No-UNDO.
     1433   DEFINE VARIABLE pychk_dop-sumk as decimal No-UNDO.
     1434   DEFINE VARIABLE pychk_exch as decimal No-UNDO.
     1435   DEFINE VARIABLE pychk_exch-rubl as decimal No-UNDO.
     1436   define variable pychk_pay-desk like ub.chk-doc.pay-desk no-undo init 0.
     1437   DEFINE VARIABLE pychk_classify as logical no-undo  init no.
     1438   DEFINE VARIABLE pychk_selectgood as logical no-undo init no.
     1439   define variable pychk_rv as integer no-undo .
     1440   DEFINE VARIABLE pychk_density AS DECIMAL NO-UNDO.
     1441   DEFINE VARIABLE pychk_SHEET2 as logical no-undo.
     1442   DEFINE VARIABLE pychk_SHEET3 as logical no-undo.
     1443   DEFINE VARIABLE pychk_SHEET4 as logical no-undo.
     1444   DEFINE VARIABLE pychk_SHEET8 as logical no-undo.
     1445   define variable pychk_doc-code-r as character no-undo .
     1446   define variable pychk_doc-code-v as character no-undo .
     1447   define variable pychk_doc-code as character no-undo .
     1448   define buffer pychk_ret-doc for ub.trn-doc .
     1449   define buffer pychk_ras-doc for ub.trn-doc .
     1450   DEFINE BUFFER b-treal-3 for treal-3.
     1451   DEFINE VARIABLE v-line-num as integer no-undo .
     1452   define variable v-curr-r-b as character no-undo .
     1453   define variable v-base-code like ub.sysconf.base-code no-undo .
     1454   define variable p-by-pay-desk as logical no-undo .
     1455   define buffer buf_trn-doc for ub.trn-doc.
     1456   define buffer buf_ret-doc for ub.trn-doc.
     1457   define buffer buf_goods   for ub.goods.
     1458   define buffer pay_treal-vat for treal-vat.
     1459   define buffer pay0_treal-vat for treal-vat.
     1460   define buffer gen_treal-vat for treal-vat.
     1461   define buffer gen0_treal-vat for treal-vat.
     1462   define buffer buf_doc-line for ub.doc-line.
     1463   define variable v-ret-doc-code like ub.trn-doc.doc-code no-undo .
     1464   define variable v-grp-code as character no-undo .
     1465   define buffer buf_tt-cash-pay  for tt-cash-pay.
     1466   define buffer buf_tt-cash-group for tt-cash-group.
     1467   do
     1468   on error undo, return error
     1469   :
     1470   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1472     (output v-curr-r-b
     1473     )  .
     1474   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1476     (input  buf_inkas.host-code
     1477     ,output v-base-code
     1478     )  .
     1479     if v-curr-r-b = 'base':U or
     1480     v-base-code = 0 then pychk_NO-exch = yes.
     1481     else pychk_No-exch = no.
     1482     if v-curr-r-b = 'rubl':U or
     1483     v-base-code = 0 then pychk_NO-exch-rubl = yes.
     1484     else pychk_No-exch-rubl = no.
     1485     assign
     1486     v-curr-code = (if v-curr-code = ? then v-base-code else v-curr-code)
     1487     v-one-curr-code = (if v-base-code = v-curr-code then yes else no)
     1488     .
     1489     find first buf_trn-doc no-lock where
     1490               buf_trn-doc.doc-code = buf_inkas.inkas-code .
     1491     find first buf_ret-doc no-lock where
     1492               buf_ret-doc.doc-code = buf_trn-doc.out-code no-error .
     1493     if available buf_ret-doc then
     1494     assign
     1495     v-ret-doc-code = buf_ret-doc.doc-code
     1496     .
     1497     assign
     1498     pychk_sheet3 = yes
     1499     .
     1500     for each temp-chk-gds:
     1501       delete temp-chk-gds.
     1502     end.
     1503     _chk-doc:
     1504     FOR EACH ub.chk-doc No-LOCK WHERE
     1505             ub.chk-doc.obj-type = buf_inkas.obj-type AND
     1506             ub.chk-doc.obj-code = buf_inkas.obj-code AND
     1507             ub.chk-doc.out-code = buf_inkas.inkas-code,
     1508       EACH ub.chk-pay NO-LOCK WHERE
     1509               ub.chk-pay.doc-code = ub.chk-doc.doc-code
     1510         BREAK
     1511         BY CHK-pay.DOC-CODE
     1512         BY CHK-pay.LINE-NUM:
     1513       if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     1514         pychk_rv = (if p-rv
     1515                 then (if ub.chk-doc.netto >= 0 then 1 else - 1)
     1516                 else 0).
     1517   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1518   if first-of(CHK-pay.DOC-CODE) THEN Do:
     1519     assign
     1520     pychk_kk = 0
     1521     pychk_jj = 1
     1522     pychk_jjp = 0
     1523     pychk_jjo = 0
     1524     pychk_pay-sum = chk-doc.netto
     1525     pychk_dop-sumg = 0
     1526     .
     1527    if ub.chk-doc.netto < 0 then do:
     1528           if pychk_doc-code-r <> ub.chk-doc.out-code
     1529           then do:
     1530             find first pychk_ras-doc no-lock
     1531               where pychk_ras-doc.doc-code = ub.chk-doc.out-code
     1532               no-error .
     1533             if not available pychk_ras-doc then do:
     1534               message
     1535                 substitute("Отсутствует документ расхода по чеку &1"
     1536                           , ub.chk-doc.doc-code
     1537                           )   skip
     1538                 "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
     1539                 view-as alert-box error .
     1540               return error .
     1541             end.
     1542             pychk_doc-code-r = pychk_ras-doc.doc-code.
     1543             find first pychk_ret-doc no-lock
     1544               where pychk_ret-doc.doc-code = pychk_ras-doc.out-code
     1545               no-error .
     1546             if not available pychk_ret-doc then do:
     1547               message
     1548                 substitute("Отсутствует документ возврата по чеку &1"
     1549                           , ub.chk-doc.doc-code
     1550                           )   skip
     1551                 "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
     1552                 view-as alert-box error .
     1553               return error .
     1554             end.
     1555             pychk_doc-code-v = pychk_ret-doc.doc-code.
     1556           end.
     1557           assign
     1558             pychk_doc-code = pychk_doc-code-v
     1559           .
     1560         end.
     1561         else do:
     1562           assign
     1563             pychk_doc-code = ub.chk-doc.out-code
     1564           .
     1565         end.
     1566     FOR EACH ub.chk-gds No-LOCK WHERE
     1567              ub.chk-gds.doc-code = ub.chk-pay.doc-code
     1568     BY ub.chk-gds.line-num:
     1569     pychk_density = 0.
     1570     if ub.chk-gds.write-off-code <> ?
     1571     and ub.chk-gds.write-off-code > 0 then NEXT.
     1572         find first temp-chk-gds where
     1573                   temp-chk-gds.b-code = chk-gds.b-code
     1574              AND  temp-chk-gds.doc-code = chk-gds.doc-code
     1575              and temp-chk-gds.rec-type = 0  no-error.
     1576         IF AVAILABLE TEMP-CHK-GDS THEN DO:
     1577           assign
     1578           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.DOC-qnty
     1579           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
     1580           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + chk-gds.doc-qnty * pychk_density
     1581           temp-chk-gds.sum-change = temp-chk-gds.sum
     1582           .
     1583         end.
     1584         else do:
     1585           find first temp-chk-gds where temp-chk-gds.jj_ = pychk_jj use-index ijj no-error.
     1586           if not available temp-chk-gds then do:
     1587             create temp-chk-gds.
     1588             assign
     1589             temp-chk-gds.jj_ = pychk_jj
     1590             temp-chk-gds.qnty2 = 0
     1591             temp-chk-gds.qnty = 0
     1592             temp-chk-gds.sum = 0
     1593             temp-chk-gds.sum-change = temp-chk-gds.sum
     1594             pychk_jj = pychk_jj + 1
     1595             .
     1596           end.
     1597           else do:
     1598             assign
     1599             pychk_jj = pychk_jj + 1
     1600             temp-chk-gds.qnty2 = 0
     1601             temp-chk-gds.qnty = 0
     1602             temp-chk-gds.sum = 0
     1603             temp-chk-gds.sum-change = temp-chk-gds.sum
     1604             .
     1605           end.
     1606           ASSIGN
     1607           temp-chk-gds.doc-code = chk-gds.doc-code
     1608           temp-chk-gds.b-code = chk-gds.b-code
     1609           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.DOC-qnty
     1610           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
     1611           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + chk-gds.doc-qnty * pychk_density
     1612           temp-chk-gds.sum-change = temp-chk-gds.sum
     1613           temp-chk-gds.rec-type = 0
     1614           temp-chk-gds.gds-type =
     1615                                     2
     1616           pychk_jjo = pychk_jjo + 1
     1617           temp-chk-gds.jjp_  = 0
     1618           temp-chk-gds.jjo_  = pychk_jjo
     1619           .
     1620         end.
     1621     END.
     1622   end.
     1623   FIND FIRST ub.cash-pay No-LOCK WHERE
     1624             ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     1625             ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     1626   if available ub.cash-pay then do:
     1627     find first temp-chk-pay where
     1628             temp-chk-pay.line-num = chk-pay.line-num
     1629         AND  temp-chk-pay.doc-code = chk-pay.doc-code  no-error.
     1630     find first temp-chk-pay use-index pi where
     1631             temp-chk-pay.line-num = chk-pay.line-num no-error.
     1632     if not available temp-chk-pay then do:
     1633       create temp-chk-pay.
     1634     end.
     1635     buffer-copy chk-pay to temp-chk-pay
     1636     assign
     1637     temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash)
     1638     temp-chk-pay.obj-name = cash-pay.obj-name
     1639     temp-chk-pay.is-cash  = cash-pay.is-cash
     1640     temp-chk-pay.register = cash-pay.register
     1641     .
     1642   end.
     1643   if last-of(chk-pay.doc-code) then do:
     1644     for each temp-chk-pay where
     1645             temp-chk-pay.doc-code = chk-pay.doc-code
     1646     by temp-chk-pay.pet-good descending
     1647     by temp-chk-pay.line-num:
     1648       assign
     1649       pychk_dop-sump = (if v-curr-r-b = 'rubl':U then temp-chk-pay.tot-rubl else temp-chk-pay.tot-base)
     1650       pychk_exch = if pychk_No-exch then 1 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base
     1651       pychk_exch-rubl = if pychk_No-exch-rubl then 1 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base
     1652       .
     1653       _repeat:
     1654       REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     1655         if pychk_dop-sumg = 0 then do:
     1656           assign
     1657           pychk_kk = pychk_kk + 1
     1658           .
     1659           if pychk_kk >= pychk_jj then LEAVE _repeat.
     1660           if pychk_kk <= pychk_jjp then
     1661           find first temp-chk-gds where
     1662                     temp-chk-gds.doc-code = chk-doc.doc-code
     1663               AND  temp-chk-gds.jjp_ = pychk_kk no-error .
     1664           else
     1665           find first temp-chk-gds where
     1666                     temp-chk-gds.doc-code = chk-doc.doc-code
     1667               AND  temp-chk-gds.jjo_ = pychk_kk - pychk_jjp no-error .
     1668           if not available temp-chk-gds or temp-chk-gds.sum = 0 then do:
     1669             NEXT _repeat.
     1670           end.
     1671           assign
     1672           pychk_dop-sumg = temp-chk-gds.sum
     1673           .
     1674         end.
     1675         assign
     1676         pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 )
     1677         pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     1678         pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     1679         pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     1680         .
     1681         FIND FIRST ub.bar-code No-LOCK WHERE
     1682                   ub.bar-code.b-code =  temp-chk-gds.b-code No-ERROR.
     1683         IF NOT AVAIL ub.bar-code then NEXT _repeat.
     1684         if x-SelectGood  = 4 then do:
     1685           find first gds-list no-lock where
     1686                   gds-list.gds-code = ub.bar-code.gds-code no-error .
     1687         end.
     1688         if x-SelectGood  = 1
     1689         or available gds-list then do:
     1690         CASE temp-chk-gds.gds-type:
     1691           WHEN 2   then do:
     1692                   if pychk_sheet3 then do:
     1693               FIND FIRST ub.goods No-LOCK WHERE
     1694                           ub.goods.gds-code = ub.bar-code.gds-code No-ERROR.
     1695               IF NOT AVAIL ub.goods then NEXT _repeat.
     1696               FIND FIRST treal-3 No-LOCK WHERE
     1697                         treal-3.gds-code = ub.goods.gds-code AND
     1698                         treal-3.cpay-code = temp-chk-pay.pay-code AND
     1699                         treal-3.curr-code = temp-chk-pay.curr-code
     1700                         AND treal-3.rv = pychk_rv
     1701                         No-ERROR.
     1702               IF NOT AVAIL treal-3 then do:
     1703                 FIND last b-treal-3 No-LOCK WHERE
     1704                           b-treal-3.gds-code = ub.goods.gds-code use-index vi No-ERROR.
     1705                 run create-g-treal-3  in this-procedure (
     1706                               INPUT ub.goods.gds-code,
     1707                               INPUT temp-chk-pay.pay-code,
     1708                               INPUT temp-chk-pay.curr-code,
     1709                               INPUT pychk_rv,
     1710                               INPUT 0,
     1711                               INPUT 0,
     1712                               INPUT temp-chk-pay.obj-name,
     1713                               INPUT yes,
     1714                               INPUT (if avail b-treal-3
     1715                                       then b-treal-3.ii + 1
     1716                                       else 1)
     1717                                     ) no-error.
     1718               END.
     1719               assign
     1720               treal-3.netto = treal-3.netto + pychk_dop-sumk / pychk_exch
     1721               treal-3.qnty1 = treal-3.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     1722               treal-3.netto-rubl = treal-3.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
     1723               treal-3.netto-inkas = (if treal-3.inkas-code <> buf_inkas.inkas-code
     1724                                     then 0
     1725                                     else treal-3.netto-inkas)
     1726               treal-3.netto-rubl-inkas = (if treal-3.inkas-code <> buf_inkas.inkas-code
     1727                                           then 0
     1728                                           else treal-3.netto-rubl-inkas)
     1729               treal-3.vat-pc      = if treal-3.inkas-code <> buf_inkas.inkas-code
     1730                                     then -1
     1731                                     else treal-3.vat-pc
     1732               treal-3.inkas-code        = if treal-3.inkas-code <> buf_inkas.inkas-code
     1733                                           then buf_inkas.inkas-code
     1734                                           else treal-3.inkas-code
     1735               treal-3.netto-inkas = treal-3.netto-inkas + pychk_dop-sumk / pychk_exch
     1736               treal-3.netto-rubl-inkas = treal-3.netto-rubl-inkas + pychk_dop-sumk * pychk_exch-rubl
     1737               .
     1738             END.
     1739           END.
     1740         END CASE.
     1741           end.
     1742         if pychk_dop-sumg <= 0 then do:
     1743           assign
     1744           pychk_kk = pychk_kk + 1.
     1745           if pychk_kk >= pychk_jj then LEAVE _repeat.
     1746           if pychk_kk <= pychk_jjp then do:
     1747             find first temp-chk-gds where
     1748                       temp-chk-gds.doc-code = chk-doc.doc-code
     1749                 AND  temp-chk-gds.jjp_ = pychk_kk no-error .
     1750           end.
     1751           else do:
     1752             find first temp-chk-gds where
     1753                       temp-chk-gds.doc-code = chk-doc.doc-code
     1754                 AND  temp-chk-gds.jjo_ = pychk_kk - pychk_jjp no-error .
     1755             if not available temp-chk-gds then do:
     1756               LEAVE _repeat.
     1757             end.
     1758           end.
     1759           pychk_dop-sumg = temp-chk-gds.sum.
     1760           pychk_dop-sumg = temp-chk-gds.sum.
     1761         end.
     1762       END.
     1763     end.
     1764   output close.
     1765   end.
     1766     END.
     1767     _doc-line:
     1768     FOR EACH treal-3 where
     1769             treal-3.vat-pc = - 1,
     1770         FIRST buf_goods no-lock where
     1771               buf_goods.gds-code = treal-3.gds-code:
     1772       if not p-rv or treal-3.rv = 1 then do:
     1773         FIND FIRST buf_doc-line no-lock WHERE
     1774                   buf_doc-line.doc-code = buf_inkas.inkas-code AND
     1775                   buf_doc-line.artic     = buf_goods.artic AND
     1776                   buf_doc-line.prod-type = buf_goods.prod-type AND
     1777                   buf_doc-line.prod-code = buf_goods.prod-code  no-error .
     1778         if available buf_doc-line then do:
     1779           assign
     1780           treal-3.vat-pc = buf_doc-line.vat-pc.
     1781           if p-group then do:                                      find first buf_tt-cash-pay no-lock where                                               buf_tt-cash-pay.cdpay-code = treal-3.cpay-code                           AND buf_tt-cash-pay.curr-code = treal-3.curr-code no-error.            if buf_tt-cash-pay.grp-code = chr(4) + "0":U then do:                  assign                                                                       v-grp-code = string(treal-3.cpay-code) + chr(4) +                                 string(treal-3.curr-code)                                       .                                                                          end.                                                                         else do:                                                                       assign                                                                       v-grp-code = buf_tt-cash-pay.grp-code                                        .                                                                          end.                                                                       end.                                                                         else do:                                                                       assign                                                                       v-grp-code = string(treal-3.cpay-code) + chr(4) +                                 string(treal-3.curr-code)                                       .                                                                          end.                                                                                              find first treal-vat where                                      treal-vat.inkas-code = buf_Inkas.inkas-code                              AND treal-vat.vat-pc = treal-3.vat-pc                                        AND treal-vat.grp-code = v-grp-code                                          AND treal-vat.rv   = treal-3.rv  no-error .                                                   find first pay_treal-vat where                                  pay_treal-vat.inkas-code = "":U                                          AND pay_treal-vat.vat-pc = treal-3.vat-pc                                    AND pay_treal-vat.grp-code = v-grp-code                                      AND pay_treal-vat.rv = treal-3.rv                no-error .                  if p-rv then do:                                                                              find first pay0_treal-vat where                                 pay0_treal-vat.inkas-code = "":U                                         AND pay0_treal-vat.vat-pc = treal-3.vat-pc                                   AND pay0_treal-vat.grp-code = v-grp-code                                     AND pay0_treal-vat.rv = 0                         no-error .                 end.                                                                                          find first gen_treal-vat where                                  gen_treal-vat.inkas-code = "":U                                          AND gen_treal-vat.vat-pc = treal-3.vat-pc                                    AND gen_treal-vat.grp-code  = "":U                                           AND gen_treal-vat.rv = treal-3.rv  no-error .                                if p-rv then do:                                                                              find first gen0_treal-vat where                                 gen0_treal-vat.inkas-code = "":U                                         AND gen0_treal-vat.vat-pc = treal-3.vat-pc                                   AND gen0_treal-vat.grp-code  = "":U                                          AND gen0_treal-vat.rv = 0  no-error .                                        end .                                                                  if not available treal-vat then do:                                            create treal-vat.                                                            assign                                                                       treal-vat.inkas-code = buf_inkas.inkas-code                                  treal-vat.doc-date   = buf_inkas.doc-date                                    treal-vat.fact-order = buf_trn-doc.fact-order                                treal-vat.grp-code   = v-grp-code                                            treal-vat.vat-pc     = treal-3.vat-pc                                        treal-vat.rv         = treal-3.rv                                            .                                                                          end.                                                                         if not available pay_treal-vat then do:                                        create pay_treal-vat.                                                        assign                                                                       pay_treal-vat.inkas-code = "":U                                              pay_treal-vat.fact-order = 0                                                 pay_treal-vat.grp-code = v-grp-code                                          pay_treal-vat.vat-pc     = treal-3.vat-pc                                    pay_treal-vat.rv         = treal-3.rv                                        .                                                                          end.                                                                         if P-RV AND not available pay0_treal-vat then do:                              create pay0_treal-vat.                                                       assign                                                                       pay0_treal-vat.inkas-code = "":U                                             pay0_treal-vat.fact-order = 0                                                pay0_treal-vat.grp-code = v-grp-code                                         pay0_treal-vat.vat-pc     = treal-3.vat-pc                                   pay0_treal-vat.rv         = 0                                                .                                                                          end.                                                                         if not available gen_treal-vat then do:                                        create gen_treal-vat.                                                        assign                                                                       gen_treal-vat.inkas-code = "":U                                              gen_treal-vat.grp-code   = "":U                                              gen_treal-vat.vat-pc     = treal-3.vat-pc                                    gen_treal-vat.rv         = treal-3.rv                                        .                                                                          end.                                                                         if P-RV AND not available gen0_treal-vat then do:                              create gen0_treal-vat.                                                       assign                                                                       gen0_treal-vat.inkas-code = "":U                                             gen0_treal-vat.grp-code   = "":U                                             gen0_treal-vat.vat-pc     = treal-3.vat-pc                                   gen0_treal-vat.rv         = 0                                                .                                                                          end.
     1782           assign                                                                       treal-vat.netto = treal-vat.netto + treal-3.netto-inkas                      treal-vat.netto-rubl = treal-vat.netto-rubl + treal-3.netto-rubl-inkas       pay_treal-vat.netto = pay_treal-vat.netto + treal-3.netto-inkas              pay_treal-vat.netto-rubl = pay_treal-vat.netto-rubl + treal-3.netto-rubl-inkas gen_treal-vat.netto = gen_treal-vat.netto + treal-3.netto-inkas              gen_treal-vat.netto-rubl = gen_treal-vat.netto-rubl + treal-3.netto-rubl-inkas .                                                                              if p-rv then do:                                                                 assign                                                                         pay0_treal-vat.netto = pay0_treal-vat.netto + treal-3.netto-inkas                pay0_treal-vat.netto-rubl = pay0_treal-vat.netto-rubl + treal-3.netto-rubl-inkas   gen0_treal-vat.netto = gen0_treal-vat.netto + treal-3.netto-inkas                gen0_treal-vat.netto-rubl = gen0_treal-vat.netto-rubl + treal-3.netto-rubl-inkas   .                                                                               end.
     1783           NEXT _doc-line.
     1784         end.
     1785       end.
     1786       if (not p-rv and  not available buf_doc-line)
     1787       or treal-3.rv = - 1 then do:
     1788         FIND FIRST buf_doc-line no-lock WHERE
     1789                   buf_doc-line.doc-code = v-ret-doc-code AND
     1790                   buf_doc-line.artic     = buf_goods.artic AND
     1791                   buf_doc-line.prod-type = buf_goods.prod-type AND
     1792                   buf_doc-line.prod-code = buf_goods.prod-code  no-error .
     1793         if available buf_doc-line then do:
     1794           assign
     1795           treal-3.vat-pc = buf_doc-line.vat-pc.
     1796           if p-group then do:                                      find first buf_tt-cash-pay no-lock where                                               buf_tt-cash-pay.cdpay-code = treal-3.cpay-code                           AND buf_tt-cash-pay.curr-code = treal-3.curr-code no-error.            if buf_tt-cash-pay.grp-code = chr(4) + "0":U then do:                  assign                                                                       v-grp-code = string(treal-3.cpay-code) + chr(4) +                                 string(treal-3.curr-code)                                       .                                                                          end.                                                                         else do:                                                                       assign                                                                       v-grp-code = buf_tt-cash-pay.grp-code                                        .                                                                          end.                                                                       end.                                                                         else do:                                                                       assign                                                                       v-grp-code = string(treal-3.cpay-code) + chr(4) +                                 string(treal-3.curr-code)                                       .                                                                          end.                                                                                              find first treal-vat where                                      treal-vat.inkas-code = buf_Inkas.inkas-code                              AND treal-vat.vat-pc = treal-3.vat-pc                                        AND treal-vat.grp-code = v-grp-code                                          AND treal-vat.rv   = treal-3.rv  no-error .                                                   find first pay_treal-vat where                                  pay_treal-vat.inkas-code = "":U                                          AND pay_treal-vat.vat-pc = treal-3.vat-pc                                    AND pay_treal-vat.grp-code = v-grp-code                                      AND pay_treal-vat.rv = treal-3.rv                no-error .                  if p-rv then do:                                                                              find first pay0_treal-vat where                                 pay0_treal-vat.inkas-code = "":U                                         AND pay0_treal-vat.vat-pc = treal-3.vat-pc                                   AND pay0_treal-vat.grp-code = v-grp-code                                     AND pay0_treal-vat.rv = 0                         no-error .                 end.                                                                                          find first gen_treal-vat where                                  gen_treal-vat.inkas-code = "":U                                          AND gen_treal-vat.vat-pc = treal-3.vat-pc                                    AND gen_treal-vat.grp-code  = "":U                                           AND gen_treal-vat.rv = treal-3.rv  no-error .                                if p-rv then do:                                                                              find first gen0_treal-vat where                                 gen0_treal-vat.inkas-code = "":U                                         AND gen0_treal-vat.vat-pc = treal-3.vat-pc                                   AND gen0_treal-vat.grp-code  = "":U                                          AND gen0_treal-vat.rv = 0  no-error .                                        end .                                                                  if not available treal-vat then do:                                            create treal-vat.                                                            assign                                                                       treal-vat.inkas-code = buf_inkas.inkas-code                                  treal-vat.doc-date   = buf_inkas.doc-date                                    treal-vat.fact-order = buf_trn-doc.fact-order                                treal-vat.grp-code   = v-grp-code                                            treal-vat.vat-pc     = treal-3.vat-pc                                        treal-vat.rv         = treal-3.rv                                            .                                                                          end.                                                                         if not available pay_treal-vat then do:                                        create pay_treal-vat.                                                        assign                                                                       pay_treal-vat.inkas-code = "":U                                              pay_treal-vat.fact-order = 0                                                 pay_treal-vat.grp-code = v-grp-code                                          pay_treal-vat.vat-pc     = treal-3.vat-pc                                    pay_treal-vat.rv         = treal-3.rv                                        .                                                                          end.                                                                         if P-RV AND not available pay0_treal-vat then do:                              create pay0_treal-vat.                                                       assign                                                                       pay0_treal-vat.inkas-code = "":U                                             pay0_treal-vat.fact-order = 0                                                pay0_treal-vat.grp-code = v-grp-code                                         pay0_treal-vat.vat-pc     = treal-3.vat-pc                                   pay0_treal-vat.rv         = 0                                                .                                                                          end.                                                                         if not available gen_treal-vat then do:                                        create gen_treal-vat.                                                        assign                                                                       gen_treal-vat.inkas-code = "":U                                              gen_treal-vat.grp-code   = "":U                                              gen_treal-vat.vat-pc     = treal-3.vat-pc                                    gen_treal-vat.rv         = treal-3.rv                                        .                                                                          end.                                                                         if P-RV AND not available gen0_treal-vat then do:                              create gen0_treal-vat.                                                       assign                                                                       gen0_treal-vat.inkas-code = "":U                                             gen0_treal-vat.grp-code   = "":U                                             gen0_treal-vat.vat-pc     = treal-3.vat-pc                                   gen0_treal-vat.rv         = 0                                                .                                                                          end.
     1797           assign                                                                       treal-vat.netto = treal-vat.netto + treal-3.netto-inkas                      treal-vat.netto-rubl = treal-vat.netto-rubl + treal-3.netto-rubl-inkas       pay_treal-vat.netto = pay_treal-vat.netto + treal-3.netto-inkas              pay_treal-vat.netto-rubl = pay_treal-vat.netto-rubl + treal-3.netto-rubl-inkas gen_treal-vat.netto = gen_treal-vat.netto + treal-3.netto-inkas              gen_treal-vat.netto-rubl = gen_treal-vat.netto-rubl + treal-3.netto-rubl-inkas .                                                                              if p-rv then do:                                                                 assign                                                                         pay0_treal-vat.netto = pay0_treal-vat.netto + treal-3.netto-inkas                pay0_treal-vat.netto-rubl = pay0_treal-vat.netto-rubl + treal-3.netto-rubl-inkas   gen0_treal-vat.netto = gen0_treal-vat.netto + treal-3.netto-inkas                gen0_treal-vat.netto-rubl = gen0_treal-vat.netto-rubl + treal-3.netto-rubl-inkas   .                                                                               end.
     1798           NEXT _doc-line.
     1799         end.
     1800       end.
     1801     end.
     1802   end.
     1803   end procedure.
     1804   procedure printproc :
     1805   define variable v-only-excel as logical no-undo .
     1806   define variable f-cash-pay-name like ub.cash-pay.obj-name no-undo .
     1807   define variable f-inkas-code like ub.inkas.inkas-code no-undo .
     1808   define variable f-sum-rubl-3 as decimal no-undo .
     1809   define variable f-sum-base-4 as decimal no-undo .
     1810   define variable f-sum-rubl-4 as decimal no-undo .
     1811   define variable f-sum-base as decimal no-undo .
     1812   DEFINE VARIABLE fill18 as character no-undo.
     1813   DEFINE VARIABLE fill30 as character no-undo.
     1814   define variable ii as integer no-undo .
     1815   DEFINE VARIABLE Line                as      char    no-undo.
     1816   DEFINE VARIABLE date_string     as      char    no-undo.
     1817   define variable accum-netto as decimal no-undo extent 3.
     1818   define variable accum-netto-rubl as decimal no-undo extent 3.
     1819   define variable glog as logical no-undo .
     1820   define variable col-ii as integer no-undo .
     1821   define variable col-jj as integer no-undo .
     1822   define variable v-page-num as integer no-undo init -1.
     1823   define variable v-header as character no-undo .
     1824   define variable v-r-b as logical no-undo .
     1825   define variable v-rubl as logical no-undo .
     1826   define variable v-curr-r-b as character no-undo .
     1827   define variable v-header-curr as character no-undo .
     1828   define variable v-curr-abbr as character no-undo .
     1829   define variable irv as integer no-undo .
     1830   define variable irv-start as integer no-undo .
     1831   define variable irv-end as integer no-undo .
     1832   define variable col-trail as integer no-undo .
     1833   define variable col-fix as integer no-undo .
     1834   define variable num-vats as integer no-undo .
     1835   define variable iext as integer no-undo .
     1836   define variable irv2 as integer no-undo .
     1837   define variable v-first-found-vat as logical no-undo .
     1838   define variable v-first-found-rv as logical no-undo .
     1839   define variable jj as integer no-undo .
     1840   define buffer buf_cash-pay for ub.cash-pay.
     1841   define buffer gen_treal-vat for treal-vat.
     1842   define buffer gen0_treal-vat for treal-vat.
     1843   define buffer pay_treal-vat for treal-vat.
     1844   define buffer buf_tt-cash-group for tt-cash-group.
     1845   define buffer buf_currency for ub.currency.
     1846   define buffer buf_treal-vat for treal-vat.
     1847     do
     1848     on error undo, return error
     1849     :
     1850   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1851   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1852     (output v-curr-r-b
     1853     )  .
     1854       assign
     1855       sheetf.Excel-Column-Lable =  "Продажа,Дата док.,Тип кассового платежа" +
     1856                                    (if p-rv then ",Рас/Взв" else '':U)
     1857       sheetf.colformat = "2=dd/mm/yyyy"
     1858       sheetf.sizes = "16,10,30" +  (if p-rv then ",7" else '':U)
     1859       v-header = string("Продажа", "X(16)") + chr(32) +
     1860                  string("Дата док.", "X(10)") + chr(32) +
     1861                  string("Тип кассового платежа", "X(30)")  + chr(32)  +
     1862                  (if p-rv then (string("Рас/Взвр", "X(7)")  + chr(32))
     1863                   else '':U)
     1864       v-r-b = (if v-curr-r-b = 'rubl':U or v-one-curr-code then yes else no)
     1865       v-rubl =(if not v-r-b or (v-r-b = yes and v-curr-r-b = 'rubl':U)
     1866               then yes
     1867               else no)
     1868       .
     1869       if v-rubl = yes then do:
     1870         assign
     1871         v-header-curr = string( "(Все суммы в рублях)" )
     1872         .
     1873       end.
     1874       else do:
     1875         find first buf_currency no-lock where
     1876                   buf_currency.curr-code = v-curr-code no-error .
     1877         assign
     1878         v-header-curr = string( "(Все суммы в " +
     1879                                (if available buf_currency
     1880                                then buf_currency.curr-abbr
     1881                                else string(v-curr-code)) + ")"
     1882                               )
     1883         .
     1884       end.
     1885       if p-rv then do:
     1886         assign
     1887         irv-start = 1
     1888         irv-end = - 1
     1889         col-fix  = 59
     1890         col-trail = 67
     1891         .
     1892       end.
     1893       else do:
     1894         assign
     1895         col-fix  = 59
     1896         col-trail = 59
     1897         irv-start = 0
     1898         irv-end = 0
     1899         .
     1900       end.
     1901       for each gen0_treal-vat no-lock where
     1902               gen0_treal-vat.inkas-code = "":U
     1903           AND gen0_treal-vat.grp-code   = ""
     1904           AND gen0_treal-vat.rv   = 0
     1905       break
     1906       by gen0_treal-vat.vat-pc:
     1907         if first-of(gen0_treal-vat.vat-pc) then do:
     1908           assign
     1909           num-vats = num-vats + 1
     1910           sheetf.Excel-Column-Lable =  sheetf.Excel-Column-Lable + chr(44) + "Товар с НДС" + chr(32) + string(gen0_treal-vat.vat-pc, ">9.99")
     1911           sheetf.sizes = sheetf.sizes + chr(44) +  "20"
     1912           v-header   = v-header + string("Товар с НДС" + chr(32) + string(gen0_treal-vat.vat-pc, ">9.99"), "X(20)")
     1913           .
     1914         end.
     1915       end.
     1916       assign
     1917       sheetf.Excel-Column-Lable =  sheetf.Excel-Column-Lable + chr(44) + "Итого по всем НДС"
     1918       sheetf.sizes = sheetf.sizes + chr(44) +  "20"
     1919       v-header = v-header + string("Итого по всем НДС", "X(20)")
     1920       .
     1921       if num-vats >= (if p-rv then 5 else 6) then do:
     1922         assign
     1923         v-only-excel = yes
     1924         .
     1925         message
     1926         "Общая ширина интересующих Вас колонок больше 198" skip
     1927         "отчет не уместится на бумаге формата А4 (ориентация альбомная)"
     1928         "Выводить только в Excel?"
     1929         view-as alert-box QUESTION buttons yes-no update glog.
     1930         if not glog then do:
     1931           run waitfram-hide in this-procedure .
     1932           return.
     1933         end.
     1934       end.
     1935       DEFINE FRAME OutFrame
     1936       HEADER
     1937       cur-time-print() AT 5 format "X(35)"
     1938       string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>>>>9" ) ) AT 70 format "X(23)" SKIP
     1939       Line format "X(195)" AT 1 skip
     1940       v-header format "X(195)" AT 1
     1941       with width 232 down stream-io.
     1942       FORM HEADER
     1943       Line format "X(195)" AT 1 SKIP
     1944       "Продолжение - на следующей странице" AT 60 SKIP
     1945       with FRAME BottomFrame width 232
     1946       PAGE-BOTTOM no-labels no-box.
     1947       run waitfram-show in this-procedure ("Ждите..." ).
     1948       run prn-lib-open-stream  in this-procedure (
     1949                                                   input parParentProc
     1950                                                   ,input 43
     1951                                                   ,input yes
     1952                                                   ,input no
     1953                                                   ).
     1954       assign
     1955       str3 = v-header-curr.
     1956       run rep/extitle.p (1).
     1957       run waitfram-show in this-procedure ("Ждите..." ).
     1958       find first buf1_sheetf no-lock where
     1959                 buf1_sheetf.sheet-num = 1 or buf1_sheetf.sheet-num = 0.
     1960       PUT stream PrnLibStream UNFORMATTED
     1961       "Суммы продаж с разбивкой по типам кассовых платежей и НДС"
     1962       format "x(50)" SKIP(1).
     1963       if p-rv then do:
     1964         PUT stream PrnLibStream UNFORMATTED
     1965         "Раздельно по чекам продажи и возврата"
     1966         format "x(50)" SKIP(1).
     1967       end.
     1968       PUT stream PrnLibStream UNFORMATTED
     1969       str1 skip
     1970       str2 skip
     1971       str4 skip
     1972       v-header-curr skip
     1973       .
     1974       PUT stream PrnLibStream UNFORMATTED
     1975       reportheader SKIP(0).
     1976       FORM with FRAME OutFrame.
     1977       VIEW STREAM PrnLibStream FRAME BottomFrame .
     1978       VIEW STREAM PrnLibStream FRAME OutFrame .
     1979       for each treal-vat no-lock where treal-vat.fact-order > 0
     1980       break
     1981       by treal-vat.fact-order
     1982       by treal-vat.inkas-code
     1983       by treal-vat.grp-code
     1984       :
     1985         if first-of(treal-vat.inkas-code) then do:
     1986           if not v-only-excel then do:
     1987              Put stream PrnLibStream unformatted
     1988              treal-vat.inkas-code format "X(16)" chr(32)
     1989              string(treal-vat.doc-date, "99/99/9999")
     1990              .
     1991           end.
     1992           if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end .
     1993           if Make-Excel then  put   stream ForExcel unformatted
     1994           treal-vat.inkas-code CHR(9)
     1995           treal-vat.doc-date   CHR(9)
     1996           .
     1997         end.
     1998         if first-of(treal-vat.grp-code) then do:
     1999           do iext = 1 to 3:
     2000             assign
     2001             accum-netto[iext] = 0
     2002             accum-netto-rubl[iext] = 0
     2003             v-first-found-vat = yes
     2004             .
     2005           end.
     2006               if p-group and treal-vat.grp-code      begins chr(4) then do:              find first buf_tt-cash-group no-lock where                                                                       buf_tt-cash-group.grp-code = treal-vat.grp-code no-error .                                        if available buf_tt-cash-group then do:                                                                  assign                                                                                                 f-cash-pay-name  = "Группа: " + buf_tt-cash-group.obj-name                                             .                                                                                                    end.                                                                                                   else do:                                                                                                 assign                                                                                                 f-cash-pay-name  = "Неизвестная группа касс.платежа"                                                   .                                                                                                    end.                                                                                                 end.                                                                                                   else do:                                                                                                 find first buf_cash-pay no-lock where                                                                            buf_cash-pay.cdpay-code = integer(entry(1, treal-vat.grp-code, chr(4)))                           AND buf_cash-pay.curr-code = integer(entry(2, treal-vat.grp-code, chr(4))) no-error .           if available buf_cash-pay then do:                                                                       assign                                                                                                 f-cash-pay-name = buf_cash-pay.obj-name                                                                .                                                                                                    end.                                                                                                   else do:                                                                                                 assign                                                                                                 f-cash-pay-name  = "Неизвестный тип. касс.платежа"                                                     .                                                                                                    end.                                                                                                 end.
     2007           if first-of(treal-vat.grp-code)
     2008           and (not p-rv  or v-first-found-vat  = yes)
     2009           then do:
     2010             if not v-only-excel then do:
     2011               put stream PrnLibStream unformatted
     2012               f-cash-pay-name at 29.
     2013             end.
     2014             if Make-Excel then  put   stream ForExcel unformatted
     2015             (if first-of(treal-vat.inkas-code ) then '':U else fill(CHR(9), 2))
     2016             f-cash-pay-name CHR(9)
     2017             .
     2018           end.
     2019           v-first-found-rv = yes.
     2020           do irv = irv-start to irv-end by -2:
     2021             assign
     2022             ii = 0
     2023             v-first-found-vat = yes
     2024             .
     2025             for each gen0_treal-vat no-lock where
     2026                     gen0_treal-vat.inkas-code = "":U
     2027                 AND gen0_treal-vat.grp-code = "":U
     2028                 AND gen0_treal-vat.rv = 0
     2029                 :
     2030               assign
     2031               ii = ii + 1
     2032               col-ii = col-trail + 20 * (ii - 1 )
     2033               .
     2034               find first buf_treal-vat no-lock where
     2035                     buf_treal-vat.inkas-code = treal-vat.inkas-code
     2036                 AND buf_treal-vat.grp-code   = treal-vat.grp-code
     2037                 AND buf_treal-vat.vat-pc     = gen0_treal-vat.vat-pc
     2038                 AND buf_treal-vat.rv         = irv
     2039                 no-error.
     2040               if available buf_treal-vat then do:
     2041                 if p-rv and v-first-found-vat then do:
     2042                                   if not v-only-excel then do:
     2043                     put stream PrnLibStream unformatted
     2044                     entry(lookup(string(irv), "1,-1,0"), " Расход,Возврат,Рас+Взвр") at col-fix.
     2045                     do jj = 1 to (ii - 1) :
     2046                       col-jj = col-trail + 20 * (jj - 1).
     2047                       put stream PrnLibStream unformatted
     2048                       string(0, "->>,>>>,>>>,>>9.99") at col-jj.
     2049                     end.
     2050                   end.
     2051                   if Make-Excel then  put   stream ForExcel unformatted
     2052                   (if v-first-found-rv
     2053                    then '':U
     2054                    else fill(CHR(9), 3)
     2055                    )
     2056                   entry(lookup(string(irv), "1,-1,0"), " Расход,Возврат,Рас+Взвр")
     2057                   CHR(9).
     2058                   do jj = 1 to (ii - 1) :
     2059                     if Make-Excel then  put   stream ForExcel unformatted
     2060                     0
     2061                     CHR(9)
     2062                     .
     2063                   end.
     2064                 end.
     2065                 assign
     2066                 v-first-found-vat = no
     2067                 accum-netto[2] = accum-netto[2] + buf_treal-vat.netto
     2068                 accum-netto-rubl[2] = accum-netto-rubl[2] + buf_treal-vat.netto-rubl
     2069                 .
     2070                 if buf_treal-vat.rv <> 0 then do:
     2071                   assign
     2072                   accum-netto[irv + 2] = accum-netto[irv + 2] + buf_treal-vat.netto
     2073                   accum-netto-rubl[irv + 2] = accum-netto-rubl[irv + 2] + buf_treal-vat.netto-rubl
     2074                   .
     2075                 end.
     2076                 if not v-only-excel then do:
     2077                   put stream PrnLibStream unformatted
     2078                   string(if v-rubl
     2079                         then buf_treal-vat.netto-rubl
     2080                         else buf_treal-vat.netto , "->>,>>>,>>>,>>9.99") at col-ii.
     2081                 end.
     2082                 if Make-Excel then  put   stream ForExcel unformatted
     2083                 (if v-rubl
     2084                 then buf_treal-vat.netto-rubl
     2085                 else buf_treal-vat.netto) CHR(9)
     2086                 .
     2087                 v-first-found-rv = no.
     2088               end.
     2089               else do:
     2090                 if not p-rv
     2091                 or v-first-found-vat = no  then do:
     2092                   if not v-only-excel then do:
     2093                     put stream PrnLibStream unformatted
     2094                     string(0, "->>,>>>,>>>,>>9.99") at col-ii.
     2095                   end.
     2096                   if Make-Excel then  put   stream ForExcel unformatted
     2097                   0
     2098                   CHR(9)
     2099                   .
     2100                 end.
     2101               end.
     2102             end.
     2103             assign
     2104             ii = ii + 1
     2105             col-ii = col-trail + 20 * (ii - 1)
     2106             .
     2107             if (not p-rv) or (v-first-found-vat = no) then do:
     2108               if not v-only-excel then do:
     2109                 put stream PrnLibStream unformatted
     2110                 string(if v-rubl
     2111                         then accum-netto-rubl[irv + 2]
     2112                         else accum-netto[irv + 2], "->>,>>>,>>>,>>9.99") at col-ii skip.
     2113               end.
     2114               if Make-Excel then  put   stream ForExcel unformatted
     2115               (if v-rubl
     2116               then accum-netto-rubl[irv + 2]
     2117               else accum-netto[irv + 2])
     2118               SKIP.
     2119               assign
     2120               ii-excel = ii-excel + 1
     2121               .
     2122             end.
     2123           end.
     2124         end.
     2125         if last-of(treal-vat.inkas-code) then do:
     2126           DOWN STREAM PrnLibStream
     2127           1 with FRAME OutFrame .
     2128           if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end .
     2129           if Make-Excel then  put   stream ForExcel unformatted skip.
     2130         end.
     2131       end.
     2132       if not v-only-excel then do:
     2133         DOWN STREAM PrnLibStream
     2134         1 with FRAME OutFrame .
     2135         Put stream PrnLibStream unformatted "Итого ПО ПРОДАЖАМ" .
     2136       end.
     2137       if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end .
     2138       if Make-Excel then  put   stream ForExcel unformatted
     2139       "Итого ПО ПРОДАЖАМ"
     2140       skip
     2141       CHR(9)
     2142       CHR(9)
     2143       .
     2144       for each pay_treal-vat no-lock where
     2145               pay_treal-vat.inkas-code = "":U
     2146           AND pay_treal-vat.grp-code <> "":U
     2147       break
     2148       by pay_treal-vat.fact-order
     2149       by pay_treal-vat.inkas-code
     2150       by pay_treal-vat.grp-code
     2151       by pay_treal-vat.rv :
     2152         if first-of(pay_treal-vat.grp-code) then do:
     2153           do iext = 1 to 3:
     2154             assign
     2155             accum-netto[iext] = 0
     2156             accum-netto-rubl[iext] = 0
     2157             .
     2158           end.
     2159           if p-group and pay_treal-vat.grp-code      begins chr(4) then do:              find first buf_tt-cash-group no-lock where                                                                       buf_tt-cash-group.grp-code = pay_treal-vat.grp-code no-error .                                        if available buf_tt-cash-group then do:                                                                  assign                                                                                                 f-cash-pay-name  = "Группа: " + buf_tt-cash-group.obj-name                                             .                                                                                                    end.                                                                                                   else do:                                                                                                 assign                                                                                                 f-cash-pay-name  = "Неизвестная группа касс.платежа"                                                   .                                                                                                    end.                                                                                                 end.                                                                                                   else do:                                                                                                 find first buf_cash-pay no-lock where                                                                            buf_cash-pay.cdpay-code = integer(entry(1, pay_treal-vat.grp-code, chr(4)))                           AND buf_cash-pay.curr-code = integer(entry(2, pay_treal-vat.grp-code, chr(4))) no-error .           if available buf_cash-pay then do:                                                                       assign                                                                                                 f-cash-pay-name = buf_cash-pay.obj-name                                                                .                                                                                                    end.                                                                                                   else do:                                                                                                 assign                                                                                                 f-cash-pay-name  = "Неизвестный тип. касс.платежа"                                                     .                                                                                                    end.                                                                                                 end.
     2160           do irv2 = 1 to num-entries(if p-rv then "1,-1,0" else "0"):
     2161             if not first-of(pay_treal-vat.inkas-code)
     2162             or irv2 > 1
     2163             then do:
     2164               if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end .
     2165               if Make-Excel then  put   stream ForExcel unformatted
     2166               CHR(9)
     2167               CHR(9)
     2168               .
     2169             end.
     2170             if not v-only-excel then do:
     2171               put stream PrnLibStream unformatted
     2172               f-cash-pay-name at 29.
     2173             end.
     2174             if Make-Excel then  put   stream ForExcel unformatted
     2175             f-cash-pay-name CHR(9)
     2176             .
     2177             assign
     2178             irv = integer(entry(irv2, (if p-rv then "1,-1,0" else "0"))).
     2179             assign
     2180             ii = 0
     2181             .
     2182             if p-rv then do:
     2183                           if not v-only-excel then do:
     2184                 put stream PrnLibStream unformatted
     2185                 entry(lookup(string(irv), "1,-1,0"), " Расход,Возврат,Рас+Взвр") at col-fix.
     2186               end.
     2187               if Make-Excel then  put   stream ForExcel unformatted
     2188               entry(lookup(string(irv), "1,-1,0"), " Расход,Возврат,Рас+Взвр")
     2189               CHR(9)
     2190               .
     2191             end.
     2192             for each gen0_treal-vat no-lock where
     2193                   gen0_treal-vat.inkas-code = "":U
     2194               AND gen0_treal-vat.grp-code = "":U
     2195               AND gen0_treal-vat.rv = 0:
     2196               find first buf_treal-vat no-lock where
     2197                     buf_treal-vat.inkas-code = "":U
     2198                 AND buf_treal-vat.grp-code   = pay_treal-vat.grp-code
     2199                 AND buf_treal-vat.vat-pc     = gen0_treal-vat.vat-pc
     2200                 AND buf_treal-vat.rv         = irv  no-error.
     2201               assign
     2202               ii = ii + 1
     2203               col-ii = col-trail + 20 * (ii - 1)
     2204               .
     2205               if available buf_treal-vat then do:
     2206                   assign
     2207                   accum-netto[irv + 2] = accum-netto[irv + 2] + buf_treal-vat.netto
     2208                   accum-netto-rubl[irv + 2] = accum-netto-rubl[irv + 2] + buf_treal-vat.netto-rubl
     2209                   .
     2210                 if not v-only-excel then do:
     2211                   put stream PrnLibStream unformatted
     2212                   string(if v-rubl
     2213                         then buf_treal-vat.netto-rubl
     2214                         else buf_treal-vat.netto, "->>,>>>,>>>,>>9.99") at col-ii.
     2215                 end.
     2216                 if Make-Excel then  put   stream ForExcel unformatted
     2217                 (if v-rubl
     2218                 then buf_treal-vat.netto-rubl
     2219                 else buf_treal-vat.netto)  CHR(9)
     2220                 .
     2221               end.
     2222               else do:
     2223                 if not v-only-excel then do:
     2224                   put stream PrnLibStream unformatted
     2225                   string(0, "->>,>>>,>>>,>>9.99") at col-ii.
     2226                 end.
     2227                               if Make-Excel then  put   stream ForExcel unformatted
     2228                 0  CHR(9)
     2229                 .
     2230               end.
     2231             end.
     2232             assign
     2233             ii = ii + 1
     2234             col-ii = col-trail + 20 * (ii - 1)
     2235             .
     2236             if not v-only-excel then do:
     2237               put stream PrnLibStream unformatted
     2238               string(if v-rubl
     2239                     then accum-netto-rubl[irv + 2]
     2240                     else accum-netto[irv + 2], "->>,>>>,>>>,>>9.99") at col-ii skip.
     2241             end.
     2242             if Make-Excel then  put   stream ForExcel unformatted
     2243             (if v-rubl
     2244             then accum-netto-rubl[irv + 2]
     2245             else accum-netto[irv + 2])
     2246             SKIP.
     2247             assign
     2248             ii-excel = ii-excel + 1
     2249             .
     2250           end.
     2251           if p-rv then do:
     2252             if not v-only-excel then do:
     2253               DOWN STREAM PrnLibStream
     2254               1 with FRAME OutFrame .
     2255             end.
     2256             if Make-Excel then  put   stream ForExcel unformatted
     2257             CHR(9)
     2258             SKIP.
     2259             assign
     2260             ii-excel = ii-excel + 1
     2261             .
     2262           end.
     2263         end.
     2264       end.
     2265       if not v-only-excel then do:
     2266         DOWN STREAM PrnLibStream
     2267         1 with FRAME OutFrame .
     2268         Put stream PrnLibStream unformatted "ИТОГО ПО ВСЕМ ПРОДАЖАМ И ТИПАМ ПЛАТЕЖЕЙ" .
     2269       end.
     2270       if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end .
     2271       if Make-Excel then  put   stream ForExcel unformatted
     2272       "ИТОГО ПО ВСЕМ" CHR(9)
     2273       "ПРОДАЖАМ" CHR(9)
     2274       "И ТИПАМ ПЛАТЕЖЕЙ"  CHR(9)
     2275       .
     2276       do iext = 1 to 3:
     2277         assign
     2278         accum-netto[iext] = 0
     2279         accum-netto-rubl[iext] = 0
     2280         .
     2281       end.
     2282       do irv2 = 1 to num-entries(if p-rv then "1,-1,0" else '0'):
     2283         ii = 0.
     2284         irv = integer(entry(irv2, if p-rv then "1,-1,0" else '0')).
     2285         if p-rv then do:
     2286           if not v-only-excel then do:
     2287                       put stream PrnLibStream unformatted
     2288             entry(lookup(string(irv), "1,-1,0"), " Расход,Возврат,Рас+Взвр") at col-fix
     2289             .
     2290           end.
     2291           if Make-Excel then  put   stream ForExcel unformatted
     2292           (if irv2 > 1
     2293            then fill(CHR(9), 3)
     2294            else '':U)
     2295            entry(lookup(string(irv), "1,-1,0"), " Расход,Возврат,Рас+Взвр") CHR(9).
     2296         end.
     2297         for each gen0_treal-vat no-lock where
     2298                 gen0_treal-vat.inkas-code = "":U
     2299             AND gen0_treal-vat.grp-code   = "":U
     2300             AND gen0_treal-vat.rv   = 0 :
     2301           find first gen_treal-vat no-lock where
     2302                     gen_treal-vat.inkas-code = ""
     2303                 AND gen_treal-vat.grp-code = ""
     2304                 AND gen_treal-vat.vat-pc = gen0_treal-vat.vat-pc
     2305                 AND gen_treal-vat.rv = irv no-error.
     2306           assign
     2307           ii = ii + 1
     2308           col-ii = col-trail + 20 * (ii - 1)
     2309           .
     2310           if available gen_treal-vat then do:
     2311             if not v-only-excel then do:
     2312               put stream PrnLibStream unformatted
     2313               string(if v-rubl
     2314                     then gen_treal-vat.netto-rubl
     2315                     else gen_treal-vat.netto, "->>,>>>,>>>,>>9.99") at col-ii.
     2316             end.
     2317             if Make-Excel then  put   stream ForExcel unformatted
     2318             (if v-rubl
     2319             then gen_treal-vat.netto-rubl
     2320             else gen_treal-vat.netto) CHR(9)
     2321             .
     2322             assign
     2323             accum-netto[irv + 2] = accum-netto[irv + 2] + gen_treal-vat.netto
     2324             accum-netto-rubl[irv + 2] = accum-netto-rubl[irv + 2] + gen_treal-vat.netto-rubl
     2325             .
     2326           end.
     2327           else do:
     2328             if not v-only-excel then do:
     2329               put stream PrnLibStream unformatted
     2330               string(0, "->>,>>>,>>>,>>9.99") at col-ii.
     2331             end.
     2332                       if Make-Excel then  put   stream ForExcel unformatted
     2333             0  CHR(9)
     2334             .
     2335           end.
     2336         end.
     2337         assign
     2338         ii  = ii + 1
     2339         col-ii = col-trail + 20 * (ii - 1)
     2340         .
     2341         if not v-only-excel then do:
     2342           put stream PrnLibStream unformatted
     2343           string(if v-rubl
     2344                 then accum-netto-rubl[irv + 2]
     2345                 else accum-netto[irv + 2], "->>,>>>,>>>,>>9.99") at col-ii.
     2346           if irv = 0 then do:
     2347             DOWN STREAM PrnLibStream
     2348             1 with FRAME OutFrame .
     2349           end.
     2350           else do:
     2351             put stream PrnLibStream unformatted skip.
     2352           end.
     2353         end.
     2354         if Make-Excel then  put   stream ForExcel unformatted
     2355         (if v-rubl
     2356         then accum-netto-rubl[irv + 2]
     2357         else accum-netto[irv + 2])
     2358         skip.
     2359       end.
     2360       HIDE STREAM PrnLibStream FRAME BottomFrame .
     2361       OUTPUT STREAM PrnLibStream CLOSE.
     2362       if Make-Excel then output stream ForExcel close.
     2363       run waitfram-hide in this-procedure .
     2364       if not v-only-excel then do:
     2365         run prn-lib-prn-file in this-procedure (
     2366                                                   input parParentProc
     2367                                                   ,input 8
     2368                                                   ).
     2369       end.
     2370       else do:
     2371         define variable v-report-name as character no-undo .
     2372         run prn-lib-get-report-name  in this-procedure(
     2373                                                        input parParentProc
     2374                                                       ,output v-report-name ) .
     2375         run rep/runexcel.p (v-report-name + ".txt").
     2376       end.
     2377     end.
     2378   end procedure.
     2379   procedure printproc-gds :
     2380   define variable v-gds-code like ub.goods.gds-code no-undo .
     2381   define variable f-artic like ub.goods.artic no-undo .
     2382   define variable f-gds-name like ub.goods.gds-name no-undo .
     2383   define variable f-prod-name like ub.clients.obj-name no-undo .
     2384   define variable f-cash-pay-name like ub.cash-pay.obj-name no-undo .
     2385   define variable f-grp-name like ub.goods.grp-name no-undo .
     2386   define variable f-sum-rubl as decimal no-undo .
     2387   define variable f-sum-base as decimal no-undo .
     2388   DEFINE VARIABLE Line                as      char    no-undo.
     2389   DEFINE VARIABLE date_string     as      char    no-undo.
     2390     do
     2391     on error undo, return error
     2392     :
     2393   DEFINE FRAME OutFrame
     2394   v-gds-code COLUMN-LABEL "Код товара"
     2395   f-artic  COLUMN-LABEL "Артикул"
     2396   f-gds-name COLUMn-LABEL "Название товара"  format "X(40)"
     2397   f-prod-name COLUMn-LABEL "Производитель" format "X(30)"
     2398   f-cash-pay-name COLUMn-LABEL "Тип касс.платежа" format "X(30)"
     2399   f-grp-name  COLUMn-LABEL "Группа" format "X(50)"
     2400   f-sum-rubl      COLUMn-LABEL "Сумма в руб." format "->>>,>>>,>>9.99"
     2401   f-sum-base      COLUMn-LABEL "Сумма в б.в." format "->>>,>>>,>>9.99"
     2402   HEADER
     2403   cur-time-print() AT 5 format "X(35)"
     2404   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>>>>9" ) ) AT 170 format "X(13)" SKIP
     2405   Line format "X(195)" AT 1
     2406   with width 232 down stream-io.
     2407   FORM HEADER
     2408   Line format "X(195)" AT 1 SKIP
     2409   "Продолжение - на следующей странице" AT 60 SKIP
     2410   with FRAME BottomFrame width 232
     2411   PAGE-BOTTOM no-labels no-box.
     2412   run waitfram-show in this-procedure ("Ждите..." ).
     2413   run prn-lib-open-stream  in this-procedure (
     2414                                               input parParentProc
     2415                                               ,input 43
     2416                                               ,input yes
     2417                                               ,input no
     2418                                               ).
     2419   run rep/extitle.p (1).
     2420   find first buf1_sheetf no-lock where buf1_sheetf.sheet-num = 1 or buf1_sheetf.sheet-num = 0.
     2421   PUT stream PrnLibStream UNFORMATTED
     2422   ("Разбивка товаров в чеке по типам кассовых платежей" +
     2423   string( x-date-start, "99/99/9999" ) + " по " + string(x-date-end, "99/99/9999") + ".")
     2424   format "x(110)" SKIP(1).
     2425   PUT stream PrnLibStream UNFORMATTED
     2426   str1 skip
     2427   str2 skip
     2428   str4 skip.
     2429   PUT stream PrnLibStream UNFORMATTED
     2430   reportheader SKIP(0).
     2431   VIEW STREAM PrnLibStream FRAME BottomFrame .
     2432   FORM with FRAME OutFrame.
     2433   for each treal-3 no-lock
     2434   break
     2435   by treal-3.gds-code
     2436   by treal-3.cpay-code
     2437   by treal-3.curr-code
     2438   by treal-3.is-pay
     2439   :
     2440     if ii-excel > 32000 then do:                                                               if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.                                                                          find first buf_sheetf where                                                                     buf_sheetf.sheet-num = ii-page + 1 no-error.                                if not available buf_sheetf then do:                                                    create buf_sheetf.                                                                  end.                                                                                  buffer-copy buf1_sheetf except sheet-num                                              to buf_sheetf                                                                         assign                                                                                buf_sheetf.sheet-num = ii-page + 1                                                    .                                                                                     run rep/extitle.p (ii-page) .                                                              assign                                                                                ii-page = ii-page + 1                                                                 ii-excel = 0                                                                          .                                                                                   end .
     2441     if first-of(treal-3.is-pay) then do:
     2442       find first buf_goods no-lock where
     2443                 buf_goods.gds-code = treal-3.gds-code.
     2444       find first buf_clients no-lock where
     2445                 buf_Clients.obj-type = buf_goods.prod-type
     2446             AND buf_Clients.obj-code = buf_goods.prod-code no-error .
     2447       assign
     2448       f-prod-name = buf_clients.obj-name
     2449       f-gds-name = buf_goods.gds-name
     2450       f-grp-name = buf_goods.grp-name
     2451       f-artic = buf_goods.artic
     2452       .
     2453       display stream PrnLibStream
     2454       treal-3.gds-code @ v-gds-code
     2455       f-artic
     2456       f-gds-name
     2457       f-prod-name
     2458       f-grp-name
     2459       treal-3.out-name @ f-cash-pay-name
     2460       treal-3.netto-rubl @ f-sum-rubl
     2461       treal-3.netto @ f-sum-base
     2462       with frame OutFrame.
     2463       DOWN STREAM PrnLibStream
     2464       1 with FRAME OutFrame .
     2465     end.
     2466     else do:
     2467       display stream PrnLibStream
     2468       treal-3.out-name @ f-cash-pay-name
     2469       treal-3.netto-rubl @ f-sum-rubl
     2470       treal-3.netto @ f-sum-base
     2471       with frame OutFrame.
     2472       DOWN STREAM PrnLibStream
     2473       1 with FRAME OutFrame .
     2474     end.
     2475     if Make-Excel then  put   stream ForExcel unformatted
     2476     treal-3.gds-code          CHR(9)
     2477     f-artic                   CHR(9)
     2478     f-gds-name                CHR(9)
     2479     f-prod-name               CHR(9)
     2480     f-grp-name                CHR(9)
     2481     treal-3.out-name          CHR(9)
     2482     treal-3.netto-rubl        CHR(9)
     2483     treal-3.netto             CHR(9)
     2484     skip.
     2485     assign
     2486     ii-excel = ii-excel + 1
     2487     .
     2488   end.
     2489   HIDE STREAM PrnLibStream FRAME BottomFrame .
     2490   OUTPUT STREAM PrnLibStream CLOSE.
     2491   if Make-Excel then output stream ForExcel close.
     2492   run waitfram-hide in this-procedure .
     2493   run prn-lib-prn-file in this-procedure (
     2494                                             input parParentProc
     2495                                             ,input 8
     2496                                             ).
     2497     end.
     2498   end procedure.
