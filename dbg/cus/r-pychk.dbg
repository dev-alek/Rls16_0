     1409               buf_inkas.doc-date  >= x-date-start
     1410           AND buf_inkas.doc-date  <= x-date-end
     1411           AND buf_inkas.obj-type   = obj-list.obj-type
     1412           AND buf_inkas.obj-code   = obj-list.obj-code
     1413           AND buf_inkas.status_     = 'факт':U:
     1414        run process-inkas in this-procedure (
     1415                         buffer buf_inkas
     1416                        ).
     1417      end.
     1418   END.
     1419   run waitfram-hide in this-procedure .
