     1363     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     1364       define variable v-answ as logical no-undo .
     1365       if ( p-unit-base-cli-eq = true
     1366            and p-density = 1.0
     1367          )
     1368         or ( p-unit-base-cli-eq = false
     1369              and p-density <> ?
     1370              and p-density > 0.0
     1371              and p-density < 1.0
     1372            )
     1373       then do:
     1374         assign
     1375           v-answ = true
     1376         .
     1377       end.
     1378       else do:
     1379         assign
     1380           v-answ = false
     1381         .
     1382       end.
     1383       return v-answ.
     1384     end function.
