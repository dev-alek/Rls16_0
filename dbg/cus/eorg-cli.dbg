     2192         end.
     2193       end.
     2194       if p-move-resize = true
     2195       then do:
     2196         run diasize_position-resize-button in this-procedure .
     2197       end.
     2198       if v-diasize-wndstore = true
     2199       then do:
     2200         if connected("ub") = true
     2201         then do:
     2202           define variable v-cntxt-db-num        as integer   no-undo .
     2203           define variable v-cntxt-userid        as character no-undo .
