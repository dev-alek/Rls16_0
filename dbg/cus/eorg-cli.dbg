     2584       end.
     2585       if v-diasize-wndstore = true
     2586       then do:
     2587         if connected("ub") = true
     2588         then do:
     2589           define variable v-cntxt-db-num        as integer   no-undo .
     2590           define variable v-cntxt-userid        as character no-undo .
     2591           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2592                                             , OUTPUT v-cntxt-userid
     2593                                             ) .
     2594           run gbl/wndsizew.p
     2595             (input  v-cntxt-db-num
     2596             ,input  v-cntxt-userid
     2597             ,input  v-diasize-proc-name
     2598             ,input  'width':u
