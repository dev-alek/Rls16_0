     2508           then do:
     2509             assign
     2510               v-object-handle :col = v-object-handle :col + p-change-value
     2511               no-error .
     2512             if error-status :error
     2513             or error-status :get-message(1) <> ""
     2514             then do:
     2515               undo move_block, retry move_block .
     2516             end.
     2517           end.
     2518         end.
     2519       end.
     2520       else do:
     2521         for each buf_temp-diasize-handle
     2522         on error undo move_block, retry move_block
     2523         :
     2524           assign
     2525             v-object-handle = buf_temp-diasize-handle.handle-value
     2526           .
     2527           if v-object-handle <> v-diasize-resize-button
     2528           then do:
     2529             assign
     2530               v-object-handle :col = v-object-handle :col + p-change-value
     2531               no-error .
     2532             if error-status :error
     2533             or error-status :get-message(1) <> ""
     2534             then do:
     2535               undo move_block, retry move_block .
     2536             end.
     2537           end.
     2538         end.
     2539         for each buf_temp-browse-handle
     2540           where buf_temp-browse-handle.browse-type = 'width':u
     2541         on error undo move_block, retry move_block
     2542         :
     2543           assign
     2544             buf_temp-browse-handle.browse-handle :width
     2545               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2546             no-error .
