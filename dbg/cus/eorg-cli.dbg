     2221   procedure diasize_set-height :
     2222     define input  parameter p-new-height  as decimal   no-undo .
     2223     define input  parameter p-move-resize as logical   no-undo .
     2224     do
     2225     on error undo, return error return-value
     2226     :
     2227       run diasize_change-height in this-procedure
     2228         (input  (p-new-height - frame Dialog-Frame :height)
     2229         ,input  p-move-resize
     2230         ) .
     2231     end.
     2232   end procedure.
     2233   procedure diasize_change-width :
     2234     define input  parameter p-change-value as decimal   no-undo .
     2235     define input  parameter p-move-resize  as logical   no-undo .
     2236     define variable v-field-group-handle   as handle    no-undo .
     2237     define variable v-object-handle        as handle    no-undo .
     2238     define variable v-frame-width          as decimal   no-undo .
     2239     define variable v-frame-virtual-width  as decimal   no-undo .
     2240     define variable v-browse-width         as decimal   no-undo .
     2241     define variable v-window-width         as decimal   no-undo .
     2242     define variable v-window-virtual-width as decimal   no-undo .
     2243     define variable v-change-sign          as integer   no-undo .
     2244     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2245     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2246     if p-change-value > 0
     2247     then do:
     2248       if frame Dialog-Frame :width + p-change-value >
     2249           session :width-chars
     2250       then do:
     2251         assign
     2252           p-change-value = session :width-chars - frame Dialog-Frame :width
     2253         .
     2254         if p-change-value <= 0
     2255         then do:
     2256           run diasize_position-resize-button in this-procedure .
     2257           return .
     2258         end.
     2259       end.
     2260     end.
     2261     if p-change-value < 0
     2262     then do:
     2263       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2264       then do:
     2265         assign
     2266           p-change-value = v-diasize-orig-frame-width
     2267                          - frame Dialog-Frame :width
     2268         .
     2269         if p-change-value >= 0
     2270         then do:
     2271           run diasize_position-resize-button in this-procedure .
     2272           return .
     2273         end.
     2274       end.
     2275     end.
     2276     if p-change-value >= 0
     2277     then do:
     2278       assign
     2279         v-change-sign = 1
     2280       .
     2281     end.
     2282     else do:
     2283       assign
     2284         v-change-sign = -1
     2285       .
     2286     end.
     2287     assign
     2288       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2289     .
     2290     if p-change-value = 0
     2291     then do:
     2292       run diasize_position-resize-button in this-procedure .
     2293       return .
     2294     end.
     2295     move_block:
     2296     do
     2297     on error undo move_block, leave move_block
     2298     :
     2299       if retry
     2300       then do:
     2301         do
     2302         on error undo move_block, leave move_block
     2303         :
     2304           if p-change-value > 0
     2305           then do:
     2306             for each buf_temp-diasize-handle
     2307             on error undo, next
     2308             :
     2309               assign
     2310                 v-object-handle = buf_temp-diasize-handle.handle-value
     2311               .
     2312               if v-object-handle <> v-diasize-resize-button
     2313               then do:
     2314                 assign
     2315                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2316                 .
     2317               end.
     2318             end.
     2319             assign
     2320               v-diasize-browse-handle :width = v-browse-width
     2321             .
     2322             for each buf_temp-browse-handle
     2323               where buf_temp-browse-handle.browse-type = 'width':u
     2324             on error undo, next
     2325             :
     2326               assign
     2327                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2328               .
     2329             end.
     2330             assign
     2331               frame Dialog-Frame :width = v-frame-width
     2332             .
     2333             if frame Dialog-Frame :scrollable = true
     2334             then do:
     2335               assign
     2336                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2337               .
     2338             end.
     2339             run diasize_position-resize-button in this-procedure .
     2340           end.
     2341           else do:
     2342             if frame Dialog-Frame :scrollable = true
     2343             then do:
     2344               assign
     2345                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2346               .
     2347             end.
     2348             assign
     2349               frame Dialog-Frame :width = v-frame-width
     2350             .
     2351             for each buf_temp-browse-handle
     2352               where buf_temp-browse-handle.browse-type = 'width':u
     2353             on error undo, next
     2354             :
     2355               assign
     2356                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2357               .
     2358             end.
     2359             assign
     2360               v-diasize-browse-handle :width = v-browse-width
     2361             .
