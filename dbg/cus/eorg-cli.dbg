     2420         :
     2421           if  v-object-handle <> v-diasize-browse-handle :handle
     2422           and v-object-handle <> v-diasize-resize-button
     2423           and can-query(v-object-handle, "row")
     2424           and can-query(v-object-handle, "height")
     2425           and ( v-object-handle :col + v-object-handle :width
     2426                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2427               )
     2428           then do:
     2429             find first buf_temp-browse-handle
     2430               where buf_temp-browse-handle.browse-type   = 'width':u
     2431                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2432               no-error .
     2433             if available buf_temp-browse-handle
     2434             then do:
     2435             end.
     2436             else do:
     2437               create buf_temp-diasize-handle .
     2438               assign
     2439                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2440                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2441               .
     2442             end.
     2443           end.
     2444           assign
     2445             v-object-handle = v-object-handle :next-sibling
     2446           .
     2447         end.
     2448         assign
     2449           v-field-group-handle = v-field-group-handle :next-sibling
     2450         .
     2451       end.
     2452       do with frame Dialog-Frame
     2453       :
     2454         hide v-diasize-resize-button .
     2455         v-diasize-resize-button :row = 1.
     2456         v-diasize-resize-button :column = 1.
     2457       end.
     2458       if p-change-value > 0
     2459       then do:
     2460         if frame Dialog-Frame :scrollable = true
     2461         then do:
     2462           assign
     2463             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2464             no-error .
     2465           if error-status :error
     2466           or error-status :get-message(1) <> ""
     2467           then do:
     2468             undo move_block, retry move_block.
     2469           end.
     2470         end.
     2471         assign
     2472           frame Dialog-Frame :width = v-frame-width + p-change-value
     2473           no-error .
     2474         if error-status :error
     2475         or error-status :get-message(1) <> ""
     2476         then do:
     2477           undo move_block, retry move_block.
     2478         end.
     2479         assign
     2480           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2481         no-error .
     2482         if error-status :error
     2483         or error-status :get-message(1) <> ""
     2484         then do:
     2485           undo move_block, retry move_block.
     2486         end.
     2487         for each buf_temp-browse-handle
     2488           where buf_temp-browse-handle.browse-type = 'width':u
     2489         on error undo move_block, retry move_block
     2490         :
     2491           assign
     2492             buf_temp-browse-handle.browse-handle :width
     2493               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2494             no-error .
     2495           if error-status :error
     2496           or error-status :get-message(1) <> ""
     2497           then do:
     2498             undo move_block, retry move_block .
     2499           end.
     2500         end.
     2501         for each buf_temp-diasize-handle
     2502         on error undo move_block, retry move_block
     2503         :
