     2557         or error-status :get-message(1) <> ""
     2558         then do:
     2559           undo move_block, retry move_block.
     2560         end.
     2561         assign
     2562           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2563         no-error .
     2564         if error-status :error
