     2602       end.
     2603     end.
     2604     assign
     2605       v-diasize-change-size = false
     2606     .
     2607   end procedure.
     2608   procedure diasize_set-width :
     2609     define input  parameter p-new-width  as decimal   no-undo .
     2610     define input  parameter p-move-resize as logical   no-undo .
     2611     do
     2612     on error undo, return error return-value
     2613     :
     2614       run diasize_change-width in this-procedure
     2615         (input  (p-new-width - frame Dialog-Frame :width)
     2616         ,input  p-move-resize
     2617         ) .
     2618     end.
     2619   end procedure.
     2620   procedure diasize_position-resize-button :
     2621     do with frame Dialog-Frame
     2622     :
     2623       hide v-diasize-resize-button .
     2624       assign
     2625         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2626                     - 1
     2627                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2628         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2629                     - 1
     2630                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2631       .
     2632       view v-diasize-resize-button .
     2633     end.
     2634   end procedure.
     2635   on alt-right anywhere
     2636   do:
     2637     run diasize_change-width in this-procedure
     2638       (input 1
     2639       ,input true
     2640       ) .
     2641     return no-apply .
     2642   end.
     2643   on alt-left anywhere
     2644   do:
     2645     run diasize_change-width in this-procedure
     2646       (input -1
     2647       ,input true
     2648       ) .
     2649     return no-apply .
     2650   end.
     2651   on alt-down anywhere
     2652   do:
     2653     run diasize_change-height in this-procedure
     2654       (input 1
     2655       ,input true
     2656       ) .
     2657     return no-apply .
     2658   end.
     2659   on alt-up anywhere
     2660   do:
     2661     run diasize_change-height in this-procedure
     2662       (input -1
     2663       ,input true
     2664       ) .
     2665     return no-apply .
     2666   end.
     2667   on alt-enter of frame Dialog-Frame
     2668   do:
     2669     run diasize_maximize in this-procedure
     2670       (input  ?
     2671       ).
     2672     return no-apply .
     2673   end.
     2674   procedure diasize_end-move :
     2675     do
     2676     on error undo, return error return-value
     2677     :
     2678       define variable v-row-delta as decimal   no-undo .
     2679       define variable v-col-delta as decimal   no-undo .
     2680       define variable v-new-row as decimal   no-undo .
     2681       define variable v-new-col as decimal   no-undo .
     2682       assign
     2683         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2684         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2685       .
     2686       assign
     2687         v-row-delta = v-new-row - frame Dialog-Frame :height
     2688         v-col-delta = v-new-col - frame Dialog-Frame :width
     2689       .
     2690       run diasize_change-height in this-procedure
     2691         (input v-row-delta
     2692         ,input true
     2693         ) .
     2694       run diasize_change-width in this-procedure
     2695         (input v-col-delta
     2696         ,input true
     2697         ) .
     2698     end.
     2699   end procedure.
     2700   procedure diasize_maximize :
     2701     define input  parameter p-action as logical   no-undo .
     2702     do
     2703     on error undo, return error return-value
     2704     :
     2705       if p-action = ?
     2706       then do:
     2707         if v-diasize-need-maximize = true
     2708         then do:
     2709           assign
     2710             p-action = true
     2711           .
     2712         end.
     2713         else do:
     2714           assign
     2715             p-action = false
     2716           .
     2717         end.
     2718       end.
     2719       if p-action = true
     2720       then do:
     2721         run diasize_change-height in this-procedure
     2722           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2723               - frame Dialog-Frame :height-chars
     2724           ,input true
     2725           ) .
     2726         run diasize_change-width in this-procedure
     2727           (input session :width-chars
     2728               - frame Dialog-Frame :width-chars
     2729           ,input true
     2730           ) .
     2731         assign
     2732           v-diasize-need-maximize = false
     2733         .
     2734       end.
     2735       else do:
     2736         run diasize_change-width in this-procedure
     2737           (input v-diasize-orig-frame-width
     2738               - frame Dialog-Frame :width-chars
     2739           ,input true
     2740           ) .
     2741         run diasize_change-height in this-procedure
     2742           (input v-diasize-orig-frame-height
     2743               - frame Dialog-Frame :height-chars
     2744           ,input true
     2745           ) .
     2746         assign
     2747           v-diasize-need-maximize = true
     2748         .
     2749       end.
     2750     end.
     2751   end procedure.
     2752   procedure diasize_restore-orig-size :
     2753     do
     2754     on error undo, return error return-value
     2755     :
     2756       assign
     2757         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2758         v-diasize-current-frame-height = frame Dialog-Frame :height
     2759       .
     2760       run diasize_set-height in this-procedure
     2761         (input  v-diasize-orig-frame-height
     2762         ,input  true
     2763         ) .
     2764       run diasize_set-width in this-procedure
     2765         (input  v-diasize-orig-frame-width
     2766         ,input  true
     2767         ) .
     2768     end.
     2769   end procedure.
     2770   procedure diasize_restore-current-size :
     2771     do
     2772     on error undo, return error return-value
     2773     :
     2774       run diasize_set-height in this-procedure
     2775         (input  v-diasize-current-frame-height
     2776         ,input  true
     2777         ) .
     2778       run diasize_set-width in this-procedure
     2779         (input  v-diasize-current-frame-width
     2780         ,input  true
     2781         ) .
     2782     end.
     2783   end procedure.
     2784   procedure diasize_set-browse-handle :
     2785     define input  parameter p-browse-handle as handle   no-undo .
     2786     define buffer buf_temp-browse-handle for temp-browse-handle .
     2787     do
     2788     on error undo, return error return-value
     2789     :
     2790       assign
     2791         v-diasize-browse-handle = p-browse-handle
     2792       .
     2793       for each buf_temp-browse-handle
     2794       on error undo, return error return-value
     2795       :
     2796         delete buf_temp-browse-handle .
     2797       end.
     2798     end.
     2799   end procedure.
     2800   procedure diasize_add_browse :
     2801     define input  parameter p-browse-type   as character no-undo .
     2802     define input  parameter p-browse-handle as handle    no-undo .
     2803     define buffer buf_temp-browse-handle for temp-browse-handle .
     2804     do
     2805     on error undo, return error return-value
     2806     :
     2807       assign
     2808         v-diasize-browse-number = v-diasize-browse-number + 1
     2809       .
     2810       create buf_temp-browse-handle .
     2811       assign
     2812         buf_temp-browse-handle.browse-type   = p-browse-type
     2813         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2814         buf_temp-browse-handle.browse-handle = p-browse-handle
     2815       .
     2816     end.
     2817   end procedure.
     2818   procedure diasize_init :
     2819     define variable v-default-value    as logical   no-undo .
     2820     define variable v-restore-saved    as logical   no-undo .
     2821     define variable v-resize-value-str as character no-undo .
     2822     do
     2823     on error undo, return error return-value
     2824     :
     2825       do with frame Dialog-Frame
     2826       :
     2827         assign
     2828           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2829           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2830           v-diasize-browse-handle     = browse br-ext-contragent :handle
     2831         .
     2832         create button v-diasize-resize-button
     2833         assign
     2834           parent        = frame Dialog-Frame :first-child
     2835           label         = "s"
     2836           height-pixels = 16
     2837           width-pixels  = 16
     2838           visible       = true
     2839           sensitive     = true
     2840           movable       = true
     2841           triggers:
     2842             on end-move persistent run diasize_end-move in this-procedure .
     2843           end triggers.
     2844         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2845         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2846         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2847         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2848         assign
     2849           v-diasize-wndmax = false
     2850         .
     2851         if connected("ub") = true
     2852         then do:
     2853           define variable v-cntxt-db-num        as integer   no-undo .
     2854           define variable v-cntxt-userid        as character no-undo .
     2855           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2856                                             , OUTPUT v-cntxt-userid
     2857                                             ) .
     2858           run gbl/wndpar_r.p
     2859             (input  v-cntxt-db-num
     2860             ,input  v-cntxt-userid
     2861             ,input  'wndmax':U
     2862             ,output v-diasize-wndmax
     2863             ,output v-default-value
     2864             ) .
     2865         end.
     2866         assign
     2867           v-diasize-wndstore = false
     2868         .
     2869         if connected("ub") = true
     2870         then do:
     2871           run gbl/wndpar_r.p
     2872             (input  v-cntxt-db-num
     2873             ,input  v-cntxt-userid
     2874             ,input  'wndstore':U
     2875             ,output v-diasize-wndstore
     2876             ,output v-default-value
     2877             ) .
     2878         end.
     2879         assign
     2880           v-diasize-proc-name = entry(1, program-name(2), '.')
     2881         .
     2882         if v-diasize-wndstore = true
     2883         then do:
     2884           assign
     2885             v-restore-saved = false
     2886           .
     2887           if connected("ub") = true
     2888           then do:
     2889             run gbl/wndsizer.p
     2890               (input  v-cntxt-db-num
     2891               ,input  v-cntxt-userid
     2892               ,input  v-diasize-proc-name
     2893               ,input  'height':u
     2894               ,output v-resize-value-str
     2895               ) .
     2896             if v-resize-value-str <> '':U
     2897             then do:
     2898               run diasize_change-height in this-procedure
     2899                 (input  integer(v-resize-value-str)
     2900                 ,input  true
     2901                 ) .
     2902               assign
     2903                 v-restore-saved = true
     2904               .
     2905             end.
     2906           end.
     2907           if connected("ub") = true
     2908           then do:
     2909             run gbl/wndsizer.p
     2910               (input  v-cntxt-db-num
     2911               ,input  v-cntxt-userid
     2912               ,input  v-diasize-proc-name
     2913               ,input  'width':u
     2914               ,output v-resize-value-str
     2915               ) .
     2916             if v-resize-value-str <> '':U
     2917             then do:
     2918               run diasize_change-width in this-procedure
     2919                 (input  integer(v-resize-value-str)
     2920                 ,input  true
     2921                 ) .
     2922               assign
     2923                 v-restore-saved = true
     2924               .
     2925             end.
     2926           end.
     2927           if v-restore-saved <> true
     2928           then do:
     2929             if v-diasize-wndmax = true
     2930             then do:
     2931               run diasize_maximize in this-procedure
     2932                 (input  true
     2933                 ) .
     2934             end.
     2935           end.
     2936         end.
     2937         else do:
     2938           if v-diasize-wndmax = true
     2939           then do:
     2940             run diasize_maximize in this-procedure
     2941               (input  true
     2942               ) .
     2943           end.
     2944         end.
     2945       end.
     2946     end.
     2947   end procedure.
     2948   procedure diasize_need-full-display :
     2949     define output parameter p-need-full-display as logical   no-undo .
     2950     do
     2951     on error undo, return error return-value
     2952     :
     2953       assign
     2954         p-need-full-display = v-diasize-need-full-display
     2955       .
     2956       assign
     2957         v-diasize-need-full-display = false
     2958       .
     2959     end.
     2960   end procedure.
     2961   procedure get-context :
     2962      define output parameter p-db-num as integer          no-undo.
     2963      define output parameter p-user-id as character        no-undo.
     2964      define variable v-login               as character    no-undo.
     2965      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2966      define buffer buf_user-login  for ub.user-login .
     2967      do
     2968      on error undo, return error
     2969      :
     2970            FIND FIRST buf_sys-ctrl no-lock.
     2971            ASSIGN
     2972               v-login = USERID("ub")
     2973               p-db-num = buf_sys-ctrl.db-num
     2974            .
     2975            FIND FIRST buf_user-login
     2976                 WHERE buf_user-login.db-num = p-db-num
     2977                   AND buf_user-login.user-login = v-login
     2978                 no-lock
     2979                 no-error
     2980                 .
     2981            IF AVAILABLE buf_user-login
     2982            THEN DO:
     2983               assign
     2984                  p-user-id = buf_user-login.user-id
     2985               .
     2986            END.
     2987      end.
     2988   end procedure.
     2989       run diasize_init in this-procedure .
     2990   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2991   procedure set-filter-name :
     2992   define input parameter p-filter-name as character no-undo .
     2993     do with frame Dialog-Frame:
     2994       if p-filter-name > "" then do:
     2995         assign
     2996           frame Dialog-Frame:title
     2997             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2998         .
     2999         assign
     3000           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3001         .
     3002       end.
     3003       else do:
     3004         assign
     3005           b-sch :tooltip = ""
     3006         .
     3007       end.
     3008     end.
     3009   end procedure.
     3010   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3011   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3012     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3013     return no-apply.
     3014   end.
     3015   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3016   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3017     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3018     return no-apply.
     3019   end.
     3020   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3021   on F8 of frame Dialog-Frame anywhere do:
     3022     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3023     return no-apply.
     3024   end.
     3025   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3026   on INS of frame Dialog-Frame anywhere do:
     3027     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3028     return no-apply.
     3029   end.
     3030   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3031   on F2 of frame Dialog-Frame anywhere do:
     3032     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3033     return no-apply.
     3034   end.
     3035   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3036   on F2 of frame Dialog-Frame anywhere do:
     3037     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3038     return no-apply.
     3039   end.
     3040   MAIN-BLOCK:
     3041   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3042      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3043   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3044     run mainmenu_getcntxt in parparentproc
     3045       (output v-cntxt-db-num
     3046       ,output v-cntxt-userid
     3047       ,output v-cntxt-level
     3048       ,output v-cntxt-host-code-obj
     3049       ,output v-cntxt-obj-type
     3050       ,output v-cntxt-obj-code
     3051       ,output v-cntxt-db-num-obj
     3052       ,output v-cntxt-is-admin
     3053       ) .
     3054     case p-list-mode:
     3055       when 'все':U then do:
     3056       end.
     3057       otherwise do:
     3058          message
     3059          substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3060          view-as alert-box error.
     3061          undo, return error .
     3062       end.
     3063     end.
     3064     v-rid-list = p-rid-list.
     3065     RUN Myenable.
     3066     WAIT-FOR GO OF FRAME Dialog-Frame.
     3067   END.
     3068   RUN disable_UI.
     3069   PROCEDURE disable_UI :
     3070     HIDE FRAME Dialog-Frame.
     3071   END PROCEDURE.
     3072   PROCEDURE enable_UI :
     3073     DISPLAY mark-num
     3074         WITH FRAME Dialog-Frame.
     3075     ENABLE b-quit B-mark B-sel b-add b-del b-cli b-sch b-print B-Help
     3076            br-ext-contragent mark-num fill-in-code-th fill-in-code-system
     3077         WITH FRAME Dialog-Frame.
     3078     VIEW FRAME Dialog-Frame.
     3079     OPEN QUERY br-ext-contragent FOR EACH X_ext-classif NO-LOCK,        FIRST X_clients NO-LOCK INDEXED-REPOSITION.
     3080   END PROCEDURE.
     3081   PROCEDURE MyEnable :
     3082   ENABLE
     3083   b-quit
     3084   b-cli
     3085   b-print
     3086   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3087   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0 and not transaction)
     3088   b-sch
     3089   B-Help
     3090   br-ext-contragent
     3091   fill-in-code-th
     3092   fill-in-code-system
     3093   WITH FRAME Dialog-Frame.
     3094   VIEW FRAME Dialog-Frame.
     3095   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3096   END PROCEDURE.
     3097   PROCEDURE OpenBr :
     3098   define input  parameter p-open-query     as logical   no-undo .
     3099   define input  parameter p-find-next      as logical   no-undo .
     3100   define input  parameter p-find-condition as character no-undo .
     3101   define variable sort-column-phrase as character no-undo .
     3102   define variable l-query-was-opened as logical no-undo .
     3103   define variable title0 as character no-undo .
     3104   define buffer buf_clients for ub.clients.
     3105   case sort-column-name :
     3106     when "" then do:
     3107       assign
     3108         sort-column-phrase = ""
     3109       .
     3110     end.
     3111     otherwise do:
     3112       assign
     3113         sort-column-phrase = "by " + sort-column-name
     3114       .
     3115     end.
     3116   end case.
     3117   filter-point = filter-point0 + p-list-mode .
     3118   case p-list-mode:
     3119    when 'все':U then do:
     3120     title0 = "Коды соответствия контрагентов".
     3121     ASSIGN
     3122     frame Dialog-Frame:title = substitute("&1", title0)
     3123     filter-label = SUBSTITUTE("&1"
     3124                               , frame Dialog-Frame:title
     3125                               )
     3126     .
     3127   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3128   define variable  l-disable-where-27  as logical   no-undo .
     3129   define variable  l-filter-open-27    as logical   .
     3130   define variable  flt-rec-27       as recid     no-undo .
     3131   define variable  filter-name-27      as character no-undo .
     3132   define variable  where-phrase-27     as character no-undo .
     3133   define variable  sort-phrase-27      as character no-undo .
     3134   define variable  where-phrase-rus-27 as character no-undo .
     3135   define variable  sort-phrase-rus-27  as character no-undo .
     3136   run gbl/flt-get.p
     3137     (input filter-point
     3138     ,output flt-rec-27
     3139     ,output filter-name-27
     3140     ,output where-phrase-27
     3141     ,output sort-phrase-27
     3142     ,output where-phrase-rus-27
     3143     ,output sort-phrase-rus-27
     3144     ).
     3145       run set-filter-name in this-procedure
     3146         (INPUT filter-name-27
     3147         ) no-error .
     3148     assign
     3149       l-filter-open-27 = false
     3150     .
     3151     if flt-rec-27 <> ?
     3152       or sort-column-phrase > ""
     3153     then do:
     3154       define variable  parameter-2-27 as character no-undo .
     3155       define variable  parameter-3-27 as character no-undo .
     3156       define variable  parameter-4-27 as character no-undo .
     3157       define variable  parameter-5-27 as character no-undo .
     3158       define variable  parameter-6-27 as character no-undo .
     3159       define variable  parameter-7-27 as character no-undo .
     3160         assign
     3161         parameter-3-27 =
     3162                                 "FOR EACH X_ext-classif"
     3163         parameter-4-27 =
     3164           (
     3165             if (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'code_org_client':U" + " " + where-phrase-27) <> ""
     3166             then  substitute('X_ext-classif.classif-subject = &1&2&1                           and X_ext-classif.classif-name = &1&3&1', chr(34), 'clients':U, 'code_org_client':U) + " " + where-phrase-27
     3167             else "true"
     3168           )
     3169         parameter-5-27 = (" " + "" + " " + substitute(', FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))'))
     3170         parameter-6-27 = if sort-phrase-27 = ''
     3171                              then
     3172           (
     3173           " " + "  " +
     3174             " " + sort-column-phrase +
     3175           " " + "  "
     3176           )
     3177                              else
     3178           (
     3179           " " + "  " +
     3180             " " + sort-column-phrase +
     3181           " " + sort-phrase-27
     3182           )
     3183         parameter-7-27 =
     3184           " INDEXED-REPOSITION  "
     3185       .
     3186       do
     3187       on stop undo, leave
     3188       on error undo, leave
     3189       :
     3190         assign
     3191           l-disable-where-27 =
     3192             (" X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'code_org_client':U" + " " + where-phrase-27 = "")
     3193         .
     3194         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3195                             ,input QUERY br-ext-contragent:handle
     3196                             ,input parameter-3-27
     3197                             ,input parameter-4-27
     3198                             ,input parameter-5-27
     3199                             ,input parameter-6-27
     3200                             ,input parameter-7-27
     3201                             )
     3202         .
     3203         assign
     3204           l-filter-open-27 = true
     3205         .
     3206       end.
     3207       if l-filter-open-27 = false then do:
     3208         message
     3209           "Ошибка при фильтрации / сортировке" skip
     3210           "Будут показаны записи без учета фильтра" skip
     3211           view-as alert-box .
     3212       end.
     3213       else do:
     3214           assign
     3215             l-query-was-opened = true
     3216           .
     3217       end.
     3218     end.
     3219     if l-filter-open-27 = false then do:
     3220       OPEN QUERY br-ext-contragent FOR EACH X_ext-classif
     3221         where  X_ext-classif.classif-subject = 'clients':U                           and X_ext-classif.classif-name = 'code_org_client':U
     3222       , FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))
     3223         INDEXED-REPOSITION
     3224     .
     3225         assign
     3226           l-query-was-opened = true
     3227         .
     3228     end.
     3229    end.
     3230   end case.
     3231   APPLY "entry" TO br-ext-contragent.
     3232   if available X_ext-classif then do:
     3233       APPLY "VALUE-CHANGED":U to br-ext-contragent.
     3234   END.
     3235   END PROCEDURE.
     3236   PROCEDURE proc-b-add :
     3237   DEFINE VARIABLE v-obj-type AS CHARACTER NO-UNDO.
     3238   define variable v-obj-code as integer no-undo .
     3239   DEFINE VARIABLE v-ext-obj-type AS CHARACTER NO-UNDO.
     3240   define variable v-ext-obj-code as integer no-undo .
     3241   DEFINE VARIABLE v-ok AS logical NO-UNDO.
     3242   define variable v-uniq-key-rec as character no-undo .
     3243   define variable v-rid as recid no-undo .
     3244   define buffer buf_db for ub.db .
     3245   define buffer buf_clients for ub.clients.
     3246   run ref\cli-eadd.w( parparentproc
     3247                     , output v-obj-type
     3248                     , output v-obj-code
     3249                     , output v-ext-obj-type
     3250                     , output v-ext-obj-code
     3251                     , output v-ok
     3252                     ).
     3253   if v-ok then do:
     3254     find first buf_clients no-lock
     3255       where buf_clients.obj-type = v-obj-type
     3256         and buf_clients.obj-code = v-obj-code
     3257       no-error.
     3258     if not avail buf_clients then do:
     3259       message
     3260         substitute( "Не возможно найти клиента &1 &2", v-obj-type, string( v-obj-code ) )
     3261         view-as alert-box error .
     3262       undo, return error .
     3263     end.
     3264     run gen-key-rec IN THIS-PROCEDURE
     3265       ( input 'clients':U
     3266        ,input (buffer buf_clients:handle)
     3267        ,output v-uniq-key-rec ).
     3268     run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     3269                         ,INPUT NO
     3270                         ,INPUT-OUTPUT v-rid
     3271                         ,INPUT 'clients':U
     3272                         ,INPUT 'code_org_client':U
     3273                         ,input  (-1)
     3274                         ,input v-obj-code
     3275                         ,input v-ext-obj-code
     3276                         ,input 0
     3277                         ,input v-obj-type
     3278                         ,input v-ext-obj-type
     3279                         ,input ""
     3280                         ,input (if buf_clients.obj-type = 'орг':U then 1000000000 else 0) + buf_clients.obj-code
     3281                         ,input v-uniq-key-rec ) no-error.
     3282     if error-status:error then do:
     3283       undo, return error .
     3284     end.
     3285   end.
     3286   if v-rid <> ? then do:
     3287     run openbr in this-procedure ( input yes, input no, input '':U).
     3288     reposition br-ext-contragent to recid v-rid no-error .
     3289     apply "entry" to br-ext-contragent in frame Dialog-Frame .
     3290   end.
     3291   END PROCEDURE.
     3292   PROCEDURE proc-b-del :
     3293   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3294   DEFINE VARIABLE glog AS logical NO-UNDO.
     3295   IF NOT AVAILABLE X_ext-classif THEN UNDO, RETURN ERROR.
     3296   v-rec = recid(X_ext-classif).
     3297   MESSAGE
     3298   "Вы действительно хотитет удалить эту запись?"
     3299   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3300   IF NOT glog THEN RETURN ERROR.
     3301   run ref/extclas3.p ( INPUT NO
     3302                       ,INPUT v-rec) NO-ERROR.
     3303   if not error-status:error then do:
     3304     run openbr in this-procedure ( input yes, input no, input '':U).
     3305     reposition br-ext-contragent to row 1 no-error .
     3306     apply "entry" to br-ext-contragent in frame Dialog-Frame .
     3307   end.
     3308   END PROCEDURE.
     3309   PROCEDURE proc-b-print :
     3310   DEFINE VARIABLE date_string              as   character no-undo .
     3311   DEFINE VARIABLE Line                     as   character no-undo .
     3312   DEFINE VARIABLE for-time                 as   character no-undo .
     3313   DEFINE VARIABLE accum-count              as   integer   no-undo .
     3314   define variable v-rid                    as   recid no-undo .
     3315   DEFINE VARIABLE v-firm-name AS CHARACTER NO-UNDO.
     3316   DEFINE FRAME list1
     3317   X_ext-classif.CharKey_One COLUMN-LABEL "Тип!клиента" FORMAT "X(3)"
     3318   X_ext-classif.KEY#_one  COLUMN-LABEL "Код!клиента" FORMAT ">>>>9"
     3319   X_clients.obj-name COLUMN-LABEL "Название клиента" FORMAT "X(45)"
     3320   X_ext-classif.CharKey_two COLUMN-LABEL "Тип!контрагента" FORMAT "X(3)"
     3321   X_ext-classif.KEY#_two COLUMN-LABEL "Код!контрагента" FORMAT ">>>>>>9"
     3322   v-firm-name COLUMN-LABEL "Название контрагента" FORMAT "X(45)"
     3323   HEADER  date_string AT 5 format "X(35)"
     3324   string( "Страница " ) format "X(9)" AT 75 PAGE-NUMBER(PrnLibStream) AT 85 FORMAT ">>9" SKIP
     3325   Line format "X(131)" AT 1
     3326   with width 232 down stream-io use-text    .
     3327   Line = fill("-", 131).
     3328   date_string = cur-time-print() .
     3329   run prn-lib-open-stream  in this-procedure (
     3330                                                input parParentProc
     3331                                               ,input  62
     3332                                               ,input yes
     3333                                               ,input no
     3334                                               ).
     3335   PUT  STREAM PrnLibStream
     3336   SPACE(25) ( frame Dialog-Frame:title )
     3337   format "x(131)" SKIP(1) .
     3338   FORM HEADER
     3339   Line format "X(131)" AT 1 SKIP
     3340   "Продолжение - на следующей странице" AT 30 SKIP
     3341   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3342   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3343   v-rid = recid(X_ext-classif).
     3344   FORM with FRAME List1.
     3345   run waitfram-show in this-procedure ( input "Ждите...").
     3346   DO WHILE available X_ext-classif :
     3347      GET prev br-ext-contragent.
     3348   END.
     3349   GET next br-ext-contragent.
     3350   DO WHILE available X_ext-classif :
     3351     v-firm-name = get-client-name(X_ext-classif.key#_two,X_ext-classif.CharKey_two).
     3352     Display STREAM PrnLibStream
     3353     X_ext-classif.CharKey_One
     3354     X_ext-classif.KEY#_one
     3355     X_clients.obj-name
     3356     X_ext-classif.CharKey_two
     3357     X_ext-classif.KEY#_two
     3358     v-firm-name
     3359     with FRAME List1.
     3360     DOWN STREAM PrnLibStream
     3361     1
     3362     with FRAME List1.
     3363     assign
     3364     accum-count = accum-count + 1
     3365     .
     3366     GET next br-ext-contragent.
     3367   END.
     3368   UNDERLINE  STREAM PrnLibStream
     3369   X_ext-classif.CharKey_One
     3370   X_ext-classif.KEY#_one
     3371   X_clients.obj-name
     3372   X_ext-classif.CharKey_two
     3373   X_ext-classif.KEY#_two
     3374   v-firm-name
     3375   with FRAME List1.
     3376   DISPLAY STREAM PrnLibStream
     3377   accum-count @ X_ext-classif.key#_one
     3378   with frame List1.
     3379   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3380   HIDE  STREAM PrnLibStream FRAME List1.
     3381   output  STREAM PrnLibStream CLOSE.
     3382   reposition br-ext-contragent to recid v-rid no-error .
     3383   apply "ENTRY" to br-ext-contragent in frame Dialog-Frame .
     3384   run waitfram-hide in this-procedure .
     3385   run prn-lib-prn-file in this-procedure (
     3386                                             input parParentProc
     3387                                             ,input 0
     3388                                             ).
     3389   END PROCEDURE.
     3390   PROCEDURE proc-b-sch :
     3391   define variable v-ri as recid no-undo .
     3392   assign
     3393   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     3394   .
     3395   assign
     3396   tbl = 'ext-classif':U
     3397   join-tbl = 'X_ext-classif'
     3398   fld = ""
     3399   lab = ""
     3400   spr = ""
     3401   dim = '0'
     3402   .
     3403   run fltfield-add in this-procedure('key#_one', 'Код Фирмы', '',
     3404   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3405   DO on stop undo, leave:
     3406       run gbl/filter.w ( INPUT parparentproc
     3407                    ,INPUT filter-point + chr(4) + filter-label
     3408                    ,INPUT tbl
     3409                    ,INPUT join-tbl
     3410                    ,INPUT fld
     3411                    ,INput lab
     3412                    ,INPUT spr
     3413                    ,INPUT  dim).
     3414       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3415       if v-ri <> ? then do:
     3416         reposition br-ext-contragent to recid v-ri no-error.
     3417       end.
     3418       APPLY "ENTRY" to br-ext-contragent in frame Dialog-Frame .
     3419       APPLY "VALUE-CHANGED" to br-ext-contragent.
     3420   END .
     3421   END PROCEDURE.
     3422   FUNCTION get-client-name RETURNS CHARACTER
     3423     ( INPUT p-obj-code AS integer, INPUT p-obj-type AS character )  :
     3424     define variable v-client-name as character no-undo .
     3425     define buffer buf_clients for ub.clients .
     3426     do
     3427     on error undo, return error return-value
     3428     :
     3429       find first buf_clients no-lock
     3430         where buf_clients.obj-type = p-obj-type
     3431           and buf_clients.obj-code = p-obj-code
     3432         no-error .
     3433       if available buf_clients
     3434       then do:
     3435         assign
     3436           v-client-name = (if buf_clients.stts = 0
     3437                          then buf_clients.obj-name
     3438                          else (substring (buf_clients.obj-name, 1, 20)
     3439                               + fill (" " , 20 - length (substring (buf_clients.obj-name, 1, 20)))
     3440                               + '---  УДАЛЕН  ---':U
     3441                               )
     3442                         )
     3443         .
     3444       end.
     3445     end.
     3446     return v-client-name .
     3447   END FUNCTION.
