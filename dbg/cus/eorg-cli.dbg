     2397         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2398         v-browse-width = v-diasize-browse-handle :width
     2399       .
     2400       for each buf_temp-browse-handle
     2401         where buf_temp-browse-handle.browse-type = 'width':u
