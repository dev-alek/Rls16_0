      515   end.
      516   assign counter  = 0.
      517   FOR EACH ub.trn-doc WHERE ub.trn-doc.obj-type = v-cntxt-obj-type
      518                                               AND ub.trn-doc.obj-code = v-cntxt-obj-code
      519                                               AND ub.trn-doc.fact-num <> 0
      520                                               AND ub.trn-doc.discnt-type <> 'касс':U
      521                                               AND ub.trn-doc.fact-date >= date-beg
      522                                               AND ub.trn-doc.fact-date <= date-end NO-LOCK:
      523       if type-docs = 'при':U and ub.trn-doc.doc-type = 'рас':U then next.
      524       else if type-docs = 'рас':U and ub.trn-doc.doc-type = 'при':U then next.
      525       else if type-docs = 'рас':U and ub.trn-doc.doc-type = 'возврат':U then next.
      526       create doc-tbl.
      527       assign
      528           doc-tbl.fact-num  = ub.trn-doc.fact-num
      529           doc-tbl.fact-date  = ub.trn-doc.fact-date
      530           doc-tbl.num-doc  = ub.trn-doc.doc-code
      531           doc-tbl.client       = ub.trn-doc.cli-name
      532           doc-tbl.type-doc  = ub.trn-doc.doc-type
      533       .
      534       if ub.trn-doc.doc-type = 'инв':U then doc-tbl.client = "Инвентаризация".
      535       else if ub.trn-doc.doc-type = 'возврат':U and type-docs = 'при':U then doc-tbl.client = 'возврат':U.
      536       else if ub.trn-doc.ext-doc-type = 'ep':U and type-docs = 'рас':U then doc-tbl.client = "Возврат поставщику".
      537       FOR EACH ub.doc-line WHERE ub.doc-line.doc-code = ub.trn-doc.doc-code NO-LOCK,
      538               EACH ub.clients WHERE ub.clients.obj-type = ub.doc-line.prod-type
      539                                                   AND ub.clients.obj-code = ub.doc-line.prod-code NO-LOCK:
      540              assign
      541                  with-discnt          = 0
      542                  sum-with-discnt  = 0
      543                  discnt                  = 0
      544                  sum-discnt          = 0
      545                  amount                = 0
      546                  sum                     = 0 .
      547               FOR EACH ub.gds-dtl WHERE
      548                                 ub.gds-dtl.prod-type  = ub.doc-line.prod-type
      549                         AND ub.gds-dtl.prod-code = ub.doc-line.prod-code
      550                         AND ub.gds-dtl.artic          = ub.doc-line.artic
      551                         AND ub.gds-dtl.doc-code   = ub.doc-line.doc-code
      552                     NO-LOCK:
      553                     if ub.trn-doc.doc-type =  'инв':U  THEN do:
      554                               if ( ( type-docs = 'рас':U AND ub.gds-dtl.doc-qnty >= 0 )
      555                                    OR ( type-docs = 'при':U AND ub.gds-dtl.doc-qnty <= 0 ) ) then
      556                                   NEXT.
      557                               else
      558                                  assign
      559                                     amount = amount + absolute( ub.gds-dtl.doc-qnty )
      560                                     sum      = sum      +
      561                                     ( if var-report-r-b = "rubl" then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base )
      562                                     * absolute( ub.gds-dtl.doc-qnty ) .
      563                     end.
      564                     else do:
      565                         if  type-docs = 'рас':U then   do:
      566                             assign
      567                                 amount = amount + ub.gds-dtl.fact-qnty
      568                                 sum      = sum      + ( (
      569                                  ( if var-report-r-b = "rubl" then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base )
      570                                   -
      571                                   ( if var-report-r-b = "rubl" then ub.gds-dtl.discnt-rubl else ub.gds-dtl.discnt-base )
      572                                   ) * ub.gds-dtl.fact-qnty ).
      573                             if   ub.trn-doc.ext-doc-type = 'ep':U   then
      574                               assign
      575                                   doc-tbl.type-doc  = 'возврат':U
      576                                   amount = amount + ub.gds-dtl.fact-qnty
      577                                   sum      = sum      + (
      578                                     ( if var-report-r-b = "rubl" then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base )
      579                                     -
      580                                     ( if var-report-r-b = "rubl" then ub.gds-dtl.discnt-rubl else ub.gds-dtl.discnt-base )
      581                                      ) * ub.gds-dtl.fact-qnty  .
      582                             else
      583                                assign
      584                                    with-discnt          = with-discnt + ub.gds-dtl.fact-qnty
      585                                    sum-with-discnt  = sum-with-discnt + ( (
      586                                     ( if var-report-r-b = "rubl" then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base )
      587                                     -
      588                                     ( if var-report-r-b = "rubl" then ub.gds-dtl.discnt-rubl else ub.gds-dtl.discnt-base )
      589                                      ) * ub.gds-dtl.fact-qnty )
      590                                    discnt          = discnt + ub.gds-dtl.fact-qnty
      591                                    sum-discnt  = sum-discnt + (
      592                                      ( if var-report-r-b = "rubl" then ub.gds-dtl.discnt-rubl else ub.gds-dtl.discnt-base )
      593                                      * ub.gds-dtl.fact-qnty ) .
      594                        end.
      595                        else
      596                             assign
      597                                 amount = amount + ub.gds-dtl.fact-qnty
      598                                 sum      = sum      + ( ub.gds-dtl.cur-base * ub.gds-dtl.fact-qnty ).
      599                     end.
      600               end.
      601               find  cli-tbl where
      602                        cli-tbl.cli-type   = ub.doc-line.prod-type
      603                 and cli-tbl.cli-code  = ub.doc-line.prod-code
      604               use-index code no-lock no-error.
      605               if not available cli-tbl then do:
      606                   create cli-tbl.
      607                   assign
      608                      cli-tbl.cli-type    = ub.doc-line.prod-type
      609                      cli-tbl.cli-code   = ub.doc-line.prod-code
      610                      cli-tbl.cli-name  = ub.clients.obj-name.
      611               end.
      612               find  var-tbl where
      613                        var-tbl.fact-num = ub.trn-doc.fact-num
      614                 and var-tbl.cli-type   = ub.doc-line.prod-type
      615                 and var-tbl.cli-code  = ub.doc-line.prod-code
      616               use-index code no-lock no-error.
      617               if not available var-tbl then do:
      618                  create var-tbl.
      619                  assign
      620                     var-tbl.cli-type    = ub.doc-line.prod-type
      621                     var-tbl.cli-code   = ub.doc-line.prod-code
      622                     var-tbl.fact-num  = ub.trn-doc.fact-num
      623                   .
      624               end.
      625                assign
      626                     var-tbl.quant    = var-tbl.quant + amount
      627                     var-tbl.summa = var-tbl.summa +  sum.
      628                 if type-docs = 'рас':U and ub.trn-doc.ext-doc-type <> 'ep':U then   do:
      629                     find  var-tbl where
      630                              var-tbl.fact-num = - 99
      631                       and var-tbl.cli-type   = ub.doc-line.prod-type
      632                       and var-tbl.cli-code  = ub.doc-line.prod-code
      633                     use-index code no-lock no-error.
      634                     if not available var-tbl then do:
      635                         create var-tbl.
      636                         assign
      637                             var-tbl.cli-type    = ub.doc-line.prod-type
      638                             var-tbl.cli-code   = ub.doc-line.prod-code
      639                             var-tbl.fact-num  = - 99.
      640                           .
      641                     end.
      642                     assign
      643                         var-tbl.quant    = var-tbl.quant    + with-discnt
      644                         var-tbl.summa = var-tbl.summa + sum-with-discnt.
      645                     find  var-tbl where
      646                              var-tbl.fact-num = - 999
      647                       and var-tbl.cli-type   = ub.doc-line.prod-type
      648                       and var-tbl.cli-code  = ub.doc-line.prod-code
      649                     use-index code no-lock no-error.
      650                     if not available var-tbl then do:
      651                         create var-tbl.
      652                         assign
      653                             var-tbl.cli-type    = ub.doc-line.prod-type
      654                             var-tbl.cli-code   = ub.doc-line.prod-code
      655                             var-tbl.fact-num  = - 999
      656                           .
      657                     end.
      658                     assign
      659                         var-tbl.quant    = var-tbl.quant    + discnt
      660                         var-tbl.summa = var-tbl.summa + sum-discnt.
      661                 end.
      662       END.
      663       assign counter = counter + 1.
      664       if ( counter MODULO 10 ) = 0 then
      665           run waitfram-show ( string( "Обработано " + string( counter )  + " документов" ) ).
      666   END.
      667   assign counter = 0.
      668   FOR EACH ub.price-doc WHERE ub.price-doc.obj-type = v-cntxt-obj-type
      669                                                   AND ub.price-doc.obj-code = v-cntxt-obj-code
      670                                                   AND ub.price-doc.fact-num <> 0
      671                                                   AND ub.price-doc.fact-date >= date-beg
      672                                                   AND ub.price-doc.fact-date <= date-end NO-LOCK:
      673       create doc-tbl.
      674       assign
      675           doc-tbl.fact-num  = ub.price-doc.fact-num
      676           doc-tbl.fact-date  = ub.price-doc.fact-date
      677           doc-tbl.num-doc  = ub.price-doc.doc-num
      678           doc-tbl.client       = 'переоценка':U
      679           doc-tbl.type-doc  = "пер"
      680           pr-price               = false
      681       .
      682       FOR EACH ub.price-list WHERE ub.price-list.doc-num = ub.price-doc.doc-num NO-LOCK,
      683               EACH ub.goods WHERE ub.goods.artic = ub.price-list.artic
      684                                                  AND ub.goods.prod-type = ub.price-list.prod-type
      685                                                  AND ub.goods.prod-code = ub.price-list.prod-code NO-LOCK,
      686               EACH ub.clients WHERE ub.clients.obj-type = ub.goods.prod-type
      687                                                   AND ub.clients.obj-code = ub.goods.prod-code NO-LOCK:
      688           FIND LAST b-price-list WHERE b-price-list.obj-type = v-cntxt-obj-type
      689                                                              AND b-price-list.obj-code = v-cntxt-obj-code
      690                                                              AND b-price-list.b-code  = ub.price-list.b-code
      691                                                              AND b-price-list.fact-order < ub.price-list.fact-order
      692                                                              NO-LOCK NO-ERROR.
      693           if not available b-price-list  then do:
      694                   FIND ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK.
      695                   FIND LAST b-price-list WHERE b-price-list.obj-type = v-cntxt-obj-type
      696                                                                     AND b-price-list.obj-code = v-cntxt-obj-code
      697                                                                     AND b-price-list.b-code  = ub.gds-prt.node-code
      698                                                                     AND b-price-list.fact-order < ub.price-list.fact-order
      699                                                                     NO-LOCK NO-ERROR.
      700           end.
      701           if not available b-price-list  then
      702               d-price = ub.price-list.price-sale * ub.price-list.doc-qnty.
      703           else
      704               d-price = ( ub.price-list.price-sale - b-price-list.price-sale ) * ub.price-list.doc-qnty.
      705           if ub.price-list.doc-qnty = ? then   NEXT.
      706           if ( ( type-docs = 'рас':U AND d-price >= 0 ) OR ( type-docs = 'при':U AND d-price <= 0 ) ) then
      707               NEXT.
      708               find  cli-tbl where
      709                        cli-tbl.cli-type   = ub.price-list.prod-type
      710                 and cli-tbl.cli-code  = ub.price-list.prod-code
      711               use-index code no-lock no-error.
      712               if not available cli-tbl then do:
      713                   create cli-tbl.
      714                   assign
      715                      cli-tbl.cli-type    = ub.price-list.prod-type
      716                      cli-tbl.cli-code   = ub.price-list.prod-code
      717                      cli-tbl.cli-name  = ub.clients.obj-name.
      718               end.
      719               find  var-tbl where
      720                         var-tbl.fact-num = ub.price-doc.fact-num
      721                  and var-tbl.cli-type   = ub.price-list.prod-type
      722                  and var-tbl.cli-code  = ub.price-list.prod-code
      723               use-index code no-lock no-error.
      724               if not available var-tbl then do:
      725                   create var-tbl.
      726                   assign
      727                       var-tbl.cli-type    = ub.price-list.prod-type
      728                       var-tbl.cli-code   = ub.price-list.prod-code
      729                       var-tbl.fact-num  = ub.price-doc.fact-num
      730                    .
      731               end.
      732               assign
      733                   var-tbl.quant    = var-tbl.quant    + ub.price-list.doc-qnty
      734                   var-tbl.summa = var-tbl.summa + d-price.
      735                   pr-price            = true
      736                 .
      737       END.
      738       if pr-price = false then delete doc-tbl.
      739       assign counter = counter + 1.
      740       if ( counter MODULO 10 ) = 0 then
      741           run waitfram-show ( string( "Обработано " + string( counter )  + " актов переоценки" ) ).
      742   END.
      743   if type-docs = 'при':U then
      744       EXPORT stream OutStream
      745            "Отчет по приходу товара".
      746   else
      747       EXPORT stream OutStream
      748           "Отчет по расходу товара".
      749   find ub.clients where ub.clients.obj-type = v-cntxt-obj-type
      750                        AND ub.clients.obj-code = v-cntxt-obj-code NO-LOCK.
      751   EXPORT stream OutStream
      752       "Магазин/Склад"  p-xl-delim ub.clients.obj-name .
      753   EXPORT stream OutStream
      754       "Отчетный период" p-xl-delim
      755       string(date-beg,  "99/99/9999" ) p-xl-delim
      756       " - "  p-xl-delim
      757       string( date-end,  "99/99/9999" ) .
      758   put stream OutStream unformatted " " skip.
      759   str-doc =  "Дата" + p-xl-delim  + "N документа" + p-xl-delim.
      760   if type-docs = 'при':U then
      761           str-doc = str-doc + "Отправитель"  + p-xl-delim.
      762   else
      763           str-doc = str-doc + "Получатель"  + p-xl-delim.
      764   str-txt =  p-xl-delim +  p-xl-delim +  p-xl-delim.
      765   for each cli-tbl no-lock
      766      use-index name:
      767      assign
      768           str-doc = str-doc + cli-tbl.cli-name + p-xl-delim + p-xl-delim
      769           str-txt   = str-txt   + "шт." + p-xl-delim + "Стоимость РУБ" +  p-xl-delim.
      770   end.
      771   assign
      772        str-doc = str-doc + "ИТОГО" + p-xl-delim + p-xl-delim
      773        str-txt   = str-txt   + "шт." + p-xl-delim + "Стоимость РУБ" +  p-xl-delim.
      774   EXPORT stream OutStream str-doc .
      775   EXPORT stream OutStream str-txt .
      776   do i = 1 to 6 :
      777       if i = 1 then do:
      778            if type-docs = 'при':U  then t-d =  'при':U.
      779            else t-d = 'рас':U.
      780       end.
      781       else if i = 4 then t-d = 'возврат':U.
      782       else if i = 2 then do:
      783            if type-docs = 'при':U  then next.
      784            else t-d = "Со скидкой".
      785       end.
      786       else if i = 3 then do:
      787            if type-docs = 'при':U  then next.
      788            else t-d = 'скидка':U.
      789       end.
      790       else if i = 5 then t-d =  "пер".
      791       else if i = 6 then t-d =  'инв':U.
      792       pr-t-doc = false.
      793       for each doc-tbl  where
      794               doc-tbl.type-doc = t-d
      795           use-index code  no-lock :
      796           if i = 2  or i = 3  then
      797              str-doc = p-xl-delim + p-xl-delim.
      798           else
      799               str-doc =  string(doc-tbl.fact-date, "99/99/9999") + p-xl-delim +
      800                               string(doc-tbl.num-doc) + p-xl-delim .
      801           assign
      802               amount = 0
      803               sum      = 0
      804               pr-t-doc = true
      805               str-doc =  str-doc +
      806                               string(doc-tbl.client)      + p-xl-delim.
      807           for each cli-tbl no-lock
      808               use-index name:
      809               find first var-tbl  WHERE
      810                        var-tbl.fact-num = doc-tbl.fact-num
      811                 and var-tbl.cli-type   = cli-tbl.cli-type
      812                 and var-tbl.cli-code   = cli-tbl.cli-code
      813               use-index code  no-lock no-error.
      814               if not available var-tbl then
      815                   str-doc = str-doc + " "  + p-xl-delim
      816                                              + " "  + p-xl-delim.
      817               else  do:
      818                   if i = 2 or i = 3 then
      819                       str-doc = str-doc +  p-xl-delim
      820                                                  +  string(var-tbl.summa)   + p-xl-delim.
      821                   else do:
      822                       if var-tbl.quant <> 0 then
      823                           str-doc = str-doc +  string(var-tbl.quant   )   + p-xl-delim.
      824                       else
      825                           str-doc = str-doc +  " "  + p-xl-delim.
      826                       if var-tbl.summa <> 0 then
      827                           str-doc = str-doc +  string(var-tbl.summa)   + p-xl-delim.
      828                       else
      829                           str-doc = str-doc +  " "  + p-xl-delim.
      830                       assign
      831                           cli-tbl.quant = cli-tbl.quant + var-tbl.quant
      832                           cli-tbl.summa = cli-tbl.summa + var-tbl.summa.
      833                   end.
      834                   assign
      835                       amount = amount + var-tbl.quant
      836                       sum      = sum      + var-tbl.summa.
      837                end.
      838           end.
      839           if i = 2 or i = 3 then
      840               str-doc = str-doc + p-xl-delim
      841                                          +  string(sum)   + p-xl-delim.
      842           else do:
      843               if amount <> 0 then
      844                  str-doc = str-doc +  string(amount   )   + p-xl-delim.
      845               else
      846                  str-doc = str-doc +  " "   + p-xl-delim.
      847               if sum <> 0 then
      848                  str-doc = str-doc +  string(sum)   + p-xl-delim.
      849               else
      850                  str-doc = str-doc +  " "   + p-xl-delim.
      851           end.
      852           EXPORT stream OutStream str-doc .
      853       end.
      854       if pr-t-doc = false then do:
      855           str-txt =  p-xl-delim +  p-xl-delim .
      856           if i = 4  and type-docs = 'рас':U then
      857                EXPORT stream OutStream  p-xl-delim
      858                       p-xl-delim "Возврат поставщику" .
      859           else if i = 4  and type-docs = 'при':U then
      860                EXPORT stream OutStream  p-xl-delim
      861                       p-xl-delim 'возврат':U .
      862           else if i = 2   and type-docs = 'рас':U  then
      863                    EXPORT stream OutStream p-xl-delim
      864                           p-xl-delim  "Со скидкой" .
      865           else if i = 3  and type-docs = 'рас':U  then
      866                    EXPORT stream OutStream
      867                           p-xl-delim   p-xl-delim   'скидка':U .
      868           else if i = 5 then
      869                EXPORT stream OutStream
      870                       p-xl-delim  p-xl-delim
      871                       'переоценка':U  p-xl-delim .
      872           else if i = 6 then
      873                EXPORT stream OutStream
      874                       p-xl-delim  p-xl-delim
      875                       "Инвентаризация"  p-xl-delim .
      876       end.
      877   end.
      878   str-txt =  p-xl-delim +  p-xl-delim  + "ИТОГО" +  p-xl-delim.
      879   assign
      880     amount = 0
      881     sum = 0.
      882   for each cli-tbl no-lock
      883       use-index name:
      884       if cli-tbl.quant <> 0 then
      885           str-txt = str-txt + string(cli-tbl.quant)    +  p-xl-delim .
      886       else
      887           str-txt = str-txt +  " "   + p-xl-delim.
      888       if cli-tbl.summa <> 0 then
      889           str-txt = str-txt + string(cli-tbl.summa) +  p-xl-delim .
      890       else
      891           str-txt = str-txt +  " "   + p-xl-delim.
      892       assign
      893           amount = amount + cli-tbl.quant
      894           sum      = sum      + cli-tbl.summa.
      895   end.
      896   str-txt = str-txt +  string(amount   )   + p-xl-delim
      897                           +  string(sum)           + p-xl-delim.
      898   EXPORT stream OutStream str-txt .
      899   run waitfram-hide.
      900   put stream OutStream unformatted " " skip.
      901   EXPORT stream OutStream p-xl-delim
      902       "Директор Магазина/Склада" p-xl-delim
      903       "Дата составления отчета " p-xl-delim
      904        string(TODAY,  "99/99/9999")   .
      905   EXPORT stream OutStream p-xl-delim
      906       "Управляющий салоном/Старший товаровед"   .
      907   if session:set-wait-state("") then.
      908   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      909   output stream OutStream CLOSE.
      910   message "Отчет выведен в файл:" SKIP
      911                   ReportFileName
      912                   view-as alert-box INFORMATION buttons OK TITLE " ".
      913   END.
      914   ON RETURN OF date-beg IN FRAME xl-inout
      915   DO:
      916       APPLY "ENTRY" TO date-end IN FRAME xl-inout.
      917   END.
      918   ON RETURN OF date-end IN FRAME xl-inout
      919   DO:
      920       APPLY "CHOOSE" TO b-print IN FRAME xl-inout.
      921   END.
      922   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME xl-inout:PARENT eq ?
      923   THEN FRAME xl-inout:PARENT = ACTIVE-WINDOW.
      924   ON WINDOW-CLOSE OF FRAME xl-inout APPLY "END-ERROR":U TO SELF.
      925   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      926   on help of frame xl-inout
      927   do:
      928     run gbl/app_help.p
      929       (input this-procedure :file-name
      930       ,input ''
      931       ,input ?
      932       ) no-error.
      933     if error-status :error then do:
      934       message
      935         "Ошибка при вызове помощи"
      936         error-status :get-message(1)
      937         view-as alert-box .
      938     end.
      939   end.
      940   run minbtn-set in this-procedure .
      941   on choose of b-help in frame xl-inout
      942   do:
      943     apply "help":u to frame xl-inout .
      944   end.
      945   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   procedure minbtn-set :
      947       do
      948           on error undo, return error return-value
      949           :
      950           define variable ii              as integer       no-undo .
      951           define variable fh              as widget-handle no-undo .
      952           define variable hh              as widget-handle no-undo .
      953           define variable v-h             as handle        extent 4 no-undo .
      954           define variable v-name-button   as character     no-undo .
      955           define variable v-help-old-x    as decimal       no-undo .
      956           define variable v-help-old-y    as decimal       no-undo .
      957           define variable v-help-old-size as decimal       no-undo .
      958           define variable v-frame-width   as decimal       no-undo .
      959           define variable jj              as integer       no-undo .
      960           do
      961               on error undo, return error
      962               :
      963               assign
      964                   v-frame-width = frame xl-inout:width - 0.3
      965                   fh            = frame xl-inout:first-child
      966                   hh            = fh:first-child
      967                   ii            = 1
      968                   .
      969               do while valid-handle(hh):
      970                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      971                   do:
      972                       case lc(hh:name) :
      973                           when "b-help" then
      974                               do:
      975                                   hh:load-image-up("cmp/b-help.bmp":u) .
      976                                   hh:load-image-down("cmp/b-help.bmp":u) .
      977                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      978                                   hh:TOOLTIP = "Помощь" .
      979                                   v-help-old-x = hh:column .
      980                                   v-help-old-y = hh:row    .
      981                                   v-help-old-size = hh:width .
      982                                   hh:width-chars = 2.5 .
      983                               end.
      984                           when "b-print" then
      985                               do:
      986                                   hh:load-image("cmp/b-print.bmp":u) .
      987                                   hh:TOOLTIP = "Печать" .
      988                                   v-h[ii] = hh:handle .
      989                                   ii = ii + 1 .
      990                                   hh:width-chars = 3 .
      991                               end.
      992                           when "b-history" or
      993                           when "b-hist" then
      994                               do:
      995                                   hh:load-image("cmp/b-hist.bmp":u) .
      996                                   hh:TOOLTIP = "История" .
      997                                   v-h[ii] = hh:handle .
      998                                   ii = ii + 1 .
      999                                   hh:width-chars = 3 .
     1000                               end.
     1001                           when "b-sch" then
     1002                               do:
     1003                                   hh:load-image("cmp/b-sch.bmp":u) .
     1004                                   hh:TOOLTIP = "Установка Фильтра" .
     1005                                   v-h[ii] = hh:handle .
     1006                                   ii = ii + 1 .
     1007                                   hh:width-chars = 3 .
     1008                               end.
     1009                           when "b-hist-user" then
     1010                               do:
     1011                                   hh:load-image("cmp/b-hist.bmp":u) .
     1012                                   hh:TOOLTIP = "История пользователя" .
     1013                                   ii = ii + 1 .
     1014                               end.
     1015                       end case.
     1016                   end.
     1017                   hh = hh:next-sibling.
     1018               end.
     1019               b-help:column = v-frame-width - b-help:width-chars.
     1020               jj = 0.
     1021               repeat ii = 4 to 1 by -1 :
     1022                   if valid-handle (v-h[ii] ) then
     1023                   do:
     1024                       jj  = jj + 1 .
     1025                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1026                       v-h[ii]:row    = v-help-old-y .
     1027                   end.
     1028               end.
     1029           end.
     1030       end.
     1031   end procedure.
     1032   MAIN-BLOCK:
     1033   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1034      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1035     assign
     1036         date-beg = date( month( TODAY ), 1, year( TODAY ) )
     1037         date-end = TODAY
     1038         .
     1039     run enable_ui.
     1040     if type-docs = 'при':U then
     1041         FRAME xl-inout:TITLE = "Отчет по приходу товара".
     1042     else
     1043         FRAME xl-inout:TITLE = "Отчет по расходу товара".
     1044     WAIT-FOR GO OF FRAME xl-inout.
     1045   END.
     1046   run disable_ui.
     1047   PROCEDURE disable_UI :
     1048     HIDE FRAME xl-inout.
     1049   END PROCEDURE.
     1050   PROCEDURE enable_UI :
     1051     DISPLAY date-beg date-end
     1052         WITH FRAME xl-inout.
     1053     ENABLE b-quit b-print b-help date-beg date-end
     1054         WITH FRAME xl-inout.
     1055   END PROCEDURE.
     1056   PROCEDURE xl-io-get :
     1057   def input parameter d-t like ub.trn-doc.doc-type no-undo.
     1058           if d-t = 'возврат':U then
     1059               run waitfram-show ( "Обработка возвратных накладных" ).
     1060           if d-t = 'инв':U then
     1061               run waitfram-show ( "Обработка инвентаризаций" ).
     1062           assign
     1063               counter = 0
     1064               str-doc = str-et
     1065               .
     1066           FOR EACH ub.trn-doc WHERE ub.trn-doc.obj-type = v-cntxt-obj-type
     1067                                                       AND ub.trn-doc.obj-code = v-cntxt-obj-code
     1068                                                       AND ub.trn-doc.status_ = 'факт':U
     1069                                                       AND ub.trn-doc.doc-type = d-t
     1070                                                       AND ub.trn-doc.discnt-type <> 'касс':U
     1071                                                       AND ub.trn-doc.fact-date >= date-beg
     1072                                                       AND ub.trn-doc.fact-date <= date-end NO-LOCK:
     1073               FOR EACH ub.doc-line WHERE ub.doc-line.doc-code = ub.trn-doc.doc-code NO-LOCK,
     1074                       EACH ub.clients WHERE ub.clients.obj-type = ub.doc-line.prod-type
     1075                                                           AND ub.clients.obj-code = ub.doc-line.prod-code NO-LOCK,
     1076                       EACH ub.gds-dtl WHERE ub.gds-dtl.prod-type = ub.doc-line.prod-type
     1077                                                           AND ub.gds-dtl.prod-code = ub.doc-line.prod-code
     1078                                                           AND ub.gds-dtl.artic = ub.doc-line.artic
     1079                                                           AND ub.gds-dtl.doc-code = ub.doc-line.doc-code NO-LOCK:
     1080                   assign
     1081                       str-ind = lookup( ub.clients.obj-name, CliName, p-xl-delim )
     1082                       .
     1083                   CASE d-t :
     1084                       WHEN 'инв':U THEN
     1085                           do:
     1086                               if ( ( type-docs = 'рас':U AND ub.gds-dtl.doc-qnty >= 0 )
     1087                                    OR ( type-docs = 'при':U AND ub.gds-dtl.doc-qnty <= 0 ) ) then
     1088                                   NEXT.
     1089                               assign
     1090                                   entry( str-ind, str-doc , p-xl-delim ) =
     1091                                       string(absolute( ub.gds-dtl.doc-qnty ) + decimal( entry( str-ind, str-doc , p-xl-delim ) ) )
     1092                                   entry( str-ind + 1, str-doc , p-xl-delim ) =
     1093                                       string(
     1094                                          ( if var-report-r-b = "rubl" then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base )
     1095                                         * absolute( ub.gds-dtl.doc-qnty ) + decimal( entry( str-ind + 1, str-doc , p-xl-delim ) ) )
     1096                                   .
     1097                          end.
     1098                       OTHERWISE
     1099                           do:
     1100                               assign
     1101                                   entry( str-ind, str-doc , p-xl-delim ) =
     1102                                       string(ub.gds-dtl.fact-qnty + decimal( entry( str-ind, str-doc , p-xl-delim ) ) )
     1103                                   entry( str-ind + 1, str-doc , p-xl-delim ) =
     1104                                       string( (
     1105                                           ( if var-report-r-b = "rubl" then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base )
     1106                                           -
     1107                                           ( if var-report-r-b = "rubl" then ub.gds-dtl.discnt-rubl else ub.gds-dtl.discnt-base )
     1108                                         ) * ub.gds-dtl.fact-qnty + decimal( entry( str-ind + 1, str-doc , p-xl-delim ) ) )
     1109                                   .
     1110                           end.
     1111                   END CASE.
     1112               END.
     1113               assign counter = counter + 1.
     1114               if ( counter MODULO 50 ) = 0 then
     1115                   do:
     1116                       if d-t = 'возврат':U then
     1117                           run waitfram-show ( string( "Обработано " + string( counter )  + " возвратных накладных" ) ).
     1118                       if d-t = 'инв':U then
     1119                           run waitfram-show ( string( "Обработано " + string( counter )  + " инвентаризаций" ) ).
     1120                   end.
     1121           END.
     1122           if d-t = 'возврат':U then
     1123               assign entry( 4, str-doc, p-xl-delim ) = 'возврат':U .
     1124           if d-t = 'инв':U then
     1125               assign entry( 4, str-doc, p-xl-delim ) = "Инвентаризация" .
     1126           EXPORT stream OutStream str-doc .
     1127   END PROCEDURE.
