        1   define input  parameter parParentProc  as widget-handle no-undo.
        2   define input parameter type-docs like ub.trn-doc.doc-type no-undo.
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define new global shared variable g#library  as handle no-undo .
        8   define new global shared variable g#library2 as handle no-undo .
        9   procedure proc-alt-shift-f2:
       10     if not ibs.th.gbl.gbl-var:rcode
       11   then
       12     run gbl\inidebug.p .
       13   end.
       14   procedure proc-alt-shift-f3:
       15     run gbl/prvssinf.p
       16       ( input this-procedure
       17       ) .
       18   end.
       19   define variable v-inform-launched as logical no-undo initial false .
       20   procedure proc-alt-shift-f4:
       21     define variable v-action as character no-undo .
       22     if v-inform-launched = false then do:
       23       assign
       24         v-inform-launched = true
       25       .
       26       run gbl/d-inform.w
       27         (  input self
       28         ,  input this-procedure
       29         , output v-action
       30         ) no-error .
       31       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       32       assign
       33         v-inform-launched = false
       34       .
       35     end.
       36   end.
       37   procedure proc-alt-f1:
       38     run gbl/corrhelp.p
       39       (input this-procedure
       40       ) .
       41   end .
       42   on alt-shift-f2 anywhere do:
       43     run proc-alt-shift-f2.
       44   end.
       45   on alt-shift-f3 anywhere do:
       46     run proc-alt-shift-f3 in this-procedure .
       47   end.
       48   on alt-shift-f4 anywhere do:
       49     run proc-alt-shift-f4 in this-procedure.
       50   end.
       51   on alt-f1 anywhere do:
       52     run proc-alt-f1 in this-procedure .
       53   end.
       54   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       55   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       56   define new shared variable RepPathName        as character no-undo .
       57   define new shared variable PrintRubl          as logical   no-undo .
       58   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       59   define variable v-waitfram-action01         as character   no-undo .
       60   define variable v-waitfram-action02         as character   no-undo .
       61   define variable v-waitfram-action03         as character   no-undo .
       62   define variable mWaitFramTextBeg            as character   no-undo.
       63   define variable mWaitFramTextEnd            as character   no-undo.
       64   define variable mWaitFramView               as logical     no-undo.
       65   define variable mWaitProcEvent              as logical     no-undo init yes.
       66   define variable mWaitFramInterval           as integer     no-undo init 1 .
       67   define variable mWaitFramStop               as logical     no-undo.
       68   define variable mWaitFramStopUser           as logical     no-undo.
       69   define variable mWaitFramStopTimeOut        as logical     no-undo.
       70   define variable mWaitFramStartProc          as datetime-tz no-undo.
       71   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       72   define button B-WaitFramStop auto-end-key
       73        label "Стоп"
       74        size 10 by 1 tooltip "Остоновить процесс".
       75   define button B-viewProcInfo
       76        label "Информация"
       77        size 15 by 1 tooltip "Информация о процесс".
       78   define frame waitfram
       79     v-waitfram-action01 format "x(72)" no-label skip
       80     v-waitfram-action02 format "x(72)" no-label skip
       81     v-waitfram-action03 format "x(72)" no-label skip
       82     B-viewProcInfo
       83     B-WaitFramStop at row 4 col 30
       84     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       85     .
       86   define new global shared variable mBatchMode as logical no-undo init ?.
       87   define variable mFramBachModHandle as handle no-undo.
       88   mFramBachModHandle = frame waitfram:handle.
       89   define variable mFameOldVis as logical no-undo.
       90   define variable mVisCUrentVin as logical no-undo.
       91   if session:batch-mode
       92   then
       93      mBatchMode = yes.
       94   if mBatchMode = ? then do:
       95     mVisCUrentVin = current-window:visible.
       96     mFameOldVis = mFramBachModHandle:visible.
       97     mFramBachModHandle:visible  = yes.
       98     mBatchMode = mFramBachModHandle:visible ne yes.
       99     mFramBachModHandle:visible = mFameOldVis.
      100     current-window:visible = mVisCUrentVin.
      101   end.
      102    if  log-manager:logfile-name ne ?
      103     then DO:
      104         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      105         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      106         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      107     end.
      108   on choose of B-WaitFramStop in frame waitfram
      109   do:
      110     mWaitFramStop = yes.
      111     mWaitFramStopUser = yes.
      112   end.
      113   function waitfram-check-timeout returns logical():
      114      define variable vtime as int64 no-undo.
      115      if mWaitFramStopTimeOut
      116      then
      117         return yes.
      118      vtime = ( now - mWaitFramStartProc ) / 1000 .
      119      if     mWaitFramTimeOut ne ?
      120         and mWaitFramTimeOut ne 0
      121         and mWaitFramTimeOut lt vtime
      122      then do:
      123         mWaitFramStopTimeOut = yes.
      124      end.
      125      return mWaitFramStopTimeOut.
      126   end.
      127   procedure waitfram-hide :
      128     if not session:batch-mode
      129     then do
      130     on error undo, return error return-value
      131     :
      132       pause 0 before-hide .
      133       if not mBatchMode then
      134         hide frame waitfram .
      135     if     not mWaitFramView
      136        and mWaitProcEvent
      137     then
      138       process events .
      139     end.
      140   end procedure.
      141   procedure waitfram-show :
      142     define input  parameter p-message as character no-undo .
      143     define variable v-left-margin as integer   no-undo .
      144     if not session:batch-mode
      145     then do
      146     on error undo, return error return-value
      147     :
      148       if length(p-message) <= 70 then do:
      149         assign
      150           v-left-margin = integer((70 - length(p-message)) / 2)
      151         .
      152         assign
      153           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      154         .
      155         assign
      156           v-waitfram-action01 = " "
      157           v-waitfram-action02 = " "
      158                                    + fill(" ", v-left-margin)
      159                                    + p-message
      160           v-waitfram-action03 = " "
      161         .
      162       end.
      163       else do:
      164         define variable vRindex1 as integer no-undo.
      165         define variable vRindex2 as integer no-undo.
      166         vRindex1 = r-index(p-message," ",70).
      167         if vRindex1 = 0
      168         then
      169            vRindex1 = 70.
      170         if length(p-message)  <= vRindex1 + 70 then do:
      171           assign
      172             v-waitfram-action01 = " "
      173             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      174             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      175           .
      176         end.
      177         else do:
      178           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      179           if vRindex2 <= vRindex1
      180           then
      181              vRindex2 = vRindex1 + 70.
      182           assign
      183             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      186           .
      187         end.
      188       end.
      189       B-viewProcInfo:visible   in frame waitfram = no.
      190       B-viewProcInfo:sensitive in frame waitfram = no.
      191       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      192       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      193       if  (   mWaitFramView
      194          or  mWaitProcEvent)
      195          and not mBatchMode
      196       then
      197          display
      198             v-waitfram-action01 skip
      199             v-waitfram-action02 skip
      200             v-waitfram-action03 skip
      201          with frame waitfram .
      202       if     mWaitFramView
      203          then do:
      204             if     mWaitFramInterval ne ?
      205                and not mBatchMode
      206             then
      207                wait-for go of frame waitfram pause mWaitFramInterval.
      208          end.
      209          else
      210             if     mWaitProcEvent
      211                and not mBatchMode
      212             then
      213                process events .
      214     end.
      215   end procedure.
      216      procedure waitfram-show-this:
      217         define input  parameter iInterval as int64 no-undo.
      218         define variable vtime as int64 no-undo.
      219         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      220         mWaitFramInterval = iInterval.
      221         run waitfram-show (substitute("&1&2 &3&4" ,
      222                                       mWaitFramTextBeg ,
      223                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      224                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      225                                       mWaitFramTextEnd
      226                                      )
      227                           ).
      228      end.
      229      procedure WaitFramRunPause:
      230         define input  parameter iInterval as dec no-undo.
      231         define variable vStart  as datetime-tz no-undo.
      232         define variable vend    as datetime-tz no-undo.
      233         define variable vint as int64 no-undo.
      234         define variable vOk as logical no-undo.
      235         vStart = now.
      236         vend   = vStart.
      237         publish "WaitFramPause" (iInterval,output vOk).
      238         vend   =  now.
      239         vint = vend - vStart.
      240         vint = iInterval - vint / 1000.
      241         if     not mWaitFramStop
      242            and (   vint > 0
      243                 or (    not vOk
      244                     and iInterval eq ?
      245                     )
      246                 )
      247         then
      248            run waitfram-show-this (iInterval).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and vint > 0
      254         then do:
      255            run gbl/pause.p (vint * 1000).
      256         end.
      257         if iInterval ne ?
      258         then
      259            publish "WaitFramStop".
      260         waitfram-check-timeout().
      261      end.
      262      procedure WaitFramWaitFor:
      263         define input  parameter iInterval as dec no-undo.
      264         assign
      265            mWaitFramStartProc   = now
      266            mWaitFramStopUser    = no
      267            mWaitFramStopTimeOut = no
      268         .
      269         block-wait:
      270         do while not mWaitFramStop:
      271            run WaitFramRunPause (iInterval).
      272            if  waitfram-check-timeout()
      273            then do:
      274               leave block-wait.
      275            end.
      276         end.
      277         run waitfram-hide.
      278      end.
      279   procedure waitfram-join :
      280     define input  parameter p-line-1  as character no-undo .
      281     define input  parameter p-line-2  as character no-undo .
      282     define input  parameter p-line-3  as character no-undo .
      283     define output parameter p-message as character no-undo .
      284     do
      285     on error undo, return error return-value
      286     :
      287       assign
      288         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      289                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      290                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      291       .
      292     end.
      293   end procedure.
      294   function waitfram-join-function returns character
      295     (input p-line-1 as character
      296     ,input p-line-2 as character
      297     ,input p-line-3 as character
      298     ).
      299     define variable v-message as character no-undo .
      300     run waitfram-join in this-procedure
      301       (input  p-line-1
      302       ,input  p-line-2
      303       ,input  p-line-3
      304       ,output v-message
      305       ) .
      306     return v-message .
      307   end function .
