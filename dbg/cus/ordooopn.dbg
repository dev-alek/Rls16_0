        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":u .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
        5   define variable vss-workfile    as character no-undo init "$Workfile: ordooopn.p $":u .
        6   define variable vss-archive     as character no-undo init "$Archive: cus/ordooopn.p $":u .
        7   define variable vss-description as character no-undo init  "Переход по графу статусов ОТКРЫТИЕ" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       79   define  shared variable RepPathName        as character no-undo .
       80   define  shared variable PrintRubl          as logical   no-undo .
       81   define input  parameter parParentProc  as widget-handle no-undo.
       82   define input  parameter p-rec as recid no-undo .
       83   define  buffer buf_ord-doc    for ub.ord-doc.
       84   define  buffer x_doc-rcv      for ub.ord-doc-rcv .
       85   define  buffer x_ord-doc-rcv  for ub.ord-doc-rcv.
       86   define  buffer x_ord-doc-line-rcv for ub.ord-line-rcv.
       87   define  buffer x_doc-line     for ub.ord-line.
       88   define  buffer x_doc-line-rcv for ub.ord-line-rcv.
       89   define  buffer x_trn-line     for ub.doc-line.
       90   define  buffer x_trn-doc      for ub.trn-doc.
       91   define variable varchip-code as integer no-undo.
       92   do
       93   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       94   :
       95   find first buf_ord-doc where recid (buf_ord-doc) = p-rec exclusive-lock no-error.
       96   if not( ( buf_ord-doc.status_ = 'запрос':U and buf_ord-doc.flag_ = true  ) or
       97           ( buf_ord-doc.status_ = 'новый':U and buf_ord-doc.flag_ = true  )  ) then do:
       98      RELEASE buf_ord-doc.
       99      message "Открыть можно только заказ в статусе запр+ или новый+ " view-as alert-box information .
      100      undo, return .
      101   end.
      102   if  buf_ord-doc.status_ = 'запрос':U and buf_ord-doc.flag_ = true  then do:
      103     for each  X_ord-doc-rcv  exclusive-lock  where
      104               X_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
      105         on error undo, return error :
      106      for each ub.ord-chain no-lock where
      107               ub.ord-chain.doc-code = x_ord-doc-rcv.rcv-code and
      108               ub.ord-chain.doc-type = 'rcv'                  and
      109               ub.ord-chain.rel-doc-type = 'trn'
      110               :
      111               find first x_trn-doc  no-lock  where
      112                          x_trn-doc.doc-code = ub.ord-chain.rel-doc-code no-error .
      113                 if available x_trn-doc then do:
      114                       if not ( x_trn-doc.status_ = 'запрос':U  and
      115                                x_trn-doc.flag_   = false )  then do :
      116                         release buf_ord-doc .
      117                         message "Уже создана накладная в статусе " x_trn-doc.status_   + string( x_trn-doc.flag_ , "+/-")  " удалять нельзя!  "
      118                                 "Открыть заказ нельзя!"
      119                                 view-as alert-box error .
      120                                 undo,return.
      121                       end.
      122                 run str/del-doc.p
      123                     ( input  parParentProc,
      124                       input  x_trn-doc.doc-code,
      125                       input  g#db-num,
      126                       input  "del-doc.err",
      127                       input  ?,
      128                       input  ?,
      129                       input  g#userid,
      130                       input  x_trn-doc.doc-code,
      131                       input  ?,
      132                       output varchip-code )
      133                       .
      134              end.
      135       end.
      136     delete X_ord-doc-rcv .
      137     end.
      138    assign
      139     buf_ord-doc.status_ = 'запрос':U
      140     buf_ord-doc.flag_   = false
      141     .
      142     RELEASE buf_ord-doc .
      143     return.
      144   end.
      145   if  buf_ord-doc.status_ = 'новый':U and buf_ord-doc.flag_ = true  then do:
      146       if not ( ((buf_ord-doc.order-type = 2 or buf_ord-doc.order-type = 0) and g#db-num = 0 ) or
      147                (buf_ord-doc.order-type = 3  and g#db-num <> 0  )) then do:
      148         RELEASE buf_ord-doc.
      149         message "Открыть нельзя, так как распределение назначено в другой БД" view-as alert-box information .
      150         undo, return .
      151       end.
      152       assign
      153         buf_ord-doc.status_ = 'новый':U
      154         buf_ord-doc.flag_   = false
      155         .
      156         RELEASE buf_ord-doc .
      157         return.
      158    end.
      159   end.
