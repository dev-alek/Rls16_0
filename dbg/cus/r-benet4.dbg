     1200   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1201   define variable  str  as char format "X(60)"  no-undo.
     1202   define variable  str2 as char no-undo.
     1203   define variable v-r as character no-undo init "" .
     1204   define variable  i#i as int no-undo.
     1205   STR = "".
     1206   repeat i#i =1 to lavel#:
     1207       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1208       else do:
     1209           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1210           if not error-status:error  and str2 <> "":u then
     1211                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1212           end.
     1213   end.
     1214   if str <> ? then do:
     1215   v-r = str + chr(47) .
     1216   end.
     1217   RETURN v-r .
     1218   END FUNCTION.
     1219   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1220     if num-entries(string(p-dec), '.') = 2
     1221       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1222       else return( string(p-dec)) .
     1223   end function.
     1224   function format-point-to-comma returns char (input orig as char ) .
     1225   define variable rtext as character no-undo .
     1226   define variable strt as integer no-undo .
     1227   define variable leng as integer no-undo .
     1228   assign rtext = orig .
     1229   repeat:
     1230     strt =  index(rtext,'.').
     1231     if strt = 0 then leave.
     1232     leng = 1.
     1233     substring(rtext,strt,leng,"character") = v-delim .
     1234   end.
     1235   return rtext.
     1236   end function.
     1237   function format-excel-text returns char ( input start-text as char ) :
     1238   def var  i    as int no-undo.
     1239   def var  ch   as char no-undo.
     1240   def var  n    as int no-undo.
     1241   def var  ipos as int no-undo.
     1242     n = num-entries(trim(start-text), chr(10)) - 1 .
     1243     do i = 1 to n :
     1244       ipos = index( start-text, chr(10)).
     1245       if ipos > 0 then
     1246         substr( start-text, ipos, 1 ) = ' '.
     1247     end.
     1248     n = num-entries(trim(start-text), chr(13)) - 1 .
     1249     do i = 1 to n :
     1250       ipos = index( start-text, chr(13)).
     1251       if ipos > 0 then
     1252         substr( start-text, ipos, 1 ) = ' '.
     1253     end.
     1254     if index( start-text, '"' ) = 0 then
     1255       start-text =  '="'   + trim( start-text) + '"'   .
     1256       else do:
     1257         n = num-entries(trim(start-text), '"') - 1.
     1258         do i = 1 to n :
     1259           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1260         end.
     1261         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1262         start-text = '="'  + ch  + '"' .
     1263       end.
     1264     return start-text.
     1265   end.
     1266   function excel-sum returns char (input p-dec as decimal ).
     1267     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1268   end function.
     1269   function excel-qnty returns char (input p-dec as decimal ).
     1270     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1271   end function.
     1272   function format-excel-text-macr returns char ( input start-text as char ) :
     1273   def var  i    as int no-undo.
     1274   def var  ch   as char no-undo.
     1275   def var  n    as int no-undo.
     1276   def var  ipos as int no-undo.
     1277     n = num-entries(trim(start-text), chr(10)) - 1 .
     1278     do i = 1 to n :
     1279       ipos = index( start-text, chr(10)).
     1280       if ipos > 0 then
     1281         substring( start-text, ipos , 1 ) = ' '.
     1282     end.
     1283     n = num-entries(trim(start-text), chr(13)) - 1 .
     1284     do i = 1 to n :
     1285       ipos = index( start-text, chr(13)).
     1286       if ipos > 0 then
     1287         substring( start-text, ipos, 1 ) = ' '.
     1288     end.
     1289     if index( start-text, '"' ) = 0 then
     1290       start-text =  '"'   + trim( start-text) + '"'   .
     1291       else do:
     1292         n = num-entries(trim(start-text), '"') - 1.
     1293         do i = 1 to n :
     1294           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1295         end.
     1296         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1297         start-text = '"'  + ch  + '"' .
     1298       end.
     1299     n = num-entries(trim(start-text), chr(10)) - 1 .
     1300     do i = 1 to n :
     1301       ipos = index( start-text, chr(10)).
     1302       if ipos > 0 then
     1303         substring( start-text, ipos , 1 ) = ' '.
     1304     end.
     1305       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1306     return start-text.
     1307   end.
     1308   PROCEDURE report-execute :
     1309     run waitfram-show ( 'Подождите ...' ) .
     1310     output stream OutStream to value( string( session:temp-directory +
     1311                               "rpt" + string( g#report-num ) ) )      .
     1312      run maket .
     1313      if xTog-obj  Then DO:
     1314               FOR each obj-list no-lock:
     1315                   x-store-type = obj-list.obj-type.
     1316                   x-store-code = obj-list.obj-code.
     1317                   run report-exec1 .
     1318               End.
     1319                                                  End.
     1320     Else run report-exec1 .
     1321     output stream outstream close.
     1322     run waitfram-hide .
     1323     if Make-Excel then output stream ForExcel close.
     1324     run rep/runexcel.p
     1325         (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1326   END PROCEDURE.
     1327   PROCEDURE foreach :
     1328    R = R + 1.
     1329   If Integer(10) = 0 Then Temp1  = 100  .
     1330                         Else Temp1 = Integer(10) .
     1331        IF ( R modulo Temp1 = 0 ) AND ( R >= Temp1 ) then
     1332            RUN waitfram-show( "Обработано строк : " + string( R )) .
     1333       run ob-line ( input   x-store-code   ,  input   x-store-type   ,  input   gds-zap-artic       ,  input   gds-zap-prod-code,      input   gds-zap-prod-type   ,
     1334         input   fact-order-1,
     1335         input   fact-order-2,
     1336         input   type-arh,  input   '##,##':U, input   "" , input   xtog-obj ,  input   1 ,
     1337         output v#r-qnty[1] ,
     1338         output v#r-sum[1]).
     1339         assign    q4 = q4 + v#r-qnty[1]
     1340                    coast4  = coast4  + v#r-sum[1] .
     1341   if tog-1 then do:
     1342       run ob-line ( input   x-store-code   ,  input   x-store-type   ,  input   gds-zap-artic       ,  input   gds-zap-prod-code,      input   gds-zap-prod-type   ,
     1343         input   fo1  ,
     1344         input   fo12 ,
     1345         input   type-arh,  input   '##,##':U, input   "" , input   xtog-obj ,  input   1 ,
     1346         output v#r-qnty[2] ,
     1347         output v#r-sum[2]).
     1348       run ob-line ( input   x-store-code   ,  input   x-store-type   ,  input   gds-zap-artic       ,  input   gds-zap-prod-code,      input   gds-zap-prod-type   ,
     1349         input   fo2  ,
     1350         input   fo22 ,
     1351         input   type-arh,  input   '##,##':U, input   "" , input   xtog-obj ,  input   1 ,
     1352         output  v#r-qnty[3] ,
     1353         output  v#r-sum[3]).
     1354       run ob-line ( input   x-store-code   ,  input   x-store-type   ,  input   gds-zap-artic       ,  input   gds-zap-prod-code,      input   gds-zap-prod-type   ,
     1355         input   fo3  ,
     1356         input   fo32 ,
     1357         input   type-arh,  input   '##,##':U, input   "" , input   xtog-obj ,  input   1 ,
     1358         output  v#r-qnty[4] ,
     1359         output  v#r-sum[4]).
     1360       run ob-line ( input   x-store-code   ,  input   x-store-type   ,  input   gds-zap-artic       ,  input   gds-zap-prod-code,      input   gds-zap-prod-type   ,
     1361         input   fo4  ,
     1362         input   fo42 ,
     1363         input   type-arh,  input   '##,##':U, input   "" , input   xtog-obj ,  input   1 ,
     1364         output v#r-qnty[5] ,
     1365         output v#r-sum[5]  ).
     1366       run ob-line ( input   x-store-code   ,  input   x-store-type   ,  input   gds-zap-artic       ,  input   gds-zap-prod-code,      input   gds-zap-prod-type   ,
     1367         input   fo5  ,
     1368         input   fo52 ,
     1369         input   type-arh,  input   '##,##':U, input   "" , input   xtog-obj ,  input   1 ,
     1370         output v#r-qnty[6] ,
     1371         output v#r-sum[6]  ).
     1372   END.
     1373   if  v#r-qnty[1] <> 0 then
     1374    case rs-1 :
     1375     when 1 then do :
     1376           rr = rr + 1 .
     1377               create tmp#bs .
     1378               run eqq .
     1379               q3 = q3 + tmp#bs.r-qnty .
     1380               coast3 = coast3 + tmp#bs.r-sum .
     1381            end.
     1382     when 2  then do:
     1383           rr = rr + 1 .
     1384           if rr <= xbsamount then do:
     1385               create tmp#bs.
     1386               run eqq.
     1387               q3 = q3 + tmp#bs.r-qnty .
     1388               coast3 = coast3 + tmp#bs.r-sum .
     1389               end.
     1390               else do:
     1391                     find first tmp#bs  use-index byr-qnty.
     1392                     if available tmp#bs and absolute(v#r-qnty[1] ) > absolute(tmp#bs.r-qnty ) then do:
     1393                         q3 = q3 - tmp#bs.r-qnty + v#r-qnty[1] .
     1394                         coast3 = coast3 - tmp#bs.r-sum + v#r-sum[1] .
     1395                         run eqq.
     1396                         end.
     1397               end.
     1398            end.
     1399     when 3 then do:
     1400       if absolute(v#r-sum[1]) >= min-sum then do:
     1401           rr = rr + 1 .
     1402           if rr <= xbsamount then do:
     1403               create tmp#bs.
     1404               run eqq.
     1405               q3 = q3 + tmp#bs.r-qnty .
     1406               coast3 = coast3 + tmp#bs.r-sum .
     1407               end.
     1408               else do:
     1409                     find last tmp#bs  use-index byr-qnty.
     1410                     if available tmp#bs and absolute(v#r-qnty[1] ) < absolute(tmp#bs.r-qnty ) then do:
     1411                         q3 = q3 - tmp#bs.r-qnty + v#r-qnty[1] .
     1412                         coast3 = coast3 - tmp#bs.r-sum + v#r-sum[1] .
     1413                         run eqq.
     1414                         end.
     1415               end.
     1416           end.
     1417        end.
     1418    end case.
     1419   end procedure.
     1420   procedure display-line :
     1421              ii = ii + 1.
     1422              run display-str1.
     1423     end procedure.
     1424   procedure display-str1 :
     1425    end procedure.
     1426   procedure print-header :
     1427   if not firstline then  run display-title.
     1428       firstline = true .
     1429       if xtog-obj and    x-selectobject <> "currency":u   then  do:
     1430             if Make-Excel then  put   stream ForExcel unformatted  "ПО ОБЪЕКТУ : " + caps(objname)  format "x(170)" skip.
     1431             end.
     1432              break_group = true.
     1433              break_group1 = true.
     1434      end procedure.
     1435   procedure print-footer :
     1436    if (q4 - q3) <> 0 then do:
     1437           run u-line.
     1438           if Make-Excel then  put   stream ForExcel unformatted                                                             CHR(9)
     1439           'ОСТАЛЬНЫЕ'                                                             CHR(9)
     1440           excel-qnty(decimal( ((q4 - q3) / q4 ) * 100    ))                   CHR(9)
     1441           excel-qnty(decimal( q4 - q3                    ))             CHR(9)
     1442           excel-sum(decimal ( coast4 - coast3            ))            CHR(9)
     1443           excel-qnty(decimal( (q4 - q3) / (integer(x-date-end - x-date-start) + 1 )    ))           CHR(9)
     1444           excel-sum(decimal ( (coast4 - coast3) / (integer(x-date-end - x-date-start) + 1 ) ))         skip.
     1445    end.
     1446           if Make-Excel then  put   stream ForExcel unformatted
     1447           '          ИТОГО'                                                   CHR(9)
     1448           'по всем товарам'                                                   CHR(9)
     1449           100                                                                 CHR(9)
     1450           excel-qnty(decimal(q4                                                    ))      CHR(9)
     1451           excel-sum (decimal(coast4                                                ))     CHR(9)
     1452           excel-qnty( decimal( q4 / (integer(x-date-end - x-date-start) + 1 )       ))       CHR(9)
     1453           excel-sum(decimal(coast4 / (integer(x-date-end - x-date-start) + 1 )   ))
     1454           skip.
     1455          end procedure.
     1456   PROCEDURE U-LINE :
     1457           END PROCEDURE.
     1458   PROCEDURE P-LINE :
     1459           END PROCEDURE.
     1460   procedure run1 :
     1461    run run1sort2.
     1462   end procedure.
     1463   procedure run1sort2 :
     1464          case select-good :
     1465           when 1  then do:
     1466   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1467   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1468       for each gds-obj  where
     1469             gds-obj.obj-type = x-store-type  and
     1470             gds-obj.obj-code = x-store-code
     1471             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1472                   no-lock,
     1473             First goods  where  gds-obj.gds-code   = goods.gds-code
     1474   no-lock
     1475   BREAK
     1476       BY (goods.artic) :
     1477         run item-goods ( "1" , "goods" ) .
     1478         if return-value <> "" then NEXT.
     1479       End.
     1480     END.
     1481     Else DO:
     1482      For each obj-list no-lock :
     1483                     FOR EACH gds-obj where
     1484                   gds-obj.obj-type = obj-list.obj-type    and
     1485                   gds-obj.obj-code = obj-list.obj-code
     1486                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1487                   no-lock :
     1488                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1489                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1490                       Create temp-gds-list.
     1491                       Assign
     1492                         temp-gds-list.prod-code = gds-obj.prod-code
     1493                         temp-gds-list.grp-name  = gds-obj.grp-name
     1494                         temp-gds-list.gds-name  = goods.gds-name
     1495                         temp-gds-list.gds-code  = gds-obj.gds-code
     1496                         temp-gds-list.artic     = gds-obj.artic
     1497                       .
     1498                   End.
     1499               End.
     1500     End.
     1501     for each temp-gds-list no-lock
     1502       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     1503         BREAK
     1504       BY goods.artic :
     1505       run item-goods ( "1" , "goods" ) .
     1506         if return-value <> "" then NEXT.
     1507     End.
     1508   End.
     1509     end.
     1510           when 2  then do:
     1511   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1512     if x-selectobject = "currency":u  or  xtog-obj then do:
     1513         for  each gds-obj
     1514                     where gds-obj.obj-code   = x-store-code
     1515                      and  gds-obj.obj-type   = x-store-type
     1516                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1517                           no-lock ,
     1518                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1519                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     1520                     break
     1521                     by goods.artic :
     1522                     run item-goods ( input "1" , input "goods" ) .
     1523                     if return-value <> "" then next.
     1524         end.
     1525     end.
     1526     else do:
     1527         for each obj-list no-lock :
     1528               for  each gds-obj
     1529                 where  gds-obj.obj-code   = obj-list.obj-code
     1530                   and  gds-obj.obj-type   = obj-list.obj-type
     1531                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1532                 no-lock ,
     1533                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1534                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     1535                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1536                           create temp-gds-list.
     1537                           assign
     1538                             temp-gds-list.prod-code = gds-obj.prod-code
     1539                             temp-gds-list.grp-name  = gds-obj.grp-name
     1540                             temp-gds-list.gds-name  = goods.grp-name
     1541                             temp-gds-list.gds-code  = gds-obj.gds-code
     1542                             temp-gds-list.artic     = gds-obj.artic
     1543                           .
     1544                       end.
     1545               end.
     1546       end.
     1547     for each temp-gds-list no-lock
     1548       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     1549         break
     1550       by goods.artic :
     1551       run item-goods ( "1" , "goods" ) .
     1552         if return-value <> "" then next.
     1553     end.
     1554   end.
     1555     end.
     1556           when 3 then do:
     1557   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   if x-selectobject = "currency":u  or  xtog-obj then do:
     1559     for  each gds-obj
     1560         where  gds-obj.obj-code   = x-store-code
     1561           and  gds-obj.obj-type   = x-store-type
     1562                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1563                 no-lock ,
     1564     first g#cli
     1565           where gds-obj.prod-code  = g#cli.obj-code
     1566           and  gds-obj.prod-type   = g#cli.obj-type
     1567           no-lock,
     1568     first goods
     1569           where gds-obj.gds-code = goods.gds-code no-lock
     1570           break
     1571           by goods.artic :
     1572           run item-goods ( "1" , "goods" ) .
     1573           if return-value <> "" then next.
     1574         end.
     1575     end.
     1576     else do:
     1577       for each obj-list no-lock :
     1578             for  each gds-obj
     1579               where  gds-obj.obj-code   = obj-list.obj-code
     1580                 and  gds-obj.obj-type   = obj-list.obj-type
     1581                       and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1582                       no-lock ,
     1583             first g#cli
     1584                 where gds-obj.prod-code  = g#cli.obj-code
     1585                 and  gds-obj.prod-type   = g#cli.obj-type
     1586                 no-lock,
     1587             first goods
     1588                 where gds-obj.gds-code = goods.gds-code no-lock :
     1589                   if not can-find (first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     1590                       create temp-gds-list.
     1591                       assign
     1592                         temp-gds-list.prod-code = gds-obj.prod-code
     1593                         temp-gds-list.grp-name  = gds-obj.grp-name
     1594                         temp-gds-list.gds-name  = goods.gds-name
     1595                         temp-gds-list.gds-code  = gds-obj.gds-code
     1596                         temp-gds-list.artic     = gds-obj.artic
     1597                       .
     1598                   end.
     1599             end.
     1600       end.
     1601         for each temp-gds-list no-lock
     1602           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     1603             break
     1604               by goods.artic :
     1605           run item-goods ( "1" , "goods" ) .
     1606             if return-value <> "" then next.
     1607         end.
     1608   end.
     1609     end.
     1610           otherwise do:
     1611   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1612   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1613       for each gds-obj  where
     1614             gds-obj.obj-type = x-store-type  and
     1615             gds-obj.obj-code = x-store-code
     1616             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1617                   no-lock,
     1618             First goods  where  gds-obj.gds-code   = goods.gds-code
     1619         no-lock,
     1620   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     1621   no-lock
     1622   BREAK
     1623       BY (gds-list.artic) :
     1624         run item-goods ( "1" , "gds-list" ) .
     1625         if return-value <> "" then NEXT.
     1626       End.
     1627     END.
     1628     Else DO:
     1629      For each obj-list no-lock :
     1630                     FOR EACH gds-obj where
     1631                   gds-obj.obj-type = obj-list.obj-type    and
     1632                   gds-obj.obj-code = obj-list.obj-code
     1633                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1634                   no-lock,
     1635             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     1636                   no-lock :
     1637                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1638                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1639                       Create temp-gds-list.
     1640                       Assign
     1641                         temp-gds-list.prod-code = gds-obj.prod-code
     1642                         temp-gds-list.grp-name  = gds-obj.grp-name
     1643                         temp-gds-list.gds-name  = goods.gds-name
     1644                         temp-gds-list.gds-code  = gds-obj.gds-code
     1645                         temp-gds-list.artic     = gds-obj.artic
     1646                       .
     1647                   End.
     1648               End.
     1649     End.
     1650     for each temp-gds-list no-lock
     1651       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     1652         BREAK
     1653       BY gds-list.artic :
     1654       run item-goods ( "1" , "gds-list" ) .
     1655         if return-value <> "" then NEXT.
     1656     End.
     1657   End.
     1658           end.
     1659           end case.
     1660   end procedure.
     1661   PROCEDURE CalcItog :
     1662       run ostatok (
     1663           input x-store-code  ,
     1664           input x-store-type  , x-TOG-Shift,
     1665           input x-date-start - 1 ,
     1666           input date('')      ,  x-Shift-Start,x-Shift-End,
     1667           input 'crsa':U   ,
     1668           input '##,##':U,
     1669           input xTog-obj ,
     1670           output  Quantity1  ,
     1671           output  Coast_R1   ,
     1672           output  Coast_V1   ,
     1673           output  VAT_R1     ,
     1674           output  VAT_V1     ,
     1675           output  Fact-order-1 ).
     1676       run ostatok (
     1677           input x-store-code  ,
     1678           input x-store-type  , x-TOG-Shift,
     1679           input x-date-start  ,
     1680           input x-date-end    ,  x-Shift-Start,x-Shift-End,
     1681           input 'crsa':U   ,
     1682           input '##,##':U,
     1683           input xTog-obj      ,
     1684           output  Quantity2  ,
     1685           output  Coast_R2   ,
     1686           output  Coast_V2   ,
     1687           output  VAT_R2     ,
     1688           output  VAT_V2     ,
     1689           output  Fact-order-2 ).
     1690   END PROCEDURE.
     1691   PROCEDURE Display-title :
     1692       i=0.
     1693       run rep/extitle.p (1) .
     1694   END PROCEDURE.
     1695   PROCEDURE ob-line  :
     1696   def input  parameter x-store-code     like clients.obj-code      no-undo.
     1697   def input  parameter x-store-type     like clients.obj-type      no-undo.
     1698   def INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     1699   def INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     1700   def INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     1701   def INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     1702   def INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     1703   def input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     1704   def input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     1705   def input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     1706   def input  parameter xTog-obj         as log no-undo.
     1707   def input  parameter xi               as int no-undo.
     1708   def output  parameter Quntity          like ub.stk-line.fact-qnty   no-undo.
     1709   def output  parameter Summa            like ub.stk-line.sum-rubl   no-undo.
     1710   define variable  First-qnty  like ub.stk-line.fact-qnty  no-undo.
     1711   define variable  Second-qnty like ub.stk-line.fact-qnty  no-undo.
     1712   define variable  First-sum   like ub.stk-line.sum-rubl   no-undo.
     1713   define variable  Second-sum  like ub.stk-line.sum-rubl   no-undo.
     1714     Assign First-sum = 0 Second-sum = 0 First-qnty = 0 second-qnty = 0.
     1715     For EAch obj-list
     1716     where
     1717          (xTog-obj = TRUE AND (x-store-type     = obj-list.obj-type  AND  x-store-code     = obj-list.obj-code ) )
     1718          OR
     1719          (xTog-obj = FAlse AND ( can-find (first gds-obj where
     1720                                       gds-obj.obj-type = obj-list.obj-type    and
     1721                                       gds-obj.obj-code = obj-list.obj-code    AND
     1722                                       gds-obj.artic        = x-artic         AND
     1723                                       gds-obj.prod-code    = x-prod-code     AND
     1724                                       gds-obj.prod-type    = x-prod-type   No-lock use-index pi ) = TRUE ))
     1725               no-lock  :
     1726      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     1727         FIND LAST ub.stk-line where
     1728                                 ub.stk-line.artic        = x-artic
     1729                           AND   ub.stk-line.fact-order  <= x-fact-order-1
     1730                           AND   ub.stk-line.obj-code     = obj-list.obj-code
     1731                           AND   ub.stk-line.obj-type     = obj-list.obj-type
     1732                           AND   ub.stk-line.prod-code    = x-prod-code
     1733                           AND   ub.stk-line.prod-type    = x-prod-type
     1734                           AND   ub.stk-line.sum-type     = temp#sum-type.sum-type
     1735                           AND   ub.stk-line.cat-id       = '##,##':U
     1736                                 no-lock use-index pi no-error.
     1737              if available ub.stk-LINE THEN Assign First-qnty = First-qnty + ub.stk-line.fact-qnty
     1738                                                First-sum = First-sum
     1739                                                         + ( if tPrintRubl then              ub.stk-line.sum-rubl
     1740                                                                                        else ub.stk-line.sum-base    )
     1741                                                                                        .
     1742         FIND LAST STK-line2 where
     1743                                 STK-line2.artic        = x-artic
     1744                           AND   STK-line2.fact-order  <= x-fact-order-2
     1745                           AND   STK-line2.obj-code     = obj-list.obj-code
     1746                           AND   STK-line2.obj-type     = obj-list.obj-type
     1747                           AND   STK-line2.prod-code    = x-prod-code
     1748                           AND   STK-line2.prod-type    = x-prod-type
     1749                           AND   STK-line2.sum-type     = temp#sum-type.sum-type
     1750                           AND   STK-line2.cat-id       = '##,##':U
     1751                                 no-lock use-index pi  no-error.
     1752              if available STK-LINE2 THEN DO:
     1753                                                 Assign Second-qnty = Second-qnty + Stk-line2.fact-qnty
     1754                                                        Second-sum  = Second-sum
     1755                                                         + ( if tPrintRubl then              Stk-line2.sum-rubl
     1756                                                                                        else Stk-line2.sum-base    )
     1757                                                                                        .
     1758                                                  End.
     1759       End.
     1760      End.
     1761      Assign
     1762      Quntity = Second-qnty - first-qnty
     1763      Summa   = Second-sum  - first-sum .
     1764   END PROCEDURE.
     1765   procedure ost-line :
     1766     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1767     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1768     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1769     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1770     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1771     define input  parameter x-tog-shift  as logical no-undo .
     1772     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1773     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1774     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1775     define input  parameter xtog-obj     as logical no-undo .
     1776     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1777     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1778     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1779     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1780     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1781     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1782     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1783     define buffer buff-obj-list  for obj-list .
     1784     define buffer buff-stk-line  for ub.stk-line .
     1785     assign
     1786       Quantity = 0
     1787       Coast_R  = 0
     1788       Coast_V  = 0
     1789       VAT_R    = 0
     1790       VAT_V    = 0
     1791       SLT_R    = 0
     1792       SLT_V    = 0
     1793     .
     1794     if  x-tog-shift = false then do:
     1795       for each buff-obj-list no-lock
     1796         where xtog-obj = false
     1797            or (buff-obj-list.obj-type = x-store-type
     1798               and buff-obj-list.obj-code = x-store-code
     1799               )
     1800       on error undo, return error
     1801       :
     1802       find last buff-stk-line no-lock
     1803         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1804           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1805           and buff-stk-line.artic      = x-artic
     1806           and buff-stk-line.prod-type  = x-prod-type
     1807           and buff-stk-line.prod-code  = x-prod-code
     1808           and buff-stk-line.sum-type   = x-sum-type
     1809           and buff-stk-line.cat-id     = '##,##':U
     1810           and buff-stk-line.fact-order <= x-fact-order
     1811           and buff-stk-line.shift-num  = 0
     1812         use-index category
     1813         no-error .
     1814       if available buff-stk-line then do:
     1815         assign
     1816           Quantity = Quantity + buff-stk-line.fact-qnty
     1817           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1818           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1819           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1820           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1821           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1822           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1823         .
     1824       end.
     1825      end.
     1826     end.
     1827     else do:
     1828       for each buff-obj-list no-lock
     1829         where xtog-obj = false
     1830            or (buff-obj-list.obj-type = x-store-type
     1831               and buff-obj-list.obj-code = x-store-code
     1832               )
     1833       on error undo, return error
     1834       :
     1835         find last buff-stk-line no-lock
     1836           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1837             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1838             and buff-stk-line.artic      = x-artic
     1839             and buff-stk-line.prod-type  = x-prod-type
     1840             and buff-stk-line.prod-code  = x-prod-code
     1841             and buff-stk-line.sum-type   = x-sum-type
     1842             and buff-stk-line.cat-id     = '##,##':U
     1843             and buff-stk-line.fact-order <= x-fact-order
     1844             and buff-stk-line.shift-num  > 0
     1845           use-index category
     1846           no-error .
     1847         if available buff-stk-line then do:
     1848           assign
     1849             Quantity = Quantity +  buff-stk-line.fact-qnty
     1850             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1851             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1852             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1853             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1854             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1855             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1856           .
     1857         end.
     1858       end.
     1859     end.
     1860   end procedure.
     1861   procedure ost-lineother-tax :
     1862     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1863     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1864     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1865     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1866     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1867     define input  parameter x-tog-shift  as logical no-undo .
     1868     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1869     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1870     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1871     define input  parameter xTog-obj     as logical no-undo .
     1872     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1873     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1874     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1875     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1876     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1877     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1878     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1879     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1880     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1881     define buffer buff-obj-list  for obj-list .
     1882     define buffer buff-stk-line  for ub.stk-line .
     1883     assign
     1884       Quantity = 0
     1885       Coast_R  = 0
     1886       Coast_V  = 0
     1887       VAT_R    = 0
     1888       VAT_V    = 0
     1889       SLT_R    = 0
     1890       SLT_V    = 0
     1891       other_R  = 0
     1892       other_V  = 0
     1893     .
     1894     if  x-tog-shift = false then do:
     1895       for each buff-obj-list no-lock
     1896         where xtog-obj = false
     1897            or (buff-obj-list.obj-type = x-store-type
     1898               and buff-obj-list.obj-code = x-store-code
     1899               )
     1900       on error undo, return error
     1901       :
     1902       find last buff-stk-line no-lock
     1903         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1904           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1905           and buff-stk-line.artic      = x-artic
     1906           and buff-stk-line.prod-type  = x-prod-type
     1907           and buff-stk-line.prod-code  = x-prod-code
     1908           and buff-stk-line.sum-type   = x-sum-type
     1909           and buff-stk-line.cat-id     = '##,##':U
     1910           and buff-stk-line.fact-order <= x-fact-order
     1911           and buff-stk-line.shift-num  = 0
     1912         use-index category
     1913         no-error .
     1914       if available buff-stk-line then do:
     1915         assign
     1916           Quantity = Quantity + buff-stk-line.fact-qnty
     1917           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1918           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1919           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1920           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1921           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1922           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1923           other_R  = other_R  + buff-stk-line.other-rubl
     1924           other_V  = other_V  + buff-stk-line.other-base
     1925         .
     1926       end.
     1927    end.
     1928     end.
     1929     else do:
     1930       for each buff-obj-list no-lock
     1931         where xtog-obj = false
     1932            or (buff-obj-list.obj-type = x-store-type
     1933               and buff-obj-list.obj-code = x-store-code
     1934               )
     1935       on error undo, return error
     1936       :
     1937         find last buff-stk-line no-lock
     1938           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1939             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1940             and buff-stk-line.artic      = x-artic
     1941             and buff-stk-line.prod-type  = x-prod-type
     1942             and buff-stk-line.prod-code  = x-prod-code
     1943             and buff-stk-line.sum-type   = x-sum-type
     1944             and buff-stk-line.cat-id     = '##,##':U
     1945             and buff-stk-line.fact-order <= x-fact-order
     1946             and buff-stk-line.shift-num  > 0
     1947           use-index category
     1948           no-error .
     1949         if available buff-stk-line then do:
     1950           assign
     1951             Quantity = Quantity +  buff-stk-line.fact-qnty
     1952             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1953             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1954             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1955             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1956             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1957             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1958             other_R = other_R   +  buff-stk-line.other-rubl
     1959             other_V = other_V   +  buff-stk-line.other-base
     1960           .
     1961         end.
     1962       end.
     1963     end.
     1964   end procedure.
     1965   procedure ost-line-kg :
     1966     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1967     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1968     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1969     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1970     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1971     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1972     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1973     define buffer buff-obj-list  for obj-list .
     1974     define buffer buf_doc-line for ub.doc-line .
     1975     define buffer buf_inv-line for ub.inv-line .
     1976     do
     1977     on error undo, return error
     1978     :
     1979       for each buf_doc-line no-lock where
     1980                buf_doc-line.obj-type    = p-obj-type   and
     1981                buf_doc-line.obj-code    = p-obj-code   and
     1982                buf_doc-line.prod-type   = p-prod-type  and
     1983                buf_doc-line.prod-code   = p-prod-code  and
     1984                buf_doc-line.artic       = p-artic      and
     1985                buf_doc-line.status_     = 'факт':U      and
     1986                buf_doc-line.fact-order <= p-fact-order
     1987             by buf_doc-line.fact-order    descending
     1988       :
     1989         find first buf_inv-line no-lock where
     1990                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1991                    buf_inv-line.artic     = buf_doc-line.artic     and
     1992                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1993                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1994         if available buf_inv-line
     1995         then do:
     1996           if buf_inv-line.after-cli-qnty <> ?
     1997           then do:
     1998             assign
     1999               p-quantity-kg = buf_inv-line.after-cli-qnty
     2000             .
     2001             leave .
     2002           end.
     2003         end.
     2004       end.
     2005       if p-quantity-kg = ?
     2006       then do:
     2007         assign
     2008           p-quantity-kg = 0
     2009         .
     2010       end.
     2011     end.
     2012   end procedure.
     2013   PROCEDURE ostatok :
     2014   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2015   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2016   def input parameter x-tog-shift   as   logical             no-undo.
     2017   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2018   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2019   def input parameter x-shift-start as integer               no-undo.
     2020   def input parameter x-shift-end   as integer               no-undo.
     2021   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2022   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2023   def input parameter xTog-obj   as log no-undo.
     2024   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2025   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2026   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2027   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2028   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2029   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2030   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2031   def var              Fact-orderS   as char  no-undo.
     2032   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2033      Assign
     2034         Fact-order   = 0
     2035         Quantity     = 0
     2036         Coast_R      = 0
     2037         Coast_V      = 0
     2038         VAT_R        = 0
     2039         VAT_V        = 0 .
     2040    x-date-start-t  = x-date-start + 1 .
     2041   IF x-date-end = date('') then DO:
     2042      Fact-order = 0 .
     2043      for each obj-list
     2044          where  ( not xtog-obj or
     2045                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2046                 no-lock :
     2047         if  x-tog-shift = false then do:
     2048                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2049                               ub.stk-tot.Fact-date <=  x-date-start
     2050                               and ub.stk-tot.shift-num = 0
     2051                               USE-INDEX fact-date no-lock no-error .
     2052              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2053         End.
     2054         Else  DO :
     2055             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2056              (ub.stk-tot.shift-date  = x-date-start-t and
     2057               ub.stk-tot.shift-num  < x-shift-start or
     2058               ub.stk-tot.shift-date  < x-date-start-t  )
     2059               and ub.stk-tot.shift-num  > 0
     2060               USE-INDEX Shift-num no-lock no-error .
     2061            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2062           END.
     2063       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2064     End.
     2065   End.
     2066   Else DO:
     2067     For each obj-list  WHERE
     2068        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2069         no-lock :
     2070      IF  x-TOG-Shift = False Then DO:
     2071          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2072               ub.stk-tot.Fact-date <= x-date-end
     2073               and ub.stk-tot.shift-num = 0
     2074               USE-INDEX fact-date no-lock no-error.
     2075          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2076      END.
     2077      Else DO:
     2078           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2079               (ub.stk-tot.shift-date  = x-date-end and
     2080               ub.stk-tot.shift-num  <= x-shift-end or
     2081               ub.stk-tot.shift-date  < x-date-end       ) and
     2082               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2083               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2084       End.
     2085       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2086     End.
     2087   End.
     2088   END PROCEDURE.
     2089   PROCEDURE report-exec1  :
     2090   fOR EACH TMP#bs SHARE-LOCK:
     2091       DELETE TMP#bs.
     2092   END.
     2093   ASSIGN
     2094    RR = 0
     2095    Q3 = 0
     2096    Q4 = 0
     2097    cOAST3 = 0
     2098    cOAST4 = 0.
     2099      FIND FIRST clients where x-store-type = clients.obj-type AND
     2100                               x-store-code = clients.obj-code no-lock no-error.
     2101              If available clients then  ObjName = clients.obj-name.
     2102                                            else  ObjName="объект не определен".
     2103   run waitfram-show(objname) .
     2104     FORM with FRAME zapas .
     2105     run calcitog.
     2106     run print-header.
     2107     run run1.
     2108     run printtemptable.
     2109     run print-footer.
     2110    END PROCEDURE.
     2111   PROCEDURE Item-Goods :
     2112    def input parameter  par-3 as char no-undo.
     2113    def input parameter  par-4 as char no-undo.
     2114         if par-4 = "goods":U  Then
     2115                                   assign
     2116                                       gds-zap-prt-root   = Goods.prt-root
     2117                                       gds-zap-prod-type  = Goods.prod-type
     2118                                       gds-zap-prod-code  = Goods.prod-code
     2119                                       gds-zap-artic      = Goods.artic
     2120                                       gds-zap-grp-name   = Goods.grp-name
     2121                                       gds-zap-b-code     = Goods.gds-code
     2122                                       gds-zap-gds-name   = if g#gds-engl then Goods.engl-name
     2123                                                                          else Goods.gds-name.
     2124        if par-4 = "gds-list":U  Then
     2125                                   assign
     2126                                       gds-zap-prt-root   = gds-list.prt-root
     2127                                       gds-zap-prod-type  = gds-list.prod-type
     2128                                       gds-zap-prod-code  = gds-list.prod-code
     2129                                       gds-zap-artic      = gds-list.artic
     2130                                       gds-zap-grp-name   = gds-list.grp-name
     2131                                       gds-zap-b-code     = gds-list.gds-code
     2132                                       gds-zap-gds-name   = if g#gds-engl then Gds-list.engl-name
     2133                                                                          else Gds-list.gds-name.
     2134             FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND
     2135                                      clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     2136                                      gds-zap-prod-name  = clients.obj-name .
     2137      run foreach.
     2138   END PROCEDURE.
     2139   Procedure maket :
     2140   if tog-ras then DO:
     2141     Create temp#sum-type no-error.
     2142     Assign temp#sum-type.sum-type = type-arh + 'ee':U       temp#sum-type.xi = 1      .
     2143   End.
     2144   if tog-voz then DO:
     2145     Create temp#sum-type no-error.
     2146     Assign temp#sum-type.sum-type = type-arh + 're':U   temp#sum-type.xi = 1      .
     2147   End.
     2148   if tog-kass then DO:
     2149     Create temp#sum-type no-error.
     2150     Assign temp#sum-type.sum-type = type-arh + 'es':U       temp#sum-type.xi = 1      .
     2151     Create temp#sum-type no-error.
     2152     Assign temp#sum-type.sum-type = type-arh + 'rs':U   temp#sum-type.xi = 1      .
     2153     End.
     2154    End procedure.
     2155   PROCEDURE Eqq :
     2156   define variable TTT like TMP#bs.grp-name no-undo.
     2157      Assign
     2158       TMP#bs.sub-artic     = SUBSTRING (gds-zap-artic,2,3)
     2159       TMP#bs.b-code        =  gds-zap-b-code
     2160       TMP#bs.artic         =  gds-zap-artic
     2161       TMP#bs.gds-name      =  gds-zap-gds-name
     2162       TMP#bs.prod-name     =  gds-zap-prod-name
     2163       TMP#bs.prt-root      =  gds-zap-prt-root
     2164       TMP#bs.r-qnty        =  v#r-qnty[1]
     2165       TMP#bs.r-qnty2       =  v#r-qnty[2]
     2166       TMP#bs.r-qnty3       =  v#r-qnty[3]
     2167       TMP#bs.r-qnty4       =  v#r-qnty[4]
     2168       TMP#bs.r-qnty5       =  v#r-qnty[5]
     2169       TMP#bs.r-qnty6       =  v#r-qnty[6]
     2170       TMP#bs.avr-qnty      =  v#r-qnty[1] / (Integer(x-date-end - x-date-start) + 1 )
     2171       TMP#bs.r-sum         =  v#r-sUM[1]
     2172       TMP#bs.r-sum2        =  v#r-sUM[2]
     2173       TMP#bs.r-sum3        =  v#r-sUM[3]
     2174       TMP#bs.r-sum4        =  v#r-sUM[4]
     2175       TMP#bs.r-sum5        =  v#r-sUM[5]
     2176       TMP#bs.r-sum6        =  v#r-sUM[6]
     2177       TMP#bs.avr-sum       =  v#r-sum[1] / (Integer( x-date-end - x-date-start) + 1 )
     2178        .
     2179        TTT     =  IF  xtog-lavel = False THEN gds-zap-grp-name  Else  n-lavel(INPUT gds-zap-grp-name, Input xLavel ).
     2180        TMP#bs.grp-name      =  TTT.
     2181   END PROCEDURE.
     2182   PROCEDURE PrintTempTable :
     2183   define variable i as int init 0  no-undo.
     2184       For each TMP#bs  where TMP#bs.r-qnty <> 0
     2185       Break by (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U )
     2186       by
     2187       (if xSorttype = "sort-code":U  THEN string(TMP#bs.b-code)
     2188          ELSE if xSorttype = "sort-artic":U  THEN TMP#bs.artic
     2189             ELSE if xSorttype = "sort-qunty":U  THEN string(( TMP#bs.r-qnty),"-9999999999.999")
     2190                ELSE if xSorttype = "sort-name":U  THEN TMP#bs.gds-name
     2191                      ELSE  TMP#bs.sub-artic ) :
     2192                   i = i + 1 .
     2193                   proc# = 100.
     2194       if xClassify = "grp-goods":U Then DO:
     2195          Accumulate Tmp#bs.r-qnty (TOTAL BY (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U )  ).
     2196          Accumulate Tmp#bs.r-sum (TOTAL BY (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U )  ).
     2197         If FIRST-OF( (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U ) ) Then DO:
     2198                if Make-Excel then  put   stream ForExcel unformatted    'Группа ' CHR(9) TMP#bs.grp-name skip.
     2199               END.
     2200      End.
     2201          if Make-Excel then  put   stream ForExcel unformatted
     2202           TMP#bs.artic                  CHR(9)
     2203           TMP#bs.gds-name               CHR(9)
     2204           excel-qnty(decimal(( TMP#bs.r-qnty / Q4 ) * 100 )) CHR(9)
     2205           excel-qnty(decimal(TMP#bs.r-qnty                )) CHR(9)
     2206           excel-sum(decimal (TMP#bs.r-sum                 )) CHR(9)
     2207           excel-qnty(decimal(TMP#bs.avr-qnty              )) CHR(9)
     2208           excel-sum(decimal (TMP#bs.avr-sum               )) CHR(9)
     2209           if tog-1  then
     2210            (excel-qnty(decimal(TMP#bs.r-qnty2 )) + CHR(9) +
     2211             excel-qnty(decimal(TMP#bs.r-sum2  )) + CHR(9) +
     2212             excel-sum(decimal (TMP#bs.r-qnty3 )) + CHR(9) +
     2213             excel-qnty(decimal(TMP#bs.r-sum3  )) + CHR(9) +
     2214             excel-sum(decimal (TMP#bs.r-qnty4 )) + CHR(9) +
     2215             excel-qnty(decimal(TMP#bs.r-sum4  )) + CHR(9) +
     2216             excel-qnty(decimal(TMP#bs.r-qnty5 )) + CHR(9) +
     2217             excel-sum(decimal (TMP#bs.r-sum5  )) + CHR(9) +
     2218             excel-qnty(decimal(TMP#bs.r-qnty6 )) + CHR(9) +
     2219             excel-sum(decimal (TMP#bs.r-sum6  )) + CHR(9) )
     2220           else ""
     2221           skip.
     2222        if xClassify = "grp-goods":U Then DO:
     2223           IF LAST-OF( (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U )  )  THEN DO:
     2224               if Make-Excel then  put   stream ForExcel unformatted
     2225               'ИТОГО по группе :'  CHR(9)
     2226               TMP#bs.grp-name      CHR(9)
     2227               excel-qnty(decimal( ((ACCUM TOTAL BY (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U ) Tmp#bs.r-qnty) / Q4 ) * 100                                )) CHR(9)
     2228               excel-qnty(decimal( ACCUM   TOTAL BY (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U ) Tmp#bs.r-qnty                                              )) CHR(9)
     2229               excel-sum(decimal ( ACCUM   TOTAL BY (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U ) Tmp#bs.r-sum                                               )) CHR(9)
     2230               excel-qnty(decimal( (ACCUM  TOTAL BY (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U ) Tmp#bs.r-qnty) / (Integer(x-date-end - x-date-start) + 1 ) )) CHR(9)
     2231               excel-sum(decimal ( (ACCUM  TOTAL BY (if xClassify = "grp-goods":U Then TMP#bs.grp-name  Else "1":U ) Tmp#bs.r-sum) /  (Integer(x-date-end - x-date-start) + 1 ) )) CHR(9)
     2232               skip.
     2233           End.
     2234        End.
     2235       End.
     2236       run u-line.
     2237   END PROCEDURE.
     2238   PROCEDURE display-line-tMP :
     2239   def input parameter i as int no-undo.
     2240   END PROCEDURE.
