      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   define variable v-waitfram-action01         as character   no-undo .
      645   define variable v-waitfram-action02         as character   no-undo .
      646   define variable v-waitfram-action03         as character   no-undo .
      647   define variable mWaitFramTextBeg            as character   no-undo.
      648   define variable mWaitFramTextEnd            as character   no-undo.
      649   define variable mWaitFramView               as logical     no-undo.
      650   define variable mWaitProcEvent              as logical     no-undo init yes.
      651   define variable mWaitFramInterval           as integer     no-undo init 1 .
      652   define variable mWaitFramStop               as logical     no-undo.
      653   define variable mWaitFramStopUser           as logical     no-undo.
      654   define variable mWaitFramStopTimeOut        as logical     no-undo.
      655   define variable mWaitFramStartProc          as datetime-tz no-undo.
      656   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      657   define button B-WaitFramStop auto-end-key
      658        label "Стоп"
      659        size 10 by 1 tooltip "Остоновить процесс".
      660   define button B-viewProcInfo
      661        label "Информация"
      662        size 15 by 1 tooltip "Информация о процесс".
      663   define frame waitfram
      664     v-waitfram-action01 format "x(72)" no-label skip
      665     v-waitfram-action02 format "x(72)" no-label skip
      666     v-waitfram-action03 format "x(72)" no-label skip
      667     B-viewProcInfo
      668     B-WaitFramStop at row 4 col 30
      669     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      670     .
      671   define new global shared variable mBatchMode as logical no-undo init ?.
      672   define variable mFramBachModHandle as handle no-undo.
      673   mFramBachModHandle = frame waitfram:handle.
      674   define variable mFameOldVis as logical no-undo.
      675   define variable mVisCUrentVin as logical no-undo.
      676   if session:batch-mode
      677   then
      678      mBatchMode = yes.
      679   if mBatchMode = ? then do:
      680     mVisCUrentVin = current-window:visible.
      681     mFameOldVis = mFramBachModHandle:visible.
      682     mFramBachModHandle:visible  = yes.
      683     mBatchMode = mFramBachModHandle:visible ne yes.
      684     mFramBachModHandle:visible = mFameOldVis.
      685     current-window:visible = mVisCUrentVin.
      686   end.
      687    if  log-manager:logfile-name ne ?
      688     then DO:
      689         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      690         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      691         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      692     end.
      693   on choose of B-WaitFramStop in frame waitfram
      694   do:
      695     mWaitFramStop = yes.
      696     mWaitFramStopUser = yes.
      697   end.
      698   function waitfram-check-timeout returns logical():
      699      define variable vtime as int64 no-undo.
      700      if mWaitFramStopTimeOut
      701      then
      702         return yes.
      703      vtime = ( now - mWaitFramStartProc ) / 1000 .
      704      if     mWaitFramTimeOut ne ?
      705         and mWaitFramTimeOut ne 0
      706         and mWaitFramTimeOut lt vtime
      707      then do:
      708         mWaitFramStopTimeOut = yes.
      709      end.
      710      return mWaitFramStopTimeOut.
      711   end.
      712   procedure waitfram-hide :
      713     if not session:batch-mode
      714     then do
      715     on error undo, return error return-value
      716     :
      717       pause 0 before-hide .
      718       if not mBatchMode then
      719         hide frame waitfram .
      720     if     not mWaitFramView
      721        and mWaitProcEvent
      722     then
      723       process events .
      724     end.
      725   end procedure.
      726   procedure waitfram-show :
      727     define input  parameter p-message as character no-undo .
      728     define variable v-left-margin as integer   no-undo .
      729     if not session:batch-mode
      730     then do
      731     on error undo, return error return-value
      732     :
      733       if length(p-message) <= 70 then do:
      734         assign
      735           v-left-margin = integer((70 - length(p-message)) / 2)
      736         .
      737         assign
      738           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      739         .
      740         assign
      741           v-waitfram-action01 = " "
      742           v-waitfram-action02 = " "
      743                                    + fill(" ", v-left-margin)
      744                                    + p-message
      745           v-waitfram-action03 = " "
      746         .
      747       end.
      748       else do:
      749         define variable vRindex1 as integer no-undo.
      750         define variable vRindex2 as integer no-undo.
      751         vRindex1 = r-index(p-message," ",70).
      752         if vRindex1 = 0
      753         then
      754            vRindex1 = 70.
      755         if length(p-message)  <= vRindex1 + 70 then do:
      756           assign
      757             v-waitfram-action01 = " "
      758             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      759             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      760           .
      761         end.
      762         else do:
      763           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      764           if vRindex2 <= vRindex1
      765           then
      766              vRindex2 = vRindex1 + 70.
      767           assign
      768             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      769             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      770             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      771           .
      772         end.
      773       end.
      774       B-viewProcInfo:visible   in frame waitfram = no.
      775       B-viewProcInfo:sensitive in frame waitfram = no.
      776       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      777       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      778       if  (   mWaitFramView
      779          or  mWaitProcEvent)
      780          and not mBatchMode
      781       then
      782          display
      783             v-waitfram-action01 skip
      784             v-waitfram-action02 skip
      785             v-waitfram-action03 skip
      786          with frame waitfram .
      787       if     mWaitFramView
      788          then do:
      789             if     mWaitFramInterval ne ?
      790                and not mBatchMode
      791             then
      792                wait-for go of frame waitfram pause mWaitFramInterval.
      793          end.
      794          else
      795             if     mWaitProcEvent
      796                and not mBatchMode
      797             then
      798                process events .
      799     end.
      800   end procedure.
      801      procedure waitfram-show-this:
      802         define input  parameter iInterval as int64 no-undo.
      803         define variable vtime as int64 no-undo.
      804         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      805         mWaitFramInterval = iInterval.
      806         run waitfram-show (substitute("&1&2 &3&4" ,
      807                                       mWaitFramTextBeg ,
      808                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      809                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      810                                       mWaitFramTextEnd
      811                                      )
      812                           ).
      813      end.
      814      procedure WaitFramRunPause:
      815         define input  parameter iInterval as dec no-undo.
      816         define variable vStart  as datetime-tz no-undo.
      817         define variable vend    as datetime-tz no-undo.
      818         define variable vint as int64 no-undo.
      819         define variable vOk as logical no-undo.
      820         vStart = now.
      821         vend   = vStart.
      822         publish "WaitFramPause" (iInterval,output vOk).
      823         vend   =  now.
      824         vint = vend - vStart.
      825         vint = iInterval - vint / 1000.
      826         if     not mWaitFramStop
      827            and (   vint > 0
      828                 or (    not vOk
      829                     and iInterval eq ?
      830                     )
      831                 )
      832         then
      833            run waitfram-show-this (iInterval).
      834         vend   =  now.
      835         vint = vend - vStart.
      836         vint = iInterval - vint / 1000.
      837         if     not mWaitFramStop
      838            and vint > 0
      839         then do:
      840            run gbl/pause.p (vint * 1000).
      841         end.
      842         if iInterval ne ?
      843         then
      844            publish "WaitFramStop".
      845         waitfram-check-timeout().
      846      end.
      847      procedure WaitFramWaitFor:
      848         define input  parameter iInterval as dec no-undo.
      849         assign
      850            mWaitFramStartProc   = now
      851            mWaitFramStopUser    = no
      852            mWaitFramStopTimeOut = no
      853         .
      854         block-wait:
      855         do while not mWaitFramStop:
      856            run WaitFramRunPause (iInterval).
      857            if  waitfram-check-timeout()
      858            then do:
      859               leave block-wait.
      860            end.
      861         end.
      862         run waitfram-hide.
      863      end.
      864   procedure waitfram-join :
      865     define input  parameter p-line-1  as character no-undo .
      866     define input  parameter p-line-2  as character no-undo .
      867     define input  parameter p-line-3  as character no-undo .
      868     define output parameter p-message as character no-undo .
      869     do
      870     on error undo, return error return-value
      871     :
      872       assign
      873         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      874                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      875                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      876       .
      877     end.
      878   end procedure.
      879   function waitfram-join-function returns character
      880     (input p-line-1 as character
      881     ,input p-line-2 as character
      882     ,input p-line-3 as character
      883     ).
      884     define variable v-message as character no-undo .
      885     run waitfram-join in this-procedure
      886       (input  p-line-1
      887       ,input  p-line-2
      888       ,input  p-line-3
      889       ,output v-message
      890       ) .
      891     return v-message .
      892   end function .
      893   DEFINE VARIABLE doc-num like ub.trn-doc.doc-code no-undo.
      894   DEFINE VARIABLE is-out as decimal no-undo.
      895   DEFINE VARIABLE is-prihod as logical no-undo.
      896   DEFINE VARIABLE is-rashod as logical no-undo.
      897   DEFINE VARIABLE prt-qnty as decimal no-undo.
      898   define buffer for-doc for ub.trn-doc.
      899   define buffer for-line for ub.doc-line.
      900   define buffer in-parts for ub.parts.
      901   define buffer b-temp-goods for temp-goods.
      902   DEFINE VARIABLE my-accum as integer no-undo .
      903   DEFINE VARIABLE all-obj-type as character no-undo.
      904   DEFINE VARIABLE all-obj-code as integer no-undo.
      905   DEFINE VARIABLE for-part-code like ub.parts.part-code no-undo.
      906   DEFINE VARIABLE is-twounit as logical no-undo .
      907   DEFINE VARIABLE first-find as logical no-undo .
      908   DEFINE VARIABLE         v-supp-type     like ub.parts-attr.supp-type        no-undo .
      909   DEFINE VARIABLE         v-supp-code     like ub.parts-attr.supp-code        no-undo .
      910   DEFINE VARIABLE         v-in-code       like ub.parts-attr.income-in-code   no-undo .
      911   DEFINE VARIABLE         v-part-code     like ub.parts-attr.part-code        no-undo .
      912   DEFINE VARIABLE         v-gds-code      like ub.parts-attr.gds-code         no-undo .
      913   DEFINE VARIABLE         v-price-cli     like ub.parts-attr.price-cli        no-undo .
      914   DEFINE VARIABLE         v-cli-base-rate like ub.parts-attr.cli-base-rate    no-undo .
      915   DEFINE VARIABLE         v-obj-type      like ub.parts-attr.obj-type         no-undo .
      916   DEFINE VARIABLE         v-obj-code      like ub.parts-attr.obj-code         no-undo .
      917   DEFINE VARIABLE         v-vat-type      like ub.parts-attr.vat-type         no-undo .
      918   DEFINE VARIABLE         v-slt-type      like ub.parts-attr.slt-type         no-undo .
      919   DEFINE VARIABLE         v-vat-pc        like ub.parts-attr.vat-pc           no-undo .
      920   DEFINE VARIABLE         v-slt-pc        like ub.parts-attr.slt-pc           no-undo .
      921   DEFINE VARIABLE         v-fact-qnty     like ub.parts-attr.fact-qnty        no-undo .
      922   DEFINE VARIABLE         v-qnty          like ub.parts-attr.doc-qnty         no-undo .
      923   DEFINE VARIABLE         v-fact-date     like ub.parts-attr.fact-date        no-undo .
      924   DEFINE VARIABLE         v-exch-code     like ub.parts-attr.exch-code        no-undo .
      925   DEFINE VARIABLE         v-inv           as logical                          no-undo .
      926   DEFINE VARIABLE         v-real-is-prihod as logical no-undo .
      927   DEFINE VARIABLE         v-real-is-rashod as logical no-undo .
      928   define buffer buf_parts-attr for ub.parts-attr.
      929   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      930      define variable loc-price-without-abs        like ub.doc-line.price-base no-undo.
      931      define variable loc-price-slt                like ub.doc-line.price-base no-undo.
      932      define variable loc-price-vat                like ub.doc-line.price-base no-undo.
      933      define variable loc-price-no-vat-slt         like ub.doc-line.price-base no-undo.
      934      define variable loc-price-cli-netto          like ub.doc-line.price-base no-undo.
      935   if pnum-obj > 1 then
      936   assign
      937   all-obj-type = ""
      938   all-obj-code = 0
      939   .
      940   else do:
      941     find first obj-list No-LOCK No-ERROR.
      942     if avail obj-list then do:
      943       assign
      944       all-obj-type = obj-list.obj-type
      945       all-obj-code = obj-list.obj-code
      946       .
      947     end.
      948   end.
      949   FOR EACH temp-goods:
      950     delete temp-goods.
      951   END.
      952   FOR EACH obj-list NO-LOCK:
      953     FOR EACH for-doc No-LOCK WHERE
      954             for-doc.obj-type = obj-list.obj-type AND
      955             for-doc.obj-code = obj-list.obj-code AND
      956             for-doc.fact-date >= X-date-start AND
      957             for-doc.fact-date <= X-date-end AND
      958             for-doc.status_ = 'факт':U:
      959       if for-doc.office then NEXT.
      960       if LOOKUP(for-doc.ext-doc-type, 'iv,rv,ev':U + 'ap,pc':U) > 0 then NEXT.
      961       assign
      962       doc-num = for-doc.doc-code
      963       is-out = if LOOKUP(for-doc.ext-doc-type, 'ie,re,rs,vt,im':U) > 0  then 1 else -1
      964       is-prihod = if (for-doc.ext-doc-type = 'ie':U OR
      965                       for-doc.ext-doc-type = 'ep':U
      966                       )
      967                   then yes else no
      968       is-rashod = NOt is-prihod
      969       .
      970   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      971   FOR  each for-line NO-LOCk WHERE
      972             for-line.doc-code = doc-num:
      973   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      974   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run doclicod in g#library
      975     (input  recid(for-line)
      976     ,output v-gds-code
      977     ) no-error .
      978     if error-status:error then do:
      979       next.
      980     end.
      981     my-accum = my-accum + 1.
      982     IF my-accum MODULO 50  = 0 then do:
      983       run waitfram-show in this-procedure ("Обработано " + string(my-accum) + " партий ").
      984     end.
      985     FOR EACH ub.parts NO-LOCK WHERE
      986             ub.parts.artic = for-line.artic AND
      987             ub.parts.prod-type = for-line.prod-type AND
      988             ub.parts.prod-code = for-line.prod-code AND
      989             ub.parts.out-code = doc-num AND
      990             ub.parts.obj-type = for-line.obj-type AND
      991             ub.parts.obj-code = for-line.obj-code :
      992       first-find = yes.
      993       FIND FIRST ub.goods No-LOCK WHERE
      994                   ub.goods.artic = for-line.artic AND
      995                   ub.goods.prod-type = for-line.prod-type AND
      996                   ub.goods.prod-code = for-line.prod-code No-ERROR.
      997       find first buf_parts-attr no-lock where
      998                  buf_parts-attr.in-code = ub.parts.in-code
      999              AND buf_parts-attr.gds-code = v-gds-code
     1000              AND buf_parts-attr.part-code = ub.parts.part-code no-error .
     1001       if avail buf_parts-attr then do:
     1002         IF buf_parts-attr.is-supp = no  then NEXT.
     1003         if not can-find(FIRST cli-list where
     1004                               cli-list.obj-type = buf_parts-attr.supp-type AND
     1005                               cli-list.obj-code = buf_parts-attr.supp-code) then NEXT.
     1006         assign
     1007         v-in-code = buf_parts-attr.income-in-code
     1008         v-part-code = buf_parts-attr.income-part-code
     1009         v-supp-type = buf_parts-attr.supp-type
     1010         v-supp-code = buf_parts-attr.supp-code
     1011         v-inv       = (buf_parts-attr.ext-doc-type = 'vt':U or buf_parts-attr.ext-doc-type = 'vp':U)
     1012         .
     1013       end.
     1014       else do:
     1015         IF ub.parts.is-supp = no  then NEXT.
     1016         if not can-find(FIRST cli-list where
     1017                               cli-list.obj-type = ub.parts.supp-type AND
     1018                               cli-list.obj-code = ub.parts.supp-code) then NEXT.
     1019         assign
     1020         v-in-code = ub.parts.in-code
     1021         v-part-code = ub.parts.part-code
     1022         v-supp-type = buf_parts-attr.supp-type
     1023         v-supp-code = buf_parts-attr.supp-code
     1024         v-inv       = ub.parts.doc-type = 'инв':U
     1025         .
     1026       end.
     1027       if v-in-code <> ub.parts.out-code then do:
     1028         find first ub.units No-LOCK WHERE
     1029                     ub.units.unit-name = ub.goods.unit-base NO-ERROR.
     1030         if avail ub.units and lookup('2ед':U, ub.units.type ) > 0
     1031         then do:
     1032           assign
     1033           is-twounit = yes
     1034           for-part-code = substr(v-part-code, 1, index(v-part-code, '#':U) - 1)
     1035           .
     1036         end.
     1037         else do:
     1038           assign
     1039           is-twounit = no
     1040           for-part-code = v-part-code
     1041           .
     1042         end.
     1043       end.
     1044       else do:
     1045         assign
     1046         is-twounit = no
     1047         FOR-PART-CODE = v-PART-CODE.
     1048       end.
     1049       FIND FIRST b-temp-goods WHERE
     1050                 b-temp-goods.artic = for-line.artic AND
     1051                 b-temp-goods.prod-type = for-line.prod-type AND
     1052                 b-temp-goods.prod-code = for-line.prod-code AND
     1053                 b-temp-goods.supp-type = v-supp-type AND
     1054                 b-temp-goods.supp-code = v-supp-code AND
     1055                 b-temp-goods.in-code = v-in-code AND
     1056                 b-temp-goods.part-code = FOR-part-code AND
     1057                 b-temp-goods.obj-type = all-obj-type AND
     1058                 b-temp-goods.obj-code = all-obj-code
     1059                 No-error.
     1060       IF not avail b-temp-goods then do:
     1061         if avail buf_parts-attr then do:
     1062           if ( (pcurr-code <> ?) AND (buf_parts-attr.exch-code <> pcurr-code) ) then NEXT.
     1063           FIND FIRST ub.currency No-LOCK WHERE
     1064                     ub.currency.curr-code = buf_parts-attr.exch-code No-ERROR.
     1065           assign
     1066           v-price-cli = buf_parts-attr.price-cli
     1067           v-cli-base-rate = buf_parts-attr.cli-base-rate
     1068           v-obj-type = buf_parts-attr.obj-type
     1069           v-obj-code = buf_parts-attr.obj-code
     1070           v-vat-type = buf_parts-attr.vat-type
     1071           v-slt-type = buf_parts-attr.slt-type
     1072           v-vat-pc   = buf_parts-attr.vat-pc
     1073           v-slt-pc   = buf_parts-attr.slt-pc
     1074           v-fact-qnty = buf_parts-attr.fact-qnty
     1075           v-qnty      = buf_parts-attr.doc-qnty
     1076           v-exch-code = buf_parts-attr.exch-code
     1077           v-fact-date = buf_parts-attr.fact-date
     1078           .
     1079   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   if buf_parts-attr.VAT-type = 'нет':U then do:
     1081     if buf_parts-attr.SLT-type = 'нет':U      or
     1082        buf_parts-attr.SLT-Type = 'без':U then do:
     1083       assign
     1084         loc-price-VAT        = buf_parts-attr.price-cli                             * buf_parts-attr.vat-pc / 100
     1085         loc-price-slt        = buf_parts-attr.price-cli * (1 + buf_parts-attr.vat-pc / 100) * buf_parts-attr.slt-pc / 100
     1086         loc-price-no-vat-slt = buf_parts-attr.price-cli.
     1087     end.
     1088     else do:
     1089       assign
     1090         loc-price-VAT        = buf_parts-attr.price-cli / ((100 / buf_parts-attr.vat-pc) * (1 + buf_parts-attr.slt-pc / 100) + buf_parts-attr.slt-pc / 100)
     1091         loc-price-slt        = buf_parts-attr.price-cli * ( 1 - 1 / (1 + buf_parts-attr.slt-pc / 100 + buf_parts-attr.slt-pc / 100 * buf_parts-attr.vat-pc / 100 ))
     1092         loc-price-no-vat-slt = buf_parts-attr.price-cli - loc-price-slt.
     1093     end.
     1094   end.
     1095   else do:
     1096     if buf_parts-attr.SLT-type = 'нет':U      or
     1097        buf_parts-attr.SLT-Type = 'без':U then do:
     1098       assign
     1099         loc-price-VAT        = buf_parts-attr.price-cli                                               * buf_parts-attr.vat-pc / (100 + buf_parts-attr.vat-pc)
     1100         loc-price-slt        = buf_parts-attr.price-cli                                               * buf_parts-attr.slt-pc / 100
     1101         loc-price-no-vat-slt = buf_parts-attr.price-cli - loc-price-VAT.
     1102     end.
     1103     else do:
     1104       assign
     1105         loc-price-VAT        = buf_parts-attr.price-cli * (100 / ( 100 + buf_parts-attr.slt-pc))              * buf_parts-attr.vat-pc / (100 + buf_parts-attr.vat-pc)
     1106         loc-price-slt        = buf_parts-attr.price-cli                                               * buf_parts-attr.slt-pc / (100 + buf_parts-attr.slt-pc)
     1107         loc-price-no-vat-slt = buf_parts-attr.price-cli - loc-price-VAT - loc-price-SLT.
     1108     end.
     1109   end.
     1110   assign loc-price-without-abs = loc-price-no-vat-slt + loc-price-VAT + loc-price-slt.
     1111       assign
     1112       loc-price-cli-netto = loc-price-without-abs  / buf_parts-attr.cli-base-rate.
     1113         end.
     1114         else do:
     1115           FIND FIRST ub.trn-doc No-LOCK WHERE
     1116                     ub.trn-doc.doc-code = v-in-code No-ERROR.
     1117           if not avail ub.trn-doc then do:
     1118             message "Не найдена ПН " v-in-code
     1119             view-as alert-box WARNING.
     1120             NEXT.
     1121           end.
     1122           assign
     1123           v-exch-code = ub.trn-doc.exch-code
     1124           v-fact-date = ub.trn-doc.fact-date
     1125           .
     1126           if ( (pcurr-code <> ?) AND (ub.trn-doc.exch-code <> pcurr-code) ) then NEXT.
     1127           FIND FIRST ub.currency No-LOCK WHERE
     1128                     ub.currency.curr-code = ub.trn-doc.exch-code No-ERROR.
     1129           if v-in-code <> ub.parts.out-code then do:
     1130             FIND FIRST in-parts No-LOCK WHERE
     1131                       in-parts.artic = ub.parts.artic AND
     1132                       in-parts.prod-type = ub.parts.prod-type AND
     1133                       in-parts.prod-code = ub.parts.prod-code AND
     1134                       in-parts.supp-type = v-supp-type AND
     1135                       in-parts.supp-code = v-supp-code AND
     1136                       in-parts.in-code = ub.trn-doc.doc-code AND
     1137                       in-parts.out-code = ub.trn-doc.doc-code AND
     1138                       in-parts.part-code = for-part-code
     1139                       No-ERROR.
     1140             IF not avail in-parts then do:
     1141               message "Не найдена партия по ПН " v-in-code
     1142               ub.parts.artic ub.parts.prod-type ub.parts.prod-code
     1143               "Поставщик" v-supp-type v-supp-code
     1144               "Код партии" for-part-code
     1145               view-as alert-box WARNING.
     1146               NEXT.
     1147             END.
     1148           end.
     1149           else do:
     1150             find first in-parts No-LOCK WHERE
     1151                         recid(in-parts) = recid(ub.parts) No-ERROR.
     1152           end.
     1153   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   if ub.trn-doc.VAT-type = 'нет':U then do:
     1155     if ub.trn-doc.SLT-type = 'нет':U      or
     1156        ub.trn-doc.SLT-Type = 'без':U then do:
     1157       assign
     1158         loc-price-VAT        = in-parts.price-cli                             * in-parts.vat-pc / 100
     1159         loc-price-slt        = in-parts.price-cli * (1 + in-parts.vat-pc / 100) * in-parts.slt-pc / 100
     1160         loc-price-no-vat-slt = in-parts.price-cli.
     1161     end.
     1162     else do:
     1163       assign
     1164         loc-price-VAT        = in-parts.price-cli / ((100 / in-parts.vat-pc) * (1 + in-parts.slt-pc / 100) + in-parts.slt-pc / 100)
     1165         loc-price-slt        = in-parts.price-cli * ( 1 - 1 / (1 + in-parts.slt-pc / 100 + in-parts.slt-pc / 100 * in-parts.vat-pc / 100 ))
     1166         loc-price-no-vat-slt = in-parts.price-cli - loc-price-slt.
     1167     end.
     1168   end.
     1169   else do:
     1170     if ub.trn-doc.SLT-type = 'нет':U      or
     1171        ub.trn-doc.SLT-Type = 'без':U then do:
     1172       assign
     1173         loc-price-VAT        = in-parts.price-cli                                               * in-parts.vat-pc / (100 + in-parts.vat-pc)
     1174         loc-price-slt        = in-parts.price-cli                                               * in-parts.slt-pc / 100
     1175         loc-price-no-vat-slt = in-parts.price-cli - loc-price-VAT.
     1176     end.
     1177     else do:
     1178       assign
     1179         loc-price-VAT        = in-parts.price-cli * (100 / ( 100 + in-parts.slt-pc))              * in-parts.vat-pc / (100 + in-parts.vat-pc)
     1180         loc-price-slt        = in-parts.price-cli                                               * in-parts.slt-pc / (100 + in-parts.slt-pc)
     1181         loc-price-no-vat-slt = in-parts.price-cli - loc-price-VAT - loc-price-SLT.
     1182     end.
     1183   end.
     1184   assign loc-price-without-abs = loc-price-no-vat-slt + loc-price-VAT + loc-price-slt.
     1185       assign
     1186       loc-price-cli-netto = loc-price-without-abs  / in-parts.cli-base-rate.
     1187           assign
     1188           v-price-cli = in-parts.price-cli
     1189           v-cli-base-rate = in-parts.cli-base-rate
     1190           v-obj-type = in-parts.obj-type
     1191           v-obj-code = in-parts.obj-code
     1192           v-vat-type = in-parts.vat-type
     1193           v-slt-type = in-parts.slt-type
     1194           v-vat-pc   = in-parts.vat-pc
     1195           v-slt-pc   = in-parts.slt-pc
     1196           v-fact-qnty = in-parts.fact-qnty
     1197           v-qnty = in-parts.qnty
     1198           .
     1199         end.
     1200         create temp-goods.
     1201         assign
     1202         temp-goods.supp-type = v-supp-type
     1203         temp-goods.supp-code = v-supp-code
     1204         temp-goods.exch-code = v-exch-code
     1205         temp-goods.artic = for-line.artic
     1206         temp-goods.prod-type = for-line.prod-type
     1207         temp-goods.prod-code = for-line.prod-code
     1208         temp-goods.in-code =  v-in-code
     1209         temp-goods.part-code = for-part-code
     1210         temp-goods.obj-code = ub.parts.obj-code
     1211         temp-goods.obj-type = ub.parts.obj-type
     1212         temp-goods.unit = ub.goods.unit-base
     1213         temp-goods.gds-name = ub.goods.gds-name
     1214         temp-goods.IN-date =  v-fact-date
     1215         temp-goods.price-cli-in-brutto = v-price-cli / v-cli-base-rate
     1216         temp-goods.price-cli-in = loc-price-cli-netto
     1217         temp-goods.obj-in-type = v-obj-type
     1218         temp-goods.obj-in-code = v-obj-code
     1219         temp-goods.qnty-all = v-fact-qnty
     1220         temp-goods.vat-type = v-vat-type
     1221         temp-goods.slt-type = v-slt-type
     1222         temp-goods.curr-name = (if avail ub.currency then ub.currency.curr-abbr else string(temp-goods.exch-code))
     1223         temp-goods.slt-pc = v-slt-pc
     1224         temp-goods.vat-pc = v-vat-pc
     1225         .
     1226         if all-obj-code = 0 then do:
     1227           create b-temp-goods.
     1228           assign
     1229           b-temp-goods.supp-type = v-supp-type
     1230           b-temp-goods.supp-code = v-supp-code
     1231           b-temp-goods.exch-code = v-exch-code
     1232           b-temp-goods.artic = for-line.artic
     1233           b-temp-goods.prod-type = for-line.prod-type
     1234           b-temp-goods.prod-code = for-line.prod-code
     1235           b-temp-goods.in-code =  v-in-code
     1236           b-temp-goods.part-code = for-part-code
     1237           b-temp-goods.obj-code = all-obj-code
     1238           b-temp-goods.obj-type = all-obj-type
     1239           b-temp-goods.unit = ub.goods.unit-base
     1240           b-temp-goods.gds-name = ub.goods.gds-name
     1241           b-temp-goods.IN-date =  v-fact-date
     1242           b-temp-goods.price-cli-in-brutto = v-price-cli / v-cli-base-rate
     1243           b-temp-goods.price-cli-in = loc-price-cli-netto
     1244           b-temp-goods.qnty-all = v-qnty
     1245           b-temp-goods.obj-in-type = v-obj-type
     1246           b-temp-goods.obj-in-code = v-obj-code
     1247           b-temp-goods.qnty-rest = v-qnty
     1248           b-temp-goods.vat-type = v-vat-type
     1249           b-temp-goods.slt-type = v-slt-type
     1250           b-temp-goods.curr-name = (if avail ub.currency then ub.currency.curr-abbr else string(b-temp-goods.exch-code))
     1251           b-temp-goods.slt-pc = v-slt-pc
     1252           b-temp-goods.vat-pc = v-vat-pc
     1253           .
     1254         end.
     1255       END.
     1256       else do:
     1257         first-find = no.
     1258         if NOT (b-temp-goods.obj-type = obj-list.obj-type AND
     1259                 b-temp-goods.obj-code = obj-list.obj-code) then do:
     1260           FIND FIRST temp-goods WHERE
     1261                 temp-goods.supp-type = v-supp-type AND
     1262                 temp-goods.supp-code = v-supp-code AND
     1263                 temp-goods.artic = for-line.artic AND
     1264                 temp-goods.prod-type = for-line.prod-type AND
     1265                 temp-goods.prod-code = for-line.prod-code AND
     1266                 temp-goods.in-code = v-in-code AND
     1267                 temp-goods.part-code = for-part-code AND
     1268                 temp-goods.obj-type = obj-list.obj-type AND
     1269                 temp-goods.obj-code = obj-list.obj-code
     1270                 No-error.
     1271           if not avail temp-goods then do:
     1272             create temp-goods.
     1273             buffer-copy b-temp-goods
     1274             except
     1275             b-temp-goods.obj-type
     1276             b-temp-goods.obj-code
     1277             b-temp-goods.qnty-in
     1278             b-temp-goods.qnty-out
     1279             b-temp-goods.price-cli-in-sum
     1280             b-temp-goods.price-cli-out-sum
     1281             to temp-goods
     1282             assign
     1283             temp-goods.obj-type = obj-list.obj-type
     1284             temp-goods.obj-code = obj-list.obj-code
     1285             .
     1286           end.
     1287         end.
     1288       end.
     1289       assign
     1290       prt-qnty =  is-out * ub.parts.fact-qnty
     1291       v-real-is-prihod = (if v-inv
     1292                           then (if prt-qnty >=0
     1293                                 then yes
     1294                                 else no)
     1295                           else is-prihod)
     1296       v-real-is-rashod = (if v-inv
     1297                           then (if prt-qnty < 0
     1298                                 then yes
     1299                                 else no)
     1300                           else is-rashod)
     1301       .
     1302       if all-obj-code = 0 or first-find then do:
     1303         assign
     1304         temp-goods.qnty-in = temp-goods.qnty-in +  (if v-real-is-prihod then prt-qnty else 0)
     1305         temp-goods.qnty-out = temp-goods.qnty-out +  (if v-real-is-rashod then prt-qnty else 0)
     1306         temp-goods.price-cli-in-sum = temp-goods.price-cli-in-sum +
     1307                                       (if v-real-is-prihod
     1308                                       then temp-goods.price-cli-in * prt-qnty
     1309                                       else 0)
     1310         temp-goods.price-cli-out-sum = temp-goods.price-cli-out-sum +
     1311                                       (if v-real-is-rashod
     1312                                       then temp-goods.price-cli-in * prt-qnty
     1313                                       else 0)
     1314         .
     1315       end.
     1316       if all-obj-code = 0 or not first-find then do:
     1317         assign
     1318         b-temp-goods.qnty-in = b-temp-goods.qnty-in +  (if v-real-is-prihod then prt-qnty else 0)
     1319         b-temp-goods.qnty-out = b-temp-goods.qnty-out +  (if v-real-is-rashod then prt-qnty else 0)
     1320         b-temp-goods.price-cli-in-sum = b-temp-goods.price-cli-in-sum +
     1321                                       (if v-real-is-prihod
     1322                                       then b-temp-goods.price-cli-in * prt-qnty
     1323                                       else 0)
     1324         b-temp-goods.price-cli-out-sum = b-temp-goods.price-cli-out-sum +
     1325                                       (if v-real-is-rashod
     1326                                       then b-temp-goods.price-cli-in * prt-qnty
     1327                                       else 0)
     1328         b-temp-goods.qnty-rest = b-temp-goods.qnty-rest + prt-qnty
     1329         .
     1330       end.
     1331     END.
     1332   END.
     1333     END.
     1334   END.
     1335   run waitfram-hide in this-procedure .
