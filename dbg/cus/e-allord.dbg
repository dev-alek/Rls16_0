      818     define variable v-action as character no-undo .
      819     if v-inform-launched = false then do:
      820       assign
      821         v-inform-launched = true
      822       .
      823       run gbl/d-inform.w
      824         (  input self
      825         ,  input this-procedure
      826         , output v-action
      827         ) no-error .
      828       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      829       assign
      830         v-inform-launched = false
      831       .
      832     end.
      833   end.
