     1988       if v-curr-sv-date <> ?
     1989       then do:
     1990         assign
     1991           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1992         .
     1993         assign
     1994           self :screen-value = string(v-new-sv-date) .
     1995         .
     1996       end.
     1997     end.
     1998     return no-apply .
     1999   end.
     2000   on ctrl-e of date-p-2 in frame F-Main
     2001   do:
     2002     if (can-query (self, "sensitive")
     2003        and
     2004        self :sensitive = true
     2005        )
     2006     or (can-query (self, "read-only")
     2007        and
     2008        self :read-only = false
     2009        )
     2010     then do:
     2011       if self :handle <> focus :handle
     2012       then do:
     2013         apply "entry":u to self .
     2014       end.
     2015       define variable v-curr-sv-date as date no-undo .
     2016       define variable v-new-sv-date  as date no-undo .
     2017       assign
     2018         v-curr-sv-date = date(self :screen-value) no-error
     2019       .
     2020       if v-curr-sv-date = ?
     2021       then do:
     2022         run gbl/getcurdt.p
     2023           (output v-curr-sv-date
     2024           ) .
     2025       end.
     2026       if v-curr-sv-date <> ?
     2027       then do:
     2028         run gbl/lastdate.p
     2029           (input  v-curr-sv-date
     2030           ,output v-new-sv-date
     2031           ).
     2032         assign
     2033           self :screen-value = string(v-new-sv-date) .
     2034         .
     2035       end.
     2036     end.
     2037     return no-apply .
     2038   end.
     2039   on ctrl-f of date-p-2 in frame F-Main
     2040   do:
     2041     if (can-query (self, "sensitive")
     2042        and
     2043        self :sensitive = true
     2044        )
     2045     or (can-query (self, "read-only")
     2046        and
     2047        self :read-only = false
     2048        )
     2049     then do:
     2050       if self :handle <> focus :handle
     2051       then do:
     2052         apply "entry":u to self .
     2053       end.
     2054       define variable v-ok            as logical   no-undo .
     2055       define variable v-curr-sv-date  as date      no-undo .
     2056       define variable v-description   as character no-undo .
     2057       assign
     2058         v-curr-sv-date = date(self :screen-value) no-error
     2059       .
     2060       if v-curr-sv-date = ?
     2061       then do:
     2062         run gbl/getcurdt.p
     2063           (output v-curr-sv-date
     2064           ) .
     2065       end.
     2066       if v-curr-sv-date <> ?
     2067       then do:
     2068         run gbl/d-inpday.w
     2069           (input ?
     2070           ,input "Выбор даты"
     2071           ,input v-description
     2072           ,input ""
     2073           ,input-output v-curr-sv-date
     2074           ,output v-ok
     2075           ).
     2076         if v-ok = true
     2077         then do:
     2078           assign
     2079             self :screen-value = string(v-curr-sv-date) .
     2080           .
     2081         end.
     2082       end.
     2083     end.
     2084     return no-apply .
     2085   end.
     2086     define MENU m-ed-date19
     2087       MENU-ITEM m-ed-date19-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2088       MENU-ITEM m-ed-date19-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2089       MENU-ITEM m-ed-date19-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2090       MENU-ITEM m-ed-date19-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     2091       .
     2092     if date-p-2 :POPUP-MENU in frame F-Main = ?
     2093     then do:
     2094       ASSIGN
     2095         date-p-2 :POPUP-MENU in frame F-Main = MENU m-ed-date19 :HANDLE
     2096         date-p-2 :MENU-MOUSE in frame F-Main = 3
     2097       .
     2098     end.
     2099     define variable v-label-handle19 as handle no-undo .
     2100     assign
     2101       v-label-handle19 = date-p-2 :side-label-handle in frame F-Main
     2102     .
     2103     if valid-handle (v-label-handle19)
     2104     then do:
     2105       if v-label-handle19 :tooltip = ""
     2106       or v-label-handle19 :tooltip = ?
     2107       then do:
     2108         assign
     2109           v-label-handle19 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     2110         .
     2111       end.
     2112     end.
     2113     ON CHOOSE OF MENU-ITEM m-ed-date19-1 in menu m-ed-date19 DO:
     2114       apply "ctrl-b":U to date-p-2 in frame F-Main .
     2115     END.
     2116     ON CHOOSE OF MENU-ITEM m-ed-date19-2 in menu m-ed-date19 DO:
     2117       apply "ctrl-d":U to date-p-2 in frame F-Main .
     2118     END.
     2119     ON CHOOSE OF MENU-ITEM m-ed-date19-3 in menu m-ed-date19 DO:
     2120       apply "ctrl-e":U to date-p-2 in frame F-Main .
     2121     END.
     2122     ON CHOOSE OF MENU-ITEM m-ed-date19-4 in menu m-ed-date19 DO:
     2123       apply "ctrl-f":U to date-p-2 in frame F-Main .
     2124     END.
     2125       RUN my_init.
     2126   PROCEDURE adm-row-available :
     2127     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2128     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2129     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2130     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2131     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2132     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2133     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2134     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2135     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2136     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2137     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2138     IF adm-updating-record THEN RETURN.
     2139     RUN get-attribute ('FIELDS-ENABLED':U).
     2140     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2141     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2142         OUTPUT link-handle) NO-ERROR.
     2143     IF link-handle = "":U THEN
     2144         RETURN.
     2145     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2146     IF NUM-ENTRIES(link-handle) > 1 THEN
     2147         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2148             "encountered more than one RECORD-SOURCE.":U SKIP
     2149             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2150                VIEW-AS ALERT-BOX ERROR.
     2151     RUN get-attribute ('Key-Name':U).
     2152     key-name = RETURN-VALUE.
     2153     IF key-name = "":U THEN key-name = ?.
     2154     IF key-name NE ? THEN DO:
     2155       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2156         NO-ERROR.
     2157       IF key-value NE ? THEN
     2158         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2159     END.
     2160   IF VALID-HANDLE (adm-object-hdl) THEN
     2161       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2162   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2163   END PROCEDURE.
     2164   PROCEDURE disable_UI :
     2165     HIDE FRAME F-Main.
     2166     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2167   END PROCEDURE.
     2168   PROCEDURE my-report :
     2169   x-tog-artic = T-artic .
     2170   x-tog-grp   = T-grp   .
     2171   if radio-column then tog-det-prizn = false.
     2172   run cus/r-aord.p ( g#type ) .
     2173   END PROCEDURE.
     2174   PROCEDURE my-var :
     2175   ASSIGN frame F-Main g#type T-grp T-artic
     2176       date-p-1 date-p-2 date-ship .
     2177       if date-p-1  > date-p-2 then do:
     2178       message "Не верно введен интервал дат!" view-as alert-box error .
     2179       return no-apply .
     2180       end.
     2181   ASSIGN
     2182       x-date-alone = date-ship
     2183       x-date-start = date-p-1
     2184       x-date-end   = date-p-2
     2185       .
     2186   END PROCEDURE.
     2187   PROCEDURE my_init :
     2188       define variable v-ii as integer no-undo.
     2189       assign
     2190       date-p-1  = TODAY + 1
     2191       date-p-2  = TODAY + 31
     2192       date-ship = TODAY + 1
     2193       .
     2194       run value-order-type in parent-handle (output g#type) .
     2195       apply "choose" to button-1 in frame F-Main .
     2196       g#type:radio-buttons = "Объект-Поставщик,ОП,Объект-Фирма,ОФ,Фирма-Поставщик,ФП,Объект-Объект,ОО".
     2197       run value-order-type in parent-handle (output g#type) .
     2198       assign
     2199         radio-column:screen-value = "yes"
     2200         radio-gds-obj:screen-value = "yes"
     2201         tog-det-post:screen-value = "yes"
     2202         tog-goods-from-am:screen-value = "no"
     2203         tog-det-prizn:screen-value = "no"
     2204       .
     2205       find first ubflt.usr-flt where
     2206               ubflt.usr-flt.user-name    = v-cntxt-userid and
     2207               ubflt.usr-flt.call-point   = "selrdallo":U
     2208               no-error .
     2209       if available ubflt.usr-flt then do:
     2210         DO v-ii = 1 TO NUM-ENTRIES( ubflt.usr-flt.list_, chr(4)):
     2211           CASE v-ii:
     2212               WHEN 1 THEN DO:
     2213                 radio-column:screen-value      = ENTRY(v-ii, ubflt.usr-flt.list_, chr(4)).
     2214               END.
     2215               WHEN 2 THEN DO:
     2216                 radio-gds-obj:screen-value     = ENTRY(v-ii, ubflt.usr-flt.list_, chr(4)).
     2217               END.
     2218               WHEN 3 THEN DO:
     2219                 tog-det-post:screen-value      = ENTRY(v-ii, ubflt.usr-flt.list_, chr(4)).
     2220               END.
     2221               WHEN 4 THEN DO:
     2222                 tog-goods-from-am:screen-value = ENTRY(v-ii, ubflt.usr-flt.list_, chr(4)).
     2223               END.
     2224               WHEN 5 THEN DO:
     2225                 tog-det-prizn:screen-value     = ENTRY(v-ii, ubflt.usr-flt.list_, chr(4)).
     2226               END.
     2227           end case.
     2228         end.
     2229       end.
     2230       apply "value-changed" to radio-column in frame F-Main.
     2231   DISPLAY date-p-1 date-p-2 date-ship EDITOR-1 g#type  FILL-IN-1 FILL-IN-2 FILL-IN-3 tog-det-post tog-det-prizn WITH FRAME F-Main.
     2232   if radio-gds-obj:screen-value = "yes" then do :
     2233       hide tog-det-post .
     2234   end.
     2235   else do :
     2236       enable tog-det-post with frame F-Main.
     2237   end.
     2238   if radio-column:screen-value = "yes" then hide FILL-IN-3 tog-det-post tog-det-prizn.
     2239   find first ubflt.usr-flt  no-lock where
     2240            ubflt.usr-flt.user-name    = v-cntxt-userid and
     2241            ubflt.usr-flt.call-point   = "all-ord":U    no-error .
     2242            if not avail ubflt.usr-flt  then do:
     2243               message error-status :get-message(1) .
     2244            end.
     2245   if integer(entry(2,(entry(3,ubflt.usr-flt.list_)), "=" )) = 1 and radio-column:screen-value = "no" then do :
     2246       enable tog-det-prizn with frame F-Main.
     2247   end.
     2248   else do :
     2249       hide tog-det-prizn .
     2250   end.
     2251   END PROCEDURE.
     2252   PROCEDURE save-usr-flt :
     2253   assign frame F-Main
     2254      radio-column
     2255      radio-gds-obj
     2256      tog-det-post
     2257      tog-goods-from-am
     2258      tog-det-prizn
     2259   .
     2260   find first ubflt.usr-flt where
     2261           ubflt.usr-flt.user-name    = v-cntxt-userid and
     2262           ubflt.usr-flt.call-point   = "selrdallo":U
     2263           no-error .
     2264           if not available ubflt.usr-flt  then do:
     2265                 create  ubflt.usr-flt.
     2266                 assign
     2267                   ubflt.usr-flt.user-name  = v-cntxt-userid
     2268                   ubflt.usr-flt.call-point = "selrdallo":U
     2269                 .
     2270           end.
     2271           assign
     2272               ubflt.usr-flt.list_ = string(radio-column)  + chr(4)
     2273                                   + string(radio-gds-obj) + chr(4)
     2274                                   + string(tog-det-post)  + chr(4)
     2275                                   + string(tog-goods-from-am) + chr(4)
     2276                                   + string(tog-det-prizn)
     2277           .
     2278   END PROCEDURE.
     2279   PROCEDURE send-records :
     2280   END PROCEDURE.
     2281   PROCEDURE state-changed :
     2282     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2283     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2284     CASE p-state:
     2285       WHEN 'update-begin':U THEN DO:
     2286           RUN dispatch('enable-fields':U).
     2287           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2288           DO:
     2289             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     2290             RUN new-state('update-complete':U).
     2291           END.
     2292           ELSE RUN new-state ('update':U).
     2293       END.
     2294       WHEN 'update-complete':U THEN DO:
     2295           RUN new-state ('update-complete':U).
     2296       END.
     2297     END CASE.
     2298   END PROCEDURE.
