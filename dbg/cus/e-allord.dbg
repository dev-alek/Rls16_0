      930   DEFINE VARIABLE date-p-1 AS DATE FORMAT "99/99/9999":U
      931        LABEL "На период продаж с"
      932        VIEW-AS FILL-IN
      933        SIZE 11 BY 1 TOOLTIP "Период продаж" NO-UNDO.
      934   DEFINE VARIABLE date-p-2 AS DATE FORMAT "99/99/9999":U
      935        LABEL "по"
      936        VIEW-AS FILL-IN
      937        SIZE 11 BY 1 TOOLTIP "Период продаж" NO-UNDO.
      938   DEFINE VARIABLE date-ship AS DATE FORMAT "99/99/9999":U
      939        LABEL "Дата заказа"
      940        VIEW-AS FILL-IN
      941        SIZE 11 BY 1 TOOLTIP "Ориентировочная дата доставки" NO-UNDO.
      942   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Сортировка товаров"
      943         VIEW-AS TEXT
      944        SIZE 21.5 BY .67
      945        FGCOLOR 4  NO-UNDO.
      946   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Выбор типа печати"
      947         VIEW-AS TEXT
      948        SIZE 21.5 BY .67
      949        FGCOLOR 4  NO-UNDO.
      950   DEFINE VARIABLE FILL-IN-3 AS CHARACTER FORMAT "X(256)":U INITIAL "Тип сортировки"
      951         VIEW-AS TEXT
      952        SIZE 21.5 BY .67
      953        FGCOLOR 4  NO-UNDO.
      954   DEFINE VARIABLE g#type AS CHARACTER
      955        VIEW-AS RADIO-SET VERTICAL
      956        RADIO-BUTTONS
      957             "Item 1", "1",
      958   "Item 2", "2",
      959   "Item 3", "3",
      960   "Item 4", "4"
      961        SIZE 24.5 BY 2.75 NO-UNDO.
      962   DEFINE VARIABLE radio-column AS LOGICAL
      963        VIEW-AS RADIO-SET VERTICAL
      964        RADIO-BUTTONS
      965             "Печать в формате импорта", yes,
      966   "Произвольная форма", no
      967        SIZE 29.5 BY 4 NO-UNDO.
      968   DEFINE VARIABLE radio-gds-obj AS LOGICAL
      969        VIEW-AS RADIO-SET VERTICAL
      970        RADIO-BUTTONS
      971             "Товар\Объект", yes,
      972   "Объект\Товар", no
      973        SIZE 20 BY 2 TOOLTIP "Выводить отчет в выбранном разрезе" NO-UNDO.
      974   DEFINE VARIABLE T-artic AS LOGICAL INITIAL no
      975        LABEL "По артикулу"
      976        VIEW-AS TOGGLE-BOX
      977        SIZE 21.5 BY .83 NO-UNDO.
      978   DEFINE VARIABLE T-grp AS LOGICAL INITIAL no
      979        LABEL "По группам товаров"
      980        VIEW-AS TOGGLE-BOX
      981        SIZE 21.5 BY .83 NO-UNDO.
      982   DEFINE VARIABLE tog-det-post AS LOGICAL INITIAL no
      983        LABEL "Детализация по поставщикам"
      984        VIEW-AS TOGGLE-BOX
      985        SIZE 31 BY .83 TOOLTIP "Выводить информацию по поставщикам товара" NO-UNDO.
      986   DEFINE VARIABLE tog-goods-from-am AS LOGICAL INITIAL no
      987        LABEL "Товары из Асс.матрицы"
      988        VIEW-AS TOGGLE-BOX
      989        SIZE 25.5 BY .83 TOOLTIP "Только товары из Ассортиментной матрицы объекта" NO-UNDO.
      990   DEFINE VARIABLE tog-det-prizn AS LOGICAL INITIAL no
      991        LABEL "Детализация по признакам"
      992        VIEW-AS TOGGLE-BOX
      993        SIZE 31 BY .83 TOOLTIP "Детализировать шкальные товары по признакам" NO-UNDO.
      994   DEFINE FRAME F-Main
      995        date-ship AT ROW 1 COL 20.5 COLON-ALIGNED
      996        date-p-1 AT ROW 2 COL 20.5 COLON-ALIGNED
      997        date-p-2 AT ROW 2 COL 37.5 COLON-ALIGNED
      998        g#type AT ROW 2 COL 53 NO-LABEL
      999        BUTTON-1 AT ROW 3.25 COL 2
     1000        EDITOR-1 AT ROW 4.75 COL 1 NO-LABEL
     1001        T-grp AT ROW 10 COL 5
     1002        radio-column AT ROW 10 COL 37 NO-LABEL WIDGET-ID 2
     1003        B-neword AT ROW 10 COL 67
     1004        T-artic AT ROW 11 COL 5
     1005        B-newcol AT ROW 12 COL 67 WIDGET-ID 8
     1006        radio-gds-obj AT ROW 13.25 COL 5.5 NO-LABEL WIDGET-ID 10
     1007        tog-goods-from-am AT ROW 14.25 COL 37 WIDGET-ID 20
     1008        tog-det-post AT ROW 15.5 COL 5.5 WIDGET-ID 18
     1009        tog-det-prizn AT ROW 15.5 COL 37 WIDGET-ID 22
     1010        FILL-IN-1 AT ROW 9.25 COL 2.5 COLON-ALIGNED NO-LABEL
     1011        FILL-IN-2 AT ROW 9.25 COL 35 COLON-ALIGNED NO-LABEL WIDGET-ID 6
     1012        FILL-IN-3 AT ROW 12.5 COL 3 COLON-ALIGNED NO-LABEL WIDGET-ID 16
     1013        "Тип заказов" VIEW-AS TEXT
     1014             SIZE 18.5 BY .67 AT ROW 1.25 COL 53
     1015             FGCOLOR 4
     1016       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1017            SIDE-LABELS NO-UNDERLINE THREE-D
     1018            AT COL 1 ROW 1 SCROLLABLE .
     1019   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1020   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1021   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1022   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1023   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1024   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1025   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1026   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1027         adm-object-hdl = FRAME F-Main:HANDLE.
     1028   RUN ensure-broker.
     1029   THIS-PROCEDURE:ADM-DATA =
     1030        'ADM1.1~`':U +
     1031        'SmartObject~`':U +
     1032        '~`':U +
     1033        'NO ~`':U +
     1034        '~`':U +
     1035        '~`':U +
     1036        '~`':U +
     1037        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1038           + "~`":U +
     1039        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1040        'Record-Source,Record-Target,TableIO-Target~`':U +
     1041        '~`':U +
     1042        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1043        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1044            THEN "^^":U
     1045        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1046             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1047   PROCEDURE adm-apply-entry :
     1048     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1049   END PROCEDURE.
     1050   PROCEDURE adm-destroy :
     1051    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1052   END PROCEDURE.
     1053   PROCEDURE adm-disable :
     1054       DISABLE date-ship date-p-1 date-p-2 g#type BUTTON-1 EDITOR-1 T-grp radio-column B-neword T-artic B-newcol radio-gds-obj tog-goods-from-am tog-det-post tog-det-prizn FILL-IN-1 FILL-IN-2 FILL-IN-3 WITH FRAME F-Main.
     1055       RUN dispatch ('disable-fields':U).
     1056       RUN set-attribute-list ('ENABLED=no':U).
     1057       RETURN.
     1058   END PROCEDURE.
     1059   PROCEDURE adm-edit-attribute-list :
     1060         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1061         RETURN.
     1062   END PROCEDURE.
     1063   PROCEDURE adm-enable :
     1064       ENABLE UNLESS-HIDDEN date-ship date-p-1 date-p-2 g#type BUTTON-1 EDITOR-1 T-grp radio-column B-neword T-artic B-newcol radio-gds-obj tog-goods-from-am tog-det-post tog-det-prizn FILL-IN-1 FILL-IN-2 FILL-IN-3 WITH FRAME F-Main.
     1065       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1066       RUN set-attribute-list ('ENABLED=yes':U).
     1067       RETURN.
     1068   END PROCEDURE.
     1069   PROCEDURE adm-exit :
     1070        RUN notify ('exit':U).
     1071     RETURN.
     1072   END PROCEDURE.
     1073   PROCEDURE adm-hide :
     1074     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1075   END PROCEDURE.
     1076   PROCEDURE adm-initialize :
     1077     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1078   END PROCEDURE.
     1079   PROCEDURE adm-show-errors :
     1080       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1081       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1082           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1083       END.
     1084       RETURN.
     1085   END PROCEDURE.
     1086   PROCEDURE adm-UIB-mode :
     1087     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1088   END PROCEDURE.
     1089   PROCEDURE adm-view :
     1090     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1091   END PROCEDURE.
     1092   PROCEDURE dispatch :
     1093       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1094       RUN broker-dispatch IN adm-broker-hdl
     1095           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1096       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1097   END PROCEDURE.
     1098   PROCEDURE ensure-broker :
     1099   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1100   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1101   DO:
     1102       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1103       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1104   END.
     1105   END PROCEDURE.
     1106   PROCEDURE get-attribute :
     1107     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1108     RUN broker-get-attribute IN adm-broker-hdl
     1109         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1110     RETURN RETURN-VALUE.
     1111   END PROCEDURE.
     1112   PROCEDURE get-attribute-list :
     1113     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1114     RUN broker-get-attribute-list IN adm-broker-hdl
     1115         (INPUT THIS-PROCEDURE,
     1116          INPUT ?,
     1117          OUTPUT p-attr-list) NO-ERROR.
     1118     RETURN.
     1119   END PROCEDURE.
     1120   PROCEDURE new-state :
     1121     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1122     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1123     RETURN.
     1124   END PROCEDURE.
     1125   PROCEDURE notify :
     1126     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1127     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1128     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1129         RETURN "ADM-ERROR":U.
     1130     RETURN.
     1131   END PROCEDURE.
     1132   PROCEDURE set-attribute-list :
     1133     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1134     RUN ensure-broker.
     1135     RUN broker-set-attribute-list IN adm-broker-hdl
     1136         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1137     RETURN.
     1138   END PROCEDURE.
     1139   PROCEDURE set-position :
     1140       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1141       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1142       IF VALID-HANDLE(adm-object-hdl) THEN
     1143       DO:
     1144         ASSIGN adm-object-hdl:ROW    =   p-row
     1145                adm-object-hdl:COLUMN =   p-col.
     1146       END.
     1147       RETURN.
     1148   END PROCEDURE.
     1149   PROCEDURE adm-display-fields :
     1150       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1151       RETURN.
     1152   END PROCEDURE.
     1153   PROCEDURE adm-open-query :
     1154     RETURN.
     1155   END PROCEDURE.
     1156   PROCEDURE adm-row-changed :
     1157         IF VALID-HANDLE(adm-object-hdl) THEN
     1158           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1159         RUN notify ('row-available':U).
     1160         RETURN.
     1161   END PROCEDURE.
     1162   PROCEDURE reposition-query :
     1163       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1164       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1165       RETURN.
     1166   END PROCEDURE.
     1167     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1168     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1169     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1170     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1171     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1172     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1173     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1174     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1175     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1176     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1177     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1178     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1179     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1180     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1181     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1182     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1183     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1184     IF "":U = "":U THEN
     1185       RUN modify-list-attribute IN adm-broker-hdl
     1186         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1187     RUN use-create-on-add(?).
     1188   PROCEDURE adm-add-record :
     1189       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1190          "must have at least one Enabled Table to perform Add.":U
     1191          VIEW-AS ALERT-BOX ERROR.
     1192       RETURN.
     1193   END PROCEDURE.
     1194   PROCEDURE adm-assign-record :
     1195    MESSAGE
     1196          "Object ":U THIS-PROCEDURE:FILE-NAME
     1197            "must have at least one Enabled Table to perform Assign.":U
     1198              VIEW-AS ALERT-BOX ERROR.
     1199      RETURN.
     1200     END PROCEDURE.
     1201   PROCEDURE adm-assign-statement :
     1202     RETURN.
     1203   END PROCEDURE.
     1204   PROCEDURE adm-cancel-record :
     1205      RETURN.
     1206     END PROCEDURE.
     1207   PROCEDURE adm-copy-record :
     1208       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1209        "must have at least one Enabled Table to perform Copy.":U
     1210          VIEW-AS ALERT-BOX ERROR.
     1211       RETURN.
     1212   END PROCEDURE.
     1213   PROCEDURE adm-create-record :
     1214      RETURN.
     1215   END PROCEDURE.
     1216   PROCEDURE adm-current-changed :
     1217     RETURN.
     1218   END PROCEDURE.
     1219   PROCEDURE adm-delete-record :
     1220    MESSAGE
     1221          "Object ":U THIS-PROCEDURE:FILE-NAME
     1222            "must have at least one Enabled Table to perform Delete.":U
     1223              VIEW-AS ALERT-BOX ERROR.
     1224       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1225       RETURN.
     1226   END PROCEDURE.
     1227   PROCEDURE adm-disable-fields :
     1228         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1229       RETURN.
     1230   END PROCEDURE.
     1231   PROCEDURE adm-enable-fields :
     1232       RETURN.
     1233   END PROCEDURE.
     1234   PROCEDURE adm-end-update :
     1235     RETURN.
     1236   END PROCEDURE.
     1237   PROCEDURE adm-reset-record :
     1238       RETURN.
     1239   END PROCEDURE.
     1240   PROCEDURE adm-update-record :
     1241       MESSAGE
     1242         "Object ":U THIS-PROCEDURE:FILE-NAME
     1243           "must have at least one Enabled Table to perform Update.":U
     1244             VIEW-AS ALERT-BOX ERROR.
     1245      RETURN.
     1246   END PROCEDURE.
     1247   PROCEDURE check-modified :
     1248   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1249   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1250   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1251   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1252     IF check-state = "check":U THEN
     1253     DO:
     1254       RUN get-link-handle IN adm-broker-hdl
     1255         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1256            OUTPUT group-target-list).
     1257       IF group-target-list NE "":U THEN
     1258       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1259         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1260         RUN check-modified IN curr-widget ('group-check':U).
     1261         IF RETURN-VALUE NE "":U THEN
     1262         DO:
     1263           RUN check-modified-message(RETURN-VALUE).
     1264           RETURN "":U.
     1265         END.
     1266       END.
     1267     END.
     1268     RETURN "":U.
     1269   END PROCEDURE.
     1270   PROCEDURE check-modified-message :
     1271     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1272        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1273           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1274        IF RETURN-VALUE = "YES":U THEN
     1275           RUN notify ('view,CONTAINER-SOURCE':U).
     1276        MESSAGE IF p-changed-table NE ? THEN
     1277           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1278           ELSE "Current values have been changed."
     1279           SKIP "  Do you wish to save those changes?"
     1280           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1281        IF ANS THEN
     1282        DO:
     1283           IF group-assign-target THEN
     1284             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1285           ELSE RUN dispatch('update-record':U).
     1286           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1287           DO:
     1288               MESSAGE "Changes to the previous record were not saved."
     1289                 VIEW-AS ALERT-BOX ERROR.
     1290               IF group-assign-target THEN
     1291                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1292               ELSE RUN dispatch ('cancel-record':U).
     1293           END.
     1294        END.
     1295        ELSE DO:
     1296          IF group-assign-target THEN
     1297             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1298          ELSE RUN dispatch('cancel-record':U).
     1299        END.
     1300        RETURN.
     1301   END PROCEDURE.
     1302   PROCEDURE get-rowid :
     1303       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1304       ASSIGN
     1305       p-table   =   adm-first-table.
     1306       RETURN.
     1307   END PROCEDURE.
     1308   PROCEDURE init-group-assign :
     1309       RUN request-attribute IN adm-broker-hdl
     1310         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1311       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1312         group-assign-target = yes.
     1313       ELSE group-assign-target = no.
     1314       RETURN.
     1315   END PROCEDURE.
     1316   PROCEDURE set-editors :
     1317       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1318       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1319       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1320       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1321       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1322       DO WHILE VALID-HANDLE (curr-widget):
     1323           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1324              curr-widget:HIDDEN = no THEN DO:
     1325             CASE p-field-setting:
     1326               WHEN "INITIALIZE":U THEN
     1327               DO:
     1328                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1329                     read-only-list +
     1330                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1331                        STRING(curr-widget).
     1332               END.
     1333               WHEN "DISABLE":U OR
     1334               WHEN "ENABLE":U THEN
     1335               DO:
     1336                   curr-widget:SENSITIVE = yes.
     1337                   RUN get-attribute ('Read-Only-Editors':U).
     1338                   IF RETURN-VALUE = ? OR
     1339                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1340                       curr-widget:READ-ONLY =
     1341                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1342               END.
     1343               WHEN "CLEAR":U THEN
     1344                   curr-widget:SCREEN-VALUE = "":U.
     1345             END CASE.
     1346           END.
     1347           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1348       END.
     1349       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1350         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1351           + '"':U).
     1352       RETURN.
     1353   END PROCEDURE.
     1354   PROCEDURE use-check-modified-all :
     1355    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1356     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1357     RETURN.
     1358   END PROCEDURE.
     1359   PROCEDURE use-create-on-add :
     1360   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1361      RETURN.
     1362   END PROCEDURE.
     1363   PROCEDURE use-initial-lock :
     1364     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1365     ASSIGN adm-initial-lock = p-attr-value.
     1366     RETURN.
     1367   END PROCEDURE.
     1368     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1369   ASSIGN
     1370          FRAME F-Main:SCROLLABLE       = FALSE
     1371          FRAME F-Main:HIDDEN           = TRUE.
     1372   ASSIGN
     1373          EDITOR-1:READ-ONLY IN FRAME F-Main        = TRUE.
     1374   ON CHOOSE OF B-newcol IN FRAME F-Main
     1375   DO:
     1376     run cus/secoallo.w (input my-handle).
     1377   END.
     1378   ON CHOOSE OF B-neword IN FRAME F-Main
     1379   DO:
     1380     run cus/seqeallo.w .
     1381   END.
     1382   ON CHOOSE OF BUTTON-1 IN FRAME F-Main
     1383   DO:
     1384     run cus/ord-m.w
     1385        ( input my-handle , input "all-ord":u , g#type ) .
     1386     editor-1 = e-method .
     1387     display editor-1 with frame F-Main .
     1388   find first ubflt.usr-flt  no-lock where
     1389            ubflt.usr-flt.user-name    = v-cntxt-userid and
     1390            ubflt.usr-flt.call-point   = "all-ord":U    no-error .
     1391            if not avail ubflt.usr-flt  then do:
     1392               message error-status :get-message(1) .
     1393            end.
     1394   if integer(entry(2,(entry(3,ubflt.usr-flt.list_)), "=" )) = 1 and radio-column:screen-value = "no" then do :
     1395       enable tog-det-prizn with frame F-Main.
     1396   end.
     1397   else do :
     1398       hide tog-det-prizn .
     1399   end.
     1400   END.
     1401   ON VALUE-CHANGED OF radio-column IN FRAME F-Main
     1402   DO:
     1403       if radio-column:screen-value = "yes" then do :
     1404           enable b-neword with frame F-Main .
     1405         hide b-newcol radio-gds-obj fill-in-3 tog-det-post tog-det-prizn.
     1406       end.
     1407       else do :
     1408         find first ubflt.usr-flt  no-lock where
     1409            ubflt.usr-flt.user-name    = v-cntxt-userid and
     1410            ubflt.usr-flt.call-point   = "all-ord":U    no-error .
     1411            if not avail ubflt.usr-flt  then do:
     1412               message error-status :get-message(1) .
     1413            end.
     1414           enable b-newcol radio-gds-obj fill-in-3 with frame F-Main .
     1415           hide b-neword .
     1416           if radio-gds-obj:screen-value = "no" then do :
     1417             enable tog-det-post with frame F-Main.
     1418           end.
     1419         if (integer(entry(2,(entry(3,ubflt.usr-flt.list_)), "=" )) = 1) then do :
     1420             enable tog-det-prizn with frame F-Main.
     1421         end.
     1422       end.
     1423       run save-usr-flt.
     1424   END.
     1425   ON VALUE-CHANGED OF radio-gds-obj IN FRAME F-Main
     1426   DO:
     1427     if radio-gds-obj:screen-value = "yes" then do :
     1428         hide tog-det-post .
     1429     end.
     1430     else do :
     1431         enable tog-det-post with frame F-Main.
     1432               end.
     1433     run save-usr-flt.
     1434   END.
     1435   ON VALUE-CHANGED OF tog-det-post IN FRAME F-Main
     1436   DO:
     1437     run save-usr-flt.
     1438   END.
     1439   ON VALUE-CHANGED OF tog-goods-from-am IN FRAME F-Main
     1440   DO:
     1441     run save-usr-flt.
     1442   END.
     1443   ON VALUE-CHANGED OF tog-det-prizn IN FRAME F-Main
     1444   DO:
     1445     run save-usr-flt.
     1446   END.
     1447   if not this-procedure :persistent
     1448   then do:
     1449     message
     1450       vss-workfile vss-revision vss-description skip
     1451       "Ошибка при запуске процедуры" skip
     1452       "Данную процедуру следует запускать только с параметром persistent" skip
     1453       view-as alert-box error .
     1454     undo, return error .
     1455   end.
     1456   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1457   on ' ' of date-ship in frame F-Main
     1458   do:
     1459     if (can-query (self, "sensitive")
     1460        and
     1461        self :sensitive = true
     1462        )
     1463     or (can-query (self, "read-only")
     1464        and
     1465        self :read-only = false
     1466        )
     1467     then do:
     1468       assign
     1469         self :screen-value = ?
     1470       .
     1471     end.
     1472     return no-apply.
     1473   end.
     1474   on delete-character of date-ship in frame F-Main
     1475   do:
     1476     if (can-query (self, "sensitive")
     1477        and
     1478        self :sensitive = true
     1479        )
     1480     or (can-query (self, "read-only")
     1481        and
     1482        self :read-only = false
     1483        )
     1484     then do:
     1485       assign
     1486         self :screen-value = ?
     1487       .
     1488     end.
     1489     return no-apply.
     1490   end.
     1491   on ctrl-d of date-ship in frame F-Main
     1492   do:
     1493     define variable v-curr-sv-date as date no-undo .
     1494     if (can-query (self, "sensitive")
     1495        and
     1496        self :sensitive = true
     1497        )
     1498     or (can-query (self, "read-only")
     1499        and
     1500        self :read-only = false
     1501        )
     1502     then do:
     1503       if self :handle <> focus :handle
     1504       then do:
     1505         apply "entry":u to self .
     1506       end.
     1507       run gbl/getcurdt.p
     1508         (output v-curr-sv-date
     1509         ) .
     1510       assign
     1511         self :screen-value = string(v-curr-sv-date) .
     1512       .
     1513     end.
     1514     return no-apply.
     1515   end.
     1516   on ctrl-b of date-ship in frame F-Main
     1517   do:
     1518     if (can-query (self, "sensitive")
     1519        and
     1520        self :sensitive = true
     1521        )
     1522     or (can-query (self, "read-only")
     1523        and
     1524        self :read-only = false
     1525        )
     1526     then do:
     1527       if self :handle <> focus :handle
     1528       then do:
     1529         apply "entry":u to self .
     1530       end.
     1531       define variable v-curr-sv-date as date no-undo .
     1532       define variable v-new-sv-date  as date no-undo .
     1533       assign
     1534         v-curr-sv-date = date(self :screen-value) no-error
     1535       .
     1536       if v-curr-sv-date = ?
     1537       then do:
     1538         run gbl/getcurdt.p
     1539           (output v-curr-sv-date
     1540           ) .
     1541       end.
     1542       if v-curr-sv-date <> ?
     1543       then do:
     1544         assign
     1545           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1546         .
     1547         assign
     1548           self :screen-value = string(v-new-sv-date) .
     1549         .
     1550       end.
     1551     end.
     1552     return no-apply .
     1553   end.
