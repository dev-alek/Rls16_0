     2585       else               assign temp-goods.gds-name = buf_goods.gds-name.
     2586     end.
     2587               end .
     2588             end.
     2589           end .
     2590           when 2 then do:
     2591             for each tmp#grp :
     2592               find first buf_gds-grp no-lock
     2593                 where buf_gds-grp.node-code = tmp#grp.node-code
     2594               .
     2595               run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output CurrGrpName ) .
     2596               for each buf_gds-obj no-lock
     2597                 where buf_gds-obj.obj-type = temp-obj.obj-type
     2598                   and buf_gds-obj.obj-code = temp-obj.obj-code
     2599                   and buf_gds-obj.grp-name begins CurrGrpName
     2600                 use-index obj-grp :
     2601                 find first buf_goods no-lock
     2602                   where buf_goods.gds-code = buf_gds-obj.gds-code
     2603                 .
     2604   define variable vss-include-info23 as character format "X(65)" no-undo
     2605   initial "@(#)$Workfile$ $Revision$".
     2606     assign Counter1 = Counter1 + 1.
     2607   IF ( Counter1 modulo v-account = 0 )  then DO:
     2608             if  log-manager:logfile-name ne ?
