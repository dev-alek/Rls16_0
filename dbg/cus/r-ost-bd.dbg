     2805         create temp-goods-obj .
     2806         assign
     2807           temp-goods-obj.gds-code = temp-goods.gds-code
     2808           temp-goods-obj.obj-code = temp-obj.obj-code
     2809           temp-goods-obj.obj-type = temp-obj.obj-type
     2810           temp-goods-obj.obj-name = temp-obj.obj-name
     2811           temp-goods-obj.db-num   = temp-obj.db-num
     2812           temp-goods-obj.qnty     = 0
     2813           temp-goods-obj.sum-zak  = 0
     2814           temp-goods-obj.sum-prod = 0
     2815         .
     2816         find last buf_stk-line no-lock
     2817           where buf_stk-line.obj-type  = temp-obj.obj-type
     2818             and buf_stk-line.obj-code  = temp-obj.obj-code
     2819             and buf_stk-line.artic     = temp-goods.artic
     2820             and buf_stk-line.prod-type = temp-goods.prod-type
     2821             and buf_stk-line.prod-code = temp-goods.prod-code
     2822             and buf_stk-line.sum-type  = 'cost':U
     2823             and buf_stk-line.cat-id    = '##,##'
     2824             and buf_stk-line.fact-order <= v-fact-order-start
     2825           use-index category no-error .
     2826         if available buf_stk-line then do:
     2827           assign
     2828             temp-goods-obj.qnty = buf_stk-line.fact-qnty
     2829             temp-goods-obj.sum-zak = buf_stk-line.sum-rubl
     2830           .
     2831         end.
     2832         find last buf_stk-line no-lock
     2833           where buf_stk-line.obj-type  = temp-obj.obj-type
     2834             and buf_stk-line.obj-code  = temp-obj.obj-code
     2835             and buf_stk-line.artic     = temp-goods.artic
     2836             and buf_stk-line.prod-type = temp-goods.prod-type
     2837             and buf_stk-line.prod-code = temp-goods.prod-code
     2838             and buf_stk-line.sum-type  = 'crsa':U
     2839             and buf_stk-line.cat-id    = '##,##'
     2840             and buf_stk-line.fact-order <= v-fact-order-start
     2841           use-index category no-error .
     2842         if available buf_stk-line then do:
     2843           assign
     2844             temp-goods-obj.sum-prod = buf_stk-line.sum-rubl
     2845           .
     2846         end.
     2847         if temp-goods-obj.qnty <> 0 then assign is-null = no .
     2848       end.
     2849       if is-null = yes then do:
     2850         for each temp-goods-obj
     2851           where temp-goods-obj.gds-code = temp-goods.gds-code :
     2852           delete temp-goods-obj .
     2853         end.
     2854         delete temp-goods .
     2855       end.
     2856     end.
     2857     end.
     2858   end procedure.
     2859   procedure PutColumnTitulExcel :
     2860     do
     2861     on error undo, return error return-value
     2862     :
     2863     assign
     2864       v-row = 2
     2865       v-col = 3
     2866     .
     2867     run macr_excel_char (str1, 1, 3) .
     2868     run macr_cell_format ( 11, yes, no, ?, 1, 3, 1, 3) .
     2869     run macr_excel_char("Артикул", v-row, 1) .
     2870     run macr_cell_size (14,?, v-row, 1,?,?).
     2871     run macr_excel_char("Наименование товара", v-row, 2) .
     2872     run macr_cell_size (40,?, v-row, 2,?,?).
     2873     for each temp-db :
     2874       run macr_excel_char( temp-db.db-name,   v-row, v-col + 1) .
     2875       run macr_excel_char( "кол-во", v-row + 1, v-col) .                assign v-col = v-col + 1 .
     2876       run macr_excel_char( "сумма учетных цен", v-row + 1, v-col) .     assign v-col = v-col + 1 .
     2877       run macr_excel_char( "сумма продажных цен", v-row + 1, v-col) .   assign v-col = v-col + 1 .
     2878       for each temp-obj
     2879         where temp-obj.db-num = temp-db.db-num
     2880           and temp-obj.typ    = 1
     2881         :
     2882         run macr_excel_char(temp-obj.obj-name + " (" + temp-obj.obj-type + '#' + string(temp-obj.obj-code) + ")", v-row, v-col + 1) .
     2883         run macr_excel_char( "кол-во", v-row + 1, v-col) .              assign v-col = v-col + 1 .
     2884         run macr_excel_char( "сумма учетных цен", v-row + 1, v-col) .   assign v-col = v-col + 1 .
     2885         run macr_excel_char( "сумма продажных цен", v-row + 1, v-col) . assign v-col = v-col + 1 .
     2886       end.
     2887     end.
     2888     find first  temp-obj where temp-obj.typ = 2  no-error .
     2889     if available temp-obj then do:
     2890       run macr_excel_char( "Исключенные объекты", v-row, v-col + 1) .
     2891       run macr_excel_char( "кол-во", v-row + 1, v-col) .               assign v-col = v-col + 1 .
     2892       run macr_excel_char( "сумма учетных цен", v-row + 1, v-col) .    assign v-col = v-col + 1 .
     2893       run macr_excel_char( "сумма продажных цен", v-row + 1, v-col) .
     2894     end.
     2895     else assign v-col = v-col - 1 .
     2896     run macr_cell_bordur ( v-row, 1, v-row + 1, v-col) .
     2897     run macr_cell_format ( 10, yes, no, 35, v-row, 1, v-row + 1, v-col) .
     2898     run macr_cell_size   (14,?, v-row, 3, v-row + 1, v-col) .
     2899     assign  v-row = v-row + 2 .
     2900     end.
     2901   end procedure.
     2902   procedure PrintLine :
     2903     do
     2904     on error undo, return error return-value
     2905     :
     2906       if  ( v-row ) >= 63000 then do:
     2907         Output stream Macr_Excel  close .
     2908         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     2909         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     2910         output stream  Macr_Excel to value(v-file-name) .
     2911         v-ind = v-ind + 1 .
     2912         run PutColumnTitulExcel in this-procedure .
     2913       end.
     2914       assign
     2915         v-col = 3
     2916         ii = 3
     2917       .
     2918       for each Temp-Sum where Temp-Sum.num = -2 : assign Temp-Sum.sum = 0 . end.
     2919       for each temp-db :
     2920         for each temp-obj
     2921           where temp-obj.db-num = temp-db.db-num
     2922             and temp-obj.typ    = 0
     2923         :
     2924           find first temp-goods-obj
     2925             where temp-goods-obj.obj-type = temp-obj.obj-type
     2926               and temp-goods-obj.obj-code = temp-obj.obj-code
     2927               and temp-goods-obj.gds-code = temp-goods.gds-code
     2928           no-error .
     2929           if available temp-goods-obj then do:
     2930             find first Temp-Sum where Temp-Sum.num = -2 and Temp-Sum.ind  = ii .
     2931             assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-obj.qnty .
     2932             find first Temp-Sum where Temp-Sum.num = -2 and Temp-Sum.ind  = ii + 1 .
     2933             assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-obj.sum-zak .
     2934             find first Temp-Sum where Temp-Sum.num = -2 and Temp-Sum.ind  = ii + 2 .
     2935             assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-obj.sum-prod .
     2936           end .
     2937         end .
     2938         assign ii = ii + 3 .
     2939         for each temp-obj
     2940           where temp-obj.db-num = temp-db.db-num
     2941             and temp-obj.typ    = 1
     2942         :
     2943           find first temp-goods-obj
     2944             where temp-goods-obj.obj-type = temp-obj.obj-type
     2945               and temp-goods-obj.obj-code = temp-obj.obj-code
     2946               and temp-goods-obj.gds-code = temp-goods.gds-code
     2947           no-error .
     2948           find first Temp-Sum where Temp-Sum.num = -2 and Temp-Sum.ind  = ii .
     2949           if available temp-goods-obj then assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-obj.qnty .
     2950           assign ii = ii + 1 .
     2951           find first Temp-Sum where Temp-Sum.num = -2 and Temp-Sum.ind  = ii .
     2952           if available temp-goods-obj then assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-obj.sum-zak .
     2953           assign ii = ii + 1 .
     2954           find first Temp-Sum where Temp-Sum.num = -2 and Temp-Sum.ind  = ii .
     2955           if available temp-goods-obj then assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-obj.sum-prod .
     2956           assign ii = ii + 1 .
     2957         end .
     2958       end .
     2959       for each temp-obj where temp-obj.typ = 2 :
     2960         find first temp-goods-obj
     2961           where temp-goods-obj.obj-type = temp-obj.obj-type
     2962             and temp-goods-obj.obj-code = temp-obj.obj-code
     2963             and temp-goods-obj.gds-code = temp-goods.gds-code
     2964         no-error .
     2965         find first Temp-Sum where Temp-Sum.num = -2 and Temp-Sum.ind  = ii .
     2966         if available temp-goods-obj then assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-obj.qnty .
     2967         find first Temp-Sum where Temp-Sum.num = -2 and Temp-Sum.ind  = ii + 1 .
     2968         if available temp-goods-obj then assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-obj.sum-zak .
     2969         find first Temp-Sum where Temp-Sum.num = -2 and Temp-Sum.ind  = ii + 2 .
     2970         if available temp-goods-obj then assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-obj.sum-prod .
     2971       end .
     2972       if x-itog = no then do:
     2973         run macr_excel_char(temp-goods.artic, v-row, 1) .
     2974         run macr_excel_char(temp-goods.gds-name, v-row, 2) .
     2975         for each Temp-Sum where Temp-Sum.num = -2 :
     2976           if TRUNCATE( Temp-Sum.ind / 3,0) = Temp-Sum.ind / 3 then run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 3) .
     2977           else                                                     run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 2) .
     2978         end.
     2979         assign v-row = v-row + 1 .
     2980       end.
     2981       define buffer buf_Temp-Sum for Temp-Sum .
     2982       for each Temp-Sum where Temp-Sum.num = -2 :
     2983         find first buf_Temp-Sum where buf_Temp-Sum.num  = v-level and buf_Temp-Sum.ind  = Temp-Sum.ind  no-error .
     2984         assign buf_Temp-Sum.sum = buf_Temp-Sum.sum + Temp-Sum.sum  .
     2985       end.
     2986     end.
     2987   end procedure.
     2988   procedure GrpSumTree :
     2989     v-level      = num-entries( right-trim(temp-goods.full-grp-name, chr(47)), chr(47) ).
     2990     assign CurrGrpName = "" .
     2991     do ind = 1 to v-level :
     2992       if ind = 1 then assign CurrGrpName = entry ( ind, temp-goods.full-grp-name, chr(47) ) + chr(47) .
     2993       else assign CurrGrpName = CurrGrpName + entry ( ind, temp-goods.full-grp-name, chr(47) )  + chr(47).
     2994       find first temp-sum  where temp-sum.full_grp = CurrGrpName no-error .
     2995       if not available temp-sum then LEAVE.
     2996     end.
     2997     do ii = v-old-level to ind by -1 :
     2998       find first temp-sum where temp-sum.num = ii .
     2999       if x-itog = no then do:
     3000         run macr_excel_char("Итого по группе " + temp-sum.grp + ":", v-row, 2) .
     3001         run macr_cell_format ( 10, yes, no, ?, v-row , 2, v-row, 2) .
     3002         for each Temp-Sum where Temp-Sum.num = ii :
     3003           if TRUNCATE( Temp-Sum.ind / 3,0) = Temp-Sum.ind / 3 then run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 3) .
     3004           else                                                     run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 2) .
     3005         end.
     3006         assign  v-row = v-row + 1 .
     3007       end.
     3008       else do:
     3009         if x-lavel = -1 or ii <= x-lavel then do:
     3010           run macr_excel_char(temp-sum.full_grp, v-row, 2) .
     3011           run macr_cell_format ( 10, yes, no, ?, v-row , 2, v-row, 2) .
     3012           for each Temp-Sum where Temp-Sum.num = ii :
     3013             if TRUNCATE( Temp-Sum.ind / 3,0) = Temp-Sum.ind / 3 then run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 3) .
     3014             else                                                     run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 2) .
     3015           end.
     3016           assign  v-row = v-row + 1 .
     3017         end.
     3018       end.
     3019       for each temp-sum where temp-sum.num = ii : delete temp-sum . end.
     3020     end.
     3021     assign v-old-level = v-level .
     3022     do ii = ind to v-level :
     3023       run InitTempSum in this-procedure (ii) .
     3024       find first temp-sum where temp-sum.num = ii .
     3025       if ii > ind then do:
     3026         assign CurrGrpName = CurrGrpName + chr(47) + entry ( ii, temp-goods.full-grp-name, chr(47) ) .
     3027       end.
     3028       assign
     3029         temp-sum.full_grp = CurrGrpName
     3030         temp-sum.grp = entry ( ii, temp-goods.full-grp-name, chr(47) )
     3031       .
     3032       if x-itog = no then do:
     3033         run macr_excel_char("Группа " + temp-sum.grp + ":", v-row, 2) .
     3034         run macr_cell_format ( 10, yes, no, ?, v-row , 2, v-row, 2) .
     3035         assign  v-row = v-row + 1 .
     3036       end.
     3037     end.
     3038   end procedure.
     3039   procedure InitTempSum :
     3040     define input parameter  p-num as integer   no-undo .
     3041     do
     3042     on error undo, return error return-value
     3043     :
     3044       define variable i as integer no-undo .
     3045       define variable jj as integer no-undo .
     3046       assign jj = 3 .
     3047       do i = 1 to (3 * num-col) :
     3048         create Temp-Sum .
     3049         assign
     3050           Temp-Sum.num  = p-num
     3051           Temp-Sum.ind  = jj
     3052           Temp-Sum.sum  = 0
     3053           jj = jj + 1
     3054         .
     3055       end.
     3056     end.
     3057   end procedure.
     3058   procedure AddTempSum :
     3059     define input parameter  p-num as integer   no-undo .
     3060     do
     3061     on error undo, return error return-value
     3062     :
     3063       define buffer buf_Temp-Sum for Temp-Sum .
     3064       for each Temp-Sum
     3065         where Temp-Sum.num = v-level
     3066       :
     3067         find first buf_Temp-Sum
     3068           where buf_Temp-Sum.num  = p-num - 1
     3069             and buf_Temp-Sum.ind  = Temp-Sum.ind
     3070         no-error .
     3071         if available buf_Temp-Sum then assign buf_Temp-Sum.sum = buf_Temp-Sum.sum + Temp-Sum.sum  .
     3072       end.
     3073     end.
     3074   end procedure.
