     2704     run Ostatok in this-procedure .
     2705     assign
     2706       make-excel = yes
     2707       v-file-name = string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     2708     .
     2709     output stream macr_excel to value(v-file-name) .
     2710     assign v-ind = v-ind + 1 .
     2711   if session :set-wait-state( "compiler" ) then.
     2712     run PutColumnTitulExcel in this-procedure .
     2713     run InitTempSum in this-procedure (-2) .
     2714     run InitTempSum in this-procedure (0) .
     2715     assign
     2716       ind = 0
     2717       v-old-level = 0
     2718       v-level = 0
     2719     .
     2720     for each temp-goods
     2721       break by temp-goods.grp-name
     2722             by temp-goods.gds-name
     2723       :
     2724       if first-of(temp-goods.grp-name ) then run GrpSumTree in this-procedure .
     2725       run PrintLine in this-procedure .
     2726       if last-of(temp-goods.grp-name ) then do:
     2727         do ii = 1 to v-level :      run AddTempSum in this-procedure (ii) .      end.
     2728       End.
     2729     end.
     2730     do ii = v-old-level to 0  by -1 :
     2731       find first temp-sum  where temp-sum.num = ii no-error .
     2732       if available temp-sum then do:
     2733         if x-itog = no then do:
     2734           if ii = 0 then run macr_excel_char("Итого: ", v-row, 2) .
     2735           else run macr_excel_char("Итого по группе " + temp-sum.grp + ":", v-row, 2) .
     2736           run macr_cell_format ( 10, yes, no, ?, v-row , 2, v-row, 2) .
     2737           for each Temp-Sum where Temp-Sum.num = ii :
     2738             if TRUNCATE( Temp-Sum.ind / 3,0) = Temp-Sum.ind / 3 then run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 3) .
     2739             else                                                     run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 2) .
     2740           end.
     2741           assign v-row = v-row + 1 .
     2742         end.
     2743         else do:
     2744           if ii = 0 then do:
     2745             run macr_excel_char("Итого: ", v-row, 2) .
     2746             for each Temp-Sum where Temp-Sum.num = ii :
     2747               if TRUNCATE( Temp-Sum.ind / 3,0) = Temp-Sum.ind / 3 then run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 3) .
     2748               else                                                     run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 2) .
     2749             end.
     2750             assign v-row = v-row + 1 .
     2751           end.
     2752           else if x-lavel = -1 or x-lavel >= ( num-entries( right-trim(temp-sum.full_grp, chr(47)), chr(47) ) )  then do:
     2753             run macr_excel_char(temp-sum.full_grp + ":", v-row, 2) .
     2754             run macr_cell_format ( 10, yes, no, ?, v-row , 2, v-row, 2) .
     2755             for each Temp-Sum where Temp-Sum.num = ii :
     2756               if TRUNCATE( Temp-Sum.ind / 3,0) = Temp-Sum.ind / 3 then run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 3) .
     2757               else                                                     run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind, 2) .
     2758             end.
     2759             assign v-row = v-row + 1 .
     2760           end.
     2761         end.
     2762       end.
     2763     end.
     2764     for each temp-sum : delete temp-sum . end.
     2765     output stream macr_excel close .
     2766     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     2767     run end-proc .
