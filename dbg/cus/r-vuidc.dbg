      326   procedure create_obj-list :
      327      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      328      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      329      do
      330      on error undo, return error return-value
      331      :
      332         define buffer cli-obj for ub.clients .
      333         define variable p-var as integer no-undo .
      334         define buffer buf_obj-list for obj-list .
      335         find last buf_obj-list  use-index pi no-error .
      336         if available buf_obj-list
      337         then
      338            p-var = buf_obj-list.obj-id + 1.
      339         else
      340            p-var = 1.
      341         find first cli-obj where
      342                   cli-obj.obj-type = p-obj-type
      343               and cli-obj.obj-code = p-obj-code
      344         no-lock no-error.
      345         if available cli-obj
      346         then do:
      347            create buf_obj-list.
      348            assign
      349               buf_obj-list.obj-id   = p-var
      350               buf_obj-list.obj-code = cli-obj.obj-code
      351               buf_obj-list.obj-type = cli-obj.obj-type
      352               buf_obj-list.obj-name = cli-obj.obj-name
      353               buf_obj-list.db-num   = cli-obj.db-num
      354            .
      355         end.
      356      end.
      357   end.
