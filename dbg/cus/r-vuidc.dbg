     1040   define button B-viewProcInfo
     1041        label "Информация"
     1042        size 15 by 1 tooltip "Информация о процесс".
     1043   define frame waitfram
     1044     v-waitfram-action01 format "x(72)" no-label skip
     1045     v-waitfram-action02 format "x(72)" no-label skip
     1046     v-waitfram-action03 format "x(72)" no-label skip
     1047     B-viewProcInfo
     1048     B-WaitFramStop at row 4 col 30
     1049     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1050     .
     1051   define new global shared variable mBatchMode as logical no-undo init ?.
     1052   define variable mFramBachModHandle as handle no-undo.
     1053   mFramBachModHandle = frame waitfram:handle.
     1054   define variable mFameOldVis as logical no-undo.
     1055   define variable mVisCUrentVin as logical no-undo.
     1056   if session:batch-mode
     1057   then
     1058      mBatchMode = yes.
     1059   if mBatchMode = ? then do:
     1060     mVisCUrentVin = current-window:visible.
     1061     mFameOldVis = mFramBachModHandle:visible.
     1062     mFramBachModHandle:visible  = yes.
     1063     mBatchMode = mFramBachModHandle:visible ne yes.
     1064     mFramBachModHandle:visible = mFameOldVis.
     1065     current-window:visible = mVisCUrentVin.
     1066   end.
     1067    if  log-manager:logfile-name ne ?
     1068     then DO:
     1069         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1070         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1071         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1072     end.
     1073   on choose of B-WaitFramStop in frame waitfram
     1074   do:
     1075     mWaitFramStop = yes.
     1076     mWaitFramStopUser = yes.
     1077   end.
     1078   function waitfram-check-timeout returns logical():
     1079      define variable vtime as int64 no-undo.
     1080      if mWaitFramStopTimeOut
     1081      then
     1082         return yes.
     1083      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1084      if     mWaitFramTimeOut ne ?
     1085         and mWaitFramTimeOut ne 0
     1086         and mWaitFramTimeOut lt vtime
     1087      then do:
     1088         mWaitFramStopTimeOut = yes.
     1089      end.
     1090      return mWaitFramStopTimeOut.
     1091   end.
     1092   procedure waitfram-hide :
     1093     if not session:batch-mode
     1094     then do
     1095     on error undo, return error return-value
     1096     :
     1097       pause 0 before-hide .
     1098       if not mBatchMode then
     1099         hide frame waitfram .
     1100     if     not mWaitFramView
     1101        and mWaitProcEvent
     1102     then
     1103       process events .
     1104     end.
     1105   end procedure.
     1106   procedure waitfram-show :
     1107     define input  parameter p-message as character no-undo .
     1108     define variable v-left-margin as integer   no-undo .
     1109     if not session:batch-mode
     1110     then do
     1111     on error undo, return error return-value
     1112     :
     1113       if length(p-message) <= 70 then do:
     1114         assign
     1115           v-left-margin = integer((70 - length(p-message)) / 2)
     1116         .
     1117         assign
     1118           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1119         .
     1120         assign
     1121           v-waitfram-action01 = " "
     1122           v-waitfram-action02 = " "
     1123                                    + fill(" ", v-left-margin)
     1124                                    + p-message
     1125           v-waitfram-action03 = " "
     1126         .
     1127       end.
     1128       else do:
     1129         define variable vRindex1 as integer no-undo.
     1130         define variable vRindex2 as integer no-undo.
     1131         vRindex1 = r-index(p-message," ",70).
     1132         if vRindex1 = 0
     1133         then
     1134            vRindex1 = 70.
     1135         if length(p-message)  <= vRindex1 + 70 then do:
     1136           assign
     1137             v-waitfram-action01 = " "
     1138             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1139             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1140           .
     1141         end.
     1142         else do:
     1143           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1144           if vRindex2 <= vRindex1
     1145           then
     1146              vRindex2 = vRindex1 + 70.
     1147           assign
     1148             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1149             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1150             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1151           .
     1152         end.
     1153       end.
     1154       B-viewProcInfo:visible   in frame waitfram = no.
     1155       B-viewProcInfo:sensitive in frame waitfram = no.
     1156       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1157       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1158       if  (   mWaitFramView
     1159          or  mWaitProcEvent)
     1160          and not mBatchMode
     1161       then
     1162          display
     1163             v-waitfram-action01 skip
     1164             v-waitfram-action02 skip
     1165             v-waitfram-action03 skip
     1166          with frame waitfram .
     1167       if     mWaitFramView
     1168          then do:
     1169             if     mWaitFramInterval ne ?
     1170                and not mBatchMode
     1171             then
     1172                wait-for go of frame waitfram pause mWaitFramInterval.
     1173          end.
     1174          else
     1175             if     mWaitProcEvent
     1176                and not mBatchMode
     1177             then
     1178                process events .
     1179     end.
     1180   end procedure.
     1181      procedure waitfram-show-this:
     1182         define input  parameter iInterval as int64 no-undo.
     1183         define variable vtime as int64 no-undo.
     1184         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1185         mWaitFramInterval = iInterval.
     1186         run waitfram-show (substitute("&1&2 &3&4" ,
     1187                                       mWaitFramTextBeg ,
     1188                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1189                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1190                                       mWaitFramTextEnd
     1191                                      )
     1192                           ).
     1193      end.
     1194      procedure WaitFramRunPause:
     1195         define input  parameter iInterval as dec no-undo.
     1196         define variable vStart  as datetime-tz no-undo.
     1197         define variable vend    as datetime-tz no-undo.
     1198         define variable vint as int64 no-undo.
     1199         define variable vOk as logical no-undo.
     1200         vStart = now.
     1201         vend   = vStart.
     1202         publish "WaitFramPause" (iInterval,output vOk).
     1203         vend   =  now.
     1204         vint = vend - vStart.
     1205         vint = iInterval - vint / 1000.
     1206         if     not mWaitFramStop
     1207            and (   vint > 0
     1208                 or (    not vOk
     1209                     and iInterval eq ?
     1210                     )
     1211                 )
     1212         then
     1213            run waitfram-show-this (iInterval).
     1214         vend   =  now.
     1215         vint = vend - vStart.
     1216         vint = iInterval - vint / 1000.
     1217         if     not mWaitFramStop
     1218            and vint > 0
     1219         then do:
     1220            run gbl/pause.p (vint * 1000).
     1221         end.
     1222         if iInterval ne ?
     1223         then
     1224            publish "WaitFramStop".
     1225         waitfram-check-timeout().
     1226      end.
     1227      procedure WaitFramWaitFor:
     1228         define input  parameter iInterval as dec no-undo.
     1229         assign
     1230            mWaitFramStartProc   = now
     1231            mWaitFramStopUser    = no
     1232            mWaitFramStopTimeOut = no
     1233         .
     1234         block-wait:
     1235         do while not mWaitFramStop:
     1236            run WaitFramRunPause (iInterval).
     1237            if  waitfram-check-timeout()
     1238            then do:
     1239               leave block-wait.
     1240            end.
     1241         end.
     1242         run waitfram-hide.
     1243      end.
     1244   procedure waitfram-join :
     1245     define input  parameter p-line-1  as character no-undo .
     1246     define input  parameter p-line-2  as character no-undo .
     1247     define input  parameter p-line-3  as character no-undo .
     1248     define output parameter p-message as character no-undo .
     1249     do
     1250     on error undo, return error return-value
     1251     :
     1252       assign
     1253         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1254                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1255                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1256       .
     1257     end.
     1258   end procedure.
     1259   function waitfram-join-function returns character
     1260     (input p-line-1 as character
     1261     ,input p-line-2 as character
     1262     ,input p-line-3 as character
     1263     ).
     1264     define variable v-message as character no-undo .
     1265     run waitfram-join in this-procedure
     1266       (input  p-line-1
     1267       ,input  p-line-2
     1268       ,input  p-line-3
     1269       ,output v-message
     1270       ) .
     1271     return v-message .
     1272   end function .
     1273   define variable sheets              as integer no-undo.
     1274   define variable Line                as character no-undo .
     1275   define variable num-g#              as integer no-undo.
     1276   define variable FixProdAttr         as character no-undo.
     1277   define variable v-name like ub.clients.obj-name no-undo .
     1278   define variable v-first-date        like ub.chk-doc.chk-date no-undo .
     1279   define variable v-first-time        like ub.chk-doc.chk-time no-undo .
     1280   define variable v-first-obj-type    like ub.chk-doc.obj-type no-undo .
     1281   define variable v-first-obj-code    like ub.chk-doc.obj-code no-undo .
     1282   define variable g#report-num        as integer no-undo .
     1283   define buffer buf_person for ub.person.
     1284   define buffer buf_firm for ub.firm.
     1285   define buffer buf_clients for ub.clients.
     1286   define buffer buf_chk-doc for ub.chk-doc.
     1287   define buffer buf_obj for ub.clients.
     1288   run prn-lib-open-stream  in this-procedure (
     1289                                                input my-handle
     1290                                               ,input 62
     1291                                               ,input yes
     1292                                               ,input no
     1293                                               ).
     1294   CASE X-selectgood:
     1295     when 3 then do:
     1296       For each g#cli no-lock:
     1297           num-g# = num-g# + 1.
     1298           if num-g#= 1 then
     1299           FixProdAttr = g#cli.obj-type + string( g#cli.obj-code ) .
     1300           if num-g# > 1 then leave.
     1301       end.
     1302     end.
     1303     when 2 then do:
     1304       For each tmp#grp no-lock:
     1305           num-g# = num-g# + 1.
     1306           if num-g# = 1 then
     1307           FixProdAttr = tmp#grp.grp-name .
     1308           if num-g# > 1 then leave.
     1309       end.
     1310     end.
     1311     when 4 then do:
     1312       For each gds-list no-lock:
     1313           num-g# = num-g# + 1.
     1314           if num-g# = 1 then
     1315           FixProdAttr = string( gds-list.gds-code ) .
     1316           if num-g# > 1 then leave.
     1317       end.
     1318     end.
     1319     when 5 then do:
     1320       num-g# = 1.
     1321       for each gds-list:
     1322         FixProdAttr = string( gds-list.gds-code ) .
     1323         leave.
     1324       end.
     1325     end.
     1326   END CASE.
     1327   run cus/r-vuidcr.p (
     1328                    input my-handle
     1329                   ,input X-SelectGood
     1330                   ,input FixProdAttr
     1331                   ,input X-date-Start
     1332                   ,input X-date-End
     1333                   ,input (if X-SelectGood = 1
     1334                           then "ALL":U
     1335                           else (IF num-g# > 1 then "LIST:U" else "ONE":U)
     1336                           )
     1337                   ,input ", обработано чеков :"
     1338                   ,input this-procedure:handle
     1339   ).
     1340   if not can-find(first temp-cards no-lock) then do:
     1341     message
     1342     "Нет данных для отчета"
     1343     view-as alert-box .
     1344     run waitfram-hide in this-procedure .
     1345     return.
     1346   end.
     1347   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1348   FOR EACH sheetf where sheetf.sheet-num > 1:
     1349     delete sheetf.
     1350   end.
     1351   FIND FIRST sheetf where
     1352               sheetf.sheet-num = 1 No-ERROR.
     1353   sheetf.sizes = "".
     1354   assign
     1355   Sheetf.Excel-Column-Lable =
     1356                               "Дисконтная карта" + chr(44) +
     1357                               "Код" + chr(44) +
     1358                               "Дата перв.покупки" + chr(44) +
     1359                               "Маг перв.покупки" + chr(44) +
     1360                               "Дата посл.покупки(за период)" + chr(44) +
     1361                               "Маг посл.покупки" + chr(44) +
     1362                               "Фамилия" + chr(44) +
     1363                               "Имя" + chr(44) +
     1364                               "Отчество" + chr(44) +
     1365                               "Организация" + chr(44) +
     1366                               "Должность" + chr(44) +
     1367                               "ИНН" +   chr(44) +
     1368                               "Телефон" + chr(44) +
     1369                               "Факс" + chr(44) +
     1370                               "E-mail" + chr(44) +
     1371                               "Город" + chr(44) +
     1372                               "Индекс" + chr(44) +
     1373                               "Адрес" + chr(44) +
     1374                               "А/я" + chr(44) +
     1375                               "Паспортные данные" + chr(44) +
     1376                               "Примечание"
     1377   Sheetf.Sizes = "16,12,10,8,10,8,40,20,20,40,20,21,20,20,20,40,6,60,8,60,60"
     1378   sheetf.colformat = "3=dd/mm/yyyy;5=dd/mm/yyyy":U + chr(4) + "1=@;12=@"
     1379   .
     1380   run rep/extitle.p (1) no-error.
     1381   for each temp-cards no-lock
     1382   break
     1383   by temp-cards.cli-type
     1384   by temp-cards.cli-code:
     1385     assign
     1386     v-first-date = ?
     1387     v-first-time = 0
     1388     v-first-obj-type = "":U
     1389     v-first-obj-code = 0
     1390     .
     1391     _chk-doc:
     1392     for each buf_obj no-lock where
     1393             buf_obj.obj-type = 'маг':U
     1394          OR buf_obj.obj-type = 'скл':U:
     1395       _chk-doc2:
     1396       for each buf_chk-doc no-lock where
     1397             buf_chk-doc.obj-type = buf_obj.obj-type
     1398         AND buf_chk-doc.obj-code = buf_obj.obj-code
     1399         AND buf_chk-doc.d-card = temp-cards.d-card
     1400       by buf_chk-doc.chk-date
     1401       by buf_chk-doc.chk-time
     1402       :
     1403         if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next _chk-doc2.
     1404         if v-first-date = ? then do:
     1405           assign
     1406           v-first-date = buf_chk-doc.chk-date
     1407           v-first-time = buf_chk-doc.chk-time
     1408           v-first-obj-type = buf_chk-doc.obj-type
     1409           v-first-obj-code = buf_chk-doc.obj-code
     1410           .
     1411         end.
     1412         else do:
     1413           if (v-first-date < buf_chk-doc.chk-date)
     1414           or ((v-first-date = buf_chk-doc.chk-date)  AND
     1415               (v-first-time <= buf_chk-doc.chk-time))
     1416           then NEXT _chk-doc.
     1417           else do:
     1418             assign
     1419             v-first-date = buf_chk-doc.chk-date
     1420             v-first-time = buf_chk-doc.chk-time
     1421             v-first-obj-type = buf_chk-doc.obj-type
     1422             v-first-obj-code = buf_chk-doc.obj-code
     1423             .
     1424             NEXT _chk-doc.
     1425           end.
     1426         end.
     1427       end.
     1428     end.
     1429     if first-of(temp-cards.cli-code) then do:
     1430       find first buf_clients no-lock where
     1431                  buf_clients.obj-type = temp-cards.cli-type
     1432              and buf_clients.obj-code = temp-cards.cli-code.
     1433       CASE temp-cards.cli-type:
     1434         when 'чел':U then do:
     1435           find first buf_person no-lock where
     1436                      buf_person.psn-code = temp-cards.cli-code.
     1437           if Make-Excel then  put   stream ForExcel unformatted
     1438           (chr(4) + temp-cards.d-card)                  CHR(9)
     1439           (temp-cards.cli-type + string(temp-cards.cli-code)) CHR(9)
     1440           string(v-first-date, "99/99/9999")                  CHR(9)
     1441           (v-first-obj-type + string(v-first-obj-code))       CHR(9)
     1442           string(temp-cards.last-date, "99/99/9999")          CHR(9)
     1443           (temp-cards.last-obj-type + string(temp-cards.last-obj-code))       CHR(9)
     1444           buf_clients.obj-name                                CHR(9)
     1445           buf_person.name1                                    CHR(9)
     1446           buf_person.name2                                    CHR(9)
     1447           buf_person.firm-name                                CHR(9)
     1448           buf_person.position                                 CHR(9)
     1449           (chr(1) + buf_person.inn)                     CHR(9)
     1450           buf_person.phone1                                   CHR(9)
     1451           buf_person.fax                                      CHR(9)
     1452           buf_person.e-mail                                   CHR(9)
     1453           buf_person.city                                     CHR(9)
     1454           buf_person.ind                                      CHR(9)
     1455           buf_person.address                                  CHR(9)
     1456           buf_person.post-box                                 CHR(9)
     1457           (buf_person.passp-num + chr(32) +
     1458           buf_person.passp-ser + chr(32) +
     1459           buf_person.given-by)                                CHR(9)
     1460           buf_clients.PS
     1461           skip.
     1462         end.
     1463         when 'орг':U then do:
     1464           find first buf_firm no-lock where
     1465                      buf_firm.firm-code = temp-cards.cli-code.
     1466           if Make-Excel then  put   stream ForExcel unformatted
     1467           (chr(1) + temp-cards.d-card)                  CHR(9)
     1468           (temp-cards.cli-type + string(temp-cards.cli-code)) CHR(9)
     1469           string(v-first-date, "99/99/9999")                  CHR(9)
     1470           (v-first-obj-type + string(v-first-obj-code))       CHR(9)
     1471           string(temp-cards.last-date, "99/99/9999")          CHR(9)
     1472           (temp-cards.last-obj-type + string(temp-cards.last-obj-code))       CHR(9)
     1473           buf_clients.obj-name                                CHR(9)
     1474           buf_firm.engl-name                                  CHR(9)
     1475                                                               CHR(9)
     1476                                                               CHR(9)
     1477           buf_firm.director                                   CHR(9)
     1478           (chr(1) + buf_firm.inn)                       CHR(9)
     1479           buf_firm.phone                                      CHR(9)
     1480           buf_firm.fax                                        CHR(9)
     1481           buf_firm.e-mail                                     CHR(9)
     1482           buf_firm.city                                       CHR(9)
     1483           buf_firm.ind                                        CHR(9)
     1484           buf_firm.addres1                                    CHR(9)
     1485                                                               CHR(9)
     1486                                                               CHR(9)
     1487           (buf_clients.Ps + chr(32) + buf_firm.contact-psn)
     1488           skip.
     1489         end.
     1490       END CASE.
     1491     end.
     1492     else do:
     1493       if Make-Excel then  put   stream ForExcel unformatted
     1494       (chr(1) + temp-cards.d-card) CHR(9)
     1495       (temp-cards.cli-type + string(temp-cards.cli-code)) CHR(9)
     1496       string(v-first-date, "99/99/9999")                  CHR(9)
     1497       (v-first-obj-type + string(v-first-obj-code))       CHR(9)
     1498       string(temp-cards.last-date, "99/99/9999")          CHR(9)
     1499       (temp-cards.last-obj-type + string(temp-cards.last-obj-code))       CHR(9)
     1500       CHR(9)
     1501       CHR(9)
     1502       CHR(9)
     1503       CHR(9)
     1504       CHR(9)
     1505       CHR(9)
     1506       CHR(9)
     1507       CHR(9)
     1508       CHR(9)
     1509       CHR(9)
     1510       CHR(9)
     1511       CHR(9)
     1512       CHR(9)
     1513       CHR(9)
     1514       skip.
     1515     end.
     1516   END.
     1517   if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1518   FInd first Sheetf where
     1519               Sheetf.sheet-num = 2 No-ERROR.
     1520   if not avail sheetf then
     1521   create sheetf.
     1522   assign
     1523   Sheetf.Sheet-num = 2.
     1524   assign
     1525   Sheetf.Excel-Column-Lable =
     1526                               "Дисконтная карта" + chr(44) +
     1527                               "Код" + chr(44) +
     1528                               "Фамилия" + chr(44) +
     1529                               "Скидка клиента%" + chr(44) +
     1530                               "Дата чека" + chr(44) +
     1531                               "Номер магазина" + chr(44) +
     1532                               "Код продавца" + chr(44) +
     1533                               "Код кассира" +  chr(44) +
     1534                               "Скидка итоговая (%)" +  chr(44) +
     1535                               "Код товара" +  chr(44) +
     1536                               "Артикул товара" +  chr(44) +
     1537                               "Наименование товара" +  chr(44) +
     1538                               "Кол-во" +  chr(44) +
     1539                               "Цена брутто" + chr(44) +
     1540                               "Цена нетто" + chr(44) +
     1541                               "Скидка" + chr(44) +
     1542                               "Сумма нетто" + chr(44) +
     1543                               "Курс валюты" + chr(44) +
     1544                               "Масштаб"
     1545   Sheetf.Sizes = "12,40,16,5,10,5,4,4,5,9,16,48,5,8,8,8,16,15,7"
     1546   sheetf.colformat = "5=dd/mm/yyyy" + chr(1) + "1=@"
     1547   .
     1548   run rep/extitle.p (2) .
     1549   for each temp-gds no-lock
     1550   break
     1551   by temp-gds.cli-type
     1552   by temp-gds.cli-code
     1553   by temp-gds.d-card
     1554   :
     1555     if first-of(temp-gds.cli-code) then do:
     1556       find first buf_clients no-lock where
     1557                  buf_clients.obj-type = temp-gds.cli-type
     1558              and buf_clients.obj-code = temp-gds.cli-code no-error .
     1559       if avail buf_clients then do:
     1560         assign
     1561         v-name = buf_clients.obj-name
     1562         .
     1563       end.
     1564       else do:
     1565         assign
     1566         v-name = temp-gds.cli-type + string(temp-gds.cli-code)
     1567         .
     1568       end.
     1569     end.
     1570     if Make-Excel then  put   stream ForExcel unformatted
     1571     (chr(1) + temp-gds.d-card)                             CHR(9)
     1572     (temp-gds.cli-type + string(temp-gds.cli-code))     CHR(9)
     1573     v-name                                              CHR(9)
     1574     temp-gds.src-d-pcnt                                 CHR(9)
     1575     string(temp-gds.chk-date, "99/99/9999")                                   CHR(9)
     1576     temp-gds.obj-code                                   CHR(9)
     1577     temp-gds.sales-man                                  CHR(9)
     1578     temp-gds.cashier                                    CHR(9)
     1579     temp-gds.d-pcnt                                     CHR(9)
     1580     temp-gds.gds-code                                   CHR(9)
     1581     temp-gds.artic                                      CHR(9)
     1582     temp-gds.gds-name                                   CHR(9)
     1583     temp-gds.doc-qnty                                   CHR(9)
     1584     temp-gds.price-base                                 CHR(9)
     1585     (temp-gds.price-base - temp-gds.discnt)             CHR(9)
     1586     temp-gds.discnt                                     CHR(9)
     1587     round((temp-gds.price-base - temp-gds.discnt) *
     1588             temp-gds.doc-qnty, 2)                        CHR(9)
     1589     temp-gds.cash-rate                                  CHR(9)
     1590     temp-gds.cash-scale
     1591     skip.
     1592   END.
     1593   output stream PrnLibStream CLOSE .
     1594   if Make-Excel then output stream ForExcel close.
     1595   run waitfram-hide in this-procedure .
     1596   run get-report-num in my-handle (output g#report-num).
     1597   run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
