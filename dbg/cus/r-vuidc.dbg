       73   define  stream PrnLibStream.
       74   procedure prn-lib-prn-file :
       75     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       76     define input parameter p-DIsabledoptions as integer no-undo .
       77     define variable v-report-name as character no-undo .
       78     define variable v-user-action as character no-undo .
       79     define variable v-printed     as logical   no-undo .
       80     define variable v-exist       as logical   no-undo .
       81     do
       82       on error undo, return error
       83       :
       84       run prn-lib-get-report-name  in this-procedure (
       85         input parParentProc
       86         ,output v-report-name
       87         ).
       88   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       90     (input  v-report-name
       91     ,input  2
       92     ,output v-exist
       93     )  .
       94       if NOT v-exist then
       95       DO:
       96         Message
       97           "Нет заданий на печать ! "
       98           view-as alert-box .
       99         Return  .
      100       End.
      101       run gbl/prnfilen.w
      102         (input  ""
      103         ,input  p-DisabledOptions
      104         ,input  string(v-report-name )
      105         ,input  7
      106         ,output v-user-action
      107         ,output v-printed
      108         ) .
      109       if v-printed then
      110       do:
      111         return "YES" .
      112       end.
      113       else
      114       do:
      115         return "NO" .
      116       end.
      117     end.
      118   end procedure.
      119   procedure prn-lib-open-stream :
      120     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      121     define input parameter p-page-size    as integer no-undo .
      122     define input parameter p-is-stream    as logical no-undo .
      123     define input parameter p-append       as logical no-undo .
      124     define variable v-report-name as character no-undo .
      125     do
      126       on error undo, return error
      127       :
      128       run prn-lib-get-report-name  in this-procedure (
      129         input parParentProc
      130         ,output v-report-name
      131         ).
      132       if p-is-stream then
      133       do:
      134         if p-append then
      135         do:
      136           output stream PrnLibStream to value( v-report-name )
      137             page-size value(p-page-size) append .
      138         end.
      139         if not p-append then
      140         do:
      141           output stream PrnLibStream to value( v-report-name )
      142             page-size value(p-page-size) .
      143         end.
      144       end.
      145       if not p-is-stream then
      146       do:
      147         if p-append then
      148         do:
      149           output to value( v-report-name )
      150             page-size value(p-page-size) append .
      151         end.
      152         if not p-append then
      153         do:
      154           output to value( v-report-name )
      155             page-size value(p-page-size) .
      156         end.
      157       end.
      158     end.
      159   end procedure.
      160   procedure prn-lib-open-exp :
      161     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      162     define input parameter p-is-stream    as logical no-undo .
      163     define input parameter p-is-append    as logical no-undo .
      164     define output parameter p-ReportFileName as char init "report" no-undo.
      165     define output parameter p-process as logical no-undo .
      166     define variable glog as logical no-undo .
      167     do
      168       on error undo, return error
      169       :
      170       SYSTEM-DIALOG GET-FILE p-ReportFileName
      171         TITLE      "Укажите путь"
      172         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      173         ASK-OVERWRITE
      174         CREATE-TEST-FILE
      175         SAVE-AS
      176         USE-FILENAME
      177         DEFAULT-EXTENSION "txt"
      178         UPDATE glog
      179         .
      180       if not glog then  return.
      181       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      182       if p-is-stream then
      183       do:
      184         if p-is-append then
      185         do:
      186           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      187         end.
      188         else
      189         do:
      190           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      191         end.
      192       end.
      193       else
      194       do:
      195         if p-is-append then
      196         do:
      197           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      198         end.
      199         else
      200         do:
      201           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      202         end.
      203       end.
      204       p-process = yes.
      205     end.
      206   end procedure.
      207   procedure prn-lib-get-report-name :
      208     define input parameter parParentProc  as widget-handle no-undo.
      209     define output parameter p-report-name as character no-undo .
      210     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      211   end procedure.
      212   procedure prn-lib-reportviewer-report-name :
      213     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      214     define input parameter p-report-name-html as character no-undo .
      215     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      216   end procedure.
      217   procedure prn-lib-reportviewer :
      218     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      219     define input parameter p-report-name-html as character no-undo .
      220     define input parameter p-param        as character no-undo .
      221     define variable v-excel           as character no-undo init 'TRUE' .
      222     define variable v-value-character as character no-undo .
      223     define variable v-value-integer   as character no-undo .
      224     define variable v-value-date      as date      no-undo .
      225     define variable v-value-decimal   as decimal   no-undo .
      226     define variable rep-excel         as logical   no-undo .
      227     define variable excel-string      as character no-undo .
      228     define variable v-param-type      as character no-undo .
      229     define variable v-tth             as handle    no-undo .
      230     run adm/shattri.p (
      231       input "get":U
      232       ,input  ""
      233       ,input  0
      234       ,input  'report-glob':U
      235       ,input  'rep-excel':U
      236       ,output v-value-character
      237       ,output v-value-date
      238       ,output v-value-decimal
      239       ,output v-value-integer
      240       ,output rep-excel
      241       ,output v-param-type
      242       ,INPUT-OUTPUT table-handle v-tth
      243       )  .
      244     if rep-excel then v-excel = "TRUE" .
      245     else v-excel = "FALSE" .
      246     if p-param eq ""
      247     then
      248        p-param = "EXCEL:" + v-excel.
      249     else
      250        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      251     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      252   end procedure.
