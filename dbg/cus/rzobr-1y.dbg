     2177     END.
     2178     Else DO:
     2179      For each obj-list no-lock :
     2180                     FOR EACH gds-obj where
     2181                   gds-obj.obj-type = obj-list.obj-type    and
     2182                   gds-obj.obj-code = obj-list.obj-code
     2183                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2184                   no-lock,
     2185             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2186                   no-lock :
     2187                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2188                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2189                       Create temp-gds-list.
     2190                       Assign
     2191                         temp-gds-list.prod-code = gds-obj.prod-code
     2192                         temp-gds-list.grp-name  = gds-obj.grp-name
     2193                         temp-gds-list.gds-name  = goods.gds-name
     2194                         temp-gds-list.gds-code  = gds-obj.gds-code
     2195                         temp-gds-list.artic     = gds-obj.artic
     2196                       .
     2197                   End.
     2198               End.
     2199     End.
     2200     for each temp-gds-list no-lock
     2201       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2202         BREAK
     2203       BY gds-list.artic :
     2204       run item-goods ( "1" , "gds-list" ) .
     2205         if return-value <> "" then NEXT.
     2206     End.
     2207   End.
     2208           end.
     2209           end case.
     2210   end procedure.
     2211   PROCEDURE CalcItog :
     2212       run ostatok (
     2213           input x-store-code  ,
     2214           input x-store-type  ,x-TOG-Shift,
     2215           input x-date-start - 1 ,
     2216           input date('')      , x-Shift-Start,x-Shift-End,
     2217           input 'crsa':U   ,
     2218           input '##,##':U,
     2219           input xTog-obj ,
     2220           output  Quantity1  ,
     2221           output  Coast_R1   ,
     2222           output  Coast_V1   ,
     2223           output  VAT_R1     ,
     2224           output  VAT_V1     ,
     2225           output  Fact-order-1 ).
     2226       run ostatok (
     2227           input x-store-code  ,
     2228           input x-store-type  , x-TOG-Shift,
     2229           input x-date-start  ,
     2230           input x-date-end    , x-Shift-Start,x-Shift-End,
     2231           input 'crsa':U   ,
     2232           input '##,##':U,
     2233           input xTog-obj ,
     2234           output  Quantity1  ,
     2235           output  Coast_R1   ,
     2236           output  Coast_V1   ,
     2237           output  VAT_R1     ,
     2238           output  VAT_V1     ,
     2239           output  Fact-order-2 ).
     2240             Quantity1  = 0.
     2241             Coast_R1   = 0.
     2242             Coast_V1   = 0.
     2243             VAT_R1     = 0.
     2244             VAT_V1     = 0.
     2245   END PROCEDURE.
     2246   PROCEDURE display-str1  :
     2247              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2248            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2249            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2250            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     2251            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2252            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     2253            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     2254   end procedure.
     2255   procedure display-bi  :
     2256              run di-qnty("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     2257            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     2258            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     2259            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bi":u).  end.
     2260            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bi":u ). end.
     2261            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bi":u ).  end.
     2262            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bi":u ).  end.
     2263   END PROCEDURE.
     2264   PROCEDURE display-Bo  :
     2265              run di-qnty("кол-во",1,  "", "ИТОГО ПО" ,"ОБЪЕКТАМ" ,"", "bo":u).
     2266            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bo":u).  end.
     2267            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bo":u).  end.
     2268            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bo":u).  end.
     2269            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bo":u ). end.
     2270            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bo":u ).  end.
     2271            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bo":u ).  end.
     2272   end procedure.
     2273   PROCEDURE display-B1  :
     2274         if NOT( NOT Show-Negativ-2 and
     2275            ( b1-prih         [1]   = 0 AND
     2276              b1-rash          [1]   = 0 AND
     2277              b1-kassa         [1]   = 0 AND
     2278              b1-Inv           [1]   = 0 AND
     2279              b1-Overturn      [1]   = 0 AND
     2280              b1-Overturn      [5]   = 0 AND
     2281              b1-Overturn      [8]   = 0 ) ) then DO:
     2282           IF  NOT (NOT Show-Negativ  AND (
     2283                 b1-prih          [1]   = 0 AND
     2284                 b1-rash          [1]   = 0 AND
     2285                 b1-kassa         [1]   = 0 AND
     2286                 b1-Inv           [1]   = 0 AND
     2287                 b1-Overturn      [1]   = 0 AND
     2288                 b1-Overturn      [5]   = 0 AND
     2289                 b1-ostatok-start [1]   = 0 AND
     2290                 b1-ostatok-End   [1]   = 0   )) then DO:
     2291                 if Sums-Only THEN do:
     2292                     if fr0 = true then do:
     2293                         PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2294                         if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     2295                         fr0 = false .
     2296                       end.
     2297                  end.
     2298           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2299           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2300           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2301           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2302           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2303           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2304           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2305          if not sums-only then run p-line.
     2306    End.
     2307    end.
     2308   END PROCEDURE.
     2309   PROCEDURE display-B2  :
     2310        if NOT( NOT Show-Negativ-2 and
     2311            ( b2-prih         [1]   = 0 AND
     2312              b2-rash          [1]   = 0 AND
     2313              b2-kassa         [1]   = 0 AND
     2314              b2-Inv           [1]   = 0 AND
     2315              b2-Overturn      [1]   = 0 AND
     2316              b2-Overturn      [5]   = 0 AND
     2317              b2-Overturn      [8]   = 0 ) ) then DO:
     2318           IF  NOT (NOT Show-Negativ  AND (
     2319                 b2-prih          [1]   = 0 AND
     2320                 b2-rash          [1]   = 0 AND
     2321                 b2-kassa         [1]   = 0 AND
     2322                 b2-Inv           [1]   = 0 AND
     2323                 b2-Overturn      [1]   = 0 AND
     2324                 b2-Overturn      [5]   = 0 AND
     2325                 b2-ostatok-start [1]   = 0 AND
     2326                 b2-ostatok-End   [1]   = 0   )) then DO:
     2327           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     2328           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     2329           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     2330           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
     2331            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","b2":u ). end.
     2332            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","b2":u ).  end.
     2333            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","b2":u ).  end.
     2334    End.
     2335   end.
     2336   END PROCEDURE.
     2337   PROCEDURE Clear-B1  :
     2338    b1-gds-zap-other           = 0.
     2339    REPEAT kk = 1 to 9 :
     2340    Assign
     2341       b1-Prih                                            [kk]    = 0
     2342       b1-Rash                                            [kk]    = 0
     2343       b1-KAssa                                           [kk]    = 0
     2344       b1-Inv                                             [kk]    = 0
     2345       b1-Overturn                                        [kk]    = 0
     2346       b1-ostatok-end                                     [kk]    = 0
     2347       b1-ostatok-start                                   [kk]    = 0   .
     2348      End.
     2349    END PROCEDURE.
     2350   PROCEDURE Clear-B2  :
     2351    b2-gds-zap-other           = 0.
     2352    REPEAT kk = 1 to 9 :
     2353    Assign
     2354       b2-Prih                                            [kk]    = 0
     2355       b2-Rash                                            [kk]    = 0
     2356       b2-KAssa                                           [kk]    = 0
     2357       b2-Inv                                             [kk]    = 0
     2358       b2-Overturn                                        [kk]    = 0
     2359       b2-ostatok-end                                     [kk]    = 0
     2360       b2-ostatok-start                                   [kk]    = 0   .
     2361      End.
     2362   END PROCEDURE.
     2363   PROCEDURE Clear-Bi  :
     2364    bi-gds-zap-other           = 0.
     2365    REPEAT kk = 1 to 9 :
     2366    Assign
     2367       bi-Prih                                            [kk]    = 0
     2368       bi-Rash                                            [kk]    = 0
     2369       bi-KAssa                                           [kk]    = 0
     2370       bi-Inv                                             [kk]    = 0
     2371       bi-Overturn                                        [kk]    = 0
     2372       bi-ostatok-end                                     [kk]    = 0
     2373       bi-ostatok-start                                   [kk]    = 0   .
