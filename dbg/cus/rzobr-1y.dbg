     2134                 where gds-obj.prod-code  = g#cli.obj-code
     2135                 and  gds-obj.prod-type   = g#cli.obj-type
     2136                 no-lock,
     2137             first goods
     2138                 where gds-obj.gds-code = goods.gds-code no-lock :
     2139                   if not can-find (first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2140                       create temp-gds-list.
     2141                       assign
     2142                         temp-gds-list.prod-code = gds-obj.prod-code
     2143                         temp-gds-list.grp-name  = gds-obj.grp-name
     2144                         temp-gds-list.gds-name  = goods.gds-name
     2145                         temp-gds-list.gds-code  = gds-obj.gds-code
     2146                         temp-gds-list.artic     = gds-obj.artic
     2147                       .
     2148                   end.
     2149             end.
     2150       end.
     2151         for each temp-gds-list no-lock
     2152           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2153             break
     2154               by goods.artic :
     2155           run item-goods ( "1" , "goods" ) .
     2156             if return-value <> "" then next.
     2157         end.
     2158   end.
     2159     end.
     2160           otherwise do:
     2161   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2162   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2163       for each gds-obj  where
     2164             gds-obj.obj-type = x-store-type  and
     2165             gds-obj.obj-code = x-store-code
     2166             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2167                   no-lock,
     2168             First goods  where  gds-obj.gds-code   = goods.gds-code
     2169         no-lock,
     2170   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2171   no-lock
     2172   BREAK
     2173       BY (gds-list.artic) :
     2174         run item-goods ( "1" , "gds-list" ) .
