     2375   END PROCEDURE.
     2376   PROCEDURE Display-title :
     2377   define variable v-nn as integer   no-undo .
     2378      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2379             REPORTNAME  AT 20 format "X(170)" SKIP
     2380             Trim(str1)  AT 35 format "X(75)" SKIP.
     2381        v-nn = NUM-ENTRIES(str2,chr(10)) .
     2382        Repeat i = 1 to v-nn:
     2383         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     2384        End.
     2385       i=0.
     2386          PUT stream  OutStream  UNFORMATTED  Trim(str3)  AT 35 format "X(75)" SKIP.
     2387        v-nn = NUM-ENTRIES(str4,chr(10)).
     2388        Repeat i = 1 to v-nn :
     2389         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2390        End.
     2391       i=0.
     2392        v-nn = NUM-ENTRIES(ReportHeader,chr(10)) .
     2393        Repeat i = 1 to v-nn :
     2394         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2395        End.
     2396       i=0.
     2397       run rep/extitle.p (1) .
     2398   END PROCEDURE.
     2399   PROCEDURE ob-line  :
     2400   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2401   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2402   define INPUT  parameter x-artic        like ub.ot-line.artic        no-undo.
     2403   define INPUT  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2404   define INPUT  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2405   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2406   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2407   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2408   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2409   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2410   define input  parameter xTog-obj           as log no-undo.
     2411   define variable  tt#          as   int                 no-undo.
     2412    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     2413    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     2414    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     2415        FOR each ub.ot-line where
     2416                           ub.ot-line.artic         = x-artic
     2417                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2418                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2419                     AND   ub.ot-line.obj-code     = x-store-code
     2420                     AND   ub.ot-line.obj-type     = x-store-type
     2421                     AND   ub.ot-line.prod-code    = x-prod-code
     2422                     AND   ub.ot-line.prod-type    = x-prod-type
     2423                     AND   ub.ot-line.sum-type     = x-sum-type
     2424                       no-lock :
     2425       CASE ub.ot-line.ext-doc-type:
     2426                 WHEN        'ie':U  OR
     2427                 WHEN        're':U  OR
     2428                 WHEN        'iv':U    OR
     2429                 WHEN        'rv':U OR
     2430                 WHEN        'im':U     THEN
     2431                 DO:
     2432                 ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  ub.ot-line.fact-qnty
     2433                        prih[2 + tt#]   = prih[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2434                        prih[3 + tt#]   = prih[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2435                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2436                 End.
     2437                 WHEN       'ee':U      OR
     2438                 WHEN       'ep':U    OR
     2439                 WHEN       'ev':U     OR
     2440                 WHEN       'em':U       OR
     2441                 WHEN       'wm':U       OR
     2442                 WHEN       'we':U     THEN
     2443                 DO:
     2444                 ASSIGN  rash[1 + tt#]   = rash[1 + tt#]   +  ub.ot-line.fact-qnty
     2445                         rash[2 + tt#]   = rash[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2446                         rash[3 + tt#]   = rash[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2447                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2448                 End.
     2449                 WHEN       'es':U  OR
     2450                 WHEN       'rs':U THEN
     2451                 DO:
     2452                 ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.ot-line.fact-qnty
     2453                        kassa[2 + tt#]   = kassa[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2454                        kassa[3 + tt#]   = kassa[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2455                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2456                 End.
     2457             WHEN  'vt':U or when 'vp':U     THEN
     2458                 DO:
     2459                 ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.ot-line.fact-qnty
     2460                       inv[2 + tt#]   = inv[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2461                       Inv[3 + tt#]   = Inv[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.vat-base  .
     2462                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2463                 End.
     2464             WHEN       'ot':U THEN
     2465                 DO:
     2466                 ASSIGN Overturn[1 + tt#]   = Overturn[1 + tt#]   +  ub.ot-line.fact-qnty
     2467                       Overturn[2 + tt#]   = Overturn[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2468                       Overturn[3 + tt#]   = Overturn[3 + tt#]   +  if tPrintRubl then ub.ot-line.vat-rubl Else  ub.ot-line.vat-base  .
     2469                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2470                 End.
     2471         End CASE.
     2472     END.
     2473     if tt# = 6 then DO:
     2474              ASSIGN Overturn[1 + tt#]   = (Ostatok-end[1 + tt#]  - Ostatok-start[1 + tt#] )  -  (INV[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2475                     Overturn[2 + tt#]   = (Ostatok-end[2 + tt#]  - Ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  )
     2476                     Overturn[3 + tt#]   = (Ostatok-end[3 + tt#]  - Ostatok-start[3 + tt#] )  -  (Inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2477     End.
     2478   END PROCEDURE.
     2479   procedure ost-line :
     2480     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2481     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2482     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2483     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2484     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2485     define input  parameter x-tog-shift  as logical no-undo .
     2486     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2487     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2488     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2489     define input  parameter xtog-obj     as logical no-undo .
     2490     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2491     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2492     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2493     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2494     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2495     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2496     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2497     define buffer buff-obj-list  for obj-list .
     2498     define buffer buff-stk-line  for ub.stk-line .
     2499     assign
     2500       Quantity = 0
     2501       Coast_R  = 0
     2502       Coast_V  = 0
     2503       VAT_R    = 0
     2504       VAT_V    = 0
     2505       SLT_R    = 0
     2506       SLT_V    = 0
     2507     .
     2508     if  x-tog-shift = false then do:
     2509       for each buff-obj-list no-lock
     2510         where xtog-obj = false
     2511            or (buff-obj-list.obj-type = x-store-type
     2512               and buff-obj-list.obj-code = x-store-code
     2513               )
     2514       on error undo, return error
     2515       :
     2516       find last buff-stk-line no-lock
     2517         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2518           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2519           and buff-stk-line.artic      = x-artic
     2520           and buff-stk-line.prod-type  = x-prod-type
     2521           and buff-stk-line.prod-code  = x-prod-code
     2522           and buff-stk-line.sum-type   = x-sum-type
     2523           and buff-stk-line.cat-id     = '##,##':U
     2524           and buff-stk-line.fact-order <= x-fact-order
     2525           and buff-stk-line.shift-num  = 0
     2526         use-index category
     2527         no-error .
     2528       if available buff-stk-line then do:
     2529         assign
     2530           Quantity = Quantity + buff-stk-line.fact-qnty
     2531           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2532           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2533           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2534           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2535           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2536           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2537         .
     2538       end.
     2539      end.
     2540     end.
     2541     else do:
     2542       for each buff-obj-list no-lock
     2543         where xtog-obj = false
     2544            or (buff-obj-list.obj-type = x-store-type
     2545               and buff-obj-list.obj-code = x-store-code
     2546               )
     2547       on error undo, return error
     2548       :
     2549         find last buff-stk-line no-lock
     2550           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2551             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2552             and buff-stk-line.artic      = x-artic
     2553             and buff-stk-line.prod-type  = x-prod-type
     2554             and buff-stk-line.prod-code  = x-prod-code
     2555             and buff-stk-line.sum-type   = x-sum-type
     2556             and buff-stk-line.cat-id     = '##,##':U
     2557             and buff-stk-line.fact-order <= x-fact-order
     2558             and buff-stk-line.shift-num  > 0
     2559           use-index category
     2560           no-error .
     2561         if available buff-stk-line then do:
     2562           assign
     2563             Quantity = Quantity +  buff-stk-line.fact-qnty
     2564             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2565             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2566             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2567             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2568             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2569             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2570           .
     2571         end.
     2572       end.
     2573     end.
     2574   end procedure.
     2575   procedure ost-lineother-tax :
     2576     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2577     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2578     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2579     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2580     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2581     define input  parameter x-tog-shift  as logical no-undo .
     2582     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2583     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2584     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2585     define input  parameter xTog-obj     as logical no-undo .
     2586     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2587     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2588     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2589     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2590     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2591     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2592     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2593     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2594     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2595     define buffer buff-obj-list  for obj-list .
     2596     define buffer buff-stk-line  for ub.stk-line .
     2597     assign
     2598       Quantity = 0
     2599       Coast_R  = 0
     2600       Coast_V  = 0
     2601       VAT_R    = 0
     2602       VAT_V    = 0
     2603       SLT_R    = 0
     2604       SLT_V    = 0
     2605       other_R  = 0
     2606       other_V  = 0
     2607     .
     2608     if  x-tog-shift = false then do:
     2609       for each buff-obj-list no-lock
     2610         where xtog-obj = false
     2611            or (buff-obj-list.obj-type = x-store-type
     2612               and buff-obj-list.obj-code = x-store-code
     2613               )
     2614       on error undo, return error
     2615       :
     2616       find last buff-stk-line no-lock
     2617         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2618           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2619           and buff-stk-line.artic      = x-artic
     2620           and buff-stk-line.prod-type  = x-prod-type
     2621           and buff-stk-line.prod-code  = x-prod-code
     2622           and buff-stk-line.sum-type   = x-sum-type
     2623           and buff-stk-line.cat-id     = '##,##':U
     2624           and buff-stk-line.fact-order <= x-fact-order
     2625           and buff-stk-line.shift-num  = 0
     2626         use-index category
     2627         no-error .
     2628       if available buff-stk-line then do:
     2629         assign
     2630           Quantity = Quantity + buff-stk-line.fact-qnty
     2631           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     2632           Coast_V  = Coast_V  + buff-stk-line.sum-base
     2633           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     2634           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     2635           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     2636           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     2637           other_R  = other_R  + buff-stk-line.other-rubl
     2638           other_V  = other_V  + buff-stk-line.other-base
     2639         .
     2640       end.
     2641    end.
     2642     end.
     2643     else do:
     2644       for each buff-obj-list no-lock
     2645         where xtog-obj = false
     2646            or (buff-obj-list.obj-type = x-store-type
     2647               and buff-obj-list.obj-code = x-store-code
     2648               )
     2649       on error undo, return error
     2650       :
     2651         find last buff-stk-line no-lock
     2652           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2653             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2654             and buff-stk-line.artic      = x-artic
     2655             and buff-stk-line.prod-type  = x-prod-type
     2656             and buff-stk-line.prod-code  = x-prod-code
     2657             and buff-stk-line.sum-type   = x-sum-type
     2658             and buff-stk-line.cat-id     = '##,##':U
     2659             and buff-stk-line.fact-order <= x-fact-order
     2660             and buff-stk-line.shift-num  > 0
     2661           use-index category
     2662           no-error .
     2663         if available buff-stk-line then do:
     2664           assign
     2665             Quantity = Quantity +  buff-stk-line.fact-qnty
     2666             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2667             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2668             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2669             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2670             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2671             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2672             other_R = other_R   +  buff-stk-line.other-rubl
     2673             other_V = other_V   +  buff-stk-line.other-base
     2674           .
     2675         end.
     2676       end.
     2677     end.
     2678   end procedure.
     2679   procedure ost-line-kg :
     2680     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2681     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2682     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2683     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2684     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2685     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2686     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2687     define buffer buff-obj-list  for obj-list .
     2688     define buffer buf_doc-line for ub.doc-line .
     2689     define buffer buf_inv-line for ub.inv-line .
     2690     do
     2691     on error undo, return error
     2692     :
     2693       for each buf_doc-line no-lock where
     2694                buf_doc-line.obj-type    = p-obj-type   and
     2695                buf_doc-line.obj-code    = p-obj-code   and
     2696                buf_doc-line.prod-type   = p-prod-type  and
     2697                buf_doc-line.prod-code   = p-prod-code  and
     2698                buf_doc-line.artic       = p-artic      and
     2699                buf_doc-line.status_     = 'факт':U      and
     2700                buf_doc-line.fact-order <= p-fact-order
     2701             by buf_doc-line.fact-order    descending
     2702       :
     2703         find first buf_inv-line no-lock where
     2704                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2705                    buf_inv-line.artic     = buf_doc-line.artic     and
     2706                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2707                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2708         if available buf_inv-line
     2709         then do:
     2710           if buf_inv-line.after-cli-qnty <> ?
     2711           then do:
     2712             assign
     2713               p-quantity-kg = buf_inv-line.after-cli-qnty
     2714             .
     2715             leave .
     2716           end.
     2717         end.
     2718       end.
     2719       if p-quantity-kg = ?
     2720       then do:
     2721         assign
     2722           p-quantity-kg = 0
     2723         .
     2724       end.
     2725     end.
     2726   end procedure.
     2727   PROCEDURE ostatok :
     2728   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2729   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2730   def input parameter x-tog-shift   as   logical             no-undo.
     2731   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2732   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2733   def input parameter x-shift-start as integer               no-undo.
     2734   def input parameter x-shift-end   as integer               no-undo.
     2735   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2736   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2737   def input parameter xTog-obj   as log no-undo.
     2738   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2739   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2740   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2741   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2742   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2743   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2744   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2745   def var              Fact-orderS   as char  no-undo.
     2746   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2747      Assign
     2748         Fact-order   = 0
     2749         Quantity     = 0
     2750         Coast_R      = 0
     2751         Coast_V      = 0
     2752         VAT_R        = 0
     2753         VAT_V        = 0 .
     2754    x-date-start-t  = x-date-start + 1 .
     2755   IF x-date-end = date('') then DO:
     2756      Fact-order = 0 .
     2757      for each obj-list
     2758          where  ( not xtog-obj or
     2759                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2760                 no-lock :
     2761         if  x-tog-shift = false then do:
     2762                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2763                               ub.stk-tot.Fact-date <=  x-date-start
     2764                               and ub.stk-tot.shift-num = 0
     2765                               USE-INDEX fact-date no-lock no-error .
     2766              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2767         End.
     2768         Else  DO :
     2769             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2770              (ub.stk-tot.shift-date  = x-date-start-t and
     2771               ub.stk-tot.shift-num  < x-shift-start or
     2772               ub.stk-tot.shift-date  < x-date-start-t  )
     2773               and ub.stk-tot.shift-num  > 0
     2774               USE-INDEX Shift-num no-lock no-error .
     2775            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2776           END.
     2777       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2778     End.
     2779   End.
     2780   Else DO:
     2781     For each obj-list  WHERE
     2782        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2783         no-lock :
     2784      IF  x-TOG-Shift = False Then DO:
     2785          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2786               ub.stk-tot.Fact-date <= x-date-end
     2787               and ub.stk-tot.shift-num = 0
     2788               USE-INDEX fact-date no-lock no-error.
     2789          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2790      END.
     2791      Else DO:
     2792           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2793               (ub.stk-tot.shift-date  = x-date-end and
     2794               ub.stk-tot.shift-num  <= x-shift-end or
     2795               ub.stk-tot.shift-date  < x-date-end       ) and
     2796               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2797               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2798       End.
     2799       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2800     End.
     2801   End.
     2802   END PROCEDURE.
     2803   PROCEDURE report-exec1  :
     2804      FIND FIRST clients where x-store-type = clients.obj-type AND
     2805                               x-store-code = clients.obj-code no-lock no-error.
     2806     run waitfram-show(clients.obj-name) .
     2807     run calcitog.
     2808     run print-header.
     2809      case retclassify :
     2810        when "no-classify":u     then run run1.
     2811        otherwise do:
     2812          message "Ошибка вызова!"  view-as alert-box error .
     2813        end.
     2814      end case.
     2815     run print-footer.
     2816     END PROCEDURE.
     2817   PROCEDURE Calc-Sub-itog :
     2818   define input parameter tt as int no-undo.
     2819   define variable b as int no-undo.
     2820   if tt = 6  then Assign
     2821     B1-gds-zap-other = B1-gds-zap-other +  gds-zap-other
     2822     B2-gds-zap-other = B2-gds-zap-other +  gds-zap-other
     2823     Bi-gds-zap-other = Bi-gds-zap-other +  gds-zap-other
     2824     Bo-gds-zap-other = Bo-gds-zap-other +  gds-zap-other
     2825     .
     2826   repeat b = 1 to 3:
     2827     Assign
     2828     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     2829     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     2830     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     2831     Bo-Prih[b + TT]    = Bo-Prih[b + TT]    +  Prih[b + TT]
     2832     Bo-ostatok-start[b + TT]    = Bo-ostatok-start[b + TT]    +  ostatok-start[b + TT]
     2833     Bo-ostatok-end[b + TT]      = Bo-ostatok-end[b + TT]      +  ostatok-end[b + TT]
     2834     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     2835     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     2836     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     2837     Bo-RAsh[b + TT]    = Bo-RAsh[b + TT]    +  RAsh[b + TT]
     2838     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     2839     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     2840     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     2841     Bo-Kassa[b + TT]    = Bo-Kassa[b + TT]    +  Kassa[b + TT]
     2842     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     2843     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     2844     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     2845     Bo-Inv[b + TT]    = Bo-Inv[b + TT]    +  Inv[b + TT]
     2846     B1-Overturn[b + TT]    = B1-Overturn[b + TT]    +  Overturn[b + TT]
     2847     B2-Overturn[b + TT]    = B2-Overturn[b + TT]    +  Overturn[b + TT]
     2848     Bi-Overturn[b + TT]    = Bi-Overturn[b + TT]    +  Overturn[b + TT]
     2849     Bo-Overturn[b + TT]    = Bo-Overturn[b + TT]    +  Overturn[b + TT] .
     2850   End.
     2851   END PROCEDURE.
     2852   PROCEDURE Clear-item :
     2853   define variable kk as int no-undo.
     2854    gds-zap-other = 0 .
     2855    REPEAT kk = 1 to 9 :
     2856    Assign
     2857       prih            [kk]    = 0
     2858       rash            [kk]    = 0
     2859       kassa           [kk]    = 0
     2860       Inv             [kk]    = 0
     2861       Overturn        [kk]    = 0
     2862       ostatok-end     [kk]    = 0
     2863       ostatok-start   [kk]    = 0 .
     2864          End.
     2865    END PROCEDURE.
     2866   PROCEDURE Item-Goods :
     2867      define input parameter  par-3 as char no-undo.
     2868      define input parameter  par-4 as char no-undo.
     2869        if par-4 = "goods":U  Then DO:
     2870           assign
     2871               gds-zap-unit-base  = Goods.unit-base
     2872               gds-zap-prt-root   = Goods.prt-root
     2873               gds-zap-prod-type  = Goods.prod-type
     2874               gds-zap-prod-code  = Goods.prod-code
     2875               gds-zap-artic      = Goods.artic
     2876               gds-zap-grp-name   = Goods.grp-name
     2877               gds-zap-b-code     = Goods.gds-code
     2878               gds-zap-type       = Goods.gds-type.
     2879           if g#gds-engl then
     2880               assign gds-zap-gds-name = Goods.engl-name.
     2881           else
     2882               assign gds-zap-gds-name = Goods.gds-name.
     2883        End.
     2884        if par-4 = "gds-list":U  Then DO:
     2885           assign
     2886               gds-zap-unit-base  = gds-list.unit-base
     2887               gds-zap-prt-root   = gds-list.prt-root
     2888               gds-zap-prod-type  = gds-list.prod-type
     2889               gds-zap-prod-code  = gds-list.prod-code
     2890               gds-zap-artic      = gds-list.artic
     2891               gds-zap-grp-name   = gds-list.grp-name
     2892               gds-zap-b-code     = gds-list.gds-code
     2893               gds-zap-type       = gds-list.gds-type.
     2894           if g#gds-engl then
     2895               assign gds-zap-gds-name = gds-list.engl-name.
     2896           else
     2897               assign gds-zap-gds-name = gds-list.gds-name.
     2898        End.
     2899       run foreach.
     2900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2901     (input  gds-zap-b-code
     2902     ,input  ?
     2903     ,output v-bar-code
     2904     )  .
     2905   s-bar-code = string (v-bar-code,"999999999").
     2906       If  break_group = true  and par-3 <> "1"  then DO :
     2907            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     2908            gds-zap-prod-name  = clients.obj-name.
     2909             If break_group1 = true  THEN  DO :
     2910               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     2911                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     2912                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     2913               if par-3 = "6"  then  dO:
     2914                  if xTog-obj = true then do:
     2915                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     2916                     .
     2917                   end.
     2918                  else do:
     2919                   var-vat-pc = temp-gds-list.vat-pc .
     2920                   end.
     2921                   assign
     2922                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     2923                       b1-name = temp-str.
     2924                   end.
     2925               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     2926                   fr0 = true .
     2927                   tmp#stroka0 = temp-str.
     2928               End.
     2929             End.
     2930               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     2931                 if par-3 = "4"
     2932                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     2933                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     2934                 if NOT xSumsOnly THEN DO:
     2935                     fr = true .
     2936                 End.
     2937                 break_group1 = false.
     2938               END.
     2939          break_group = false.
     2940       End.
     2941       run display-line.
     2942    END PROCEDURE.
