     2013   procedure run1sort2 :
     2014          case select-good :
     2015           when 1  then do:
     2016   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2017   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2018       for each gds-obj  where
     2019             gds-obj.obj-type = x-store-type  and
     2020             gds-obj.obj-code = x-store-code
     2021             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2022                   no-lock,
     2023             First goods  where  gds-obj.gds-code   = goods.gds-code
     2024   no-lock
     2025   BREAK
     2026       BY (goods.artic) :
     2027         run item-goods ( "1" , "goods" ) .
     2028         if return-value <> "" then NEXT.
     2029       End.
     2030     END.
     2031     Else DO:
     2032      For each obj-list no-lock :
     2033                     FOR EACH gds-obj where
     2034                   gds-obj.obj-type = obj-list.obj-type    and
     2035                   gds-obj.obj-code = obj-list.obj-code
     2036                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2037                   no-lock :
     2038                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2039                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2040                       Create temp-gds-list.
     2041                       Assign
     2042                         temp-gds-list.prod-code = gds-obj.prod-code
     2043                         temp-gds-list.grp-name  = gds-obj.grp-name
     2044                         temp-gds-list.gds-name  = goods.gds-name
     2045                         temp-gds-list.gds-code  = gds-obj.gds-code
     2046                         temp-gds-list.artic     = gds-obj.artic
     2047                       .
     2048                   End.
     2049               End.
     2050     End.
     2051     for each temp-gds-list no-lock
     2052       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2053         BREAK
     2054       BY goods.artic :
     2055       run item-goods ( "1" , "goods" ) .
     2056         if return-value <> "" then NEXT.
     2057     End.
     2058   End.
     2059     end.
     2060           when 2  then do:
     2061   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2062     if x-selectobject = "currency":u  or  xtog-obj then do:
     2063         for  each gds-obj
     2064                     where gds-obj.obj-code   = x-store-code
     2065                      and  gds-obj.obj-type   = x-store-type
     2066                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2067                           no-lock ,
     2068                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2069                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     2070                     break
     2071                     by goods.artic :
     2072                     run item-goods ( input "1" , input "goods" ) .
     2073                     if return-value <> "" then next.
     2074         end.
     2075     end.
     2076     else do:
     2077         for each obj-list no-lock :
     2078               for  each gds-obj
     2079                 where  gds-obj.obj-code   = obj-list.obj-code
     2080                   and  gds-obj.obj-type   = obj-list.obj-type
     2081                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2082                 no-lock ,
     2083                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2084                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     2085                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2086                           create temp-gds-list.
     2087                           assign
     2088                             temp-gds-list.prod-code = gds-obj.prod-code
     2089                             temp-gds-list.grp-name  = gds-obj.grp-name
     2090                             temp-gds-list.gds-name  = goods.grp-name
     2091                             temp-gds-list.gds-code  = gds-obj.gds-code
     2092                             temp-gds-list.artic     = gds-obj.artic
     2093                           .
     2094                       end.
     2095               end.
     2096       end.
     2097     for each temp-gds-list no-lock
     2098       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2099         break
     2100       by goods.artic :
     2101       run item-goods ( "1" , "goods" ) .
     2102         if return-value <> "" then next.
     2103     end.
     2104   end.
     2105     end.
     2106           when 3 then do:
     2107   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2108   if x-selectobject = "currency":u  or  xtog-obj then do:
     2109     for  each gds-obj
     2110         where  gds-obj.obj-code   = x-store-code
     2111           and  gds-obj.obj-type   = x-store-type
     2112                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2113                 no-lock ,
     2114     first g#cli
     2115           where gds-obj.prod-code  = g#cli.obj-code
     2116           and  gds-obj.prod-type   = g#cli.obj-type
     2117           no-lock,
     2118     first goods
     2119           where gds-obj.gds-code = goods.gds-code no-lock
     2120           break
     2121           by goods.artic :
     2122           run item-goods ( "1" , "goods" ) .
     2123           if return-value <> "" then next.
