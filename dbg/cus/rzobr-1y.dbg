     2125     end.
     2126     else do:
     2127       for each obj-list no-lock :
     2128             for  each gds-obj
     2129               where  gds-obj.obj-code   = obj-list.obj-code
     2130                 and  gds-obj.obj-type   = obj-list.obj-type
     2131                       and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2132                       no-lock ,
