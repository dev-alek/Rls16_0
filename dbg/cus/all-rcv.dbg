     2564     hide sch-num in frame Dialog-Frame.
     2565   end.
     2566    sch-field = "rcv-date".
     2567    assign sch-date-rcv = input frame Dialog-Frame sch-date-rcv.
     2568    find first ub.ord-doc-rcv no-lock  where ub.ord-doc-rcv.fact-date  = sch-date-rcv no-error .
     2569           if available ub.ord-doc-rcv then doc-rec = recid( ub.ord-doc-rcv) .
     2570               else doc-rec = ? .
