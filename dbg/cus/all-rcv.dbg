     4778   MAIN-BLOCK:
     4779   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4780      ON stop    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4781      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4782     b-exec:POPUP-MENU IN FRAME Dialog-Frame = MENU m-exec:HANDLE.
     4783     b-exec:MENU-MOUSE = 1.
     4784     b-export:POPUP-MENU IN FRAME Dialog-Frame = MENU m-export:HANDLE.
     4785     b-export:MENU-MOUSE = 1.
     4786     b-rep:POPUP-MENU IN FRAME Dialog-Frame = MENU m-rep:HANDLE.
     4787     b-rep:MENU-MOUSE = 1.
     4788     b-print:POPUP-MENU IN FRAME Dialog-Frame = MENU m-print:HANDLE.
     4789     b-print:MENU-MOUSE = 1.
     4790   if lookup (list-mode , "without-fo,whith-fo,firm-fin" ) > 0  then do:
     4791       ASSIGN
     4792         MENU-ITEM m_lkp-fo :SENSITIVE IN MENU m-exec = true
     4793         MENU-ITEM m_gen-1 :SENSITIVE IN MENU m-exec = true
     4794         MENU-ITEM m_gen-2 :SENSITIVE IN MENU m-exec = true
     4795         MENU-ITEM m_gen-3 :SENSITIVE IN MENU m-exec = true
