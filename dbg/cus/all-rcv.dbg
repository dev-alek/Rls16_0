     3230           end.
     3231           else do:
     3232             if frame Dialog-Frame :scrollable = true
     3233             then do:
     3234               assign
     3235                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3236               .
     3237             end.
     3238             assign
     3239               frame Dialog-Frame :width = v-frame-width
     3240             .
     3241             for each buf_temp-browse-handle
     3242               where buf_temp-browse-handle.browse-type = 'width':u
     3243             on error undo, next
     3244             :
     3245               assign
     3246                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3247               .
     3248             end.
     3249             assign
     3250               v-diasize-browse-handle :width = v-browse-width
     3251             .
     3252             for each buf_temp-diasize-handle
     3253             on error undo, next
     3254             :
     3255               assign
     3256                 v-object-handle = buf_temp-diasize-handle.handle-value
     3257               .
     3258               if v-object-handle <> v-diasize-resize-button
     3259               then do:
     3260                 assign
