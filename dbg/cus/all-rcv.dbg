     2127        RECT-1 AT ROW 2 COL 52 WIDGET-ID 10
     2128        SPACE(0.00) SKIP(17.21)
     2129       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2130            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2131            TITLE "Поставки под заказ"
     2132            CANCEL-BUTTON b-quit.
     2133   ASSIGN
     2134          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2135          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2136   ASSIGN
     2137          b-exec:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-exec:HANDLE.
     2138   ASSIGN
     2139          b-export:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-export:HANDLE.
     2140   ASSIGN
     2141          b-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-print:HANDLE.
     2142   ASSIGN
     2143          b-rep:POPUP-MENU IN FRAME Dialog-Frame       = MENU m-rep:HANDLE.
     2144   ASSIGN
     2145          sch-num:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2146   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2147   DO:
     2148     APPLY "END-ERROR":U TO SELF.
     2149   END.
     2150   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     2151   DO:
     2152   if not available bufs_ord-doc-rcv then return .
     2153   define variable  v-line-mode  as character no-undo .
     2154   define variable  v-doc-mode   as character no-undo .
     2155   define variable  v-list-mode  as character no-undo .
     2156    define variable g-log as logical   no-undo .
     2157   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2158   do:
     2159     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2160       (input  v-cntxt-db-num
     2161       ,input  v-cntxt-userid
     2162       ,input  0
     2163       ,input  'actn_ord-rcv_update':U
     2164       ,input  'object':U
     2165       ,input  v-cntxt-host-code-obj
     2166       ,input  v-cntxt-obj-type
     2167       ,input  v-cntxt-obj-code
     2168       ,input  0
     2169       ,input  0
     2170       ,input  0
     2171       ,input  true
     2172       ,output g-log
     2173       )  .
     2174   end.
     2175    if not g-log then  return .
     2176   if buf_ord-doc.doc-type = 'ОО':U then return.
     2177       if available bufs_ord-doc-rcv then do:
     2178             if bufs_ord-doc-rcv.status_ = 'факт':U then do :
     2179                 message "Статус" caps(bufs_ord-doc-rcv.status_) "изменять нельзя! " view-as alert-box error .
     2180                 ll-rec = recid(bufs_ord-doc-rcv) .
     2181                 return no-apply .
     2182             end.
     2183             ll-rec = recid(bufs_ord-doc-rcv) .
     2184           if bufs_ord-doc-rcv.status_ = 'поставка':U then  do:
     2185                 assign
     2186                   v-line-mode  = 'ПРОСМОТР':U
     2187                   v-doc-mode   = 'ПРОСМОТР':U
     2188                   v-list-mode  = 'поставка':U
     2189                  .
     2190           end.
     2191           else  do:
     2192                 assign
     2193                   v-line-mode = 'ИЗМЕНЕНИЕ':U
     2194                   v-doc-mode  = 'ИЗМЕНЕНИЕ':U
     2195                   .
     2196           end.
     2197           run cus/or-obj.w (
     2198                  input  parParentProc
     2199                , input  p-host-code
     2200                , input  recid(bufs_ord-doc-rcv)
     2201                , input  3
     2202                , input  v-list-mode
     2203                , input  v-line-mode
     2204                , input-output  v-doc-mode  ) .
     2205           v-glog =  br-docs:refresh() .
     2206       end.
     2207   apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     2208   END.
     2209   ON CHOOSE OF MENU-ITEM m_gen-1
     2210   DO:
     2211   run proc-m_gen-1 no-error .
     2212     if error-status :error then do: message return-value error-status :get-message(1) . return no-apply. end.
     2213   END.
     2214   ON CHOOSE OF MENU-ITEM m_gen-2
     2215   DO:
     2216   run proc-m_gen-2 no-error .
