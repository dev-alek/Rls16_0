     2058         mark-string (buffer bufs_ord-doc-rcv) @ mark COLUMN-LABEL "*" FORMAT "x(1)"
     2059   if bufs_ord-doc-rcv.ord-int2 = integer('2':U) then "!" else "" column-label "!" FORMAT "x(1)" COLUMN-FGCOLOR 12
     2060   IF (bufs_ord-doc-rcv.doc-type = "out":U) THEN ("внешн") ELSE ("внутр") COLUMN-LABEL "Тип" FORMAT "x(5)"
     2061   IF (bufs_ord-doc-rcv.status_ = 'факт':U or bufs_ord-doc-rcv.status_ = 'закрыто':U)  THEN (bufs_ord-doc-rcv.status_ + string(bufs_ord-doc-rcv.flag_,"+/-"))  ELSE (bufs_ord-doc-rcv.status_)  COLUMN-LABEL "Статус"
     2062   bufs_ord-doc-rcv.rcv-code COLUMN-LABEL "Номер"
