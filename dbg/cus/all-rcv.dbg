     2071   f-fo ( buffer bufs_ord-doc-rcv ) @ v-fo column-label "ФО" format "x(11)"
     2072   STRING(bufs_ord-doc-rcv.ship-time, "HH:MM")  FORMAT "x(6)" @ bufs_ord-doc-rcv.ship-time COLUMN-LABEL "Время"
     2073   STRING(bufs_ord-doc-rcv.fact-ship-time, "HH:MM")  FORMAT "x(6)" @ bufs_ord-doc-rcv.fact-ship-time COLUMN-LABEL "Факт"
     2074   bufs_ord-doc-rcv.cons-code COLUMN-LABEL "СЗФП"
