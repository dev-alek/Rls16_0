     2067   sum-rubl (buffer bufs_ord-doc-rcv) @ prt-sum-rubl COLUMN-LABEL "Сумма поставки" FORMAT ">>>>>>>>>>>>9.99"
     2068   bufs_ord-doc-rcv.ship-date COLUMN-LABEL "Доставка" FORMAT "99/99/99"
