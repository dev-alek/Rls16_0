     1879   define NEW SHARED  buffer  loc-doc-rcv   for ub.ord-doc-rcv.
     1880   define NEW SHARED  variable br-rcv-handle as handle no-undo   .
     1881   define NEW SHARED  variable x-make-avto   as integer no-undo .
