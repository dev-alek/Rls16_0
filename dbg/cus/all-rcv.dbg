     2108        b-chg AT ROW 2 COL 4
     2109        b-lkp AT ROW 2 COL 13
     2110        b-del AT ROW 2 COL 25
     2111        b-export AT ROW 2 COL 37 WIDGET-ID 2
     2112        r-cli-type AT ROW 3 COL 51.13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
     2113        r-cli-code AT ROW 3 COL 57.5 COLON-ALIGNED NO-LABEL WIDGET-ID 16
     2114        r-cli AT ROW 3 COL 73.75 WIDGET-ID 18
