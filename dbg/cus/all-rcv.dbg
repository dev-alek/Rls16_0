     1901   FUNCTION sum-rubl returns decimal (buffer loc-t-doc for bufs_ord-doc-rcv) .
     1902     define buffer buf_ord-line-rcv for ub.ord-line-rcv .
     1903     define variable v-sum as decimal   no-undo .
     1904     v-sum = 0.
     1905     for each buf_ord-line-rcv no-lock where
     1906             buf_ord-line-rcv.doc-code = loc-t-doc.doc-code and
     1907             buf_ord-line-rcv.rcv-code = loc-t-doc.rcv-code
     1908             :
     1909         v-sum = v-sum  + buf_ord-line-rcv.cli-qnty * buf_ord-line-rcv.price-cli .
     1910     end.
     1911     return v-sum .
     1912   END FUNCTION.
     1913   FUNCTION cli-doc-out returns character (buffer loc-doc for ub.ord-doc-rcv) .
     1914     return entry(1,loc-doc.sub-par,chr(4)) .
     1915   END FUNCTION.
     1916   FUNCTION cli-name returns character (buffer loc-t-doc for bufs_ord-doc-rcv) .
     1917   define buffer buf_clients for ub.clients  .
     1918   find first buf_clients no-lock where
     1919              buf_clients.obj-type = loc-t-doc.cli-type and
     1920              buf_clients.obj-code = loc-t-doc.cli-code no-error .
     1921       if available buf_clients then return buf_clients.obj-name.
     1922          else return loc-t-doc.obj-type + string(loc-t-doc.obj-code) .
     1923   END FUNCTION.
     1924   FUNCTION mark-string RETURNs CHAR (buffer loc-t-doc for bufs_ord-doc-rcv ).
