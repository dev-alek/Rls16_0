     1468   define  stream PrnLibStream.
     1469   procedure prn-lib-prn-file :
     1470     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1471     define input parameter p-DIsabledoptions as integer no-undo .
     1472     define variable v-report-name as character no-undo .
     1473     define variable v-user-action as character no-undo .
     1474     define variable v-printed     as logical   no-undo .
     1475     define variable v-exist       as logical   no-undo .
     1476     do
     1477       on error undo, return error
     1478       :
     1479       run prn-lib-get-report-name  in this-procedure (
     1480         input parParentProc
     1481         ,output v-report-name
     1482         ).
     1483   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1484   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1485     (input  v-report-name
     1486     ,input  2
     1487     ,output v-exist
     1488     )  .
     1489       if NOT v-exist then
     1490       DO:
     1491         Message
     1492           "Нет заданий на печать ! "
     1493           view-as alert-box .
     1494         Return  .
     1495       End.
     1496       run gbl/prnfilen.w
     1497         (input  ""
     1498         ,input  p-DisabledOptions
     1499         ,input  string(v-report-name )
     1500         ,input  7
     1501         ,output v-user-action
     1502         ,output v-printed
     1503         ) .
     1504       if v-printed then
     1505       do:
     1506         return "YES" .
     1507       end.
     1508       else
     1509       do:
     1510         return "NO" .
     1511       end.
     1512     end.
     1513   end procedure.
     1514   procedure prn-lib-open-stream :
     1515     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1516     define input parameter p-page-size    as integer no-undo .
     1517     define input parameter p-is-stream    as logical no-undo .
     1518     define input parameter p-append       as logical no-undo .
     1519     define variable v-report-name as character no-undo .
     1520     do
     1521       on error undo, return error
     1522       :
     1523       run prn-lib-get-report-name  in this-procedure (
     1524         input parParentProc
     1525         ,output v-report-name
     1526         ).
     1527       if p-is-stream then
     1528       do:
     1529         if p-append then
     1530         do:
     1531           output stream PrnLibStream to value( v-report-name )
     1532             page-size value(p-page-size) append .
     1533         end.
     1534         if not p-append then
     1535         do:
     1536           output stream PrnLibStream to value( v-report-name )
     1537             page-size value(p-page-size) .
     1538         end.
     1539       end.
     1540       if not p-is-stream then
     1541       do:
     1542         if p-append then
     1543         do:
     1544           output to value( v-report-name )
     1545             page-size value(p-page-size) append .
     1546         end.
     1547         if not p-append then
     1548         do:
     1549           output to value( v-report-name )
     1550             page-size value(p-page-size) .
     1551         end.
     1552       end.
     1553     end.
     1554   end procedure.
     1555   procedure prn-lib-open-exp :
     1556     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1557     define input parameter p-is-stream    as logical no-undo .
     1558     define input parameter p-is-append    as logical no-undo .
     1559     define output parameter p-ReportFileName as char init "report" no-undo.
     1560     define output parameter p-process as logical no-undo .
     1561     define variable glog as logical no-undo .
     1562     do
     1563       on error undo, return error
     1564       :
     1565       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1566         TITLE      "Укажите путь"
     1567         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1568         ASK-OVERWRITE
     1569         CREATE-TEST-FILE
     1570         SAVE-AS
     1571         USE-FILENAME
     1572         DEFAULT-EXTENSION "txt"
     1573         UPDATE glog
     1574         .
     1575       if not glog then  return.
     1576       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1577       if p-is-stream then
     1578       do:
     1579         if p-is-append then
     1580         do:
     1581           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1582         end.
     1583         else
     1584         do:
     1585           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1586         end.
     1587       end.
     1588       else
     1589       do:
     1590         if p-is-append then
     1591         do:
     1592           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1593         end.
     1594         else
     1595         do:
     1596           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1597         end.
     1598       end.
     1599       p-process = yes.
     1600     end.
     1601   end procedure.
