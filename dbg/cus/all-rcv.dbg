     2584   end.
     2585    sch-field = "rcv-code".
     2586    assign sch-rcv = input frame Dialog-Frame sch-rcv.
     2587    find first ub.ord-doc-rcv no-lock where ub.ord-doc-rcv.rcv-code  begins sch-rcv no-error .
     2588           if available ord-doc-rcv then doc-rec = recid(ub.ord-doc-rcv) .
     2589               else doc-rec = ? .
