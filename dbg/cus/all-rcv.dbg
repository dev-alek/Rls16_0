     2233   END.
     2234   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     2235   DO:
     2236       run cus/rcv-clos.p
     2237         ( input parParentProc ,
     2238           input bufs_ord-doc-rcv.rcv-code ,
     2239           input yes ,
     2240           input store-type ,
     2241           input store-code ,
     2242           input yes
     2243           ) no-error .
     2244       if error-status :error then do:
     2245             message  return-value  view-as alert-box error .
     2246             return no-apply .
     2247       end.
     2248     if p-g#stat = ? then  v-glog =  br-docs:refresh() .
     2249                   else OPEN QUERY br-docs FOR EACH bufs_ord-doc-rcv NO-LOCK where ( if list-mode = 'obj':U then ( bufs_ord-doc-rcv.obj-code = store-code and                                 bufs_ord-doc-rcv.obj-type = store-type)                           else (                                  if list-mode = 'cli':U then (bufs_ord-doc-rcv.cli-code = store-code and                                                               bufs_ord-doc-rcv.cli-type = store-type)                                                         else ( true = true )                                ) )    and bufs_ord-doc-rcv.host-code = p-host-code and (p-g#cons-code = ? or ( bufs_ord-doc-rcv.cons-code = p-g#cons-code)) and (p-g#type = ? or  ( bufs_ord-doc-rcv.doc-type = p-g#type)) and (p-g#stat = ? or  (bufs_ord-doc-rcv.status_ = p-g#stat  )) and (hard-flt-date = no or ( bufs_ord-doc-rcv.ship-date >= sch-ship and bufs_ord-doc-rcv.ship-date <= sch-ship-2 )) and (hard-flt-cli  = no or ( bufs_ord-doc-rcv.cli-code = r-cli-code and bufs_ord-doc-rcv.cli-type = r-cli-type)) ,        EACH buf_ord-doc WHERE buf_ord-doc.doc-code = bufs_ord-doc-rcv.doc-code OUTER-JOIN NO-LOCK by  bufs_ord-doc-rcv.doc-date desc by bufs_ord-doc-rcv.doc-code desc .
     2250   END.
     2251   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     2252   DO:
     2253   if not available bufs_ord-doc-rcv then return .
     2254    define variable g-log as logical   no-undo .
     2255   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2256   do:
     2257     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2258       (input  v-cntxt-db-num
     2259       ,input  v-cntxt-userid
     2260       ,input  0
     2261       ,input  'actn_ord-rcv_deletion':U
     2262       ,input  'object':U
     2263       ,input  v-cntxt-host-code-obj
     2264       ,input  v-cntxt-obj-type
     2265       ,input  v-cntxt-obj-code
     2266       ,input  0
     2267       ,input  0
     2268       ,input  0
     2269       ,input  true
     2270       ,output g-log
     2271       )  .
     2272   end.
     2273    if not g-log then  return .
     2274     if buf_ord-doc.doc-type = 'ОО':U then return.
     2275       if available bufs_ord-doc-rcv then do:
     2276          find current bufs_ord-doc-rcv exclusive-lock no-error.
     2277               if avail bufs_ord-doc-rcv then do:
