     4801         MENU-ITEM m_lkp-fo :SENSITIVE IN MENU m-exec =  false
     4802         MENU-ITEM m_gen-1  :SENSITIVE IN MENU m-exec =  false
     4803         MENU-ITEM m_gen-2  :SENSITIVE IN MENU m-exec =  false
     4804         MENU-ITEM m_gen-3  :SENSITIVE IN MENU m-exec =  false
     4805         MENU-ITEM m_gen-4  :SENSITIVE IN MENU m-exec =  false
