     3262                 .
     3263               end.
     3264             end.
     3265             run diasize_position-resize-button in this-procedure .
     3266           end.
     3267           assign
     3268             v-diasize-change-size = false
     3269           .
     3270           leave move_block .
     3271         end.
     3272       end.
     3273       assign
     3274         v-diasize-need-full-display = true
     3275       .
     3276       if v-diasize-change-size = false
     3277       then do:
     3278         assign
     3279           v-diasize-change-size = true
     3280         .
     3281       end.
     3282       else do:
     3283         return .
     3284       end.
     3285       assign
     3286         v-frame-width = frame Dialog-Frame :width
     3287         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3288         v-browse-width = v-diasize-browse-handle :width
     3289       .
     3290       for each buf_temp-browse-handle
     3291         where buf_temp-browse-handle.browse-type = 'width':u
     3292       :
     3293         assign
     3294           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3295         .
     3296       end.
     3297       for each buf_temp-diasize-handle
     3298       :
     3299         delete buf_temp-diasize-handle .
     3300       end.
     3301       assign
     3302         v-field-group-handle = frame Dialog-Frame :first-child
     3303       .
     3304       do while valid-handle(v-field-group-handle)
     3305       :
     3306         assign
     3307           v-object-handle = v-field-group-handle :first-child
     3308         .
     3309         do while valid-handle(v-object-handle)
     3310         :
     3311           if  v-object-handle <> v-diasize-browse-handle :handle
     3312           and v-object-handle <> v-diasize-resize-button
     3313           and can-query(v-object-handle, "row")
     3314           and can-query(v-object-handle, "height")
     3315           and ( v-object-handle :col + v-object-handle :width
     3316                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3317               )
     3318           then do:
     3319             find first buf_temp-browse-handle
     3320               where buf_temp-browse-handle.browse-type   = 'width':u
     3321                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3322               no-error .
     3323             if available buf_temp-browse-handle
     3324             then do:
     3325             end.
     3326             else do:
     3327               create buf_temp-diasize-handle .
     3328               assign
     3329                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3330                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3331               .
     3332             end.
     3333           end.
     3334           assign
     3335             v-object-handle = v-object-handle :next-sibling
     3336           .
     3337         end.
     3338         assign
     3339           v-field-group-handle = v-field-group-handle :next-sibling
     3340         .
     3341       end.
     3342       do with frame Dialog-Frame
     3343       :
     3344         hide v-diasize-resize-button .
     3345         v-diasize-resize-button :row = 1.
     3346         v-diasize-resize-button :column = 1.
     3347       end.
     3348       if p-change-value > 0
     3349       then do:
     3350         if frame Dialog-Frame :scrollable = true
     3351         then do:
     3352           assign
     3353             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3354             no-error .
     3355           if error-status :error
     3356           or error-status :get-message(1) <> ""
     3357           then do:
     3358             undo move_block, retry move_block.
     3359           end.
     3360         end.
     3361         assign
     3362           frame Dialog-Frame :width = v-frame-width + p-change-value
     3363           no-error .
     3364         if error-status :error
     3365         or error-status :get-message(1) <> ""
     3366         then do:
     3367           undo move_block, retry move_block.
     3368         end.
     3369         assign
     3370           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3371         no-error .
     3372         if error-status :error
     3373         or error-status :get-message(1) <> ""
     3374         then do:
     3375           undo move_block, retry move_block.
     3376         end.
     3377         for each buf_temp-browse-handle
     3378           where buf_temp-browse-handle.browse-type = 'width':u
     3379         on error undo move_block, retry move_block
     3380         :
     3381           assign
     3382             buf_temp-browse-handle.browse-handle :width
     3383               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3384             no-error .
     3385           if error-status :error
     3386           or error-status :get-message(1) <> ""
     3387           then do:
     3388             undo move_block, retry move_block .
     3389           end.
     3390         end.
     3391         for each buf_temp-diasize-handle
     3392         on error undo move_block, retry move_block
     3393         :
     3394           assign
     3395             v-object-handle = buf_temp-diasize-handle.handle-value
     3396           .
     3397           if v-object-handle <> v-diasize-resize-button
     3398           then do:
     3399             assign
     3400               v-object-handle :col = v-object-handle :col + p-change-value
     3401               no-error .
     3402             if error-status :error
     3403             or error-status :get-message(1) <> ""
     3404             then do:
     3405               undo move_block, retry move_block .
     3406             end.
     3407           end.
     3408         end.
     3409       end.
     3410       else do:
     3411         for each buf_temp-diasize-handle
     3412         on error undo move_block, retry move_block
     3413         :
     3414           assign
     3415             v-object-handle = buf_temp-diasize-handle.handle-value
     3416           .
     3417           if v-object-handle <> v-diasize-resize-button
     3418           then do:
     3419             assign
     3420               v-object-handle :col = v-object-handle :col + p-change-value
     3421               no-error .
     3422             if error-status :error
     3423             or error-status :get-message(1) <> ""
     3424             then do:
     3425               undo move_block, retry move_block .
     3426             end.
     3427           end.
     3428         end.
     3429         for each buf_temp-browse-handle
     3430           where buf_temp-browse-handle.browse-type = 'width':u
     3431         on error undo move_block, retry move_block
     3432         :
     3433           assign
     3434             buf_temp-browse-handle.browse-handle :width
     3435               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3436             no-error .
     3437           if error-status :error
     3438           or error-status :get-message(1) <> ""
     3439           then do:
     3440             undo move_block, retry move_block .
     3441           end.
     3442         end.
     3443         assign
     3444           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3445           no-error .
     3446         if error-status :error
     3447         or error-status :get-message(1) <> ""
     3448         then do:
     3449           undo move_block, retry move_block.
     3450         end.
     3451         assign
     3452           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3453         no-error .
     3454         if error-status :error
     3455         or error-status :get-message(1) <> ""
     3456         then do:
     3457           undo move_block, retry move_block.
     3458         end.
     3459         if frame Dialog-Frame :scrollable = true
     3460         then do:
     3461           assign
     3462             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3463           no-error .
     3464           if error-status :error
     3465           or error-status :get-message(1) <> ""
     3466           then do:
     3467             undo move_block, retry move_block.
     3468           end.
     3469         end.
     3470       end.
     3471       if p-move-resize
     3472       then do:
     3473         run diasize_position-resize-button in this-procedure .
     3474       end.
     3475       if v-diasize-wndstore = true
     3476       then do:
     3477         if connected("ub") = true
     3478         then do:
     3479           define variable v-cntxt-db-num        as integer   no-undo .
     3480           define variable v-cntxt-userid        as character no-undo .
     3481           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3482                                             , OUTPUT v-cntxt-userid
     3483                                             ) .
     3484           run gbl/wndsizew.p
     3485             (input  v-cntxt-db-num
     3486             ,input  v-cntxt-userid
     3487             ,input  v-diasize-proc-name
     3488             ,input  'width':u
     3489             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3490             ) .
     3491         end.
     3492       end.
     3493     end.
     3494     assign
     3495       v-diasize-change-size = false
     3496     .
     3497   end procedure.
     3498   procedure diasize_set-width :
     3499     define input  parameter p-new-width  as decimal   no-undo .
     3500     define input  parameter p-move-resize as logical   no-undo .
     3501     do
     3502     on error undo, return error return-value
     3503     :
     3504       run diasize_change-width in this-procedure
     3505         (input  (p-new-width - frame Dialog-Frame :width)
     3506         ,input  p-move-resize
     3507         ) .
     3508     end.
     3509   end procedure.
     3510   procedure diasize_position-resize-button :
     3511     do with frame Dialog-Frame
     3512     :
     3513       hide v-diasize-resize-button .
     3514       assign
     3515         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3516                     - 1
     3517                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3518         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3519                     - 1
     3520                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3521       .
     3522       view v-diasize-resize-button .
     3523     end.
     3524   end procedure.
     3525   on alt-right anywhere
     3526   do:
     3527     run diasize_change-width in this-procedure
     3528       (input 1
     3529       ,input true
     3530       ) .
     3531     return no-apply .
     3532   end.
     3533   on alt-left anywhere
     3534   do:
     3535     run diasize_change-width in this-procedure
     3536       (input -1
     3537       ,input true
     3538       ) .
     3539     return no-apply .
     3540   end.
     3541   on alt-down anywhere
     3542   do:
     3543     run diasize_change-height in this-procedure
     3544       (input 1
     3545       ,input true
     3546       ) .
     3547     return no-apply .
     3548   end.
     3549   on alt-up anywhere
     3550   do:
     3551     run diasize_change-height in this-procedure
     3552       (input -1
     3553       ,input true
     3554       ) .
     3555     return no-apply .
     3556   end.
     3557   on alt-enter of frame Dialog-Frame
     3558   do:
     3559     run diasize_maximize in this-procedure
     3560       (input  ?
     3561       ).
     3562     return no-apply .
     3563   end.
     3564   procedure diasize_end-move :
     3565     do
     3566     on error undo, return error return-value
     3567     :
     3568       define variable v-row-delta as decimal   no-undo .
     3569       define variable v-col-delta as decimal   no-undo .
     3570       define variable v-new-row as decimal   no-undo .
     3571       define variable v-new-col as decimal   no-undo .
     3572       assign
     3573         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3574         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3575       .
     3576       assign
     3577         v-row-delta = v-new-row - frame Dialog-Frame :height
     3578         v-col-delta = v-new-col - frame Dialog-Frame :width
     3579       .
     3580       run diasize_change-height in this-procedure
     3581         (input v-row-delta
     3582         ,input true
     3583         ) .
     3584       run diasize_change-width in this-procedure
     3585         (input v-col-delta
     3586         ,input true
     3587         ) .
     3588     end.
     3589   end procedure.
     3590   procedure diasize_maximize :
     3591     define input  parameter p-action as logical   no-undo .
     3592     do
     3593     on error undo, return error return-value
     3594     :
     3595       if p-action = ?
     3596       then do:
     3597         if v-diasize-need-maximize = true
     3598         then do:
     3599           assign
     3600             p-action = true
     3601           .
     3602         end.
     3603         else do:
     3604           assign
     3605             p-action = false
     3606           .
     3607         end.
     3608       end.
     3609       if p-action = true
     3610       then do:
     3611         run diasize_change-height in this-procedure
     3612           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3613               - frame Dialog-Frame :height-chars
     3614           ,input true
     3615           ) .
     3616         run diasize_change-width in this-procedure
     3617           (input session :width-chars
     3618               - frame Dialog-Frame :width-chars
     3619           ,input true
     3620           ) .
     3621         assign
     3622           v-diasize-need-maximize = false
     3623         .
     3624       end.
     3625       else do:
     3626         run diasize_change-width in this-procedure
     3627           (input v-diasize-orig-frame-width
     3628               - frame Dialog-Frame :width-chars
     3629           ,input true
     3630           ) .
     3631         run diasize_change-height in this-procedure
     3632           (input v-diasize-orig-frame-height
     3633               - frame Dialog-Frame :height-chars
     3634           ,input true
     3635           ) .
     3636         assign
     3637           v-diasize-need-maximize = true
     3638         .
     3639       end.
     3640     end.
     3641   end procedure.
     3642   procedure diasize_restore-orig-size :
     3643     do
     3644     on error undo, return error return-value
     3645     :
     3646       assign
     3647         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3648         v-diasize-current-frame-height = frame Dialog-Frame :height
     3649       .
     3650       run diasize_set-height in this-procedure
     3651         (input  v-diasize-orig-frame-height
     3652         ,input  true
     3653         ) .
     3654       run diasize_set-width in this-procedure
     3655         (input  v-diasize-orig-frame-width
     3656         ,input  true
     3657         ) .
     3658     end.
     3659   end procedure.
     3660   procedure diasize_restore-current-size :
     3661     do
     3662     on error undo, return error return-value
     3663     :
     3664       run diasize_set-height in this-procedure
     3665         (input  v-diasize-current-frame-height
     3666         ,input  true
     3667         ) .
     3668       run diasize_set-width in this-procedure
     3669         (input  v-diasize-current-frame-width
     3670         ,input  true
     3671         ) .
     3672     end.
     3673   end procedure.
     3674   procedure diasize_set-browse-handle :
     3675     define input  parameter p-browse-handle as handle   no-undo .
     3676     define buffer buf_temp-browse-handle for temp-browse-handle .
     3677     do
     3678     on error undo, return error return-value
     3679     :
     3680       assign
     3681         v-diasize-browse-handle = p-browse-handle
     3682       .
     3683       for each buf_temp-browse-handle
     3684       on error undo, return error return-value
     3685       :
     3686         delete buf_temp-browse-handle .
     3687       end.
     3688     end.
     3689   end procedure.
     3690   procedure diasize_add_browse :
     3691     define input  parameter p-browse-type   as character no-undo .
     3692     define input  parameter p-browse-handle as handle    no-undo .
     3693     define buffer buf_temp-browse-handle for temp-browse-handle .
     3694     do
     3695     on error undo, return error return-value
     3696     :
     3697       assign
     3698         v-diasize-browse-number = v-diasize-browse-number + 1
     3699       .
     3700       create buf_temp-browse-handle .
     3701       assign
     3702         buf_temp-browse-handle.browse-type   = p-browse-type
     3703         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3704         buf_temp-browse-handle.browse-handle = p-browse-handle
     3705       .
     3706     end.
     3707   end procedure.
     3708   procedure diasize_init :
     3709     define variable v-default-value    as logical   no-undo .
     3710     define variable v-restore-saved    as logical   no-undo .
     3711     define variable v-resize-value-str as character no-undo .
     3712     do
     3713     on error undo, return error return-value
     3714     :
     3715       do with frame Dialog-Frame
     3716       :
     3717         assign
     3718           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3719           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3720           v-diasize-browse-handle     = browse br-docs :handle
     3721         .
     3722         create button v-diasize-resize-button
     3723         assign
     3724           parent        = frame Dialog-Frame :first-child
     3725           label         = "s"
     3726           height-pixels = 16
     3727           width-pixels  = 16
     3728           visible       = true
     3729           sensitive     = true
     3730           movable       = true
     3731           triggers:
     3732             on end-move persistent run diasize_end-move in this-procedure .
     3733           end triggers.
     3734         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3735         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3736         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3737         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3738         assign
     3739           v-diasize-wndmax = false
     3740         .
     3741         if connected("ub") = true
     3742         then do:
     3743           define variable v-cntxt-db-num        as integer   no-undo .
     3744           define variable v-cntxt-userid        as character no-undo .
     3745           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3746                                             , OUTPUT v-cntxt-userid
     3747                                             ) .
     3748           run gbl/wndpar_r.p
     3749             (input  v-cntxt-db-num
     3750             ,input  v-cntxt-userid
     3751             ,input  'wndmax':U
     3752             ,output v-diasize-wndmax
     3753             ,output v-default-value
     3754             ) .
     3755         end.
     3756         assign
     3757           v-diasize-wndstore = false
     3758         .
     3759         if connected("ub") = true
     3760         then do:
     3761           run gbl/wndpar_r.p
     3762             (input  v-cntxt-db-num
     3763             ,input  v-cntxt-userid
     3764             ,input  'wndstore':U
     3765             ,output v-diasize-wndstore
     3766             ,output v-default-value
     3767             ) .
     3768         end.
     3769         assign
     3770           v-diasize-proc-name = entry(1, program-name(2), '.')
     3771         .
     3772         if v-diasize-wndstore = true
     3773         then do:
     3774           assign
     3775             v-restore-saved = false
     3776           .
     3777           if connected("ub") = true
     3778           then do:
     3779             run gbl/wndsizer.p
     3780               (input  v-cntxt-db-num
     3781               ,input  v-cntxt-userid
     3782               ,input  v-diasize-proc-name
     3783               ,input  'height':u
     3784               ,output v-resize-value-str
     3785               ) .
     3786             if v-resize-value-str <> '':U
     3787             then do:
     3788               run diasize_change-height in this-procedure
     3789                 (input  integer(v-resize-value-str)
     3790                 ,input  true
     3791                 ) .
     3792               assign
     3793                 v-restore-saved = true
     3794               .
     3795             end.
     3796           end.
     3797           if connected("ub") = true
     3798           then do:
     3799             run gbl/wndsizer.p
     3800               (input  v-cntxt-db-num
     3801               ,input  v-cntxt-userid
     3802               ,input  v-diasize-proc-name
     3803               ,input  'width':u
     3804               ,output v-resize-value-str
     3805               ) .
     3806             if v-resize-value-str <> '':U
     3807             then do:
     3808               run diasize_change-width in this-procedure
     3809                 (input  integer(v-resize-value-str)
     3810                 ,input  true
     3811                 ) .
     3812               assign
     3813                 v-restore-saved = true
     3814               .
     3815             end.
     3816           end.
     3817           if v-restore-saved <> true
     3818           then do:
     3819             if v-diasize-wndmax = true
     3820             then do:
     3821               run diasize_maximize in this-procedure
     3822                 (input  true
     3823                 ) .
     3824             end.
     3825           end.
     3826         end.
     3827         else do:
     3828           if v-diasize-wndmax = true
     3829           then do:
     3830             run diasize_maximize in this-procedure
     3831               (input  true
     3832               ) .
     3833           end.
     3834         end.
     3835       end.
     3836     end.
     3837   end procedure.
     3838   procedure diasize_need-full-display :
     3839     define output parameter p-need-full-display as logical   no-undo .
     3840     do
     3841     on error undo, return error return-value
     3842     :
     3843       assign
     3844         p-need-full-display = v-diasize-need-full-display
     3845       .
     3846       assign
     3847         v-diasize-need-full-display = false
     3848       .
     3849     end.
     3850   end procedure.
     3851   procedure get-context :
     3852      define output parameter p-db-num as integer          no-undo.
     3853      define output parameter p-user-id as character        no-undo.
     3854      define variable v-login               as character    no-undo.
     3855      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3856      define buffer buf_user-login  for ub.user-login .
     3857      do
     3858      on error undo, return error
     3859      :
     3860            FIND FIRST buf_sys-ctrl no-lock.
     3861            ASSIGN
     3862               v-login = USERID("ub")
     3863               p-db-num = buf_sys-ctrl.db-num
     3864            .
     3865            FIND FIRST buf_user-login
     3866                 WHERE buf_user-login.db-num = p-db-num
     3867                   AND buf_user-login.user-login = v-login
     3868                 no-lock
     3869                 no-error
     3870                 .
     3871            IF AVAILABLE buf_user-login
     3872            THEN DO:
     3873               assign
     3874                  p-user-id = buf_user-login.user-id
     3875               .
     3876            END.
     3877      end.
     3878   end procedure.
     3879       run diasize_init in this-procedure .
     3880   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3881   on ' ' of sch-date in frame Dialog-Frame
     3882   do:
     3883     if (can-query (self, "sensitive")
     3884        and
     3885        self :sensitive = true
     3886        )
     3887     or (can-query (self, "read-only")
     3888        and
     3889        self :read-only = false
     3890        )
     3891     then do:
     3892       assign
     3893         self :screen-value = ?
     3894       .
     3895     end.
     3896     return no-apply.
     3897   end.
