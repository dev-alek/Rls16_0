     2598   DO:
     2599   END.
     2600   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2601   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2602   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2603   on help of frame Dialog-Frame
     2604   do:
     2605     run gbl/app_help.p
     2606       (input this-procedure :file-name
     2607       ,input ''
     2608       ,input ?
     2609       ) no-error.
     2610     if error-status :error then do:
     2611       message
     2612         "Ошибка при вызове помощи"
     2613         error-status :get-message(1)
     2614         view-as alert-box .
     2615     end.
     2616   end.
     2617   run minbtn-set in this-procedure .
     2618   on choose of b-help in frame Dialog-Frame
     2619   do:
     2620     apply "help":u to frame Dialog-Frame .
     2621   end.
     2622   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2623   procedure minbtn-set :
     2624       do
     2625           on error undo, return error return-value
     2626           :
     2627           define variable ii              as integer       no-undo .
     2628           define variable fh              as widget-handle no-undo .
     2629           define variable hh              as widget-handle no-undo .
     2630           define variable v-h             as handle        extent 4 no-undo .
     2631           define variable v-name-button   as character     no-undo .
     2632           define variable v-help-old-x    as decimal       no-undo .
     2633           define variable v-help-old-y    as decimal       no-undo .
     2634           define variable v-help-old-size as decimal       no-undo .
     2635           define variable v-frame-width   as decimal       no-undo .
     2636           define variable jj              as integer       no-undo .
     2637           do
     2638               on error undo, return error
     2639               :
     2640               assign
     2641                   v-frame-width = frame Dialog-Frame:width - 0.3
     2642                   fh            = frame Dialog-Frame:first-child
     2643                   hh            = fh:first-child
     2644                   ii            = 1
     2645                   .
     2646               do while valid-handle(hh):
     2647                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2648                   do:
     2649                       case lc(hh:name) :
     2650                           when "b-help" then
     2651                               do:
     2652                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2653                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2654                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2655                                   hh:TOOLTIP = "Помощь" .
     2656                                   v-help-old-x = hh:column .
     2657                                   v-help-old-y = hh:row    .
     2658                                   v-help-old-size = hh:width .
     2659                                   hh:width-chars = 2.5 .
     2660                               end.
     2661                           when "b-print" then
     2662                               do:
     2663                                   hh:load-image("cmp/b-print.bmp":u) .
     2664                                   hh:TOOLTIP = "Печать" .
     2665                                   v-h[ii] = hh:handle .
     2666                                   ii = ii + 1 .
     2667                                   hh:width-chars = 3 .
     2668                               end.
     2669                           when "b-history" or
     2670                           when "b-hist" then
     2671                               do:
     2672                                   hh:load-image("cmp/b-hist.bmp":u) .
     2673                                   hh:TOOLTIP = "История" .
     2674                                   v-h[ii] = hh:handle .
     2675                                   ii = ii + 1 .
     2676                                   hh:width-chars = 3 .
     2677                               end.
     2678                           when "b-sch" then
     2679                               do:
     2680                                   hh:load-image("cmp/b-sch.bmp":u) .
     2681                                   hh:TOOLTIP = "Установка Фильтра" .
     2682                                   v-h[ii] = hh:handle .
     2683                                   ii = ii + 1 .
     2684                                   hh:width-chars = 3 .
     2685                               end.
     2686                           when "b-hist-user" then
     2687                               do:
     2688                                   hh:load-image("cmp/b-hist.bmp":u) .
     2689                                   hh:TOOLTIP = "История пользователя" .
     2690                                   ii = ii + 1 .
     2691                               end.
     2692                       end case.
     2693                   end.
     2694                   hh = hh:next-sibling.
     2695               end.
     2696               b-help:column = v-frame-width - b-help:width-chars.
     2697               jj = 0.
     2698               repeat ii = 4 to 1 by -1 :
     2699                   if valid-handle (v-h[ii] ) then
     2700                   do:
     2701                       jj  = jj + 1 .
     2702                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2703                       v-h[ii]:row    = v-help-old-y .
     2704                   end.
     2705               end.
     2706           end.
     2707       end.
     2708   end procedure.
     2709   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2710   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2711   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2712   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2713   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2714   define variable v-diasize-current-frame-height as decimal   no-undo .
     2715   define variable v-diasize-change-size          as logical   no-undo .
     2716   define variable v-diasize-resize-button        as handle    no-undo .
     2717   define variable v-diasize-wndmax               as logical   no-undo .
     2718   define variable v-diasize-wndstore             as logical   no-undo .
     2719   define variable v-diasize-proc-name            as character no-undo .
     2720   define variable v-diasize-browse-handle        as handle    no-undo .
     2721   define variable v-diasize-browse-number        as integer   no-undo .
     2722   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2723   define temp-table temp-diasize-handle no-undo
     2724     field handle-value  as handle
     2725     field save-position as decimal
     2726     index xpk is primary unique handle-value
     2727     .
     2728   define temp-table temp-browse-handle no-undo
     2729     field browse-type   as character
     2730     field browse-number as integer
     2731     field browse-handle as handle
     2732     field original-size as decimal
     2733     index xpk is primary unique browse-type browse-number
     2734     index xie browse-type browse-handle
     2735   .
     2736   procedure diasize_change-height :
     2737     define input  parameter p-change-value  as decimal   no-undo .
     2738     define input  parameter p-move-resize   as logical   no-undo .
     2739     define variable v-field-group-handle    as handle    no-undo .
     2740     define variable v-object-handle         as handle    no-undo .
     2741     define variable v-frame-height          as decimal   no-undo .
     2742     define variable v-frame-virtual-height  as decimal   no-undo .
     2743     define variable v-browse-height         as decimal   no-undo .
     2744     define variable v-window-height         as decimal   no-undo .
     2745     define variable v-window-virtual-height as decimal   no-undo .
     2746     define variable v-change-sign           as integer   no-undo .
     2747     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2748     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2749     if p-change-value > 0
     2750     then do:
     2751       if frame Dialog-Frame :height + p-change-value
     2752           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2753       then do:
     2754         assign
     2755           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2756                           - (frame Dialog-Frame :height-chars)
     2757         .
     2758         if p-change-value <= 0
     2759         then do:
     2760           run diasize_position-resize-button in this-procedure .
     2761           return .
     2762         end.
     2763       end.
     2764     end.
     2765     if p-change-value < 0
     2766     then do:
     2767       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2768       then do:
     2769         assign
     2770           p-change-value = v-diasize-orig-frame-height
     2771                          - (frame Dialog-Frame :height-chars)
     2772         .
     2773         if p-change-value >= 0
     2774         then do:
     2775           run diasize_position-resize-button in this-procedure .
     2776           return .
     2777         end.
     2778       end.
     2779     end.
     2780     if p-change-value >= 0
     2781     then do:
     2782       assign
     2783         v-change-sign = 1
     2784       .
     2785     end.
     2786     else do:
     2787       assign
     2788         v-change-sign = -1
     2789       .
     2790     end.
     2791     assign
     2792       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2793     .
     2794     if p-change-value = 0
     2795     then do:
     2796       run diasize_position-resize-button in this-procedure .
     2797       return .
     2798     end.
     2799     move_block:
     2800     do
     2801     on error undo move_block, retry move_block
     2802     :
     2803       if retry
     2804       then do:
     2805         do
     2806         on error undo move_block, leave move_block
     2807         :
     2808           if p-change-value > 0
     2809           then do:
     2810             for each buf_temp-diasize-handle
     2811             on error undo, next
     2812             :
     2813               assign
     2814                 v-object-handle = buf_temp-diasize-handle.handle-value
     2815               .
     2816               if v-object-handle <> v-diasize-resize-button
     2817               then do:
     2818                 assign
     2819                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2820                 .
     2821               end.
     2822             end.
     2823             assign
     2824               v-diasize-browse-handle :height = v-browse-height
     2825             .
     2826             for each buf_temp-browse-handle
     2827               where buf_temp-browse-handle.browse-type = 'height':u
     2828             on error undo, next
     2829             :
     2830               assign
     2831                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2832               .
     2833             end.
     2834             assign
     2835               frame Dialog-Frame :height = v-frame-height
     2836             .
     2837             if frame Dialog-Frame :scrollable = true
     2838             then do:
     2839               assign
     2840                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2841               .
     2842             end.
     2843             run diasize_position-resize-button in this-procedure .
     2844           end.
     2845           else do:
     2846             if frame Dialog-Frame :scrollable = true
     2847             then do:
     2848               assign
     2849                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2850               .
     2851             end.
     2852             assign
     2853               frame Dialog-Frame :height = v-frame-height
     2854             .
     2855             assign
     2856               v-diasize-browse-handle :height = v-browse-height
     2857             .
     2858             for each buf_temp-browse-handle
     2859               where buf_temp-browse-handle.browse-type = 'height':u
     2860             on error undo, next
     2861             :
     2862               assign
     2863                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2864               .
     2865             end.
     2866             for each buf_temp-diasize-handle
     2867             on error undo, next
     2868             :
     2869               assign
     2870                 v-object-handle = buf_temp-diasize-handle.handle-value
     2871               .
     2872               if v-object-handle <> v-diasize-resize-button
     2873               then do:
     2874                 assign
     2875                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2876                 .
     2877               end.
     2878             end.
     2879             run diasize_position-resize-button in this-procedure .
     2880           end.
     2881           assign
     2882             v-diasize-change-size = false
     2883           .
     2884           leave move_block .
     2885         end.
     2886       end.
     2887       assign
     2888         v-diasize-need-full-display = true
     2889       .
     2890       if v-diasize-change-size = false
     2891       then do:
     2892         assign
     2893           v-diasize-change-size = true
     2894         .
     2895       end.
     2896       else do:
     2897         return .
     2898       end.
     2899       assign
     2900         v-frame-height = frame Dialog-Frame :height
     2901         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2902         v-browse-height = v-diasize-browse-handle :height
     2903       .
     2904       for each buf_temp-browse-handle
     2905         where buf_temp-browse-handle.browse-type = 'height':u
     2906       :
     2907         assign
     2908           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2909         .
     2910       end.
     2911       for each buf_temp-diasize-handle
     2912       :
     2913         delete buf_temp-diasize-handle .
     2914       end.
     2915       assign
     2916         v-field-group-handle = frame Dialog-Frame :first-child
     2917       .
     2918       do while valid-handle(v-field-group-handle)
     2919       :
     2920         assign
     2921           v-object-handle = v-field-group-handle :first-child
     2922         .
     2923         do while valid-handle(v-object-handle)
     2924         :
     2925           if  v-object-handle <> v-diasize-browse-handle :handle
     2926           and can-query(v-object-handle, "row")
     2927           and can-query(v-object-handle, "height")
     2928           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2929           then do:
     2930             find first buf_temp-browse-handle
     2931               where buf_temp-browse-handle.browse-type   = 'height':u
     2932                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2933               no-error .
     2934             if available buf_temp-browse-handle
     2935             then do:
     2936             end.
     2937             else do:
     2938               create buf_temp-diasize-handle .
     2939               assign
     2940                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2941                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2942               .
     2943             end.
     2944           end.
     2945           assign
     2946             v-object-handle = v-object-handle :next-sibling
     2947           .
     2948         end.
     2949         assign
     2950           v-field-group-handle = v-field-group-handle :next-sibling
     2951         .
     2952       end.
     2953       do with frame Dialog-Frame
     2954       :
     2955         hide v-diasize-resize-button .
     2956         assign
     2957           v-diasize-resize-button :row    = 1
     2958           v-diasize-resize-button :column = 1
     2959         .
     2960       end.
     2961       if p-change-value > 0
     2962       then do:
     2963         if frame Dialog-Frame :scrollable = true
     2964         then do:
     2965           assign
     2966             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2967             no-error .
     2968           if error-status :error
     2969           or error-status :get-message(1) <> ""
     2970           then do:
     2971             undo move_block, retry move_block .
     2972           end.
     2973         end.
     2974         assign
     2975           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2976           no-error .
     2977         if error-status :error
     2978         or error-status :get-message(1) <> ""
     2979         then do:
     2980           undo move_block, retry move_block .
     2981         end.
     2982         assign
     2983           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2984           no-error .
     2985         if error-status :error
     2986         or error-status :get-message(1) <> ""
     2987         then do:
     2988           undo move_block, retry move_block .
     2989         end.
     2990         for each buf_temp-browse-handle
     2991           where buf_temp-browse-handle.browse-type = 'height':u
     2992         on error undo move_block, retry move_block
     2993         :
     2994           assign
     2995             buf_temp-browse-handle.browse-handle :height
     2996               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2997             no-error .
     2998           if error-status :error
     2999           or error-status :get-message(1) <> ""
     3000           then do:
     3001             undo move_block, retry move_block .
     3002           end.
     3003         end.
     3004         for each buf_temp-diasize-handle
     3005         on error undo move_block, retry move_block
     3006         :
     3007           assign
     3008             v-object-handle = buf_temp-diasize-handle.handle-value
     3009           .
     3010           if v-object-handle <> v-diasize-resize-button
     3011           then do:
     3012             assign
     3013               v-object-handle :row = v-object-handle :row + p-change-value
     3014               no-error .
     3015             if error-status :error
     3016             or error-status :get-message(1) <> ""
     3017             then do:
     3018               undo move_block, retry move_block .
     3019             end.
     3020           end.
     3021         end.
     3022       end.
     3023       else do:
     3024         for each buf_temp-diasize-handle
     3025         on error undo move_block, retry move_block
     3026         :
     3027           assign
     3028             v-object-handle = buf_temp-diasize-handle.handle-value
     3029           .
     3030           if v-object-handle <> v-diasize-resize-button
     3031           then do:
     3032             assign
     3033               v-object-handle :row = v-object-handle :row + p-change-value
     3034               no-error .
     3035             if error-status :error
     3036             or error-status :get-message(1) <> ""
     3037             then do:
     3038               undo move_block, retry move_block .
     3039             end.
     3040           end.
     3041         end.
     3042         assign
     3043           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3044           no-error .
     3045         if error-status :error
     3046         or error-status :get-message(1) <> ""
     3047         then do:
     3048           undo move_block, retry move_block .
     3049         end.
     3050         for each buf_temp-browse-handle
     3051           where buf_temp-browse-handle.browse-type = 'height':u
     3052         on error undo move_block, retry move_block
     3053         :
     3054           assign
     3055             buf_temp-browse-handle.browse-handle :height
     3056               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3057             no-error .
     3058           if error-status :error
     3059           or error-status :get-message(1) <> ""
     3060           then do:
     3061             undo move_block, retry move_block .
     3062           end.
     3063         end.
     3064         assign
     3065           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3066           no-error .
     3067         if error-status :error
     3068         or error-status :get-message(1) <> ""
     3069         then do:
     3070           undo move_block, retry move_block .
     3071         end.
     3072         if frame Dialog-Frame :scrollable = true
     3073         then do:
     3074           assign
     3075             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3076             no-error .
     3077           if error-status :error
     3078           or error-status :get-message(1) <> ""
     3079           then do:
     3080             undo move_block, retry move_block .
     3081           end.
     3082         end.
     3083       end.
     3084       if p-move-resize = true
     3085       then do:
     3086         run diasize_position-resize-button in this-procedure .
     3087       end.
     3088       if v-diasize-wndstore = true
     3089       then do:
     3090         if connected("ub") = true
     3091         then do:
     3092           define variable v-cntxt-db-num        as integer   no-undo .
     3093           define variable v-cntxt-userid        as character no-undo .
     3094           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3095                                             , OUTPUT v-cntxt-userid
     3096                                             ) .
     3097           run gbl/wndsizew.p
     3098             (input  v-cntxt-db-num
     3099             ,input  v-cntxt-userid
     3100             ,input  v-diasize-proc-name
     3101             ,input  'height':u
     3102             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3103             ) .
     3104         end.
     3105       end.
     3106     end.
     3107     assign
     3108       v-diasize-change-size = false
     3109     .
     3110   end procedure.
     3111   procedure diasize_set-height :
     3112     define input  parameter p-new-height  as decimal   no-undo .
     3113     define input  parameter p-move-resize as logical   no-undo .
     3114     do
     3115     on error undo, return error return-value
     3116     :
     3117       run diasize_change-height in this-procedure
     3118         (input  (p-new-height - frame Dialog-Frame :height)
     3119         ,input  p-move-resize
     3120         ) .
     3121     end.
     3122   end procedure.
     3123   procedure diasize_change-width :
     3124     define input  parameter p-change-value as decimal   no-undo .
     3125     define input  parameter p-move-resize  as logical   no-undo .
     3126     define variable v-field-group-handle   as handle    no-undo .
     3127     define variable v-object-handle        as handle    no-undo .
     3128     define variable v-frame-width          as decimal   no-undo .
     3129     define variable v-frame-virtual-width  as decimal   no-undo .
     3130     define variable v-browse-width         as decimal   no-undo .
     3131     define variable v-window-width         as decimal   no-undo .
     3132     define variable v-window-virtual-width as decimal   no-undo .
     3133     define variable v-change-sign          as integer   no-undo .
     3134     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3135     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3136     if p-change-value > 0
     3137     then do:
     3138       if frame Dialog-Frame :width + p-change-value >
     3139           session :width-chars
     3140       then do:
     3141         assign
     3142           p-change-value = session :width-chars - frame Dialog-Frame :width
     3143         .
     3144         if p-change-value <= 0
     3145         then do:
     3146           run diasize_position-resize-button in this-procedure .
     3147           return .
     3148         end.
     3149       end.
     3150     end.
     3151     if p-change-value < 0
     3152     then do:
     3153       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3154       then do:
     3155         assign
     3156           p-change-value = v-diasize-orig-frame-width
     3157                          - frame Dialog-Frame :width
     3158         .
     3159         if p-change-value >= 0
     3160         then do:
     3161           run diasize_position-resize-button in this-procedure .
     3162           return .
     3163         end.
     3164       end.
     3165     end.
     3166     if p-change-value >= 0
     3167     then do:
     3168       assign
     3169         v-change-sign = 1
     3170       .
     3171     end.
     3172     else do:
     3173       assign
     3174         v-change-sign = -1
     3175       .
     3176     end.
     3177     assign
     3178       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3179     .
     3180     if p-change-value = 0
     3181     then do:
     3182       run diasize_position-resize-button in this-procedure .
     3183       return .
     3184     end.
     3185     move_block:
     3186     do
     3187     on error undo move_block, leave move_block
     3188     :
     3189       if retry
     3190       then do:
     3191         do
     3192         on error undo move_block, leave move_block
     3193         :
     3194           if p-change-value > 0
     3195           then do:
     3196             for each buf_temp-diasize-handle
     3197             on error undo, next
     3198             :
     3199               assign
     3200                 v-object-handle = buf_temp-diasize-handle.handle-value
     3201               .
     3202               if v-object-handle <> v-diasize-resize-button
     3203               then do:
     3204                 assign
     3205                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3206                 .
     3207               end.
     3208             end.
     3209             assign
     3210               v-diasize-browse-handle :width = v-browse-width
     3211             .
     3212             for each buf_temp-browse-handle
     3213               where buf_temp-browse-handle.browse-type = 'width':u
     3214             on error undo, next
     3215             :
     3216               assign
     3217                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3218               .
     3219             end.
     3220             assign
     3221               frame Dialog-Frame :width = v-frame-width
     3222             .
     3223             if frame Dialog-Frame :scrollable = true
     3224             then do:
     3225               assign
     3226                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3227               .
     3228             end.
