     2079   IF (buf_ord-doc.status_ = 'факт':U or buf_ord-doc.status_ = 'закрыто':U)  THEN (buf_ord-doc.status_ + string(buf_ord-doc.flag_,"+/-"))  ELSE (buf_ord-doc.status_)
     2080         COLUMN-LABEL "Статус"  FORMAT "x(8)"  LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
     2081   status-edoc-edi-light (buffer buf_ord-doc, input is-edoc-nn, input is-edi, output v-color) @ v-status-edi COLUMN-LABEL "Статус EDI" FORMAT "x(12)" LABEL-FGCOLOR 15 LABEL-BGCOLOR 3
