     2511         else r-cli-name = "" .
     2512     display r-cli-name with frame Dialog-Frame .
     2513   END.
     2514   ON MOUSE-SELECT-DBLCLICK OF sch-code IN FRAME Dialog-Frame
     2515   OR  RETURN OF sch-code IN FRAME Dialog-Frame
     2516   DO:
     2517     if sch-code <> input frame Dialog-Frame sch-code or sch-field <> "doc-code" then do:
     2518         sch-num = 0.
     2519         hide sch-num in frame Dialog-Frame.
     2520     end.
     2521     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
     2522    sch-field = "doc-code".
     2523    assign sch-code = input frame Dialog-Frame sch-code.
     2524    find first buf_ord-doc-rcv no-lock  where
     2525               buf_ord-doc-rcv.doc-code  begins sch-code
     2526           and buf_ord-doc-rcv.obj-code = v-cntxt-obj-code
     2527           and buf_ord-doc-rcv.obj-type = v-cntxt-obj-type
     2528           and buf_ord-doc-rcv.host-code = p-host-code
     2529           and ( p-g#type = ? or  ( buf_ord-doc-rcv.doc-type = p-g#type))
     2530           no-error .
     2531           if available buf_ord-doc-rcv then doc-rec = recid (buf_ord-doc-rcv) .
     2532                                        else doc-rec = ? .
     2533     if doc-rec = ? then message "Документ не найден !"  .
     2534     else do:
     2535         reposition br-docs to recid doc-rec no-error.
     2536         apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     2537     end.
     2538   return no-apply.
     2539   END.
     2540   ON MOUSE-SELECT-DBLCLICK OF sch-date IN FRAME Dialog-Frame
     2541   OR  RETURN OF sch-date IN FRAME Dialog-Frame
     2542   DO:
     2543     if sch-date <> input frame Dialog-Frame sch-date or sch-field <> "doc-date" then do:
     2544     sch-num = 0.
     2545     hide sch-num in frame Dialog-Frame.
     2546   end.
     2547    sch-field = "doc-date".
     2548    assign sch-date = input frame Dialog-Frame sch-date.
     2549    find first ub.ord-doc-rcv no-lock  where ub.ord-doc-rcv.doc-date  = sch-date no-error .
     2550           if available ub.ord-doc-rcv then doc-rec = recid(ub.ord-doc-rcv) .
     2551               else doc-rec = ? .
     2552     if doc-rec = ? then message "Документ не найден !"  .
     2553     else do:
     2554         reposition br-docs to recid doc-rec no-error.
