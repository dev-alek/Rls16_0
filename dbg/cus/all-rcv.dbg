     2087         COLUMN-LABEL "Статус"  FORMAT "x(8)"  LABEL-FGCOLOR 15 LABEL-BGCOLOR 1
     2088         buf_trn-doc.fact-qnty COLUMN-LABEL "Количество" LABEL-FGCOLOR 15 LABEL-BGCOLOR 1
     2089         buf_trn-doc.fact-rubl COLUMN-LABEL "Сумма РУБ" LABEL-FGCOLOR 15 LABEL-BGCOLOR 1
     2090         buf_trn-doc.doc-date COLUMN-LABEL "Дата док" LABEL-FGCOLOR 15 LABEL-BGCOLOR 1
     2091         buf_trn-doc.fact-date COLUMN-LABEL "Дата факт" LABEL-FGCOLOR 15 LABEL-BGCOLOR 1
