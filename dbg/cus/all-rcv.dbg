     1612   procedure prn-lib-reportviewer :
     1613     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1614     define input parameter p-report-name-html as character no-undo .
     1615     define input parameter p-param        as character no-undo .
     1616     define variable v-excel           as character no-undo init 'TRUE' .
     1617     define variable v-value-character as character no-undo .
     1618     define variable v-value-integer   as character no-undo .
     1619     define variable v-value-date      as date      no-undo .
     1620     define variable v-value-decimal   as decimal   no-undo .
     1621     define variable rep-excel         as logical   no-undo .
     1622     define variable excel-string      as character no-undo .
     1623     define variable v-param-type      as character no-undo .
     1624     define variable v-tth             as handle    no-undo .
     1625     run adm/shattri.p (
     1626       input "get":U
     1627       ,input  ""
     1628       ,input  0
     1629       ,input  'report-glob':U
     1630       ,input  'rep-excel':U
     1631       ,output v-value-character
     1632       ,output v-value-date
     1633       ,output v-value-decimal
     1634       ,output v-value-integer
     1635       ,output rep-excel
     1636       ,output v-param-type
     1637       ,INPUT-OUTPUT table-handle v-tth
     1638       )  .
     1639     if rep-excel then v-excel = "TRUE" .
     1640     else v-excel = "FALSE" .
     1641     if p-param eq ""
     1642     then
     1643        p-param = "EXCEL:" + v-excel.
     1644     else
     1645        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1646     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1647   end procedure.
     1648   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1649   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1650   procedure fltopend_fltopend :
     1651   define input parameter p-parent-handle as handle no-undo .
     1652   define input parameter p-qh as handle no-undo .
     1653   define input parameter p-flt-open-open-query  as character no-undo .
     1654   define input parameter p-where-cond as character no-undo .
     1655   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1656   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1657   define input parameter p-indexed-reposition as character no-undo .
     1658     do
     1659     on error undo, return error
     1660     :
     1661   define variable v-prepare-string as character no-undo .
     1662   define variable glog as logical no-undo .
     1663   assign
     1664   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1665                      p-where-cond + chr(32)  +
     1666                      p-use-indFIRST-query-tail + chr(32) +
     1667                      p-use-ind-sort-clmn-by + chr(32) +
     1668                      p-indexed-reposition
     1669   .
     1670   assign
     1671   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1672   if not glog
     1673   or error-status:error then do:
     1674     message error-status:get-message(1) view-as alert-box .
     1675     undo, return error .
     1676   end.
     1677   assign
     1678   glog = p-qh:query-open no-error .
     1679   if not glog
     1680   or error-status:error then do:
     1681     message error-status:get-message(1) view-as alert-box .
     1682     undo, return error .
     1683   end.
     1684     end.
     1685   end procedure.
     1686   procedure fltopend_fltfindd :
     1687   define input parameter p-parent-handle as handle no-undo .
     1688   define input parameter p-qh as handle no-undo .
     1689   define input parameter p-rowid as rowid no-undo .
     1690   define input parameter p-next as logical no-undo .
     1691   define input parameter p-lock as integer no-undo .
     1692   define input parameter p-bh as handle no-undo .
     1693   define input parameter p-where-cond as character no-undo .
     1694   define input parameter p-use-index-phrase as character no-undo .
     1695   define variable glog as logical no-undo .
     1696   define variable v-qh as handle no-undo .
     1697   define variable v-bh as handle no-undo .
     1698   define variable v-recid as recid no-undo .
     1699   define variable v-prepare-string as character no-undo .
     1700   do
     1701   on error undo, return error
     1702   on stop undo, return error
     1703   :
     1704     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1705     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1706     create query v-qh.
     1707     v-qh:set-buffers(v-bh).
     1708     v-prepare-string = substitute("for each &1 &2 &3"
     1709                                     ,v-bh:name
     1710                                     ,p-where-cond
     1711                                     ,p-use-index-phrase).
     1712     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1713     if not glog then do:
     1714       delete object v-qh.
     1715       delete object v-bh.
     1716       undo, return error .
     1717     end.
     1718     glog = v-qh:query-open no-error .
     1719     if not glog then do:
     1720       delete object v-qh.
     1721       delete object v-bh.
     1722       undo, return error .
     1723     end.
     1724     if p-next then do:
     1725       v-qh:reposition-to-rowid(p-rowid) no-error .
     1726       glog = v-qh:get-next( p-lock) no-error .
     1727       glog = v-qh:get-next( p-lock) no-error .
     1728       if not glog or v-qh:query-off-end = yes then do:
     1729         glog = v-qh:get-first( p-lock) no-error .
     1730       end.
     1731     end.
     1732     else do:
     1733       glog = v-qh:get-first( p-lock) no-error .
     1734     end.
     1735     v-recid = v-bh:recid no-error .
     1736     delete object v-qh.
     1737     delete object v-bh.
     1738     return string(v-recid) .
     1739   end.
     1740   end procedure.
     1741   procedure fltopend_fltfindq :
     1742   define input parameter p-parent-handle as handle no-undo .
     1743   define input parameter p-qh as handle no-undo .
     1744   define input parameter p-next as logical no-undo .
     1745   define input parameter p-lock as integer no-undo .
     1746   define input parameter p-flt-open-open-query  as character no-undo .
     1747   define input parameter p-where-cond as character no-undo .
     1748   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1749   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1750   define input parameter p-indexed-reposition as character no-undo .
     1751   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1752   define variable glog as logical no-undo .
     1753   define variable v-qh as handle no-undo .
     1754   define variable v-bh as handle no-undo extent 18.
     1755   define variable v-rowid as rowid no-undo extent 18.
     1756   define variable v-ii as integer no-undo .
     1757   define variable v-prepare-string as character no-undo .
     1758   do
     1759   on error undo, return error
     1760   on stop undo, return error
     1761   :
     1762     create query v-qh.
     1763     do v-ii = 1 to p-qh:num-buffers:
     1764       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1765       assign
     1766       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1767       no-error.
     1768       v-qh:add-buffer(v-bh[v-ii]).
     1769     end.
     1770     assign
     1771     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1772                       p-where-cond + chr(32)  +
     1773                       p-use-indFIRST-query-tail + chr(32) +
     1774                       p-use-ind-sort-clmn-by + chr(32) +
     1775                       p-indexed-reposition
     1776     .
     1777     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1778     if not glog then do:
     1779       delete object v-qh.
     1780       do v-ii = 1 to p-qh:num-buffers:
     1781         delete object v-bh[v-ii].
     1782       end.
     1783       undo, return error .
     1784     end.
     1785     glog = v-qh:query-open no-error .
     1786     if not glog then do:
     1787       delete object v-qh.
     1788       do v-ii = 1 to p-qh:num-buffers:
     1789         delete object v-bh[v-ii].
     1790       end.
     1791       undo, return error .
     1792     end.
     1793     if p-next then do:
     1794       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1795       glog = v-qh:get-next( p-lock) no-error .
     1796       glog = v-qh:get-next( p-lock) no-error .
     1797       if not glog or v-qh:query-off-end = yes then do:
     1798         glog = v-qh:get-first( p-lock) no-error .
     1799       end.
     1800     end.
     1801     else do:
     1802       glog = v-qh:get-first( p-lock) no-error .
     1803     end.
     1804     do v-ii = 1 to p-qh:num-buffers:
     1805       assign
     1806       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1807       no-error.
     1808     end.
     1809     delete object v-qh.
     1810     do v-ii = 1 to p-qh:num-buffers:
     1811       delete object v-bh[v-ii].
     1812     end.
     1813   end.
     1814   end procedure.
