     4836   is-edoc-nn = lookup(par-is-edoc-nn, "true,yes":U) > 0
     4837   .
     4838   if not (is-edi and is-edoc-nn) then do:
     4839       v-status-edi:VISIBLE IN BROWSE br-docs = FALSE.
     4840       v-status-trn-edi:VISIBLE IN BROWSE browse-34 = FALSE.
     4841   end.
     4842     RUN enable_UI.
     4843     RUN init-p.
     4844     run OpenBr in this-procedure .
     4845     WAIT-FOR GO OF FRAME Dialog-Frame.
     4846   END.
     4847   RUN disable_UI.
     4848   PROCEDURE disable_UI :
     4849     HIDE FRAME Dialog-Frame.
     4850   END PROCEDURE.
     4851   PROCEDURE enable_UI :
     4852     OPEN QUERY Dialog-Frame FOR EACH bufs_ord-doc-rcv NO-LOCK.
     4853     GET FIRST Dialog-Frame.
     4854     DISPLAY r-cli-type r-cli-code sch-date-rcv sch-rcv sch-ship sch-ship-2
     4855             sch-code sch-date FILL-IN-1 r-cli-name
     4856         WITH FRAME Dialog-Frame.
     4857     ENABLE b-quit RECT-1 b-sel b-rep b-sch b-close b-exec b-print b-history
     4858            b-help b-mark b-chg b-lkp b-del b-export r-cli-type r-cli-code r-cli
     4859            sch-date-rcv sch-rcv b-excecF sch-ship sch-ship-2 sch-code sch-date
     4860            br-docs BROWSE-34 FILL-IN-1 r-cli-name
     4861         WITH FRAME Dialog-Frame.
     4862     VIEW FRAME Dialog-Frame.
     4863     OPEN QUERY br-docs FOR EACH bufs_ord-doc-rcv NO-LOCK where ( if list-mode = 'obj':U then ( bufs_ord-doc-rcv.obj-code = store-code and                                 bufs_ord-doc-rcv.obj-type = store-type)                           else (                                  if list-mode = 'cli':U then (bufs_ord-doc-rcv.cli-code = store-code and                                                               bufs_ord-doc-rcv.cli-type = store-type)                                                         else ( true = true )                                ) )    and bufs_ord-doc-rcv.host-code = p-host-code and (p-g#cons-code = ? or ( bufs_ord-doc-rcv.cons-code = p-g#cons-code)) and (p-g#type = ? or  ( bufs_ord-doc-rcv.doc-type = p-g#type)) and (p-g#stat = ? or  (bufs_ord-doc-rcv.status_ = p-g#stat  )) and (hard-flt-date = no or ( bufs_ord-doc-rcv.ship-date >= sch-ship and bufs_ord-doc-rcv.ship-date <= sch-ship-2 )) and (hard-flt-cli  = no or ( bufs_ord-doc-rcv.cli-code = r-cli-code and bufs_ord-doc-rcv.cli-type = r-cli-type)) ,        EACH buf_ord-doc WHERE buf_ord-doc.doc-code = bufs_ord-doc-rcv.doc-code OUTER-JOIN NO-LOCK by  bufs_ord-doc-rcv.doc-date desc by bufs_ord-doc-rcv.doc-code desc .    OPEN QUERY BROWSE-34 FOR EACH buf_ord-chain NO-LOCK WHERE          buf_ord-chain.doc-code = bufs_ord-doc-rcv.rcv-code and          buf_ord-chain.doc-type = 'rcv' and          buf_ord-chain.rel-doc-type = 'trn' ,            EACH buf_trn-doc NO-LOCK where          buf_trn-doc.doc-code = buf_ord-chain.rel-doc-code INDEXED-REPOSITION.
     4864   END PROCEDURE.
     4865   PROCEDURE init-p :
     4866   if list-mode = "firm":U  then
     4867       assign
     4868         sss = "ПОСТАВКИ под заказ   ФИРМА: " + p-g#host-name .
     4869       else
     4870       assign
     4871         sss = "ПОСТАВКИ под заказ   ОБЪЕКТ: " + store-type + " " + string(store-code) .
     4872   if list-mode = "with-fo":U then do:
     4873     sss = "ПОСТАВКИ под заказ  --  Есть ФО  --  ФИРМА: " + p-g#host-name .
     4874     disable b-close b-chg b-del with frame Dialog-Frame .
     4875   end.
     4876   if list-mode = "without-fo":U then do:
     4877     sss = "ПОСТАВКИ под заказ  --  Нет ФО  --  ФИРМА: " + p-g#host-name .
     4878     disable b-close b-chg b-del with frame Dialog-Frame .
     4879   end.
     4880   if list-mode = "firm-fin":U then do:
     4881     sss = "ПОСТАВКИ под заказ  ФИРМА: " + p-g#host-name .
     4882     disable b-close b-chg b-del with frame Dialog-Frame .
     4883   end.
     4884   if list-mode = "cli":U then do:
     4885       assign
     4886         sss = "ПОСТАВКИ под заказ   ПОСТАВЩИК: " + store-type + " " + string(store-code) .
     4887     disable b-close with frame Dialog-Frame .
     4888   end.
     4889   case p-g#type :
     4890     when "in" then sss = sss + " , Тип: Внутренние".
     4891     when "out" then  sss = sss + " , Тип: Внешние".
     4892   end case.
     4893   case p-g#stat :
     4894     when 'новый':U then sss = sss + " , Статус: " +  p-g#stat.
     4895     when 'поставка':U then sss = sss + " , Статус: " +  p-g#stat.
     4896     when 'факт':U then  sss = sss + " , Статус: " +  p-g#stat.
     4897   end case.
     4898   if p-g#cons-code <> ? then  sss = sss + " , СЗФП № " +  p-g#cons-code.
     4899   frame Dialog-Frame:title = sss.
     4900   END PROCEDURE.
     4901   PROCEDURE openbr :
     4902    do
     4903    on error undo, return error return-value
     4904    :
     4905   define variable l-query-was-opened as logical no-undo .
     4906   define variable title0 as character no-undo.
     4907   title0 = "Поставки ".
     4908   run waitfram-show("Ждите...").
     4909   define variable sort-column-phrase as character no-undo .
     4910   case sort-column-name :
     4911     when "" then do:
     4912       assign
     4913         sort-column-phrase = ""
     4914       .
     4915     end.
     4916     otherwise do:
     4917       assign
     4918         sort-column-phrase = "by " + sort-column-name
     4919       .
     4920     end.
     4921   end case.
     4922   do:
     4923   case list-mode :
     4924   when 'obj':U then do:
     4925   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4926   define variable  l-disable-where-38  as logical   no-undo .
     4927   define variable  l-filter-open-38    as logical   .
     4928   define variable  flt-rec-38       as recid     no-undo .
     4929   define variable  filter-name-38      as character no-undo .
     4930   define variable  where-phrase-38     as character no-undo .
     4931   define variable  sort-phrase-38      as character no-undo .
     4932   define variable  where-phrase-rus-38 as character no-undo .
     4933   define variable  sort-phrase-rus-38  as character no-undo .
     4934   run gbl/flt-get.p
     4935     (input filter-point
     4936     ,output flt-rec-38
     4937     ,output filter-name-38
     4938     ,output where-phrase-38
     4939     ,output sort-phrase-38
     4940     ,output where-phrase-rus-38
     4941     ,output sort-phrase-rus-38
     4942     ).
     4943       run set-filter-name in this-procedure
     4944         (INPUT filter-name-38
     4945         ) no-error .
     4946     assign
     4947       l-filter-open-38 = false
     4948     .
     4949     if flt-rec-38 <> ?
     4950       or sort-column-phrase > ""
     4951     then do:
     4952       define variable  parameter-2-38 as character no-undo .
     4953       define variable  parameter-3-38 as character no-undo .
     4954       define variable  parameter-4-38 as character no-undo .
     4955       define variable  parameter-5-38 as character no-undo .
     4956       define variable  parameter-6-38 as character no-undo .
     4957       define variable  parameter-7-38 as character no-undo .
     4958         assign
     4959         parameter-3-38 =
     4960                                 "FOR EACH bufs_ord-doc-rcv"
     4961         parameter-4-38 =
     4962           (
     4963             if (" bufs_ord-doc-rcv.obj-code = store-code   and bufs_ord-doc-rcv.obj-type = store-type   and bufs_ord-doc-rcv.host-code = p-host-code   and ( p-g#cons-code = ?                              or  ( bufs_ord-doc-rcv.cons-code = p-g#cons-code ))   and ( p-g#type = ? or  ( bufs_ord-doc-rcv.doc-type = p-g#type ))   and ( p-g#stat = ? or  ( bufs_ord-doc-rcv.status_ = p-g#stat  ))   and (hard-flt-date = no or ( bufs_ord-doc-rcv.ship-date >= sch-ship and bufs_ord-doc-rcv.ship-date <= sch-ship-2 ))   and (hard-flt-cli  = no or ( bufs_ord-doc-rcv.cli-code = r-cli-code and bufs_ord-doc-rcv.cli-type = r-cli-type))   " + " " + where-phrase-38) <> ""
     4964             then  substitute('
     4965     bufs_ord-doc-rcv.obj-code = &3 and
     4966     bufs_ord-doc-rcv.obj-type = &1&4&1
     4967         and bufs_ord-doc-rcv.host-code = &5
     4968         and ( &1&6&1 = &1?&1
