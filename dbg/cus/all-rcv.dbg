     1604     define output parameter p-report-name as character no-undo .
     1605     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1606   end procedure.
     1607   procedure prn-lib-reportviewer-report-name :
