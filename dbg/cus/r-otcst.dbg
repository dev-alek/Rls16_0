     1363                                                input my-handle
     1364                                               ,input 43
     1365                                               ,input yes
     1366                                               ,input no
     1367                                               ).
     1368   run waitfram-show in this-procedure ('Подождите ...' ) .
     1369   assign
     1370   v-header-name = "Отчет о товарах, помеченных под таможенный режим магазина беспошлинной торговли" + chr(10) + "и реализованных в магазине беспошлинной торговли ЗАО 'Порт-Альянc' лицензия от 06.09.99 № 52" + chr(10) + "по состоянию на " + string(x-Date-End + 1, "99/99/9999") + " за период с " + string(x-date-start, "99/99/9999") + " по " + string(x-date-end, "99/99/9999")
     1371   v-print-time  = cur-time-string().
     1372   put stream PrnLibStream unformatted
     1373   "Отчет о товарах, помеченных под таможенный режим магазина беспошлинной торговли" skip(1)
     1374   "и реализованных в магазине беспошлинной торговли ЗАО 'Порт-Альянc' лицензия от 06.09.99 № 52" skip(1)
     1375   "по состоянию на " + string(x-Date-End + 1, "99/99/9999") + " за период с " + string(x-date-start, "99/99/9999") + " по " + string(x-date-end, "99/99/9999") skip(1)
     1376   SPACE(50) v-print-time skip(1).
     1377   put stream PrnLibStream unformatted
     1378   v-line skip
     1379   ":     :      :                                         :   Статус   :          :                     :          : Остаток  :Количество: Товары в отношении которых тамож. режим: Остаток  :          :" skip
     1380   ":  №  :   №  :  Краткое наименование товара, артикул,  :  товаров   :   Код    :   Кол-во мест и     :Количество:на начало :реализова-:маг-на беспошлинной торг.изменен на иной: товаров, :Примечание:" skip
     1381   ": п/п :  ГТД :           единица измерения             :(российские :  ТНВЭД   :    вес брутто       :   (шт)   :отчетного :   нное   :________________________________________:помещенных:          :" skip
     1382   ":     :      :                                         :     или    :          :                     :          : периода  :  на дату :  кол-во  :таможенный :       №ГТД      :под тамож.:          :" skip
     1383   ":     :      :                                         :иностранные):          :                     :          :   (шт)   :отчета(шт):  товара  :   режим   :                 :  режим   :          :" skip
     1384   v-line
     1385   .
     1386   find first tt-cst-year No-LOCK WHERE
     1387              tt-cst-year.zero = no USE-index i-year No-ERROR.
     1388   if avail tt-cst-year then
     1389   varyear-cst = tt-cst-year.in-year.
     1390   form header
     1391   v-line1 at 1 skip
     1392   v-header-name format "x(79)" at 1
     1393   "Дата:" at 90
