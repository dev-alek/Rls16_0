      583   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      584   define  stream PrnLibStream.
      585   procedure prn-lib-prn-file :
      586     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      587     define input parameter p-DIsabledoptions as integer no-undo .
      588     define variable v-report-name as character no-undo .
      589     define variable v-user-action as character no-undo .
      590     define variable v-printed     as logical   no-undo .
      591     define variable v-exist       as logical   no-undo .
      592     do
      593       on error undo, return error
      594       :
      595       run prn-lib-get-report-name  in this-procedure (
      596         input parParentProc
      597         ,output v-report-name
      598         ).
      599   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      601     (input  v-report-name
      602     ,input  2
      603     ,output v-exist
      604     )  .
      605       if NOT v-exist then
      606       DO:
      607         Message
      608           "Нет заданий на печать ! "
      609           view-as alert-box .
      610         Return  .
      611       End.
      612       run gbl/prnfilen.w
      613         (input  ""
      614         ,input  p-DisabledOptions
      615         ,input  string(v-report-name )
      616         ,input  7
      617         ,output v-user-action
      618         ,output v-printed
      619         ) .
      620       if v-printed then
      621       do:
      622         return "YES" .
      623       end.
      624       else
      625       do:
      626         return "NO" .
      627       end.
      628     end.
      629   end procedure.
      630   procedure prn-lib-open-stream :
      631     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      632     define input parameter p-page-size    as integer no-undo .
      633     define input parameter p-is-stream    as logical no-undo .
      634     define input parameter p-append       as logical no-undo .
      635     define variable v-report-name as character no-undo .
      636     do
      637       on error undo, return error
      638       :
      639       run prn-lib-get-report-name  in this-procedure (
      640         input parParentProc
      641         ,output v-report-name
      642         ).
      643       if p-is-stream then
      644       do:
      645         if p-append then
      646         do:
      647           output stream PrnLibStream to value( v-report-name )
      648             page-size value(p-page-size) append .
      649         end.
      650         if not p-append then
      651         do:
      652           output stream PrnLibStream to value( v-report-name )
      653             page-size value(p-page-size) .
      654         end.
      655       end.
      656       if not p-is-stream then
      657       do:
      658         if p-append then
      659         do:
      660           output to value( v-report-name )
      661             page-size value(p-page-size) append .
      662         end.
      663         if not p-append then
      664         do:
      665           output to value( v-report-name )
      666             page-size value(p-page-size) .
      667         end.
      668       end.
      669     end.
      670   end procedure.
      671   procedure prn-lib-open-exp :
      672     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      673     define input parameter p-is-stream    as logical no-undo .
      674     define input parameter p-is-append    as logical no-undo .
      675     define output parameter p-ReportFileName as char init "report" no-undo.
      676     define output parameter p-process as logical no-undo .
      677     define variable glog as logical no-undo .
      678     do
      679       on error undo, return error
      680       :
      681       SYSTEM-DIALOG GET-FILE p-ReportFileName
      682         TITLE      "Укажите путь"
      683         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      684         ASK-OVERWRITE
      685         CREATE-TEST-FILE
      686         SAVE-AS
      687         USE-FILENAME
      688         DEFAULT-EXTENSION "txt"
      689         UPDATE glog
      690         .
      691       if not glog then  return.
      692       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      693       if p-is-stream then
      694       do:
      695         if p-is-append then
      696         do:
      697           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      698         end.
      699         else
      700         do:
      701           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      702         end.
      703       end.
      704       else
      705       do:
      706         if p-is-append then
      707         do:
      708           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      709         end.
      710         else
      711         do:
      712           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      713         end.
      714       end.
      715       p-process = yes.
      716     end.
      717   end procedure.
      718   procedure prn-lib-get-report-name :
      719     define input parameter parParentProc  as widget-handle no-undo.
      720     define output parameter p-report-name as character no-undo .
      721     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      722   end procedure.
      723   procedure prn-lib-reportviewer-report-name :
      724     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      725     define input parameter p-report-name-html as character no-undo .
      726     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      727   end procedure.
      728   procedure prn-lib-reportviewer :
      729     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      730     define input parameter p-report-name-html as character no-undo .
      731     define input parameter p-param        as character no-undo .
      732     define variable v-excel           as character no-undo init 'TRUE' .
      733     define variable v-value-character as character no-undo .
      734     define variable v-value-integer   as character no-undo .
      735     define variable v-value-date      as date      no-undo .
      736     define variable v-value-decimal   as decimal   no-undo .
      737     define variable rep-excel         as logical   no-undo .
      738     define variable excel-string      as character no-undo .
      739     define variable v-param-type      as character no-undo .
      740     define variable v-tth             as handle    no-undo .
      741     run adm/shattri.p (
      742       input "get":U
      743       ,input  ""
      744       ,input  0
      745       ,input  'report-glob':U
      746       ,input  'rep-excel':U
      747       ,output v-value-character
      748       ,output v-value-date
      749       ,output v-value-decimal
      750       ,output v-value-integer
      751       ,output rep-excel
      752       ,output v-param-type
      753       ,INPUT-OUTPUT table-handle v-tth
      754       )  .
      755     if rep-excel then v-excel = "TRUE" .
      756     else v-excel = "FALSE" .
      757     if p-param eq ""
      758     then
      759        p-param = "EXCEL:" + v-excel.
      760     else
      761        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      762     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      763   end procedure.
      764   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      765   procedure cur-time :
      766      define output parameter p-today as date      no-undo .
      767      define output parameter p-time  as integer   no-undo .
      768     do
      769     on error undo, return error
      770     :
      771       define variable v-date1 as date      no-undo .
      772       define variable v-date2 as date      no-undo .
      773       define variable v-time  as integer   no-undo .
      774       assign
      775         v-date1 = today
      776         v-time  = time
      777         v-date2 = today
      778       .
      779       if v-date1 <> v-date2
      780       then do:
      781         assign
      782           v-date1 = today
      783           v-time  = v-time
      784         .
      785       end.
      786       assign
      787         p-today = v-date1
      788         p-time  = v-time
      789       .
      790     end.
      791   end.
      792   function cur-time-date returns character
      793   :
      794     return string(today, '99/99/9999':U) .
      795   end.
      796   function cur-time-mjd returns decimal
      797   :
      798     define variable v-date as date      no-undo .
      799     define variable v-time as integer   no-undo .
      800     run cur-time in this-procedure
      801       (output v-date
      802       ,output v-time
      803       ) .
      804     return integer(v-date) - 2400002 + (v-time / 86400) .
      805   end.
      806   function cur-time-get-ending-index returns integer
      807   (input p-number as integer
      808   )
      809   :
      810     if p-number < 0
      811     or p-number = ?
      812     then do:
      813       return 1 .
      814     end.
      815     define variable v-rest as integer   no-undo .
      816     assign
      817       p-number = p-number modulo 100
      818     .
      819     if p-number < 20
      820     then do:
      821       assign
      822         v-rest = p-number
      823       .
      824     end.
      825     else do:
      826       assign
      827         v-rest = p-number modulo 10
      828       .
      829     end.
      830     case v-rest :
      831       when 1
      832       then do:
      833         return 2 .
      834       end.
      835       when 2 or
      836       when 3 or
      837       when 4
      838       then do:
      839         return 3 .
      840       end.
      841       otherwise do:
      842         return 1 .
      843       end.
      844     end case .
      845   end.
      846   procedure cur-time-mjd-to-date :
      847      define input  parameter i-mjd-diff as decimal no-undo.
      848      define output parameter o-Date     as date    no-undo.
      849      define output parameter o-Time     as integer no-undo.
      850      define variable v-day-number as integer   no-undo .
      851      if    i-mjd-diff < 0
      852         or i-mjd-diff = ?
      853      then do:
      854         return "?" .
      855      end.
      856      assign
      857         v-day-number = truncate(i-mjd-diff,0).
      858         o-Date = date(v-day-number + 2400002).
      859         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      860     .
      861   end.
      862   function cur-time-mjd-to-string returns character
      863   (input p-mjd-diff as decimal
      864   )
      865   :
      866     define variable v-day-number as integer   no-undo .
      867     define variable v-seconds    as integer   no-undo .
      868     define variable v-hour       as integer   no-undo .
      869     define variable v-min        as integer   no-undo .
      870     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      871     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      872     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      873     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      874     if p-mjd-diff < 0
      875     or p-mjd-diff = ?
      876     then do:
      877       return "?" .
      878     end.
      879     assign
      880       v-day-number = integer(truncate(p-mjd-diff,0))
      881       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      882     .
      883     if v-seconds > 86400
      884     then do:
      885       assign
      886         v-seconds = 86400 - 1
      887       .
      888     end.
      889     if v-seconds < 0
      890     then do:
      891       assign
      892         v-seconds = 0
      893       .
      894     end.
      895     assign
      896       v-hour = truncate(v-seconds / 3600, 0)
      897     .
      898     assign
      899       v-seconds = v-seconds modulo 3600
      900     .
      901     assign
      902       v-min = truncate(v-seconds / 60, 0)
      903     .
      904     assign
      905       v-seconds = v-seconds modulo 60
      906     .
      907     return
      908         (if v-day-number <> 0
      909           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      910           else ""
      911         )
      912       + (if v-day-number <> 0 or v-hour <> 0
      913           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      914           else ""
      915         )
      916       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      917           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      918           else ""
      919         )
      920       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      921       .
      922   end.
      923   function cur-time-string returns character
      924   :
      925     define variable v-date as date      no-undo .
      926     define variable v-time as integer   no-undo .
      927     run cur-time in this-procedure
      928       (output v-date
      929       ,output v-time
      930       ) .
      931     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      932   end.
      933   function cur-time-string-sec returns character
      934   :
      935     define variable v-date as date      no-undo .
      936     define variable v-time as integer   no-undo .
      937     run cur-time in this-procedure
      938       (output v-date
      939       ,output v-time
      940       ) .
      941     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      942   end.
      943   function cur-time-custom  returns character
      944   (input p-prefix as character
      945   ,input p-date-format as character
      946   ,input p-delimiter as character
      947   ,input p-time-format as character
      948   ,input p-suffix as character
      949   )
      950   :
      951     define variable v-date as date      no-undo .
      952     define variable v-time as integer   no-undo .
      953     run cur-time in this-procedure
      954       (output v-date
      955       ,output v-time
      956       ) .
      957     return
      958       p-prefix
      959       + string(v-date, p-date-format)
      960       + p-delimiter
      961       + string(v-time, p-time-format)
      962       + p-suffix
      963       .
      964   end.
      965   function cur-time-print  returns character
      966   :
      967     define variable v-date as date      no-undo .
      968     define variable v-time as integer   no-undo .
      969     run cur-time in this-procedure
      970       (output v-date
      971       ,output v-time
      972       ) .
      973     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      974   end.
      975   function cur-time-datetime returns datetime
      976   :
      977     define variable v-char as character no-undo .
      978     define variable v-datetime as datetime no-undo .
      979     v-char = cur-time-string().
      980     v-datetime = datetime(v-char).
      981     return  v-datetime.
      982   end.
      983   function cur-time-string-msec returns character
      984   :
      985     define variable v-date as datetime  no-undo .
      986     v-date = now.
      987     return string(v-date) .
      988   end.
