     1246     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1247     define variable v-cntxt-is-admin      as logical   no-undo .
     1248   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1249   define NEW shared temp-table tt-cst no-undo
