      990   define variable v-waitfram-action01         as character   no-undo .
      991   define variable v-waitfram-action02         as character   no-undo .
      992   define variable v-waitfram-action03         as character   no-undo .
      993   define variable mWaitFramTextBeg            as character   no-undo.
      994   define variable mWaitFramTextEnd            as character   no-undo.
      995   define variable mWaitFramView               as logical     no-undo.
      996   define variable mWaitProcEvent              as logical     no-undo init yes.
      997   define variable mWaitFramInterval           as integer     no-undo init 1 .
      998   define variable mWaitFramStop               as logical     no-undo.
      999   define variable mWaitFramStopUser           as logical     no-undo.
     1000   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1001   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1002   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1003   define button B-WaitFramStop auto-end-key
     1004        label "Стоп"
     1005        size 10 by 1 tooltip "Остоновить процесс".
     1006   define button B-viewProcInfo
     1007        label "Информация"
     1008        size 15 by 1 tooltip "Информация о процесс".
     1009   define frame waitfram
     1010     v-waitfram-action01 format "x(72)" no-label skip
     1011     v-waitfram-action02 format "x(72)" no-label skip
     1012     v-waitfram-action03 format "x(72)" no-label skip
     1013     B-viewProcInfo
     1014     B-WaitFramStop at row 4 col 30
     1015     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1016     .
     1017   define new global shared variable mBatchMode as logical no-undo init ?.
     1018   define variable mFramBachModHandle as handle no-undo.
     1019   mFramBachModHandle = frame waitfram:handle.
     1020   define variable mFameOldVis as logical no-undo.
     1021   define variable mVisCUrentVin as logical no-undo.
     1022   if session:batch-mode
     1023   then
     1024      mBatchMode = yes.
     1025   if mBatchMode = ? then do:
     1026     mVisCUrentVin = current-window:visible.
     1027     mFameOldVis = mFramBachModHandle:visible.
     1028     mFramBachModHandle:visible  = yes.
     1029     mBatchMode = mFramBachModHandle:visible ne yes.
     1030     mFramBachModHandle:visible = mFameOldVis.
     1031     current-window:visible = mVisCUrentVin.
     1032   end.
     1033    if  log-manager:logfile-name ne ?
     1034     then DO:
     1035         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1036         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1037         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1038     end.
     1039   on choose of B-WaitFramStop in frame waitfram
     1040   do:
     1041     mWaitFramStop = yes.
     1042     mWaitFramStopUser = yes.
     1043   end.
     1044   function waitfram-check-timeout returns logical():
     1045      define variable vtime as int64 no-undo.
     1046      if mWaitFramStopTimeOut
     1047      then
     1048         return yes.
     1049      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1050      if     mWaitFramTimeOut ne ?
     1051         and mWaitFramTimeOut ne 0
     1052         and mWaitFramTimeOut lt vtime
     1053      then do:
     1054         mWaitFramStopTimeOut = yes.
     1055      end.
     1056      return mWaitFramStopTimeOut.
     1057   end.
     1058   procedure waitfram-hide :
     1059     if not session:batch-mode
     1060     then do
     1061     on error undo, return error return-value
     1062     :
     1063       pause 0 before-hide .
     1064       if not mBatchMode then
     1065         hide frame waitfram .
     1066     if     not mWaitFramView
     1067        and mWaitProcEvent
     1068     then
     1069       process events .
     1070     end.
     1071   end procedure.
     1072   procedure waitfram-show :
     1073     define input  parameter p-message as character no-undo .
     1074     define variable v-left-margin as integer   no-undo .
     1075     if not session:batch-mode
     1076     then do
     1077     on error undo, return error return-value
     1078     :
     1079       if length(p-message) <= 70 then do:
     1080         assign
     1081           v-left-margin = integer((70 - length(p-message)) / 2)
     1082         .
     1083         assign
     1084           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1085         .
     1086         assign
     1087           v-waitfram-action01 = " "
     1088           v-waitfram-action02 = " "
     1089                                    + fill(" ", v-left-margin)
     1090                                    + p-message
     1091           v-waitfram-action03 = " "
     1092         .
     1093       end.
     1094       else do:
     1095         define variable vRindex1 as integer no-undo.
     1096         define variable vRindex2 as integer no-undo.
     1097         vRindex1 = r-index(p-message," ",70).
     1098         if vRindex1 = 0
     1099         then
     1100            vRindex1 = 70.
     1101         if length(p-message)  <= vRindex1 + 70 then do:
     1102           assign
     1103             v-waitfram-action01 = " "
     1104             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1105             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1106           .
     1107         end.
     1108         else do:
     1109           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1110           if vRindex2 <= vRindex1
     1111           then
     1112              vRindex2 = vRindex1 + 70.
     1113           assign
     1114             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1115             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1116             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1117           .
     1118         end.
     1119       end.
     1120       B-viewProcInfo:visible   in frame waitfram = no.
     1121       B-viewProcInfo:sensitive in frame waitfram = no.
     1122       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1123       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1124       if  (   mWaitFramView
     1125          or  mWaitProcEvent)
     1126          and not mBatchMode
     1127       then
     1128          display
     1129             v-waitfram-action01 skip
     1130             v-waitfram-action02 skip
     1131             v-waitfram-action03 skip
     1132          with frame waitfram .
     1133       if     mWaitFramView
     1134          then do:
     1135             if     mWaitFramInterval ne ?
     1136                and not mBatchMode
     1137             then
     1138                wait-for go of frame waitfram pause mWaitFramInterval.
     1139          end.
     1140          else
     1141             if     mWaitProcEvent
     1142                and not mBatchMode
     1143             then
     1144                process events .
     1145     end.
     1146   end procedure.
     1147      procedure waitfram-show-this:
     1148         define input  parameter iInterval as int64 no-undo.
     1149         define variable vtime as int64 no-undo.
     1150         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1151         mWaitFramInterval = iInterval.
     1152         run waitfram-show (substitute("&1&2 &3&4" ,
     1153                                       mWaitFramTextBeg ,
     1154                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1155                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1156                                       mWaitFramTextEnd
     1157                                      )
     1158                           ).
     1159      end.
     1160      procedure WaitFramRunPause:
     1161         define input  parameter iInterval as dec no-undo.
     1162         define variable vStart  as datetime-tz no-undo.
     1163         define variable vend    as datetime-tz no-undo.
     1164         define variable vint as int64 no-undo.
     1165         define variable vOk as logical no-undo.
     1166         vStart = now.
     1167         vend   = vStart.
     1168         publish "WaitFramPause" (iInterval,output vOk).
     1169         vend   =  now.
     1170         vint = vend - vStart.
     1171         vint = iInterval - vint / 1000.
     1172         if     not mWaitFramStop
     1173            and (   vint > 0
     1174                 or (    not vOk
     1175                     and iInterval eq ?
     1176                     )
     1177                 )
     1178         then
     1179            run waitfram-show-this (iInterval).
     1180         vend   =  now.
     1181         vint = vend - vStart.
     1182         vint = iInterval - vint / 1000.
     1183         if     not mWaitFramStop
     1184            and vint > 0
     1185         then do:
     1186            run gbl/pause.p (vint * 1000).
     1187         end.
     1188         if iInterval ne ?
     1189         then
     1190            publish "WaitFramStop".
     1191         waitfram-check-timeout().
     1192      end.
     1193      procedure WaitFramWaitFor:
     1194         define input  parameter iInterval as dec no-undo.
     1195         assign
     1196            mWaitFramStartProc   = now
     1197            mWaitFramStopUser    = no
     1198            mWaitFramStopTimeOut = no
     1199         .
     1200         block-wait:
     1201         do while not mWaitFramStop:
     1202            run WaitFramRunPause (iInterval).
     1203            if  waitfram-check-timeout()
     1204            then do:
     1205               leave block-wait.
     1206            end.
     1207         end.
     1208         run waitfram-hide.
     1209      end.
     1210   procedure waitfram-join :
     1211     define input  parameter p-line-1  as character no-undo .
     1212     define input  parameter p-line-2  as character no-undo .
     1213     define input  parameter p-line-3  as character no-undo .
     1214     define output parameter p-message as character no-undo .
     1215     do
     1216     on error undo, return error return-value
     1217     :
     1218       assign
     1219         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1220                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1221                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1222       .
     1223     end.
     1224   end procedure.
     1225   function waitfram-join-function returns character
     1226     (input p-line-1 as character
     1227     ,input p-line-2 as character
     1228     ,input p-line-3 as character
     1229     ).
     1230     define variable v-message as character no-undo .
     1231     run waitfram-join in this-procedure
     1232       (input  p-line-1
     1233       ,input  p-line-2
     1234       ,input  p-line-3
     1235       ,output v-message
     1236       ) .
     1237     return v-message .
     1238   end function .
     1239   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
