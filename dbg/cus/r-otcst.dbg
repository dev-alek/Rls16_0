     1395   v-line2 at 1
     1396   with frame topframe
     1397   width 200 page-top no-labels no-box .
     1398   view stream PrnLibStream frame topframe .
     1399   form header
     1400   v-line skip
     1401   "ГТД  за " varyear-cst "год "
     1402   "Стр." at 180 string( page-number(PrnLibStream), ">>>9" )
     1403   "Продолжение на следующей странице " at 30 skip
     1404   with frame bottomframe
     1405   width 200 page-bottom no-labels no-box .
     1406   view stream PrnLibStream frame bottomframe .
     1407   form with frame doc-line-frm .
     1408   for each tt-cst-year No-LOCK WHERE
     1409            tt-cst-year.zero = no,
     1410       each tt-cst No-LOCK WHERE
     1411            tt-cst.cst-code = tt-cst-year.cst-code
     1412       break
     1413       by tt-cst-year.in-year
     1414       by tt-cst-year.cst-code
     1415       by tt-cst.artic
     1416       by tt-cst.prod-type
     1417       by tt-cst.prod-code:
     1418     if first-of(tt-cst-year.in-year) then do:
     1419       if tt-cst-year.in-year <> ? then
     1420       varyear-cst = tt-cst-year.in-year.
     1421       if not first(tt-cst-year.in-year) then
     1422       DOWN 1 stream PrnLibStream
     1423       with FRAME doc-line-frm.
     1424       DISPLAY stream PrnLibStream
     1425       "ГТД" @ for-ii
     1426       "за"  @ tt-cst.cst-code
     1427       (string(tt-cst-year.in-year) + chr(32) + "год") @ tt-cst.name_artic_unit
     1428       with frame doc-line-frm.
     1429       DOWN 2 stream PrnLibStream
     1430       with FRAME doc-line-frm.
     1431     end.
     1432     if first-of(tt-cst-year.cst-code) then do:
     1433       if not first(tt-cst-year.cst-code) and
     1434          not first-of(tt-cst-year.in-year) then
     1435       DOWN 1 stream PrnLibStream
     1436       with FRAME doc-line-frm.
     1437       DISPLAY stream PrnLibStream
     1438       "ГТД" @ for-ii
     1439       "N"  @ tt-cst.cst-code
     1440       tt-cst-year.cst-code @ tt-cst.name_artic_unit
     1441       with frame doc-line-frm.
     1442       DOWN 2 stream PrnLibStream
     1443       with FRAME doc-line-frm.
     1444     end.
     1445     for-ii = for-ii + 1.
     1446     find first tt-cst-ext No-LOCK WHERE
     1447               tt-cst-ext.cst-code = tt-cst.cst-code AND
     1448               tt-cst-ext.artic = tt-cst.artic AND
     1449               tt-cst-ext.prod-type = tt-cst.prod-type AND
     1450               tt-cst-ext.prod-code = tt-cst.prod-code No-ERROR.
     1451     DISPLAY stream PrnLibStream
     1452     sym01 sym02 sym03 sym04 sym05 sym06 sym07 sym08 sym09 sym10 sym11 sym12 sym13 sym14
     1453     for-ii
     1454     "--//--" @ tt-cst.cst-code
     1455     tt-cst.name_artic_unit
     1456     tt-cst.nationality
     1457     tt-cst.tnved
     1458     string(tt-cst.num-place, "->>>>>>>9.<<<") + chr(32) + string(tt-cst.brutto, ">>>>9.999")
     1459     @ for-num-place_brutto
     1460     tt-cst.qnty-income
     1461     tt-cst.qnty-start
     1462     (- tt-cst.qnty-sale) @ tt-cst.qnty-sale
     1463     ( - tt-cst.qnty-ext_expence) @ tt-cst.qnty-ext_expence
     1464     (if avail tt-cst-ext
     1465      then (string(tt-cst-ext.qnty, "->>>>>>>9.<<<") + chr(32) + tt-cst-ext.des)
     1466      else "") @ vardes
     1467     tt-cst.qnty-rest
     1468     tt-cst.PS
     1469     with frame doc-line-frm.
     1470     DOWN stream PrnLibStream
     1471     with FRAME doc-line-frm.
     1472     REPEAT while avail tt-cst-ext:
     1473       find next tt-cst-ext No-LOCK WHERE
     1474                 tt-cst-ext.cst-code = tt-cst.cst-code AND
     1475                 tt-cst-ext.artic = tt-cst.artic AND
     1476                 tt-cst-ext.prod-type = tt-cst.prod-type AND
     1477                 tt-cst-ext.prod-code = tt-cst.prod-code No-ERROR.
     1478       if avail tt-cst-ext then do:
     1479         DISPLAY stream PrnLibStream
     1480         sym01 sym02 sym03 sym04 sym05 sym06 sym07 sym08 sym09 sym10 sym11 sym12 sym13 sym14
     1481         tt-cst-ext.des @ vardes
     1482         with frame doc-line-frm.
     1483         DOWN stream PrnLibStream
     1484         with FRAME doc-line-frm.
     1485       end.
     1486     END.
     1487   end.
     1488   put stream PrnLibStream
     1489   v-line  skip
     1490   .
     1491   hide frame input-frm .
     1492   put stream PrnLibStream
     1493   skip(2)
     1494   .
     1495   put stream PrnLibStream unformatted
     1496   "   ___________________________________      ___________________________________                 " skip
     1497   "             Руководитель                                 Подпись                         Печать" SKIP
     1498   .
     1499   hide stream PrnLibStream frame bottomframe .
     1500   output stream PrnLibStream close.
     1501   run waitfram-show in this-procedure ("Вывод списка ГТД, исключенных из отчета").
     1502   run prn-lib-open-stream  in this-procedure (
     1503                                                input my-handle
     1504                                               ,input 45
     1505                                               ,input yes
     1506                                               ,input yes
     1507                                               ).
     1508   assign
     1509   v-header-name = "                Список ГТД, которые исключены из Отчета, как ГТД," + chr(10) + " по которым остаток по всем наименованиям товаров, помещенных под таможенный " + chr(10) + " режим МБТ и реализованных в магазине беспошлинной торговли ЗАО 'Порт-Альянс'"
     1510   .
     1511   put stream PrnLibStream unformatted
     1512   "                Список ГТД, которые исключены из Отчета, как ГТД," skip(1)
     1513   " по которым остаток по всем наименованиям товаров, помещенных под таможенный " skip(1)
     1514   " режим МБТ и реализованных в магазине беспошлинной торговли ЗАО 'Порт-Альянс'" skip(1)
     1515   "лицензия от 06.09.99 N 52 по состоянию на " + string(X-date-end + 1, "99/99/9999") + " равен 0" skip(1)
     1516   SPACE(50) v-print-time skip(1).
     1517   put stream PrnLibStream unformatted
     1518   v-line skip
     1519   ":     :                     :" skip
     1520   ":  №  :       № ГТД         :" skip
     1521   ": п/п :                     :" skip
     1522   ":     :                     :" skip
     1523   v-line
     1524   .
     1525   find first tt-cst-year No-LOCK WHERE
     1526              tt-cst-year.zero = yes USE-index i-year No-ERROR.
     1527   if avail tt-cst-year then
     1528   varyear-cst = tt-cst-year.in-year.
     1529   else
     1530   varyear-cst = ?.
     1531   form header
     1532   v-line1 at 1 skip
     1533   v-header-name format "x(55)" at 1
     1534   "Дата:" at 90
     1535   v-print-time format "x(20)"
     1536   v-line2 at 1
     1537   with frame topframez
     1538   width 200 page-top no-labels no-box .
     1539   view stream PrnLibStream frame topframez .
     1540   form header
     1541   v-line skip
     1542   "ГТД за " varyear-cst "год "
     1543   "Стр." at 180 string( page-number(PrnLibStream), ">>>9" )
     1544   "Продолжение на следующей странице " at 30 skip
     1545   with frame bottomframez
     1546   width 200 page-bottom no-labels no-box .
     1547   view stream PrnLibStream frame bottomframez .
     1548   form with frame zero-frm .
     1549   for-ii = 0.
     1550   FOR EACH tt-cst-year where
     1551            tt-cst-year.zero = yes
     1552       BREAK
     1553       BY tt-cst-year.in-year:
     1554     IF first-of(tt-cst-year.in-year) then do:
     1555       if tt-cst-year.in-year <> ? then
     1556       varyear-cst = tt-cst-year.in-year.
     1557       if not first(tt-cst-year.in-year) then
     1558       DOWN 1 stream PrnLibStream
     1559       with FRAME zero-frm.
     1560       DISPLAY stream PrnLibStream
     1561       "ГТД" @ for-ii
     1562       ("за " + string(tt-cst-year.in-year, "9999") + chr(32) + "год") @ tt-cst-year.cst-code
     1563       with frame zero-frm.
     1564       DOWN 2 stream PrnLibStream
     1565       with FRAME zero-frm.
     1566     end.
     1567     for-ii = for-ii + 1.
     1568     display stream PrnLibStream
     1569     for-ii
     1570     tt-cst-year.cst-code
     1571     with frame zero-frm.
     1572     DOWN stream PrnLibStream
     1573     with FRAME zero-frm.
     1574   END.
     1575   put stream PrnLibStream
     1576   v-line  skip
     1577   .
     1578   hide frame input-frmz .
     1579   put stream PrnLibStream
     1580   skip(2)
     1581   .
     1582   put stream PrnLibStream unformatted
     1583   "   ___________________________________      ___________________________________                 " skip
     1584   "             Руководитель                                 Подпись                         Печать"
     1585   .
     1586   hide stream PrnLibStream frame bottomframez .
     1587   output stream PrnLibStream close.
     1588   run waitfram-hide in this-procedure .
     1589   run prn-lib-prn-file in this-procedure (
     1590                                             input my-handle
     1591                                             ,input 8
     1592                                             ).
