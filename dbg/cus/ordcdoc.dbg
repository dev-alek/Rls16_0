     2817   when "ord-dec1":U then do:     create temp-changes.       assign         temp-changes.f_name = "ord-dec1":U         temp-changes.l_name = "4"         temp-changes.v_old = string(buf_c-ord-doc.ord-dec1)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.ord-dec1)                                  else string(current_ord-doc.ord-dec1))       .   end.
     2818   when "ord-dec2":U then do:     create temp-changes.       assign         temp-changes.f_name = "ord-dec2":U         temp-changes.l_name = "5"         temp-changes.v_old = string(buf_c-ord-doc.ord-dec2)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.ord-dec2)                                  else string(current_ord-doc.ord-dec2))       .   end.
     2819   when "ord-dec3":U then do:     create temp-changes.       assign         temp-changes.f_name = "ord-dec3":U         temp-changes.l_name = "6"         temp-changes.v_old = string(buf_c-ord-doc.ord-dec3)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.ord-dec3)                                  else string(current_ord-doc.ord-dec3))       .   end.
     2820   when "ord-int1":U then do:     create temp-changes.       assign         temp-changes.f_name = "ord-int1":U         temp-changes.l_name = "7"         temp-changes.v_old = string(buf_c-ord-doc.ord-int1)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.ord-int1)                                  else string(current_ord-doc.ord-int1))       .   end.
     2821   when "ord-int2":U then do:     create temp-changes.       assign         temp-changes.f_name = "ord-int2":U         temp-changes.l_name = "8"         temp-changes.v_old = string(buf_c-ord-doc.ord-int2)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.ord-int2)                                  else string(current_ord-doc.ord-int2))       .   end.
     2822   when "ord-int3":U then do:     create temp-changes.       assign         temp-changes.f_name = "ord-int3":U         temp-changes.l_name = "9"         temp-changes.v_old = string(buf_c-ord-doc.ord-int3)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.ord-int3)                                  else string(current_ord-doc.ord-int3))       .   end.
     2823   when "qnty":U then do:     create temp-changes.       assign         temp-changes.f_name = "qnty":U         temp-changes.l_name = "Количество"         temp-changes.v_old = string(buf_c-ord-doc.qnty)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.qnty)                                  else string(current_ord-doc.qnty))       .   end.
     2824   when "sub-par":U then do:     create temp-changes.       assign         temp-changes.f_name = "sub-par":U         temp-changes.l_name = "10"         temp-changes.v_old = string(buf_c-ord-doc.sub-par)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.sub-par)                                  else string(current_ord-doc.sub-par))       .   end.
     2825   when "transport-cli-code":U then do:     create temp-changes.       assign         temp-changes.f_name = "transport-cli-code":U         temp-changes.l_name = "transport-cli-code"         temp-changes.v_old = string(buf_c-ord-doc.transport-cli-code)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.transport-cli-code)                                  else string(current_ord-doc.transport-cli-code))       .   end.
     2826   when "transport-cli-type":U then do:     create temp-changes.       assign         temp-changes.f_name = "transport-cli-type":U         temp-changes.l_name = "transport-cli-type"         temp-changes.v_old = string(buf_c-ord-doc.transport-cli-type)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.transport-cli-type)                                  else string(current_ord-doc.transport-cli-type))       .   end.
