     2831   when "transport-VAT":U then do:     create temp-changes.       assign         temp-changes.f_name = "transport-VAT":U         temp-changes.l_name = "транспортный НДС"         temp-changes.v_old = string(buf_c-ord-doc.transport-VAT)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.transport-VAT)                                  else string(current_ord-doc.transport-VAT))       .   end.
     2832   when "VAT-type":U then do:     create temp-changes.       assign         temp-changes.f_name = "VAT-type":U         temp-changes.l_name = "Тип НДС"         temp-changes.v_old = string(buf_c-ord-doc.VAT-type)         temp-changes.v_new = (if available new_c-ord-doc                                  then string(new_c-ord-doc.VAT-type)                                  else string(current_ord-doc.VAT-type))       .   end.
     2833   END CASE.
     2834   end.
     2835   end.
     2836   define buffer old_c-ord-line for ub.c-ord-line  .
     2837   for each ub.c-ord-line where
     2838            ub.c-ord-line.doc-code = buf_c-ord-doc.doc-code and
     2839            ub.c-ord-line.chip-num = buf_c-ord-doc.chip-num
     2840            :
     2841        find last old_c-ord-line no-lock where
     2842            old_c-ord-line.doc-code   = ub.c-ord-line.doc-code  and
     2843            old_c-ord-line.artic      = ub.c-ord-line.artic     and
     2844            old_c-ord-line.prod-type  = ub.c-ord-line.prod-type and
     2845            old_c-ord-line.prod-code  = ub.c-ord-line.prod-code and
     2846            old_c-ord-line.chip-num   < buf_c-ord-doc.chip-num
     2847            use-index pi no-error .
     2848            if available old_c-ord-line then do:
     2849                 buffer-compare ub.c-ord-line to old_c-ord-line
     2850                 save result in v-chg-fields.
     2851            end.
     2852            v-nn = num-entries (v-chg-fields) .
     2853           do ii = 1 to v-nn:
     2854               CASE entry(ii, v-chg-fields):
     2855                                             when "status_":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "status_":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Статус строки"         temp-changes.v_new = string(ub.c-ord-line.status_)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.status_)                                  else "")       .   end.
     2856                                             when "qnty":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "qnty":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Количество"         temp-changes.v_new = string(ub.c-ord-line.qnty)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.qnty)                                  else "")       .   end.
     2857                                             when "cli-qnty":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "cli-qnty":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Кол.во пост"         temp-changes.v_new = string(ub.c-ord-line.cli-qnty)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.cli-qnty)                                  else "")       .   end.
     2858                                             when "price-cli":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "price-cli":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Цена поставщика"         temp-changes.v_new = string(ub.c-ord-line.price-cli)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.price-cli)                                  else "")       .   end.
     2859                                             when "price-rubl":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "price-rubl":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Цена в нац.вал."         temp-changes.v_new = string(ub.c-ord-line.price-rubl)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.price-rubl)                                  else "")       .   end.
     2860                                             when "price-base":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "price-base":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Цена в баз.вал."         temp-changes.v_new = string(ub.c-ord-line.price-base)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.price-base)                                  else "")       .   end.
     2861                                             when "sum-cli":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "sum-cli":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Сумма в ценах поставщика"         temp-changes.v_new = string(ub.c-ord-line.sum-cli)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.sum-cli)                                  else "")       .   end.
     2862                                             when "sum-rubl":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "sum-rubl":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Сумма в нац.вал."         temp-changes.v_new = string(ub.c-ord-line.sum-rubl)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.sum-rubl)                                  else "")       .   end.
     2863                                             when "sum-base":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "sum-base":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Сумма в баз.вал."         temp-changes.v_new = string(ub.c-ord-line.sum-base)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.sum-base)                                  else "")       .   end.
     2864                                             when "sum-VAT":U then do:     create temp-changes.       assign         temp-changes.f_name ="line" + string(ub.c-ord-line.line-num ) + "sum-VAT":U         temp-changes.l_name ="Изм.строки-" + string(ub.c-ord-line.line-num ) + " " + "Сумма НДС"         temp-changes.v_new = string(ub.c-ord-line.sum-VAT)         temp-changes.v_old =  (if available old_c-ord-line                                  then string(old_c-ord-line.sum-VAT)                                  else "")       .   end.
     2865               end case.
     2866           end.
     2867   end.
     2868   Open QUery br-changes for each temp-changes.
     2869   END PROCEDURE.
     2870   PROCEDURE set-filter-name :
     2871   define input parameter p-filter-name as character no-undo .
     2872     do with frame Dialog-Frame:
     2873       if p-filter-name > "" then do:
     2874         assign
     2875           frame Dialog-Frame:title
     2876             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2877         .
     2878         assign
     2879           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     2880         .
     2881       end.
     2882       else do:
     2883         assign
     2884           b-sch :TOOLTIP = ""
     2885         .
     2886       end.
     2887     end.
     2888   END PROCEDURE.
