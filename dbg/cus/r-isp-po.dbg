     1284   procedure prn-lib-reportviewer :
     1285     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1286     define input parameter p-report-name-html as character no-undo .
     1287     define input parameter p-param        as character no-undo .
     1288     define variable v-excel           as character no-undo init 'TRUE' .
     1289     define variable v-value-character as character no-undo .
     1290     define variable v-value-integer   as character no-undo .
     1291     define variable v-value-date      as date      no-undo .
     1292     define variable v-value-decimal   as decimal   no-undo .
     1293     define variable rep-excel         as logical   no-undo .
     1294     define variable excel-string      as character no-undo .
     1295     define variable v-param-type      as character no-undo .
     1296     define variable v-tth             as handle    no-undo .
     1297     run adm/shattri.p (
     1298       input "get":U
     1299       ,input  ""
     1300       ,input  0
     1301       ,input  'report-glob':U
     1302       ,input  'rep-excel':U
     1303       ,output v-value-character
     1304       ,output v-value-date
     1305       ,output v-value-decimal
     1306       ,output v-value-integer
     1307       ,output rep-excel
     1308       ,output v-param-type
     1309       ,INPUT-OUTPUT table-handle v-tth
     1310       )  .
     1311     if rep-excel then v-excel = "TRUE" .
     1312     else v-excel = "FALSE" .
     1313     if p-param eq ""
     1314     then
     1315        p-param = "EXCEL:" + v-excel.
     1316     else
     1317        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1318     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1319   end procedure.
     1320   do
     1321   on error undo, return error
     1322   :
     1323   define temp-table temp-gds no-undo
     1324     FIELD gds-name  as character
     1325     FIELD prod-code as integer
     1326     FIELD prod-type as character
     1327     FIELD artic     as character
     1328     FIELD gds-code  as integer
     1329     FIELD b-code    as integer
     1330     FIELD unit      as character
     1331     FIELD qnty1     as decimal
     1332     FIELD price1    as decimal
     1333     FIELD sum1      as decimal
     1334     FIELD qnty2     as decimal
     1335     FIELD price2    as decimal
     1336     FIELD sum2      as decimal
     1337     INDEX ii IS UNIQUE artic prod-type prod-code
     1338   .
     1339     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
     1340     ASSIGN parParentProc =  my-handle .
     1341     define variable g#report-num as integer   no-undo .
     1342     run get-report-num  in parParentProc ( output g#report-num ).
     1343     define buffer buf_ord-doc-rcv  for ub.ord-doc-rcv.
     1344     define buffer buf_ord-line-rcv for ub.ord-line-rcv.
     1345     define buffer buf_goods        for ub.goods.
