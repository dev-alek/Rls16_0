      601   define new global shared variable g#library  as handle no-undo .
      602   define new global shared variable g#library2 as handle no-undo .
      603   define variable var-report-r-b as character no-undo .
      604   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      606     (output var-report-r-b
      607     )  .
      608   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   procedure factord :
      610     define input  parameter p-fact-date            as date    no-undo .
      611     define input  parameter p-fact-time            as integer no-undo .
      612     define input  parameter p-fact-num             as integer no-undo .
      613     define input  parameter p-shift-date           as date    no-undo .
      614     define input  parameter p-shift-num            as integer no-undo .
      615     define input  parameter p-shift-on             as logical no-undo .
      616     define output parameter p-fact-order           as decimal no-undo .
      617     define output parameter p-shift-end-fact-order as decimal no-undo .
      618     define output parameter p-day-end-fact-order   as decimal no-undo .
      619     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      620     if p-fact-date = ?
      621     then do:
      622       return error "Не указана фактическая дата" .
      623     end.
      624     define variable v-fact-date-num as integer no-undo .
      625     assign
      626       v-fact-date-num = integer(p-fact-date)
      627     .
      628     if p-fact-num = ?
      629     or p-fact-num = 0
      630     then do:
      631       return error "Не задан p-fact-num " + string(p-fact-num) .
      632     end.
      633     if p-fact-num < 0
      634     then do:
      635       return error "Отрицательный fact-num " + string(p-fact-num) .
      636     end.
      637     if p-fact-num >= 100000000
      638     then do:
      639       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      640     end.
      641     if p-shift-on = true
      642     then do:
      643       if p-shift-date = ?
      644       then do:
      645         return error "Не задана дата смены" .
      646       end.
      647       if p-shift-num = ?
      648       or p-shift-num = 0
      649       then do:
      650         return error "Не задан номер смены" .
      651       end.
      652     end.
      653     else do:
      654       assign
      655         p-shift-date = p-fact-date
      656         p-shift-num  = 24
      657       .
      658     end.
      659     define variable v-shift-offset as integer no-undo .
      660     if p-shift-date = p-fact-date
      661     then do:
      662       assign
      663         v-shift-offset = 1
      664       .
      665     end.
      666     if p-shift-date < p-fact-date
      667     then do:
      668       assign
      669         v-shift-offset = 0
      670       .
      671     end.
      672     if p-shift-date > p-fact-date
      673     then do:
      674       message
      675         vss-workfile vss-revision vss-description skip
      676         "Неправильная дата закрытия смены" skip
      677         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      678         view-as alert-box error .
      679       undo, return error
      680         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      681           ,string(p-fact-date, '99/99/9999':U)
      682           ,string(p-shift-date, '99/99/9999':U)
      683           )
      684       .
      685     end.
      686     if p-shift-num < 1
      687     or p-shift-num > 24
      688     then do:
      689       message
      690         vss-workfile vss-revision vss-description skip
      691         "Неправильный номер смены" skip
      692         "p-shift-num" p-shift-num skip
      693         view-as alert-box error .
      694       undo, return error return-value .
      695     end.
      696     assign
      697       p-fact-order           = v-fact-date-num
      698                              + v-shift-offset * 0.5
      699                              + p-shift-num    * 0.02 - 0.01
      700                              + p-fact-num     * 0.0000000001
      701       p-shift-end-fact-order = v-fact-date-num
      702                              + v-shift-offset * 0.5
      703                              + p-shift-num    * 0.02
      704       p-day-end-fact-order   = v-fact-date-num
      705                              + 0.99
      706     .
      707     if p-fact-order           <= v-fact-date-num
      708     or p-shift-end-fact-order <= v-fact-date-num
      709     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      710     or p-shift-end-fact-order >= p-day-end-fact-order
      711     then do:
      712       message
      713         vss-workfile vss-revision vss-description skip
      714         "Внутренняя ошибка при генерации фактического номера" skip
      715         "p-fact-date"            p-fact-date            skip
      716         "p-fact-time"            p-fact-time            skip
      717         "p-fact-num"             p-fact-num             skip
      718         "p-shift-date"           p-shift-date           skip
      719         "p-shift-num"            p-shift-num            skip
      720         "p-shift-on"             p-shift-on             skip
      721         "p-shift-end-fact-order" p-shift-end-fact-order skip
      722         "p-day-end-fact-order"   p-day-end-fact-order   skip
      723         "v-fact-date-num"        v-fact-date-num        skip
      724         view-as alert-box error .
      725       undo, return error return-value .
      726     end.
      727   end procedure.
      728   procedure day-begin-fact-order :
      729     define input  parameter p-fact-date            as date    no-undo .
      730     define output parameter p-day-begin-fact-order as decimal no-undo .
      731     do
      732     on error undo, return error return-value
      733     :
      734       if p-fact-date = ?
      735       then do:
      736         assign
      737           p-day-begin-fact-order = 0
      738         .
      739       end.
      740       else do:
      741         assign
      742           p-day-begin-fact-order = integer(p-fact-date)
      743         .
      744       end.
      745     end.
      746   end procedure.
      747   procedure factord-max-fact-order :
      748     define output parameter p-max-fact-order as decimal   no-undo .
      749     do
      750     on error undo, return error return-value
      751     :
      752       run day-begin-fact-order in this-procedure
      753         (input  date(1, 1, 5000)
      754         ,output p-max-fact-order
      755         ) .
      756     end.
      757   end procedure.
      758   procedure factord-cut-archive :
      759     define input  parameter p-obj-type             as character no-undo .
      760     define input  parameter p-obj-code             as integer   no-undo .
      761     define input  parameter p-fact-date            as date      no-undo .
      762     define output parameter p-shift-on             as logical   no-undo .
      763     define output parameter p-shift-date           as date      no-undo .
      764     define output parameter p-shift-num            as integer   no-undo .
      765     define output parameter p-day-end-fact-order   as decimal   no-undo .
      766     define output parameter p-shift-end-fact-order as decimal   no-undo .
      767     define variable v-fact-order as decimal   no-undo .
      768     define buffer buf_shift-obj for ub.shift-obj .
      769     do
      770     on error undo, return error return-value
      771     :
      772   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      773   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      774     (input  p-obj-type
      775     ,input  p-obj-code
      776     ,input  'shift-on=request'
      777     ,output p-shift-on
      778     ) no-error .
      779       if error-status :error
      780       then do:
      781         message
      782           vss-workfile vss-revision vss-description skip
      783           "Ошибка при определении атрибута объекта" skip
      784           "Объект" p-obj-type p-obj-code skip
      785           error-status :get-message(1) skip
      786           return-value skip
      787           view-as alert-box error .
      788         undo, return error return-value .
      789       end.
      790       if p-shift-on = false
      791       then do:
      792         assign
      793           p-shift-date               = ?
      794           p-shift-num                = 0
      795         .
      796       end.
      797       else do:
      798         find first buf_shift-obj share-lock
      799           where buf_shift-obj.obj-type   = p-obj-type
      800             and buf_shift-obj.obj-code   = p-obj-code
      801             and buf_shift-obj.shift-date > p-fact-date
      802           use-index pi
      803           no-error .
      804         if not available buf_shift-obj
      805         or buf_shift-obj.status_ <> 'зкр':U
      806         then do:
      807           message
      808             vss-workfile vss-revision vss-description skip
      809             "Невозможно вычислить последнюю смену" skip
      810             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      811             "Объект" p-obj-type p-obj-code skip
      812             "Дата" p-fact-date skip
      813             view-as alert-box error .
      814           undo, return error return-value .
      815         end.
      816         find last buf_shift-obj share-lock
      817           where buf_shift-obj.obj-type = p-obj-type
      818             and buf_shift-obj.obj-code = p-obj-code
      819             and buf_shift-obj.shift-date <= p-fact-date
      820           use-index pi
      821           no-error .
      822         if available buf_shift-obj
      823         then do:
      824           if  buf_shift-obj.status_ = 'зкр':U
      825           then do:
      826             assign
      827               p-shift-date = buf_shift-obj.shift-date
      828               p-shift-num  = buf_shift-obj.shift-num
      829             .
      830           end.
      831           else do:
      832             message
      833               vss-workfile vss-revision vss-description skip
      834               "Невозможно вычислить последнюю смену" skip
      835               "Статус смены отличен от статуса" 'зкр':U skip
      836               "Объект" p-obj-type p-obj-code skip
      837               "Дата" p-fact-date skip
      838               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      839               view-as alert-box error .
      840             undo, return error return-value .
      841           end.
      842         end.
      843         else do:
      844           assign
      845             p-shift-date = p-fact-date - 1
      846             p-shift-num  = 1
      847           .
      848         end.
      849       end.
      850       run factord in this-procedure
      851         (input  p-fact-date
      852         ,input  1
      853         ,input  1
      854         ,input  p-shift-date
      855         ,input  p-shift-num
      856         ,input  p-shift-on
      857         ,output v-fact-order
      858         ,output p-shift-end-fact-order
      859         ,output p-day-end-fact-order
      860         ) no-error .
      861       if error-status :error
      862       then do:
      863         message
      864           vss-workfile vss-revision vss-description skip
      865           "Ошибка при вызове процедуры factord"
      866           error-status :get-message(1) skip
      867           return-value skip
      868           view-as alert-box error .
      869         undo, return error return-value .
      870       end.
      871     end.
      872   end procedure.
      873   procedure factord-lock-shift :
      874     define input  parameter p-obj-type  as character no-undo .
      875     define input  parameter p-obj-code  as integer   no-undo .
      876     define input  parameter p-fact-date as date      no-undo .
      877     define parameter buffer buf_shift-obj for ub.shift-obj .
      878     define variable v-shift-on      as logical   no-undo .
      879     define variable v-extra-message as character no-undo .
      880     define variable v-error as character no-undo .
      881     do
      882     on error undo, return error return-value
      883     :
      884   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      886     (input  p-obj-type
      887     ,input  p-obj-code
      888     ,input  'shift-on=request'
      889     ,output v-shift-on
      890     ) no-error .
      891       if error-status :error
      892       then do:
      893         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      894         undo, return error v-error .
      895       end.
      896       if v-shift-on = true
      897       then do:
      898         find first buf_shift-obj share-lock
      899           where buf_shift-obj.obj-type   = p-obj-type
      900             and buf_shift-obj.obj-code   = p-obj-code
      901             and buf_shift-obj.shift-date > p-fact-date
      902           use-index pi
      903           no-error .
      904         if not available buf_shift-obj
      905         or buf_shift-obj.status_ <> 'зкр':U
      906         then do:
      907           find last buf_shift-obj
      908             where buf_shift-obj.obj-type = p-obj-type
      909               and buf_shift-obj.obj-code = p-obj-code
      910               and buf_shift-obj.status_  = 'зкр':U
      911             use-index stts
      912             no-error .
      913           if available buf_shift-obj
      914           then do:
      915             assign
      916               v-extra-message =
      917                     substitute("Дата начала последеней закрытой смены на объекте &1"
      918                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      919                               )
      920             .
      921           end.
      922           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      923           undo, return error v-error .
      924         end.
      925       end.
      926     end.
      927   end procedure.
      928   procedure factord-end-day :
      929     define input  parameter p-fact-date            as date    no-undo .
      930     define output parameter p-day-end-fact-order   as decimal no-undo .
      931     do
      932     on error undo, return error return-value
      933     :
      934       if p-fact-date = ?
      935       then do:
      936         return error "Не указана фактическая дата" .
      937       end.
      938       assign
      939         p-day-end-fact-order = integer(p-fact-date) + 0.99
      940       .
      941     end.
      942   end procedure.
      943   procedure factord-to-date :
      944     define input  parameter p-fact-order as decimal no-undo .
      945     define output parameter p-fact-date  as date    no-undo .
      946     define variable v-ref-date  as date      no-undo .
      947     define variable v-ref-delta as integer   no-undo .
      948     do
      949     on error undo, return error return-value
      950     :
      951       if p-fact-order = ?
      952       or p-fact-order = 0
      953       then do:
      954         return error "Не указан fact-order" .
      955       end.
      956       assign
      957         v-ref-date  = date(1, 1, 2000)
      958       .
      959       assign
      960         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      961       .
      962       assign
      963         p-fact-date = v-ref-date + v-ref-delta
      964       .
      965     end.
      966   end procedure.
      967   procedure factord-to-fact-num :
      968     define input  parameter p-fact-order as decimal no-undo .
      969     define output parameter p-fact-num   as integer no-undo .
      970     define variable v-fact-order-trunc as decimal no-undo .
      971     do
      972     on error undo, return error return-value
      973     :
      974       if p-fact-order = ?
      975       or p-fact-order = 0
      976       then do:
      977         return error "Не указан fact-order" .
      978       end.
      979       assign
      980        v-fact-order-trunc = truncate(p-fact-order, 2)
      981       .
      982       assign
      983         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      984       .
      985     end.
      986   end procedure.
      987   procedure factord-to-shift-num :
      988     define input  parameter p-fact-order as decimal no-undo .
      989     define output parameter p-shift-num   as integer no-undo .
      990     define variable  p-shift-numd  as decimal   no-undo .
      991     define variable v-fact-order-trunc as decimal no-undo .
      992     do
      993     on error undo, return error return-value
      994     :
      995       if p-fact-order = ?
      996       or p-fact-order = 0
      997       then do:
      998         return error "Не указан fact-order" .
      999       end.
     1000       assign
     1001        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1002       .
     1003       if v-fact-order-trunc < 0.5 then do:
     1004         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1005       end.
     1006       assign
     1007         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1008         .
     1009        assign
     1010         p-shift-num = truncate (p-shift-numd , 0)
     1011       .
     1012     end.
     1013   end procedure.
     1014   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1015   procedure cmptime :
     1016   do
     1017   on error undo, return error
     1018   :
     1019   define output parameter p-difference as decimal      no-undo.
     1020   define variable v-srv-time      as decimal           no-undo.
     1021   define variable v-cli-time      as decimal           no-undo.
     1022   assign
     1023       session :time-source = "ub":U
     1024       v-srv-time = integer(today) + ( time / 86400 )
     1025   .
     1026   assign
     1027       session :time-source = "LOCAL":U
     1028       v-cli-time = integer(today) + ( time / 86400 )
     1029   .
     1030   assign
     1031       p-difference = ( v-srv-time - v-cli-time ) * 1440
     1032   .
     1033   end.
     1034   end procedure.
     1035   procedure cmptime-time-diff :
     1036   do
     1037   on error undo, return error
     1038   :
     1039   define input parameter p-date1          as date         no-undo.
     1040   define input parameter p-time1          as integer      no-undo.
     1041   define input parameter p-date2          as date         no-undo.
     1042   define input parameter p-time2          as integer      no-undo.
     1043   define output parameter p-difference    as decimal      no-undo.
     1044       assign
     1045           p-difference = ( integer( p-date2 ) - integer( p-date1 ) + ( ( p-time2 - p-time1 ) / 86400 ) ) * 1440
     1046       .
     1047   end.
     1048   end procedure.
     1049   procedure cmptime-string-to-hms :
     1050   do
     1051   on error undo, return error
     1052   :
     1053   define input parameter p-time-string as character    no-undo.
     1054   define input parameter p-format      as character    no-undo.
     1055   define output parameter p-hour as integer      no-undo.
     1056   define output parameter p-min  as integer      no-undo.
     1057   define output parameter p-sec  as integer      no-undo.
     1058   if p-format <> "hh:mm" and p-format <> "hh:mm:ss"
     1059   then do:
     1060       message
     1061         "cmptime.i: Ошибка преобразования строки даты"
     1062         skip return-value
     1063         skip trim(error-status :get-message(1))
     1064              trim(error-status :get-message(2))
     1065              trim(error-status :get-message(3))
     1066              trim(error-status :get-message(4))
     1067              trim(error-status :get-message(5))
     1068       view-as alert-box error.
     1069       undo, return error .
     1070   end.
     1071   assign
     1072       p-hour      = integer ( entry( 1, p-time-string, ":" ) )
     1073       p-min       = integer ( entry( 2, p-time-string, ":" ) )
     1074       p-sec       = ( if p-format = "hh:mm:ss"
     1075                       then integer ( entry( 3, p-time-string, ":" ) )
     1076                       else 0
     1077                     )
     1078   .
     1079   end.
     1080   end procedure.
     1081   procedure cmptime-hms-to-integer :
     1082   do
     1083   on error undo, return error
     1084   :
     1085   define input parameter p-hour   as integer      no-undo.
     1086   define input parameter p-min    as integer      no-undo.
     1087   define input parameter p-sec    as integer      no-undo.
     1088   define output parameter p-time  as integer      no-undo.
     1089       assign
     1090           p-time = p-hour * 3600 + ( p-min * 60 ) + p-sec
     1091       .
     1092   end.
     1093   end procedure.
     1094   procedure proc-alt-shift-f2:
     1095     if not ibs.th.gbl.gbl-var:rcode
