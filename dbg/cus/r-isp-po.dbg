     1139   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1140   define  stream PrnLibStream.
     1141   procedure prn-lib-prn-file :
     1142     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1143     define input parameter p-DIsabledoptions as integer no-undo .
     1144     define variable v-report-name as character no-undo .
     1145     define variable v-user-action as character no-undo .
     1146     define variable v-printed     as logical   no-undo .
     1147     define variable v-exist       as logical   no-undo .
     1148     do
     1149       on error undo, return error
     1150       :
     1151       run prn-lib-get-report-name  in this-procedure (
     1152         input parParentProc
     1153         ,output v-report-name
     1154         ).
     1155   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1156   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1157     (input  v-report-name
     1158     ,input  2
     1159     ,output v-exist
     1160     )  .
     1161       if NOT v-exist then
     1162       DO:
     1163         Message
     1164           "Нет заданий на печать ! "
     1165           view-as alert-box .
     1166         Return  .
     1167       End.
     1168       run gbl/prnfilen.w
     1169         (input  ""
     1170         ,input  p-DisabledOptions
     1171         ,input  string(v-report-name )
     1172         ,input  7
     1173         ,output v-user-action
     1174         ,output v-printed
     1175         ) .
     1176       if v-printed then
     1177       do:
     1178         return "YES" .
     1179       end.
     1180       else
     1181       do:
     1182         return "NO" .
     1183       end.
     1184     end.
     1185   end procedure.
     1186   procedure prn-lib-open-stream :
     1187     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1188     define input parameter p-page-size    as integer no-undo .
     1189     define input parameter p-is-stream    as logical no-undo .
     1190     define input parameter p-append       as logical no-undo .
     1191     define variable v-report-name as character no-undo .
     1192     do
     1193       on error undo, return error
     1194       :
     1195       run prn-lib-get-report-name  in this-procedure (
     1196         input parParentProc
     1197         ,output v-report-name
     1198         ).
     1199       if p-is-stream then
     1200       do:
     1201         if p-append then
     1202         do:
     1203           output stream PrnLibStream to value( v-report-name )
     1204             page-size value(p-page-size) append .
     1205         end.
     1206         if not p-append then
     1207         do:
     1208           output stream PrnLibStream to value( v-report-name )
     1209             page-size value(p-page-size) .
     1210         end.
     1211       end.
     1212       if not p-is-stream then
     1213       do:
     1214         if p-append then
     1215         do:
     1216           output to value( v-report-name )
     1217             page-size value(p-page-size) append .
     1218         end.
     1219         if not p-append then
     1220         do:
     1221           output to value( v-report-name )
     1222             page-size value(p-page-size) .
     1223         end.
     1224       end.
     1225     end.
     1226   end procedure.
     1227   procedure prn-lib-open-exp :
     1228     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1229     define input parameter p-is-stream    as logical no-undo .
     1230     define input parameter p-is-append    as logical no-undo .
     1231     define output parameter p-ReportFileName as char init "report" no-undo.
     1232     define output parameter p-process as logical no-undo .
     1233     define variable glog as logical no-undo .
     1234     do
     1235       on error undo, return error
     1236       :
     1237       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1238         TITLE      "Укажите путь"
     1239         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1240         ASK-OVERWRITE
     1241         CREATE-TEST-FILE
     1242         SAVE-AS
     1243         USE-FILENAME
     1244         DEFAULT-EXTENSION "txt"
     1245         UPDATE glog
     1246         .
     1247       if not glog then  return.
     1248       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1249       if p-is-stream then
     1250       do:
     1251         if p-is-append then
     1252         do:
     1253           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1254         end.
     1255         else
     1256         do:
     1257           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1258         end.
     1259       end.
     1260       else
     1261       do:
     1262         if p-is-append then
     1263         do:
     1264           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1265         end.
     1266         else
     1267         do:
     1268           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1269         end.
     1270       end.
     1271       p-process = yes.
     1272     end.
     1273   end procedure.
     1274   procedure prn-lib-get-report-name :
     1275     define input parameter parParentProc  as widget-handle no-undo.
     1276     define output parameter p-report-name as character no-undo .
     1277     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1278   end procedure.
     1279   procedure prn-lib-reportviewer-report-name :
