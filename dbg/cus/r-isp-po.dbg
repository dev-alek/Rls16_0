     1347     define buffer buf1_trn-doc     for ub.trn-doc.
     1348     define buffer buf_doc-line     for ub.doc-line.
     1349     define buffer buf_clients      for ub.clients.
     1350     define variable Counter as integer .
     1351   define variable v-account as integer init 0 no-undo .
     1352   define variable v-account-lavel as character no-undo .
     1353   define variable v-button-stop as logical no-undo .
     1354   define variable v-kol-spice as integer no-undo .
     1355   define variable v-kol-spice2 as integer no-undo .
     1356   define variable v-kol-spice3 as integer no-undo .
     1357   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1358   DEFINE BUTTON StopBtn AUTO-END-KEY
     1359        LABEL "Стоп"
     1360        SIZE 10 BY 1.
     1361   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1362        LABEL "Обработано записей"
     1363         VIEW-AS TEXT
     1364        SIZE 14 BY .67 NO-UNDO.
     1365   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1366         VIEW-AS TEXT
     1367        SIZE 53.25 BY .67
     1368        FGCOLOR 1  NO-UNDO.
     1369   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1370         VIEW-AS TEXT
     1371        SIZE 53.25 BY .67
     1372        FGCOLOR 1  NO-UNDO.
     1373   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1374         VIEW-AS TEXT
     1375        SIZE 53.25 BY .67
     1376        FGCOLOR 1  NO-UNDO.
     1377   DEFINE RECTANGLE RECT-1
     1378        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1379        SIZE 55.13 BY 4.46.
     1380   DEFINE FRAME InfoFrame
     1381        StopBtn AT ROW 4.25 COL 21.75
     1382        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1383        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1384        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1385        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1386        RECT-1 AT ROW 1 COL 1
     1387       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1388            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1389            TITLE "Процесс"
     1390            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1391   define variable mFrameView      as logical   no-undo init yes.
     1392     define variable mFramHandle as handle no-undo.
     1393     mFramHandle = frame InfoFrame:handle.
     1394     if  log-manager:logfile-name ne ?
     1395     then DO:
     1396         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1397         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1398         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1399     end.
     1400     mFrameView = not session:batch-mode and mFramHandle:visible.
     1401     if mFrameView
     1402     then do:
     1403       ASSIGN
     1404          FRAME InfoFrame:HIDDEN                           = TRUE
     1405          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1406     end.
     1407   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1408   DO:
     1409     IF not StopProcessing THEN
     1410       Message "Вы действительно хотите прервать" SKIP
     1411               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1412                 UPDATE StopProcessing.
     1413     IF StopProcessing THEN do:
     1414        if mFrameView
     1415        then do:
     1416           HIDE FRAME InfoFrame.
     1417        end.
     1418     End.
     1419   END.
     1420   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1421     if  log-manager:logfile-name ne ?
     1422     then DO:
     1423         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1424     end.
     1425     if not session:batch-mode then
     1426     do:
     1427       VIEW FRAME InfoFrame.
     1428       mFrameView = true.
     1429     end.
     1430      v-button-stop = false .
     1431         if mFrameView
     1432         then do:
     1433         if v-button-stop then view STOPBTN in frame InfoFrame.
     1434                          else Hide STOPBTN in frame InfoFrame.
     1435         end.
     1436     define variable  Line as char no-undo.
