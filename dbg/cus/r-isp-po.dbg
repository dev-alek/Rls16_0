      177   procedure create_obj-list :
      178      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      179      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      180      do
      181      on error undo, return error return-value
      182      :
      183         define buffer cli-obj for ub.clients .
      184         define variable p-var as integer no-undo .
      185         define buffer buf_obj-list for obj-list .
      186         find last buf_obj-list  use-index pi no-error .
      187         if available buf_obj-list
      188         then
      189            p-var = buf_obj-list.obj-id + 1.
      190         else
      191            p-var = 1.
      192         find first cli-obj where
      193                   cli-obj.obj-type = p-obj-type
      194               and cli-obj.obj-code = p-obj-code
      195         no-lock no-error.
      196         if available cli-obj
      197         then do:
      198            create buf_obj-list.
      199            assign
      200               buf_obj-list.obj-id   = p-var
      201               buf_obj-list.obj-code = cli-obj.obj-code
      202               buf_obj-list.obj-type = cli-obj.obj-type
      203               buf_obj-list.obj-name = cli-obj.obj-name
      204               buf_obj-list.db-num   = cli-obj.db-num
      205            .
      206         end.
      207      end.
      208   end.
