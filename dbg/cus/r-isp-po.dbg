     1474           sym10 v-date-nakl    column-label "Дата!накладной"         format "99.99.9999"        space(0)
     1475           sym11 v-time-nakl    column-label "Время!накладной"        format "X(9)"              space(0)
     1476           sym12 v-cost-nakl    column-label "Цена!накладной"         format ">>>,>>>,>>9.99"    space(0)
     1477           sym13
     1478     HEADER
     1479           string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(100)"
     1480           string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>9") ) AT 170 format "X(15)" SKIP
     1481           Line format "X(196)" AT 1
     1482     with width 235 down stream-io.
     1483     run prn-lib-open-stream  in this-procedure (input parParentProc,input 43,input yes,input no).
     1484     FORM HEADER
     1485         Line format "X(196)" AT 1 SKIP
     1486         "Продолжение - на следующей странице" AT 30 SKIP
     1487         with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     1488     VIEW stream PrnLibStream FRAME BottomFrame .
     1489     FORM with FRAME f-doc .
     1490     PUT stream PrnLibStream
     1491       SPACE(30) "Отчет по исполнению поставок за период с: " x-date-start format "99/99/9999" "г. по: "  x-date-end format "99/99/9999" "г." SKIP .
     1492     PUT stream PrnLibStream   str1 format "X(100)" SKIP  str2 format "X(100)"SKIP .
     1493     for each obj-list no-lock :
     1494       assign
     1495         PrnObj = no
     1496         sum-obj-val-post = 0
     1497         sum-obj-val-nakl = 0
     1498       .
     1499       for each buf_ord-doc-rcv no-lock
     1500         where buf_ord-doc-rcv.obj-type  = obj-list.obj-type
     1501           and buf_ord-doc-rcv.obj-code  = obj-list.obj-code
     1502           and buf_ord-doc-rcv.status_   = 'факт':U
     1503           and buf_ord-doc-rcv.fact-order >= v-fact-order-start
     1504           and buf_ord-doc-rcv.fact-order < v-fact-order-end
     1505         :
     1506         case p-post :
     1507           when 2 then do:
     1508             if buf_ord-doc-rcv.doc-type <> "in":U then next .
     1509           end.
     1510           when 3 then do:
     1511             if buf_ord-doc-rcv.doc-type <> "out":U then next .
     1512           end.
     1513           when 4 then do:
     1514             if buf_ord-doc-rcv.doc-type <> "out":U then next .
     1515             find buf_clients no-lock
     1516               where buf_clients.obj-type = buf_ord-doc-rcv.cli-type
     1517                 and buf_clients.obj-code = buf_ord-doc-rcv.cli-code .
     1518             if not can-do( p_cli-list, string( recid( buf_clients ) ) ) then next.
     1519           end.
     1520           otherwise do:
     1521           end.
     1522         end case.
     1523         assign
     1524           PrnNum = no
     1525           sum-doc-val-post = 0
     1526           sum-doc-val-nakl = 0
     1527           v-date-post      = buf_ord-doc-rcv.ship-date
     1528           v-time-post      = string(buf_ord-doc-rcv.ship-time, "HH:MM")
     1529           v-time-nakl      = string(buf_ord-doc-rcv.fact-ship-time, "HH:MM")
     1530         .
     1531         assign
     1532           v-val-nakl  = 0
     1533           v-cost-nakl = 0
     1534         .
     1535         for each temp-gds : delete temp-gds. end.
     1536         for each buf_ord-line-rcv no-lock
     1537           where buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
     1538             and buf_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code
     1539           :
     1540           assign Counter = Counter + 1.
     1541   IF ( Counter modulo v-account = 0 )  then DO:
     1542             if  log-manager:logfile-name ne ?
     1543             then DO:
     1544                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1545             end.
     1546              if mFrameView
     1547              then do:
     1548               DISPLAY
     1549                 Counter @ RecordsDone
     1550                 WITH FRAME InfoFrame.
     1551              end.
     1552   End.
     1553      if v-button-stop then  DO:
     1554            if mFrameView
     1555            then
     1556               PROCESS EVENTS.
     1557            IF StopProcessing THEN DO:
     1558            RETURN error.
     1559            End.
     1560      end.
     1561           if x-SelectGood <> 1 then do:
     1562             find first gds-list
     1563               where gds-list.artic     = buf_ord-line-rcv.artic
     1564                 and gds-list.prod-type = buf_ord-line-rcv.prod-type
     1565                 and gds-list.prod-code = buf_ord-line-rcv.prod-code
     1566             no-error .
     1567             if not available gds-list then next.
     1568           end.
     1569           find first buf_goods  no-lock
     1570             where buf_goods.artic     = buf_ord-line-rcv.artic
     1571               and buf_goods.prod-type = buf_ord-line-rcv.prod-type
     1572               and buf_goods.prod-code = buf_ord-line-rcv.prod-code
     1573           no-error .
     1574           if not available buf_goods then do:
     1575             message vss-workfile + ". Не найден товар с артикулом " + buf_ord-line-rcv.artic view-as alert-box error.
     1576             next .
     1577           end.
     1578           create temp-gds .
     1579           assign
     1580             temp-gds.unit      = buf_goods.unit-base
     1581             temp-gds.gds-name  = buf_goods.gds-name
     1582             temp-gds.gds-code  = buf_goods.gds-code
     1583             temp-gds.artic     = buf_ord-line-rcv.artic
     1584             temp-gds.prod-type = buf_ord-line-rcv.prod-type
     1585             temp-gds.prod-code = buf_ord-line-rcv.prod-code
     1586             temp-gds.qnty1     = buf_ord-line-rcv.qnty
     1587           .
     1588           if x-SET_val_TYPE = 1 then assign temp-gds.price1 = buf_ord-line-rcv.price-rubl .
     1589           else                       assign temp-gds.price1 = buf_ord-line-rcv.price-base .
     1590           assign temp-gds.sum1 = buf_ord-line-rcv.qnty * temp-gds.price1 .
     1591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1592     (input  buf_goods.gds-code
     1593     ,input  ?
     1594     ,output temp-gds.b-code
     1595     ) no-error .
     1596    .
     1597           if error-status:error then do:
     1598             message vss-workfile + ". Не найден бар-код товара " + buf_goods.artic view-as alert-box error.
     1599             next .
     1600           end.
     1601         end.
     1602         find first temp-gds no-error .
     1603         if not available temp-gds then next .
     1604         for each ub.ord-chain no-lock
     1605           where ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code
     1606             and ub.ord-chain.doc-type = 'rcv'
     1607             and ub.ord-chain.rel-doc-type = 'trn'
     1608           :
     1609           find first buf_trn-doc no-lock where buf_trn-doc.doc-code  = ub.ord-chain.rel-doc-code no-error .
     1610           if not available buf_trn-doc then next.
     1611           if buf_ord-doc-rcv.doc-type = "in":U then do:
     1612             find first buf1_trn-doc no-lock where buf1_trn-doc.out-code  = buf_trn-doc.doc-code no-error .
     1613             if available buf1_trn-doc then do:
     1614               if p-otkl = 3 or p-otkl = 4 then do:
     1615                 run cmptime-time-diff ( buf1_trn-doc.fact-date, buf_ord-doc-rcv.fact-ship-time, buf_ord-doc-rcv.ship-date, buf_ord-doc-rcv.ship-time,output v-difference) .
     1616                 if p-time >= ABSOLUTE( v-difference ) then next .
     1617               end.
     1618               assign v-date-nakl = buf1_trn-doc.fact-date  .
     1619               run CreateGoods (input buf1_trn-doc.doc-code) .
     1620             end.
     1621           end.
     1622           else do:
     1623             if p-otkl = 3 or p-otkl = 4 then do:
     1624               run cmptime-time-diff ( buf_trn-doc.fact-date, buf_ord-doc-rcv.fact-ship-time, buf_ord-doc-rcv.ship-date, buf_ord-doc-rcv.ship-time,output v-difference) .
     1625               if p-time >= ABSOLUTE( v-difference ) then next .
     1626             end.
     1627             assign v-date-nakl = buf_trn-doc.fact-date  .
     1628             run CreateGoods (input buf_trn-doc.doc-code) .
     1629           end.
     1630         end.
     1631         for each temp-gds :
     1632           if p-otkl = 2 or p-otkl = 4 then do:
     1633             if ABSOLUTE((( temp-gds.qnty1 - temp-gds.qnty2 ) * 100 / temp-gds.qnty1 )) <= p-proc then next .
     1634           end.
     1635           if PrnObj = no then do:
     1636             assign
     1637               PrnObj = yes
     1638               v-goods-name = string( " Объект: " + obj-list.obj-name)
     1639             .
     1640             display stream PrnLibStream  sym1  v-goods-name  sym13  with frame f-doc.
     1641             down stream PrnLibStream with frame f-doc .
     1642           end.
     1643           if p-tg-zay = yes then do:
     1644             if PrnNum = no then do:
     1645               assign
     1646                 PrnNum = yes
     1647                 v-goods-name = string( " Поставка " + buf_ord-doc-rcv.rcv-code + " по заказу " + buf_ord-doc-rcv.doc-code )
     1648               .
     1649               display stream PrnLibStream  sym1  v-goods-name sym13  with frame f-doc.
     1650               down stream PrnLibStream with frame f-doc .
     1651             end.
     1652           end.
     1653           assign
     1654             v-goods-artic   = temp-gds.artic
     1655             v-goods-name    = temp-gds.gds-name
     1656             v-goods-unit    = temp-gds.unit
     1657             v-bar-code      = temp-gds.b-code
     1658             v-val-post      = temp-gds.qnty1
     1659             v-cost-post     = temp-gds.price1
     1660             v-val-nakl      = temp-gds.qnty2
     1661             v-cost-nakl     = temp-gds.sum2 / temp-gds.qnty2
     1662             sum-doc-val-post = sum-doc-val-post + v-val-post
     1663             sum-doc-val-nakl = sum-doc-val-nakl + v-val-nakl
     1664             sum-obj-val-post = sum-obj-val-post + v-val-post
     1665             sum-obj-val-nakl = sum-obj-val-nakl + v-val-nakl
     1666             sum-all-val-post = sum-all-val-post + v-val-post
     1667             sum-all-val-nakl = sum-all-val-nakl + v-val-nakl
     1668           .
     1669           display stream PrnLibStream
     1670             sym1  v-bar-code
     1671             sym2  v-goods-artic
     1672             sym3  v-goods-name
     1673             sym4  v-goods-unit
     1674             sym5  v-val-post
     1675             sym6  v-date-post
     1676             sym7  v-time-post
     1677             sym8  v-cost-post
     1678             sym9  v-val-nakl
     1679             sym10 v-date-nakl
     1680             sym11 v-time-nakl
     1681             sym12 v-cost-nakl
     1682             sym13
     1683           with frame f-doc.
     1684           down stream PrnLibStream with frame f-doc .
     1685         end.
     1686         if p-tg-zay = yes then do:
     1687           if PrnNum = yes then do:
     1688             assign
     1689               v-goods-name = "Всего по поставке:"
     1690               v-val-post   = sum-doc-val-post
     1691               v-val-nakl   = sum-doc-val-nakl
     1692             .
     1693             display stream PrnLibStream
     1694               sym1
     1695               sym2
     1696               sym3   v-goods-name
     1697               sym4
     1698               sym5   v-val-post
     1699               sym6
     1700               sym7
     1701               sym8
     1702               sym9   v-val-nakl
     1703               sym10
     1704               sym11
     1705               sym12
     1706               sym13
     1707             with frame f-doc.
     1708             down stream PrnLibStream with frame f-doc .
     1709           end.
     1710         end.
     1711       end.
     1712       if PrnObj = yes then do:
     1713         assign
     1714           v-goods-name = "Всего по объекту:"
     1715           v-val-post   = sum-obj-val-post
     1716           v-val-nakl   = sum-obj-val-nakl
     1717         .
     1718         display stream PrnLibStream sym1 sym2 sym3   v-goods-name sym4 sym5   v-val-post sym6 sym7 sym8 sym9   v-val-nakl sym10 sym11 sym12 sym13 with frame f-doc.
     1719         down stream PrnLibStream with frame f-doc .
     1720         display stream PrnLibStream  sym1   sym13  with frame f-doc.
     1721         down stream PrnLibStream with frame f-doc .
     1722       end.
     1723     end.
     1724     assign
     1725       v-goods-name = "ИТОГО:"
     1726       v-val-post   = sum-all-val-post
     1727       v-val-nakl   = sum-all-val-nakl
     1728     .
     1729     display stream PrnLibStream sym1 sym2 sym3   v-goods-name sym4 sym5   v-val-post sym6 sym7 sym8 sym9   v-val-nakl sym10 sym11 sym12 sym13 with frame f-doc.
     1730     down stream PrnLibStream with frame f-doc .
     1731     PUT STREAM PrnLibStream Line format "X(196)".
     1732     HIDE stream PrnLibStream FRAME BottomFrame .
     1733     OUTPUT stream PrnLibStream CLOSE.
     1734   if mFrameView
     1735   then do:
     1736      HIDE FRAME InfoFrame.
     1737   end.
     1738   if session :set-wait-state( "" ) then.
     1739     run prn-lib-prn-file in this-procedure (input parParentProc,input 8).
     1740   END.
     1741   procedure CreateGoods :
     1742     do on error undo, return error return-value :
     1743     define input  parameter p-code as character no-undo .
     1744       define buffer buf_doc-line for ub.doc-line.
     1745       for each buf_doc-line no-lock where buf_doc-line.doc-code = p-code :
     1746         find first temp-gds
     1747             where temp-gds.artic     = buf_doc-line.artic
     1748               and temp-gds.prod-type = buf_doc-line.prod-type
     1749               and temp-gds.prod-code = buf_doc-line.prod-code
     1750         no-error .
     1751         if not available temp-gds then next.
     1752         if x-SET_val_TYPE = 1 then assign temp-gds.sum2 = temp-gds.sum2 + buf_doc-line.price-rubl * buf_doc-line.fact-qnty  .
     1753         else                       assign temp-gds.sum2 = temp-gds.sum2 + buf_doc-line.price-base * buf_doc-line.fact-qnty  .
     1754         assign temp-gds.qnty2 = temp-gds.qnty2 + buf_doc-line.fact-qnty .
     1755       end.
     1756     end.
     1757   end procedure.
