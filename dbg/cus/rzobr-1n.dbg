     1721    ostatok-end [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1722    b1-ostatok-end [1 + 0] =  b1-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1723    b1-ostatok-end [2 + 0] =  b1-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1724    b1-ostatok-end [3 + 0] =  b1-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1725    b2-ostatok-end [1 + 0] =  b2-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1726    b2-ostatok-end [2 + 0] =  b2-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1727    b2-ostatok-end [3 + 0] =  b2-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1728    .
     1729    assign
     1730     bi-ostatok-end [1 + 0] =  bi-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1731     bi-ostatok-end [2 + 0] =  bi-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1732     bi-ostatok-end [3 + 0] =  bi-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1733    .
     1734   If  xshowcrsa or vat-crsa Then DO:
     1735   run ost-line in this-procedure
     1736                  (input   x-store-code  ,
     1737                   input   x-store-type  ,
     1738                   input   gds-zap-artic     ,
     1739                   input   gds-zap-prod-code ,
     1740                   input   gds-zap-prod-type ,
     1741                   input   x-tog-shift       ,
     1742                   input   Fact-order-2               ,
     1743                   input   'crsa':U            ,
     1744                   input   '##,##':U    ,
     1745                   input   xtog-obj    ,
     1746                   output  quantity    ,
     1747                   output  coast_r     ,
     1748                   output  coast_v     ,
     1749                   output  vat_r       ,
     1750                   output  vat_v       ,
     1751                   output  slt_r       ,
     1752                   output  slt_v       ).
     1753   assign
     1754     ostatok-end [4]        = round(ostatok-end [1] *  p-price-med , 2)
     1755    ostatok-end [2 + 3]   = if tprintrubl then coast_r else coast_v
     1756    ostatok-end [3 + 3]   = if tprintrubl then vat_r   else vat_v
     1757    b1-ostatok-end [1 + 3] =  b1-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1758    b1-ostatok-end [2 + 3] =  b1-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1759    b1-ostatok-end [3 + 3] =  b1-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1760    b2-ostatok-end [1 + 3] =  b2-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1761    b2-ostatok-end [2 + 3] =  b2-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1762    b2-ostatok-end [3 + 3] =  b2-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1763    .
     1764    assign
     1765     bi-ostatok-end [1 + 3] =  bi-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1766     bi-ostatok-end [2 + 3] =  bi-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1767     bi-ostatok-end [3 + 3] =  bi-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1768    .
     1769      End.
     1770   If xshowsale or vat-sale Then DO:
     1771   run ost-line in this-procedure
     1772                  (input   x-store-code  ,
     1773                   input   x-store-type  ,
     1774                   input   gds-zap-artic     ,
     1775                   input   gds-zap-prod-code ,
     1776                   input   gds-zap-prod-type ,
     1777                   input   x-tog-shift       ,
     1778                   input   Fact-order-2               ,
     1779                   input   'crsa':U            ,
     1780                   input   '##,##':U    ,
     1781                   input   xtog-obj    ,
     1782                   output  quantity    ,
     1783                   output  coast_r     ,
     1784                   output  coast_v     ,
     1785                   output  vat_r       ,
     1786                   output  vat_v       ,
     1787                   output  slt_r       ,
     1788                   output  slt_v       ).
     1789   assign
     1790     ostatok-end [1 + 6]   = quantity
     1791    ostatok-end [2 + 6]   = if tprintrubl then coast_r else coast_v
     1792    ostatok-end [3 + 6]   = if tprintrubl then vat_r   else vat_v
     1793    ostatok-end [10]        = if tprintrubl then slt_r   else slt_v
     1794    b1-ostatok-end [1 + 6] =  b1-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1795    b1-ostatok-end [2 + 6] =  b1-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1796    b1-ostatok-end [3 + 6] =  b1-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1797    b2-ostatok-end [1 + 6] =  b2-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1798    b2-ostatok-end [2 + 6] =  b2-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1799    b2-ostatok-end [3 + 6] =  b2-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1800    b1-ostatok-end [10] =  b1-ostatok-end [10] + ostatok-end [10]
     1801    b2-ostatok-end [10] =  b2-ostatok-end [10] + ostatok-end [10]
     1802    .
     1803    assign
     1804     bi-ostatok-end [1 + 6] =  bi-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1805     bi-ostatok-end [2 + 6] =  bi-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1806     bi-ostatok-end [3 + 6] =  bi-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1807     bi-ostatok-end [10] =  bi-ostatok-end [10] + ostatok-end [10]
     1808    .
     1809      End.
     1810       case  gds-zap-type :
     1811       when 'у':U THEN DO:
     1812         run ob-line (
     1813             input   x-store-code   ,
     1814             input   x-store-type   ,
     1815             INPUT   gds-zap-artic       ,
     1816             INPUT   gds-zap-prod-code   ,
     1817             INPUT   gds-zap-prod-type   ,
     1818             INPUT   Fact-order-1,
     1819             INPUT   Fact-order-2,
     1820             input   'cssr':U    ,
     1821             input   '##,##':U,
     1822             input   ""    ,
     1823             input   xTog-obj) .
     1824        End.
     1825       when 'т':U THEN DO:
     1826         run ob-line (
     1827             input   x-store-code   ,
     1828             input   x-store-type   ,
     1829             INPUT   gds-zap-artic       ,
     1830             INPUT   gds-zap-prod-code   ,
     1831             INPUT   gds-zap-prod-type   ,
     1832             INPUT   Fact-order-1,
     1833             INPUT   Fact-order-2,
     1834             input   'cost':U    ,
     1835             input   '##,##':U,
     1836             input   ""    ,
     1837             input   xTog-obj) .
     1838         End.
     1839         End case.
     1840      run calc-sub-itog (0).
     1841     If xshowcrsa OR  xshowsale or vat-crsa or vat-sale Then DO:
     1842       case  gds-zap-type :
     1843       when 'у':U THEN DO:
     1844         run ob-line (
     1845             input   x-store-code   ,
     1846             input   x-store-type   ,
     1847             INPUT   gds-zap-artic       ,
     1848             INPUT   gds-zap-prod-code   ,
     1849             INPUT   gds-zap-prod-type   ,
     1850             INPUT   Fact-order-1,
     1851             INPUT   Fact-order-2,
     1852             input   'cgsr':U    ,
     1853             input   '##,##':U,
     1854             input   ""    ,
     1855             input   xTog-obj) .
     1856        End.
     1857       when 'т':U THEN DO:
     1858         run ob-line (
     1859             input   x-store-code   ,
     1860             input   x-store-type   ,
     1861             INPUT   gds-zap-artic       ,
     1862             INPUT   gds-zap-prod-code   ,
     1863             INPUT   gds-zap-prod-type   ,
     1864             INPUT   Fact-order-1,
     1865             INPUT   Fact-order-2,
     1866             input   'crsa':U    ,
     1867             input   '##,##':U,
     1868             input   ""    ,
     1869             input   xTog-obj) .
     1870         End.
     1871             End case.
     1872        run calc-sub-itog (3).
     1873        End.
     1874     If xshowsale  Then DO:
     1875       case  gds-zap-type :
     1876       when 'у':U THEN DO:
     1877         run ob-line (
     1878             input   x-store-code   ,
     1879             input   x-store-type   ,
     1880             INPUT   gds-zap-artic       ,
     1881             INPUT   gds-zap-prod-code   ,
     1882             INPUT   gds-zap-prod-type   ,
     1883             INPUT   Fact-order-1,
     1884             INPUT   Fact-order-2,
     1885             input   'sasr':U    ,
     1886             input   '##,##':U,
     1887             input   ""    ,
     1888             input   xTog-obj) .
     1889        End.
     1890       when 'т':U THEN DO:
     1891         run ob-line (
     1892             input   x-store-code   ,
     1893             input   x-store-type   ,
     1894             INPUT   gds-zap-artic       ,
     1895             INPUT   gds-zap-prod-code   ,
     1896             INPUT   gds-zap-prod-type   ,
     1897             INPUT   Fact-order-1,
     1898             INPUT   Fact-order-2,
     1899             input   'sale':U    ,
     1900             input   '##,##':U,
     1901             input   ""    ,
     1902             input   xTog-obj) .
     1903         End.
     1904             End case.
     1905        run calc-sub-itog (6).
     1906        End.
     1907   END PROCEDURE.
     1908   PROCEDURE display-line :
     1909        i = i + 1.
     1910           if NOT( NOT Show-Negativ-2 and
     1911            ( prih         [1]   = 0 AND
     1912             rash          [1]   = 0 AND
     1913             kassa         [1]   = 0 AND
     1914             Inv           [1]   = 0 AND
     1915             Overturn      [1]   = 0 AND
     1916             Overturn      [5]   = 0 AND
     1917             Overturn      [8]   = 0 ) ) then DO:
     1918           IF  NOT (NOT Show-Negativ  AND (
     1919                 prih          [1]   = 0 AND
     1920                 rash          [1]   = 0 AND
     1921                 kassa         [1]   = 0 AND
     1922                 Inv           [1]   = 0 AND
     1923                 Overturn      [1]   = 0 AND
     1924                 Overturn      [5]   = 0 AND
     1925                 ostatok-start [1]   = 0 AND
     1926                 ostatok-End   [1]   = 0   )) then DO:
     1927           IF NOT Sums-Only then DO:
     1928               if fr0 = true then do:
     1929                 PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     1930                 if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     1931                 fr0 = false .
     1932               end.
     1933               if fr = true then dO:
     1934                 PUT stream OutStream space(10) temp-str format "X(100)" SKIP.
     1935                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) String(temp-str) skip.
     1936                 fr = false .
     1937               end.
     1938              run display-str1 in this-procedure.
     1939             End.
     1940           End.
     1941        END.
     1942     END PROCEDURE.
     1943   PROCEDURE print-header :
     1944   if NOT FirstLine Then DO:
     1945      run display-title.
     1946      FORM with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1947   End.
     1948    FirstLine = TRUE .
     1949       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     1950             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name)  AT 30 format "X(170)" SKIP.
     1951             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + CAPS(clients.obj-name) format "X(170)" SKIP.
     1952         End.
     1953         run clear-b1 .
     1954         run clear-b2.
     1955         run clear-bi .
     1956         break_group = true.
     1957         break_group1 = true.
     1958      END PROCEDURE.
     1959   PROCEDURE Print-Footer :
     1960         If RetClassify = "no-classify":U  then run u-line.
     1961          gds-zap-artic = "ИТОГО" .
     1962          run display-bi.
     1963          run u-line.
     1964          END PROCEDURE.
     1965   PROCEDURE U-LINE :
     1966   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1967           s-bar-code
     1968           gds-zap-artic
     1969           gds-zap-gds-name
     1970           gds-zap-unit-base
     1971           gds-type
     1972           F-ostatok-start
     1973           F-Prih
     1974           F-Rash
     1975           F-KAssa
     1976           F-Inv
     1977           F-Overturn
     1978           F-ostatok-end
     1979           gds-zap-other
     1980           with FRAME ZAPAS .
     1981           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1982           END PROCEDURE.
     1983   PROCEDURE P-LINE :
     1984   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1985           gds-zap-artic
     1986           gds-zap-gds-name
     1987           gds-zap-unit-base
     1988           gds-type
     1989           F-ostatok-start
     1990           F-Prih
     1991           F-Rash
     1992           F-KAssa
     1993           F-Inv
     1994           F-Overturn
     1995           F-ostatok-end
     1996           gds-zap-other
     1997           with FRAME ZAPAS .
     1998           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1999           END PROCEDURE.
     2000   procedure run1 :
     2001          case select-good :
     2002           when 1  then do:
     2003   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2004   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2005       for each gds-obj  where
     2006             gds-obj.obj-type = x-store-type  and
     2007             gds-obj.obj-code = x-store-code
     2008             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2009                   no-lock,
     2010             First goods  where  gds-obj.gds-code   = goods.gds-code
     2011   no-lock
     2012   BREAK
     2013       BY (temp-gds-list.artic) :
     2014         run item-goods ( "1" , "goods" ) .
     2015         if return-value <> "" then NEXT.
     2016       End.
     2017     END.
     2018     Else DO:
     2019      For each obj-list no-lock :
     2020                     FOR EACH gds-obj where
     2021                   gds-obj.obj-type = obj-list.obj-type    and
     2022                   gds-obj.obj-code = obj-list.obj-code
     2023                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2024                   no-lock :
     2025                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2026                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2027                       Create temp-gds-list.
     2028                       Assign
     2029                         temp-gds-list.prod-code = gds-obj.prod-code
     2030                         temp-gds-list.grp-name  = gds-obj.grp-name
     2031                         temp-gds-list.gds-name  = goods.gds-name
     2032                         temp-gds-list.gds-code  = gds-obj.gds-code
     2033                         temp-gds-list.artic     = gds-obj.artic
     2034                       .
     2035                   End.
     2036               End.
     2037     End.
     2038     for each temp-gds-list no-lock
     2039       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2040         BREAK
     2041       BY temp-gds-list.artic :
     2042       run item-goods ( "1" , "goods" ) .
     2043         if return-value <> "" then NEXT.
     2044     End.
     2045   End.
     2046     end.
     2047           when 2  then do:
     2048   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2049     if x-selectobject = "currency":u  or  xtog-obj then do:
     2050         for  each gds-obj
     2051                     where gds-obj.obj-code   = x-store-code
     2052                      and  gds-obj.obj-type   = x-store-type
     2053                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2054                           no-lock ,
     2055                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2056                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     2057                     break
     2058                     by temp-gds-list.artic :
     2059                     run item-goods ( input "1" , input "goods" ) .
     2060                     if return-value <> "" then next.
     2061         end.
     2062     end.
     2063     else do:
     2064         for each obj-list no-lock :
     2065               for  each gds-obj
     2066                 where  gds-obj.obj-code   = obj-list.obj-code
     2067                   and  gds-obj.obj-type   = obj-list.obj-type
     2068                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2069                 no-lock ,
     2070                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2071                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     2072                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2073                           create temp-gds-list.
     2074                           assign
     2075                             temp-gds-list.prod-code = gds-obj.prod-code
     2076                             temp-gds-list.grp-name  = gds-obj.grp-name
     2077                             temp-gds-list.gds-name  = goods.grp-name
     2078                             temp-gds-list.gds-code  = gds-obj.gds-code
     2079                             temp-gds-list.artic     = gds-obj.artic
     2080                           .
     2081                       end.
     2082               end.
     2083       end.
     2084     for each temp-gds-list no-lock
     2085       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2086         break
     2087       by temp-gds-list.artic :
     2088       run item-goods ( "1" , "goods" ) .
     2089         if return-value <> "" then next.
     2090     end.
     2091   end.
     2092     end.
     2093           when 3 then do:
     2094   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2095   if x-selectobject = "currency":u  or  xtog-obj then do:
     2096     for  each gds-obj
     2097         where  gds-obj.obj-code   = x-store-code
     2098           and  gds-obj.obj-type   = x-store-type
     2099                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2100                 no-lock ,
     2101     first g#cli
     2102           where gds-obj.prod-code  = g#cli.obj-code
     2103           and  gds-obj.prod-type   = g#cli.obj-type
     2104           no-lock,
     2105     first goods
     2106           where gds-obj.gds-code = goods.gds-code no-lock
     2107           break
     2108           by temp-gds-list.artic :
     2109           run item-goods ( "1" , "goods" ) .
     2110           if return-value <> "" then next.
     2111         end.
     2112     end.
     2113     else do:
     2114       for each obj-list no-lock :
     2115             for  each gds-obj
     2116               where  gds-obj.obj-code   = obj-list.obj-code
     2117                 and  gds-obj.obj-type   = obj-list.obj-type
     2118                       and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2119                       no-lock ,
     2120             first g#cli
     2121                 where gds-obj.prod-code  = g#cli.obj-code
     2122                 and  gds-obj.prod-type   = g#cli.obj-type
     2123                 no-lock,
     2124             first goods
     2125                 where gds-obj.gds-code = goods.gds-code no-lock :
     2126                   if not can-find (first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2127                       create temp-gds-list.
     2128                       assign
     2129                         temp-gds-list.prod-code = gds-obj.prod-code
     2130                         temp-gds-list.grp-name  = gds-obj.grp-name
     2131                         temp-gds-list.gds-name  = goods.gds-name
     2132                         temp-gds-list.gds-code  = gds-obj.gds-code
     2133                         temp-gds-list.artic     = gds-obj.artic
     2134                       .
     2135                   end.
     2136             end.
     2137       end.
     2138         for each temp-gds-list no-lock
     2139           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2140             break
     2141               by temp-gds-list.artic :
     2142           run item-goods ( "1" , "goods" ) .
     2143             if return-value <> "" then next.
     2144         end.
     2145   end.
     2146     end.
     2147           otherwise do:
     2148   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2149   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2150       for each gds-obj  where
     2151             gds-obj.obj-type = x-store-type  and
     2152             gds-obj.obj-code = x-store-code
     2153             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2154                   no-lock,
     2155             First goods  where  gds-obj.gds-code   = goods.gds-code
     2156         no-lock,
     2157   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2158   no-lock
     2159   BREAK
     2160       BY (gds-list.artic) :
     2161         run item-goods ( "1" , "gds-list" ) .
     2162         if return-value <> "" then NEXT.
     2163       End.
     2164     END.
     2165     Else DO:
     2166      For each obj-list no-lock :
     2167                     FOR EACH gds-obj where
     2168                   gds-obj.obj-type = obj-list.obj-type    and
     2169                   gds-obj.obj-code = obj-list.obj-code
     2170                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2171                   no-lock,
     2172             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2173                   no-lock :
     2174                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2175                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2176                       Create temp-gds-list.
     2177                       Assign
     2178                         temp-gds-list.prod-code = gds-obj.prod-code
     2179                         temp-gds-list.grp-name  = gds-obj.grp-name
     2180                         temp-gds-list.gds-name  = goods.gds-name
     2181                         temp-gds-list.gds-code  = gds-obj.gds-code
     2182                         temp-gds-list.artic     = gds-obj.artic
     2183                       .
     2184                   End.
     2185               End.
     2186     End.
     2187     for each temp-gds-list no-lock
     2188       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2189         BREAK
     2190       BY gds-list.artic :
     2191       run item-goods ( "1" , "gds-list" ) .
     2192         if return-value <> "" then NEXT.
     2193     End.
     2194   End.
     2195           end.
     2196          end case.
     2197   end procedure.
     2198   PROCEDURE CalcItog :
     2199       run ostatok (
     2200           input x-store-code  ,
     2201           input x-store-type  ,x-TOG-Shift,
     2202           input x-date-start - 1 ,
     2203           input date('')      , x-Shift-Start,x-Shift-End,
     2204           input 'crsa':U   ,
     2205           input '##,##':U,
     2206           input xTog-obj ,
     2207           output  Quantity1  ,
     2208           output  Coast_R1   ,
     2209           output  Coast_V1   ,
     2210           output  VAT_R1     ,
     2211           output  VAT_V1     ,
     2212           output  Fact-order-1 ).
     2213       run ostatok (
     2214           input x-store-code  ,
     2215           input x-store-type  , x-TOG-Shift,
     2216           input x-date-start  ,
     2217           input x-date-end    , x-Shift-Start,x-Shift-End,
     2218           input 'crsa':U   ,
     2219           input '##,##':U,
     2220           input xTog-obj ,
     2221           output  Quantity1  ,
     2222           output  Coast_R1   ,
     2223           output  Coast_V1   ,
     2224           output  VAT_R1     ,
     2225           output  VAT_V1     ,
     2226           output  Fact-order-2 ).
     2227             Quantity1  = 0.
     2228             Coast_R1   = 0.
     2229             Coast_V1   = 0.
     2230             VAT_R1     = 0.
     2231             VAT_V1     = 0.
     2232   END PROCEDURE.
     2233   PROCEDURE display-str1  :
     2234              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2235            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2236            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2237            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     2238            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2239            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     2240            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     2241   end procedure.
     2242   procedure display-bi  :
     2243              run di-qnty("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     2244            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     2245            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     2246            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bi":u).  end.
     2247            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bi":u ). end.
     2248            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bi":u ).  end.
     2249            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bi":u ).  end.
     2250   END PROCEDURE.
     2251   PROCEDURE display-Bo  :
     2252              run di-qnty("кол-во",1,  "", "ИТОГО ПО" ,"ОБЪЕКТАМ" ,"", "bo":u).
     2253            if xshowcost    then do: run di ("учет." , 2 , "","", "", "", "bo":u).  end.
     2254            if xshowcrsa    then do: run di ("прод." , 5, "","", "", "",  "bo":u).  end.
     2255            if xshowsale    then do: run di ("док." , 8, "","", "", "",  "bo":u).  end.
     2256            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","bo":u ). end.
     2257            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","bo":u ).  end.
     2258            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","bo":u ).  end.
     2259   end procedure.
     2260   PROCEDURE display-B1  :
     2261         if NOT( NOT Show-Negativ-2 and
     2262            ( b1-prih         [1]   = 0 AND
     2263              b1-rash          [1]   = 0 AND
     2264              b1-kassa         [1]   = 0 AND
     2265              b1-Inv           [1]   = 0 AND
     2266              b1-Overturn      [1]   = 0 AND
     2267              b1-Overturn      [5]   = 0 AND
     2268              b1-Overturn      [8]   = 0 ) ) then DO:
     2269           IF  NOT (NOT Show-Negativ  AND (
     2270                 b1-prih          [1]   = 0 AND
     2271                 b1-rash          [1]   = 0 AND
     2272                 b1-kassa         [1]   = 0 AND
     2273                 b1-Inv           [1]   = 0 AND
     2274                 b1-Overturn      [1]   = 0 AND
     2275                 b1-Overturn      [5]   = 0 AND
     2276                 b1-ostatok-start [1]   = 0 AND
     2277                 b1-ostatok-End   [1]   = 0   )) then DO:
     2278                 if Sums-Only THEN do:
     2279                     if fr0 = true then do:
     2280                         PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     2281                         if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     2282                         fr0 = false .
     2283                       end.
     2284                  end.
     2285           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2286           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2287           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2288           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2289           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2290           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2291           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2292          if not sums-only then run p-line.
     2293    End.
     2294    end.
     2295   END PROCEDURE.
     2296   PROCEDURE display-B2  :
     2297        if NOT( NOT Show-Negativ-2 and
     2298            ( b2-prih         [1]   = 0 AND
     2299              b2-rash          [1]   = 0 AND
     2300              b2-kassa         [1]   = 0 AND
     2301              b2-Inv           [1]   = 0 AND
     2302              b2-Overturn      [1]   = 0 AND
     2303              b2-Overturn      [5]   = 0 AND
     2304              b2-Overturn      [8]   = 0 ) ) then DO:
     2305           IF  NOT (NOT Show-Negativ  AND (
     2306                 b2-prih          [1]   = 0 AND
     2307                 b2-rash          [1]   = 0 AND
     2308                 b2-kassa         [1]   = 0 AND
     2309                 b2-Inv           [1]   = 0 AND
     2310                 b2-Overturn      [1]   = 0 AND
     2311                 b2-Overturn      [5]   = 0 AND
     2312                 b2-ostatok-start [1]   = 0 AND
     2313                 b2-ostatok-End   [1]   = 0   )) then DO:
     2314           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     2315           if xshowcost    then do: run di ("учет.", 2, "","", "", "", "b2":u).  end.
     2316           if xshowcrsa    then do: run di ("прод.", 5 ,"","", "", "", "b2":u).  end.
     2317           if xshowsale    then do: run di ("док.", 8 ,"","", "", "", "b2":u).  end.
     2318            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","b2":u ). end.
     2319            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","b2":u ).  end.
     2320            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","b2":u ).  end.
     2321    End.
     2322   end.
     2323   END PROCEDURE.
     2324   PROCEDURE Clear-B1  :
     2325    b1-gds-zap-other           = 0.
     2326    REPEAT kk = 1 to 9 :
     2327    Assign
     2328       b1-Prih                                            [kk]    = 0
     2329       b1-Rash                                            [kk]    = 0
     2330       b1-KAssa                                           [kk]    = 0
     2331       b1-Inv                                             [kk]    = 0
     2332       b1-Overturn                                        [kk]    = 0
     2333       b1-ostatok-end                                     [kk]    = 0
     2334       b1-ostatok-start                                   [kk]    = 0   .
     2335      End.
     2336    END PROCEDURE.
     2337   PROCEDURE Clear-B2  :
     2338    b2-gds-zap-other           = 0.
     2339    REPEAT kk = 1 to 9 :
     2340    Assign
     2341       b2-Prih                                            [kk]    = 0
     2342       b2-Rash                                            [kk]    = 0
     2343       b2-KAssa                                           [kk]    = 0
     2344       b2-Inv                                             [kk]    = 0
     2345       b2-Overturn                                        [kk]    = 0
     2346       b2-ostatok-end                                     [kk]    = 0
     2347       b2-ostatok-start                                   [kk]    = 0   .
     2348      End.
     2349   END PROCEDURE.
     2350   PROCEDURE Clear-Bi  :
     2351    bi-gds-zap-other           = 0.
     2352    REPEAT kk = 1 to 9 :
     2353    Assign
     2354       bi-Prih                                            [kk]    = 0
     2355       bi-Rash                                            [kk]    = 0
     2356       bi-KAssa                                           [kk]    = 0
     2357       bi-Inv                                             [kk]    = 0
     2358       bi-Overturn                                        [kk]    = 0
     2359       bi-ostatok-end                                     [kk]    = 0
     2360       bi-ostatok-start                                   [kk]    = 0   .
