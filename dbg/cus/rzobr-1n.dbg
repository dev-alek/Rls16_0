     2362   END PROCEDURE.
     2363   PROCEDURE Display-title :
     2364   define variable v-nn as integer   no-undo .
     2365      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2366             REPORTNAME  AT 20 format "X(170)" SKIP
     2367             Trim(str1)  AT 35 format "X(75)" SKIP.
     2368        v-nn = NUM-ENTRIES(str2,chr(10)) .
     2369        Repeat i = 1 to v-nn:
     2370         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     2371        End.
     2372       i=0.
     2373          PUT stream  OutStream  UNFORMATTED  Trim(str3)  AT 35 format "X(75)" SKIP.
     2374        v-nn = NUM-ENTRIES(str4,chr(10)).
     2375        Repeat i = 1 to v-nn :
     2376         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2377        End.
     2378       i=0.
     2379        v-nn = NUM-ENTRIES(ReportHeader,chr(10)) .
     2380        Repeat i = 1 to v-nn :
     2381         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2382        End.
     2383       i=0.
     2384       run rep/extitle.p (1) .
     2385   END PROCEDURE.
     2386   PROCEDURE ob-line  :
     2387   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2388   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2389   define INPUT  parameter x-artic        like ub.ot-line.artic        no-undo.
     2390   define INPUT  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2391   define INPUT  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2392   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2393   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2394   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2395   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2396   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2397   define input  parameter xTog-obj           as log no-undo.
     2398   define variable  tt#          as   int                 no-undo.
     2399    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     2400    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     2401    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     2402     For EAch obj-list  no-lock :
     2403        FOR each ub.ot-line where
     2404                           ub.ot-line.artic         = x-artic
     2405                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2406                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2407                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     2408                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     2409                     AND   ub.ot-line.prod-code    = x-prod-code
     2410                     AND   ub.ot-line.prod-type    = x-prod-type
     2411                     AND   ub.ot-line.sum-type     = x-sum-type
     2412                       no-lock :
     2413       CASE ub.ot-line.ext-doc-type:
     2414                 WHEN        'ie':U  OR
     2415                 WHEN        're':U  OR
     2416                 WHEN        'iv':U    OR
     2417                 WHEN        'rv':U OR
     2418                 WHEN        'im':U     THEN
     2419                 DO:
     2420                 ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  ub.ot-line.fact-qnty
     2421                        prih[2 + tt#]   = prih[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2422                        prih[3 + tt#]   = prih[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2423                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2424                 End.
     2425                 WHEN       'ee':U      OR
     2426                 WHEN       'ep':U    OR
     2427                 WHEN       'ev':U     OR
     2428                 WHEN       'em':U       OR
     2429                 WHEN       'wm':U       OR
     2430                 WHEN       'we':U     THEN
     2431                 DO:
     2432                 ASSIGN  rash[1 + tt#]   = rash[1 + tt#]   +  ub.ot-line.fact-qnty
     2433                         rash[2 + tt#]   = rash[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2434                         rash[3 + tt#]   = rash[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2435                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2436                 End.
     2437                 WHEN       'es':U  OR
     2438                 WHEN       'rs':U THEN
     2439                 DO:
     2440                 ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.ot-line.fact-qnty
     2441                        kassa[2 + tt#]   = kassa[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2442                        kassa[3 + tt#]   = kassa[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.VAT-base  .
     2443                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2444                 End.
     2445             WHEN  'vt':U or when 'vp':U     THEN
     2446                 DO:
     2447                 ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.ot-line.fact-qnty
     2448                       inv[2 + tt#]   = inv[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2449                       Inv[3 + tt#]   = Inv[3 + tt#]   +  if tPrintRubl then ub.ot-line.VAT-rubl Else  ub.ot-line.vat-base  .
     2450                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2451                 End.
     2452             WHEN       'ot':U THEN
     2453                 DO:
     2454                 ASSIGN Overturn[1 + tt#]   = Overturn[1 + tt#]   +  ub.ot-line.fact-qnty
     2455                       Overturn[2 + tt#]   = Overturn[2 + tt#]   +  if tPrintRubl then ub.ot-line.sum-rubl Else  ub.ot-line.sum-base
     2456                       Overturn[3 + tt#]   = Overturn[3 + tt#]   +  if tPrintRubl then ub.ot-line.vat-rubl Else  ub.ot-line.vat-base  .
     2457                 if tt# = 6 then gds-zap-other  = gds-zap-other   +   (if tPrintRubl then ub.ot-line.other-rubl  Else  ub.ot-line.other-base ) .
     2458                 End.
     2459         End CASE.
     2460      End.
     2461     END.
     2462     if tt# = 6 then DO:
     2463              ASSIGN Overturn[1 + tt#]   = (Ostatok-end[1 + tt#]  - Ostatok-start[1 + tt#] )  -  (INV[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2464                     Overturn[2 + tt#]   = (Ostatok-end[2 + tt#]  - Ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  )
     2465                     Overturn[3 + tt#]   = (Ostatok-end[3 + tt#]  - Ostatok-start[3 + tt#] )  -  (Inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2466     End.
     2467   END PROCEDURE.
     2468   procedure ost-line :
     2469     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2470     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2471     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2472     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2473     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2474     define input  parameter x-tog-shift  as logical no-undo .
     2475     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2476     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2477     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2478     define input  parameter xtog-obj     as logical no-undo .
     2479     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2480     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2481     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2482     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2483     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2484     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2485     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2486     define buffer buff-obj-list  for obj-list .
     2487     define buffer buff-stk-line  for ub.stk-line .
     2488     assign
     2489       Quantity = 0
     2490       Coast_R  = 0
     2491       Coast_V  = 0
     2492       VAT_R    = 0
     2493       VAT_V    = 0
     2494       SLT_R    = 0
     2495       SLT_V    = 0
     2496     .
     2497     if  x-tog-shift = false then do:
     2498       for each buff-obj-list no-lock
     2499       on error undo, return error
     2500       :
     2501         find last buff-stk-line no-lock
     2502           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2503             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2504             and buff-stk-line.artic      = x-artic
     2505             and buff-stk-line.prod-type  = x-prod-type
     2506             and buff-stk-line.prod-code  = x-prod-code
     2507             and buff-stk-line.sum-type   = x-sum-type
     2508             and buff-stk-line.cat-id     = '##,##':U
     2509             and buff-stk-line.fact-order <= x-fact-order
     2510             and buff-stk-line.shift-num  = 0
     2511           use-index category
     2512           no-error .
     2513         if available buff-stk-line then do:
     2514           assign
     2515             Quantity = Quantity +  buff-stk-line.fact-qnty
     2516             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2517             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2518             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2519             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2520             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2521             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2522           .
     2523         end.
     2524       end.
     2525     end.
     2526     else do:
     2527       for each buff-obj-list no-lock
     2528         where xtog-obj = false
     2529            or (buff-obj-list.obj-type = x-store-type
     2530               and buff-obj-list.obj-code = x-store-code
     2531               )
     2532       on error undo, return error
     2533       :
     2534         find last buff-stk-line no-lock
     2535           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2536             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2537             and buff-stk-line.artic      = x-artic
     2538             and buff-stk-line.prod-type  = x-prod-type
     2539             and buff-stk-line.prod-code  = x-prod-code
     2540             and buff-stk-line.sum-type   = x-sum-type
     2541             and buff-stk-line.cat-id     = '##,##':U
     2542             and buff-stk-line.fact-order <= x-fact-order
     2543             and buff-stk-line.shift-num  > 0
     2544           use-index category
     2545           no-error .
     2546         if available buff-stk-line then do:
     2547           assign
     2548             Quantity = Quantity +  buff-stk-line.fact-qnty
     2549             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2550             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2551             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2552             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2553             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2554             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2555           .
     2556         end.
     2557       end.
     2558     end.
     2559   end procedure.
     2560   procedure ost-lineother-tax :
     2561     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2562     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2563     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2564     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2565     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2566     define input  parameter x-tog-shift  as logical no-undo .
     2567     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2568     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2569     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2570     define input  parameter xTog-obj     as logical no-undo .
     2571     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2572     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2573     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2574     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2575     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2576     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2577     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2578     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2579     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2580     define buffer buff-obj-list  for obj-list .
     2581     define buffer buff-stk-line  for ub.stk-line .
     2582     assign
     2583       Quantity = 0
     2584       Coast_R  = 0
     2585       Coast_V  = 0
     2586       VAT_R    = 0
     2587       VAT_V    = 0
     2588       SLT_R    = 0
     2589       SLT_V    = 0
     2590       other_R  = 0
     2591       other_V  = 0
     2592     .
     2593     if  x-tog-shift = false then do:
     2594       for each buff-obj-list no-lock
     2595       on error undo, return error
     2596       :
     2597         find last buff-stk-line no-lock
     2598           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2599             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2600             and buff-stk-line.artic      = x-artic
     2601             and buff-stk-line.prod-type  = x-prod-type
     2602             and buff-stk-line.prod-code  = x-prod-code
     2603             and buff-stk-line.sum-type   = x-sum-type
     2604             and buff-stk-line.cat-id     = '##,##':U
     2605             and buff-stk-line.fact-order <= x-fact-order
     2606             and buff-stk-line.shift-num  = 0
     2607           use-index category
     2608           no-error .
     2609         if available buff-stk-line then do:
     2610           assign
     2611             Quantity = Quantity +  buff-stk-line.fact-qnty
     2612             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2613             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2614             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2615             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2616             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2617             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2618             other_R  = other_R  +  buff-stk-line.other-rubl
     2619             other_V  = other_V  +  buff-stk-line.other-base
     2620           .
     2621         end.
     2622       end.
     2623     end.
     2624     else do:
     2625       for each buff-obj-list no-lock
     2626         where xtog-obj = false
     2627            or (buff-obj-list.obj-type = x-store-type
     2628               and buff-obj-list.obj-code = x-store-code
     2629               )
     2630       on error undo, return error
     2631       :
     2632         find last buff-stk-line no-lock
     2633           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2634             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2635             and buff-stk-line.artic      = x-artic
     2636             and buff-stk-line.prod-type  = x-prod-type
     2637             and buff-stk-line.prod-code  = x-prod-code
     2638             and buff-stk-line.sum-type   = x-sum-type
     2639             and buff-stk-line.cat-id     = '##,##':U
     2640             and buff-stk-line.fact-order <= x-fact-order
     2641             and buff-stk-line.shift-num  > 0
     2642           use-index category
     2643           no-error .
     2644         if available buff-stk-line then do:
     2645           assign
     2646             Quantity = Quantity +  buff-stk-line.fact-qnty
     2647             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2648             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2649             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2650             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2651             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2652             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2653             other_R = other_R   +  buff-stk-line.other-rubl
     2654             other_V = other_V   +  buff-stk-line.other-base
     2655           .
     2656         end.
     2657       end.
     2658     end.
     2659   end procedure.
     2660   procedure ost-line-kg :
     2661     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2662     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2663     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2664     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2665     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2666     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2667     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2668     define buffer buff-obj-list  for obj-list .
     2669     define buffer buf_doc-line for ub.doc-line .
     2670     define buffer buf_inv-line for ub.inv-line .
     2671     do
     2672     on error undo, return error
     2673     :
     2674       for each buf_doc-line no-lock where
     2675                buf_doc-line.obj-type    = p-obj-type   and
     2676                buf_doc-line.obj-code    = p-obj-code   and
     2677                buf_doc-line.prod-type   = p-prod-type  and
     2678                buf_doc-line.prod-code   = p-prod-code  and
     2679                buf_doc-line.artic       = p-artic      and
     2680                buf_doc-line.status_     = 'факт':U      and
     2681                buf_doc-line.fact-order <= p-fact-order
     2682             by buf_doc-line.fact-order    descending
     2683       :
     2684         find first buf_inv-line no-lock where
     2685                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2686                    buf_inv-line.artic     = buf_doc-line.artic     and
     2687                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2688                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2689         if available buf_inv-line
     2690         then do:
     2691           if buf_inv-line.after-cli-qnty <> ?
     2692           then do:
     2693             assign
     2694               p-quantity-kg = buf_inv-line.after-cli-qnty
     2695             .
     2696             leave .
     2697           end.
     2698         end.
     2699       end.
     2700       if p-quantity-kg = ?
     2701       then do:
     2702         assign
     2703           p-quantity-kg = 0
     2704         .
     2705       end.
     2706     end.
     2707   end procedure.
     2708   PROCEDURE ostatok :
     2709   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2710   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2711   def input parameter x-tog-shift   as   logical             no-undo.
     2712   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2713   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2714   def input parameter x-shift-start as integer               no-undo.
     2715   def input parameter x-shift-end   as integer               no-undo.
     2716   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2717   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2718   def input parameter xTog-obj   as log no-undo.
     2719   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2720   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2721   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2722   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2723   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2724   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2725   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2726   def var              Fact-orderS   as char  no-undo.
     2727   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2728      Assign
     2729         Fact-order   = 0
     2730         Quantity     = 0
     2731         Coast_R      = 0
     2732         Coast_V      = 0
     2733         VAT_R        = 0
     2734         VAT_V        = 0 .
     2735    x-date-start-t  = x-date-start + 1 .
     2736   IF x-date-end = date('') then DO:
     2737      Fact-order = 0 .
     2738      for each obj-list
     2739          where  ( not xtog-obj or
     2740                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2741                 no-lock :
     2742         if  x-tog-shift = false then do:
     2743                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2744                               ub.stk-tot.Fact-date <=  x-date-start
     2745                               and ub.stk-tot.shift-num = 0
     2746                               USE-INDEX fact-date no-lock no-error .
     2747              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2748         End.
     2749         Else  DO :
     2750             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2751              (ub.stk-tot.shift-date  = x-date-start-t and
     2752               ub.stk-tot.shift-num  < x-shift-start or
     2753               ub.stk-tot.shift-date  < x-date-start-t  )
     2754               and ub.stk-tot.shift-num  > 0
     2755               USE-INDEX Shift-num no-lock no-error .
     2756            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2757           END.
     2758       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2759     End.
     2760   End.
     2761   Else DO:
     2762     For each obj-list  WHERE
     2763        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2764         no-lock :
     2765      IF  x-TOG-Shift = False Then DO:
     2766          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2767               ub.stk-tot.Fact-date <= x-date-end
     2768               and ub.stk-tot.shift-num = 0
     2769               USE-INDEX fact-date no-lock no-error.
     2770          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2771      END.
     2772      Else DO:
     2773           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2774               (ub.stk-tot.shift-date  = x-date-end and
     2775               ub.stk-tot.shift-num  <= x-shift-end or
     2776               ub.stk-tot.shift-date  < x-date-end       ) and
     2777               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2778               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2779       End.
     2780       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2781     End.
     2782   End.
     2783   END PROCEDURE.
     2784   PROCEDURE report-exec1  :
     2785      FIND FIRST clients where x-store-type = clients.obj-type AND
     2786                               x-store-code = clients.obj-code no-lock no-error.
     2787     run waitfram-show(clients.obj-name) .
     2788     run calcitog.
     2789     run print-header.
     2790      case retclassify :
     2791        when "no-classify":u     then run run1.
     2792        otherwise do:
     2793          message "Ошибка вызова!"  view-as alert-box error .
     2794        end.
     2795      end case.
     2796     run print-footer.
     2797     END PROCEDURE.
     2798   PROCEDURE Calc-Sub-itog :
     2799   define input parameter tt as int no-undo.
     2800   define variable b as int no-undo.
     2801   if tt = 6  then Assign
     2802     B1-gds-zap-other = B1-gds-zap-other +  gds-zap-other
     2803     B2-gds-zap-other = B2-gds-zap-other +  gds-zap-other
     2804     Bi-gds-zap-other = Bi-gds-zap-other +  gds-zap-other
     2805     Bo-gds-zap-other = Bo-gds-zap-other +  gds-zap-other
     2806     .
     2807   repeat b = 1 to 3:
     2808     Assign
     2809     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     2810     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     2811     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     2812     Bo-Prih[b + TT]    = Bo-Prih[b + TT]    +  Prih[b + TT]
     2813     Bo-ostatok-start[b + TT]    = Bo-ostatok-start[b + TT]    +  ostatok-start[b + TT]
     2814     Bo-ostatok-end[b + TT]      = Bo-ostatok-end[b + TT]      +  ostatok-end[b + TT]
     2815     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     2816     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     2817     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     2818     Bo-RAsh[b + TT]    = Bo-RAsh[b + TT]    +  RAsh[b + TT]
     2819     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     2820     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     2821     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     2822     Bo-Kassa[b + TT]    = Bo-Kassa[b + TT]    +  Kassa[b + TT]
     2823     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     2824     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     2825     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     2826     Bo-Inv[b + TT]    = Bo-Inv[b + TT]    +  Inv[b + TT]
     2827     B1-Overturn[b + TT]    = B1-Overturn[b + TT]    +  Overturn[b + TT]
     2828     B2-Overturn[b + TT]    = B2-Overturn[b + TT]    +  Overturn[b + TT]
     2829     Bi-Overturn[b + TT]    = Bi-Overturn[b + TT]    +  Overturn[b + TT]
     2830     Bo-Overturn[b + TT]    = Bo-Overturn[b + TT]    +  Overturn[b + TT] .
     2831   End.
     2832   END PROCEDURE.
     2833   PROCEDURE Clear-item :
     2834   define variable kk as int no-undo.
     2835    gds-zap-other = 0 .
     2836    REPEAT kk = 1 to 9 :
     2837    Assign
     2838       prih            [kk]    = 0
     2839       rash            [kk]    = 0
     2840       kassa           [kk]    = 0
     2841       Inv             [kk]    = 0
     2842       Overturn        [kk]    = 0
     2843       ostatok-end     [kk]    = 0
     2844       ostatok-start   [kk]    = 0 .
     2845          End.
     2846    END PROCEDURE.
     2847   PROCEDURE Item-Goods :
     2848      define input parameter  par-3 as char no-undo.
     2849      define input parameter  par-4 as char no-undo.
     2850        if par-4 = "goods":U  Then DO:
     2851           assign
     2852               gds-zap-unit-base  = Goods.unit-base
     2853               gds-zap-prt-root   = Goods.prt-root
     2854               gds-zap-prod-type  = Goods.prod-type
     2855               gds-zap-prod-code  = Goods.prod-code
     2856               gds-zap-artic      = Goods.artic
     2857               gds-zap-grp-name   = Goods.grp-name
     2858               gds-zap-b-code     = Goods.gds-code
     2859               gds-zap-type       = Goods.gds-type.
     2860           if g#gds-engl then
     2861               assign gds-zap-gds-name = Goods.engl-name.
     2862           else
     2863               assign gds-zap-gds-name = Goods.gds-name.
     2864        End.
     2865        if par-4 = "gds-list":U  Then DO:
     2866           assign
     2867               gds-zap-unit-base  = gds-list.unit-base
     2868               gds-zap-prt-root   = gds-list.prt-root
     2869               gds-zap-prod-type  = gds-list.prod-type
     2870               gds-zap-prod-code  = gds-list.prod-code
     2871               gds-zap-artic      = gds-list.artic
     2872               gds-zap-grp-name   = gds-list.grp-name
     2873               gds-zap-b-code     = gds-list.gds-code
     2874               gds-zap-type       = gds-list.gds-type.
     2875           if g#gds-engl then
     2876               assign gds-zap-gds-name = gds-list.engl-name.
     2877           else
     2878               assign gds-zap-gds-name = gds-list.gds-name.
     2879        End.
     2880       run foreach.
     2881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2882     (input  gds-zap-b-code
     2883     ,input  ?
     2884     ,output v-bar-code
     2885     )  .
     2886   s-bar-code = string (v-bar-code,"999999999").
     2887       If  break_group = true  and par-3 <> "1"  then DO :
     2888            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     2889            gds-zap-prod-name  = clients.obj-name.
     2890             If break_group1 = true  THEN  DO :
     2891               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     2892                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     2893                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     2894               if par-3 = "6"  then  dO:
     2895                  if xTog-obj = true then do:
     2896                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     2897                     .
     2898                   end.
     2899                  else do:
     2900                   var-vat-pc = temp-gds-list.vat-pc .
     2901                   end.
     2902                   assign
     2903                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     2904                       b1-name = temp-str.
     2905                   end.
     2906               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     2907                   fr0 = true .
     2908                   tmp#stroka0 = temp-str.
     2909               End.
     2910             End.
     2911               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     2912                 if par-3 = "4"
     2913                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     2914                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     2915                 if NOT xSumsOnly THEN DO:
     2916                     fr = true .
     2917                 End.
     2918                 break_group1 = false.
     2919               END.
     2920          break_group = false.
     2921       End.
     2922       run display-line.
     2923    END PROCEDURE.
