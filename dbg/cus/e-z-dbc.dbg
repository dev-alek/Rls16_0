      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     run mainmenu_getcntxt in my-handle
      626       (output v-cntxt-db-num
      627       ,output v-cntxt-userid
      628       ,output v-cntxt-level
      629       ,output v-cntxt-host-code-obj
      630       ,output v-cntxt-obj-type
      631       ,output v-cntxt-obj-code
      632       ,output v-cntxt-db-num-obj
      633       ,output v-cntxt-is-admin
      634       ) .
      635   define variable base-type as character no-undo .
      636   define variable base-code as integer   no-undo .
      637   define variable g#report-num as integer   no-undo .
      638   define variable g#gds-engl as logical   no-undo .
      639   define variable vv-exch-rate  as decimal   no-undo .
      640   define variable vv-exch-scale as decimal   no-undo .
      641   define variable v-cntxt-host-name-obj as character no-undo .
      642   if v-cntxt-level = 'object':U then do:
      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      645     (input  v-cntxt-obj-type
      646     ,input  v-cntxt-obj-code
      647     ,output v-cntxt-host-code-obj
      648     ,output v-cntxt-host-name-obj
      649     )  .
      650   end.
      651   if v-cntxt-level = 'firm':U then do:
      652     find first ub.clients no-lock where
      653                ub.clients.obj-type = 'орг':U and
      654                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      655   if error-status :error then v-cntxt-host-name-obj = ? .
      656      else v-cntxt-host-name-obj = ub.clients.obj-name.
      657   end.
      658   if v-cntxt-level = 'object':U
      659   or v-cntxt-level = 'firm':U
      660   then do:
      661   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      663     (input  v-cntxt-host-code-obj
      664     ,output base-code
      665     )  .
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   define variable State-source as  WIDGET-HANDLE.
      679   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      680        VIEW-AS FILL-IN NATIVE
      681        SIZE 5 BY .79 NO-UNDO.
      682   DEFINE VARIABLE Classify AS CHARACTER
      683        VIEW-AS RADIO-SET VERTICAL
      684        RADIO-BUTTONS
      685             "Без классификации", "no-classify":U,
      686   "Производители", "prod":U,
      687   "Группы товаров", "grp-goods":U
      688        SIZE 30.5 BY 2.92 NO-UNDO.
      689   DEFINE VARIABLE SortType AS CHARACTER
      690        VIEW-AS RADIO-SET VERTICAL
      691        RADIO-BUTTONS
      692             "по коду", "sort-code":U,
      693   "по артикулу", "sort-article":U
      694        SIZE 14 BY 2.92 NO-UNDO.
      695   DEFINE RECTANGLE RECT-5
      696        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      697        SIZE 32.25 BY 7.75.
      698   DEFINE RECTANGLE RECT-6
      699        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      700        SIZE 16.13 BY 7.79.
      701   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL yes
      702        LABEL "Показывать нулевые остатки":L
      703        VIEW-AS TOGGLE-BOX
      704        SIZE 31.13 BY 1.13 NO-UNDO.
      705   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      706        LABEL "Только итоги":L
      707        VIEW-AS TOGGLE-BOX
      708        SIZE 16 BY 1 NO-UNDO.
      709   DEFINE VARIABLE Tog-lavel AS LOGICAL INITIAL no
      710        LABEL "с уровня":L
      711        VIEW-AS TOGGLE-BOX
      712        SIZE 12.63 BY .79 NO-UNDO.
      713   DEFINE FRAME F-Main
      714        Classify AT ROW 2.71 COL 2.25 NO-LABEL
      715        SortType AT ROW 2.71 COL 35.38 NO-LABEL
      716        Tog-lavel AT ROW 5.67 COL 15
      717        var-lavel AT ROW 5.67 COL 25.88 COLON-ALIGNED NO-LABEL
      718        SumsOnly AT ROW 7.29 COL 2.25
      719        ShowZero AT ROW 9.17 COL 2.25
      720        "Сортировка :" VIEW-AS TEXT
      721             SIZE 11.5 BY .75 AT ROW 1.33 COL 36.88
      722             FGCOLOR 4
      723        "Классификация :" VIEW-AS TEXT
      724             SIZE 15 BY .75 AT ROW 1.33 COL 9.5
      725             FGCOLOR 4
      726        RECT-5 AT ROW 1.13 COL 1.63
      727        RECT-6 AT ROW 1.13 COL 34.25
      728       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      729            SIDE-LABELS NO-UNDERLINE THREE-D
      730            AT COL 1 ROW 1 SCROLLABLE .
      731   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      732   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      733   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      734   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      735   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      736   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      737   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      738   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      739         adm-object-hdl = FRAME F-Main:HANDLE.
      740   RUN ensure-broker.
      741   THIS-PROCEDURE:ADM-DATA =
      742        'ADM1.1~`':U +
      743        'SmartObject~`':U +
      744        '~`':U +
      745        'NO ~`':U +
      746        '~`':U +
      747        '~`':U +
      748        '~`':U +
      749        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      750           + "~`":U +
      751        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      752        'Record-Source,Record-Target,TableIO-Target~`':U +
      753        '~`':U +
      754        '~`~`~`~`~`~`~`~`~`~`~`':U +
      755        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      756            THEN "^^":U
      757        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      758             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      759   PROCEDURE adm-apply-entry :
      760     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      761   END PROCEDURE.
      762   PROCEDURE adm-destroy :
      763    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      764   END PROCEDURE.
      765   PROCEDURE adm-disable :
      766       DISABLE RECT-5 RECT-6 Classify SortType WITH FRAME F-Main.
      767       RUN dispatch ('disable-fields':U).
      768       RUN set-attribute-list ('ENABLED=no':U).
      769       RETURN.
      770   END PROCEDURE.
      771   PROCEDURE adm-edit-attribute-list :
      772         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      773         RETURN.
      774   END PROCEDURE.
      775   PROCEDURE adm-enable :
      776       ENABLE UNLESS-HIDDEN RECT-5 RECT-6 Classify SortType WITH FRAME F-Main.
      777       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      778       RUN set-attribute-list ('ENABLED=yes':U).
      779       RETURN.
      780   END PROCEDURE.
      781   PROCEDURE adm-exit :
      782        RUN notify ('exit':U).
      783     RETURN.
      784   END PROCEDURE.
      785   PROCEDURE adm-hide :
      786     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      787   END PROCEDURE.
      788   PROCEDURE adm-initialize :
      789     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      790   END PROCEDURE.
      791   PROCEDURE adm-show-errors :
      792       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      793       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      794           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      795       END.
      796       RETURN.
      797   END PROCEDURE.
      798   PROCEDURE adm-UIB-mode :
      799     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      800   END PROCEDURE.
      801   PROCEDURE adm-view :
      802     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      803   END PROCEDURE.
      804   PROCEDURE dispatch :
      805       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      806       RUN broker-dispatch IN adm-broker-hdl
      807           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      808       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      809   END PROCEDURE.
      810   PROCEDURE ensure-broker :
      811   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      812   IF RETURN-VALUE NE "ADM-Broker":U THEN
      813   DO:
      814       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      815       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      816   END.
      817   END PROCEDURE.
      818   PROCEDURE get-attribute :
      819     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      820     RUN broker-get-attribute IN adm-broker-hdl
      821         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      822     RETURN RETURN-VALUE.
      823   END PROCEDURE.
      824   PROCEDURE get-attribute-list :
      825     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      826     RUN broker-get-attribute-list IN adm-broker-hdl
      827         (INPUT THIS-PROCEDURE,
      828          INPUT ?,
      829          OUTPUT p-attr-list) NO-ERROR.
      830     RETURN.
      831   END PROCEDURE.
      832   PROCEDURE new-state :
      833     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      834     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      835     RETURN.
      836   END PROCEDURE.
      837   PROCEDURE notify :
      838     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      839     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      840     IF RETURN-VALUE = "ADM-ERROR":U THEN
      841         RETURN "ADM-ERROR":U.
      842     RETURN.
      843   END PROCEDURE.
      844   PROCEDURE set-attribute-list :
      845     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      846     RUN ensure-broker.
      847     RUN broker-set-attribute-list IN adm-broker-hdl
      848         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      849     RETURN.
      850   END PROCEDURE.
      851   PROCEDURE set-position :
      852       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      853       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      854       IF VALID-HANDLE(adm-object-hdl) THEN
      855       DO:
      856         ASSIGN adm-object-hdl:ROW    =   p-row
      857                adm-object-hdl:COLUMN =   p-col.
      858       END.
      859       RETURN.
      860   END PROCEDURE.
      861   PROCEDURE adm-display-fields :
      862       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      863       RETURN.
      864   END PROCEDURE.
      865   PROCEDURE adm-open-query :
      866     RETURN.
      867   END PROCEDURE.
      868   PROCEDURE adm-row-changed :
      869         IF VALID-HANDLE(adm-object-hdl) THEN
      870           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      871         RUN notify ('row-available':U).
      872         RETURN.
      873   END PROCEDURE.
      874   PROCEDURE reposition-query :
      875       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      876       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      877       RETURN.
      878   END PROCEDURE.
      879     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      880     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      881     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      882     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      883     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      884     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      885     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      886     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      887     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      888     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      889     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      890     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      891     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      892     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      893     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      894     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      895     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      896     IF "":U = "":U THEN
      897       RUN modify-list-attribute IN adm-broker-hdl
      898         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      899     RUN use-create-on-add(?).
      900   PROCEDURE adm-add-record :
      901       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      902          "must have at least one Enabled Table to perform Add.":U
      903          VIEW-AS ALERT-BOX ERROR.
      904       RETURN.
      905   END PROCEDURE.
      906   PROCEDURE adm-assign-record :
      907    MESSAGE
      908          "Object ":U THIS-PROCEDURE:FILE-NAME
      909            "must have at least one Enabled Table to perform Assign.":U
      910              VIEW-AS ALERT-BOX ERROR.
      911      RETURN.
      912     END PROCEDURE.
      913   PROCEDURE adm-assign-statement :
      914     RETURN.
      915   END PROCEDURE.
      916   PROCEDURE adm-cancel-record :
      917      RETURN.
      918     END PROCEDURE.
      919   PROCEDURE adm-copy-record :
      920       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      921        "must have at least one Enabled Table to perform Copy.":U
      922          VIEW-AS ALERT-BOX ERROR.
      923       RETURN.
      924   END PROCEDURE.
      925   PROCEDURE adm-create-record :
      926      RETURN.
      927   END PROCEDURE.
      928   PROCEDURE adm-current-changed :
      929     RETURN.
      930   END PROCEDURE.
      931   PROCEDURE adm-delete-record :
      932    MESSAGE
      933          "Object ":U THIS-PROCEDURE:FILE-NAME
      934            "must have at least one Enabled Table to perform Delete.":U
      935              VIEW-AS ALERT-BOX ERROR.
      936       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      937       RETURN.
      938   END PROCEDURE.
      939   PROCEDURE adm-disable-fields :
      940         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      941       RETURN.
      942   END PROCEDURE.
      943   PROCEDURE adm-enable-fields :
      944       RETURN.
      945   END PROCEDURE.
      946   PROCEDURE adm-end-update :
      947     RETURN.
      948   END PROCEDURE.
      949   PROCEDURE adm-reset-record :
      950       RETURN.
      951   END PROCEDURE.
      952   PROCEDURE adm-update-record :
      953       MESSAGE
      954         "Object ":U THIS-PROCEDURE:FILE-NAME
      955           "must have at least one Enabled Table to perform Update.":U
      956             VIEW-AS ALERT-BOX ERROR.
      957      RETURN.
      958   END PROCEDURE.
      959   PROCEDURE check-modified :
      960   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      961   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      962   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      963   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      964     IF check-state = "check":U THEN
      965     DO:
      966       RUN get-link-handle IN adm-broker-hdl
      967         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      968            OUTPUT group-target-list).
      969       IF group-target-list NE "":U THEN
      970       DO i = 1 TO NUM-ENTRIES(group-target-list):
      971         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      972         RUN check-modified IN curr-widget ('group-check':U).
      973         IF RETURN-VALUE NE "":U THEN
      974         DO:
      975           RUN check-modified-message(RETURN-VALUE).
      976           RETURN "":U.
      977         END.
      978       END.
      979     END.
      980     RETURN "":U.
      981   END PROCEDURE.
      982   PROCEDURE check-modified-message :
      983     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      984        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      985           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      986        IF RETURN-VALUE = "YES":U THEN
      987           RUN notify ('view,CONTAINER-SOURCE':U).
      988        MESSAGE IF p-changed-table NE ? THEN
      989           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      990           ELSE "Current values have been changed."
      991           SKIP "  Do you wish to save those changes?"
      992           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      993        IF ANS THEN
      994        DO:
      995           IF group-assign-target THEN
      996             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      997           ELSE RUN dispatch('update-record':U).
      998           IF RETURN-VALUE = "ADM-ERROR":U THEN
      999           DO:
     1000               MESSAGE "Changes to the previous record were not saved."
     1001                 VIEW-AS ALERT-BOX ERROR.
     1002               IF group-assign-target THEN
     1003                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1004               ELSE RUN dispatch ('cancel-record':U).
     1005           END.
     1006        END.
     1007        ELSE DO:
     1008          IF group-assign-target THEN
     1009             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1010          ELSE RUN dispatch('cancel-record':U).
     1011        END.
     1012        RETURN.
     1013   END PROCEDURE.
     1014   PROCEDURE get-rowid :
     1015       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1016       ASSIGN
     1017       p-table   =   adm-first-table.
     1018       RETURN.
     1019   END PROCEDURE.
     1020   PROCEDURE init-group-assign :
     1021       RUN request-attribute IN adm-broker-hdl
     1022         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1023       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1024         group-assign-target = yes.
     1025       ELSE group-assign-target = no.
     1026       RETURN.
     1027   END PROCEDURE.
     1028   PROCEDURE set-editors :
     1029       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1030       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1031       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1032       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1033       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1034       DO WHILE VALID-HANDLE (curr-widget):
     1035           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1036              curr-widget:HIDDEN = no THEN DO:
     1037             CASE p-field-setting:
     1038               WHEN "INITIALIZE":U THEN
     1039               DO:
     1040                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1041                     read-only-list +
     1042                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1043                        STRING(curr-widget).
     1044               END.
     1045               WHEN "DISABLE":U OR
     1046               WHEN "ENABLE":U THEN
     1047               DO:
     1048                   curr-widget:SENSITIVE = yes.
     1049                   RUN get-attribute ('Read-Only-Editors':U).
     1050                   IF RETURN-VALUE = ? OR
     1051                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1052                       curr-widget:READ-ONLY =
     1053                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1054               END.
     1055               WHEN "CLEAR":U THEN
     1056                   curr-widget:SCREEN-VALUE = "":U.
     1057             END CASE.
     1058           END.
     1059           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1060       END.
     1061       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1062         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1063           + '"':U).
     1064       RETURN.
     1065   END PROCEDURE.
     1066   PROCEDURE use-check-modified-all :
     1067    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1068     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1069     RETURN.
     1070   END PROCEDURE.
     1071   PROCEDURE use-create-on-add :
     1072   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1073      RETURN.
     1074   END PROCEDURE.
     1075   PROCEDURE use-initial-lock :
     1076     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1077     ASSIGN adm-initial-lock = p-attr-value.
     1078     RETURN.
     1079   END PROCEDURE.
     1080     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1081   ASSIGN
     1082          FRAME F-Main:SCROLLABLE       = FALSE
     1083          FRAME F-Main:HIDDEN           = TRUE.
     1084   ASSIGN
     1085          ShowZero:HIDDEN IN FRAME F-Main           = TRUE.
     1086   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1087   DO:
     1088       Assign Classify.
     1089       if Classify  Begins "prod":U OR
     1090          Classify  Begins "grp-goods":U then
     1091           enable SumsOnly with frame F-Main .
     1092       else
     1093           do:
     1094               SumsOnly = FALSE .
     1095               display SumsOnly with frame F-Main .
     1096               disable SumsOnly with frame F-Main .
     1097           end.
     1098    if Classify = "grp-goods":U
     1099            Then do:
     1100               display TOG-lavel   with frame F-Main .
     1101               enable  TOG-lavel   with frame F-Main .
     1102           end.
     1103            Else do:
     1104               display  TOG-lavel  var-Lavel with frame F-Main .
     1105               disable  TOG-lavel  var-Lavel with frame F-Main .
     1106           end.
     1107   END.
     1108   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1109   DO:
     1110      Assign tog-lavel.
     1111     if tog-lavel = TRUE
     1112           Then do:
     1113               display  var-Lavel  with frame F-Main .
     1114               enable   var-Lavel  with frame F-Main .
     1115           end.
     1116            Else do:
     1117               display    var-Lavel with frame F-Main .
     1118               disable    var-Lavel with frame F-Main .
     1119           end.
     1120   END.
     1121   if not this-procedure :persistent
     1122   then do:
     1123     message
     1124       vss-workfile vss-revision vss-description skip
     1125       "Ошибка при запуске процедуры" skip
     1126       "Данную процедуру следует запускать только с параметром persistent" skip
     1127       view-as alert-box error .
     1128     undo, return error .
     1129   end.
     1130   PROCEDURE disable_UI :
     1131     HIDE FRAME F-Main.
     1132     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1133   END PROCEDURE.
     1134   PROCEDURE my-report :
     1135   if classify = "no-classify":u then do:
     1136   run cus/r-benet5.p
     1137    (
     1138    input  v-cntxt-obj-code,
     1139    input  v-cntxt-obj-type,
     1140    input  base-type ,
     1141    input  base-code ,
     1142    input  classify  ,
     1143    input  sorttype  ,
     1144    input  sumsonly  ,
     1145    input  showzero  ,
     1146    false ,
     1147    input   tog-lavel,
     1148    input   var-lavel )
     1149   .
     1150   end.
     1151   else do:
     1152     if  classify = "prod":u then do:
     1153     run cus/r-bent53.p
     1154     (
     1155     input  v-cntxt-obj-code,
     1156     input  v-cntxt-obj-type,
     1157     input  base-type ,
     1158     input  base-code ,
     1159     input  classify  ,
     1160     input  sorttype  ,
     1161     input  sumsonly  ,
     1162     input  showzero  ,
     1163     false ,
     1164     input   tog-lavel,
     1165     input   var-lavel )
     1166     .
     1167     end.
     1168     else do:
     1169     run cus/r-bene52.p
     1170     (
     1171     input  v-cntxt-obj-code,
     1172     input  v-cntxt-obj-type,
     1173     input  base-type ,
     1174     input  base-code ,
     1175     input  classify  ,
     1176     input  sorttype  ,
     1177     input  sumsonly  ,
     1178     input  showzero  ,
     1179     false ,
     1180     input   tog-lavel,
     1181     input   var-lavel )
     1182     .
     1183   end.
     1184   end.
     1185   END PROCEDURE.
     1186   PROCEDURE my-var :
     1187   assign frame F-Main SumsOnly ShowZero  Classify SortType
     1188   Tog-lavel var-lavel.
     1189   def var t-class as char no-undo.
     1190   def var t-sort as char no-undo.
     1191     case classify:
     1192       when "no-classify":u    then t-class =   "Без классификации" .
     1193       when "prod":u           then t-class =   "Производители"   .
     1194       when "post":u           then t-class =   "Поставщики"   .
     1195       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1196       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1197       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1198       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1199       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1200       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1201       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1202       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1203       when  "t-level":u       then t-class =   "Терминальные группы" .
     1204    end case.
     1205     case sorttype:
     1206       when "sort-pp":u               then t-sort =   "по порядку" .
     1207       when "sort-code":u             then t-sort =   "по коду" .
     1208       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1209       when "sort-qunty":u            then t-sort =   "по реализации".
     1210       when "sort-name":u             then t-sort =   "по наименованию".
     1211       when "sort-type":u             then t-sort =   "по типу ткани".
     1212       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1213       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1214    end case.
     1215   ReportNAme = "С О С Т О Я Н И Е    З А П А С А ".
     1216   ReportHeader = "Классификация : " + t-class + chr(10) +
     1217                  (if SumsOnly then "Только итоги "  else " " )  +  chr(10) +
     1218                 "Сортировка " + t-sort  + chr(10) +
     1219                  (if ShowZero then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) .
     1220     if X-SET_PAY_TYPE <> 2 then str3 =  "в ценах РЕАЛИЗАЦИИ".
     1221    str2 = "" .
     1222    sheetf.Excel-Column-Lable =
     1223             "Код"
     1224     + ","  + "Доп.БК"
     1225     + ","  + "Артикул"
     1226     + ","  + "Название товара"
     1227     + ","  + "Ед. изм"
     1228      .
     1229     define variable t-str as character no-undo .
     1230     For each obj-list no-lock :
     1231       t-str = obj-list.obj-name .
     1232       repeat :
     1233           if index ( t-str , "," ) > 0 then do:
     1234              substring ( t-str ,  index ( t-str , "," ) ) = "." .
     1235           end.
     1236           else leave.
     1237       end.
     1238       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable   + ","  + "Количество "  + t-str + ","  + "Стоимость" .
     1239     End.
     1240       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable   + ","  + "Количество ИТОГО,Стоимость ИТОГО" .
     1241    sheetf.Sizes =  "10,10,16,40,5".
     1242     For each obj-list no-lock :
     1243       sheetf.Sizes = sheetf.Sizes   + ","  + "15"  + ","  + "15" .
     1244     End.
     1245     sheetf.Sizes = sheetf.Sizes   + ","  + "15"  + ","  + "15" .
     1246     sheetf.Sizes = sheetf.Sizes   + ",".
     1247     sheetf.colformat = "2=@;3=@;4=@":U .
     1248   END PROCEDURE.
     1249   PROCEDURE state-changed :
