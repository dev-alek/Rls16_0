      232               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      233               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      234               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      235               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      236                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      237               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      238         otherwise do:
      239           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      240         end.
      241       end CASE.
      242     end.
      243   end procedure.
      244   procedure uf-get :
      245     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      246     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      247     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      248     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      249     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      250     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      251     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      252     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      253     do
      254     on error undo, return error
      255     :
      256       define buffer buf_usr-flt for ubflt.usr-flt .
      257       define variable v-use-List_     as logical   no-undo .
      258       define variable v-type-List_     as character no-undo .
      259       define variable v-format-List_   as character no-undo .
      260       define variable v-use-Naim      as logical   no-undo .
      261       define variable v-type-Naim      as character no-undo .
      262       define variable v-format-Naim    as character no-undo .
      263       define variable v-use-print-graft as logical   no-undo .
      264       define variable v-use-sort-gr     as logical   no-undo .
      265       define variable v-use-type-price  as logical   no-undo .
      266       define variable v-use-type-val    as logical   no-undo .
      267       define variable v-label          as character no-undo .
      268       define variable v-tooltip        as character no-undo .
      269       define variable v-user-can-edit  as logical   no-undo .
      270       define variable v-output-display as logical   no-undo .
      271       define variable v-other          as character no-undo .
      272       run uf-name in this-procedure
      273          (input  entry(1, p-code, chr(4))
      274         ,output v-use-List_
      275         ,output v-type-List_
      276         ,output v-format-List_
      277         ,output v-use-Naim
      278         ,output v-type-Naim
      279         ,output v-format-Naim
      280         ,output v-use-print-graft
      281         ,output v-use-sort-gr
      282         ,output v-use-type-price
      283         ,output v-use-type-val
      284         ,output v-label
      285         ,output v-tooltip
      286         ,output v-user-can-edit
      287         ,output v-output-display
      288         ,output v-other
      289         ) no-error .
      290       if error-status :error then do:
      291         undo, return error return-value .
      292       end.
      293       find first buf_usr-flt no-lock where
      294                  buf_usr-flt.Call-point     = p-code AND
      295                  buf_usr-flt.user-name       = p-user-name
      296         no-error .
      297       if avail buf_usr-flt then do:
      298         assign
      299         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      300         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      301         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      302         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      303         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      304         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      305         .
      306       end.
      307       else do:
      308         assign
      309         p-List_        = (if v-use-List_       then "":U                    else ?)
      310         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      311         p-print-graft  = (if v-use-print-graft then no                      else ?)
      312         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      313         p-type-price   = (if v-use-type-price  then no                      else ?)
      314         p-type-val     = (if v-use-List_       then no                      else ?)
      315         .
      316       end.
      317     end.
      318   end procedure.
      319   procedure uf-set :
      320     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      321     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      322     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      323     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      324     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      325     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      326     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      327     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      328     do
      329     on error undo, return error
      330     :
      331       define buffer buf_usr-flt for ubflt.usr-flt .
      332       define variable v-use-List_     as logical   no-undo .
      333       define variable v-type-List_     as character no-undo .
      334       define variable v-format-List_   as character no-undo .
      335       define variable v-use-Naim      as logical   no-undo .
      336       define variable v-type-Naim      as character no-undo .
      337       define variable v-format-Naim    as character no-undo .
      338       define variable v-use-print-graft as logical   no-undo .
      339       define variable v-use-sort-gr   as logical   no-undo .
      340       define variable v-use-type-price as logical   no-undo .
      341       define variable v-use-type-val  as logical   no-undo .
      342       define variable v-tooltip        as character no-undo .
      343       define variable v-label          as character no-undo .
      344       define variable v-user-can-edit  as logical   no-undo .
      345       define variable v-output-display as logical   no-undo .
      346       define variable v-other          as character no-undo .
      347       run uf-name in this-procedure
      348         (input  entry(1, p-code, chr(4))
      349         ,output v-use-List_
      350         ,output v-type-List_
      351         ,output v-format-List_
      352         ,output v-use-Naim
      353         ,output v-type-Naim
      354         ,output v-format-Naim
      355         ,output v-use-print-graft
      356         ,output v-use-sort-gr
      357         ,output v-use-type-price
      358         ,output v-use-type-val
      359         ,output v-label
      360         ,output v-tooltip
      361         ,output v-user-can-edit
      362         ,output v-output-display
      363         ,output v-other
      364         ) no-error .
      365       if error-status :error then do:
      366         undo, return error return-value .
      367       end.
      368       find first buf_usr-flt where
      369                  buf_usr-flt.Call-point     = p-code AND
      370                  buf_usr-flt.user-name       = p-user-name
      371         no-error .
      372       if not avail buf_usr-flt then do:
      373           create buf_usr-flt .
      374           assign
      375           buf_usr-flt.call-point = p-code
      376           buf_usr-flt.user-name  = p-user-name
      377           .
      378       end.
      379       if avail buf_usr-flt then do:
      380        assign
      381        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      382        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      383        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      384        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      385        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      386        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      387       .
      388       release buf_usr-flt.
      389       end.
      390       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      391     end.
      392   end procedure.
      393   define buffer buf_goods for ub.goods.
      394   define temp-table tt_doc-line no-undo like ub.doc-line.
      395   define temp-table tt_ord-line-rcv no-undo like ub.ord-line-rcv.
      396   define temp-table tt_ord-line no-undo like ub.ord-line
      397   field type-str as character
      398   field qnty-rcv as decimal
      399   field qnty-trn as decimal
      400   .
      401   define variable vi-total-rcv as decimal   no-undo init 0.
      402   define variable vi-total-trn as decimal   no-undo init 0.
      403   define variable vi-total-ord as decimal   no-undo init 0.
      404   define buffer buf_ord-doc for ub.ord-doc  .
      405   define buffer buf_ord-line for ub.ord-line  .
      406   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
      407   define buffer buf_ord-line-rcv for ub.ord-line-rcv  .
      408   define buffer buf_trn-doc for ub.trn-doc  .
      409   define buffer buf_doc-line for ub.doc-line  .
      410   define variable v-total-rcv as decimal   no-undo .
      411   define variable v-total-trn as decimal   no-undo .
      412   define variable varlog as logical   no-undo .
      413   define variable v-size-col1 as decimal   no-undo .
      414   define variable v-size-col2 as decimal   no-undo .
      415   define variable v-size-col3 as decimal   no-undo .
      416   run uf-get in this-procedure (
      417        input  'ord-sost-p':U
      418       ,input  v-cntxt-userid
      419       ,output v-uf-List_
      420       ,output v-uf-Naim
      421       ,output v-uf-print-graft
      422       ,output v-uf-sort-gr
      423       ,output v-uf-type-price
      424       ,output v-uf-type-val
      425   )  .
      426   v-size-col1  = decimal (entry(1, v-uf-List_ ,chr(4))) no-error.
      427   v-size-col2  = decimal (entry(2, v-uf-List_ ,chr(4))) no-error.
      428   v-size-col3   = decimal (entry(3, v-uf-List_ ,chr(4))) no-error.
      429   if v-size-col1 = 0  or v-size-col1 = ? then v-size-col1 = 16 .
      430   if v-size-col2 = 0  or v-size-col2 = ? then v-size-col2 = 20 .
      431   if v-size-col3 = 0  or v-size-col3 = ? then v-size-col3 = 12 .
      432   if v-cntxt-db-num <> 0 then p-mode = 'ПРОСМОТР':U .
      433   DEFINE BUTTON B-exit AUTO-GO
      434        LABEL "&Ввод"
      435        SIZE 10 BY 1
      436        BGCOLOR 8 .
      437   DEFINE BUTTON B-Help
      438        LABEL "&Help"
      439        SIZE 10 BY 1
      440        BGCOLOR 8 .
      441   DEFINE BUTTON B-next AUTO-GO
      442        LABEL "&>>"
      443        SIZE 5 BY 1
      444        BGCOLOR 8 .
      445   DEFINE BUTTON B-prev AUTO-GO
      446        LABEL "&<<"
      447        SIZE 5 BY 1
      448        BGCOLOR 8 .
      449   DEFINE BUTTON B-print
      450        LABEL "&Печать"
      451        SIZE 10 BY 1
      452        BGCOLOR 8 .
      453   DEFINE BUTTON B-quit AUTO-END-KEY
      454        LABEL "&Отмена"
      455        SIZE 10 BY 1
      456        BGCOLOR 8 .
      457   DEFINE BUTTON B-rcv
      458        LABEL "&Поставки"
      459        SIZE 10 BY 1 TOOLTIP "Поставки по товару"
      460        BGCOLOR 8 .
      461   DEFINE BUTTON B-trn
      462        LABEL "&Накладные"
      463        SIZE 12 BY 1 TOOLTIP "Накладные по товару"
      464        BGCOLOR 8 .
      465   DEFINE VARIABLE COMBO-status AS INTEGER FORMAT "9":U INITIAL 0
      466        VIEW-AS COMBO-BOX INNER-LINES 5
      467        LIST-ITEM-PAIRS "Поставка = заказу",0,
      468                        "Перепоставка",1,
      469                        "Недопоставка",2,
      470                        "Несоответствие",3
      471        DROP-DOWN-LIST
      472        SIZE 20.5 BY 1
      473        FGCOLOR 4  NO-UNDO.
      474   DEFINE VARIABLE i-ord AS DECIMAL FORMAT ">>>,>>>,>>>,>>9.999":U INITIAL 0
      475         VIEW-AS TEXT
      476        SIZE 19.5 BY 1 TOOLTIP "Итого по заказам"
      477        FGCOLOR 4  NO-UNDO.
      478   DEFINE VARIABLE i-rcv AS DECIMAL FORMAT ">>>,>>>,>>>,>>9.999":U INITIAL 0
      479         VIEW-AS TEXT
      480        SIZE 19.5 BY 1 TOOLTIP "Итого по поставкам"
      481        FGCOLOR 4  NO-UNDO.
      482   DEFINE VARIABLE i-trn AS DECIMAL FORMAT ">>>,>>>,>>>,>>9.999":U INITIAL 0
      483         VIEW-AS TEXT
      484        SIZE 19.5 BY 1 TOOLTIP "Итого по накладным"
      485        FGCOLOR 4  NO-UNDO.
      486   DEFINE VARIABLE v-status AS CHARACTER FORMAT "X(256)":U
      487         VIEW-AS TEXT
      488        SIZE 34.5 BY .67
      489        FGCOLOR 4  NO-UNDO.
      490   DEFINE QUERY BROWSE-3 FOR
      491         tt_ord-line,
      492         buf_goods SCROLLING.
      493   DEFINE BROWSE BROWSE-3
      494     QUERY BROWSE-3 NO-LOCK DISPLAY
      495         tt_ord-line.gds-code COLUMN-LABEL "Код" FORMAT "999999999":U
      496         tt_ord-line.artic
      497         buf_goods.gds-name
      498         buf_goods.unit-base COLUMN-LABEL "Е.И" FORMAT "X(3)":U WIDTH 3
      499         tt_ord-line.qnty      COLUMN-LABEL "Заказано" FORMAT ">>>,>>>,>>>,>>9.999":U
      500         tt_ord-line.qnty-rcv  COLUMN-LABEL "По поставкам"
      501         tt_ord-line.qnty-trn  COLUMN-LABEL "По накладным" FORMAT "->>>,>>>,>>>,>>9.999":U
      502       WITH NO-ROW-MARKERS SEPARATORS SIZE 99.25 BY 18 FIT-LAST-COLUMN.
      503   DEFINE FRAME Dialog-Frame
      504        B-exit AT ROW 1 COL 1
      505        B-quit AT ROW 1 COL 11
      506        B-rcv AT ROW 1 COL 21 WIDGET-ID 52
      507        B-trn AT ROW 1 COL 31 WIDGET-ID 54
      508        B-print AT ROW 1 COL 80 WIDGET-ID 56
      509        B-Help AT ROW 1 COL 90
      510        B-prev AT ROW 2 COL 1 WIDGET-ID 66
      511        B-next AT ROW 2 COL 6 WIDGET-ID 68
      512        BROWSE-3 AT ROW 3 COL 1 WIDGET-ID 200
      513        COMBO-status AT ROW 21.25 COL 7 COLON-ALIGNED NO-LABEL WIDGET-ID 50
      514        i-ord AT ROW 21.25 COL 36.5 COLON-ALIGNED NO-LABEL WIDGET-ID 58
      515        i-rcv AT ROW 21.25 COL 57.38 COLON-ALIGNED NO-LABEL WIDGET-ID 60
      516        i-trn AT ROW 21.25 COL 78 COLON-ALIGNED NO-LABEL WIDGET-ID 62
      517        v-status AT ROW 22.25 COL 2 NO-LABEL WIDGET-ID 64
      518        "ИТОГО:" VIEW-AS TEXT
      519             SIZE 6.5 BY 1 AT ROW 21.25 COL 2 WIDGET-ID 48
      520             FGCOLOR 4
      521        SPACE(91.75) SKIP(0.78)
      522       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      523            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      524            TITLE "Состояние заказа"
      525            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      526   ASSIGN
      527          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      528          FRAME Dialog-Frame:HIDDEN           = TRUE.
      529   ON GO OF FRAME Dialog-Frame
      530   DO:
      531     run save-proc in this-procedure no-error.
      532     if error-status :error then return no-apply.
      533   END.
      534   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      535   OR ENDKEY OF FRAME Dialog-Frame DO:
      536     parnext-prev = ?.
      537     APPLY "END-ERROR":U TO SELF.
      538   END.
      539   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      540   DO:
      541     parnext-prev = ?.
      542   END.
      543   ON CHOOSE OF B-next IN FRAME Dialog-Frame
      544   DO:
      545     RUN step-next in this-procedure .
      546     END.
      547   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
      548   DO:
      549     run step-prev in this-procedure .
      550   END.
      551   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      552   DO:
      553     if not available tt_ord-line then return no-apply.
      554   END.
      555   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
      556   DO:
      557     parnext-prev = ?.
      558   END.
      559   ON CHOOSE OF B-rcv IN FRAME Dialog-Frame
      560   DO:
      561     if not available tt_ord-line then return no-apply.
      562     run cus/ord-sosr.w
      563        ( input parparentproc,
      564        input 'ПРОСМОТР':U,
      565        input p-doc-code,
      566        input tt_ord-line.gds-code,
      567        input table tt_ord-line-rcv
      568        ).
      569   END.
      570   ON CHOOSE OF B-trn IN FRAME Dialog-Frame
      571   DO:
      572     if not available tt_ord-line then return no-apply.
      573     run cus/ord-sosn.w
      574        ( input parparentproc,
      575        input 'ПРОСМОТР':U,
      576        input p-doc-code,
      577        input tt_ord-line.gds-code,
      578        input table tt_doc-line
      579        ).
      580   END.
      581   ON ROW-DISPLAY OF BROWSE-3 IN FRAME Dialog-Frame
      582   DO:
      583     if not available tt_ord-line then return no-apply.
      584        case tt_ord-line.type-str :
      585           when "ord" then do:
      586              run bg-col (?) .
      587              if tt_ord-line.qnty <> tt_ord-line.qnty-rcv
      588                 then tt_ord-line.qnty-rcv:fgcolor in browse BROWSE-3      = 12.
      589                 else tt_ord-line.qnty-rcv:fgcolor = ?.
      590              if tt_ord-line.qnty <> tt_ord-line.qnty-trn
      591                 then tt_ord-line.qnty-trn:fgcolor in browse BROWSE-3      = 12.
      592                 else tt_ord-line.qnty-trn:fgcolor = ?.
      593           end.
      594           when "rcv" then do:
      595           run bg-col (11) .
      596           end.
      597           when "trn" then do:
      598           run bg-col (13) .
      599           end.
      600        end.
      601   END.
      602   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      603   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      604   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   on help of frame Dialog-Frame
      606   do:
      607     run gbl/app_help.p
      608       (input this-procedure :file-name
      609       ,input ''
      610       ,input ?
      611       ) no-error.
      612     if error-status :error then do:
      613       message
      614         "Ошибка при вызове помощи"
      615         error-status :get-message(1)
      616         view-as alert-box .
      617     end.
      618   end.
      619   run minbtn-set in this-procedure .
      620   on choose of b-help in frame Dialog-Frame
      621   do:
      622     apply "help":u to frame Dialog-Frame .
      623   end.
      624   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625   procedure minbtn-set :
      626       do
      627           on error undo, return error return-value
      628           :
      629           define variable ii              as integer       no-undo .
      630           define variable fh              as widget-handle no-undo .
      631           define variable hh              as widget-handle no-undo .
      632           define variable v-h             as handle        extent 4 no-undo .
      633           define variable v-name-button   as character     no-undo .
      634           define variable v-help-old-x    as decimal       no-undo .
      635           define variable v-help-old-y    as decimal       no-undo .
      636           define variable v-help-old-size as decimal       no-undo .
      637           define variable v-frame-width   as decimal       no-undo .
      638           define variable jj              as integer       no-undo .
      639           do
      640               on error undo, return error
      641               :
      642               assign
      643                   v-frame-width = frame Dialog-Frame:width - 0.3
      644                   fh            = frame Dialog-Frame:first-child
      645                   hh            = fh:first-child
      646                   ii            = 1
      647                   .
      648               do while valid-handle(hh):
      649                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      650                   do:
      651                       case lc(hh:name) :
      652                           when "b-help" then
      653                               do:
      654                                   hh:load-image-up("cmp/b-help.bmp":u) .
      655                                   hh:load-image-down("cmp/b-help.bmp":u) .
      656                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      657                                   hh:TOOLTIP = "Помощь" .
      658                                   v-help-old-x = hh:column .
      659                                   v-help-old-y = hh:row    .
      660                                   v-help-old-size = hh:width .
      661                                   hh:width-chars = 2.5 .
      662                               end.
      663                           when "b-print" then
      664                               do:
      665                                   hh:load-image("cmp/b-print.bmp":u) .
      666                                   hh:TOOLTIP = "Печать" .
      667                                   v-h[ii] = hh:handle .
      668                                   ii = ii + 1 .
      669                                   hh:width-chars = 3 .
      670                               end.
      671                           when "b-history" or
      672                           when "b-hist" then
      673                               do:
      674                                   hh:load-image("cmp/b-hist.bmp":u) .
      675                                   hh:TOOLTIP = "История" .
      676                                   v-h[ii] = hh:handle .
      677                                   ii = ii + 1 .
      678                                   hh:width-chars = 3 .
      679                               end.
      680                           when "b-sch" then
      681                               do:
      682                                   hh:load-image("cmp/b-sch.bmp":u) .
      683                                   hh:TOOLTIP = "Установка Фильтра" .
      684                                   v-h[ii] = hh:handle .
      685                                   ii = ii + 1 .
      686                                   hh:width-chars = 3 .
      687                               end.
      688                           when "b-hist-user" then
      689                               do:
      690                                   hh:load-image("cmp/b-hist.bmp":u) .
      691                                   hh:TOOLTIP = "История пользователя" .
      692                                   ii = ii + 1 .
      693                               end.
      694                       end case.
      695                   end.
      696                   hh = hh:next-sibling.
      697               end.
      698               b-help:column = v-frame-width - b-help:width-chars.
      699               jj = 0.
      700               repeat ii = 4 to 1 by -1 :
      701                   if valid-handle (v-h[ii] ) then
      702                   do:
      703                       jj  = jj + 1 .
      704                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      705                       v-h[ii]:row    = v-help-old-y .
      706                   end.
      707               end.
      708           end.
      709       end.
      710   end procedure.
      711   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      712   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      713   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      714   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      715   define variable v-diasize-current-frame-width  as decimal   no-undo .
      716   define variable v-diasize-current-frame-height as decimal   no-undo .
      717   define variable v-diasize-change-size          as logical   no-undo .
      718   define variable v-diasize-resize-button        as handle    no-undo .
      719   define variable v-diasize-wndmax               as logical   no-undo .
      720   define variable v-diasize-wndstore             as logical   no-undo .
      721   define variable v-diasize-proc-name            as character no-undo .
      722   define variable v-diasize-browse-handle        as handle    no-undo .
      723   define variable v-diasize-browse-number        as integer   no-undo .
      724   define variable v-diasize-need-full-display    as logical   no-undo init false .
      725   define temp-table temp-diasize-handle no-undo
      726     field handle-value  as handle
      727     field save-position as decimal
      728     index xpk is primary unique handle-value
      729     .
      730   define temp-table temp-browse-handle no-undo
      731     field browse-type   as character
      732     field browse-number as integer
      733     field browse-handle as handle
      734     field original-size as decimal
      735     index xpk is primary unique browse-type browse-number
      736     index xie browse-type browse-handle
      737   .
      738   procedure diasize_change-height :
      739     define input  parameter p-change-value  as decimal   no-undo .
      740     define input  parameter p-move-resize   as logical   no-undo .
      741     define variable v-field-group-handle    as handle    no-undo .
      742     define variable v-object-handle         as handle    no-undo .
      743     define variable v-frame-height          as decimal   no-undo .
      744     define variable v-frame-virtual-height  as decimal   no-undo .
      745     define variable v-browse-height         as decimal   no-undo .
      746     define variable v-window-height         as decimal   no-undo .
      747     define variable v-window-virtual-height as decimal   no-undo .
      748     define variable v-change-sign           as integer   no-undo .
      749     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      750     define buffer buf_temp-browse-handle  for temp-browse-handle .
      751     if p-change-value > 0
      752     then do:
      753       if frame Dialog-Frame :height + p-change-value
      754           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      755       then do:
      756         assign
      757           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      758                           - (frame Dialog-Frame :height-chars)
      759         .
      760         if p-change-value <= 0
      761         then do:
      762           run diasize_position-resize-button in this-procedure .
      763           return .
      764         end.
      765       end.
      766     end.
      767     if p-change-value < 0
      768     then do:
      769       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      770       then do:
      771         assign
      772           p-change-value = v-diasize-orig-frame-height
      773                          - (frame Dialog-Frame :height-chars)
      774         .
      775         if p-change-value >= 0
      776         then do:
      777           run diasize_position-resize-button in this-procedure .
      778           return .
      779         end.
      780       end.
      781     end.
      782     if p-change-value >= 0
      783     then do:
      784       assign
      785         v-change-sign = 1
      786       .
      787     end.
      788     else do:
      789       assign
      790         v-change-sign = -1
      791       .
      792     end.
      793     assign
      794       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      795     .
      796     if p-change-value = 0
      797     then do:
      798       run diasize_position-resize-button in this-procedure .
      799       return .
      800     end.
      801     move_block:
      802     do
      803     on error undo move_block, retry move_block
      804     :
      805       if retry
      806       then do:
      807         do
      808         on error undo move_block, leave move_block
      809         :
      810           if p-change-value > 0
      811           then do:
      812             for each buf_temp-diasize-handle
      813             on error undo, next
      814             :
      815               assign
      816                 v-object-handle = buf_temp-diasize-handle.handle-value
      817               .
      818               if v-object-handle <> v-diasize-resize-button
      819               then do:
      820                 assign
      821                   v-object-handle :row = buf_temp-diasize-handle.save-position
      822                 .
      823               end.
      824             end.
      825             assign
      826               v-diasize-browse-handle :height = v-browse-height
      827             .
      828             for each buf_temp-browse-handle
      829               where buf_temp-browse-handle.browse-type = 'height':u
      830             on error undo, next
      831             :
      832               assign
      833                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      834               .
      835             end.
      836             assign
      837               frame Dialog-Frame :height = v-frame-height
      838             .
      839             if frame Dialog-Frame :scrollable = true
      840             then do:
      841               assign
      842                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      843               .
      844             end.
      845             run diasize_position-resize-button in this-procedure .
      846           end.
      847           else do:
      848             if frame Dialog-Frame :scrollable = true
      849             then do:
      850               assign
      851                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      852               .
      853             end.
      854             assign
      855               frame Dialog-Frame :height = v-frame-height
      856             .
      857             assign
      858               v-diasize-browse-handle :height = v-browse-height
      859             .
      860             for each buf_temp-browse-handle
      861               where buf_temp-browse-handle.browse-type = 'height':u
      862             on error undo, next
      863             :
      864               assign
      865                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      866               .
      867             end.
      868             for each buf_temp-diasize-handle
      869             on error undo, next
      870             :
      871               assign
      872                 v-object-handle = buf_temp-diasize-handle.handle-value
      873               .
      874               if v-object-handle <> v-diasize-resize-button
      875               then do:
      876                 assign
      877                   v-object-handle :row = buf_temp-diasize-handle.save-position
      878                 .
      879               end.
      880             end.
      881             run diasize_position-resize-button in this-procedure .
      882           end.
      883           assign
      884             v-diasize-change-size = false
      885           .
      886           leave move_block .
      887         end.
      888       end.
      889       assign
      890         v-diasize-need-full-display = true
      891       .
      892       if v-diasize-change-size = false
      893       then do:
      894         assign
      895           v-diasize-change-size = true
      896         .
      897       end.
      898       else do:
      899         return .
      900       end.
      901       assign
      902         v-frame-height = frame Dialog-Frame :height
      903         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      904         v-browse-height = v-diasize-browse-handle :height
      905       .
      906       for each buf_temp-browse-handle
      907         where buf_temp-browse-handle.browse-type = 'height':u
      908       :
      909         assign
      910           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      911         .
      912       end.
      913       for each buf_temp-diasize-handle
      914       :
      915         delete buf_temp-diasize-handle .
      916       end.
      917       assign
      918         v-field-group-handle = frame Dialog-Frame :first-child
      919       .
      920       do while valid-handle(v-field-group-handle)
      921       :
      922         assign
      923           v-object-handle = v-field-group-handle :first-child
      924         .
      925         do while valid-handle(v-object-handle)
      926         :
      927           if  v-object-handle <> v-diasize-browse-handle :handle
      928           and can-query(v-object-handle, "row")
      929           and can-query(v-object-handle, "height")
      930           and ( v-object-handle :row > v-diasize-browse-handle :row )
      931           then do:
      932             find first buf_temp-browse-handle
      933               where buf_temp-browse-handle.browse-type   = 'height':u
      934                 and buf_temp-browse-handle.browse-handle = v-object-handle
      935               no-error .
      936             if available buf_temp-browse-handle
      937             then do:
      938             end.
      939             else do:
      940               create buf_temp-diasize-handle .
      941               assign
      942                 buf_temp-diasize-handle.handle-value  = v-object-handle
      943                 buf_temp-diasize-handle.save-position = v-object-handle :row
      944               .
      945             end.
      946           end.
      947           assign
      948             v-object-handle = v-object-handle :next-sibling
      949           .
      950         end.
      951         assign
      952           v-field-group-handle = v-field-group-handle :next-sibling
      953         .
      954       end.
      955       do with frame Dialog-Frame
      956       :
      957         hide v-diasize-resize-button .
      958         assign
      959           v-diasize-resize-button :row    = 1
      960           v-diasize-resize-button :column = 1
      961         .
      962       end.
      963       if p-change-value > 0
      964       then do:
      965         if frame Dialog-Frame :scrollable = true
      966         then do:
      967           assign
      968             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      969             no-error .
      970           if error-status :error
      971           or error-status :get-message(1) <> ""
      972           then do:
      973             undo move_block, retry move_block .
      974           end.
      975         end.
      976         assign
      977           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      978           no-error .
      979         if error-status :error
      980         or error-status :get-message(1) <> ""
      981         then do:
      982           undo move_block, retry move_block .
      983         end.
      984         assign
      985           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      986           no-error .
      987         if error-status :error
      988         or error-status :get-message(1) <> ""
      989         then do:
      990           undo move_block, retry move_block .
      991         end.
      992         for each buf_temp-browse-handle
      993           where buf_temp-browse-handle.browse-type = 'height':u
      994         on error undo move_block, retry move_block
      995         :
      996           assign
      997             buf_temp-browse-handle.browse-handle :height
      998               = buf_temp-browse-handle.browse-handle :height + p-change-value
      999             no-error .
     1000           if error-status :error
     1001           or error-status :get-message(1) <> ""
     1002           then do:
     1003             undo move_block, retry move_block .
     1004           end.
     1005         end.
     1006         for each buf_temp-diasize-handle
     1007         on error undo move_block, retry move_block
     1008         :
     1009           assign
     1010             v-object-handle = buf_temp-diasize-handle.handle-value
     1011           .
     1012           if v-object-handle <> v-diasize-resize-button
     1013           then do:
     1014             assign
     1015               v-object-handle :row = v-object-handle :row + p-change-value
     1016               no-error .
     1017             if error-status :error
     1018             or error-status :get-message(1) <> ""
     1019             then do:
     1020               undo move_block, retry move_block .
     1021             end.
     1022           end.
     1023         end.
     1024       end.
     1025       else do:
     1026         for each buf_temp-diasize-handle
     1027         on error undo move_block, retry move_block
     1028         :
     1029           assign
     1030             v-object-handle = buf_temp-diasize-handle.handle-value
     1031           .
     1032           if v-object-handle <> v-diasize-resize-button
     1033           then do:
     1034             assign
     1035               v-object-handle :row = v-object-handle :row + p-change-value
     1036               no-error .
     1037             if error-status :error
     1038             or error-status :get-message(1) <> ""
     1039             then do:
     1040               undo move_block, retry move_block .
     1041             end.
     1042           end.
     1043         end.
     1044         assign
     1045           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1046           no-error .
     1047         if error-status :error
     1048         or error-status :get-message(1) <> ""
     1049         then do:
     1050           undo move_block, retry move_block .
     1051         end.
     1052         for each buf_temp-browse-handle
     1053           where buf_temp-browse-handle.browse-type = 'height':u
     1054         on error undo move_block, retry move_block
     1055         :
     1056           assign
     1057             buf_temp-browse-handle.browse-handle :height
     1058               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1059             no-error .
     1060           if error-status :error
     1061           or error-status :get-message(1) <> ""
     1062           then do:
     1063             undo move_block, retry move_block .
     1064           end.
     1065         end.
     1066         assign
     1067           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1068           no-error .
     1069         if error-status :error
     1070         or error-status :get-message(1) <> ""
     1071         then do:
     1072           undo move_block, retry move_block .
     1073         end.
     1074         if frame Dialog-Frame :scrollable = true
     1075         then do:
     1076           assign
     1077             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1078             no-error .
     1079           if error-status :error
     1080           or error-status :get-message(1) <> ""
     1081           then do:
     1082             undo move_block, retry move_block .
     1083           end.
     1084         end.
     1085       end.
     1086       if p-move-resize = true
     1087       then do:
     1088         run diasize_position-resize-button in this-procedure .
     1089       end.
     1090       if v-diasize-wndstore = true
     1091       then do:
     1092         if connected("ub") = true
     1093         then do:
     1094           define variable v-cntxt-db-num        as integer   no-undo .
     1095           define variable v-cntxt-userid        as character no-undo .
     1096           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1097                                             , OUTPUT v-cntxt-userid
     1098                                             ) .
     1099           run gbl/wndsizew.p
     1100             (input  v-cntxt-db-num
     1101             ,input  v-cntxt-userid
     1102             ,input  v-diasize-proc-name
     1103             ,input  'height':u
     1104             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1105             ) .
     1106         end.
     1107       end.
     1108     end.
     1109     assign
     1110       v-diasize-change-size = false
     1111     .
     1112   end procedure.
     1113   procedure diasize_set-height :
     1114     define input  parameter p-new-height  as decimal   no-undo .
     1115     define input  parameter p-move-resize as logical   no-undo .
     1116     do
     1117     on error undo, return error return-value
     1118     :
     1119       run diasize_change-height in this-procedure
     1120         (input  (p-new-height - frame Dialog-Frame :height)
     1121         ,input  p-move-resize
     1122         ) .
     1123     end.
     1124   end procedure.
     1125   procedure diasize_change-width :
     1126     define input  parameter p-change-value as decimal   no-undo .
     1127     define input  parameter p-move-resize  as logical   no-undo .
     1128     define variable v-field-group-handle   as handle    no-undo .
     1129     define variable v-object-handle        as handle    no-undo .
     1130     define variable v-frame-width          as decimal   no-undo .
     1131     define variable v-frame-virtual-width  as decimal   no-undo .
     1132     define variable v-browse-width         as decimal   no-undo .
     1133     define variable v-window-width         as decimal   no-undo .
     1134     define variable v-window-virtual-width as decimal   no-undo .
     1135     define variable v-change-sign          as integer   no-undo .
     1136     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1137     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1138     if p-change-value > 0
     1139     then do:
     1140       if frame Dialog-Frame :width + p-change-value >
     1141           session :width-chars
     1142       then do:
     1143         assign
     1144           p-change-value = session :width-chars - frame Dialog-Frame :width
     1145         .
     1146         if p-change-value <= 0
     1147         then do:
     1148           run diasize_position-resize-button in this-procedure .
     1149           return .
     1150         end.
     1151       end.
     1152     end.
     1153     if p-change-value < 0
     1154     then do:
     1155       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1156       then do:
     1157         assign
     1158           p-change-value = v-diasize-orig-frame-width
     1159                          - frame Dialog-Frame :width
     1160         .
     1161         if p-change-value >= 0
     1162         then do:
     1163           run diasize_position-resize-button in this-procedure .
     1164           return .
     1165         end.
     1166       end.
     1167     end.
     1168     if p-change-value >= 0
     1169     then do:
     1170       assign
     1171         v-change-sign = 1
     1172       .
     1173     end.
     1174     else do:
     1175       assign
     1176         v-change-sign = -1
     1177       .
     1178     end.
     1179     assign
     1180       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1181     .
     1182     if p-change-value = 0
     1183     then do:
     1184       run diasize_position-resize-button in this-procedure .
     1185       return .
     1186     end.
     1187     move_block:
     1188     do
     1189     on error undo move_block, leave move_block
     1190     :
     1191       if retry
     1192       then do:
     1193         do
     1194         on error undo move_block, leave move_block
     1195         :
     1196           if p-change-value > 0
     1197           then do:
     1198             for each buf_temp-diasize-handle
     1199             on error undo, next
     1200             :
     1201               assign
     1202                 v-object-handle = buf_temp-diasize-handle.handle-value
     1203               .
     1204               if v-object-handle <> v-diasize-resize-button
     1205               then do:
     1206                 assign
     1207                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1208                 .
     1209               end.
     1210             end.
     1211             assign
     1212               v-diasize-browse-handle :width = v-browse-width
     1213             .
     1214             for each buf_temp-browse-handle
     1215               where buf_temp-browse-handle.browse-type = 'width':u
     1216             on error undo, next
     1217             :
     1218               assign
     1219                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1220               .
     1221             end.
     1222             assign
     1223               frame Dialog-Frame :width = v-frame-width
     1224             .
     1225             if frame Dialog-Frame :scrollable = true
     1226             then do:
     1227               assign
     1228                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1229               .
     1230             end.
     1231             run diasize_position-resize-button in this-procedure .
     1232           end.
     1233           else do:
     1234             if frame Dialog-Frame :scrollable = true
     1235             then do:
     1236               assign
     1237                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1238               .
     1239             end.
     1240             assign
     1241               frame Dialog-Frame :width = v-frame-width
     1242             .
     1243             for each buf_temp-browse-handle
     1244               where buf_temp-browse-handle.browse-type = 'width':u
     1245             on error undo, next
     1246             :
     1247               assign
     1248                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1249               .
     1250             end.
     1251             assign
     1252               v-diasize-browse-handle :width = v-browse-width
     1253             .
     1254             for each buf_temp-diasize-handle
     1255             on error undo, next
     1256             :
     1257               assign
     1258                 v-object-handle = buf_temp-diasize-handle.handle-value
     1259               .
     1260               if v-object-handle <> v-diasize-resize-button
     1261               then do:
     1262                 assign
     1263                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1264                 .
     1265               end.
     1266             end.
     1267             run diasize_position-resize-button in this-procedure .
     1268           end.
     1269           assign
     1270             v-diasize-change-size = false
     1271           .
     1272           leave move_block .
     1273         end.
     1274       end.
     1275       assign
     1276         v-diasize-need-full-display = true
     1277       .
     1278       if v-diasize-change-size = false
     1279       then do:
     1280         assign
     1281           v-diasize-change-size = true
     1282         .
     1283       end.
     1284       else do:
     1285         return .
     1286       end.
     1287       assign
     1288         v-frame-width = frame Dialog-Frame :width
     1289         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1290         v-browse-width = v-diasize-browse-handle :width
     1291       .
     1292       for each buf_temp-browse-handle
     1293         where buf_temp-browse-handle.browse-type = 'width':u
     1294       :
     1295         assign
     1296           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1297         .
     1298       end.
     1299       for each buf_temp-diasize-handle
     1300       :
     1301         delete buf_temp-diasize-handle .
     1302       end.
     1303       assign
     1304         v-field-group-handle = frame Dialog-Frame :first-child
     1305       .
     1306       do while valid-handle(v-field-group-handle)
     1307       :
     1308         assign
     1309           v-object-handle = v-field-group-handle :first-child
     1310         .
     1311         do while valid-handle(v-object-handle)
     1312         :
     1313           if  v-object-handle <> v-diasize-browse-handle :handle
     1314           and v-object-handle <> v-diasize-resize-button
     1315           and can-query(v-object-handle, "row")
     1316           and can-query(v-object-handle, "height")
     1317           and ( v-object-handle :col + v-object-handle :width
     1318                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1319               )
     1320           then do:
     1321             find first buf_temp-browse-handle
     1322               where buf_temp-browse-handle.browse-type   = 'width':u
     1323                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1324               no-error .
     1325             if available buf_temp-browse-handle
     1326             then do:
     1327             end.
     1328             else do:
     1329               create buf_temp-diasize-handle .
     1330               assign
     1331                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1332                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1333               .
     1334             end.
     1335           end.
     1336           assign
     1337             v-object-handle = v-object-handle :next-sibling
     1338           .
     1339         end.
     1340         assign
     1341           v-field-group-handle = v-field-group-handle :next-sibling
     1342         .
     1343       end.
     1344       do with frame Dialog-Frame
     1345       :
     1346         hide v-diasize-resize-button .
     1347         v-diasize-resize-button :row = 1.
     1348         v-diasize-resize-button :column = 1.
     1349       end.
     1350       if p-change-value > 0
     1351       then do:
     1352         if frame Dialog-Frame :scrollable = true
     1353         then do:
     1354           assign
     1355             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1356             no-error .
     1357           if error-status :error
     1358           or error-status :get-message(1) <> ""
     1359           then do:
     1360             undo move_block, retry move_block.
     1361           end.
     1362         end.
     1363         assign
     1364           frame Dialog-Frame :width = v-frame-width + p-change-value
     1365           no-error .
     1366         if error-status :error
     1367         or error-status :get-message(1) <> ""
     1368         then do:
     1369           undo move_block, retry move_block.
     1370         end.
     1371         assign
     1372           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1373         no-error .
     1374         if error-status :error
     1375         or error-status :get-message(1) <> ""
     1376         then do:
     1377           undo move_block, retry move_block.
     1378         end.
     1379         for each buf_temp-browse-handle
     1380           where buf_temp-browse-handle.browse-type = 'width':u
     1381         on error undo move_block, retry move_block
     1382         :
     1383           assign
     1384             buf_temp-browse-handle.browse-handle :width
     1385               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1386             no-error .
     1387           if error-status :error
     1388           or error-status :get-message(1) <> ""
     1389           then do:
     1390             undo move_block, retry move_block .
     1391           end.
     1392         end.
     1393         for each buf_temp-diasize-handle
     1394         on error undo move_block, retry move_block
     1395         :
     1396           assign
     1397             v-object-handle = buf_temp-diasize-handle.handle-value
     1398           .
     1399           if v-object-handle <> v-diasize-resize-button
     1400           then do:
     1401             assign
     1402               v-object-handle :col = v-object-handle :col + p-change-value
     1403               no-error .
     1404             if error-status :error
     1405             or error-status :get-message(1) <> ""
     1406             then do:
     1407               undo move_block, retry move_block .
     1408             end.
     1409           end.
     1410         end.
     1411       end.
     1412       else do:
     1413         for each buf_temp-diasize-handle
     1414         on error undo move_block, retry move_block
     1415         :
     1416           assign
     1417             v-object-handle = buf_temp-diasize-handle.handle-value
     1418           .
     1419           if v-object-handle <> v-diasize-resize-button
     1420           then do:
     1421             assign
     1422               v-object-handle :col = v-object-handle :col + p-change-value
     1423               no-error .
     1424             if error-status :error
     1425             or error-status :get-message(1) <> ""
     1426             then do:
     1427               undo move_block, retry move_block .
     1428             end.
     1429           end.
     1430         end.
     1431         for each buf_temp-browse-handle
     1432           where buf_temp-browse-handle.browse-type = 'width':u
     1433         on error undo move_block, retry move_block
     1434         :
     1435           assign
     1436             buf_temp-browse-handle.browse-handle :width
     1437               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1438             no-error .
     1439           if error-status :error
     1440           or error-status :get-message(1) <> ""
     1441           then do:
     1442             undo move_block, retry move_block .
     1443           end.
     1444         end.
     1445         assign
     1446           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1447           no-error .
     1448         if error-status :error
     1449         or error-status :get-message(1) <> ""
     1450         then do:
     1451           undo move_block, retry move_block.
     1452         end.
     1453         assign
     1454           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1455         no-error .
     1456         if error-status :error
     1457         or error-status :get-message(1) <> ""
     1458         then do:
     1459           undo move_block, retry move_block.
     1460         end.
     1461         if frame Dialog-Frame :scrollable = true
     1462         then do:
     1463           assign
     1464             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1465           no-error .
     1466           if error-status :error
     1467           or error-status :get-message(1) <> ""
     1468           then do:
     1469             undo move_block, retry move_block.
     1470           end.
     1471         end.
     1472       end.
     1473       if p-move-resize
     1474       then do:
     1475         run diasize_position-resize-button in this-procedure .
     1476       end.
     1477       if v-diasize-wndstore = true
     1478       then do:
     1479         if connected("ub") = true
     1480         then do:
     1481           define variable v-cntxt-db-num        as integer   no-undo .
     1482           define variable v-cntxt-userid        as character no-undo .
     1483           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1484                                             , OUTPUT v-cntxt-userid
     1485                                             ) .
     1486           run gbl/wndsizew.p
     1487             (input  v-cntxt-db-num
     1488             ,input  v-cntxt-userid
     1489             ,input  v-diasize-proc-name
     1490             ,input  'width':u
     1491             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1492             ) .
     1493         end.
     1494       end.
     1495     end.
     1496     assign
     1497       v-diasize-change-size = false
     1498     .
     1499   end procedure.
     1500   procedure diasize_set-width :
     1501     define input  parameter p-new-width  as decimal   no-undo .
     1502     define input  parameter p-move-resize as logical   no-undo .
     1503     do
     1504     on error undo, return error return-value
     1505     :
     1506       run diasize_change-width in this-procedure
     1507         (input  (p-new-width - frame Dialog-Frame :width)
     1508         ,input  p-move-resize
     1509         ) .
     1510     end.
     1511   end procedure.
     1512   procedure diasize_position-resize-button :
     1513     do with frame Dialog-Frame
     1514     :
     1515       hide v-diasize-resize-button .
     1516       assign
     1517         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1518                     - 1
     1519                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1520         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1521                     - 1
     1522                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1523       .
     1524       view v-diasize-resize-button .
     1525     end.
     1526   end procedure.
     1527   on alt-right anywhere
     1528   do:
     1529     run diasize_change-width in this-procedure
     1530       (input 1
     1531       ,input true
     1532       ) .
     1533     return no-apply .
     1534   end.
     1535   on alt-left anywhere
     1536   do:
     1537     run diasize_change-width in this-procedure
     1538       (input -1
     1539       ,input true
     1540       ) .
     1541     return no-apply .
     1542   end.
     1543   on alt-down anywhere
     1544   do:
     1545     run diasize_change-height in this-procedure
     1546       (input 1
     1547       ,input true
     1548       ) .
     1549     return no-apply .
     1550   end.
     1551   on alt-up anywhere
     1552   do:
     1553     run diasize_change-height in this-procedure
     1554       (input -1
     1555       ,input true
     1556       ) .
     1557     return no-apply .
     1558   end.
     1559   on alt-enter of frame Dialog-Frame
     1560   do:
     1561     run diasize_maximize in this-procedure
     1562       (input  ?
     1563       ).
     1564     return no-apply .
     1565   end.
     1566   procedure diasize_end-move :
     1567     do
     1568     on error undo, return error return-value
     1569     :
     1570       define variable v-row-delta as decimal   no-undo .
     1571       define variable v-col-delta as decimal   no-undo .
     1572       define variable v-new-row as decimal   no-undo .
     1573       define variable v-new-col as decimal   no-undo .
     1574       assign
     1575         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1576         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1577       .
     1578       assign
     1579         v-row-delta = v-new-row - frame Dialog-Frame :height
     1580         v-col-delta = v-new-col - frame Dialog-Frame :width
     1581       .
     1582       run diasize_change-height in this-procedure
     1583         (input v-row-delta
     1584         ,input true
     1585         ) .
     1586       run diasize_change-width in this-procedure
     1587         (input v-col-delta
     1588         ,input true
     1589         ) .
     1590     end.
     1591   end procedure.
     1592   procedure diasize_maximize :
     1593     define input  parameter p-action as logical   no-undo .
     1594     do
     1595     on error undo, return error return-value
     1596     :
     1597       if p-action = ?
     1598       then do:
     1599         if v-diasize-need-maximize = true
     1600         then do:
     1601           assign
     1602             p-action = true
     1603           .
     1604         end.
     1605         else do:
     1606           assign
     1607             p-action = false
     1608           .
     1609         end.
     1610       end.
     1611       if p-action = true
     1612       then do:
     1613         run diasize_change-height in this-procedure
     1614           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1615               - frame Dialog-Frame :height-chars
     1616           ,input true
     1617           ) .
     1618         run diasize_change-width in this-procedure
     1619           (input session :width-chars
     1620               - frame Dialog-Frame :width-chars
     1621           ,input true
     1622           ) .
     1623         assign
     1624           v-diasize-need-maximize = false
     1625         .
     1626       end.
     1627       else do:
     1628         run diasize_change-width in this-procedure
     1629           (input v-diasize-orig-frame-width
     1630               - frame Dialog-Frame :width-chars
     1631           ,input true
     1632           ) .
     1633         run diasize_change-height in this-procedure
     1634           (input v-diasize-orig-frame-height
     1635               - frame Dialog-Frame :height-chars
     1636           ,input true
     1637           ) .
     1638         assign
     1639           v-diasize-need-maximize = true
     1640         .
     1641       end.
     1642     end.
     1643   end procedure.
     1644   procedure diasize_restore-orig-size :
     1645     do
     1646     on error undo, return error return-value
     1647     :
     1648       assign
     1649         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1650         v-diasize-current-frame-height = frame Dialog-Frame :height
     1651       .
     1652       run diasize_set-height in this-procedure
     1653         (input  v-diasize-orig-frame-height
     1654         ,input  true
     1655         ) .
     1656       run diasize_set-width in this-procedure
     1657         (input  v-diasize-orig-frame-width
     1658         ,input  true
     1659         ) .
     1660     end.
     1661   end procedure.
     1662   procedure diasize_restore-current-size :
     1663     do
     1664     on error undo, return error return-value
     1665     :
     1666       run diasize_set-height in this-procedure
     1667         (input  v-diasize-current-frame-height
     1668         ,input  true
     1669         ) .
     1670       run diasize_set-width in this-procedure
     1671         (input  v-diasize-current-frame-width
     1672         ,input  true
     1673         ) .
     1674     end.
     1675   end procedure.
     1676   procedure diasize_set-browse-handle :
     1677     define input  parameter p-browse-handle as handle   no-undo .
     1678     define buffer buf_temp-browse-handle for temp-browse-handle .
     1679     do
     1680     on error undo, return error return-value
     1681     :
     1682       assign
     1683         v-diasize-browse-handle = p-browse-handle
     1684       .
     1685       for each buf_temp-browse-handle
     1686       on error undo, return error return-value
     1687       :
     1688         delete buf_temp-browse-handle .
     1689       end.
     1690     end.
     1691   end procedure.
     1692   procedure diasize_add_browse :
     1693     define input  parameter p-browse-type   as character no-undo .
     1694     define input  parameter p-browse-handle as handle    no-undo .
     1695     define buffer buf_temp-browse-handle for temp-browse-handle .
     1696     do
     1697     on error undo, return error return-value
     1698     :
     1699       assign
     1700         v-diasize-browse-number = v-diasize-browse-number + 1
     1701       .
     1702       create buf_temp-browse-handle .
     1703       assign
     1704         buf_temp-browse-handle.browse-type   = p-browse-type
     1705         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1706         buf_temp-browse-handle.browse-handle = p-browse-handle
     1707       .
     1708     end.
     1709   end procedure.
     1710   procedure diasize_init :
     1711     define variable v-default-value    as logical   no-undo .
     1712     define variable v-restore-saved    as logical   no-undo .
     1713     define variable v-resize-value-str as character no-undo .
     1714     do
     1715     on error undo, return error return-value
     1716     :
     1717       do with frame Dialog-Frame
     1718       :
     1719         assign
     1720           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1721           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1722           v-diasize-browse-handle     = browse BROWSE-3 :handle
     1723         .
     1724         create button v-diasize-resize-button
     1725         assign
     1726           parent        = frame Dialog-Frame :first-child
     1727           label         = "s"
     1728           height-pixels = 16
     1729           width-pixels  = 16
     1730           visible       = true
     1731           sensitive     = true
     1732           movable       = true
     1733           triggers:
     1734             on end-move persistent run diasize_end-move in this-procedure .
     1735           end triggers.
     1736         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1737         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1738         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1739         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1740         assign
     1741           v-diasize-wndmax = false
     1742         .
     1743         if connected("ub") = true
     1744         then do:
     1745           define variable v-cntxt-db-num        as integer   no-undo .
     1746           define variable v-cntxt-userid        as character no-undo .
     1747           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1748                                             , OUTPUT v-cntxt-userid
     1749                                             ) .
     1750           run gbl/wndpar_r.p
     1751             (input  v-cntxt-db-num
     1752             ,input  v-cntxt-userid
     1753             ,input  'wndmax':U
     1754             ,output v-diasize-wndmax
     1755             ,output v-default-value
     1756             ) .
     1757         end.
     1758         assign
     1759           v-diasize-wndstore = false
     1760         .
     1761         if connected("ub") = true
     1762         then do:
     1763           run gbl/wndpar_r.p
     1764             (input  v-cntxt-db-num
     1765             ,input  v-cntxt-userid
     1766             ,input  'wndstore':U
     1767             ,output v-diasize-wndstore
     1768             ,output v-default-value
     1769             ) .
     1770         end.
     1771         assign
     1772           v-diasize-proc-name = entry(1, program-name(2), '.')
     1773         .
     1774         if v-diasize-wndstore = true
     1775         then do:
     1776           assign
     1777             v-restore-saved = false
     1778           .
     1779           if connected("ub") = true
     1780           then do:
     1781             run gbl/wndsizer.p
     1782               (input  v-cntxt-db-num
     1783               ,input  v-cntxt-userid
     1784               ,input  v-diasize-proc-name
     1785               ,input  'height':u
     1786               ,output v-resize-value-str
     1787               ) .
     1788             if v-resize-value-str <> '':U
     1789             then do:
     1790               run diasize_change-height in this-procedure
     1791                 (input  integer(v-resize-value-str)
     1792                 ,input  true
     1793                 ) .
     1794               assign
     1795                 v-restore-saved = true
     1796               .
     1797             end.
     1798           end.
     1799           if connected("ub") = true
     1800           then do:
     1801             run gbl/wndsizer.p
     1802               (input  v-cntxt-db-num
     1803               ,input  v-cntxt-userid
     1804               ,input  v-diasize-proc-name
     1805               ,input  'width':u
     1806               ,output v-resize-value-str
     1807               ) .
     1808             if v-resize-value-str <> '':U
     1809             then do:
     1810               run diasize_change-width in this-procedure
     1811                 (input  integer(v-resize-value-str)
     1812                 ,input  true
     1813                 ) .
     1814               assign
     1815                 v-restore-saved = true
     1816               .
     1817             end.
     1818           end.
     1819           if v-restore-saved <> true
     1820           then do:
     1821             if v-diasize-wndmax = true
     1822             then do:
     1823               run diasize_maximize in this-procedure
     1824                 (input  true
     1825                 ) .
     1826             end.
     1827           end.
     1828         end.
     1829         else do:
     1830           if v-diasize-wndmax = true
     1831           then do:
     1832             run diasize_maximize in this-procedure
     1833               (input  true
     1834               ) .
     1835           end.
     1836         end.
     1837       end.
     1838     end.
     1839   end procedure.
     1840   procedure diasize_need-full-display :
     1841     define output parameter p-need-full-display as logical   no-undo .
     1842     do
     1843     on error undo, return error return-value
     1844     :
     1845       assign
     1846         p-need-full-display = v-diasize-need-full-display
     1847       .
     1848       assign
     1849         v-diasize-need-full-display = false
     1850       .
     1851     end.
     1852   end procedure.
     1853   procedure get-context :
     1854      define output parameter p-db-num as integer          no-undo.
     1855      define output parameter p-user-id as character        no-undo.
     1856      define variable v-login               as character    no-undo.
     1857      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1858      define buffer buf_user-login  for ub.user-login .
     1859      do
     1860      on error undo, return error
     1861      :
     1862            FIND FIRST buf_sys-ctrl no-lock.
     1863            ASSIGN
     1864               v-login = USERID("ub")
     1865               p-db-num = buf_sys-ctrl.db-num
     1866            .
     1867            FIND FIRST buf_user-login
     1868                 WHERE buf_user-login.db-num = p-db-num
     1869                   AND buf_user-login.user-login = v-login
     1870                 no-lock
     1871                 no-error
     1872                 .
     1873            IF AVAILABLE buf_user-login
     1874            THEN DO:
     1875               assign
     1876                  p-user-id = buf_user-login.user-id
     1877               .
     1878            END.
     1879      end.
     1880   end procedure.
     1881       run diasize_init in this-procedure .
     1882   assign
     1883     parnext-prev = yes
     1884   .
     1885   n-p:
     1886   do while parnext-prev :
     1887   MAIN-BLOCK:
     1888   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1889      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1890   define variable loc#log as logical   no-undo .
     1891   find first buf_ord-doc no-lock where recid(buf_ord-doc) = v-doc-rec no-error .
     1892   if error-status :error then message
     1893     vss-workfile vss-revision vss-description skip
     1894     error-status :get-message(1) skip
     1895     return-value skip
     1896     "Ошибка нет заказа с №"
     1897     p-doc-code
     1898     view-as alert-box error
     1899   .
     1900   p-doc-code = buf_ord-doc.doc-code .
     1901    if not ( buf_ord-doc.doc-type = 'ОП':U or
     1902         buf_ord-doc.doc-type = 'ПО':U or
     1903         buf_ord-doc.doc-type = 'ФП':U ) then do:
     1904        message "Для заказов типа " buf_ord-doc.doc-type
     1905               "Этот режим не работает"
     1906               view-as alert-box information .
     1907               parnext-prev = ? .
     1908        return .
     1909       end.
     1910       RUN init-tt.
     1911       RUN enable_UI.
     1912       RUN init-proc.
     1913     WAIT-FOR GO OF FRAME Dialog-Frame.
     1914   END.
     1915   end.
     1916   RUN disable_UI.
     1917   PROCEDURE bg-col :
     1918   define input  parameter p-color as integer   no-undo .
     1919   assign
     1920     tt_ord-line.gds-code :bgcolor in browse BROWSE-3 = p-color
     1921     tt_ord-line.artic    :bgcolor in browse BROWSE-3 = p-color
     1922     buf_goods.gds-name   :bgcolor in browse BROWSE-3 = p-color
     1923     buf_goods.unit-base  :bgcolor in browse BROWSE-3 = p-color
     1924     tt_ord-line.qnty:bgcolor in browse BROWSE-3 = p-color
     1925     tt_ord-line.qnty-rcv:bgcolor in browse BROWSE-3 = p-color
     1926     tt_ord-line.qnty-trn:bgcolor in browse BROWSE-3 = p-color
     1927   .
     1928   END PROCEDURE.
     1929   PROCEDURE disable_UI :
     1930     HIDE FRAME Dialog-Frame.
     1931   END PROCEDURE.
     1932   PROCEDURE enable_UI :
     1933     DISPLAY COMBO-status i-ord i-rcv i-trn v-status
     1934         WITH FRAME Dialog-Frame.
     1935     ENABLE B-exit B-quit B-rcv B-trn B-print B-Help B-prev B-next BROWSE-3 i-ord
     1936            i-rcv i-trn v-status
     1937         WITH FRAME Dialog-Frame.
     1938     VIEW FRAME Dialog-Frame.
     1939     OPEN QUERY BROWSE-3 FOR EACH tt_ord-line NO-LOCK,              EACH buf_goods WHERE buf_goods.gds-code = tt_ord-line.gds-code NO-LOCK INDEXED-REPOSITION.
     1940   END PROCEDURE.
     1941   PROCEDURE fill-widgets :
     1942   END PROCEDURE.
     1943   PROCEDURE init-proc :
     1944     buf_goods.gds-name  :resizable in browse BROWSE-3 = true .
     1945     tt_ord-line.artic   :resizable in browse BROWSE-3 = true .
     1946     tt_ord-line.qnty-rcv:resizable in browse BROWSE-3 = true .
     1947     buf_goods.gds-name  :width     in browse BROWSE-3   = v-size-col2 .
     1948     tt_ord-line.artic   :width     in browse BROWSE-3   = v-size-col1 .
     1949     tt_ord-line.qnty-rcv  :width     in browse BROWSE-3   = v-size-col3 .
     1950     frame Dialog-Frame:title = "Состояние заказа № " + buf_ord-doc.doc-code .
     1951     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1952        B-exit:label in frame Dialog-Frame  = "Вы&ход"  .
     1953        hide B-quit in frame Dialog-Frame .
     1954     END.
     1955    hide b-print  in frame Dialog-Frame .
     1956   end procedure.
     1957   PROCEDURE init-tt :
     1958   empty temp-table tt_ord-line.
     1959   empty temp-table tt_doc-line.
     1960   empty temp-table tt_ord-line-rcv.
     1961   vi-total-ord = 0.
     1962   vi-total-rcv = 0.
     1963   vi-total-trn = 0.
     1964   for each buf_ord-line no-lock where
     1965            buf_ord-line.doc-code = buf_ord-doc.doc-code
     1966            :
     1967           find first buf_goods no-lock where
     1968                     buf_goods.artic     = buf_ord-line.artic and
     1969                     buf_goods.prod-type = buf_ord-line.prod-type and
     1970                     buf_goods.prod-code = buf_ord-line.prod-code no-error .
     1971            create  tt_ord-line.
     1972            buffer-copy buf_ord-line to tt_ord-line
     1973            assign
     1974              tt_ord-line.type-str = "ord"
     1975              tt_ord-line.gds-code = buf_goods.gds-code
     1976            .
     1977         v-total-rcv = 0 .
     1978        for each  buf_ord-doc-rcv no-lock where
     1979                  buf_ord-doc-rcv.doc-code = buf_ord-line.doc-code :
     1980             for each buf_ord-line-rcv no-lock where
     1981                      buf_ord-line-rcv.doc-code = buf_ord-doc-rcv.doc-code and
     1982                      buf_ord-line-rcv.rcv-code = buf_ord-doc-rcv.rcv-code and
     1983                      buf_ord-line-rcv.artic    = buf_ord-line.artic and
     1984                      buf_ord-line-rcv.prod-type= buf_ord-line.prod-type and
     1985                      buf_ord-line-rcv.prod-code= buf_ord-line.prod-code :
     1986                     create  tt_ord-line-rcv.
     1987                     buffer-copy buf_ord-line-rcv to tt_ord-line-rcv
     1988                      assign
     1989                        tt_ord-line-rcv.gds-code = buf_goods.gds-code
     1990                     .
     1991                     v-total-rcv = v-total-rcv + buf_ord-line-rcv.qnty .
     1992                     vi-total-rcv = vi-total-rcv + buf_ord-line-rcv.qnty .
     1993             end.
     1994        end.
     1995         assign
     1996           tt_ord-line.qnty-rcv = v-total-rcv
     1997         .
     1998         vi-total-ord = vi-total-ord + buf_ord-line.qnty .
     1999   end.
     2000   define buffer bufn_ord-line-rcv for ub.ord-line-rcv  .
     2001   for each bufn_ord-line-rcv no-lock where
     2002            bufn_ord-line-rcv.doc-code = buf_ord-doc.doc-code
     2003            :
     2004           find first buf_goods no-lock where
     2005                     buf_goods.artic     = bufn_ord-line-rcv.artic     and
     2006                     buf_goods.prod-type = bufn_ord-line-rcv.prod-type and
     2007                     buf_goods.prod-code = bufn_ord-line-rcv.prod-code
     2008                     no-error .
     2009            find first tt_ord-line where
     2010                       tt_ord-line.artic     =  buf_goods.artic      and
     2011                       tt_ord-line.prod-type =  buf_goods.prod-type  and
     2012                       tt_ord-line.prod-code =  buf_goods.prod-code
     2013                       no-error .
     2014      if not available tt_ord-line then do:
     2015            create  tt_ord-line.
     2016            buffer-copy bufn_ord-line-rcv to tt_ord-line
     2017            assign
     2018              tt_ord-line.qnty = 0
     2019              tt_ord-line.type-str = "rcv"
     2020              tt_ord-line.gds-code = buf_goods.gds-code
     2021            .
     2022         v-total-rcv = 0 .
     2023        for each  buf_ord-doc-rcv no-lock where
     2024                  buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code :
     2025             for each buf_ord-line-rcv no-lock where
     2026                      buf_ord-line-rcv.doc-code = buf_ord-doc-rcv.doc-code and
     2027                      buf_ord-line-rcv.rcv-code = buf_ord-doc-rcv.rcv-code and
     2028                      buf_ord-line-rcv.artic    = bufn_ord-line-rcv.artic and
     2029                      buf_ord-line-rcv.prod-type= bufn_ord-line-rcv.prod-type and
     2030                      buf_ord-line-rcv.prod-code= bufn_ord-line-rcv.prod-code :
     2031                     create  tt_ord-line-rcv.
     2032                     buffer-copy buf_ord-line-rcv to tt_ord-line-rcv
     2033                      assign
     2034                        tt_ord-line-rcv.gds-code = buf_goods.gds-code
     2035                     .
     2036                     v-total-rcv  = v-total-rcv  + buf_ord-line-rcv.qnty .
     2037                     vi-total-rcv = vi-total-rcv + buf_ord-line-rcv.qnty .
     2038             end.
     2039        end.
     2040         assign
     2041           tt_ord-line.qnty-rcv = v-total-rcv
     2042         .
     2043   end.
     2044   end.
     2045   for each buf_ord-doc-rcv no-lock where
     2046            buf_ord-doc-rcv.doc-code = p-doc-code :
     2047      for each ub.ord-chain no-lock where
     2048               ub.ord-chain.doc-code = buf_ord-doc-rcv.rcv-code and
     2049               ub.ord-chain.doc-type = 'rcv'                  and
     2050               ub.ord-chain.rel-doc-type = 'trn'
     2051               :
     2052        for each buf_trn-doc no-lock where
     2053                 buf_trn-doc.doc-code = ub.ord-chain.rel-doc-code :
     2054            for each buf_doc-line no-lock where
     2055                     buf_doc-line.doc-code = buf_trn-doc.doc-code :
     2056                     if not can-find ( first tt_doc-line where
     2057                      tt_doc-line.doc-code = buf_doc-line.doc-code  and
     2058                      tt_doc-line.artic    = buf_doc-line.artic and
     2059                      tt_doc-line.prod-type= buf_doc-line.prod-type and
     2060                      tt_doc-line.prod-code= buf_doc-line.prod-code ) then do:
     2061                         create  tt_doc-line.
     2062                         buffer-copy buf_doc-line to tt_doc-line.
     2063                         vi-total-trn = vi-total-trn + buf_doc-line.fact-qnty .
     2064                         find first tt_ord-line where
     2065                                    tt_ord-line.doc-code  = p-doc-code and
     2066                                    tt_ord-line.artic     = buf_doc-line.artic and
     2067                                    tt_ord-line.prod-type = buf_doc-line.prod-type and
     2068                                    tt_ord-line.prod-code = buf_doc-line.prod-code no-error .
     2069                         if available tt_ord-line then do:
     2070                            tt_ord-line.qnty-trn = tt_ord-line.qnty-trn + buf_doc-line.fact-qnty.
     2071                         end.
     2072                         else do:
     2073                           find first buf_goods no-lock where
     2074                                    buf_goods.artic     = buf_doc-line.artic and
     2075                                    buf_goods.prod-type = buf_doc-line.prod-type and
     2076                                    buf_goods.prod-code = buf_doc-line.prod-code no-error .
     2077                           create  tt_ord-line.
     2078                           buffer-copy buf_doc-line to tt_ord-line
     2079                           assign
     2080                             tt_ord-line.doc-code = p-doc-code
     2081                             tt_ord-line.gds-code = buf_goods.gds-code
     2082                             tt_ord-line.type-str = "trn"
     2083                             tt_ord-line.qnty     = 0
     2084                             tt_ord-line.qnty-trn = buf_doc-line.fact-qnty
     2085                           .
     2086                         end.
     2087                      end.
     2088            end.
     2089        end.
     2090        end.
     2091   end.
     2092   i-ord = vi-total-ord .
     2093   i-rcv = vi-total-rcv .
     2094   i-trn = vi-total-trn .
     2095   v-status = buf_ord-doc.status_ + string( buf_ord-doc.flag_,"+/-" ) .
     2096   if i-ord = i-rcv and
     2097      i-rcv = i-trn then COMBO-status = 0 .
     2098   else COMBO-status = 3.
     2099   END PROCEDURE.
     2100   PROCEDURE save-proc :
     2101   define variable v-list-new as character no-undo .
     2102   assign
     2103      v-list-new =  string(decimal( tt_ord-line.artic  :width in browse BROWSE-3)) +  chr(4)
     2104                  + string(decimal( buf_goods.gds-name :width  in browse BROWSE-3))  +  chr(4)
     2105                  + string(decimal( tt_ord-line.qnty-rcv :width  in browse BROWSE-3))  +  chr(4) .
     2106   run uf-set in this-procedure(
     2107       input  'ord-sost-p':U
     2108       ,input v-cntxt-userid
     2109       ,input v-list-new
     2110       ,input v-uf-Naim
     2111       ,input v-uf-print-graft
     2112       ,input v-uf-sort-gr
     2113       ,input v-uf-type-price
     2114       ,input v-uf-type-val
     2115   )  no-error   .
     2116   END PROCEDURE.
     2117   procedure step-next :
     2118   define buffer new_ord-doc for ub.ord-doc  .
     2119   if bf-handle = ? then return .
     2120   if valid-handle (br-handle) then do:
     2121     varlog = br-handle:select-next-row().
     2122     find first new_ord-doc no-lock where  recid( new_ord-doc ) = bf-handle:recid no-error .
     2123     if not varlog then message "Это последний заказ списка.".
     2124   end.
     2125   assign
     2126       v-doc-rec   = bf-handle:recid
     2127       parnext-prev = true
     2128        .
     2129   end procedure.
     2130   procedure step-prev :
     2131   define buffer new_ord-doc for ub.ord-doc  .
     2132   if bf-handle = ? then return .
     2133   if valid-handle (br-handle) then do:
     2134     varlog = br-handle:select-prev-row().
     2135     find first new_ord-doc no-lock where  recid( new_ord-doc ) = bf-handle:recid no-error .
     2136     if not varlog then message "Это первый заказ списка.".
     2137   end.
     2138   assign
     2139     v-doc-rec    = bf-handle:recid
     2140     parnext-prev = true
     2141   .
     2142   end procedure.
