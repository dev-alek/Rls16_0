      149     define output parameter p-use-List_     as logical   no-undo .
      150     define output parameter p-type-List_     as character no-undo .
      151     define output parameter p-format-List_   as character no-undo .
      152     define output parameter p-use-Naim      as logical   no-undo .
      153     define output parameter p-type-Naim      as character no-undo .
      154     define output parameter p-format-Naim    as character no-undo .
      155     define output parameter p-use-print-graft as logical   no-undo .
      156     define output parameter p-use-sort-gr   as logical   no-undo .
      157     define output parameter p-use-type-price as logical   no-undo .
      158     define output parameter p-use-type-val  as logical   no-undo .
