     1492           gds-zap-artic column-label "Артикул! ! ":C16 format "X(16)" space(0)
     1493           sym2 column-label ":!:!:" format "x(1)"                         space(0)
     1494           gds-zap-gds-name column-label "Название товара! ! ":C36 format "X(36)" space(0)
     1495           sym3 column-label ":!:!:" format "x(1)"                                     space(0)
     1496           gds-zap-unit-base column-label "Ед.!изм! " format "X(3)"                  space(0)
     1497           sym4 column-label ":!:!:" format "x(1)"                                     space(0)
     1498           gds-type column-label "Тип!данных! ":C6 format "X(6)"                  space(0)
     1499           sym5 column-label ":!:!:" format "x(1)" space(0)
     1500           F-ostatok-start     column-label "Остаток на!начало! ":C14 format "x(14)"           space(0)
     1501           sym6 column-label ":!:!:" format "x(1)" space(0)
     1502           F-Prih       column-label "Приход! ! ":C14     Format "x(14)"     space(0)
