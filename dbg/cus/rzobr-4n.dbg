     1721    ostatok-end [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1722    b1-ostatok-end [1 + 0] =  b1-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1723    b1-ostatok-end [2 + 0] =  b1-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1724    b1-ostatok-end [3 + 0] =  b1-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1725    b2-ostatok-end [1 + 0] =  b2-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1726    b2-ostatok-end [2 + 0] =  b2-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1727    b2-ostatok-end [3 + 0] =  b2-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1728    .
     1729    assign
     1730     bi-ostatok-end [1 + 0] =  bi-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1731     bi-ostatok-end [2 + 0] =  bi-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1732     bi-ostatok-end [3 + 0] =  bi-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1733    .
     1734   If  xshowcrsa or vat-crsa Then DO:
     1735   run ost-line in this-procedure
     1736                  (input   x-store-code  ,
     1737                   input   x-store-type  ,
     1738                   input   gds-zap-artic     ,
     1739                   input   gds-zap-prod-code ,
     1740                   input   gds-zap-prod-type ,
     1741                   input   x-tog-shift       ,
     1742                   input   Fact-order-2               ,
     1743                   input   'crsa':U            ,
     1744                   input   '##,##':U    ,
     1745                   input   xtog-obj    ,
     1746                   output  quantity    ,
     1747                   output  coast_r     ,
     1748                   output  coast_v     ,
     1749                   output  vat_r       ,
     1750                   output  vat_v       ,
     1751                   output  slt_r       ,
     1752                   output  slt_v       ).
     1753   assign
     1754     ostatok-end [4]        = round(ostatok-end [1] *  p-price-med , 2)
     1755    ostatok-end [2 + 3]   = if tprintrubl then coast_r else coast_v
     1756    ostatok-end [3 + 3]   = if tprintrubl then vat_r   else vat_v
     1757    b1-ostatok-end [1 + 3] =  b1-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1758    b1-ostatok-end [2 + 3] =  b1-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1759    b1-ostatok-end [3 + 3] =  b1-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1760    b2-ostatok-end [1 + 3] =  b2-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1761    b2-ostatok-end [2 + 3] =  b2-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1762    b2-ostatok-end [3 + 3] =  b2-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1763    .
     1764    assign
     1765     bi-ostatok-end [1 + 3] =  bi-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1766     bi-ostatok-end [2 + 3] =  bi-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1767     bi-ostatok-end [3 + 3] =  bi-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1768    .
     1769      End.
     1770   If xshowsale or vat-sale Then DO:
     1771   run ost-line in this-procedure
     1772                  (input   x-store-code  ,
     1773                   input   x-store-type  ,
     1774                   input   gds-zap-artic     ,
     1775                   input   gds-zap-prod-code ,
     1776                   input   gds-zap-prod-type ,
     1777                   input   x-tog-shift       ,
     1778                   input   Fact-order-2               ,
     1779                   input   'crsa':U            ,
     1780                   input   '##,##':U    ,
     1781                   input   xtog-obj    ,
     1782                   output  quantity    ,
     1783                   output  coast_r     ,
     1784                   output  coast_v     ,
     1785                   output  vat_r       ,
     1786                   output  vat_v       ,
     1787                   output  slt_r       ,
     1788                   output  slt_v       ).
     1789   assign
     1790     ostatok-end [1 + 6]   = quantity
     1791    ostatok-end [2 + 6]   = if tprintrubl then coast_r else coast_v
     1792    ostatok-end [3 + 6]   = if tprintrubl then vat_r   else vat_v
     1793    ostatok-end [10]        = if tprintrubl then slt_r   else slt_v
     1794    b1-ostatok-end [1 + 6] =  b1-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1795    b1-ostatok-end [2 + 6] =  b1-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1796    b1-ostatok-end [3 + 6] =  b1-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1797    b2-ostatok-end [1 + 6] =  b2-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1798    b2-ostatok-end [2 + 6] =  b2-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1799    b2-ostatok-end [3 + 6] =  b2-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1800    b1-ostatok-end [10] =  b1-ostatok-end [10] + ostatok-end [10]
     1801    b2-ostatok-end [10] =  b2-ostatok-end [10] + ostatok-end [10]
     1802    .
     1803    assign
     1804     bi-ostatok-end [1 + 6] =  bi-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     1805     bi-ostatok-end [2 + 6] =  bi-ostatok-end [2 + 6] + ostatok-end [2 + 6]
     1806     bi-ostatok-end [3 + 6] =  bi-ostatok-end [3 + 6] + ostatok-end [3 + 6]
     1807     bi-ostatok-end [10] =  bi-ostatok-end [10] + ostatok-end [10]
     1808    .
     1809      End.
     1810       case  gds-zap-type :
     1811       when 'у':U THEN DO:
     1812         run ob-line (
     1813             input   x-store-code   ,
     1814             input   x-store-type   ,
     1815             INPUT   gds-zap-artic       ,
     1816             INPUT   gds-zap-prod-code   ,
     1817             INPUT   gds-zap-prod-type   ,
     1818             INPUT   Fact-order-1,
     1819             INPUT   Fact-order-2,
     1820             input   'cssr':U    ,
     1821             input   '##,##':U,
     1822             input   ""    ,
     1823             input   xTog-obj) .
     1824        End.
     1825       when 'т':U THEN DO:
     1826         run ob-line (
     1827             input   x-store-code   ,
     1828             input   x-store-type   ,
     1829             INPUT   gds-zap-artic       ,
     1830             INPUT   gds-zap-prod-code   ,
     1831             INPUT   gds-zap-prod-type   ,
     1832             INPUT   Fact-order-1,
     1833             INPUT   Fact-order-2,
     1834             input   'cost':U    ,
     1835             input   '##,##':U,
     1836             input   ""    ,
     1837             input   xTog-obj) .
     1838         End.
     1839         End case.
     1840      run calc-sub-itog (0).
     1841     If xshowcrsa OR  xshowsale or vat-crsa or vat-sale Then DO:
     1842       case  gds-zap-type :
     1843       when 'у':U THEN DO:
     1844         run ob-line (
     1845             input   x-store-code   ,
     1846             input   x-store-type   ,
     1847             INPUT   gds-zap-artic       ,
     1848             INPUT   gds-zap-prod-code   ,
