     3718     excel-sum(ostatok-start[6])  CHR(9)
     3719     excel-sum(ostatok-start[9])  CHR(9)
     3720     excel-qnty(Prih         [1])  CHR(9)
     3721     excel-sum(Prih         [2])  CHR(9)
     3722     excel-sum(Prih         [5])  CHR(9)
     3723     excel-sum(Prih         [8])  CHR(9)
     3724     excel-sum(Prih         [3])  CHR(9)
     3725     excel-sum(Prih         [6])  CHR(9)
     3726     excel-sum(Prih         [9])  CHR(9)
     3727     excel-qnty(RAsh         [1])  CHR(9)
     3728     excel-sum(RAsh         [2])  CHR(9)
     3729     excel-sum(RAsh         [5])  CHR(9)
     3730     excel-sum(RAsh         [8])  CHR(9)
     3731     excel-sum(RAsh         [3])  CHR(9)
     3732     excel-sum(RAsh         [6])  CHR(9)
     3733     excel-sum(RAsh         [9])  CHR(9)
     3734     excel-qnty(KAssa        [1])  CHR(9)
     3735     excel-sum(KAssa        [2])  CHR(9)
     3736     excel-sum(KAssa        [5])  CHR(9)
     3737     excel-sum(KAssa        [8])  CHR(9)
     3738     excel-sum(KAssa        [3])  CHR(9)
     3739     excel-sum(KAssa        [6])  CHR(9)
     3740     excel-sum(KAssa        [9])  CHR(9)
     3741     excel-qnty(Inv          [1])  CHR(9)
     3742     excel-sum(Inv          [2])  CHR(9)
     3743     excel-sum(Inv          [5])  CHR(9)
     3744     excel-sum(Inv          [8])  CHR(9)
     3745     excel-sum(Inv          [3])  CHR(9)
     3746     excel-sum(Inv          [6])  CHR(9)
     3747     excel-sum(Inv          [9])  CHR(9)
     3748     excel-qnty(Overturn     [1])  CHR(9)
     3749     excel-sum(Overturn     [2])  CHR(9)
     3750     excel-sum(Overturn     [5])  CHR(9)
     3751     excel-sum(Overturn     [8])  CHR(9)
     3752     excel-sum(Overturn     [3])  CHR(9)
     3753     excel-sum(Overturn     [6])  CHR(9)
     3754     excel-sum(Overturn     [9])  CHR(9)
     3755     excel-qnty(Ostatok-end  [1])  CHR(9)
     3756     excel-sum(Ostatok-end  [2])  CHR(9)
