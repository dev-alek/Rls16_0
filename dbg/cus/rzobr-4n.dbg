     2558   PROCEDURE CalcItog :
     2559       run ostatok (
     2560           input x-store-code  ,
     2561           input x-store-type  ,x-TOG-Shift,
     2562           input x-date-start - 1 ,
     2563           input date('')      , x-Shift-Start,x-Shift-End,
     2564           input 'crsa':U   ,
     2565           input '##,##':U,
     2566           input xTog-obj ,
     2567           output  Quantity1  ,
     2568           output  Coast_R1   ,
     2569           output  Coast_V1   ,
     2570           output  VAT_R1     ,
     2571           output  VAT_V1     ,
     2572           output  Fact-order-1 ).
     2573       run ostatok (
     2574           input x-store-code  ,
     2575           input x-store-type  , x-TOG-Shift,
     2576           input x-date-start  ,
     2577           input x-date-end    , x-Shift-Start,x-Shift-End,
     2578           input 'crsa':U   ,
     2579           input '##,##':U,
     2580           input xTog-obj ,
     2581           output  Quantity1  ,
     2582           output  Coast_R1   ,
     2583           output  Coast_V1   ,
     2584           output  VAT_R1     ,
     2585           output  VAT_V1     ,
     2586           output  Fact-order-2 ).
     2587             Quantity1  = 0.
     2588             Coast_R1   = 0.
     2589             Coast_V1   = 0.
     2590             VAT_R1     = 0.
     2591             VAT_V1     = 0.
     2592   END PROCEDURE.
     2593   PROCEDURE display-str1  :
     2594              run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2595            if xshowcost    then do: run di ( "учет.", 2,"","","","",""). end.
     2596            if xshowcrsa    then do: run di ( "прод.", 5,"","","","","" ).  end.
     2597            if xshowsale    then do: run di ( "док." , 8,"","","","","" ).  end.
     2598            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     2599            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ).  end.
     2600            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ).  end.
     2601   end procedure.
